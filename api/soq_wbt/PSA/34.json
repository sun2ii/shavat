{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":34,"content":[{"type":"heading","content":["Iawe God euda dewasadia sasawa"]},{"type":"hebrew_subtitle","content":["Walama dea Dawid Abimelek danawe dewalena ewaewa abo oopa rua, sa baiwa me wanaubeno alen. Dewa ema aupe Iawe God Dawid sausana insene ita sasa ema girumalen."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Ne walama uduudu Iawe God wadaposisapina","poem":1},{"text":"ita me asowa wapina.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ne me ebowa debamasapina,","poem":1},{"text":"e apana ituaisilala gagalo ema etane nuaeuitana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Iawe God wadaposisata,","poem":1},{"text":"no awodea me ebowa debamasata!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ne Iawe God mampe rauparinteno ita me ne sipoanen,","poem":1},{"text":"apana sa ne sauntedina mampo me inanen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Apana mida sau baiwa Iawe God mampentoia,","poem":1},{"text":"mo nuaeuntoi,","poem":2},{"lineBreak":true},{"text":"me walama uduudu mo saumompa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ne poka uara mainawo wimoieno","poem":1},{"text":"tane Iawe God mampe rauparinteno etanen,","poem":2},{"lineBreak":true},{"text":"ne poka etedino me inanen.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Apana mida Iawe God wiwirawantoia,","poem":1},{"text":"me enseliwa mo oniamode,","poem":2},{"lineBreak":true},{"text":"me mo gonaamodio do waimoi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sa baiwa e Iawe God mampeitane","poem":1},{"text":"ita me euwaa dauwaida etana.","poem":2},{"text":"Naita e me onialepia baiwa mampe aitana,","poem":1},{"text":"e nuaeuitana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"E sumanailala Iawe God ebowa debamasana.","poem":1},{"lineBreak":true},{"text":"Apana mida me ebowa debamasaia","poem":1},{"text":"mai dima abolawantopu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Walama isiwa pue laion omana tomodio lai,","poem":1},{"text":"tane mida Iawe God sumanaiwantoia nitu uduudu mampe rua os waimoi","poem":2},{"lineBreak":true},{"text":"mai nitu da abolawantopu, dia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ne obaina, mainawo winlene gagalona etana.","poem":1},{"text":"Ne waeuwalepo Iawe God wiwirawaitonuna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"E wanwan daumawa ita do","poem":1},{"text":"wanwan euda waina menalempa,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"mai apana wakadisamonuna","poem":1},{"text":"do mai laga wanuna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kadiwa dewasailana ene tane euda dewasana,","poem":1},{"text":"ita apana saumono wanwan euda obasa wampu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Iawe God emawa apana dewa dodomana dewasaia osouwo winede,","poem":1},{"text":"mo sau baiwa me mampe iririntoio etamode.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tane kadi dewasaia apanawa mampo","poem":1},{"text":"me namba nambesade,","poem":2},{"lineBreak":true},{"text":"mo bontopuo ando mai mida mo umanau wapi, dia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Iawe God apanawa me mampe sau baiwa iririntompo etamopi,","poem":1},{"text":"me mo poka uduudu bedewe saumopie inamopi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Apana mida insaisau omaomala","poem":1},{"text":"Iawe God ipa mo do,","poem":2},{"lineBreak":true},{"text":"ita mo mida nuabolantoie insaisau omedia","poem":2},{"lineBreak":true},{"text":"me saumopie insaisau badosapi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dewa dodomana dewasaia apanawa","poem":1},{"text":"poka saiwa uara donsai,","poem":2},{"lineBreak":true},{"text":"tane Iawe God walama uduudu mo saumodie inamode.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Me emawa mo osouwo,","poem":1},{"text":"sa baiwa mai neaipu da tewapi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tane kadi dewalala, mo muba kadiwa dewasaia kadimopi,","poem":1},{"text":"ita apana mida dodomana dewasaio emalawoamoia","poem":2},{"lineBreak":true},{"text":"matangelawa mo wadapu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Tane Iawe God me nolawa dewalala inamode.","poem":1},{"text":"Apana mida Iawe God saumopie inamopia baiwa","poem":2},{"lineBreak":true},{"text":"me mampe antoia mai matangela donsapu, dia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":22}