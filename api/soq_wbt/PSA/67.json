{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":67,"content":[{"type":"heading","content":["Auwa sasawa"]},{"type":"verse","number":1,"content":[{"text":"O God, nuaparembaite, sau euda osombo itua.","poem":1},{"text":"E nana mainimbosae oiwawaitaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ita apana uduudu tawo osowe waimoia e dewaa atentopu,","poem":1},{"text":"uwa daitada apanawa atentopu e mo inamoa rua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Uwa daitada apanawa God wadaposiepu,","poem":1},{"text":"apana uduudu e wadaposiepu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Apana uduudu tawo osowe nuaeu mampe sasantopu","poem":1},{"text":"ipawa e dewaa dodomana mampe","poem":2},{"text":"uwa daitada apanawa oniamoiana,","poem":1},{"text":"e apana uduudu tawo osowe oniamona.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uwa daitada apanawa God wadaposiepu","poem":1},{"text":"apana uduudu e wadaposiepu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ita tawo osowe nana mauralepi","poem":1},{"text":"ita no Godimba sau debama no osombo itupi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ulaipa, God sau euda no osombosapi","poem":1},{"text":"ita bola daitada bede wanwanlala me wadaposisana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":7}