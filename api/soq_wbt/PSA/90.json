{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":90,"content":[{"type":"heading","content":["Apana ando diantopu tane Iawe God ipa wanwankasalala"]},{"type":"hebrew_subtitle","content":["God nolawa dewalala Moses sasa ema girumalen."]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Tatamba, e ipa walama uduudu no wanwanimba bolawa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E ipa wanwankasalalaida","poem":1},{"text":"muriwa wadi dewamoana","poem":2},{"lineBreak":true},{"text":"do muriwa tawo uduudu dewamoana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"E apana diamoe waanase,","poem":1},{"text":"“E leuitane popokau wanaitana!”","poem":2},{"text":"Mo popokau mampe seganton,","poem":1},{"text":"tane e leumoano popokau wananton.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"E emaawo ena 1,000 ipa walama dea rua,","poem":1},{"text":"ena sa ipa tadina omowa kampaida rua.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"E apana inawau tauwadea os wadeiaubeiana","poem":1},{"text":"auen ewawo nuaa tauwadea awawalepia rua.","poem":2},{"lineBreak":true},{"text":"Mo ipa beran tadinaida kelontoia rua.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tadinaida beran kelowa ewaewau eubu,","poem":1},{"text":"tane rawiwa mo rorontoie nonosintoi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"E nuakadia debama no kadinede","poem":1},{"text":"e nuaa no mainimbo kadileidia walamawe e saaidantitana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"No kadimba uduudu e eweiana,","poem":1},{"text":"no weregasaitana, tane e sabamo eweiana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"No wainitano e nuaa kadileide;","poem":1},{"text":"apana nonaupa itumpaiompa rua","poem":2},{"lineBreak":true},{"text":"e no wanwanimba tauwadea os kampasaana.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"No wantaa enawa ipa 70,","poem":1},{"text":"tane apana isiwa mukantopua wampuo enau 80 wadepi;","poem":2},{"text":"no wainite sai uara donsaitana,","poem":1},{"text":"mai wainipono daumaleipona ita bontitana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mai mida e nuakadia pokawaaida atenleipona,","poem":1},{"text":"naita e nuakadia no atendewantepono,","poem":2},{"lineBreak":true},{"text":"e saaidantepona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"No wanwanimba walamawa kampaida winedia waeuwanewo atentate,","poem":1},{"text":"ita insadewasa bedewe wainenta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Iawe God, insaisaa leusae nuaparembaitaa!","poem":1},{"text":"Mai kaino nuaa kadilempa no mainimbo!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tadinaida uduudu euwanena","poem":1},{"text":"e nuawadawadaa no baimba ipa winakasalala,","poem":2},{"text":"ita no walama uduudu nuaeu mampe","poem":1},{"text":"sasantonte wainenta.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"E sai debama ena uara bedewe nenaana,","poem":1},{"text":"tane tauma deawaa dewasae","poem":2},{"text":"walama dauma bedewe nuaeu nenona!","poem":1},{"text":"Poka eteitana wadaaubea,","poem":2},{"lineBreak":true},{"text":"ita wanwan euda ena uara bedewe wanta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"No ipa e nolaa dewalala,","poem":1},{"text":"e dewaa pokawaa euwanea,","poem":2},{"text":"no obainimba euwamoa e ipa,","poem":1},{"text":"mukamukaua ita debamawaida wainiana.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tatamba e ipa no Godimba,","poem":1},{"text":"sau euda osombo itua,","poem":2},{"text":"no nolamba dewasawo eulepie ipuipua segalepi,","poem":1},{"text":"oa, e no nolamba dewasawo eulepie ipuipua segalepi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":17}