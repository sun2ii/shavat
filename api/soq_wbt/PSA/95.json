{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"PSA","translationId":"soq_wbt","name":"Sam","commonName":"Sam","title":"Sam","order":19,"numberOfChapters":14,"sha256":"452799f1bf6ad2d1b70d1316efbdf887dee6fa26aaf7302d9918908677b9b132","firstChapterNumber":1,"firstChapterApiLink":"/api/soq_wbt/PSA/1.json","lastChapterNumber":139,"lastChapterApiLink":"/api/soq_wbt/PSA/139.json","totalNumberOfVerses":176},"chapter":{"number":95,"content":[{"type":"heading","content":["Wadapos sasawa"]},{"type":"verse","number":1,"content":[{"text":"Winleno sasantate Iawe God wadaposisata","poem":1},{"text":"no nuaeu mampe me wadaposisata,","poem":2},{"lineBreak":true},{"text":"me ipa no onioniamba ita saumba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"No me mampe winte auwasata","poem":1},{"text":"no sasantate me wadaposisata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ipawa Iawe God me ipa debamawaida,","poem":1},{"text":"me ipa warere mukamukaua tawo godiu uduudu aimon.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tawo bolawa uduudu ipa me mampea","poem":1},{"text":"doba nuau iane aidantona","poem":2},{"text":"ita wadi debama odane aidantona","poem":1},{"text":"me os witape winei.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Owa ipa me mebaa, ipawa me dewasan","poem":1},{"text":"ita do tawo me dewasan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Winleno dunentate Iawe God wadaposisata,","poem":1},{"text":"Iawe God no dewanena danawe iminimba emmisintata.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Me ipa no Godimba,","poem":1},{"text":"no ipa me apanawaida, oniadewasanede,","poem":2},{"lineBreak":true},{"text":"gamowa rua onianedio wainitana.","poem":2},{"lineBreak":true},{"text":"Ande e me aiawa etanadewaitana!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Me wadiase, “E mai nosinosila sala makowa bedewe bola Meriba","poem":1},{"text":"ita Masa bedewe wimone nuau anatene badosaiena ruauitana!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mo ne ginasana emauwoido eweiena,","poem":1},{"text":"ita mai sumanaintopona,","poem":2},{"lineBreak":true},{"text":"tane rubu osowe ituneiena.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ena 40 bedewe ne mo mampo nuana kadileno wanase,","poem":1},{"text":"‘Apana ema nuau nambeido,","poem":2},{"lineBreak":true},{"text":"ne aiana mai ruawantoipona.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sa baiwa nuana kadileno badowa diamone wanase,","poem":1},{"text":"‘Ne bubua bolawa mo baibu imaasanawo mai odapu, dia.’”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":11}