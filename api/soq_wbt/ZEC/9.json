{"translation":{"id":"soq_wbt","name":"Ina Sanaa Gagalowa","website":"https://ebible.org/Scriptures/details.php?id=soq","licenseUrl":"https://ebible.org/Scriptures/details.php?id=soq","licenseNotes":null,"shortName":"WBT","englishName":"Kanasi NT","language":"soq","textDirection":"ltr","sha256":"f9edf6e3fb39a74c83410f8e58654caa6e1d3b76d301c38d4dd4c7e065385de2","availableFormats":["json"],"listOfBooksApiLink":"/api/soq_wbt/books.json","numberOfBooks":55,"totalNumberOfChapters":488,"totalNumberOfVerses":10560,"languageName":"Kanasi","languageEnglishName":"Kanasi"},"book":{"id":"ZEC","translationId":"soq_wbt","name":"Sakaria","commonName":"Sakaria","title":"Sakaria","order":38,"numberOfChapters":3,"sha256":"adb735e4a22c88ac2cbb41b1af4bc4fc35edc3284e3e2a310310b747ab78fcbd","firstChapterNumber":9,"firstChapterApiLink":"/api/soq_wbt/ZEC/9.json","lastChapterNumber":13,"lastChapterApiLink":"/api/soq_wbt/ZEC/13.json","totalNumberOfVerses":5},"chapter":{"number":9,"content":[{"type":"heading","content":["Ierusalem apanawa warereu ando wisepi"]},{"type":"verse","number":9,"content":[{"text":"Iawe God wadiase, “E bola debama Saion apanawa nuaeuidaitana!","poem":1},{"text":"E Ierusalem apanawa nuaeu kawa wana!","poem":2},{"text":"Ewane e warerela manlawo iede,","poem":1},{"text":"me dewawa ipa dodomana ita ona nanausana apanawa.","poem":2},{"text":"Me etepa molaisiwa donki osowe waine iede;","poem":1},{"text":"Oa, me donki sanaa osowe waine iede.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ne ona turakawa pue mampe teiteinala Israel bedewe otaubamopa,","poem":1},{"text":"ita oas osouwo waimoie antoie onantoia Ierusalem bedewe waimoia otaubamope nambemopa.","poem":2},{"text":"Ita ona puraiwawa uduudu kadimopatuwapi.","poem":1},{"text":"E warerela wanwan euda obasa uwa daitada apanawa uduudu tawo osowe waimoia wanamopi.","poem":2},{"text":"Me warerewa makawa owa da osowe enepitue alepie owa da wadepi,","poem":1},{"text":"ita do esa Eupirates makawa alepie ita tawo uduudu wadepituwapi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/soq_wbt/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/soq_wbt/ZEC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/soq_wbt/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":2}