{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"ISA","translationId":"spa_blm","name":"ISAÍAS","commonName":"ISAÍAS","title":"El libro del profeta Isaías","order":23,"numberOfChapters":66,"sha256":"89f711ca61ae4bb84717e44b6c44834da76e3a03089d844a2cf74905de051778","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/spa_blm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":[{"text":"Bel se inclina.","poem":1},{"text":"Nebo se inclina.","poem":2},{"text":"Sus ídolos son llevados por animales,","poem":1},{"text":"y en el ganado.","poem":2},{"text":"Las cosas que llevabas son cargas pesadas,","poem":1},{"text":"una carga para los cansados.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Se agachan y se inclinan juntos.","poem":1},{"text":"No pudieron entregar la carga,","poem":2},{"lineBreak":true},{"text":"pero han ido al cautiverio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Escúchame, casa de Jacob,","poem":1},{"text":"y todo el resto de la casa de Israel,","poem":2},{"lineBreak":true},{"text":"que llevan desde su nacimiento,","poem":2},{"lineBreak":true},{"text":"que se han llevado desde el vientre materno.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hasta la vejez soy yo,","poem":1},{"text":"y hasta las canas te llevaré.","poem":2},{"text":"He hecho, y soportaré.","poem":1},{"text":"Sí, llevaré y entregaré.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“¿Con quién me compararás y me considerarás igual?","poem":1},{"text":"y compararme, como si fuéramos iguales?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Algunos vierten oro de la bolsa,","poem":1},{"text":"y pesa la plata en la balanza.","poem":2},{"text":"Contratan a un orfebre,","poem":1},{"text":"y lo convierte en un dios.","poem":2},{"text":"Se caen...","poem":1},{"text":"sí, adoran.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lo llevan al hombro.","poem":1},{"text":"Lo llevan y lo colocan en su sitio, y allí se queda.","poem":2},{"lineBreak":true},{"text":"No puede moverse de su sitio.","poem":2},{"text":"Sí, se le puede gritar, pero no puede responder.","poem":1},{"text":"No puede salvarle de su problema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Recordad esto y mostraos como hombres.","poem":1},{"text":"Recuérdenlo, transgresores.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Acuérdate de las cosas antiguas;","poem":1},{"text":"porque yo soy Dios y no hay otro.","poem":2},{"lineBreak":true},{"text":"Yo soy Dios, y no hay nadie como yo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Declaro el fin desde el principio,","poem":1},{"text":"y de los tiempos antiguos las cosas que aún no se han hecho.","poem":2},{"text":"Yo digo: Mi consejo se mantendrá,","poem":1},{"text":"y haré todo lo que me plazca.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Llamo a un pájaro voraz del este,","poem":1},{"text":"el hombre de mi consejo desde un país lejano.","poem":2},{"text":"Sí, he hablado.","poem":1},{"text":"Yo también lo llevaré a cabo.","poem":2},{"text":"Lo he planeado.","poem":1},{"text":"Yo también lo haré.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Escúchame, terco de corazón,","poem":1},{"text":"¡que están lejos de la justicia!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Acerco mi justicia.","poem":1},{"text":"No está lejos,","poem":2},{"lineBreak":true},{"text":"y mi salvación no esperará.","poem":2},{"text":"Yo concederé la salvación a Sión,","poem":1},{"text":"mi gloria a Israel.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}