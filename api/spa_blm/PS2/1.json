type":"verse","number":5,"content":[{"text":"Mis hermanos eran guapos y altos;","poem":1},{"text":"pero el Señor no se complació en ellos.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Salí al encuentro del filisteo,","poem":1},{"text":"y me maldijo por sus ídolos.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Pero yo saqué su propia espada y lo decapité,","poem":1},{"text":"y quitó el reproche a los hijos de Israel.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PS2/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/DAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/MAN/1.json","previousChapterAudioLinks":{},"numberOfVerses":7}