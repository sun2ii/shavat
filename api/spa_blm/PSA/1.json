{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Dichoso el hombre que no anda en el consejo de los malvados,","poem":1},{"text":"ni se detiene en el camino de los pecadores,","poem":2},{"lineBreak":true},{"text":"ni sienta en la silla de los burlones;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"sino que su deleite está en la ley de Yahvé.","poem":1},{"noteId":0},{"text":"En su ley medita de día y noche.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Será como un árbol plantado junto a las corrientes de agua,","poem":1},{"text":"que produce su fruto en su temporada,","poem":2},{"lineBreak":true},{"text":"cuya hoja tampoco se marchita.","poem":2},{"lineBreak":true},{"text":"Todo lo que haga prosperará.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Los malvados no son así,","poem":1},{"text":"sino que son como la paja que el viento se lleva.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Por lo tanto, los impíos no levantarán en el juicio,","poem":1},{"text":"ni los pecadores en la congregación de los justos.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Porque Yahvé conoce el camino de los justos,","poem":1},{"text":"pero el camino de los impíos perecerá.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"“Yahvé” es el nombre propio de Dios, a veces traducido como “SEÑOR” (en mayúsculas) en otras traducciones.","reference":{"chapter":1,"verse":2}}]},"thisChapterLink":"/api/spa_blm/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}