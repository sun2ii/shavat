{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Para el músico jefe. Por David."]},{"type":"verse","number":1,"content":[{"text":"En Yahvé me refugio.","poem":1},{"text":"¿Cómo puedes decir a mi alma: “Huye como un pájaro a tu montaña”?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Porque, he aquí, los malvados doblan sus arcos.","poem":1},{"text":"Colocaron sus flechas en las cuerdas,","poem":2},{"lineBreak":true},{"text":"para que disparen en la oscuridad a los rectos de corazón.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Si se destruyen los cimientos,","poem":1},{"text":"¿qué pueden hacer los justos?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahvé está en su santo templo.","poem":1},{"text":"Yahvé está en su trono en el cielo.","poem":2},{"text":"Sus ojos observan.","poem":1},{"text":"Sus ojos examinan a los hijos de los hombres.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yahvé examina a los justos,","poem":1},{"text":"pero su alma odia al malvado y al que ama la violencia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sobre los malvados hará llover carbones ardientes;","poem":1},{"text":"fuego, azufre y viento abrasador serán la porción de su copa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Porque Yahvé es justo.","poem":1},{"text":"Ama la justicia.","poem":2},{"lineBreak":true},{"text":"Los rectos verán su rostro.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}