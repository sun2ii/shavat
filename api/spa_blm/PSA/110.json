erecha.","poem":1},{"text":"Aplastará a los reyes en el día de su ira.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Él juzgará entre las naciones.","poem":1},{"text":"Amontonará cadáveres.","poem":2},{"lineBreak":true},{"text":"Aplastará al gobernante de toda la tierra.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Beberá del arroyo en el camino;","poem":1},{"text":"por lo que levantará la cabeza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}