{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"¡Alabado sea Yah!","poem":1},{"text":"Alabad, siervos de Yahvé,","poem":2},{"lineBreak":true},{"text":"alabar el nombre de Yahvé.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bendito sea el nombre de Yahvé,","poem":1},{"text":"desde este momento y para siempre.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Desde la salida del sol hasta su puesta,","poem":1},{"text":"El nombre de Yahvé debe ser alabado.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yahvé es alto sobre todas las naciones,","poem":1},{"text":"su gloria sobre los cielos.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"¿Quién es como Yahvé, nuestro Dios?","poem":1},{"text":"que tiene su asiento en lo alto,","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿quién se inclina para ver en el cielo y en la tierra?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Él levanta a los pobres del polvo,","poem":1},{"text":"y levanta a los necesitados del montón de cenizas,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"para que lo ponga con los príncipes,","poem":1},{"text":"incluso con los príncipes de su pueblo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Él asienta a la mujer estéril en su casa","poem":1},{"text":"como una alegre madre de niños.","poem":2},{"text":"¡Alabado sea Yah!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}