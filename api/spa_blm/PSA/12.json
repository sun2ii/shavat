{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["Para el músico principal; en una lira de ocho cuerdas. Un salmo de David."]},{"type":"verse","number":1,"content":[{"text":"Ayuda, Yahvé, porque el hombre piadoso cesa.","poem":1},{"text":"Porque los fieles fallan entre los hijos de los hombres.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Todo el mundo miente a su vecino.","poem":1},{"text":"Hablan con labios lisonjeros, y con un corazón doble.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Que Yahvé corte todos los labios lisonjeros,","poem":1},{"text":"y la lengua que se jacta,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"que han dicho: “Con nuestra lengua prevaleceremos.","poem":1},{"text":"Nuestros labios son nuestros.","poem":2},{"lineBreak":true},{"text":"¿Quién es el señor de nosotros?”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Por la opresión de los débiles y por el gemido de los necesitados,","poem":1},{"text":"Ahora me levantaré”, dice Yahvé;","poem":2},{"text":"“Lo pondré a salvo de los que lo difaman”.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Las palabras de Yahvé son palabras impecables,","poem":1},{"text":"como la plata refinada en un horno de arcilla, purificada siete veces.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tú los guardarás, Yahvé.","poem":1},{"text":"Los preservarás de esta generación para siempre.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Los malvados andan por todas partes,","poem":1},{"text":"cuando lo que es vil es exaltado entre los hijos de los hombres.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}