mpo","poem":1},{"text":"con el que odia la paz.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Estoy a favor de la paz,","poem":1},{"text":"pero cuando hablo, son para la guerra.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}