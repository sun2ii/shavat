 por encima de nuestra alma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bendito sea Yahvé,","poem":1},{"text":"que no nos ha dado como presa a sus dientes.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nuestra alma ha escapado como un pájaro de la trampa del cazador.","poem":1},{"text":"La trampa se ha roto y hemos escapado.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nuestra ayuda está en el nombre de Yahvé,","poem":1},{"text":"que hizo el cielo y la tierra.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}