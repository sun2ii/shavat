,{"text":"para que mis adversarios no se alegren de mi caída.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pero confío en tu amorosa bondad.","poem":1},{"text":"Mi corazón se regocija en tu salvación.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Cantaré a Yahvé,","poem":1},{"text":"porque ha sido bueno conmigo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}