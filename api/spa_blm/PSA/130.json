{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Una canción de ascensos."]},{"type":"verse","number":1,"content":[{"text":"Desde las profundidades he clamado a ti, Yahvé.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Señor, escucha mi voz.","poem":1},{"text":"Que tus oídos estén atentos a la voz de mis peticiones.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Si tú, Yah, llevaras un registro de los pecados,","poem":1},{"text":"Señor, ¿quién podría aguantar?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Pero contigo hay perdón,","poem":1},{"text":"por lo que se le teme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Espero a Yahvé.","poem":1},{"text":"Mi alma espera.","poem":2},{"lineBreak":true},{"text":"Espero en su palabra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mi alma anhela al Señor más que los vigilantes la mañana,","poem":1},{"text":"más que vigilantes de la mañana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Israel, espera en Yahvé,","poem":1},{"text":"porque hay bondad amorosa con Yahvé.","poem":2},{"lineBreak":true},{"text":"La redención abundante está con él.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Redimirá a Israel de todos sus pecados.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}