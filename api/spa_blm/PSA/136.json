{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"Dad gracias a Yahvé, porque es bueno,","poem":1},{"text":"porque su bondad es eterna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dad gracias al Dios de los dioses,","poem":1},{"text":"porque su bondad es eterna.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dad gracias al Señor de los señores,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"a aquel que es el único que hace grandes maravillas,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"al que con su entendimiento hizo los cielos,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"al que extendió la tierra sobre las aguas,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"al que hizo las grandes luces,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"el sol para gobernar de día,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"la luna y las estrellas para gobernar de noche,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"al que abatió al primogénito egipcio,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"y sacó a Israel de entre ellos,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"con una mano fuerte, y con un brazo extendido,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"al que dividió el Mar Rojo,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"e hizo pasar a Israel por el medio de ella,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"pero derrocó al Faraón y a su ejército en el Mar Rojo,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"al que guió a su pueblo por el desierto,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"al que golpeó a los grandes reyes,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"y mató a poderosos reyes,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sehón, rey de los amorreos,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Og, rey de Basán,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"y les dio su tierra como herencia,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"también una herencia para Israel, su siervo,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"que se acordó de nosotros en nuestro bajo estado,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"y nos ha librado de nuestros adversarios,","poem":1},{"text":"porque su bondad es eterna;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"que da alimento a toda criatura,","poem":1},{"text":"porque su bondad es eterna.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ohda gracias al Dios del cielo,","poem":1},{"text":"porque su bondad es eterna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}