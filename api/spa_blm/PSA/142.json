{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["Una contemplación de David, cuando estaba en la cueva. Una oración."]},{"type":"verse","number":1,"content":[{"text":"Clamo con mi voz a Yahvé.","poem":1},{"text":"Con mi voz, pido a Yahvé misericordia.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Derramo mi queja ante él.","poem":1},{"text":"Le cuento mis problemas.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Cuando mi espíritu se sobrecogió dentro de mí,","poem":1},{"text":"que conocías mi ruta.","poem":2},{"text":"En el camino en el que camino,","poem":1},{"text":"han escondido una trampa para mí.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mira a mi derecha y ve;","poem":1},{"text":"porque no hay nadie que se preocupe por mí.","poem":2},{"lineBreak":true},{"text":"El refugio ha huido de mí.","poem":2},{"lineBreak":true},{"text":"Nadie se preocupa por mi alma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A ti, Yahvé, te clamé.","poem":1},{"text":"Le dije: “Tú eres mi refugio,","poem":2},{"lineBreak":true},{"text":"mi parte en la tierra de los vivos”.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Escucha mi grito,","poem":1},{"text":"porque estoy desesperado.","poem":2},{"text":"Líbrame de mis perseguidores,","poem":1},{"text":"porque son demasiado fuertes para mí.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Saca ami alma de la cárcel,","poem":1},{"text":"para que pueda dar gracias a tu nombre.","poem":2},{"text":"Los justos me rodearán,","poem":1},{"text":"porque tú serás bueno conmigo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}