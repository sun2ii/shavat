{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"¡Alabado sea Yahvé!","poem":1},{"text":"Canta a Yahvé una nueva canción,","poem":2},{"lineBreak":true},{"text":"su alabanza en la asamblea de los santos.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Que Israel se regocije en el que los hizo.","poem":1},{"text":"Que los hijos de Sión se alegren en su Rey.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"¡Que alaben su nombre en la danza!","poem":1},{"text":"Que le canten alabanzas con pandereta y arpa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Porque Yahvé se complace en su pueblo.","poem":1},{"text":"Corona a los humildes con la salvación.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Que los santos se regocijen en el honor.","poem":1},{"text":"Que canten de alegría en sus camas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Que las altas alabanzas de Dios estén en sus bocas,","poem":1},{"text":"y una espada de dos filos en la mano,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"para ejecutar la venganza sobre las naciones,","poem":1},{"text":"y castigos a los pueblos;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"para atar a sus reyes con cadenas,","poem":1},{"text":"y sus nobles con grilletes de hierro;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"para ejecutar en ellos la sentencia escrita.","poem":1},{"text":"Todos sus santos tienen este honor.","poem":2},{"text":"¡Alabado sea Yah!","poem":1}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}