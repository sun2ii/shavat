{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Un salmo de David."]},{"type":"verse","number":1,"content":[{"text":"La tierra es de Yahvé, con su plenitud;","poem":1},{"text":"el mundo y los que lo habitan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Porque la ha fundado sobre los mares,","poem":1},{"text":"y lo estableció en las inundaciones.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Quién puede subir al monte de Yahvé?","poem":1},{"text":"¿Quién puede estar en su lugar santo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"El que tiene las manos limpias y el corazón puro;","poem":1},{"text":"que no ha levantado su alma a la falsedad,","poem":2},{"lineBreak":true},{"text":"y no ha jurado con engaño.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Recibirá la bendición de Yahvé,","poem":1},{"text":"justicia del Dios de su salvación.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Esta es la generación de los que le buscan,","poem":1},{"text":"que buscan tu rostro, incluso Jacob. Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Levantad la cabeza, puertas!","poem":1},{"text":"Alzaos, puertas eternas,","poem":2},{"lineBreak":true},{"text":"y el Rey de la gloria entrará.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"¿Quién es el Rey de la gloria?","poem":1},{"text":"Yahvé fuerte y poderoso,","poem":2},{"lineBreak":true},{"text":"Yahvé es poderoso en la batalla.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Levantad la cabeza, puertas;","poem":1},{"text":"sí, levántalos, puertas eternas,","poem":2},{"lineBreak":true},{"text":"y el Rey de la gloria entrará.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"¿Quién es este Rey de la gloria?","poem":1},{"text":"¡Yahvé de los Ejércitos es el Rey de la gloria! Selah.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}