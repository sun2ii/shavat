{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Vindícame, Dios, y defiende mi causa contra una nación impía.","poem":1},{"text":"Oh, líbrame de los hombres engañosos y malvados.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Porque tú eres el Dios de mi fuerza. ¿Por qué me has rechazado?","poem":1},{"text":"¿Por qué estoy de luto por la opresión del enemigo?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Oh, envía tu luz y tu verdad.","poem":1},{"text":"Deja que me guíen.","poem":2},{"lineBreak":true},{"text":"Deja que me lleven a tu santa colina,","poem":2},{"lineBreak":true},{"text":"a sus tiendas.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Entonces iré al altar de Dios,","poem":1},{"text":"a Dios, mi mayor alegría.","poem":2},{"text":"Te alabaré con el arpa, Dios, mi Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Por qué te desesperas, alma mía?","poem":1},{"text":"¿Por qué te perturbas dentro de mí?","poem":2},{"text":"¡Esperen en Dios!","poem":1},{"text":"Porque todavía lo alabaré:","poem":2},{"lineBreak":true},{"text":"mi Salvador, mi ayudante y mi Dios.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}