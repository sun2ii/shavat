{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Para el músico jefe. En los instrumentos de cuerda. Una contemplación de David, cuando los zifitas vinieron y le dijeron a Saúl: “¿No se esconde David entre nosotros?”"]},{"type":"verse","number":1,"content":[{"text":"Sálvame, Dios, por tu nombre.","poem":1},{"text":"Reivindícame con tu poder.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Escucha mi oración, Dios.","poem":1},{"text":"Escucha las palabras de mi boca.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Porque los extraños se han levantado contra mí.","poem":1},{"text":"Hombres violentos han buscado mi alma.","poem":2},{"lineBreak":true},{"text":"No han puesto a Dios delante de ellos. Selah.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"He aquí que Dios es mi ayudante.","poem":1},{"text":"El Señor es quien sostiene mi alma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Él pagará el mal a mis enemigos.","poem":1},{"text":"Destrúyelos con tu verdad.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Con una ofrenda voluntaria, te sacrificaré.","poem":1},{"text":"Daré gracias a tu nombre, Yahvé, porque es bueno.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Porque me ha librado de toda angustia.","poem":1},{"text":"Mi ojo ha visto el triunfo sobre mis enemigos.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}