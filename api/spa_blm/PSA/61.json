{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Para el músico jefe. Para un instrumento de cuerda. Por David."]},{"type":"verse","number":1,"content":[{"text":"Escucha mi clamor, Dios.","poem":1},{"text":"Escucha mi oración.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Desde el fin de la tierra, te llamaré cuando mi corazón esté abrumado.","poem":1},{"text":"Condúceme a la roca que es más alta que yo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Porque tú has sido un refugio para mí,","poem":1},{"text":"una torre fuerte del enemigo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yo habitaré en tu tienda para siempre.","poem":1},{"text":"Me refugiaré al abrigo de tus alas. Selah.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Porque tú, Dios, has escuchado mis votos.","poem":1},{"text":"Me has dado la herencia de los que temen tu nombre.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Prolongarás la vida del rey.","poem":1},{"text":"Sus años serán para generaciones.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Será entronizado en la presencia de Dios para siempre.","poem":1},{"text":"Designa tu amorosa bondad y la verdad, para que lo preserven.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Así cantaré alabanzas a tu nombre para siempre,","poem":1},{"text":"para que pueda cumplir mis votos diariamente.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}