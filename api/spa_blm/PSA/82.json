{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Un salmo de Asaf."]},{"type":"verse","number":1,"content":[{"text":"Dios preside la gran asamblea.","poem":1},{"text":"Juzga entre los dioses.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Hasta cuándo juzgarás injustamente,","poem":1},{"text":"y mostrar parcialidad a los malvados?” Selah.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Defiende al débil, al pobre y al huérfano.","poem":1},{"text":"Mantener los derechos de los pobres y oprimidos.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Rescata a los débiles y necesitados.","poem":1},{"text":"Líbrales de la mano de los malvados”.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"No saben, ni entienden.","poem":1},{"text":"Caminan de un lado a otro en la oscuridad.","poem":2},{"lineBreak":true},{"text":"Todos los cimientos de la tierra se tambalean.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dije: “Ustedes son dioses,","poem":1},{"text":"todos vosotros sois hijos del Altísimo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sin embargo, moriréis como hombres,","poem":1},{"text":"y caer como uno de los gobernantes”.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Levántate, Dios, juzga la tierra,","poem":1},{"text":"porque tú heredas todas las naciones.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}