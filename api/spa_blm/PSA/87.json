{"translation":{"id":"spa_blm","name":"Santa Biblia libre para el mundo","website":"https://ebible.org/Scriptures/details.php?id=spablm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spablm","licenseNotes":null,"shortName":"BLM","englishName":"Spanish Free Bible for the World","language":"spa","textDirection":"ltr","sha256":"9013d7e4ae9d7d7aa64d75862173621084457b0d80d37183e5fbdc703bc3dfbd","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_blm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"español","languageEnglishName":"Spanish","numberOfApocryphalBooks":15,"totalNumberOfApocryphalChapters":213,"totalNumberOfApocryphalVerses":6955},"book":{"id":"PSA","translationId":"spa_blm","name":"SALMOS","commonName":"SALMOS","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"4578c69ff1e9c30a5c3ef961b5a1e128e374160971428e7ff1690558e8e588d9","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_blm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_blm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Un Salmo de los hijos de Coré; una Canción."]},{"type":"verse","number":1,"content":[{"text":"Su fundamento está en los montes sagrados.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Yahvé ama las puertas de Sión más que todas las moradas de Jacob.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Cosas gloriosas se dicen de ti, ciudad de Dios. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Registraré a Rahab y a Babilonia entre los que me reconocen.","poem":1},{"text":"Mira, Filistea, Tiro, y también Etiopía:","poem":2},{"lineBreak":true},{"text":"“Este nació allí”.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sí, de Sión se dirá: “Éste y aquél han nacido en ella”.","poem":1},{"text":"el mismo Altísimo la establecerá.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yahvé contará, cuando escriba los pueblos,","poem":1},{"text":"“Este nació allí”. Selah.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tanto los que cantan como los que bailan dicen,","poem":1},{"text":"“Todos mis resortes están en ti”.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}