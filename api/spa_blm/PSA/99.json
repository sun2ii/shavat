a su escabel.","poem":2},{"lineBreak":true},{"text":"¡Él es Santo!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Moisés y Aarón estaban entre sus sacerdotes,","poem":1},{"text":"Samuel estaba entre los que invocan su nombre.","poem":2},{"lineBreak":true},{"text":"Invocaron a Yahvé y éste les respondió.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Les habló en la columna de nube.","poem":1},{"text":"Guardaron sus testimonios,","poem":2},{"lineBreak":true},{"text":"el estatuto que les dio.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tú les respondiste, Yahvé, nuestro Dios.","poem":1},{"text":"Eres un Dios que los perdonó,","poem":2},{"lineBreak":true},{"text":"aunque te hayas vengado de sus actos.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Exalta a Yahvé, nuestro Dios.","poem":1},{"text":"Adorar en su santa colina,","poem":2},{"lineBreak":true},{"text":"porque Yahvé, nuestro Dios, es santo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/spa_blm/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_blm/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_blm/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}