{"translation":{"id":"spa_onbv","name":"Biblica® Open Nueva Biblia Viva 2008","website":"https://ebible.org/Scriptures/details.php?id=spaonbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spaonbv","licenseNotes":null,"shortName":"ONBV","englishName":"Spanish ONBV","language":"spa","textDirection":"ltr","sha256":"e44a69a37ce560d253672e51128fe37b068f29ea586be150b42a3d3bb6826f25","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_onbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_onbv","name":"Salmo","commonName":"Salmo","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"99a1299b2fe3442dbf5ac7b2207db6d230fc6bda70eea1c7cf63807aac1e3eef","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_onbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_onbv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":["¡Aleluya! ¡Alabado sea el Señor! Alaben, siervos del Señor, alaben el nombre del Señor."]},{"type":"verse","number":2,"content":["Bendito es su nombre por los siglos de los siglos."]},{"type":"verse","number":3,"content":["¡Alábenlo desde el amanecer hasta que el sol se ponga!"]},{"type":"verse","number":4,"content":["Porque él está muy por encima de las naciones; su gloria es mucho más grande que los cielos."]},{"type":"verse","number":5,"content":["¿Quién podrá compararse con el Señor nuestro Dios, que tiene su trono en las alturas?"]},{"type":"verse","number":6,"content":["Allá por debajo de él están los cielos y la tierra; él se inclina a mirar,"]},{"type":"verse","number":7,"content":["y levanta al pobre del polvo, y al necesitado del basurero,"]},{"type":"verse","number":8,"content":["y los hace sentarse entre los príncipes, con los príncipes de su pueblo."]},{"type":"verse","number":9,"content":["El da hijos a la mujer estéril, un hogar para que sea una madre feliz. ¡Aleluya! ¡Alabado sea el Señor!"]}],"footnotes":[]},"thisChapterLink":"/api/spa_onbv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_onbv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_onbv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}