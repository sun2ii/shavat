{"translation":{"id":"spa_onbv","name":"Biblica® Open Nueva Biblia Viva 2008","website":"https://ebible.org/Scriptures/details.php?id=spaonbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spaonbv","licenseNotes":null,"shortName":"ONBV","englishName":"Spanish ONBV","language":"spa","textDirection":"ltr","sha256":"e44a69a37ce560d253672e51128fe37b068f29ea586be150b42a3d3bb6826f25","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_onbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_onbv","name":"Salmo","commonName":"Salmo","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"99a1299b2fe3442dbf5ac7b2207db6d230fc6bda70eea1c7cf63807aac1e3eef","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_onbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_onbv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":["Hace mucho tiempo, cuando Israel salió de Egipto, de una tierra extraña,"]},{"type":"verse","number":2,"content":["la tierra de Judá se convirtió en el santuario de Dios e Israel, en su reino."]},{"type":"verse","number":3,"content":["El Mar Rojo los vio venir y rápidamente huyó ante ellos. El río Jordán se volvió atrás."]},{"type":"verse","number":4,"content":["Las montañas saltaron como chivos, y las colinas como corderos."]},{"type":"verse","number":5,"content":["¿Qué te pasó, Mar Rojo, qué te hizo huir? Río Jordán, ¿qué le ocurrió a tus aguas? ¿Por qué se volvieron atrás?"]},{"type":"verse","number":6,"content":["Por qué, ustedes los montes saltaron como chivos? ¿Por qué, ustedes colinas, saltaron como corderos?"]},{"type":"verse","number":7,"content":["Tiembla, oh tierra, ante la presencia del Señor, el Dios de Jacob,"]},{"type":"verse","number":8,"content":["porque él hizo que de la roca surgiera un estanque, del pedernal surgieran torrentes de agua."]}],"footnotes":[]},"thisChapterLink":"/api/spa_onbv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_onbv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_onbv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}