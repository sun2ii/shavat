{"translation":{"id":"spa_onbv","name":"Biblica® Open Nueva Biblia Viva 2008","website":"https://ebible.org/Scriptures/details.php?id=spaonbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spaonbv","licenseNotes":null,"shortName":"ONBV","englishName":"Spanish ONBV","language":"spa","textDirection":"ltr","sha256":"e44a69a37ce560d253672e51128fe37b068f29ea586be150b42a3d3bb6826f25","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_onbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_onbv","name":"Salmo","commonName":"Salmo","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"99a1299b2fe3442dbf5ac7b2207db6d230fc6bda70eea1c7cf63807aac1e3eef","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_onbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_onbv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Salmo de Asaf."]},{"type":"verse","number":1,"content":["Dios está en el tribunal del cielo. Pronuncia sentencia contra los jueces."]},{"type":"verse","number":2,"content":["¿Hasta cuándo, jueces, tomarán decisiones injustas? ¿Hasta cuándo concederán favores especiales a los malvados?"]},{"type":"verse","number":3,"content":["Juzguen rectamente al pobre y al huérfano, y al desvalido y al oprimido háganles justicia."]},{"type":"verse","number":4,"content":["Rescaten de las garras de los malvados al pobre y al necesitado."]},{"type":"verse","number":5,"content":["¡Pero qué necios e ignorantes son ustedes! Como están en tinieblas, los cimientos de la tierra se estremecen."]},{"type":"verse","number":6,"content":["Yo les he dicho: «Ustedes son dioses e hijos del Altísimo»."]},{"type":"verse","number":7,"content":["Mas para la muerte, ustedes no son sino hombres. Caerán como cualquier príncipe, pues todos han de morir."]},{"type":"verse","number":8,"content":["¡Levántate, oh Dios, y juzga a la tierra! Todas las naciones te pertenecen."]}],"footnotes":[]},"thisChapterLink":"/api/spa_onbv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_onbv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_onbv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}