{"translation":{"id":"spa_onbv","name":"Biblica® Open Nueva Biblia Viva 2008","website":"https://ebible.org/Scriptures/details.php?id=spaonbv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spaonbv","licenseNotes":null,"shortName":"ONBV","englishName":"Spanish ONBV","language":"spa","textDirection":"ltr","sha256":"e44a69a37ce560d253672e51128fe37b068f29ea586be150b42a3d3bb6826f25","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_onbv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":29102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_onbv","name":"Salmo","commonName":"Salmo","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"99a1299b2fe3442dbf5ac7b2207db6d230fc6bda70eea1c7cf63807aac1e3eef","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_onbv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_onbv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":["¡El Señor es rey! Se ha revestido de majestad, de majestad se ha revestido y se ha armado con poder. Ha establecido al mundo con firmeza; no lo sacudirán."]},{"type":"verse","number":2,"content":["Tu trono desde el principio se estableció, y tú desde siempre has existido."]},{"type":"verse","number":3,"content":["Los poderosos océanos braman, Señor. Los poderosos océanos braman como truenos; los poderosos océanos braman cuando sus olas se rompen en la playa."]},{"type":"verse","number":4,"content":["Pero el Señor, en las alturas, se muestra poderoso; más poderoso que el estruendo de las muchas aguas."]},{"type":"verse","number":5,"content":["Tus reales decretos no cambian. La santidad, Señor, es lo que hace a tu reino diferente."]}],"footnotes":[]},"thisChapterLink":"/api/spa_onbv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_onbv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/s