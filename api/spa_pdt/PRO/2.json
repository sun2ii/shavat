{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PRO","translationId":"spa_pdt","name":"Proverbios","commonName":"Proverbios","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"6212fe15f7e1351054eaa48868a737e6ad235e14fb37e7a14f90190ecd4c528d","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/spa_pdt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Absoluta excelencia de la sabiduría"]},{"type":"verse","number":1,"content":[{"text":"Hijo mío, si aceptas mis palabras,","poem":1},{"lineBreak":true},{"text":"Y guardas mis mandamientos dentro de ti,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Eres de oído atento a la sabiduría,","poem":1},{"lineBreak":true},{"text":"E inclinas tu corazón a la inteligencia,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Si invocas a la prudencia,","poem":1},{"lineBreak":true},{"text":"Y al entendimiento alzas tu voz,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Si la procuras como a la plata,","poem":1},{"lineBreak":true},{"text":"Y la rebuscas como a tesoros escondidos,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Entonces entenderás el temor a Yavé,","poem":1},{"lineBreak":true},{"text":"Y hallarás el conocimiento de ʼElohim.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Porque Yavé da la sabiduría.","poem":1},{"lineBreak":true},{"text":"De su boca procede la ciencia y la inteligencia.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Él atesora el acierto para los hombres rectos,","poem":1},{"lineBreak":true},{"text":"Es escudo al que anda en integridad.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Es el que guarda las sendas de la justicia,","poem":1},{"lineBreak":true},{"text":"Y preserva el camino de sus santos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Entonces entenderás la justicia y el derecho,","poem":1},{"lineBreak":true},{"text":"La equidad y todo buen camino.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cuando la sabiduría entre en tu corazón","poem":1},{"lineBreak":true},{"text":"Y el conocimiento sea dulce a tu alma,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Te guardará la discreción.","poem":1},{"lineBreak":true},{"text":"Te preservará la prudencia","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Para librarte del camino malo","poem":1},{"lineBreak":true},{"text":"Del hombre que habla cosas perversas,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"De los que abandonan los caminos rectos","poem":1},{"lineBreak":true},{"text":"Para andar por sendas tenebrosas,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"De los que gozan haciendo el mal,","poem":1},{"lineBreak":true},{"text":"Y se alegran en las perversidades del vicio,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Cuyas sendas son tortuosas,","poem":1},{"lineBreak":true},{"text":"Y sus caminos extraviados.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Te librará de la mujer ajena,","poem":1},{"lineBreak":true},{"text":"De la extraña que endulza sus palabras,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Que abandona al compañero de su juventud","poem":1},{"lineBreak":true},{"text":"Y olvida el Pacto de su ʼElohim.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Su casa se inclina hacia la muerte,","poem":1},{"lineBreak":true},{"text":"Sus sendas hacia el país de las sombras.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Cuantos entran en ella no regresan,","poem":1},{"lineBreak":true},{"text":"Ni retoman los senderos de la vida.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Para que sigas el buen camino","poem":1},{"lineBreak":true},{"text":"Y guardes los senderos del justo.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Porque los rectos vivirán en la tierra,","poem":1},{"lineBreak":true},{"text":"Y los de limpio corazón permanecerán en ella.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Pero el perverso será cortado de la tierra,","poem":1},{"lineBreak":true},{"text":"Y de ella serán desarraigados los transgresores.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}