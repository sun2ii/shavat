{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PRO","translationId":"spa_pdt","name":"Proverbios","commonName":"Proverbios","title":"Proverbios","order":20,"numberOfChapters":31,"sha256":"6212fe15f7e1351054eaa48868a737e6ad235e14fb37e7a14f90190ecd4c528d","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/spa_pdt/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["La sabiduría y la mujer necia"]},{"type":"verse","number":1,"content":[{"text":"La sabiduría edificó su casa.","poem":1},{"lineBreak":true},{"text":"Labró sus siete columnas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Degolló sus animales,","poem":1},{"lineBreak":true},{"text":"Mezcló su vino,","poem":1},{"lineBreak":true},{"text":"Sirvió su mesa,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Y envió a sus criadas","poem":1},{"lineBreak":true},{"text":"A pregonarlo desde las más altas cumbres de la ciudad:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡El que sea simple, venga acá!","poem":1},{"lineBreak":true},{"text":"Al falto de entendimiento le quiero hablar:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Vengan, coman de mis manjares,","poem":1},{"lineBreak":true},{"text":"Y beban del vino que mezclé!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Dejen la necedad y vivan,","poem":1},{"lineBreak":true},{"text":"Pongan sus pies en el camino del entendimiento!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"El que corrige al burlador se acarrea insultos.","poem":1},{"lineBreak":true},{"text":"El que reprende al perverso se acarrea afrenta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"No reprendas al burlador, no sea que te aborrezca.","poem":1},{"lineBreak":true},{"text":"Reprende al sabio, y te amará.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Da al sabio, y será aun más sabio.","poem":1},{"lineBreak":true},{"text":"Enseña al justo, y aumentará su saber.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"El temor a Yavé es el principio de la sabiduría,","poem":1},{"lineBreak":true},{"text":"Y el conocimiento del Santísimo es el entendimiento.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Porque por mí se aumentarán tus días,","poem":1},{"lineBreak":true},{"text":"Y años de vida se te añadirán.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Si eres sabio, para ti mismo eres sabio,","poem":1},{"lineBreak":true},{"text":"Y si eres burlador, solo tú llevarás el daño.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"La mujer necia es alborotadora.","poem":1},{"lineBreak":true},{"text":"Es simple y nada sabe.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Se sienta en la puerta de su casa,","poem":1},{"lineBreak":true},{"text":"O en los lugares más altos de la ciudad","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Para llamar a los que pasan,","poem":1},{"lineBreak":true},{"text":"A los que van directo por sus sendas:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"¡Todos los ingenuos vengan acá!","poem":1},{"lineBreak":true},{"text":"Y dice a los faltos de cordura:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"¡El agua robada es dulce!","poem":1},{"lineBreak":true},{"text":"¡El pan comido en oculto es sabroso!","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"No saben ellos que allí están los muertos,","poem":1},{"lineBreak":true},{"text":"Y que sus invitados están tendidos en lo profundo del Seol.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}