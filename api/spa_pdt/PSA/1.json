{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"heading","content":["Prólogo"]},{"type":"verse","number":1,"content":[{"text":"¡Inmensamente feliz","poem":1},{"noteId":0},{"text":"es el varón que no anduvo en consejo de impíos,","poem":1},{"lineBreak":true},{"text":"Ni se detuvo en camino de pecadores,","poem":1},{"lineBreak":true},{"text":"Ni se sentó en silla de burladores!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Sino en la Ley de Yavé halla complacencia,","poem":1},{"lineBreak":true},{"text":"Y en su Ley reflexiona de día y de noche.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Será como árbol plantado junto a corrientes de agua","poem":1},{"lineBreak":true},{"text":"Que da su fruto a su tiempo","poem":1},{"lineBreak":true},{"text":"Y su follaje no se marchita.","poem":1},{"lineBreak":true},{"text":"Todo lo que hace tendrá éxito.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"No así los impíos,","poem":1},{"lineBreak":true},{"text":"Que son como cáscara de grano levantada por el viento.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Por tanto, no se levantarán los impíos en el juicio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Porque Yavé conoce el camino de los justos,","poem":1},{"lineBreak":true},{"text":"Pero la senda de los impíos lleva a destrucción.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Lit. Bienaventurado.","reference":{"chapter":1,"verse":1}}]},"thisChapterLink":"/api/spa_pdt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}