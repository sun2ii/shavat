{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Cantaré de tu misericordia y justicia.","poem":1},{"lineBreak":true},{"text":"A Ti, oh Yavé, cantaré salmos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Observaré atentamente el camino de la integridad.","poem":1},{"lineBreak":true},{"text":"¿Cuándo vendrás a mí?","poem":1},{"lineBreak":true},{"text":"Andaré en la integridad de mi corazón en medio de mi casa.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"No pondré ante mis ojos cosa indigna.","poem":1},{"lineBreak":true},{"text":"Aborrezco la obra de los que se desvían.","poem":1},{"lineBreak":true},{"text":"No me atrapará.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"El corazón perverso se apartará de mí.","poem":1},{"lineBreak":true},{"text":"No reconoceré al perverso.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Destruiré al que secretamente calumnia a su prójimo.","poem":1},{"lineBreak":true},{"text":"No soportaré al altivo de ojos y orgulloso de corazón.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sobre los fieles de la tierra fijaré mis ojos","poem":1},{"lineBreak":true},{"text":"Para que estén conmigo.","poem":1},{"lineBreak":true},{"text":"El que anda en camino de integridad me servirá.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"No vivirá en mi casa el que practica fraude,","poem":1},{"lineBreak":true},{"text":"El que habla mentira no permanecerá delante de mí.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Por las mañanas destruiré a todos los perversos de la tierra,","poem":1},{"lineBreak":true},{"text":"Para extirpar de la ciudad de Yavé a todos los malhechores.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}