{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"heading","content":["Canto. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Mi corazón está firme, oh ʼElohim.","poem":1},{"lineBreak":true},{"text":"Cantaré y entonaré salmos.","poem":1},{"lineBreak":true},{"text":"Esta es mi gloria.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Despierten, arpa y lira,","poem":1},{"noteId":22},{"lineBreak":true},{"text":"Yo despertaré el alba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Oh Yavé, te daré gracias entre los pueblos.","poem":1},{"lineBreak":true},{"text":"Entre las naciones te cantaré salmos,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Porque tu misericordia es más grande que los cielos,","poem":1},{"lineBreak":true},{"text":"Y hasta los cielos tu verdad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Exaltado seas por encima de los cielos, oh ʼElohim,","poem":1},{"lineBreak":true},{"text":"Y tu gloria por encima de toda la tierra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Para que sean librados tus amados,","poem":1},{"lineBreak":true},{"text":"Salva con tu mano derecha, y respóndeme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ʼElohim respondió en su Santuario:","poem":1},{"lineBreak":true},{"text":"Yo me alegraré.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Repartiré a Siquem.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y mediré el valle de Sucot.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mío es Galaad,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Mío es Manasés.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"También Efraín es el casco de mi cabeza.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Judá es mi cetro.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Moab es la vasija en la cual me lavo.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Sobre Edom lanzaré mi sandalia.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Sobre Filistea proclamaré victoria.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Quién me conducirá a la ciudad fortificada?","poem":1},{"lineBreak":true},{"text":"¿Quién me guiará hasta Edom?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¿Tú, mismo, oh ʼElohim, no nos rechazaste?","poem":1},{"lineBreak":true},{"text":"¿Y no sales con nuestros ejércitos, oh ʼElohim?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Socórrenos contra el adversario,","poem":1},{"lineBreak":true},{"text":"Porque vana es la liberación del hombre.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Por medio de ʼElohim haremos proezas.","poem":1},{"lineBreak":true},{"text":"Él pisoteará a nuestros enemigos.","poem":1}]}],"footnotes":[{"noteId":22,"caller":"+","text":"Lira: Antiguo instrumento músico de varias cuerdas tensas en un marco.","reference":{"chapter":108,"verse":2}}]},"thisChapterLink":"/api/spa_pdt/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}