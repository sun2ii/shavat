{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Al director del coro. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"En Yavé me refugio.","poem":1},{"lineBreak":true},{"text":"¿Cómo puedes decir a mi alma:","poem":1},{"lineBreak":true},{"text":"Huye como ave a tu montaña?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Pues ahí están los perversos que tensan el arco.","poem":1},{"lineBreak":true},{"text":"Preparan su flecha en la cuerda","poem":1},{"lineBreak":true},{"text":"Para dispararla en la oscuridad a los de corazón recto.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Si son destruidos los fundamentos,","poem":1},{"lineBreak":true},{"text":"¿Qué puede hacer el justo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yavé está en su santo Templo.","poem":1},{"lineBreak":true},{"text":"Yavé tiene en los cielos su trono.","poem":1},{"lineBreak":true},{"text":"Sus ojos observan,","poem":1},{"lineBreak":true},{"text":"Sus párpados examinan a los hijos de los hombres.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yavé prueba al justo,","poem":1},{"lineBreak":true},{"text":"Pero su alma aborrece al perverso","poem":1},{"lineBreak":true},{"text":"Y al que ama violencia.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hará llover carbones encendidos sobre los perversos,","poem":1},{"lineBreak":true},{"text":"Fuego, azufre y viento abrasador.","poem":1},{"lineBreak":true},{"text":"Tal será la porción de la copa de ellos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Porque Yavé es justo.","poem":1},{"lineBreak":true},{"text":"Él ama la justicia.","poem":1},{"lineBreak":true},{"text":"Los rectos contemplarán su rostro.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}