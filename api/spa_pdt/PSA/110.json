{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Dice Yavé a mi ʼAdonay:","poem":1},{"lineBreak":true},{"text":"Siéntate a mi mano derecha,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Hasta que pongas a tus enemigos como estrado de tus pies.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yavé enviará desde Sion el cetro","poem":1},{"noteId":23},{"text":"de tu poder.","poem":1},{"lineBreak":true},{"text":"Domina en medio de tus enemigos","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"En el día de tu poder.","poem":1},{"lineBreak":true},{"text":"En la hermosura de la santidad desde el seno de la aurora,","poem":1},{"lineBreak":true},{"text":"Con ornamento santo desde el vientre de la aurora,","poem":1},{"lineBreak":true},{"text":"Tu juventud te es como el rocío.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yavé juró y no cambiará:","poem":1},{"lineBreak":true},{"text":"Tú eres sacerdote para siempre según el orden de Melquisedec.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ʼAdonay está a tu mano derecha.","poem":1},{"lineBreak":true},{"text":"Quebrantará reyes en el día de su ira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Juzgará entre las naciones,","poem":1},{"lineBreak":true},{"text":"Las llenará de cadáveres.","poem":1},{"lineBreak":true},{"text":"Quebrantará a los gobernantes sobre la extensa tierra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Beberá del arroyo en el camino,","poem":1},{"lineBreak":true},{"text":"Por tanto levantará su cabeza.","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Cetro: Vara de oro labrada con primor que usaban los reyes como insignia de dignidad.","reference":{"chapter":110,"verse":2}}]},"thisChapterLink":"/api/spa_pdt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}