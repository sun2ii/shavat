{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["¡Aleluya!"]},{"type":"verse","number":1,"content":[{"text":"Daré gracias a Yavé con todo mi corazón","poem":1},{"lineBreak":true},{"text":"En la compañía de los rectos y en la congregación.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Grandes son las obras de Yavé,","poem":1},{"lineBreak":true},{"text":"Estudiadas por todos los que se deleitan en ellas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Espléndida y majestuosa es su obra,","poem":1},{"lineBreak":true},{"text":"Y su justicia permanece para siempre.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Hizo memorables sus maravillas.","poem":1},{"lineBreak":true},{"text":"Clemente y misericordioso es Yavé.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dio alimento a los que le temen.","poem":1},{"lineBreak":true},{"text":"Para siempre se acordará de su Pacto.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"El poder de sus obras manifestó a su pueblo","poem":1},{"lineBreak":true},{"text":"Al darle la heredad de las naciones.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Las obras de sus manos son verdad y justicia.","poem":1},{"lineBreak":true},{"text":"Todos sus Preceptos son firmes.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Afirmados eternamente y para siempre,","poem":1},{"lineBreak":true},{"text":"Hechos con verdad y rectitud.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Envió redención a su pueblo.","poem":1},{"lineBreak":true},{"text":"Estableció su Pacto para siempre.","poem":1},{"lineBreak":true},{"text":"Santo y asombroso es su Nombre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"El principio de la sabiduría es el temor a Yavé.","poem":1},{"lineBreak":true},{"text":"Buen entendimiento tienen todos los que lo practican.","poem":1},{"lineBreak":true},{"text":"Su alabanza permanece para siempre.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}