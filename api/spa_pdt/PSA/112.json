{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["¡Aleluya!"]},{"type":"verse","number":1,"content":[{"text":"¡Aleluya! Inmensamente feliz es el hombre que teme a Yavé,","poem":1},{"lineBreak":true},{"text":"Que grandemente se deleita en sus Mandamientos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sus descendientes serán poderosos en la tierra.","poem":1},{"lineBreak":true},{"text":"La generación de los rectos será bendita.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Suficiencia y riquezas hay en su casa,","poem":1},{"lineBreak":true},{"text":"Y su justicia permanece para siempre.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Luz resplandece en las tinieblas para el recto.","poem":1},{"lineBreak":true},{"text":"Es bondadoso, compasivo y justo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Anda bien el hombre que es bondadoso y presta.","poem":1},{"lineBreak":true},{"text":"Mantendrá su causa en el juicio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Porque él nunca será conmovido,","poem":1},{"lineBreak":true},{"text":"El justo será recordado para siempre.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"No tendrá temor de malas noticias.","poem":1},{"lineBreak":true},{"text":"Su corazón está firme, confiado en Yavé.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Su corazón está sostenido.","poem":1},{"lineBreak":true},{"text":"No temerá hasta que mire desde arriba a sus adversarios.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"El reparte libremente a los pobres.","poem":1},{"lineBreak":true},{"text":"Su justicia permanece para siempre.","poem":1},{"lineBreak":true},{"text":"Su poder es exaltado con honor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lo verá el perverso y se angustiará.","poem":1},{"lineBreak":true},{"text":"Crujirá sus dientes y se consumirá.","poem":1},{"lineBreak":true},{"text":"El deseo de los perversos perecerá.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}