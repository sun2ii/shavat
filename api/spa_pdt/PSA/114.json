{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Cuando Israel salió de Egipto,","poem":1},{"lineBreak":true},{"text":"La casa de Jacob de un pueblo de lengua extraña,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Judá fue su santuario,","poem":1},{"lineBreak":true},{"text":"E Israel, su dominio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"El mar lo vio y huyó,","poem":1},{"lineBreak":true},{"text":"El Jordán retrocedió.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Las montañas saltaron como carneros,","poem":1},{"lineBreak":true},{"text":"Las colinas, como corderos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Qué te ocurrió, oh mar, que huiste?","poem":1},{"lineBreak":true},{"text":"¿Y tú, oh Jordán, que retrocediste?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¿Ustedes, oh montañas, que saltan como carneros,","poem":1},{"lineBreak":true},{"text":"Y ustedes, oh colinas, como corderos?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tiembla, oh tierra, ante ʼAdonay,","poem":1},{"lineBreak":true},{"text":"Ante el ʼElohim de Jacob,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quien convirtió la peña en un estanque de aguas,","poem":1},{"lineBreak":true},{"text":"Y el pedernal en manantial de aguas.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}