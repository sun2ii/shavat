{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"No a nosotros, oh Yavé,","poem":1},{"lineBreak":true},{"text":"No a nosotros,","poem":1},{"lineBreak":true},{"text":"Sino a tu Nombre da gloria,","poem":1},{"lineBreak":true},{"text":"Por tu misericordia y por tu verdad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"¿Por qué deben decir los gentiles:","poem":1},{"lineBreak":true},{"text":"Dónde está su ʼElohim?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nuestro ʼElohim está en el cielo.","poem":1},{"lineBreak":true},{"text":"Hizo todo lo que quiso.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Los ídolos de ellos son de plata y oro,","poem":1},{"lineBreak":true},{"text":"Obra de manos de hombres.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tienen bocas, pero no hablan.","poem":1},{"lineBreak":true},{"text":"Tienen ojos, pero no ven.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tienen orejas, pero no oyen.","poem":1},{"lineBreak":true},{"text":"Tienen fosas nasales, pero no perciben olor.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tienen manos, pero no palpan.","poem":1},{"lineBreak":true},{"text":"Tienen pies, pero no andan.","poem":1},{"lineBreak":true},{"text":"No hablan con su garganta.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Los que los hacen","poem":1},{"lineBreak":true},{"text":"Y todos los que confían en ellos","poem":1},{"lineBreak":true},{"text":"Son semejantes a ellos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Oh Israel, confía en Yavé!","poem":1},{"lineBreak":true},{"text":"Él es tu Ayuda y Escudo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¡Oh casa de Aarón, confía en Yavé!","poem":1},{"lineBreak":true},{"text":"Él es tu Ayuda y tu Escudo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Los que temen a Yavé,","poem":1},{"lineBreak":true},{"text":"Confíen en Yavé.","poem":1},{"lineBreak":true},{"text":"Él es su Ayuda y su Escudo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yavé se acordó de nosotros,","poem":1},{"lineBreak":true},{"text":"Él nos bendecirá.","poem":1},{"lineBreak":true},{"text":"Bendecirá a la casa de Israel,","poem":1},{"lineBreak":true},{"text":"Bendecirá a la casa de Aarón.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bendecirá a los que temen a Yavé,","poem":1},{"lineBreak":true},{"text":"A los pequeños y a los grandes.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Yavé aumentará bendición","poem":1},{"lineBreak":true},{"text":"Sobre ustedes y sobre sus hijos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Benditos sean ustedes por Yavé,","poem":1},{"lineBreak":true},{"text":"Quien hizo el cielo y la tierra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"El cielo es el cielo de Yavé,","poem":1},{"lineBreak":true},{"text":"Pero Él dio la tierra a los hijos de los hombres.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"No alaban los muertos a YA,","poem":1},{"lineBreak":true},{"text":"Ni cualquiera que baja al silencio.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Pero nosotros bendecimos a YA desde ahora y para siempre.","poem":1},{"lineBreak":true},{"text":"¡Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}