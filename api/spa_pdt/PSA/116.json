{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"Amo a Yavé,","poem":1},{"lineBreak":true},{"text":"Porque escucha mi voz y mis súplicas,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Porque inclina a mí su oído.","poem":1},{"lineBreak":true},{"text":"Por tanto, lo invocaré mientras viva.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Me rodearon las ataduras de la muerte.","poem":1},{"lineBreak":true},{"text":"Me cayeron los terrores del Seol.","poem":1},{"lineBreak":true},{"text":"Hallé angustia y tristeza.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Entonces invoqué el Nombre de Yavé:","poem":1},{"lineBreak":true},{"text":"Oh Yavé, te busco, libra mi alma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bondadoso y justo es Yavé.","poem":1},{"lineBreak":true},{"text":"Sí, misericordioso es nuestro ʼElohim.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yavé guarda a los sencillos.","poem":1},{"lineBreak":true},{"text":"Estaba yo postrado","poem":1},{"lineBreak":true},{"text":"Y Él me salvó.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vuelve, alma mía, a tu reposo,","poem":1},{"lineBreak":true},{"text":"Porque Yavé te llenó de bien.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tú libraste mi vida de la muerte,","poem":1},{"lineBreak":true},{"text":"Mis ojos, de las lágrimas,","poem":1},{"lineBreak":true},{"text":"Y mis pies, de tropezar.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Andaré delante de Yavé","poem":1},{"lineBreak":true},{"text":"En la tierra de los vivientes.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Creí, por tanto hablé:","poem":1},{"lineBreak":true},{"text":"Estoy afligido en gran manera.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Y dije en mi apresuramiento:","poem":1},{"lineBreak":true},{"text":"Todo hombre es mentiroso.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Qué pagaré a Yavé","poem":1},{"lineBreak":true},{"text":"Por todos sus beneficios para mí?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Levantaré la copa de la salvación","poem":1},{"lineBreak":true},{"text":"E invocaré el Nombre de Yavé.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A Yavé cumpliré mis votos","poem":1},{"lineBreak":true},{"text":"En presencia de todo su pueblo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Estimada es a los ojos de Yavé","poem":1},{"lineBreak":true},{"text":"La muerte de sus santos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Oh Yavé, ciertamente yo soy tu esclavo.","poem":1},{"lineBreak":true},{"text":"Esclavo tuyo soy, hijo de tu esclava,","poem":1},{"lineBreak":true},{"text":"Tú desataste mis ataduras.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Te ofreceré sacrificio de acción de gracias","poem":1},{"lineBreak":true},{"text":"E invocaré el Nombre de Yavé.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"A Yavé cumpliré mis votos,","poem":1},{"lineBreak":true},{"text":"En presencia de todo su pueblo,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"En los patios de la Casa de Yavé,","poem":1},{"lineBreak":true},{"text":"En medio de ti, oh Jerusalén.","poem":1},{"lineBreak":true},{"text":"¡Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}