{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"Den gracias a Yavé, porque Él es bueno,","poem":1},{"lineBreak":true},{"text":"Porque para siempre es su misericordia.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Diga ahora Israel:","poem":1},{"lineBreak":true},{"text":"Que para siempre es su misericordia.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Diga la casa de Aarón:","poem":1},{"lineBreak":true},{"text":"Que para siempre es su misericordia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Digan ahora los que temen a Yavé:","poem":1},{"lineBreak":true},{"text":"Que para siempre es su misericordia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"En mi angustia clamé a YA,","poem":1},{"lineBreak":true},{"text":"Y YA me respondió","poem":1},{"lineBreak":true},{"text":"Y me colocó en lugar amplio.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yavé está conmigo,","poem":1},{"lineBreak":true},{"text":"No temeré","poem":1},{"lineBreak":true},{"text":"Lo que me haga el hombre.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yavé está conmigo entre los que me ayudan.","poem":1},{"lineBreak":true},{"text":"Por tanto veré mi deseo en los que me odian.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mejor es refugiarse en Yavé","poem":1},{"lineBreak":true},{"text":"Que confiar en hombre.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mejor es refugiarse en Yavé","poem":1},{"lineBreak":true},{"text":"Que confiar en los poderosos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Todas las naciones me rodearon.","poem":1},{"lineBreak":true},{"text":"En el Nombre de Yavé yo las destruiré.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Me rodearon,","poem":1},{"lineBreak":true},{"text":"Sí, me asediaron.","poem":1},{"lineBreak":true},{"text":"En el Nombre de Yavé ciertamente las destruiré.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Me rodearon como abejas.","poem":1},{"lineBreak":true},{"text":"Se extinguieron como fuego de espinos.","poem":1},{"lineBreak":true},{"text":"En el Nombre de Yavé yo ciertamente las destruiré.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ustedes me empujaron con violencia","poem":1},{"lineBreak":true},{"text":"De modo que estaba cayendo,","poem":1},{"lineBreak":true},{"text":"Pero me ayudó Yavé.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mi Fortaleza y mi Canto es YA.","poem":1},{"lineBreak":true},{"text":"Él es mi salvación.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Voz de júbilo y de salvación hay en las tiendas de los justos.","poem":1},{"lineBreak":true},{"text":"La mano derecha de Yavé hace proezas.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"La mano derecha de Yavé está levantada en alto.","poem":1},{"lineBreak":true},{"text":"La mano derecha de Yavé realiza hazañas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"No moriré, sino viviré,","poem":1},{"lineBreak":true},{"text":"Y contaré las obras de YA.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Me disciplinó severamente YA,","poem":1},{"lineBreak":true},{"text":"Pero no me entregó a la muerte.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ábranme las puertas de la justicia.","poem":1},{"lineBreak":true},{"text":"Entraré por ellas,","poem":1},{"lineBreak":true},{"text":"Daré gracias a YA.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Esta es la puerta de Yavé.","poem":1},{"lineBreak":true},{"text":"Por ella entrarán los justos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Te alabaré porque me escuchaste,","poem":1},{"lineBreak":true},{"text":"Y fuiste mi salvación.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"La piedra que desecharon los edificadores","poem":1},{"lineBreak":true},{"text":"Es cabeza del ángulo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Esta es la obra de Yavé.","poem":1},{"lineBreak":true},{"text":"Es maravillosa ante nuestros ojos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Este es el día que hizo Yavé.","poem":1},{"lineBreak":true},{"text":"¡Regocijémonos y alegrémonos en él!","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Te imploramos, oh Yavé. ¡Sálvanos ahora!","poem":1},{"lineBreak":true},{"text":"Te rogamos, oh Yavé que nos prosperes ahora.","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"¡Bendito el que viene en el Nombre de Yavé!","poem":1},{"lineBreak":true},{"text":"Desde la Casa de Yavé los bendecimos.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ʼEL es Yavé, y nos dio luz,","poem":1},{"lineBreak":true},{"text":"Aten con cuerdas sacrificios festivos a los cuernos del altar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Tú eres mi ʼEL, y te doy gracias.","poem":1},{"lineBreak":true},{"text":"Tú eres mi ʼElohim, te exaltaré.","poem":1}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Den gracias a Yavé porque Él es bueno,","poem":1},{"lineBreak":true},{"text":"Porque para siempre es su misericordia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}