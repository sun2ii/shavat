{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["Al director del coro. Con arpa en octava baja. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"¡Salva, oh Yavé, porque se acaban los piadosos!","poem":1},{"lineBreak":true},{"text":"Porque desaparecen los fieles entre los hijos de los hombres.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hablan vanidades, cada uno a su prójimo.","poem":1},{"lineBreak":true},{"text":"Hablan con labios lisonjeros y doblez de corazón.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¡Corte Yavé todos los labios lisonjeros,","poem":1},{"lineBreak":true},{"text":"La boca que habla altanerías!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Los que dicen: Prevaleceremos con nuestra lengua.","poem":1},{"lineBreak":true},{"text":"Nuestros labios son nuestros.","poem":1},{"lineBreak":true},{"text":"¿Quién es ʼAdón sobre nosotros?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Por la opresión a los pobres,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Por el gemido del menesteroso,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Ahora me levantaré, dice Yavé.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Pondré en seguridad al que por ella suspira.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Las Palabras de Yavé son Palabras puras,","poem":1},{"lineBreak":true},{"text":"Como plata refinada en un crisol en la tierra","poem":1},{"lineBreak":true},{"text":"Purificada siete veces.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tú los guardarás, oh Yavé,","poem":1},{"lineBreak":true},{"text":"Los guardarás de esta generación para siempre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Por todos lados los impíos deambulan","poem":1},{"lineBreak":true},{"text":"Cuando la vileza es exaltada entre los hijos de los hombres.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}