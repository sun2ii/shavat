{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Canto de ascenso gradual120:0 Gradual: O de las subidas, o peregrinaciones. Probablemente se cantaban en las subidas anuales a Jerusalén."]},{"type":"verse","number":1,"content":[{"text":"En mi angustia clamé a Yavé,","poem":1},{"lineBreak":true},{"text":"Y Él me respondió.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oh Yavé, libra mi vida de labios mentirosos,","poem":1},{"lineBreak":true},{"text":"De una lengua engañadora.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Qué se te dará,","poem":1},{"lineBreak":true},{"text":"O qué más se te hará,","poem":1},{"lineBreak":true},{"text":"Oh lengua engañosa?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Agudas flechas de guerrero,","poem":1},{"lineBreak":true},{"text":"Forjadas con brasas de enebro.","poem":1},{"noteId":24}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Ay de mí, porque vivo desterrado en Mesec,","poem":1},{"lineBreak":true},{"text":"Y habito entre las tiendas de Cedar!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mucho tiempo estuvo mi alma","poem":1},{"lineBreak":true},{"text":"Con los que aborrecen la paz.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yo soy pacífico, pero cuando hablo,","poem":1},{"lineBreak":true},{"text":"Ellos me declaran la guerra.","poem":1}]}],"footnotes":[{"noteId":24,"caller":"+","text":"Enebro: arbusto de madera muy dura.","reference":{"chapter":120,"verse":4}}]},"thisChapterLink":"/api/spa_pdt/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}