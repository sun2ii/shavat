":6,"content":[{"lineBreak":true},{"text":"El sol no te fatigará de día,","poem":1},{"lineBreak":true},{"text":"Ni la luna de noche.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yavé te protegerá de todo mal.","poem":1},{"lineBreak":true},{"text":"Él guardará tu alma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yavé guardará tu salida y tu entrada","poem":1},{"lineBreak":true},{"text":"Desde ahora y para siempre.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}