ak":true},{"text":"Sobre nuestras vidas habrían pasado las aguas impetuosas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bendito sea Yavé,","poem":1},{"lineBreak":true},{"text":"Quien no nos entregó como presa de los dientes de ellos.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Como un ave que escapa de la trampa del cazador,","poem":1},{"lineBreak":true},{"text":"Así escapó nuestra alma.","poem":1},{"lineBreak":true},{"text":"¡La trampa se rompió,","poem":1},{"lineBreak":true},{"text":"Y nosotros escapamos!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nuestro socorro está en el Nombre de Yavé,","poem":1},{"lineBreak":true},{"text":"Quien hizo el cielo y la tierra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}