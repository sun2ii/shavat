:1},{"lineBreak":true},{"text":"Y a los que son rectos en su corazón.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Pero a los que se apartan a sus caminos torcidos,","poem":1},{"lineBreak":true},{"text":"Yavé los llevará con los que hacen iniquidad.","poem":1},{"lineBreak":true},{"text":"¡Paz sea sobre Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}