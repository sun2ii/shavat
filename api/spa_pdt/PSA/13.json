{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["Al director del coro. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"¿Hasta cuándo, oh Yavé?","poem":1},{"lineBreak":true},{"text":"¿Me olvidarás para siempre?","poem":1},{"lineBreak":true},{"text":"¿Hasta cuándo esconderás tu rostro de mí?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¿Hasta cuándo pensaré profundamente","poem":1},{"lineBreak":true},{"text":"Con tristeza en mi corazón cada día?","poem":1},{"lineBreak":true},{"text":"¿Hasta cuándo mi enemigo será enaltecido sobre mí?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¡Considera, oh Yavé, ʼElohim mío, y respóndeme!","poem":1},{"lineBreak":true},{"text":"Ilumina mis ojos, no sea que duerma el sueño de la muerte,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"No sea que mi enemigo diga: ¡Lo vencí!","poem":1},{"lineBreak":true},{"text":"Mis adversarios gozan cuando soy sacudido.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Confío en tu misericordia,","poem":1},{"lineBreak":true},{"text":"Y mi corazón se gozará en tu salvación.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cantaré a Yavé","poem":1},{"lineBreak":true},{"text":"Porque me llenó de bienes.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}