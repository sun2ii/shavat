{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["Canto de ascenso gradual"]},{"type":"verse","number":1,"content":[{"text":"Acuérdate, oh Yavé, de David,","poem":1},{"lineBreak":true},{"text":"Y de toda su aflicción.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"De cómo juró a Yavé,","poem":1},{"lineBreak":true},{"text":"Y prometió al Fuerte de Jacob:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ciertamente no entraré en mi tienda,","poem":1},{"lineBreak":true},{"text":"Ni subiré a mi cama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"No concederé sueño a mis ojos,","poem":1},{"lineBreak":true},{"text":"Ni a mis párpados calma,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Hasta que halle lugar para Yavé,","poem":1},{"lineBreak":true},{"text":"Tabernáculo para el Fuerte de Jacob.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ciertamente oímos de ello en Efrata.","poem":1},{"lineBreak":true},{"text":"Lo hallamos en el campo del bosque.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Entremos en su Tabernáculo,","poem":1},{"lineBreak":true},{"text":"Postrémonos ante el estrado de sus pies.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oh Yavé, levántate y ven al lugar de tu reposo,","poem":1},{"lineBreak":true},{"text":"Tú y el Arca de tu poder.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Que tus sacerdotes se vistan de justicia,","poem":1},{"lineBreak":true},{"text":"Y se regocijen tus santos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Por amor a David tu esclavo,","poem":1},{"lineBreak":true},{"text":"No vuelvas el rostro de tu ungido.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"En verdad Yavé juró a David,","poem":1},{"lineBreak":true},{"text":"Y no se retractará de ello:","poem":1},{"lineBreak":true},{"text":"De tu descendencia sentaré en tu trono.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Si tus hijos observan mi Pacto,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y mi testimonio que Yo les enseño,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Tus hijos también se sentarán en tu trono para siempre.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Porque Yavé escogió a Sion.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"La deseó para morada suya:","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Este es el lugar de mi reposo para siempre.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Aquí moraré, porque lo deseé.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Con abundancia bendeciré su provisión,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y saciaré de pan a sus necesitados.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Vestiré con salvación a sus sacerdotes,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y sus santos darán voces de júbilo.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Allí retoñará el poder de David.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Dispuse una lámpara para mi ungido.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A sus enemigos vestiré de vergüenza,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Pero sobre él resplandecerá su corona.","wordsOfJesus":true,"poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}