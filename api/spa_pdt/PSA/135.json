{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"heading","content":["¡Aleluya!"]},{"type":"verse","number":1,"content":[{"text":"Alaben el Nombre de Yavé.","poem":1},{"lineBreak":true},{"text":"Alábenlo, esclavos de Yavé,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ustedes quienes están en la Casa de Yavé,","poem":1},{"lineBreak":true},{"text":"En los patios de la Casa de nuestro ʼElohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¡Aleluya, porque Yavé es bueno!","poem":1},{"lineBreak":true},{"text":"Canten salmos a su Nombre,","poem":1},{"lineBreak":true},{"text":"Porque eso es agradable.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Porque YA escogió a Jacob para Él,","poem":1},{"lineBreak":true},{"text":"A Israel como su posesión.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Porque yo sé que Yavé es grande,","poem":1},{"lineBreak":true},{"text":"Y que nuestro ʼAdonay está por encima de todos los ʼelohim.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yavé hace todo lo que quiere,","poem":1},{"lineBreak":true},{"text":"Tanto en el cielo como en la tierra,","poem":1},{"lineBreak":true},{"text":"En los mares y en todos los abismos.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Él impulsa","poem":1},{"lineBreak":true},{"text":"Para que las nieblas suban desde los confines de la tierra.","poem":1},{"lineBreak":true},{"text":"Produce relámpagos para la lluvia,","poem":1},{"lineBreak":true},{"text":"Saca de sus tesoros el viento.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Él fue el que mató a los primogénitos de Egipto,","poem":1},{"lineBreak":true},{"text":"Tanto del hombre como del animal.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"En medio de Ti, oh Egipto, envió señales y prodigios,","poem":1},{"lineBreak":true},{"text":"Contra Faraón y todos sus esclavos.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Destruyó a muchas naciones,","poem":1},{"lineBreak":true},{"text":"Y mató a reyes poderosos:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A Sehón rey de los amorreos,","poem":1},{"lineBreak":true},{"text":"A Og rey de Basán,","poem":1},{"lineBreak":true},{"text":"Y a todos los reyes de Canaán.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dio la tierra de ellos","poem":1},{"lineBreak":true},{"text":"Como heredad a su pueblo Israel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Oh Yavé, eterno es tu Nombre.","poem":1},{"lineBreak":true},{"text":"Tu memoria, oh Yavé, por todas las generaciones.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Porque Yavé juzgará a su pueblo","poem":1},{"lineBreak":true},{"text":"Y tendrá compasión de sus esclavos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Los ídolos de las naciones son de plata y oro,","poem":1},{"lineBreak":true},{"text":"Obra de manos de hombre.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tienen bocas, pero no hablan.","poem":1},{"lineBreak":true},{"text":"Tienen ojos, pero no ven.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tienen orejas, pero no oyen,","poem":1},{"lineBreak":true},{"text":"Tampoco hay aliento en sus bocas.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Los que las hacen son semejantes a ellos,","poem":1},{"lineBreak":true},{"text":"Y todo el que confía en ellos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¡Oh casa de Israel, bendiga a Yavé!","poem":1},{"lineBreak":true},{"text":"¡Oh casa de Aarón, bendiga a Yavé!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"¡Oh casa de Leví, bendiga a Yavé!","poem":1},{"lineBreak":true},{"text":"¡Los que temen a Yavé, bendigan a Yavé!","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"¡Desde Sion, bendito sea Yavé,","poem":1},{"lineBreak":true},{"text":"Quien mora en Jerusalén!","poem":1},{"lineBreak":true},{"text":"¡Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}