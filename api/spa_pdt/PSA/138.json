{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Oh Yavé, te doy gracias con todo mi corazón.","poem":1},{"lineBreak":true},{"text":"Te cantaré alabanzas delante de los ʼelohim.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Me postraré hacia tu santo Templo","poem":1},{"lineBreak":true},{"text":"Y daré gracias a tu Nombre por tu misericordia y tu verdad,","poem":1},{"lineBreak":true},{"text":"Porque engrandeciste tu Palabra por encima de todo tu Nombre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"El día cuando invoqué,","poem":1},{"lineBreak":true},{"text":"Tú me respondiste.","poem":1},{"lineBreak":true},{"text":"Me volviste atrevido con fortaleza en mi alma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Todos los reyes de la tierra te darán gracias, oh Yavé,","poem":1},{"lineBreak":true},{"text":"Cuando oigan las Palabras de tu boca.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Y cantarán de los caminos de Yavé,","poem":1},{"lineBreak":true},{"text":"¡Porque grande es la gloria de Yavé!","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Porque aunque Yavé es exaltado,","poem":1},{"lineBreak":true},{"text":"Sin embargo, atiende al humilde,","poem":1},{"lineBreak":true},{"text":"Pero al altivo conoce de lejos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Aunque yo ande en medio de la aflicción,","poem":1},{"lineBreak":true},{"text":"Tú me vivificarás.","poem":1},{"lineBreak":true},{"text":"Extenderás tu mano contra la ira de mis enemigos,","poem":1},{"lineBreak":true},{"text":"Y me salvará tu mano derecha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yavé hará lo que concierne a mí.","poem":1},{"lineBreak":true},{"text":"Oh Yavé, tu misericordia es para siempre,","poem":1},{"lineBreak":true},{"text":"No desampares la obra de tus manos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}