{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["Al director del coro. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"El necio dice en su corazón: ¡No existe ʼElohim!","poem":1},{"lineBreak":true},{"text":"Están corrompidos, hicieron obras repugnantes.","poem":1},{"lineBreak":true},{"text":"No hay quien haga el bien.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yavé miró desde los cielos sobre los hijos de los hombres","poem":1},{"lineBreak":true},{"text":"Para ver si había algún entendido que buscara a ʼElohim.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Todos se desviaron. Juntamente se corrompieron.","poem":1},{"lineBreak":true},{"text":"No hay quien haga lo bueno, ni siquiera uno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿No tienen discernimiento todos los que hacen iniquidad,","poem":1},{"lineBreak":true},{"text":"Que devoran a mi pueblo como si comieran pan","poem":1},{"lineBreak":true},{"text":"Y no invocan a Yavé?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Allí temblarán de espanto,","poem":1},{"lineBreak":true},{"text":"Porque ʼElohim está con la generación de los justos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Se burlan del consejo del pobre,","poem":1},{"lineBreak":true},{"text":"Pero Yavé es su refugio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Oh, que de Sion venga la salvación de Israel!","poem":1},{"lineBreak":true},{"text":"Cuando Yavé restaure a su pueblo cautivo,","poem":1},{"lineBreak":true},{"text":"Se regocijará Jacob y se alegrará Israel.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}