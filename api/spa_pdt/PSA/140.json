{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"heading","content":["Al director del coro. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Rescátame, oh Yavé, de hombres perversos.","poem":1},{"lineBreak":true},{"text":"Guárdame de hombres violentos","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Que maquinan cosas malas en sus corazones.","poem":1},{"lineBreak":true},{"text":"Continuamente promueven guerras,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Afilan su lengua como serpiente.","poem":1},{"lineBreak":true},{"text":"Veneno de víbora hay debajo de sus labios. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Guárdame, oh Yavé, de las manos de los perversos.","poem":1},{"lineBreak":true},{"text":"Guárdame de hombres violentos,","poem":1},{"lineBreak":true},{"text":"Que se proponen que vacilen mis pies.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Soberbios esconden trampa y cuerdas contra mí,","poem":1},{"lineBreak":true},{"text":"Junto al sendero me extienden una red. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Digo a Yavé: Tú eres mi ʼElohim.","poem":1},{"lineBreak":true},{"text":"Presta oído, oh Yavé, a la voz de mis súplicas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oh Yavé ʼAdonay, Fortaleza de mi salvación,","poem":1},{"lineBreak":true},{"text":"Cubriste mi cabeza en el día de la batalla.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"No concedas, oh Yavé, los deseos del perverso.","poem":1},{"lineBreak":true},{"text":"No promuevas su designio de ser ellos exaltados. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"En cuanto a la cabeza de los que me rodean,","poem":1},{"lineBreak":true},{"text":"Cúbralos la perversidad de sus propios labios.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Que caigan sobre ellos carbones encendidos.","poem":1},{"lineBreak":true},{"text":"Que sean echados al fuego","poem":1},{"lineBreak":true},{"text":"En abismos profundos de donde no puedan salir.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Que el difamador no sea establecido en la tierra.","poem":1},{"lineBreak":true},{"text":"Que el mal cace velozmente al varón violento.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Yo sé que Yavé defiende la causa del afligido,","poem":1},{"lineBreak":true},{"text":"Y la justicia para el pobre.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ciertamente los justos darán gracias a tu Nombre,","poem":1},{"lineBreak":true},{"text":"Los rectos vivirán en tu Presencia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}