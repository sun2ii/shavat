{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"heading","content":["Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"¡Oh Yavé, a Ti clamo, apresúrate hacia mí!","poem":1},{"lineBreak":true},{"text":"Presta oído a mi voz cuando te invoco.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Que mi oración sea contada como incienso delante de Ti,","poem":1},{"lineBreak":true},{"text":"El levantamiento de mis manos como la ofrenda de la tarde.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pon, oh Yavé, un guardia sobre mi boca.","poem":1},{"lineBreak":true},{"text":"Vigila la puerta de mis labios.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"No inclines mi corazón a alguna cosa perversa,","poem":1},{"lineBreak":true},{"text":"Para que haga obras de perversidad","poem":1},{"lineBreak":true},{"text":"Con hombres que practican iniquidad,","poem":1},{"lineBreak":true},{"text":"Y no me dejes probar sus golosinas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Que el justo me castigue con bondad","poem":1},{"lineBreak":true},{"text":"Y me reprenda.","poem":1},{"lineBreak":true},{"text":"No permitas que el aceite del impío embellezca mi cabeza.","poem":1},{"lineBreak":true},{"text":"Porque aun mi oración está contra las obras perversas.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Sean lanzados sus jueces por las laderas de la peña.","poem":1},{"lineBreak":true},{"text":"Y oigan mis palabras, porque son agradables.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Como cuando uno ara y rompe la tierra,","poem":1},{"lineBreak":true},{"text":"Nuestros huesos fueron esparcidos en la boca del Seol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pero mis ojos están hacia Ti, oh Yavé, ʼAdonay.","poem":1},{"lineBreak":true},{"text":"En Ti me refugio.","poem":1},{"lineBreak":true},{"text":"No me dejes indefenso.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Guárdame de las trampas que me tendieron","poem":1},{"lineBreak":true},{"text":"Y de las trampas de los que cometen iniquidad.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Que los perversos caigan en sus propias redes","poem":1},{"lineBreak":true},{"text":"Mientras yo paso con seguridad.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}