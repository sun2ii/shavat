{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["Instrucción (Maskil) de David cuando estaba en la cueva. Oración"]},{"type":"verse","number":1,"content":[{"text":"Con mi voz clamo a Yavé.","poem":1},{"lineBreak":true},{"text":"Con mi voz suplico a Yavé.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ante Él derramo mi queja.","poem":1},{"lineBreak":true},{"text":"Declaro mi aflicción ante Él.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Cuando mi espíritu desmayaba dentro de mí,","poem":1},{"lineBreak":true},{"text":"Tú conociste mi sendero.","poem":1},{"lineBreak":true},{"text":"En el camino por donde ando","poem":1},{"lineBreak":true},{"text":"Ellos me escondieron una trampa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Miro a la derecha y observo","poem":1},{"lineBreak":true},{"text":"Que no hay uno quien me atienda.","poem":1},{"lineBreak":true},{"text":"No hay escape para mí.","poem":1},{"lineBreak":true},{"text":"Nadie se preocupa por mi vida.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A Ti clamo, oh Yavé.","poem":1},{"lineBreak":true},{"text":"Digo: Tú eres mi Refugio,","poem":1},{"lineBreak":true},{"text":"Mi porción en la tierra de los que viven.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Presta oído a mi clamor,","poem":1},{"lineBreak":true},{"text":"Porque estoy muy abatido.","poem":1},{"lineBreak":true},{"text":"Líbrame de mis perseguidores,","poem":1},{"lineBreak":true},{"text":"Porque son demasiado fuertes para mí.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Saca mi vida de la prisión,","poem":1},{"lineBreak":true},{"text":"Para que dé gracias a tu Nombre.","poem":1},{"lineBreak":true},{"text":"Me rodearán los justos,","poem":1},{"lineBreak":true},{"text":"Porque Tú me tratarás con abundancia.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}