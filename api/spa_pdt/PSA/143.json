{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"heading","content":["Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Oh Yavé, escucha mi oración.","poem":1},{"lineBreak":true},{"text":"Presta oído a mis súplicas.","poem":1},{"lineBreak":true},{"text":"Por tu fidelidad, por tu justicia respóndeme.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"No entres a juicio con tu esclavo,","poem":1},{"lineBreak":true},{"text":"Porque ante tu vista ningún hombre que viva es justo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Porque el enemigo persiguió mi vida.","poem":1},{"lineBreak":true},{"text":"Humilló mi vida hasta el suelo.","poem":1},{"lineBreak":true},{"text":"Me obligó a habitar en tenebrosidad, como los muertos.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Por tanto, mi espíritu desfallece dentro de mí,","poem":1},{"lineBreak":true},{"text":"Mi corazón está desolado.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Recuerdo los días de antaño.","poem":1},{"lineBreak":true},{"text":"Medito en todas tus obras.","poem":1},{"lineBreak":true},{"text":"Reflexiono sobre la obra de tus manos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A Ti levanto mis manos.","poem":1},{"lineBreak":true},{"text":"Mi alma te anhela como una tierra seca. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Oh Yavé, respóndeme pronto.","poem":1},{"lineBreak":true},{"text":"Mi espíritu desfallece.","poem":1},{"lineBreak":true},{"text":"No escondas de mí tu rostro,","poem":1},{"lineBreak":true},{"text":"O seré como los que bajan a la fosa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Que yo escuche por la mañana tu misericordia,","poem":1},{"lineBreak":true},{"text":"Porque en Ti confío.","poem":1},{"lineBreak":true},{"text":"Enséñame el camino en el cual debo andar,","poem":1},{"lineBreak":true},{"text":"Porque a Ti levanto mi alma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Oh Yavé, líbrame de mis enemigos.","poem":1},{"lineBreak":true},{"text":"Me refugio en Ti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Enséñame a hacer tu voluntad,","poem":1},{"lineBreak":true},{"text":"Porque Tú eres mi ʼElohim,","poem":1},{"lineBreak":true},{"text":"Que tu buen Espíritu me guíe por tierra nivelada.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Revíveme, oh Yavé, por amor a tu Nombre.","poem":1},{"lineBreak":true},{"text":"Por tu justicia saca mi alma de la aflicción.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Con tu misericordia corta a mis adversarios","poem":1},{"lineBreak":true},{"text":"Y destruye a todos los que afligen mi alma,","poem":1},{"lineBreak":true},{"text":"Porque soy tu esclavo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}