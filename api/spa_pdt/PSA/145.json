{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"heading","content":["Alabanza. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Te exaltaré, mi ʼElohim, oh Rey,","poem":1},{"lineBreak":true},{"text":"Y bendeciré tu Nombre eternamente y para siempre.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Cada día te bendeciré y alabaré tu Nombre","poem":1},{"lineBreak":true},{"text":"Eternamente y para siempre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Grande es Yavé, y digno de suprema alabanza,","poem":1},{"lineBreak":true},{"text":"Y su grandeza es inescrutable.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Una generación a otra generación alabará tus obras,","poem":1},{"lineBreak":true},{"text":"Y declarará tus poderosas obras.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Meditaré en el glorioso esplendor de tu majestad","poem":1},{"lineBreak":true},{"text":"Y en tus maravillosas obras.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hablarán los hombres del poder de tus asombrosas obras,","poem":1},{"lineBreak":true},{"text":"Y yo contaré tu grandeza.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Con anhelo proclamarán la memoria de tu gran bondad,","poem":1},{"lineBreak":true},{"text":"Y clamarán de tu justicia con regocijo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Clemente y misericordioso es Yavé.","poem":1},{"lineBreak":true},{"text":"Lento para la ira y grande en misericordia.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yavé es bueno para todos,","poem":1},{"lineBreak":true},{"text":"Y sus misericordias están sobre todas sus obras.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Oh Yavé, todas tus obras te darán gracias,","poem":1},{"lineBreak":true},{"text":"Y tus santos te bendecirán.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hablarán de la gloria de tu reino,","poem":1},{"lineBreak":true},{"text":"Y conversarán sobre tu poder.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Para proclamar a los hijos de hombres tus poderosas obras,","poem":1},{"lineBreak":true},{"text":"Y la gloria de la majestad de tu reino.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tu reino es eterno,","poem":1},{"lineBreak":true},{"text":"Y tu señorío por todas las generaciones.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yavé sostiene a todos los que caen","poem":1},{"lineBreak":true},{"text":"Y levanta a todos los que están doblegados.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Los ojos de todos miran a Ti.","poem":1},{"lineBreak":true},{"text":"Y en su tiempo Tú les das su alimento.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Abres tu mano","poem":1},{"lineBreak":true},{"text":"Y sacias el deseo de todo ser viviente.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Justo es Yavé en todos sus procedimientos,","poem":1},{"lineBreak":true},{"text":"Y bondadoso en todas sus obras.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Cerca está Yavé de todos los que lo invocan,","poem":1},{"lineBreak":true},{"text":"De todos los que lo invocan en verdad.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Cumplirá el deseo de los que le temen.","poem":1},{"lineBreak":true},{"text":"Escuchará también su clamor,","poem":1},{"lineBreak":true},{"text":"Y los salvará.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Yavé guarda a todos los que lo aman,","poem":1},{"lineBreak":true},{"text":"Pero destruirá a los perversos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mi boca hablará la alabanza de Yavé,","poem":1},{"lineBreak":true},{"text":"¡Y todo ser viviente bendecirá su santo Nombre","poem":1},{"lineBreak":true},{"text":"Eternamente y para siempre!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}