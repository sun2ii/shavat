{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"¡Aleluya!","poem":1},{"lineBreak":true},{"text":"¡Alaba, alma mía, a Yavé!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alabaré a Yavé en mi vida.","poem":1},{"lineBreak":true},{"text":"Cantaré alabanzas a mi ʼElohim mientras viva.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"No confíen en gobernantes,","poem":1},{"lineBreak":true},{"text":"En un hijo de hombre, en quien no hay salvación.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sale su espíritu, vuelve a la tierra.","poem":1},{"lineBreak":true},{"text":"Ese mismo día perecen sus planes.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Inmensamente feliz es aquél","poem":1},{"lineBreak":true},{"text":"Cuya Ayuda es el ʼElohim de Jacob,","poem":1},{"lineBreak":true},{"text":"Cuya esperanza está en Yavé su ʼElohim,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Quien hizo el cielo y la tierra,","poem":1},{"lineBreak":true},{"text":"El mar y todo lo que hay en ellos,","poem":1},{"lineBreak":true},{"text":"Quien guarda su fidelidad para siempre,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Quien ejecuta justicia a los oprimidos,","poem":1},{"lineBreak":true},{"text":"Quien da alimento a los hambrientos.","poem":1},{"lineBreak":true},{"text":"Yavé liberta a los prisioneros,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yavé da vista a los ciegos,","poem":1},{"lineBreak":true},{"text":"Yavé endereza a los encorvados,","poem":1},{"lineBreak":true},{"text":"Yavé ama a los justos,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yavé protege a los extranjeros,","poem":1},{"lineBreak":true},{"text":"Él sostiene al huérfano y a la viuda,","poem":1},{"lineBreak":true},{"text":"Pero Él trastorna el camino de los perversos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Reinará Yavé para siempre,","poem":1},{"lineBreak":true},{"text":"Tu ʼElohim, oh Sion, por todas las generaciones.","poem":1},{"lineBreak":true},{"text":"¡Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}