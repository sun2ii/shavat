{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"¡Aleluya!","poem":1},{"lineBreak":true},{"text":"Porque es bueno cantar salmos a nuestro ʼElohim,","poem":1},{"lineBreak":true},{"text":"Porque agradable, hermosa es la alabanza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yavé edifica a Jerusalén.","poem":1},{"lineBreak":true},{"text":"Él reúne a los desterrados de Israel.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Él sana a los quebrantados de corazón","poem":1},{"lineBreak":true},{"text":"Y venda sus heridas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Él cuenta el número de las estrellas.","poem":1},{"lineBreak":true},{"text":"Él da nombres a todas ellas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Grande es nuestro ʼAdonay","poem":1},{"lineBreak":true},{"text":"Y prominente en fortaleza.","poem":1},{"lineBreak":true},{"text":"Su entendimiento es infinito.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yavé sostiene a los afligidos.","poem":1},{"lineBreak":true},{"text":"Él abate a los perversos hasta la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Canten a Yavé con acción de gracias.","poem":1},{"lineBreak":true},{"text":"Canten salmos a nuestro ʼElohim con el arpa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Quien cubre de nubes el cielo,","poem":1},{"lineBreak":true},{"text":"Quien provee lluvia para la tierra,","poem":1},{"lineBreak":true},{"text":"Quien desarrolla la hierba en las montañas.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Él da a la bestia su alimento,","poem":1},{"lineBreak":true},{"text":"A las crías de los cuervos que claman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"No se deleita con la fuerza del caballo,","poem":1},{"lineBreak":true},{"text":"No se complace en las piernas de un hombre.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yavé favorece a los que le temen,","poem":1},{"lineBreak":true},{"text":"Los que esperan su misericordia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¡Alaba a Yavé, oh Jerusalén!","poem":1},{"lineBreak":true},{"text":"¡Alaba a tu ʼElohim, oh Sion!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Porque Él refuerza los cerrojos de tus puertas,","poem":1},{"lineBreak":true},{"text":"Él bendice a tus hijos dentro de ti.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Él establece paz en tus fronteras,","poem":1},{"lineBreak":true},{"text":"Él te sacia con lo mejor del trigo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Él envía su mandato a la tierra,","poem":1},{"lineBreak":true},{"text":"Su Palabra corre velozmente.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Él da nieve como lana,","poem":1},{"lineBreak":true},{"text":"Él esparce la escarcha como ceniza.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Él lanza su nieve como migas.","poem":1},{"lineBreak":true},{"text":"¿Quién puede resistir su helada?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Envía su Palabra,","poem":1},{"lineBreak":true},{"text":"Y la derrite,","poem":1},{"lineBreak":true},{"text":"Impulsa su viento para que sople,","poem":1},{"lineBreak":true},{"text":"Y fluyan las aguas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Él declara sus Palabras a Jacob,","poem":1},{"lineBreak":true},{"text":"Sus Estatutos y Ordenanzas a Israel.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"No trató así con ninguna nación.","poem":1},{"lineBreak":true},{"text":"Ninguna otra conoció sus ordenanzas.","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}