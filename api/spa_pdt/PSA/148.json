{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"¡Aleluya!","poem":1},{"lineBreak":true},{"text":"Alaben a Yavé desde los cielos.","poem":1},{"lineBreak":true},{"text":"Alábenlo en las alturas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alábenlo, todos sus ángeles.","poem":1},{"lineBreak":true},{"text":"Alábenlo, todas sus huestes.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alábenlo, sol y luna.","poem":1},{"lineBreak":true},{"text":"Alábenlo, todas lucientes estrellas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alábenlo, los más altos cielos,","poem":1},{"lineBreak":true},{"text":"Y las aguas que están sobre los cielos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alaben el Nombre de Yavé,","poem":1},{"lineBreak":true},{"text":"Porque Él mandó,","poem":1},{"lineBreak":true},{"text":"Y fueron creados.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Y los estableció eternamente y para siempre.","poem":1},{"lineBreak":true},{"text":"Él dio un decreto que no pasará.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alaben a Yavé desde la tierra:","poem":1},{"lineBreak":true},{"text":"Cetáceos y todos los abismos,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"El fuego y el granizo, la nieve y el vapor,","poem":1},{"lineBreak":true},{"text":"El viento tempestuoso que ejecuta su Palabra,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Las montañas y todas las colinas,","poem":1},{"lineBreak":true},{"text":"Árboles frutales y todo cedro,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Los animales salvajes y todo ganado,","poem":1},{"lineBreak":true},{"text":"Reptiles y ave alada,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Reyes de la tierra y todos los pueblos,","poem":1},{"lineBreak":true},{"text":"Magistrados y todos los jueces de la tierra,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tanto jóvenes varones como doncellas,","poem":1},{"lineBreak":true},{"text":"Los ancianos y los niños,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alaben el Nombre de Yavé,","poem":1},{"lineBreak":true},{"text":"Porque solo su Nombre es exaltado.","poem":1},{"lineBreak":true},{"text":"Su gloria está por encima de la tierra y el cielo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Y Él levantó un poder para su pueblo,","poem":1},{"lineBreak":true},{"text":"Alabanza para todos sus fieles,","poem":1},{"lineBreak":true},{"text":"De los hijos de Israel, un pueblo cercano a Él.","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}