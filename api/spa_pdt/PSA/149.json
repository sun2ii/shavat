{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"¡Aleluya!","poem":1},{"lineBreak":true},{"text":"Canten a Yavé un canto nuevo","poem":1},{"lineBreak":true},{"text":"Su alabanza esté en la congregación de los santos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alégrese Israel en su Hacedor.","poem":1},{"lineBreak":true},{"text":"Regocíjense en su Rey los hijos de Sion.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alaben su Nombre con danza.","poem":1},{"lineBreak":true},{"text":"Cántenle alabanzas con pandero y arpa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Porque Yavé se complace en su pueblo,","poem":1},{"lineBreak":true},{"text":"Embellecerá a los humildes con salvación.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Que los fieles exalten su gloria.","poem":1},{"lineBreak":true},{"text":"Que canten con regocijo en sus camas.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Que enaltezcan a ʼEL con su boca,","poem":1},{"lineBreak":true},{"text":"Con una espada de dos filos en su mano","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Para ejecutar venganza sobre las naciones","poem":1},{"lineBreak":true},{"text":"Y castigo sobre los pueblos,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Para atar a sus reyes con cadenas,","poem":1},{"lineBreak":true},{"text":"Y a sus nobles con grilletes de hierro,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Para ejecutar la sentencia escrita sobre ellos.","poem":1},{"lineBreak":true},{"text":"Éste será un honor para todos sus fieles.","poem":1},{"lineBreak":true},{"text":"¡Aleluya! ¡Aleluya!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}