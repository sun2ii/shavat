"content":[{"lineBreak":true},{"text":"Quien no presta su dinero con interés,","poem":1},{"lineBreak":true},{"text":"Ni acepta soborno contra el inocente.","poem":1},{"lineBreak":true},{"text":"El que hace estas cosas jamás será movido.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}