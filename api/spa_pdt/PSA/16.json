{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["Canto a media voz, de David"]},{"type":"verse","number":1,"content":[{"text":"Guárdame, oh ʼElohim, porque en Ti me refugio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dije a Yavé: Tú eres mi ʼAdonay.","poem":1},{"lineBreak":true},{"text":"No tengo bien fuera de Ti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Para los santos y los íntegros que están en la tierra","poem":1},{"lineBreak":true},{"text":"Es toda mi complacencia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Multiplicarán sus dolores los que sirven a otro ʼelohim.","poem":1},{"lineBreak":true},{"text":"No derramaré sus libaciones de sangre,","poem":1},{"lineBreak":true},{"text":"Ni estarán sus nombres en mis labios.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yavé es la porción de mi herencia y de mi copa.","poem":1},{"lineBreak":true},{"text":"Tú sustentas firmemente mi parcela.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Las cuerdas me cayeron en lugares deleitosos","poem":1},{"lineBreak":true},{"text":"Y es hermosa la heredad que me corresponde.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bendeciré a Yavé que me aconseja,","poem":1},{"lineBreak":true},{"text":"Aun en las noches me corrige las partes más íntimas de mi personalidad.","poem":1},{"noteId":7}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A Yavé coloqué continuamente delante de mí.","poem":1},{"lineBreak":true},{"text":"Porque está a mi derecha, no seré movido.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Por lo cual se alegra mi corazón,","poem":1},{"lineBreak":true},{"text":"Y se regocija mi gloria.","poem":1},{"lineBreak":true},{"text":"Mi cuerpo reposará también confiadamente,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Porque no abandonarás mi alma en el Seol,","poem":1},{"lineBreak":true},{"text":"Ni permitirás que tu Santo experimente corrupción.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Me mostrarás la senda de la vida.","poem":1},{"lineBreak":true},{"text":"En tu Presencia hay plenitud de gozo,","poem":1},{"lineBreak":true},{"text":"Delicias a tu mano derecha para siempre.","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Lit. riñones.","reference":{"chapter":16,"verse":7}}]},"thisChapterLink":"/api/spa_pdt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}