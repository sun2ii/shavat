{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"heading","content":["Oración de David"]},{"type":"verse","number":1,"content":[{"text":"Oye, oh Yavé, una causa justa, atiende mi clamor.","poem":1},{"lineBreak":true},{"text":"Escucha mi oración hecha con labios sin engaño.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"De tu Presencia proceda mi defensa.","poem":1},{"lineBreak":true},{"text":"Vean tus ojos la rectitud.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tú probaste mi corazón.","poem":1},{"lineBreak":true},{"text":"Me visitaste de noche,","poem":1},{"lineBreak":true},{"text":"Me pasaste por el crisol y nada inicuo hallaste.","poem":1},{"lineBreak":true},{"text":"Resolví que mi boca no cometa transgresión.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"En cuanto a las obras humanas,","poem":1},{"lineBreak":true},{"text":"Con la Palabra de tus labios","poem":1},{"lineBreak":true},{"text":"Me guardé de las sendas del violento.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mis pasos se mantuvieron en tus caminos.","poem":1},{"lineBreak":true},{"text":"Mis pies no resbalarán.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oh ʼElohim, yo te invocaré,","poem":1},{"lineBreak":true},{"text":"Y Tú me responderás.","poem":1},{"lineBreak":true},{"text":"Inclina tu oído hacia mí y escucha mis palabras.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Haz tus misericordias maravillosas!","poem":1},{"lineBreak":true},{"text":"Tú eres Quien salvas a quienes se refugian a tu mano derecha,","poem":1},{"lineBreak":true},{"text":"De los que se levantan contra ellos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Guárdame como a la pupila de tus ojos,","poem":1},{"lineBreak":true},{"text":"Escóndeme bajo la sombra de tus alas","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"De la presencia de los perversos que me oprimen,","poem":1},{"lineBreak":true},{"text":"De los enemigos mortales que me rodean.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Protegidos están en su prosperidad.","poem":1},{"lineBreak":true},{"text":"Con su boca hablan arrogancias.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ahora cercaron nuestros pasos.","poem":1},{"lineBreak":true},{"text":"Fijan su mirada en echarnos a tierra,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Como león ansioso de desgarrar su presa,","poem":1},{"lineBreak":true},{"text":"Como cachorro de león agazapado en su cueva.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Levántate, oh Yavé!","poem":1},{"lineBreak":true},{"text":"¡Hazle frente!","poem":1},{"lineBreak":true},{"text":"Haz que sea derribado.","poem":1},{"lineBreak":true},{"text":"Con tu espada libra mi alma del inicuo,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Y con tu mano, oh Yavé, de los hombres del mundo,","poem":1},{"lineBreak":true},{"text":"Cuya porción está en esta vida,","poem":1},{"lineBreak":true},{"text":"Cuyo vientre Tú llenas con tus tesoros.","poem":1},{"lineBreak":true},{"text":"¡Sean saciados, pues, sus hijos,","poem":1},{"lineBreak":true},{"text":"Y dejen las migajas a sus nietos!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yo veré tu rostro en justicia,","poem":1},{"lineBreak":true},{"text":"Estaré satisfecho cuando despierte a tu semejanza.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}