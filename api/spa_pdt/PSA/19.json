{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"heading","content":["Al director del coro. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Los cielos cuentan la gloria de ʼElohim,","poem":1},{"lineBreak":true},{"text":"Y el firmamento declara la obra de sus manos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Día tras día pronuncian su mensaje,","poem":1},{"lineBreak":true},{"text":"Y noche tras noche proclaman sabiduría.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"No hay lengua ni palabras","poem":1},{"lineBreak":true},{"text":"En las cuales no sea oída la voz de ellos.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Su expresión llega a toda la tierra,","poem":1},{"lineBreak":true},{"text":"Y sus Palabras hasta los confines del mundo.","poem":1},{"lineBreak":true},{"text":"En ellos puso tabernáculo para el sol,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Y éste, como esposo que sale de su aposento,","poem":1},{"lineBreak":true},{"text":"Se alegra como atleta para recorrer su camino.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"De un extremo de los cielos es su salida,","poem":1},{"lineBreak":true},{"text":"Y su órbita hasta el término de ellos.","poem":1},{"lineBreak":true},{"text":"Nada queda escondido de su calor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"La Ley de Yavé es perfecta.","poem":1},{"lineBreak":true},{"text":"Restaura el alma.","poem":1},{"lineBreak":true},{"text":"El testimonio de Yavé es fiel.","poem":1},{"lineBreak":true},{"text":"Hace sabio al sencillo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Los Preceptos de Yavé son rectos.","poem":1},{"lineBreak":true},{"text":"Alegran el corazón.","poem":1},{"lineBreak":true},{"text":"El Mandamiento de Yavé es puro,","poem":1},{"lineBreak":true},{"text":"Alumbra los ojos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"El temor a Yavé es limpio,","poem":1},{"lineBreak":true},{"text":"Permanece para siempre.","poem":1},{"lineBreak":true},{"text":"Los Juicios de Yavé son verdaderos,","poem":1},{"lineBreak":true},{"text":"Todos justos.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Deseables son más que el oro,","poem":1},{"lineBreak":true},{"text":"Más que mucho oro afinado,","poem":1},{"lineBreak":true},{"text":"Y más dulces que la miel,","poem":1},{"lineBreak":true},{"text":"Aun la que destila del panal.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Tu esclavo es además amonestado por ellos.","poem":1},{"lineBreak":true},{"text":"En guardarlos hay grande galardón.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Quién reconocerá sus propios errores?","poem":1},{"lineBreak":true},{"text":"Declárame inocente de los que me son ocultos.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Aparta también a tu esclavo de las soberbias,","poem":1},{"lineBreak":true},{"text":"Que no me dominen.","poem":1},{"lineBreak":true},{"text":"Entonces seré íntegro","poem":1},{"lineBreak":true},{"text":"Y declarado absuelto de gran transgresión.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sean aceptos los dichos de mi boca delante de Ti","poem":1},{"lineBreak":true},{"text":"Y la meditación de mi corazón,","poem":1},{"lineBreak":true},{"text":"Oh Yavé, Roca mía y Redentor mío.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}