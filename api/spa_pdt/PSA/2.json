{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"¿Para qué están en tumulto las naciones,","poem":1},{"lineBreak":true},{"text":"Y los pueblos maquinan cosas vanas?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Los reyes de la tierra se levantarán,","poem":1},{"lineBreak":true},{"text":"Y gobernantes conspirarán unidos","poem":1},{"lineBreak":true},{"text":"Contra Yavé y contra su Ungido, y dicen:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Rompamos sus ataduras","poem":1},{"lineBreak":true},{"text":"Y quitemos de nosotros sus cuerdas!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"El que está sentado en los cielos se reirá.","poem":1},{"lineBreak":true},{"text":"ʼAdonay se burlará de ellos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Luego les hablará en su furor.","poem":1},{"lineBreak":true},{"text":"Los conturbará en su ira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yo mismo consagré","wordsOfJesus":true,"poem":1},{"noteId":1},{"text":"a mi Rey sobre Sion,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Mi Montaña Santa.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yo promulgaré el decreto.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Yavé me dijo:","poem":1},{"lineBreak":true},{"text":"Mi Hijo eres Tú,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Yo te engendré hoy.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pídeme y te daré los pueblos en posesión,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y como herencia tuya los confines de la tierra.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Los quebrantarás con vara de hierro.","poem":1},{"lineBreak":true},{"text":"Los harás añicos como vasija de alfarero.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ahora pues, oh reyes, actúen con sabiduría.","poem":1},{"lineBreak":true},{"text":"Acepten amonestación, jueces de la tierra:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sirvan a Yavé con temor","poem":1},{"lineBreak":true},{"text":"Y regocíjense con temblor.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Besen los pies al Hijo","poem":1},{"lineBreak":true},{"text":"No sea que se enoje y perezcan en el camino,","poem":1},{"lineBreak":true},{"text":"Pues de repente arde su ira.","poem":1},{"lineBreak":true},{"text":"Inmensamente felices","poem":1},{"noteId":2},{"text":"son los que se refugian en Él.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Lit. he consagrado.","reference":{"chapter":2,"verse":6}},{"noteId":2,"caller":"+","text":"Lit. Bienaventurado.","reference":{"chapter":2,"verse":12}}]},"thisChapterLink":"/api/spa_pdt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}