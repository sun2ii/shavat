{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["Al director del coro. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Yavé te responda en el día de la adversidad.","poem":1},{"lineBreak":true},{"text":"El Nombre del ʼElohim de Jacob te defienda,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Te envíe ayuda desde el Santuario","poem":1},{"lineBreak":true},{"text":"Y desde Sion te sostenga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Se acuerde de todas tus ofrendas","poem":1},{"lineBreak":true},{"text":"Y acepte tus holocaustos. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Te dé conforme al deseo de tu corazón","poem":1},{"lineBreak":true},{"text":"Y cumpla todos tus propósitos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nosotros nos alegraremos en tu salvación","poem":1},{"lineBreak":true},{"text":"Y levantaremos pendón en el Nombre de nuestro ʼElohim.","poem":1},{"lineBreak":true},{"text":"Yavé te conceda todas tus peticiones.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ahora sé que Yavé salva a su ungido.","poem":1},{"lineBreak":true},{"text":"Le responderá desde sus santos cielos","poem":1},{"lineBreak":true},{"text":"Con la potencia salvadora de su mano derecha.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Éstos confían en carruajes de guerra,","poem":1},{"lineBreak":true},{"text":"Y aquéllos en caballos,","poem":1},{"lineBreak":true},{"text":"Pero nosotros nos gloriamos del Nombre de Yavé, nuestro ʼElohim.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ellos flaquean y caen,","poem":1},{"lineBreak":true},{"text":"Pero nosotros nos levantamos y estamos firmes.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Salva, oh Yavé!","poem":1},{"lineBreak":true},{"text":"¡Que el Rey nos responda el día cuando lo invoquemos!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}