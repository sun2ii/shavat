su gloria por tu salvación.","poem":1},{"lineBreak":true},{"text":"Pusiste sobre él honor y majestad.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Lo bendijiste para siempre.","poem":1},{"lineBreak":true},{"text":"Lo llenaste de alegría con tu Presencia","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Por cuanto el rey confía en Yavé.","poem":1},{"lineBreak":true},{"text":"Por la misericordia de ʼElyón, no será conmovido.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tu mano alcanzará a todos tus enemigos.","poem":1},{"lineBreak":true},{"text":"Tu mano derecha alcanzará a los que te aborrecen.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Los pondrás en horno de fuego en el tiempo de tu ira.","poem":1},{"lineBreak":true},{"text":"Yavé los deshará en su ira,","poem":1},{"lineBreak":true},{"text":"Y el fuego los consumirá.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Destruirás su producto de la tierra,","poem":1},{"lineBreak":true},{"text":"Y su descendencia de entre los hijos de hombres.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Porque tramaron el mal contra Ti.","poem":1},{"lineBreak":true},{"text":"Fraguaron un complot,","poem":1},{"lineBreak":true},{"text":"Pero no prevalecerán.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Pues Tú les harás volver la espalda","poem":1},{"lineBreak":true},{"text":"Al apuntar tu arco contra sus rostros.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Engrandécete, oh Yavé, con tu fortaleza!","poem":1},{"lineBreak":true},{"text":"Cantaremos y alabaremos tu poderío.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}