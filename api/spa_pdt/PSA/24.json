"poem":1},{"lineBreak":true},{"text":"Y la justicia del ʼElohim de su salvación.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Esta es la generación de los que lo buscan,","poem":1},{"lineBreak":true},{"text":"De los que buscan tu rostro, oh ʼElohim de Jacob. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Alcen, oh puertas, sus cabezas!","poem":1},{"lineBreak":true},{"text":"¡Sean levantados, portales eternos,","poem":1},{"lineBreak":true},{"text":"Y entrará el Rey de gloria!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¿Quién es este Rey de gloria?","poem":1},{"lineBreak":true},{"text":"¡Yavé, el Fuerte y Poderoso!","poem":1},{"lineBreak":true},{"text":"¡Yavé, el Poderoso en batalla!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Alcen, oh puertas, sus cabezas!","poem":1},{"lineBreak":true},{"text":"¡Sean levantados, portales eternos,","poem":1},{"lineBreak":true},{"text":"Y entrará el Rey de gloria!","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"¿Quién es este Rey de gloria?","poem":1},{"lineBreak":true},{"text":"¡Yavé de las huestes!","poem":1},{"lineBreak":true},{"text":"¡Él es el Rey de gloria! Selah","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}