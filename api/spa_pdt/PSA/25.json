{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"heading","content":["Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"A Ti, oh Yavé, levanto mi alma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"¡ʼElohim mío, en Ti confío!","poem":1},{"lineBreak":true},{"text":"No sea yo avergonzado,","poem":1},{"lineBreak":true},{"text":"No se alegren de mí mis enemigos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ciertamente ninguno de los que confían en Ti será avergonzado.","poem":1},{"lineBreak":true},{"text":"Serán avergonzados los que se rebelan sin causa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Muéstrame, oh Yavé, tus caminos,","poem":1},{"lineBreak":true},{"text":"Enséñame tus sendas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Encamíname en tu verdad y enséñame,","poem":1},{"lineBreak":true},{"text":"Porque Tú eres el ʼElohim de mi salvación.","poem":1},{"lineBreak":true},{"text":"En Ti espero todo el día.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Acuérdate, oh Yavé, de tu compasión y de tu misericordia que son perpetuas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"No te acuerdes de los pecados de mi juventud y de mis transgresiones.","poem":1},{"lineBreak":true},{"text":"Conforme a tu misericordia acuérdate de mí,","poem":1},{"lineBreak":true},{"text":"Por tu bondad, oh Yavé.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bueno y justo es Yavé.","poem":1},{"lineBreak":true},{"text":"Él muestra el camino a los pecadores.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Encamina a los humildes en justicia,","poem":1},{"lineBreak":true},{"text":"Y enseña a los mansos su senda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Todas las sendas de Yavé son misericordia y verdad","poem":1},{"lineBreak":true},{"text":"Para los que observan su Pacto y sus Preceptos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Por amor a tu Nombre, oh Yavé,","poem":1},{"lineBreak":true},{"text":"Perdonas también mi iniquidad, que es grande.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Quién es el hombre que teme a Yavé?","poem":1},{"lineBreak":true},{"text":"Él le enseñará el camino que debe escoger.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Su alma gozará de bienestar,","poem":1},{"lineBreak":true},{"text":"Y su descendencia heredará la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"El secreto de Yavé es para los que le temen.","poem":1},{"lineBreak":true},{"text":"A ellos hará conocer su Pacto.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mis ojos están siempre fijos en Yavé,","poem":1},{"lineBreak":true},{"text":"Porque Él sacará mis pies de la red.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mírame y ten misericordia de mí,","poem":1},{"lineBreak":true},{"text":"Porque estoy solo y afligido.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Las angustias de mi corazón se aumentaron.","poem":1},{"lineBreak":true},{"text":"¡Sácame de mis congojas!","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mira mi aflicción y mis fatigas,","poem":1},{"lineBreak":true},{"text":"Y perdona todos mis pecados.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"¡Mira cómo se multiplicaron mis enemigos,","poem":1},{"lineBreak":true},{"text":"Y con violento odio me aborrecen!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"¡Guarda mi alma y líbrame!","poem":1},{"lineBreak":true},{"text":"No sea yo avergonzado,","poem":1},{"lineBreak":true},{"text":"Porque en Ti me refugio.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Integridad y rectitud me guarden,","poem":1},{"lineBreak":true},{"text":"Porque en Ti espero.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"¡Oh ʼElohim, redime a Israel de todas sus angustias!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}