{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"heading","content":["Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Defiéndeme, oh Yavé, porque en mi integridad anduve,","poem":1},{"lineBreak":true},{"text":"Y en Yavé confié sin titubear.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Examíname, oh Yavé, y pruébame.","poem":1},{"lineBreak":true},{"text":"Escudriña lo más íntimo de mi personalidad","poem":1},{"noteId":8},{"text":"y mi corazón,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Porque tu misericordia está delante de mis ojos","poem":1},{"lineBreak":true},{"text":"Y ando en tu verdad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"No me siento con hombres falsos","poem":1},{"lineBreak":true},{"text":"Ni ando con hipócritas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aborrezco la reunión de perversos","poem":1},{"lineBreak":true},{"text":"Y no me sentaré con los inicuos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lavaré en inocencia mis manos,","poem":1},{"lineBreak":true},{"text":"Y así andaré en torno a tu altar, oh Yavé,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Para hacer resonar mi voz de gratitud","poem":1},{"lineBreak":true},{"text":"Y contar todas tus maravillas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oh Yavé, yo amo la Casa donde moras,","poem":1},{"lineBreak":true},{"text":"Y el lugar donde reside tu gloria.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"No arrebates mi alma con los pecadores,","poem":1},{"lineBreak":true},{"text":"Ni mi vida con hombres sanguinarios,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"En las manos de los cuales está el crimen,","poem":1},{"lineBreak":true},{"text":"Cuya mano derecha está llena de sobornos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"En cuanto a mí, andaré en mi integridad.","poem":1},{"lineBreak":true},{"text":"¡Redímeme y ten misericordia de mí!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mis pies están en suelo firme.","poem":1},{"lineBreak":true},{"text":"Bendeciré a Yavé en las congregaciones.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Lit. riñones.","reference":{"chapter":26,"verse":2}}]},"thisChapterLink":"/api/spa_pdt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}