{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"heading","content":["Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"A Ti clamo, oh Yavé, Roca mía.","poem":1},{"lineBreak":true},{"text":"No enmudezcas para mí,","poem":1},{"lineBreak":true},{"text":"Porque si Tú enmudeces para mí,","poem":1},{"lineBreak":true},{"text":"Seré como los que bajan a la fosa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oye la voz de mis súplicas cuando clamo a Ti,","poem":1},{"lineBreak":true},{"text":"Cuando levanto mis manos hacia tu Santuario.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"No me arrastres junto con los impíos,","poem":1},{"lineBreak":true},{"text":"Quienes hacen iniquidad","poem":1},{"lineBreak":true},{"text":"Y hablan de paz con su prójimo,","poem":1},{"lineBreak":true},{"text":"Pero la perversidad está en sus corazones.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dales conforme a su obra y según la perversidad de sus hechos.","poem":1},{"lineBreak":true},{"text":"Retribúyeles de acuerdo con las obras de sus manos.","poem":1},{"lineBreak":true},{"text":"¡Dales su recompensa!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Porque no entienden los hechos de Yavé,","poem":1},{"lineBreak":true},{"text":"Ni las obras de sus manos,","poem":1},{"lineBreak":true},{"text":"Él los derribará y no los edificará.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡Bendito sea Yavé,","poem":1},{"lineBreak":true},{"text":"Porque escuchó la voz de mi súplica!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yavé es mi Fortaleza y mi Escudo.","poem":1},{"lineBreak":true},{"text":"Confió mi corazón en Él","poem":1},{"lineBreak":true},{"text":"Y fui ayudado,","poem":1},{"lineBreak":true},{"text":"Por lo cual se regocija mi corazón.","poem":1},{"lineBreak":true},{"text":"Lo alabaré con mi canto.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yavé es la Fortaleza de su pueblo,","poem":1},{"lineBreak":true},{"text":"Y el Refugio salvador de su ungido.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¡Salva a tu pueblo,","poem":1},{"lineBreak":true},{"text":"Y bendice tu heredad!","poem":1},{"lineBreak":true},{"text":"¡Pastoréalos y cárgalos para siempre!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}