{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Salmo de David cuando huía de su hijo Absalón"]},{"type":"verse","number":1,"content":[{"text":"¡Oh Yavé, cómo se multiplicaron mis opresores!","poem":1},{"lineBreak":true},{"text":"Muchos son los que se levantan contra mí.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muchos dicen de mí:","poem":1},{"lineBreak":true},{"text":"No hay salvación en ʼElohim para él. Selah","poem":1},{"noteId":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pero Tú, oh Yavé, eres escudo alrededor de mí,","poem":1},{"lineBreak":true},{"text":"Mi gloria, y el que levanta mi cabeza.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Clamé a Yavé con mi voz.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Yo me acosté y dormí,","poem":1},{"lineBreak":true},{"text":"Y desperté, porque Yavé me sustenta.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"No temeré a decenas de millares de personas","poem":1},{"lineBreak":true},{"text":"Me sitien que alrededor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Levántate, oh Yavé, sálvame, ʼElohim mío!","poem":1},{"lineBreak":true},{"text":"Porque Tú eres el que golpea a todos mis enemigos en la mejilla","poem":1},{"lineBreak":true},{"text":"Y quebrantas los dientes de los impíos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"La salvación corresponde a Yavé.","poem":1},{"lineBreak":true},{"text":"Sobre tu pueblo sea tu bendición. Selah","poem":1}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Selah. Probablemente piensen en esto.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/spa_pdt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}