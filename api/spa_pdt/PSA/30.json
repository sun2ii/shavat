{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"heading","content":["Canto para la dedicación del Templo. Salmo de David."]},{"type":"verse","number":1,"content":[{"text":"Te exalto oh Yavé, porque me levantaste,","poem":1},{"lineBreak":true},{"text":"Y no dejaste que mis enemigos se alegraran de mí.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Oh Yavé, mi ʼElohim!","poem":1},{"lineBreak":true},{"text":"Clamé a Ti, y me sanaste.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Oh Yavé, sacaste mi vida del Seol,","poem":1},{"lineBreak":true},{"text":"De entre los que bajan a la tumba me mantuviste vivo!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Canten salmos a Yavé, ustedes sus santos,","poem":1},{"lineBreak":true},{"text":"Y celebren la memoria de su santidad.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Por un momento es su ira,","poem":1},{"lineBreak":true},{"text":"Pero su favor dura toda la vida.","poem":1},{"lineBreak":true},{"text":"Por la noche dura el llanto,","poem":1},{"lineBreak":true},{"text":"Pero al amanecer viene la alegría.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"En mi prosperidad me decía:","poem":1},{"lineBreak":true},{"text":"No seré conmovido jamás,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Porque con tu favor, oh Yavé,","poem":1},{"lineBreak":true},{"text":"Me afirmaste como fuerte montaña.","poem":1},{"lineBreak":true},{"text":"Escondiste tu rostro, fui turbado.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"A Ti clamé, oh Yavé.","poem":1},{"lineBreak":true},{"text":"A Yavé dirigí mi súplica.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"¿Qué provecho hay en mi muerte cuando baje a la tumba?","poem":1},{"lineBreak":true},{"text":"¿Te alabará el polvo?","poem":1},{"lineBreak":true},{"text":"¿Anunciará tu verdad?","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Escucha, oh Yavé, y ten compasión de mí.","poem":1},{"lineBreak":true},{"text":"¡Oh Yavé, sé mi Ayudador!","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Cambiaste mi lamento en danza,","poem":1},{"lineBreak":true},{"text":"Desataste mi tela áspera y me vestiste de alegría.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Por tanto, a Ti cantaré, Gloria mía, y no estaré callado.","poem":1},{"lineBreak":true},{"text":"¡Oh Yavé, mi ʼElohim, te daré gracias para siempre!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}