{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"heading","content":["Instrucción (Maskil) de David"]},{"type":"verse","number":1,"content":[{"text":"Inmensamente feliz es aquel","poem":1},{"lineBreak":true},{"text":"A quien es perdonada su transgresión","poem":1},{"lineBreak":true},{"text":"Y cubierto su pecado.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Inmensamente feliz es el hombre","poem":1},{"lineBreak":true},{"text":"A quien Yavé no atribuye iniquidad,","poem":1},{"lineBreak":true},{"text":"Y en el espíritu del cual no hay engaño.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mientras callé, se consumieron mis huesos","poem":1},{"lineBreak":true},{"text":"En mi gemir todo el día.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Porque de día y de noche pesó sobre mí tu mano.","poem":1},{"lineBreak":true},{"text":"Hasta que mi vigor se convirtió","poem":1},{"lineBreak":true},{"text":"En sequedades de verano. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mi pecado confesé y no encubrí mi iniquidad.","poem":1},{"lineBreak":true},{"text":"Dije: Confesaré mis transgresiones a Yavé,","poem":1},{"lineBreak":true},{"text":"Y Tú perdonaste la culpa de mi pecado. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Por esto todo santo ora a Ti","poem":1},{"lineBreak":true},{"text":"En un tiempo cuando puedes ser hallado.","poem":1},{"lineBreak":true},{"text":"Ciertamente en la inundación de muchas aguas,","poem":1},{"lineBreak":true},{"text":"Éstas no llegarán a él.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tú eres mi Refugio.","poem":1},{"lineBreak":true},{"text":"Me guardas de la angustia.","poem":1},{"lineBreak":true},{"text":"Me rodeas con cantos de liberación. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Te haré entender","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y te enseñaré el camino en el cual debes andar.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Sobre Ti fijaré mis ojos y te aconsejaré.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"No sean como el caballo o la mula,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Sin entendimiento,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Cuya boca debe ser frenada con freno y rienda","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Para que se acerquen a Ti.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Muchos dolores hay para el impío,","poem":1},{"lineBreak":true},{"text":"Pero al que confía en Yavé","poem":1},{"lineBreak":true},{"text":"Lo rodea la misericordia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"¡Alégrense, oh justos, en Yavé, y regocíjense!","poem":1},{"lineBreak":true},{"text":"¡Canten con júbilo todos los rectos de corazón!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}