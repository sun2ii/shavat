{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"heading","content":["Salmo de David. Cuando cambió su conducta ante Abimelec, quien lo echó y él salió"]},{"type":"verse","number":1,"content":[{"text":"Bendeciré a Yavé en todo tiempo.","poem":1},{"lineBreak":true},{"text":"Su alabanza estará de continuo en mi boca.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"En Yavé se gloriará mi alma.","poem":1},{"lineBreak":true},{"text":"Lo oirán los mansos y se alegrarán.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Engrandezcan a Yavé conmigo,","poem":1},{"lineBreak":true},{"text":"Y exaltemos juntos su Nombre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Busqué a Yavé y Él me respondió,","poem":1},{"lineBreak":true},{"text":"Y me libró de todos mis temores.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Los que miraron a Él fueron iluminados,","poem":1},{"lineBreak":true},{"text":"Y sus semblantes nunca serán avergonzados.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Este pobre clamó,","poem":1},{"lineBreak":true},{"text":"Y Yavé lo escuchó,","poem":1},{"lineBreak":true},{"text":"Y lo salvó de todas sus angustias.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"El Ángel de Yavé acampa alrededor de los que le temen,","poem":1},{"lineBreak":true},{"text":"Y los rescata.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Prueben y vean que Yavé es bueno.","poem":1},{"lineBreak":true},{"text":"¡Cuán feliz es el varón que confía en Él!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Teman a Yavé, ustedes sus santos,","poem":1},{"lineBreak":true},{"text":"Porque nada falta a los que le temen.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Los cachorros de león necesitan y sufren hambre,","poem":1},{"lineBreak":true},{"text":"Pero los que buscan a Yavé no carecen de ningún bien.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vengan, hijos, escúchenme.","poem":1},{"lineBreak":true},{"text":"Les enseñaré el temor a Yavé.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"¿Quién es el hombre que desea vida,","poem":1},{"lineBreak":true},{"text":"Que desea muchos días para ver el bien?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Guarda tu boca del mal","poem":1},{"lineBreak":true},{"text":"Y tus labios de hablar engaño.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Apártate del mal y haz el bien.","poem":1},{"lineBreak":true},{"text":"Busca la paz y persíguela.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Los ojos de Yavé están hacia los justos,","poem":1},{"lineBreak":true},{"text":"Y sus oídos atentos al clamor de ellos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"El rostro de Yavé está contra los perversos,","poem":1},{"lineBreak":true},{"text":"Para cortar su memoria de la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Claman los justos,","poem":1},{"lineBreak":true},{"text":"Y Yavé los oye","poem":1},{"lineBreak":true},{"text":"Y los libra de todas sus angustias.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Cercano está Yavé a los quebrantados de corazón,","poem":1},{"lineBreak":true},{"text":"Y salva a los contritos de espíritu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Muchas son las aflicciones del justo,","poem":1},{"lineBreak":true},{"text":"Pero de todas ellas lo libra Yavé.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Él guarda todos sus huesos.","poem":1},{"lineBreak":true},{"text":"Ni uno de ellos es quebrado.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Matará al malo la maldad,","poem":1},{"lineBreak":true},{"text":"Y los que aborrecen al justo serán culpables.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Yavé redime la vida de sus esclavos.","poem":1},{"lineBreak":true},{"text":"No serán condenados cuantos en Él confían.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}