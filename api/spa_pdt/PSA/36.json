{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"heading","content":["Al director del coro. Salmo de David, esclavo de Yavé"]},{"type":"verse","number":1,"content":[{"text":"La transgresión del impío habla a su corazón.","poem":1},{"lineBreak":true},{"text":"No hay temor a ʼElohim delante de sus ojos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Se jacta ante sus propios ojos","poem":1},{"lineBreak":true},{"text":"De que su iniquidad no será descubierta ni aborrecida.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Las palabras de su boca son iniquidad y engaño.","poem":1},{"lineBreak":true},{"text":"Dejó de ser sabio, de hacer el bien.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Trama iniquidad sobre su cama.","poem":1},{"lineBreak":true},{"text":"Se mantiene en camino no bueno.","poem":1},{"lineBreak":true},{"text":"No aborrece lo malo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Oh Yavé, tu misericordia llega hasta el cielo,","poem":1},{"lineBreak":true},{"text":"Y hasta las nubes tu fidelidad.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tu justicia es como las montañas de ʼEL,","poem":1},{"noteId":10},{"lineBreak":true},{"text":"Tus juicios, como inmenso abismo.","poem":1},{"lineBreak":true},{"text":"Tú, oh Yavé, preservas al hombre y la bestia.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"¡Oh ʼElohim, cuán preciosa es tu misericordia!","poem":1},{"lineBreak":true},{"text":"Por eso los hombres se amparan bajo la sombra de tus alas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Son plenamente saciados con la abundancia de tu casa,","poem":1},{"lineBreak":true},{"text":"Les das de beber del torrente de tus delicias.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Porque contigo está el manantial de la vida.","poem":1},{"lineBreak":true},{"text":"En tu luz vemos la luz.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Extiende tu misericordia a los que te conocen,","poem":1},{"lineBreak":true},{"text":"Y tu justicia a los rectos de corazón.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"No me alcance el pie de la soberbia,","poem":1},{"lineBreak":true},{"text":"Ni me mueva la mano del inicuo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ahí cayeron los que obran iniquidad,","poem":1},{"lineBreak":true},{"text":"Fueron derribados,","poem":1},{"lineBreak":true},{"text":"Y no pueden levantarse.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"ʼEL es un nombre de ʼElohim.","reference":{"chapter":36,"verse":6}}]},"thisChapterLink":"/api/spa_pdt/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}