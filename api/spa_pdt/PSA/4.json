{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["Al director del coro, con instrumentos de cuerda. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"¡Oh ʼElohim de mi justicia, respóndeme cuando clamo!","poem":1},{"lineBreak":true},{"text":"Tú que me diste holgura en la estrechez,","poem":1},{"lineBreak":true},{"text":"Ten compasión de mí y escucha mi oración.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Oh hijos de los hombres,","poem":1},{"lineBreak":true},{"text":"¿Por cuánto tiempo convertirán mi honra en infamia?","poem":1},{"lineBreak":true},{"text":"¿Hasta cuando amarán vanidad y buscarán la mentira? Selah","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sepan, pues, que Yavé apartó al piadoso para Él.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Aírense, pero no pequen.","poem":1},{"lineBreak":true},{"text":"Mediten en su corazón sobre sus camas.","poem":1},{"lineBreak":true},{"text":"Guarden silencio. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ofrezcan sacrificios de justicia,","poem":1},{"lineBreak":true},{"text":"Y confíen en Yavé.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Muchos dicen: ¡Oh, que viéramos algún bien!","poem":1},{"lineBreak":true},{"text":"¡Oh Yavé, levanta sobre nosotros la luz de tu rostro!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Diste alegría a mi corazón,","poem":1},{"lineBreak":true},{"text":"Mayor que la de ellos, aun cuando abundan en grano y mosto.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"En paz me acostaré y así dormiré,","poem":1},{"lineBreak":true},{"text":"Porque solo Tú, Yavé, me haces vivir confiado.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}