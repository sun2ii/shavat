{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"heading","content":["Al director del coro. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"¡Oh cuán bendecido es el que piensa en el pobre!","poem":1},{"lineBreak":true},{"text":"En el día malo Yavé lo librará.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yavé lo protegerá y le dará vida.","poem":1},{"lineBreak":true},{"text":"Será bendito en la tierra,","poem":1},{"lineBreak":true},{"text":"Y no lo entregarás a la voluntad de sus enemigos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yavé lo sustentará en el lecho de dolor.","poem":1},{"lineBreak":true},{"text":"En su enfermedad suavizarás su cama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dije yo: Oh Yavé, ten compasión de mí.","poem":1},{"lineBreak":true},{"text":"Sana mi alma, porque pequé contra Ti.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mis enemigos hablan mal de mí y preguntan:","poem":1},{"lineBreak":true},{"text":"¿Cuándo morirá y perecerá su nombre?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Cuando viene a verme, habla falsedad.","poem":1},{"lineBreak":true},{"text":"Su corazón recoge perversidades.","poem":1},{"lineBreak":true},{"text":"Cuando sale las divulga.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Todos los que me aborrecen murmuran reunidos contra mí.","poem":1},{"lineBreak":true},{"text":"Maquinan la perversidad contra mí y dicen:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Algo perverso fue derramado sobre él.","poem":1},{"lineBreak":true},{"text":"Cuando caiga en cama, no volverá a levantarse.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Aun el hombre de mi paz en quien yo confiaba,","poem":1},{"lineBreak":true},{"text":"Que comía de mi pan,","poem":1},{"lineBreak":true},{"text":"Levantó contra mí su talón.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Pero Tú, oh Yavé, ten compasión de mí.","poem":1},{"lineBreak":true},{"text":"Levántame para que le dé recompensa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"En esto sé que te complaces en mí:","poem":1},{"lineBreak":true},{"text":"En que mi enemigo no proclame triunfo sobre mí.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"En cuanto a mí, en mi integridad me sostienes,","poem":1},{"lineBreak":true},{"text":"Y me establecerás en tu Presencia para siempre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Bendito sea Yavé el ʼElohim de Israel,","poem":1},{"lineBreak":true},{"text":"Desde la eternidad y hasta la eternidad! ¡Amén y amén!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}