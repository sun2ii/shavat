{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Júzgame, oh ʼElohim, y defiende mi causa.","poem":1},{"lineBreak":true},{"text":"Líbrame de gente impía, del hombre engañador y perverso.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Porque Tú eres el ʼElohim de mi fortaleza.","poem":1},{"lineBreak":true},{"text":"¿Por qué me desechaste?","poem":1},{"lineBreak":true},{"text":"¿Por qué ando enlutado a causa de la opresión del enemigo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Envía tu luz y tu verdad.","poem":1},{"lineBreak":true},{"text":"Éstas me guiarán.","poem":1},{"lineBreak":true},{"text":"Ellas me conducirán a tu Montaña Santa y a tus moradas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Entonces iré al altar de ʼElohim,","poem":1},{"lineBreak":true},{"text":"Al ʼEL de mi alegría y regocijo,","poem":1},{"lineBreak":true},{"text":"Y te alabaré con el arpa, oh ʼElohim, mi ʼElohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¿Por qué te abates, oh alma mía,","poem":1},{"lineBreak":true},{"text":"Y por qué te turbas dentro de mí?","poem":1},{"lineBreak":true},{"text":"Espera a ʼElohim, porque aún lo alabaré.","poem":1},{"lineBreak":true},{"text":"¡El Ayudador de mi presencia y mi ʼElohim!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}