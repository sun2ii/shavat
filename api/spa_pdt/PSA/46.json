{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"heading","content":["Al director del coro. Salmo de los hijos de Coré, sobre instrumentos de tonos altos. Canto"]},{"type":"verse","number":1,"content":[{"text":"ʼElohim es nuestro Refugio y Fortaleza,","poem":1},{"lineBreak":true},{"text":"Un auxilio muy presente en la tribulación.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Por tanto, no temeremos aunque la tierra sea removida,","poem":1},{"lineBreak":true},{"text":"Y las montañas se traspasen al corazón del mar,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Aunque bramen y espumen sus aguas,","poem":1},{"lineBreak":true},{"text":"Y tiemblen las montañas a causa de su ímpetu. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hay un río cuyas corrientes alegran la ciudad de ʼElohim,","poem":1},{"lineBreak":true},{"text":"El Santuario, morada del ʼElyón.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ʼElohim está en medio de ella.","poem":1},{"lineBreak":true},{"text":"No será conmovida.","poem":1},{"lineBreak":true},{"text":"ʼElohim la ayudará al clarear la mañana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Braman las naciones,","poem":1},{"lineBreak":true},{"text":"Se tambalean los reinos.","poem":1},{"lineBreak":true},{"text":"Él emite su voz.","poem":1},{"lineBreak":true},{"text":"Se derrite la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yavé de las huestes está con nosotros.","poem":1},{"lineBreak":true},{"text":"Nuestro Refugio es el ʼElohim de Jacob. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Vengan y miren las obras de Yavé,","poem":1},{"lineBreak":true},{"text":"Quien causó asolamientos en la tierra,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Quien hace cesar las guerras hasta el fin de la tierra,","poem":1},{"lineBreak":true},{"text":"Quien quiebra el arco, rompe la lanza","poem":1},{"lineBreak":true},{"text":"Y quema los carruajes en el fuego.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Estén quietos y reconozcan que Yo soy ʼElohim.","poem":1},{"lineBreak":true},{"text":"Seré exaltado entre las naciones.","poem":1},{"lineBreak":true},{"text":"Seré enaltecido en la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Yavé de las huestes está con nosotros.","poem":1},{"lineBreak":true},{"text":"Nuestra Fortaleza es el ʼElohim de Jacob. Selah","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}