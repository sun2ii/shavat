{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["Al director del coro. Salmo de los hijos de Coré"]},{"type":"verse","number":1,"content":[{"text":"¡Pueblos todos, aplaudan!","poem":1},{"lineBreak":true},{"text":"¡Aclamen a ʼElohim con voz de júbilo!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Porque Yavé el ʼElyón es temible,","poem":1},{"lineBreak":true},{"text":"Rey grande sobre toda la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Él somete los pueblos a nosotros,","poem":1},{"lineBreak":true},{"text":"Las naciones bajo nuestros pies.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Él nos eligió nuestra herencia,","poem":1},{"lineBreak":true},{"text":"El Esplendor de Jacob, a quien amó. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ʼElohim asciende con aclamación de júbilo,","poem":1},{"lineBreak":true},{"text":"Yavé con sonido de trompeta.","poem":1},{"noteId":12}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Canten a ʼElohim, canten!","poem":1},{"lineBreak":true},{"text":"¡Canten a nuestro Rey, canten!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Porque ʼElohim es el Rey de toda la tierra.","poem":1},{"lineBreak":true},{"text":"¡Canten con entendimiento!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"¡ʼElohim reina sobre las naciones!","poem":1},{"lineBreak":true},{"text":"¡ʼElohim se sienta en su santo trono!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Los jefes de las naciones se reúnen como pueblo del ʼElohim de Abraham,","poem":1},{"lineBreak":true},{"text":"Porque de ʼElohim son los escudos de la tierra,","poem":1},{"lineBreak":true},{"text":"Él es sumamente exaltado.","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Lit. cuerno.","reference":{"chapter":47,"verse":5}}]},"thisChapterLink":"/api/spa_pdt/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}