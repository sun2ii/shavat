{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"heading","content":["Canto. Salmo de los hijos de Coré"]},{"type":"verse","number":1,"content":[{"text":"¡Grande es Yavé y digno de suprema alabanza!","poem":1},{"lineBreak":true},{"text":"En la ciudad de nuestro ʼElohim, su Montaña Santa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hermosa elevación, el gozo de toda la tierra","poem":1},{"lineBreak":true},{"text":"Es la Montaña Sion en el lejano norte, la ciudad del gran Rey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"En sus palacios ʼElohim se presentó como una Fortaleza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Porque ciertamente se aliaron los reyes,","poem":1},{"lineBreak":true},{"text":"Avanzaron unidos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"La miraron, fueron asombrados.","poem":1},{"lineBreak":true},{"text":"Se aterrorizaron, huyeron alarmados.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Allí se apoderó de ellos un temblor,","poem":1},{"lineBreak":true},{"text":"Angustia como de parturienta.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Con el viento que sopla del oriente","poem":1},{"lineBreak":true},{"text":"Quiebras las naves de Tarsis.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Como lo oímos, lo vimos en la ciudad de Yavé de las huestes,","poem":1},{"lineBreak":true},{"text":"La ciudad de nuestro ʼElohim.","poem":1},{"lineBreak":true},{"text":"ʼElohim la afirmará para siempre. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nos acordamos de tu misericordia, oh ʼElohim, en tu Templo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Como tu Nombre, oh ʼElohim,","poem":1},{"lineBreak":true},{"text":"Así es tu alabanza hasta los confines de la tierra.","poem":1},{"lineBreak":true},{"text":"Tu mano derecha está llena de justicia.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Alégrese la Montaña Sion!","poem":1},{"lineBreak":true},{"text":"¡Regocíjense las hijas de Judá","poem":1},{"lineBreak":true},{"text":"A causa de tus juicios!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Anden alrededor de Sion y rodéenla.","poem":1},{"lineBreak":true},{"text":"Cuenten sus torres.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Observen atentamente su muro exterior.","poem":1},{"lineBreak":true},{"text":"Contemplen sus palacios","poem":1},{"lineBreak":true},{"text":"Para que lo cuenten a la generación venidera.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Porque este ʼElohim es nuestro ʼElohim,","poem":1},{"lineBreak":true},{"text":"Eternamente y para siempre.","poem":1},{"lineBreak":true},{"text":"¡Él nos guiará hasta la muerte!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}