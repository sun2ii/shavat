{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"heading","content":["Al director del coro, para instrumentos de viento. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Escucha, oh Yavé, mis palabras.","poem":1},{"lineBreak":true},{"text":"Considera mi susurro.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oye el sonido de mi clamor,","poem":1},{"lineBreak":true},{"text":"Rey mío y ʼElohim mío, porque a Ti oro.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oh Yavé, oyes mi voz de mañana.","poem":1},{"lineBreak":true},{"text":"De mañana la presentaré ante Ti,","poem":1},{"lineBreak":true},{"text":"Y esperaré.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Porque Tú no eres un ʼElohim que se complace en la maldad,","poem":1},{"lineBreak":true},{"text":"Ni el hombre impío mora contigo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Los arrogantes no se presentarán delante de Ti.","poem":1},{"lineBreak":true},{"text":"Aborreces a todos los perversos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Destruirás a los que hablan mentira.","poem":1},{"lineBreak":true},{"text":"Yavé aborrece al hombre sanguinario y engañador.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Pero yo entraré en tu Casa por la abundancia de tu firme amor,","poem":1},{"lineBreak":true},{"text":"Y con reverencia me postraré hacia tu santo Templo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Guíame, oh Yavé, en tu justicia,","poem":1},{"lineBreak":true},{"text":"A causa de mis adversarios.","poem":1},{"lineBreak":true},{"text":"Allana tu camino delante de mí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Porque no hay veracidad en su lenguaje.","poem":1},{"lineBreak":true},{"text":"Su corazón es destructivo,","poem":1},{"lineBreak":true},{"text":"Sepulcro abierto es su garganta.","poem":1},{"lineBreak":true},{"text":"Con su lengua hablan lisonjas.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Oh ʼElohim, castígalos.","poem":1},{"lineBreak":true},{"text":"Caigan por sus propios consejos.","poem":1},{"lineBreak":true},{"text":"Échalos a causa de la multitud de sus transgresiones,","poem":1},{"lineBreak":true},{"text":"Porque se rebelaron contra Ti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pero, ¡alégrense todos los que confían en Ti!","poem":1},{"lineBreak":true},{"text":"¡Den voces de júbilo porque Tú los defiendes para siempre!","poem":1},{"lineBreak":true},{"text":"¡Regocíjense en Ti los que aman tu Nombre!","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Porque Tú, oh Yavé, bendecirás al justo,","poem":1},{"lineBreak":true},{"text":"Como con un escudo lo rodearás de tu favor.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}