{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"heading","content":["Salmo de Asaf"]},{"type":"verse","number":1,"content":[{"text":"El poderoso ʼEL, ʼElohim, Yavé habló","poem":1},{"lineBreak":true},{"text":"Y convocó a la tierra desde el oriente hasta el occidente.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Desde Sion, perfección de hermosura, ʼElohim resplandeció.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Que venga nuestro ʼElohim, y no en silencio.","poem":1},{"lineBreak":true},{"text":"Un fuego devorador lo precede,","poem":1},{"lineBreak":true},{"text":"Y alrededor de Él ruge una gran tempestad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Desde lo alto convoca a los cielos","poem":1},{"lineBreak":true},{"text":"Y a la tierra para juzgar a su pueblo:","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Júntenme a mis santos,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Los que hicieron un Pacto conmigo con sacrificio.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Los cielos proclamarán su justicia,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Porque ʼElohim es el Juez. Selah","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Escucha, pueblo mío, y hablaré.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Testificaré contra ti, Israel.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Yo soy ʼElohim, el ʼElohim tuyo.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"No te reprendo por tus sacrificios.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Tus ofrendas encendidas están siempre delante de Mí.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"No aceptaré becerros de tu casa,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Ni machos cabríos de tus corrales.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Porque mía es toda bestia del bosque","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y los ganados sobre 1.000 colinas.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Conozco todas las aves de las montañas,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y todo lo que se mueve en el campo es mío.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Si tuviera hambre,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"No te lo diría a ti,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Porque mío es el mundo y todo lo que contiene.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"¿Yo como carne de becerros?","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"¿Bebo sangre de machos cabríos?","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ofrece a ʼElohim sacrificio de acción de gracias.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Paga a ʼElyón tus votos.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Invócame en el día de la angustia.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Te libraré,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y tú me honrarás.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"al perverso ʼElohim dice:","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"¿Qué derecho tienes tú para recitar mis Estatutos,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y tomar mi Pacto en tu boca?","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Porque tú aborreces la corrección,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y das tu espalda a mis Palabras.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Si ves a un ladrón, te complaces con él,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y te asocias con los adúlteros.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Permites que tu boca se pierda en lo malo,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y tu lengua trama el engaño.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Te sientas, hablas contra tu hermano,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y difamas al hijo de tu propia madre.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Estas cosas hiciste,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y Yo callé.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Pensaste que Yo soy como tú.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Pero te reprenderé y las expondré delante de tus ojos.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Entiendan esto, los que se olvidan de ʼEloah,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"No sea que los quebrante sin que haya quien los libre.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"El que ofrece sacrificio de acción de gracias me honra,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y al que ordena rectamente su camino","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Le mostraré la salvación de ʼElohim.","wordsOfJesus":true,"poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}