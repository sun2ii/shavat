{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"heading","content":["Al director del coro. Instrucción (Maskil) de David, cuando Doeg Edomita dio aviso a Saúl, y le dijo: David entró en casa de Ahimelec"]},{"type":"verse","number":1,"content":[{"text":"¿Por qué te jactas de ser perverso, oh poderoso?","poem":1},{"lineBreak":true},{"text":"La misericordia de ʼEL es continua.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tu lengua diseña destrucción.","poem":1},{"lineBreak":true},{"text":"Produce engaño, como una navaja afilada.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tú amas más el mal que el bien,","poem":1},{"lineBreak":true},{"text":"La mentira más bien que hablar lo recto. Selah","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tú amas todas las palabras que devoran, oh lengua engañosa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Por tanto, ʼEL te destruirá para siempre.","poem":1},{"lineBreak":true},{"text":"Te arrastrará,","poem":1},{"lineBreak":true},{"text":"Te arrancará de la tierra de los vivientes","poem":1},{"lineBreak":true},{"text":"Y te desarraigará de la tierra de los vivientes. Selah","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Verán los justos y temerán.","poem":1},{"lineBreak":true},{"text":"Se reirán de él y dirán:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Miren al hombre que no tomó a ʼElohim como su Fortaleza,","poem":1},{"lineBreak":true},{"text":"Sino confió en la abundancia de sus riquezas","poem":1},{"lineBreak":true},{"text":"Y fue fuerte en su perversidad!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Pero yo estaré como olivo frondoso en la Casa de ʼElohim,","poem":1},{"lineBreak":true},{"text":"Porque en la misericordia de ʼElohim confío eternamente y para siempre.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Te daré gracias para siempre por lo que hiciste,","poem":1},{"lineBreak":true},{"text":"Y esperaré en tu Nombre,","poem":1},{"lineBreak":true},{"text":"Porque es bueno en presencia de tus devotos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}