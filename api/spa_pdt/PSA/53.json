{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"heading","content":["Al director del coro. Al estilo de duelo (Mahalath). Instrucción (Maskil) de David"]},{"type":"verse","number":1,"content":[{"text":"El necio dijo en su corazón: No hay ʼElohim.","poem":1},{"lineBreak":true},{"text":"Están corrompidos.","poem":1},{"lineBreak":true},{"text":"Cometieron repugnante injusticia.","poem":1},{"lineBreak":true},{"text":"No hay uno que haga lo recto.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ʼElohim miró desde el cielo a los hijos de hombres","poem":1},{"lineBreak":true},{"text":"Para ver si hay alguno que entiende,","poem":1},{"lineBreak":true},{"text":"Que busca a ʼElohim.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Cada uno de ellos se apartó.","poem":1},{"lineBreak":true},{"text":"Juntamente se volvieron corruptos.","poem":1},{"lineBreak":true},{"text":"No hay quien hace lo bueno,","poem":1},{"lineBreak":true},{"text":"Ni siquiera uno.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¿Los que practican iniquidad no saben","poem":1},{"lineBreak":true},{"text":"Que devoran a mi pueblo como si comieran pan,","poem":1},{"lineBreak":true},{"text":"Y no invocaron a ʼElohim?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Allí, donde nada había que temer, tuvieron gran terror.","poem":1},{"lineBreak":true},{"text":"Porque ʼElohim dispersó a los que acamparon contra ti,","poem":1},{"lineBreak":true},{"text":"Los avergonzaste,","poem":1},{"lineBreak":true},{"text":"Porque ʼElohim los rechazó.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡Oh, que venga de Sion la salvación de Israel!","poem":1},{"lineBreak":true},{"text":"Cuando ʼElohim restaure de la cautividad a su pueblo,","poem":1},{"lineBreak":true},{"text":"¡Que se regocije Jacob, y se alegre Israel!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}