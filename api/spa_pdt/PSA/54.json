{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Al director del coro. Sobre instrumentos de cuerda. Instrucción. (Maskil) de David, cuando llegaron los zifeos y dijeron a Saúl: ¿No se esconde David entre nosotros?"]},{"type":"verse","number":1,"content":[{"text":"Oh ʼElohim, sálvame por tu Nombre,","poem":1},{"lineBreak":true},{"text":"Y defiéndeme con tu poder.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Oh ʼElohim, escucha mi oración.","poem":1},{"lineBreak":true},{"text":"Escucha las palabras de mi boca.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Porque extraños se levantaron contra mí,","poem":1},{"lineBreak":true},{"text":"Y hombres violentos buscan mi vida.","poem":1},{"lineBreak":true},{"text":"No colocaron a ʼElohim delante de ellos. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ciertamente ʼElohim es el que me ayuda.","poem":1},{"lineBreak":true},{"text":"ʼAdonay es Quien sostiene mi vida.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Él hace volver el mal contra mis enemigos.","poem":1},{"lineBreak":true},{"text":"Por tu fidelidad, destrúyelos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Voluntariamente te ofreceré sacrificio.","poem":1},{"lineBreak":true},{"text":"Oh Yavé, daré gracias a tu Nombre","poem":1},{"lineBreak":true},{"text":"Porque es bueno,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Porque me libraste de toda angustia","poem":1},{"lineBreak":true},{"text":"Y mis ojos vieron la ruina de mis enemigos.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}