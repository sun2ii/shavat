{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"heading","content":["Al director del coro. Sobre la paloma silenciosa en parajes muy lejanos."]},{"type":"heading","content":["Canto a media voz (Mictam) de David, cuando los filisteos lo capturaron en Gat"]},{"type":"verse","number":1,"content":[{"text":"Oh ʼElohim, ten compasión de mí,","poem":1},{"lineBreak":true},{"text":"Porque el hombre me pisotea, me devora,","poem":1},{"lineBreak":true},{"text":"Me oprime y me combate todo el día.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Los que me asaltan me pisotean todo el día,","poem":1},{"lineBreak":true},{"text":"Porque son muchos los que con soberbia pelean contra mí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"El día cuando temo, confío en Ti.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"En ʼElohim, la Palabra de Quien alabo,","poem":1},{"lineBreak":true},{"text":"En ʼElohim confío, no temeré.","poem":1},{"lineBreak":true},{"text":"¿Qué puede hacerme el hombre?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Todo el día pervierten mis palabras.","poem":1},{"lineBreak":true},{"text":"Contra mí son todos sus pensamientos para mal.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Conspiran, acechan, observan atentamente mis pasos en acecho de mi vida.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pésalos a causa de su perversidad.","poem":1},{"lineBreak":true},{"text":"Con furia derriba los pueblos, oh ʼElohim.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tomaste en cuenta mis huidas.","poem":1},{"lineBreak":true},{"text":"Coloca mis lágrimas en tu botella.","poem":1},{"lineBreak":true},{"text":"¿No están ellas en tu rollo?","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"El día cuando yo te invoque retrocederán mis enemigos.","poem":1},{"lineBreak":true},{"text":"Esto sé porque ʼElohim está a mi favor.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Oh ʼElohim, tu Palabra alabo,","poem":1},{"lineBreak":true},{"text":"Oh Yavé, tu Palabra alabo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"En ʼElohim confié, no temeré.","poem":1},{"lineBreak":true},{"text":"¿Qué puede hacerme el hombre?","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Oh ʼElohim, sobre mí están los votos.","poem":1},{"lineBreak":true},{"text":"Te pagaré ofrendas de acción de gracias,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Porque libraste mi vida de la muerte","poem":1},{"lineBreak":true},{"text":"Y mis pies de tropezar,","poem":1},{"lineBreak":true},{"text":"Para que ande delante de ʼElohim","poem":1},{"lineBreak":true},{"text":"En la luz de los que viven.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}