{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["Al director del coro. A modo de “No destruyas.”"]},{"type":"heading","content":["Canto a media voz (Mictam) de David, en la cueva, cuando huía de Saúl"]},{"type":"verse","number":1,"content":[{"text":"Ten compasión de mí, oh ʼElohim.","poem":1},{"lineBreak":true},{"text":"Ten compasión de mí.","poem":1},{"lineBreak":true},{"text":"Porque mi alma confía en Ti,","poem":1},{"lineBreak":true},{"text":"Y en la sombra de tus alas me amparo","poem":1},{"lineBreak":true},{"text":"Hasta que pase la destrucción.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Clamaré a ʼElohim ʼElyón,","poem":1},{"lineBreak":true},{"text":"A ʼEL, Quien me favorece.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Él enviará desde el cielo","poem":1},{"lineBreak":true},{"text":"Y me salvará de la infamia del que me oprime. Selah","poem":1},{"lineBreak":true},{"text":"ʼElohim enviará su misericordia y su verdad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mi vida está en medio de leones.","poem":1},{"lineBreak":true},{"text":"Estoy tendido entre los que respiran fuego.","poem":1},{"lineBreak":true},{"text":"Hijos de hombres, sus dientes son lanzas y flechas,","poem":1},{"lineBreak":true},{"text":"Y su lengua, espada aguda.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"¡Exaltado seas sobre los cielos, oh ʼElohim!","poem":1},{"lineBreak":true},{"text":"¡Tu gloria sea sobre toda la tierra!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tendieron una red ante mis pies para doblegar mi vida.","poem":1},{"lineBreak":true},{"text":"Cavaron un hoyo delante de mí","poem":1},{"lineBreak":true},{"text":"Y ellos cayeron en él. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mi corazón está establecido, oh ʼElohim.","poem":1},{"lineBreak":true},{"text":"Está firme mi corazón.","poem":1},{"lineBreak":true},{"text":"Cantaré y entonaré salmos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Despierta, alma mía.","poem":1},{"lineBreak":true},{"text":"Despierten, arpa y lira.","poem":1},{"lineBreak":true},{"text":"Yo despertaré el alba.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Te daré gracias entre los pueblos, oh ʼAdonay.","poem":1},{"lineBreak":true},{"text":"Te cantaré salmos en las naciones.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Porque tu misericordia es grande hasta los cielos,","poem":1},{"lineBreak":true},{"text":"Y tu verdad, hasta las nubes.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Exaltado seas sobre los cielos, oh ʼElohim.","poem":1},{"lineBreak":true},{"text":"Y tu gloria sea por encima de toda la tierra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}