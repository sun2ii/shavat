{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"heading","content":["Al director del coro. Al modo del “Lirio del Testimonio”"]},{"type":"heading","content":["Canto a media voz (Mictam) de David, cuando combatió contra Siria Mesopotámica y contra Siria de Soba, y Joab regresó y derrotó a 12.000 edomitas en el valle de la Sal."]},{"type":"verse","number":1,"content":[{"text":"Oh ʼElohim, Tú nos rechasaste.","poem":1},{"lineBreak":true},{"text":"Tú nos desechaste, rompiste nuestras defensas.","poem":1},{"lineBreak":true},{"text":"Te airaste. Vuelve a nosotros.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Hiciste temblar la tierra, la agrietaste.","poem":1},{"lineBreak":true},{"text":"Repara sus grietas, porque se tambalea.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hiciste sufrir a tu pueblo cosas duras.","poem":1},{"lineBreak":true},{"text":"Nos hiciste beber vino de aturdimiento.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero a tus fieles diste un estandarte","poem":1},{"lineBreak":true},{"text":"Para que sea desplegado por causa de la verdad. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sálvanos con tu mano derecha, y respóndenos,","poem":1},{"lineBreak":true},{"text":"Para que sean librados tus amados.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ʼElohim respondió desde su Santuario:","poem":1},{"lineBreak":true},{"text":"¡Yo me alegraré!","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Repartiré a Siquem,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y mediré el valle de Sucot.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mío es Galaad y mío es Manasés,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Efraín es el casco de mi cabeza,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Judá, mi cetro,","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Moab, vasija para lavarme.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Sobre Edom echaré mi sandalia,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y sobre Filistea lanzaré mi grito de victoria.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¿Quién me conducirá a la ciudad fortificada?","poem":1},{"lineBreak":true},{"text":"¿Quién me guiará a Edom?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"¿No eres Tú, oh ʼElohim, Quien nos rechazaste","poem":1},{"lineBreak":true},{"text":"Y no sales con nuestros ejércitos, oh ʼElohim?","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Socórrenos ante el adversario,","poem":1},{"lineBreak":true},{"text":"Porque vana es la liberación del hombre.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Con ʼElohim haremos proezas.","poem":1},{"lineBreak":true},{"text":"Él pisoteará a nuestros adversarios.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}