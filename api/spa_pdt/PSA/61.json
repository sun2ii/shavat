{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Al director del coro. Con música de cuerdas. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Oh ʼElohim, oye mi clamor.","poem":1},{"lineBreak":true},{"text":"Atiende mi súplica.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Cuando mi corazón desmaya,","poem":1},{"lineBreak":true},{"text":"Clamo a Ti desde el extremo de la tierra:","poem":1},{"lineBreak":true},{"text":"Llévame a la Roca que es más alta que yo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Porque Tú fuiste mi Refugio,","poem":1},{"lineBreak":true},{"text":"Torre fuerte contra el enemigo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Permite que yo viva en tu Tabernáculo para siempre","poem":1},{"lineBreak":true},{"text":"Y que me refugie al amparo de tus alas. Selah","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Porque Tú, ʼElohim, oíste mis votos.","poem":1},{"lineBreak":true},{"text":"Diste heredad a los que temen tu Nombre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Prolongarás la vida del rey.","poem":1},{"lineBreak":true},{"text":"Sus años serán como muchas generaciones.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Estará para siempre delante de ʼElohim.","poem":1},{"lineBreak":true},{"text":"Prepara misericordia y verdad para que lo preserven.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Así cantaré alabanza a tu Nombre para siempre,","poem":1},{"lineBreak":true},{"text":"A fin de pagar mis votos cada día.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}