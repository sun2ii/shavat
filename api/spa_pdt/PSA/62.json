{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"heading","content":["Al director del coro, para Jedutún. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Solo en ʼElohim se aquieta mi alma.","poem":1},{"lineBreak":true},{"text":"De Él viene mi salvación.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Solo Él es mi Roca, mi Salvación, mi Refugio.","poem":1},{"lineBreak":true},{"text":"No seré grandemente sacudido.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"¿Hasta cuándo atacarán a un hombre todos juntos para matarlo,","poem":1},{"lineBreak":true},{"text":"Para derribarlo como a un muro desplomado o a una cerca insegura?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Solo consultan para derribarlo de su alta posición.","poem":1},{"lineBreak":true},{"text":"Se deleitan en la falsedad.","poem":1},{"lineBreak":true},{"text":"Bendicen con su boca,","poem":1},{"lineBreak":true},{"text":"Pero maldicen en su interior. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Solo en ʼElohim cálmate, alma mía,","poem":1},{"lineBreak":true},{"text":"Porque de Él viene mi esperanza.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Solo Él es mi Roca, mi Salvación, mi alto Refugio.","poem":1},{"lineBreak":true},{"text":"No seré sacudido.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"En ʼElohim está mi salvación y mi gloria.","poem":1},{"lineBreak":true},{"text":"La Roca de mi fortaleza,","poem":1},{"lineBreak":true},{"text":"Mi Refugio está en ʼElohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oh pueblo, confíen en Él en todo tiempo.","poem":1},{"lineBreak":true},{"text":"Derramen su corazón ante Él.","poem":1},{"lineBreak":true},{"text":"ʼElohim es nuestro Refugio. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Los hombres de bajo grado son solo vanidad.","poem":1},{"lineBreak":true},{"text":"Y los hombres de alto rango son una mentira.","poem":1},{"lineBreak":true},{"text":"Puestos en balanza suben,","poem":1},{"lineBreak":true},{"text":"Juntos son más livianos que un soplo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"No confíen en la opresión,","poem":1},{"lineBreak":true},{"text":"Ni se envanezcan en el robo.","poem":1},{"lineBreak":true},{"text":"Si se aumentan las riquezas,","poem":1},{"lineBreak":true},{"text":"No fijen el corazón en ellas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Una vez habló ʼElohim.","poem":1},{"lineBreak":true},{"text":"Dos veces oí esto:","poem":1},{"lineBreak":true},{"text":"Que el poder es de ʼElohim.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"La misericordia es tuya, oh ʼAdonay,","poem":1},{"lineBreak":true},{"text":"Porque Tú pagas a cada uno según su obra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}