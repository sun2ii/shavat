{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["Salmo de David, compuesto cuando estaba en el desierto de Judá"]},{"type":"verse","number":1,"content":[{"text":"Oh ʼElohim, Tú eres mi ʼEL.","poem":1},{"lineBreak":true},{"text":"Ansiosamente te busqué.","poem":1},{"lineBreak":true},{"text":"Mi alma tiene sed de Ti.","poem":1},{"lineBreak":true},{"text":"Mi cuerpo te anhela en tierra árida y deshabitada,","poem":1},{"lineBreak":true},{"text":"Donde no hay agua.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Así te busqué en el Santuario","poem":1},{"lineBreak":true},{"text":"Para ver tu poder y tu gloria.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Porque tu misericordia es mejor que la vida,","poem":1},{"lineBreak":true},{"text":"Mis labios te alabarán.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Por tanto te bendeciré en mi vida.","poem":1},{"lineBreak":true},{"text":"En tu Nombre alzaré mis manos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Como con médula y sustancia está saciada mi alma.","poem":1},{"lineBreak":true},{"text":"Mi boca te alaba con labios jubilosos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Cuando en mi cama me acuerdo de Ti,","poem":1},{"lineBreak":true},{"text":"Cuando medito en Ti en las vigilias","poem":1},{"noteId":13},{"text":"de la noche.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Porque Tú eres mi Socorro.","poem":1},{"lineBreak":true},{"text":"Bajo la sombra de tus alas canto con gozo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mi alma está apegada a Ti.","poem":1},{"lineBreak":true},{"text":"Tu mano derecha me sostiene.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pero los que buscan mi vida para destruirla","poem":1},{"lineBreak":true},{"text":"Caerán en las profundidades más bajas de la tierra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Serán destruidos a filo de espada.","poem":1},{"lineBreak":true},{"text":"Serán presa de los chacales.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pero el rey se regocija en ʼElohim.","poem":1},{"lineBreak":true},{"text":"Cualquiera que jura por Él será alabado,","poem":1},{"lineBreak":true},{"text":"Porque las bocas de los que dicen mentiras serán tapadas.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Dividían la noche en cuatro partes llamada vigilias: de 6 a 9, de 9 a 12, de 12 a 3, de 3 a 6.","reference":{"chapter":63,"verse":6}}]},"thisChapterLink":"/api/spa_pdt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}