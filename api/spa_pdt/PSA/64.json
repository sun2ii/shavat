{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["Al director del coro. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"Escucha, oh ʼElohim, la voz de mi queja:","poem":1},{"lineBreak":true},{"text":"Preserva mi vida del terror de perversos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ocúltame de la conspiración de malhechores,","poem":1},{"lineBreak":true},{"text":"Del tumulto de los que hacen iniquidad,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Que afilan sus lenguas como una espada,","poem":1},{"lineBreak":true},{"text":"Y la emplean como su flecha en un lenguaje amargo","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Para dispararlas en oculto al inocente.","poem":1},{"lineBreak":true},{"text":"De repente disparan sus flechas, sin que teman.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Se animan unos a otros en su perverso designio","poem":1},{"lineBreak":true},{"text":"Y planean esconder trampas.","poem":1},{"lineBreak":true},{"text":"Dicen: ¿Quién las verá?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Traman injusticias y dicen:","poem":1},{"lineBreak":true},{"text":"Estamos listos con una conspiración bien concebida.","poem":1},{"lineBreak":true},{"text":"Tanto el pensamiento íntimo como el corazón del hombre son profundos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Pero ʼElohim les dispara una flecha.","poem":1},{"lineBreak":true},{"text":"De repente vendrán sus plagas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Así que ellas los hacen tropezar.","poem":1},{"lineBreak":true},{"text":"Los que los ven menean la cabeza.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Entonces temerán todos los hombres.","poem":1},{"lineBreak":true},{"text":"Proclamarán la obra de ʼElohim","poem":1},{"lineBreak":true},{"text":"Y entenderán sus hechos.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"El justo se alegrará en Yavé,","poem":1},{"lineBreak":true},{"text":"Y se confiará en Él.","poem":1},{"lineBreak":true},{"text":"Se gloriarán todos los rectos de corazón.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}