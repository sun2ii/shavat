{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Al director del coro. Con instrumentos de cuerda. Salmo. Canto"]},{"type":"verse","number":1,"content":[{"text":"ʼElohim tenga compasión de nosotros y nos bendiga,","poem":1},{"lineBreak":true},{"text":"Resplandezca su rostro sobre nosotros, Selah","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Para que tu camino sea conocido en la tierra,","poem":1},{"lineBreak":true},{"text":"Y tu salvación en todas las naciones.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Que los pueblos te alaben, oh ʼElohim.","poem":1},{"lineBreak":true},{"text":"Que todos los pueblos te alaben.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Que se regocijen y canten con júbilo las naciones.","poem":1},{"lineBreak":true},{"text":"Porque Tú juzgarás a los pueblos con equidad,","poem":1},{"lineBreak":true},{"text":"Y guiarás a las naciones de la tierra. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Que te alaben los pueblos, oh ʼElohim.","poem":1},{"lineBreak":true},{"text":"Que todos los pueblos te alaben.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"La tierra dio su fruto.","poem":1},{"lineBreak":true},{"text":"ʼElohim, el ʼElohim nuestro, nos bendice.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ʼElohim nos bendiga.","poem":1},{"lineBreak":true},{"text":"Que le teman todos los confines de la tierra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}