{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["Al director del coro. Salmo de David. En conmemoración"]},{"type":"verse","number":1,"content":[{"text":"Oh ʼElohim, apresúrate a librarme.","poem":1},{"lineBreak":true},{"text":"Apresúrate, oh Yavé, a socorrerme.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sean avergonzados y humillados","poem":1},{"lineBreak":true},{"text":"Los que buscan mi vida,","poem":1},{"lineBreak":true},{"text":"Sean vueltos atrás y confundidos","poem":1},{"lineBreak":true},{"text":"Los que desean mi mal.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Sean vueltos atrás a causa de su vergüenza","poem":1},{"lineBreak":true},{"text":"Los que dicen: ¡Ea, ea!","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Regocíjense y alégrense en Ti todos los que te buscan.","poem":1},{"lineBreak":true},{"text":"Y aquellos que aman tu salvación digan siempre:","poem":1},{"lineBreak":true},{"text":"¡Engrandecido sea ʼElohim!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Pero yo estoy afligido y menesteroso.","poem":1},{"lineBreak":true},{"text":"Oh ʼElohim, apresúrate a mí.","poem":1},{"lineBreak":true},{"text":"Tú eres mi Ayudador y mi Libertador.","poem":1},{"lineBreak":true},{"text":"Oh Yavé, no demores.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}