jacten.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y a los perversos: No alcen su cuerno,","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ni levanten su cuerno en alto,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Ni hablen con orgullo insolente.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Porque ni del oriente ni del occidente,","poem":1},{"lineBreak":true},{"text":"Ni del desierto viene la exaltación,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sino ʼElohim es el Juez.","poem":1},{"lineBreak":true},{"text":"A éste humilla y a aquél enaltece.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hay una copa en la mano de Yavé,","poem":1},{"lineBreak":true},{"text":"Y el vino fermenta.","poem":1},{"lineBreak":true},{"text":"Está bien mezclado y lo derramará.","poem":1},{"lineBreak":true},{"text":"Y tendrá que ser sorbido hasta sus sedimentos.","poem":1},{"lineBreak":true},{"text":"¡Ciertamente todos los perversos de la tierra lo beberán!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pero yo lo declararé para siempre.","poem":1},{"lineBreak":true},{"text":"Cantaré salmos al ʼElohim de Jacob.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Él quebrará el cuerno de los perversos,","poem":1},{"lineBreak":true},{"text":"Pero el cuerno de los justos será exaltado.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}