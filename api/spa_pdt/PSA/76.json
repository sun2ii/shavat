{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["Al director del coro. Con instrumentos de cuerda. Salmo de Asaf. Canto"]},{"type":"verse","number":1,"content":[{"text":"ʼElohim es conocido en Judá,","poem":1},{"lineBreak":true},{"text":"Y en Israel es grande su Nombre.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"En Salén está su Tabernáculo.","poem":1},{"lineBreak":true},{"text":"Su lugar de morada también está en Sion.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Allí quebró las flechas encendidas,","poem":1},{"lineBreak":true},{"text":"El escudo y la espada y las armas de guerra. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¡Eres esplendoroso!","poem":1},{"lineBreak":true},{"text":"¡Más majestuoso que las montañas de caza!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Los valientes fueron saqueados.","poem":1},{"lineBreak":true},{"text":"Duermen su sueño.","poem":1},{"lineBreak":true},{"text":"Ninguno de los soldados pudo usar sus manos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¡A tu reprensión, oh ʼElohim de Jacob,","poem":1},{"lineBreak":true},{"text":"Tanto jinete como caballo fueron lanzados a un sueño mortal!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Tú, solo Tú debes ser temido!","poem":1},{"lineBreak":true},{"text":"¿Y quién puede permanecer en tu Presencia cuando estás airado?","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Desde los cielos hiciste oír la sentencia.","poem":1},{"lineBreak":true},{"text":"La tierra tuvo temor y permaneció quieta","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cuando ʼElohim se levantó a juzgar,","poem":1},{"lineBreak":true},{"text":"A salvar a todos los mansos de la tierra. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ciertamente las iras del hombre te exaltarán,","poem":1},{"lineBreak":true},{"text":"Y te atarás con los sobrevivientes de las iras.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hagan votos a Yavé su ʼElohim y cúmplanlos.","poem":1},{"lineBreak":true},{"text":"Que todos los que lo rodean traigan presentes al que debe ser temido.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Él humillará el espíritu de magistrados.","poem":1},{"lineBreak":true},{"text":"Él es temido por los reyes de la tierra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}