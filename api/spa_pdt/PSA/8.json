{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["Al director del coro, con notas. Salmo de David"]},{"type":"verse","number":1,"content":[{"text":"¡Oh Yavé, ʼAdonay nuestro,","poem":1},{"lineBreak":true},{"text":"Cuán majestuoso es tu Nombre en toda la tierra!","poem":1},{"lineBreak":true},{"text":"Colocaste tu majestad sobre los cielos.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"De la boca de los niños y de los que maman","poem":1},{"lineBreak":true},{"text":"Estableciste una fortaleza frente a tus adversarios","poem":1},{"lineBreak":true},{"text":"Para silenciar al enemigo y al vengador.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Cuando contemplo tus cielos, la obra de tus dedos,","poem":1},{"lineBreak":true},{"text":"La luna y las estrellas que Tú afirmaste,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Digo: ¿Qué es el hombre, para que te acuerdes de él,","poem":1},{"lineBreak":true},{"text":"El hijo de hombre, para que te preocupes por él?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lo hiciste un poco menor que los ángeles.","poem":1},{"lineBreak":true},{"text":"Lo coronaste de gloria y honor.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lo haces dominar sobre las obras de tus manos.","poem":1},{"lineBreak":true},{"text":"Colocaste todas las cosas debajo de sus pies:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ovejas y bueyes, todo ello,","poem":1},{"lineBreak":true},{"text":"Y también las bestias del campo,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Las aves del cielo y los peces del mar,","poem":1},{"lineBreak":true},{"text":"Todo cuanto pasa por los senderos de los mares.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"¡Oh Yavé, ʼAdonay nuestro,","poem":1},{"lineBreak":true},{"text":"Cuán majestuoso es tu Nombre en toda la tierra!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}