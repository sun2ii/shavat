{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"heading","content":["Al director del coro. Según Geteos. Salmo de Asaf"]},{"type":"verse","number":1,"content":[{"text":"Canten con gozo a ʼElohim, Fortaleza nuestra.","poem":1},{"lineBreak":true},{"text":"Aclamen con júbilo al ʼElohim de Jacob.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Eleven un canto, batan el pandero, la suave lira","poem":1},{"noteId":17},{"text":"y el arpa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Soplen la corneta en la Nueva Luna en el día de nuestra fiesta,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Porque estatuto es para Israel,","poem":1},{"lineBreak":true},{"text":"Ordenanza del ʼElohim de Jacob.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Lo estableció como testimonio en José","poem":1},{"lineBreak":true},{"text":"Cuando salió de la tierra de Egipto.","poem":1},{"lineBreak":true},{"text":"Escuché un lenguaje que no conocía.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Quité su hombro de debajo de la carga.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Sus manos fueron libradas del peso de los cestos.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"En la angustia clamaste,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y Yo te rescaté.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Te respondí en el secreto del trueno.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Te probé junto al agua de Meriba. Selah","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Escucha, pueblo mío, y te amonestaré.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Oh Israel, si me escuchas,","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Que no haya en medio de ti ʼelohim extraño,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Ni adores algún ʼelohim extranjero.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yo soy Yavé,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Tu ʼElohim,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"El que te sacó de la tierra de Egipto.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"¡Abre tu boca, y Yo la llenaré!","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pero mi pueblo no escuchó mi voz.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Israel no me obedeció.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Por eso los entregué a la dureza de su corazón,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Para que anduvieran según sus propios designios.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"¡Oh, si mi pueblo me escuchara!","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"¡Que Israel anduviera en mis caminos!","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Prontamente Yo sometería a sus enemigos","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y volvería mi mano contra sus adversarios.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Los que aborrecen a Yavé se le someterían,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Pero su castigo duraría para siempre.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Pero a ti te sustentaría con lo más fino del trigo","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y te saciaría con miel de la roca.","wordsOfJesus":true,"poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Lira: Antiguo instrumento músico de varias cuerdas tensas en un marco.","reference":{"chapter":81,"verse":2}}]},"thisChapterLink":"/api/spa_pdt/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}