{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Salmo de Asaf"]},{"type":"verse","number":1,"content":[{"text":"ʼElohim toma su posición en la asamblea de los ʼelohim.","poem":1},{"lineBreak":true},{"text":"Juzga en medio de los ʼelohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"¿Hasta cuándo juzgarán injustamente,","poem":1},{"lineBreak":true},{"text":"Y mostrarán parcialidad a los perversos? Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Defiendan al débil y al huérfano.","poem":1},{"lineBreak":true},{"text":"Hagan justicia al afligido y al menesteroso.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Rescaten al débil y al necesitado.","poem":1},{"lineBreak":true},{"text":"Líbrenlos de mano de los perversos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"No saben ni entienden.","poem":1},{"lineBreak":true},{"text":"Andan en la oscuridad.","poem":1},{"lineBreak":true},{"text":"Son conmovidos todos los cimientos de la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yo dije: Ustedes son ʼelohim.","poem":1},{"lineBreak":true},{"text":"Todos ustedes son hijos del ʼElyón.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sin embargo, como hombres morirán.","poem":1},{"lineBreak":true},{"text":"Caerán como cualquiera de los gobernantes.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Levántate, oh ʼElohim, juzga la tierra,","poem":1},{"lineBreak":true},{"text":"Porque Tú posees todas las naciones.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}