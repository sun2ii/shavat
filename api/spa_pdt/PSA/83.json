{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["Canto. Salmo de Asa"]},{"type":"verse","number":1,"content":[{"text":"Oh ʼElohim, no permanezcas en silencio.","poem":1},{"lineBreak":true},{"text":"Oh ʼElohim, no calles, no estés imperturbable.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pues mira que rugen tus enemigos,","poem":1},{"lineBreak":true},{"text":"Y los que te aborrecen levantan la cabeza.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Astutamente consultaron contra tu pueblo.","poem":1},{"lineBreak":true},{"text":"Conspiran contra tus protegidos.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dijeron: Vengan.","poem":1},{"lineBreak":true},{"text":"Destruyámoslos para que no sean nación.","poem":1},{"lineBreak":true},{"text":"Que no haya más memoria del nombre de Israel.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Porque con consentimiento conspiraron juntos.","poem":1},{"lineBreak":true},{"text":"Contra Ti hacen un pacto:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Las tiendas de Edom y los ismaelitas, Moab y los agarenos,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Gebal, Amón y Amalec, Filistea con los habitantes de Tiro,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"También Asiria se unió a ellos.","poem":1},{"lineBreak":true},{"text":"Sirven de brazo a los hijos de Lot. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Haz con ellos como con Madián,","poem":1},{"lineBreak":true},{"text":"Como con Sísara,","poem":1},{"lineBreak":true},{"text":"Como con Jabín en el torrente de Cisón,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Que fueron destruidos en Endor","poem":1},{"lineBreak":true},{"text":"Y fueron como abono para la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Haz a sus nobles como a Oreb y a Zeeb,","poem":1},{"lineBreak":true},{"text":"Y a todos sus jefes como a Zeba y Zalmuna,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Porque dijeron:","poem":1},{"lineBreak":true},{"text":"Tomemos como posesión nuestra los prados de ʼElohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Oh ʼElohim mío, conviértelos como un remolino de polvo,","poem":1},{"lineBreak":true},{"text":"Como hojarasca ante el viento,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Como fuego que consume el bosque,","poem":1},{"lineBreak":true},{"text":"Como una llama incendia las montañas.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Persíguelos así con tu tempestad","poem":1},{"lineBreak":true},{"text":"Y aterrorízalos con tu tormenta.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Llena sus caras de deshonra,","poem":1},{"lineBreak":true},{"text":"Para que busquen tu Nombre, oh Yavé.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sean avergonzados y turbados para siempre.","poem":1},{"lineBreak":true},{"text":"Sean humillados y perezcan,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Y sepan que solo Tú, tu Nombre es Yavé.","poem":1},{"lineBreak":true},{"text":"Eres el ʼElyón sobre toda la tierra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}