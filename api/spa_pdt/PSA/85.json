{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"heading","content":["Al director del coro. Salmo de los hijos de Coré"]},{"type":"verse","number":1,"content":[{"text":"Oh Yavé, fuiste favorable a tu tierra.","poem":1},{"lineBreak":true},{"text":"Devolviste a los cautivos de Jacob.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Perdonaste la iniquidad de tu pueblo.","poem":1},{"lineBreak":true},{"text":"Cubriste todos sus pecados. Selah","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Retiraste toda tu indignación.","poem":1},{"lineBreak":true},{"text":"Te apartaste de tu ardiente ira.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Restáuranos, oh ʼElohim de nuestra salvación.","poem":1},{"lineBreak":true},{"text":"Que cese tu ira contra nosotros.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Estarás airado contra nosotros para siempre?","poem":1},{"lineBreak":true},{"text":"¿Extenderás tu ira a todas las generaciones?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"¿No volverás Tú a darnos vida","poem":1},{"lineBreak":true},{"text":"Para que tu pueblo se regocije en Ti?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Muéstranos, oh Yavé, tu misericordia","poem":1},{"lineBreak":true},{"text":"Y danos tu salvación!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Escucharé lo que diga ʼEL, el Yavé,","poem":1},{"lineBreak":true},{"text":"Porque hablará paz a su pueblo y a sus santos","poem":1},{"lineBreak":true},{"text":"Para que no vuelvan a la insensatez.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ciertamente tu salvación está cerca a los que te temen,","poem":1},{"lineBreak":true},{"text":"Para que la gloria more en nuestra tierra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"La misericordia y la verdad se encontraron.","poem":1},{"lineBreak":true},{"text":"La justicia y la paz se besaron.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"La verdad brota de la tierra,","poem":1},{"lineBreak":true},{"text":"Y la justicia mira desde el cielo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ciertamente Yavé dará lo bueno,","poem":1},{"lineBreak":true},{"text":"Y nuestra tierra dará su fruto.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"La justicia irá delante de Él,","poem":1},{"lineBreak":true},{"text":"Y sus pisadas serán nuestro camino.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}