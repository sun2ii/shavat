{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"heading","content":["Oración de David"]},{"type":"verse","number":1,"content":[{"text":"Oh Yavé, inclina tu oído y escúchame.","poem":1},{"lineBreak":true},{"text":"Porque estoy afligido y necesitado.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Guarda mi alma, porque soy piadoso.","poem":1},{"lineBreak":true},{"text":"Oh ʼElohim mío, salva a tu esclavo que confía en Ti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Oh ʼAdonay, ten compasión de mí,","poem":1},{"lineBreak":true},{"text":"Porque a Ti clamo todo el día.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Oh ʼAdonay, alegra el alma de tu esclavo,","poem":1},{"lineBreak":true},{"text":"Porque a Ti levanto mi alma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Porque Tú, ʼAdonay, eres bueno y perdonador,","poem":1},{"lineBreak":true},{"text":"Grande en misericordia para todos los que te invocan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Oh Yavé, escucha mi oración","poem":1},{"lineBreak":true},{"text":"Y atiende a la voz de mis súplicas.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"En el día de mi angustia te llamaré,","poem":1},{"lineBreak":true},{"text":"Porque Tú me responderás.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oh ʼAdonay, no hay uno como Tú entre los ʼelohim,","poem":1},{"lineBreak":true},{"text":"Ni obras que igualen tus obras.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Oh ʼAdonay, vendrán todas las naciones que hiciste,","poem":1},{"lineBreak":true},{"text":"Se postrarán delante de Ti","poem":1},{"lineBreak":true},{"text":"Y glorificarán tu Nombre.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Porque Tú eres grande,","poem":1},{"lineBreak":true},{"text":"Hacedor de maravillas.","poem":1},{"lineBreak":true},{"text":"¡Solo Tú eres ʼElohim!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Enséñame, oh Yavé, tu camino.","poem":1},{"lineBreak":true},{"text":"Caminaré en tu verdad.","poem":1},{"lineBreak":true},{"text":"Afirma mi corazón para que tema tu Nombre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Oh ʼAdonay, ʼElohim mío, te alabaré con todo mi corazón.","poem":1},{"lineBreak":true},{"text":"Glorificaré tu Nombre para siempre.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Porque tu misericordia es grande hacia mí,","poem":1},{"lineBreak":true},{"text":"Libraste mi alma de las profundidades del Seol.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Oh ʼElohim, hombres arrogantes se levantaron contra mí,","poem":1},{"lineBreak":true},{"text":"Y una banda de violentos busca mi vida.","poem":1},{"lineBreak":true},{"text":"No te colocaron delante de ellos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Pero Tú, ʼAdonay, eres un ʼEL misericordioso y compasivo,","poem":1},{"lineBreak":true},{"text":"Lento para la ira y grande en misericordia y verdad.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mírame y ten compasión de mí.","poem":1},{"lineBreak":true},{"text":"Da tu fortaleza a tu esclavo,","poem":1},{"lineBreak":true},{"text":"Y salva al hijo de tu esclava.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Muéstrame una señal para bien.","poem":1},{"lineBreak":true},{"text":"Que la vean los que me aborrecen","poem":1},{"lineBreak":true},{"text":"Y sean avergonzados.","poem":1},{"lineBreak":true},{"text":"Porque Tú, oh Yavé, me ayudaste y me consolaste.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}