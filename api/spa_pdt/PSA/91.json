{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"El que mora al abrigo del ʼElyón","poem":1},{"lineBreak":true},{"text":"Morará bajo la sombra del Shadday.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Diré yo a Yavé:","poem":1},{"lineBreak":true},{"text":"¡Refugio mío y Fortaleza mía,","poem":1},{"lineBreak":true},{"text":"Mi ʼElohim, en Quien confío!","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Él te librará de la trampa del cazador,","poem":1},{"lineBreak":true},{"text":"Y de la mortal pestilencia.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Con sus plumas te cubrirá,","poem":1},{"lineBreak":true},{"text":"Y debajo de sus alas te refugiarás.","poem":1},{"lineBreak":true},{"text":"Escudo y adarga","poem":1},{"noteId":19},{"text":"es su verdad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"No temerás el terror nocturno,","poem":1},{"lineBreak":true},{"text":"Ni a flecha que vuele de día,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ni a pestilencia que ande en la oscuridad,","poem":1},{"lineBreak":true},{"text":"Ni a mortandad que a mediodía destruya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Caerán a tu lado 1.000,","poem":1},{"lineBreak":true},{"text":"Y 10.000 a tu mano derecha,","poem":1},{"lineBreak":true},{"text":"Pero a ti no llegará.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ciertamente mirarás con tus ojos,","poem":1},{"lineBreak":true},{"text":"Y verás la recompensa de los perversos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Por cuanto pusiste a Yavé, mi Refugio,","poem":1},{"lineBreak":true},{"text":"A ʼElyón como tu Lugar de morada,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"No te vendrá mal,","poem":1},{"lineBreak":true},{"text":"Ni alguna plaga tocará tu morada.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Pues a sus ángeles mandará con respecto a Ti,","poem":1},{"lineBreak":true},{"text":"Que te guarden en todos tus caminos.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"En sus manos te llevarán","poem":1},{"lineBreak":true},{"text":"Para que tu pie no tropiece en piedra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sobre el león y el áspid","poem":1},{"noteId":20},{"text":"pisarás.","poem":1},{"lineBreak":true},{"text":"Pisotearás al cachorro de león y al dragón.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Me amó,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Por tanto Yo lo libraré.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Lo pondré en alto,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Porque conoció mi Nombre.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Me invocará","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y Yo le responderé.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Estaré con él en la angustia.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Lo libraré y lo glorificaré.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Lo saciaré de larga vida y le mostraré mi salvación.","wordsOfJesus":true,"poem":1}]}],"footnotes":[{"noteId":19,"caller":"+","text":"Adarga: pequeño escuelo de cuero casi siempre ovalado.","reference":{"chapter":91,"verse":4}},{"noteId":20,"caller":"+","text":"Áspid: Culebra venenosa propia de Egipto que puede alcanzar dos metros de longitud.","reference":{"chapter":91,"verse":13}}]},"thisChapterLink":"/api/spa_pdt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}