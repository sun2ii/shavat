{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"heading","content":["Salmo. Canto para el sábado"]},{"type":"verse","number":1,"content":[{"text":"Bueno es alabar a Yavé","poem":1},{"lineBreak":true},{"text":"Y cantar salmos a tu Nombre, oh ʼElyón.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Anunciar por la mañana tu misericordia","poem":1},{"lineBreak":true},{"text":"Y tu fidelidad cada noche","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Con el decacordio y el salterio,","poem":1},{"noteId":21},{"lineBreak":true},{"text":"Con el armonioso tono del arpa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Porque Tú, oh Yavé, me alegraste con lo que hiciste.","poem":1},{"lineBreak":true},{"text":"Por las obras de tus manos doy gritos de júbilo.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Cuán grandes son tus obras, oh Yavé!","poem":1},{"lineBreak":true},{"text":"Tus pensamientos son muy profundos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"El hombre necio no sabe","poem":1},{"lineBreak":true},{"text":"Y el insensato no entiende esto:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Que cuando los perversos brotan como hierba,","poem":1},{"lineBreak":true},{"text":"Y florecen todos los que hacen iniquidad,","poem":1},{"lineBreak":true},{"text":"Solo sucede para que sean destruidos eternamente.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Pero Tú, oh Yavé, eres altísimo para siempre.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Porque ya veo que tus enemigos, oh Yavé,","poem":1},{"lineBreak":true},{"text":"Ya veo que tus enemigos perecen.","poem":1},{"lineBreak":true},{"text":"Son dispersados todos los obradores de iniquidad.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Pero Tú aumentarás mi fuerza como la del búfalo.","poem":1},{"lineBreak":true},{"text":"Seré ungido con aceite fresco.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Y mis ojos mirarán por encima de mis enemigos.","poem":1},{"lineBreak":true},{"text":"Mis oídos escucharán","poem":1},{"lineBreak":true},{"text":"Con respecto a los perversos que se levantan contra mí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"El justo florecerá como la palmera.","poem":1},{"lineBreak":true},{"text":"Crecerá como un cedro en el Líbano.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Plantados en la Casa de Yavé,","poem":1},{"lineBreak":true},{"text":"Florecerán en los patios de nuestro ʼElohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Aun en la vejez darán fruto.","poem":1},{"lineBreak":true},{"text":"Estarán llenos de savia y muy verdes","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Para manifestar que Yavé es recto.","poem":1},{"lineBreak":true},{"text":"Mi Roca es.","poem":1},{"lineBreak":true},{"text":"En Él no hay injusticia.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Decacordio: Instrumento músico de diez cuerdas. Salterio: Instrumento músico de 12 cuerdas hechas con intestino grueso de ovejas. Se pulsaba con los dedos.","reference":{"chapter":92,"verse":3}}]},"thisChapterLink":"/api/spa_pdt/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}