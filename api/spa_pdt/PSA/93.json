{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"Yavé reina.","poem":1},{"lineBreak":true},{"text":"Está cubierto de majestad.","poem":1},{"lineBreak":true},{"text":"Yavé se cubrió y se ató con poder.","poem":1},{"lineBreak":true},{"text":"El mundo está en verdad firmemente establecido","poem":1},{"lineBreak":true},{"text":"Y no será conmovido.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tu trono está establecido desde la antigüedad.","poem":1},{"lineBreak":true},{"text":"Tú eres desde la eternidad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Oh Yavé, los torrentes se levantan.","poem":1},{"lineBreak":true},{"text":"Las crecientes alzaron su voz.","poem":1},{"lineBreak":true},{"text":"Los ríos levantan sus olas estruendosas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yavé en las alturas es más poderoso","poem":1},{"lineBreak":true},{"text":"Que el estruendo de muchas aguas,","poem":1},{"lineBreak":true},{"text":"Que las poderosas olas del mar.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Tus Testimonios son completamente confirmados.","poem":1},{"lineBreak":true},{"text":"La santidad conviene a tu Casa,","poem":1},{"lineBreak":true},{"text":"Oh Yavé, para siempre.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}