{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"¡Vengan, cantemos con gozo a Yavé!","poem":1},{"lineBreak":true},{"text":"¡Aclamemos con júbilo a la Roca de nuestra salvación!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Entremos ante su Presencia con acción de gracias,","poem":1},{"lineBreak":true},{"text":"Aclamémoslo con salmos.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Porque Yavé es ʼEL grande,","poem":1},{"lineBreak":true},{"text":"Y gran Rey sobre todos los ʼelohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"En su mano están las profundidades de la tierra.","poem":1},{"lineBreak":true},{"text":"Suyas son las alturas de las montañas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Suyo es el mar, pues Él lo hizo,","poem":1},{"lineBreak":true},{"text":"Y sus manos formaron la tierra seca.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vengan, adoremos y postrémonos.","poem":1},{"lineBreak":true},{"text":"Arrodillémonos ante la Presencia de Yavé, nuestro Hacedor,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Porque Él es nuestro ʼElohim,","poem":1},{"lineBreak":true},{"text":"Nosotros el pueblo de su prado y ovejas de su mano.","poem":1},{"lineBreak":true},{"text":"Si ustedes oyen hoy su voz,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"No endurezcan sus corazones como en Meriba,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Como en el día de Masa en el desierto,","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Cuando me tentaron sus antepasados.","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Me probaron, aunque vieron mi obra.","wordsOfJesus":true,"poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Durante 40 años estuve disgustado con aquella generación,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y dije: Es un pueblo que divaga en su corazón,","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Y no conoce mis caminos.","wordsOfJesus":true,"poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Por tanto, juré en mi ira","wordsOfJesus":true,"poem":1},{"lineBreak":true},{"text":"Que no entrarán en mi reposo.","wordsOfJesus":true,"poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}