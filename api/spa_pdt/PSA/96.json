{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"¡Canten a Yavé un canto nuevo!","poem":1},{"lineBreak":true},{"text":"¡Cante a Yavé toda la tierra!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"¡Canten a Yavé, bendigan su Nombre!","poem":1},{"lineBreak":true},{"text":"Anuncien de día en día su salvación.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Proclamen su gloria entre las naciones,","poem":1},{"lineBreak":true},{"text":"Entre todos los pueblos, sus maravillosas obras.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Porque grande es Yavé","poem":1},{"lineBreak":true},{"text":"Y digno de suprema alabanza.","poem":1},{"lineBreak":true},{"text":"Él debe ser temido por encima de todos los ʼelohim.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Porque todos los ʼelohim de los pueblos son ídolos.","poem":1},{"lineBreak":true},{"text":"Pero Yavé hizo los cielos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Esplendor y majestad hay ante Él.","poem":1},{"lineBreak":true},{"text":"Fortaleza y hermosura hay en su Santuario.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tributen a Yavé, oh familias de los pueblos.","poem":1},{"lineBreak":true},{"text":"Tributen a Yavé gloria y fortaleza.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tributen a Yavé la gloria debida a su Nombre.","poem":1},{"lineBreak":true},{"text":"Lleven ofrenda y entren en sus patios.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Adoren a Yavé en la hermosura de la santidad.","poem":1},{"lineBreak":true},{"text":"Tiemble ante Él toda la tierra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Digan entre las naciones: ¡Yavé reina!","poem":1},{"lineBreak":true},{"text":"Ciertamente el mundo está firmemente establecido.","poem":1},{"lineBreak":true},{"text":"No será conmovido.","poem":1},{"lineBreak":true},{"text":"Él juzgará a los pueblos con equidad.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"¡Alégrense los cielos","poem":1},{"lineBreak":true},{"text":"Y regocíjese la tierra!","poem":1},{"lineBreak":true},{"text":"Brame el mar y todo lo que contiene.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Exáltese el campo y todo lo que hay en él.","poem":1},{"lineBreak":true},{"text":"Entonces todos los árboles del bosque cantarán con gozo","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Delante de Yavé Quien viene,","poem":1},{"lineBreak":true},{"text":"Porque viene a juzgar la tierra.","poem":1},{"lineBreak":true},{"text":"Él juzgará al mundo con justicia","poem":1},{"lineBreak":true},{"text":"Y a los pueblos con su fidelidad.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}