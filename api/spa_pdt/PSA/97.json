{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"¡Yavé reina!","poem":1},{"lineBreak":true},{"text":"¡Regocíjese la tierra!","poem":1},{"lineBreak":true},{"text":"¡Alégrese la multitud de islas!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nubes y densa oscuridad lo rodean.","poem":1},{"lineBreak":true},{"text":"Justicia y equidad son el fundamento de su trono.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fuego avanza delante de Él","poem":1},{"lineBreak":true},{"text":"Que quema alrededor a sus adversarios.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Sus relámpagos iluminan el orbe.","poem":1},{"lineBreak":true},{"text":"La tierra mira y se estremece.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ante la presencia de Yavé","poem":1},{"lineBreak":true},{"text":"Las montañas se derriten como cera,","poem":1},{"lineBreak":true},{"text":"Ante la presencia del ʼAdonay de toda la tierra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Los cielos declaran su justicia,","poem":1},{"lineBreak":true},{"text":"Y todos los pueblos ven su gloria.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sean avergonzados","poem":1},{"lineBreak":true},{"text":"Todos los que sirven a imágenes talladas,","poem":1},{"lineBreak":true},{"text":"Quienes se jactan de ídolos.","poem":1},{"lineBreak":true},{"text":"Póstrense ante Él todos los ʼelohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oyó Sion y se alegró,","poem":1},{"lineBreak":true},{"text":"Y las hijas de Judá se regocijaron","poem":1},{"lineBreak":true},{"text":"A causa de tus juicios, oh Yavé.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Porque Tú, oh Yavé, eres ʼElyón sobre toda la tierra.","poem":1},{"lineBreak":true},{"text":"Tú eres exaltado por encima de todos los ʼelohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Aborrezcan el mal ustedes los que aman a Yavé,","poem":1},{"lineBreak":true},{"text":"Quien preserva las almas de sus santos.","poem":1},{"lineBreak":true},{"text":"ʼEL los libra de la mano de los perversos.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Luz hay sembrada para el justo,","poem":1},{"lineBreak":true},{"text":"Y alegría para los rectos de corazón.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Alégrense ustedes, los justos, en Yavé,","poem":1},{"lineBreak":true},{"text":"Y den gracias a la memoria de su santo Nombre.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}