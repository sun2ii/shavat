{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_pdt","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"e89c34099bdeb8acc733673f09dd4e0b316e276caa02119311f4a69894c30343","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_pdt/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["Salmo"]},{"type":"verse","number":1,"content":[{"text":"Canten a Yavé un canto nuevo,","poem":1},{"lineBreak":true},{"text":"Porque Él hizo maravillosas cosas.","poem":1},{"lineBreak":true},{"text":"Su mano derecha y su santo brazo ganaron la victoria para Él.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Yavé hizo notoria su salvación.","poem":1},{"lineBreak":true},{"text":"Ha manifestado su justicia a la vista de las naciones.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ha recordado su misericordia y su fidelidad a la casa de Israel.","poem":1},{"lineBreak":true},{"text":"Todos los confines de la tierra vieron la salvación de nuestro ʼElohim.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"¡Aclamen a Yavé toda la tierra!","poem":1},{"lineBreak":true},{"text":"¡Prorrumpan y canten de gozo y canten salmos!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Canten salmos a Yavé con arpa","poem":1},{"lineBreak":true},{"text":"Y con voz de canto,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Con trompetas y al sonido de la corneta.","poem":1},{"lineBreak":true},{"text":"¡Aclamen con gozo ante el Rey Yavé!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Brame el mar y los que moran en él,","poem":1},{"lineBreak":true},{"text":"El mundo, y los que en él habitan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Batan sus manos los ríos.","poem":1},{"lineBreak":true},{"text":"Que las montañas en conjunto se regocijen","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Delante de Yavé,","poem":1},{"lineBreak":true},{"text":"Porque Él viene a juzgar la tierra.","poem":1},{"lineBreak":true},{"text":"Juzgará al mundo con justicia,","poem":1},{"lineBreak":true},{"text":"Y a los pueblos con equidad.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}