{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"SNG","translationId":"spa_pdt","name":"Cantares","commonName":"Cantares","title":"Cantar de los Cantares","order":22,"numberOfChapters":8,"sha256":"57a5260926e906ae7bd79ac8e96a49638e0703d06afee716b1965e5113bfbabd","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/spa_pdt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Cantar de los cantares,","poem":1},{"lineBreak":true},{"text":"El cual es de Salomón.","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":2,"content":[{"text":"¡Oh, si él me besara con ósculos de su boca!","poem":1},{"lineBreak":true},{"text":"Mejor que el vino es tu amor.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"El olor de tus ungüentos es fragancia.","poem":1},{"lineBreak":true},{"text":"Tu nombre es como ungüento derramado.","poem":1},{"lineBreak":true},{"text":"Por eso las doncellas te aman.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"¡Atráeme, y correremos detrás de ti!","poem":1},{"lineBreak":true},{"text":"El rey me introdujo en sus habitaciones:","poem":1},{"lineBreak":true},{"text":"Nos regocijaremos y nos alegraremos en ti,","poem":1},{"lineBreak":true},{"text":"Y exaltaremos tu amor más que el vino.","poem":1},{"lineBreak":true},{"text":"¡Con justa razón te aman!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hijas de Jerusalén, soy morena,","poem":1},{"lineBreak":true},{"text":"Pero codiciable como las tiendas de Cedar,","poem":1},{"lineBreak":true},{"text":"Como las cortinas de Salomón.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"No consideren que soy morena","poem":1},{"lineBreak":true},{"text":"Porque el sol me quemó.","poem":1},{"lineBreak":true},{"text":"Los hijos de mi madre se airaron contra mí.","poem":1},{"lineBreak":true},{"text":"Me dedicaron a cuidar las viñas,","poem":1},{"lineBreak":true},{"text":"Y mi propia viña no cuidé.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Hazme saber tú, amado de mi alma, dónde pastoreas,","poem":1},{"lineBreak":true},{"text":"Dónde haces recostar el rebaño al mediodía.","poem":1},{"lineBreak":true},{"text":"Pues, ¿por qué seré como la que se desvela","poem":1},{"lineBreak":true},{"text":"Junto a los rebaños de tus compañeros?","poem":1}]},{"type":"heading","content":["Coro"]},{"type":"verse","number":8,"content":[{"text":"¡Si no lo sabes tú,","poem":1},{"lineBreak":true},{"text":"La más hermosa de las mujeres,","poem":1},{"lineBreak":true},{"text":"Sal tras las huellas del rebaño,","poem":1},{"lineBreak":true},{"text":"Y apacienta tus cabritas junto a las cabañas de los pastores!","poem":1}]},{"type":"heading","content":["Él"]},{"type":"verse","number":9,"content":[{"text":"A mi yegua favorita entre las carrozas de Faraón","poem":1},{"lineBreak":true},{"text":"Te comparé, oh amada mía.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hermosas son tus mejillas entre los zarcillos,","poem":1},{"lineBreak":true},{"text":"Tu cuello, con sus collares.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Te haremos aretes de oro con incrustaciones de plata.","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":12,"content":[{"text":"Mientras el rey está en su reclinatorio,","poem":1},{"lineBreak":true},{"text":"Mi nardo da su fragancia.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mi amado es para mí un manojito de mirra","poem":1},{"lineBreak":true},{"text":"Que reposa entre mis pechos.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ramillete de flores de alheña","poem":1},{"lineBreak":true},{"text":"Es mi amado para mí en las viñas de En-gadi.","poem":1}]},{"type":"heading","content":["Él"]},{"type":"verse","number":15,"content":[{"text":"Mira, eres hermosa, oh amada mía.","poem":1},{"lineBreak":true},{"text":"¡Cuán bella eres!","poem":1},{"lineBreak":true},{"text":"Tus ojos son como palomas.","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":16,"content":[{"text":"Mira, eres hermoso, oh amado mío.","poem":1},{"lineBreak":true},{"text":"También placentero.","poem":1},{"lineBreak":true},{"text":"Nuestra cama es de florido verdor.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Las vigas de nuestra casa son de cedro,","poem":1},{"lineBreak":true},{"text":"Y de ciprés nuestro techo raso.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}