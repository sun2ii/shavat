{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"SNG","translationId":"spa_pdt","name":"Cantares","commonName":"Cantares","title":"Cantar de los Cantares","order":22,"numberOfChapters":8,"sha256":"57a5260926e906ae7bd79ac8e96a49638e0703d06afee716b1965e5113bfbabd","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/spa_pdt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Soy la rosa de Sarón","poem":1},{"lineBreak":true},{"text":"Y el lirio de los valles.","poem":1}]},{"type":"heading","content":["Él"]},{"type":"verse","number":2,"content":[{"text":"Como el lirio entre los espinos,","poem":1},{"lineBreak":true},{"text":"Así es mi amada entre las doncellas.","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":3,"content":[{"text":"Como el manzano entre los árboles del bosque,","poem":1},{"lineBreak":true},{"text":"Así es mi amado entre los jóvenes.","poem":1},{"lineBreak":true},{"text":"A su sombra deseo sentarme y comer sus dulces frutos.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Él me lleva a la sala del banquete,","poem":1},{"lineBreak":true},{"text":"Y su estandarte sobre mí es amor.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¡Susténtenme con pasas,","poem":1},{"lineBreak":true},{"text":"Confórtenme con manzanas,","poem":1},{"lineBreak":true},{"text":"Porque estoy enferma de amor!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Su izquierda esté bajo mi cabeza,","poem":1},{"lineBreak":true},{"text":"Y su derecha me abrace!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Oh hijas de Jerusalén,","poem":1},{"lineBreak":true},{"text":"Las conjuro por las gacelas y por los venados del campo,","poem":1},{"lineBreak":true},{"text":"Que no despierten ni hagan velar al amor hasta que quiera!","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"¡La voz de mi amado!","poem":1},{"lineBreak":true},{"text":"¡Allí salta sobre las montañas,","poem":1},{"lineBreak":true},{"text":"Brinca sobre las colinas!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mi amado es como un venado o un cervatillo.","poem":1},{"lineBreak":true},{"text":"¡Miren! Está tras nuestro muro y mira por las ventanas.","poem":1},{"lineBreak":true},{"text":"Observa por las celosías.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mi amado habló:","poem":1},"Él",{"text":"¡Oh amada mía, hermosa mía, levántate y sal conmigo!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Porque pasó el invierno.","poem":1},{"lineBreak":true},{"text":"La lluvia cesó y se fue.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Las flores aparecen en la tierra,","poem":1},{"lineBreak":true},{"text":"El tiempo de la poda llegó","poem":1},{"lineBreak":true},{"text":"Y la voz de la tórtola se oye en nuestra tierra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"La higuera ya madura sus brevas,","poem":1},{"lineBreak":true},{"text":"Y las vides en flor exhalan su aroma.","poem":1},{"lineBreak":true},{"text":"¡Levántate, oh amada mía,","poem":1},{"lineBreak":true},{"text":"Hermosa mía, y ven!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"¡Oh paloma mía!","poem":1},{"lineBreak":true},{"text":"Tú, que anidas en las grietas de la peña,","poem":1},{"lineBreak":true},{"text":"En los escarpados parajes:","poem":1},{"lineBreak":true},{"text":"¡Muéstrate! ¡Hazme oír tu voz!","poem":1},{"lineBreak":true},{"text":"Porque dulce es tu voz y hermoso tu rostro.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Cácennos las zorras,","poem":1},{"lineBreak":true},{"text":"Las zorras pequeñas que echan a perder las viñas,","poem":1},{"lineBreak":true},{"text":"¡Nuestras viñas en flor!","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":16,"content":[{"text":"¡Mi amado es mío y yo suya!","poem":1},{"lineBreak":true},{"text":"Él pastorea entre los lirios","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Hasta que refresque el día y huyan las sombras.","poem":1},{"lineBreak":true},{"text":"¡Vuelve, oh amado mío!","poem":1},{"lineBreak":true},{"text":"Sé como el venado o el cervatillo sobre las montañas de Béter.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}