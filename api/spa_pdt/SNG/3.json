ue},{"text":"Me agarré de él y no lo dejé,","poem":1},{"lineBreak":true},{"text":"Hasta que lo introduje en la casa de mi madre,","poem":1},{"lineBreak":true},{"text":"En la habitación de la que me concibió.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Las conjuro, oh hijas de Jerusalén,","poem":1},{"lineBreak":true},{"text":"Por las gacelas y por los venados del campo,","poem":1},{"lineBreak":true},{"text":"Que no despierten al amor","poem":1},{"lineBreak":true},{"text":"Ni lo hagan velar hasta que quiera.","poem":1}]},{"type":"heading","content":["Coro"]},{"type":"verse","number":6,"content":[{"text":"¿Qué es esto que sube del desierto como columnas de humo,","poem":1},{"lineBreak":true},{"text":"Perfumado con mirra e incienso","poem":1},{"lineBreak":true},{"text":"Y con todos los aromas del mercader?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mira, la litera de Salomón,","poem":1},{"lineBreak":true},{"text":"Escoltada por 60 valientes de entre los héroes de Israel.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Todos ellos empuñan espada.","poem":1},{"lineBreak":true},{"text":"Son expertos en la batalla.","poem":1},{"lineBreak":true},{"text":"Cada uno tiene su espada en su cintura","poem":1},{"lineBreak":true},{"text":"Por los peligros de la noche.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"El rey Salomón hizo para él una litera con madera del Líbano.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hizo sus columnas de plata,","poem":1},{"lineBreak":true},{"text":"Su respaldo de oro,","poem":1},{"lineBreak":true},{"text":"Su asiento de púrpura,","poem":1},{"lineBreak":true},{"text":"Su interior tapizado con amor por las hijas de Jerusalén.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"¡Salgan, oh hijas de Sion,","poem":1},{"lineBreak":true},{"text":"Y contemplen al rey Salomón,","poem":1},{"lineBreak":true},{"text":"Con la diadema que le colocó su madre el día de su boda,","poem":1},{"lineBreak":true},{"text":"El día del gozo de su corazón!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}