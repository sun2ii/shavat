{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"SNG","translationId":"spa_pdt","name":"Cantares","commonName":"Cantares","title":"Cantar de los Cantares","order":22,"numberOfChapters":8,"sha256":"57a5260926e906ae7bd79ac8e96a49638e0703d06afee716b1965e5113bfbabd","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/spa_pdt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"heading","content":["Él"]},{"type":"verse","number":1,"content":[{"text":"¡Vine a mi huerto, oh hermana mía y esposa mía.","poem":1},{"lineBreak":true},{"text":"Recogí mi mirra con mi bálsamo,","poem":1},{"lineBreak":true},{"text":"Comí mi panal con mi miel,","poem":1},{"lineBreak":true},{"text":"Bebí mi vino con mi leche!","poem":1},{"lineBreak":true},{"text":"¡Coman, amigos!","poem":1},{"lineBreak":true},{"text":"¡Beban y embriáguense, oh amados!","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":2,"content":[{"text":"Yo dormía,","poem":1},{"lineBreak":true},{"text":"Pero mi corazón velaba:","poem":1},{"lineBreak":true},{"text":"¡Una voz!","poem":1},{"lineBreak":true},{"text":"¡Mi amado llama!","poem":1},"Él",{"text":"¡Ábreme, hermana mía, amada mía,","poem":1},{"lineBreak":true},{"text":"Paloma mía, perfecta mía!","poem":1},{"lineBreak":true},{"text":"Porque mi cabeza está empapada de rocío,","poem":1},{"lineBreak":true},{"text":"Y mis cabellos con las gotas de la noche.","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":3,"content":[{"text":"Me quité el vestido.","poem":1},{"lineBreak":true},{"text":"¿Cómo me volveré a vestir?","poem":1},{"lineBreak":true},{"text":"Me lavé los pies,","poem":1},{"lineBreak":true},{"text":"¿Los volveré a ensuciar?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mi amado metió su mano por la ventanilla,","poem":1},{"lineBreak":true},{"text":"Y mis entrañas se conmovieron por él.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Me levanté para abrir a mi amado,","poem":1},{"lineBreak":true},{"text":"Mis manos destilaron mirra,","poem":1},{"lineBreak":true},{"text":"De mis dedos se escurrió la mirra por la manecilla del cerrojo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Abrí a mi amado,","poem":1},{"lineBreak":true},{"text":"Pero mi amado ya se había ido.","poem":1},{"lineBreak":true},{"text":"Había pasado,","poem":1},{"lineBreak":true},{"text":"Y mi alma salió tras su hablar.","poem":1},{"lineBreak":true},{"text":"Lo busqué,","poem":1},{"lineBreak":true},{"text":"Pero no lo hallé.","poem":1},{"lineBreak":true},{"text":"Lo llamé,","poem":1},{"lineBreak":true},{"text":"Pero no me respondió.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Me hallaron los guardas que rondan la ciudad.","poem":1},{"lineBreak":true},{"text":"Me golpearon y me hirieron.","poem":1},{"lineBreak":true},{"text":"Los guardas de las murallas","poem":1},{"lineBreak":true},{"text":"Me despojaron de mi manto.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Las conjuro, oh hijas de Jerusalén,","poem":1},{"lineBreak":true},{"text":"Que si hallan a mi amado,","poem":1},{"lineBreak":true},{"text":"¡Le digan que estoy enferma de amor!","poem":1}]},{"type":"heading","content":["Coro"]},{"type":"verse","number":9,"content":[{"text":"¿Qué es tu amado más que otro amado,","poem":1},{"lineBreak":true},{"text":"Oh tú, la más hermosa entre las mujeres?","poem":1},{"lineBreak":true},{"text":"¿Qué es tu amado más que otro amado,","poem":1},{"lineBreak":true},{"text":"Que así nos conjuras?","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":10,"content":[{"text":"Mi amado es radiante y lozano,","poem":1},{"lineBreak":true},{"text":"Distinguido entre 10.000.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Su cabeza es como el oro más fino,","poem":1},{"lineBreak":true},{"text":"Sus cabellos, ondulados,","poem":1},{"lineBreak":true},{"text":"Negros como el cuervo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sus ojos son como palomas junto a corrientes de agua,","poem":1},{"lineBreak":true},{"text":"Bañados con leche,","poem":1},{"lineBreak":true},{"text":"Que descansan en la orilla.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sus mejillas, como un jardín de especias,","poem":1},{"lineBreak":true},{"text":"Que exhalan su fragancia,","poem":1},{"lineBreak":true},{"text":"Sus labios son como lirios,","poem":1},{"lineBreak":true},{"text":"Que destilan abundante mirra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sus brazos como barras de oro engastados con piedras de Tarsis,","poem":1},{"lineBreak":true},{"text":"Su torso, tallado de marfil,","poem":1},{"lineBreak":true},{"text":"Recubierto de zafiros.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Sus piernas son columnas de alabastro,","poem":1},{"lineBreak":true},{"text":"Asentadas sobre basas de oro puro.","poem":1},{"lineBreak":true},{"text":"Su aspecto, como el del Líbano,","poem":1},{"lineBreak":true},{"text":"Majestuoso como los cedros.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Su paladar es dulcísimo,","poem":1},{"lineBreak":true},{"text":"Y todo él, la dulzura misma.","poem":1},{"lineBreak":true},{"text":"¡Es mi amado y es mi amigo, oh hijas de Jerusalén!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}