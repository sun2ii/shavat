{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"SNG","translationId":"spa_pdt","name":"Cantares","commonName":"Cantares","title":"Cantar de los Cantares","order":22,"numberOfChapters":8,"sha256":"57a5260926e906ae7bd79ac8e96a49638e0703d06afee716b1965e5113bfbabd","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/spa_pdt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"heading","content":["Coro"]},{"type":"verse","number":1,"content":[{"text":"¿Adónde se fue tu amado,","poem":1},{"lineBreak":true},{"text":"Oh tú, la más hermosa entre las mujeres?","poem":1},{"lineBreak":true},{"text":"¿Adónde fue tu amado,","poem":1},{"lineBreak":true},{"text":"Para que lo busquemos contigo?","poem":1}]},{"type":"heading","content":["Ella"]},{"type":"verse","number":2,"content":[{"text":"Mi amado bajó a su huerto,","poem":1},{"lineBreak":true},{"text":"A las eras de las especias para apacentar entre los huertos y recoger los lirios.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yo soy de mi amado y mi amado es mío.","poem":1},{"lineBreak":true},{"text":"Él apacienta entre lirios.","poem":1}]},{"type":"heading","content":["Él"]},{"type":"verse","number":4,"content":[{"text":"Oh amada mía, eres hermosa como Tirsa,","poem":1},{"lineBreak":true},{"text":"Deseable como Jerusalén,","poem":1},{"lineBreak":true},{"text":"Imponente como un ejército con estandartes.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Aparta tus ojos de mí,","poem":1},{"lineBreak":true},{"text":"Porque me conturban.","poem":1},{"lineBreak":true},{"text":"Tu cabellera es como un rebaño de cabras recostadas en las laderas de Galaad.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tus dientes, como un rebaño de ovejas que suben del lavadero,","poem":1},{"lineBreak":true},{"text":"Todas con crías gemelas,","poem":1},{"lineBreak":true},{"text":"Y ninguna entre ellas estéril.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tus mejillas, detrás de tu velo, dos mitades de granada.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Si 60 son las reinas, 80 las concubinas,","poem":1},{"lineBreak":true},{"text":"Y sinnúmero las doncellas,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Una sola es mi paloma, la perfecta mía,","poem":1},{"lineBreak":true},{"text":"Una sola, predilecta de su madre.","poem":1},{"lineBreak":true},{"text":"Las doncellas la vieron y la consideran inmensamente feliz.","poem":1},{"lineBreak":true},{"text":"La alabaron las reinas y las concubinas.","poem":1}]},{"type":"heading","content":["Coro"]},{"type":"verse","number":10,"content":[{"text":"¿Quién es la que se asoma como el alba,","poem":1},{"lineBreak":true},{"text":"Hermosa como la luna,","poem":1},{"lineBreak":true},{"text":"Límpida como el sol,","poem":1},{"lineBreak":true},{"text":"Imponente como un escuadrón abanderado?","poem":1}]},{"type":"heading","content":["Él"]},{"type":"verse","number":11,"content":[{"text":"Al huerto de los nogales descendí","poem":1},{"lineBreak":true},{"text":"A ver los frutos del valle,","poem":1},{"lineBreak":true},{"text":"A ver si brotaba la vid,","poem":1},{"lineBreak":true},{"text":"Si florecían los granados.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Antes que lo supiera,","poem":1},{"lineBreak":true},{"text":"Mi alma me puso entre las carrozas de Abinadab.","poem":1}]},{"type":"heading","content":["Coro"]},{"type":"verse","number":13,"content":[{"text":"¡Vuelve, vuelve, oh sulamita!","poem":1},{"lineBreak":true},{"text":"¡Vuelve, vuelve y te contemplaremos!","poem":1},{"lineBreak":true},{"text":"¿Qué quieren ver en la sulamita?","poem":1},"Él",{"text":"Algo como las danzas de Majanaim,","poem":1},{"lineBreak":true},{"text":"¡Cuán graciosos son tus pasos en sandalias, oh hija del príncipe!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}