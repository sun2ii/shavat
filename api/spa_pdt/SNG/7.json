{"translation":{"id":"spa_pdt","name":"Palabra de Dios para ti","website":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spapddpt","licenseNotes":null,"shortName":"PDT","englishName":"Spanish Bible (God's Word for You)","language":"spa","textDirection":"ltr","sha256":"69c3006e1052e0f358a06ee946899e91ff451bf42ba5a5d2df83331b7bf5672e","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_pdt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"SNG","translationId":"spa_pdt","name":"Cantares","commonName":"Cantares","title":"Cantar de los Cantares","order":22,"numberOfChapters":8,"sha256":"57a5260926e906ae7bd79ac8e96a49638e0703d06afee716b1965e5113bfbabd","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_pdt/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/spa_pdt/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Los contornos de tus muslos son como joyas,","poem":1},{"lineBreak":true},{"text":"Obra de manos de un hábil orfebre.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tu ombligo es como un ánfora,","poem":1},{"lineBreak":true},{"text":"Donde no falta ningún vino generoso.","poem":1},{"lineBreak":true},{"text":"Tu vientre, una gavilla de trigo cercada de lirios.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tus dos pechos, como crías mellizas de gacela.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tu cuello, una torre de marfil,","poem":1},{"lineBreak":true},{"text":"Tus ojos, claros como los estanques de Hesbón,","poem":1},{"lineBreak":true},{"text":"Junto al portal de Bat-rabim.","poem":1},{"lineBreak":true},{"text":"Tu perfil es como la torre del Líbano,","poem":1},{"lineBreak":true},{"text":"Que mira hacia Damasco.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tu cabeza se yergue como la montaña Carmelo,","poem":1},{"lineBreak":true},{"text":"Y tu cabellera es como la púrpura.","poem":1},{"lineBreak":true},{"text":"¡El rey está cautivo en tus trenzas!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Cuán hermosa y dulce eres, oh amor deleitoso!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tu talle se asemeja a la palmera,","poem":1},{"lineBreak":true},{"text":"Y tus pechos, a sus racimos.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dije: Subiré a la palmera.","poem":1},{"lineBreak":true},{"text":"Tomaré sus frutos.","poem":1},{"lineBreak":true},{"text":"Sean tus pechos como racimos de la vid,","poem":1},{"lineBreak":true},{"text":"Y la fragancia de tu aliento como de manzanas,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Y el cielo de tu boca como el vino generoso.","poem":1},"Ella",{"text":"Que de mi amado fluye suavemente,","poem":1},{"lineBreak":true},{"text":"Y hace mover apaciblemente los labios de los que duermen.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yo soy de mi amado,","poem":1},{"lineBreak":true},{"text":"Y su deseo es para mí.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ven, amado mío,","poem":1},{"lineBreak":true},{"text":"Salgamos al campo,","poem":1},{"lineBreak":true},{"text":"Pernoctemos en las aldeas.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Madruguemos y vayamos a las viñas,","poem":1},{"lineBreak":true},{"text":"Veamos si brotó la vid,","poem":1},{"lineBreak":true},{"text":"Si ya se abrieron sus flores,","poem":1},{"lineBreak":true},{"text":"Si florecen los granados.","poem":1},{"lineBreak":true},{"text":"Allí te daré mis caricias.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Las mandrágoras exhalan su fragancia,","poem":1},{"lineBreak":true},{"text":"Y a nuestra puerta hay toda clase de frutos deliciosos,","poem":1},{"lineBreak":true},{"text":"Nuevos y añejos, que guardé para ti, oh amado mío.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_pdt/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_pdt/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_pdt/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}