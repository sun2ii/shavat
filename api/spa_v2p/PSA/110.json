l cami­no: por lo cual levantará cabeza."]}],"footnotes":[]},"thisChapterLink":"/api/spa_v2p/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_v2p/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_v2p/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}