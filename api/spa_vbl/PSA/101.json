{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Un salmo de David."]},{"type":"verse","number":1,"content":[{"text":"Cantaré de tu inmenso amor y de tu buen juicio. Cantaré alabanzas a ti, Señor.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Me aseguraré de que mi vida sea irreprochable. ¿Cuándo vendrás a ayudarme? Mi vida será íntegra, incluso en privado.","poem":1},{"noteId":337}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"No me fijaré en nada malo. Porque odio hacer el mal, y no quiero tener nada que ver con él.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"No tendré malos pensamientos, ni consideraré acción perversa, por más mínima que sea.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Haré callar a cualquiera que levante calumnias contra su prójimo. No toleraré a nadie que sea orgulloso o arrogante.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yo busco a gente leal que viva conmigo; solo aquellos que son dignos de confianza me servirán.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nadie deshonesto vivirá en mi casa; ningún mentiroso será permitido en mi presencia.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Trabajo cada día para silenciar a los malvados de la tierra, para librar a la ciudad del Señor de todos los que hacen mal.","poem":1}]}],"footnotes":[{"noteId":337,"caller":"+","text":"101.2 “Incluso en privado”: Literalmente, “en mi casa”.","reference":{"chapter":101,"verse":2}}]},"thisChapterLink":"/api/spa_vbl/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}