{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"¡Alaben al Señor! ¡Alábenlo, siervos del Señor! ¡Alábenlo tal como él es!","poem":1},{"noteId":385}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Que la naturaleza del Señor sea alabada, ahora y para siempre.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"¡Que todo el mundo en todas partes, desde el Este hasta el Oeste,","poem":1},{"noteId":386},{"text":"alabe al Señor!","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"El Señor gobierna con supremacía sobre todas las naciones; su gloria llega más alto que los cielos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Quién es como el Señor nuestro Dios? Él es el único que vive en las alturas, sentado en su trono.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tiene que agacharse para mirar desde los cielos hasta la tierra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Levanta al pobre del polvo; ayuda al necesitado a salir del tiradero de basura.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A los líderes de su pueblo les da puestos de honor","poem":1},{"noteId":387},{"text":"junto a otros líderes importantes.","poem":1},{"noteId":388}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alegra el hogar de la mujer estériles dándoles hijos. ¡Alaben al Señor!","poem":1}]}],"footnotes":[{"noteId":385,"caller":"+","text":"113.1 “Tal como él es!” Literalmente, “nombre”, pero en hebreo esta palabra significa más que solo una apelación. “Nombre” denota naturaleza y carácter. Lo mismo ocurre en los versículos 2 y 3.","reference":{"chapter":113,"verse":1}},{"noteId":386,"caller":"+","text":"113.3 O, “desde el amanecer hasta el ocaso”.","reference":{"chapter":113,"verse":3}},{"noteId":387,"caller":"+","text":"113.8 “Les da puestos de honor”: Literalmente, “los hace sentarse”.","reference":{"chapter":113,"verse":8}},{"noteId":388,"caller":"+","text":"113.8 “Líderes importantes”: Literalmente, “príncipes”.","reference":{"chapter":113,"verse":8}}]},"thisChapterLink":"/api/spa_vbl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}