{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"A través del éxodo de Israel desde Egipto, cuando los descendientes de Jacob salieron de aquella nación extranjera,","poem":1},{"noteId":389}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"la tierra de Judá se convirtió en el santuario del Señor, Israel su reino.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"El mar rojo los vio y huyó; el río Jordán también se retiró.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Las montañas brincaron","poem":1},{"noteId":390},{"text":"como carneros, los cerros saltaron","poem":1},{"noteId":391},{"text":"como ovejas.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Oh, Mar Rojo, ¿Por qué huiste? Río Jordán, ¿Por qué volviste a atrás?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Montañas, ¿Por qué saltaron alarmadas? Montes, ¿Por qué se asustaron como ovejas?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tierra, tiembla ante la presencia del Señor, ¡Tiembla ante la presencia del Dios de Jacob!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Él es el único que puede convertir una roca en manantial de aguas; y hacer brotar el agua de piedras solidas.","poem":1},{"noteId":392}]}],"footnotes":[{"noteId":389,"caller":"+","text":"114.1 “Nación extranjera”: Literalmente, “pueblo de un idioma extranjero”.","reference":{"chapter":114,"verse":1}},{"noteId":390,"caller":"+","text":"114.4 Literalmente “brincaron”, pero esto sugiere una acción lúdica cuando el contexto deja en claro que el salto se debe al miedo y no a la alegría.","reference":{"chapter":114,"verse":4}},{"noteId":391,"caller":"+","text":"114.4 “Saltaron”: implícito. La imagen es de montañas y colinas temblando como en un terremoto.","reference":{"chapter":114,"verse":4}},{"noteId":392,"caller":"+","text":"114.8 Ver Éxodo 17:1-7; Números 20:1-13.","reference":{"chapter":114,"verse":8}}]},"thisChapterLink":"/api/spa_vbl/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}