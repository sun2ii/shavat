{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["Un cántico para los peregrinos que van a Jerusalén."]},{"type":"verse","number":1,"content":[{"text":"Muchos enemigos me han atacado desde que era joven. Que todo Israel diga:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muchos enemigos me han atacado desde que era joven, pero nunca me vencieron.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Me golpearon en la espalda, dejando largos surcos como si hubiera sido golpeado por un granjero.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero el Señor hace lo correcto: me liberado de las ataduras de los impíos.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Que todos los que odian Sión sean derrotados y humillados.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Que sean como la grama que crece en los techos y se marchita antes de que pueda ser cosechada,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"y que no es suficiente para que un segador la sostenga, ni suficiente para que el cosechador llene sus brazos.","poem":1},{"noteId":428}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Que al pasar nadie les diga, “La bendición del Señor esté sobre ti, te bendecimos en el nombre del Señor”.","poem":1}]}],"footnotes":[{"noteId":428,"caller":"+","text":"129.7 La imagen de algo inútil.","reference":{"chapter":129,"verse":7}}]},"thisChapterLink":"/api/spa_vbl/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}