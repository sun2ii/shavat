"poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Cantaré al Señor, por cuanto Él me ha tratado con tanta generosidad!","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"13.3 Literalmente: “da luz a mis ojos”. Los ojos brillantes se consideraban un signo de buena salud.","reference":{"chapter":13,"verse":3}}]},"thisChapterLink":"/api/spa_vbl/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}