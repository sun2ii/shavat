{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["Un cántico para los peregrinos que van a Jerusalén."]},{"type":"verse","number":1,"content":[{"text":"Señor, clamo a ti desde lo más profundo de mi dolor.","poem":1},{"noteId":429}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Por favor escucha mi llanto, presta atención a lo que pido.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Señor, si guardaras una lista de nuestros pecados, ¿Quién podría escapar de ser condenado?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero tú eres un Dios perdonador y por eso debes ser respetado.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yo espero en el Señor, espero ansiosamente, porque confío en su palabra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Anhelo que el Señor vuelva, más que los vigilantes añorando el amanecer.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Israel, deposita tus esperanzas en el Señor, porque el Señor nos ama con su inmenso amor, y su salvación no conoce límites.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Él redimirá a Israel de todos sus pecados.","poem":1}]}],"footnotes":[{"noteId":429,"caller":"+","text":"130.1 “De mi dolor”: implícito.","reference":{"chapter":130,"verse":1}}]},"thisChapterLink":"/api/spa_vbl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}