{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"¡Alaben al Señor! ¡Canten una canción nueva al Señor! ¡Alábenlo en medio de la reunión de sus seguidores fieles!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Que Israel celebre a su Creador. Que el pueblo de Sión se alegre en su Rey.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alaben su naturaleza con danza; canten alabanzas a él con acompañamiento de panderetas y harpas.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Porque el Señor se alegra con su pueblo, y honra a los oprimidos con su salvación.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Que los fieles celebren la honra del Señor, que canten incluso desde sus camas.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Que sus alabanzas siempre estén en sus labios, que tengan una espada de doble filo en sus manos,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"listos para vengarse de las naciones, y castigar a los pueblos extranjeros,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"para encarcelar a sus reyes con grilletes y a sus líderes con cadenas de hierro,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"para imponer el juicio decretado contra ellos. Esta es la honra de sus fieles seguidores. ¡Alaben al Señor!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_vbl/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}