{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Un Salmo de David."]},{"type":"verse","number":1,"content":[{"text":"El Señor es mi pastor, y por ello tengo todo lo que necesito.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Me da descanso en verdes pastos. Me guía a corrientes tranquilas.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Me consuela, me guía por el camino correcto, por su nombre.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Incluso cuando camino por el valle oscuro de la muerte, no tengo miedo de ningún mal, porque tú estás ahí conmigo. Tu vara y tu bastón me protegen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Preparas un banquete para mí en presencia mis enemigos. Me honras ungiendo mi cabeza con aceite. ¡Mi copa está tan llena que se desborda!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Estoy completamente seguro de que tu bondad y tu amor inagotable estarán conmigo toda mi vida, y viviré para siempre en la casa del Señor.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_vbl/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}