{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"hebrew_subtitle","content":["(Los Salmos 42 y 43 eran originalmente uno solo)."]},{"type":"verse","number":1,"content":[{"text":"Dios, ¡Por favor reivindícame! Aboga por mi caso contra una nación infiel; sálvame de esa gente malvada y deshonesta.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Porque tú, Dios, eres mi protección, así que, ¿Por qué me has dado la espalda? ¿Por qué debería ir por ahí llorando a causa del ataque de mis enemigos?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Envía tu luz y tu verdad para que me guíen; deja que me lleven a tu monte santo, al lugar donde vives.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Iré al altar de Dios, a Dios quien me hace verdaderamente feliz. Te alabaré con el arpa, Dios, mi Dios.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"¿Por qué estoy tan desanimado? ¿Por qué me siento tan triste? Esperaré en el Señor; le alabaré porque él es el único que me puede salvar, ¡Mi Dios!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/spa_vbl/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}