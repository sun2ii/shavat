{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Para el director del coro. Un Salmo de los hijos de Coré."]},{"type":"verse","number":1,"content":[{"text":"¡Aplauda todo el mundo! ¡Griten con alegría al Señor!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Porque nuestro Señor Altísimo es imponente; él es el gran rey de toda la tierra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Él somete a los otros pueblos bajo nosotros; pone a las naciones bajo nuestros pies.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Él escogió la tierra prometida para nosotros; la orgullosa posesión de los descendientes de Jacob a quienes ama. Selah.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dios asciende a su trono","poem":1},{"noteId":142},{"text":"con grandes gritos, el Señor es acompañado con el sonido de trompetas.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"¡Canten alabanzas a Dios, canten, canten alabanzas a nuestro Rey, canten!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"¡Porque el Señor es el Rey de toda la tierra; canten alabanzas con Salmos!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dios gobierna sobre las naciones; se sienta sobre su santo trono.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Los gobernantes de las naciones se reúnen junto con la gente del Dios de Abraham, porque los defensores","poem":1},{"noteId":143},{"text":"de la tierra le pertenecen a Dios. Él será honrado por toda la tierra.","poem":1}]}],"footnotes":[{"noteId":142,"caller":"+","text":"47.5 Implícito.","reference":{"chapter":47,"verse":5}},{"noteId":143,"caller":"+","text":"47.9 Literalmente, “escudos”.","reference":{"chapter":47,"verse":9}}]},"thisChapterLink":"/api/spa_vbl/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}