{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["Para el director del coro. Con instrumentos de cuerda. Un Salmo (masquil) de David, cuando los Zifitas vinieron a Saúl y le dijeron, “David se está escondiendo entre nosotros”."]},{"type":"verse","number":1,"content":[{"text":"¡Sálvame! ¡Oh, Dios! Por tu carácter,","poem":1},{"noteId":161},{"text":"por favor ¡Sálvame! ¡Reivindícame por tu poder!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Por favor, Dios, escucha mi oración; escucha lo que digo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Porque extraños están viniendo a atacarme. Hombres violentos que no creen en Dios están intentando matarme. Selah.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero Dios me ayuda; ¡El Señor salva mi vida!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"El mal que mis enemigos han hecho vendrá sobre ellos. Dependo de ti para destruirlos.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Felizmente ofreceré sacrificio a ti; te alabaré,","poem":1},{"noteId":162},{"text":"Señor, porque tú eres bueno.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Porque él me ha salvado de todos mis problemas; y he visto a todos los que me odiaban vencidos.","poem":1},{"noteId":163}]}],"footnotes":[{"noteId":161,"caller":"+","text":"54.1 Literalmente, “nombre”.","reference":{"chapter":54,"verse":1}},{"noteId":162,"caller":"+","text":"54.6 Literalmente, “tu nombre”.","reference":{"chapter":54,"verse":6}},{"noteId":163,"caller":"+","text":"54.7 “Derrotado”: implícito. Literalmente, “with my eye I have looked at those who hate me”.","reference":{"chapter":54,"verse":7}}]},"thisChapterLink":"/api/spa_vbl/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}