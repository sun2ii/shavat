{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Un salmo de David, cuando estaba en el desierto de Judá."]},{"type":"verse","number":1,"content":[{"text":"Dios, tú eres mi Dios y te busco de todo corazón. Mi ser entero te anhela y tiene sed de ti, en medio de esta tierra seca, árida y carente de aguas.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Te veo en el Templo. Contemplo tu poder y tu gloria.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tu fidelidad y amor son mejores que la vida misma. Por ello te alabaré.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Te agradeceré tanto como viva. Elevo mis manos hacia ti y celebro tu maravilloso carácter.","poem":1},{"noteId":191}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tú me satisfaces más que el mejor de los alimentos. Te alabaré con canciones alegres.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Paso la noche entera pensando en ti desde que me acuesto, meditando sobre ti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Porque eres quien me ayuda, canto feliz bajo tus alas.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Me aferro a ti y tus fuertes brazos me levantan.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Los que tratan de destruirme irán a la tumba.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Morirán a punta de espada y serán alimento para los chacales.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Pero el rey vivirá feliz por todo lo que Dios ha hecho. Todos los que siguen a Dios","poem":1},{"noteId":192},{"text":"le alabarán, pero los que mienten serán silenciados.","poem":1}]}],"footnotes":[{"noteId":191,"caller":"+","text":"63.4 Literalmente, “tu nombre”.","reference":{"chapter":63,"verse":4}},{"noteId":192,"caller":"+","text":"63.11 “Siguen a Dios”: Literalmente, “juran por Dios”.","reference":{"chapter":63,"verse":11}}]},"thisChapterLink":"/api/spa_vbl/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}