{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Para el director del coro. Un salmo de David. Para un memorial.",{"noteId":227}]},{"type":"verse","number":1,"content":[{"text":"Oh, Dios, ¡sálvame! ¡Apresúrate a ayudarme!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Por favor, vence y humilla a los que tratan de matarme. Haz que los que me hieren retrocedan con deshonra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Que los que se burlan de mi se horroricen de su derrota.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero que Sean felices todos los que vienen a ti; que los que aman tu salvación siempre digan: “¡Cuán grande es Dios!”","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"En lo que a mi concierne, soy un pobre y menesteroso. ¡Apresúrate, oh Dios, a ayudarme! ¡No esperes más!","poem":1}]}],"footnotes":[{"noteId":227,"caller":"+","text":"70.0 Este s