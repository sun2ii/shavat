{"translation":{"id":"spa_vbl","name":"Versión Biblia Libre","website":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spavbl","licenseNotes":null,"shortName":"VBL","englishName":"Spanish Free Bible Version","language":"spa","textDirection":"ltr","sha256":"ae91569281ca1406b1ab1913636cf3ca7e95529bc40b7238b8664e09ee86da2b","availableFormats":["json"],"listOfBooksApiLink":"/api/spa_vbl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"español","languageEnglishName":"Spanish"},"book":{"id":"PSA","translationId":"spa_vbl","name":"Salmos","commonName":"Salmos","title":"Salmos","order":19,"numberOfChapters":150,"sha256":"eefc996ebb6d8af3d6ab9301c1d942abdb0c2c90b7ba26ac210670f761783e3c","firstChapterNumber":1,"firstChapterApiLink":"/api/spa_vbl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/spa_vbl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"¡El Señor reina, revestido en majestad! Él usa sus mantos reales, con su poder, usado llevado cinturón. El mundo se mantiene unido firmemente, no puede ser destruido.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tu trono ha existido desde eras pasadas; tú eres eterno.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Las inundaciones se han elevado, Señor; las inundaciones han levantado sus voces; las inundaciones han levantado olas destructoras.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Pero mientras más violento es el océano, mientras más grandes son las olas del mar, más grande es el Señor que reina.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tus leyes son totalmente confiables. Tu casa,","poem":1},{"noteId":326},{"text":"Señor, será santa para siempre.","poem":1}]}],"footnotes":[{"noteId":326,"caller":"+","text":"93.5 “Tu casa”: Esto podría referirse al Templo, o al reinado duradero del Señor.","reference":{"chapter":93,"verse":5}}]},"thisChapterLink":"/api/spa_vbl/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spa_vbl/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spa_vbl/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}