{"translation":{"id":"spy_wbt","name":"Biibilya Nyēē Tiliil","website":"https://ebible.org/Scriptures/details.php?id=spyNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=spyNT","licenseNotes":null,"shortName":"WBT","englishName":"Sabaot NT","language":"spy","textDirection":"ltr","sha256":"d9db79bb400d744f5833223ac2be5101d86cfd7332033c319cd9f14cd00d05d3","availableFormats":["json"],"listOfBooksApiLink":"/api/spy_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7844,"languageName":"Kalenjin","languageEnglishName":"Kalenjin"},"book":{"id":"HEB","translationId":"spy_wbt","name":"Iburaneek","commonName":"Iburaneek","title":"Barweet nyēē /kikēēsirchi Iburaneek","order":58,"numberOfChapters":13,"sha256":"16e600f375712236ccfdf932a579c4a3a721ac33650058d0633bb36951d14ad1","firstChapterNumber":1,"firstChapterApiLink":"/api/spy_wbt/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/spy_wbt/HEB/13.json","totalNumberOfVerses":299},"chapter":{"number":1,"content":[{"type":"heading","content":["King'āloolwēēch ꞉Yēyiin kubununēē lakwanyii"]},{"type":"verse","number":1,"content":["King'āloolchinē ꞉Yēyiin kēny mbo kuuko areet chēē chaang' ām kēēlwookik chēē chaang' kubununēē *wōōrkooyikyii,"]},{"type":"verse","number":2,"content":["nteenee ām bēsyōōsyēchu bo lēt king'āloolwēēch kubununēē lakwanyii nyēē kiikurōōbchi kiy ake tukul. Lakwanaata ꞉nyēē kiyēyēē ꞉inee kōōrēēt barak āk ng'wēny."]},{"type":"verse","number":3,"content":["Kēēkāsēē lakwanaa wōōyintaab Yēyiin. Inee ꞉nyooto kerkeey Yēyiin bakeenke ānkubāwu kōōrēēt barak āk ng'wēny ām kāāmuukēywēēkaab ng'ālyoontēēnyii. Yu kāwokume sukōōtiliil biiko ām choolwookātēēng'waa, kuwēēchi keey kibkōōnkōy wokutēbunēē āwutaab taay nyēbo Yēyiin nyoo bāwu kiy ake tukul."]},{"type":"heading","content":["Wōō ꞉Yēēsu kusiir malayikaanik"]},{"type":"verse","number":4,"content":["/Kikeeyey lakwanaa kunyōōr wōōyinto kusiir malayikaanik. /Kēēkuurē inee kule Lakwataab Yēyiin, kaayna nyēē wōō kusiir nyēbo malayikaanik."]},{"type":"verse","number":5,"content":["Ara, *malayikeet nkōnō ꞉nyēē kiikumwoochi ꞉Yēyiin kule,",{"text":"“Inyiing' lakwanyuu!","poem":1},{"text":"Kāāyēku ra kōōn.”?","poem":2},"Mānāāmwooy yēēt ake ꞉Yēyiin kurubta keey malayikeet kule,",{"text":"“+Māāyēku kwaan","poem":1},{"text":"ānkuyēk lakwanyuu.”","poem":2}]},{"type":"verse","number":6,"content":["Nto subak yu kēēyook ꞉Yēyiin lakwanyii kibooreet kuchō kōōrooni, kimwooy kurubta keey lakwanaa kule,",{"text":"“Kukutunkyi ꞉malayikaanik tukul inee.”","poem":1},{"noteId":0}]},{"type":"verse","number":7,"content":["Kurubta keey āk malayikaanik /kikēēmwooy kule,",{"text":"“Kiiyookiintēētaab Yēyiin mbo ꞉wusōōnēēt","poem":1},{"noteId":1},{"text":"ānku motwooriintēēnyii ꞉nkinee iileet.”","poem":2}]},{"type":"verse","number":8,"content":["Nto kurubta keey āk Lakwataab Yēyiin /kēēmwooyē kule,",{"text":"“Wēētii ꞉bāytooyiisyēēng'uung' ākookoy ōō, Yēyiin!","poem":1},{"text":"Ibāytēē ꞉inyiing' biikuuk manta.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ichāmē ꞉inyiing' kiyēē bo man,","poem":1},{"text":"‑āmēēriiku ng'al chēbo rōkōs.","poem":2},{"text":"Kiyooto ꞉nyēē kiyey Yēyiin kung'aabing',","poem":1},{"text":"ānkukōōning' ng'erekweek kusiir bāytooyiin ake tukul.”","poem":2}]},{"type":"verse","number":10,"content":["/Kikēēmwooy subak kule,",{"text":"“Ām taayta, 'kiiyey ꞉inyiing' Mokoryoontēēt kōōrēēt wōlēēb ng'wēny","poem":1},{"text":"ankiiyey nkinee wōliin bo barak.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mākubot ꞉barak āk ng'wēny,","poem":1},{"text":"nteenee imiitē ꞉inyiing' ākookoy.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"+Mākung'ētyo kuu sira nyēē yoos","poem":1},{"text":"ankiimaman kuu kōōtiit nyēē kibsānkāti","poem":2},{"text":"nto yityo ikeeree alak chēē leelach.","poem":3},{"text":"Nteenee inyiing' ku nyooto bo kwaak","poem":1},{"text":"nyēē mākoy iyoosiitu bēsyēēt ake.”","poem":2}]},{"type":"verse","number":13,"content":["Ara malayikeet nkōnō ꞉nyēē kiikumwoochi ꞉Yēyiin kule,",{"text":"“Ibuurunēē āwunyuu nyēbo taay","poem":1},{"text":"ākoy yoo kaayeyiing' itēbēē buunikuuk.”?","poem":2}]},{"type":"verse","number":14,"content":["Ng'oo ꞉malayikaanik nanyuun? Icheek ku tāmirmirook choo iyooktooy ꞉Yēyiin ānkuyēētyēēchinē biiko choo mii /bokiirāroochē."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kwoonēē ꞉ng'aleechu Kiruutēk 32:43 ām wēēksēēt nyēbo kuutiitaab Kirikiik.","reference":{"chapter":1,"verse":6}},{"noteId":1,"caller":"+","text":"Ng'ālyoontēēt ‘malayikeet’ ām kuutiitaab Kirikiik āk Iburaneek kōōbooru kule ‘kiiyookiintēēt’.","reference":{"chapter":1,"verse":7}}]},"thisChapterLink":"/api/spy_wbt/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/spy_wbt/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/spy_wbt/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}