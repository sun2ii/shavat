{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"AMO","translationId":"srp_onspc","name":"Књига пророка Амоса","commonName":"Књига пророка Амоса","title":"Књига пророка Амоса","order":30,"numberOfChapters":9,"sha256":"2e26dc7f3e980f57b8a67df90c90e4f46e6c25f22867fc9a378cee455d7c170e","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/srp_onspc/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Овако каже Господ:",{"text":"„Због три преступа Моава,","poem":1},{"text":"а и због четири, своју казну нећу да повучем,","poem":2},{"text":"јер је у кречу спалио","poem":1},{"text":"кости цара Едома.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Бацићу огањ на Моав","poem":1},{"text":"и спалиће кериотска утврђења.","poem":2},{"text":"Моав ће пропасти уз вреву,","poem":1},{"text":"уз покличе и уз јеку трубе.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Истребићу из њега судије,","poem":1},{"text":"са њим побићу све његове главаре“ –","poem":2},{"text":"каже Господ.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Овако каже Господ:",{"text":"„Због три преступа Јуде,","poem":1},{"text":"а и због четири, своју казну нећу да повучем,","poem":2},{"text":"јер су одбацили Закон Господњи","poem":1},{"text":"и његове уредбе нису држали.","poem":2},{"text":"На грех су их навеле њихове лажи,","poem":1},{"text":"у којима су живели и њихови очеви.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Бацићу огањ на Јуду","poem":1},{"text":"и спалиће јерусалимска утврђења.“","poem":2}]},{"type":"heading","content":["Суд над Израиљем"]},{"type":"verse","number":6,"content":["Овако каже Господ:",{"text":"„Због три преступа Израиља,","poem":1},{"text":"а и због четири, своју казну нећу да повучем,","poem":2},{"text":"јер су праведника продавали за сребро","poem":1},{"text":"и убогога за сандале.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Они газе по прашини на глави сиромаха.","poem":1},{"text":"Пут понизних изокрећу,","poem":2},{"text":"човек и отац његов иду истој девојци","poem":1},{"text":"и тако скрнаве моје свето име.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"На заложеним хаљинама леже","poem":1},{"text":"крај сваког жртвеника","poem":2},{"text":"и вино оних који су глобљени пију","poem":1},{"text":"у храму њихових богова.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"А ја сам истребио Аморејце међу њима,","poem":1},{"text":"високе као кедрови моћни,","poem":2},{"lineBreak":true},{"text":"јаке као храстови.","poem":2},{"text":"Истребио сам их од подножја до врха,","poem":1},{"text":"од корена до плода.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"И још сам вас извео из египатске земље","poem":1},{"text":"и водио вас по пустињи четрдесет година,","poem":2},{"lineBreak":true},{"text":"да бисте запосели земљу Аморејаца.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Од ваших сам синова неке подизао за пророке,","poem":1},{"text":"и за назиреје неке од ваших младића.","poem":2},{"text":"Зар није тако, о, децо Израиљева","poem":1},{"text":"– говори Господ.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Али ви сте назирејима давали да пију вино","poem":1},{"text":"и пророцима сте заповедали: ’Не пророкујте!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ево, притиснућу вас","poem":1},{"text":"као што снопови многи притискају запрегу.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ни онај који је брз неће утећи,","poem":1},{"text":"ни јаки неће учврстити снагу своју","poem":2},{"lineBreak":true},{"text":"и свој живот јунак спасти неће.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Стрелац се неће одржати,","poem":1},{"text":"брзи на ногама се неће спасти,","poem":2},{"lineBreak":true},{"text":"а ни коњаник живот сачувати неће.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"И најсрчанији међу ратницима","poem":1},{"text":"тога ће дана утећи неодевен","poem":2},{"text":"– говори Господ.“","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}