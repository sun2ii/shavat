{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"HOS","translationId":"srp_onspc","name":"Књига пророка Осије","commonName":"Књига пророка Осије","title":"Књига пророка Осије","order":28,"numberOfChapters":14,"sha256":"a14c403ef3541ce9cd6fa5f493d3b71ed87fc0eaad863c8f7f2bdf9aa11cb579","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/srp_onspc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Покајање доноси благослов"]},{"type":"verse","number":1,"content":[{"text":"Господу се, Богу своме, Израиљу врати,","poem":1},{"text":"јер си посрнуо у кривици својој!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Понесите са собом речи,","poem":1},{"text":"Господу се вратите.","poem":2},{"text":"Кажите му:","poem":1},{"text":"„Кривицу нам сваку ти опрости,","poem":2},{"lineBreak":true},{"text":"молитву услиши;","poem":2},{"text":"како бисмо ти принели","poem":1},{"text":"плод усана својих","poem":2},{"lineBreak":true},{"text":"као јунце када жртвујемо!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Асирија нас спасти неће","poem":1},{"text":"и на коњима нећемо јахати.","poem":2},{"text":"Нећемо опет говорити, делу руку наших: ’Боже наш!’","poem":1},{"text":"Јер сироче смиловање у теби налази.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"„Излечићу отпадништво њихово,","poem":1},{"text":"добровољно волећу их","poem":2},{"lineBreak":true},{"text":"јер се од њих јарост моја одвратила.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Израиљу бићу као зора,","poem":1},{"text":"процветаће као љиљан,","poem":2},{"text":"пустиће корење као кедар ливански.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ницаће му младице,","poem":1},{"text":"као маслина раскошан ће бити,","poem":2},{"text":"мирисаће као кедар ливански.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Вратиће се да живе у сенци његовој.","poem":1},{"text":"Проклијаће као жито,","poem":2},{"text":"раширити као лоза,","poem":1},{"text":"прочуће се као вино са Ливана.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"О, Јефреме, шта ја имам с идолима?","poem":1},{"text":"Ја, ја ћу да услишим,","poem":2},{"lineBreak":true},{"text":"ја ћу да се старам,","poem":2},{"text":"ја сам као зелен чемпрес.","poem":1},{"text":"Од мене ћеш ти свој плод да примиш.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ко је мудар нек ово разуме,","poem":1},{"text":"ове ствари нек умни разазна:","poem":2},{"text":"Господњи су исправни путеви.","poem":1},{"text":"Праведници ходају по њима,","poem":2},{"lineBreak":true},{"text":"одметници на њима посрћу.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}