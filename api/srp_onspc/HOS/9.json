{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"HOS","translationId":"srp_onspc","name":"Књига пророка Осије","commonName":"Књига пророка Осије","title":"Књига пророка Осије","order":28,"numberOfChapters":14,"sha256":"a14c403ef3541ce9cd6fa5f493d3b71ed87fc0eaad863c8f7f2bdf9aa11cb579","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/srp_onspc/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Казна за Израиљ"]},{"type":"verse","number":1,"content":[{"text":"Израиљу, не радуј се!","poem":1},{"text":"Не ликуј као народи","poem":2},{"text":"јер си блудничио и отишао од Бога свога.","poem":1},{"text":"Заволео си зараду блудничку","poem":2},{"lineBreak":true},{"text":"са пшеничних гумна.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Гумно и винска каца их неће нахранити,","poem":1},{"text":"изневериће у њима шира.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Они неће остати у Господњој земљи.","poem":1},{"text":"Јефрем ће се вратити у Египат","poem":2},{"lineBreak":true},{"text":"и у Асирији ће јести нечисту храну.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Неће Господу изливати вино","poem":1},{"text":"и неће му бити угодне њихове жртве.","poem":2},{"text":"Биће им као хлеб жалости","poem":1},{"text":"и сви који га једу ће се онечистити.","poem":2},{"text":"Јер је њихов хлеб за њихову гушу","poem":1},{"text":"и неће ући у Дом Господњи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Шта ћеш да радиш на дан одређеног празника,","poem":1},{"text":"на дан Господње светковине?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Јер, гле, побегли су од пропасти,","poem":1},{"text":"а Египат ће их окупити","poem":2},{"lineBreak":true},{"text":"и у Мемфису ће их сахранити.","poem":2},{"text":"Драгоцености њиховог сребра зарашће у коприву","poem":1},{"text":"и трње ће им бити у шаторима.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Дошли су дани казне!","poem":1},{"text":"Дошли су дани освете!","poem":2},{"lineBreak":true},{"text":"Нека зна Израиљ:","poem":2},{"text":"Пророк је луд","poem":1},{"text":"и суманут је човек духован,","poem":2},{"text":"од величине кривице твоје","poem":1},{"text":"и велике мржње.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Јефрем је са Богом мојим био стражар,","poem":1},{"text":"а пророк птичарева замка на свим његовим путевима.","poem":2},{"lineBreak":true},{"text":"Мржња је у Дому Бога његовога.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"У покварености су огрезли","poem":1},{"text":"као у данима Гаваје.","poem":2},{"text":"Али сетиће се он кривице њихове","poem":1},{"text":"и казниће грехе њихове.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"„У пустињи сам нашао Израиљ као грожђе;","poem":1},{"text":"као рани плод на тек стасалом смоквином стаблу","poem":2},{"lineBreak":true},{"text":"видео сам ваше претке.","poem":2},{"text":"И они су дошли у Вал-Фегор","poem":1},{"text":"и посветили се срамоти,","poem":2},{"lineBreak":true},{"text":"постали су попут гадости какве су волели.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Јефремова слава ће као птица да одлети –","poem":1},{"text":"нема рађања, нема трудноће, нема зачећа.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Јер ако и одгаје децу своју","poem":1},{"text":"ја ћу их оставити без иједног човека.","poem":2},{"text":"И још: јао њима,","poem":1},{"text":"када будем отишао од њих!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Јефрем је, колико видим, као Тир,","poem":1},{"text":"засађен на пашњаку.","poem":2},{"text":"Али Јефрем изводи убицама","poem":1},{"text":"своју децу.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"О, Господе, подај им,","poem":1},{"text":"ал’ шта да им даш?","poem":2},{"text":"Утробу која побацује","poem":1},{"text":"и груди усахле подај им.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"„У Галгалу су сва њихова зла","poem":1},{"text":"и тамо их мрзим.","poem":2},{"text":"Због њихових злобних дела","poem":1},{"text":"истераћу их из свога Дома.","poem":2},{"text":"Више нећу да их волим.","poem":1},{"text":"Сви су њихови главари одметници.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Разорен је Јефрем,","poem":1},{"text":"корен му је сасушен","poem":2},{"lineBreak":true},{"text":"и плода неће имати.","poem":2},{"text":"А ако и нешто роди,","poem":1},{"text":"то предраго његове утробе ја ћу да погубим!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Мој Бог ће их одбацити","poem":1},{"text":"јер га нису послушали,","poem":2},{"lineBreak":true},{"text":"па ће бити луталице међу народима.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}