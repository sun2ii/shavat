{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"ISA","translationId":"srp_onspc","name":"Књига пророка Исаије","commonName":"Књига пророка Исаије","title":"Књига пророка Исаије","order":23,"numberOfChapters":66,"sha256":"8ac1b8f0b387ba17b93e555a34687ef1b438b1c76a8adfbfa22303428cbce2d8","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/srp_onspc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Тужбалица над Моавцима"]},{"type":"verse","number":1,"content":["Пророштво против Моава:",{"text":"„Обноћ је опустошен Ар;","poem":1},{"text":"срушен је Моав!","poem":2},{"text":"Обноћ је опустошен Кир;","poem":1},{"text":"срушен је Моав!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"У храм и Девон она се успиње","poem":1},{"text":"на узвишицу да плаче;","poem":2},{"lineBreak":true},{"text":"над Нававом и над Медевом","poem":2},{"text":"нариче народ моавски;","poem":1},{"text":"а све су главе оголеле","poem":2},{"lineBreak":true},{"text":"и све браде обријане;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"по улицама су врећама заогрнути,","poem":1},{"text":"на њиховим крововима и по трговима","poem":2},{"text":"сви они наричу","poem":1},{"text":"и плачући силазе.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Есевон и Елеалија јаучу,","poem":1},{"text":"глас њихов се чује до Јасе.","poem":2},{"text":"Зато дрхћу ратници моавски,","poem":1},{"text":"у грчу је душа њихова.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Зато јеца срце моје због Моаваца,","poem":1},{"text":"бегунци њихови беже","poem":2},{"lineBreak":true},{"text":"до Соара, Еглат-Селисије,","poem":2},{"text":"плачући се пењу на Луит;","poem":1},{"text":"путем оронајимским","poem":2},{"lineBreak":true},{"text":"разлеже се јаук над рушевинама.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Јер су се исушиле воде нимримске,","poem":1},{"text":"трава је усахла,","poem":2},{"text":"биље пропало,","poem":1},{"text":"зеленила више нема.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Зато ко је нешто уштедео и складишта њихова,","poem":1},{"text":"тај ће то носити на Поток врба.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Јер јаук се разлеже до границе с Моавом,","poem":1},{"text":"нарицање му је до Еглајима,","poem":2},{"lineBreak":true},{"text":"нарицање му је до Вир-Елима.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Та, пуне су крви воде димонске,","poem":1},{"text":"а ја ћу још додати Димону","poem":2},{"text":"једног лава на моавске бегунце","poem":1},{"text":"и на преостале у земљи.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}