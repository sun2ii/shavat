{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"ISA","translationId":"srp_onspc","name":"Књига пророка Исаије","commonName":"Књига пророка Исаије","title":"Књига пророка Исаије","order":23,"numberOfChapters":66,"sha256":"8ac1b8f0b387ba17b93e555a34687ef1b438b1c76a8adfbfa22303428cbce2d8","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/srp_onspc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Реч против Куша"]},{"type":"verse","number":1,"content":[{"text":"Тешко земљи размахнутих крила,","poem":1},{"text":"с оне стране кушанских река,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"која морем шаље гласнике,","poem":1},{"text":"и водом у чамцима рогозним.","poem":2},{"lineBreak":true},{"text":"Идите, хитри весници,","poem":1},{"lineBreak":true},{"text":"пуку лепа стаса и тамне пути,","poem":1},{"text":"народу ког се боје и надаље,","poem":2},{"text":"пуку жилавом и завојевачком,","poem":1},{"text":"чијом земљом се преплићу реке.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Сви становници васељене,","poem":1},{"text":"житељи земље,","poem":2},{"text":"кад се застава на горама подигне,","poem":1},{"text":"гледајте;","poem":2},{"text":"и кад рог затруби,","poem":1},{"text":"слушајте.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Јер мени говори Господ:","poem":1},{"text":"„Одмараћу се и посматрати са својег места,","poem":2},{"text":"као жега зажарена над светлошћу,","poem":1},{"text":"као росни облак кад је жега током жетве.“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Пре бербе, кад процвета лоза,","poem":1},{"text":"дозревање гроздова је у јеку,","poem":2},{"text":"и секачима ће посећи младице,","poem":1},{"text":"и одстранити посечене лозице.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Заједно ће бити остављени","poem":1},{"text":"грабљивицама горским и зверима по земљи:","poem":2},{"text":"грабљивице ће на њима летовати,","poem":1},{"text":"и све звери земаљске зимовати.","poem":2}]},{"type":"verse","number":7,"content":["У то време дар доносиће Господу над војскама",{"text":"пук лепа стаса и тамне пути,","poem":1},{"text":"народ ког се боје и надаље,","poem":2},{"text":"пук жилав и завојевачки,","poem":1},{"text":"чијом земљом преплићу се реке,","poem":2},"к месту где је име Господа над војскама, гори Сион."]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}