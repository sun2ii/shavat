{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"ISA","translationId":"srp_onspc","name":"Књига пророка Исаије","commonName":"Књига пророка Исаије","title":"Књига пророка Исаије","order":23,"numberOfChapters":66,"sha256":"8ac1b8f0b387ba17b93e555a34687ef1b438b1c76a8adfbfa22303428cbce2d8","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/srp_onspc/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Свети пут"]},{"type":"verse","number":1,"content":[{"text":"Нека им се узрадује пустиња,","poem":1},{"text":"земља сасушена.","poem":2},{"text":"Нека кличе пустара,","poem":1},{"text":"нека као шафран процвета.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Нека бујно цвати цват,","poem":1},{"text":"и нека још кличе од радости и певања.","poem":2},{"text":"Њој је дана слава ливанска,","poem":1},{"text":"красота кармилска и саронска.","poem":2},{"text":"Они ће гледати славу Господњу,","poem":1},{"text":"красоту Бога нашега.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Руке клонуле укрепите,","poem":1},{"text":"и колена клецава учврстите.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Реците преплашеним срцима:","poem":1},{"text":"„Будите јаки, не бојте се!","poem":2},{"text":"Ево Бога вашега,","poem":1},{"text":"одмазда долази,","poem":2},{"text":"наплата Божија.","poem":1},{"text":"Он сам хита да вас спасе!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Тада ће се слепима отворити очи","poem":1},{"text":"и глувима ће се уши отворити;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"тада ће хроми као јелен скакати,","poem":1},{"text":"и певаће језик у немога;","poem":2},{"text":"јер ће вода избијати у пустињи","poem":1},{"text":"и потоци у пустари,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"тле спаљено постаће рит,","poem":1},{"text":"а жедна земља водоскоци;","poem":2},{"text":"у јазбинама за шакале","poem":1},{"text":"сместиће се зеленило за трску и рогоз.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Тамо ће пролазити друм и пут,","poem":1},{"text":"и он ће се звати „Свети пут“;","poem":2},{"lineBreak":true},{"text":"нико нечист њиме проћи неће","poem":2},{"text":"него ће бити за њих,","poem":1},{"text":"за оне који путем иду, а ту луди неће залутати.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Тамо лава више бити неће,","poem":1},{"text":"нити ће тамо пролазити звер,","poem":2},{"lineBreak":true},{"text":"нити ће се наћи,","poem":2},{"text":"него ће ходати откупљени.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"Вратиће се избављени Господњи,","poem":2},{"text":"доћи ће у Сион с весељем","poem":1},{"text":"и с радошћу вечном на челима;","poem":2},{"text":"пратиће их раздраганост и радост,","poem":1},{"text":"а побећи ће жалост и уздаси.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}