{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Блажен човек који не следи савет опаких,","poem":1},{"text":"не стоји на грешничком путу,","poem":2},{"lineBreak":true},{"text":"нити седа у друштво ругача,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"већ ужива у Закону Господњем,","poem":1},{"text":"дан и ноћ му о Закону мисли.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Он је као дрво усађено крај поточних вода,","poem":1},{"text":"које род свој даје када му је време,","poem":2},{"text":"а лишће му никада не вене.","poem":1},{"text":"Све што ради, на добро му иде.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Нису такви опаки!","poem":1},{"text":"Они су као плева што је ветар носи.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Зато опаки неће опстати на суду,","poem":1},{"text":"ни грешници на збору праведних.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Јер зна Господ пут праведника,","poem":1},{"text":"а пут опаких води у пропаст.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}