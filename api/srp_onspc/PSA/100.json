[]},"thisChapterLink":"/api/srp_onspc/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}