{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["Давидов Псалам."]},{"type":"verse","number":1,"content":[{"text":"О милости и о правди певам!","poem":1},{"text":"Ја теби, Господе, певам похвале.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Предаћу се путу беспрекорном!","poem":1},{"text":"Када ћеш ми доћи?","poem":2},{"lineBreak":true},{"text":"У честитости срца свога","poem":1},{"text":"живећу у свом дому.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ствари гнусне","poem":1},{"text":"не стављам пред очи своје;","poem":2},{"text":"отпадничке ствари мрзим,","poem":1},{"text":"на њих не пристајем!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ништа немам с подлацима","poem":1},{"text":"и за зло нећу да знам.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ко свог ближњег иза леђа оцрњује,","poem":1},{"text":"ја тога сатирем;","poem":2},{"text":"ко је пркосног погледа и надменог срца,","poem":1},{"text":"ја тога не трпим.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Моје су очи на вернима у земљи","poem":1},{"text":"да би са мном боравили;","poem":2},{"text":"нек ми служи онај","poem":1},{"text":"који иде путем беспрекорним.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"У мом дому места","poem":1},{"text":"нема за препредењака,","poem":2},{"text":"пред очима мојим лажов","poem":1},{"text":"потрајати неће.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Из јутра у јутро сатирем","poem":1},{"text":"све неверне из земље,","poem":2},{"text":"све злотворе истребљујем","poem":1},{"text":"из Господњег града.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}