{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["Песма. Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"Срце ми је вољно, Боже,","poem":1},{"text":"да ти певам,","poem":2},{"lineBreak":true},{"text":"да ти свирам бићем својим!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Будите се, о, лиро и харфо,","poem":1},{"text":"ја бих зору да пробудим.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"О, Господе, хвалићу те међу народима,","poem":1},{"text":"славићу те међу туђинцима.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Јер је велика милост твоја, поврх је небеса;","poem":1},{"text":"до облака сеже верност твоја.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Нека си узвишен врх небеса, Боже;","poem":1},{"text":"слава твоја нек је над свом земљом.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Десницом нас својом спаси, услиши нас,","poem":1},{"text":"па да твоји миљеници избављени буду.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"У свом Светилишту Бог је објавио:","poem":1},{"text":"„Заклицаћу, поделићу Сихем,","poem":2},{"lineBreak":true},{"text":"премерићу долину Сокота.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Мој је Галад, мој је Манасија;","poem":1},{"text":"Јефрем ми је кацига на глави,","poem":2},{"lineBreak":true},{"text":"а Јуда ми царско жезло.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Моав ми је корито за прање,","poem":1},{"text":"на Едом сам бацио сандалу,","poem":2},{"lineBreak":true},{"text":"ускликнућу поврх Филистеје!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ко ће мене да отпрати у град утврђени?","poem":1},{"text":"А на Едом ко ће ме повести?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Нећеш ли ти, о, Боже,","poem":1},{"text":"који си нас одбацио,","poem":2},{"text":"па с војскама нашим, Боже,","poem":1},{"text":"више не корачаш?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Помоћ дај нам испред противника,","poem":1},{"text":"узалуд је људско избављење.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Силно ћемо ступати са Богом,","poem":1},{"text":"изгазиће наше противнике!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}