{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["Хоровођи. Давидов."]},{"type":"verse","number":1,"content":[{"text":"Уточиште је мени у Господу.","poem":1},{"text":"Зашто онда мени говорите:","poem":2},{"lineBreak":true},{"text":"„Као птица у гору утеци!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Јер, гле, опаки лук свој натежу,","poem":1},{"text":"на тетиву стрелу постављају,","poem":2},{"lineBreak":true},{"text":"да поштене из мрака гађају.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Када се темељи распадају,","poem":1},{"text":"шта праведник може да учини?“","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Господ је у свом светом храму,","poem":1},{"text":"Господњи је престо на небесима,","poem":2},{"text":"очима он помно посматра,","poem":1},{"text":"он прониче потомке људи.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Праведнога испитује Господ,","poem":1},{"text":"али душа његова мрзи онога,","poem":2},{"lineBreak":true},{"text":"ко је опак и воли насиље.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"На опаког он ће сручити","poem":1},{"text":"ужарено угљевље и сумпор;","poem":2},{"text":"пламенови огњеног вихора,","poem":1},{"text":"то је део њихов, то им је у чаши.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Јер праведан је Господ,","poem":1},{"text":"праведност он воли,","poem":2},{"lineBreak":true},{"text":"поштени ће гледати му лице.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}