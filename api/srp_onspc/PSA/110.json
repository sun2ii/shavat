{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"Рече Господ Господу моме:","poem":1},{"lineBreak":true},{"text":"„Седи мени с моје десне стране,","poem":2},{"text":"док душмане не положим твоје,","poem":1},{"text":"за твоје ноге постоље да буду.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Жезло снаге твоје пружа Господ са Сиона:","poem":1},{"text":"Сред душмана својих владај!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Твој ће ти се народ радо дати у дану твог похода;","poem":1},{"text":"у сјају славе, у цику зоре младићи су твоји као роса.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Господ је дао заклетву","poem":1},{"text":"и неће је повући:","poem":2},{"text":"„Ти си довека свештеник","poem":1},{"text":"по реду Мелхиседековом.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Господ ти је с десне стране","poem":1},{"text":"и цареве ломи у дану свог гнева.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Он народима суди, све је пуно лешева;","poem":1},{"text":"широм поља он главе разбија.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Он из потока крај пута пије","poem":1},{"text":"и због тога диже главу.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}