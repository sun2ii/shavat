{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"Славите Господа!","poem":1},{"lineBreak":true},{"text":"Благо човеку што се Господа боји","poem":1},{"text":"и у заповестима његовим радо ужива.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Моћно ће му потомство бити по земљи,","poem":1},{"text":"нараштај ће праведника благословен бити.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"У кући му благо и иметак,","poem":1},{"text":"праведност му постојана вавек.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Светло и у тами сија праведнима,","poem":1},{"text":"милосрднима, милостивима и правичнима.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Сажаљив је добар човек, позајмљује,","poem":1},{"text":"праведно се у послу опходи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Тај се никад уздрмати неће,","poem":1},{"text":"сећање на праведника трајаће довека.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Он не стрепи пред лошим вестима,","poem":1},{"text":"поузданог срца у Господа се узда.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Прибраног је срца, не страхује","poem":1},{"text":"док не заликује над душманима својим.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Он нештедимице дели,","poem":1},{"text":"даје сиротињи,","poem":2},{"text":"праведност његова остаје довека;","poem":1},{"text":"рог ће му се у части уздићи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Видеће то злотвор, озлоједиће се,","poem":1},{"text":"шкрипаће зубима и гришће се;","poem":2},{"lineBreak":true},{"text":"пропашће жудња злотвора!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}