{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"Славите Господа!","poem":1},{"lineBreak":true},{"text":"О, славите, слуге Господње,","poem":1},{"text":"славите име Господње!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Нек име Господње прослављано буде","poem":1},{"text":"од сад па довека!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Од изласка сунца па до његовог заласка,","poem":1},{"text":"прослављано било име Господње!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Над свим народима узвишен је Господ,","poem":1},{"text":"слава му је врх небеса.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ко је као Господ, Бог наш,","poem":1},{"text":"што столује у висини;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"што се сагне да погледа","poem":1},{"text":"и по небу и по земљи?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Сиромаха диже из прашине,","poem":1},{"text":"из буњишта диже убогога;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"да га посади с племићима,","poem":1},{"text":"с племићима његовог народа.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Од нероткиње у кући","poem":1},{"text":"чини срећну мајку деце.","poem":2},{"lineBreak":true},{"text":"Славите Господа!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}