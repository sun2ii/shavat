{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"Када је из Египта изашао Израиљ,","poem":1},{"text":"дом Јаковљев из народа туђинског језика,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Јуда је постао његово Светилиште","poem":1},{"text":"и Израиљ царство његово.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Видело то море, па устукну,","poem":1},{"text":"а и Јордан потече уназад.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ко овнови поскакаше горе","poem":1},{"text":"и брежуљци попут јагањаца.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Море, што си утекло?","poem":1},{"text":"Јордане, што си уназад потекао?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Горе, што скачете ко овнови","poem":1},{"text":"и ви, брежуљци, попут јагањаца?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Пред Господом потреси се, земљо,","poem":1},{"text":"пред Јаковљевим Богом;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"што претвара стену у језеро,","poem":1},{"text":"кремен-камен у свој извор воде.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}