t":"Предуго сам боравио","poem":1},{"text":"са онима што мир мрзе.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ја сам миру предан,","poem":1},{"text":"али чим бих да говорим,","poem":2},{"lineBreak":true},{"text":"они би да зарате.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}