{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["Песма поклоничка."]},{"type":"verse","number":1,"content":[{"text":"Они што се у Господа уздају,","poem":1},{"text":"јесу као гора Сион – постојана,","poem":2},{"lineBreak":true},{"text":"довека се помакнути не да!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Попут гора што Јерусалим окружују,","poem":1},{"text":"тако је и Господ око свог народа,","poem":2},{"lineBreak":true},{"text":"све од сада па за вечност целу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Уистину, неће жезло злочинаца владати","poem":1},{"text":"над земљом што припада праведнима;","poem":2},{"text":"да праведни руке своје не би","poem":1},{"text":"неправди пружали.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"О, Господе, добро чини добрима","poem":1},{"text":"и онима честитога срца!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"А оне што на своје криве стазе скрећу,","poem":1},{"text":"Господ ће одагнати са злотворима.","poem":2},{"lineBreak":true},{"text":"Мир Израиљу!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}