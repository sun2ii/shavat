{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["Песма поклоничка."]},{"type":"verse","number":1,"content":[{"text":"Кад је Господ прогнанике на Сион враћао,","poem":1},{"text":"било нам је као да сањамо!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Уста су нам праскала од смеха,","poem":1},{"text":"језик нам је клицао","poem":2},{"text":"када се међу народима причало:","poem":1},{"text":"„Њима је Господ велико дело учинио!“","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Господ нам је велико дело учинио","poem":1},{"text":"и како смо само раздрагани били!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"О, Господе, срећу нашу ти поврати","poem":1},{"text":"ко брзаке на испуцалу земљу!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Они који са сузама сеју,","poem":1},{"text":"жању са клицањем.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Плачући иде човек","poem":1},{"text":"и зобницу са семеном носи,","poem":2},{"text":"али ће се вратити сигурно,","poem":1},{"text":"и клицаће, своје снопље","poem":2},{"lineBreak":true},{"text":"док буде носио!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}