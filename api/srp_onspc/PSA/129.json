{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["Песма поклоничка."]},{"type":"verse","number":1,"content":[{"text":"„Много су ме тлачили још од како млад сам био“ –","poem":1},{"text":"нек каже Израиљ –","poem":2}]},{"type":"verse","number":2,"content":[{"text":"„Много су ме тлачили још од како млад сам био,","poem":1},{"text":"а ипак ме нису надвладали.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Преко мојих леђа су орали орачи","poem":1},{"text":"своје дуге бразде.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Праведан је Господ,","poem":1},{"text":"пресекао је конопце злотвора!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Нек се стиде, нек устукну","poem":1},{"text":"сви што Сион мрзе.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Нек су као трава по крововима,","poem":1},{"text":"која свене пре него се почупа;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"која жетеоцу руку не испуни,","poem":1},{"text":"ни наручје оном који снопље веже.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"А ни пролазници нек не кажу:","poem":1},{"text":"„Благословени од Господа да сте!","poem":2},{"lineBreak":true},{"text":"Благосиљамо вас у Господње име!“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}