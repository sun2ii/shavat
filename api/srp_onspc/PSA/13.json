{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["Хоровођи. Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"Докле више, докле, о, Господе?","poem":1},{"text":"Зар ћеш ме ти ваздан заборављати?","poem":2},{"lineBreak":true},{"text":"Докле ћеш од мене своје лице крити?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Докле више да се питам у души,","poem":1},{"text":"и сваки дан у срцу тугујем?","poem":2},{"lineBreak":true},{"text":"Докле ће душманин да буде нада мном?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Погледај, услиши ме, Господе,","poem":1},{"text":"Боже мој, очи ми просветли,","poem":2},{"lineBreak":true},{"text":"да у сан смртни ја не утонем,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"да не каже непријатељ:","poem":1},{"text":"„Ја сам га надјачао“,","poem":2},{"lineBreak":true},{"text":"и противници не ликују нада мном.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"А ја ћу се у твоју милост уздати,","poem":1},{"text":"твоме се спасењу у срцу радовати.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Певаћу Господу, јер ми је био добростив.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}