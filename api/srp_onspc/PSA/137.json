{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"Седели смо тамо, поред река Вавилона","poem":1},{"text":"и плакали кад би се сетили Сиона.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"О тамошње смо врбе","poem":1},{"text":"повешали харфе своје,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"јер су наши тлачитељи од нас захтевали песму;","poem":1},{"text":"мучитељи наши да се веселимо:","poem":2},{"lineBreak":true},{"text":"„Певајте нам песму о Сиону!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Како да певамо Господњу песму","poem":1},{"text":"у туђинској земљи?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"О, Јерусалиме, ако бих тебе заборавио,","poem":1},{"text":"заборављена била и десница моја!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Језик ми се за непце слепио","poem":1},{"text":"ако те се не сетио,","poem":2},{"text":"ако се не радовао Јерусалиму","poem":1},{"text":"више него и најбољем своме!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"О, Господе, сети се Едомаца","poem":1},{"text":"што су на дан пада Јерусалима говорили:","poem":2},{"lineBreak":true},{"text":"„Разваљујте! Разваљујте га до темеља!“","poem":2}]},{"type":"verse","number":8,"content":[{"text":"О, ћерко вавилонска,","poem":1},{"text":"што ћеш бити разорена!","poem":2},{"text":"Благо оном који ти узврати истом мером,","poem":1},{"text":"онако како си чинила нама.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Благо оном ко ти нејач зграби","poem":1},{"text":"и о стену смрска!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}