{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["За хоровођу. Давидов псалам."]},{"type":"verse","number":1,"content":[{"text":"Безумник у свом срцу каже:","poem":1},{"text":"„Нема Бога!“","poem":2},{"text":"Дела су им опака и гадна,","poem":1},{"text":"нема никога да чини добро.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Господ с неба гледа потомке људи,","poem":1},{"text":"да види има ли разумнога,","poem":2},{"lineBreak":true},{"text":"таквога који тражи Бога.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Од Бога се сви одвратише,","poem":1},{"text":"покварени сви постадоше;","poem":2},{"text":"нема тога који чини добро,","poem":1},{"text":"таквога ниједнога нема.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Зар не знају сви ти зликовци,","poem":1},{"text":"да мој народ као хлеб прождиру,","poem":2},{"lineBreak":true},{"text":"а ни самог Господа не призивају?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ту ће њих страх силни спопасти,","poem":1},{"text":"јер је Бог с родом праведничким.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ругате се оном што убоги мисли,","poem":1},{"text":"али уточиште је њему у Господу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ко ће са Сиона дати спасење Израиљу?","poem":1},{"text":"Када Господ врати свој народ изгнани,","poem":2},{"text":"радоваће се Јаков,","poem":1},{"text":"веселиће се Израиљ.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}