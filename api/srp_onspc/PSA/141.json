{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"О, Господе, теби вапим: брзо мени дођи,","poem":1},{"text":"глас ми почуј када те дозивам!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Молитва моја нек пред тобом као тамјан буде,","poem":1},{"text":"моје руке подигнуте ко вечерњи принос.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"О, Господе, пред уста ми стражу стави,","poem":1},{"text":"чувај врата усана мојих!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Моме срцу не дај злој речи да скрене,","poem":1},{"text":"да се предам злоби са злобним људима;","poem":2},{"lineBreak":true},{"text":"не дај да се сладим сластима њиховим.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Нек праведник милошћу удара ме;","poem":1},{"text":"нек ме кори, нек ми глава не одбије уље одабрано;","poem":2},{"text":"још увек се молим","poem":1},{"text":"против злих дела злотвора.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Низ литицу бацише их њихове судије","poem":1},{"text":"што су чуле речи моје,","poem":2},{"lineBreak":true},{"text":"јер су милозвучне.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ко кад неко оре и по земљи рије,","poem":1},{"text":"расуте су кости наше све до ждрела Света мртвих.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"А ја теби, о, Господе Боже,","poem":1},{"text":"очи своје дижем;","poem":2},{"text":"ти си моје уточиште,","poem":1},{"text":"душу моју не сатири!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Чувај ме, да ме не зграби замка","poem":1},{"text":"што су ми је поставили","poem":2},{"lineBreak":true},{"text":"и клопке злочинаца.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"У мреже своје нек падну злобници,","poem":1},{"text":"а ја нек их прођем!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}