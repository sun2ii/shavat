{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"О, Господе, чуј молитву моју","poem":1},{"text":"и послушај преклињања моја!","poem":2},{"text":"Услиши ме по верности,","poem":1},{"text":"по праведности својој.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Са слугом својим немој на суд ићи,","poem":1},{"text":"јер пред тобом нема живог,","poem":2},{"lineBreak":true},{"text":"а да је праведан.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Јер душманин душу моју гони,","poem":1},{"text":"живог ме о земљу ломи;","poem":2},{"text":"тера ме да живим по мрачним местима,","poem":1},{"text":"као оне што су одавно покојни.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Клонуо је дух мој у мени,","poem":1},{"text":"срце ми је уцвељено у грудима!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Прохујалих дана присећам се,","poem":1},{"text":"уносим се у сва твоја дела","poem":2},{"lineBreak":true},{"text":"и разматрам дело твојих руку.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Руке своје к теби ширим,","poem":1},{"text":"душа моја те је жедна","poem":2},{"lineBreak":true},{"text":"као земља сува. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Пожури се, услиши ме!","poem":1},{"text":"О, Господе, дух мој копни!","poem":2},{"text":"Лице своје од мене не скривај,","poem":1},{"text":"да не будем попут оних што иду у раку.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Кад је јутро објави ми своју милост,","poem":1},{"text":"јер у тебе уздајем се;","poem":2},{"text":"објави ми пут којим ћу поћи","poem":1},{"text":"јер је моја душа тебе жељна.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"О, Господе, избави ме од душмана мојих!","poem":1},{"text":"К теби бежим да се скријем.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Поучи ме да по твојој вољи чиним,","poem":1},{"text":"јер Бог мој ти си;","poem":2},{"text":"ти си доброг духа,","poem":1},{"text":"поведи ме где је земља равна.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"О, Господе, због имена свога","poem":1},{"text":"сачувај ме живог!","poem":2},{"text":"Праведношћу својом душу моју","poem":1},{"text":"од невоље спаси.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"По милости својој","poem":1},{"text":"затри противнике моје;","poem":2},{"text":"искорени све душмане душе моје,","poem":1},{"text":"јер ја сам твој слуга!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}