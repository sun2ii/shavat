{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"Славите Господа!","poem":1},{"lineBreak":true},{"text":"Душо моја, прослављај Господа!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Господа ћу прослављати докле живим,","poem":1},{"text":"док ме има Богу своме певаћу похвале!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Не уздајте се у владаре, у човеков изданак,","poem":1},{"text":"јер у њему избављења нема.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Напусти га дух његов, у земљу се враћа","poem":1},{"text":"и тог дана пропадне му што је наумио.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Благо оном ком помаже Бог Јаковљев;","poem":1},{"text":"оном што се Господу, Богу нада!","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Он је створио небо, земљу","poem":1},{"text":"и море и све што је у њима;","poem":2},{"lineBreak":true},{"text":"он истине довека се држи.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Потлаченим он праведно узвраћа","poem":1},{"text":"и гладнима храну даје;","poem":2},{"text":"Господ ослобађа утамничене.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Господ слепима очи отвара,","poem":2},{"text":"Господ подиже понижене,","poem":1},{"text":"Господ воли праведнике.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Господ штити придошлице,","poem":1},{"text":"олакшава сирочету и удовици,","poem":2},{"lineBreak":true},{"text":"а пут зликовцима осујећује.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Довека владаће Господ,","poem":1},{"text":"твој Бог, Сионе, кроз нараштај сваки!","poem":2},{"lineBreak":true},{"text":"Славите Господа!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}