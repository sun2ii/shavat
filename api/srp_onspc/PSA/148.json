{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"Славите Господа!","poem":1},{"lineBreak":true},{"text":"Славите Господа са небеса,","poem":1},{"text":"славите га на висинама!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"О, анђели сви његови, славите га,","poem":1},{"text":"славите га, све војске његове!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Славите га, сунце и месече,","poem":1},{"text":"славите га, све блиставе звезде!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Славите га, небеса највиша,","poem":1},{"text":"и ви, воде врх небеса!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Нек Господње име славе,","poem":1},{"text":"јер он заповеди и они посташе.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"За сву вечност њих је поставио,","poem":1},{"text":"уредбу је дао која проћи неће.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ви са земље славите Господа –","poem":1},{"text":"немани морске и дубино свака;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"громе и граде, снеже и магло,","poem":1},{"text":"олујо што реч његову остварујеш;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"горе и сва брда, свако стабло родно","poem":1},{"text":"и сви кедрови;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"звери и сва стоко,","poem":1},{"text":"гмизавци и птице крилате;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"земаљски цареви и сви људи,","poem":1},{"text":"главари и владари земље;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"младићи, а и девојке;","poem":1},{"text":"стари са младима!","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Нек Господње име славе,","poem":1},{"text":"јер само је његово име узвишено;","poem":2},{"lineBreak":true},{"text":"величанство му је и над земљом и над небесима!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Свом народу он ће рог уздићи –","poem":1},{"text":"славу сваког који му је веран –","poem":2},{"lineBreak":true},{"text":"народу израиљском, народу њему блиском.","poem":2},{"lineBreak":true},{"text":"Славите Господа!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}