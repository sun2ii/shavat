{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["Хоровођи. Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"Нека те Господ услиши у дан невоље,","poem":1},{"text":"нека те име Бога Јаковљевог штити.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Нека ти пошаље помоћ из Светиње,","poem":1},{"text":"са Сиона нека те подупре.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Нека се сети свих твојих приноса,","poem":1},{"text":"и свеспалницу твоју нека прими. Села","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Нека ти да што ти срце хоће,","poem":1},{"text":"и сваку замисао твоју нека испуни.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"А ми ћемо клицати ради твог спасења,","poem":1},{"text":"и у име Бога нашега дизати заставе.","poem":2},{"lineBreak":true},{"text":"Нека Господ испуни све твоје молбе.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Сада знам да Господ спасава свога помазаника,","poem":1},{"text":"и услишава га са свог светог неба,","poem":2},{"lineBreak":true},{"text":"силним спасењем своје деснице.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Једни се хвале колима, други коњима,","poem":1},{"text":"а ми именом Господа, Бога нашега.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Они посрћу и падају,","poem":1},{"text":"ми се дижемо и стојимо.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Господе, спаси цара,","poem":1},{"text":"услиши нас кад те призовемо!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}