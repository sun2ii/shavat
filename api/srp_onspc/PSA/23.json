{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"Господ је мени Пастир,","poem":1},{"text":"ни у чему ја не оскудевам.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"На зеленој паши одмара ме,","poem":1},{"text":"води ме на воде починка.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Душу моју опоравља,","poem":1},{"text":"води ме стазама праведности,","poem":2},{"lineBreak":true},{"text":"ради свог имена.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Па да и долином смртне сене ходам,","poem":1},{"text":"нећу се бојати зла, јер си ти са мном;","poem":2},{"lineBreak":true},{"text":"штап твој и палица твоја дају ми утеху.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ти простиреш сто преда мном","poem":1},{"text":"у присуству мојих душмана,","poem":2},{"text":"намазао си уљем главу моју,","poem":1},{"text":"и чаша се моја прелива.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Да, доброта и милост твоја","poem":1},{"text":"пратиће ме у све дане живота мога","poem":2},{"text":"и ја ћу становати у Дому Господњем","poem":1},{"text":"у данима многим.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}