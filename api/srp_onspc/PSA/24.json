{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"Господу припада земља и све што је на њој,","poem":1},{"text":"свет и сви који живе на њему.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Јер он га је утемељио на морима,","poem":1},{"text":"на водама га основао.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ко ће да се успне на гору Господњу?","poem":1},{"text":"Ко ће да стане на свето место његово?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Онај коме су руке недужне,","poem":1},{"text":"човек који има срце без мане,","poem":2},{"text":"чија душа не следи испразност,","poem":1},{"text":"и који се не заклиње лажно.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Он ће пожњети благослов од Господа,","poem":1},{"text":"и праведност од Бога, свог Спаситеља.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Такав је нараштај оних који га траже,","poem":1},{"text":"који траже лице твоје, Боже Јаковљев. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Дигните, о, врата, своје надвратнике,","poem":1},{"text":"дигните се, двери вечне,","poem":2},{"lineBreak":true},{"text":"да уђе Цар славе.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ко је тај Цар славе?","poem":1},{"text":"Господ јак и јуначан,","poem":2},{"lineBreak":true},{"text":"Господ силан у боју.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Дигните, о, врата, своје надвратнике,","poem":1},{"text":"дигните се, двери вечне,","poem":2},{"lineBreak":true},{"text":"да уђе Цар славе.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ко је тај Цар славе?","poem":1},{"text":"Господ над војскама,","poem":2},{"lineBreak":true},{"text":"он је тај Цар славе. Села","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}