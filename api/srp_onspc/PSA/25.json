{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["Давидов."]},{"type":"verse","number":1,"content":[{"text":"К теби, Господе, уздижем душу своју,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"у тебе се поуздајем, мој Боже,","poem":1},{"text":"не дај да се осрамотим;","poem":2},{"lineBreak":true},{"text":"не дај да душмани моји ликују нада мном.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Неће се стидети ни један од оних","poem":1},{"text":"који у тебе наду своју полажу;","poem":2},{"text":"стидеће се они","poem":1},{"text":"који своју веру крше без разлога.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Објави ми, Господе, своје путеве,","poem":1},{"text":"научи ме својим стазама.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Води ме својом истином, учи ме,","poem":1},{"text":"јер ти си мој Бог, мој Спаситељ,","poem":2},{"lineBreak":true},{"text":"теби се надам поваздан.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Сети се, Господе, милосрђа","poem":1},{"text":"и милости своје, јер су од вечности.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Не сећај се греха моје младости,","poem":1},{"text":"ни мојих преступа;","poem":2},{"text":"сећај ме се по милости својој,","poem":1},{"text":"ради своје доброте, Господе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Господ је добар и праведан,","poem":1},{"text":"зато показује пут грешницима.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Он води понизне по правди,","poem":1},{"text":"и учи понизне своме путу.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Све стазе Господње милост су и истина,","poem":1},{"text":"онима што чувају савез његов и прописе.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Опрости ми кривицу, јер је велика,","poem":1},{"text":"ради свога имена, Господе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ко је човек што се боји Господа?","poem":1},{"text":"Он ће га упутити на пут, који он изабра за њега.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Душа ће му почивати у добру,","poem":1},{"text":"а семе му наследити земљу.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Присан је Господ с онима","poem":1},{"text":"који га се боје,","poem":2},{"lineBreak":true},{"text":"њима свој савез обзнањује.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Стално очи упирем ка Господу,","poem":1},{"text":"јер ми ноге из мреже извлачи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Окрени се к мени, смилуј ми се,","poem":1},{"text":"јер сам усамљен и јадан.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Множе се муке срца мога;","poem":1},{"text":"извуци ме из мојих невоља.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Погледај на моју муку и патњу,","poem":1},{"text":"и опрости све грехе моје.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Погледај колико је душмана мојих,","poem":1},{"text":"који мене мрзе из дубине душе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Чувај моју душу, избави ме,","poem":1},{"text":"не дај да се постидим,","poem":2},{"lineBreak":true},{"text":"јер у теби нађох уточиште.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Нека ме недужност и поштење чувају,","poem":1},{"text":"јер сам своју наду ставио у тебе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Откупи, Боже, Израиљ,","poem":1},{"text":"од свих његових невоља.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}