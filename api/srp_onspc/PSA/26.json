{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["Давидов."]},{"type":"verse","number":1,"content":[{"text":"Оправдај ме, Господе,","poem":1},{"text":"јер сам живео у недужности,","poem":2},{"text":"у Господа сам се поуздао,","poem":1},{"text":"поколебао се нисам.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Истражи ме, Господе, искушај ме,","poem":1},{"text":"испитај ми и нутрину и срце.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ход свој управљам по твојој истини,","poem":1},{"text":"јер ми је твоја милост пред очима.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ја не седим с лажљивцима,","poem":1},{"text":"с лицемерима се ја не дружим.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ја мрзим збор зликоваца,","poem":1},{"text":"с опакима нећу ни да седнем.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Руке перем у својој невиности,","poem":1},{"text":"и идем око твог жртвеника, Господе,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"да гласно уздигнем глас хвалоспева,","poem":1},{"text":"и другима причам о свим твојим чудима.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Волим, Господе, Пребивалиште твоје,","poem":1},{"text":"место у коме пребива твоја слава.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Не погуби моју душу с грешницима,","poem":1},{"text":"ни мој живот с људима крволочним;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"на рукама је њима безакоње,","poem":1},{"text":"а десница пуна им је мита.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"А ја ћу ходати у недужности;","poem":1},{"text":"откупи ме, смилуј ми се!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Моја нога стоји на равном месту:","poem":1},{"text":"на зборовима благосиљаћу Господа.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}