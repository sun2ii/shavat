{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["Давидов."]},{"type":"verse","number":1,"content":[{"text":"К теби, Господе, вапим, стено моја,","poem":1},{"text":"не буди глув према мени,","poem":2},{"text":"да неуслишен не будем","poem":1},{"text":"као они што у раку силазе.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Почуј глас мога преклињања","poem":1},{"text":"кад завапим к теби,","poem":2},{"text":"кад подигнем руке своје","poem":1},{"text":"к твом најсветијем месту.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Не одведи ме с опакима,","poem":1},{"text":"с онима који чине безакоње.","poem":2},{"text":"Они причају благо с ближњима својим,","poem":1},{"text":"а у срцу злоба им почива.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Врати им по делима њиховим,","poem":1},{"text":"и по њиховим злим поступцима.","poem":2},{"text":"Плати им по делима руку њихових,","poem":1},{"text":"ти им врати што су заслужили.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Пошто не маре за дела Господња,","poem":1},{"text":"нити за дела руку његових,","poem":2},{"lineBreak":true},{"text":"срушиће их, подићи их неће.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Нека је благословен Господ,","poem":1},{"text":"јер је чуо глас мога преклињања.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Господ је моја снага и мој штит,","poem":1},{"text":"у њега се поуздаје моје срце.","poem":2},{"text":"Он ми је помогао, па ми кличе срце,","poem":1},{"text":"својом песмом даваћу му хвале.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Господ је снага свом народу,","poem":1},{"text":"тврђава спасења свом помазанику.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Спаси свој народ! Благослови своје наследство!","poem":1},{"text":"Напасај га и носи заувек!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}