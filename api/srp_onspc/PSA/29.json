{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"Дајте славу Господу, синови Божији,","poem":1},{"text":"дајте Господу славу и силу,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"дајте Господу славу имена његовог,","poem":1},{"text":"клањајте се Господу у величанству светиње његове.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Глас је Господњи над водама,","poem":1},{"text":"он то тутњи, он, Бог славе,","poem":2},{"lineBreak":true},{"text":"он, Господ, над многим водама.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Глас је Господњи силан,","poem":1},{"text":"глас је Господњи величанствен.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Глас Господњи ломи кедрове,","poem":1},{"text":"Господ ломи кедрове ливанске.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Од њега поскакују као теле,","poem":1},{"text":"а Ливан и Сирјон","poem":2},{"noteId":4},{"text":"као биволче.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Глас Господњи сипа муње огњене,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"глас Господњи потреса пустињу,","poem":1},{"text":"тресе Господ пустињу кадиску.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Од гласа Господњег кошуте се младе,","poem":1},{"text":"шумама он скида кору са стабала,","poem":2},{"lineBreak":true},{"text":"а у Дому његовом сви говоре „Слава!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Господ столује над потопом,","poem":1},{"text":"Господ столује као Цар довека.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Господ даје силу свом народу,","poem":1},{"text":"Господ миром благосиља свој народ.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"29,6 Друго име горе Ермон, види 5. Мој 3,9.","reference":{"chapter":29,"verse":6}}]},"thisChapterLink":"/api/srp_onspc/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}