{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов, кад је бежао пред својим сином Авесаломом."]},{"type":"verse","number":1,"content":[{"text":"Господе, колико ли је мојих противника,","poem":1},{"text":"колико ли је оних што устају на мене!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Много је оних што о мени кажу:","poem":1},{"text":"„Нема њему спасења од Бога.“ Села","poem":2},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"А ти, Господе, штит си око мене,","poem":1},{"text":"славо моја, ти ми главу дижеш!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Гласом својим призивам Господа,","poem":1},{"text":"одговара он ми с горе своје свете. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ја лежем и спавам, и опет се будим,","poem":1},{"text":"јер Он, Господ, пружа ми ослонац.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Не бојим се ни хиљада људи,","poem":1},{"text":"што одасвуд надиру на мене.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Устани, Господе,","poem":1},{"text":"спаси ме, мој Боже;","poem":2},{"text":"све душмане моје удари у браду,","poem":1},{"text":"опакима све зубе поломи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Спасење припада Господу,","poem":1},{"lineBreak":true},{"text":"твој благослов на твом је народу. Села","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"3,2 Јеврејски музички појам несигурног значења који се у Септуагинти преводи као прекид, пауза.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/srp_onspc/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}