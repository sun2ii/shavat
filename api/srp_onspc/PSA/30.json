{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов. Песма за посвећење храма."]},{"type":"verse","number":1,"content":[{"text":"Узвисујем те, Господе, јер си ме подигао,","poem":1},{"text":"ниси дао да се душмани нада мном радују.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Теби завапих, Господе, Боже мој,","poem":1},{"text":"и ти си ме исцелио.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Господе, из Света мртвих ти си ме извео,","poem":1},{"text":"моју си душу спасао од раке.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Запојте Господу, верни његови,","poem":1},{"text":"хвалите га, спомињите светост његову.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Јер гнев његов траје за трен,","poem":1},{"text":"а читав живот милост његова.","poem":2},{"text":"Вече доноси плач,","poem":1},{"text":"а јутро клицање.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"У свом спокојству рекао сам себи:","poem":1},{"text":"„Никада ме ништа неће уздрмати.“","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Милошћу си ме својом, Господе,","poem":1},{"text":"учврстио као моћну гору;","poem":2},{"text":"кад си лице своје сакрио,","poem":1},{"text":"свега ме је страх обузео.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"К теби вапим, Господе,","poem":1},{"text":"од свога Бога тражим милост.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"„Каква корист од моје смрти,","poem":1},{"text":"ако сиђем у раку?","poem":2},{"text":"Хоће ли те прах прослављати?","poem":1},{"text":"Зар ће прах о твојој верности да прича?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Почуј, Господе, смилуј ми се,","poem":1},{"text":"буди моја помоћ, о, Господе!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Мој си плач окренуо у коло,","poem":1},{"text":"скинуо си с мене рухо жалости,","poem":2},{"lineBreak":true},{"text":"и у рухо ме радости обукао.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Зато те душа моја слави без престанка.","poem":1},{"text":"О, Господе, Боже мој, хвалићу те вечно!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}