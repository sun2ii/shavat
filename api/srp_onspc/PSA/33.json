{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"Ускликните у Господу, праведни,","poem":1},{"text":"славити га приличи поштенима.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Хвалите Господа харфом,","poem":1},{"text":"свирајте му на лири од десет струна,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Певајте му нову песму,","poem":1},{"text":"свирајте складно уз клицање.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Јер права је реч Господња,","poem":1},{"text":"доследан је он у сваком делу своме.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Он воли праведност и правду,","poem":1},{"text":"пуна је земља милости Господње.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Речју Господњом небеса су створена,","poem":1},{"text":"и дахом уста његових сва војска њихова.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Он сабире воде морске као гомилу,","poem":1},{"text":"дубине он ставља у складишта.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Цела земља нек се боји Господа,","poem":1},{"text":"нек стрепе пред њим сви житељи света.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Јер он рече, и све постаде,","poem":1},{"text":"он нареди, и све се створи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Господ разбија намере пуцима,","poem":1},{"text":"и ремети науме народима.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Намера Господња остаје довека,","poem":1},{"text":"мисли срца његовог од колена до колена.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Благо народу коме је Бог Господ,","poem":1},{"text":"народу који изабра себи за баштину.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Господ посматра са небеса,","poem":1},{"text":"он све људе види.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Из свог боравишта","poem":1},{"text":"он мотри све житеље земље,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"он обликује срце њихово,","poem":1},{"text":"он прониче сва њихова дела.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Не спасава цара војска многобројна,","poem":1},{"text":"силна снага не избавља јунака.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Залудно је у коњу тражити спасење,","poem":1},{"text":"велика сила неће га избавити.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Око је Господње над онима што га се боје,","poem":1},{"text":"над онима који очекују милост његову,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"да им душу од смрти избави,","poem":1},{"text":"живот им сачува у време глади.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Наша душа чека на Господа;","poem":1},{"text":"он је наша помоћ, штит наш.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"У њему се срце наше радује,","poem":1},{"text":"јер се уздамо у свето име његово.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Нека милост твоја буде над нама, Господе,","poem":1},{"text":"јер смо наду своју положили у тебе.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}