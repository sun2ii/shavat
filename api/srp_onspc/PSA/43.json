{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"Досуди ми правду, Боже,","poem":1},{"text":"одбрани мој спор од безбожног света,","poem":2},{"lineBreak":true},{"text":"избави ме од човека подлог и неправедног.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Јер ти си Бог мој, тврђава моја.","poem":1},{"text":"Зашто си ме одбацио?","poem":2},{"text":"Зашто идем около у жалости","poem":1},{"text":"под тлаком непријатеља мога?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Пошаљи светлост и истину твоју да ме воде,","poem":1},{"text":"да ме доведу на свету гору твоју,","poem":2},{"lineBreak":true},{"text":"и до места где ти пребиваш.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Приступићу тада к жртвенику Божијем,","poem":1},{"text":"к Богу радости и ужитка свог;","poem":2},{"lineBreak":true},{"text":"да те харфом хвалим, Боже, Боже мој.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Зашто си ми клонула, душо моја,","poem":1},{"text":"зашто уздишеш у мени?","poem":2},{"text":"Богу се надај, јер опет ћу га славити,","poem":1},{"text":"Спаситеља и Бога свог.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}