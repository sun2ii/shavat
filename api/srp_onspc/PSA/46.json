{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["Хоровођи. За потомке Корејеве. Песма за високе гласове."]},{"type":"verse","number":1,"content":[{"text":"Бог нам је уточиште и сила,","poem":1},{"text":"трајни помоћник у невољи.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Не бојмо се, зато, кад се земља љуља,","poem":1},{"text":"кад се горе руше у дубине мора.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ма, нек буче и пене се његове воде,","poem":1},{"text":"нек се горе тресу од његове силе. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Тече река и њене притоке,","poem":1},{"text":"граду Божијем радост доносе,","poem":2},{"lineBreak":true},{"text":"светом месту где Свевишњи живи.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Бог је усред њега, помаћи се неће,","poem":1},{"text":"Бог ће му помоћи у сам освит јутра.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Буне се народи, пропадају царства,","poem":1},{"text":"кад глас повиси земља се раствара.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"С нама је Господ над војскама,","poem":1},{"text":"Бог Јаковљев наша је тврђава. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Дођите, размотрите дела Господња,","poem":1},{"text":"који пустош по земљи оставља.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Он прекида ратове до на крај земље,","poem":1},{"text":"лук крши, копље прелама,","poem":2},{"lineBreak":true},{"text":"бојна кола огњу изручује.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Утихните и знајте да сам ја Бог,","poem":1},{"text":"узвишен међу народима,","poem":2},{"lineBreak":true},{"text":"узвишен на земљи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"С нама је Господ над војскама,","poem":1},{"text":"Бог Јаковљев наша је тврђава. Села","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}