{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["Хоровођи. Псалам потомака Корејевих."]},{"type":"verse","number":1,"content":[{"text":"Сви народи, запљескајте длановима;","poem":1},{"text":"кличите Богу веселим узвиком!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Јер је страшан Свевишњи Господ,","poem":1},{"text":"цар велики над свом земљом.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Он нам је покорио народе","poem":1},{"text":"и људе под ноге наше.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Наследство је за нас одабрао,","poem":1},{"text":"понос за Јакова кога воли. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Подиже се Бог уз поклик;","poem":1},{"text":"Господ, уз звук трубе.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Певајте славопоје Богу,","poem":1},{"text":"певајте славопоје;","poem":2},{"text":"певајте славопоје цару нашем,","poem":1},{"text":"певајте славопоје.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Јер, Бог је цар целе земље;","poem":1},{"text":"певајте песму поучну.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Бог влада над народима,","poem":1},{"text":"Бог столује на престолу свом светом.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Племићи народа се окупљају,","poem":1},{"text":"са народом Бога Аврахамовог;","poem":2},{"text":"Божији су штитови земље","poem":1},{"text":"и он је преузвишен.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}