{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["Песма. Псалам потомака Корејевих."]},{"type":"verse","number":1,"content":[{"text":"Велик је Господ,","poem":1},{"text":"многе хвале вредан,","poem":2},{"text":"у граду Бога нашег,","poem":1},{"text":"на његовој светој гори.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Прелепа је њена висина,","poem":1},{"text":"радост је целе земље;","poem":2},{"text":"гора Сион, на ивицама севера,","poem":1},{"text":"град је великог цара.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Бог је у утврђењима својим,","poem":1},{"text":"за заклон је себе обзнанио.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Јер, гле, цареви су окупљени,","poem":1},{"text":"заједно напредују.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"И кад су га видели, запањише се,","poem":1},{"text":"ужаснуше се и умакоше.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Трепет их је тамо обузео","poem":1},{"text":"и бол као породиљу.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ветром са истока","poem":1},{"text":"скршио си лађе тарсиске.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Као што смо чули,","poem":1},{"text":"тако смо и видели","poem":2},{"text":"у граду Господа над војскама,","poem":1},{"text":"у граду Бога нашега,","poem":2},{"lineBreak":true},{"text":"Бога који га је довека основао. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Боже, усред Дома твога размишљамо","poem":1},{"text":"о милости твојој.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Попут твог имена, Боже,","poem":1},{"text":"слава ти прелази крајеве земље,","poem":2},{"lineBreak":true},{"text":"десница ти обилује праведношћу.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Гора Сион нека се радује,","poem":1},{"text":"нека се веселе Јудина насеља","poem":2},{"lineBreak":true},{"text":"због твојих прописа.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Обиђите Сион,","poem":1},{"text":"око њега корачајте,","poem":2},{"lineBreak":true},{"text":"куле му пребројте;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"проверите његове зидине,","poem":1},{"text":"утврђења му прегледајте,","poem":2},{"text":"да поколењу новом","poem":1},{"text":"о томе причате.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Јер, ово је Бог,","poem":1},{"text":"наш Бог у веке векова;","poem":2},{"lineBreak":true},{"text":"он нас води и до смрти!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}