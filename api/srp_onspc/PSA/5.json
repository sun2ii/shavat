{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["Хоровођи, уз фруле: Давидов псалам."]},{"type":"verse","number":1,"content":[{"text":"О, Господе, почуј моје речи,","poem":1},{"text":"и размотри уздисаје моје.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Чуј мој вапај, царе мој и Боже,","poem":1},{"text":"јер теби своју управљам молитву.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Јутром, Господе, ти глас ми чујеш,","poem":1},{"text":"јутром теби приносим молитву,","poem":2},{"lineBreak":true},{"text":"нетремице пазим, ишчекујем.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Јер ти ниси Бог коме злочин прија,","poem":1},{"text":"зло не може твојим гостом бити.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Охоли ти на очи не могу изаћи,","poem":1},{"text":"мрзиш све што чине неправду.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ти затиреш оне што говоре лажи,","poem":1},{"text":"крвожедне и подмукле Господ не подноси.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"А ја ћу у Дом твој доћи,","poem":1},{"text":"по обилном твоме смиловању,","poem":2},{"text":"пред твојим ћу светим Домом бити,","poem":1},{"text":"у страху се теби поклонити.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Својом ме правдом води, Господе,","poem":1},{"text":"због мрзитеља који ми заседу спремају;","poem":2},{"lineBreak":true},{"text":"пут свој поравнај преда мном.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Истине им нема на уснама,","poem":1},{"text":"срце им је испуњено злобом,","poem":2},{"text":"гроб отворен грло је њихово,","poem":1},{"text":"а језик им ласка превртљиво.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"О, Боже, кривим их прогласи,","poem":1},{"text":"сплетке њихове нек их упропасте.","poem":2},{"text":"За грехе их многе изагнај,","poem":1},{"text":"јер на тебе они устадоше.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Нека се радују сви што у теби уточиште траже,","poem":1},{"text":"нека се довека веселе које ти заклањаш,","poem":2},{"lineBreak":true},{"text":"нека кличу они који име твоје љубе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Јер ти, Господе, благосиљаш праведног,","poem":1},{"text":"милошћу га као штитом заклањаш.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}