{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["Хоровођи на жичаним инструментима. Давидов."]},{"type":"verse","number":1,"content":[{"text":"Боже, чуј мој вапај;","poem":1},{"text":"молитву ми добро почуј.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ја те зовем са крајева земље","poem":1},{"text":"док ми срце клоне;","poem":2},{"lineBreak":true},{"text":"поведи ме на стену од мене вишу.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Јер ти си ми уточиште,","poem":1},{"text":"моћна кула испред противника.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"У шатору твоме","poem":1},{"text":"довека бих да пребивам,","poem":2},{"text":"уточиште да ми буде","poem":1},{"text":"заклон твојих крила. Села","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Јер ти си, Боже, чуо завете моје;","poem":1},{"text":"дао си ми наследство оних који стрепе од имена твога.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Цару дане на дане надодај,","poem":1},{"text":"година његових нека буде од нараштаја до нараштаја.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Нека га има довека пред Богом,","poem":1},{"text":"одреди му и милост и верност, нека га чувају.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Имену ћу твоме зато славопој да певам довека;","poem":1},{"text":"да испуним завете своје дан за даном.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}