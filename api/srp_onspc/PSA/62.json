{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["Хоровођи. За Једутуна. Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"Само у Богу душа моја почива,","poem":1},{"text":"од њега је спасење моје.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Само он је стена моја и спасење моје;","poem":1},{"text":"заклон мој, ништа мене неће уздрмати.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Докле ћете се обрушавати на човека?","poem":1},{"text":"Побиће вас, све вас,","poem":2},{"lineBreak":true},{"text":"попут зида накривљеног","poem":2},{"lineBreak":true},{"text":"и ограде полегнуте.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Зацело, договорише се","poem":1},{"text":"са висина његових да га оборе.","poem":2},{"text":"Они воле лаж,","poem":1},{"text":"па устима својим благосиљају,","poem":2},{"lineBreak":true},{"text":"а нутрином својом проклињу. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Само се у Богу смири, душо моја,","poem":1},{"text":"јер је од њега надање моје.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Само он је стена моја","poem":1},{"text":"и спасење моје;","poem":2},{"text":"заклон мој,","poem":1},{"text":"мене неће уздрмати.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Од Бога је спасење моје","poem":1},{"text":"и слава моја;","poem":2},{"lineBreak":true},{"text":"стена снаге моје,","poem":2},{"lineBreak":true},{"text":"уточиште моје је у Богу.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"У њега се уздај увек, народе;","poem":1},{"text":"пред њим срце своје изливајте,","poem":2},{"lineBreak":true},{"text":"Бог је наше уточиште. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Само су дах потомци људи,","poem":1},{"text":"лаж су потомци човекови;","poem":2},{"text":"на теразијама мерени заједно","poem":1},{"text":"они су од даха лакши.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Не уздајте се у отимачину","poem":1},{"text":"и у грабеж ташту наду не стављајте;","poem":2},{"text":"а богатство када се умножи,","poem":1},{"text":"срцем се за њега не везујте.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Бог је једно објавио,","poem":1},{"text":"а две ствари ја сам чуо:","poem":2},{"text":"да је сила једино Божија,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"да је милост једино Господња;","poem":2},{"text":"јер, ти узвраћаш човеку","poem":1},{"text":"по делу његовом.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}