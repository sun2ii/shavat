{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["Псалам Давидов. Када је био у јудејској пустињи."]},{"type":"verse","number":1,"content":[{"text":"Боже, мој Бог ти си","poem":1},{"text":"и ја тебе тражим.","poem":2},{"text":"Моја је душа тебе жедна,","poem":1},{"text":"тело је моје тебе жељно,","poem":2},{"text":"у земљи сувој,","poem":1},{"text":"огољеној и безводној.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Заиста, у Светињи сам те видео,","poem":1},{"text":"гледао ти и силу и славу.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Милост је твоја боља од живота,","poem":1},{"text":"усне моје величаће тебе.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Зато ћу те благосиљати кроз живот свој,","poem":1},{"text":"у име ћу твоје подизати руке своје.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Сита ће ми бити душа","poem":1},{"text":"ко од сала и обиља;","poem":2},{"text":"са весељем на уснама","poem":1},{"text":"уста моја прослављаће те.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"На постељи својој сетим те се,","poem":1},{"text":"о стражама ноћним размишљам о теби.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Јер си ти помоћ моја","poem":1},{"text":"у сенци крила твојих ја се веселим.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Уз тебе ми је душа прионула,","poem":1},{"text":"десница ме твоја подржава.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"А они жуде да ми душу упропасте,","poem":1},{"text":"они ће отићи у дубине земље.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Биће предани мачу,","poem":1},{"text":"биће храна лисицама.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"А цар ће се у Богу веселити,","poem":1},{"text":"хвалиће се свако ко се њиме закуне,","poem":2},{"lineBreak":true},{"text":"јер ће се затворити уста онима што говоре лажи.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}