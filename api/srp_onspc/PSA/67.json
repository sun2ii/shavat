{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["Хоровођи, уз жичане инструменте. Псалам. Песма."]},{"type":"verse","number":1,"content":[{"text":"Смиловао нам се Бог и благословио нас,","poem":1},{"text":"лицем својим обасјао нас; Села","poem":2}]},{"type":"verse","number":2,"content":[{"text":"да би се на земљи знало за пут твој,","poem":1},{"text":"за спасење твоје у свим народима.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Нек те хвале народи, о, Боже,","poem":1},{"text":"нек те хвале сви народи.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Нека се радују и нек се веселе људи,","poem":1},{"text":"јер праведно судиш народима","poem":2},{"lineBreak":true},{"text":"и водиш људе на земљи. Села","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Нек те хвале народи, о, Боже,","poem":1},{"text":"нек те хвале сви народи.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Земља рађа својим плодовима;","poem":1},{"text":"благословио нас Бог, Бог наш.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Благословио нас Бог","poem":1},{"text":"да би га се бојали сви крајеви земље.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}