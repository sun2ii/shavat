{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["Хоровођи. Давидов. За спомен."]},{"type":"verse","number":1,"content":[{"text":"Боже, избави ме! У помоћ ми пожури, Господе!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Нека се постиде,","poem":1},{"text":"нека се осрамоте ти што ми о глави раде.","poem":2},{"text":"Нека се повуку у срамоти,","poem":1},{"text":"нека буду понижени ти што им је мила невоља моја.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Нек устукну због срамоте своје","poem":1},{"text":"ти што довикују: „Аха! Аха!“","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Нек ликују и нек се радују у теби","poem":1},{"text":"сви који те траже;","poem":2},{"text":"нека увек говоре они што спасење твоје воле:","poem":1},{"text":"„Велик је Бог!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"А ја сам сиромах и убог,","poem":1},{"text":"Боже, пожури к мени.","poem":2},{"text":"Ти си моја помоћ и мој избавитељ.","poem":1},{"text":"О, Господе, не оклевај!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}