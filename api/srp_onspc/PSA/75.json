{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["Хоровођи. Напев: „Не погуби“. Псалам Асафов. Песма."]},{"type":"verse","number":1,"content":[{"text":"Хвалимо те, Боже,","poem":1},{"text":"хвалимо те, јер нам је име твоје блиско;","poem":2},{"lineBreak":true},{"text":"чудеса твоја спомиње народ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"„Ја одређујем заказано време,","poem":1},{"text":"ја подједнако судим.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Растапа се земља и сав њезин живаљ,","poem":1},{"text":"а ја стубове њене постављам. Села","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Бахатима кажем:","poem":1},{"text":"’Немојте се бахатити’;","poem":2},{"text":"и зликовцима:","poem":1},{"text":"’Рог свој не дижите.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Рог свој у висине не дижите,","poem":1},{"text":"дрско не причајте.’“","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Јер уздизање не долази ни са запада,","poem":1},{"text":"ни са истока, ни из пустиње;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"већ је Бог судија:","poem":1},{"text":"једног руши, једног диже.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ено, чаша је у Господњој руци","poem":1},{"text":"и вино пуно зачина се пени.","poem":2},{"text":"И излиће из ње, и заиста ће пити,","poem":1},{"text":"до талога искапиће је сви земаљски зликовци.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"О томе ћу довека да јављам,","poem":1},{"text":"певаћу похвале Богу Јаковљевом!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"„Све рогове зликовачке ја ћу да изломим,","poem":1},{"text":"а рогови праведника уздигнути биће.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}