{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["Хоровођи, уз жичане инструменте. Асафов псалам. Песма."]},{"type":"verse","number":1,"content":[{"text":"Бог је познат у Јуди,","poem":1},{"text":"име му је узвишено у Израиљу!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Салим му је конак,","poem":1},{"text":"на Сиону му стан.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Тамо је сломио стрелу запаљену,","poem":1},{"text":"штит и мач и справе ратничке. Села","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ти блисташ,","poem":1},{"text":"славнији си од тих брда са пленом.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Људи храброг срца су оплењени,","poem":1},{"text":"позаспаше;","poem":2},{"text":"јаки људи,","poem":1},{"text":"ал’ ни руку да подигну.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Заспаше довека од поклича твога,","poem":1},{"text":"о, Боже Јаковљев, и коњ и коњаник!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ти! Ти си страшан!","poem":1},{"text":"Кад се гневиш, ко пред тобом може да опстане?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Са небеса ти суд јављаш.","poem":1},{"text":"Земља се преплаши, онеми,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"кад устаје Бог да суди","poem":1},{"text":"и да спасе све понизне на земљи. Села","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Прослављаш се и људским гневом,","poem":1},{"text":"опасујеш се преживелима од гнева.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Заветујте се и завете извршите Господу, своме Богу;","poem":1},{"text":"сви који су око њега,","poem":2},{"lineBreak":true},{"text":"нек Страшноме дар донесу!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Владарима он дух обара,","poem":1},{"text":"од њега стрепе цареви земаљски!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}