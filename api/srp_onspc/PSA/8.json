{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["Хоровођи, „Радосница“. Псалам Давидов."]},{"type":"verse","number":1,"content":[{"text":"О, Господе, наш Боже,","poem":1},{"text":"како је узвишено име твоје по свој земљи!","poem":2},{"text":"Ти си хвалу себи","poem":1},{"text":"дао на небесима.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Са усана деце и дојенчади,","poem":1},{"text":"ти си себи моћ подигао","poem":2},{"text":"ради својих непријатеља;","poem":1},{"text":"да ућуткаш душманина и осветника.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Кад погледам твоја небеса,","poem":1},{"text":"које твоји прсти начинише,","poem":2},{"text":"месец и звезде које ти постави…","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Шта је човек да га се сећаш,","poem":1},{"text":"шта ли син човечији да бринеш за њега?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ти си га мало мањим од Бога учинио,","poem":1},{"text":"славом и чашћу њега си овенчао,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"дела руку својих у власт си му дао,","poem":1},{"text":"њему под ноге све си покорио:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"све овце и говеда,","poem":1},{"text":"и звериње пољско,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"птице небеске, и рибе морске,","poem":1},{"text":"што пливају морским стазама.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"О, Господе, наш Боже,","poem":1},{"text":"како је узвишено име твоје по свој земљи!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}