{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["Псалам Асафов."]},{"type":"verse","number":1,"content":[{"text":"Бог је стао у Божијем збору,","poem":1},{"text":"па сад суди међу боговима:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"„Докле ћете судити нечасно","poem":1},{"text":"и држати страну злотворима? Села","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Заступајте право убогога и сиротога,","poem":1},{"text":"оправдајте сиромаха и невољника.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Спасавајте слабог и тлаченог,","poem":1},{"text":"избавите их из руке зликоваца.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Али нису знали, нису разумели;","poem":1},{"text":"у тами су посртали","poem":2},{"lineBreak":true},{"text":"и темеље земљи задрмали.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ја рекох: ’Богови сте,","poem":1},{"text":"сви сте деца Свевишњега!’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ипак ћете помрети ко људи,","poem":1},{"text":"пропашћете ко и главар сваки.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Устани, Боже, и суди земљи,","poem":1},{"text":"јер сви су народи наследство твоје!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}