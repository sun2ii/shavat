{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["Псалам. Песма за дан суботњи."]},{"type":"verse","number":1,"content":[{"text":"Баш је добро хвалити Господа,","poem":1},{"text":"твом имену певати, Свевишњи;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"милост твоју ујутру јављати,","poem":1},{"text":"сваке ноћи верност твоју;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"лиром са десет струна","poem":1},{"text":"и харфином мелодијом!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Јер ти си ме, о, Господе,","poem":1},{"text":"обрадово делом својим;","poem":2},{"lineBreak":true},{"text":"кличем труду руку твојих.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Како су велика дела твоја, о, Господе!","poem":1},{"text":"Како су дубоки науми твоји.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Човек без памети не зна","poem":1},{"text":"и безумник ово не разуме;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Кад зликовци ничу као трава","poem":1},{"text":"и кад сваки злотвор цвета,","poem":2},{"lineBreak":true},{"text":"то је да би заувек пропали!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"А ти си довека узвишен, о, Господе!","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"О, Господе, ено твојих душмана;","poem":1},{"text":"ено твојих душмана, гину,","poem":2},{"lineBreak":true},{"text":"и сви што злобно раде биће одувани.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ти си мој рог уздигао као у бивола,","poem":1},{"text":"помазан сам свежим уљем.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Очима гледам по зидинама мојим","poem":1},{"text":"оне што се против мене дижу;","poem":2},{"lineBreak":true},{"text":"ушима својим слушам злотворе.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Као палма грана се праведник,","poem":1},{"text":"као кедар расте на Ливану!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Посађени у Дому Господњем","poem":1},{"text":"цветаће у двориштима Бога нашег.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Биће плодоносни и када остаре,","poem":1},{"text":"једри и зелени биће;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"и јављаће: праведан је Господ, стена моја,","poem":1},{"text":"неправде у њему нема!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}