text":"кроз дане многе.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}