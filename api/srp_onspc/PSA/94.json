{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"О, Боже освете!","poem":1},{"text":"Севни, Господе, Боже осветниче!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Устани, судијо земље,","poem":1},{"text":"па узврати бахатима истом мером.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Докле ће зликовци, о, Господе,","poem":1},{"text":"докле ће зликовци да ликују?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Брбљивци су, бахати хвалисавци","poem":1},{"text":"сви ти што опако раде.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Они сатиру твој народ, Господе,","poem":1},{"text":"и наследство твоје тлаче.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Убијају удовицу, дошљака","poem":1},{"text":"и сирочад кољу.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"И још кажу: „Господ не види,","poem":1},{"text":"не опажа Бог Јаковљев!“","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Размислите, ви свирепи људи! Будале!","poem":1},{"text":"Кад ћете се опаметити?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Не чује ли онај што је творац уха?","poem":1},{"text":"Не види ли онај што је творац ока?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Зар народе он да не кори?","poem":1},{"text":"Зар да не покара онај који људе знању учи?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Господ зна да су мисли човекове безвредне.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Благо ономе кога ти учиш, Господе,","poem":1},{"text":"кога поучаваш о Закону своме;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"да буде спокојан у данима патње,","poem":1},{"text":"док се за зликовца јама не ископа.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Јер Господ не оставља свој народ","poem":1},{"text":"и наследства свога он се не одриче.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Јер праведност се суду враћа","poem":1},{"text":"и следе је сва срца честита.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ко ће мене да заступа против зликоваца?","poem":1},{"text":"Ко ће против злочинаца уз мене да стане?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Да ми Господ није био помоћ,","poem":1},{"text":"убрзо би душа моја у гробу ћутала.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Када кажем – „Моја нога клеца!“ –","poem":1},{"text":"нек ме твоја милост окрепи, Господе!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Када су у мени самом многобројне бриге,","poem":1},{"text":"утехе ми твоје разгаљују душу.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Зар окрутни владари да ти буду савезници,","poem":1},{"text":"и они који крше заповести?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Уроту праве против душе праведника,","poem":1},{"text":"крв невиних осуде ко криву.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Господ ми је заклон на висини!","poem":1},{"text":"Мој је Бог стена уточишта!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Он ће њима да узврати за злобу њихову,","poem":1},{"text":"збрисаће их због зала њихових;","poem":2},{"lineBreak":true},{"text":"збрисаће их, Господ, Бог наш.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}