{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["Псалам."]},{"type":"verse","number":1,"content":[{"text":"Певајте Господу нову песму,","poem":1},{"text":"јер је чудеса учинио!","poem":2},{"text":"Десница му донесе победу","poem":1},{"text":"и мишица његова света.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Спасење је своје Господ обзнанио,","poem":1},{"text":"наочиглед народа је објавио праведност своју.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Сетио се своје милости","poem":1},{"text":"и своје верности према дому Израиљевом,","poem":2},{"text":"и сви су крајеви земље","poem":1},{"text":"видели спасење Бога нашег.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ускликни Господу, земљо сва!","poem":1},{"text":"Подвикујте, запевајте и засвирајте!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Засвирајте Господу уз харфу;","poem":1},{"text":"и уз харфу, и уз звуке песме.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Уз трубе, уз јеку рогова","poem":1},{"text":"ускликните пред царем Господом!","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Нека хучи море и све што је у њему,","poem":1},{"text":"свет и његови становници.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Нек рукама запљескају реке,","poem":1},{"text":"с њима горе нек радосно кличу","poem":2}]},{"type":"verse","number":9,"content":[{"text":"пред Господом;","poem":1},{"text":"јер долази да суди земљи,","poem":2},{"text":"да поштено суди свету","poem":1},{"text":"и људима по правди.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}