{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onspc","name":"Псалм","commonName":"Псалм","title":"Псалми","order":19,"numberOfChapters":150,"sha256":"e781be469581e49cc7285f7e41ec8b839f862458bc75ffb2be2327d1b0c97268","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onspc/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"Господ влада –","poem":1},{"text":"нек народи дрхте!","poem":2},{"text":"Над херувимима он седи –","poem":1},{"text":"нек се земља тресе!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Велики је Господ на Сиону,","poem":1},{"text":"узвишен је над свим народима.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Велико ти име нека славе,","poem":1},{"text":"јер је страшно –","poem":2},{"lineBreak":true},{"text":"он је свет!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Моћан је цар који воли правду;","poem":1},{"text":"Јакову си учврстио подједнако","poem":2},{"text":"и правду и праведност,","poem":1},{"text":"ти си то учинио.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Уздижите Господа, Бога нашег!","poem":1},{"text":"Поклоните се пред подножјем његових ногу,","poem":2},{"lineBreak":true},{"text":"јер је он свет.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Мојсије и Арон, свештеници његови;","poem":1},{"text":"Самуило, један од оних што су му се молили,","poem":2},{"text":"звали су Господа","poem":1},{"text":"и он их је услишио.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"У стубу од облака им је говорио,","poem":1},{"text":"а они су држали прописе","poem":2},{"lineBreak":true},{"text":"и уредбе које им је дао.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"О, Господе, Боже наш,","poem":1},{"text":"ти си их услишио!","poem":2},{"text":"Био си им Бог који опрашта","poem":1},{"text":"али и онај што кажњава њихова злодела.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Уздижите Господа, Бога нашег!","poem":1},{"text":"Поклоните се на његовој светој гори,","poem":2},{"lineBreak":true},{"text":"јер наш Господ, Бог је свети.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}