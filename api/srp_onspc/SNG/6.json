{"translation":{"id":"srp_onspc","name":"Biblica® Нови српски превод, слободна права","website":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponspc","licenseNotes":null,"shortName":"ONSPC","englishName":"Serbian ONSP Cyrillic","language":"srp","textDirection":"ltr","sha256":"6fe510ae04833ea773a40537f9528fb73da3ff5538252707a82d79f6c138ec48","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onspc/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"SNG","translationId":"srp_onspc","name":"Песма над песмама","commonName":"Песма над песмама","title":"Песма над песмама","order":22,"numberOfChapters":8,"sha256":"cf04a92ab927f4db7bd5e0aa7a6e7f28b3598f9c72eff525fba7922d3af1af8f","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onspc/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/srp_onspc/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Где је отишао вољени твој,","poem":1},{"text":"о, најлепша међу женама?","poem":2},{"text":"Куда се окренуо вољени твој","poem":1},{"text":"да га тражимо са тобом?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Вољени је мој сишао у врт свој,","poem":1},{"text":"на леје зачина,","poem":2},{"text":"да пасе по вртовима","poem":1},{"text":"и љиљане бере.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ја припадам моме вољеноме","poem":1},{"text":"и мени припада мој вољени","poem":2},{"lineBreak":true},{"text":"који пасе међу љиљанима.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Лепа си, вољена моја,","poem":1},{"text":"као Терса љупка и као Јерусалим,","poem":2},{"lineBreak":true},{"text":"страховита као војска с барјацима.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Очи своје с мене скрени","poem":1},{"text":"јер ме залуђују,","poem":2},{"text":"а коса ти је попут стада коза","poem":1},{"text":"што се спушта низ Галад.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Зуби су ти као стадо оваца","poem":1},{"text":"што долази са купања.","poem":2},{"text":"Свака од њих близанце носи","poem":1},{"text":"и јалове међу њима нема.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Као кришка нара","poem":1},{"text":"чело је твоје иза вела твога.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Нека је шездесет царица,","poem":1},{"text":"осамдесет иноча","poem":2},{"lineBreak":true},{"text":"и небројено младих жена;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ал’ је једна голубица моја без мане.","poem":1},{"text":"Она је љубимица мајке своје,","poem":2},{"lineBreak":true},{"text":"миљеница оне што је роди.","poem":2},{"text":"Виделе су је девојке и блаженом је прозвале,","poem":1},{"text":"а царице и иноче су је хвалиле.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ко је она што се јавља као зора,","poem":1},{"text":"лепа као пуни месец, ко сунце без мане,","poem":2},{"lineBreak":true},{"text":"страховита као војска с барјацима?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Сишао сам у орашњак,","poem":1},{"text":"прегледао изданке у долу,","poem":2},{"text":"да видим хоће ли да пропупи лоза","poem":1},{"text":"и нар да процвета.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ал’ ме душа, а да нисам знао,","poem":1},{"text":"посади на кола мојих великаша.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Врати се! Врати се, о, Суламко!","poem":1},{"text":"Врати се, врати да те погледамо!","poem":2},"Он",{"text":"Зашто да гледате у Суламку","poem":1},{"text":"као у игру два табора.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onspc/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onspc/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onspc/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}