{"translation":{"id":"srp_onstl","name":"Biblica® Novi srpski prevod, slobodna prava","website":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseNotes":null,"shortName":"ONSTL","englishName":"Serbian ONST Latin","language":"srp","textDirection":"ltr","sha256":"5b89923b317dd2bbf1ad867a0ad52c9ebc28275db904363e008c414350a5883d","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onstl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"ISA","translationId":"srp_onstl","name":"Knjiga proroka Isaije","commonName":"Knjiga proroka Isaije","title":"Knjiga proroka Isaije","order":23,"numberOfChapters":66,"sha256":"1c9e5a2e4e07df935afbb7f4fb0e5d9cdf2c9c148665c8bcb584d2e8c8ad8e29","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onstl/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/srp_onstl/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Tužbalica nad Moavcima"]},{"type":"verse","number":1,"content":["Proroštvo protiv Moava:",{"text":"„Obnoć je opustošen Ar;","poem":1},{"text":"srušen je Moav!","poem":2},{"text":"Obnoć je opustošen Kir;","poem":1},{"text":"srušen je Moav!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"U hram i Devon ona se uspinje","poem":1},{"text":"na uzvišicu da plače;","poem":2},{"lineBreak":true},{"text":"nad Navavom i nad Medevom","poem":2},{"text":"nariče narod moavski;","poem":1},{"text":"a sve su glave ogolele","poem":2},{"lineBreak":true},{"text":"i sve brade obrijane;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"po ulicama su vrećama zaogrnuti,","poem":1},{"text":"na njihovim krovovima i po trgovima","poem":2},{"text":"svi oni nariču","poem":1},{"text":"i plačući silaze.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Esevon i Elealija jauču,","poem":1},{"text":"glas njihov se čuje do Jase.","poem":2},{"text":"Zato drhću ratnici moavski,","poem":1},{"text":"u grču je duša njihova.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Zato jeca srce moje zbog Moavaca,","poem":1},{"text":"begunci njihovi beže","poem":2},{"lineBreak":true},{"text":"do Soara, Eglat-Selisije,","poem":2},{"text":"plačući se penju na Luit;","poem":1},{"text":"putem oronajimskim","poem":2},{"lineBreak":true},{"text":"razleže se jauk nad ruševinama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jer su se isušile vode nimrimske,","poem":1},{"text":"trava je usahla,","poem":2},{"text":"bilje propalo,","poem":1},{"text":"zelenila više nema.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Zato ko je nešto uštedeo i skladišta njihova,","poem":1},{"text":"taj će to nositi na Potok vrba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jer jauk se razleže do granice s Moavom,","poem":1},{"text":"naricanje mu je do Eglajima,","poem":2},{"lineBreak":true},{"text":"naricanje mu je do Vir-Elima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ta, pune su krvi vode dimonske,","poem":1},{"text":"a ja ću još dodati Dimonu","poem":2},{"text":"jednog lava na moavske begunce","poem":1},{"text":"i na preostale u zemlji.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onstl/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}