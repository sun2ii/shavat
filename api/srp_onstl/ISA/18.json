{"translation":{"id":"srp_onstl","name":"Biblica® Novi srpski prevod, slobodna prava","website":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseNotes":null,"shortName":"ONSTL","englishName":"Serbian ONST Latin","language":"srp","textDirection":"ltr","sha256":"5b89923b317dd2bbf1ad867a0ad52c9ebc28275db904363e008c414350a5883d","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onstl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"ISA","translationId":"srp_onstl","name":"Knjiga proroka Isaije","commonName":"Knjiga proroka Isaije","title":"Knjiga proroka Isaije","order":23,"numberOfChapters":66,"sha256":"1c9e5a2e4e07df935afbb7f4fb0e5d9cdf2c9c148665c8bcb584d2e8c8ad8e29","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onstl/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/srp_onstl/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Reč protiv Kuša"]},{"type":"verse","number":1,"content":[{"text":"Teško zemlji razmahnutih krila,","poem":1},{"text":"s one strane kušanskih reka,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"koja morem šalje glasnike,","poem":1},{"text":"i vodom u čamcima rogoznim.","poem":2},{"lineBreak":true},{"text":"Idite, hitri vesnici,","poem":1},{"lineBreak":true},{"text":"puku lepa stasa i tamne puti,","poem":1},{"text":"narodu kog se boje i nadalje,","poem":2},{"text":"puku žilavom i zavojevačkom,","poem":1},{"text":"čijom zemljom se prepliću reke.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Svi stanovnici vaseljene,","poem":1},{"text":"žitelji zemlje,","poem":2},{"text":"kad se zastava na gorama podigne,","poem":1},{"text":"gledajte;","poem":2},{"text":"i kad rog zatrubi,","poem":1},{"text":"slušajte.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jer meni govori Gospod:","poem":1},{"text":"„Odmaraću se i posmatrati sa svojeg mesta,","poem":2},{"text":"kao žega zažarena nad svetlošću,","poem":1},{"text":"kao rosni oblak kad je žega tokom žetve.“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Pre berbe, kad procveta loza,","poem":1},{"text":"dozrevanje grozdova je u jeku,","poem":2},{"text":"i sekačima će poseći mladice,","poem":1},{"text":"i odstraniti posečene lozice.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Zajedno će biti ostavljeni","poem":1},{"text":"grabljivicama gorskim i zverima po zemlji:","poem":2},{"text":"grabljivice će na njima letovati,","poem":1},{"text":"i sve zveri zemaljske zimovati.","poem":2}]},{"type":"verse","number":7,"content":["U to vreme dar donosiće Gospodu nad vojskama",{"text":"puk lepa stasa i tamne puti,","poem":1},{"text":"narod kog se boje i nadalje,","poem":2},{"text":"puk žilav i zavojevački,","poem":1},{"text":"čijom zemljom prepliću se reke,","poem":2},"k mestu gde je ime Gospoda nad vojskama, gori Sion."]}],"footnotes":[]},"thisChapterLink":"/api/srp_onstl/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}