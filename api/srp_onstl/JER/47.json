{"translation":{"id":"srp_onstl","name":"Biblica® Novi srpski prevod, slobodna prava","website":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseNotes":null,"shortName":"ONSTL","englishName":"Serbian ONST Latin","language":"srp","textDirection":"ltr","sha256":"5b89923b317dd2bbf1ad867a0ad52c9ebc28275db904363e008c414350a5883d","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onstl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"JER","translationId":"srp_onstl","name":"Knjiga proroka Jeremije","commonName":"Knjiga proroka Jeremije","title":"Knjiga proroka Jeremije","order":24,"numberOfChapters":52,"sha256":"5d7975527cd5282026ac11ecb7b94f529456b786cf702e56d22495f1959517b9","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onstl/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/srp_onstl/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Poruka Filistejcima"]},{"type":"verse","number":1,"content":["Reč Gospodnja koja je došla proroku Jeremiji za Filistejce, pre nego je faraon udario na Gazu:"]},{"type":"verse","number":2,"content":["Ovako kaže Gospod:",{"text":"„Evo, dižu se vode sa severa,","poem":1},{"text":"postaju bujični potoci i plave zemlju","poem":2},{"text":"i sve što je u njoj,","poem":1},{"text":"grad i one što žive u njemu.","poem":2},{"text":"I svako će da zavapi,","poem":1},{"text":"zakukaće svaki stanovnik zemlje.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Od topota kopita njihovih ždrebaca,","poem":1},{"text":"od vreve njihovih kola","poem":2},{"lineBreak":true},{"text":"i praska točkova njihovih","poem":2},{"text":"ni očevi se, nemoćni od straha","poem":1},{"text":"neće vratiti po svoju decu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"zbog dana što dolazi","poem":1},{"text":"da satre sve Filistejce,","poem":2},{"text":"da istrebi Tiru i Sidonu","poem":1},{"text":"sve preživele pomoćnike.","poem":2},{"text":"Jer Gospod će da pohara Filistejce,","poem":1},{"text":"ostatak ostrva Kaftor","poem":2},{"noteId":26},{"text":".","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Oćelaviće Gaza!","poem":1},{"text":"Opustošiće Askalon!","poem":2},{"text":"O, ostače njihove doline,","poem":1},{"text":"dokle ćeš sebe parati?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"’Jao, maču Gospodnji,","poem":1},{"text":"koliko se još primiriti nećeš?!","poem":2},{"text":"Priberi se, u korice usuči se","poem":1},{"text":"i ostani miran.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kako da se primiri","poem":1},{"text":"kada mu je Gospod zapovedio?","poem":2},{"text":"Za Askalon i za obalu morsku,","poem":1},{"text":"tamo ga je on odredio.“","poem":2}]}],"footnotes":[{"noteId":26,"caller":"+","text":"47,4 Krit.","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/srp_onstl/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}