{"translation":{"id":"srp_onstl","name":"Biblica® Novi srpski prevod, slobodna prava","website":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseNotes":null,"shortName":"ONSTL","englishName":"Serbian ONST Latin","language":"srp","textDirection":"ltr","sha256":"5b89923b317dd2bbf1ad867a0ad52c9ebc28275db904363e008c414350a5883d","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onstl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PRO","translationId":"srp_onstl","name":"Priče Solomonove","commonName":"Priče Solomonove","title":"Priče Solomonove","order":20,"numberOfChapters":31,"sha256":"5184344c162fe61f1c13cb0cf4fce075ed9ef70c1303f08625652274d1d6fcee","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onstl/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/srp_onstl/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Blagodati mudrosti"]},{"type":"verse","number":1,"content":[{"text":"Sine moj, prihvatiš li moje reči","poem":1},{"text":"i u sebi sačuvaš zapovesti moje;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"tad pažljivo slušaj mudrost","poem":1},{"text":"i srcem teži da razumeš.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ako prizoveš pronicljivost","poem":1},{"text":"i zavapiš razboritosti;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"potražiš li to kao srebro,","poem":1},{"text":"tragaš li za tim kao za skrivenim blagom;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"onda ćeš znati za bogobojaznost","poem":1},{"text":"i naći ćeš bogopoznanje.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jer Gospod mudrost daje,","poem":1},{"text":"znanje i razboritost iz njegovih su usta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"On pravednima sabira istinsku mudrost,","poem":1},{"text":"štit je onima što čestito žive,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"da zaštiti staze pravednosti","poem":1},{"text":"i sačuva put verujućih svojih.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Onda ćeš razumeti pravednost, pravdu i čestitost,","poem":1},{"text":"baš svaku stazu valjanu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Onda će ti mudrost doći u srce","poem":1},{"text":"i znanje biće milo duši tvojoj;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"domišljatost će bdeti nad tobom","poem":1},{"text":"i razboritost čuvaće te.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Izbaviće te od puta izopačenog,","poem":1},{"text":"od onih što izopačeno govore,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"od onih koji napuštaju pravednu stazu","poem":1},{"text":"da bi koračali stazama mraka,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"od onih koji se raduju kada čine zlo","poem":1},{"text":"i kliču izopačenosti zla,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kojima su staze pokvarene,","poem":1},{"text":"a bogaze iskvarene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Izbaviće te od bludnice,","poem":1},{"text":"od uspaljenice slatkorečive,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"one što napušta muža mladosti svoje","poem":1},{"text":"i zaboravlja zavet Boga svoga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Njena kuća tone u smrt,","poem":1},{"text":"a staze njene među pokojne.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ne vraća se niko ko joj ode,","poem":1},{"text":"ne domognu se staza života.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Zato ti idi putem dobrih ljudi,","poem":1},{"text":"drži se staza pravednika.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jer će zemlju pravednici naslediti","poem":1},{"text":"i besprekorni će u njoj prebivati.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"A zli će se iz zemlje istrebiti,","poem":1},{"text":"nevernike će počupati iz nje.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onstl/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}