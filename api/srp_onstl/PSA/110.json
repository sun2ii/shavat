{"translation":{"id":"srp_onstl","name":"Biblica® Novi srpski prevod, slobodna prava","website":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseNotes":null,"shortName":"ONSTL","englishName":"Serbian ONST Latin","language":"srp","textDirection":"ltr","sha256":"5b89923b317dd2bbf1ad867a0ad52c9ebc28275db904363e008c414350a5883d","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onstl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onstl","name":"Psalam","commonName":"Psalam","title":"Psalmi","order":19,"numberOfChapters":150,"sha256":"0f4a6d51097b3743a5f2e7c95becdaae8b222185cdea7bc4316e2af445d3135c","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onstl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onstl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["Psalam Davidov."]},{"type":"verse","number":1,"content":[{"text":"Reče Gospod Gospodu mome:","poem":1},{"lineBreak":true},{"text":"„Sedi meni s moje desne strane,","poem":2},{"text":"dok dušmane ne položim tvoje,","poem":1},{"text":"za tvoje noge postolje da budu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Žezlo snage tvoje pruža Gospod sa Siona:","poem":1},{"text":"Sred dušmana svojih vladaj!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tvoj će ti se narod rado dati u danu tvog pohoda;","poem":1},{"text":"u sjaju slave, u ciku zore mladići su tvoji kao rosa.“","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Gospod je dao zakletvu","poem":1},{"text":"i neće je povući:","poem":2},{"text":"„Ti si doveka sveštenik","poem":1},{"text":"po redu Melhisedekovom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Gospod ti je s desne strane","poem":1},{"text":"i careve lomi u danu svog gneva.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"On narodima sudi, sve je puno leševa;","poem":1},{"text":"širom polja on glave razbija.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"On iz potoka kraj puta pije","poem":1},{"text":"i zbog toga diže glavu.“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onstl/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}