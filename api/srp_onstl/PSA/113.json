"text":"Siromaha diže iz prašine,","poem":1},{"text":"iz bunjišta diže ubogoga;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"da ga posadi s plemićima,","poem":1},{"text":"s plemićima njegovog naroda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Od nerotkinje u kući","poem":1},{"text":"čini srećnu majku dece.","poem":2},{"lineBreak":true},{"text":"Slavite Gospoda!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onstl/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}