:2},{"lineBreak":true},{"text":"više no stražari jutro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"O, Izrailju, Gospodu se nadaj!","poem":1},{"text":"Jer milostiv je Gospod,","poem":2},{"lineBreak":true},{"text":"otkupljuje prebogato.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Baš on će da otkupi Izrailj","poem":1},{"text":"od svih njegovih krivica.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onstl/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}