5,"content":[{"text":"ko ne pozajmljuje novac s kamatom,","poem":1},{"text":"niti prima mito protiv nevinog.","poem":2},{"text":"Ko to čini, neće se poljuljati doveka.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onstl/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}