{"translation":{"id":"srp_onstl","name":"Biblica® Novi srpski prevod, slobodna prava","website":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseUrl":"https://ebible.org/Scriptures/details.php?id=srponstl","licenseNotes":null,"shortName":"ONSTL","englishName":"Serbian ONST Latin","language":"srp","textDirection":"ltr","sha256":"5b89923b317dd2bbf1ad867a0ad52c9ebc28275db904363e008c414350a5883d","availableFormats":["json"],"listOfBooksApiLink":"/api/srp_onstl/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"српски","languageEnglishName":"Serbian"},"book":{"id":"PSA","translationId":"srp_onstl","name":"Psalam","commonName":"Psalam","title":"Psalmi","order":19,"numberOfChapters":150,"sha256":"0f4a6d51097b3743a5f2e7c95becdaae8b222185cdea7bc4316e2af445d3135c","firstChapterNumber":1,"firstChapterApiLink":"/api/srp_onstl/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/srp_onstl/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["Potomaka Korejevih. Psalam. Pesma."]},{"type":"verse","number":1,"content":[{"text":"Na svetim je gorama njegov temelj.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Gospod voli vrata Siona","poem":1},{"text":"više od svih Jakovljevih prebivališta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Slavne se stvari govore o tebi,","poem":1},{"text":"o, grade Božiji! Sela","poem":2}]},{"type":"verse","number":4,"content":[{"text":"„Spominjaću i Vavilon i Ravu","poem":1},{"text":"sa onima koji me poznaju;","poem":2},{"text":"eno, onde su Filisteja i Tir sa Kušom,","poem":1},{"text":"’A ovaj je ovde rođen.’“","poem":2}]},{"type":"verse","number":5,"content":[{"text":"A Sionu će reći:","poem":1},{"text":"„Taj i taj se u njemu rodio;","poem":2},{"lineBreak":true},{"text":"Svevišnji je njega osnovao.“","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Upisaće Gospod u knjigu popisa naroda:","poem":1},{"text":"„Ovaj se rodio ovde!“ Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A pevači i igrači kažu:","poem":1},{"text":"„U tebi su svi izvori moji!“","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/srp_onstl/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/srp_onstl/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/srp_onstl/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}