"content":[{"text":"وٌ قَمَ نّ يٍ بَدٍ كِسِ دُلٌنيِ كُي سّيوّ رَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"نَ لْشْي، وٌ قَمَ نّ عَ قَلَدٍ،","poem":1},{"lineBreak":true},{"text":"«وٌ شَ عَلَتَلَ مَتْشْ،","poem":1},{"lineBreak":true},{"text":"وٌ شَ عَ شِلِ مَسٍن دُنِحَ بّ،","poem":1},{"lineBreak":true},{"text":"وٌ شَ عَ شَ وَلِ قَنيِيٍ قَلَ حَمَنّ مَ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"وٌ شَ عَلَتَلَ مَتْشْ بّيتِيٍ رَ عَ شَ كَابَنَكٌي شَ قٍ رَ.","poem":1},{"lineBreak":true},{"text":"وٌ شَ دُنِحَ بِرِن نَكٌلٌن عَ شَ نْرّ رَ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"وٌ تَن سِيٌنِكَيٍ، وٌ شَ وٌ شُي رَ مِنِ سّيوّ رَ،","poem":1},{"lineBreak":true},{"text":"بَرِ مَ عِسِرَيِلَ شَ سّنِيّنتْي سّنبّ فبٌ وٌ تَفِ!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}