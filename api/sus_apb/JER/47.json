{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JER","translationId":"sus_apb","name":"عَننَبِ يٍرٍ مِ","commonName":"عَننَبِ يٍرٍ مِ","title":"عَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ عَلَ شَ مَسٍنيِ عَننَبِ يٍرٍ مِ بّ","order":24,"numberOfChapters":52,"sha256":"ce69332af9e44b19071bb955135fb21f26dc7c49d844fffdb099216cce348383","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sus_apb/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["مَسٍنيِ قِلِسِتَكَيٍ بّ"]},{"type":"verse","number":1,"content":[{"text":"عَلَتَلَ بَرَ يِ مَسٍنيِ تِ عَننَبِ يٍرٍ مِ بّ","poem":1},{"lineBreak":true},{"text":"قِلِسِتَكَيٍ شَ قٍ رَ بٍينُ مِسِرَ مَنفّ شَ فَسَ فٍرٍ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«عَلَتَلَ شَ مَسٍنيِ نَن يَ؛","poem":1},{"lineBreak":true},{"text":"مِشِ قَمَ نّ كٍلِقٍ كْولَ مَ","poem":1},{"lineBreak":true},{"text":"نَشٍيٍ لُشِ عَلْ يٍ شُنفبٍ شُرٍ كُي،","poem":1},{"lineBreak":true},{"text":"نَشَن بَنبَرَنمَ، عَ قَ تَايٍ كَنَ.","poem":1},{"lineBreak":true},{"text":"تَاكَيٍ بِرِن عٍ وَ شُي رَ مِنِمَ نّ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"سٌي نُن سْورِ رَفِسٍيٍ شُي نَ تَا لِ،","poem":1},{"lineBreak":true},{"text":"بَبَيٍ مُ عٍ شَ دِيٍ مَلِمَ،","poem":1},{"lineBreak":true},{"text":"سّنبّمَيٍ مُ سّنبّتَرٍيٍ مَلِمَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"قِلِسِتَكَيٍ فبَلٌي لْشْي بَرَ عَ لِ.","poem":1},{"lineBreak":true},{"text":"تِرٍ نُن سِدْن مُ قِلِسِتَكَيٍ شَ مَلِ سْتْمَ سْنْن،","poem":1},{"lineBreak":true},{"text":"بَرِ مَ عَلَتَلَ بَرَ عٍ سْنتْ عَ نُن كَقَتٌرٌكَيٍ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"فَسَ بَرَ كَنَ، عَسِكَلْن بَرَ عَ سَبَرِ.»","poem":1},{"lineBreak":true},{"text":"«مِشِ نَشٍيٍ لُشِ قِيلِ مَ،","poem":1},{"lineBreak":true},{"text":"وٌ وٌ يّتّ مَشَبَمَ سُننُنيِ كُي هَن مُن تّمُي؟","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"وٌ عَ قَلَمَ، ‹عَلَتَلَ شَ سَنتِدّفّمَ وَلِمَ هَن مُن تّمُي؟","poem":1},{"lineBreak":true},{"text":"عَ رَ سٌ عَ تّي كُي، عِ بْحّ مَفٌرٌ!›","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ﭑ شَ عَ قَلَ وٌ بّ، عَ سَنتِدّفّمَ مَلَبُمَ دِ؟","poem":1},{"lineBreak":true},{"text":"عَلَتَلَ نَن عَ يَمَرِشِ،","poem":1},{"lineBreak":true},{"text":"عَ شَ سِفَ هَن عَسِكَلْن بَا دّ رَ.","poem":1},{"lineBreak":true},{"text":"عَ شَ وَلِ نَن نَ كِ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}