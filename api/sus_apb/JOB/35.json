ak":true},{"text":"شَ عِ عَ مَتَندِ، نَ قِندِ مَ كٌتٍ مُندُن نَ عَ بّ؟","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"شَ عِ تِنشِن، نَ قِندِ مَ فٍينِ مُندُن نَ عَ تَن بّ؟","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عِ شَ قٍ حَاشِ نْمَ عَدَ مَدِ نَن فبَنسَن تْورْدٍ،","poem":1},{"lineBreak":true},{"text":"عَدَ مَدِ نَشَن لُشِ عَلْ عِ تَن.","poem":1},{"lineBreak":true},{"text":"عِ شَ تِنشِنيِ قَن نْمَ قِندِدٍ فٍينِ رَ عَدَ مَدِ نَن فبَنسَن بّ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"مِشِيٍ عٍ وَ شُي مّمَ بَرِ مَ قٍ حَاشِ رَبَيٍ وُيَ.","poem":1},{"lineBreak":true},{"text":"مِشِيٍ شِلِ تِمَ نَ كٌبِحَ شَ قٍ رَ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"كْنْ مِشِ يٌ مُ عَ قَلَمَ،","poem":1},{"lineBreak":true},{"text":"‹ﭑ دَا مَنفّ عَلَ نَ مِندٍن،","poem":1},{"lineBreak":true},{"text":"ﭑ بّيتِ بَمَ نَشَن بّ كْي رَ،","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"نَشَن لْننِ قِمَ عَدَ مَدِيٍ مَ","poem":1},{"lineBreak":true},{"text":"دَنفِقٍ سُبٍيٍ رَ نَشٍيٍ نَ دُنِحَ مَ،","poem":1},{"lineBreak":true},{"text":"دَنفِقٍ شْنِيٍ رَ نَشٍيٍ نَ كُيٍ مَ؟›","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"مِشِيٍ شِلِ تِمَ، كْنْ عَ مُ عٍ يَابِمَ","poem":1},{"lineBreak":true},{"text":"قٍ حَاشِ رَبَيٍ شَ يّتّ عِفبٌحَ شَ قٍ رَ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"عٍ شِلِ تِمَ قُقَقُ،","poem":1},{"lineBreak":true},{"text":"بَرِ مَ عَلَ مُ عَ تُلِ مَتِمَ عٍ رَ،","poem":1},{"lineBreak":true},{"text":"عَلَ سّنبّ كَنيِ مُ عٍ شُي رَ مّمَ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"كْنْ عِ تَن نَن عَ قَلَشِ عَ عِ مُ عَلَ تٌشِ،","poem":1},{"lineBreak":true},{"text":"عِ شَ قٍ سَشِ عَ يَ عِ، عِ نَ عَ مَمّقٍ تُن.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"عَ مُ نُ شْنْ عِ شَ مَتَند