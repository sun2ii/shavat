":true},{"text":"عَبِيُدِ نَشَ عٍلِيَكِمِ سْتْ.","poem":1},{"lineBreak":true},{"text":"عٍلِيَكِمِ نَشَ عَسٌرٌ سْتْ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"عَسٌرٌ نَشَ سَدْكِ سْتْ.","poem":1},{"lineBreak":true},{"text":"سَدْكِ نَشَ عَشِمِ سْتْ.","poem":1},{"lineBreak":true},{"text":"عَشِمِ نَشَ عٍلِيُدِ سْتْ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"عٍلِيُدِ نَشَ عٍلٍيَسَرِ سْتْ.","poem":1},{"lineBreak":true},{"text":"عٍلٍيَسَرِ نَشَ مَتَن سْتْ.","poem":1},{"lineBreak":true},{"text":"مَتَن نَشَ يَشُبَ سْتْ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"يَشُبَ نَشَ يُسُقُ سْتْ.","poem":1},{"lineBreak":true},{"text":"يُسُقُ نَشَ مَرِيَمَ دْشْ.","poem":1},{"lineBreak":true},{"text":"مَرِيَمَ نَن قِندِ عِسَ نفَ رَ،","poem":1},{"lineBreak":true},{"text":"نَشَن شِلِ عَلَ شَ مِشِ سُفَندِشِ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["عَ بِرِن نَلَنشِ بٍنبَ دْشْ قُ نُن نَانِ، كٍلِ عِبُرَهِمَ مَ سَ دْشْ دَوُدَ رَ. عَ بِرِن نَلَنشِ بٍنبَ دْشْ قُ نُن نَانِ، كٍلِ دَوُدَ مَ، هَن عِسِرَيِلَكَيٍ سِفَ تّمُي نَشّ بَبِلْن. عَ بِرِن نَلَنشِ بٍنبَ دْشْ قُ نُن نَانِ، كٍلِ عِسِرَيِلَكَيٍ سِفَ تّمُي مَ بَبِلْن، هَن عَ سَ دْشْ عَلَ شَ مِشِ سُفَندِشِ شَ وَشَتِ رَ."]},{"type":"heading","content":["عِسَ بَرِ كِ نَشّ"]},{"type":"verse","number":18,"content":["عَلَ شَ مِشِ سُفَندِشِ عِسَ شَ بَرِ رَبَ يِ كِ نّ؛ يُسُقُ نُ بَرَ عِسَ نفَ مَرِيَمَ شَ كٌتٍ دْشْ، كْنْ بٍينُن عٍ شَ كَقُ، مَرِيَمَ نَشَ تّيفّ عَلَ شَشِلِ سّنِيّنشِ شَ كَابَنَكٌ سَابُي رَ."]},{"type":"verse","number":19,"content":["عَ شَ مْرِ يُسُقُ تٌ قِندِشِ تِنشِنتْي رَ، عَ مُ نُ وَشِ مَرِيَمَ شِلِ كَنَقٍ. عَ نَشَ نَتّ تٌنفٌ عٍ شَ قَتَن فُندٌحْشْحَ كُي."]},{"type":"verse","number":20,"content":["عَ نُ عَ مَحْشُنمَ نَ قٍ مَ تّمُي نَشّ، مَرِفِ شَ مَلٍكّ ندٍ نَشَ مِنِ عَ مَ شِيٍ كُي، عَ عَ مَسٍن عَ بّ، «يُسُقُ، عِ تَن نَشَن كٍلِشِ دَوُدَ بْنسْي، عِ نَشَ فَاشُ عِ شَ فِنّ مَرِيَمَ قُتِقٍ رَ، بَرِ مَ عَ تّيفّشِ دِ نَشَن مَ، عَ قَتَنشِ عَلَ شَشِلِ سّنِيّنشِ شَ كَابَنَكٌ نَن نَ."]},{"type":"verse","number":21,"content":["مَرِيَمَ قَمَ دِ شّمّ نَن بَرِدٍ. عِ شَ عَ شِلِ سَ عِسَ، بَرِ مَ عَ تَن نَن قَمَ عَ شَ حَمَ رَكِسِدٍ عٍ شَ يُنُبِيٍ مَ.»"]},{"type":"verse","number":22,"content":["نَ بِرِن نَبَ نّ عَلَكٌ مَرِفِ نَشَن مَسٍن نَمِحْنمّ سَابُي رَ، عَ شَ كَمَلِ عَلْ عَ سّبّشِ كِتَابُي كُي كِ نَشّ،"]},{"type":"verse","number":23,"content":[{"text":"«فِنّدِ مّدِ تّيفّمَ نّ، عَ دِ شّمّ بَرِ.","poem":1},{"lineBreak":true},{"text":"عٍ عَ شِلِ قَلَمَ نّ عٍمَنُوّلِ.»","poem":1},"نَ نَن نَ كِ، «عَلَ نَ وٌن يَ مَ.»"]},{"type":"verse","number":24,"content":["يُسُقُ تٌ شُنُ، عَ نَشَ مَرِفِ شَ مَلٍكّ شَ يَامَرِ رَبَتُ، عَ عَ شَ فِنّ شَ قُتِ شِرِ."]},{"type":"verse","number":25,"content":["كْنْ عَ مُ عَ كٌلٌن فِنّ رَ هَن مَرِيَمَ شَ دِ شّمّ بَرِ شَنبِ. عَ نَشَ نَ دِ شِلِ سَ عِسَ."]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/MAL/3.json","previousChapterAudioLinks":{},"numberOfVerses":25}