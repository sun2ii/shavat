{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":108,"content":[{"type":"heading","content":["شُننَكٍلِ عَلَ سَابُي رَ"]},{"type":"heading","content":["عَلَ مَشَندِ"]},{"type":"verse","number":1,"content":[{"text":"دَوُدَ شَ بّيتِ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"عَلَ، ﭑ بَرَ نَتّ تٌنفٌ ﭑ بْحّ كُي.","poem":1},{"lineBreak":true},{"text":"ﭑ مَرِفِ شُننَكٍلِ كَنيِ، ﭑ ﭑ شُي رَ مِنِمَ نّ بّيتِيٍ رَ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ﭑ ﭑ مَ كْرَيٍ نُن ﭑ مَ مَشَسٍيٍ بٍرٍ مَ نّ سُبَشّ مَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ﭑ مَرِفِ، ﭑ عِ بَتُمَ نّ سِيٍ تَفِ،","poem":1},{"lineBreak":true},{"text":"ﭑ عِ مَتْشْمَ نّ بّيتِ رَ حَمَنّيٍ يَ مَ،","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"بَرِ مَ عِ شَ دُفُتّفّحَ فبٌ دَنفِ كٌورٍ رَ،","poem":1},{"lineBreak":true},{"text":"عِ شَ شَنُنتٍيَ عِتٍ عَلْ نُشُييٍ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"عَلَ، عِ شُنيِ رَكٍلِ كٌورٍ مَ،","poem":1},{"lineBreak":true},{"text":"عِ شَ نْرّ شَ لُ بْشِ بِرِن شُن مَ،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عَلَكٌ عِ شَنُنتٍنيِيٍ شَ كِسِ عِ سّنبّ سَابُي رَ.","poem":1},{"lineBreak":true},{"text":"يَندِ، ﭑ مَ دُبَ سُشُ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"عَلَ بَرَ وْيّن عَ شَ لِنفِرَ سّنِيّنشِ كُي،","poem":1},{"lineBreak":true},{"text":"«ﭑ ﭑ شُن نَكٍلِمَ نّ،","poem":1},{"lineBreak":true},{"text":"ﭑ سِكٍمِ بْشِ عِتَشُن،","poem":1},{"lineBreak":true},{"text":"ﭑ سُكْتِ فُلُنبَ سْتْمَ نّ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ﭑ فبٍ نَن فَلَدِ رَ، ﭑ فبٍ نَن مَنَسِ رَ.","poem":1},{"lineBreak":true},{"text":"عٍقِرَ مِ بْشِ تَن لُمَ نّ عَلْ ﭑ شُن مَكَنتَسٍ،","poem":1},{"lineBreak":true},{"text":"يُدَيَ قِندِ ﭑ مَ مُنيَاتِ رَ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ﭑ ﭑ سَنيِ مَشَمَ مٌوَبَ بْشِ مَ،","poem":1},{"lineBreak":true},{"text":"ﭑ ﭑ مَ سَنكِرِ وٌلِمَ عٍدٌن نَن مَ عَ شَ قِندِ ﭑ فبٍ رَ.","poem":1},{"lineBreak":true},{"text":"ﭑ فٍرٍ تِ شُي مّمَ نّ قِلِسِتَ بْشِ مَ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ندٍ ﭑ شُن تِمَ تَا مَكَنتَشِ رَ؟","poem":1},{"lineBreak":true},{"text":"ندٍ ﭑ شَنِنمَ عٍدٌن بْشِ مَ؟","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"عَلَ مُ عَ رَ، نَشَن مُشُ رَبّحِنشِ فٍرٍ كُي؟","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"عِ شَ قَ مُشُ مَلِدٍ، عِ شَ مُشُ بَ مُشُ يَشُييٍ يِ رَ.","poem":1},{"lineBreak":true},{"text":"عَدَ مَدِيٍ شَ مَلِ قُقَقُ نَ عَ رَ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"وٌن قَمَ وٌن سّنبّ رَ مِنِدٍ عَلَ شَ مَلِ سَابُي رَ.","poem":1},{"lineBreak":true},{"text":"عَ تَن نَن قَمَ وٌن يَشُييٍ عِوُرُدٍ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}