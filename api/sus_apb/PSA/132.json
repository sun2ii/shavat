},{"type":"verse","number":6,"content":[{"text":"وٌن نُ بَرَ عَ شَ قٍ مّ عٍقَرَتَ بْشِ مَ.","poem":1},{"lineBreak":true},{"text":"وٌن نَشَ عَ لِ يَارَ شَ شّ مَ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«وٌن شّي عَ شَ هْرْ مْلِنفِرَ يِرٍ،","poem":1},{"lineBreak":true},{"text":"وٌن شَ وٌن شِنبِ سِن عَ سَنتِدٍ يَ عِ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عَلَتَلَ، كٍلِ عِ شَ تَلُ عِ سَبَتِدٍ،","poem":1},{"lineBreak":true},{"text":"عِ تَن نُن عِ شَ سَاتّ كَنكِرَ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"عِ شَ سّرّشّدُبّيٍ شَ لُ شُننَكٍلِ كُي،","poem":1},{"lineBreak":true},{"text":"عِ دُفُتّفّيٍ شَ عٍ سّيوّ شُي رَتٍ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"عِ شَ كٌنيِ دَوُدَ شَ قٍ رَ،","poem":1},{"lineBreak":true},{"text":"عِ نَشَ مّي عِ شَ مَنفّ سُفَندِشِ رَ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"عَلَتَلَ عَ كَلِ نّ دَوُدَ بّ،","poem":1},{"lineBreak":true},{"text":"مَرَكَلِ نَشَن مُ كَنَمَ،","poem":1},{"lineBreak":true},{"text":"عَ نَشّ، «ﭑ عِ بْنسْي ندٍ نَن دْشْمَ عِ شَ كِبَنيِ مَ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"شَ عِ شَ دِيٍ سَ ﭑ مَ سَاتّ بِنيَ،","poem":1},{"lineBreak":true},{"text":"عٍ ﭑ مَ يَامَرِيٍ رَبَتُ،","poem":1},{"lineBreak":true},{"text":"عٍ شَ دِيٍ قَن لُمَ نّ عِ شَ كِبَنيِ مَ عَبَدَن.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"بَرِ مَ عَلَتَلَ بَرَ سِيٌنِ سُفَندِ،","poem":1},{"lineBreak":true},{"text":"مّننِ نَن نَقَنشِ عَ مَ عَ سَبَتِدٍ رَ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"عَ نَشّ، «ﭑ سَبَتِدٍ نَن بٍ رَ عَبَدَن.","poem":1},{"lineBreak":true},{"text":"ﭑ دْشْمَ بٍ ﭑ مَ كِبَنيِ كُي بَرِ مَ بٍ رَقَنشِ ﭑ مَ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ﭑ بَرَكّ سَمَ نّ سِيٌنِكَيٍ مَ،","poem":1},{"lineBreak":true},{"text":"ﭑ بَلٌي قِ عٍ شَ مِسِكِينّيٍ مَ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ﭑ كِسِ قِمَ نّ عٍ شَ سّرّشّدُبّيٍ مَ،","poem":1},{"lineBreak":true},{"text":"عٍ دُفُتّفّيٍ بّيتِ بَمَ نّ سّيوّ كُي.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«بٍ ﭑ دَوُدَ سّنبّ رَكٍلِمَ نّ،","poem":1},{"lineBreak":true},{"text":"ﭑ نَءِيَلَنيِ رَ مِنِمَ نّ ﭑ مَ مِشِ سُفَندِشِ بّ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ﭑ يَافِ دُ سُمَ نّ عَ يَشُييٍ شُن نَ،","poem":1},{"lineBreak":true},{"text":"كْنْ ﭑ نْرّ دُ سُمَ عَ تَن نَن شُن نَ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}