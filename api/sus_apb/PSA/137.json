{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":137,"content":[{"type":"heading","content":["عِسِرَيِلَ شَ كٌنيِيَ بَبِلْن بْشِ مَ"]},{"type":"heading","content":["عَلَ مَتْشْي"]},{"type":"verse","number":1,"content":[{"text":"مُشُ نُ دْشْشِ بَبِلْن شُرٍيٍ دّ رَ سِيٌنِ شَ قٍ رَتُقٍ رَ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"مُشُ نُ بَرَ مُشُ شَ كْرَيٍ فبَكُ وُرِ بِلِيٍ كْن نَ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"مُشُ يَشُييٍ نُ سِيٌنِ بّيتِيٍ مَشْرِن مُشُ مَ،","poem":1},{"lineBreak":true},{"text":"عٍ نُ وَ مَ بّيتِ سّيوَشِ ندٍ شْن.","poem":1},{"lineBreak":true},{"text":"عٍ نَشّ، «سِيٌنِ بّيتِ ندٍ بَ مُشُ بّ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"مُشُ نْمَ بّيتِ بَدٍ عَلَتَلَ بّ يِ كٌنيِيَ كُي دِ؟","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"دَرِ سَلَمُ، شَ ﭑ نّيمُ عِ مَ، ﭑ بّلّشّ نَشَ نْ كْرَ رَبٍرٍدٍ سْنْن،","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ﭑ نّنيِ شَ كَنكَن ﭑ دّ كُي.","poem":1},{"lineBreak":true},{"text":"نَ شَ رَبَ ﭑ نَ شَ عَ سَ لِ ﭑ نَشَ نّيمُ دَرِ سَلَمُ مَ،","poem":1},{"lineBreak":true},{"text":"شَ عَ شَ قٍ مُ قِندِ ﭑ مَ سّيوّ رَ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"عَلَتَلَ، عِ شَ رَتُ عٍدٌنكَيٍ شَ قٍ رَبَ مَ دَرِ سَلَمُ شَ نِمِسّ لْشْي.","poem":1},{"lineBreak":true},{"text":"عٍ تَن نَن نُ عَ قَلَمَ،","poem":1},{"lineBreak":true},{"text":"«وٌن شَ عَ كَنَ هَن وٌن سَ عَ بَ عَ بُنيِ رَ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"بَبِلْن، وٌ شَ شُننَفٌرٍ بَرَ فّ حَنِفٍدٍ،","poem":1},{"lineBreak":true},{"text":"سّيوّ نَ عَ بّ نَشَن عِ سَرٍ رَفبِلٍنمَ عِ مَ،","poem":1},{"lineBreak":true},{"text":"عِ قٍ حَاشِ نَشَن نَبَشِ مُشُ رَ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"سّيوّ نَ مِشِ بّ نَشَن عِ شَ دِيٍ سُشُمَ،","poem":1},{"lineBreak":true},{"text":"عَ عٍ بُتُشُن قَنيٍ قَرِ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}