{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":140,"content":[{"type":"heading","content":["مِشِ كٌبِ عَلْ بْشِمَسٍ"]},{"type":"heading","content":["عَلَ مَشَندِ"]},{"type":"verse","number":1,"content":[{"text":"دَوُدَ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"عَلَتَلَ، ﭑ نَتَنفَ مِشِ حَاشِيٍ يِ رَ،","poem":1},{"lineBreak":true},{"text":"نَشٍيٍ وَ مَ ﭑ تْورْقٍ،","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"نَشٍيٍ نَتّ تٌنفٌمَ عٍ بْحّ مَ فٍرٍ مَسٌقٍ رَ لْشْ يٌ لْشْ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"عٍ شَ وْيّنيِ شْنْ عَلْ بْشِمَسٍ شَ شْنّ. حّنفِ رَتٍ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"عَلَتَلَ، عِ شَ ﭑ نَتَنفَ مِشِ حَاشِيٍ بّلّشّ عِ.","poem":1},{"lineBreak":true},{"text":"عِ شَ ﭑ نَتَنفَ مِشِ كٌبِيٍ مَ نَشٍيٍ وَ مَ ﭑ نَبِرَقٍ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عِ شَ ﭑ نَتَنفَ يّتّ عِفبٌي شَ فَنتَنيِ نُن لُوتِيٍ مَ،","poem":1},{"lineBreak":true},{"text":"نَشٍيٍ يّلّيٍ عِتَلَمَ ﭑ مَ كِرَيٍ رَ ﭑ سُشُقٍ رَ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عَلَتَلَ، ﭑ مَرِفِ عَلَ نَن عِ رَ.","poem":1},{"lineBreak":true},{"text":"عِ شَ عِ تُلِ مَتِ ﭑ وَ شُي رَ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عَلَتَلَ، ﭑ نَكِسِمَ سّنبّمَ،","poem":1},{"lineBreak":true},{"text":"نَشَن ﭑ نَتَنفَمَ ﭑ فٍرٍ لْشْي،","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"عِ نَشَ تِن مِشِ كٌبِيٍ وَشْنقٍ رَ،","poem":1},{"lineBreak":true},{"text":"عِ نَشَ نَ سْونّيَ عٍ بّ عَلَكٌ عٍ شُن نَشَ قَ رَكٍلِ. حّنفِ رَتٍ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ﭑ فٍرٍقَيٍ شَ قٍ حَاشِ مَشِرِشِيٍ شَ فبِلٍن عٍ مَ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"تّ وٌلٍ شَ دْشْ عٍ شُن نَ،","poem":1},{"lineBreak":true},{"text":"عٍ شَ رَدِن تّ شْورَ، عٍ نَشَ قَ مِنِ نَ كُي سْنْن.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"قٍ حَاشِ رَبَيٍ نَشَ سَبَتِ يِ بْشِ مَ،","poem":1},{"lineBreak":true},{"text":"تْورّ نَن تُن شَ رَفِرِ عٍ مَ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ﭑ عَ كٌلٌن عَلَتَلَ كِيتِ قَنيِ سَمَ نّ مِسِكِينّيٍ بّ،","poem":1},{"lineBreak":true},{"text":"عَ نْندِ قِمَ سٍتَرٍيٍ مَ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"تِنشِنتْييٍ عِ شِلِ مَتْشْمَ نّ،","poem":1},{"lineBreak":true},{"text":"نْندِلَيٍ كِسِمَ نّ عِ يَ عِ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}