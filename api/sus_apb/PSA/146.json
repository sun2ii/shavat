:[{"text":"سّيوّ نَ مِشِ بّ، يَشُبَ مَرِفِ عَلَ نَشَن مَلِمَ.","poem":1},{"lineBreak":true},{"text":"سّيوّ نَ مِشِ بّ، نَشَن عَ شَشِلِ تِمَ عَ مَرِفِ عَلَتَلَ رَ،","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عَلَ نَشَن كٌورٍ نُن بْشِ دَا،","poem":1},{"lineBreak":true},{"text":"عَلَ نَشَن بَا نُن عَ كُي سٍيٍ بِرِن دَا،","poem":1},{"lineBreak":true},{"text":"دُفُتّفّحَ نَ عَلَ نَشَن بّ عَبَدَن.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عَلَتَلَ تْوحّفّتْييٍ شُن مَقَلَمَ،","poem":1},{"lineBreak":true},{"text":"عَ دٌنسٍ قِمَ كَامّتْييٍ مَ،","poem":1},{"lineBreak":true},{"text":"عَ فٍيلِمَنِيٍ رَ مِنِمَ فٍيلِ كُي،","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عَ دْنشُييٍ يَ رَبْو مَ،","poem":1},{"lineBreak":true},{"text":"عَ مِشِ مَفٌرٌشِيٍ شُن نَكٍلِمَ،","poem":1},{"lineBreak":true},{"text":"عَ تِنشِنتْييٍ شَنُمَ،","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"عَ مّينِمَ شْحّيٍ مَ،","poem":1},{"lineBreak":true},{"text":"عَ كِرِدِيٍ نُن كَاحّ فِنّيٍ بُن تِمَ،","poem":1},{"lineBreak":true},{"text":"كْنْ عَ مِشِ حَاشِيٍ تَن شُن نَكَنَمَ نّ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"سِيٌنِ، وٌ مَرِفِ عَلَتَلَ شَ مَنفّيَ مُ حْنمَ عَبَدَن.","poem":1},{"lineBreak":true},{"text":"وٌ شَ عَلَتَلَ مَتْشْ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}