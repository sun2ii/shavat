":true},{"text":"مِشِ فبّتّيٍ قٍ حَاشِ رَبَمَ،","poem":1},{"lineBreak":true},{"text":"كْنْ ﭑ تَن بَرَ عِ شَ يَامَرِ سُشُ.","poem":1},{"lineBreak":true},{"text":"ﭑ مُ بِرَ مَ سُوتٍيٍ شَ كِرَيٍ قْشْ رَ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ﭑ بِرَ مَ عِ تَن نَن قْشْ رَ،","poem":1},{"lineBreak":true},{"text":"ﭑ مُ نَ كِرَ بّحِنمَ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عَلَ، ﭑ عِ شِلِمَ نّ، بَرِ مَ عِ يَابِ قِمَ مِشِ مَ.","poem":1},{"lineBreak":true},{"text":"يَندِ، عِ شَ عِ تُلِ مَتِ ﭑ مَ مَشَندِ رَ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عِ شَ هِننّ مُشُ رَ،","poem":1},{"lineBreak":true},{"text":"عِ تَن نَشَن مِشِيٍ رَكِسِمَ عٍ يَشُييٍ مَ،","poem":1},{"lineBreak":true},{"text":"نَشٍيٍ يِفِيَ قٍنمَ عِ رَ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"مّينِ ﭑ مَ عَلْ عِ يَ قِرِنيِيٍ.","poem":1},{"lineBreak":true},{"text":"ﭑ نْشُن عَلْ تْشّيْرّ","poem":1},{"lineBreak":true},{"text":"نَشَن عَ نْشُنمَ عَ نفَ فَبُتٍنيِيٍ بُن مَ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"نَ نَ عَ تٌمَ، مِشِ حَاشِ نَشٍيٍ ﭑ نَبِلِنشِ،","poem":1},{"lineBreak":true},{"text":"عٍ مُ نْمَ ﭑ نَ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"يّتّ عِفبٌي نَن عٍ رَ، عٍ دّ عِفبٌ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"عٍ بَرَ قَ ﭑ قْشْ رَ يَكْسِ،","poem":1},{"lineBreak":true},{"text":"عٍ ﭑ نَبِلِن، عٍ عَلَكٌ عٍ شَ ﭑ قَشَ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"عٍ لُشِ عَلْ يّتّ نَشَن سُبٍ قٍنمَ،","poem":1},{"lineBreak":true},{"text":"عَلْ يّتّ كَامّشِيٍ نَشٍيٍ فبَتَشِ سُبٍ قَشَدٍ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"عَلَتَلَ، كٍلِ! ﭑ يَشُييٍ فٍرٍ، عِ شَ نْ عٍ رَ.","poem":1},{"lineBreak":true},{"text":"ﭑ نَتَنفَ مِشِ حَاشِيٍ مَ عِ شَ سَنتِدّفّمَ رَ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ﭑ نَتَنفَ نَ دُنِحَ مِشِ مْولِيٍ مَ،","poem":1},{"lineBreak":true},{"text":"نَشٍيٍ عٍ مَسُندِ سْتْمَ يِ دُنِحّءِفِرِ فبَنسَن كُي.","poem":1},{"lineBreak":true},{"text":"عٍ رَلُفَ نَ مَسُندِ رَ، عِ نَشَن نَفَتَشِ عٍ بّ.","poem":1},{"lineBreak":true},{"text":"عٍ شَ دِيٍ قَن شَ وَ سَ نَ رَ،","poem":1},{"lineBreak":true},{"text":"عَ دْنشْي شَ لُ عٍ شَ مَمَدِيٍ بّ!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"كْنْ ﭑ تَن قَمَ نّ عِ يَتَفِ تٌدٍ تِنشِنيِ سَابُي رَ.","poem":1},{"lineBreak":true},{"text":"ﭑ نَ شُنُ، ﭑ وَ سَمَ نّ عِ يَتَفِ رَ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}