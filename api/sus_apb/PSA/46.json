 رَ سّيوَ مَ.","poem":1},{"lineBreak":true},{"text":"عَلَ شِلِ شُنفبٍ كَنيِ شَ هْرْ مْلِنفِرَ سّنِيّنشِ نَ مّننِ نّ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عَلَ نَ نَ تَا كُي، نَ تَا مُ عَ رَ مَشَمَ،","poem":1},{"lineBreak":true},{"text":"عَ عَ مَلِمَ سُبَشّ نّقّ عَ لِ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"سِيٍ سْنشْي رَتٍمَ،","poem":1},{"lineBreak":true},{"text":"مَنفّيَيٍ بِرَ مَ نّ.","poem":1},{"lineBreak":true},{"text":"عَلَ نّقّ عَ شُي رَ مِنِ،","poem":1},{"lineBreak":true},{"text":"دُنِحَ بِرِن شُنُنمَ نّ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"مَنفّ عَلَتَلَ نَ وٌن سّيتِ مَ.","poem":1},{"lineBreak":true},{"text":"وٌن مَ كَنتَرِ نَ يَشُبَ مَرِفِ عَلَ يِ رَ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"وٌ قَ عَلَتَلَ شَ وَلِ مَتٌ،","poem":1},{"lineBreak":true},{"text":"عَ فبَلٌي نَشَن لُشِ بْشِ مَ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"عَ تَن نَن فٍرٍ حْنمَ دُنِحَ بِرِن مَ.","poem":1},{"lineBreak":true},{"text":"عَ شَلِ فِرَ مَ نّ.","poem":1},{"lineBreak":true},{"text":"عَ تَنبّ كَنَمَ نّ،","poem":1},{"lineBreak":true},{"text":"عَ مَكَنتَسٍ فَن.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«وٌ وٌ رَشَرَ، وٌ شَ عَ كٌلٌن عَلَ نَ ﭑ تَن نَن نَ.","poem":1},{"lineBreak":true},{"text":"ﭑ سِ بِرِن يَمَرِ مَ.","poem":1},{"lineBreak":true},{"text":"ﭑ مَ يَامَرِ نَ دُنِحَ بِرِن مَ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"عَلَتَلَ نَ وٌن سّيتِ مَ،","poem":1},{"lineBreak":true},{"text":"وٌن مَ كَنتَرِ نَ يَشُبَ مَرِفِ عَلَ يِ رَ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerse