{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":52,"content":[{"type":"heading","content":["دّ حَاشِ"]},{"type":"heading","content":["عَلَ شَ سّرِيّ"]},{"type":"verse","number":1,"content":[{"text":"دَوُدَ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"مَسٍنيِ نَن يَ دٌوٍفٍ عٍدٌنكَ شَ قٍ رَ، نَشَن عَ قَلَ سْلُ بّ عَ دَوُدَ نَ عَشِمٍلٍكِ شْنيِ.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"عِ عِ يّتّ عِفبٌمَ قٍ كٌبِ رَبَقٍ رَ مُنقٍ رَ؟","poem":1},{"lineBreak":true},{"text":"عَلَ شَ هِننّ بُمَ نّ عَبَدَن.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"عِ دّ لُمَ عَلْ قِنّ نَشَن قٍ حَاشِ رَبَمَ.","poem":1},{"lineBreak":true},{"text":"يَنقَنتٍ نَن عِ رَ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"قٍ حَاشِ رَقَن عِ مَ دَنفِقٍ قٍ قَنيِ رَ.","poem":1},{"lineBreak":true},{"text":"وُلٍ رَقَن عِ مَ دَنفِقٍ نْندِ رَ. حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عِ وْيّن شُي شَاحّ، عِ دّ مُ قَن.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"نَ كُي عَلَ قَمَ عِ رَهَلَكِدٍ تّمُي بِرِن.","poem":1},{"lineBreak":true},{"text":"عَ عِ سُشُمَ نّ، عَ عِ كٍرِ عِ شَ بَنشِ كُي، عَ عِ كٍرِ دُنِحَ مَ. حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"تِنشِنتْي نَشٍيٍ قِندِ مَ سٍيدٍيٍ رَ","poem":1},{"lineBreak":true},{"text":"عٍ قَمَ يٍلٍدٍ نَ كَنيِ مَ يِ كِ نّ،","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«وٌ نَ مِشِ مَتٌ،","poem":1},{"lineBreak":true},{"text":"نَشَن مُ نُ عَ شَشِلِ تِشِ عَلَ رَ.","poem":1},{"lineBreak":true},{"text":"عَ نَشَ لَ عَ شَ نَاقُلِ رَ،","poem":1},{"lineBreak":true},{"text":"عَ عَ يّتّ كَنتَ عَ شَ يَنقَنتٍيَ رَ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"كْنْ، ﭑ تَن نَشَن لَشِ عَلَ شَ هِننّ رَ،","poem":1},{"lineBreak":true},{"text":"ﭑ مَ قٍ بِرِن نَ سْونّيَقٍ","poem":1},{"lineBreak":true},{"text":"عَلْ عٌلِوِ وُرِ تٌقَنيِ نَشَن نَ عَلَ شْنيِ.»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ﭑ عِ تَنتُمَ نّ عَبَدَن عِ شَ وَلِ شَ قٍ رَ.","poem":1},{"lineBreak":true},{"text":"ﭑ شَشِلِ تِشِ عِ شِلِ قَنيِ نَن نَ عِ شَ دَنشَنِيَتْييٍ تَفِ،","poem":1},{"lineBreak":true},{"text":"بَرِ مَ عِ قَن.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}