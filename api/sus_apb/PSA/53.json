:5,"content":[{"lineBreak":true},{"text":"تِنشِنتَرٍيٍ شَشِلِ مُ نَ؟","poem":1},{"lineBreak":true},{"text":"عٍ نُ ﭑ مَ حَمَ تْورْ تُن.","poem":1},{"lineBreak":true},{"text":"عٍ مُ عَلَ شِلِمَ قٍوٌ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عٍ قَمَ سّرّندٍ فَاشُي رَ نَ نَن مَ،","poem":1},{"lineBreak":true},{"text":"بَرِ مَ عَلَ قَمَ نَ مِشِ مْولِيٍ رَيٍنسٍندٍ،","poem":1},{"lineBreak":true},{"text":"نَشٍيٍ وَ مَ وٌ تْورْقٍ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ندٍ كٍلِمَ سِيٌن عَ شَ عِسِرَيِلَ رَكِسِ؟","poem":1},{"lineBreak":true},{"text":"عَلَ نَ عَ شَ حَمَ رَ مِنِ كٌنيِيَ كُي،","poem":1},{"lineBreak":true},{"text":"يَشُبَ بْنسْي سّيوَ مَ نّ، عِسِرَيِلَ حّلّشِنمَ نّ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}