{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":54,"content":[{"type":"heading","content":["ﭑ مَرِفِ تِمَ ﭑ بُن مَ"]},{"type":"heading","content":["عَلَ مَشَندِ"]},{"type":"verse","number":1,"content":[{"text":"دَوُدَ شَ لْننِ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ شُي رَ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"سِقِكَيٍ تٌ عَ قَلَ سْلُ بّ عَ دَوُدَ عَ نْشُنشِ عٍ شْنيِ، دَوُدَ نَشَ يِ بّيتِ بَ.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"عَلَ، ﭑ نَكِسِ عِ شِلِ رَ، ﭑ مَ كِيتِ سَ عِ سّنبّ رَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"عَلَ، ﭑ مَ دُبّ سُشُ، عِ تُلِ مَتِ ﭑ مَ وْيّنيِ رَ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"شْحّ ندٍيٍ بَرَ كٍلِ ﭑ شِلِ مَ،","poem":1},{"lineBreak":true},{"text":"مِشِ كٌبِ نَشٍيٍ وَ مَ ﭑ قَشَقٍ.","poem":1},{"lineBreak":true},{"text":"عٍ مُ عَلَ كٌلٌن قٍقٍ مَ. حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عَلَ ﭑ مَلِمَ، ﭑ مَرِفِ تِمَ ﭑ بُن مَ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عَ ﭑ يَشُييٍ شَ كٌبِحَ سَرٍ رَفبِلٍنمَ عٍ مَ.","poem":1},{"lineBreak":true},{"text":"عِ شَ عٍ هَلَكِ عِ شَ دُفُتّفّحَ كُي.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ﭑ بَرَ عَ حَنِفٍ ﭑ شَ سّرّشّ بَ عِ بّ.","poem":1},{"lineBreak":true},{"text":"عَلَتَلَ، ﭑ عِ شِلِ تَنتُمَ نّ بَرِ مَ عِ قَن،","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"عِ مَن ﭑ نَكِسِمَ ﭑ مَ تْورّ كُي، ﭑ قَ نْ ﭑ يَشُييٍ رَ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}