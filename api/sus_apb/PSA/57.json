{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":57,"content":[{"type":"heading","content":["ﭑ بَرَ لِمَنِيَ سْتْ"]},{"type":"heading","content":["عَلَ مَشَندِ"]},{"type":"verse","number":1,"content":[{"text":"دَوُدَ شَ سُوكِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «عِ نَشَ هَلَكِ تِ.» دَوُدَ نَشَ يِ بَ عَ تٌ عَ فِ سْلُ مَ، عَ سَ سٌ قْنمّ كُي.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"عَلَ، هِننّ ﭑ نَ، يَندِ عِ شَ هِننّ ﭑ نَ.","poem":1},{"lineBreak":true},{"text":"ﭑ مَرَتَنفّ قٍنمَ عِ يِرٍ","poem":1},{"lineBreak":true},{"text":"عَلْ تْشّيْرّ عَ قٍنمَ عَ نفَ فَبُتٍنيِ بُن مَ كِ نَشّ","poem":1},{"lineBreak":true},{"text":"هَن قٍ شْرْشْي شَ دَنفِ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ﭑ بَرَ عَلَ شِلِ شُنفبٍ كَنيِ مَشَندِ","poem":1},{"lineBreak":true},{"text":"نَشَن ﭑ مَ قٍ بِرِن سْونّيَمَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ﭑ شْنمِشِيٍ ﭑ حَشَنكَتَمَ تّمُي نَشّ،","poem":1},{"lineBreak":true},{"text":"عَلَ ﭑ نَكِسِمَ نّ كٍلِقٍ عَرِيَننَ، حّنفِ رَتٍ","poem":1},{"lineBreak":true},{"text":"عَ هِننّ نُن نْندِ رَفٌرٌ مَ ﭑ مَ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"يّتّيٍ بَرَ ﭑ نَبِلِن،","poem":1},{"lineBreak":true},{"text":"ﭑ سَشِ عٍ تَفِ، عٍ تَن نَشٍيٍ عَدَ مَدِيٍ قَشَمَ.","poem":1},{"lineBreak":true},{"text":"عٍ حِنيِيٍ لُشِ عَلْ تَنبّيٍ،","poem":1},{"lineBreak":true},{"text":"عٍ نّنيِيٍ لُشِ عَلْ سَنتِدّفّمَ نَشَن بَشِ عَ تّي عِ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عَلَ، عِ شَ عِ شَ بِنيّ مَسٍن كٌورٍ مَ،","poem":1},{"lineBreak":true},{"text":"عِ شَ عَ مَسٍن بْشِ مَ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عٍ بَرَ يّلّ تِ ﭑ يَ رَ، عَ فبٍ مُ لُشِ ﭑ شَ سٌ عَ رَ.","poem":1},{"lineBreak":true},{"text":"عٍ بَرَ يِلِ فٍ ﭑ يَ رَ، كْنْ عٍ تَن نَن بِرَشِ عَ كُي. حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عَلَ، ﭑ بْحّ بَرَ لِمَنِيَ، ﭑ بَرَ لِمَنِيَ سْتْ.","poem":1},{"lineBreak":true},{"text":"ﭑ بّيتِ بَمَ نّ، ﭑ عِ تَنتُمَ نّ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ﭑ بْحّ بَرَ كٍلِ ﭑ نَ،","poem":1},{"lineBreak":true},{"text":"ﭑ شَ ﭑ مَ كْرَيٍ تٌنفٌ، ﭑ شَ بّيتِ بَ هَن سُبَشّ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"مَرِفِ، ﭑ عِ تَنتُمَ نّ سِيٍ تَفِ.","poem":1},{"lineBreak":true},{"text":"ﭑ بّيتِ بَمَ نّ عِ بّ بْنسْييٍ تَفِ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"عِ شَ هِننّ كٌورٍ لِمَ نّ،","poem":1},{"lineBreak":true},{"text":"عِ شَ تِنشِنيِ تٍمَ نّ هَن نُشُييٍ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"عَلَ، عِ شَ عِ شَ بِنيّ مَسٍن كٌورٍ مَ،","poem":1},{"lineBreak":true},{"text":"عِ شَ عَ مَسٍن بْشِ مَ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/58.json"