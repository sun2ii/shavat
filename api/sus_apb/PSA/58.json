نّ عَلْ بْشِمَسٍ شْنّ،","poem":1},{"lineBreak":true},{"text":"عَلْ بْشِمَسٍ نَشَن مُ بْشِمَسٍ سُشُي شُي رَ مّمَ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"هَلِ بْشِمَسٍ سُشُي قَنيِ، عَ مُ نْمَ عَ سُشُدٍ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"عَلَ، عِ شَ عٍ حِنيِ كَنَ عٍ دّ عِ،","poem":1},{"lineBreak":true},{"text":"بَرِ مَ عٍ لُشِ نّ عَلْ يّتّ.","poem":1},{"lineBreak":true},{"text":"عَلَتَلَ، عِ شَ عٍ دّ وَنوَن.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عٍ حْنمَ نّ عَلْ يٍ نَشَن عِقِلِمَ بْشِ.","poem":1},{"lineBreak":true},{"text":"عٍ شَ تَنبّ مُ حّرّ مَ سّنبّ رَ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"عَ لُمَ عَلْ بٌي نَشَن قَتٍ لْيمَ لِنفِ كُي.","poem":1},{"lineBreak":true},{"text":"عَ لُمَ عَلْ دِ نَشَن بَشِ عَ نفَ قَتٍ عِ، عَ مُ قٌيٍ تٌ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"بٍينُن تُندٍ شَ قُرَ يٍفٍ مَلِنسِنشِ رَ،","poem":1},{"lineBreak":true},{"text":"شَ نَ مُ عَ رَ يٍفٍ شَرٍ رَ،","poem":1},{"lineBreak":true},{"text":"عَلَ عٍ كْمَ نّ، عَ عٍ وْلّ عَ عِ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"مِشِ تِنشِنشِ قَمَ حّلّشِندٍ","poem":1},{"lineBreak":true},{"text":"بَرِ مَ عَ قَمَ فبٍحْشْي سْتْدٍ.","poem":1},{"lineBreak":true},{"text":"عَ قَمَ عَ سَنيِ مَشَدٍ مِشِ حَاشِ وُلِ رَ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"عَدَ مَدِيٍ قَمَ عَ قَلَدٍ،","poem":1},{"lineBreak":true},{"text":"«عِيٌ، عَلَ مِشِ تِنشِنشِ سَرٍ قِمَ.","poem":1},{"lineBreak":true},{"text":"عِيٌ، عَلَ كِيتِ سَمَ نّ دُنِحَ مَ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}