{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":60,"content":[{"type":"heading","content":["عَلَ قَمَ شُننَكٍلِ رَ"]},{"type":"heading","content":["عَلَ مَشَندِ"]},{"type":"verse","number":1,"content":[{"text":"دَوُدَ شَ لْننِ سُوكِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «قُفٍ تٌقَنيِ عَلْ عَلَ شَ سَاتّ.»","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"عِسِرَيِلَ تٌ سِرٍنِكَيٍ فٍرٍ، عٍ يِ بّيتِ بَ نَ تّمُي نّ. عٍ نُ كٍلِشِ مٍسٌثٌتَمِيَ نُن سٌبَ بْشِ مَ. يٌوَبَ نَشَ عٍدٌنكَ وُلُ قُ نُن قِرِن قَشَ قٌلٍ كُي قْشْي نَ دّننَشّ.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"عَلَ، عِ بَرَ مُشُ رَلْي،","poem":1},{"lineBreak":true},{"text":"عِ بَرَ ندٍ بَ مُشُ شَ فَلِ رَ،","poem":1},{"lineBreak":true},{"text":"عِ بَرَ شْنْ مُشُ مَ،","poem":1},{"lineBreak":true},{"text":"كْنْ يَكْسِ، عِ شَ سّنبّ قِ مُشُ مَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"عِ بَرَ بْشِ رَ سّرّن،","poem":1},{"lineBreak":true},{"text":"عِ بَرَ عَ عِبْو.","poem":1},{"lineBreak":true},{"text":"عِ شَ نَ يَءِلَن مُشُ بّ","poem":1},{"lineBreak":true},{"text":"بَرِ مَ بْشِ وَ مَ كَنَقٍ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"عِ بَرَ قٍ شْرْشْييٍ دْشْ عِ شَ مِشِيٍ مَ،","poem":1},{"lineBreak":true},{"text":"هَن عٍ بَرَ لُ عَلْ سِيسِلَ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"كْنْ نَشٍيٍ فَاشُشِ عِ يَ رَ،","poem":1},{"lineBreak":true},{"text":"عِ بَرَ تْنشُمَ سٌ عٍ يِ رَ،","poem":1},{"lineBreak":true},{"text":"عٍ شَ نْ عٍ يَشُييٍ رَ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"عِ شَ عِ شَنُنتٍنيِيٍ رَكِسِ عِ سّنبّ رَ،","poem":1},{"lineBreak":true},{"text":"عِ شَ مُشُ شَ دُبّ سُشُ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"عَلَ شَ مَسٍنيِ نَن يَ،","poem":1},{"lineBreak":true},{"text":"عَ نَشَن قَلَشِ هْرْ مْبَنشِ سّنِيّنشِ كُي،","poem":1},{"lineBreak":true},{"text":"«ﭑ سِكٍمِ تَا قِمَ نّ وٌ مَ شُننَكٍلِ كُي،","poem":1},{"lineBreak":true},{"text":"ﭑ سُكْتِ فٍيَ لَنبَنيِ قَن قِ وٌ مَ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"فَلَدِ بْشِ، ﭑ فبٍ. مَنَسِ بْشِ، ﭑ فبٍ.","poem":1},{"lineBreak":true},{"text":"عٍقِرَ مِكَيٍ نَن قِندِ مَ ﭑ مَ فٍرٍ سٌي رَ.","poem":1},{"lineBreak":true},{"text":"ﭑ مَنفّ دْشْمَ نّ يُدَيَ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"مٌوَبَكَيٍ قِندِ مَ ﭑ مَ كٌنيِيٍ نَن نَ.","poem":1},{"lineBreak":true},{"text":"عٍدٌن قِندِ ﭑ مَ بْشِ رَ.","poem":1},{"lineBreak":true},{"text":"ﭑ فٍرٍ شُي رَتٍمَ نّ قِلِسِتَ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"عَلَ، ندٍ نْمَ ﭑ شَنِندٍ نَ تَا مَكَنتَشِ كُي؟","poem":1},{"lineBreak":true},{"text":"ندٍ نْمَ ﭑ شَنِندٍ هَن عٍدٌن بْشِ مَ؟","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"عِ تَن فبَنسَن، عِ تَن نَشَن مُشُ رَلْي،","poem":1},{"lineBreak":true},{"text":"عِ تَن نَشَن مُ نُ 