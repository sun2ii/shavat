ak":true},{"text":"عٍ دُبّ تِمَ عٍ دّ رَ، كْنْ عٍ دَنكّ تَن تِمَ عٍ بْحّ رَ. حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ﭑ بْحّسَ سْتْمَ عَلَ نَن نَ،","poem":1},{"lineBreak":true},{"text":"بَرِ مَ ﭑ شَشِلِ تِشِ عَ تَن نَن نَ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عَ لُشِ عَلْ قَنيٍ نَ عَ رَ ﭑ بّ،","poem":1},{"lineBreak":true},{"text":"ﭑ مَ مَرَكِسِمَ نُن ﭑ مَ مَكَنتَمَ نَن عَ رَ.","poem":1},{"lineBreak":true},{"text":"ﭑ مُ نْمَ بِرَدٍ سْنْن.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ﭑ مَ كِسِ نُن ﭑ مَ بِنيّ نَ عَلَ نَن يِ.","poem":1},{"lineBreak":true},{"text":"عَلَ ﭑ مَكَنتَمَ نَن عَ رَ، ﭑ يِفِ تِدٍ نَن عَ رَ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"حَمَ، وٌ شَ وٌ تَشُ عَ رَ،","poem":1},{"lineBreak":true},{"text":"وٌ شَ وٌ شَ كْنتْقِلِ مَسٍن عَ بّ.","poem":1},{"lineBreak":true},{"text":"عَ تَن نَن نْمَ وٌن مَلِدٍ. حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"عَدَ مَدِيٍ لُمَ عَلْ قٌيٍ نَشَن دَنفِمَ.","poem":1},{"lineBreak":true},{"text":"مِشِ شُنفبٍ قِندِ مَ مِشِ شُرِ رَ،","poem":1},{"lineBreak":true},{"text":"شَ عٍ شَ قٍ بَرَ مَنِيَ، عَ يٍلٍبُ عَلْ قٌيٍ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"وٌ نَشَ هَرِفٍ قٍن قٍ كٌبِ رَ،","poem":1},{"lineBreak":true},{"text":"وٌ نَشَ عَ قٍن مُحّ رَ.","poem":1},{"lineBreak":true},{"text":"شَ وٌ شَ نَاقُلِ سَ فبٌ،","poem":1},{"lineBreak":true},{"text":"وٌ نَشَ وٌ شَشِلِ تِ نَ رَ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"عَلَ بَرَ قٍ قِرِن قَلَ ﭑ نَشٍيٍ مّشِ.","poem":1},{"lineBreak":true},{"text":"كٍرٍن، سّنبّ نَ عَلَ بّ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"عَ قِرِن ندٍ، ﭑ مَرِفِ نَن هِننّنتٍ رَ،","poem":1},{"lineBreak":true},{"text":"بَرِ مَ عَ مِشِيٍ سَرٍ رَفبِلٍنمَ عٍ مَ.","poem":1}]}],"footnotes":[]