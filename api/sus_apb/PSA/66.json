{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":66,"content":[{"type":"heading","content":["عَلَ شَ كَابَنَكٌي مَفَاشُ"]},{"type":"heading","content":["عَلَ مَتْشْي"]},{"type":"hebrew_subtitle","content":["بّيتِ نُن سُوكِ بّيتِبَيٍ شَ مَنفّ بّ"]},{"type":"verse","number":1,"content":[{"text":"عَدَ مَدِيٍ بِرِن شُي شَ عِتٍ سّيوّ رَ عَلَ بّ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"وٌ شَ عَ شِلِ بِنيَ بّيتِ رَ،","poem":1},{"lineBreak":true},{"text":"وٌ شَ عَ بِنيَ مَتْشْي رَ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"وٌ شَ عَ قَلَ عَلَ بّ،","poem":1},{"lineBreak":true},{"text":"«عِ شَ كَابَنَكٌي مَفَاشُ.","poem":1},{"lineBreak":true},{"text":"عِ سّنبّ فبٌ هَن. هَلِ عِ يَشُييٍ سّرّنمَ عِ يَ رَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"دُنِحَ بِرِن عِ بَتُمَ،","poem":1},{"lineBreak":true},{"text":"عٍ عِ بِنيَ بّيتِ رَ، عٍ عِ شِلِ مَتْشْ.» حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"وٌ قَ عَلَ شَ وَلِ مَتٌدٍ.","poem":1},{"lineBreak":true},{"text":"عَ نَ قٍ رَبَ عَدَ مَدِيٍ تَفِ، نَ مَفَاشُ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عَ بَا قِندِ شَرٍ رَ،","poem":1},{"lineBreak":true},{"text":"عَ مِشِ رَفِرِ شُرٍ مَ عٍ سَنيِ شَرَشِ رَ.","poem":1},{"lineBreak":true},{"text":"نَ كُي، وٌن حّلّشِنمَ نّ عَ رَ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عَ دُنِحَ يَمَرِ مَ سّنبّ رَ عَبَدَن.","poem":1},{"lineBreak":true},{"text":"عَ يَ تِشِ سِيٍ رَ، مَتَندِلَيٍ مُ نْمَ كٍلِدٍ سْنْن. حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"سِيٍ، وٌ شَ وٌن مَرِفِ عَلَ تَنتُ،","poem":1},{"lineBreak":true},{"text":"وٌ شَ وٌ شُي رَ مِنِ عَ مَتْشْقٍ رَ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"عَ بَرَ سِمَيَ قِ وٌن مَ،","poem":1},{"lineBreak":true},{"text":"عَ مُ تِن وٌن شَ بِرَ،","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"بَرِ مَ عَلَ وٌن بْحّ كٌلٌن.","poem":1},{"lineBreak":true},{"text":"عَ بَرَ وٌن مَتٌ عَلْ مِشِ فبٍتِ مَتٌمَ كِ نَشّ","poem":1},{"lineBreak":true},{"text":"عَ عَ رَشُنُ عَلَكٌ عَ فبِ شَ بَ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"عِ بَرَ مُشُ شُن تِ يّلّ كُي رَ،","poem":1},{"lineBreak":true},{"text":"عِ مَن بَرَ كٌتٍ دْشْ مُشُ شُن مَ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"عِ بَرَ عَ لُ مِشِيٍ شَ نْ مُشُ رَ،","poem":1},{"lineBreak":true},{"text":"مُشُ شَ تْورْ يٍ نُن تّ شْورَ.","poem":1},{"lineBreak":true},{"text":"كْنْ عَ رَحْنيِ، عِ بَرَ مُشُ شُن تِ دَشَمُي يِرٍ رَ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ﭑ قَمَ سّرّشّ فَن دَاشِ رَ عِ شَ بَنشِ كُي،","poem":1},{"lineBreak":true},{"text":"ﭑ نَن ﭑ مَ لَايِدِ رَكَمَلِمَ نّ،","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ﭑ نَشٍيٍ قَلَ ﭑ دّ رَ ﭑ نُ تْورّ كُي تّمُي نَشّ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ﭑ شُرُ سٍ تُرَشِيٍ بَمَ نّ سّرّشّ فَن دَاشِ رَ،","poem":1},{"lineBreak":true},{"text":"عَلْ يّشّي كٌنتٌنيِيٍ، تُورَيٍ، نُن سِ دٌنبِيٍ. حّنفِ رَتٍ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"وٌ قَ، وٌ شَ وٌ تُلِ مَتِ،","poem":1},{"lineBreak":true},{"text":"وٌ تَن نَشٍيٍ فَاشُمَ عَلَ يَ رَ.","poem":1},{"lineBreak":true},{"text":"ﭑ شَ عَ مَسٍن عَلَ نَشَن نَبَشِ ﭑ بّ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ﭑ بَرَ عَ شِلِ، ﭑ بَرَ عَ مَتْشْ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"شَ يَنقَنتٍيَ نُ نَ ﭑ بْحّ كُي نُ،","poem":1},{"lineBreak":true},{"text":"ﭑ مَرِفِ مُ نُ عَ تُلِ مَتِمَ ﭑ نَ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"كْنْ عَلَ بَرَ ﭑ شُي رَ مّ،","poem":1},{"lineBreak":true},{"text":"عَ ﭑ مَ دُبّ سُشُ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"تَنتُي نَ عَلَ بّ نَشَن بَرَ ﭑ مَ مَشَندِ شُي مّ،","poem":1},{"lineBreak":true},{"text":"عَ مَن بَرَ هِننّ ﭑ نَ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}