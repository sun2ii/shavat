{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":75,"content":[{"type":"heading","content":["عَلَ شَ كِيتِ"]},{"type":"heading","content":["عَلَ مَتْشْي"]},{"type":"verse","number":1,"content":[{"text":"عَسَقِ شَ بّيتِ بّيتِبَيٍ مَنفّ بّ. عَ شَ بَ عَلْ بّيتِ نَشَن شِلِ «عِ نَشَ كَسَرّ تِ.»","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"مُشُ مَرِفِ عَلَ، مُشُ بَرَ عِ مَتْشْ.","poem":1},{"lineBreak":true},{"text":"مَتْشْي نَ عِ بّ، عِ تَن نَشَن نَ مُشُ سّيتِ مَ،","poem":1},{"lineBreak":true},{"text":"عِ تَن نَشَن شَ كَابَنَكٌي قَلَمَ يِرٍ بِرِن.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"عِ نَشّ، «ﭑ مَ وَشَتِ سُفَندِشِ نَ عَ لِ،","poem":1},{"lineBreak":true},{"text":"ﭑ تَن نَن كِيتِ سَمَ تِنشِنيِ رَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"دُنِحَ نُن عَ شَ مِشِيٍ قَمَ شُنُدٍ،","poem":1},{"lineBreak":true},{"text":"كْنْ ﭑ تَن نَن عَ كِنكِيٍ سّنبّ سٌمَ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ﭑ عَ قَلَمَ يّتّ عِفبٌي نُن مِشِ كٌبِيٍ بّ،","poem":1},{"lineBreak":true},{"text":"‹وٌ نَشَ وٌ يّتّ عِفبٌ، وٌ نَشَ وٌ شُنيِ عِتٍ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"وٌ نَشَ وٌ شُنيِ عِتٍ كٌورٍ مَ،","poem":1},{"lineBreak":true},{"text":"وٌ بَ يّتّ عِفبٌحَ وْيّنيِ قَلَقٍ رَ.›»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"وٌ شَ عَ كٌلٌن شُننَكٍلِ مُ كٍلِمَ سٌفٍتٍدٍ،","poem":1},{"lineBreak":true},{"text":"عَ مُ كٍلِمَ سٌفٍفٌرٌدٍ، عَ مُ كٍلِمَ فبٍنفبٍرٍنيِ مَ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عَلَ نَن كِيتِ سَمَ،","poem":1},{"lineBreak":true},{"text":"عَ مِشِ ندٍ شَ قٍ رَفٌرٌ، عَ مِشِ ندٍ شَ قٍ عِتٍ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"تْنبِلِ ندٍ نَ عَلَتَلَ شْنيّ،","poem":1},{"lineBreak":true},{"text":"وّنِ شَاحّ رَقَلَشِ نَ نَشَن كُي.","poem":1},{"lineBreak":true},{"text":"عَ نَ سٌمَ دُنِحَ مِشِ حَاشِيٍ نَن يِ،","poem":1},{"lineBreak":true},{"text":"عٍ عَ مِن هَن عَ حْن.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ﭑ نَ مَسٍنيِ تِمَ تّمُي بِرِن،","poem":1},{"lineBreak":true},{"text":"ﭑ يَشُبَ مَرِفِ عَلَ مَتْشْمَ بّيتِ رَ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«ﭑ مِشِ حَاشِيٍ شَ يّتّ عِفبٌحَ شُن نَكَنَمَ نّ،","poem":1},{"lineBreak":true},{"text":"ﭑ تِنشِنتْييٍ شُن نَكٍلِ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}