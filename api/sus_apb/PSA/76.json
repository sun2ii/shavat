{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":76,"content":[{"type":"heading","content":["عَلَ شَ شُننَكٍلِ"]},{"type":"heading","content":["عَلَ مَتْشْي"]},{"type":"verse","number":1,"content":[{"text":"عَسَقِ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ كْرَ شُي رَ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"عَلَ كٌلٌنشِ يُدَيَ بْشِ مَ، عَ شِلِ فبٌ عِسِرَيِلَ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"عَ شْنيِ نَ سَلَمُ، عَ شَ بَنشِ نَ سِيٌن.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"عَ فٍرٍ سٌسٍيٍ عَلْ شَلِيٍ، وُرٍ لٍقَيٍ، نُن سَنتِدّفّمَيٍ كَنَ مّننِ نّ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"عِ شَ نْرّ فبٌ عَلْ كٌيِنمَ،","poem":1},{"lineBreak":true},{"text":"نَشَن فبِلٍن كٍلِقٍ فٍيَيٍ مَ، سُبٍيٍ وُيَ دّننَشّ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"عِ بَرَ نْ سّنبّمَيٍ رَ، نَشٍيٍ مُ شُنُمَ سْنْن،","poem":1},{"lineBreak":true},{"text":"نَشٍيٍ مُ نْ فٍرٍ تِدٍ عِ كَنكٍ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عِ تَن يَشُبَ مَرِفِ عَلَ تٌ كٍلِ عٍ شِلِ مَ،","poem":1},{"lineBreak":true},{"text":"عٍ شَ سٌي رَفِيٍ نُن عٍ شَ سٌي نَشَ هَلَكِ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عِ مَفَاشُ! عِ شَ شْنّ كُي، ندٍ سُو سَمَ عِ يَ رَ؟","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"عِ تٌ كِيتِ سَ كٌورٍ مَ، دُنِحَ نَشَ سَبَرِ فَاشُي كُي.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"عِ شَ كِيتِ نَشَ تْورْ مِشِيٍ رَكِسِ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"عِ شَ شْنّ عِبُنَدَ مَ مَبِرِ قِندِشِ عِ مَتْشْي نَن نَ.","poem":1},{"lineBreak":true},{"text":"عِ شَ بْحّتٍ لُشِ نّ عَلْ بّلّتِ عِ عِ تَفِ عِشِرِ مَ نَشَن نَ فٍرٍ كُي.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"وٌ شَ وٌ شَ دَاكَن نَكَمَلِ وٌ مَرِفِ عَلَتَلَ بّ،","poem":1},{"lineBreak":true},{"text":"وٌ شَ قَ سّرّشّيٍ رَ عَ شْن مَ،","poem":1},{"lineBreak":true},{"text":"وٌ تَن نَشٍيٍ بِرِن عَ رَبِلِنشِ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"عَ تَن نَن حّنفِ بَمَ سّنبّمَيٍ قَتٍ عِ،","poem":1},{"lineBreak":true},{"text":"عَ مَفَاشُ دُنِحَ مَنفّيٍ بّ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}