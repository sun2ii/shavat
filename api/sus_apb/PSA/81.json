{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":81,"content":[{"type":"heading","content":["تُلِ مَتِقٍ عَلَ مَ"]},{"type":"heading","content":["عَلَ مَشَندِ"]},{"type":"verse","number":1,"content":[{"text":"عَسَقِ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ مَشَسٍ لُوتِ دَاشِ شُي رَ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"وٌ شَ سّيوَ شُي رَتٍ عَلَ مَ،","poem":1},{"lineBreak":true},{"text":"نَشَن قِندِشِ وٌن سّنبّ رَ.","poem":1},{"lineBreak":true},{"text":"وٌ وٌ شُي رَ سِفَ يَشُبَ مَرِفِ عَلَ مَ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"وٌ شَ بّيتِ بَ مَشَسٍ نُن كْرَ شُي رَ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"وٌ شَ قٍرِ قٍ كِكٍ نّينّ تٍ تّمُي،","poem":1},{"lineBreak":true},{"text":"وٌن مَ سَلِ لْشْي نَ عَ رَ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"نَ قِندِشِ عَلَ شَ سّرِيّ نَن نَ عِسِرَيِلَ بّ،","poem":1},{"lineBreak":true},{"text":"يَشُبَ مَرِفِ عَلَ شَ يَامَرِ نَ عَ رَ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"يَامَرِ نَ عَ رَ عَلَ نَشَن سٌ يُسُقُ بْنسْي يِ رَ،","poem":1},{"lineBreak":true},{"text":"عَ تٌ مِنِ مِسِرَ بْشِ شِلِ مَ.","poem":1},{"lineBreak":true},{"text":"ﭑ نَشَ شُي ندٍ مّ ﭑ مُ نَشَن كٌلٌن، عَ نَشّ،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«ﭑ بَرَ كٌتٍ بَ عٍ شُن مَ،","poem":1},{"lineBreak":true},{"text":"ﭑ بَرَ دٍبٍ بِنيٍ بَ عٍ بّلّشّيٍ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"وٌ تٌ ﭑ شِلِ وٌ شَ حَشَنكَتّ كُي،","poem":1},{"lineBreak":true},{"text":"ﭑ نَشَ وٌ رَكِسِ، ﭑ نَشَ وٌ يَابِ كٍلِقٍ سٍسَرِنيِ يِرٍ،","poem":1},{"lineBreak":true},{"text":"ﭑ نَشَ وٌ مَتٌ مٍرِبَ يٍ يِرٍ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ﭑ مَ حَمَ عِسِرَيِلَ، وٌ وٌ تُلِ مَتِ ﭑ مَ مَرَ سِ رَ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"وٌ نَشَ عَلَ فبّتّ بَتُ،","poem":1},{"lineBreak":true},{"text":"وٌ نَشَ وٌ شِنبِ سِن عَلَ فبّتّ مَ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ﭑ تَن نَن نَ وٌ مَرِفِ عَلَ رَ،","poem":1},{"lineBreak":true},{"text":"نَشَن وٌ رَ مِنِ مِسِرَ بْشِ رَ.","poem":1},{"lineBreak":true},{"text":"وٌ وٌ دّ رَبِ عَ بٍلٍبٍلٍ رَ، ﭑ عَ رَقٍمَ نّ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«كْنْ ﭑ مَ حَمَ مُ عَ تُلِ مَتِشِ ﭑ نَ،","poem":1},{"lineBreak":true},{"text":"عِسِرَيِلَ مُ ﭑ شُي رَتِنمّ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"نَ كُي ﭑ نَشَ عٍ لُ عٍ شَ بْحّ شْرْشْيَ كُي،","poem":1},{"lineBreak":true},{"text":"عٍ شَ حّرّ عٍ يّتّ شَشِلِ مَ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"شَ عَ سَ لِ نُ ﭑ مَ حَمَ نَشَ عَ تُلِ مَتِ ﭑ نَ،","poem":1},{"lineBreak":true},{"text":"شَ عِسِرَيِلَ سَ تِن ﭑ مَ كِرَ رَ نُ،","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ﭑ قَمَ نّ عَ يَشُي بِرِن نَيَافِدٍ كٍرٍن نَ،","poem":1},{"lineBreak":true},{"text":"ﭑ عٍ رَفٌرٌ تّمُي بِرِن.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"عَلَتَلَ يَشُييٍ قَمَ فَاشُدٍ عَ يَ رَ،","poem":1},{"lineBreak":true},{"text":"عٍ هَلَكِ عَبَدَن.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"كْنْ ﭑ وٌ تَن بَلٌمَ نّ دٌنسٍ قَنيِ رَ،","poem":1},{"lineBreak":true},{"text":"ﭑ كُمِ رَ مِنِمَ نّ فّمّ كُي وٌ بّ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":17}