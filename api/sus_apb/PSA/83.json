r":6,"content":[{"lineBreak":true},{"text":"عٍ بَرَ لَن عٍ بٌورٍ مَ عِ شِلِ مَ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"عٍدٌنكَيٍ، سُمَيِلَ بْنسْي، مٌوَبَكَيٍ، هَفَرِكَيٍ،","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"فٍبَلَكَيٍ، عَمٌنِكَيٍ، عَمَلّكِكَيٍ،","poem":1},{"lineBreak":true},{"text":"قِلِسِتَكَيٍ، تِرٍكَيٍ،","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"نُن عَسِرِيَكَيٍ بِرِن بَرَ كَقُ لٌتِ بْنسْي مَ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"عِ شَ عٍ بْنبْ عَلْ عِ عَ رَبَ مَدِيَنكَيٍ رَ كِ نَشّ.","poem":1},{"lineBreak":true},{"text":"عِ شَ عٍ بْنبْ عَلْ عِ عَ رَبَ مَنفّ يَبِنِ نَ كِ نَشّ،","poem":1},{"lineBreak":true},{"text":"عَ نُن عَ شَ سْورِ مَنفّ سِسٍرَ رَ كِ نَشّ كِسٌن شُرٍ يِرٍ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"عٍ سْنتْ نّ عٍندٌرِ،","poem":1},{"lineBreak":true},{"text":"عٍ قُرٍ نَشَ لُ بْشِ مَ، عٍ مُ رَفَتَ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"عِ شَ قٍ شْرْشْي رَبَ عٍ شَ كُنتِفِيٍ رَ،","poem":1},{"lineBreak":true},{"text":"عَلْ عِ رَبَ عٌرٍبِ نُن سٍيبِ رَ كِ نَشّ.","poem":1},{"lineBreak":true},{"text":"عٍ شَ يَرٍرَتِيٍ شَ لُ عَلْ سّبَ نُن سَلَمُنَ، نَشٍيٍ عَ قَلَ،","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"«وٌن شَ عَلَ شَ حَمَ شَ بْشِ قِندِ وٌن فبٍ رَ.»","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ﭑ مَرِفِ عَلَ، عِ شَ نَ مِشِيٍ لُ عَلْ سّشّ، قٌيٍ نَشَن شَنِنمَ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"عِ شَ عٍ شُن نَكَنَ عَلْ تّ قْتْنيِ فَنمَ كِ نَشّ فٍيَيٍ قَرِ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"عِ شَ بِرَ عٍ قْشْ رَ شْنّ كُي عَلْ تُرُننَادّ مَفَاشُشِ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"مَرِفِ، عِ شَ عٍ رَيَافِ عَلَكٌ