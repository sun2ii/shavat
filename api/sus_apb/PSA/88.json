{"translation":{"id":"sus_apb","name":"Ala xa Kitaabui Sosoe bɛ","website":"https://ebible.org/Scriptures/details.php?id=susa","licenseUrl":"https://ebible.org/Scriptures/details.php?id=susa","licenseNotes":null,"shortName":"APB","englishName":"Susu Bible (Arabic script)","language":"sus","textDirection":"rtl","sha256":"36d7ef927b0820dd63b4eac75f29bcd742c39589e2fe7c36b3f766ddf9cb880f","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_apb/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_apb","name":"يَبُرَ","commonName":"يَبُرَ","title":"يَبُرَ دَوُدَ يَبُرَ دَوُدَ","order":19,"numberOfChapters":150,"sha256":"2f7ddc351a3a3da0364fe84ec94997ca573d539eb13e0f4789f2abc6c5dd544c","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_apb/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_apb/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":88,"content":[{"type":"heading","content":["سَيَ كِرَ"]},{"type":"heading","content":["عَلَ مَشَندِ"]},{"type":"verse","number":1,"content":[{"text":"كٌرَ شَ دِيٍ شَ بّيتِ بّيتِبَيٍ شَ مَنفّ بّ. عَ شَ بَ شُلٍ رَ. هٍمَن عٍسِرَكَ شَ لْننِ بّيتِ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"مَرِفِ، ﭑ نَكِسِمَ عَلَ،","poem":1},{"lineBreak":true},{"text":"ﭑ عِ شِلِمَ يَنيِ نُن كْي رَ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"عِ شَ ﭑ مَ مَشَندِ سُشُ،","poem":1},{"lineBreak":true},{"text":"عِ شَ ﭑ مَ دُبّ تٌنفٌ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ﭑ بَرَ تْورْ ﭑ مَ دُنِحّءِفِرِ كُي،","poem":1},{"lineBreak":true},{"text":"يَكْسِ ﭑ بَرَ مَكْرّ سَيَ رَ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ﭑ نَ مِشِيٍ يَ مَ نَشٍيٍ نَ سَيَ كِرَ شْن مَ.","poem":1},{"lineBreak":true},{"text":"ﭑ سّنبّ يٌ مُ نَ سْنْن.","poem":1}]},{"type":"verse","number":6,