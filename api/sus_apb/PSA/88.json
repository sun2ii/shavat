"poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ﭑ نَ تْورّ كُي كَبِ ﭑ دِ مّدِ تّمُي.","poem":1},{"lineBreak":true},{"text":"ﭑ فَاشُشِ، شَشِلِسَ بِرِن بَرَ بَ ﭑ يِ رَ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"عِ شَ شْنّ سّنبّ بَرَ دَنفِ عَ عِ،","poem":1},{"lineBreak":true},{"text":"عِ شَ قٍ مَفَاشُشِيٍ بَرَ نْ ﭑ نَ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"عٍ ﭑ نَبِلِنشِ عَلْ بَنبَرَنيِ،","poem":1},{"lineBreak":true},{"text":"عٍ دُ سُ ﭑ شُن نَ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"عِ بَرَ ﭑ شَنُنتٍنيِيٍ بِرِن مَكُيَ ﭑ نَ،","poem":1},{"lineBreak":true},{"text":"ﭑ دْشْبٌورٍ بَرَ كٍلِ ﭑ شُن مَ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":19}