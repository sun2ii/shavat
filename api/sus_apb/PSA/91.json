rue},{"text":"«عَ تٌ لَشِ ﭑ نَ، ﭑ عَ رَكِسِمَ نّ.","poem":1},{"lineBreak":true},{"text":"ﭑ عَ مَكَنتَمَ نّ بَرِ مَ عَ ﭑ شِلِ كٌلٌن.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"عَ نَ ﭑ شِلِ، ﭑ عَ يَابِمَ نّ.","poem":1},{"lineBreak":true},{"text":"تْورّ نَ عَ لِ، ﭑ لُمَ نّ عَ سّيتِ مَ.","poem":1},{"lineBreak":true},{"text":"ﭑ عَ رَكِسِمَ نّ، ﭑ عَ شُن نَكٍلِ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ﭑ سِمَيَ شْنكُيٍ قِمَ نّ عَ مَ،","poem":1},{"lineBreak":true},{"text":"ﭑ نَ ﭑ مَ كِسِ مَسٍن عَ بّ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}