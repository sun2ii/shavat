umber":6,"content":[{"lineBreak":true},{"text":"مَرِفِ، عِ نَشَن نَبَمَ، عَ مَكَابَ، عِ شَشِلِ تِلِن.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"شَشِلِتَرٍ مُ سٍسٍ كٌلٌنمَ نَ كُي،","poem":1},{"lineBreak":true},{"text":"عَ مُ قَهَامُي سْتْمَ عِ شَ قٍ مَ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"عَلَ كٌلٌنتَرٍيٍ لُمَ عَلْ سَنسِ","poem":1},{"lineBreak":true},{"text":"نَشَن بُلَمَ قِيلِ مَ، عَ قُفَ،","poem":1},{"lineBreak":true},{"text":"كْنْ نَ دَنفِ شَنبِ، عَ حْن عَبَدَن.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"كْنْ عِ تَن مَرِفِ، مَتْشْي نَ عِ بّ تّمُي بِرِن.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ﭑ مَرِفِ، عِ يَشُييٍ هَلَكِمَ نّ،","poem":1},{"lineBreak":true},{"text":"عِ قٍ كٌبِ رَبَيٍ بِرِن نَيٍنسٍن يّ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"عِ سّنبّ قِمَ نّ ﭑ مَ عَلْ سّشّ نِنفٍ،","poem":1},{"lineBreak":true},{"text":"عِ تُرٍ قَنيِ سَ ﭑ مَ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ﭑ يَيٍ عَ تٌمَ ﭑ فٍرٍقَيٍ شُن فٌرٌ مَ كِ نَشّ،","poem":1},{"lineBreak":true},{"text":"ﭑ تُلِ عٍ فِ شُي مّ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"تِنشِنتْييٍ شَ قٍ قَنمَ نّ عَلْ تُفِ بِلِ،","poem":1},{"lineBreak":true},{"text":"عٍ شَ قٍ تٍ عَلْ سّدِرِ وُرِ بِلِ نَشٍيٍ نَ لِبَن.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"عٍ سَبَتِشِ عَلَتَلَ شَ هْرْ مْبَنشِ تّتّ كُي،","poem":1},{"lineBreak":true},{"text":"عٍ شَ قٍ قَنمَ نّ وٌن مَرِفِ عَلَ يَ عِ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"هَلِ عٍ قٌرِشِ عٍ شُنسّشّ قِيشّشِ،","poem":1},{"lineBreak":true},{"text":"سّنبّ نَ عٍ بّ قٍ قَنيِ رَبَقٍ رَ،","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"عَلَكٌ عٍ شَ عَ مَسٍن،","poem":1},{"lineBreak":true},{"text":"«عَلَتَلَ 