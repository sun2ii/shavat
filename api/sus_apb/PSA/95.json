},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"وٌ قَ، وٌن شَ سُيِدِ، وٌن شَ وٌن عِفٌرٌ،","poem":1},{"lineBreak":true},{"text":"وٌن شَ وٌن شِنبِ سِن عَلَتَلَ يَ عِ نَشَن وٌن دَا،","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"بَرِ مَ عَ تَن نَن وٌن مَرِفِ عَلَ رَ.","poem":1},{"lineBreak":true},{"text":"وٌن قِندِشِ عَ شَ حَمَ نَن نَ عَ نَشَن دّ مَدٌنمَ،","poem":1},{"lineBreak":true},{"text":"عَلْ شُرُ سٍ دّ مَدٌنيِ مّينِمَ فْورّ مَ كِ نَشّ.","poem":1},{"lineBreak":true},{"text":"وٌ شَ عَ شُي مّ تٌ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"وٌ نَشَ وٌ بْحّيٍ رَشْرْشْ عَلْ نَشَن نَبَشِ مٍرِبَ،","poem":1},{"lineBreak":true},{"text":"عَلْ نَشَن نَبَشِ مَسَ فبٍنفبٍرٍنيِ مَ تّمُي دَنفِشِ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"وٌ بٍنبَيٍ ﭑ مَتٌ نّ نَ لْشْي،","poem":1},{"lineBreak":true},{"text":"هَلِ عٍ تٌ نُ بَرَ ﭑ وَلِ قْشِ تٌ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"نَ بْنسْي شَ قٍ نَشَ رَحَاشُ ﭑ مَ حّ تٌنفٌ نَانِ بُن مَ.","poem":1},{"lineBreak":true},{"text":"ﭑ نَشَ عَ قَلَ، «حَمَ شُرُتَرٍ نَن يِ كِ،","poem":1},{"lineBreak":true},{"text":"نَشَن مُ ﭑ وَشْنقٍ كٌلٌن.»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"نَ كُي ﭑ نَشَ ﭑ كَلِ ﭑ مَ شْنّ كُي،","poem":1},{"lineBreak":true},{"text":"«عٍ مُ سٌمَ ﭑ مَ مَلَبُدٍ كُي قٍقٍ مَ!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_apb/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_apb/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_apb/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}