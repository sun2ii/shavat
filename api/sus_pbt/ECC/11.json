{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"ECC","translationId":"sus_pbt","name":"Kawandila","commonName":"Kawandila","title":"Kawandila xa Kitaabui Kawandila xa Kitaabui","order":21,"numberOfChapters":12,"sha256":"7e450e99aca2e578870e5d9c84433e39bc3eb92a1ac1f2501e72cdf3b4e02a0d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/sus_pbt/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["Wakilife"]},{"type":"verse","number":1,"content":["Taali ndee nan yi ki:",{"text":"Xa i taami woli ye ma,","poem":1},{"lineBreak":true},{"text":"i fama nɛ a masɔtɔde lɔxɔɛ nde.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I xa i xa sɔtɔse taxu mixi solofere ra,","poem":1},{"lineBreak":true},{"text":"xa na mu a ra, mixi solomasaxan,","poem":1},{"lineBreak":true},{"text":"barima i mu a kolon ɲaxankatɛ naxan fama duniɲa lide.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xa nuxui rafexi ye ra,","poem":1},{"lineBreak":true},{"text":"tunɛ fama nɛ birade bɔxi ma.","poem":1},{"lineBreak":true},{"text":"Xa wuri bira yire fanyi ma, xa a bira kɔɔla ma,","poem":1},{"lineBreak":true},{"text":"a luma naa nɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mixi yo bɔnbɔ foye rabɛnfe ra, na mu sansi sima.","poem":1},{"lineBreak":true},{"text":"Mixi yo bɔnbɔ nuxui matofe ra, na mu fama sansi xabade.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I mu ɲɛngi nun xɔrie rafala ki kolon furi ginɛ furi kui,","poem":1},{"lineBreak":true},{"text":"i man mu Ala Daali Mangɛ xa wali fan kolon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"I xa wakili kelife gɛɛsɛgɛ han nunmare sansi sife ra,","poem":1},{"lineBreak":true},{"text":"barima i mu a kolon i xa wali mundun fama sɔɔnɛyade.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Naiyalanyi tofe ɲɔxun.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A lanma mixi xa sɛɛwa a xa simaya ra,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a naxa nɛɛmu dimi ma naxan nu na a xa simaya kui.","poem":1},{"lineBreak":true},{"text":"Fe naxan birin fama, fe fufafu na a ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Fonike, i xa ɲɛlɛxin i xa fonikeya kui,","poem":1},{"lineBreak":true},{"text":"i sondonyi xa sɛɛwa i xa fonikeya waxati kui.","poem":1},{"lineBreak":true},{"text":"I xa bira i bɔɲɛ nun i waxɔnfe fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"kɔnɔ i xa a kolon a Ala i makiitima nɛ na birin ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na kui kɔntɔfili makuya i ra,","poem":1},{"lineBreak":true},{"text":"tɔɔrɛ keri i fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"Fonikeya findixi fe fufafu nan na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}