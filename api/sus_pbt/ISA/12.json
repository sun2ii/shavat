{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"ISA","translationId":"sus_pbt","name":"Annabi Esayi","commonName":"Annabi Esayi","title":"Ala xa masenyi Annabi Esayi bɛ Ala xa masenyi Annabi Esayi bɛ","order":23,"numberOfChapters":66,"sha256":"2eba6ff6ac39626ce84ab919b8e03175dab1e346f01a4e0263d0ad9312c4aeb0","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/sus_pbt/ISA/66.json","totalNumberOfVerses":1291},"chapter":{"number":12,"content":[{"type":"heading","content":["Marakisi Mangɛ xa matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Na lɔxɔɛ wo fama nɛ a falade,","poem":1},{"lineBreak":true},{"text":"«Muxu bara i tan Alatala matɔxɔ.","poem":1},{"lineBreak":true},{"text":"I nu bara xɔnɔ muxu ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ i xa xɔnɛ bara gbilen muxu fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"i fa muxu madundu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muxu Rakisima nan na Ala ra.","poem":1},{"lineBreak":true},{"text":"Muxu bara la i ra, sese mu muxu magaaxuma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"barima i tan Alatala nan na muxu sɛnbɛ ra,","poem":1},{"lineBreak":true},{"text":"i tan nan na muxu xa kisi ra.","poem":1},{"lineBreak":true},{"text":"Na bara a niya muxu xa bɛɛti ba i matɔxɔfe ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wo fama nɛ ye bade kisi dulonyi kui sɛɛwɛ ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na lɔxɔɛ, wo fama nɛ a falade,","poem":1},{"lineBreak":true},{"text":"«Wo xa Alatala matɔxɔ,","poem":1},{"lineBreak":true},{"text":"wo xa a xili masen duniɲa bɛ,","poem":1},{"lineBreak":true},{"text":"wo xa a xa wali fanyie fala ɲamanɛ ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wo xa Alatala matɔxɔ bɛɛtie ra a xa kaabanakoe xa fe ra.","poem":1},{"lineBreak":true},{"text":"Wo xa duniɲa birin nakolon a xa nɔrɛ ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wo tan Siyonikae, wo xa wo xui ramini sɛɛwɛ ra,","poem":1},{"lineBreak":true},{"text":"barima Isirayila xa Sɛniyɛntɔɛ sɛnbɛ gbo wo tagi!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}