{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JER","translationId":"sus_pbt","name":"Annabi Yeremi","commonName":"Annabi Yeremi","title":"Ala xa masenyi Annabi Yeremi bɛ Ala xa masenyi Annabi Yeremi bɛ","order":24,"numberOfChapters":52,"sha256":"d6fac946d17b5fd83d1d68d95903f1fc9a1868bd69a844fe1471d8231a618df4","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/sus_pbt/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Masenyi Filisitakae bɛ"]},{"type":"verse","number":1,"content":[{"text":"Alatala bara yi masenyi ti Annabi Yeremi bɛ","poem":1},{"lineBreak":true},{"text":"Filisitakae xa fe ra beenu Misira mangɛ xa Gasa gere.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Alatala xa masenyi nan ya:","poem":1},{"lineBreak":true},{"text":"Mixi fama nɛ kelife kɔɔla ma","poem":1},{"lineBreak":true},{"text":"naxee luxi alɔ ye xungbe xure kui,","poem":1},{"lineBreak":true},{"text":"naxan banbaranma, a fa taae kana.","poem":1},{"lineBreak":true},{"text":"Taakae birin e wa xui raminima nɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Soe nun sɔɔri ragisee xui na taa li,","poem":1},{"lineBreak":true},{"text":"babae mu e xa die malima,","poem":1},{"lineBreak":true},{"text":"sɛnbɛmae mu sɛnbɛtaree malima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Filisitakae gbaloe lɔxɔɛ bara a li.","poem":1},{"lineBreak":true},{"text":"Tire nun Sidɔn mu Filisitakae xa mali sɔtɔma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"barima Alatala bara e sɔntɔ a nun Kafatorokae.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Gasa bara kana, Asikalɔn bara a sabari.»","poem":1},{"lineBreak":true},{"text":"«Mixi naxee luxi fiili ma,","poem":1},{"lineBreak":true},{"text":"wo wo yɛtɛ maxabama sunnunyi kui han mun tɛmui?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wo a falama, ‹Alatala xa santidɛgɛma walima han mun tɛmui?","poem":1},{"lineBreak":true},{"text":"A raso a tɛɛ kui, i bɔɲɛ magoro!›","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N xa a fala wo bɛ, a santidɛgɛma malabuma di?","poem":1},{"lineBreak":true},{"text":"Alatala nan a yamarixi,","poem":1},{"lineBreak":true},{"text":"a xa siga han Asikalɔn baa dɛ ra.","poem":1},{"lineBreak":true},{"text":"A xa wali nan na ki.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}