{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Sofara xa masenyi singe"]},{"type":"heading","content":["«Ayuba, i xa tuubi Ala ma»"]},{"type":"verse","number":1,"content":[{"text":"Sofara Naamaka naxa a fala,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«A mu lan mixi xa i xa yi masenyi gbegbe yaabi?","poem":1},{"lineBreak":true},{"text":"Masenyi ratofanxi mu nɔndi fima masenyi ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I ɲɔxɔ a ma a mixi dunduma i xa wɔyɛnyie ma,","poem":1},{"lineBreak":true},{"text":"i xa yo Ala ma, mixi yo mu i rayaagi?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I naxɛ, ‹Sese mu luxi n ma lɔnni ra,","poem":1},{"lineBreak":true},{"text":"n bara sɛniyɛn Ala ya i.›","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xa Ala sa wɔyɛn i bɛ nu,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"a a xa lɔnni gundo masenma nɛ i bɛ,","poem":1},{"lineBreak":true},{"text":"naxan dangima adamadi xa fe to ki ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I nɔma Ala xa tilinyi kolonde?","poem":1},{"lineBreak":true},{"text":"I nɔma Ala Sɛnbɛ Kanyi xaxili birin fahaamude?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Na lɔnni ite koore xa maite bɛ, a tilin aligiyama bɛ.","poem":1},{"lineBreak":true},{"text":"I nɔma sode na kui?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A kuya bɔxi bɛ,","poem":1},{"lineBreak":true},{"text":"a xa gboe dangi baa ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xa Ala sa mixi suxu, a fa a makiiti,","poem":1},{"lineBreak":true},{"text":"nɔndi luma na kanyi bɛ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala mixi ɲaaxie kolonma,","poem":1},{"lineBreak":true},{"text":"a tinxintaree toma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xaxilitare mu nɔma findide lɔnnila ra,","poem":1},{"lineBreak":true},{"text":"alɔ sofale fan to mu nɔma findide adamadi ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xa i tan i yɛtɛ ragbilen Ala ma,","poem":1},{"lineBreak":true},{"text":"xa i i bɛlɛxɛ itala a bɛ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"xa i gbilen tinxintareya fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"xa i a matanga i xa denbaya kui,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"na kui i xunnakeli sɔtɔma nɛ,","poem":1},{"lineBreak":true},{"text":"i sɛnbɛ sɔtɔ, i limaniya a fanyi ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Na tɛmui i nɛɛmuma nɛ i xa tɔɔrɛ ma,","poem":1},{"lineBreak":true},{"text":"alɔ xure naxan bara dangi a rakuya.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I xa duniɲɛigiri yanbama nɛ alɔ soge,","poem":1},{"lineBreak":true},{"text":"i xa dimi bama nɛ,","poem":1},{"lineBreak":true},{"text":"a lu alɔ kuye na iba.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I bɔɲɛ a raxarama nɛ, xaxili tide lu i bɛ,","poem":1},{"lineBreak":true},{"text":"fe ɲaaxi a makuyama nɛ i ra, i xi xɔli fanyi raba.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I na i sa, mixi yo mu i xa xi xɔli kanama i ma.","poem":1},{"lineBreak":true},{"text":"Mixie fama nɛ i xa hinnɛ e ra.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kɔnɔ tinxintaree xa fe xun nakanama nɛ,","poem":1},{"lineBreak":true},{"text":"e mu kisima, faxɛ nan e mamɛxi.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}