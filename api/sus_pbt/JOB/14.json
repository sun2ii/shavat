{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"heading","content":["Ayuba xa masenyi naani nde"]},{"type":"heading","content":["«Adama xa duniɲɛigiri xɔrɔxɔ»"]},{"type":"verse","number":1,"content":[{"text":"«Adama, ginɛ bari di,","poem":1},{"lineBreak":true},{"text":"a xa simaya dunke, kɔntɔfili gbo a ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A luxi nɛ alɔ fuge naxan minima, a fa xaba.","poem":1},{"lineBreak":true},{"text":"A luxi nɛ alɔ niini naxan mu buma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I wama n maniyafe na nan na, i xa n makiiti?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nde nɔma sɛniyɛnyi raminide sɛniyɛntareɲa kui?","poem":1},{"lineBreak":true},{"text":"Mixi yo!","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xa i tan nan mixi xa simaya kɔnti ragirixi,","poem":1},{"lineBreak":true},{"text":"xa i tan nan natɛ tongoxi a xa simaya kɔnti dande ma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"i xa gbilen a fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"alako a xa a malabu alɔ walikɛ a malabuma ki naxɛ wali raɲɔnyi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«Xa wuri bili na a ra nu,","poem":1},{"lineBreak":true},{"text":"a na xaba, a xuntunyi man gbilenma nɛ ɲingi ra,","poem":1},{"lineBreak":true},{"text":"a salonyie man fan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xa a sanke sa bu bɔxi bun ma,","poem":1},{"lineBreak":true},{"text":"a xuntunyi tan naxa faxa bɛndɛ kui,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"tunɛ birɛ, a man nɔma findide a ra alɔ a singe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɔnɔ adamadi tan,","poem":1},{"lineBreak":true},{"text":"xa a faxa, a sɛnbɛ birin ɲɔnma nɛ,","poem":1},{"lineBreak":true},{"text":"a mu baloxi sɔnɔn.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Baa nun xure nɔma xɔride,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"kɔnɔ adamadi laaxiraxi mu kelima,","poem":1},{"lineBreak":true},{"text":"fo koore xa ɲɔn, a fa xunu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"A xɔli n ma i xa n nɔxun aligiyama,","poem":1},{"lineBreak":true},{"text":"han i xa xɔnɛ dangima tɛmui naxɛ, i fa ratu n ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɔnɔ Adama na faxa, a man gbilenma balo ra?","poem":1},{"lineBreak":true},{"text":"N mamɛ tima nɛ n ma wali kui,","poem":1},{"lineBreak":true},{"text":"han n ɲɔxɔɛ fa tɛmui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I na n xili, n fama i xa xili ratinde,","poem":1},{"lineBreak":true},{"text":"barima i wama nɛ i xa daali xɔn.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yakɔsi i n sanyi tongo ki birin igbɛma.","poem":1},{"lineBreak":true},{"text":"I mu n ma yunubie toma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N ma fe ɲaaxie nɔxun bɛki kui, n ma yunubie xafari!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"«Kɔnɔ geya birama a yensen yɛ,","poem":1},{"lineBreak":true},{"text":"fanye tala a yire,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ye kira rabɔɔ gɛmɛe xɔn ma,","poem":1},{"lineBreak":true},{"text":"a bɔxi bɛndɛ xanin a xun.","poem":1},{"lineBreak":true},{"text":"I fan adamadi xaxili tide rabama na ki nɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I nɔma adama ra, a fa faxa.","poem":1},{"lineBreak":true},{"text":"I na gɛ a tɔɔrɔde, i a xanin aligiyama.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Xa a xa die binyɛ sɔtɔma, a mu na kolon.","poem":1},{"lineBreak":true},{"text":"Xa binyɛ bama e ma, a mu na toma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Adama xa tɔɔrɛ gbo duniɲa bɛndɛ fuɲi fari,","poem":1},{"lineBreak":true},{"text":"a bɔɲɛ luma sunnunyi kui.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}