{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Ayuba xa masenyi suuli nde"]},{"type":"heading","content":["«Ayuba xa seede na koore ma»"]},{"type":"verse","number":1,"content":[{"text":"Ayuba naxa a yaabi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«N bara wo xa masenyi maniyɛ gbegbe mɛ.","poem":1},{"lineBreak":true},{"text":"Wo mu fata mixi madundude.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wo xa masenyie maniya foye ra.","poem":1},{"lineBreak":true},{"text":"E ɲɔnma tɛmui mundun?","poem":1},{"lineBreak":true},{"text":"N ma yaabie bara wo raxɔnɔ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xa wo tan nan nu na tɔɔrɔfe,","poem":1},{"lineBreak":true},{"text":"n tan fan nu nɔma wɔyɛnde nɛ alɔ wo tan,","poem":1},{"lineBreak":true},{"text":"n wo tɔɔɲɛgɛ, n yo wo ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɔnɔ n tan mu nu na rabama,","poem":1},{"lineBreak":true},{"text":"n wo sɛnbɛ soma n ma wɔyɛnyie nan na nu, n dɛ wo ralimaniya.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"«N ma wɔyɛnyi mu n ma tɔɔrɛ bama,","poem":1},{"lineBreak":true},{"text":"n ma sabari fan mu a makuyama n na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yakɔsi fa, n bara tagan.","poem":1},{"lineBreak":true},{"text":"Ala, i bara n ma denbaya birin halaki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I bara n fate birin ba n ma,","poem":1},{"lineBreak":true},{"text":"na bara findi seede ra n xili ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala xa xɔnɛ bara dutun n ma,","poem":1},{"lineBreak":true},{"text":"a bara n tɔɔrɔ a ɲaaxi ra,","poem":1},{"lineBreak":true},{"text":"alɔ n yaxui nɔma a rabade ki naxɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N yaxuie fe ɲaaxi falama n ma fe ra,","poem":1},{"lineBreak":true},{"text":"e n nayaagima, e n bɔnbɔma.","poem":1},{"lineBreak":true},{"text":"E birin e malanma n xili ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala mu n natanga fonike karinxie ma,","poem":1},{"lineBreak":true},{"text":"a n so mixi ɲaaxie yi ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N nu bɔɲɛsa nan kui,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a naxa n suxu,","poem":1},{"lineBreak":true},{"text":"a n imaxa, a n xun nakana.","poem":1},{"lineBreak":true},{"text":"N bara lu alɔ se a luma naxan bɔnbɔ ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A xa tanbɛe n nabilinxi yire birin,","poem":1},{"lineBreak":true},{"text":"e bara n bɔɲɛ sɔxɔ kinikinitareɲa kui,","poem":1},{"lineBreak":true},{"text":"e n furingɛe ramini kɛnɛ ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A n gerema alɔ geresoe xaaɲɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N bara sunnun donma ragoro n fate ma,","poem":1},{"lineBreak":true},{"text":"n bara n xun sin bɔxi ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wa bara n yae gbeeli,","poem":1},{"lineBreak":true},{"text":"saya bara makɔrɛ n na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kɔnɔ n mu fe ɲaaxi yo rabaxi.","poem":1},{"lineBreak":true},{"text":"N nu Ala maxandima sɛniyɛnyi nan kui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Bɛndɛ, i naxa dusu n wuli xun na,","poem":1},{"lineBreak":true},{"text":"a lu n wa xui xa makɛnɛn yire birin.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«Kelife yakɔsi ma fa, n ma seede na koore ma,","poem":1},{"lineBreak":true},{"text":"n xunmafalama na yire itexi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N booree na yofe n ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ n nan n mawama Ala nan bɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N seede xa n xun mafala Ala xɔn ma,","poem":1},{"lineBreak":true},{"text":"alɔ mixi a boore xun mafalama ki naxɛ,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"a xa n xun mafala barima a gbe mu luxi n xa siga,","poem":1},{"lineBreak":true},{"text":"n mu gbilenma sigɛ naxan kui.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}