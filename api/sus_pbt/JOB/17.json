{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"heading","content":["Ayuba xa masenyi suuli nde dɛ idɔxɔɛ"]},{"type":"heading","content":["«N xaxili tixi gaburi nan na»"]},{"type":"verse","number":1,"content":[{"text":"«N na n nii magagafe,","poem":1},{"lineBreak":true},{"text":"a gbe mu luxi n ma simaya ra, gaburi a dɛ rabixi n ya ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mixie na yofe n ma, n mu nɔma xide.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala, yandi, taani n bɛ,","poem":1},{"lineBreak":true},{"text":"mixi gbɛtɛ yo mu tinma na rabade,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"barima i bara n booree xaxili balan.","poem":1},{"lineBreak":true},{"text":"I naxa a lu e xa nɔ n na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E luma alɔ xɛmɛ naxan donse fima mixi gbɛtɛe ma,","poem":1},{"lineBreak":true},{"text":"a xa di kaamɛxi ya xɔri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mixi birin n mayelema,","poem":1},{"lineBreak":true},{"text":"e e dɛ ye bɔxunma n yatagi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N ya mu fa sese toma maraɲaaxui xa fe ra,","poem":1},{"lineBreak":true},{"text":"n fate birin bara ba n ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tinxintɔɛe kaabama n ma,","poem":1},{"lineBreak":true},{"text":"e fa xɔnɔ tinxintaree ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tinxintɔɛ luma a xa kira xɔn,","poem":1},{"lineBreak":true},{"text":"sɛniyɛntɔɛ sɛnbɛ xun masama.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wo tan birin nɔma fade,","poem":1},{"lineBreak":true},{"text":"kɔnɔ n mu laxi a ra xa n lɔnnila keren toma wo ya ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ma simaya kɔnti bara ɲɔn,","poem":1},{"lineBreak":true},{"text":"n mu gɛxi n ma walie ra,","poem":1},{"lineBreak":true},{"text":"n waxɔnfe mu sɔɔnɛyaxi n bɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yi tinxintaree fe mafindima,","poem":1},{"lineBreak":true},{"text":"a falafe ra a dimi nan na naiyalanyi ra.","poem":1},{"lineBreak":true},{"text":"E naxɛ a naiyalanyi bara makɔrɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ e na falama dimi nan kui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N xaxili tixi aligiyama nan na fa,","poem":1},{"lineBreak":true},{"text":"n xa sa bɛlɛ dimi kui,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"gaburi xa findi n baba ra,","poem":1},{"lineBreak":true},{"text":"kuli xa findi nga nun n maaginɛ ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N xaxili tixi munse ra sɔnɔn?","poem":1},{"lineBreak":true},{"text":"N xaxili tide yo mu na fa.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N xaxili tide na aligiyama nan na,","poem":1},{"lineBreak":true},{"text":"n goroma dɛnnaxɛ bɛndɛ xɔɔra.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}