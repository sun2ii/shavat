{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Bilidada Suuxaka xa masenyi firin nde"]},{"type":"heading","content":["«Mixi ɲaaxie xa xunnakanɛ»"]},{"type":"verse","number":1,"content":[{"text":"Bilidada Suuxaka naxa a fala,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Wo yi masenyi mɔɔli danma tɛmui mundun?","poem":1},{"lineBreak":true},{"text":"Wo xa xaxili sɔtɔ alako won xa wɔyɛn a fanyi ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wo muxu maɲɔxunxi subee ra munfe ra?","poem":1},{"lineBreak":true},{"text":"Munfe ra muxu findixi wo bɛ xaxilitare ra?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ayuba, i tan naxan xɔnɔxi, duniɲa xa dan i xa fe ra?","poem":1},{"lineBreak":true},{"text":"Geya xa tala i bɛ a tide?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«N xa a fala wo bɛ,","poem":1},{"lineBreak":true},{"text":"mixi ɲaaxi xa fe ɲɔnma nɛ,","poem":1},{"lineBreak":true},{"text":"alɔ tɛ xubenma ki naxɛ, a ba naiyalanyi raminife.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A xa denbaya xa fe ɲɔnma nɛ,","poem":1},{"lineBreak":true},{"text":"a yɛtɛ xa fe danma nɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A mu a ɲɛrɛma sɛnbɛ ra sɔnɔn,","poem":1},{"lineBreak":true},{"text":"a waxɔnfe fama nɛ a xun nakanade.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A bara suxu yɛlɛ ra,","poem":1},{"lineBreak":true},{"text":"a mu minima naxan kui sɔnɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Gantanyi bara a sanyi suxu,","poem":1},{"lineBreak":true},{"text":"a mu a bama naxan yi sɔnɔn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Gantanyi luuti nu nɔxunxi bɛndɛ bun ma,","poem":1},{"lineBreak":true},{"text":"gantanyi nu texi sankira xɔn ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Gaaxui bara a suxu a xa fe birin kui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kaamɛ bara a suxu, a bara lu tɔɔrɛ kui.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A fate bara ba a ma,","poem":1},{"lineBreak":true},{"text":"a salonse na bɔrɔfe saya kira xɔn ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A bara keli a xɔnyi a nu laxi dɛnnaxɛ ra,","poem":1},{"lineBreak":true},{"text":"a na sigafe mangɛ magaaxuxi yire.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I nɔma lude a xa banxi kui,","poem":1},{"lineBreak":true},{"text":"a gbe mu luxi sɔnɔn.","poem":1},{"lineBreak":true},{"text":"Aligiyama bara findi a xɔnyi ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A sankee bara xara,","poem":1},{"lineBreak":true},{"text":"a salonyie bara lisi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Duniɲa mixie bara nɛɛmu a ma,","poem":1},{"lineBreak":true},{"text":"e mu ratuma a xili ma sɔnɔn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A bara keli naiyalanyi kui,","poem":1},{"lineBreak":true},{"text":"a so dimi kui duniɲa fari ma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Di mu a bɛ, i fa a i nɛ mamadi.","poem":1},{"lineBreak":true},{"text":"A nu sabatixi dɛnnaxɛ,","poem":1},{"lineBreak":true},{"text":"bɔnsɔɛ yo mu a bɛ mɛnni sɔnɔn.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bɔnsɔɛ naxee sa fama, keli sogetede nun sogegorode,","poem":1},{"lineBreak":true},{"text":"nee fama nɛ kaabade a xa xunnakanɛ ma, gaaxui fa e suxu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Tinxintare xa maraɲɔnyi luma na ki nɛ,","poem":1},{"lineBreak":true},{"text":"Ala kolontare xa fe rabama na ki nɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}