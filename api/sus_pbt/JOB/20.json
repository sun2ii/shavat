{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Sofara xa masenyi firin nde"]},{"type":"heading","content":["«Tɔɔrɛ nan na tinxintare kɛ ra»"]},{"type":"verse","number":1,"content":[{"text":"Sofara Naamaka naxa a fala,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«I xa masenyi bara n tɔɔrɔ,","poem":1},{"lineBreak":true},{"text":"fo n xa i yaabi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N bara marakɔrɔsi nde mɛ","poem":1},{"lineBreak":true},{"text":"naxan bara n xaxili ifu.","poem":1},{"lineBreak":true},{"text":"N i yaabima n ma lɔnni ra na nan ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I mu a kolon kabi adama naxa daa, a lu duniɲa ma,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"mixi ɲaaxie xa xunnakeli mu buma?","poem":1},{"lineBreak":true},{"text":"E xa ɲɛlɛxinyi dunke?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hali a xa fe gbo yɛ,","poem":1},{"lineBreak":true},{"text":"hali a xunyi koore li,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"a fama sɔntɔde a lu alɔ se naxan tide mu na,","poem":1},{"lineBreak":true},{"text":"a kolonmae nu fa maxɔrinyi ti, ‹A na minden?›","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A dangima nɛ alɔ xiye.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A kolonmae mu a toma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"a lɔɛma nɛ a xa mixie ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A xa die setaree kima see ra,","poem":1},{"lineBreak":true},{"text":"e baba naxee muɲa.","poem":1},{"lineBreak":true},{"text":"E baba xa naafuli gbilenma nɛ na mixie ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Sɛnbɛ naxan nu na a yi ra a fonike ra,","poem":1},{"lineBreak":true},{"text":"na birin kanama nɛ, a findi bɛndɛ ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fe ɲaaxi na rafan mixi ma,","poem":1},{"lineBreak":true},{"text":"a fa na ragata a furi kui,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"a mu a bɛɲin,","poem":1},{"lineBreak":true},{"text":"a mu gbilen na fɔxɔ ra,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"a xa donse findima pɔsɔnɛ nan na a furi kui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A naafuli naxan donxi, a fama na bɔxunde.","poem":1},{"lineBreak":true},{"text":"Ala yati na bama nɛ a furi kui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A bɔximase xa xɔnɛ nan bɛsuma,","poem":1},{"lineBreak":true},{"text":"biida nan a faxama.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A harige naxan sɔtɔxi,","poem":1},{"lineBreak":true},{"text":"naxan bara gbo yɛ alɔ xure,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"a na birin nagbilenma nɛ,","poem":1},{"lineBreak":true},{"text":"a mu nɔma na sese donde.","poem":1},{"lineBreak":true},{"text":"Na mu findima ɲɛlɛxinyi ra a bɛ,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"barima a bara se ba tɔɔrɔmixie yi ra.","poem":1},{"lineBreak":true},{"text":"A bara e xa banxie ba e yi ra, a mu naxee tixi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wasabali nan to nu a ra a xa milɛ kui,","poem":1},{"lineBreak":true},{"text":"a harige keren mu ratangama.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A to nu se birin maɲɔxunxi a yɛtɛ nan bɛ,","poem":1},{"lineBreak":true},{"text":"a xa hɛɛri mu buma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A nɛ na a xa fanyi tagi,","poem":1},{"lineBreak":true},{"text":"tɔɔrɔ sin tɛmui nan na ki a ma.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A dɛge tɛmui, Ala fama a tɔɔrɔde a xa xɔnɛ ra,","poem":1},{"lineBreak":true},{"text":"na tɔɔrɛ fa findi a xa donse ra.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Xa geresose lanmadi mu a tɔɔrɔ,","poem":1},{"lineBreak":true},{"text":"geresose xungbe nan nawalima a xili ma.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Hali a tanbɛ tala e a sɔxɔxi naxan na,","poem":1},{"lineBreak":true},{"text":"fe magaaxuxi gbɛtɛ fama nɛ a lide.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A xa naafuli birin luma dimi nan kui,","poem":1},{"lineBreak":true},{"text":"tɛ fa na birin gan a xɔnyi.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Ala a xa yunubi makɛnɛn ma,","poem":1},{"lineBreak":true},{"text":"adamadie na sare ragbilen a ma.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"A xa naafuli birin sigama nɛ","poem":1},{"lineBreak":true},{"text":"Ala xa xɔnɛ lɔxɔɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Ala na nan fima mixi ɲaaxi ma kɛ ra.","poem":1},{"lineBreak":true},{"text":"Na bara findi Ala ɲanige ra na mixi mɔɔli bɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}