{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Ayuba xa masenyi solomasaxan nde"]},{"type":"heading","content":["«Ala na minden?»"]},{"type":"verse","number":1,"content":[{"text":"Ayuba naxa a yaabi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«To fan n ma yaxaseri masa xɔrɔxɔ,","poem":1},{"lineBreak":true},{"text":"a xa kote gbo n xun,","poem":1},{"lineBreak":true},{"text":"n sɛnbɛ bara ɲɔn.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xa a sa li n nu nɔma Ala tode nu,","poem":1},{"lineBreak":true},{"text":"xa a sa li n nu nɔma sigade a xɔnyi nu,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n nan n xaxili kui ifee birin falama nɛ a bɛ nu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na kui n nu nɔma nɛ a xa yaabi kolonde,","poem":1},{"lineBreak":true},{"text":"alako n xa fahaamui sɔtɔ na kui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A fama a sɛnbɛ birin naminide n ma kiitife ra?","poem":1},{"lineBreak":true},{"text":"Ade, a a yae nan tima n na tun.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na tɛmui a n ma tinxinyi toma nɛ,","poem":1},{"lineBreak":true},{"text":"a fa nɔndi fi n ma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Kɔnɔ Ala mu toma sogetede,","poem":1},{"lineBreak":true},{"text":"a mu toma sogegorode.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N a fenma kɔɔla ma, n a fenma yirefanyi ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a mu toma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɔnɔ a tan n toma a fanyi ra.","poem":1},{"lineBreak":true},{"text":"A na gɛ n tode, a nɔndi fima n ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N biraxi nɛ a fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"n a xa sɛriyɛ birin nabatu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N mu a xa yaamarie bɛɲinxi.","poem":1},{"lineBreak":true},{"text":"A waxɔnfe findixi nɛ n waxɔnfe ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Nde nɔma a xa natɛ tongoxi masarade?","poem":1},{"lineBreak":true},{"text":"A wama naxan xɔn, a na nan nabama.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A naxan ɲanigexi n ma fe ra,","poem":1},{"lineBreak":true},{"text":"a fama na nan nagiride n ma.","poem":1},{"lineBreak":true},{"text":"A fama fe gbɛtɛe fan sade na fari.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Na nan a toma n gaaxuma a ya ra.","poem":1},{"lineBreak":true},{"text":"N na a xa fe maɲɔxun, n mu suusama.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ala bara limaniya ba n yi,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanyi bara n magaaxu,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"kɔnɔ n mu dunduma na dimi xa fe ra,","poem":1},{"lineBreak":true},{"text":"na dimi mu nɔma n na.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}