uie mu sɛniyɛn a ya i,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"adamadi go,","poem":1},{"lineBreak":true},{"text":"naxan xurun alɔ kuli,","poem":1},{"lineBreak":true},{"text":"naxan findixi kuli yɔrɛ di gbansan na?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}