{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Ayuba xa masenyi solomanaani nde"]},{"type":"heading","content":["«Nde nɔma Ala sɛnbɛ fahaamude?»"]},{"type":"verse","number":1,"content":[{"text":"Ayuba naxa a yaabi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«I fata sɛnbɛtare malide.","poem":1},{"lineBreak":true},{"text":"I fata mixi ralimaniyade.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I fata lɔnnitare raside.","poem":1},{"lineBreak":true},{"text":"I xaxili fanyi masenma,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"kɔnɔ i na masenma nde bɛ?","poem":1},{"lineBreak":true},{"text":"Nde na xaxili fixi i ma?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Mixi faxaxie sɛrɛnma baa nun bɔxi bun ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Aligiyama naadɛ rabixi Ala ya tode ra,","poem":1},{"lineBreak":true},{"text":"a naa igbɛxi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ala nan koore daaxi,","poem":1},{"lineBreak":true},{"text":"a a singan kuye ma,","poem":1},{"lineBreak":true},{"text":"a bɔxi singan a yɛtɛ ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A tunɛ ye ragatama nuxuie kui,","poem":1},{"lineBreak":true},{"text":"ye xa binyɛ man mu nɔ e bɔɔde.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A a xa kibanyi ya makotoxi nuxuie nan na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A naaninyi saxi naiyalanyi nun dimi tagi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Koore sɛrɛnma, a kaabama Ala xaaɲɛ xui mɛfe ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A sɛnbɛ baa imaxama,","poem":1},{"lineBreak":true},{"text":"a baa yɛxɛe magaaxuxi ibɔɔma a xaxili fanyi ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A kɛrɛ foye koore rasɛniyɛnma,","poem":1},{"lineBreak":true},{"text":"a bɛlɛxɛ bɔximase gixi sɔxɔma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xa yee findixi a xa wali xurie nan na,","poem":1},{"lineBreak":true},{"text":"won mu nɔma naxee fahaamude a fanyi ra,","poem":1},{"lineBreak":true},{"text":"nde nɔma a sɛnbɛ magaaxuxi tan fahaamude?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}