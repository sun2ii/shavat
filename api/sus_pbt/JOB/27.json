{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"heading","content":["Ayuba xa masenyi solomanaani nde dɛ idɔxɔɛ"]},{"type":"heading","content":["«Fo n xa nɔndi fala»"]},{"type":"verse","number":1,"content":[{"text":"Ayuba man naxa masenyi ti:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«N bara n kali Ala Sɛnbɛ Kanyi ra,","poem":1},{"lineBreak":true},{"text":"naxan mu nɔndi fima n ma,","poem":1},{"lineBreak":true},{"text":"naxan bara n nafe xɔnɛ ra,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"danmi n ɲɛngima,","poem":1},{"lineBreak":true},{"text":"danmi n ɲɛngi naxan fatanxi Ala ra na nan n fate i,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"tinxintareya mu minima n dɛ i,","poem":1},{"lineBreak":true},{"text":"N mu wule falama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Han n faxa, n mu nɔndi fima wo ma,","poem":1},{"lineBreak":true},{"text":"n mu n yɛtɛ tɔɔɲɛgɛma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N tan a kolon n tinxin, sese man mu n bama mɛnni.","poem":1},{"lineBreak":true},{"text":"N mu n ma fe ɲaaxi yo kolon.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«N yaxui xa suxu alɔ mixi ɲaaxi,","poem":1},{"lineBreak":true},{"text":"n gerefa xa suxu alɔ tinxintare.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala na natɛ tongo a xa na mixi mɔɔlie faxa,","poem":1},{"lineBreak":true},{"text":"xaxili tide yo mu luma e bɛ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala nee maxandi xui tongoma e tɔɔrɔ tɛmui?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala rafan na mixi mɔɔli ma?","poem":1},{"lineBreak":true},{"text":"A Ala maxandima tɛmui birin?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«N xa Ala sɛnbɛ masen wo bɛ,","poem":1},{"lineBreak":true},{"text":"n mu Ala Sɛnbɛ Kanyi waxɔnfe nɔxunma wo ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wo birin bara yi to a fanyi ra,","poem":1},{"lineBreak":true},{"text":"wo fa wɔyɛnyi fufafu falama munfe ra?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Ala naxan nagirima mixi ɲaaxi ma,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanyi naxan soma a yi ra kɛ ra, na nan yi ki:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A xa die na wuya, e faxama santidɛgɛma nan na,","poem":1},{"lineBreak":true},{"text":"a xa mamadie faxa kaamɛ ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A xa mixi ndee na lu,","poem":1},{"lineBreak":true},{"text":"nee fa faxa a xanbi,","poem":1},{"lineBreak":true},{"text":"e xa kaaɲɛ ginɛe mu wama e xa fe ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A xa naafuli na gbo yɛ alɔ mɛyɛnyi,","poem":1},{"lineBreak":true},{"text":"a xa dugi na wuya alɔ bɛndɛ gbegbe malanxi,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"a tan nan na malanxi,","poem":1},{"lineBreak":true},{"text":"kɔnɔ tinxintɔɛ nan na dugi ragoroma a ma,","poem":1},{"lineBreak":true},{"text":"sɛniyɛntɔɛ nan na naafuli sɔtɔma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A xa banxi luma alɔ turunturunyi,","poem":1},{"lineBreak":true},{"text":"alɔ xɔni keri xa bage di.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A bannaxi nan a sama,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a ragatama a tɔɔrɔxi nan na.","poem":1},{"lineBreak":true},{"text":"A na a ya rabi, sese mu na a yi ra sɔnɔn.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Gaaxui a suxuma tɛrɛnna ra,","poem":1},{"lineBreak":true},{"text":"alɔ banbaranyi, alɔ turunnaadɛ kɔɛ kui.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Foye xungbe a xaninma,","poem":1},{"lineBreak":true},{"text":"a a tala a sabatide.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Tanbɛe wolima a ma, a mu bama a ra,","poem":1},{"lineBreak":true},{"text":"fo a xa a gi nɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Mixie ɲɛlɛxinma nɛ a xa xunnakanɛ ra,","poem":1},{"lineBreak":true},{"text":"e yo a ma.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}