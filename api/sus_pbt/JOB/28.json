{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"heading","content":["Ayuba xa masenyi solomanaani nde dɛ idɔxɔɛ man"]},{"type":"heading","content":["«Lɔnni na minden?»"]},{"type":"verse","number":1,"content":[{"text":"«Yire na na gbeti bama bɔxi ma dɛnnaxɛ,","poem":1},{"lineBreak":true},{"text":"xɛɛma raxunude fan na na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yire na na wure bama bɔxi ma dɛnnaxɛ,","poem":1},{"lineBreak":true},{"text":"gɛmɛ raxunuxi fan wure gbeeli raminima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mixi yili gema bɔxi bun dimi kui na see fenfe ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E yili gema wula i,","poem":1},{"lineBreak":true},{"text":"dɛnnaxɛ makuya mixi sabatide ra.","poem":1},{"lineBreak":true},{"text":"Mɛnni mixi goroma luuti ma bɔxi bun ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Baloe minima bɔxi fari,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a bunyi tan luma alɔ tɛ nan yiriyirima.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mɛnni e gɛmɛ tofanyie toma,","poem":1},{"lineBreak":true},{"text":"e xɛɛma fuɲi raminima.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xɔni xaaɲɛ mu mɛnni kira kolon,","poem":1},{"lineBreak":true},{"text":"sɛgɛ mu mɛnni toma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sube magaaxuxi mu e ɲɛrɛma mɛnni,","poem":1},{"lineBreak":true},{"text":"yɛtɛ mu dangima naa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɔnɔ adama tan gɛmɛ xɔrɔxɔɛ gema,","poem":1},{"lineBreak":true},{"text":"han a geya bunyi li.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A yili gema gɛmɛ kui,","poem":1},{"lineBreak":true},{"text":"alako a xa naafuli to.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A ye kira balanma,","poem":1},{"lineBreak":true},{"text":"a tɛ xaninma naa alako a xa se nɔxunxi to.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Kɔnɔ lɔnni tan toma minden?","poem":1},{"lineBreak":true},{"text":"Xaxili fanyi lude na minden na?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Adama mu lɔnni tide kolon.","poem":1},{"lineBreak":true},{"text":"Lɔnni mu toma duniɲa mixi baloxie tagi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A mu toma dabonyi xungbe kui,","poem":1},{"lineBreak":true},{"text":"a mu toma baa ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A mu sarama xɛɛma ra, a mu sɔtɔma gbeti ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A mu sama sikeeli ma xɛɛma sɛɛti ma,","poem":1},{"lineBreak":true},{"text":"xa na mu a ra gɛmɛ tofanyie sɛɛti ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A maniyɛ mu na.","poem":1},{"lineBreak":true},{"text":"A maniyɛ mu findi xɛɛma ra,","poem":1},{"lineBreak":true},{"text":"a mu findi gɛmɛ tinsexi ra,","poem":1},{"lineBreak":true},{"text":"a mu findi xɛɛma pɔɔti tofanyi ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Lɔnni tide gbo diyaman bɛ,","poem":1},{"lineBreak":true},{"text":"a sɔtɔfe tide gbo gɛmɛ tofanyi bɛ naxan toma baa ma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Lɔnni maniyɛ mu findi gɛmɛ tofanyi ra,","poem":1},{"lineBreak":true},{"text":"naxan kelixi yire makuye.","poem":1},{"lineBreak":true},{"text":"A mu maniyama sikeeli ra alɔ xɛɛma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"«Na kui, lɔnni kelixi minden?","poem":1},{"lineBreak":true},{"text":"Xaxili fanyi lude na minden na?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A nɔxunxi nimasee ma naxee na bɔxi ma,","poem":1},{"lineBreak":true},{"text":"a nɔxunxi xɔnie ma naxee na koore ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Aligiyama bara a xa fe nde mɛ, kɔnɔ a mu a kolon.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Ala nan lɔnni kira kolon,","poem":1},{"lineBreak":true},{"text":"a tan nan a lingira toma,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"barima a tan nan duniɲa nun koore igbɛma han e dande.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"A to gɛ foye nun ye itaxunde,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"a to gɛ tunɛ, seyamakɔnyi, nun galanyi yamaride,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"awa, a naxa lɔnni ramini, a a mato a fanyi ra.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Na kui a naxa a fala adamadie bɛ,","poem":1},{"lineBreak":true},{"text":"Ala xa yaragaaxui findixi lɔnni nan na,","poem":1},{"lineBreak":true},{"text":"fe ɲaaxi bɛɲinfe findixi xaxili fanyi nan na.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}