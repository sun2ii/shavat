{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"heading","content":["Ayuba xa masenyi dɔnxɔɛ"]},{"type":"heading","content":["«N ma tɛmui fanyi dangixi»"]},{"type":"verse","number":1,"content":[{"text":"Ayuba naxa yi masenyi ti:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Xa n ma tɛmui dangixie nan a ra yi ki nu,","poem":1},{"lineBreak":true},{"text":"Ala nu mɛɛnima n ma tɛmui naxɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A xa naiyalanyi to nu na n xun ma,","poem":1},{"lineBreak":true},{"text":"a to nu tɛ tima n bɛ kira xɔn ma dimi kui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N sɛnbɛ nu gbo na tɛmui,","poem":1},{"lineBreak":true},{"text":"n nun Ala dɛ nu fan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na tɛmui Ala Sɛnbɛ Kanyi nu na n sɛɛti ma,","poem":1},{"lineBreak":true},{"text":"n ma die fan nu na n nabilinyi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ma fe birin nu sɔɔnɛyaxi,","poem":1},{"lineBreak":true},{"text":"xiɲɛ nun ture nu gbo n yi ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«N to nu sigama taa sode dɛ ra,","poem":1},{"lineBreak":true},{"text":"ɲama nu na dɛnnaxɛ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"fonikee nu kira ibama nɛ n bɛ,","poem":1},{"lineBreak":true},{"text":"forie nu keli e ti n binyafe ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuntigie nu e sabarima nɛ n ya ra,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"mangɛe nu wɔyɛnyi so n yi, e tan dundu,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"barima naxan na n xui mɛ, a fe fanyi fala n ma fe ra.","poem":1},{"lineBreak":true},{"text":"Naxee nu n toma, n nu rafanma e ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N nu tɔɔrɔmixie malima,","poem":1},{"lineBreak":true},{"text":"n nu kiridie kima, booree nu nɛɛmuma naxee ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mixi naxan nu na saya kira xɔn ma,","poem":1},{"lineBreak":true},{"text":"na nu dubama nɛ n bɛ.","poem":1},{"lineBreak":true},{"text":"N nu kaaɲɛ ginɛ bɔɲɛ rasɛɛwama.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N nu n ɲɛrɛma tinxinyi kui,","poem":1},{"lineBreak":true},{"text":"nɔndi nu findixi n yuge nan na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N nu findixi saabui fanyi nan na dɔnxui nun mabɛnyi bɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N nu findixi babɛ nan na setaree bɛ,","poem":1},{"lineBreak":true},{"text":"n xɔɲɛe mali e xa tɔɔrɛ kui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N nu tinxintaree xa fe xun nakanama,","poem":1},{"lineBreak":true},{"text":"n misikiinɛ ratanga e xa fe kobie ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N nu a maɲɔxunma saya n lima hɛɛri nan kui,","poem":1},{"lineBreak":true},{"text":"n ma simaya fa kamali alɔ baa dɛ ra mɛyɛnyi.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N nu a maɲɔxunma n ma duniɲɛigiri sɔɔnɛyama nɛ,","poem":1},{"lineBreak":true},{"text":"alɔ sansi naxan sanke bara ye li, a salonyi xini sɔtɔ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N nu a maɲɔxunma n xun nakelima nɛ tɛmui birin,","poem":1},{"lineBreak":true},{"text":"n tanbɛ woli sɛnbɛ ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"«Mixie nu e tuli matima nɛ n na,","poem":1},{"lineBreak":true},{"text":"e e sabari n ma marasi ramɛfe ra.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N ma masenyie nu rafanma e ma,","poem":1},{"lineBreak":true},{"text":"e mu nu e matandima.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"E nu n mamɛma alɔ mixi tunɛ mamɛma ki naxɛ,","poem":1},{"lineBreak":true},{"text":"e n ma wɔyɛnyi birin suxu sɛɛwɛ kui.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"E na n yatagi to,","poem":1},{"lineBreak":true},{"text":"e birin nu e xaxili tima n na.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N nu e raɲɛrɛma,","poem":1},{"lineBreak":true},{"text":"n nu luxi nɛ e bɛ alɔ e xa mangɛ,","poem":1},{"lineBreak":true},{"text":"naxan dɔxɔxi kibanyi kui e tagi,","poem":1},{"lineBreak":true},{"text":"a nu tɔɔrɔmixie madundu.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}