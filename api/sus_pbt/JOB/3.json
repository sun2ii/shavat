{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Ayuba xa masenyi"]},{"type":"heading","content":["«Ayuba nimisafe a xa bari ra»"]},{"type":"verse","number":1,"content":["Na birin to dangi, Ayuba naxa a bari lɔxɔɛ danka"]},{"type":"verse","number":2,"content":["yi masenyi ra:"]},{"type":"verse","number":3,"content":[{"text":"«N bari lɔxɔɛ xa nɛɛmu duniɲa ra.","poem":1},{"lineBreak":true},{"text":"Na kɔɛ ra e naxɛ, ‹Di xɛmɛ na a ra.›","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala xa na lɔxɔɛ findi dimi ra,","poem":1},{"lineBreak":true},{"text":"na lɔxɔɛ xa nɛɛmu a ra,","poem":1},{"lineBreak":true},{"text":"a xa tɔnyi dɔxɔ soge yanbafe ra na lɔxɔɛ kui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ala xa na lɔxɔɛ findi dimi ra,","poem":1},{"lineBreak":true},{"text":"a xa nuxui ifɔɔrɛ dusu a xun na,","poem":1},{"lineBreak":true},{"text":"a xa lu dimi magaaxuxi kui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala xa na kɔɛ ifɔɔrɔ,","poem":1},{"lineBreak":true},{"text":"a xa na ba kɔnti ra ɲɛ kui,","poem":1},{"lineBreak":true},{"text":"a xa na ba kɔnti ra kike kui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ala xa na kɔɛ kuma di ra,","poem":1},{"lineBreak":true},{"text":"sɛɛwɛ xui yo naxa ite.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A xa findi dankɛ ti se ra mandurulae bɛ,","poem":1},{"lineBreak":true},{"text":"naxee ninginangɛ xilima.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na lɔxɔɛ subaxɛ tunbuie naxa yanba,","poem":1},{"lineBreak":true},{"text":"kuye naxa iba,","poem":1},{"lineBreak":true},{"text":"naiyalanyi yo naxa mini,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"barima a mu sese raba naxan","poem":1},{"lineBreak":true},{"text":"nu nɔma n barife dande,","poem":1},{"lineBreak":true},{"text":"naxan nu nɔma n nɔxunde n ma tɔɔrɛ ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Munfe ra n nga furi mu bira nu?","poem":1},{"lineBreak":true},{"text":"Munfe ra n mu faxa nu beenu n xa bari?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Munfe ra n nga n nasɛnɛxi a san ma,","poem":1},{"lineBreak":true},{"text":"a xiɲɛ fi n ma?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xa na mu a ra, yi tɛmui n bɛlɛxi bɔɲɛsa kui nu","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"mangɛe nun rasimae fɛ ma,","poem":1},{"lineBreak":true},{"text":"naxee xa banxie bara gɛ kanade,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"naxee nu bara xɛɛma nun gbeti gbegbe sɔtɔ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Munfe ra e mu n nagata,","poem":1},{"lineBreak":true},{"text":"alɔ diyɔrɛ naxan mu waxi,","poem":1},{"lineBreak":true},{"text":"naxan mu mini kɛnɛ ma?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Gaburi tan kui, mixi ɲaaxie mu nɔma sese ra,","poem":1},{"lineBreak":true},{"text":"mixi taganxie e malabuma nɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Konyie bɔɲɛsa sɔtɔma nɛ,","poem":1},{"lineBreak":true},{"text":"e mu e kanyi xui mɛma gaburi kui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Dimɛdie nun forie na mɛnni,","poem":1},{"lineBreak":true},{"text":"konyie e yɛtɛ sɔtɔma naa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Munfe ra Ala a niyama adamadie xa mini kɛnɛ ma,","poem":1},{"lineBreak":true},{"text":"naxee findi tɔɔrɔmixie ra,","poem":1},{"lineBreak":true},{"text":"naxee nimisaxi e xa duniɲɛigiri kui,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"naxee faxɛ xɔli mawama, kɔnɔ e mu faxa,","poem":1},{"lineBreak":true},{"text":"naxee faxɛ fenma dangi naafuli ra,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"naxee ɲɛlɛxinma gaburi life ra?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Munfe ra mixi barima,","poem":1},{"lineBreak":true},{"text":"Ala kira balanxi naxan ya ra,","poem":1},{"lineBreak":true},{"text":"Ala naxan naxɛtɛnma yire birin?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"N ma donse findixi n ma tɔɔrɛ nan na,","poem":1},{"lineBreak":true},{"text":"n ma minse findixi n yaye nan na.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"N na gaaxu fe naxan na, na nan n lima.","poem":1},{"lineBreak":true},{"text":"Fe naxan na n nasɛrɛn, n na nan sɔtɔma.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Bɔɲɛsa mu na n bɛ,","poem":1},{"lineBreak":true},{"text":"n mu nɔma n sabaride.","poem":1},{"lineBreak":true},{"text":"Malabui mu na n bɛ, fo tɔɔrɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}