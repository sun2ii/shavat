{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"heading","content":["Elihu xa masenyi saxan nde"]},{"type":"heading","content":["«Ala i xa fe kolon»"]},{"type":"verse","number":1,"content":[{"text":"Elihu naxa a fala,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«I ɲɔxɔ a ma nɔndi na i bɛ i na a fala,","poem":1},{"lineBreak":true},{"text":"‹N ma tinxinyi fatanxi Ala nan na?›","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I bara a maxɔrin,","poem":1},{"lineBreak":true},{"text":"‹Geeni mundun na n bɛ xa n mu yunubi rabama?›","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N tan nan i yaabima na ra, i tan nun i booree.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Koore mato. Nuxui mu na i xun ma xɛ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Xa i yunubi raba, na findima tɔɔrɛ ra Ala nan bɛ?","poem":1},{"lineBreak":true},{"text":"Xa i a matandi, na findima kote mundun na a bɛ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xa i tinxin, na findima geeni mundun na a tan bɛ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I xa fe ɲaaxi nɔma adamadi nan gbansan tɔɔrɔde,","poem":1},{"lineBreak":true},{"text":"adamadi naxan luxi alɔ i tan.","poem":1},{"lineBreak":true},{"text":"I xa tinxinyi fan nɔma findide geeni ra adamadi nan gbansan bɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mixie e wa xui mɛma barima fe ɲaaxi rabae wuya.","poem":1},{"lineBreak":true},{"text":"Mixie xili tima na kobiɲa xa fe ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɔnɔ mixi yo mu a falama,","poem":1},{"lineBreak":true},{"text":"‹N Daa Mangɛ Ala na minden,","poem":1},{"lineBreak":true},{"text":"n bɛɛti bama naxan bɛ kɔɛ ra,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"naxan lɔnni fima adamadie ma","poem":1},{"lineBreak":true},{"text":"dangife subee ra naxee na duniɲa ma,","poem":1},{"lineBreak":true},{"text":"dangife xɔnie ra naxee na kuye ma?›","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mixie xili tima, kɔnɔ a mu e yaabima","poem":1},{"lineBreak":true},{"text":"fe ɲaaxi rabae xa yɛtɛ igboɲa xa fe ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"E xili tima fufafu,","poem":1},{"lineBreak":true},{"text":"barima Ala mu a tuli matima e ra,","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanyi mu e xui ramɛma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɔnɔ i tan nan a falaxi a i mu Ala toxi,","poem":1},{"lineBreak":true},{"text":"i xa fe saxi a ya i, i na a mamɛfe tun.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A mu nu xɔnɔ i xa matandi wɔyɛnyie ma sinden.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ayuba, i bara i dɛ rabi fufafu xaxilitareɲa falafe ra.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}