{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"heading","content":["Ala xa masenyi firin nde Ayuba bɛ"]},{"type":"heading","content":["«Nde mɛɛnima subee ma?»"]},{"type":"verse","number":1,"content":[{"text":"«I wula i si di bari tɛmui kolon geyae fari?","poem":1},{"lineBreak":true},{"text":"I bara xeli to di bari ra?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I e xa furi maxanin kike kɔnti kolon","poem":1},{"lineBreak":true},{"text":"beenu e di bari waxati xa a li?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E na e sa, e di barima,","poem":1},{"lineBreak":true},{"text":"alako e xa fulun e furi xa xɔnɛ ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E xa die na mɔ,","poem":1},{"lineBreak":true},{"text":"e keli e nga xun ma, e mu fa sɔnɔn.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"«Nde luuti baxi sofale ma,","poem":1},{"lineBreak":true},{"text":"a a rabɛɲin wula i?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N tan nan wula findixi a xɔnyi ra","poem":1},{"lineBreak":true},{"text":"n a lu yire, fɔxɛ sunbuxi bɛndɛ ra dɛnnaxɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Taa xa wundui mu rafan a ma,","poem":1},{"lineBreak":true},{"text":"a mu tinma mixie xa a raɲɛrɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A wula isama ɲooge fende a balose ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"«I nɔma sɛxɛ ninge rawalide?","poem":1},{"lineBreak":true},{"text":"A kɔɛ radangima i xa gɔɔrɛ kui?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I nɔma a xiride sari ra,","poem":1},{"lineBreak":true},{"text":"a xa bɔxi buxa i bɛ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I i yigi suxuma a sɛnbɛ gbe ra?","poem":1},{"lineBreak":true},{"text":"I nɔma i xa wali xungbee taxude a ra?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I nɔma a xɛɛde xɛ xabɛ, a xa i mali i xa baloe rasode?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"«Xɔni mɔɔli nde na na naxan","poem":1},{"lineBreak":true},{"text":"gabutenyi dunkee ibɔnbɔma sɛɛwɛ kui,","poem":1},{"lineBreak":true},{"text":"kɔnɔ e mu tofan gbongboe gabutenyie bɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A a xɛlɛe sama bɔxi ma,","poem":1},{"lineBreak":true},{"text":"a e lu mɛyɛnyi bun ma alako wuyenyi xa lu e ma,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"a mu a maɲɔxun sube nde nɔma tide e fari, e bula.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A mu mɛɛnima a xa die ma,","poem":1},{"lineBreak":true},{"text":"a luma alɔ a gbe mu e ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A na mɔɔli rabama","poem":1},{"lineBreak":true},{"text":"barima Ala mu lɔnni nun xaxili fanyi fixi a ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kɔnɔ a na a gi fɔlɔ,","poem":1},{"lineBreak":true},{"text":"a soe ragie nun soe luma nɛ a xanbi ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"«I tan nan soe sɛnbɛ fima a ma?","poem":1},{"lineBreak":true},{"text":"I tan nan a kɔnyi xabee rakuyama?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I tan nan a niyama a xa nɔ tugande alɔ katoe,","poem":1},{"lineBreak":true},{"text":"a birin magaaxu a xui ra?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A bɔxi iboronma a sanyi ra, a ɲɛlɛxinxi a sɛnbɛ ra.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"A mu gaaxuma sese ya ra,","poem":1},{"lineBreak":true},{"text":"a mu a magbilenma santidɛgɛma ya i.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Tanbɛe nun e sase gbakuxi a ma,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"a gbataxi tuganma, a xulun a gide gere yire.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Gere sara na fe,","poem":1},{"lineBreak":true},{"text":"a tan kelima nɛ fa keren na a gereso ki ma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"«I xa lɔnni bara a niya","poem":1},{"lineBreak":true},{"text":"sɛgɛ xa a ɲɛrɛ koore ma sigafe ra yirefanyi ma?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"I tan nan yaamari fima a ma a xa a tɛɛ sa yire itexi?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kɔɛ ra, a yigiyama gɛmɛ longori ra geyae fari.","poem":1},{"lineBreak":true},{"text":"Mɛnni nan findixi a bɛ a makantade nan na.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"A subee toma na yire makuye nɛ,","poem":1},{"lineBreak":true},{"text":"a baloma naxee ra.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Sube xinde ɲɔxun a xa diyɔrɛe bɛ.","poem":1},{"lineBreak":true},{"text":"Binbi lu dɛdɛ a na mɛnni.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}