{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifasi Temanka xa masenyi singe"]},{"type":"heading","content":["«Tinxintɔɛ mu tɔɔrɔma»"]},{"type":"verse","number":1,"content":[{"text":"Elifasi Temanka naxa a fala,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Ayuba, i haakɛ to n bɛ n xa wɔyɛn.","poem":1},{"lineBreak":true},{"text":"N mu nɔma dundude.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I bara mixi gbegbe xaran,","poem":1},{"lineBreak":true},{"text":"i bara e ralimaniya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I xa masenyie bara mixie mali,","poem":1},{"lineBreak":true},{"text":"i xa wɔyɛnyie bara e sɛnbɛ so.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yakɔsi i tan nan to fa na tɔɔrɔfe,","poem":1},{"lineBreak":true},{"text":"limaniya bara ba i tan yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I mu i xaxili ti i xa danxaniya ra Ala ma?","poem":1},{"lineBreak":true},{"text":"I mu lama i xa tinxinyi ra?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I bara mixi fanyi to halakixi tɔɔrɛ ma?","poem":1},{"lineBreak":true},{"text":"Tinxintɔɛ nɔma bɔnɔde?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N naxan nakɔrɔsixi, fe ɲaaxi rabae nan tɔɔrɔma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala e xun nakanama a xa xɔnɛ kui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yɛtɛ xa yirindinyi nun baratɛ xa ɲarandanyi magaaxu,","poem":1},{"lineBreak":true},{"text":"kɔnɔ e ɲinyie fama nɛ magirade.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yɛtɛ yati faxama kaamɛ ra,","poem":1},{"lineBreak":true},{"text":"a xa die yensen yɛ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Masenyi nde bara fala n bɛ a gundo ki ma,","poem":1},{"lineBreak":true},{"text":"n tuli bara a makɔlikɔli xui mɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xiye sa tɛmui kɔɛ tagi,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"gaaxui naxa n suxu han n fate naxa sɛrɛn.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tubari nde naxa dangi n ya i.","poem":1},{"lineBreak":true},{"text":"N fate xabee naxa keli, e ti.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Tubari nu tixi naa.","poem":1},{"lineBreak":true},{"text":"N a to nɛ, kɔnɔ mixi yo a ra n mu a kolon.","poem":1},{"lineBreak":true},{"text":"N bara mixi maniyɛ tan to.","poem":1},{"lineBreak":true},{"text":"N naxa xui nde mɛ yi makɔlikɔli ra,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"‹Adamadi tinxin Ala ya i? A sɛniyɛn a Marigi ya i?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xa Ala mu la a xa malekɛe ra a xa walikɛe,","poem":1},{"lineBreak":true},{"text":"xa a tantanyi toma nee ma,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ibunadama go, naxan yailanxi bɛndɛ ra,","poem":1},{"lineBreak":true},{"text":"naxan nɔma iwurude alɔ kaari?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Adamadie faxama lɔxɔ yo lɔxɔ, sese mu na kanama.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"E xa simaya luuti bolonma nɛ,","poem":1},{"lineBreak":true},{"text":"e faxa fahaamutareɲa kui.›»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}