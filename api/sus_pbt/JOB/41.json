{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"heading","content":["Ala xa masenyi naani nde Ayuba bɛ"]},{"type":"heading","content":["«Ala xa daalise sɛnbɛma»"]},{"type":"verse","number":1,"content":[{"text":"«Mixi mu nɔma a ra,","poem":1},{"lineBreak":true},{"text":"a xa toe gbansan findima gaaxui nan na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Xa mixi mu suusama a ya ra,","poem":1},{"lineBreak":true},{"text":"nde fa nɔma suusade n tan ya ra?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nde n donixi se nde ra n naxan nagbilenma a ma?","poem":1},{"lineBreak":true},{"text":"Duniɲa birin findixi n gbe nan na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N mu nɔma dundude na sɔɲɛ xa fe ma,","poem":1},{"lineBreak":true},{"text":"a salonsee sɛnbɛ gbo, a man tofan.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A bura fɛɛrɛ na nde bɛ?","poem":1},{"lineBreak":true},{"text":"Nde mu gaaxuma a ɲinyie ya ra?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nde nɔma a dɛ rabide?","poem":1},{"lineBreak":true},{"text":"A ɲinyi magaaxuxie a dɛ kui rafexi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xalee fatuxi a kiri ma alɔ sɔɔri xa wure lefa,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"e xɛtɛnxi e bore ra,","poem":1},{"lineBreak":true},{"text":"foye sode yati mu na e tagi","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"e fatuxi e bore ma a fanyi ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A na ɲɛngi sɛnbɛ ra,","poem":1},{"lineBreak":true},{"text":"yanbɛ nan luma mini ra,","poem":1},{"lineBreak":true},{"text":"a yae fan luxi alɔ gɛɛsɛgɛ soge.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɛ yiriyiri minima a dɛ i,","poem":1},{"lineBreak":true},{"text":"e fulefulee nu fa yensen yɛ kuye ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tuuri nde minima a ɲɔɛ,","poem":1},{"lineBreak":true},{"text":"na luxi nɛ alɔ fifa naxan dɔxɔxi tɛ ma, a satunfe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A ɲɛngi findima tɛ ra,","poem":1},{"lineBreak":true},{"text":"tɛ yiriyiri nu fa mini a dɛ i.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Sɛnbɛ xutunxi a kɔnyi ra,","poem":1},{"lineBreak":true},{"text":"birin gaaxuma a ya ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A kiri xɔrɔxɔ, a sɛnbɛ gbo.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A kanke luxi alɔ gɛmɛ xungbe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A na ti, limaniya bama nɛ sɛnbɛmae yi ra,","poem":1},{"lineBreak":true},{"text":"e sɛrɛn, e e gi.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Santidɛgɛma na din a ra,","poem":1},{"lineBreak":true},{"text":"a mu a xabama.","poem":1},{"lineBreak":true},{"text":"Tanbɛ mɔɔli yo mu na naxan nɔma a sɔxɔde.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wure luxi nɛ a bɛ alɔ sɛxɛ,","poem":1},{"lineBreak":true},{"text":"yɔxui lu a bɛ alɔ wuri bɔrɔxi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A mu gaaxuma tanbɛe ya ra,","poem":1},{"lineBreak":true},{"text":"laati kuni luma a bɛ alɔ maale lagi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Gbendegela luma a bɛ alɔ sɛxɛ,","poem":1},{"lineBreak":true},{"text":"tanbɛ xungbe mayele a bɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bɛlɛ xɛɲɛnxi nde nun tunbee na a furi bunyi,","poem":1},{"lineBreak":true},{"text":"nee luma boora tirindin na nɛ alɔ sari to yire buxama.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A baa ixufuxufuma alɔ ye nɛ satunma,","poem":1},{"lineBreak":true},{"text":"a dabonyi lu alɔ ture nɛ satunma.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A na a ɲɛrɛ ye xɔɔra,","poem":1},{"lineBreak":true},{"text":"mɔrɔnyi fiixɛ nan luma te ra a xanbi ra.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Mangɛ yo mu a bɛ duniɲa,","poem":1},{"lineBreak":true},{"text":"a daaxi nɛ, gaaxui yo mu a yi.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"A a ya ragoroma nɛ daalise yɛtɛ igboe ma,","poem":1},{"lineBreak":true},{"text":"a findixi subee birin ma mangɛ nan na.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":26}