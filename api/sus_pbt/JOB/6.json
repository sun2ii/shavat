{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Ayuba xa masenyi singe"]},{"type":"heading","content":["«N ma tɔɔrɛ gbo n ma fe ɲaaxie bɛ.»"]},{"type":"verse","number":1,"content":[{"text":"Ayuba naxa a yaabi,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Xa n ma tɔɔrɛ sa maniyama nu,","poem":1},{"lineBreak":true},{"text":"xa a sa sama sikeeli ma nu,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"a binyɛ dangima nɛ baa mɛyɛnyi ra.","poem":1},{"lineBreak":true},{"text":"Na nan a toxi yusi yo mu na n ma wɔyɛnyie ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanyi xa tanbɛ bara n sɔxɔ,","poem":1},{"lineBreak":true},{"text":"na xɔnɛ bara te n xaxili ra.","poem":1},{"lineBreak":true},{"text":"Ala na n gerefe a ɲaaxi ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ɲooge fanxi dɛnnaxɛ, sofale wama mɛnni?","poem":1},{"lineBreak":true},{"text":"Ninge wa xui mɛɛma a xa donse ya i?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bande donma fɔxɛ xanbi?","poem":1},{"lineBreak":true},{"text":"Tɔxɛlɛ ɲintare ɲɔxun?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N mu nu wama naxan xɔn,","poem":1},{"lineBreak":true},{"text":"na bara findi n baloe ra hali na fa kanaxi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala xa n ma dubɛ suxu n bɛ,","poem":1},{"lineBreak":true},{"text":"a xa n waxɔnfe rakamali.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ala xa n xun nakana, a xa n faxa.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na kui, n madundui sɔtɔma nɛ, hali n to yi tɔɔrɛ birin kolonxi,","poem":1},{"lineBreak":true},{"text":"n sɛɛwa n to mu gbilen Ala Sɛniyɛntɔɛ xa yaamari fɔxɔ ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N nan n xaxili tima sɛnbɛ mundun na fa?","poem":1},{"lineBreak":true},{"text":"N ma diɲɛ munse fanma n ma sɔnɔn?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N sɛnbɛ gbo alɔ fanye?","poem":1},{"lineBreak":true},{"text":"N fate xɔrɔxɔ alɔ wure?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nde nɔma n malide?","poem":1},{"lineBreak":true},{"text":"Sɛnbɛ mundun luxi n ma?»","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"«Tɔɔrɔmixi hayi na a dugutɛgɛ xa mali ma,","poem":1},{"lineBreak":true},{"text":"hali na mu sa gaaxuma Ala Sɛnbɛ Kanyi ya ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N ngaxakerenyie bara n yanfa,","poem":1},{"lineBreak":true},{"text":"alɔ xure naxan xɔrima.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ɲɛmɛ tɛmui, ye banbaran yɛ, a radunda,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"kɔnɔ sogofure ra, ye birin xɔri.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Biyaasilae kira bama a ma ye fenfe ra,","poem":1},{"lineBreak":true},{"text":"e fa lɔɛ gbengberen yire.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Tema Biyaasilae e xun tima ye yire ra.","poem":1},{"lineBreak":true},{"text":"Seebakae fan e xaxili tima na xure ra,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"kɔnɔ e na mɛnni li, e xure xɔrixi nan toma.","poem":1},{"lineBreak":true},{"text":"Na kui limaniya bama nɛ e yi ra.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wo luxi na ki nɛ n bɛ.","poem":1},{"lineBreak":true},{"text":"Wo bara gaaxu n ma tɔɔrɛ ya ra.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N xoro nu, n nu wo makula nɛ,","poem":1},{"lineBreak":true},{"text":"wo xa n xun sara wo xa naafuli nde ra?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N wo makula nɛ,","poem":1},{"lineBreak":true},{"text":"wo xa n xun sara n yaxui gbeeli nde ma?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Wo n xaran.","poem":1},{"lineBreak":true},{"text":"Wo n ma tantanyi masen n bɛ,","poem":1},{"lineBreak":true},{"text":"alako n xa n sabari.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Nɔndi tan mu mixi yo tɔɔrɔma.","poem":1},{"lineBreak":true},{"text":"Kɔnɔ wo xa masenyie tan fala xun?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Wo bara kiiti sa,","poem":1},{"lineBreak":true},{"text":"wo mu wo tuli matixi tɔɔrɔmixi tan xa wɔyɛnyi ra.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Wo fata kiiti ɲaaxi sade kiridie ma.","poem":1},{"lineBreak":true},{"text":"Wo mu yanfanteya ba wo boore yɛtɛ yati ra.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Kɔsi fa yandi, wo wo ya ti n na.","poem":1},{"lineBreak":true},{"text":"N mu wule falama wo bɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wo xa kiiti tinxinxi sa,","poem":1},{"lineBreak":true},{"text":"alako n xili fanyi naxa kana.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Wo fe falɛ ɲaaxi mɛma n na?","poem":1},{"lineBreak":true},{"text":"N mu fata fe fanyi nun fe ɲaaxi tagi rasade?»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}