{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOB","translationId":"sus_pbt","name":"Ayuba","commonName":"Ayuba","title":"Ayuba xa Taruxui Ayuba xa Taruxui","order":18,"numberOfChapters":42,"sha256":"837c5afdf49e9ee7efaa613dc3bac55b8cb2e8c6f7d64aa88901d6a28d0ec92a","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/sus_pbt/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["Bilidada Suuxaka xa masenyi singe"]},{"type":"heading","content":["«Haakɛ mu sigama Aligiyama.»"]},{"type":"verse","number":1,"content":[{"text":"Bilidada Suuxaka naxa a masen,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«I yi wɔyɛnyi mɔɔli falama han tɛmui mundun?","poem":1},{"lineBreak":true},{"text":"I xa wɔyɛnyi luxi nɛ alɔ foye.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala nɔma nɔndi mafindide wule ra?","poem":1},{"lineBreak":true},{"text":"Ala Sɛnbɛ Kanyi nɔma tinxinyi ifude?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xa i xa die yunubi nan nabaxi a ra,","poem":1},{"lineBreak":true},{"text":"a e ɲaxankataxi na nan ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xa i tan Ala fenma,","poem":1},{"lineBreak":true},{"text":"xa i Ala Sɛnbɛ Kanyi makulama,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"xa yunubi mu na i ma, xa i tinxin,","poem":1},{"lineBreak":true},{"text":"Ala a ɲɛngi sama nɛ i xɔn ma,","poem":1},{"lineBreak":true},{"text":"a i rasabati i xa tinxinyi kui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I harige dɔnxɔɛ fama dangide na singe ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"«Fahaamui fen won babae ra,","poem":1},{"lineBreak":true},{"text":"i xa xaxili sɔtɔ nee benbae fan na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Won tan mu buxi duniɲa ma,","poem":1},{"lineBreak":true},{"text":"xaxili xɔnkuye mu na won bɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E mu fahaamui fima xɛ i ma?","poem":1},{"lineBreak":true},{"text":"E e xaxili xa masenyie tima i bɛ yi ki:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wofiri bulama xare ma?","poem":1},{"lineBreak":true},{"text":"Xure i baare findima a ra ye mu dɛnnaxɛ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Hali a na a bili ma, a mu xabaxi,","poem":1},{"lineBreak":true},{"text":"a lisima mafuren dangi ɲooge birin na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Na nan fama rabade mixie ra, naxee nɛɛmuma Ala ma.","poem":1},{"lineBreak":true},{"text":"Tinxintare xaxili tide ɲɔnma na ki nɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A xaxili tide bara kana, alɔ mixi naxan a kilɔnma sayɛlɛ tɛɛ ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A na a kilɔn na ra, a kanama nɛ, a kanyi bira.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A luma alɔ sansi, ye naxan kui rafexi,","poem":1},{"lineBreak":true},{"text":"a a salonyi iyan soge linlinyi ya ma laakɔɛ xun ma,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"a a sankee sɔti gɛmɛ malanxi longori ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xa i na sansi tala naa, a lisima nɛ,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"a mu fanma mɛnni sɔnɔn.","poem":1},{"lineBreak":true},{"text":"Sansi gbɛtɛ man fa bula a nu na dɛnnaxɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Ala mu tinxintɔɛ rawɔlɛma, a mu tinxintare sɛnbɛ soma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"A gbe mu luxi a xa i rasɛɛwa,","poem":1},{"lineBreak":true},{"text":"i xa matɔxɔɛ falɛ ra i fama naxan tide.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"I xɔnmixie fama lude yaagi kui, e xɔnyie fa bira.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}