{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"JOL","translationId":"sus_pbt","name":"Annabi Yoweli","commonName":"Annabi Yoweli","title":"Ala xa masenyi Annabi Yoweli bɛ Ala xa masenyi Annabi Yoweli bɛ","order":29,"numberOfChapters":4,"sha256":"0413ee441fa556db1076476493d11bb36dd55ca95fef21919ea7daf911aa593e","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/sus_pbt/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Alatala Xaxili ragorofe duniɲa ma"]},{"type":"verse","number":1,"content":[{"text":"Na dangi xanbi, n na n Xaxili ragoroma nɛ mixi birin ma.","poem":1},{"lineBreak":true},{"text":"Wo xa di xɛmɛe nun di ginɛe namiɲɔnmɛɲa rabama nɛ,","poem":1},{"lineBreak":true},{"text":"wo xa forie xiyee sama nɛ,","poem":1},{"lineBreak":true},{"text":"laamatunyie goroma nɛ wo xa fonikee ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N na n Xaxili ragoroma nɛ konyi xɛmɛe nun konyi ginɛe ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N tɔnxumae raminima nɛ koore nun bɔxi ma,","poem":1},{"lineBreak":true},{"text":"naxee findima wuli, tɛ, nun tuuri ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Soge dimima nɛ, kike masarama nɛ a findi wuli ra,","poem":1},{"lineBreak":true},{"text":"beenun Marigi xa lɔxɔɛ xungbe magaaxuxi xa a li.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na kui, naxan yo na Alatala xili, na kanyi kisima nɛ.","poem":1},{"lineBreak":true},{"text":"Mixi kisixie luma nɛ Siyoni nun Darisalamu,","poem":1},{"lineBreak":true},{"text":"alɔ Alatala a masenxi ki naxɛ.","poem":1},{"lineBreak":true},{"text":"Alatala kisi ragirixi naxee ma, nee luma nɛ kisi mixie dɔnxɔɛ ya ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}