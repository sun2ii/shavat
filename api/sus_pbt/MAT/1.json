{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"MAT","translationId":"sus_pbt","name":"Matiyu","commonName":"Matiyu","title":"Inyila Isa Annabi Matiyu naxan sɛbɛxi Inyila Isa Annabi Matiyu naxan sɛbɛxi","order":40,"numberOfChapters":28,"sha256":"b90b67c038ae42e8e9555b64dc7d1808e5dba7a815ead891a387cce4f8e24102","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/MAT/1.json","lastChapterNumber":28,"lastChapterApiLink":"/api/sus_pbt/MAT/28.json","totalNumberOfVerses":1069},"chapter":{"number":1,"content":[{"type":"heading","content":["Isa benbae"]},{"type":"verse","number":1,"content":["Isa, Ala xa Mixi Sugandixi naxan fatan Dawuda nun Iburahima bɔnsɔɛ ra, a benbae xilie nan yi ki:"]},{"type":"verse","number":2,"content":[{"text":"Iburahima naxa Isiyaga sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Isiyaga naxa Yaxuba sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Yaxuba naxa Yuda nun a taarae nun a xunyae sɔtɔ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yuda naxa Peresi nun Sera sɔtɔ, Tamari xa die.","poem":1},{"lineBreak":true},{"text":"Peresi naxa Xesiron sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Xesiron naxa Arami sɔtɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Arami naxa Aminadabo sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Aminadabo naxa Naxason sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Naxason naxa Salimon sɔtɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Salimon naxa Boosu sɔtɔ, Raxabi xa di.","poem":1},{"lineBreak":true},{"text":"Boosu naxa Obedo sɔtɔ, Ruti xa di.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Obedo naxa Yisayi sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Yisayi naxa Dawuda sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Mangɛ Dawuda naxa Sulemani sɔtɔ","poem":1},{"lineBreak":true},{"text":"Uriya xa ginɛ saabui ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sulemani naxa Robowami sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Robowami naxa Abiya sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Abiya naxa Asa sɔtɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Asa naxa Yehosafati sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Yehosafati naxa Yehorami sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Yehorami naxa Yusiya sɔtɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yusiya naxa Yotami sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Yotami naxa Axasi sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Axasi naxa Xesekiya sɔtɔ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xesekiya naxa Manasi sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Manasi naxa Amon sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Amon naxa Yosiya sɔtɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Yosiya naxa Yekoniya nun a xunyae sɔtɔ,","poem":1},{"lineBreak":true},{"text":"Isirayilakae xaninxi Babilɔn tɛmui naxɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"E to siga Babilɔn, Yekoniya naxa Salatiyeli sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Salatiyeli naxa Sorobabeli sɔtɔ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Sorobabeli naxa Abiyudi sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Abiyudi naxa Eliyakimi sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Eliyakimi naxa Asoro sɔtɔ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Asoro naxa Sadɔki sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Sadɔki naxa Aximi sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Aximi naxa Eliyudi sɔtɔ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Eliyudi naxa Eleyasari sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Eleyasari naxa Matan sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Matan naxa Yaxuba sɔtɔ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Yaxuba naxa Yusufu sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Yusufu naxa Mariyama dɔxɔ.","poem":1},{"lineBreak":true},{"text":"Mariyama nan findi Isa nga ra,","poem":1},{"lineBreak":true},{"text":"naxan xili Ala xa Mixi Sugandixi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":["A birin nalanxi benba dɔxɔ fu nun naani, keli Iburahima ma sa dɔxɔ Dawuda ra. A birin nalanxi benba dɔxɔ fu nun naani, keli Dawuda ma, han Isirayilakae siga tɛmui naxɛ Babilɔn. A birin nalanxi benba dɔxɔ fu nun naani, keli Isirayilakae siga tɛmui ma Babilɔn, han a sa dɔxɔ Ala xa Mixi Sugandixi xa waxati ra."]},{"type":"heading","content":["Isa bari ki naxɛ"]},{"type":"verse","number":18,"content":["Ala xa Mixi Sugandixi Isa xa bari raba yi ki nɛ: Yusufu nu bara Isa nga Mariyama xa kote dɔxɔ, kɔnɔ beenun e xa kafu, Mariyama naxa tɛɛgɛ Ala Xaxili Sɛniyɛnxi xa kaabanako saabui ra."]},{"type":"verse","number":19,"content":["A xa mɔri Yusufu to findixi tinxintɔɛ ra, a mu nu waxi Mariyama xili kanafe. A naxa natɛ tongo e xa fatan gundoɲɔxɔɲa kui."]},{"type":"verse","number":20,"content":["A nu a maɲɔxunma na fe ma tɛmui naxɛ, Marigi xa malekɛ nde naxa mini a ma xiye kui, a a masen a bɛ, «Yusufu, i tan naxan kelixi Dawuda bɔnsɔɛ, i naxa gaaxu i xa ginɛ Mariyama futife ra, barima a tɛɛgɛxi di naxan ma, a fatanxi Ala Xaxili Sɛniyɛnxi xa kaabanako nan na."]},{"type":"verse","number":21,"content":["Mariyama fama di xɛmɛ nan baride. I xa a xili sa Isa, barima a tan nan fama a xa ɲama rakiside e xa yunubie ma.»"]},{"type":"verse","number":22,"content":["Na birin naba nɛ alako Marigi naxan masen namiɲɔnmɛ saabui ra, a xa kamali alɔ a sɛbɛxi Kitaabui kui ki naxɛ,"]},{"type":"verse","number":23,"content":[{"text":"«Ginɛdimɛdi tɛɛgɛma nɛ, a di xɛmɛ bari.","poem":1},{"lineBreak":true},{"text":"E a xili falama nɛ Emanuwɛli.»","poem":1},"Na nan na ki, «Ala na won ya ma.»"]},{"type":"verse","number":24,"content":["Yusufu to xunu, a naxa Marigi xa malekɛ xa yaamari rabatu, a a xa ginɛ xa futi xiri."]},{"type":"verse","number":25,"content":["Kɔnɔ a mu a kolon ginɛ ra han Mariyama xa di xɛmɛ bari xanbi. A naxa na di xili sa Isa."]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/MAT/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/MAT/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/MAL/3.json","previousChapterAudioLinks":{},"numberOfVerses":25}