{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PRO","translationId":"sus_pbt","name":"Taalie","commonName":"Taalie","title":"Ala xa Taalie Ala xa Taalie","order":20,"numberOfChapters":31,"sha256":"975752b79deafabebf5ed03fa8b74e9ede5472bcd752b4569072c55213015430","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sus_pbt/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":2,"content":[{"type":"heading","content":["Xaxilimaya fan adamadie bɛ"]},{"type":"verse","number":1,"content":[{"text":"N ma di, xa i n ma masenyie suxu,","poem":1},{"lineBreak":true},{"text":"xa i n ma sɛriyɛ rabatu,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"xa i i tuli mati lɔnni ra, xa nɔndi rafan i bɔɲɛ ma,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"xa i xaxili fanyi fen, xa i nɔndi maxili,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"xa i a fen alɔ gbeti, xa i a fen a fanyi ra","poem":1},{"lineBreak":true},{"text":"alɔ bannaya fenma ki naxɛ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"na kui, i Alatala xa yaragaaxui kolonma nɛ,","poem":1},{"lineBreak":true},{"text":"i Ala xa fe fahaamuma nɛ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"barima Alatala nan lɔnni fima,","poem":1},{"lineBreak":true},{"text":"xaxili fanyi nun nɔndi minima a kɛrɛ i.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A fe fanyi gbegbe ragatama tinxintɔɛe bɛ.","poem":1},{"lineBreak":true},{"text":"A nɔndi falɛ makantama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A mixi tinxinxi makantama,","poem":1},{"lineBreak":true},{"text":"a a xanuntenyie ratangama kira xɔn ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Na kui, i nɔndi nun tinxinyi kolonma nɛ,","poem":1},{"lineBreak":true},{"text":"kira tinxinxi naxee mixi tima fe fanyi ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lɔnni fama i bɔɲɛ nan ma,","poem":1},{"lineBreak":true},{"text":"fe kolonyi ɲɔxunma i bɛ,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"xaxili fanyi i ratangama,","poem":1},{"lineBreak":true},{"text":"nɔndi i makantama,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"a i ratangama kira ɲaaxi ma,","poem":1},{"lineBreak":true},{"text":"a i ratangama wɔyɛn kobi falɛ ma,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"naxee gbilenma tinxinyi kira fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"naxee ɲɛrɛma dimi kui,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"fe ɲaaxi rafanxi naxee ma,","poem":1},{"lineBreak":true},{"text":"naxee ɲɛlɛxinxi kobiɲa ra,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"naxee xa kira mu tinxin,","poem":1},{"lineBreak":true},{"text":"naxee ɲɛrɛ ki mu fan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lɔnni i ratangama nɛ ginɛ ɲaaxi ma,","poem":1},{"lineBreak":true},{"text":"langoe ginɛ xa dɛ iɲɔxunyi ma,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"naxan a xa xɛmɛ singe finsiriwalima,","poem":1},{"lineBreak":true},{"text":"naxan nɛɛmuma a Marigi Ala xa saatɛ ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A xa wali kobi a rabirama nɛ,","poem":1},{"lineBreak":true},{"text":"a ɲɛrɛ ki a xanin aligiyama.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Mixi naxee birama a fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"e mu gbilenma sɔnɔn, e mu kisi sɔtɔma.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A lanma i xa i ɲɛrɛ mixi fanyie nan ma kira ra,","poem":1},{"lineBreak":true},{"text":"i xa tinxintɔɛe xa kira suxu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Mixi tinxinxie luma nɛ yi bɔxi ma,","poem":1},{"lineBreak":true},{"text":"mixi hagigɛe mu kelima be,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"kɔnɔ mixi ɲaaxie tan ɲɔnma nɛ yi bɔxi ma,","poem":1},{"lineBreak":true},{"text":"tinxintaree kerima nɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}