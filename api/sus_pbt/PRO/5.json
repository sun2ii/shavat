{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PRO","translationId":"sus_pbt","name":"Taalie","commonName":"Taalie","title":"Ala xa Taalie Ala xa Taalie","order":20,"numberOfChapters":31,"sha256":"975752b79deafabebf5ed03fa8b74e9ede5472bcd752b4569072c55213015430","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sus_pbt/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":5,"content":[{"type":"heading","content":["Yɛnɛ xa kanari"]},{"type":"verse","number":1,"content":[{"text":"N ma di, mɛɛni n ma lɔnni ma,","poem":1},{"lineBreak":true},{"text":"i i tuli mati n ma xaxili fanyi ra,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"alako i xa fahaamui sɔtɔ,","poem":1},{"lineBreak":true},{"text":"i dɛ xa wɔyɛnyi xɔri fala.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Langoe xa wɔyɛnyie ɲɔxun alɔ kumi,","poem":1},{"lineBreak":true},{"text":"a masalaxun alɔ suloɲi,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"kɔnɔ a raɲɔnyi xɔnɔ alɔ meli,","poem":1},{"lineBreak":true},{"text":"a xɛɲɛn alɔ santidɛgɛma dɛ firinyi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A sanyie a xun tima gbaloe ra,","poem":1},{"lineBreak":true},{"text":"a xa kira mixi xaninma aligiyama nɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A mu luma simaya kira xɔn ma.","poem":1},{"lineBreak":true},{"text":"A lɔɛxi, kɔnɔ a mu a kolon.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yakɔsi, n ma di, i i tuli mati n na,","poem":1},{"lineBreak":true},{"text":"i naxa i makuya n ma masenyi ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I makuya langoe xa kira ra,","poem":1},{"lineBreak":true},{"text":"i naxa i makɔrɛ a xa banxi naadɛ ra,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"alako binyɛ naxa ba i ma,","poem":1},{"lineBreak":true},{"text":"xɛmɛ ya ixaraxi naxa fa i xa duniɲɛigiri kana.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xa na mu a ra mixi gbɛtɛe nan lugama i harige ra,","poem":1},{"lineBreak":true},{"text":"i xa wali tɔnɛ lu booree bɛ,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"i i xa simaya raɲɔn tɔɔrɛ kui,","poem":1},{"lineBreak":true},{"text":"i fate birin ba i ma a ɲaaxi ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I a falama nɛ kɔrɛ,","poem":1},{"lineBreak":true},{"text":"«N na marasi xɔn munfe ra?","poem":1},{"lineBreak":true},{"text":"N bɔɲɛ tondi na sɛriyɛ ra munfe ra?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Munfe ra n mu n tuli mati n karamɔxɔɛe ra,","poem":1},{"lineBreak":true},{"text":"n mu n tuli mati n nasimae ra?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N fa na tɔɔrɛ birin dɔnxɔɛ nan kui yi ki ɲama ya xɔri.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ye min, naxan minima i yɛtɛ xa kɔlɔnyi ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I naxa tin i xa kɔlɔnyi ye xa goro mixie bun ma,","poem":1},{"lineBreak":true},{"text":"i naxa tin i xa ye xa makana taa kui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Na ye xa findi i keren nan gbe ra,","poem":1},{"lineBreak":true},{"text":"i tan nun xɔɲɛe naxa na itaxun.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Barakɛ xa lu i xa kɔlɔnyi ma,","poem":1},{"lineBreak":true},{"text":"i xa sɛɛwa i xa ginɛ ra i","poem":1},{"lineBreak":true},{"text":"naxan futi i fonike ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I xa ginɛ tofan alɔ bole, a fan alɔ xeli.","poem":1},{"lineBreak":true},{"text":"A xa marafanyi xa lu i bɔɲɛ kui,","poem":1},{"lineBreak":true},{"text":"i xa a maxanu tɛmui birin.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N ma di, i birama mixi gbɛtɛ xa ginɛ fɔxɔ ra munfe ra?","poem":1},{"lineBreak":true},{"text":"Munfe ra i ginɛ xiɲɛ sunbuma","poem":1},{"lineBreak":true},{"text":"i gbe mu naxan na?","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Alatala adama ɲɛrɛ ki birin kolon.","poem":1},{"lineBreak":true},{"text":"A adama xa kira birin toma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Mixi ɲaaxi xa wali ɲaaxie nan a suxuxi,","poem":1},{"lineBreak":true},{"text":"a xa yangoe nan findixi gantanyi ra a bɛ.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A xa xurutareɲa nan a niyama a faxa,","poem":1},{"lineBreak":true},{"text":"a xa daxuɲa nan a niyama a bɔnɔ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}