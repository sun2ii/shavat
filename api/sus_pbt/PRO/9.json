{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PRO","translationId":"sus_pbt","name":"Taalie","commonName":"Taalie","title":"Ala xa Taalie Ala xa Taalie","order":20,"numberOfChapters":31,"sha256":"975752b79deafabebf5ed03fa8b74e9ede5472bcd752b4569072c55213015430","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/sus_pbt/PRO/31.json","totalNumberOfVerses":913},"chapter":{"number":9,"content":[{"type":"heading","content":["Xaxilimaya nun lɔnnitareɲa"]},{"type":"verse","number":1,"content":[{"text":"Lɔnni bara a xa banxi ti fanye solofere fari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A bara xuruse nde faxa, a wɛni yailan,","poem":1},{"lineBreak":true},{"text":"a xa dɔxɔ teebili ra a dɛgede.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A bara xɛɛrae xɛɛ taa kui mixi xilife ra,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«Wo tan xaxilitaree nun fahaamutare,","poem":1},{"lineBreak":true},{"text":"wo fa be.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wo xa fa n ma taami don,","poem":1},{"lineBreak":true},{"text":"wo xa fa n ma wɛni fanyi min.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wo xa gbilen fe ɲaaxie fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"wo xa bira xaxilima xa kira fɔxɔ ra.»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mixi yo naxan katama yɛtɛ igboe matinxinde,","poem":1},{"lineBreak":true},{"text":"a maraɲaaxui nan sɔtɔma.","poem":1},{"lineBreak":true},{"text":"Mixi yo naxan katama mixi ɲaaxi raside,","poem":1},{"lineBreak":true},{"text":"a konbi nan sɔtɔma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xa i xurutare rasi, a i xɔnma nɛ.","poem":1},{"lineBreak":true},{"text":"Xa i xaxilima rasi, a i xanuma nɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I naxan falama lɔnnila bɛ,","poem":1},{"lineBreak":true},{"text":"a nde nan sama a xa lɔnni xun.","poem":1},{"lineBreak":true},{"text":"I naxan masenma tinxintɔɛ bɛ,","poem":1},{"lineBreak":true},{"text":"a nde nan sama a xa tinxinyi xun.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lɔnni fɔlɔma Alatala xa yaragaaxui nan ma.","poem":1},{"lineBreak":true},{"text":"Fahaamui sɔtɔma Ala Sɛniyɛntɔɛ kolonfe nan ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I xa duniɲɛigiri xɔn kuyama nɛ lɔnni ra,","poem":1},{"lineBreak":true},{"text":"i xa simaya ɲɛ kɔnti xun masama nɛ fahaamui ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xaxilima lɔnni sare nan sɔtɔma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ mixi naxan yoma a boore ma, na tɔɔrɛ nan tun sɔtɔma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Xaxilitareɲa luxi nɛ alɔ ginɛ naxan dɛ wuya,","poem":1},{"lineBreak":true},{"text":"a mu xuru, a mu fe kolon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A dɔxɔma a xa banxi sode dɛ nan na","poem":1},{"lineBreak":true},{"text":"dɔxɔse ma naxan na yire itexi,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"alako a xa dangi mixie xili a xui itexi ra,","poem":1},{"lineBreak":true},{"text":"naxee na e ɲɛrɛfe kira tinxinxie xɔn ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A a falama mixie bɛ naxee mu fahaamui sɔtɔxi,","poem":1},{"lineBreak":true},{"text":"«Wo tan xaxilitaree, wo fa be.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Minse muɲaxi ɲɔxun,","poem":1},{"lineBreak":true},{"text":"taami donxi dunxui ra, na fan ɲɔxun.»","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"E mu a kolon faxɛ dimi nan mɛnni ra.","poem":1},{"lineBreak":true},{"text":"Mixi naxee a xa xili ratinma,","poem":1},{"lineBreak":true},{"text":"nee xun tixi aligiyama nan na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}