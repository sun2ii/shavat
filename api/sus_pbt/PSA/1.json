eBreak":true},{"text":"A burɛxɛ mu lisima.","poem":1},{"lineBreak":true},{"text":"Na adama, fefe suxuma, a sɔɔnɛyama nɛ a bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kɔnɔ a mu na ki xɛ mixi ɲaaxie tan bɛ.","poem":1},{"lineBreak":true},{"text":"E tan maniyɛ maale lagi ra foye naxan xaninma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mixi ɲaaxie bɔnɔma nɛ kiiti waxati,","poem":1},{"lineBreak":true},{"text":"e mu luma tinxin mixie ya ma.","poem":1},{"lineBreak":true},{"text":"Lude mu na e bɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala mɛɛnima tinxintɔɛe ma a xa kira xɔn ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ mixi ɲaaxi tan xa kira findima gbaloe kira nan na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}