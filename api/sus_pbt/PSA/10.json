{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":10,"content":[{"type":"heading","content":["I naxa nɛɛmu setare ma"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Alatala, i i makuyaxi n na munfe ra?","poem":1},{"lineBreak":true},{"text":"I i nɔxunxi muxu ma muxu xa tɔɔrɛ kui munfe ra?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yɛtɛ igboe setaree tɔɔrɔma,","poem":1},{"lineBreak":true},{"text":"a xa maɲɔxunyi kobi nɔma e ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A a yɛtɛ igboma a xa wali ɲaaxi xa fe ra.","poem":1},{"lineBreak":true},{"text":"Alatala xɔnɔma a xa naafuli sɔtɔ ki ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mixi ɲaaxi yɛtɛ igboe naxɛ,","poem":1},{"lineBreak":true},{"text":"«Ala mu na! A mu nɔma sese rabade n na!»","poem":1},{"lineBreak":true},{"text":"A xa maɲɔxunyi birin nan ya.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A xa wali birin sɔɔnɛyama nɛ.","poem":1},{"lineBreak":true},{"text":"A mu gaaxuma Ala xa kiiti ya ra.","poem":1},{"lineBreak":true},{"text":"A yoma a yaxuie ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A maɲɔxunma a bɔɲɛ ma,","poem":1},{"lineBreak":true},{"text":"«Sese mu a niyama n bira.","poem":1},{"lineBreak":true},{"text":"Tɔɔrɛ man mu n suxuma.»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A dɛ mixi dankama, a wule fala.","poem":1},{"lineBreak":true},{"text":"A fe ɲaaxi tinxintare nan tun falama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A mixi mɛlɛnma taa fari ma, a xa mixi fanyi faxa.","poem":1},{"lineBreak":true},{"text":"A mu taganma fe ɲaaxi rabafe ra mixi fanyi ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A setaree mɛlɛnma alɔ yɛtɛ.","poem":1},{"lineBreak":true},{"text":"A e suxu a xa gantanyi ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na setaree luma a xa nɔɛ bun ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A a falama a bɔɲɛ kui,","poem":1},{"lineBreak":true},{"text":"«Ala mu sese toma. A ya raxixi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alatala keli! I naxa nɛɛmu setare ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Munfe ra mixi ɲaaxi yoma Ala ma?","poem":1},{"lineBreak":true},{"text":"Munfe ra a a falama a yɛtɛ bɛ,","poem":1},{"lineBreak":true},{"text":"«Ala mu n ɲaxankatama»?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɔnɔ Ala, i tɔɔrɛ nun nimisɛ toma.","poem":1},{"lineBreak":true},{"text":"I tɔɔrɔmixie malima.","poem":1},{"lineBreak":true},{"text":"Naxan mu nɔma a yɛtɛ kantade,","poem":1},{"lineBreak":true},{"text":"a a yɛtɛ taxuma i tan na na.","poem":1},{"lineBreak":true},{"text":"I tan nan na kiridi malima ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mixi ɲaaxi sɛnbɛ kana!","poem":1},{"lineBreak":true},{"text":"E ɲaxankata e xa fe ɲaaxi xa fe ra!","poem":1},{"lineBreak":true},{"text":"E ralɔɛ yi duniɲa ma!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mangɛ nan Alatala ra.","poem":1},{"lineBreak":true},{"text":"Na mu kanama abadan.","poem":1},{"lineBreak":true},{"text":"Kuye batui mu luma a xa bɔxi ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala, i i tuli tixi mixi magoroxie ra.","poem":1},{"lineBreak":true},{"text":"I limaniya fima e ma.","poem":1},{"lineBreak":true},{"text":"I e xa maxandi suxuma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I tɔɔrɔmixi nun kiridi kantama,","poem":1},{"lineBreak":true},{"text":"alako adamadi naxan findixi bɛndɛ ra, a naxa e magaaxu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}