"poem":1},{"lineBreak":true},{"text":"Wo tantui rasiga a ma, wo a xili matɔxɔ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"barima Alatala fan, a xa xanunteya buma nɛ abadan,","poem":1},{"lineBreak":true},{"text":"a xa dugutɛgɛɲa mu ɲɔnma duniɲa bɛndɛ fuɲi fari ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}