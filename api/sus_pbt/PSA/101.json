{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":101,"content":[{"type":"heading","content":["Dawuda xa natɛe"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti","descriptive":true},{"text":"N dugutɛgɛɲa nun tinxinyi matɔxɔma nɛ.","poem":1},{"lineBreak":true},{"text":"N bɛɛti bama i tan nan bɛ Alatala.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N fe birin nabama lufe ra tinxintɔɛ xa kira xɔn.","poem":1},{"lineBreak":true},{"text":"I fama n yire mun tɛmui?","poem":1},{"lineBreak":true},{"text":"N na n ɲɛrɛma nɛ n bɔɲɛ fiixɛxi ra n ma mixie tagi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N mu n ya tima fe tinxintare ra,","poem":1},{"lineBreak":true},{"text":"n mu tinma yanfante xa kira ra,","poem":1},{"lineBreak":true},{"text":"n nun e tan mu lanma fe yo ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N tan nun mixi ɲaaxi tagi kuya,","poem":1},{"lineBreak":true},{"text":"n mu wama yunubi xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N mixi dɛ balanma nɛ naxan a boore mafalama.","poem":1},{"lineBreak":true},{"text":"N mu tinma yɛtɛ matɔxɔɛ nun yɛtɛ igboɲa ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na n ɲɔxɔ sama nɛ yi bɔxi dugutɛgɛe xɔn ma,","poem":1},{"lineBreak":true},{"text":"alako e xa lu n sɛɛti ma.","poem":1},{"lineBreak":true},{"text":"N wama tinxintɔɛe nan xɔn ma, e xa n mali.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yanfantee mu luma n ma mixie ya ma,","poem":1},{"lineBreak":true},{"text":"wule falɛe mu tima n ya i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gɛɛsɛgɛ birin n mixi kobie sɔntɔma nɛ,","poem":1},{"lineBreak":true},{"text":"alako na mixi mɔɔli naxa lu Alatala xa taa kui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}