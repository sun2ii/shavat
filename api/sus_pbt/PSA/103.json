{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":103,"content":[{"type":"heading","content":["Ala xa marafanyi"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti","descriptive":true},{"text":"N xa Alatala tantu n nii birin na,","poem":1},{"lineBreak":true},{"text":"n xa a xili sɛniyɛnxi matɔxɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N xa Alatala tantu n nii birin na,","poem":1},{"lineBreak":true},{"text":"n naxa nɛɛmu a xa hinnɛ ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A tan nan diɲɛma i xa yunubie ma,","poem":1},{"lineBreak":true},{"text":"a i xa furee rayalan,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"a i ratanga faxɛ ma,","poem":1},{"lineBreak":true},{"text":"a i rabilin a xa xanunteya nun a xa kinikini ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A hinnɛma i ra i xa duniɲɛigiri kui,","poem":1},{"lineBreak":true},{"text":"alako i man xa sɛnbɛ sɔtɔ i xa foriɲa kui alɔ sɛgɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alatala ɲɛrɛma tinxinyi kui,","poem":1},{"lineBreak":true},{"text":"a kiiti tinxinxi sama tɔɔrɔmixie bɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A bara a xa kira masen Annabi Munsa bɛ,","poem":1},{"lineBreak":true},{"text":"a a xa kaabanakoee masen Isirayilakae bɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala kinikinima mixie ma, a hinnɛ e ra,","poem":1},{"lineBreak":true},{"text":"a mu xɔnɔma e ma mafuren mafuren,","poem":1},{"lineBreak":true},{"text":"a xa xanunteya gbo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A mu mixie tɔɔrɔma tɛmui birin,","poem":1},{"lineBreak":true},{"text":"a xa xɔnnanteya mu buma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A mu won ɲaxankatama won ma yunubi rabaxi ki ma,","poem":1},{"lineBreak":true},{"text":"a mu won ma yunubi sare ragbilenma won ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Koore itexi bɔxi xun ma ki naxɛ,","poem":1},{"lineBreak":true},{"text":"a xa xanunteya fan gboxi na ki nɛ a yaragaaxuie bɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Sogetede makuyaxi sogegorode ra ki naxɛ,","poem":1},{"lineBreak":true},{"text":"a won ma yunubie fan makuyaxi won na na ki nɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Babae kinikinima e xa die ma ki naxɛ,","poem":1},{"lineBreak":true},{"text":"Alatala fan kinikinima a yaragaaxuie ma na ki nɛ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"barima a a kolon won yailanxi se naxan na,","poem":1},{"lineBreak":true},{"text":"a ratuxi a ma a bɛndɛ nan won na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Adamadie xa simaya maniya sansi ra naxan fugama fiili ma,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"kɔnɔ foye na bɔnbɔ a ra, a xarama nɛ, a lɔɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kɔnɔ Alatala a yaragaaxuie xanuma nɛ abadan,","poem":1},{"lineBreak":true},{"text":"a xa tinxinyi birama nɛ e bɔnsɔɛe fɔxɔ ra,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"naxee a xa saatɛ binyama,","poem":1},{"lineBreak":true},{"text":"e a xa sɛriyɛ rabatu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Alatala bara a xa kibanyi dɔxɔ koore ma,","poem":1},{"lineBreak":true},{"text":"a duniɲa birin yamari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wo tan malekɛe, wo xa Alatala tantu,","poem":1},{"lineBreak":true},{"text":"wo tan naxee sɛnbɛ gbo, wo tan naxee a rabatuma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wo tan sɛnbɛma naxee na koore ma,","poem":1},{"lineBreak":true},{"text":"wo xa Alatala tantu,","poem":1},{"lineBreak":true},{"text":"wo tan naxee a waxɔnfe rabama.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wo tan birin naxee daaxi,","poem":1},{"lineBreak":true},{"text":"wo xa Alatala tantu yire birin a xa mangɛya bun ma.","poem":1},{"lineBreak":true},{"text":"N xa Alatala tantu n nii birin na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}