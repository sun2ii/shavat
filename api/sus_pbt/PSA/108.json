{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":108,"content":[{"type":"heading","content":["Xunnakeli Ala saabui ra"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, n bara natɛ tongo n bɔɲɛ kui.","poem":1},{"lineBreak":true},{"text":"N Marigi Xunnakeli Kanyi, n n xui raminima nɛ bɛɛtie ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N n ma kɔrae nun n ma maxasee berema nɛ subaxɛ ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N Marigi, n i batuma nɛ sie tagi,","poem":1},{"lineBreak":true},{"text":"n i matɔxɔma nɛ bɛɛti ra ɲamanɛe ya ma,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"barima i xa dugutɛgɛɲa gbo dangi koore ra,","poem":1},{"lineBreak":true},{"text":"i xa xanunteya ite alɔ nuxuie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ala, i xunyi rakeli koore ma,","poem":1},{"lineBreak":true},{"text":"i xa nɔrɛ xa lu bɔxi birin xun ma,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"alako i xanuntenyie xa kisi i sɛnbɛ saabui ra.","poem":1},{"lineBreak":true},{"text":"Yandi, n ma duba suxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ala bara wɔyɛn a xa lingira sɛniyɛnxi kui,","poem":1},{"lineBreak":true},{"text":"«N n xun nakelima nɛ,","poem":1},{"lineBreak":true},{"text":"n Sikemi bɔxi itaxun,","poem":1},{"lineBreak":true},{"text":"n Sukɔti gulunba sɔtɔma nɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N gbe nan Galadi ra, n gbe nan Manasi ra.","poem":1},{"lineBreak":true},{"text":"Efirami bɔxi tan luma nɛ alɔ n xun makantase,","poem":1},{"lineBreak":true},{"text":"Yudaya findi n ma munyaati ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N n sanyi maxama Mowaba bɔxi ma,","poem":1},{"lineBreak":true},{"text":"n n ma sankiri wolima Edon nan ma a xa findi n gbe ra.","poem":1},{"lineBreak":true},{"text":"N gere ti xui mɛma nɛ Filisita bɔxi ma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Nde n xun tima taa makantaxi ra?","poem":1},{"lineBreak":true},{"text":"Nde n xaninma Edon bɔxi ma?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala mu a ra, naxan muxu rabɛɲinxi gere kui?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I xa fa muxu malide, i xa muxu ba muxu yaxuie yi ra.","poem":1},{"lineBreak":true},{"text":"Adamadie xa mali fufafu na a ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Won fama won sɛnbɛ raminide Ala xa mali saabui ra.","poem":1},{"lineBreak":true},{"text":"A tan nan fama won yaxuie iwurude.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}