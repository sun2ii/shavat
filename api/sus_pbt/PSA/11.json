{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":11,"content":[{"type":"heading","content":["Tinxinyi rafan Ala ma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true},{"text":"N bara Alatala findi n yigi ra. Wo a falama n bɛ di,","poem":1},{"lineBreak":true},{"text":"«I i gi alɔ xɔni naxan tuganma sigafe ra geya ma,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"barima mixi ɲaaxie bara e xa xalie tongo, e xa mixi bɔɲɛ fanyie faxa.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xa sɛriyɛ mu na mixie tagi sɔnɔn, tinxintɔɛ fa munse rabama?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala na a xa hɔrɔmɔbanxi sɛniyɛnxi kui.","poem":1},{"lineBreak":true},{"text":"A xa kibanyi na ariyanna.","poem":1},{"lineBreak":true},{"text":"A adamadie matoma a fanyi ra,","poem":1},{"lineBreak":true},{"text":"a xa a kolon naxan na e sondonyi kui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala tinxintɔɛ nun tinxintare matoma.","poem":1},{"lineBreak":true},{"text":"Gbaloe rafan naxee ma, a nee raɲaaxu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A tinxintare luma tɔɔrɛ mɔɔli birin kui.","poem":1},{"lineBreak":true},{"text":"Na luma nɛ alɔ tɛ wolenxi nun foye ɲaaxi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala tinxin. Tinxinyi rafan a ma.","poem":1},{"lineBreak":true},{"text":"Tinxintɔɛ fama a yatagi tode.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}