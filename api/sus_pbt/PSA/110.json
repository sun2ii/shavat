{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":110,"content":[{"type":"heading","content":["Alatala nan Mangɛ Xungbe dɔxɔma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"hebrew_subtitle","content":["Dawuda xa bɛɛti"]},{"type":"verse","number":1,"content":[{"text":"Alatala xa masenyi n marigi bɛ:","poem":1},{"lineBreak":true},{"text":"«I magoro n yifanyi ma,","poem":1},{"lineBreak":true},{"text":"han n xa i sanyi ti i yaxuie fari.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Alatala i sɛnbɛ ragboma nɛ kelife Siyoni,","poem":1},{"lineBreak":true},{"text":"han i i yaxuie yamari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I xa sɔɔrie luma nɛ i fɔxɔ ra gere kui.","poem":1},{"lineBreak":true},{"text":"Na kuye na iba subaxɛ ma,","poem":1},{"lineBreak":true},{"text":"i sɛnbɛ gboma nɛ sɛniyɛnyi kui alɔ i fonike waxati.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala bara a kali yi laayidi ra, naxan mu kanama:","poem":1},{"lineBreak":true},{"text":"«N bara i findi sɛrɛxɛdubɛ ra abadan,","poem":1},{"lineBreak":true},{"text":"a Melekisedeki daaxi.»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Marigi luma i yifanyi ma,","poem":1},{"lineBreak":true},{"text":"a mangɛe kanama nɛ a xa xɔnɛ lɔxɔɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A a xa kiiti raɲɛrɛma nɛ ɲamanɛe fari,","poem":1},{"lineBreak":true},{"text":"a e sɔntɔ, a mangɛ xungbe nde xun nakana.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mangɛ xure ye minma kira i.","poem":1},{"lineBreak":true},{"text":"A xun nakelima na nan ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}