{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":111,"content":[{"type":"heading","content":["Ala matɔxɔma fe naxee ma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo Alatala matɔxɔ!","poem":1},{"lineBreak":true},{"text":"N Alatala batuma nɛ n bɔɲɛ birin na,","poem":1},{"lineBreak":true},{"text":"tinxintɔɛe nun ɲama ya ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Marigi xa walie makaaba.","poem":1},{"lineBreak":true},{"text":"E rafan mixie ma naxee tinma e matode.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A xa walie nɔrɔxi,","poem":1},{"lineBreak":true},{"text":"a xa tinxinyi buma nɛ abadan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A a niya birin xa ratu a xa kaabanakoe ma.","poem":1},{"lineBreak":true},{"text":"Alatala hinnɛma adamadie ra, a kinikini e ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A baloe fima mixi ma naxan gaaxuma a ya ra,","poem":1},{"lineBreak":true},{"text":"a ratu a xa saatɛ ma abadan.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A bara a xa wali sɛnbɛ masen a xa ɲama bɛ,","poem":1},{"lineBreak":true},{"text":"ɲamanɛ gbɛtɛe kɛ sofe ra e yi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A walima nɔndi nun tinxinyi nan fari.","poem":1},{"lineBreak":true},{"text":"A xa yaamarie findima sɛriyɛ fanyi nan na,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"naxee mu kanama abadan,","poem":1},{"lineBreak":true},{"text":"adamadie lanma e xa naxee rakamali.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A bara a xa ɲama xun sara,","poem":1},{"lineBreak":true},{"text":"a bara a xa saatɛ mabanban abadan.","poem":1},{"lineBreak":true},{"text":"A xili sɛniyɛn, a magaaxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Xaxilimaya fɔlɔma Alatala yaragaaxui nan ma.","poem":1},{"lineBreak":true},{"text":"Mixi naxan gaaxuma Ala ya ra, a xaxili fanyi sɔtɔma nɛ.","poem":1},{"lineBreak":true},{"text":"Adamadie lanma e xa a matɔxɔ abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}