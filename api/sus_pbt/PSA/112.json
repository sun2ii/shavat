{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":112,"content":[{"type":"heading","content":["Tinxintɔɛ sare"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo Marigi Ala matɔxɔ!","poem":1},{"lineBreak":true},{"text":"Hɛɛri na mixi bɛ naxan gaaxuma Marigi ya ra,","poem":1},{"lineBreak":true},{"text":"naxan tinma a xa yaamarie rabatude.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"A bɔnsɔɛ sɛnbɛ gboma nɛ bɔxi ma.","poem":1},{"lineBreak":true},{"text":"Barakɛ luma tinxintɔɛ nan ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naafuli nun bannaya luma a yi ra,","poem":1},{"lineBreak":true},{"text":"a xa tinxinyi xanxi abadan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yanbɛ minima dimi kui tinxintɔɛ bɛ,","poem":1},{"lineBreak":true},{"text":"naxan kinikinima a boore ma,","poem":1},{"lineBreak":true},{"text":"naxan hinnɛma adamadie ra,","poem":1},{"lineBreak":true},{"text":"naxan luma ɲɛrɛ ra tinxinyi kui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Barakɛ luma mixi bɛ naxan mixie kima,","poem":1},{"lineBreak":true},{"text":"naxan tinma mixi donide,","poem":1},{"lineBreak":true},{"text":"naxan walima tinxinyi ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na kanyi mu birama,","poem":1},{"lineBreak":true},{"text":"mixie mu nɛɛmuma a xa tinxinyi ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A mu gaaxuma xibaaru ɲaaxi ya ra,","poem":1},{"lineBreak":true},{"text":"barima a xaxili tixi Alatala ra, a bɔɲɛ xanxi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A bɔɲɛ raxara, gaaxui yo mu a ma.","poem":1},{"lineBreak":true},{"text":"A raɲɔnyi, a nɔma nɛ a yaxuie ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"A misikiinɛ kima,","poem":1},{"lineBreak":true},{"text":"a ɲɛrɛma tinxinyi kui tɛmui birin,","poem":1},{"lineBreak":true},{"text":"a xun nakelima tun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mixi ɲaaxi tɔɔrɔma na tofe ra,","poem":1},{"lineBreak":true},{"text":"a a ɲinyi maxinma, a xa fe xun nakanama.","poem":1},{"lineBreak":true},{"text":"Mixi ɲaaxie xa natɛ mu kamalima fefe ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}