{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":113,"content":[{"type":"heading","content":["Alatala maniyɛ mu na"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo Alatala matɔxɔ!","poem":1},{"lineBreak":true},{"text":"Alatala xa konyi die, wo xa a matɔxɔ.","poem":1},{"lineBreak":true},{"text":"Wo Alatala xili matɔxɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Tantui na Alatala bɛ abadan.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tantui na Alatala bɛ yire birin,","poem":1},{"lineBreak":true},{"text":"kelife sogetede mabiri, han sogegorode.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala xa nɔɛ na ɲamanɛe xun ma, a xa nɔrɛ na koore ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nde maniyɛ won Marigi Alatala ra,","poem":1},{"lineBreak":true},{"text":"naxan magoroxi a xa kibanyi kui koore ma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"naxan a ya ragoroma koore nun bɔxi ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A misikiinɛ xun nakelima,","poem":1},{"lineBreak":true},{"text":"a tɔɔrɔmixi bama a xa setareɲa kui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A a tima a xa kuntigie sɛɛti ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A di gbegbe fima ginɛ dibaritare ma,","poem":1},{"lineBreak":true},{"text":"alako a xa sɛɛwa sɔtɔ a xa die ya ma.","poem":1},{"lineBreak":true},{"text":"Wo Alatala matɔxɔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}