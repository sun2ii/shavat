{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":114,"content":[{"type":"heading","content":["Isirayila bɔxi Ala xa ɲama rasɛnɛfe"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Yaxuba bɔnsɔɛ naxan findixi Isirayila ra,","poem":1},{"lineBreak":true},{"text":"e naxa mini Misira xa konyiya ra,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"e sabati Yudaya Ala xa hɔrɔmɔlingira luxi dɛnnaxɛ.","poem":1},{"lineBreak":true},{"text":"Isirayila bɔxi naxa findi Ala xa mangɛya ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xulunyumi baa to Isirayila ɲama to,","poem":1},{"lineBreak":true},{"text":"a naxa rabi mafuren.","poem":1},{"lineBreak":true},{"text":"Yurudɛn xure to e to fa ra, a man naxa kira fi e ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Isirayila geyae to e to, e naxa tugan tugan ɲɛlɛxinyi ra,","poem":1},{"lineBreak":true},{"text":"alɔ yɛxɛɛ kontonyie nun yɛxɛɛ yɔrɛe tuganma ki naxɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Munse a niyaxi na baa xa rabi mafuren?","poem":1},{"lineBreak":true},{"text":"Munse a niyaxi Yurudɛn xure kira fixi e ma?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Munse a niyaxi Isirayila geyae xa ɲɛlɛxin","poem":1},{"lineBreak":true},{"text":"alɔ yɛxɛɛ kontonyie nun yɛxɛe yɔrɛe?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Duniɲa birin xa sɛrɛn Marigi ya ra,","poem":1},{"lineBreak":true},{"text":"naxan findi Yaxuba Marigi Ala ra,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"naxan ye dulonyi ramini fanye xɔrɔxɔɛ kui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}