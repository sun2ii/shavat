{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":115,"content":[{"type":"heading","content":["Alatala gbo kuyee bɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Matɔxɔɛ mu lanma muxu tan bɛ,","poem":1},{"lineBreak":true},{"text":"matɔxɔɛ lanma Alatala nan bɛ,","poem":1},{"lineBreak":true},{"text":"a xa hinnɛ nun dugutɛgɛɲa xa fe ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Munfe ra ɲamanɛe a falama,","poem":1},{"lineBreak":true},{"text":"«E xa Ala na minden?»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muxu Marigi Ala na koore ma,","poem":1},{"lineBreak":true},{"text":"a a waxɔnfe birin nabama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kɔnɔ e xa kuyee yailanxi xɛɛma nun gbeti nan na,","poem":1},{"lineBreak":true},{"text":"e yɛtɛ bɛlɛxɛe saabui ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dɛ na e bɛ, kɔnɔ e mu wɔyɛnma,","poem":1},{"lineBreak":true},{"text":"ya na e bɛ, kɔnɔ e mu se toma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"tuli na e bɛ, kɔnɔ e mu xui mɛma,","poem":1},{"lineBreak":true},{"text":"ɲɔɛ na e bɛ, kɔnɔ e mu se xiri mɛma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛlɛxɛ na e bɛ, kɔnɔ e mu se masuxuma,","poem":1},{"lineBreak":true},{"text":"sanyi na e bɛ, kɔnɔ e mu e ɲɛrɛma.","poem":1},{"lineBreak":true},{"text":"Xui yo mu minima e kɔn na!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E yailanmae fama nɛ lude alɔ e tan.","poem":1},{"lineBreak":true},{"text":"Mixi naxee e xaxili tima e ra","poem":1},{"lineBreak":true},{"text":"e findima sɛnbɛtaree nan na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Isirayila bɔnsɔɛ, i xaxili ti Alatala ra,","poem":1},{"lineBreak":true},{"text":"naxan findi i xa dɛmɛri nun i kantama ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Haruna bɔnsɔɛ, i xaxili ti Alatala ra,","poem":1},{"lineBreak":true},{"text":"naxan findi i xa dɛmɛri nun i kantama ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wo tan naxee findixi Ala yaragaaxuie ra,","poem":1},{"lineBreak":true},{"text":"wo wo xaxili ti Alatala ra,","poem":1},{"lineBreak":true},{"text":"naxan findi i xa dɛmɛri nun i kantama ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Marigi a ɲɔxɔ saxi won xɔn ma.","poem":1},{"lineBreak":true},{"text":"A won barakama nɛ.","poem":1},{"lineBreak":true},{"text":"Isirayila bɔnsɔɛ yo, Haruna bɔnsɔɛ yo,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"nun Ala yaragaaxuie birin yo,","poem":1},{"lineBreak":true},{"text":"e barakɛ sɔtɔma nɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alatala xa wo tan nun wo xa die yiriwa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Alatala naxan koore nun bɔxi daa,","poem":1},{"lineBreak":true},{"text":"a xa barakɛ fi wo ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Alatala nan gbe koore ra,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a naxa duniɲa tan fi adamadie ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mixi faxaxie xa mu Alatala matɔxɔma,","poem":1},{"lineBreak":true},{"text":"mixi naxee sigama aligiyama e mu nɔma matɔxɔɛ rabade,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"kɔnɔ won tan naxee na duniɲa,","poem":1},{"lineBreak":true},{"text":"a lanma won xa tantui rasiga Alatala ma,","poem":1},{"lineBreak":true},{"text":"fɔlɔ yi tɛmui ma han dan mu naxan ma.","poem":1},{"lineBreak":true},{"text":"Wo Alatala matɔxɔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}