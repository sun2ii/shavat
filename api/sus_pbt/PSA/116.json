{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":116,"content":[{"type":"heading","content":["Ala xa kisi faxɛ ma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"N Alatala xanuma barima a n xui mɛma.","poem":1},{"lineBreak":true},{"text":"A naxa kinikini n wa xui ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A to a tuli mati n na,","poem":1},{"lineBreak":true},{"text":"n a maxandima nɛ n ma simaya birin kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Faxɛ luuti nu bara n xiri,","poem":1},{"lineBreak":true},{"text":"aligiyama tɔɔrɛ nu bara n li,","poem":1},{"lineBreak":true},{"text":"nimisɛ nun kɔntɔfili nu bara nɔ n na,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"kɔnɔ na tɛmui n naxa Alatala maxandi,","poem":1},{"lineBreak":true},{"text":"«Alatala, yandi, n nakisi!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hinnɛnte nan Alatala ra, a tinxin.","poem":1},{"lineBreak":true},{"text":"Won Marigi Ala kinikinima won ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A mixi magoroxi kantama.","poem":1},{"lineBreak":true},{"text":"N sɛnbɛ to ɲɔn, a naxa n nakisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N xa n nii raxara,","poem":1},{"lineBreak":true},{"text":"barima Alatala bara fe fanyi raba n bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala, i bara n nii ratanga faxɛ ma,","poem":1},{"lineBreak":true},{"text":"i yaye ba n ya ra,","poem":1},{"lineBreak":true},{"text":"i n sanyi sɛnbɛ so,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"alako n xa ɲɛrɛ i tan Alatala ya ra mixi baloxi ya ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N to nu n xaxili tima i ra,","poem":1},{"lineBreak":true},{"text":"n naxa a fala i bɛ,","poem":1},{"lineBreak":true},{"text":"«N na tɔɔrɔfe.»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Limaniya to ba n yi ra,","poem":1},{"lineBreak":true},{"text":"n naxa a fala, «Wule falɛ nan mixi birin na.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alatala, n i sare fima di, i xa hinnɛ xa fe ra?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N i xa maratangɛ masenma nɛ ɲama bɛ,","poem":1},{"lineBreak":true},{"text":"Alatala xili matɔxɔfe ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N na n ma laayidie rakamalima nɛ Alatala bɛ,","poem":1},{"lineBreak":true},{"text":"a xa ɲama birin ya xɔri.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Alatala a ɲɔxɔ sama nɛ a batulae xa simaya xɔn ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I tan Alatala xa konyi di nan n na, i xa konyi ginɛ xa di,","poem":1},{"lineBreak":true},{"text":"i naxan nafulunxi saya luuti ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"N tantui sɛrɛxɛ bama nɛ i bɛ, n i xili matɔxɔma nɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N na n ma laayidie rakamalima nɛ Alatala bɛ,","poem":1},{"lineBreak":true},{"text":"a xa ɲama birin ya xɔri,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Alatala xa banxi tɛtɛ kui,","poem":1},{"lineBreak":true},{"text":"Darisalamu ɲama ya xɔri.","poem":1},{"lineBreak":true},{"text":"Wo Marigi matɔxɔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}