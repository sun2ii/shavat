{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":118,"content":[{"type":"heading","content":["Xaxili tife Alatala ra"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo Alatala tantu barima a fan,","poem":1},{"lineBreak":true},{"text":"a xa xanunteya mu ɲɔnma abadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Isirayila xa a fala,","poem":1},{"lineBreak":true},{"text":"«A xa xanunteya mu ɲɔnma abadan!»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Haruna bɔnsɔɛ xa a fala,","poem":1},{"lineBreak":true},{"text":"«A xa xanunteya mu ɲɔnma abadan!»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala yaragaaxuie xa a fala,","poem":1},{"lineBreak":true},{"text":"«A xa xanunteya mu ɲɔnma abadan!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N ma tɔɔrɛ kui, n naxa Alatala maxandi.","poem":1},{"lineBreak":true},{"text":"A naxa n ma duba suxu n fulunfe ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala na n sɛɛti ma,","poem":1},{"lineBreak":true},{"text":"n mu gaaxuma fefe ma.","poem":1},{"lineBreak":true},{"text":"Adamadi nɔma munse niyade n na?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala na n fɔxɔ ra, a n malima.","poem":1},{"lineBreak":true},{"text":"N fama nɛ nɔde n yaxuie ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Xaxili tife Alatala ra, na nan fan beenun xaxili tife adamadi ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yɛtɛ taxufe Alatala ra dangi yɛtɛ taxufe duniɲa mangɛe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Si birin nu n nabilinxi n gere xili ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ Alatala naxa a niya n xa nɔ e ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E nu n nabilinxi a ɲaaxi ra,","poem":1},{"lineBreak":true},{"text":"kɔnɔ n naxa nɔ e ra Alatala xili ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E naxa din n na alɔ kumi tɔnsɔɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ e naxa ɲɔn alɔ sɛxɛ xaraxi ganma ki naxɛ.","poem":1},{"lineBreak":true},{"text":"Alatala nan a niya n xa nɔ e ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"E nu n matutunma sɛnbɛ ra,","poem":1},{"lineBreak":true},{"text":"a gbe mu nu luxi n xa bira,","poem":1},{"lineBreak":true},{"text":"kɔnɔ Alatala naxa n mali.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala nan na n sɛnbɛ nun n ma sɛɛwɛ ra,","poem":1},{"lineBreak":true},{"text":"A bara n nakisi!","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sɛɛwɛ nun xunnakeli xui naxa mini tinxintɔɛe xɔnyi a falafe ra,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"«Alatala naxa wali sɛnbɛ ra!","poem":1},{"lineBreak":true},{"text":"A naxa a mangɛya masen,","poem":1},{"lineBreak":true},{"text":"a kaabanakoe raba.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"N mu faxa, n naxa kisi,","poem":1},{"lineBreak":true},{"text":"alako n xa Alatala xa kaabanakoe masen ɲama bɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alatala bara n ɲaxankata,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a mu n luxi n xa faxa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wo tinxinyi naadɛe rabi n bɛ,","poem":1},{"lineBreak":true},{"text":"n soma mɛnni Alatala tantufe ra.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatala xa naadɛ nan yi ki,","poem":1},{"lineBreak":true},{"text":"tinxintɔɛe soma naxan kui.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N i tantuma nɛ, barima i bara n ma duba suxu,","poem":1},{"lineBreak":true},{"text":"i bara findi n nakisima ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Banxitie mɛɛ gɛmɛ naxan na,","poem":1},{"lineBreak":true},{"text":"na bara findi banxi sangantimɛ ra.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Na kelixi Marigi nan ma.","poem":1},{"lineBreak":true},{"text":"Kaabanakoe na a ra won tan bɛ.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Lɔxɔɛ nan yi ki Alatala naxan ɲanigexi,","poem":1},{"lineBreak":true},{"text":"won xa ɲɛlɛxin, won xa sɛɛwa a xa fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Yandi Alatala, muxu rakisi!","poem":1},{"lineBreak":true},{"text":"Yandi Alatala, muxu xun nakeli.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Baraka na mixi ma naxan fafe Marigi xili ra.","poem":1},{"lineBreak":true},{"text":"Muxu Alatala matɔxɔma a xa banxi kui.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Marigi nan na Alatala ra,","poem":1},{"lineBreak":true},{"text":"naxan xa nɔrɛ bara yanba won ma.","poem":1},{"lineBreak":true},{"text":"Wo xa sɛrɛxɛ xiri sɛrɛxɛbade sɛɛti ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"N Marigi Ala nan i ra, n i tantuma nɛ,","poem":1},{"lineBreak":true},{"text":"n Marigi Ala nan i ra, n i matɔxɔma nɛ.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Wo Alatala tantu barima a fan.","poem":1},{"lineBreak":true},{"text":"A xa xanunteya mu ɲɔnma abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}