{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":121,"content":[{"type":"heading","content":["Dɛmɛri kelima Ala ma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Biyaasilae xa bɛɛti nde","descriptive":true},{"text":"N na n ya ratema geyae mabiri.","poem":1},{"lineBreak":true},{"text":"N ma dɛmɛri kelima minden?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ma dɛmɛri fatanma Alatala nan na,","poem":1},{"lineBreak":true},{"text":"naxan koore nun bɔxi daaxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A mu tinma i xa bira.","poem":1},{"lineBreak":true},{"text":"A i kantama, a mu kinsɔnma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Isirayila kantama mu kinsɔnma, a mu xima.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala nan i kantama.","poem":1},{"lineBreak":true},{"text":"A findixi niini nan na i bɛ,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"alako soge naxa i tɔɔrɔ yanyi ra,","poem":1},{"lineBreak":true},{"text":"kike naxa i tɔɔrɔ kɔɛ ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala i ratangama nɛ tɔɔrɛ birin ma, a i nii makantama.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I na mini, Alatala luma nɛ i sɛɛti ma.","poem":1},{"lineBreak":true},{"text":"I na so, Alatala birama nɛ i fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"A na i sɛɛti ma yakɔsi, a na i sɛɛti ma abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}