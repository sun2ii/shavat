{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":122,"content":[{"type":"heading","content":["Bɔɲɛsa xa lu Darisalamu"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Biyaasilae xa bɛɛti nde Dawuda naxan sɛbɛ","descriptive":true},{"text":"N bara sɛɛwa n biyaasi booree xa wɔyɛnyi ma, a falafe ra,","poem":1},{"lineBreak":true},{"text":"«Won xɛɛ Alatala xa banxi!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"«Yakɔsi muxu sanyie tixi i tan Darisalamu sode dɛ ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Darisalamu taa na a ra naxan tixi lanyi kui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala xa mixie tema nɛ naa e bɔnsɔɛ ki ma","poem":1},{"lineBreak":true},{"text":"alako e xa Alatala xili matɔxɔ alɔ a yamarixi ki naxɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kiitisa xa kibanyie dɔxɔxi mɛnni nɛ,","poem":1},{"lineBreak":true},{"text":"Dawuda bɔnsɔɛ xa mangɛ kibanyie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wo bɔɲɛsa maxandi Darisalamu bɛ!","poem":1},{"lineBreak":true},{"text":"«Ala xa i xanuntenyie ratanga fe xɔrɔxɔɛ ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ala xa a niya bɔɲɛsa xa lu i xa tɛtɛ kui.","poem":1},{"lineBreak":true},{"text":"Ala xa i ratanga gere ma.»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N ngaxakerenyie nun n xanuntenyie xa fe ra,","poem":1},{"lineBreak":true},{"text":"n a falama nɛ, «Bɔɲɛsa xa lu wo bɛ!","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N i xa hɛɛri fenma nɛ won Marigi Alatala xa hɔrɔmɔlingira xa fe ra.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}