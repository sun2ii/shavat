{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":126,"content":[{"type":"heading","content":["Ala mixi xɔrɛyafe"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Biyaasilae xa bɛɛti nde","descriptive":true},{"text":"Alatala to geelimanie ragbilen Siyoni,","poem":1},{"lineBreak":true},{"text":"a lu nɛ muxu bɛ alɔ xiye.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muxu naxa yele,","poem":1},{"lineBreak":true},{"text":"muxu naxa bɛɛti ba sɛɛwɛ ra.","poem":1},{"lineBreak":true},{"text":"Sie nu a falama nɛ e bore bɛ,","poem":1},{"lineBreak":true},{"text":"«Alatala bara kaabanakoe raba yie bɛ.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Iyo, Alatala bara kaabanakoe raba muxu bɛ,","poem":1},{"lineBreak":true},{"text":"muxu sɛɛwaxi ki fanyi ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala, muxu harige ragbilen muxu ma","poem":1},{"lineBreak":true},{"text":"alɔ ye ragbilenma Negewi bɔxi xure xɔrixie ra ki naxɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mixi naxee xɛ sama yaye ra, e fama nɛ a xabade sɛɛwɛ kui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mixi naxan sigama sansi side, e na wafe,","poem":1},{"lineBreak":true},{"text":"na mixi gbilenma nɛ baloe ra, a sɛɛwaxi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}