{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":129,"content":[{"type":"heading","content":["Ala xunnakeli fife tɔɔrɔmixi ma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Biyaasilae xa bɛɛti nde","descriptive":true},{"text":"Isirayila xa a fala:","poem":1},{"lineBreak":true},{"text":"N gerefae bara n tɔɔrɔ kabi n fonike tɛmui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E bara n tɔɔrɔ a ɲaaxi ra kabi a fɔlɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ e mu nɔ n na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E bara n fari ibɔɔ","poem":1},{"lineBreak":true},{"text":"alɔ xɛ sae bɔxi bɔɔma ki naxɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɔnɔ Alatala tinxin.","poem":1},{"lineBreak":true},{"text":"A bara mixi kobie xa luuti xirixie bolon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ala xa Siyoni xɔnmixie rayaagi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala xa e lu alɔ banxi fari ɲooge,","poem":1},{"lineBreak":true},{"text":"naxan xarama beenun a xa tala,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"naxan mu findima baloe ra xɛ sae bɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dangi mixie naxa duba wo bɛ, a falafe ra,","poem":1},{"lineBreak":true},{"text":"«Ala xa wo baraka.","poem":1},{"lineBreak":true},{"text":"Muxu bara duba wo bɛ Alatala xili ra.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}