{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":13,"content":[{"type":"heading","content":["Han mun tɛmui?"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i nɛɛmuma n ma han mun tɛmui?","poem":1},{"lineBreak":true},{"text":"I i nɔxunma n ma han mun tɛmui?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N bɔɲɛ tɔɔrɔma han mun tɛmui?","poem":1},{"lineBreak":true},{"text":"N sondonyi ɲaxankatama han mun tɛmui?","poem":1},{"lineBreak":true},{"text":"N luma n yaxuie bun ma han mun tɛmui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N Marigi Alatala, a mato, i xa n yaabi.","poem":1},{"lineBreak":true},{"text":"Ti n fanga ra, xa na mu n faxama nɛ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"n yaxuie fa a fala, «N bara nɔ a ra.»","poem":1},{"lineBreak":true},{"text":"N yaxuie ɲɛlɛxinma nɛ n ma birɛ ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɔnɔ n tan bara la i xa hinnɛ ra,","poem":1},{"lineBreak":true},{"text":"n bɔɲɛ bara ɲɛlɛxin i xa kisi xa fe ra.","poem":1},{"lineBreak":true},{"text":"N bɛɛti bama Alatala bɛ a xa hinnɛ nan ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}