{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":130,"content":[{"type":"heading","content":["Alatala Marakisima"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Biyaasilae xa bɛɛti nde","descriptive":true},{"text":"Alatala, n i xilima n ma tɔɔrɛ tilinxi nan kui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N Marigi, i xa i tuli mati n xui ra,","poem":1},{"lineBreak":true},{"text":"i xa n ma maxandi ramɛ kinikini kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Xa i tan Alatala ratuma mixie xa yunubie ma,","poem":1},{"lineBreak":true},{"text":"nde nɔma tide i ya ra sɔnɔn?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɔnɔ i tan yunubie xafarima nɛ.","poem":1},{"lineBreak":true},{"text":"Na kui mixi gaaxuma nɛ i ya ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N xaxili tixi Alatala nan na n nii birin na,","poem":1},{"lineBreak":true},{"text":"n ya tixi a xa masenyi nan na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N xaxili naxan tixi n Marigi ra,","poem":1},{"lineBreak":true},{"text":"na dangi taa makantɛ xa mamɛ ti ra kuye iba ra.","poem":1},{"lineBreak":true},{"text":"A gbo na bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isirayila, i xa i xaxili ti Alatala ra,","poem":1},{"lineBreak":true},{"text":"barima i xa xanunteya na a bɔɲɛ kui,","poem":1},{"lineBreak":true},{"text":"a i xunsare birin fima nɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A tan nan Isirayila xun sarama a xa yunubie birin ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}