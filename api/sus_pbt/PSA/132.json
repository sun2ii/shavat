{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":132,"content":[{"type":"heading","content":["Ala xa laayidi Dawuda nun Darisalamu bɛ"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Biyaasilae xa bɛɛti nde","descriptive":true},{"text":"Alatala, i xa ratu Dawuda ma a nun a xa tɔɔrɛ birin ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"A naxa a rakali Alatala bɛ,","poem":1},{"lineBreak":true},{"text":"a naxa a rakali Yaxuba Marigi Ala Sɛnbɛma bɛ,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"«N mu soma n xɔnyi, n mu n sama,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"n mu n ya maxima,","poem":1},{"lineBreak":true},{"text":"n mu n ya magirama,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"han n sa lingira sɔtɔma Yaxuba Marigi Ala Sɛnbɛma bɛ tɛmui naxɛ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Won nu bara a xa fe mɛ Efarata bɔxi ma.","poem":1},{"lineBreak":true},{"text":"Won naxa a li Yaara xa xɛ ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«Won xɛɛ a xa hɔrɔmɔlingira yire,","poem":1},{"lineBreak":true},{"text":"won xa won xinbi sin a santide ya i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, keli i xa talu i sabatide, i tan nun i xa saatɛ kankira.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I xa sɛrɛxɛdubɛe xa lu xunnakeli kui,","poem":1},{"lineBreak":true},{"text":"i dugutɛgɛe xa e sɛɛwɛ xui rate.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I xa konyi Dawuda xa fe ra,","poem":1},{"lineBreak":true},{"text":"i naxa mɛɛ i xa mangɛ sugandixi ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alatala a kali nɛ Dawuda bɛ,","poem":1},{"lineBreak":true},{"text":"marakali naxan mu kanama,","poem":1},{"lineBreak":true},{"text":"a naxɛ, «N i bɔnsɔɛ nde nan dɔxɔma i xa kibanyi ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xa i xa die sa n ma saatɛ binya,","poem":1},{"lineBreak":true},{"text":"e n ma yaamarie rabatu,","poem":1},{"lineBreak":true},{"text":"e xa die fan luma nɛ i xa kibanyi ma abadan.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Barima Alatala bara Siyoni sugandi,","poem":1},{"lineBreak":true},{"text":"mɛnni nan nafanxi a ma a sabatide ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A naxɛ, «N sabatide nan be ra abadan.","poem":1},{"lineBreak":true},{"text":"N dɔxɔma be n ma kibanyi kui barima be rafanxi n ma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N barakɛ sama nɛ Siyonikae ma,","poem":1},{"lineBreak":true},{"text":"n baloe fi e xa misikiinɛe ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N kisi fima nɛ e xa sɛrɛxɛdubɛe ma,","poem":1},{"lineBreak":true},{"text":"e dugutɛgɛe bɛɛti bama nɛ sɛɛwɛ kui.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"«Be n Dawuda sɛnbɛ rakelima nɛ,","poem":1},{"lineBreak":true},{"text":"n naiyalanyi raminima nɛ n ma Mixi Sugandixi bɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N yaagi dusuma nɛ a yaxuie xun na,","poem":1},{"lineBreak":true},{"text":"kɔnɔ n nɔrɛ dusuma a tan nan xun na.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}