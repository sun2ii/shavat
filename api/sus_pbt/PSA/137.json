{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":137,"content":[{"type":"heading","content":["Isirayila xa konyiya Babilɔn bɔxi ma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Muxu nu dɔxɔxi Babilɔn xuree dɛ ra Siyoni xa fe ratufe ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Muxu nu bara muxu xa kɔrae gbaku wuri bilie kɔn na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muxu yaxuie nu Siyoni bɛɛtie maxɔrin muxu ma,","poem":1},{"lineBreak":true},{"text":"e nu wama bɛɛti sɛɛwaxi nde xɔn.","poem":1},{"lineBreak":true},{"text":"E naxɛ, «Siyoni bɛɛti nde ba muxu bɛ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Muxu nɔma bɛɛti bade Alatala bɛ yi konyiya kui di?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Darisalamu, xa n nɛɛmu i ma,","poem":1},{"lineBreak":true},{"text":"n bɛlɛxɛ naxa nɔ kɔra raberede sɔnɔn,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"n nɛnyi xa kankan n dɛ kui.","poem":1},{"lineBreak":true},{"text":"Na xa raba n na xa a sa li n naxa nɛɛmu Darisalamu ma,","poem":1},{"lineBreak":true},{"text":"xa a xa fe mu findi n ma sɛɛwɛ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatala, i xa ratu Edonkae xa fe raba ma Darisalamu xa nimisɛ lɔxɔɛ.","poem":1},{"lineBreak":true},{"text":"E tan nan nu a falama,","poem":1},{"lineBreak":true},{"text":"«Won xa a kana han won sa a ba a bunyi ra.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Babilɔn, wo xa xunnagore bara gɛ ɲanigede,","poem":1},{"lineBreak":true},{"text":"sɛɛwɛ na a bɛ naxan i sare ragbilenma i ma,","poem":1},{"lineBreak":true},{"text":"i fe ɲaaxi naxan nabaxi muxu ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sɛɛwɛ na mixi bɛ","poem":1},{"lineBreak":true},{"text":"naxan i xa die suxuma,","poem":1},{"lineBreak":true},{"text":"a e butuxun fanye fari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}