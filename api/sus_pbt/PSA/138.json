{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":138,"content":[{"type":"heading","content":["Ala batufe bɔɲɛ birin na"]},{"type":"hebrew_subtitle","content":["Dawuda xa bɛɛti"]},{"type":"verse","number":1,"content":[{"text":"N i batuma nɛ n bɔɲɛ birin na,","poem":1},{"lineBreak":true},{"text":"n i matɔxɔ alae ya i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N na n xinbi sinma nɛ i xa hɔrɔmɔlingira mabiri,","poem":1},{"lineBreak":true},{"text":"n i xili matɔxɔ i xa xanunteya nun dugutɛgɛɲa xa fe ra,","poem":1},{"lineBreak":true},{"text":"barima i bara i xili nun i xa masenyi rate fe birin xun na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N to i xili, i naxa n yaabi,","poem":1},{"lineBreak":true},{"text":"i naxa n nalimaniya i sɛnbɛ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mangɛ naxee birin na yi duniɲa ma,","poem":1},{"lineBreak":true},{"text":"e na i xa masenyi ramɛ,","poem":1},{"lineBreak":true},{"text":"e xa i matɔxɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E xa Alatala xa kira matɔxɔ,","poem":1},{"lineBreak":true},{"text":"barima Alatala xa nɔrɛ gbo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hali Alatala na koore ma,","poem":1},{"lineBreak":true},{"text":"a mɛɛnima nɛ mixi magoroxie ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a makuyama nɛ yɛtɛ igboee ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N na lu tɔɔrɛ kui,","poem":1},{"lineBreak":true},{"text":"i n nakisima nɛ,","poem":1},{"lineBreak":true},{"text":"i n yaxuie xa xɔnɛ xun nakanama nɛ,","poem":1},{"lineBreak":true},{"text":"i fa n nakisi i sɛnbɛ ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala n ma fee rakamalima nɛ.","poem":1},{"lineBreak":true},{"text":"Alatala, dan mu na i xa xanunteya ma.","poem":1},{"lineBreak":true},{"text":"I naxa i xa daalie rabolo.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}