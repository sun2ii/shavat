{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":139,"content":[{"type":"heading","content":["Ala mixie kolonfe"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true},{"text":"Alatala, i n bɔɲɛ birin kolon.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I n dɔxɔ tɛmui kolon, i n keli tɛmui kolon,","poem":1},{"lineBreak":true},{"text":"i n ma maɲɔxunyie birin kolon","poem":1},{"lineBreak":true},{"text":"beenun n xa e maɲɔxun.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I n ɲɛrɛ tɛmui kolon, i n sa tɛmui kolon,","poem":1},{"lineBreak":true},{"text":"i n ma kirae birin kolon.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Beenun wɔyɛnyi xa mini n dɛ i,","poem":1},{"lineBreak":true},{"text":"i tan ɲan bara a birin kolon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I n nabilinma nɛ i xɔnyɛe ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Na fe kolonyi makaabaxi gbo n tan bɛ,","poem":1},{"lineBreak":true},{"text":"a dangi n ma fahaamui ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N sigama minden, n xa n makuya i Xaxili ra?","poem":1},{"lineBreak":true},{"text":"N na n gima minden, n xa n nɔxun i ma?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Xa n sa te koore nɛ, i na mɛnni.","poem":1},{"lineBreak":true},{"text":"Xa n sa goro aligiyama nɛ, n i lima nɛ naa.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Xa n sa keli subaxɛ ma, n baa igiri,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"i bɛlɛxɛ n naɲɛrɛma nɛ, i sɛnbɛ n malima nɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Xa a sa li n fa a fala,","poem":1},{"lineBreak":true},{"text":"«N nɔma n nɔxunde dimi kui naiyalanyi mu na dɛnnaxɛ,»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"i n toma nɛ na dimi kui alɔ n na soge nan bun ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"I tan nan n nii daaxi,","poem":1},{"lineBreak":true},{"text":"i tan nan n nafalaxi n nga tɛɛgɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N i matɔxɔma nɛ barima n daa ki makaaba.","poem":1},{"lineBreak":true},{"text":"I xa wali maniyɛ mu na.","poem":1},{"lineBreak":true},{"text":"N na kolonxi a fanyi ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N fate ki mu nu nɔxunxi i ma","poem":1},{"lineBreak":true},{"text":"a to yailanxi gundo kui.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I yae naxa n to beenun n xa findi a ra.","poem":1},{"lineBreak":true},{"text":"N ma lɔxɔɛe birin nu sɛbɛxi i xa buki kui beenun n xa daali.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ala, i xa maɲɔxunyie gbo, e tilin.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xa n sa e kɔntima nɛ nu, e wuya mɛyɛnyi xɔri bɛ.","poem":1},{"lineBreak":true},{"text":"Na birin kui, n luma i yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ala, yandi, i xa mixi ɲaaxie faxa,","poem":1},{"lineBreak":true},{"text":"i xa faxɛtie makuya n na.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I yaxuie fe ɲaaxi falama i xa fe ra,","poem":1},{"lineBreak":true},{"text":"e i xili kanama.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Alatala, a mu lanma n xa i xɔnmixie xɔn?","poem":1},{"lineBreak":true},{"text":"A mu lanma i matandilae xa raɲaaxu n ma?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"N e xɔnma nɛ.","poem":1},{"lineBreak":true},{"text":"E bara findi n yaxuie ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ala i xa n bɔɲɛ kui mato,","poem":1},{"lineBreak":true},{"text":"i xa n ma kɔntɔfili kolon.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"A mato xa n na kira kobi nde nan xɔn ma,","poem":1},{"lineBreak":true},{"text":"i naxan xɔnxi.","poem":1},{"lineBreak":true},{"text":"Xa a na na ki nɛ, i xa n ti kisi kira nan xɔn ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}