{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":14,"content":[{"type":"heading","content":["Ɲaaxuɲa"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true},{"text":"Xaxilitare a falama a bɔɲɛ kui, «Ala mu na.»","poem":1},{"lineBreak":true},{"text":"A bɔɲɛ bara kana, a ɲaaxuɲa nan tun nabama.","poem":1},{"lineBreak":true},{"text":"Fe fanyi rabae mu na sɔnɔn.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala a ya ragorofe adamadie ma keli ariyanna,","poem":1},{"lineBreak":true},{"text":"a xa a to xa lɔnnila nde na na naxan Ala fenma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɔnɔ birin bara kira bɛɲin, e ɲaaxu.","poem":1},{"lineBreak":true},{"text":"Hali fe fanyi rabama keren mu na sɔnɔn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Maɲɔxunyi fanyi mu na fe kobi rabae bɛ?","poem":1},{"lineBreak":true},{"text":"E na n ma ɲama xa geeni nan tun donfe.","poem":1},{"lineBreak":true},{"text":"E mu Alatala xilima fefe ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɔnɔ e fama sɛrɛnde Ala ya ra,","poem":1},{"lineBreak":true},{"text":"naxan na tinxintɔɛe ya ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wo bara wa setaree waxɔnfe kanafe,","poem":1},{"lineBreak":true},{"text":"kɔnɔ e Kanta Marigi Alatala na na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nde fama kisi ra Isirayila bɛ kelife Siyon?","poem":1},{"lineBreak":true},{"text":"Alatala nan fama a xa ɲama raminide konyiya kui.","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔɛ sɛɛwama nɛ, Isirayila ɲɛlɛxinma nɛ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}