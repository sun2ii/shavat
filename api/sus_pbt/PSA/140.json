{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":140,"content":[{"type":"heading","content":["Mixi kobi alɔ bɔximase"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n natanga mixi ɲaaxie yi ra,","poem":1},{"lineBreak":true},{"text":"naxee wama n tɔɔrɔfe,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"naxee natɛ tongoma e bɔɲɛ ma gere masofe ra lɔxɔ yo lɔxɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E xa wɔyɛnyi xɔnɔ alɔ bɔximase xa xɔnɛ. Ɲɛngi rate.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala, i xa n natanga mixi ɲaaxie bɛlɛxɛ i.","poem":1},{"lineBreak":true},{"text":"I xa n natanga mixi kobie ma naxee wama n nabirafe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I xa n natanga yɛtɛ igboe xa gantanyi nun luutie ma,","poem":1},{"lineBreak":true},{"text":"naxee yɛlɛe italama n ma kirae ra n suxufe ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala, n Marigi Ala nan i ra.","poem":1},{"lineBreak":true},{"text":"I xa i tuli mati n wa xui ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, n nakisima sɛnbɛma,","poem":1},{"lineBreak":true},{"text":"naxan n natangama n gere lɔxɔɛ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"i naxa tin mixi kobie waxɔnfe ra,","poem":1},{"lineBreak":true},{"text":"i naxa na sɔɔnɛya e bɛ alako e xun naxa fa rakeli. Ɲɛngi rate.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N gerefae xa fe ɲaaxi maxirixie xa gbilen e ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tɛ wole xa dɔxɔ e xun na,","poem":1},{"lineBreak":true},{"text":"e xa radin tɛ xɔɔra, e naxa fa mini na kui sɔnɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Fe ɲaaxi rabae naxa sabati yi bɔxi ma,","poem":1},{"lineBreak":true},{"text":"tɔɔrɛ nan tun xa ragiri e ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N a kolon Alatala kiiti fanyi sama nɛ misikiinɛe bɛ,","poem":1},{"lineBreak":true},{"text":"a nɔndi fima setaree ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tinxintɔɛe i xili matɔxɔma nɛ,","poem":1},{"lineBreak":true},{"text":"nɔndilae kisima nɛ i ya i.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}