{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":141,"content":[{"type":"heading","content":["Mixi ɲaaxie xa gantanyi"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti","descriptive":true},{"text":"Alatala, n bara i maxandi, i xulun n malife ra,","poem":1},{"lineBreak":true},{"text":"i xa i tuli mati n ma maxandi ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N ma duba xa te i mabiri alɔ surayi xiri,","poem":1},{"lineBreak":true},{"text":"n ma bɛlɛxɛ ti xa lu alɔ nunmare sɛrɛxɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alatala, n dɛ makanta","poem":1},{"lineBreak":true},{"text":"alako fe ɲaaxi yo naxa mini n dɛ kui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I naxa tin n bɔɲɛ xa siga fe ɲaaxi ma,","poem":1},{"lineBreak":true},{"text":"n naxa lan wali kobi rabae ma n ma geeni xa fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xa tinxintɔɛ n bɔnbɔ, a fan n bɛ,","poem":1},{"lineBreak":true},{"text":"a xa xurui fan alɔ labundɛ naxan sama n fate ma.","poem":1},{"lineBreak":true},{"text":"N mu tondima na fe ra.","poem":1},{"lineBreak":true},{"text":"Kɔnɔ n Ala maxandima a xa mixi ɲaaxi waxɔnfe kana.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E xa kiitisae xa radin gelenyi ra.","poem":1},{"lineBreak":true},{"text":"Mixi ɲaaxie xa a kolon n ma masenyi fan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E xa a fala, «Muxu xɔrie bara yensen aligiyama,","poem":1},{"lineBreak":true},{"text":"alɔ xɛ sa bɔxi buxama ki naxɛ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kɔnɔ n Marigi Alatala, n ya tixi i tan na.","poem":1},{"lineBreak":true},{"text":"N kantari toma i sɛɛti ma, i naxa n nii rabolo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N natanga gantanyie ma e naxee tema n bɛ,","poem":1},{"lineBreak":true},{"text":"n natanga mixi ɲaaxie xa yɛlɛe ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E tan xa suxu nee ra, n tan xa kisi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}