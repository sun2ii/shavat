{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":142,"content":[{"type":"heading","content":["Danxaniyatɔɛ xa kantari"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa lɔnni bɛɛti a to nu na fɔnmɛ ra","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N na n xui ratema Alatala nan ma kinikini xa fe ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N na n ma kɔntɔfili dɛntɛgɛma a tan nan bɛ,","poem":1},{"lineBreak":true},{"text":"n na n ma nimisɛ ya ba a bɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Limaniya na ba n yi ra,","poem":1},{"lineBreak":true},{"text":"i tan n sigade kolon.","poem":1},{"lineBreak":true},{"text":"E bara gantanyi te n bɛ n ma kira ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N nabilinyi mato: mixi yo mu na n bɛ,","poem":1},{"lineBreak":true},{"text":"kantari mu na n bɛ, mɛɛnima yo mu na n bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alatala, i tan nan keren peti na n bɛ sɔnɔn.","poem":1},{"lineBreak":true},{"text":"I keren nan findixi n kantama ra yi duniɲa bɛndɛ fuɲi fari.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I xa n wa xui mɛ, barima n sɛnbɛ birin bara ɲɔn.","poem":1},{"lineBreak":true},{"text":"N ba n kerimae yi ra, barima e sɛnbɛ gbo n bɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N namini geeli kui,","poem":1},{"lineBreak":true},{"text":"alako n xa i xili matɔxɔ.","poem":1},{"lineBreak":true},{"text":"Na kui tinxintɔɛe fama nɛ e malande n yire i xa hinnɛ xa fe ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}