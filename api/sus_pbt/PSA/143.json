{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":143,"content":[{"type":"heading","content":["Ala xa maxandi hagigɛ"]},{"type":"heading","content":["Ala maxandi"]},{"type":"hebrew_subtitle","content":["Dawuda xa bɛɛti"]},{"type":"verse","number":1,"content":[{"text":"Alatala, i tuli mati n ma maxandi ra,","poem":1},{"lineBreak":true},{"text":"i xa kinikini n wa xui ma.","poem":1},{"lineBreak":true},{"text":"I xa n ma duba suxu i xa dugutɛgɛɲa nun i xa tinxinyi xa fe ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I naxa i xa konyi makiiti, barima daali yo mu tinxin i ya i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"N yaxui birama nɛ n fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"a n boronma nɛ bɔxi ma,","poem":1},{"lineBreak":true},{"text":"a n luma nɛ faxɛ niini bun ma alɔ faxamixie.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Na kui n xaxili bara ifu. Limaniya bara ba n yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N natuma nɛ lɔxɔɛ dangixie ma,","poem":1},{"lineBreak":true},{"text":"n na n xaxili rasigama i xa wali birin ma,","poem":1},{"lineBreak":true},{"text":"n na n ɲɔxɔ rasiga i xa daalie ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na n bɛlɛxɛ italama nɛ i bɛ,","poem":1},{"lineBreak":true},{"text":"n nii i fenma nɛ alɔ gbengberenyi ye fenma ki naxɛ. Ɲɛngi rate.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatala, yandi, i xulun n yaabife ra.","poem":1},{"lineBreak":true},{"text":"Limaniya bara gɛ bade n yi ra.","poem":1},{"lineBreak":true},{"text":"I naxa i kobe raso n na,","poem":1},{"lineBreak":true},{"text":"xa na mu n luma nɛ alɔ faxamixie.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuye na iba, i xa i xa dugutɛgɛɲa masen n bɛ,","poem":1},{"lineBreak":true},{"text":"barima n xaxili tixi i tan nan na.","poem":1},{"lineBreak":true},{"text":"N ɲɛrɛ kira masen n bɛ,","poem":1},{"lineBreak":true},{"text":"barima n xaxili tixi i tan nan na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala, n natanga n yaxuie ma,","poem":1},{"lineBreak":true},{"text":"barima n kantari sɔtɔma i niini nan bun ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N xaran i waxɔnfe rabafe ra,","poem":1},{"lineBreak":true},{"text":"barima i tan nan na n Marigi Ala ra.","poem":1},{"lineBreak":true},{"text":"I Xaxili Sɛniyɛnxi xa n ti kira fanyi xɔn ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala, i xa n nakisi i xili xa fe ra,","poem":1},{"lineBreak":true},{"text":"i xa n ba tɔɔrɛ kui i xa tinxinyi xa fe ra,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"i xa n yaxuie dɛ balan i xa dugutɛgɛɲa xa fe ra,","poem":1},{"lineBreak":true},{"text":"i xa n gerefae xun nakana,","poem":1},{"lineBreak":true},{"text":"barima i xa konyi nan lanxi n ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}