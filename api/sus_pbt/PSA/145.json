{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":145,"content":[{"type":"heading","content":["Ala xa kaabanakoe nun xanunteya"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"hebrew_subtitle","content":["Dawuda xa Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"N ma Mangɛ Ala, n i matɔxɔma nɛ, n i xili tantuma nɛ abadan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Lɔxɔ yo lɔxɔ n i matɔxɔma nɛ, n i xili tantuma nɛ abadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Alatala sɛnbɛ gbo, matɔxɔɛ birin na a tan nan bɛ,","poem":1},{"lineBreak":true},{"text":"adamadi mu nɔma sode na birin kui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yi waxati mixie fama nɛ i xa kaabanakoe falade boore waxati mixie bɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E fama nɛ i xa nɔrɛ tofanyi masende.","poem":1},{"lineBreak":true},{"text":"N luma nɛ i xa kaabanakoe maɲɔxun na.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E fama nɛ i sɛnbɛ magaaxuxi xa fe falade.","poem":1},{"lineBreak":true},{"text":"N luma nɛ i xa kaabanakoe masen na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E fama nɛ ɲɛlɛxinde i xa hinnɛ xungbe ra,","poem":1},{"lineBreak":true},{"text":"e i xa tinxinyi masenma nɛ bɛɛti sɛɛwaxi ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala hinnɛ mixi ra, a kinikini,","poem":1},{"lineBreak":true},{"text":"a diɲɛxi, a xa xanunteya gbo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala fe fanyi rabama mixi birin bɛ,","poem":1},{"lineBreak":true},{"text":"a kinikini a xa daali birin ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala, i xa daalie birin i matɔxɔma nɛ,","poem":1},{"lineBreak":true},{"text":"i xa sɛniyɛntɔɛe i tantuma nɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E i xa mangɛya xungbe xa fe masenma nɛ,","poem":1},{"lineBreak":true},{"text":"e i sɛnbɛ xa fe falama nɛ,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"alako mixie xa i xa kaabanakoe kolon, a nun i xa mangɛya nɔrɔxi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I xa mangɛya mu ɲɔnma nɛ, i xa nɔɛ buma nɛ abadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alatala bira mixi malima,","poem":1},{"lineBreak":true},{"text":"a mixi magoroxi xun nakelima nɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Duniɲa birin a xaxili tixi i ra,","poem":1},{"lineBreak":true},{"text":"i tan nan e baloma a waxati.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I tan nan i bɛlɛxɛ rabima,","poem":1},{"lineBreak":true},{"text":"i birin nawasa e hayi na naxan ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala tinxin a xa fe birin kui,","poem":1},{"lineBreak":true},{"text":"a dugutɛgɛxi a xa daalie ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alatala makɔrɛ a maxandilae ra,","poem":1},{"lineBreak":true},{"text":"naxee a maxandima e bɔɲɛ fiixɛ ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A a yaragaaxuie waxɔnfe rabama nɛ,","poem":1},{"lineBreak":true},{"text":"a e xa duba suxuma nɛ, a e rakisi.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Alatala a xanuntenyie makantama nɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a mixi ɲaaxie birin sɔntɔma nɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"N dɛ Alatala matɔxɔma nɛ.","poem":1},{"lineBreak":true},{"text":"Daali xa a xili sɛniyɛnxi matɔxɔ tɛmui birin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}