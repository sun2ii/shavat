{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":146,"content":[{"type":"heading","content":["Ala xa mali gbo adama xa mali bɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo Alatala matɔxɔ!","poem":1},{"lineBreak":true},{"text":"N nii xa Alatala matɔxɔ,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"n xa a matɔxɔ n ma simaya birin na.","poem":1},{"lineBreak":true},{"text":"N n Marigi Alatala matɔxɔma nɛ bɛɛti ra, fanni n na n nii ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wo naxa wo yɛtɛ taxu mixi xungbee ra,","poem":1},{"lineBreak":true},{"text":"barima adamadie na e ra,","poem":1},{"lineBreak":true},{"text":"naxee mu nɔma mixi rakiside.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E nii bama nɛ e fate i, e gbilen bɛndɛ.","poem":1},{"lineBreak":true},{"text":"Na lɔxɔɛ yati, e naxan ɲanigexi, na birin ɲɔnma nɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sɛɛwɛ na mixi bɛ, Yaxuba Marigi Ala naxan malima.","poem":1},{"lineBreak":true},{"text":"Sɛɛwɛ na mixi bɛ, naxan a xaxili tima a Marigi Alatala ra,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala naxan koore nun bɔxi daa,","poem":1},{"lineBreak":true},{"text":"Ala naxan baa nun a kui see birin daa,","poem":1},{"lineBreak":true},{"text":"dugutɛgɛɲa na Ala naxan bɛ abadan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala tɔɔɲɛgɛtɔɛe xun mafalama,","poem":1},{"lineBreak":true},{"text":"a donse fima kaamɛtɔɛe ma,","poem":1},{"lineBreak":true},{"text":"a geelimanie raminima geeli kui,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"a dɔnxuie ya rabɔɔma,","poem":1},{"lineBreak":true},{"text":"a mixi magoroxie xun nakelima,","poem":1},{"lineBreak":true},{"text":"a tinxintɔɛe xanuma,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"a mɛɛnima xɔɲɛe ma,","poem":1},{"lineBreak":true},{"text":"a kiridie nun kaaɲɛ ginɛe bun tima,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a mixi ɲaaxie tan xun nakanama nɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Siyoni, wo Marigi Alatala xa mangɛya mu ɲɔnma abadan.","poem":1},{"lineBreak":true},{"text":"Wo xa Alatala matɔxɔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}