{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":147,"content":[{"type":"heading","content":["Ala sɛnbɛ maniyɛ mu na"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo Alatala matɔxɔ.","poem":1},{"lineBreak":true},{"text":"A lanma Alatala xa matɔxɔ bɛɛti ra.","poem":1},{"lineBreak":true},{"text":"Fe fanyi na a ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Alatala na gbilenfe Darisalamu ti ra,","poem":1},{"lineBreak":true},{"text":"a Isirayila xa mixi rafama nɛ kelife konyiya kui,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"a tɔɔrɔmixie ralimaniyama, a e rayalanma e xa fure kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala tunbuie kɔnti kolon,","poem":1},{"lineBreak":true},{"text":"a e birin xilima e xili ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Won Marigi Alatala sɛnbɛ gbo,","poem":1},{"lineBreak":true},{"text":"dan mu na a xa fahaamui ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala mixi magoroxi bun tima,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a yɛtɛ igboe xa fe kanama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wo xa bɛɛti ba Alatala bɛ tantui ra,","poem":1},{"lineBreak":true},{"text":"wo xa bɛɛti ba Ala bɛ kɔrae xui ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A tan nan nuxui raminima koore ma,","poem":1},{"lineBreak":true},{"text":"a tunɛ rafa bɔxi ma,","poem":1},{"lineBreak":true},{"text":"a sansie rasoli geyae fari.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A xurusee rabaloma,","poem":1},{"lineBreak":true},{"text":"a donse fima xaxa yɔrɛe ma, e na e xui ramini tɛmui naxɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Soe sɛnbɛ mu findixi fefe ra Ala bɛ.","poem":1},{"lineBreak":true},{"text":"Xɛmɛ xa sɛnbɛ mu findixi fefe ra Ala bɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala yaragaaxuiya nan nafanma a ma.","poem":1},{"lineBreak":true},{"text":"Ala wama mixi xɔn naxan xaxili tixi a xa xanunteya ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Darisalamu, i xa Alatala matɔxɔ.","poem":1},{"lineBreak":true},{"text":"Siyoni, i xa Ala tantu,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"barima a tan nan i xa naadɛ makantama,","poem":1},{"lineBreak":true},{"text":"a tan nan barakɛ sama i xa ɲama ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A bɔɲɛsa fima i xa bɔxi ma,","poem":1},{"lineBreak":true},{"text":"a donse fanyi fima i ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Alatala duniɲa yamarima,","poem":1},{"lineBreak":true},{"text":"a a waxɔnfe rayensenma mafuren mafuren.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A balabalanyi ragoroma nɛ alɔ gɛsɛ fute,","poem":1},{"lineBreak":true},{"text":"a na rayensen alɔ tɛ xube.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A ragoro bɔxi ma, nde nɔma tide na xinbeli ya ra?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A na a xui ramini e ma, e xunuma nɛ,","poem":1},{"lineBreak":true},{"text":"a na foye rafa, balabalanyi man findima nɛ ye ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Alatala bara Annabi Yaxuba rakolon a xa masenyi ra,","poem":1},{"lineBreak":true},{"text":"a bara a xa sɛriyɛ nun a xa yaamarie masen Isirayila bɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"A mu na mɔɔli ragirixi si gbɛtɛ yo bɛ.","poem":1},{"lineBreak":true},{"text":"Nee luma Ala xa sɛriyɛe kolontareya nan kui.","poem":1},{"lineBreak":true},{"text":"Wo xa Alatala matɔxɔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}