{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":148,"content":[{"type":"heading","content":["Duniɲa xa Ala matɔxɔ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo Alatala matɔxɔ!","poem":1},{"lineBreak":true},{"text":"Wo Alatala matɔxɔ kelife koore ma.","poem":1},{"lineBreak":true},{"text":"Wo a matɔxɔ yire itexi kui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala xa malekɛe xa a matɔxɔ,","poem":1},{"lineBreak":true},{"text":"a xa galie xa a matɔxɔ koore ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Soge nun kike xa a matɔxɔ,","poem":1},{"lineBreak":true},{"text":"tunbui dɛxɛxie fan xa a matɔxɔ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Koore xa a matɔxɔ,","poem":1},{"lineBreak":true},{"text":"a nun ye naxan toma naa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E birin xa Alatala xili matɔxɔ,","poem":1},{"lineBreak":true},{"text":"barima a yamari nan fi, e naxa daa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A naxa e ti e tide, e xa lu naa abadan.","poem":1},{"lineBreak":true},{"text":"A naxa na sɛriyɛ sa, naxan mu kanama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wo Alatala matɔxɔ kelife bɔxi ma.","poem":1},{"lineBreak":true},{"text":"Baa nun nimase birin naxee na baa tilinyi kui,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"seyamakɔnyi, balabalanyi, kunda, nuxuie,","poem":1},{"lineBreak":true},{"text":"nun foye xungbe naxan a xa yaamari ratinmɛma,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"geyae nun tentenyie, wuri bogilae nun sɛdiri bilie,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"wulai subee nun xurusee, bubusee nun xɔnie,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"duniɲa mangɛe nun sie,","poem":1},{"lineBreak":true},{"text":"mangɛdie nun duniɲa kuntigie,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"fonikee nun ginɛdimɛdie, dimɛe nun forie,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"e birin xa Alatala xili matɔxɔ,","poem":1},{"lineBreak":true},{"text":"barima a xili gbansan nan itexi,","poem":1},{"lineBreak":true},{"text":"a nɔrɛ dangi koore nun bɔxi ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"A bara mangɛ sɛnbɛma rakeli a xa ɲama xun na,","poem":1},{"lineBreak":true},{"text":"a xa sɛniyɛntɔɛe naxan matɔxɔma,","poem":1},{"lineBreak":true},{"text":"sɛniyɛntɔɛe naxan findixi Isirayila a xa ɲama xanuxi ra.","poem":1},{"lineBreak":true},{"text":"Wo Alatala matɔxɔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}