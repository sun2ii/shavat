{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":149,"content":[{"type":"heading","content":["Bɛɛti nɛɛnɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo Alatala matɔxɔ!","poem":1},{"lineBreak":true},{"text":"Wo bɛɛti nɛɛnɛ ba a bɛ,","poem":1},{"lineBreak":true},{"text":"wo matɔxɔɛ raba a batulae tagi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isirayila xa sɛɛwa a daali Marigi ra.","poem":1},{"lineBreak":true},{"text":"Siyoni ɲama xa sɛɛwa e xa Mangɛ ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E xa a xili matɔxɔ fare boron yi ra,","poem":1},{"lineBreak":true},{"text":"e xa bɛɛtie ba maxase nun kɔra xui ra,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"barima Alatala sɛɛwaxi a xa ɲama ra,","poem":1},{"lineBreak":true},{"text":"a kisi fima nɛ yɛtɛ magoroe ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A xa sɛniyɛntɔɛe xa sɛɛwa yi binyɛ ra,","poem":1},{"lineBreak":true},{"text":"e xa e sɛɛwɛ xui ite","poem":1},{"lineBreak":true},{"text":"hali e xa sadee ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala matɔxɔɛ xa lu e dɛ i.","poem":1},{"lineBreak":true},{"text":"Na luxi alɔ santidɛgɛma xaaɲɛxi e bɛlɛxɛ kui,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"e naxan nawalima e gbe ɲɔxɔfe ra,","poem":1},{"lineBreak":true},{"text":"si ɲaaxie ɲaxankatafe ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E e yaxuie xa mangɛe sama nɛ yɔlɔnxɔnyie ra,","poem":1},{"lineBreak":true},{"text":"e e xa yareratie xirima nɛ a xɔrɔxɔɛ ra,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"na fa findi e xa kobiɲa sare ra.","poem":1},{"lineBreak":true},{"text":"Xunnakeli belebele nan na ki Ala xa sɛniyɛntɔɛe bɛ.","poem":1},{"lineBreak":true},{"text":"Wo xa Alatala matɔxɔ!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}