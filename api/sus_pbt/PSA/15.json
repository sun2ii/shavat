{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":15,"content":[{"type":"heading","content":["Sali mixi"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti","descriptive":true},{"text":"Alatala, nde nɔma lude i xa salide kui?","poem":1},{"lineBreak":true},{"text":"Nde nɔma sabatide i xa geya sɛniyɛnxi fari?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mixi naxan ɲɛrɛma tinxinyi kira xɔn ma,","poem":1},{"lineBreak":true},{"text":"naxan fe fanyi rabama,","poem":1},{"lineBreak":true},{"text":"naxan nɔndi falama a bɔɲɛ fiixɛ ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A mu mixi mafalama,","poem":1},{"lineBreak":true},{"text":"a mu fe ɲaaxi rabama a boore ra,","poem":1},{"lineBreak":true},{"text":"a man mu a rayaagima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A a makuyama mixi ra naxan mu rafan Ala ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a mixi binyama naxan gaaxuma Ala ya ra.","poem":1},{"lineBreak":true},{"text":"Hali a tɔɔrɔma, a mu a xa marakali masarama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A mu mixi donima kɔbiri ra alako a xa geeni sɔtɔ.","poem":1},{"lineBreak":true},{"text":"A mu kɔbiri rasuxuma a xa wule sa mixi xun ma.","poem":1},{"lineBreak":true},{"text":"Yi mixi mɔɔli mu dinkonma abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}