{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":16,"content":[{"type":"heading","content":["Ala xanuntenyi"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa suuki","descriptive":true},{"text":"Ala, i xa n kanta!","poem":1},{"lineBreak":true},{"text":"N ma kantari na i yi ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala, n Marigi nan i ra.","poem":1},{"lineBreak":true},{"text":"N ma fe fanyi birin na i tan nan yi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yi bɔxi sɛniyɛntɔɛe rafan n ma.","poem":1},{"lineBreak":true},{"text":"Mixi xungbe nan e ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuye batuie xa tɔɔrɛ gboma nɛ.","poem":1},{"lineBreak":true},{"text":"Kɔnɔ n tan mu sɛrɛxɛ wuli daaxi bama kuyee bɛ.","poem":1},{"lineBreak":true},{"text":"N dɛ mu e xili falama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sese mu na n yi ra, fo Alatala.","poem":1},{"lineBreak":true},{"text":"N waxɔnfe birin, Ala nan a ra.","poem":1},{"lineBreak":true},{"text":"N ma duniɲɛigiri birin na Ala yi ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala naxan soxi n yi ra na fan n bɛ,","poem":1},{"lineBreak":true},{"text":"n bara ɲɛlɛxin a ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bara Alatala tantu, a marasi fima n ma.","poem":1},{"lineBreak":true},{"text":"Hali kɔɛ ra, n xaxili sɔtɔma nɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Lɔxɔ yo lɔxɔ n xaxili tixi Alatala ra.","poem":1},{"lineBreak":true},{"text":"Xa a na n sɛɛti ma,","poem":1},{"lineBreak":true},{"text":"n mu birama.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N bɔɲɛ ɲɛlɛxinma nɛ,","poem":1},{"lineBreak":true},{"text":"n xaxili sɛɛwama nɛ,","poem":1},{"lineBreak":true},{"text":"n fate fan malabuma nɛ bɔɲɛsa kui,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"barima i mu n nii rabɛɲinma aligiyama.","poem":1},{"lineBreak":true},{"text":"I mu i xanuntenyi luma gaburi kui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I simaya kira masenma n bɛ.","poem":1},{"lineBreak":true},{"text":"Ɲɛlɛxinyi gbegbe na i yire.","poem":1},{"lineBreak":true},{"text":"Fe fanyi mu ɲɔnma i yire fanyi ma abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}