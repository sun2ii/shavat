{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":17,"content":[{"type":"heading","content":["N ma kiiti bolon"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa Ala maxandi","descriptive":true},{"text":"Alatala, n ma maxandi ramɛ tinxinyi xa fe ra.","poem":1},{"lineBreak":true},{"text":"I tuli mati n wa xui ra.","poem":1},{"lineBreak":true},{"text":"I tuli mati n ma maxandi xui ra wule mu na naxan kui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I xa n ma kiiti bolon,","poem":1},{"lineBreak":true},{"text":"barima naxan tinxin, i na kolon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I na n bɔɲɛ mato kɔɛ ra,","poem":1},{"lineBreak":true},{"text":"i na n ma duniɲɛigiri mato yanyi ra,","poem":1},{"lineBreak":true},{"text":"i mu tantanyi yo toma n na.","poem":1},{"lineBreak":true},{"text":"N mu tinma wɔyɛn ɲaaxi xa mini n dɛ i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mixi gbɛtɛe fe ɲaaxi rabama,","poem":1},{"lineBreak":true},{"text":"kɔnɔ n tan bara i xa yaamari suxu.","poem":1},{"lineBreak":true},{"text":"N mu birama suutee xa kirae fɔxɔ ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N birama i tan nan fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"n mu na kira bɛɲinma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala, n i xilima nɛ, barima i yaabi fima mixi ma.","poem":1},{"lineBreak":true},{"text":"Yandi, i xa i tuli mati n ma maxandi ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I xa hinnɛ muxu ra,","poem":1},{"lineBreak":true},{"text":"i tan naxan mixie rakisima e yaxuie ma,","poem":1},{"lineBreak":true},{"text":"naxee yigiya fenma i ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɛɛni n ma alɔ i ya firinyie.","poem":1},{"lineBreak":true},{"text":"N nɔxun alɔ tɔxɛyɔrɛ","poem":1},{"lineBreak":true},{"text":"naxan a nɔxunma a nga gabutenyie bun ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Na na a toma, mixi ɲaaxi naxee n nabilinxi,","poem":1},{"lineBreak":true},{"text":"e mu nɔma n na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yɛtɛ igboe nan e ra, e dɛ igbo.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E bara fa n fɔxɔ ra yakɔsi,","poem":1},{"lineBreak":true},{"text":"e n nabilin, e alako e xa n faxa.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E luxi alɔ yɛtɛ naxan sube fenma,","poem":1},{"lineBreak":true},{"text":"alɔ yɛtɛ kaamɛxie naxee gbataxi sube faxade.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala, keli! N yaxuie gere, i xa nɔ e ra.","poem":1},{"lineBreak":true},{"text":"N natanga mixi ɲaaxie ma i xa santidɛgɛma ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N natanga na duniɲa mixi mɔɔlie ma,","poem":1},{"lineBreak":true},{"text":"naxee e masundi sɔtɔma yi duniɲɛigiri gbansan kui.","poem":1},{"lineBreak":true},{"text":"E raluga na masundi ra, i naxan nagataxi e bɛ.","poem":1},{"lineBreak":true},{"text":"E xa die fan xa wasa na ra,","poem":1},{"lineBreak":true},{"text":"a dɔnxɔɛ xa lu e xa mamadie bɛ!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kɔnɔ n tan fama nɛ i yatagi tode tinxinyi saabui ra.","poem":1},{"lineBreak":true},{"text":"N na xunu, n wasama nɛ i yatagi ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}