{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":19,"content":[{"type":"heading","content":["Ala xa nɔrɛ nun sɛriyɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Koore Ala xa nɔrɛ masenma.","poem":1},{"lineBreak":true},{"text":"Koore walaxɛ Ala xa wali masenma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yanyi lɔnni masenma lɔxɔ yo lɔxɔ.","poem":1},{"lineBreak":true},{"text":"Dimi xaxili masenma kɔɛ yo kɔɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xui yati yati mu a ra,","poem":1},{"lineBreak":true},{"text":"wɔyɛnyi fan mu a ra.","poem":1},{"lineBreak":true},{"text":"Tuli mu nɔma e xui mɛde.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E fɔxi toma duniɲa birin ma.","poem":1},{"lineBreak":true},{"text":"E fɔxi yire makuye birin lima,","poem":1},{"lineBreak":true},{"text":"han soge sa sama kankira naxan kui.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Soge minima nɛ alɔ xɛmɛ naxan baxi ginɛ dɔxɔde,","poem":1},{"lineBreak":true},{"text":"a fa mini a xa konkoe kui,","poem":1},{"lineBreak":true},{"text":"alɔ mixi xungbe naxan ɲɛrɛma a yɛtɛ xa kira xɔn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A ɲɛrɛ fɔlɔma sogetede, a sa ɲɔn sogegorode.","poem":1},{"lineBreak":true},{"text":"Sese mu nɔma a wuyenyi bade.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala xa sɛriyɛ, sɛriyɛ fanyi na a ra.","poem":1},{"lineBreak":true},{"text":"A sɛnbɛ fima mixi ma.","poem":1},{"lineBreak":true},{"text":"Alatala xa nɔndi, nɔndi yati na a ra.","poem":1},{"lineBreak":true},{"text":"A lɔnnitare findima lɔnnila ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala xa nɔɛ, nɔɛ tinxinxi na a ra.","poem":1},{"lineBreak":true},{"text":"A mixi bɔɲɛ raɲɛlɛxinma nɛ.","poem":1},{"lineBreak":true},{"text":"Alatala xa masenyi, masenyi tinsexi na a ra.","poem":1},{"lineBreak":true},{"text":"A mixi xaxili ya rabima nɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala xa yaragaaxui, fe sɛniyɛnxi na a ra.","poem":1},{"lineBreak":true},{"text":"A mu ɲɔnma abadan.","poem":1},{"lineBreak":true},{"text":"Alatala xa yaamari, yaamari fanyi na a ra.","poem":1},{"lineBreak":true},{"text":"A birin tinxin.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala xa yaamari, a fan xɛɛma bɛ,","poem":1},{"lineBreak":true},{"text":"a fan dangi xɛɛma fanyi birin na.","poem":1},{"lineBreak":true},{"text":"Ala xa yaamari, a ɲɔxun kumi bɛ,","poem":1},{"lineBreak":true},{"text":"a ɲɔxun dangi kumi fanyi birin na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"I xa konyi xaxili sɔtɔma nɛ i xa sɛriyɛ kui.","poem":1},{"lineBreak":true},{"text":"A geeni gbegbe toma nɛ naa.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nde nɔma a yɛtɛ kan yuge ɲaaxie birin kolonde?","poem":1},{"lineBreak":true},{"text":"I xa n ma yunubi nɔxunxi xafari n mu naxan kolon.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I xa n ma yunubi makɛnɛnxi makuya n na.","poem":1},{"lineBreak":true},{"text":"A naxa n suxu sɛnbɛ ra.","poem":1},{"lineBreak":true},{"text":"Na tɛmui n fama findide mixi tinxinxi ra,","poem":1},{"lineBreak":true},{"text":"naxan mu yunubi ɲaaxi rabama.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wɔyɛnyi naxan kelima n dɛ i,","poem":1},{"lineBreak":true},{"text":"a nun wɔyɛnyi naxan kelima n bɔɲɛ ma,","poem":1},{"lineBreak":true},{"text":"Ala xa na tongo n bɛ ɲɛlɛxinyi ra.","poem":1},{"lineBreak":true},{"text":"Alatala, n kantama nan i ra, i bara n xunsara.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":15}