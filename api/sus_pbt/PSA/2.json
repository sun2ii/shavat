{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":2,"content":[{"type":"heading","content":["Ala xa Mixi Sugandixi"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"verse","number":1,"content":[{"text":"Munfe ra sie bɔɲɛ texi fufafu?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Duniɲa mangɛe bara keli,","poem":1},{"lineBreak":true},{"text":"xunmatie bara ti Alatala","poem":1},{"lineBreak":true},{"text":"nun a xa mixi sugandixi kanke.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Na duniɲa mangɛe naxɛ,","poem":1},{"lineBreak":true},{"text":"«Won xa won ba e yi ra,","poem":1},{"lineBreak":true},{"text":"Won xa mini e xa nɔɛ bun ma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Marigi naxan na koore ma,","poem":1},{"lineBreak":true},{"text":"na na yelefe e ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A xɔnɔma e ma,","poem":1},{"lineBreak":true},{"text":"a e magaaxuma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala xa masenyi nan ya,","poem":1},{"lineBreak":true},{"text":"«N tan nan mangɛ sugandi,","poem":1},{"lineBreak":true},{"text":"n a dɔxɔ Siyoni geya fari, n ma yire sɛniyɛnxi.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Na mangɛ sugandixi xa masenyi nan ya,","poem":1},{"lineBreak":true},{"text":"«N xa Alatala xa natɛ masen wo bɛ.","poem":1},{"lineBreak":true},{"text":"Ala bara a masen n bɛ, ‹To, i bara findi n ma di ra.","poem":1},{"lineBreak":true},{"text":"N tan bara findi i baba ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I xa n maxandi n xa si birin fi i ma,","poem":1},{"lineBreak":true},{"text":"e xa findi kɛ ra i bɛ.","poem":1},{"lineBreak":true},{"text":"Duniɲa birin xa findi i gbe ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I e yamarima sawuri ra,","poem":1},{"lineBreak":true},{"text":"i e kanama alɔ wure fɛɲɛ bɔɔma ki naxɛ,","poem":1},{"lineBreak":true},{"text":"a kebelae yensen yɛ.›»","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yakɔsi wo tan mangɛe, wo xaxili sɔtɔ.","poem":1},{"lineBreak":true},{"text":"Kuntigie, wo bira nɔndi fɔxɔ ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wo Alatala batu gaaxui ra,","poem":1},{"lineBreak":true},{"text":"wo sɛɛwa a xa fe ra,","poem":1},{"lineBreak":true},{"text":"wo gaaxu a ya ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Wo wo xun sin a xa mixi sugandixi bɛ.","poem":1},{"lineBreak":true},{"text":"Xa na mu a ra, a wo halakima nɛ wo xa duniɲɛigiri kui.","poem":1},{"lineBreak":true},{"text":"Ala xa xɔnɛ dɛxɛma alɔ tɛ nu so fiili ra.","poem":1},{"lineBreak":true},{"text":"Ɲɛlɛxinyi na adama nan bɛ,","poem":1},{"lineBreak":true},{"text":"naxan kantari fenma Ala ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}