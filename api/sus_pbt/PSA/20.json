{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":20,"content":[{"type":"heading","content":["Ala xa mangɛ mali"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala xa i yaabi i xa tɔɔrɛ kui.","poem":1},{"lineBreak":true},{"text":"Yaxuba Marigi Ala xa i ratanga.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala xa i mali kelife a xa yire sɛniyɛnxi,","poem":1},{"lineBreak":true},{"text":"a xa i mali kelife Siyon geya fari.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala xa i xa sɛrɛxɛ birin suxu,","poem":1},{"lineBreak":true},{"text":"a xa ɲɛlɛxin i xa sɛrɛxɛ gan daaxie ra. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ala xa i waxɔnfe fi i ma,","poem":1},{"lineBreak":true},{"text":"a xa i xa wali sɔɔnɛya i bɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Won won xui itema ɲɛlɛxinyi kui.","poem":1},{"lineBreak":true},{"text":"Won won ma tɔnxuma itema won Marigi Ala xili ra.","poem":1},{"lineBreak":true},{"text":"Alatala xa i xa maxandi birin nasuxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N a kolon a Alatala a xa mixi sugandixi rakisima nɛ.","poem":1},{"lineBreak":true},{"text":"A a yaabima nɛ a sɛnbɛ ra kelife ra a xa yire sɛniyɛnxi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nde lama a xa sɔɔri ragise ra,","poem":1},{"lineBreak":true},{"text":"nde lama a xa soee ra,","poem":1},{"lineBreak":true},{"text":"kɔnɔ won tan laxi won Marigi Alatala xili nan na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Soee tan birama nɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ won tan tixi tun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala xa mangɛ rakisi,","poem":1},{"lineBreak":true},{"text":"a xa won ma maxandi suxu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}