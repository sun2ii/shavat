{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":21,"content":[{"type":"heading","content":["Mangɛ barakatɔɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, mangɛ bara sɛɛwa i sɛnbɛ ra.","poem":1},{"lineBreak":true},{"text":"A xa ɲɛlɛxinyi gbo barima i bara a rakisi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I bara a waxɔnfe raba,","poem":1},{"lineBreak":true},{"text":"i bara a xa dubɛ suxu. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I fama barakɛ ra a bɛ,","poem":1},{"lineBreak":true},{"text":"i tɔnxuma mangɛ daaxi dɔxɔma a xun ma,","poem":1},{"lineBreak":true},{"text":"a yailanxi xɛɛma ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A bara i maxandi a xa simaya xa fe ra.","poem":1},{"lineBreak":true},{"text":"I bara na maxandi suxu,","poem":1},{"lineBreak":true},{"text":"a xa simaya xɔn naxa kuya han.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I to a rakisi, a xa binyɛ naxa gbo.","poem":1},{"lineBreak":true},{"text":"I naxa xunnakeli nun binyɛ fi a ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I naxa a findi barakatɔɛ xungbe ra.","poem":1},{"lineBreak":true},{"text":"I naxa a rasɛɛwa i ya i.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mangɛ lama Alatala nan na.","poem":1},{"lineBreak":true},{"text":"A mu birama Ala Xili Xungbe xa hinnɛ saabui ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I fama i yaxui birin suxude.","poem":1},{"lineBreak":true},{"text":"I fama nɔde i xɔnmixie ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I na fa, i e ɲɔnma nɛ,","poem":1},{"lineBreak":true},{"text":"alɔ tɛ belebele wuri ganma ki naxɛ.","poem":1},{"lineBreak":true},{"text":"Alatala xɔnɔma e ma han tɛ e gan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I bɔnsɔɛe bama nɛ duniɲa ma, i adamadie raɲɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E bara wa fe ɲaaxi rabafe i ra.","poem":1},{"lineBreak":true},{"text":"E bara kata han,","poem":1},{"lineBreak":true},{"text":"kɔnɔ na mu findixi sɔɔnɛya yo ra e bɛ,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"barima i tan nan fama e ragide i xa xali ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala, i xa i sɛnbɛ masen e bɛ.","poem":1},{"lineBreak":true},{"text":"Muxu wama bɛɛti bafe i ya xɔri,","poem":1},{"lineBreak":true},{"text":"muxu xa i matɔxɔ i sɛnbɛ xa fe ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}