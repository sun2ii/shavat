"poem":1},{"lineBreak":true},{"text":"barima i na n sɛɛti ma.","poem":1},{"lineBreak":true},{"text":"I n kantama, i n xun tima yire fanyi ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I donse rafalama n bɛ n yaxuie ya xɔri.","poem":1},{"lineBreak":true},{"text":"I se xiri ɲɔxunmɛ sama n ma.","poem":1},{"lineBreak":true},{"text":"I n ma pɔɔti rafema minse ra a fanyi ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hɛɛri nun hinnɛnteya birama n fɔxɔ ra n ma duniɲɛigiri kui.","poem":1},{"lineBreak":true},{"text":"N luma nɛ Ala xa hɔrɔmɔlingira kui lɔxɔ yo lɔxɔ,","poem":1},{"lineBreak":true},{"text":"han n ma duniɲɛigiri ɲɔn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}