{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":24,"content":[{"type":"heading","content":["Nde soma Ala xa hɔrɔmɔbanxi kui?"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"hebrew_subtitle","content":["Dawuda xa bɛɛti"]},{"type":"verse","number":1,"content":[{"text":"Alatala nan gbe na bɔxi nun a isee birin na,","poem":1},{"lineBreak":true},{"text":"duniɲa nun adamadi birin.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"A tan nan bɔxi dɔxɔxi baae nun xuree tagi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nde nɔma tede Alatala xa geya fari?","poem":1},{"lineBreak":true},{"text":"Nde nɔma sode a xa hɔrɔmɔbanxi kui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Naxan xa wali fan,","poem":1},{"lineBreak":true},{"text":"naxan bɔɲɛ sɛniyɛn,","poem":1},{"lineBreak":true},{"text":"naxan mu birama fe fufafu fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"naxan mu wule falama,","poem":1},{"lineBreak":true},{"text":"na kanyi nan soma Ala xa hɔrɔmɔbanxi kui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala barakɛ sama a ma,","poem":1},{"lineBreak":true},{"text":"a rakisima Ala a sare ragbilenma a ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yi mixi mɔɔli nan Ala fenma.","poem":1},{"lineBreak":true},{"text":"Yaxuba xa mixie wama Ala kolonfe. Ɲɛngi rate.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tɛtɛ naadɛe xa rabi, hɔrɔmɔbanxi naadɛ forie fan xa rabi.","poem":1},{"lineBreak":true},{"text":"Nɔrɛ Kanyi na sofe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Nde na yi Nɔrɛ Kanyi ra?","poem":1},{"lineBreak":true},{"text":"Alatala sɛnbɛma nan a ra, Alatala, naxan sɛnbɛ gbo gere kui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɛtɛ naadɛe xa rabi, hɔrɔmɔbanxi naadɛ forie fan xa rabi.","poem":1},{"lineBreak":true},{"text":"Nɔrɛ Kanyi na sofe.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nde na yi Nɔrɛ Kanyi ra?","poem":1},{"lineBreak":true},{"text":"Mangɛ Alatala nan Nɔrɛ Kanyi ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}