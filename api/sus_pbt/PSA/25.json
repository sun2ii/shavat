{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":25,"content":[{"type":"heading","content":["Ala, hinnɛ n na"]},{"type":"heading","content":["Ala maxandi"]},{"type":"hebrew_subtitle","content":["Dawuda gbe"]},{"type":"verse","number":1,"content":[{"text":"N xaxili tixi i tan Alatala nan na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N Marigi Ala, n bara n yɛtɛ taxu i ra","poem":1},{"lineBreak":true},{"text":"alako yaagi naxa n sɔtɔ,","poem":1},{"lineBreak":true},{"text":"alako n yaxuie naxa n mayele.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Naxan yo la i ra, na kanyi mu yaagi sɔtɔma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ yanfante tan, yaagi sɔtɔma nɛ a fanyi ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alatala, i xa kira masen n bɛ,","poem":1},{"lineBreak":true},{"text":"n xaran i xa kira ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N naɲɛrɛ i xa nɔndi kira xɔn,","poem":1},{"lineBreak":true},{"text":"i man xa n matinkan i xa kira ra,","poem":1},{"lineBreak":true},{"text":"barima i tan Ala nan n nakisima.","poem":1},{"lineBreak":true},{"text":"N xaxili tixi i ra lɔxɔɛ birin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala, i maɲɔxun i xa marafanyi nun i xa fonisireya ma,","poem":1},{"lineBreak":true},{"text":"barima e na na kabi duniɲa fɔlɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I naxa i maɲɔxun n ma yunubi ma,","poem":1},{"lineBreak":true},{"text":"n naxan nabaxi n ma sɛgɛtalaya kui,","poem":1},{"lineBreak":true},{"text":"n i raxɔnɔxi tɛmui naxɛ.","poem":1},{"lineBreak":true},{"text":"Alatala, i maɲɔxun n ma i xa fonisireya kui,","poem":1},{"lineBreak":true},{"text":"barima i fan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala fan, a tinxin.","poem":1},{"lineBreak":true},{"text":"Na nan a toxi a kira masenma yunubitɔɛe bɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A tan nan mixi magoroxi raɲɛrɛma tinxinyi kui.","poem":1},{"lineBreak":true},{"text":"A e matinkanma a xa kira ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala xa fonisireya nun tinxinyi na mixie bɛ,","poem":1},{"lineBreak":true},{"text":"naxee a xa saatɛ nun a xa yaamari mabanbanma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala, n ma yunubie xafari i xili xa fe ra,","poem":1},{"lineBreak":true},{"text":"barima e mu xurun.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nde gaaxuma Alatala ya ra?","poem":1},{"lineBreak":true},{"text":"Alatala kira masenma na kanyi bɛ","poem":1},{"lineBreak":true},{"text":"a lanma a xa ɲɛrɛ naxan ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A aligiyama lima nɛ sɛɛwɛ kui.","poem":1},{"lineBreak":true},{"text":"A bɔnsɔɛ fan fama sabatide yi bɔxi ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala a xa gundo masenma mixie bɛ,","poem":1},{"lineBreak":true},{"text":"naxee gaaxu a ya ra.","poem":1},{"lineBreak":true},{"text":"A a xa saatɛ masenma nɛ e bɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N xaxili tixi Alatala ra lɔxɔɛ birin","poem":1},{"lineBreak":true},{"text":"barima a tan nan n natangama fe ɲaaxi ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Alatala, yandi, hinnɛ n na,","poem":1},{"lineBreak":true},{"text":"barima tɔɔrɔmixi nan n na,","poem":1},{"lineBreak":true},{"text":"n malima fan mu na.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N bɔɲɛ bara tɔɔrɔ. N namini na tɔɔrɛ kui.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"I ya rasiga n ma sunnunyi nun n ma ɲaxankatɛ ma,","poem":1},{"lineBreak":true},{"text":"i xa diɲɛ n ma yunubi birin ma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I xa a mato n yaxuie wuyaxi ki naxɛ.","poem":1},{"lineBreak":true},{"text":"E n xɔnxi a ɲaaxi ra.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N nii makanta, i xa n natanga,","poem":1},{"lineBreak":true},{"text":"alako yaagi naxa n sɔtɔ i xa niini bun ma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Sɛriyɛ nun tinxinyi xa n kanta","poem":1},{"lineBreak":true},{"text":"barima n xaxili tixi i tan na.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ala, Isirayila xunsara a xa tɔɔrɛ birin ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}