{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":26,"content":[{"type":"heading","content":["Tinxintɔɛ ɲɛrɛ ki"]},{"type":"heading","content":["Ala maxandi"]},{"type":"hebrew_subtitle","content":["Dawuda gbe"]},{"type":"verse","number":1,"content":[{"text":"Alatala, i xa n ma kiiti sa, barima n ɲɛrɛ ki tinxin.","poem":1},{"lineBreak":true},{"text":"N bara n yɛtɛ taxu i ra, n mu birama.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala, n bɔɲɛ mato, n sondonyi makiiti,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"barima n laxi i xa hinnɛ ra,","poem":1},{"lineBreak":true},{"text":"n man n ɲɛrɛma i xa sɛriyɛ ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N mu luma wule falɛe ya ma,","poem":1},{"lineBreak":true},{"text":"n mu ɲɛrɛma filankafuie tagi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe kobi rabae mu rafan n ma,","poem":1},{"lineBreak":true},{"text":"n tan nun mixi ɲaaxie mu luma yire keren.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala, n nan n ɲɛrɛ ki rasɛniyɛn,","poem":1},{"lineBreak":true},{"text":"n man luma nɛ i xa sɛrɛxɛbade.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N tantui bɛɛti bama,","poem":1},{"lineBreak":true},{"text":"n i xa kaabanakoe masenma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, i xa hɔrɔmɔbanxi rafan n ma, i xa nɔrɛ na dɛnnaxɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"I naxa n nii ba alɔ yunubitɔɛe nun faxatie.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E fe ɲaaxie rabama, e kɔbiri rasuxuma tinxintareya ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɔnɔ n tan luma tinxinyi kui.","poem":1},{"lineBreak":true},{"text":"N xun sara, i xa diɲɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N ɲɛrɛ ki tinxin.","poem":1},{"lineBreak":true},{"text":"N Alatala tantuma nɛ malanyie kui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}