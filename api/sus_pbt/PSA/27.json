{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":27,"content":[{"type":"heading","content":["I xaxili ti Alatala ra"]},{"type":"heading","content":["Ala maxandi"]},{"type":"hebrew_subtitle","content":["Dawuda gbe"]},{"type":"verse","number":1,"content":[{"text":"Alatala nan na n ma naiyalanyi ra.","poem":1},{"lineBreak":true},{"text":"N nakisima na a ra.","poem":1},{"lineBreak":true},{"text":"N lan n xa gaaxu nde ya ra?","poem":1},{"lineBreak":true},{"text":"N ma duniɲɛigiri na Alatala nan ma niini bun ma.","poem":1},{"lineBreak":true},{"text":"N lan n xa gaaxu nde ya ra?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N gerefae nun n yaxui naxee fe ɲaaxi rabama,","poem":1},{"lineBreak":true},{"text":"e na fa n nahalakide,","poem":1},{"lineBreak":true},{"text":"e tan nan birama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Hali sɔɔri gaali n nabilin,","poem":1},{"lineBreak":true},{"text":"n bɔɲɛ mu sɛrɛnma.","poem":1},{"lineBreak":true},{"text":"Hali sɔɔri gaali fa n gerede,","poem":1},{"lineBreak":true},{"text":"n bɔɲɛ suusama nɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N fe keren nan maxɔrin Alatala ma,","poem":1},{"lineBreak":true},{"text":"n na na nan fenfe.","poem":1},{"lineBreak":true},{"text":"N wama lufe Alatala xa hɔrɔmɔbanxi nan kui","poem":1},{"lineBreak":true},{"text":"n ma duniɲɛigiri birin,","poem":1},{"lineBreak":true},{"text":"alako n xaxili xa ti Alatala xa fe fanyi ra,","poem":1},{"lineBreak":true},{"text":"n man xa nɔ a xa hɔrɔmɔbanxi matode.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A n natangama nɛ tɔɔrɛ ma hɔrɔmɔbanxi kui.","poem":1},{"lineBreak":true},{"text":"A n nɔxunma nɛ na niini bun ma.","poem":1},{"lineBreak":true},{"text":"A n natema nɛ geya fari.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A n xun nakelima nɛ n yaxuie ya xɔri naxee n nabilinxi.","poem":1},{"lineBreak":true},{"text":"N sɛrɛxɛ bama nɛ a xa hɔrɔmɔbanxi kui ɲɛlɛxinyi ra.","poem":1},{"lineBreak":true},{"text":"N suuki ba, n bɛɛti ba Alatala bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatala, i tuli mati n xui ra, n na i maxandife.","poem":1},{"lineBreak":true},{"text":"Hinnɛ n na, i man xa n yaabi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N bɔɲɛ wama i fenfe.","poem":1},{"lineBreak":true},{"text":"Alatala, n i fenma nɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I naxa i kobe ti n na.","poem":1},{"lineBreak":true},{"text":"I naxa mɛɛ i xa konyi ra xɔnɛ kui.","poem":1},{"lineBreak":true},{"text":"I tan nan na n malima ra.","poem":1},{"lineBreak":true},{"text":"N ma marakisima Ala, i naxa n nabolo,","poem":1},{"lineBreak":true},{"text":"i naxa n nabɛɲin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Xa n nga nun n ba n nabolo,","poem":1},{"lineBreak":true},{"text":"Alatala tan a makɔrɛma nɛ n na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alatala, i xa kira masen n bɛ.","poem":1},{"lineBreak":true},{"text":"N xun ti kira tinxinxi ra,","poem":1},{"lineBreak":true},{"text":"alako n yaxuie naxa n suxu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I naxa n nabolo n yaxuie xa e sago raba n na,","poem":1},{"lineBreak":true},{"text":"barima e bara findi tɔɔɲɛgɛlae ra n bɛ.","poem":1},{"lineBreak":true},{"text":"Fe kobi rabae nan lanxi e ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N laxi a ra n Alatala xa fe fanyi toma nɛ","poem":1},{"lineBreak":true},{"text":"yi duniɲa bɛndɛ fuɲi fari.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"I xaxili ti Alatala ra.","poem":1},{"lineBreak":true},{"text":"I sɛnbɛ xun xa masa, i xa limaniya.","poem":1},{"lineBreak":true},{"text":"I xaxili ti Alatala ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}