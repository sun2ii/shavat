{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":28,"content":[{"type":"heading","content":["Ala ɲɛngi dɔxɔxi a xa mixie xɔn ma"]},{"type":"heading","content":["Ala maxandi"]},{"type":"hebrew_subtitle","content":["Dawuda gbe"]},{"type":"verse","number":1,"content":[{"text":"Alatala, n bara i xili.","poem":1},{"lineBreak":true},{"text":"I xa sɛnbɛ luma n bɛ alɔ fanye.","poem":1},{"lineBreak":true},{"text":"I tuli mati n na, xa na mu a ra n luma alɔ faxa mixi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N na n bɛlɛxɛ ite i bɛ i xa yire sɛniyɛnxi mabiri,","poem":1},{"lineBreak":true},{"text":"i xa n ma maxandi xui ramɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I naxa n lu alɔ mixi ɲaaxie nun tinxintaree.","poem":1},{"lineBreak":true},{"text":"E e boore yanfama, e bɔɲɛ mu fan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E xa wali kobi sare ragbilen e ma.","poem":1},{"lineBreak":true},{"text":"E naxan nabaxi mixie ra,","poem":1},{"lineBreak":true},{"text":"i xa na raba e fan na.","poem":1},{"lineBreak":true},{"text":"A lanma e xa na mɔɔli sɔtɔ,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"barima e mu Alatala xa wali kolon.","poem":1},{"lineBreak":true},{"text":"A fama e rabirade, e mu keli sɔnɔn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala tantu,","poem":1},{"lineBreak":true},{"text":"a bara n ma dubɛ suxu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala nan na n sɛnbɛ nun n kantama ra.","poem":1},{"lineBreak":true},{"text":"N xaxili tixi a tan nan na naxan n malima.","poem":1},{"lineBreak":true},{"text":"N bɔɲɛ sɛɛwama nɛ, n fa bɛɛti ba a bɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala nan a xa ɲama sɛnbɛ ra,","poem":1},{"lineBreak":true},{"text":"a findi a xa mixi sugandixi kantama ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I xa ɲama rakisi, i xa barakɛ ragoro e ma.","poem":1},{"lineBreak":true},{"text":"Mɛɛni e ma","poem":1},{"lineBreak":true},{"text":"alɔ xuruse dɛmadonyi mɛɛnima a xa gɔɔrɛ ma ki naxɛ.","poem":1},{"lineBreak":true},{"text":"I ɲɛngi dɔxɔ e xɔn ma abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}