{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":29,"content":[{"type":"heading","content":["Alatala xui magaaxuxi"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"hebrew_subtitle","content":["Dawuda xa bɛɛti"]},{"type":"verse","number":1,"content":[{"text":"Malekɛe, wo Alatala matɔxɔ,","poem":1},{"lineBreak":true},{"text":"a xa binyɛ nun a sɛnbɛ xa fe ra.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wo xa Alatala matɔxɔ,","poem":1},{"lineBreak":true},{"text":"wo xa a batu a nɔrɛ sɛniyɛnxi kui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala xui mɛma baa ma,","poem":1},{"lineBreak":true},{"text":"Ala Binyɛ Kanyi xui luma alɔ galanyi,","poem":1},{"lineBreak":true},{"text":"a a xui rasigama baa xungbee ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala xui sɛnbɛ gbo,","poem":1},{"lineBreak":true},{"text":"a magaaxu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala xui wuri bili xungbee igirama,","poem":1},{"lineBreak":true},{"text":"alɔ naxee na Liban bɔxi ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala Liban wuri bilie ituganma alɔ ninge di,","poem":1},{"lineBreak":true},{"text":"a Siriyon geya ituganma alɔ sɛxɛ i ninge.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Alatala xui tɛ rayensenma alɔ seyamakɔnyi.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala xui Kadesi gbengberenyi rasɛrɛnma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala xui a niyama xelie nun sie xa bari.","poem":1},{"lineBreak":true},{"text":"Ɲama birin e xui itema a xa hɔrɔmɔbanxi kui,","poem":1},{"lineBreak":true},{"text":"a a fala,","poem":1},{"lineBreak":true},{"text":"«Matɔxɔɛ na Ala bɛ!»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala nu na a xa kibanyi kui duniɲa banbaran yɛ tɛmui naxɛ.","poem":1},{"lineBreak":true},{"text":"A xa mangɛya mu ɲɔnma abadan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala nan sɛnbɛ fima a xa ɲama ma,","poem":1},{"lineBreak":true},{"text":"a barakɛ nun bɔɲɛsa fima e ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}