{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":3,"content":[{"type":"heading","content":["Dawuda nun a xa di Abisalomi"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti a nu a gima a xa di Abisalomi ma tɛmui naxɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n yaxuie bara wuya.","poem":1},{"lineBreak":true},{"text":"N gerefae bara gbo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mixi wuyaxi a falama,","poem":1},{"lineBreak":true},{"text":"Ala mu nɔma n nakiside. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɔnɔ i tan Alatala, i findixi n kantama nan na.","poem":1},{"lineBreak":true},{"text":"N ma binyɛ nun n ma xunnakeli fatanxi i tan nan na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N nan n xui rate Ala ma,","poem":1},{"lineBreak":true},{"text":"a n yaabima keli a xa geya sɛniyɛnxi fari. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N nan n sama, n xa xi,","poem":1},{"lineBreak":true},{"text":"n man xunuma xaxili sa kui,","poem":1},{"lineBreak":true},{"text":"barima Alatala nan na n dɛmɛnma ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N mu gaaxuma yi ɲama duniɲa ya ra,","poem":1},{"lineBreak":true},{"text":"naxee mu wama n ma fe xɔn ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala yandi, n nakisi, n Marigi Ala.","poem":1},{"lineBreak":true},{"text":"I n yaxuie dɛ ragarinma nɛ,","poem":1},{"lineBreak":true},{"text":"i mixi ɲaaxi ɲinyie magirama nɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Marakisima nan na Alatala ra.","poem":1},{"lineBreak":true},{"text":"I xa barakɛ sa i xa ɲama xa fe. Ɲɛngi rate.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}