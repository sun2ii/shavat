{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":30,"content":[{"type":"heading","content":["Ala xa xɔnɛ mu buma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti a naxan sɛbɛ Ala xa hɔrɔmɔbanxi xa fe ra","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N bara i matɔxɔ Alatala,","poem":1},{"lineBreak":true},{"text":"barima i bara n nakeli.","poem":1},{"lineBreak":true},{"text":"I mu tin n yaxuie xa xunnakeli sɔtɔ n xun ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N Marigi Alatala, n to i xili,","poem":1},{"lineBreak":true},{"text":"i naxa n nayalan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala, i naxa n nii rakisi saya ma,","poem":1},{"lineBreak":true},{"text":"i mu tin n xa goro gaburi kui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Danxaniyatɔɛe, wo xa bɛɛti ba Alatala bɛ,","poem":1},{"lineBreak":true},{"text":"wo xa a xili matɔxɔ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A xa xɔnɛ mu buma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a hinnɛma i ra i xa simaya birin kui.","poem":1},{"lineBreak":true},{"text":"Nunmare, mixie wama, kɔnɔ gɛɛsɛgɛ e fa ɲɛlɛxin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N bɔɲɛsa sɔtɔ tɛmui naxɛ n naxa a fala,","poem":1},{"lineBreak":true},{"text":"«N mu nɔma birade.»","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, tɛmui dangixi i naxa n sɛnbɛ lu alɔ geya,","poem":1},{"lineBreak":true},{"text":"kɔnɔ yakɔsi i bara i nɔxun n ma.","poem":1},{"lineBreak":true},{"text":"N bɔɲɛ bara ifu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala, n naxa i xili, n naxa i maxandi.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N naxa a fala i bɛ,","poem":1},{"lineBreak":true},{"text":"«N ma faxɛ findima geeni mundun na i bɛ?","poem":1},{"lineBreak":true},{"text":"Xa n bara goro gaburi kui,","poem":1},{"lineBreak":true},{"text":"na nɔma findide matɔxɔɛ ra i bɛ?","poem":1},{"lineBreak":true},{"text":"Na nɔma i xa lanlanteya masende duniɲa bɛ?»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala, i tuli mati n na, i xa kinikini n ma.","poem":1},{"lineBreak":true},{"text":"Alatala, n mali.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"I bara n ma nimisɛ masara sɛɛwɛ ra.","poem":1},{"lineBreak":true},{"text":"I bara n ma sunnun donma masara ɲɛlɛxin donma ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N Marigi Alatala, na na a ra n mu dunduma,","poem":1},{"lineBreak":true},{"text":"n tantui bɛɛti bama nɛ i bɛ abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}