{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":31,"content":[{"type":"heading","content":["Lafe Ala ra"]},{"type":"heading","content":["Ala maxandi nun Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n bara n xaxili ti i ra.","poem":1},{"lineBreak":true},{"text":"I naxa tin n xa lu yaagi kui, i xa kiiti fanyi sa n ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I xa i tuli mati n na, n nakisi.","poem":1},{"lineBreak":true},{"text":"I xa lu n bɛ alɔ fanye,","poem":1},{"lineBreak":true},{"text":"alɔ yire makantaxi alako n xa kisi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N ma sɛnbɛma nun n ma kantama nan i ra.","poem":1},{"lineBreak":true},{"text":"I xa n xun ti kira fanyi xɔn i xili fanyi xa fe ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yaxuie bara yɛlɛ itala n ya ra, kɔnɔ i fama n natangade na ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N bara n xaxili ti i ra.","poem":1},{"lineBreak":true},{"text":"Alatala Nɔndi Marigi, i bara n nakisi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuye batui mu rafan n ma,","poem":1},{"lineBreak":true},{"text":"n tan, nan n taxuma Alatala nan na.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N sɛɛwama nɛ i xa hinnɛ xa fe ra,","poem":1},{"lineBreak":true},{"text":"barima i bara n ma tɔɔrɛe to,","poem":1},{"lineBreak":true},{"text":"n sondonyi na ɲaxankata, i na kolon.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I mu n soxi n yaxuie yi ra, i bara n xɔrɛya.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alatala, hinnɛ n na,","poem":1},{"lineBreak":true},{"text":"barima n na tɔɔrɔfe.","poem":1},{"lineBreak":true},{"text":"N fate birin bara ba n ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ma simaya na ɲɔnfe tɔɔrɛ kui.","poem":1},{"lineBreak":true},{"text":"N ma duniɲɛigiri xɔrɔxɔ.","poem":1},{"lineBreak":true},{"text":"N sɛnbɛ bara ɲɔn n ma yunubi xa fe ra.","poem":1},{"lineBreak":true},{"text":"N fate bara kana","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"n yaxuie xa fe ra.","poem":1},{"lineBreak":true},{"text":"N bara yaagi n dɔxɔbooree xɔn ma.","poem":1},{"lineBreak":true},{"text":"N booree, xa na mu a ra naxee n toma taa kui,","poem":1},{"lineBreak":true},{"text":"e e gima nɛ n ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"E birin bara nɛɛmu n ma alɔ n ɲan bara faxa.","poem":1},{"lineBreak":true},{"text":"N luxi alɔ se lɔɛxi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N bara n yaxuie xui mɛ.","poem":1},{"lineBreak":true},{"text":"Gbaloe na n nabilinyi.","poem":1},{"lineBreak":true},{"text":"E bara lan a ma e xa n faxa.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kɔnɔ n tan bara n taxu i ra, i tan n Marigi Alatala.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N na i sagoe.","poem":1},{"lineBreak":true},{"text":"N natanga n yaxuie ma naxee wama n ɲaxankatafe.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I xa i xa konyi to, n nakisi i xa hinnɛ ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alatala, n na i xili, i naxa n lu yaagi kui.","poem":1},{"lineBreak":true},{"text":"Ala xa mixi ɲaaxie rayaagi,","poem":1},{"lineBreak":true},{"text":"Ala xa e rasabari faxɛ ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ala xa e xui radundu,","poem":1},{"lineBreak":true},{"text":"barima yi wule falɛe e yɛtɛ igboma, e yo tinxintɔɛe ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"I xa hinnɛ gbo, i naxan nagataxi i yaragaaxuie bɛ,","poem":1},{"lineBreak":true},{"text":"naxee i xa kantari fenma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I bara e yigiya alako fe kobi rabae naxa e suxu.","poem":1},{"lineBreak":true},{"text":"I bara e ratanga wule falɛe ma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Alatala tantu, barima a bara hinnɛ n na n ma tɔɔrɛ kui.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N ma gaaxui kui, n nu bara a fala,","poem":1},{"lineBreak":true},{"text":"«I bara i nɔxun n ma,»","poem":1},{"lineBreak":true},{"text":"kɔnɔ i bara n ma maxandi suxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Danxaniyatɔɛe, wo xa Alatala xanu.","poem":1},{"lineBreak":true},{"text":"Alatala togondiyatɔɛe rakisima nɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ a yɛtɛ igboe ɲaxankatama nɛ.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Wo tan naxee wo xaxili tixi Alatala ra,","poem":1},{"lineBreak":true},{"text":"wo wo sɛnbɛ so, wo xa limaniya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":25}