{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":32,"content":[{"type":"heading","content":["Ala yunubi xafarife"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"hebrew_subtitle","content":["Dawuda xa lɔnni bɛɛti"]},{"type":"verse","number":1,"content":[{"text":"Ɲɛlɛxinyi na adama bɛ","poem":1},{"lineBreak":true},{"text":"naxan xa yunubi bara ba,","poem":1},{"lineBreak":true},{"text":"naxan xa fe kobi bara xafari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ɲɛlɛxinyi na adama bɛ","poem":1},{"lineBreak":true},{"text":"Alatala bara diɲɛ naxan ma fe kobi ma,","poem":1},{"lineBreak":true},{"text":"a nun maifui mu na naxan xaxili ya ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Danmi n dunduxi, n mu nɔma minide tɔɔrɛ kui.","poem":1},{"lineBreak":true},{"text":"N nu tɔɔrɔma nɛ yanyi birin na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɔɛ nun yanyi i xa tɔɔrɛ na n fari.","poem":1},{"lineBreak":true},{"text":"N sɛnbɛ bara kana, a bara lu alɔ gbengberen yire.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N bara n ma yunubi masen i bɛ,","poem":1},{"lineBreak":true},{"text":"n mu n ma yunubi nɔxunxi fa.","poem":1},{"lineBreak":true},{"text":"N bara a fala,","poem":1},{"lineBreak":true},{"text":"«Fo n xa n ma yunubi ya xaran Alatala bɛ.»","poem":1},{"lineBreak":true},{"text":"I tan Alatala bara n ma yunubi ba n ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mixi tinxinxi birin xa i maxandi a waxati.","poem":1},{"lineBreak":true},{"text":"Xa tɔɔrɛ gbo alɔ banbaranyi,","poem":1},{"lineBreak":true},{"text":"a mu sese niyama a ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N ma kantari lanxi i tan nan ma.","poem":1},{"lineBreak":true},{"text":"I man sunnunyi bama n ma.","poem":1},{"lineBreak":true},{"text":"N i tantuma nɛ i xa maratangɛ xa fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N wo xaranma nɛ kira ra","poem":1},{"lineBreak":true},{"text":"wo lan wo xa bira naxan fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"N wo rasima nɛ,","poem":1},{"lineBreak":true},{"text":"n nan n ɲɛngi sama nɛ wo xa fe xɔn ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wo naxa lu alɔ soe,","poem":1},{"lineBreak":true},{"text":"xa na mu a ra sofale xaxilitare,","poem":1},{"lineBreak":true},{"text":"naxan mu raɲɛrɛma fo karafoe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Fe xɔnɛ gbegbe ragataxi mixi ɲaaxi bɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ naxan a xaxili tixi Alatala ra,","poem":1},{"lineBreak":true},{"text":"Ala xa fonisireya na kanyi rabilinma nɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mixi tinxinxie, wo sɛɛwa Alatala ra,","poem":1},{"lineBreak":true},{"text":"wo man xa ɲɛlɛxin.","poem":1},{"lineBreak":true},{"text":"Wo Ala tantu ɲɛlɛxinyi kui wo xui itexi ra,","poem":1},{"lineBreak":true},{"text":"wo tan mixi tinxinxie birin.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}