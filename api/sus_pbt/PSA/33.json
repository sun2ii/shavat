{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":33,"content":[{"type":"heading","content":["Ala na wɔyɛn, a fe ragirima nɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Tinxintɔɛe, wo xa Alatala matɔxɔ wo xui itexi ra.","poem":1},{"lineBreak":true},{"text":"Tinxintɔɛe lan e xa Ala matɔxɔ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wo xa Alatala tantu kɔra ra,","poem":1},{"lineBreak":true},{"text":"wo xa bɛɛti ba kɔra ra luuti fu daaxi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wo xa bɛɛti nɛɛnɛ ba a bɛ,","poem":1},{"lineBreak":true},{"text":"wo xa na raba maxasee ra wo xui itexi ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala xa masenyi tinxin,","poem":1},{"lineBreak":true},{"text":"a a xa wali birin nabama sɔɔbɛ ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tinxinyi nun sɛriyɛ rafan a ma,","poem":1},{"lineBreak":true},{"text":"duniɲa birin nafexi Alatala xa hinnɛ ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala naxa koore daa a xa wɔyɛnyi ra.","poem":1},{"lineBreak":true},{"text":"A to wɔyɛn keren fala, tunbuie naxa mini keren na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A naxa baa fan malan yire keren,","poem":1},{"lineBreak":true},{"text":"a xa ye ragata.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɔxi birin xa gaaxu Alatala ya ra.","poem":1},{"lineBreak":true},{"text":"Duniɲa mixi birin xa a binya.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A na wɔyɛn, a fe ragirima nɛ.","poem":1},{"lineBreak":true},{"text":"A na yaamari fi, a rabama nɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala sie xa natɛe kanama nɛ.","poem":1},{"lineBreak":true},{"text":"A mu e xa wali sɔɔnɛyama.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɔnɔ Alatala xa fe ragirixie buma abadan.","poem":1},{"lineBreak":true},{"text":"A waxɔnfe sɔɔnɛyama nɛ waxati birin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɲɛlɛxinyi na si bɛ naxan marigi findixi Alatala ra.","poem":1},{"lineBreak":true},{"text":"Ɲɛlɛxinyi na bɔnsɔɛ bɛ Alatala naxan sugandixi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala a ya ragoroma duniɲa ma kelife ariyanna,","poem":1},{"lineBreak":true},{"text":"a mixi birin mato.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kelife a xɔnyi, a duniɲa mixi birin matoma nɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Naxan adamadie bɔɲɛ daaxi,","poem":1},{"lineBreak":true},{"text":"a a ɲɛngi sama e xa walie xɔn.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mangɛ yo mu kisima a xa sɔɔrie saabui ra.","poem":1},{"lineBreak":true},{"text":"Sɔɔri fan mu kisima a yɛtɛ sɛnbɛ ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Sɔɔri ɲɔxɔ a ma a xa soe nɔma a rakiside,","poem":1},{"lineBreak":true},{"text":"kɔnɔ na tan mu findima kisi ra a bɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Alatala nan mɛɛnima mixie ma","poem":1},{"lineBreak":true},{"text":"naxee gaaxuma a ya ra,","poem":1},{"lineBreak":true},{"text":"naxee e xaxili tima a xa hinnɛ ra,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"alako e nii naxa laaxira,","poem":1},{"lineBreak":true},{"text":"alako e xa balo kaamɛ waxati.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Won xaxili tixi Alatala nan na.","poem":1},{"lineBreak":true},{"text":"A tan nan won malima ra,","poem":1},{"lineBreak":true},{"text":"a tan nan won kantama ra.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Won bɔɲɛe sɛɛwaxi a tan nan ma fe ra,","poem":1},{"lineBreak":true},{"text":"barima won bara la a xili sɛniyɛnxi ra.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Alatala, i xa hinnɛ muxu ra,","poem":1},{"lineBreak":true},{"text":"barima muxu xaxili tixi i tan nan na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}