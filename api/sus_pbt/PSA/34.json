{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":34,"content":[{"type":"heading","content":["Ala yaragaaxuie sare"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda to a yɛtɛ findi daxui ra Abimeleki ya i alako a xa a bɛɲin, a naxa yi bɛɛti sɛbɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N Alatala tantuma waxati birin.","poem":1},{"lineBreak":true},{"text":"A xa matɔxɔɛ mu bama n dɛ i.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N Alatala matɔxɔma n bɔɲɛ kui.","poem":1},{"lineBreak":true},{"text":"Tɔɔrɔmixie fama nɛ na mɛde, e fa sɛɛwa.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Won birin xa Alatala binya,","poem":1},{"lineBreak":true},{"text":"won xa a xili matɔxɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N to Alatala maxandi, a naxa n yaabi,","poem":1},{"lineBreak":true},{"text":"a n ma gaaxui birin ba n yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Naxan na a ya ti Ala ra,","poem":1},{"lineBreak":true},{"text":"a sɛɛwama nɛ, a mu yaagima.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xa tɔɔrɔmixi a xui ramini,","poem":1},{"lineBreak":true},{"text":"Alatala a mɛma nɛ, a fa a rakisi a xa tɔɔrɛ kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alatala xa malekɛ Ala yaragaaxuie rabilinma nɛ, a e kanta.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wo a mato, Alatala fan de!","poem":1},{"lineBreak":true},{"text":"Ɲɛlɛxinyi na adama bɛ naxan xaxili tixi a ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sɛniyɛntɔɛe, wo xa gaaxu Alatala ya ra,","poem":1},{"lineBreak":true},{"text":"alako wo hayi birin xa fan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kaamɛ yɛtɛe suxuma nɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ Alatala fenmae hayi birin fanma nɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"N ma die, wo fa, wo xa fa wo tuli mati n na.","poem":1},{"lineBreak":true},{"text":"N xa Alatala yaragaaxui masen wo bɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Nde wama simaya xɔnkuye xɔn?","poem":1},{"lineBreak":true},{"text":"Nde wama lufe sɛɛwɛ kui tɛmui birin?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xa wo wama na xɔn,","poem":1},{"lineBreak":true},{"text":"wɔyɛn ɲaaxie naxa mini wo dɛ i,","poem":1},{"lineBreak":true},{"text":"wo naxa wule yo fala.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wo xa fe ɲaaxi lu na, wo xa fe fanyi raba.","poem":1},{"lineBreak":true},{"text":"Wo xa wo tunnabɛxi bɔɲɛsa fenfe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Alatala tinxintɔɛe toma nɛ, a a tuli matima e wa xui ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala a kobe soma fe kobi rabae ra,","poem":1},{"lineBreak":true},{"text":"alako e xili xa nɛɛmu duniɲa ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Tinxintɔɛe na e mawa Alatala bɛ, a a tuli matima nɛ e ra,","poem":1},{"lineBreak":true},{"text":"a e ba e xa tɔɔrɛe kui.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Alatala luma mixi fɛ ma naxan sunnunxi a bɔɲɛ ma,","poem":1},{"lineBreak":true},{"text":"a mixi rakisima naxan xaxili bara ifu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tɔɔrɛ gbegbe tinxintɔɛ lima nɛ,","poem":1},{"lineBreak":true},{"text":"kɔnɔ Alatala a rakisima na birin ma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Alatala mɛɛnima nɛ a ma,","poem":1},{"lineBreak":true},{"text":"sese mu a toma.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Fe ɲaaxi nan mixi ɲaaxi faxama.","poem":1},{"lineBreak":true},{"text":"Tinxintɔɛ yaxuie fama ɲaxankatade.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Alatala a xa konyie xun sarama nɛ.","poem":1},{"lineBreak":true},{"text":"Naxan a xaxili tima Ala ra,","poem":1},{"lineBreak":true},{"text":"na mu kiiti ɲaaxi sɔtɔma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":23}