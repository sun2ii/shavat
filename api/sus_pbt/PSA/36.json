{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":36,"content":[{"type":"heading","content":["Adama xa ɲaaxuɲa nun Ala xa hinnɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Alatala xa konyi Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N bara mixi ɲaaxi xa matandi maɲɔxun n bɔɲɛ kui.","poem":1},{"lineBreak":true},{"text":"A mu a kolon a lanma a xa gaaxu Ala ya ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A a yɛtɛ igboma han a mu nɔma a xa yunubi tode,","poem":1},{"lineBreak":true},{"text":"a mu nɔma a ɲɛrɛ ki xɔnde.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A xa wɔyɛnyi ɲaaxu, a nu mixi madaxu tun.","poem":1},{"lineBreak":true},{"text":"A mu fe fanyi yo kolon.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A fe ɲaaxi maɲɔxunma kɔɛ ra, a fa kira ɲaaxi suxu,","poem":1},{"lineBreak":true},{"text":"barima a mu tondima fe kobi lude.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Alatala, i xa hinnɛ koore lima,","poem":1},{"lineBreak":true},{"text":"i xa dugutɛgɛɲa sigama han nuxui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I xa tinxinyi gbo alɔ geyae.","poem":1},{"lineBreak":true},{"text":"I xa kiiti tilin alɔ baa.","poem":1},{"lineBreak":true},{"text":"I tan nan adamadie nun subee rakisima.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala, i xa hinnɛ fan.","poem":1},{"lineBreak":true},{"text":"Adamadie birin yigiya sɔtɔma nɛ i yi ra,","poem":1},{"lineBreak":true},{"text":"alɔ tɔxɔɛ yɔrɛe luma e nga gabutenyie bun ma ki naxɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E wasama i xa nɛmɛ nan na,","poem":1},{"lineBreak":true},{"text":"i xa fe fanyi luma e bɛ alɔ ye xinbeli.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I tan nan gbansan nɔma adama rabalode.","poem":1},{"lineBreak":true},{"text":"I xa naiyalanyi bara muxu xa kira iyalan.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I xa hinnɛ i kolonmae ra,","poem":1},{"lineBreak":true},{"text":"i xa i xa tinxinyi masen tinxintɔɛe bɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I xa n natanga yɛtɛ igboee ma,","poem":1},{"lineBreak":true},{"text":"i naxa a lu mixi ɲaaxie xa n keri.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tinxintaree birama nɛ, e mu nɔma kelide sɔnɔn.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}