{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":38,"content":[{"type":"heading","content":["N sɛnbɛ bara kana"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa maxandi bɛɛti","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i naxa n ɲaxankata i xa xɔnɛ kui,","poem":1},{"lineBreak":true},{"text":"i naxa n halaki i xa bɔɲɛte kui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I bara n maxɔnɔ i xa tanbɛ ra, i bara n nabira.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yalanyi yo mu na n bɛ i xa xɔnɛ kui.","poem":1},{"lineBreak":true},{"text":"N ma yunubi bara a niya n fate birin xa tɔɔrɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N ma yunubie bara gbo n xun ma.","poem":1},{"lineBreak":true},{"text":"Na kote bara binya, n mu a nɔma sɔnɔn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N ma fie bara gbo, e xiri bara ɲaaxu.","poem":1},{"lineBreak":true},{"text":"Na birin fatanxi n ma xaxilitareɲa nan na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bɔɲɛ bara kana, xunnakeli mu na n bɛ.","poem":1},{"lineBreak":true},{"text":"N luma fɛɛɲɛn na sunnunyi nan kui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N fate birin wolenxi, yalanyi yo mu na sɔnɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N sɛnbɛ bara kana, n fate birin bara ba n ma.","poem":1},{"lineBreak":true},{"text":"N bɔɲɛ tɔɔrɔxi tun.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N Marigi, i n waxɔnfe kolon, n ma tɔɔrɛ mu nɔxunxi i ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N bɔɲɛ mu saxi, n sɛnbɛ bara ɲɔn.","poem":1},{"lineBreak":true},{"text":"N ya mu naiyalanyi toma sɔnɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N xanuntenyie nun n booree bara keli n xun ma","poem":1},{"lineBreak":true},{"text":"n ma fure xa fe ra, n ngaxakerenyie bara e makuya n na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Naxee wama n faxafe, e bara yɛlɛ itala n ya ra.","poem":1},{"lineBreak":true},{"text":"Naxee wama n tɔɔrɔfe, e bara n konbi,","poem":1},{"lineBreak":true},{"text":"e n tɔɔɲɛgɛma tɛmui birin.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɔnɔ n mu n tuli mati na wɔyɛnyie ra,","poem":1},{"lineBreak":true},{"text":"n mu n dɛ rabi n xa e yaabi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N luma alɔ tuli xɔri, n luma alɔ boboe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Alatala, n xaxili tixi i tan nan na.","poem":1},{"lineBreak":true},{"text":"N Marigi Ala, i tan nan gbansan nɔma n yaabide.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N naxɛ, «I naxa tin n yaxuie xa yo n ma,","poem":1},{"lineBreak":true},{"text":"e xa ɲɛlɛxin n ma tɔɔrɛ xa fe ra.»","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"A gbe mu luxi n xa bira,","poem":1},{"lineBreak":true},{"text":"n na tɔɔrɔfe tɛmui birin.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N bara n ti n ma yunubi rabaxie ra,","poem":1},{"lineBreak":true},{"text":"n yangoe naxee rabaxi, na fe bara n kɔntɔfili.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"N yaxuie tan kɛndɛ, e sɛnbɛ gbo.","poem":1},{"lineBreak":true},{"text":"N xɔnmixie bara wuya, hali nɔndi mu na e bɛ.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Naxee fe fanyi masarama fe ɲaaxi ra, e n tɔɔrɔma,","poem":1},{"lineBreak":true},{"text":"barima n tan birama fe fanyi nan fɔxɔ ra.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Alatala, i naxa n nabɛɲin.","poem":1},{"lineBreak":true},{"text":"N Marigi Ala, i naxa i makuya n na.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"N Marigi, i xa fa mafuren n malide.","poem":1},{"lineBreak":true},{"text":"N Marigi, n ma marakisima nan i ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}