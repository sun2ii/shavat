{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":39,"content":[{"type":"heading","content":["Adama luma alɔ foye"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ Yedutun bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N bara a fala, «N fe birin nabama,","poem":1},{"lineBreak":true},{"text":"alako n naxa yunubi raba n dɛ ra.","poem":1},{"lineBreak":true},{"text":"N fe birin nabama,","poem":1},{"lineBreak":true},{"text":"alako n naxa na wɔyɛnyi mɔɔli fala mixi ɲaaxie ya xɔri.»","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N ma tɔɔrɛ xungbe kui,","poem":1},{"lineBreak":true},{"text":"n naxa dundu, n mu sese fala, n naxa n sabari tun.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N bɔɲɛ nu satunma, n ma tɔɔrɛ naxa lu alɔ tɛ dɛxɛxi.","poem":1},{"lineBreak":true},{"text":"Na bara a niya n xa yi wɔyɛnyi fala,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"«Alatala, a masen n bɛ n faxama tɛmui mundun,","poem":1},{"lineBreak":true},{"text":"n ma simaya sigama han minden,","poem":1},{"lineBreak":true},{"text":"alako n xa n sɛnbɛ xa xurunyi kolon.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I bara n ma simaya radunke, a xɔn mu kuya sɔnɔn.","poem":1},{"lineBreak":true},{"text":"Adama luma alɔ foye naxan dangima.» Ɲɛngi rate.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Adama luxi nɛ alɔ niini, naxan minima, a fa dangi.","poem":1},{"lineBreak":true},{"text":"A naafuli malanma, kɔnɔ naxan fama a sɔtɔde,","poem":1},{"lineBreak":true},{"text":"a mu na kolon.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N Marigi, n fa n xaxili tima nde ra?","poem":1},{"lineBreak":true},{"text":"I tan nan gbansan nɔma n malide.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N nakisi n ma yunubie birin ma.","poem":1},{"lineBreak":true},{"text":"I naxa n nayaagi daxuie ya xɔri.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N bara dundu, n mu sese falama,","poem":1},{"lineBreak":true},{"text":"barima i tan nan na walife.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I xa fure ba n ma, beenu i xa n naɲɔn tɔɔrɛ kui.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I mixi ɲaxankatama a xa yunubi xa fe ra.","poem":1},{"lineBreak":true},{"text":"Naxan nafan adama ma, i na bama a yi.","poem":1},{"lineBreak":true},{"text":"Na fe luma nɛ alɔ kuli naxan bogise fanyi xun nakanama","poem":1},{"lineBreak":true},{"text":"beenu mixi xa a matongo.","poem":1},{"lineBreak":true},{"text":"Adamadi misaalixi foye nan na naxan dangima. Ɲɛngi rate.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alatala, n ma dubɛ suxu,","poem":1},{"lineBreak":true},{"text":"i xa i tuli mati n ma maxandi ra.","poem":1},{"lineBreak":true},{"text":"I xa n wa xui mɛ, barima i xa xɔɲɛ nan n na.","poem":1},{"lineBreak":true},{"text":"N luma alɔ n benbae,","poem":1},{"lineBreak":true},{"text":"n mu buma yi duniɲa bɛndɛ fuɲi fari.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"I xa i xa ɲaxankatɛ ragbilen n fɔxɔ ra sinden,","poem":1},{"lineBreak":true},{"text":"xa na mu a ra n faxama nɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}