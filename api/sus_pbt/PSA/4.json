{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":4,"content":[{"type":"heading","content":["Alatala keren nan nɔma n kantade"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba kɔra xui ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N Marigi Ala tinxinxi, n na n xui rate i ma, yandi a ratin n bɛ.","poem":1},{"lineBreak":true},{"text":"N ma tɔɔrɛ kui, i n bɔɲɛ sama.","poem":1},{"lineBreak":true},{"text":"Hinnɛ n na, n ma dubɛ suxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Adamadie, wo n ma binyɛ masarama yaagi ra han mun tɛmui?","poem":1},{"lineBreak":true},{"text":"Wo birama fe fufafu nun wule fɔxɔ ra han mun tɛmui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wo xa a kolon Alatala bara tinxintɔɛ sugandi.","poem":1},{"lineBreak":true},{"text":"N nan n xui rate Alatala ma, a a ramɛma nɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wo fan xa gaaxu, wo gbilen yunubi fe fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"Wo wo yɛtɛ rasi kɔɛ ra, wo xa wo raxara.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wo xa sɛrɛxɛ ba tinxinyi kui,","poem":1},{"lineBreak":true},{"text":"wo xa wo yɛtɛ taxu Alatala ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mixi gbegbe a falama,","poem":1},{"lineBreak":true},{"text":"«Nde nɔma hɛɛri masende won bɛ?»","poem":1},{"lineBreak":true},{"text":"Alatala, i xa nɔrɛ masen muxu bɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I bara n bɔɲɛ rafe sɛɛwɛ ra","poem":1},{"lineBreak":true},{"text":"dangife xɛ xaba tɛmui ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N na n sa, n xima bɔɲɛsa kui,","poem":1},{"lineBreak":true},{"text":"barima i tan Alatala, i keren nan nɔma n kantade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}