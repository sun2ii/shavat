{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":41,"content":[{"type":"heading","content":["Furema Ala maxandife"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ɲɛlɛxinyi na mixi bɛ naxan hinnɛma tɔɔrɔmixi ra.","poem":1},{"lineBreak":true},{"text":"Alatala a ratangama nɛ a xa tɔɔrɛ ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala a ratangama nɛ, a a rabalo.","poem":1},{"lineBreak":true},{"text":"A ɲɛlɛxinma nɛ duniɲa.","poem":1},{"lineBreak":true},{"text":"I mu a luma a yaxuie sagoe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala a malima nɛ a fura tɛmui, a a rayalan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N a falama a bɛ,","poem":1},{"lineBreak":true},{"text":"«Alatala, hinnɛ n na.","poem":1},{"lineBreak":true},{"text":"N nayalan barima n bara yunubi raba i ra.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N yaxuie wɔyɛn ɲaaxie falama, e naxɛ,","poem":1},{"lineBreak":true},{"text":"«A faxama mun tɛmui?","poem":1},{"lineBreak":true},{"text":"A xili lɔɛma mun lɔxɔɛ?»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Naxan fama n xɛɛbude a filankafui wɔyɛnyi falama.","poem":1},{"lineBreak":true},{"text":"Fe ɲaaxi gbo a bɔɲɛ kui.","poem":1},{"lineBreak":true},{"text":"A na keli n xun ma, a na mɔɔli falama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N xɔnmixie n ma fe makɔlikɔlima e boore bɛ,","poem":1},{"lineBreak":true},{"text":"e xa n tɔɔrɔ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E naxɛ, «Fure ɲaaxi bara a suxu,","poem":1},{"lineBreak":true},{"text":"a bara tagan, a mu kelima sɔnɔn.»","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Hali n dɛfanboore, n nu laxi naxan na,","poem":1},{"lineBreak":true},{"text":"muxu nun naxan nu muxu dɛgema yire keren,","poem":1},{"lineBreak":true},{"text":"na bara a kobe ti n na.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Alatala, hinnɛ n na, i xa n nakeli,","poem":1},{"lineBreak":true},{"text":"alako n xa n yaxuie sare ragbilen e ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N a kolon n nafan i ma,","poem":1},{"lineBreak":true},{"text":"barima i mu n luma n yaxuie sagoe.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I n malima nɛ barima n tinxin.","poem":1},{"lineBreak":true},{"text":"I bara tin n xa lu i sɛɛti ma abadan.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tantui na Isirayila Marigi Alatala bɛ abadan.","poem":1},{"lineBreak":true},{"text":"Amina. Amina.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":14}