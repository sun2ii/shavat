{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":42,"content":[{"type":"heading","content":["N sondonyi nimisaxi munfe ra?"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Kora xa die xa lɔnni bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, n wama lufe i yire.","poem":1},{"lineBreak":true},{"text":"N i fenma alɔ xeli ye fenma ki naxɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N hayi na Ala ɲiɲɛ ma.","poem":1},{"lineBreak":true},{"text":"N a yire lima mun tɛmui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yakɔsi n wama kɔɛ ra,","poem":1},{"lineBreak":true},{"text":"n wama yanyi ra.","poem":1},{"lineBreak":true},{"text":"Mixi n maxɔrinma,","poem":1},{"lineBreak":true},{"text":"«I Marigi Ala na minden?»","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N na ratu yi fe ma, n bɔɲɛ sɛɛwama nɛ.","poem":1},{"lineBreak":true},{"text":"Singe n nu ɲama raɲɛrɛma Ala xa hɔrɔmɔbanxi nan kui,","poem":1},{"lineBreak":true},{"text":"e nu bɛɛti bafe ɲɛlɛxinyi kui,","poem":1},{"lineBreak":true},{"text":"e tantui rasiga Ala ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Munfe ra n sondonyi nimisaxi?","poem":1},{"lineBreak":true},{"text":"Munfe ra n bɔɲɛ sunnunxi?","poem":1},{"lineBreak":true},{"text":"N xa n xaxili ti Ala ra,","poem":1},{"lineBreak":true},{"text":"n man xa a tantu a xa kisi xa fe ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N Marigi Ala, n bɔɲɛ nimisaxi n yɛtɛ kan ma fe ra.","poem":1},{"lineBreak":true},{"text":"Na na a ra n nan n natuma i ma Yurudɛn,","poem":1},{"lineBreak":true},{"text":"n na dɛnnaxɛ yi tɛmui,","poem":1},{"lineBreak":true},{"text":"Xerimon nun Misari geyae na dɛnnaxɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N ma tɔɔrɛ xun nan tun masafe.","poem":1},{"lineBreak":true},{"text":"A luma alɔ susui ye naxan sinma xure ye xun.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala hinnɛma n na yanyi ra,","poem":1},{"lineBreak":true},{"text":"n fan bɛɛti bama a bɛ kɔɛ ra.","poem":1},{"lineBreak":true},{"text":"N Ala maxandima naxan n nabaloma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N bara a fala Ala bɛ,","poem":1},{"lineBreak":true},{"text":"naxan sɛnbɛ gbo alɔ fanye,","poem":1},{"lineBreak":true},{"text":"«I nɛɛmuxi n ma munfe ra?","poem":1},{"lineBreak":true},{"text":"I n luxi tɔɔrɛ kui","poem":1},{"lineBreak":true},{"text":"n yaxuie xa nɔɛ bun ma munfe ra?»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N yaxuie n tɔɔrɔma konbi ra lɔxɔ yo lɔxɔ.","poem":1},{"lineBreak":true},{"text":"E n maxɔrinma, «I Marigi Ala na minden?»","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N sondonyi nimisaxi munfe ra?","poem":1},{"lineBreak":true},{"text":"N bɔɲɛ sunnunxi munfe ra?","poem":1},{"lineBreak":true},{"text":"N xa n xaxili ti Ala ra,","poem":1},{"lineBreak":true},{"text":"n man xa a tantu a xa kisi xa fe ra.","poem":1},{"lineBreak":true},{"text":"N Marigi nan na n ma marakisima ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":12}