"text":"Ala naxan findixi n ma sɛɛwɛ nun n ma ɲɛlɛxinyi ra.","poem":1},{"lineBreak":true},{"text":"N bɛɛti bama n Marigi Ala bɛ kɔra ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N sondonyi nimisaxi munfe ra?","poem":1},{"lineBreak":true},{"text":"N bɔɲɛ sunnunxi munfe ra?","poem":1},{"lineBreak":true},{"text":"N xa n xaxili ti Ala ra,","poem":1},{"lineBreak":true},{"text":"n man xa a tantu a xa kisi xa fe ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}