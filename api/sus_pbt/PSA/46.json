{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":46,"content":[{"type":"heading","content":["Won mu gaaxuma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Kora xa die xa bɛɛti bɛɛtibae xa mangɛ bɛ ginɛdimɛdi xui daaxi","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, won kantama nan a ra.","poem":1},{"lineBreak":true},{"text":"Won ma kantari na a yi ra.","poem":1},{"lineBreak":true},{"text":"A won malima won ma tɔɔrɛ birin kui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Xa bɔxi sa sɛrɛn, won mu gaaxuma.","poem":1},{"lineBreak":true},{"text":"Xa geya sa bira baa ma, won mu gaaxuma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Xa mɔrɔnyie sa xaaɲɛ, won mu gaaxuma.","poem":1},{"lineBreak":true},{"text":"Xa geya sa a imaxa, a sɛrɛn, won mu gaaxuma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Xure nan a ra, naxan salonyie Ala xa taa rasɛɛwama.","poem":1},{"lineBreak":true},{"text":"Ala Xili Xungbe Kanyi xa hɔrɔmɔlingira sɛniyɛnxi na mɛnni nɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala na na taa kui, na taa mu a ramaxama,","poem":1},{"lineBreak":true},{"text":"a a malima subaxɛ nɛfɛ a li.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Sie sɔnxɔɛ ratema, mangɛyae birama nɛ.","poem":1},{"lineBreak":true},{"text":"Ala nɛfɛ a xui ramini, duniɲa birin xununma nɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mangɛ Alatala na won sɛɛti ma.","poem":1},{"lineBreak":true},{"text":"Won ma kantari na Yaxuba Marigi Ala yi ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wo fa Alatala xa wali mato,","poem":1},{"lineBreak":true},{"text":"a gbaloe naxan luxi bɔxi ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A tan nan gere ɲɔnma duniɲa birin ma.","poem":1},{"lineBreak":true},{"text":"A xali girama nɛ.","poem":1},{"lineBreak":true},{"text":"A tanbɛ kanama nɛ,","poem":1},{"lineBreak":true},{"text":"a makantase gan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«Wo wo raxara, wo xa a kolon Ala na n tan nan na.","poem":1},{"lineBreak":true},{"text":"N si birin yamarima.","poem":1},{"lineBreak":true},{"text":"N ma yaamari na duniɲa birin ma.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alatala na won sɛɛti ma,","poem":1},{"lineBreak":true},{"text":"Won ma kantari na Yaxuba Marigi Ala yi ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":12}