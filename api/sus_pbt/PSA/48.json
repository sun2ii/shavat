{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":48,"content":[{"type":"heading","content":["Ala xa taa Siyon"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Kora xa die xa bɛɛti. Sigi sɛniyɛnxi.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala gbo.","poem":1},{"lineBreak":true},{"text":"A lanma won xa a matɔxɔ","poem":1},{"lineBreak":true},{"text":"a xa taa kui a xa geya sɛniyɛnxi fari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala xa geya Siyon tofan,","poem":1},{"lineBreak":true},{"text":"a rafan duniɲa birin ma.","poem":1},{"lineBreak":true},{"text":"Na findi Mangɛ Xungbe xa taa nan na.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala a ɲɛngi sama a xa taa makantaxi xɔn,","poem":1},{"lineBreak":true},{"text":"a bara a yɛtɛ findi a kantama ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mangɛe to e malan Siyon gere xili ma,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"e naxa kaaba na tofe ra.","poem":1},{"lineBreak":true},{"text":"E naxa gaaxu, e fa e gi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E to gaaxu na ya ra,","poem":1},{"lineBreak":true},{"text":"e naxa sɛrɛn alɔ ginɛ naxan na di barife,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"xa na mara alɔ Tarasisi xa kunkuie","poem":1},{"lineBreak":true},{"text":"foye xungbe naxee imaxama.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Won Marigi Ala kaabanako naxan nabaxi a xa taa kui,","poem":1},{"lineBreak":true},{"text":"won bara na mɛ, won bara na to.","poem":1},{"lineBreak":true},{"text":"Mangɛ Alatala na taa rakisima tɛmui birin. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ala, muxu na so i xa Hɔrɔmɔlingira kui,","poem":1},{"lineBreak":true},{"text":"muxu ratuma i xa hinnɛ nan ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala Xili Xungbe Kanyi,","poem":1},{"lineBreak":true},{"text":"i xili tantuma nɛ duniɲa yire birin.","poem":1},{"lineBreak":true},{"text":"I xa mangɛya tinxin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ɲama ɲɛlɛxinma nɛ Siyon geya fari,","poem":1},{"lineBreak":true},{"text":"Yudakae sɛɛwama nɛ i xa kiiti xa fe ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Wo xa Siyon mabilin,","poem":1},{"lineBreak":true},{"text":"wo xa a xa sɔɔri tidee kɔnti.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wo xa a tɛtɛ nun a yire makantaxie mato,","poem":1},{"lineBreak":true},{"text":"alako wo xa na fala wo xa die bɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ala nan na won Marigi Ala ra abadan.","poem":1},{"lineBreak":true},{"text":"A won naɲɛrɛma han aligiyama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}