{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":49,"content":[{"type":"heading","content":["Aligiyama sigafe mu kanama"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"verse","number":1,"content":[{"text":"Kora xa die xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Wo wo tuli mati yi ra, wo tan ɲama birin.","poem":1},{"lineBreak":true},{"text":"Duniɲa ɲama birin, wo wo tuli mati n na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tide xuri kanyi, tide xungbe kanyi,","poem":1},{"lineBreak":true},{"text":"setare a nun se kanyi, wo birin xa wo tuli mati.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N fama wɔyɛnyi hagigɛ nan falade wo bɛ,","poem":1},{"lineBreak":true},{"text":"n bɔɲɛ xaxili fanyi naxan maɲɔxunxi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N nan n tuli tixi taali ra,","poem":1},{"lineBreak":true},{"text":"n fama na tagi rabade wo bɛ kɔra xui ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Munfera n fa gaaxuma gbaloe lɔxɔɛ ya ra,","poem":1},{"lineBreak":true},{"text":"n yaxuie xa fe kobi n nabilinma tɛmui naxɛ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E laxi e xa bannaya nan na,","poem":1},{"lineBreak":true},{"text":"e nu fa e yɛtɛ matɔxɔ e harige xa gboe ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E mu nɔma e bore xunsarade,","poem":1},{"lineBreak":true},{"text":"E mu nɔma e xunsare fide Ala ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E nii xunsare xɔrɔxɔ,","poem":1},{"lineBreak":true},{"text":"e mu nɔma a fide abadan.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"E tan mu faxama? E mu sigama aligiyama?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Won a toma, lɔnnilae faxama,","poem":1},{"lineBreak":true},{"text":"lɔnnitaree fan faxama nɛ.","poem":1},{"lineBreak":true},{"text":"E fa e harige lu mixi gbɛtɛe yi ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mixi naxee e xilie saxi bɔxie xun ma,","poem":1},{"lineBreak":true},{"text":"e maɲɔxunxi nɛ e xa banxie luma nɛ naa abadan,","poem":1},{"lineBreak":true},{"text":"e xɔnyi mu kanama keli lanfanmae ma,","poem":1},{"lineBreak":true},{"text":"a sa dɔxɔ lanfanma gbɛtɛe ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Hali mixi xungbe, a mu buma.","poem":1},{"lineBreak":true},{"text":"A faxama nɛ alɔ subee.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mixi naxee laxi e yɛtɛ ra, e xa kira nan ya.","poem":1},{"lineBreak":true},{"text":"E xui rafan naxee ma, nee birama nɛ e fɔxɔ ra.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"E aligiyama lima nɛ.","poem":1},{"lineBreak":true},{"text":"Faxɛ e ralɔɛma nɛ.","poem":1},{"lineBreak":true},{"text":"Mixi tinxinxie e maboronma nɛ.","poem":1},{"lineBreak":true},{"text":"E xa tofanyi kanama nɛ.","poem":1},{"lineBreak":true},{"text":"Aligiyama findima nɛ e xɔnyi ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kɔnɔ Ala n nii xunsarama nɛ aligiyama,","poem":1},{"lineBreak":true},{"text":"a n xanin. Ɲɛngi rate.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mixi na findi banna ra, a harige na gbo,","poem":1},{"lineBreak":true},{"text":"i naxa gaaxu,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"barima a mu sese xaninma aligiyama.","poem":1},{"lineBreak":true},{"text":"A harige mu birama a fɔxɔ ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A ɲɛlɛxinma nɛ a harige ra a xa duniɲɛigiri kui,","poem":1},{"lineBreak":true},{"text":"barima birin a matɔxɔma na xa fe ra,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"kɔnɔ a fa siga aligiyama","poem":1},{"lineBreak":true},{"text":"a a benbae li na,","poem":1},{"lineBreak":true},{"text":"naxee mu duniɲa toma sɔnɔn.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Xa banna mixi xaxili mu na,","poem":1},{"lineBreak":true},{"text":"a luxi nɛ alɔ sube naxee faxama.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":21}