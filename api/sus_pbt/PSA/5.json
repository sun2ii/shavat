{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":5,"content":[{"type":"heading","content":["N soma Ala xɔnyi"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ xule xui ra","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i tuli mati n ma maxandi ra,","poem":1},{"lineBreak":true},{"text":"i xa n ma tɔɔrɛ kolon.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N Marigi Ala, i tuli mati n ma maxandi ra,","poem":1},{"lineBreak":true},{"text":"n na i tan nan maxandife.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Alatala, kuye nɛ ibama, i n xui ramɛma.","poem":1},{"lineBreak":true},{"text":"Gɛɛsɛgɛ, n nan n yɛtɛ ragbilenma i ma, n i mɛmɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I mu ɲɛlɛxinma fe kobi ra.","poem":1},{"lineBreak":true},{"text":"Fe ɲaaxi mu nɔma makɔrɛde i yire ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yɛtɛ igboe mu tima i ya i.","poem":1},{"lineBreak":true},{"text":"I tinxintaree birin xɔnxi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I wule falɛ rahalakima.","poem":1},{"lineBreak":true},{"text":"I faxatie nun yanfantee xɔnma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kɔnɔ n tan soma i xa banxi kui i xa fonisireya saabui nan na.","poem":1},{"lineBreak":true},{"text":"N nan n igoroma i xa hɔrɔmɔbanxi sɛniyɛnxi kui gaaxui ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala, n yaxuie xa fe ra,","poem":1},{"lineBreak":true},{"text":"n xun ti i xa tinxinyi ra,","poem":1},{"lineBreak":true},{"text":"i xa kira yailan n ya ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Nɔndi mu na n yaxuie xa masenyi sese kui.","poem":1},{"lineBreak":true},{"text":"E yuge mu fan.","poem":1},{"lineBreak":true},{"text":"E xa wɔyɛnyi mixi rafilima nɛ,","poem":1},{"lineBreak":true},{"text":"barima e dɛ iɲɔxun.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ala, e ɲaxankata.","poem":1},{"lineBreak":true},{"text":"E xa yanfɛ xa gbilen e ma.","poem":1},{"lineBreak":true},{"text":"E keri e xa fe kobi ma,","poem":1},{"lineBreak":true},{"text":"barima e bara i matandi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kɔnɔ mixi naxan birin a yɛtɛ taxuma i ra,","poem":1},{"lineBreak":true},{"text":"e birin xa sɛɛwa,","poem":1},{"lineBreak":true},{"text":"e xa ɲɛlɛxinyi naxa ɲɔn abadan.","poem":1},{"lineBreak":true},{"text":"I xili rafanxi mixi naxee ma, e makanta,","poem":1},{"lineBreak":true},{"text":"e xa sɛɛwa i xa fe ra,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"barima i tan Alatala, i barakɛ sama mixi tinxinxi xa fe.","poem":1},{"lineBreak":true},{"text":"I xa hinnɛ naxan e rabilinxi,","poem":1},{"lineBreak":true},{"text":"a bara findi e xa kantari ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}