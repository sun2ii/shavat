{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":50,"content":[{"type":"heading","content":["Sɛrɛxɛ naxan nafan Ala ma"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"hebrew_subtitle","content":["Asafi xa bɛɛti"]},{"type":"verse","number":1,"content":[{"text":"Alatala na wɔyɛnfe.","poem":1},{"lineBreak":true},{"text":"A na duniɲa birin xilife,","poem":1},{"lineBreak":true},{"text":"keli sogetede han sogegorode.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kelife Siyon, Ala xa tofanyi yanbama.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Won Marigi Ala na fafe,","poem":1},{"lineBreak":true},{"text":"a mu dunduxi.","poem":1},{"lineBreak":true},{"text":"Tɛ belebele na a ya ra,","poem":1},{"lineBreak":true},{"text":"foye xungbe fan na a rabilinyi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A xui tema koore ma,","poem":1},{"lineBreak":true},{"text":"a xui goroma bɔxi","poem":1},{"lineBreak":true},{"text":"kiiti sade a xa mixie bɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"«N batulae, naxee laayidi tongoxi n bɛ sɛrɛxɛ ra,","poem":1},{"lineBreak":true},{"text":"wo xa wo malan.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala xa masenyi tinxinxi kelima koore nan ma,","poem":1},{"lineBreak":true},{"text":"barima kiitisa nan na Ala ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"«N ma mixie, wo wo tuli mati, n xa wɔyɛn.","poem":1},{"lineBreak":true},{"text":"Isirayila, n bara wo kalamu.","poem":1},{"lineBreak":true},{"text":"Ala nan n na, wo Marigi Ala.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N mu xɔnɔxi wo xa sɛrɛxɛe xa fe ra.","poem":1},{"lineBreak":true},{"text":"Wo sɛrɛxɛ gan daaxie bama n bɛ tɛmui birin.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N mu tuura tongoma wo xɔnyi.","poem":1},{"lineBreak":true},{"text":"N mu si kontonyi fan tongoma wo xa kulɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N gbe nan na sube birin na wula i.","poem":1},{"lineBreak":true},{"text":"N gbe nan na sube birin na geyae ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N gbe nan na xɔni birin na koore ma.","poem":1},{"lineBreak":true},{"text":"N gbe nan na sube birin na fiili ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xa kaamɛ n suxuma nu, n ma falama wo tan bɛ.","poem":1},{"lineBreak":true},{"text":"N gbe nan na duniɲa birin na.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N tan tuura sube donma? Ade.","poem":1},{"lineBreak":true},{"text":"N tan si kontonyi wuli minma? Ade.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A lanma wo xa tantui rasiga n ma,","poem":1},{"lineBreak":true},{"text":"na xa findi wo xa sɛrɛxɛe ra.","poem":1},{"lineBreak":true},{"text":"Wo xa wo xa laayidie rakamali n bɛ, n tan Ala Xili Xungbe Kanyi.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Wo xa n xili wo xa tɔɔrɛ kui.","poem":1},{"lineBreak":true},{"text":"N fama wo ratangade,","poem":1},{"lineBreak":true},{"text":"wo fan fama n matɔxɔde.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ala xa masenyi nan ya, mixi ɲaaxie bɛ,","poem":1},{"lineBreak":true},{"text":"«wo na n ma yaamari nun n ma saatɛ durusife munfe ra?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N ma sɛriyɛ mu rafan wo ma.","poem":1},{"lineBreak":true},{"text":"Wo mu n ma wɔyɛnyi danxunma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wo nun muɲɛtie na a ra.","poem":1},{"lineBreak":true},{"text":"Wo nun yɛnɛ rabae na a ra.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Fe ɲaaxi nan tun minima wo dɛ i,","poem":1},{"lineBreak":true},{"text":"wo wule nan tun falama.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Wo nun naxan nga keren a ra,","poem":1},{"lineBreak":true},{"text":"wo na tɔɔɲɛgɛma.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Wo naxan nabaxi, na nan ya.","poem":1},{"lineBreak":true},{"text":"Han yakɔsi n bara n sabari.","poem":1},{"lineBreak":true},{"text":"Wo ɲɔxɔ a ma a n na wo sɛɛti ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ n fama xaaɲɛde wo ma,","poem":1},{"lineBreak":true},{"text":"n fama a birin ya bade wo bɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Wo xa yi fe mɛ,","poem":1},{"lineBreak":true},{"text":"wo tan naxee nɛɛmuxi Ala ma,","poem":1},{"lineBreak":true},{"text":"xa na mara n wo xa fe kanama nɛ.","poem":1},{"lineBreak":true},{"text":"Mixi yo mu wo ratangama.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Naxan tantui sɛrɛxɛ bama n bɛ,","poem":1},{"lineBreak":true},{"text":"na mixi bara n matɔxɔ.","poem":1},{"lineBreak":true},{"text":"Mixi naxan a ɲɛrɛ ki matoma a fanyi ra,","poem":1},{"lineBreak":true},{"text":"n fama n tan Ala xa marakisi masende a bɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}