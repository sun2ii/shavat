{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":51,"content":[{"type":"heading","content":["Dawuda xa yunubi"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Annabi Natan wɔyɛnfe Dawuda bɛ a yunubi raba Batiseba ra tɛmui naxɛ.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Ala, hinnɛ n na alɔ i darixi a ra ki naxɛ.","poem":1},{"lineBreak":true},{"text":"Diɲɛ n ma fe ɲaaxi ma i xa bɔɲɛ fanyi saabui ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I xa n nasɛniyɛn n ma fe kobi birin ma.","poem":1},{"lineBreak":true},{"text":"I xa n ma yunubi xafari.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N bara n ma yunubi kolon.","poem":1},{"lineBreak":true},{"text":"N mu nɔma nɛɛmude na ma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N na fe ɲaaxi rabaxi i keren nan na.","poem":1},{"lineBreak":true},{"text":"N naxan nabaxi a mu rafan i ma.","poem":1},{"lineBreak":true},{"text":"I na n makiiti,","poem":1},{"lineBreak":true},{"text":"nɔndi luma nɛ i bɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N barixi yunubi fe nan kui,","poem":1},{"lineBreak":true},{"text":"kabi nga furi ba nɛɛnɛ ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɔnɔ nɔndi na lu mixi bɔɲɛ kui,","poem":1},{"lineBreak":true},{"text":"na nan nafan i ma.","poem":1},{"lineBreak":true},{"text":"Na lɔnni masen n bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"N sɛniyɛn hisopi burɛxɛ ra,","poem":1},{"lineBreak":true},{"text":"alako n xa fiixɛ.","poem":1},{"lineBreak":true},{"text":"N sɛniyɛn,","poem":1},{"lineBreak":true},{"text":"alako n xa fiixɛ fɔɛn alɔ xiɲɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ɲɛlɛxinyi nun sɛɛwɛ fi n ma,","poem":1},{"lineBreak":true},{"text":"alako n bɔɲɛ xa sa.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I kobe ti n ma yunubi ra,","poem":1},{"lineBreak":true},{"text":"i xa n ma fe kobi birin ba n ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N Marigi Ala, n bɔɲɛ mafindi bɔɲɛ sɛniyɛnxi ra,","poem":1},{"lineBreak":true},{"text":"xaxili fanyi fi n ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I naxa n makuya i ya tode ra.","poem":1},{"lineBreak":true},{"text":"I naxa i Xaxili Sɛniyɛnxi ba n yi ra.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kisi sɛɛwɛ nun limaniya fi n ma","poem":1},{"lineBreak":true},{"text":"naxan n malima.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N i xa kira masenma nɛ i matandilae bɛ,","poem":1},{"lineBreak":true},{"text":"alako e man xa bira i fɔxɔ ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N nakisima Ala,","poem":1},{"lineBreak":true},{"text":"n bara mixi faxa.","poem":1},{"lineBreak":true},{"text":"Yandi, n xunsara,","poem":1},{"lineBreak":true},{"text":"alako n xa i xa fe fanyi masen.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N Marigi, na niya n bɛ,","poem":1},{"lineBreak":true},{"text":"n xa i tantu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Sɛrɛxɛ mu rafan i ma,","poem":1},{"lineBreak":true},{"text":"xa na mu a ra n na bama nɛ i bɛ nu.","poem":1},{"lineBreak":true},{"text":"I mu wama sɛrɛxɛ gan daaxi xɔn.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Sɛrɛxɛ fanyi findixi yɛtɛ magoroe nan na.","poem":1},{"lineBreak":true},{"text":"Ala wama yi sɛrɛxɛ mɔɔli nan xɔn ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"I xa hinnɛ Siyoni ra,","poem":1},{"lineBreak":true},{"text":"i xa Darisalamu tɛtɛ rakeli.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Na tɛmui i ɲɛlɛxinma nɛ sɛrɛxɛ tinxinxi","poem":1},{"lineBreak":true},{"text":"nun sɛrɛxɛ gan daaxi ra.","poem":1},{"lineBreak":true},{"text":"Na tɛmui tuurae nan bama sɛrɛxɛ ra i xa sɛrɛxɛbade.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":21}