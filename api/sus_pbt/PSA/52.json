{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":52,"content":[{"type":"heading","content":["Dɛ ɲaaxi"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa lɔnni bɛɛti bɛɛtibae xa mangɛ bɛ.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Masenyi nan ya Dowege Edonka xa fe ra, naxan a fala Sɔlu bɛ a Dawuda na Aximeleki xɔnyi.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"I i yɛtɛ igboma fe kobi rabafe ra munfe ra?","poem":1},{"lineBreak":true},{"text":"Ala xa hinnɛ buma nɛ abadan.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I dɛ luma alɔ finɛ naxan fe ɲaaxi rabama.","poem":1},{"lineBreak":true},{"text":"Yanfante nan i ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Fe ɲaaxi rafan i ma dangife fe fanyi ra.","poem":1},{"lineBreak":true},{"text":"Wule rafan i ma dangife nɔndi ra. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I wɔyɛn xui xaaɲɛ, i dɛ mu fan.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Na kui Ala fama i rahalakide tɛmui birin.","poem":1},{"lineBreak":true},{"text":"A i suxuma nɛ, a i keri i xa banxi kui, a i keri duniɲa ma. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Tinxintɔɛ naxee findima seedee ra","poem":1},{"lineBreak":true},{"text":"e fama yelede na kanyi ma yi ki nɛ,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"«Wo na mixi mato,","poem":1},{"lineBreak":true},{"text":"naxan mu nu a xaxili tixi Ala ra.","poem":1},{"lineBreak":true},{"text":"A naxa la a xa naafuli ra,","poem":1},{"lineBreak":true},{"text":"a a yɛtɛ kanta a xa yanfanteya ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɔnɔ, n tan naxan laxi Ala xa hinnɛ ra,","poem":1},{"lineBreak":true},{"text":"n ma fe birin na sɔɔnɛyafe","poem":1},{"lineBreak":true},{"text":"alɔ Oliwi wuri tofanyi naxan na Ala xɔnyi.»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N i tantuma nɛ abadan i xa wali xa fe ra.","poem":1},{"lineBreak":true},{"text":"N xaxili tixi i xili fanyi nan na i xa danxaniyatɔɛe tagi,","poem":1},{"lineBreak":true},{"text":"barima i fan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}