{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":53,"content":[{"type":"heading","content":["Xaxilitare xa masenyi"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa lɔnni bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba xule xui ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Xaxilitare a falama a bɔɲɛ kui,","poem":1},{"lineBreak":true},{"text":"«Ala mu na.»","poem":1},{"lineBreak":true},{"text":"E fe haramuxie rabama, e mu tinxin.","poem":1},{"lineBreak":true},{"text":"Mixi yo mu na naxan fe fanyi rabama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ala a ya ragoroma adamadie ma kelife ariyanna,","poem":1},{"lineBreak":true},{"text":"a xa e mato xa xaxilima nde na na naxan Ala fenma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɔnɔ birin bara makuya Ala ra, e nu fe ɲaaxi raba.","poem":1},{"lineBreak":true},{"text":"Hali mixi keren mu na naxan fe fanyi rabama.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Tinxintaree xaxili mu na?","poem":1},{"lineBreak":true},{"text":"E nu n ma ɲama tɔɔrɔ tun.","poem":1},{"lineBreak":true},{"text":"E mu Ala xilima feo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E fama sɛrɛnde gaaxui ra na nan ma,","poem":1},{"lineBreak":true},{"text":"barima Ala fama na mixi mɔɔlie rayensende, naxee wama wo tɔɔrɔfe.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nde kelima Siyon a xa Isirayila rakisi?","poem":1},{"lineBreak":true},{"text":"Ala na a xa ɲama ramini konyiya kui,","poem":1},{"lineBreak":true},{"text":"Yaxuba bɔnsɔɛ sɛɛwama nɛ, Isirayila ɲɛlɛxinma nɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}