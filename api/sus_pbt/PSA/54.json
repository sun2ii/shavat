{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":54,"content":[{"type":"heading","content":["N Marigi tima n bun ma"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa lɔnni bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba kɔra xui ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Sifikae to a fala Sɔlu bɛ a Dawuda a nɔxunxi e xɔnyi, Dawuda naxa yi bɛɛti ba.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Ala, n nakisi i xili ra, n ma kiiti sa i sɛnbɛ ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala, n ma dubɛ suxu, i tuli mati n ma wɔyɛnyi ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Xɔɲɛ ndee bara keli n xili ma,","poem":1},{"lineBreak":true},{"text":"mixi kobi naxee wama n faxafe.","poem":1},{"lineBreak":true},{"text":"E mu Ala kolon fefe ma. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala n malima, n Marigi tima n bun ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A n yaxuie xa kobiɲa sare ragbilenma e ma.","poem":1},{"lineBreak":true},{"text":"I xa e halaki i xa dugutɛgɛɲa kui.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N bara a ɲanige n xa sɛrɛxɛ ba i bɛ.","poem":1},{"lineBreak":true},{"text":"Alatala, n i xili tantuma nɛ barima i fan,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"i man n nakisima n ma tɔɔrɛ kui, n fa nɔ n yaxuie ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}