{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":56,"content":[{"type":"heading","content":["N mu gaaxuma sɔnɔn"]},{"type":"heading","content":["Ala maxandi nun Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa suuki bɛɛtibae xa mangɛ bɛ. A xa ba alɔ bɛɛti naxan xili, «Ganbɛ na wuri makuye fari.» A a ba Filisitakae a suxu tɛmui naxɛ Gati.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, hinnɛ n na barima mixie na n gerefe.","poem":1},{"lineBreak":true},{"text":"E gere tima n bɛ tɛmui birin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N yaxuie fɛɛɲɛnma gere ra.","poem":1},{"lineBreak":true},{"text":"Ala Xungbe, n gerefae bara wuya.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N na gaaxu tɛmui naxɛ, n nan n xaxili tima i tan nan na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N Ala xa masenyi matɔxɔma.","poem":1},{"lineBreak":true},{"text":"N mu gaaxuma sɔnɔn, barima n bara la Ala ra.","poem":1},{"lineBreak":true},{"text":"Ibunadama gbansan nɔma munse rabade n na?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tɛmui birin n yaxuie wama n tɔɔrɔfe e xa wɔyɛnyi ra.","poem":1},{"lineBreak":true},{"text":"N ma fefe mu rafanxi e ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E lanxi n ma ɲaxankatɛ ma,","poem":1},{"lineBreak":true},{"text":"e bira n fɔxɔ ra yire birin alako e xa n faxa.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I naxa tin e xa ratanga e xa fe ɲaaxie ma.","poem":1},{"lineBreak":true},{"text":"Ala, i xa xɔnɛ xa e rabira.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I n ma duniɲɛigiri kolon, i n yaye toxi.","poem":1},{"lineBreak":true},{"text":"N ma tɔɔrɛ birin sɛbɛxi i yi ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N na i xili tɛmui naxɛ, n yaxuie gbilenma nɛ n fɔxɔ ra.","poem":1},{"lineBreak":true},{"text":"N a kolon n nun Ala na a ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N Ala xa wɔyɛnyi matɔxɔma,","poem":1},{"lineBreak":true},{"text":"n Alatala xa masenyi matɔxɔma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N mu gaaxuma sɔnɔn, barima n bara la Ala ra.","poem":1},{"lineBreak":true},{"text":"Ibunadama gbansan nɔma munse rabade n na?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ala, n xa n ma laayidi rakamali i bɛ, n ma tantui sɛrɛxɛe ra,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"barima i bara n natanga faxɛ ma.","poem":1},{"lineBreak":true},{"text":"I mu tin n xa bira,","poem":1},{"lineBreak":true},{"text":"alako n xa ɲɛrɛ i xa kira xɔn ma yi bɛndɛ fuɲi fari.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":14}