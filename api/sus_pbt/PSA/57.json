{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":57,"content":[{"type":"heading","content":["N bara limaniya sɔtɔ"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa suuki bɛɛtibae xa mangɛ bɛ. A xa ba alɔ bɛɛti naxan xili «I naxa halaki ti.» Dawuda naxa yi ba a to a gi Sɔlu ma, a sa so fɔnmɛ kui.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, hinnɛ n na, yandi i xa hinnɛ n na.","poem":1},{"lineBreak":true},{"text":"N maratangɛ fenma i yire","poem":1},{"lineBreak":true},{"text":"alɔ tɔxɛyɔrɛ a fenma a nga gabutenyi bun ma ki naxɛ","poem":1},{"lineBreak":true},{"text":"han fe xɔrɔxɔɛ xa dangi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N bara Ala Xili Xungbe Kanyi maxandi","poem":1},{"lineBreak":true},{"text":"naxan n ma fe birin sɔɔnɛyama.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N xɔnmixie n ɲaxankatama tɛmui naxɛ,","poem":1},{"lineBreak":true},{"text":"Ala n nakisima nɛ kelife ariyanna, Ɲɛngi rate","poem":1},{"lineBreak":true},{"text":"a hinnɛ nun nɔndi ragoroma n ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yɛtɛe bara n nabilin,","poem":1},{"lineBreak":true},{"text":"n saxi e tagi, e tan naxee adamadie faxama.","poem":1},{"lineBreak":true},{"text":"E ɲinyie luxi alɔ tanbɛe,","poem":1},{"lineBreak":true},{"text":"e nɛnyie luxi alɔ santidɛgɛma naxan baxi a tɛɛ i.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala, i xa i xa binyɛ masen koore ma,","poem":1},{"lineBreak":true},{"text":"i xa a masen bɔxi ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E bara yɛlɛ ti n ya ra, a gbe mu luxi n xa so a ra.","poem":1},{"lineBreak":true},{"text":"E bara yili ge n ya ra, kɔnɔ e tan nan biraxi a kui. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala, n bɔɲɛ bara limaniya, n bara limaniya sɔtɔ.","poem":1},{"lineBreak":true},{"text":"N bɛɛti bama nɛ, n i tantuma nɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N bɔɲɛ bara keli n na,","poem":1},{"lineBreak":true},{"text":"n xa n ma kɔrae tongo, n xa bɛɛti ba han subaxɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Marigi, n i tantuma nɛ sie tagi.","poem":1},{"lineBreak":true},{"text":"N bɛɛti bama nɛ i bɛ bɔnsɔɛe tagi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I xa hinnɛ koore lima nɛ,","poem":1},{"lineBreak":true},{"text":"i xa tinxinyi tema nɛ han nuxuie.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala, i xa i xa binyɛ masen koore ma,","poem":1},{"lineBreak":true},{"text":"i xa a masen bɔxi ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}