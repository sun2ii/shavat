{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":58,"content":[{"type":"heading","content":["Adamadie sare"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa suuki bɛɛtibae xa mangɛ bɛ. A xa ba alɔ bɛɛti naxan xili «I naxa kasarɛ ti».","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Wo xa wɔyɛnyi mu tinxin.","poem":1},{"lineBreak":true},{"text":"Adamadie, wo nɔma kiiti sade nɔndi ra?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ade, wo fe ɲaaxi rabama wo bɔɲɛ kui,","poem":1},{"lineBreak":true},{"text":"wo fe ɲaaxi rabama yi bɔxi ma,","poem":1},{"lineBreak":true},{"text":"wo mixi ratantanma duniɲa ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kafi e bari tɛmui,","poem":1},{"lineBreak":true},{"text":"e findixi mixi ɲaaxi nan na.","poem":1},{"lineBreak":true},{"text":"Wule falɛe bara lɔɛ kabi e bari lɔxɔɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E xa xɔnɛ luxi nɛ alɔ bɔximase xɔnɛ,","poem":1},{"lineBreak":true},{"text":"alɔ bɔximase naxan mu bɔximase suxui xui ramɛma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hali bɔximase suxui fanyi, a mu nɔma a suxude.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ala, i xa e ɲinyi kana e dɛ i, barima e luxi nɛ alɔ yɛtɛ.","poem":1},{"lineBreak":true},{"text":"Alatala, i xa e dɛ wanwan.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"E ɲɔnma nɛ alɔ ye naxan ifilima bɔxi.","poem":1},{"lineBreak":true},{"text":"E xa tanbɛ mu ɲɛrɛma sɛnbɛ ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A luma alɔ boe naxan fate lɔɛma lingi kui.","poem":1},{"lineBreak":true},{"text":"A luma alɔ di naxan baxi a nga fate i, a mu foye to.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Beenun tunde xa fura yege malinsinxi ra,","poem":1},{"lineBreak":true},{"text":"xa na mu a ra yege xare ra,","poem":1},{"lineBreak":true},{"text":"Ala e kɔma nɛ, a e wɔlɛ a i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mixi tinxinxi fama ɲɛlɛxinde barima a fama gbeɲɔxɔɛ sɔtɔde.","poem":1},{"lineBreak":true},{"text":"A fama a sanyi maxade mixi ɲaaxi wuli ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Adamadie fama a falade, «Iyo, Ala mixi tinxinxi sare fima.","poem":1},{"lineBreak":true},{"text":"Iyo, Ala kiiti sama nɛ duniɲa ma.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}