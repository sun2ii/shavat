{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":6,"content":[{"type":"heading","content":["Furema wa xui"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba kɔra luuti solomasaxan xui ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, i naxa n ɲaxankata i xa xɔnɛ kui,","poem":1},{"lineBreak":true},{"text":"i naxa n tɔɔrɔ i xa bɔɲɛ te kui.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Alatala, hinnɛ n na, n bara halaki.","poem":1},{"lineBreak":true},{"text":"Alatala, n nayalan, n xɔrie na sɛrɛnfe nɛ yi ki.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N nii birin na sɛrɛnfe tɔɔrɛ ra.","poem":1},{"lineBreak":true},{"text":"Alatala, han tɛmui mundun fa?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, fa n nii rakisi.","poem":1},{"lineBreak":true},{"text":"N natanga i xa fonisireya xa fe ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mixi mu nɔma ratude i ma gaburi kui.","poem":1},{"lineBreak":true},{"text":"Nde nɔma i tantude aligiyama?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N bara tɔɔrɔ han n sɛnbɛ birin bara ɲɔn.","poem":1},{"lineBreak":true},{"text":"Kɔɛ yo kɔɛ n wama, han n ma sade birin bunda n ya ye ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sunnunyi bara n ya mafɔɔrɔ.","poem":1},{"lineBreak":true},{"text":"N mu sese tofe n yaxuie xa gboe xa fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wo wo masiga n na, wo tan tinxintaree, barima n wa xui bara Alatala li.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Alatala bara n ma maxandi mɛ. Alatala bara n ma dubɛ suxu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N yaxuie birin yaagima nɛ, han e e gi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}