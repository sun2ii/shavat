{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":60,"content":[{"type":"heading","content":["Ala fama xunnakeli ra"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa lɔnni suuki bɛɛtibae xa mangɛ bɛ. A xa ba alɔ bɛɛti naxan xili «Fuge tofanyi alɔ Ala xa saatɛ.»","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Isirayila to Sirenikae gere, e yi bɛɛti ba na tɛmui nɛ. E nu kelixi Mesopotamiya nun Soba bɔxi ma. Yowaba naxa Edonka wulu fu nun firin faxa fole kui fɔxɔɛ na dɛnnaxɛ.","descriptive":true}]},{"type":"verse","number":3,"content":[{"text":"Ala, i bara muxu ralɔɛ,","poem":1},{"lineBreak":true},{"text":"i bara nde ba muxu xa gali ra,","poem":1},{"lineBreak":true},{"text":"i bara xɔnɔ muxu ma,","poem":1},{"lineBreak":true},{"text":"kɔnɔ yakɔsi, i xa sɛnbɛ fi muxu ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I bara bɔxi rasɛrɛn,","poem":1},{"lineBreak":true},{"text":"i bara a ibɔɔ.","poem":1},{"lineBreak":true},{"text":"I xa na yailan muxu bɛ","poem":1},{"lineBreak":true},{"text":"barima bɔxi wama kanafe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I bara fe xɔrɔxɔɛe dɔxɔ i xa mixie ma,","poem":1},{"lineBreak":true},{"text":"han e bara lu alɔ siisila.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɔnɔ naxee gaaxuxi i ya ra,","poem":1},{"lineBreak":true},{"text":"i bara tɔnxuma so e yi ra,","poem":1},{"lineBreak":true},{"text":"e xa nɔ e yaxuie ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I xa i xanuntenyie rakisi i sɛnbɛ ra,","poem":1},{"lineBreak":true},{"text":"i xa muxu xa dubɛ suxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ala xa masenyi nan ya,","poem":1},{"lineBreak":true},{"text":"a naxan falaxi hɔrɔmɔbanxi sɛniyɛnxi kui,","poem":1},{"lineBreak":true},{"text":"«N Sikemi taa fima nɛ wo ma xunnakeli kui,","poem":1},{"lineBreak":true},{"text":"n Sukɔti geya lanbanyi fan fi wo ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Galadi bɔxi, n gbe. Manasi bɔxi, n gbe.","poem":1},{"lineBreak":true},{"text":"Efiramikae nan findima n ma geresoe ra.","poem":1},{"lineBreak":true},{"text":"N mangɛ dɔxɔma nɛ Yudaya.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mowabakae findima n ma konyie nan na.","poem":1},{"lineBreak":true},{"text":"Edon findi n ma bɔxi ra.","poem":1},{"lineBreak":true},{"text":"N gere xui ratema nɛ Filisita.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ala, nde nɔma n xaninde na taa makantaxi kui?","poem":1},{"lineBreak":true},{"text":"Nde nɔma n xaninde han Edon bɔxi ma?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I tan gbansan, i tan naxan muxu ralɔɛ,","poem":1},{"lineBreak":true},{"text":"i tan naxan mu nu na muxu xa sɔɔrie sɛɛti ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Muxu mali muxu yaxuie gerede.","poem":1},{"lineBreak":true},{"text":"Adamadi xa mali, sese mu a ra,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"kɔnɔ Ala xa mali tan fama muxu yaxui birin halakide.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":14}