{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":62,"content":[{"type":"heading","content":["Ala xa bɔɲɛsa"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ Yedutun bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N bɔɲɛ saxi Ala nan saabui ra,","poem":1},{"lineBreak":true},{"text":"n ma kisi fatanxi a tan nan na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A luxi n bɛ alɔ fanye,","poem":1},{"lineBreak":true},{"text":"n ma marakisima nun n makantama nan a ra.","poem":1},{"lineBreak":true},{"text":"N mu nɔma birade sɔnɔn.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wo dutunma mixie ma han mun tɛmui,","poem":1},{"lineBreak":true},{"text":"wo xa e rabira, alɔ banxi nun tɛtɛ fori?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E wule falama alako e xa mixie ba yire fanyi e nu dɛnnaxɛ.","poem":1},{"lineBreak":true},{"text":"E dubɛ tima e dɛ ra, kɔnɔ e dankɛ tan tima e bɔɲɛ ra. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N bɔɲɛsa sɔtɔma Ala nan na,","poem":1},{"lineBreak":true},{"text":"barima n xaxili tixi a tan nan na.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A luxi alɔ fanye na a ra n bɛ,","poem":1},{"lineBreak":true},{"text":"n ma marakisima nun n ma makantama nan a ra.","poem":1},{"lineBreak":true},{"text":"N mu nɔma birade sɔnɔn.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N ma kisi nun n ma binyɛ na Ala nan yi.","poem":1},{"lineBreak":true},{"text":"Ala n makantama nan a ra,","poem":1},{"lineBreak":true},{"text":"n yigi tide nan a ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ɲama, wo xa wo taxu a ra,","poem":1},{"lineBreak":true},{"text":"wo xa wo xa kɔntɔfili masen a bɛ.","poem":1},{"lineBreak":true},{"text":"A tan nan nɔma won malide. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Adamadie luma alɔ foye naxan dangima.","poem":1},{"lineBreak":true},{"text":"Mixi xungbe findima mixi xuri ra,","poem":1},{"lineBreak":true},{"text":"Xa e xa fe bara maniya,","poem":1},{"lineBreak":true},{"text":"a yelebu alɔ foye.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wo naxa harige fen fe kobi ra,","poem":1},{"lineBreak":true},{"text":"wo naxa a fen muɲɛ ra.","poem":1},{"lineBreak":true},{"text":"Xa wo xa naafuli sa gbo,","poem":1},{"lineBreak":true},{"text":"wo naxa wo xaxili ti na ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Ala bara fe firin fala n naxee mɛxi.","poem":1},{"lineBreak":true},{"text":"Keren, sɛnbɛ na Ala bɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A firin nde, n Marigi nan hinnɛnte ra,","poem":1},{"lineBreak":true},{"text":"barima a mixie sare ragbilenma e ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}