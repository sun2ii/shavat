{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":63,"content":[{"type":"heading","content":["Ala xa hinnɛ fan simaya bɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti, a naxan ba Yudaya, a to nu gbengberenyi ma tɛmui naxɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala nan n Marigi ra.","poem":1},{"lineBreak":true},{"text":"Ala n i fenma, barima n hayi na i ma,","poem":1},{"lineBreak":true},{"text":"alɔ fate hayi to na ye ma gbengberenyi ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N luma i xa hɔrɔmɔbanxi kui","poem":1},{"lineBreak":true},{"text":"alako n xa i sɛnbɛ nun i xa binyɛ to.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I xa hinnɛ fan simaya bɛ.","poem":1},{"lineBreak":true},{"text":"N bara i matɔxɔ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N i tantuma n ma simaya birin kui,","poem":1},{"lineBreak":true},{"text":"n nan n bɛlɛxɛe itema i mabiri.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N bɔnsɔɛ wasama nɛ i tantufe ra sɛɛwɛ kui.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N na n sa n i xa fe maɲɔxunma kɔɛ birin,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"barima i tan nan n malima.","poem":1},{"lineBreak":true},{"text":"N sɛɛwama nɛ i niini bun ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N nii bara fatu i ma, i bɛlɛxɛ luma nɛ n bun ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Naxee katama n faxade, e tan nan faxama.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Santidɛgɛma fama nɛ e sɔxɔde,","poem":1},{"lineBreak":true},{"text":"wulai baree fa e ibɔɔde.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Mangɛ sɛɛwama nɛ Ala xa fe ra.","poem":1},{"lineBreak":true},{"text":"Naxee e kalima Ala xili ra, nee fama nɛ a matɔxɔde.","poem":1},{"lineBreak":true},{"text":"Kɔnɔ wule falɛe dɛe balanma nɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}