{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":64,"content":[{"type":"heading","content":["Adama xa maɲɔxunyi tilin"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, i tuli mati n wa xui ra,","poem":1},{"lineBreak":true},{"text":"N natanga n yaxuie ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N nɔxun mixi ɲaaxie ma","poem":1},{"lineBreak":true},{"text":"naxee wama n tɔɔrɔfe tinxintareya kui.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E dɛ xaaɲɛ alɔ santidɛgɛma,","poem":1},{"lineBreak":true},{"text":"e xa wɔyɛn ɲaaxie luma alɔ tanbɛe.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E mu gaaxuma tinxintɔɛ ya ra,","poem":1},{"lineBreak":true},{"text":"e luma a ɲaxankata ra tun.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E dɛ kobi, e yɛlɛ italama mixi ya ra.","poem":1},{"lineBreak":true},{"text":"E naxɛ, «Nde na kolonma?»","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E yanfanteya yailanma, e a fala,","poem":1},{"lineBreak":true},{"text":"«Won xa keli a yanfa xili ma. A sɔɔnɛyama nɛ.»","poem":1},{"lineBreak":true},{"text":"Adama xa maɲɔxunyi tilin.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɔnɔ Ala na tanbɛe woli, e e lima nɛ keren na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"E bara wule fala.","poem":1},{"lineBreak":true},{"text":"Naxee e toma, e e gima nɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na gaaxui adama birin suxuma nɛ.","poem":1},{"lineBreak":true},{"text":"E Ala xa wali masenma,","poem":1},{"lineBreak":true},{"text":"e a xa wali kolonma nɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Tinxintɔɛ sɛɛwama nɛ Alatala ra,","poem":1},{"lineBreak":true},{"text":"a fa lu a niini bun ma.","poem":1},{"lineBreak":true},{"text":"Sondon fanyi kanyi ɲɛlɛxinma nɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}