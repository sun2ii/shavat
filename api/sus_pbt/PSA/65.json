{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":65,"content":[{"type":"heading","content":["Saabui fanyi"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Matɔxɔɛ na i tan Ala bɛ Siyoni geya fari.","poem":1},{"lineBreak":true},{"text":"Muxu laayidi naxan tongoxi i bɛ,","poem":1},{"lineBreak":true},{"text":"muxu na birin nakamalima nɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala, i muxu xa maxandi birin mɛma nɛ.","poem":1},{"lineBreak":true},{"text":"Duniɲa birin fama nɛ birade i fɔxɔ ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Tantanyi to nɔ muxu ra, i bara muxu xa yunubi xafari.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I naxan sugandima a xa makɔrɛ i xa salide ra,","poem":1},{"lineBreak":true},{"text":"na ɲɛlɛxinma nɛ barima a buma nɛ i xɔnyi.","poem":1},{"lineBreak":true},{"text":"Muxu bara wasa i xa fe fanyi ra,","poem":1},{"lineBreak":true},{"text":"fe sɛniyɛnxi naxan kelixi i xa hɔrɔmɔlingira.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I muxu xa maxandi yaabima kaabanako nun tinxinyi ra.","poem":1},{"lineBreak":true},{"text":"Ala, i bara findi muxu rakisima ra.","poem":1},{"lineBreak":true},{"text":"Duniɲa yire birin xaxili tixi i ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I bara geya daa i sɛnbɛ ra","poem":1},{"lineBreak":true},{"text":"barima sɛnbɛma nan i ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I bara baa xui radundu, mɔrɔnyi xui mu na.","poem":1},{"lineBreak":true},{"text":"I bara ɲama fan masabari.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Duniɲa birin gaaxuma nɛ i xa kaabanakoe ya ra.","poem":1},{"lineBreak":true},{"text":"Kelife sogetede han sogegorode,","poem":1},{"lineBreak":true},{"text":"e birin e ɲɛlɛxin xui raminima nɛ i xa fe ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I bɔxi mɛɛni, a a rafe fe fanyi ra.","poem":1},{"lineBreak":true},{"text":"I xure rafema ye ra alako mixie xa baloe sɔtɔ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I tunɛ ye sama bɔxi ma alako bɔxi xa bɔrɔxɔ sansi bɛ.","poem":1},{"lineBreak":true},{"text":"I barakɛ sama xɛ ma, a xa fan.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xɛ xaba tɛmui i fe fanyi raminima nɛ.","poem":1},{"lineBreak":true},{"text":"I xa sansi sase rafema nɛ, han a fili a ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Gbengberenyi fiilie nun geyae fanma nɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xurusee yiriwama nɛ fiili ma.","poem":1},{"lineBreak":true},{"text":"Sansi yiriwama nɛ geya bunyie.","poem":1},{"lineBreak":true},{"text":"Na birin, Ala xa fe fanyi nan masenma won bɛ sɛɛwɛ kui.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":14}