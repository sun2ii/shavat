{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":66,"content":[{"type":"heading","content":["Ala xa kaabanakoe magaaxu"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"hebrew_subtitle","content":["Bɛɛti nun suuki bɛɛtibae xa mangɛ bɛ"]},{"type":"verse","number":1,"content":[{"text":"Adamadie birin xui xa ite sɛɛwɛ ra Ala bɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wo xa a xili binya bɛɛti ra,","poem":1},{"lineBreak":true},{"text":"wo xa a binya matɔxɔɛ ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wo xa a fala Ala bɛ,","poem":1},{"lineBreak":true},{"text":"«I xa kaabanakoe magaaxu.","poem":1},{"lineBreak":true},{"text":"I sɛnbɛ gbo han. Hali i yaxuie sɛrɛnma i ya ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Duniɲa birin i batuma,","poem":1},{"lineBreak":true},{"text":"e i binya bɛɛti ra, e i xili matɔxɔ.» Ɲɛngi rate.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wo fa Ala xa wali matode.","poem":1},{"lineBreak":true},{"text":"A na fe raba adamadie tagi, na magaaxu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A baa findi xare ra,","poem":1},{"lineBreak":true},{"text":"a mixi ragiri xure ma e sanyi xaraxi ra.","poem":1},{"lineBreak":true},{"text":"Na kui, won ɲɛlɛxinma nɛ a ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A duniɲa yamarima sɛnbɛ ra abadan.","poem":1},{"lineBreak":true},{"text":"A ya tixi sie ra, matandilae mu nɔma kelide sɔnɔn. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Sie, wo xa won Marigi Ala tantu,","poem":1},{"lineBreak":true},{"text":"wo xa wo xui ramini a matɔxɔfe ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A bara simaya fi won ma,","poem":1},{"lineBreak":true},{"text":"a mu tin won xa bira,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"barima Ala won bɔɲɛ kolon.","poem":1},{"lineBreak":true},{"text":"A bara won mato alɔ mixi gbeti matoma ki naxɛ","poem":1},{"lineBreak":true},{"text":"a a raxunu alako a gbi xa ba.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I bara muxu xun ti yɛlɛ kui ra,","poem":1},{"lineBreak":true},{"text":"i man bara kote dɔxɔ muxu xun ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I bara a lu mixie xa nɔ muxu ra,","poem":1},{"lineBreak":true},{"text":"muxu xa tɔɔrɔ ye nun tɛ xɔɔra.","poem":1},{"lineBreak":true},{"text":"Kɔnɔ a raɲɔnyi, i bara muxu xun ti daxamui yire ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N fama sɛrɛxɛ gan daaxi ra i xa banxi kui,","poem":1},{"lineBreak":true},{"text":"n nan n ma laayidi rakamalima nɛ,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"n naxee fala n dɛ ra n nu tɔɔrɛ kui tɛmui naxɛ.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N xuruse turaxie bama nɛ sɛrɛxɛ gan daaxi ra,","poem":1},{"lineBreak":true},{"text":"alɔ yɛxɛɛ kontonyie, tuurae, nun si donbie. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Wo fa, wo xa wo tuli mati,","poem":1},{"lineBreak":true},{"text":"wo tan naxee gaaxuma Ala ya ra.","poem":1},{"lineBreak":true},{"text":"N xa a masen Ala naxan nabaxi n bɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"N bara a xili, n bara a matɔxɔ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Xa yanfanteya nu na n bɔɲɛ kui nu,","poem":1},{"lineBreak":true},{"text":"n Marigi mu nu a tuli matima n na.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kɔnɔ Ala bara n xui ramɛ,","poem":1},{"lineBreak":true},{"text":"a n ma dubɛ suxu.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tantui na Ala bɛ naxan bara n ma maxandi xui mɛ,","poem":1},{"lineBreak":true},{"text":"a man bara hinnɛ n na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}