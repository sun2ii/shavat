{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":7,"content":[{"type":"heading","content":["Kiitisa fanyi nan na Ala ra"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti mɔɔli nde Alatala bɛ Kusi Bunyaminka xa fe ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N Marigi Alatala, i tan nan na n kantama ra.","poem":1},{"lineBreak":true},{"text":"N natanga n yaxuie ma, n ba e yi ra,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"e naxa n faxa alɔ yɛtɛ mixi faxama ki naxɛ.","poem":1},{"lineBreak":true},{"text":"A na naxan suxu, na mu bama a yi ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N Marigi Alatala,","poem":1},{"lineBreak":true},{"text":"xa n bara kɔbiri ramuruta,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"xa n bara fe ɲaaxi raba mixi ra,","poem":1},{"lineBreak":true},{"text":"muxu nun naxan dɔxɔxi bɔɲɛsa kui,","poem":1},{"lineBreak":true},{"text":"xa n bara n gerefa muɲa tɔɔɲɛgɛ kui,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"n yaxuie xa n keri, e xa n masɔtɔ,","poem":1},{"lineBreak":true},{"text":"e xa n maboron, e n faxa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alatala, n mali,","poem":1},{"lineBreak":true},{"text":"i bɔɲɛ xa te n yaxuie ma.","poem":1},{"lineBreak":true},{"text":"N dɛmɛn, sɛriyɛ na i tan naxan yi ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I xa nɔɛ xa lu ɲamae xun,","poem":1},{"lineBreak":true},{"text":"e xa lu i xa yaamari bun ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Alatala, ɲamae makiiti.","poem":1},{"lineBreak":true},{"text":"Alatala, n ma nɔndi makɛnɛn e bɛ","poem":1},{"lineBreak":true},{"text":"n ma tinxinyi nun n ma sɛriyɛ bɛrɛ ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Danyi sa fe kobi rabae xa fe ma.","poem":1},{"lineBreak":true},{"text":"Sɛnbɛ fi mixi tinxinxie ma","poem":1},{"lineBreak":true},{"text":"i tan, Ala naxan tinxin,","poem":1},{"lineBreak":true},{"text":"naxan birin sondon ma fe kolon.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ala, n kantama na i tan nan na,","poem":1},{"lineBreak":true},{"text":"naxan mixi tinxinxi rakisima.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kiitisa fanyi nan na Ala ra,","poem":1},{"lineBreak":true},{"text":"naxan xɔnɔma tinxintaree ma tɛmui birin.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Xa mixi ɲaaxie mu gbilen e yuge fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"Ala a xa santidɛgɛma raluganma nɛ,","poem":1},{"lineBreak":true},{"text":"a a xa xali maxiri.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ala na faxatise yailanma mixi ɲaaxie nan xili ma,","poem":1},{"lineBreak":true},{"text":"a a xa tanbɛe dɛ findi tɛ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mixi ɲaaxi luma fe ɲaaxi nan tun naba ra.","poem":1},{"lineBreak":true},{"text":"A a ɲɔxɔ sa a xɔn ma han a findi a ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"A yili gema han a tilin,","poem":1},{"lineBreak":true},{"text":"a fa bira a yɛtɛ xa yili gexi kui.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"A xa fe ɲaaxi nun a xa geregiri bara gbilen a ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"N Alatala tantuma nɛ a xa tinxinyi xa fe ra.","poem":1},{"lineBreak":true},{"text":"N suuki bama nɛ Alatala xili ra, Ala xili xungbe kanyi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":18}