{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":70,"content":[{"type":"heading","content":["Ala fenmae xa sɛɛwa"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa maxandi bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala, n nakisi! Alatala, fa n mali mafuren.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ala xa mixie rayaagi naxee wama n faxafe.","poem":1},{"lineBreak":true},{"text":"Ala xa e keri, Ala xa e ya ifu, naxee wama n tɔɔrɔfe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ala xa e keri yaagi kui, naxee a falama n bɛ, «I xa tɔɔrɔ!»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I fenmae xa sɛɛwa.","poem":1},{"lineBreak":true},{"text":"Naxee wama i xa kisi xɔn, e xa Ala matɔxɔ tɛmui birin.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ala, n findixi misikiinɛ nun tɔɔrɔmixi nan na,","poem":1},{"lineBreak":true},{"text":"fa n mali, i naxa dugundi.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}