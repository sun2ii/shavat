{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":72,"content":[{"type":"heading","content":["Isirayila mangɛ"]},{"type":"heading","content":["Ala maxandi"]},{"type":"hebrew_subtitle","content":["Sulemani gbe"]},{"type":"verse","number":1,"content":[{"text":"Ala, i xa a niya mangɛ xa kiiti tinxinxi sa.","poem":1},{"lineBreak":true},{"text":"I xa tinxinyi xa lu mangɛ xa di dɛ i.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Na kui a xa i xa ɲama makiiti nɔndi ra,","poem":1},{"lineBreak":true},{"text":"a xa tinxin tɔɔrɔmixie bɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Masenyi xa ti geyae fari, ɲama bɔɲɛ saxi ra,","poem":1},{"lineBreak":true},{"text":"xibaarui xa yensen bɔxi ma, tinxinyi nan ɲama yamarima.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mangɛ xa sɛriyɛ raba tɔɔrɔmixie bɛ,","poem":1},{"lineBreak":true},{"text":"a xa setare xa die rakisi, a xa e gerefae rayensen.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mixie xa gaaxu i ya ra abadan,","poem":1},{"lineBreak":true},{"text":"danmi soge nun kike yanbama.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mangɛ xa lu alɔ tunɛ naxan birama xɛe ma, naxan bɔxi rafanma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tinxintɔɛ xa fe fanma na waxati nɛ,","poem":1},{"lineBreak":true},{"text":"danmi kike yanbama, bɔɲɛsa gboma nɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A xa mangɛya gboma nɛ,","poem":1},{"lineBreak":true},{"text":"sa fɔlɔ sogetede han a sa dɔxɔ sogegorode ra,","poem":1},{"lineBreak":true},{"text":"a fɔlɔ Efirati xure ma han sa dɔxɔ bɔxi danyi ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Mixi naxee na wula i, e xinbi sinma nɛ a bun ma,","poem":1},{"lineBreak":true},{"text":"a yaxuie lu a sanyi bun ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tarasisi mangɛe nun Suri mangɛe fama nɛ buɲae ra.","poem":1},{"lineBreak":true},{"text":"Seeba nun Seba mangɛe fan duuti fima nɛ a ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mangɛ birin e xinbi sinma nɛ a bun ma,","poem":1},{"lineBreak":true},{"text":"sie birin lu a xa yaamari bun ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Na kui setaree fama nɛ a xilide marakisima.","poem":1},{"lineBreak":true},{"text":"A misikiinɛ sɛnbɛtare malima nɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A kinikinima nɛ sɛnbɛtaree nun setaree ma,","poem":1},{"lineBreak":true},{"text":"a tɔɔrɔmixie rakisi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A e xɔrɛyama nɛ maifui nun fe kobie ma,","poem":1},{"lineBreak":true},{"text":"barima e findixi a xanuntenyie nan na.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A xa mangɛya xa bu!","poem":1},{"lineBreak":true},{"text":"A Seeba bɔxi xa xɛɛma sɔtɔma nɛ.","poem":1},{"lineBreak":true},{"text":"Mixie xa Ala maxandi a bɛ tɛmui birin,","poem":1},{"lineBreak":true},{"text":"e naxa tagan dubade a bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ala donse yiriwama nɛ bɔxi kui.","poem":1},{"lineBreak":true},{"text":"Geyae rafema nɛ sansie ra,","poem":1},{"lineBreak":true},{"text":"e bogie lu alɔ sansi bogi naxee na Liban.","poem":1},{"lineBreak":true},{"text":"Mixie gboma nɛ taa kui alɔ bɔxi sɛxɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Mangɛ Ala xili gbo abadan!","poem":1},{"lineBreak":true},{"text":"Dan mu na a xili ma soge bun ma.","poem":1},{"lineBreak":true},{"text":"Si birin barakɛ sɔtɔma nɛ a saabui ra,","poem":1},{"lineBreak":true},{"text":"e fa a matɔxɔ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Isirayila Marigi Alatala tantu.","poem":1},{"lineBreak":true},{"text":"A keren nan kaabanakoe rabama.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"A xili xungbe xa tantu abadan.","poem":1},{"lineBreak":true},{"text":"Duniɲa birin xa a xa binyɛ kolon.","poem":1},{"lineBreak":true},{"text":"Amina! Amina!","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Yisayi xa di Dawuda xa maxandie raɲɔnyi nan na ki.","descriptive":true}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}