{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":75,"content":[{"type":"heading","content":["Ala xa kiiti"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Asafi xa bɛɛti bɛɛtibae mangɛ bɛ. A xa ba alɔ bɛɛti naxan xili «I naxa kasarɛ ti.»","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Muxu Marigi Ala, muxu bara i matɔxɔ.","poem":1},{"lineBreak":true},{"text":"Matɔxɔɛ na i bɛ, i tan naxan na muxu sɛɛti ma,","poem":1},{"lineBreak":true},{"text":"i tan naxan xa kaabanakoe falama yire birin.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I naxɛ, «N ma waxati sugandixi na a li,","poem":1},{"lineBreak":true},{"text":"n tan nan kiiti sama tinxinyi ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Duniɲa nun a xa mixie fama xunude,","poem":1},{"lineBreak":true},{"text":"kɔnɔ n tan nan a kinkie sɛnbɛ soma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N a falama yɛtɛ igboe nun mixi kobie bɛ,","poem":1},{"lineBreak":true},{"text":"‹Wo naxa wo yɛtɛ igbo, wo naxa wo xunyi ite.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wo naxa wo xunyi ite koore ma,","poem":1},{"lineBreak":true},{"text":"wo ba yɛtɛ igboɲa wɔyɛnyi falafe ra.›»","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wo xa a kolon xunnakeli mu kelima sogetede,","poem":1},{"lineBreak":true},{"text":"a mu kelima sogegorode, a mu kelima gbengberenyi ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala nan kiiti sama, a mixi nde xa fe ragoro, a mixi nde xa fe ite.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Tɔnbili nde na Alatala xɔnyɛ,","poem":1},{"lineBreak":true},{"text":"wɛni xaaɲɛ rafalaxi na naxan kui.","poem":1},{"lineBreak":true},{"text":"A na soma duniɲa mixi ɲaaxie nan yi, e a min han a ɲɔn.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N na masenyi tima tɛmui birin,","poem":1},{"lineBreak":true},{"text":"n Yaxuba Marigi Ala matɔxɔma bɛɛti ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"«N mixi ɲaaxie xa yɛtɛ igboɲa xun nakanama nɛ,","poem":1},{"lineBreak":true},{"text":"n tinxintɔɛe xun nakeli.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}