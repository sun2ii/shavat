{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":76,"content":[{"type":"heading","content":["Ala xa xunnakeli"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Asafi xa bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba kɔra xui ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ala kolonxi Yudaya bɔxi ma, a xili gbo Isirayila.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A xɔnyi na Salamu, a xa banxi na Siyon.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A geresosee alɔ xalie, wure lefae, nun santidɛgɛmae kana mɛnni nɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I xa nɔrɛ gbo alɔ koyinma,","poem":1},{"lineBreak":true},{"text":"naxan gbilen kelife geyae ma, subee wuya dɛnnaxɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I bara nɔ sɛnbɛmae ra, naxee mu xunuma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"naxee mu nɔ gere tide i kanke.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I tan Yaxuba Marigi Ala to keli e xili ma,","poem":1},{"lineBreak":true},{"text":"e xa soe ragie nun e xa soe naxa halaki.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I magaaxu! I xa xɔnɛ kui, nde suusama i ya ra?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I to kiiti sa koore ma, duniɲa naxa sabari gaaxui kui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"I xa kiiti naxa tɔɔrɔmixie rakisi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I xa xɔnɛ ibunadama mabiri findixi i matɔxɔɛ nan na.","poem":1},{"lineBreak":true},{"text":"I xa bɔɲɛte luxi nɛ alɔ bɛlɛti i i tagi ixirima naxan na gere kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wo xa wo xa daakan nakamali wo Marigi Alatala bɛ,","poem":1},{"lineBreak":true},{"text":"wo xa fa sɛrɛxɛe ra a xɔn ma,","poem":1},{"lineBreak":true},{"text":"wo tan naxee birin a rabilinxi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A tan nan ɲɛngi bama sɛnbɛmae fate i,","poem":1},{"lineBreak":true},{"text":"a magaaxu duniɲa mangɛe bɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}