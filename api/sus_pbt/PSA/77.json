{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":77,"content":[{"type":"heading","content":["Ala xa maratangɛ mu masarama"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Asafi xa bɛɛti bɛɛtibae xa mangɛ Yedutun bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"N nan n xui ratefe Ala nan ma.","poem":1},{"lineBreak":true},{"text":"A a tuli matima nɛ n xui ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Lɔxɔ xɔrɔxɔɛe na fa n ma, n nan n Marigi xilima nɛ.","poem":1},{"lineBreak":true},{"text":"Kɔɛ ra, n nan n bɛlɛxɛ itala a bɛ, kɔnɔ n mu madundui sɔtɔma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N nan n natu Ala ma, n wa n bɔɲɛ ma.","poem":1},{"lineBreak":true},{"text":"N nan n maɲɔxun a ma, limaniya ba n yi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"I mu tinma n xa xi.","poem":1},{"lineBreak":true},{"text":"N xaxili ifuxi, ɲan n mu nɔma wɔyɛnde.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N nan n maɲɔxunma waxati dangixie ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N nan n natuma nee ma n ma bɛɛtie saabui ra.","poem":1},{"lineBreak":true},{"text":"N nan n yɛtɛ maxɔrin,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"«N Marigi mɛɛma nɛ ibunadama ra abadan?","poem":1},{"lineBreak":true},{"text":"A mu hinnɛma mixie ra sɔnɔn?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Danyi na a xa fanyi ma?","poem":1},{"lineBreak":true},{"text":"A tondima a xa laayidie kamalide?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A bara nɛɛmu a xa hinnɛ ma?","poem":1},{"lineBreak":true},{"text":"A xa xɔnɛ bara nɔ a xa kinikini ra?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N ma tɔɔrɛ kui a luma n bɛ","poem":1},{"lineBreak":true},{"text":"alɔ Ala Xili Xungbe Kanyi na masarafe.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"A lanma n xa ratu Alatala xa walie ma,","poem":1},{"lineBreak":true},{"text":"a xa kaabanakoe a naxee rabaxi tɛmui dangixi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N nan n xaxili rasigama nɛ i xa kɛwali birin ma,","poem":1},{"lineBreak":true},{"text":"n nan n maɲɔxunma nɛ i xa walie ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ala, i xa kira sɛniyɛn.","poem":1},{"lineBreak":true},{"text":"Ala gbɛtɛ mu na, i maniyɛ mu na!","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I tan Ala nan kaabanakoe rabama,","poem":1},{"lineBreak":true},{"text":"i fe magaaxuxie masen ɲamanɛe tagi.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I i xa ɲama xun saraxi i sɛnbɛ nan na,","poem":1},{"lineBreak":true},{"text":"Yaxuba nun Yusufu xa mamadie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ala, baa xungbe to i to,","poem":1},{"lineBreak":true},{"text":"a dulonyi naxa sɛrɛn.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Nuxuie naxa ye gbegbe ragoro,","poem":1},{"lineBreak":true},{"text":"galanyi naxa bula koore ma,","poem":1},{"lineBreak":true},{"text":"seyamakɔnyie naxa lu alɔ tanbɛ wolixie.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I xa sarinyi xui naxa bula,","poem":1},{"lineBreak":true},{"text":"seyamakɔnyi naxa duniɲa iyalan,","poem":1},{"lineBreak":true},{"text":"bɔxi naxa a imaxa, a sɛrɛn.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"I naxa kira rabɔɔ baa ma,","poem":1},{"lineBreak":true},{"text":"i dangi ye xungbe tagi, kɔnɔ i fɔxi mu to.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"I naxa i xa ɲama raɲɛrɛ alɔ xuruse gɔɔrɛ","poem":1},{"lineBreak":true},{"text":"Annabi Munsa nun Haruna saabui ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":21}