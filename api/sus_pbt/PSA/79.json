{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":79,"content":[{"type":"heading","content":["Ala gbeɲɔxɔfe"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Asafi xa bɛɛti","descriptive":true},{"text":"Ala, sie bara so i xa bɔxi kui,","poem":1},{"lineBreak":true},{"text":"e i xa hɔrɔmɔlingira findi yire sɛniyɛntare ra,","poem":1},{"lineBreak":true},{"text":"e Darisalamu kana.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"E bara i xa konyie furee findi xɔnie xa baloe ra,","poem":1},{"lineBreak":true},{"text":"e bara i xanuntenyie so wulai sube yi ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E bara e sɔntɔ Darisalamu rabilinyi, e mu ragata.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Si naxee na muxu rabilinyi e muxu konbima,","poem":1},{"lineBreak":true},{"text":"e yoma muxu ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Alatala, i xɔnɔma nɛ muxu ma abadan?","poem":1},{"lineBreak":true},{"text":"I xa tɔɔnɛ danma mun tɛmui?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I xa xɔnɔ ɲamanɛe ma naxee mu i kolon,","poem":1},{"lineBreak":true},{"text":"i xa xɔnɔ mangɛyae ma naxee mu i batuma,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"barima e bara Isirayila xun nakana,","poem":1},{"lineBreak":true},{"text":"e bara a xa lingira rabira.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I naxa ratu muxu xa yunubi dangixie ma.","poem":1},{"lineBreak":true},{"text":"I xa hinnɛ muxu ra mafuren,","poem":1},{"lineBreak":true},{"text":"barima sɛnbɛ yo mu na muxu bɛ sɔnɔn.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kafu muxu ma, muxu rakisima Ala,","poem":1},{"lineBreak":true},{"text":"i xili xa nɔrɛ xa fe ra.","poem":1},{"lineBreak":true},{"text":"I xa muxu rakisi,","poem":1},{"lineBreak":true},{"text":"i xa muxu xa yunubie xafari i xili xa fe ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Munfe ra ɲamanɛe a falama,","poem":1},{"lineBreak":true},{"text":"«E Marigi Ala na minden?»","poem":1},{"lineBreak":true},{"text":"E xa a kolon i fama i xa konyie wuli gbeɲɔxɔde muxu ya xɔri.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I xa i tuli mati geelimanie wa xui ra,","poem":1},{"lineBreak":true},{"text":"i sɛnbɛ xa nee rakisi naxee xa kiitisae wama e faxafe.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N Marigi, i xa sare dɔxɔ solofere ragbilen na sie ma,","poem":1},{"lineBreak":true},{"text":"naxee bara i bɛxu.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Na kui, muxu tan i xa ɲama fan fama nɛ i batude,","poem":1},{"lineBreak":true},{"text":"muxu tan i xa xurusee fama nɛ i xa matɔxɔɛ masende muxu bɔnsɔɛ bɛ abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}