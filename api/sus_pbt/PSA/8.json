{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":8,"content":[{"type":"heading","content":["Xili xungbe kanyi nan lanxi Ala ma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba maxase luuti daaxi xui ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Muxu Marigi Alatala!","poem":1},{"lineBreak":true},{"text":"Xili xungbe kanyi nan lanxi i ma duniɲa bɛndɛ fuɲi fari,","poem":1},{"lineBreak":true},{"text":"i tan naxan ma nɔrɛ na koore ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dimɛe nun diyɔrɛe i sɛnbɛ matɔxɔma,","poem":1},{"lineBreak":true},{"text":"i i yaxuie nun i gerefae dɛ balanma na matɔxɔɛ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N na koore mato,","poem":1},{"lineBreak":true},{"text":"i naxan yailanxi i bɛlɛxɛ ra, kike a nun tunbuie,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"n nan n yɛtɛ maxɔrinma nɛ,","poem":1},{"lineBreak":true},{"text":"«Munse lanxi adama ma","poem":1},{"lineBreak":true},{"text":"i to i maɲɔxunma a xa fe ma?","poem":1},{"lineBreak":true},{"text":"Munse lanxi adamadi ma","poem":1},{"lineBreak":true},{"text":"i to i ɲɛngi sama a xa fe xɔn ma?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I a daaxi ki naxɛ,","poem":1},{"lineBreak":true},{"text":"a gbe mu luxi a xa findi malekɛ ra.","poem":1},{"lineBreak":true},{"text":"I bara binyɛ nun fisamanteya fi a ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I bara yaamari so a yi ra i xa daalisee birin xun ma.","poem":1},{"lineBreak":true},{"text":"I bara duniɲa findi a sanyi bun ma se ra:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"yɛxɛɛe, ningee, wulai subee,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"xɔni naxee ɲɛrɛma koore ma,","poem":1},{"lineBreak":true},{"text":"yɛxɛ naxee birin ɲɛrɛma baa ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muxu Marigi Alatala!","poem":1},{"lineBreak":true},{"text":"Xili Xungbe Kanyi nan lanxi i ma duniɲa bɛndɛ fuɲi fari!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}