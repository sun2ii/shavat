{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":81,"content":[{"type":"heading","content":["Tuli matife Ala ma"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Asafi xa bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba maxase luuti daaxi xui ra.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Wo xa sɛɛwa xui rate Ala ma,","poem":1},{"lineBreak":true},{"text":"naxan findixi won sɛnbɛ ra.","poem":1},{"lineBreak":true},{"text":"Wo wo xui rasiga Yaxuba Marigi Ala ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wo xa bɛɛti ba maxase nun kɔra xui ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wo xa feri fe kike nɛɛnɛ te tɛmui,","poem":1},{"lineBreak":true},{"text":"won ma sali lɔxɔɛ na a ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na findixi Ala xa sɛriyɛ nan na Isirayila bɛ,","poem":1},{"lineBreak":true},{"text":"Yaxuba Marigi Ala xa yaamari na a ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yaamari na a ra Ala naxan so Yusufu bɔnsɔɛ yi ra,","poem":1},{"lineBreak":true},{"text":"a to mini Misira bɔxi xili ma.","poem":1},{"lineBreak":true},{"text":"N naxa xui nde mɛ n mu naxan kolon, a naxɛ,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"«N bara kote ba e xun ma,","poem":1},{"lineBreak":true},{"text":"n bara debe binye ba e bɛlɛxɛe.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wo to n xili wo xa ɲaxankatɛ kui,","poem":1},{"lineBreak":true},{"text":"n naxa wo rakisi, n naxa wo yaabi kelife sesarinyi yire,","poem":1},{"lineBreak":true},{"text":"n naxa wo mato Meriba ye yire.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N ma ɲama Isirayila, wo wo tuli mati n ma marasi ra.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Wo naxa Ala gbɛtɛ batu,","poem":1},{"lineBreak":true},{"text":"wo naxa wo xinbi sin Ala gbɛtɛ ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N tan nan na wo Marigi Ala ra,","poem":1},{"lineBreak":true},{"text":"naxan wo ramini Misira bɔxi ra.","poem":1},{"lineBreak":true},{"text":"Wo wo dɛ rabi a belebele ra, n a rafema nɛ.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"«Kɔnɔ n ma ɲama mu a tuli matixi n na,","poem":1},{"lineBreak":true},{"text":"Isirayila mu n xui ratinmɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Na kui n naxa e lu e xa bɔɲɛ xɔrɔxɔya kui,","poem":1},{"lineBreak":true},{"text":"e xa ɲɛrɛ e yɛtɛ xaxili ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Xa a sa li nu n ma ɲama naxa a tuli mati n na,","poem":1},{"lineBreak":true},{"text":"xa Isirayila sa tin n ma kira ra nu,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"n fama nɛ a yaxui birin nayaagide keren na,","poem":1},{"lineBreak":true},{"text":"n e ragoro tɛmui birin.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Alatala yaxuie fama gaaxude a ya ra, e halaki abadan.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kɔnɔ n wo tan baloma nɛ donse fanyi ra,","poem":1},{"lineBreak":true},{"text":"n kumi raminima nɛ gɛmɛ kui wo bɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":17}