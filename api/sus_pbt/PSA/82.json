{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":82,"content":[{"type":"heading","content":["Ala xa kiiti a xa sɛnbɛmae bɛ"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Asafi xa bɛɛti","descriptive":true},{"text":"Ala tixi a xa malanyi ya ra,","poem":1},{"lineBreak":true},{"text":"a kiiti safe koore sɛnbɛmae ya ma.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"«Wo kiiti sama kobiɲa ra han mun tɛmui?","poem":1},{"lineBreak":true},{"text":"Wo nɔndi fima mixi ɲaaxie ma munfe ra?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wo xa misikiinɛe nun kiridie xa kiiti sa sɛriyɛ ki ma.","poem":1},{"lineBreak":true},{"text":"Wo xa setaree nun fuxarilae ratanga kiiti ɲaaxi ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wo xa setaree nun tɔɔrɔmixie rakisi.","poem":1},{"lineBreak":true},{"text":"Wo xa e ba mixi kobie bɛlɛxɛe i.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kɔnɔ e mu fahaamui sɔtɔ na fefe ma.","poem":1},{"lineBreak":true},{"text":"E e ɲɛrɛma dimi nan kui tun.","poem":1},{"lineBreak":true},{"text":"Duniɲa sanbunyi birin sɛrɛnma.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N a fala nɛ, «Koore sɛnbɛmae nan wo ra,","poem":1},{"lineBreak":true},{"text":"Ala Xili Xungbe Kanyi xa die nan wo birin na,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kɔnɔ wo faxama nɛ alɔ adamadie,","poem":1},{"lineBreak":true},{"text":"wo birama nɛ alɔ duniɲa mangɛe.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"I tan Ala, keli, i xa duniɲa makiiti,","poem":1},{"lineBreak":true},{"text":"barima i tan nan gbe na sie birin na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}