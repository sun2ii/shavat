{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":83,"content":[{"type":"heading","content":["Isirayila yaxuie"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Asafi xa bɛɛti","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Ee Ala, i naxa i sabari!","poem":1},{"lineBreak":true},{"text":"Ala, i naxa lu dundui kui,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"barima i yaxuie mu e raxaraxi,","poem":1},{"lineBreak":true},{"text":"i xɔnmae bara e xunyie ikeli.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"E na yanfɛ xɔrɔxɔɛ maxirife i xa ɲama xili ma,","poem":1},{"lineBreak":true},{"text":"e na e boore bɔɲɛ ratefe i xanuntenyie xili ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"E naxɛ, «Won xa e xili ɲɔn sie ya ma,","poem":1},{"lineBreak":true},{"text":"alako birin xa nɛɛmu Isirayila xili ma.»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E bara lan e boore ma i xili ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Edonkae, Sumayila bɔnsɔɛ, Mowabakae, Hagarikae,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Gebalakae, Amonikae, Amalɛkikae,","poem":1},{"lineBreak":true},{"text":"Filisitakae, Tirekae,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"nun Asiriyakae birin bara kafu Loti bɔnsɔɛ ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"I xa e bɔnbɔ alɔ i a raba Madiyankae ra ki naxɛ.","poem":1},{"lineBreak":true},{"text":"I xa e bɔnbɔ alɔ i a raba mangɛ Yabini na ki naxɛ,","poem":1},{"lineBreak":true},{"text":"a nun a xa sɔɔri mangɛ Sisera ra ki naxɛ Kison xure yire.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"E sɔntɔ nɛ Endori,","poem":1},{"lineBreak":true},{"text":"e fure naxa lu bɔxi ma, e mu ragata.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I xa fe xɔrɔxɔɛ raba e xa kuntigie ra,","poem":1},{"lineBreak":true},{"text":"alɔ i raba Orebi nun Seebi ra ki naxɛ.","poem":1},{"lineBreak":true},{"text":"E xa yareratie xa lu alɔ Sɛba nun Salamuna, naxee a fala,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"«Won xa Ala xa ɲama xa bɔxi findi won gbe ra.»","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N Marigi Ala, i xa na mixie lu alɔ sɛxɛ, foye naxan xaninma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I xa e xun nakana alɔ tɛ fɔtɔnyi ganma ki naxɛ geyae fari.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I xa bira e fɔxɔ ra xɔnɛ kui alɔ turunnaadɛ magaaxuxi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Marigi, i xa e rayaagi alako e xa gbilen i ma.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yaagi nun gaaxui xa lu e bɔɲɛ ma,","poem":1},{"lineBreak":true},{"text":"i xa e bɔnsɔɛ raɲɔn abadan.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"E xa a kolon a i tan nan xili Alatala,","poem":1},{"lineBreak":true},{"text":"a Ala Xili Xungbe Kanyi na i tan nan na duniɲa xun na.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}