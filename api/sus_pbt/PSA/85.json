{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":85,"content":[{"type":"heading","content":["Ala xa hinnɛ"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Kora xa die xa bɛɛti bɛɛtibae xa mangɛ bɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Marigi, i xanunteya masenma i xa ɲama bɛ,","poem":1},{"lineBreak":true},{"text":"i Yaxuba bɔnsɔɛ xun nakelima.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I diɲɛma i xa ɲama xa fe ɲaaxie ma,","poem":1},{"lineBreak":true},{"text":"i a xa yunubie birin xafarima. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I i xa xɔnɛ ragbilenma a fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"i diɲɛma a ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ala, i man xa muxu rakisi, i man xa hinnɛ muxu ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I xɔnɔma nɛ muxu ma abadan?","poem":1},{"lineBreak":true},{"text":"Na xɔnɛ mu bama muxu xa yi waxati kui?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I mu nɔma diɲɛde mu ma,","poem":1},{"lineBreak":true},{"text":"i xa ɲama xa kisi, e xa sɛɛwa?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala, i xa dugutɛgɛɲa masen muxu bɛ, i xa muxu rakisi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"N nan n tuli matima nɛ n Marigi Ala xa masenyi ra,","poem":1},{"lineBreak":true},{"text":"barima a bɔɲɛsa nan fima a xa ɲama tinxinxi ma.","poem":1},{"lineBreak":true},{"text":"Ala xa e mali gbilenfe ra e xa daxuɲa ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A kisi yati yati nan fima mixie ma naxee gaaxuma a ya ra,","poem":1},{"lineBreak":true},{"text":"alako a xa nɔrɛ xa sabati won ma bɔxi kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dugutɛgɛɲa nun nɔndi na yire keren.","poem":1},{"lineBreak":true},{"text":"Tinxinyi nun bɔɲɛsa ɲɛrɛma kira keren xɔn.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɔndi kelima lanbanyi ma,","poem":1},{"lineBreak":true},{"text":"tinxinyi kelima koore ma.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala hɛri fima nɛ won ma,","poem":1},{"lineBreak":true},{"text":"alako won ma bɔxi xa daxamui ramini.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Tinxinyi ɲɛrɛma a ya ra,","poem":1},{"lineBreak":true},{"text":"a findi sanyi fɔxi ra kira xɔn ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":14}