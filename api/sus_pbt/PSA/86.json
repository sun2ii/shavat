{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":86,"content":[{"type":"heading","content":["N hayi na Ala ma"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa Ala maxandi","descriptive":true},{"text":"Marigi, i i tuli mati n na, i xa n yaabi.","poem":1},{"lineBreak":true},{"text":"Misikiinɛ fuxarixi na n na.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I xa n makanta, i dugutɛgɛ na n na.","poem":1},{"lineBreak":true},{"text":"N Marigi Ala, i xa i xa konyi di rakisi naxan a taxuxi i ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kinikini n ma, n Marigi, barima n i xilima lɔxɔɛ birin.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"I xa sɛɛwɛ fi i xa konyi di ma,","poem":1},{"lineBreak":true},{"text":"n xaxili tixi i tan nan na, n Marigi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I tan Marigi, i fan, i kinikini,","poem":1},{"lineBreak":true},{"text":"i xa dugutɛgɛɲa gbo mixie bɛ naxee birin i xilima.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Marigi, i xa i tuli mati n ma maxandi ra, i xa n ma dubɛ suxu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N i xilima n ma tɔɔrɛ kui, barima i n natinma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N Marigi, i maniyɛ mu na alae tagi,","poem":1},{"lineBreak":true},{"text":"i xa kaabanakoee dangi wali birin na.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I si naxee daa duniɲa ma, nee fama nɛ e xinbi sinde i bun ma,","poem":1},{"lineBreak":true},{"text":"e i xili matɔxɔ,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"barima i gbo, i man kaabanakoe rabama.","poem":1},{"lineBreak":true},{"text":"I tan keren peti na nan Ala ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N Marigi, i xa i xa kira masen n bɛ,","poem":1},{"lineBreak":true},{"text":"n xa n ɲɛrɛ i xa nɔndi kui.","poem":1},{"lineBreak":true},{"text":"Bɔɲɛ fanyi fi n ma, alako n xa gaaxu i xili ya ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N i matɔxɔma n bɔɲɛ fiixɛ birin na, n Marigi Ala.","poem":1},{"lineBreak":true},{"text":"N i xili matɔxɔma nɛ abadan,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"barima i xa hinnɛ tilin.","poem":1},{"lineBreak":true},{"text":"I bara n nii ratanga faxɛ ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ee Ala, yɛtɛ igboe ndee bara keli n xili ma,","poem":1},{"lineBreak":true},{"text":"gbalotɔɛe wama n faxafe.","poem":1},{"lineBreak":true},{"text":"E mu i kolon feo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kɔnɔ n Marigi, i tan nan findixi Ala ra,","poem":1},{"lineBreak":true},{"text":"naxan kinikinima, naxan hinnɛma ibunadama ra,","poem":1},{"lineBreak":true},{"text":"naxan bɔɲɛ mu tema mafuren,","poem":1},{"lineBreak":true},{"text":"naxan mu taganma dugutɛgɛɲa nun xanunteya ma.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I xa i ya rafindi n ma, i xa hinnɛ n na.","poem":1},{"lineBreak":true},{"text":"I xa sɛnbɛ fi i xa konyi di ma,","poem":1},{"lineBreak":true},{"text":"i xa i xa konyi ginɛ xa di rakisi.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Tɔnxuma nde ramini n bɛ seede ra,","poem":1},{"lineBreak":true},{"text":"alako naxee n xɔnxi, e xa a to, e xa yaagi,","poem":1},{"lineBreak":true},{"text":"i xa mali nun i xa madundui xa fe ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}