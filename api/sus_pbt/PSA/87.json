{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":87,"content":[{"type":"heading","content":["Barife Siyoni"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Kora xa die xa bɛɛti","descriptive":true},{"text":"Alatala xa taa tixi geya sɛniyɛnxie fari.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Siyoni naadɛe rafan Marigi ma,","poem":1},{"lineBreak":true},{"text":"dangi Yaxuba xa lingira birin na.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mixie Ala xa taa matɔxɔma a fanyi ra Ɲɛngi rate.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"«N xa a fala Raxabi nun Babilɔn n kolonma,","poem":1},{"lineBreak":true},{"text":"a nun Filisita, Tire, nun Kusi.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A falaxi Siyonikae xa fe ra,","poem":1},{"lineBreak":true},{"text":"‹E to barixi naa, Marigi Ala e makantama nɛ.›»","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Alatala bara a sɛbɛ sie xa buki kui,","poem":1},{"lineBreak":true},{"text":"«Yi tan barixi naa.» Ɲɛngi rate.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛɛtibae a falama e xui itexi ra,","poem":1},{"lineBreak":true},{"text":"«N ma saabui birin na i tan nɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}