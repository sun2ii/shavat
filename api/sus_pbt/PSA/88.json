{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":88,"content":[{"type":"heading","content":["Saya kira"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Kora xa die xa bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba xule ra. Heman Esiraka xa lɔnni bɛɛti.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Marigi, n nakisima Ala,","poem":1},{"lineBreak":true},{"text":"n i xilima yanyi nun kɔɛ ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"I xa n ma maxandi suxu,","poem":1},{"lineBreak":true},{"text":"i xa n ma dubɛ tongo.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N bara tɔɔrɔ n ma duniɲɛigiri kui,","poem":1},{"lineBreak":true},{"text":"yakɔsi n bara makɔrɛ saya ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N na mixie ya ma naxee na saya kira xɔn ma.","poem":1},{"lineBreak":true},{"text":"N sɛnbɛ yo mu na sɔnɔn.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A luxi nɛ alɔ n ɲan saxi furee tagi gaburi kui,","poem":1},{"lineBreak":true},{"text":"i mu ratuxi naxee xa fe ma sɔnɔn,","poem":1},{"lineBreak":true},{"text":"naxee bara makuya i xa hinnɛ ra.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I bara n na so yili tilinxi kui dimi xɔɔra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I xa xɔnɛ bara dutun n ma,","poem":1},{"lineBreak":true},{"text":"a n makoto alɔ baa mɔrɔnyi mixi makotoma ki naxɛ. Ɲɛngi rate.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"I bara n dɛfanbooree makuya n na,","poem":1},{"lineBreak":true},{"text":"i bara e bɔɲɛe raɲaaxu e ma.","poem":1},{"lineBreak":true},{"text":"N luma banxi kui,","poem":1},{"lineBreak":true},{"text":"n mu minima fefe ma.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N Marigi, n i xilima lɔxɔ yo lɔxɔ yaye ra,","poem":1},{"lineBreak":true},{"text":"n na n bɛlɛxɛe tixi i bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"I kaabanakoe rabama mixi faxaxie nan bɛ?","poem":1},{"lineBreak":true},{"text":"E nɔma kelide, e i matɔxɔ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"I xa dugutɛgɛɲa xa fe falama gaburi kui?","poem":1},{"lineBreak":true},{"text":"I xa xanunteya masenma naa?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I xa kaabanako toma aligiyama?","poem":1},{"lineBreak":true},{"text":"I xa tinxinyi kolonma yire dɛnnaxɛ xa fe bara nɛɛmu mixi ra?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"N Marigi, n tan i xilima,","poem":1},{"lineBreak":true},{"text":"gɛɛsɛgɛ yo gɛɛsɛgɛ n i maxandima.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Marigi, i tondima n bɛ munfe ra?","poem":1},{"lineBreak":true},{"text":"I i kobe soma n na munfe ra?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N na tɔɔrɛ kui kabi n dimɛdi tɛmui.","poem":1},{"lineBreak":true},{"text":"N gaaxuxi, xaxilisa birin bara ba n yi ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"I xa xɔnɛ sɛnbɛ bara dangi a i,","poem":1},{"lineBreak":true},{"text":"i xa fe magaaxuxie bara nɔ n na.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"E n nabilinxi alɔ banbaranyi,","poem":1},{"lineBreak":true},{"text":"e dusu n xun na.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"I bara n xanuntenyie birin makuya n na,","poem":1},{"lineBreak":true},{"text":"n dɔxɔboore bara keli n xun ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":19}