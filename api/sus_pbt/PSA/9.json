{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":9,"content":[{"type":"heading","content":["Alatala kolonxi a xa tinxinyi nan ma"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Dawuda xa bɛɛti bɛɛtibae xa mangɛ bɛ. A xa ba alɔ bɛɛti naxan xili «Di xa faxɛ.»","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Alatala, n i tantuma n sondonyi birin na,","poem":1},{"lineBreak":true},{"text":"n i xa wali fanyi ixaranma mixi birin bɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N sɛɛwama nɛ i xa fe ra,","poem":1},{"lineBreak":true},{"text":"i tan Alatala Xili Xungbe Kanyi,","poem":1},{"lineBreak":true},{"text":"n i matɔxɔ bɛɛti ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yaxuie gbilenma nɛ e kelide.","poem":1},{"lineBreak":true},{"text":"Xa e bara ti i ya i,","poem":1},{"lineBreak":true},{"text":"e sanyie mu xanma bɔxi,","poem":1},{"lineBreak":true},{"text":"e nii mu xanma duniɲa,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"barima i xa tinxinyi kui,","poem":1},{"lineBreak":true},{"text":"i tan mangɛ bara kiiti so n yi.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"I bara si gbɛtɛe kalamu,","poem":1},{"lineBreak":true},{"text":"i fe kobi rabae rahalakima,","poem":1},{"lineBreak":true},{"text":"i e xili ralɔɛma nɛ han duniɲa ɲɔn.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"I bara e xa taae sɔntɔ,","poem":1},{"lineBreak":true},{"text":"na taa sɔntɔxie luma nɛ na ki han,","poem":1},{"lineBreak":true},{"text":"e xa fe nɛɛmu mixie ra!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Alatala xa mangɛya tixi,","poem":1},{"lineBreak":true},{"text":"danyi mu na a ma.","poem":1},{"lineBreak":true},{"text":"A xa kibanyi dɔxɔxi kiiti safe nan ma.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A duniɲa makiitima tinxinyi kui,","poem":1},{"lineBreak":true},{"text":"a dɔxɔxi sie xun ma tinxinyi kui.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Tɔɔrɔmixie kantama nan na Alatala ra,","poem":1},{"lineBreak":true},{"text":"e ratangama na a tan nan na e xa kɔntɔfilie kui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala, i kolonma laxi i ra,","poem":1},{"lineBreak":true},{"text":"barima i singe mu nu i fenma rabolo.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Alatala dɔxɔxi a xa geya sɛniyɛnxi xun,","poem":1},{"lineBreak":true},{"text":"won xa a tantu bɛɛtie ra.","poem":1},{"lineBreak":true},{"text":"A bara fe naxee raba,","poem":1},{"lineBreak":true},{"text":"won xa nee masen si birin bɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ala ratuxi wuli filixi ma,","poem":1},{"lineBreak":true},{"text":"a fan na ɲɔxɔma nɛ.","poem":1},{"lineBreak":true},{"text":"A tɔɔrɔmixie wa xui danxunxi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alatala, kinikini n ma.","poem":1},{"lineBreak":true},{"text":"I xa n mato.","poem":1},{"lineBreak":true},{"text":"A mato n yaxuie na n tɔɔrɔfe ki naxɛ.","poem":1},{"lineBreak":true},{"text":"I tan naxan n nakisima saya kira ma,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"alako n xa i tantu Siyoni ɲama tagi,","poem":1},{"lineBreak":true},{"text":"n xa sɛɛwa i xa kisi ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Sie nu gantanyi naxan texi e yaxuie bɛ,","poem":1},{"lineBreak":true},{"text":"e bara e yɛtɛ sanyie suxu a ra.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Alatala kolonxi a xa tinxinyi nan ma.","poem":1},{"lineBreak":true},{"text":"Tinxintaree suxuma e yɛtɛ bɛlɛxɛ fɔxi nan saabui ra.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Matandila naxee nɛɛmuma Ala ma,","poem":1},{"lineBreak":true},{"text":"e birin naɲɔnma aligiyama nɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Ala fama ratude tɔɔrɔmixi ma,","poem":1},{"lineBreak":true},{"text":"a mu nɛɛmuma e ma abadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Alatala, keli, i naxa a lu adama xa nɔ i ra.","poem":1},{"lineBreak":true},{"text":"A makiiti.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Alatala, i xa e magaaxu.","poem":1},{"lineBreak":true},{"text":"E xa a kolon ibunadama gbansan nan e ra.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}