{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":90,"content":[{"type":"heading","content":["Adama birin faxama nɛ"]},{"type":"heading","content":["Ala maxandi"]},{"type":"verse","number":1,"content":[{"text":"Ala xa mixi Munsa xa Ala maxandi","descriptive":true},{"text":"N Marigi, i tan findixi muxu kantama nan na abadan.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Beenun geyae nun duniɲa xa daa,","poem":1},{"lineBreak":true},{"text":"i tan nan nu na Ala ra abadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I ibunadama ragbilenma bɛndɛ i.","poem":1},{"lineBreak":true},{"text":"I na nan fala, «Adamadi xa gbilen bɛndɛ.»","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ɲɛ wulu keren luxi nɛ i bɛ","poem":1},{"lineBreak":true},{"text":"alɔ lɔxɔ keren naxan bara dangi,","poem":1},{"lineBreak":true},{"text":"alɔ waxati keren naxan bara dangi kɔɛ kui.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I a niya adamadi mu keli a xa xixɔli ma.","poem":1},{"lineBreak":true},{"text":"A luxi alɔ ɲooge naxan minima a yɛtɛ ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A keli subaxɛ ma, a fuga,","poem":1},{"lineBreak":true},{"text":"nunmare tɛmui a ɲan bara lisi, a xara.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"I xa xɔnɛ muxu ɲɔnma nɛ, a muxu magaaxu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I muxu xa yunubi birin kolon,","poem":1},{"lineBreak":true},{"text":"hali muxu xa fe ɲaaxi naxee findixi gundo ra.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Muxu xa simaya birin luma i xa xɔnɛ bun ma.","poem":1},{"lineBreak":true},{"text":"Muxu xa duniɲɛigiri xa bui birin, ɲɛngi rate keren.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Muxu xa simaya buma ɲɛ tongo solofere,","poem":1},{"lineBreak":true},{"text":"ɲɛ tongo solomasaxan xa a sɔɔnɛya,","poem":1},{"lineBreak":true},{"text":"kɔnɔ na birin findixi tɔɔrɛ nun ɲaxankatɛ nan na.","poem":1},{"lineBreak":true},{"text":"Simaya dangima nɛ mafuren mafuren, a muxu lu dimi kui.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Nde i xa xɔnɛ sɛnbɛ kolon?","poem":1},{"lineBreak":true},{"text":"Nde gaaxuma na ya ra?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A muxu ratu simaya raɲɔnyi ma,","poem":1},{"lineBreak":true},{"text":"alako muxu xa xaxili sɔtɔ muxu xa duniɲɛigiri kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N Marigi, i xa i ya rafindi muxu ma","poem":1},{"lineBreak":true},{"text":"I xa xɔnɛ buma han mun tɛmui?","poem":1},{"lineBreak":true},{"text":"Kinikini i xa konyi die ma.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kuye na iba, i xa muxu rawasa i xa dugutɛgɛɲa ra,","poem":1},{"lineBreak":true},{"text":"alako muxu xa sɛɛwa muxu xa simaya birin kui.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"I tɔɔrɛ xasabi naxan dɔxɔ muxu ma,","poem":1},{"lineBreak":true},{"text":"i yaagi xasabi naxan sa muxu ma,","poem":1},{"lineBreak":true},{"text":"i man xa muxu rasɛɛwa na xasabi ra.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I xa i xa kaabanakoe masen muxu bɛ, i xa konyie.","poem":1},{"lineBreak":true},{"text":"I xa nɔrɛ xa mini muxu xa die ma.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Muxu Marigi Ala xa tofanyi xa lu muxu ya i.","poem":1},{"lineBreak":true},{"text":"A xa muxu xa wali sɔɔnɛya, a xa baraka sa muxu xa wali ma!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}