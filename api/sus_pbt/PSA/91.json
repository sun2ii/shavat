{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":91,"content":[{"type":"heading","content":["Gaaxutareɲa"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Naxan luma Ala Xili Xungbe Kanyi xa kantari bun ma,","poem":1},{"lineBreak":true},{"text":"a a malabuma nɛ Ala xa kantɛ kui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N na a masenma Alatala bɛ,","poem":1},{"lineBreak":true},{"text":"«I tan nan na n ma kantari nun n makantade ra,","poem":1},{"lineBreak":true},{"text":"i tan n Marigi Ala, n laxi naxan na.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"A tan nan i ratangama gantanyie ma naxee tema i bɛ,","poem":1},{"lineBreak":true},{"text":"a i ratanga wuganyi ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A i makantama nɛ","poem":1},{"lineBreak":true},{"text":"alɔ tɔxɔɛ a xa die makantama ki naxɛ a gabutenyi bun ma.","poem":1},{"lineBreak":true},{"text":"A xa dugutɛgɛɲa luma nɛ alɔ sɔɔri xa wure lefa.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"I mu gaaxuma gbaloe ra kɔɛ ra,","poem":1},{"lineBreak":true},{"text":"i mu gaaxuma xalie ra yanyi ra,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"i mu gaaxuma wuganyi ra dimi kui,","poem":1},{"lineBreak":true},{"text":"i mu gaaxuma fure ɲaaxi ra soge bun ma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mixi wulu nɔma nɛ birade i kɔɔla ma,","poem":1},{"lineBreak":true},{"text":"mixi wulu fu nɔma birade i yirefanyi ma, kɔnɔ sese mu i toma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"I na birin toma nɛ i ya i,","poem":1},{"lineBreak":true},{"text":"i findi seede ra tinxintare xa ɲaxankatɛ ma,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"barima i bara la i Marigi ra, a bara findi i xa kantari ra.","poem":1},{"lineBreak":true},{"text":"Ala Xili Xungbe kanyi findixi i xa makantade nan na.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Sese mu i lima,","poem":1},{"lineBreak":true},{"text":"wuganyi yo mu soma i xɔnyi,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"barima a a xa malekɛe yamarima e xa i makanta yire birin.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"E i tongoma nɛ e bɛlɛxɛe kui,","poem":1},{"lineBreak":true},{"text":"alako i naxa i sanyi radin gɛmɛ ra.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"I nɔma yɛtɛe nun bɔximasee ra,","poem":1},{"lineBreak":true},{"text":"i sɛnbɛ dangi baratɛe nun biidae ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Alatala xa masenyi nan ya:","poem":1},{"lineBreak":true},{"text":"«A to laxi n na, n a rakisima nɛ.","poem":1},{"lineBreak":true},{"text":"N a makantama nɛ barima a n xili kolon.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"A na n xili, n a yaabima nɛ.","poem":1},{"lineBreak":true},{"text":"Tɔɔrɛ na a li, n luma nɛ a sɛɛti ma.","poem":1},{"lineBreak":true},{"text":"N a rakisima nɛ, n a xun nakeli.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N simaya xɔnkuye fima nɛ a ma,","poem":1},{"lineBreak":true},{"text":"n na n ma kisi masen a bɛ.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}