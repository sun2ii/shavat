{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":92,"content":[{"type":"heading","content":["Simaya kamalixi"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Bɛɛti naxan bama malabui lɔxɔɛ","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Marigi batufe fe fanyi na a ra.","poem":1},{"lineBreak":true},{"text":"Ala Xili Xungbe Kanyi, a lanma i xili xa matɔxɔ bɛɛti ra.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuye iba, a lanma i xa xanunteya xa matɔxɔ,","poem":1},{"lineBreak":true},{"text":"kɔɛ kui, muxu xa i tantu i xa dugutɛgɛɲa xa fe ra.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Matɔxɔɛ xa ba kɔra luuti fu daaxi xui ra nun adamadi xui ra.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Marigi, n ɲɛlɛxinma i xa kaabanakoe ra,","poem":1},{"lineBreak":true},{"text":"n nan n sɛɛwɛ xui itema i xa wali xa fe ra.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Marigi, i naxan nabama, a makaaba, i xaxili tilin.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Xaxilitare mu sese kolonma na kui,","poem":1},{"lineBreak":true},{"text":"a mu fahaamui sɔtɔma i xa fe ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ala kolontaree luma alɔ sansi","poem":1},{"lineBreak":true},{"text":"naxan bulama fiili ma, a fuga,","poem":1},{"lineBreak":true},{"text":"kɔnɔ na dangi xanbi, a ɲɔn abadan.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kɔnɔ i tan Marigi, matɔxɔɛ na i bɛ tɛmui birin.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"N Marigi, i yaxuie halakima nɛ,","poem":1},{"lineBreak":true},{"text":"i fe kobi rabae birin nayensen yɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"I sɛnbɛ fima nɛ n ma alɔ sɛxɛ ninge,","poem":1},{"lineBreak":true},{"text":"i ture fanyi sa n ma.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N yae a toma n gerefae xun goroma ki naxɛ,","poem":1},{"lineBreak":true},{"text":"n tuli e gi xui mɛ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Tinxintɔɛe xa fe fanma nɛ alɔ tugi bili,","poem":1},{"lineBreak":true},{"text":"e xa fe te alɔ sɛdiri wuri bili naxee na Liban.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"E sabatixi Alatala xa hɔrɔmɔbanxi tɛtɛ kui,","poem":1},{"lineBreak":true},{"text":"e xa fe fanma nɛ won Marigi Ala ya i.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Hali e forixi e xunsɛxɛ fiixɛxi,","poem":1},{"lineBreak":true},{"text":"sɛnbɛ na e bɛ fe fanyi rabafe ra,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"alako e xa a masen,","poem":1},{"lineBreak":true},{"text":"«Alatala tinxin, n tixi a xa sɛriyɛ nan fari,","poem":1},{"lineBreak":true},{"text":"tinxintareya yo mu na a ma.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}