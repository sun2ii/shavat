content":[{"lineBreak":true},{"text":"I xa sɛriyɛ xanxi, sɛniyɛntɔɛ nan lanxi i ma abadan.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}