{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":94,"content":[{"type":"heading","content":["Ala xa ɲaxankatɛ"]},{"type":"heading","content":["Ala xa sɛriyɛ"]},{"type":"verse","number":1,"content":[{"text":"N Marigi Ala naxan a gbeɲɔxɔma,","poem":1},{"lineBreak":true},{"text":"i xa i makɛnɛn i xa nɔrɛ kui.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"I tan naxan duniɲa kiiti sama, i xa keli,","poem":1},{"lineBreak":true},{"text":"i xa yɛtɛ igboe xa walie ragbilen e ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N Marigi, a lanma mixi kobie xun xa rakeli han mun tɛmui?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A lanma mixi ɲaaxie xa e yɛtɛ matɔxɔ tun e xa yɛtɛ igboɲa kui?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Alatala, e i xa ɲama tɔɔrɔma, e i xa mixie halakima.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"E kaaɲɛ ginɛe nun xɔɲɛ faxama, e kiridie nii bama.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"E nu fa a fala, «Alatala mu yi fee toma,","poem":1},{"lineBreak":true},{"text":"Yaxuba Marigi Ala mu yi rakɔrɔsima.»","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Wo tan xaxilitaree, naxee luma ɲama tagi,","poem":1},{"lineBreak":true},{"text":"wo xaxili sɔtɔma mun tɛmui?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Naxan tuli daaxi, na luma a mu fe mɛ?","poem":1},{"lineBreak":true},{"text":"Naxan ya daaxi, na luma a mu se to?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Naxan ɲamanɛe xuruma, na mu e ɲaxankatama?","poem":1},{"lineBreak":true},{"text":"A tan nan xaxili fima ibunadama ma.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Alatala a kolon a adamadie xa maɲɔxunyie na nɛ fufafu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Alatala, Sɛɛwɛ na mixi bɛ i naxan matinxinma,","poem":1},{"lineBreak":true},{"text":"i naxan matinxinma i xa sɛriyɛ ra,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"alako a xaxili xa sa tɔɔrɛ lɔxɔɛe,","poem":1},{"lineBreak":true},{"text":"han mixi ɲaaxie e gbe ɲaxankatɛ sɔtɔma tɛmui naxɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Alatala mu a xa ɲama raboloma,","poem":1},{"lineBreak":true},{"text":"a mu a xa mixie rabɛɲinma.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kiiti tinxinxi fama nɛ sade,","poem":1},{"lineBreak":true},{"text":"tinxintɔɛe bɔɲɛ birama nɛ na fɔxɔ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nde n xun mafalama mixi ɲaaxie xɔn ma?","poem":1},{"lineBreak":true},{"text":"Nde tima n bɛ mixi kobie xili ma?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Xa n Marigi mu findi n malima ra nu,","poem":1},{"lineBreak":true},{"text":"n ma fe danma nɛ gaburi kui nu.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"N Marigi, n na maɲɔxun","poem":1},{"lineBreak":true},{"text":"a n sanyi mu tima sɔnɔn,","poem":1},{"lineBreak":true},{"text":"i xa dugutɛgɛɲa n dɛmɛnma.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N ma kɔntɔfilie na wuya,","poem":1},{"lineBreak":true},{"text":"i e bama n ma, i fa n nasɛɛwa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"I nɔma tinde mangɛya tinxintare ra,","poem":1},{"lineBreak":true},{"text":"naxan yaamari tima fe kobi ra?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"E kafuma e bore ma tinxintɔɛ faxafe ra,","poem":1},{"lineBreak":true},{"text":"e mixi tɔɔɲɛgɛ kiiti kui.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kɔnɔ Marigi nan na n kantama ra,","poem":1},{"lineBreak":true},{"text":"a luma alɔ fanye n sabatima naxan fari.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"A e xa wali kobie ragbilenma nɛ e ma,","poem":1},{"lineBreak":true},{"text":"a e xun nakana e xa ɲaaxuɲa ra.","poem":1},{"lineBreak":true},{"text":"Muxu Marigi Ala e sɔntɔma nɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}