{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":95,"content":[{"type":"heading","content":["Mangɛ Ala matofe"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Won xa bɛɛti ba Marigi bɛ sɛɛwɛ ra,","poem":1},{"lineBreak":true},{"text":"won xa won xui ite won nakisima sɛnbɛma bɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Won xa a matɔxɔ,","poem":1},{"lineBreak":true},{"text":"won xa a matɔxɔɛ ba a bɛ bɛɛtie ra,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"barima Alatala, Ala xungbe na a ra,","poem":1},{"lineBreak":true},{"text":"naxan findixi mangɛ xungbe ra sɛnbɛmae birin xun ma.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Yire tilinxi na a bɛlɛxɛ.","poem":1},{"lineBreak":true},{"text":"Geya xuntagie findixi a gbe nan na,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"alɔ baa nun bɔxi a naxee daaxi a bɛlɛxɛ ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wo fa, won xa suyidi, won xa won igoro,","poem":1},{"lineBreak":true},{"text":"won xa won xinbi sin Alatala ya i naxan won daa,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"barima a tan nan won Marigi Ala ra.","poem":1},{"lineBreak":true},{"text":"Won findixi a xa ɲama nan na a naxan dɛmadonma,","poem":1},{"lineBreak":true},{"text":"alɔ xuruse dɛmadonyi mɛɛnima gɔɔrɛ ma ki naxɛ.","poem":1},{"lineBreak":true},{"text":"Wo xa a xui mɛ to.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wo naxa wo bɔɲɛe raxɔrɔxɔ alɔ naxan nabaxi Meriba,","poem":1},{"lineBreak":true},{"text":"alɔ naxan nabaxi Masa gbengberenyi ma tɛmui dangixi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wo benbae n mato nɛ na lɔxɔɛ,","poem":1},{"lineBreak":true},{"text":"hali e to nu bara n wali fɔxi to.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Na bɔnsɔɛ xa fe naxa raɲaaxu n ma ɲɛ tongo naani bun ma.","poem":1},{"lineBreak":true},{"text":"N naxa a fala, «Ɲama xurutare nan yi ki,","poem":1},{"lineBreak":true},{"text":"naxan mu n waxɔnfe kolon.»","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Na kui n naxa n kali n ma xɔnɛ kui,","poem":1},{"lineBreak":true},{"text":"«E mu soma n ma malabude kui fefe ma!»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}