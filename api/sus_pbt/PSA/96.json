{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":96,"content":[{"type":"heading","content":["Kiitisa na fafe"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Wo bɛɛti nɛɛnɛ nde ba Alatala bɛ!","poem":1},{"lineBreak":true},{"text":"Duniɲa birin xa bɛɛti ba Alatala bɛ!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wo bɛɛti ba Marigi bɛ, wo a xili matɔxɔ.","poem":1},{"lineBreak":true},{"text":"Wo xa a xa kisi masen mixie bɛ tɛmui birin.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wo xa a xa nɔrɛ fala si birin bɛ,","poem":1},{"lineBreak":true},{"text":"wo a xa kaabanakoe masen ɲama birin tagi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Marigi Ala gbo, a lanma won xa a matɔxɔ,","poem":1},{"lineBreak":true},{"text":"naxan dangi sɛnbɛmae birin na.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sie birama ala naxee fɔxɔ ra,","poem":1},{"lineBreak":true},{"text":"e findixi kuyee fufafu gbansan nan na,","poem":1},{"lineBreak":true},{"text":"kɔnɔ Alatala nan koore daa.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Nɔrɛ nun naiyalanyi kelima a tan nan ma,","poem":1},{"lineBreak":true},{"text":"sɛnbɛ nun naiyalanyi luma nɛ a xa hɔrɔmɔbanxi kui.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bɔnsɔɛ birin, wo xa tantui rasiga Alatala ma,","poem":1},{"lineBreak":true},{"text":"wo Alatala matɔxɔ a xunnakeli nun a xa sɛnbɛ xa fe ra.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Wo xa a xili binya alɔ a lanma wo xa a raba ki naxɛ.","poem":1},{"lineBreak":true},{"text":"Wo xa fa hadiya ra, wo xa a raso a xa hɔrɔmɔbanxi tɛtɛ kui.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wo xa suyidi Marigi bɛ a xa nɔrɛ ya i.","poem":1},{"lineBreak":true},{"text":"Duniɲa birin xa sɛrɛn a ya ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wo xa a fala si birin bɛ, «Alatala nan na Mangɛ ra.","poem":1},{"lineBreak":true},{"text":"Duniɲa xanxi, a mu a imaxama.","poem":1},{"lineBreak":true},{"text":"Ala ɲamae makiitima tinxinyi ra.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Koore xa sɛɛwa, bɔxi xa ɲɛlɛxin.","poem":1},{"lineBreak":true},{"text":"Baa nun a kui isee xa wundu sɛɛwɛ ra.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Xɛe nun e xa bogi see xui xa ite,","poem":1},{"lineBreak":true},{"text":"wondi wuri bilie xa e sɛɛwa xui ite","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Alatala ya ra naxan fafe.","poem":1},{"lineBreak":true},{"text":"A fafe duniɲa makiitide.","poem":1},{"lineBreak":true},{"text":"A duniɲa makiitima tinxinyi nan na,","poem":1},{"lineBreak":true},{"text":"a ɲamae makiiti nɔndi ra.»","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}