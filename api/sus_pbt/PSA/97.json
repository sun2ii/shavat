{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":97,"content":[{"type":"heading","content":["Mangɛ Ala magaaxu"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Alatala nan na mangɛ ra.","poem":1},{"lineBreak":true},{"text":"Duniɲa xa ɲɛlɛxin, surie xa sɛɛwa.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nuxui nun kuye ifɔɔrɔxi a rabilinma.","poem":1},{"lineBreak":true},{"text":"A xa kibanyi dɔxɔxi tinxinyi nun nɔndi fari.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Tɛ tixi a ya ra, a a yaxuie birin ganma a rabilinyi.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A duniɲa iyalanma a xa seyamakɔnyie ra,","poem":1},{"lineBreak":true},{"text":"duniɲa mixie na a to, e sɛrɛnma nɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Geyae xunuma duniɲa Marigi Alatala ya ra alɔ kumi dole.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Koore a xa tinxinyi masenma,","poem":1},{"lineBreak":true},{"text":"si birin a xa nɔrɛ toma.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuye batue fama nɛ yaagide a ya ra,","poem":1},{"lineBreak":true},{"text":"sɛnbɛmae e felenma nɛ a bun ma.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Siyonikae na a xui mɛ, e sɛɛwama nɛ,","poem":1},{"lineBreak":true},{"text":"Yudayakae ɲɛlɛxinma nɛ i tan Alatala xa kiiti ra,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"barima i tan Marigi xun nakelixi sɛnbɛmae birin bɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Alatala xanuntenyi xa fe ɲaaxi xɔn.","poem":1},{"lineBreak":true},{"text":"Alatala a batulae makantama nɛ,","poem":1},{"lineBreak":true},{"text":"a e ba mixi kobie bɛlɛxɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Naiyalanyi na tinxintɔɛe nan bɛ,","poem":1},{"lineBreak":true},{"text":"sɛɛwɛ na mixie bɛ naxee bɔɲɛ fiixɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tinxintɔɛe, wo sɛɛwa Marigi ra,","poem":1},{"lineBreak":true},{"text":"wo xa tantui rasiga a xili sɛniyɛnxi ma.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}