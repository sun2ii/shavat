{"translation":{"id":"sus_pbt","name":"Soso Kitaabuie: Tawureta, Yabura, Inyila","website":"https://ebible.org/Scriptures/details.php?id=sus","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sus","licenseNotes":null,"shortName":"PBT","englishName":"Susu Bible","language":"sus","textDirection":"ltr","sha256":"8ef8a9312ce0064991a818b1a48884f15adc64e168fd7e4262e9e91204b6903a","availableFormats":["json"],"listOfBooksApiLink":"/api/sus_pbt/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"Susu","languageEnglishName":"Susu"},"book":{"id":"PSA","translationId":"sus_pbt","name":"Yabura","commonName":"Yabura","title":"Yabura Dawuda Yabura Dawuda","order":19,"numberOfChapters":150,"sha256":"07c2608d8ccceb0045c1c0f15fae9f23573853d0351b52a91d399b9bd582945d","firstChapterNumber":1,"firstChapterApiLink":"/api/sus_pbt/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/sus_pbt/PSA/150.json","totalNumberOfVerses":2525},"chapter":{"number":99,"content":[{"type":"heading","content":["Mangɛ Alatala sɛniyɛn"]},{"type":"heading","content":["Ala matɔxɔɛ"]},{"type":"verse","number":1,"content":[{"text":"Ala dɔxɔxi a xa kibanyi kui kerubimi malekɛe tagi.","poem":1},{"lineBreak":true},{"text":"A xa ɲama tixi gaaxui kui, bɔxi na sɛrɛnfe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Alatala gbo Siyoni, a tixi sie birin xun ma.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"E xa i xili xungbe magaaxuxi matɔxɔ a xa sɛniyɛnyi xa fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mangɛ sɛnbɛ xa matɔxɔ,","poem":1},{"lineBreak":true},{"text":"tinxinyi rafan a ma,","poem":1},{"lineBreak":true},{"text":"a kiiti sama nɔndi ra Yaxuba xa bɔxi ma.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wo Marigi Alatala matɔxɔ,","poem":1},{"lineBreak":true},{"text":"wo wo magoro a bun ma a xa sɛniyɛnyi xa fe ra.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Munsa nun Haruna nu na a xa sɛrɛxɛdubɛe ya ma,","poem":1},{"lineBreak":true},{"text":"Annabi Samuweli nu na mixie ya ma naxee a maxandima.","poem":1},{"lineBreak":true},{"text":"E to a xili, a naxa e yaabi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A to sɛriyɛ nun yaamari masen e bɛ nuxui kui,","poem":1},{"lineBreak":true},{"text":"e naxa a xui suxu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Muxu Marigi Alatala, i bara e xa maxandi suxu.","poem":1},{"lineBreak":true},{"text":"I to Isirayila ɲaxankata e xa yunubi xa fe ra,","poem":1},{"lineBreak":true},{"text":"i man bara diɲɛ e ma.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wo xa wo Marigi Alatala matɔxɔ,","poem":1},{"lineBreak":true},{"text":"wo xa wo xinbi sin a xa geya sɛniyɛnxi fari,","poem":1},{"lineBreak":true},{"text":"barima won Marigi Alatala sɛniyɛn!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sus_pbt/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sus_pbt/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sus_pbt/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}