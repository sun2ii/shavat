ु यो इ कली खाल पाइब। मुल रे गेना हना यो मो पाइब। ब्‍यवस्‍था २८:६"]}],"footnotes":[]},"thisChapterLink":"/api/suz_wbt/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/suz_wbt/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/suz_wbt/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}