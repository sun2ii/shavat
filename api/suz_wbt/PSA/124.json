:["सरीङ नु रागी सेल्‍ब परमप्रभु यावेमी आंइ कली वारच पशो बाक्‍ब।"]}],"footnotes":[]},"thisChapterLink":"/api/suz_wbt/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/suz_wbt/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/suz_wbt/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}