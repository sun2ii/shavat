{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"1CO","translationId":"swe_fol","name":"Första Korintierbrevet","commonName":"Första Korintierbrevet","title":"Första Korintierbrevet","order":46,"numberOfChapters":16,"sha256":"b0a6e96baec672be13072bf8d10165b6e8a7410623b8e25fc475fa8503dfcce2","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/1CO/1.json","lastChapterNumber":16,"lastChapterApiLink":"/api/swe_fol/1CO/16.json","totalNumberOfVerses":437},"chapter":{"number":13,"content":[{"type":"heading","content":["Kärlekens väg"]},{"type":"verse","number":1,"content":[{"text":"Om jag talar","poem":1},{"text":"både människors","poem":2},{"text":"och änglars språk","poem":3},{"text":"men inte har kärlek,","poem":2},{"text":"är jag bara ekande brons","poem":1},{"text":"eller en skrällande cymbal.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Och om jag har profetisk gåva","poem":1},{"text":"och vet alla hemligheter","poem":2},{"text":"och har all kunskap,","poem":3},{"text":"och om jag har all tro","poem":2},{"text":"så att jag kan flytta berg","poem":3},{"text":"men inte har kärlek,","poem":2},{"text":"så är jag ingenting.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Och om jag delar ut","poem":1},{"text":"allt jag äger","poem":3},{"text":"och om jag offrar min kropp","poem":2},{"text":"till att brännas","poem":3},{"noteId":77},{"text":"men inte har kärlek,","poem":2},{"text":"så vinner jag ingenting.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Kärleken är tålig och mild.","poem":1},{"text":"Kärleken avundas inte,","poem":3},{"text":"den skryter inte,","poem":2},{"text":"den är inte uppblåst.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Den beter sig inte illa,","poem":1},{"text":"den söker inte sitt,","poem":3},{"text":"den brusar inte upp,","poem":2},{"text":"den tänker inte på","poem":3},{"noteId":78},{"text":"det onda.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Den gläder sig inte","poem":1},{"text":"över orätten","poem":3},{"text":"men gläds med sanningen.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Allt bär den, allt tror den,","poem":1},{"text":"allt hoppas den,","poem":2},{"text":"allt uthärdar den.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Kärleken upphör aldrig.","poem":1},{"text":"Men profetiorna ska försvinna,","poem":3},{"text":"tungomålen ska tystna","poem":2},{"text":"och kunskapen försvinna.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Vi förstår bara till en del","poem":1},{"text":"och profeterar till en del,","poem":3}]},{"type":"verse","number":10,"content":[{"text":"men när det fullkomliga kommer","poem":1},{"text":"ska det som är till en del","poem":2},{"text":"försvinna.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"När jag var barn","poem":1},{"text":"talade jag som ett barn,","poem":3},{"text":"tänkte som ett barn","poem":2},{"text":"och förstod som ett barn.","poem":3},{"text":"Men sedan jag blivit vuxen","poem":2},{"text":"har jag lagt bort det barnsliga.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Nu ser vi en gåtfull spegelbild","poem":1},{"noteId":79},{"text":",","poem":1},{"text":"men då ska vi se","poem":2},{"text":"ansikte mot ansikte.","poem":3},{"text":"Nu förstår jag bara till en del,","poem":2},{"text":"men då ska jag","poem":3},{"text":"känna fullkomligt,","poem":4},{"text":"så som jag själv blivit","poem":2},{"text":"fullkomligt känd.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Så består nu tro, hopp och kärlek,","poem":1},{"text":"dessa tre,","poem":3},{"text":"och störst av dem är kärleken.","poem":2}]}],"footnotes":[{"noteId":77,"caller":"-","text":"till att brännasAndra handskrifter: \"för att skryta\".","reference":{"chapter":13,"verse":3}},{"noteId":78,"caller":"-","text":"tänker inte påAnnan översättning: \"tillräknar inte\".","reference":{"chapter":13,"verse":5}},{"noteId":79,"caller":"-","text":"en gåtfull spegelbildAntikens bronsspeglar gav endast en vag bild. Kunskapen om Gud är i detta liv fragmentarisk (13:9) och meddelas som en hemlighet (2:7) och en gåta i Skriftens klara spegel (4 Mos 12:8). Den är dock sann och tas emot genom tron (2 Kor 5:7), medan den i det kommande livet ska ersättas av att få se Gud \"ansikte mot ansikte\".","reference":{"chapter":13,"verse":12}}]},"thisChapterLink":"/api/swe_fol/1CO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/1CO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/1CO/12.json","previousChapterAudioLinks":{},"numberOfVerses":13}