{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"2SA","translationId":"swe_fol","name":"Andra Samuelsboken","commonName":"Andra Samuelsboken","title":"Andra Samuelsboken","order":10,"numberOfChapters":24,"sha256":"bd2d5623eae0d2b190ae3c2867565e7bc8beb895dbe031e5ba553ffc40d3b3ff","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/swe_fol/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Davids segersång"]},{"type":"verse","number":1,"content":["David sjöng denna sång",{"noteId":137},"till Herren när Herren hade räddat honom från alla hans fiender och ur Sauls våld."]},{"type":"verse","number":2,"content":["Han sade:",{"lineBreak":true},{"text":"Herre, mitt bergfäste,","poem":1},{"text":"min borg och min räddare,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"min Gud, min klippa","poem":1},{"text":"och min tillflykt,","poem":3},{"text":"min sköld och min frälsnings horn,","poem":2},{"text":"mitt värn och mitt skydd,","poem":3},{"text":"min frälsare som frälser mig","poem":2},{"text":"från våldet.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Till Herren, den högt lovade,","poem":1},{"text":"ropar jag,","poem":3},{"text":"och jag blir frälst från mina fiender.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dödens vågor omgav mig,","poem":1},{"text":"fördärvets strömmar skrämde mig.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Dödsrikets band omslöt mig,","poem":1},{"text":"dödens snaror mötte mig.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I min nöd åkallade jag Herren,","poem":1},{"text":"jag ropade till min Gud.","poem":3},{"text":"Från sitt tempel hörde han min röst,","poem":2},{"text":"mitt rop nådde hans öron.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Då skakade jorden och bävade,","poem":1},{"text":"himlens grundvalar darrade,","poem":3},{"text":"de skakade av hans brinnande vrede.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rök steg ur hans näsa","poem":1},{"text":"och förtärande eld ur hans mun,","poem":3},{"text":"det gnistrade av glöd från honom.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Han sänkte himlen och steg ner","poem":1},{"text":"med mörka moln under sina fötter,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"han red på keruben och flög,","poem":1},{"text":"han svävade fram på vindens vingar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Han gjorde mörker till sitt skydd","poem":1},{"text":"omkring honom:","poem":3},{"text":"vattenmassor, tjocka moln.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ur glansen framför honom","poem":1},{"text":"flammade glödande kol.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Herren dundrade från himlen,","poem":1},{"text":"den Högste höjde sin röst.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Han sköt pilar och skingrade dem,","poem":1},{"text":"blixtar och förvirrade dem.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Flodbäddar blev synliga,","poem":1},{"text":"jordens grundvalar blottades","poem":3},{"text":"för Herrens tillrättavisning,","poem":2},{"text":"för hans vredes stormvind.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Han räckte sin hand från höjden","poem":1},{"text":"och grep tag i mig,","poem":3},{"text":"han drog mig upp","poem":2},{"text":"ur de väldiga vattnen.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Han räddade mig","poem":1},{"text":"från min mäktige fiende,","poem":3},{"text":"från dem som hatade mig","poem":2},{"text":"och var starkare än jag.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"De anföll mig på min olyckas dag,","poem":1},{"text":"men Herren var mitt stöd.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Han förde mig ut på rymlig plats,","poem":1},{"text":"han räddade mig","poem":2},{"text":"eftersom han älskar mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Herren var god mot mig","poem":1},{"text":"efter min rättfärdighet,","poem":3},{"text":"han lönade mig","poem":2},{"text":"efter mina händers renhet,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"för jag har hållit mig","poem":1},{"text":"på Herrens vägar","poem":3},{"text":"och inte avfallit från min Gud.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jag har haft alla hans domar","poem":1},{"text":"för ögonen","poem":3},{"text":"och inte avvisat hans stadgar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Jag har varit fullkomlig inför honom","poem":1},{"text":"och aktat mig för synd.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Därför har Herren lönat mig efter min rättfärdighet,","poem":1},{"text":"efter min renhet inför hans ögon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mot den trogne är du trofast,","poem":1},{"text":"mot den fullkomlige","poem":2},{"text":"är du fullkomlig.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Mot den rene är du ren,","poem":1},{"text":"men mot den falske är du vrång.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Du frälser ett förtryckt folk,","poem":1},{"text":"men du har ögonen på de stolta","poem":2},{"text":"och ödmjukar dem.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Ja, du är min lampa, Herre,","poem":1},{"text":"Herren gör mitt mörker ljust.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Med dig slår jag ner en armé,","poem":1},{"text":"med min Gud stormar jag murar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Guds väg är fullkomlig,","poem":1},{"text":"Herrens ord är rent.","poem":3},{"text":"Han är en sköld för alla","poem":2},{"text":"som flyr till honom.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Vem är Gud förutom Herren,","poem":1},{"text":"vem är en klippa utom vår Gud?","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Gud är mitt starka värn,","poem":1},{"text":"han gör min väg fullkomlig","poem":2},{"noteId":138},{"text":".","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Du gör mina fötter som hindens","poem":1},{"text":"och ställer mig på mina höjder.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Du lär mina händer att strida,","poem":1},{"text":"mina armar","poem":2},{"text":"att spänna kopparbågen.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Du ger mig din frälsnings sköld,","poem":1},{"text":"din ödmjukhet gör mig stor.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Du gör plats för mina steg","poem":1},{"text":"där jag går,","poem":3},{"text":"mina fötter vacklar inte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Jag förföljde mina fiender","poem":1},{"text":"och förgjorde dem,","poem":3},{"text":"jag vände inte förrän","poem":2},{"text":"jag gjort slut på dem.","poem":3}]},{"type":"verse","number":39,"content":[{"text":"Jag gjorde slut på dem och slog dem","poem":1},{"text":"så att de inte kunde resa sig,","poem":3},{"text":"de föll under mina fötter.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Du rustade mig med kraft","poem":1},{"text":"för striden,","poem":3},{"text":"du böjde mina motståndare","poem":2},{"text":"under mig.","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Mina fiender drev du","poem":1},{"text":"på flykten för mig,","poem":3},{"text":"dem som hatade mig förintade jag.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"De såg sig omkring,","poem":1},{"text":"men ingen räddare fanns,","poem":3},{"text":"till Herren,","poem":2},{"text":"men han svarade dem inte.","poem":3}]},{"type":"verse","number":43,"content":[{"text":"Jag malde dem till stoft på marken,","poem":1},{"text":"jag krossade dem","poem":2},{"text":"och trampade ner dem","poem":3},{"text":"som smuts på gatan.","poem":4}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Du räddade mig ur mitt folks strider,","poem":1},{"text":"du bevarade mig","poem":2},{"text":"som ett huvud över hednafolk,","poem":3},{"text":"folk jag inte kände blev mina tjänare.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Främlingar kröp för mig,","poem":1},{"text":"så snart de hörde om mig","poem":2},{"text":"lydde de mig.","poem":3}]},{"type":"verse","number":46,"content":[{"text":"Främlingarnas mod vissnade bort,","poem":1},{"text":"bävande lämnade de sina fästen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Herren lever!","poem":1},{"text":"Lovad är min klippa,","poem":2},{"text":"upphöjd är Gud,","poem":3},{"text":"min frälsnings klippa.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Gud, du har gett mig hämnd","poem":1},{"text":"och lagt folken under mig.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Du har fört mig ut från mina fiender,","poem":1},{"text":"du har upphöjt mig","poem":2},{"text":"över mina motståndare","poem":3},{"text":"och räddat mig från våldsmän.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Därför vill jag tacka dig","poem":1},{"text":"bland hednafolken, Herre,","poem":3},{"text":"och lovsjunga ditt namn,","poem":2}]},{"type":"verse","number":51,"content":[{"text":"för du ger stora segrar till din kung","poem":1},{"text":"och visar nåd mot din smorde,","poem":3},{"text":"mot David och hans ätt till evig tid.","poem":2}]}],"footnotes":[{"noteId":137,"caller":"-","text":"denna sångEn snarlik version av psalmen finns i Psaltaren som Ps 18.","reference":{"chapter":22,"verse":1}},{"noteId":138,"caller":"-","text":"han gör min väg fullkomligAndra handskrifter: ”han leder den fullkomlige på hans väg”.","reference":{"chapter":22,"verse":33}}]},"thisChapterLink":"/api/swe_fol/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}