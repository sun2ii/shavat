{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"AMO","translationId":"swe_fol","name":"Amos","commonName":"Amos","title":"Amos","order":30,"numberOfChapters":9,"sha256":"726aac71e752ac41337c453373fbefc872328a66ad55f416b92b28384ec2b2b5","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swe_fol/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Ord av Amos, en av herdarna från Tekoa. Detta är vad han såg om Israel när Ussia",{"noteId":0},"var kung i Juda och Jerobeam",{"noteId":1},", Joashs son, var kung i Israel, två år före jordbävningen",{"noteId":2},"."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Han sade:","poem":1},{"lineBreak":true},{"text":"Herren ska ryta från Sion,","poem":1},{"text":"höja sin röst från Jerusalem.","poem":3},{"text":"Då ska herdarnas","poem":2},{"text":"betesmarker sörja","poem":3},{"text":"och Karmels höjd torka bort.","poem":2}]},{"type":"heading","content":["Profetia om Damaskus"]},{"type":"verse","number":3,"content":[{"text":"Så säger Herren:","poem":1},{"text":"För tre brott av Damaskus, ja fyra,","poem":2},{"text":"tar jag inte tillbaka mitt beslut,","poem":3},{"text":"för de tröskade Gilead","poem":2},{"noteId":3},{"text":"med tröskslädar av järn:","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag ska sända en eld","poem":1},{"text":"mot Hasaels hus,","poem":3},{"text":"och den ska förtära","poem":2},{"text":"Ben-Hadads borgar.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Jag ska bryta bommarna i Damaskus","poem":1},{"text":"och utrota dem som bor","poem":2},{"noteId":4},{"text":"i Bikat-Aven","poem":2},{"noteId":5},{"text":"och den som bär spiran","poem":3},{"text":"i Bet-Eden","poem":4},{"noteId":6},{"text":".","poem":4},{"text":"Arams folk ska föras bort till Kir","poem":2},{"noteId":7},{"text":",","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"heading","content":["Profetia om Gaza"]},{"type":"verse","number":6,"content":[{"text":"Så säger Herren:","poem":1},{"text":"För tre brott av Gaza, ja fyra,","poem":2},{"text":"tar jag inte tillbaka mitt beslut,","poem":3},{"text":"för de förde bort","poem":2},{"text":"allt folket som fångar","poem":3},{"text":"och utlämnade dem åt Edom:","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Jag ska sända en eld","poem":1},{"text":"mot Gazas murar","poem":3},{"noteId":8},{"text":",","poem":3},{"text":"och den ska förtära dess borgar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jag ska utrota dem som bor i Ashdod","poem":1},{"text":"och den som bär spiran i Ashkelon.","poem":2},{"text":"Jag ska vända min hand mot Ekron","poem":1},{"text":"så att de som är kvar av filisteerna","poem":2},{"text":"går under, säger Herren Gud.","poem":3}]},{"type":"heading","content":["Profetia om Tyrus"]},{"type":"verse","number":9,"content":[{"text":"Så säger Herren:","poem":1},{"text":"För tre brott av Tyrus, ja fyra,","poem":2},{"text":"tar jag inte tillbaka mitt beslut,","poem":3},{"text":"för de utlämnade allt folket","poem":2},{"text":"som fångar åt Edom","poem":3},{"text":"och tänkte inte","poem":2},{"text":"på sitt brödraförbund:","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Jag ska sända en eld","poem":1},{"text":"mot Tyrus murar,","poem":3},{"text":"och den ska förtära dess borgar.","poem":2}]},{"type":"heading","content":["Profetia om Edom"]},{"type":"verse","number":11,"content":[{"text":"Så säger Herren:","poem":1},{"text":"För tre brott av Edom, ja fyra,","poem":2},{"text":"tar jag inte tillbaka mitt beslut,","poem":3},{"text":"för de förföljde sin bror med svärd","poem":2},{"text":"och förkvävde all barmhärtighet,","poem":3},{"text":"lät sin vrede rasa utan uppehåll","poem":2},{"text":"och höll kvar sitt raseri utan slut:","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Jag ska sända en eld mot Teman,","poem":1},{"text":"och den ska förtära Bosras borgar.","poem":2}]},{"type":"heading","content":["Profetia om Ammon"]},{"type":"verse","number":13,"content":[{"text":"Så säger Herren:","poem":1},{"text":"För tre brott av ammoniterna, ja fyra,","poem":2},{"text":"tar jag inte tillbaka mitt beslut,","poem":3},{"text":"för de skar upp","poem":2},{"text":"havande kvinnor i Gilead","poem":3},{"text":"när de ville vidga sitt område:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jag ska tända en eld","poem":1},{"text":"mot Rabbas murar,","poem":3},{"text":"och den ska förtära dess borgar","poem":2},{"text":"under härskri på stridens dag,","poem":3},{"text":"under storm på ovädrets dag.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Deras kung ska gå bort i fångenskap,","poem":1},{"text":"han och hans furstar med honom,","poem":2},{"text":"säger Herren.","poem":3}]}],"footnotes":[{"noteId":0,"caller":"-","text":"UssiaOckså kallad Asarja. Mäktig kung i Sydriket 767-740 f Kr (2 Kung 15:1f, 2 Krön 26).","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"-","text":"JerobeamRegerade i Nordriket 782-753 f Kr (2 Kung 14:23f). Hans förfader med samma namn hade infört avgudadyrkan i Nordriket på 920-talet f Kr (1 Kung 12:28).","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"-","text":"jordbävningenUtgrävningar i galileiska Hasor har funnit spår av en omfattade jordbävning ca 760 f Kr. Både Sak 14:5 och Josefus daterar den till Ussias tid.","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"-","text":"tröskade GileadSkövlingen under den arameiske kungen Hasael beskrivs i 2 Kung 8:12f, 10:32f.","reference":{"chapter":1,"verse":3}},{"noteId":4,"caller":"-","text":"dem som borAnnan översättning: ”den som tronar” (även i vers 8).","reference":{"chapter":1,"verse":5}},{"noteId":5,"caller":"-","text":"Bikat-AvenBetyder ”syndens dal”. Syftar kanske på Bekaadalen i nuvarande Libanon.","reference":{"chapter":1,"verse":5}},{"noteId":6,"caller":"-","text":"Bet-EdenBit-Adini var ett arameiskt smårike ca 30 mil nordost om Israel.","reference":{"chapter":1,"verse":5}},{"noteId":7,"caller":"-","text":"KirArameernas ursprungsland (9:7) dit de fördes i fångenskap av assyrierna ca år 733 f Kr.","reference":{"chapter":1,"verse":5}},{"noteId":8,"caller":"-","text":"eld mot Gazas murarOmrådet härjades av kung Ussia (2 Krön 26:6), och utgrävningar visar att Ashdods portar förstördes ca 760 f Kr. Längre fram erövrades området av assyrierna 734 f Kr.","reference":{"chapter":1,"verse":7}}]},"thisChapterLink":"/api/swe_fol/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}