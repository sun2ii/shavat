{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"AMO","translationId":"swe_fol","name":"Amos","commonName":"Amos","title":"Amos","order":30,"numberOfChapters":9,"sha256":"726aac71e752ac41337c453373fbefc872328a66ad55f416b92b28384ec2b2b5","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swe_fol/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Hör detta ord,",{"text":"ni Bashans kor","poem":3},{"noteId":18},{"text":"på Samarias berg,","poem":4},{"text":"ni kvinnor som förtrycker de svaga","poem":2},{"text":"och krossar de fattiga,","poem":3},{"text":"ni som säger till era män:","poem":2},{"text":"”Hämta hit så vi får dricka!”","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Herren Gud har svurit","poem":1},{"text":"vid sin helighet:","poem":3},{"text":"Se, dagar ska drabba er","poem":2},{"text":"då man hämtar er med krokar","poem":3},{"text":"och vad som är kvar av er","poem":2},{"text":"med fiskkrokar.","poem":3},{"noteId":19}]},{"type":"verse","number":3,"content":[{"text":"Då ska ni komma ut,","poem":1},{"text":"var och en genom närmaste","poem":2},{"text":"öppning i muren,","poem":3},{"text":"och drivas bort till Hermon,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"heading","content":["Israels förhärdelse"]},{"type":"verse","number":4,"content":[{"text":"Gå till Betel och synda,","poem":1},{"text":"till Gilgal och synda ännu mer.","poem":3},{"text":"Bär fram era slaktoffer","poem":2},{"text":"på morgonen,","poem":3},{"text":"era tionden på tredje dagen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bränn syrat bröd","poem":1},{"noteId":20},{"text":"som lovoffer,","poem":1},{"text":"ropa ut frivilliga offer,","poem":2},{"text":"kungör dem,","poem":3},{"text":"för sådant älskar ni ju,","poem":2},{"text":"ni Israels barn,","poem":3},{"text":"säger Herren Gud.","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jag lät er gå med tomma magar","poem":1},{"noteId":21},{"text":"i alla era städer","poem":3},{"text":"och lät er sakna bröd","poem":2},{"text":"på alla era orter.","poem":3},{"text":"Ändå har ni inte vänt om till mig,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Jag höll tillbaka regnet för er,","poem":1},{"text":"när det ännu var tre månader kvar","poem":2},{"text":"till skördetiden.","poem":3},{"text":"Jag lät det regna över en stad","poem":2},{"text":"men inte över en annan.","poem":3},{"text":"En åker fick regn,","poem":2},{"text":"den som inte fick regn","poem":3},{"text":"torkade bort.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Två, tre städer stapplade","poem":1},{"text":"till samma stad","poem":3},{"text":"för att få vatten att dricka,","poem":2},{"text":"men kunde inte släcka sin törst.","poem":3},{"text":"Och ändå har ni inte","poem":2},{"text":"vänt om till mig,","poem":4},{"text":"säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jag slog er med sot och rost","poem":1},{"noteId":22},{"text":".","poem":1},{"text":"Era många trädgårdar, vingårdar,","poem":2},{"text":"fikonträd och olivträd","poem":3},{"text":"åt gräshopporna upp.","poem":4},{"text":"Och ändå har ni inte vänt om","poem":2},{"text":"till mig, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jag sände pest bland er","poem":1},{"text":"som i Egypten.","poem":3},{"text":"Jag dödade era unga män med svärd","poem":2},{"text":"och lät era hästar tas som byte.","poem":3},{"text":"Stanken av era fallna skaror","poem":2},{"text":"lät jag stiga upp i er näsa.","poem":3},{"text":"Och ändå har ni inte","poem":2},{"text":"vänt om till mig, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jag lät ödeläggelse drabba er,","poem":1},{"text":"som när Gud ödelade","poem":2},{"text":"Sodom och Gomorra.","poem":3},{"text":"Ni var som en brand,","poem":2},{"text":"ryckt ur elden.","poem":3},{"text":"Och ändå har ni inte","poem":2},{"text":"vänt om till mig, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Därför ska jag göra så","poem":1},{"text":"med dig, Israel,","poem":3},{"text":"och eftersom jag ska göra så","poem":2},{"text":"med dig,","poem":3},{"text":"så bered dig att möta din Gud, Israel.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"För se, han som formar bergen","poem":1},{"text":"och skapar vinden","poem":3},{"noteId":23},{"text":"och förkunnar sina tankar","poem":2},{"text":"för människan,","poem":3},{"text":"han som gör gryningen till mörker","poem":2},{"text":"och går fram över jordens höjder –","poem":3},{"text":"Herren Gud Sebaot","poem":2},{"text":"är hans namn.","poem":3}]}],"footnotes":[{"noteId":18,"caller":"-","text":"Bashans korHerden Amos liknar Samarias rika kvinnor vid landets mest välgödda kor, som betade på Bashan eller nuvarande Golanhöjderna.","reference":{"chapter":4,"verse":1}},{"noteId":19,"caller":"-","text":"krokar … fiskkrokarSyftar antingen på mindre metkrokar eller större hakar och harpuner.","reference":{"chapter":4,"verse":2}},{"noteId":20,"caller":"-","text":"Brännsyrat brödFörbjudet enligt 3 Mos 2:11. Liknas i NT vid synd (Luk 12:1, 1 Kor 5:6f).","reference":{"chapter":4,"verse":5}},{"noteId":21,"caller":"-","text":"tomma magarOrdagrant: ”rena tänder”.","reference":{"chapter":4,"verse":6}},{"noteId":22,"caller":"-","text":"sot och rostSädessjukdomar som orsakades av ökenvindar och svampangrepp.","reference":{"chapter":4,"verse":9}},{"noteId":23,"caller":"-","text":"vindenAnnan översättning: ”anden” (jfr Joh 3:8).","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/swe_fol/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}