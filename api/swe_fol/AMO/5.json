{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"AMO","translationId":"swe_fol","name":"Amos","commonName":"Amos","title":"Amos","order":30,"numberOfChapters":9,"sha256":"726aac71e752ac41337c453373fbefc872328a66ad55f416b92b28384ec2b2b5","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swe_fol/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["En sorgesång"]},{"type":"verse","number":1,"content":["Hör dessa ord som jag tar upp som en sorgesång över er, ni av Israels hus:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"”Fallen är hon och reser inte sig mer,","poem":1},{"text":"jungfrun Israel!","poem":3},{"text":"Hon ligger övergiven på sin mark.","poem":2},{"text":"Ingen finns","poem":3},{"text":"som hjälper henne upp.”","poem":4}]},{"type":"verse","number":3,"content":[{"text":"För så säger Herren Gud:","poem":1},{"text":"Den stad där tusen brukade dra ut","poem":2},{"text":"ska ha hundra kvar,","poem":3},{"text":"och den där hundra brukade dra ut","poem":2},{"text":"ska ha tio kvar för Israels hus.","poem":3}]},{"type":"heading","content":["Kallelse till omvändelse"]},{"type":"verse","number":4,"content":[{"text":"Så säger Herren till Israels hus:","poem":1},{"text":"Sök mig så ska ni leva.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Men sök inte Betel,","poem":1},{"text":"gå inte till Gilgal","poem":2},{"text":"och dra inte bort till Beer-Sheba","poem":3},{"noteId":24},{"text":",","poem":3},{"text":"för Gilgal ska föras bort","poem":2},{"text":"i fångenskap","poem":3},{"text":"och av Betel ska inget bli kvar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sök Herren så ska ni leva.","poem":1},{"text":"Annars ska han drabba Josefs hus","poem":2},{"noteId":25},{"text":"likt en eld som förtär,","poem":3},{"text":"och ingen kan släcka den","poem":2},{"text":"så att Betel räddas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ni förvandlar rätten till malört","poem":1},{"text":"och slår rättfärdigheten","poem":2},{"text":"till marken.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Han som har gjort","poem":1},{"text":"Sjustjärnorna och Orion,","poem":3},{"text":"han som förvandlar","poem":2},{"text":"det djupa mörkret","poem":3},{"noteId":26},{"text":"till morgon","poem":3},{"text":"och gör dagen mörk","poem":2},{"text":"som natten,","poem":3},{"text":"han som kallar på havets vatten","poem":2},{"text":"och öser ut det över jorden –","poem":3},{"text":"Herren är hans namn.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han låter fördärv blixtra över","poem":1},{"text":"starka fästen","poem":3},{"noteId":27},{"text":",","poem":3},{"text":"fördärv drabba befästa borgar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"De hatar den som försvarar det rätta","poem":1},{"text":"i porten","poem":3},{"text":"och avskyr den som talar sanning.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hör därför,","poem":1},{"text":"ni som trampar på den fattige","poem":3},{"text":"och tar ifrån honom hans säd","poem":2},{"text":"som skatt:","poem":3},{"text":"Ni bygger hus av huggen sten","poem":2},{"text":"men ska inte bo i dem,","poem":3},{"text":"ni planterar ljuvliga vingårdar","poem":2},{"text":"men ska inte dricka deras vin,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"för jag vet att era brott är många","poem":1},{"text":"och era synder talrika,","poem":3},{"text":"ni som förtrycker den rättfärdige","poem":2},{"text":"och tar mutor","poem":3},{"text":"och hindrar de fattiga","poem":2},{"text":"att få rätt i porten.","poem":3},{"noteId":28}]},{"type":"verse","number":13,"content":[{"text":"Därför tiger den förståndige","poem":1},{"text":"i denna tid,","poem":3},{"text":"för det är en ond tid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sök det goda och inte det onda,","poem":1},{"text":"så att ni får leva.","poem":3},{"text":"Då ska Herren Gud Sebaot","poem":2},{"text":"vara med er,","poem":3},{"text":"så som ni säger att han är.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hata det onda och älska det goda","poem":1},{"text":"och låt rätten härska i porten.","poem":3},{"text":"Kanske ska Herren Gud Sebaot","poem":2},{"text":"vara nådig mot dem som är kvar","poem":3},{"text":"av Josef.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Därför säger","poem":1},{"text":"Herren Gud Sebaot, Herren:","poem":3},{"text":"På alla torg ska man höra klagan,","poem":2},{"text":"på alla gator ska man säga:","poem":3},{"text":"”Oj, oj!”","poem":4},{"text":"Bonden ska man mana till sorg,","poem":2},{"text":"och dem som kan","poem":3},{"text":"sjunga sorgesång till klagan.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"I alla vingårdar ska man höra klagan,","poem":1},{"text":"för jag ska gå fram mitt ibland er,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"heading","content":["Herrens dag"]},{"type":"verse","number":18,"content":[{"text":"Ve dem som längtar","poem":1},{"text":"efter Herrens dag!","poem":2},{"text":"Varför längtar ni efter den?","poem":3},{"text":"Herrens dag är mörker","poem":2},{"text":"och inte ljus.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Det blir som när man flyr","poem":1},{"text":"för ett lejon men möter en björn,","poem":3},{"text":"och som när man kommer hem","poem":2},{"text":"och stöder handen mot väggen","poem":3},{"text":"och blir biten av en orm.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Ja, Herrens dag är mörker","poem":1},{"text":"och inte ljus,","poem":3},{"text":"becksvart utan en strimma av ljus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Jag hatar era fester, jag föraktar dem,","poem":1},{"text":"jag tål inte era högtider.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"För även om ni offrar","poem":1},{"text":"både brännoffer och matoffer åt mig","poem":2},{"text":"har jag ingen glädje i dem,","poem":3},{"text":"jag vill inte se era gemenskapsoffer","poem":2},{"text":"av gödkalvar.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Ta bort dina sångers buller ifrån mig,","poem":1},{"text":"jag vill inte höra ditt strängaspel.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Men låt rätten flöda fram som vatten","poem":1},{"text":"och rättfärdigheten","poem":2},{"text":"som en ständigt rinnande ström.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Var det åt mig ni frambar","poem":1},{"text":"slaktoffer och matoffer","poem":3},{"text":"under de fyrtio åren i öknen,","poem":2},{"text":"ni av Israels hus?","poem":3},{"noteId":29}]},{"type":"verse","number":26,"content":[{"text":"Ni bar","poem":1},{"noteId":30},{"text":"Sickut, er kung","poem":1},{"noteId":31},{"text":",","poem":1},{"text":"och Kijjun, er guds stjärna","poem":3},{"noteId":32},{"text":",","poem":3},{"text":"era gudabilder som ni gjort åt er.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Men jag ska föra er i fångenskap","poem":1},{"text":"bortom Damaskus,","poem":3},{"noteId":33},{"text":"säger han vars namn är","poem":2},{"text":"Herren Gud Sebaot.","poem":3}]}],"footnotes":[{"noteId":24,"caller":"-","text":"Beer-ShebaEtt stort altare från kungatiden har grävts fram här vid landets södra gräns, ca 7 mil sydväst om Jerusalem. Det avskaffades troligen som avgudaaltare (jfr 8:14) av Hiskia på 710-talet f Kr (2 Kung 18:4).","reference":{"chapter":5,"verse":5}},{"noteId":25,"caller":"-","text":"Josefs husNordriket (se Jos 17:14f, 18:5).","reference":{"chapter":5,"verse":6}},{"noteId":26,"caller":"-","text":"djupa mörkretAnnan översättning: ”dödsskuggan” (jfr Ps 23:4).","reference":{"chapter":5,"verse":8}},{"noteId":27,"caller":"-","text":"starka fästenAnnan översättning: ”de mäktiga”.","reference":{"chapter":5,"verse":9}},{"noteId":28,"caller":"-","text":"hindrar de fattiga att få rätt i portenAnnan översättning: ”visar bort de fattiga i porten”.","reference":{"chapter":5,"verse":12}},{"noteId":29,"caller":"-","text":"Citeras av Stefanus i Apg 7:42f.","reference":{"chapter":5,"verse":25}},{"noteId":30,"caller":"-","text":"Ni barAnnan översättning: ”Ni ska bära” (under assyrisk fångenskap, jfr vers 27).","reference":{"chapter":5,"verse":26}},{"noteId":31,"caller":"-","text":"Sickut, er kungAnnan omvokaliserad översättning: ”Moloks tält” (så Septuaginta, jfr Apg 7:43). Både Sickut och Kijjun är omvokaliseringar av de assyriska gudarna Sakkut och Kewan. Vokalerna i-u har hämtats från hebr. shiqqúts, ”vidrighet”.","reference":{"chapter":5,"verse":26}},{"noteId":32,"caller":"-","text":"er guds stjärnaDe båda avgudarna förknippades med planeten Saturnus.","reference":{"chapter":5,"verse":26}},{"noteId":33,"caller":"-","text":"fångenskap bortom DamaskusNordrikets stammar fördes bort till Assyrien 722 f Kr (1 Kung 17:23).","reference":{"chapter":5,"verse":27}}]},"thisChapterLink":"/api/swe_fol/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}