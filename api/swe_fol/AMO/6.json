{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"AMO","translationId":"swe_fol","name":"Amos","commonName":"Amos","title":"Amos","order":30,"numberOfChapters":9,"sha256":"726aac71e752ac41337c453373fbefc872328a66ad55f416b92b28384ec2b2b5","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swe_fol/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Folkets brist på gudsfruktan"]},{"type":"verse","number":1,"content":["Ve de trygga på Sion,",{"text":"de självsäkra på Samarias berg,","poem":3},{"text":"de förnämsta i det främsta folket","poem":2},{"text":"som Israels hus vänder sig till!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Dra bort till Kalne och se efter,","poem":1},{"text":"gå därifrån till Stora Hamat","poem":2},{"text":"och sedan ner till filisteernas Gat.","poem":3},{"text":"Är de bättre än rikena här,","poem":2},{"text":"eller är deras område","poem":3},{"text":"större än ert område?","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ni skjuter ifrån er den onda dagen","poem":1},{"text":"men låter våldet härska hos er.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ni vilar på divaner av elfenben","poem":1},{"text":"och latar er","poem":3},{"noteId":34},{"text":"på era bäddar.","poem":3},{"text":"Ni äter lamm ur hjorden","poem":2},{"text":"och kalvar från gödstallet.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ni skrålar till harpans ljud","poem":1},{"text":"och tänker ut nya musikinstrument","poem":2},{"text":"som David.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ni dricker vin ur stora skålar","poem":1},{"noteId":35},{"text":"och smörjer er med","poem":2},{"text":"de finaste oljorna,","poem":3},{"text":"men bekymrar er inte","poem":2},{"text":"om Josefs skada.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Därför ska de nu vara först","poem":1},{"text":"att föras bort i fångenskap.","poem":3},{"text":"Då är det slut med skrålet","poem":2},{"text":"från dem som latade sig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Herren Gud","poem":1},{"text":"har svurit vid sig själv,","poem":2},{"text":"säger Herren Gud Sebaot:","poem":3},{"text":"Jag avskyr Jakobs stolthet","poem":2},{"text":"och hatar hans borgar.","poem":3},{"text":"Jag ska utlämna staden","poem":2},{"text":"med allt som finns i den.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":["Och det ska ske att om tio män lämnas kvar i samma hus, ska de alla dö."]},{"type":"verse","number":10,"content":["När en släkting och likbrännare",{"noteId":36},"vill ta ut benen ur huset och ropar till den som är inne i huset: ”Har du någon mer där?” och han svarar: ”Ingen”, så ska han säga: ”Tyst! Herrens namn får inte nämnas",{"noteId":37},".”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["För se, på Herrens befallning",{"text":"ska det stora huset slås i stycken","poem":2},{"text":"och det lilla huset i spillror.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Springer hästar på klippor","poem":1},{"text":"eller plöjer man där med oxar?","poem":3},{"text":"Men ni har förvandlat rätten","poem":2},{"text":"till gift","poem":3},{"text":"och rättfärdighetens frukt","poem":2},{"text":"till malört.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ni gläder er över Lo-Debar","poem":1},{"text":"och säger:","poem":3},{"text":"”Har vi inte intagit Karnajim","poem":2},{"noteId":38},{"text":"med vår egen kraft?”","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":["För se, ni av Israels hus, jag ska uppväcka ett folk mot er, säger Herren Gud Sebaot. Och de ska ansätta er från infartsvägen mot Hamat ända till Arabasänkan",{"noteId":39},"."]}],"footnotes":[{"noteId":34,"caller":"-","text":"latar erAnnan översättning (så Septuaginta): ”festar”.","reference":{"chapter":6,"verse":4}},{"noteId":35,"caller":"-","text":"stora skålarGyllene dryckesskålar är kända från Assyrien. Sådana skålar användes annars i Israel för att samla upp offerdjurens blod (jfr Sak 9:15).","reference":{"chapter":6,"verse":6}},{"noteId":36,"caller":"-","text":"likbrännareAnnan översättning: ”liksmörjaren” (jfr Joh 19:40). Kroppar kremerades normalt inte i Israel.","reference":{"chapter":6,"verse":10}},{"noteId":37,"caller":"-","text":"HERRENS namn får inte nämnasEn försäkran underströks ofta med eden ”så sant HERREN lever” (jfr t ex Rut 3:19, Hos 4:15), vilket nu undveks av rädsla.","reference":{"chapter":6,"verse":10}},{"noteId":38,"caller":"-","text":"Lo-Debar … KarnajimOrter strax öster om Jordanfloden som nyligen hade erövrats av kung Jerobeam II (2 Kung 14:25). Orden betyder ”ingenting” och ”två horn”, vilket symboliserar styrka.","reference":{"chapter":6,"verse":13}},{"noteId":39,"caller":"-","text":"Hamat … ArabasänkanIsraels östra gräns (från norr till söder), nyligen utvidgad enligt en profetia av Jona (2 Kung 14:25).","reference":{"chapter":6,"verse":14}}]},"thisChapterLink":"/api/swe_fol/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}