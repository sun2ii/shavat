{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"AMO","translationId":"swe_fol","name":"Amos","commonName":"Amos","title":"Amos","order":30,"numberOfChapters":9,"sha256":"726aac71e752ac41337c453373fbefc872328a66ad55f416b92b28384ec2b2b5","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swe_fol/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["Israel har mognat för dom"]},{"type":"verse","number":1,"content":["Detta lät Herren Gud mig se: Jag såg en korg med mogen frukt."]},{"type":"verse","number":2,"content":["Han sade: ”Vad ser du, Amos?” Jag svarade: ”En korg med mogen frukt.” Då sade Herren till mig: ”Slutet har kommit för mitt folk Israel. Jag ska inte skona dem igen."]},{"type":"verse","number":3,"content":["Sångerna i borgen ska på den dagen övergå i klagan, säger Herren Gud. Döda kroppar i mängd ska i tysthet kastas överallt.”"]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hör detta,","poem":1},{"text":"ni som trampar på den fattige","poem":3},{"text":"och vill göra slut på de svaga","poem":2},{"noteId":45},{"text":"i landet,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"ni som säger:","poem":1},{"text":"”När är nymånadsdagen slut","poem":2},{"text":"så vi får sälja säd,","poem":3},{"text":"och sabbaten","poem":2},{"text":"så vi får öppna kornboden?","poem":3},{"text":"Då ska vi minska efa-måttet","poem":2},{"noteId":46},{"text":"och höja priset","poem":3},{"text":"och fuska med vågen","poem":2},{"text":"så att den ljuger.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Då ska vi köpa de utblottade","poem":1},{"text":"för pengar","poem":3},{"text":"och den fattige för ett par skor,","poem":2},{"text":"och sälja spillet som säd.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Herren har svurit vid Jakobs stolthet:","poem":1},{"text":"Aldrig ska jag glömma","poem":2},{"text":"någon av deras gärningar.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Skulle inte landet darra","poem":1},{"text":"när sådant sker,","poem":3},{"text":"och skulle inte alla dess invånare","poem":2},{"text":"sörja?","poem":3},{"text":"Skulle inte hela landet","poem":2},{"text":"höja sig som Nilen","poem":3},{"text":"och röras upp och åter sjunka","poem":2},{"noteId":47},{"text":"som Egyptens flod?","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Det ska ske på den dagen,","poem":1},{"text":"säger Herren Gud,","poem":3},{"text":"att jag ska låta solen","poem":2},{"text":"gå ner vid middagstid","poem":3},{"text":"och lägga landet i mörker","poem":2},{"text":"mitt på ljusa dagen.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Jag ska förvandla era högtider","poem":1},{"text":"till sorg","poem":3},{"text":"och alla era sånger","poem":2},{"text":"till klagovisor.","poem":3},{"text":"Jag ska klä allas höfter med säcktyg","poem":2},{"text":"och göra alla huvuden skalliga.","poem":3},{"text":"Jag ska låta det bli","poem":2},{"text":"som när man sörjer ende sonen","poem":3},{"text":"och låta det sluta som en bitter dag.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Se, dagar ska komma,","poem":1},{"text":"säger Herren Gud,","poem":3},{"text":"då jag sänder hunger i landet –","poem":2},{"text":"inte en hunger efter bröd,","poem":3},{"text":"inte en törst efter vatten,","poem":4},{"text":"utan efter att höra Herrens ord.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"De ska irra omkring från hav till hav","poem":1},{"text":"och springa hit och dit","poem":2},{"text":"från norr till öster","poem":3},{"text":"för att söka efter Herrens ord,","poem":2},{"text":"men de ska inte finna det.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"På den dagen","poem":1},{"text":"ska vackra unga kvinnor","poem":3},{"text":"och unga män tyna bort av törst,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"de som svär vid Samarias skam","poem":1},{"noteId":48},{"text":"och säger: ”Leve din gud, Dan!”","poem":2},{"text":"och ”Leve vägen","poem":3},{"text":"till Beer-Sheba!”","poem":4},{"noteId":49},{"text":"De ska falla och inte resa sig mer.","poem":2}]}],"footnotes":[{"noteId":45,"caller":"-","text":"svagaAndra handskrifter: ”ödmjuka”.","reference":{"chapter":8,"verse":4}},{"noteId":46,"caller":"-","text":"efa-måttetCa 22 liter. De som sålde med snåla mått lurade till sig pengar (jfr Ords 11:1, 20:10).","reference":{"chapter":8,"verse":5}},{"noteId":47,"caller":"-","text":"höja sig som Nilen … åter sjunkaVattenståndet i Nilen har historiskt stigit ca tio meter under september-oktober varje år, fram till dess att Assuandammen byggdes år 1970.","reference":{"chapter":8,"verse":8}},{"noteId":48,"caller":"-","text":"Samarias skamSyftar förmodligen på den kananeiska fruktbarhetsgudinnan Ashera (jfr 2 Kung 17:30). Annan översättning: ”Ashima i Samarien”, en syrisk avgud som började införas vid denna tid.","reference":{"chapter":8,"verse":14}},{"noteId":49,"caller":"-","text":"Dan … Beer-ShebaIsraels mest avlägsna norra och södra ort, jfr ”från Smygehuk till Treriksröset”. Båda städerna hyste avgudaaltaren (1 Kung 12:29, 2 Kung 23:8, Amos 5:5).","reference":{"chapter":8,"verse":14}}]},"thisChapterLink":"/api/swe_fol/AMO/8.json","thisChapterAudioLinks":{},"nextChapterA