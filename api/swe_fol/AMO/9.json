{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"AMO","translationId":"swe_fol","name":"Amos","commonName":"Amos","title":"Amos","order":30,"numberOfChapters":9,"sha256":"726aac71e752ac41337c453373fbefc872328a66ad55f416b92b28384ec2b2b5","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swe_fol/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Israels förödelse"]},{"type":"verse","number":1,"content":["Jag såg Herren stå vid altaret,",{"text":"och han sade:","poem":3},{"text":"Slå till pelarhuvudena","poem":2},{"text":"så att trösklarna skakar,","poem":3},{"text":"och låt spillrorna falla","poem":2},{"text":"över huvudet på dem alla.","poem":3},{"text":"Dem som är kvar","poem":2},{"text":"ska jag döda med svärd.","poem":3},{"text":"Ingen av dem ska kunna fly,","poem":2},{"text":"ingen av dem ska kunna","poem":3},{"text":"rädda sig.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Även om de bröt sig in i dödsriket","poem":1},{"text":"skulle min hand","poem":2},{"text":"hämta dem därifrån,","poem":3},{"text":"även om de steg upp till himlen","poem":2},{"text":"skulle jag störta ner dem därifrån.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Även om de gömde sig","poem":1},{"text":"på toppen av Karmel","poem":3},{"noteId":50},{"text":"skulle jag hitta dem där","poem":2},{"text":"och hämta ner dem.","poem":3},{"text":"Även om de gömde sig","poem":2},{"text":"för min blick på havets botten","poem":3},{"text":"skulle jag där befalla ormen","poem":2},{"text":"att bita dem.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Även om de gick i fångenskap","poem":1},{"text":"framför sina fiender","poem":3},{"text":"skulle jag där befalla svärdet","poem":2},{"text":"att komma och döda dem.","poem":3},{"text":"Och jag ska fästa min blick på dem","poem":2},{"text":"till deras olycka","poem":3},{"text":"och inte till deras lycka.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Herren Gud Sebaot","poem":1},{"text":"rör vid jorden och den smälter,","poem":2},{"text":"och alla dess invånare sörjer.","poem":3},{"text":"Hela jorden höjer sig som Nilen","poem":2},{"text":"och sjunker åter","poem":3},{"text":"som Egyptens flod.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Han bygger sin sal i himlen","poem":1},{"text":"och grundar sitt valv över jorden,","poem":3},{"text":"han kallar på havets vatten","poem":2},{"text":"och öser ut det över jordens yta –","poem":3},{"text":"Herren är hans namn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Är ni inte som nubierna","poem":1},{"text":"i mina ögon, ni Israels barn?","poem":2},{"text":"säger Herren.","poem":3},{"text":"Förde jag inte Israel","poem":2},{"text":"upp ur Egyptens land,","poem":3},{"text":"filisteerna från Kaftor","poem":2},{"noteId":51},{"text":"och arameerna från Kir?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Se, Herren Guds ögon","poem":1},{"text":"är emot detta syndiga rike,","poem":3},{"text":"och jag ska utplåna det","poem":2},{"text":"från jordens yta.","poem":3},{"text":"Ändå vill jag inte utplåna","poem":2},{"text":"Jakobs hus helt,","poem":3},{"text":"säger Herren.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"För se, jag befaller att Israels hus","poem":1},{"text":"ska sållas bland alla hednafolk","poem":2},{"text":"som man siktar i ett såll.","poem":3},{"text":"Inte minsta korn","poem":2},{"noteId":52},{"text":"ska falla till marken.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Alla syndare i mitt folk","poem":1},{"text":"ska dö för svärd, de som säger:","poem":3},{"text":"”Olyckan når oss inte,","poem":2},{"text":"den kommer inte i närheten","poem":3},{"text":"av oss.”","poem":4}]},{"type":"heading","content":["Löfte om upprättelse"]},{"type":"verse","number":11,"content":[{"text":"På den dagen ska jag resa upp","poem":1},{"text":"Davids fallna hydda,","poem":3},{"text":"mura igen dess sprickor","poem":2},{"text":"och resa upp dess ruiner.","poem":3},{"text":"Jag ska bygga upp den","poem":2},{"text":"som i forna dagar,","poem":3},{"noteId":53}]},{"type":"verse","number":12,"content":[{"text":"så att de kan ta i besittning","poem":1},{"text":"vad som är kvar av Edom","poem":2},{"text":"och av alla hednafolk","poem":3},{"text":"över vilka mitt namn har nämnts,","poem":2},{"text":"säger Herren som gör detta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Se, dagar ska komma, säger Herren,","poem":1},{"text":"då plöjaren ska följa","poem":2},{"text":"skördemannen i spåren","poem":3},{"text":"och druvtramparen","poem":2},{"text":"såningsmannen,","poem":3},{"text":"då bergen ska drypa av druvsaft","poem":2},{"text":"och alla höjder flöda över.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Jag ska göra slut","poem":1},{"text":"på mitt folk Israels fångenskap.","poem":3},{"text":"De ska bygga upp ödelagda städer","poem":2},{"text":"och få bo i dem,","poem":3},{"text":"de ska plantera vingårdar","poem":2},{"text":"och få dricka vinet från dem,","poem":3},{"text":"de ska anlägga trädgårdar","poem":2},{"text":"och få äta deras frukt.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Jag ska plantera dem","poem":1},{"text":"i deras eget land.","poem":3},{"text":"De ska inte mer ryckas upp","poem":2},{"text":"ur det land som jag gett dem,","poem":3},{"text":"säger Herren din Gud.","poem":2}]}],"footnotes":[{"noteId":50,"caller":"-","text":"KarmelBergsrygg vid Israels kust i nordväst som höjer sig 550 meter över vattenytan.","reference":{"chapter":9,"verse":3}},{"noteId":51,"caller":"-","text":"KaftorFilisteerna kom till Gazaremsan på 1200-talet f Kr från Kreta och andra medelhavsöar.","reference":{"chapter":9,"verse":7}},{"noteId":52,"caller":"-","text":"Inte minsta kornSåll brukar släppa igenom stoft och bevara sädeskornen (jfr Luk 22:31). Annan översättning: ”Inte en sten” (grövre såll under antiken kan ha fungerat tvärtom).","reference":{"chapter":9,"verse":9}},{"noteId":53,"caller":"-","text":"Citeras av Jakob i Apg 15:16f som profetia om hur hedningarna inlemmas i tron på Kristus. Att uttala sitt namn över något innebar ägande och beskydd (jfr Jak 2:7).","reference":{"chapter":9,"verse":11}}]},"thisChapterLink":"/api/swe_fol/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}