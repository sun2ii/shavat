{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"DEU","translationId":"swe_fol","name":"Femte Moseboken","commonName":"Femte Moseboken","title":"Femte Moseboken","order":5,"numberOfChapters":34,"sha256":"5664fee515aa1577ec7600c5a75aba7eeb49288e95cb216340443da98732aa28","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/swe_fol/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Lyssna, ni himlar, jag vill tala!",{"lineBreak":true},{"text":"Hör, du jord, min muns ord!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Som regnet ska min lära droppa,","poem":1},{"text":"som daggen ska mitt tal flöda,","poem":3},{"text":"som rikligt regn på grönska,","poem":2},{"text":"som regnskurar på gräs.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Herrens namn ska jag förkunna.","poem":1},{"text":"Ge ära åt vår store Gud!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Han är Klippan,","poem":1},{"text":"fullkomliga är hans gärningar,","poem":2},{"text":"för alla hans vägar är rätta.","poem":3},{"text":"En trofast Gud utan svek,","poem":2},{"text":"rättfärdig och rättvis är han.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"De har handlat illa mot honom,","poem":1},{"text":"de är inte hans barn utan en skam,","poem":2},{"text":"ett förvänt och avogt släkte.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Är det så du lönar Herren,","poem":1},{"text":"du dåraktiga och ovisa folk?","poem":3},{"text":"Är han inte din Far","poem":2},{"text":"som skapade dig,","poem":3},{"text":"han som danade och formade dig?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kom ihåg forna dagar.","poem":1},{"text":"Ge akt på gångna släktens år.","poem":3},{"text":"Fråga din far,","poem":2},{"text":"han ska berätta för dig,","poem":3},{"text":"dina äldste, de ska säga dig det.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"När den Högste gav arvslotter","poem":1},{"text":"åt folken,","poem":3},{"text":"när han spred ut människors barn,","poem":2},{"text":"då utstakade han gränserna","poem":3},{"text":"för folken","poem":4},{"text":"efter antalet av Israels barn","poem":3},{"noteId":143},{"text":",","poem":3}]},{"type":"verse","number":9,"content":[{"text":"för Herrens del är hans folk,","poem":1},{"text":"Jakob är hans arvedels lott.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Han fann honom i öknens land,","poem":1},{"text":"i ödslig, tjutande ödemark.","poem":3},{"text":"Han omslöt honom","poem":2},{"text":"och tog honom i sin vård,","poem":3},{"text":"han bevarade honom","poem":2},{"text":"som sin ögonsten","poem":3},{"noteId":144},{"text":".","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Som en örn väcker upp sitt bo","poem":1},{"text":"och svävar över sina ungar,","poem":3},{"text":"så bredde han ut sina vingar","poem":2},{"text":"och tog emot honom","poem":3},{"text":"och bar honom på sina fjädrar.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Endast Herren ledde honom,","poem":1},{"text":"ingen främmande gud","poem":2},{"text":"vid hans sida.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Han lät honom gå fram","poem":1},{"text":"över landets höjder","poem":2},{"noteId":145},{"text":"och äta av markens gröda.","poem":3},{"text":"Han lät honom suga honung","poem":2},{"text":"ur berget","poem":3},{"text":"och olja ur den hårda klippan.","poem":2},{"noteId":146}]},{"type":"verse","number":14,"content":[{"text":"Han gav honom gräddmjölk av kor","poem":1},{"text":"och sötmjölk av får","poem":2},{"text":"med det bästa av lamm,","poem":3},{"text":"baggar från Bashan","poem":2},{"noteId":147},{"text":"och bockar,","poem":2},{"text":"det bästa och finaste vete.","poem":3},{"text":"Druvors blod fick du dricka,","poem":2},{"text":"skummande vin.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Då blev Jeshurun","poem":1},{"noteId":148},{"text":"fet och slog bakut.","poem":1},{"text":"Du blev fet och tjock och stinn.","poem":3},{"text":"Han övergav Gud, sin skapare,","poem":2},{"text":"och föraktade","poem":3},{"text":"sin frälsnings klippa.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"De retade honom","poem":1},{"text":"med främmande gudar,","poem":3},{"text":"väckte hans vrede med vidrigheter.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"De offrade åt onda andar","poem":1},{"text":"som inte är Gud,","poem":2},{"text":"åt gudar de inte kände,","poem":3},{"text":"nya gudar som nyss kommit till","poem":2},{"text":"och som era fäder inte fruktade.","poem":3},{"noteId":149}]},{"type":"verse","number":18,"content":[{"text":"Du övergav Klippan","poem":1},{"text":"som födde dig,","poem":3},{"text":"du glömde Gud som gav dig livet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Herren såg det och förkastade dem,","poem":1},{"text":"eftersom hans söner och döttrar","poem":2},{"text":"hade kränkt honom.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Han sade:","poem":1},{"text":"Jag ska dölja mitt ansikte för dem,","poem":2},{"text":"jag ska se vilket slut de får,","poem":3},{"text":"för de är ett förvänt släkte,","poem":2},{"text":"barn utan trohet.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"De har provocerat mig","poem":1},{"text":"med gudar som inte är gudar,","poem":3},{"text":"väckt min vrede","poem":2},{"text":"med sina tomma avgudar.","poem":3},{"text":"Därför ska jag provocera dem","poem":2},{"text":"med det som inte är ett folk,","poem":3},{"text":"med ett dåraktigt hednafolk","poem":2},{"text":"ska jag väcka deras förtret.","poem":3},{"noteId":150}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"För en eld är tänd av min vrede,","poem":1},{"text":"den brinner till dödsrikets djup.","poem":3},{"text":"Den förtär jorden med dess gröda","poem":2},{"text":"och sätter bergens grundvalar","poem":3},{"text":"i brand.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"Jag ska hopa olyckor över dem,","poem":1},{"text":"jag ska skjuta mina pilar","poem":2},{"text":"mot dem.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Svält ska drabba dem,","poem":1},"feberglöd förtära dem,",{"text":"pest som bittert pinar.","poem":3},{"text":"Jag ska sända vilddjurens tänder","poem":2},{"text":"mot dem","poem":4},{"text":"och gift från ormar","poem":3},{"lineBreak":true},{"text":"som krälar i stoftet.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Ute ska svärdet dräpa deras barn,","poem":1},{"text":"inne gör skräcken det.","poem":3},{"text":"Unga män och jungfrur förgås,","poem":2},{"text":"spädbarn och grånade män.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Jag skulle säga:","poem":1},{"text":"Jag ska skingra dem,","poem":2},{"text":"utplåna minnet av dem","poem":3},{"text":"bland människor,","poem":4}]},{"type":"verse","number":27,"content":[{"text":"om jag inte fruktade","poem":1},{"text":"fiendens hån,","poem":3},{"text":"att deras ovänner","poem":2},{"text":"skulle misstolka det och säga:","poem":3},{"text":"Vår hand är mäktig,","poem":2},{"text":"det var inte Herren","poem":3},{"text":"som gjorde allt detta.","poem":4}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"De är ett rådlöst folk,","poem":1},{"text":"och förstånd finns inte i dem.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vore de visa skulle de inse detta,","poem":1},{"text":"de skulle förstå vilket slut","poem":2},{"text":"de måste få.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Hur kan en jaga tusen framför sig,","poem":1},{"text":"två driva tiotusen på flykten,","poem":3},{"text":"om inte deras Klippa","poem":2},{"text":"hade sålt dem,","poem":3},{"text":"Herren hade utlämnat dem?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Våra fienders klippa","poem":1},{"text":"är inte som vår Klippa,","poem":2},{"text":"det kan de själva döma om,","poem":3}]},{"type":"verse","number":32,"content":[{"text":"för deras vinstock","poem":1},{"text":"är från Sodoms vinstock","poem":2},{"text":"och från Gomorras fält.","poem":3},{"text":"Deras druvor är giftiga druvor,","poem":2},{"text":"deras klasar är beska.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Deras vin är ormars etter,","poem":1},{"text":"kobrors grymma gift.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Sådant ligger förvarat hos mig,","poem":1},{"text":"förseglat i mina förrådshus.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Min är hämnden","poem":1},{"noteId":151},{"text":"och vedergällningen","poem":3},{"text":"vid tiden då deras fot ska vackla,","poem":2},{"text":"för deras olyckas dag är nära,","poem":3},{"text":"det som väntar dem","poem":2},{"text":"kommer med hast.","poem":3}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"Herren ska ta sig an sitt folks sak","poem":1},{"text":"och förbarma sig","poem":2},{"text":"över sina tjänare,","poem":3},{"text":"när han ser att deras kraft är borta","poem":2},{"text":"och att ingen finns kvar,","poem":3},{"text":"varken slav eller fri.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Då ska han fråga:","poem":1},{"text":"Var är deras gudar,","poem":2},{"text":"klippan som de flydde till,","poem":3}]},{"type":"verse","number":38,"content":[{"text":"de som åt","poem":1},{"noteId":152},{"text":"deras slaktoffers fett","poem":1},{"text":"och drack deras","poem":2},{"text":"dryckesoffers vin?","poem":3},{"text":"De får komma och hjälpa er,","poem":2},{"text":"de får vara ert beskydd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Se nu: Jag, jag är Gud,","poem":1},{"text":"det finns ingen Gud","poem":2},{"text":"vid sidan av mig.","poem":3},{"text":"Jag dödar och jag gör levande,","poem":2},{"text":"jag slår och jag helar.","poem":3},{"text":"Ingen kan rädda ur min hand.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Se, jag lyfter min hand","poem":1},{"text":"mot himlen och säger:","poem":3},{"text":"Så sant jag lever för evigt:","poem":2}]},{"type":"verse","number":41,"content":[{"text":"När jag vässat","poem":1},{"text":"mitt flammande svärd","poem":2},{"text":"och min hand skipar rätt,","poem":3},{"text":"ska jag ta hämnd på mina ovänner","poem":2},{"text":"och straffa dem som hatar mig.","poem":3}]},{"type":"verse","number":42,"content":[{"text":"Jag ska göra mina pilar","poem":1},{"text":"berusade av blod,","poem":3},{"text":"mitt svärd ska mätta sig av kött,","poem":2},{"text":"av fallnas och fångnas blod,","poem":3},{"text":"av fiendehövdingars huvuden.","poem":4}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"noteId":153},{"text":"Jubla, ni hednafolk","poem":1},{"text":"tillsammans med hans folk,","poem":2},{"noteId":154},{"text":"för han hämnas sina tjänares blod.","poem":3},{"text":"Han tar hämnd på sina ovänner","poem":2},{"text":"och bringar försoning för sitt land,","poem":3},{"text":"sitt folk.","poem":4}]},{"type":"line_break"},{"type":"verse","number":44,"content":["Mose kom tillsammans med Hosea",{"noteId":155},", Nuns son, och talade hela denna sångs ord inför folket."]},{"type":"verse","number":45,"content":["Och när Mose hade talat alla dessa ord till hela Israel,"]},{"type":"verse","number":46,"content":["sade han till dem: ”Lägg på hjärtat alla de ord som jag i dag gör till vittnen mot er, så att ni befaller era barn att hålla fast vid och följa alla ord i denna lag."]},{"type":"verse","number":47,"content":["Detta är inte ett tomt ord för er, det gäller ert liv. Genom detta ord ska ni få ett långt liv i det land, dit ni nu går över Jordan för att ta det i besittning.”"]},{"type":"heading","content":["Gud talar om Moses död"]},{"type":"verse","number":48,"content":["Samma dag talade Herren till Mose och sade:"]},{"type":"verse","number":49,"content":["”Stig upp här på Abarimberget, på berget Nebo",{"noteId":156},"i Moabs land mitt emot Jeriko, så ska du få se Kanaans land som jag ger åt Israels barn till besittning."]},{"type":"verse","number":50,"content":["Du ska dö där på berget dit du stiger upp, och du ska samlas till ditt folk, liksom din bror Aron dog på berget Hor",{"noteId":157},"och samlades till sitt folk."]},{"type":"verse","number":51,"content":["Detta sker för att ni var trolösa mot mig mitt bland Israels barn vid Meribas vatten",{"noteId":158},"vid Kadesh i öknen Zin, eftersom ni inte höll mig helig bland Israels barn."]},{"type":"verse","number":52,"content":["Du ska se landet rakt framför dig, men du ska inte komma in dit, till det land som jag ger åt Israels barn.”"]}],"footnotes":[{"noteId":143,"caller":"-","text":"Israels barnAndra handskrifter (Septuaginta och Qumran): ”Guds söner” (änglarna).","reference":{"chapter":32,"verse":8}},{"noteId":144,"caller":"-","text":"sin ögonstenOrdagrant: ”den lille mannen i sitt öga”, alltså den känsliga pupillen.","reference":{"chapter":32,"verse":10}},{"noteId":145,"caller":"-","text":"landets höjderEn stark position med överblick (Dom 5:18, Ps 18:34). Bergsbygden var den första delen av landet som intogs av israeliterna (Dom 1:19).","reference":{"chapter":32,"verse":13}},{"noteId":146,"caller":"-","text":"honung ur berget och olja ur … klippanBikupor i klippskrevor och olivträd på bergshöjder.","reference":{"chapter":32,"verse":13}},{"noteId":147,"caller":"-","text":"baggar från BashanGolanhöjderna, där det bästa betet fanns (jfr Amos 4:1).","reference":{"chapter":32,"verse":14}},{"noteId":148,"caller":"-","text":"JeshurunPoetiskt namn på Israel, troligen bildat av Jashár, ”rättrådig”.","reference":{"chapter":32,"verse":15}},{"noteId":149,"caller":"-","text":"fruktadeAnnan översättning: ”kände till”.","reference":{"chapter":32,"verse":17}},{"noteId":150,"caller":"-","text":"Citeras av Paulus i Rom 10:19 i samband med hedningarnas frälsning.","reference":{"chapter":32,"verse":21}},{"noteId":151,"caller":"-","text":"Min är hämndenCiteras i Rom 12:19 och Hebr 10:30.","reference":{"chapter":32,"verse":35}},{"noteId":152,"caller":"-","text":"de som åtHednagudar ansågs beroende av sina offer, till skillnad från Israels Gud (Ps 50:9f).","reference":{"chapter":32,"verse":38}},{"noteId":153,"caller":"-","text":"Septuaginta tillägger i början av versen: ”Jubla, ni himlar, tillsammans med honom! Alla Guds söner ska tillbe honom.” Citeras i Hebr 1:6 som profetia om Kristus.","reference":{"chapter":32,"verse":43}},{"noteId":154,"caller":"-","text":"Jubla, ni hednafolk tillsammans med hans folkCiteras av Paulus i Rom 15:10.","reference":{"chapter":32,"verse":43}},{"noteId":155,"caller":"-","text":"HoseaVariant på namnet Josua, hans ursprungliga namn (4 Mos 13:17).","reference":{"chapter":32,"verse":44}},{"noteId":156,"caller":"-","text":"Abarimberget … NeboBergskedja och topp ca en mil öster om Döda havets nordspets.","reference":{"chapter":32,"verse":49}},{"noteId":157,"caller":"-","text":"Aron dog på berget HorSe 4 Mos 20:23f, 33:38.","reference":{"chapter":32,"verse":50}},{"noteId":158,"caller":"-","text":"trolösa … vid Meribas vattenSe 4 Mos 20, Ps 106:32.","reference":{"chapter":32,"verse":51}}]},"thisChapterLink":"/api/swe_fol/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}