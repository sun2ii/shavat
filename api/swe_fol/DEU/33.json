{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"DEU","translationId":"swe_fol","name":"Femte Moseboken","commonName":"Femte Moseboken","title":"Femte Moseboken","order":5,"numberOfChapters":34,"sha256":"5664fee515aa1577ec7600c5a75aba7eeb49288e95cb216340443da98732aa28","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/swe_fol/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Mose välsignar Israel"]},{"type":"verse","number":1,"content":["Detta är den välsignelse som gudsmannen Mose uttalade över Israels barn före sin död."]},{"type":"verse","number":2,"content":["Han sade:",{"lineBreak":true},{"text":"Herren kom från Sinai,","poem":1},{"text":"han gick upp över dem från Seir.","poem":3},{"text":"Han strålade fram från berget Paran,","poem":2},{"text":"ur skaran av mångtusen heliga.","poem":3},{"text":"På hans högra sida","poem":2},{"text":"brann i eld en lag för dem.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"I sanning älskar han folken.","poem":1},{"text":"Alla hans heliga är i din hand.","poem":3},{"text":"De faller ner vid din fot,","poem":2},{"text":"de tar emot av dina ord.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mose gav oss en lag,","poem":1},{"text":"en arvedel för Jakobs församling.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Han blev kung i Jeshurun","poem":1},{"text":"när folkets huvudmän samlades,","poem":3},{"text":"Israels alla stammar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Låt Ruben leva och inte dö.","poem":1},"Men hans män blir en liten skara."]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Detta sade han om Juda:","poem":1},{"text":"Hör, o Herre, Juda röst,","poem":2},{"text":"låt honom komma till sitt folk.","poem":3},{"text":"Med sina händer strider han","poem":2},{"text":"för dem.","poem":3},{"text":"Bli hans hjälp mot hans fiender.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Om Levi sade han:","poem":1},{"text":"Dina tummim","poem":2},{"noteId":159},{"text":"och dina urim","poem":2},{"noteId":160},{"text":"tillhör din trogne","poem":3},{"text":"som du prövade i Massa,","poem":2},{"text":"som du kämpade med","poem":3},{"text":"vid Meribas vatten,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"han som sade om sin far och sin mor:","poem":1},{"text":"’Jag ser dem inte’,","poem":2},{"text":"som inte ville kännas vid","poem":3},{"text":"sina bröder","poem":4},{"noteId":161},{"text":"eller veta av sina barn,","poem":2},{"text":"för de tog vara på ditt ord","poem":3},{"text":"och höll ditt förbund.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"De ska lära Jakob dina förordningar","poem":1},{"text":"och Israel din lag.","poem":3},{"text":"De ska bära fram rökelse","poem":2},{"text":"för din näsa","poem":3},{"noteId":162},{"text":"och heloffer på ditt altare.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Välsigna, o Herre, hans kraft,","poem":1},{"text":"låt hans händers verk behaga dig.","poem":3},{"text":"Krossa höfterna","poem":2},{"text":"på hans motståndare","poem":3},{"text":"så att hans fiender","poem":2},{"text":"inte kan resa sig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Om Benjamin sade han:","poem":1},{"text":"Herrens älskade","poem":2},{"text":"ska bo i trygghet hos honom","poem":3},{"text":"som alltid skyddar honom.","poem":4},{"text":"Mellan hans höjder ska han bo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Om Josef sade han:","poem":1},{"text":"Må hans land","poem":2},{"text":"bli välsignat av Herren","poem":3},{"text":"med himlens ädlaste gåvor,","poem":2},{"text":"med dagg,","poem":3},{"text":"med gåvor från djupet","poem":2},{"text":"som ligger där nere,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"med solens finaste skördar","poem":1},{"text":"och månvarvens finaste frukter,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"med de uråldriga bergens","poem":1},{"text":"yppersta skatter","poem":3},{"text":"och de eviga höjdernas","poem":2},{"text":"finaste frukt,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"med jordens finaste frukt","poem":1},{"text":"och all dess fullhet,","poem":3},{"text":"med nåd från honom","poem":2},{"text":"som bodde i busken","poem":3},{"noteId":163},{"text":".","poem":3},{"text":"Låt detta komma","poem":2},{"text":"över Josefs huvud,","poem":3},{"text":"över hjässan på fursten","poem":2},{"text":"bland bröder.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Härlig är den förstfödde","poem":1},{"text":"bland hans tjurar,","poem":2},{"text":"som vildoxens är hans horn.","poem":3},{"text":"Med dem stångar han folken,","poem":2},{"text":"också dem som bor","poem":3},{"text":"vid jordens ändar.","poem":4},{"text":"Sådana är Efraims tiotusenden,","poem":2},{"text":"sådana Manasses tusenden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Om Sebulon sade han:","poem":1},{"text":"Gläd dig, Sebulon, när du drar ut,","poem":2},{"text":"och du Isaskar i dina tält.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"De bjuder in folk till sitt berg,","poem":1},{"text":"där offrar de rätta offer,","poem":3},{"text":"för de suger till sig havens rikedom","poem":2},{"text":"och skatter dolda i sanden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Om Gad sade han:","poem":1},{"text":"Lovad är han","poem":2},{"text":"som gav rymligt land åt Gad!","poem":3},{"text":"Han bor som en lejonhona","poem":2},{"text":"och krossar både arm och hjässa.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Han utsåg den bästa delen","poem":1},{"text":"åt sig själv,","poem":3},{"text":"för där var hans","poem":2},{"text":"härskarlott förvarad.","poem":3},{"text":"När folkets huvudmän","poem":2},{"text":"kom samman,","poem":3},{"text":"utförde han Herrens rätt","poem":2},{"text":"och hans domar med Israel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Om Dan sade han:","poem":1},{"text":"Dan är ett ungt lejon","poem":2},{"text":"som rusar ner från Bashan.","poem":3},{"noteId":164}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Om Naftali sade han:","poem":1},{"text":"Naftali har fått riklig nåd","poem":2},{"text":"och full välsignelse av Herren.","poem":3},{"text":"Väster och söder","poem":2},{"text":"ska du ta i besittning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Om Asher sade han:","poem":1},{"text":"Välsignad bland söner","poem":2},{"text":"är Asher.","poem":3},{"text":"Må han bli älskad av sina bröder","poem":2},{"text":"och doppa sin fot i olja.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Av järn och koppar","poem":1},{"text":"ska dina reglar vara,","poem":2},{"text":"och som dina dagar din kraft.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ingen är som Jeshuruns Gud,","poem":1},{"text":"han som far fram på himlen","poem":2},{"text":"till din hjälp,","poem":3},{"text":"på skyarna i sitt majestät.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"En tillflykt är han, urtidens Gud,","poem":1},{"text":"och här nere råder","poem":2},{"text":"hans eviga armar.","poem":3},{"text":"Han ska jaga fienderna framför dig","poem":2},{"text":"och säga: Förgör dem!","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Så ska Israel bo i trygghet,","poem":1},{"text":"Jakobs källa lämnas ifred","poem":2},{"text":"i ett land med säd och vin,","poem":3},{"text":"under en himmel","poem":2},{"text":"som dryper av dagg.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Salig är du, Israel.","poem":1},{"text":"Vem är som du?","poem":3},{"text":"Du är ett folk","poem":2},{"text":"som har sin räddning i Herren.","poem":3},{"text":"Han är din skyddande sköld,","poem":2},{"text":"ditt ärorika svärd.","poem":3},{"text":"Dina fiender ska krypa för dig,","poem":2},{"text":"och du ska gå fram","poem":3},{"text":"över deras höjder.","poem":4}]}],"footnotes":[{"noteId":159,"caller":"-","text":"Dina tummimAndra handskrifter (så Septuaginta): ”Ge Levi dina tummim”.","reference":{"chapter":33,"verse":8}},{"noteId":160,"caller":"-","text":"tummim … urimTvå stenar, kanske ljus och mörk, som användes för att söka Guds vilja genom lottkastning (4 Mos 27:21, 1 Sam 28:6, Ords 16:33).","reference":{"chapter":33,"verse":8}},{"noteId":161,"caller":"-","text":"inte ville kännas vid sina bröderVid Guds straffdom efter guldkalven (se 4 Mos 32:27).","reference":{"chapter":33,"verse":9}},{"noteId":162,"caller":"-","text":"för din näsaAnnan översättning (så Septuaginta): ”för din vrede” (jfr 4 Mos 16:46).","reference":{"chapter":33,"verse":10}},{"noteId":163,"caller":"-","text":"bodde i buskenDen brinnande busken där Gud uppenbarade sig för Mose (2 Mos 3).","reference":{"chapter":33,"verse":16}},{"noteId":164,"caller":"-","text":"BashanGolanhöjderna. Dan flyttade senare till området nordväst om Bashan (se Dom 18).","reference":{"chapter":33,"verse":22}}]},"thisChapterLink":"/api/swe_fol/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}