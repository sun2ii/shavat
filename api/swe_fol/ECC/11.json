{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ECC","translationId":"swe_fol","name":"Predikaren","commonName":"Predikaren","title":"Predikaren","order":21,"numberOfChapters":12,"sha256":"acabe7f92505034171e456e56f58c746fa3e4624896c441cdd430b17774bd86b","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/swe_fol/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["Du kan inte se in i framtiden"]},{"type":"verse","number":1,"content":["Sänd ditt bröd över vattnet",{"noteId":44},",",{"text":"för med tiden","poem":2},{"text":"får du det tillbaka.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Dela vad du har i sju delar, ja, åtta,","poem":1},{"text":"för du vet inte vilken olycka","poem":2},{"text":"som kan drabba landet.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"När molnen blir fulla","poem":1},{"text":"tömmer de sitt regn över jorden,","poem":3},{"text":"och faller ett träd","poem":2},{"text":"mot söder eller norr","poem":3},{"text":"så ligger det på platsen","poem":2},{"text":"där det föll.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Den som spejar efter vind","poem":1},{"text":"får aldrig så,","poem":3},{"text":"den som ser efter moln","poem":2},{"text":"får inget skörda.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Liksom du inte vet vart vinden far","poem":1},{"text":"eller hur benen bildas","poem":2},{"noteId":45},{"text":"i moderlivet,","poem":3},{"text":"så förstår du inte heller Guds verk,","poem":2},{"text":"hur han gör alltsammans.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Så din säd om morgonen","poem":1},{"text":"och låt inte din hand","poem":2},{"text":"vila om kvällen,","poem":3},{"text":"för du vet inte vad som lyckas bäst,","poem":2},{"text":"det ena eller det andra","poem":3},{"text":"eller om båda är lika bra.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ljuset är ljuvligt,","poem":1},{"text":"och det är gott för ögonen","poem":2},{"text":"att se solen.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Om en människa får leva många år,","poem":1},{"text":"bör hon glädja sig under dem alla","poem":3},{"text":"och minnas","poem":2},{"text":"att det blir många mörka dagar.","poem":3},{"text":"Allt som kommer är förgängligt.","poem":2}]},{"type":"heading","content":["Ungdom och åldrande"]},{"type":"verse","number":9,"content":[{"text":"Du som är ung,","poem":1},{"text":"gläd dig i din ungdom,","poem":3},{"text":"låt ditt hjärta ha det gott","poem":2},{"text":"i din ungdoms dagar.","poem":3},{"text":"Vandra ditt hjärtas vägar,","poem":2},{"text":"följ det dina ögon ser.","poem":3},{"text":"Men tänk på att för allt detta","poem":2},{"text":"kommer Gud att kalla dig","poem":3},{"text":"till doms.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Låt sorgen","poem":1},{"noteId":46},{"text":"vika ur ditt hjärta","poem":1},{"text":"och håll det onda borta","poem":2},{"text":"från din kropp.","poem":3},{"text":"För ungdomstiden","poem":2},{"text":"och blomstringstiden","poem":3},{"text":"är förgänglig.","poem":4}]}],"footnotes":[{"noteId":44,"caller":"-","text":"Sänd ditt bröd över vattnetJfr Salomos handelsflotta (1 Kung 9:26f, 10:22).","reference":{"chapter":11,"verse":1}},{"noteId":45,"caller":"-","text":"vart vinden far eller hur benen bildasAnnan översättning: ”hur anden verkar när benen bildas”.","reference":{"chapter":11,"verse":5}},{"noteId":46,"caller":"-","text":"sorgenAnnan översättning: ”vreden” eller ”oron”.","reference":{"chapter":11,"verse":10}}]},"thisChapterLink":"/api/swe_fol/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}