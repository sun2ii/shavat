{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ECC","translationId":"swe_fol","name":"Predikaren","commonName":"Predikaren","title":"Predikaren","order":21,"numberOfChapters":12,"sha256":"acabe7f92505034171e456e56f58c746fa3e4624896c441cdd430b17774bd86b","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/swe_fol/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":["För vem vet vad som är gott för människan i livet under hennes förgängliga livsdagar där hon lever som en skugga? Och vem kan säga en människa vad som kommer att ske efter henne under solen?"]},{"type":"heading","content":["Livsvisdom"]},{"type":"verse","number":2,"content":["Bättre gott namn än god salva",{"noteId":24},",",{"text":"och bättre dödens dag","poem":2},{"text":"än födelsens dag.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Bättre gå till sorgehus","poem":1},{"text":"än till gästabud,","poem":3},{"text":"för det är slutet för alla människor,","poem":2},{"text":"och den som lever","poem":3},{"text":"bör ta det till hjärtat.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bättre sorg än skratt,","poem":1},{"text":"av plågat ansikte mår hjärtat bra.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"De visas hjärtan är i sorgens hus,","poem":1},{"text":"dårarnas hjärtan i glädjens hus.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bättre höra den vises tillrättavisning","poem":1},{"text":"än höra dårars sång,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"för dårens skratt är som","poem":1},{"text":"sprakandet av törne","poem":2},{"noteId":25},{"text":"under grytan.","poem":3},{"text":"Också det är förgängligt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Oärlig vinst gör den vise till en dåre,","poem":1},{"text":"mutor fördärvar hjärtat.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bättre slutet på en sak än dess början,","poem":1},{"text":"bättre tålmodig än högmodig.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Var inte snar till vrede,","poem":1},{"text":"för vrede bor i dårars bröst.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Fråga inte:","poem":1},{"text":"Varför var det bättre förr?","poem":3},{"text":"Det är inte av vishet du frågar så.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vishet är lika gott som ett arv","poem":1},{"noteId":26},{"text":",","poem":1},{"text":"en förmån för dem som ser solen.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vishetens beskydd","poem":1},{"text":"är som pengars beskydd.","poem":3},{"text":"Men kunskapens fördel","poem":2},{"text":"är att visheten ger liv","poem":3},{"text":"åt sin ägare.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Se på Guds verk:","poem":1},{"text":"Vem kan göra rakt","poem":2},{"text":"det han har gjort krokigt?","poem":3}]},{"type":"verse","number":15,"content":[{"text":"På glädjens dag ska du vara glad,","poem":1},{"text":"på olyckans dag ska du tänka på","poem":2},{"text":"att Gud har gjort","poem":3},{"text":"både den ena och den andra,","poem":4},{"text":"för att människan inte ska förstå","poem":2},{"text":"vad som kommer efter henne.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Allt har jag sett","poem":1},{"text":"under mina förgängliga dagar:","poem":3},{"text":"Den rättfärdige går under","poem":2},{"text":"i sin rättfärdighet,","poem":3},{"text":"den ogudaktige lever länge","poem":2},{"text":"i sin ondska.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Var inte alltför rättfärdig","poem":1},{"text":"och inte alltför vis.","poem":3},{"text":"Varför förstöra dig själv?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Var inte alltför ogudaktig","poem":1},{"text":"och inte dåraktig.","poem":3},{"text":"Varför dö före din tid?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Det är bäst att hålla fast vid det ena","poem":1},{"text":"utan att släppa det andra,","poem":3},{"text":"för den som fruktar Gud","poem":2},{"text":"finner en väg ut ur allt detta.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Visheten gör den vise starkare","poem":1},{"text":"än tio mäktiga i staden.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"För det finns ingen","poem":1},{"text":"rättfärdig människa på jorden","poem":3},{"text":"som gör det goda och aldrig syndar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Fäst dig inte","poem":1},{"text":"vid allt som människor säger,","poem":3},{"text":"så hör du inte","poem":2},{"text":"att din tjänare förbannar dig.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Ditt hjärta vet ju att du själv","poem":1},{"text":"många gånger","poem":3},{"text":"har förbannat andra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Allt detta har jag prövat","poem":1},{"text":"genom vishet.","poem":3},{"text":"Jag sade: ”Jag vill bli vis.”","poem":2},{"text":"Men visheten var","poem":3},{"text":"fjärran från mig.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"Det som är långt borta","poem":1},{"text":"och mycket djupt,","poem":3},{"text":"vem finner det?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Och jag vände mitt hjärta","poem":1},{"text":"till att förstå, utforska,","poem":2},{"text":"söka vishet och sammanhang.","poem":3},{"text":"Jag ville förstå att ondska är dårskap","poem":2},{"text":"och dåraktighet galenskap.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Och jag fann:","poem":1},{"text":"Bittrare än döden är den kvinna","poem":3},{"text":"vars hjärta är snaror","poem":2},{"noteId":27},{"text":"och nät,","poem":2},{"text":"vars händer är bojor.","poem":3},{"text":"Den som är god inför Gud","poem":2},{"text":"kommer undan henne,","poem":3},{"text":"men syndaren fångas av henne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Se, detta fann jag, säger Predikaren,","poem":1},{"text":"när jag lade det ena till det andra","poem":2},{"text":"för att få sammanhang,","poem":3}]},{"type":"verse","number":29,"content":[{"text":"något som min själ ännu söker","poem":1},{"text":"men inte har funnit.","poem":3},{"text":"En man bland tusen","poem":2},{"text":"har jag funnit,","poem":3},{"text":"men någon kvinna bland alla dessa","poem":2},{"text":"har jag inte funnit.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Se, bara detta har jag funnit:","poem":1},{"text":"Gud skapade människan rak,","poem":2},{"noteId":28},{"text":"men de har tänkt ut","poem":3},{"text":"många påhitt.","poem":4}]}],"footnotes":[{"noteId":24,"caller":"-","text":"Bättre gott namn än god salvaPå hebreiska tov shem mi-shémen tov.","reference":{"chapter":7,"verse":2}},{"noteId":25,"caller":"-","text":"sprakandet av törneDe värdelösa törnbuskarna gav mycket ljud men lite värme i brasan.","reference":{"chapter":7,"verse":7}},{"noteId":26,"caller":"-","text":"lika gott som ett arvAnnan översättning: ”gott tillsammans med ett arv” (men jfr vers 13).","reference":{"chapter":7,"verse":12}},{"noteId":27,"caller":"-","text":"den kvinna vars hjärta är snarorSalomos hedniska hustrur förledde honom till avgudadyrkan (1 Kung 11:4).","reference":{"chapter":7,"verse":27}},{"noteId":28,"caller":"-","text":"rakAnnan översättning: ”ärlig” eller ”rättfärdig” (så som hon skulle vara).","reference":{"chapter":7,"verse":30}}]},"thisChapterLink":"/api/swe_fol/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":30}