{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"EXO","translationId":"swe_fol","name":"Andra Moseboken","commonName":"Andra Moseboken","title":"Andra Moseboken","order":2,"numberOfChapters":40,"sha256":"3ac12f6f28d25c5e124c4784b1b7d1194e53c70d081cb267e239a9d779d65be7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/swe_fol/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Israels lovsång"]},{"type":"verse","number":1,"content":["Då sjöng Mose och Israels barn denna lovsång till Herren:",{"lineBreak":true},{"text":"”Jag vill lovsjunga Herren,","poem":1},{"text":"högt är han upphöjd.","poem":3},{"text":"Häst och ryttare störtade han","poem":2},{"text":"i havet.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Herren är min styrka","poem":1},{"text":"och min lovsång,","poem":2},{"text":"han blev min frälsning.","poem":3},{"text":"Han är min Gud,","poem":2},{"text":"jag vill prisa honom,","poem":3},{"text":"min fars Gud,","poem":2},{"text":"jag vill upphöja honom.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Herren är en stridsman,","poem":1},{"text":"Herren är hans namn.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Faraos vagnar och här","poem":1},{"text":"kastade han i havet,","poem":3},{"text":"hans utvalda krigsmän","poem":2},{"text":"dränktes i Röda havet.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Djupen täckte dem,","poem":1},{"text":"de sjönk till botten som stenar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Din högra hand, Herre,","poem":1},{"text":"är härlig i sin kraft,","poem":3},{"text":"din högra hand, Herre,","poem":2},{"text":"krossade fienden.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"I din stora höghet","poem":1},{"text":"slog du ner dina motståndare,","poem":3},{"text":"du släppte lös din glödande vrede,","poem":2},{"text":"den förtärde dem som strå.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Av din näsas fnysning","poem":1},{"noteId":79},{"text":"dämdes vattnen upp,","poem":3},{"text":"böljorna reste sig som en mur,","poem":2},{"text":"vattenströmmarna stelnade","poem":3},{"text":"i havets djup.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Fienden sade: Jag ska förfölja dem,","poem":1},{"text":"jag ska hinna upp dem,","poem":3},{"text":"jag ska dela upp bytet,","poem":2},{"text":"släcka min hämnd på dem.","poem":3},{"text":"Jag ska dra mitt svärd,","poem":2},{"text":"min hand ska förgöra dem.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Du andades på dem","poem":1},{"text":"och havet täckte dem,","poem":3},{"text":"de sjönk som bly","poem":2},{"text":"i de väldiga vattnen.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Vem är som du bland gudarna,","poem":1},{"text":"Herre?","poem":3},{"text":"Vem är som du, härlig i helighet,","poem":2},{"text":"värdig fruktan och lovsång,","poem":3},{"text":"du som gör under?","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Du sträckte ut din högra hand,","poem":1},{"text":"och jorden slukade dem.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Du ledde med din nåd","poem":1},{"text":"det folk som du återlöst,","poem":3},{"text":"du förde dem med din makt","poem":2},{"text":"till din heliga boning.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Folken hörde det och darrade,","poem":1},{"text":"ångest grep Filisteens invånare.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Då blev Edoms furstar förskräckta,","poem":1},{"text":"Moabs hövdingar bävade,","poem":3},{"text":"Kanaans alla invånare","poem":2},{"text":"smälte av ångest.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Över dem föll skräck och fruktan.","poem":1},{"text":"Inför din mäktiga arm stod de","poem":2},{"text":"som förstenade","poem":3},{"text":"tills ditt folk drog förbi, Herre,","poem":2},{"text":"tills folket drog förbi","poem":3},{"text":"som du hade köpt.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Du för dem in","poem":1},{"text":"och planterar dem","poem":2},{"text":"på din arvedels berg,","poem":3},{"text":"den plats som du gjort","poem":2},{"text":"till din boning, Herre,","poem":3},{"text":"den helgedom, Herre,","poem":2},{"text":"som dina händer berett.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Herren ska regera alltid","poem":1},{"text":"och för evigt.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":["När Faraos hästar med vagnar och ryttare hade kommit ner i havet, lät Herren havets vatten vända tillbaka över dem. Men Israels barn gick rakt genom havet på torr mark."]},{"type":"verse","number":20,"content":["Och profetissan Mirjam",{"noteId":80},", Arons syster, tog en tamburin i handen, och alla kvinnorna följde henne med tamburiner och dansade."]},{"type":"verse","number":21,"content":["Mirjam sjöng för dem:",{"lineBreak":true},{"text":"”Lovsjung Herren,","poem":1},{"text":"högt är han upphöjd!","poem":3},{"text":"Häst och ryttare störtade han","poem":2},{"text":"i havet.”","poem":3}]},{"type":"heading","content":["Det bittra vattnet i Mara"]},{"type":"verse","number":22,"content":["Därefter lät Mose Israels barn bryta upp från Röda havet, och de drog ut i öknen Shur",{"noteId":81},". Under tre dagar vandrade de i öknen utan att finna vatten."]},{"type":"verse","number":23,"content":["Sedan kom de till Mara",{"noteId":82},", men de kunde inte dricka vattnet där, eftersom det var bittert. Därför kallade de platsen Mara."]},{"type":"verse","number":24,"content":["Då klagade folket mot Mose och sade: ”Vad ska vi dricka?”"]},{"type":"verse","number":25,"content":["Men han ropade till Herren, och Herren visade honom ett visst slags trä. Han kastade det i vattnet och då blev vattnet sött. Där förelade han folket lag och rätt, och där satte han det på prov."]},{"type":"verse","number":26,"content":["Han sade: ”Om du hör Herren din Guds röst och noga lyssnar till hans bud och håller alla hans stadgar, ska jag inte lägga på dig någon av de sjukdomar som jag lade på egyptierna, för jag är Herren din läkare."]},{"type":"verse","number":27,"content":["Sedan kom de till Elim",{"noteId":83},", där det fanns tolv vattenkällor och sjuttio palmer. Och de slog läger där vid vattnet."]}],"footnotes":[{"noteId":79,"caller":"-","text":"din näsas fnysningAnnan översättning (så Septuaginta): ”din vredes Ande”.","reference":{"chapter":15,"verse":8}},{"noteId":80,"caller":"-","text":"MirjamNamnet kan tolkas som ”trotsig” (jfr 4 Mos 12) eller på egyptiska ”älskad”.","reference":{"chapter":15,"verse":20}},{"noteId":81,"caller":"-","text":"öknen ShurÖkenområde öster om Egypten (jfr 1 Mos 20:1, 25:18, 1 Sam 15:7, 27:8).","reference":{"chapter":15,"verse":22}},{"noteId":82,"caller":"-","text":"MaraBetyder ”bitter”.","reference":{"chapter":15,"verse":23}},{"noteId":83,"caller":"-","text":"ElimBetyder ”terebinter” (ett träd besläktat med eken).","reference":{"chapter":15,"verse":27}}]},"thisChapterLink":"/api/swe_fol/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}