{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"EZK","translationId":"swe_fol","name":"Hesekiel","commonName":"Hesekiel","title":"Hesekiel","order":26,"numberOfChapters":48,"sha256":"c1d528baebe437e6d2b98b53d0864bf39f7c022564f6cc43d02781d2eb11299d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swe_fol/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":15,"content":[{"type":"heading","content":["Jerusalem, en förtorkad vinstock"]},{"type":"verse","number":1,"content":["Herrens ord kom till mig:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"”Människobarn,","poem":1},{"text":"hur är vinstockens trä","poem":2},{"text":"bättre än allt annat trä,","poem":3},{"text":"grenarna på träden i skogen?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tar man virke av den","poem":1},{"text":"för att göra något nyttigt?","poem":3},{"text":"Gör man ens en pinne av den","poem":2},{"text":"för att hänga upp något på den?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Nej, man ger den till mat åt elden.","poem":1},{"text":"När båda dess ändar","poem":2},{"text":"blivit förtärda av eld","poem":3},{"text":"och delen däremellan blivit svedd,","poem":2},{"text":"duger den då till något nyttigt?","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Inte ens när den ännu var oskadd","poem":1},{"text":"kunde man göra något nyttigt","poem":2},{"text":"av den.","poem":3},{"text":"Hur mycket mindre kan","poem":2},{"text":"den användas till något nyttigt","poem":3},{"text":"när elden förtärt den","poem":2},{"text":"och bränt den!","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Därför säger Herren Gud:","poem":1},{"text":"Som jag gör med en vinstock","poem":2},{"text":"bland skogens träd,","poem":3},{"text":"när jag ger den till bränsle","poem":2},{"text":"åt elden,","poem":3},{"text":"så ska jag göra","poem":2},{"text":"med Jerusalems invånare.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Jag ska vända mitt ansikte","poem":1},{"text":"mot dem.","poem":3},{"text":"De har kommit ut ur elden,","poem":2},{"text":"men elden ska förtära dem.","poem":3},{"text":"Ni ska inse att jag är Herren","poem":2},{"text":"när jag vänder mitt ansikte","poem":3},{"text":"mot dem.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Jag ska göra landet till en ödemark,","poem":1},{"text":"därför att de har handlat trolöst,","poem":2},{"text":"säger Herren Gud.”","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/EZK/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/EZK/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/EZK/14.json","previousChapterAudioLinks":{},"numberOfVerses":8}