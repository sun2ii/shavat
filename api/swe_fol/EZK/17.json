{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"EZK","translationId":"swe_fol","name":"Hesekiel","commonName":"Hesekiel","title":"Hesekiel","order":26,"numberOfChapters":48,"sha256":"c1d528baebe437e6d2b98b53d0864bf39f7c022564f6cc43d02781d2eb11299d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swe_fol/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":17,"content":[{"type":"heading","content":["Liknelse om Sidkias förbundsbrott"]},{"type":"verse","number":1,"content":["Herrens ord kom till mig:"]},{"type":"verse","number":2,"content":["”Män­niskobarn, ge Israels hus en gåta och tala till dem i en liknelse, och säg:"]},{"type":"verse","number":3,"content":["Så säger Herren Gud:",{"lineBreak":true},{"text":"En stor örn med stora vingar","poem":1},{"text":"och långa vingpennor","poem":2},{"text":"och täckt med brokiga fjädrar","poem":3},{"text":"kom till Libanon","poem":2},{"text":"och tog bort toppen på cedern.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Han bröt av dess översta gren","poem":1},{"text":"och förde den","poem":2},{"text":"till köpmännens land","poem":3},{"text":"och satte den i en handelsstad.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Han tog en planta","poem":1},{"text":"som växte i landet,","poem":2},{"text":"och planterade den i fruktbar jord.","poem":3},{"text":"Han förde den till mycket vatten","poem":2},{"text":"och satte den som ett pilträd där.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Den växte upp och blev en vinstock","poem":1},{"text":"med många grenar,","poem":2},{"text":"men med låg stam","poem":3},{"text":"för att dess rankor","poem":2},{"text":"skulle vända sig till honom","poem":4},{"text":"och dess rötter vara under honom.","poem":3},{"text":"Den blev en vinstock","poem":2},{"text":"som bar grenar och sköt skott.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Men det fanns också en annan","poem":1},{"text":"stor örn med stora vingar","poem":2},{"text":"och många fjädrar.","poem":3},{"text":"Och se, vinstocken sköt","poem":2},{"text":"längtansfullt ut","poem":3},{"text":"sina rötter till den.","poem":4},{"text":"Och från platsen","poem":2},{"text":"där den var planterad","poem":3},{"text":"sträckte den sina rankor","poem":2},{"text":"mot honom,","poem":3},{"text":"för att han skulle vattna den.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Den var planterad i god jord","poem":1},{"text":"vid mycket vatten,","poem":3},{"text":"för att den skulle få grenar","poem":2},{"text":"och bära frukt","poem":3},{"text":"och bli en utsökt vinstock.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Säg: Så säger Herren Gud:","poem":1},{"text":"Kan det gå väl","poem":2},{"text":"för den vinstocken?","poem":3},{"text":"Ska han inte rycka upp rötterna","poem":2},{"text":"och riva av frukten,","poem":3},{"text":"så att den torkar","poem":4},{"text":"och alla de spirande bladen","poem":2},{"text":"vissnar?","poem":3},{"text":"Det behövs inte stor kraft","poem":2},{"text":"eller mycket folk","poem":3},{"text":"för att rycka upp den","poem":2},{"text":"med rötterna.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Visst står den fast planterad,","poem":1},{"text":"men kan det sluta väl för den?","poem":3},{"text":"När östanvinden når den,","poem":2},{"text":"ska den då inte helt torka bort?","poem":3},{"text":"På den plats där den vuxit upp","poem":2},{"text":"ska den torka bort.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Herrens ord kom till mig:"]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"”Säg nu till det upproriska släktet:","poem":1},{"text":"Förstår ni inte","poem":2},{"text":"vad detta betyder?","poem":3},{"text":"Säg dem: Se, Babels kung","poem":2},{"text":"kom till Jerusalem","poem":3},{"text":"och tog kungen","poem":2},{"noteId":49},{"text":"och furstarna","poem":2},{"text":"och förde dem med sig till Babel.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Sedan tog han en ättling","poem":1},{"noteId":50},{"text":"av kungahuset","poem":3},{"text":"och slöt förbund med honom","poem":2},{"text":"och lät honom avlägga ed","poem":3},{"noteId":51},{"text":".","poem":3},{"text":"Men de mäktiga i landet","poem":2},{"text":"förde han med sig bort,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"så att riket skulle vara obetydligt","poem":1},{"text":"och inte kunna resa sig","poem":3},{"text":"utan hålla förbundet med honom,","poem":2},{"text":"om det skulle bestå.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Men han avföll från honom","poem":1},{"text":"och skickade sina sändebud","poem":3},{"text":"till Egypten,","poem":4},{"text":"för att man där skulle ge honom","poem":2},{"text":"hästar och mycket folk.","poem":3},{"text":"Kan det gå väl för honom?","poem":2},{"text":"Kan han komma undan?","poem":3},{"text":"Kan den som bryter förbund","poem":2},{"text":"komma undan?","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Så sant jag lever, säger Herren Gud: Han ska dö i Babel där den kung bor som gjorde honom till kung, för han föraktade eden han gett honom och bröt förbundet han slutit med honom."]},{"type":"verse","number":17,"content":["Inte heller ska farao med stor här och mycket folk hjälpa honom i kriget, när man kastar upp en vall och bygger en belägringsmur till undergång för många människor."]},{"type":"verse","number":18,"content":["Han föraktade eden och bröt förbundet och gjorde allt detta, fastän han hade gett sitt löfte. Han ska inte komma undan."]},{"type":"verse","number":19,"content":["Därför säger Herren Gud:",{"lineBreak":true},{"text":"Så sant jag lever,","poem":1},{"text":"jag ska låta min ed","poem":2},{"text":"som han har föraktat","poem":3},{"text":"och mitt förbund som han har brutit","poem":2},{"text":"komma över hans huvud.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Jag ska breda ut mitt nät","poem":1},{"text":"över honom,","poem":4},{"text":"och han ska fångas i min snara.","poem":3},{"text":"Jag ska föra honom till Babel","poem":2},{"text":"och döma honom där","poem":3},{"text":"för den otrohet","poem":2},{"text":"som han har begått mot mig.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Alla hans flyktingar","poem":1},{"text":"och alla hans skaror","poem":2},{"text":"ska falla för svärd,","poem":3},{"text":"och de som räddas","poem":2},{"text":"ska spridas för vinden.","poem":3},{"text":"Och ni ska inse att","poem":2},{"text":"jag, Herren, har talat.","poem":3}]},{"type":"heading","content":["Den späda kvisten på Israels berg"]},{"type":"verse","number":22,"content":["Så säger Herren Gud:",{"lineBreak":true},{"text":"Jag ska själv ta en kvist","poem":1},{"text":"från den höga cederns topp","poem":2},{"noteId":52},{"text":"och plantera den.","poem":3},{"text":"Av dess översta grenar","poem":2},{"text":"ska jag bryta av en späd kvist","poem":3},{"text":"och själv plantera den","poem":2},{"text":"på ett högt och brant berg.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"På Israels höga berg","poem":1},{"text":"ska jag plantera den,","poem":3},{"text":"och den ska få grenar och bära frukt","poem":2},{"text":"och bli en utsökt ceder.","poem":4},{"text":"Alla slags fåglar ska bo under den","poem":2},{"text":"och finna skugga","poem":3},{"text":"under grenarna.","poem":4}]},{"type":"verse","number":24,"content":[{"text":"Alla markens träd ska förstå","poem":1},{"text":"att jag, Herren,","poem":3},{"text":"har böjt ner det höga trädet","poem":2},{"text":"och upphöjt det låga trädet,","poem":3},{"text":"och låtit det friska trädet torka","poem":2},{"text":"och det torra trädet grönska.","poem":3},{"text":"Jag, Herren, har talat","poem":2},{"text":"och ska göra det.”","poem":3}]}],"footnotes":[{"noteId":49,"caller":"-","text":"kungenJojakin, som fördes bort år 597 f Kr (2 Kung 24:15f).","reference":{"chapter":17,"verse":12}},{"noteId":50,"caller":"-","text":"en ättlingSidkia, som gjorde uppror mot Nebukadnessar 589 f Kr (2 Kung 24:17f).","reference":{"chapter":17,"verse":13}},{"noteId":51,"caller":"-","text":"avlägga edLydkungar svor trohet i sin egen guds namn (2 Krön 36:13), och eder till Herren måste hållas (jfr Jos 9:19, Pred 5:3).","reference":{"chapter":17,"verse":13}},{"noteId":52,"caller":"-","text":"kvist från den höga cederns toppRiket skulle återupprättas genom kung Jojakins ätt. Hans sonson Serubbabel ledde återuppbyggnaden av Jerusalem 538 f Kr (1 Krön 3:17f, Esra 2:2, 3:2f) och var juridisk förfader till Jesus Kristus (Matt 1:12).","reference":{"chapter":17,"verse":22}}]},"thisChapterLink":"/api/swe_fol/EZK/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/EZK/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/EZK/16.json","previousChapterAudioLinks":{},"numberOfVerses":24}