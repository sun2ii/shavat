{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"EZK","translationId":"swe_fol","name":"Hesekiel","commonName":"Hesekiel","title":"Hesekiel","order":26,"numberOfChapters":48,"sha256":"c1d528baebe437e6d2b98b53d0864bf39f7c022564f6cc43d02781d2eb11299d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swe_fol/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Sorgesång över Israels kungahus"]},{"type":"verse","number":1,"content":["Stäm upp en sorgesång över Israels furstar"]},{"type":"verse","number":2,"content":["och säg:",{"lineBreak":true},{"text":"Vilken lejoninna var inte din mor!","poem":1},{"text":"Hon låg bland lejon,","poem":2},{"noteId":53},{"text":"hon födde upp sina ungar","poem":3},{"text":"bland unga lejon.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"En av sina ungar","poem":1},{"noteId":54},{"text":"födde hon upp","poem":1},{"text":"till ett kraftigt lejon.","poem":3},{"text":"Han lärde sig ta rov,","poem":2},{"text":"han åt människor.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Men hednafolken fick höra","poem":1},{"text":"om honom.","poem":3},{"text":"Han blev fångad i deras grop,","poem":2},{"text":"och de förde honom","poem":3},{"text":"med krok i nosen","poem":4},{"text":"till Egyptens land.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"När lejoninnan såg","poem":1},{"text":"att hon fick vänta förgäves,","poem":2},{"text":"att hennes hopp blev om intet,","poem":3},{"text":"tog hon en annan av sina ungar","poem":2},{"noteId":55},{"text":"och gjorde honom till","poem":3},{"text":"ett kraftigt lejon.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Han gick omkring bland lejonen,","poem":1},{"text":"ja, han blev ett kraftigt lejon.","poem":3},{"text":"Han lärde sig ta rov","poem":2},{"text":"och att äta människor.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han kränkte deras änkor","poem":1},{"text":"och ödelade deras städer.","poem":3},{"text":"Landet och allt som fanns där","poem":2},{"text":"greps av förfäran","poem":3},{"text":"vid ljudet av hans rytande.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Då kom folken upp mot honom","poem":1},{"text":"från länderna runt omkring.","poem":3},{"text":"De bredde ut sitt nät över honom,","poem":2},{"text":"och han blev fångad","poem":3},{"text":"i deras grop.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Sedan satte de honom i en bur,","poem":1},{"text":"med krok i nosen","poem":3},{"noteId":56},{"text":",","poem":3},{"text":"och förde honom till Babels kung","poem":2},{"text":"och satte honom i säkert förvar,","poem":3},{"text":"för att hans röst inte mer","poem":2},{"text":"skulle höras bort till Israels berg.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Din mor är som en vinstock","poem":1},{"text":"i din vingård,","poem":3},{"noteId":57},{"text":"planterad vid vatten,","poem":2},{"text":"fruktbar och rik på skott,","poem":3},{"text":"för där fanns mycket vatten.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Den fick starka grenar,","poem":1},{"text":"användbara till härskarspiror,","poem":3},{"text":"och stammen växte hög,","poem":2},{"text":"omgiven av lövverk,","poem":3},{"text":"så att den syntes","poem":2},{"text":"genom sin ståtliga växt","poem":3},{"text":"och sin rikedom på rankor.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Men den blev uppryckt i vrede","poem":1},{"text":"och kastad till marken,","poem":3},{"text":"östanvinden förtorkade","poem":2},{"text":"dess frukt.","poem":3},{"text":"De starka grenarna","poem":2},{"text":"bröts av och vissnade,","poem":3},{"text":"och elden förtärde dem.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Nu är den planterad i öknen,","poem":1},{"text":"i ett torrt och törstande land.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Eld har gått ut från","poem":1},{"text":"en av de yppersta grenarna","poem":2},{"text":"och har förtärt frukten.","poem":3},{"text":"Ingen stark gren finns kvar,","poem":2},{"text":"ingen härskarspira!","poem":3},{"lineBreak":true},"Detta är en sorgesång, och den ska användas som sorgesång.",{"noteId":58}]}],"footnotes":[{"noteId":53,"caller":"-","text":"lejonVanliga i dåtidens Mellanöstern (Dom 14:5, 1 Sam 17:34) och därför en ofta använd bild för kungar (t ex Ords 30:30f, Nah 2:11 med not). Kungastammen Juda liknades vid ett lejon med ”härskarspira” (vers 14, 1 Mos 49:9-10).","reference":{"chapter":19,"verse":2}},{"noteId":54,"caller":"-","text":"En av sina ungarJoahas (2 Kung 23:31f), bortförd efter tre månader som kung.","reference":{"chapter":19,"verse":3}},{"noteId":55,"caller":"-","text":"en annan av sina ungarJojakin (2 Kung 24:8f), också bortförd efter tre månader.","reference":{"chapter":19,"verse":5}},{"noteId":56,"caller":"-","text":"krok i nosenSå ledde assyrierna sina fångar med våld (jfr Jes 37:29).","reference":{"chapter":19,"verse":9}},{"noteId":57,"caller":"-","text":"i din vingårdAndra handskrifter: ”i ditt blod”.","reference":{"chapter":19,"verse":10}},{"noteId":58,"caller":"-","text":"ska användas som sorgesångAnnan översättning: ”har blivit en sorgesång”.","reference":{"chapter":19,"verse":14}}]},"thisChapterLink":"/api/swe_fol/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}