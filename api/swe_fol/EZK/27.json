{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"EZK","translationId":"swe_fol","name":"Hesekiel","commonName":"Hesekiel","title":"Hesekiel","order":26,"numberOfChapters":48,"sha256":"c1d528baebe437e6d2b98b53d0864bf39f7c022564f6cc43d02781d2eb11299d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swe_fol/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":27,"content":[{"type":"heading","content":["Sorgesång över Tyrus"]},{"type":"verse","number":1,"content":["Herrens ord kom till mig:"]},{"type":"verse","number":2,"content":["”Människobarn, stäm upp en sorge­sång över Tyrus."]},{"type":"verse","number":3,"content":["Säg till Tyrus:",{"lineBreak":true},{"text":"Du som bor vid havets portar","poem":1},{"text":"och driver handel med folken","poem":3},{"text":"i många kustländer,","poem":2},{"text":"så säger Herren Gud:","poem":3},{"text":"O Tyrus, du säger:","poem":2},{"text":"Jag är den fullkomliga skönheten.","poem":3}]},{"type":"verse","number":4,"content":["Dina gränser är mitt i havet,",{"text":"de som byggde dig","poem":2},{"text":"gjorde din skönhet fullkomlig.","poem":3}]},{"type":"verse","number":5,"content":["Av cypress från Senir",{"noteId":86},{"text":"gjorde de allt ditt träarbete.","poem":3},{"text":"De hämtade en ceder från Libanon","poem":2},{"text":"för att göra en mast åt dig.","poem":3}]},{"type":"verse","number":6,"content":["Av ekar från Bashan",{"text":"gjorde de dina åror.","poem":3},{"text":"De prydde ditt däck med elfenben,","poem":2},{"text":"inlagt i ädelt trä","poem":3},{"text":"från kitteernas öländer.","poem":4}]},{"type":"verse","number":7,"content":["Seglet av fint broderat linne",{"text":"från Egypten","poem":4},{"text":"hade du som ditt baner.","poem":3},{"text":"Mörkblått och purpurrött tyg","poem":2},{"text":"från Elishas","poem":3},{"noteId":87},{"text":"öländer","poem":3},{"text":"hade du till soltält.","poem":4}]},{"type":"verse","number":8,"content":["Sidons och Arvads",{"noteId":88},"invånare",{"text":"var roddare åt dig.","poem":3},{"text":"De vise, som du hade hos dig, Tyrus,","poem":2},{"text":"dem tog du till sjömän.","poem":3}]},{"type":"verse","number":9,"content":["Gebals",{"noteId":89},"äldste och dess vise",{"text":"tjänade dig med att täta","poem":2},{"text":"dina fogar.","poem":3},{"text":"Havets alla fartyg","poem":2},{"text":"med sina besättningar","poem":3},{"text":"tjänade dig vid din byteshandel.","poem":2}]},{"type":"verse","number":10,"content":["Perser, ludeer och puteer",{"noteId":90},{"text":"var soldater i din här,","poem":2},{"text":"ditt krigsfolk.","poem":3},{"text":"Sköldar och hjälmar","poem":2},{"text":"hängde de på dig,","poem":3},{"text":"och dessa gav dig glans.","poem":4}]},{"type":"verse","number":11,"content":["Arvads söner och din här",{"text":"stod runt omkring","poem":2},{"text":"på dina murar,","poem":3},{"text":"och män från Gammad","poem":2},{"text":"var i dina torn.","poem":3},{"text":"Sina stora sköldar hängde de upp","poem":2},{"text":"runt om på dina murar,","poem":3},{"text":"de gjorde din skönhet fullkomlig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Tarshish",{"noteId":91},"var din handelspartner, för du var rik på allt. Du fick silver, järn, tenn och bly i utbyte mot dina varor."]},{"type":"verse","number":13,"content":["Grekland",{"noteId":92},", Tubal och Meshek",{"noteId":93},"handlade med dig. Slavar och kopparkärl gav de dig i utbyte."]},{"type":"verse","number":14,"content":["Arbetshästar, stridshästar och mulåsnor fick du som betalning från Togarmas land",{"noteId":94},"."]},{"type":"verse","number":15,"content":["Dedans söner",{"noteId":95},"handlade med dig, ja, många kustländer var dina kunder. Elfenben och ebenholts förde de till dig som betalning."]},{"type":"verse","number":16,"content":["Aram",{"noteId":96},"var din handelspartner, för du var rik på konstarbeten. Rubiner, purpurrött tyg, broderade vävnader och fint linne, koraller och rubiner gav de dig som betalning."]},{"type":"verse","number":17,"content":["Juda och Israels land handlade med dig. Vete från Minnit",{"noteId":97},", bakverk och honung, olja och balsam gav de dig i utbyte för dina varor."]},{"type":"verse","number":18,"content":["Damaskus var din handelspartner, för du var rik på konstarbeten och allt slags gods. De kom med vin från Helbon och med ull från Sahar.",{"noteId":98}]},{"type":"verse","number":19,"content":["Dan och Javan gav dig tvinnad tråd som betalning. De gav konstsmitt järn, kassia och kalmus",{"noteId":99},"i utbyte mot dina varor."]},{"type":"verse","number":20,"content":["Dedan handlade med dig med sadeltäcken att rida på."]},{"type":"verse","number":21,"content":["Araberna och Kedars",{"noteId":100},"alla furstar tjänade dig med sin handel, med lamm och baggar och bockar drev de handel hos dig."]},{"type":"verse","number":22,"content":["Sabas och Raamas köpmän",{"noteId":101},"gjorde affärer med dig. Kryddor av bästa slag och alla slags ädla stenar och guld gav de dig som betalning."]},{"type":"verse","number":23,"content":["Harran",{"noteId":102},", Kanne och Eden,",{"noteId":103},"Sabas köpmän, Assur och Kilmad",{"noteId":104},"drev handel med dig."]},{"type":"verse","number":24,"content":["De gjorde affärer hos dig med vackra kläder, med mörkblå brokigt vävda mantlar, med brokiga täcken, med välslagna, starka rep på din marknad."]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Fartyg från Tarshish for i väg","poem":1},{"text":"med dina bytesvaror.","poem":3},{"text":"Så fylldes du med gods","poem":2},{"text":"och blev mycket ärad,","poem":3},{"text":"där du låg mitt i havet.","poem":4}]},{"type":"verse","number":26,"content":["Ut på vida vattnen",{"text":"förde de dig,","poem":2},{"text":"dina roddare.","poem":3},{"text":"Då kom östanvinden","poem":2},{"text":"och krossade dig,","poem":3},{"text":"där du låg mitt i havet.","poem":4}]},{"type":"verse","number":27,"content":[{"text":"Ditt gods, dina varor och din handel,","poem":1},{"text":"dina sjömän och styrmän,","poem":3},{"text":"de som lagade dina fogar","poem":2},{"text":"och de som drev din handel,","poem":3},{"text":"allt krigsfolk som fanns hos dig","poem":2},{"text":"och allt manskap hos dig,","poem":3},{"text":"ska sjunka ner i havets djup","poem":2},{"text":"den dag du faller.","poem":3}]},{"type":"verse","number":28,"content":["När dina sjömän höjer sorgerop",{"text":"bävar kustländerna.","poem":2}]},{"type":"verse","number":29,"content":["Alla som ror med åror",{"text":"lämnar sina skepp.","poem":3},{"text":"Sjömän och alla som far","poem":2},{"text":"på havet stannar i land.","poem":3}]},{"type":"verse","number":30,"content":["De ropar högt över dig",{"text":"och klagar bittert,","poem":3},{"text":"de strör stoft på sina huvuden","poem":2},{"text":"och rullar sig i aska.","poem":3}]},{"type":"verse","number":31,"content":["De rakar sig skalliga för din skull",{"text":"och klär sig i säcktyg,","poem":3},{"text":"de gråter över dig i bitter sorg,","poem":2},{"text":"under bitter klagan.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Med jämmer stämmer de upp","poem":1},{"text":"en sorgesång över dig,","poem":2},{"text":"klagande sjunger de om dig:","poem":3},"Vem är som Tyrus,",{"text":"som bringats till tystnad","poem":3},{"text":"mitt ute i havet?","poem":4}]},{"type":"verse","number":33,"content":["När dina handelsvaror",{"text":"sattes i land från havet","poem":2},{"text":"mättade du många folk.","poem":3},{"text":"Med din mängd av gods","poem":2},{"text":"och bytesvaror","poem":4},{"text":"gjorde du jordens kungar rika.","poem":3}]},{"type":"verse","number":34,"content":["Men nu, när du förlist",{"text":"och försvunnit från havet","poem":4},{"text":"ner i vattnets djup,","poem":3},{"text":"har dina bytesvaror","poem":2},{"text":"och allt ditt manskap","poem":3},{"text":"sjunkit med dig.","poem":4}]},{"type":"verse","number":35,"content":[{"text":"Kustländernas alla invånare","poem":1},{"text":"häpnar över dig,","poem":2},{"text":"deras kungar står rysande","poem":3},{"text":"med förfäran i sina ansikten.","poem":2}]},{"type":"verse","number":36,"content":["Köpmännen ute bland folken",{"text":"visslar hånfullt åt dig.","poem":3},{"text":"Du har fått ett fasansfullt slut,","poem":2},{"text":"du ska inte mer finnas till.”","poem":3}]}],"footnotes":[{"noteId":86,"caller":"-","text":"SenirHermonbergen (5 Mos 3:9), rikt bevuxna med barrskog.","reference":{"chapter":27,"verse":5}},{"noteId":87,"caller":"-","text":"ElishaKustområde i Medelhavet, kanske på Cypern. Se 1 Mos 10:4.","reference":{"chapter":27,"verse":7}},{"noteId":88,"caller":"-","text":"Sidon och ArvadFeniciska handelsstäder ca 4 och 17 mil norr om Tyrus.","reference":{"chapter":27,"verse":8}},{"noteId":89,"caller":"-","text":"GebalPå grekiska Byblos, berömd fenicisk handelsstad ca 10 mil norr om Tyrus.","reference":{"chapter":27,"verse":9}},{"noteId":90,"caller":"-","text":"Perser, ludeer och puteerAvlägsna folk i öst (Iran), väst (Lydien, västra Turkiet) och sydväst (Libyen). Jfr Jer 30:5, 38:5, 46:9 och 1 Mos 10:6, 13.","reference":{"chapter":27,"verse":10}},{"noteId":91,"caller":"-","text":"TarshishHandelscentrum i västra Medelhavet (1 Kung 10:22). Har identifierats med spanska Tartessos, tunisiska Kartago eller Sardinien.","reference":{"chapter":27,"verse":12}},{"noteId":92,"caller":"-","text":"GreklandHebr. Javán, särskilt Jonien på nuvarande Turkiets västkust.","reference":{"chapter":27,"verse":13}},{"noteId":93,"caller":"-","text":"Tubal och MeshekRiken i östra nuvarande Turkiet. Se 38:2, 1 Mos 10:2.","reference":{"chapter":27,"verse":13}},{"noteId":94,"caller":"-","text":"Togarmas landKanske staden Tegarama vid Gürün i centrala Turkiet, omnämnd i assyrisk kilskrift. Se 38:6 och 1 Mos 10:3.","reference":{"chapter":27,"verse":14}},{"noteId":95,"caller":"-","text":"Dedans sönerNordvästra Saudiarabien (1 Mos 10:7, Jes 21:13, Jer 25:23). Septuaginta: ­”Rodans söner” (ön Rhodos).","reference":{"chapter":27,"verse":15}},{"noteId":96,"caller":"-","text":"AramNuvarande Syriens inland.","reference":{"chapter":27,"verse":16}},{"noteId":97,"caller":"-","text":"MinnitOmråde i Ammon nordost om Döda havet (Dom 11:33).","reference":{"chapter":27,"verse":17}},{"noteId":98,"caller":"-","text":"Helbon … SaharOmråden strax norr om Damaskus.","reference":{"chapter":27,"verse":18}},{"noteId":99,"caller":"-","text":"kassia och kalmusDoftämnen från bortre Asien.","reference":{"chapter":27,"verse":19}},{"noteId":100,"caller":"-","text":"KedarBoskapsskötande arabfolk (Jes 60:7), fruktade krigare (Ps 120:5, Jes 21:17).","reference":{"chapter":27,"verse":21}},{"noteId":101,"caller":"-","text":"Sabas och Raamas köpmänNuvarande Jemen, ett mäktigt handelsrike (1 Kung 10, Job 6:19, Ps 72:10, Jes 60:6).","reference":{"chapter":27,"verse":22}},{"noteId":102,"caller":"-","text":"HarranStad mellan Syrien och Turkiet, förknippad med Abraham (1 Mos 11:31).","reference":{"chapter":27,"verse":23}},{"noteId":103,"caller":"-","text":"EdenTroligen Bet-Eden, arameiskt rike i norra Syrien sydväst om Harran (Amos 1:5).","reference":{"chapter":27,"verse":23}},{"noteId":104,"caller":"-","text":"Kanne … KilmadOkända orter, troligen i Syriens inland.","reference":{"chapter":27,"verse":23}}]},"thisChapterLink":"/api/swe_fol/EZK/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/EZK/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/EZK/26.json","previousChapterAudioLinks":{},"numberOfVerses":36}