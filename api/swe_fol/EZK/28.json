{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"EZK","translationId":"swe_fol","name":"Hesekiel","commonName":"Hesekiel","title":"Hesekiel","order":26,"numberOfChapters":48,"sha256":"c1d528baebe437e6d2b98b53d0864bf39f7c022564f6cc43d02781d2eb11299d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swe_fol/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Profetia mot kungen i Tyrus"]},{"type":"verse","number":1,"content":["Herrens ord kom till mig:"]},{"type":"verse","number":2,"content":["”Människobarn, säg till fursten i Tyrus",{"noteId":105},": Så säger Herren Gud:",{"lineBreak":true},{"text":"Ditt hjärta är högmodigt","poem":1},{"text":"och du säger: Jag är en gud,","poem":2},{"text":"jag tronar på en gudatron","poem":3},{"text":"mitt ute i havet.","poem":4},{"text":"Ändå är du bara en människa","poem":2},{"text":"och inte en gud,","poem":3},{"text":"hur mycket du än i ditt hjärta","poem":2},{"text":"tycker dig vara en gud.","poem":3}]},{"type":"verse","number":3,"content":["Se, du menar dig vara visare",{"text":"än Daniel","poem":3},{"noteId":106},{"text":",","poem":3},{"text":"ingen hemlighet är dold för dig.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Genom din visdom och ditt förstånd","poem":1},{"text":"har du blivit rik,","poem":3},{"text":"guld och silver har du samlat","poem":2},{"text":"i dina förrådshus.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Genom stor visdom med vilken","poem":1},{"text":"du drev din handel","poem":4},{"text":"har du ökat din rikedom,","poem":3},{"text":"och så har ditt hjärta","poem":2},{"text":"blivit högmodigt","poem":4},{"text":"för din rikedoms skull.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Därför säger Herren Gud så:","poem":1},{"text":"Eftersom du menar","poem":2},{"text":"att dina tankar är Guds tankar,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"se, därför ska jag låta främlingar","poem":1},{"text":"komma mot dig,","poem":2},{"text":"de grymmaste folk.","poem":3},{"text":"De ska dra sina svärd","poem":2},{"text":"mot din visdoms skönhet","poem":3},{"text":"och orena din glans.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"De ska störta ner dig i graven,","poem":1},{"text":"och du ska dö en våldsam död","poem":2},{"text":"mitt ute i havet.","poem":3}]},{"type":"verse","number":9,"content":["Ska du då säga till",{"text":"den som dräper dig:","poem":2},{"text":"’Jag är en gud’,","poem":3},{"text":"du som är en människa","poem":2},{"text":"och inte en gud,","poem":3},{"text":"i händerna på den","poem":2},{"text":"som genomborrar dig?","poem":3}]},{"type":"verse","number":10,"content":["Du ska dö som de oomskurna dör",{"text":"för främlingars hand.","poem":3},{"text":"För jag har talat,","poem":2},{"text":"säger Herren Gud.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Herrens ord kom till mig:"]},{"type":"verse","number":12,"content":["”Män­niskobarn, stäm upp en sorgesång över kungen i Tyrus och säg till honom: Så säger Herren Gud:",{"lineBreak":true},{"text":"Du var en mönsterbild","poem":1},{"text":"av fullkomlighet,","poem":3},{"text":"full av visdom","poem":2},{"text":"och fullkomlig i skönhet.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Du var i Eden, Guds lustgård,","poem":1},{"text":"höljd i alla slags ädelstenar:","poem":2},{"text":"karneol, topas och kalcedon,","poem":3},{"text":"krysolit, onyx och jaspis,","poem":2},{"text":"safir, granat och smaragd.","poem":3},{"text":"Med guld var dina tamburiner","poem":2},{"text":"och flöjter utsmyckade,","poem":3},{"text":"framställda den dag du skapades.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Du var en smord,","poem":1},{"text":"beskyddande kerub","poem":3},{"noteId":107},{"text":",","poem":3},{"text":"och jag hade satt dig","poem":2},{"text":"på Guds heliga berg.","poem":3},{"text":"Där gick du omkring","poem":2},{"text":"bland gnistrande stenar.","poem":3}]},{"type":"verse","number":15,"content":["Du var fullkomlig",{"text":"på alla dina vägar","poem":3},{"text":"från den dag då du skapades","poem":2},{"text":"till dess att orättfärdighet","poem":3},{"text":"blev funnen hos dig.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Genom din stora handel","poem":1},{"text":"fylldes du med våld,","poem":2},{"text":"och du syndade.","poem":3},{"text":"Därför drev jag dig bort","poem":2},{"text":"från Guds berg","poem":3},{"text":"och förgjorde dig,","poem":2},{"text":"du beskyddande kerub","poem":3},{"text":"mitt bland de gnistrande stenarna.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Eftersom ditt hjärta var högmodigt","poem":1},{"text":"på grund av din skönhet,","poem":3},{"text":"och du fördärvade din visdom","poem":2},{"text":"på grund av din prakt,","poem":3},{"text":"kastade jag ner dig till jorden","poem":4},{"text":"och utlämnade dig åt kungar","poem":2},{"text":"till att beskådas.","poem":3}]},{"type":"verse","number":18,"content":["Genom dina många missgärningar",{"text":"och din oärliga handel","poem":2},{"text":"vanhelgade du dina helgedomar.","poem":3},{"text":"Därför lät jag eld gå ut från dig,","poem":2},{"text":"och den förtärde dig.","poem":3},{"text":"Jag gjorde dig till aska på marken","poem":2},{"text":"inför alla som såg dig.","poem":3}]},{"type":"verse","number":19,"content":["Alla som kände dig bland folken",{"text":"häpnade över dig.","poem":3},{"text":"Du fick ett fasansfullt slut","poem":2},{"text":"och du ska inte mer finnas till.”","poem":3}]},{"type":"heading","content":["Profetia mot Sidon"]},{"type":"verse","number":20,"content":["Herrens ord kom till mig:"]},{"type":"verse","number":21,"content":["”Män­niskobarn, vänd ditt ansikte mot Sidon",{"noteId":108},"och profetera mot det"]},{"type":"verse","number":22,"content":["och säg: Så säger Herren Gud:",{"lineBreak":true},{"text":"Se, jag ska komma över dig, Sidon,","poem":1},{"text":"och förhärliga mig i dig.","poem":3},{"text":"Man ska inse att jag är Herren,","poem":2},{"text":"när jag dömer henne","poem":3},{"text":"och visar mig helig i hennes mitt.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jag ska sända pest över henne","poem":1},{"text":"och blod på hennes gator,","poem":3},{"text":"och inne i henne ska döende män","poem":2},{"text":"falla för svärd,","poem":3},{"text":"som ska drabba henne","poem":2},{"text":"från alla sidor.","poem":3},{"text":"Och man ska inse att jag är Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":["Sedan ska det för Israels hus inte mer finnas någon stickande tagg ­eller något sårande törne bland alla de grannfolk som nu föraktar dem. Och man ska inse att jag är Herren Gud."]},{"type":"verse","number":25,"content":["Så säger Herren Gud: När jag samlar Israels hus från de folk dit de skingrats, ska jag uppenbara min helighet bland dem inför hednafolkens ögon. Sedan ska de bo i sitt land, det som jag gav åt min tjänare Jakob."]},{"type":"verse","number":26,"content":["De ska bo där i trygghet och bygga hus och plantera vingårdar. Ja, de ska bo i trygghet, när jag dömer alla som bor runt omkring dem och som föraktar dem. Och de ska inse att jag är Herren deras Gud.”"]}],"footnotes":[{"noteId":105,"caller":"-","text":"fursten i TyrusHette Etbaal III (”Baals man”, ca 591-573 f Kr). Personifierar här staden.","reference":{"chapter":28,"verse":2}},{"noteId":106,"caller":"-","text":"visare än DanielSe t ex Dan 1:20 och not till Hes 14:14.","reference":{"chapter":28,"verse":3}},{"noteId":107,"caller":"-","text":"beskyddande kerubKeruberna (jfr kap 1 och 10) var väktare vid Edens lustgård (1 Mos 3:24), avbildade på förbundsarken där Gud uppenbarade sig (4 Mos 7:89).","reference":{"chapter":28,"verse":14}},{"noteId":108,"caller":"-","text":"SidonDeltog med Juda i upproret mot Nebudkadnessar (Jer 27:3) men besegrades.","reference":{"chapter":28,"verse":21}}]},"thisChapterLink":"/api/swe_fol/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}