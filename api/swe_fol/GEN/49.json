{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"GEN","translationId":"swe_fol","name":"Första Moseboken","commonName":"Första Moseboken","title":"Första Moseboken","order":1,"numberOfChapters":50,"sha256":"2f25aea47c10dcf70e72240f089bf13010d87c48bc3b398850d9ef8ca97404d9","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/swe_fol/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["Jakob välsignar sina söner"]},{"type":"verse","number":1,"content":["Och Jakob kallade sina söner till sig och sade: ”Kom hit till mig, så ska jag tala om vad som ska hända er i kommande dagar."]},{"type":"verse","number":2,"content":["Samla er och lyssna, ni Jakobs söner, hör på Israel, er far!"]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ruben, du är min förstfödde,","poem":1},{"text":"min kraft och min styrkas förstling,","poem":2},{"text":"främst i myndighet","poem":3},{"text":"och främst i makt.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Du sjuder över som vatten,","poem":1},{"text":"du ska inte bli den främste,","poem":2},{"text":"för du besteg din fars bädd,","poem":3},{"text":"då vanhelgade du den.","poem":2},{"text":"Han besteg min säng!","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Simeon och Levi är bröder,","poem":1},{"text":"våldet är deras vapen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Min själ ska inte ta del i deras råd,","poem":1},{"text":"min själ ska inte umgås med dem,","poem":3},{"text":"för de dödade män i sin vrede","poem":2},{"text":"och stympade oxar i sitt övermod.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Förbannad är deras vrede","poem":1},{"text":"som är så våldsam","poem":3},{"text":"och deras grymhet","poem":2},{"text":"som är så stor!","poem":3},{"text":"Jag ska dela upp dem i Jakob","poem":2},{"text":"och skingra dem i Israel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Juda, dig ska dina bröder prisa.","poem":1},{"noteId":366},{"text":"Din hand ska gripa","poem":2},{"text":"dina fienders nacke,","poem":3},{"text":"din fars söner","poem":2},{"text":"ska buga sig för dig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ett ungt lejon är Juda.","poem":1},{"text":"Du reser dig från rivet byte,","poem":2},{"text":"min son.","poem":3},{"text":"Han böjer sig, han lägger sig","poem":2},{"text":"som ett lejon, som en lejonhona –","poem":3},{"text":"vem vågar väcka honom?","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Spiran ska inte vika från Juda,","poem":1},{"text":"inte härskarstaven","poem":2},{"text":"från hans fötter,","poem":3},{"text":"förrän han som den tillhör","poem":2},{"noteId":367},{"text":"kommer","poem":2},{"text":"och folken lyder honom.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Han binder sin ungåsna","poem":1},{"text":"vid vinstocken,","poem":3},{"text":"sitt åsneföl vid den ädla rankan.","poem":2},{"text":"Han tvättar sina kläder i vin,","poem":3},{"text":"sin mantel i druvors blod.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Hans ögon är dunkla av vin,","poem":1},{"text":"hans tänder vita av mjölk.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Sebulon ska bo vid havets strand","poem":1},{"text":"och bli en hamn för skepp.","poem":3},{"noteId":368},{"text":"Sin sida ska han vända mot Sidon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Isaskar är en stark åsna","poem":1},{"text":"som ligger i ro i sitt hägn.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Han såg att viloplatsen var god","poem":1},{"text":"och landet ljuvligt.","poem":3},{"text":"Då böjde han sin rygg","poem":2},{"text":"under bördor","poem":3},{"text":"och blev en arbetspliktig slav.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dan ska skaffa rätt","poem":1},{"noteId":369},{"text":"åt sitt folk","poem":1},{"text":"som en av Israels stammar.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Dan ska vara en orm på vägen,","poem":1},{"text":"en huggorm på stigen","poem":3},{"text":"som biter hästen i foten","poem":2},{"text":"så att ryttaren faller baklänges.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Herre, jag väntar","poem":1},{"text":"på din frälsning!","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gad ska trängas av skaror","poem":1},{"noteId":370},{"text":"och själv tränga dem in på hälarna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Från Asher kommer utsökta rätter,","poem":1},{"text":"han ska bjuda","poem":2},{"text":"på kungliga läckerheter.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Naftali är en frisläppt hind","poem":1},{"text":"som talar vackra ord.","poem":2},{"noteId":371}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Josef är ett ungt fruktträd,","poem":1},{"text":"ett ungt fruktträd vid källan.","poem":3},{"text":"Grenarna når upp över muren.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bågskyttar oroar honom,","poem":1},{"text":"de skjuter mot honom","poem":2},{"text":"och ansätter honom.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Men hans båge förblir fast","poem":1},{"text":"och hans händer","poem":2},{"text":"och armar spänstiga","poem":3},{"text":"genom Jakobs Mäktige,","poem":2},{"text":"genom Herden, Israels Klippa,","poem":3}]},{"type":"verse","number":25,"content":[{"text":"genom din fars Gud","poem":1},{"text":"som ska hjälpa dig,","poem":3},{"text":"genom den Allsmäktige","poem":2},{"text":"som ska välsigna dig","poem":3},{"text":"med välsignelser","poem":2},{"text":"från himlen därovan,","poem":3},{"text":"välsignelser från djupet","poem":2},{"text":"som ruvar där nere,","poem":3},{"text":"välsignelser från bröst","poem":2},{"text":"och moderliv.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Din fars välsignelser når högt,","poem":1},{"text":"högre än mina fäders välsignelser,","poem":2},{"text":"till de eviga höjdernas härlighet.","poem":3},{"text":"De ska vara över Josefs huvud,","poem":2},{"text":"över hjässan på fursten","poem":3},{"text":"bland sina bröder.","poem":4}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Benjamin är en glupsk varg.","poem":1},{"text":"På morgonen äter han sitt rov,","poem":2},{"text":"på kvällen fördelar han bytet.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":["Alla dessa är Israels tolv stammar, och detta är vad deras far sade till dem. Han välsignade dem och gav åt var och en sin särskilda välsignelse."]},{"type":"heading","content":["Jakob dör"]},{"type":"verse","number":29,"content":["Sedan befallde han dem och sade: ”Jag ska nu samlas till mitt folk. Begrav mig hos mina fäder i grottan på hetiten Efrons mark,"]},{"type":"verse","number":30,"content":["i grottan vid fältet i Makpela mitt emot Mamre i Kanaans land, den som Abraham köpte till gravplats av hetiten Efron."]},{"type":"verse","number":31,"content":["Där begravdes Abraham och hans hustru Sara, där begravdes Isak och hans hustru Rebecka, och där har jag själv begravt Lea,"]},{"type":"verse","number":32,"content":["i grottan på marken som köptes av hetiterna.”"]},{"type":"verse","number":33,"content":["När Jakob hade gett sina söner dessa befallningar drog han upp fötterna i sängen. Och han gav upp andan och samlades till sitt folk."]}],"footnotes":[{"noteId":366,"caller":"-","text":"Juda … prisaPå hebreiska Jehudá … jodúcha (jfr 29:35 med not).","reference":{"chapter":49,"verse":8}},{"noteId":367,"caller":"-","text":"han som den tillhörDvs Messias, den rätte härskaren av Juda stam (Heb 7:14, Upp 5:5). Jfr Hes 21:27. Annan översättning: ”Shilo” (där tabernaklet senare stod, se Jos 18:1, 1 Sam 1-4).","reference":{"chapter":49,"verse":10}},{"noteId":368,"caller":"-","text":"hamn för skeppIsraels bästa naturligt skyddade hamn vid Medelhavet finns i nordväst på Sebulons område, vid berget Karmel och nutidens Haifa.","reference":{"chapter":49,"verse":13}},{"noteId":369,"caller":"-","text":"Dan … skaffa rättHebr. dan betyder ”skaffa rätt, döma” (jfr 30:6).","reference":{"chapter":49,"verse":16}},{"noteId":370,"caller":"-","text":"Gad … skarorPå hebreiska gad … gedud. Gad kan också översättas ”tränga/anfalla”.","reference":{"chapter":49,"verse":19}},{"noteId":371,"caller":"-","text":"talar vackra ordAnnan översättning: ”föder vackra kalvar”.","reference":{"chapter":49,"verse":21}}]},"thisChapterLink":"/api/swe_fol/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}