{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HAB","translationId":"swe_fol","name":"Habackuk","commonName":"Habackuk","title":"Habackuk","order":35,"numberOfChapters":3,"sha256":"220af71bf3f883facf041e416ff1da82cb7e5e77bbaf816f399b9da4c9bc3113","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Den profetia som profeten Habackuk såg i en syn."]},{"type":"heading","content":["Klagan över folkets ondska"]},{"type":"verse","number":2,"content":[{"text":"Herre, hur länge","poem":1},{"text":"ska jag ropa på hjälp","poem":2},{"text":"utan att du hör,","poem":3},{"text":"ropa högt till dig över våld","poem":2},{"text":"utan att du räddar?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Varför låter du mig se ondska,","poem":1},{"text":"och hur kan du själv","poem":2},{"text":"se på sådant elände?","poem":3},{"text":"Fördärv och våld är inför mig,","poem":2},{"text":"det uppstår tvister och gräl.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Därför blir lagen utan kraft,","poem":1},{"text":"och rätten kommer aldrig fram.","poem":3},{"text":"Den ogudaktige omringar","poem":2},{"text":"den rättfärdige","poem":3},{"text":"och rätten förvrängs.","poem":2}]},{"type":"heading","content":["Herrens svar"]},{"type":"verse","number":5,"content":[{"text":"Se er omkring bland hednafolken,","poem":1},{"text":"se och häpna, ja, häpna,","poem":3},{"text":"för jag gör en gärning i era dagar","poem":2},{"text":"som ni inte kommer att tro","poem":3},{"text":"när den berättas.","poem":4},{"noteId":0}]},{"type":"verse","number":6,"content":[{"text":"Se, jag ska uppväcka kaldeerna","poem":1},{"noteId":1},{"text":",","poem":1},{"text":"det vilda och snabba folket","poem":2},{"text":"som drar ut över jordens vidder","poem":3},{"text":"för att ta i besittning","poem":2},{"text":"boplatser som inte är deras.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"De är skrämmande och fruktade,","poem":1},{"text":"de avgör själva","poem":2},{"text":"vad som är lag och rätt.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Deras hästar är snabbare än leoparder","poem":1},{"text":"och vildare än stäppvargar","poem":3},{"noteId":2},{"text":".","poem":3},{"text":"Deras ryttare spränger fram,","poem":2},{"text":"de kommer fjärran ifrån,","poem":3},{"text":"de flyger likt örnen","poem":2},{"text":"som störtar sig över sitt byte.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Alla kommer de med våld i sinnet,","poem":1},{"text":"stridslystna rycker de fram","poem":2},{"text":"och samlar fångar som sand.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"De gör kungar till åtlöje","poem":1},{"text":"och hånar furstar.","poem":3},{"text":"De skrattar åt alla befästningar,","poem":2},{"text":"de kastar upp jordvallar","poem":3},{"text":"och intar dem.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Så drar de vidare som vinden,","poem":1},{"text":"de fortsätter framåt","poem":2},{"text":"och samlar på sig skuld.","poem":3},{"text":"Deras egen styrka är deras gud.","poem":2}]},{"type":"heading","content":["Frågor om Guds rättfärdighet"]},{"type":"verse","number":12,"content":[{"text":"Visst har du alltid varit till,","poem":1},{"text":"Herre min Gud, min Helige?","poem":2},{"text":"Vi ska inte dö!","poem":3},{"text":"Herre, till en dom har du satt dem,","poem":2},{"text":"till en tillrättavisning","poem":3},{"text":"har du berett dem,","poem":4},{"text":"du vår klippa.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Dina ögon är för rena","poem":1},{"text":"för att se på det onda.","poem":3},{"text":"Du som inte står ut med","poem":2},{"text":"att se någon orätt,","poem":3},{"text":"hur kan du se på de trolösa och tiga","poem":2},{"text":"när den ogudaktige slukar","poem":3},{"text":"den som är mer rättfärdig än han?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Du gör människorna","poem":1},{"text":"lika fiskarna i havet,","poem":3},{"text":"lika kräldjur","poem":2},{"text":"som inte har någon herre.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"De drar upp dem alla med sin krok,","poem":1},{"text":"de fångar dem i sitt nät","poem":2},{"text":"och samlar dem i sitt garn.","poem":3},{"text":"Därför gläder de sig och jublar,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"därför offrar de åt sitt nät","poem":1},{"text":"och tänder rökelse åt sitt garn,","poem":3},{"text":"för dessa gör deras andel fet","poem":2},{"text":"och deras mat så läcker.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Men ska de få vittja sitt nät","poem":1},{"text":"och ständigt dräpa folken","poem":2},{"text":"utan förskoning?","poem":3}]}],"footnotes":[{"noteId":0,"caller":"-","text":"Citeras av Paulus i Apg 13:41 som varning till dem som förhärdade sig mot tron.","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"-","text":"kaldeernaArameiskt folk kring Babel i nuvarande Irak som frigjorde sig från Assyrien ca 620 f Kr och krossade huvudstaden Nineve 612 f Kr (se Nahums bok). Kung Nebukadnessar tog över hela regionen efter slaget vid Karkemish 605 f Kr (2 Krön 35:20, Dan 1:1 med not).","reference":{"chapter":1,"verse":6}},{"noteId":2,"caller":"-","text":"stäppvargarAnnan översättning: ”kvällens vargar”.","reference":{"chapter":1,"verse":8}}]},"thisChapterLink":"/api/swe_fol/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}