{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HAB","translationId":"swe_fol","name":"Habackuk","commonName":"Habackuk","title":"Habackuk","order":35,"numberOfChapters":3,"sha256":"220af71bf3f883facf041e416ff1da82cb7e5e77bbaf816f399b9da4c9bc3113","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Jag ska stå på min vaktpost",{"text":"och ställa mig i tornet.","poem":3},{"text":"Jag vill spana för att se","poem":2},{"text":"vad han ska tala till mig,","poem":3},{"text":"vilket svar jag ska få","poem":2},{"text":"på min klagan.","poem":3}]},{"type":"heading","content":["Herrens svar"]},{"type":"verse","number":2,"content":[{"text":"Herren svarade mig och sade:","poem":1},{"text":"Skriv ner synen","poem":3},{"text":"och gör den tydlig på tavlor","poem":2},{"text":"så att den lätt kan läsas","poem":3},{"noteId":3},{"text":",","poem":3}]},{"type":"verse","number":3,"content":[{"text":"för synen väntar ännu på sin tid.","poem":1},{"text":"Han","poem":2},{"noteId":4},{"text":"skyndar mot slutet","poem":2},{"noteId":5},{"text":"och sviker inte.","poem":3},{"text":"Om han dröjer,","poem":2},{"text":"så vänta på honom,","poem":3},{"text":"för han kommer helt visst,","poem":2},{"text":"han uteblir inte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Se, hans själ är uppblåst","poem":1},{"text":"och oärlig i honom.","poem":3},{"noteId":6},{"text":"Men den rättfärdige ska leva","poem":2},{"text":"genom sin tro","poem":3},{"noteId":7},{"text":".","poem":3},{"noteId":8}]},{"type":"verse","number":5,"content":[{"text":"Ja, vinet bedrar.","poem":1},{"text":"Han är en högmodig man","poem":2},{"text":"och kommer inte till ro.","poem":3},{"text":"Han spärrar upp sitt gap","poem":2},{"text":"som dödsriket,","poem":3},{"text":"han är som döden","poem":2},{"text":"och blir inte mätt.","poem":3},{"text":"Han samlar alla hednafolk till sig,","poem":2},{"text":"han drar till sig alla folkslag.","poem":3}]},{"type":"heading","content":["Ve över förtryckaren"]},{"type":"verse","number":6,"content":[{"text":"Ska de inte alla stämma upp","poem":1},{"text":"en visa om honom,","poem":3},{"text":"en smädesång med gåtfulla ord","poem":2},{"text":"och säga:","poem":3},{"text":"Ve dig som samlar","poem":2},{"text":"vad som inte är ditt","poem":3},{"text":"– hur länge till? –","poem":4},{"text":"och tynger dig med pantsatt gods!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ska inte dina fordringsägare","poem":1},{"text":"plötsligt resa sig?","poem":3},{"text":"De som får dig att darra ska vakna,","poem":2},{"text":"och du blir deras byte.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Du har plundrat många hednafolk,","poem":1},{"text":"därför ska de andra folken","poem":2},{"noteId":9},{"text":"plundra dig,","poem":3},{"text":"på grund av blodsdåd","poem":2},{"text":"mot människor","poem":3},{"text":"och våld mot land och stad","poem":2},{"text":"och alla som bor där.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ve den som skaffar","poem":1},{"text":"oärlig vinst åt sitt hus","poem":3},{"text":"för att bygga sitt näste högt","poem":2},{"text":"och rädda sig undan","poem":3},{"text":"olyckans våld!","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Du har planerat,","poem":1},{"text":"till skam för ditt hus,","poem":3},{"text":"att förgöra många folk","poem":2},{"text":"och syndar så mot dig själv,","poem":3}]},{"type":"verse","number":11,"content":[{"text":"för stenarna i muren ska ropa","poem":1},{"text":"och bjälkarna i trävirket","poem":2},{"text":"ska svara dem.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ve den som bygger en stad","poem":1},{"text":"med blodsdåd","poem":3},{"text":"och grundar en stad","poem":2},{"text":"med orättfärdighet!","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Se, kommer det inte","poem":1},{"text":"från Herren Sebaot","poem":3},{"text":"att folken sliter","poem":2},{"text":"för det som bränns upp","poem":3},{"text":"och tröttar ut sig till ingen nytta?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jorden ska fyllas av kunskap","poem":1},{"text":"om Herrens härlighet,","poem":3},{"text":"så som vattnet täcker havets djup.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ve dig som ger din nästa","poem":1},{"text":"att dricka,","poem":3},{"text":"som blandar i ditt gift","poem":2},{"text":"och berusar dem","poem":3},{"text":"för att få se deras nakenhet.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Du blir mättad med skam","poem":1},{"text":"och inte med ära.","poem":3},{"text":"Drick också du","poem":2},{"text":"och visa att du är oomskuren!","poem":3},{"text":"Bägaren i Herrens högra hand","poem":2},{"text":"ska vändas mot dig,","poem":3},{"text":"vanära ska drabba din härlighet.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ja, våldet mot Libanon","poem":1},{"noteId":10},{"text":"och skövlingen","poem":2},{"text":"som skrämde dess djur","poem":3},{"text":"ska täcka dig,","poem":4},{"text":"på grund av blodsdåd","poem":2},{"text":"mot människor","poem":3},{"text":"och våld mot land och stad","poem":2},{"text":"och alla som bor där.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Vad nytta gör en avgud","poem":1},{"text":"som en människa har snidat,","poem":3},{"text":"eller en gjuten avgud","poem":2},{"text":"som är en falsk lärare?","poem":3},{"text":"Den som gör den","poem":2},{"text":"litar till sitt eget verk.","poem":3},{"text":"Han gör avgudar som inte kan tala.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ve den som säger till träbiten:","poem":1},{"text":"”Vakna!”","poem":3},{"text":"och till en stum sten: ”Res dig!”","poem":2},{"text":"Kan den undervisa?","poem":3},{"text":"Den är överdragen","poem":2},{"text":"med guld och silver,","poem":3},{"text":"men det finns ingen ande i den.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Men Herren är i sitt heliga tempel.","poem":1},{"text":"Var stilla inför honom, hela jorden!","poem":2}]}],"footnotes":[{"noteId":3,"caller":"-","text":"att den lätt kan läsasAnnan översättning: ”att läsaren/utroparen kan springa med den” (antingen skrivtavlan eller budskapet, efter att ha läst det).","reference":{"chapter":2,"verse":2}},{"noteId":4,"caller":"-","text":"HanProfetia om Messias enligt judisk tradition, citeras i Hebr 10:37. Annan översättning: ”Den” (synen).","reference":{"chapter":2,"verse":3}},{"noteId":5,"caller":"-","text":"skyndar mot slutetAnnan översättning: ”vittnar om slutet”.","reference":{"chapter":2,"verse":3}},{"noteId":6,"caller":"-","text":"Se, hans själ är uppblåst och oärlig i honomAndra handskrifter (Septuaginta): ”Drar han sig undan, har min själ ingen glädje i honom”. Citeras så i Hebr 10:38.","reference":{"chapter":2,"verse":4}},{"noteId":7,"caller":"-","text":"sin troAndra handskrifter (Septuaginta): ”min trohet”.","reference":{"chapter":2,"verse":4}},{"noteId":8,"caller":"-","text":"Citeras av Paulus i Rom 1:17 och Gal 3:11 för att visa rättfärdigheten genom tron.","reference":{"chapter":2,"verse":4}},{"noteId":9,"caller":"-","text":"de andra folkenMeder, perser, elamiter och andra folk i nuvarande Iran som under Koresh besegrade Babel år 539 f Kr (se Dan 5:28f).","reference":{"chapter":2,"verse":8}},{"noteId":10,"caller":"-","text":"våldet mot LibanonEnligt Nebukadnessars kungliga krönika röjde han en timmerväg och förde cedrarna till Babel för att bygga sitt palats och Marduks tempel.","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/swe_fol/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}