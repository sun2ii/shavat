{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HAB","translationId":"swe_fol","name":"Habackuk","commonName":"Habackuk","title":"Habackuk","order":35,"numberOfChapters":3,"sha256":"220af71bf3f883facf041e416ff1da82cb7e5e77bbaf816f399b9da4c9bc3113","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Habackuks bön och lovsång"]},{"type":"verse","number":1,"content":["En bön av profeten Habackuk, till shigjonót",{"noteId":11},"."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, jag har hört","poem":1},{"text":"budskapet om dig och jag bävar.","poem":3},{"text":"Herre, ge liv åt ditt verk","poem":2},{"text":"i våra dagar,","poem":4},{"text":"låt det bli känt i vår tid.","poem":3},{"text":"Tänk i din vrede","poem":2},{"text":"på att förbarma dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gud kommer från Teman,","poem":1},{"text":"den Helige från berget Paran","poem":3},{"noteId":12},{"text":". Sela","poem":3},{"text":"Hans härlighet täcker himlen,","poem":2},{"text":"hans lov fyller jorden.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Hans glans är som ljuset,","poem":1},{"text":"strålar går ut från hans hand,","poem":2},{"text":"där är hans styrka dold.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Framför honom går pest,","poem":1},{"text":"och brinnande feber","poem":2},{"noteId":13},{"text":"följer i hans spår.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han träder fram och jorden skakar,","poem":1},{"text":"folken bävar för hans blick.","poem":3},{"text":"Urgamla berg splittras,","poem":2},{"text":"eviga höjder sjunker ner.","poem":3},{"text":"Hans vägar är eviga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag ser Kushans hyddor i nöd,","poem":1},{"text":"tältdukarna i Midjans land darrar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Vredgas Herren på floderna?","poem":1},{"text":"Brinner din vrede mot strömmarna","poem":2},{"text":"eller din harm mot havet,","poem":3},{"text":"när du far fram med dina hästar,","poem":2},{"text":"med dina segervagnar?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Blottad och bar är din båge,","poem":1},{"text":"som edsvurna pilar är ditt ord.","poem":2},{"text":"Sela","poem":3},{"text":"Du låter floder klyva jorden.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bergen ser dig och bävar,","poem":1},{"text":"störtregn forsar ner,","poem":3},{"text":"djupet höjer sin röst,","poem":2},{"text":"det lyfter sina händer mot höjden.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Sol och måne står still i sin boning","poem":1},{"text":"vid skenet av dina pilar","poem":2},{"text":"som flyger,","poem":3},{"text":"vid glansen","poem":2},{"text":"av ditt blixtrande spjut.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"I raseri går du fram över jorden,","poem":1},{"text":"i vrede trampar du ner","poem":2},{"text":"hednafolken.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Du drar ut för att frälsa ditt folk,","poem":1},{"text":"för att frälsa din smorde.","poem":3},{"text":"Du krossar taket","poem":2},{"text":"på den gudlöses hus,","poem":3},{"text":"du bryter ner det","poem":2},{"text":"från tinnarna till grunden. Sela","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Med hans egna spjut","poem":1},{"text":"genomborrar du huvudet","poem":2},{"text":"på hans krigare,","poem":3},{"text":"när de stormar fram","poem":2},{"text":"för att fördriva mig.","poem":3},{"text":"Deras glädje är att sluka","poem":2},{"text":"den svage i hemlighet.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Du far fram med dina hästar","poem":1},{"text":"genom havet,","poem":2},{"text":"genom väldiga vattens svall.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Jag hör det och darrar i mitt innersta,","poem":1},{"text":"vid dånet skälver mina läppar.","poem":3},{"text":"Röta tränger in i benen i min kropp.","poem":2},{"text":"Jag darrar där jag står,","poem":3},{"text":"för jag måste stilla vänta","poem":2},{"text":"på olyckans dag,","poem":3},{"text":"att den drabbar det folk","poem":2},{"text":"som angriper oss.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Fikonträdet blomstrar inte mer,","poem":1},{"text":"och vinstocken ger ingen skörd.","poem":3},{"text":"Olivträdets frukt slår fel,","poem":2},{"text":"och fälten ger ingen föda.","poem":3},{"text":"Fåren rycks bort ur fållorna,","poem":2},{"text":"och ingen boskap finns i stallen.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Men jag vill jubla i Herren","poem":1},{"text":"och glädja mig i min frälsnings Gud.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Herren Gud är min styrka.","poem":1},{"text":"Han gör mina fötter som hjortens","poem":2},{"text":"och låter mig gå fram","poem":3},{"text":"över mina höjder.","poem":4},{"lineBreak":true},"För sångmästaren, med mitt strängaspel."]}],"footnotes":[{"noteId":11,"caller":"-","text":"shigjonótOkänd musikterm. Möjligen ”klagopsalm” (jfr Ps 7:1).","reference":{"chapter":3,"verse":1}},{"noteId":12,"caller":"-","text":"Teman … ParanOmråden i ökentrakterna söder om Döda havet (jfr 5 Mos 33:2).","reference":{"chapter":3,"verse":3}},{"noteId":13,"caller":"-","text":"pest … brinnande feberAnnan översättning: ”Ordet … flammor”.","reference":{"chapter":3,"verse":5}}]},"thisChapterLink":"/api/swe_fol/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}