{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HAG","translationId":"swe_fol","name":"Haggai","commonName":"Haggai","title":"Haggai","order":37,"numberOfChapters":2,"sha256":"86e88aeb6a0de2d778a537e53c24c87c4699b01eb88b1f020ee9862147df7946","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HAG/1.json","lastChapterNumber":2,"lastChapterApiLink":"/api/swe_fol/HAG/2.json","totalNumberOfVerses":38},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Detta hände på tjugofjärde dagen i sjätte månaden",{"noteId":4},"av kung Darejaveshs andra regeringsår."]},{"type":"heading","content":["Det nya templets härlighet"]},{"type":"verse","number":2,"content":["I sjunde månaden, på tjugoförsta dagen i månaden",{"noteId":5},", kom Herrens ord genom profeten Haggai. Han sade:"]},{"type":"verse","number":3,"content":["Säg till Serubbabel, Shealtiels son, ståthållare i Juda, och till översteprästen Josua, Josadaks son, och till dem som är kvar av folket:"]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vilka är kvar bland er","poem":1},{"text":"som har sett detta hus","poem":2},{"text":"i dess forna härlighet?","poem":3},{"noteId":6},{"text":"Hur tycker ni att det ser ut nu?","poem":2},{"text":"Är det inte som ingenting","poem":3},{"text":"i era ögon?","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Men var nu frimodig, Serubbabel,","poem":1},{"text":"säger Herren,","poem":3},{"text":"var frimodig, du överstepräst Josua,","poem":2},{"text":"Josadaks son,","poem":3},{"text":"var frimodiga,","poem":2},{"text":"alla ni människor i landet,","poem":3},{"text":"säger Herren.","poem":4},{"text":"Arbeta, för jag är med er,","poem":2},{"text":"säger Herren Sebaot.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Det löftet gav jag er","poem":1},{"text":"när ni drog ut ur Egypten,","poem":3},{"text":"och min Ande är mitt ibland er.","poem":2},{"text":"Var inte rädda!","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Inom kort ska jag än en gång","poem":3},{"text":"skaka himlen och jorden,","poem":2},{"text":"havet och det torra.","poem":3},{"noteId":7}]},{"type":"verse","number":8,"content":[{"text":"Jag ska skaka om alla hednafolk,","poem":1},{"text":"och alla folkens skatter","poem":2},{"noteId":8},{"text":"ska komma hit.","poem":3},{"text":"Och jag ska fylla detta hus","poem":2},{"text":"med härlighet,","poem":3},{"text":"säger Herren Sebaot.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Mitt är silvret och mitt är guldet,","poem":1},{"text":"säger Herren Sebaot.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Den kommande härligheten","poem":1},{"text":"hos detta hus","poem":3},{"text":"ska bli större än den förra,","poem":2},{"text":"säger Herren Sebaot,","poem":3},{"text":"och på denna plats","poem":2},{"text":"ska jag ge frid,","poem":3},{"text":"säger Herren Sebaot.","poem":4}]},{"type":"heading","content":["Ny välsignelse"]},{"type":"verse","number":11,"content":["På tjugofjärde dagen i nionde månaden av Darejaveshs andra regeringsår",{"noteId":9},"kom Herrens ord till profeten Haggai. Han sade:"]},{"type":"verse","number":12,"content":["Så säger Herren Sebaot: Fråga prästerna vad lagen säger:"]},{"type":"verse","number":13,"content":["”Om någon bär heligt kött i sin mantelflik och med fliken rör vid bröd, kokt mat, vin, olja eller annan mat, blir det då heligt?” Prästerna svarade: ”Nej.”"]},{"type":"verse","number":14,"content":["Sedan frågade Haggai: ”Om en som blivit oren genom en död rör vid något av allt detta, blir det då orent?”",{"noteId":10},"Prästerna svarade: ”Ja, det blir orent.”"]},{"type":"verse","number":15,"content":["Då sade Haggai:",{"lineBreak":true},{"text":"Så är det med detta folk,","poem":1},{"text":"så är det med detta hednafolk","poem":2},{"text":"inför mig, säger Herren,","poem":3},{"text":"och så är det med allt","poem":2},{"text":"som deras händer gör:","poem":3},{"text":"Det de offrar där är orent.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lägg nu märke till det som sker,","poem":1},{"text":"från i dag och framåt!","poem":3},{"text":"Innan det lades sten på sten","poem":2},{"text":"till Herrens tempel,","poem":3},{"text":"hur var det då?","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Kom man till en sädeshög","poem":1},{"text":"som skulle ge tjugo mått","poem":2},{"text":"gav den bara tio,","poem":3},{"text":"kom man till vinpressen","poem":2},{"text":"för att ösa femtio kärl","poem":3},{"text":"gav den bara tjugo.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Jag slog er med sot och rost","poem":1},{"noteId":11},{"text":"och alla era händers verk","poem":3},{"text":"med hagel,","poem":4},{"text":"och ändå vände ni er inte till mig,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lägg märke till det som sker","poem":1},{"text":"från i dag och framåt,","poem":3},{"text":"från den tjugofjärde dagen","poem":2},{"text":"i nionde månaden,","poem":3},{"text":"från dagen då grunden lades","poem":2},{"text":"till Herrens tempel.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Finns det någon säd kvar","poem":1},{"text":"i kornboden?","poem":3},{"text":"Varken vinstocken, fikonträdet,","poem":2},{"text":"granatträdet eller olivträdet","poem":3},{"text":"har burit någon frukt än.","poem":4},{"text":"Men från denna dag","poem":2},{"text":"ska jag välsigna.”","poem":3}]},{"type":"heading","content":["Serubbabel – Herrens signetring"]},{"type":"verse","number":21,"content":["Herrens ord kom för andra gången till Haggai, på tjugofjärde dagen i samma månad. Han sade:"]},{"type":"verse","number":22,"content":["Säg till Serubbabel, Juda ståthållare:",{"lineBreak":true},{"text":"Jag ska skaka himlen","poem":1},{"text":"och jorden.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jag ska störta kungatroner","poem":1},{"text":"och göra hednarikenas makt","poem":2},{"text":"om intet.","poem":3},{"text":"Jag ska välta vagnar","poem":2},{"text":"och deras förare,","poem":3},{"text":"och hästar och deras ryttare","poem":2},{"text":"ska falla,","poem":3},{"text":"den ene för den andres svärd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":["På den dagen, säger Herren Sebaot, ska jag ta dig, min tjänare Serubbabel, Shealtiels son, säger Herren, och göra dig till en signetring.",{"noteId":12},"För jag har utvalt dig, säger Herren Sebaot."]}],"footnotes":[{"noteId":4,"caller":"-","text":"tjugofjärde dagen i sjätte månaden21 sept 520 f Kr.","reference":{"chapter":2,"verse":1}},{"noteId":5,"caller":"-","text":"sjunde månaden, på tjugoförsta dagen17 okt 520 f Kr, lövhyddohögtidens sista dag när hela folket var samlat vid templet i Jerusalem till skördefest (3 Mos 23:34f, 5 Mos 16:13f). Detta år hade skörden dock slagit fel (1:6, 10, 2:20).","reference":{"chapter":2,"verse":2}},{"noteId":6,"caller":"-","text":"i dess forna härlighetDet första templet hade skövlats år 587 f Kr, 67 år tidigare.","reference":{"chapter":2,"verse":4}},{"noteId":7,"caller":"-","text":"Citeras i Heb 12:26.","reference":{"chapter":2,"verse":7}},{"noteId":8,"caller":"-","text":"folkens skatterOrdagrant: ”det/den som folken längtar efter” (möjlig profetia om Kristus, jfr Mal 3:1).","reference":{"chapter":2,"verse":8}},{"noteId":9,"caller":"-","text":"tjugofjärde dagen i nionde månaden18 dec 520 f Kr (även i 2:21).","reference":{"chapter":2,"verse":11}},{"noteId":10,"caller":"-","text":"orentRituell orenhet smittade genom beröring tills den tvättades bort (3 Mos 22:4f, 4 Mos 19:11f).","reference":{"chapter":2,"verse":14}},{"noteId":11,"caller":"-","text":"sot och rostSädessjukdomar som orsakades av ökenvindar och svampangrepp.","reference":{"chapter":2,"verse":18}},{"noteId":12,"caller":"-","text":"signetringStämpelring för underskrift, en nära personlig tillhörighet (jfr Höga V 8:6, Jer 22:24).","reference":{"chapter":2,"verse":24}}]},"thisChapterLink":"/api/swe_fol/HAG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ZEC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HAG/1.json","previousChapterAudioLinks":{},"numberOfVerses":24}