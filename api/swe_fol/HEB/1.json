{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HEB","translationId":"swe_fol","name":"Hebreerbrevet","commonName":"Hebreerbrevet","title":"Hebreerbrevet","order":58,"numberOfChapters":13,"sha256":"5fd619a958aea2a39efd816c2c0d49c1c13b79015fda654ad32ad6c370feeab4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/swe_fol/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Gud har talat genom Sonen"]},{"type":"verse","number":1,"content":["I forna tider talade Gud många gånger och på många sätt till fäderna genom profeterna,"]},{"type":"verse","number":2,"content":["men nu i den sista tiden har han talat till oss genom sin Son. Honom har han insatt som arvinge till allt, och genom honom har han också skapat universum",{"noteId":0},"."]},{"type":"verse","number":3,"content":["Sonen är utstrålningen av Guds härlighet och hans väsens avbild, och han bär allt med sitt mäktiga ord. Och sedan han fullbordat en rening från synderna sitter han nu på Majestätets högra sida i höjden."]},{"type":"heading","content":["Sonen är större än änglarna"]},{"type":"verse","number":4,"content":["Sonen är så mycket större än änglarna som namnet han har ärvt är högre än deras."]},{"type":"verse","number":5,"content":["Till vilken av änglarna har Gud någonsin sagt:",{"noteId":1},{"text":"Du är min Son,","poem":1},{"text":"jag har fött dig i dag?","poem":2},{"lineBreak":true},"Eller:",{"text":"Jag ska vara hans Far,","poem":1},{"text":"och han ska vara min Son?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Men när han låter den Förstfödde träda in i världen, säger han:",{"noteId":2},{"text":"Alla Guds änglar","poem":1},{"text":"ska tillbe honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":["Om änglarna säger han:",{"text":"Han gör sina änglar till vindar","poem":1},{"text":"och sina tjänare till eldslågor.","poem":2},{"noteId":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":["Men om Sonen säger han:",{"text":"Gud, din tron består","poem":1},{"text":"i evigheters evighet,","poem":3},{"text":"och ditt rikes spira","poem":2},{"text":"är rättens spira.","poem":3},{"noteId":4}]},{"type":"verse","number":9,"content":[{"text":"Du älskar rättfärdighet","poem":1},{"text":"och hatar orättfärdighet.","poem":3},{"text":"Därför, Gud, har din Gud","poem":2},{"text":"smort dig med glädjens olja","poem":3},{"text":"mer än dina medbröder.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Och:",{"text":"I begynnelsen lade du, Herre,","poem":1},{"text":"jordens grund,","poem":3},{"text":"och himlarna är","poem":2},{"text":"dina händers verk.","poem":3},{"noteId":5}]},{"type":"verse","number":11,"content":[{"text":"De ska gå under,","poem":1},{"text":"men du ska bestå.","poem":3},{"text":"De ska alla nötas ut som kläder,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"du ska rulla ihop dem","poem":1},{"text":"som en mantel","poem":3},{"text":"och de ska bytas ut","poem":2},{"text":"som kläder.","poem":3},{"text":"Men du är densamme,","poem":2},{"text":"och dina år har inget slut.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Till vilken av änglarna har han någonsin sagt:",{"noteId":6},{"text":"Sätt dig på min högra sida","poem":1},{"text":"tills jag lagt dina fiender","poem":2},{"text":"som en pall under dina fötter?","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":["Är inte änglarna andar i Guds tjänst, utsända för att hjälpa dem som ska ärva frälsningen?"]}],"footnotes":[{"noteId":0,"caller":"-","text":"universumAnnan översättning: \"världarna\", \"tidsåldrarna\" (även i 11:3).","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"-","text":"2 Sam 7:14, Ps 2:7.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"-","text":"5 Mos 32:43 (Septuaginta), Ps 97:7.","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"-","text":"Ps 104:4 (Septuaginta).","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"-","text":"Ps 45:7f. Annan översättning i vers 9: \"Därför har Gud, din Gud, smort…\".","reference":{"chapter":1,"verse":8}},{"noteId":5,"caller":"-","text":"Ps 102:26f.","reference":{"chapter":1,"verse":10}},{"noteId":6,"caller":"-","text":"Ps 110:1.","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/swe_fol/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}