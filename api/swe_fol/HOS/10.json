{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"heading","content":["Israels synder och fångenskap"]},{"type":"verse","number":1,"content":["Israel var en frodig vinstock",{"text":"som bar frukt.","poem":3},{"text":"Men ju mer frukt han fick,","poem":2},{"text":"desto fler altaren byggde han.","poem":3},{"text":"Ju bättre det gick för hans land,","poem":2},{"text":"desto finare stoder reste han.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Deras hjärta är delat,","poem":1},{"text":"nu ska de lida sitt straff.","poem":3},{"text":"Han ska själv bryta ner","poem":2},{"text":"deras altaren","poem":3},{"text":"och förstöra deras stoder.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nu ska de säga:","poem":1},{"text":"”Vi har ingen kung,","poem":2},{"text":"för vi fruktar inte Herren.","poem":3},{"text":"Och en kung, vad skulle han","poem":2},{"text":"kunna göra för oss?”","poem":3}]},{"type":"verse","number":4,"content":[{"text":"De talar tomma ord,","poem":1},{"text":"de svär falska eder","poem":2},{"text":"och sluter förbund,","poem":3},{"text":"och domen skjuter upp","poem":2},{"text":"som en giftig planta","poem":3},{"text":"ur åkerns fåror.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"De som bor i Samaria","poem":1},{"text":"ska vara rädda för kalven","poem":3},{"text":"i Bet-Aven","poem":4},{"noteId":41},{"text":".","poem":4},{"text":"Folket ska sörja över den,","poem":2},{"text":"avgudaprästerna ska darra,","poem":3},{"text":"eftersom dess härlighet","poem":2},{"text":"ska föras bort i fångenskap.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Också den ska föras till Assyrien","poem":1},{"text":"som en gåva åt den store kungen.","poem":3},{"text":"Skam ska Efraim få,","poem":2},{"text":"Israel ska komma på skam","poem":3},{"text":"med sina planer.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Samariens kung ska försvinna","poem":1},{"text":"som en pinne på vattnet.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ödelagda blir Avens offerhöjder","poem":1},{"noteId":42},{"text":",","poem":1},{"text":"Israels synd.","poem":3},{"text":"Törne och tistel ska skjuta upp","poem":2},{"text":"på deras altaren.","poem":3},{"text":"Då ska man säga till bergen","poem":1},{"noteId":43},{"text":":","poem":1},{"text":"”Göm oss!”","poem":3},{"text":"och till höjderna: ”Fall över oss!”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Israel, ända sedan Gibeas dagar","poem":1},{"text":"har du syndat.","poem":3},{"text":"Där har de stannat,","poem":2},{"text":"utan att kriget mot brottslingarna","poem":3},{"text":"nådde dem i Gibea.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"När jag vill ska jag tukta dem.","poem":1},{"text":"Folken ska samlas mot dem","poem":2},{"text":"när jag binder dem","poem":3},{"text":"vid deras dubbla synd.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Efraim är en inkörd kviga","poem":1},{"text":"som gärna vill tröska.","poem":3},{"text":"Men jag ska lägga ett ok","poem":2},{"text":"över","poem":3},{"noteId":44},{"text":"hennes vackra nacke.","poem":3},{"text":"Jag ska spänna för Efraim,","poem":2},{"text":"Juda ska plöja, Jakob ska harva.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Så åt er i rättfärdighet,","poem":1},{"text":"skörda efter kärlekens bud,","poem":2},{"text":"bryt er ny mark.","poem":3},{"text":"Det är tid att söka Herren,","poem":2},{"text":"tills han kommer och låter","poem":3},{"text":"rättfärdighet regna över er.","poem":4},{"noteId":45}]},{"type":"verse","number":13,"content":[{"text":"Ni har plöjt ogudaktighet,","poem":1},{"text":"ni har skördat orättfärdighet,","poem":2},{"text":"ni har ätit lögnens frukt,","poem":3},{"text":"för du har förlitat dig","poem":2},{"text":"på din egen väg,","poem":3},{"text":"på dina många hjältar.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Stridslarm ska stiga","poem":1},{"text":"bland dina stammar,","poem":3},{"text":"och alla dina fästen ska ödeläggas","poem":2},{"text":"som när Bet-Arbel","poem":3},{"noteId":46},{"text":"ödelades","poem":3},{"text":"av Shalman på stridens dag","poem":4},{"text":"och mödrar och barn krossades.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Så ska Betel göra med er","poem":1},{"text":"för er stora ondskas skull.","poem":3},{"text":"När gryningen kommer","poem":2},{"text":"är det förbi,","poem":3},{"text":"förbi med Israels kung!","poem":4}]}],"footnotes":[{"noteId":41,"caller":"-","text":"Bet-AvenBetyder ”syndens hus”, omskrivning för Betel, ”Guds hus” (se v 8 och 1 Kung 12:28f).","reference":{"chapter":10,"verse":5}},{"noteId":42,"caller":"-","text":"Avens offerhöjderAvgudahelgedomarna i Betel (se 1 Kung 12:28f).","reference":{"chapter":10,"verse":8}},{"noteId":43,"caller":"-","text":"Då ska man säga till bergenVersen citeras av Jesus i Luk 23:30 och i Upp 6:16.","reference":{"chapter":10,"verse":8}},{"noteId":44,"caller":"-","text":"lägga ett ok överAnnan översättning: ”skona”.","reference":{"chapter":10,"verse":11}},{"noteId":45,"caller":"-","text":"låter rättfärdighet regna över erAnnan översättning: ”lär er rättfärdighet” (jfr Joel 2:23 med not).","reference":{"chapter":10,"verse":12}},{"noteId":46,"caller":"-","text":"Bet-ArbelTvå städer bar detta namn, väster om Galileiska sjön och öster om Jordan. Dessa båda områden härjades år 732 f Kr av Assyriens kung Tiglat-Pileser III (2 Kung 15:29), troligen med hjälp av hans son Shalmaneser (Shalman) som sedan blev kung 727 f Kr (2 Kung 17:4).","reference":{"chapter":10,"verse":14}}]},"thisChapterLink":"/api/swe_fol/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}