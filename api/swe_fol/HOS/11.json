{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Guds hjärta för upproriska Israel"]},{"type":"verse","number":1,"content":["När Israel var ung",{"text":"fick jag honom kär,","poem":3},{"text":"och ut ur Egypten","poem":2},{"text":"kallade jag min son.","poem":3},{"noteId":47}]},{"type":"verse","number":2,"content":[{"text":"Men ju mer man kallar dem,","poem":1},{"text":"desto mer drar de sig undan.","poem":3},{"text":"De offrar åt baalerna","poem":2},{"text":"och tänder rökelse","poem":3},{"text":"åt avgudabilderna.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Ändå var det jag","poem":1},{"text":"som lärde Efraim att gå","poem":2},{"text":"och som tog dem i mina armar.","poem":3},{"text":"Men de förstod inte","poem":2},{"text":"att jag ville hela dem.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Med lena band drog jag dem,","poem":1},{"text":"med kärlekens band.","poem":3},{"text":"Jag var för dem lik den som","poem":2},{"text":"lättar oket över deras nackar","poem":3},{"noteId":48},{"text":",","poem":3},{"text":"jag böjde mig ner till dem","poem":2},{"text":"och gav dem mat.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"De ska inte få vända tillbaka","poem":1},{"text":"till Egyptens land,","poem":3},{"text":"utan Assur","poem":2},{"noteId":49},{"text":"ska bli deras kung","poem":2},{"text":"eftersom de vägrade","poem":3},{"text":"att omvända sig.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Svärdet ska rasa i deras städer","poem":1},{"text":"och förstöra deras bommar","poem":2},{"text":"och frossa omkring sig","poem":3},{"text":"för deras onda planers skull.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mitt folk hänger fast","poem":1},{"text":"vid sin otrohet mot mig,","poem":3},{"text":"och hur man än kallar dem","poem":2},{"text":"till den som är därovan,","poem":3},{"text":"upphöjer ändå ingen honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hur ska jag kunna överge dig, Efraim?","poem":1},{"text":"Ska jag lämna dig, Israel?","poem":3},{"text":"Hur ska jag kunna göra med dig","poem":2},{"text":"som med Adma","poem":3},{"text":"och behandla dig som Sebojim?","poem":4},{"noteId":50},{"text":"Mitt hjärta vänder sig i mig,","poem":2},{"text":"all min barmhärtighet vaknar.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Jag vill inte utföra","poem":1},{"text":"min brinnande vrede,","poem":3},{"text":"jag vill inte ödelägga Efraim igen,","poem":2},{"text":"för jag är Gud","poem":3},{"text":"och inte en människa.","poem":4},{"text":"Jag är helig bland er","poem":2},{"text":"och vill inte komma med vrede.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Herren ska de följa,","poem":1},{"text":"och han ska ryta som ett lejon.","poem":3},{"text":"Han ska ryta och barnen","poem":2},{"text":"ska komma","poem":3},{"text":"med bävan västerifrån.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"De ska komma med bävan","poem":1},{"text":"som fåglar från Egypten","poem":2},{"text":"och som duvor från Assurs land,","poem":3},{"text":"och jag ska låta dem bo i sina hus,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"heading","content":["Israels synd"]},{"type":"verse","number":12,"content":[{"text":"Efraim har omgett mig med lögn,","poem":1},{"text":"Israels hus med svek.","poem":3},{"text":"Juda är ännu trolös mot Gud,","poem":2},{"text":"mot den Allraheligaste,","poem":3},{"text":"den Trofaste.","poem":4}]}],"footnotes":[{"noteId":47,"caller":"-","text":"Citeras i Matt 2:15 som profetia om Kristus.","reference":{"chapter":11,"verse":1}},{"noteId":48,"caller":"-","text":"lättar oket över deras nackarAnnan översättning: ”lyfter barnet till kinden”.","reference":{"chapter":11,"verse":4}},{"noteId":49,"caller":"-","text":"inte ... Egyptens land, utan AssurSe 2 Kung 17:4f för intrigerna bakom rikets undergång.","reference":{"chapter":11,"verse":5}},{"noteId":50,"caller":"-","text":"Adma … SebojimStäder som gick under med Sodom och Gomorra (1 Mos 14:8, 19:24f).","reference":{"chapter":11,"verse":8}}]},"thisChapterLink":"/api/swe_fol/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}