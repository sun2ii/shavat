{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Efraim jagar efter vind,",{"text":"han följer östanvinden","poem":2},{"text":"dagen lång,","poem":4},{"text":"lögn och våld tilltar.","poem":3},{"text":"De sluter förbund med Assur","poem":2},{"text":"och olja förs till Egypten.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Men Herren ska gå till rätta","poem":1},{"text":"med Juda","poem":3},{"text":"och straffa Jakob efter hans vägar,","poem":2},{"text":"ge honom efter hans gärningar.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"I moderlivet","poem":1},{"text":"grep han sin bror i hälen,","poem":3},{"text":"i sin mannakraft","poem":2},{"text":"kämpade han med Gud.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ja, han kämpade med ängeln","poem":1},{"text":"och vann seger,","poem":3},{"text":"han grät och bad honom","poem":2},{"text":"om nåd.","poem":3},{"text":"I Betel mötte han honom,","poem":2},{"text":"och där talade han med oss","poem":3},{"noteId":51},{"text":",","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Herren Gud Sebaot,","poem":1},{"text":"Herren är hans namn.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Så vänd om till din Gud,","poem":1},{"text":"håll fast vid kärlek och rätt","poem":2},{"text":"och vänta ständigt på din Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Handlaren","poem":1},{"noteId":52},{"text":"har falsk våg i sin hand","poem":1},{"text":"och älskar att suga ut människor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraim säger: ”Jag har blivit rik,","poem":1},{"text":"jag har fått mig en förmögenhet!","poem":3},{"text":"I allt mitt hårda arbete","poem":2},{"text":"ska ingen finna någon orätt,","poem":3},{"text":"något som är synd.”","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Jag är Herren din Gud","poem":1},{"text":"alltsedan du var i Egyptens land.","poem":3},{"text":"Jag ska på nytt låta dig bo i tält","poem":2},{"text":"som vid era högtidsdagar.","poem":3},{"noteId":53}]},{"type":"verse","number":10,"content":[{"text":"Jag har talat till profeterna,","poem":1},{"text":"jag har gett dem många syner","poem":2},{"text":"och talat genom profeterna","poem":3},{"text":"i liknelser.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Är Gilead ett ogärningsnäste?","poem":1},{"text":"Då ska de bli till intet.","poem":3},{"text":"Offrar de tjurar i Gilgal?","poem":2},{"text":"Då ska deras altaren bli stenrösen","poem":3},{"text":"längs åkerns plogfåror.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Jakob flydde till Arams land,","poem":1},{"text":"Israel tjänade för en kvinna,","poem":3},{"text":"för en kvinnas skull","poem":2},{"text":"vaktade han hjorden.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Genom en profet förde Herren","poem":1},{"text":"Israel upp ur Egypten,","poem":3},{"text":"och genom en profet","poem":2},{"text":"blev folket bevarat.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Efraim har väckt bitter vrede.","poem":1},{"text":"Hans Herre ska låta hans blodsdåd","poem":2},{"text":"drabba honom","poem":3},{"text":"och låta hans hån slå tillbaka","poem":2},{"text":"på honom.","poem":3}]}],"footnotes":[{"noteId":51,"caller":"-","text":"med ossAndra handskrifter (Septuaginta): ”med honom” (Jakob).","reference":{"chapter":12,"verse":4}},{"noteId":52,"caller":"-","text":"HandlarenAnnan översättning: ”Kananén”.","reference":{"chapter":12,"verse":7}},{"noteId":53,"caller":"-","text":"bo i tält som vid era högtidsdagarDen glada lövhyddohögtiden (3 Mos 23:34f) firades till minne av Guds välgärningar under ökenvandringen (2:14, 9:10, 13:5).","reference":{"chapter":12,"verse":9}}]},"thisChapterLink":"/api/swe_fol/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}