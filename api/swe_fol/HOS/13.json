{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Israels avguderi och otacksamhet"]},{"type":"verse","number":1,"content":["När Efraim talade",{"text":"darrade man,","poem":2},{"text":"han upphöjde sig själv i Israel.","poem":3},{"text":"Men han drog skuld över sig","poem":2},{"text":"genom Baal och dog.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Ändå fortsätter de att synda.","poem":1},{"text":"De gjuter sig avgudabilder","poem":2},{"text":"av sitt silver,","poem":3},{"text":"avgudar efter sitt eget förstånd,","poem":2},{"text":"alltsammans verk","poem":3},{"text":"av hantverkare.","poem":4},{"text":"Folk säger om dem:","poem":2},{"text":"”De offrar människor,","poem":3},{"text":"de kysser kalvar","poem":4},{"noteId":54},{"text":".”","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Därför ska de bli som morgondis,","poem":1},{"text":"som dagg som tidigt försvinner,","poem":3},{"text":"som agnar som blåser bort","poem":2},{"text":"från tröskplatsen","poem":3},{"text":"och som rök från en skorsten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jag är Herren din Gud","poem":1},{"text":"alltsedan du var i Egyptens land.","poem":3},{"text":"Du ska inte veta av","poem":2},{"text":"någon annan Gud än mig,","poem":3},{"text":"och det finns ingen annan frälsare","poem":2},{"text":"än jag.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Det var jag som vårdade dig i öknen,","poem":1},{"text":"i den brännande torkans land.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Men ju bättre bete de fick,","poem":1},{"text":"desto mättare blev de,","poem":3},{"text":"och när de var mätta","poem":2},{"text":"blev deras hjärtan högmodiga,","poem":3},{"text":"och därför glömde de mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Då blev jag som ett lejon för dem,","poem":1},{"text":"jag lurar som en leopard","poem":2},{"text":"vid vägen.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Jag kommer över dem som en","poem":1},{"text":"björnhona som mist sina ungar.","poem":3},{"text":"Jag river upp deras bröstkorg","poem":2},{"text":"och slukar dem där","poem":3},{"text":"som en lejonhona.","poem":4},{"text":"Markens vilddjur","poem":2},{"text":"ska slita dem i stycken.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Det är ditt fördärv, Israel,","poem":1},{"text":"att du är emot mig, din hjälp.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Var är din kung?","poem":1},{"text":"Var är den som skulle rädda dig","poem":2},{"text":"i alla dina städer?","poem":3},{"text":"Och var är dina domare,","poem":2},{"text":"du som sade:","poem":3},{"text":"Ge mig en kung och furstar?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jag gav dig en kung i min vrede,","poem":1},{"text":"och i min vrede tar jag bort honom.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Efraims skuld är samlad","poem":1},{"text":"som i en pung,","poem":3},{"text":"och hans synd är i förvar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Födslovärkar ska drabba honom,","poem":1},{"text":"men han är en oförståndig son:","poem":3},{"text":"han kommer inte fram","poem":2},{"text":"ur moderlivet","poem":3},{"text":"när tiden är inne.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Från dödsrikets våld","poem":1},{"text":"ska jag friköpa dem,","poem":3},{"text":"från döden","poem":2},{"text":"ska jag återlösa dem.","poem":3},{"text":"Du död, var är dina plågor?","poem":2},{"text":"Du dödsrike, var är din udd","poem":3},{"noteId":55},{"text":"?","poem":3},{"text":"Ånger är fördold för mina ögon.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bäst han frodas bland sina bröder","poem":1},{"text":"ska det komma en östanvind,","poem":3},{"text":"en Herrens vind","poem":2},{"text":"som blåser upp från öknen.","poem":3},{"text":"Då ska hans brunn torka ut","poem":2},{"text":"och hans källa sina.","poem":3},{"text":"Vinden ska röva bort","poem":2},{"text":"alla dyrbarheter","poem":3},{"text":"ur skattkammaren.","poem":4}]}],"footnotes":[{"noteId":54,"caller":"-","text":"kysser kalvarUnderkastelse visades genom att kyssa en härskares eller gudabilds fötter.","reference":{"chapter":13,"verse":2}},{"noteId":55,"caller":"-","text":"din uddAnnan översättning: ”din ödeläggelse”. Citeras av Paulus i 1 Kor 15:55.","reference":{"chapter":13,"verse":14}}]},"thisChapterLink":"/api/swe_fol/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":15}