{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Samaria ska stå med skuld,",{"text":"för hon har varit upprorisk","poem":3},{"text":"mot sin Gud.","poem":4},{"text":"Invånarna ska falla för svärd,","poem":2},{"text":"deras späda barn","poem":3},{"text":"ska bli krossade,","poem":4},{"text":"deras havande kvinnor","poem":2},{"text":"uppristade.","poem":4}]},{"type":"heading","content":["Kallelse till omvändelse"]},{"type":"verse","number":2,"content":[{"text":"Vänd om, Israel,","poem":1},{"text":"till Herren din Gud,","poem":3},{"text":"för genom din missgärning","poem":2},{"text":"har du kommit på fall.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ta med er ord","poem":1},{"text":"och vänd om till Herren,","poem":2},{"text":"säg till honom:","poem":3},{"text":"”Förlåt oss all vår skuld","poem":2},{"text":"och ta nådigt emot oss.","poem":3},{"text":"Då ska vi ge dig","poem":2},{"text":"en frukt från våra läppar","poem":3},{"noteId":56},{"text":".","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Assur kan inte rädda oss,","poem":1},{"text":"vi ska inte sitta upp","poem":2},{"text":"på stridshästar.","poem":3},{"text":"Vi ska aldrig mer säga: ’Vår Gud’","poem":2},{"text":"till våra händers verk,","poem":3},{"text":"för hos dig får den faderlöse","poem":2},{"text":"barmhärtighet.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jag vill hela dem från deras avfall,","poem":1},{"text":"jag vill älska dem generöst,","poem":3},{"text":"för min vrede","poem":2},{"text":"har vänt sig ifrån dem.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag ska bli som dagg för Israel,","poem":1},{"text":"han ska blomstra som en lilja","poem":2},{"text":"och skjuta rötter som Libanon.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Hans skott ska breda ut sig,","poem":1},{"text":"han ska bli som olivträdet i skönhet,","poem":2},{"text":"han ska dofta som Libanon.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De som bor i hans skugga","poem":1},{"text":"ska återvända.","poem":3},{"text":"De ska odla säd igen","poem":2},{"text":"och grönska som vinstockar.","poem":3},{"text":"Hans namn ska vara","poem":2},{"text":"som Libanons vin.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Efraim, vad har jag mer","poem":1},{"text":"med avgudar att göra?","poem":3},{"text":"Jag ska svara honom","poem":2},{"text":"och ta mig an honom.","poem":3},{"text":"Jag är som en grönskande cypress,","poem":2},{"text":"hos mig finner du din frukt.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Den som är vis förstår detta,","poem":1},{"text":"den förståndige besinnar det,","poem":3},{"text":"för Herrens vägar är rätta","poem":2},{"text":"och där vandrar de rättfärdiga.","poem":3},{"text":"Men syndarna kommer där på fall.","poem":2}]}],"footnotes":[{"noteId":56,"caller":"-","text":"en frukt från våra läpparAndra handskrifter: ”våra läppar som tjuroffer” (men jfr Hebr 13:15).","reference":{"chapter":14,"verse":3}}]},"thisChapterLink":"/api/swe_fol/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":10}