{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"heading","content":["Israels trolöshet och Guds trofasthet"]},{"type":"verse","number":1,"content":["Kalla era bröder Ammi",{"text":"och era systrar Ruhama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Gå till rätta med er mor,","poem":1},{"text":"gå till rätta,","poem":3},{"text":"för hon är inte min hustru","poem":2},{"text":"och jag är inte hennes man.","poem":3},{"text":"Hon måste få bort sin otukt","poem":2},{"text":"från sitt ansikte","poem":3},{"text":"och sin otrohet mellan sina bröst.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Annars ska jag klä av henne","poem":1},{"noteId":10},{"text":"naken","poem":1},{"text":"och låta henne stå där","poem":3},{"text":"sådan hon var den dag","poem":2},{"text":"då hon föddes.","poem":3},{"text":"Jag ska göra henne till en öken,","poem":2},{"text":"låta henne bli som ett torrt land","poem":3},{"text":"och dö av törst.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Hennes barn ska jag inte","poem":1},{"text":"förbarma mig över,","poem":3},{"text":"för de är barn","poem":2},{"text":"till en otrogen kvinna.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ja, deras mor var otrogen,","poem":1},{"text":"hon som födde dem","poem":2},{"text":"gjorde skamliga saker.","poem":3},{"text":"Hon sade:","poem":2},{"text":"”Jag vill följa mina älskare","poem":3},{"text":"som ger mig min mat","poem":2},{"text":"och mitt vatten,","poem":3},{"text":"min ull och mitt lin,","poem":2},{"text":"min olja och min dryck.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Se, därför ska jag stänga","poem":1},{"text":"din väg med törnen.","poem":3},{"text":"Jag ska resa en mur framför henne","poem":2},{"text":"så att hon inte finner sina stigar.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"När hon då löper efter sina älskare","poem":1},{"text":"ska hon inte få fatt på dem,","poem":3},{"text":"när hon söker dem","poem":2},{"text":"ska hon inte finna dem.","poem":3},{"text":"Då ska hon säga:","poem":2},{"text":"”Jag vill gå tillbaka","poem":3},{"text":"till min förste man,","poem":4},{"text":"för jag hade det bättre då","poem":3},{"text":"än nu.”","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Men hon har inte förstått","poem":1},{"text":"att det var jag som gav henne","poem":2},{"text":"både säden och vinet och oljan,","poem":3},{"text":"och som gav henne mycket silver","poem":2},{"text":"och guld som de använde till Baal.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Därför ska jag ta tillbaka min säd","poem":1},{"text":"när tiden är inne,","poem":3},{"text":"och mitt vin när stunden kommer.","poem":2},{"text":"Jag ska ta bort min ull och mitt lin","poem":1},{"text":"som hon skyler sin nakenhet med.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nu ska jag blotta hennes blygd","poem":1},{"text":"inför hennes älskares ögon,","poem":3},{"text":"och ingen ska rädda henne","poem":2},{"text":"ur min hand.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Jag ska göra slut","poem":1},{"text":"på all hennes fröjd,","poem":3},{"text":"på hennes fester, nymånader","poem":2},{"text":"och sabbater","poem":3},{"text":"och alla hennes högtider.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jag ska skövla hennes","poem":1},{"text":"vinstockar och fikonträd,","poem":3},{"text":"eftersom hon sade:","poem":2},{"text":"”De är min lön som mina älskare","poem":3},{"text":"har gett mig.”","poem":4},{"text":"Jag ska göra dem till en vildmark,","poem":2},{"text":"och markens djur","poem":3},{"text":"ska äta av dem.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Så ska jag straffa henne","poem":1},{"text":"för hennes baalsdagar,","poem":3},{"text":"då hon tände rökelse åt baalerna","poem":2},{"text":"och smyckade sig med ring","poem":3},{"text":"och bröstspänne","poem":4},{"text":"och följde efter sina älskare","poem":2},{"text":"men glömde mig, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Därför ska jag locka henne bort","poem":1},{"text":"och föra henne ut i öknen","poem":2},{"text":"och tala till hennes hjärta.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Sedan ska jag ge tillbaka","poem":1},{"text":"hennes vingårdar","poem":3},{"text":"och göra Akors dal","poem":2},{"noteId":11},{"text":"till en hoppets port.","poem":3},{"text":"Där ska hon sjunga","poem":2},{"noteId":12},{"text":"som i sin ungdoms dagar,","poem":3},{"text":"som på den dag då hon drog upp","poem":2},{"text":"ur Egyptens land.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Det ska ske på den dagen,","poem":1},{"text":"säger Herren,","poem":3},{"text":"att du ska kalla mig: ”Min man”","poem":2},{"text":"och inte mer kalla mig:","poem":3},{"text":"”Min Baal.”","poem":4},{"noteId":13}]},{"type":"verse","number":17,"content":[{"text":"Baalernas namn ska jag ta bort","poem":1},{"text":"ur hennes mun,","poem":3},{"text":"och man ska inte mer minnas","poem":2},{"text":"deras namn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"På den dagen ska jag","poem":1},{"text":"sluta ett förbund för dem","poem":3},{"text":"med djuren på marken,","poem":2},{"text":"med fåglarna under himlen","poem":3},{"text":"och med kräldjuren på jorden.","poem":4},{"text":"Båge och svärd och krig","poem":2},{"text":"ska jag bryta och ta bort","poem":3},{"text":"ur landet","poem":4},{"text":"och låta dem bo i trygghet.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jag ska trolova dig med mig","poem":1},{"text":"för evigt,","poem":3},{"text":"jag ska trolova dig med mig","poem":2},{"text":"i rätt och rättfärdighet,","poem":3},{"text":"i kärlek och barmhärtighet.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Jag ska trolova dig med mig i trohet,","poem":1},{"text":"och du ska känna","poem":2},{"noteId":14},{"text":"Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Och det ska ske på den dagen","poem":1},{"text":"att jag ska svara, säger Herren.","poem":3},{"text":"Jag ska svara himlen,","poem":2},{"text":"och den ska svara jorden,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"och jorden ska svara","poem":1},{"text":"säden, vinet och oljan,","poem":2},{"text":"och de ska svara Jisreel","poem":3},{"noteId":15},{"text":".","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Jag ska plantera henne åt mig","poem":1},{"text":"i landet.","poem":3},{"text":"Jag ska förbarma mig","poem":2},{"text":"över Lo-Ruhama","poem":3},{"text":"och säga till Lo-Ammi:","poem":2},{"text":"”Du är mitt folk.”","poem":3},{"text":"Och de ska svara:","poem":2},{"text":"”Du är min Gud.”","poem":3}]}],"footnotes":[{"noteId":10,"caller":"-","text":"klä av henneSkamstraff för otrogen hustru enligt de mesopotamiska Nuzitexterna från 1300-talet f Kr.","reference":{"chapter":2,"verse":3}},{"noteId":11,"caller":"-","text":"Akors dalJfr Jos 7:24-25. Hebr. achór betyder ”olycka”.","reference":{"chapter":2,"verse":15}},{"noteId":12,"caller":"-","text":"sjungaAnnan översättning: ”svara” (jfr vers 21).","reference":{"chapter":2,"verse":15}},{"noteId":13,"caller":"-","text":"min BaalHebr. báal betyder ”ägare” eller ”herre” och kunde användas om en make (t ex Est 1:20). Baal var också namnet på kananeernas fruktbarhetsgud (jfr Dom 2:13). Pluralformen ”baalerna” (vers 17) syftar troligen på andemakter knutna till lokala platser.","reference":{"chapter":2,"verse":16}},{"noteId":14,"caller":"-","text":"kännaHebr. jadáanvänds om intim äktenskaplig gemenskap (jfr 1 Mos 4:1 med not).","reference":{"chapter":2,"verse":20}},{"noteId":15,"caller":"-","text":"JisreelAnnan översättning: ”Gud planterar” (jfr v 23).","reference":{"chapter":2,"verse":22}}]},"thisChapterLink":"/api/swe_fol/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}