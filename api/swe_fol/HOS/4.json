{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Herrens anklagelser mot Israel"]},{"type":"verse","number":1,"content":["Hör Herrens ord, ni Israels barn,",{"text":"för Herren går till rätta","poem":2},{"text":"med dem som bor i landet,","poem":3},{"text":"för det finns ingen sanning","poem":2},{"text":"och ingen kärlek","poem":3},{"text":"och ingen kunskap om Gud","poem":2},{"text":"i landet.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"De svär och ljuger,","poem":1},{"text":"mördar och stjäl och är otrogna.","poem":3},{"text":"De brukar våld","poem":2},{"text":"och blodsdåd följer på blodsdåd.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Därför sörjer landet","poem":1},{"text":"och allt som lever där tynar bort,","poem":3},{"text":"både markens djur","poem":2},{"text":"och himlens fåglar","poem":3},{"text":"och havets fiskar försvinner.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ingen ska anklaga eller gå till rätta","poem":1},{"text":"med någon annan.","poem":3},{"text":"Ditt folk liknar dem som anklagar","poem":2},{"text":"en präst.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Du ska komma på fall om dagen,","poem":1},{"text":"även profeten ska komma på fall","poem":2},{"text":"tillsammans med dig om natten.","poem":3},{"text":"Också din mor ska jag förgöra.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mitt folk går under","poem":1},{"text":"av brist på kunskap.","poem":3},{"text":"Eftersom du har förkastat kunskap","poem":2},{"text":"ska också jag förkasta dig","poem":3},{"text":"från att vara min präst.","poem":4},{"text":"Du glömde","poem":2},{"text":"din Guds undervisning,","poem":3},{"text":"därför ska också jag glömma","poem":2},{"text":"dina barn.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ju fler de blev,","poem":1},{"text":"desto mer syndade de mot mig.","poem":3},{"text":"Jag ska förvandla deras ära","poem":2},{"noteId":21},{"text":"till skam.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De lever av mitt folks synd","poem":1},{"text":"och längtar efter folkets","poem":2},{"text":"missgärning.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Därför ska det gå prästen","poem":1},{"text":"och folket lika.","poem":3},{"text":"Jag ska straffa dem för deras vägar","poem":2},{"text":"och ge dem för deras gärningar.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"De ska äta men inte bli mätta,","poem":1},{"text":"begå otukt men inte föröka sig,","poem":3},{"text":"för de har slutat","poem":2},{"text":"hålla sig till Herren.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Otukt och vin, gammalt eller nytt,","poem":1},{"text":"tar bort förståndet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mitt folk frågar sin avgudabild av trä","poem":1},{"text":"och hämtar svar från sin stav,","poem":3},{"text":"för en otuktsande har vilselett dem","poem":2},{"text":"så att de begår otukt","poem":3},{"text":"och överger sin Gud.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"På bergens toppar offrar de,","poem":1},{"text":"och på höjderna tänder de rökelse","poem":2},{"text":"under ekar, popplar","poem":3},{"text":"och terebinter","poem":4},{"text":"eftersom skuggan där är skön.","poem":3},{"text":"Så begår era döttrar otukt","poem":2},{"text":"och era sonhustrur otrohet.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Jag kan inte straffa era döttrar","poem":1},{"text":"för deras otukt","poem":3},{"text":"eller era sonhustrur","poem":2},{"text":"för deras otrohet,","poem":3},{"text":"för männen går själva iväg","poem":2},{"text":"med prostituerade","poem":3},{"text":"och offrar med tempelflickor.","poem":4},{"noteId":22},{"text":"Ett folk som inget förstår går under.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Om du, Israel, vill begå otukt,","poem":1},{"text":"så låt inte Juda dra på sig skuld.","poem":3},{"text":"Gå inte till Gilgal,","poem":2},{"text":"dra inte upp till Bet-Aven","poem":3},{"noteId":23},{"text":"och svär inte:","poem":2},{"text":"”Så sant Herren lever.”","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Som en envis kviga envisas Israel.","poem":1},{"text":"Ska då Herren låta dem beta","poem":2},{"noteId":24},{"text":"som lamm på en stor äng?","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Efraim är i förbund med avgudar","poem":1},{"text":"– låt honom vara!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Deras drickande går överstyr","poem":1},{"noteId":25},{"text":",","poem":1},{"text":"hejdlöst begår de otukt.","poem":3},{"text":"Landets sköldar","poem":2},{"noteId":26},{"text":"älskar","poem":2},{"text":"skamliga ting.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Men en stormvind ska gripa dem","poem":1},{"text":"med sina vingar,","poem":3},{"text":"och de ska få skämmas","poem":2},{"text":"med sina offer.","poem":3}]}],"footnotes":[{"noteId":21,"caller":"-","text":"Jag ska förvandla deras äraArameiska targumer och Peshitta: ”De har förvandlat sin ära”.","reference":{"chapter":4,"verse":7}},{"noteId":22,"caller":"-","text":"otukt … tempelflickorHedniska fruktbarhetsriter till avgudaparet Baals och Astartes ära kopplade samman mänsklig sexualitet med hoppet om goda skördar.","reference":{"chapter":4,"verse":14}},{"noteId":23,"caller":"-","text":"Bet-AvenBetyder ”syndens hus”, platsnamn nära Betel, ”Guds hus” (jfr Jos 7:2, 1 Kung 12:28f).","reference":{"chapter":4,"verse":15}},{"noteId":24,"caller":"-","text":"Ska då Herren låta dem betaAnnan översättning: ”Nu ska HERREN låta dem beta”.","reference":{"chapter":4,"verse":16}},{"noteId":25,"caller":"-","text":"Deras drickande går överstyrGrundtexten oklar. Annan översättning: ”Deras drycker är slut”.","reference":{"chapter":4,"verse":18}},{"noteId":26,"caller":"-","text":"Landets sköldarDvs de styrande i landet (jfr Ps 47:10, 84:10).","reference":{"chapter":4,"verse":18}}]},"thisChapterLink":"/api/swe_fol/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}