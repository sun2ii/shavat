,{"text":"i deras bröst","poem":4},{"text":"och de känner inte Herren.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Israels stolthet vittnar emot honom,","poem":1},{"text":"Israel och Efraim kommer på fall","poem":2},{"text":"genom sin missgärning.","poem":3},{"text":"Också Juda kommer på fall","poem":2},{"text":"med dem.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Med får och oxar går de","poem":1},{"text":"för att söka Herren,","poem":3},{"text":"men de finner honom inte.","poem":2},{"text":"Han har dragit sig undan","poem":3},{"text":"från dem.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"De har svikit Herren,","poem":1},{"text":"för de har fött barn","poem":3},{"text":"som inte är hans.","poem":4},{"text":"Nu ska nymånadsfesten","poem":2},{"text":"förtära dem och deras åkrar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Blås i basun i Gibea,","poem":1},{"text":"i trumpet i Rama,","poem":2},{"text":"slå larm i Bet-Aven:","poem":3},{"text":"Fienden är efter dig, Benjamin!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efraim ska bli ödelagt","poem":1},{"text":"på straffets dag.","poem":3},{"text":"Bland Israels stammar","poem":2},{"text":"kungör jag vad som är sant.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Furstarna i Juda har blivit","poem":1},{"text":"lika sådana som flyttar gränser.","poem":3},{"text":"Över dem ska jag ösa","poem":2},{"text":"min vrede som vatten.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Efraim lider förtryck,","poem":1},{"text":"krossad av domen,","poem":3},{"text":"för han har frivilligt följt","poem":2},{"text":"människobud","poem":3},{"noteId":27},{"text":".","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Därför är jag som mal för Efraim","poem":1},{"text":"och som röta för Juda hus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"När Efraim såg sin sjukdom","poem":1},{"text":"och Juda sitt sår,","poem":3},{"text":"gick Efraim till Assur","poem":2},{"text":"och sände bud","poem":3},{"text":"till den store kungen.","poem":4},{"text":"Men han kan inte hela er,","poem":2},{"text":"ert sår kommer inte att läkas,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"för jag ska vara som ett lejon","poem":1},{"text":"mot Efraim,","poem":3},{"text":"som ett ungt lejon mot Juda hus.","poem":2},{"text":"Jag själv river dem","poem":3},{"text":"och går min väg,","poem":4},{"text":"jag släpar bort dem","poem":2},{"text":"och ingen kan rädda.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Jag går min väg,","poem":1},{"text":"jag återvänder till min boning","poem":3},{"text":"tills de erkänner sin skuld","poem":2},{"text":"och söker mitt ansikte.","poem":3},{"text":"I nöden ska de vända sig till mig.","poem":2}]}],"footnotes":[{"noteId":27,"caller":"-","text":"människobudAndra handskrifter (Septuaginta): ”tomhet”.","reference":{"chapter":5,"verse":11}}]},"thisChapterLink":"/api/swe_fol/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}