{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"heading","content":["Efraims och Samariens ondska"]},{"type":"verse","number":1,"content":["När jag vill hela Israel,",{"text":"då avslöjas","poem":2},{"lineBreak":true},{"text":"Efraims missgärning","poem":2},{"text":"och Samariens ondska,","poem":3},{"text":"för de begår svek,","poem":2},{"text":"tjuvar gör inbrott","poem":3},{"text":"och rövarband plundrar","poem":2},{"text":"på vägarna.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"I sina hjärtan tänker de inte på","poem":1},{"text":"att jag kommer ihåg","poem":2},{"text":"all deras ondska.","poem":3},{"text":"Nu är de omringade","poem":2},{"text":"av sina gärningar,","poem":3},{"text":"de är inför mitt ansikte.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Med sin ondska gläder de kungen","poem":1},{"text":"och med sina lögner furstarna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Alla är de äktenskapsbrytare.","poem":1},{"text":"De liknar en ugn","poem":2},{"text":"som bagaren värmt upp.","poem":3},{"text":"När han knådat degen","poem":2},{"text":"slutar han elda","poem":3},{"text":"tills degen har jäst.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"På vår kungs dag","poem":1},{"text":"drack sig furstarna","poem":2},{"text":"febriga av vin,","poem":3},{"text":"själv räckte han smädarna handen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"De kommer nära,","poem":1},{"text":"deras hjärtan är som en ugn","poem":2},{"text":"där de ligger i försåt.","poem":3},{"text":"Hela natten sover deras bagare,","poem":2},{"text":"men på morgonen brinner han","poem":3},{"text":"som en flammande eld.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Alla är de heta som en ugn","poem":1},{"text":"och förtär sina domare.","poem":3},{"text":"Alla deras kungar har fallit,","poem":2},{"text":"ingen bland dem åkallar mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Efraim blandar sig med andra folk,","poem":1},{"text":"han är som en brödkaka","poem":2},{"text":"som inte har vänts.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Främlingar har förtärt hans kraft","poem":1},{"text":"men han förstår det inte,","poem":3},{"text":"trots att han fått gråa hår","poem":2},{"text":"märker han det inte.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Israels högmod vittnar","poem":1},{"text":"mot honom.","poem":3},{"text":"De vänder inte om","poem":2},{"text":"till Herren sin Gud","poem":3},{"text":"och söker inte hans hjälp","poem":2},{"text":"trots allt detta.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Efraim har blivit som en duva,","poem":1},{"text":"naiv och utan vett.","poem":3},{"text":"De kallar på Egypten,","poem":2},{"text":"de går till Assur.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Men när de går","poem":1},{"text":"kastar jag mitt nät över dem,","poem":3},{"text":"drar ner dem","poem":2},{"text":"som fåglar under himlen.","poem":3},{"text":"Jag ska straffa dem","poem":2},{"text":"så som de hört i sin församling","poem":3},{"noteId":33},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ve över dem,","poem":1},{"text":"för de har flytt bort från mig!","poem":3},{"text":"Fördärv över dem,","poem":2},{"text":"för de har gjort uppror","poem":3},{"text":"mot mig!","poem":4},{"text":"Jag ville friköpa dem,","poem":2},{"text":"men de har talat lögner","poem":3},{"text":"mot mig.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"De ropar inte till mig av hjärtat","poem":1},{"text":"utan klagar på sina bäddar.","poem":3},{"text":"De oroar sig","poem":2},{"noteId":34},{"text":"för säd och vin","poem":2},{"text":"men vänder sig bort från mig.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Det var jag som lärde dem","poem":1},{"text":"och stärkte","poem":3},{"noteId":35},{"text":"deras armar,","poem":3},{"text":"men de har ont i sinnet mot mig.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"De vänder om,","poem":1},{"text":"men inte till den som är därovan.","poem":2},{"text":"De liknar en båge som sviker.","poem":3},{"text":"Deras furstar ska falla för svärd","poem":2},{"text":"på grund av sina hätska tungor.","poem":3},{"text":"Det ska bli deras vanära","poem":2},{"text":"i Egyptens land.","poem":3}]}],"footnotes":[{"noteId":33,"caller":"-","text":"så som de hört i sin församlingAnnan översättning: ”när man hör dem samlas”.","reference":{"chapter":7,"verse":12}},{"noteId":34,"caller":"-","text":"oroar sigAndra handskrifter: ”samlas” eller ”skär sig” (så Septuaginta). Baalsdyrkare skar sig ibland när de åkallade sin avgud (jfr 1 Kung 18:28).","reference":{"chapter":7,"verse":14}},{"noteId":35,"caller":"-","text":"lärde dem och stärkteAnnan översättning: ”styrkte och stärkte”.","reference":{"chapter":7,"verse":15}}]},"thisChapterLink":"/api/swe_fol/HOS/7.json","thisChapterAudioLinks":{},"nextChapterA