{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Israels falska gudstjänst"]},{"type":"verse","number":1,"content":["Sätt basunen för din mun!",{"text":"Som en örn kommer fienden","poem":2},{"text":"över Herrens hus,","poem":3},{"text":"för de har brutit mitt förbund","poem":2},{"text":"och syndat mot min lag.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"De ropar till mig:","poem":1},{"text":"”Min Gud! Vi i Israel känner dig.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Israel har förkastat det som är gott,","poem":1},{"text":"därför ska fienden förfölja dem.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"De valde kungar","poem":1},{"text":"som inte var från mig,","poem":3},{"text":"de tillsatte furstar","poem":2},{"text":"som jag inte erkände","poem":3},{"noteId":36},{"text":".","poem":3},{"text":"Av sitt silver och guld","poem":2},{"text":"gjorde de sig avgudar","poem":3},{"text":"till sin egen undergång.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Din kalv","poem":1},{"noteId":37},{"text":"är förkastlig, Samaria.","poem":1},{"text":"Min vrede är upptänd mot dem.","poem":3},{"text":"Hur länge ska de vara oförmögna","poem":2},{"text":"till renhet?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Kalven är från Israel,","poem":1},{"text":"en hantverkare har gjort den,","poem":2},{"text":"den är ingen gud.","poem":3},{"text":"Samarias kalv ska krossas","poem":2},{"text":"till smulor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vind sår de,","poem":1},{"text":"och storm ska de skörda.","poem":3},{"text":"Säd ska de inte få,","poem":2},{"text":"deras gröda ska inte ge föda,","poem":3},{"text":"och ger den någon","poem":2},{"text":"ska främlingar sluka den.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Israel blir uppslukad.","poem":1},{"text":"De räknas nu bland hednafolken","poem":2},{"text":"som ett kärl ingen vill ha,","poem":3}]},{"type":"verse","number":9,"content":[{"text":"för de drog bort till Assur","poem":1},{"text":"likt en vildåsna","poem":2},{"text":"som går sin egen väg.","poem":3},{"text":"Efraim har lejt sig älskare.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Men hur de än köpslår bland folken","poem":1},{"text":"ska jag nu samla dem","poem":3},{"text":"och låta dem börja en tid av ringhet,","poem":2},{"text":"förtryckta av furstarnas kung.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Efraim har gjort sig många altaren","poem":1},{"text":"åt synden,","poem":3},{"noteId":38},{"text":"därför ska hans altaren","poem":2},{"text":"bli honom till synd.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Jag har skrivit mycket till honom","poem":1},{"text":"i min undervisning,","poem":3},{"text":"men den betraktas som något","poem":2},{"text":"främmande.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"De offrar kött","poem":1},{"text":"som offergåvor åt mig och äter,","poem":2},{"text":"men Herren tar inte emot dem.","poem":3},{"text":"Nu ska han komma ihåg","poem":2},{"text":"deras skuld","poem":4},{"text":"och straffa dem för deras synder.","poem":3},{"text":"De ska få vända tillbaka till Egypten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Israel har glömt sin skapare","poem":1},{"text":"och byggt tempel,","poem":3},{"text":"och Juda har uppfört","poem":2},{"text":"många befästa städer.","poem":3},{"text":"Jag ska sända en eld","poem":2},{"text":"mot hans städer,","poem":3},{"text":"och den ska förtära deras borgar.","poem":2}]}],"footnotes":[{"noteId":36,"caller":"-","text":"erkändeAnnan översättning: ”kände till”.","reference":{"chapter":8,"verse":4}},{"noteId":37,"caller":"-","text":"Din kalvNordrikets avgudabild i form av en guldkalv (se 1 Kung 12:28f, jfr 2 Mos 32:4f).","reference":{"chapter":8,"verse":5}},{"noteId":38,"caller":"-","text":"altaren åt syndenAnnan översättning: ”altaren för syndoffer”.","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/swe_fol/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}