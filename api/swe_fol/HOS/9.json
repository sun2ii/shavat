{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"HOS","translationId":"swe_fol","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"47ea837ae47ff728c8bec6ebae1758306cc3aa31b523f9cfabb5e176d5ab5ef1","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Straff för Israels synder"]},{"type":"verse","number":1,"content":["Gläd dig inte, Israel,",{"text":"jubla inte som folken,","poem":3},{"text":"för du har varit otrogen","poem":2},{"text":"och kommit bort från din Gud.","poem":3},{"text":"Du har älskat prostitutionens lön","poem":2},{"noteId":39},{"text":"på alla tröskplatser.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Logen och vinpressen","poem":1},{"text":"ska inte föda dem,","poem":3},{"text":"och vinet ska slå fel för dem.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"De ska inte få bo i Herrens land.","poem":1},{"text":"Efraim måste tillbaka till Egypten,","poem":2},{"text":"och i Assyrien ska de äta oren mat.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"De ska inte få offra vin åt Herren,","poem":1},{"text":"och deras slaktoffer","poem":2},{"text":"ska inte glädja honom.","poem":3},{"text":"Det ska vara som sorgebröd","poem":2},{"text":"för dem,","poem":4},{"text":"alla som äter av det ska bli orena,","poem":3},{"text":"för deras bröd","poem":2},{"text":"är bara för dem själva,","poem":3},{"text":"det kommer inte in i Herrens hus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vad ska ni göra på högtidsdagen,","poem":1},{"text":"på Herrens festdag?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"För kommer de undan förödelsen","poem":1},{"text":"samlar Egypten ihop dem","poem":2},{"text":"och Memfis begraver dem.","poem":3},{"text":"Deras silverskatter","poem":2},{"text":"tas över av nässlor,","poem":3},{"text":"törne ska växa i deras hyddor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Straffets dagar kommer,","poem":1},{"text":"vedergällningens dagar kommer,","poem":2},{"text":"Israel ska märka det.","poem":3},{"text":"Profeten anses vara en dåre,","poem":2},{"text":"Andens man galen,","poem":3},{"text":"för att din skuld är stor","poem":2},{"text":"och fiendskapen stark.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Profeten är Guds väktare","poem":1},{"text":"över Efraim,","poem":3},{"text":"men snaror väntar honom","poem":2},{"text":"på alla hans vägar","poem":3},{"text":"och fiendskap i hans Guds hus.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I djupt fördärv har de sjunkit,","poem":1},{"text":"nu som i Gibeas dagar.","poem":3},{"text":"Men han kommer ihåg deras skuld,","poem":2},{"text":"han straffar deras synder.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Som druvor i öknen fann jag Israel,","poem":1},{"text":"som förstlingsfrukter på fikonträdet","poem":2},{"text":"när det börjar bära frukt","poem":3},{"text":"såg jag era fäder.","poem":4},{"text":"Men de gick till Baal-Peor","poem":2},{"noteId":40},{"text":"och invigde sig åt skammens gud,","poem":3},{"text":"och de blev lika vidriga","poem":2},{"text":"som den de älskade.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Efraims härlighet","poem":1},{"text":"ska flyga bort som en fågel:","poem":3},{"text":"ingen ska föda, ingen gå havande,","poem":2},{"text":"ingen befruktas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Och även om de uppfostrar barn","poem":1},{"text":"ska jag ta dem ifrån dem,","poem":2},{"text":"inte en människa blir kvar.","poem":3},{"text":"Ja, ve dem när jag går ifrån dem!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Efraim är som jag såg Tyrus,","poem":1},{"text":"planterad på en äng.","poem":3},{"text":"Men Efraim ska få föra ut sina barn","poem":2},{"text":"till bödeln.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ge dem, Herre,","poem":1},{"text":"vad du ska ge dem!","poem":3},{"text":"Ge dem moderliv med missfall","poem":2},{"text":"och uttorkade bröst.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"All deras ondska finns i Gilgal,","poem":1},{"text":"det var där jag fick hat till dem.","poem":3},{"text":"För deras onda gärningars skull","poem":2},{"text":"ska jag driva ut dem","poem":3},{"text":"ur mitt hus.","poem":4},{"text":"Jag ska inte visa dem kärlek längre,","poem":2},{"text":"alla deras furstar är upproriska.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Efraim är slagen,","poem":1},{"text":"deras rot förtorkad,","poem":2},{"text":"de ska inte bära frukt.","poem":3},{"text":"Även om de föder barn","poem":2},{"text":"ska jag döda deras kära livsfrukt.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Min Gud ska förkasta dem,","poem":1},{"text":"för de har inte lyssnat på honom.","poem":3},{"text":"De ska bli flyktingar","poem":2},{"text":"bland hednafolken.","poem":3}]}],"footnotes":[{"noteId":39,"caller":"-","text":"älskat prostitutionens lönOfferriter till Baal och Astarte i hopp om god skörd.","reference":{"chapter":9,"verse":1}},{"noteId":40,"caller":"-","text":"Baal-PeorEn otuktsrelaterad episod under ökenvandringen (se 4 Mos 25:3f, Jos 22:17).","reference":{"chapter":9,"verse":10}}]},"thisChapterLink":"/api/swe_fol/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}