{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Detta är de syner om Juda och Jerusalem som Jesaja, Amos son",{"noteId":0},", såg när Ussia",{"noteId":1},", Jotam",{"noteId":2},", Ahas",{"noteId":3},"och Hiskia",{"noteId":4},"var kungar i Juda."]},{"type":"heading","content":["Herrens klagan över trolösa Juda"]},{"type":"verse","number":2,"content":[{"text":"Hör, ni himlar!","poem":1},{"text":"Lyssna, du jord,","poem":2},{"text":"för Herren talar!","poem":3},{"text":"Barn har jag fött upp och fostrat,","poem":2},{"text":"men de har gjort uppror mot mig.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"En oxe känner sin ägare,","poem":1},{"text":"en åsna sin herres krubba,","poem":3},{"text":"men Israel känner inget,","poem":2},{"text":"mitt folk förstår ingenting.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ve dig, du syndiga släkte,","poem":1},{"text":"du skuldtyngda folk,","poem":3},{"text":"ni förbrytares avkomma,","poem":2},{"text":"ni fördärvade barn!","poem":3},{"text":"Ni har övergett Herren,","poem":2},{"text":"föraktat Israels Helige","poem":3},{"text":"och vänt honom ryggen.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Var mer ska man slå er,","poem":1},{"text":"eftersom ni fortsätter i trolöshet?","poem":3},{"text":"Hela huvudet är sjukt","poem":2},{"text":"och hela hjärtat svagt.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Från fotsulan upp till huvudet","poem":1},{"text":"finns inget helt,","poem":3},{"text":"bara blåmärken, skråmor","poem":2},{"text":"och öppna sår","poem":3},{"text":"som inte blivit urkramade,","poem":2},{"text":"förbundna eller lindrade","poem":3},{"text":"med olja.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ert land är ödelagt,","poem":1},{"text":"era städer nerbrända i eld.","poem":3},{"text":"Era åkrar förtärs i er åsyn","poem":2},{"text":"av främlingar,","poem":4},{"text":"ödelagda som efter","poem":2},{"text":"främlingars framfart.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Dottern Sion står kvar","poem":1},{"noteId":5},{"text":"som en hydda i en vingård,","poem":2},{"text":"som ett vaktskjul","poem":3},{"noteId":6},{"text":"på ett gurkfält,","poem":3},{"text":"som en belägrad","poem":2},{"noteId":7},{"text":"stad.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hade inte Herren Sebaot lämnat kvar","poem":1},{"text":"en liten rest åt oss,","poem":3},{"text":"då hade vi blivit som Sodom,","poem":2},{"text":"vi hade liknat Gomorra","poem":3},{"noteId":8},{"text":".","poem":3},{"noteId":9}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hör Herrens ord,","poem":1},{"text":"ni Sodomsfurstar,","poem":3},{"text":"lyssna till vår Guds undervisning,","poem":2},{"text":"du Gomorrafolk!","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Vad ska jag med","poem":1},{"text":"era många slaktoffer till?","poem":2},{"text":"säger Herren.","poem":3},{"text":"Jag är mätt på brännofferbaggar","poem":2},{"text":"och gödkalvars fett,","poem":3},{"text":"jag har ingen glädje i blod","poem":2},{"text":"av tjurar, lamm och bockar.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"När ni kommer för att träda fram","poem":1},{"text":"inför mitt ansikte,","poem":3},{"text":"vem har då bett er","poem":2},{"text":"trampa ner mina förgårdar?","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Bär inte fram fler","poem":1},{"text":"meningslösa matoffer!","poem":3},{"text":"Röken av dem","poem":2},{"text":"är avskyvärd för mig.","poem":3},{"text":"Nymånad, sabbat","poem":2},{"text":"och utlysta fester –","poem":3},{"text":"jag tål inte ondska","poem":2},{"text":"och högtid tillsammans.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Min själ hatar era nymånader","poem":1},{"noteId":10},{"text":"och högtider.","poem":3},{"text":"De har blivit en börda för mig,","poem":2},{"text":"jag är trött på att bära den.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"När ni räcker ut era händer","poem":1},{"text":"döljer jag mina ögon för er.","poem":3},{"text":"Även om ni ber mycket","poem":2},{"text":"kommer jag inte att lyssna.","poem":3},{"text":"Era händer är fulla av blod.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tvätta er, gör er rena!","poem":1},{"text":"Ta bort era onda gärningar","poem":2},{"text":"ur min åsyn.","poem":3},{"text":"Sluta att göra det som är ont,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"lär er att göra det som är gott!","poem":1},{"text":"Sök det rätta,","poem":2},{"text":"tillrättavisa förtryckaren","poem":3},{"noteId":11},{"text":",","poem":3},{"text":"försvara den faderlöses rätt,","poem":2},{"text":"stöd änkan i hennes sak.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kom, låt oss gå till rätta","poem":1},{"text":"med varandra, säger Herren.","poem":3},{"text":"Om än era synder är blodröda","poem":2},{"text":"ska de bli snövita,","poem":3},{"text":"om än de är röda som scharlakan","poem":2},{"text":"ska de bli vita som ull.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Om ni är villiga och lyssnar","poem":1},{"text":"ska ni få äta landets goda.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Men om ni vägrar och trotsar","poem":1},{"text":"ska ni förtäras av svärd,","poem":3},{"text":"för Herrens mun har talat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Vilken prostituerad hon har blivit,","poem":1},{"text":"den trogna staden!","poem":3},{"text":"Den var full av rättvisa,","poem":2},{"text":"rättfärdighet bodde därinne –","poem":3},{"text":"men nu mördare.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"Ditt silver har blivit slagg,","poem":1},{"text":"ditt ädla vin är utspätt","poem":2},{"text":"med vatten.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Dina ledare är upprorsmän","poem":1},{"text":"och tjuvars kumpaner.","poem":3},{"text":"Alla älskar de mutor","poem":2},{"text":"och jagar oärlig vinst.","poem":3},{"text":"Den faderlöses rätt försvarar de inte,","poem":2},{"text":"och änkans sak","poem":3},{"text":"kommer inte inför dem.","poem":4}]},{"type":"verse","number":24,"content":[{"text":"Därför säger Herren Gud","poem":1},{"noteId":12},{"text":"Sebaot,","poem":1},{"text":"Israels Mäktige:","poem":3},{"text":"Ve! Jag ska släppa lös","poem":2},{"text":"min vrede över mina motståndare","poem":3},{"text":"och hämnas på mina fiender.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jag ska vända min hand mot dig","poem":1},{"text":"och bränna bort ditt slagg","poem":2},{"text":"som med lut","poem":3},{"text":"och rensa bort alla dina orenheter.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Jag ska åter ge dig sådana domare","poem":1},{"text":"som du hade först","poem":3},{"text":"och sådana rådgivare","poem":2},{"text":"som du hade i början.","poem":3},{"text":"Sedan ska du kallas","poem":2},{"text":"\"rättfärdighetens stad\",","poem":3},{"text":"\"den trogna staden\".","poem":4}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Genom rätt ska Sion bli friköpt,","poem":1},{"text":"genom rättfärdighet","poem":2},{"text":"de som vänder om.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Men brottslingar och syndare","poem":1},{"text":"ska krossas tillsammans,","poem":3},{"text":"de som överger Herren","poem":2},{"text":"ska gå under.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Ja, ni ska få skämmas","poem":1},{"text":"över terebinterna som var er lust,","poem":3},{"text":"blygas över trädgårdarna","poem":2},{"noteId":13},{"text":"som ni har utvalt,","poem":3}]},{"type":"verse","number":30,"content":[{"text":"för ni ska bli som en terebint","poem":1},{"text":"med vissnade löv,","poem":3},{"text":"som en lustgård utan vatten.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Och den starke ska bli som fnöske,","poem":1},{"text":"hans verk som en gnista.","poem":3},{"text":"Båda ska brinna tillsammans","poem":2},{"text":"utan att någon kan släcka.","poem":3}]}],"footnotes":[{"noteId":0,"caller":"-","text":"Amos sonInte profeten Amos från Tekoa, vars namn på hebreiska stavas annorlunda.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"-","text":"UssiaRegerade ca 792-740 f Kr, utvecklade Juda rike men dog som spetälsk (se 2 Krön 26).","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"-","text":"JotamRättfärdig kung som regerade ca 750-732 f Kr (se 2 Krön 27).","reference":{"chapter":1,"verse":1}},{"noteId":3,"caller":"-","text":"AhasUng kung (ca 735-715 f Kr) som underordnade sig Assyrien (kap 7-8, 2 Kung 16, 2 Krön 28).","reference":{"chapter":1,"verse":1}},{"noteId":4,"caller":"-","text":"HiskiaKung och reformator som rensade ut avgudadyrkan och återupprättade tron på Israels Gud (kap 36-39, 2 Kung 18-20, 2 Krön 29-32). Regerade ca 715-686 f Kr.","reference":{"chapter":1,"verse":1}},{"noteId":5,"caller":"-","text":"Sion står kvarÅr 701 f Kr härjade Sanherib hela Juda, men Jerusalem räddades (se kap 36-37).","reference":{"chapter":1,"verse":8}},{"noteId":6,"caller":"-","text":"hydda … vaktskjulHär kunde skördemännen rasta, sova och vakta sin skörd (jfr Rut 2-3).","reference":{"chapter":1,"verse":8}},{"noteId":7,"caller":"-","text":"belägradAnnan översättning: \"beskyddad\".","reference":{"chapter":1,"verse":8}},{"noteId":8,"caller":"-","text":"Sodom … GomorraStäder vid Döda havet som utplånades för sin ondska (1 Mos 14, 19, Hes 16:49f).","reference":{"chapter":1,"verse":9}},{"noteId":9,"caller":"-","text":"Citeras av Paulus i Rom 9:29.","reference":{"chapter":1,"verse":9}},{"noteId":10,"caller":"-","text":"nymånaderVarje ny månad inleddes med en dag för fest, vila och gudstjänst (1 Sam 20:5, Jes 66:23, Hos 2:11, Amos 8:5).","reference":{"chapter":1,"verse":14}},{"noteId":11,"caller":"-","text":"tillrättavisa förtryckarenAnnan översättning: \"hjälp den förtryckte till rätta\".","reference":{"chapter":1,"verse":17}},{"noteId":12,"caller":"-","text":"Herren GudHebr. Adonaí Jhvh(Herren Herren). När Gudsnamnet Jhvh är sammansatt med ordet \"Adonaí\" (Herre) anger grundtextens vokaler att det istället ska uttalas \"Elohím\" (Gud).","reference":{"chapter":1,"verse":24}},{"noteId":13,"caller":"-","text":"terebinterna … trädgårdarnaTräd vördades t ex i fruktbarhetskulten kring Ashera (Dom 6:25f, Jer 17:2, Hes 6:13), som bekämpades av kung Hiskia (1 Kung 18:4).","reference":{"chapter":1,"verse":29}}]},"thisChapterLink":"/api/swe_fol/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}