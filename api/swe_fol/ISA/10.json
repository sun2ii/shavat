{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Ve dem som stiftar",{"text":"orättfärdiga lagar","poem":3},{"text":"och skriver orätta skrivelser","poem":2}]},{"type":"verse","number":2,"content":[{"text":"för att förvrida rättvisan","poem":1},{"text":"för de nödställda","poem":3},{"text":"och beröva de förtryckta","poem":2},{"text":"i mitt folk deras rätt,","poem":3},{"text":"för att göra änkor till sitt byte","poem":2},{"text":"och plundra de faderlösa.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Vad ska ni göra","poem":1},{"text":"på räkenskapsdagen","poem":3},{"text":"när förödelsen kommer","poem":2},{"text":"fjärran ifrån?","poem":3},{"text":"Till vem ska ni fly","poem":2},{"text":"för att få hjälp,","poem":3},{"text":"och var ska ni göra av","poem":2},{"text":"era rikedomar","poem":3},{"noteId":66},{"text":"?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Den som inte faller på knä","poem":1},{"text":"bland fångar","poem":4},{"text":"måste falla bland de dräpta.","poem":3},{"text":"Med allt detta upphör inte","poem":2},{"text":"hans vrede,","poem":4},{"text":"hans hand är ännu uträckt.","poem":3}]},{"type":"heading","content":["Guds dom över Assyrien"]},{"type":"verse","number":5,"content":[{"text":"Ve över Assur, min vredes ris!","poem":1},{"text":"Staven i hans hand är min harm.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jag sände honom","poem":1},{"text":"mot ett gudlöst folk,","poem":2},{"text":"mot ett folk jag är vred på.","poem":3},{"text":"Jag befallde honom","poem":2},{"text":"att plundra och ta byte","poem":3},{"text":"och trampa ner dem","poem":2},{"text":"som smuts på gatorna.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Men så menade inte han,","poem":1},{"text":"i sitt hjärta tänkte han inte så.","poem":3},{"text":"Hans hjärta ville förgöra","poem":2},{"text":"och utrota många folk,","poem":3}]},{"type":"verse","number":8,"content":[{"text":"för han säger:","poem":1},{"text":"\"Är inte alla mina furstar kungar?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Gick det inte Kalno som Karkemish,","poem":1},{"text":"Hamat som Arpad","poem":2},{"text":"och Samaria som Damaskus?","poem":3},{"noteId":67}]},{"type":"verse","number":10,"content":[{"text":"Min hand har drabbat","poem":1},{"text":"andra gudars riken","poem":3},{"text":"som hade fler","poem":2},{"noteId":68},{"text":"gudabilder","poem":2},{"text":"än Jerusalem och Samaria.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Skulle jag då inte göra med Jerusalem","poem":1},{"text":"och dess gudabilder","poem":3},{"noteId":69},{"text":"som jag har gjort med Samaria","poem":2},{"text":"och dess gudar?\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Men när Herren har fullbordat allt sitt verk på Sions berg och i Jerusalem, ska jag ställa Assurs kung till svars för frukten av hans hjärtas övermod och hans stolta ögons högmod."]},{"type":"verse","number":13,"content":["För han säger:",{"lineBreak":true},"\"Detta har jag gjort",{"text":"med min starka hand","poem":3},{"text":"och min vishet,","poem":2},{"text":"för jag är så klok!","poem":3},{"text":"Jag flyttade folkens gränser","poem":2},{"text":"och plundrade deras skatter,","poem":3},{"text":"som den mäktige","poem":2},{"text":"störtade jag härskarna.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Min hand fann folkens skatter","poem":1},{"text":"som i ett fågelbo","poem":3},{"noteId":70},{"text":",","poem":3},{"text":"jag samlade ihop hela jorden","poem":2},{"text":"som man tar övergivna ägg.","poem":3},{"text":"Ingen rörde en vinge,","poem":2},{"text":"öppnade näbben eller pep.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ska yxan höja sig över honom","poem":1},{"text":"som hugger med den,","poem":3},{"text":"eller sågen förhäva sig över honom","poem":2},{"text":"som använder den?","poem":3},{"text":"Som om käppen kunde svinga","poem":2},{"text":"honom som lyfter den,","poem":3},{"text":"eller staven lyfta","poem":2},{"text":"honom som inte är av trä!","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Därför ska Herren Gud Sebaot","poem":1},{"text":"sända en tärande sjukdom","poem":2},{"text":"bland hans feta män,","poem":3},{"text":"och under hans härlighet","poem":2},{"text":"ska det brinna en brand","poem":3},{"text":"som en brinnande eld.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Och Israels ljus","poem":1},{"text":"ska vara som en eld,","poem":2},{"text":"hans Helige som en låga,","poem":3},{"text":"och den ska bränna och förtära","poem":2},{"text":"hans törnen och tistlar,","poem":3},{"text":"allt på samma dag.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Han ska helt göra slut","poem":1},{"text":"på hans härliga skog","poem":2},{"text":"och fruktträdgård.","poem":3},{"text":"Det ska bli som när en sjuk","poem":2},{"text":"tynar bort.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"De träd som blir kvar i skogen","poem":1},{"text":"ska vara lätträknade,","poem":3},{"text":"ett barn kan skriva upp dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"På den dagen ska Israels rest","poem":1},{"text":"och de räddade av Jakobs hus","poem":3},{"text":"inte längre stödja sig","poem":2},{"text":"på honom som slog dem.","poem":3},{"text":"I trohet ska de stödja sig","poem":2},{"text":"på Herren, Israels Helige.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"En rest ska vända om","poem":1},{"noteId":71},{"text":",","poem":1},{"text":"en rest av Jakob,","poem":3},{"text":"till Gud den Mäktige.","poem":2},{"noteId":72}]},{"type":"verse","number":22,"content":[{"text":"För även om ditt folk, Israel,","poem":1},{"text":"vore som havets sand,","poem":3},{"text":"så ska bara en rest av det","poem":2},{"text":"vända om.","poem":3},{"text":"Förödelse är beslutad,","poem":2},{"text":"en rättfärdig störtflod.","poem":3},{"noteId":73}]},{"type":"verse","number":23,"content":[{"text":"Förödelse och beslutad straffdom","poem":1},{"text":"ska Herren Gud Sebaot","poem":2},{"text":"låta drabba hela landet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Därför säger Herren Gud Sebaot så:","poem":1},{"text":"Mitt folk som bor i Sion,","poem":2},{"text":"var inte rädda för Assur.","poem":3},{"text":"Han kommer att slå dig med riset","poem":2},{"text":"och höja sin stav mot dig,","poem":3},{"text":"som i Egypten.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"För ännu en liten tid","poem":1},{"text":"så upphör vreden mot dig,","poem":3},{"text":"och min vrede ska vända sig","poem":2},{"text":"till deras fördärv.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Herren Sebaot ska svänga","poem":1},{"text":"sitt gissel över dem,","poem":3},{"text":"som när han slog Midjan","poem":2},{"text":"vid Orebsklippan.","poem":3},{"noteId":74},{"text":"Han ska åter höja sin stav","poem":2},{"text":"som han räckte ut över havet,","poem":3},{"text":"som i Egypten.","poem":4},{"noteId":75}]},{"type":"verse","number":27,"content":[{"text":"På den dagen ska hans börda","poem":1},{"text":"tas bort från dina axlar","poem":2},{"text":"och hans ok från din nacke,","poem":3},{"text":"för oket ska brista","poem":2},{"text":"på grund av fetman.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Han kommer över Ajat,","poem":1},{"text":"drar fram genom Migron.","poem":3},{"text":"I Mikmas lämnar han sin tross.","poem":2},{"noteId":76}]},{"type":"verse","number":29,"content":[{"text":"De drar fram genom passet,","poem":1},{"text":"tar nattkvarter i Geba.","poem":3},{"text":"Rama bävar, Sauls Gibea flyr.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ropa högt, dotter Gallim!","poem":1},{"text":"Lyssna, Laisha!","poem":2},{"text":"Arma Anatot!","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Madmena flyr,","poem":1},{"text":"Gibeons invånare söker skydd.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Samma dag gör han halt i Nob.","poem":1},{"text":"Han svingar sin hand","poem":2},{"text":"mot dottern Sions berg,","poem":3},{"text":"mot Jerusalems höjd.","poem":4}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Se, Herren Gud Sebaot","poem":1},{"text":"ska hugga av den lummiga kronan","poem":2},{"text":"med våldsam kraft.","poem":3},{"text":"De resliga stammarna ska fällas,","poem":2},{"text":"de höga träden störta ner.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Han ska fälla snårskogen med järn,","poem":1},{"text":"och Libanon ska falla","poem":2},{"text":"för den Mäktige.","poem":3}]}],"footnotes":[{"noteId":66,"caller":"-","text":"era rikedomarOrdagrant: \"er härlighet\".","reference":{"chapter":10,"verse":3}},{"noteId":67,"caller":"-","text":"Kalno etcSyriska städer som erövrats 740-717 f Kr, uppräknade från norr till söder.","reference":{"chapter":10,"verse":9}},{"noteId":68,"caller":"-","text":"flerAnnan översättning: \"bättre\".","reference":{"chapter":10,"verse":10}},{"noteId":69,"caller":"-","text":"Jerusalem … gudabilderAvfälliga israeliters avgudar (se t ex 2 Kung 18:4, 2 Krön 28:24f).","reference":{"chapter":10,"verse":11}},{"noteId":70,"caller":"-","text":"som … ett fågelboJfr beskrivningen av Sanheribs skryt i noten till 2 Kung 19:36.","reference":{"chapter":10,"verse":14}},{"noteId":71,"caller":"-","text":"En rest ska vända omHebr. sheár jashúb, namnet på Jesajas son (7:3).","reference":{"chapter":10,"verse":21}},{"noteId":72,"caller":"-","text":"Gud, den MäktigeHebr. El Gibbór, samma namn som för Messias i 9:6 (\"Mäktig Gud\").","reference":{"chapter":10,"verse":21}},{"noteId":73,"caller":"-","text":"Citeras i Rom 9:27 som profetia om Guds frälsningsplan för Israel.","reference":{"chapter":10,"verse":22}},{"noteId":74,"caller":"-","text":"slog Midjan vid OrebsklippanGuds räddning genom Gideon (Dom 7:22, 25).","reference":{"chapter":10,"verse":26}},{"noteId":75,"caller":"-","text":"stav … över havet, som i EgyptenVid delningen av Röda havet i 2 Mos 14:16f.","reference":{"chapter":10,"verse":26}},{"noteId":76,"caller":"-","text":"Ajat etcOrter från ca 1,5 mil norr om Jerusalem och söderut fram till staden.","reference":{"chapter":10,"verse":28}}]},"thisChapterLink":"/api/swe_fol/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}