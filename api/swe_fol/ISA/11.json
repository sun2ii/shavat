{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["Telningen från Ishais rot"]},{"type":"verse","number":1,"content":["Men ett skott ska skjuta upp",{"text":"ur Ishais avhuggna stam,","poem":3},{"noteId":77},{"text":"en telning från hans rötter","poem":2},{"text":"ska bära frukt.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Över honom","poem":1},{"text":"ska Herrens Ande vila,","poem":3},{"text":"Anden med vishet och förstånd,","poem":2},{"text":"Anden med råd och styrka,","poem":3},{"text":"Anden med kunskap","poem":2},{"text":"och vördnad för Herren.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Han ska ha sin glädje","poem":1},{"text":"i vördnad för Herren.","poem":3},{"text":"Han ska inte döma","poem":2},{"text":"efter vad ögonen ser","poem":3},{"text":"eller avgöra","poem":2},{"noteId":78},{"text":"efter vad öronen hör,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"utan han ska döma de fattiga","poem":1},{"text":"med rättfärdighet","poem":3},{"text":"och med rättvisa","poem":2},{"text":"skaffa rätt åt de ödmjuka","poem":3},{"text":"på jorden.","poem":4},{"text":"Han ska slå jorden","poem":2},{"text":"med sin muns stav,","poem":3},{"text":"döda de ogudaktiga","poem":2},{"text":"med sina läppars ande.","poem":3},{"noteId":79}]},{"type":"verse","number":5,"content":[{"text":"Rättfärdighet ska vara bältet","poem":1},{"text":"runt hans midja,","poem":3},{"text":"trofasthet bältet om hans höfter.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vargar ska bo tillsammans med lamm,","poem":1},{"text":"leoparder ligga bland killingar.","poem":3},{"text":"Kalvar och unga lejon","poem":2},{"text":"och gödboskap","poem":4},{"text":"ska vara","poem":3},{"noteId":80},{"text":"tillsammans,","poem":3},{"text":"och en liten pojke ska valla dem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kor och björnar ska gå och beta,","poem":1},{"text":"deras ungar","poem":2},{"text":"ska ligga tillsammans,","poem":3},{"text":"och lejon ska äta halm som oxar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ett spädbarn ska leka","poem":1},{"text":"vid huggormens håla,","poem":3},{"text":"ett avvant barn räcka ut handen","poem":2},{"text":"mot giftormens öga.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ingenstans på mitt heliga berg","poem":1},{"text":"ska man göra något ont","poem":2},{"text":"eller förstöra något,","poem":3},{"text":"för landet ska vara fullt","poem":2},{"text":"av Herrens kunskap,","poem":3},{"text":"liksom vattnet täcker havet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Det ska ske på den dagen att hednafolken ska söka Ishais rot där han står som ett baner för folken, och hans boning ska vara härlig.",{"noteId":81}]},{"type":"verse","number":11,"content":["På den dagen ska Herren för andra gången räcka ut handen för att friköpa en rest av sitt folk som är kvar från Assyrien, Egypten, Patros, Nubien, Elam, Shinar, Hamat och havsländerna.",{"noteId":82}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Han ska resa ett baner","poem":1},{"text":"för hednafolken","poem":3},{"text":"och samla de fördrivna","poem":2},{"text":"av Israel","poem":3},{"text":"och de kringspridda av Juda","poem":2},{"text":"från jordens fyra hörn.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Då ska Efraims avund","poem":1},{"noteId":83},{"text":"upphöra","poem":1},{"text":"och Juda fiender utrotas.","poem":3},{"text":"Efraim ska inte avundas Juda,","poem":2},{"text":"och Juda inte vara","poem":3},{"text":"fiende till Efraim.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Och de ska slå ner","poem":1},{"text":"på filisteernas skuldra i väster,","poem":3},{"text":"tillsammans ta byte","poem":2},{"text":"från folken i öster.","poem":3},{"text":"De ska räcka ut sin hand","poem":2},{"text":"över Edom och Moab,","poem":3},{"text":"och ammoniterna ska lyda dem.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Och Herren ska torka ut","poem":1},{"text":"Egyptens havsvik","poem":3},{"text":"och lyfta sin hand mot floden","poem":2},{"text":"med en brännande vind.","poem":3},{"text":"Han ska klyva den i sju bäckar","poem":2},{"text":"så att man kan gå torrskodd över.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Det ska bli en banad väg","poem":1},{"text":"för den rest av hans folk","poem":2},{"text":"som är kvar från Assyrien,","poem":3},{"text":"så som det var för Israel","poem":2},{"text":"den dag de drog upp","poem":3},{"text":"ur Egyptens land.","poem":4}]}],"footnotes":[{"noteId":77,"caller":"-","text":"skott ... ur Ishais avhuggna stamProfetia om Messias, ättlingen till Davids kungatron (jfr Jer 23:5, Sak 6:12, Luk 1:32, Upp 22:16)","reference":{"chapter":11,"verse":1}},{"noteId":78,"caller":"-","text":"avgöraAnnan översättning: \"tillrättavisa\" eller \"straffa\".","reference":{"chapter":11,"verse":3}},{"noteId":79,"caller":"-","text":"Citeras av Paulus i 2 Tess 2:8 som profetia om hur Messias ska döda Antikrist.","reference":{"chapter":11,"verse":4}},{"noteId":80,"caller":"-","text":"lejon och gödboskap ska varaAndra handskrifter (Septuaginta): \"lejon ska beta\".","reference":{"chapter":11,"verse":6}},{"noteId":81,"caller":"-","text":"Citeras av Paulus i Rom 15:12 som profetia om Messiastrons spridning bland hedningarna.","reference":{"chapter":11,"verse":10}},{"noteId":82,"caller":"-","text":"Assyrien etcOmrådena motsvarar norra Irak, Egypten, södra Egypten, Sudan, västra Iran, Irak, västra Syrien och Medelhavet.","reference":{"chapter":11,"verse":11}},{"noteId":83,"caller":"-","text":"Efraims avundDe norra stammarnas fientlighet mot Juda och Jerusalem (jfr kap 7).","reference":{"chapter":11,"verse":13}}]},"thisChapterLink":"/api/swe_fol/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}