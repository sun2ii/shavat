 namn","poem":2},{"text":"är upphöjt.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Lovsjung Herren,","poem":1},{"text":"för han har gjort härliga ting.","poem":3},{"text":"Låt det bli känt över hela jorden.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ropa av fröjd och jubla,","poem":1},{"text":"ni Sions invånare,","poem":3},{"text":"för Israels Helige är stor,","poem":2},{"text":"han är mitt ibland er.\"","poem":3}]}],"footnotes":[{"noteId":84,"caller":"-","text":"Herren HerrenHebr. Jah Jhvh (jfr hallelú Jah, \"prisa Herren\", Ps 104:35). Även i 26:4, 38:11.","reference":{"chapter":12,"verse":2}}]},"thisChapterLink":"/api/swe_fol/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}