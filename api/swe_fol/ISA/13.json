{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["Profetia om Babel"]},{"type":"verse","number":1,"content":["Profetia om Babel",{"noteId":85},", som Jesaja, Amos son, såg i en syn:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Res ett baner på ett kalt berg,","poem":1},{"text":"ropa högt till dem,","poem":3},{"text":"vinka med handen","poem":2},{"text":"att de ska dra in","poem":3},{"text":"genom de mäktigas portar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jag har befallt mina heliga","poem":1},{"text":"och kallat mina krigare","poem":2},{"text":"till mitt vredesverk,","poem":3},{"text":"min stolta, jublande skara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hör, det dånar på bergen","poem":1},{"text":"som av ett stort folk!","poem":3},{"text":"Hör, det sorlar av riken,","poem":2},{"text":"av samlade hednafolk!","poem":3},{"text":"Herren Sebaot mönstrar","poem":2},{"text":"sin krigshär.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"De kommer från fjärran land,","poem":1},{"text":"från himlens ände,","poem":3},{"text":"Herren och hans vredes redskap,","poem":2},{"text":"för att fördärva hela landet.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jämra er, för Herrens dag är nära.","poem":1},{"text":"Den kommer som förödelse","poem":2},{"text":"från den Allsmäktige.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Därför sjunker alla händer,","poem":1},{"text":"och alla människors hjärtan","poem":2},{"text":"tappar modet.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De grips av skräck,","poem":1},{"text":"av plågor och smärtor,","poem":2},{"text":"av vånda som en födande kvinna.","poem":3},{"text":"Häpen stirrar den ene på den andre,","poem":2},{"text":"deras ansikten blossar","poem":3},{"text":"som lågor av eld.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Se, Herrens dag kommer,","poem":1},{"text":"fruktansvärd med harm","poem":2},{"text":"och brinnande vrede,","poem":3},{"text":"för att ödelägga landet","poem":2},{"text":"och utrota syndarna som bor där.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"För himlens stjärnor och stjärnbilder","poem":1},{"text":"ger inte längre sitt ljus.","poem":3},{"text":"Solen går upp mörk","poem":2},{"text":"och månen ger inte sitt sken.","poem":3},{"noteId":86}]},{"type":"verse","number":11,"content":[{"text":"Jag ska straffa","poem":1},{"text":"världen för dess ondska,","poem":2},{"text":"de gudlösa för deras skuld.","poem":3},{"text":"Jag ska göra slut","poem":2},{"text":"på de stoltas övermod","poem":3},{"text":"och slå ner tyrannernas högmod.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jag ska göra människor","poem":1},{"text":"mer sällsynta än fint guld,","poem":3},{"text":"män mer sällsynta","poem":2},{"text":"än guld från Ofir.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Därför ska jag få himlen att darra","poem":1},{"text":"och jorden att gunga och skaka","poem":2},{"text":"i sina grundvalar –","poem":3},{"text":"genom Herren Sebaots harm,","poem":2},{"text":"på hans brinnande vredes dag.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Som bortjagade gaseller","poem":1},{"text":"och får som ingen samlar","poem":3},{"text":"ska de alla vända hem och fly,","poem":2},{"text":"var och en till sitt folk och land.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Var och en som påträffas","poem":1},{"text":"ska bli genomborrad,","poem":3},{"text":"var och en som grips","poem":2},{"text":"ska falla för svärd.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Deras spädbarn ska krossas","poem":1},{"text":"inför deras ögon,","poem":3},{"text":"deras hus ska plundras","poem":2},{"text":"och deras kvinnor våldtas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Se, jag ska egga upp mederna","poem":1},{"noteId":87},{"text":"mot dem,","poem":3},{"text":"de som inte bryr sig om silver","poem":2},{"text":"och inte frågar efter guld.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Deras bågar fäller unga män,","poem":1},{"text":"de har inget förbarmande","poem":2},{"text":"med fostret i moderlivet,","poem":3},{"text":"deras ögon har inget medlidande","poem":2},{"text":"med barn.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Med Babel, rikenas krona,","poem":1},{"text":"kaldeernas vackra stolthet,","poem":3},{"text":"ska det gå som när Gud","poem":2},{"text":"ödelade Sodom och Gomorra.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Aldrig mer ska det bli bebyggt,","poem":1},{"text":"från släkte till släkte","poem":2},{"text":"ska det ligga obebott.","poem":3},{"text":"Ingen arab ska där slå upp sitt tält,","poem":2},{"text":"ingen herde slå läger","poem":3},{"text":"med sin hjord.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"Där ska öknens djur lägga sig ner,","poem":1},{"text":"dess hus ska fyllas av ugglor.","poem":3},{"text":"Där ska strutsar bo,","poem":2},{"text":"där ska getabockar","poem":3},{"text":"hoppa omkring.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"Schakaler ska tjuta i dess slott","poem":1},{"text":"och ökenhundar","poem":2},{"text":"i de praktfulla palatsen.","poem":3},{"text":"Dess tid kommer snart,","poem":2},{"text":"dess dagar ska inte fördröjas.","poem":3}]}],"footnotes":[{"noteId":85,"caller":"-","text":"BabelUnder 700-talet en lydstat under Assyrien. Efter flera uppror, särskilt efter 705 f Kr då Merodak-Baladan samordnade sitt uppror med Hiskia (2 Kung 20:12), ödelade Sanherib staden 689 f Kr. Den återuppbyggdes tio år senare av Esarhaddon (37:38), föll sedan 539 f Kr och övergavs helt först efter nytestamentlig tid (vers 20).","reference":{"chapter":13,"verse":1}},{"noteId":86,"caller":"-","text":"Citeras av Jesus i Matt 24:29 och Mark 13:24 som profetia om den sista tiden.","reference":{"chapter":13,"verse":10}},{"noteId":87,"caller":"-","text":"medernaKrigarfolk i västra Iran som deltog i Koreshs anfall mot Babel 539 f Kr (Dan 5:28).","reference":{"chapter":13,"verse":17}}]},"thisChapterLink":"/api/swe_fol/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}