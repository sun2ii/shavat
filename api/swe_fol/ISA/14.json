{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"heading","content":["Sång över Babels kungs fall"]},{"type":"verse","number":1,"content":["Herren ska förbarma sig över Jakob och än en gång utvälja Israel och låta dem få ro i deras eget land. Främlingar ska ansluta sig till dem och hålla sig till Jakobs hus."]},{"type":"verse","number":2,"content":["Folken ska ta dem och föra dem hem, och Israels hus ska få dem som sin egendom i Herrens land som tjänare och tjänarinnor. Så ska deras fångvaktare bli deras fångar, och de ska råda över sina förtryckare."]},{"type":"verse","number":3,"content":["På den dag då Herren ger dig ro från din smärta och oro och från det hårda arbete som du tvingats göra,"]},{"type":"verse","number":4,"content":["ska du ta upp denna sång över Babels kung och säga:",{"lineBreak":true},{"text":"\"Vilket slut förtryckaren har fått!","poem":1},{"text":"Indrivningen av guld","poem":3},{"noteId":88},{"text":"är över.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Herren bröt sönder de gudlösas stav,","poem":1},{"text":"härskarnas spira","poem":3}]},{"type":"verse","number":6,"content":[{"text":"som i grymhet slog folken","poem":1},{"text":"med slag på slag","poem":3},{"text":"och i vrede härskade över folkslagen","poem":2},{"text":"med skoningslös förföljelse.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Hela jorden har fått vila och ro,","poem":1},{"text":"man brister ut i jubel.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Även cypresserna gläds över ditt fall,","poem":1},{"text":"likaså Libanons cedrar","poem":3},{"noteId":89},{"text":":","poem":3},{"text":"’Nu när du ligger där","poem":2},{"text":"kommer ingen och hugger","poem":3},{"text":"ner oss.’","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dödsriket därnere","poem":1},{"text":"kommer i rörelse för din skull,","poem":3},{"text":"för att ta emot dig","poem":2},{"text":"när du kommer.","poem":3},{"text":"Det väcker de avlidnas andar","poem":2},{"text":"för din skull,","poem":4},{"text":"jordens alla härskare,","poem":3},{"text":"och låter hednafolkens alla kungar","poem":2},{"text":"resa sig från sina troner.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Alla börjar de tala","poem":1},{"text":"och säger till dig:","poem":3},{"text":"’Du har också blivit maktlös som vi,","poem":2},{"text":"du har blivit som en av oss.’","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Din prakt for ner till dödsriket,","poem":1},{"text":"med dina harpors buller.","poem":3},{"text":"Förruttnelse är bädden under dig","poem":2},{"text":"och maskar ditt täcke.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hur har du inte fallit från himlen,","poem":1},{"text":"du strålande stjärna,","poem":2},{"text":"du gryningens son!","poem":3},{"text":"Hur har du inte blivit fälld","poem":2},{"text":"till jorden,","poem":3},{"text":"du som slog ner folken till marken!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Du sade i ditt hjärta:","poem":1},{"text":"’Jag ska stiga upp till himlen,","poem":2},{"text":"jag ska resa min tron","poem":3},{"text":"ovanför Guds stjärnor","poem":4},{"noteId":90},{"text":".","poem":4},{"text":"Jag ska sätta mig på mötesberget","poem":2},{"text":"längst upp i norr.","poem":3},{"noteId":91}]},{"type":"verse","number":14,"content":[{"text":"Jag ska stiga upp","poem":1},{"text":"över molnens höjder,","poem":3},{"text":"jag ska bli som den Högste.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Men ner till dödsriket störtades du,","poem":1},{"text":"längst ner i graven.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"De som ser dig stirrar på dig,","poem":1},{"text":"de granskar dig och säger:","poem":3},{"text":"’Är detta den man","poem":2},{"text":"som fick jorden att darra","poem":3},{"text":"och riken att skaka,","poem":4}]},{"type":"verse","number":17,"content":[{"text":"som gjorde jorden till en öken","poem":1},{"text":"och förstörde dess städer,","poem":3},{"text":"och som aldrig släppte hem","poem":2},{"text":"sina fångar?’","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Folkens alla kungar","poem":1},{"text":"ligger alla med ära,","poem":3},{"text":"var och en i sitt vilorum,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"men du är utkastad ur din grav","poem":1},{"text":"som en föraktad gren,","poem":3},{"text":"täckt av dräpta män","poem":2},{"text":"som genomborrats av svärd","poem":3},{"text":"och förts ner till gropens stenar.","poem":4},{"text":"Du är som ett förtrampat as.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Du ska inte få vila i en grav som de,","poem":1},{"text":"för du fördärvade ditt eget land","poem":2},{"text":"och dräpte ditt eget folk.\"","poem":3},{"lineBreak":true},{"text":"Förbrytarnas avkomma","poem":1},{"text":"ska man aldrig mer nämna.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ordna ett blodbad på hans söner","poem":1},{"text":"för deras fäders missgärning.","poem":3},{"text":"De får inte resa sig","poem":2},{"text":"och ta över landet","poem":3},{"text":"och fylla jordens yta med städer.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Jag ska resa mig mot dem,","poem":1},{"text":"säger Herren Sebaot,","poem":3},{"text":"och utrota ur Babel","poem":2},{"text":"både namn och överlevande,","poem":3},{"text":"både barn och ättlingar,","poem":4},{"text":"säger Herren.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jag ska göra det","poem":1},{"text":"till ett tillhåll för hägrar","poem":2},{"text":"och fylla det med sumpsjöar,","poem":3},{"text":"jag ska sopa bort det","poem":2},{"text":"med ödeläggelsens kvast,","poem":3},{"text":"säger Herren Sebaot.","poem":2}]},{"type":"heading","content":["Assyrien ska krossas"]},{"type":"verse","number":24,"content":[{"text":"Herren Sebaot har svurit och sagt:","poem":1},{"text":"Sannerligen, som jag har tänkt,","poem":2},{"text":"så ska det ske,","poem":3},{"text":"det jag beslutat ska bli verklighet.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jag ska krossa Assur i mitt land","poem":1},{"noteId":92},{"text":",","poem":1},{"text":"trampa ner honom på mina berg.","poem":3},{"text":"Då ska hans ok lyftas av dem,","poem":2},{"text":"hans börda lyftas från deras axlar.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Detta är det beslut","poem":1},{"text":"som är fattat om hela jorden,","poem":3},{"text":"detta är den hand","poem":2},{"text":"som är uträckt över alla folk.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"När Herren Sebaot har beslutat det,","poem":1},{"text":"vem kan då göra det om intet?","poem":3},{"text":"Hans hand är uträckt,","poem":2},{"text":"vem kan då hindra den?","poem":3}]},{"type":"heading","content":["Profetia om Filisteen"]},{"type":"verse","number":28,"content":["Året då kung Ahas dog",{"noteId":93},"kom denna profetia:"]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Gläd er inte, alla ni filisteer,","poem":1},{"text":"över att staven som slog er","poem":2},{"noteId":94},{"text":"är bruten.","poem":3},{"text":"För från ormens rot","poem":2},{"text":"ska det komma en huggorm,","poem":3},{"text":"och dess avkomma","poem":2},{"text":"blir en vajande giftorm","poem":3},{"noteId":95},{"text":".","poem":3}]},{"type":"verse","number":30,"content":[{"text":"De utblottades förstfödda","poem":1},{"text":"ska finna bete,","poem":2},{"text":"de fattiga ska vila i trygghet.","poem":3},{"text":"Men din rot ska jag döda","poem":2},{"text":"genom svält,","poem":3},{"text":"de som blir kvar av dig ska dräpas.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Jämra dig, du port!","poem":1},{"text":"Ropa, du stad!","poem":3},{"text":"Alla i filisteernas land","poem":2},{"text":"smälter bort av ångest,","poem":3},{"text":"för ett rökmoln kommer norrifrån","poem":2},{"noteId":96},{"text":"och ingen blir efter","poem":3},{"text":"i fiendernas led.","poem":4}]},{"type":"verse","number":32,"content":[{"text":"Vad ska man svara","poem":1},{"text":"det främmande folkets","poem":2},{"text":"sändebud?","poem":3},{"text":"Att Herren har grundat Sion,","poem":2},{"text":"och där har de betryckta","poem":3},{"text":"i hans folk sin tillflykt.","poem":4}]}],"footnotes":[{"noteId":88,"caller":"-","text":"indrivningen av guldAndra handskrifter: \"hans framfart\".","reference":{"chapter":14,"verse":4}},{"noteId":89,"caller":"-","text":"cedrarBåde Assurs och Babels kungar tog av Libanons cedrar till sina palats (37:24, Hab 2:17).","reference":{"chapter":14,"verse":8}},{"noteId":90,"caller":"-","text":"Guds stjärnorSymboliserar ofta änglar (Job 38:7, Upp 1:20, 8:12f).","reference":{"chapter":14,"verse":13}},{"noteId":91,"caller":"-","text":"mötesberget längst upp i norrBerget Safon nordost om Ugarit i Syrien ansågs bland många hednafolk vara en mötesplats för gudarna (jfr Ps 48:3 med not).","reference":{"chapter":14,"verse":13}},{"noteId":92,"caller":"-","text":"krossa Assur i mitt landTroligen vid räddningen av Jerusalem 701 f Kr (37:36f).","reference":{"chapter":14,"verse":25}},{"noteId":93,"caller":"-","text":"Året då kung Ahas dogTroligen 715 f Kr (2 Kung 16:2 med not).","reference":{"chapter":14,"verse":28}},{"noteId":94,"caller":"-","text":"staven som slog erFilisteerna på Gazaremsan hade kuvats av Ahas farfar Ussia (2 Krön 26:6), men sedan anfallit Juda under Ahas tid (2 Krön 28:18). Kan också syfta på Tiglat-Pileser III.","reference":{"chapter":14,"verse":29}},{"noteId":95,"caller":"-","text":"vajande giftormKanske kobran som är \"bevingad\". Annan översättning: \"flygande seraf\" (jfr 6:6).","reference":{"chapter":14,"verse":29}},{"noteId":96,"caller":"-","text":"ett rökmoln kommer norrifrånAssyrierna härjade filisteernas land ca år 720, 712 och 701 f Kr. De utplånades som folk av Nebukadnessar år 588 f Kr (se not till Jer 47:1).","reference":{"chapter":14,"verse":31}}]},"thisChapterLink":"/api/swe_fol/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}