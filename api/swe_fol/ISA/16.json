{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"heading","content":["Fortsättning av profetian om Moab"]},{"type":"verse","number":1,"content":["Sänd lamm",{"noteId":101},"till landets herre",{"text":"från Sela genom öknen","poem":2},{"text":"till dottern Sions berg.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Som flyende fåglar utkastade","poem":1},{"text":"ur fågelboet","poem":3},{"text":"kommer Moabs döttrar","poem":2},{"text":"till Arnons vadställen.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"\"Ge oss råd, döm oss rättvist.","poem":1},{"text":"Låt din skugga vara som natten","poem":2},{"text":"nu mitt på dagen.","poem":3},{"text":"Göm de fördrivna,","poem":2},{"text":"röj inte flyktingarna!","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Låt Moabs fördrivna bo hos dig,","poem":1},{"text":"var","poem":2},{"noteId":102},{"text":"ett gömställe för dem","poem":2},{"text":"undan fördärvaren.","poem":3},{"text":"När utpressaren inte finns mer,","poem":2},{"text":"skövlingen är slut","poem":3},{"text":"och förtryckaren försvunnen","poem":2},{"text":"ur landet,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"då ska en tron befästas","poem":1},{"text":"genom nåd.","poem":3},{"text":"I trohet ska en furste sitta","poem":2},{"text":"på den i Davids hydda,","poem":3},{"text":"en som söker det rätta","poem":2},{"text":"och främjar rättfärdighet.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vi har hört om Moabs stolthet,","poem":1},{"text":"hur stolt han är,","poem":3},{"text":"om hans högfärd, högmod","poem":2},{"text":"och våldsamma vrede,","poem":3},{"text":"och hans tomma skryt.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Därför ska Moab jämra sig över Moab.","poem":1},{"text":"Alla ska jämra sig.","poem":2},{"text":"Över Kir-Haresets russinkakor","poem":3},{"text":"ska ni sucka i djup bedrövelse,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"för Heshbons fält tynar bort,","poem":1},{"text":"liksom Sibmas vinstockar.","poem":3},{"text":"Deras ädla druvor slogs till marken","poem":2},{"text":"av folkens herrar.","poem":3},{"text":"Deras rankor nådde","poem":2},{"text":"ända till Jaeser","poem":4},{"text":"och bredde ut sig i öknen,","poem":3},{"text":"deras grenar sträckte sig ut","poem":2},{"text":"över havet.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Därför gråter jag","poem":1},{"text":"över Sibmas vinstockar,","poem":2},{"text":"så som Jaeser gråter.","poem":3},{"text":"Med mina tårar tänker jag","poem":2},{"text":"dränka dig, Heshbon,","poem":3},{"text":"och dig, Eleale.","poem":4},{"text":"Glädjeropen över din mogna frukt","poem":2},{"text":"och din kornskörd har upphört.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Glädje och fröjd har försvunnit","poem":1},{"text":"från de bördiga fälten","poem":3},{"text":"och i vingårdarna hörs ingen sång,","poem":2},{"text":"inget jubel.","poem":3},{"text":"Ingen trampar vin i pressarna,","poem":2},{"text":"på glädjeropen har jag gjort slut.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Därför klagar mitt inre","poem":1},{"text":"som en harpa över Moab,","poem":3},{"text":"mitt innersta över Kir-Heres.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"För hur Moab än träder upp","poem":1},{"text":"på offerhöjden","poem":2},{"text":"och arbetar sig trött där,","poem":3},{"text":"hur han än går","poem":2},{"text":"till sin helgedom och ber,","poem":3},{"text":"så uträttar han ingenting med det.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Detta är det ord som Herren på den tiden talade om Moab."]},{"type":"verse","number":14,"content":["Men nu har Herren åter talat och sagt: Inom tre år, så som daglönaren räknar åren, ska Moab i sin härlighet förnedras med alla sina stora skaror. Och det lilla som blir kvar ska vara obetydligt och maktlöst."]}],"footnotes":[{"noteId":101,"caller":"-","text":"Sänd lammMoab hade bra bete (4 Mos 32:1) och hade sänt tribut i lamm förut (2 Kung 3:4).","reference":{"chapter":16,"verse":1}},{"noteId":102,"caller":"-","text":"Låt Moabs fördrivna bo hos dig, varAndra handskrifter: \"Låt mina fördrivna bo hos dig, var för Moab\".","reference":{"chapter":16,"verse":4}}]},"thisChapterLink":"/api/swe_fol/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}