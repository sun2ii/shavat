":2}]},{"type":"verse","number":4,"content":[{"text":"För så har Herren sagt till mig:","poem":1},{"text":"\"Stilla ska jag se ner","poem":2},{"text":"från min boning,","poem":3},{"text":"som glödande sol","poem":2},{"text":"från klar himmel,","poem":3},{"text":"som dagg från moln","poem":2},{"text":"under skördetidens hetta.\"","poem":3}]},{"type":"verse","number":5,"content":[{"text":"För innan skördetiden är inne,","poem":1},{"text":"när blomningen är över","poem":2},{"text":"och blomman blir","poem":3},{"text":"en mognande druva,","poem":4},{"text":"ska han skära av","poem":2},{"noteId":107},{"text":"rankorna","poem":2},{"text":"med vingårdskniv","poem":3},{"text":"och hugga bort grenarna.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Allt ska lämnas","poem":1},{"text":"åt rovfåglarna i bergen","poem":2},{"text":"och markens djur.","poem":3},{"text":"På dem ska rovfåglarna","poem":2},{"text":"tillbringa sommaren,","poem":3},{"text":"på dem ska markens alla djur","poem":2},{"text":"övervintra.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"På den tiden ska gåvor bäras fram","poem":1},{"text":"till Herren Sebaot","poem":3},{"text":"från det resliga folket","poem":2},{"noteId":108},{"text":"med glänsande hy,","poem":3},{"text":"från det folk som är fruktat","poem":2},{"text":"vida omkring,","poem":3},{"text":"det starka och segerrika folket","poem":2},{"text":"i landet som delas av floder,","poem":3},{"text":"till platsen för Herren Sebaots namn,","poem":2},{"text":"Sions berg.","poem":3}]}],"footnotes":[{"noteId":105,"caller":"-","text":"sänt budbärareNubien tog vid denna tid över Egypten (19:2) och knöt kontakter både med Jerusalem och med stormakten Assyrien. Kung Sargons (722-705 f Kr) krönikor nämner nubiska budbärare och att man utlämnade Ashdods furste till honom (se 20:1 med not).","reference":{"chapter":18,"verse":2}},{"noteId":106,"caller":"-","text":"resliga folket med glänsande hyÄven Herodotos noterar de