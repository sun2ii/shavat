{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["Egyptens förnedring och upprättelse"]},{"type":"verse","number":1,"content":["Profetia om Egypten.",{"lineBreak":true},{"text":"Se, Herren far fram på en snabb sky","poem":1},{"text":"och kommer till Egypten.","poem":3},{"text":"Egyptens avgudar bävar","poem":2},{"text":"inför honom,","poem":3},{"text":"och egyptiernas hjärtan smälter","poem":2},{"text":"i deras bröst.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Jag ska egga egyptier mot egyptier","poem":1},{"noteId":109},{"text":",","poem":1},{"text":"broder ska strida mot broder","poem":2},{"text":"och vän mot vän,","poem":3},{"text":"stad mot stad och rike mot rike.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Egyptiernas mod ska försvinna,","poem":1},{"text":"jag ska göra deras planer om intet.","poem":3},{"text":"De ska fråga","poem":2},{"text":"sina avgudar och trollkarlar,","poem":3},{"text":"andebesvärjare och spåmän.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Jag ska överlämna egyptierna","poem":1},{"text":"i en hård herres hand,","poem":3},{"text":"en grym kung ska råda över dem,","poem":2},{"text":"säger Herren Gud Sebaot.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vattnet i havet ska torka ut,","poem":1},{"text":"floden sina och ebba ut.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Strömmarna ska stinka,","poem":1},{"text":"Egyptens kanaler","poem":2},{"text":"krympa och torka ut,","poem":3},{"text":"rör och vass vissna bort.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ängarna","poem":1},{"noteId":110},{"text":"vid Nilen längs flodstranden","poem":1},{"text":"och alla sädesfält vid floden","poem":3},{"text":"ska torka ut,","poem":2},{"text":"fördärvas och försvinna.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Nilens fiskare ska klaga,","poem":1},{"text":"alla som kastar ut krok i floden","poem":2},{"text":"ska sörja,","poem":3},{"text":"de som lägger ut nät i vattnet","poem":2},{"text":"ska bli modlösa.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"De som arbetar med lin","poem":1},{"noteId":111},{"text":"och de som väver fina tyger","poem":2},{"text":"ska komma på skam.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Landets stöttepelare","poem":1},{"noteId":112},{"text":"ska krossas","poem":1},{"text":"och alla lönearbetare gripas","poem":2},{"text":"av ångest.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Soans","poem":1},{"noteId":113},{"text":"alla furstar står som dårar,","poem":1},{"text":"faraos visaste rådgivare","poem":2},{"text":"ger oförnuftiga råd.","poem":3},{"text":"Hur kan ni säga till farao:","poem":2},{"text":"\"Jag är son till visa män,","poem":3},{"text":"son till forntida kungar\"?","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Var finns nu dina visa män?","poem":1},{"text":"De kan få berätta för dig,","poem":2},{"text":"de vet ju","poem":3},{"noteId":114},{"text":"det,","poem":3},{"text":"vad Herren Sebaot har beslutat","poem":2},{"text":"om Egypten.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Soans furstar har blivit dårar,","poem":1},{"text":"Memfis","poem":3},{"noteId":115},{"text":"furstar är bedragna,","poem":3},{"text":"de som var hörnstenar","poem":2},{"text":"i Egyptens stammar","poem":3},{"text":"har vilselett det.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Herren har utgjutit","poem":1},{"text":"en förvirringens ande","poem":2},{"text":"bland dem","poem":3},{"text":"så att de vilseleder Egypten","poem":2},{"text":"i allt det gör,","poem":3},{"text":"likt en berusad","poem":2},{"text":"som raglar i sina spyor.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Egypten kan inget uträtta,","poem":1},{"text":"varken huvud eller svans,","poem":2},{"text":"palmtopp eller sävstrå.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"På den dagen ska egyptierna","poem":1},{"text":"vara som kvinnor.","poem":3},{"text":"De ska darra och vara rädda","poem":2},{"text":"för Herren Sebaots lyfta hand","poem":3},{"text":"när han lyfter den mot dem.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Och Juda land ska bli en skräck","poem":1},{"text":"för egyptierna.","poem":3},{"text":"Så ofta någon nämner det för dem","poem":2},{"text":"ska de bli rädda,","poem":3},{"text":"på grund av det beslut som","poem":2},{"text":"Herren Sebaot har fattat mot dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":["På den dagen ska det finnas fem städer",{"noteId":116},"i Egyptens land som talar Kanaans språk och svär vid Herren Sebaot. En av dem ska heta Ir-Haheres",{"noteId":117},"."]},{"type":"verse","number":19,"content":["På den tiden ska ett altare vara rest åt Herren mitt i Egyptens land och en stod åt Herren vid landets gräns."]},{"type":"verse","number":20,"content":["De ska vara till tecken och vittnesbörd om Herren Sebaot i Egyptens land. För när de ropar till Herren på grund av förtryckarna ska han sända dem en frälsare och förkämpe som",{"noteId":118},"ska befria dem."]},{"type":"verse","number":21,"content":["Herren ska göra sig känd för egyptierna, och egyptierna ska på den tiden lära känna Herren. De ska tjäna honom med slaktoffer och matoffer och ge löften åt Herren och uppfylla dem."]},{"type":"verse","number":22,"content":["Så ska Herren slå Egypten, slå men också hela. När de omvänder sig till Herren ska han bönhöra dem och hela dem."]},{"type":"verse","number":23,"content":["På den dagen ska det finnas en banad väg mellan Egypten och Assyrien, och assyrierna ska komma in i Egypten och egyptierna in i Assyrien, och egyptierna ska tjäna Herren tillsammans med assyrierna."]},{"type":"verse","number":24,"content":["På den dagen ska Israel vara den tredje vid sidan av Egypten och Assyrien, en välsignelse mitt på jorden."]},{"type":"verse","number":25,"content":["Herren Sebaot ska välsigna dem och säga:",{"lineBreak":true},{"text":"Välsignat är Egypten, mitt folk,","poem":1},{"text":"och Assyrien, mina händers verk,","poem":2},{"text":"och Israel, min arvedel!","poem":3}]}],"footnotes":[{"noteId":109,"caller":"-","text":"egyptier mot egyptierLandet var splittrat mellan flera olika faraoner (vers 13) tills det erövrades och enades av nubiern Shabaka på 710-talet f Kr (vers 4).","reference":{"chapter":19,"verse":2}},{"noteId":110,"caller":"-","text":"ÄngarnaAnnan översättning: \"Vattenväxterna\".","reference":{"chapter":19,"verse":7}},{"noteId":111,"caller":"-","text":"arbetar med linEgypten var berömt för sitt fina linne (1 Mos 41:42, Ords 7:16, Hes 27:7).","reference":{"chapter":19,"verse":9}},{"noteId":112,"caller":"-","text":"Landets stöttepelareAndra handskrifter (Septuaginta): \"Vävarna\".","reference":{"chapter":19,"verse":10}},{"noteId":113,"caller":"-","text":"SoanHade varit Egyptens huvudstad under Salomos tid. Låg i östra Nildeltat (Ps 78:12).","reference":{"chapter":19,"verse":11}},{"noteId":114,"caller":"-","text":"de vet juAndra handskrifter: \"de kan få låta dig veta\".","reference":{"chapter":19,"verse":12}},{"noteId":115,"caller":"-","text":"MemfisEgyptens första huvudstad under 2000-talet f Kr, strax söder om nuvarande Kairo.","reference":{"chapter":19,"verse":13}},{"noteId":116,"caller":"-","text":"fem städerJfr Jer 44:1 för fyra egyptiska orter där hebreisktalande judar hade bosatt sig.","reference":{"chapter":19,"verse":18}},{"noteId":117,"caller":"-","text":"Ir-HaheresBetyder \"ödeläggelsens stad\". Andra handskrifter: \"Ir-Hacheres\", som betyder \"Solens stad\". I Heliopolisområdet byggdes enligt Josefus på 100-talet f Kr en mindre kopia av Jerusalems tempel (jfr vers 19).","reference":{"chapter":19,"verse":18}},{"noteId":118,"caller":"-","text":"och förkämpe somAnnan översättning: \"som ska kämpa och\". Ordet för \"förkämpe\" (rab) kan också översättas \"stor\" eller \"mästare\" (jfr \"rabbi\" i nytestamentlig tid).","reference":{"chapter":19,"verse":20}}]},"thisChapterLink":"/api/swe_fol/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}