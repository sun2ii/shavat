{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Herrens berg"]},{"type":"verse","number":1,"content":["Det ord som Jesaja, Amos son, såg i en syn angående Juda och Jerusalem:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Det ska ske i den yttersta tiden","poem":1},{"text":"att berget med Herrens hus","poem":2},{"text":"ska stå fast grundat","poem":3},{"text":"och vara högst bland bergen,","poem":2},{"text":"upphöjt över höjderna.","poem":3},{"text":"Alla hednafolk ska strömma dit,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"många folk ska gå i väg och säga:","poem":1},{"text":"\"Kom, låt oss gå upp","poem":2},{"text":"till Herrens berg,","poem":3},{"text":"till Jakobs Guds hus.","poem":4},{"text":"Han ska lära oss sina vägar","poem":2},{"text":"så att vi kan vandra","poem":3},{"text":"på hans stigar.\"","poem":4},{"text":"För undervisning ska gå ut","poem":2},{"text":"från Sion,","poem":3},{"text":"Herrens ord från Jerusalem.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Han ska döma mellan hednafolken","poem":1},{"text":"och skipa rätt för många folk.","poem":3},{"text":"Då ska de smida sina svärd","poem":2},{"text":"till plogbillar","poem":3},{"text":"och sina spjut","poem":2},{"text":"till vingårdsknivar.","poem":3},{"text":"Folk ska inte lyfta svärd mot folk","poem":2},{"text":"och inte mer öva för krig.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Kom, ni av Jakobs släkt,","poem":1},{"text":"låt oss vandra i Herrens ljus.","poem":2}]},{"type":"heading","content":["Herrens dag"]},{"type":"verse","number":6,"content":[{"text":"Du har förskjutit ditt folk,","poem":1},{"text":"Jakobs hus,","poem":3},{"text":"för de är fulla","poem":2},{"text":"av Österlandets tänkande,","poem":3},{"text":"de är spåmän som filisteerna.","poem":4},{"text":"De sluter förbund","poem":2},{"text":"med främmande folk.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Deras land är fullt av silver och guld,","poem":1},{"text":"det är ingen ände på deras skatter.","poem":3},{"text":"Deras land är fullt av hästar,","poem":2},{"text":"det är ingen ände","poem":3},{"text":"på deras vagnar","poem":4},{"noteId":14},{"text":".","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Deras land är fullt av avgudar,","poem":1},{"text":"och de tillber sina händers verk,","poem":2},{"text":"det som deras fingrar har gjort.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Därför blir människorna nerböjda","poem":1},{"text":"och männen ödmjukade.","poem":3},{"text":"Du ska inte förlåta dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Fly in i klippan och göm dig i stoftet","poem":1},{"text":"av fruktan för Herren","poem":2},{"text":"och hans höga majestät,","poem":3}]},{"type":"verse","number":11,"content":[{"text":"för människornas stolta ögon","poem":1},{"text":"ska ödmjukas,","poem":2},{"text":"männens högmod bli nerböjt.","poem":3},{"text":"Herren ensam","poem":2},{"text":"ska vara upphöjd på den dagen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"För Herren Sebaots dag","poem":1},{"text":"ska komma","poem":3},{"text":"mot allt som är stolt och högt,","poem":2},{"text":"mot allt som är upphöjt","poem":3},{"text":"så att det ödmjukas,","poem":4}]},{"type":"verse","number":13,"content":[{"text":"mot Libanons alla cedrar,","poem":1},{"text":"de höga och upphöjda,","poem":3},{"text":"och Bashans alla ekar","poem":2},{"noteId":15},{"text":",","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mot alla höga berg","poem":1},{"text":"och alla stolta höjder,","poem":3}]},{"type":"verse","number":15,"content":[{"text":"mot alla höga torn","poem":1},{"text":"och alla fasta murar,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"mot alla Tarshishskepp","poem":1},{"noteId":16},{"text":"och alla ståtliga fartyg","poem":3},{"noteId":17},{"text":".","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Människornas stolthet","poem":1},{"text":"ska böjas ner","poem":3},{"text":"och männens högmod","poem":2},{"text":"ödmjukas.","poem":3},{"text":"Herren ensam","poem":2},{"text":"ska vara upphöjd på den dagen,","poem":3}]},{"type":"verse","number":18,"content":[{"text":"och avgudarna ska helt försvinna.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Man ska fly in i klippgrottor","poem":1},{"text":"och jordhålor","poem":3},{"text":"av fruktan för Herren","poem":2},{"text":"och hans höga majestät,","poem":3},{"text":"när han reser sig","poem":2},{"text":"för att slå jorden med skräck.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"På den dagen","poem":1},{"text":"ska människorna kasta bort","poem":2},{"text":"till mullvadar och fladdermöss","poem":3},{"text":"sina avgudar av silver","poem":2},{"text":"och avgudar av guld","poem":3},{"text":"som de har gjort åt sig för att tillbe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"De ska fly in i klippskrevor","poem":1},{"text":"och bergsklyftor","poem":3},{"text":"av fruktan för Herren","poem":2},{"text":"och hans höga majestät,","poem":3},{"text":"när han reser sig","poem":2},{"text":"för att slå jorden med skräck.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Förlita er inte på människor,","poem":1},{"text":"som bara har en vindpust","poem":2},{"text":"i sin näsa!","poem":3},{"text":"Vad är de att räkna med?","poem":2}]}],"footnotes":[{"noteId":14,"caller":"-","text":"hästar … vagnarUttryck för militär styrka (se t ex 2 Kung 6:14f, Ps 20:8).","reference":{"chapter":2,"verse":7}},{"noteId":15,"caller":"-","text":"cedrar … ekarDet finaste träet från högländerna i Libanon (1 Kung 7:2f) och Golanhöjderna.","reference":{"chapter":2,"verse":13}},{"noteId":16,"caller":"-","text":"TarshishskeppLångfärdsskepp för handel med fjärran länder som Tarshish (kanske Spanien). En flotta med sådana skepp hade förlist på Joshafats tid (1 Kung 22:49, Ps 48:8).","reference":{"chapter":2,"verse":16}},{"noteId":17,"caller":"-","text":"alla ståtliga fartygAnnan översättning:\"allt som är vackert att se\".","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/swe_fol/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}