{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Babels fall"]},{"type":"verse","number":1,"content":["Profetia om Öknen vid havet",{"noteId":122},".",{"lineBreak":true},{"text":"Likt en storm som far fram","poem":1},{"text":"i Negev","poem":3},{"text":"kommer det från öknen,","poem":2},{"text":"från det fruktansvärda landet.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"En hemsk syn","poem":1},{"text":"har uppenbarats för mig:","poem":3},{"text":"\"Bedragaren bedrar,","poem":2},{"text":"plundraren plundrar.","poem":3},{"text":"Dra upp, Elam!","poem":2},{"text":"Träng på, Mediens","poem":3},{"noteId":123},{"text":"folk!","poem":3},{"text":"På all suckan ska jag göra slut.\"","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Därför är mina höfter fulla","poem":1},{"text":"av smärta,","poem":3},{"text":"jag har gripits av ångest","poem":2},{"text":"som en födande kvinnas ångest.","poem":3},{"text":"Jag är nertryckt","poem":2},{"text":"så att jag inte kan höra,","poem":3},{"text":"jag är bestört","poem":2},{"text":"så att jag inte kan se.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mitt hjärta är utom sig,","poem":1},{"text":"bävan överväldigar mig.","poem":3},{"text":"Skymningen som jag längtade efter","poem":2},{"text":"får mig att darra.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Man dukar bordet, sätter ut vakt,","poem":1},{"noteId":124},{"text":"äter och dricker.","poem":3},{"text":"Res er, ni furstar!","poem":2},{"text":"Smörj era sköldar!","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"För så har Herren sagt till mig:","poem":1},{"text":"\"Gå och ställ ut en väktare.","poem":2},{"text":"Han ska meddela vad han ser.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ser han ett tåg av ryttare i par,","poem":1},{"text":"ryttare på åsnor och på kameler,","poem":2},{"text":"ska han ge noga akt,","poem":3},{"text":"mycket noga.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Han började ryta som ett lejon","poem":1},{"noteId":125},{"text":":","poem":1},{"text":"\"Herre, här står jag ständigt","poem":2},{"text":"på vakt, dagen lång,","poem":3},{"text":"jag står här på min post","poem":2},{"text":"natt efter natt.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Och se, här kommer en vagn","poem":1},{"text":"med män och ryttare","poem":3},{"noteId":126},{"text":"i par!\"","poem":3},{"text":"Och han tog till orda och sade:","poem":2},{"text":"\"Det har fallit! Babel har fallit","poem":3},{"noteId":127},{"text":"!","poem":3},{"text":"Alla dess avgudabilder","poem":2},{"text":"är slagna till marken.\"","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Du mitt krossade","poem":1},{"text":"och söndertröskade folk,","poem":3},{"text":"vad jag har hört från Herren Sebaot,","poem":2},{"text":"Israels Gud,","poem":3},{"text":"det har jag förkunnat för er.","poem":2}]},{"type":"heading","content":["Profetia om Edom"]},{"type":"verse","number":11,"content":[{"text":"Profetia om Duma","poem":1},{"noteId":128},{"text":".","poem":1},{"lineBreak":true},{"text":"Man ropar till mig från Seir:","poem":1},{"text":"\"Väktare, vad är kvar av natten?","poem":2},{"text":"Väktare, vad är kvar av natten?\"","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Väktaren svarar:","poem":1},{"text":"\"Morgon kommer,","poem":2},{"text":"ändå är det natt.","poem":3},{"text":"Vill ni fråga mer, så fråga.","poem":2},{"text":"Kom tillbaka igen.\"","poem":3}]},{"type":"heading","content":["Profetia om Arabien"]},{"type":"verse","number":13,"content":[{"text":"Profetia om Arabien.","poem":1},{"lineBreak":true},{"text":"Ni ska bo i Arabiens vildmark,","poem":1},{"text":"ni karavaner från Dedan.","poem":2},{"noteId":129}]},{"type":"verse","number":14,"content":[{"text":"Möt de törstande med vatten.","poem":1},{"text":"De som bor i Temas land","poem":2},{"text":"ska möta flyktingarna med bröd,","poem":3}]},{"type":"verse","number":15,"content":[{"text":"för de flyr undan svärd,","poem":1},{"text":"undan draget svärd och spänd båge,","poem":2},{"text":"undan krigets tunga börda.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"För så har Herren sagt till mig:","poem":1},{"text":"Inom ett år,","poem":2},{"text":"så som daglönaren räknar året,","poem":3},{"text":"ska all Kedars","poem":2},{"noteId":130},{"text":"härlighet vara borta,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"och få ska vara kvar","poem":1},{"text":"av de många bågskyttarna,","poem":2},{"text":"Kedars väldiga krigare.","poem":3},{"text":"För så har Herren, Israels Gud, talat.","poem":2}]}],"footnotes":[{"noteId":122,"caller":"-","text":"Öknen vid havetTroligen träsklandet i södra Babylonien nära Persiska viken.","reference":{"chapter":21,"verse":1}},{"noteId":123,"caller":"-","text":"Elam … MedienFolk i västra Iran, allierade med Merodak-Baladan i Babel (vers 9).","reference":{"chapter":21,"verse":2}},{"noteId":124,"caller":"-","text":"vaktAnnan översättning: \"dynor\", kanske en ordlek (jfr vers 6).","reference":{"chapter":21,"verse":5}},{"noteId":125,"caller":"-","text":"ryta som ett lejonAndra handskrifter (Qumran, Peshitta): \"ropa, spejaren\".","reference":{"chapter":21,"verse":8}},{"noteId":126,"caller":"-","text":"ryttareAnnan översättning: \"hästar\".","reference":{"chapter":21,"verse":9}},{"noteId":127,"caller":"-","text":"Babel har fallitUnder Jesajas tid föll Babel 703 f Kr (se även not till 13:1), en motgång för Juda som samtidigt sökt frigöra sig från Assyrien (39:1 med not). När Babel längre fram föll 539 f Kr blev det istället en glädje för gudsfolket (Esra 1:1, Ps 137:8, jfr Upp 14:8, 18:2).","reference":{"chapter":21,"verse":9}},{"noteId":128,"caller":"-","text":"DumaOas i norra Arabien (1 Mos 25:14). Namnet betyder \"tystnad\" och anspelar på Edom.","reference":{"chapter":21,"verse":11}},{"noteId":129,"caller":"-","text":"Dedan … TemaArabstammar i nordvästra Saudiarabien (se Job 6:19, Hes 27:15, 20).","reference":{"chapter":21,"verse":13}},{"noteId":130,"caller":"-","text":"KedarNordarabisk herdestam (60:7, Hes 27:21), senare härjad av Nebukadnessar (Jer 49:28f).","reference":{"chapter":21,"verse":16}}]},"thisChapterLink":"/api/swe_fol/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}