{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Profetia om Tyrus"]},{"type":"verse","number":1,"content":["Profetia om Tyrus",{"noteId":140},".",{"lineBreak":true},{"text":"Jämra er, ni Tarshishskepp,","poem":1},{"text":"för det är ödelagt,","poem":2},{"text":"utan hus och utan ingång.","poem":3},{"text":"Från kitteernas land","poem":2},{"noteId":141},{"text":"når budskapet dem.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Sitt stumma, ni kustlandets invånare!","poem":1},{"text":"Köpmän från Sidon,","poem":2},{"text":"sjöfarande män, uppfyllde dig.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Av Shihors","poem":1},{"noteId":142},{"text":"säd","poem":1},{"text":"och Nilflodens skördar","poem":2},{"text":"gjorde du vinster","poem":3},{"text":"genom att fara över stora vatten","poem":2},{"text":"och driva handel.","poem":3},{"text":"Du blev en marknadsplats","poem":2},{"text":"för folken.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Stå där med skam, Sidon,","poem":1},{"text":"för havet har sagt,","poem":2},{"text":"havets fäste säger:","poem":3},{"text":"\"Jag har inte haft födslosmärtor,","poem":2},{"text":"inte fött barn,","poem":3},{"text":"inte fött upp unga män","poem":2},{"text":"eller fostrat jungfrur.\"","poem":3}]},{"type":"verse","number":5,"content":[{"text":"När ryktet kommer till Egypten","poem":1},{"text":"bävar man vid nyheterna","poem":2},{"text":"om Tyrus.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Dra bort till Tarshish","poem":1},{"noteId":143},{"text":"och jämra er,","poem":1},{"text":"ni kustlandets invånare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Är detta er stolta stad","poem":1},{"text":"från forna dagar,","poem":3},{"text":"vars fötter bar henne bort","poem":2},{"text":"för att bosätta sig i fjärran?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Vem har bestämt detta om Tyrus,","poem":1},{"text":"hon som delade ut kronor,","poem":3},{"text":"hon vars köpmän var furstar","poem":2},{"text":"och vars handelsmän","poem":3},{"text":"var jordens stormän.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Herren Sebaot har bestämt det,","poem":1},{"text":"för att slå ner all stolt härlighet","poem":3},{"text":"och ödmjuka jordens alla stormän.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bred ut dig över ditt land","poem":1},{"text":"som Nilfloden,","poem":3},{"text":"du dotter Tarshish.","poem":4},{"text":"Du bär ingen boja mer.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Han räckte ut sin hand över havet,","poem":1},{"text":"han fick kungariken att skaka.","poem":3},{"text":"Herren befallde att Kanaans fästen","poem":2},{"text":"skulle ödeläggas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Han sade:","poem":1},{"text":"\"Du ska aldrig mer stoltsera,","poem":2},{"text":"du kränkta jungfru, dotter Sidon","poem":3},{"noteId":144},{"text":".","poem":3},{"text":"Bryt upp och dra bort","poem":2},{"text":"till kitteernas land.","poem":3},{"text":"Men inte heller där ska du få ro.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Se på kaldeernas land,","poem":1},{"text":"det folket finns inte mer.","poem":3},{"noteId":145},{"text":"Assyrierna gav det landet","poem":2},{"text":"åt ökendjur.","poem":3},{"text":"De reste sina belägringstorn,","poem":2},{"text":"rev ner dess borgar","poem":3},{"text":"och förvandlade det till en grushög.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jämra er, ni Tarshishskepp,","poem":1},{"text":"för er befästning är förstörd.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":["På den dagen ska Tyrus vara bortglömt i sjuttio år, lika länge som en kungs dagar. Men efter sjuttio år ska det gå med Tyrus som i visan om den prostituerade:"]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"\"Ta din harpa och gå runt i staden,","poem":1},{"text":"du bortglömda prostituerade.","poem":3},{"text":"Spela vackert och sjung flitigt,","poem":2},{"text":"så att du blir ihågkommen.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":["För efter sjuttio år ska Herren se till Tyrus, och hon ska åter ta emot prostitutionspengar och begå otukt med jordens alla länder i hela världen."]},{"type":"verse","number":18,"content":["Men hennes handelsvinst och hennes lön ska helgas åt Herren. Det ska inte lagras eller läggas undan, utan hennes vinst ska gå till dem som bor inför Herrens ansikte, för att de ska få äta sig mätta och ha praktfulla kläder."]}],"footnotes":[{"noteId":140,"caller":"-","text":"TyrusStor handelsstad strax norr om Israel (Hes 26-28).","reference":{"chapter":23,"verse":1}},{"noteId":141,"caller":"-","text":"kitteernas landCypern, allierat med Tyrus. Hit flydde Tyrus kung Lulli ca år 705 f Kr undan assyrierna (jfr vers 12).","reference":{"chapter":23,"verse":1}},{"noteId":142,"caller":"-","text":"ShihorTroligen östra delen av Nildeltat (Jos 13:3, Jer 2:18).","reference":{"chapter":23,"verse":3}},{"noteId":143,"caller":"-","text":"TarshishNågon av kolonierna som fenicierna från Tyrus hade grundat i Medelhavet (vers 7). Kanske Tartessos i sydvästra Spanien, kanske Sardinien eller Kartago.","reference":{"chapter":23,"verse":6}},{"noteId":144,"caller":"-","text":"SidonHandelsstad ca 2 mil norr om Tyrus som skövlades av assyrierna år 677 f Kr.","reference":{"chapter":23,"verse":12}},{"noteId":145,"caller":"-","text":"det folket finns inte merBabel ödelades av assyriern Sanherib 689 f Kr (se 13:1 med not). Annan översättning: \"folket som förr inte fanns till\".","reference":{"chapter":23,"verse":13}}]},"thisChapterLink":"/api/swe_fol/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}