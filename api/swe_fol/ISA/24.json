{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Den stora domen över hela jorden"]},{"type":"verse","number":1,"content":["Se, Herren tömmer jorden",{"text":"och ödelägger den.","poem":3},{"text":"Han omvälver dess yta","poem":2},{"text":"och skingrar dess invånare.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Det går prästen som folket,","poem":1},{"text":"husbonden som tjänaren,","poem":2},{"text":"husmodern som tjänarinnan,","poem":3},{"text":"säljaren som köparen,","poem":2},{"text":"låntagaren som långivaren,","poem":3},{"text":"den skuldsatte","poem":2},{"text":"som borgensmannen.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Jorden blir helt ödelagd","poem":1},{"text":"och fullständigt utplundrad,","poem":3},{"text":"för Herren har talat detta ord.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jorden sörjer och vissnar,","poem":1},{"text":"världen tynar bort och vissnar,","poem":2},{"text":"jordens stolta folk tynar bort.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Jorden har blivit orenad","poem":1},{"text":"under sina invånare,","poem":3},{"text":"för de har överträtt","poem":2},{"text":"Guds undervisning,","poem":3},{"text":"kränkt lagarna","poem":2},{"text":"och brutit det eviga förbundet.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Därför förtär en förbannelse jorden,","poem":1},{"text":"de som bor på den","poem":2},{"text":"måste straffas för sin skuld.","poem":3},{"text":"Därför blir jordens invånare färre","poem":2},{"noteId":146},{"text":",","poem":2},{"text":"bara några få är kvar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vinmusten sörjer,","poem":1},{"text":"vinstocken tynar bort.","poem":3},{"text":"Alla som var hjärteglada suckar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Det är slut med tamburinernas fröjd,","poem":1},{"text":"de gladas sorl har slutat.","poem":2},{"text":"Det är slut med harpans glädje.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Man dricker inte vin under sång,","poem":1},{"text":"rusdrycken är bitter","poem":2},{"text":"för dem som dricker den.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Den öde staden ligger nerbruten,","poem":1},{"text":"alla hus är stängda","poem":2},{"text":"så att ingen kommer in.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ute på gatorna","poem":1},{"text":"hörs sorgerop över vinet.","poem":3},{"text":"All glädje har förmörkats,","poem":2},{"text":"all jordens fröjd har flytt.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Bara förödelse är kvar i staden,","poem":1},{"text":"porten har slagits i spillror.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"För det ska bli","poem":1},{"text":"på jorden bland folken","poem":3},{"text":"som när oliver slås ner,","poem":2},{"text":"som vid en efterskörd","poem":3},{"text":"när vinskörden är slut.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"De höjer sin röst och ropar av fröjd,","poem":1},{"text":"de jublar högt från havet","poem":3},{"text":"över Herrens höghet:","poem":4}]},{"type":"verse","number":15,"content":[{"text":"\"Ära därför Herren i öster,","poem":1},{"text":"ära i havsländerna","poem":2},{"text":"Herrens, Israels Guds, namn.\"","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Från jordens ände","poem":1},{"text":"hör vi lovsånger:","poem":3},{"text":"\"Ära till den Rättfärdige!\"","poem":2},{"lineBreak":true},{"text":"Men jag sade:","poem":1},{"text":"Jag förgås, jag förgås, ve mig!","poem":3},{"text":"Förrädare förråder,","poem":2},{"text":"förrädiskt förråder förrädarna.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Fruktan, fallgrop och fälla väntar er,","poem":1},{"text":"ni jordens invånare.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Det ska ske att den som flyr","poem":1},{"text":"från farans rop störtar","poem":2},{"text":"i fallgropen,","poem":3},{"text":"och den som kommer upp","poem":2},{"text":"ur fallgropen fångas i fällan,","poem":3},{"text":"för fönstren i höjden är öppna","poem":2},{"text":"och jordens grundvalar skakar.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Jorden brister, ja, den brister.","poem":1},{"text":"Jorden rämnar, ja, den rämnar.","poem":2},{"text":"Jorden vacklar, ja, den vacklar.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Jorden raglar som en drucken.","poem":1},{"text":"Den svajar fram och tillbaka","poem":2},{"text":"som en vakthydda i trädets topp.","poem":3},{"text":"Dess missgärning vilar tung","poem":2},{"text":"på den.","poem":3},{"text":"Den ska falla och inte mer resa sig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"På den dagen ska Herren straffa","poem":1},{"text":"höjdens här","poem":3},{"noteId":147},{"text":"uppe i höjden","poem":3},{"text":"och jordens kungar nere på jorden.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"De ska samlas ihop","poem":1},{"text":"som fångar i fånggropen,","poem":2},{"text":"de ska stängas inne i fängelse.","poem":3},{"text":"Efter lång tid når straffet dem.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Då ska månen blygas","poem":1},{"text":"och solen skämmas,","poem":3},{"text":"för Herren Sebaot ska då vara kung","poem":2},{"text":"på Sions berg och i Jerusalem","poem":3},{"text":"och inför sina äldste, i härlighet.","poem":2}]}],"footnotes":[{"noteId":146,"caller":"-","text":"blir ... färreAnnan översättning: \"brinner\".","reference":{"chapter":24,"verse":6}},{"noteId":147,"caller":"-","text":"höjdens härStjärnor symboliserar ofta änglar (Upp 1:20, 8:12f). Se Jud v 6, Matt 25:41.","reference":{"chapter":24,"verse":21}}]},"thisChapterLink":"/api/swe_fol/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}