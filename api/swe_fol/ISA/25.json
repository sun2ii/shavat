{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Lovsång till Herren för hans seger"]},{"type":"verse","number":1,"content":["Herre, du är min Gud!",{"text":"Jag vill upphöja dig,","poem":2},{"text":"jag vill prisa ditt namn,","poem":3},{"text":"för du gör underbara ting,","poem":2},{"text":"dina beslut från forna tider","poem":3},{"text":"med trofasthet och sanning.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Du har gjort stad till stenhög,","poem":1},{"text":"befäst stad till ruiner.","poem":3},{"text":"Främlingarnas fäste","poem":2},{"text":"ska inte längre vara en stad,","poem":3},{"text":"det ska aldrig mer byggas upp.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Därför ska det mäktiga folket","poem":1},{"text":"ära dig,","poem":3},{"text":"de skoningslösa hedningarnas","poem":2},{"text":"städer frukta dig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Du är ett skydd för den svage,","poem":1},{"text":"ett skydd för den fattige","poem":2},{"text":"i hans nöd,","poem":3},{"text":"en tillflykt undan storm,","poem":2},{"text":"en skugga undan hetta.","poem":3},{"text":"För de skoningslösas andedräkt","poem":2},{"text":"är som en storm mot en vägg.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Som du kuvar hettan","poem":1},{"text":"när det är som torrast,","poem":2},{"text":"så kuvar du främlingarnas larm.","poem":3},{"text":"Som hettan dämpas","poem":2},{"text":"av molnets skugga,","poem":3},{"text":"så dämpas de skoningslösas sång.","poem":2}]},{"type":"heading","content":["Herrens festmåltid"]},{"type":"verse","number":6,"content":[{"text":"Herren Sebaot ska på detta berg","poem":1},{"text":"göra en festmåltid för alla folk,","poem":3},{"text":"en festmåltid med feta rätter","poem":2},{"text":"och lagrade viner,","poem":3},{"text":"feta, mustiga rätter","poem":2},{"text":"och lagrat, klarat vin.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han ska på detta berg utplåna","poem":1},{"text":"den slöja som beslöjar alla folk,","poem":3},{"text":"det täckelse som täcker","poem":2},{"text":"alla folkslag.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Han ska utplåna döden för evigt.","poem":1},{"text":"Herren Gud ska torka tårarna","poem":2},{"text":"från alla ansikten","poem":3},{"text":"och ta bort sitt folks vanära","poem":2},{"text":"från hela jorden,","poem":3},{"text":"för Herren har talat.","poem":2},{"noteId":148}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"På den dagen ska man säga:","poem":1},{"text":"Se, här är vår Gud!","poem":3},{"text":"Honom hoppades","poem":2},{"noteId":149},{"text":"vi på,","poem":2},{"text":"att han skulle frälsa oss.","poem":3},{"text":"Ja, här är Herren","poem":2},{"text":"som vi hoppades på.","poem":3},{"text":"Låt oss vara glada och jubla","poem":2},{"text":"över hans frälsning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"För Herrens hand","poem":1},{"text":"ska vila över detta berg,","poem":3},{"text":"men Moab ska trampas ner","poem":2},{"text":"i sitt land","poem":3},{"text":"som halm trampas ner","poem":2},{"text":"i gödselhögen.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Där ska han breda ut sina händer","poem":1},{"text":"som simmaren gör","poem":3},{"text":"för att simma,","poem":4},{"text":"men hans stolthet ska brytas ner","poem":2},{"text":"trots hans händers alla konster.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ja, dina murars höga fästningsverk","poem":1},{"text":"störtar han och ödmjukar,","poem":3},{"text":"han tar ner dem till jorden,","poem":2},{"text":"ner i stoftet.","poem":3}]}],"footnotes":[{"noteId":148,"caller":"-","text":"Citeras av Paulus i 1 Kor 15:54. Hebr. nésach, \"för evigt\", kan också översättas \"i seger\".","reference":{"chapter":25,"verse":8}},{"noteId":149,"caller":"-","text":"hoppadesAnnan översättning: \"väntade\".","reference":{"chapter":25,"verse":9}}]},"thisChapterLink":"/api/swe_fol/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}