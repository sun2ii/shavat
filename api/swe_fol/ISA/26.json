{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Lovsång"]},{"type":"verse","number":1,"content":["På den dagen ska man sjunga denna sång i Juda land:",{"lineBreak":true},{"text":"Vi har en stark stad.","poem":1},{"text":"Frälsningen gör han","poem":2},{"text":"till murar och värn.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Öppna portarna","poem":1},{"text":"och låt ett rättfärdigt folk tåga in,","poem":2},{"text":"ett folk som förblir troget.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Den som är fast i sitt sinne","poem":1},{"text":"bevarar du i frid,","poem":3},{"text":"i frid, för han förtröstar på dig.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Förtrösta på Herren för evigt,","poem":1},{"text":"för HerrenHerren","poem":2},{"text":"är en evig klippa.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Han störtar ner dem som tronar","poem":1},{"text":"i höjden,","poem":4},{"text":"den stolta staden ödmjukar han.","poem":3},{"text":"Han slår den ner till jorden,","poem":2},{"text":"han tar ner den i stoftet.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Den trampas ner under fötterna –","poem":1},{"text":"fattigas fötter, svagas steg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den rättfärdiges väg är jämn.","poem":1},{"text":"Du, den Rättvise,","poem":2},{"text":"jämnar den rättfärdiges stig.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ja, på dina domars väg, Herre,","poem":1},{"text":"väntar vi dig.","poem":3},{"text":"Ditt namn och din ära","poem":2},{"text":"är vår själs längtan.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Min själ längtar efter dig om natten,","poem":1},{"text":"anden i mig söker dig,","poem":3},{"text":"för när dina domar drabbar jorden","poem":2},{"text":"lär sig världens invånare","poem":3},{"text":"rättfärdighet.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"När den ogudaktige får nåd","poem":1},{"text":"lär han sig inte rättfärdighet.","poem":3},{"text":"I det land där rätt skulle råda","poem":2},{"text":"handlar han orätt,","poem":3},{"text":"han ser inte Herrens höghet.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Herre, din hand är upplyft,","poem":1},{"text":"men de ser det inte.","poem":3},{"text":"De ska se din iver för folket","poem":2},{"text":"och blygas,","poem":3},{"text":"den eld som är avsedd","poem":2},{"text":"för dina fiender ska förtära dem.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Herre, du ska ge oss frid,","poem":1},{"text":"för allt som vi har uträttat","poem":2},{"text":"har du utfört åt oss.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Herre vår Gud, andra herrar än du","poem":1},{"text":"har härskat över oss,","poem":3},{"text":"men bara genom dig","poem":2},{"text":"prisar vi ditt namn.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"De är döda, de får inte liv igen,","poem":1},{"text":"deras andar kan inte uppstå.","poem":3},{"text":"Därför har du gripit in","poem":2},{"text":"och förgjort dem,","poem":3},{"text":"du har utplånat minnet av dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Du har förökat folket, Herre.","poem":1},{"text":"Du har förökat folket","poem":2},{"text":"och visat dig härlig,","poem":3},{"text":"du har utvidgat","poem":2},{"text":"landets alla gränser.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Herre, i nöden sökte de dig,","poem":1},{"text":"de utgöt tysta böner","poem":3},{"text":"när din tillrättavisning","poem":2},{"text":"drabbade dem.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Som en havande kvinna våndas","poem":1},{"text":"när hon är nära att föda","poem":2},{"text":"och ropar ut sin smärta,","poem":3},{"text":"så är det med oss inför dig, Herre.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vi var havande och våndades,","poem":1},{"text":"men vi födde vind.","poem":3},{"text":"Vi har inte gett landet frälsning,","poem":2},{"text":"och ingen föds till att bo","poem":3},{"text":"på jorden.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Dina döda ska bli levande,","poem":1},{"text":"mina dödas","poem":3},{"noteId":150},{"text":"kroppar ska uppstå.","poem":3},{"text":"Vakna upp och jubla,","poem":2},{"text":"ni som bor i stoftet,","poem":3},{"text":"för din dagg är ljusets dagg,","poem":2},{"text":"och jorden ska ge igen","poem":3},{"text":"de avsomnade.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Kom, mitt folk,","poem":1},{"text":"och gå in i dina kamrar,","poem":2},{"text":"stäng igen dörrarna efter dig.","poem":3},{"text":"Göm dig ett litet ögonblick","poem":2},{"text":"tills vreden har gått förbi.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"För se, Herren kommer","poem":1},{"text":"ut ur sin boning","poem":3},{"text":"för att straffa jordens invånare","poem":2},{"text":"för deras missgärning.","poem":3},{"text":"Jorden ska blotta","poem":2},{"text":"sina blodskulder","poem":3},{"text":"och inte längre dölja","poem":2},{"text":"sina dräpta.","poem":3}]}],"footnotes":[{"noteId":150,"caller":"-","text":"mina dödasAndra handskrifter (Peshitta): \"deras döda\".","reference":{"chapter":26,"verse":19}}]},"thisChapterLink":"/api/swe_fol/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}