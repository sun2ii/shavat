{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Israel, Herrens vingård"]},{"type":"verse","number":1,"content":["På den dagen ska Herren",{"text":"med sitt hårda, stora","poem":2},{"text":"och starka svärd","poem":3},{"text":"straffa Leviatan,","poem":2},{"text":"den snabba ormen,","poem":3},{"text":"Leviatan, den ringlande ormen,","poem":2},{"text":"och han ska döda draken","poem":3},{"noteId":151},{"text":"i havet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sjung på den dagen","poem":1},{"text":"om den underbara vingården:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jag, Herren, sköter om den,","poem":1},{"text":"ständigt vattnar jag den.","poem":3},{"text":"Både dag och natt vaktar jag den","poem":2},{"text":"så att ingen ska skada den.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag hyser ingen vrede.","poem":1},{"text":"Hade jag törne och tistel","poem":2},{"text":"att strida emot,","poem":3},{"text":"skulle jag gå lös på dem","poem":2},{"text":"och bränna upp alltsammans.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Eller också söker man skydd hos mig","poem":1},{"text":"för att sluta fred med mig.","poem":3},{"text":"Ja, fred ska man sluta med mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"I kommande dagar ska Jakob slå rot,","poem":1},{"text":"Israel grönska och blomstra.","poem":3},{"text":"De ska fylla hela världen","poem":2},{"text":"med frukt.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Har han slagit Israel","poem":1},{"text":"så som han slog","poem":2},{"text":"dem som slog hans folk?","poem":3},{"text":"Eller dräpte han Israel","poem":2},{"text":"så som dess dråpare blev dräpta?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Nej, noggrant utmätt","poem":1},{"text":"gick du till rätta med dem","poem":2},{"text":"när de sändes bort.","poem":3},{"text":"Han fördrev dem","poem":2},{"text":"med sin hårda vind","poem":3},{"text":"på östanstormens dag.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Men därför blir också","poem":1},{"text":"Jakobs skuld försonad,","poem":3},{"text":"och detta blir följden","poem":2},{"text":"av att deras synd tas bort:","poem":3},{"text":"Han krossar alla altarstenar","poem":2},{"text":"som när kalksten smulas sönder.","poem":3},{"text":"Asherapålar och solstoder","poem":2},{"noteId":152},{"text":"ska inte mer resas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Den befästa staden är öde,","poem":1},{"text":"en folktom plats,","poem":2},{"text":"övergiven som en öken.","poem":3},{"text":"Kalvar betar där och lägger sig där,","poem":2},{"text":"de biter av dess kvistar.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"När grenarna är torra","poem":1},{"text":"bryter man av dem,","poem":3},{"text":"och kvinnor kommer","poem":2},{"text":"och gör upp eld med dem,","poem":3},{"text":"för detta är ett folk","poem":2},{"text":"utan förstånd.","poem":3},{"text":"Därför har deras Skapare","poem":2},{"text":"inget förbarmande med dem,","poem":3},{"text":"han som har format dem","poem":2},{"text":"visar dem ingen nåd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Det ska ske på den dagen","poem":1},{"text":"att Herren klappar ut kornen,","poem":3},{"noteId":153},{"text":"ända från den strida floden","poem":2},{"text":"till Egyptens bäckravin","poem":3},{"noteId":154},{"text":",","poem":3},{"text":"och ni ska samlas in en och en,","poem":2},{"text":"ni Israels barn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Och det ska ske på den dagen","poem":1},{"text":"att man blåser i en stor basun,","poem":3},{"text":"och de som var försvunna","poem":2},{"noteId":155},{"text":"i Assyriens land","poem":3},{"text":"och fördrivna till Egyptens land","poem":2},{"text":"ska då komma och tillbe Herren","poem":3},{"text":"på det heliga berget i Jerusalem.","poem":4}]}],"footnotes":[{"noteId":151,"caller":"-","text":"Leviatan ... drakenär symboler för onda makter och riken som är fiender till Guds rike. Jfr Job 40:20f, Upp 12-13.","reference":{"chapter":27,"verse":1}},{"noteId":152,"caller":"-","text":"altarstenar … Asherapålar och solstoderRensades bort av kung Hiskia (2 Kung 18:4, 22, 2 Krön 31:1). Ordet för \"solstoder\" kan också syfta på hedniska rökelsealtaren (2 Krön 30:14).","reference":{"chapter":27,"verse":9}},{"noteId":153,"caller":"-","text":"klappar ut kornenFör att skilja agnarna från vetet (jfr Rut 2:17).","reference":{"chapter":27,"verse":12}},{"noteId":154,"caller":"-","text":"floden … Egyptens bäckravinFrån Eufrat till Wadi el-Arish, gränsen i sydväst (jfr 2 Kung 24:7).","reference":{"chapter":27,"verse":12}},{"noteId":155,"caller":"-","text":"försvunnaAnnan översättning: \"på väg att gå under\".","reference":{"chapter":27,"verse":13}}]},"thisChapterLink":"/api/swe_fol/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}