{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Ve över Samaria"]},{"type":"verse","number":1,"content":["Ve dig,",{"text":"du stolta krona","poem":2},{"text":"av Efraims druckna män,","poem":3},{"text":"du vissnande blomma","poem":2},{"text":"av hans strålande härlighet","poem":3},{"text":"på berget","poem":2},{"noteId":156},{"text":"över","poem":2},{"text":"de vinberusades bördiga dal!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Se, från Herren kommer","poem":1},{"text":"en som är stark och mäktig,","poem":3},{"text":"som en hagelskur,","poem":2},{"text":"en förödande storm,","poem":3},{"text":"som en flod med väldiga vatten","poem":2},{"text":"som forsar fram med kraft","poem":3},{"text":"och slår allt till marken.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Den stolta kronan","poem":1},{"text":"av Efraims druckna män","poem":3},{"text":"trampas då under fötterna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Den vissnande blomman","poem":1},{"text":"av hans strålande härlighet","poem":2},{"text":"på berget över den bördiga dalen","poem":3},{"text":"ska bli som ett tidigt fikon","poem":2},{"text":"som mognat före sommaren:","poem":3},{"text":"När någon får se det slukar han det,","poem":2},{"text":"så snart det är i hans hand.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"På den dagen ska Herren Sebaot","poem":1},{"text":"bli en härlig krona","poem":2},{"text":"och en strålande krans","poem":3},{"text":"för dem som är kvar","poem":2},{"text":"av hans folk.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han ska bli en rättens ande","poem":1},{"text":"för den som skipar rätt","poem":3},{"text":"och en styrka för dem","poem":2},{"text":"som driver fienden på porten.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Men också de raglar av vin","poem":1},{"text":"och vinglar av starka drycker.","poem":3},{"text":"Både präst och profet","poem":2},{"text":"raglar av starka drycker.","poem":3},{"text":"De är berusade av vin","poem":2},{"text":"och vinglar.","poem":3},{"text":"De raglar när de profeterar,","poem":2},{"text":"de stapplar när de skipar rätt.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Alla bord är täckta","poem":1},{"text":"med äckliga spyor,","poem":3},{"text":"det finns ingen ren fläck.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"\"Vem kan han lära förstånd?","poem":1},{"text":"För vem förklarar han budskapet?","poem":3},{"text":"För dem som just är avvanda","poem":2},{"text":"från modersmjölken,","poem":3},{"text":"nyss tagna från modersbröstet?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"För det är bud på bud, bud på bud,","poem":1},{"text":"ljud på ljud, ljud på ljud,","poem":2},{"noteId":157},{"text":"lite här, lite där!\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ja, genom stammande","poem":1},{"noteId":158},{"text":"läppar","poem":1},{"text":"och på främmande språk","poem":3},{"text":"ska han tala till detta folk,","poem":2},{"noteId":159}]},{"type":"verse","number":12,"content":[{"text":"han som en gång sade till dem:","poem":1},{"text":"\"Här är viloplatsen,","poem":2},{"text":"låt den trötte vila.","poem":3},{"text":"Här finns ro.\"","poem":4},{"text":"Men de ville inte lyssna.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Och Herrens ord blev för dem","poem":1},{"text":"\"bud på bud, bud på bud,","poem":2},{"text":"ljud på ljud, ljud på ljud,","poem":3},{"text":"lite här, lite där.\"","poem":4},{"text":"Så ska de, där de går,","poem":2},{"text":"falla baklänges och krossas,","poem":3},{"text":"bli snärjda och fångade.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hör därför Herrens ord,","poem":1},{"text":"ni hånare som härskar","poem":2},{"text":"över folket här i Jerusalem.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Ni säger:","poem":1},{"text":"\"Vi har slutit förbund med döden,","poem":2},{"text":"vi har ingått en pakt","poem":3},{"text":"med dödsriket.","poem":4},{"text":"När gisslet far fram som en störtflod","poem":2},{"text":"ska det inte nå oss,","poem":3},{"text":"för vi har gjort lögnen","poem":2},{"text":"till vår tillflykt,","poem":3},{"text":"falskheten till vårt gömställe.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Därför säger Herren Gud så:","poem":1},{"text":"Se, jag har lagt","poem":2},{"text":"en grundsten i Sion,","poem":3},{"text":"en beprövad sten,","poem":2},{"text":"en dyrbar hörnsten,","poem":3},{"text":"en fast grundval.","poem":4},{"text":"Den som tror på den","poem":2},{"text":"behöver inte fly","poem":3},{"noteId":160},{"text":".","poem":3},{"noteId":161}]},{"type":"verse","number":17,"content":[{"text":"Och jag ska låta","poem":1},{"text":"rätten vara mätsnöret","poem":2},{"text":"och rättfärdigheten sänklodet.","poem":3},{"text":"Hagel ska slå ner lögnens tillflykt,","poem":2},{"text":"vatten ska skölja bort gömstället.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Ert förbund med döden","poem":1},{"text":"ska upplösas,","poem":3},{"text":"er pakt med dödsriket","poem":2},{"text":"ska inte bestå.","poem":3},{"text":"När gisslet far fram","poem":2},{"text":"som en störtflod","poem":3},{"text":"ska ni bli nertrampade av det.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Så ofta det far fram","poem":1},{"text":"ska det träffa er.","poem":3},{"text":"Morgon efter morgon","poem":2},{"text":"ska det fara fram,","poem":3},{"text":"både dag och natt.","poem":4},{"text":"Det blir bara förfäran","poem":2},{"text":"när man förstår budskapet.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"För sängen är för kort","poem":1},{"text":"att sträcka ut sig på,","poem":3},{"text":"täcket för smalt att svepa in sig i.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ja, Herren ska resa sig","poem":1},{"text":"som på Perasims berg,","poem":3},{"text":"och han ska vredgas","poem":2},{"text":"som i Gibeons dal","poem":3},{"noteId":162},{"text":"för att utföra sitt verk,","poem":2},{"text":"sitt främmande verk,","poem":3},{"text":"och fullgöra sitt arbete,","poem":2},{"text":"sitt förunderliga arbete.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Sluta nu med ert hån,","poem":1},{"text":"så att era band inte dras åt","poem":2},{"text":"ännu hårdare,","poem":3},{"text":"för jag har hört","poem":2},{"text":"från Herren Gud Sebaot","poem":3},{"text":"om förödelse","poem":2},{"text":"och beslutad straffdom","poem":3},{"text":"över hela jorden.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Lyssna och hör min röst,","poem":1},{"text":"ge akt och hör mina ord.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"När bonden vill så,","poem":1},{"text":"plöjer han då ständigt","poem":3},{"text":"och hackar upp och harvar sin åker?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"När han har fått marken jämn,","poem":1},{"text":"strör han då inte ut svartkummin","poem":2},{"text":"och kryddkummin,","poem":3},{"text":"sår vete i rader","poem":2},{"text":"och korn på dess plats","poem":3},{"text":"och spältvete","poem":4},{"noteId":163},{"text":"i kanten?","poem":4}]},{"type":"verse","number":26,"content":[{"text":"För hans Gud har undervisat honom","poem":1},{"text":"och lärt honom det rätta sättet.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Man tröskar ju inte","poem":1},{"text":"svartkummin med trösksläde","poem":3},{"text":"eller kryddkummin","poem":2},{"text":"med vagnshjul,","poem":3},{"text":"utan man klappar ut svartkummin","poem":2},{"text":"med stav","poem":3},{"text":"och kryddkummin med käpp.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Brödsäd tröskas","poem":1},{"text":"men inte i det oändliga,","poem":3},{"text":"man driver inte ständigt","poem":2},{"text":"sina vagnshjul","poem":3},{"text":"och hästar över den.","poem":4},{"text":"Man vill ju inte tröska sönder den.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Också detta kommer från","poem":1},{"text":"Herren Sebaot,","poem":3},{"text":"underbar i råd och stor i vishet.","poem":2}]}],"footnotes":[{"noteId":156,"caller":"-","text":"Efraims druckna … på bergetNordrikets huvudstad Samaria var byggd på ett berg (1 Kung 16:24).","reference":{"chapter":28,"verse":1}},{"noteId":157,"caller":"-","text":"bud på bud, ljud på ljudDe korta orden (hebr. kav lekáv, sav lesáv) som motståndarna hånar Jesaja med knyter an till ramsor för barn (jfr vers 9), men leder också tanken till de assyriska erövrarnas främmande språk akkadiska (jfr 28:11, 33:19).","reference":{"chapter":28,"verse":10}},{"noteId":158,"caller":"-","text":"stammandeAnnan översättning: \"hånfulla\" (jfr de assyriska förtryckarna i 33:19).","reference":{"chapter":28,"verse":11}},{"noteId":159,"caller":"-","text":"Citeras av Paulus i 1 Kor 14:21 som profetia om tungotalets gåva.","reference":{"chapter":28,"verse":11}},{"noteId":160,"caller":"-","text":"flyAndra handskrifter (Septuaginta): \"skämmas\".","reference":{"chapter":28,"verse":16}},{"noteId":161,"caller":"-","text":"Citeras av Petrus i 1 Petr 2:6 och av Paulus i Rom 9:33, 10:11 som profetia om Messias.","reference":{"chapter":28,"verse":16}},{"noteId":162,"caller":"-","text":"Perasims berg … Gibeons dalPlatser för forna militära segrar (2 Sam 5:20, Jos 10:10).","reference":{"chapter":28,"verse":21}},{"noteId":163,"caller":"-","text":"spältvetekallas också dinkelvete, en äldre vetesort.","reference":{"chapter":28,"verse":25}}]},"thisChapterLink":"/api/swe_fol/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}