{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["Jerusalems belägring och räddning"]},{"type":"verse","number":1,"content":["Ve dig, Ariel, Ariel,",{"noteId":164},{"text":"staden där David","poem":3},{"lineBreak":true},{"text":"slog upp sitt läger","poem":3},{"noteId":165},{"text":"!","poem":3},{"text":"Lägg år till år,","poem":2},{"text":"låt högtiderna fullborda","poem":3},{"text":"sitt kretslopp,","poem":4}]},{"type":"verse","number":2,"content":[{"text":"så ska jag ansätta Ariel.","poem":1},{"text":"Där ska bli sorg och jämmer,","poem":2},{"text":"och den ska vara för mig","poem":3},{"text":"ett verkligt Ariel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jag ska slå läger runt omkring dig","poem":1},{"noteId":166},{"text":",","poem":1},{"text":"omringa dig med belägringsvallar","poem":2},{"text":"och resa upp bålverk mot dig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Då ska du bli förnedrad","poem":1},{"text":"och tala djupt nerifrån jorden,","poem":3},{"text":"dämpade ska dina ord","poem":2},{"text":"komma fram ur stoftet.","poem":3},{"text":"Din röst ska höras ur jorden","poem":2},{"text":"som en andes röst,","poem":3},{"text":"ur stoftet ska du viska fram","poem":2},{"text":"dina ord.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Men dina många fiender","poem":1},{"noteId":167},{"text":"ska bli som fint damm,","poem":3},{"text":"våldsmännens skara","poem":2},{"text":"som bortflygande agnar.","poem":3},{"text":"Det ska ske plötsligt,","poem":2},{"text":"på ett ögonblick.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Från Herren Sebaot","poem":1},{"text":"ska straffet komma","poem":3},{"text":"med åska och jordbävning","poem":2},{"text":"och väldigt dån,","poem":3},{"text":"med storm och oväder","poem":2},{"text":"och flammor av förtärande eld.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Och alla de många folk","poem":1},{"text":"som förde krig mot Ariel,","poem":3},{"text":"alla som drog ut i strid","poem":2},{"text":"mot det och dess borg","poem":3},{"text":"och ansatte det","poem":4},{"text":"ska vara som en drömsyn","poem":2},{"text":"om natten.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Som när den hungrige","poem":1},{"text":"drömmer att han äter","poem":3},{"text":"men vaknar och känner","poem":2},{"text":"att magen är tom,","poem":3},{"text":"som när den törstige","poem":2},{"text":"drömmer att han dricker","poem":3},{"text":"men vaknar matt och törstig,","poem":2},{"text":"så ska det gå med alla de folk","poem":3},{"text":"som drog ut i strid mot Sions berg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Häpna och förundras,","poem":1},{"text":"stirra er blinda och var blinda!","poem":3},{"text":"De är druckna men inte av vin,","poem":2},{"text":"de raglar","poem":3},{"text":"men inte av starka drycker.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"För Herren har utgjutit över er","poem":1},{"text":"en ande med djup sömn.","poem":3},{"text":"Han har slutit era ögon,","poem":2},{"text":"profeterna,","poem":3},{"text":"och täckt över era huvuden,","poem":2},{"text":"siarna.","poem":3},{"noteId":168}]},{"type":"line_break"},{"type":"verse","number":11,"content":["All uppenbarelse har för er blivit som orden i en förseglad",{"noteId":169},"bokrulle. Räcker man en sådan bokrulle till någon som kan läsa och säger: \"Läs det\", så svarar han: \"Jag kan inte, den är ju förseglad.\""]},{"type":"verse","number":12,"content":["Och räcker man den till någon som inte kan läsa och säger: \"Läs det\", så svarar han: \"Jag kan inte läsa.\""]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Herren har sagt:","poem":1},{"text":"Detta folk kommer nära","poem":2},{"text":"med sin mun","poem":4},{"text":"och ärar mig med sina läppar,","poem":3},{"text":"men håller sitt hjärta","poem":2},{"text":"långt ifrån mig.","poem":3},{"text":"Därför är deras vördnad för mig","poem":2},{"text":"bara ett inlärt människobud.","poem":3},{"noteId":170}]},{"type":"verse","number":14,"content":[{"text":"Se, därför ska jag än en gång","poem":1},{"text":"göra underbara ting med detta folk,","poem":2},{"text":"underbara och förunderliga.","poem":3},{"text":"De visas vishet ska förgå,","poem":2},{"text":"de förståndigas förstånd","poem":3},{"text":"ska förmörkas.","poem":4},{"noteId":171}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ve dem som går ner i djupen","poem":1},{"text":"för att dölja sina planer","poem":2},{"text":"för Herren,","poem":3},{"text":"som gör sina gärningar i mörkret","poem":2},{"text":"och säger: \"Vem ser oss?","poem":3},{"text":"Vem känner oss?\"","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Hur bakvända är ni inte!","poem":1},{"text":"Ska leran anses lika","poem":2},{"text":"med krukmakaren?","poem":3},{"text":"Ska verket säga om sin mästare:","poem":2},{"text":"\"Han har inte gjort mig\"?","poem":3},{"text":"Eller ska det formade säga","poem":2},{"text":"om honom som har format det:","poem":3},{"text":"\"Han förstår ingenting\"?","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Ännu en liten tid","poem":1},{"text":"och Libanon ska förvandlas","poem":2},{"text":"till ett bördigt fält,","poem":3},{"text":"och det bördiga fältet","poem":2},{"text":"ska räknas som vildmark.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Den dagen ska de döva","poem":1},{"text":"höra bokens ord","poem":3},{"text":"och de blindas ögon","poem":2},{"text":"se ur dunkel och mörker.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"De ödmjuka ska få","poem":1},{"text":"allt större glädje i Herren,","poem":3},{"text":"de fattigaste bland människor","poem":2},{"text":"ska fröjda sig i Israels Helige.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Det är förbi med de våldsamma,","poem":1},{"text":"det är slut med hånarna.","poem":3},{"text":"Alla som ville det onda utrotas,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"de som med sitt ord","poem":1},{"text":"fick människor att synda","poem":3},{"noteId":172},{"text":",","poem":3},{"text":"som snärjde den","poem":2},{"text":"som skulle skipa rätt i porten","poem":3},{"text":"och åsidosatte rätten","poem":2},{"text":"för den rättfärdige med lögn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Därför säger Herren så","poem":1},{"text":"till Jakobs hus,","poem":4},{"text":"han som befriade Abraham:","poem":3},{"text":"Jakob ska inte mer behöva blygas,","poem":2},{"text":"hans ansikte","poem":3},{"text":"ska inte längre blekna,","poem":4}]},{"type":"verse","number":23,"content":[{"text":"för när han, alltså hans barn,","poem":1},{"text":"ser mina händers verk ibland sig","poem":3},{"noteId":173},{"text":",","poem":3},{"text":"kommer de att","poem":2},{"text":"hålla mitt namn heligt.","poem":3},{"text":"De kommer att","poem":2},{"text":"hålla Jakobs Helige helig","poem":3},{"text":"och bäva för Israels Gud.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"De som gått vilse i anden","poem":1},{"text":"ska få förstånd,","poem":3},{"text":"de som klagar","poem":2},{"text":"ska ta emot undervisning.","poem":3}]}],"footnotes":[{"noteId":164,"caller":"-","text":"Arielkan översättas \"altarhärd\" (syftar på Jerusalems tempel, jfr Hes 43:15). Ordet kan också översättas \"Guds lejon\".","reference":{"chapter":29,"verse":1}},{"noteId":165,"caller":"-","text":"slog upp sitt lägerAnnan översättning: \"belägrade\" (när han intog staden, 2 Sam 5:6).","reference":{"chapter":29,"verse":1}},{"noteId":166,"caller":"-","text":"runt omkring digAndra handskrifter (så Septuaginta): \"som David omkring dig\".","reference":{"chapter":29,"verse":3}},{"noteId":167,"caller":"-","text":"dina många fienderAndra handskrifter (Qumran, Septuaginta): \"dina många stolta\".","reference":{"chapter":29,"verse":5}},{"noteId":168,"caller":"-","text":"Citeras av Paulus i Rom 11:8.","reference":{"chapter":29,"verse":10}},{"noteId":169,"caller":"-","text":"försegladFörsedd med sigill för att öppnas av den rätte mottagaren (jfr Upp 5).","reference":{"chapter":29,"verse":11}},{"noteId":170,"caller":"-","text":"bara ett inlärt människobudAnnan översättning (Septuaginta): \"meningslös, för de lär ut människobud\". Citeras så av Jesus i Matt 15:8f och Mark 7:6 i mötet med fariseerna.","reference":{"chapter":29,"verse":13}},{"noteId":171,"caller":"-","text":"Citeras av Paulus i 1 Kor 1:19 i skildringen av Guds frälsningsplan.","reference":{"chapter":29,"verse":14}},{"noteId":172,"caller":"-","text":"syndaAnnan översättning: \"stå som syndare\" (inför domstolen).","reference":{"chapter":29,"verse":21}},{"noteId":173,"caller":"-","text":"han, alltså hans barn, ser mina händers verk ibland sigAnnan översättning: \"han ser sina barn, mina händers verk, hos sig\". Orden \"ibland sig\" kan också översättas \"inom sig\".","reference":{"chapter":29,"verse":23}}]},"thisChapterLink":"/api/swe_fol/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}