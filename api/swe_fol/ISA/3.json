{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Straffdom över Juda och Jerusalem"]},{"type":"verse","number":1,"content":["Se, Herren Gud Sebaot",{"text":"ska ta ifrån Jerusalem och Juda","poem":3},{"text":"både stöd och tillgång –","poem":2},{"text":"all tillgång på bröd,","poem":3},{"text":"all tillgång på vatten,","poem":4}]},{"type":"verse","number":2,"content":[{"text":"hjältar och krigsmän,","poem":1},{"text":"domare och profeter,","poem":2},{"text":"spåmän och äldste,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"underbefäl och högt uppsatta män,","poem":1},{"text":"rådgivare och hantverksskickliga","poem":2},{"text":"och besvärjelsekunniga.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag ska ge dem pojkar till furstar,","poem":1},{"text":"nyckfullhet ska råda över dem.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Av folket ska","poem":1},{"text":"den ene förtrycka den andre,","poem":2},{"text":"var och en sin nästa.","poem":3},{"text":"Den unge ska sätta sig upp","poem":2},{"text":"mot den gamle,","poem":3},{"text":"den obetydlige","poem":2},{"text":"mot den högt ansedde.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"När någon tar tag i sin bror","poem":1},{"text":"i sin fars hus och säger:","poem":3},{"text":"\"Du äger en mantel, bli vår ledare","poem":2},{"text":"och ta hand om denna ruinhög!\"","poem":3}]},{"type":"verse","number":7,"content":[{"text":"då ska han ropa:","poem":1},{"text":"\"Jag kan inte råda bot!","poem":3},{"text":"I mitt hus finns varken","poem":2},{"text":"bröd eller mantel.","poem":3},{"text":"Sätt inte mig till ledare för folket!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"För Jerusalem vacklar","poem":1},{"text":"och Juda faller,","poem":3},{"text":"därför att de i ord och gärningar","poem":2},{"text":"står emot Herren,","poem":3},{"text":"upproriska mot","poem":2},{"text":"hans härlighets ögon.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Deras uppsyn","poem":1},{"noteId":18},{"text":"vittnar mot dem.","poem":1},{"text":"Liksom Sodoms folk","poem":2},{"text":"visar de sina synder öppet","poem":3},{"text":"och döljer dem inte.","poem":4},{"text":"Ve över deras själar,","poem":2},{"text":"för de har själva","poem":3},{"text":"berett sig olycka.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Säg till den rättfärdige","poem":1},{"text":"att det ska gå honom väl,","poem":3},{"text":"för de får äta sina gärningars frukt.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Men ve över den ogudaktige!","poem":1},{"text":"Honom ska det gå illa,","poem":2},{"text":"han ska få igen","poem":3},{"text":"för sina gärningar.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Mitt folks förtryckare är barn,","poem":1},{"text":"och kvinnor","poem":3},{"noteId":19},{"text":"härskar över det.","poem":3},{"text":"O, mitt folk,","poem":2},{"text":"dina ledare för dig vilse","poem":3},{"text":"och fördärvar den väg du skulle gå.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Herren träder fram","poem":1},{"text":"för att gå till rätta,","poem":3},{"text":"han står upp för att döma folken","poem":2},{"noteId":20},{"text":".","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Herren håller rättegång","poem":1},{"text":"med sitt folks äldste","poem":3},{"text":"och dess furstar:","poem":4},{"text":"\"Ni har skövlat vingården.","poem":2},{"text":"Rov från de fattiga finns i era hus.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Vad menar ni","poem":1},{"text":"med att krossa mitt folk","poem":2},{"text":"och mala sönder de fattiga?\"","poem":3},{"text":"säger Herren Gud Sebaot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Och Herren sade:","poem":1},{"text":"Sions döttrar är högmodiga,","poem":3},{"text":"de går med rak hals","poem":2},{"text":"och flörtar med ögonen,","poem":3},{"text":"trippar och pinglar","poem":2},{"text":"med sina vristlänkar.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Därför ska Herren låta","poem":1},{"text":"Sions döttrar gå med kal hjässa","poem":3},{"noteId":21},{"text":",","poem":3},{"text":"Herren ska blotta deras nakenhet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":["På den dagen ska Herren ta bort allt det vackra: vristlänkar, pannband och halssmycken,"]},{"type":"verse","number":19,"content":["örhängen, armband och slöjor,"]},{"type":"verse","number":20,"content":["huvudprydnader, fotkedjor, bälten, parfymflaskor och amuletter,"]},{"type":"verse","number":21,"content":["fingerringar och näsringar,"]},{"type":"verse","number":22,"content":["högtidsdräkter, kappor, mantlar och väskor,"]},{"type":"verse","number":23,"content":["speglar, fina linneskjortor, huvudbindlar och flor."]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Det ska bli stank i stället för väldoft,","poem":1},{"text":"rep i stället för bälte,","poem":4},{"text":"skalligt huvud","poem":2},{"text":"i stället för fint uppsatt hår,","poem":3},{"text":"skynke av säcktyg","poem":2},{"text":"i stället för högtidsmantel,","poem":3},{"text":"märken av brännjärn","poem":2},{"text":"i stället för skönhet.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Dina män ska falla för svärd","poem":1},{"text":"och dina hjältar i strid.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Sions portar ska klaga och sörja,","poem":1},{"text":"utblottad ska hon sitta","poem":2},{"text":"på marken.","poem":3}]}],"footnotes":[{"noteId":18,"caller":"-","text":"uppsynAnnan översättning: \"partiskhet\" (jfr 1:23).","reference":{"chapter":3,"verse":9}},{"noteId":19,"caller":"-","text":"är barn … kvinnorAnnan översättning (så Septuaginta): \"skinnar det … utsugare\".","reference":{"chapter":3,"verse":12}},{"noteId":20,"caller":"-","text":"folkenAndra handskrifter (Septuaginta): \"sitt folk\".","reference":{"chapter":3,"verse":13}},{"noteId":21,"caller":"-","text":"kal hjässaAnsågs skamligt för kvinnor (1 Kor 11:6). Förknippades med slaveri eller skabb.","reference":{"chapter":3,"verse":17}}]},"thisChapterLink":"/api/swe_fol/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}