{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["Lita på Herren och inte på Egypten"]},{"type":"verse","number":1,"content":["Ve de upproriska barnen!",{"text":"säger Herren.","poem":3},{"text":"De rådslår utan mig,","poem":2},{"text":"de sluter förbund","poem":3},{"text":"utan att min Ande är med,","poem":4},{"text":"så att de därigenom hopar","poem":2},{"text":"synd på synd.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"De drar ner till Egypten","poem":1},{"noteId":174},{"text":"utan att ha rådfrågat min mun,","poem":3},{"text":"för att söka skydd hos farao","poem":2},{"text":"och få tillflykt","poem":3},{"text":"under Egyptens skugga.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Faraos beskydd","poem":1},{"text":"ska bli er till skam,","poem":3},{"text":"tillflykten under Egyptens skugga","poem":2},{"text":"en förödmjukelse.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"För hans furstar var i Soan","poem":1},{"text":"och hans sändebud","poem":2},{"text":"kom ända till Hanes","poem":3},{"noteId":175},{"text":",","poem":3}]},{"type":"verse","number":5,"content":[{"text":"men alla ska skämmas","poem":1},{"text":"över ett folk","poem":2},{"text":"som inte kan hjälpa dem.","poem":3},{"text":"De är inte till hjälp eller nytta,","poem":2},{"text":"bara till skam och hån.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Profetia om djuren i Negev.","poem":1},{"text":"Genom farornas","poem":2},{"text":"och ångestens land","poem":3},{"text":"där lejon och lejonhonor","poem":2},{"text":"har sitt tillhåll,","poem":3},{"text":"där huggormar","poem":2},{"text":"och vajande giftormar","poem":3},{"noteId":176},{"text":"bor,","poem":3},{"text":"bär de sina rikedomar","poem":2},{"noteId":177},{"text":"på åsnors ryggar","poem":3},{"text":"och sina skatter","poem":2},{"text":"på kamelers pucklar,","poem":3},{"text":"till ett folk som inte kan hjälpa dem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"För Egyptens hjälp är förgäves","poem":1},{"text":"och till ingen nytta.","poem":3},{"text":"Därför kallar jag Egypten","poem":2},{"text":"\"Rahab","poem":3},{"noteId":178},{"text":"som inget uträttar\".","poem":3},{"noteId":179}]},{"type":"heading","content":["Faran i att förakta Guds ord"]},{"type":"verse","number":8,"content":[{"text":"Gå nu och skriv detta","poem":1},{"text":"på en tavla inför dem","poem":2},{"text":"och nerteckna det i en bok,","poem":3},{"text":"så att det bevaras","poem":2},{"text":"för kommande dagar,","poem":3},{"text":"alltid och för evigt.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"För det är ett upproriskt folk,","poem":1},{"text":"barn som ljuger,","poem":3},{"text":"barn som inte vill höra","poem":2},{"text":"Herrens undervisning","poem":3}]},{"type":"verse","number":10,"content":[{"text":"och som säger till siarna:","poem":1},{"text":"\"Sluta med era syner!\"","poem":3},{"text":"och till profeterna:","poem":2},{"text":"\"Profetera inte","poem":3},{"text":"det som är sant för oss!","poem":4},{"text":"Tala något smickrande till oss,","poem":2},{"text":"profetera något bedrägligt.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Vik av från vägen,","poem":1},{"text":"gå bort från stigen,","poem":3},{"text":"låt oss slippa se Israels Helige!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Därför säger Israels Helige:","poem":1},{"text":"\"Eftersom ni förkastar detta ord","poem":3},{"text":"och förtröstar på våld och list","poem":2},{"text":"och förlitar er på sådant,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ska denna missgärning bli för er","poem":1},{"text":"som en spricka i en hög mur,","poem":3},{"text":"som buktar ut mer och mer","poem":2},{"text":"tills muren plötsligt rasar","poem":3},{"text":"på ett ögonblick.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Den ska krossas som en lerkruka,","poem":1},{"text":"så skoningslöst att man inte","poem":2},{"text":"kan finna en skärva stor nog","poem":3},{"text":"för att hämta eld från eldstaden","poem":2},{"text":"eller ösa upp vatten ur dammen.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"För så säger Herren Gud,","poem":1},{"text":"Israels Helige:","poem":3},{"text":"\"Om ni vänder om och är stilla","poem":2},{"text":"blir ni frälsta.","poem":3},{"text":"Genom stillhet och tillit","poem":2},{"text":"blir ni starka.\"","poem":3},{"text":"Men ni vill inte.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ni säger:","poem":1},{"text":"\"Nej, vi tänker fly på hästar.\"","poem":2},{"text":"Därför ska ni också fly.","poem":3},{"text":"\"Vi ska rida i väg på snabba hästar.\"","poem":2},{"text":"Därför ska också era förföljare","poem":3},{"text":"vara snabba.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Tusen ska fly för en endas hot,","poem":1},{"text":"och för fem mäns hot","poem":2},{"text":"ska ni alla fly,","poem":3},{"text":"tills det som är kvar av er","poem":2},{"text":"är som en flaggstång","poem":3},{"text":"på en bergstopp,","poem":4},{"text":"som ett baner på en kulle.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Därför väntar Herren","poem":1},{"text":"på att få visa er nåd,","poem":3},{"text":"därför är han upphöjd","poem":2},{"text":"för att visa er barmhärtighet,","poem":3},{"text":"för Herren är en domens Gud.","poem":2},{"text":"Saliga är alla som väntar","poem":3},{"text":"på honom.","poem":4}]},{"type":"heading","content":["Herren ska välsigna sitt folk"]},{"type":"verse","number":19,"content":["O, du Sions folk, som bor i Jerusalem, gråt inte mer. Han ska förvisso förbarma sig över dig när du ropar. Så snart han hör din röst ska han svara dig."]},{"type":"verse","number":20,"content":["Herren ska ge dig nödens bröd och lidandets dryck, men sedan ska dina lärare",{"noteId":180},"inte längre vara dolda, utan dina ögon ska se dina lärare."]},{"type":"verse","number":21,"content":["Och vare sig du viker av åt höger eller vänster, så ska dina öron höra detta ord bakom dig: \"Här är vägen, gå på den.\""]},{"type":"verse","number":22,"content":["Silvret som dina snidade avgudabilder är överdragna med och guldet som dina gjutna avgudabilder är belagda med ska du då anse vara orent",{"noteId":181},". Du ska kasta bort det som något orent och säga till det: \"Bort härifrån!\"",{"noteId":182}]},{"type":"verse","number":23,"content":["Och han ska ge regn åt den säd du har sått i jorden, och markens gröda ska ge dig bröd som är rikligt och närande. Den dagen ska din boskap få beta på stora betesmarker."]},{"type":"verse","number":24,"content":["Oxarna och åsnorna, de som bearbetar jorden, ska äta saltad blandsäd som kastats med kastskovel och högaffel."]},{"type":"verse","number":25,"content":["På den stora slaktens dag, när tornen faller, ska bäckar med strömmande vatten flöda fram på alla höga berg och alla stora höjder."]},{"type":"verse","number":26,"content":["Månens ljus ska vara som solens och solens ljus ska vara sju gånger klarare, som ett sjufaldigt dagsljus, när den dag kommer då Herren förbinder sitt folks skador och helar såren efter slagen som det fått."]},{"type":"heading","content":["Dom över Assyrien"]},{"type":"verse","number":27,"content":[{"text":"Se, Herrens namn","poem":1},{"text":"kommer fjärran ifrån","poem":3},{"text":"med brinnande vrede","poem":2},{"text":"och med tunga rökmoln.","poem":3},{"text":"Hans läppar är fulla av harm,","poem":2},{"text":"hans tunga är","poem":3},{"text":"som förtärande eld.","poem":4}]},{"type":"verse","number":28,"content":[{"text":"Hans andedräkt är som en ström","poem":1},{"text":"som svämmar över","poem":2},{"text":"och når ända upp till halsen,","poem":3},{"text":"för han vill sålla hednafolken","poem":2},{"text":"i förintelsens såll","poem":3},{"text":"och lägga i folkens mun","poem":2},{"text":"ett betsel som leder dem vilse.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Då ska ni sjunga som under en natt","poem":1},{"text":"då man firar helig högtid,","poem":3},{"text":"och era hjärtan ska glädja sig","poem":2},{"text":"som när man under flöjtspel","poem":3},{"text":"tågar upp på Herrens berg,","poem":2},{"text":"upp till Israels klippa.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Och Herren ska låta höra","poem":1},{"text":"sin majestätiska röst","poem":3},{"text":"och visa hur hans arm drabbar","poem":2},{"text":"med vrede och harm,","poem":3},{"text":"med förtärande eldslåga,","poem":2},{"text":"storm och störtregn","poem":3},{"text":"och hagelstenar.","poem":4}]},{"type":"verse","number":31,"content":[{"text":"Inför Herrens röst","poem":1},{"text":"ska Assur gripas av skräck","poem":2},{"text":"när han slår honom med sin stav.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Och så ofta staven far fram","poem":1},{"text":"och Herren efter sitt beslut","poem":2},{"text":"låter den falla på honom,","poem":3},{"text":"ska det ljuda","poem":2},{"text":"av tamburiner och harpor.","poem":3},{"text":"Gång på gång ska han lyfta sin arm","poem":2},{"text":"för att strida mot honom.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"För en eldsgrop","poem":1},{"noteId":183},{"text":"är beredd sedan länge,","poem":3},{"text":"även för kungen","poem":2},{"text":"har den gjorts redo.","poem":3},{"text":"Den är djup och bred,","poem":2},{"text":"dess bål har eld och ved","poem":3},{"text":"i överflöd,","poem":4},{"text":"som en svavelström","poem":2},{"text":"ska Herrens Ande","poem":3},{"text":"sätta den i brand.","poem":4}]}],"footnotes":[{"noteId":174,"caller":"-","text":"drar ner till EgyptenKung Hiskia sökte hjälp mot Assyrien hos Egypten (31:1f, 36:6, 9).","reference":{"chapter":30,"verse":2}},{"noteId":175,"caller":"-","text":"Soan … HanesEgyptiska huvudstäder, i östra Nildeltat respektive 7 mil söder om Kairo.","reference":{"chapter":30,"verse":4}},{"noteId":176,"caller":"-","text":"vajande giftormarKanske kobror. Annan översättning: \"flygande serafer\" (jfr 14:29 med not).","reference":{"chapter":30,"verse":6}},{"noteId":177,"caller":"-","text":"bär de sina rikedomarFör att vinna egyptiernas gunst (jfr 1 Mos 43:11, 2 Kung 16:8).","reference":{"chapter":30,"verse":6}},{"noteId":178,"caller":"-","text":"RahabBetyder \"övermod\", ett symboliskt namn för Egypten (jfr Ps 87:4).","reference":{"chapter":30,"verse":7}},{"noteId":179,"caller":"-","text":"som inget uträttarAnnan översättning: \"den tillintetgjorda\".","reference":{"chapter":30,"verse":7}},{"noteId":180,"caller":"-","text":"dina lärareAnnan översättning: \"din lärare\" eller \"ditt höstregn\" (jfr vers 23).","reference":{"chapter":30,"verse":20}},{"noteId":181,"caller":"-","text":"något orentHebr. daváanvänds t ex om menstruationsblod (3 Mos 15:33, 20:18).","reference":{"chapter":30,"verse":22}},{"noteId":182,"caller":"-","text":"BortAndra handskrifter (Septuaginta): \"Avföring\".","reference":{"chapter":30,"verse":22}},{"noteId":183,"caller":"-","text":"eldsgropPå hebreiska tófeti Hinnomsdalen (Jer 7:31), som blev en bild för den eviga elden (Matt 5:22). Enligt historikern Diodoros brändes Nineves siste kung Sin-Shar-Ishkun levande i sitt palats vid stadens fall 612 f Kr (se Nah 3:18 med not).","reference":{"chapter":30,"verse":33}}]},"thisChapterLink":"/api/swe_fol/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}