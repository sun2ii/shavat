{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Herren kan rädda, inte Egypten"]},{"type":"verse","number":1,"content":["Ve dem som drar ner",{"text":"till Egypten för att få hjälp.","poem":3},{"text":"De förlitar sig på hästar","poem":2},{"text":"och förtröstar på vagnar","poem":3},{"text":"för att de är många,","poem":4},{"text":"och på ryttare","poem":2},{"text":"för att mängden är stor.","poem":3},{"text":"De vänder inte sin blick","poem":2},{"text":"till Israels Helige","poem":3},{"text":"och frågar inte efter Herren.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Men också han är vis","poem":1},{"text":"och låter olyckan komma,","poem":2},{"text":"han tar inte tillbaka sina ord.","poem":3},{"text":"Han reser sig mot de ondas hus","poem":2},{"text":"och mot hjälp från förbrytare.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"För egyptierna är människor","poem":1},{"text":"och inte Gud,","poem":3},{"text":"deras hästar är kött och inte ande.","poem":2},{"text":"Herren ska räcka ut sin hand,","poem":3},{"text":"och hjälparen ska vackla","poem":2},{"text":"och den hjälpte falla,","poem":3},{"text":"båda går under tillsammans.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"För så har Herren sagt till mig:","poem":1},{"text":"Liksom ett lejon ryter,","poem":3},{"text":"ett ungt lejon över sitt rov","poem":2},{"text":"när många herdar","poem":3},{"text":"samlas emot det,","poem":4},{"text":"och inte skräms av herdarnas rop","poem":3},{"text":"eller räds deras oväsen,","poem":4},{"text":"så ska Herren Sebaot komma ner","poem":2},{"text":"för att strida på Sions berg","poem":3},{"text":"och uppe på dess höjd.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Som fågeln breder ut sina vingar","poem":1},{"text":"ska Herren Sebaot beskydda","poem":2},{"text":"Jerusalem.","poem":3},{"text":"Han ska beskydda och hjälpa,","poem":2},{"text":"skona och rädda.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":["Vänd om till honom som ni så djupt har avfallit ifrån, ni Israels barn."]},{"type":"verse","number":7,"content":["För på den dagen ska var och en kasta bort sina avgudar av silver och avgudar av guld, som era händer har gjort åt er till synd."]},{"type":"verse","number":8,"content":["Assur ska falla",{"noteId":184},", men inte genom en mans svärd. Ett svärd som inte är en människas ska förtära honom. Han ska fly för svärd, och hans unga män ska bli slavar."]},{"type":"verse","number":9,"content":["Hans klippa ska förgås av skräck, och hans furstar ska förfärade fly för baneret. Så säger Herren, han som har sin eld på Sion och sin ugn i Jerusalem."]}],"footnotes":[{"noteId":184,"caller":"-","text":"Assur ska fallaTroligen vid Jerusalem 701 f Kr (37:36). Se Nahums bok för Nineves fall 612 f Kr.","reference":{"chapter":31,"verse":8}}]},"thisChapterLink":"/api/swe_fol/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}