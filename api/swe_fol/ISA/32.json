{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["Rättfärdighetens rike"]},{"type":"verse","number":1,"content":["Se, en kung ska regera",{"text":"i rättfärdighet,","poem":3},{"text":"furstar ska styra med rättvisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"En man ska vara som en tillflykt","poem":1},{"text":"i stormen,","poem":3},{"text":"som ett skydd mot störtskuren,","poem":2},{"text":"som vattenbäckar i en ödemark,","poem":3},{"text":"som skuggan av en väldig klippa","poem":2},{"text":"i ett törstigt land.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"De som har ögon att se med","poem":1},{"text":"ska inte vara förblindade,","poem":3},{"text":"de som har öron att höra med","poem":2},{"text":"ska lyssna.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"De obetänksammas hjärtan","poem":1},{"text":"ska förstå kunskap,","poem":3},{"text":"och de stammandes tunga","poem":2},{"text":"ska tala flytande och klart.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Dåren ska då inte mer kallas ädel,","poem":1},{"text":"girigbuken inte kallas generös.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"För en dåre talar dårskap,","poem":1},{"text":"hans hjärta gör det som är orätt,","poem":3},{"text":"så att han handlar ogudaktigt","poem":2},{"text":"och sprider villoläror","poem":3},{"text":"om Herren.","poem":4},{"text":"Han svälter ut den hungriges själ","poem":2},{"text":"och hindrar den törstige","poem":3},{"text":"från att dricka.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Girigbukens vapen är onda,","poem":1},{"text":"han tänker ut ondskefulla planer","poem":3},{"text":"för att fördärva de betryckta","poem":2},{"text":"med lögnaktiga ord","poem":3},{"text":"och den fattige","poem":2},{"text":"när han vädjar om rättvisa.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Men den ädle tänker ädla tankar,","poem":1},{"text":"han står fast vid det som är ädelt.","poem":2}]},{"type":"heading","content":["Dom och upprättelse"]},{"type":"verse","number":9,"content":[{"text":"Ni kvinnor som är så säkra,","poem":1},{"text":"res er upp och hör min röst!","poem":3},{"text":"Ni självsäkra döttrar,","poem":2},{"text":"lyssna till mina ord!","poem":3}]},{"type":"verse","number":10,"content":[{"text":"När dagar lagts till år ska ni darra,","poem":1},{"text":"ni som är så sorglösa,","poem":3},{"text":"för vinskörden uteblir,","poem":2},{"text":"ingen fruktskörd kommer mer.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Bäva, ni säkra,","poem":1},{"text":"darra, ni sorglösa,","poem":3},{"text":"lägg av era kläder och blotta er,","poem":2},{"text":"bär säcktyg runt era höfter!","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Slå er mot brösten och klaga","poem":1},{"text":"över de vackra fälten,","poem":2},{"text":"över de fruktbara vinstockarna,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"över mitt folks åkrar","poem":1},{"text":"där törne och tistel skjuter upp,","poem":3},{"text":"över glädjens alla boningar","poem":2},{"text":"i den yra staden.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"För palatset blir övergivet,","poem":1},{"text":"den folkrika staden lämnas öde.","poem":3},{"text":"Ofelhöjden","poem":2},{"noteId":185},{"text":"med tornet förvandlas","poem":2},{"text":"till grotthålor för evigt,","poem":3},{"text":"till glädje för vildåsnor","poem":2},{"text":"och bete för hjordar –","poem":3}]},{"type":"verse","number":15,"content":[{"text":"tills Anden från höjden","poem":1},{"text":"blir utgjuten över oss","poem":3},{"text":"och öknen blir ett bördigt fält,","poem":2},{"text":"och det bördiga fältet","poem":3},{"text":"räknas som skog.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Då ska rätten ta sin boning i öknen,","poem":1},{"text":"rättfärdigheten bo","poem":2},{"text":"på det bördiga fältet.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Rättfärdighetens frukt","poem":1},{"text":"ska vara frid,","poem":3},{"text":"och rättfärdighetens verk","poem":2},{"text":"vara ro och trygghet för evigt.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Mitt folk ska bo i fridfulla hem,","poem":1},{"text":"i trygga boningar","poem":2},{"text":"och på säkra viloplatser.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Men hagel ska falla när skogen fälls,","poem":1},{"text":"och staden ska bli","poem":2},{"text":"djupt ödmjukad.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Lyckliga är ni","poem":1},{"text":"som kan så vid alla vatten","poem":3},{"text":"och låta oxen och åsnan","poem":2},{"text":"fritt ströva omkring.","poem":3}]}],"footnotes":[{"noteId":185,"caller":"-","text":"OfelhöjdenÅs söder om tempelberget där Jerusalems äldsta delar är byggda.","reference":{"chapter":32,"verse":14}}]},"thisChapterLink":"/api/swe_fol/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}