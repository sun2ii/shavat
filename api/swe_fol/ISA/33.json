{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Assyriens fall och Sions räddning"]},{"type":"verse","number":1,"content":["Ve dig, du härjare",{"text":"som själv inte har härjats,","poem":3},{"text":"du förrädare","poem":2},{"text":"som själv inte blivit förrådd!","poem":3},{"text":"När du är färdig med att härja","poem":2},{"text":"ska du själv bli härjad,","poem":3},{"text":"när du har slutat förråda","poem":2},{"text":"ska du själv bli förrådd.","poem":3},{"noteId":186}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, förbarma dig över oss,","poem":1},{"text":"vi hoppas på dig.","poem":3},{"text":"Bli du vår","poem":2},{"noteId":187},{"text":"arm var morgon,","poem":2},{"text":"vår frälsning i nödens tid.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"För det väldiga dånet flyr folken,","poem":1},{"text":"inför ditt majestät","poem":2},{"text":"skingras folkslagen.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Man ska förse sig med byte från er,","poem":1},{"text":"som när gräsmaskar förser sig.","poem":3},{"text":"Så som gräshoppor störtar fram","poem":2},{"text":"kastar han sig över det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Upphöjd är Herren,","poem":1},{"text":"för han bor i höjden.","poem":3},{"text":"Han uppfyller Sion med rätt","poem":2},{"text":"och rättfärdighet.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han ska vara","poem":1},{"text":"din framtids säkra grund,","poem":3},{"text":"rik på frälsning,","poem":2},{"text":"vishet och kunskap.","poem":3},{"text":"Fruktan för Herren ska vara","poem":2},{"text":"Sions skatt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hör, deras hjältar klagar därute,","poem":1},{"text":"fredsbudbärarna gråter bittert.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vägarna är öde,","poem":1},{"text":"ingen går mer på stigarna.","poem":3},{"text":"Han bryter fördrag, föraktar städer","poem":2},{"noteId":188},{"text":",","poem":2},{"text":"tar ingen hänsyn till människor.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Landet sörjer och försmäktar,","poem":1},{"text":"Libanon blygs och tynar bort,","poem":2},{"text":"Saron har blivit lik en ödemark,","poem":3},{"text":"Bashans och Karmels skogar","poem":2},{"noteId":189},{"text":"fäller sina löv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Nu vill jag stå upp, säger Herren,","poem":1},{"text":"nu vill jag resa mig,","poem":2},{"text":"nu vill jag visa min höghet.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Med halm går ni havande,","poem":1},{"text":"och ni föder strå.","poem":3},{"text":"Er ande är en eld","poem":2},{"text":"som kommer att förtära er.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Folken ska förbrännas till kalk,","poem":1},{"text":"likt avhugget törne","poem":2},{"text":"ska de brännas upp i eld.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ni som är långt borta,","poem":1},{"text":"hör vad jag har gjort.","poem":3},{"text":"Ni som är nära,","poem":2},{"text":"lär känna min makt.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Syndarna i Sion blir förskräckta,","poem":1},{"text":"bävan griper de gudlösa.","poem":3},{"text":"\"Vem av oss kan härda ut","poem":2},{"text":"vid en förtärande eld?","poem":3},{"text":"Vem av oss kan bo","poem":2},{"text":"vid en evig glöd?\"","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Den som vandrar i rättfärdighet","poem":1},{"text":"och talar vad rätt är,","poem":3},{"text":"den som föraktar","poem":2},{"text":"det som vinns genom förtryck","poem":3},{"text":"och som avhåller sina händer","poem":2},{"text":"från att ta mutor,","poem":3},{"text":"den som stoppar till sina öron","poem":2},{"text":"för att inte höra","poem":3},{"text":"om blodsgärningar","poem":4},{"text":"och sluter sina ögon","poem":2},{"text":"för att inte se det onda,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"han ska bo på höjderna,","poem":1},{"text":"klippfästen ska vara hans värn.","poem":3},{"text":"Sitt bröd ska han få,","poem":2},{"text":"vatten ska aldrig fattas honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"En kung i sin skönhet","poem":1},{"text":"ska dina ögon se,","poem":3},{"text":"de ska blicka ut","poem":2},{"text":"över ett vidsträckt land.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Då ska ditt hjärta tänka tillbaka","poem":1},{"text":"på skräckens tid:","poem":3},{"text":"\"Var är nu skrivarna,","poem":2},{"text":"var är skatteindrivarna,","poem":3},{"text":"var är de som räknade tornen?\"","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Du slipper då se det vildsinta folket,","poem":1},{"text":"folket med obegripligt språk","poem":2},{"text":"som ingen kunde förstå,","poem":3},{"text":"vars stammande tungomål","poem":2},{"text":"ingen kunde tyda.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Se på Sion, våra högtiders stad!","poem":1},{"text":"Dina ögon ska skåda Jerusalem,","poem":2},{"text":"en säker boning,","poem":4},{"text":"ett tält som inte flyttas bort.","poem":3},{"text":"Dess tältpinnar","poem":2},{"text":"ska aldrig ryckas upp,","poem":3},{"text":"och av dess tältlinor","poem":2},{"text":"ska ingen enda brista,","poem":3}]},{"type":"verse","number":21,"content":[{"text":"för Herren ska vara där","poem":1},{"text":"i sitt majestät.","poem":3},{"text":"Han ska vara för oss","poem":2},{"text":"som floder och breda strömmar.","poem":3},{"text":"Inget skepp med åror","poem":2},{"text":"ska där gå fram,","poem":3},{"text":"inget mäktigt skepp","poem":2},{"text":"färdas däröver,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"för Herren är vår domare,","poem":1},{"text":"Herren är vår lagstiftare,","poem":2},{"text":"Herren är vår kung.","poem":3},{"text":"Han är den som frälser oss.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Dina tåg hänger slaka,","poem":1},{"text":"de håller inte masten stadig,","poem":2},{"text":"seglet är inte spänt.","poem":3},{"text":"Då ska mycket rövat gods utskiftas,","poem":2},{"text":"även de lama ska då ta byte.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Och ingen av invånarna ska säga:","poem":1},{"text":"\"Jag är sjuk.\"","poem":3},{"text":"Folket som bor där","poem":2},{"text":"har fått sin synd förlåten.","poem":3}]}],"footnotes":[{"noteId":186,"caller":"-","text":"härjareEn av de assyriska kungarna, sannolikt Sanherib (705-681 f Kr, kap 36-37).","reference":{"chapter":33,"verse":1}},{"noteId":187,"caller":"-","text":"vårAndra handskrifter: \"deras\".","reference":{"chapter":33,"verse":2}},{"noteId":188,"caller":"-","text":"städerAndra handskrifter (Qumran): \"vittnen\".","reference":{"chapter":33,"verse":8}},{"noteId":189,"caller":"-","text":"Libanon … Saron … Bashans och Karmels skogarBördiga områden i Israels utkanter åt norr, väster, nordost och nordväst.","reference":{"chapter":33,"verse":9}}]},"thisChapterLink":"/api/swe_fol/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}