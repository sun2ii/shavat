{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Guds dom över Edom och världen"]},{"type":"verse","number":1,"content":["Träd fram, ni folk, och hör,",{"text":"lyssna, ni folkslag!","poem":3},{"text":"Jorden och allt den rymmer","poem":2},{"text":"ska höra,","poem":3},{"text":"världen och allt som växer där.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"För Herrens vrede riktas","poem":1},{"text":"mot alla hednafolk,","poem":3},{"text":"hans harm","poem":2},{"text":"mot alla deras härskaror.","poem":3},{"text":"Han viger dem åt förintelse,","poem":2},{"text":"han utlämnar dem till slakt.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Deras slagna ska kastas bort,","poem":1},{"text":"stank stiger","poem":2},{"text":"från deras döda kroppar,","poem":3},{"text":"bergen flyter av deras blod.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Himlens hela härskara går under,","poem":1},{"text":"himlarna rullas ihop","poem":2},{"text":"som en bokrulle.","poem":3},{"text":"Hela dess härskara","poem":2},{"text":"faller förvissnad ner","poem":3},{"text":"som vissnade löv","poem":2},{"text":"från vinrankan,","poem":3},{"text":"som vissnade blad","poem":2},{"text":"från fikonträdet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"För mitt svärd","poem":1},{"text":"har druckit sig rusigt i himlen.","poem":3},{"text":"Se, det far ner över Edom,","poem":2},{"text":"över folket jag vigt åt förintelse","poem":3},{"text":"för att bli deras dom.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Herrens svärd dryper av blod,","poem":1},{"text":"det är dränkt i fett,","poem":3},{"text":"i lamms och bockars blod,","poem":2},{"text":"i talg från baggars njurar,","poem":3},{"text":"för Herren har ett offer i Bosra,","poem":2},{"text":"en stor slakt i Edoms","poem":3},{"noteId":190},{"text":"land.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Också vildoxar slaktas","poem":1},{"text":"liksom oxar och starka tjurar.","poem":3},{"text":"Deras land dricker sig rusigt","poem":2},{"text":"av blod,","poem":3},{"text":"deras jord blir dränkt av fett,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"för dagen kommer","poem":1},{"text":"för Herrens hämnd,","poem":3},{"text":"ett vedergällningens år","poem":2},{"text":"då han utför Sions sak.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Då förvandlas","poem":1},{"text":"Edoms bäckar till tjära","poem":3},{"text":"och dess jord till svavel,","poem":2},{"noteId":191},{"text":"dess land blir till brinnande tjära.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Varken natt eller dag","poem":1},{"text":"ska den branden slockna,","poem":3},{"text":"ständigt ska röken av den","poem":2},{"text":"stiga upp.","poem":3},{"text":"Från släkte till släkte","poem":2},{"text":"ska landet ligga öde,","poem":3},{"text":"aldrig i evighet","poem":2},{"text":"ska någon vandra där.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Pelikaner och hägrar","poem":1},{"text":"ska ta över det,","poem":4},{"text":"uvar och korpar bo där.","poem":3},{"text":"Han ska spänna linor och lod","poem":2},{"text":"över det","poem":3},{"text":"till förödelse och ödeläggelse.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Av dess ädlingar finns ingen kvar","poem":1},{"text":"som kan utropa någon till kung.","poem":3},{"text":"Alla dess furstar blir till intet.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dess palats fylls av törne,","poem":1},{"text":"nässlor och tistlar","poem":2},{"text":"växer i dess borgar.","poem":3},{"text":"Det blir en boning för ökenhundar,","poem":2},{"text":"ett tillhåll för strutsar.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Öknens djur möter där hyenor,","poem":1},{"text":"raggiga bockar","poem":2},{"text":"bräker till varandra.","poem":3},{"text":"Där kan tornugglan","poem":2},{"noteId":192},{"text":"slå sig till ro","poem":2},{"text":"och finna en viloplats åt sig.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Där ordnar pilormen","poem":1},{"noteId":193},{"text":"sitt bo","poem":1},{"text":"och lägger sina ägg,","poem":3},{"text":"kläcker ut ynglet och","poem":2},{"text":"samlar det i sitt beskydd.","poem":3},{"text":"Där samlas gamarna,","poem":2},{"text":"den ena efter den andra.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Sök i Herrens bok och läs!","poem":1},{"text":"Inte ett enda av dem ska utebli,","poem":2},{"text":"det ena ska inte sakna","poem":3},{"text":"det andra,","poem":4},{"text":"för det är hans mun","poem":2},{"text":"som befaller det","poem":3},{"text":"och hans Ande som samlar dem.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Det är han som kastar lott för dem,","poem":1},{"text":"hans hand tilldelar dem","poem":2},{"text":"deras mark med mätsnöre.","poem":3},{"text":"De ska ha den till besittning","poem":2},{"text":"för alltid,","poem":3},{"text":"de ska bo där från släkte till släkte.","poem":2}]}],"footnotes":[{"noteId":190,"caller":"-","text":"Bosra … EdomHuvudstad och rike söder om Döda havet (se profetian i 63:1f med not).","reference":{"chapter":34,"verse":6}},{"noteId":191,"caller":"-","text":"tjära … svavelPå liknande sätt gick Sodom under, strax norr om Edom (1 Mos 14:10, 19:24).","reference":{"chapter":34,"verse":9}},{"noteId":192,"caller":"-","text":"tornugglanHebr. lilít. I babylonisk och senare judisk mytologi var Lilit namnet på en kvinnlig demon. Sammanhanget talar här för en nattfågel (jfr vers 13-15, Ps 102:7, Sef 2:14).","reference":{"chapter":34,"verse":14}},{"noteId":193,"caller":"-","text":"pilormenGrundtexten svårtolkad. Annan översättning: \"ugglan\".","reference":{"chapter":34,"verse":15}}]},"thisChapterLink":"/api/swe_fol/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}