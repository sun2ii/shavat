{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Frälsningen – den heliga vägen"]},{"type":"verse","number":1,"content":["Öknen och ödemarken",{"text":"ska glädja sig,","poem":3},{"text":"hedmarken fröjda sig","poem":2},{"text":"och blomstra som en lilja.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Den ska blomstra skönt","poem":1},{"text":"och fröjda sig,","poem":2},{"text":"ja, fröjda sig och jubla.","poem":3},{"text":"Libanons härlighet ska den få,","poem":2},{"text":"Karmels och Sarons prakt.","poem":3},{"text":"De ska få se Herrens härlighet,","poem":2},{"text":"vår Guds majestät.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Stärk kraftlösa händer,","poem":1},{"text":"styrk vacklande knän.","poem":3},{"noteId":194}]},{"type":"verse","number":4,"content":[{"text":"Säg till oroliga hjärtan:","poem":1},{"text":"\"Var starka, var inte rädda!\"","poem":3},{"text":"Se, er Gud är här!","poem":2},{"text":"Han kommer med hämnd,","poem":3},{"text":"med vedergällning från Gud.","poem":4},{"text":"Han kommer själv och frälser er.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Då ska de blindas ögon öppnas","poem":1},{"text":"och de dövas öron upplåtas.","poem":3},{"noteId":195}]},{"type":"verse","number":6,"content":[{"text":"Den lame ska hoppa som en hjort,","poem":1},{"text":"den stummes tunga ska jubla,","poem":3},{"text":"för vatten ska bryta fram i öknen,","poem":2},{"text":"strömmar på hedmarken.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Den glödande sanden ska bli en sjö,","poem":1},{"text":"den torra marken","poem":2},{"text":"vattenrika källor.","poem":3},{"text":"Där schakalerna har sina lyor","poem":2},{"text":"ska det växa säv, vass","poem":3},{"text":"och papyrus.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"En banad väg ska gå där,","poem":1},{"text":"en vandringsled,","poem":3},{"text":"och den ska kallas","poem":2},{"text":"\"den heliga vägen\".","poem":3},{"text":"Ingen oren ska färdas på den,","poem":2},{"text":"men den är till för dem.","poem":3},{"noteId":196},{"text":"De som vandrar den vägen","poem":2},{"text":"ska inte gå vilse,","poem":3},{"text":"även om de är dårar.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Där ska inga lejon finnas,","poem":1},{"text":"inga rovdjur ska komma dit.","poem":3},{"text":"De ska inte finnas där,","poem":2},{"text":"men de återlösta ska färdas","poem":3},{"text":"på den.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Herrens friköpta ska vända tillbaka","poem":1},{"text":"och komma till Sion med jubel.","poem":3},{"text":"Evig glädje ska kröna","poem":2},{"text":"deras huvuden.","poem":3},{"text":"Fröjd och glädje ska de få,","poem":2},{"text":"sorg och suckan ska fly bort.","poem":3}]}],"footnotes":[{"noteId":194,"caller":"-","text":"Citeras i Hebr 12:12.","reference":{"chapter":35,"verse":3}},{"noteId":195,"caller":"-","text":"Nämns av Jesus som tecken på Messias ankomst i Matt 11:5 och Luk 7:22.","reference":{"chapter":35,"verse":5}},{"noteId":196,"caller":"-","text":"men den är till för demDen heliga vägen är \"till för dem\", dvs de \"orena\" som förklarats rena och rättfärdiga.","reference":{"chapter":35,"verse":8}}]},"thisChapterLink":"/api/swe_fol/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}