{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["Hiskias sjukdom"]},{"type":"verse","number":1,"content":["Vid den tiden",{"noteId":216},"blev Hiskia dödssjuk. Profeten Jesaja, Amos son, kom till honom och sade: \"Så säger Herren: Se om ditt hus, för du kommer att dö och ska inte tillfriskna.\""]},{"type":"verse","number":2,"content":["Då vände Hiskia sitt ansikte mot väggen och bad till Herren:"]},{"type":"verse","number":3,"content":["\"O, Herre, kom ihåg att jag har vandrat inför dig i trohet och med hängivet hjärta och gjort det som är gott i dina ögon.\" Och Hiskia grät mycket."]},{"type":"verse","number":4,"content":["Då kom Herrens ord till Jesaja. Han sade:"]},{"type":"verse","number":5,"content":["\"Gå och säg till Hiskia: Så säger Herren, din fader Davids Gud: Jag har hört din bön. Jag har sett dina tårar. Se, jag ska lägga femton år till din livstid."]},{"type":"verse","number":6,"content":["Jag ska också rädda dig och denna stad ur den assyriske kungens hand och beskydda denna stad."]},{"type":"verse","number":7,"content":["Detta ska vara tecknet för dig från Herren på att Herren ska göra vad han har sagt:"]},{"type":"verse","number":8,"content":["Se, jag ska låta skuggan på trappstegen gå tillbaka de tio steg som den har flyttat sig på Ahas trappa",{"noteId":217},"med solen.\" Solen gick då tillbaka de tio steg på trappan som den redan hade gått."]},{"type":"heading","content":["Hiskias lovsång"]},{"type":"verse","number":9,"content":["En sång skriven av Juda kung Hiskia, när han hade varit sjuk och blivit frisk från sin sjukdom igen:"]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jag sade:","poem":1},{"text":"I mina bästa dagar går jag in","poem":2},{"text":"genom dödsrikets portar,","poem":3},{"text":"jag blir fråntagen","poem":2},{"text":"resten av mina år.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Jag sade:","poem":1},{"text":"Jag får aldrig mer se Herren,","poem":2},{"text":"Herren i de levandes land.","poem":3},{"text":"Jag får aldrig mer se människor","poem":2},{"text":"hos dem som bor i världen","poem":3},{"noteId":218},{"text":".","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Min boning rycks upp","poem":1},{"text":"och flyttas ifrån mig","poem":2},{"text":"som en herdes tält.","poem":3},{"text":"Jag har vävt mitt liv till slut","poem":2},{"text":"som vävaren sin väv,","poem":3},{"text":"och han skär ner mig från bommen.","poem":2},{"text":"Innan dagen blivit natt","poem":3},{"noteId":219},{"text":"gör du slut på mig.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Jag ropar","poem":1},{"noteId":220},{"text":"ända till morgonen.","poem":1},{"text":"Som ett lejon","poem":2},{"text":"krossar han alla mina ben.","poem":3},{"text":"Innan dagen blivit natt","poem":2},{"text":"gör du slut på mig.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Jag låter som en svala,","poem":1},{"text":"som en trana,","poem":4},{"text":"jag kuttrar som en duva.","poem":3},{"text":"Mina matta ögon","poem":2},{"text":"ser längtansfullt mot höjden:","poem":3},{"text":"\"Herre, jag är betryckt.","poem":2},{"text":"Ta dig an min sak!\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Vad ska jag säga?","poem":1},{"text":"Han har både talat till mig","poem":2},{"text":"och själv utfört sitt verk.","poem":3},{"text":"Jag får vandra varsamt alla mina år","poem":2},{"text":"efter det bittra","poem":3},{"text":"min själ varit med om.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Herre, trots sådant","poem":1},{"text":"lever människor,","poem":3},{"text":"och genom allt sådant","poem":2},{"text":"hålls min ande vid liv.","poem":3},{"text":"Du gör mig frisk","poem":2},{"text":"och låter mig leva.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Se, den bittra plågan","poem":1},{"text":"blev till nytta för mig.","poem":3},{"text":"I din kärlek räddade du min själ","poem":2},{"text":"från förintelsens grop,","poem":3},{"text":"för du har kastat alla mina synder","poem":2},{"text":"bakom din rygg.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Dödsriket tackar dig inte,","poem":1},{"text":"döden prisar dig inte.","poem":3},{"text":"De som far ner i graven","poem":2},{"text":"hoppas inte på din trofasthet.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Den som lever,","poem":1},{"text":"den som lever tackar dig,","poem":2},{"text":"så som jag gör i dag.","poem":3},{"text":"En far gör din trofasthet känd","poem":2},{"text":"för barnen.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Herren ska frälsa mig,","poem":1},{"text":"och vi ska spela mina sånger","poem":2},{"text":"i alla våra livsdagar","poem":3},{"text":"i Herrens hus.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Jesaja sade att man skulle ta en fikonkaka och lägga den som plåster på bölden så att han blev frisk."]},{"type":"verse","number":22,"content":["Och Hiskia hade frågat: \"Vad är tecknet på att jag får gå upp till Herrens hus?\""]}],"footnotes":[{"noteId":216,"caller":"-","text":"Vid den tidenCa år 701 f Kr (jfr 2 Kung 18:2, 13, 20:6), någon gång före Sanheribs belägring (jfr vers 6).","reference":{"chapter":38,"verse":1}},{"noteId":217,"caller":"-","text":"Ahas trappaKanske en sorts solur (känt från Egypten redan på Moses tid).","reference":{"chapter":38,"verse":8}},{"noteId":218,"caller":"-","text":"världenAndra handskrifter: \"förgängelsen\".","reference":{"chapter":38,"verse":11}},{"noteId":219,"caller":"-","text":"Innan dagen blivit nattAnnan översättning: \"Dag och natt\".","reference":{"chapter":38,"verse":12}},{"noteId":220,"caller":"-","text":"roparAnnan översättning: \"håller mig lugn\".","reference":{"chapter":38,"verse":13}}]},"thisChapterLink":"/api/swe_fol/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}