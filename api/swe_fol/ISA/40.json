{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Herren tröstar sitt folk"]},{"type":"verse","number":1,"content":["Trösta, trösta mitt folk!",{"text":"säger er Gud.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Tala till Jerusalems hjärta","poem":1},{"text":"och förkunna för det","poem":3},{"text":"att dess vedermöda är slut,","poem":2},{"text":"att dess skuld är försonad,","poem":3},{"text":"och att det fått dubbelt igen","poem":2},{"text":"av Herrens hand","poem":3},{"text":"för alla sina synder.","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"En röst ropar i öknen:","poem":1},{"text":"\"Bana väg för Herren,","poem":3},{"text":"gör vägen rak i ödemarken","poem":2},{"text":"för vår Gud.","poem":3},{"noteId":224}]},{"type":"verse","number":4,"content":[{"text":"Varje dal ska höjas,","poem":1},{"text":"alla berg och höjder sänkas.","poem":3},{"text":"Ojämn mark ska jämnas,","poem":2},{"text":"kuperat land bli slät mark.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Herrens härlighet ska uppenbaras,","poem":1},{"text":"alla människor ska se det","poem":2},{"text":"tillsammans,","poem":3},{"text":"för Herrens mun har talat.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hör, någon säger: \"Predika!\"","poem":1},{"text":"Och en annan","poem":2},{"noteId":225},{"text":"svarar:","poem":2},{"text":"\"Vad ska jag predika?\"","poem":3},{"text":"\"Allt kött är gräs,","poem":2},{"text":"och all dess härlighet","poem":3},{"text":"som blomman på marken.","poem":4},{"noteId":226}]},{"type":"verse","number":7,"content":[{"text":"Gräset vissnar,","poem":1},{"text":"blomman faller av","poem":2},{"text":"när Herrens Ande blåser på det.","poem":3},{"text":"Ja, folket är gräs!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gräset vissnar,","poem":1},{"text":"blomman faller av,","poem":3},{"text":"men vår Guds ord består för evigt.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sion, du glädjens budbärarinna,","poem":1},{"text":"stig upp på ett högt berg.","poem":3},{"text":"Jerusalem,","poem":2},{"text":"du glädjens budbärarinna,","poem":3},{"noteId":227},{"text":"höj din röst med kraft!","poem":4},{"text":"Höj den utan fruktan,","poem":2},{"text":"säg till Juda städer:","poem":3},{"text":"\"Se er Gud!\"","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ja, Herren Gud kommer med kraft,","poem":1},{"text":"hans arm visar sin makt.","poem":3},{"text":"Se, han har med sig sin lön,","poem":2},{"text":"hans segerbyte","poem":3},{"text":"går framför honom.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Han vallar sin hjord som en herde,","poem":1},{"text":"han samlar lammen i sina armar","poem":3},{"text":"och bär dem i sin famn.","poem":4},{"text":"Sakta för han moderfåren fram.","poem":2}]},{"type":"heading","content":["Ingen kan liknas vid Gud"]},{"type":"verse","number":12,"content":[{"text":"Vem har mätt vattnen","poem":1},{"text":"i sin kupade hand","poem":3},{"text":"och mätt upp himlens vidd","poem":2},{"text":"med sina fingrar?","poem":3},{"text":"Vem har samlat jordens stoft","poem":2},{"text":"i ett mått,","poem":3},{"text":"vägt bergen på en våg","poem":2},{"text":"och höjderna i en vågskål?","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Vem har utforskat Herrens Ande?","poem":1},{"text":"Vem kan ge honom råd","poem":2},{"text":"och undervisa honom?","poem":3},{"noteId":228}]},{"type":"verse","number":14,"content":[{"text":"Vem rådfrågar han,","poem":1},{"text":"vem ska ge honom förstånd","poem":2},{"text":"och lära honom den rätta stigen,","poem":3},{"text":"lära honom kunskap","poem":2},{"text":"och visa honom förståndets väg?","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Se, folken är som en droppe","poem":1},{"text":"i en spann,","poem":3},{"text":"som ett dammkorn i en vågskål.","poem":2},{"text":"Kustländerna lyfter han","poem":3},{"text":"som ett stoftkorn.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Libanons skog","poem":1},{"text":"räcker inte till offerved,","poem":3},{"text":"dess djur inte till brännoffer.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Alla folk är som ingenting","poem":1},{"text":"inför honom,","poem":3},{"text":"mindre än noll och tomhet","poem":2},{"text":"anser han dem vara.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Vem vill ni likna Gud vid?","poem":1},{"text":"Vad vill ni jämföra honom med?","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hantverkaren gjuter en gudabild,","poem":1},{"text":"och guldsmeden belägger den","poem":2},{"text":"med guld","poem":3},{"text":"och smider silverkedjor.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Den som inte har råd","poem":1},{"text":"att offra så mycket","poem":3},{"text":"väljer ett stycke trä","poem":2},{"text":"som inte ruttnar.","poem":3},{"text":"Sedan söker han","poem":2},{"text":"en skicklig hantverkare","poem":3},{"text":"som kan forma en gudabild","poem":2},{"text":"som inte faller omkull.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Vet ni inte det?","poem":1},{"text":"Har ni inte hört?","poem":3},{"text":"Har det inte förkunnats för er","poem":2},{"text":"från begynnelsen?","poem":3},{"text":"Har ni inte förstått det","poem":2},{"text":"sedan jordens grund blev lagd?","poem":3}]},{"type":"verse","number":22,"content":[{"text":"För honom som tronar","poem":1},{"text":"över jordens rund","poem":2},{"text":"är dess invånare som gräshoppor.","poem":3},{"text":"Han breder ut himlen som ett flor,","poem":2},{"text":"spänner ut den som ett tält","poem":3},{"text":"att bo under.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"Han gör furstar till intet,","poem":1},{"text":"förvandlar jordens domare","poem":2},{"text":"till tomhet.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Knappt är de planterade,","poem":1},{"text":"knappt är de sådda,","poem":3},{"text":"knappt har deras stam","poem":2},{"text":"slagit rot i jorden,","poem":3},{"text":"så blåser han på dem","poem":2},{"text":"och de förtorkar,","poem":3},{"text":"och en stormvind","poem":2},{"text":"för bort dem som strå.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Vem vill ni då likna mig vid,","poem":1},{"text":"vem är min like?","poem":2},{"text":"säger den Helige.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Lyft blicken mot höjden och se:","poem":1},{"text":"Vem har skapat allt detta?","poem":3},{"text":"Det är han som för fram härskaran","poem":2},{"text":"däruppe i räknade skaror.","poem":3},{"text":"Med sin stora makt","poem":2},{"text":"och sin väldiga kraft","poem":3},{"text":"nämner han dem alla vid namn –","poem":2},{"text":"ingen enda uteblir.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Hur kan du Jakob säga,","poem":1},{"text":"du Israel påstå:","poem":3},{"text":"\"Min väg är dold för Herren,","poem":2},{"text":"Gud bryr sig inte om min rätt\"?","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Vet du inte? Har du inte hört","poem":1},{"text":"att Herren är en evig Gud","poem":2},{"text":"som har skapat jordens ändar?","poem":3},{"text":"Han blir inte trött och mattas inte,","poem":2},{"text":"hans förstånd kan inte utforskas.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Han ger den trötte kraft","poem":1},{"text":"och ökar den maktlöses styrka.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Ynglingar kan bli trötta och ge upp,","poem":1},{"text":"unga män kan falla.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Men de som hoppas på Herren","poem":1},{"text":"får ny kraft,","poem":3},{"text":"de lyfter med vingar som örnar.","poem":2},{"lineBreak":true},{"text":"De springer utan att mattas,","poem":2},{"text":"de vandrar utan att bli trötta.","poem":3}]}],"footnotes":[{"noteId":224,"caller":"-","text":"Citeras i Luk 3:4f, Matt 3:3, Mark 1:3 och Joh 1:23 som profetia om Johannes Döparen.","reference":{"chapter":40,"verse":3}},{"noteId":225,"caller":"-","text":"en annanJesajarullen från Qumran och Septuaginta: \"jag\".","reference":{"chapter":40,"verse":6}},{"noteId":226,"caller":"-","text":"Citeras av Petrus i 1 Petr 1:24f.","reference":{"chapter":40,"verse":6}},{"noteId":227,"caller":"-","text":"Sion … Jerusalem, du glädjens budbärarinnaAnnan översättning: \"Du som bär glädjebud till Sion/Jerusalem\".","reference":{"chapter":40,"verse":9}},{"noteId":228,"caller":"-","text":"Citeras av Paulus i Rom 11:34 och 1 Kor 2:16.","reference":{"chapter":40,"verse":13}}]},"thisChapterLink":"/api/swe_fol/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}