{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Herren eller avgudarna"]},{"type":"verse","number":1,"content":["Var tysta inför mig,",{"text":"ni kustländer.","poem":3},{"text":"Låt folken hämta ny kraft,","poem":2},{"text":"låt dem komma fram","poem":3},{"text":"och sedan tala.","poem":4},{"text":"Låt oss tillsammans","poem":2},{"text":"träda inför rätta.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Vem har i öster uppväckt honom","poem":1},{"text":"som möts av rättfärdighet?","poem":3},{"text":"Vem ger folk i hans våld","poem":2},{"text":"och gör honom till härskare","poem":3},{"text":"över kungar?","poem":4},{"text":"Vem gör dem till stoft","poem":2},{"text":"för hans svärd,","poem":3},{"text":"till bortblåst halm för hans båge?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Han förföljer dem","poem":1},{"text":"och går trygg fram,","poem":3},{"text":"på vägar där hans fötter aldrig gått.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vem har planerat och utfört detta?","poem":1},{"text":"Det är han som från begynnelsen","poem":2},{"text":"kallade fram människors släkten.","poem":3},{"text":"Jag, Herren, är den förste","poem":2},{"text":"och hos de sista. Jag Är.","poem":3},{"noteId":229}]},{"type":"verse","number":5,"content":[{"text":"Havsländerna ser det och bävar,","poem":1},{"text":"jordens ändar darrar.","poem":3},{"text":"De närmar sig och kommer.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Den ene vill hjälpa den andre","poem":1},{"text":"och säger till honom: \"Var stark!\"","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Hantverkaren styrker guldsmeden,","poem":1},{"text":"bleckslagaren","poem":2},{"text":"den som hamrar på städet.","poem":3},{"text":"Han säger om lödningen:","poem":2},{"text":"\"Den är bra!\"","poem":3},{"text":"och nitar fast avguden","poem":2},{"text":"så att den inte faller omkull.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Men du Israel, min tjänare,","poem":1},{"text":"du Jakob som jag utvalt,","poem":2},{"text":"du ättling till Abraham, min vän!","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Jag har hämtat dig","poem":1},{"text":"från jordens ändar,","poem":3},{"text":"kallat dig från dess yttersta hörn","poem":2},{"text":"och sagt till dig:","poem":3},{"text":"\"Du är min tjänare,","poem":2},{"text":"dig har jag utvalt","poem":3},{"text":"och inte förkastat.\"","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Var inte rädd, för jag är med dig,","poem":1},{"text":"se dig inte ängsligt om,","poem":2},{"text":"för jag är din Gud.","poem":3},{"text":"Jag styrker dig, jag hjälper dig,","poem":2},{"text":"jag stöder dig","poem":3},{"text":"med min rättfärdighets högra hand.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Se, alla som hatar dig","poem":1},{"text":"ska få skämmas och blygas.","poem":3},{"text":"Dina motståndare ska bli till intet","poem":2},{"text":"och förgås.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Du ska söka efter dina motståndare","poem":1},{"text":"men inte finna dem.","poem":3},{"text":"De som strider mot dig","poem":2},{"text":"ska gå under och bli till intet,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"för jag är Herren din Gud","poem":1},{"text":"som tar din högra hand","poem":2},{"text":"och säger till dig:","poem":3},{"text":"Var inte rädd, jag hjälper dig.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Var inte rädd, du mask Jakob,","poem":1},{"text":"ni Israels män.","poem":3},{"text":"Jag hjälper dig, säger Herren.","poem":2},{"text":"Israels Helige är din återlösare","poem":3},{"noteId":230},{"text":".","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Se, jag gör dig till en ny trösksläde","poem":1},{"text":"med skarpa taggar.","poem":3},{"text":"Du ska tröska sönder berg","poem":2},{"text":"och krossa dem till stoft","poem":3},{"text":"och göra höjder till agnar.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Du ska kasta dem med kastskovel","poem":1},{"noteId":231},{"text":",","poem":1},{"text":"och vinden ska föra bort dem","poem":2},{"text":"och stormen skingra dem.","poem":3},{"text":"Och själv ska du jubla i Herren,","poem":2},{"text":"ha din ära i Israels Helige.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"De svaga och fattiga","poem":1},{"text":"söker efter vatten,","poem":3},{"text":"men det finns inget,","poem":2},{"text":"deras tunga torkar av törst.","poem":3},{"text":"Men jag, Herren, ska bönhöra dem,","poem":2},{"text":"Israels Gud ska inte överge dem.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Jag ska låta strömmar","poem":1},{"text":"rinna upp på höjderna","poem":2},{"text":"och källor i dalarna.","poem":3},{"text":"Jag ska göra öknen till sjö","poem":2},{"text":"och torrt land till källsprång.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Jag ska sätta cedrar och akacieträd","poem":1},{"text":"i öknen, med myrten och olivträd.","poem":3},{"text":"På hedmarken","poem":2},{"text":"ska jag plantera cypress","poem":3},{"text":"med alm","poem":4},{"noteId":232},{"text":"och buxbom,","poem":4}]},{"type":"verse","number":20,"content":[{"text":"för att man tillsammans","poem":1},{"text":"ska se och veta,","poem":3},{"text":"betänka och förstå","poem":4},{"text":"att Herrens hand har gjort det,","poem":2},{"text":"att Israels Helige har skapat det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"För fram er sak, säger Herren,","poem":1},{"text":"kom med era bevis,","poem":2},{"text":"säger Jakobs Kung.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Låt dem komma och berätta för oss","poem":1},{"text":"vad som ska ske.","poem":3},{"text":"Var finns era tidigare utsagor?","poem":2},{"text":"Lägg fram dem,","poem":3},{"text":"så ska vi studera dem","poem":2},{"text":"och se hur de har uppfyllts.","poem":3},{"text":"Eller låt oss höra","poem":2},{"text":"vad som ska komma,","poem":3}]},{"type":"verse","number":23,"content":[{"text":"tala om vad som ska hända","poem":1},{"text":"i framtiden så att vi ser","poem":2},{"text":"att ni är gudar.","poem":3},{"text":"Gör något, vad som helst,","poem":2},{"text":"så att vi alla häpnar när vi ser det!","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Men se, ni är mindre än noll,","poem":1},{"text":"ert verk är ingenting alls.","poem":3},{"text":"Den som väljer er är avskyvärd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Jag har låtit en man uppstå i norr,","poem":1},{"text":"och han kommer från öster.","poem":2},{"text":"Han ska åkalla mitt namn.","poem":3},{"text":"Han ska gå fram över de styrande","poem":2},{"text":"som över lerjord,","poem":3},{"text":"lik en krukmakare","poem":2},{"text":"som trampar lera.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Vem talade om det från begynnelsen","poem":1},{"text":"så att vi fick veta det,","poem":3},{"text":"eller i förväg så att vi kunde säga:","poem":2},{"text":"\"Han har rätt\"?","poem":3},{"text":"Det fanns ingen som talade om det,","poem":2},{"text":"ingen som lät oss höra det,","poem":3},{"text":"ingen som hörde er tala om det.","poem":4}]},{"type":"verse","number":27,"content":[{"text":"Jag är den förste som säger till Sion:","poem":1},{"text":"\"Se, där är de!\",","poem":3},{"text":"jag ger Jerusalem","poem":2},{"text":"en glädjebudbärare.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Jag ser mig om,","poem":1},{"text":"men här finns ingen.","poem":3},{"text":"Av dessa kan ingen ge besked,","poem":2},{"text":"ingen ge ett svar på min fråga.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Se, de är alla förgängliga,","poem":1},{"text":"deras verk är ingenting,","poem":3},{"text":"deras avgudabilder","poem":2},{"text":"är vind och tomhet.","poem":3}]}],"footnotes":[{"noteId":229,"caller":"-","text":"Jag ÄrGuds auktoritativa aní hu (grek. egó eimi), som upprepas gång på gång hos Jesaja (t ex 43:10, 13, 46:4, 48:12), plockas senare upp av Jesus (Mark 6:50, 14:62, Joh 4:26, 8:24f etc). Kan också översättas \"Jag är densamme\" (jfr Heb 1:12, 13:8).","reference":{"chapter":41,"verse":4}},{"noteId":230,"caller":"-","text":"återlösareSläkting med uppgift att hjälpa sina släktingar ur slaveri etc (jfr Rut 2:20 med not).","reference":{"chapter":41,"verse":14}},{"noteId":231,"caller":"-","text":"kastskovelSpade för att rensa ut agnarna från vetet (se Matt 3:12 med not).","reference":{"chapter":41,"verse":16}},{"noteId":232,"caller":"-","text":"almAnnan översättning: \"platan\", ett lönnliknande träd i Medelhavsområdet.","reference":{"chapter":41,"verse":19}}]},"thisChapterLink":"/api/swe_fol/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}