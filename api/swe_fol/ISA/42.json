{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Herrens tjänare"]},{"type":"verse","number":1,"content":["Se, min tjänare som jag stöder,",{"text":"min utvalde som min själ","poem":2},{"text":"glädjer sig över.","poem":3},{"text":"Jag har sänt min Ande","poem":2},{"text":"över honom.","poem":3},{"text":"Han ska utbreda rätten","poem":2},{"text":"bland hednafolken.","poem":3},{"noteId":233}]},{"type":"verse","number":2,"content":[{"text":"Han ska inte skria eller ropa,","poem":1},{"text":"inte låta sin röst höras på gatorna.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ett brutet strå","poem":1},{"text":"ska han inte krossa,","poem":3},{"text":"en tynande veke","poem":2},{"text":"ska han inte släcka.","poem":3},{"text":"Han ska i trofasthet utbreda rätten.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Han ska inte försvagas","poem":1},{"text":"eller brytas ner","poem":3},{"text":"förrän han har grundat rätten","poem":2},{"text":"på jorden.","poem":3},{"text":"Havsländerna väntar","poem":2},{"text":"på hans undervisning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Så säger Gud,","poem":1},{"text":"Herren som har skapat himlen","poem":2},{"text":"och spänt ut den,","poem":3},{"text":"han som har brett ut jorden","poem":2},{"text":"med allt som växer där,","poem":3},{"text":"han som har gett liv åt folket","poem":2},{"text":"som bor där","poem":3},{"text":"och ande åt dem som vandrar","poem":2},{"text":"på den.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag, Herren,","poem":1},{"text":"har kallat dig i rättfärdighet.","poem":3},{"text":"Jag ska hålla dig i handen,","poem":2},{"text":"jag ska bevara dig","poem":3},{"text":"och göra dig till ett förbund","poem":2},{"text":"för folket,","poem":3},{"text":"till ett ljus för hednafolken,","poem":2},{"noteId":234}]},{"type":"verse","number":7,"content":[{"text":"för att du ska öppna blinda ögon","poem":1},{"text":"och föra fångar ut ur fängelset,","poem":3},{"text":"ur fångenskapen","poem":2},{"text":"dem som sitter i mörker.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Jag är Herren,","poem":1},{"text":"det är mitt namn.","poem":3},{"text":"Jag ger inte min ära åt någon annan","poem":2},{"text":"eller mitt lov åt avgudabilder.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Se, det jag förkunnade förut","poem":1},{"text":"har kommit.","poem":3},{"text":"Nu förkunnar jag nya ting,","poem":2},{"text":"jag låter er höra om dem","poem":3},{"text":"innan de visar sig.","poem":4}]},{"type":"heading","content":["En ny sång"]},{"type":"verse","number":10,"content":[{"text":"Sjung en ny sång till Herren,","poem":1},{"text":"sjung hans lov från jordens ände,","poem":3},{"text":"ni som reser på havet","poem":2},{"text":"och allt som finns i det,","poem":3},{"text":"ni havsländer med era invånare.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Höj din röst,","poem":1},{"text":"du öken med dina städer,","poem":2},{"text":"ni byar där Kedar bor.","poem":3},{"text":"Jubla, ni Selas","poem":2},{"noteId":235},{"text":"invånare,","poem":2},{"text":"ropa från bergens toppar.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ge Herren ära,","poem":1},{"text":"förkunna hans lov i havsländerna.","poem":2}]},{"type":"heading","content":["Herren ska gripa in"]},{"type":"verse","number":13,"content":[{"text":"Herren drar ut som en hjälte,","poem":1},{"text":"han eggar upp sig","poem":2},{"text":"med en krigares iver.","poem":3},{"text":"Han ropar högt, han höjer härskri","poem":2},{"text":"och visar sin makt","poem":3},{"text":"mot sina fiender.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Länge har jag tigit,","poem":1},{"text":"jag höll mig stilla,","poem":2},{"text":"jag lade band på mig.","poem":3},{"text":"Men nu ska jag skrika","poem":2},{"text":"som en barnaföderska,","poem":3},{"text":"jag ska flämta och flåsa","poem":2},{"text":"på samma gång.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Jag ska ödelägga berg och höjder","poem":1},{"text":"och låta allt deras gräs torka bort.","poem":3},{"text":"Jag ska göra strömmar till land","poem":2},{"text":"och låta sjöar torka ut.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"De blinda ska jag leda","poem":1},{"text":"på en väg som de inte känner,","poem":3},{"text":"på okända stigar","poem":2},{"text":"ska jag föra dem fram.","poem":3},{"text":"Jag ska göra mörkret framför dem","poem":2},{"text":"till ljus","poem":4},{"text":"och det ojämna till jämn mark.","poem":3},{"text":"Detta är vad jag ska göra,","poem":2},{"text":"och jag ska inte överge dem.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Men de som litar till avgudabilder","poem":1},{"text":"och säger till gjutna bilder:","poem":2},{"text":"\"Ni är våra gudar\",","poem":3},{"text":"de ska vika tillbaka","poem":2},{"text":"och stå där med skam.","poem":3}]},{"type":"heading","content":["Israels barn är blinda och döva"]},{"type":"verse","number":18,"content":[{"text":"Ni som är döva, hör!","poem":1},{"text":"Ni som är blinda, skåda och se!","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Vem är så blind som min tjänare","poem":1},{"text":"och så döv som min","poem":2},{"text":"budbärare som jag sänder?","poem":3},{"text":"Vem är så blind som min förtrogne,","poem":2},{"text":"så blind som Herrens tjänare?","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Du har sett mycket","poem":1},{"text":"men inte tagit vara på det.","poem":3},{"text":"Öronen är öppna,","poem":2},{"text":"men ingen lyssnar.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Herren ville","poem":1},{"text":"för sin rättfärdighets skull","poem":3},{"text":"låta sin undervisning","poem":2},{"text":"komma till makt och ära.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Men detta är ett plundrat","poem":1},{"text":"och skövlat folk.","poem":3},{"text":"De ligger alla bundna i hålor,","poem":2},{"text":"gömda i fängelser.","poem":3},{"text":"De har utlämnats till plundring","poem":2},{"text":"utan att någon räddar,","poem":3},{"text":"till skövling utan att någon säger:","poem":2},{"text":"\"Ge tillbaka.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Vem bland er lyssnar på detta,","poem":1},{"text":"tar vara på det","poem":2},{"text":"och hör för framtiden?","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Vem har lämnat Jakob till skövling","poem":1},{"text":"och Israel åt plundrare?","poem":3},{"text":"Är det inte Herren,","poem":2},{"text":"som vi syndat mot?","poem":3},{"text":"De ville inte vandra på hans vägar","poem":2},{"text":"eller höra hans undervisning.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Därför öste han sin brinnande vrede","poem":1},{"text":"över dem – krigets raseri.","poem":3},{"text":"De förbrändes av det runt omkring,","poem":2},{"text":"men de besinnade det inte.","poem":3},{"text":"De förtärdes av det","poem":2},{"text":"men tog det inte till sitt hjärta.","poem":3}]}],"footnotes":[{"noteId":233,"caller":"-","text":"Citeras i Matt 12:18f som profetia om Messias.","reference":{"chapter":42,"verse":1}},{"noteId":234,"caller":"-","text":"Citeras av Paulus i Apg 13:47 som profetia om hedningarnas frälsning.","reference":{"chapter":42,"verse":6}},{"noteId":235,"caller":"-","text":"Kedar … SelaNordarabiskt ökenfolk samt troligen Petra söder om Döda havet.","reference":{"chapter":42,"verse":11}}]},"thisChapterLink":"/api/swe_fol/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}