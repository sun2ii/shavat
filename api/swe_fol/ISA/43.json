{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Israels oförtjänta räddning"]},{"type":"verse","number":1,"content":["Men så säger nu Herren,",{"text":"han som har","poem":2},{"text":"skapat dig, Jakob,","poem":4},{"text":"han som har format dig, Israel:","poem":3},{"text":"Var inte rädd,","poem":2},{"text":"för jag har återlöst dig,","poem":3},{"text":"jag har kallat dig vid namn,","poem":2},{"text":"du är min.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Om du går genom vatten","poem":1},{"text":"är jag med dig,","poem":3},{"text":"eller genom strömmar","poem":2},{"text":"så ska de inte dränka dig.","poem":3},{"text":"Om du går genom eld","poem":2},{"text":"ska du inte bli svedd,","poem":3},{"text":"lågan ska inte bränna dig.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"För jag är Herren din Gud,","poem":1},{"text":"Israels Helige, din Frälsare.","poem":3},{"text":"Jag ger Egypten till lösen för dig,","poem":2},{"text":"Nubien och Seba","poem":3},{"noteId":236},{"text":"i ditt ställe.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Eftersom du är dyrbar i mina ögon,","poem":1},{"text":"högt aktad och älskad av mig,","poem":3},{"text":"ger jag människor i ditt ställe,","poem":2},{"text":"folk i stället för ditt liv.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Var inte rädd, för jag är med dig.","poem":1},{"text":"Jag ska hämta dina barn från öster","poem":2},{"text":"och samla dig från väster.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag ska säga till länderna i norr:","poem":1},{"text":"\"Ge hit!\"","poem":3},{"text":"och till södern:","poem":2},{"text":"\"Håll dem inte tillbaka!","poem":3},{"text":"För hit mina söner fjärran ifrån","poem":2},{"text":"och mina döttrar","poem":3},{"text":"från jordens ände,","poem":4}]},{"type":"verse","number":7,"content":[{"text":"var och en som är uppkallad","poem":1},{"text":"efter mitt namn","poem":3},{"text":"och som jag skapat till min ära,","poem":2},{"text":"som jag format och gjort.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"För ut det blinda folket","poem":1},{"text":"som ändå har ögon,","poem":3},{"text":"och de döva som ändå har öron.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alla hedningar kommer tillsammans","poem":1},{"text":"och folken samlas.","poem":3},{"text":"Vem bland dem förkunnade detta","poem":2},{"text":"och lät oss höra om det","poem":3},{"text":"som har skett?","poem":4},{"text":"Låt dem föra fram sina vittnen","poem":2},{"text":"så att de kan få rätt.","poem":3},{"text":"Låt dem höra, så att de kan säga:","poem":2},{"text":"\"Det är sant.\"","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ni är mina vittnen, säger Herren,","poem":1},{"text":"och min tjänare som jag utvalt,","poem":3},{"text":"för att ni ska känna mig och tro mig","poem":2},{"text":"och förstå att Jag Är.","poem":3},{"text":"Före mig blev ingen Gud formad,","poem":2},{"text":"efter mig ska ingen komma.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Jag, jag är Herren.","poem":1},{"text":"Förutom mig finns ingen frälsare.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Det är jag som har förutsagt","poem":1},{"text":"och frälst och förkunnat,","poem":3},{"text":"ingen främmande gud ibland er.","poem":2},{"text":"Ni är mina vittnen, säger Herren,","poem":3},{"text":"och jag är Gud.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Jag Är, redan från första dagen.","poem":1},{"noteId":237},{"text":"Ingen kan rädda ur min hand.","poem":3},{"text":"När jag vill göra något,","poem":2},{"text":"vem kan då hindra det?","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Så säger Herren,","poem":1},{"text":"er återlösare, Israels Helige:","poem":3},{"text":"För er skull sänder jag bud till Babel","poem":2},{"text":"och bryter ner alla bommarna,","poem":3},{"text":"och kaldeernas jubel","poem":2},{"text":"förvandlas till jämmer.","poem":3},{"noteId":238}]},{"type":"verse","number":15,"content":[{"text":"Jag är Herren er Helige,","poem":1},{"text":"Israels skapare, er kung.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Så säger Herren,","poem":1},{"text":"han som gjorde en väg i havet,","poem":2},{"text":"en stig i väldiga vatten,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"han som förde ut vagnar","poem":1},{"text":"och hästar dit,","poem":2},{"text":"en mäktig krigshär.","poem":3},{"text":"Där blev de liggande,","poem":2},{"text":"de reser sig aldrig mer.","poem":3},{"text":"De utplånades,","poem":2},{"text":"de släcktes som en veke.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tänk inte på det som har hänt,","poem":1},{"text":"bry er inte om det som var förr.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Se, jag gör något nytt.","poem":1},{"text":"Redan nu visar det sig.","poem":2},{"text":"Märker ni det inte?","poem":3},{"text":"Jag ska göra en väg i vildmarken","poem":2},{"text":"och strömmar i öknen.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Markens djur ska ära mig,","poem":1},{"text":"schakaler och strutsar,","poem":3},{"text":"för jag förser vildmarken med vatten","poem":2},{"text":"och öknen med strömmar,","poem":3},{"text":"så att mitt folk, mina utvalda,","poem":2},{"text":"kan dricka.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Det folk som jag format åt mig","poem":1},{"text":"ska höja mitt lov.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Men du Jakob har inte kallat på mig,","poem":1},{"text":"du Israel har tröttnat på mig.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Du har inte kommit till mig","poem":1},{"text":"med dina brännofferfår","poem":3},{"text":"eller ärat mig med dina slaktoffer.","poem":2},{"lineBreak":true},{"text":"Jag har inte gett dig arbete","poem":2},{"text":"med matoffer","poem":3},{"text":"eller möda med rökelse.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Du har inte köpt kalmus","poem":1},{"noteId":239},{"text":"åt mig","poem":1},{"text":"för pengar","poem":3},{"text":"eller mättat mig","poem":2},{"text":"med dina slaktoffers fett.","poem":3},{"text":"I stället har du gett mig arbete","poem":2},{"text":"med dina synder","poem":3},{"text":"och möda med dina missgärningar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Jag, jag är den som utplånar","poem":1},{"text":"dina brott för min egen skull,","poem":3},{"text":"dina synder minns jag inte mer.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Påminn mig,","poem":1},{"text":"låt oss gå till rätta med varandra,","poem":2},{"text":"tala så att du kan få rätt.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Redan din stamfar syndade","poem":1},{"text":"och dina talesmän gjorde uppror","poem":3},{"text":"mot mig.","poem":4}]},{"type":"verse","number":28,"content":[{"text":"Därför har jag vanhelgat","poem":1},{"text":"helgedomens ledare,","poem":3},{"text":"överlämnat Jakob till förintelse","poem":2},{"text":"och Israel till hån.","poem":3}]}],"footnotes":[{"noteId":236,"caller":"-","text":"Nubien och SebaNuvarande Sudan och Jemen.","reference":{"chapter":43,"verse":3}},{"noteId":237,"caller":"-","text":"redan från första dagenAnnan översättning: \"från denna dag och framåt\".","reference":{"chapter":43,"verse":13}},{"noteId":238,"caller":"-","text":"Babel etcAnnan översättning: \"Babel och för ner kaldeerna som flyktingar på skeppen de jublade över\".","reference":{"chapter":43,"verse":14}},{"noteId":239,"caller":"-","text":"kalmusDoftande gräs, kanske från Indien (Jer 6:20). Ingick i smörjelseoljan (2 Mos 30:23).","reference":{"chapter":43,"verse":24}}]},"thisChapterLink":"/api/swe_fol/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}