{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["Det sanna Israel och den ende Guden"]},{"type":"verse","number":1,"content":["Men hör nu,",{"text":"du min tjänare Jakob,","poem":2},{"text":"du Israel som jag har utvalt.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Så säger Herren som skapade dig,","poem":1},{"text":"han som formade dig i moderlivet","poem":2},{"text":"och som hjälper dig:","poem":3},{"text":"Var inte rädd, du min tjänare Jakob,","poem":2},{"text":"du Jeshurun","poem":3},{"noteId":240},{"text":"som jag har utvalt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"För jag ska utgjuta","poem":1},{"text":"vatten över det som törstar","poem":2},{"text":"och strömmar över det torra.","poem":3},{"text":"Jag ska utgjuta","poem":2},{"text":"min Ande över dina barn,","poem":3},{"text":"min välsignelse","poem":2},{"text":"över dina avkomlingar,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"så att de växer upp","poem":1},{"text":"bland det gröna gräset,","poem":3},{"text":"som pilträd vid vattenbäckar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Då ska en säga: \"Jag tillhör Herren\",","poem":1},{"text":"en annan åberopa Jakobs namn,","poem":3},{"text":"en tredje skriva: \"Herrens egen\"","poem":2},{"text":"på sin hand","poem":3},{"text":"och använda Israel som ärenamn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Så säger Herren, Israels Kung,","poem":1},{"text":"och hans Återlösare,","poem":3},{"text":"Herren Sebaot:","poem":4},{"text":"Jag är den förste, och jag är den siste.","poem":2},{"text":"Utom mig finns ingen Gud.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Vem är som jag?","poem":1},{"text":"Låt honom berätta och lägga fram","poem":2},{"text":"för mig vad som har hänt","poem":4},{"text":"sedan jag insatte folket för evigt,","poem":3},{"text":"och berätta vad som ska komma","poem":2},{"text":"i framtiden.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Var inte rädda eller förskräckta.","poem":1},{"text":"Har jag inte låtit er höra om det","poem":2},{"text":"och förkunnat det","poem":3},{"text":"för länge sedan?","poem":4},{"text":"Ni är mina vittnen.","poem":3},{"text":"Finns det någon annan Gud än jag?","poem":2},{"text":"Nej, det finns ingen annan klippa,","poem":3},{"text":"jag vet ingen.","poem":4}]},{"type":"heading","content":["Det dåraktiga med avgudar"]},{"type":"verse","number":9,"content":[{"text":"Alla som tillverkar avgudar är tomhet,","poem":1},{"text":"deras kära gudar kan inte hjälpa.","poem":3},{"text":"Deras vittnen ser inget","poem":2},{"text":"och förstår inget,","poem":3},{"text":"därför kommer de på skam.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vem vill forma en gud","poem":1},{"text":"och gjuta en bild","poem":3},{"text":"som inte kan hjälpa honom?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Se, hela deras sällskap","poem":1},{"text":"ska komma på skam.","poem":3},{"text":"Konsthantverkarna är ju själva","poem":2},{"text":"bara människor.","poem":3},{"text":"Låt dem alla samlas och träda fram.","poem":2},{"text":"Då ska de alla komma på skam","poem":3},{"text":"i skräck.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Smeden tar sitt verktyg","poem":1},{"text":"och bearbetar smidet i glöden,","poem":3},{"text":"han formar det med hammare","poem":2},{"text":"och bearbetar det","poem":3},{"text":"med kraftig arm.","poem":4},{"text":"Blir han hungrig","poem":2},{"text":"förlorar han sin kraft,","poem":3},{"text":"dricker han inte vatten","poem":2},{"text":"blir han matt.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Träsnidaren spänner ut","poem":1},{"text":"sitt måttband","poem":3},{"text":"och gör märken på trästycket","poem":2},{"text":"med sitt ritstift.","poem":3},{"text":"Han formar det med stämjärn","poem":2},{"text":"och märker ut det med passaren.","poem":3},{"text":"Han gör det till en mansbild,","poem":2},{"text":"en vacker människogestalt","poem":3},{"text":"att sättas i ett hus.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Man fäller cedrar åt sig","poem":1},{"text":"och tar stenek och vanlig ek","poem":2},{"text":"och väljer","poem":3},{"noteId":241},{"text":"åt sig","poem":3},{"text":"bland skogens träd.","poem":4},{"text":"Man planterar lärkträd,","poem":2},{"text":"och regnet får dem att växa.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Detta har människorna till bränsle.","poem":1},{"text":"Man tar av veden","poem":2},{"text":"och värmer sig med den,","poem":3},{"text":"man tänder på den","poem":2},{"text":"och bakar bröd.","poem":3},{"text":"Men man tillverkar också","poem":2},{"text":"en gud och tillber den,","poem":3},{"text":"man gör träet till en gudabild","poem":2},{"text":"och faller ner för den.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Hälften av träet","poem":1},{"text":"bränner man upp i eld,","poem":3},{"text":"över hälften lagar man kött att äta,","poem":2},{"text":"steker sin stek och äter sig mätt.","poem":3},{"text":"Sedan värmer man sig och säger:","poem":2},{"text":"\"Gott, jag är varm!","poem":3},{"text":"Jag njuter av brasan.\"","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Men av det som är kvar","poem":1},{"text":"gör man en gud, en gudabild.","poem":3},{"text":"Man faller ner för den och tillber,","poem":2},{"text":"Man ber till den och säger:","poem":3},{"text":"\"Rädda mig, för du är min gud!\"","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Dessa människor vet ingenting","poem":1},{"text":"och förstår ingenting,","poem":3},{"text":"för deras ögon är stängda","poem":2},{"text":"så att de inte ser,","poem":3},{"text":"och deras hjärtan","poem":2},{"text":"så att de inte fattar.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Ingen tänker efter i hjärtat,","poem":1},{"text":"har vett eller förstånd att säga:","poem":3},{"text":"\"Hälften brände jag upp i eld,","poem":2},{"text":"på kolen bakade jag bröd","poem":3},{"text":"och stekte kött och åt.","poem":4},{"text":"Skulle jag nu göra resten","poem":2},{"text":"till en avskyvärd avgud?","poem":3},{"text":"Skulle jag falla ner","poem":2},{"text":"för en träbit?\"","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Den som lever av aska","poem":1},{"text":"är förledd av ett vilselett hjärta,","poem":3},{"text":"så att han inte kan rädda sin själ","poem":2},{"text":"eller tänka:","poem":3},{"text":"\"Är det inte lögn,","poem":2},{"text":"detta i min högra hand?\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tänk på detta, Jakob,","poem":1},{"text":"du Israel, för du är min tjänare.","poem":3},{"text":"Jag har format dig,","poem":2},{"text":"du är min tjänare.","poem":3},{"text":"Israel, du blir inte bortglömd av mig.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Jag har utplånat dina brott","poem":1},{"text":"som ett moln,","poem":3},{"text":"dina synder som en sky.","poem":2},{"lineBreak":true},{"text":"Vänd om till mig,","poem":2},{"text":"för jag har återlöst dig.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Jubla, ni himlar,","poem":1},{"text":"för Herren har gjort det!","poem":3},{"text":"Höj glädjerop, ni jordens djup,","poem":2},{"text":"brist ut i jubel, ni berg,","poem":3},{"text":"du skog med alla dina träd,","poem":4},{"text":"för Herren har återlöst Jakob,","poem":2},{"text":"han visar sin härlighet i Israel.","poem":3}]},{"type":"heading","content":["Jerusalem ska bli bebott"]},{"type":"verse","number":24,"content":[{"text":"Så säger Herren din återlösare,","poem":1},{"text":"han som format dig","poem":2},{"text":"sedan moderlivet:","poem":3},{"text":"Jag, Herren,","poem":2},{"text":"är den som har gjort allt,","poem":3},{"text":"den som ensam har spänt ut himlen","poem":2},{"text":"och brett ut jorden.","poem":3},{"text":"Vem var med mig?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jag är den som tillintetgör","poem":1},{"text":"lögnprofeternas tecken","poem":2},{"text":"och gör spåmännen till dårar,","poem":3},{"text":"som låter de visa komma till korta","poem":2},{"text":"och gör deras kunskap","poem":3},{"text":"till dårskap,","poem":4}]},{"type":"verse","number":26,"content":[{"text":"men bekräftar sin tjänares ord","poem":1},{"text":"och fullbordar sina","poem":2},{"text":"sändebuds råd.","poem":3},{"text":"Jag är den som säger om Jerusalem:","poem":2},{"text":"\"Det ska bli bebott\"","poem":3},{"text":"och om Juda städer:","poem":2},{"text":"\"De ska byggas upp,","poem":3},{"text":"jag ska resa upp deras ruiner.\"","poem":4}]},{"type":"verse","number":27,"content":[{"text":"Jag är den som säger till havsdjupet:","poem":1},{"text":"\"Bli torrt!","poem":2},{"text":"Jag ska torka ut dina strömmar.\"","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Jag är den som säger om Koresh","poem":1},{"noteId":242},{"text":":","poem":1},{"text":"\"Han är min herde,","poem":2},{"text":"han ska fullborda allt jag vill.","poem":3},{"text":"Han ska säga om Jerusalem:","poem":2},{"text":"Det ska byggas upp,","poem":3},{"text":"och till templet:","poem":2},{"text":"Din grund ska bli lagd på nytt.\"","poem":3}]}],"footnotes":[{"noteId":240,"caller":"-","text":"JeshurunPoetiskt namn på Israel, troligen bildat av Jashár, \"rättrådig\".","reference":{"chapter":44,"verse":2}},{"noteId":241,"caller":"-","text":"väljerAnnan översättning: \"odlar\".","reference":{"chapter":44,"verse":14}},{"noteId":242,"caller":"-","text":"KoreshPersisk kung (559-530 f Kr) som år 539 f Kr besegrade Babel och befriade rikets fångar, däribland judarna, och möjliggjorde återuppbyggnaden av templet i Jerusalem (se Esra 1).","reference":{"chapter":44,"verse":28}}]},"thisChapterLink":"/api/swe_fol/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}