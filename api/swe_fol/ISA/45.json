{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"heading","content":["Koresh som Guds verktyg"]},{"type":"verse","number":1,"content":["Så säger Herren",{"text":"till sin smorde","poem":2},{"noteId":243},{"text":",","poem":2},{"lineBreak":true},{"text":"till Koresh vars högra hand","poem":2},{"text":"jag har fattat","poem":3},{"text":"för att slå ner folken framför honom,","poem":2},{"text":"lossa bältet från kungars höfter","poem":3},{"text":"och öppna dörrar för honom","poem":2},{"text":"så att inga portar mer är stängda:","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Jag ska gå framför dig","poem":1},{"text":"och jämna ut höjderna","poem":3},{"noteId":244},{"text":".","poem":3},{"text":"Jag ska krossa kopparportarna","poem":2},{"text":"och knäcka järnbommarna.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Jag ska ge dig skatter","poem":1},{"text":"som är dolda i mörkret","poem":2},{"text":"och hemliga rikedomar,","poem":3},{"text":"för att du ska inse att jag är Herren","poem":2},{"text":"som kallar dig vid ditt namn,","poem":3},{"text":"jag är Israels Gud.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"För min tjänare Jakobs skull,","poem":1},{"text":"för Israels skull, min utvalde,","poem":2},{"text":"kallade jag dig vid namn.","poem":3},{"text":"Jag gav dig ett ärenamn,","poem":2},{"text":"fastän du inte kände mig.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Jag är Herren,","poem":1},{"text":"och det finns ingen annan.","poem":2},{"text":"Utom mig finns ingen Gud.","poem":3},{"text":"Jag spänner bältet om ditt liv,","poem":2},{"text":"fastän du inte känner mig,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"för att man ska förstå","poem":1},{"text":"både i öster och väster","poem":2},{"text":"att det inte finns någon utom mig.","poem":3},{"text":"Jag är Herren,","poem":2},{"text":"och det finns ingen annan.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Jag formar ljuset och skapar mörkret,","poem":1},{"text":"jag ger lycka och skapar olycka.","poem":2},{"text":"Jag, Herren, gör allt detta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Låt det regna från ovan, ni himlar,","poem":1},{"text":"låt rättfärdighet strömma ner","poem":2},{"text":"från skyarna.","poem":3},{"text":"Jorden ska öppna sig","poem":2},{"text":"och ge frälsning som frukt,","poem":3},{"text":"den ska låta rättfärdighet växa upp.","poem":2},{"text":"Jag, Herren, skapar detta.","poem":3}]},{"type":"heading","content":["Blindhet för Skaparen"]},{"type":"verse","number":9,"content":[{"text":"Ve den som tvistar med sin Skapare,","poem":1},{"text":"en lerskärva","poem":2},{"text":"bland jordens skärvor!","poem":3},{"text":"Säger leran till den som formar den:","poem":2},{"text":"\"Vad gör du?\"","poem":3},{"text":"Säger ditt verk:","poem":2},{"text":"\"Han har inga händer?\"","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ve den som säger till en far:","poem":1},{"text":"\"Vad är det du avlar?\"","poem":3},{"text":"och till en kvinna:","poem":2},{"text":"\"Vad är det du föder fram?\"","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Så säger Herren,","poem":1},{"text":"Israels Helige och Skapare:","poem":3},{"text":"Fråga mig om det som ska komma.","poem":2},{"text":"Låt mig ha omsorg","poem":3},{"text":"om mina söner","poem":2},{"text":"och mina händers verk.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Det är jag som har gjort jorden","poem":1},{"text":"och skapat människorna på den.","poem":3},{"text":"Det är jag som har spänt ut himlen","poem":2},{"text":"med mina händer","poem":3},{"text":"och gett befallning till hela dess här.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Det är jag som har","poem":1},{"text":"väckt upp honom i rättfärdighet","poem":2},{"text":"och gör alla hans vägar jämna.","poem":3},{"text":"Han ska bygga upp min stad","poem":2},{"text":"och släppa mina fångar fria,","poem":3},{"text":"men inte för betalning eller mutor,","poem":2},{"text":"säger Herren Sebaot.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Vad egyptierna har vunnit","poem":2},{"text":"med arbete","poem":3},{"text":"och nubiernas och Sebas resliga folk","poem":2},{"text":"med handel,","poem":3},{"text":"allt ska gå över till dig","poem":2},{"text":"och tillhöra dig.","poem":3},{"text":"De ska följa efter dig,","poem":2},{"text":"i kedjor ska de gå.","poem":3},{"text":"Och de ska falla ner inför dig","poem":2},{"text":"och rikta sin bön till dig:","poem":3},{"text":"\"Endast hos dig är Gud,","poem":2},{"text":"och det finns ingen mer,","poem":3},{"text":"ingen annan Gud.\"","poem":4}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Du är sannerligen","poem":1},{"text":"en Gud som döljer sig,","poem":3},{"text":"du Israels Gud, du Frälsare.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Alla måste de skämmas och blygas,","poem":1},{"text":"avgudamakarna går bort","poem":2},{"text":"tillsammans i skam.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Men Israel blir frälst genom Herren","poem":1},{"text":"med en evig frälsning.","poem":3},{"text":"Ni ska aldrig i evighet","poem":2},{"text":"behöva skämmas eller blygas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"För så säger Herren,","poem":1},{"text":"han som har skapat himlen,","poem":2},{"text":"han som är Gud,","poem":3},{"text":"som har format jorden","poem":2},{"text":"och gjort den och berett den,","poem":3},{"text":"som inte har skapat den","poem":2},{"text":"till att vara öde","poem":3},{"text":"utan format den till att vara bebodd:","poem":2},{"text":"Jag är Herren,","poem":3},{"text":"och det finns ingen annan.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Jag har inte talat i hemlighet,","poem":1},{"text":"någonstans i ett mörkt land.","poem":3},{"text":"Jag har inte sagt","poem":2},{"text":"till Jakobs avkomlingar:","poem":3},{"text":"\"Ni ska söka mig förgäves.\"","poem":4},{"text":"Jag är Herren,","poem":2},{"text":"som talar sanning","poem":3},{"text":"och förkunnar vad som är rätt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Samla er och kom, träd fram,","poem":1},{"text":"ni som räddats från folken.","poem":3},{"text":"De förstår inte,","poem":2},{"text":"de som bär på sina träbilder","poem":3},{"lineBreak":true},{"text":"och ber till en gud","poem":3},{"text":"som inte kan frälsa.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"Berätta, lägg fram er sak!","poem":1},{"text":"Ja, låt dem rådslå tillsammans.","poem":3},{"text":"Vem har låtit er höra detta","poem":2},{"text":"sedan länge","poem":3},{"text":"och förkunnat det för längesedan?","poem":2},{"text":"Är det inte jag, Herren?","poem":3},{"text":"Och det finns ingen Gud utom mig,","poem":2},{"text":"en rättfärdig Gud som frälser,","poem":3},{"text":"ingen utom mig.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"Vänd er till mig och bli frälsta,","poem":1},{"text":"ni jordens alla ändar,","poem":3},{"text":"för jag är Gud","poem":2},{"text":"och det finns ingen annan.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Jag har svurit vid mig själv,","poem":1},{"text":"ett sanningsord har gått ut","poem":2},{"text":"från min mun,","poem":4},{"text":"ett ord som inte ska tas tillbaka:","poem":3},{"text":"För mig ska alla knän böjas,","poem":2},{"text":"alla tungor ska ge mig sin ed","poem":3},{"noteId":245}]},{"type":"verse","number":24,"content":[{"text":"och säga om mig:","poem":1},{"text":"Endast i Herren","poem":2},{"text":"finns rättfärdighet och styrka.","poem":3},{"text":"Till honom ska man komma,","poem":2},{"text":"och alla som varit arga på honom","poem":3},{"text":"ska skämmas.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"I Herren ska hela Israels släkt","poem":1},{"text":"ha sin rättfärdighet,","poem":3},{"text":"de ska ha sin ära i honom.","poem":2}]}],"footnotes":[{"noteId":243,"caller":"-","text":"smordeGuds utvalde, helgade kung, en förebild till Messias (Apg 10:38).","reference":{"chapter":45,"verse":1}},{"noteId":244,"caller":"-","text":"höjdernaJesajarullen från Qumran och Septuaginta: \"bergen\".","reference":{"chapter":45,"verse":2}},{"noteId":245,"caller":"-","text":"Citeras av Paulus i Rom 14:11 och i Kristushymnen i Fil 2:10f.","reference":{"chapter":45,"verse":23}}]},"thisChapterLink":"/api/swe_fol/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}