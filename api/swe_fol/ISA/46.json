{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["Babels gudar faller"]},{"type":"verse","number":1,"content":["Bel sjunker ner,",{"text":"Nebo","poem":3},{"noteId":246},{"text":"måste böja sig,","poem":3},{"text":"deras bilder läggs på djur","poem":2},{"text":"och boskap.","poem":3},{"text":"De som ni bar på är en belastning,","poem":2},{"text":"en börda för den trötte.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Tillsammans sjunker de ihop","poem":1},{"text":"och böjer sig.","poem":3},{"text":"De kan inte rädda bördan,","poem":2},{"text":"de måste själva gå i fångenskap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Så hör på mig, ni av Jakobs hus,","poem":1},{"text":"alla ni som är kvar av Israels folk,","poem":3},{"text":"ni som har varit lagda på mig","poem":2},{"text":"från moderlivet,","poem":3},{"text":"burna av mig ända från","poem":2},{"text":"modersskötet.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag Är densamme tills ni blir gamla,","poem":1},{"text":"och jag ska bära er","poem":2},{"text":"ända tills ni blir grå.","poem":3},{"text":"Jag har gjort det förut","poem":2},{"noteId":247},{"text":",","poem":2},{"text":"och jag kommer att lyfta,","poem":3},{"text":"bära och rädda er.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Med vem vill ni likna","poem":1},{"text":"och jämföra mig?","poem":3},{"text":"Med vem vill ni jämställa mig,","poem":2},{"text":"så att vi skulle vara lika?","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Man skakar ut guld ur börsen","poem":1},{"text":"och väger upp silver på vågen.","poem":3},{"text":"Man lejer en guldsmed","poem":2},{"text":"för att göra det till en gud,","poem":3},{"text":"som man faller ner för och tillber.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Man lyfter upp den på axeln,","poem":1},{"text":"bär bort den och sätter ner den","poem":2},{"text":"på dess plats.","poem":3},{"text":"Där står den","poem":2},{"text":"och kan inte gå därifrån.","poem":3},{"text":"Ropar någon till den,","poem":2},{"text":"kan den inte svara","poem":3},{"text":"och rädda honom ur hans nöd.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Tänk på detta och fatta mod!","poem":1},{"text":"Ta det till hjärtat, ni upproriska.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kom ihåg det som hänt","poem":1},{"text":"för länge sedan,","poem":3},{"text":"för jag är Gud,","poem":2},{"text":"och det finns ingen annan Gud,","poem":3},{"text":"ingen som jag.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Jag förkunnar från början","poem":1},{"text":"vad som ska komma","poem":3},{"text":"och långt i förväg","poem":2},{"text":"det som inte har skett.","poem":3},{"text":"Jag säger:","poem":2},{"text":"Mitt beslut ska förverkligas,","poem":3},{"text":"allt jag vill kommer jag att göra.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Jag kallar på örnen från öster,","poem":1},{"text":"från fjärran land en man","poem":2},{"text":"som verkställer mitt beslut.","poem":3},{"text":"Vad jag talat låter jag ske,","poem":2},{"text":"vad jag beslutat utför jag.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Hör på mig, ni självsäkra,","poem":1},{"text":"ni som är fjärran","poem":2},{"text":"från rättfärdighet:","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Jag låter min rättfärdighet","poem":1},{"text":"komma nära,","poem":3},{"text":"den är inte långt borta,","poem":2},{"text":"min frälsning dröjer inte.","poem":3},{"text":"Jag ger frälsning i Sion,","poem":2},{"text":"min härlighet åt Israel.","poem":3}]}],"footnotes":[{"noteId":246,"caller":"-","text":"Bel … NeboBabels högste gud Marduk (jfr \"Baal\") och hans son vishetsguden.","reference":{"chapter":46,"verse":1}},{"noteId":247,"caller":"-","text":"gjort det förutAnnan översättning: \"gjort er\".","reference":{"chapter":46,"verse":4}}]},"thisChapterLink":"/api/swe_fol/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}