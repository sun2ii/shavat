{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Det stolta Babel faller"]},{"type":"verse","number":1,"content":["Kom ner och sätt dig i stoftet,",{"text":"du jungfru dotter Babel.","poem":3},{"text":"Sätt dig på jorden utan tron,","poem":2},{"text":"du kaldeernas dotter,","poem":3},{"text":"för man ska inte mer kalla dig","poem":2},{"text":"den fina och förnäma.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ta en kvarn","poem":1},{"noteId":248},{"text":"och mal mjöl,","poem":1},{"text":"lägg av din slöja","poem":3},{"noteId":249},{"text":",","poem":3},{"text":"lyft upp släpet, blotta benen,","poem":2},{"text":"vada genom strömmarna.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Din nakenhet ska blottas,","poem":1},{"text":"din skam ska synas.","poem":3},{"text":"Jag ska utkräva hämnd","poem":2},{"text":"och inte skona någon.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Vår återlösares namn","poem":1},{"text":"är Herren Sebaot, Israels Helige!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sitt tyst och dra dig undan i mörkret,","poem":1},{"text":"du kaldeernas dotter,","poem":3},{"text":"för du ska inte mer kallas","poem":2},{"text":"kungarikenas drottning.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag blev vred på mitt folk,","poem":1},{"text":"jag vanhelgade min arvedel","poem":2},{"text":"och gav dem i din hand.","poem":3},{"text":"Och du visade dem","poem":2},{"text":"ingen barmhärtighet,","poem":3},{"text":"du lät ditt ok tynga de gamla.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Du tänkte:","poem":1},{"text":"\"Jag ska vara drottning","poem":2},{"text":"för alltid!\"","poem":3},{"text":"Så du tog dig inte i akt","poem":2},{"text":"och tänkte inte på slutet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hör nu detta,","poem":1},{"text":"du som lever i lyx,","poem":2},{"text":"du som tronar så trygg,","poem":3},{"text":"du som säger i ditt hjärta:","poem":2},{"text":"\"Jag och ingen annan!","poem":3},{"text":"Aldrig ska jag sitta som änka,","poem":2},{"text":"aldrig veta av barnlöshet.\"","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Plötsligt ska båda dessa olyckor","poem":1},{"text":"drabba dig, på en och samma dag:","poem":2},{"text":"barnlöshet och änkestånd.","poem":3},{"text":"I fullt mått ska de drabba dig,","poem":2},{"text":"trots dina många trollkonster","poem":3},{"noteId":250},{"text":",","poem":3},{"text":"trots dina besvärjelsers stora kraft.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Du litade till din ondska och tänkte:","poem":1},{"text":"\"Ingen ser mig.\"","poem":3},{"text":"Din vishet och kunskap","poem":2},{"text":"förledde dig,","poem":3},{"text":"och du sade i ditt hjärta:","poem":2},{"text":"\"Jag och ingen annan.\"","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Därför ska en olycka drabba dig","poem":1},{"text":"som du inte kan besvärja,","poem":3},{"text":"ett fördärv ska falla över dig","poem":2},{"text":"som du inte kan avvärja.","poem":3},{"text":"Plötsligt ska förödelsen drabba dig,","poem":2},{"text":"när du minst anar det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Träd fram med dina besvärjelser","poem":1},{"text":"och dina många trollkonster,","poem":3},{"text":"som du har tröttat ut dig med","poem":2},{"text":"sedan din ungdom.","poem":3},{"text":"Kanske kan du få hjälp,","poem":2},{"text":"kanske kan du skrämma bort","poem":3},{"text":"faran?","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Du har tröttat ut dig","poem":1},{"text":"med dina många rådslag.","poem":3},{"text":"Nu får de träda fram","poem":2},{"text":"och rädda dig,","poem":3},{"text":"de som mäter upp himlen","poem":2},{"text":"och spanar i stjärnorna","poem":3},{"noteId":251},{"text":"och kungör månad för månad","poem":2},{"text":"vad som ska komma över dig.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Se, de är som strå","poem":1},{"text":"som bränns upp i eld,","poem":3},{"text":"de kan inte rädda sitt liv","poem":2},{"text":"ur lågornas våld.","poem":3},{"text":"Det är ingen koleld","poem":2},{"text":"att värma sig vid,","poem":3},{"text":"ingen brasa att sitta vid.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Så går det med","poem":1},{"text":"dem som du tröttade ut dig med,","poem":3},{"text":"dem du har handlat med","poem":2},{"text":"sedan din ungdom.","poem":3},{"text":"De irrar bort var och en åt sitt håll,","poem":2},{"text":"det finns ingen som räddar dig.","poem":3}]}],"footnotes":[{"noteId":248,"caller":"-","text":"kvarnAtt mala mjöl med handkvarn (två stenar) var en slavinnas syssla (2 Mos 11:5).","reference":{"chapter":47,"verse":2}},{"noteId":249,"caller":"-","text":"slöjaEn gift kvinnas kännetecken och rättighet.","reference":{"chapter":47,"verse":2}},{"noteId":250,"caller":"-","text":"många trollkonsterBabel var beryktat för sin tro på magi. Tusentals besvärjelsetexter har grävts fram.","reference":{"chapter":47,"verse":9}},{"noteId":251,"caller":"-","text":"spanar i stjärnornaAstrologin uppkom i Babylonien redan under patriarktiden.","reference":{"chapter":47,"verse":13}}]},"thisChapterLink":"/api/swe_fol/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}