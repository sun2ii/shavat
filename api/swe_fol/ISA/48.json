{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Israels befrielse trots upproriskhet"]},{"type":"verse","number":1,"content":["Hör detta, ni av Jakobs hus,",{"text":"ni som är uppkallade","poem":2},{"text":"efter Israels namn","poem":3},{"text":"och flöt fram ur Juda källa,","poem":4},{"text":"ni som svär vid Herrens namn","poem":2},{"text":"och bekänner er till Israels Gud,","poem":3},{"text":"men inte i sanning och rättfärdighet.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"För de kallar sig","poem":1},{"text":"efter den heliga staden","poem":3},{"text":"och stöder sig på Israels Gud,","poem":2},{"text":"vars namn är Herren Sebaot.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Det som har hänt förut,","poem":1},{"text":"det har jag förkunnat","poem":3},{"text":"för längesedan.","poem":4},{"text":"Det var förutsagt av min mun,","poem":2},{"text":"jag lät er höra om det.","poem":3},{"text":"Plötsligt satte jag det i verket,","poem":2},{"text":"och det inträffade.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Eftersom jag visste att du är hård,","poem":1},{"text":"med en nacke av järn","poem":2},{"text":"och en panna av koppar,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"förkunnade jag det för längesedan.","poem":1},{"text":"Innan det hände","poem":2},{"text":"lät jag dig höra om det,","poem":3},{"text":"för att du inte skulle kunna säga:","poem":2},{"text":"\"Min avgud har gjort det,","poem":3},{"text":"min skurna och gjutna gudabild","poem":2},{"text":"har befallt det.\"","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Du har hört det,","poem":1},{"text":"och nu ser du alltsammans.","poem":2},{"text":"Vill ni inte erkänna det?","poem":3},{"text":"Nu låter jag dig höra om nya ting,","poem":2},{"text":"fördolda ting","poem":3},{"text":"som du inte visste om.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Först nu har de skapats, inte förr.","poem":1},{"text":"Du har inte hört om dem","poem":2},{"text":"förrän i dag,","poem":3},{"text":"för att du inte skulle kunna säga:","poem":2},{"text":"\"Det visste jag redan.\"","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Du fick varken höra eller veta det,","poem":1},{"text":"på den tiden var dina öron","poem":2},{"text":"inte öppnade.","poem":3},{"text":"Jag visste ju hur trolös du var,","poem":2},{"text":"att du kallades syndare","poem":3},{"text":"från moderlivet.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Men för mitt namns skull","poem":1},{"text":"håller jag tillbaka min vrede,","poem":3},{"text":"för min äras skull är jag tålmodig","poem":2},{"text":"så att du inte blir utrotad.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Se, jag har luttrat dig,","poem":1},{"text":"men inte fått något silver","poem":3},{"noteId":252},{"text":".","poem":3},{"text":"Jag har prövat dig i lidandets ugn.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"För min egen skull,","poem":1},{"text":"för min egen skull gör jag det,","poem":3},{"text":"för hur skulle jag kunna","poem":2},{"text":"låta mitt namn bli ohelgat?","poem":3},{"text":"Jag ger inte min ära åt någon annan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hör på mig, Jakob,","poem":1},{"text":"du Israel som jag har kallat.","poem":3},{"text":"Jag Är.","poem":2},{"text":"Jag är den förste,","poem":3},{"text":"jag är också den siste.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Min hand har lagt jordens grund,","poem":1},{"text":"min högra hand","poem":2},{"text":"har spänt ut himlen.","poem":3},{"text":"Jag kallade på dem, då stod de där.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Samla er, ni alla, och hör:","poem":1},{"text":"Vem av de andra","poem":2},{"text":"har förutsagt detta,","poem":3},{"text":"att mannen som Herren älskar","poem":2},{"text":"ska utföra hans vilja mot Babel","poem":3},{"noteId":253},{"text":"och vara hans arm mot kaldeerna?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jag, jag har talat det,","poem":1},{"text":"jag har också kallat honom.","poem":3},{"text":"Jag har fört honom fram,","poem":2},{"text":"och han ska ha framgång","poem":3},{"text":"på sin väg.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kom till mig och hör detta:","poem":1},{"text":"Från första stund har jag talat","poem":2},{"text":"helt öppet.","poem":3},{"text":"När tiden kom att det skulle ske,","poem":2},{"text":"då var jag där.","poem":3},{"text":"Och nu har Herren Gud","poem":2},{"text":"sänt mig och sin Ande.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Så säger Herren din återlösare,","poem":1},{"text":"Israels Helige:","poem":3},{"text":"Jag är Herren din Gud","poem":2},{"text":"som lär dig vad nyttigt är,","poem":3},{"text":"som leder dig på vägen","poem":2},{"text":"du ska vandra.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Tänk om du hade lyssnat","poem":1},{"text":"på mina bud!","poem":3},{"text":"Då skulle din frid bli som en flod","poem":2},{"text":"och din rätt","poem":3},{"text":"som havets vågor.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Dina barn skulle bli som sanden,","poem":1},{"text":"din livsfrukt","poem":2},{"text":"som de oräkneliga sandkornen.","poem":3},{"text":"Deras namn skulle aldrig utrotas","poem":2},{"text":"eller utplånas ur min åsyn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dra ut från Babel,","poem":1},{"text":"fly från kaldeerna!","poem":3},{"text":"Förkunna det med fröjderop,","poem":2},{"text":"ropa ut det,","poem":3},{"text":"för ut det till jordens ände, säg:","poem":2},{"text":"\"Herren har återlöst","poem":3},{"text":"sin tjänare Jakob!","poem":4}]},{"type":"verse","number":21,"content":[{"text":"De led ingen törst","poem":1},{"text":"när han förde dem","poem":2},{"text":"genom öknarna,","poem":3},{"text":"för han lät vatten strömma fram","poem":2},{"text":"ur klippan åt dem.","poem":3},{"text":"Han klöv klippan","poem":2},{"text":"så att vatten flödade.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Det finns ingen frid","poem":1},{"text":"för de ogudaktiga, säger Herren.","poem":2}]}],"footnotes":[{"noteId":252,"caller":"-","text":"inte fått något silverAnnan översättning: \"inte som silver\". Silver renades i smältugn.","reference":{"chapter":48,"verse":10}},{"noteId":253,"caller":"-","text":"utföra hans vilja mot BabelKoresh (44:28) uppfyllde profetior mot Babel (Jer 50-51, Dan 5:24f).","reference":{"chapter":48,"verse":14}}]},"thisChapterLink":"/api/swe_fol/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}