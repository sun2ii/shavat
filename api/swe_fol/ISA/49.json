{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Messias, Herrens tjänare"]},{"type":"verse","number":1,"content":["Hör på mig, ni kustländer,",{"text":"lyssna, ni folk","poem":3},{"lineBreak":true},{"text":"som bor i fjärran!","poem":3},{"text":"Herren kallade mig","poem":2},{"text":"redan i moderlivet,","poem":3},{"text":"han nämnde mitt namn","poem":2},{"text":"redan i min mors sköte.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Han gjorde min mun","poem":1},{"text":"till ett skarpt svärd","poem":3},{"noteId":254},{"text":"och gömde mig","poem":2},{"text":"i skuggan av sin hand.","poem":3},{"text":"Han gjorde mig till en vass pil","poem":2},{"text":"och dolde mig i sitt koger.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Han sade till mig:","poem":1},{"text":"\"Du är min tjänare, Israel,","poem":2},{"text":"genom dig","poem":3},{"text":"vill jag förhärliga mig.\"","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Men jag tänkte:","poem":1},{"text":"\"Förgäves har jag ansträngt mig,","poem":2},{"text":"utan nytta förbrukat min kraft.","poem":3},{"text":"Men min rätt är hos Herren","poem":2},{"text":"och min lön hos min Gud.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Och nu säger Herren,","poem":1},{"text":"han som från moderlivet","poem":2},{"text":"formade mig till sin tjänare","poem":3},{"text":"för att föra Jakob tillbaka till honom","poem":2},{"text":"så att Israel samlas hos honom,","poem":3},{"text":"för jag är ärad i Herrens ögon","poem":2},{"text":"och min Gud är min styrka –","poem":3}]},{"type":"verse","number":6,"content":[{"text":"han säger: Det är för lite","poem":1},{"text":"att du bara är min tjänare","poem":3},{"text":"som upprättar Jakobs stammar","poem":2},{"text":"och för tillbaka de bevarade","poem":3},{"text":"av Israel.","poem":4},{"text":"Jag ska sätta dig","poem":2},{"text":"till ett ljus för hednafolken,","poem":3},{"text":"för att du ska bli min frälsning","poem":2},{"text":"ända till jordens yttersta gräns.","poem":3},{"noteId":255}]},{"type":"verse","number":7,"content":[{"text":"Så säger Herren,","poem":1},{"text":"Israels återlösare, hans Helige,","poem":3},{"text":"till honom som är föraktad","poem":2},{"text":"av varje själ,","poem":3},{"text":"till honom som är avskydd","poem":2},{"text":"av folken,","poem":3},{"text":"till honom som är","poem":2},{"text":"härskares tjänare:","poem":3},{"text":"Kungar ska se det och resa sig,","poem":2},{"text":"furstar ska se det och tillbe","poem":3},{"text":"eftersom Herren är trofast,","poem":2},{"text":"Israels Helige","poem":3},{"text":"som har utvalt dig.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Jag bönhör dig i nådens tid,","poem":2},{"text":"jag hjälper dig","poem":3},{"text":"på frälsningens dag.","poem":4},{"text":"Jag ska bevara dig","poem":2},{"text":"och göra dig till ett förbund","poem":3},{"text":"för folket,","poem":4},{"text":"för att upprätta landet","poem":2},{"text":"och fördela","poem":3},{"text":"de förödda arvslotterna,","poem":4},{"noteId":256}]},{"type":"verse","number":9,"content":[{"text":"för att säga till de fångna: \"Kom ut\",","poem":1},{"text":"och till dem som sitter i mörkret:","poem":2},{"text":"\"Visa er!\"","poem":3},{"text":"De ska finna bete längs vägarna,","poem":2},{"text":"betesmark på alla kala höjder.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"De ska varken hungra eller törsta,","poem":1},{"text":"ökenhettan och solen","poem":2},{"text":"ska inte skada dem,","poem":3},{"text":"för deras förbarmare ska leda dem","poem":2},{"text":"och föra dem till vattenkällor.","poem":3},{"noteId":257}]},{"type":"verse","number":11,"content":[{"text":"Jag ska göra alla mina berg","poem":1},{"text":"till jämna vägar,","poem":3},{"text":"och mina banade vägar","poem":2},{"text":"ska byggas höga.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Se, där kommer de fjärran ifrån,","poem":1},{"text":"några från norr","poem":2},{"text":"och andra från väster,","poem":3},{"text":"några från sineernas land","poem":2},{"noteId":258},{"text":".","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jubla, ni himlar,","poem":1},{"text":"och gläd dig, du jord,","poem":2},{"text":"brist ut i jubel, ni berg,","poem":3},{"text":"för Herren tröstar sitt folk","poem":2},{"text":"och förbarmar sig","poem":3},{"text":"över sina betryckta.","poem":4}]},{"type":"heading","content":["Herren har inte glömt Sion"]},{"type":"verse","number":14,"content":[{"text":"Men Sion säger:","poem":1},{"text":"\"Herren har övergett mig,","poem":2},{"text":"Herren har glömt mig.\"","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Kan en mor glömma sitt lilla barn,","poem":1},{"text":"att förbarma sig över sin livsfrukt?","poem":3},{"text":"Och även om hon skulle glömma,","poem":2},{"text":"så glömmer jag inte dig.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Se, jag har skrivit","poem":1},{"noteId":259},{"text":"dig","poem":1},{"text":"på mina händer.","poem":3},{"text":"Dina murar står ständigt inför mig.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Dina söner","poem":1},{"noteId":260},{"text":"skyndar sig tillbaka,","poem":1},{"text":"de som förstört och ödelagt dig","poem":2},{"text":"drar bort ifrån dig.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Lyft din blick och se dig omkring!","poem":1},{"text":"Alla samlas och kommer till dig.","poem":3},{"text":"Så sant jag lever, säger Herren,","poem":2},{"text":"du ska få klä dig i dem alla","poem":3},{"text":"som smycken","poem":4},{"text":"och fästa dem omkring dig","poem":3},{"text":"likt en brud.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Du var i ruiner, ödelagd,","poem":1},{"text":"ditt land var förött –","poem":3},{"text":"nu blir du för trång att bo i,","poem":2},{"text":"och de som slukade dig","poem":3},{"text":"ska vara långt borta.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Du ska få höra hur barnen","poem":1},{"text":"från din barnlöshets tid säger:","poem":3},{"text":"\"Platsen är för trång för mig,","poem":2},{"text":"ge mig plats så att jag kan bo här.\"","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Då ska du säga i ditt hjärta:","poem":1},{"text":"\"Vem har fött dessa åt mig?","poem":3},{"text":"Jag var ju barnlös och ofruktsam,","poem":2},{"text":"landsflyktig och fördriven.","poem":3},{"text":"Vem har fostrat dem?","poem":2},{"text":"Jag var ju lämnad ensam,","poem":3},{"text":"varifrån kommer de?\"","poem":4}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Så säger Herren Gud:","poem":1},{"text":"Se, jag ska lyfta min hand till folken,","poem":2},{"text":"resa mitt baner för hednafolken.","poem":3},{"text":"Då ska de komma","poem":2},{"text":"med dina söner i sin famn","poem":3},{"text":"och bära dina döttrar på sina axlar.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kungar ska vara dina barns vårdare","poem":1},{"text":"och furstinnor dina ammor.","poem":3},{"text":"De ska falla ner för dig","poem":2},{"text":"med ansiktet mot jorden","poem":3},{"text":"och slicka stoftet vid dina fötter.","poem":4},{"text":"Och du ska inse att jag är Herren,","poem":2},{"text":"och att de som hoppas på mig","poem":3},{"text":"inte kommer på skam.","poem":4}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kan man ta bytet från den starke","poem":1},{"text":"eller rycka fångarna från tyrannen","poem":2},{"noteId":261},{"text":"?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ja, så säger Herren:","poem":1},{"noteId":262},{"text":"Den starkes fångar","poem":2},{"text":"ska tas ifrån honom,","poem":3},{"text":"bytet ryckas från tyrannen.","poem":4},{"text":"Jag ska själv strida","poem":2},{"text":"mot dina motståndare,","poem":3},{"text":"jag ska själv rädda dina barn.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Jag ska låta dina förtryckare","poem":1},{"text":"äta sitt eget kött","poem":3},{"text":"och bli druckna av sitt eget blod,","poem":2},{"text":"som av sött vin.","poem":3},{"text":"Då ska allt levande förstå","poem":2},{"text":"att jag, Herren, är din Frälsare,","poem":3},{"text":"att Jakobs Mäktige","poem":2},{"text":"är din återlösare.","poem":3}]}],"footnotes":[{"noteId":254,"caller":"-","text":"mun … svärdOrdet för \"mun\" betyder också \"svärdsegg\". Jfr Upp 1:16, Ef 6:17.","reference":{"chapter":49,"verse":2}},{"noteId":255,"caller":"-","text":"Citeras av Paulus i Apg 13:47 som profetia om hedningarnas frälsning. Ordet \"frälsning\" heter på hebreiska jeshuá(jfr namnet Jeshúa, Jesus, Matt 1:21).","reference":{"chapter":49,"verse":6}},{"noteId":256,"caller":"-","text":"Citeras av Paulus i 2 Kor 6:2.","reference":{"chapter":49,"verse":8}},{"noteId":257,"caller":"-","text":"Citeras i Upp 7:16f.","reference":{"chapter":49,"verse":10}},{"noteId":258,"caller":"-","text":"sineernas landOsäker syftning. Har traditionellt tolkats som Kina, men kan också (enligt Jesajarullen från Qumran) syfta på Aswan vid Egyptens södra gräns, där det fanns en judisk befolkning i Elefantine (se not till Jer 44:1).","reference":{"chapter":49,"verse":12}},{"noteId":259,"caller":"-","text":"skrivitOrdagrant: \"ristat\" (som på en lertavla).","reference":{"chapter":49,"verse":16}},{"noteId":260,"caller":"-","text":"sönerAndra handskrifter (Qumran och Septuaginta): \"byggare\".","reference":{"chapter":49,"verse":17}},{"noteId":261,"caller":"-","text":"tyrannenAndra handskrifter: \"den som har segerns rätt\".","reference":{"chapter":49,"verse":24}},{"noteId":262,"caller":"-","text":"Citeras av Jesus i Matt 12:29, Mark 3:27, Luk 11:21 för att visa hans seger över Satan.","reference":{"chapter":49,"verse":25}}]},"thisChapterLink":"/api/swe_fol/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}