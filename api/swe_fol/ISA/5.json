{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["Sången om Herrens vingård"]},{"type":"verse","number":1,"content":["Nu vill jag sjunga",{"text":"om min älskade,","poem":2},{"lineBreak":true},{"text":"min älskades sång","poem":2},{"text":"om hans vingård:","poem":3},{"text":"Min älskade hade en vingård","poem":2},{"text":"på en bördig bergskulle.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Han grävde upp den","poem":1},{"text":"och rensade den från stenar","poem":3},{"text":"och planterade där","poem":2},{"text":"ädla vinstockar.","poem":3},{"text":"Han byggde ett vakttorn mitt i den","poem":2},{"text":"och högg ut ett presskar.","poem":3},{"text":"Sedan väntade han","poem":2},{"text":"att den skulle bära äkta druvor,","poem":3},{"text":"men den bar vilddruvor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Och nu, Jerusalems invånare","poem":1},{"text":"och Juda män,","poem":3},{"text":"döm mellan mig och min vingård.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vad mer kunde man","poem":1},{"text":"göra för min vingård","poem":2},{"text":"än vad jag har gjort för den?","poem":3},{"text":"Varför bar den vilddruvor,","poem":2},{"text":"när jag väntade","poem":3},{"text":"att den skulle bära äkta druvor?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nu ska jag låta er veta","poem":1},{"text":"vad jag ska göra med","poem":2},{"text":"min vingård:","poem":3},{"text":"Jag ska ta bort stängslet,","poem":2},{"text":"och den ska bli ödelagd.","poem":3},{"text":"Jag ska bryta ner muren,","poem":2},{"text":"och den ska bli nertrampad.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag ska ödelägga den,","poem":1},{"text":"ingen ska beskära den","poem":2},{"text":"eller gräva i den.","poem":3},{"text":"Men tistel och törne ska växa upp,","poem":2},{"text":"och jag ska befalla molnen","poem":3},{"text":"att inte låta det regna på den.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Herren Sebaots vingård","poem":1},{"text":"är Israels hus","poem":3},{"text":"och Juda folk","poem":2},{"text":"hans älsklingsplantering.","poem":3},{"text":"Han väntade laglydnad","poem":2},{"text":"men fann blodiga lagbrott,","poem":3},{"text":"han väntade rättfärdighet","poem":2},{"text":"men fann skriande","poem":3},{"text":"orättfärdighet.","poem":4}]},{"type":"heading","content":["Domsord över ogudaktigheten"]},{"type":"verse","number":8,"content":[{"text":"Ve er som lägger hus till hus","poem":1},{"text":"och fogar åker till åker","poem":3},{"text":"tills inget utrymme finns kvar","poem":2},{"text":"och ni är de enda","poem":3},{"text":"som bor i landet.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Från Herren Sebaot","poem":1},{"text":"ljuder det i mina öron:","poem":3},{"text":"Sannerligen, många hus ska bli öde,","poem":2},{"text":"stora och vackra hus","poem":3},{"text":"utan invånare.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"En vingård på tio plogland","poem":1},{"text":"ska bara ge ett batmått,","poem":3},{"noteId":26},{"text":"och en homers utsäde","poem":2},{"text":"ska bara ge en efa","poem":3},{"noteId":27},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ve dem som går upp tidigt","poem":1},{"text":"för att jaga efter starka drycker","poem":3},{"text":"och sitter uppe till sena natten,","poem":2},{"text":"heta av vin!","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Vid sina dryckeslag","poem":1},{"text":"har de harpa och lyra,","poem":2},{"text":"tamburin, flöjt och vin.","poem":3},{"text":"Men Herrens gärningar","poem":2},{"text":"bryr de sig inte om,","poem":3},{"text":"hans händers verk","poem":2},{"text":"intresserar dem inte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Därför ska mitt folk","poem":1},{"text":"föras bort i fångenskap,","poem":2},{"text":"för de saknar kunskap.","poem":3},{"text":"Dess ädlingar ska dö av hunger","poem":2},{"noteId":28},{"text":"och dess larmande skaror","poem":3},{"text":"förtorka av törst.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Därför ökar dödsriket sitt begär","poem":1},{"text":"och spärrar upp sitt gap","poem":2},{"text":"utan gräns.","poem":3},{"text":"Stadens främsta ska fara ner,","poem":2},{"text":"tillsammans med de larmande","poem":3},{"text":"och bullrande skaror","poem":4},{"text":"som jublar därinne.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Människorna blir nerböjda,","poem":1},{"text":"var och en ödmjukad.","poem":3},{"text":"De stoltas ögon ska ödmjukas.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Men Herren Sebaot blir upphöjd","poem":1},{"text":"genom sin dom,","poem":3},{"text":"Gud, den Helige, visar sig helig","poem":2},{"text":"genom rättfärdighet.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Då ska lammen få beta","poem":1},{"text":"som på sin egen mark,","poem":3},{"text":"och på de rikas ödetomter","poem":2},{"text":"ska främlingar få sin föda.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ve dem som drar fram missgärning","poem":1},{"text":"med lögnens band","poem":3},{"text":"och synd som med vagnslinor,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"dem som säger:","poem":1},{"text":"\"Han får skynda sig,","poem":2},{"text":"han får utföra sitt verk snart","poem":3},{"text":"så att vi ser det!","poem":4},{"text":"Det som Israels Helige bestämt","poem":2},{"text":"får närma sig och komma","poem":3},{"text":"så att vi lär känna det!\"","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Ve dem som kallar det onda gott","poem":1},{"text":"och det goda ont,","poem":3},{"text":"som gör mörker till ljus","poem":2},{"text":"och ljus till mörker,","poem":3},{"text":"som gör bittert till sött","poem":2},{"text":"och sött till bittert!","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ve dem som är visa i sina egna ögon","poem":1},{"text":"och håller sig själva för kloka!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ve dem som är hjältar i att dricka vin","poem":1},{"text":"och duktiga på att blanda","poem":2},{"text":"starka drycker,","poem":3}]},{"type":"verse","number":23,"content":[{"text":"dem som frikänner den skyldige","poem":1},{"text":"för mutor","poem":3},{"text":"och berövar den rättfärdige","poem":2},{"text":"hans rätt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Som eldsflamman förtär strå","poem":1},{"text":"och halm sjunker ihop i lågan,","poem":3},{"text":"så ska deras rot ruttna bort","poem":2},{"text":"och deras blomning flyga i väg","poem":3},{"text":"som stoft,","poem":4},{"text":"eftersom de förkastade","poem":2},{"text":"Herren Sebaots lag","poem":3},{"text":"och föraktade Israels Heliges ord.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Därför brinner Herrens vrede","poem":1},{"text":"mot hans folk,","poem":3},{"text":"och han räcker ut sin hand mot det","poem":2},{"text":"och slår det","poem":3},{"text":"så att bergen darrar","poem":2},{"text":"och döda kroppar ligger","poem":3},{"text":"som orenhet på gatorna.","poem":4},{"text":"Med allt detta upphör inte","poem":2},{"text":"hans vrede,","poem":4},{"text":"hans hand är ännu uträckt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Han reser ett baner","poem":1},{"text":"för hednafolken i fjärran","poem":3},{"text":"och lockar på dem","poem":2},{"text":"från jordens ände.","poem":3},{"text":"Och se, de kommer snabbt","poem":2},{"text":"och med hast.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Ingen bland dem","poem":1},{"text":"är trött eller stapplar,","poem":4},{"text":"ingen slumrar eller sover.","poem":3},{"text":"Bältet runt deras höfter lossnar inte,","poem":2},{"text":"deras skoremmar går inte av.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Deras pilar är skarpa,","poem":1},{"text":"alla deras bågar är spända.","poem":3},{"text":"Hovarna på deras hästar","poem":2},{"text":"är som av flinta,","poem":3},{"text":"deras vagnshjul liknar","poem":2},{"text":"stormvinden.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Deras rop är som","poem":1},{"text":"en lejonhonas rytande,","poem":2},{"text":"de ryter som unga lejon.","poem":3},{"text":"De morrar och griper sitt rov","poem":2},{"text":"och bär bort det,","poem":3},{"text":"och ingen finns som räddar.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"På den dagen ska det dåna mot dem","poem":1},{"text":"som när havet dånar.","poem":3},{"text":"Ser man ut över landet","poem":2},{"text":"är där mörker och nöd,","poem":3},{"text":"ljuset förmörkas av töcken.","poem":2}]}],"footnotes":[{"noteId":26,"caller":"-","text":"plogland … batmåttEtt \"plogland\" var den yta som ett par oxar kunde plöja på en dag, kanske ett tunnland, och ett bat var troligen ca 22 liter. Skörden var kanske en tusendel av den normala.","reference":{"chapter":5,"verse":10}},{"noteId":27,"caller":"-","text":"homer … efaCa 220 och 22 liter. Normalt gav skörden tio gånger utsädet, här bara en tiondel.","reference":{"chapter":5,"verse":10}},{"noteId":28,"caller":"-","text":"ädlingar ska dö av hungerAnnan översättning: \"ädla män ska lida hunger\".","reference":{"chapter":5,"verse":13}}]},"thisChapterLink":"/api/swe_fol/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}