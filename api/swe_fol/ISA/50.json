{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Israels synd och tjänarens lydnad"]},{"type":"verse","number":1,"content":["Så säger Herren:",{"text":"Var finns er mors","poem":2},{"text":"skilsmässobrev","poem":4},{"text":"som jag förskjutit henne med?","poem":3},{"text":"Eller till vilken","poem":2},{"text":"av mina fordringsägare","poem":3},{"text":"har jag sålt er","poem":4},{"noteId":263},{"text":"?","poem":4},{"text":"Se, för era missgärningar","poem":2},{"text":"blev ni sålda,","poem":3},{"text":"och för era brott","poem":2},{"text":"blev er mor förskjuten.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Varför var ingen där när jag kom?","poem":1},{"text":"Varför svarade ingen","poem":2},{"text":"när jag ropade?","poem":3},{"text":"Är min arm för kort","poem":2},{"text":"för att friköpa er,","poem":3},{"text":"eller har jag ingen kraft","poem":2},{"text":"till att rädda?","poem":3},{"text":"Se, genom min befallning","poem":2},{"text":"torkar jag ut havet","poem":3},{"text":"och gör strömmar till öken.","poem":4},{"text":"Deras fiskar ruttnar","poem":2},{"text":"av brist på vatten och dör av törst.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Jag klär himlen i mörker","poem":1},{"text":"och ger den sorgdräkt att bära.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Herren Gud har gett mig","poem":1},{"text":"en tunga med lärdom,","poem":3},{"text":"så att jag förstår att hjälpa den trötte","poem":2},{"text":"med mina ord.","poem":3},{"text":"Han väcker varje morgon mitt öra,","poem":2},{"text":"väcker det till att lyssna","poem":3},{"text":"som lärjunge.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Herren Gud har öppnat mitt öra,","poem":1},{"text":"och jag har inte varit upprorisk,","poem":2},{"text":"jag har inte dragit mig undan.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag höll fram min rygg","poem":1},{"text":"åt dem som slog mig","poem":3},{"text":"och mina kinder","poem":2},{"text":"åt dem som ryckte ut","poem":3},{"text":"mina skäggstrån.","poem":4},{"text":"Jag dolde inte mitt ansikte","poem":2},{"text":"för hån och spott.","poem":3},{"noteId":264}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Herren Gud ska hjälpa mig,","poem":1},{"text":"därför behöver jag inte skämmas,","poem":3},{"text":"därför gör jag mitt ansikte","poem":2},{"text":"hårt som sten.","poem":3},{"text":"Jag vet att jag inte kommer på skam.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Den som förklarar mig rättfärdig","poem":1},{"text":"är nära.","poem":3},{"text":"Vem vill då gå till rätta med mig?","poem":2},{"text":"Låt oss träda fram tillsammans.","poem":3},{"text":"Vem är min motpart?","poem":2},{"text":"Låt honom komma fram till mig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Se, Herren Gud kommer","poem":1},{"text":"att hjälpa mig.","poem":2},{"text":"Vem ska då döma mig skyldig?","poem":3},{"text":"De ska alla slitas ut som kläder,","poem":2},{"text":"mal ska förtära dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vem bland er fruktar Herren","poem":1},{"text":"och hör hans tjänares röst?","poem":3},{"text":"Även om han vandrar i mörkret","poem":2},{"text":"och inte ser någon ljusning,","poem":3},{"text":"ska han förtrösta på Herrens namn","poem":2},{"text":"och stödja sig på sin Gud.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Men se, alla ni som tänder eld","poem":1},{"text":"och omger er","poem":2},{"text":"med brinnande pilar,","poem":3},{"text":"vandra ni i lågorna från er eld","poem":2},{"text":"bland de brinnande pilar ni tänt!","poem":3},{"text":"Av min hand ska detta drabba er:","poem":2},{"text":"ni ska ligga i plågor.","poem":3}]}],"footnotes":[{"noteId":263,"caller":"-","text":"sålt erEn skuldsatt människa kunde tvingas sälja sina barn (2 Kung 4:1, Neh 5:5).","reference":{"chapter":50,"verse":1}},{"noteId":264,"caller":"-","text":"Profetia om Kristi lidande (se Matt 26:67).","reference":{"chapter":50,"verse":6}}]},"thisChapterLink":"/api/swe_fol/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}