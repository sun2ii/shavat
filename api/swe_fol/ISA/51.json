{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Sions frälsning är Herrens verk"]},{"type":"verse","number":1,"content":["Hör på mig,",{"text":"ni som strävar","poem":2},{"text":"efter rättfärdighet,","poem":3},{"text":"ni som söker Herren!","poem":4},{"text":"Se på klippan ni är uthuggna ur","poem":2},{"text":"och på gruvan ni grävts fram ur.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Se på er fader Abraham","poem":1},{"text":"och på Sara som födde er.","poem":3},{"text":"För jag kallade honom","poem":2},{"text":"när han ännu var ensam,","poem":3},{"text":"och jag välsignade","poem":2},{"text":"och förökade honom.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ja, Herren tröstar Sion,","poem":1},{"text":"han ser med medlidande","poem":2},{"text":"på alla dess ruiner.","poem":3},{"text":"Han gör dess öken lik Eden,","poem":2},{"text":"dess ödemark","poem":3},{"text":"lik Herrens lustgård.","poem":4},{"text":"Fröjd och glädje ska höras därinne,","poem":2},{"text":"tacksägelse och lovsångsljud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hör på mig, du mitt folk,","poem":1},{"text":"lyssna till mig, du mitt folkslag","poem":3},{"noteId":265},{"text":",","poem":3},{"text":"för från mig ska undervisning gå ut,","poem":2},{"text":"jag ska sätta min rätt","poem":3},{"text":"till ett ljus för folken.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Min rättfärdighet är nära,","poem":1},{"text":"min frälsning är på väg,","poem":2},{"text":"och mina armar ska döma folken.","poem":3},{"text":"Kustländerna väntar på mig","poem":2},{"text":"och hoppas på min arm.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Lyft er blick till himlen","poem":1},{"text":"och se på jorden därnere,","poem":3},{"text":"för himlen ska försvinna som rök","poem":2},{"text":"och jorden nötas ut","poem":3},{"text":"som en klädnad.","poem":4},{"text":"Dess invånare ska dö som mygg.","poem":3},{"text":"Men min frälsning","poem":2},{"text":"ska bestå för evigt,","poem":3},{"text":"min rättfärdighet ska inte brytas ner.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hör på mig,","poem":1},{"text":"ni som känner rättfärdigheten,","poem":3},{"text":"du folk som har min undervisning","poem":2},{"text":"i ditt hjärta.","poem":3},{"text":"Var inte rädda för människors hån,","poem":2},{"text":"frukta inte deras förolämpningar,","poem":3}]},{"type":"verse","number":8,"content":[{"text":"för mal ska förtära dem","poem":1},{"text":"som en klädnad,","poem":2},{"text":"mott ska äta dem som ylle.","poem":3},{"text":"Men min rättfärdighet","poem":2},{"text":"ska bestå för evigt,","poem":3},{"text":"min frälsning från släkte till släkte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vakna, vakna, klä dig i kraft,","poem":1},{"text":"du Herrens arm!","poem":3},{"text":"Vakna som i forna dagar,","poem":2},{"text":"i gångna tider.","poem":3},{"text":"Var det inte du","poem":2},{"text":"som högg Rahab","poem":3},{"noteId":266},{"text":"i bitar,","poem":3},{"text":"som genomborrade draken?","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Var det inte du","poem":1},{"text":"som torkade ut havet,","poem":2},{"text":"det stora djupets vatten,","poem":3},{"text":"och gjorde havsdjupen till en väg","poem":2},{"text":"där de återlösta kunde gå fram?","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Så ska Herrens friköpta vända hem","poem":1},{"text":"och komma till Sion med jubel.","poem":3},{"text":"Evig glädje ska kröna","poem":2},{"text":"deras huvuden,","poem":3},{"text":"de ska få fröjd och glädje,","poem":2},{"text":"men sorg och suckan ska fly.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jag, jag är den som tröstar er.","poem":1},{"text":"Vem är då du, att du fruktar","poem":2},{"text":"människor som ska dö,","poem":3},{"text":"människobarn som torkar","poem":2},{"text":"som gräs,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"att du glömmer Herren din Skapare","poem":1},{"text":"som har spänt ut himlen","poem":3},{"text":"och lagt jordens grund,","poem":4},{"text":"att du ständigt dagen lång","poem":2},{"text":"är rädd för förtryckarens vrede,","poem":3},{"text":"när han är redo att fördärva?","poem":4},{"text":"Var är nu förtryckarens vrede?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Snart blir fången fri.","poem":1},{"text":"Han ska inte dö och läggas i graven,","poem":2},{"text":"han ska inte lida brist på bröd.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Jag är Herren din Gud,","poem":1},{"text":"han som rör upp havet","poem":2},{"text":"så att dess vågor dånar,","poem":3},{"text":"Herren Sebaot är hans namn.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jag har lagt mina ord i din mun","poem":1},{"text":"och täckt dig med skuggan","poem":3},{"text":"av min hand,","poem":4},{"text":"för att plantera himlen","poem":2},{"text":"och grunda jorden","poem":3},{"text":"och säga till Sion: Du är mitt folk.","poem":2}]},{"type":"heading","content":["Herrens vredesbägare"]},{"type":"verse","number":17,"content":[{"text":"Vakna, vakna! Res dig, Jerusalem,","poem":1},{"text":"du som av Herrens hand","poem":2},{"text":"har fått dricka","poem":3},{"text":"hans vredes bägare,","poem":4},{"text":"du som har tömt","poem":2},{"text":"berusningens bägare","poem":3},{"text":"till sista droppen.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Av alla de söner hon fött","poem":1},{"text":"var det ingen som ledde henne,","poem":3},{"text":"av alla de söner hon fostrat","poem":2},{"text":"var det ingen som tog henne","poem":3},{"text":"i handen.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Dubbel olycka har drabbat dig,","poem":1},{"text":"vem har medkänsla med dig?","poem":3},{"text":"Förödelse och förstöring,","poem":2},{"text":"svält och svärd –","poem":3},{"text":"hur ska jag","poem":2},{"noteId":267},{"text":"trösta dig?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dina söner var utslagna,","poem":1},{"text":"de låg vid alla gathörn","poem":3},{"text":"som antiloper i nät,","poem":4},{"text":"fullt drabbade av Herrens vrede,","poem":2},{"text":"av din Guds bestraffning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Så hör nu detta, du plågade","poem":1},{"text":"som är drucken, men inte av vin:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Så säger Herren,","poem":1},{"text":"din Herre och Gud","poem":2},{"text":"som utför sitt folks sak:","poem":3},{"text":"Se, jag tar bort berusningens bägare","poem":2},{"text":"ur din hand,","poem":3},{"text":"du ska inte dricka mer","poem":2},{"text":"av min vredes bägare.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Jag ska sätta den i handen","poem":1},{"text":"på dina plågare, de som sade till dig:","poem":2},{"text":"\"Fall ner, vi ska gå fram","poem":3},{"text":"över dig!\"","poem":4},{"text":"Så gjorde du din rygg till mark,","poem":2},{"text":"en gata för dem att gå på.","poem":3}]}],"footnotes":[{"noteId":265,"caller":"-","text":"du mitt folk … du mitt folkslagAndra handskrifter: \"ni folk … ni folkslag\".","reference":{"chapter":51,"verse":4}},{"noteId":266,"caller":"-","text":"RahabBetyder \"övermod\", ett symboliskt namn för Egypten (30:7).","reference":{"chapter":51,"verse":9}},{"noteId":267,"caller":"-","text":"hur ska jagJesajarullen från Qumran och tidiga översättningar: \"vem kan\".","reference":{"chapter":51,"verse":19}}]},"thisChapterLink":"/api/swe_fol/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}