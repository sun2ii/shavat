{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"heading","content":["Glädjebudet om Sions återlösning"]},{"type":"verse","number":1,"content":["Vakna, vakna!",{"text":"Klä dig i din styrka, Sion,","poem":2},{"text":"klä dig i din högtidsskrud,","poem":3},{"text":"Jerusalem, du heliga stad,","poem":4},{"text":"för ingen oomskuren eller oren","poem":2},{"text":"ska mer komma in i dig.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Skaka av dig stoftet,","poem":1},{"text":"res dig och ta din plats,","poem":2},{"text":"Jerusalem.","poem":3},{"text":"Lös banden från din hals,","poem":2},{"text":"du fångna dotter Sion,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"för så säger Herren:","poem":1},{"text":"Ni blev sålda för ingenting,","poem":3},{"text":"och ni ska också bli återlösta","poem":2},{"text":"utan pengar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Så säger Herren Gud:","poem":1},{"text":"Först drog mitt folk ner till Egypten","poem":2},{"text":"och bodde där som främlingar,","poem":3},{"text":"sedan förtryckte Assur dem","poem":2},{"text":"utan orsak.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Vad har jag nu här? säger Herren.","poem":1},{"text":"Mitt folk har förts bort","poem":3},{"text":"utan skäl.","poem":4},{"text":"De som härskar över dem skränar,","poem":2},{"text":"säger Herren,","poem":3},{"text":"och mitt namn hånas ständigt,","poem":2},{"text":"dagen lång.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Därför ska mitt folk","poem":1},{"text":"få lära känna mitt namn,","poem":3},{"text":"därför ska de på den dagen förstå","poem":2},{"text":"att jag är den som talar:","poem":3},{"text":"Här är jag!","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hur ljuvliga är inte","poem":1},{"text":"glädjebudbärarens steg","poem":3},{"text":"när han kommer över bergen","poem":2},{"text":"och förkunnar frid,","poem":3},{"text":"bär fram goda nyheter","poem":2},{"text":"och förkunnar frälsning","poem":3},{"text":"och säger till Sion:","poem":2},{"text":"\"Din Gud är kung!\"","poem":3},{"noteId":268}]},{"type":"verse","number":8,"content":[{"text":"Hör, dina väktare ropar","poem":1},{"text":"med hög röst,","poem":4},{"text":"de jublar tillsammans,","poem":3},{"text":"för de ska med egna ögon få se","poem":2},{"text":"Herren vända tillbaka till Sion.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Brist ut i jubel tillsammans,","poem":1},{"text":"ni Jerusalems ruiner,","poem":3},{"text":"för Herren tröstar sitt folk,","poem":2},{"text":"han återlöser Jerusalem.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Herren visar sin heliga arm","poem":1},{"text":"inför alla folkens ögon,","poem":3},{"text":"alla jordens ändar ska se","poem":2},{"text":"vår Guds frälsning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dra bort! Dra bort! Gå ut därifrån!","poem":1},{"text":"Rör inte vid något orent!","poem":3},{"text":"Gå ut från henne!","poem":2},{"text":"Rena er, ni som bär Herrens kärl","poem":3},{"noteId":269},{"text":".","poem":3},{"noteId":270}]},{"type":"verse","number":12,"content":[{"text":"Ni ska inte dra ut med hast","poem":1},{"text":"och inte gå bort som flyktingar,","poem":3},{"text":"för Herren går framför er","poem":2},{"text":"och Israels Gud är sist i ert tåg.","poem":3}]},{"type":"heading","content":["Tjänarens lidande och härlighet"]},{"type":"verse","number":13,"content":[{"text":"Se, min tjänare ska handla vist","poem":1},{"noteId":271},{"text":".","poem":1},{"text":"Han ska bli hög och upphöjd,","poem":2},{"text":"mycket hög.","poem":3},{"noteId":272}]},{"type":"verse","number":14,"content":[{"text":"Liksom många häpnade över dig,","poem":1},{"text":"så ska hans utseende","poem":2},{"text":"fördärvas","poem":3},{"noteId":273},{"text":"mer än människors","poem":3},{"text":"och hans gestalt","poem":2},{"text":"mer än Adams barn.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Så ska han bestänka","poem":1},{"noteId":274},{"text":"många folk.","poem":1},{"text":"Inför honom ska kungar","poem":2},{"text":"förstummas,","poem":3},{"text":"för de får se något","poem":2},{"text":"som aldrig berättats för dem","poem":3},{"text":"och förstå något de aldrig har hört.","poem":2},{"noteId":275}]}],"footnotes":[{"noteId":268,"caller":"-","text":"Citeras av Paulus i Rom 10:15.","reference":{"chapter":52,"verse":7}},{"noteId":269,"caller":"-","text":"Herrens kärlGudstjänstföremålen som hade rövats bort (2 Krön 36:18, Esra 1:7f).","reference":{"chapter":52,"verse":11}},{"noteId":270,"caller":"-","text":"Citeras av Paulus i 2 Kor 6:17.","reference":{"chapter":52,"verse":11}},{"noteId":271,"caller":"-","text":"handla vistAnnan översättning: \"ha framgång\".","reference":{"chapter":52,"verse":13}},{"noteId":272,"caller":"-","text":"Avsnittet med Jes 53 utgör centrum i Jes 40-66 (se not till 57:21).","reference":{"chapter":52,"verse":13}},{"noteId":273,"caller":"-","text":"hans utseende fördärvasAnnan översättning: \"hans framträdande förvrängas\".","reference":{"chapter":52,"verse":14}},{"noteId":274,"caller":"-","text":"bestänkaRena med förbundsblod (2 Mos 24:8, 1 Petr 1:2) eller reningsvatten (4 Mos 19:17).","reference":{"chapter":52,"verse":15}},{"noteId":275,"caller":"-","text":"Annan översättning (så Septuaginta): \"… för de som aldrig fått det berättat får se, och de som aldrig fått höra förstår\". Citeras så av Paulus i Rom 15:21.","reference":{"chapter":52,"verse":15}}]},"thisChapterLink":"/api/swe_fol/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}