{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Sions upprättelse"]},{"type":"verse","number":1,"content":["Jubla, du ofruktsamma,",{"text":"du som inte har fött barn!","poem":3},{"text":"Brist ut i jubel och ropa av fröjd,","poem":2},{"text":"du som inte har haft födslovärkar,","poem":3},{"text":"för den ensamma har många barn,","poem":2},{"text":"fler än den som har en man,","poem":3},{"text":"säger Herren.","poem":4},{"noteId":287}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Utvidga platsen för ditt tält,","poem":1},{"text":"spänn ut tältdukarna där du bor","poem":2},{"text":"och håll inte tillbaka.","poem":3},{"text":"Gör dina tältlinor långa","poem":2},{"text":"och dina pluggar starka,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"för du ska breda ut dig","poem":1},{"text":"åt både höger och vänster","poem":3},{"noteId":288},{"text":".","poem":3},{"text":"Dina avkomlingar","poem":2},{"text":"ska få hedningar som arv","poem":3},{"text":"och på nytt befolka","poem":2},{"text":"ödelagda städer.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Var inte rädd,","poem":1},{"text":"för du ska inte behöva skämmas.","poem":3},{"text":"Var inte blyg,","poem":2},{"text":"för du ska inte bli förödmjukad.","poem":3},{"text":"Nej, du ska glömma","poem":2},{"text":"din ungdoms skam,","poem":3},{"text":"och din änketids förakt","poem":2},{"text":"ska du inte minnas mer,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"för han som skapat dig är din man,","poem":1},{"text":"Herren Sebaot är hans namn.","poem":3},{"text":"Israels Helige är din återlösare,","poem":2},{"text":"han som kallas hela jordens Gud.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Som en övergiven kvinna i hjärtesorg","poem":1},{"text":"kallade Herren dig,","poem":3},{"text":"och som en förkastad","poem":2},{"text":"ungdomshustru,","poem":3},{"text":"säger din Gud.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ett kort ögonblick övergav jag dig,","poem":1},{"text":"men i stor barmhärtighet","poem":2},{"text":"vill jag nu samla dig.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"När min vrede vällde fram","poem":1},{"text":"dolde jag ett ögonblick","poem":2},{"text":"mitt ansikte för dig,","poem":3},{"text":"men nu vill jag med evig nåd","poem":2},{"text":"förbarma mig över dig,","poem":3},{"text":"säger Herren din återlösare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jag ska göra som vid Noas flod.","poem":1},{"text":"Liksom jag gav min ed","poem":2},{"text":"att Noas flod inte mer","poem":3},{"text":"skulle drabba jorden,","poem":4},{"text":"så ger jag nu min ed att inte mer","poem":2},{"text":"vredgas på dig eller bestraffa dig.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Även om bergen viker bort","poem":1},{"text":"och höjderna vacklar,","poem":3},{"text":"så ska min nåd inte vika från dig","poem":2},{"text":"eller mitt fridsförbund vackla,","poem":3},{"text":"säger Herren din förbarmare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Du arma, så drabbad av stormar","poem":1},{"text":"utan att få någon tröst,","poem":3},{"text":"nu ska jag mura dina stenar","poem":2},{"text":"med spetsglans","poem":3},{"noteId":289},{"text":"och lägga din grund med safirer.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jag ska göra dina tinnar av rubiner,","poem":1},{"text":"dina portar av kristall","poem":3},{"noteId":290},{"text":"och hela din ringmur av ädla stenar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Alla dina barn","poem":1},{"text":"ska bli Herrens lärjungar,","poem":3},{"text":"och dina barns frid ska vara stor.","poem":2},{"noteId":291}]},{"type":"verse","number":14,"content":[{"text":"I rättfärdighet ska du bli befäst.","poem":1},{"text":"Förtryck ska vara fjärran från dig,","poem":2},{"text":"du har inget att frukta.","poem":3},{"text":"Skräcken ska vara borta,","poem":2},{"text":"den ska inte komma dig nära.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Om någon angriper dig","poem":1},{"text":"kommer det inte från mig,","poem":3},{"text":"den som angriper dig","poem":2},{"text":"ska falla för dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Se, jag skapar smeden,","poem":1},{"text":"som blåser upp kolelden","poem":3},{"text":"och formar ett vapen","poem":2},{"text":"genom sitt arbete.","poem":3},{"text":"Jag skapar också fördärvaren","poem":2},{"text":"till att förstöra.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Inget vapen som smids mot dig","poem":1},{"text":"ska ha framgång,","poem":3},{"text":"och varje tunga som angriper dig","poem":2},{"text":"ska du i domen döma skyldig.","poem":3},{"text":"Detta är Herrens tjänares arvedel,","poem":2},{"text":"och deras rättfärdighet","poem":3},{"text":"kommer från mig, säger Herren.","poem":2}]}],"footnotes":[{"noteId":287,"caller":"-","text":"Citeras av Paulus i Gal 4:27 som profetia om den Kristustroende församlingen.","reference":{"chapter":54,"verse":1}},{"noteId":288,"caller":"-","text":"höger … vänsterKan syfta på söder och norr, eftersom man var \"orienterad\" mot öst.","reference":{"chapter":54,"verse":3}},{"noteId":289,"caller":"-","text":"spetsglansAntimon, mörkt färgämne som användes mellan mosaikstenar och även som ögonskugga.","reference":{"chapter":54,"verse":11}},{"noteId":290,"caller":"-","text":"kristallSå Septuaginta. Grundtexten svårtolkad.","reference":{"chapter":54,"verse":12}},{"noteId":291,"caller":"-","text":"Citeras av Jesus i Joh 6:45.","reference":{"chapter":54,"verse":13}}]},"thisChapterLink":"/api/swe_fol/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}