{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Inbjudan till dem som törstar"]},{"type":"verse","number":1,"content":["Hör, alla ni som törstar,",{"text":"kom till vattnet!","poem":3},{"text":"Och ni som inte har pengar,","poem":2},{"text":"kom och köp säd och ät!","poem":3},{"text":"Ja, kom och köp säd utan pengar","poem":2},{"text":"och vin och mjölk för ingenting.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Varför ger ni pengar","poem":1},{"text":"för det som inte är bröd,","poem":3},{"text":"era inkomster","poem":2},{"text":"för det som inte mättar?","poem":3},{"text":"Hör på mig, så får ni äta gott","poem":2},{"text":"och er själ njuta av feta rätter.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Vänd ert öra hit och kom till mig!","poem":1},{"text":"Hör, så får er själ leva!","poem":3},{"text":"Jag vill sluta ett evigt förbund","poem":2},{"text":"med er,","poem":3},{"text":"den trofasta nåd","poem":2},{"text":"som jag lovade David.","poem":3},{"noteId":292}]},{"type":"verse","number":4,"content":[{"text":"Se, honom har jag satt","poem":1},{"text":"till ett vittne för folken,","poem":2},{"text":"till en furste och ledare för folken.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Du ska kalla på ett folk","poem":1},{"text":"du inte känner,","poem":3},{"text":"ett hednafolk som inte känner dig","poem":2},{"text":"ska skynda till dig","poem":3},{"text":"för Herren din Guds skull,","poem":2},{"text":"Israels Helige,","poem":3},{"text":"för han har förhärligat dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sök Herren","poem":1},{"text":"medan han låter sig finnas,","poem":3},{"text":"åkalla honom medan han är nära.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Den ogudaktige ska lämna sin väg,","poem":1},{"text":"den orättfärdige sina tankar","poem":3},{"text":"och vända om till Herren,","poem":2},{"text":"så ska han förbarma sig","poem":3},{"text":"över honom,","poem":4},{"text":"och till vår Gud,","poem":2},{"text":"för han vill gärna förlåta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mina tankar är inte era tankar,","poem":1},{"text":"och era vägar är inte mina vägar,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Nej, liksom himlen","poem":1},{"text":"är högre än jorden,","poem":3},{"text":"så är mina vägar högre än era vägar","poem":2},{"text":"och mina tankar högre än","poem":3},{"text":"era tankar.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Liksom regnet och snön","poem":1},{"text":"faller från himlen","poem":3},{"text":"och inte återvänder dit","poem":2},{"text":"utan vattnar jorden","poem":3},{"text":"så att den blir fruktbar och grönskar","poem":2},{"text":"och ger säd till att så","poem":3},{"text":"och bröd till att äta,","poem":4},{"noteId":293}]},{"type":"verse","number":11,"content":[{"text":"så ska det vara med ordet","poem":1},{"text":"som går ut från min mun.","poem":3},{"text":"Det ska inte komma tillbaka","poem":2},{"text":"till mig förgäves","poem":3},{"text":"utan att ha gjort vad jag vill","poem":2},{"text":"och utfört vad jag sänt det till.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Med glädje ska ni dra ut,","poem":1},{"text":"i frid ska ni föras fram.","poem":3},{"text":"Bergen och höjderna","poem":2},{"text":"ska brista ut i jubel inför er,","poem":3},{"text":"markens alla träd","poem":2},{"text":"ska klappa i händerna.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"I stället för törnsnår","poem":1},{"text":"ska cypresser växa upp,","poem":3},{"text":"i stället för nässlor","poem":2},{"text":"ska myrten växa upp.","poem":3},{"text":"Det ska bli till ära för Herren,","poem":2},{"text":"ett evigt tecken","poem":3},{"text":"som inte ska utplånas.","poem":4}]}],"footnotes":[{"noteId":292,"caller":"-","text":"den trofasta nåd som jag lovade DavidMessiaslöftet i 2 Sam 7:12f (särskilt vers 14-15). Citeras av Paulus i Apg 13:34 som profetia om Messias.","reference":{"chapter":55,"verse":3}},{"noteId":293,"caller":"-","text":"Citeras av Paulus i 2 Kor 9:10.","reference":{"chapter":55,"verse":10}}]},"thisChapterLink":"/api/swe_fol/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}