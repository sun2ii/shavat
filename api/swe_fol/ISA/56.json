{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Guds frälsning gäller alla"]},{"type":"verse","number":1,"content":["Så säger Herren:",{"text":"Håll fast vid det som är rätt,","poem":2},{"text":"handla rättfärdigt,","poem":3},{"text":"för snart ska min frälsning komma","poem":2},{"text":"och min rättfärdighet","poem":3},{"text":"uppenbaras.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Salig är den människa som gör så,","poem":1},{"text":"den människoson","poem":2},{"text":"som håller fast vid det,","poem":3},{"text":"som tar vara på sabbaten","poem":2},{"text":"och inte ohelgar den,","poem":3},{"text":"som avhåller sin hand","poem":2},{"text":"från att göra något ont.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Främlingen som sluter sig","poem":1},{"text":"till Herren ska inte säga:","poem":3},{"text":"\"Herren kommer att skilja mig","poem":2},{"text":"från sitt folk.\"","poem":3},{"text":"Inte heller ska eunucken","poem":2},{"noteId":294},{"text":"säga:","poem":2},{"text":"\"Jag är ett förtorkat träd.\"","poem":3}]},{"type":"verse","number":4,"content":[{"text":"För så säger Herren:","poem":1},{"text":"De eunucker","poem":2},{"noteId":295},{"text":"som tar vara","poem":2},{"text":"på mina sabbater,","poem":3},{"text":"som väljer det jag finner glädje i","poem":2},{"text":"och håller fast vid mitt förbund,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"åt dem ska jag","poem":1},{"text":"i mitt hus och inom mina murar","poem":3},{"text":"ge ett minnesmärke och ett namn,","poem":2},{"text":"en välsignelse som är bättre","poem":3},{"text":"än söner och döttrar.","poem":4},{"text":"Jag ska ge dem ett evigt namn","poem":2},{"text":"som inte ska utplånas.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"De främlingar som sluter sig","poem":1},{"text":"till Herren","poem":3},{"text":"och vill tjäna honom","poem":2},{"text":"och älska Herrens namn","poem":3},{"text":"och vara hans tjänare,","poem":4},{"text":"alla som tar vara på sabbaten","poem":2},{"text":"och inte ohelgar den,","poem":3},{"text":"som håller fast vid mitt förbund,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"dem ska jag föra till mitt heliga berg","poem":1},{"text":"och ge dem glädje","poem":2},{"text":"i mitt bönehus.","poem":3},{"text":"Deras brännoffer och slaktoffer","poem":2},{"text":"ska tas emot på mitt altare,","poem":3},{"text":"för mitt hus ska kallas","poem":2},{"text":"ett bönens hus för alla folk.","poem":3},{"noteId":296}]},{"type":"verse","number":8,"content":[{"text":"Så säger Herren Gud,","poem":1},{"text":"han som samlar Israels fördrivna:","poem":3},{"text":"Ännu fler ska jag samla till honom,","poem":2},{"text":"till hans församling.","poem":3}]},{"type":"heading","content":["Israels väktare är blinda"]},{"type":"verse","number":9,"content":[{"text":"Alla ni markens vilda djur,","poem":1},{"text":"kom och ät,","poem":3},{"text":"alla ni vilda djur i skogen!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hans väktare är alla blinda,","poem":1},{"text":"de märker ingenting.","poem":3},{"text":"De är alla stumma hundar","poem":2},{"text":"som inte kan skälla.","poem":3},{"text":"De ligger och drömmer,","poem":2},{"text":"de älskar att slumra.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Men de är glupska hundar,","poem":1},{"text":"de blir aldrig mätta.","poem":3},{"text":"Och de ska vara herdar,","poem":2},{"text":"de som inget förstår!","poem":3},{"text":"Alla går sin egen väg,","poem":2},{"text":"var och en söker sin egen fördel,","poem":3},{"text":"allesammans.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"\"Kom, jag hämtar vin,","poem":1},{"text":"vi berusar oss med starka drycker!","poem":3},{"text":"Och morgondagen ska bli","poem":2},{"text":"som i dag,","poem":3},{"text":"ja, ännu bättre!\"","poem":4}]}],"footnotes":[{"noteId":294,"caller":"-","text":"främlingen … eunuckenHade begränsat tillträde till templet (5 Mos 23) men tillbad på hedningarnas förgård. Se t ex 1 Kung 8:41f, Apg 8:27, Ef 2:11f.","reference":{"chapter":56,"verse":3}},{"noteId":295,"caller":"-","text":"eunuckerKastrerade män (jfr Matt 19:12), inte ovanligt bland Orientens hovmän (Apg 8:27).","reference":{"chapter":56,"verse":4}},{"noteId":296,"caller":"-","text":"Citeras av Jesus vid tempelrensningen i Matt 21:13, Mark 11:17, Luk 19:46.","reference":{"chapter":56,"verse":7}}]},"thisChapterLink":"/api/swe_fol/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}