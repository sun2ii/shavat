{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"heading","content":["Israels trolöshet och avgudadyrkan"]},{"type":"verse","number":1,"content":["Den rättfärdige går under,",{"text":"men ingen bryr sig om det.","poem":3},{"text":"Fromma människor rycks bort,","poem":2},{"text":"utan att någon inser","poem":3},{"text":"att den rättfärdige tas bort","poem":2},{"text":"för att slippa ondskan.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Han går in i friden.","poem":1},{"text":"De som vandrar sin väg rakt fram","poem":2},{"text":"kommer till vila på sina läger.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Men ni, kom fram hit,","poem":1},{"text":"ni söner till spåkvinnor,","poem":3},{"text":"ni barn till äktenskapsbrytare","poem":2},{"text":"och prostituerade.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Vem gör ni er lustiga över?","poem":1},{"text":"Mot vem spärrar ni upp munnen","poem":2},{"text":"och räcker ut tungan?","poem":3},{"text":"Är ni inte upprorets barn,","poem":2},{"text":"lögnens avkomma,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"ni som under alla gröna träd","poem":1},{"text":"brinner av lust till avgudarna","poem":3},{"noteId":297},{"text":",","poem":3},{"text":"ni som slaktar era barn","poem":2},{"noteId":298},{"text":"i dalarna","poem":2},{"text":"nere i bergsklyftorna.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ravinens hala stenar är din del,","poem":1},{"text":"de, just de, är din lott.","poem":3},{"text":"Åt dem utgjuter du dryckesoffer","poem":2},{"text":"och bär fram matoffer.","poem":3},{"text":"Ska jag vara nöjd med sådant?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Du ordnade din bädd","poem":1},{"text":"på höga och stora berg,","poem":3},{"text":"dit gick du för att offra slaktoffer.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bakom dörren och dörrposten","poem":1},{"text":"satte du ditt minnestecken.","poem":3},{"text":"Du övergav mig, klädde av dig,","poem":2},{"text":"steg upp i din säng","poem":3},{"lineBreak":true},{"text":"och gjorde den rymlig.","poem":3},{"text":"Du ingick förbund med dem","poem":2},{"text":"som du älskade att gå i säng med,","poem":3},{"text":"du såg dem nakna.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Du gick till kungen","poem":1},{"noteId":299},{"text":"med olja","poem":1},{"text":"och använde många","poem":2},{"text":"väldoftande salvor.","poem":3},{"text":"Du sände dina budbärare","poem":2},{"text":"till fjärran land,","poem":3},{"text":"ja, ända ner till dödsriket.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Du blev trött av din långa färd,","poem":1},{"text":"men du sade inte:","poem":3},{"text":"\"Det är lönlöst.\"","poem":4},{"text":"Så länge du kunde röra din hand,","poem":2},{"text":"mattades du inte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vem var du rädd för och fruktade,","poem":1},{"text":"eftersom du bedrog mig?","poem":3},{"text":"Du har inte kommit ihåg mig","poem":2},{"text":"eller brytt dig om mig.","poem":3},{"text":"Jag har varit tyst,","poem":2},{"text":"och det sedan länge –","poem":3},{"text":"är det därför du inte fruktar mig?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Men jag ska visa hur det är","poem":1},{"text":"med din rättfärdighet","poem":2},{"text":"och dina verk,","poem":3},{"text":"de kommer inte att hjälpa dig.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"När du ropar","poem":1},{"text":"får din avgudasamling rädda dig.","poem":3},{"text":"En vind ska ta med dem allihop,","poem":2},{"text":"en fläkt ska föra bort dem.","poem":3},{"text":"Men den som tar sin tillflykt","poem":2},{"text":"till mig","poem":3},{"text":"ska få landet till arvedel","poem":2},{"text":"och mitt heliga berg","poem":3},{"text":"till besittning.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Man ska säga:","poem":1},{"text":"\"Bana väg, bana och röj väg!","poem":3},{"text":"Ta bort stötestenarna","poem":2},{"text":"från mitt folks väg!\"","poem":3}]},{"type":"verse","number":15,"content":[{"text":"För så säger den höge","poem":1},{"text":"och upphöjde,","poem":3},{"text":"han som tronar för evigt","poem":2},{"text":"och heter \"den Helige\":","poem":3},{"text":"Jag bor i det höga och heliga","poem":2},{"text":"men också hos den","poem":3},{"text":"som är förkrossad","poem":4},{"text":"och har en ödmjuk ande,","poem":3},{"text":"för att ge liv","poem":2},{"text":"åt de ödmjukas ande,","poem":3},{"text":"för att ge liv","poem":2},{"text":"åt de förkrossades hjärtan.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Jag ska inte gå till rätta för evigt,","poem":1},{"text":"inte ständigt vredgas,","poem":3},{"text":"för då skulle deras ande","poem":2},{"text":"försmäkta inför mig,","poem":3},{"text":"de själar som jag själv har skapat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Jag var vred","poem":1},{"text":"över hans girighetssynd,","poem":3},{"text":"jag slog honom och","poem":2},{"text":"dolde mig i min vrede.","poem":3},{"text":"Men han vände sig bort","poem":2},{"text":"och gick den väg han själv ville.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Jag har sett hans vägar,","poem":1},{"text":"men jag vill bota honom","poem":2},{"text":"och leda honom.","poem":3},{"text":"Jag vill ge tröst åt honom","poem":2},{"text":"och hans sörjande,","poem":3}]},{"type":"verse","number":19,"content":[{"text":"skapa lovsång på deras läppar,","poem":1},{"text":"frid för den som är fjärran","poem":2},{"text":"och frid för den som är nära,","poem":3},{"text":"säger Herren.","poem":4},{"text":"Jag ska bota honom.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Men de gudlösa","poem":1},{"text":"är som ett upprört hav","poem":2},{"text":"som inte kan vara stilla,","poem":3},{"text":"vars vågor rör upp dy och smuts.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Det finns ingen frid","poem":1},{"text":"för de ogudaktiga,","poem":3},{"text":"säger min Gud.","poem":4},{"noteId":300}]}],"footnotes":[{"noteId":297,"caller":"-","text":"brinner av lust till avgudarnaKananeiska fruktbarhetsriter (se Jer 2:20f, Hos 1-3).","reference":{"chapter":57,"verse":5}},{"noteId":298,"caller":"-","text":"slaktar era barnBarnoffer till dödsguden Molok (se 3 Mos 20:2f, Ps 106:37f, Jer 32:35).","reference":{"chapter":57,"verse":5}},{"noteId":299,"caller":"-","text":"kungenAnnan översättning: \"Molok\".","reference":{"chapter":57,"verse":9}},{"noteId":300,"caller":"-","text":"Jesaja 40-66 består av tre lika stora delar: Kap 40-48, 49-57 och 58-66. De två första delarna slutar på samma sätt, se 48:22 och 57:21. Varje del har en mittpunkt. Kap 49-57 består av 49-51, 52-54 och 55-57. Mittpunkten 52-54 har i sin tur en mittpunkt, 52:13-53:12, som består av fem lika stora delar med mittpunkten 53:4-6, vilket är centrum för hela 40-66.","reference":{"chapter":57,"verse":21}}]},"thisChapterLink":"/api/swe_fol/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}