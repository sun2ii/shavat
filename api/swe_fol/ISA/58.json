{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Falsk och äkta fasta"]},{"type":"verse","number":1,"content":["Ropa för full hals,",{"text":"håll inte tillbaka.","poem":3},{"text":"Höj din röst som en basun","poem":2},{"text":"och förkunna för mitt folk","poem":3},{"text":"deras brott,","poem":4},{"text":"för Jakobs hus deras synder.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"De söker mig dag efter dag","poem":1},{"text":"och vill gärna","poem":2},{"text":"lära känna mina vägar,","poem":3},{"text":"som om de vore ett folk","poem":2},{"text":"som handlar rättfärdigt","poem":3},{"text":"och inte överger","poem":2},{"text":"sin Guds domslut.","poem":3},{"text":"De frågar mig om rätta domslut","poem":2},{"text":"och vill komma nära Gud","poem":3},{"noteId":301},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"\"Varför fastar vi","poem":1},{"text":"när du inte ser det?","poem":3},{"text":"Varför späker vi oss","poem":2},{"text":"när du inte märker det?\"","poem":3},{"text":"Men se, på er fastedag","poem":2},{"text":"sköter ni era sysslor","poem":3},{"noteId":302},{"text":"och driver alla era arbetare hårt.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ni håller er fasta med gräl och bråk,","poem":1},{"text":"ni slåss med onda nävar.","poem":3},{"text":"Ni fastar i dag inte på sådant sätt","poem":2},{"text":"att er röst blir hörd i höjden.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Är det en sådan fasta jag vill ha,","poem":1},{"text":"en dag då människan","poem":2},{"text":"ödmjukar sig?","poem":3},{"text":"Att man hänger med huvudet","poem":2},{"text":"som ett sävstrå","poem":3},{"text":"och sitter i säck och aska,","poem":2},{"text":"kallar du det en fasta,","poem":3},{"text":"en dag som behagar Herren?","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nej, detta är den fasta jag vill ha:","poem":1},{"text":"Lossa orättfärdiga bojor,","poem":2},{"text":"lös okets band,","poem":3},{"text":"släpp de förtryckta fria,","poem":2},{"text":"bryt sönder alla ok!","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Dela ditt bröd med den hungrige,","poem":1},{"text":"ge de fattiga och hemlösa","poem":2},{"text":"en boning,","poem":3},{"text":"klä den nakne när du ser honom","poem":2},{"text":"och dra dig inte undan","poem":3},{"text":"för den som är ditt kött och blod.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Då ska ditt ljus bryta fram","poem":1},{"text":"som gryningen","poem":3},{"text":"och ditt helande växa fram","poem":2},{"text":"med hast.","poem":3},{"text":"Din rättfärdighet ska gå framför dig","poem":2},{"text":"och Herrens härlighet","poem":3},{"text":"följa i dina spår.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Då ska Herren svara","poem":1},{"text":"när du åkallar honom.","poem":3},{"text":"När du ropar, ska han säga:","poem":2},{"text":"\"Här är jag.\"","poem":3},{"text":"Om du gör dig av med alla ok,","poem":2},{"text":"om du slutar att peka finger","poem":3},{"noteId":303},{"text":"och tala onda ord,","poem":4}]},{"type":"verse","number":10,"content":[{"text":"om du delar med dig av vad du har","poem":1},{"text":"åt den hungrige","poem":2},{"text":"och mättar den som lider nöd,","poem":3},{"text":"då ska ditt ljus gå upp i mörkret","poem":2},{"text":"och din natt bli","poem":3},{"text":"som middagens ljus.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Och Herren ska alltid leda dig,","poem":1},{"text":"han ska mätta dig i ödemarken","poem":2},{"text":"och ge styrka åt benen i din kropp.","poem":3},{"text":"Du ska vara","poem":2},{"text":"som en vattenrik trädgård","poem":3},{"text":"och likna en källa","poem":2},{"text":"vars vatten aldrig sinar.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Dina avkomlingar","poem":1},{"text":"ska bygga upp de gamla ruinerna,","poem":3},{"text":"du ska återställa grundvalar","poem":2},{"text":"från forna generationer.","poem":3},{"text":"Du ska kallas","poem":2},{"text":"\"den som murar igen sprickor\",","poem":3},{"text":"\"den som återställer stigar","poem":2},{"text":"så att man kan bo i landet\".","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Om du hindrar din fot på sabbaten","poem":1},{"text":"från att sköta dina sysslor","poem":2},{"text":"på min heliga dag,","poem":3},{"text":"om du kallar sabbaten en fröjd,","poem":2},{"text":"helgad åt Herren och ärad,","poem":3},{"text":"om du ärar den","poem":2},{"text":"genom att inte gå egna vägar","poem":3},{"text":"och inte sköta dina sysslor","poem":2},{"text":"eller tala tomma ord,","poem":4}]},{"type":"verse","number":14,"content":[{"text":"då ska du få fröjda dig i Herren,","poem":1},{"text":"och jag ska föra dig fram","poem":2},{"text":"över landets höjder","poem":3},{"text":"och låta dig njuta","poem":2},{"text":"av din fader Jakobs arvedel.","poem":3},{"text":"Så har Herrens mun talat.","poem":2}]}],"footnotes":[{"noteId":301,"caller":"-","text":"komma nära GudAnnan översättning: \"att Gud ska komma nära\".","reference":{"chapter":58,"verse":2}},{"noteId":302,"caller":"-","text":"sköter ni era sysslorAnnan översättning: \"gör ni vad ni har lust med\" (även i vers 13).","reference":{"chapter":58,"verse":3}},{"noteId":303,"caller":"-","text":"peka fingerFörknippades med anklagelse och förbannelse.","reference":{"chapter":58,"verse":9}}]},"thisChapterLink":"/api/swe_fol/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}