{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Synd, bekännelse och frälsning"]},{"type":"verse","number":1,"content":["Se, Herrens hand är inte",{"text":"för kort för att frälsa,","poem":3},{"text":"hans öra är inte","poem":2},{"text":"för dövt för att höra.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Nej, det är era missgärningar","poem":1},{"text":"som skiljer er från er Gud,","poem":3},{"text":"era synder döljer","poem":2},{"text":"hans ansikte för er","poem":3},{"text":"så att han inte hör er.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"För era händer är fläckade av blod,","poem":1},{"text":"era fingrar av skuld.","poem":3},{"text":"Era läppar talar lögn,","poem":2},{"text":"er tunga bär fram ondska.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Ingen ropar efter rättfärdighet,","poem":1},{"text":"ingen dömer med sanning.","poem":3},{"text":"De litar till tomhet och talar lögn,","poem":2},{"text":"de går havande med olycka","poem":3},{"text":"och föder fördärv.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"De kläcker ormägg","poem":1},{"text":"och väver spindelnät.","poem":3},{"text":"Den som äter av deras ägg dör,","poem":2},{"text":"och krossas ett","poem":3},{"text":"kommer det ut en orm.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Deras spindelnät","poem":1},{"text":"duger inte till kläder,","poem":3},{"text":"de kan inte skyla sig själva","poem":2},{"text":"med vad de tillverkat.","poem":3},{"text":"Deras verk är ondskans verk,","poem":2},{"text":"deras händer utövar våld.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Deras fötter rusar","poem":1},{"text":"till det som är ont,","poem":3},{"text":"de är snabba","poem":2},{"text":"att spilla oskyldigt blod.","poem":3},{"text":"Deras tankar är fördärvets tankar,","poem":2},{"text":"förödelse och elände","poem":3},{"text":"råder på deras vägar.","poem":4},{"noteId":304}]},{"type":"verse","number":8,"content":[{"text":"Fridens väg känner de inte,","poem":1},{"text":"rätten följer inte i deras spår.","poem":3},{"text":"De går krokiga stigar,","poem":2},{"text":"ingen som vandrar dem","poem":3},{"text":"vet vad frid är.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Därför är rättvisan fjärran från oss,","poem":1},{"text":"rättfärdigheten når oss inte.","poem":3},{"text":"Vi väntar på ljus,","poem":2},{"text":"men här råder mörker,","poem":3},{"text":"på solsken,","poem":2},{"text":"men vi vandrar i dunkel.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Vi famlar som blinda längs väggen,","poem":1},{"text":"famlar som om vi inte hade ögon.","poem":3},{"text":"Vi stapplar mitt på dagen","poem":2},{"text":"som vore det skymning.","poem":3},{"text":"Bland de friska","poem":2},{"noteId":305},{"text":"är vi som döda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vi brummar alla som björnar","poem":1},{"text":"och kuttrar sorgset som duvor.","poem":3},{"text":"Vi väntar på rättvisa,","poem":2},{"text":"men den kommer inte,","poem":3},{"text":"efter frälsning,","poem":2},{"text":"men den är fjärran från oss.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Våra brott inför dig är många,","poem":1},{"text":"våra synder vittnar mot oss.","poem":3},{"text":"Våra brott följer med oss,","poem":2},{"text":"vi känner våra missgärningar.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Vi har gjort uppror","poem":1},{"text":"och förnekat Herren,","poem":3},{"text":"vi har vänt vår Gud ryggen.","poem":2},{"lineBreak":true},{"text":"Vi har talat förtryck och avfall,","poem":2},{"text":"tänkt ut och fört fram","poem":3},{"text":"lögnaktiga ord från våra hjärtan.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Rättvisan trängs tillbaka,","poem":1},{"text":"rättfärdigheten står långt borta,","poem":3},{"text":"för sanningen vacklar på torget,","poem":2},{"text":"det som är rätt","poem":3},{"text":"kan inte komma fram.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Sanningen har försvunnit,","poem":1},{"text":"och den som undviker det onda","poem":2},{"text":"blir plundrad.","poem":4},{"lineBreak":true},{"text":"Detta såg Herren,","poem":1},{"text":"och han var missnöjd med","poem":2},{"text":"att det inte fanns någon rättvisa.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Han såg att ingen steg fram,","poem":1},{"text":"han var förundrad","poem":2},{"text":"över att ingen grep in.","poem":3},{"text":"Då hjälpte honom hans egen arm,","poem":2},{"text":"och hans rättfärdighet","poem":3},{"text":"stödde honom.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Han klädde sig i rättfärdighet","poem":1},{"text":"som pansar","poem":3},{"text":"och satte frälsningens hjälm","poem":2},{"text":"på sitt huvud.","poem":3},{"text":"Han klädde sig i hämndens dräkt","poem":2},{"text":"som klädsel","poem":3},{"text":"och svepte sig i lidelse","poem":2},{"text":"som en mantel.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Efter deras gärningar","poem":1},{"text":"ska han löna dem,","poem":3},{"text":"med vrede över hans motståndare,","poem":2},{"text":"hämnd över hans fiender.","poem":3},{"text":"Han ska löna kustländerna","poem":2},{"text":"för vad de har gjort.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Så ska man frukta Herrens namn","poem":1},{"text":"i väster","poem":3},{"text":"och hans härlighet","poem":2},{"text":"där solen går upp.","poem":3},{"text":"När fienden bryter fram","poem":2},{"text":"som en flod,","poem":3},{"text":"ska Herrens Ande","poem":2},{"text":"driva honom på flykten.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Återlösaren ska komma till Sion","poem":1},{"text":"och till dem i Jakob som vänder om","poem":2},{"text":"från sitt uppror,","poem":3},{"text":"säger Herren.","poem":2},{"noteId":306}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Detta är mitt förbund med dem, säger Herren: Min Ande som är över dig och mina ord som jag har lagt i din mun ska inte vika ur din mun eller ur dina barns eller barnbarns mun, från nu och till evig tid, säger Herren."]}],"footnotes":[{"noteId":304,"caller":"-","text":"Citeras av Paulus i Rom 3:15f.","reference":{"chapter":59,"verse":7}},{"noteId":305,"caller":"-","text":"de friskaGrundtexten svårtolkad.","reference":{"chapter":59,"verse":10}},{"noteId":306,"caller":"-","text":"Citeras av Paulus i Rom 11:26f som profetia om Messias.","reference":{"chapter":59,"verse":20}}]},"thisChapterLink":"/api/swe_fol/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}