{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Sions kommande härlighet"]},{"type":"verse","number":1,"content":["Stå upp, stråla,",{"text":"för ditt ljus kommer","poem":3},{"text":"och Herrens härlighet","poem":2},{"text":"går upp över dig.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Se, mörker ska täcka jorden","poem":1},{"text":"och töcken folken,","poem":3},{"text":"men över dig ska Herren gå upp,","poem":2},{"text":"hans härlighet ska uppenbaras","poem":3},{"text":"över dig.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Hednafolk ska vandra i ditt ljus","poem":1},{"text":"och kungar i glansen","poem":2},{"text":"som går upp över dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lyft din blick och se dig omkring:","poem":1},{"text":"Alla samlas och kommer till dig.","poem":3},{"text":"Dina söner kommer från fjärran,","poem":2},{"text":"dina döttrar bärs fram på armen.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Då ska du se det","poem":1},{"text":"och stråla av fröjd,","poem":3},{"text":"ditt hjärta ska bäva och vidga sig,","poem":2},{"text":"för havets rikedomar","poem":3},{"text":"ska föras till dig,","poem":4},{"text":"folkens skatter ska tillfalla dig.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Skaror av kameler ska täcka dig,","poem":1},{"text":"unga kameler","poem":2},{"text":"från Midjan och Efa","poem":3},{"noteId":307},{"text":".","poem":3},{"text":"Från Saba","poem":2},{"noteId":308},{"text":"kommer de alla,","poem":2},{"text":"de bär guld och rökelse","poem":3},{"text":"och förkunnar Herrens lov.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Alla Kedars hjordar","poem":1},{"text":"ska samlas till dig,","poem":3},{"text":"Nebajots","poem":2},{"noteId":309},{"text":"baggar","poem":2},{"text":"ska stå till din tjänst.","poem":3},{"text":"De ska offras till välbehag","poem":2},{"text":"på mitt altare,","poem":3},{"text":"och jag ska förhärliga","poem":2},{"text":"min härlighets hus.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Vilka är dessa","poem":1},{"text":"som kommer flygande som moln,","poem":2},{"text":"som duvor till sitt duvslag?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Kustländerna hoppas på mig,","poem":1},{"text":"främst kommer Tarshishskepp","poem":3},{"noteId":310},{"text":"för att föra hem dina söner","poem":2},{"text":"från fjärran land.","poem":3},{"text":"De har med sig silver och guld","poem":2},{"text":"åt Herren din Guds namn,","poem":3},{"text":"åt Israels Helige,","poem":4},{"text":"för han förhärligar dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Främlingar ska bygga upp","poem":1},{"text":"dina murar","poem":3},{"text":"och deras kungar ska betjäna dig,","poem":2},{"text":"för jag slog dig i min vrede","poem":3},{"text":"men i min nåd","poem":2},{"text":"förbarmar jag mig över dig.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Dina portar ska ständigt stå öppna,","poem":1},{"text":"varken dag eller natt","poem":2},{"text":"ska de stängas,","poem":3},{"text":"så att folkens rikedomar","poem":2},{"text":"kan föras till dig","poem":3},{"text":"och deras kungar föras med i tåget.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"För det folk eller rike","poem":1},{"text":"som inte vill tjäna dig","poem":2},{"text":"ska gå under,","poem":3},{"text":"sådana folk ska förgöras helt.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Libanons härlighet","poem":1},{"noteId":311},{"text":"ska komma till dig,","poem":3},{"text":"både cypress och alm och buxbom,","poem":2},{"text":"för att pryda","poem":3},{"text":"min helgedoms plats.","poem":4},{"text":"Jag vill göra platsen för mina fötter","poem":2},{"text":"härlig.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Bugande ska dina förtryckares söner","poem":1},{"text":"komma till dig,","poem":3},{"text":"alla som föraktade dig","poem":2},{"text":"ska falla ner för dina fötter.","poem":3},{"text":"Och de ska kalla dig \"Herrens stad\",","poem":2},{"text":"\"Israels Heliges Sion\".","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"I stället för att du var övergiven","poem":1},{"text":"och hatad","poem":3},{"noteId":312},{"text":"så att ingen ville ta vägen","poem":2},{"text":"genom dig,","poem":3},{"text":"ska jag göra dig till härlighet","poem":2},{"text":"för evigt,","poem":3},{"text":"till en fröjd från släkte till släkte.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Du ska dia folkens mjölk,","poem":1},{"text":"kungabröst ska du dia.","poem":3},{"text":"Då ska du förstå att jag, Herren,","poem":2},{"text":"är din frälsare,","poem":3},{"text":"att Jakobs Mäktige","poem":2},{"text":"är din återlösare.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Jag ska ge guld i stället för koppar,","poem":1},{"text":"silver i stället för järn,","poem":2},{"text":"koppar i stället för trä","poem":3},{"text":"och järn i stället för sten.","poem":4},{"text":"Jag ska sätta friden till din överhet,","poem":2},{"text":"rättfärdigheten till din härskare.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Man ska inte mer höra om våld","poem":1},{"text":"i ditt land","poem":3},{"text":"eller förödelse och förstörelse","poem":2},{"text":"inom dina gränser,","poem":3},{"text":"utan du ska kalla dina murar","poem":2},{"text":"för frälsning","poem":3},{"text":"och dina portar för lovsång.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Solen ska inte mer vara ditt ljus","poem":1},{"text":"om dagen,","poem":3},{"text":"månen ska inte lysa dig","poem":2},{"text":"med sitt sken.","poem":3},{"text":"Herren ska vara ditt eviga ljus,","poem":2},{"text":"din Gud ska vara din härlighet.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Din sol ska inte mer gå ner,","poem":1},{"text":"din måne inte mer avta,","poem":3},{"text":"för Herren ska vara ditt eviga ljus","poem":2},{"text":"och dina sorgedagar ska vara slut.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Då ska alla i ditt folk vara rättfärdiga","poem":1},{"text":"och besitta landet för evigt,","poem":3},{"text":"som ett skott av min plantering,","poem":2},{"text":"som ett verk av mina händer","poem":3},{"text":"för att förhärliga mig.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"Av den minste ska det bli tusen,","poem":1},{"text":"av den ringaste ett stort folk.","poem":3},{"text":"Jag, Herren, ska låta det ske snabbt","poem":2},{"text":"när dess tid kommer.","poem":3}]}],"footnotes":[{"noteId":307,"caller":"-","text":"Midjan och EfaNomadstammar i nordvästra Saudiarabien (1 Mos 25:4, 2 Mos 2:15).","reference":{"chapter":60,"verse":6}},{"noteId":308,"caller":"-","text":"SabaHandelsrike i nuvarande Jemen, berömt för guld och rökelse (1 Kung 10, Hes 27:22).","reference":{"chapter":60,"verse":6}},{"noteId":309,"caller":"-","text":"Kedar … NebajotNordarabiska stammar (1 Mos 25:13, Hes 27:21).","reference":{"chapter":60,"verse":7}},{"noteId":310,"caller":"-","text":"TarshishskeppLångseglande handelsskepp. Tarshish låg någonstans i västra Medelhavet.","reference":{"chapter":60,"verse":9}},{"noteId":311,"caller":"-","text":"Libanons härlighetDet berömda cederträet prydde Salomos tempel (1 Kung 5:8f).","reference":{"chapter":60,"verse":13}},{"noteId":312,"caller":"-","text":"hatadAnnan översättning: \"försmådd\" (jfr not till Luk 14:26).","reference":{"chapter":60,"verse":15}}]},"thisChapterLink":"/api/swe_fol/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}