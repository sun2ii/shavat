{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Ett nådens år från Herren"]},{"type":"verse","number":1,"content":["Herren Guds Ande",{"text":"är över mig,","poem":3},{"text":"för Herren har smort mig","poem":2},{"noteId":313},{"text":"till att förkunna glädjens budskap","poem":3},{"text":"för de ödmjuka","poem":4},{"noteId":314},{"text":".","poem":4},{"text":"Han har sänt mig","poem":2},{"text":"att förbinda dem som har","poem":3},{"text":"förkrossade hjärtan,","poem":4},{"text":"att utropa frihet för de fångna","poem":2},{"text":"och befrielse för de bundna,","poem":3}]},{"type":"verse","number":2,"content":[{"text":"att förkunna ett nådens år","poem":1},{"text":"från Herren","poem":3},{"text":"och en hämndens dag","poem":2},{"text":"från vår Gud,","poem":3},{"text":"att trösta alla sörjande,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"att ge de sörjande i Sion","poem":1},{"text":"huvudprydnad i stället för aska,","poem":3},{"text":"glädjens olja i stället för sorg,","poem":2},{"text":"lovsångsdräkt i stället för","poem":3},{"text":"en modfälld ande.","poem":4},{"text":"Och de ska kallas","poem":2},{"text":"\"rättfärdighetens terebinter\",","poem":3},{"text":"planterade av Herren","poem":2},{"text":"till hans förhärligande.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"De ska bygga upp gamla ruiner,","poem":1},{"text":"upprätta det som förr legat öde.","poem":3},{"text":"De ska bygga upp","poem":2},{"text":"ruinstäderna igen,","poem":3},{"text":"platser som varit öde","poem":2},{"text":"i generation efter generation.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Främlingar ska stå och valla","poem":1},{"text":"era hjordar,","poem":3},{"text":"utlänningar sköta","poem":2},{"text":"era åkrar och vingårdar.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Och ni ska heta \"Herrens präster\",","poem":1},{"text":"man ska kalla er:","poem":2},{"text":"\"Vår Guds tjänare\".","poem":3},{"text":"Ni ska få njuta av","poem":2},{"text":"hednafolkens skatter","poem":3},{"text":"och ståta med deras härlighet.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ni ska få dubbelt igen för er skam,","poem":1},{"text":"och de som förödmjukades","poem":2},{"text":"ska nu jubla över sin del.","poem":3},{"text":"Därför ska de få en dubbel lott","poem":2},{"text":"i sitt land,","poem":3},{"text":"evig glädje ska de få,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"för jag, Herren, älskar det rätta","poem":1},{"text":"och hatar orättfärdigt rofferi.","poem":3},{"text":"Jag ska ge dem deras lön i trofasthet","poem":2},{"text":"och sluta ett evigt förbund","poem":3},{"text":"med dem.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Deras släkte ska vara känt","poem":1},{"text":"bland folken,","poem":4},{"text":"deras avkomma bland folkslagen.","poem":3},{"text":"Alla som ser dem ska förstå","poem":2},{"text":"att de är det släkte","poem":3},{"text":"som Herren har välsignat.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jag gläder mig stort i Herren,","poem":1},{"text":"min själ fröjdar sig i min Gud,","poem":3},{"text":"för han har klätt mig","poem":2},{"text":"i frälsningens klädnad","poem":3},{"text":"och svept in mig","poem":2},{"text":"i rättfärdighetens mantel,","poem":3},{"text":"som när brudgummen","poem":2},{"text":"sätter turbanen","poem":3},{"noteId":315},{"text":"på sitt huvud,","poem":3},{"text":"som när bruden","poem":2},{"text":"pryder sig med sina smycken.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"För liksom jorden","poem":1},{"text":"låter sina växter spira fram","poem":3},{"text":"och en trädgård","poem":2},{"text":"låter sin sådd växa upp,","poem":3},{"text":"så ska Herren Gud","poem":2},{"text":"låta rättfärdighet och lovsång","poem":3},{"text":"växa upp inför alla folk.","poem":4}]}],"footnotes":[{"noteId":313,"caller":"-","text":"smort migEtt uttryck för den helige Ande, beskydd och invigning till tjänst. Smörjelsen gavs till kungar (1 Sam 16:13, 1 Kung 1:39), präster (2 Mos 30:30f) och profeter (1 Kung 19:16, Ps 105:15). Jesus citerade versen (Luk 4:18f) och förklarade att den fått sin uppfyllelse i honom som Messias, den smorde (jfr Apg 10:38 samt 1 Joh 2:20).","reference":{"chapter":61,"verse":1}},{"noteId":314,"caller":"-","text":"ödmjukaAndra handskrifter (Septuaginta): \"fattiga\".","reference":{"chapter":61,"verse":1}},{"noteId":315,"caller":"-","text":"turbanenGrundtextens ord leder tanken till turbanen som bars av prästerna (2 Mos 29:6).","reference":{"chapter":61,"verse":10}}]},"thisChapterLink":"/api/swe_fol/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}