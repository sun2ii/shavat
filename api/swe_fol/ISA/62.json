{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Sions frälsning"]},{"type":"verse","number":1,"content":["För Sions skull",{"text":"vill jag inte tiga,","poem":3},{"text":"för Jerusalems skull","poem":2},{"text":"vill jag inte unna mig någon ro","poem":3},{"text":"förrän dess rättfärdighet","poem":2},{"text":"går upp som solens sken","poem":3},{"text":"och dess frälsning","poem":2},{"text":"som ett brinnande bloss.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Folken ska se din rättfärdighet","poem":1},{"text":"och alla kungar din härlighet.","poem":3},{"text":"Du ska få ett nytt namn,","poem":2},{"text":"som Herrens mun ska bestämma.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Du ska vara en härlig krona","poem":1},{"text":"i Herrens hand,","poem":3},{"text":"ett kungligt diadem","poem":2},{"text":"i din Guds hand.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Du ska inte mer kallas","poem":1},{"text":"\"den övergivna\",","poem":3},{"noteId":316},{"text":"ditt land ska inte mer kallas","poem":2},{"text":"\"ödemark\",","poem":3},{"text":"utan du ska heta \"min kära\"","poem":2},{"noteId":317},{"text":"och ditt land \"den äkta hustrun\",","poem":3},{"text":"för Herren har dig kär,","poem":2},{"text":"ditt land har fått sin äkta man.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"För som när en ung man","poem":1},{"text":"gifter sig med en jungfru,","poem":2},{"text":"så ska dina barn gifta sig med dig,","poem":3},{"text":"och som en brudgum","poem":2},{"text":"jublar över sin brud,","poem":3},{"text":"så ska din Gud jubla över dig.","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"På dina murar, Jerusalem,","poem":1},{"text":"har jag ställt väktare.","poem":3},{"text":"Varken dag eller natt","poem":2},{"text":"får de någonsin tystna.","poem":3},{"text":"Ni som ropar till Herren,","poem":2},{"text":"unna er ingen ro,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"och ge honom ingen ro","poem":1},{"text":"förrän han upprättar Jerusalem","poem":3},{"text":"och gör det till en lovsång","poem":2},{"text":"på jorden.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Herren har lovat med ed","poem":1},{"text":"vid sin högra hand","poem":2},{"text":"och sin starka arm:","poem":3},{"text":"Jag ska inte mer ge din säd","poem":2},{"text":"som mat åt dina fiender,","poem":3},{"text":"och främlingar ska inte dricka","poem":2},{"text":"ditt nya vin,","poem":3},{"text":"frukten av din möda.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"De som samlar in säden","poem":1},{"text":"ska få äta den och lova Herren,","poem":3},{"text":"och de som skördar vinet","poem":2},{"text":"ska få dricka det","poem":3},{"text":"på min helgedoms förgårdar","poem":4},{"noteId":318},{"text":".","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gå fram, fram genom portarna,","poem":1},{"text":"bana väg för folket!","poem":3},{"text":"Röj, röj en väg","poem":2},{"text":"och rensa bort stenarna,","poem":3},{"text":"res ett baner för folken!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Se, Herren förkunnar","poem":1},{"text":"till jordens ände:","poem":3},{"text":"Säg till dottern Sion:","poem":2},{"text":"Se, din frälsning kommer!","poem":3},{"text":"Se, han har med sig sin lön,","poem":2},{"text":"hans segerbyte","poem":3},{"text":"går framför honom.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Man ska kalla dem","poem":1},{"text":"\"det heliga folket\",","poem":2},{"text":"\"Herrens återlösta\".","poem":3},{"text":"Och du ska kallas","poem":2},{"text":"\"den eftersökta\",","poem":3},{"text":"\"staden som inte","poem":2},{"text":"blir övergiven\".","poem":3}]}],"footnotes":[{"noteId":316,"caller":"-","text":"den övergivnaHebr. Asuba, namnet på kung Joshafats drottning (1 Kung 22:42).","reference":{"chapter":62,"verse":4}},{"noteId":317,"caller":"-","text":"min käraHebr. Hefsi-Ba, drottningens namn under Jesajas tid (2 Kung 21:1).","reference":{"chapter":62,"verse":4}},{"noteId":318,"caller":"-","text":"äta … lova … dricka … förgårdarTecken på ett upprättat gudstjänstliv (5 Mos 8:10, 14:23).","reference":{"chapter":62,"verse":9}}]},"thisChapterLink":"/api/swe_fol/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}