{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["Vredens och frälsningens dag"]},{"type":"verse","number":1,"content":["Vem är han som kommer",{"text":"från Edom,","poem":2},{"text":"från Bosra","poem":3},{"noteId":319},{"text":"i högröda kläder,","poem":3},{"text":"så ståtlig i sin dräkt,","poem":2},{"text":"så stolt i sin stora kraft?","poem":3},{"text":"\"Det är jag som talar i rättfärdighet,","poem":2},{"text":"som är mäktig att frälsa.\"","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Varför är din dräkt så röd,","poem":1},{"text":"varför liknar dina kläder","poem":2},{"text":"en vintrampares?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"\"Jag har trampat vinpressen själv,","poem":1},{"text":"ingen bland folken hjälpte mig.","poem":3},{"text":"Jag trampade dem i min vrede,","poem":2},{"text":"trampade sönder dem i min harm.","poem":3},{"text":"Deras blod stänkte på mina kläder,","poem":2},{"text":"och jag fick","poem":3},{"text":"hela min dräkt fläckad.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"För hämndens dag var i mitt hjärta","poem":1},{"text":"och året för min återlösning","poem":2},{"text":"hade kommit.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Jag såg mig omkring,","poem":1},{"text":"men det fanns ingen hjälpare.","poem":3},{"text":"Jag stod där förundrad,","poem":2},{"text":"men det fanns ingen","poem":3},{"text":"som stödde mig.","poem":4},{"text":"Då hjälpte mig min egen arm,","poem":2},{"text":"och min vrede stödde mig.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag trampade ner folken i min vrede","poem":1},{"text":"och gjorde dem druckna","poem":2},{"text":"i min harm,","poem":3},{"text":"jag lät deras blod rinna ner","poem":2},{"text":"på jorden.\"","poem":3}]},{"type":"heading","content":["Ånger och bön om frälsning"]},{"type":"verse","number":7,"content":[{"text":"Jag vill förkunna","poem":1},{"text":"Herrens nådegärningar,","poem":2},{"text":"Herrens lov,","poem":3},{"text":"efter allt som Herren","poem":2},{"text":"har gjort för oss,","poem":3},{"text":"allt det goda som han gjort","poem":2},{"text":"för Israels hus","poem":3},{"text":"efter sin barmhärtighet","poem":2},{"text":"och stora nåd.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Han sade: \"De är ju mitt folk,","poem":1},{"text":"barn som inte ska svika.\"","poem":3},{"text":"Och han blev deras frälsare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"I all deras nöd","poem":1},{"text":"var ingen verklig nöd,","poem":2},{"noteId":320},{"text":"hans ansiktes ängel frälste dem.","poem":3},{"text":"I sin kärlek och medömkan","poem":2},{"text":"återlöste han dem,","poem":3},{"text":"han lyfte upp dem och bar dem","poem":2},{"text":"ständigt i forna dagar.","poem":3},{"noteId":321}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Men de var upproriska","poem":1},{"text":"och bedrövade hans helige Ande.","poem":3},{"text":"Därför blev han deras fiende,","poem":2},{"text":"han stred själv mot dem.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Då tänkte hans folk","poem":1},{"text":"på gångna tider,","poem":2},{"text":"de tänkte på Mose:","poem":3},{"text":"Var är nu han som förde dem","poem":2},{"text":"upp ur havet,","poem":3},{"text":"tillsammans med herden","poem":2},{"text":"för hans hjord?","poem":3},{"text":"Var är han som lade sin helige Ande","poem":2},{"text":"i deras bröst,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"han som lät sin härliga arm","poem":1},{"text":"gå fram vid Moses högra sida,","poem":3},{"text":"han som klöv vattnet framför dem","poem":2},{"text":"och gjorde sig ett evigt namn,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"han som förde dem genom djupen","poem":1},{"text":"så att de likt springare i öknen","poem":2},{"text":"inte stapplade?","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Som när boskap går ner i dalen","poem":1},{"text":"fördes de av Herrens Ande till ro.","poem":3},{"text":"Så ledde du ditt folk","poem":2},{"text":"och gjorde dig ett härligt namn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Blicka ner från himlen,","poem":1},{"text":"se till oss från din heliga","poem":2},{"text":"och härliga boning!","poem":3},{"text":"Var är nu din lidelse","poem":2},{"text":"och din kraft?","poem":3},{"text":"Ditt hjärtas ömhet","poem":2},{"text":"och din barmhärtighet","poem":3},{"text":"har dragit sig tillbaka från mig.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Du är ju vår Far!","poem":1},{"text":"Abraham vet inte om oss,","poem":2},{"text":"Israel känner oss inte.","poem":3},{"noteId":322},{"text":"Men du, Herre, är vår Far.","poem":2},{"text":"Vår Återlösare av evighet","poem":3},{"text":"är ditt namn.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Varför, o Herre, låter du oss","poem":1},{"text":"gå vilse från dina vägar,","poem":3},{"text":"och varför förhärdar du","poem":2},{"text":"våra hjärtan","poem":3},{"text":"så att vi inte fruktar dig?","poem":4},{"text":"Vänd tillbaka,","poem":2},{"text":"för dina tjänares skull,","poem":3},{"text":"för din arvedels stammars skull.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"En kort tid ägde ditt heliga folk","poem":1},{"text":"sitt land.","poem":3},{"text":"Våra fiender trampade ner","poem":2},{"text":"din helgedom.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Vi har blivit som de","poem":1},{"text":"som du aldrig har varit herre över,","poem":3},{"text":"som inte har uppkallats","poem":2},{"text":"efter ditt namn.","poem":3}]}],"footnotes":[{"noteId":319,"caller":"-","text":"Edom … BosraRike och huvudstad söder om Döda havet. De nämns som representanter för fiender till Herren och hans folk (jfr kap 34).","reference":{"chapter":63,"verse":1}},{"noteId":320,"caller":"-","text":"var ingen verklig nödAndra handskrifter: \"led han nöd\".","reference":{"chapter":63,"verse":9}},{"noteId":321,"caller":"-","text":"Andra handskrifter (Septuaginta): \"...deras frälsare 9 i all deras nöd. Det var ingen budbärare eller ängel, utan hans ansikte frälste dem.\"","reference":{"chapter":63,"verse":9}},{"noteId":322,"caller":"-","text":"vet inte om oss … känner oss inteAnnan översättning: \"vill inte veta av oss … erkänner oss inte\".","reference":{"chapter":63,"verse":16}}]},"thisChapterLink":"/api/swe_fol/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}