{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"heading","content":["Bön om att Gud griper in"]},{"type":"verse","number":1,"content":["O, att du rev isär himlen",{"text":"och kom ner","poem":3},{"text":"så att bergen bävade inför dig,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"som när eld antänder ris","poem":1},{"text":"och elden får vattnet att koka,","poem":3},{"text":"så att ditt namn blir känt","poem":2},{"text":"för dina fiender","poem":3},{"text":"och hednafolken darrar för dig.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"När du gjorde","poem":1},{"text":"förunderliga gärningar","poem":2},{"text":"som vi inte väntade oss,","poem":3},{"text":"då kom du ner","poem":2},{"text":"och bergen bävade inför dig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Aldrig har någon hört,","poem":1},{"text":"inget öra har uppfattat,","poem":2},{"text":"inget öga har sett","poem":3},{"text":"en annan Gud än dig,","poem":4},{"text":"som gör sådant för dem","poem":2},{"text":"som väntar på honom.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Du kom för att hjälpa dem","poem":1},{"text":"som gjorde det rätta med fröjd,","poem":2},{"text":"som tänkte på dig på dina vägar.","poem":3},{"lineBreak":true},{"text":"Men se, du blev vred","poem":1},{"text":"när vi syndade.","poem":3},{"text":"Det har vi gjort länge –","poem":2},{"text":"ska vi någonsin bli frälsta?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Vi är alla orena,","poem":1},{"text":"alla våra rättfärdiga gärningar","poem":2},{"text":"är som en fläckad dräkt.","poem":3},{"noteId":323},{"text":"Vi vissnar alla som löv,","poem":2},{"text":"och som en vind sveper","poem":3},{"text":"våra missgärningar bort oss.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Ingen åkallar ditt namn,","poem":1},{"text":"ingen vaknar","poem":2},{"text":"för att hålla sig till dig,","poem":3},{"text":"för du har dolt ditt ansikte för oss,","poem":2},{"text":"överlämnat oss åt","poem":3},{"noteId":324},{"text":"vår missgärning.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Men Herre, du är vår Far.","poem":1},{"text":"Vi är leran,","poem":2},{"text":"och du är den som format oss,","poem":3},{"text":"vi är alla verk av din hand.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Var då inte så oerhört vred, Herre,","poem":1},{"text":"tänk inte för alltid","poem":2},{"text":"på vår missgärning.","poem":3},{"text":"Tänk på att vi alla är ditt folk.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dina heliga städer är en öken.","poem":1},{"text":"Sion är en öken,","poem":2},{"text":"Jerusalem en ödemark.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Vårt heliga och härliga hus,","poem":1},{"text":"där våra fäder lovade dig,","poem":2},{"text":"är eldens byte.","poem":3},{"text":"Allt som är dyrbart för oss","poem":2},{"text":"har lämnats åt förödelsen.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Kan du trots detta","poem":1},{"text":"hålla dig tillbaka, Herre?","poem":3},{"text":"Kan du tiga","poem":2},{"text":"och låta oss lida så mycket?","poem":3}]}],"footnotes":[{"noteId":323,"caller":"-","text":"fläckad dräktHebr. iddím används om menstruation (se 3 Mos 15:19f).","reference":{"chapter":64,"verse":6}},{"noteId":324,"caller":"-","text":"överlämnat oss åtAndra handskrifter: \"låtit oss smälta bort i\".","reference":{"chapter":64,"verse":7}}]},"thisChapterLink":"/api/swe_fol/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}