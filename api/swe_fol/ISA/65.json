{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Dom och frälsning"]},{"type":"verse","number":1,"content":["Jag lät mig sökas av dem",{"text":"som inte frågade efter mig,","poem":3},{"text":"jag lät mig finnas av dem","poem":2},{"text":"som inte sökte mig.","poem":3},{"text":"Till ett folk som inte åkallade","poem":2},{"text":"mitt namn sade jag:","poem":3},{"text":"\"Här är jag, här är jag.\"","poem":4},{"noteId":325}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hela dagen har jag","poem":1},{"text":"räckt ut mina händer","poem":2},{"text":"mot ett trotsigt folk,","poem":3},{"text":"som vandrar den väg","poem":2},{"text":"som inte är god,","poem":3},{"text":"som följer sina egna tankar,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ett folk som ständigt kränker mig","poem":1},{"text":"rakt i ansiktet.","poem":3},{"text":"De bär fram offer i trädgårdar","poem":2},{"text":"och tänder offereld","poem":3},{"noteId":326},{"text":"på tegelaltaren,","poem":4}]},{"type":"verse","number":4,"content":[{"text":"de håller till bland gravar","poem":1},{"text":"och tillbringar nätter","poem":2},{"text":"i gömda nästen,","poem":3},{"text":"de äter svinkött","poem":2},{"noteId":327},{"text":"och har oren mat","poem":3},{"noteId":328},{"text":"i sina kärl.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"De säger: \"Håll dig undan!","poem":1},{"text":"Kom inte nära mig,","poem":2},{"text":"för jag är heligare än du.\"","poem":3},{"text":"De är som rök i min näsa,","poem":2},{"text":"en eld som brinner dagen lång.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Se, det står skrivet inför mig:","poem":1},{"text":"Jag tiger inte","poem":3},{"text":"förrän jag gett dem vad de förtjänar,","poem":2},{"text":"gett det i deras famn,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"för både deras egna missgärningar","poem":1},{"text":"och deras fäders, säger Herren,","poem":3},{"text":"för att de tände offereld på bergen","poem":2},{"text":"och hånade mig på höjderna.","poem":3},{"text":"Jag ska mäta upp i deras famn","poem":2},{"text":"lönen för vad de tidigare har gjort.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Så säger Herren:","poem":1},{"text":"När man finner saft i en druvklase","poem":2},{"text":"säger man:","poem":3},{"text":"\"Förstör den inte!","poem":2},{"text":"Det finns välsignelse i den.\"","poem":3},{"text":"Så ska också jag göra","poem":2},{"text":"för mina tjänares skull,","poem":3},{"text":"jag ska inte förgöra dem alla.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jag ska låta","poem":1},{"text":"en avkomma gå ut från Jakob,","poem":2},{"text":"från Juda en arvinge","poem":3},{"text":"till mina berg,","poem":4},{"text":"för mina utvalda ska besitta landet","poem":2},{"text":"och mina tjänare ska bo där.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"För mitt folk, som frågar efter mig,","poem":1},{"text":"ska Saron","poem":2},{"noteId":329},{"text":"bli en betesmark för får","poem":2},{"text":"och Akors dal","poem":3},{"noteId":330},{"text":"en lägerplats för kor.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Men ni som överger Herren","poem":1},{"text":"och glömmer mitt heliga berg,","poem":3},{"text":"ni som dukar bord åt Lyckan","poem":2},{"text":"och häller upp blandat vin","poem":3},{"text":"åt Ödet","poem":4},{"noteId":331},{"text":",","poem":4}]},{"type":"verse","number":12,"content":[{"text":"jag ska låta svärdet bli ert öde.","poem":1},{"text":"Alla ska ni få böja er ner","poem":2},{"text":"för att slaktas,","poem":3},{"text":"för ni svarade inte när jag kallade,","poem":2},{"text":"ni lyssnade inte när jag talade.","poem":3},{"text":"Ni gjorde det som var ont","poem":2},{"text":"i mina ögon","poem":3},{"text":"och valde det som misshagade mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Därför säger Herren Gud så:","poem":1},{"text":"Se, mina tjänare ska äta,","poem":2},{"text":"men ni ska hungra.","poem":3},{"text":"Mina tjänare ska dricka,","poem":2},{"text":"men ni ska törsta.","poem":3},{"text":"Mina tjänare ska glädjas,","poem":2},{"text":"men ni ska skämmas.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Mina tjänare ska jubla","poem":1},{"text":"i hjärtats fröjd,","poem":3},{"text":"men ni ska ropa i hjärtats plåga","poem":2},{"text":"och jämra er i förtvivlan.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Ni ska överlämna ert namn","poem":1},{"text":"åt mina utvalda","poem":3},{"text":"till att användas som en förbannelse,","poem":2},{"text":"och Herren Gud ska döda dig.","poem":3},{"text":"Men åt sina tjänare","poem":2},{"text":"ska han ge ett annat namn.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Den som välsignar sig i landet","poem":1},{"text":"ska välsigna sig vid","poem":2},{"text":"Sanningens Gud","poem":3},{"noteId":332},{"text":",","poem":3},{"text":"och den som ger sin ed i landet","poem":2},{"text":"ska svära vid Sanningens Gud,","poem":3},{"text":"för de forna bedrövelserna","poem":2},{"text":"är glömda och dolda","poem":3},{"text":"för mina ögon.","poem":4}]},{"type":"heading","content":["Det nya Jerusalem"]},{"type":"verse","number":17,"content":[{"text":"Se, jag skapar nya himlar","poem":1},{"text":"och en ny jord,","poem":3},{"text":"och man ska inte mer minnas","poem":2},{"text":"det förgångna eller tänka på det.","poem":3},{"noteId":333}]},{"type":"verse","number":18,"content":[{"text":"Nej, fröjda er och jubla för evigt","poem":1},{"text":"över det som jag skapar!","poem":3},{"text":"För se, jag skapar Jerusalem till jubel","poem":2},{"text":"och dess folk till fröjd.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Jag ska jubla över Jerusalem,","poem":1},{"text":"fröjda mig över mitt folk.","poem":3},{"text":"Där ska inte mer höras","poem":2},{"text":"gråt eller klagan.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Där ska inte mer finnas spädbarn","poem":1},{"text":"som lever bara några dagar,","poem":3},{"text":"eller gamla män","poem":2},{"text":"som inte uppnår sina dagars mått.","poem":3},{"text":"Den som dör vid hundra års ålder","poem":2},{"text":"är en ung man,","poem":3},{"text":"och först vid hundra års ålder","poem":2},{"text":"ska syndaren drabbas","poem":3},{"text":"av förbannelsen.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"De ska bygga hus och få bo i dem,","poem":1},{"text":"plantera vingårdar","poem":2},{"text":"och äta deras frukt.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"När de bygger hus","poem":1},{"text":"ska andra inte bo i dem,","poem":3},{"text":"när de planterar något","poem":2},{"text":"ska andra inte äta av det.","poem":3},{"text":"Mitt folks ålder ska bli","poem":2},{"text":"som ett träds ålder,","poem":3},{"text":"mina utvalda ska länge få njuta","poem":2},{"text":"av sina händers verk.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"De ska inte arbeta förgäves","poem":1},{"text":"och inte föda barn till plötslig död,","poem":3},{"text":"för de är ett släkte","poem":2},{"text":"välsignat av Herren,","poem":3},{"text":"de och deras efterkommande","poem":2},{"text":"tillsammans.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Och det ska ske att","poem":1},{"text":"innan de ropar ska jag svara,","poem":3},{"text":"medan de ännu talar","poem":2},{"text":"ska jag höra.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Vargar ska beta med lamm,","poem":1},{"text":"lejon ska äta halm som oxar,","poem":2},{"text":"och stoft ska vara ormens föda.","poem":3},{"text":"Ingenstans på mitt heliga berg","poem":2},{"text":"ska de göra något ont","poem":3},{"text":"eller skadligt, säger Herren.","poem":4}]}],"footnotes":[{"noteId":325,"caller":"-","text":"Citeras av Paulus i Rom 10:21f som profetia om hedningarnas frälsning.","reference":{"chapter":65,"verse":1}},{"noteId":326,"caller":"-","text":"offereldAnnan översättning: \"rökelse\" (även i vers 7).","reference":{"chapter":65,"verse":3}},{"noteId":327,"caller":"-","text":"svinköttFörknippades med offer till underjordens gudar och ansågs orent (3 Mos 11:7).","reference":{"chapter":65,"verse":4}},{"noteId":328,"caller":"-","text":"oren matGryta på orent kött. Andra handskrifter: \"orena bitar\".","reference":{"chapter":65,"verse":4}},{"noteId":329,"caller":"-","text":"SaronGrönskande slätt (35:2) längs Medelhavskusten, god betesmark (1 Krön 27:29).","reference":{"chapter":65,"verse":10}},{"noteId":330,"caller":"-","text":"Akors dalSlätt nära Jeriko öster om Jerusalem (Jos 7:24f, Hos 2:15).","reference":{"chapter":65,"verse":10}},{"noteId":331,"caller":"-","text":"Lyckan … ÖdetPå hebreiska Gad och Meni, namn på avgudar (jfr latinets Fortuna).","reference":{"chapter":65,"verse":11}},{"noteId":332,"caller":"-","text":"Sanningens GudAnnan översättning: \"Gud som är Amen\" (jfr Upp 3:14 och not till Matt 5:18).","reference":{"chapter":65,"verse":16}},{"noteId":333,"caller":"-","text":"Citeras i 2 Petr 3:13.","reference":{"chapter":65,"verse":17}}]},"thisChapterLink":"/api/swe_fol/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}