{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":66,"content":[{"type":"heading","content":["De avfälligas slut och det nya Sion"]},{"type":"verse","number":1,"content":["Så säger Herren:",{"text":"Himlen är min tron","poem":2},{"text":"och jorden är mina fötters pall.","poem":3},{"text":"Vad för ett hus","poem":2},{"text":"kan ni bygga åt mig,","poem":3},{"text":"vad för en plats där jag kan vila?","poem":2},{"noteId":334}]},{"type":"verse","number":2,"content":[{"text":"Allt detta har min hand gjort","poem":1},{"text":"så att det blev till, säger Herren.","poem":3},{"text":"Jag ser till den som är betryckt","poem":2},{"text":"och har en förkrossad ande,","poem":3},{"text":"som fruktar mitt ord.","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Den som slaktar en oxe","poem":1},{"text":"är som en som dödar","poem":2},{"text":"en människa,","poem":3},{"text":"den som offrar ett lamm","poem":2},{"text":"är som en som bryter nacken","poem":3},{"text":"på en hund,","poem":4},{"text":"den som bär fram ett matoffer","poem":2},{"text":"är som en som bär fram svinblod","poem":3},{"noteId":335},{"text":",","poem":3},{"text":"den som offrar rökelse","poem":2},{"text":"är som den som hyllar en avgud.","poem":3},{"text":"De har valt att gå sina egna vägar","poem":2},{"text":"och har sin själs glädje","poem":3},{"text":"i sina vidrigheter.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Därför ska också jag","poem":1},{"text":"välja deras ofärd","poem":3},{"text":"och låta det de fruktar","poem":2},{"text":"drabba dem.","poem":3},{"text":"För jag ropade, men ingen svarade,","poem":2},{"text":"jag talade, men ingen lyssnade.","poem":3},{"text":"De gjorde det som var ont","poem":2},{"text":"i mina ögon,","poem":3},{"text":"de valde det","poem":2},{"text":"som misshagade mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hör Herrens ord,","poem":1},{"text":"ni som fruktar hans ord!","poem":3},{"text":"Era bröder som hatar er","poem":2},{"text":"och stöter bort er","poem":3},{"text":"för mitt namns skull,","poem":4},{"text":"de säger:","poem":2},{"text":"\"Herren kan visa sin härlighet","poem":3},{"text":"så att vi får se er glädje!\"","poem":4},{"text":"Men de ska få skämmas.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hör hur det larmar i staden,","poem":1},{"text":"hör rösten","poem":3},{"noteId":336},{"text":"från templet,","poem":3},{"text":"rösten av Herren","poem":2},{"text":"som ger sina fiender","poem":3},{"text":"vad de förtjänar!","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Innan Sion har känt några värkar","poem":1},{"text":"föder hon,","poem":3},{"text":"innan hon känt någon vånda","poem":2},{"text":"har hon fött en son.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Vem har hört något sådant,","poem":1},{"text":"vem har sett något liknande?","poem":3},{"text":"Kan ett land komma till liv","poem":2},{"text":"på en enda dag,","poem":3},{"text":"eller ett folk födas på ett ögonblick,","poem":2},{"text":"eftersom Sion föder sina barn","poem":3},{"text":"redan när värkarna börjar?","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Skulle jag öppna moderlivet","poem":1},{"text":"men inte låta födseln ske?","poem":3},{"text":"säger Herren.","poem":4},{"text":"Eller skulle jag som låter födseln ske","poem":2},{"text":"sedan hålla tillbaka barnet?","poem":3},{"text":"säger din Gud.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gläd er med Jerusalem,","poem":1},{"text":"fröjda er med henne,","poem":2},{"text":"alla ni som älskar henne!","poem":3},{"text":"Jubla högt med henne,","poem":2},{"text":"alla ni som har sörjt över henne,","poem":3}]},{"type":"verse","number":11,"content":[{"text":"så att ni får dia er mätta","poem":1},{"text":"vid hennes trösterika bröst,","poem":3},{"text":"suga och njuta av","poem":2},{"text":"hennes härliga rikedom","poem":3},{"noteId":337},{"text":".","poem":3}]},{"type":"verse","number":12,"content":[{"text":"För så säger Herren:","poem":1},{"text":"Se, jag leder frid till henne","poem":2},{"text":"som en flod","poem":3},{"text":"och folkens härlighet","poem":2},{"text":"som en översvämmande älv.","poem":3},{"text":"Ni ska få dia","poem":2},{"text":"och bli burna på höften","poem":3},{"text":"och sitta i knäet och bli smekta","poem":2},{"noteId":338},{"text":".","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Som en mor tröstar sitt barn","poem":1},{"text":"ska jag trösta er.","poem":3},{"text":"I Jerusalem ska ni få tröst.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"När ni får se det","poem":1},{"text":"ska era hjärtan glädjas,","poem":3},{"text":"era ben","poem":2},{"noteId":339},{"text":"ska få liv","poem":2},{"text":"likt spirande gräs.","poem":3},{"text":"Herrens hand ska bli känd","poem":2},{"text":"för hans tjänare,","poem":3},{"text":"men hans fiender","poem":2},{"text":"får känna hans vrede.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"För se,","poem":1},{"text":"Herren ska komma med eld,","poem":3},{"text":"och hans vagnar är","poem":2},{"text":"som en stormvind.","poem":3},{"text":"Han låter sin vrede drabba","poem":2},{"text":"med hetta","poem":3},{"text":"och sitt straff med eldslågor,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"för med eld och med sitt svärd","poem":1},{"text":"ska Herren gå till rätta","poem":2},{"text":"med alla människor,","poem":3},{"text":"och många ska bli slagna av Herren.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"De som inviger och renar sig","poem":1},{"text":"för att gå in i trädgårdarna,","poem":2},{"text":"anförda av en som står i mitten,","poem":3},{"text":"de som äter svinkött","poem":2},{"text":"och annat avskyvärt och möss,","poem":3},{"text":"de ska alla förgås, säger Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Jag känner deras gärningar och deras tankar. Den tid kommer då jag ska samla alla folk och språk, och de ska komma och se min härlighet."]},{"type":"verse","number":19,"content":["Jag ska sätta ett tecken bland dem. Några av dem som blir räddade ska jag sända som budbärare till hednafolken, till Tarshish, till Pul och Lud, bågskyttefolken",{"noteId":340},", till Tubal",{"noteId":341},"och Grekland",{"noteId":342},", till kustländerna i fjärran som inte har hört talas om mig eller sett min härlighet. De ska förkunna min härlighet bland hednafolken."]},{"type":"verse","number":20,"content":["De ska som en offergåva åt Herren föra ut alla era bröder från alla hednafolk på hästar, vagnar och kärror",{"noteId":343},", på mulåsnor och dromedarer upp till mitt heliga berg i Jerusalem, säger Herren, på samma sätt som Israels folk för fram offergåvor i rena kärl till Herrens hus."]},{"type":"verse","number":21,"content":["Och några av dem ska jag ta till mina präster, till mina leviter, säger Herren."]},{"type":"verse","number":22,"content":["För liksom de nya himlarna och den nya jorden som jag skapar blir bestående inför mig, så ska era efterkommande och ert namn bestå, säger Herren."]},{"type":"verse","number":23,"content":["Och nymånadsdag efter nymånadsdag och sabbatsdag efter sabbatsdag ska alla människor komma och tillbe inför mig, säger Herren."]},{"type":"verse","number":24,"content":["Och de ska gå ut och se liken av de människor som gjorde uppror mot mig. Deras mask ska inte dö och deras eld ska inte släckas. De ska vara en vämjelse för alla människor."]}],"footnotes":[{"noteId":334,"caller":"-","text":"Citeras av Stefanus i Apg 7:49f.","reference":{"chapter":66,"verse":1}},{"noteId":335,"caller":"-","text":"hund … svinblodFörknippades med offer till underjordens avgudar, t ex bland hetiterna.","reference":{"chapter":66,"verse":3}},{"noteId":336,"caller":"-","text":"röstenAnnan översättning: \"ljudet\".","reference":{"chapter":66,"verse":6}},{"noteId":337,"caller":"-","text":"rikedomAnnan översättning: \"bröstvårtor\".","reference":{"chapter":66,"verse":11}},{"noteId":338,"caller":"-","text":"smektaAnnan översättning: \"gungade\".","reference":{"chapter":66,"verse":12}},{"noteId":339,"caller":"-","text":"benSkelettets ben står för människans kärna och väsen (jfr 1 Mos 2:23, Ps 32:3).","reference":{"chapter":66,"verse":14}},{"noteId":340,"caller":"-","text":"bågskyttefolkenAndra handskrifter (så Septuaginta): \"Meshek\" (grannfolk till Tubal).","reference":{"chapter":66,"verse":19}},{"noteId":341,"caller":"-","text":"Tarshish … Pul och Lud … TubalMotsvarar västra Medelhavet, Libyen, Lydien i västra Turkiet samt östra Turkiet. Se 1 Mos 10.","reference":{"chapter":66,"verse":19}},{"noteId":342,"caller":"-","text":"GreklandHebr. Javán, jfr \"jonisk\".","reference":{"chapter":66,"verse":19}},{"noteId":343,"caller":"-","text":"kärrorAnnan översättning: \"bärstolar\".","reference":{"chapter":66,"verse":20}}]},"thisChapterLink":"/api/swe_fol/ISA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/65.json","previousChapterAudioLinks":{},"numberOfVerses":24}