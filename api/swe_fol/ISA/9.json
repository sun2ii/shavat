{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ISA","translationId":"swe_fol","name":"Jesaja","commonName":"Jesaja","title":"Jesaja","order":23,"numberOfChapters":66,"sha256":"9bd0dcf90ea02372db71c8e78e69ee16d3a07a7535c524ec21268bde4f259e30","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swe_fol/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Ett barn blir oss fött"]},{"type":"verse","number":1,"content":["Men det ska inte vara nattsvart mörker där ångest nu råder. Förr i tiden lät han Sebulons och Naftalis land",{"noteId":54},"vara föraktat, men i kommande dagar ska han ge ära åt trakten längs havsvägen, landet på andra sidan Jordan",{"noteId":55},", hednafolkens Galileen.",{"noteId":56}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Det folk som vandrar i mörkret","poem":1},{"text":"ska se ett stort ljus,","poem":3},{"text":"över dem som bor","poem":2},{"text":"i dödsskuggans land","poem":3},{"text":"ska ljuset stråla fram.","poem":4},{"noteId":57}]},{"type":"verse","number":3,"content":[{"text":"Du förökar det folk","poem":1},{"text":"som du inte gett","poem":3},{"noteId":58},{"text":"stor glädje.","poem":3},{"text":"De ska glädjas inför dig","poem":2},{"text":"som man gläds","poem":3},{"text":"under skördetiden,","poem":4},{"text":"som man jublar när man delar byte.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"För du ska bryta","poem":1},{"text":"deras bördors ok,","poem":3},{"noteId":59},{"text":"deras skuldrors käpp","poem":2},{"text":"och deras plågares stav,","poem":3},{"text":"som på Midjans tid.","poem":2},{"noteId":60}]},{"type":"verse","number":5,"content":[{"text":"Ja, varje stövel buren i stridslarm","poem":1},{"text":"och varje mantel vältrad i blod","poem":3},{"text":"ska brännas upp","poem":2},{"text":"och förtäras av eld.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"För ett barn blir oss fött,","poem":1},{"text":"en son blir oss given.","poem":3},{"text":"På hans axlar vilar herradömet,","poem":2},{"text":"och hans namn är:","poem":3},{"text":"Under, Rådgivare","poem":2},{"noteId":61},{"text":", Mäktig Gud,","poem":2},{"text":"Evig Far, Fridsfurste.","poem":3},{"noteId":62}]},{"type":"verse","number":7,"content":[{"text":"Så ska herradömet bli stort","poem":1},{"text":"och friden utan slut","poem":2},{"text":"över Davids tron och hans rike.","poem":3},{"text":"Det ska befästas och stödjas","poem":2},{"text":"med rätt och rättfärdighet","poem":3},{"text":"från nu och till evig tid.","poem":4},{"text":"Herren Sebaots lidelse","poem":2},{"text":"ska göra detta.","poem":3}]},{"type":"heading","content":["Herrens vrede mot Israel"]},{"type":"verse","number":8,"content":[{"text":"Herren sänder ett ord mot Jakob,","poem":1},{"text":"och det slår ner i Israel.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Hela folket ska märka det,","poem":1},{"text":"Efraim och Samarias invånare.","poem":3},{"text":"I stolthet och hjärtats högmod","poem":2},{"text":"säger de:","poem":3}]},{"type":"verse","number":10,"content":[{"text":"\"Tegelstenar har fallit,","poem":1},{"text":"men vi ska bygga upp","poem":2},{"text":"med huggen sten.","poem":3},{"text":"Mullbärsfikonträd","poem":2},{"noteId":63},{"text":"har huggits ner,","poem":2},{"text":"men vi ska ersätta dem","poem":3},{"text":"med cedrar.\"","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Herren reser upp","poem":1},{"text":"Resins motståndare","poem":3},{"noteId":64},{"text":"mot dem","poem":3},{"text":"och eggar upp deras fiender,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"arameerna från öster","poem":1},{"text":"och filisteerna","poem":3},{"noteId":65},{"text":"från väster,","poem":3},{"text":"och de ska sluka Israel","poem":2},{"text":"med glupska gap.","poem":3},{"text":"Med allt detta upphör inte","poem":2},{"text":"hans vrede,","poem":4},{"text":"hans hand är ännu uträckt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"För folket vänder inte om","poem":1},{"text":"till honom som slår dem,","poem":3},{"text":"de söker inte Herren Sebaot.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Därför ska Herren hugga av","poem":1},{"text":"både huvud och svans","poem":2},{"text":"från Israel,","poem":3},{"text":"både palmtopp och sävstrå,","poem":2},{"text":"allt på samma dag.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"De äldsta och högst uppsatta","poem":1},{"text":"är huvudet,","poem":3},{"text":"profeten som lär ut lögn","poem":2},{"text":"är svansen.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"För de som leder detta folk","poem":1},{"text":"vilseleder det,","poem":3},{"text":"och de som låter sig ledas","poem":2},{"text":"går i fördärvet.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Därför kan Herren inte glädja sig","poem":1},{"text":"över deras unga män","poem":3},{"text":"eller förbarma sig","poem":2},{"text":"över deras faderlösa och änkor,","poem":3},{"text":"för alla är hycklare","poem":2},{"text":"och gör det som är ont,","poem":3},{"text":"varje mun talar dårskap.","poem":4},{"text":"Med allt detta upphör inte","poem":2},{"text":"hans vrede,","poem":4},{"text":"hans hand är ännu uträckt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ja, gudlösheten brinner som en eld,","poem":1},{"text":"den förtär tistel och törne.","poem":3},{"text":"Den antänder snårskogen","poem":2},{"text":"så att den går upp","poem":3},{"text":"i höga virvlar av rök.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Landet brinner","poem":1},{"text":"genom Herren Sebaots vrede,","poem":2},{"text":"och folket är som ved för elden.","poem":3},{"text":"Ingen skonar sin broder.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Man river åt sig till höger","poem":1},{"text":"men förblir hungrig,","poem":3},{"text":"man tar för sig till vänster","poem":2},{"text":"men blir inte mätt.","poem":3},{"text":"Var och en äter köttet","poem":2},{"text":"på sin egen arm:","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Manasse äter Efraim","poem":1},{"text":"och Efraim Manasse,","poem":2},{"text":"och tillsammans angriper de Juda.","poem":3},{"text":"Med allt detta upphör inte","poem":2},{"text":"hans vrede,","poem":4},{"text":"hans hand är ännu uträckt.","poem":3}]}],"footnotes":[{"noteId":54,"caller":"-","text":"Sebulons och Naftalis landDrabbades hårt av assyrierna 733 f Kr (2 Kung 15:29).","reference":{"chapter":9,"verse":1}},{"noteId":55,"caller":"-","text":"andra sidan JordanHär väster om Jordan (från assyriernas sida sett). Benämningarna anknyter till assyriernas termer för erövrat land i norra Israel.","reference":{"chapter":9,"verse":1}},{"noteId":56,"caller":"-","text":"Citeras i Matt 4:15f som profetia om Jesu verksamhet i Galileen.","reference":{"chapter":9,"verse":1}},{"noteId":57,"caller":"-","text":"Citeras i Luk 1:79 som en del av Sakarias profetia om Kristi ankomst.","reference":{"chapter":9,"verse":2}},{"noteId":58,"caller":"-","text":"som du inte gettAndra handskrifter: \"åt vilket du gett\".","reference":{"chapter":9,"verse":3}},{"noteId":59,"caller":"-","text":"okBärstång över axlar, vanlig bild för underordning (jfr 1 Mos 27:40, 1 Kung 12:4, Jer 27:2).","reference":{"chapter":9,"verse":4}},{"noteId":60,"caller":"-","text":"Midjans tidRäddningen från Midjans förtryck genom Gideon (se 10:26, Dom 6-7)","reference":{"chapter":9,"verse":4}},{"noteId":61,"caller":"-","text":"Profetia om Messias födelse (jfr Luk 1:31f).","reference":{"chapter":9,"verse":6}},{"noteId":62,"caller":"-","text":"Under, RådgivareAnnan översättning: \"Underbar i råd\". Egyptiska kungar fick normalt fem tronnamn, medan en av Jesajas söner fick ett profetiskt namn med fyra ord (8:3).","reference":{"chapter":9,"verse":6}},{"noteId":63,"caller":"-","text":"Tegelstenar … mullbärsfikonträdBilligt och enkelt byggmaterial (jfr 2 Mos 1:14, 1 Kung 10:27).","reference":{"chapter":9,"verse":10}},{"noteId":64,"caller":"-","text":"Resins motståndareAssyrien, som anföll Israel 733 och 722 f Kr. Annan översättning: \"Resin som motståndare\" (Arams kung, vers 13). Andra handskrifter (Septuaginta): \"deras motståndare mot Sion\".","reference":{"chapter":9,"verse":11}},{"noteId":65,"caller":"-","text":"filisteernaFolket i Gaza tog de södra och västra områdena när Juda och Israel var svaga (2 Krön 28:18).","reference":{"chapter":9,"verse":12}}]},"thisChapterLink":"/api/swe_fol/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}