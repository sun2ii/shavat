{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JDG","translationId":"swe_fol","name":"Domarboken","commonName":"Domarboken","title":"Domarboken","order":7,"numberOfChapters":21,"sha256":"2101001721adf1e481ad162f40cdfd7142e3f618b1ff353975c94629f823c875","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/swe_fol/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Deboras och Baraks segersång"]},{"type":"verse","number":1,"content":["Den dagen sjöng Debora och Barak, Abinoams son, denna sång:"]},{"type":"verse","number":2,"content":[{"text":"När härförare anför i Israel,","poem":1},{"text":"när folket villigt offrar sig","poem":2},{"text":"– lova Herren!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Hör, ni kungar! Lyssna, ni furstar!","poem":1},{"lineBreak":true},{"text":"Jag vill sjunga, sjunga till Herren,","poem":1},{"text":"jag vill lovsjunga Herren,","poem":2},{"text":"Israels Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Herre, när du drog ut från Seir,","poem":1},{"text":"när du gick fram från Edoms land,","poem":3},{"text":"då bävade jorden,","poem":2},{"text":"då strömmade det från himlen,","poem":3},{"text":"då strömmade vatten från molnen.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bergen skalv inför Herrens ansikte,","poem":1},{"text":"Sinai inför Herrens, Israels Guds,","poem":2},{"text":"ansikte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"I Shamgars dagar, Anats sons,","poem":1},{"text":"i Jaels dagar låg vägarna öde.","poem":3},{"text":"Vandrarna måste gå omvägar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inga ledare","poem":1},{"noteId":24},{"text":"fanns, inga i Israel","poem":1},{"text":"förrän jag, Debora, trädde fram,","poem":2},{"text":"trädde fram som en moder i Israel.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Man valde sig nya gudar,","poem":1},{"text":"då nådde striden ända till portarna.","poem":3},{"text":"Men varken sköld eller spjut","poem":2},{"text":"fanns att se","poem":3},{"text":"bland Israels fyrtiotusen.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Mitt hjärta tillhör Israels furstar","poem":1},{"text":"och dem bland folket","poem":2},{"text":"som villigt offrade sig.","poem":3},{"text":"Lova Herren!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ni som rider på vita åsnor,","poem":1},{"text":"ni som sitter hemma på mattor","poem":2},{"text":"och ni som vandrar på vägen,","poem":3},{"text":"sjung!","poem":4},{"noteId":25}]},{"type":"verse","number":11,"content":[{"text":"När man sjungande","poem":1},{"text":"delar byte mellan vattenhoarna","poem":3},{"text":"lovprisar man Herrens","poem":2},{"text":"rättfärdiga gärningar,","poem":3},{"text":"hans styres rättfärdiga gärningar","poem":2},{"text":"i Israel.","poem":3},{"text":"Då drog Herrens folk ner","poem":2},{"text":"till portarna.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vakna, vakna, Debora!","poem":1},{"text":"Vakna, vakna, sjung din sång!","poem":3},{"text":"Res dig, Barak! Ta dig fångar,","poem":2},{"text":"du Abinoams son!","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Då satte folkets överlevare","poem":1},{"text":"de tappra till anförare,","poem":3},{"text":"Herren satte mig","poem":2},{"text":"till anförare över hjältarna.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Från Efraim kom män","poem":1},{"text":"med rötter i Amalek.","poem":3},{"text":"Benjamin följde dig","poem":2},{"text":"med dina skaror.","poem":3},{"text":"Från Makir kom furstar ner","poem":2},{"text":"och från Sebulon","poem":3},{"text":"män med ledarstav.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Furstarna i Isaskar","poem":1},{"text":"slöt sig till Debora,","poem":3},{"text":"och liksom Isaskar","poem":2},{"text":"gjorde också Barak,","poem":3},{"text":"ner i dalen skyndade man","poem":2},{"text":"i hans spår.","poem":3},{"text":"Bland Rubens ätter","poem":2},{"text":"höll man stora rådslag.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Varför satt du kvar bland dina fållor","poem":1},{"text":"och lyssnade till flöjtspel","poem":2},{"text":"vid hjordarna?","poem":3},{"text":"Bland Rubens ätter","poem":2},{"text":"hade man stora överläggningar.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Gilead stannade","poem":1},{"text":"på andra sidan Jordan.","poem":3},{"text":"Och Dan,","poem":2},{"text":"varför dröjde han vid skeppen?","poem":3},{"text":"Asher satt kvar vid havets strand,","poem":2},{"text":"vid sina vikar stannade han.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Men Sebulon var ett folk","poem":1},{"text":"som föraktade döden,","poem":3},{"text":"likaså Naftali på slagfältets höjder.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kungar drog fram och stred,","poem":1},{"text":"då stred Kanaans kungar","poem":2},{"text":"vid Taanak nära Megiddos vatten,","poem":3},{"text":"men silverbyte vann de inte.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Från himlen fördes strid,","poem":1},{"text":"stjärnorna stred från sina banor","poem":2},{"text":"mot Sisera.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Floden Kishon svepte bort dem,","poem":1},{"text":"urtidsfloden, floden Kishon.","poem":3},{"text":"Framåt, min själ, med kraft!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Då stampade hästarnas hovar,","poem":1},{"text":"hans starka hingstar","poem":2},{"text":"jagade framåt, framåt.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Förbanna Meros,","poem":1},{"text":"säger Herrens ängel,","poem":3},{"text":"förbanna, ja,","poem":2},{"text":"förbanna dess invånare","poem":3},{"text":"eftersom de inte kom","poem":2},{"text":"till Herrens hjälp,","poem":3},{"text":"till Herrens hjälp bland hjältarna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Välsignad framför andra kvinnor","poem":1},{"text":"är Jael, keniten Hebers hustru,","poem":3},{"text":"välsignad framför alla kvinnor i tält.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Vatten begärde han,","poem":1},{"text":"hon gav honom mjölk,","poem":3},{"text":"bar fram gräddmjölk i högtidsskålen.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hon räckte sin hand efter tältpluggen,","poem":1},{"text":"sin högra hand efter hammaren.","poem":3},{"text":"Med den slog hon Sisera","poem":2},{"text":"och krossade hans huvud,","poem":3},{"text":"spräckte hans tinning","poem":2},{"text":"och genomborrade den.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Vid hennes fötter kröp han ihop,","poem":1},{"text":"låg och blev liggande.","poem":3},{"text":"Vid hennes fötter kröp han ihop","poem":2},{"text":"och låg.","poem":3},{"text":"Där han kröp ihop,","poem":2},{"text":"där låg han utslagen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ut genom fönstret","poem":1},{"text":"blickade Siseras mor,","poem":3},{"text":"hon ropade gällt genom gallret:","poem":2},{"text":"”Varför dröjer hans vagn?","poem":3},{"text":"Varför hörs inte","poem":2},{"text":"vagnshästarnas hovar?”","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Då svarade","poem":1},{"text":"hennes klokaste hovdamer,","poem":3},{"text":"och själv gav hon sig samma svar:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"”Säkert fick de byte och delar det nu,","poem":1},{"text":"en flicka","poem":2},{"noteId":26},{"text":"eller två åt varje man,","poem":2},{"text":"färggrant byte för Siseras räkning,","poem":3},{"text":"färggrant byte av brokiga tyger,","poem":2},{"text":"en brokig duk eller två","poem":3},{"text":"för de fångnas halsar.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Så ska alla dina fiender förgås,","poem":1},{"text":"Herre.","poem":3},{"text":"Men de som älskar honom","poem":2},{"text":"ska bli som solen","poem":3},{"text":"när den går upp i sin kraft.","poem":4},{"lineBreak":true},"Och landet hade nu ro i fyrtio år."]}],"footnotes":[{"noteId":24,"caller":"-","text":"ledareAnnan översättning: ”lantbrukare” (på grund av plundringsrisken, jfr 6:4).","reference":{"chapter":5,"verse":7}},{"noteId":25,"caller":"-","text":"sjungAnnan översättning: ”tala om det”.","reference":{"chapter":5,"verse":10}},{"noteId":26,"caller":"-","text":"en flickaOrdagrant: ”ett sköte”.","reference":{"chapter":5,"verse":30}}]},"thisChapterLink":"/api/swe_fol/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}