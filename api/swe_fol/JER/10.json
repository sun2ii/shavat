{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Gud och avgudarna"]},{"type":"verse","number":1,"content":["Hör det ord",{"text":"som Herren talar till er,","poem":2},{"text":"ni av Israels hus.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Ta inte efter hednafolkens sätt,","poem":2},{"text":"låt er inte skrämmas","poem":3},{"text":"av tecknen på himlen","poem":4},{"text":"därför att hednafolken","poem":2},{"text":"skräms av dem,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"för folkens seder är tomhet.","poem":1},{"text":"Man hugger ett träd i skogen,","poem":2},{"text":"och hantverkarens händer","poem":3},{"text":"formar det med yxan.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Man pryder det med silver och guld","poem":1},{"text":"och fäster det med hammare","poem":2},{"text":"och spik","poem":3},{"text":"så att det inte faller omkull.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Som fågelskrämmor på ett gurkfält","poem":1},{"text":"står de där och kan inte tala.","poem":3},{"text":"Man måste bära dem,","poem":2},{"text":"för de kan inte gå.","poem":3},{"text":"Var inte rädd för dem,","poem":2},{"text":"för de kan inte göra något ont,","poem":3},{"text":"inte heller något gott.","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ingen är som du, Herre.","poem":1},{"text":"Du är stor, och stort och mäktigt","poem":2},{"text":"är ditt namn.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Vem skulle inte frukta dig,","poem":1},{"text":"du folkens kung?","poem":2},{"text":"Det anstår dig.","poem":3},{"text":"Bland folkens alla visa","poem":2},{"text":"och i alla deras riken","poem":3},{"text":"finns ingen som du.","poem":4},{"noteId":51}]},{"type":"verse","number":8,"content":[{"text":"Alla är de oförnuftiga","poem":1},{"text":"och dåraktiga,","poem":3},{"text":"vägledda av tomma trägudar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Silvret som hamras","poem":1},{"text":"hämtas från Tarshish","poem":2},{"noteId":52},{"text":"och guldet från Ufas","poem":3},{"noteId":53},{"text":".","poem":3},{"text":"Snickarnas och guldsmedernas verk","poem":2},{"text":"kläs sedan i blått och purpur","poem":3},{"noteId":54},{"text":".","poem":3},{"text":"Allt är tillverkat av konstnärer.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Men Herren är den sanne Guden,","poem":1},{"text":"han är den levande Guden,","poem":2},{"text":"den evige Kungen.","poem":3},{"text":"För hans vrede bävar jorden,","poem":2},{"text":"och folken uthärdar inte","poem":3},{"text":"hans harm.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Så ska ni säga till dem:","poem":1},{"text":"De gudar som inte har gjort","poem":2},{"text":"himmel och jord","poem":4},{"text":"ska utrotas från jorden","poem":2},{"text":"och inte finnas kvar","poem":3},{"text":"under himlen.","poem":4},{"noteId":55}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Han har skapat jorden","poem":1},{"text":"med sin kraft,","poem":3},{"text":"han har grundat världen","poem":2},{"text":"med sin vishet","poem":3},{"text":"och spänt ut himlen","poem":2},{"text":"med sitt förstånd.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"När han höjer sin röst,","poem":1},{"text":"då brusar himlens vatten,","poem":3},{"text":"då låter han regnskyar stiga","poem":2},{"text":"från jordens ände.","poem":3},{"text":"Han gör blixtar åt regnet","poem":2},{"text":"och för ut vinden","poem":3},{"text":"ur dess förvaringsrum.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Alla människor står då som dårar,","poem":1},{"text":"utan förstånd.","poem":3},{"text":"Alla guldsmeder får skämmas","poem":2},{"text":"med sina avgudar,","poem":3},{"text":"för deras gjutna gudabilder","poem":2},{"text":"är bedrägeri,","poem":4},{"text":"det finns ingen ande i dem.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Tomhet är de,","poem":1},{"text":"ett verk som väcker löje.","poem":3},{"text":"När straffet drabbar dem","poem":2},{"text":"förgås de.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Sådan är inte han","poem":1},{"text":"som är Jakobs del.","poem":3},{"text":"Han är den som har format allt,","poem":2},{"text":"och Israel är hans arvedels stam.","poem":3},{"text":"Herren Sebaot är hans namn.","poem":2}]},{"type":"heading","content":["Kommande fångenskap"]},{"type":"verse","number":17,"content":[{"text":"Samla er packning","poem":1},{"text":"och lämna landet,","poem":3},{"text":"ni som är belägrade,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"för så säger Herren:","poem":1},{"text":"Den här gången slungar jag bort","poem":2},{"text":"dem som bor i landet.","poem":3},{"text":"Jag ska ansätta dem hårt","poem":2},{"text":"så att de känner det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ve mig för min skada!","poem":1},{"text":"Mitt sår kan inte läkas.","poem":3},{"text":"Men jag säger: Detta är min plåga","poem":2},{"text":"och jag måste bära den!","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Mitt tält är förstört","poem":1},{"text":"och alla mina tältlinor är avslitna.","poem":3},{"text":"Mina barn har lämnat mig,","poem":2},{"text":"de finns inte mer.","poem":3},{"text":"Ingen är kvar","poem":2},{"text":"som kan slå upp mitt tält","poem":3},{"text":"och sätta upp mina tältdukar,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"för herdarna är oförnuftiga,","poem":1},{"text":"de söker inte Herren.","poem":3},{"text":"Därför har de ingen framgång,","poem":2},{"text":"och hela deras hjord har skingrats.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Lyssna, det hörs något!","poem":1},{"text":"Se, det kommer!","poem":3},{"text":"Ett väldigt dån från landet i norr,","poem":2},{"text":"för att göra Juda städer","poem":3},{"text":"till en ödemark,","poem":4},{"text":"till en boning för schakaler.","poem":3}]},{"type":"heading","content":["Profetens bön"]},{"type":"verse","number":23,"content":[{"text":"Jag vet, Herre:","poem":1},{"text":"Människans väg","poem":2},{"text":"beror inte på henne själv,","poem":3},{"text":"det står inte i vandrarens makt","poem":2},{"text":"att styra sina steg.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Tukta mig, Herre,","poem":1},{"text":"men med måtta, inte i vrede,","poem":2},{"text":"så att du inte krossar mig.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Ös din vrede över hednafolken","poem":1},{"text":"som inte känner dig,","poem":3},{"text":"över stammarna","poem":2},{"text":"som inte åkallar ditt namn,","poem":3},{"text":"för de har slukat Jakob,","poem":2},{"text":"slukat och gjort slut på honom","poem":3},{"text":"och ödelagt hans boning.”","poem":4}]}],"footnotes":[{"noteId":51,"caller":"-","text":"Citeras i Upp 15:3f.","reference":{"chapter":10,"verse":7}},{"noteId":52,"caller":"-","text":"TarshishHandelscentrum i västra Medelhavet (1 Kung 10:22). Har identifierats med spanska Tartessos, tunisiska Kartago eller Sardinien.","reference":{"chapter":10,"verse":9}},{"noteId":53,"caller":"-","text":"UfasOkänd ort, kanske i Jemen (Ofir) som var berömt för sina guldgruvor.","reference":{"chapter":10,"verse":9}},{"noteId":54,"caller":"-","text":"blått och purpurKungliga, dyrbara färger (jfr Apg 16:14).","reference":{"chapter":10,"verse":9}},{"noteId":55,"caller":"-","text":"Grundtexten till vers 11 är på arameiska, de kaldeiska erövrarnas språk (jfr Dan 2:4). Kanske är det en marginalanteckning, kanske ett färdigt svar att ge i fångenskapen (jfr 1 Petr 3:15).","reference":{"chapter":10,"verse":11}}]},"thisChapterLink":"/api/swe_fol/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}