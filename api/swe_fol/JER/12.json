{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Undran över Herrens handlande"]},{"type":"verse","number":1,"content":["Rättfärdig är du, Herre,",{"text":"när jag vill gå till rätta","poem":2},{"text":"med dig.","poem":3},{"text":"Ändå måste jag tala med dig","poem":2},{"text":"om dina domslut.","poem":3},{"text":"Varför lyckas de ogudaktiga så väl?","poem":2},{"text":"Varför lever alla trolösa","poem":3},{"text":"så trygga?","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Du planterar dem och de slår rot,","poem":1},{"text":"de växer och bär frukt.","poem":3},{"text":"Du är nära i deras mun,","poem":2},{"text":"men långt från deras inre.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Men du, Herre, känner mig.","poem":1},{"text":"Du ser mig och prövar","poem":2},{"text":"hur mitt hjärta är mot dig.","poem":3},{"text":"Ryck bort dem som får till slakt","poem":2},{"text":"och förbered dem för dagen","poem":3},{"text":"då de dödas.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Hur länge ska landet sörja","poem":1},{"text":"och hela markens gräs","poem":2},{"text":"torka bort,","poem":3},{"text":"så att både fyrfotadjur och fåglar","poem":2},{"text":"går under för invånarnas ondska?","poem":3},{"text":"De säger: ”Han kan inte se","poem":2},{"text":"vår framtid.”","poem":3}]},{"type":"heading","content":["Guds svar"]},{"type":"verse","number":5,"content":[{"text":"Om du springer ikapp med fotfolk","poem":1},{"text":"och de tröttar ut dig,","poem":3},{"text":"hur skulle du då kunna","poem":2},{"text":"tävla med hästar?","poem":3},{"text":"Du känner dig trygg i fredligt land,","poem":2},{"text":"men hur ska du klara dig","poem":3},{"text":"i snåren vid Jordan","poem":4},{"noteId":59},{"text":"?","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Dina bröder och din fars hus","poem":1},{"text":"är också trolösa mot dig,","poem":3},{"text":"de ropar för full hals","poem":2},{"text":"bakom din rygg.","poem":3},{"text":"Lita inte på dem,","poem":2},{"text":"även om de talar vänligt","poem":3},{"text":"med dig.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jag har övergett mitt hus,","poem":1},{"text":"lämnat mitt arv","poem":3},{"text":"och gett min älskade","poem":2},{"text":"i fiendens hand.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Min arvedel blev","poem":1},{"text":"som ett lejon i skogen mot mig.","poem":3},{"text":"Hon höjde sin röst mot mig,","poem":2},{"text":"därför hatar jag henne.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Min arvedel har blivit för mig","poem":1},{"text":"som en spräcklig rovfågel","poem":3},{"text":"som angrips av andra rovfåglar","poem":2},{"noteId":60},{"text":"runt omkring.","poem":3},{"text":"Gå och samla markens alla djur","poem":2},{"text":"och låt dem komma för att äta!","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Många herdar","poem":1},{"text":"har fördärvat min vingård","poem":2},{"text":"och trampat ner mitt land.","poem":3},{"text":"De har gjort mitt härliga land","poem":2},{"text":"till en öde öken,","poem":3},{"text":"till en ödemark.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Sörjande och öde","poem":1},{"text":"ligger det framför mig.","poem":3},{"text":"Hela landet ligger öde,","poem":2},{"text":"för ingen bryr sig om det.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Över alla kala höjder i öknen","poem":1},{"text":"rycker plundrare fram,","poem":3},{"text":"för Herrens svärd slukar allt","poem":2},{"text":"från landets ena ände","poem":3},{"text":"till den andra.","poem":4},{"text":"Ingen kan känna sig trygg.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"De har sått vete men skördat törne.","poem":1},{"text":"Förgäves tröttar de ut sig.","poem":3},{"text":"Ni kommer att skämmas","poem":2},{"text":"över er gröda","poem":3},{"text":"på grund av Herrens","poem":2},{"text":"brinnande vrede.","poem":3}]},{"type":"heading","content":["Upprättelse för Israels grannar"]},{"type":"verse","number":14,"content":["Så säger Herren om alla onda grannar som förgriper sig på det arv jag har gett mitt folk Israel: Se, jag ska rycka bort dem ur deras land och rycka undan Juda hus ifrån dem."]},{"type":"verse","number":15,"content":["Men när jag har ryckt bort dem, ska jag åter förbarma mig över dem och låta dem komma tillbaka, var och en till sin arvedel, var och en till sitt land."]},{"type":"verse","number":16,"content":["Om de då verkligen lär sig mitt folks vägar så att de svär vid mitt namn: ”Så sant Herren lever”, liksom de förut lärde mitt folk att svära vid Baal, då ska de bli upprättade mitt ibland mitt folk."]},{"type":"verse","number":17,"content":["Men om de inte vill lyssna ska jag fullständigt rycka bort det folket och förgöra det, säger Herren."]}],"footnotes":[{"noteId":59,"caller":"-","text":"snåren vid JordanVid denna tid tätbevuxen terräng (2 Kung 6:2) med farliga djur som lejon.","reference":{"chapter":12,"verse":5}},{"noteId":60,"caller":"-","text":"en spräcklig rovfågel som angrips av andra rovfåglarSvårtolkad vers. Andra handskrifter (Septuaginta): ”en hyenas grotta med andra grottor”.","reference":{"chapter":12,"verse":9}}]},"thisChapterLink":"/api/swe_fol/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}