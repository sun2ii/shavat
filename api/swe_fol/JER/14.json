{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["Den stora torkan"]},{"type":"verse","number":1,"content":["Detta är Herrens ord till Jeremia angående torkan."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Juda sörjer,","poem":1},{"text":"dess portar tynar bort,","poem":2},{"text":"de lutar sig sörjande mot jorden","poem":3},{"text":"och ett sorgerop stiger upp","poem":2},{"text":"från Jerusalem.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"De mäktiga sänder sina tjänare","poem":1},{"text":"efter vatten,","poem":3},{"text":"men när de kommer till dammarna","poem":2},{"text":"finner de inget vatten","poem":3},{"text":"utan måste vända tillbaka","poem":2},{"text":"med tomma kärl.","poem":3},{"text":"De är skamsna och förtvivlade","poem":2},{"text":"och täcker huvudet.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Marken spricker","poem":1},{"text":"eftersom det inte regnar i landet.","poem":3},{"text":"Jordbrukarna står med skam","poem":2},{"text":"och täcker sina huvuden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Även hinden på fältet","poem":1},{"text":"överger sin nyfödda kalv,","poem":3},{"text":"eftersom det inte finns något grönt.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vildåsnorna står på höjderna","poem":1},{"text":"och flämtar efter luft","poem":2},{"text":"som schakaler.","poem":3},{"text":"Deras ögon är matta,","poem":2},{"text":"för det finns inget gräs.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Våra missgärningar vittnar mot oss,","poem":1},{"text":"men grip in ändå,","poem":2},{"text":"för ditt namns skull, Herre.","poem":3},{"text":"Gång på gång har vi avfallit","poem":2},{"text":"och syndat mot dig.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Du Israels hopp,","poem":1},{"text":"dess frälsare i nödens tid,","poem":3},{"text":"varför är du","poem":2},{"text":"som en främling i landet,","poem":3},{"text":"en vandrare","poem":2},{"text":"som bara stannar för en natt?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Varför är du som en rådlös man,","poem":1},{"text":"som en hjälte","poem":2},{"text":"som inte kan hjälpa?","poem":3},{"text":"Du finns ju mitt ibland oss, Herre,","poem":2},{"text":"och vi är uppkallade","poem":3},{"text":"efter ditt namn.","poem":4},{"text":"Överge oss inte!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Så säger Herren om detta folk:","poem":1},{"text":"De vill gärna driva omkring","poem":2},{"text":"på det sättet,","poem":3},{"text":"de håller inte sina fötter i styr.","poem":2},{"text":"Därför har Herren inte","poem":3},{"text":"behag till dem.","poem":4},{"text":"Han minns nu deras missgärning","poem":2},{"text":"och ska straffa dem","poem":3},{"text":"för deras synder.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Herren sade till mig: Du ska inte be om något gott för detta folk."]},{"type":"verse","number":12,"content":["För även om de fastar vill jag inte lyssna till deras rop, och även om de offrar brännoffer och matoffer finner jag ingen glädje i dem, utan jag tänker göra slut på dem med svärd, svält och pest."]},{"type":"verse","number":13,"content":["Då sade jag: ”O, Herre Gud! Profeterna säger ju till dem: Ni ska inte se något svärd, inte heller ska svält drabba er, utan jag ska ge er en varaktig fred på denna plats.”"]},{"type":"verse","number":14,"content":["Men Herren sade till mig: Profeterna profeterar lögn i mitt namn. Jag har inte sänt dem eller befallt dem eller talat till dem. Falska syner, tomma spådomar, löst prat och sina egna hjärtans bedrägerier är vad de profeterar för er."]},{"type":"verse","number":15,"content":["Därför säger Herren så om de profeter som profeterar i mitt namn fast jag inte har sänt dem, de som säger att svärd och svält inte ska komma i detta land: Genom svärd och svält ska dessa profeter gå under."]},{"type":"verse","number":16,"content":["Och folket som de profeterar för, männen och deras hustrur, söner och döttrar, ska kastas ut på Jerusalems gator slagna av svält och svärd, och ingen ska begrava dem. Jag ska låta deras ondska drabba dem själva."]},{"type":"verse","number":17,"content":["Tala till dem detta ord:",{"lineBreak":true},{"text":"Tårar strömmar från mina ögon","poem":1},{"text":"natt och dag,","poem":2},{"text":"och de ska inte sluta,","poem":3},{"text":"för jungfrun, dottern mitt folk,","poem":2},{"text":"har drabbats","poem":3},{"text":"av ett förkrossande slag,","poem":4},{"text":"ett svårt och oläkligt sår.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Går jag ut på fälten","poem":1},{"text":"ligger där män genomborrade","poem":2},{"text":"av svärd,","poem":3},{"text":"och kommer jag in i staden","poem":2},{"text":"möts jag av svältens plågor.","poem":3},{"text":"Både profet och präst","poem":2},{"text":"drar vidare mot ett land","poem":3},{"text":"de inte känner.","poem":4}]},{"type":"heading","content":["Profetens förbön"]},{"type":"verse","number":19,"content":[{"text":"Har du helt förkastat Juda?","poem":1},{"text":"Känner du avsky för Sion?","poem":3},{"text":"Eller varför har du slagit oss","poem":2},{"text":"så att ingen kan bota oss?","poem":3},{"text":"Vi väntar på välgång,","poem":2},{"text":"men inget gott kommer,","poem":3},{"text":"på en tid med läkedom,","poem":2},{"text":"men se, skräck råder.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Herre, vi erkänner vår ondska","poem":1},{"text":"och våra fäders missgärning,","poem":3},{"text":"att vi har syndat mot dig.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"För ditt namns skull:","poem":1},{"text":"Förkasta oss inte,","poem":2},{"text":"låt inte din härlighets tron","poem":3},{"text":"bli föraktad.","poem":4},{"text":"Kom ihåg ditt förbund med oss","poem":2},{"text":"och bryt det inte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kan någon av hednafolkens","poem":1},{"text":"tomma avgudar ge regn?","poem":3},{"text":"Kan himlen av sig själv","poem":2},{"text":"låta skurar falla?","poem":3},{"text":"Nej, bara du, Herre vår Gud!","poem":2},{"text":"Vi hoppas på dig,","poem":3},{"text":"för du har gjort allt detta.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}