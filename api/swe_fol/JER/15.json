{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"heading","content":["Folket måste straffas"]},{"type":"verse","number":1,"content":["Men Herren sade till mig: Även om Mose och Samuel",{"noteId":63},"trädde fram inför mig skulle jag ändå inte bli vänligt sinnad mot detta folk. Driv bort dem från mitt ansikte och låt dem gå."]},{"type":"verse","number":2,"content":["Om de frågar dig: ”Vart ska ni gå?” ska du svara dem: Så säger Herren: Till döden den som tillhör döden, till svärdet den som tillhör svärdet, till svälten den som tillhör svälten och till fångenskapen den som tillhör fångenskapen."]},{"type":"verse","number":3,"content":["Fyra slags plågor ska jag låta drabba dem, säger Herren: Svärdet för att döda dem, hundarna för att släpa bort dem, och himlens fåglar och markens vilddjur för att äta upp och göra slut på dem."]},{"type":"verse","number":4,"content":["Jag ska göra dem till ett avskräckande exempel för alla riken på jorden, på grund av det som Juda kung Manasse",{"noteId":64},", Hiskias son, har gjort i Jerusalem."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"För vem har förbarmande","poem":1},{"text":"med dig, Jerusalem,","poem":2},{"text":"vem har medlidande med dig?","poem":3},{"text":"Vem tar en omväg för att fråga","poem":2},{"text":"hur det är med dig?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Du har förkastat mig, säger Herren,","poem":1},{"text":"och vänt mig ryggen.","poem":3},{"text":"Därför har jag räckt ut min hand","poem":2},{"text":"mot dig för att förgöra dig.","poem":3},{"text":"Jag är trött på att hålla tillbaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jag kastade dem med kastskovel","poem":1},{"noteId":65},{"text":"vid landets portar,","poem":3},{"text":"jag gjorde dem barnlösa,","poem":2},{"text":"jag förgjorde mitt folk –","poem":3},{"text":"men de vände inte om","poem":2},{"text":"från sina vägar.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Deras änkor blev fler inför mig","poem":1},{"text":"än sandkornen i havet.","poem":3},{"text":"Mödrarna till deras unga män","poem":2},{"text":"lät jag härjas av inkräktare","poem":3},{"text":"mitt på ljusa dagen.","poem":4},{"text":"Plötsligt lät jag ångest och skräck","poem":2},{"text":"drabba dem.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Den som hade fött sju söner","poem":1},{"text":"svimmade och gav upp andan.","poem":3},{"text":"Hennes sol gick ner","poem":2},{"text":"medan det ännu var dag,","poem":3},{"text":"hon får blygas och skämmas.","poem":4},{"text":"De som är kvar av dem","poem":2},{"text":"ska jag överlämna","poem":3},{"text":"åt deras fienders svärd,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"heading","content":["Profetkallets vånda"]},{"type":"verse","number":10,"content":[{"text":"”Ve mig, min mor,","poem":1},{"text":"att du fött mig,","poem":3},{"text":"en man som skapar strid","poem":2},{"text":"och osämja för hela landet!","poem":3},{"text":"Jag har inte lånat dem något","poem":2},{"text":"och de har inte gett lån till mig.","poem":3},{"text":"Ändå förbannar alla mig.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":["Men Herren svarade: ”Sannerligen, jag ska styrka dig så att det går väl för dig. Sannerligen, jag ska göra så att dina fiender kommer och bönfaller inför dig i olyckans och nödens tid."]},{"type":"verse","number":12,"content":["Kan man bryta sönder järn, järn från norr eller koppar?"]},{"type":"verse","number":13,"content":["Din rikedom och dina skatter ska jag lämna till plundring, men inte för betalning, utan för alla dina synders skull i hela ditt land."]},{"type":"verse","number":14,"content":["Och jag ska föra bort dig med dina fiender till ett land du inte känner, för min vredes eld är upptänd och den ska brinna mot er.”"]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Herre, du förstår.","poem":1},{"text":"Tänk på mig","poem":2},{"text":"och ta hand om mig,","poem":3},{"text":"och ge mig hämnd","poem":2},{"text":"på mina förföljare.","poem":3},{"text":"Ryck inte bort mig,","poem":2},{"text":"du som är sen till vrede.","poem":3},{"text":"Tänk på hur jag hånas","poem":2},{"text":"för din skull.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Dina ord kom och jag åt dem,","poem":1},{"text":"ditt ord blev mitt hjärtas fröjd","poem":2},{"text":"och glädje,","poem":3},{"text":"för jag är uppkallad","poem":2},{"text":"efter ditt namn,","poem":3},{"text":"Herre Gud Sebaot.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jag har inte suttit tillsammans","poem":1},{"text":"med gycklare för att roa mig.","poem":3},{"text":"Eftersom din hand var över mig","poem":2},{"text":"satt jag ensam,","poem":3},{"text":"för du har fyllt mig med vrede.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Varför ska jag ständigt plågas,","poem":1},{"text":"och varför är mitt sår oläkbart?","poem":3},{"text":"Det vill inte läka.","poem":4},{"text":"Du har blivit för mig","poem":2},{"text":"som en sinande bäck,","poem":3},{"text":"som ett vatten","poem":2},{"text":"som ingen kan lita på.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Därför säger Herren så:","poem":1},{"text":"Om du vänder om","poem":3},{"text":"låter jag dig komma tillbaka,","poem":2},{"text":"och du ska få tjäna mig.","poem":3},{"text":"Om du skiljer det äkta","poem":2},{"text":"från det oäkta","poem":3},{"text":"ska du bli som min mun.","poem":4},{"text":"Folket ska vända tillbaka till dig,","poem":2},{"text":"men du ska inte vända tillbaka","poem":3},{"text":"till dem.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Jag ska göra dig till en fast","poem":1},{"text":"kopparmur mot detta folk.","poem":3},{"text":"De ska strida mot dig,","poem":2},{"text":"men de kan inte besegra dig,","poem":3},{"text":"för jag är med dig","poem":2},{"text":"för att hjälpa dig och rädda dig,","poem":3},{"text":"säger Herren.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"Jag ska rädda dig","poem":1},{"text":"ur de ondas våld","poem":3},{"text":"och befria dig","poem":2},{"text":"ur våldsmännens hand.","poem":3}]}],"footnotes":[{"noteId":63,"caller":"-","text":"Mose och SamuelStora bedjare som bad om nåd för folket (2 Mos 32:30f, 4 Mos 14:11f, 1 Sam 7:8, 12:23).","reference":{"chapter":15,"verse":1}},{"noteId":64,"caller":"-","text":"ManasseUtövade våld, barnoffer och grov avgudadyrkan (se 2 Kung 21).","reference":{"chapter":15,"verse":4}},{"noteId":65,"caller":"-","text":"kastskovelRensade ut agnarna från vetet (Matt 3:12 med not).","reference":{"chapter":15,"verse":7}}]},"thisChapterLink":"/api/swe_fol/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}