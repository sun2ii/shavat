{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":17,"content":[{"type":"heading","content":["Juda synd"]},{"type":"verse","number":1,"content":["Juda synd är skriven",{"text":"med järnstift,","poem":2},{"text":"ristad med diamantspets","poem":3},{"text":"på deras hjärtas tavla","poem":2},{"text":"och på deras altares horn.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Som man tänker på sina barn,","poem":1},{"text":"så tänker de på sina altaren","poem":2},{"text":"och sina asherapålar","poem":3},{"text":"vid gröna träd och på höga kullar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mitt berg på fältet,","poem":1},{"text":"din rikedom och alla dina skatter","poem":2},{"text":"ska jag lämna till plundring","poem":3},{"text":"liksom dina offerhöjder,","poem":2},{"text":"på grund av synd","poem":3},{"text":"i hela ditt land.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Det är ditt eget fel","poem":1},{"text":"att du måste avstå ifrån det arv","poem":2},{"text":"som jag har gett dig.","poem":3},{"text":"Jag ska låta dig tjäna dina fiender","poem":2},{"text":"i ett land som du inte känner,","poem":3},{"text":"för ni har tänt min vredes eld,","poem":2},{"text":"och den ska brinna för evigt.","poem":3}]},{"type":"heading","content":["Förbannelse och välsignelse"]},{"type":"verse","number":5,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Förbannad är den","poem":2},{"text":"som litar till människor","poem":3},{"text":"och söker sin styrka","poem":2},{"text":"i det som är kött","poem":3},{"text":"och vars hjärta vänder sig bort","poem":2},{"text":"från Herren.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han är som en torr buske på heden","poem":1},{"text":"och får inte se","poem":2},{"text":"något gott komma.","poem":3},{"text":"Han bor på brända platser i öknen,","poem":2},{"text":"på salt jord där ingen bor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Men välsignad är den","poem":1},{"text":"som litar till Herren","poem":3},{"text":"och har Herren till sin trygghet.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Han är som ett träd","poem":1},{"text":"planterat vid vatten","poem":3},{"text":"som sträcker sina rötter","poem":2},{"text":"till bäcken.","poem":3},{"text":"Det fruktar inte om hetta kommer,","poem":2},{"text":"dess löv är alltid gröna.","poem":3},{"text":"Det oroas inte under torra år,","poem":2},{"text":"och det slutar aldrig","poem":3},{"text":"att bära frukt.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bedrägligare än allt annat är hjärtat,","poem":1},{"text":"det är obotligt sjukt.","poem":3},{"text":"Vem kan förstå det?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jag, Herren, utforskar hjärtat","poem":1},{"text":"och prövar njurarna","poem":3},{"text":"för att ge åt var och en","poem":2},{"text":"efter hans vägar,","poem":3},{"text":"efter hans gärningars frukt.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lik en rapphöna, som ruvar på ägg","poem":1},{"text":"som hon inte har lagt","poem":3},{"noteId":66},{"text":",","poem":3},{"text":"är den som oärligt","poem":2},{"text":"samlar rikedom.","poem":3},{"text":"När halva livet gått","poem":2},{"text":"måste han lämna den,","poem":3},{"text":"och vid livets slut","poem":2},{"text":"ses han som en dåre.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"En härlighetens tron,","poem":1},{"text":"en urgammal höjd","poem":3},{"text":"är vår helgedoms plats.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Herren är Israels hopp.","poem":1},{"text":"Alla som överger dig","poem":2},{"text":"kommer på skam.","poem":3},{"text":"De som avfaller från mig","poem":2},{"text":"ska bli skrivna på marken.","poem":3},{"noteId":67},{"text":"De har övergett Herren,","poem":2},{"text":"källan med det levande vattnet.","poem":3}]},{"type":"heading","content":["Jeremias bön om frälsning"]},{"type":"verse","number":14,"content":[{"text":"Hela mig, Herre, så blir jag helad.","poem":1},{"text":"Fräls mig, så blir jag frälst,","poem":2},{"text":"för du är min lovsång.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Se, de säger till mig:","poem":1},{"text":"”Vad blir det av Herrens ord?","poem":2},{"text":"Låt det inträffa!”","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jag har inte dragit mig undan","poem":1},{"text":"från att vara en herde","poem":2},{"text":"som följer dig,","poem":3},{"text":"och inte längtat efter","poem":2},{"text":"fördärvets dag.","poem":3},{"text":"Du vet själv att det som kom","poem":2},{"text":"över mina läppar","poem":3},{"text":"sades inför ditt ansikte.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bli inte till skräck för mig!","poem":1},{"text":"Du är min tillflykt","poem":2},{"text":"på den onda dagen.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Låt mina förföljare få skämmas,","poem":1},{"text":"men låt inte mig","poem":2},{"text":"behöva skämmas.","poem":3},{"text":"Låt dem bli förskräckta,","poem":2},{"text":"men låt inte mig bli förskräckt.","poem":3},{"text":"Låt den onda dagen drabba dem","poem":2},{"text":"och krossa dem dubbelt upp.","poem":3}]},{"type":"heading","content":["Sabbatsbudet"]},{"type":"verse","number":19,"content":["Herren sade till mig: Gå och ställ dig i Folkets port där Juda kungar går in och ut, och i Jerusalems alla portar"]},{"type":"verse","number":20,"content":["och säg till dem: Hör Herrens ord, ni Juda kungar och hela Juda och Jerusalems alla invånare som går in genom dessa portar!"]},{"type":"verse","number":21,"content":["Så säger Herren: Se till för era själars skull att ni inte bär någon börda på sabbatsdagen",{"noteId":68},"eller tar in den genom Jerusalems portar."]},{"type":"verse","number":22,"content":["Ni ska inte bära ut någon börda ur era hus på sabbatsdagen eller göra något annat arbete, utan håll sabbatsdagen helig så som jag har befallt era fäder."]},{"type":"verse","number":23,"content":["Men de ville inte höra eller lyssna, utan var hårdnackade så att de inte hörde eller tog emot tillrättavisning."]},{"type":"verse","number":24,"content":["Men om ni hör mig, säger Herren, så att ni inte bär in någon börda på sabbaten genom denna stads portar utan håller sabbaten helig och inte gör något arbete på den dagen,"]},{"type":"verse","number":25,"content":["då ska kungar och furstar som sitter på Davids tron dra in genom denna stads portar med vagnar och hästar, följda av sina furstar, Juda män och Jerusalems invånare. Då ska denna stad vara bebodd för alltid."]},{"type":"verse","number":26,"content":["Från Juda städer, från Jerusalems omgivningar, från Benjamins land, från Låglandet, Bergsbygden och Negev",{"noteId":69},"ska man komma och bära fram brännoffer, slaktoffer, matoffer, rökelse och gemenskapsoffer till Herrens hus."]},{"type":"verse","number":27,"content":["Men om ni inte lyssnar till mitt bud att hålla sabbaten helig och inte bära in någon börda genom Jerusalems portar på sabbatsdagen, då ska jag tända en eld i dess portar. Den ska förtära Jerusalems borgar och inte kunna släckas."]}],"footnotes":[{"noteId":66,"caller":"-","text":"inte har lagtAnnan översättning: ”inte får kläcka”.","reference":{"chapter":17,"verse":11}},{"noteId":67,"caller":"-","text":"skrivna på markenDvs inte i himlen, i livets bok (Ps 69:29, Jes 4:3, Upp 3:5). Jfr även Joh 8:6f.","reference":{"chapter":17,"verse":13}},{"noteId":68,"caller":"-","text":"börda på sabbatsdagenJfr Neh 13:15 där det handlar om försäljning.","reference":{"chapter":17,"verse":21}},{"noteId":69,"caller":"-","text":"Benjamins land … Låglandet, Bergsbygden och NegevOmråden nordost, sydväst, norr och söder om Jerusalem.","reference":{"chapter":17,"verse":26}}]},"thisChapterLink":"/api/swe_fol/JER/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/16.json","previousChapterAudioLinks":{},"numberOfVerses":27}