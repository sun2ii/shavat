{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Israels trolöshet mot Gud"]},{"type":"verse","number":1,"content":["Herrens ord kom till mig. Han sade:"]},{"type":"verse","number":2,"content":["Gå och predika för Jerusalem och säg: Så säger Herren:",{"lineBreak":true},{"text":"Jag minns din ungdoms hängivenhet,","poem":1},{"text":"hur du älskade mig","poem":2},{"text":"under din brudtid","poem":3},{"text":"och följde mig i öknen,","poem":2},{"text":"i landet där man inte sår.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Israel var heligt för Herren,","poem":1},{"text":"den första frukten av hans skörd.","poem":3},{"text":"Alla som äter av den","poem":2},{"text":"drar på sig skuld,","poem":3},{"text":"olycka drabbar dem,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hör Herrens ord,","poem":1},{"text":"ni av Jakobs hus,","poem":3},{"text":"ni alla släkter av Israels hus.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Vad fann era fäder för fel hos mig,","poem":2},{"text":"eftersom de gick bort ifrån mig","poem":3},{"text":"och följde värdelösa avgudar","poem":2},{"text":"och själva blev värdelösa?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"De frågade inte: ”Var är Herren,","poem":1},{"text":"han som förde oss upp","poem":2},{"text":"ur Egyptens land,","poem":3},{"text":"han som ledde oss i öknen,","poem":2},{"text":"det öde och oländiga landet,","poem":3},{"text":"torkans och dödsskuggans land,","poem":2},{"text":"landet där ingen färdas","poem":3},{"text":"och där ingen människa bor?”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag förde er in i det bördiga landet","poem":1},{"text":"och ni fick äta dess frukt","poem":2},{"text":"och dess goda.","poem":3},{"text":"Men när ni hade kommit dit,","poem":2},{"text":"orenade ni mitt land","poem":3},{"text":"och gjorde min arvedel avskyvärd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Prästerna frågade inte:","poem":1},{"text":"”Var är Herren?”","poem":3},{"text":"De som hade hand om lagen","poem":2},{"text":"kände mig inte,","poem":3},{"text":"och herdarna var trolösa","poem":2},{"text":"mot mig.","poem":3},{"text":"Profeterna profeterade i Baals namn","poem":2},{"text":"och följde dem","poem":3},{"text":"som inte kan hjälpa.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Därför ska jag fortsätta","poem":1},{"text":"gå till rätta med er, säger Herren,","poem":3},{"text":"och gå till rätta med era barnbarn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dra bort till kitteernas kuster","poem":1},{"text":"och se efter,","poem":3},{"text":"skicka bud till Kedar","poem":2},{"noteId":7},{"text":"och undersök,","poem":2},{"text":"se om något sådant har hänt där:","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Har ett folk någonsin","poem":1},{"text":"bytt bort sina gudar?","poem":2},{"text":"Och ändå är de inga gudar.","poem":3},{"text":"Men mitt folk har bytt bort","poem":2},{"text":"sin härlighet","poem":3},{"text":"mot något som inte kan hjälpa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Häpna, ni himlar, över detta,","poem":1},{"text":"rys av stor förfäran, säger Herren,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"för mitt folk har begått","poem":1},{"text":"en dubbel synd:","poem":3},{"text":"De har övergett mig,","poem":2},{"text":"källan med det levande vattnet","poem":3},{"noteId":8},{"text":",","poem":3},{"text":"och gjort sig usla brunnar","poem":2},{"text":"som inte håller vatten.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Är Israel en träl?","poem":1},{"text":"Är han född som slav?","poem":3},{"text":"Varför har han blivit ett byte?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lejonen","poem":1},{"noteId":9},{"text":"ryter mot honom,","poem":1},{"text":"man hör dem morra.","poem":3},{"text":"De gör hans land till en ödemark.","poem":2},{"text":"Hans städer bränns ner","poem":3},{"text":"så att ingen kan bo i dem.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Även Memfis och Tachpanches","poem":1},{"noteId":10},{"text":"barn","poem":1},{"text":"betar din hjässa kal","poem":2},{"noteId":11},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Men är det inte du själv","poem":1},{"text":"som vållar dig detta,","poem":3},{"text":"genom att du överger","poem":2},{"text":"Herren din Gud","poem":3},{"text":"när han vill leda dig","poem":2},{"text":"på den rätta vägen?","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Varför vill du till Egypten","poem":1},{"text":"för att dricka av Nilens","poem":3},{"noteId":12},{"text":"vatten?","poem":3},{"text":"Och varför vill du till Assyrien","poem":2},{"text":"för att dricka av flodens vatten?","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Det är din ondska som tuktar dig","poem":1},{"text":"och ditt avfall som straffar dig.","poem":3},{"text":"Inse därför och tänk på","poem":2},{"text":"hur ont och bittert det är","poem":3},{"text":"att du överger Herren din Gud","poem":2},{"text":"och inte fruktar mig,","poem":3},{"text":"säger Herren Gud Sebaot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Redan för länge sedan","poem":1},{"text":"bröt jag sönder ditt ok","poem":2},{"text":"och slet av dina band,","poem":3},{"text":"men du sade:","poem":2},{"text":"”Jag vill inte tjäna dig.”","poem":3},{"text":"På alla höga kullar","poem":2},{"text":"och under alla gröna träd","poem":3},{"text":"lade du dig ner och bedrev otukt.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jag hade planterat dig","poem":1},{"text":"som en ädel vinstock, helt äkta.","poem":3},{"text":"Hur kunde du då bli en oäkta,","poem":2},{"text":"främmande vinstock för mig?","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Även om du tvättar dig med soda","poem":1},{"text":"och tar mängder av såpa","poem":3},{"text":"är ändå din synds fläckar","poem":2},{"text":"kvar inför mig, säger Herren Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hur kan du säga:","poem":1},{"text":"”Jag har inte orenat mig,","poem":2},{"text":"jag har inte följt baalerna?”","poem":3},{"text":"Tänk hur du bar dig åt i dalen,","poem":2},{"text":"kom ihåg vad du har gjort!","poem":3},{"text":"Du är som ett ystert kamelsto","poem":2},{"text":"som löper hit och dit,","poem":3}]},{"type":"verse","number":24,"content":[{"text":"som en vildåsna","poem":1},{"text":"som är van vid öknen","poem":2},{"text":"och flåsar i sin brunst.","poem":3},{"text":"Vem kan hålla tillbaka","poem":2},{"text":"hennes begär?","poem":3},{"text":"Den som söker henne","poem":2},{"text":"behöver inte löpa sig trött.","poem":3},{"text":"Vid parningstiden","poem":2},{"noteId":13},{"text":"finner man henne lätt.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Akta din fot","poem":1},{"text":"så att du inte tappar skon","poem":3},{"text":"och din strupe","poem":2},{"text":"så att den inte blir törstig.","poem":3},{"text":"Men du svarar: ”Det är förgäves!","poem":2},{"text":"Jag älskar främmande gudar","poem":3},{"text":"och tänker följa dem.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Liksom tjuven står med skam","poem":1},{"text":"när han ertappas,","poem":3},{"text":"så ska Israels hus få skämmas","poem":2},{"text":"med sina kungar och furstar,","poem":3},{"text":"sina präster och profeter,","poem":4}]},{"type":"verse","number":27,"content":[{"text":"de som säger till trästycket:","poem":1},{"text":"”Du är min far”,","poem":3},{"text":"och till stenen:","poem":2},{"text":"”Du har fött mig”.","poem":3},{"text":"De vänder ryggen mot mig","poem":2},{"text":"och inte ansiktet.","poem":3},{"text":"Men i olyckans tid ropar de:","poem":2},{"text":"”Res dig och rädda oss!”","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Var är då dina gudar","poem":1},{"text":"som du gjorde åt dig?","poem":3},{"text":"Låt dem resa sig!","poem":2},{"text":"Kan de rädda dig","poem":3},{"text":"i din olyckas tid?","poem":4},{"text":"För du, Juda,","poem":2},{"text":"har lika många gudar","poem":3},{"text":"som du har städer!","poem":4}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Varför går ni till rätta med mig?","poem":1},{"text":"Ni har alla vänt er bort från mig,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Förgäves har jag slagit era barn,","poem":1},{"text":"de lät sig inte tillrättavisas.","poem":3},{"text":"Likt ett lejon som vållar fördärv","poem":2},{"text":"har ert eget svärd slukat","poem":3},{"text":"era profeter.","poem":4}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Du släkte, se Herrens ord!","poem":1},{"text":"Har jag varit en öken för Israel","poem":2},{"text":"eller ett land av mörker?","poem":3},{"text":"Varför säger mitt folk: ”Vi är fria,","poem":2},{"text":"vi kommer inte mer till dig?”","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Inte glömmer en jungfru","poem":1},{"text":"sina smycken","poem":3},{"text":"eller en brud sin utstyrsel?","poem":2},{"text":"Men mitt folk har i alla tider","poem":3},{"text":"glömt mig.","poem":4}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Hur skickligt går du inte till väga","poem":1},{"text":"när du söker kärlek!","poem":3},{"text":"Även de sämsta kvinnor","poem":2},{"text":"har du lärt dina vägar.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"På dina mantelflikar finns blod","poem":1},{"text":"av fattiga som var oskyldiga,","poem":2},{"text":"de hade inte ertappats vid inbrott","poem":3},{"noteId":14},{"text":".","poem":3}]},{"type":"verse","number":35,"content":[{"text":"Trots allt detta säger du:","poem":1},{"text":"”Jag är oskyldig.","poem":2},{"text":"Han är inte arg på mig längre.”","poem":3},{"text":"Men jag vill gå till rätta med dig,","poem":2},{"text":"eftersom du säger:","poem":3},{"text":"”Jag har inte syndat.”","poem":4}]},{"type":"verse","number":36,"content":[{"text":"Varför far du än hit än dit","poem":1},{"text":"för att ta en annan väg?","poem":3},{"text":"Du blir besviken på Egypten","poem":2},{"text":"liksom du blev besviken","poem":3},{"text":"på Assyrien.","poem":4},{"noteId":15}]},{"type":"verse","number":37,"content":[{"text":"Också därifrån måste du gå din väg","poem":1},{"text":"med händerna på huvudet,","poem":3},{"noteId":16},{"text":"för Herren förkastar","poem":2},{"text":"dem som du litar till,","poem":3},{"text":"du får ingen framgång genom dem.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"-","text":"kitteerna … KedarCypern i västerhavet och araber i den östra öknen (jfr 1 Mos 10:4, 25:13).","reference":{"chapter":2,"verse":10}},{"noteId":8,"caller":"-","text":"levande vattnetFriskt och flödande, inte stillastående och osunt. Jfr Joh 4:10, 7:38.","reference":{"chapter":2,"verse":13}},{"noteId":9,"caller":"-","text":"LejonenTroligen assyrierna (jfr Nah 2:11 med not) som hade härjat landet upprepade gånger (se 2 Kung 15:29, 17:3f, 18:7f).","reference":{"chapter":2,"verse":15}},{"noteId":10,"caller":"-","text":"Memfis och TachpanchesEgyptens huvudstad söder om Kairo och gränsstad i östra Nildeltat. Egypten härjade Israel 609 f Kr (2 Kung 23:29f).","reference":{"chapter":2,"verse":16}},{"noteId":11,"caller":"-","text":"betar din hjässa kalAnnan översättning: ”krossar din hjässa”.","reference":{"chapter":2,"verse":16}},{"noteId":12,"caller":"-","text":"NilenHebr. Shihór, ”Horus vatten”, troligen det östra Nildeltat närmast Israel.","reference":{"chapter":2,"verse":18}},{"noteId":13,"caller":"-","text":"parningstidenOrdagrant: ”hennes månad”.","reference":{"chapter":2,"verse":24}},{"noteId":14,"caller":"-","text":"ertappats vid inbrottHusägare hade rätt att döda inbrottstjuvar (2 Mos 22:2).","reference":{"chapter":2,"verse":34}},{"noteId":15,"caller":"-","text":"besviken på AssyrienFolket hade försökt vinna stormaktens gunst (2 Kung 15:19, 16:7f), men i stället själva blivit plundrade (2 Kung 15:29, 18:9f).","reference":{"chapter":2,"verse":36}},{"noteId":16,"caller":"-","text":"händerna på huvudetSorgegest (jfr 2 Sam 13:19 med not).","reference":{"chapter":2,"verse":37}}]},"thisChapterLink":"/api/swe_fol/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}