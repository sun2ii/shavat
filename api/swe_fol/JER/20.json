{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["Jeremia och prästen Pashur"]},{"type":"verse","number":1,"content":["När prästen Pashur, Immers son, som var överuppsyningsman i Herrens hus, hörde Jeremia profetera dessa ord,"]},{"type":"verse","number":2,"content":["lät han misshandla profeten Jeremia och satte honom i stocken i Övre Benjaminsporten till Herrens hus."]},{"type":"verse","number":3,"content":["Men när Pashur dagen därpå släppte Jeremia ur stocken, sade Jeremia till honom: ”Herren kallar dig inte Pashur utan Magor-Missabib",{"noteId":75},","]},{"type":"verse","number":4,"content":["för så säger Herren: Jag ska göra dig till en skräck för både dig själv och alla dina vänner. De ska falla för sina fienders svärd och dina ögon ska se det. Hela Juda ska jag ge i den babyloniske kungens hand, och han ska föra bort dem till Babel och döda dem med svärd."]},{"type":"verse","number":5,"content":["Alla rikedomar, ägodelar och dyrbarheter i denna stad och Juda kungars alla skatter ska jag ge i deras fienders hand. De ska ta det som byte och föra det till Babel."]},{"type":"verse","number":6,"content":["Och du själv, Pashur, ska gå i fångenskap med alla som bor i ditt hus. Du ska komma till Babel, där ska du dö, och där ska du begravas med alla dina vänner som du har profeterat lögn för.”"]},{"type":"heading","content":["Profetens klagan inför Herren"]},{"type":"verse","number":7,"content":[{"text":"Du, Herre, övertalade mig,","poem":1},{"text":"och jag lät mig övertalas.","poem":3},{"text":"Du grep mig","poem":2},{"text":"och besegrade mig.","poem":3},{"text":"Jag har blivit till ständigt åtlöje,","poem":2},{"text":"alla hånar mig.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Så ofta jag talar måste jag klaga,","poem":1},{"text":"ropa över våld och förtryck,","poem":3},{"text":"för Herrens ord drar spott och spe","poem":2},{"text":"över mig dagen lång.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Men jag tänkte:","poem":1},{"text":"Jag vill glömma honom","poem":2},{"text":"och inte mer tala i hans namn.","poem":3},{"text":"Då blev det som en brinnande eld","poem":2},{"text":"i mitt hjärta, instängd i mitt inre.","poem":3},{"text":"Jag ansträngde mig","poem":2},{"text":"att hålla den inne","poem":3},{"text":"men lyckades inte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jag hör många förtala mig,","poem":1},{"text":"det är skräck från alla håll:","poem":3},{"text":"”Ange honom!”","poem":2},{"text":"”Ja, vi ska ange honom!”","poem":3},{"text":"Alla som stått mig nära","poem":2},{"text":"väntar på att jag ska falla.","poem":3},{"text":"”Kanske låter han lura sig,","poem":2},{"text":"så kan vi besegra honom","poem":3},{"text":"och ta hämnd på honom.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Men Herren är med mig","poem":1},{"text":"som en mäktig hjälte.","poem":3},{"text":"Därför ska mina förföljare falla","poem":2},{"text":"och inte besegra mig.","poem":3},{"text":"De ska stå där med stor skam,","poem":2},{"text":"för de har handlat utan förstånd.","poem":3},{"text":"De ska drabbas av evig vanära","poem":2},{"text":"som inte ska glömmas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Herre Sebaot,","poem":1},{"text":"du prövar den rättfärdige,","poem":2},{"text":"du ser hjärtan och njurar","poem":3},{"noteId":76},{"text":".","poem":3},{"text":"Låt mig se din hämnd på dem,","poem":2},{"text":"för jag har överlämnat min sak","poem":3},{"text":"till dig.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Sjung till Herren, lova Herren,","poem":1},{"text":"för han räddar den fattiges själ","poem":2},{"text":"ur de ondas hand.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Förbannad","poem":1},{"noteId":77},{"text":"är den dag","poem":1},{"text":"då jag föddes!","poem":3},{"text":"Låt inte dagen då min mor","poem":2},{"text":"födde mig bli välsignad!","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Förbannad är den man","poem":1},{"text":"som meddelade min far:","poem":2},{"text":"”Du har fått en son!”","poem":3},{"text":"och gjorde honom mycket glad.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Låt det gå den mannen","poem":1},{"text":"som det gick för de städer","poem":3},{"text":"som Herren förstörde","poem":2},{"text":"utan att ångra det.","poem":3},{"text":"Låt honom få höra sorgerop","poem":2},{"text":"på morgonen","poem":3},{"text":"och stridsrop mitt på dagen,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"eftersom han inte dödade mig","poem":1},{"text":"i moderlivet","poem":3},{"text":"så att min mor fick bli min grav","poem":2},{"text":"och hennes moderliv havande","poem":3},{"text":"för alltid.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Varför kom jag ut ur moderlivet","poem":1},{"text":"för att se möda och bedrövelse","poem":2},{"text":"och sluta mina dagar i skam?","poem":3}]}],"footnotes":[{"noteId":75,"caller":"-","text":"Magor-MissabibBetyder ”skräck från alla håll”.","reference":{"chapter":20,"verse":3}},{"noteId":76,"caller":"-","text":"hjärtan och njurarEn bild för människans innersta (jfr Ps 139:13, Upp 2:23).","reference":{"chapter":20,"verse":12}},{"noteId":77,"caller":"-","text":"FörbannadJfr Jobs klagan (Job 3).","reference":{"chapter":20,"verse":14}}]},"thisChapterLink":"/api/swe_fol/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}