{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Israels befrielse från Babel"]},{"type":"verse","number":1,"content":["Detta ord kom till Jeremia från Herren. Han sade:"]},{"type":"verse","number":2,"content":["”Så säger Herren, Israels Gud: Skriv upp i en bokrulle alla de ord som jag har talat till dig."]},{"type":"verse","number":3,"content":["För se, dagar ska komma, säger Herren, då jag gör slut på fångenskapen för mitt folk Israel och Juda, säger Herren. Jag ska låta dem komma tillbaka till det land som jag gav deras fäder. Och de ska ta det i besittning.”"]},{"type":"verse","number":4,"content":["Detta är vad Herren har talat om Israel och Juda."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Rop av förfäran har vi hört,","poem":2},{"text":"fruktan och ingen frid.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Fråga och tänk:","poem":1},{"text":"Brukar män föda barn?","poem":3},{"text":"Varför ser jag då alla män","poem":2},{"text":"med händerna på höfterna","poem":3},{"text":"som kvinnor i barnsnöd?","poem":4},{"text":"Varför har alla ansikten","poem":2},{"text":"blivit så dödsbleka?","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ve! Detta är en stor dag,","poem":1},{"text":"den liknar ingen annan.","poem":3},{"text":"Det är en tid av nöd för Jakob,","poem":2},{"text":"men han ska bli räddad ur den.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Och det ska ske på den dagen,","poem":1},{"text":"säger Herren Sebaot,","poem":3},{"text":"att jag ska ta oket från din nacke","poem":2},{"text":"och bryta sönder det","poem":3},{"text":"och slita av dina band.","poem":4},{"text":"Inga främlingar ska längre","poem":2},{"text":"tvinga honom att tjäna dem,","poem":3}]},{"type":"verse","number":9,"content":[{"text":"utan de ska tjäna Herren sin Gud","poem":1},{"text":"och David sin kung,","poem":3},{"text":"som jag ska låta uppstå åt dem.","poem":2},{"noteId":113}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Så var inte rädd,","poem":1},{"text":"min tjänare Jakob, säger Herren,","poem":2},{"text":"och var inte förskräckt, Israel.","poem":3},{"text":"För jag ska rädda dig","poem":2},{"text":"ur landet i fjärran","poem":3},{"text":"och dina efterkommande ur landet","poem":2},{"text":"där de är fångna.","poem":3},{"text":"Jakob ska komma tillbaka","poem":2},{"text":"och leva i fred och trygghet,","poem":3},{"text":"och ingen ska skrämma honom.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"För jag är med dig, säger Herren,","poem":1},{"text":"för att rädda dig.","poem":3},{"text":"Jag ska göra slut på alla de folk","poem":2},{"text":"bland vilka jag spritt ut dig.","poem":3},{"text":"Men dig ska jag inte göra slut på,","poem":2},{"text":"bara tukta dig med rättvisa,","poem":3},{"text":"för helt ostraffad","poem":2},{"text":"kan jag inte lämna dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"För så säger Herren:","poem":1},{"text":"Obotlig är din skada,","poem":2},{"text":"oläkligt ditt sår.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ingen tar sig an din sak","poem":1},{"text":"för att se om ditt sår.","poem":3},{"text":"Det finns inga läkemedel","poem":2},{"text":"och ingen läkedom för dig.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Alla dina älskare har glömt dig,","poem":1},{"text":"de frågar inte efter dig,","poem":3},{"text":"för jag har slagit dig","poem":2},{"text":"med en fiendes slag.","poem":3},{"text":"Jag har tuktat dig hårt,","poem":2},{"text":"för din skuld är stor","poem":3},{"text":"och dina synder många.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Varför ropar du över din skada?","poem":1},{"text":"Obotlig är din plåga.","poem":3},{"text":"Därför att din skuld är stor","poem":2},{"text":"och dina synder många","poem":3},{"text":"har jag gjort dig detta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Men nu ska alla som ätit av dig","poem":1},{"text":"bli uppätna,","poem":3},{"text":"och alla dina motståndare","poem":2},{"text":"ska allihop gå i fångenskap.","poem":3},{"text":"De som har skövlat dig","poem":2},{"text":"ska bli skövlade,","poem":3},{"text":"och alla som har plundrat dig","poem":2},{"text":"ska jag lämna till plundring.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"För jag ska låta dig bli frisk","poem":1},{"text":"och läka dina sår, säger Herren,","poem":3},{"text":"dig som man kallar","poem":2},{"text":"”den fördrivna”,","poem":3},{"text":"”Sion som ingen frågar efter”.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Se, jag ska göra slut","poem":2},{"text":"på fångenskapen","poem":3},{"text":"för Jakobs hyddor","poem":4},{"text":"och förbarma mig","poem":3},{"text":"över hans boningar.","poem":4},{"text":"Staden ska åter byggas upp","poem":2},{"text":"på sin höjd,","poem":3},{"text":"och palatset ska stå","poem":2},{"text":"på sin rätta plats.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Från dem ska höras lovsång","poem":1},{"text":"och rop från glada människor.","poem":3},{"text":"Jag ska föröka dem,","poem":2},{"text":"och de ska inte bli färre.","poem":3},{"text":"Jag ska ära dem,","poem":2},{"text":"och de ska inte vara obetydliga.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Hans söner ska bli som förr,","poem":1},{"text":"hans församling ska bestå","poem":2},{"text":"inför mig,","poem":3},{"text":"och jag ska straffa alla","poem":2},{"text":"som förtrycker honom.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Hans ledare ska vara","poem":1},{"text":"en av hans egna,","poem":3},{"text":"hans härskare ska utgå","poem":2},{"text":"från hans mitt.","poem":3},{"text":"Jag ska låta honom komma nära","poem":2},{"text":"och närma sig mig –","poem":3},{"text":"för vem skulle annars våga sitt liv","poem":2},{"noteId":114},{"text":"genom att närma sig mig?","poem":3},{"text":"säger Herren.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"Och ni ska vara mitt folk,","poem":1},{"text":"och jag ska vara er Gud.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Se, Herrens stormvind bryter fram,","poem":1},{"text":"full av vrede, en härjande storm!","poem":3},{"text":"Den virvlar ner","poem":2},{"text":"över de ogudaktigas huvuden.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Herrens brinnande vrede","poem":1},{"text":"ska inte vända åter","poem":3},{"text":"förrän han har utfört,","poem":2},{"text":"förrän han har fullbordat","poem":3},{"text":"sitt hjärtas tankar.","poem":4},{"text":"I den yttersta tiden","poem":2},{"text":"ska ni förstå det.","poem":3}]}],"footnotes":[{"noteId":113,"caller":"-","text":"David sin kung, som jag ska låta uppstå åt demProfetia om Messias, Davids son (Matt 1:1).","reference":{"chapter":30,"verse":9}},{"noteId":114,"caller":"-","text":"skulle annars våga sitt livAnnan översättning: ”kommer att viga sitt liv”.","reference":{"chapter":30,"verse":21}}]},"thisChapterLink":"/api/swe_fol/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}