{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"heading","content":["Israels kommande frälsning"]},{"type":"verse","number":1,"content":["På den tiden, säger Herren, ska jag vara Gud för alla Israels släkter, och de ska vara mitt folk."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Det folk","poem":2},{"text":"som kommer undan svärdet","poem":3},{"text":"finner nåd i öknen.","poem":4},{"text":"Israel får gå dit där jag ger det ro.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fjärran ifrån uppenbarade sig","poem":1},{"text":"Herren för mig","poem":3},{"noteId":115},{"text":":","poem":3},{"text":"”Med evig kärlek har jag älskat dig,","poem":2},{"text":"därför låter jag min nåd bli kvar","poem":3},{"text":"över dig.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Än en gång ska jag upprätta dig,","poem":1},{"text":"och du ska bli upprättad,","poem":3},{"text":"du jungfru Israel.","poem":4},{"text":"Än en gång ska du ta din tamburin","poem":2},{"text":"och dra ut i dans","poem":3},{"text":"bland dem som är glada.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Än en gång ska du","poem":1},{"text":"plantera vingårdar","poem":2},{"text":"på Samariens berg,","poem":3},{"text":"och de som planterar","poem":2},{"text":"ska själva njuta av frukten.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"För det kommer en dag","poem":1},{"text":"då väktare ropar på Efraims berg:","poem":3},{"text":"Kom, låt oss dra upp till Sion,","poem":2},{"text":"till Herren vår Gud.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"För så säger Herren:","poem":1},{"text":"Jubla i glädje över Jakob,","poem":2},{"text":"höj fröjderop över honom","poem":3},{"text":"som är den främste","poem":2},{"text":"bland folken.","poem":3},{"text":"Låt lovsången ljuda och säg:","poem":2},{"text":"”Fräls, Herre","poem":3},{"noteId":116},{"text":", ditt folk,","poem":3},{"text":"dem som är kvar av Israel.”","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Se, jag ska hämta dem","poem":1},{"text":"från landet i norr","poem":3},{"text":"och samla dem","poem":2},{"text":"från jordens yttersta hörn.","poem":3},{"text":"Bland dem finns","poem":2},{"text":"både blinda och halta,","poem":3},{"text":"både havande kvinnor","poem":2},{"text":"och barnaföderskor.","poem":3},{"text":"En stor skara","poem":2},{"text":"ska komma tillbaka hit.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Gråtande ska de komma,","poem":1},{"text":"men jag ska leda dem","poem":2},{"text":"där de går bedjande fram.","poem":3},{"noteId":117},{"text":"Jag ska föra dem till vattenbäckar","poem":2},{"text":"på en jämn väg","poem":3},{"text":"där de inte stapplar.","poem":4},{"text":"För jag är en Far för Israel,","poem":2},{"text":"och Efraim är min förstfödde son.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hör Herrens ord, ni hednafolk,","poem":1},{"text":"och förkunna det i kustländerna","poem":2},{"text":"i fjärran.","poem":3},{"text":"Säg: Han som skingrade Israel","poem":2},{"text":"ska också samla det","poem":3},{"text":"och bevara det","poem":2},{"text":"som en herde bevarar sin hjord.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"För Herren ska befria Jakob","poem":1},{"text":"och friköpa honom","poem":2},{"text":"från den som är starkare än han.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"De ska komma","poem":1},{"text":"och jubla på Sions höjd","poem":3},{"text":"och strömma som en flod","poem":2},{"text":"till Herrens goda,","poem":3},{"text":"till säd, vin och olja","poem":2},{"text":"och till unga får och oxar.","poem":3},{"text":"Deras själ ska vara","poem":2},{"text":"som en vattenrik trädgård,","poem":3},{"text":"och de ska inte sörja mer.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Då ska flickorna vara glada","poem":1},{"text":"och dansa,","poem":3},{"text":"unga och gamla","poem":2},{"text":"ska glädja sig tillsammans.","poem":3},{"text":"Jag ska förvandla deras sorg","poem":2},{"text":"till glädje","poem":3},{"text":"och trösta dem och glädja dem","poem":2},{"text":"efter deras bedrövelse.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Prästerna ska jag mätta","poem":1},{"text":"med utsökta rätter,","poem":3},{"text":"och mitt folk ska mättas","poem":2},{"text":"av mitt goda, säger Herren.","poem":3}]},{"type":"heading","content":["Guds barmhärtighet mot Israel"]},{"type":"verse","number":15,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Ett skri hörs i Rama","poem":2},{"noteId":118},{"text":",","poem":2},{"text":"klagan och bitter gråt.","poem":3},{"text":"Det är Rakel som gråter","poem":2},{"text":"över sina barn,","poem":3},{"text":"hon vägrar låta sig tröstas,","poem":2},{"text":"för hennes barn finns inte mer.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Men så säger Herren:","poem":1},{"text":"Stilla din högljudda gråt","poem":2},{"text":"och tårarna från dina ögon,","poem":3},{"text":"för ditt verk ska få sin lön,","poem":2},{"text":"säger Herren.","poem":3},{"text":"De ska komma tillbaka","poem":2},{"text":"från sina fienders land.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Det finns hopp för din framtid,","poem":1},{"text":"säger Herren.","poem":3},{"text":"Dina barn ska komma tillbaka","poem":2},{"text":"till sitt land.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Jag har hört hur Efraim klagar:","poem":1},{"text":"”Du har tuktat mig,","poem":3},{"text":"jag har blivit tuktad","poem":2},{"text":"som en otämjd kalv.","poem":3},{"text":"Omvänd mig, så blir jag omvänd!","poem":2},{"text":"För du är Herren min Gud.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"När jag nu har vänt om","poem":1},{"text":"känner jag ånger,","poem":3},{"text":"och när jag nu besinnat mig","poem":2},{"text":"slår jag mig på höften","poem":3},{"noteId":119},{"text":".","poem":3},{"text":"Jag både blygs och skäms","poem":2},{"text":"när jag nu bär","poem":3},{"text":"min ungdoms förnedring.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Är inte Efraim min käre son,","poem":1},{"text":"är han inte mitt älsklingsbarn?","poem":3},{"text":"Närhelst jag går till rätta","poem":2},{"text":"med honom tänker jag på honom.","poem":3},{"text":"Därför ömmar mitt hjärta","poem":2},{"text":"för honom.","poem":3},{"text":"Jag måste förbarma mig","poem":2},{"text":"över honom, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sätt upp vägmärken åt dig,","poem":1},{"text":"skaffa dig vägskyltar","poem":3},{"noteId":120},{"text":"!","poem":3},{"text":"Lägg vägen på minnet,","poem":2},{"text":"stigen där du vandrade.","poem":3},{"text":"Vänd tillbaka, du jungfru Israel,","poem":2},{"text":"vänd tillbaka till dina städer här.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Hur länge ska du irra hit och dit,","poem":1},{"text":"du trolösa dotter?","poem":3},{"text":"Herren vill skapa något nytt","poem":2},{"text":"på jorden:","poem":3},{"text":"En kvinna ska omsluta","poem":2},{"text":"en mäktig man.","poem":3},{"noteId":121}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Så säger Herren Sebaot,","poem":1},{"text":"Israels Gud:","poem":3},{"text":"När jag på nytt har gjort slut","poem":2},{"text":"på fångenskapen","poem":3},{"text":"för Juda land och dess städer,","poem":4},{"text":"ska man än en gång","poem":2},{"text":"uttala detta ord:","poem":3},{"text":"”Herren välsigne dig,","poem":2},{"text":"du rättfärdighetens boning,","poem":3},{"text":"du heliga berg.”","poem":4}]},{"type":"verse","number":24,"content":[{"text":"Och Juda folk med alla sina städer","poem":1},{"text":"ska bo där tillsammans,","poem":3},{"text":"både jordbrukare","poem":2},{"text":"och vandrande herdar.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"För jag ska stärka trötta själar","poem":1},{"text":"och mätta alla utsvultna själar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":["Med det vaknade jag och såg mig om. Min sömn hade varit skön."]},{"type":"verse","number":27,"content":["Se, dagar ska komma, säger Herren, då jag ska beså Israels land och Juda land med säd av människor och med säd av djur."]},{"type":"verse","number":28,"content":["Och liksom jag har vakat över dem för att rycka upp och riva ner, förstöra, förgöra och skada, ska jag nu vaka över dem för att bygga upp och plantera, säger Herren."]},{"type":"verse","number":29,"content":["På den tiden ska man inte mer säga: ”Fäderna åt sura druvor och barnens tänder blir ömma.”",{"noteId":122}]},{"type":"verse","number":30,"content":["Nej, var och en ska dö genom sin egen missgärning. Den som äter sura druvor får själv ömma tänder."]},{"type":"heading","content":["Det nya förbundet"]},{"type":"verse","number":31,"content":[{"text":"Se, dagar ska komma, säger Herren,","poem":1},{"text":"då jag sluter ett nytt förbund","poem":3},{"text":"med Israels hus","poem":2},{"text":"och med Juda hus,","poem":3},{"noteId":123}]},{"type":"verse","number":32,"content":[{"text":"inte som förbundet jag slöt","poem":1},{"text":"med deras fäder","poem":3},{"text":"den dag då jag tog deras hand","poem":2},{"text":"och förde dem ut","poem":3},{"text":"ur Egyptens land –","poem":4},{"text":"förbundet med mig som de bröt","poem":2},{"text":"fastän jag var deras rätte herre –","poem":3},{"text":"säger Herren.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Nej, detta är förbundet","poem":1},{"text":"som jag efter denna tid","poem":3},{"text":"ska sluta med Israels hus,","poem":2},{"text":"säger Herren:","poem":3},{"text":"Jag ska lägga min lag i deras inre","poem":2},{"text":"och skriva den i deras hjärtan.","poem":3},{"text":"Jag ska vara deras Gud,","poem":2},{"text":"och de ska vara mitt folk.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Då ska de inte mer behöva","poem":1},{"text":"undervisa varandra,","poem":3},{"text":"ingen sin broder och säga:","poem":2},{"text":"”Lär känna Herren!”","poem":3},{"text":"Alla ska känna mig,","poem":2},{"text":"från den minste av dem","poem":3},{"text":"till den störste, säger Herren,","poem":4},{"text":"för jag ska förlåta","poem":2},{"text":"deras missgärningar","poem":3},{"text":"och aldrig mer minnas","poem":2},{"text":"deras synder.","poem":3}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Så säger Herren,","poem":1},{"text":"han som har satt solen","poem":2},{"text":"till att lysa om dagen","poem":3},{"text":"och ordnat månen och stjärnorna","poem":2},{"text":"till att lysa om natten,","poem":3},{"text":"han som rör upp havet","poem":2},{"text":"så att vågorna dånar,","poem":3},{"text":"Herren Sebaot är hans namn:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Om denna ordning upphör","poem":1},{"text":"inför mig, säger Herren,","poem":3},{"text":"först då ska Israels släkte","poem":2},{"text":"upphöra som folk inför mig","poem":3},{"text":"för alltid.","poem":4}]},{"type":"verse","number":37,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Om himlen därovan kan mätas","poem":2},{"text":"och jordens grundvalar därnere","poem":3},{"text":"kan utforskas,","poem":4},{"text":"först då ska jag förkasta","poem":2},{"text":"hela Israels släkte","poem":3},{"text":"för allt de har gjort, säger Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":["Se, dagar ska komma, säger Herren, då staden ska bli uppbyggd åt Herren, från Hananeltornet till Hörnporten."]},{"type":"verse","number":39,"content":["Och mätsnöret ska vidare dras rätt fram mot Garebshöjden och ska sedan vändas mot Goa."]},{"type":"verse","number":40,"content":["Hela dalen där man har lagt lik",{"noteId":124},"och aska och alla fälten ner till Kidrondalen och till hörnet vid Hästporten österut ska vara helgade åt Herren. Aldrig mer ska staden raseras eller förstöras."]}],"footnotes":[{"noteId":115,"caller":"-","text":"migAndra handskrifter (Septuaginta): ”honom” (alltså Israel).","reference":{"chapter":31,"verse":3}},{"noteId":116,"caller":"-","text":"Fräls, HerreAnnan översättning (Septuaginta): ”HERREN har frälst”.","reference":{"chapter":31,"verse":7}},{"noteId":117,"caller":"-","text":"där de går bedjande framOrdagrant: ”med/under böner”.","reference":{"chapter":31,"verse":9}},{"noteId":118,"caller":"-","text":"RamaHöjd en halvmil norr om Jerusalem där fångarna samlades 587 f Kr för transport till Babel (40:1). I närheten fanns Rakels grav (1 Sam 10:2), på vägen mot Betlehem (1 Mos 35:19). Versen citeras i Matt 2:18 som profetia om mordet på barnen i Betlehem.","reference":{"chapter":31,"verse":15}},{"noteId":119,"caller":"-","text":"slår jag mig på höftenUttryck för sorg och smärta.","reference":{"chapter":31,"verse":19}},{"noteId":120,"caller":"-","text":"vägskyltarGrundtexten svårtolkad. Annan översättning: ”det bittra”.","reference":{"chapter":31,"verse":21}},{"noteId":121,"caller":"-","text":"En kvinna ska omsluta en mäktig manMöjligen profetia om Messias (Matt 1:18, Luk 1:31f).","reference":{"chapter":31,"verse":22}},{"noteId":122,"caller":"-","text":"Fäderna åt sura druvorEtt gängse ordspråk (se Hes 18:2). Jfr 2 Mos 20:5.","reference":{"chapter":31,"verse":29}},{"noteId":123,"caller":"-","text":"Citeras i Hebr 8:8f och 10:16f som profetia om det nya förbundet genom Kristi blod (jfr Luk 22:20).","reference":{"chapter":31,"verse":31}},{"noteId":124,"caller":"-","text":"dalen där man har lagt likHinnomsdalen i sydväst, som mötte Kidrondalen i öst.","reference":{"chapter":31,"verse":40}}]},"thisChapterLink":"/api/swe_fol/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}