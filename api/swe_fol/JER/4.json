{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Om du vill vända tillbaka, Israel,",{"text":"säger Herren,","poem":2},{"text":"vänd då om till mig.","poem":3},{"text":"Om du tar bort","poem":2},{"text":"dina avskyvärda gudar","poem":3},{"text":"från min åsyn","poem":4},{"text":"ska du slippa irra runt som flykting.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Du ska svära i sanning,","poem":1},{"text":"rätt och rättfärdighet:","poem":2},{"text":"”Så sant Herren lever”,","poem":3},{"text":"och då ska hednafolken","poem":2},{"text":"välsigna sig i honom","poem":3},{"text":"och ha sin ära i honom.","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Så säger Herren","poem":1},{"text":"till Juda män och till Jerusalem:","poem":3},{"text":"Bryt er ny mark!","poem":2},{"text":"Så inte bland törnen.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Omskär er för Herren,","poem":1},{"text":"ta bort ert hjärtas förhud,","poem":3},{"text":"ni Juda män","poem":2},{"text":"och Jerusalems invånare.","poem":3},{"text":"Annars ska min vrede","poem":2},{"text":"bryta fram som en eld","poem":3},{"text":"och brinna så att ingen kan släcka,","poem":2},{"text":"för era onda gärningars skull.","poem":3}]},{"type":"heading","content":["Kommande dom"]},{"type":"verse","number":5,"content":[{"text":"Förkunna i Juda","poem":1},{"text":"och ropa och säg det i Jerusalem,","poem":3},{"text":"blås i hornet i landet,","poem":2},{"text":"ropa med hög röst och säg:","poem":3},{"text":"”Låt oss samlas","poem":2},{"text":"och gå in i de befästa städerna","poem":3},{"noteId":23},{"text":"!”","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Res ett baner i riktning mot Sion,","poem":1},{"text":"sök skydd, stanna inte!","poem":3},{"text":"För jag ska låta olyckan komma","poem":2},{"text":"från norr med stor förödelse.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ett lejon kommer fram ur sitt snår,","poem":1},{"text":"en folkfördärvare","poem":3},{"noteId":24},{"text":"bryter upp.","poem":3},{"text":"Han går ut ur sin boning","poem":2},{"text":"för att göra ditt land","poem":3},{"text":"till en ödemark.","poem":4},{"text":"Då läggs dina städer i ruiner","poem":2},{"text":"så att ingen kan bo där.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Klä er därför i säcktyg,","poem":1},{"text":"klaga och jämra er,","poem":3},{"text":"för Herrens brinnande vrede","poem":2},{"text":"har inte vänt sig bort från oss.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"På den dagen, säger Herren,","poem":1},{"text":"ska kungen och furstarna","poem":2},{"text":"tappa modet,","poem":3},{"text":"prästerna bli förfärade","poem":2},{"text":"och profeterna vara bestörta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Men jag sade",{"noteId":25},": O, Herre Gud, hur svårt bedrog du inte detta folk och Jerusalem när du sade: ”Det ska gå er väl.” Svärdet är ju nära att ta våra liv!"]},{"type":"verse","number":11,"content":["På den tiden ska det sägas till detta folk och till Jerusalem: En brännhet vind från de kala höjderna i öknen sveper in mot dottern mitt folk – inte för att kasta säd eller rensa korn",{"noteId":26},","]},{"type":"verse","number":12,"content":["en starkare vind än så kommer från mig. Nu ska också jag gå till rätta med dem!"]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Se, han stiger upp som ett moln,","poem":1},{"text":"hans vagnar är som en stormvind,","poem":2},{"text":"hans hästar är snabbare än örnar.","poem":3},{"text":"Ve oss, vi är förlorade!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tvätta bort ondskan från ditt hjärta,","poem":1},{"text":"Jerusalem, så att du blir räddad!","poem":3},{"text":"Hur länge ska onda tankar","poem":2},{"text":"bo i ditt bröst?","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Från Dan","poem":1},{"noteId":27},{"text":"hörs en röst ropa,","poem":1},{"text":"från Efraims berg","poem":2},{"text":"en som bådar olycka.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Kungör för folken,","poem":1},{"text":"tala om för Jerusalem:","poem":3},{"text":"En belägringshär kommer","poem":2},{"text":"från fjärran land","poem":3},{"text":"och höjer sitt rop mot Juda städer.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Som väktare kring ett åkerfält","poem":1},{"text":"omringar de henne,","poem":3},{"text":"för hon har varit upprorisk","poem":2},{"text":"mot mig, säger Herren.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Din väg och dina gärningar","poem":1},{"text":"vållar dig detta.","poem":3},{"text":"Din ondska gör att det blir så bittert,","poem":2},{"text":"att plågan träffar dig","poem":3},{"text":"ända in i hjärtat.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"O, mitt inre, mitt inre!","poem":1},{"text":"Jag vrider mig av smärta","poem":2},{"text":"i mitt hjärtas djup.","poem":3},{"text":"Mitt hjärta klagar i mig,","poem":2},{"text":"jag kan inte tiga,","poem":3},{"text":"för min själ har hört","poem":2},{"text":"hornstötar och stridsrop.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Katastrof på katastrof ropas ut,","poem":1},{"text":"hela landet läggs öde.","poem":3},{"text":"Plötsligt blir mina tält förstörda,","poem":2},{"text":"på ett ögonblick mina tältdukar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hur länge ska jag se stridsbaneret","poem":1},{"text":"och höra hornstötarna?","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Mitt folk är dåraktigt,","poem":1},{"text":"de känner mig inte.","poem":3},{"text":"De är oförnuftiga barn","poem":2},{"text":"och förstår ingenting.","poem":3},{"text":"De är skickliga på att göra ont,","poem":2},{"text":"men de förstår inte att göra gott.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Jag såg på jorden,","poem":1},{"text":"och den var öde och tom,","poem":3},{"text":"upp mot himlen,","poem":2},{"text":"och där fanns inget ljus.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Jag såg på bergen, och de bävade","poem":1},{"text":"och alla höjder vacklade.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Jag såg mig om,","poem":1},{"text":"och där fanns ingen människa,","poem":2},{"text":"himlens alla fåglar hade flytt.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Jag såg mig om,","poem":1},{"text":"och det bördiga landet","poem":2},{"text":"var en öken,","poem":3},{"text":"alla dess städer var ödelagda","poem":2},{"text":"inför Herrens ansikte,","poem":3},{"text":"för hans brinnande vrede.","poem":4}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"För så säger Herren:","poem":1},{"text":"Hela landet ska bli en ödemark,","poem":3},{"text":"men jag ska inte göra slut","poem":2},{"text":"på det helt.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Därför sörjer jorden","poem":1},{"text":"och himlen ovanför mörknar,","poem":3},{"text":"för vad jag har talat och beslutat","poem":2},{"text":"ska jag inte ångra eller ta tillbaka.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"För larmet av ryttare och bågskyttar","poem":1},{"text":"flyr hela staden.","poem":3},{"text":"Man ger sig in i skogssnåren","poem":2},{"text":"och upp bland klipporna.","poem":3},{"text":"Alla städer är övergivna,","poem":2},{"text":"ingen människa bor i dem mer.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Du ödelagda, vad vill du göra?","poem":1},{"text":"Även om du klär dig i scharlakan","poem":2},{"text":"och smyckar dig","poem":3},{"noteId":28},{"text":"med smycken av guld,","poem":4},{"text":"om du förstorar dina ögon","poem":2},{"text":"med smink,","poem":4},{"text":"så gör du dig vacker förgäves.","poem":2},{"text":"Dina älskare föraktar dig,","poem":3},{"text":"de vill ta ditt liv.","poem":4}]},{"type":"verse","number":31,"content":[{"text":"För jag hör rop","poem":1},{"text":"som från en födande kvinna,","poem":3},{"text":"ångestrop","poem":2},{"text":"som från en förstföderska.","poem":3},{"text":"Det är dottern Sions röst.","poem":2},{"text":"Hon flämtar,","poem":3},{"text":"hon räcker ut sina händer:","poem":4},{"text":"”O, ve mig!","poem":2},{"text":"Mitt liv tynar bort","poem":3},{"text":"inför mördare.”","poem":4}]}],"footnotes":[{"noteId":23,"caller":"-","text":"de befästa städernaHit samlades byarnas folk i orostid (jfr Ps 48).","reference":{"chapter":4,"verse":5}},{"noteId":24,"caller":"-","text":"en folkfördärvareTroligen Nebukadnessar, som kom efter Josias tid (se 2 Kung 24-25).","reference":{"chapter":4,"verse":7}},{"noteId":25,"caller":"-","text":"jag sadeAndra handskrifter (Septuaginta): ”de sade” (men jfr 14:13).","reference":{"chapter":4,"verse":10}},{"noteId":26,"caller":"-","text":"kasta säd eller rensa kornNormalt skilde vinden agnarna från vetet (se Matt 3:12 med not), men ökenstormen sopade bort dem båda (rättfärdiga och orättfärdiga).","reference":{"chapter":4,"verse":11}},{"noteId":27,"caller":"-","text":"DanIsraels nordligaste stad som först mötte invasionshären.","reference":{"chapter":4,"verse":15}},{"noteId":28,"caller":"-","text":"smyckar digSå försökte Isebel möta krigaren Jehu (2 Kung 9:30, jfr också Hes 23:40).","reference":{"chapter":4,"verse":30}}]},"thisChapterLink":"/api/swe_fol/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}