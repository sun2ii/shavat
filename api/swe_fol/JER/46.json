{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Profetia om Egypten"]},{"type":"verse","number":1,"content":["Detta är Herrens ord som kom till Jeremia om hednafolken."]},{"type":"verse","number":2,"content":["Om Egypten. Angående den egyptiske kungen farao Nekos här som stod vid floden Eufrat nära Karkemish",{"noteId":185},"och blev slagen av Babels kung Nebukadressar i Juda kung Jojakims, Josias sons, fjärde regeringsår."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gör i ordning sköld och skydd","poem":1},{"noteId":186},{"text":"och ryck fram till strid!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Spänn för hästarna,","poem":1},{"text":"sitt upp på springarna","poem":3},{"text":"och ställ upp er","poem":2},{"text":"med hjälmarna på.","poem":3},{"text":"Gör spjuten blanka,","poem":2},{"text":"klä er i pansar.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Vad ser jag?","poem":1},{"text":"De är förfärade,","poem":2},{"text":"de viker tillbaka,","poem":3},{"text":"deras hjältar blir slagna och flyr","poem":2},{"text":"utan att vända sig om.","poem":3},{"text":"Det är skräck från alla håll,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Inte ens den snabbaste kan fly,","poem":1},{"text":"inte ens hjälten","poem":2},{"text":"kan komma undan.","poem":3},{"text":"Norrut, vid floden Eufrat,","poem":2},{"text":"där stapplar de och faller.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vem är det som stiger som Nilfloden,","poem":1},{"text":"likt strömmar","poem":2},{"text":"av framvällande vatten?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Det är Egypten","poem":1},{"text":"som stiger som Nilfloden,","poem":3},{"text":"likt strömmar","poem":2},{"text":"av framvällande vatten.","poem":3},{"text":"Han säger:","poem":2},{"text":"”Jag ska dra upp","poem":3},{"text":"och täcka landet,","poem":4},{"text":"jag ska förstöra städerna","poem":3},{"text":"och dem som bor i dem.”","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Dra dit upp, ni hästar,","poem":1},{"text":"storma fram, ni vagnar.","poem":3},{"text":"Dra ut, ni hjältar,","poem":2},{"text":"nubier och puteer,","poem":3},{"text":"rustade med sköldar,","poem":2},{"text":"och ludeer","poem":3},{"noteId":187},{"text":",","poem":3},{"text":"rustade med bågar","poem":2},{"text":"som de spänner.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Detta är Herren Gud Sebaots dag,","poem":1},{"text":"en hämndens dag","poem":3},{"text":"då han hämnas","poem":2},{"text":"på sina motståndare.","poem":3},{"text":"Svärdet frossar sig mätt,","poem":2},{"text":"det dricker sig rusigt","poem":3},{"text":"av deras blod,","poem":4},{"text":"för detta är ett slaktoffer","poem":2},{"text":"åt Herren Gud Sebaot","poem":3},{"text":"i Nordlandet vid floden Eufrat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dra upp till Gilead","poem":1},{"text":"och hämta balsam,","poem":2},{"text":"du jungfru dotter Egypten.","poem":3},{"text":"Men förgäves har du skaffat","poem":2},{"text":"läkemedel i mängd.","poem":3},{"text":"Du kan inte bli botad.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hednafolken har hört om din skam,","poem":1},{"text":"och dina sorgerop","poem":2},{"text":"uppfyller jorden,","poem":3},{"text":"för den ene hjälten","poem":2},{"text":"snavar på den andre","poem":3},{"text":"och de båda faller tillsammans.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":["Detta ord talade Herren till profeten Jeremia om att Babels kung Nebukadressar skulle komma och besegra Egypten:"]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Förkunna i Egypten","poem":1},{"text":"och ropa ut det i Migdol,","poem":3},{"text":"ropa ut det i Memfis","poem":2},{"text":"och även i Tachpanches och säg:","poem":3},{"text":"”Träd fram och gör dig beredd,","poem":2},{"text":"för svärdet frossar","poem":3},{"text":"runt omkring dig.”","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Varför slogs dina hjältar","poem":1},{"text":"till marken","poem":3},{"noteId":188},{"text":"?","poem":3},{"text":"De kunde inte hålla stånd,","poem":2},{"text":"för Herren stötte bort dem.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Han fick många att vackla,","poem":1},{"text":"och de föll, den ene över den andre,","poem":2},{"text":"och ropade:","poem":3},{"text":"”Upp, låt oss vända tillbaka","poem":2},{"text":"till vårt folk","poem":3},{"text":"och till landet där vi föddes,","poem":2},{"text":"undan det härjande svärdet!”","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Man ropar där:","poem":1},{"text":"”Farao, Egyptens kung,","poem":2},{"text":"är bara ett buller!","poem":3},{"text":"Han har försummat sin tid.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Så sant jag lever, säger Kungen,","poem":1},{"text":"Herren Sebaot är hans namn:","poem":3},{"text":"Som Tabor bland bergen,","poem":2},{"text":"som Karmel vid havet","poem":3},{"text":"ska han komma.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Gör er beredda för landsflykt,","poem":1},{"text":"ni dotter Egyptens invånare,","poem":3},{"text":"för Memfis ska bli en ödemark","poem":2},{"text":"och brännas ner så att ingen","poem":3},{"text":"kan bo där.","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"En skön kviga är Egypten,","poem":1},{"text":"men en broms kommer farande","poem":2},{"text":"från norr.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Också legosoldaterna i landet","poem":1},{"text":"liknar gödda kalvar.","poem":3},{"text":"De vänder alla om, alla flyr de,","poem":2},{"text":"för de kan inte stå emot.","poem":3},{"text":"Deras ofärds dag har drabbat dem,","poem":2},{"text":"tiden för deras straff är inne.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Hon väser likt en orm","poem":1},{"text":"som ringlar i väg,","poem":3},{"text":"för de drar fram med vapenmakt","poem":2},{"text":"och kommer över henne","poem":3},{"text":"med yxor,","poem":4},{"text":"som för att hugga ved.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"De fäller hennes skog, säger Herren,","poem":1},{"text":"för den är ogenomtränglig.","poem":3},{"text":"De är fler än gräshoppor,","poem":2},{"text":"de kan inte räknas.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Egyptens dotter kommer på skam,","poem":1},{"text":"hon utlämnas åt folket från norr.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":["Så säger Herren Sebaot, Israels Gud: Se, jag ska straffa Amon från No",{"noteId":189},"och farao och Egypten med dess gudar och dess kungar, både farao och dem som förlitar sig på honom."]},{"type":"verse","number":26,"content":["Jag ska överlämna dem åt dem som vill ta deras liv, till Babels kung Nebukadressar och hans tjänare. Men därefter ska landet bli bebott som i forna dagar, säger Herren."]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Så var inte rädd,","poem":1},{"text":"du min tjänare Jakob,","poem":3},{"text":"och var inte förskräckt,","poem":2},{"text":"du Israel,","poem":3},{"text":"för se, jag ska rädda dig","poem":2},{"text":"ur det fjärran landet","poem":3},{"text":"och dina barn ur landet","poem":2},{"text":"där de är fångna.","poem":3},{"text":"Jakob ska vända tillbaka","poem":2},{"text":"och leva i trygghet,","poem":3},{"text":"och ingen ska skrämma honom.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Var inte rädd, du min tjänare Jakob,","poem":1},{"text":"säger Herren, för jag är med dig.","poem":3},{"text":"Jag ska göra slut på alla de folk","poem":2},{"text":"dit jag fördrivit dig.","poem":3},{"text":"Men dig ska jag inte göra slut på,","poem":2},{"text":"bara tukta dig med rättvisa,","poem":3},{"text":"för helt ostraffad","poem":2},{"text":"kan jag inte lämna dig.","poem":3}]}],"footnotes":[{"noteId":185,"caller":"-","text":"farao Nekos här … nära KarkemishEgyptens nederlag i norra Syrien år 605 f Kr befäste Babel som regionens stormakt (jfr 27:6f, 2 Kung 23:29, 24:7).","reference":{"chapter":46,"verse":2}},{"noteId":186,"caller":"-","text":"sköld och skyddSmå sköldar för närstrid och stora mot pilar.","reference":{"chapter":46,"verse":3}},{"noteId":187,"caller":"-","text":"nubier och puteer … ludeerLegosoldater från Sudan, Libyen och Lydien i västra Turkiet.","reference":{"chapter":46,"verse":9}},{"noteId":188,"caller":"-","text":"slogs dina hjältar till markenAndra handskrifter (Septuaginta): ”flydde din mäktige Apis”. (Egyptens tjurgud som dyrkades i Memfis).","reference":{"chapter":46,"verse":15}},{"noteId":189,"caller":"-","text":"Amon från NoEgyptens högsta gud Amon-Ra dyrkades i Karnaktemplet i södra Egyptens huvudstad Thebe, som i Bibeln kallas No (jfr Nah 3:8).","reference":{"chapter":46,"verse":25}}]},"thisChapterLink":"/api/swe_fol/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}