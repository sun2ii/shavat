e":"verse","number":4,"content":[{"text":"inför dagen som kommer","poem":1},{"text":"då alla filisteer förintas,","poem":3},{"text":"då alla utrotas som är kvar","poem":2},{"text":"för att försvara Tyrus och Sidon.","poem":3},{"text":"För Herren ska förinta filisteerna,","poem":2},{"text":"dem som är kvar från Kaftors ö","poem":3},{"noteId":191},{"text":".","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Gazas huvud ska rakas,","poem":1},{"text":"det är slut med Ashkelon,","poem":2},{"text":"med dem som är kvar i deras dal","poem":3},{"noteId":192},{"text":".","poem":3},{"text":"Hur länge ska du rista märken","poem":2},{"text":"på dig?","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"O, du Herrens svärd,","poem":1},{"text":"när ska du äntligen få ro?","poem":3},{"text":"Dra dig in i din skida,","poem":2},{"text":"vila och var stilla.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Men hur ska det få ro","poem":1},{"text":"när Herren har gett","poem":2},{"text":"sin befallning?","poem":3},{"text":"Mot Ashkelon och mot kustlandet,","poem":2},{"text":"dit har han befallt det.","poem":3}]}],"footnotes":[{"noteId":190,"caller":"-","text":"innan farao intog GazaEn egyptisk motattack mot Nebukadnessar erövrade Gaza år 601-599 f Kr. Nebukadnessar skövlade Gazaområdet 604 f Kr och gjorde slut på filisteerna helt 588 f Kr (jfr Hes 25:16).","reference":{"chapter":47,"verse":1}},{"noteId":191,"caller":"-","text":"Kaftors öTroligen Kreta (jfr 1 Mos 10:14, 5 Mos 2:23, Amos 9:7).","reference":{"chapter":47,"verse":4}},{"noteId":192,"caller":"-","text":"i deras dalAndra handskrifter (Septuaginta): ”av anakiterna” (jättar bland filisteerna, jfr 5 Mos 9:2, 1 Sam 17:4).","reference":{"chapter":47,"verse":5}}]},"thisChapterLink":"/api/swe_fol/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/46.json","previousChapterAudioLin