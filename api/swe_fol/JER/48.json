{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Profetia om Moab"]},{"type":"verse","number":1,"content":["Om Moab",{"noteId":193},".",{"text":"Så säger Herren Sebaot,","poem":2},{"text":"Israels Gud:","poem":3},{"text":"Ve över Nebo,","poem":2},{"text":"för det har ödelagts!","poem":3},{"text":"Kirjatajim har kommit på skam","poem":2},{"text":"och intagits,","poem":3},{"text":"fästet har kommit på skam","poem":2},{"text":"och ligger krossat.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Moab prisas inte längre.","poem":1},{"text":"I Heshbon smider man","poem":2},{"text":"onda planer mot det:","poem":3},{"text":"”Kom, låt oss göra slut på det,","poem":2},{"text":"så att det inte mer är ett folk!”","poem":3},{"text":"Också du, Madmen, ska tystas,","poem":2},{"text":"svärdet ska förfölja dig.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Sorgerop hörs från Horonajim,","poem":1},{"text":"förödelse och stor förstörelse.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moab är krossat,","poem":1},{"text":"högljutt klagar barnen där.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uppför backen mot Luhit","poem":1},{"text":"går man under gråt,","poem":3},{"text":"och på vägen ner till Horonajim","poem":2},{"text":"hörs ångestfulla sorgerop","poem":3},{"text":"över förstörelsen.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Fly, rädda era liv","poem":1},{"text":"och bli som en buske i öknen!","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Eftersom du litar","poem":1},{"text":"till dina gärningar och dina skatter","poem":2},{"text":"ska också du intas.","poem":3},{"text":"Och Kemosh","poem":2},{"noteId":194},{"text":"ska gå i fångenskap","poem":2},{"text":"och hans präster","poem":3},{"text":"och furstar med honom.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ödeläggaren ska drabba varje stad,","poem":1},{"text":"och ingen stad","poem":2},{"text":"ska komma undan.","poem":3},{"text":"Dalen ska bli fördärvad","poem":2},{"text":"och slätten läggas öde,","poem":3},{"text":"så som Herren har sagt.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ge Moab vingar","poem":1},{"noteId":195},{"text":",","poem":1},{"text":"flygande måste han fly.","poem":3},{"text":"Hans städer ska bli öde,","poem":2},{"text":"och ingen ska bo i dem.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Förbannad är den som utför","poem":1},{"text":"Herrens verk försumligt,","poem":3},{"text":"förbannad är den som tvekar","poem":2},{"text":"att bloda ner sitt svärd!","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Moab har levt i trygghet","poem":1},{"text":"från sin ungdom,","poem":3},{"text":"han har legat i ro","poem":2},{"text":"som vin på sin bottensats.","poem":3},{"text":"Han har inte hällts från kärl till kärl,","poem":2},{"text":"inte vandrat bort i fångenskap.","poem":3},{"text":"Därför har han kvar sin smak,","poem":2},{"text":"och hans luktsinne","poem":3},{"text":"har inte förändrats.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Se, därför ska dagar komma, säger Herren, då jag sänder till honom vintappare, som ska tappa honom och tömma hans fat och krossa hans krukor."]},{"type":"verse","number":13,"content":["Då ska Moab skämmas för Kemosh, liksom Israels folk fick skämmas för Betel som de litade till."]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hur kan ni säga:","poem":1},{"text":"”Vi är hjältar","poem":2},{"text":"och tappra män i striden”?","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Moab ska ödeläggas,","poem":1},{"text":"dess städer gå upp i rök","poem":3},{"text":"och dess utvalda unga män","poem":2},{"text":"komma ner för att slaktas.","poem":3},{"text":"Så säger Kungen,","poem":2},{"text":"Herren Sebaot är hans namn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Moabs undergång är nära,","poem":1},{"text":"hans olycka kommer med hast.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ha medlidande med honom,","poem":1},{"text":"alla ni som bor omkring honom,","poem":2},{"text":"alla ni som känner hans namn!","poem":3},{"text":"Säg: ”Hur sönderbruten är inte","poem":2},{"text":"den starka spiran,","poem":3},{"text":"den härliga staven!”","poem":4}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kom ner från din härlighet","poem":1},{"text":"och sätt dig på torra marken,","poem":2},{"text":"du dotter Dibons folk,","poem":3},{"text":"för den som ödelägger Moab","poem":2},{"text":"drar upp mot dig","poem":3},{"text":"och förstör dina fästen.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Ställ dig vid vägen","poem":1},{"text":"och se dig omkring,","poem":2},{"text":"du som bor i Aroer.","poem":3},{"text":"Fråga honom som flyr","poem":2},{"text":"och henne som kommit undan,","poem":3},{"text":"säg: ”Vad har hänt?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moab har kommit på skam,","poem":1},{"text":"det är krossat, jämra er och ropa!","poem":3},{"text":"Berätta vid Arnon","poem":2},{"text":"att Moab är ödelagt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Domen har drabbat slättlandet, över Holon, Jahas och Mofaat,"]},{"type":"verse","number":22,"content":["över Dibon, Nebo och Bet-Diblatajim,"]},{"type":"verse","number":23,"content":["över Kirjatajim, Bet-Gamul och Bet-Meon,"]},{"type":"verse","number":24,"content":["över Keriot och Bosra och över alla andra städer i Moabs land, vare sig de ligger långt borta eller nära."]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Avhugget är Moabs horn","poem":1},{"text":"och sönderbruten är hans arm,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":["Gör honom drucken, för han har upphävt sig mot Herren. Moab ska vältra sig i spyor och bli till åtlöje, också han."]},{"type":"verse","number":27,"content":["Eller var inte Israel till åtlöje för dig? Ertappades han bland tjuvar, eftersom du skakar på huvudet så ofta du talar om honom?"]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Överge städerna","poem":1},{"text":"och bygg bo i klippan,","poem":2},{"text":"ni Moabs invånare.","poem":3},{"text":"Gör som duvan","poem":2},{"text":"som bygger sitt näste","poem":3},{"text":"i sidorna på gapande klyftor.","poem":4}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Vi har hört om Moabs högmod,","poem":1},{"text":"hans gränslöst stora högfärd,","poem":3},{"text":"hans stolthet,","poem":2},{"text":"högmod och överlägsenhet","poem":3},{"text":"och hans hjärtas förhävelse.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Jag känner hans fräckhet,","poem":1},{"text":"säger Herren,","poem":3},{"text":"hans tomma skryt","poem":2},{"text":"och svekfulla sätt.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Därför jämrar jag mig","poem":1},{"text":"för Moabs skull","poem":2},{"text":"och klagar över hela Moab.","poem":3},{"text":"Över Kir-Heres män","poem":2},{"text":"ska man sucka.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Mer än Jaeser gråter,","poem":1},{"text":"gråter jag över dig,","poem":2},{"text":"du Sibmas vinstock.","poem":3},{"text":"Dina rankor gick över havet","poem":2},{"text":"och nådde till Jaesers hav.","poem":3},{"text":"Mitt i din sommar","poem":2},{"text":"och din vinbärgning","poem":3},{"text":"har ödeläggaren slagit ner.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Glädjen och jublet har ryckts bort","poem":1},{"text":"från de bördiga fälten","poem":2},{"text":"och från Moabs land.","poem":3},{"text":"Jag har gjort slut","poem":2},{"text":"på vinet i pressarna,","poem":3},{"text":"man trampar inte längre vin","poem":2},{"text":"under glädjerop –","poem":3},{"text":"rop hörs men inte glädjerop.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Från Heshbon hörs rop","poem":1},{"text":"ända till Eleale,","poem":3},{"text":"ända till Jahas","poem":2},{"text":"höjer man sin röst","poem":3},{"text":"och från Soar ända till Horonajim,","poem":2},{"text":"till Eglat-Selisia,","poem":3},{"text":"för också Nimrims vatten","poem":2},{"text":"har blivit torr mark.","poem":3}]},{"type":"verse","number":35,"content":[{"text":"Jag ska i Moab göra slut på dem","poem":1},{"text":"som bär fram offer","poem":2},{"text":"på offerhöjden","poem":3},{"text":"och tänder rökelse åt sina gudar,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Därför klagar mitt hjärta","poem":1},{"text":"som en flöjt över Moab,","poem":3},{"text":"mitt hjärta klagar som en flöjt","poem":2},{"text":"över Kir-Heres män.","poem":3},{"text":"Det som är kvar","poem":2},{"text":"av vad de förvärvat","poem":3},{"text":"går förlorat.","poem":4}]},{"type":"verse","number":37,"content":[{"text":"Alla huvuden är rakade","poem":1},{"text":"och alla skägg avskurna.","poem":3},{"text":"På alla händer finns ristningar","poem":2},{"text":"och runt höfterna bär de säcktyg.","poem":3}]},{"type":"verse","number":38,"content":[{"text":"På alla Moabs tak och på dess torg","poem":1},{"text":"hörs bara dödsklagan,","poem":3},{"text":"för jag har krossat Moab","poem":2},{"text":"som ett värdelöst kärl,","poem":3},{"text":"säger Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Hur nerbruten är han inte,","poem":1},{"text":"hur jämrar de sig inte!","poem":3},{"text":"Hur vänder inte Moab ryggen till","poem":2},{"text":"i skam!","poem":3},{"text":"Moab blir ett åtlöje och en skräck","poem":2},{"text":"för alla som bor omkring honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"För så säger Herren:","poem":1},{"text":"Se, han svävar fram som en örn,","poem":2},{"text":"han breder ut sina vingar","poem":3},{"text":"över Moab.","poem":4}]},{"type":"verse","number":41,"content":[{"text":"Keriot intas, fästena erövras.","poem":1},{"text":"Hjärtat hos Moabs hjältar","poem":2},{"text":"blir på den dagen","poem":3},{"text":"som hjärtat hos en kvinna","poem":2},{"text":"i barnsnöd.","poem":3}]},{"type":"verse","number":42,"content":[{"text":"Moab ska förgöras","poem":1},{"text":"så att det inte mer är ett folk,","poem":3},{"text":"för han har förhävt sig mot Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Fruktan, fallgrop och fälla","poem":1},{"text":"väntar er, ni Moabs invånare,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"verse","number":44,"content":[{"text":"Den som flyr från skräcken","poem":1},{"text":"störtar i fallgropen,","poem":3},{"text":"och den som kommer upp","poem":2},{"text":"ur fallgropen fastnar i fällan,","poem":3},{"text":"för jag ska låta ett hemsökelsens år","poem":2},{"text":"drabba Moab, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"I Heshbons skugga stannar de,","poem":1},{"text":"det är slut","poem":2},{"text":"med flyktingarnas kraft,","poem":3},{"text":"för en eld gick ut från Heshbon,","poem":2},{"text":"en låga från Sichon.","poem":3},{"text":"Den förtärde Moabs sida,","poem":2},{"text":"hjässan på stridslarmets söner.","poem":3}]},{"type":"verse","number":46,"content":[{"text":"Ve dig Moab!","poem":1},{"text":"Förlorat är Kemosh folk,","poem":3},{"text":"för dina söner har tagits till fånga,","poem":2},{"text":"dina döttrar har förts bort","poem":3},{"text":"i fångenskap.","poem":4}]},{"type":"verse","number":47,"content":[{"text":"Men i kommande dagar","poem":1},{"text":"ska jag göra slut","poem":2},{"text":"på Moabs fångenskap,","poem":3},{"text":"säger Herren.","poem":2},{"lineBreak":true},"Så långt domen över Moab."]}],"footnotes":[{"noteId":193,"caller":"-","text":"MoabFolk öster om Döda havet som deltog i upproret mot Nebukadnessar (27:3). Enligt Josefus härjades de av Nebukadnessar år 582 f Kr (jfr Hes 25:8f).","reference":{"chapter":48,"verse":1}},{"noteId":194,"caller":"-","text":"KemoshMoabiternas nationalgud.","reference":{"chapter":48,"verse":7}},{"noteId":195,"caller":"-","text":"vingarGrundtexten svårtolkad. Annan översättning: ”salt” (jfr Dom 9:45). Andra handskrifter: ”en gravsten” (så Septuaginta).","reference":{"chapter":48,"verse":9}}]},"thisChapterLink":"/api/swe_fol/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}