{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Profetia om Ammon"]},{"type":"verse","number":1,"content":["Om ammoniterna",{"noteId":196},".",{"text":"Så säger Herren:","poem":3},{"text":"Har Israel inga barn,","poem":2},{"text":"eller har han ingen arvinge?","poem":3},{"text":"Eller varför har deras kung","poem":2},{"noteId":197},{"text":"tagit Gad","poem":3},{"noteId":198},{"text":"i besittning,","poem":3},{"text":"och varför bor hans folk","poem":2},{"text":"i dess städer?","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Se, därför ska dagar komma,","poem":1},{"text":"säger Herren,","poem":3},{"text":"då jag ska låta ett stridsrop höras","poem":2},{"text":"mot Rabba i ammoniternas land.","poem":3},{"text":"Det ska bli en öde grushög,","poem":2},{"text":"och dess lydstäder","poem":3},{"text":"ska brännas upp i eld.","poem":4},{"text":"Israel ska då ta i besittning","poem":2},{"text":"dem som tog hans arv,","poem":3},{"text":"säger Herren.","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jämra dig, Heshbon,","poem":1},{"text":"för Ai är ödelagt!","poem":3},{"text":"Ropa, ni Rabbas döttrar!","poem":2},{"lineBreak":true},{"text":"Klä er i säcktyg,","poem":2},{"text":"klaga och gå runt i gårdarna,","poem":3},{"text":"för deras kung går bort","poem":2},{"text":"i fångenskap","poem":3},{"text":"och hans präster och furstar","poem":2},{"text":"med honom.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Varför skryter du om dina dalar,","poem":1},{"text":"att din dal flödar över,","poem":2},{"text":"du trolösa dotter?","poem":3},{"text":"Du litar på dina skatter och säger:","poem":2},{"text":"”Vem kan komma åt mig?”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Se, jag ska låta fruktan drabba dig,","poem":1},{"text":"säger Herren Gud Sebaot,","poem":3},{"text":"från alla som bor runt omkring dig.","poem":2},{"text":"Och ni ska drivas bort,","poem":3},{"text":"var och en åt sitt håll,","poem":4},{"text":"och ingen ska samla dem som flyr.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Men därefter ska jag göra slut","poem":1},{"text":"på Ammons fångenskap,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"heading","content":["Profetia om Edom"]},{"type":"verse","number":7,"content":["Om Edom.",{"noteId":199},{"text":"Så säger Herren Sebaot:","poem":2},{"lineBreak":true},{"text":"Finns det ingen vishet mer","poem":2},{"text":"i Teman?","poem":3},{"text":"Har de förståndiga inget råd att ge?","poem":2},{"text":"Är deras vishet borta?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Fly, vänd om,","poem":1},{"text":"göm er djupt nere i dalarna,","poem":2},{"text":"ni Dedans invånare,","poem":3},{"text":"för jag ska låta olycka drabba Esau","poem":2},{"text":"när jag straffar honom.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Om vinbärgare kommer till dig","poem":1},{"text":"lämnar de ingen efterskörd kvar,","poem":3},{"text":"om tjuvar kommer om natten","poem":2},{"text":"fördärvar de så mycket de kan.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"För det är jag som har klätt av Esau,","poem":1},{"text":"jag har avslöjat hans gömställen","poem":2},{"text":"så att han inte kan hålla sig dold.","poem":3},{"text":"Ödeläggelse har drabbat hans barn,","poem":2},{"text":"hans bröder och grannar.","poem":3},{"text":"Han finns inte mer.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lämna dina faderlösa,","poem":1},{"text":"jag ska hålla dem vid liv.","poem":3},{"text":"Dina änkor kan lita på mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":["För så säger Herren: Se, de som inte blev dömda att dricka ur bägaren tvingas att dricka. Skulle då du bli ostraffad? Nej, du ska inte bli ostraffad utan tvingas att dricka."]},{"type":"verse","number":13,"content":["För jag har svurit vid mig själv, säger Herren, att Bosra ska bli till häpnad och vanära. Det ska ödeläggas och bli en förbannelse, och alla dess lydstäder ska bli ödemarker för all framtid."]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jag har hört ett budskap","poem":1},{"text":"från Herren,","poem":3},{"text":"en budbärare har sänts ut","poem":2},{"text":"bland hednafolken:","poem":3},{"text":"”Kom samman och dra ut mot det","poem":2},{"text":"och res er till strid.”","poem":3}]},{"type":"verse","number":15,"content":[{"text":"För se, jag ska göra dig","poem":1},{"text":"liten bland hednafolken,","poem":3},{"text":"föraktad bland människorna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Skräcken du spred","poem":1},{"text":"och ditt hjärtas högmod","poem":2},{"text":"har bedragit dig,","poem":3},{"text":"du som bor bland bergsklyftorna","poem":2},{"text":"och har ditt tillhåll uppe","poem":3},{"text":"på höjden.","poem":4},{"text":"Även om du byggde ditt bo","poem":2},{"text":"så högt som örnen","poem":3},{"text":"skulle jag ändå störta dig","poem":2},{"text":"ner därifrån, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Edom ska bli till häpnad. Var och en som går där förbi ska häpna och vissla vid tanken på alla dess plågor."]},{"type":"verse","number":18,"content":["Som när Sodom och Gomorra ödelades med sina grannstäder, säger Herren, så ska ingen bo där mer och ingen människa vistas där."]},{"type":"verse","number":19,"content":["Se, som ett lejon ska han dra upp från Jordanbygdens täta snår till frodiga betesmarker. På ett ögonblick ska jag jaga bort dem därifrån. Och den som är utvald ska jag sätta över dem. För vem är min like och vem kan ställa mig till svars? Eller vem är den herde som kan stå emot mig?"]},{"type":"verse","number":20,"content":["Hör därför vad Herren har beslutat om Edom och tankarna som han tänkt om dem som bor i Teman:",{"lineBreak":true},{"text":"Även de minsta i hjorden","poem":1},{"text":"ska släpas bort,","poem":3},{"text":"och deras betesmark","poem":2},{"text":"ska häpna över dem.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Vid dånet av deras fall bävar jorden.","poem":1},{"text":"Man skriar så att ljudet hörs","poem":2},{"text":"ända till Röda havet.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Se, han lyfter som en örn,","poem":1},{"text":"han svävar fram och breder ut","poem":2},{"text":"sina vingar över Bosra.","poem":3},{"text":"Hjärtat hos Edoms hjältar","poem":2},{"text":"blir på den dagen","poem":3},{"text":"som hjärtat hos en kvinna","poem":2},{"text":"i barnsnöd.","poem":3}]},{"type":"heading","content":["Profetia om Damaskus"]},{"type":"verse","number":23,"content":[{"text":"Om Damaskus.","poem":1},{"text":"Hamat och Arpad kommer","poem":2},{"text":"på skam,","poem":4},{"text":"för de har hört ett ont budskap.","poem":3},{"text":"De fylls av ångest,","poem":2},{"text":"som ett upprört hav","poem":3},{"text":"som inte kan bli stilla.","poem":4}]},{"type":"verse","number":24,"content":[{"text":"Damaskus har tappat modet","poem":1},{"text":"och vänt för att fly,","poem":3},{"text":"skräcken har fått grepp,","poem":2},{"text":"de grips av ångest och vånda","poem":3},{"text":"som en barnaföderska.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"Hur övergiven är inte","poem":1},{"text":"den berömda staden,","poem":2},{"text":"min glädjes stad?","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Därför måste de unga männen","poem":1},{"text":"falla på gatorna,","poem":3},{"text":"och alla krigsmän förgöras","poem":2},{"text":"på den dagen,","poem":3},{"text":"säger Herren Sebaot.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Jag ska tända eld","poem":1},{"text":"på Damaskus murar,","poem":3},{"text":"och den ska förtära","poem":2},{"text":"Ben-Hadads palats.","poem":3}]},{"type":"heading","content":["Profetia om Kedar och Hasor"]},{"type":"verse","number":28,"content":["Om Kedar och Hasors riken",{"noteId":200},"som besegrades av Nebukadressar, Babels kung.",{"lineBreak":true},{"text":"Så säger Herren:","poem":1},{"text":"Res dig, dra upp mot Kedar","poem":2},{"text":"och härja Österlandets söner.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Deras hyddor och hjordar","poem":1},{"text":"ska rövas bort,","poem":3},{"text":"deras tält och allt deras bohag,","poem":2},{"text":"deras kameler ska föras bort","poem":3},{"text":"från dem,","poem":4},{"text":"och man ska ropa över dem:","poem":2},{"text":"Skräck från alla håll!","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Fly, vandra långt bort,","poem":1},{"text":"göm er djupt ner,","poem":2},{"text":"ni Hasors invånare, säger Herren,","poem":3},{"text":"för Babels kung Nebukadressar","poem":2},{"text":"har fattat beslut om er","poem":3},{"text":"och tänkt ut en plan mot er.","poem":4}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Bryt upp, säger Herren, och dra ut","poem":1},{"text":"mot ett obekymrat folk","poem":2},{"text":"som bor i trygghet,","poem":3},{"text":"utan portar eller bommar.","poem":2},{"text":"De bor för sig själva.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Deras kameler ska bli ert byte,","poem":1},{"text":"och deras stora boskapshjordar","poem":2},{"text":"ska bli ert rov.","poem":3},{"text":"Jag ska skingra dem","poem":2},{"text":"åt alla väderstreck,","poem":4},{"text":"männen med kantklippt hår.","poem":3},{"text":"Från alla håll","poem":2},{"text":"ska jag låta ofärd drabba dem,","poem":3},{"text":"säger Herren.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"Hasor ska bli en boning","poem":1},{"text":"för schakaler,","poem":2},{"text":"en ödemark för alltid.","poem":3},{"text":"Ingen ska bo där mer","poem":2},{"text":"och ingen människa vistas där.","poem":3}]},{"type":"heading","content":["Profetia om Elam"]},{"type":"verse","number":34,"content":["Detta är Herrens ord som kom till profeten Jeremia om Elam",{"noteId":201},"i början av Juda kung Sidkias regering. Han sade:"]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Se, jag ska bryta Elams båge,","poem":2},{"text":"deras främsta makt.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Jag ska låta fyra vindar","poem":1},{"text":"komma mot Elam","poem":2},{"text":"från himlens fyra hörn.","poem":3},{"text":"Jag ska skingra dem","poem":2},{"text":"åt alla väderstreck,","poem":3},{"text":"och det ska inte finnas något folk","poem":2},{"text":"dit de fördrivna från Elam","poem":3},{"text":"inte ska komma.","poem":4}]},{"type":"verse","number":37,"content":[{"text":"Jag ska göra elamiterna","poem":1},{"text":"förfärade för sina fiender","poem":2},{"text":"och för dem som vill ta deras liv.","poem":3},{"text":"Jag ska låta olycka drabba dem,","poem":2},{"text":"min brinnande vrede,","poem":3},{"text":"säger Herren.","poem":4},{"text":"Jag ska sända svärdet efter dem","poem":2},{"text":"tills jag har gjort slut på dem.","poem":3}]},{"type":"verse","number":38,"content":[{"text":"Jag ska sätta upp min tron i Elam","poem":1},{"text":"och utrota både kung","poem":2},{"text":"och furstar där, säger Herren.","poem":3}]},{"type":"verse","number":39,"content":[{"text":"Men i kommande dagar","poem":1},{"text":"ska jag göra slut på","poem":2},{"text":"Elams fångenskap,","poem":3},{"text":"säger Herren.","poem":2}]}],"footnotes":[{"noteId":196,"caller":"-","text":"ammoniternaFolk runt nutida Amman i Jordanien (Bibelns Rabba). Deltog liksom moabiterna i upproret mot Nebukadnessar (23:7) och härjades 582 f Kr (jfr Hes 25:2f).","reference":{"chapter":49,"verse":1}},{"noteId":197,"caller":"-","text":"deras kungAnnan översättning: ”Milkom”, ammoniternas huvudgud (2 Kung 23:13) som också kallades Molok (3 Mos 20:2f). Jfr 2 Sam 12:30. Gäller även vers 3.","reference":{"chapter":49,"verse":1}},{"noteId":198,"caller":"-","text":"tagit GadOmrådet öster om Jordan som hade getts åt Gads stam (se Jos 13:24).","reference":{"chapter":49,"verse":1}},{"noteId":199,"caller":"-","text":"EdomHärjades år 552 f Kr av Babels kung Nabonidus (se not till Dan 5:1). Jfr Hes 49:12.","reference":{"chapter":49,"verse":7}},{"noteId":200,"caller":"-","text":"Kedar och Hasors rikenNordarabiska stammar som härjades av Nebukadnessar 599-598 f Kr.","reference":{"chapter":49,"verse":28}},{"noteId":201,"caller":"-","text":"ElamFolk i västra nuvarande Iran som kämpade vid babyloniernas sida under 600-talet f Kr.","reference":{"chapter":49,"verse":34}}]},"thisChapterLink":"/api/swe_fol/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}