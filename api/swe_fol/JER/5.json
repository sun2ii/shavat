{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Dom över otrohet och orättfärdighet"]},{"type":"verse","number":1,"content":["Gå runt på gatorna i Jerusalem",{"text":"och lägg märke till vad ni ser,","poem":2},{"lineBreak":true},{"text":"sök på torgen om ni finner någon,","poem":2},{"text":"om det finns någon enda","poem":3},{"text":"som gör rätt och frågar","poem":2},{"text":"efter trohet.","poem":3},{"text":"Då ska jag förlåta staden.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Men även om de säger:","poem":1},{"text":"”Så sant Herren lever”,","poem":3},{"text":"så svär de ändå falskt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Herre, är det inte trohet","poem":1},{"text":"dina ögon söker?","poem":3},{"text":"Du slog dem,","poem":2},{"text":"men de kände ingen smärta.","poem":3},{"text":"Du gjorde slut på dem,","poem":2},{"text":"men de vägrade","poem":3},{"text":"att ta emot tillrättavisning.","poem":4},{"text":"De gjorde sina pannor","poem":2},{"text":"hårdare än klippan","poem":3},{"text":"och vägrade omvända sig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Då tänkte jag:","poem":1},{"text":"Det är bara enkelt folk,","poem":2},{"text":"de är dåraktiga,","poem":3},{"text":"för de känner inte Herrens väg,","poem":2},{"text":"sin Guds domslut.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Nu går jag till de stora","poem":1},{"text":"och talar med dem.","poem":3},{"text":"De måste ju känna Herrens väg","poem":2},{"text":"och sin Guds domslut.","poem":3},{"text":"Men också de har brutit sönder oket","poem":2},{"text":"och slitit av banden.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Därför ska lejonet från skogen","poem":1},{"text":"slå dem","poem":3},{"text":"och stäppvargen","poem":2},{"text":"slita sönder dem.","poem":3},{"text":"Leoparden ska lura","poem":2},{"text":"vid deras städer","poem":3},{"text":"och alla som går ut","poem":2},{"text":"ska rivas ihjäl,","poem":3},{"text":"för deras brott är många","poem":2},{"text":"och deras avfall svåra","poem":3},{"noteId":29},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Varför skulle jag förlåta dig?","poem":1},{"text":"Dina barn har övergett mig","poem":2},{"text":"och svurit vid gudar","poem":3},{"text":"som inte finns.","poem":4},{"text":"Jag gav dem fullt upp av allt,","poem":2},{"text":"men de var otrogna","poem":3},{"text":"och samlades i skaror","poem":2},{"text":"vid horhusen.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De liknar välnärda,","poem":1},{"text":"brunstiga hingstar,","poem":3},{"text":"var och en gnäggar","poem":2},{"text":"efter sin nästas hustru.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Skulle jag inte straffa dem för sådant?","poem":1},{"text":"säger Herren.","poem":3},{"text":"Skulle jag inte hämnas","poem":2},{"text":"på ett folk som detta?","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dra upp mot hennes","poem":1},{"text":"vingårdsterrasser","poem":2},{"text":"och förstör dem,","poem":3},{"text":"men gör inte slut på henne helt.","poem":2},{"text":"Riv bort hennes rankor,","poem":3},{"text":"de tillhör inte Herren,","poem":4}]},{"type":"verse","number":11,"content":[{"text":"för de har svikit mig svårt,","poem":1},{"text":"både Israels hus och Juda hus,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"De har förnekat Herren och sagt:","poem":1},{"text":"”Han finns inte där.","poem":3},{"text":"Inget ont ska drabba oss,","poem":2},{"text":"svärd och svält ska vi inte möta.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Profeterna blir till vind,","poem":1},{"text":"Guds ord är inte i dem.","poem":3},{"text":"Vad de säger ska drabba","poem":2},{"text":"dem själva.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Därför säger Herren Gud Sebaot så:","poem":1},{"text":"Eftersom ni talar på det sättet,","poem":3},{"text":"se, därför ska jag göra","poem":2},{"text":"mina ord i din mun till en eld","poem":3},{"text":"och detta folk till ved,","poem":2},{"text":"och elden ska förtära dem.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Se, jag ska sända ett hednafolk","poem":1},{"text":"mot er fjärran ifrån,","poem":3},{"text":"ni av Israels hus, säger Herren,","poem":2},{"lineBreak":true},{"text":"ett starkt hednafolk,","poem":2},{"text":"ett urgammalt folk,","poem":3},{"text":"ett folk vars språk du inte känner","poem":2},{"text":"och vars tal du inte förstår.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Deras koger är som en öppen grav,","poem":1},{"text":"de är alla krigare.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"De ska sluka din skörd","poem":1},{"text":"och ditt bröd,","poem":3},{"text":"de ska sluka dina söner och döttrar,","poem":2},{"text":"de ska sluka dina får och kor,","poem":3},{"text":"de ska sluka dina vinstockar","poem":2},{"text":"och fikonträd.","poem":3},{"text":"Dina befästa städer som du litar på,","poem":2},{"text":"ska de förstöra med svärd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Men inte ens då vill jag göra slut på er helt, säger Herren."]},{"type":"verse","number":19,"content":["Om ni då frågar: ”Varför har Herren vår Gud gjort oss allt detta?” ska du svara dem: ”Liksom ni har övergett mig och tjänat främmande gudar i ert eget land, ska ni nu få tjäna främlingar i ett land som inte är ert.”"]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kungör det för Jakobs hus,","poem":1},{"text":"ropa ut det i Juda och säg:","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Hör detta,","poem":1},{"text":"du dåraktiga folk utan förstånd!","poem":3},{"text":"Ni har ögon och ser inte,","poem":2},{"text":"ni har öron och hör inte.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Skulle ni inte frukta mig,","poem":1},{"text":"säger Herren,","poem":3},{"text":"skulle ni inte bäva för mig,","poem":2},{"text":"jag som har satt sand","poem":3},{"text":"till gräns för havet,","poem":4},{"text":"till en evig gräns","poem":3},{"text":"som det inte kan överskrida.","poem":4},{"text":"Hur dess vågor än svallar","poem":2},{"text":"förmår de inget,","poem":3},{"text":"och hur de än brusar","poem":2},{"text":"kan de inte komma över den.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Men detta folk har ett motsträvigt","poem":1},{"text":"och upproriskt hjärta.","poem":3},{"text":"De har vänt sig bort","poem":2},{"text":"och gått sin egen väg.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"De säger inte i sina hjärtan:","poem":1},{"text":"”Låt oss frukta Herren vår Gud,","poem":2},{"text":"som ger regn i rätt tid","poem":3},{"text":"både höst och vår","poem":4},{"text":"och som skänker oss","poem":2},{"text":"de bestämda skördeveckorna.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Era missgärningar","poem":1},{"text":"har nu bringat detta i olag,","poem":3},{"text":"era synder håller det goda","poem":2},{"text":"borta från er,","poem":3}]},{"type":"verse","number":26,"content":[{"text":"för bland mitt folk","poem":1},{"text":"finns ogudaktiga människor.","poem":3},{"text":"De ligger i bakhåll","poem":2},{"text":"liksom jägaren ligger på lur,","poem":3},{"text":"de sätter snaror","poem":2},{"text":"och fångar människor.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Som en bur full av fåglar","poem":1},{"text":"är deras hus fulla av svek.","poem":3},{"text":"Därför har de blivit stora och rika,","poem":2},{"text":"de har blivit feta och skinande.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Deras onda gärningar","poem":1},{"text":"har ingen gräns,","poem":2},{"text":"de dömer inte rättvist,","poem":3},{"text":"de verkar inte","poem":2},{"text":"för den faderlöses sak","poem":3},{"text":"och hjälper inte den fattige","poem":2},{"text":"att få sin rätt.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Skulle jag inte straffa dem för sådant?","poem":1},{"text":"säger Herren.","poem":3},{"text":"Skulle jag inte hämnas","poem":2},{"text":"på ett hednafolk som detta?","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Förfärliga och fruktansvärda saker","poem":1},{"text":"sker i landet.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Profeterna profeterar lögn,","poem":1},{"text":"och prästerna styr efter deras råd.","poem":2},{"text":"Så vill mitt folk ha det.","poem":3},{"text":"Men vad ska ni göra","poem":2},{"text":"när slutet på det kommer?","poem":3}]}],"footnotes":[{"noteId":29,"caller":"-","text":"svåraAnnan översättning: ”talrika”.","reference":{"chapter":5,"verse":6}}]},"thisChapterLink":"/api/swe_fol/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}