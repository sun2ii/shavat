{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Profetia om Babel"]},{"type":"verse","number":1,"content":["Detta ord talade Herren om Babel, om kaldeernas land, genom profeten Jeremia:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Förkunna bland hednafolken,","poem":1},{"text":"ropa ut det, res ett baner,","poem":2},{"text":"ropa ut och dölj det inte.","poem":3},{"text":"Säg: Babel är intaget","poem":2},{"noteId":202},{"text":",","poem":2},{"text":"Bel","poem":3},{"noteId":203},{"text":"har kommit på skam,","poem":3},{"text":"Merodak är krossad.","poem":4},{"text":"Dess gudabilder har kommit","poem":2},{"text":"på skam,","poem":3},{"text":"dess avgudar är krossade.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"För ett folk drar upp","poem":1},{"text":"mot det norrifrån.","poem":3},{"text":"De ska göra dess land","poem":2},{"text":"till en ödemark","poem":3},{"text":"så att ingen kan bo i det.","poem":4},{"text":"Både människor och djur ska fly.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I de dagarna och på den tiden,","poem":1},{"text":"säger Herren,","poem":3},{"text":"ska Israels barn komma","poem":2},{"text":"tillsammans med Juda barn.","poem":3},{"text":"De ska gå under gråt","poem":2},{"text":"och söka Herren sin Gud.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"De ska fråga efter Sion","poem":1},{"text":"och vända sig hitåt:","poem":3},{"text":"”Kom! Låt oss hålla fast vid Herren","poem":2},{"text":"i ett evigt förbund","poem":3},{"text":"som aldrig ska glömmas.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mitt folk var förlorade får.","poem":1},{"text":"Deras herdar vilseledde dem","poem":2},{"text":"och lät dem irra omkring","poem":3},{"text":"på bergen.","poem":4},{"text":"De strövade från berg till höjd","poem":2},{"text":"och glömde sin viloplats.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Alla som träffade på dem","poem":1},{"text":"slukade dem,","poem":3},{"text":"och deras motståndare sade:","poem":2},{"text":"”Vi är utan skuld.”","poem":3},{"text":"Det hände för att de hade syndat","poem":2},{"text":"mot Herren,","poem":4},{"text":"rättfärdighetens boning,","poem":3},{"text":"mot Herren, deras fäders hopp.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fly ut ur Babel,","poem":1},{"text":"dra bort från kaldeernas land","poem":3},{"text":"och var som bockar","poem":2},{"text":"framför hjorden.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"För se, jag ska väcka","poem":1},{"text":"från nordlandet","poem":3},{"text":"en mängd stora hednafolk","poem":2},{"text":"och föra dem upp mot Babel.","poem":3},{"text":"De ska rusta sig till strid mot det,","poem":2},{"text":"från det hållet ska det erövras.","poem":3},{"text":"Deras pilar ska vara","poem":2},{"text":"som en skicklig hjältes,","poem":3},{"text":"ingen vänder tomhänt tillbaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kaldeen ska plundras,","poem":1},{"text":"plundrarna ska alla få nog,","poem":2},{"text":"säger Herren,","poem":3}]},{"type":"verse","number":11,"content":[{"text":"för ni gladde er och jublade","poem":1},{"text":"när ni skövlade min arvedel.","poem":3},{"text":"Ni hoppade som kvigor","poem":2},{"text":"på tröskplatsen","poem":3},{"text":"och frustade som hingstar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Er mor ska ändå stå med djup skam,","poem":1},{"text":"hon som har fött er","poem":2},{"text":"ska få skämmas.","poem":3},{"text":"Se, sist av hednafolken","poem":2},{"text":"ska hon bli en ödemark,","poem":3},{"text":"ett torrt land och en öken!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"På grund av Herrens vrede","poem":1},{"text":"ska det ligga obebott","poem":2},{"text":"och helt öde.","poem":3},{"text":"Var och en som går förbi Babel","poem":2},{"text":"ska häpna och vissla","poem":3},{"text":"vid tanken på alla dess plågor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Rusta er till strid mot Babel","poem":1},{"text":"från alla sidor,","poem":2},{"text":"ni som spänner båge.","poem":3},{"text":"Skjut på henne,","poem":2},{"text":"spar inte på pilarna,","poem":3},{"text":"för hon har syndat mot Herren.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Höj segerrop över henne","poem":1},{"text":"från alla håll:","poem":3},{"text":"”Hon har tvingats ge upp.","poem":2},{"text":"Hennes stöd har fallit,","poem":3},{"text":"hennes murar är nerrivna!”","poem":4},{"text":"Detta är Herrens hämnd.","poem":2},{"text":"Hämnas då på henne.","poem":3},{"text":"Gör mot henne som hon har gjort.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Utrota ur Babel den som sår","poem":1},{"text":"och den som håller skäran","poem":2},{"text":"i skördens tid.","poem":3},{"text":"Undan det härjande svärdet","poem":2},{"text":"ska var och en vända om","poem":3},{"text":"till sitt folk","poem":4},{"text":"och var och en fly hem till sitt land.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":["Israel är ett vilsekommet får",{"text":"som jagats av lejon.","poem":2},{"lineBreak":true},"Först slukade Assyriens kung det, och till slut har Babels kung Nebukadressar gnagt dess ben."]},{"type":"verse","number":18,"content":["Därför säger Herren Sebaot, Israels Gud, så: Se, jag ska straffa Babels kung och hans land liksom jag har straffat Assyriens kung."]},{"type":"verse","number":19,"content":["Jag ska föra Israel tillbaka till hans betesmarker, och han ska få gå i bet på Karmel och i Bashan. På Efraims berg och i Gilead ska han få äta sig mätt."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"I de dagarna och på den tiden,","poem":1},{"text":"säger Herren,","poem":3},{"text":"ska man söka efter Israels skuld,","poem":2},{"text":"men den är borta,","poem":3},{"text":"efter Juda synder,","poem":2},{"text":"men de finns inte mer.","poem":3},{"text":"För jag ska förlåta dem","poem":2},{"text":"som jag låter leva kvar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Dra ut mot Meratajims",{"noteId":204},"land",{"text":"och mot invånarna i Pekod","poem":3},{"noteId":205},{"text":".","poem":3},{"text":"Förgör dem och vig dem","poem":2},{"text":"åt förintelse, säger Herren,","poem":3},{"text":"och gör i allt","poem":2},{"text":"som jag har befallt dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Det är stridslarm","poem":1},{"text":"och stor förödelse i landet.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hur sönderbruten","poem":1},{"text":"och krossad är den inte,","poem":3},{"text":"den hammare som slog","poem":2},{"text":"hela jorden!","poem":3},{"text":"Hur har inte Babel kommit","poem":2},{"text":"hednafolken att häpna!","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Jag lade ut en snara","poem":1},{"text":"för dig, Babel,","poem":3},{"text":"och du blev fångad","poem":2},{"text":"innan du visste om det.","poem":3},{"text":"Du ertappades och greps,","poem":2},{"text":"för det var mot Herren","poem":3},{"text":"du hade gett dig i strid.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Herren öppnade sitt vapenförråd","poem":1},{"text":"och tog fram sin vredes vapen,","poem":3},{"text":"för Herren Gud Sebaot hade","poem":2},{"text":"ett verk att utföra","poem":3},{"text":"i kaldeernas land.","poem":4}]},{"type":"verse","number":26,"content":[{"text":"Ryck fram mot det från alla håll,","poem":1},{"text":"öppna dess förrådshus,","poem":3},{"text":"kasta i en hög vad där finns,","poem":2},{"text":"som man gör med säd,","poem":4},{"text":"och vig det åt förintelse.","poem":3},{"text":"Låt ingenting bli kvar av det.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Döda alla dess tjurar,","poem":1},{"text":"för ner dem till slakt.","poem":3},{"text":"Ve dem, för deras dag har kommit,","poem":1},{"text":"tiden för deras straff!","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Lyssna till flyktingarna","poem":1},{"text":"som söker rädda sig","poem":2},{"text":"ut ur Babels land,","poem":3},{"text":"för att i Sion förkunna Herren","poem":2},{"text":"vår Guds hämnd,","poem":3},{"text":"hämnden för hans tempel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kalla samman bågskyttar","poem":1},{"text":"mot Babel,","poem":2},{"text":"alla som kan spänna en båge.","poem":3},{"text":"Slå läger runt omkring det,","poem":2},{"text":"låt ingen komma undan.","poem":3},{"text":"Vedergäll det för dess gärningar,","poem":2},{"text":"gör mot det precis som det själv","poem":3},{"text":"har gjort,","poem":4},{"text":"för det har handlat övermodigt","poem":2},{"text":"mot Herren,","poem":3},{"text":"mot Israels Helige.","poem":4}]},{"type":"verse","number":30,"content":[{"text":"Därför ska dess unga män falla","poem":1},{"text":"på gatorna,","poem":3},{"text":"alla dess stridsmän ska gå","poem":2},{"text":"under på den dagen,","poem":3},{"text":"säger Herren.","poem":2}]},{"type":"verse","number":31,"content":["Se, jag är emot dig, du övermodige,",{"text":"säger Herren Gud Sebaot,","poem":3},{"text":"för din dag har kommit,","poem":2},{"text":"den tid då jag ska straffa dig.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Då ska den övermodige","poem":1},{"text":"stappla och falla,","poem":2},{"text":"och ingen ska resa upp honom.","poem":3},{"text":"Jag ska tända eld på hans städer","poem":2},{"text":"och elden ska förtära allt","poem":3},{"text":"omkring honom.","poem":4}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Förtryckta är Israels barn","poem":2},{"text":"och Juda barn med dem.","poem":3},{"text":"Alla som har fört dem i fångenskap","poem":2},{"text":"håller fast dem","poem":3},{"text":"och vägrar att släppa dem.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Men deras återlösare är stark,","poem":1},{"text":"Herren Sebaot är hans namn.","poem":3},{"text":"Han tar sig an deras sak,","poem":2},{"text":"och skaffar ro åt jorden","poem":3},{"text":"men oro åt Babels invånare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Svärd mot kaldeerna, säger Herren,","poem":1},{"text":"mot Babels invånare,","poem":2},{"text":"mot dess furstar och vise män!","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Svärd mot lögnprofeterna,","poem":1},{"text":"de ska stå där som dårar.","poem":3},{"text":"Svärd mot dess hjältar,","poem":2},{"text":"de ska bli förfärade.","poem":3}]},{"type":"verse","number":37,"content":[{"text":"Svärd mot dess hästar och vagnar,","poem":1},{"text":"mot alla främmande folk därinne,","poem":2},{"text":"de ska bli som kvinnor.","poem":3},{"text":"Svärd mot dess skatter,","poem":2},{"text":"så att de rövas bort.","poem":3}]},{"type":"verse","number":38,"content":[{"text":"Torka ska drabba dess vatten,","poem":1},{"text":"de ska torka ut,","poem":3},{"text":"för det är ett gudabildernas land,","poem":2},{"text":"med sina skrämmande avgudar","poem":3},{"text":"uppför de sig som galna.","poem":4}]},{"type":"verse","number":39,"content":[{"text":"Därför ska schakaler bo där","poem":1},{"text":"tillsammans med andra ökendjur.","poem":2},{"text":"Strutsar ska där ha sin boning.","poem":3},{"text":"Aldrig mer","poem":2},{"text":"ska någon människa bo där,","poem":3},{"text":"från släkte till släkte","poem":2},{"text":"ska det vara obebott.","poem":3}]},{"type":"verse","number":40,"content":[{"text":"Liksom när Sodom och Gomorra","poem":1},{"text":"med sina grannstäder","poem":3},{"text":"ödelades av Gud,","poem":2},{"text":"säger Herren,","poem":3},{"text":"så ska ingen bo där,","poem":2},{"text":"ingen människa mer vistas där.","poem":3}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Se, ett folk kommer norrifrån,","poem":1},{"text":"ett stort hednafolk,","poem":3},{"text":"många kungar reser sig","poem":2},{"text":"från jordens yttersta ände.","poem":3}]},{"type":"verse","number":42,"content":[{"text":"De bär båge och lans","poem":1},{"noteId":206},{"text":",","poem":1},{"text":"de är grymma och skoningslösa.","poem":3},{"text":"Larmet från dem","poem":2},{"text":"är som havets dån,","poem":3},{"text":"på hästar rider de fram,","poem":2},{"text":"rustade som kämpar till strid","poem":3},{"text":"mot dig, du dotter Babel.","poem":4}]},{"type":"verse","number":43,"content":[{"text":"När Babels kung","poem":1},{"noteId":207},{"text":"hör ryktet om dem","poem":1},{"text":"sjunker hans händer ner.","poem":3},{"text":"Ängslan griper honom,","poem":2},{"text":"ångest som","poem":3},{"text":"hos en barnaföderska.","poem":4}]},{"type":"line_break"},{"type":"verse","number":44,"content":["Se, som ett lejon ska han dra upp från Jordanbygdens täta snår till frodiga betesmarker. Ja, på ett ögonblick ska jag jaga bort dem därifrån. Och den som är utvald ska jag sätta över dem. För vem är min like och vem kan ställa mig till svars? Eller vem är den herde som kan stå emot mig?"]},{"type":"verse","number":45,"content":["Hör därför vad Herren har beslutat om Babel och tankarna som han tänkt om kaldeernas land.",{"lineBreak":true},{"text":"Även de minsta i hjorden","poem":1},{"text":"ska släpas bort,","poem":3},{"text":"och deras betesmark","poem":2},{"text":"ska häpna över dem.","poem":3}]},{"type":"verse","number":46,"content":[{"text":"Vid ropet: ”Babel är intaget!”","poem":1},{"text":"ska jorden bäva","poem":3},{"text":"och ett skriande höras","poem":2},{"text":"bland folken.","poem":3}]}],"footnotes":[{"noteId":202,"caller":"-","text":"Babel är intagetBabel föll 539 f Kr för Koresh (Dan 5:31, 6:28). Därefter minskade Babel gradvis i betydelse och låg helt öde först efter nytestamentlig tid. Jfr Jes 47, Upp 17-18.","reference":{"chapter":50,"verse":2}},{"noteId":203,"caller":"-","text":"BelTitel för Mesopotamiens högsta gud (jfr ”Baal”), under Babels tid Marduk (Merodak).","reference":{"chapter":50,"verse":2}},{"noteId":204,"caller":"-","text":"MeratajimHebr. för ”dubbel envishet”. På akkadiska Marratum, saltträsk i sydöstra Irak.","reference":{"chapter":50,"verse":21}},{"noteId":205,"caller":"-","text":"PekodHebr. för ”straffa”. På akkadiska Pukudu, stamgrupp i östra Irak.","reference":{"chapter":50,"verse":21}},{"noteId":206,"caller":"-","text":"lansAnnan översättning: ”kroksabel”.","reference":{"chapter":50,"verse":42}},{"noteId":207,"caller":"-","text":"Babels kungNabonidus (556-539 f Kr). Se Dan 5:1f med not.","reference":{"chapter":50,"verse":43}}]},"thisChapterLink":"/api/swe_fol/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}