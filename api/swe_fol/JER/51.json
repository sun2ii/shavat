{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Så säger Herren:",{"text":"Se, jag ska uppväcka","poem":1},{"text":"en ödeläggande ande mot Babel","poem":3},{"text":"och mot Leb-Kamajs","poem":4},{"noteId":208},{"text":"invånare.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Jag ska sända skördemän","poem":1},{"text":"mot Babel,","poem":3},{"text":"och de ska rensa bort dess invånare","poem":2},{"text":"och ödelägga landet.","poem":3},{"text":"Från alla sidor ska de komma","poem":2},{"text":"emot det på olyckans dag.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Skyttar ska spänna sina bågar","poem":1},{"text":"mot dem som där spänner båge","poem":3},{"text":"och mot dem som där bröstar sig","poem":2},{"text":"i sitt pansar.","poem":3},{"text":"Skona inte de unga männen,","poem":2},{"text":"vig hela dess här åt förintelse!","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Slagna män ska då falla","poem":1},{"text":"i kaldeernas land","poem":3},{"text":"och genomborrade män","poem":2},{"text":"på deras gator,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"för Israel och Juda är inte änkor","poem":1},{"text":"övergivna av sin Gud,","poem":2},{"text":"av Herren Sebaot,","poem":3},{"text":"fastän deras land är fullt","poem":2},{"text":"av skuld mot Israels Helige.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Fly ut ur Babel!","poem":1},{"text":"Var och en ska rädda sitt liv","poem":2},{"text":"så att ni inte går under","poem":3},{"text":"genom dess missgärning,","poem":4},{"text":"för detta är en hämndens tid","poem":2},{"text":"för Herren","poem":3},{"text":"då han vedergäller Babel","poem":2},{"text":"vad det har gjort.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"En gyllene bägare var Babel","poem":1},{"text":"i Herrens hand,","poem":2},{"text":"den gjorde hela jorden drucken.","poem":3},{"text":"Av dess vin drack hednafolken,","poem":2},{"text":"därför blev de från vettet.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Men plötsligt har nu Babel fallit","poem":1},{"text":"och krossats.","poem":2},{"text":"Jämra er över det!","poem":3},{"text":"Hämta balsam för dess plåga,","poem":2},{"text":"kanske kan den botas.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"”Vi har försökt att bota Babel,","poem":1},{"text":"men det har inte kunnat botas.","poem":3},{"text":"Låt oss lämna det","poem":2},{"text":"och gå var och en till sitt land,","poem":3},{"text":"för dess straffdom","poem":2},{"text":"räcker upp till himlen,","poem":3},{"text":"den når ända upp till skyarna.","poem":2}]},{"type":"verse","number":10,"content":["Herren har låtit vår rättfärdighet",{"text":"gå fram.","poem":3},{"text":"Kom, låt oss berätta i Sion","poem":2},{"text":"om Herren vår Guds verk.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vässa pilarna, fatta sköldarna!","poem":1},{"text":"Herren har väckt","poem":2},{"text":"de mediska kungarnas ande,","poem":3},{"text":"hans avsikt är att lägga Babel","poem":2},{"text":"i ruiner.","poem":3},{"text":"Det är Herrens hämnd,","poem":2},{"text":"hämnden för hans tempel.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Res ett baner mot Babels murar!","poem":1},{"text":"Håll sträng bevakning,","poem":2},{"text":"ställ ut vakter,","poem":3},{"text":"lägg bakhåll!","poem":4},{"text":"För Herren har fattat sitt beslut,","poem":2},{"text":"och han utför vad han har talat","poem":3},{"text":"mot Babels invånare.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Du som bor vid stora vatten","poem":1},{"text":"och är så rik på skatter,","poem":3},{"text":"ditt slut har nu kommit,","poem":2},{"text":"din girighets mått är fyllt.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Herren Sebaot har svurit","poem":1},{"text":"vid sig själv:","poem":3},{"text":"Sannerligen, jag ska fylla dig","poem":2},{"text":"med människor","poem":4},{"text":"så talrika som gräshoppor,","poem":3},{"text":"och de ska höja segerrop mot dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Han har skapat jorden","poem":1},{"text":"genom sin kraft,","poem":3},{"text":"han har grundat världen","poem":2},{"text":"genom sin vishet,","poem":3},{"text":"och genom sitt förstånd har han spänt ut himlen.","poem":2}]},{"type":"verse","number":16,"content":["När han låter sin röst höras,",{"text":"då brusar himlens vatten,","poem":3},{"text":"då låter han regnskyar stiga","poem":2},{"text":"upp från jordens ände.","poem":3},{"text":"Han gör blixtar åt regnet","poem":2},{"text":"och för vinden","poem":3},{"text":"ut ur dess förvaringsrum.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Alla människor står då som dårar,","poem":1},{"text":"utan förstånd.","poem":3},{"text":"Alla guldsmederna kommer","poem":2},{"text":"på skam med sina avgudar,","poem":3},{"text":"för deras gjutna gudabilder","poem":2},{"text":"är bedrägeri,","poem":3},{"text":"ingen ande är i dem.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Tomhet är de,","poem":1},{"text":"ett verk som väcker åtlöje.","poem":3},{"text":"När straffet drabbar dem","poem":2},{"text":"förgås de.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Sådan är inte han","poem":1},{"text":"som är Jakobs del.","poem":3},{"text":"Han är den som har format allt","poem":2},{"text":"och sin arvedels stam","poem":3},{"noteId":209},{"text":".","poem":3},{"text":"Herren Sebaot är hans namn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Min hammare är du,","poem":1},{"text":"mitt stridsvapen.","poem":3},{"text":"Med dig krossar jag hednafolk,","poem":2},{"text":"med dig fördärvar jag riken,","poem":3}]},{"type":"verse","number":21,"content":[{"text":"med dig krossar jag","poem":1},{"text":"häst och ryttare,","poem":3},{"text":"med dig krossar jag","poem":2},{"text":"vagn och kusk,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"med dig krossar jag","poem":1},{"text":"man och kvinna,","poem":3},{"text":"med dig krossar jag","poem":2},{"text":"gammal och ung,","poem":3},{"text":"med dig krossar jag","poem":2},{"text":"yngling och jungfru,","poem":3}]},{"type":"verse","number":23,"content":[{"text":"med dig krossar jag","poem":1},{"text":"herden och hans hjord,","poem":3},{"text":"med dig krossar jag","poem":2},{"text":"bonden och hans oxar,","poem":3},{"text":"med dig krossar jag","poem":2},{"text":"ståthållare och styresmän.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":["Men nu ska jag inför era ögon vedergälla Babel och Kaldeens alla invånare för allt det onda som de har gjort mot Sion, säger Herren."]},{"type":"verse","number":25,"content":["Se, jag vänder mig mot dig, du fördärvets berg, säger Herren, du som fördärvar hela jorden, och jag ska sträcka ut min hand mot dig och störta dig ner från klipporna och göra dig till ett förbränt berg,"]},{"type":"verse","number":26,"content":["så att man inte från dig ska kunna ta vare sig hörnsten eller grundsten. Du ska bli en ödemark för alltid, säger Herren."]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Res ett baner på jorden,","poem":1},{"text":"blås i horn bland hednafolken,","poem":3},{"text":"förbered hednafolk","poem":2},{"text":"till strid mot det,","poem":3},{"text":"båda upp riken mot det,","poem":2},{"text":"Ararat, Minni","poem":3},{"noteId":210},{"text":"och Ashkenas.","poem":3},{"noteId":211},{"text":"Välj ut en härförare mot det,","poem":2},{"text":"dra dit upp med hästar","poem":3},{"text":"som liknar borstiga gräshoppor.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Förbered hednafolk","poem":1},{"text":"till strid mot det:","poem":3},{"text":"Mediens kungar, dess ståthållare","poem":2},{"text":"och alla dess landsfurstar","poem":3},{"text":"och hela det land som lyder","poem":2},{"text":"under deras välde.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Då skälver jorden och bävar,","poem":1},{"text":"för Herrens planer","poem":2},{"text":"mot Babel fullbordas:","poem":3},{"text":"att göra Babels land till","poem":2},{"text":"en ödemark utan invånare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Babels hjältar slutar att strida,","poem":1},{"text":"de sitter stilla i sina fästen.","poem":3},{"text":"Deras styrka har försvunnit,","poem":2},{"text":"de har blivit som kvinnor.","poem":3},{"text":"Man har tänt eld","poem":2},{"text":"på Babels boningar,","poem":3},{"text":"och dess bommar","poem":2},{"text":"är sönderbrutna.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Löpare möter löpare,","poem":1},{"text":"den ene budbäraren korsar","poem":2},{"text":"den andres väg","poem":3},{"text":"för att meddela Babels kung","poem":2},{"text":"att hela hans stad har intagits,","poem":3}]},{"type":"verse","number":32,"content":[{"text":"att vadställena har erövrats,","poem":1},{"text":"att dammarna är uppbrända i eld","poem":2},{"text":"och stridsmännen står","poem":3},{"text":"skräckslagna.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"För så säger Herren Sebaot,","poem":1},{"text":"Israels Gud:","poem":3},{"text":"Dottern Babel är som en tröskplats","poem":2},{"text":"när man just har trampat","poem":3},{"text":"till den.","poem":4},{"text":"Ännu en liten tid,","poem":2},{"text":"och skördetiden är inne.","poem":3}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Han har slukat mig","poem":1},{"text":"och tillintetgjort mig,","poem":2},{"text":"Babels kung Nebukadressar.","poem":3},{"text":"Han har gjort mig till ett tomt kärl,","poem":2},{"text":"som en drake har han svalt mig,","poem":3},{"text":"han har fyllt sin buk","poem":2},{"text":"med mina läckerheter","poem":3},{"text":"och drivit bort mig.","poem":4}]},{"type":"verse","number":35,"content":["”Låt det våld som har drabbat mig",{"text":"och mitt kött","poem":3},{"text":"komma över Babel”,","poem":4},{"text":"säger hon som bor i Sion.","poem":3},{"text":"”Låt mitt blod komma över","poem":2},{"text":"Kaldeens invånare”,","poem":3},{"text":"säger Jerusalem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"Därför säger Herren så:","poem":1},{"text":"Se, jag ska utföra din sak","poem":2},{"text":"och utkräva din hämnd.","poem":3},{"text":"Jag ska låta Babels hav sina bort","poem":2},{"text":"och dess brunn torka ut,","poem":3}]},{"type":"verse","number":37,"content":[{"text":"och Babel ska bli en stenhög,","poem":1},{"text":"ett tillhåll för schakaler,","poem":3},{"text":"till häpnad och förakt.","poem":2},{"text":"Ingen ska bo där.","poem":3}]},{"type":"verse","number":38,"content":[{"text":"Alla ryter de nu som lejon,","poem":1},{"text":"de morrar som lejonungar.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Men när de är som mest upptända","poem":1},{"text":"ska jag ordna ett gästabud","poem":2},{"text":"för dem.","poem":3},{"text":"Jag ska göra dem druckna","poem":2},{"text":"så att de jublar,","poem":3},{"text":"och så ska de somna in","poem":2},{"text":"i en evig sömn","poem":3},{"text":"och aldrig mer vakna, säger Herren.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Jag ska föra dem ner","poem":1},{"text":"till att slaktas som lamm,","poem":2},{"text":"som baggar och bockar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"Hur har inte Sheshak","poem":1},{"noteId":212},{"text":"blivit intaget,","poem":1},{"text":"det som var","poem":2},{"text":"hela jordens berömmelse","poem":3},{"text":"har erövrats!","poem":4},{"text":"Hur har inte Babel fått","poem":2},{"text":"hednafolken att häpna!","poem":3}]},{"type":"verse","number":42,"content":[{"text":"Havet steg upp över Babel,","poem":1},{"text":"de brusande böljorna täckte","poem":2},{"text":"över det.","poem":3}]},{"type":"verse","number":43,"content":["Så förvandlades dess städer",{"text":"till en ödemark,","poem":3},{"text":"ett torrt land och en öken,","poem":2},{"text":"ett land där ingen bor","poem":3},{"text":"och där ingen människa går fram.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Jag ska straffa Bel i Babel","poem":1},{"text":"och dra ut ur hans gap","poem":2},{"text":"vad han har slukat.","poem":3},{"text":"Hednafolken ska inte mer","poem":2},{"text":"strömma till honom,","poem":3},{"text":"också Babels murar ska falla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"Dra ut därifrån, mitt folk.","poem":1},{"text":"Var och en ska rädda sitt liv","poem":2},{"text":"undan Herrens brinnande vrede.","poem":3}]},{"type":"verse","number":46,"content":["Tappa inte modet och frukta inte de rykten",{"text":"som hörs i landet,","poem":3},{"text":"även om ett rykte kommer ena året","poem":2},{"text":"och ett nytt rykte nästa år,","poem":3},"även om våld råder på jorden",{"text":"och härskare står mot härskare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"För se, dagar ska komma","poem":1},{"text":"då jag ska straffa","poem":2},{"text":"Babels avgudar","poem":3},{"text":"och då hela dess land ska stå","poem":2},{"text":"med skam","poem":3},{"text":"och alla bli slagna därinne.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Då ska de jubla över Babel,","poem":1},{"text":"himmel och jord","poem":2},{"text":"och allt som finns där,","poem":3},{"text":"för norrifrån kommer","poem":2},{"text":"härjarna över det,","poem":3},{"text":"säger Herren.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"På grund av dem som har dräpts","poem":1},{"text":"i Israel måste Babel falla,","poem":3},{"text":"så som dräpta över hela jorden","poem":2},{"text":"har fallit för Babels skull.","poem":3}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Ni som räddat er undan svärdet,","poem":1},{"text":"ge er av, stanna inte!","poem":3},{"text":"Kom ihåg Herren i fjärran land","poem":2},{"text":"och låt Jerusalem vara","poem":3},{"text":"i era hjärtan!","poem":4}]},{"type":"verse","number":51,"content":[{"text":"Vi står här med skam,","poem":1},{"text":"vi blir hånade.","poem":3},{"text":"Blygsel täcker vårt ansikte,","poem":2},{"text":"för främlingar har trängt in i","poem":3},{"text":"de heliga platserna i Herrens hus.","poem":2}]},{"type":"verse","number":52,"content":["Se, därför ska dagar komma,",{"text":"säger Herren,","poem":2},{"text":"då jag ska döma Babels avgudar","poem":3},{"text":"och i hela dess land","poem":2},{"text":"ska slagna män jämra sig.","poem":3}]},{"type":"verse","number":53,"content":[{"text":"Även om Babel steg upp till himlen","poem":1},{"text":"och gjorde sin befästning","poem":2},{"text":"hög och ointaglig,","poem":3},{"text":"så skulle ändå plundrare","poem":2},{"text":"från mig nå dit, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"Sorgerop hörs från Babel","poem":1},{"text":"och stor förödelse","poem":2},{"text":"från kaldeernas land,","poem":3}]},{"type":"verse","number":55,"content":[{"text":"för Herren ödelägger Babel","poem":1},{"text":"och gör slut på","poem":2},{"text":"det stora larmet därinne.","poem":3},{"text":"Deras vågor brusar","poem":2},{"text":"som stora vatten,","poem":3},{"text":"dånet av dem ljuder högt,","poem":2}]},{"type":"verse","number":56,"content":["för över Babel kommer en",{"text":"som ödelägger,","poem":3},{"text":"och hjältarna där tas till fånga,","poem":2},{"text":"deras bågar bryts sönder.","poem":3},{"text":"Herren är en vedergällningens Gud,","poem":2},{"text":"han lönar till fullo.","poem":3}]},{"type":"verse","number":57,"content":[{"text":"Jag ska göra dem druckna,","poem":1},{"text":"Babels furstar och visa,","poem":2},{"text":"dess ståthållare, styresmän","poem":3},{"text":"och hjältar.","poem":4},{"text":"De ska somna in i en evig sömn","poem":2},{"text":"och aldrig mer vakna,","poem":3},{"text":"säger Kungen.","poem":2},{"text":"Herren Sebaot är hans namn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Babels breda murar","poem":2},{"text":"ska rivas ner i grund,","poem":3},{"text":"och de höga portarna","poem":2},{"text":"ska brännas upp i eld.","poem":3},{"text":"Så mödar sig folken för intet","poem":2},{"text":"och folkslagen arbetar sig trötta","poem":3},{"text":"för det som blir lågornas rov.","poem":2}]},{"type":"line_break"},{"type":"verse","number":59,"content":["Detta är vad profeten Jeremia befallde Seraja, son till Neria",{"noteId":213},", son till Mahaseja, då denne begav sig till Babel med Juda kung Sidkia i hans fjärde regeringsår",{"noteId":214},". Seraja var nämligen kvartermästare."]},{"type":"verse","number":60,"content":["Jeremia skrev ner i en och samma bok all den olycka som skulle drabba Babel, allt detta som nu är skrivet om Babel."]},{"type":"verse","number":61,"content":["Jeremia sade till Seraja: ”När du kommer till Babel, se då till att du läser upp allt detta."]},{"type":"verse","number":62,"content":["Och du ska säga: Herre, du har själv talat om denna plats att du vill fördärva den så att ingen mer ska bo här, varken människa eller djur, för den ska vara en ödemark för all framtid."]},{"type":"verse","number":63,"content":["Och när du har läst upp hela boken, ska du binda en sten vid den och kasta den mitt i floden Eufrat"]},{"type":"verse","number":64,"content":["och säga: På samma sätt ska Babel sjunka ner och aldrig mer komma upp på grund av den olycka som jag ska låta drabba det. Och de ska gå under.” Här slutar Jeremias ord.",{"noteId":215}]}],"footnotes":[{"noteId":208,"caller":"-","text":"Leb-Kamajär ett kryptogram för Kaldeen, dvs Babylonien. Namnet betyder ”hjärtat på dem som reser sig mot mig”.","reference":{"chapter":51,"verse":1}},{"noteId":209,"caller":"-","text":"sin arvedels stamAndra handskrifter: ”Israel, sin arvedels stam”.","reference":{"chapter":51,"verse":19}},{"noteId":210,"caller":"-","text":"Ararat, MinniRiken i gränsområdet mellan nuvarande Turkiet och Iran.","reference":{"chapter":51,"verse":27}},{"noteId":211,"caller":"-","text":"AshkenasSkyter (Kol 3:11), hästfolk öster och norr om Svarta havet (1 Mos 10:3).","reference":{"chapter":51,"verse":27}},{"noteId":212,"caller":"-","text":"Sheshakär ett kryptogram för Babel. Man ersätter alfabetets första bokstav med den sista, den andra med den näst sista osv.","reference":{"chapter":51,"verse":41}},{"noteId":213,"caller":"-","text":"Seraja, son till NeriaBror till skrivaren Baruk (Jer 32:12). Ett avtryck av Serajas personliga sigill finns bevarat. Som kvartermästare skötte han expeditionens inkvartering.","reference":{"chapter":51,"verse":59}},{"noteId":214,"caller":"-","text":"Sidkia i hans fjärde regeringsårÅr 593 f Kr, då Hesekiel i Babel fick sin kallelse (Hes 1:1).","reference":{"chapter":51,"verse":59}},{"noteId":215,"caller":"-","text":"Här slutar Jeremias ordKapitel 52 är en epilog hämtad från slutet av Andra Kungaboken (2 Kung 24:18f).","reference":{"chapter":51,"verse":64}}]},"thisChapterLink":"/api/swe_fol/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}