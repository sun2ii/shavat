{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Jerusalem belägras"]},{"type":"verse","number":1,"content":["Fly från Jerusalem,",{"text":"ni Benjamins barn!","poem":3},{"text":"Blås i hornet i Tekoa","poem":2},{"noteId":30},{"text":",","poem":2},{"text":"res ett högt baner","poem":3},{"text":"i Bet-Hakkerem","poem":4},{"noteId":31},{"text":",","poem":4},{"text":"för en olycka hotar från norr","poem":2},{"text":"med stor förödelse.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Jag ska ödelägga dotter Sion,","poem":1},{"text":"den vackra och bortskämda.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Herdar ska komma över henne","poem":1},{"text":"med sina hjordar.","poem":3},{"text":"De ska slå upp sina tält","poem":2},{"text":"runt omkring henne","poem":3},{"text":"och var och en ska beta av","poem":2},{"text":"sitt stycke.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Rusta er till strid mot henne!","poem":1},{"text":"”Kom, låt oss dra upp","poem":2},{"text":"vid middagstid!","poem":3},{"text":"Men ve oss, dagen går mot sitt slut","poem":2},{"text":"och kvällens skuggor förlängs.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Kom, låt oss dra upp om natten","poem":1},{"text":"och förstöra hennes palats.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"För så säger Herren Sebaot:","poem":1},{"text":"Fäll träd och bygg vallar","poem":2},{"noteId":32},{"text":"mot Jerusalem!","poem":3},{"text":"Här är staden som ska straffas.","poem":2},{"text":"Den är full av förtryck.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Som en källa flödar av vatten,","poem":1},{"text":"så flödar den av sin ondska.","poem":3},{"text":"Man hör om våld och förödelse där,","poem":2},{"text":"sår och slag är ständigt","poem":3},{"text":"inför mina ögon.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Ta varning, Jerusalem,","poem":1},{"text":"så att jag inte vänder mig","poem":2},{"text":"ifrån dig","poem":3},{"text":"och gör dig till en ödemark,","poem":2},{"text":"ett land där ingen bor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Man ska bärga en efterskörd","poem":2},{"text":"från dem som är kvar av Israel,","poem":3},{"text":"som från en vinstock.","poem":4},{"text":"Räck ut din hand på nytt,","poem":2},{"text":"som när man plockar druvor","poem":3},{"text":"från rankorna.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Till vem ska jag tala","poem":1},{"text":"och för vem ska jag vittna","poem":2},{"text":"så att de hör?","poem":3},{"text":"Deras öron är stängda","poem":2},{"noteId":33},{"text":"så att de inte kan höra.","poem":3},{"text":"Herrens ord föraktas bland dem,","poem":2},{"text":"de vill inte veta av det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Därför är jag fylld av Herrens vrede,","poem":1},{"text":"jag orkar inte hålla tillbaka den.","poem":3},{"text":"Ös ut den över barnen på gatan","poem":2},{"text":"och över de unga där de samlas.","poem":3},{"text":"Både man och kvinna ska drabbas,","poem":2},{"text":"också den gamle","poem":3},{"text":"och den som fyllt sina dagars mått.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Främlingar ska ta över deras hus,","poem":1},{"text":"deras åkrar och hustrur,","poem":3},{"text":"för jag ska räcka ut min hand","poem":2},{"text":"mot dem som bor i landet,","poem":3},{"text":"säger Herren.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hög som låg,","poem":1},{"text":"alla söker de oärlig vinst.","poem":3},{"text":"Både profet och präst,","poem":2},{"text":"alla handlar de lögnaktigt.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"De tar det lätt med att bota","poem":1},{"text":"mitt folks skada","poem":3},{"text":"och säger: ”Allt är väl, allt är väl!”","poem":2},{"text":"Men allt är inte väl.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"De ska stå där med skam,","poem":1},{"text":"för de har gjort avskyvärda saker.","poem":3},{"text":"Ändå känner de ingen skam","poem":2},{"text":"och förstår inte att blygas.","poem":3},{"text":"Därför ska de falla","poem":2},{"text":"bland dem som faller.","poem":3},{"text":"När tiden kommer","poem":2},{"text":"och jag straffar dem","poem":3},{"text":"ska de komma på fall,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Ställ er vid vägarna och spana,","poem":2},{"text":"fråga efter de urgamla stigarna.","poem":3},{"text":"Fråga efter den goda vägen","poem":2},{"text":"och vandra på den,","poem":3},{"text":"så ska ni finna ro för era själar","poem":2},{"noteId":34},{"text":".","poem":2},{"text":"Men de svarade:","poem":3},{"text":"”Vi vill inte vandra på den.”","poem":4}]},{"type":"verse","number":17,"content":[{"text":"När jag satte väktare","poem":1},{"text":"över er och sade:","poem":3},{"text":"”Lyssna till basunens ljud”,","poem":2},{"text":"svarade de: ”Vi vill inte lyssna.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hör därför, ni hednafolk,","poem":1},{"text":"och lägg märke till, du församling,","poem":2},{"text":"vad som sker bland dem.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Hör du jord: Se, jag ska låta","poem":1},{"text":"olycka drabba detta folk,","poem":2},{"text":"frukten av deras tankar,","poem":3},{"text":"eftersom de inte har lyssnat","poem":2},{"text":"på mina ord","poem":3},{"text":"utan förkastat min lag.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Vad bryr jag mig om","poem":1},{"text":"rökelse","poem":3},{"noteId":35},{"text":"från Saba","poem":3},{"text":"eller finaste kalmus","poem":2},{"noteId":36},{"text":"från fjärran land?","poem":3},{"text":"Era brännoffer har jag inte behag till","poem":2},{"text":"och era slaktoffer","poem":3},{"text":"tycker jag inte om.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"Därför säger Herren så:","poem":1},{"text":"Se, jag ska lägga stötestenar","poem":2},{"text":"framför detta folk,","poem":3},{"text":"och på dem ska fäder och söner","poem":2},{"text":"snubbla tillsammans,","poem":3},{"text":"grannar och vänner förgås.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Se, ett folk kommer","poem":2},{"text":"från landet i norr,","poem":3},{"text":"ett stort hednafolk reser sig","poem":2},{"text":"vid jordens yttersta ände.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"De bär båge och lans","poem":1},{"noteId":37},{"text":",","poem":1},{"text":"de är grymma och skoningslösa.","poem":3},{"text":"Deras röst är som havets dån,","poem":2},{"text":"och på sina hästar rider de fram,","poem":3},{"text":"rustade som kämpar till strid","poem":2},{"text":"mot dig, dotter Sion.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Vi har hört ryktet om dem.","poem":1},{"text":"Våra händer sjunker ner,","poem":2},{"text":"ängslan griper oss,","poem":3},{"text":"ångest som hos en barnaföderska.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gå inte ut på fältet","poem":1},{"text":"och vandra inte på vägen,","poem":3},{"text":"för fiendens svärd är där","poem":2},{"text":"med skräck från alla sidor.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Du, mitt folk, min dotter,","poem":1},{"text":"klä dig i säcktyg, rulla dig i aska,","poem":3},{"text":"sjung sorgesång","poem":2},{"text":"som efter ende sonen","poem":4},{"text":"och håll bitter dödsklagan.","poem":3},{"text":"Plötsligt drabbar oss fördärvaren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Jag har satt dig att pröva mitt folk","poem":1},{"text":"och gjort dig till en fast borg,","poem":3},{"text":"för att du ska lära känna","poem":2},{"text":"och pröva deras väg.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Alla är de förhärdade rebeller","poem":1},{"text":"som går med förtal,","poem":3},{"text":"de är som koppar och järn,","poem":2},{"text":"allihop är fördärvare.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Blåsbälgen pustar,","poem":1},{"text":"men ur elden kommer bara bly.","poem":3},{"text":"Mer rening är meningslös,","poem":2},{"text":"de onda rensas inte ut.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"”Förkastat silver” kallar man dem,","poem":1},{"text":"för Herren har förkastat dem.","poem":3}]}],"footnotes":[{"noteId":30,"caller":"-","text":"TekoaOrt i bergsbygden ca 1,5 mil söder om Jerusalem. Tekoa liknar ordet för ”hornstöt”.","reference":{"chapter":6,"verse":1}},{"noteId":31,"caller":"-","text":"Bet-HakkeremBetyder ”vingårdshuset”. Enligt Hieronymus halvvägs till Tekoa.","reference":{"chapter":6,"verse":1}},{"noteId":32,"caller":"-","text":"vallarBelägrare byggde en sluttande vall upp mot stadsmurens topp (bevarats t ex i Lakish).","reference":{"chapter":6,"verse":6}},{"noteId":33,"caller":"-","text":"stängdaOrdagrant: ”oomskurna” (jfr Apg 7:51).","reference":{"chapter":6,"verse":10}},{"noteId":34,"caller":"-","text":"finna ro för era själarUttrycket används av Jesus i Matt 11:29.","reference":{"chapter":6,"verse":16}},{"noteId":35,"caller":"-","text":"rökelseTändes dagligen i templet (2 Mos 30:7f, Luk 1:9f), en symbol för bön (Upp 5:8, 8:3).","reference":{"chapter":6,"verse":20}},{"noteId":36,"caller":"-","text":"kalmusDoftande gräs, ursprungligen från Indien. Ingick i smörjelseoljan (2 Mos 30:23).","reference":{"chapter":6,"verse":20}},{"noteId":37,"caller":"-","text":"lansAnnan översättning: ”kroksabel”.","reference":{"chapter":6,"verse":23}}]},"thisChapterLink":"/api/swe_fol/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}