{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["På den tiden, säger Herren, ska man kasta ut Juda kungars och furstars ben, prästernas och profeternas ben och Jerusalems invånares ben ur deras gravar"]},{"type":"verse","number":2,"content":["och strö ut dem inför solen och månen och himlens alla stjärnor som de har älskat, dyrkat och följt, sökt och tillbett. De ska inte samlas ihop eller begravas, de ska bli gödsel på marken."]},{"type":"verse","number":3,"content":["Alla som blir kvar av detta onda släkte ska hellre vilja dö än leva, vart jag än fördriver dem, säger Herren Sebaot."]},{"type":"heading","content":["Ett avfall utan motstycke"]},{"type":"verse","number":4,"content":[{"text":"Säg också till dem: Så säger Herren:","poem":1},{"lineBreak":true},{"text":"Om någon faller,","poem":1},{"text":"reser han sig då inte igen?","poem":3},{"text":"Och om någon går vilse,","poem":2},{"text":"vänder han då inte om?","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Varför vänder de sig ständigt bort,","poem":1},{"text":"detta Jerusalems folk?","poem":3},{"text":"De håller fast vid sitt svek,","poem":2},{"text":"de vägrar att vända om.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag har lyssnat och hört efter.","poem":1},{"text":"De talar det som inte är rätt.","poem":3},{"text":"Ingen enda ångrar sin ondska,","poem":2},{"text":"ingen säger: ”Vad har jag gjort?”","poem":3},{"text":"Alla viker av i egen riktning,","poem":2},{"text":"likt hästar som störtar sig ut","poem":3},{"text":"i striden.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Till och med storken under himlen","poem":1},{"text":"vet sin bestämda tid,","poem":3},{"text":"och turturduvan, svalan och tranan","poem":2},{"text":"passar tiden","poem":3},{"text":"när de ska komma tillbaka.","poem":4},{"text":"Men mitt folk","poem":2},{"text":"känner inte Herrens domslut.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Hur kan ni säga: ”Vi är visa,","poem":1},{"text":"vi har Herrens lag?”","poem":3},{"text":"Visst! De skriftlärdas lögnpenna","poem":2},{"text":"har förvandlat lagen till lögn.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"De visa ska komma på skam,","poem":1},{"text":"bli förskräckta och fångade.","poem":3},{"text":"Se, de har förkastat Herrens ord.","poem":2},{"text":"Vad har de då för vishet?","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Därför ska jag ge deras hustrur","poem":1},{"text":"åt andra","poem":3},{"text":"och deras åkrar åt erövrare,","poem":2},{"text":"för alla söker de oärlig vinst,","poem":3},{"text":"hög som låg.","poem":4},{"text":"Profet och präst,","poem":2},{"text":"alla handlar de lögnaktigt.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"De tar det lätt med att bota","poem":1},{"text":"dottern mitt folks skada","poem":3},{"text":"och säger: ”Allt är väl, allt är väl!”","poem":2},{"text":"Men allt är inte väl.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"De ska få skämmas","poem":1},{"text":"för att de har gjort något","poem":2},{"text":"så avskyvärt.","poem":3},{"text":"Ändå känner de ingen skam","poem":2},{"text":"och förstår inte att blygas.","poem":3},{"text":"Därför ska de falla","poem":2},{"text":"bland dem som faller.","poem":3},{"text":"När tiden kommer","poem":2},{"text":"och jag straffar dem","poem":3},{"text":"ska de komma på fall,","poem":2},{"text":"säger Herren.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Jag ska rycka bort och förgöra dem,","poem":1},{"text":"säger Herren.","poem":3},{"text":"Inga druvor blir kvar","poem":2},{"text":"på vinstockarna","poem":3},{"text":"och inga fikon på fikonträden,","poem":2},{"text":"till och med löven är vissnade.","poem":3},{"text":"Det jag gav dem","poem":2},{"text":"ska tas ifrån dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Varför sitter vi här?","poem":1},{"text":"Låt oss samlas","poem":2},{"text":"och gå in i de befästa städerna","poem":3},{"text":"och möta slutet där,","poem":4},{"text":"för Herren vår Gud","poem":2},{"text":"låter oss förgås.","poem":3},{"text":"Han ger oss förgiftat vatten","poem":2},{"text":"att dricka,","poem":3},{"text":"för vi har syndat mot Herren.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vi väntade på välgång,","poem":1},{"text":"men inget gott kommer,","poem":3},{"text":"på en tid med läkedom,","poem":2},{"text":"men se, skräck råder.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Från Dan hörs hans hästar frusta,","poem":1},{"text":"när hans hingstar gnäggar","poem":2},{"text":"bävar hela landet.","poem":3},{"text":"De kommer och slukar landet","poem":2},{"text":"med allt som finns där,","poem":3},{"text":"staden och alla som bor i den.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Se, jag sänder ormar bland er,","poem":1},{"text":"giftormar som inte kan besvärjas,","poem":2},{"text":"och de ska bita er, säger Herren.","poem":3}]},{"type":"heading","content":["Profetens stora sorg"]},{"type":"verse","number":18,"content":[{"text":"Var ska jag få lindring i min sorg?","poem":1},{"text":"Mitt hjärta är sjukt i mig.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Hör, dottern mitt folk","poem":1},{"text":"ropar från fjärran land:","poem":3},{"text":"”Finns inte Herren mer i Sion?","poem":2},{"text":"Är hennes kung inte längre där?”","poem":3},{"text":"Varför har de retat mig till vrede","poem":2},{"text":"med sina bilder,","poem":4},{"text":"med sina främmande avgudar?","poem":3}]},{"type":"verse","number":20,"content":[{"text":"”Skördetiden är förbi,","poem":1},{"noteId":45},{"text":"sommaren är över,","poem":3},{"text":"men vi har inte blivit räddade.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jag är förkrossad,","poem":1},{"text":"för dottern mitt folk har krossats.","poem":3},{"text":"Jag sörjer, förfäran har gripit mig.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Finns det ingen balsam i Gilead","poem":1},{"noteId":46},{"text":",","poem":1},{"text":"finns där ingen läkare?","poem":3},{"text":"Varför blir dottern mitt folk","poem":2},{"text":"inte botad?","poem":3}]}],"footnotes":[{"noteId":45,"caller":"-","text":"Skördetiden är förbiDen belägrade staden kunde inte fylla på sitt matförråd.","reference":{"chapter":8,"verse":20}},{"noteId":46,"caller":"-","text":"balsam i GileadKanske mastix, en doftande kåda med medicinska egenskaper.","reference":{"chapter":8,"verse":22}}]},"thisChapterLink":"/api/swe_fol/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}