{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JER","translationId":"swe_fol","name":"Jeremia","commonName":"Jeremia","title":"Jeremia","order":24,"numberOfChapters":52,"sha256":"6a7dbbcbd8cd35d59c52b64f7dad4960117ef05b409a0d605903164f6bf9b5e7","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swe_fol/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":9,"content":[{"type":"heading","content":["Klagan över folkets ogudaktighet"]},{"type":"verse","number":1,"content":["O, att mitt huvud",{"text":"vore en vattenbrunn","poem":2},{"text":"och mina ögon en källa av tårar!","poem":3},{"text":"Då skulle jag gråta dag och natt","poem":2},{"text":"över de slagna","poem":3},{"text":"hos dottern mitt folk.","poem":4}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O, att jag hade en viloplats i öknen,","poem":1},{"text":"så att jag kunde lämna mitt folk","poem":2},{"text":"och gå bort från dem,","poem":3},{"text":"för de är alla äktenskapsbrytare,","poem":2},{"text":"en samling trolösa.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"De spänner sin tunga som en pilbåge,","poem":1},{"text":"lögn och inte sanning","poem":2},{"text":"härskar i landet.","poem":3},{"text":"De går från illdåd till illdåd,","poem":2},{"text":"mig vill de inte veta av,","poem":3},{"text":"säger Herren.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Var och en ska vara på sin vakt","poem":1},{"text":"för sin vän,","poem":3},{"text":"ingen kan lita","poem":2},{"text":"ens på sin bror,","poem":3},{"text":"för varje bror är en listig bedragare","poem":2},{"noteId":47},{"text":"och varje vän går med förtal.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Var och en sviker sin vän,","poem":1},{"text":"ingen talar sanning.","poem":3},{"text":"De lär sina tungor att tala lögn,","poem":2},{"text":"de tröttar ut sig med att göra illa.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Du bor mitt ibland svek,","poem":1},{"text":"i sin svekfullhet vill de inte","poem":2},{"text":"veta av mig, säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Därför säger Herren Sebaot så:","poem":1},{"text":"Se, jag smälter dem","poem":2},{"text":"och prövar dem,","poem":3},{"text":"för vad annat kan jag göra","poem":2},{"text":"med dottern mitt folk?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Deras tunga är en mördande pil,","poem":1},{"text":"deras mun talar svek.","poem":3},{"text":"De talar vänligt till sin nästa,","poem":2},{"text":"men i hjärtat lägger de fällor","poem":3},{"text":"för honom.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Skulle jag inte straffa dem för sådant?","poem":1},{"text":"säger Herren.","poem":3},{"text":"Skulle jag inte hämnas","poem":2},{"text":"på ett sådant folk som detta?","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jag vill gråta och sjunga sorgesång","poem":1},{"text":"över bergen,","poem":3},{"text":"jag vill höja sorgesång","poem":2},{"text":"över betesmarkerna i öknen,","poem":3},{"text":"för de är förbrända,","poem":2},{"text":"ingen går fram där mer,","poem":3},{"text":"och inga läten av boskap","poem":2},{"text":"hörs längre.","poem":3},{"text":"Både himlens fåglar","poem":2},{"text":"och de vilda djuren har flytt,","poem":3},{"text":"de är alla borta.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jag ska göra Jerusalem","poem":1},{"text":"till ett stenröse,","poem":2},{"text":"till en boning för schakaler,","poem":3},{"text":"och Juda städer till en ödemark","poem":2},{"text":"där ingen bor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":["Vem är så vis att han förstår detta? Och till vem har Herrens mun talat, så att han kan förklara varför landet har blivit så fördärvat, förbränt som en öken där ingen färdas?"]},{"type":"verse","number":13,"content":["Herren svarade: Det är för att de har övergett min undervisning som jag gav dem. De har inte lyssnat till min röst och inte följt den,"]},{"type":"verse","number":14,"content":["utan vandrat efter sina hårda hjärtan och följt baalerna, så som deras fäder lärde dem."]},{"type":"verse","number":15,"content":["Därför säger Herren Sebaot, Israels Gud, så: Se, jag ska ge detta folk malört att äta och förgiftat vatten att dricka."]},{"type":"verse","number":16,"content":["Och jag ska sprida ut dem bland folk som varken de eller deras fäder har känt, och jag ska sända svärdet efter dem tills jag gjort slut på dem."]},{"type":"heading","content":["Nöden vid Jerusalems undergång"]},{"type":"verse","number":17,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Se er om och kalla på gråterskor","poem":2},{"noteId":48},{"text":"så att de kommer,","poem":3},{"text":"sänd efter kunniga kvinnor,","poem":2},{"text":"låt dem komma.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Låt dem snabbt stämma upp","poem":1},{"text":"en sorgesång över oss,","poem":3},{"text":"så att våra ögon rinner av tårar","poem":2},{"text":"och vattnet strömmar","poem":3},{"text":"från våra ögonlock,","poem":4}]},{"type":"verse","number":19,"content":[{"text":"för sorgesång hörs från Sion:","poem":1},{"text":"”Vilken förödelse","poem":2},{"text":"som har drabbat oss!","poem":3},{"text":"Vi skäms djupt,","poem":2},{"text":"vi måste lämna landet,","poem":3},{"text":"för de har rivit våra hem.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ni kvinnor, hör Herrens ord,","poem":1},{"text":"öppna era öron","poem":2},{"text":"för ordet från hans mun.","poem":3},{"text":"Lär era döttrar sorgesång,","poem":2},{"text":"lär varandra klagosång,","poem":3}]},{"type":"verse","number":21,"content":[{"text":"för döden stiger in","poem":1},{"text":"genom våra fönster","poem":2},{"text":"och kommer in i våra palats.","poem":3},{"text":"Den rycker bort barnen från gatan","poem":2},{"text":"och de unga männen från torgen.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Säg: Så säger Herren:","poem":1},{"text":"Människornas döda kroppar","poem":2},{"text":"ligger som gödsel på marken,","poem":3},{"text":"som kärvar efter skördemannen,","poem":2},{"text":"och ingen samlar upp dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Den vise ska inte berömma sig","poem":2},{"text":"av sin vishet,","poem":3},{"text":"den starke inte av sin styrka","poem":2},{"text":"och den rike inte av sin rikedom.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Den som vill berömma sig,","poem":1},{"text":"han ska berömma sig av","poem":2},{"text":"att han har insikt och känner mig:","poem":3},{"text":"Att jag är Herren,","poem":2},{"text":"som verkar med nåd,","poem":3},{"text":"rätt och rättfärdighet på jorden,","poem":4},{"text":"för i det har jag min glädje,","poem":2},{"text":"säger Herren.","poem":3},{"noteId":49}]},{"type":"line_break"},{"type":"verse","number":25,"content":["Se, dagar ska komma, säger Herren, då jag ska straffa alla omskurna",{"noteId":50},"som ändå är oomskurna:"]},{"type":"verse","number":26,"content":["Egypten, Juda, Edom, ammoniterna, Moab och alla ökenbor med kantklippt hår. För hednafolken är alla oomskurna, och hela Israels hus har ett oomskuret hjärta."]}],"footnotes":[{"noteId":47,"caller":"-","text":"bedragarePå hebreiska ”Jakob” (se 1 Mos 25:26 med not).","reference":{"chapter":9,"verse":4}},{"noteId":48,"caller":"-","text":"gråterskorYrkeskvinnor som anlitades vid begravningar.","reference":{"chapter":9,"verse":17}},{"noteId":49,"caller":"-","text":"Citeras av Paulus i 1 Kor 1:31 och 2 Kor 10:17.","reference":{"chapter":9,"verse":24}},{"noteId":50,"caller":"-","text":"omskurna … oomskurnaFör grannfolken var omskärelsen inte ett förbundstecken (se not till 1 Mos 17:10).","reference":{"chapter":9,"verse":25}}]},"thisChapterLink":"/api/swe_fol/JER/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JER/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/8.json","previousChapterAudioLinks":{},"numberOfVerses":26}