{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Jag är trött på livet,",{"text":"jag vill släppa fram","poem":2},{"lineBreak":true},{"text":"min klagan,","poem":2},{"text":"jag talar i min själs bitterhet.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Jag vill säga till Gud:","poem":1},{"text":"Fördöm mig inte.","poem":3},{"text":"Låt mig veta varför du anklagar mig.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Gläds du åt att förtrycka,","poem":1},{"text":"att förkasta dina händers verk","poem":3},{"text":"och låta ditt ljus skina","poem":2},{"text":"över de gudlösas rådslag?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Har du ögon som en varelse av kött,","poem":1},{"text":"ser du så som människor ser?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Är dina dagar","poem":1},{"text":"som en människas dagar,","poem":3},{"text":"dina år som en mans levnadstid?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Du letar ju efter min skuld","poem":1},{"text":"och söker min synd,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"du som vet att jag är oskyldig","poem":1},{"text":"och att ingen kan rädda ur din hand.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Dina händer har format mig","poem":1},{"text":"och gjort varje del av mig,","poem":3},{"text":"och ändå vill du fördärva mig!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tänk på hur du formade mig","poem":1},{"text":"som lera,","poem":3},{"text":"och nu låter du mig bli stoft igen!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Du hällde ut mig som mjölk","poem":1},{"text":"och lät mig stelna som ost.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Du klädde mig med hud och kött","poem":1},{"text":"och vävde mig samman","poem":2},{"text":"av ben och senor.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Liv och nåd gav du mig,","poem":1},{"text":"din omsorg bevarade min ande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Men detta gömde du i ditt hjärta","poem":1},{"text":"– jag vet att du tänkte så –","poem":2}]},{"type":"verse","number":14,"content":[{"text":"att om jag syndade,","poem":1},{"text":"skulle du vakta på mig","poem":2},{"lineBreak":true},{"text":"och inte lämna min skuld ostraffad.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ve mig om jag är skyldig!","poem":1},{"text":"Men är jag oskyldig","poem":2},{"text":"kan jag ändå inte lyfta mitt huvud,","poem":3},{"text":"för jag fylls av skam","poem":2},{"text":"och ser mitt lidande.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Och höjde jag huvudet","poem":1},{"text":"skulle du jaga mig som ett lejon","poem":3},{"text":"och åter visa din förunderliga","poem":2},{"text":"makt mot mig.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Du skulle föra fram","poem":1},{"text":"nya vittnen mot mig","poem":3},{"text":"och låta mig känna","poem":2},{"text":"din vrede mer och mer,","poem":3},{"text":"du skulle sända här efter här","poem":2},{"text":"mot mig.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Varför tog du mig ut ur moderlivet?","poem":1},{"text":"Om jag ändå hade dött","poem":2},{"text":"innan något öga såg mig!","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Om jag ändå aldrig varit till,","poem":1},{"text":"utan förts från moderlivet","poem":2},{"text":"till graven!","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Min tid är kort.","poem":1},{"text":"Låt mig vara, lämna mig i fred","poem":2},{"text":"så att jag får en stund av glädje","poem":3}]},{"type":"verse","number":21,"content":[{"text":"innan jag går bort","poem":1},{"text":"för att aldrig komma tillbaka,","poem":3},{"text":"till mörkrets","poem":2},{"text":"och dödsskuggans land,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"till ett land med dunkel","poem":1},{"text":"som djupaste natt,","poem":3},{"text":"till dödsskugga och förvirring","poem":2},{"text":"där ljuset är som djupaste natt.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}