{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Sofars första tal"]},{"type":"verse","number":1,"content":["Då tog Sofar från Naama till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ska detta ordflöde stå oemotsagt","poem":1},{"text":"och en så mångordig man få rätt?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ska ditt tomma prat få män att tiga,","poem":1},{"text":"ska du håna utan att någon","poem":2},{"text":"får dig att skämmas?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Du säger: ”Min lära är ren,","poem":1},{"text":"och jag är fläckfri","poem":2},{"text":"inför dina ögon.”","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Om bara Gud ville tala","poem":1},{"text":"och öppna sin mun mot dig","poem":3}]},{"type":"verse","number":6,"content":[{"text":"och säga dig vishetens hemligheter,","poem":1},{"text":"för han äger förstånd","poem":2},{"text":"i dubbelt mått.","poem":3},{"text":"Då skulle du inse att Gud","poem":2},{"text":"kan låta din skuld vara glömd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kan du utforska Guds djup?","poem":1},{"text":"Kan du förstå den Allsmäktiges","poem":2},{"text":"fullkomlighet?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Hög som himlen är den –","poem":1},{"text":"vad kan du göra?","poem":3},{"text":"Djupare än dödsriket är den –","poem":2},{"text":"vad kan du förstå?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Dess längd är längre än jorden","poem":1},{"text":"och vidare än havet.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Om han far fram","poem":1},{"text":"och fängslar någon","poem":3},{"text":"och kallar till doms –","poem":2},{"text":"vem kan hindra honom?","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Han känner lögnens män","poem":1},{"text":"och ser ondskan,","poem":3},{"text":"skulle han inte bry sig om det?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Om en dåre kan få förstånd,","poem":1},{"text":"då kan en vildåsna","poem":2},{"text":"födas till människa.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Om du bereder ditt hjärta","poem":1},{"text":"och sträcker ut dina händer","poem":2},{"text":"till honom,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"om du skaffar undan","poem":1},{"text":"dina händers fördärv","poem":3},{"text":"och inte låter orättfärdighet","poem":2},{"text":"bo i dina tält,","poem":3}]},{"type":"verse","number":15,"content":[{"text":"då ska du lyfta","poem":1},{"text":"ditt ansikte utan skam,","poem":3},{"text":"du står trygg","poem":2},{"text":"och har inget att frukta.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Du ska glömma ditt elände,","poem":1},{"text":"minnas det som bortrunnet vatten.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ditt liv ska stråla klarare","poem":1},{"text":"än middagsljuset,","poem":3},{"text":"och mörkret ska vara","poem":2},{"text":"som morgonljuset.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Du ska vara trygg,","poem":1},{"text":"för det finns hopp.","poem":3},{"text":"Du ska se dig omkring","poem":2},{"text":"och trygg gå till vila.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Du ska lägga dig","poem":1},{"text":"utan att någon skrämmer dig,","poem":3},{"text":"och många ska söka vinna","poem":2},{"text":"din gunst.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Men de gudlösas ögon ska tyna bort,","poem":1},{"text":"för dem ska ingen tillflykt finnas,","poem":3},{"text":"deras hopp ska vara","poem":2},{"text":"att få ge upp andan.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}