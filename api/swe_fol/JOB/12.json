{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["Jobs svar på Sofars första tal"]},{"type":"verse","number":1,"content":["Då tog Job till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Visst är det ni som är folket,","poem":1},{"text":"och med er dör visheten ut!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Men jag har förstånd","poem":1},{"text":"likaväl som ni,","poem":3},{"text":"jag är inte underlägsen er.","poem":2},{"text":"Vem känner inte till detta?","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jag har blivit till åtlöje","poem":1},{"text":"för min vän,","poem":3},{"text":"jag som ropade till Gud","poem":2},{"text":"och fick svar.","poem":3},{"text":"Den rättfärdige och oskyldige","poem":2},{"text":"blir till åtlöje.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"I den sorglöses tankar","poem":1},{"text":"föraktas olyckan,","poem":3},{"text":"den står redo för dem","poem":2},{"text":"vilkas fötter vacklar.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Rövarna får ha sina tält i fred,","poem":1},{"text":"de som trotsar Gud har trygghet,","poem":2},{"text":"de som har sin gud i sin hand.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Men fråga boskapen,","poem":1},{"text":"den ska undervisa dig,","poem":3},{"text":"fåglarna under himlen,","poem":2},{"text":"de ska ge dig svar.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Tala till jorden,","poem":1},{"text":"den ska undervisa dig,","poem":3},{"text":"fiskarna i havet ska ge dig besked.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vem av dem känner inte till","poem":1},{"text":"att det är Herrens hand","poem":2},{"text":"som har gjort det?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"I hans hand är allt levandes själ","poem":1},{"text":"och varje människas ande.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ska inte örat pröva orden","poem":1},{"text":"liksom munnen prövar","poem":2},{"lineBreak":true},{"text":"matens smak?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hos de gamla finns vishet,","poem":1},{"text":"långt liv ger förstånd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hos Gud finns vishet och makt,","poem":1},{"text":"hos honom finns råd och förstånd.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Se, han river ner","poem":1},{"text":"och ingen kan bygga upp,","poem":3},{"text":"han låser in och ingen kan öppna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Se, han håller vattnen tillbaka","poem":1},{"text":"och de torkar ut,","poem":3},{"text":"han släpper dem lösa","poem":2},{"text":"och de ödelägger landet.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Hos honom är kraft och klokhet,","poem":1},{"text":"den förvillade och förvillaren","poem":2},{"text":"tillhör honom.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Rådsherrar för han barfota bort,","poem":1},{"text":"och domare gör han till dårar.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Han lossar kungars bojor","poem":1},{"text":"och binder rep om deras höfter.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Präster för han barfota bort","poem":1},{"text":"och störtar mäktiga män.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Han tystar de betroddas läppar","poem":1},{"text":"och tar bort de äldstes insikt.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Han öser förakt över furstar","poem":1},{"text":"och lossar bältet på de starka.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Han avslöjar mörkrets djupheter","poem":1},{"text":"och för dödsskuggan ut i ljuset.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Han låter folkslag växa","poem":1},{"text":"och förgör dem,","poem":3},{"text":"han vidgar deras gränser","poem":2},{"text":"och för bort dem.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Han tar förståndet","poem":1},{"text":"från ledarna för jordens folk","poem":3},{"text":"och låter dem irra","poem":2},{"text":"i väglös ödemark.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"De famlar i mörker utan ljus,","poem":1},{"text":"han får dem att ragla som druckna.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}