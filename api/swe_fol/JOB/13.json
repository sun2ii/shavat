{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Se, allt har mitt öga sett,",{"text":"mitt öra har hört","poem":2},{"text":"och förstått det.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Vad ni vet, vet också jag,","poem":1},{"text":"jag är inte underlägsen er.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Men jag vill tala till den Allsmäktige,","poem":1},{"text":"jag vill försvara mig mot Gud.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ni däremot spinner ihop lögn,","poem":1},{"text":"ni är alla värdelösa läkare.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Om ni ändå ville tiga helt –","poem":1},{"text":"det skulle vara er vishet!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hör nu mitt försvar,","poem":1},{"text":"lyssna till mina läppars inlägg.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vill ni försvara Gud med orätt","poem":1},{"text":"och tala falskhet för hans sak?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Visar ni er partiska för honom,","poem":1},{"text":"är det Guds sak ni försvarar?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kan det sluta väl","poem":1},{"text":"när han rannsakar er?","poem":3},{"text":"Eller kan ni bedra honom","poem":2},{"text":"som man bedrar en människa?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Han ska sannerligen straffa er","poem":1},{"text":"om ni visar dold partiskhet.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ska inte hans majestät skrämma er,","poem":1},{"text":"skräck för honom drabba er?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Era tänkespråk är ordspråk av aska,","poem":1},{"text":"ert försvar är försvarsverk av lera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tig nu och låt mig tala,","poem":1},{"text":"sedan får vad som helst hända mig.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Varför skulle jag ta mitt kött","poem":1},{"text":"mellan tänderna","poem":3},{"text":"och lägga mitt liv i min hand?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Se, han får döda mig,","poem":1},{"text":"jag väntar inget annat.","poem":3},{"noteId":23},{"text":"Då får jag försvara min väg","poem":2},{"text":"inför hans ansikte.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Det skulle också bli min frälsning,","poem":1},{"text":"för ingen gudlös","poem":2},{"text":"kan komma inför honom.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Hör noga på mina ord,","poem":1},{"text":"låt min förklaring nå era öron.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Se, jag lägger fram min sak,","poem":1},{"text":"jag vet att jag har rätt.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Finns det någon","poem":1},{"text":"som kan anklaga mig?","poem":3},{"text":"I så fall ska jag tiga och dö.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Skona mig bara från två ting,","poem":1},{"text":"sedan ska jag inte gömma mig","poem":2},{"text":"för ditt ansikte:","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Låt inte din hand drabba mig","poem":1},{"text":"och låt inte skräck för dig","poem":2},{"text":"skrämma mig.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Kalla på mig och jag ska svara,","poem":1},{"text":"eller jag ska tala och du svara mig.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hur många är mina","poem":1},{"text":"missgärningar och synder?","poem":3},{"text":"Visa mitt brott och min synd.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Varför döljer du ditt ansikte","poem":1},{"text":"och ser mig som din fiende?","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Vill du skrämma","poem":1},{"text":"ett bortvirvlande löv,","poem":3},{"text":"förföljer du ett torrt halmstrå?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Du skriver ner bittra ting mot mig","poem":1},{"text":"och låter mig ärva","poem":2},{"text":"min ungdoms synder.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Du sätter mina fötter i stocken,","poem":1},{"text":"du vaktar på alla mina vägar","poem":3},{"text":"och märker ut stegen för mina fötter.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Människan tärs bort som ruttet trä,","poem":1},{"text":"som ett malätet klädesplagg.","poem":2}]}],"footnotes":[{"noteId":23,"caller":"-","text":"jag väntar inget annatAndra handskrifter: ”jag hoppas ändå på honom”.","reference":{"chapter":13,"verse":15}}]},"thisChapterLink":"/api/swe_fol/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}