{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Människan, av kvinna född,",{"text":"lever en kort tid","poem":2},{"text":"och mättas av oro.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Som ett blomster växer hon upp","poem":1},{"text":"och vissnar,","poem":3},{"text":"som en skugga flyr hon","poem":2},{"text":"och kan inte bestå.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Mot en sådan öppnar du ditt öga,","poem":1},{"text":"mig drar du till doms inför dig.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kan en ren komma från en oren?","poem":1},{"text":"Nej, inte en enda!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Om människans dagar är bestämda","poem":1},{"text":"och hennes månaders antal","poem":2},{"text":"är fastställt av dig,","poem":3},{"text":"om du har satt en gräns","poem":2},{"text":"som hon inte kan överskrida,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"vänd då din blick ifrån henne","poem":1},{"text":"och ge henne ro,","poem":3},{"text":"låt henne få glädje av sin dag","poem":2},{"text":"som en daglönare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"För ett träd finns det hopp,","poem":1},{"text":"huggs det ner kan det gro igen","poem":2},{"text":"och nya skott ska inte saknas.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Även om dess rötter åldras i jorden","poem":1},{"text":"och stubben dör i mullen,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ska det grönska vid doften av vatten","poem":1},{"text":"och skjuta skott som ett ungt träd.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Men när en man dör ligger han där.","poem":1},{"text":"När en människa ger upp andan,","poem":2},{"text":"var är hon då?","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Som vattnet försvinner ur sjön","poem":1},{"text":"och en flod sinar och torkar ut,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"så lägger sig människan","poem":1},{"text":"och står inte upp igen.","poem":3},{"text":"Först när inte himlen finns mer","poem":2},{"text":"vaknar hon och reser sig","poem":3},{"text":"från sin sömn.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tänk om du ville","poem":1},{"text":"gömma mig i dödsriket,","poem":2},{"text":"dölja mig tills din vrede upphör,","poem":3},{"text":"sätta en bestämd tid för mig","poem":2},{"text":"och tänka på mig!","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Kan en människa som en gång dött","poem":1},{"text":"få liv igen?","poem":3},{"text":"Då skulle jag hålla ut","poem":2},{"text":"i min mödas tid","poem":3},{"text":"tills min avlösning kommer.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Du skulle ropa på mig,","poem":1},{"text":"och jag skulle svara dig,","poem":3},{"text":"du skulle längta efter","poem":2},{"text":"dina händers verk.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Fastän du nu räknar mina steg","poem":1},{"text":"skulle du inte ge akt på min synd.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Min synd skulle ligga i en förseglad pung,","poem":1},{"text":"och du skulle täcka över min skuld.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Men som berget faller","poem":1},{"text":"och vittrar bort,","poem":3},{"text":"som klippan flyttas från sin plats,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"som vatten nöter sönder stenar,","poem":1},{"text":"som dess flöden sköljer bort myllan,","poem":2},{"text":"så gör du människans hopp","poem":3},{"text":"om intet.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Du besegrar henne för alltid","poem":1},{"text":"och hon går bort,","poem":3},{"text":"du förändrar hennes ansikte","poem":2},{"text":"och sänder i väg henne.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Om hennes barn kommer till ära","poem":1},{"text":"vet hon det inte,","poem":3},{"text":"om de blir ringa","poem":2},{"text":"ser hon det inte.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Hennes kropp känner bara","poem":1},{"text":"sin egen plåga,","poem":3},{"text":"hennes själ bara sin egen sorg.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}