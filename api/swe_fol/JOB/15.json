{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["Elifas andra tal"]},{"type":"verse","number":1,"content":["Då tog Elifas från Teman till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ska en vis man tala så i vädret","poem":1},{"text":"och fylla sitt bröst","poem":2},{"text":"med östanvind?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ska han försvara sin sak","poem":1},{"text":"med värdelöst tal,","poem":3},{"text":"med ord till ingen nytta?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ja, du gör gudsfruktan om intet","poem":1},{"text":"och hindrar andakt inför Gud,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"för din synd lägger orden i din mun","poem":1},{"text":"och du väljer listigt tal.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Din egen mun dömer dig, inte jag,","poem":1},{"text":"dina egna läppar vittnar emot dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Var du den första människa","poem":1},{"text":"som föddes?","poem":3},{"text":"Blev du till innan höjderna fanns?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Var du åhörare i Guds hemliga råd?","poem":1},{"text":"Har du tagit visheten","poem":2},{"text":"för dig själv?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Vad vet du som vi inte vet?","poem":1},{"text":"Vad förstår du som vi inte förstår?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Här hos oss finns","poem":1},{"text":"både gråhårsman och åldring,","poem":3},{"text":"mycket äldre än din far.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Är inte Guds tröst nog för dig,","poem":1},{"text":"de milda ord som talas till dig?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Varför leds du bort av ditt hjärta","poem":1},{"text":"och varför gnistrar dina ögon?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Du vänder din ande mot Gud","poem":1},{"text":"och öser ut ord ur din mun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Vad är en människa,","poem":1},{"text":"att hon skulle vara ren,","poem":3},{"text":"att en av kvinna född","poem":2},{"text":"skulle vara rättfärdig?","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Gud kan inte lita på sina heliga,","poem":1},{"text":"inför hans ögon","poem":2},{"text":"är inte himlarna rena,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"hur mycket mindre då den","poem":1},{"text":"som är avskyvärd och fördärvad,","poem":3},{"text":"en människa","poem":2},{"text":"som dricker orättfärdighet","poem":3},{"text":"som vatten!","poem":4}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lyssna, jag vill säga dig något,","poem":1},{"text":"det som jag sett vill jag berätta,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"vad visa män fört vidare","poem":1},{"text":"från sina fäder och inte förtigit,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"från dem som ensamma fick landet","poem":1},{"text":"utan att någon främling","poem":2},{"text":"trängde in bland dem:","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Den gudlöse plågas av ångest","poem":1},{"text":"i alla sina dagar,","poem":3},{"text":"den våldsammes år är räknade.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Skräckröster ljuder i hans öron.","poem":1},{"text":"I hans trygghet kommer förhärjaren","poem":2},{"text":"över honom.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Han har inget hopp om räddning","poem":1},{"text":"ur mörkret,","poem":3},{"text":"svärdet är bestämt för honom.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Han irrar efter bröd","poem":1},{"text":"och undrar var det finns.","poem":3},{"text":"Han vet att mörkrets dag är nära.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ångest och nöd skrämmer honom,","poem":1},{"text":"de slår ner honom","poem":2},{"text":"som en kung rustad till strid,","poem":3}]},{"type":"verse","number":25,"content":[{"text":"för han har lyft sin hand mot Gud","poem":1},{"text":"och förhäver sig","poem":2},{"text":"mot den Allsmäktige.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Med styv nacke","poem":1},{"text":"stormar han mot honom,","poem":3},{"text":"väl skyddad bakom sina sköldar.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Han har täckt sitt ansikte med fetma","poem":1},{"text":"och hans midja sväller av fett.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Han bosätter sig i ödelagda städer,","poem":1},{"text":"i hus där man inte kan bo,","poem":2},{"text":"som är bestämda till ruiner.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Han blir inte rik,","poem":1},{"text":"hans välstånd ska inte bestå,","poem":3},{"text":"hans skördar ska inte luta tungt","poem":2},{"text":"mot marken.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Han kan inte fly undan mörkret,","poem":1},{"text":"hans knoppar ska förtorka","poem":2},{"text":"av hetta,","poem":3},{"text":"han ska förgås","poem":2},{"text":"genom Guds","poem":3},{"noteId":24},{"text":"muns ande.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Han ska inte lita till tomhet,","poem":1},{"text":"då bedrar han sig,","poem":3},{"text":"för tomhet blir hans lön.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"I förtid ska hans mått bli fyllt,","poem":1},{"text":"och hans krona","poem":2},{"text":"ska inte grönska mer.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Han ska tappa sina omogna druvor","poem":1},{"text":"som en vinstock,","poem":3},{"text":"fälla sina blommor som ett olivträd,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"för den gudlöses hus","poem":1},{"text":"blir ofruktsamt","poem":3},{"text":"och eld förtär de hus där mutor tas.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"De går havande med elände","poem":1},{"text":"och föder fördärv,","poem":3},{"text":"deras moderliv alstrar förvillelse.","poem":2}]}],"footnotes":[{"noteId":24,"caller":"-","text":"GudsOrdagrant: ”hans”.","reference":{"chapter":15,"verse":30}}]},"thisChapterLink":"/api/swe_fol/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}