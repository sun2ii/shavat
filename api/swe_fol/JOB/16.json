{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Jobs svar på Elifas andra tal"]},{"type":"verse","number":1,"content":["Då tog Job till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Det där har jag hört många gånger!","poem":1},{"text":"Ni är alla bedrövliga tröstare.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Är det ingen ände","poem":1},{"text":"på detta tal i vädret?","poem":3},{"text":"Vad frestar dig att ta till orda?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Också jag kunde tala som ni,","poem":1},{"text":"om ni vore i mitt ställe.","poem":3},{"text":"Jag kunde fläta samman ord mot er","poem":2},{"text":"och skaka mitt huvud mot er.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Men jag skulle styrka er","poem":1},{"text":"med min mun,","poem":3},{"text":"mina läppars tröst","poem":2},{"text":"skulle ge er lindring.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Om jag talar lindras inte min plåga,","poem":1},{"text":"och tiger jag, lämnar den mig inte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Men nu har han tömt all min kraft.","poem":1},{"text":"Du har ödelagt hela mitt hus.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Du har fjättrat mig,","poem":1},{"text":"det har blivit mitt vittnesbörd.","poem":3},{"text":"Min tärda kropp träder upp","poem":2},{"text":"och vittnar mot mig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Hans vrede sliter sönder","poem":1},{"text":"och jagar mig,","poem":3},{"text":"han gnisslar sina tänder mot mig.","poem":2},{"text":"Min motståndare ger mig","poem":3},{"text":"vassa blickar.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"De spärrar upp munnen mot mig,","poem":1},{"text":"de slår mig hånfullt på kinden,","poem":3},{"text":"alla gaddar ihop sig mot mig.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Gud utlämnar mig åt de gudlösa","poem":1},{"text":"och kastar mig i de ondas händer.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jag satt i trygghet,","poem":1},{"text":"då krossade han mig.","poem":3},{"text":"Han grep mig i nacken","poem":2},{"text":"och slog mig i bitar,","poem":3},{"text":"han gjorde mig till sin måltavla,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"han skjuter pilar från alla sidor,","poem":1},{"text":"genomborrar mina njurar","poem":2},{"text":"utan förskoning,","poem":3},{"text":"häller ut min galla på marken.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Han bryter ner mig med slag på slag,","poem":1},{"text":"stormar emot mig som en krigare.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jag har sytt säcktyg över min hud","poem":1},{"text":"och har sänkt mitt horn","poem":2},{"noteId":25},{"text":"i stoftet.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mitt ansikte är flammigt av tårar,","poem":1},{"text":"mina ögonlock mörka","poem":2},{"text":"av dödsskugga,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"fastän mina händer är fria från våld","poem":1},{"text":"och min bön är ren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Du jord, täck inte över mitt blod,","poem":1},{"text":"låt mitt rop aldrig stanna","poem":2},{"text":"någonstans!","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Se, redan nu har jag mitt vittne","poem":1},{"text":"i himlen,","poem":3},{"text":"min försvarare i höjden.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Min medlare är min vän","poem":1},{"noteId":26},{"text":",","poem":1},{"text":"mitt öga fäller tårar inför Gud.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Må han skaffa rätt","poem":1},{"text":"åt en man inför Gud,","poem":3},{"text":"så som en människoson","poem":2},{"text":"gör för sin nästa,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"för om bara några år","poem":1},{"text":"ska jag vandra vägen","poem":2},{"text":"utan återvändo.","poem":3}]}],"footnotes":[{"noteId":25,"caller":"-","text":"hornSymbol för styrka och kraft (jfr Ps 89:25, 92:11).","reference":{"chapter":16,"verse":15}},{"noteId":26,"caller":"-","text":"Min medlare är min vänAnnan översättning: ”Mina vänner hånar mig” (men jfr 33:23).","reference":{"chapter":16,"verse":20}}]},"thisChapterLink":"/api/swe_fol/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}