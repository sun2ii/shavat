{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Min ande är bruten,",{"text":"mina dagar slocknar,","poem":3},{"text":"graven väntar på mig.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sannerligen, jag är omgiven","poem":1},{"text":"av smädelser,","poem":3},{"text":"mitt öga ser ständigt","poem":2},{"text":"deras fiendskap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gå själv i borgen för mig,","poem":1},{"text":"vem annars kan ge mig","poem":2},{"text":"sitt handslag?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Du har stängt deras hjärtan","poem":1},{"text":"för insikt,","poem":3},{"text":"låt dem därför inte triumfera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Den som förråder vänner","poem":1},{"text":"mot belöning,","poem":3},{"text":"på hans barn ska ögonen tyna bort.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Han har gjort mig till ett ordspråk","poem":1},{"text":"bland folken,","poem":3},{"text":"jag är en man som man spottar","poem":2},{"text":"i ansiktet.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Mitt öga är skumt av grämelse,","poem":1},{"text":"alla mina lemmar","poem":2},{"text":"är som en skugga.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De rättsinniga häpnar över sådant,","poem":1},{"text":"den oskyldige blir upprörd","poem":2},{"text":"över de gudlösa.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Men den rättfärdige","poem":1},{"text":"håller fast vid sin väg,","poem":3},{"text":"och den som har rena händer","poem":2},{"text":"blir starkare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Men ni får alla komma tillbaka,","poem":1},{"text":"jag finner ändå ingen vis bland er.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mina dagar är förbi,","poem":1},{"text":"mina planer är krossade,","poem":3},{"text":"det som var mitt hjärtas begär.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Natten vill de göra till dag,","poem":1},{"text":"och när mörkret bryter in säger de:","poem":2},{"text":"”Ljuset är nära.”","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Om jag måste vänta mig dödsriket","poem":1},{"text":"som min boning,","poem":3},{"text":"breda ut min bädd i mörkret,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"säga till förgängelsen:","poem":1},{"text":"”Du är min far”,","poem":3},{"text":"och till maskarna:","poem":2},{"text":"”Min mor, min syster” –","poem":3}]},{"type":"verse","number":15,"content":[{"text":"var är då mitt hopp?","poem":1},{"text":"Vem kan se något hopp för mig?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kommer det ner","poem":1},{"text":"till dödsrikets bommar,","poem":3},{"text":"sjunker vi ner tillsammans","poem":2},{"text":"i stoftet?","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}