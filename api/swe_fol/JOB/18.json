{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["Bildads andra tal"]},{"type":"verse","number":1,"content":["Då tog Bildad från Shua till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hur länge ska ni lägga snaror","poem":1},{"text":"med ord?","poem":3},{"text":"Kom till förstånd,","poem":2},{"text":"sedan kan vi tala.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Varför räknas vi som djur","poem":1},{"text":"och betraktas som dumma","poem":2},{"text":"i era ögon?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Du som sliter sönder","poem":1},{"text":"dig själv i vrede,","poem":3},{"text":"ska jorden bli öde för din skull","poem":2},{"text":"eller klippan flyttas från sin plats?","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sannerligen,","poem":1},{"text":"den gudlöses ljus ska slockna","poem":2},{"text":"och lågan i hans eld sluta lysa.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ljuset i hans tält ska bli mörkt","poem":1},{"text":"och lampan slockna för honom.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hans väldiga steg ska bli kortare,","poem":1},{"text":"hans egna rådslag fälla honom.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hans fötter leder honom till nätet,","poem":1},{"text":"han vandrar mot snaran.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Snaran griper hans häl,","poem":1},{"text":"fällan håller fast honom.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ett rep är lagt för honom","poem":1},{"text":"på marken,","poem":3},{"text":"en fälla ligger på stigen.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Skräck möter honom från alla håll","poem":1},{"text":"och jagar honom i hälarna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Olyckan hungrar efter honom,","poem":1},{"text":"hemsökelsen står redo","poem":2},{"text":"att fälla honom.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Sjukdom förtär hans hud,","poem":1},{"text":"dödens förstfödde","poem":2},{"text":"slukar hans lemmar.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Han rycks bort från sitt trygga tält","poem":1},{"text":"och drivs i väg till fasornas kung.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I hans tält får främlingar bo,","poem":1},{"text":"svavel strös över hans boning.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hans rötter torkar nertill,","poem":1},{"text":"hans grenar vissnar upptill.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hans minne utplånas från jorden,","poem":1},{"text":"hans namn nämns inte","poem":2},{"text":"på vägarna.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Han drivs från ljuset till mörkret","poem":1},{"text":"och jagas bort från världen.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Han blir utan barn","poem":1},{"text":"och efterkommande i sitt folk,","poem":3},{"text":"ingen överlevande finns","poem":2},{"text":"i hans hus.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"De som bor i väst","poem":1},{"text":"häpnar över hans olyckas dag,","poem":3},{"text":"de som bor i öst","poem":2},{"text":"skälver av fasa.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Ja, så går det den orättfärdiges hem,","poem":1},{"text":"så går det den plats","poem":2},{"text":"där man inte känner Gud.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}