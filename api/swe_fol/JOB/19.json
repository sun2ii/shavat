{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Jobs svar på Bildads andra tal"]},{"type":"verse","number":1,"content":["Då tog Job till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hur länge ska ni plåga min själ","poem":1},{"text":"och krossa mig med ord?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tio gånger har ni hånat mig","poem":1},{"text":"och kränkt mig utan att rodna.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Om jag verkligen har gått vilse,","poem":1},{"text":"då är förvillelsen min egen sak.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Även om ni förhäver er mot mig","poem":1},{"text":"och använder min förnedring","poem":2},{"text":"emot mig,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"så ska ni veta","poem":1},{"text":"att Gud har gjort mig orätt","poem":2},{"text":"och spänt sitt nät omkring mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jag ropar mot våldet","poem":1},{"text":"men får inget svar,","poem":3},{"text":"jag ropar men där finns ingen","poem":2},{"text":"rättfärdighet.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Han har spärrat min väg","poem":1},{"text":"så att jag inte kommer fram,","poem":3},{"text":"över mina stigar lägger han mörker.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han har klätt av mig min ära","poem":1},{"text":"och tagit kronan från mitt huvud.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Han bryter ner mig från alla sidor","poem":1},{"text":"tills jag går under.","poem":3},{"text":"Han rycker upp mitt hopp","poem":2},{"text":"som ett träd.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Han har tänt sin vredes eld","poem":1},{"text":"mot mig","poem":3},{"text":"och räknar mig som sin fiende.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hans skaror samlas","poem":1},{"text":"och förbereder sitt anfall mot mig,","poem":2},{"text":"de slår läger runt mitt tält.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Han har drivit bort","poem":1},{"text":"mina bröder från mig,","poem":3},{"text":"alla jag känner","poem":2},{"text":"är som främlingar för mig.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Mina närmaste har gett sig av,","poem":1},{"text":"mina vänner har glömt mig.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Min familj och mina tjänarinnor","poem":1},{"text":"ser mig som en främling,","poem":3},{"text":"en främmande är jag i deras ögon.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Om jag kallar på min tjänare","poem":1},{"text":"svarar han inte,","poem":3},{"text":"jag måste vädja","poem":2},{"text":"till honom ödmjukt.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Min andedräkt är vidrig","poem":1},{"text":"för min hustru,","poem":3},{"text":"jag äcklar min egen familj.","poem":2},{"noteId":27}]},{"type":"verse","number":18,"content":[{"text":"Även små barn föraktar mig,","poem":1},{"text":"så snart jag reser mig","poem":2},{"text":"hånar de mig.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"För alla mina vänner","poem":1},{"text":"är jag avskyvärd,","poem":3},{"text":"de jag älskade","poem":2},{"text":"har vänt mig ryggen.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Mina ben tränger ut","poem":1},{"text":"genom hud och kött,","poem":3},{"text":"jag har bara tandköttet kvar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Var barmhärtiga, ni mina vänner,","poem":1},{"text":"var barmhärtiga mot mig,","poem":3},{"text":"för Guds hand har slagit mig.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Varför förföljer ni mig","poem":1},{"text":"som Gud gör?","poem":3},{"text":"Blir ni aldrig mätta av mitt kött?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"O, att mina ord skulle skrivas ner,","poem":1},{"text":"att de skulle nertecknas i en bok","poem":2}]},{"type":"verse","number":24,"content":[{"text":"och för evigt ristas in i klippan","poem":1},{"text":"med järnstift och bly!","poem":2},{"noteId":28}]},{"type":"verse","number":25,"content":[{"text":"Men jag vet att min återlösare lever","poem":1},{"noteId":29},{"text":",","poem":1},{"text":"att han till sist ska träda fram","poem":2},{"text":"över stoftet.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"När sedan min sargade hud","poem":1},{"text":"är borta,","poem":3},{"text":"ska jag i mitt kött skåda Gud.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Jag själv ska få skåda honom,","poem":1},{"text":"jag ska se honom","poem":3},{"text":"med egna ögon,","poem":2},{"text":"inte med någon annans.","poem":3},{"text":"Därefter längtar jag i mitt innersta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Men ni säger:","poem":1},{"text":"”Hur ska vi förfölja honom?”","poem":3},{"text":"Roten till olyckan","poem":2},{"text":"har ni funnit hos mig","poem":3},{"noteId":30},{"text":".","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Var rädda för svärdet,","poem":1},{"text":"för vrede hör till synder","poem":2},{"text":"som straffas med svärd.","poem":3},{"text":"Därför ska ni veta","poem":2},{"text":"att det kommer en dom.","poem":3}]}],"footnotes":[{"noteId":27,"caller":"-","text":"min egen familjOrdagrant: ”min mages barn”. Syftar troligen på Jobs syskon, de som är födda ur samma moderliv som han själv, eftersom hans egna barn var döda (1:19).","reference":{"chapter":19,"verse":17}},{"noteId":28,"caller":"-","text":"blyAnvändes för att fylla i en inskrift i sten.","reference":{"chapter":19,"verse":24}},{"noteId":29,"caller":"-","text":"min återlösare leverMöjlig profetia om Kristus (jfr 1 Kor 15).","reference":{"chapter":19,"verse":25}},{"noteId":30,"caller":"-","text":"har ni funnit hos migAndra handskrifter (så Septuaginta): ”finns hos honom”.","reference":{"chapter":19,"verse":28}}]},"thisChapterLink":"/api/swe_fol/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}