{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Sofars andra tal"]},{"type":"verse","number":1,"content":["Då tog Sofar från Naama till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mina tankar tvingar mig att svara,","poem":1},{"text":"jag är så upprörd.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Kränkande tillrättavisning","poem":1},{"text":"måste jag höra,","poem":3},{"text":"men mitt förstånds ande","poem":2},{"text":"ger mig svar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vet du inte att det alltid varit så,","poem":1},{"text":"ända sedan människan","poem":2},{"text":"sattes på jorden,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"att de gudlösas jubel är kortvarigt,","poem":1},{"text":"att den gudlöses glädje","poem":2},{"text":"varar ett ögonblick?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Även om hans förhävelse","poem":1},{"text":"stiger mot himlen","poem":3},{"text":"och hans huvud når till molnen,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"så förgås han dock för alltid","poem":1},{"text":"som sin egen träck.","poem":3},{"text":"De som såg honom ska fråga:","poem":2},{"text":"”Var finns han?”","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Likt en dröm flyger han bort","poem":1},{"text":"och ingen finner honom,","poem":3},{"text":"han jagas i väg","poem":2},{"text":"som en syn om natten.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ögat som såg honom","poem":1},{"text":"ser honom aldrig mer,","poem":3},{"text":"hans plats får inte återse honom.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hans barn måste gottgöra de fattiga,","poem":1},{"text":"hans händer återlämna","poem":2},{"text":"hans rikedom.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Hans ben var fulla","poem":1},{"text":"av ungdomskraft,","poem":3},{"text":"men de ska ligga i stoftet","poem":2},{"text":"med honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Även om ondskan är söt i hans mun","poem":1},{"text":"och han gömmer den","poem":2},{"text":"under tungan,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"även om han är rädd om den","poem":1},{"text":"och inte vill förlora den","poem":3},{"text":"utan förvarar den i sin mun,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"så förvandlas hans föda i hans inre","poem":1},{"text":"och blir till ormgift","poem":2},{"text":"inom honom.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Den rikedom han slukat","poem":1},{"text":"måste han kräkas upp,","poem":3},{"text":"Gud driver ut den ur hans buk.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ormgift ska han suga i sig,","poem":1},{"text":"giftormens tunga ska döda honom.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Inga bäckar får han se,","poem":1},{"text":"inget flöde av honung","poem":2},{"text":"och gräddmjölk.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Han måste återlämna","poem":1},{"text":"vad han tjänat,","poem":3},{"text":"han får inte njuta av det","poem":2},{"text":"eller glädjas åt den rikedom","poem":3},{"text":"han vunnit,","poem":4}]},{"type":"verse","number":19,"content":[{"text":"för han slog och övergav de ringa,","poem":1},{"text":"han rövade åt sig hus","poem":2},{"text":"som han inte hade byggt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Han känner ingen ro i sitt inre,","poem":1},{"text":"han kan inte rädda sig","poem":2},{"text":"genom sina ägodelar.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Inget kom undan hans glupskhet,","poem":1},{"text":"därför ska hans framgång","poem":2},{"text":"inte bestå.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Mitt i sitt överflöd","poem":1},{"text":"ska han drabbas av nöd,","poem":3},{"text":"lidande av alla slag","poem":2},{"text":"ska möta honom.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"När han fyller sin buk","poem":1},{"text":"ska Gud sända sin vredes glöd","poem":2},{"text":"över honom,","poem":3},{"text":"och den ska träffa honom som regn.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Flyr han för vapen av järn","poem":1},{"text":"ska kopparbågens pilar","poem":2},{"text":"genomborra honom.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Drar han ut pilen från sin rygg","poem":1},{"text":"och den blanka udden","poem":2},{"text":"ur sin galla,","poem":3},{"text":"då drabbar honom dödsångest.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Djupt mörker väntar","poem":1},{"text":"på hans ägodelar.","poem":3},{"text":"En eld som ingen blåser på","poem":2},{"text":"ska förtära honom,","poem":3},{"text":"den ska ödelägga","poem":2},{"text":"det som finns kvar i hans tält.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Himlarna visar hans skuld","poem":1},{"text":"och jorden reser sig mot honom.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Allt i hans hus drivs bort","poem":1},{"text":"som forsande vatten","poem":2},{"text":"på vredens dag.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Det är vad den gudlösa människan","poem":1},{"text":"får av Gud,","poem":3},{"text":"den lott Gud har bestämt.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}