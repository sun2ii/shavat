{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["Jobs svar på Sofars andra tal"]},{"type":"verse","number":1,"content":["Då tog Job till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lyssna noga på mina ord,","poem":1},{"text":"låt det vara trösten ni ger mig.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Visa mig tålamod så att jag får tala,","poem":1},{"text":"och när jag har talat kan du håna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Är det en människa jag grälar på?","poem":1},{"text":"Varför skulle jag inte vara otålig?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Se på mig och häpna,","poem":1},{"text":"sätt handen för munnen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"När jag tänker på det","poem":1},{"text":"blir jag förskräckt,","poem":3},{"text":"rysningar griper min kropp.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Varför får de gudlösa leva,","poem":1},{"text":"bli gamla och växa i kraft?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"De ser sina barn leva trygga hos dem","poem":1},{"text":"och har sina avkomlingar","poem":2},{"text":"för ögonen.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Deras hus står trygga utan fasor,","poem":1},{"text":"Gud drabbar dem inte med sitt ris.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Deras boskap lyckas alltid para sig,","poem":1},{"text":"deras kor kalvar utan missfall.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Sina minsta släpper de ut","poem":1},{"text":"som en hjord,","poem":3},{"text":"deras barn dansar omkring.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"De sjunger till tamburin och harpa","poem":1},{"text":"och jublar till musik av flöjt.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"De lever sina dagar i välmåga,","poem":1},{"text":"och i frid far de ner till dödsriket.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"De sade till Gud: ”Låt oss vara!","poem":1},{"text":"Vi har ingen lust","poem":2},{"text":"att lära känna dina vägar.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Vem är den Allsmäktige","poem":1},{"text":"att vi skulle tjäna honom?","poem":3},{"text":"Vad skulle vi vinna","poem":2},{"text":"på att åkalla honom?”","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Se, deras framgång","poem":1},{"text":"ligger inte i deras egen hand.","poem":3},{"text":"De gudlösas rådslag","poem":2},{"text":"är fjärran från mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hur ofta slocknar","poem":1},{"text":"de gudlösas lampa?","poem":3},{"text":"Hur ofta drabbar dem olycka,","poem":2},{"text":"plågor som Gud i vrede","poem":3},{"text":"tilldelar dem?","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Hur ofta blir de som halm för vinden,","poem":1},{"text":"som agnar som stormen för bort?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ni säger:","poem":1},{"text":"”Gud sparar hans straff","poem":2},{"text":"till barnen.”","poem":3},{"text":"Låt honom straffa honom själv,","poem":2},{"text":"så att han får känna det.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Låt den gudlöse få se sitt fall","poem":1},{"text":"med egna ögon,","poem":3},{"text":"låt honom få dricka","poem":2},{"text":"den Allsmäktiges vrede.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Frågar han efter sin familj","poem":1},{"text":"när han är borta,","poem":3},{"text":"när hans månaders antal är slut?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kan någon lära Gud förstånd,","poem":1},{"text":"han som dömer över de högsta?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Den ene dör i sin krafts dagar,","poem":1},{"text":"helt sorglös och trygg.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hans kärl är fulla av mjölk,","poem":1},{"text":"och märgen i hans ben","poem":2},{"text":"har bevarat sin saft.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Den andre dör med bedrövad själ,","poem":1},{"text":"utan att ha smakat det goda.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tillsammans ligger de i stoftet,","poem":1},{"text":"med förruttnelsens maskar","poem":2},{"text":"över sig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Se, jag känner era tankar","poem":1},{"text":"och era lömska planer mot mig.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ni frågar:","poem":1},{"text":"”Vad blev det av stormännens hus,","poem":2},{"text":"av tälten där de gudlösa bodde?”","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Har ni inte frågat dem som har rest,","poem":1},{"text":"lyssnar ni inte","poem":2},{"text":"till deras vittnesbörd?","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Den onde skonas på olyckans dag,","poem":1},{"text":"han räddas undan vredens dag.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Vem säger honom rakt i ansiktet","poem":1},{"text":"hur han lever,","poem":3},{"text":"vem straffar honom","poem":2},{"text":"för vad han har gjort?","poem":3}]},{"type":"verse","number":32,"content":[{"text":"När han har förts till graven","poem":1},{"text":"vakar man vid gravkullen.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Dalens mylla är ljuvlig för honom,","poem":1},{"text":"alla människor följer honom","poem":2},{"text":"och otaliga har gått före honom.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Hur tom är inte trösten ni ger mig.","poem":1},{"text":"Era svar är bara bedrägeri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}