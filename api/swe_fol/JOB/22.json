{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Elifas tredje tal"]},{"type":"verse","number":1,"content":["Då tog Elifas från Teman till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kan en människa","poem":1},{"text":"vara till nytta för Gud,","poem":3},{"text":"kan en förståndig","poem":2},{"text":"vara till nytta för honom?","poem":3},{"noteId":31}]},{"type":"verse","number":3,"content":[{"text":"Har den Allsmäktige","poem":1},{"text":"någon glädje av din rättfärdighet,","poem":3},{"text":"eller något att tjäna på att du","poem":2},{"text":"lever rent?","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Är det för din gudsfruktan","poem":1},{"text":"som han straffar dig","poem":3},{"text":"och går till doms med dig?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Är inte din ondska stor","poem":1},{"text":"och dina missgärningar utan ände?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Du tog ju pant av din broder","poem":1},{"text":"utan orsak","poem":3},{"text":"och plundrade de utblottade","poem":2},{"text":"på deras kläder.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Du gav inget vatten åt den utmattade,","poem":1},{"text":"den hungrige nekade du bröd.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Den som brukar våld","poem":1},{"text":"fick besitta landet,","poem":3},{"text":"och den som är högt aktad","poem":2},{"text":"fick bo där.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Änkor lät du gå tomhänta bort,","poem":1},{"text":"och de faderlösas armar krossades.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Därför omges du av snaror","poem":1},{"text":"och förfäras av plötslig skräck,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"eller av mörker så att du inget ser","poem":1},{"text":"och av vattenmassor som täcker dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bor inte Gud i himlens höjd?","poem":1},{"text":"Och se på stjärnorna däruppe,","poem":2},{"text":"hur högt de sitter!","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Och du säger:","poem":1},{"text":"”Vad kan Gud veta?","poem":3},{"text":"Kan han döma genom detta töcken?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Molnen bildar en slöja","poem":1},{"text":"så att han inte ser","poem":3},{"text":"när han vandrar på himlavalvet.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Vill du hålla dig på forntidens väg","poem":1},{"text":"där fördärvets män","poem":2},{"noteId":32},{"text":"gick,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"män som rycktes bort i förtid","poem":1},{"text":"när deras grund sveptes bort","poem":2},{"text":"av floden?","poem":3}]},{"type":"verse","number":17,"content":[{"text":"De sade till Gud: ”Lämna oss!","poem":1},{"text":"Vad kan den Allsmäktige göra?”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ändå var det han som fyllde","poem":1},{"text":"deras hus med välstånd.","poem":3},{"text":"Men de gudlösas rådslag","poem":2},{"text":"är fjärran ifrån mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"De rättfärdiga ser det och gläds,","poem":1},{"text":"den oskyldige hånar dem:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"”Sannerligen,","poem":1},{"text":"våra motståndare är utrotade,","poem":3},{"text":"och elden har slukat deras överflöd.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Sök nu försoning och frid med Gud,","poem":1},{"text":"så ska lycka komma på din lott.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ta emot undervisning av hans mun,","poem":1},{"text":"bevara hans ord i ditt hjärta.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Om du omvänder dig","poem":1},{"text":"till den Allsmäktige","poem":2},{"text":"blir du upprättad,","poem":3},{"text":"om du avlägsnar orätten","poem":2},{"text":"från ditt tält,","poem":3}]},{"type":"verse","number":24,"content":[{"text":"om du kastar ditt guld i stoftet","poem":1},{"text":"och guldet från Ofir","poem":2},{"noteId":33},{"text":"bland bäckens stenar,","poem":3}]},{"type":"verse","number":25,"content":[{"text":"då blir den Allsmäktige ditt guld,","poem":1},{"text":"han blir ditt ädlaste silver.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ja, då ska du glädjas","poem":1},{"text":"i den Allsmäktige","poem":3},{"text":"och lyfta ditt ansikte till Gud.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"När du ber till honom","poem":1},{"text":"ska han höra dig,","poem":3},{"text":"och du ska få uppfylla dina löften.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Allt du beslutar ska gå dig väl,","poem":1},{"text":"och ljus ska skina på dina vägar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"När de för nedåt","poem":1},{"text":"ska du säga: ”Uppåt!”","poem":3},{"text":"Då ska han frälsa","poem":2},{"text":"den som sänker sin blick.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Han ska rädda också den","poem":1},{"text":"som inte är oskyldig,","poem":3},{"text":"genom dina händers renhet","poem":2},{"text":"ska han räddas.","poem":3}]}],"footnotes":[{"noteId":31,"caller":"-","text":"kan en förståndig vara till nytta för honom?Annan översättning: ”en förståndig är till nytta för sig själv” (jfr Ords 9:12).","reference":{"chapter":22,"verse":2}},{"noteId":32,"caller":"-","text":"fördärvets mänGenerationen vid syndafloden (se 1 Mos 6:4f).","reference":{"chapter":22,"verse":15}},{"noteId":33,"caller":"-","text":"OfirBerömt guldproducerande land, troligen i södra Arabien (jfr 1 Mos 10:29, 1 Kung 9:28f).","reference":{"chapter":22,"verse":24}}]},"thisChapterLink":"/api/swe_fol/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}