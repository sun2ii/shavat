{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Jobs svar på Elifas tredje tal"]},{"type":"verse","number":1,"content":["Då tog Job till orda och sade:"]},{"type":"verse","number":2,"content":[{"text":"Också i dag är min klagan bitter.","poem":1},{"noteId":34},{"text":"Min hand","poem":2},{"noteId":35},{"text":"vilar tungt","poem":2},{"text":"över mitt suckande.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"O, om jag visste","poem":1},{"text":"hur jag skulle finna honom,","poem":3},{"text":"hur jag kunde komma","poem":2},{"text":"till hans boning!","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag skulle lägga fram","poem":1},{"text":"min sak inför honom,","poem":3},{"text":"fylla min mun med bevis.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jag vill veta","poem":1},{"text":"vad han kan svara mig,","poem":3},{"text":"begrunda vad han har","poem":2},{"text":"att säga mig.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Skulle han bekämpa mig","poem":1},{"text":"med sin stora makt?","poem":3},{"text":"Nej, han skulle lyssna på mig.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"En rättfärdig skulle då","poem":1},{"text":"vara hans motpart,","poem":3},{"text":"jag skulle för alltid","poem":2},{"text":"bli frikänd av min domare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Se, går jag mot öster","poem":1},{"text":"är han inte där,","poem":3},{"text":"går jag mot väster","poem":2},{"text":"finner jag honom inte.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Är han verksam i norr","poem":1},{"text":"skådar jag honom inte,","poem":3},{"text":"vänder han sig åt söder","poem":2},{"text":"ser jag honom inte.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Han vet vilken väg jag har vandrat.","poem":1},{"text":"Prövar han mig","poem":2},{"text":"ska jag komma fram som guld.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Min fot har hållit fast vid hans spår,","poem":1},{"text":"jag har följt hans väg utan att vika av.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jag har inte övergett","poem":1},{"text":"hans läppars bud,","poem":3},{"text":"hans muns ord är mig en större skatt","poem":2},{"text":"än mitt dagliga bröd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Men han är den ende,","poem":1},{"text":"vem kan stå honom emot?","poem":3},{"text":"Vad han vill, det gör han.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Han fullbordar","poem":1},{"text":"vad han beslutat om mig,","poem":3},{"text":"och mycket mer av samma slag.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Därför bävar jag för hans ansikte,","poem":1},{"text":"när jag tänker på det","poem":2},{"text":"blir jag rädd för honom.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Gud har gjort mitt hjärta försagt,","poem":1},{"text":"den Allsmäktige","poem":2},{"text":"har fått mig att bäva,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"för jag fick inte förgås","poem":1},{"text":"innan mörkret kom,","poem":3},{"text":"han dolde inte den svarta natten","poem":2},{"text":"för mitt ansikte.","poem":3}]}],"footnotes":[{"noteId":34,"caller":"-","text":"bitterAnnan översättning: ”trotsig”.","reference":{"chapter":23,"verse":2}},{"noteId":35,"caller":"-","text":"Min handAndra handskrifter (Septuaginta och Peshitta): ”Hans hand”.","reference":{"chapter":23,"verse":2}}]},"thisChapterLink":"/api/swe_fol/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}