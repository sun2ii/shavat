{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Varför har den Allsmäktige",{"text":"inga domstider i förvar?","poem":3},{"text":"Varför får inte hans vänner","poem":2},{"text":"se hans dagar?","poem":3}]},{"type":"verse","number":2,"content":[{"text":"De flyttar gränsstenar","poem":1},{"noteId":36},{"text":",","poem":1},{"text":"de rövar bort hjordar","poem":2},{"text":"och för dem i bet.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"De för bort de faderlösas åsna","poem":1},{"text":"och tar änkans ko i pant.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"De tränger bort de fattiga","poem":1},{"text":"från vägen,","poem":3},{"text":"alla nödställda i landet","poem":2},{"text":"måste gömma sig.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Se, som vildåsnor i öknen","poem":1},{"text":"går de ut till sin gärning.","poem":3},{"text":"De söker efter mat,","poem":2},{"text":"och hedmarken","poem":3},{"text":"ger dem bröd åt barnen.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"De skördar foder på fältet,","poem":1},{"text":"de plockar det som finns kvar","poem":2},{"noteId":37},{"text":"i den gudlöses vingård.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Nakna ligger de om natten,","poem":1},{"text":"utan kläder,","poem":3},{"text":"de har inget att skyla sig med","poem":2},{"text":"i kölden.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De dränks av skurar från bergen,","poem":1},{"text":"i brist på skydd","poem":2},{"text":"håller de sig tätt intill klippan.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Faderlösa slits från sin mors bröst","poem":1},{"text":"och tas i pant från den fattige.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"De måste gå omkring nakna,","poem":1},{"text":"utan kläder,","poem":3},{"text":"hungrande bär de på kärvar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mellan deras murar","poem":1},{"text":"pressar de ut olja,","poem":3},{"text":"törstande trampar de vinpressen.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Från staden hörs","poem":1},{"text":"de döendes jämmer,","poem":3},{"text":"svårt sårade ropar på hjälp.","poem":2},{"text":"Men Gud bryr sig inte om","poem":3},{"text":"ondskan.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Andra har blivit fiender till ljuset,","poem":1},{"text":"de känner inte dess vägar","poem":2},{"text":"och håller sig inte","poem":3},{"text":"på dess stigar.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Så snart det dagas","poem":1},{"text":"stiger mördaren upp,","poem":3},{"text":"han dödar","poem":2},{"text":"den nödställde och fattige,","poem":3},{"text":"och om natten blir han tjuvars like.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Äktenskapsbrytarens öga","poem":1},{"text":"spanar efter skymningen,","poem":3},{"text":"han tänker: ”Inget öga får se mig”","poem":2},{"text":"och täcker sitt ansikte","poem":3},{"text":"med en slöja.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Vid mörkrets inbrott","poem":1},{"text":"bryter de sig in i husen,","poem":3},{"text":"om dagen låser de in sig.","poem":2},{"text":"De vill inte veta av ljuset,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"för svartaste mörker","poem":1},{"text":"är morgon för dem alla,","poem":3},{"text":"de är väl förtrogna","poem":2},{"text":"med mörkrets fasor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"De är skum på vattenytan.","poem":1},{"text":"Deras mark är förbannad i landet,","poem":2},{"text":"ingen styr sin färd","poem":3},{"text":"till vingårdarna.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Som torka och hetta","poem":1},{"text":"slukar snövatten,","poem":3},{"text":"så slukar dödsriket","poem":2},{"text":"den som har syndat.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Modersskötet glömmer honom,","poem":1},{"text":"maskar frossar på honom,","poem":3},{"text":"ingen bevarar hans minne.","poem":2},{"text":"Orätten bryts som ett träd.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Han gör illa den ofruktsamma","poem":1},{"text":"som inte kan föda","poem":3},{"text":"och är inte god mot änkan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Men Gud rycker bort de starka","poem":1},{"text":"genom sin kraft.","poem":3},{"text":"När han griper in","poem":2},{"text":"kan de inte vara säkra för sitt liv.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Han ger dem trygghet och vila,","poem":1},{"text":"men hans ögon vakar","poem":2},{"text":"över deras vägar.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"En kort tid är de upphöjda,","poem":1},{"text":"sedan är de borta,","poem":3},{"text":"de slås ner och skördas som alla,","poem":2},{"text":"de vissnar som axens toppar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Om det inte är så,","poem":1},{"text":"vem kan visa att jag ljuger","poem":2},{"text":"och göra mina ord om intet?","poem":3}]}],"footnotes":[{"noteId":36,"caller":"-","text":"flyttar gränsstenarEtt svårt brott (Ords 23:10f). På mesopotamiska gränsstenar har man funnit inristade förbannelser över den som vågar flytta dem för att öka sitt område.","reference":{"chapter":24,"verse":2}},{"noteId":37,"caller":"-","text":"plockar det som finns kvarSå fick de fattiga sin försörjning (3 Mos 19:10, 5 Mos 24:21, Rut 2).","reference":{"chapter":24,"verse":6}}]},"thisChapterLink":"/api/swe_fol/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}