{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Jobs svar på Bildads tredje tal"]},{"type":"verse","number":1,"content":["Då tog Job till orda och sade:"]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Vilken hjälp har du inte gett","poem":1},{"text":"den maktlöse,","poem":3},{"text":"hur har du inte stärkt","poem":2},{"text":"den svages arm!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Vilka råd har du inte gett","poem":1},{"text":"den ovise,","poem":3},{"text":"vilket överflöd av klokhet","poem":2},{"text":"har du inte lagt i dagen!","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Med vems hjälp talar du dessa ord,","poem":1},{"text":"och vems ande utgår från dig?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"De avlidna skälver,","poem":1},{"text":"likaså djupets vatten","poem":2},{"text":"och de som bor där.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Dödsriket ligger naket för honom,","poem":1},{"text":"avgrunden","poem":3},{"noteId":38},{"text":"utan täckelse.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han spänner ut himlen i norr","poem":1},{"text":"över det tomma,","poem":3},{"text":"han hänger upp jorden på intet.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Han samlar upp vatten i sina moln,","poem":1},{"text":"och skyarna brister inte","poem":2},{"text":"under bördan.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Han gömmer sin tron för vår åsyn,","poem":1},{"text":"han höljer den med sina skyar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"En välvd horisont","poem":1},{"text":"har han satt över vattnen","poem":3},{"text":"där ljuset gränsar mot mörkret.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Himlens pelare skälver,","poem":1},{"text":"skrämda av hans tillrättavisning.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Med sin kraft stillar","poem":1},{"noteId":39},{"text":"han havet,","poem":1},{"text":"med sitt förstånd","poem":2},{"text":"krossar han Rahab","poem":3},{"noteId":40},{"text":".","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Han andas och himlen blir klar.","poem":1},{"text":"Hans hand genomborrar","poem":2},{"text":"den snabba ormen.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Se, detta är bara en glimt","poem":1},{"text":"av hans verk,","poem":3},{"text":"det vi hör om honom","poem":2},{"text":"är bara en viskning.","poem":3},{"text":"Vem kan fatta dånet av hans kraft?","poem":2}]}],"footnotes":[{"noteId":38,"caller":"-","text":"avgrundenHebr. Abaddón(jfr Upp 9:11). Annan översättning: ”fördärvet”.","reference":{"chapter":26,"verse":6}},{"noteId":39,"caller":"-","text":"stillarAnnan översättning: ”upprör”.","reference":{"chapter":26,"verse":12}},{"noteId":40,"caller":"-","text":"RahabBetyder ”övermod”, ”trots”. Namnet används också om Egypten (jfr Ps 87:4, Jes 30:7).","reference":{"chapter":26,"verse":12}}]},"thisChapterLink":"/a