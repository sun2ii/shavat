{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"heading","content":["Jobs sluttal (Kap 27-31)"]},{"type":"verse","number":1,"content":["Job fortsatte sin framställning. Han sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Så sant Gud lever,","poem":1},{"text":"han som undanhållit mig min rätt,","poem":2},{"text":"den Allsmäktige","poem":3},{"text":"som har förbittrat min själ:","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Så länge min ande är i mig","poem":1},{"text":"och Guds livsande i min näsa,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ska mina läppar inte tala orätt","poem":1},{"text":"eller min tunga tala svek.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aldrig ger jag er rätt,","poem":1},{"text":"till min död vidhåller jag","poem":2},{"text":"min oskuld.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag håller fast vid min rättfärdighet","poem":1},{"text":"och släpper den inte.","poem":3},{"text":"Mitt hjärta förebrår mig inte","poem":2},{"text":"för någon av mina dagar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Låt min fiende stå som den skyldige,","poem":1},{"text":"min motståndare som orättfärdig.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"För vad har den gudlöse för hopp","poem":1},{"text":"när livet skärs av,","poem":2},{"text":"när Gud tar hans själ?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Kommer Gud att höra hans rop","poem":1},{"text":"när nöden drabbar honom?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kan han glädja sig","poem":1},{"text":"över den Allsmäktige?","poem":3},{"text":"Kan han ständigt åkalla Gud?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jag vill lära er om Guds hand,","poem":1},{"text":"den Allsmäktiges tankar","poem":2},{"text":"vill jag inte dölja.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Ni har ju själva alla sett det,","poem":1},{"text":"varför kommer ni då","poem":2},{"text":"med tomt prat?","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Detta är den gudlöses lott hos Gud,","poem":1},{"text":"det arv som våldsverkaren","poem":2},{"text":"får av den Allsmäktige:","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Får han många barn","poem":1},{"text":"ska de falla för svärd,","poem":3},{"text":"hans avkomlingar får inte","poem":2},{"text":"mätta sig med bröd.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"De som undkommer","poem":1},{"text":"läggs i graven av pest","poem":3},{"text":"och deras änkor gråter inte","poem":2},{"text":"över dem.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Även om han samlar silver som stoft","poem":1},{"text":"och lägger kläder på hög","poem":2},{"text":"som lera,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"så får de rättfärdiga klä sig","poem":1},{"text":"i det han har samlat,","poem":3},{"text":"och silvret får de oskyldiga dela.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Han bygger sitt hus som en mal,","poem":1},{"text":"likt en hydda","poem":2},{"noteId":41},{"text":"som väktaren","poem":2},{"text":"gör åt sig.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Rik går han till sängs,","poem":1},{"text":"och sedan aldrig mer –","poem":3},{"text":"när han öppnar sina ögon","poem":2},{"text":"är allt borta.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Fasorna griper honom","poem":1},{"text":"som vattenmassor,","poem":3},{"text":"stormen rycker bort honom i natten.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Östanvinden lyfter honom","poem":1},{"text":"och han är borta,","poem":3},{"text":"den sveper i väg honom","poem":2},{"text":"från hans plats.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Den vräker sig mot honom","poem":1},{"text":"utan förskoning,","poem":3},{"text":"han försöker fly för dess kraft.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Den klappar sina händer","poem":1},{"noteId":42},{"text":"mot honom","poem":1},{"text":"och visslar åt honom","poem":2},{"text":"från hans plats.","poem":3}]}],"footnotes":[{"noteId":41,"caller":"-","text":"hyddaTillfälligt skydd vid åkrarna under skördetiden för den som vaktade sin skörd mot tjuvar.","reference":{"chapter":27,"verse":18}},{"noteId":42,"caller":"-","text":"klappar sina händerKan syfta på en hånfull gest (jfr 34:37, Hes 25:6).","reference":{"chapter":27,"verse":23}}]},"thisChapterLink":"/api/swe_fol/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}