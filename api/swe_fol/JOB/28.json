{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Silvret har sin gruva,",{"text":"guldet en plats där det renas.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Järn hämtas upp ur jorden,","poem":1},{"text":"stenar smälts till koppar.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Människan sätter gränser för mörkret","poem":1},{"text":"och utforskar det yttersta djupet,","poem":3},{"text":"där stenen är natt","poem":2},{"text":"och svartaste skugga.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"De spränger schakt","poem":1},{"text":"långt från människors boningar,","poem":2},{"text":"där ingen har satt sin fot,","poem":3},{"text":"de hänger och svajar","poem":2},{"text":"fjärran från människor.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Från jorden kommer bröd,","poem":1},{"text":"men där nere förvandlas den","poem":2},{"text":"som av eld.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Safiren har sin plats","poem":1},{"text":"bland dess stenar,","poem":3},{"text":"och där finns guldmalm.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Stigen dit är inte känd av örnen,","poem":1},{"text":"falkens öga har inte","poem":2},{"text":"upptäckt den.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Stolta vilddjur har inte trampat den,","poem":1},{"text":"inget lejon har gått fram på den.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"På den hårda stenen","poem":1},{"text":"lägger man sin hand","poem":3},{"text":"och gräver ut bergen från grunden.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"De hugger ut gångar i klipporna,","poem":1},{"text":"och ögat får se härliga ting.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"De stoppar upp vattenådrornas gråt,","poem":1},{"text":"de drar fram dolda skatter i ljuset.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Men visheten, var finns hon?","poem":1},{"text":"Var har förståndet sin boning?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Människan vet inte hennes värde","poem":1},{"noteId":43},{"text":",","poem":1},{"text":"man finner henne inte","poem":2},{"text":"i de levandes land.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Djupet säger: ”Hon är inte i mig”,","poem":1},{"text":"havet säger:","poem":2},{"text":"”Hon finns inte hos mig.”","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Hon kan inte köpas för guld,","poem":1},{"text":"hennes värde kan inte vägas upp","poem":2},{"text":"med silver.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Hon kan inte köpas","poem":1},{"text":"med guld från Ofir","poem":3},{"text":"eller med dyrbar onyx och safir.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Guld och glas","poem":1},{"text":"kan inte jämföras med henne,","poem":3},{"text":"hon kan inte bytas mot guldföremål,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"koraller och kristall ska inte nämnas.","poem":1},{"text":"Att äga vishet är mer värt än pärlor.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Topas från Kush","poem":1},{"text":"kan inte jämföras med henne,","poem":3},{"text":"hon kan inte vägas upp","poem":2},{"text":"med renaste guld.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Men visheten,","poem":1},{"text":"var kommer hon ifrån?","poem":3},{"text":"Var har förståndet sin boning?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hon är gömd för alla levandes ögon,","poem":1},{"text":"hon är dold för himlens fåglar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Avgrunden och döden säger:","poem":1},{"text":"”Endast hennes rykte","poem":2},{"text":"har nått våra öron.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Gud känner vägen till henne,","poem":1},{"text":"han vet var hon bor,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"för han skådar till jordens ändar,","poem":1},{"text":"han ser allt under himlen.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"När han mätte upp vindens vikt","poem":1},{"text":"och vägde vattnen efter mått,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"när han gjorde en lag för regnet","poem":1},{"text":"och en väg för åskans blixt,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"då såg han henne och","poem":1},{"text":"uppenbarade henne,","poem":3},{"text":"han beredde henne","poem":2},{"text":"och utforskade henne.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Och till människorna sade han:","poem":1},{"text":"”Se, att vörda Herren är vishet,","poem":2},{"text":"att fly det onda är förstånd.”","poem":3}]}],"footnotes":[{"noteId":43,"caller":"-","text":"hennes värdeAndra handskrifter (Septuaginta): ”vägen till henne”.","reference":{"chapter":28,"verse":13}}]},"thisChapterLink":"/api/swe_fol/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}