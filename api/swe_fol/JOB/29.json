{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Job fortsatte sin utläggning. Han sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"O, att jag var som i gångna månader,","poem":1},{"text":"som i dagarna då Gud vakade","poem":2},{"text":"över mig,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"då hans lykta sken över mitt huvud","poem":1},{"text":"och jag gick i hans ljus","poem":2},{"text":"genom mörkret,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"då jag var i min krafts dagar,","poem":1},{"text":"då Guds godhet vilade","poem":2},{"text":"över mitt hus,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"då den Allsmäktige","poem":1},{"text":"ännu var med mig","poem":3},{"text":"och mina barn fanns","poem":2},{"text":"runt omkring mig,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"då mina fötter badade i gräddmjölk","poem":1},{"text":"och det rann bäckar av olja","poem":2},{"text":"ur klippan för mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"När jag gick till porten","poem":1},{"noteId":44},{"text":"i staden","poem":1},{"text":"och intog min plats på torget,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"då drog sig de unga undan","poem":1},{"text":"när de såg mig,","poem":3},{"text":"och de gamla reste sig och stod.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Stormännen höll tillbaka sina ord","poem":1},{"text":"och lade handen på munnen.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Furstarnas röst tystnade,","poem":1},{"text":"tungan fastnade vid deras gom.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Varje öra som hörde mig prisade mig,","poem":1},{"text":"varje öga som såg mig","poem":2},{"text":"lovordade mig,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"för jag räddade den fattige","poem":1},{"text":"som ropade","poem":3},{"text":"och den faderlöse","poem":2},{"text":"som ingen hjälpare hade.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Den döende välsignade mig,","poem":1},{"text":"änkans hjärta fick jag att jubla.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jag klädde mig i rättfärdighet","poem":1},{"text":"och den var min klädnad,","poem":3},{"text":"rättvisan var min mantel","poem":2},{"text":"och huvudbonad.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Jag var ögon åt den blinde","poem":1},{"text":"och fötter åt den halte.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jag var en far för de fattiga","poem":1},{"text":"och redde ut den okändes sak.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jag krossade","poem":1},{"text":"den orättfärdiges käkar","poem":3},{"text":"och ryckte rovet från hans tänder.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Jag tänkte då:","poem":1},{"text":"”I mitt eget bo ska jag dö,","poem":2},{"text":"mina dagar blir många","poem":3},{"text":"som sanden.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Min rot sträcker sig till vattnet,","poem":1},{"text":"nattens dagg vilar i mina grenar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Min ära är ständigt ny,","poem":1},{"text":"och min båge förnyas","poem":2},{"noteId":45},{"text":"i min hand.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"De lyssnade på mig och väntade,","poem":1},{"text":"de var tysta inför mitt råd.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Efter mig talade ingen,","poem":1},{"text":"och mina ord vederkvickte dem.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"De väntade på mig som på regn,","poem":1},{"text":"de öppnade sin mun","poem":2},{"text":"som efter vårregn.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Jag log mot dem när de misströstade,","poem":1},{"text":"och de tog emot mitt ansiktes ljus.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jag valde väg åt dem","poem":1},{"text":"och satt som hövding,","poem":3},{"text":"jag tronade som en kung","poem":2},{"text":"bland sina män,","poem":3},{"text":"som en som tröstar de sörjande.","poem":2}]}],"footnotes":[{"noteId":44,"caller":"-","text":"portenDär de äldste möttes och beslutade om samhällets frågor (jfr Rut 4:1, Ords 31:23).","reference":{"chapter":29,"verse":7}},{"noteId":45,"caller":"-","text":"min båge förnyasSymbol för god vigör (jfr 30:11). En gammal båge tappade sin spänst.","reference":{"chapter":29,"verse":20}}]},"thisChapterLink":"/api/swe_fol/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}