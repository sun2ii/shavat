{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Nu skrattar de åt mig,",{"text":"dessa som är yngre än jag,","poem":3},{"text":"medan jag inte hade satt deras fäder","poem":2},{"text":"ens bland mina vallhundar.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Vilken hjälp kunde","poem":1},{"text":"deras händer ge mig,","poem":3},{"text":"de som saknar all livskraft?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"De är utmärglade av nöd och hunger,","poem":1},{"text":"de gnager den torra marken","poem":2},{"text":"som redan förut var öde","poem":3},{"text":"och ödslig.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"De plockar saltörter","poem":1},{"noteId":46},{"text":"bland snåren","poem":1},{"text":"och ginströtter","poem":2},{"noteId":47},{"text":"är deras mat.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"De drivs ut från gemenskapen,","poem":1},{"text":"man ropar efter dem som tjuvar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"De måste bo i otäcka raviner,","poem":1},{"text":"i jordhålor och bergsskrevor.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"De skriker bland snåren,","poem":1},{"text":"de kryper ihop under nässlor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"De är uslingar och ärelösa,","poem":1},{"text":"utjagade ur landet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nu har jag blivit deras nidvisa,","poem":1},{"text":"jag har blivit ett ordspråk","poem":2},{"text":"bland dem.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"De avskyr mig","poem":1},{"text":"och håller sig borta från mig,","poem":3},{"text":"de tvekar inte att spotta mig","poem":2},{"text":"i ansiktet.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Gud har lossat min bågsträng","poem":1},{"text":"och plågat mig,","poem":3},{"text":"därför släpper de sina hämningar","poem":2},{"text":"inför mina ögon.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Vid min högra sida reser sig slöddret,","poem":1},{"text":"de slår undan mina fötter","poem":2},{"text":"och banar sig väg","poem":3},{"text":"för att fördärva mig.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"De river upp min stig,","poem":1},{"text":"de arbetar på mitt fördärv,","poem":2},{"text":"men de får ingen hjälp.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"De bryter fram","poem":1},{"text":"som genom en bred rämna,","poem":3},{"text":"de vältrar sig fram mellan ruinerna.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Fasor väller över mig,","poem":1},{"text":"min ära rycks bort som en storm","poem":3},{"text":"och min räddning har försvunnit","poem":2},{"text":"som ett moln.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nu utgjuter sig min själ inom mig,","poem":1},{"text":"och plågans dagar håller mig fast.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Natten borrar i mina ben,","poem":1},{"text":"den gnagande pinan tar ingen vila.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Med stor kraft griper han min mantel,","poem":1},{"text":"han fattar mig i min livklädnad.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Han har vräkt mig ner i dyn,","poem":1},{"text":"och jag liknar stoft och aska.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Jag ropar till dig,","poem":1},{"text":"men du svarar mig inte.","poem":3},{"text":"Jag reser mig upp,","poem":2},{"text":"men du bara ser på mig.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Du har blivit grym mot mig,","poem":1},{"text":"med din starka hand","poem":2},{"text":"ansätter du mig.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Du lyfter upp mig till vinden","poem":1},{"text":"och för mig bort,","poem":3},{"text":"du skakar mig i stormen.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jag vet att du vill föra mig till döden,","poem":1},{"text":"till den boning där allt levande","poem":2},{"text":"samlas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Men räcker man inte ut handen","poem":1},{"text":"när man faller,","poem":3},{"text":"ropar man inte efter hjälp","poem":2},{"text":"när olyckan kommer?","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Grät jag inte över den","poem":1},{"text":"som hade hårda dagar,","poem":3},{"text":"led inte min själ med den fattige?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Men när jag sökte det goda","poem":1},{"text":"kom det onda,","poem":3},{"text":"när jag väntade på ljus kom mörker.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mitt innersta kokar och får ingen ro,","poem":1},{"text":"dagar av plåga har mött mig.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mörk går jag omkring,","poem":1},{"text":"men inte av solen","poem":3},{"noteId":48},{"text":".","poem":3},{"text":"Jag reser mig bland folket","poem":2},{"text":"och ropar på hjälp.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Jag har blivit en bror till schakalerna,","poem":1},{"text":"en vän till strutsarna","poem":2},{"noteId":49},{"text":".","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Min hud svartnar och faller av mig,","poem":1},{"text":"mina ben brinner av hetta.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mitt harpspel är bytt i sorgelåt,","poem":1},{"text":"mitt flöjtspel i högljudd gråt.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"-","text":"saltörterNämns i Talmud som fattigmanskost och nödmat.","reference":{"chapter":30,"verse":4}},{"noteId":47,"caller":"-","text":"ginströtterOätliga men utmärkta som bränsle (jfr Ps 120:4).","reference":{"chapter":30,"verse":4}},{"noteId":48,"caller":"-","text":"men inte av solenAnnan översättning: ”utan sol”.","reference":{"chapter":30,"verse":28}},{"noteId":49,"caller":"-","text":"strutsarnaAnnan översättning: ”ugglorna”.","reference":{"chapter":30,"verse":29}}]},"thisChapterLink":"/api/swe_fol/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}