{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":31,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Jag slöt ett förbund",{"text":"med mina ögon:","poem":2},{"text":"att aldrig se på en ung kvinna.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Vilken lott skulle jag annars få","poem":1},{"text":"av Gud i höjden,","poem":3},{"text":"vilken del av den Allsmäktige","poem":2},{"text":"där ovan?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ofärd drabbar ju orättfärdiga,","poem":1},{"text":"och olycka ogärningsmän.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ser inte han mina vägar","poem":1},{"text":"och räknar alla mina steg?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Har jag umgåtts med lögn,","poem":1},{"text":"har min fot varit snar till svek?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Låt honom väga mig på en rättvis våg,","poem":1},{"text":"så ska Gud få se att jag är oskyldig.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Har mina steg vikit av ifrån vägen,","poem":1},{"text":"har mitt hjärta följt mina ögon,","poem":3},{"text":"har jag någon fläck på mina händer?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Då får en annan äta vad jag har sått","poem":1},{"text":"och mina plantor ryckas upp","poem":2},{"text":"med roten.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Har mitt hjärta förförts av en kvinna,","poem":1},{"text":"har jag stått på lur","poem":2},{"text":"vid min nästas dörr?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Då får min hustru mala korn","poem":1},{"text":"åt en annan","poem":3},{"text":"och främmande män ligga","poem":2},{"text":"i hennes famn.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Det hade varit","poem":1},{"text":"en skamlig handling,","poem":2},{"text":"en straffbar synd,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"en eld som förtär","poem":1},{"text":"ända till avgrunden","poem":3},{"noteId":50},{"text":"och föröder hela min skörd till roten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Har jag kränkt","poem":1},{"text":"min tjänares eller tjänarinnas rätt","poem":3},{"text":"när de hade någon tvist med mig?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vad skulle jag då göra","poem":1},{"text":"när Gud reser sig?","poem":3},{"text":"När han ställer mig till svars,","poem":2},{"text":"vad skulle jag säga?","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Han som skapade mig i moderlivet","poem":1},{"text":"skapade ju dem också,","poem":3},{"text":"en och samme har berett oss båda","poem":2},{"text":"i modersskötet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Har jag nekat de fattiga vad de önskat","poem":1},{"text":"eller låtit änkans ögon försmäkta?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Har jag ensam ätit mitt bröd","poem":1},{"text":"utan att den faderlöse","poem":2},{"text":"fått äta av det?","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Nej, från min ungdom","poem":1},{"text":"har jag uppfostrat honom","poem":3},{"text":"som en far,","poem":4},{"text":"och från första stund","poem":2},{"text":"har jag tagit mig an änkor.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Har jag sett någon förgås utan kläder,","poem":1},{"text":"eller en fattig utan något","poem":2},{"text":"att skyla sig med?","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Har inte hans hjärta välsignat mig,","poem":1},{"text":"fick han inte värma sig","poem":2},{"text":"i ull från mina lamm?","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Har jag lyft min hand","poem":1},{"text":"mot den faderlöse","poem":3},{"text":"när jag såg mig ha medhåll i porten","poem":2},{"noteId":51},{"text":"?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Då får min axel lossna","poem":1},{"text":"från min skuldra","poem":3},{"text":"och min arm brytas från sin led,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"då skulle jag frukta Guds straff","poem":1},{"text":"och stå maktlös inför hans majestät.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Satte jag mitt hopp till guldet,","poem":1},{"text":"kallade jag rent guld min trygghet?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Gladdes jag över","poem":1},{"text":"att min rikedom växte","poem":3},{"text":"och att min hand samlade","poem":2},{"text":"så mycket?","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Hände det när jag såg","poem":1},{"text":"hur solljuset sken","poem":3},{"text":"och hur månen skred härligt fram,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"att mitt hjärta i hemlighet","poem":1},{"text":"lät sig förföras","poem":3},{"text":"och jag gav dem en handkyss?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Även det hade varit","poem":1},{"text":"en straffbar synd,","poem":3},{"text":"för då hade jag förnekat","poem":2},{"text":"Gud i höjden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Har jag glatt mig","poem":1},{"text":"åt min fiendes olycka,","poem":3},{"text":"fröjdat mig","poem":2},{"text":"när olyckan drabbade honom?","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Nej, jag lät inte min mun synda","poem":1},{"text":"genom att begära hans liv","poem":2},{"text":"med en förbannelse.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Mitt husfolk kan vittna:","poem":1},{"text":"”Alla fick mätta sig","poem":2},{"text":"med kött vid hans bord.”","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Främlingen behövde inte","poem":1},{"text":"övernatta på gatan,","poem":3},{"text":"jag öppnade mina dörrar mot vägen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Har jag dolt mina brott som Adam","poem":1},{"text":"och gömt min skuld inom mig,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"av fruktan för allt folket","poem":1},{"text":"och rädsla för fränders förakt,","poem":3},{"text":"så att jag teg","poem":2},{"text":"och inte gick utanför dörren?","poem":3}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"O, att jag hade någon","poem":1},{"text":"som lyssnade på mig!","poem":3},{"text":"Se, här är min underskrift","poem":2},{"noteId":52},{"text":".","poem":2},{"text":"Må den Allsmäktige svara mig.","poem":3},{"text":"Låt mig se min motparts","poem":2},{"text":"anklagelseskrift!","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Sannerligen, jag skulle bära den","poem":1},{"text":"på min skuldra,","poem":3},{"text":"jag skulle fästa den som min krona.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Jag skulle redovisa alla mina steg","poem":1},{"text":"för honom,","poem":3},{"text":"möta honom som en furste.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Har min mark ropat över mig,","poem":1},{"text":"har dess fåror gråtit med varandra?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Har jag ätit dess frukt","poem":1},{"text":"utan att betala","poem":3},{"text":"eller sugit ut dem","poem":2},{"text":"som brukade jorden?","poem":3}]},{"type":"verse","number":40,"content":[{"text":"Då får törne växa i stället för vete,","poem":1},{"text":"ogräs i stället för korn.","poem":2},{"lineBreak":true},"Slut på Jobs tal."]}],"footnotes":[{"noteId":50,"caller":"-","text":"avgrundenHebr. Abaddón(jfr Upp 9:11). Annan översättning: ”fördärvet”.","reference":{"chapter":31,"verse":12}},{"noteId":51,"caller":"-","text":"medhåll i portenI en process om den rättslöses egendom.","reference":{"chapter":31,"verse":21}},{"noteId":52,"caller":"-","text":"underskriftHebr. taw, hebreisk bokstav som under GT:s tid skrevs som ett kors (jfr Hes 9:4).","reference":{"chapter":31,"verse":35}}]},"thisChapterLink":"/api/swe_fol/JOB/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}