{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["Elihus tal (Kap 32-37)"]},{"type":"verse","number":1,"content":["De tre männen slutade nu svara Job, eftersom han var rättfärdig i sina egna ögon."]},{"type":"verse","number":2,"content":["Men Elihu,",{"noteId":53},"Barakels son från Bus",{"noteId":54},", av Rams släkt, blev upprörd. Han blev upprörd mot Job för att denne menade sig ha rätt mot Gud,"]},{"type":"verse","number":3,"content":["och han blev upprörd mot Jobs tre vänner för att de inte fann något svar och ändå dömde Job skyldig."]},{"type":"verse","number":4,"content":["Elihu hade väntat med att tala till Job eftersom de andra var äldre än han."]},{"type":"verse","number":5,"content":["Men när Elihu insåg att de tre männen inte hade något mer att säga blev han upprörd."]},{"type":"verse","number":6,"content":["Då tog Elihu, Barakels son, från Bus till orda. Han sade:",{"lineBreak":true},{"text":"Jag är ung till åldern,","poem":1},{"text":"och ni är gamla.","poem":3},{"text":"Därför var jag rädd och vågade inte","poem":2},{"text":"lägga fram min mening för er.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Jag tänkte: ”Åldern ska tala","poem":1},{"text":"och de många åren","poem":2},{"text":"förkunna vishet.”","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Men det beror på anden","poem":1},{"text":"i människan,","poem":3},{"text":"den Allsmäktiges livsfläkt","poem":2},{"text":"ger henne förstånd.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Det är inte åldern som ger vishet","poem":1},{"text":"eller bara gamla som förstår","poem":2},{"text":"vad som är rätt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Därför säger jag: Lyssna på mig!","poem":1},{"text":"Också jag vill lägga fram","poem":2},{"text":"min mening.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Se, jag väntade på era ord,","poem":1},{"text":"jag lyssnade efter era insikter","poem":3},{"text":"när ni sökte finna de rätta orden.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jag lyssnade uppmärksamt på er,","poem":1},{"text":"men se,","poem":3},{"text":"ingen kunde motbevisa Job,","poem":2},{"text":"ingen kunde ge honom","poem":3},{"text":"svar på tal.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Svara nu inte: ”Vi möttes av vishet.","poem":1},{"text":"Gud kan besegra honom,","poem":2},{"text":"inte människor.”","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Hans ord var inte riktade mot mig,","poem":1},{"text":"och jag ska inte bemöta honom","poem":2},{"text":"med era argument.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"De är bestörta och svarar inte mer,","poem":1},{"text":"de har tappat talförmågan.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Skulle jag vänta","poem":1},{"text":"när de inget säger,","poem":3},{"text":"när de står där utan svar?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Också jag vill ta till orda,","poem":1},{"text":"också jag vill säga min mening,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"för jag är uppfylld av ord,","poem":1},{"text":"anden inom mig tvingar mig.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Se, mitt inre är som instängt vin","poem":1},{"noteId":55},{"text":",","poem":1},{"text":"som en ny vinlägel nära att brista.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Därför måste jag tala och få lättnad,","poem":1},{"text":"jag vill öppna mina läppar","poem":2},{"text":"och svara.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Jag ska inte vara partisk mot någon","poem":1},{"text":"och inte smickra någon människa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Smicker vill jag inte veta av,","poem":1},{"text":"annars kunde min skapare","poem":2},{"text":"strax rycka bort mig.","poem":3}]}],"footnotes":[{"noteId":53,"caller":"-","text":"ElihuBetyder ”han är min Gud”.","reference":{"chapter":32,"verse":2}},{"noteId":54,"caller":"-","text":"BusArabiskt stamområde (jfr 1 Mos 22:21, Jer 25:23).","reference":{"chapter":32,"verse":2}},{"noteId":55,"caller":"-","text":"instängt vinJäsande vin expanderar och kan spränga sitt kärl (jfr Matt 9:17 med not).","reference":{"chapter":32,"verse":19}}]},"thisChapterLink":"/api/swe_fol/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}