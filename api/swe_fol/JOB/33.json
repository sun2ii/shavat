{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Men Job, hör nu mina ord,",{"text":"lyssna till allt jag har att säga!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Se, jag öppnar nu mina läppar,","poem":1},{"text":"min tunga talar i min mun.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mina ord kommer","poem":1},{"text":"från ett uppriktigt hjärta,","poem":3},{"text":"det jag förstår ska jag ärligt säga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Guds Ande har gjort mig,","poem":1},{"text":"den Allsmäktiges livsande","poem":2},{"text":"ger mig liv.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Svara mig om du kan,","poem":1},{"text":"träd fram inför mig,","poem":2},{"text":"gör dig redo.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Se, inför Gud är vi båda lika,","poem":1},{"text":"också jag är formad av lera.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Se, rädsla för mig","poem":1},{"text":"behöver inte skrämma dig,","poem":3},{"text":"och min myndighet","poem":2},{"text":"ska inte trycka ner dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Men du sade inför mina öron,","poem":1},{"text":"så lydde orden jag hörde:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"”Jag är ren och utan synd,","poem":1},{"text":"jag är fläckfri och utan skuld.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Men se, han vill ansätta mig,","poem":1},{"text":"han räknar mig som sin fiende.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Han sätter mina fötter i stocken,","poem":1},{"text":"han vaktar på alla mina vägar.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Där har du inte rätt, svarar jag dig,","poem":1},{"text":"för Gud är större än en människa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hur kan du förebrå honom","poem":1},{"text":"att han inte ger ett enda ord till svar","poem":2},{"noteId":56},{"text":"?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gud talar både en och två gånger,","poem":1},{"text":"utan att man bryr sig om det.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I drömmen, i en syn om natten,","poem":1},{"text":"när sömnen fallit tung","poem":2},{"text":"över människorna","poem":3},{"text":"och de slumrar i sin bädd,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"då öppnar han människornas öron","poem":1},{"text":"och bekräftar","poem":2},{"noteId":57},{"text":"deras tuktan","poem":2}]},{"type":"verse","number":17,"content":[{"text":"för att hindra människan","poem":1},{"text":"från en ogärning","poem":3},{"text":"och hålla henne borta från högmod.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Han bevarar hennes själ från graven","poem":1},{"text":"och hennes liv","poem":2},{"text":"från att falla för svärd.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Hon tuktas med plågor","poem":1},{"text":"på sin sjukbädd","poem":3},{"text":"och med ständiga smärtor i benen.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hennes sinne äcklas av mat,","poem":1},{"text":"hennes själ vid den föda","poem":2},{"text":"hon älskade.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Hennes kött tärs bort","poem":1},{"text":"tills inget finns kvar,","poem":3},{"text":"hennes ben blottas","poem":2},{"text":"som förr inte syntes.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Hennes själ närmar sig graven,","poem":1},{"text":"hennes liv dödens makter.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Om det finns en ängel hos henne,","poem":1},{"text":"en medlare, en av tusen,","poem":3},{"text":"som förkunnar för människan","poem":2},{"text":"vad som är rätt,","poem":3}]},{"type":"verse","number":24,"content":[{"text":"då förbarmar sig Gud över henne","poem":1},{"text":"och säger:","poem":3},{"text":"”Rädda henne","poem":2},{"text":"från att fara ner i graven,","poem":3},{"text":"jag har funnit lösen för henne.”","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Då får hennes kropp","poem":1},{"text":"ny ungdomskraft,","poem":3},{"text":"hon blir på nytt","poem":2},{"text":"som i sin ungdoms dagar.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Hon ber till Gud","poem":1},{"text":"och han har behag till henne,","poem":3},{"text":"hon får se hans ansikte med jubel.","poem":2},{"text":"Och Gud återger människan","poem":3},{"text":"hennes rättfärdighet.","poem":4}]},{"type":"verse","number":27,"content":[{"text":"Hon ska sjunga inför människorna:","poem":1},{"text":"”Jag syndade","poem":2},{"text":"och förvrängde det rätta,","poem":3},{"text":"men jag fick inte vad jag förtjänade.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Han friköpte min själ","poem":1},{"text":"från att hamna i fördärvet,","poem":3},{"text":"och mitt liv ska se ljuset.”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Se, allt detta gör Gud","poem":1},{"text":"med en människa,","poem":3},{"text":"både två och tre gånger,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"för att återföra hennes själ","poem":1},{"text":"från graven","poem":3},{"text":"och låta livets ljus stråla över henne.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ge akt, Job, och lyssna på mig!","poem":1},{"text":"Var stilla, så att jag får tala.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Men har du något att säga,","poem":1},{"text":"så svara mig, tala,","poem":3},{"text":"för jag vill gärna ge dig rätt.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Om inte, lyssna då till mig.","poem":1},{"text":"Var stilla, jag ska lära dig vishet.","poem":2}]}],"footnotes":[{"noteId":56,"caller":"-","text":"ger ett enda ord till svarAnnan översättning: ”ger för sin sak”.","reference":{"chapter":33,"verse":13}},{"noteId":57,"caller":"-","text":"bekräftarAndra handskrifter (Septuaginta): ”skrämmer dem med”.","reference":{"chapter":33,"verse":16}}]},"thisChapterLink":"/api/swe_fol/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}