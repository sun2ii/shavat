{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Elihu fortsatte. Han sade:"]},{"type":"verse","number":2,"content":[{"text":"Hör mina ord, ni som är visa,","poem":1},{"text":"lyssna till mig, ni som vet,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"för örat prövar orden","poem":1},{"text":"liksom gommen prövar smaken.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Låt oss avgöra vad som är rätt,","poem":1},{"text":"tillsammans förstå","poem":2},{"text":"vad som är gott,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"för Job har sagt: ”Jag är rättfärdig,","poem":1},{"text":"men Gud har berövat mig","poem":2},{"text":"min rätt.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Trots att jag har rätt","poem":1},{"text":"står jag som lögnare.","poem":3},{"text":"Jag är dödsskjuten","poem":2},{"text":"fast jag är utan skuld.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Finns en man som Job,","poem":1},{"text":"som dricker hån som vatten,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"som slår följe med ogärningsmän","poem":1},{"text":"och vandrar","poem":2},{"text":"med gudlösa människor?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Han säger ju:","poem":1},{"text":"”Det hjälper inte en människa","poem":2},{"text":"att hålla sig väl med Gud.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lyssna därför på mig,","poem":1},{"text":"ni förståndiga män!","poem":3},{"text":"Skulle Gud göra orätt,","poem":2},{"text":"den Allsmäktige något","poem":3},{"text":"orättfärdigt?","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Nej, han ger åt människan","poem":1},{"text":"efter hennes gärningar","poem":3},{"text":"och låter var och en få","poem":2},{"text":"efter sin väg.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Gud gör sannerligen inget orätt,","poem":1},{"text":"den Allsmäktige","poem":2},{"text":"förvränger inte rätten.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Vem satte honom","poem":1},{"text":"att ta hand om jorden,","poem":3},{"text":"vem lade hela världen på honom?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Om han bara tänkte på sig själv","poem":1},{"text":"och tog tillbaka sin ande,","poem":2},{"text":"sin livsfläkt,","poem":3}]},{"type":"verse","number":15,"content":[{"text":"då skulle allt levande förgås","poem":1},{"text":"och människorna vända åter","poem":2},{"text":"till stoft.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Har du insikt, så hör detta,","poem":1},{"text":"lyssna till vad jag säger.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ska den härska som hatar rättvisa?","poem":1},{"text":"Eller fördömer du","poem":2},{"text":"den störste i rättfärdighet,","poem":3}]},{"type":"verse","number":18,"content":[{"text":"han som säger ”Skurk!” till en kung","poem":1},{"text":"och ”Skyldig!” till furstar,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"han som inte är partisk för furstar","poem":1},{"text":"och inte aktar den rike","poem":2},{"text":"mer än den fattige,","poem":3},{"text":"eftersom de alla är","poem":2},{"text":"hans händers verk?","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"De dör plötsligt, mitt i natten.","poem":1},{"text":"Folk bävar och förgås,","poem":3},{"text":"de mäktiga rycks bort","poem":2},{"text":"men inte genom människohand,","poem":3}]},{"type":"verse","number":21,"content":[{"text":"för Guds ögon följer var mans vägar","poem":1},{"text":"och ser alla hans steg.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Det finns inget mörker","poem":1},{"text":"och ingen djup skugga","poem":3},{"text":"där ogärningsmän kan gömma sig.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Gud behöver inte betrakta","poem":1},{"text":"en människa länge","poem":3},{"text":"innan hon kan ställas till doms","poem":2},{"text":"inför honom.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Han krossar mäktiga män","poem":1},{"text":"utan rannsakan","poem":3},{"text":"och insätter andra i deras ställe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ja, han känner deras gärningar,","poem":1},{"text":"han störtar dem om natten","poem":2},{"text":"och de krossas.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Han straffar dem som förbrytare,","poem":1},{"text":"öppet, där människor ser det,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"eftersom de vek av ifrån honom","poem":1},{"text":"och inte gav akt","poem":2},{"text":"på alla hans vägar.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Det fick de fattiga","poem":1},{"text":"att ropa till honom,","poem":3},{"text":"och han hörde","poem":2},{"text":"de nödställdas klagan.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"När han är tyst,","poem":1},{"text":"vem kan då fördöma?","poem":3},{"text":"När han döljer sitt ansikte,","poem":2},{"text":"vem kan då se honom,","poem":3},{"text":"vare sig ett folk","poem":2},{"text":"eller en enskild människa?","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Han låter inga gudlösa regera","poem":1},{"text":"eller bli snaror för folket.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Har någon sagt till Gud:","poem":1},{"text":"”Jag tar mitt straff,","poem":2},{"text":"jag vill inte synda mer.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Lär mig du vad jag inte ser.","poem":1},{"text":"Har jag gjort orätt","poem":2},{"text":"vill jag inte göra så mer.”","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Ska Gud löna dig","poem":1},{"text":"efter din önskan,","poem":3},{"text":"du som har förkastat honom?","poem":2},{"text":"Du måste välja, inte jag.","poem":3},{"text":"Säg vad du menar!","poem":4}]},{"type":"verse","number":34,"content":[{"text":"Kloka män kommer att säga,","poem":1},{"text":"visa män som lyssnar till mig:","poem":2}]},{"type":"verse","number":35,"content":[{"text":"”Job talar utan insikt,","poem":1},{"text":"hans ord är utan vishet.”","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Låt Job prövas till det yttersta,","poem":1},{"text":"för han försvarar sig","poem":2},{"text":"som ogärningsmän.","poem":3}]},{"type":"verse","number":37,"content":[{"text":"Han lägger uppror till sin synd,","poem":1},{"text":"han klappar händerna mot oss","poem":2},{"text":"och hopar sina ord mot Gud.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}