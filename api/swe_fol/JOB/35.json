{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Elihu fortsatte. Han sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tycker du det är rätt att säga:","poem":1},{"text":"”Min rättfärdighet","poem":2},{"text":"är större än Guds”,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"eftersom du säger:","poem":1},{"text":"”Vad hjälper den mig?","poem":3},{"text":"Har jag mer nytta av den","poem":2},{"text":"än av min synd?”","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag ska svara dig och dina vänner.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Blicka upp mot himlen och se,","poem":1},{"text":"lägg märke till skyarna","poem":2},{"text":"högt över dig.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Om du syndar,","poem":1},{"text":"vad gör du då mot honom?","poem":3},{"text":"Om dina brott är många,","poem":2},{"text":"vad skadar det honom?","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Om du är rättfärdig,","poem":1},{"text":"vad ger du honom,","poem":2},{"text":"vad får han från din hand?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Din ondska påverkar människor","poem":1},{"text":"som är lika dig,","poem":3},{"text":"och din rättfärdighet människobarn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Man klagar över allt förtryck,","poem":1},{"text":"man ropar om hjälp","poem":2},{"text":"mot de mäktigas arm.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Men ingen frågar:","poem":1},{"text":"”Var är Gud som har skapat mig,","poem":3},{"text":"han som låter lovsånger","poem":2},{"text":"ljuda","poem":3},{"noteId":58},{"text":"i natten,","poem":3}]},{"type":"verse","number":11,"content":[{"text":"han som ger oss","poem":1},{"text":"mer kunskap än jordens djur","poem":3},{"text":"och mer vishet än","poem":2},{"noteId":59},{"text":"himlens fåglar?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Man ropar, men han svarar inte","poem":1},{"text":"på grund av de ondas högmod.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nej, Gud hör inte på tomma böner,","poem":1},{"text":"den Allsmäktige bryr sig inte","poem":2},{"text":"om det.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Även när du säger","poem":1},{"text":"att du inte ser honom","poem":3},{"text":"ligger din sak inför honom,","poem":2},{"text":"och du bör vänta på honom.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Men nu när han inte straffar i vrede","poem":1},{"text":"och inte bryr sig så mycket","poem":2},{"text":"om synden,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"spärrar Job upp sin mun","poem":1},{"text":"till tomma ord,","poem":3},{"text":"han hopar ord utan insikt.","poem":2}]}],"footnotes":[{"noteId":58,"caller":"-","text":"låter lovsånger ljudaAnnan översättning: ”ger styrka”.","reference":{"chapter":35,"verse":10}},{"noteId":59,"caller":"-","text":"mer kunskap än … mer vishet änAnnan översättning: ”kunskap genom … vishet genom”.","reference":{"chapter":35,"verse":11}}]},"thisChapterLink":"/api/swe_fol/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}