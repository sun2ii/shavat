{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Elihu fortsatte. Han sade:"]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ha lite tålamod,","poem":1},{"text":"jag har mer att säga till Guds försvar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jag vill hämta min insikt från fjärran","poem":1},{"text":"och hävda min skapares","poem":2},{"text":"rättfärdighet.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mina ord är sannerligen inte falska,","poem":1},{"text":"en som har full insikt är med dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Se, Gud är väldig och förkastar ingen,","poem":1},{"text":"han är väldig i sitt förstånds kraft.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Den gudlöse låter han inte leva,","poem":1},{"text":"men de nödställda skaffar han rätt.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Han tar inte sina ögon","poem":1},{"text":"från de rättfärdiga.","poem":3},{"text":"Han låter dem trona i kungars krets,","poem":2},{"text":"upphöjda för evigt.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Men läggs de bundna i kedjor","poem":1},{"text":"och fångas i eländets snaror,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"så vill han visa dem vad de har gjort","poem":1},{"text":"och vilka brott de i trots","poem":2},{"text":"har begått.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Han öppnar deras öra för tuktan","poem":1},{"text":"och manar dem att vända om","poem":2},{"text":"från synden.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Om de lyssnar och tjänar honom,","poem":1},{"text":"får de framleva sina dagar i lycka","poem":2},{"text":"och sina år i ljuvlig ro.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Men om de inte lyssnar,","poem":1},{"text":"ska de drabbas av svärdet","poem":2},{"text":"och gå under i sitt oförstånd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"De som har gudlösa hjärtan","poem":1},{"text":"tar till vrede,","poem":3},{"text":"de ropar inte på hjälp","poem":2},{"text":"när han binder dem.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"De ska dö i sin ungdom","poem":1},{"text":"och sluta sitt liv bland horkarlar","poem":2},{"noteId":60},{"text":"i avgudatempel.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Genom lidandet vill han rädda","poem":1},{"text":"den som lider","poem":3},{"text":"och genom nöden öppna hans öra.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Också dig vill han locka","poem":1},{"text":"ut ur nödens gap","poem":3},{"text":"till en rymlig plats utan betryck","poem":2},{"text":"och duka ditt bord","poem":3},{"text":"med utsökta rätter.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Men du är fylld","poem":1},{"text":"av ogudaktighetens dom,","poem":3},{"text":"dom och rättvisa håller dig fast.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Låt inte vreden locka dig att håna,","poem":1},{"noteId":61},{"text":"och låt inte en stor lösensumma","poem":2},{"text":"förleda dig.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Kan ditt rop","poem":1},{"text":"och alla kraftansträngningar","poem":3},{"text":"frita dig från nöd?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Längta inte efter den natt","poem":1},{"text":"då folken ska ryckas från sin plats.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Akta dig, vänd dig inte till ondskan,","poem":1},{"text":"som du valt i stället för lidande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Se, Gud är upphöjd i sin kraft.","poem":1},{"text":"Var finns en lärare som han?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Vem har anvisat honom hans väg,","poem":1},{"text":"och vem kan säga:","poem":2},{"text":"”Du har gjort orätt”?","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Kom ihåg att upphöja hans verk","poem":1},{"text":"som människorna besjunger,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"som alla människor ser,","poem":1},{"text":"som de betraktar om än i fjärran.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Se, Gud är för hög för vårt förstånd,","poem":1},{"text":"hans år är fler än någon kan utforska.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Vattnets droppar drar han uppåt,","poem":1},{"text":"de strilar som regn från dimman.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Det strömmar från skyarna","poem":1},{"text":"och droppar i mängd","poem":2},{"text":"över människor.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Kan någon förstå","poem":1},{"text":"hur molnen breder ut sig,","poem":3},{"text":"förstå dundret från hans hydda?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Se, han sprider sina blixtars ljus","poem":1},{"text":"omkring sig","poem":3},{"text":"och döljer havets djup.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Genom dem dömer han folken,","poem":1},{"text":"men ger också mat i överflöd.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Han höljer sina händer i blixtars ljus","poem":1},{"text":"och befaller dem att träffa sitt mål.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hans dunder bär bud om honom,","poem":1},{"text":"även boskapen vet vad som väntar.","poem":2},{"noteId":62}]}],"footnotes":[{"noteId":60,"caller":"-","text":"horkarlar i avgudatempelManliga tempelprostituerade (jfr 1 Kung 14:24, 2 Kung 23:7).","reference":{"chapter":36,"verse":14}},{"noteId":61,"caller":"-","text":"att hånaAnnan översättning: ”när du tuktas”.","reference":{"chapter":36,"verse":18}},{"noteId":62,"caller":"-","text":"även boskapen vet vad som väntarAnnan översättning: ”den som ivrar mot det onda”.","reference":{"chapter":36,"verse":33}}]},"thisChapterLink":"/api/swe_fol/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}