{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Inför sådant bävar mitt hjärta",{"text":"och slår häftigt i mitt bröst.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lyssna noga","poem":1},{"text":"till dundret från hans röst,","poem":3},{"text":"till mullret som går ut","poem":2},{"text":"från hans mun.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Han sänder ut det över hela himlen,","poem":1},{"text":"sina blixtar till jordens ändar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Efteråt ryter dånet,","poem":1},{"text":"han dundrar","poem":2},{"text":"med sin väldiga röst,","poem":3},{"text":"han spar inte på blixtarna","poem":2},{"text":"när han låter sin röst höras.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Gud dundrar underbart med sin röst,","poem":1},{"text":"han gör stora och ofattbara ting.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Snön befaller han:","poem":1},{"text":"”Fall över jorden!”,","poem":3},{"text":"och regnet:","poem":2},{"text":"”Kraftiga skurar av regn!”","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han binder","poem":1},{"noteId":63},{"text":"alla människors händer","poem":1},{"text":"så att alla lär känna hans gärningar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vilddjuren drar sig in i sina gömslen,","poem":1},{"text":"de blir kvar i sina hålor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Stormen kommer från sin kammare,","poem":1},{"text":"kölden kommer med","poem":2},{"text":"nordanvinden.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Gud sänder frost","poem":1},{"text":"med sin andedräkt,","poem":3},{"text":"och de vida vattnen fryser till.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Han lastar skyarna med väta","poem":1},{"text":"och sprider sina åskmoln","poem":2},{"text":"vida omkring.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"De far runt åt alla håll","poem":1},{"text":"efter hans styrning","poem":3},{"text":"och utför allt han befaller dem","poem":2},{"text":"över hela jordens yta.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Han låter dem komma som straff,","poem":1},{"text":"för att hjälpa hans land","poem":2},{"text":"eller visa hans godhet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lyssna till detta, Job,","poem":1},{"text":"stanna och tänk på Guds under!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Förstår du hur Gud styr dem","poem":1},{"text":"och låter blixten lysa fram","poem":2},{"text":"från sitt moln?","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Förstår du lagen för skyarnas jämvikt,","poem":1},{"text":"den Allvises underverk,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"hur dina kläder blir heta","poem":1},{"text":"när jorden blir stilla","poem":2},{"text":"under sunnanvinden?","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Kan du, med honom,","poem":1},{"text":"breda ut skyarna som ett valv,","poem":3},{"text":"fasta som en spegel av gjuten metall?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lär oss vad vi ska säga till honom,","poem":1},{"text":"i vårt mörker har vi inget","poem":2},{"text":"att lägga fram.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Ska det kungöras för honom","poem":1},{"text":"att jag vill tala?","poem":3},{"text":"Ingen ber väl om att bli slukad?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ingen kan väl se på ljuset","poem":1},{"text":"som strålar i skyarna","poem":3},{"text":"när vinden har gått fram","poem":2},{"text":"och skingrat dem?","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Från norr","poem":1},{"noteId":64},{"text":"kommer en glans av guld,","poem":1},{"text":"ett skrämmande majestät","poem":2},{"text":"omger Gud.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Den Allsmäktige kan vi inte finna,","poem":1},{"text":"han är upphöjd i kraft och dom.","poem":3},{"text":"Han kan inte kränka","poem":2},{"text":"sin stora rättfärdighet.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Därför fruktar människorna honom.","poem":1},{"text":"Han bryr sig inte om dem","poem":2},{"text":"som tycker sig vara visa.","poem":3}]}],"footnotes":[{"noteId":63,"caller":"-","text":"binderOrdagrant: ”förseglar” (så att ingen kan arbeta).","reference":{"chapter":37,"verse":7}},{"noteId":64,"caller":"-","text":"Från norrVäderstrecket förknippas med Guds boning (jfr Ps 48:13 med not).","reference":{"chapter":37,"verse":22}}]},"thisChapterLink":"/api/swe_fol/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}