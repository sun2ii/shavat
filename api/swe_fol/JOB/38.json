{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["Herren svarar Job (Kap 38-39:35)"]},{"type":"verse","number":1,"content":["Herren svarade Job ur stormvinden. Han sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Vem är den som fördunklar mitt råd","poem":1},{"text":"med ord utan förstånd?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Spänn bältet om livet som en man.","poem":1},{"text":"Jag ska fråga dig,","poem":2},{"text":"och du ska ge mig besked.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Var var du","poem":1},{"text":"när jag lade jordens grund?","poem":3},{"text":"Svara, om du vet och förstår.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vem bestämde dess mått?","poem":1},{"text":"Du vet ju!","poem":3},{"text":"Och vem spände mätsnöret","poem":2},{"text":"över den?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Var fick dess grundpelare fäste?","poem":1},{"text":"Vem lade dess hörnsten,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"medan morgonstjärnorna","poem":1},{"text":"sjöng tillsammans","poem":3},{"text":"och alla Guds söner ropade","poem":2},{"text":"av glädje?","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Vem satte dörrar för havet","poem":1},{"text":"när det bröt fram ur moderlivet,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"när jag gav det moln till kläder","poem":1},{"text":"och dimman till linda,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"när jag bestämde dess gräns","poem":1},{"text":"och satte bom och dörrar","poem":2}]},{"type":"verse","number":11,"content":[{"text":"och sade: ”Hit men inte längre,","poem":1},{"text":"här ska dina stolta vågor","poem":2},{"text":"lägga sig”?","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Har du under dina dagar","poem":1},{"text":"befallt dagen att gry","poem":3},{"text":"och visat gryningen dess plats","poem":2}]},{"type":"verse","number":13,"content":[{"text":"där den kan gripa jorden i dess hörn","poem":1},{"text":"så att de gudlösa skakas bort","poem":2},{"text":"från den?","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Då ändrar jorden form","poem":1},{"text":"som leran under sigillet,","poem":3},{"text":"och allt träder fram som i ny dräkt.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Då mister de gudlösa sitt ljus,","poem":1},{"text":"och den höjda armen bryts av.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Har du stigit ner till havets källor","poem":1},{"text":"och vandrat på djupets botten?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Har dödens portar visat sig för dig,","poem":1},{"text":"har du sett dödsskuggans portar?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Har du sett ut över","poem":1},{"noteId":65},{"text":"jordens vidder?","poem":1},{"text":"Berätta, om du förstår allt detta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Var går vägen dit där ljuset bor,","poem":1},{"text":"och var har mörkret sin boning,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"så att du kan föra det till dess gräns","poem":1},{"text":"och finna stigarna till dess hus?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Du vet det, du var ju född då,","poem":1},{"text":"och dina dagars tal är stort!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Har du varit vid snöns förråd,","poem":1},{"text":"har du sett haglets förråd","poem":2}]},{"type":"verse","number":23,"content":[{"text":"som jag sparar till nödens tid,","poem":1},{"text":"till krigets och drabbningens dag?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Var går vägen dit där ljuset","poem":1},{"noteId":66},{"text":"delar sig,","poem":1},{"text":"där östanvinden breder ut sig","poem":2},{"text":"över jorden?","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Vem öppnar rännor för regnflödet","poem":1},{"text":"och banar väg för åskans blixt,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"för att sända regn","poem":1},{"text":"över folktomma trakter,","poem":3},{"text":"öknar där ingen människa finns,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"för att mätta ödsliga ödemarker","poem":1},{"text":"och ge växt åt gräsets brodd?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Har regnet någon far?","poem":1},{"text":"Vem födde daggens droppar?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Från vilket sköte kom isen?","poem":1},{"text":"Och vem födde himlens rimfrost?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Vattnet blir hårt som sten,","poem":1},{"text":"djupets yta fryser till is.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kan du knyta samman","poem":1},{"text":"Sjustjärnornas knippe","poem":3},{"text":"eller lossa Orions band?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kan du föra fram himlens tecken","poem":1},{"text":"i rätt tid","poem":3},{"text":"och leda Björnen","poem":2},{"noteId":67},{"text":"och dess ungar?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Förstår du himlens lagar,","poem":1},{"text":"ordnar du dess välde över jorden?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kan du höja din röst till molnen","poem":1},{"text":"och få vattenflöden att täcka dig?","poem":3}]},{"type":"verse","number":35,"content":[{"text":"Kan du sända ut blixtarna","poem":1},{"text":"så att de går ut","poem":3},{"text":"och säger till dig: ”Här är vi”?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Vem har lagt vishet i det fördolda,","poem":1},{"text":"och vem gav förstånd","poem":2},{"text":"åt luftens tecken?","poem":3},{"noteId":68}]},{"type":"verse","number":37,"content":[{"text":"Vem har vishet att räkna skyarna?","poem":1},{"text":"Och vem tömmer ut","poem":2},{"text":"himlens vattenkärl","poem":3}]},{"type":"verse","number":38,"content":[{"text":"när myllan är hård och fast","poem":1},{"text":"och jordkokorna klibbat samman?","poem":2}]}],"footnotes":[{"noteId":65,"caller":"-","text":"sett ut överAnnan översättning: ”fatta”.","reference":{"chapter":38,"verse":18}},{"noteId":66,"caller":"-","text":"ljusetAnnan översättning: ”blixten”.","reference":{"chapter":38,"verse":24}},{"noteId":67,"caller":"-","text":"BjörnenDvs Stora Björn med Karlavagnen. Annan översättning: ”Lejonet”.","reference":{"chapter":38,"verse":32}},{"noteId":68,"caller":"-","text":"det fördolda … luftens teckenAnnan översättning: ”det inre … hjärtat” eller ”hägern … tuppen”.","reference":{"chapter":38,"verse":36}}]},"thisChapterLink":"/api/swe_fol/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":38}