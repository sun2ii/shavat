{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Jagar du byte",{"text":"åt lejonhonan?","poem":3},{"text":"Stillar du","poem":2},{"text":"de unga lejonens hunger","poem":3}]},{"type":"verse","number":2,"content":[{"text":"när de kryper ihop i sina hålor","poem":1},{"text":"eller ligger på lur i snåret?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vem skaffar mat åt korpen,","poem":1},{"text":"när hans ungar ropar till Gud","poem":2},{"text":"och flaxar omkring utan föda?","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vet du när stengetterna ska föda,","poem":1},{"text":"vakar du över när hindarna","poem":2},{"text":"ska kalva?","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Räknar du månaderna","poem":1},{"text":"de går dräktiga,","poem":3},{"text":"vet du tiden när de ska föda?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"De böjer sig ner och föder sina foster","poem":1},{"text":"och blir fria från sina värkar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deras ungar blir starka","poem":1},{"text":"och växer upp i det fria,","poem":3},{"text":"de springer sin väg","poem":2},{"text":"och vänder inte tillbaka.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Vem släppte vildåsnan fri,","poem":1},{"text":"vem lossade hennes band?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jag gav henne stäppen till hem,","poem":1},{"text":"saltöknen till sin boning.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hon ler åt bullret i staden","poem":1},{"text":"och hör ingen pådrivares rop.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hon söker sitt bete på bergen","poem":1},{"text":"och letar efter allt som är grönt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Har vildoxen lust att tjäna dig","poem":1},{"text":"och stanna vid din krubba","poem":2},{"text":"över natten?","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Kan du tvinga vildoxen","poem":1},{"text":"att gå i fåran med töm","poem":3},{"text":"och harva markerna efter dig?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kan du lita på hans stora styrka","poem":1},{"text":"och anförtro ditt arbete åt honom?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Litar du på att han för hem din säd","poem":1},{"text":"och samlar den vid din tröskplats?","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Strutshonans","poem":1},{"noteId":69},{"text":"vingar","poem":1},{"text":"flaxar med fröjd,","poem":3},{"text":"men visar hennes vingar och fjädrar","poem":2},{"text":"ömhet?","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Hon lämnar sina ägg på marken","poem":1},{"text":"och låter dem värmas i sanden,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"hon glömmer att en fot","poem":1},{"text":"kan krossa dem,","poem":3},{"text":"att vilda djur kan trampa på dem.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hon är hård mot sina ungar,","poem":1},{"text":"som om de inte var hennes.","poem":3},{"text":"Hon bryr sig inte om","poem":2},{"text":"att hennes möda","poem":3},{"text":"kan vara förgäves,","poem":4}]},{"type":"verse","number":20,"content":[{"text":"för Gud gav henne inte vishet,","poem":1},{"text":"han lät henne inte få förstånd.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Men när hon piskar sig","poem":1},{"text":"upp till språng,","poem":3},{"text":"då ler hon åt både häst","poem":2},{"text":"och ryttare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ger du hästen hans styrka,","poem":1},{"text":"klär du hans nacke med man?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Får du honom att hoppa","poem":1},{"text":"som gräshoppan?","poem":3},{"text":"Hans stolta frustning sprider skräck.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Han skrapar i marken","poem":1},{"text":"och gläds över sin styrka,","poem":3},{"text":"han rusar fram mot väpnade skaror.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Han ler åt fruktan","poem":1},{"text":"och känner ingen rädsla,","poem":3},{"text":"han ryggar inte tillbaka för svärd.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Runt honom rasslar det av koger,","poem":1},{"text":"det blänker av spjut och lansar","poem":2},{"noteId":70},{"text":".","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Han skakar och eggas","poem":1},{"text":"när han vinner terräng,","poem":3},{"text":"han kan inte stå still","poem":2},{"text":"när basunen har ljudit.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"För varje basunstöt frustar han till,","poem":1},{"text":"redan på avstånd vädrar han strid,","poem":2},{"text":"kommandorop och härskri.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Är det genom din vishet","poem":1},{"text":"som höken stiger","poem":3},{"text":"och breder ut sina vingar","poem":2},{"text":"mot söder?","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Är det på din befallning","poem":1},{"text":"som örnen stiger högt","poem":3},{"text":"och bygger sitt näste på höjden?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"På klippan bor han och vilar,","poem":1},{"text":"på klippans topp och bergsfäste.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Därifrån spanar han efter byte,","poem":1},{"text":"långt i fjärran spejar hans ögon.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Hans ungar frossar på blod,","poem":1},{"text":"och där de slagna ligger,","poem":2},{"text":"där finner man honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Och Herren svarade Job. Han sade:","poem":1}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Du som tvistar med den Allsmäktige,","poem":1},{"text":"ska du tillrättavisa honom?","poem":3},{"text":"Du som anklagar Gud, ge svar!","poem":2},{"noteId":71}]},{"type":"heading","content":["Job svarar Herren"]},{"type":"verse","number":36,"content":[{"text":"Job svarade Herren och sade:","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Jag är för liten.","poem":1},{"text":"Vad kan jag svara dig?","poem":3},{"text":"Jag sätter handen för munnen.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"En gång har jag talat,","poem":1},{"text":"men jag säger inget mer,","poem":3},{"text":"två gånger, men jag gör det inte igen.","poem":2}]}],"footnotes":[{"noteId":69,"caller":"-","text":"StrutshonanVar med sina oskyddade ägg på marken en bild för bristande ömhet (Klag 4:3). Strutsar levde i den arabiska öknen under biblisk tid.","reference":{"chapter":39,"verse":16}},{"noteId":70,"caller":"-","text":"det blänker av spjut och lansarAnnan översättning: ”klingor av spjut och kroksablar”.","reference":{"chapter":39,"verse":26}},{"noteId":71,"caller":"-","text":"Annan översättning: ”Vill en kritiker tvista med den Allsmäktige? Du som anklagar...”.","reference":{"chapter":39,"verse":35}}]},"thisChapterLink":"/api/swe_fol/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":38}