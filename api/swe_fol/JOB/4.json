{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifas första tal"]},{"type":"verse","number":1,"content":["Då tog Elifas från Teman till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tar du illa upp","poem":1},{"text":"om man försöker tala till dig?","poem":3},{"text":"Vem kan hålla tillbaka sina ord?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Se, du har väglett många","poem":1},{"text":"och stärkt kraftlösa händer.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dina ord har rest upp","poem":1},{"text":"den som har snubblat,","poem":3},{"text":"och du har gett kraft","poem":2},{"text":"åt vacklande knän.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Men nu gäller det dig,","poem":1},{"text":"och då blir du modlös,","poem":3},{"text":"du blir förskräckt","poem":2},{"text":"när det drabbar dig.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Är inte din gudsfruktan","poem":1},{"text":"din tillförsikt","poem":3},{"text":"och dina vägars ostrafflighet","poem":2},{"text":"ditt hopp?","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tänk efter:","poem":1},{"text":"När gick en oskyldig förlorad,","poem":2},{"text":"och var gick de rättsinniga","poem":3},{"text":"under?","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Jag har sett att de som plöjer ondska","poem":1},{"text":"och sår olycka får skörda sådant.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"De förgås för Guds andedräkt,","poem":1},{"text":"de försvinner","poem":2},{"text":"för hans vredes fnysning.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Lejonen ryter och vrålar,","poem":1},{"text":"men de unga lejonens tänder","poem":2},{"text":"bryts av.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Det gamla lejonet","poem":1},{"text":"förgås i brist på rov","poem":3},{"text":"och lejonhonans ungar skingras.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ett ord smög sig till mig,","poem":1},{"text":"det nådde mitt öra","poem":2},{"text":"som en viskning","poem":3}]},{"type":"verse","number":13,"content":[{"text":"när tankarna oroades","poem":1},{"text":"av nattens syner","poem":3},{"text":"och sömnen föll tung","poem":2},{"text":"över människorna.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Skräck och bävan drabbade mig","poem":1},{"text":"och fick alla mina ben att skaka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"En ande strök förbi mitt ansikte,","poem":1},{"text":"håren på min kropp reste sig.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Den stannade,","poem":1},{"text":"men jag kunde inte","poem":3},{"text":"urskilja utseendet","poem":2},{"text":"på gestalten jag såg.","poem":3},{"text":"Det var tyst,","poem":2},{"text":"sedan hörde jag en röst:","poem":3}]},{"type":"verse","number":17,"content":[{"text":"”Kan en människa","poem":1},{"text":"stå rättfärdig inför Gud,","poem":3},{"text":"kan en människa vara ren","poem":2},{"text":"inför sin skapare?","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Han litar inte ens på sina tjänare,","poem":1},{"text":"han finner fel hos sina änglar","poem":2},{"noteId":13},{"text":".","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hur mycket mer hos dem","poem":1},{"text":"som bor i hyddor av lera","poem":3},{"noteId":14},{"text":",","poem":3},{"text":"dem som har sin grund i stoftet!","poem":2},{"text":"De krossas lättare än mal.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"När morgon blivit kväll","poem":1},{"text":"ligger de slagna,","poem":3},{"text":"de går under för alltid","poem":2},{"text":"utan att någon märker det.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Deras tältlinor rycks upp för dem,","poem":1},{"text":"de dör utan visdom.”","poem":2}]}],"footnotes":[{"noteId":13,"caller":"-","text":"finner fel hos sina änglarJfr änglarnas uppror i 2 Petr 2:4, Upp 12:7.","reference":{"chapter":4,"verse":18}},{"noteId":14,"caller":"-","text":"hyddor av leraMänniskokroppen (jfr 1 Mos 2:7, 2 Kor 5:1f, 2 Petr 1:13f).","reference":{"chapter":4,"verse":19}}]},"thisChapterLink":"/api/swe_fol/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}