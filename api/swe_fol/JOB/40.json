{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"heading","content":["Herrens andra tal till Job"]},{"type":"verse","number":1,"content":["Då talade Herren till Job ur stormvinden. Han sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Spänn bältet om livet som en man.","poem":1},{"text":"Jag ska fråga dig,","poem":2},{"text":"och du ska ge mig besked.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vill du göra min rättvisa om intet?","poem":1},{"text":"Dömer du mig skyldig","poem":2},{"text":"för att själv stå rättfärdig?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Har du en arm som Gud,","poem":1},{"text":"och kan du dundra","poem":2},{"text":"med en röst som hans?","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Pryd dig då","poem":1},{"text":"med storhet och härlighet,","poem":3},{"text":"klä dig i ära och majestät.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ös ut din rasande vrede,","poem":1},{"text":"ödmjuka alla högmodiga","poem":2},{"text":"med en blick.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Underkuva alla högmodiga","poem":1},{"text":"med en blick,","poem":3},{"text":"slå ner de gudlösa på stället.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Göm dem alla i stoftet,","poem":1},{"text":"fjättra deras ansikten i mörkret.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Då ska också jag prisa dig","poem":1},{"text":"för att din högra hand","poem":2},{"text":"ger dig frälsning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Se Behemot","poem":1},{"noteId":72},{"text":",","poem":1},{"text":"som jag har skapat liksom dig.","poem":3},{"text":"Han lever av gräs som en oxe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Se kraften i hans höfter","poem":1},{"text":"och styrkan i hans bukmuskler.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hans svans är styv som en ceder,","poem":1},{"text":"hans lårsenor är sammanvävda.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hans benpipor är som kopparrör,","poem":1},{"text":"benen liknar järnstänger.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Han är förstlingen av Guds verk,","poem":1},{"text":"men hans skapare kan komma nära","poem":2},{"text":"med sitt svärd.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Bergen bär fram mat åt honom,","poem":1},{"text":"och alla de vilda djuren","poem":2},{"text":"har där sin lek.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Han lägger sig ner under lotusträd,","poem":1},{"text":"i skydd av rör och vass.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lotusträden ger honom skugga,","poem":1},{"text":"flodens pilträd omger honom.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Även om strömmen är kraftig","poem":1},{"text":"oroas han inte,","poem":3},{"text":"om så Jordan forsar mot hans gap","poem":2},{"text":"är han trygg.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Kan någon gripa tag i hans ögon","poem":1},{"text":"eller borra snaror genom hans nos?","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kan du dra upp Leviatan","poem":1},{"noteId":73},{"text":"med krok","poem":1},{"text":"eller kuva hans tunga med rep?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kan du sätta en sävlina","poem":1},{"noteId":74},{"text":"i hans näsa","poem":1},{"text":"eller borra en hake","poem":2},{"text":"genom hans käke?","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Skulle han vädja till dig om nåd","poem":1},{"text":"gång på gång","poem":3},{"text":"eller tala till dig med mjuka ord?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Skulle han sluta fördrag med dig","poem":1},{"text":"så att du kan ta honom som slav","poem":2},{"text":"för alltid?","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Kan du leka med honom","poem":1},{"text":"som med en fågel","poem":3},{"text":"eller hålla honom i band","poem":2},{"text":"åt dina flickor?","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Kan fiskarlag köpslå om honom","poem":1},{"text":"och dela upp honom","poem":2},{"text":"mellan köpmän?","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Kan du fylla hans hud","poem":1},{"text":"med harpuner","poem":3},{"text":"och hans huvud med fiskespjut?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bär hand på honom,","poem":1},{"text":"så minns du den striden","poem":2},{"text":"och gör inte om det!","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Nej, den som hoppas på seger","poem":1},{"text":"blir besviken,","poem":3},{"text":"redan när man ser honom","poem":2},{"text":"är man slagen.","poem":3}]}],"footnotes":[{"noteId":72,"caller":"-","text":"BehemotHebr. för ”djur”. Har traditionellt identifierats med flodhästen. På senare tid har även en identifikation med dinosaurier av sauropodsläktet föreslagits (jfr vers 12).","reference":{"chapter":40,"verse":10}},{"noteId":73,"caller":"-","text":"LeviatanHar traditionellt identifierats med krokodilen. På övriga ställen beskrivs Leviatan som ett havsmonster (Ps 104:26) eller en drake i opposition mot Gud (41:10f, jfr Jes 27:1).","reference":{"chapter":40,"verse":20}},{"noteId":74,"caller":"-","text":"sävlinaTråd tvinnad av vattenväxande säv.","reference":{"chapter":40,"verse":21}}]},"thisChapterLink":"/api/swe_fol/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":28}