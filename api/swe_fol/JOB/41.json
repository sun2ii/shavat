{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Ingen är så dumdristig",{"text":"att han retar honom.","poem":3},{"text":"Vem vågar då sätta sig upp","poem":2},{"text":"mot mig?","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Vem har gett mig något","poem":1},{"text":"som jag måste betala igen?","poem":3},{"text":"Mitt är allt som finns under himlen.","poem":2},{"noteId":75}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jag vill inte tiga om hans lemmar,","poem":1},{"text":"om hans styrka och sköna gestalt.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vem kan rycka av honom hans dräkt?","poem":1},{"text":"Vem kan ta sig in","poem":2},{"text":"mellan hans båda käkar?","poem":3},{"noteId":76}]},{"type":"verse","number":5,"content":[{"text":"Vem kan öppna hans ansiktes dörrar?","poem":1},{"text":"Runt hans tänder bor skräck.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Stolta sitter sköldarnas rader,","poem":1},{"text":"sammanfogade och fast förseglade,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"den ena tätt mot den andra,","poem":1},{"text":"ingen luft tränger in däremellan.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"De sitter fast mot varandra,","poem":1},{"text":"de griper in i varandra","poem":2},{"text":"och kan inte skiljas åt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"När han fnyser blixtrar det av ljus,","poem":1},{"text":"hans blickar är som","poem":2},{"text":"gryningens strålar.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Hans gap sprutar flammor,","poem":1},{"text":"gnistor av eld bryter fram.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ur hans näsborrar stiger rök","poem":1},{"text":"som från en kokande gryta","poem":2},{"text":"på elden.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Hans andedräkt kan tända kol,","poem":1},{"text":"lågor går ut ur hans gap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"På hans nacke bor styrkan,","poem":1},{"text":"och skräcken dansar","poem":2},{"noteId":77},{"text":"framför honom.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Hans hudveck är fasta,","poem":1},{"text":"de sitter hårt och orubbligt.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hans hjärta är hårt som sten,","poem":1},{"text":"som den understa kvarnstenen.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"När han reser sig bävar hjältar,","poem":1},{"text":"de tappar fattningen i ångest.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Svärdet som träffar håller inte stånd,","poem":1},{"text":"inte heller spjut, pil eller lans.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Han räknar järn som halm,","poem":1},{"text":"koppar som murket trä.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bågskott får honom inte att fly,","poem":1},{"text":"för honom är slungstenar","poem":2},{"text":"som agnar.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Stridsklubban räknar han som halm,","poem":1},{"text":"han skrattar åt rasslet av lansar","poem":2},{"noteId":78},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hans buk är som skarpa lerskärvor,","poem":1},{"text":"han sätter spår i dyn","poem":2},{"text":"som en trösksläde.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Han får djupet att koka som en gryta,","poem":1},{"text":"han får havet att skumma","poem":2},{"text":"som när man kokar salva.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Bakom honom går ett lysande stråk,","poem":1},{"text":"djupet tycks få silverhår.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inget på jorden är hans like,","poem":1},{"text":"han skapades utan fruktan.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Han ser på allt som är upphöjt,","poem":1},{"text":"han är kung över allt som är stolt.","poem":2}]}],"footnotes":[{"noteId":75,"caller":"-","text":"Citeras av Paulus i Rom 11:35.","reference":{"chapter":41,"verse":2}},{"noteId":76,"caller":"-","text":"ta sig in mellan hans båda käkarAnnan översättning: ”ta sig fram med betsel” eller ”ta sig igenom hans dubbla pansar” (så Septuaginta).","reference":{"chapter":41,"verse":4}},{"noteId":77,"caller":"-","text":"dansarAndra handskrifter (Septuaginta): ”springer”.","reference":{"chapter":41,"verse":13}},{"noteId":78,"caller":"-","text":"lansarAnnan översättning: ”kroksablar”.","reference":{"chapter":41,"verse":20}}]},"thisChapterLink":"/api/swe_fol/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":25}