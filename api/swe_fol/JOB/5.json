{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Ropa du!",{"text":"Finns det någon","poem":2},{"text":"som svarar dig?","poem":3},{"text":"Till vem av de heliga vänder du dig?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Dåren dödas av sin ilska,","poem":1},{"text":"den oförnuftige av sin förbittring.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jag såg en dåre som slagit rot,","poem":1},{"text":"men strax förbannade jag","poem":2},{"text":"hans boning.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Hans barn är fjärran från frälsning,","poem":1},{"text":"de trampas ner i porten","poem":2},{"text":"och ingen räddare finns.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Den hungrige slukar hans skörd,","poem":1},{"text":"den rövas bort","poem":2},{"text":"till och med bland törnen.","poem":3},{"text":"De törstiga flämtar","poem":2},{"text":"efter","poem":3},{"noteId":15},{"text":"deras rikedom,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"för nöden kommer inte ur stoftet,","poem":1},{"text":"olyckan skjuter inte upp ur marken.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Men människan föds till möda","poem":1},{"text":"liksom eldens gnistor","poem":2},{"text":"flyger mot höjden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Men jag skulle söka Gud","poem":1},{"text":"och inför Gud lägga fram min sak.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han gör stora och outgrundliga ting,","poem":1},{"text":"fler under än någon kan räkna.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Han ger jorden regn","poem":1},{"text":"och sänder vatten över markerna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Han upphöjer de ringa","poem":1},{"text":"och hjälper de sörjande.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Han gör de listigas anslag om intet","poem":1},{"text":"så att deras händer","poem":2},{"text":"inte får framgång.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Han fångar de visa i deras slughet","poem":1},{"text":"och låter de svekfulla förhasta sig","poem":2},{"text":"vid sina rådslag.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Om dagen möter de mörker,","poem":1},{"text":"de famlar mitt på dagen","poem":2},{"text":"som om det var natt.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Han räddar från svärdet i deras mun,","poem":1},{"text":"den fattige från den mäktiges hand.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Den nödställde får åter ett hopp,","poem":1},{"text":"orätten måste stänga sin mun.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Se, salig är den människa","poem":1},{"text":"som Gud tuktar.","poem":3},{"text":"Förkasta inte","poem":2},{"text":"den Allsmäktiges fostran,","poem":3}]},{"type":"verse","number":18,"content":[{"text":"för han sargar och förbinder,","poem":1},{"text":"han slår och hans händer helar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sex gånger räddar han dig ur nöden,","poem":1},{"text":"och sjunde gången drabbar dig inte","poem":2},{"text":"det onda.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"I tider av svält","poem":1},{"text":"räddar han dig från döden","poem":3},{"text":"och i krig från svärdets våld.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Från tungors gissel göms du undan,","poem":1},{"text":"du behöver inte vara rädd","poem":2},{"text":"när förödelse kommer.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Du kan le åt förödelse och svält,","poem":1},{"text":"du behöver inte vara rädd","poem":2},{"text":"för vilddjur,","poem":3}]},{"type":"verse","number":23,"content":[{"text":"för du står i förbund","poem":1},{"text":"med markens stenar,","poem":3},{"text":"markens vilddjur håller fred","poem":2},{"text":"med dig.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Du ska veta att ditt tält står tryggt,","poem":1},{"text":"när du synar din boning","poem":2},{"text":"ska inget saknas.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Du ska veta att din ätt förökas,","poem":1},{"text":"att dina efterkommande","poem":2},{"text":"blir som gräset på marken.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Du kommer i graven","poem":1},{"text":"när du nått full mognad,","poem":3},{"text":"som sädeskärven bärgas","poem":2},{"text":"när tiden är inne.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Se, vi har utforskat detta,","poem":1},{"text":"så är det.","poem":3},{"text":"Hör det och tänk på det noga.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"-","text":"De törstiga flämtar efterAnnan översättning: ”Snaran snappar efter”.","reference":{"chapter":5,"verse":5}}]},"thisChapterLink":"/api/swe_fol/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}