{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Jobs svar på Elifas första tal"]},{"type":"verse","number":1,"content":["Då tog Job till orda och sade:"]},{"type":"verse","number":2,"content":[{"text":"O, att min sorg kunde vägas","poem":1},{"text":"och min olycka läggas","poem":2},{"text":"i samma vågskål!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Nu är den tyngre än havets sand,","poem":1},{"text":"därför kan jag inte styra mina ord,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"för den Allsmäktiges pilar","poem":1},{"text":"har träffat mig,","poem":3},{"text":"min ande dricker deras gift.","poem":2},{"text":"Fasor från Gud","poem":3},{"text":"går i stridsställning mot mig.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Skriar vildåsnan över sitt gräs,","poem":1},{"text":"råmar oxen över sitt foder?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kan det smaklösa ätas utan salt,","poem":1},{"text":"finns det någon smak i äggets vita?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag vägrar röra det,","poem":1},{"text":"det är kväljande mat för mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"O, att min begäran blev hörd","poem":1},{"text":"och att Gud uppfyllde min längtan,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"att Gud ville krossa mig,","poem":1},{"text":"räcka ut sin hand","poem":2},{"text":"och skära av mitt liv!","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Då vore det ändå min tröst,","poem":1},{"text":"mitt jubel i skoningslös plåga,","poem":3},{"text":"att jag inte förnekat","poem":2},{"text":"den Heliges ord.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vad är då min kraft,","poem":1},{"text":"att jag skulle hoppas?","poem":3},{"text":"Vad är mitt slut,","poem":2},{"text":"att jag skulle vara tålig?","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Är min kraft som stenens,","poem":1},{"text":"min kropp av koppar?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nej, hjälpen kommer inte från mig,","poem":1},{"text":"varje utväg är stängd för mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Den förtvivlade borde få godhet","poem":1},{"text":"från sin vän,","poem":3},{"text":"men man fruktar inte mer","poem":2},{"text":"den Allsmäktige.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Mina bröder är trolösa som bäckar","poem":1},{"noteId":16},{"text":",","poem":1},{"text":"som bäckars rännilar som sinar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"De är mörka av is när snön har fallit","poem":1},{"text":"och gömt sig i dem,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"men när hettan kommer torkar de,","poem":1},{"text":"försvinner i värmen från sin plats.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"De ändrar kurs från sitt lopp,","poem":1},{"text":"rinner ut i intet och försvinner.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Karavaner från Tema","poem":1},{"noteId":17},{"text":"spanar efter dem,","poem":3},{"text":"resande från Saba","poem":2},{"text":"sätter sitt hopp till dem.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"De blir svikna i sin förhoppning,","poem":1},{"text":"när de kommer fram","poem":2},{"text":"blir de bestörta.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Så har ni nu blivit till intet,","poem":1},{"text":"ni ser det förskräckliga","poem":2},{"text":"och blir rädda.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Har jag sagt: ”Ge mig något,","poem":1},{"text":"köp mig loss med er förmögenhet,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"rädda mig från fiendens hand,","poem":1},{"text":"friköp mig från utpressarna?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Undervisa mig så tiger jag,","poem":1},{"text":"hjälp mig förstå var jag gått vilse.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hur inträngande","poem":1},{"text":"är inte uppriktiga ord!","poem":3},{"text":"Men vad hjälper","poem":2},{"text":"tillrättavisning från er?","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Tänker ni märka ord","poem":1},{"text":"och betrakta en förtvivlad mans","poem":2},{"text":"ord som luft?","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Skulle ni kasta lott om en faderlös","poem":1},{"text":"och köpslå om er vän?","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Men se nu på mig!","poem":1},{"text":"Jag ska inte ljuga er rakt i ansiktet.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Vänd om, låt ingen orätt ske!","poem":1},{"text":"Vänd om, min sak är rättfärdig!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Bor orätt på min tunga?","poem":1},{"text":"Skulle inte min mun förstå ondska?","poem":2}]}],"footnotes":[{"noteId":16,"caller":"-","text":"trolösa som bäckarÖkenbäckar har inte vatten på sommaren när det som bäst behövs.","reference":{"chapter":6,"verse":15}},{"noteId":17,"caller":"-","text":"TemaHandelsort vid oas i nordvästra Saudiarabien, längs en viktig karavanväg.","reference":{"chapter":6,"verse":19}}]},"thisChapterLink":"/api/swe_fol/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}