{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Har inte människan",{"text":"ett slitsamt liv på jorden?","poem":2},{"lineBreak":true},{"text":"Är inte hennes dagar","poem":2},{"text":"som daglönarens dagar?","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Hon är som en slav","poem":1},{"text":"som flämtar efter skugga,","poem":3},{"text":"som en daglönare","poem":2},{"text":"som väntar på sin lön.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Månader av elände","poem":1},{"text":"har jag fått till arvedel,","poem":3},{"text":"nätter av vedermöda","poem":2},{"text":"har blivit min lott.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Så snart jag har lagt mig frågar jag:","poem":1},{"text":"”När ska jag stiga upp?","poem":2},{"text":"När ska natten ta slut?”","poem":3},{"text":"Jag mättas av oro","poem":2},{"text":"ända till morgonen.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Min kropp täcks av maskar","poem":1},{"text":"och med en skorpa som av jord,","poem":3},{"text":"min hud skrumpnar och faller av.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mina dagar flyr snabbare","poem":1},{"text":"än vävarens spole,","poem":3},{"text":"de försvinner utan hopp.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tänk på att mitt liv är en vindfläkt,","poem":1},{"text":"att mitt öga inte längre","poem":2},{"text":"får se det goda.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Det öga som ser mig","poem":1},{"text":"ska inte mer iaktta mig,","poem":3},{"text":"om din blick söker mig","poem":2},{"text":"finns jag inte längre.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ett moln löses upp och är borta,","poem":1},{"text":"den som farit ner i dödsriket","poem":2},{"text":"kommer inte upp igen.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Aldrig mer återvänder han","poem":1},{"text":"till sitt hus,","poem":3},{"text":"hans plats känner honom inte längre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Därför vill jag inte lägga band","poem":1},{"text":"på min mun,","poem":3},{"text":"jag vill tala i min andes ångest,","poem":2},{"text":"jag vill klaga i min själs","poem":3},{"text":"bedrövelse.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Jag är väl inte ett hav","poem":1},{"text":"eller ett havsodjur,","poem":3},{"text":"så att du måste sätta ut vakt","poem":2},{"text":"mot mig?","poem":3}]},{"type":"verse","number":13,"content":[{"text":"När jag säger:","poem":1},{"text":"”Min bädd ska trösta mig,","poem":3},{"text":"min viloplats ska lindra min oro”,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"då skrämmer du mig med drömmar","poem":1},{"text":"och skräckslår mig med syner.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Hellre vill jag bli kvävd,","poem":1},{"text":"hellre dö än vara ett benrangel.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jag är trött på det här,","poem":1},{"text":"jag kommer inte att leva för evigt.","poem":3},{"text":"Låt mig vara,","poem":2},{"text":"för mina dagar är en vindfläkt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Vad är då en människa,","poem":1},{"text":"att du gör så stor sak av henne,","poem":2},{"text":"ger akt på henne så noga,","poem":3}]},{"type":"verse","number":18,"content":[{"text":"synar henne var morgon,","poem":1},{"text":"prövar henne vart ögonblick?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"När ska du vända din blick","poem":1},{"text":"ifrån mig,","poem":3},{"text":"ge mig tid att svälja min saliv?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Har jag syndat, vad gör det dig,","poem":1},{"text":"du människornas bevakare?","poem":3},{"text":"Varför har du gjort mig","poem":2},{"text":"till din måltavla","poem":3},{"text":"och låtit mig bli en börda","poem":2},{"text":"för mig själv","poem":3},{"noteId":18},{"text":"?","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Varför förlåter du inte min synd","poem":1},{"text":"och tar bort min skuld?","poem":3},{"text":"Snart ska jag ligga i stoftet,","poem":2},{"text":"du kommer att söka efter mig","poem":3},{"text":"men jag finns inte mer.","poem":4}]}],"footnotes":[{"noteId":18,"caller":"-","text":"för mig självAndra handskrifter (Septuaginta): ”för dig”.","reference":{"chapter":7,"verse":20}}]},"thisChapterLink":"/api/swe_fol/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}