{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["Bildads första tal"]},{"type":"verse","number":1,"content":["Sedan tog Bildad från Shua till orda och sade:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hur länge ska du tala så?","poem":1},{"text":"Orden från din mun","poem":2},{"text":"är som en väldig storm.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Kan Gud kränka rättvisan,","poem":1},{"text":"kan den Allsmäktige","poem":2},{"text":"kränka rättfärdigheten?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Om dina barn har syndat mot honom,","poem":1},{"text":"då ger han dem i deras synders våld.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Men om du söker Gud","poem":1},{"text":"och ber den Allsmäktige om nåd,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"om du är ren och rättsinnig,","poem":1},{"text":"då ska han vaka över dig","poem":3},{"text":"och göra din rättfärdighets boning","poem":2},{"text":"trygg.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Om än din början är ringa,","poem":1},{"text":"ska du till sist bli mycket stor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fråga gångna släktled","poem":1},{"text":"och ta vara på fädernas erfarenhet.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Själva är vi från i går","poem":1},{"text":"och vet ingenting,","poem":3},{"text":"en skugga är våra dagar på jorden.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Men de ska undervisa","poem":1},{"text":"och berätta för dig","poem":3},{"text":"och lägga fram ord från sina hjärtan.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kan papyrus växa","poem":1},{"text":"där marken inte är sank,","poem":3},{"text":"skjuter vassen upp","poem":2},{"text":"där det inte finns vatten?","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Medan den står grön och oskuren","poem":1},{"text":"vissnar den före allt annat gräs.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Så går det alla som glömmer Gud.","poem":1},{"text":"Den gudlöses hopp kan inte bestå,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"för hans tillförsikt är bräcklig","poem":1},{"text":"och hans trygghet","poem":2},{"text":"som spindelns nät.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Han förlitar sig på sitt hus,","poem":1},{"text":"men det håller inte,","poem":3},{"text":"han klamrar sig fast vid det,","poem":2},{"text":"men det kommer inte att bestå.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Han frodas i solens sken,","poem":1},{"text":"hans skott sträcker sig","poem":2},{"text":"ut över trädgården.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Hans rötter slingrar sig","poem":1},{"text":"kring stenröset,","poem":3},{"text":"ett hus av sten har han i sikte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"När han rycks bort från sin plats,","poem":1},{"text":"förnekar den honom:","poem":2},{"text":"”Jag har aldrig sett dig.”","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Ja, det är den glädje han får","poem":1},{"text":"av sin färd,","poem":3},{"text":"och ur mullen växer andra upp.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Gud förkastar inte den oskyldige,","poem":1},{"text":"och han håller inte de onda","poem":2},{"text":"i handen.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Vänta tills han fyller din mun","poem":1},{"text":"med skratt","poem":3},{"text":"och dina läppar med jubel.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"De som hatar dig ska kläs i skam,","poem":1},{"text":"och de gudlösas tält","poem":2},{"text":"ska inte mer finnas till.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}