{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOB","translationId":"swe_fol","name":"Job","commonName":"Job","title":"Job","order":18,"numberOfChapters":42,"sha256":"93d6eeb654213789ceebf80fcbfdb6884933bf46c2eefbb35838ee8154b308e0","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swe_fol/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["Jobs svar på Bildads första tal"]},{"type":"verse","number":1,"content":["Då tog Job till orda och sade:"]},{"type":"verse","number":2,"content":[{"text":"Jag vet mycket väl att det är så.","poem":1},{"text":"Hur kan en människa","poem":2},{"text":"stå rättfärdig inför Gud?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Om hon vill gå till rätta med honom,","poem":1},{"text":"kan hon inte ge svar på en sak","poem":2},{"text":"bland tusen.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Hans hjärta är vist,","poem":1},{"text":"hans kraft är väldig,","poem":3},{"text":"vem har trotsat honom","poem":2},{"text":"och kommit undan?","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Han flyttar berg","poem":1},{"text":"utan att någon vet det","poem":3},{"text":"och omstörtar dem i sin vrede,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"han får jorden att vackla","poem":1},{"text":"från sin plats","poem":3},{"text":"och dess pelare att bäva,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"han befaller solen att inte gå upp","poem":1},{"text":"och förseglar stjärnorna,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"han ensam spänner ut himlarna","poem":1},{"text":"och skrider fram över havets rygg,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"han har gjort Stora Björn","poem":1},{"noteId":19},{"text":"och Orion,","poem":1},{"text":"Sjustjärnorna","poem":2},{"text":"och söderns stjärnbilder,","poem":3}]},{"type":"verse","number":10,"content":[{"text":"han gör stora och ofattbara ting,","poem":1},{"text":"under som ingen kan räkna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Se, han går förbi mig","poem":1},{"text":"utan att jag ser honom,","poem":3},{"text":"han drar vidare","poem":2},{"text":"utan att jag märker det.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Han griper sitt rov,","poem":1},{"text":"vem kan hindra honom?","poem":3},{"text":"Vem kan säga till honom:","poem":2},{"text":"”Vad gör du?”","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Gud håller inte tillbaka sin vrede.","poem":1},{"text":"För honom måste","poem":2},{"text":"Rahabs","poem":3},{"noteId":20},{"text":"följe böja sig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hur skulle jag kunna svara honom,","poem":1},{"text":"välja ut ord inför honom?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Även om jag har rätt","poem":1},{"text":"kan jag inte svara,","poem":3},{"text":"bara be min domare om nåd.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Om jag ropar och han svarar,","poem":1},{"text":"så tror jag inte att han lyssnar","poem":2},{"text":"till min röst,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"för han straffar mig med storm","poem":1},{"text":"och slår mig med sår på sår","poem":2},{"text":"utan orsak.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Han låter mig inte hämta andan","poem":1},{"text":"utan mättar mig med bedrövelser.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Gäller det styrka? Se, han är stark!","poem":1},{"text":"Gäller det vad som är rätt?","poem":2},{"text":"Vem vill ställa mig till svars","poem":3},{"noteId":21},{"text":"?","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Om jag hade rätt","poem":1},{"text":"skulle ändå min mun fälla mig,","poem":3},{"text":"om jag vore oskyldig","poem":2},{"text":"skulle han finna mig falsk.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Jag är oskyldig!","poem":1},{"text":"Jag vill inte veta av mig själv,","poem":2},{"text":"jag är trött på att leva.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Det går på ett ut, därför säger jag:","poem":1},{"text":"Både den oskyldige","poem":2},{"text":"och den skyldige förgör han.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Om en plåga bringar plötslig död,","poem":1},{"text":"föraktar han de oskyldigas","poem":2},{"text":"förtvivlan.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Jorden är given i de gudlösas hand.","poem":1},{"text":"Han binder för ögonen","poem":2},{"text":"på dess domare.","poem":3},{"text":"Om det inte är han, vem är det då?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mina dagar rusar i väg","poem":1},{"text":"snabbare än en löpare,","poem":3},{"text":"de flyr bort utan att ha sett","poem":2},{"text":"någon glädje.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"De far förbi som vassbåtar,","poem":1},{"text":"som en örn som störtar","poem":2},{"text":"mot sitt byte.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Om jag säger:","poem":1},{"text":"Jag ska glömma mitt bekymmer,","poem":2},{"text":"släppa min sorgsna min","poem":3},{"text":"och vara glad,","poem":4}]},{"type":"verse","number":28,"content":[{"text":"så bävar jag ändå för alla mina kval,","poem":1},{"text":"för jag vet att du inte","poem":2},{"text":"ska döma mig fri.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Jag står där som skyldig,","poem":1},{"text":"varför tröttar jag ut mig i onödan?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Även om jag tvättar mig med snö","poem":1},{"noteId":22},{"text":"och renar mina händer med lut,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ska du ändå sänka ner mig i pölen","poem":1},{"text":"och mina kläder ska avsky mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Han är inte en människa som jag,","poem":1},{"text":"så att jag kan svara honom:","poem":2},{"text":"”Vi går tillsammans till rätten.”","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Det finns ingen som kan","poem":1},{"text":"döma mellan oss","poem":3},{"text":"och lägga sin hand på oss båda.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Må han ta bort sitt ris från mig","poem":1},{"text":"så att skräcken för honom","poem":2},{"text":"inte förfärar mig.","poem":3}]},{"type":"verse","number":35,"content":[{"text":"Då ska jag tala","poem":1},{"text":"utan att vara rädd för honom.","poem":3},{"text":"Men så har jag det inte.","poem":2}]}],"footnotes":[{"noteId":19,"caller":"-","text":"Stora BjörnStjärnbilden med Karlavagnen. Annan översättning: ”Lejonet”.","reference":{"chapter":9,"verse":9}},{"noteId":20,"caller":"-","text":"RahabHebr. för ”övermod”, ”trotsighet”. Används även om Egypten (jfr Ps 87:4, Jes 30:7).","reference":{"chapter":9,"verse":13}},{"noteId":21,"caller":"-","text":"ställa mig till svarsAndra handskrifter (Septuaginta): ”ställa honom till svars”.","reference":{"chapter":9,"verse":19}},{"noteId":22,"caller":"-","text":"snöKan möjligen syfta på såpnejlikor, ett forntida tvättmedel.","reference":{"chapter":9,"verse":30}}]},"thisChapterLink":"/api/swe_fol/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}