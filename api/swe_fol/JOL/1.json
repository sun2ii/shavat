{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOL","translationId":"swe_fol","name":"Joel","commonName":"Joel","title":"Joel","order":29,"numberOfChapters":3,"sha256":"c4d30a5edd6a42842d99be551a643d585cc6d76fce47cf766d1844638121192c","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"heading","content":["Guds dom genom gräshoppor"]},{"type":"verse","number":1,"content":["Herrens ord som kom till Joel, Petuels son."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hör detta, ni äldste,","poem":1},{"text":"lyssna, alla ni som bor i landet.","poem":3},{"text":"Har något sådant hänt i era dagar","poem":2},{"text":"eller under era fäders tid?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Det här ska ni berätta för era barn,","poem":1},{"text":"era barn ska säga det till sina barn","poem":3},{"text":"och deras barn","poem":2},{"text":"till ett kommande släkte.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Det som gräsgnagarna","poem":1},{"noteId":0},{"text":"lämnade","poem":1},{"text":"åt gräshopporna upp,","poem":3},{"text":"det som gräshopporna lämnade","poem":2},{"text":"åt gräsbitarna upp,","poem":3},{"text":"och det som gräsbitarna lämnade","poem":2},{"text":"åt gräsätarna upp.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Vakna, ni druckna, och gråt!","poem":1},{"text":"Jämra er, alla ni som dricker vin,","poem":2},{"text":"över druvsaften","poem":3},{"text":"som ryckts från er mun.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"För ett hednafolk","poem":1},{"text":"har invaderat mitt land,","poem":3},{"text":"ett mäktigt folk","poem":2},{"text":"som ingen kan räkna,","poem":3},{"text":"med tänder som ett lejon","poem":2},{"text":"och käftar som en lejonhona.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"De har ödelagt min vinstock","poem":1},{"text":"och förstört mitt fikonträd,","poem":3},{"text":"skalat dem nakna","poem":2},{"text":"och kastat bort barken,","poem":3},{"text":"lämnat grenarna vita.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Klaga som en brud i sorgdräkt","poem":1},{"text":"efter sin ungdoms brudgum.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Matoffer och dryckesoffer","poem":1},{"text":"har försvunnit från Herrens hus.","poem":3},{"text":"Prästerna, Herrens tjänare, sörjer.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Fältet är ödelagt, marken sörjer,","poem":1},{"text":"för säden är förstörd.","poem":3},{"text":"Det nya vinet har torkat bort","poem":2},{"text":"och oljan har sinat.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Stå besvikna, ni jordbrukare,","poem":1},{"text":"jämra er, ni vinodlare,","poem":3},{"text":"över vetet och kornet,","poem":2},{"text":"för skörden på fälten är förstörd.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Vinstocken är förtorkad","poem":1},{"text":"och fikonträdet vissnat.","poem":3},{"text":"Granatäppelträdet, dadelpalmen","poem":2},{"text":"och äppelträdet –","poem":3},{"text":"markens alla träd har torkat bort,","poem":2},{"text":"glädjen har vissnat","poem":3},{"text":"från människors barn.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Klä er i säcktyg och klaga, ni präster,","poem":1},{"text":"jämra er, ni som tjänstgör","poem":2},{"text":"vid altaret.","poem":3},{"text":"Gå in och sitt i säcktyg hela natten,","poem":2},{"text":"ni min Guds tjänare,","poem":3},{"text":"för det finns inga mer matoffer","poem":2},{"text":"eller drickoffer i er Guds hus.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Pålys en helig fasta,","poem":1},{"noteId":1},{"text":"utropa en högtidsförsamling.","poem":3},{"text":"Samla de äldste,","poem":2},{"text":"samla alla som bor i landet","poem":3},{"text":"till Herren er Guds hus,","poem":2},{"text":"och ropa till Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ve oss, vilken dag!","poem":1},{"text":"Herrens dag är nära,","poem":2},{"text":"den kommer som förödelse","poem":3},{"text":"från den Allsmäktige.","poem":4},{"noteId":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Har inte vårt levebröd ryckts bort","poem":1},{"text":"inför ögonen på oss,","poem":3},{"text":"glädje och fröjd","poem":2},{"text":"från vår Guds hus?","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Utsädet ligger förtorkat","poem":1},{"text":"under klumpar av jord,","poem":3},{"text":"förrådshusen står öde","poem":2},{"text":"och ladorna förfaller,","poem":3},{"text":"för säden har torkat bort.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vad boskapen stönar!","poem":1},{"text":"Hjordar av kor irrar omkring,","poem":2},{"text":"de finner inget bete.","poem":3},{"text":"Även fårhjordarna går under.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Jag ropar till dig, Herre,","poem":1},{"text":"för en eld har förtärt","poem":2},{"text":"betet i ödemarken","poem":3},{"text":"och flamman förbränt","poem":2},{"text":"markens alla träd.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Även de vilda djuren","poem":1},{"text":"längtar efter dig,","poem":3},{"text":"för bäckarnas vatten har torkat ut","poem":2},{"text":"och en eld har förtärt","poem":3},{"text":"betet i ödemarken.","poem":4}]}],"footnotes":[{"noteId":0,"caller":"-","text":"gräsgnagarna etcDe fyra orden syftar på antingen fyra olika arter eller på fyra stadier i gräshoppans livscykel (larv, vinglös, utvecklad och äggläggande). Gräshoppssvärmar förtär allt i sin väg (se 2 Mos 10:4f) och har drabbat Israel även i modern tid.","reference":{"chapter":1,"verse":4}},{"noteId":1,"caller":"-","text":"säcktyg … fastaUttryck för djup sorg och omvändelse (jfr Est 4:1f, Jona 3:5f).","reference":{"chapter":1,"verse":14}},{"noteId":2,"caller":"-","text":"förödelse från den AllsmäktigeHebr. shod mi-Shaddaí.","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/swe_fol/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}