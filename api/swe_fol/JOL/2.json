{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOL","translationId":"swe_fol","name":"Joel","commonName":"Joel","title":"Joel","order":29,"numberOfChapters":3,"sha256":"c4d30a5edd6a42842d99be551a643d585cc6d76fce47cf766d1844638121192c","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Herrens dag"]},{"type":"verse","number":1,"content":["Blås i basun på Sion,",{"text":"låt larmet ljuda","poem":2},{"text":"på mitt heliga berg","poem":3},{"text":"så att alla som bor i landet darrar,","poem":2},{"text":"för Herrens dag kommer,","poem":3},{"text":"den är nära,","poem":4}]},{"type":"verse","number":2,"content":[{"text":"en dag av mörker och töcken,","poem":1},{"text":"en dag av moln och dimma.","poem":3},{"text":"Som gryningen","poem":2},{"text":"breder ut sig över bergen","poem":3},{"text":"kommer ett stort","poem":2},{"text":"och mäktigt folk,","poem":3},{"text":"vars like inte har funnits","poem":2},{"text":"och aldrig ska uppstå igen","poem":3},{"text":"under kommande släkten.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Framför dem","poem":1},{"text":"går en förtärande eld,","poem":3},{"text":"bakom dem","poem":2},{"text":"en brännande låga.","poem":3},{"text":"Landet framför dem","poem":2},{"text":"var som Edens lustgård,","poem":3},{"text":"bakom dem är öde öken.","poem":2},{"text":"Ingen kommer undan dem.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"De liknar hästar,","poem":1},{"text":"de rusar fram som stridshästar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"De spränger fram","poem":1},{"text":"över bergens toppar","poem":3},{"text":"med ett muller som av vagnar,","poem":2},{"text":"med ett dån som när eldens lågor","poem":3},{"text":"förtär strå,","poem":4},{"text":"som ett mäktigt folk,","poem":2},{"text":"ordnat till strid.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Framför dem grips folken av skräck,","poem":1},{"text":"alla ansikten bleknar","poem":2},{"noteId":3},{"text":".","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Som hjältar jagar de fram,","poem":1},{"text":"som stridsmän stiger de upp","poem":2},{"text":"på murarna.","poem":3},{"text":"Var och en går sin väg rakt fram,","poem":2},{"text":"ingen viker av från sin bana","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Den ene tränger inte den andre,","poem":1},{"text":"var och en går sitt givna spår.","poem":2},{"lineBreak":true},{"text":"Mitt igenom vapnen störtar de fram","poem":1},{"text":"utan att hejdas","poem":2},{"noteId":4},{"text":".","poem":2}]},{"type":"verse","number":9,"content":[{"text":"De stormar in i staden,","poem":1},{"text":"rusar fram på murarna,","poem":3},{"text":"klättrar upp på husen,","poem":2},{"text":"går in genom fönstren","poem":3},{"text":"som tjuvar.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Inför dem darrar jorden,","poem":1},{"text":"himlen bävar,","poem":3},{"text":"solen och månen förmörkas","poem":2},{"text":"och stjärnorna mister sitt sken.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Herren låter sin röst höras","poem":1},{"text":"framför sin här.","poem":3},{"text":"Mycket stor är hans armé,","poem":2},{"text":"stark är den som utför","poem":3},{"text":"hans order,","poem":4},{"text":"för Herrens dag är stor","poem":2},{"text":"och mycket skrämmande.","poem":3},{"text":"Vem kan uthärda den?","poem":2}]},{"type":"heading","content":["Kallelse till omvändelse"]},{"type":"verse","number":12,"content":[{"text":"Men nu, säger Herren,","poem":1},{"text":"vänd om till mig","poem":2},{"text":"av hela ert hjärta,","poem":3},{"text":"med fasta, gråt och klagan.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Riv sönder era hjärtan,","poem":1},{"text":"inte era kläder,","poem":3},{"text":"och vänd om till Herren er Gud,","poem":2},{"text":"för han är nådig och barmhärtig,","poem":3},{"text":"sen till vrede och stor i nåd,","poem":2},{"text":"och han ångrar det onda.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Vem vet?","poem":1},{"text":"Kanske vänder han om","poem":2},{"text":"och ångrar sig","poem":3},{"text":"och lämnar kvar en välsignelse","poem":2},{"text":"efter sig","poem":3},{"text":"till matoffer och drickoffer","poem":2},{"text":"åt Herren er Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Blås i basun på Sion,","poem":1},{"text":"pålys en helig fasta,","poem":2},{"text":"utropa en helig sammankomst.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Samla folket,","poem":1},{"text":"helga församlingen,","poem":3},{"text":"kalla samman de äldste,","poem":2},{"text":"samla de små barnen,","poem":4},{"text":"också dem som diar vid bröstet.","poem":3},{"text":"Låt brudgummen komma ut","poem":2},{"text":"ur sitt rum","poem":3},{"text":"och bruden ur sin kammare.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Låt prästerna, Herrens tjänare,","poem":1},{"text":"gråta mellan förhuset och altaret","poem":2},{"text":"och säga:","poem":3},{"text":"”Herre, skona ditt folk","poem":2},{"text":"och låt inte din arvedel hånas","poem":3},{"text":"och bli en nidvisa","poem":2},{"text":"bland hednafolken.","poem":3},{"text":"Varför ska det få sägas bland folken:","poem":2},{"text":"Var är deras Gud?”","poem":3}]},{"type":"heading","content":["Herrens svar"]},{"type":"verse","number":18,"content":[{"text":"Då fylldes Herren","poem":1},{"text":"av lidelse för sitt land,","poem":3},{"text":"och han förbarmade sig","poem":2},{"text":"över sitt folk.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Herren svarade","poem":1},{"text":"och sade till sitt folk:","poem":3},{"text":"Se, jag ska sända er","poem":2},{"text":"säd och vin och olja","poem":3},{"text":"så att ni blir mätta.","poem":4},{"text":"Och jag ska inte","poem":2},{"text":"låta hednafolken håna er längre.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Fienden från norr","poem":1},{"text":"ska jag driva långt bort ifrån er,","poem":3},{"text":"jag ska driva ut honom","poem":2},{"text":"till ett torrt och öde land,","poem":3},{"text":"hans förtrupp till havet i öster","poem":2},{"text":"och hans eftertrupp till havet","poem":3},{"text":"i väster.","poem":4},{"noteId":5},{"text":"Stank ska stiga från honom,","poem":2},{"text":"ja, vidrig lukt ska stiga","poem":3},{"text":"från honom,","poem":4},{"text":"för han har gjort stora ting.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Var inte rädd, du land!","poem":1},{"text":"Jubla och gläd dig,","poem":2},{"text":"för Herren har gjort stora ting.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Var inte rädda, ni markens djur,","poem":1},{"text":"för ödemarkens beten grönskar","poem":2},{"text":"och träden bär sin frukt,","poem":3},{"text":"fikonträden och vinstockarna","poem":2},{"text":"ger sin rikedom.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Jubla, ni Sions barn,","poem":1},{"text":"gläd er i Herren er Gud,","poem":3},{"text":"för han ger er Läraren","poem":2},{"noteId":6},{"text":"till rättfärdighet.","poem":3},{"text":"Han ska sända er rikligt med regn,","poem":2},{"text":"både höstregn och vårregn","poem":3},{"text":"som tidigare.","poem":4}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Så ska tröskplatserna fyllas med säd","poem":1},{"text":"och pressarna flöda över","poem":2},{"text":"av vin och olja.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Jag ska gottgöra er för åren","poem":1},{"text":"som åts upp av gräshopporna","poem":2},{"text":"och gräsbitarna,","poem":3},{"text":"av gräsätarna och gräsgnagarna,","poem":2},{"text":"den stora här","poem":3},{"text":"som jag sände ut mot er.","poem":4}]},{"type":"verse","number":26,"content":[{"text":"Ni ska äta och bli mätta,","poem":1},{"text":"och ni ska lova","poem":2},{"noteId":7},{"text":"Herren er Guds namn,","poem":3},{"text":"han som har handlat","poem":2},{"text":"så underbart med er,","poem":3},{"text":"och mitt folk ska aldrig mer","poem":2},{"text":"komma på skam.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Ni ska förstå att jag är mitt i Israel,","poem":1},{"text":"att jag är Herren er Gud","poem":2},{"text":"och ingen annan.","poem":3},{"text":"Och mitt folk ska aldrig mer","poem":2},{"text":"komma på skam.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Och det ska ske därefter","poem":1},{"text":"att jag utgjuter min Ande","poem":2},{"text":"över allt kött.","poem":3},{"text":"Era söner och era döttrar","poem":2},{"text":"ska profetera,","poem":3},{"text":"era gamla ska ha drömmar","poem":2},{"text":"och era unga ska se syner.","poem":3},{"noteId":8}]},{"type":"verse","number":29,"content":[{"text":"Ja, över tjänare och tjänarinnor","poem":1},{"text":"ska jag i de dagarna","poem":2},{"text":"utgjuta min Ande.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Och jag ska göra tecken","poem":1},{"text":"på himlen och på jorden,","poem":2},{"text":"blod, eld och rökpelare.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Solen ska vändas i mörker","poem":1},{"text":"och månen i blod","poem":3},{"text":"innan Herrens dag kommer,","poem":2},{"text":"den stora och skrämmande.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Och det ska ske att var och en","poem":1},{"text":"som åkallar Herrens namn","poem":2},{"text":"ska bli frälst.","poem":3},{"text":"På Sions berg och i Jerusalem","poem":2},{"text":"ska det finnas en räddad skara,","poem":3},{"text":"så som Herren har sagt,","poem":2},{"text":"bland de överlevande","poem":3},{"text":"som Herren kallar.","poem":4},{"noteId":9}]}],"footnotes":[{"noteId":3,"caller":"-","text":"bleknarOklar betydelse. Annan översättning: ”blossar röda”.","reference":{"chapter":2,"verse":6}},{"noteId":4,"caller":"-","text":"utan att hejdasGrundtextens innebörd är osäker.","reference":{"chapter":2,"verse":8}},{"noteId":5,"caller":"-","text":"havet i öster … havet i västerDöda havet och Medelhavet.","reference":{"chapter":2,"verse":20}},{"noteId":6,"caller":"-","text":"Läraren till rättfärdighetAnnan översättning: ”höstregnet i rätt tid”. Gud gav det livsnödvändiga regnet när förbundet efterlevdes (3 Mos 26:4, 5 Mos 11:14).","reference":{"chapter":2,"verse":23}},{"noteId":7,"caller":"-","text":"äta … bli mätta … lovaAnspelning på den utlovade välsignelsen i 5 Mos 8:10.","reference":{"chapter":2,"verse":26}},{"noteId":8,"caller":"-","text":"Citeras av Petrus i Apg 2:17f som profetia om Andens utgjutelse på pingstdagen.","reference":{"chapter":2,"verse":28}},{"noteId":9,"caller":"-","text":"Citeras av Paulus i Rom 10:13 som profetia om frälsning genom tro på Kristus.","reference":{"chapter":2,"verse":32}}]},"thisChapterLink":"/api/swe_fol/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}