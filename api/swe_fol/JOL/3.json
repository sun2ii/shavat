{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"JOL","translationId":"swe_fol","name":"Joel","commonName":"Joel","title":"Joel","order":29,"numberOfChapters":3,"sha256":"c4d30a5edd6a42842d99be551a643d585cc6d76fce47cf766d1844638121192c","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Guds dom över Israels fiender"]},{"type":"verse","number":1,"content":["För se, i de dagarna",{"text":"och på den tiden,","poem":3},{"text":"när jag gör slut på","poem":2},{"text":"Judas och Jerusalems fångenskap,","poem":3}]},{"type":"verse","number":2,"content":[{"text":"ska jag samla alla hednafolk","poem":1},{"text":"och föra dem ner till Joshafats","poem":3},{"noteId":10},{"text":"dal.","poem":3},{"text":"Där ska jag hålla dom över dem","poem":2},{"text":"för mitt folks skull,","poem":3},{"text":"min arvedel Israel","poem":2},{"text":"som de har skingrat","poem":3},{"text":"bland hednafolken.","poem":4},{"text":"De har delat mitt land","poem":2}]},{"type":"verse","number":3,"content":[{"text":"och kastat lott om mitt folk.","poem":1},{"text":"De betalade en prostituerad","poem":2},{"text":"med en pojke","poem":3},{"text":"och sålde en flicka för vin","poem":2},{"text":"som de drack upp.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":["Och du Tyrus och du Sidon, och ni Filisteens alla trakter, vad vill ni mig? Vill ni hämnas på mig för något? Om ni hämnas på mig, ska jag snabbt och med hast vända tillbaka er hämnd över era egna huvuden,"]},{"type":"verse","number":5,"content":["för ni har tagit mitt silver och mitt guld och fört bort mina dyrbaraste skatter in i era tempel."]},{"type":"verse","number":6,"content":["Folket i Juda och Jerusalem har ni sålt till grekerna för att skicka dem långt bort från sitt land."]},{"type":"verse","number":7,"content":["Se, jag ska väcka upp dem från den ort dit ni sålt dem, och det ni har gjort ska jag låta komma över era egna huvuden."]},{"type":"verse","number":8,"content":["Jag ska sälja era söner och döttrar till folket i Juda, och de ska sälja dem till sabeerna",{"noteId":11},", ett folk i fjärran land. Så har Herren talat."]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ropa ut det bland hednafolken,","poem":1},{"text":"kalla till helig strid.","poem":3},{"text":"Väck upp hjältarna,","poem":2},{"text":"låt alla krigsmän komma","poem":3},{"text":"och rycka fram.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Smid era plogbillar till svärd","poem":1},{"text":"och era vingårdsknivar till spjut.","poem":3},{"text":"Den svage ska säga: ”Jag är stark.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Skynda er att komma,","poem":1},{"text":"alla hednafolk häromkring,","poem":2},{"text":"och församla er.","poem":3},{"text":"Sänd, Herre, dina hjältar dit ner.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Låt hednafolken resa sig","poem":1},{"text":"och dra ut till Joshafats dal,","poem":3},{"text":"för där ska jag sitta till doms","poem":2},{"text":"över alla hednafolk häromkring.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Låt lien gå, för skörden är mogen.","poem":1},{"text":"Kom och trampa,","poem":2},{"text":"för pressen är full.","poem":3},{"text":"Presskaren flödar över,","poem":2},{"text":"för deras ondska är stor.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Det är skaror på skaror","poem":1},{"text":"i Domens dal,","poem":3},{"text":"för Herrens dag är nära","poem":2},{"text":"i Domens dal.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Solen och månen förmörkas","poem":1},{"text":"och stjärnorna mister sitt sken.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Herren ryter från Sion,","poem":1},{"text":"han låter sin röst höras","poem":2},{"text":"från Jerusalem","poem":4},{"text":"så att himlen och jorden bävar.","poem":3},{"text":"Men Herren är en tillflykt","poem":2},{"text":"för sitt folk,","poem":3},{"text":"ett skydd för Israels barn.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Och ni ska förstå","poem":1},{"text":"att jag är Herren er Gud","poem":2},{"text":"som bor på Sion, mitt heliga berg.","poem":3},{"text":"Jerusalem ska vara heligt,","poem":2},{"text":"och främlingar ska inte mer","poem":3},{"text":"ta vägen genom henne.","poem":4}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Och det ska ske på den tiden","poem":1},{"text":"att bergen ska drypa av druvsaft","poem":2},{"text":"och höjderna flöda av mjölk.","poem":3},{"text":"Alla bäckar i Juda","poem":2},{"text":"ska flöda av vatten.","poem":3},{"text":"En källa ska utgå från Herrens hus","poem":2},{"text":"och vattna Akaciedalen","poem":3},{"noteId":12},{"text":".","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Egypten ska bli en ödemark","poem":1},{"text":"och Edom en öde öken,","poem":3},{"text":"eftersom de brukat våld","poem":2},{"text":"mot Juda folk","poem":3},{"text":"och spillt oskyldigt blod","poem":2},{"text":"i deras land.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Juda ska vara bebott för alltid","poem":1},{"text":"och Jerusalem från släkte till släkte.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jag ska utplåna deras blodskulder,","poem":1},{"text":"dem som jag inte redan","poem":2},{"text":"har utplånat.","poem":3},{"text":"Herren bor på Sion.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"-","text":"Joshafatbetyder ”HERRENS håller dom” (jfr vers 14). Det är oklart vilken koppling dalen har till kung Joshafat som regerade i Juda ca 870-848 f Kr (1 Kung 22, 2 Krön 17-20).","reference":{"chapter":3,"verse":2}},{"noteId":11,"caller":"-","text":"sabeernaEtt folk i sydvästra Arabien (jfr Job 1:15, 6:19 och drottningen av Saba, 1 Kung 10).","reference":{"chapter":3,"verse":8}},{"noteId":12,"caller":"-","text":"AkaciedalenTroligen den torra wadi som går från Kidrondalen i sydostlig riktning mot Döda havet (jfr Hes 47:7f).","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/swe_fol/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}