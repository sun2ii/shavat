{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"LAM","translationId":"swe_fol","name":"Klagovisorna","commonName":"Klagovisorna","title":"Klagovisorna","order":25,"numberOfChapters":5,"sha256":"e5223ac4182751412c81ab1ddfbc2d0701a3d0cc7b8a6333a9edcdb3aa16a96a","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swe_fol/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"heading","content":["Jerusalems sorg och ödeläggelse"]},{"type":"heading","content":["אAlef"]},{"type":"verse","number":1,"content":["Så övergiven hon sitter,",{"text":"den folkrika staden!","poem":3},{"text":"Hon som var stor bland folken","poem":2},{"text":"har blivit som en änka,","poem":3},{"text":"furstinnan bland länderna","poem":2},{"text":"måste göra slavtjänst.","poem":3},{"noteId":0}]},{"type":"heading","content":["בBeth"]},{"type":"verse","number":2,"content":[{"text":"Bittert gråter hon i natten","poem":1},{"text":"med tårar på sin kind.","poem":3},{"text":"Ingen tröstare har hon","poem":2},{"text":"bland alla sina älskare.","poem":3},{"text":"Alla hennes vänner har svikit henne,","poem":2},{"text":"de har blivit hennes fiender.","poem":3}]},{"type":"heading","content":[]},{"type":"heading","content":["גGimel"]},{"type":"verse","number":3,"content":[{"text":"Juda har gått i landsflykt","poem":1},{"text":"efter förtryck och svårt slaveri.","poem":3},{"text":"Hon bor bland hednafolk","poem":2},{"text":"och finner ingen ro.","poem":3},{"text":"Alla hennes förföljare","poem":2},{"text":"har hunnit ifatt henne,","poem":3},{"text":"mitt i hennes nöd.","poem":4}]},{"type":"heading","content":["דDaleth"]},{"type":"verse","number":4,"content":[{"text":"Vägarna till Sion sörjer,","poem":1},{"text":"ingen kommer till högtiderna","poem":3},{"noteId":1},{"text":".","poem":3},{"text":"Alla hennes portar är öde,","poem":2},{"text":"hennes präster suckar.","poem":3},{"text":"Hennes jungfrur är bedrövade,","poem":2},{"text":"och själv sörjer hon bittert.","poem":3}]},{"type":"heading","content":["הHe"]},{"type":"verse","number":5,"content":[{"text":"Hennes ovänner har makten,","poem":1},{"text":"hennes fiender känner sig säkra,","poem":3},{"text":"eftersom Herren","poem":2},{"text":"har bedrövat henne","poem":3},{"text":"för hennes många synder.","poem":4},{"text":"Hennes barn har vandrat bort","poem":2},{"text":"som fångar framför fienden.","poem":3}]},{"type":"heading","content":["וWaw"]},{"type":"verse","number":6,"content":[{"text":"All sin prakt har dottern Sion förlorat.","poem":1},{"text":"Hennes furstar liknar hjortar","poem":2},{"text":"som inte funnit bete,","poem":3},{"text":"som kraftlösa flyr undan jägaren.","poem":2}]},{"type":"heading","content":["זZajin"]},{"type":"verse","number":7,"content":[{"text":"I sin nöd och hemlöshet","poem":1},{"text":"minns Jerusalem","poem":3},{"text":"alla skatter hon hade","poem":2},{"text":"i forna dagar.","poem":3},{"text":"Nu när hennes folk","poem":2},{"text":"har fallit i fienders hand","poem":3},{"text":"och ingen hjälpare finns,","poem":4},{"text":"ser de med hån","poem":2},{"text":"på hennes undergång.","poem":3}]},{"type":"heading","content":["חHeth"]},{"type":"verse","number":8,"content":[{"text":"Svårt har Jerusalem syndat,","poem":1},{"text":"därför har hon blivit oren","poem":3},{"noteId":2},{"text":".","poem":3},{"text":"Alla som ärat henne föraktar henne,","poem":2},{"text":"för de ser hennes nakenhet.","poem":3},{"text":"Själv suckar hon och vänder sig bort.","poem":2}]},{"type":"heading","content":["טTeth"]},{"type":"verse","number":9,"content":[{"text":"Orenhet fläckar hennes mantelflik,","poem":1},{"text":"hon tänkte inte","poem":2},{"text":"på hur slutet skulle bli.","poem":3},{"text":"Hon har sjunkit ofattbart djupt,","poem":2},{"text":"och ingen tröstare finns.","poem":3},{"text":"Herre, se mitt betryck,","poem":2},{"text":"för fienden triumferar!","poem":3}]},{"type":"heading","content":["יJod"]},{"type":"verse","number":10,"content":[{"text":"Fienden sträckte sin hand","poem":1},{"text":"efter alla hennes skatter.","poem":3},{"text":"Hon såg hur hedningar","poem":2},{"text":"gick in i hennes helgedom,","poem":3},{"text":"dem du förbjöd","poem":2},{"text":"att komma in i din församling.","poem":3},{"noteId":3}]},{"type":"heading","content":["כKaf"]},{"type":"verse","number":11,"content":[{"text":"Hela hennes folk suckar","poem":1},{"text":"och söker efter bröd.","poem":3},{"text":"De byter sina skatter mot mat","poem":2},{"text":"för att hålla sig vid liv.","poem":3},{"text":"Se, Herre, och tänk på","poem":2},{"text":"hur föraktad jag blivit!","poem":3}]},{"type":"heading","content":["לLamed"]},{"type":"verse","number":12,"content":[{"text":"Betyder det inget för alla er","poem":1},{"text":"som går vägen förbi?","poem":3},{"text":"Se efter och se:","poem":2},{"text":"finns det någon smärta","poem":3},{"text":"lik smärtan som drabbat mig,","poem":4},{"text":"som Herren har plågat mig med","poem":2},{"text":"på sin brinnande vredes dag?","poem":3}]},{"type":"heading","content":["מMem"]},{"type":"verse","number":13,"content":[{"text":"Han sände från höjden en eld","poem":1},{"text":"i mina ben och kuvade dem.","poem":3},{"noteId":4},{"text":"Han lade ut ett nät för mina fötter","poem":2},{"text":"och stötte mig tillbaka,","poem":3},{"text":"han lämnade mig övergiven","poem":2},{"text":"och sjuk dagen lång.","poem":3}]},{"type":"heading","content":["נNun"]},{"type":"verse","number":14,"content":[{"text":"Mina synder bands samman","poem":1},{"text":"till ett ok,","poem":3},{"text":"de vävdes ihop av hans hand","poem":2},{"text":"och lades på min nacke.","poem":3},{"text":"Han bröt min kraft,","poem":2},{"text":"Herren gav mig i händerna","poem":3},{"text":"på dem som jag inte kan stå emot.","poem":2}]},{"type":"heading","content":["סSamek"]},{"type":"verse","number":15,"content":[{"text":"Alla mina hjältar","poem":1},{"text":"har Herren förkastat,","poem":3},{"text":"han samlade ett uppbåd mot mig","poem":2},{"text":"för att krossa mina unga män.","poem":3},{"text":"Som en vinpress har Herren trampat","poem":2},{"text":"jungfrun dottern Juda.","poem":3}]},{"type":"heading","content":["עAjin"]},{"type":"verse","number":16,"content":[{"text":"Därför gråter jag,","poem":1},{"text":"mitt öga","poem":3},{"noteId":5},{"text":", mitt öga rinner av tårar,","poem":3},{"text":"för min tröstare är fjärran ifrån mig,","poem":2},{"text":"han som ger liv åt min själ.","poem":3},{"text":"Mina barn är övergivna,","poem":2},{"text":"för fienden har triumferat.","poem":3}]},{"type":"heading","content":["פPe"]},{"type":"verse","number":17,"content":[{"text":"Sion sträcker ut sina händer,","poem":1},{"text":"men ingen tröstare finns.","poem":3},{"text":"Herren har sänt Jakobs fiender","poem":2},{"text":"mot honom från alla håll,","poem":3},{"text":"Jerusalem har blivit som något orent","poem":2},{"text":"bland dem.","poem":3}]},{"type":"heading","content":["צTsade"]},{"type":"verse","number":18,"content":[{"text":"Herren är rättfärdig,","poem":1},{"text":"för jag gjorde uppror","poem":2},{"text":"mot hans bud.","poem":3},{"text":"Hör nu, alla ni folk,","poem":2},{"text":"och se min smärta!","poem":3},{"text":"Mina jungfrur och unga män","poem":2},{"text":"har gått i fångenskap.","poem":3}]},{"type":"heading","content":["קQof"]},{"type":"verse","number":19,"content":[{"text":"Jag kallade på mina älskare","poem":1},{"noteId":6},{"text":",","poem":1},{"text":"men de svek mig.","poem":3},{"text":"Mina präster och äldste","poem":2},{"text":"gick under i staden,","poem":3},{"text":"när de sökte efter mat","poem":2},{"text":"för att hålla sig vid liv.","poem":3}]},{"type":"heading","content":["רResh"]},{"type":"verse","number":20,"content":[{"text":"Se, Herre, jag är i nöd!","poem":1},{"text":"Det jäser inom mig,","poem":2},{"text":"mitt hjärta vänder sig i mitt bröst,","poem":3},{"text":"för jag har varit mycket upprorisk.","poem":2},{"text":"Därute tar svärdet mina barn,","poem":3},{"text":"härinne är det som döden.","poem":4}]},{"type":"heading","content":["שShin"]},{"type":"verse","number":21,"content":[{"text":"De hör hur jag suckar,","poem":1},{"text":"men ingen tröstare finns.","poem":3},{"text":"Alla mina fiender har hört","poem":2},{"text":"om min olycka,","poem":3},{"text":"de gläds att du gjort det här.","poem":2},{"text":"Dagen du förkunnat","poem":3},{"text":"lät du komma.","poem":4},{"text":"Men det ska gå dem","poem":2},{"text":"som det gått mig.","poem":3}]},{"type":"heading","content":["תTaw"]},{"type":"verse","number":22,"content":[{"text":"Låt all deras ondska","poem":1},{"text":"komma upp inför dig,","poem":3},{"text":"och gör med dem","poem":2},{"text":"som du gjort med mig","poem":3},{"text":"för alla mina synders skull,","poem":4},{"text":"för mina suckar är många","poem":2},{"text":"och mitt hjärta är sjukt.","poem":3}]}],"footnotes":[{"noteId":0,"caller":"-","text":"Septuaginta tillägger en inledning: ”När Israel hade förts bort i fångenskap och Jerusalem ödelagts, satt Jeremia och grät och sjöng denna klagosång över Jerusalem.”","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"-","text":"högtidernaVid påsken, pingsten och lövhyddohögtiden i oktober hade folket samlats i Jerusalem från hela landet (5 Mos 16:16). Nu var firandet ett minne blott.","reference":{"chapter":1,"verse":4}},{"noteId":2,"caller":"-","text":"orenHebr. niddáanvänds även om menstruation. Annan översättning: ”en som man skakar på huvudet åt”.","reference":{"chapter":1,"verse":8}},{"noteId":3,"caller":"-","text":"förbjöd att komma in i din församlingSe 5 Mos 23:3f, samt Ef 2:14 med not.","reference":{"chapter":1,"verse":10}},{"noteId":4,"caller":"-","text":"i mina ben och kuvade demAndra handskrifter (Septuaginta): ”ner i mina ben”. Skelettets ben symboliserar människans kärna och väsen (jfr Ps 32:3, 139:15).","reference":{"chapter":1,"verse":13}},{"noteId":5,"caller":"-","text":"ögaHebr. ájin kan också översättas ”källa”.","reference":{"chapter":1,"verse":16}},{"noteId":6,"caller":"-","text":"mina älskareAvgudadyrkande folk som förlett Israel till otrohet mot Herren (jfr Jer 4:30, Hes 16:33f, 23:5f, Hos 2:5f).","reference":{"chapter":1,"verse":19}}]},"thisChapterLink":"/api/swe_fol/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}