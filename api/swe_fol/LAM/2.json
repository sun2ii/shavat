{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"LAM","translationId":"swe_fol","name":"Klagovisorna","commonName":"Klagovisorna","title":"Klagovisorna","order":25,"numberOfChapters":5,"sha256":"e5223ac4182751412c81ab1ddfbc2d0701a3d0cc7b8a6333a9edcdb3aa16a96a","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swe_fol/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"heading","content":["Herren bestraffar sitt folk"]},{"type":"heading","content":["אAlef"]},{"type":"verse","number":1,"content":["Så mörka moln",{"text":"Herren i sin vrede","poem":2},{"text":"har täckt dottern Sion med!","poem":3},{"text":"Han kastade Israels härlighet","poem":2},{"text":"från himlen ner till jorden,","poem":3},{"text":"han tänkte inte på sin fotpall","poem":2},{"noteId":7},{"text":"på sin vredes dag.","poem":3}]},{"type":"heading","content":[]},{"type":"heading","content":["בBeth"]},{"type":"verse","number":2,"content":[{"text":"Utan att skona har Herren fördärvat","poem":1},{"text":"Jakobs alla boningar.","poem":3},{"text":"I sin vrede rev han","poem":2},{"text":"dottern Judas fästningar","poem":3},{"text":"och slog dem till marken,","poem":4},{"text":"han orenade riket och dess furstar.","poem":2}]},{"type":"heading","content":["גGimel"]},{"type":"verse","number":3,"content":[{"text":"I vredens hetta högg han av","poem":1},{"text":"Israels alla horn.","poem":3},{"text":"Han drog undan sin högra hand","poem":2},{"text":"när fienden kom,","poem":3},{"text":"och brann i Jakob","poem":2},{"text":"likt en flammande eld","poem":3},{"text":"som förtär allt runt omkring.","poem":4}]},{"type":"heading","content":["דDaleth"]},{"type":"verse","number":4,"content":[{"text":"Han spände sin båge som en fiende,","poem":1},{"text":"stod redo med sin högra hand","poem":2},{"text":"som en ovän,","poem":3},{"text":"och dödade allt","poem":2},{"text":"som var ljuvligt för ögat.","poem":3},{"text":"Över dottern Sions hydda","poem":2},{"text":"öste han sin vrede som eld.","poem":3}]},{"type":"heading","content":["הHe"]},{"type":"verse","number":5,"content":[{"text":"Herren var som en fiende.","poem":1},{"text":"Han fördärvade Israel,","poem":2},{"text":"han fördärvade alla dess borgar,","poem":3},{"text":"han förstörde dess fästningar.","poem":4},{"text":"Han hopade sorg på sorg","poem":2},{"text":"över dottern Juda.","poem":3}]},{"type":"heading","content":["וWaw"]},{"type":"verse","number":6,"content":[{"text":"Han skövlade sin boning","poem":1},{"text":"som en trädgård,","poem":3},{"text":"han förstörde sin mötesplats.","poem":2},{"text":"Herren lät högtid och sabbat","poem":1},{"text":"falla i glömska i Sion,","poem":3},{"text":"i sin brinnande vrede","poem":2},{"text":"förkastade han kung och präst.","poem":3}]},{"type":"heading","content":["זZajin"]},{"type":"verse","number":7,"content":[{"text":"Herren förkastade sitt altare,","poem":1},{"text":"han övergav sin helgedom.","poem":3},{"text":"Murarna runt hennes palats","poem":2},{"text":"gav han i fienders hand,","poem":3},{"text":"de ropade högt i Herrens hus","poem":2},{"text":"som på en högtidsdag.","poem":3}]},{"type":"heading","content":["חHeth"]},{"type":"verse","number":8,"content":[{"text":"Herren beslöt att förstöra","poem":1},{"text":"dottern Sions murar,","poem":3},{"text":"han spände ut mätsnöret","poem":2},{"text":"och drog inte undan sin hand","poem":3},{"text":"från skövlingen.","poem":4},{"text":"Han sände sorg över vallar","poem":2},{"text":"och murar,","poem":4},{"text":"allt ligger nu förstört.","poem":3}]},{"type":"heading","content":["טTeth"]},{"type":"verse","number":9,"content":[{"text":"Hennes portar sjönk ner i jorden,","poem":1},{"text":"han knäckte och krossade","poem":2},{"text":"hennes bommar.","poem":3},{"text":"Hennes kung och furstar","poem":2},{"text":"bor bland hednafolken,","poem":3},{"text":"ingen undervisning ges","poem":2},{"text":"och hennes profeter får ingen syn","poem":3},{"text":"från Herren.","poem":4}]},{"type":"heading","content":["יJod"]},{"type":"verse","number":10,"content":[{"text":"Dottern Sions äldste","poem":1},{"text":"sitter stumma på marken,","poem":3},{"text":"de kastar stoft över sitt huvud","poem":2},{"text":"och klär sig i säcktyg.","poem":3},{"text":"Jerusalems jungfrur","poem":2},{"text":"sänker sina huvuden mot jorden.","poem":3}]},{"type":"heading","content":["כKaf"]},{"type":"verse","number":11,"content":[{"text":"Mina ögon förtärs av gråt,","poem":1},{"text":"det jäser i mitt inre,","poem":2},{"text":"min lever","poem":3},{"noteId":8},{"text":"rinner ut på jorden,","poem":3},{"text":"för dottern mitt folk går under,","poem":2},{"text":"barn och spädbarn förgås","poem":3},{"text":"på stadens gator.","poem":4}]},{"type":"heading","content":["לLamed"]},{"type":"verse","number":12,"content":[{"text":"De ropar till sina mödrar:","poem":1},{"text":"”Var finns bröd och vin?”","poem":3},{"text":"De tynar bort som slagna","poem":2},{"text":"på stadens gator,","poem":3},{"text":"de ger upp andan","poem":2},{"text":"i sina mödrars famn.","poem":3}]},{"type":"heading","content":["מMem"]},{"type":"verse","number":13,"content":[{"text":"Vad ska jag säga dig,","poem":1},{"text":"vad ska jag likna dig med,","poem":2},{"text":"du dotter Jerusalem?","poem":3},{"text":"Vad ska jag jämföra dig med","poem":2},{"text":"för att trösta dig,","poem":3},{"text":"du jungfru dotter Sion?","poem":4},{"text":"Din skada är ju stor som havet,","poem":2},{"text":"vem kan hela dig?","poem":3}]},{"type":"heading","content":["נNun"]},{"type":"verse","number":14,"content":[{"text":"Dina profeters syner","poem":1},{"text":"var falska och dåraktiga,","poem":3},{"text":"de visade dig inte din skuld","poem":2},{"text":"för att vända bort din fångenskap","poem":3},{"noteId":9},{"text":".","poem":3},{"text":"De budskap de förkunnade för dig","poem":2},{"text":"var falska och förföriska.","poem":3}]},{"type":"heading","content":["סSamek"]},{"type":"verse","number":15,"content":[{"text":"Alla som går vägen förbi","poem":1},{"text":"slår ihop sina händer","poem":2},{"text":"och hånar dig,","poem":3},{"text":"de visslar och skakar på huvudet","poem":2},{"text":"åt dottern Jerusalem:","poem":3},{"text":"”Är detta den stad som kallades","poem":2},{"text":"skönhetens krona,","poem":3},{"text":"hela jordens fröjd?”","poem":4}]},{"type":"heading","content":["פPe"]},{"type":"verse","number":16,"content":[{"text":"Alla dina fiender spärrar upp","poem":1},{"text":"sin mun mot dig,","poem":3},{"text":"de visslar och gnisslar tänder","poem":2},{"text":"och säger: ”Vi har slukat henne!","poem":3},{"text":"Detta är dagen vi väntat på.","poem":2},{"text":"Vi fick uppleva den,","poem":3},{"text":"vi fick se den!”","poem":4}]},{"type":"heading","content":["עAjin"]},{"type":"verse","number":17,"content":[{"text":"Herren har gjort vad han bestämt,","poem":1},{"text":"han har uppfyllt sitt ord","poem":2},{"text":"som han uttalat för länge sedan.","poem":3},{"text":"Han har rivit utan att skona,","poem":2},{"text":"han har låtit fienden","poem":3},{"text":"triumfera över dig","poem":4},{"text":"och upphöjt dina motståndares horn.","poem":2}]},{"type":"heading","content":["צTsade"]},{"type":"verse","number":18,"content":[{"text":"Deras hjärtan ropar till Herren.","poem":1},{"text":"Du dotter Sions mur,","poem":2},{"text":"låt tårarna rinna som en bäck","poem":3},{"text":"både dag och natt.","poem":4},{"text":"Ge dig ingen ro,","poem":2},{"text":"unna inte ditt öga någon vila.","poem":3}]},{"type":"heading","content":["קQof"]},{"type":"verse","number":19,"content":[{"text":"Stig upp, ropa högt i natten","poem":1},{"text":"när nattväkterna","poem":3},{"noteId":10},{"text":"börjar.","poem":3},{"text":"Utgjut ditt hjärta som vatten","poem":2},{"text":"inför Herrens ansikte,","poem":3},{"text":"lyft dina händer till honom","poem":2},{"text":"för dina barns liv","poem":3},{"text":"som tynar bort av hunger","poem":2},{"text":"i alla gathörn.","poem":3}]},{"type":"heading","content":["רResh"]},{"type":"verse","number":20,"content":[{"text":"Se, Herre, och tänk på","poem":1},{"text":"vem du gjort så emot.","poem":3},{"text":"Ska kvinnor äta sin livsfrukt,","poem":2},{"text":"barnen de burit i sin famn?","poem":3},{"text":"Ska präster och profeter dödas","poem":2},{"text":"i Herrens helgedom?","poem":3}]},{"type":"heading","content":["שShin"]},{"type":"verse","number":21,"content":[{"text":"På marken, på gatorna","poem":1},{"text":"ligger unga och gamla.","poem":3},{"text":"Mina jungfrur och unga män","poem":2},{"text":"har fallit för svärd,","poem":3},{"text":"du har dödat på din vredes dag,","poem":2},{"text":"slaktat utan att skona.","poem":3}]},{"type":"heading","content":["תTaw"]},{"type":"verse","number":22,"content":[{"text":"Som till högtidsdag bjöd du in","poem":1},{"text":"skräck från alla håll.","poem":3},{"text":"På Herrens vredes dag","poem":2},{"text":"var det ingen som kom undan","poem":3},{"text":"eller överlevde.","poem":4},{"text":"Dem som jag burit","poem":2},{"text":"i famnen och fostrat","poem":3},{"text":"har min fiende förgjort.","poem":4}]}],"footnotes":[{"noteId":7,"caller":"-","text":"fotpallTroligen förbundsarken (Ps 132:7), över vilken Gud uppenbarade sig (4 Mos 7:89).","reference":{"chapter":2,"verse":1}},{"noteId":8,"caller":"-","text":"min leverAnnan översättning (så Septuaginta): ”min ära”.","reference":{"chapter":2,"verse":11}},{"noteId":9,"caller":"-","text":"vända bort din fångenskapAnnan översättning: ”upprätta dig”.","reference":{"chapter":2,"verse":14}},{"noteId":10,"caller":"-","text":"nattväkternaVarje natt var indelad i tre väkter eller fyratimmarsperioder (Dom 7:19).","reference":{"chapter":2,"verse":19}}]},"thisChapterLink":"/api/swe_fol/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}