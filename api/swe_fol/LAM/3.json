{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"LAM","translationId":"swe_fol","name":"Klagovisorna","commonName":"Klagovisorna","title":"Klagovisorna","order":25,"numberOfChapters":5,"sha256":"e5223ac4182751412c81ab1ddfbc2d0701a3d0cc7b8a6333a9edcdb3aa16a96a","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swe_fol/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["Lidande och hopp"]},{"type":"heading","content":["אAlef"]},{"type":"verse","number":1,"content":["Jag är mannen",{"text":"som fått se lidande","poem":2},{"lineBreak":true},{"text":"under hans vredes ris.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Han har lett mig och fört mig","poem":1},{"text":"i mörker och inte i ljus.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ja, han vände sin hand mot mig","poem":1},{"text":"gång på gång, dagen lång.","poem":2}]},{"type":"heading","content":["בBeth"]},{"type":"verse","number":4,"content":[{"text":"Han nötte ut mitt kött och min hud,","poem":1},{"text":"han krossade mina ben.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Han byggde en mur mot mig","poem":1},{"text":"och omringade mig","poem":2},{"text":"med bitterhet och möda.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"På mörka platser lät han mig bo,","poem":1},{"text":"likt dem som länge varit döda.","poem":2}]},{"type":"heading","content":["גGimel"]},{"type":"verse","number":7,"content":[{"text":"Han har spärrat in mig","poem":1},{"text":"så att jag inte kommer ut,","poem":3},{"text":"han har lagt på mig tunga bojor.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hur jag än klagar och ropar","poem":1},{"text":"stänger han ute min bön.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han har spärrat mina vägar","poem":1},{"text":"med huggen sten","poem":3},{"text":"och gjort mina stigar krokiga.","poem":2}]},{"type":"heading","content":["דDaleth"]},{"type":"verse","number":10,"content":[{"text":"Han var en björn på lur mot mig,","poem":1},{"text":"ett lejon i försåt.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Han förde mig på avvägar","poem":1},{"text":"och slet mig i stycken,","poem":3},{"text":"han lät mig ligga övergiven.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Han spände sin båge","poem":1},{"text":"och ställde mig som mål för sin pil.","poem":2}]},{"type":"heading","content":["הHe"]},{"type":"verse","number":13,"content":[{"text":"Pilar från sitt koger","poem":1},{"text":"har han satt i mina njurar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jag har blivit till åtlöje","poem":1},{"text":"för hela mitt folk,","poem":3},{"text":"deras nidvisa hela dagen lång.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Han har mättat mig med bitterhet,","poem":1},{"text":"gett mig malört att dricka.","poem":2}]},{"type":"heading","content":["וWaw"]},{"type":"verse","number":16,"content":[{"text":"Han har krossat mina tänder","poem":1},{"text":"mot stenar,","poem":3},{"text":"han har tryckt ner mig i askan.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Du har fördrivit min själ från friden,","poem":1},{"text":"jag har glömt vad lycka är.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jag sade:","poem":1},{"text":"”Det är slut med min livskraft","poem":2},{"text":"och mitt hopp till Herren.”","poem":3}]},{"type":"heading","content":["זZajin"]},{"type":"verse","number":19,"content":[{"text":"Tänk på min nöd och min hemlöshet,","poem":1},{"text":"malörten och det bittra!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Min själ tänker ständigt på det","poem":1},{"text":"och sjunker ihop inom mig.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Detta tar jag till hjärtat,","poem":1},{"text":"därför har jag hopp:","poem":2}]},{"type":"heading","content":["חHeth"]},{"type":"verse","number":22,"content":[{"text":"Det är Herrens nåd","poem":1},{"text":"att det inte är ute med oss,","poem":3},{"text":"att","poem":2},{"noteId":11},{"text":"det inte är slut","poem":2},{"text":"med hans barmhärtighet.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Den är ny varje morgon,","poem":1},{"text":"stor är din trofasthet.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Herren är min del,","poem":1},{"text":"det säger min själ,","poem":3},{"text":"därför hoppas jag på honom.","poem":2}]},{"type":"heading","content":["טTeth"]},{"type":"verse","number":25,"content":[{"text":"Herren är god","poem":1},{"text":"mot dem som väntar på honom,","poem":2},{"text":"mot den själ som söker honom.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Det är gott att i stillhet","poem":1},{"text":"hoppas på hjälp från Herren.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Det är gott för en man","poem":1},{"text":"att bära ett ok i sin ungdom.","poem":2}]},{"type":"heading","content":["יJod"]},{"type":"verse","number":28,"content":[{"text":"Må han sitta ensam och tyst","poem":1},{"text":"när han lägger det på honom.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Må han sänka sin mun i stoftet,","poem":1},{"text":"kanske finns det ännu hopp.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Må han vända kinden","poem":1},{"text":"mot den som slår honom","poem":3},{"text":"och låta sig mättas av hån.","poem":2}]},{"type":"heading","content":["כKaf"]},{"type":"verse","number":31,"content":[{"text":"Herren förkastar ju inte","poem":1},{"text":"för evigt.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Om än han bedrövar","poem":1},{"text":"förbarmar han sig i sin stora nåd,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"för det är inte av hjärtat","poem":1},{"text":"han plågar och bedrövar","poem":2},{"text":"människors barn.","poem":3}]},{"type":"heading","content":["לLamed"]},{"type":"verse","number":34,"content":[{"text":"När man krossar landets alla fångar","poem":1},{"text":"under sina fötter,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"när man nekar en man hans rätt","poem":1},{"text":"inför den Högstes ansikte,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"när man gör orätt mot någon","poem":1},{"text":"i hans sak –","poem":3},{"text":"skulle Herren inte se det?","poem":2}]},{"type":"heading","content":["מMem"]},{"type":"verse","number":37,"content":[{"text":"Vem talar så att det sker,","poem":1},{"text":"om inte Herren befallt det?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Kommer inte både ont","poem":1},{"noteId":12},{"text":"och gott","poem":1},{"text":"från den Högstes mun?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Varför klagar en människa här i livet","poem":1},{"text":"när hon straffas","poem":2},{"noteId":13},{"text":"för sin synd?","poem":2}]},{"type":"heading","content":["נNun"]},{"type":"verse","number":40,"content":[{"text":"Låt oss pröva våra vägar","poem":1},{"text":"och granska dem,","poem":3},{"text":"låt oss vända om till Herren!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Låt oss lyfta våra hjärtan och händer","poem":1},{"text":"till Gud i himlen!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Vi har syndat och gjort uppror,","poem":1},{"text":"och du har inte förlåtit.","poem":2}]},{"type":"heading","content":["סSamek"]},{"type":"verse","number":43,"content":[{"text":"Du har dolt dig i vrede","poem":1},{"text":"och förföljt oss,","poem":3},{"text":"du har dödat och inte skonat.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Du har dolt dig i moln","poem":1},{"text":"så att bönen inte når fram,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"du har gjort oss till avskum","poem":1},{"text":"och förakt bland folken.","poem":2}]},{"type":"heading","content":["פPe"]},{"type":"verse","number":46,"content":[{"text":"Alla våra fiender","poem":1},{"text":"spärrar upp sitt gap mot oss.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Faror och fallgropar möter oss,","poem":1},{"text":"förödelse och undergång.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Strömmar av tårar","poem":1},{"text":"rinner från mitt öga,","poem":3},{"text":"för dottern mitt folk går under.","poem":2}]},{"type":"heading","content":["עAjin"]},{"type":"verse","number":49,"content":[{"text":"Mitt öga flödar utan uppehåll,","poem":1},{"text":"det får ingen vila","poem":2}]},{"type":"verse","number":50,"content":[{"text":"förrän Herren blickar ner","poem":1},{"text":"från himlen och ser.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Mitt öga plågar min själ","poem":1},{"text":"när jag ser min stads alla döttrar","poem":2},{"noteId":14},{"text":".","poem":2}]},{"type":"heading","content":["צTsade"]},{"type":"verse","number":52,"content":[{"text":"De jagade mig som en fågel,","poem":1},{"text":"de som utan orsak är mina fiender.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"De ville släcka mitt liv här i gropen,","poem":1},{"text":"de kastade sten över mig.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Vattnen sköljde över mitt huvud,","poem":1},{"text":"jag sade: ”Jag är förlorad!”","poem":2}]},{"type":"heading","content":["קQof"]},{"type":"verse","number":55,"content":[{"text":"Jag åkallade ditt namn, Herre,","poem":1},{"text":"från gropens djup.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Du har hört min röst,","poem":1},{"text":"stäng inte ditt öra","poem":2},{"text":"när jag ber om lindring och ropar.","poem":3}]},{"type":"verse","number":57,"content":[{"text":"Du kom nära när jag åkallade dig,","poem":1},{"text":"du sade: ”Var inte rädd!”","poem":2}]},{"type":"heading","content":["רResh"]},{"type":"verse","number":58,"content":[{"text":"Herre, du tar dig an min sak,","poem":1},{"text":"du friköper mitt liv.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Herre, du ser den orätt jag lider,","poem":1},{"text":"döm i min sak!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Du ser all deras hämndlystnad,","poem":1},{"text":"alla deras planer mot mig.","poem":2}]},{"type":"heading","content":["שShin"]},{"type":"verse","number":61,"content":[{"text":"Du har hört deras hån, Herre,","poem":1},{"text":"alla deras planer mot mig,","poem":2}]},{"type":"verse","number":62,"content":[{"text":"mina fienders tal och onda tankar","poem":1},{"text":"mot mig dagen lång.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Se! Vare sig de sitter eller står","poem":1},{"text":"är det mig de hånar i sin sång.","poem":2}]},{"type":"heading","content":["תTaw"]},{"type":"verse","number":64,"content":[{"text":"Du ska återgälda dem, Herre,","poem":1},{"text":"efter deras händers verk.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Du ska ge dem en slöja över hjärtat,","poem":1},{"text":"din förbannelse ska drabba dem.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Du ska jaga dem i vrede","poem":1},{"text":"och förgöra dem","poem":2},{"text":"under Herrens himmel.","poem":3}]}],"footnotes":[{"noteId":11,"caller":"-","text":"Det är HERRENS nåd att det inte är ute med oss, attAndra handskrifter (så Peshitta): ”HERRENS nåd sinar inte, för”.","reference":{"chapter":3,"verse":22}},{"noteId":12,"caller":"-","text":"ontStraffdom och tuktan (5 Mos 28:15f), inte orätt och ondska (Job 34:10, 1 Joh 1:5).","reference":{"chapter":3,"verse":38}},{"noteId":13,"caller":"-","text":"när hon straffas förAnnan översättning: ”en man över”.","reference":{"chapter":3,"verse":39}},{"noteId":14,"caller":"-","text":"döttrarAntingen stadens kvinnor eller byarna kring Jerusalem (jfr Ps 48:12 med not).","reference":{"chapter":3,"verse":51}}]},"thisChapterLink":"/api/swe_fol/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}