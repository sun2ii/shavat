{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"LAM","translationId":"swe_fol","name":"Klagovisorna","commonName":"Klagovisorna","title":"Klagovisorna","order":25,"numberOfChapters":5,"sha256":"e5223ac4182751412c81ab1ddfbc2d0701a3d0cc7b8a6333a9edcdb3aa16a96a","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swe_fol/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"heading","content":["Sions elände och vanära"]},{"type":"heading","content":["אAlef"]},{"type":"verse","number":1,"content":["Så matt guldet har blivit,",{"text":"det ädlaste guldet förvandlats!","poem":3},{"text":"Heliga ädelstenar ligger spridda","poem":2},{"text":"i varje gathörn.","poem":3}]},{"type":"heading","content":["בBeth"]},{"type":"verse","number":2,"content":[{"text":"Sions ädlaste söner","poem":1},{"text":"skattades som fint guld.","poem":3},{"text":"Nu räknas de som lerkärl,","poem":2},{"text":"som verk av krukmakarhänder.","poem":3}]},{"type":"heading","content":["גGimel"]},{"type":"verse","number":3,"content":[{"text":"Till och med schakaler","poem":1},{"text":"räcker fram sina spenar","poem":2},{"text":"och låter ungarna dia,","poem":3},{"text":"men dottern mitt folk","poem":2},{"text":"har blivit grym","poem":4},{"noteId":15},{"text":",","poem":4},{"text":"som strutsen i öknen.","poem":3}]},{"type":"heading","content":["דDaleth"]},{"type":"verse","number":4,"content":[{"text":"Dibarnets tunga fastnar","poem":1},{"text":"i gommen av törst.","poem":3},{"text":"Små barn ber om bröd,","poem":2},{"text":"men ingen ger dem något.","poem":3}]},{"type":"heading","content":["הHe"]},{"type":"verse","number":5,"content":[{"text":"De som förr åt läckerheter","poem":1},{"text":"tynar bort på gatorna.","poem":3},{"text":"De som växte upp i purpur","poem":2},{"noteId":16},{"text":"ligger nu i dyn.","poem":3}]},{"type":"heading","content":["וWaw"]},{"type":"verse","number":6,"content":[{"text":"Missgärningen hos dottern mitt folk","poem":1},{"text":"är större än synden i Sodom,","poem":3},{"noteId":17},{"text":"som ödelades på ett ögonblick","poem":2},{"text":"utan att röras av människohänder.","poem":3}]},{"type":"heading","content":["זZajin"]},{"type":"verse","number":7,"content":[{"text":"Hennes furstar glänste mer än snö,","poem":1},{"text":"de var vitare än mjölk,","poem":3},{"text":"deras kroppar var rödare än korall,","poem":2},{"text":"deras gestalter var som safir.","poem":3}]},{"type":"heading","content":["חHeth"]},{"type":"verse","number":8,"content":[{"text":"Nu är deras ansikten mörkare än sot,","poem":1},{"text":"man känner inte igen dem","poem":2},{"text":"på gatorna.","poem":3},{"text":"Deras hud stramar över benen,","poem":1},{"text":"den är torr som trä.","poem":2}]},{"type":"heading","content":["טTeth"]},{"type":"verse","number":9,"content":[{"text":"Lyckligare var de som dödades","poem":1},{"text":"med svärd","poem":4},{"text":"än de som nu dödas av hunger,","poem":3},{"text":"som tynar bort i plåga","poem":2},{"text":"av brist på markens frukter.","poem":3}]},{"type":"heading","content":["יJod"]},{"type":"verse","number":10,"content":[{"text":"Med egna händer","poem":1},{"text":"har ömsinta mödrar kokat","poem":2},{"text":"sina barn","poem":3},{"text":"för att ha dem till föda","poem":2},{"text":"när dottern mitt folk gick under.","poem":3}]},{"type":"heading","content":["כKaf"]},{"type":"verse","number":11,"content":[{"text":"Herren tömde ut sin vrede,","poem":1},{"text":"han öste ut sin vredesglöd.","poem":3},{"text":"I Sion tände han en eld","poem":2},{"text":"som förtärde dess grundvalar.","poem":3}]},{"type":"heading","content":["לLamed"]},{"type":"verse","number":12,"content":[{"text":"Ingen av jordens kungar","poem":1},{"text":"hade trott det,","poem":3},{"noteId":18},{"text":"ingen av världens invånare,","poem":2},{"text":"att någon ovän eller fiende","poem":3},{"text":"skulle komma in","poem":2},{"text":"genom Jerusalems portar.","poem":3}]},{"type":"heading","content":["מMem"]},{"type":"verse","number":13,"content":[{"text":"Det kom för hennes profeters synder","poem":1},{"text":"och hennes prästers","poem":3},{"text":"missgärningar,","poem":4},{"text":"för att de spillde rättfärdigas blod","poem":2},{"text":"där inne i staden.","poem":3}]},{"type":"heading","content":["נNun"]},{"type":"verse","number":14,"content":[{"text":"Som blinda irrar de på gatorna,","poem":1},{"text":"fläckade av blod","poem":3},{"text":"så att ingen vågar röra","poem":2},{"text":"deras kläder.","poem":3}]},{"type":"heading","content":["סSamek"]},{"type":"verse","number":15,"content":[{"text":"”Bort! Oren!”","poem":1},{"text":"ropar man till dem.","poem":3},{"text":"”Bort, bort! Rör dem inte!”","poem":2},{"text":"De flyr, de irrar omkring.","poem":3},{"text":"Bland hednafolken säger man:","poem":2},{"text":"”Här får de inte bo längre.”","poem":3}]},{"type":"heading","content":["פPe"]},{"type":"verse","number":16,"content":[{"text":"Herren själv har skingrat dem,","poem":1},{"text":"han vill inte ta sig an dem mer.","poem":3},{"text":"Prästerna får ingen respekt,","poem":2},{"text":"de äldre får ingen barmhärtighet.","poem":3}]},{"type":"heading","content":["עAjin"]},{"type":"verse","number":17,"content":[{"text":"Våra ögon sviker oss","poem":1},{"text":"när vi förgäves söker efter hjälp.","poem":3},{"text":"Vi har spanat och spanat","poem":2},{"text":"efter ett folk som ändå inte kan","poem":3},{"text":"rädda oss.","poem":4},{"noteId":19}]},{"type":"heading","content":["צTsade"]},{"type":"verse","number":18,"content":[{"text":"De vaktar på våra steg","poem":1},{"text":"så att vi inte vågar gå","poem":2},{"text":"på våra gator.","poem":3},{"text":"Vårt slut är nära,","poem":2},{"text":"våra dagar är ute,","poem":3},{"text":"ja, vårt slut har kommit.","poem":2}]},{"type":"heading","content":["קQof"]},{"type":"verse","number":19,"content":[{"text":"Våra förföljare var snabbare","poem":1},{"text":"än himlens örnar.","poem":3},{"text":"De jagade oss över bergen","poem":2},{"text":"och låg på lur i öknen för oss.","poem":3}]},{"type":"heading","content":["רResh"]},{"type":"verse","number":20,"content":[{"text":"Vår livsande, Herrens smorde,","poem":1},{"noteId":20},{"text":"fångades i deras fallgropar.","poem":3},{"text":"Om honom sade vi:","poem":2},{"text":"”I hans skugga ska vi leva","poem":3},{"text":"bland hednafolken.”","poem":4}]},{"type":"heading","content":["שShin"]},{"type":"verse","number":21,"content":[{"text":"Gläd dig och jubla, dotter Edom","poem":1},{"noteId":21},{"text":",","poem":1},{"text":"du som bor i landet Us.","poem":3},{"text":"Bägaren ska komma till dig också,","poem":2},{"text":"du ska bli drucken","poem":3},{"text":"och ligga naken.","poem":4}]},{"type":"heading","content":["תTaw"]},{"type":"verse","number":22,"content":[{"text":"Straffet för din skuld har nått sitt slut,","poem":1},{"text":"dotter Sion.","poem":3},{"text":"Han ska inte mer föra bort dig","poem":2},{"text":"i fångenskap.","poem":3},{"text":"Men din skuld, dotter Edom,","poem":2},{"text":"ska han straffa,","poem":3},{"text":"han ska avslöja dina synder.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"-","text":"grymStrutsen lämnar sina ägg direkt på marken och var därför en bild för bristande omsorg (jfr Job 39:16f).","reference":{"chapter":4,"verse":3}},{"noteId":16,"caller":"-","text":"purpurAntikens dyraste färg. Den utvanns ur havssnäckor och var värd sin vikt i silver.","reference":{"chapter":4,"verse":5}},{"noteId":17,"caller":"-","text":"SodomStad vid Döda havet som utplånades för sin ondska (1 Mos 19, Hes 16:49f, Jud v 7).","reference":{"chapter":4,"verse":6}},{"noteId":18,"caller":"-","text":"Ingen ... hade trott detSion ansågs ointagligt så länge man hade Guds beskydd (Ps 46, 48).","reference":{"chapter":4,"verse":12}},{"noteId":19,"caller":"-","text":"ett folk som ändå inte kan rädda ossEgypten, vars militära hjälp svek (Jer 2:36, 37:7, Jes 30:2f).","reference":{"chapter":4,"verse":17}},{"noteId":20,"caller":"-","text":"HERRENS smordeGuds utvalde, helgade kung, en förebild till Messias/Kristus (Apg 10:38). De sista kungarna var Jojakin (598-597 f Kr) och Sidkia (597-587 f Kr). Se 2 Kung 24:8f.","reference":{"chapter":4,"verse":20}},{"noteId":21,"caller":"-","text":"EdomGrannfolk i sydöst som hade sett på Jerusalems förstöring med skadeglädje (jfr Ps 137:7, Hes 25:12f och Ob vers 11).","reference":{"chapter":4,"verse":21}}]},"thisChapterLink":"/api/swe_fol/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}