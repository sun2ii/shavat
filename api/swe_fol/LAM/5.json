{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"LAM","translationId":"swe_fol","name":"Klagovisorna","commonName":"Klagovisorna","title":"Klagovisorna","order":25,"numberOfChapters":5,"sha256":"e5223ac4182751412c81ab1ddfbc2d0701a3d0cc7b8a6333a9edcdb3aa16a96a","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swe_fol/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["Folkets bön i djupaste förnedring"]},{"type":"verse","number":1,"content":["Tänk, Herre,",{"text":"på vad som hänt oss,","poem":3},{"text":"se efter och se hur vi hånas!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vår arvedel har gått över","poem":1},{"text":"till främlingar,","poem":3},{"text":"våra hus är i främmande hand.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vi har blivit föräldralösa,","poem":1},{"text":"vi har ingen far,","poem":3},{"text":"våra mödrar är som änkor.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vi måste köpa vårt eget vatten","poem":1},{"text":"som vi dricker,","poem":3},{"text":"betala för vår egen ved.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Våra förföljare flåsar oss i nacken","poem":1},{"noteId":22},{"text":",","poem":1},{"text":"vi är trötta men får ingen vila.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vi räckte ut vår hand till Egypten,","poem":1},{"text":"till Assyrien för att få bröd","poem":2},{"text":"att mätta oss med.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Våra fäder har syndat","poem":1},{"text":"och finns inte mer,","poem":3},{"text":"men vi måste bära deras skuld.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Slavar härskar över oss,","poem":1},{"text":"ingen befriar oss ur deras hand.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Med fara för vårt liv","poem":1},{"text":"hämtar vi vårt bröd,","poem":3},{"text":"bärgar det undan öknens svärd.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vår hud hettar som en ugn,","poem":1},{"text":"den är febersjuk av hunger.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kvinnor kränkte de i Sion,","poem":1},{"text":"jungfrur i Juda städer.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Furstar hängde de","poem":1},{"noteId":23},{"text":",","poem":1},{"text":"äldre hedrade de inte.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Unga män fick slita","poem":1},{"text":"med kvarnstenen","poem":3},{"noteId":24},{"text":",","poem":3},{"text":"pojkar dignade","poem":2},{"text":"under bördor av ved.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"De gamla sitter inte längre i porten,","poem":1},{"text":"de unga har slutat","poem":2},{"text":"med sin musik.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Glädjen är borta från vårt hjärta,","poem":1},{"text":"vår dans är förvandlad till sorg.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kronan har fallit från vårt huvud.","poem":1},{"text":"Ve oss, att vi syndade så!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Därför är vårt hjärta sjukt,","poem":1},{"text":"därför är våra ögon förmörkade,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"för att Sions berg ligger öde","poem":1},{"text":"och schakaler","poem":2},{"noteId":25},{"text":"strövar där.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Du, Herre, tronar för evigt,","poem":1},{"text":"din tron består","poem":2},{"text":"från släkte till släkte.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Varför skulle du glömma oss","poem":1},{"text":"för evigt,","poem":3},{"text":"överge oss för alltid?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ta oss till dig igen, Herre,","poem":1},{"text":"så kommer vi tillbaka.","poem":3},{"text":"Förnya våra dagar som förr,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"om du inte har förkastat oss helt","poem":1},{"text":"och är mycket vred på oss.","poem":2}]}],"footnotes":[{"noteId":22,"caller":"-","text":"flåsar oss i nackenAnnan översättning: ”har ett ok på vår nacke”.","reference":{"chapter":5,"verse":5}},{"noteId":23,"caller":"-","text":"hängde deAnnan översättning: ”hängdes upp i sina händer”.","reference":{"chapter":5,"verse":12}},{"noteId":24,"caller":"-","text":"slita med kvarnstenenFångar sattes ofta att mala säd till mjöl, en föraktad syssla (jfr Dom 16:21).","reference":{"chapter":5,"verse":13}},{"noteId":25,"caller":"-","text":"schakalerAnnan översättning: ”rävar”.","reference":{"chapter":5,"verse":18}}]},"thisChapterLink":"/api/swe_fol/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}