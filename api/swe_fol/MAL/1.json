{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MAL","translationId":"swe_fol","name":"Malaki","commonName":"Malaki","title":"Malaki","order":39,"numberOfChapters":4,"sha256":"5fe8f3608571134416c28b992137a120ada0404fab4ab0db557b58f85148fb6b","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/swe_fol/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Denna profetia är Herrens ord till Israel genom Malaki."]},{"type":"heading","content":["Herrens kärlek till Israel"]},{"type":"verse","number":2,"content":[{"noteId":0},{"text":"Jag har älskat er, säger Herren.","poem":1},{"text":"Och ni frågar:","poem":2},{"text":"”Hur har du älskat oss?”","poem":3},{"text":"Var inte Esau bror till Jakob?","poem":2},{"text":"säger Herren.","poem":3},{"text":"Jakob älskade jag,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"men Esau hatade jag.","poem":1},{"text":"Jag gjorde hans berg","poem":2},{"text":"till en ödemark","poem":3},{"noteId":1},{"text":"och gav hans arvedel","poem":2},{"text":"åt öknens schakaler.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Om Edom säger: ”Vi är krossade,","poem":1},{"text":"men vi ska bygga upp","poem":2},{"text":"ruinerna igen”,","poem":3},{"text":"så säger Herren Sebaot:","poem":2},{"text":"De bygger upp,","poem":3},{"text":"men jag ska riva ner.","poem":4},{"text":"De ska kallas","poem":2},{"text":"”gudlöshetens land”","poem":3},{"text":"och ”folket som Herren","poem":2},{"text":"är vred på för evigt”.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Era ögon ska se det,","poem":1},{"text":"och ni ska säga:","poem":3},{"text":"”Herren är upphöjd","poem":2},{"text":"utanför Israels gränser.”","poem":3}]},{"type":"heading","content":["Förakt för Herren"]},{"type":"verse","number":6,"content":[{"text":"En son hedrar sin far","poem":1},{"text":"och en tjänare sin herre.","poem":3},{"text":"Men om jag är en far,","poem":2},{"text":"var är då hedern jag borde få?","poem":3},{"text":"Och om jag är en herre,","poem":2},{"text":"var är då vördnaden för mig?","poem":3},{"text":"Detta säger Herren Sebaot","poem":2},{"text":"till er präster","poem":3},{"text":"som föraktar mitt namn.","poem":4},{"text":"Och ni frågar:","poem":2},{"text":"”Hur har vi föraktat ditt namn?”","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Genom att ni offrar oren mat","poem":1},{"text":"på mitt altare.","poem":3},{"text":"Och ni frågar:","poem":2},{"text":"”Hur har vi kränkt din renhet?”","poem":3},{"text":"Genom att ni säger:","poem":2},{"text":"”Herrens bord","poem":3},{"text":"betyder ingenting.”","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Om ni bär fram","poem":1},{"text":"ett blint djur som offer,","poem":2},{"text":"är inte det något ont?","poem":3},{"text":"Om ni bär fram","poem":1},{"text":"det som är lamt och sjukt,","poem":2},{"noteId":2},{"text":"är inte det något ont?","poem":3},{"text":"Kom med sådant","poem":2},{"text":"till din ståthållare","poem":3},{"noteId":3},{"text":"!","poem":3},{"text":"Tror du han blir glad","poem":2},{"text":"och tar emot dig?","poem":3},{"text":"säger Herren Sebaot.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Men bönfall nu inför Gud","poem":1},{"text":"att han förbarmar sig över oss.","poem":3},{"text":"När det kommer sådant","poem":2},{"text":"från era händer,","poem":3},{"text":"ska han då ta emot er?","poem":2},{"text":"säger Herren Sebaot.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Kan inte någon av er","poem":1},{"text":"stänga tempeldörrarna,","poem":3},{"text":"så att ni inte tänder min altareld","poem":2},{"text":"förgäves!","poem":3},{"text":"Jag har inte behag till er,","poem":2},{"text":"säger Herren Sebaot,","poem":3},{"text":"jag har ingen glädje","poem":2},{"text":"i offergåvorna från er hand.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Från solens uppgång","poem":1},{"text":"till dess nedgång","poem":3},{"text":"ska mitt namn vara stort","poem":2},{"text":"bland hednafolken.","poem":3},{"text":"På varje plats ska man bära fram","poem":2},{"text":"rökoffer och rena offergåvor","poem":3},{"text":"åt mitt namn.","poem":4},{"text":"Ja, mitt namn ska vara stort","poem":2},{"text":"bland hednafolken,","poem":3},{"text":"säger Herren Sebaot.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Men ni vanhelgar det när ni säger:","poem":1},{"text":"”Herrens bord är orent","poem":2},{"text":"och maten där är värdelös.”","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ni säger: ”Det är inte mödan värt!”","poem":1},{"text":"och fnyser åt det,","poem":2},{"text":"säger Herren Sebaot.","poem":3},{"text":"Ni kommer med stulna,","poem":2},{"text":"halta och sjuka djur","poem":3},{"text":"och bär fram det som offer.","poem":4},{"text":"Ska jag ta emot det från er","poem":2},{"text":"med glädje? säger Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Förbannad är den bedragare","poem":1},{"text":"som har ett djur av hankön","poem":2},{"text":"i sin hjord","poem":3},{"text":"och lovar att ge det,","poem":4},{"text":"men sedan offrar ett skadat","poem":2},{"noteId":4},{"text":"djur","poem":2},{"text":"till Herren.","poem":3},{"text":"För jag är en stor Kung,","poem":2},{"text":"säger Herren Sebaot,","poem":3},{"text":"och mitt namn är fruktat","poem":2},{"text":"bland hednafolken.","poem":3}]}],"footnotes":[{"noteId":0,"caller":"-","text":"f Citeras av Paulus i Rom 9:13.","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"-","text":"gjorde hans berg till en ödemarkEdom, som härstammade från Jakobs bror Esau (1 Mos 25:30, 36:1) och låg söder om Döda havet, hade överfallit judarna när de var svaga och därför drabbats av Guds dom. Se Jer 49 och Hes 25.","reference":{"chapter":1,"verse":3}},{"noteId":2,"caller":"-","text":"blint … lamt … sjuktEtt offerdjur skulle vara felfritt, som förebild till Kristus (3 Mos 22:19).","reference":{"chapter":1,"verse":8}},{"noteId":3,"caller":"-","text":"till din ståthållareSom skatt till ståthållaren som styrde Juda för perserrikets räkning.","reference":{"chapter":1,"verse":8}},{"noteId":4,"caller":"-","text":"skadatAnnan översättning: ”kastrerat” (jfr 3 Mos 22:24).","reference":{"chapter":1,"verse":14}}]},"thisChapterLink":"/api/swe_fol/MAL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MAL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ZEC/14.json","previousChapterAudioLinks":{},"numberOfVerses":14}