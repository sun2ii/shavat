{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MAL","translationId":"swe_fol","name":"Malaki","commonName":"Malaki","title":"Malaki","order":39,"numberOfChapters":4,"sha256":"5fe8f3608571134416c28b992137a120ada0404fab4ab0db557b58f85148fb6b","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/swe_fol/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":2,"content":[{"type":"heading","content":["Prästernas synd"]},{"type":"verse","number":1,"content":["Och nu kommer denna befallning till er, ni präster:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Om ni inte vill höra,","poem":1},{"text":"om ni inte tar det till hjärtat","poem":2},{"text":"att ge ära åt mitt namn,","poem":3},{"text":"säger Herren Sebaot,","poem":4},{"text":"då ska jag sända förbannelse","poem":2},{"text":"över er.","poem":3},{"text":"Jag ska förbanna era välsignelser,","poem":2},{"text":"och jag har redan förbannat dem","poem":3},{"text":"eftersom ni inte tar det till hjärtat.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Se, jag ska tillrättavisa era ättlingar","poem":1},{"text":"och kasta dynga","poem":2},{"noteId":5},{"text":"i ansiktet på er,","poem":2},{"text":"dynga från era högtidsoffer,","poem":3},{"text":"och ni ska bäras bort","poem":2},{"text":"tillsammans med den.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Och ni ska förstå","poem":1},{"text":"att jag har gett er","poem":2},{"text":"denna befallning","poem":3},{"text":"för att mitt förbund med Levi","poem":2},{"text":"ska bestå, säger Herren Sebaot.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Mitt förbund med honom","poem":1},{"text":"var liv och frid,","poem":3},{"text":"och jag gav honom det","poem":2},{"text":"för att han skulle vörda mig.","poem":3},{"text":"Och han vördade mig","poem":2},{"text":"och bävade för mitt namn.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Sann undervisning var i hans mun,","poem":1},{"text":"ingen orätt fanns på hans läppar.","poem":3},{"text":"I frid och uppriktighet","poem":2},{"text":"vandrade han med mig,","poem":3},{"text":"och han omvände många","poem":2},{"text":"från deras missgärningar.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"För prästens läppar","poem":1},{"text":"ska bevara kunskap,","poem":3},{"text":"och man ska hämta undervisning","poem":2},{"text":"från hans mun,","poem":3},{"text":"eftersom han är en budbärare","poem":2},{"text":"från Herren Sebaot.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Men ni har vikit av från vägen,","poem":1},{"text":"ni har fått många på fall","poem":2},{"text":"genom er undervisning.","poem":3},{"text":"Ni har fördärvat förbundet","poem":2},{"text":"med Levi, säger Herren Sebaot.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Därför har jag också gjort er","poem":1},{"text":"föraktade och förnedrade","poem":2},{"text":"inför hela folket,","poem":3},{"text":"för ni har inte hållit er","poem":2},{"text":"till mina vägar","poem":3},{"text":"utan varit partiska","poem":2},{"text":"när ni undervisar.","poem":3}]},{"type":"heading","content":["Folkets trolöshet"]},{"type":"verse","number":10,"content":[{"text":"Har vi inte alla samme Far?","poem":1},{"text":"Har inte samme Gud skapat oss?","poem":3},{"text":"Varför begår vi då svek","poem":2},{"text":"mot varandra","poem":3},{"text":"och kränker våra fäders förbund?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Juda har begått svek,","poem":1},{"text":"och avskyvärda ting","poem":2},{"text":"har gjorts i Israel och i Jerusalem.","poem":3},{"text":"Juda har kränkt","poem":2},{"text":"det som Herren håller heligt,","poem":3},{"text":"det som han älskar,","poem":4},{"text":"och de har gift sig med kvinnor","poem":2},{"text":"som dyrkar främmande gudar.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Herren ska utrota ur Jakobs tält","poem":1},{"text":"var och en som gör så,","poem":3},{"text":"både hög och låg","poem":2},{"noteId":6},{"text":"och den som bär fram gåvor","poem":3},{"text":"till Herren Sebaot.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Och dessutom gör ni detta:","poem":1},{"text":"Ni översköljer Herrens altare","poem":2},{"text":"med tårar, gråt och klagan,","poem":3},{"text":"eftersom han inte vill","poem":2},{"text":"se till offergåvan längre","poem":3},{"text":"eller ta emot något från er hand","poem":2},{"text":"med glädje.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Och ni frågar: ”Varför?”","poem":1},{"text":"Därför att Herren var vittne","poem":2},{"text":"mellan dig","poem":3},{"text":"och din ungdoms hustru.","poem":4},{"text":"Du har varit trolös mot henne,","poem":2},{"text":"trots att hon är din maka,","poem":3},{"text":"din hustru","poem":2},{"text":"som du ingått förbund med.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Har inte han gjort dem till ett?","poem":1},{"text":"Det som är kvar av ande","poem":2},{"noteId":7},{"text":"tillhör honom.","poem":3},{"text":"Och varför till ett?","poem":2},{"text":"Han söker ättlingar","poem":3},{"text":"som hör Gud till.","poem":4},{"text":"Så ta hand om er ande","poem":2},{"text":"och var inte trolös","poem":3},{"text":"mot din ungdoms hustru.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Jag hatar skilsmässa,","poem":1},{"text":"säger Herren, Israels Gud,","poem":3},{"text":"och att man höljer sig i våld","poem":2},{"text":"som i en klädnad,","poem":3},{"text":"säger Herren Sebaot.","poem":4},{"text":"Så var på er vakt i er ande","poem":2},{"text":"och var inte trolösa.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Ni tröttar ut Herren med era ord.","poem":1},{"text":"Ni frågar:","poem":2},{"text":"”Hur har vi tröttat ut honom?”","poem":3},{"text":"När ni säger:","poem":2},{"text":"”Den som gör det onda","poem":3},{"text":"är god i Herrens ögon,","poem":4},{"text":"och han gläder sig över dem”,","poem":3},{"text":"eller: ”Var är rättvisans Gud?”","poem":2}]}],"footnotes":[{"noteId":5,"caller":"-","text":"dyngaOrdet användes om offerdjurens maginnehåll (se 3 Mos 1:9).","reference":{"chapter":2,"verse":3}},{"noteId":6,"caller":"-","text":"hög och lågGrundtextens innebörd är osäker.","reference":{"chapter":2,"verse":12}},{"noteId":7,"caller":"-","text":"Det som är kvar av andeAnnan översättning: ”Kött och ande” eller ”Andlig släkt”. Grundtexten är i denna vers svårtolkad.","reference":{"chapter":2,"verse":15}}]},"thisChapterLink":"/api/swe_fol/MAL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MAL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MAL/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}