{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MAL","translationId":"swe_fol","name":"Malaki","commonName":"Malaki","title":"Malaki","order":39,"numberOfChapters":4,"sha256":"5fe8f3608571134416c28b992137a120ada0404fab4ab0db557b58f85148fb6b","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/swe_fol/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":3,"content":[{"type":"heading","content":["Förbundets sändebud"]},{"type":"verse","number":1,"content":["Se, jag ska sända",{"text":"min budbärare","poem":2},{"noteId":8},{"text":"och han ska bereda vägen","poem":3},{"lineBreak":true},{"text":"för mig.","poem":3},{"text":"Och Herren som ni söker ska","poem":2},{"text":"plötsligt komma till sitt tempel,","poem":3},{"text":"förbundets sändebud","poem":2},{"noteId":9},{"text":"som ni längtar efter.","poem":3},{"text":"Se, han kommer,","poem":2},{"text":"säger Herren Sebaot.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Men vem kan uthärda","poem":1},{"text":"den dag då han kommer,","poem":3},{"text":"och vem kan bestå","poem":2},{"text":"när han visar sig?","poem":3},{"text":"Han är som guldsmedens eld","poem":2},{"text":"och som tvättarnas såpa","poem":3},{"noteId":10},{"text":".","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Han ska sätta sig likt den","poem":1},{"text":"som smälter och renar silver.","poem":3},{"text":"Han ska rena Levi söner,","poem":2},{"text":"luttra dem som guld och silver","poem":3},{"text":"så att de kan bära fram offergåvor","poem":2},{"text":"åt Herren i rättfärdighet.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Då ska Judas och Jerusalems","poem":1},{"text":"offergåvor behaga Herren","poem":2},{"text":"som i forna dagar och gångna år.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jag ska komma till er och hålla dom,","poem":1},{"text":"och jag ska vara snabb att vittna","poem":3},{"text":"mot trollkarlar","poem":2},{"text":"och äktenskapsbrytare","poem":3},{"text":"och dem som svär falskt,","poem":4},{"text":"mot dem som vägrar","poem":2},{"text":"arbetaren hans lön","poem":3},{"text":"och förtrycker änkan","poem":2},{"text":"och den faderlöse,","poem":3},{"text":"som vränger rätten för främlingen","poem":2},{"text":"och inte fruktar mig,","poem":3},{"text":"säger Herren Sebaot.","poem":2}]},{"type":"heading","content":["Israel inser inte sin synd"]},{"type":"verse","number":6,"content":[{"text":"Jag, Herren, har inte förändrats,","poem":1},{"text":"och ni, Jakobs barn,","poem":2},{"text":"har inte utplånats.","poem":3},{"noteId":11}]},{"type":"verse","number":7,"content":[{"text":"Ända sedan era fäders dagar","poem":1},{"text":"har ni vikit av från mina stadgar","poem":2},{"text":"och inte hållit dem.","poem":3},{"text":"Vänd om till mig","poem":2},{"text":"så ska jag vända om till er,","poem":3},{"text":"säger Herren Sebaot.","poem":4},{"text":"Men ni frågar:","poem":2},{"text":"”Hur ska vi vända om?”","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Får en människa stjäla från Gud?","poem":1},{"text":"Ändå stjäl ni från mig.","poem":3},{"text":"Ni säger:","poem":2},{"text":"”Vad har vi stulit från dig?”","poem":3},{"text":"Tionde och offergåvor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Förbannelse har drabbat er,","poem":1},{"text":"för ni och hela folket stjäl från mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bär in fullt tionde","poem":1},{"noteId":12},{"text":"i förrådshuset","poem":1},{"noteId":13},{"text":"så att det finns mat i mitt hus.","poem":3},{"text":"Pröva mig nu i det här,","poem":2},{"text":"säger Herren Sebaot,","poem":3},{"text":"om jag inte kommer att öppna","poem":2},{"text":"himlens fönster för er","poem":3},{"text":"och ösa ut välsignelse","poem":2},{"text":"över er i rikt mått.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Och jag ska tillrättavisa","poem":1},{"text":"skadedjuren","poem":3},{"noteId":14},{"text":"för er","poem":3},{"text":"så att de inte fördärvar","poem":2},{"text":"markens gröda,","poem":3},{"text":"och er vinstock på fältet","poem":2},{"text":"ska inte bli utan frukt,","poem":3},{"text":"säger Herren Sebaot.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Och alla folk ska kalla er lyckliga,","poem":1},{"text":"för ni ska vara ett ljuvligt land,","poem":2},{"text":"säger Herren Sebaot.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ni har talat hårda ord mot mig,","poem":1},{"text":"säger Herren.","poem":3},{"text":"Men ni säger:","poem":2},{"text":"”Vad har vi sagt mot dig?”","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Ni har sagt:","poem":1},{"text":"”Det är meningslöst","poem":2},{"text":"att tjäna Gud.","poem":3},{"text":"Vad vinner vi på att hålla hans bud","poem":2},{"text":"och gå sörjande","poem":3},{"text":"inför Herren Sebaot?","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Nu kallar vi","poem":1},{"text":"de högmodiga lyckliga.","poem":3},{"text":"De som handlar gudlöst","poem":2},{"text":"får framgång,","poem":3},{"text":"de sätter Gud på prov","poem":2},{"text":"och kommer undan med det.”","poem":3}]},{"type":"heading","content":["En minnesbok"]},{"type":"verse","number":16,"content":[{"text":"Men då talade de som","poem":1},{"text":"vördar Herren med varandra,","poem":2},{"text":"och Herren hörde och lyssnade.","poem":3},{"text":"En minnesbok skrevs inför honom","poem":2},{"text":"för dem som vördar Herren","poem":3},{"text":"och respekterar hans namn.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"De ska vara min dyrbara egendom,","poem":1},{"text":"säger Herren Sebaot,","poem":2},{"text":"den dag jag utför mitt verk.","poem":3},{"text":"Jag ska förbarma mig över dem","poem":2},{"text":"så som en man förbarmar sig","poem":3},{"text":"över sin son som tjänar honom.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Då ska ni åter se skillnaden","poem":1},{"text":"mellan den rättfärdige","poem":2},{"text":"och den gudlöse,","poem":3},{"text":"mellan den som tjänar Gud","poem":2},{"text":"och den som inte tjänar honom.","poem":3}]}],"footnotes":[{"noteId":8,"caller":"-","text":"min budbärareCiteras i Matt 11:10, Mark 1:2, Luk 7:27 som en profetia om Johannes Döparen.","reference":{"chapter":3,"verse":1}},{"noteId":9,"caller":"-","text":"förbundets sändebudAnnan översättning: ”förbundets ängel”. Det nya förbundet (Jer 31:31f) skulle instiftas av Messias (Luk 22:20, Heb 3:1, 9:15).","reference":{"chapter":3,"verse":1}},{"noteId":10,"caller":"-","text":"tvättarnas såpaDåtidens rengöringsmedel framställdes av aska.","reference":{"chapter":3,"verse":2}},{"noteId":11,"caller":"-","text":"utplånatsAnnan översättning: ”slutat” (att synda, jfr vers 7).","reference":{"chapter":3,"verse":6}},{"noteId":12,"caller":"-","text":"fullt tiondeLeviterna behövde sin försörjning för att upprätthålla templets gudstjänstliv (4 Mos 18:21, Neh 13:10f).","reference":{"chapter":3,"verse":10}},{"noteId":13,"caller":"-","text":"förrådshusetTempeltjänarnas matförråd (jfr 2 Krön 31:11, Neh 13:5, 12).","reference":{"chapter":3,"verse":10}},{"noteId":14,"caller":"-","text":"skadedjurenOrdagrant: ”uppslukarna” (t ex gräshoppor, jfr 2 Krön 7:13, Joel 1:4).","reference":{"chapter":3,"verse":11}}]},"thisChapterLink":"/api/swe_fol/MAL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MAL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MAL/2.json","previousChapterAudioLinks":{},"numberOfVerses":18}