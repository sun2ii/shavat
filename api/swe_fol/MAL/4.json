{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MAL","translationId":"swe_fol","name":"Malaki","commonName":"Malaki","title":"Malaki","order":39,"numberOfChapters":4,"sha256":"5fe8f3608571134416c28b992137a120ada0404fab4ab0db557b58f85148fb6b","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MAL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/swe_fol/MAL/4.json","totalNumberOfVerses":55},"chapter":{"number":4,"content":[{"type":"heading","content":["Herrens domedag"]},{"type":"verse","number":1,"content":["Se, dagen kommer,",{"text":"den brinner som en ugn.","poem":3},{"text":"Då ska alla högmodiga","poem":2},{"text":"och alla som gör det onda","poem":3},{"text":"vara som halm.","poem":4},{"text":"Dagen som kommer","poem":2},{"text":"ska bränna upp dem,","poem":3},{"text":"säger Herren Sebaot,","poem":4},{"text":"den ska varken lämna","poem":2},{"text":"rot eller kvist.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Men för er som vördar mitt namn","poem":1},{"text":"ska rättfärdighetens sol gå upp","poem":2},{"text":"med läkedom under sina vingar","poem":3},{"noteId":15},{"text":".","poem":3},{"text":"Då ska ni komma ut och hoppa","poem":2},{"text":"likt kalvar som släpps ur sitt bås.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ni ska trampa ner de gudlösa,","poem":1},{"text":"för de ska bli stoft under era fötter","poem":2},{"text":"den dag jag utför mitt verk,","poem":3},{"text":"säger Herren Sebaot.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kom ihåg min tjänare Moses lag","poem":1},{"text":"som jag gav honom på Horeb","poem":3},{"noteId":16},{"text":",","poem":3},{"text":"stadgar och föreskrifter","poem":2},{"text":"för hela Israel.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Se, jag ska sända er profeten Elia,","poem":1},{"noteId":17},{"text":"innan Herrens dag kommer,","poem":2},{"text":"den stora och fruktansvärda","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han ska vända","poem":1},{"text":"fädernas hjärtan till barnen","poem":2},{"text":"och barnens hjärtan","poem":3},{"text":"till deras fäder,","poem":4},{"text":"så att jag inte kommer och viger","poem":2},{"text":"landet åt förintelse","poem":3},{"noteId":18},{"text":".","poem":3}]}],"footnotes":[{"noteId":15,"caller":"-","text":"under sina vingarEn bild för omsorg (Ps 63:8, Luk 13:34). Den bevingade solen var en kungasymbol. Uttrycket används om Messias i Luk 1:78.","reference":{"chapter":4,"verse":2}},{"noteId":16,"caller":"-","text":"HorebBerget Sinai (5 Mos 4:10f).","reference":{"chapter":4,"verse":4}},{"noteId":17,"caller":"-","text":"sända er profeten EliaNämns av Jesus i Matt 17:10, Mark 9:11 och i Luk 1:17 som profetia om Johannes Döparen.","reference":{"chapter":4,"verse":5}},{"noteId":18,"caller":"-","text":"förintelseHebr. chérem innebär att något överlåts åt Herren och avskiljs från människornas värld, ofta genom förintelse (jfr 5 Mos 7).","reference":{"chapter":4,"verse":6}}]},"thisChapterLink":"/api/swe_fol/MAL/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MAT/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MAL/3.json","previousChapterAudioLinks":{},"numberOfVerses":6}