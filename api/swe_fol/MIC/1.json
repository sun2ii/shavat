{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MIC","translationId":"swe_fol","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3869d5d879c4fe3a5ec9029ed9a8f89347aa40293b68041c02e8e064e63d3a57","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swe_fol/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"heading","content":["Domsord över Juda och Israel"]},{"type":"verse","number":1,"content":["Herrens ord till Mika från Moreshet",{"noteId":0},", när Jotam, Ahas och Hiskia",{"noteId":1},"var kungar i Juda. Detta är vad han såg om Samaria och Jerusalem."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hör alla folk, lyssna du jord","poem":1},{"text":"med allt som är på den!","poem":3},{"text":"Herren Gud","poem":2},{"text":"ska vara ett vittne mot er,","poem":3},{"text":"Herren från sitt heliga tempel,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"för Herren träder fram","poem":1},{"text":"ur sin boning,","poem":3},{"text":"han stiger ner och går fram","poem":2},{"text":"över jordens höjder.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Bergen smälter under honom","poem":1},{"text":"och dalarna bryter fram","poem":3},{"text":"som vaxet för elden,","poem":2},{"text":"som vatten som störtar","poem":3},{"text":"utför branten.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Allt detta sker för Jakobs brott,","poem":1},{"text":"för synden hos Israels hus.","poem":3},{"text":"Vem är skyldig till Jakobs brott?","poem":2},{"text":"Är det inte Samaria?","poem":3},{"text":"Och vem till Juda offerhöjder","poem":2},{"noteId":2},{"text":"?","poem":2},{"text":"Är det inte Jerusalem?","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Därför ska jag göra Samaria","poem":1},{"noteId":3},{"text":"till en stenhög på marken,","poem":2},{"text":"till en plats för vinodling.","poem":3},{"text":"Jag ska vräka hennes stenar","poem":2},{"text":"ner i dalen","poem":3},{"text":"och blotta hennes grundvalar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alla hennes avgudabilder","poem":1},{"text":"ska krossas,","poem":3},{"text":"alla hennes otuktsgåvor","poem":2},{"text":"ska brännas upp i eld,","poem":3},{"text":"alla hennes avgudar","poem":2},{"text":"ska jag förstöra.","poem":3},{"text":"För hon har skaffat dem","poem":2},{"text":"genom otuktslön","poem":3},{"noteId":4},{"text":",","poem":3},{"text":"och otuktslön ska de bli igen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Därför ska jag klaga och jämra mig,","poem":1},{"text":"jag ska gå barfota och naken.","poem":3},{"text":"Jag ska yla som en schakal","poem":2},{"text":"och klaga som en struts","poem":3},{"noteId":5},{"text":",","poem":3}]},{"type":"verse","number":9,"content":[{"text":"för hennes sår kan inte läkas,","poem":1},{"text":"det har kommit ända till Juda,","poem":3},{"text":"det har nått ända till mitt folks port,","poem":2},{"text":"ända till Jerusalem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Förkunna det inte i Gat","poem":1},{"noteId":6},{"text":",","poem":1},{"text":"gråt inte så bittert!","poem":3},{"text":"I Bet-Leafra vältrar jag mig","poem":2},{"text":"i stoftet.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Dra ut i nakenhet och skam,","poem":1},{"text":"ni som bor i Shafir!","poem":3},{"text":"De som bor i Saanan","poem":2},{"text":"vågar sig inte ut.","poem":3},{"text":"Sorgeropen i Bet-Haesel","poem":2},{"text":"gör att ni inte kan stanna där.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"De som bor i Marot","poem":1},{"text":"våndas efter det goda,","poem":3},{"text":"för en olycka har kommit","poem":2},{"text":"från Herren till Jerusalems port.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Spänn travare för vagnen,","poem":1},{"text":"ni som bor i Lakish,","poem":3},{"text":"ni som var orsaken till synd","poem":2},{"text":"hos dottern Sion,","poem":3},{"text":"för det var hos er man fann","poem":2},{"text":"Israels överträdelser.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Därför ska du ge skiljebrev","poem":1},{"text":"åt Moreshet-Gat.","poem":3},{"text":"Husen i Aksib har blivit","poem":2},{"text":"som en lögn för Israels kungar.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Än en gång ska jag låta erövraren","poem":1},{"text":"drabba er, ni som bor i Maresha.","poem":3},{"text":"Israels härlighet ska komma","poem":2},{"text":"till Adullam","poem":3},{"noteId":7},{"text":".","poem":3},{"noteId":8}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Raka dig skallig","poem":1},{"noteId":9},{"text":"och skär av ditt hår","poem":2},{"text":"för barnen som var din glädje.","poem":3},{"text":"Gör ditt huvud kalt som gamens,","poem":2},{"text":"för de ska föras bort från dig.","poem":3}]}],"footnotes":[{"noteId":0,"caller":"-","text":"MoreshetBefäst stad ca 3 mil sydväst om Jerusalem.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"-","text":"Jotam, Ahas och HiskiaRegerade 750-735, 735-715 och 715-687 f Kr. Se 2 Kung 15:32f, 16:1f och 18:1f samt 2 Krön 27, 28 och 29-32).","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"-","text":"offerhöjderAndra handskrifter (Septuaginta och Peshitta): ”synd”.","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"-","text":"SamariaNordrikets huvudstad (1 Kung 16:24), som föll efter tre års belägring (2 Kung 17).","reference":{"chapter":1,"verse":6}},{"noteId":4,"caller":"-","text":"otuktslönAvgudatemplens skatter, intjänade genom tempelprostitution eller andra avgudakulter, skulle nu plundras av andra avgudadyrkande folk.","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"-","text":"strutsAnnan översättning: ”uggla”.","reference":{"chapter":1,"verse":8}},{"noteId":6,"caller":"-","text":"Förkunna det inte i GatAnspelning på Davids klagosång efter filisteernas invasion (2 Sam 1:20).","reference":{"chapter":1,"verse":10}},{"noteId":7,"caller":"-","text":"De uppräknade orterna i vers 10-15 låg i Låglandet sydväst om Jerusalem runt Mikas hemstad Moreshet-Gat. De härjades av assyriern Sanherib 701 f Kr (2 Kung 18:13, 2 Krön 32:1). I verserna finns flera anspelningar på ortnamnen (t ex Leafra, ”i stoft”, och Aksib, ”sviker”).","reference":{"chapter":1,"verse":15}},{"noteId":8,"caller":"-","text":"AdullamHit flydde David en gång från Gat (2 Sam 22:1).","reference":{"chapter":1,"verse":15}},{"noteId":9,"caller":"-","text":"Raka dig skalligUttryck för svår sorg (jfr Job 1:20, Jer 41:5).","reference":{"chapter":1,"verse":16}}]},"thisChapterLink":"/api/swe_fol/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}