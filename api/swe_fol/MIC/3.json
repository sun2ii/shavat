{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MIC","translationId":"swe_fol","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3869d5d879c4fe3a5ec9029ed9a8f89347aa40293b68041c02e8e064e63d3a57","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swe_fol/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Förfallet bland Israels ledare"]},{"type":"verse","number":1,"content":["Jag sade:",{"text":"Hör, ni hövdingar i Jakob,","poem":2},{"text":"ni furstar över Israels hus:","poem":3},{"text":"Är det inte er sak","poem":2},{"text":"att veta vad som är rätt?","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Men ni hatar det goda","poem":1},{"text":"och älskar det onda,","poem":3},{"text":"ni sliter huden av människor","poem":2},{"text":"och köttet från deras ben.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ni äter mitt folks kött","poem":1},{"text":"och flår huden av dem","poem":2},{"text":"och krossar deras ben","poem":3},{"text":"för att stycka dem","poem":2},{"text":"likt något man kastar i grytan,","poem":3},{"text":"som kött i kitteln.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"När de då ropar till Herren","poem":1},{"text":"ska han inte svara dem.","poem":3},{"text":"För det onda de gjort","poem":2},{"text":"ska han dölja sitt ansikte för dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Så säger Herren om profeterna","poem":1},{"text":"som vilseleder mitt folk,","poem":3},{"text":"som ropar: ”Allt är väl!”","poem":2},{"text":"när de får något att tugga","poem":3},{"text":"med sina tänder.","poem":4},{"text":"Men mot den som inte","poem":2},{"text":"ger dem något i munnen","poem":3},{"text":"blåser de upp till helig strid.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Därför ska ni få en natt utan syner","poem":1},{"text":"och mörker utan spådomar.","poem":3},{"text":"Solen ska gå ner över profeterna","poem":2},{"text":"och dagen bli mörk över dem.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Siarna ska stå med skam","poem":1},{"text":"och spåmännen blygas.","poem":3},{"text":"De ska alla täcka sitt skägg,","poem":2},{"text":"för inget svar kommer från Gud.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Men jag är full av kraft,","poem":1},{"text":"av Herrens Ande","poem":2},{"text":"och rätt och styrka,","poem":3},{"text":"för att förkunna för Jakob hans brott","poem":2},{"text":"och för Israel hans synd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hör nu detta,","poem":1},{"text":"ni hövdingar över Jakobs hus","poem":2},{"text":"och furstar över Israels hus:","poem":3},{"text":"Ni avskyr det som är rätt","poem":2},{"text":"och förvrider allt som är rakt,","poem":3}]},{"type":"verse","number":10,"content":[{"text":"ni bygger upp Sion med blod","poem":1},{"text":"och Jerusalem med ondska.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Stadens hövdingar dömer för mutor,","poem":1},{"text":"prästerna undervisar för betalning","poem":2},{"text":"och profeterna spår för pengar.","poem":3},{"text":"Ändå stöder de sig på Herren","poem":2},{"text":"och säger:","poem":3},{"text":"”Är inte Herren mitt ibland oss?","poem":2},{"text":"Olycka ska inte drabba oss.”","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Därför ska Sion för er skull","poem":1},{"text":"plöjas upp till en åker,","poem":3},{"text":"Jerusalem bli en stenhop","poem":2},{"noteId":11},{"text":"och tempelberget","poem":3},{"text":"en skogbevuxen höjd.","poem":4}]}],"footnotes":[{"noteId":11,"caller":"-","text":"Jerusalem bli en stenhopMikas förutsägelse om Jerusalems fall var allmänt känd (Jer 26:18) fram till stadens undergång 587 f Kr (se 2 Kung 25).","reference":{"chapter":3,"verse":12}}]},"thisChapterLink":"/api/swe_fol/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}