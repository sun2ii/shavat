{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MIC","translationId":"swe_fol","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3869d5d879c4fe3a5ec9029ed9a8f89347aa40293b68041c02e8e064e63d3a57","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swe_fol/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Israel ska återvända till sitt land"]},{"type":"verse","number":1,"content":["Det ska ske i den yttersta tiden",{"text":"att berget med Herrens hus","poem":3},{"lineBreak":true},{"text":"ska stå fast grundat","poem":3},{"text":"och vara högst bland bergen,","poem":2},{"text":"upphöjt över höjderna.","poem":3},{"text":"Och alla folk ska strömma dit,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"och många folk ska gå i väg och säga:","poem":1},{"text":"”Kom, låt oss gå upp","poem":2},{"text":"till Herrens berg,","poem":3},{"text":"till Jakobs Guds hus.","poem":4},{"text":"Han ska lära oss sina vägar","poem":2},{"text":"så att vi kan vandra","poem":3},{"text":"på hans stigar.”","poem":4},{"text":"För undervisningen","poem":2},{"text":"ska gå ut från Sion,","poem":3},{"text":"Herrens ord från Jerusalem.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Han ska döma mellan många folk","poem":1},{"text":"och skipa rätt åt mäktiga hednafolk,","poem":2},{"text":"ända bort i fjärran land.","poem":3},{"text":"Då ska de smida sina svärd","poem":2},{"text":"till plogbillar","poem":4},{"text":"och sina spjut till vingårdsknivar.","poem":3},{"text":"Folken ska inte lyfta svärd","poem":2},{"text":"mot varandra","poem":3},{"text":"och inte mer öva för krig.","poem":2},{"noteId":12}]},{"type":"verse","number":4,"content":[{"text":"Var och en ska sitta","poem":1},{"text":"under sin vinstock och sitt fikonträd","poem":2},{"noteId":13},{"text":"utan fruktan,","poem":3},{"text":"för så har Herren Sebaots mun talat.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Alla andra folk vandrar","poem":1},{"text":"vart och ett i sin guds namn,","poem":3},{"text":"men vi ska vandra","poem":2},{"text":"i Herren vår Guds namn,","poem":3},{"text":"alltid och för evigt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"På den dagen, säger Herren,","poem":1},{"text":"ska jag samla de haltande","poem":3},{"text":"och föra samman de fördrivna","poem":2},{"text":"och dem som jag har plågat.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Jag ska göra de haltande till en rest","poem":1},{"text":"och de fördrivna","poem":2},{"text":"till ett mäktigt folk,","poem":3},{"text":"och Herren ska vara kung","poem":2},{"text":"över dem på Sions berg","poem":3},{"text":"från nu och till evig tid.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Och du Herdetorn,","poem":1},{"text":"dottern Sions kulle,","poem":3},{"text":"till dig ska det komma,","poem":2},{"text":"det forna herraväldet ska komma,","poem":3},{"text":"dottern Jerusalems kungadöme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Men varför ropar du så högt?","poem":1},{"text":"Finns det ingen kung hos dig,","poem":2},{"text":"är din rådgivare borta","poem":3},{"text":"eftersom du gripits av vånda","poem":2},{"text":"likt en barnaföderska?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Vrid dig i födslosmärtor","poem":1},{"text":"likt en födande kvinna,","poem":2},{"text":"dotter Sion,","poem":3},{"text":"för nu måste du dra ut ur staden","poem":2},{"text":"och bo på öppna fältet.","poem":3},{"text":"Ända till Babel","poem":2},{"noteId":14},{"text":"ska du komma.","poem":2},{"text":"Där ska du befrias,","poem":3},{"text":"där ska Herren förlossa dig","poem":2},{"text":"ur dina fienders hand.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nu samlas många folk mot dig,","poem":1},{"text":"och de säger:","poem":3},{"text":"”Hon ska bli orenad,","poem":2},{"text":"och våra ögon ska se","poem":3},{"text":"med lust på Sion.”","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Men de känner inte","poem":1},{"text":"Herrens tankar,","poem":3},{"text":"de förstår inte hans rådslut,","poem":2},{"text":"att han har samlat dem","poem":3},{"text":"som kärvar till tröskplatsen.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Res dig och tröska","poem":1},{"noteId":15},{"text":", dotter Sion,","poem":1},{"text":"för jag ska ge dig horn av järn","poem":2},{"text":"och klövar av koppar.","poem":3},{"text":"Du ska krossa många folk","poem":2},{"text":"och viga bytet från dem åt Herren,","poem":3},{"text":"deras skatter åt hela jordens Herre.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"-","text":"Stycket återfinns även i Jesaja 2:2-4. De två profeterna var samtida och kände troligen varandra.","reference":{"chapter":4,"verse":3}},{"noteId":13,"caller":"-","text":"under sin vinstock och sitt fikonträdUttryck för trygghet och gott liv (jfr 1 Kung 4:25, Sak 3:10).","reference":{"chapter":4,"verse":4}},{"noteId":14,"caller":"-","text":"till BabelHit fördes folket bort över hundra år senare, 597 och 587 f Kr (se 2 Kung 24-25). De befriades av perserkungen Koresh 539 f Kr (Esra 1) och fick återvända till sitt land (vers 6).","reference":{"chapter":4,"verse":10}},{"noteId":15,"caller":"-","text":"tröskaAtt krossa skördad säd på tröskplatsen (Jes 28:28), en bild för våldsam behandling.","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/swe_fol/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}