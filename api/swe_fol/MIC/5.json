{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MIC","translationId":"swe_fol","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3869d5d879c4fe3a5ec9029ed9a8f89347aa40293b68041c02e8e064e63d3a57","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swe_fol/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Messias ska komma från Betlehem"]},{"type":"verse","number":1,"content":["Samla nu dina skaror,",{"text":"du skarornas stad.","poem":2},{"lineBreak":true},{"text":"De reser belägringsvallar mot oss,","poem":2},{"text":"de slår Israels domare","poem":3},{"text":"med käpp på kinden.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Men du, Betlehem Efrata","poem":1},{"text":"som är så liten","poem":2},{"text":"bland Juda tusenden,","poem":3},{"text":"från dig ska det åt mig komma","poem":2},{"text":"en som ska härska över Israel.","poem":3},{"text":"Hans ursprung är före tiden,","poem":2},{"text":"från evighetens dagar.","poem":3},{"noteId":16}]},{"type":"verse","number":3,"content":[{"text":"Därför ska han överge dem","poem":1},{"text":"fram till den tid","poem":2},{"text":"då hon som ska föda har fött.","poem":3},{"text":"Då ska de som är kvar","poem":2},{"text":"av hans bröder","poem":4},{"text":"få vända tillbaka till Israels barn.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Han ska träda fram","poem":1},{"text":"och vara en herde i Herrens kraft,","poem":2},{"text":"i Herren sin Guds namns höghet.","poem":3},{"text":"Och de ska ha ro,","poem":2},{"text":"för han ska vara stor","poem":3},{"text":"till jordens ändar.","poem":4}]},{"type":"heading","content":["Israels befrielse"]},{"type":"verse","number":5,"content":[{"text":"Och han ska vara vår frid.","poem":1},{"text":"När Assur stormar in i vårt land","poem":2},{"text":"och tränger in i våra palats,","poem":3},{"text":"då ställer vi upp sju herdar","poem":2},{"text":"mot honom,","poem":4},{"text":"åtta furstar ur folket.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Och de ska beta av Assurs land","poem":1},{"text":"med svärd","poem":3},{"text":"och Nimrods land","poem":2},{"text":"ända in i dess portar.","poem":3},{"text":"Så ska han rädda oss från Assur","poem":2},{"noteId":17},{"text":",","poem":2},{"text":"om denne kommer in i vårt land","poem":3},{"text":"och tränger in över våra gränser.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"De som är kvar av Jakob","poem":1},{"text":"ska vara bland många folk","poem":3},{"text":"som dagg från Herren,","poem":2},{"text":"som regnskurar på gräs","poem":3},{"text":"som inte väntar på någon man","poem":2},{"text":"eller dröjer för människors skull","poem":3},{"noteId":18},{"text":".","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ja, de som är kvar av Jakob","poem":1},{"text":"ska vara bland hednafolken,","poem":2},{"text":"mitt bland många folk,","poem":3},{"text":"som ett lejon bland skogens djur,","poem":2},{"text":"som ett ungt lejon","poem":3},{"text":"bland fårhjordar","poem":4},{"text":"som trampar ner där det går fram","poem":2},{"text":"och river utan att någon","poem":3},{"text":"kan rädda.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Må din hand vara upplyft","poem":1},{"text":"över dina motståndare,","poem":3},{"text":"och må alla dina fiender utrotas!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Det ska ske på den dagen,","poem":1},{"text":"säger Herren,","poem":3},{"text":"att jag ska utrota dina hästar","poem":2},{"text":"ur ditt land","poem":4},{"text":"och förstöra dina vagnar.","poem":3},{"noteId":19}]},{"type":"verse","number":11,"content":[{"text":"Jag ska utplåna städerna i ditt land","poem":1},{"text":"och riva ner alla dina fästningar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jag ska utrota all trolldom hos dig,","poem":1},{"text":"inga spåmän ska mer finnas","poem":2},{"text":"bland dig.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Jag ska utrota dina avgudabilder","poem":1},{"text":"och dina stoder ur ditt land,","poem":3},{"text":"och du ska inte mer tillbe","poem":2},{"text":"dina händers verk.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Jag ska förstöra dina asherapålar","poem":1},{"noteId":20},{"text":"som du har ibland dig","poem":3},{"text":"och ödelägga dina städer.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jag ska i vrede och harm","poem":1},{"text":"ta hämnd på de hednafolk","poem":2},{"text":"som inte har lyssnat.","poem":3}]}],"footnotes":[{"noteId":16,"caller":"-","text":"Citeras i Matt 2:6f som profetia om Kristi födelse. Efrata är området kring Betlehem (jfr Rut 1:2). Ordet ”tusenden” (hebr. alfeí) kan också översättas ”ätter” eller ”furstar” (jfr Matt 2:6).","reference":{"chapter":5,"verse":2}},{"noteId":17,"caller":"-","text":"rädda oss från AssurDen assyriske kungen Sanherib tvingades avbryta sin belägring av Jerusalem 701 f Kr efter en ängels ingripande (2 Kung 19:35, 2 Krön 32:21, Jes 37:36).","reference":{"chapter":5,"verse":6}},{"noteId":18,"caller":"-","text":"dröjer för människors skullAnnan översättning: ”hoppas på människor”.","reference":{"chapter":5,"verse":7}},{"noteId":19,"caller":"-","text":"hästar ... vagnarUtrustning för krig (jfr 2 Mos 14:9, Ps 20:8, 33:17).","reference":{"chapter":5,"verse":10}},{"noteId":20,"caller":"-","text":"asherapålarSymboler för fruktbarhetsgudinnan Ashera, en andlig otrohet mot Herren (Jer 17:2, 3:13) som föregick domen genom Assyriens invasion (2 Kung 17:10, 16).","reference":{"chapter":5,"verse":14}}]},"thisChapterLink":"/api/swe_fol/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}