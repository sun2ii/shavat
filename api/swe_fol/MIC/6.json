{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MIC","translationId":"swe_fol","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3869d5d879c4fe3a5ec9029ed9a8f89347aa40293b68041c02e8e064e63d3a57","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swe_fol/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Herren går till rätta med Israel"]},{"type":"verse","number":1,"content":["Hör vad Herren säger:",{"lineBreak":true},{"text":"Res dig och gå till rätta inför bergen","poem":1},{"text":"och låt höjderna höra din röst.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hör Herrens anklagelse, ni berg,","poem":1},{"text":"ni jordens fasta grundvalar,","poem":3},{"text":"för Herren anklagar sitt folk","poem":2},{"text":"och går till rätta med Israel.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Mitt folk, vad har jag gjort mot dig,","poem":1},{"text":"och hur har jag tröttat ut dig?","poem":2},{"text":"Svara mig!","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag förde dig upp ur Egyptens land,","poem":1},{"text":"jag befriade dig","poem":3},{"text":"ur träldomshuset.","poem":4},{"text":"Jag sände Mose, Aron och Mirjam","poem":2},{"text":"framför dig.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Mitt folk, kom ihåg","poem":1},{"text":"vad Moabs kung Balak tänkte","poem":3},{"text":"och vad han fick för svar","poem":2},{"text":"av Bileam, Beors son.","poem":3},{"text":"Kom ihåg hur det var","poem":2},{"text":"mellan Shittim och Gilgal","poem":3},{"noteId":21},{"text":"så att du förstår","poem":2},{"text":"Herrens rättfärdiga gärningar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Med vad ska jag komma inför Herren","poem":1},{"text":"och böja mig för Gud i höjden?","poem":3},{"text":"Ska jag träda fram inför honom","poem":2},{"text":"med brännoffer,","poem":3},{"text":"med årsgamla kalvar?","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Gläder sig Herren åt tusentals bockar,","poem":1},{"text":"åt tiotusen floder av olja?","poem":3},{"text":"Ska jag ge min förstfödde","poem":2},{"text":"för min överträdelse,","poem":3},{"text":"min livsfrukt som syndoffer","poem":2},{"text":"för min själ?","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Han har sagt dig, du människa,","poem":1},{"text":"vad som är gott.","poem":3},{"text":"Vad begär Herren av dig","poem":2},{"text":"annat än att du gör det rätta,","poem":3},{"text":"älskar barmhärtighet","poem":2},{"text":"och vandrar i ödmjukhet","poem":3},{"text":"med din Gud?","poem":4}]},{"type":"heading","content":["Israels skuld och straff"]},{"type":"verse","number":9,"content":[{"text":"Hör hur Herren ropar till staden!","poem":1},{"text":"Vishet är att vörda ditt namn","poem":3},{"noteId":22},{"text":".","poem":3},{"text":"Hör om straffet","poem":2},{"text":"och vem som bestämt det.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Finns det ännu i den gudlöses hus","poem":1},{"text":"skatter som vunnits genom orätt","poem":3},{"text":"eller ett snålt efa-mått","poem":2},{"noteId":23},{"text":"som är förbannat?","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Vore jag rättfärdig","poem":1},{"text":"om jag tillät orätt våg","poem":2},{"text":"och falska vikter i väskan?","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Eftersom de rika i staden","poem":1},{"text":"är fulla av våld","poem":3},{"text":"och invånarna talar lögn","poem":2},{"text":"med falsk tunga i sin mun,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"måste jag slå dig med sår","poem":1},{"text":"som inte läks","poem":3},{"text":"och lägga dig i ruiner","poem":2},{"text":"för dina synders skull.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Du ska äta men inte bli mätt,","poem":1},{"text":"hunger ska plåga dig.","poem":3},{"text":"Det du får undan","poem":2},{"text":"ska du inte kunna rädda,","poem":3},{"text":"och vad du räddar","poem":2},{"text":"ska jag ge åt svärdet.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Du ska så men inte få skörda,","poem":1},{"text":"pressa oliver men inte","poem":2},{"text":"få smörja dig med oljan,","poem":3},{"text":"och druvmust men inte","poem":2},{"text":"få dricka vinet.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Man håller fast vid Omris stadgar","poem":1},{"text":"och allt som Ahabs hus","poem":2},{"noteId":24},{"text":"har gjort.","poem":2},{"text":"Ni följer deras råd.","poem":3},{"text":"Därför ska jag göra dig","poem":2},{"text":"till en ödemark","poem":3},{"text":"och stadens invånare till åtlöje,","poem":2},{"text":"och ni ska få bära","poem":3},{"text":"mitt folks förakt.","poem":4}]}],"footnotes":[{"noteId":21,"caller":"-","text":"mellan Shittim och GilgalHär flyter floden Jordan, som delades mirakulöst inför folket (Jos 3). Vid Shittim blev folket även välsignade av hednaprofeten Bileam (4 Mos 22-24, 25:1).","reference":{"chapter":6,"verse":5}},{"noteId":22,"caller":"-","text":"Vishet är att vörda ditt namnAnnan översättning: ”Visheten får se ditt namn”.","reference":{"chapter":6,"verse":9}},{"noteId":23,"caller":"-","text":"efa-måttCa 22 liter. De som sålde med snåla mått lurade till sig pengar (jfr Ords 20:10).","reference":{"chapter":6,"verse":10}},{"noteId":24,"caller":"-","text":"Omris stadgar … Ahabs husNordrikeskungarnas avfällighet (1 Kung 16:25f).","reference":{"chapter":6,"verse":16}}]},"thisChapterLink":"/api/swe_fol/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}