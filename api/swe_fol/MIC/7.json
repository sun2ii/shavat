{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"MIC","translationId":"swe_fol","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"3869d5d879c4fe3a5ec9029ed9a8f89347aa40293b68041c02e8e064e63d3a57","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swe_fol/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Israels förfall och nöd"]},{"type":"verse","number":1,"content":["Ve mig!",{"text":"Det är med mig","poem":1},{"text":"som när sommarens frukt","poem":2},{"text":"är insamlad,","poem":3},{"text":"som när efterskörden","poem":2},{"text":"efter vinbärgningen är slut.","poem":3},{"text":"Det finns ingen druvklase att äta,","poem":2},{"text":"inget tidigt fikon","poem":3},{"text":"som jag längtat efter.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"De fromma är försvunna","poem":1},{"text":"från jorden,","poem":3},{"text":"ingen bland människorna","poem":2},{"text":"är ärlig.","poem":3},{"text":"Alla ligger de på lur efter blod,","poem":2},{"text":"var och en vill fånga den andre","poem":3},{"text":"i sitt nät.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Deras händer är skickliga","poem":1},{"text":"på att göra det onda.","poem":3},{"text":"Fursten begär gåvor","poem":2},{"text":"och domaren mutor,","poem":3},{"text":"den mäktige kräver","poem":2},{"text":"vad han vill ha.","poem":3},{"text":"Så gör de gemensam sak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Den bäste bland dem","poem":1},{"text":"är som ett törnsnår,","poem":3},{"text":"den ärligaste värre","poem":2},{"text":"än en törnhäck.","poem":3},{"text":"Det kommer en dag","poem":2},{"text":"för dina väktare,","poem":3},{"text":"din räkenskapsdag.","poem":2},{"text":"Då grips de av förvirring.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Tro inte på en vän,","poem":1},{"text":"lita inte på en förtrogen.","poem":3},{"text":"Vakta din muns dörrar","poem":2},{"text":"för henne som vilar i din famn,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"för sonen föraktar sin far,","poem":1},{"text":"dottern trotsar sin mor,","poem":2},{"text":"sonhustrun sin svärmor,","poem":3},{"text":"och var och en har sin egen familj","poem":2},{"text":"till fiender.","poem":3},{"noteId":25}]},{"type":"heading","content":["Israels upprättelse"]},{"type":"verse","number":7,"content":[{"text":"Men jag ska skåda efter Herren,","poem":1},{"text":"jag ska hoppas","poem":2},{"text":"på min frälsnings Gud.","poem":3},{"text":"Min Gud ska höra mig.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gläd dig inte över mig,","poem":1},{"text":"du min fiende.","poem":3},{"text":"Har jag fallit","poem":2},{"text":"ska jag resa mig igen,","poem":3},{"text":"sitter jag i mörkret","poem":2},{"text":"är Herren mitt ljus.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Eftersom jag syndat mot Herren","poem":1},{"text":"ska jag bära hans vrede","poem":3},{"text":"tills han tar sig an min sak","poem":2},{"text":"och skaffar mig rätt.","poem":3},{"text":"Han ska föra mig ut i ljuset,","poem":2},{"text":"och jag ska se hans rättfärdighet.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Min fiende ska se det","poem":1},{"text":"och täckas av skam,","poem":3},{"text":"hon","poem":2},{"noteId":26},{"text":"som sade till mig:","poem":2},{"text":"”Var är nu Herren din Gud?”","poem":3},{"text":"Mina ögon ska se på henne,","poem":2},{"text":"hur hon trampas ner","poem":3},{"text":"som smuts på gatan.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"En dag ska dina murar byggas upp.","poem":1},{"text":"Den dagen ska dina","poem":2},{"text":"gränser vidgas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Den dagen ska man komma till dig","poem":1},{"text":"från Assur och från Egyptens städer,","poem":2},{"text":"från Egypten och ända till floden,","poem":3},{"text":"från hav till hav","poem":2},{"text":"och från berg till berg.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Men jorden ska bli en ödemark","poem":1},{"text":"för sina invånares skull.","poem":3},{"text":"Det blir frukten","poem":2},{"text":"av deras gärningar.","poem":3}]},{"type":"heading","content":["Bön och lovsång"]},{"type":"verse","number":14,"content":[{"text":"Vakta ditt folk med din stav,","poem":1},{"text":"din arvedels hjord","poem":3},{"text":"som bor avskild i skogen,","poem":2},{"text":"mitt i ett fruktbart land.","poem":3},{"text":"Låt den beta i Bashan och i Gilead","poem":2},{"noteId":27},{"text":"som under forna dagar.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Som i de dagar","poem":1},{"text":"du drog ut ur Egyptens land","poem":3},{"text":"ska jag visa dem underbara ting.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hednafolken ska se det och skämmas","poem":1},{"text":"med all sin makt.","poem":3},{"text":"De ska lägga handen på munnen,","poem":2},{"text":"deras öron ska bli döva.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"De ska slicka stoftet som ormar,","poem":1},{"text":"som markens kräldjur.","poem":3},{"text":"Bävande ska de överge sina hålor,","poem":2},{"text":"skräckslagna ska de söka","poem":3},{"text":"Herren vår Gud.","poem":4},{"text":"De ska frukta dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Vem är en Gud som du,","poem":1},{"text":"som förlåter skuld","poem":2},{"noteId":28},{"text":"och inte tillräknar synd","poem":3},{"text":"hos dem som är kvar","poem":2},{"text":"av din arvedel?","poem":3},{"text":"Han håller inte kvar sin vrede","poem":2},{"text":"för evigt,","poem":3},{"text":"för han har sin glädje i nåd.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Han ska förbarma sig över oss igen","poem":1},{"text":"och trampa på","poem":3},{"text":"våra missgärningar.","poem":4},{"text":"Du ska kasta alla deras synder","poem":2},{"noteId":29},{"text":"i havets djup.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Du ska visa trofasthet mot Jakob","poem":1},{"text":"och nåd mot Abraham,","poem":3},{"text":"så som du med ed har lovat","poem":2},{"text":"våra fäder i forntidens dagar.","poem":3}]}],"footnotes":[{"noteId":25,"caller":"-","text":"Citeras av Jesus i Matt 10:21, 35f och Luk 12:53.","reference":{"chapter":7,"verse":6}},{"noteId":26,"caller":"-","text":"honStäder framställdes ofta som kvinnor (jfr Jes 47:1, Upp 17-18).","reference":{"chapter":7,"verse":10}},{"noteId":27,"caller":"-","text":"Bashan och GileadBördiga områden öster om Jordanfloden som hade tilldelats israeliterna (Jos 13:24f) men sedan förlorats till arameerna (2 Kung 10:33) och assyrierna (2 Kung 15:29).","reference":{"chapter":7,"verse":14}},{"noteId":28,"caller":"-","text":"förlåter skuldAnnan översättning: ”bär/tar bort skuld” (jfr Joh 1:29 med not).","reference":{"chapter":7,"verse":18}},{"noteId":29,"caller":"-","text":"deras synderAndra handskrifter (så Septuaginta): ”våra synder”.","reference":{"chapter":7,"verse":19}}]},"thisChapterLink":"/api/swe_fol/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}