{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"NAM","translationId":"swe_fol","name":"Nahum","commonName":"Nahum","title":"Nahum","order":34,"numberOfChapters":3,"sha256":"2bd998c215dfb75faf9da9809620806b07402cfef49fe585ade76c70338bafa6","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Profetia om Nineve, boken med Nahum från Elkoshs",{"noteId":0},"syn."]},{"type":"heading","content":["Herrens vrede över Nineve"]},{"type":"verse","number":2,"content":[{"text":"Herren är en nitisk Gud","poem":1},{"text":"och en hämnare.","poem":3},{"text":"Herren tar hämnd och vredgas,","poem":2},{"text":"Herren tar hämnd","poem":3},{"text":"på sina ovänner","poem":4},{"text":"och har vrede i förvar åt sina fiender.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Herren är sen till vrede","poem":1},{"text":"men stor i kraft,","poem":2},{"text":"han låter ingen gå ostraffad.","poem":3},{"text":"Herren har sin väg","poem":2},{"text":"i storm och oväder,","poem":3},{"text":"och molnen är dammet","poem":2},{"text":"under hans fötter.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Han straffar havet","poem":1},{"text":"och låter det torka ut,","poem":2},{"text":"han låter alla floder sina.","poem":3},{"text":"Då tynar Bashan och Karmel bort","poem":2},{"text":"och Libanons grönska vissnar.","poem":3},{"noteId":1}]},{"type":"verse","number":5,"content":[{"text":"Bergen darrar för honom","poem":1},{"text":"och höjderna smälter.","poem":3},{"text":"Jorden bävar för hans ansikte,","poem":2},{"text":"världen och alla som bor där.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Vem kan bestå inför hans harm,","poem":1},{"text":"vem kan uthärda","poem":2},{"text":"hans vredes glöd?","poem":3},{"text":"Hans vrede brinner som eld","poem":2},{"text":"och klipporna spricker","poem":3},{"text":"inför honom.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Herren är god,","poem":1},{"text":"en tillflykt på nödens dag,","poem":3},{"text":"han känner dem","poem":2},{"text":"som flyr till honom.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Men med en störtflod","poem":1},{"text":"förintar han platsen","poem":2},{"text":"där Nineve står,","poem":3},{"text":"och mörker förföljer hans fiender.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vad ni än planerar mot Herren","poem":1},{"text":"ska han komma","poem":2},{"text":"med fullständig ödeläggelse.","poem":3},{"text":"Nöden ska inte komma två gånger.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Om de än är hopslingrade","poem":1},{"text":"som törnsnår","poem":3},{"text":"och druckna av sitt drickande,","poem":2},{"text":"ska de alla förtäras som torrt gräs.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Från dig har en man gått ut,","poem":1},{"text":"en som tänker ut ont mot Herren,","poem":2},{"noteId":2},{"text":"en rådgivare i ondska.","poem":3}]},{"type":"heading","content":["Guds nåd över Juda"]},{"type":"verse","number":12,"content":[{"text":"Så säger Herren:","poem":1},{"text":"”Hur starka och många de än är,","poem":2},{"text":"ska de ändå mejas ner","poem":3},{"text":"och försvinna.","poem":4},{"text":"Jag har plågat dig,","poem":2},{"text":"men ska inte plåga dig mer.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Nu ska jag bryta hans ok","poem":1},{"noteId":3},{"text":"över dig,","poem":1},{"text":"jag ska slita av dina band.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Men om dig, Nineve,","poem":1},{"text":"har Herren befallt:","poem":3},{"text":"”Inga efterkommande","poem":2},{"text":"ska bära vidare ditt namn.","poem":3},{"text":"Ur dina gudars hus","poem":2},{"noteId":4},{"text":"ska jag utrota alla bilder,","poem":3},{"text":"både snidade och gjutna.","poem":4},{"text":"Jag ska göra i ordning en grav åt dig,","poem":2},{"text":"för du är ingenting värd","poem":3},{"noteId":5},{"text":".”","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Se, över bergen kommer","poem":1},{"text":"glädjebudbäraren","poem":2},{"text":"som förkunnar frid.","poem":3},{"text":"Fira dina högtider, Juda,","poem":2},{"text":"uppfyll dina löften,","poem":3},{"text":"för den onde ska inte mer","poem":2},{"text":"dra fram genom dig,","poem":3},{"text":"han är helt tillintetgjord.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"-","text":"ElkoshOkänd ort. Senare traditioner placerar den i Galileen, Judeen eller Mesopotamien.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"-","text":"Bashan … Karmel … LibanonRegnrika och bördiga högländer i trakten runt Galileen.","reference":{"chapter":1,"verse":4}},{"noteId":2,"caller":"-","text":"en som tänker ut ont mot HerrenTroligen kung Sanherib eller hans tjänare Rab-Shake, som hädade Gud och belägrade Jerusalem år 701 f Kr (se Jes 36-37).","reference":{"chapter":1,"verse":11}},{"noteId":3,"caller":"-","text":"okBärstång över axlar, en vanlig bild för underordning (1 Kung 12:4, Jes 9:4).","reference":{"chapter":1,"verse":13}},{"noteId":4,"caller":"-","text":"dina gudars husNineves huvudgudar var krigsgudinnan Ishtar och kungsguden Ashur, i vars namn assyrierna förde sina krig. Templen hade utökats av kung Sanherib (705-681 f Kr) som plundrade Juda (2 Kung 18:13).","reference":{"chapter":1,"verse":14}},{"noteId":5,"caller":"-","text":"ingenting värdAnnan översättning: ”befunnen för lätt” (jfr Dan 5:27).","reference":{"chapter":1,"verse":14}}]},"thisChapterLink":"/api/swe_fol/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}