{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"NAM","translationId":"swe_fol","name":"Nahum","commonName":"Nahum","title":"Nahum","order":34,"numberOfChapters":3,"sha256":"2bd998c215dfb75faf9da9809620806b07402cfef49fe585ade76c70338bafa6","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Nineves fall"]},{"type":"verse","number":1,"content":["En folkförskingrare",{"text":"drar upp mot dig.","poem":3},{"text":"Bevaka dina fästen!","poem":2},{"text":"Spana mot vägen, rusta dig,","poem":3},{"text":"samla all din kraft.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Herren ska återställa Jakobs storhet","poem":1},{"text":"liksom Israels storhet,","poem":3},{"text":"för plundrare har plundrat dem","poem":2},{"text":"och fördärvat deras vinstockar.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Hans hjältars sköldar","poem":1},{"text":"har färgats röda,","poem":3},{"text":"kämparna går klädda","poem":2},{"text":"i scharlakan.","poem":3},{"noteId":6},{"text":"Vagnarna gnistrar av stålglans","poem":2},{"noteId":7},{"text":"den dag han gör sig redo,","poem":3},{"text":"det svingas med spjut av cypress","poem":2},{"noteId":8},{"text":".","poem":2}]},{"type":"verse","number":4,"content":[{"text":"På gatorna stormar vagnarna fram,","poem":1},{"text":"de kör om varandra på torgen.","poem":3},{"text":"De ser ut som bloss,","poem":2},{"text":"de far i väg som blixtar.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Han kommer ihåg","poem":1},{"text":"sina väldiga kämpar.","poem":3},{"text":"De snubblar där de rusar fram,","poem":2},{"text":"de skyndar mot stadens murar","poem":3},{"text":"och skyddstaken","poem":4},{"noteId":9},{"text":"görs redo.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Flodernas portar öppnas","poem":1},{"noteId":10},{"text":",","poem":1},{"text":"och palatset","poem":2},{"noteId":11},{"text":"faller ihop.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Det är bestämt:","poem":1},{"text":"Hon ska kläs av och föras bort.","poem":3},{"text":"Hennes slavflickor","poem":2},{"text":"ska sucka som duvor","poem":3},{"text":"och slå sig över hjärtat.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Nineve var sedan gammalt","poem":1},{"text":"som en vattenrik damm,","poem":3},{"text":"men nu flyr vattnet bort.","poem":2},{"text":"”Stanna! Stanna!”","poem":3},{"text":"Men ingen vänder sig om.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Röva silver, röva guld!","poem":1},{"text":"Här finns skatter utan slut,","poem":2},{"text":"överflöd av dyrbarheter.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Tom, tömd, förödd!","poem":1},{"text":"Modlösa hjärtan, vacklande knän!","poem":3},{"text":"Darrande höfter överallt!","poem":2},{"text":"Alla ansikten är blossande röda.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Var är nu lejonens","poem":1},{"noteId":12},{"text":"kula,","poem":1},{"text":"platsen där de unga lejonen","poem":2},{"text":"åt sitt byte,","poem":3},{"text":"där lejonet och lejonhonan","poem":2},{"text":"och lejonungen gick omkring","poem":3},{"text":"utan att någon skrämde dem?","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Lejonet rev i stycken","poem":1},{"text":"tills ungarna fick nog,","poem":3},{"text":"dödade för sina lejonhonor","poem":2},{"text":"och fyllde sina hålor med byte,","poem":3},{"text":"sina kulor med rivna djur.","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Se, jag är emot dig,","poem":1},{"text":"säger Herren Sebaot.","poem":3},{"text":"Jag ska låta dina vagnar","poem":2},{"noteId":13},{"text":"gå upp i rök,","poem":3},{"text":"och dina unga lejon","poem":2},{"text":"ska förtäras av svärd.","poem":3},{"text":"Jag ska utplåna ditt rövade gods","poem":2},{"text":"från jorden,","poem":3},{"text":"och röster av dina sändebud","poem":2},{"text":"ska inte mer höras.","poem":3}]}],"footnotes":[{"noteId":6,"caller":"-","text":"klädda i scharlakanBlodröda kläder för att skrämma fienden är kända från t ex Sparta.","reference":{"chapter":2,"verse":3}},{"noteId":7,"caller":"-","text":"stålglansMetallförstärkta vagnar för att meja ner fotsoldater (jfr Dom 4:3 med not).","reference":{"chapter":2,"verse":3}},{"noteId":8,"caller":"-","text":"det svingas med spjut av cypressAndra handskrifter (Septuaginta): ”hästarna skakar”.","reference":{"chapter":2,"verse":3}},{"noteId":9,"caller":"-","text":"skyddstakenBelägringssköld som skyddade mot pilar och föremål från stadens mur.","reference":{"chapter":2,"verse":5}},{"noteId":10,"caller":"-","text":"Flodernas portar öppnasKung Sanherib (705-681 f Kr) hade tidigare dämt upp floden Tigris utanför staden. Historieskrivaren Diodorus berättar att en uppdämd flodvåg sopade bort en del av stadsmuren och öppnade vägen för invasionsarmén 612 f Kr.","reference":{"chapter":2,"verse":6}},{"noteId":11,"caller":"-","text":"palatsetSanheribs ”palats utan like” mätte ca 500 x 240 meter och var smyckat med statyer och reliefer över assyriernas segrar. Annan översättning: ”templet” (till Ishtar).","reference":{"chapter":2,"verse":6}},{"noteId":12,"caller":"-","text":"lejonens kulaAssyrierna liknade gärna sina kungar och gudar vid lejon i strid.","reference":{"chapter":2,"verse":11}},{"noteId":13,"caller":"-","text":"dina vagnarAndra handskrifter (Septuaginta): ”din rikedom”.","reference":{"chapter":2,"verse":13}}]},"thisChapterLink":"/api/swe_fol/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}