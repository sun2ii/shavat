{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"NAM","translationId":"swe_fol","name":"Nahum","commonName":"Nahum","title":"Nahum","order":34,"numberOfChapters":3,"sha256":"2bd998c215dfb75faf9da9809620806b07402cfef49fe585ade76c70338bafa6","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Nineves övermod och straff"]},{"type":"verse","number":1,"content":["Ve dig, du blodstad,",{"text":"full av lögn, fylld av våld,","poem":2},{"lineBreak":true},{"text":"du som aldrig slutar plundra!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hör, piskor smäller!","poem":1},{"text":"Hör, vagnshjul dånar!","poem":3},{"text":"Hästar jagar fram,","poem":2},{"text":"vagnar rullar i väg.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ryttare stormar fram,","poem":1},{"text":"svärden ljungar","poem":2},{"text":"och spjuten blixtrar.","poem":3},{"text":"Slagna i mängd och högar av lik,","poem":2},{"text":"det är ingen ände på döda,","poem":3},{"text":"man stupar över döda kroppar.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Allt sker för hennes stora otukt,","poem":1},{"text":"den vackra horan","poem":2},{"noteId":14},{"text":",","poem":2},{"text":"häxkonsternas mästarinna,","poem":3},{"text":"hon som sålde folken","poem":2},{"text":"genom sin otukt","poem":3},{"text":"och folkstammar","poem":2},{"text":"genom sina häxkonster.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Se, jag ska vända mig mot dig,","poem":1},{"text":"säger Herren Sebaot.","poem":3},{"text":"Jag ska lyfta upp ditt mantelsläp","poem":2},{"text":"över ditt ansikte","poem":3},{"text":"och låta folken se din nakenhet","poem":2},{"text":"och kungariken din skam.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag ska kasta vidriga ting över dig,","poem":1},{"text":"låta dig bli föraktad","poem":2},{"text":"och göra dig till åtlöje.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Och det ska ske","poem":1},{"text":"att var och en som ser dig","poem":2},{"text":"ska fly från dig och säga:","poem":3},{"text":"”Nineve är ödelagt,","poem":2},{"text":"vem har medlidande","poem":3},{"text":"med henne?”","poem":4},{"text":"Var kan jag finna tröstare åt dig?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Är du bättre än No-Amon","poem":1},{"noteId":15},{"text":"som tronade","poem":2},{"text":"vid Nilens strömmar?","poem":3},{"text":"Vatten omgav henne,","poem":2},{"text":"hon hade havet till vall","poem":3},{"text":"och vatten till mur.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Nubien och Egypten","poem":1},{"text":"var hennes oändliga styrka,","poem":3},{"text":"Put","poem":2},{"noteId":16},{"text":"och Libyen var hennes hjälp.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Också hon fördes bort","poem":1},{"text":"i landsflykt och fångenskap,","poem":3},{"text":"även hennes barn blev krossade","poem":2},{"text":"i alla gathörn.","poem":3},{"text":"Man kastade lott","poem":2},{"text":"om hennes ärade män,","poem":3},{"text":"och alla hennes stormän","poem":2},{"text":"fängslades med kedjor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Också du ska bli drucken","poem":1},{"text":"och gömma dig,","poem":3},{"text":"också du ska söka skydd","poem":2},{"text":"mot fienden.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Alla dina fästen liknar fikonträd","poem":1},{"noteId":17},{"text":"med mogen frukt.","poem":3},{"text":"När man skakar dem","poem":2},{"text":"faller fikonen i munnen","poem":3},{"text":"på den som vill äta.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Se, ditt krigsfolk","poem":1},{"text":"är som kvinnor.","poem":3},{"text":"Ditt lands portar står vidöppna","poem":2},{"text":"för dina fiender.","poem":3},{"text":"Eld förtär dina bommar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ös upp vatten åt dig för belägringen","poem":1},{"text":"och förstärk dina fästen.","poem":3},{"text":"Stig ner i leran","poem":2},{"text":"och trampa i murbruket.","poem":3},{"text":"Gör tegelformen stark.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Där ska elden förtära dig","poem":1},{"text":"och svärdet utrota dig,","poem":3},{"text":"det ska sluka dig som gräsmaskar","poem":2},{"noteId":18},{"text":",","poem":2},{"text":"även om du är talrik","poem":3},{"text":"som gräsmaskar","poem":4},{"text":"och förökar dig som gräshoppor.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Du har fler köpmän","poem":1},{"text":"än himlens stjärnor,","poem":3},{"text":"men som gräsmaskar plundrar de","poem":2},{"text":"och flyger sedan bort.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Dina furstar är som gräshoppor,","poem":1},{"text":"dina befälhavare","poem":2},{"text":"som gräshoppssvärmar.","poem":3},{"text":"De stannar inom murarna","poem":2},{"text":"när dagen är kall,","poem":3},{"text":"men när solen kommer fram","poem":2},{"text":"flyr de bort,","poem":3},{"text":"och sedan vet ingen var de är.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Dina herdar har somnat,","poem":1},{"text":"du Assurs kung","poem":3},{"noteId":19},{"text":",","poem":3},{"text":"dina förnäma män ligger i ro.","poem":2},{"text":"Ditt folk är skingrat","poem":3},{"text":"uppe på bergen,","poem":4},{"text":"och ingen samlar ihop det.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Det finns ingen läkedom","poem":1},{"text":"för din skada,","poem":2},{"text":"ditt sår är obotligt.","poem":3},{"text":"Alla som hör vad som hänt dig","poem":2},{"text":"klappar i händerna över dig,","poem":3},{"text":"för vem har inte drabbats","poem":2},{"text":"av din ständiga ondska?","poem":3},{"noteId":20}]}],"footnotes":[{"noteId":14,"caller":"-","text":"den vackra horanAssyriernas krigsgudinna Ishtar dyrkades med lössläppta ritualer.","reference":{"chapter":3,"verse":4}},{"noteId":15,"caller":"-","text":"No-AmonTempelstaden Thebe (nutida Luxor) vid Nilen i södra Egypten, en gång rikets huvudstad. Den hade ansetts ointaglig men plundrades av assyrierna år 663 f Kr.","reference":{"chapter":3,"verse":8}},{"noteId":16,"caller":"-","text":"PutTroligen ett folk i Libyen, allierat med egyptierna (1 Mos 10:6, Hes 30:5).","reference":{"chapter":3,"verse":9}},{"noteId":17,"caller":"-","text":"fikonträdVanligt förekommande i Nineve, ofta avbildade på assyriska reliefer.","reference":{"chapter":3,"verse":12}},{"noteId":18,"caller":"-","text":"gräsmaskarTroligen gräshoppans vinglösa larvstadium (jfr vers 16).","reference":{"chapter":3,"verse":15}},{"noteId":19,"caller":"-","text":"Assurs kungTroligen Sin-Shar-Ishkun, som regerade i Nineve 627-612 f Kr fram till stadens fall.","reference":{"chapter":3,"verse":18}},{"noteId":20,"caller":"-","text":"din ständiga ondskaAssyriska reliefer glorifierade tortyr av fångar (jfr 2 Krön 33:11).","reference":{"chapter":3,"verse":19}}]},"thisChapterLink":"/api/swe_fol/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}