{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"NEH","translationId":"swe_fol","name":"Nehemja","commonName":"Nehemja","title":"Nehemja","order":16,"numberOfChapters":13,"sha256":"a0892dee10c982e4e8b5ea3c133d378e5d1e1dde8263c7731bcc1d1d83f4b654","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/NEH/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/swe_fol/NEH/13.json","totalNumberOfVerses":406},"chapter":{"number":9,"content":[{"type":"heading","content":["Folket bekänner sina synder"]},{"type":"verse","number":1,"content":["På tjugofjärde dagen",{"noteId":40},"i samma månad samlades Israels barn till fasta, klädda i sorgdräkt och med jord på sina huvuden",{"noteId":41},"."]},{"type":"verse","number":2,"content":["De som var av Israels släkt avskilde sig från alla främlingar och kom fram och bekände sina synder och sina fäders missgärningar."]},{"type":"verse","number":3,"content":["De reste sig från sin plats, och man läste ur Herren deras Guds lagbok under en fjärdedel av dagen. Nästa fjärdedel bekände de sina synder och tillbad Herren sin Gud."]},{"type":"verse","number":4,"content":["Jeshua och Bani, Kadmiel, Shebanja, Bunni, Sherebja, Bani och Kenani steg upp på leviternas plattform och ropade med hög röst till Herren sin Gud."]},{"type":"verse","number":5,"content":["Leviterna Jeshua och Kadmiel, Bani, Hashabneja, Sherebja, Hodia, Shebanja och Petaja sade:",{"lineBreak":true},{"text":"”Res er och prisa Herren er Gud,","poem":1},{"text":"från evighet till evighet!","poem":2},{"text":"Lovat vare ditt härliga namn,","poem":1},{"text":"som är upphöjt","poem":2},{"text":"över allt lov och pris.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Du ensam är Herren.","poem":1},{"text":"Du gjorde himlarna","poem":2},{"text":"och himlarnas himmel","poem":3},{"text":"och hela deras härskara,","poem":4},{"text":"jorden och allt som är på den,","poem":2},{"text":"haven och allt som är i dem,","poem":3},{"text":"och du håller dem alla vid liv.","poem":2},{"text":"Himlens härskara tillber dig.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Du är Herren Gud","poem":1},{"text":"som utvalde Abram","poem":3},{"text":"och förde honom ut","poem":2},{"text":"från det kaldeiska Ur","poem":3},{"text":"och gav honom namnet Abraham.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Du fann hans hjärta trofast inför dig,","poem":1},{"text":"och du slöt förbund","poem":2},{"text":"med honom:","poem":3},{"text":"att ge åt hans efterkommande","poem":2},{"text":"kananeernas, hetiternas,","poem":3},{"text":"amoreernas, perisseernas,","poem":4},{"text":"jebusiternas och girgasheernas","poem":3},{"text":"land.","poem":4},{"text":"Du lät dina ord gå i uppfyllelse,","poem":2},{"text":"för du är rättfärdig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Du såg våra fäders nöd i Egypten","poem":1},{"text":"och hörde deras rop","poem":2},{"text":"vid Röda havet.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Du gjorde tecken och under","poem":1},{"text":"mot farao,","poem":3},{"text":"mot alla hans tjänare","poem":2},{"text":"och mot allt folket i hans land,","poem":3},{"text":"för du visste hur arrogant","poem":2},{"text":"egyptierna behandlade dem.","poem":3},{"text":"Du gjorde dig ett namn,","poem":2},{"text":"som är detsamma än i dag.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Du delade havet framför dem,","poem":1},{"text":"och de gick genom havet","poem":2},{"text":"på torr mark.","poem":3},{"text":"Men deras förföljare","poem":2},{"text":"sänkte du i djupet,","poem":3},{"text":"som en sten i väldiga vatten.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Du ledde dem","poem":1},{"text":"med en molnpelare om dagen","poem":2},{"text":"och en eldpelare om natten,","poem":3},{"text":"för att lysa dem på vägen","poem":2},{"text":"de skulle gå.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"På Sinai berg steg du ner","poem":1},{"text":"och talade till dem från himlen,","poem":3},{"text":"du gav dem rättfärdiga föreskrifter","poem":2},{"text":"och sanna lagar,","poem":3},{"text":"goda stadgar och bud.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Du gav dem kunskap","poem":1},{"text":"om din heliga sabbat","poem":3},{"text":"och gav dem bud,","poem":2},{"text":"stadgar och lagar","poem":3},{"text":"genom din tjänare Mose.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Du gav dem bröd från himlen","poem":1},{"text":"när de hungrade","poem":3},{"text":"och lät vatten komma ur klippan","poem":2},{"text":"när de törstade.","poem":3},{"text":"Du befallde dem att gå","poem":2},{"text":"och ta i besittning det land","poem":3},{"text":"som du med upplyft hand","poem":2},{"text":"hade lovat ge dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Men våra fäder blev övermodiga","poem":1},{"text":"och hårdnackade","poem":3},{"text":"och lyssnade inte","poem":2},{"text":"till dina befallningar.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"De vägrade lyssna","poem":1},{"text":"och tänkte inte på undren","poem":2},{"text":"du gjort bland dem.","poem":3},{"text":"De var hårdnackade och valde","poem":2},{"text":"i sin upproriskhet en ledare","poem":3},{"text":"för att vända tillbaka","poem":2},{"text":"till sitt slaveri.","poem":3},{"text":"Men du är en Gud som förlåter,","poem":2},{"text":"nådig och barmhärtig,","poem":3},{"text":"sen till vrede och stor i nåd.","poem":4},{"text":"Du övergav dem inte,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"fastän de gjorde sig en gjuten kalv","poem":1},{"text":"och sade:","poem":3},{"text":"”Här är din gud","poem":2},{"text":"som har fört dig upp ur Egypten.”","poem":3},{"text":"Och de gjorde sig skyldiga","poem":2},{"text":"till stora hädelser.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Men i din stora barmhärtighet","poem":1},{"text":"övergav du dem ändå inte","poem":2},{"text":"i öknen.","poem":3},{"text":"Molnpelaren vek inte","poem":2},{"text":"från dem om dagen","poem":3},{"text":"utan ledde dem på vägen,","poem":4},{"text":"och eldpelaren lyste i natten","poem":2},{"text":"på vägen de skulle gå.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Din gode Ande gav du","poem":1},{"text":"för att undervisa dem.","poem":3},{"text":"Ditt manna nekade du inte","poem":2},{"text":"deras mun,","poem":3},{"text":"och vatten gav du dem","poem":2},{"text":"när de törstade.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"I fyrtio år försörjde du dem","poem":1},{"text":"i öknen,","poem":4},{"text":"och de saknade ingenting.","poem":3},{"text":"Deras kläder blev inte utslitna,","poem":2},{"text":"och deras fötter svullnade inte.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Du gav dem riken och folk","poem":1},{"text":"och fördelade olika områden","poem":2},{"text":"åt dem.","poem":3},{"text":"De intog Sichons land,","poem":2},{"text":"kungen av Heshbons land,","poem":3},{"text":"och kung Og av Bashans land.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Deras barn gjorde du talrika","poem":1},{"text":"som stjärnorna på himlen.","poem":3},{"text":"Du förde dem in i det land","poem":2},{"text":"som du lovat deras fäder","poem":3},{"text":"att få komma till och ta i besittning.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Och deras barn kom","poem":1},{"text":"och tog landet i besittning.","poem":3},{"text":"Du kuvade landets invånare","poem":2},{"text":"kananeerna för dem","poem":3},{"text":"och gav dem i deras hand,","poem":2},{"text":"både kungarna och landets folk,","poem":3},{"text":"och de gjorde som de ville","poem":2},{"text":"med dem.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"De intog befästa städer","poem":1},{"text":"och bördig jord","poem":3},{"text":"och tog över hus","poem":2},{"text":"fyllda med allt gott,","poem":3},{"text":"uthuggna brunnar,","poem":2},{"text":"vingårdar, olivlundar","poem":3},{"text":"och fruktträd i mängd.","poem":4},{"text":"De åt och blev mätta och feta","poem":2},{"text":"och njöt av din stora godhet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Men de gjorde uppror","poem":1},{"text":"och trotsade dig,","poem":3},{"text":"de kastade din lag","poem":2},{"text":"bakom sin rygg.","poem":3},{"text":"De dödade dina profeter","poem":2},{"text":"som varnade dem","poem":3},{"text":"och ville få dem att vända om","poem":2},{"text":"till dig.","poem":3},{"text":"De gjorde sig skyldiga","poem":2},{"text":"till grova hädelser.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Då gav du dem","poem":1},{"text":"i deras fienders hand","poem":2},{"text":"som förtryckte dem.","poem":3},{"text":"Men i sin nöd ropade de till dig,","poem":2},{"text":"och du hörde dem från himlen.","poem":3},{"text":"I din stora barmhärtighet","poem":2},{"text":"gav du dem befriare","poem":3},{"text":"som frälste dem","poem":2},{"text":"ur deras fienders hand.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Men när de kom till ro,","poem":1},{"text":"gjorde de på nytt","poem":2},{"text":"det som var ont inför dig.","poem":3},{"text":"Då lämnade du dem","poem":2},{"text":"i deras fienders hand,","poem":3},{"text":"som fick råda över dem.","poem":4},{"text":"Men de ropade på nytt till dig,","poem":2},{"text":"och du hörde det","poem":3},{"text":"från himlen,","poem":4},{"text":"du räddade dem många gånger","poem":2},{"text":"i din barmhärtighet.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Du förmanade dem","poem":1},{"text":"för att återföra dem","poem":2},{"text":"till din undervisning.","poem":3},{"text":"Men de var övermodiga","poem":2},{"text":"och lyssnade inte på dina bud","poem":3},{"text":"utan syndade","poem":2},{"text":"mot dina föreskrifter,","poem":3},{"text":"trots att den människa","poem":2},{"text":"som håller dem","poem":4},{"text":"ska leva genom dem.","poem":3},{"text":"De var envisa och hårdnackade","poem":2},{"text":"och vägrade lyssna.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Du hade tålamod med dem","poem":1},{"text":"i många år","poem":3},{"text":"och förmanade dem","poem":2},{"text":"med din Ande","poem":3},{"text":"genom dina profeter,","poem":2},{"text":"men de lyssnade inte.","poem":3},{"text":"Då gav du dem","poem":2},{"text":"i de främmande folkens hand.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Men du som är rik","poem":1},{"text":"på barmhärtighet","poem":3},{"text":"gjorde inte slut på dem","poem":2},{"text":"och övergav dem inte,","poem":3},{"text":"för du är en nådig","poem":2},{"text":"och barmhärtig Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Och nu, vår Gud, du store,","poem":1},{"text":"väldige och fruktade Gud,","poem":2},{"text":"du som håller förbundet","poem":3},{"text":"och nåden:","poem":4},{"text":"Låt den inte vara liten i dina ögon,","poem":2},{"text":"den plåga som har drabbat oss,","poem":3},{"text":"våra kungar, våra furstar,","poem":2},{"text":"våra präster, våra profeter,","poem":3},{"text":"våra fäder och hela ditt folk –","poem":4},{"text":"från de assyriska kungarnas dagar","poem":2},{"noteId":42},{"text":"ända till i dag.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Du är rättfärdig","poem":1},{"text":"i allt det som har drabbat oss,","poem":3},{"text":"för du har visat dig trofast","poem":2},{"text":"medan vi har varit ogudaktiga.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Våra kungar, våra furstar,","poem":1},{"text":"våra präster och våra fäder","poem":3},{"text":"höll inte din lag","poem":2},{"text":"och lyssnade inte till dina bud","poem":3},{"text":"och de varningar du gav dem.","poem":4}]},{"type":"verse","number":35,"content":[{"text":"Trots att de levde i sitt eget rike","poem":1},{"text":"med allt det goda","poem":2},{"text":"som du gav dem","poem":3},{"text":"i det rymliga och bördiga land","poem":2},{"text":"som du skänkte dem,","poem":3},{"text":"har de ändå inte tjänat dig","poem":2},{"text":"eller vänt om","poem":3},{"text":"från sina onda gärningar.","poem":4}]},{"type":"verse","number":36,"content":[{"text":"I dag är vi slavar","poem":1},{"text":"i det land som du gav våra fäder","poem":2},{"text":"att äta dess frukt och dess goda,","poem":3},{"text":"där är vi slavar.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Dess rika skörd går till de kungar","poem":1},{"text":"du satt över oss","poem":2},{"text":"för våra synders skull.","poem":3},{"text":"De råder över våra kroppar","poem":2},{"text":"och vår boskap som de vill,","poem":3},"och vi är i stor nöd.”"]},{"type":"heading","content":["Förbundets förnyelse"]},{"type":"verse","number":38,"content":["På grund av allt detta slöt vi ett fast förbund och satte upp det skriftligt. På skrivelsen, som försågs med sigill, stod våra furstars, våra leviters och våra prästers namn."]}],"footnotes":[{"noteId":40,"caller":"-","text":"tjugofjärde dagenTvå dagar efter lövhyddohögtidens fastställda datum.","reference":{"chapter":9,"verse":1}},{"noteId":41,"caller":"-","text":"jord på sina huvudenFör att visa sorg, ånger och omvändelse (jfr 1 Sam 4:12, Klag 2:10).","reference":{"chapter":9,"verse":1}},{"noteId":42,"caller":"-","text":"de assyriska kungarnas dagarFrån 740-talet f Kr, då Assyrien började underkuva nordriket Israel (2 Kung 15:19) tills det gick under 722 f Kr (2 Kung 17). Senare härjades även Juda år 701 f Kr (2 Kung 18:13f).","reference":{"chapter":9,"verse":32}}]},"thisChapterLink":"/api/swe_fol/NEH/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/NEH/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/NEH/8.json","previousChapterAudioLinks":{},"numberOfVerses":38}