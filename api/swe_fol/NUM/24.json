{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"NUM","translationId":"swe_fol","name":"Fjärde Moseboken","commonName":"Fjärde Moseboken","title":"Fjärde Moseboken","order":4,"numberOfChapters":36,"sha256":"650347b3dfaf6365bfcac867847e79bf7be26ddd3381592f622198d1fb454f48","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/NUM/1.json","lastChapterNumber":36,"lastChapterApiLink":"/api/swe_fol/NUM/36.json","totalNumberOfVerses":1288},"chapter":{"number":24,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["När Bileam såg att det behagade Herren att välsigna Israel, gick han inte som förut bort och såg efter spåtecken",{"noteId":89},", utan vände sig mot öknen."]},{"type":"verse","number":2,"content":["Och när Bileam höjde blicken, såg han Israel i sina läger efter sina stammar. Och Guds Ande kom över honom."]},{"type":"verse","number":3,"content":["Då framförde han detta budskap:",{"lineBreak":true},{"text":"”Så säger Bileam, Beors son,","poem":1},{"text":"så säger mannen","poem":2},{"text":"med det slutna ögat","poem":3},{"noteId":90},{"text":",","poem":3}]},{"type":"verse","number":4,"content":[{"text":"så säger han som hör Guds ord,","poem":1},{"text":"han som skådar syner","poem":2},{"text":"från den Allsmäktige,","poem":3},{"text":"han som faller ner","poem":2},{"text":"och får sina ögon öppnade.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Hur sköna är inte dina tält, o Jakob,","poem":1},{"text":"dina boningar, o Israel!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Likt dalar utbreder de sig,","poem":1},{"text":"likt trädgårdar vid en ström,","poem":2},{"text":"likt aloeträd","poem":3},{"noteId":91},{"text":"planterade","poem":3},{"text":"av Herren,","poem":4},{"text":"likt cedrar vid vatten.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vatten flödar ur hans ämbar,","poem":1},{"text":"hans sådd blir rikligen vattnad.","poem":3},{"text":"Större än Agag","poem":2},{"noteId":92},{"text":"ska hans kung vara,","poem":3},{"text":"upphöjt är hans kungadöme.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gud förde honom ut ur Egypten.","poem":1},{"text":"Hans styrka är som vildoxens.","poem":3},{"text":"Han ska sluka hednafolken,","poem":2},{"text":"hans fiender.","poem":3},{"text":"Han ska krossa deras ben,","poem":2},{"text":"med sina pilar genomborra dem.","poem":3}]},{"type":"verse","number":9,"content":["Han har lagt sig ner,",{"text":"han vilar som ett lejon,","poem":3},{"text":"som en lejonhona,","poem":2},{"text":"vem vågar oroa honom?","poem":3},{"text":"Välsignad är den","poem":2},{"text":"som välsignar dig,","poem":3},{"text":"förbannad är den","poem":2},{"text":"som förbannar dig!”","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":["Då upptändes Balaks vrede mot Bileam, och han slog ihop händerna. Han sade till Bileam: ”Jag kallade hit dig för att förbanna mina fiender, men se, du har välsignat dem rikligt tre gånger."]},{"type":"verse","number":11,"content":["Ge dig nu av hem igen! Jag sade att jag skulle visa dig stor ära, men se, Herren har hindrat att du skulle bli ärad.”"]},{"type":"verse","number":12,"content":["Bileam svarade Balak: ”Sade jag inte till sändebuden som du skickade till mig:"]},{"type":"verse","number":13,"content":["Även om Balak skulle ge mig så mycket silver och guld som ryms i hans palats, kan jag ändå inte överträda Herrens befallning av egen vilja i vare sig gott eller ont. Vad Herren säger, det måste jag tala."]},{"type":"heading","content":["Bileams fjärde profetia"]},{"type":"verse","number":14,"content":["Se, jag går nu hem till mitt folk. Kom, jag vill varna dig för vad detta folk kommer att göra mot ditt folk i kommande dagar.”"]},{"type":"verse","number":15,"content":["Och han framförde detta budskap:",{"lineBreak":true},{"text":"”Så säger Bileam, Beors son,","poem":1},{"text":"så säger mannen","poem":2},{"text":"med det slutna ögat,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"så säger han som hör Guds ord","poem":1},{"text":"och har kunskap från den Högste.","poem":3},{"text":"Han ser syner","poem":2},{"text":"från den Allsmäktige","poem":3},{"text":"när han faller ner","poem":2},{"text":"och får sina ögon öppnade.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Jag ser honom, men inte nu,","poem":1},{"text":"jag skådar honom,","poem":2},{"text":"men inte nära.","poem":3},{"text":"En stjärna stiger fram","poem":2},{"noteId":93},{"text":"ur Jakob,","poem":2},{"text":"en spira höjer sig ur Israel.","poem":3},{"text":"Den krossar Moabs tinningar","poem":2},{"text":"och slår ner alla söner till Set.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Han ska få till besittning","poem":1},{"text":"Edom och Seir, sina fiender.","poem":3},{"text":"Och Israel ska göra mäktiga ting.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ur Jakob ska en härskare komma,","poem":1},{"text":"och de överlevande","poem":2},{"text":"ska han utrota ur staden.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":["Han fick se Amalek. Då framförde han detta budskap:",{"lineBreak":true},{"text":"”Den förste bland hednafolken","poem":1},{"text":"är Amalek,","poem":3},{"text":"men slutet för honom","poem":2},{"text":"blir undergång.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":["Han fick se keniterna",{"noteId":94},". Då framförde han detta budskap:",{"lineBreak":true},{"text":"”Säker är din boning,","poem":1},{"text":"lagt på klippan är ditt näste.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Likväl ska Kain skövlas","poem":1},{"noteId":95},{"text":"när Assur för dig bort","poem":2},{"text":"i fångenskap.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Och han framförde detta budskap:","poem":1},{"text":"”O, vem kan bli vid liv","poem":2},{"text":"när Gud låter detta ske?","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Skepp ska komma","poem":1},{"text":"från kitteernas kust,","poem":2},{"noteId":96},{"text":"de ska kuva Assur och kuva Eber.","poem":3},{"text":"Men också de ska drabbas","poem":2},{"text":"av undergång.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":["Sedan stod Bileam upp och vände tillbaka hem. Också Balak for sin väg."]}],"footnotes":[{"noteId":89,"caller":"-","text":"spåteckenSeptuaginta och Bileamsinskriptionen i Deir Alla (se not till 22:5) antyder att Bileam tolkade sina spåtecken utifrån fåglars flygmönster.","reference":{"chapter":24,"verse":1}},{"noteId":90,"caller":"-","text":"slutna ögatAnnan översättning: ”öppna ögat” (även i v 15).","reference":{"chapter":24,"verse":3}},{"noteId":91,"caller":"-","text":"aloeträdVäxer i Afrika, liksom Israel omplanterades från Egypten till Kanaans land.","reference":{"chapter":24,"verse":6}},{"noteId":92,"caller":"-","text":"Större än AgagAmaleks kung som senare besegrades av Israels kung Saul (1 Sam 15:8f).","reference":{"chapter":24,"verse":7}},{"noteId":93,"caller":"-","text":"En stjärna stiger framProfetia om Messias (jfr Matt 2:2f). Spiran stod för kungamakt (Ps 2:9, 45:7, 110:2).","reference":{"chapter":24,"verse":17}},{"noteId":94,"caller":"-","text":"keniternaÖkennomader med god kontakt med israeliterna (Dom 1:16, 4:11, 1 Sam 15:6).","reference":{"chapter":24,"verse":21}},{"noteId":95,"caller":"-","text":"skövlasAnnan översättning: ”brännas”.","reference":{"chapter":24,"verse":22}},{"noteId":96,"caller":"-","text":"kitteernas kustCypern eller andra medelhavsöar (1 Mos 10:4, Jes 23:1).","reference":{"chapter":24,"verse":24}}]},"thisChapterLink":"/api/swe_fol/NUM/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/NUM/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/NUM/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}