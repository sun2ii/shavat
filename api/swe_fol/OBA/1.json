{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"OBA","translationId":"swe_fol","name":"Obadja","commonName":"Obadja","title":"Obadja","order":31,"numberOfChapters":1,"sha256":"911eb57dcc52c441eee401485c531272a6c377457b6502ce3a70a291c054fb13","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/swe_fol/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"heading","content":["Domsord över Edom"]},{"type":"verse","number":1,"content":[{"text":"Obadjas profetia.","poem":1},{"noteId":0},{"lineBreak":true},{"text":"Så säger Herren Gud om Edom:","poem":1},{"text":"Vi har hört ett budskap","poem":2},{"text":"från Herren,","poem":3},{"text":"och en budbärare är utsänd","poem":2},{"text":"bland hednafolken:","poem":3},{"text":"”Upp, låt oss resa oss","poem":2},{"text":"och strida mot Edom!”","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Se, jag har gjort dig obetydlig","poem":1},{"text":"bland hednafolken,","poem":3},{"text":"djupt föraktad är du.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ditt hjärtas övermod","poem":1},{"text":"har bedragit dig","poem":3},{"text":"där du bor bland bergsklyftorna","poem":2},{"text":"i din höga boning","poem":3},{"text":"och säger i ditt hjärta:","poem":2},{"text":"”Vem kan störta mig","poem":3},{"text":"till jorden?”","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Om du än svävade högt som örnen","poem":1},{"text":"och byggde ditt bo","poem":2},{"text":"mitt bland stjärnorna,","poem":3},{"text":"så skulle jag ändå","poem":2},{"text":"störta ner dig därifrån,","poem":3},{"text":"säger Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Om tjuvar kommer till dig","poem":1},{"text":"eller plundrare om natten,","poem":2},{"text":"då är det ute med dig!","poem":3},{"text":"Ska de inte stjäla","poem":2},{"text":"tills de fått nog?","poem":3},{"text":"Om vinbärgare kommer till dig,","poem":2},{"text":"ska de då lämna en efterskörd?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Hur genomsökt ska inte Esau bli!","poem":1},{"text":"Hans dolda skatter ska letas fram.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alla som var i förbund med dig","poem":1},{"text":"ska driva dig till gränsen,","poem":3},{"text":"de som levde i fred med dig","poem":2},{"text":"ska bedra dig","poem":3},{"text":"och bli dig övermäktiga,","poem":4},{"text":"de som äter ditt bröd","poem":2},{"text":"ska lägga en snara under dig.","poem":3},{"text":"Det finns inget förstånd hos dem.","poem":2},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ska jag inte på den dagen,","poem":1},{"text":"säger Herren,","poem":3},{"text":"förgöra de visa i Edom","poem":2},{"text":"och allt förstånd på Esaus berg?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Dina hjältar, Teman,","poem":1},{"text":"ska slås av förfäran,","poem":3},{"text":"och var man på Esaus berg","poem":2},{"text":"ska bli utrotad och dräpt.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"För våld mot din broder Jakob","poem":1},{"text":"ska du täckas med skam","poem":2},{"text":"och utrotas till evig tid.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Den dag du stod på avstånd,","poem":1},{"text":"den dag då främlingar","poem":2},{"text":"förde bort hans rikedom","poem":3},{"text":"och utlänningar drog in","poem":2},{"text":"genom hans portar","poem":3},{"text":"och kastade lott om Jerusalem,","poem":4},{"text":"då var du också som en av dem.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Se inte med skadeglädje","poem":1},{"text":"på din broders dag,","poem":2},{"text":"på hans olyckas dag,","poem":3},{"text":"gläd dig inte över Juda barn","poem":2},{"text":"på deras undergångs dag,","poem":3},{"text":"öppna inte din mun så stort","poem":2},{"text":"på nödens dag.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Dra inte in genom mitt folks port","poem":1},{"text":"på deras ofärds dag,","poem":3},{"text":"se inte med skadeglädje","poem":2},{"text":"på hans olycka, du också,","poem":3},{"text":"på hans ofärds dag,","poem":4},{"text":"sträck inte din hand","poem":2},{"text":"efter hans rikedomar","poem":3},{"text":"på hans ofärds dag.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Stå inte vid vägskälet","poem":1},{"text":"för att hugga ner hans flyktingar","poem":3},{"text":"och utlämna inte hans överlevande","poem":2},{"text":"på nödens dag.","poem":3}]},{"type":"heading","content":["Herrens dag"]},{"type":"verse","number":15,"content":[{"text":"För Herrens dag är nära","poem":1},{"text":"för alla hednafolk.","poem":3},{"text":"Så som du har gjort","poem":2},{"text":"ska det göras mot dig,","poem":3},{"text":"dina gärningar","poem":2},{"text":"ska komma tillbaka","poem":3},{"text":"över ditt eget huvud.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Så som ni har druckit","poem":1},{"text":"på mitt heliga berg","poem":3},{"text":"ska alla hednafolk få dricka","poem":2},{"noteId":2},{"text":"utan uppehåll","poem":3},{"noteId":3},{"text":".","poem":3},{"text":"De ska dricka, de ska svälja,","poem":2},{"text":"de ska bli som om","poem":3},{"text":"de aldrig funnits.","poem":4}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Men på Sions berg","poem":1},{"text":"ska det finnas en räddad skara","poem":3},{"noteId":4},{"text":".","poem":3},{"text":"Det ska vara en helig plats,","poem":2},{"text":"och Jakobs hus ska åter","poem":3},{"text":"få råda över sina besittningar.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"Då ska Jakobs hus bli en eld","poem":1},{"text":"och Josefs hus en låga,","poem":3},{"text":"och Esaus hus ska vara som strå,","poem":2},{"text":"och de ska tända eld på dem","poem":3},{"text":"och förtära dem.","poem":4},{"text":"Ingen av Esaus hus","poem":2},{"text":"ska komma undan,","poem":3},{"text":"för Herren har talat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":["Då ska de som bor i Negev ta Esaus berg i besittning. De som bor i Låglandet ska ta filisteernas land. Man ska ta Efraims land och Samariens mark i besittning, och Benjamin ska ta Gilead.",{"noteId":5}]},{"type":"verse","number":20,"content":["Och de som förts bort av denna Israels här, de som bor i Kanaan ända till Sarefat,",{"noteId":6},"liksom de som förts bort från Jerusalem, de som bor i Sefarad",{"noteId":7},", dessa ska ta Negevs städer i besittning."]},{"type":"verse","number":21,"content":["Frälsare",{"noteId":8},"ska dra upp på Sions berg för att döma Esaus berg. Och riket ska tillhöra Herren."]}],"footnotes":[{"noteId":0,"caller":"-","text":"profetiaOrdagrant: ”syn”, det som profeten har sett och fått uppenbarat.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"-","text":"inget förstånd hos demAnnan översättning: ”ingen som märker den”.","reference":{"chapter":1,"verse":7}},{"noteId":2,"caller":"-","text":"drickaHerrens dom framställs som en bägare att dricka (jfr Jer 25:15f, Upp 16:19).","reference":{"chapter":1,"verse":16}},{"noteId":3,"caller":"-","text":"utan uppehållAndra handskrifter: ”omkring”.","reference":{"chapter":1,"verse":16}},{"noteId":4,"caller":"-","text":"en räddad skaraAnnan översättning: ”en räddning”.","reference":{"chapter":1,"verse":17}},{"noteId":5,"caller":"-","text":"","reference":{"chapter":1,"verse":19}},{"noteId":6,"caller":"-","text":"SarefatKuststad drygt 2 mil norr om Tyrus i nuvarande Libanon.","reference":{"chapter":1,"verse":20}},{"noteId":7,"caller":"-","text":"SefaradTroligen mediska Saparda i västra nuvarande Iran, eller möjligen Sardes i västra nuvarande Turkiet.","reference":{"chapter":1,"verse":20}},{"noteId":8,"caller":"-","text":"FrälsareAndra handskrifter (Septuaginta): ”De frälsta”.","reference":{"chapter":1,"verse":21}}]},"thisChapterLink":"/api/swe_fol/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}