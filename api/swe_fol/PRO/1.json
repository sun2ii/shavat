{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["Inledning"]},{"type":"verse","number":1,"content":["Ordspråk",{"noteId":0},"av Salomo, Davids son, Israels kung."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Med dem lär man känna","poem":1},{"text":"vishet och förmaning","poem":3},{"text":"och förstår kloka ord,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"man får förmaning","poem":1},{"text":"till att handla vist,","poem":3},{"text":"rättfärdigt, rättvist och rätt.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"De ger de okunniga","poem":1},{"noteId":1},{"text":"klokhet,","poem":1},{"text":"de unga kunskap och omdöme.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Den vise hör dem","poem":1},{"text":"och ökar sin lärdom,","poem":3},{"text":"den förståndige får klok ledning.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Med dem förstår man","poem":1},{"text":"ordspråk och liknelser,","poem":2},{"text":"de visas ord och deras gåtor.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Att vörda Herren","poem":1},{"text":"är början till kunskap,","poem":3},{"text":"men dårar","poem":2},{"noteId":2},{"text":"föraktar","poem":2},{"text":"vishet och förmaning.","poem":3}]},{"type":"heading","content":["Varning för att ledas vilse"]},{"type":"verse","number":8,"content":[{"text":"Hör, min son,","poem":1},{"text":"din fars förmaning","poem":3},{"text":"och förkasta inte","poem":2},{"text":"din mors undervisning,","poem":3}]},{"type":"verse","number":9,"content":[{"text":"för de är en skön krans","poem":1},{"text":"för ditt huvud","poem":3},{"text":"och en vacker kedja","poem":2},{"text":"för din hals.","poem":3},{"noteId":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Min son, om syndare lockar dig,","poem":1},{"text":"så följ dem inte.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Om de säger:","poem":1},{"text":"”Kom med oss!","poem":3},{"text":"Vi ska ligga på lur efter blod,","poem":2},{"text":"i bakhåll för oskyldiga","poem":3},{"text":"utan orsak.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"Som dödsriket","poem":1},{"text":"ska vi sluka dem levande,","poem":3},{"text":"friska och sunda","poem":2},{"text":"ska de fara ner i graven.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Allt dyrbart ska vi vinna,","poem":1},{"text":"vi ska fylla våra hus med byte.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Dela du vår lott med oss!","poem":1},{"text":"Vi alla ska ha gemensam kassa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Min son,","poem":1},{"text":"gå inte samma väg som de,","poem":3},{"text":"håll din fot borta från deras stig,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"för deras fötter","poem":1},{"text":"skyndar till det som är ont,","poem":3},{"text":"de rusar för att spilla blod.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Det är ingen mening","poem":1},{"text":"att lägga ut nätet","poem":3},{"text":"inför ögonen på alla fåglarna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"De ligger på lur efter sitt eget blod,","poem":1},{"text":"de gillrar fällor för sina egna liv","poem":2},{"noteId":4},{"text":".","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Så går det dem som söker","poem":1},{"text":"oärlig vinst,","poem":3},{"text":"den tar livet av sina ägare.","poem":2}]},{"type":"heading","content":["Visheten kallar och varnar"]},{"type":"verse","number":20,"content":[{"text":"Visheten ropar på gatan,","poem":1},{"text":"hon höjer sin röst på torgen.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hon predikar i gathörnens buller","poem":1},{"noteId":5},{"text":",","poem":1},{"text":"vid ingången till stadens portar","poem":2},{"noteId":6},{"text":"talar hon sina ord:","poem":3}]},{"type":"verse","number":22,"content":[{"text":"”Hur länge ska ni okunniga","poem":1},{"text":"älska okunnighet,","poem":3},{"text":"ni hånare njuta av att håna","poem":2},{"text":"och ni dårar hata kunskap?","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Vänd om till mig när jag varnar er.","poem":1},{"text":"Se, jag ska låta min Ande","poem":2},{"text":"flöda över er,","poem":3},{"text":"jag ska låta er lära känna mina ord.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Men ni vägrade lyssna","poem":1},{"text":"när jag ropade,","poem":3},{"text":"ingen brydde sig","poem":2},{"text":"när jag räckte ut min hand.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Ni förkastade alla mina råd","poem":1},{"text":"och ville inte veta av","poem":2},{"text":"mina varningar.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Därför ska också jag le åt er olycka","poem":1},{"text":"och håna när skräcken drabbar er,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"när skräcken kommer som ett oväder","poem":1},{"text":"och er olycka drar in","poem":2},{"text":"som en storm,","poem":3},{"text":"när nöd och ångest drabbar er.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Då ska de ropa till mig","poem":1},{"text":"utan att jag svarar,","poem":3},{"text":"de ska söka mig","poem":2},{"text":"utan att finna mig.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"De hatade kunskap","poem":1},{"text":"och valde inte att vörda Herren,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"de ville inte veta av mitt råd","poem":1},{"text":"utan föraktade alla mina varningar.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Därför ska de få äta","poem":1},{"text":"sina gärningars frukt","poem":3},{"text":"och mättas av sina onda planer,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"för de okunnigas avfällighet","poem":1},{"text":"ska döda dem","poem":3},{"text":"och dårarnas sorglöshet","poem":2},{"text":"förgöra dem.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Men den som lyssnar till mig","poem":1},{"text":"ska bo i trygghet","poem":3},{"text":"och inte behöva frukta något ont.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"-","text":"OrdspråkHebreiska mashálbetyder ”liknelse” eller visdomsord i vidare bemärkelse.","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"-","text":"okunnigaDet hebreiska ordet syftar på att vara naiv, oerfaren och lättpåverkad av ondskan.","reference":{"chapter":1,"verse":4}},{"noteId":2,"caller":"-","text":"dårarDet hebreiska ordet betecknar brister i vett och värderingar snarare än begåvning.","reference":{"chapter":1,"verse":7}},{"noteId":3,"caller":"-","text":"kedja för din halsOfficiellt ämbetstecken (jfr 1 Mos 41:42, Dan 5:29).","reference":{"chapter":1,"verse":9}},{"noteId":4,"caller":"-","text":"livAnnan översättning: ”själar” (även i 6:32, 7:23, 13:3, etc).","reference":{"chapter":1,"verse":18}},{"noteId":5,"caller":"-","text":"i gathörnens bullerAndra handskrifter (Septuaginta): ”från toppen av murarna”.","reference":{"chapter":1,"verse":21}},{"noteId":6,"caller":"-","text":"stadens portarDär alla passerade och där samhällets frågor beslutades (31:23, Rut 4).","reference":{"chapter":1,"verse":21}}]},"thisChapterLink":"/api/swe_fol/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}