},{"text":"deras fördärv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Den rättfärdiges arbete","poem":1},{"text":"leder till liv,","poem":3},{"text":"den gudlöses vinst","poem":2},{"text":"leder till synd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Att ta vara på förmaning","poem":1},{"text":"är vägen till livet,","poem":3},{"text":"den som föraktar tillrättavisning","poem":2},{"text":"leder andra vilse.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Den som döljer hat","poem":1},{"text":"har falska läppar,","poem":3},{"text":"den som sprider förtal är en dåre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Där orden är många","poem":1},{"text":"uteblir inte synd,","poem":3},{"text":"klok är den","poem":2},{"text":"som styr sina läppar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Den rättfärdiges tunga","poem":1},{"text":"är utvalt silver,","poem":3},{"text":"de gudlösas hjärtan","poem":2},{"text":"har ringa värde.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Den rättfärdiges läppar","poem":1},{"text":"ger näring","poem":3},{"noteId":43},{"text":"åt många,","poem":3},{"text":"dårar dör av brist på förstånd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Herrens välsignelse ger rikedom,","poem":1},{"text":"egen möda tillför inget","poem":2},{"noteId":44},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Dårens glädje","poem":1},{"text":"är att göra det skamliga,","poem":3},{"text":"den förståndiges glädje","poem":2},{"text":"är visheten.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Den gudlöse drabbas","poem":1},{"text":"av det han fruktar,","poem":3},{"text":"de rättfärdiga får vad de önskar.","poem":2}]},{"type":"line_break"}