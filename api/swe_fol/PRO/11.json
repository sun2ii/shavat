{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Herren avskyr falsk våg",{"noteId":46},",",{"text":"full vikt behagar honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"När högfärd kommer följer förakt,","poem":1},{"text":"men vishet finns hos de ödmjuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"De ärligas hederlighet leder dem,","poem":1},{"text":"de trolösas falskhet","poem":2},{"text":"blir deras fördärv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rikedom hjälper inte","poem":1},{"text":"på vredens dag,","poem":3},{"text":"men rättfärdighet räddar","poem":2},{"text":"från döden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Den hederliges rättfärdighet","poem":1},{"text":"jämnar hans väg,","poem":3},{"text":"den gudlöse faller","poem":2},{"text":"genom sin gudlöshet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"De ärligas rättfärdighet räddar dem,","poem":1},{"text":"de trolösa fångas av sina begär.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"När en gudlös dör","poem":1},{"text":"försvinner hans hopp,","poem":3},{"text":"vad de onda","poem":2},{"noteId":47},{"text":"väntar på går förlorat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Den rättfärdige räddas ur nöden,","poem":1},{"text":"den gudlöse drabbas i hans ställe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Med sin mun fördärvar","poem":1},{"text":"den gudlöse sin nästa,","poem":3},{"text":"genom kunskap räddas","poem":2},{"text":"de rättfärdiga.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"De rättfärdigas framgång","poem":1},{"text":"ger glädje i staden,","poem":3},{"text":"när de gudlösa förgås","poem":2},{"text":"blir det jubel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Genom de ärligas välsignelse","poem":1},{"text":"upphöjs en stad,","poem":3},{"text":"genom de gudlösas mun","poem":2},{"text":"rivs den ner.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Den som föraktar sin nästa","poem":1},{"text":"är utan vett,","poem":3},{"text":"den som har förstånd tiger.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Skvallraren förråder hemligheter,","poem":1},{"text":"ett trofast hjärta","poem":2},{"text":"döljer vad det vet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Utan ledning faller ett folk,","poem":1},{"text":"när många ger råd går det väl.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Den som går i borgen","poem":1},{"text":"för en främling råkar illa ut,","poem":3},{"text":"den som avskyr handslag är trygg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"En älsklig kvinna vinner ära,","poem":1},{"text":"våldsverkare","poem":2},{"noteId":48},{"text":"vinner rikedom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Den barmhärtige gör väl","poem":1},{"text":"mot sin själ,","poem":3},{"text":"den grymme skadar sitt eget kött.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Den gudlöse gör en bedräglig vinst,","poem":1},{"text":"den som sår rättfärdighet","poem":2},{"text":"får en säker lön.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Den som står fast i rättfärdighet","poem":1},{"text":"vinner liv,","poem":3},{"text":"den som jagar efter ont","poem":2},{"text":"går mot sin död.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Herren avskyr förvridna hjärtan,","poem":1},{"text":"de som lever hederligt","poem":2},{"text":"behagar honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"De onda blir förvisso","poem":1},{"text":"inte ostraffade,","poem":3},{"text":"men de rättfärdigas","poem":2},{"text":"efterkommande går fria.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Som en guldring","poem":1},{"text":"i grisens tryne","poem":3},{"text":"är skönhet hos en kvinna","poem":2},{"text":"utan vett","poem":3},{"noteId":49},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Vad de rättfärdiga önskar","poem":1},{"text":"är enbart det goda,","poem":3},{"text":"vad de gudlösa kan hoppas på","poem":2},{"text":"är vrede.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Den ene strör ut och får ändå mer,","poem":1},{"text":"den andre snålar","poem":2},{"noteId":50},{"text":"och blir bara fattigare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"En generös","poem":1},{"noteId":51},{"text":"själ blir rikt mättad,","poem":1},{"text":"den som vederkvicker andra","poem":2},{"text":"blir själv vederkvickt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Den som undanhåller sin säd","poem":1},{"text":"förbannas av folket,","poem":3},{"text":"välsignelse kommer","poem":2},{"text":"över den som vill sälja.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Den som söker det goda","poem":1},{"text":"strävar efter nåd,","poem":3},{"text":"den som jagar efter det onda","poem":2},{"text":"drabbas av det själv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Den som litar till sin rikedom","poem":1},{"text":"kommer på fall,","poem":3},{"text":"men de rättfärdiga","poem":2},{"text":"ska grönska som löven.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Den som drar olycka över sitt hus","poem":1},{"text":"får ärva vind,","poem":3},{"text":"dåren blir slav","poem":2},{"text":"åt den som har ett vist hjärta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Den rättfärdiges frukt","poem":1},{"text":"är ett livets träd,","poem":3},{"text":"den som vinner själar är vis.","poem":2},{"noteId":52}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Om den rättfärdige","poem":1},{"text":"får sin lön på jorden,","poem":3},{"noteId":53},{"text":"hur mycket mer då","poem":2},{"text":"den gudlöse och syndaren!","poem":3}]}],"footnotes":[{"noteId":46,"caller":"-","text":"falsk vågOärliga köpmän ökade vinsten genom fusk med måtten (3 Mos 19:36, Amos 8:5).","reference":{"chapter":11,"verse":1}},{"noteId":47,"caller":"-","text":"de ondaAnnan översättning: ”kraften”.","reference":{"chapter":11,"verse":7}},{"noteId":48,"caller":"-","text":"våldsverkareAndra handskrifter (Septuaginta): ”flitiga”. Septuaginta har två ordspråk i versen: ”En älsklig kvinna vinner ära, en hustru som hatar det rätta är en skamlig sits. De lata blir egendomslösa, de flitiga vinner rikedom.”","reference":{"chapter":11,"verse":16}},{"noteId":49,"caller":"-","text":"vettAnnan översättning: ”smak”.","reference":{"chapter":11,"verse":22}},{"noteId":50,"caller":"-","text":"snålarOrdagrant: ”sparar mer än vad som är rätt”.","reference":{"chapter":11,"verse":24}},{"noteId":51,"caller":"-","text":"generösOrdagrant: ”välsignande”.","reference":{"chapter":11,"verse":25}},{"noteId":52,"caller":"-","text":"den som vinner själar är visAndra handskrifter (Septuaginta): ”våld tar liv”.","reference":{"chapter":11,"verse":30}},{"noteId":53,"caller":"-","text":"får sin lön på jordenSeptuaginta: ”knappt blir frälst”. Citeras så av Petrus i 1 Petr 4:18.","reference":{"chapter":11,"verse":31}}]},"thisChapterLink":"/api/swe_fol/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}