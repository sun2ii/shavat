{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Den som älskar fostran",{"text":"älskar kunskap,","poem":3},{"text":"den som hatar tillrättavisning","poem":2},{"text":"är dum.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Den som är god","poem":1},{"text":"får nåd från Herren,","poem":3},{"text":"den som gör onda planer","poem":2},{"text":"blir fördömd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ingen människa kan bestå","poem":1},{"text":"genom ondska,","poem":3},{"text":"men de rättfärdigas rot","poem":2},{"text":"kan inte rubbas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"En driftig hustru är sin mans krona,","poem":1},{"text":"en skamlös är som röta i hans ben.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"De rättfärdigas tankar är rätta,","poem":1},{"text":"de gudlösas råd bedrar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"De gudlösas ord lurar efter blod,","poem":1},{"text":"de ärligas tal räddar dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"De gudlösa störtas","poem":1},{"text":"och finns inte mer,","poem":3},{"text":"men de rättfärdigas hus består.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Efter sitt förstånd blir man prisad,","poem":1},{"text":"men ett förvridet hjärta","poem":2},{"text":"blir föraktat.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bättre vara ringa och ha en tjänare","poem":1},{"noteId":54},{"text":"än spela förnäm och sakna bröd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Den rättfärdige vet","poem":1},{"text":"hur hans boskap känner det,","poem":3},{"text":"men de gudlösas omsorg är grym.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Den som brukar sin åker","poem":1},{"text":"får bröd så det räcker,","poem":3},{"text":"den som jagar tomhet","poem":2},{"text":"saknar vett.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Den gudlöse har begär","poem":1},{"text":"till de ondas fångst","poem":3},{"noteId":55},{"text":",","poem":3},{"text":"men de rättfärdigas rot ger frukt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Den onde snärjs i sina läppars synd,","poem":1},{"text":"men den rättfärdige slipper ut","poem":2},{"text":"ur nöden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Av munnens frukt","poem":1},{"text":"blir man mättad med gott,","poem":3},{"text":"vad människans händer har gjort","poem":2},{"text":"får hon tillbaka.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dåren tycker själv hans väg är rätt,","poem":1},{"text":"vis är den som lyssnar till råd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Dåren visar genast sin vrede,","poem":1},{"text":"klok är den som döljer en skymf.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Den ärlige talar sanning,","poem":1},{"text":"ett falskt vittne bedrar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tanklösa ord kan hugga som svärd,","poem":1},{"text":"men de visas tunga ger läkedom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sanna ord består för evigt,","poem":1},{"text":"en lögnaktig tunga","poem":2},{"text":"bara ett ögonblick.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"De som smider onda planer","poem":1},{"text":"har svek i hjärtat,","poem":3},{"text":"de som främjar frid får glädje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Inget ont drabbar den rättfärdige,","poem":1},{"text":"men de gudlösa får olycka","poem":2},{"text":"i fullt mått.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Herren avskyr falska läppar,","poem":1},{"text":"de som handlar i sanning","poem":2},{"text":"behagar honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"En klok man döljer sin kunskap,","poem":1},{"text":"dårars hjärtan ropar ut","poem":2},{"text":"sitt oförnuft.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Flitig hand får härska,","poem":1},{"text":"den late tvingas till trältjänst.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bekymmer tynger en mans hjärta,","poem":1},{"text":"ett vänligt ord ger det glädje.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Den rättfärdige väljer sitt sällskap,","poem":1},{"text":"de gudlösas väg leder andra vilse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Den late får inte tag i","poem":1},{"noteId":56},{"text":"sitt villebråd,","poem":1},{"text":"flit är för människan","poem":2},{"text":"en dyrbar skatt.","poem":3},{"noteId":57}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"På rättfärdighetens väg är liv,","poem":1},{"text":"på den vägen finns ingen död.","poem":2}]}],"footnotes":[{"noteId":54,"caller":"-","text":"ha en tjänareAnnan översättning (Septuaginta): ”arbeta för sig själv”.","reference":{"chapter":12,"verse":9}},{"noteId":55,"caller":"-","text":"fångstAnnan översättning: ”borg”.","reference":{"chapter":12,"verse":12}},{"noteId":56,"caller":"-","text":"tag iAndra handskrifter: ”steka”.","reference":{"chapter":12,"verse":27}},{"noteId":57,"caller":"-","text":"flit är för människan en dyrbar skattAnnan översättning: ”den flitige får en dyrbar skatt”.","reference":{"chapter":12,"verse":27}}]},"thisChapterLink":"/api/swe_fol/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}