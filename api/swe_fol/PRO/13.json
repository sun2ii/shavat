{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["En vis son hör",{"text":"sin fars förmaning,","poem":3},{"text":"en hånare lyder ingen tillsägelse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Av munnens frukt får man njuta gott,","poem":1},{"text":"men de trolösa hungrar efter våld.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Den som vaktar sin tunga","poem":1},{"text":"bevarar sitt liv,","poem":3},{"text":"den pratsamme råkar i olycka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Den late är full av begär","poem":1},{"text":"men får inget,","poem":3},{"text":"de flitigas hunger blir rikt mättad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Den rättfärdige avskyr lögnaktigt tal,","poem":1},{"text":"den gudlöse beter sig","poem":2},{"text":"avskyvärt och skamligt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Rättfärdighet bevarar den hederlige,","poem":1},{"text":"ondska fäller syndaren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den ene vill verka rik","poem":1},{"text":"men har ingenting,","poem":3},{"text":"den andre vill verka fattig","poem":2},{"text":"men äger mycket.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Den rike måste ge sin rikedom","poem":1},{"text":"som lösen för sitt liv,","poem":3},{"text":"men den fattige","poem":2},{"text":"hör inte av något hot.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"De rättfärdigas ljus lyser klart,","poem":1},{"text":"men de gudlösas lampa slocknar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Övermod skapar bara gräl,","poem":1},{"noteId":58},{"text":"vishet finns hos dem","poem":2},{"text":"som tar emot råd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lätt fånget är lätt förgånget,","poem":1},{"text":"men den som samlar","poem":2},{"text":"efter hand får mycket.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Utdragen väntan tär på hjärtat,","poem":1},{"text":"uppfylld önskan är ett livets träd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Den som föraktar ordet","poem":1},{"text":"fördärvar sig själv,","poem":3},{"noteId":59},{"text":"den som respekterar budet","poem":2},{"text":"blir belönad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Den vises undervisning","poem":1},{"text":"är en källa till liv,","poem":3},{"text":"en hjälp att undgå dödens snaror.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gott förstånd för med sig välvilja,","poem":1},{"text":"de trolösas väg är alltid sig lik.","poem":2},{"noteId":60}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Den kloke handlar med förstånd,","poem":1},{"text":"dåren blottar sin dumhet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"En gudlös budbärare","poem":1},{"text":"faller i olycka,","poem":3},{"text":"ett pålitligt sändebud ger läkedom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Fattigdom och skam","poem":1},{"text":"får den som föraktar förmaning,","poem":3},{"text":"men den som tar vara","poem":2},{"text":"på tillrättavisning blir ärad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Uppfylld önskan är ljuv för själen,","poem":1},{"text":"men dårar avskyr","poem":2},{"text":"att överge sin ondska.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Den som vandrar med de visa","poem":1},{"text":"blir vis,","poem":3},{"text":"den som umgås med dårar","poem":2},{"text":"går det illa.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Syndare förföljs av olycka,","poem":1},{"text":"de rättfärdigas lön blir lycka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Den gode lämnar arv","poem":1},{"text":"åt barnbarnen,","poem":3},{"text":"men syndarens egendom","poem":2},{"text":"förvaras åt den rättfärdige.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"De fattigas nyodling ger riklig föda,","poem":1},{"text":"men den sopas bort när orätt råder.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Den som spar på riset","poem":1},{"text":"hatar sin son,","poem":3},{"text":"den som älskar honom","poem":2},{"text":"fostrar honom i tid.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Den rättfärdige äter och blir mätt,","poem":1},{"text":"de gudlösa får gå med tom mage.","poem":2}]}],"footnotes":[{"noteId":58,"caller":"-","text":"Övermod skapar bara grälAndra handskrifter (Septuaginta): ”Den tommes övermod skapar gräl”.","reference":{"chapter":13,"verse":10}},{"noteId":59,"caller":"-","text":"fördärvar sig självAnnan översättning: ”får betala för det”.","reference":{"chapter":13,"verse":13}},{"noteId":60,"caller":"-","text":"är alltid sig likAndra handskrifter (Septuaginta): ”är deras undergång”.","reference":{"chapter":13,"verse":15}}]},"thisChapterLink":"/api/swe_fol/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}