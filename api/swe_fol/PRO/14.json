"content":[{"text":"Hånaren söker vishet","poem":1},{"text":"men finner ingen,","poem":3},{"text":"men för den kloke","poem":2},{"text":"kommer kunskapen lätt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Håll dig borta från dåren,","poem":1},{"text":"du finner aldrig förstånd","poem":2},{"text":"på hans läppar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Den klokes vishet","poem":1},{"text":"gör att han förstår sin väg,","poem":3},{"text":"men dårars oförnuft bedrar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dårarna hånar skuldoffret","poem":1},{"noteId":62},{"text":",","poem":1},{"text":"men bland de ärliga finns nåd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hjärtat känner sin egen sorg,","poem":1},{"text":"en främling kan inte","poem":2},{"text":"dela dess glädje.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"De gudlösas hus raseras,","poem":1},{"text":"de ärligas boning blomstrar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"En väg kan verka rätt","poem":1},{"text":"för en människa,","poem":3},{"text":"men till slut leda till döden.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Även under skratt","poem":1},{"text":"kan hjärtat värka,","poem":3},{"text":"och glädje kan sluta i sorg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Den avfällige mättas","poem":1},{"text":"av sina egna vägar,","poem":3},{"text":"och en god man håller sig borta","poem":2},{"text":"från honom.","poem":3},{"noteId":63}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Den okunnige tror varje ord,","poem":1},{"text":"den kloke ger akt på sina steg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Den vise fruktar och skyr det onda,","poem":1},{"text":"dåren är övermodig och sorglös.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"En otålig man begår dumheter,","poem":1},{"text":"en som gör onda planer","poem":2},{"text":"blir hatad.","poem":3},{"noteId":64}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"De okunniga ärver dårskap,","poem":1},{"text":"de kloka blir krönta med kunskap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Onda måste buga sig för goda,","poem":1},{"text":"gudlösa vid den rättfärdiges portar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Den fattige blir avskydd","poem":1},{"text":"även av sina närmaste,","poem":3},{"text":"men den rike har många vänner.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Den som föraktar sin nästa syndar,","poem":1},{"text":"lycklig är den som förbarmar sig","poem":2},{"text":"över de betryckta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"De som tänker ut ont far vilse,","poem":1},{"text":"de som tänker ut gott","poem":2},{"text":"får nåd och sanning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Av all möda kommer någon vinst,","poem":1},{"text":"tomt prat leder till fattigdom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"De visas krona är deras rikedom,","poem":1},{"text":"dårarnas dumhet är dumhet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ett sant vittne räddar liv,","poem":1},{"text":"den som främjar lögn bedrar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Den som vördar Herren","poem":1},{"text":"har ett tryggt fäste,","poem":3},{"text":"hans barn får där en tillflykt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Vördnad för Herren","poem":1},{"text":"är en källa till liv,","poem":3},{"text":"en hjälp att undgå dödens snaror.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Talrik skara är kungens ära,","poem":1},{"text":"brist på folk blir furstens fördärv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Den som är tålmodig","poem":1},{"text":"har gott förstånd,","poem":3},{"text":"den som är otålig går långt","poem":2},{"text":"i dårskap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Sinnesro ger kroppen liv,","poem":1},{"text":"avund är röta i benen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Den som förtrycker den fattige","poem":1},{"text":"smädar hans Skapare,","poem":3},{"text":"den som förbarmar sig","poem":2},{"text":"över de behövande ärar honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Den gudlöse kommer på fall","poem":1},{"text":"genom sin ondska,","poem":3},{"text":"den rättfärdige har en tillflykt","poem":2},{"text":"vid sin död","poem":3},{"noteId":65},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"I den klokes hjärta bor visheten,","poem":1},{"text":"bland dårarna blir den uppenbar","poem":2},{"noteId":66},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Rättfärdighet upphöjer ett folk,","poem":1},{"text":"men synd är folkens vanära.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"En förståndig tjänare","poem":1},{"text":"vinner kungens välvilja,","poem":3},{"text":"den som handlar skamligt","poem":2},{"text":"drabbas av hans vrede.","poem":3}]}],"footnotes":[{"noteId":61,"caller":"-","text":"Visa kvinnorAnnan översättning: ”Kvinnors vishet”. Jfr kap 9.","reference":{"chapter":14,"verse":1}},{"noteId":62,"caller":"-","text":"skuldoffretSkulle rena från skuld och återupprätta gemenskap. Se 3 Mos 6, Jes 53:10.","reference":{"chapter":14,"verse":9}},{"noteId":63,"caller":"-","text":"håller sig borta från honomAnnan översättning: ”av sina”.","reference":{"chapter":14,"verse":14}},{"noteId":64,"caller":"-","text":"en som gör onda planer blir hatadAndra handskrifter (Septuaginta): ”en klok man står ut”.","reference":{"chapter":14,"verse":17}},{"noteId":65,"caller":"-","text":"vid sin dödAndra handskrifter (Septuaginta): ”i sin hederlighet”.","reference":{"chapter":14,"verse":32}},{"noteId":66,"caller":"-","text":"uppenbarAndra handskrifter (Septuaginta): ”inte uppenbar”.","reference":{"chapter":14,"verse":33}}]},"thisChapterLink":"/api/swe_fol/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}