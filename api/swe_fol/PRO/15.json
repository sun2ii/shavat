{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Ett mjukt svar stillar vrede,",{"text":"sårande ord väcker harm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"De visas tunga ger god kunskap,","poem":1},{"text":"dårars mun flödar av oförnuft.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Herrens ögon är överallt,","poem":1},{"text":"de vakar över både onda och goda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"En läkande tunga är ett livets träd,","poem":1},{"text":"en falsk tunga ger hjärtesår.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dåren föraktar sin fars fostran,","poem":1},{"text":"klok är den som tar vara","poem":2},{"text":"på tillrättavisning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Den rättfärdiges hus","poem":1},{"text":"rymmer stor rikedom,","poem":3},{"text":"men den gudlöses vinst","poem":2},{"text":"för med sig bekymmer.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"De visas läppar sprider kunskap,","poem":1},{"text":"men så gör inte dårarnas hjärtan","poem":2},{"noteId":67},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"De gudlösas offer","poem":1},{"text":"är avskyvärda för Herren,","poem":3},{"text":"de ärligas bön behagar honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Herren avskyr den gudlöses väg,","poem":1},{"text":"men han älskar den som strävar","poem":2},{"text":"efter rättfärdighet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Fostran är något ont","poem":1},{"noteId":68},{"text":"för den som överger vägen,","poem":3},{"text":"men den som hatar tillrättavisning","poem":2},{"text":"måste dö.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dödsriket och avgrunden","poem":1},{"noteId":69},{"text":"ligger öppna för Herren,","poem":3},{"text":"hur mycket mer då","poem":2},{"text":"människors hjärtan!","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hånaren ogillar tillrättavisning,","poem":1},{"text":"till de visa vill han inte gå.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ett glatt hjärta gör ansiktet ljust,","poem":1},{"text":"hjärtesorg ger modlöshet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Den förståndiges hjärta","poem":1},{"text":"söker kunskap,","poem":3},{"text":"dårars mun närs av dårskap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Den betryckte","poem":1},{"text":"har aldrig en glad dag,","poem":3},{"text":"men ett glatt hjärta","poem":2},{"text":"har ständig fest.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bättre ha lite","poem":1},{"text":"med vördnad för Herren","poem":3},{"text":"än stora skatter med oro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bättre ett fat kål med kärlek","poem":1},{"text":"än en gödd oxe med hat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"En hetlevrad man skapar gräl,","poem":1},{"text":"den tålmodige stillar tvisten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Den lates stig är spärrad av törne,","poem":1},{"text":"de ärliga har en banad väg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"En vis son gläder sin far,","poem":1},{"text":"en dåre föraktar sin mor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Den vettlöse har sin glädje","poem":1},{"text":"i dårskap,","poem":3},{"text":"den förståndige går sin väg","poem":2},{"text":"rakt fram.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Där samråd saknas slår planerna fel,","poem":1},{"text":"med många rådgivare lyckas de.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Man blir glad när man kan ge svar,","poem":1},{"text":"hur gott är inte ett ord i rätt tid!","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Den förståndige vandrar","poem":1},{"text":"livets väg uppåt","poem":3},{"text":"för att undvika dödsriket","poem":2},{"text":"där nere.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Herren river den högmodiges hus","poem":1},{"text":"men låter änkans gränssten stå fast.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"För Herren","poem":1},{"text":"är ondskans planer avskyvärda,","poem":3},{"text":"men milda ord är rena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Den som söker oärlig vinst","poem":1},{"text":"drar olycka över sin familj,","poem":3},{"text":"men den som hatar mutor får leva.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Den rättfärdiges hjärta","poem":1},{"text":"svarar med eftertanke,","poem":3},{"text":"de gudlösas mun flödar","poem":2},{"text":"av ondska.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Herren är fjärran från de gudlösa,","poem":1},{"text":"men han hör de rättfärdigas bön.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"En mild blick gör hjärtat glatt,","poem":1},{"text":"ett gott budskap ger märg åt benen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Den som lyssnar till","poem":1},{"text":"livets tillrättavisning","poem":3},{"text":"får bo bland de visa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Den som avvisar fostran","poem":1},{"text":"föraktar sitt liv,","poem":3},{"text":"den som lyssnar på tillrättavisning","poem":2},{"text":"får förstånd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Vördnad för Herren","poem":1},{"text":"fostrar till vishet,","poem":3},{"text":"ödmjukhet går före ära.","poem":2}]}],"footnotes":[{"noteId":67,"caller":"-","text":"så gör inte dårarnas hjärtanAnnan översättning: ”dårarnas hjärtan är inte rätta”.","reference":{"chapter":15,"verse":7}},{"noteId":68,"caller":"-","text":"Fostran är något ontAnnan översättning: ”Sträng fostran”.","reference":{"chapter":15,"verse":10}},{"noteId":69,"caller":"-","text":"avgrundenHebr. Abaddón(jfr Upp 9:11). Annan översättning: ”fördärvet” (även i 27:20).","reference":{"chapter":15,"verse":11}}]},"thisChapterLink":"/api/swe_fol/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/14.json","previousChapterAudioLinks":{},"number