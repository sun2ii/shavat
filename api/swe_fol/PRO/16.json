{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Människan gör planer",{"text":"i sitt hjärta,","poem":3},{"text":"men från Herren kommer","poem":2},{"text":"vad tungan svarar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"En mans alla vägar","poem":1},{"text":"är rena i hans egna ögon,","poem":3},{"text":"men Herren är den","poem":2},{"text":"som prövar andarna.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Anförtro dina verk åt Herren,","poem":1},{"text":"så har dina planer framgång.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Herren har gjort var sak","poem":1},{"text":"för sitt syfte,","poem":3},{"text":"även den gudlöse för olyckans dag.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Herren avskyr de högmodiga,","poem":1},{"text":"de blir verkligen inte ostraffade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Genom nåd och sanning sonas skuld,","poem":1},{"text":"genom vördnad för Herren","poem":2},{"text":"undviks det onda.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"När någons vägar behagar Herren","poem":1},{"text":"gör han även hans fiender","poem":2},{"noteId":70},{"text":"till vänner.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bättre äga lite med rättfärdighet","poem":1},{"text":"än tjäna mycket med orätt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Människans hjärta tänker ut sin väg,","poem":1},{"text":"men Herren styr hennes steg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gudomligt beslut","poem":1},{"text":"är på kungens läppar,","poem":3},{"text":"hans mun tar inte miste i domen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rätt våg och vikt är från Herren,","poem":1},{"text":"alla vikter i pungen är hans verk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kungar avskyr onda gärningar,","poem":1},{"text":"för tronen befästs","poem":2},{"text":"genom rättfärdighet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Rättfärdiga läppar behagar kungar,","poem":1},{"text":"den som talar sanning blir älskad.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kungens vrede förebådar död,","poem":1},{"text":"men en vis man kan stilla den.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"När kungens uppsyn är ljus","poem":1},{"text":"betyder det liv,","poem":3},{"text":"hans välvilja är","poem":2},{"text":"som ett moln med vårregn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Att vinna vishet","poem":1},{"text":"är bättre än guld,","poem":3},{"text":"att vinna insikt","poem":2},{"text":"är mer värt än silver.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"De ärligas väg","poem":1},{"text":"är att undvika det onda,","poem":3},{"text":"den som ger akt på sin väg","poem":2},{"text":"bevarar sitt liv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Stolthet går före undergång","poem":1},{"text":"och högmod går före fall.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bättre vara ödmjuk bland de ringa","poem":1},{"text":"än dela byte med de stolta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Den som ger akt på ordet","poem":1},{"text":"finner det goda,","poem":3},{"text":"lycklig är den","poem":2},{"text":"som litar på Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Den som har vist hjärta","poem":1},{"text":"kallas klok,","poem":3},{"text":"och ljuvligt tal främjar lärdom.","poem":2},{"noteId":71}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Den som äger insikt","poem":1},{"text":"har en källa till liv,","poem":3},{"text":"men att fostra dårar är dårskap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Den vises hjärta","poem":1},{"text":"gör hans mun klok","poem":3},{"text":"och främjar lärdom","poem":2},{"text":"på hans läppar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Milda ord är som rinnande honung,","poem":1},{"text":"ljuva för själen","poem":2},{"text":"och en läkedom för kroppen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"En väg kan verka rätt","poem":1},{"text":"för en människa,","poem":3},{"text":"men till slut leda till döden.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Arbetarens hunger","poem":1},{"text":"får honom att arbeta,","poem":3},{"text":"hans egen mun driver på honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"En illasinnad man","poem":1},{"text":"gräver upp det onda,","poem":3},{"text":"brännande eld är på hans läppar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"En falsk människa skapar gräl,","poem":1},{"text":"baktalaren skiljer vänner åt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Den våldsamme förleder sin nästa","poem":1},{"text":"och leder honom in på en väg","poem":2},{"text":"som inte är god.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Den som kniper med ögonen","poem":1},{"text":"har vrånga tankar,","poem":3},{"text":"sammanpressade läppar","poem":2},{"text":"är redo till ont.","poem":3}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Grått hår är en ärekrona,","poem":1},{"text":"den vinns på rättfärdighetens väg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Bättre en tålmodig man","poem":1},{"text":"än en hjälte,","poem":3},{"text":"bättre styra sitt sinne","poem":2},{"text":"än inta en stad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Lotten kastas i knät,","poem":1},{"text":"men avgörandet kommer alltid","poem":2},{"text":"från Herren.","poem":3}]}],"footnotes":[{"noteId":70,"caller":"-","text":"hans fienderAnnan översättning: ”sina fiender”.","reference":{"chapter":16,"verse":7}},{"noteId":71,"caller":"-","text":"lärdomAnnan översättning: ”övertalningsförmågan” (även i vers 23).","reference":{"chapter":16,"verse":21}}]},"thisChapterLink":"/api/swe_fol/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}