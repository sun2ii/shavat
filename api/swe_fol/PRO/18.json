{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Enslingen följer",{"text":"sin egen lust,","poem":3},{"text":"han går till storms","poem":2},{"text":"mot all sund insikt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dåren frågar inte efter förstånd,","poem":1},{"text":"han vill bara uttrycka sina tankar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kommer en gudlös","poem":1},{"text":"kommer också förakt,","poem":3},{"text":"med skamligheter följer vanära.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Orden i människans mun","poem":1},{"text":"är som djupa vatten,","poem":3},{"text":"vishetens källa","poem":2},{"text":"som en flödande bäck.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Det är inte rätt","poem":1},{"text":"att ta parti för den skyldige","poem":3},{"text":"och vränga rätten","poem":2},{"text":"för den oskyldige.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dårens läppar kommer med bråk,","poem":1},{"text":"hans mun tigger om stryk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dårens mun är hans fördärv,","poem":1},{"text":"hans läppar en snara för hans liv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Baktalarens ord är som läckerbitar,","poem":1},{"text":"de tränger ner i människans inre.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Den som är försumlig i sitt arbete","poem":1},{"text":"är broder till den som förstör.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Herrens namn är ett starkt torn,","poem":1},{"text":"den rättfärdige skyndar dit","poem":2},{"text":"och får skydd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Den rikes välstånd","poem":1},{"text":"är hans fasta borg,","poem":3},{"text":"som en hög mur i hans inbillning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hjärtats högmod går före fall,","poem":1},{"text":"ödmjukhet föregår ära.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Att svara innan man lyssnat","poem":1},{"text":"är dårskap och skam.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mod håller människan uppe","poem":1},{"noteId":76},{"text":"under sjukdom,","poem":3},{"text":"men vem kan bära ett brutet mod?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Den klokes hjärta skaffar kunskap,","poem":1},{"text":"och de visas öron söker kunskap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"En gåva öppnar vägen","poem":1},{"text":"och för givaren fram inför de stora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Den som först för sin talan har rätt,","poem":1},{"text":"tills motparten kommer","poem":2},{"text":"och prövar saken.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Lotten stillar dispyter","poem":1},{"text":"och skiljer mellan mäktiga män.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"En kränkt broder","poem":1},{"text":"är svårare att vinna","poem":2},{"text":"än en befäst stad,","poem":3},{"text":"gräl är som bommar för en borg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Av munnens frukt","poem":1},{"text":"blir magen mättad,","poem":3},{"text":"man mättas av läpparnas skörd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tungan har makt över död och liv,","poem":1},{"text":"de som gärna brukar","poem":2},{"noteId":77},{"text":"den","poem":2},{"text":"får äta dess frukt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Den som funnit en hustru","poem":1},{"text":"har funnit något gott,","poem":3},{"text":"han har fått nåd från Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Den fattige vädjar om nåd,","poem":1},{"text":"den rike svarar med hårda ord.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Vänner kan slita varandra i stycken,","poem":1},{"noteId":78},{"text":"men det finns en vän","poem":2},{"text":"mer trofast än en bror.","poem":3}]}],"footnotes":[{"noteId":76,"caller":"-","text":"Mod håller människan uppeAnnan översättning: ”Människans ande håller henne uppe”.","reference":{"chapter":18,"verse":14}},{"noteId":77,"caller":"-","text":"gärna brukarAndra handskrifter (Septuaginta): ”behärskar”.","reference":{"chapter":18,"verse":21}},{"noteId":78,"caller":"-","text":"Vänner kan slita varandra i styckenAnnan översättning: ”En man med många vänner går det illa”.","reference":{"chapter":18,"verse":24}}]},"thisChapterLink":"/api/swe_fol/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}