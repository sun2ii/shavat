{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Bättre vara fattig",{"text":"och hederlig","poem":3},{"text":"än vara falsk i sitt tal","poem":2},{"text":"och en dåre.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Att sakna kunskap är illa nog,","poem":1},{"text":"men den som rusar i väg","poem":2},{"text":"missar målet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Människans dårskap","poem":1},{"text":"fördärvar hennes väg,","poem":3},{"text":"men hennes hjärta vredgas","poem":2},{"text":"på Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Rikedom ger många vänner,","poem":1},{"text":"men den fattige mister","poem":2},{"text":"den vän han har.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ett falskt vittne blir inte ostraffat,","poem":1},{"text":"den som främjar lögn","poem":2},{"text":"kommer inte undan.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Många söker en furstes välvilja,","poem":1},{"text":"alla är vänner till den givmilde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den fattige blir avskydd","poem":1},{"text":"av alla sina släktingar,","poem":3},{"text":"även hans vänner","poem":2},{"text":"fjärmar sig från honom –","poem":3},{"text":"han jagar dem med ord,","poem":2},{"text":"men de är borta","poem":3},{"noteId":79},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Den som vinner vett","poem":1},{"text":"älskar sitt liv,","poem":3},{"text":"den som tar vara på insikt","poem":2},{"text":"finner lycka.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ett falskt vittne blir inte ostraffat,","poem":1},{"text":"den som främjar lögn ska förgås.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Det passar inte att dåren lever i lyx,","poem":1},{"text":"än mindre att en slav","poem":2},{"text":"råder över furstar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Förstånd gör en människa","poem":1},{"text":"tålmodig,","poem":3},{"text":"det är hennes ära","poem":2},{"text":"att förlåta en försyndelse.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"En kungs vrede","poem":1},{"text":"är som ett lejons rytande,","poem":3},{"text":"hans välvilja är som dagg","poem":2},{"text":"på gräset.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"En dåraktig son är sin fars fördärv,","poem":1},{"text":"en hustrus gnat","poem":2},{"text":"ett ständigt takdropp.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gård och gods ärvs från fäderna,","poem":1},{"text":"en förståndig hustru","poem":2},{"text":"får man från Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lättja försänker i dvala,","poem":1},{"text":"den håglöse får hungra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Den som håller budet","poem":1},{"text":"bevarar sitt liv,","poem":3},{"text":"den som inte ger akt på sin väg","poem":2},{"text":"ska dö.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Den som ömmar för den fattige","poem":1},{"text":"lånar åt Herren","poem":3},{"text":"och lönas av honom","poem":2},{"text":"för det goda han gjort.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Fostra din son","poem":1},{"text":"medan det finns hopp","poem":3},{"noteId":80},{"text":",","poem":3},{"text":"sträva inte efter att vålla hans död.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Den hetsige måste få sitt straff,","poem":1},{"text":"för om du friar honom","poem":2},{"text":"får du fortsätta göra det","poem":3},{"noteId":81},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lyssna på råd och ta emot fostran,","poem":1},{"text":"så blir du till slut vis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Många planer har en man","poem":1},{"text":"i sitt hjärta,","poem":3},{"text":"men Herrens råd ska bestå.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"En människa längtar efter godhet,","poem":1},{"text":"bättre vara fattig än en lögnare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Vördnad för Herren leder till liv,","poem":1},{"text":"man kan vila mätt","poem":2},{"text":"utan att drabbas av något ont.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Den late sticker handen i skålen","poem":1},{"text":"men orkar inte föra den till munnen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Slå hånaren","poem":1},{"text":"så blir den okunnige klok,","poem":3},{"text":"tillrättavisa den förståndige","poem":2},{"text":"så vinner han kunskap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Den som tar till våld mot sin far","poem":1},{"noteId":82},{"text":"eller driver bort sin mor","poem":2},{"text":"är en usel och skamlös son.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Min son, om du slutar lyssna","poem":1},{"text":"till förmaning","poem":3},{"text":"så villar du bort dig","poem":2},{"text":"från kunskapens ord.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ett ont vittne hånar det rätta,","poem":1},{"text":"de gudlösas mun slukar ondska.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Straff är bestämt för hånare,","poem":1},{"text":"piskrapp för dårars rygg.","poem":2}]}],"footnotes":[{"noteId":79,"caller":"-","text":"men de är bortaGrundtextens innebörd är oklar.","reference":{"chapter":19,"verse":7}},{"noteId":80,"caller":"-","text":"medan det finns hoppAnnan översättning: ”för det finns hopp”.","reference":{"chapter":19,"verse":18}},{"noteId":81,"caller":"-","text":"får du fortsätta göra detAnnan översättning: ”gör du det värre”.","reference":{"chapter":19,"verse":19}},{"noteId":82,"caller":"-","text":"tar till våld mot sin farBelagt med dödsstraff (2 Mos 21:15). Annan översättning: ”plundrar sin far”.","reference":{"chapter":19,"verse":26}}]},"thisChapterLink":"/api/swe_fol/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}