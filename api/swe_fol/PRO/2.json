{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Visheten bevarar från fördärv"]},{"type":"verse","number":1,"content":["Min son,",{"text":"om du tar emot mina ord","poem":3},{"text":"och bevarar mina bud inom dig","poem":2}]},{"type":"verse","number":2,"content":[{"text":"så att ditt öra lyssnar till visheten","poem":1},{"text":"och du böjer ditt hjärta","poem":2},{"text":"till klokheten,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"ja, om du ropar efter insikten","poem":1},{"text":"och höjer din röst efter klokheten,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"om du söker den som silver","poem":1},{"text":"och letar efter den","poem":2},{"text":"som efter skatter,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"då ska du förstå","poem":1},{"text":"vad det är att vörda Herren","poem":2},{"text":"och finna kunskapen om Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"För det är Herren som ger vishet,","poem":1},{"text":"från hans mun kommer kunskap","poem":2},{"text":"och klokhet.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han har visa råd","poem":1},{"noteId":7},{"text":"i förvar åt de ärliga,","poem":3},{"text":"han är en sköld","poem":2},{"text":"för dem som lever hederligt,","poem":3}]},{"type":"verse","number":8,"content":[{"text":"han beskyddar det rättas stigar","poem":1},{"text":"och bevarar sina frommas väg.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Då ska du förstå vad som är","poem":1},{"text":"rättfärdigt, rättvist och rätt,","poem":2},{"text":"det godas alla vägar.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"För vishet ska komma in i ditt hjärta","poem":1},{"text":"och kunskap bli ljuvlig för din själ,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"omdöme ska bevara dig","poem":1},{"text":"och klokhet beskydda dig.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Visheten ska rädda dig","poem":1},{"text":"från det ondas väg,","poem":3},{"text":"från dem som talar","poem":2},{"text":"det som är förvridet,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"som överger det rättas stigar","poem":1},{"text":"för att vandra på mörkrets vägar,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"som gläds över att göra det onda","poem":1},{"text":"och fröjdar sig över","poem":2},{"text":"ondskans förvrängningar,","poem":3}]},{"type":"verse","number":15,"content":[{"text":"som följer krokiga stigar","poem":1},{"text":"och går på villovägar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Visheten ska rädda dig","poem":1},{"text":"från den främmande kvinnan,","poem":3},{"text":"från din nästas hustru","poem":2},{"text":"som talar hala ord,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"hon som har övergett","poem":1},{"text":"sin ungdoms vän","poem":3},{"text":"och glömt sin Guds förbund","poem":2},{"noteId":8},{"text":".","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hennes hus sjunker ner i döden,","poem":1},{"text":"hennes vägar går","poem":2},{"text":"till skuggornas boning.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"De som går in till henne","poem":1},{"text":"kommer aldrig tillbaka,","poem":3},{"text":"de når inte livets stigar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Därför ska du vandra","poem":1},{"text":"på de godas väg","poem":3},{"text":"och hålla dig","poem":2},{"text":"på de rättfärdigas stigar,","poem":3}]},{"type":"verse","number":21,"content":[{"text":"för de ärliga får bo i landet","poem":1},{"text":"och de hederliga stanna där.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Men de gudlösa","poem":1},{"noteId":9},{"text":"ska utrotas ur landet,","poem":1},{"text":"de trolösa ryckas bort därifrån.","poem":3}]}],"footnotes":[{"noteId":7,"caller":"-","text":"visa rådAnnan översättning (så Septuaginta): ”hjälp”.","reference":{"chapter":2,"verse":7}},{"noteId":8,"caller":"-","text":"sin Guds förbundÄktenskapet beskrivs som ett förbund inför Gud (Mal 2:14, Hes 16:8f).","reference":{"chapter":2,"verse":17}},{"noteId":9,"caller":"-","text":"de gudlösaHebr. rashásyftar på någon som är ond, ogudaktig, skyldig till brott mot Gud.","reference":{"chapter":2,"verse":22}}]},"thisChapterLink":"/api/swe_fol/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}