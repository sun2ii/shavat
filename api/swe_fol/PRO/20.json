{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Vinet hånar,",{"text":"starka drycker","poem":3},{"noteId":83},{"text":"larmar,","poem":3},{"text":"ingen som raglar av det är vis.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Som ett lejons rytande","poem":1},{"text":"är skräcken från en kung,","poem":3},{"text":"den som väcker hans vrede","poem":2},{"text":"förverkar sitt liv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Heder åt den som avstår från gräl,","poem":1},{"text":"dåren söker alltid strid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Den late plöjer inte om hösten,","poem":1},{"text":"vid skördetiden söker han","poem":2},{"text":"grödan förgäves.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Planerna i en mans hjärta","poem":1},{"text":"är som djupt vatten,","poem":3},{"text":"men en man med förstånd","poem":2},{"text":"hämtar upp dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Många ropar ut sin egen godhet,","poem":1},{"text":"men vem finner någon att lita på?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den rättfärdige lever hederligt,","poem":1},{"text":"lyckliga är hans barn efter honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kungen som sitter på domarsätet","poem":1},{"text":"rensar bort allt ont med sin blick.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Vem kan säga:","poem":1},{"text":"”Jag har bevarat mitt hjärta rent,","poem":2},{"text":"jag är fri från synd”?","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Två slags vikt och två slags mått,","poem":1},{"text":"Herren avskyr bådadera.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Redan den unge","poem":1},{"text":"visar med sina gärningar","poem":3},{"text":"om hans liv är rent och rätt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Örat som hör och ögat som ser,","poem":1},{"text":"båda har Herren gjort.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Älska inte sömn, då blir du fattig.","poem":1},{"text":"Håll ögonen öppna,","poem":2},{"text":"då får du bröd så det räcker.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"”Hutlöst, hutlöst”, säger köparen,","poem":1},{"text":"sedan går han sin väg","poem":2},{"text":"och skryter över sitt köp.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Det finns guld och pärlor i mängd,","poem":1},{"text":"men den dyrbaraste skatten","poem":2},{"text":"är läppar med kunskap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ta hans kläder","poem":1},{"noteId":84},{"text":"när han","poem":1},{"text":"går i borgen för en främling,","poem":3},{"text":"kräv pant när det gäller okända.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bröd man fått genom svek","poem":1},{"text":"smakar gott,","poem":3},{"text":"men sedan blir munnen full av grus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Planer efter rådslag får framgång,","poem":1},{"text":"att föra krig kräver klok ledning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Skvallraren avslöjar hemligheter,","poem":1},{"text":"ge dig inte i lag med pratmakare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Den som förbannar sin far eller mor,","poem":1},{"text":"hans lampa ska slockna","poem":2},{"text":"i djupaste mörker.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ett arv","poem":1},{"noteId":85},{"text":"som man först","poem":1},{"text":"girigt","poem":3},{"noteId":86},{"text":"tar över","poem":3},{"text":"blir till sist utan välsignelse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Säg inte:","poem":1},{"text":"”Jag ska löna ont med ont!”","poem":3},{"text":"Vänta på Herren,","poem":2},{"text":"han ska hjälpa dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Herren avskyr två slags vikter,","poem":1},{"text":"falsk våg är inte rätt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Av Herren beror en mans steg,","poem":1},{"text":"vad vet en människa om sin väg?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Det är farligt för en människa","poem":1},{"text":"att snabbt helga något","poem":3},{"text":"och överväga löftena först efteråt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"En vis kung rensar bort de gudlösa,","poem":1},{"text":"han kör tröskhjulet","poem":2},{"noteId":87},{"text":"över dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Anden i människan","poem":1},{"text":"är en Herrens lykta,","poem":3},{"text":"den utforskar varje rum","poem":2},{"text":"i hennes inre.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Godhet och sanning","poem":1},{"text":"skyddar kungen,","poem":3},{"text":"genom nåden består hans tron.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"De ungas stolthet är deras styrka,","poem":1},{"text":"de gamlas ära är deras grå hår.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Sår som svider renar från ondska,","poem":1},{"text":"slag renar hjärtats inre.","poem":2}]}],"footnotes":[{"noteId":83,"caller":"-","text":"starka dryckerSamlingsnamn för jästa drycker som öl, vin, mjöd etc. Destillerad sprit var okänd på Bibelns tid.","reference":{"chapter":20,"verse":1}},{"noteId":84,"caller":"-","text":"Ta hans kläderDen som inte kunde betala en skuld fick lämna ifrån sig allt (jfr 23:7) och i sista hand säljas som slav för sex års tid (5 Mos 15:12).","reference":{"chapter":20,"verse":16}},{"noteId":85,"caller":"-","text":"Ett arvAnnan översätting (Septuaginta): ”En egendom”.","reference":{"chapter":20,"verse":21}},{"noteId":86,"caller":"-","text":"girigtAndra handskrifter: ”plötsligt”.","reference":{"chapter":20,"verse":21}},{"noteId":87,"caller":"-","text":"tröskhjuletKrossade säden för att skilja agnarna från vetet (5 Mos 25:4, Matt 3:12).","reference":{"chapter":20,"verse":26}}]},"thisChapterLink":"/api/swe_fol/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}