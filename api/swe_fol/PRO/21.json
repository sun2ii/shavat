{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Kungens tankar är som",{"text":"vattenflöden i Herrens hand,","poem":3},{"text":"han leder dem vart han vill.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Var och en tycker","poem":1},{"text":"att hans vägar är rätta,","poem":3},{"text":"men Herren prövar hjärtan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Att handla rätt och rättfärdigt","poem":1},{"text":"är mer värt för Herren än offer.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Stolta ögon","poem":1},{"text":"och högmodigt hjärta –","poem":3},{"text":"de gudlösas lykta","poem":2},{"noteId":88},{"text":"är synd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Den flitiges planer ger idel vinst,","poem":1},{"text":"hastverk bara förlust.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Att vinna skatter","poem":1},{"text":"med lögnaktig tunga","poem":3},{"text":"är ett jagande efter vind","poem":2},{"noteId":89},{"text":"för dem som söker döden","poem":3},{"noteId":90},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"De gudlösas våldsdåd","poem":1},{"text":"snärjer dem själva,","poem":3},{"text":"för de vägrar göra det rätta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Syndfull man går krokig väg,","poem":1},{"text":"den rene går rakt fram.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bättre bo i en vrå på taket","poem":1},{"noteId":91},{"text":"än dela huset","poem":2},{"text":"med en grälsjuk kvinna.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Den gudlöses själ","poem":1},{"text":"har lust till det onda,","poem":3},{"text":"hans nästa finner ingen nåd","poem":2},{"text":"i hans ögon.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Straffas hånaren","poem":1},{"text":"blir den okunnige vis,","poem":3},{"text":"undervisas den vise","poem":2},{"text":"vinner han kunskap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Den Rättfärdige","poem":1},{"text":"ger akt på den gudlöses hus,","poem":3},{"text":"han störtar de gudlösa i olycka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Den som stänger sitt öra","poem":1},{"text":"för den fattiges rop","poem":3},{"text":"ska själv ropa utan att få svar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hemlig gåva dämpar vrede,","poem":1},{"text":"en skänk i fickan stillar stark ilska.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Att rätt skipas","poem":1},{"text":"är den rättfärdiges glädje","poem":3},{"text":"men förbrytarnas skräck.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Den som villar bort sig","poem":1},{"text":"från klokhetens väg","poem":3},{"text":"hamnar i de dödas församling.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Den som älskar fest blir fattig,","poem":1},{"text":"den som älskar vin och olja","poem":2},{"text":"blir inte rik.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Den gudlöse ges som lösen","poem":1},{"text":"för den rättfärdige,","poem":3},{"text":"den trolöse sätts i de ärligas ställe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bättre bo i ett öde land","poem":1},{"text":"än tillsammans med en grälsjuk","poem":2},{"text":"och elak kvinna.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Den vise har dyrbara skatter","poem":1},{"text":"och salvor i sin boning,","poem":3},{"text":"en dåraktig människa","poem":2},{"text":"slösar bort det.","poem":3},{"noteId":92}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Den som strävar efter","poem":1},{"text":"rättfärdighet och godhet","poem":3},{"text":"finner liv, rättfärdighet och ära.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"En vis man kan storma en stad","poem":1},{"text":"full av hjältar","poem":3},{"text":"och bryta ner det fäste de litade på.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Den som vaktar sin mun","poem":1},{"text":"och sin tunga","poem":3},{"text":"bevarar sitt liv från svårigheter.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Hånare kallas den som är fräck","poem":1},{"text":"och övermodig,","poem":3},{"text":"som handlar i måttlöst övermod.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Den lates begär blir hans död,","poem":1},{"text":"för hans händer vägrar arbeta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ständigt fikar han efter mer,","poem":1},{"text":"men den rättfärdige ger","poem":2},{"text":"utan att snåla.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"De gudlösas offer är avskyvärt,","poem":1},{"text":"särskilt när det bärs fram i ont syfte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Falskt vittne ska förgås,","poem":1},{"text":"den som lyssnar får tala till punkt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Den gudlöse visar upp en trotsig min,","poem":1},{"text":"den ärlige går sin väg rakt fram.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Ingen vishet, ingen förmåga,","poem":1},{"text":"ingen plan kan lyckas","poem":3},{"text":"mot Herren.","poem":4}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Hästen rustas för stridens dag,","poem":1},{"text":"men segern kommer från Herren.","poem":2}]}],"footnotes":[{"noteId":88,"caller":"-","text":"lyktaAndra handskrifter: ”nyodling”.","reference":{"chapter":21,"verse":4}},{"noteId":89,"caller":"-","text":"ett jagande efter vindAnnan översättning: ”en flyktig vindpust”.","reference":{"chapter":21,"verse":6}},{"noteId":90,"caller":"-","text":"för dem som söker dödenAndra handskrifter (så Septuaginta): ”en dödlig snara”.","reference":{"chapter":21,"verse":6}},{"noteId":91,"caller":"-","text":"vrå på taketAvskilt gästrum (jfr 2 Kung 4:10).","reference":{"chapter":21,"verse":9}},{"noteId":92,"caller":"-","text":"dyrbara skatter och salvorAnnan översättning: ”lager av läckerheter och olivolja”.","reference":{"chapter":21,"verse":20}}]},"thisChapterLink":"/api/swe_fol/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}