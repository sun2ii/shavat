{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Gott namn är mer värt",{"text":"än stor rikedom,","poem":3},{"text":"gott anseende bättre","poem":2},{"text":"än silver och guld.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rik och fattig lever sida vid sida","poem":1},{"noteId":93},{"text":",","poem":1},{"text":"Herren har gjort dem båda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Den kloke ser faran","poem":1},{"text":"och söker skydd,","poem":3},{"text":"de okunniga fortsätter","poem":2},{"text":"och får sitt straff.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Lön för ödmjukhet","poem":1},{"text":"och vördnad för Herren","poem":3},{"text":"är rikedom, ära och liv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Törnen och snaror","poem":1},{"text":"finns på den falskes väg,","poem":3},{"text":"den som vill bevara sitt liv","poem":2},{"text":"håller sig borta från dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vänj den unge","poem":1},{"text":"vid","poem":3},{"noteId":94},{"text":"den väg han ska vandra","poem":3},{"noteId":95},{"text":",","poem":3},{"text":"så viker han inte av från den","poem":2},{"text":"när han blir gammal.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den rike råder över de fattiga,","poem":1},{"text":"den som lånar","poem":2},{"text":"blir långivarens slav.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Den som sår orätt får skörda fördärv,","poem":1},{"text":"hans vredes stav ska få ett slut","poem":2},{"noteId":96},{"text":".","poem":2},{"noteId":97}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Den som unnar andra gott","poem":1},{"noteId":98},{"text":"blir välsignad,","poem":3},{"text":"för han delar sitt bröd","poem":2},{"text":"med den fattige.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Driv ut hånaren,","poem":1},{"text":"så upphör grälet","poem":3},{"text":"och det blir slut på bråk","poem":2},{"text":"och förolämpningar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Den som älskar hjärtats renhet","poem":1},{"text":"och talar vänligt får kungen till vän.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Herrens ögon vakar över kunskapen,","poem":1},{"text":"han gör den trolöses ord om intet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Den late säger:","poem":1},{"text":"”Det är ett lejon där ute,","poem":2},{"text":"jag kan bli dödad mitt på gatan!”","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Främmande kvinnors mun","poem":1},{"text":"är en djup grop,","poem":3},{"text":"den Herren är vred på faller i den.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Oförnuft häftar vid barnets hjärta,","poem":1},{"text":"fostrans ris driver bort det.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Att förtrycka den fattige","poem":1},{"text":"för att få mer","poem":3},{"noteId":99},{"text":"och att ge åt en rik","poem":2},{"text":"leder bara till förlust.","poem":3}]},{"type":"heading","content":["De visas ord (22:17-24:22)"]},{"type":"verse","number":17,"content":[{"text":"Vänd ditt öra hit","poem":1},{"text":"och hör de visas ord","poem":3},{"noteId":100},{"text":",","poem":3},{"text":"lägg min kunskap på ditt hjärta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Det är gott att du bevarar dem","poem":1},{"text":"i ditt inre","poem":3},{"text":"och ständigt har dem alla","poem":2},{"text":"på dina läppar.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"För att du ska lita till Herren","poem":1},{"text":"undervisar jag i dag just dig.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ja, jag har skrivit till dig","poem":1},{"text":"trettio ord","poem":2},{"noteId":101},{"text":"med råd och kunskap","poem":2}]},{"type":"verse","number":21,"content":[{"text":"för att lära dig","poem":1},{"text":"sanningens tillförlitliga ord,","poem":3},{"text":"så att du rätt kan svara","poem":2},{"text":"dem som har sänt dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Plundra inte den fattige","poem":1},{"text":"för att han är fattig","poem":3},{"text":"och krossa inte den olycklige","poem":2},{"text":"i rätten,","poem":3}]},{"type":"verse","number":23,"content":[{"text":"för Herren ska ta sig an deras sak,","poem":1},{"text":"dem som rövar från dem","poem":2},{"text":"ska han beröva livet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ge dig inte i lag","poem":1},{"text":"med en lättretad man","poem":3},{"text":"och umgås inte","poem":2},{"text":"med en hetlevrad,","poem":3}]},{"type":"verse","number":25,"content":[{"text":"så att du lär dig hans vägar","poem":1},{"text":"och lägger en snara för ditt liv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Var inte bland dem","poem":1},{"text":"som ger handslag","poem":3},{"text":"och går i borgen för lån.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Varför ska de få ta","poem":1},{"text":"sängen du ligger på","poem":3},{"text":"när du inte kan betala?","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Flytta inte en gammal gränssten","poem":1},{"text":"som dina fäder har rest.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ser du en man","poem":1},{"text":"som är skicklig i det han gör?","poem":3},{"text":"Han ska stå i kungars tjänst,","poem":2},{"text":"han ska inte tjäna okända.","poem":3}]}],"footnotes":[{"noteId":93,"caller":"-","text":"lever sida vid sidaOrdagrant: ”möts”.","reference":{"chapter":22,"verse":2}},{"noteId":94,"caller":"-","text":"Vänj … vidAnnan översättning: ”Invig … i”.","reference":{"chapter":22,"verse":6}},{"noteId":95,"caller":"-","text":"den väg han ska vandraOrdagrant: ”hans väg”.","reference":{"chapter":22,"verse":6}},{"noteId":96,"caller":"-","text":"hans vredes stav ska få ett slutAndra handskrifter (Septuaginta): ”en stav ska göra slut på hans verk”.","reference":{"chapter":22,"verse":8}},{"noteId":97,"caller":"-","text":"Septuaginta har här ett ordspråk (22:8b) som Paulus anspelar på i 2 Kor 9:7: ”Gud välsignar en glad och givmild man, och gör slut på hans gärningars tomhet.”","reference":{"chapter":22,"verse":8}},{"noteId":98,"caller":"-","text":"unnar andra gottOrdagrant: ”har ett gott öga”.","reference":{"chapter":22,"verse":9}},{"noteId":99,"caller":"-","text":"för att få merAnnan översättning: ”ger honom mer”.","reference":{"chapter":22,"verse":16}},{"noteId":100,"caller":"-","text":"de visas ordAvsnittet i 22:17-24:22 har en del likheter med den egyptiska vishetsskriften ”Amenemopes lära”, som är skriven i trettio korta kapitel (jfr vers 20).","reference":{"chapter":22,"verse":17}},{"noteId":101,"caller":"-","text":"trettio ordAnnan översättning: ”sedan länge”.","reference":{"chapter":22,"verse":20}}]},"thisChapterLink":"/api/swe_fol/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}