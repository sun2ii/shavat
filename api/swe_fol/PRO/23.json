{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["När du sitter till bords",{"text":"med en härskare,","poem":3},{"text":"tänk på vem du har framför dig.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sätt kniven mot din strupe","poem":1},{"text":"om du är alltför hungrig.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Var inte lysten","poem":1},{"text":"efter hans läckerheter,","poem":3},{"text":"det kan vara bedräglig mat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Slit inte ut dig för att bli rik,","poem":1},{"text":"var klok nog att avstå.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"När du fäster blicken på rikedomen","poem":1},{"text":"är den borta,","poem":3},{"text":"för den får vingar och flyger","poem":2},{"text":"som örnen mot himlen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ät inte den missunnsammes","poem":1},{"noteId":102},{"text":"bröd,","poem":1},{"text":"var inte lysten","poem":2},{"text":"efter hans läckerheter,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"för han handlar","poem":1},{"text":"efter sina själviska beräkningar.","poem":3},{"noteId":103},{"text":"”Ät och drick” säger han till dig,","poem":2},{"text":"men menar det inte.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Den bit du ätit får du spy upp,","poem":1},{"text":"och dina vänliga ord är förspillda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tala inte för en dåres öron,","poem":1},{"text":"han föraktar dina kloka ord.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Flytta inte en gammal gränssten","poem":1},{"text":"och gör inte intrång","poem":2},{"text":"på de faderlösas åkrar,","poem":3}]},{"type":"verse","number":11,"content":[{"text":"för deras återlösare","poem":1},{"noteId":104},{"text":"är stark.","poem":1},{"text":"Han ska föra deras talan mot dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Öppna ditt hjärta för tillrättavisning","poem":1},{"text":"och dina öron för kunskapens ord.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Låt inte pojken vara utan fostran,","poem":1},{"text":"slår du honom med riset","poem":2},{"text":"kommer han inte att dö.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"När du slår honom med riset","poem":1},{"text":"räddar du hans själ","poem":2},{"text":"från dödsriket.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Min son, om ditt hjärta blir vist","poem":1},{"text":"gläder sig också mitt hjärta.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Det jublar i mitt innersta","poem":1},{"text":"när dina läppar talar det rätta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Låt inte ditt hjärta","poem":1},{"text":"avundas syndare,","poem":3},{"text":"utan sträva alltid efter","poem":2},{"text":"vördnad för Herren.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Förvisso har du då en framtid,","poem":1},{"text":"och ditt hopp blir inte om intet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hör, min son, och bli vis,","poem":1},{"text":"och låt ditt hjärta gå rätta vägar.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Umgås inte med drinkare","poem":1},{"text":"eller med dem som frossar i kött,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"för drinkare och frossare","poem":1},{"text":"blir fattiga","poem":3},{"text":"och dåsighet ger trasiga kläder.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Lyssna till din far som gett dig livet","poem":1},{"text":"och förakta inte din mor","poem":2},{"text":"när hon blir gammal.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Skaffa dig sanning och sälj den inte,","poem":1},{"text":"skaffa dig vishet,","poem":2},{"text":"fostran och insikt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Den rättfärdiges far får jubla,","poem":1},{"text":"en vis son skänker glädje.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Låt din far och mor vara glada,","poem":1},{"text":"låt henne som fött dig","poem":2},{"text":"få fröjda sig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Min son, ge mig ditt hjärta","poem":1},{"text":"och låt mina vägar behaga dig.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"För den prostituerade","poem":1},{"text":"är en djup grop,","poem":3},{"text":"den främmande kvinnan","poem":2},{"text":"en trång brunn.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Som en rövare ligger hon på lur,","poem":1},{"text":"hon förökar de trolösas skara","poem":2},{"text":"bland människorna.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Vem ropar ”ack”, vem ropar ”ve”?","poem":1},{"text":"Vem grälar, vem klagar?","poem":3},{"text":"Vem har onödiga sår,","poem":2},{"text":"vem har dimmiga ögon?","poem":3}]},{"type":"verse","number":30,"content":[{"text":"De som stannar länge vid vinet,","poem":1},{"text":"de som går och prövar","poem":2},{"text":"kryddat vin.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Se inte på vinet,","poem":1},{"text":"att det är så rött,","poem":3},{"text":"att det glänser så i bägaren","poem":2},{"text":"och rinner ner så lätt.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Till slut biter det som en orm","poem":1},{"text":"och hugger","poem":2},{"noteId":105},{"text":"som en giftorm.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Då får dina ögon","poem":1},{"text":"se märkliga syner","poem":3},{"text":"och ditt hjärta talar galenskaper.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Det blir som att du ligger","poem":1},{"text":"mitt ute på havet","poem":3},{"text":"eller i toppen av en mast.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"”De slog mig,","poem":1},{"text":"men det gjorde inte ont.","poem":3},{"text":"De gav mig stryk,","poem":2},{"text":"men jag kände inget.","poem":3},{"text":"När ska jag vakna?","poem":2},{"text":"Jag vill få tag i mer!”","poem":3}]}],"footnotes":[{"noteId":102,"caller":"-","text":"den missunnsammeOrdagrant: ”den som har ett ont öga”.","reference":{"chapter":23,"verse":6}},{"noteId":103,"caller":"-","text":"han handlar efter sina själviska beräkningarAnnan översättning: ”som han tänker i sin själ, sådan är han” eller ”det är som att få ett hårstrå i halsen” (så Septuaginta).","reference":{"chapter":23,"verse":7}},{"noteId":104,"caller":"-","text":"återlösareSläkting som skulle rädda sina anhöriga ur ekonomisk nöd (se 3 Mos 25:25f, Rut 3-4).","reference":{"chapter":23,"verse":11}},{"noteId":105,"caller":"-","text":"huggerAndra handskrifter (Septuaginta): ”sprider gift”.","reference":{"chapter":23,"verse":32}}]},"thisChapterLink":"/api/swe_fol/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}