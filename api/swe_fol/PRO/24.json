{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Avundas inte onda människor",{"text":"och längta inte efter att","poem":2},{"text":"vara med dem,","poem":3}]},{"type":"verse","number":2,"content":[{"text":"för deras hjärtan tänker på våld,","poem":1},{"text":"deras läppar talar olycka.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Genom vishet byggs huset,","poem":1},{"text":"genom förstånd står det fast.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Genom kunskap fylls rummen","poem":1},{"text":"med allt som är dyrbart och ljuvt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"En vis man är stark,","poem":1},{"text":"en man med kunskap","poem":2},{"text":"är väldig i kraft.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Med klok ledning kan du föra krig,","poem":1},{"text":"många goda rådgivare ger seger.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Visheten är för hög för dåren,","poem":1},{"text":"i porten","poem":2},{"noteId":106},{"text":"öppnar han inte","poem":2},{"text":"sin mun.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Den som tänker ut onda planer","poem":1},{"text":"blir kallad intrigmakare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Dårskapens påhitt är synd,","poem":1},{"text":"och folk avskyr en hånare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Tappar du modet i nödens stund,","poem":1},{"text":"då blir din kraft liten.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Rädda dem som släpas till döden","poem":1},{"text":"och dra dig inte undan dem","poem":2},{"text":"som stapplar till sin avrättning.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Om du säger: ”Vi visste det inte”,","poem":1},{"text":"skulle inte han som prövar hjärtan","poem":2},{"text":"märka det?","poem":3},{"text":"Skulle inte han som vakar","poem":2},{"text":"över din själ veta det?","poem":3},{"text":"Han ska ge åt var och en","poem":2},{"text":"efter hans gärningar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ät honung, min son, det är gott,","poem":1},{"text":"rinnande honung","poem":2},{"text":"är söt för din gom.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Så är kunskap och vishet","poem":1},{"text":"för din själ.","poem":3},{"text":"Finner du dem","poem":2},{"text":"så har du en framtid,","poem":3},{"text":"och ditt hopp blir inte om intet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ligg inte på lur, du gudlöse,","poem":1},{"text":"vid den rättfärdiges boning,","poem":2},{"text":"ödelägg inte hans hem!","poem":3}]},{"type":"verse","number":16,"content":[{"text":"För den rättfärdige kan falla","poem":1},{"text":"sju gånger och resa sig igen,","poem":3},{"text":"men de gudlösa stupar","poem":2},{"text":"när olyckan kommer.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gläd dig inte när din fiende faller,","poem":1},{"text":"låt inte ditt hjärta jubla","poem":2},{"text":"när han störtar omkull.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Då kan Herren se det","poem":1},{"text":"med missnöje","poem":3},{"text":"och vända sin vrede från honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gräm dig inte över de onda","poem":1},{"noteId":107},{"text":",","poem":1},{"text":"avundas inte de gudlösa,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"för den som är ond","poem":1},{"text":"har ingen framtid,","poem":3},{"text":"de gudlösas lampa ska slockna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Min son, frukta Herren","poem":1},{"text":"och kungen,","poem":3},{"text":"ge dig inte i lag med upprorsmän.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"För plötsligt kan olyckan","poem":1},{"text":"drabba dem,","poem":3},{"text":"och vem vet när förödelse","poem":2},{"text":"från dessa båda kommer?","poem":3}]},{"type":"heading","content":["Tillägg till de visas ord (24:23-34)"]},{"type":"verse","number":23,"content":[{"text":"Dessa ord är också av de visa.","poem":1},{"lineBreak":true},{"text":"Att vara partisk när man dömer","poem":1},{"text":"är inte rätt.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Den som säger till den skyldige:","poem":1},{"text":"”Du är oskyldig”,","poem":3},{"text":"honom ska folk förbanna","poem":2},{"text":"och folkslag fördöma.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Men dem som skipar rättvisa","poem":1},{"text":"ska det gå väl,","poem":3},{"text":"de blir välsignade","poem":2},{"text":"med det som är gott.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"En kyss på läpparna är det","poem":1},{"text":"när någon ger ett rätt svar","poem":2},{"noteId":108},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Gör klart ditt arbete där ute,","poem":1},{"text":"få allt färdigt åt dig på åkern.","poem":3},{"text":"Sedan kan du bygga ditt hus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Vittna inte mot din nästa","poem":1},{"text":"utan orsak,","poem":3},{"text":"inte vill du bedra","poem":2},{"text":"med dina läppar?","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Säg inte:","poem":1},{"text":"”Jag ska göra mot honom","poem":2},{"text":"som han har gjort mot mig,","poem":3},{"text":"jag ska ge var och en","poem":2},{"text":"vad han förtjänat.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Jag gick förbi en lat mans åker,","poem":1},{"text":"en vettlös människas vingård.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Och se, det växte tistlar överallt,","poem":1},{"text":"marken var täckt av nässlor,","poem":2},{"text":"stenmuren låg nerriven.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Jag såg det och tog det till hjärtat,","poem":1},{"text":"jag betraktade det","poem":2},{"text":"och tog lärdom av det.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"Sov lite till, slumra lite till,","poem":1},{"text":"ligg lite till med armarna i kors,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"så kommer fattigdomen över dig","poem":1},{"text":"som en rövare","poem":3},{"noteId":109},{"text":"och nöden som en beväpnad man.","poem":2}]}],"footnotes":[{"noteId":106,"caller":"-","text":"i portenPlatsen där de äldste beslutade om samhällets frågor (31:23, Rut 4).","reference":{"chapter":24,"verse":7}},{"noteId":107,"caller":"-","text":"Gräm dig inte över de ondaCitat från Davids psalm Ps 37:1.","reference":{"chapter":24,"verse":19}},{"noteId":108,"caller":"-","text":"rätt svarAnnan översättning: ”ärligt svar”.","reference":{"chapter":24,"verse":26}},{"noteId":109,"caller":"-","text":"rövareAnnan översättning: ”lösdrivare”.","reference":{"chapter":24,"verse":34}}]},"thisChapterLink":"/api/swe_fol/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}