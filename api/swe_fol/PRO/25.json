{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"heading","content":["Ordspråk från Hiskias män (Kap 25-29)"]},{"type":"verse","number":1,"content":["Dessa ordspråk är också av Salomo, samlade av Juda kung Hiskias män",{"noteId":110},"."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Det är Guds ära att dölja en sak","poem":1},{"text":"och kungars ära att utforska den.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Himlens höjd och jordens djup","poem":1},{"text":"och kungars hjärtan","poem":2},{"text":"kan ingen utforska.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ta bort slagget från silvret,","poem":1},{"text":"så får guldsmeden fram ett kärl.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ta bort de gudlösa ur kungens tjänst,","poem":1},{"text":"så blir hans tron befäst","poem":2},{"text":"genom rättfärdighet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Förhäv dig inte inför kungen","poem":1},{"text":"och ställ dig inte","poem":2},{"text":"på de storas plats.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Det är bättre att han säger till dig:","poem":1},{"text":"”Kom upp hit!”","poem":3},{"noteId":111},{"text":"än att du flyttas ner","poem":2},{"text":"för en förnämare man","poem":3},{"text":"som dina ögon har sett","poem":2},{"noteId":112},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Var inte för snabb","poem":1},{"text":"att starta en rättstvist,","poem":3},{"text":"för vad gör du längre fram","poem":2},{"text":"om din motpart skämmer","poem":3},{"text":"ut dig?","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lägg fram din egen sak","poem":1},{"text":"mot din motpart,","poem":3},{"text":"men röj inte någon annans","poem":2},{"text":"hemlighet.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Annars kan den som hör det","poem":1},{"text":"klandra dig,","poem":3},{"text":"och du får dåligt rykte","poem":2},{"text":"för all framtid.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Som guldäpplen i silverinfattning","poem":1},{"text":"är ord som talas i rätt tid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Som en ring av guld","poem":1},{"text":"och ett gyllene smycke","poem":3},{"text":"är en vis förmanare","poem":2},{"text":"för ett lyssnande öra.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Som svalkande snö på en skördedag","poem":1},{"noteId":113},{"text":"är en pålitlig budbärare","poem":2},{"text":"för den som sänt honom.","poem":3},{"text":"Han ger nytt liv åt sin herres själ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Som moln och vind utan regn","poem":1},{"text":"är den som skryter med gåvor","poem":2},{"text":"han inte ger.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Med tålamod kan furstar övertalas,","poem":1},{"text":"en mild tunga kan krossa ben.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Hittar du honung, ät lagom,","poem":1},{"text":"så att du inte blir övermätt","poem":2},{"text":"och kräks.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sätt inte din fot i din väns hus","poem":1},{"text":"för ofta,","poem":3},{"text":"så att han tröttnar på dig","poem":2},{"text":"och avskyr dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"En stridshammare, ett svärd","poem":1},{"text":"och en skarp pil","poem":3},{"text":"är den som vittnar falskt","poem":2},{"text":"mot sin nästa.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Som en ruttnande tand","poem":1},{"text":"och en slintande fot","poem":3},{"text":"är förtroende för en svekfull","poem":2},{"text":"på nödens dag.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Att sjunga sånger","poem":1},{"text":"för ett sorgset hjärta","poem":3},{"text":"är som att klä av sig en vinterdag","poem":2},{"text":"eller som syra på soda","poem":3},{"noteId":114},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Om din fiende är hungrig,","poem":1},{"text":"ge honom att äta,","poem":3},{"text":"om han är törstig,","poem":2},{"text":"ge honom att dricka.","poem":3},{"noteId":115}]},{"type":"verse","number":22,"content":[{"text":"Då samlar du glödande kol","poem":1},{"text":"på hans huvud,","poem":3},{"text":"och Herren ska belöna dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Nordanvind för med sig regn,","poem":1},{"text":"tasslande tunga sura miner.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Bättre bo i en vrå på taket","poem":1},{"text":"än dela huset","poem":2},{"text":"med en grälsjuk kvinna.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Som friskt vatten för en törstig själ","poem":1},{"text":"är gott budskap från fjärran land.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Som en grumlad källa","poem":1},{"text":"och en förorenad brunn","poem":3},{"text":"är en rättfärdig som ger efter","poem":2},{"text":"för en gudlös.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Att äta för mycket honung","poem":1},{"text":"är inte gott,","poem":3},{"text":"att söka sin egen ära","poem":2},{"text":"är inte ärofullt.","poem":3},{"noteId":116}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Som en nerbruten stad utan murar","poem":1},{"text":"är den man som inte kan","poem":2},{"text":"styra sitt sinne.","poem":3}]}],"footnotes":[{"noteId":110,"caller":"-","text":"Hiskias mänKung Hiskia (715-687 f Kr) återupprättade templet med dess präster och leviter (2 Krön 29-31). I kretsen kring honom (Jes 37:2) fanns även profeten Jesaja.","reference":{"chapter":25,"verse":1}},{"noteId":111,"caller":"-","text":"Kom upp hitOrdspråket användes av Jesus vid en måltid (Luk 14:7f).","reference":{"chapter":25,"verse":7}},{"noteId":112,"caller":"-","text":"som dina ögon har settEnligt en annan tolkning hör orden till nästa ordspråk: ”Vad dina ögon har sett ska du inte vara för snabb att starta en rättstvist om”.","reference":{"chapter":25,"verse":7}},{"noteId":113,"caller":"-","text":"svalkande snö på en skördedagVetet skördades i maj-juni, heta månader då nederbörd är sällsynt i Israel (jfr 26:1, 1 Sam 12:17). Kan möjligen syfta på kylande is hämtad från bergstoppar.","reference":{"chapter":25,"verse":13}},{"noteId":114,"caller":"-","text":"syra på sodaBildar en kraftig kemisk reaktion. Jfr Sauls reaktion i 1 Sam 18:10, 19:9.","reference":{"chapter":25,"verse":20}},{"noteId":115,"caller":"-","text":"Citeras av Paulus i Rom 12:20.","reference":{"chapter":25,"verse":21}},{"noteId":116,"caller":"-","text":"att söka sin egen ära är inte ärofulltGrundtexten svårtolkad.","reference":{"chapter":25,"verse":27}}]},"thisChapterLink":"/api/swe_fol/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}