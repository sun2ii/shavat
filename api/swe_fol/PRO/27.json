{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Beröm dig inte",{"text":"av morgondagen,","poem":3},{"text":"för du vet inte","poem":2},{"text":"vad den bär i sitt sköte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Låt en annan berömma dig","poem":1},{"text":"och inte din egen mun,","poem":3},{"text":"en främmande","poem":2},{"text":"och inte dina egna läppar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Stenen är tung och sanden en börda,","poem":1},{"text":"men dårens vrede är tyngre än båda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vreden är grym","poem":1},{"text":"och harm en störtflod,","poem":3},{"text":"men vem kan uthärda svartsjuka?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bättre öppen tillrättavisning","poem":1},{"text":"än dold kärlek.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vännens slag ges i trofasthet,","poem":1},{"text":"ovännens kyssar i överflöd.","poem":2},{"noteId":123}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den mätte ratar","poem":1},{"noteId":124},{"text":"honung,","poem":1},{"text":"men för den hungrige","poem":2},{"text":"är allt bittert sött.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Som en fågel som flyr från sitt bo","poem":1},{"text":"är en man som flyr från sitt hem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Salvor och rökelse gör hjärtat glatt,","poem":1},{"text":"så även ömhet från en vän","poem":2},{"text":"som ger uppriktiga råd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Överge inte din vän","poem":1},{"text":"och din fars vän,","poem":3},{"text":"gå inte till din brors hem","poem":2},{"text":"när du råkar i nöd.","poem":3},{"text":"Bättre nära granne","poem":2},{"text":"än bror långt borta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bli vis, min son,","poem":1},{"text":"så gläder du mitt hjärta,","poem":3},{"text":"och jag kan ge min belackare svar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Den kloke ser faran","poem":1},{"text":"och söker skydd,","poem":3},{"text":"de okunniga fortsätter","poem":2},{"text":"och får sitt straff.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ta kläderna från den som","poem":1},{"text":"går i borgen för en främling,","poem":3},{"text":"kräv pant när det gäller","poem":2},{"text":"en okänd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Att högljutt välsigna","poem":1},{"noteId":125},{"text":"sin nästa","poem":1},{"text":"tidigt på morgonen","poem":3},{"text":"kan uppfattas som en förbannelse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Som ett ständigt takdropp","poem":1},{"text":"en regnig dag","poem":3},{"text":"är en grälsjuk kvinna.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Att hejda henne","poem":1},{"text":"är som att hejda vinden","poem":3},{"text":"och gripa i olja","poem":2},{"text":"med sin högra hand.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Järn skärper järn,","poem":1},{"text":"den ena människan den andra.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Den som vårdar ett fikonträd","poem":1},{"text":"får äta dess frukt,","poem":3},{"text":"den som sköter om sin herre","poem":2},{"text":"blir ärad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Som vattnet speglar ansiktet,","poem":1},{"text":"så speglar hjärtat människan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Dödsriket och avgrunden","poem":1},{"text":"blir aldrig mätta,","poem":3},{"text":"inte heller människans ögon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Silvret prövas i degeln","poem":1},{"text":"och guldet i ugnen,","poem":3},{"text":"och mannen genom sitt rykte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Även om du krossar dåren","poem":1},{"text":"bland grynen i morteln","poem":3},{"text":"går inte hans dårskap ur honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Håll noga reda på","poem":1},{"text":"hur dina får har det,","poem":3},{"text":"ha omsorg om dina hjordar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Rikedom varar ju inte för evigt.","poem":1},{"text":"Består ens en krona","poem":2},{"text":"från släkte till släkte?","poem":3}]},{"type":"verse","number":25,"content":[{"text":"När nytt gräs syns efter slåttern","poem":1},{"text":"och foder samlas in från bergen,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"då har du lamm som ger kläder","poem":1},{"text":"och bockar att köpa åkermark för,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"då har du getmjölk nog","poem":1},{"text":"till föda åt dig och ditt hus","poem":2},{"text":"och dina tjänarinnors","poem":3},{"text":"uppehälle.","poem":4}]}],"footnotes":[{"noteId":123,"caller":"-","text":"i överflödAnnan översättning: ”bedrar”.","reference":{"chapter":27,"verse":6}},{"noteId":124,"caller":"-","text":"ratarSå Septuaginta. Andra handskrifter: ”trampar på”.","reference":{"chapter":27,"verse":7}},{"noteId":125,"caller":"-","text":"välsignaMan hälsade normalt i form av en välsignelse (Rut 2:4, 1 Sam 25:6, Luk 10:5).","reference":{"chapter":27,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}