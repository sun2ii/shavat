{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["De gudlösa flyr",{"text":"fast ingen förföljer dem,","poem":3},{"text":"de rättfärdiga är trygga","poem":2},{"text":"som lejon.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ett land i uppror","poem":1},{"noteId":126},{"text":"får många herrar,","poem":1},{"text":"men en klok och förståndig man","poem":2},{"text":"skapar varaktig ordning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"En fattig","poem":1},{"noteId":127},{"text":"herre","poem":1},{"text":"som förtrycker de fattiga","poem":3},{"text":"är ett regn som förstör","poem":2},{"text":"i stället för att ge bröd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"De som överger lagen","poem":1},{"text":"prisar de gudlösa,","poem":3},{"text":"de som håller lagen","poem":2},{"text":"kämpar mot dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Onda människor förstår inte","poem":1},{"text":"vad rätt är,","poem":3},{"text":"de som söker Herren","poem":2},{"text":"förstår allt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bättre vara fattig och leva hederligt","poem":1},{"text":"än rik och gå krokiga vägar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"En förståndig son tar vara på lagen,","poem":1},{"text":"den som umgås med frossare","poem":2},{"text":"drar skam över sin far.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Den som ökar sin förmögenhet","poem":1},{"text":"genom ocker och räntor","poem":3},{"noteId":128},{"text":"samlar åt en som förbarmar sig","poem":2},{"text":"över de fattiga.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Om någon vänder bort sitt öra","poem":1},{"text":"och inte vill höra lagen,","poem":3},{"text":"då är också hans bön avskyvärd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Den som lurar in de ärliga","poem":1},{"text":"på en ond väg","poem":2},{"text":"faller själv i sin grop,","poem":3},{"text":"men de hederliga","poem":2},{"text":"får det goda till arv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"En rik man är vis i egna ögon,","poem":1},{"text":"en fattig med insikt","poem":2},{"text":"genomskådar honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"När de rättfärdiga triumferar","poem":1},{"text":"är härligheten stor,","poem":3},{"text":"när de gudlösa tar makten","poem":2},{"text":"får man leta efter människor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Den som döljer sina brott","poem":1},{"text":"går det inte väl,","poem":3},{"text":"den som bekänner och överger dem","poem":2},{"text":"får barmhärtighet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Salig är den som alltid fruktar Gud,","poem":1},{"text":"den som förhärdar sitt hjärta","poem":2},{"text":"faller i olycka.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Som ett rytande lejon","poem":1},{"text":"och en anfallande björn","poem":3},{"text":"är en gudlös härskare","poem":2},{"text":"över ett fattigt folk.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"En furste med lite förstånd","poem":1},{"text":"brukar mycket våld,","poem":3},{"text":"den som hatar oärlig vinst","poem":2},{"text":"får leva länge.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"En människa tyngd av blodskuld","poem":1},{"noteId":129},{"text":"blir flykting ända till sin grav,","poem":2},{"text":"ingen får hjälpa en sådan.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Den som lever hederligt blir räddad,","poem":1},{"text":"den som i falskhet går dubbla vägar","poem":2},{"text":"faller på en av dem","poem":3},{"noteId":130},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Den som brukar sin åker","poem":1},{"text":"får bröd så det räcker,","poem":3},{"text":"den som jagar efter tomhet","poem":2},{"text":"får fattigdom så det räcker.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"En pålitlig man","poem":1},{"text":"får mycket välsignelse,","poem":3},{"text":"den som snabbt vill bli rik","poem":2},{"text":"blir inte ostraffad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Att vara partisk är inte rätt,","poem":1},{"text":"men många gör orätt för en bit bröd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Den missunnsamme","poem":1},{"text":"strävar efter ägodelar,","poem":3},{"text":"han förstår inte","poem":2},{"text":"att brist ska drabba honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Den som tillrättavisar en människa","poem":1},{"text":"får uppskattning efteråt,","poem":3},{"text":"mer än den som kommer","poem":2},{"text":"med smicker.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Den som plundrar sin far och mor","poem":1},{"text":"och säger: ”Det är ingen synd”,","poem":3},{"text":"han är i lag med fördärvaren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Den snikne skapar gräl,","poem":1},{"text":"den som litar på Herren","poem":2},{"text":"blir rikligen mättad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Den som förlitar sig på sitt hjärta","poem":1},{"text":"är en dåre,","poem":3},{"text":"den som vandrar i vishet","poem":2},{"text":"blir räddad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Den som ger åt den fattige","poem":1},{"text":"ska inget sakna,","poem":3},{"text":"den som blundar","poem":2},{"text":"får många förbannelser.","poem":3}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"När de gudlösa tar makten","poem":1},{"text":"gömmer sig folk,","poem":3},{"text":"när de förgås","poem":2},{"text":"blir de rättfärdiga många.","poem":3}]}],"footnotes":[{"noteId":126,"caller":"-","text":"upprorAnnan översättning: ”synd”.","reference":{"chapter":28,"verse":2}},{"noteId":127,"caller":"-","text":"fattigAndra handskrifter (Septuaginta): ”ond”.","reference":{"chapter":28,"verse":3}},{"noteId":128,"caller":"-","text":"ocker och räntorFörbjudet bland israeliter (2 Mos 22:25, 3 Mos 25:35f, 5 Mos 23:19f).","reference":{"chapter":28,"verse":8}},{"noteId":129,"caller":"-","text":"tyngd av blodskuldSe 4 Mos 35 för regler kring mord, dråp och fristäder.","reference":{"chapter":28,"verse":17}},{"noteId":130,"caller":"-","text":"faller på en av demAndra handskrifter (Peshitta): ”faller i gropen”.",