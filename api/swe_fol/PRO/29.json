{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Den som får mycket",{"text":"tillrättavisning","poem":2},{"text":"men förblir hårdnackad","poem":3},{"text":"ska krossas plötsligt utan räddning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"När de rättfärdiga blir fler","poem":1},{"noteId":131},{"text":"gläder sig folket,","poem":3},{"text":"när den gudlöse härskar","poem":2},{"text":"suckar folket.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Den som älskar vishet gläder sin far,","poem":1},{"text":"den som umgås med prostituerade","poem":2},{"text":"förstör vad han äger.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Genom rättvisa","poem":1},{"text":"bygger kungen upp landet,","poem":3},{"text":"men genom höga pålagor","poem":2},{"noteId":132},{"text":"river han ner det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Den som smickrar sin nästa","poem":1},{"text":"lägger ut ett nät för hans fötter.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"En ond människa snärjs av sin synd,","poem":1},{"text":"men den rättfärdige","poem":2},{"text":"kan jubla och vara glad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den rättfärdige känner","poem":1},{"text":"de fattigas sak,","poem":3},{"text":"den gudlöse visar","poem":2},{"text":"ingen förståelse.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hånare uppviglar staden,","poem":1},{"text":"de visa stillar vreden.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"När en vis man går till rätta","poem":1},{"text":"med en dåre,","poem":3},{"text":"blir dåren arg eller skrattar","poem":2},{"text":"och det blir ingen ro.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"De blodtörstiga hatar den hederlige,","poem":1},{"text":"men de ärliga skyddar hans liv.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Dåren släpper lös all sin vrede","poem":1},{"noteId":133},{"text":",","poem":1},{"text":"men den vise håller den tillbaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Den furste som lyssnar","poem":1},{"text":"till lögnaktigt tal","poem":3},{"text":"får bara gudlösa tjänare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Den fattige och förtryckaren","poem":1},{"text":"lever sida vid sida","poem":3},{"noteId":134},{"text":",","poem":3},{"text":"Herren ger ljus åt bådas ögon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Den kung som dömer de fattiga rätt,","poem":1},{"text":"hans tron ska bestå för alltid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ris och tillrättavisning ger vishet,","poem":1},{"text":"men ett ouppfostrat barn","poem":2},{"text":"drar skam över sin mor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"När de gudlösa blir fler,","poem":1},{"text":"frodas synden,","poem":3},{"text":"men de rättfärdiga","poem":2},{"text":"ska se deras fall.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Fostra din son, så ger han dig ro","poem":1},{"text":"och ljuvlig lycka åt din själ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Utan uppenbarelsen","poem":1},{"text":"går folket vilse,","poem":3},{"text":"lycklig är den som tar vara","poem":2},{"text":"på Guds undervisning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ord fostrar ingen tjänare,","poem":1},{"text":"han förstår men fogar sig inte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ser du en man som talar förhastat?","poem":1},{"text":"Det är mer hopp om dåren","poem":2},{"text":"än om honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Om man skämmer bort sin tjänare","poem":1},{"text":"från hans ungdom","poem":3},{"text":"blir han till sist oregerlig","poem":2},{"noteId":135},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"En argsint man skapar gräl,","poem":1},{"text":"den hetlevrade förgår sig ofta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"En människas högmod","poem":1},{"text":"förödmjukar henne,","poem":3},{"text":"men den ödmjuke vinner ära.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Den som delar byte med en tjuv","poem":1},{"text":"hatar sitt eget liv,","poem":3},{"text":"han hör eden","poem":2},{"noteId":136},{"text":"men berättar inget.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Människofruktan blir en snara,","poem":1},{"text":"men den som förtröstar på Herren","poem":2},{"text":"blir beskyddad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Många söker en furstes ynnest,","poem":1},{"text":"men av Herren får var och en","poem":2},{"text":"sin rätt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"De rättfärdiga avskyr","poem":1},{"text":"den som gör orätt,","poem":3},{"text":"de gudlösa avskyr","poem":2},{"text":"den som lever rätt.","poem":3}]}],"footnotes":[{"noteId":131,"caller":"-","text":"blir flerAnnan översättning: ”frodas” (även i vers 16).","reference":{"chapter":29,"verse":2}},{"noteId":132,"caller":"-","text":"genom höga pålagorAnnan översättning: ”genom att ta mutor”.","reference":{"chapter":29,"verse":4}},{"noteId":133,"caller":"-","text":"vredeOrdagrant: ”ande”.","reference":{"chapter":29,"verse":11}},{"noteId":134,"caller":"-","text":"lever sida vid sidaOrdagrant: ”möts”.","reference":{"chapter":29,"verse":13}},{"noteId":135,"caller":"-","text":"oregerligGrundtexten svårtolkad.","reference":{"chapter":29,"verse":21}},{"noteId":136,"caller":"-","text":"edenKallelsen att vittna, med förbannelse över den som vittnar falskt under ed.","reference":{"chapter":29,"verse":24}}]},"thisChapterLink":"/api/swe_fol/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}