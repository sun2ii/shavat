{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Vishet och gudsfruktan hör ihop"]},{"type":"verse","number":1,"content":["Min son,",{"text":"glöm inte min undervisning,","poem":2},{"text":"bevara mina bud i ditt hjärta,","poem":3}]},{"type":"verse","number":2,"content":[{"text":"för de ska ge dig långt liv","poem":1},{"text":"och många levnadsår och frid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Låt inte godhet och sanning","poem":1},{"text":"lämna dig.","poem":3},{"text":"Bind dem runt din hals","poem":2},{"noteId":10},{"text":",","poem":2},{"text":"skriv dem på ditt hjärtas tavla,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"så finner du nåd och gott förstånd","poem":1},{"text":"i Guds och människors ögon.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Förtrösta på Herren","poem":1},{"text":"av hela ditt hjärta,","poem":3},{"text":"förlita dig inte på ditt förstånd.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Räkna med honom","poem":1},{"text":"på alla dina vägar,","poem":3},{"text":"så ska han jämna dina stigar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Var inte vis i dina egna ögon,","poem":1},{"text":"vörda Herren","poem":2},{"text":"och undvik det onda.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Det ska ge hälsa åt din kropp,","poem":1},{"text":"kraft åt alla dess ben.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ära Herren med vad du äger","poem":1},{"text":"och med det första","poem":2},{"text":"av all din gröda.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Då ska dina lador fyllas","poem":1},{"text":"av rika skördar","poem":3},{"text":"och dina pressar","poem":2},{"text":"flöda över av vin.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Min son,","poem":1},{"text":"förakta inte Herrens fostran","poem":3},{"text":"och förarga dig inte","poem":2},{"text":"när han tuktar dig,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"för den Herren älskar tuktar han","poem":1},{"text":"likt en far","poem":2},{"noteId":11},{"text":"den son han har kär.","poem":2}]},{"type":"heading","content":["Vishetens välsignelser"]},{"type":"verse","number":13,"content":[{"text":"Lycklig den människa","poem":1},{"text":"som funnit visheten,","poem":3},{"text":"den människa som får förstånd,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"för vishetens värde","poem":1},{"text":"är bättre än silvrets","poem":3},{"text":"och vinsten hon ger","poem":2},{"text":"är bättre än guld.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Hon är dyrbarare än pärlor,","poem":1},{"text":"ingen av dina skatter","poem":2},{"noteId":12},{"text":"kan jämföras med henne.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Långt liv har hon i sin högra hand,","poem":1},{"text":"i sin vänstra rikedom och ära.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hennes vägar är ljuvliga vägar,","poem":1},{"text":"alla hennes stigar är trygga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hon är ett livets träd","poem":1},{"noteId":13},{"text":"för dem som får tag i henne,","poem":3},{"text":"lyckliga är de","poem":2},{"text":"som håller fast vid henne.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Genom visheten har Herren","poem":1},{"text":"lagt jordens grund,","poem":3},{"text":"med förstånd har han","poem":2},{"text":"berett himlen.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Genom hans kunskap","poem":1},{"text":"bröt djupets vattenmassor fram","poem":3},{"text":"och molnen droppade av fukt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Min son,","poem":1},{"text":"bevara klokhet och omdöme,","poem":3},{"text":"låt dem inte vika från din blick.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"De ska ge liv åt din själ","poem":1},{"text":"och bli ett smycke för din hals.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Då ska du vandra trygg på din väg,","poem":1},{"text":"din fot ska inte slinta.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"När du lägger dig","poem":1},{"text":"ska inget skrämma dig,","poem":3},{"text":"och när du lagt dig","poem":2},{"text":"ska du sova gott.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Du behöver inte vara rädd","poem":1},{"text":"för plötslig fara","poem":3},{"text":"eller för stormen","poem":2},{"text":"som drabbar de gudlösa,","poem":3}]},{"type":"verse","number":26,"content":[{"text":"för Herren ska vara din trygghet","poem":1},{"text":"och bevara din fot för snaran.","poem":2}]},{"type":"heading","content":["Gör gott mot din nästa"]},{"type":"verse","number":27,"content":[{"text":"Neka inte en behövande något gott","poem":1},{"text":"när det står i din makt att hjälpa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Säg inte till din nästa:","poem":1},{"text":"”Kom tillbaka senare,","poem":2},{"text":"i morgon ska jag ge dig”,","poem":3},{"text":"när du har något nu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tänk inte ut något ont mot din nästa","poem":1},{"text":"som bor trygg i din närhet.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Gräla inte med någon utan orsak","poem":1},{"text":"när han inte har gjort dig","poem":2},{"text":"något ont.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Avundas inte en våldsam man","poem":1},{"text":"och välj inte någon av hans vägar,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"för Herren avskyr den som är falsk","poem":1},{"text":"men är förtrolig med de ärliga.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Herrens förbannelse vilar","poem":1},{"text":"över den gudlöses hus,","poem":3},{"text":"men han välsignar","poem":2},{"text":"de rättfärdigas hem.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Föraktare föraktar han","poem":1},{"noteId":14},{"text":",","poem":1},{"text":"men ger nåd åt de ödmjuka.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"De visa får ära till arvedel,","poem":1},{"text":"de dåraktiga får skam.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"-","text":"Bind dem runt din halsJfr påminnelsetecknen i 5 Mos 6:8, 4 Mos 15:38f.","reference":{"chapter":3,"verse":3}},{"noteId":11,"caller":"-","text":"likt en farAnnan översättning (så Septuaginta): ”och han agar”.","reference":{"chapter":3,"verse":12}},{"noteId":12,"caller":"-","text":"ingen av dina skatterAnnan översättning: ”inget du vill ha”.","reference":{"chapter":3,"verse":15}},{"noteId":13,"caller":"-","text":"livets trädSymbol för det eviga livet (1 Mos 3:22, Upp 22:2).","reference":{"chapter":3,"verse":18}},{"noteId":14,"caller":"-","text":"Föraktare föraktar hanSeptuaginta: ”Herren står emot de högmodiga”. Citeras så av Jakob i Jak 4:6 och av Petrus i 1 Petr 5:5.","reference":{"chapter":3,"verse":34}}]},"thisChapterLink":"/api/swe_fol/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}