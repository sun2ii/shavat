{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Agurs ord"]},{"type":"verse","number":1,"content":["Ord av Agur, Jakes son",{"noteId":137},", ett budskap",{"noteId":138},". Så talade den mannen till Itiel, till Itiel och Ukal",{"noteId":139},"."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jag är dummare än någon annan","poem":1},{"text":"och utan mänskligt förstånd.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jag har inte lärt mig vishet","poem":1},{"text":"så att jag har kunskap","poem":2},{"text":"om den Helige.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Vem har stigit upp till himlen","poem":1},{"text":"och kommit ner igen?","poem":3},{"text":"Vem har samlat vinden","poem":2},{"text":"i sina händer?","poem":3},{"text":"Vem har knutit in vattnet","poem":2},{"text":"i ett kläde?","poem":3},{"text":"Vem har fastställt","poem":2},{"text":"jordens alla gränser?","poem":3},{"text":"Vad heter han,","poem":2},{"text":"och vad heter hans son?","poem":3},{"text":"Du vet ju!","poem":4},{"noteId":140}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Allt Guds ord är rent från slagg,","poem":1},{"text":"han är en sköld","poem":2},{"text":"för dem som flyr till honom.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Lägg ingenting till hans ord,","poem":1},{"text":"så att han tillrättavisar dig för lögn.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Två saker ber jag dig om,","poem":1},{"text":"neka mig dem inte intill min död:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Håll falskhet och lögn ifrån mig.","poem":1},{"text":"Ge mig varken fattigdom","poem":2},{"text":"eller rikedom,","poem":3},{"text":"men ge mig den mat","poem":2},{"text":"jag behöver.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Annars kan jag bli så mätt","poem":1},{"text":"att jag förnekar dig och säger:","poem":2},{"text":"”Vem är Herren?”","poem":3},{"text":"eller så fattig att jag stjäl","poem":2},{"text":"och vanhelgar min Guds namn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Förtala inte en tjänare","poem":1},{"text":"inför hans herre,","poem":3},{"text":"så att han förbannar dig","poem":2},{"text":"och du står där med skuld.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Det finns ett släkte","poem":1},{"text":"som förbannar sin far","poem":3},{"text":"och inte välsignar sin mor,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ett släkte som är rent i egna ögon","poem":1},{"text":"men som inte har tvättat bort","poem":2},{"text":"sin smuts,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ett släkte med så stolta ögon","poem":1},{"text":"och högmodiga blickar,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ett släkte vars tänder är svärd","poem":1},{"text":"och vars käftar är knivar,","poem":3},{"text":"för att äta de svaga ur landet","poem":2},{"text":"och de fattiga","poem":3},{"text":"ur människornas krets.","poem":4}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Blodigeln har två döttrar:","poem":1},{"text":"”Ge” och ”Ge”.","poem":3},{"text":"Det finns tre som inte kan mättas,","poem":2},{"text":"fyra som aldrig säger: ”Nog!”:","poem":3}]},{"type":"verse","number":16,"content":[{"text":"dödsriket,","poem":1},{"text":"ett ofruktsamt moderliv,","poem":3},{"text":"jorden som aldrig","poem":2},{"text":"blir mätt på vatten","poem":3},{"text":"och elden som aldrig säger:","poem":2},{"text":"”Nog!”.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Det öga som hånar en far","poem":1},{"text":"och vägrar lyda en mor","poem":3},{"text":"ska korparna vid bäcken hacka ut","poem":2},{"text":"och örnens ungar äta upp.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tre ting är förunderliga för mig,","poem":1},{"text":"fyra kan jag inte förstå:","poem":3}]},{"type":"verse","number":19,"content":[{"text":"örnens väg på himlen,","poem":1},{"text":"ormens väg över klippan,","poem":3},{"text":"skeppets väg ute på havet","poem":2},{"text":"och mannens väg hos jungfrun.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Så gör äktenskapsbryterskan:","poem":1},{"text":"Hon äter och torkar sig","poem":2},{"text":"om munnen","poem":3},{"text":"och säger: ”Jag har inte gjort","poem":2},{"text":"något fel.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tre ting får jorden att skaka,","poem":1},{"text":"fyra kan den inte uthärda:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"en slav som blir kung,","poem":1},{"text":"en dåre som frossar i mat,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"en avskyvärd","poem":1},{"noteId":141},{"text":"kvinna","poem":1},{"text":"som blir gift","poem":3},{"text":"och en tjänstekvinna","poem":2},{"text":"som tränger undan sin husmor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Fyra finns som är små på jorden,","poem":1},{"text":"ändå är de visast bland de visa:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"myrorna är inget starkt släkte,","poem":1},{"text":"men de skaffar sin föda","poem":2},{"text":"om sommaren,","poem":3}]},{"type":"verse","number":26,"content":[{"text":"klippgrävlingarna","poem":1},{"text":"är inget kraftfullt släkte,","poem":3},{"text":"men de bygger sitt bo","poem":2},{"text":"i klippan,","poem":3}]},{"type":"verse","number":27,"content":[{"text":"gräshopporna","poem":1},{"noteId":142},{"text":"har ingen kung,","poem":1},{"text":"men de drar alla ut","poem":2},{"text":"i härordning,","poem":3}]},{"type":"verse","number":28,"content":[{"text":"geckoödlan kan gripas","poem":1},{"noteId":143},{"text":"med händerna,","poem":3},{"text":"ändå finns den","poem":2},{"text":"i kungapalats.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Tre finns som skrider","poem":1},{"text":"ståtligt fram,","poem":3},{"text":"fyra som har ståtlig gång:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"lejonet, hjälten bland djuren","poem":1},{"text":"som inte viker för någon,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"en stoltserande tupp","poem":1},{"noteId":144},{"text":", en bock","poem":1},{"text":"och en kung i spetsen","poem":2},{"text":"för sitt folk.","poem":3}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Har du varit dåraktig","poem":1},{"text":"och upphöjt dig själv","poem":3},{"text":"eller tänkt onda tankar","poem":2},{"noteId":145},{"text":",","poem":2},{"text":"så lägg handen på munnen.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"För som ost pressas ur mjölk","poem":1},{"text":"och blod pressas ur näsan,","poem":3},{"text":"så pressas strid ur vrede.","poem":2}]}],"footnotes":[{"noteId":137,"caller":"-","text":"Agur, Jakes sonBetyder möjligen ”samlare, lydig(s) son” (jfr 10:5).","reference":{"chapter":30,"verse":1}},{"noteId":138,"caller":"-","text":"ett budskapAnnan översättning: ”från Massa” (se not till 31:1).","reference":{"chapter":30,"verse":1}},{"noteId":139,"caller":"-","text":"till Itiel, till Itiel och UkalNamn som kan översättas: ”Gud är med mig” och ”jag klarar det”. Orden kan också förstås som inledning till Agurs ord: ”Jag är trött, Gud, jag är trött, Gud, men jag klarar det” (alternativt ”och jag är slut”).","reference":{"chapter":30,"verse":1}},{"noteId":140,"caller":"-","text":"Du vet ju!Annan översättning: ”Vet du det?”","reference":{"chapter":30,"verse":4}},{"noteId":141,"caller":"-","text":"avskyvärdAnnan översättning: ”avskydd”, ”ratad”.","reference":{"chapter":30,"verse":23}},{"noteId":142,"caller":"-","text":"gräshoppornaKunde härja länder i miljonstarka svärmar (jfr 2 Mos 10:4f, Joel 1:4f, Upp 9:3f).","reference":{"chapter":30,"verse":27}},{"noteId":143,"caller":"-","text":"kan gripasAnnan översättning: ”griper sig fast”.","reference":{"chapter":30,"verse":28}},{"noteId":144,"caller":"-","text":"stoltserande tuppGrundtexten svårtolkad. Annan översättning: ”en stridsrustad häst”.","reference":{"chapter":30,"verse":31}},{"noteId":145,"caller":"-","text":"tänkt onda tankarAnnan översättning: ”gjort det med avsikt” (upphöjt sig själv).","reference":{"chapter":30,"verse":32}}]},"thisChapterLink":"/api/swe_fol/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}