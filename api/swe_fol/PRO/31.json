type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ge starka drycker","poem":1},{"text":"åt den som är döende","poem":3},{"noteId":148},{"text":"och vin åt plågade","poem":2},{"noteId":149},{"text":"själar.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Låt dem dricka","poem":1},{"text":"och glömma sin fattigdom","poem":3},{"text":"och sluta tänka på sitt elände.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Öppna din mun för den stumme","poem":1},{"text":"och försvara alla värnlösa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Öppna din mun och döm rättfärdigt,","poem":1},{"text":"skaffa den svage","poem":2},{"text":"och fattige rätt.","poem":3}]},{"type":"heading","content":["Hyllning till en driftig hustru31:9 Denna lovprisning till den driftiga hustrun är en alfabetisk sång. Verserna börjar i tur och ordning med det hebreiska alfabetets 22 konsonanter."]},{"type":"verse","number":10,"content":[{"text":"Vem kan finna","poem":1},{"text":"en driftig","poem":3},{"noteId":150},{"text":"hustru?","poem":3},{"text":"Långt mer än pärlor är hon värd.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hennes mans hjärta litar på henne","poem":1},{"text":"och han saknar ingenting.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hon gör honom gott, aldrig ont,","poem":1},{"text":"i alla sina livsdagar.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Omsorg har hon om ull och lin","poem":1},{"noteId":151},{"text":",","poem":1},{"text":"och hennes händer","poem":2},{"text":"arbetar med lust.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Hon är som köpmannens skepp,","poem":1},{"text":"hon hämtar sin mat fjärran ifrån.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"När det ännu är natt går hon upp","poem":1},{"text":"och sätter fram mat åt familjen,","poem":2},{"text":"portioner","poem":3},{"noteId":152},{"text":"åt tjänarinnorna.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Hon har planer på en åker","poem":1},{"text":"och köper den,","poem":3},{"text":"hon planterar en vingård","poem":2},{"text":"med vad hennes händer tjänat.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Hon fäster ivrigt upp sina kläder","poem":1},{"noteId":153},{"text":"och går till verket","poem":2},{"text":"med starka armar.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Hon märker","poem":1},{"text":"att hennes arbete går bra,","poem":3},{"text":"hennes lampa släcks inte","poem":2},{"text":"om natten.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Hon sträcker händerna","poem":1},{"text":"mot spinnrocken,","poem":3},{"text":"och fingrarna fattar om sländan.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"För den betryckte","poem":1},{"text":"öppnar hon sin hand,","poem":3},{"text":"hon räcker ut sina armar","poem":2},{"text":"mot den fattige.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Hon oroar sig inte för sin familj","poem":1},{"text":"när vintern kommer,","poem":3},{"text":"för alla i huset är klädda","poem":2},{"text":"i scharlakansröd","poem":3},{"noteId":154},{"text":"ull.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Täcken gör hon åt sig,","poem":1},{"text":"hon är klädd i finaste linne","poem":2},{"text":"och purpur","poem":3},{"noteId":155},{"text":".","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Hennes man är känd","poem":1},{"text":"i stadens portar","poem":3},{"text":"där han sitter bland landets äldste.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Linneskjortor gör hon och säljer,","poem":1},{"text":"köpmännen förser hon","poem":2},{"text":"med bälten.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Kraft och värdighet","poem":1},{"text":"är hennes klädnad,","poem":3},{"text":"och hon ler mot dagen som kommer.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hon öppnar sin mun med vishet","poem":1},{"text":"och har vänlig förmaning","poem":2},{"noteId":156},{"text":"på sin tunga.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Hon vakar över ordningen i sitt hem","poem":1},{"text":"och äter inte lättjans bröd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Hennes barn står upp","poem":1},{"text":"och lovordar henne,","poem":3},{"text":"och hennes man berömmer henne:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"”Många kvinnor har gjort storverk,","poem":1},{"text":"men du överträffar dem alla.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Charm är bedräglig","poem":1},{"text":"och skönhet förgänglig,","poem":3},{"text":"men prisas ska den kvinna","poem":2},{"text":"som vördar Herren.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Låt henne få njuta frukten","poem":1},{"text":"av sitt arbete,","poem":3},{"text":"och må hennes gärningar","poem":2},{"text":"prisa henne i portarna.","poem":3}]}],"footnotes":[{"noteId":146,"caller":"-","text":"det budskapAnnan översättning: ”av Massa” (nordarabiskt stamrike, jfr 1 Mos 25:14). Hebr. massá används annars normalt om inspirerade profetord (t ex Nah 1:1, Hagg 1:1).","reference":{"chapter":31,"verse":1}},{"noteId":147,"caller":"-","text":"kraftAnnan översättning: ”rikedom”.","reference":{"chapter":31,"verse":3}},{"noteId":148,"caller":"-","text":"Ge starka drycker åt den som är döendeUtifrån denna vers bekostade Jerusalems kvinnor på Jesu tid ett bedövningsmedel för dem som skulle avrättas (Matt 27:34 med not).","reference":{"chapter":31,"verse":6}},{"noteId":149,"caller":"-","text":"plågadeAnnan översättning: ”bedrövade”, ”bittra”, ”arga”.","reference":{"chapter":31,"verse":6}},{"noteId":150,"caller":"-","text":"driftigAnnan översättning: ”kraftfull”, ”ädel”.","reference":{"chapter":31,"verse":10}},{"noteId":151,"caller":"-","text":"ull och linTextilarbete var under antiken kvinn