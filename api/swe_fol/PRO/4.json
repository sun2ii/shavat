{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Vishetens storhet"]},{"type":"verse","number":1,"content":["Lyssna, barn,",{"text":"till er fars förmaning,","poem":3},{"text":"ta vara på den så att ni får förstånd.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"God lärdom ger jag er,","poem":1},{"text":"överge inte min undervisning.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"För jag har själv varit barn","poem":1},{"text":"och haft en far,","poem":3},{"text":"varit liten och min mors ende son.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Då undervisade han mig","poem":1},{"text":"och sade till mig:","poem":3},{"text":"Låt ditt hjärta hålla fast","poem":2},{"text":"vid mina ord.","poem":3},{"text":"Bevara mina bud, så får du leva.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vinn vishet, vinn förstånd!","poem":1},{"text":"Glöm inte vad min mun har sagt","poem":2},{"text":"och vik inte av från det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Överge inte visheten,","poem":1},{"text":"så ska hon bevara dig.","poem":3},{"text":"Älska henne,","poem":2},{"text":"så ska hon skydda dig.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Visheten är det viktigaste.","poem":1},{"noteId":15},{"text":"Vinn vishet, vinn förstånd","poem":2},{"text":"med allt du äger.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Håll henne högt,","poem":1},{"text":"så ska hon upphöja dig.","poem":3},{"text":"Hon ger dig ära","poem":2},{"text":"när du omfamnar henne.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"En skön krans","poem":1},{"text":"ska hon sätta på ditt huvud,","poem":3},{"text":"en ärekrona ska hon räcka dig.","poem":2}]},{"type":"heading","content":["Ljusets och mörkrets väg"]},{"type":"verse","number":10,"content":[{"text":"Hör, min son,","poem":1},{"text":"ta emot mina ord,","poem":3},{"text":"så blir dina levnadsår många.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jag lär dig vishetens väg,","poem":1},{"text":"jag leder dig på rätta stigar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"När du går","poem":1},{"text":"ska inget hindra dina steg,","poem":3},{"text":"när du springer","poem":2},{"text":"ska du inte snava.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Håll fast vid min förmaning,","poem":1},{"text":"släpp den inte.","poem":3},{"text":"Bevara den, för den är ditt liv.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Gå inte in på de gudlösas stig,","poem":1},{"text":"vandra inte på de ondas väg.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Undvik den, gå inte in på den,","poem":1},{"text":"vik av från den och gå förbi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"De kan inte sova","poem":1},{"text":"om de inte fått göra något ont,","poem":3},{"text":"de mister sin sömn","poem":2},{"text":"om de inte fått någon på fall,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"för de äter ondskans bröd","poem":1},{"text":"och dricker våldets vin.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"De rättfärdigas stig","poem":1},{"text":"är som gryningens ljus,","poem":3},{"text":"som växer i klarhet","poem":2},{"text":"tills dagen når sin höjd.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Men de gudlösas väg","poem":1},{"text":"är som djupaste mörker,","poem":3},{"text":"de märker inte","poem":2},{"text":"vad som blir deras fall.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Min son,","poem":1},{"text":"ta vara på vad jag säger,","poem":3},{"text":"vänd ditt öra till mina ord.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Låt dem inte vika från din blick,","poem":1},{"text":"bevara dem i ditt hjärtas djup,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"för de är liv för den som finner dem","poem":1},{"text":"och läkedom för hela hans kropp.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mer än allt som ska bevaras,","poem":1},{"text":"bevara ditt hjärta","poem":3},{"noteId":16},{"text":",","poem":3},{"text":"för därifrån utgår livet.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Gör dig fri från munnens falskhet,","poem":1},{"text":"låt läpparnas svek","poem":2},{"text":"vara fjärran från dig.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Låt dina ögon se rakt fram,","poem":1},{"text":"rikta din blick rakt framför dig.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tänk på","poem":1},{"noteId":17},{"text":"stigen","poem":1},{"text":"där din fot går fram,","poem":3},{"text":"låt alla dina vägar vara rätta.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Vik inte av åt höger eller vänster,","poem":1},{"text":"håll din fot borta från det onda.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"-","text":"Visheten är det viktigaste.Annan översättning: ”Vishetens början är:”.","reference":{"chapter":4,"verse":7}},{"noteId":16,"caller":"-","text":"hjärtaStår i Bibeln för hela den inre människan, tanken lika väl som känslan (16:9, 24:2).","reference":{"chapter":4,"verse":23}},{"noteId":17,"caller":"-","text":"Tänk på ... rättaAnnan översättning: ”Jämna ... stadiga”.","reference":{"chapter":4,"verse":26}}]},"thisChapterLink":"/api/swe_fol/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}