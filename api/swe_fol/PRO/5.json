{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["Varning för sexuell omoral"]},{"type":"verse","number":1,"content":["Min son, lyssna till min vishet,",{"text":"vänd ditt öra till min klokhet,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"så att du tar vara på gott omdöme","poem":1},{"text":"och dina läppar bevarar kunskapen.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"För en trolös kvinnas läppar","poem":1},{"text":"dryper av honung,","poem":3},{"text":"hennes mun är halare än olja,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"men till sist blir hon","poem":1},{"text":"bitter som malört,","poem":3},{"text":"vass som ett tveeggat svärd.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hennes fötter styr ner mot döden,","poem":1},{"text":"till dödsriket drar hennes steg.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"På livets väg tänker hon inte,","poem":1},{"text":"hennes stigar leder vilse","poem":2},{"text":"utan att hon märker det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lyssna nu på mig, barn,","poem":1},{"text":"vik inte bort från min muns ord.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Låt din väg gå långt från henne,","poem":1},{"text":"kom inte nära dörren","poem":2},{"text":"till hennes hus.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Annars får du ge din kraft åt andra,","poem":1},{"text":"dina år åt en grym herre.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Främlingar mättar sig","poem":1},{"text":"av din rikedom","poem":3},{"noteId":18},{"text":"och ditt arbetes frukt hamnar","poem":2},{"text":"i en annans hus.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Till slut ska du sucka,","poem":1},{"text":"när din kropp och ditt hull","poem":2},{"text":"tynar bort,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"och säga:","poem":1},{"text":"”Hur kunde jag hata förmaning,","poem":3},{"text":"hur kunde mitt hjärta","poem":2},{"text":"förakta tillrättavisning!","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Varför lyssnade jag inte","poem":1},{"text":"till mina lärares röst?","poem":3},{"text":"Varför vände jag inte mitt öra","poem":2},{"text":"till dem som undervisade mig?","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Hur nära var det inte","poem":1},{"text":"att jag drabbades","poem":3},{"noteId":19},{"text":"av allt ont","poem":3},{"text":"mitt i den samlade församlingen!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Drick vatten ur din egen brunn,","poem":1},{"text":"det som rinner ur din egen källa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ska dina källor","poem":1},{"text":"rinna ut på gatan,","poem":3},{"text":"dina vattenbäckar på torgen?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nej, de ska tillhöra dig, bara dig,","poem":1},{"text":"och inga främlingar jämte dig.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Må din källa vara välsignad,","poem":1},{"text":"och gläd dig över","poem":2},{"text":"din ungdoms hustru,","poem":3}]},{"type":"verse","number":19,"content":[{"text":"den älskliga hinden,","poem":1},{"text":"den sköna gasellen.","poem":3},{"text":"Låt hennes bröst","poem":2},{"text":"alltid tillfredsställa dig,","poem":3},{"text":"hennes kärlek ständigt berusa dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Min son, varför låta dig berusas","poem":1},{"text":"av en främmande kvinna","poem":3},{"text":"och famna en som inte är din?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Inför Herrens ögon","poem":1},{"text":"är människans vägar uppenbara,","poem":3},{"text":"han betraktar alla hennes steg.","poem":2},{"noteId":20}]},{"type":"verse","number":22,"content":[{"text":"Den gudlöse fångas","poem":1},{"text":"av sina egna missgärningar","poem":3},{"text":"och fastnar i sina synders snaror.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Han dör av brist på förmaning,","poem":1},{"text":"i sin stora dårskap går han vilse.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"-","text":"rikedomAnnan översättning: ”styrka”.","reference":{"chapter":5,"verse":10}},{"noteId":19,"caller":"-","text":"Hur nära var det inte att jag drabbadesAnnan översättning: ”Snart drabbades jag”.","reference":{"chapter":5,"verse":14}},{"noteId":20,"caller":"-","text":"stegAnnan översättning: ”hjulspår”.","reference":{"chapter":5,"verse":21}}]},"thisChapterLink":"/api/swe_fol/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}