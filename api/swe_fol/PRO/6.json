{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Varning för olika slags dårskap"]},{"type":"verse","number":1,"content":["Min son, har du gått i borgen",{"text":"för din nästa","poem":3},{"text":"och gett ditt handslag","poem":2},{"text":"åt en främling?","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Har du blivit snärjd av dina ord","poem":1},{"text":"och fångad av vad din mun","poem":2},{"text":"har sagt?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Gör då så här, min son,","poem":1},{"text":"för att rädda dig när du hamnat","poem":2},{"text":"i din nästas våld:","poem":3},{"text":"Gå och ödmjuka dig","poem":2},{"text":"och ge honom ingen ro,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"unna inte dina ögon någon sömn","poem":1},{"text":"eller dina ögonlock en blund,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"rädda dig som en gasell","poem":1},{"text":"ur hans grepp","poem":3},{"text":"och en fågel ur jägarens våld.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gå till myran, du late,","poem":1},{"text":"se hur hon gör och bli vis.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hon har varken furste,","poem":1},{"text":"förman eller herre,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"men hon skaffar sin föda","poem":1},{"text":"om sommaren","poem":3},{"text":"och samlar sin mat","poem":2},{"text":"under skördetiden.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Hur länge ska du ligga, du late?","poem":1},{"text":"När ska du resa dig","poem":2},{"text":"ur din sömn?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Sov lite till, slumra lite till,","poem":1},{"text":"ligg lite till med armarna i kors,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"så kommer fattigdomen över dig","poem":1},{"text":"som en rövare","poem":3},{"noteId":21},{"text":"och nöden som en beväpnad man.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"En fördärvad människa,","poem":1},{"text":"en ond man","poem":3},{"text":"är den som går","poem":2},{"text":"med falskhet i sin mun,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"som blinkar med ögonen,","poem":1},{"text":"skrapar med foten,","poem":3},{"text":"gör tecken med fingrarna.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Han har svek i sitt hjärta,","poem":1},{"text":"han smider ständigt onda planer","poem":2},{"text":"och skapar gräl.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Därför kommer hans olycka","poem":1},{"text":"med hast,","poem":3},{"text":"han krossas plötsligt utan räddning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Sex saker är det som Herren hatar,","poem":1},{"text":"sju som han avskyr:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"stolta ögon, en falsk tunga,","poem":1},{"text":"händer som spiller oskyldigt blod,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ett hjärta som smider onda planer,","poem":1},{"text":"fötter som skyndar","poem":2},{"text":"till det som är ont,","poem":3}]},{"type":"verse","number":19,"content":[{"text":"ett falskt vittne som främjar lögn","poem":1},{"text":"och den som skapar gräl","poem":2},{"text":"mellan bröder.","poem":3}]},{"type":"heading","content":["Varning för äktenskapsbrott"]},{"type":"verse","number":20,"content":[{"text":"Min son, håll fast vid din fars bud","poem":1},{"text":"och förkasta inte","poem":2},{"text":"din mors undervisning.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Bär dem alltid","poem":1},{"text":"bundna vid ditt hjärta,","poem":3},{"text":"fäst dem vid din hals.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Låt dem leda dig när du går,","poem":1},{"text":"vaka över dig när du ligger","poem":2},{"text":"och tala till dig när du vaknar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Budet är en lykta","poem":1},{"text":"och undervisningen ett ljus,","poem":3},{"text":"förmanande tillrättavisning","poem":2},{"text":"är en väg till livet.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"De ska bevara dig","poem":1},{"text":"från den onda kvinnan","poem":3},{"noteId":22},{"text":",","poem":3},{"text":"från den främmandes hala tunga.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ha inte begär i ditt hjärta","poem":1},{"text":"till hennes skönhet","poem":3},{"text":"och låt henne inte fånga dig","poem":2},{"text":"med sina blickar,","poem":3}]},{"type":"verse","number":26,"content":[{"text":"för en prostituerad","poem":1},{"text":"kan ta din sista brödbit,","poem":3},{"text":"men en gift kvinna","poem":2},{"text":"jagar din dyrbara själ","poem":3},{"noteId":23},{"text":".","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Kan man bära eld i sin famn","poem":1},{"text":"utan att kläderna blir brända?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Eller kan man gå på glödande kol","poem":1},{"text":"utan att fötterna blir svedda?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Så går det den","poem":1},{"text":"som går in till sin nästas hustru,","poem":3},{"text":"ingen som rör henne","poem":2},{"text":"blir ostraffad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Föraktar man inte","poem":1},{"noteId":24},{"text":"tjuven som stjäl","poem":1},{"text":"för att äta sig mätt","poem":2},{"text":"när han är hungrig?","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Blir han ertappad","poem":1},{"text":"får han betala sjufalt","poem":3},{"noteId":25},{"text":"och ge ifrån sig allt han har","poem":2},{"text":"i sitt hus.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Den som begår äktenskapsbrott","poem":1},{"text":"saknar vett,","poem":3},{"text":"den som gör så fördärvar sitt liv.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Plåga och skam är vad han vinner,","poem":1},{"text":"hans vanära utplånas aldrig,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"för mannens vrede är svartsjuk,","poem":1},{"text":"han skonar inte på hämndens dag.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Han tar inte emot","poem":1},{"text":"några försoningsgåvor,","poem":3},{"text":"han bryr sig inte om","poem":2},{"text":"dina stora mutor.","poem":3}]}],"footnotes":[{"noteId":21,"caller":"-","text":"rövareAnnan översättning: ”lösdrivare”.","reference":{"chapter":6,"verse":11}},{"noteId":22,"caller":"-","text":"den onda kvinnanAnnan översättning: ”din nästas hustru”.","reference":{"chapter":6,"verse":24}},{"noteId":23,"caller":"-","text":"jagar din dyrbara själÄktenskapsbrott är en synd som straffades med döden (5 Mos 22:22).","reference":{"chapter":6,"verse":26}},{"noteId":24,"caller":"-","text":"Föraktar man inteAnnan översättning: ”Man föraktar inte”.","reference":{"chapter":6,"verse":30}},{"noteId":25,"caller":"-","text":"sjufaltSymbolisk förstärkning (jfr Matt 18:21). Tjuvar bötade normalt mindre än så (jfr Luk 19:8).","reference":{"chapter":6,"verse":31}}]},"thisChapterLink":"/api/swe_fol/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}