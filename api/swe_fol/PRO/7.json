{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Ytterligare varning för omoral"]},{"type":"verse","number":1,"content":["Min son, ta vara på mina ord",{"text":"och göm mina bud inom dig.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Håll mina bud så får du leva,","poem":1},{"text":"bevara min undervisning","poem":2},{"text":"som din ögonsten.","poem":3},{"noteId":26}]},{"type":"verse","number":3,"content":[{"text":"Bind dem runt dina fingrar,","poem":1},{"text":"skriv dem på ditt hjärtas tavla.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Säg till visheten:","poem":1},{"text":"”Du är min syster”","poem":3},{"text":"och kalla insikten din förtrogna.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"De ska bevara dig","poem":1},{"text":"från den främmande kvinnan,","poem":3},{"text":"från din nästas hustru","poem":2},{"text":"som talar hala ord.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"När jag spanade ut","poem":1},{"text":"genom fönstret i mitt hus,","poem":2},{"text":"genom gallret,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"då såg jag bland de okunniga,","poem":1},{"text":"bland de unga upptäckte jag","poem":2},{"text":"en yngling utan vett.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Han gick över gatan","poem":1},{"text":"vid hörnet där hon bodde","poem":3},{"text":"och styrde sina steg","poem":2},{"text":"mot hennes hus.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Det var i skymningen,","poem":1},{"text":"vid dagens slut,","poem":3},{"text":"när nattens mörker föll på.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Då mötte honom en kvinna,","poem":1},{"text":"klädd som en prostituerad","poem":2},{"text":"och med dolda avsikter.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Rastlös och trotsig var hon,","poem":1},{"text":"hennes fötter hade ingen ro","poem":2},{"text":"där hemma –","poem":3}]},{"type":"verse","number":12,"content":[{"text":"än på gatan, än på torgen,","poem":1},{"text":"vid varje gathörn","poem":2},{"noteId":27},{"text":"stod hon på lur.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hon grep honom och kysste honom,","poem":1},{"text":"med fräck uppsyn","poem":2},{"text":"sade hon till honom:","poem":3}]},{"type":"verse","number":14,"content":[{"text":"”Jag har kött från gemenskapsoffer,","poem":1},{"noteId":28},{"text":"i dag uppfyllde jag mina löften.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Därför gick jag ut för att möta dig,","poem":1},{"text":"jag sökte dig och fann dig.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jag har bäddat min säng","poem":1},{"text":"med sköna täcken,","poem":3},{"text":"med färggrant linne från Egypten.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jag har parfymerat min bädd","poem":1},{"text":"med myrra, aloe och kanel.","poem":2},{"noteId":29}]},{"type":"verse","number":18,"content":[{"text":"Kom, nu ska vi njuta av kärlek","poem":1},{"text":"ända till morgonen,","poem":3},{"text":"njuta tillsammans","poem":2},{"text":"av kärlekens fröjder.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"För min man är inte hemma,","poem":1},{"text":"han har rest långt bort.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Han tog med sig en påse pengar,","poem":1},{"text":"först vid fullmåne","poem":2},{"text":"kommer han hem.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hon förleder honom","poem":1},{"text":"med allt sitt prat,","poem":3},{"text":"förför honom med hala läppar.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Han följer genast efter henne","poem":1},{"text":"som oxen går bort för att slaktas,","poem":2},{"text":"som fången för att straffas","poem":3},{"text":"för sin dårskap,","poem":4},{"noteId":30}]},{"type":"verse","number":23,"content":[{"text":"tills pilen genomborrar hans lever.","poem":1},{"text":"Han liknar fågeln","poem":2},{"text":"som skyndar in i snaran","poem":3},{"text":"utan att förstå","poem":2},{"text":"att det gäller livet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Så hör mig nu, ni barn,","poem":1},{"text":"lyssna på mina ord.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Låt inte ditt hjärta vika av","poem":1},{"text":"till hennes vägar,","poem":3},{"text":"förirra dig inte in på hennes stigar,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"för hon har fällt många","poem":1},{"text":"som ligger slagna,","poem":3},{"text":"otaliga är hennes offer.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Hennes hus är vägen","poem":1},{"text":"till dödsriket,","poem":3},{"text":"det leder ner","poem":2},{"text":"till dödens kammare.","poem":3}]}],"footnotes":[{"noteId":26,"caller":"-","text":"din ögonstenOrdagrant: ”den lille mannen i ditt öga”, alltså den känsliga pupillen.","reference":{"chapter":7,"verse":2}},{"noteId":27,"caller":"-","text":"vid varje gathörnEn möjlig koppling till fruktbarhetsaltaren (se 2 Krön 28:24 med not).","reference":{"chapter":7,"verse":12}},{"noteId":28,"caller":"-","text":"har kött från gemenskapskapsofferSe 3 Mos 3:1f med not. Annan översättning: ”var skyldig ett gemenskapsoffer”. Den som bad kunde lova att bära fram ett offer (se t ex Jona 2:10).","reference":{"chapter":7,"verse":14}},{"noteId":29,"caller":"-","text":"linne från Egypten … myrra, aloe och kanelImporterade lyxvaror (jfr Hes 27:7, 22).","reference":{"chapter":7,"verse":17}},{"noteId":30,"caller":"-","text":"fången för att straffas för sin dårskapAndra handskrifter (Septuaginta): ”hjorten hoppar i snaran”.","reference":{"chapter":7,"verse":22}}]},"thisChapterLink":"/api/swe_fol/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}