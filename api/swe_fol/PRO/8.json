{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Visheten berättar om sig själv"]},{"type":"verse","number":1,"content":["Hör, visheten ropar",{"text":"och förståndet höjer sin röst!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hon står uppe på höjderna,","poem":1},{"text":"vid vägen där stigarna möts.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vid portarna in till staden,","poem":1},{"text":"vid ingångarna höjer hon sitt rop:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Till er, ni män, ropar jag,","poem":1},{"text":"min röst går ut","poem":2},{"text":"till människors barn.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ni som är okunniga,","poem":1},{"text":"lär er klokhet!","poem":3},{"text":"Ni dårar, lär er förstånd!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lyssna, för jag talar","poem":1},{"text":"om ädla ting","poem":3},{"noteId":31},{"text":",","poem":3},{"text":"från mina läppar kommer","poem":2},{"text":"det som är rätt.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ja, min mun talar sanning,","poem":1},{"text":"mina läppar avskyr gudlöshet.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Min muns alla ord är rättfärdiga,","poem":1},{"text":"i dem finns inget falskt","poem":2},{"text":"eller förvridet.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Allihop är rätta för den förståndige","poem":1},{"text":"och raka för dem","poem":2},{"text":"som har funnit kunskap.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ta emot min förmaning","poem":1},{"text":"hellre än silver","poem":3},{"text":"och kunskap hellre än rent guld,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"för visheten är bättre än pärlor,","poem":1},{"text":"inga skatter kan jämföras","poem":2},{"text":"med henne.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jag, visheten, bor hos klokheten,","poem":1},{"text":"jag har kunskap","poem":2},{"text":"och gott omdöme.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Att vörda Herren","poem":1},{"text":"är att hata det onda.","poem":3},{"text":"Högfärd, högmod,","poem":2},{"text":"ond väg och falsk mun,","poem":3},{"text":"det hatar jag.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Hos mig finns råd och insikt","poem":1},{"noteId":32},{"text":".","poem":1},{"text":"Jag är förstånd,","poem":2},{"text":"hos mig finns makt.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Genom mig regerar kungar","poem":1},{"text":"och stiftar furstar rätta lagar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Genom mig styr härskare","poem":1},{"text":"och hövdingar,","poem":3},{"text":"alla domare på jorden","poem":2},{"noteId":33},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Jag älskar dem som älskar mig,","poem":1},{"text":"och de som söker mig","poem":2},{"text":"ska finna mig.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Rikedom och ära finns hos mig,","poem":1},{"text":"bestående","poem":2},{"noteId":34},{"text":"skatter","poem":2},{"text":"och rättfärdighet.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Min frukt är bättre än guld,","poem":1},{"text":"än finaste guld,","poem":3},{"text":"min skörd är bättre än utvalt silver.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Jag vandrar på rättfärdighetens väg,","poem":1},{"text":"mitt på det rättas stigar,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"för att ge rikedom i arv","poem":1},{"text":"åt dem som älskar mig","poem":3},{"text":"och fylla deras förråd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Herren hade","poem":1},{"noteId":35},{"text":"mig","poem":1},{"text":"vid begynnelsen av sin väg,","poem":3},{"text":"före sina gärningar i urtiden.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Av evighet är jag insatt,","poem":1},{"text":"från begynnelsen,","poem":2},{"text":"innan jorden fanns.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Innan djupen blev till föddes jag,","poem":1},{"text":"innan källorna flödade av vatten.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Innan bergen grundades,","poem":1},{"text":"innan höjderna fanns föddes jag,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"innan han gjort land och fält","poem":1},{"text":"och jordens första stoft.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"När han beredde himlen","poem":1},{"text":"var jag där,","poem":3},{"text":"när han välvde ett valv","poem":2},{"noteId":36},{"text":"över djupen,","poem":3}]},{"type":"verse","number":28,"content":[{"text":"när han fäste skyarna där uppe","poem":1},{"text":"och djupets källor bröt fram","poem":2},{"text":"med kraft,","poem":3}]},{"type":"verse","number":29,"content":[{"text":"när han satte en gräns för havet","poem":1},{"text":"och vattnet stannade","poem":2},{"text":"där han befallt,","poem":3},{"text":"när han lade jordens grund,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"då var jag verksam","poem":1},{"noteId":37},{"text":"vid hans sida.","poem":3},{"text":"Jag var hans glädje dag efter dag,","poem":2},{"text":"ständigt jublande","poem":3},{"noteId":38},{"text":"inför honom.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Jag jublade över hela hans värld","poem":1},{"text":"och hade min glädje","poem":2},{"text":"hos människors barn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Så lyssna nu till mig, mina barn.","poem":1},{"text":"Saliga är de som följer mina vägar.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Lyssna till förmaning och bli visa,","poem":1},{"text":"förkasta den inte.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Salig är den människa","poem":1},{"text":"som lyssnar till mig,","poem":3},{"text":"som vakar vid mina dörrar","poem":2},{"text":"dag efter dag","poem":3},{"text":"och håller vakt","poem":2},{"text":"vid mina dörrposter,","poem":3}]},{"type":"verse","number":35,"content":[{"text":"för den som finner mig finner livet","poem":1},{"text":"och får nåd från Herren.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Men den som syndar mot mig","poem":1},{"text":"skadar sin själ,","poem":3},{"text":"alla som hatar mig älskar döden.","poem":2}]}],"footnotes":[{"noteId":31,"caller":"-","text":"ädla tingAnnan översättning: ”det som stämmer” (jfr 1 Mos 2:18 med not).","reference":{"chapter":8,"verse":6}},{"noteId":32,"caller":"-","text":"insiktAnnan översättning: ”framgång”.","reference":{"chapter":8,"verse":14}},{"noteId":33,"caller":"-","text":"domare på jordenAndra handskrifter: ”rättfärdiga domare”.","reference":{"chapter":8,"verse":16}},{"noteId":34,"caller":"-","text":"beståendeAnnan översättning: ”uråldriga” eller ”ädla”.","reference":{"chapter":8,"verse":18}},{"noteId":35,"caller":"-","text":"hadeAnnan översättning: ”fick” (dvs födde, ordet översätts så i 1 Mos 4:1). Nya testamentet kallar Guds vishet för Kristus (1 Kor 1:24, jfr 1 Mos 1:1, Joh 1:1f, Kol 1:15f).","reference":{"chapter":8,"verse":22}},{"noteId":36,"caller":"-","text":"välvde ett valvAnnan översättning: ”tecknade en cirkel”.","reference":{"chapter":8,"verse":27}},{"noteId":37,"caller":"-","text":"verksamAnnan översättning: ”troget”, ”ett barn” eller ”en konstnär”. Kreativitet förknippas med vishet och Guds Ande (2 Mos 31:3f).","reference":{"chapter":8,"verse":30}},{"noteId":38,"caller":"-","text":"jublandeAnnan översättning: ”lekande” (även i vers 31).","reference":{"chapter":8,"verse":30}}]},"thisChapterLink":"/api/swe_fol/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}