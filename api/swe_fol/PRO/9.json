{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PRO","translationId":"swe_fol","name":"Ordspråksboken","commonName":"Ordspråksboken","title":"Ordspråksboken","order":20,"numberOfChapters":31,"sha256":"70af87ddae069c078a12d6a5d5656cff96567509470d83509a53a8db91384ded","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swe_fol/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Vishetens inbjudan"]},{"type":"verse","number":1,"content":["Visheten har byggt sitt hus,",{"text":"hon har huggit ut","poem":2},{"noteId":39},{"text":"sina sju pelare.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Hon har slaktat sin boskap,","poem":1},{"text":"blandat sitt vin","poem":2},{"text":"och dukat sitt bord.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Hon har sänt ut sina tjänarinnor,","poem":1},{"text":"hon ropar från stadens","poem":2},{"text":"översta höjder:","poem":3},{"noteId":40}]},{"type":"verse","number":4,"content":[{"text":"”Du som är okunnig, kom hit!”","poem":1},{"text":"Till den som saknar vett säger hon:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"”Kom, ät av mitt bröd","poem":1},{"text":"och drick av det vin","poem":2},{"text":"som jag blandat!","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Lämna okunnigheten","poem":1},{"text":"så får ni leva,","poem":3},{"text":"och gå fram på förståndets väg.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den som tillrättavisar en hånare","poem":1},{"text":"får ta emot hån,","poem":3},{"text":"den som förmanar en gudlös","poem":2},{"text":"får förakt.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Förmana inte en hånare,","poem":1},{"text":"han kommer bara att hata dig.","poem":3},{"text":"Förmana den som är vis,","poem":2},{"text":"han kommer att älska dig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ge åt den vise","poem":1},{"text":"och han blir ännu visare,","poem":3},{"text":"undervisa den rättfärdige","poem":2},{"text":"och han lär sig mer.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Att vörda Herren","poem":1},{"text":"är början till vishet,","poem":3},{"text":"att känna den Helige är förstånd,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"för genom mig","poem":1},{"text":"blir dina dagar många","poem":2},{"text":"och dina levnadsår förökas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Är du vis hjälper din vishet dig,","poem":1},{"text":"hånar du får du bära det själv.","poem":2}]},{"type":"heading","content":["Oförnuftets inbjudan"]},{"type":"verse","number":13,"content":[{"text":"Dårskapen är en rastlös kvinna,","poem":1},{"text":"okunnig och utan vett.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hon sitter vid dörren till sitt hus,","poem":1},{"text":"på en tron högt uppe i staden.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hon ropar till dem","poem":1},{"text":"som går vägen förbi,","poem":3},{"text":"till dem som går sina stigar","poem":2},{"text":"rakt fram:","poem":3}]},{"type":"verse","number":16,"content":[{"text":"”Du som är okunnig, kom hit!”","poem":1},{"text":"Till den som saknar vett","poem":2},{"text":"säger hon:","poem":3}]},{"type":"verse","number":17,"content":[{"text":"”Stulet vatten är sött,","poem":1},{"text":"hemligt bröd är ljuvligt!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Men han vet inte","poem":1},{"text":"att de döda är där,","poem":3},{"text":"att hennes gäster","poem":2},{"text":"hamnar i dödsrikets djup.","poem":3}]}],"footnotes":[{"noteId":39,"caller":"-","text":"huggit utAndra handskrifter (Septuaginta): ”satt upp”.","reference":{"chapter":9,"verse":1}},{"noteId":40,"caller":"-","text":"stadens översta höjderHär låg en stads kungapalats (jfr 2 Sam 11:2) eller tempel (jfr Jes 2:2).","reference":{"chapter":9,"verse":3}}]},"thisChapterLink":"/api/swe_fol/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}