{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":10,"content":[{"type":"heading","content":["Fortsättning av föregående psalm"]},{"type":"verse","number":1,"content":[{"text":"Herre, varför stannar du på avstånd","poem":1},{"text":"och döljer dig i nödens tider?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"De gudlösas högmod","poem":1},{"text":"plågar","poem":3},{"noteId":32},{"text":"den förtryckte.","poem":3},{"text":"Låt dem fångas i de onda planer","poem":2},{"text":"de har smitt,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"för den gudlöse skryter","poem":1},{"text":"över sina själviska begär,","poem":3},{"text":"han välsignar den girige","poem":2},{"text":"och föraktar Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"I sitt högmod","poem":1},{"text":"söker han inte Gud","poem":3},{"noteId":33},{"text":",","poem":3},{"text":"i alla hans tankar","poem":2},{"text":"finns ingen plats för Gud.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Han har ständig framgång","poem":1},{"text":"på sina vägar,","poem":3},{"text":"dina domar går högt","poem":2},{"text":"över hans blick,","poem":3},{"text":"han fnyser åt alla sina fiender.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Han säger i sitt hjärta:","poem":1},{"text":"\"Jag vacklar inte,","poem":2},{"text":"mig drabbar aldrig","poem":3},{"text":"någon olycka.\"","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Hans mun är full av förbannelse,","poem":1},{"text":"svek och förtryck,","poem":3},{"text":"under hans tunga","poem":2},{"text":"finns ondska och olycka.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Han ligger på lur vid gårdarna,","poem":1},{"text":"han vill döda den oskyldige i smyg,","poem":2},{"text":"hans ögon spanar","poem":3},{"text":"efter den olycklige.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Han lurar dold","poem":1},{"text":"som ett lejon i sitt snår,","poem":3},{"text":"han lurar för att gripa den svage,","poem":2},{"text":"han griper den svage","poem":3},{"text":"och drar in honom i sitt nät.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Han hukar sig ner, han ligger på lur,","poem":1},{"text":"och de olyckliga faller i hans klor.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Han säger i sitt hjärta:","poem":1},{"text":"\"Gud glömmer,","poem":2},{"text":"han har dolt sitt ansikte,","poem":3},{"text":"han ser det aldrig.\"","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Res dig, Herre!","poem":1},{"text":"Gud, lyft din hand,","poem":2},{"text":"glöm inte de svaga!","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Varför får den gudlöse förakta Gud","poem":1},{"text":"och säga i sitt hjärta","poem":2},{"text":"att du inte ställer till svars?","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Du ser det,","poem":1},{"text":"du ser olycka och sorg","poem":2},{"text":"för att ta det i din hand.","poem":3},{"text":"Den olycklige lämnar sig åt dig,","poem":2},{"text":"du är den faderlöses hjälpare.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Bryt den ondes och gudlöses arm,","poem":1},{"text":"gör upp med hans gudlöshet","poem":2},{"text":"tills du inte ser den mer!","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Herren är kung","poem":1},{"text":"i evigheters evighet,","poem":3},{"text":"hedningar försvinner","poem":2},{"text":"ur hans land.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Du hör de förtrycktas längtan,","poem":1},{"text":"Herre,","poem":3},{"text":"du styrker deras hjärtan,","poem":2},{"text":"du vänder ditt öra till dem","poem":3}]},{"type":"verse","number":18,"content":[{"text":"för att ge den faderlöse","poem":1},{"text":"och förtryckte rätt.","poem":3},{"text":"Människor komna av jord","poem":2},{"text":"ska aldrig mer sprida skräck.","poem":3}]}],"footnotes":[{"noteId":32,"caller":"-","text":"plågarAnnan översättning: \"jagar\".","reference":{"chapter":10,"verse":2}},{"noteId":33,"caller":"-","text":"Annan översättning: \"I sitt högmod (säger) han: Gud straffar inte, det finns ingen Gud – så är alla hans tankar.\"","reference":{"chapter":10,"verse":4}}]},"thisChapterLink":"/api/swe_fol/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}