{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":101,"content":[{"type":"heading","content":["En gudfruktig kung"]},{"type":"verse","number":1,"content":[{"text":"En psalm av David.","descriptive":true},{"lineBreak":true},{"text":"Om nåd och rätt vill jag sjunga,","poem":1},{"text":"dig, Herre, vill jag prisa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jag vill ge akt på","poem":1},{"noteId":283},{"text":"den fullkomliga vägen","poem":2},{"noteId":284},{"text":".","poem":2},{"text":"När kommer du till mig?","poem":3},{"text":"Jag vill vandra med rent hjärta","poem":2},{"text":"i mitt hus.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jag vänder inte mitt öga","poem":1},{"text":"till det som är fördärvligt","poem":3},{"noteId":285},{"text":".","poem":3},{"text":"Trolöshet hatar jag,","poem":2},{"text":"det får inte finnas hos mig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Det falska hjärtat","poem":1},{"text":"ska bort från mig,","poem":3},{"text":"det onda vill jag inte veta av.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Den som baktalar sin nästa","poem":1},{"text":"ska jag förgöra,","poem":3},{"text":"stolta ögon och högmodigt hjärta","poem":2},{"text":"tål jag inte.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mina ögon söker de trofasta i landet,","poem":1},{"text":"de ska bo hos mig.","poem":3},{"text":"Den som vandrar på","poem":2},{"text":"den fullkomliga vägen,","poem":3},{"text":"han ska tjäna mig.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Den som begår svek","poem":1},{"text":"får inte bo i mitt hus,","poem":3},{"text":"den som talar lögn","poem":2},{"text":"ska inte bestå inför mina ögon.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Varje morgon ska jag förgöra","poem":1},{"text":"alla gudlösa i landet","poem":3},{"text":"och utrota alla förbrytare","poem":2},{"text":"ur Herrens stad.","poem":3}]}],"footnotes":[{"noteId":283,"caller":"-","text":"ge akt påAnnan översättning: \"förstå\" eller \"ha framgång på\".","reference":{"chapter":101,"verse":2}},{"noteId":284,"caller":"-","text":"den fullkomliga vägenAnnan översättning: \"de fullkomligas väg\".","reference":{"chapter":101,"verse":2}},{"noteId":285,"caller":"-","text":"fördärvligtOrdagrant: \"värdelöst\".","reference":{"chapter":101,"verse":3}}]},"thisChapterLink":"/api/swe_fol/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}