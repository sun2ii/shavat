{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":102,"content":[{"type":"heading","content":["Tröst i svår nöd"]},{"type":"verse","number":1,"content":[{"text":"Bön av en plågad som i vanmakt utgjuter sin sorg inför Herren.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, hör min bön,","poem":1},{"text":"låt mitt rop komma inför dig!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dölj inte ditt ansikte för mig","poem":1},{"text":"när jag är i nöd.","poem":3},{"text":"Vänd ditt öra till mig,","poem":2},{"text":"skynda dig att svara","poem":3},{"text":"när jag ropar!","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mina dagar försvinner som rök,","poem":1},{"text":"mina ben brinner som eld.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mitt hjärta är bränt","poem":1},{"text":"och visset som gräs,","poem":3},{"text":"för jag glömmer att äta mitt bröd.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Efter all min högljudda suckan","poem":1},{"text":"är jag bara skinn och ben.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag är som en pelikan i öknen,","poem":1},{"text":"som en uggla bland ruiner.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jag ligger vaken,","poem":1},{"text":"jag är som en ensam fågel","poem":2},{"text":"på taket.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Mina fiender hånar mig dagen lång,","poem":1},{"text":"mina häcklare använder mig","poem":2},{"text":"som en svordom.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Jag äter aska som bröd","poem":1},{"text":"och blandar min dryck med tårar,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"på grund av din vrede och harm.","poem":1},{"text":"Du har gripit mig","poem":2},{"text":"och kastat bort mig.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Mina dagar är","poem":1},{"text":"som en utdragen skugga,","poem":3},{"text":"jag vissnar som gräs.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Men du, Herre, tronar för evigt,","poem":1},{"text":"ihågkommen av släkte efter släkte.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Du ska gripa in","poem":1},{"text":"och förbarma dig över Sion,","poem":2},{"text":"det är dags att du visar det nåd.","poem":3},{"text":"Ja, tiden är inne,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"för dina tjänare älskar dess stenar,","poem":1},{"text":"de lider med dess grus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Folken ska vörda Herrens namn","poem":1},{"text":"och jordens alla kungar","poem":2},{"text":"din härlighet,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"när Herren bygger upp Sion","poem":1},{"text":"och visar sig i sin härlighet.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Han vänder sig till","poem":1},{"text":"den utblottades bön","poem":3},{"text":"och föraktar den inte.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Det ska skrivas ner","poem":1},{"text":"för ett kommande släkte,","poem":3},{"text":"ett folk som han skapar","poem":2},{"text":"ska prisa Herren,","poem":3}]},{"type":"verse","number":20,"content":[{"text":"för han blickar ner","poem":1},{"text":"från sin heliga höjd,","poem":3},{"text":"Herren ser ner","poem":2},{"text":"från himlen till jorden","poem":3}]},{"type":"verse","number":21,"content":[{"text":"för att höra den fångnes klagan","poem":1},{"text":"och befria dödens barn.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Herrens namn","poem":1},{"text":"ska förkunnas i Sion","poem":3},{"text":"och hans lov i Jerusalem,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"när folk och riken samlas","poem":1},{"text":"för att tjäna Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Han har försvagat min kraft","poem":1},{"text":"på vägen,","poem":3},{"text":"han har förkortat","poem":2},{"text":"mina dagar.","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Jag sade: Min Gud,","poem":1},{"text":"ryck inte bort mig","poem":3},{"text":"mitt i livet!","poem":4},{"text":"Dina år varar","poem":2},{"text":"från släkte till släkte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"För länge sedan","poem":1},{"noteId":286},{"text":"lade du jordens grund,","poem":3},{"text":"himlarna är dina händers verk.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"De ska gå under,","poem":1},{"text":"men du ska bestå.","poem":3},{"text":"De ska alla nötas ut som kläder,","poem":2},{"text":"du ska byta ut","poem":3},{"text":"dem som en mantel","poem":2},{"text":"och de försvinner","poem":3},{"noteId":287},{"text":".","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Men du är densamme,","poem":1},{"text":"och dina år har inget slut.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Dina tjänares barn","poem":1},{"text":"ska bo i trygghet","poem":3},{"text":"och deras ättlingar","poem":2},{"text":"bestå inför dig.","poem":3}]}],"footnotes":[{"noteId":286,"caller":"-","text":"Verserna 26-28 citeras i Hebr 1:10-12 med hänsyftning på Kristus som Skapare.","reference":{"chapter":102,"verse":26}},{"noteId":287,"caller":"-","text":"byta ut … försvinnerAnnan översättning (så Septuaginta): \"förvandla … förvandlas\".","reference":{"chapter":102,"verse":27}}]},"thisChapterLink":"/api/swe_fol/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":29}