{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":103,"content":[{"type":"heading","content":["Lova Herren för hans godhet"]},{"type":"verse","number":1,"content":[{"text":"Av David.","descriptive":true},{"lineBreak":true},{"text":"Lova Herren, min själ!","poem":1},{"text":"Hela mitt inre,","poem":2},{"text":"prisa hans heliga namn!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Lova Herren, min själ,","poem":1},{"text":"och glöm inte allt gott han gör –","poem":2}]},{"type":"verse","number":3,"content":[{"text":"han förlåter dig alla dina synder","poem":1},{"text":"och botar alla dina sjukdomar,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"han friköper ditt liv från graven","poem":1},{"text":"och kröner dig med nåd","poem":2},{"text":"och barmhärtighet,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"han mättar ditt begär med sitt goda","poem":1},{"text":"så att du blir ung på nytt","poem":2},{"text":"som en örn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Herren handlar rättfärdigt","poem":1},{"text":"och skipar rätt för alla förtryckta.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Han visade Mose sina vägar,","poem":1},{"text":"Israels barn sina gärningar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Barmhärtig och nådig är Herren,","poem":1},{"text":"sen till vrede och stor i nåd.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han går inte ständigt till rätta","poem":1},{"text":"och behåller inte sin vrede","poem":2},{"text":"för evigt.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Han behandlar oss inte","poem":1},{"text":"efter våra synder","poem":3},{"text":"och lönar oss inte","poem":2},{"text":"efter våra missgärningar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Så hög som himlen","poem":1},{"text":"är över jorden,","poem":3},{"text":"så väldig är hans nåd","poem":2},{"text":"över dem som vördar honom.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Så långt som öster är från väster,","poem":1},{"text":"så långt avlägsnar han","poem":2},{"text":"våra synder från oss.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Så som en far förbarmar sig","poem":1},{"text":"över barnen,","poem":3},{"text":"så förbarmar sig Herren","poem":2},{"text":"över dem som vördar honom,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"för han vet hur vi är skapade,","poem":1},{"text":"han tänker på att vi är stoft.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Människans dagar är som gräset,","poem":1},{"text":"hon blomstrar som blomman","poem":2},{"text":"på ängen.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Vinden sveper fram över den","poem":1},{"text":"och den är borta,","poem":3},{"text":"dess plats minns den inte mer.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Men Herrens nåd varar","poem":1},{"text":"från evighet till evighet","poem":2},{"text":"över dem som vördar honom","poem":3},{"text":"och hans rättfärdighet","poem":2},{"text":"ända till barnbarnen,","poem":3}]},{"type":"verse","number":18,"content":[{"text":"när man håller hans förbund","poem":1},{"text":"och tänker på hans befallningar","poem":2},{"text":"och följer dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Herren har grundat sin tron","poem":1},{"text":"i himlen,","poem":3},{"text":"hans rike råder över allt.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lova Herren, ni hans änglar,","poem":1},{"text":"ni starka hjältar","poem":3},{"text":"som utför hans befallning","poem":2},{"text":"så snart ni hör ljudet av den.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Lova Herren, alla hans härar,","poem":1},{"text":"ni hans tjänare","poem":2},{"text":"som gör hans vilja.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Lova Herren, alla hans verk,","poem":1},{"text":"överallt i hans välde.","poem":3},{"text":"Lova Herren, min själ!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}