{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":104,"content":[{"type":"heading","content":["Skaparens lov"]},{"type":"verse","number":1,"content":[{"text":"Lova Herren, min själ!","poem":1},{"text":"Herre, min Gud,","poem":2},{"text":"du är väldig och stor,","poem":3},{"text":"klädd i majestät och härlighet.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Du sveper dig i ljus som en mantel,","poem":1},{"text":"du spänner ut himlen som ett tält,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"du timrar på vattnen dina salar.","poem":1},{"text":"Du gör molnen till din vagn","poem":2},{"text":"och far fram på vindens vingar.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Du gör vindar till dina sändebud,","poem":1},{"text":"eldslågor till dina tjänare.","poem":2},{"noteId":288}]},{"type":"verse","number":5,"content":[{"text":"Du grundade jorden på dess fästen,","poem":1},{"text":"den vacklar ej till evig tid.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Du täckte den med djupet","poem":1},{"text":"som en dräkt,","poem":3},{"text":"högt över bergen stod vattnen.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vid din tillrättavisning flydde de,","poem":1},{"text":"för din dundrande röst","poem":2},{"text":"skyndade de bort.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Berg höjde sig, dalar sänkte sig","poem":1},{"text":"på den plats","poem":2},{"noteId":289},{"text":"du bestämt för dem.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Du satte en gräns","poem":1},{"text":"som vattnen inte får gå över,","poem":3},{"text":"aldrig mer ska de täcka jorden.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Du låter källor flyta fram i dalarna,","poem":1},{"text":"de forsar fram mellan bergen.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"De vattnar markens alla djur,","poem":1},{"text":"vildåsnor släcker sin törst.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Vid dem har himlens fåglar","poem":1},{"text":"sina bon,","poem":3},{"text":"bland grenarna hörs deras sång.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Du vattnar bergen från dina salar,","poem":1},{"text":"jorden mättas av det du skapar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Du låter gräs skjuta upp för djuren","poem":1},{"text":"och örter till människans tjänst","poem":3},{"noteId":290},{"text":".","poem":3},{"text":"Så låter du bröd","poem":2},{"text":"komma från jorden,","poem":3}]},{"type":"verse","number":15,"content":[{"text":"och vin som ger glädje","poem":1},{"text":"åt människans hjärta.","poem":3},{"text":"Med olja ger du glans","poem":2},{"text":"åt hennes ansikte,","poem":3},{"text":"och brödet styrker hennes hjärta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Herrens träd blir mättade,","poem":1},{"text":"Libanons cedrar","poem":2},{"text":"som han har planterat.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Fåglarna bygger där sina bon,","poem":1},{"text":"storken har sitt hem i cypresserna.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Stenbockarna har fått","poem":1},{"text":"de höga bergen,","poem":3},{"text":"klyftorna är klippgrävlingars","poem":2},{"text":"tillflykt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Månen har du gjort","poem":1},{"text":"för att visa tider,","poem":3},{"text":"solen vet när den ska gå ner.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Du sänder mörker","poem":1},{"text":"och det blir natt,","poem":3},{"text":"då kommer skogens alla djur","poem":2},{"text":"i rörelse.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Unga lejon ryter efter rov","poem":1},{"text":"och begär sin föda av Gud.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Solen går upp,","poem":1},{"text":"då drar de sig undan","poem":2},{"text":"och lägger sig ner i sina hålor.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Då går människan ut till sin gärning","poem":1},{"text":"och arbetar tills kvällen kommer.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hur mångfaldiga","poem":1},{"text":"är inte dina verk, Herre!","poem":3},{"text":"Med vishet har du gjort dem alla,","poem":2},{"text":"jorden är full av vad du har","poem":3},{"text":"skapat.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"Där är havet, det stora och vida,","poem":1},{"text":"med ett oräkneligt vimmel av djur,","poem":2},{"text":"både stora och små.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Där går skeppen fram,","poem":1},{"text":"och Leviatan som du skapat","poem":2},{"text":"för att leka där.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Alla hoppas de på dig,","poem":1},{"text":"att du ska ge dem mat i rätt tid.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Du ger dem och de samlar in,","poem":1},{"text":"du öppnar din hand","poem":2},{"text":"och de mättas av goda gåvor.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Du döljer ditt ansikte","poem":1},{"text":"och de blir förskräckta,","poem":3},{"text":"du tar ifrån dem deras ande,","poem":2},{"text":"de dör och blir åter till stoft.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Du sänder din Ande, då skapas de","poem":1},{"text":"och du förnyar jordens ansikte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Må Herrens härlighet","poem":1},{"text":"bestå för evigt!","poem":3},{"text":"Må Herren glädja sig","poem":2},{"text":"över sina verk.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Han ser på jorden och den bävar,","poem":1},{"text":"han rör vid bergen och de ryker.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Jag vill sjunga till Herren","poem":1},{"text":"så länge jag lever,","poem":3},{"text":"jag vill lovsjunga min Gud","poem":2},{"text":"så länge jag är till.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Må min bön behaga honom,","poem":1},{"text":"jag vill glädja mig i Herren.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Må syndare försvinna från jorden","poem":1},{"text":"och inga gudlösa mer finnas till.","poem":3},{"text":"Lova Herren, min själ!","poem":2},{"text":"Halleluja!","poem":3}]}],"footnotes":[{"noteId":288,"caller":"-","text":"Annan översättning (Septuaginta): \"Du gör dina änglar till vindar, dina tjänare till eldslågor\" (jfr Hebr 1:7). \"Vindar\", hebr. ruchót, kan också översättas \"andar\".","reference":{"chapter":104,"verse":4}},{"noteId":289,"caller":"-","text":"Berg höjde sig, dalar sänkte sig på den platsAnnan översättning: \"Upp över bergen, ner i dalarna, till den plats\".","reference":{"chapter":104,"verse":8}},{"noteId":290,"caller":"-","text":"till människans tjänstAnnan översättning: \"för människan att odla\".","reference":{"chapter":104,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}