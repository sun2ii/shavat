{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":105,"content":[{"type":"heading","content":["Herrens gärningar mot sitt folk"]},{"type":"verse","number":1,"content":[{"text":"Tacka Herren, åkalla hans namn,","poem":1},{"text":"gör hans gärningar kända","poem":2},{"text":"bland folken!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Sjung till honom, lovsjung honom,","poem":1},{"text":"tala om alla hans under!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Ha er ära i hans heliga namn!","poem":1},{"text":"De som söker Herren","poem":2},{"text":"ska glädja sig av hjärtat.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Fråga efter Herren och hans makt,","poem":1},{"text":"sök alltid hans ansikte.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tänk på de under han gjort,","poem":1},{"text":"på hans tecken","poem":2},{"text":"och hans muns domar,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"ni Abrahams barn, hans tjänare,","poem":1},{"text":"ni Jakobs söner, hans utvalda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Han är Herren vår Gud,","poem":1},{"text":"över hela jorden når hans domar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Han minns för evigt sitt förbund,","poem":1},{"text":"i tusen släktled ordet han gett,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"förbundet han slöt med Abraham","poem":1},{"text":"och eden han gav till Isak.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Han bestämde det","poem":1},{"text":"för Jakob som en lag,","poem":2},{"text":"för Israel som ett evigt förbund:","poem":3}]},{"type":"verse","number":11,"content":[{"text":"\"Till dig ger jag Kanaans land","poem":1},{"text":"som er arvedel och egendom.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Då var de en liten skara,","poem":1},{"text":"de var få och främlingar i landet.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"De vandrade från folk till folk,","poem":1},{"text":"från ett rike till ett annat.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Han lät ingen förtrycka dem,","poem":1},{"text":"han straffade kungar","poem":2},{"text":"för deras skull:","poem":3}]},{"type":"verse","number":15,"content":[{"text":"\"Rör inte mina smorda,","poem":1},{"text":"gör inte mina profeter något ont!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Han sände svält över landet","poem":1},{"text":"och lät dem lida brist på bröd,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"men han sände en man","poem":1},{"text":"framför dem,","poem":3},{"text":"Josef som såldes till slav.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Man slog hans fötter i bojor","poem":1},{"text":"och lade järn om hans hals,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"tills det han sagt slog in","poem":1},{"text":"och Herrens ord","poem":2},{"text":"bevisade hans oskuld.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Då släpptes han","poem":1},{"text":"på kungens befallning,","poem":3},{"text":"folkens härskare gav honom fri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Han satte honom till herre","poem":1},{"text":"över sitt hus,","poem":3},{"text":"till härskare över allt han ägde,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"till att binda","poem":1},{"noteId":291},{"text":"hans furstar","poem":1},{"text":"efter sin vilja","poem":3},{"text":"och lära hans äldste vishet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Och Israel kom till Egypten,","poem":1},{"text":"Jakob blev gäst i Hams land.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Herren gjorde sitt folk","poem":1},{"text":"mycket fruktsamt,","poem":3},{"text":"starkare","poem":2},{"noteId":292},{"text":"än deras fiender.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Han vände deras hjärtan","poem":1},{"text":"till att hata hans folk,","poem":2},{"text":"till att handla svekfullt","poem":3},{"text":"mot hans tjänare.","poem":4}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Han sände Mose, sin tjänare,","poem":1},{"text":"och Aron som han utvalt.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"De gjorde hans tecken","poem":1},{"noteId":293},{"text":"bland dem","poem":1},{"text":"och under i Hams land.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Han sände mörker","poem":1},{"text":"och allt blev mörkt,","poem":3},{"text":"och de stod inte emot","poem":2},{"noteId":294},{"text":"hans ord.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Han förvandlade deras vatten","poem":1},{"text":"till blod","poem":3},{"text":"och lät deras fisk dö.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Deras land vimlade av grodor,","poem":1},{"text":"ända in i deras kungars kamrar.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Han befallde,","poem":1},{"text":"och det kom flugsvärmar","poem":2},{"text":"och mygg","poem":4},{"text":"över hela deras rike.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Han gjorde regnet till hagel","poem":1},{"text":"och sände eldslågor i deras land.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Han slog ner deras vinstockar","poem":1},{"text":"och fikonträd","poem":3},{"text":"och knäckte träden i deras rike.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Han befallde,","poem":1},{"text":"och det kom gräshoppor","poem":2},{"text":"och gräshoppslarver","poem":3},{"text":"i oräknelig mängd.","poem":4}]},{"type":"verse","number":35,"content":[{"text":"De åt upp all grönska i landet,","poem":1},{"text":"slukade grödan på marken.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Han slog allt förstfött i landet,","poem":1},{"text":"förstlingen av all deras livskraft.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Så förde han ut dem","poem":1},{"text":"med silver och guld,","poem":3},{"text":"i hans stammar stapplade ingen.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Egypten gladde sig när de drog ut,","poem":1},{"text":"skräck för Israel hade fallit","poem":2},{"text":"över dem.","poem":3}]},{"type":"verse","number":39,"content":[{"text":"Han bredde ut ett moln till skydd","poem":1},{"text":"och en eld till att lysa i natten.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"De bad, och han sände vaktlar","poem":1},{"text":"och mättade dem","poem":2},{"text":"med bröd från himlen.","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Han öppnade klippan","poem":1},{"text":"och vattnet flödade,","poem":3},{"text":"det rann i öknen som en ström,","poem":2}]},{"type":"verse","number":42,"content":[{"text":"för han tänkte på sitt heliga löfte","poem":1},{"text":"till sin tjänare Abraham.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Så förde han ut","poem":1},{"text":"sitt folk med fröjd,","poem":2},{"text":"sina utvalda med jubel.","poem":3}]},{"type":"verse","number":44,"content":[{"text":"Han gav dem hednafolkens länder,","poem":1},{"text":"det folken förvärvat fick de ärva,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"för att de skulle hålla hans lagar","poem":1},{"text":"och följa hans undervisning.","poem":2},{"text":"Halleluja!","poem":3}]}],"footnotes":[{"noteId":291,"caller":"-","text":"bindaAndra handskrifter (Septuaginta): \"fostra\".","reference":{"chapter":105,"verse":22}},{"noteId":292,"caller":"-","text":"starkareAnnan översättning: \"fler\".","reference":{"chapter":105,"verse":24}},{"noteId":293,"caller":"-","text":"De gjorde hans teckenAndra handskrifter (Septuaginta): \"Han gjorde sina tecken\".","reference":{"chapter":105,"verse":27}},{"noteId":294,"caller":"-","text":"stod inte emotAndra handskrifter (Septuaginta): \"stod emot\".","reference":{"chapter":105,"verse":28}}]},"thisChapterLink":"/api/swe_fol/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}