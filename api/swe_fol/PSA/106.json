{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":106,"content":[{"type":"heading","content":["Guds nådegärningar och Israels otro"]},{"type":"verse","number":1,"content":[{"text":"Halleluja!","poem":1},{"text":"Tacka Herren, för han är god,","poem":2},{"text":"evig är hans nåd.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Vem kan beskriva","poem":1},{"text":"Herrens väldiga gärningar","poem":3},{"text":"och förkunna allt hans lov?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Saliga är de som följer det rätta,","poem":1},{"text":"som alltid handlar rättfärdigt.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tänk på mig, Herre,","poem":1},{"text":"efter din nåd mot ditt folk,","poem":3},{"text":"kom till mig med din frälsning,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"så att jag får se dina utvaldas lycka,","poem":1},{"text":"dela ditt folks glädje","poem":3},{"text":"och berömma mig","poem":2},{"text":"med din arvedel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vi har syndat som våra fäder,","poem":1},{"text":"vi har gjort fel,","poem":2},{"text":"vi har varit ogudaktiga.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Våra fäder i Egypten","poem":1},{"text":"tog inte lärdom av dina under,","poem":3},{"text":"de tänkte inte på","poem":2},{"text":"dina många nådegärningar","poem":3},{"text":"utan gjorde uppror vid havet,","poem":2},{"text":"vid Röda havet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Men han frälste dem","poem":1},{"text":"för sitt namns skull,","poem":2},{"text":"för att göra sin makt känd.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Han talade strängt till Röda havet","poem":1},{"text":"och det blev torrt,","poem":3},{"text":"han förde dem genom djupen","poem":2},{"text":"som i en öken.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Han frälste dem","poem":1},{"text":"från motståndarens hand","poem":3},{"text":"och befriade dem","poem":2},{"text":"från fiendens grepp.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Vattnet täckte deras fiender,","poem":1},{"text":"inte en enda av dem blev kvar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Då trodde de hans ord","poem":1},{"text":"och sjöng hans lov.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Men snart glömde de","poem":1},{"text":"hans gärningar,","poem":3},{"text":"de väntade inte på hans råd.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"De greps av begär i öknen","poem":1},{"text":"och frestade Gud i ödemarken.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Han gav dem vad de begärde,","poem":1},{"text":"men sände tärande sjukdom","poem":2},{"text":"i deras själ.","poem":3},{"noteId":295}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"De fylldes av avund","poem":1},{"text":"mot Mose i lägret","poem":3},{"text":"och mot Aron, Herrens helige.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Men jorden öppnade sig","poem":1},{"text":"och slukade Datan,","poem":3},{"text":"den begravde Abirams grupp.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Eld slog upp i deras grupp,","poem":1},{"text":"lågorna brände de gudlösa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"De gjorde en kalv vid Horeb","poem":1},{"text":"och tillbad en avgudabild,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"de bytte bort sin härlighet","poem":1},{"text":"mot bilden av en tjur","poem":2},{"text":"som äter gräs.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"De glömde Gud, sin Frälsare,","poem":1},{"text":"som gjort väldiga ting","poem":2},{"text":"i Egypten,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"underbara verk i Hams land,","poem":1},{"text":"förunderliga gärningar","poem":2},{"text":"vid Röda havet.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Han hotade att förgöra dem,","poem":1},{"text":"men Mose, hans utvalde,","poem":2},{"text":"ställde sig i vägen","poem":3},{"text":"för att vända bort hans vrede","poem":2},{"text":"från att fördärva dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"De föraktade det ljuvliga landet,","poem":1},{"text":"de trodde inte hans ord.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"De klagade i sina tält","poem":1},{"text":"och lyssnade inte","poem":2},{"text":"till Herrens röst.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Då lyfte han sin hand mot dem","poem":1},{"text":"och svor att låta dem falla i öknen,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"att låta deras barn","poem":1},{"text":"falla bland hednafolken","poem":3},{"text":"och spridas ut i länderna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"De band sig till Baal-Peor","poem":1},{"text":"och åt av offren till de döda,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"de väckte Guds vrede","poem":1},{"text":"med sina gärningar","poem":3},{"text":"och en hemsökelse bröt ut","poem":2},{"text":"bland dem.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Men Pinehas steg fram","poem":1},{"text":"och skipade rätt,","poem":3},{"text":"och hemsökelsen hejdades.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Det räknades honom","poem":1},{"text":"till rättfärdighet","poem":3},{"text":"från släkte till släkte, för evig tid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"De väckte hans vrede","poem":1},{"text":"vid Meribas vatten","poem":3},{"text":"och Mose fick lida för deras skull,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"för de trotsade","poem":1},{"noteId":296},{"text":"hans ande","poem":1},{"text":"så att tanklösa ord","poem":2},{"text":"kom över hans läppar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"De förgjorde inte folken","poem":1},{"text":"som Herren befallt dem,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"de beblandade sig","poem":1},{"text":"med hednafolken","poem":3},{"text":"och lärde sig deras gärningar.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"De tjänade deras avgudar,","poem":1},{"text":"och dessa blev en snara för dem.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"De offrade sina söner och döttrar","poem":1},{"text":"åt onda andar,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"de spillde oskyldigt blod,","poem":1},{"text":"sina söners och döttrars blod","poem":3},{"text":"som de offrade åt","poem":2},{"text":"Kanaans avgudar","poem":3},{"text":"så att landet vanhelgades av blodet.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"De blev orena genom sina gärningar","poem":1},{"text":"och var trolösa i allt de gjorde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Då upptändes Herrens vrede","poem":1},{"text":"mot hans folk,","poem":3},{"text":"och han avskydde sin arvedel.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Han gav dem","poem":1},{"text":"i hednafolkens hand,","poem":3},{"text":"och de som hatade dem","poem":2},{"text":"fick härska över dem.","poem":3}]},{"type":"verse","number":42,"content":[{"text":"Deras fiender förtryckte dem,","poem":1},{"text":"de kuvades under deras hand.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Han räddade dem gång på gång,","poem":1},{"text":"men de var upproriska","poem":2},{"text":"i sina planer","poem":3},{"noteId":297},{"text":"och sjönk allt djupare","poem":2},{"text":"genom sin synd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Men han såg till dem i deras nöd","poem":1},{"text":"när han hörde deras rop,","poem":2}]},{"type":"verse","number":45,"content":[{"text":"han tänkte på sitt förbund med dem","poem":1},{"text":"och förbarmade sig","poem":2},{"text":"för sin stora nåds skull.","poem":3}]},{"type":"verse","number":46,"content":[{"text":"Han lät dem finna barmhärtighet","poem":1},{"text":"hos alla som fört dem bort","poem":2},{"text":"i fångenskap.","poem":3}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Fräls oss, Herre vår Gud,","poem":1},{"text":"och samla oss från hednafolken,","poem":3},{"text":"så att vi får prisa ditt heliga namn","poem":2},{"text":"och ha vår ära i att lova dig.","poem":3}]},{"type":"heading","content":["__"]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Välsignad är Herren, Israels Gud,","poem":1},{"text":"från evighet till evighet!","poem":3},{"text":"Och allt folket ska säga: \"Amen!\"","poem":2},{"text":"Halleluja!","poem":3}]}],"footnotes":[{"noteId":295,"caller":"-","text":"men sände tärande sjukdom i deras själAndra handskrifter (Septuaginta): \"och sände mättnad för deras längtan\".","reference":{"chapter":106,"verse":15}},{"noteId":296,"caller":"-","text":"trotsadeAnnan översättning: \"förbittrade\".","reference":{"chapter":106,"verse":33}},{"noteId":297,"caller":"-","text":"i sina planerAndra handskrifter: \"mot hans plan\".","reference":{"chapter":106,"verse":43}}]},"thisChapterLink":"/api/swe_fol/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}