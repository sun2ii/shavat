{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":108,"content":[{"type":"heading","content":["Lovprisning och bön om seger"]},{"type":"verse","number":1,"content":[{"text":"En sång, en psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mitt hjärta är frimodigt","poem":1},{"noteId":299},{"text":", Gud!","poem":1},{"text":"Jag vill sjunga och spela,","poem":2},{"text":"så vill min ära","poem":3},{"noteId":300},{"text":".","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Vakna, lyra och harpa!","poem":1},{"text":"Jag vill väcka morgonrodnaden.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jag vill tacka dig","poem":1},{"text":"bland folken, Herre,","poem":3},{"text":"och lovsjunga dig","poem":2},{"text":"bland folkslagen,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"för din nåd är stor","poem":1},{"text":"och når upp över himlen,","poem":3},{"text":"din sanning ända till skyarna.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Visa din höghet över himlen, Gud,","poem":1},{"text":"och din härlighet över hela jorden!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Fräls med din högra hand","poem":1},{"text":"och svara mig,","poem":3},{"text":"så att dina älskade blir räddade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gud har talat i sin helgedom","poem":1},{"noteId":301},{"text":":","poem":1},{"text":"\"I triumf ska jag dela upp Shekem","poem":2},{"text":"och mäta upp Suckots dal.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Gilead är mitt, Manasse är mitt,","poem":1},{"text":"Efraim är min hjälm","poem":2},{"text":"och Juda min spira.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Moab är mitt tvättfat,","poem":1},{"text":"på Edom kastar jag min sko.","poem":3},{"text":"Över filisteerna ropar jag i triumf.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vem för mig","poem":1},{"text":"till den befästa staden,","poem":3},{"text":"vem leder mig till Edom?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Är det inte du, Gud –","poem":1},{"text":"du som har förkastat oss","poem":3},{"text":"och inte drar ut","poem":2},{"text":"med våra härar, Gud?","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ge oss hjälp mot fienden,","poem":1},{"text":"människors hjälp är meningslös.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med Gud ska vi göra storverk.","poem":1},{"text":"Han ska trampa ner våra fiender.","poem":2}]}],"footnotes":[{"noteId":299,"caller":"-","text":"frimodigtAnnan översättning: \"redo\".","reference":{"chapter":108,"verse":2}},{"noteId":300,"caller":"-","text":"min äraOfta uppfattat som liktydigt med \"min själ\". Kan också syfta på Herren själv som den troendes ära.","reference":{"chapter":108,"verse":2}},{"noteId":301,"caller":"-","text":"helgedomAnnan översättning: \"helighet\".","reference":{"chapter":108,"verse":8}}]},"thisChapterLink":"/api/swe_fol/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}