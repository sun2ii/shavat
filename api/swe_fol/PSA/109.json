{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":109,"content":[{"type":"heading","content":["Bön mot obarmhärtiga motståndare"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true},{"lineBreak":true},{"text":"Min lovsångs Gud,","poem":1},{"text":"var inte tyst,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"för de öppnar sin gudlösa mun,","poem":1},{"text":"sin falska mun mot mig.","poem":3},{"text":"De talar mot mig","poem":2},{"text":"med lögnaktig tunga.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Med hatiska ord","poem":1},{"text":"omringar de mig,","poem":3},{"text":"de strider mot mig utan orsak.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Som svar på min kärlek","poem":1},{"text":"anklagar de mig,","poem":3},{"text":"men jag ber.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"De lönar gott med ont","poem":1},{"text":"och min kärlek med hat.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sätt en gudlös över honom,","poem":1},{"text":"låt en åklagare","poem":2},{"noteId":302},{"text":"stå på hans högra sida.","poem":3},{"noteId":303}]},{"type":"verse","number":7,"content":[{"text":"När han ställs inför rätta,","poem":1},{"text":"låt honom dömas skyldig","poem":2},{"text":"och hans bön bli till synd.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Låt hans dagar bli få","poem":1},{"text":"och en annan ta över hans ämbete.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Låt hans barn bli faderlösa","poem":1},{"text":"och hans hustru änka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Låt hans barn irra runt och tigga","poem":1},{"text":"och söka sitt bröd","poem":2},{"text":"långt från sina ödelagda hem.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Låt ockraren","poem":1},{"text":"få grepp om allt han äger","poem":3},{"text":"och främlingar","poem":2},{"text":"plundra hans egendom.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Låt ingen visa barmhärtighet","poem":1},{"text":"mot honom","poem":3},{"text":"och ingen förbarma sig","poem":2},{"text":"över hans faderlösa.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Låt hans ättlingar bli utrotade","poem":1},{"text":"och hans namn utplånat","poem":2},{"text":"i nästa släktled.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Låt hans fäders skuld","poem":1},{"text":"bli ihågkommen inför Herren","poem":3},{"text":"och hans mors synd inte utplånas,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"låt dem alltid finnas inför Herren","poem":1},{"text":"och låt minnet av dem utrotas","poem":2},{"text":"från jorden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Han hade ju ingen tanke","poem":1},{"text":"på att vara barmhärtig,","poem":3},{"text":"utan jagade den som var svag,","poem":2},{"text":"fattig och bedrövad i hjärtat","poem":3},{"text":"för att döda honom.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"Han älskade förbannelse","poem":1},{"text":"och den drabbade honom,","poem":3},{"text":"han ville inte ha välsignelse","poem":2},{"text":"och den flydde från honom.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Han bar förbannelse som sin dräkt,","poem":1},{"text":"och den trängde in","poem":2},{"text":"som vatten i hans inre","poem":3},{"text":"och som olja i hans ben.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Låt den bli som hans mantel","poem":1},{"text":"att svepa sig i,","poem":3},{"text":"som ett bälte att ständigt","poem":2},{"text":"spänna om sig.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Detta är mina anklagares lön","poem":1},{"text":"från Herren,","poem":3},{"text":"till dem som talar ont mot min själ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Men du, Herre min Herre,","poem":1},{"text":"hjälp mig för ditt namns skull!","poem":3},{"text":"Din nåd är god, rädda mig,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"för jag är svag och fattig,","poem":1},{"text":"mitt hjärta är genomborrat","poem":2},{"text":"i mitt inre.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Jag försvinner som skuggan","poem":1},{"text":"om kvällen,","poem":3},{"text":"jag skakas bort som en gräshoppa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mina knän vacklar av fasta,","poem":1},{"text":"min kropp tappar sitt hull.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Jag har blivit till åtlöje för dem,","poem":1},{"text":"de ser mig och skakar på huvudet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Hjälp mig, Herre min Gud!","poem":1},{"text":"Fräls mig efter din nåd,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"så att de förstår att det är din hand,","poem":1},{"text":"att du, Herre, har gjort det.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"De förbannar, men du välsignar.","poem":1},{"text":"De reser sig men måste skämmas,","poem":2},{"text":"och din tjänare gläds.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Låt mina anklagare","poem":1},{"text":"bli klädda i vanära","poem":3},{"text":"och svepta i sin skam","poem":2},{"text":"som i en mantel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Jag vill tacka Herren","poem":1},{"text":"om och om igen med min mun","poem":3},{"text":"och prisa honom bland de många,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"för han står på den fattiges","poem":1},{"text":"högra sida","poem":3},{"text":"för att frälsa honom","poem":2},{"text":"från dem som dömer hans själ.","poem":3}]}],"footnotes":[{"noteId":302,"caller":"-","text":"en åklagareHebr. satán(jfr Job 1:6, Sak 3:1, Upp 12:10).","reference":{"chapter":109,"verse":6}},{"noteId":303,"caller":"-","text":"Enligt en annan tolkning återges här anklagarnas ord (se vers 2-5).","reference":{"chapter":109,"verse":6}}]},"thisChapterLink":"/api/swe_fol/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}