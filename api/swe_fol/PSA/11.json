{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":11,"content":[{"type":"heading","content":["Förtröstan på den Rättfärdige"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. Av David.","descriptive":true},{"lineBreak":true},{"text":"Till Herren tar jag min tillflykt.","poem":1},{"text":"Hur kan ni då säga till mig:","poem":2},{"text":"\"Fly som en fågel till bergen","poem":3},{"noteId":34},{"text":"!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Se, de gudlösa spänner bågen,","poem":1},{"text":"de lägger sin pil på strängen","poem":3},{"text":"för att skjuta i mörkret","poem":2},{"text":"mot dem som har ärliga hjärtan.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"När grundvalarna raseras,","poem":1},{"text":"vad kan då den rättfärdige göra?\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Herren är i sitt heliga tempel,","poem":1},{"text":"Herrens tron är i himlen.","poem":3},{"text":"Hans ögon ser,","poem":2},{"text":"hans blickar prövar","poem":3},{"text":"människors barn.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Herren prövar den rättfärdige,","poem":1},{"text":"men hans själ hatar den gudlöse","poem":2},{"text":"och den som älskar våld.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han ska låta glödande kol och svavel","poem":1},{"text":"regna över de gudlösa,","poem":3},{"text":"en glödhet vind","poem":2},{"text":"är bägaren de får dricka,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"för Herren är rättfärdig,","poem":1},{"text":"han älskar rättfärdighet.","poem":3},{"text":"De ärliga ska se hans ansikte.","poem":2}]}],"footnotes":[{"noteId":34,"caller":"-","text":"bergenAndra handskrifter: \"ert berg\".","reference":{"chapter":11,"verse":1}}]},"thisChapterLink":"/api/swe_fol/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}