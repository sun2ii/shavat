{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":110,"content":[{"type":"heading","content":["Den evige Kungen och Prästen"]},{"type":"verse","number":1,"content":[{"text":"En psalm av David.","descriptive":true},{"lineBreak":true},{"text":"Herren sade till min Herre:","poem":1},{"text":"\"Sätt dig på min högra sida","poem":3},{"text":"tills jag lagt dina fiender","poem":2},{"text":"som en pall under dina fötter.\"","poem":3},{"noteId":304}]},{"type":"verse","number":2,"content":[{"text":"Din makts spira","poem":1},{"text":"ska Herren sträcka ut från Sion.","poem":3},{"text":"Härska mitt bland dina fiender!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Villigt kommer ditt folk","poem":1},{"text":"när du samlar din här.","poem":3},{"text":"I helig skrud","poem":2},{"noteId":305},{"text":"kommer din ungdom","poem":2},{"text":"till dig,","poem":3},{"noteId":306},{"text":"som dagg ur morgonrodnadens","poem":2},{"text":"sköte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Herren har gett sin ed","poem":1},{"text":"och ska inte ångra sig:","poem":3},{"text":"\"Du är präst för evigt,","poem":2},{"text":"på samma sätt som Melkisedek.\"","poem":3},{"noteId":307}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Herren är vid din högra sida,","poem":1},{"text":"han krossar kungar","poem":2},{"text":"på sin vredes dag.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han ska hålla dom","poem":1},{"text":"bland hednafolken,","poem":2},{"text":"överallt ska kroppar ligga,","poem":3},{"text":"han krossar hövdingar","poem":2},{"noteId":308},{"text":"över hela jorden.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han ska dricka ur bäcken","poem":1},{"text":"vid vägen,","poem":3},{"text":"därför ska han lyfta huvudet högt.","poem":2}]}],"footnotes":[{"noteId":304,"caller":"-","text":"Citeras i Matt 22:44, Apg 2:34 och Hebr 1:13 som profetia om Kristi upphöjelse.","reference":{"chapter":110,"verse":1}},{"noteId":305,"caller":"-","text":"I helig skrudAndra handskrifter: \"På heliga berg\".","reference":{"chapter":110,"verse":3}},{"noteId":306,"caller":"-","text":"kommer din ungdom till digAnnan översättning (så Septuaginta): \"har jag fött dig\".","reference":{"chapter":110,"verse":3}},{"noteId":307,"caller":"-","text":"Citeras i Hebr 5:6, 7:17 som profetia om Kristi prästämbete. Se även 1 Mos 14:18f.","reference":{"chapter":110,"verse":4}},{"noteId":308,"caller":"-","text":"hövdingarAnnan översättning: \"huvuden\".","reference":{"chapter":110,"verse":6}}]},"thisChapterLink":"/api/swe_fol/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}