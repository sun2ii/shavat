"Sina gärningars kraft","poem":1},{"text":"visade han sitt folk","poem":3},{"text":"när han gav dem","poem":2},{"text":"hednafolkens arvedel.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Hans händers verk","poem":1},{"text":"är sanning och rätt,","poem":3},{"text":"alla hans befallningar","poem":2},{"text":"är orubbliga","poem":3},{"noteId":309},{"text":".","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De står fasta för alltid","poem":1},{"text":"och för evigt,","poem":3},{"text":"fullbordade med sanning","poem":2},{"text":"och rättvisa.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Han har sänt sitt folk befrielse","poem":1},{"text":"och grundat sitt förbund","poem":2},{"text":"för evig tid.","poem":3},{"text":"Heligt och vördat är hans namn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Att vörda Herren","poem":1},{"text":"är början till vishet,","poem":3},{"text":"gott förstånd får alla","poem":2},{"text":"som handlar så.","poem":3},{"text":"Hans lov består för evigt.","poem":2}]}],"footnotes":[{"noteId":309,"caller":"-","text":"orubbligaAnnan översättning: \"pålitliga\".","reference":{"chapter":111,"verse":7}}]},"thisChapterLink":"/api/swe_fol/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}