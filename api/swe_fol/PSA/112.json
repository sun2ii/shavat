{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":112,"content":[{"type":"heading","content":["Salig är den som vördar Herren"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Halleluja!","poem":1},{"text":"Salig är den som vördar Herren","poem":2},{"text":"och har stor glädje i hans bud.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Hans ättlingar","poem":1},{"text":"blir mäktiga på jorden,","poem":3},{"text":"de ärligas släkte blir välsignat.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Rikedom och välstånd","poem":1},{"text":"råder i hans hus,","poem":3},{"text":"hans rättfärdighet består för evigt.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"För de ärliga går han upp","poem":1},{"text":"som ett ljus i mörkret,","poem":3},{"text":"nådig, barmhärtig och rättfärdig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Det går väl för","poem":1},{"noteId":310},{"text":"den","poem":1},{"text":"som är barmhärtig och lånar ut,","poem":3},{"text":"som sköter sina saker","poem":2},{"text":"med rättfärdighet.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han ska aldrig vackla,","poem":1},{"text":"den rättfärdige blir ihågkommen","poem":2},{"text":"för evigt.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han är inte rädd för olycksbud,","poem":1},{"text":"hans hjärta är frimodigt","poem":2},{"text":"och litar på Herren.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Hans hjärta är tryggt","poem":1},{"text":"och utan fruktan,","poem":3},{"text":"till sist får han se sina fiender falla.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han strör ut, han ger åt de fattiga,","poem":1},{"text":"hans rättfärdighet består","poem":2},{"text":"för evigt.","poem":3},{"text":"Hans horn ska höjas högt med ära.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Den gudlöse ser det","poem":1},{"text":"och grämer sig,","poem":3},{"text":"han gnisslar tänder","poem":2},{"text":"och tynar bort.","poem":3},{"text":"De gudlösas begär","poem":2},{"text":"blir det ingenting av.","poem":3}]}],"footnotes":[{"noteId":310,"caller":"-","text":"Det går väl förAnnan översättning: \"God är\".","reference":{"chapter":112,"verse":5}}]},"thisChapterLink":"/api/swe_fol/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}