mber":7,"content":[{"text":"Han reser den ringe ur stoftet","poem":1},{"text":"och lyfter den fattige ur dyn","poem":2}]},{"type":"verse","number":8,"content":[{"text":"för att sätta honom bland furstar,","poem":1},{"text":"bland sitt folks furstar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han ger den ofruktsamma ett hem","poem":1},{"text":"som en lycklig mor med barn.","poem":2},{"text":"Halleluja!","poem":3}]}],"footnotes":[{"noteId":311,"caller":"-","text":"vem i himlen och på jordenAnnan översättning: \"i himlen och på jorden\".","reference":{"chapter":113,"verse":6}}]},"thisChapterLink":"/api/swe_fol/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}