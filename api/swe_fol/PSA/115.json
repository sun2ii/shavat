{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":115,"content":[{"type":"heading","content":["All ära åt Herren"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Inte oss, Herre, inte oss","poem":1},{"text":"utan ditt namn ska du ge ära,","poem":3},{"text":"för din nåds","poem":2},{"text":"och din sannings skull.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Varför ska hednafolken få säga:","poem":1},{"text":"\"Var är deras Gud?\"","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vår Gud är i himlen,","poem":1},{"text":"han gör allt han vill.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Men deras avgudar","poem":1},{"text":"är silver och guld,","poem":3},{"text":"verk av människohänder.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"De har mun men kan inte tala,","poem":1},{"text":"ögon men kan inte se.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"De har öron men kan inte höra,","poem":1},{"text":"näsa men kan inte lukta,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"händer men kan inte känna,","poem":1},{"text":"fötter men kan inte gå.","poem":2},{"text":"I sin strupe har de inget ljud.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De som har gjort dem blir som de,","poem":1},{"text":"likaså alla som litar till dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Israel, lita på Herren!","poem":1},{"text":"Han är deras hjälp och sköld.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Arons hus, lita på Herren!","poem":1},{"text":"Han är deras hjälp och sköld.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ni som vördar Herren,","poem":1},{"text":"lita på Herren!","poem":3},{"text":"Han är deras hjälp och sköld.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Herren tänker på oss,","poem":1},{"text":"han välsignar –","poem":3},{"text":"han välsignar Israels hus,","poem":2},{"text":"han välsignar Arons hus,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"han välsignar dem","poem":1},{"text":"som vördar Herren,","poem":3},{"text":"både små och stora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Herren ska föröka er,","poem":1},{"text":"er och era barn.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ni är välsignade av Herren","poem":1},{"text":"som har gjort himmel och jord.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Himlen är Herrens himmel,","poem":1},{"text":"och jorden har han gett","poem":2},{"text":"åt människors barn.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"De döda prisar inte Herren,","poem":1},{"text":"ingen som gått ner i det tysta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Men vi, vi lovar Herren","poem":1},{"text":"från nu och till evig tid.","poem":2},{"text":"Halleluja!","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}