{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":116,"content":[{"type":"heading","content":["Lovsång för räddning ur dödsfara"]},{"type":"verse","number":1,"content":[{"text":"Jag älskar Herren,","poem":1},{"text":"för han hör min röst,","poem":2},{"text":"mitt rop om nåd.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Han har vänt sitt öra till mig,","poem":1},{"text":"hela mitt liv","poem":2},{"text":"ska jag åkalla honom.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Dödens band omslöt mig,","poem":1},{"text":"dödsrikets ångest grep mig,","poem":3},{"text":"jag var i nöd och förtvivlan.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Men jag åkallade Herrens namn:","poem":1},{"text":"\"O, Herre, rädda min själ!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Herren är nådig och rättfärdig,","poem":1},{"text":"vår Gud är barmhärtig.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Herren bevarar de enkla,","poem":1},{"text":"jag var i nöd och han frälste mig.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Vänd om till din ro, min själ,","poem":1},{"text":"för Herren har varit god mot dig.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Du har räddat min själ från döden,","poem":1},{"text":"mitt öga från tårar, min fot från fall.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jag ska vandra inför Herren","poem":1},{"text":"i de levandes land.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jag tror, därför talar jag,","poem":1},{"text":"jag som plågades svårt,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"jag som sade i min ångest:","poem":1},{"text":"\"Alla människor sviker","poem":2},{"noteId":313},{"text":".\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hur ska jag återgälda Herren","poem":1},{"text":"alla hans välgärningar mot mig?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Jag vill höja frälsningens bägare","poem":1},{"text":"och åkalla Herrens namn,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"jag vill uppfylla","poem":1},{"text":"mina löften till Herren","poem":2},{"text":"inför hela hans folk.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Dyrbar i Herrens ögon","poem":1},{"text":"är hans trognas död.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"O, Herre, jag är ju din tjänare,","poem":1},{"text":"jag är din tjänare,","poem":2},{"text":"din tjänarinnas son.","poem":3},{"text":"Du har lossat mina band.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Åt dig vill jag offra lovets offer","poem":1},{"text":"och åkalla Herrens namn,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"jag vill uppfylla","poem":1},{"text":"mina löften till Herren","poem":2},{"text":"inför hela hans folk,","poem":3}]},{"type":"verse","number":19,"content":[{"text":"i gårdarna till Herrens hus,","poem":1},{"text":"mitt i dig, Jerusalem.","poem":2},{"text":"Halleluja!","poem":3}]}],"footnotes":[{"noteId":313,"caller":"-","text":"svikerAnnan översättning: \"ljuger\".","reference":{"chapter":116,"verse":11}}]},"thisChapterLink":"/api/swe_fol/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}