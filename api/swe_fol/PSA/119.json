{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":119,"content":[{"type":"heading","content":["Den troendes tröst i Herrens ord"]},{"type":"verse","number":1,"content":[{"text":"Saliga är de som vandrar","poem":1},{"text":"i fullkomlighet,","poem":3},{"text":"som lever efter Herrens","poem":2},{"text":"undervisning.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Saliga är de som tar vara","poem":1},{"text":"på hans vittnesbörd,","poem":3},{"text":"som söker honom","poem":2},{"text":"av hela sitt hjärta,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"som inte gör orätt","poem":1},{"text":"utan vandrar på hans vägar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Du har gett dina befallningar","poem":1},{"text":"för att de ska hållas noga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Om bara mina vägar var rätta","poem":1},{"text":"så att jag höll dina stadgar!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Då skulle jag inte skämmas","poem":1},{"text":"när jag tänker på alla dina bud.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag vill tacka dig med ärligt hjärta","poem":1},{"text":"när jag lär mig dina rättfärdiga","poem":2},{"text":"domar.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Dina stadgar vill jag hålla.","poem":1},{"text":"Överge mig aldrig!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hur kan den som är ung","poem":1},{"text":"hålla sitt liv rent?","poem":3},{"text":"Genom att hålla sig till ditt ord.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jag söker dig av hela mitt hjärta.","poem":1},{"text":"Låt mig inte villas bort","poem":2},{"text":"från dina bud.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Jag gömmer ditt ord i mitt hjärta","poem":1},{"text":"för att jag inte ska synda mot dig.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lovad är du, Herre!","poem":1},{"text":"Lär mig dina stadgar.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Med mina läppar förkunnar jag","poem":1},{"text":"din muns alla domar.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jag jublar över dina vittnesbörds väg","poem":1},{"text":"som över stora skatter.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jag ska begrunda","poem":1},{"text":"dina befallningar","poem":3},{"text":"och tänka på dina vägar.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jag har min glädje i dina stadgar,","poem":1},{"text":"jag glömmer inte ditt ord.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Var god mot din tjänare,","poem":1},{"text":"så att jag får leva","poem":2},{"text":"och hålla mig till ditt ord.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Öppna mina ögon,","poem":1},{"text":"så att jag ser undren","poem":2},{"text":"i din undervisning.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Jag är en främling på jorden.","poem":1},{"text":"Dölj inte dina bud för mig!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Min själ förtärs","poem":1},{"text":"av ständig längtan","poem":2},{"text":"efter dina domar.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Du tillrättavisar de fräcka,","poem":1},{"text":"de förbannade som villar bort sig","poem":2},{"text":"från dina bud.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Ta bort vanära och förakt från mig,","poem":1},{"text":"för jag tar vara på dina vittnesbörd.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Även om furstar sitter","poem":1},{"text":"och rådslår mot mig,","poem":3},{"text":"begrundar din tjänare dina stadgar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dina vittnesbörd är min glädje,","poem":1},{"text":"de är mina rådgivare.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Min själ ligger nertryckt i stoftet.","poem":1},{"text":"Ge mig liv","poem":2},{"noteId":324},{"text":"efter ditt ord!","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Jag berättade om mina vägar","poem":1},{"text":"och du svarade mig.","poem":3},{"text":"Lär mig dina stadgar!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Lär mig förstå","poem":1},{"text":"dina befallningars väg,","poem":3},{"text":"så vill jag begrunda dina under.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Min själ gråter av sorg.","poem":1},{"text":"Upprätta mig efter ditt ord!","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Låt lögnens väg","poem":1},{"text":"vara långt ifrån mig,","poem":3},{"text":"och skänk mig i nåd","poem":2},{"text":"din undervisning.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Sanningens väg har jag valt,","poem":1},{"text":"dina domar har jag för ögonen.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Jag håller mig","poem":1},{"text":"till dina vittnesbörd.","poem":3},{"text":"Låt mig inte behöva skämmas,","poem":2},{"text":"Herre!","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Jag vill löpa dina budords väg,","poem":1},{"text":"för du vidgar mitt hjärta.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Visa mig, Herre,","poem":1},{"text":"dina stadgars väg,","poem":3},{"text":"så vill jag följa den","poem":2},{"text":"ända till slutet.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Ge mig förstånd,","poem":1},{"text":"så att jag tar vara","poem":2},{"text":"på din undervisning","poem":3},{"text":"och håller fast vid den","poem":2},{"text":"av hela mitt hjärta.","poem":3}]},{"type":"verse","number":35,"content":[{"text":"Led mig på dina budords stig,","poem":1},{"text":"jag älskar den.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Vänd mitt hjärta","poem":1},{"text":"till dina vittnesbörd","poem":3},{"text":"och inte till egen vinning.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Vänd bort mina ögon","poem":1},{"text":"från förgängliga ting,","poem":3},{"text":"ge mig liv på din väg","poem":2},{"noteId":325},{"text":".","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Uppfyll ditt ord till din tjänare","poem":1},{"text":"så att han vördar dig.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Vänd bort den vanära","poem":1},{"text":"som jag fruktar,","poem":3},{"text":"för dina domar är goda.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Jag längtar","poem":1},{"text":"efter dina befallningar.","poem":3},{"text":"Ge mig liv","poem":2},{"text":"genom din rättfärdighet.","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Låt din nåd komma över mig,","poem":1},{"text":"Herre,","poem":3},{"text":"och din frälsning enligt ditt ord.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Då kan jag svara","poem":1},{"text":"den som hånar mig,","poem":3},{"text":"för jag litar på ditt ord.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Ryck aldrig sanningens ord","poem":1},{"text":"från min mun,","poem":3},{"text":"för jag hoppas på dina domar.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Jag vill alltid följa din undervisning,","poem":1},{"text":"för alltid och för evigt.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Jag kan gå fram på rymlig plats,","poem":1},{"text":"för jag begrundar dina befallningar.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Jag ska tala inför kungar","poem":1},{"text":"om dina vittnesbörd","poem":3},{"text":"och inte skämmas.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Jag har min glädje i dina bud","poem":1},{"text":"som jag älskar.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Jag lyfter mina händer","poem":1},{"text":"mot dina bud som jag älskar,","poem":3},{"text":"jag begrundar dina stadgar.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Tänk på ditt ord till din tjänare,","poem":1},{"text":"för du har gett mig hopp","poem":2},{"noteId":326},{"text":".","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Det är min tröst i mitt lidande","poem":1},{"text":"att ditt ord ger mig liv.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"De fräcka hånar mig ständigt,","poem":1},{"text":"men jag viker inte","poem":2},{"text":"från din undervisning.","poem":3}]},{"type":"verse","number":52,"content":[{"text":"Jag tänker på dina domar","poem":1},{"text":"i forna tider, Herre,","poem":3},{"text":"och jag finner tröst.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Jag grips av glödande vrede","poem":1},{"text":"över de gudlösa,","poem":3},{"text":"de som överger din undervisning.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Dina stadgar är mina lovsånger","poem":1},{"text":"i huset där jag bor.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"I natten tänker jag","poem":1},{"text":"på ditt namn, Herre.","poem":3},{"text":"Jag följer din undervisning.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Det har förunnats mig","poem":1},{"text":"att ta","poem":2},{"noteId":327},{"text":"vara på dina befallningar.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Du är min lott, Herre.","poem":1},{"text":"Jag har lovat att hålla dina ord.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Av hela mitt hjärta","poem":1},{"text":"bönfaller jag dig:","poem":3},{"text":"förbarma dig över mig","poem":2},{"text":"enligt ditt ord!","poem":3}]},{"type":"verse","number":59,"content":[{"text":"Jag tänker över mina vägar","poem":1},{"text":"och vänder mina steg","poem":2},{"text":"till dina vittnesbörd.","poem":3}]},{"type":"verse","number":60,"content":[{"text":"Jag skyndar mig och dröjer inte","poem":1},{"text":"att hålla dina bud.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"De gudlösas snaror omger mig,","poem":1},{"text":"men jag glömmer inte","poem":2},{"text":"din undervisning.","poem":3}]},{"type":"verse","number":62,"content":[{"text":"Mitt i natten går jag upp","poem":1},{"text":"för att tacka dig","poem":3},{"text":"för dina rättfärdiga domar.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Jag håller mig till alla","poem":1},{"text":"som vördar dig,","poem":2},{"text":"som följer dina befallningar.","poem":3}]},{"type":"verse","number":64,"content":[{"text":"Din nåd, Herre, uppfyller jorden.","poem":1},{"text":"Lär mig dina stadgar!","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Du gör gott mot din tjänare, Herre,","poem":1},{"text":"enligt ditt ord.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Lär mig gott förstånd och kunskap","poem":1},{"noteId":328},{"text":",","poem":1},{"text":"för jag litar på dina bud.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Innan jag fick lida gick jag vilse,","poem":1},{"text":"men nu tar jag vara på ditt ord.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Du är god och gör det goda.","poem":1},{"text":"Lär mig dina stadgar!","poem":2}]},{"type":"verse","number":69,"content":[{"text":"De fräcka svärtar ner mig","poem":1},{"text":"med lögner,","poem":3},{"text":"men jag vill helhjärtat","poem":2},{"text":"hålla dina befallningar.","poem":3}]},{"type":"verse","number":70,"content":[{"text":"Deras hjärtan är okänsliga","poem":1},{"text":"som fett,","poem":3},{"text":"men jag har min glädje","poem":2},{"text":"i din undervisning.","poem":3}]},{"type":"verse","number":71,"content":[{"text":"Det gjorde mig gott att få lida,","poem":1},{"text":"så att jag fick lära mig","poem":2},{"text":"dina stadgar.","poem":3}]},{"type":"verse","number":72,"content":[{"text":"Din muns undervisning","poem":1},{"text":"är bättre för mig","poem":3},{"text":"än tusentals mynt av guld","poem":2},{"text":"och silver.","poem":3}]},{"type":"verse","number":73,"content":[{"text":"Dina händer har gjort mig","poem":1},{"text":"och format mig.","poem":3},{"text":"Ge mig förstånd","poem":2},{"text":"så att jag lär mig dina bud.","poem":3}]},{"type":"verse","number":74,"content":[{"text":"De som vördar dig","poem":1},{"text":"ska se mig och glädjas,","poem":3},{"text":"för jag hoppas på ditt ord.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Herre, jag vet","poem":1},{"text":"att dina domar är rättfärdiga,","poem":2},{"text":"att du har tuktat mig i trofasthet.","poem":3}]},{"type":"verse","number":76,"content":[{"text":"Låt din nåd bli min tröst,","poem":1},{"text":"så som du har lovat din tjänare.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Låt din barmhärtighet","poem":1},{"text":"komma över mig så att jag får liv,","poem":3},{"text":"för din undervisning är min glädje.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Låt de fräcka få skämmas!","poem":1},{"text":"De gör mig orätt utan orsak,","poem":3},{"text":"men jag vill begrunda","poem":2},{"text":"dina befallningar.","poem":3}]},{"type":"verse","number":79,"content":[{"text":"Låt dem som vördar dig","poem":1},{"text":"och känner dina vittnesbörd","poem":3},{"text":"vända sig till mig.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Låt mitt hjärta följa dina stadgar","poem":1},{"text":"fullkomligt,","poem":3},{"text":"så att jag inte måste skämmas.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"Min själ längtar efter din frälsning,","poem":1},{"text":"jag hoppas på ditt ord.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Mina ögon längtar efter ditt ord,","poem":1},{"text":"jag undrar: När ska du trösta mig?","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Jag är som en vinsäck i rök","poem":1},{"noteId":329},{"text":",","poem":1},{"text":"men jag glömmer inte dina stadgar.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Hur få är inte din tjänares dagar!","poem":1},{"text":"När ska du döma mina förföljare?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"De fräcka gräver gropar för mig,","poem":1},{"text":"de lever inte efter din undervisning.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Alla dina bud är sanning.","poem":1},{"text":"De jagar mig utan orsak,","poem":2},{"text":"hjälp mig!","poem":3}]},{"type":"verse","number":87,"content":[{"text":"De har nästan utplånat mig","poem":1},{"text":"från jorden,","poem":3},{"text":"men jag överger inte","poem":2},{"text":"dina befallningar.","poem":3}]},{"type":"verse","number":88,"content":[{"text":"Ge mig liv efter din nåd!","poem":1},{"text":"Jag vill ta vara på din muns","poem":2},{"text":"vittnesbörd.","poem":3}]},{"type":"verse","number":89,"content":[{"text":"För evigt, Herre,","poem":1},{"text":"står ditt ord fast i himlen.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Från släkte till släkte","poem":1},{"text":"varar din trofasthet.","poem":3},{"text":"Du har grundat jorden","poem":2},{"text":"och den ska bestå.","poem":3},{"noteId":330}]},{"type":"verse","number":91,"content":[{"text":"Genom dina domar","poem":1},{"text":"består den","poem":3},{"noteId":331},{"text":"än i dag,","poem":3},{"text":"för allting måste tjäna dig.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Om inte din undervisning","poem":1},{"text":"var min glädje,","poem":3},{"text":"skulle jag gå under i mitt lidande.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Jag ska aldrig glömma","poem":1},{"text":"dina befallningar,","poem":3},{"text":"för genom dem ger du mig liv.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Jag är din, fräls mig,","poem":1},{"text":"för jag begrundar dina befallningar.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"De gudlösa vaktar på mig","poem":1},{"text":"för att förgöra mig,","poem":3},{"text":"men jag aktar på dina vittnesbörd.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"På all fullkomlighet","poem":1},{"text":"har jag sett en gräns,","poem":3},{"text":"men ditt bud är ofantligt.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"Vad jag älskar din undervisning!","poem":1},{"text":"Hela dagen begrundar jag den.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Dina bud gör mig visare","poem":1},{"text":"än mina fiender,","poem":3},{"text":"de är hos mig för evigt.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Jag är klokare än alla mina lärare,","poem":1},{"text":"för jag begrundar dina vittnesbörd.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Jag förstår mer än de gamla,","poem":1},{"text":"för jag håller dina befallningar.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Jag håller mina fötter borta","poem":1},{"text":"från varje ond väg","poem":4},{"text":"för att följa ditt ord.","poem":3}]},{"type":"verse","number":102,"content":[{"text":"Jag viker inte från dina domar,","poem":1},{"text":"för du undervisar mig.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Vad ljuvligt ditt ord är","poem":1},{"text":"på min tunga,","poem":3},{"text":"sötare än honung i min mun!","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Av dina befallningar","poem":1},{"text":"får jag förstånd,","poem":3},{"text":"därför hatar jag lögnens alla vägar.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"Ditt ord är mina fötters lykta","poem":1},{"text":"och ett ljus på min stig.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Jag har gett min ed och hållit den:","poem":1},{"text":"att följa dina rättfärdiga domar.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Jag är svårt plågad, Herre.","poem":1},{"text":"Ge mig liv enligt ditt ord!","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Låt min muns frivilliga offer","poem":1},{"text":"glädja dig, Herre,","poem":3},{"text":"och lär mig dina domar.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Mitt liv är ständigt i min hand,","poem":1},{"noteId":332},{"text":"men jag glömmer inte","poem":2},{"text":"din undervisning.","poem":3}]},{"type":"verse","number":110,"content":[{"text":"De gudlösa lägger snaror för mig,","poem":1},{"text":"men jag villas inte bort","poem":2},{"text":"från dina befallningar.","poem":3}]},{"type":"verse","number":111,"content":[{"text":"Jag har fått dina vittnesbörd","poem":1},{"text":"som min eviga arvedel.","poem":3},{"text":"De är mitt hjärtas fröjd.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Jag har vänt mitt hjärta","poem":1},{"text":"till att följa dina stadgar","poem":2},{"text":"för evigt, ända till slutet","poem":3},{"noteId":333},{"text":".","poem":3}]},{"type":"verse","number":113,"content":[{"text":"Jag hatar dem som vacklar","poem":1},{"text":"hit och dit,","poem":3},{"text":"men din undervisning älskar jag.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Du är mitt skydd och min sköld,","poem":1},{"text":"jag hoppas på ditt ord.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Försvinn ifrån mig,","poem":1},{"text":"ni som gör det onda!","poem":3},{"text":"Jag vill hålla min Guds bud.","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Stöd mig enligt ditt ord","poem":1},{"text":"så att jag får leva,","poem":3},{"text":"låt mig inte behöva skämmas","poem":2},{"text":"med mitt hopp.","poem":3}]},{"type":"verse","number":117,"content":[{"text":"Stärk mig så att jag blir frälst","poem":1},{"text":"och ständigt får fokusera på","poem":2},{"text":"dina stadgar.","poem":3}]},{"type":"verse","number":118,"content":[{"text":"Du förkastar","poem":1},{"text":"alla som villar bort sig","poem":2},{"text":"från dina stadgar,","poem":3},{"text":"för de är falska och svekfulla","poem":2},{"noteId":334},{"text":".","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Jordens alla gudlösa","poem":1},{"text":"röjer du bort","poem":3},{"noteId":335},{"text":"som slagg.","poem":3},{"text":"Därför älskar jag dina vittnesbörd.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Mitt kött ryser av fruktan för dig,","poem":1},{"text":"jag bävar för dina domar.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"Jag har gjort vad som är rätt","poem":1},{"text":"och rättfärdigt.","poem":3},{"text":"Utlämna mig inte","poem":2},{"text":"åt mina förtryckare!","poem":3}]},{"type":"verse","number":122,"content":[{"text":"Gå i god för din tjänare","poem":1},{"text":"och låt det gå honom väl.","poem":3},{"text":"Låt inte de fräcka förtrycka mig!","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Mina ögon längtar","poem":1},{"text":"efter din frälsning,","poem":3},{"text":"efter din rättfärdighets ord.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Handla med din tjänare","poem":1},{"text":"efter din nåd","poem":3},{"text":"och lär mig dina stadgar.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Jag är din tjänare,","poem":1},{"text":"ge mig förstånd","poem":3},{"text":"så att jag lär känna dina vittnesbörd.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Tiden är inne för Herren","poem":1},{"text":"att handla,","poem":3},{"text":"de har upphävt din undervisning.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Därför älskar jag dina bud","poem":1},{"text":"mer än guld, än renaste guld.","poem":2}]},{"type":"verse","number":128,"content":[{"text":"Därför ger jag","poem":1},{"text":"alla dina befallningar rätt.","poem":3},{"noteId":336},{"text":"Jag hatar lögnens alla vägar.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"Underbara är dina vittnesbörd,","poem":1},{"text":"därför tar min själ vara på dem.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"När dina ord öppnas, ger de ljus","poem":1},{"text":"och förstånd åt enkla människor.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Jag öppnar min mun och flämtar,","poem":1},{"text":"för jag längtar efter dina bud.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Vänd dig till mig","poem":1},{"text":"och förbarma dig över mig,","poem":3},{"text":"så som du gör med dem","poem":2},{"text":"som älskar ditt namn.","poem":3}]},{"type":"verse","number":133,"content":[{"text":"Gör mina steg fasta","poem":1},{"text":"genom ditt ord,","poem":3},{"text":"låt ingen ondska","poem":2},{"text":"få makt över mig.","poem":3}]},{"type":"verse","number":134,"content":[{"text":"Befria mig från människors","poem":1},{"text":"förtryck!","poem":3},{"text":"Jag vill hålla fast vid","poem":2},{"text":"dina befallningar.","poem":3}]},{"type":"verse","number":135,"content":[{"text":"Låt ditt ansikte lysa","poem":1},{"text":"över din tjänare","poem":3},{"text":"och lär mig dina stadgar.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Strömmar av tårar","poem":1},{"text":"rinner från mina ögon,","poem":3},{"text":"för de tar inte vara på","poem":2},{"text":"din undervisning.","poem":3}]},{"type":"verse","number":137,"content":[{"text":"Herre, du är rättfärdig","poem":1},{"text":"och dina domar är rätta.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Du har gett dina vittnesbörd","poem":1},{"text":"i rättfärdighet och stor trofasthet.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Jag förtärs av brinnande iver,","poem":1},{"text":"för mina fiender glömmer dina ord.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Ditt ord är fullkomligt rent,","poem":1},{"text":"din tjänare älskar det.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Jag är ringa","poem":1},{"noteId":337},{"text":"och föraktad,","poem":1},{"text":"men jag glömmer inte","poem":2},{"text":"dina befallningar.","poem":3}]},{"type":"verse","number":142,"content":[{"text":"Din rättfärdighet","poem":1},{"text":"är en evig rättfärdighet,","poem":3},{"text":"din undervisning är sanning.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Nöd och ångest griper mig,","poem":1},{"text":"men dina bud är min glädje.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Dina vittnesbörd","poem":1},{"text":"är rättfärdiga för evigt.","poem":3},{"text":"Ge mig förstånd så att jag får leva.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"Jag ropar av hela mitt hjärta,","poem":1},{"text":"svara mig, Herre!","poem":3},{"text":"Jag vill följa dina stadgar.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Jag ropar till dig, fräls mig!","poem":1},{"text":"Jag vill ta vara på","poem":2},{"text":"dina vittnesbörd.","poem":3}]},{"type":"verse","number":147,"content":[{"text":"Jag kommer i gryningen","poem":1},{"text":"och ropar,","poem":3},{"text":"jag hoppas på dina ord.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Med öppna ögon","poem":1},{"text":"möter jag nattens timmar","poem":3},{"text":"för att begrunda ditt ord.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Hör min röst enligt din nåd,","poem":1},{"text":"Herre,","poem":3},{"text":"ge mig liv enligt din dom.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Nära är de som jagar","poem":1},{"text":"efter skamliga ting,","poem":3},{"text":"de som är långt från","poem":2},{"text":"din undervisning.","poem":3}]},{"type":"verse","number":151,"content":[{"text":"Nära är också du, Herre,","poem":1},{"text":"och alla dina bud är sanning.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Sedan länge vet jag","poem":1},{"text":"genom dina vittnesbörd","poem":3},{"text":"att du har fastställt dem för evig tid.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"Se mitt lidande och rädda mig,","poem":1},{"text":"för jag glömmer inte","poem":2},{"text":"din undervisning.","poem":3}]},{"type":"verse","number":154,"content":[{"text":"Ta dig an min sak","poem":1},{"text":"och återlös mig,","poem":3},{"text":"ge mig liv enligt ditt ord.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Frälsningen är fjärran","poem":1},{"text":"från de gudlösa,","poem":3},{"text":"för de frågar inte","poem":2},{"text":"efter dina stadgar.","poem":3}]},{"type":"verse","number":156,"content":[{"text":"Herre, din barmhärtighet är stor.","poem":1},{"text":"Ge mig liv enligt dina domar!","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Mina förföljare och fiender","poem":1},{"text":"är många,","poem":3},{"text":"men jag viker inte","poem":2},{"text":"från dina vittnesbörd.","poem":3}]},{"type":"verse","number":158,"content":[{"text":"Jag ser de trolösa","poem":1},{"text":"och avskyr dem,","poem":3},{"text":"för de håller sig inte","poem":2},{"text":"till ditt ord.","poem":3}]},{"type":"verse","number":159,"content":[{"text":"Se hur jag älskar","poem":1},{"text":"dina befallningar!","poem":3},{"text":"Herre, ge mig liv efter din nåd.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Summan av ditt ord är sanning.","poem":1},{"text":"Dina rättfärdiga domar är eviga.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"Furstar förföljer mig utan orsak,","poem":1},{"text":"men mitt hjärta fruktar ditt ord.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Jag jublar över ditt ord","poem":1},{"text":"likt den som finner stort byte.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Jag hatar och avskyr lögnen,","poem":1},{"text":"men din undervisning älskar jag.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Jag prisar dig","poem":1},{"text":"sju gånger om dagen","poem":3},{"text":"för dina rättfärdiga domar.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Stor frid har de","poem":1},{"text":"som älskar din undervisning,","poem":3},{"text":"inget kan få dem på fall.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Jag hoppas på din frälsning,","poem":1},{"text":"Herre,","poem":3},{"text":"och handlar efter dina bud.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Min själ håller fast","poem":1},{"text":"vid dina vittnesbörd,","poem":3},{"text":"jag älskar dem djupt.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Jag håller fast vid dina","poem":1},{"text":"befallningar och vittnesbörd.","poem":3},{"text":"Du känner alla mina vägar.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"Låt mitt rop komma inför dig,","poem":1},{"text":"Herre!","poem":3},{"text":"Ge mig förstånd enligt ditt ord.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Låt min bön komma inför dig,","poem":1},{"text":"rädda mig enligt ditt ord.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Mina läppar ska flöda av lovsång,","poem":1},{"text":"för du lär mig dina stadgar.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Min tunga ska sjunga om ditt ord,","poem":1},{"text":"alla dina bud är rättfärdiga.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Låt din hand bli min hjälp,","poem":1},{"text":"för jag har valt dina befallningar.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Jag längtar efter din frälsning,","poem":1},{"text":"Herre,","poem":3},{"text":"din undervisning är min glädje.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Låt min själ leva och lova dig,","poem":1},{"text":"låt dina domar hjälpa mig.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Jag har gått vilse","poem":1},{"text":"som ett förlorat får.","poem":3},{"text":"Sök upp din tjänare,","poem":2},{"text":"för jag har inte glömt dina bud.","poem":3}]}],"footnotes":[{"noteId":324,"caller":"-","text":"ge mig livAnnan översättning: \"håll mig vid liv\" (även i 119:37, 40, 50, 88, 93, 107, 149, 154, 156, 159).","reference":{"chapter":119,"verse":25}},{"noteId":325,"caller":"-","text":"på din vägAndra handskrifter: \"genom ditt ord\".","reference":{"chapter":119,"verse":37}},{"noteId":326,"caller":"-","text":"för du har gett mig hoppAnnan översättning: \"som du har gett mig att hoppas på\".","reference":{"chapter":119,"verse":49}},{"noteId":327,"caller":"-","text":"mig att taAnnan översättning: \"mig, för jag tar\".","reference":{"chapter":119,"verse":56}},{"noteId":328,"caller":"-","text":"gott förstånd och kunskapAnnan översättning (så Septuaginta): \"godhet, förstånd och kunskap\".","reference":{"chapter":119,"verse":66}},{"noteId":329,"caller":"-","text":"som en vinsäck i rökSkrumpnad och märkt av rök och hetta där den hänger över elden.","reference":{"chapter":119,"verse":83}},{"noteId":330,"caller":"-","text":"Du har grundat jorden och den ska beståAnnan översättning: \"Du grundade jorden och den stod där\".","reference":{"chapter":119,"verse":90}},{"noteId":331,"caller":"-","text":"Genom dina domar består denAnnan översättning: \"För dina domars skull består den\" eller \"Dina domar består\".","reference":{"chapter":119,"verse":91}},{"noteId":332,"caller":"-","text":"Mitt liv är ständigt i min handDvs jag svävar i livsfara.","reference":{"chapter":119,"verse":109}},{"noteId":333,"caller":"-","text":"för evigt, ända till slutetAnnan översättning (så Septuaginta): \"– lönen är evig\".","reference":{"chapter":119,"verse":112}},{"noteId":334,"caller":"-","text":"de är falska och svekfullaAnnan översättning: \"deras svek är förgäves\".","reference":{"chapter":119,"verse":118}},{"noteId":335,"caller":"-","text":"röjer du bortAndra handskrifter: \"räknar du\".","reference":{"chapter":119,"verse":119}},{"noteId":336,"caller":"-","text":"ger jag alla dina befallningar rättAnnan översättning: \"rättar jag mig efter alla dina befallningar\".","reference":{"chapter":119,"verse":128}},{"noteId":337,"caller":"-","text":"ringaAnnan översättning: \"liten\" eller \"ung\".","reference":{"chapter":119,"verse":141}}]},"thisChapterLink":"/api/swe_fol/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}