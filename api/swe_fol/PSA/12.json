{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":12,"content":[{"type":"heading","content":["Klagan över växande ondska"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till sheminít.","descriptive":true},{"noteId":35},{"text":"En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Fräls, Herre!","poem":1},{"text":"De fromma är borta,","poem":2},{"text":"de trofasta är försvunna","poem":3},{"text":"bland människors barn.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"De ljuger för varandra,","poem":1},{"text":"de talar med hala läppar","poem":2},{"text":"och dubbelt hjärta.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Herre, utrota alla hala läppar","poem":1},{"text":"och tungan som talar stora ord,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"dem som säger:","poem":1},{"text":"\"Med vår tunga har vi makt,","poem":2},{"text":"våra läppar är med oss.","poem":3},{"text":"Vem är herre över oss?\"","poem":2},{"noteId":36}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"\"De svaga förtrycks","poem":1},{"text":"och de fattiga klagar –","poem":3},{"text":"nu griper jag in\", säger Herren,","poem":2},{"text":"\"jag ska ge frälsning","poem":3},{"text":"åt den som längtar efter det","poem":4},{"noteId":37},{"text":".\"","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Herrens ord är rena ord,","poem":1},{"text":"silver luttrat i degel av jord,","poem":2},{"text":"renat sju gånger.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Du, Herre, ska bevara dem,","poem":1},{"text":"du ska för evigt beskydda dem","poem":2},{"noteId":38},{"text":"från detta släkte.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Runt omkring går gudlösa fram,","poem":1},{"text":"när det usla hålls högt","poem":2},{"text":"bland människors barn.","poem":3}]}],"footnotes":[{"noteId":35,"caller":"-","text":"sheminítMusikalisk term, ordagrant \"den åttonde\". Antingen en åttasträngad lyra eller en lägre basoktav (i 1 Krön 15:20-21 kontrasterat mot alamót, ev sopran).","reference":{"chapter":12,"verse":1}},{"noteId":36,"caller":"-","text":"tunga … läpparBåda dessa ord kan användas i betydelsen \"språk\".","reference":{"chapter":12,"verse":5}},{"noteId":37,"caller":"-","text":"den som längtar efter detAnnan översättning: \"den som blir föraktad\".","reference":{"chapter":12,"verse":6}},{"noteId":38,"caller":"-","text":"beskydda demAndra handskrifter (så Septuaginta): \"beskydda oss\".","reference":{"chapter":12,"verse":8}}]},"thisChapterLink":"/api/swe_fol/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":9}