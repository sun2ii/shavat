ber":6,"content":[{"text":"Länge nog har min själ bott","poem":1},{"text":"bland dem som hatar frid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag vill ha frid,","poem":1},{"text":"men säger jag ett ord","poem":2},{"text":"är de redo till strid.","poem":3}]}],"footnotes":[{"noteId":338,"caller":"-","text":"pilgrimssångOrdagrant \"stigningssång\". Pilgrimssångerna (Ps 120-134) sjöngs av högtidsfirare på väg upp till templet i Jerusalem.","reference":{"chapter":120,"verse":1}},{"noteId":339,"caller":"-","text":"ginstkolfrån ginstbusken ger en särskilt stark och långvarig hetta.","reference":{"chapter":120,"verse":4}},{"noteId":340,"caller":"-","text":"Mesheks land … Kedars hyddorAvlägsna folk i östra Turkiet respektive Arabien.","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/swe_fol/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}