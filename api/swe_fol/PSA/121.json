:"om dagen,","poem":3},{"text":"inte månen om natten.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Herren ska bevara dig","poem":1},{"text":"från allt ont,","poem":3},{"text":"han ska bevara din själ.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Herren ska bevara","poem":1},{"text":"din utgång och din ingång,","poem":3},{"text":"från nu och till evig tid.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}