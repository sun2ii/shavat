{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":122,"content":[{"type":"heading","content":["Glädjen i att gå till Herrens hus"]},{"type":"verse","number":1,"content":[{"text":"En pilgrimssång av David.","descriptive":true},{"lineBreak":true},{"text":"Jag gladdes när man sade till mig:","poem":1},{"text":"\"Vi ska gå till Herrens hus.\"","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Våra fötter står","poem":1},{"text":"i dina portar, Jerusalem.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jerusalem, du välbyggda stad","poem":1},{"text":"som tätt sluter sig samman!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dit drar stammarna upp,","poem":1},{"text":"Herrens stammar,","poem":3},{"text":"som ett vittnesbörd för Israel","poem":2},{"text":"att prisa Herrens namn.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Där står domarsäten,","poem":1},{"text":"troner för Davids hus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Be om frid för Jerusalem!","poem":1},{"text":"Låt dem som älskar dig vara trygga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Låt det råda frid inom dina murar,","poem":1},{"text":"trygghet i dina borgar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"För mina bröders och vänners skull","poem":1},{"text":"vill jag önska dig frid,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"för Herren vår Guds hus skull","poem":1},{"text":"vill jag söka ditt bästa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}