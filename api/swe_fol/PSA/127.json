{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":127,"content":[{"type":"heading","content":["Allt beror på Herrens välsignelse"]},{"type":"verse","number":1,"content":[{"text":"En pilgrimssång av Salomo.","descriptive":true},{"lineBreak":true},{"text":"Om inte Herren bygger huset","poem":1},{"text":"bygger arbetarna förgäves.","poem":2},{"text":"Om inte Herren vaktar staden","poem":1},{"text":"vakar väktaren förgäves.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Förgäves går ni tidigt upp","poem":1},{"text":"och sent till vila,","poem":2},{"text":"ni som äter mödans bröd.","poem":3},{"text":"Detsamma ger han sina vänner","poem":2},{"text":"när de sover.","poem":3},{"noteId":344}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Se, barn är en Herrens gåva,","poem":1},{"text":"livsfrukt är en lön.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Som pilar i hjältens hand","poem":1},{"text":"är barn man får vid unga år.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lycklig är den man","poem":1},{"text":"vars koger är fyllt med dem.","poem":3},{"text":"De behöver inte skämmas","poem":2},{"text":"när de går till rätta med fiender","poem":3},{"text":"i porten.","poem":4}]}],"footnotes":[{"noteId":344,"caller":"-","text":"Detsamma ger han sina vänner när de soverAnnan översättning: \"På samma sätt ger han sina vänner sömn\".","reference":{"chapter":127,"verse":2}}]},"thisChapterLink":"/api/swe_fol/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}