issnar innan det rycks upp.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ingen skördeman","poem":1},{"text":"fyller sin hand med det,","poem":3},{"text":"ingen kärvbindare sin famn,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"och ingen som går förbi säger:","poem":1},{"text":"\"Må Herrens välsignelse","poem":2},{"text":"vila över er!","poem":3},{"text":"Vi välsignar er i Herrens namn.\"","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}