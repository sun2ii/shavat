{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":13,"content":[{"type":"heading","content":["I djup ångest"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hur länge, Herre?","poem":1},{"text":"Ska du glömma mig för evigt?","poem":3},{"text":"Hur länge ska du","poem":2},{"text":"dölja ditt ansikte för mig?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Hur länge ska jag ha oro i min själ","poem":1},{"text":"och ångest i mitt hjärta","poem":2},{"text":"dag efter dag?","poem":3},{"text":"Hur länge ska min fiende","poem":2},{"text":"triumfera över mig?","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Se mig, svara mig,","poem":1},{"text":"Herre min Gud!","poem":3},{"text":"Ge mina ögon ljus","poem":2},{"text":"så att jag inte somnar in i döden.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Låt inte min fiende säga:","poem":1},{"text":"\"Jag besegrade honom!\"","poem":3},{"text":"eller mina ovänner jubla","poem":2},{"text":"när jag vacklar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Men jag litar på din nåd,","poem":1},{"text":"mitt hjärta jublar","poem":2},{"text":"över din frälsning.","poem":3},{"text":"Jag vill sjunga till Herren,","poem":2},{"text":"för han är god mot mig.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}