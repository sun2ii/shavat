,","poem":2},{"text":"mer än väktarna efter morgonen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Israel, hoppas på Herren,","poem":1},{"text":"för hos Herren finns nåd,","poem":2},{"text":"full lösen finns hos honom.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Han ska friköpa Israel","poem":1},{"text":"från alla dess synder.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}