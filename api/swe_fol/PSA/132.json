{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":132,"content":[{"type":"heading","content":["Davids löfte och Herrens löfte"]},{"type":"verse","number":1,"content":[{"text":"En pilgrimssång.","descriptive":true},{"lineBreak":true},{"text":"Herre, tänk på David,","poem":1},{"text":"på allt han fick utstå,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"hur han gav Herren sin ed,","poem":1},{"text":"sitt löfte till Jakobs Mäktige:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"\"Jag ska inte gå in i mitt hus,","poem":1},{"text":"inte ligga på min bädd,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"inte unna mina ögon någon sömn","poem":1},{"text":"eller mina ögonlock någon vila","poem":2}]},{"type":"verse","number":5,"content":[{"text":"förrän jag funnit en plats åt Herren,","poem":1},{"text":"en boning åt Jakobs Mäktige.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vi hörde det i Efrata,","poem":1},{"text":"vi upptäckte det i skogsbygden","poem":2},{"noteId":346},{"text":".","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Låt oss gå in i hans boning,","poem":1},{"text":"låt oss tillbe vid hans fotpall.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Res dig, Herre,","poem":1},{"text":"och kom till din viloplats,","poem":2},{"text":"du och din makts ark!","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Låt dina präster vara klädda","poem":1},{"text":"i rättfärdighet","poem":3},{"text":"och dina trogna få jubla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"För din tjänare Davids skull,","poem":1},{"text":"avvisa inte din smorde!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Herren har gett David sin ed,","poem":1},{"text":"en sann ed som han","poem":2},{"text":"inte tar tillbaka:","poem":3},{"text":"\"En av dina ättlingar","poem":2},{"noteId":347},{"text":"ska jag sätta på din tron.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Om dina barn håller mitt förbund","poem":1},{"text":"och mitt vittnesbörd","poem":2},{"text":"som jag ska lära dem,","poem":3},{"text":"då ska också deras barn","poem":2},{"text":"sitta på din tron till evig tid.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ja, Herren har utvalt Sion,","poem":1},{"text":"där vill han ha sin boning:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"\"Detta är min viloplats till evig tid.","poem":1},{"text":"Här ska jag bo, hit längtar jag.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sions förråd ska jag rikligt välsigna,","poem":1},{"text":"dess fattiga ska jag mätta med bröd.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Dess präster ska jag","poem":1},{"text":"klä i frälsning","poem":3},{"text":"och dess trogna ska jubla högt.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Där ska jag låta ett horn","poem":1},{"noteId":348},{"text":"växa upp","poem":1},{"text":"åt David,","poem":3},{"text":"jag har berett en lampa","poem":2},{"text":"åt min smorde.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Hans fiender ska jag klä i skam,","poem":1},{"text":"men på honom","poem":2},{"text":"ska kronan glänsa.\"","poem":3}]}],"footnotes":[{"noteId":346,"caller":"-","text":"upptäckte det i skogsbygdenAnnan översättning: \"upptäckte den i Jaars bygd\", alltså förbundsarken. Jfr 1 Sam 6:21, 7:1, 2 Sam 6:3.","reference":{"chapter":132,"verse":6}},{"noteId":347,"caller":"-","text":"En av dina ättlingarOrdagrant: \"Av din livsfrukt\". Versen citeras av Petrus i Apg 2:30 som profetia om Jesus.","reference":{"chapter":132,"verse":11}},{"noteId":348,"caller":"-","text":"hornSymbol för styrka, för kungar (Dan 7-8, Upp 17:12) och för Messias (Luk 1:69).","reference":{"chapter":132,"verse":17}}]},"thisChapterLink":"/api/swe_fol/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}