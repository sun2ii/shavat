{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":135,"content":[{"type":"heading","content":["Herrens stora under"]},{"type":"verse","number":1,"content":[{"text":"Halleluja!","poem":1},{"text":"Prisa Herrens namn,","poem":2},{"text":"prisa det, ni Herrens tjänare","poem":3}]},{"type":"verse","number":2,"content":[{"text":"som står i Herrens hus,","poem":1},{"text":"i gårdarna till vår Guds hus!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Prisa Herren, för Herren är god,","poem":1},{"text":"lovsjung hans namn,","poem":2},{"text":"för det är ljuvligt.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Herren har utvalt Jakob åt sig,","poem":1},{"text":"Israel till sin egendom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jag vet att Herren är stor,","poem":1},{"text":"vår Herre är större än alla gudar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Allt vad Herren vill,","poem":1},{"text":"det gör han i himlen och på jorden,","poem":2},{"text":"i haven och i alla djup.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han låter moln stiga","poem":1},{"text":"vid jordens ände,","poem":3},{"text":"han sänder blixtar med regn","poem":2},{"text":"och skickar ut vinden","poem":3},{"text":"från sina förråd.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Han slog de förstfödda i Egypten,","poem":1},{"text":"både människor och boskap.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han sände tecken och under","poem":1},{"text":"mitt i dig, Egypten,","poem":3},{"text":"mot farao och alla hans tjänare.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Han slog många folk","poem":1},{"noteId":350},{"text":"och dödade mäktiga kungar –","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sichon, amoreernas kung,","poem":1},{"text":"Og, Bashans kung,","poem":2},{"text":"och Kanaans alla riken –","poem":3}]},{"type":"verse","number":12,"content":[{"text":"och gav deras land som arvedel,","poem":1},{"text":"till arvedel åt sitt folk Israel.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Herre, ditt namn består för evigt,","poem":1},{"text":"Herre, ditt rykte","poem":2},{"text":"från släkte till släkte,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"för Herren ska döma sitt folk","poem":1},{"text":"och förbarma sig","poem":2},{"text":"över sina tjänare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hednafolkens avgudar","poem":1},{"text":"är silver och guld,","poem":3},{"text":"verk av människohand.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"De har mun men kan inte tala,","poem":1},{"text":"ögon men kan inte se,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"öron men kan inte höra.","poem":1},{"text":"Ingen ande finns i deras mun.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"De som har gjort dem blir som de,","poem":1},{"text":"likaså alla som litar till dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Israels hus, lova Herren!","poem":1},{"text":"Arons hus, lova Herren!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Levis hus, lova Herren!","poem":1},{"text":"Ni som vördar Herren,","poem":2},{"text":"lova Herren!","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Lovad är Herren från Sion,","poem":1},{"text":"han som bor i Jerusalem.","poem":3},{"text":"Halleluja!","poem":2}]}],"footnotes":[{"noteId":350,"caller":"-","text":"många folkAnnan översättning: \"väldiga folk\".","reference":{"chapter":135,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}