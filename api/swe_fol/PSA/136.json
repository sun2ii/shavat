[{"text":"solen till att råda över dagen,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"månen och stjärnorna","poem":1},{"text":"till att råda över natten,","poem":3},{"text":"evig är hans nåd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Han slog de förstfödda i Egypten,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"och förde Israel ut därifrån,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"med stark hand och utsträckt arm,","poem":1},{"text":"evig är hans nåd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Han delade Röda havet mitt itu,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"och förde Israel igenom det,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"men skingrade farao","poem":1},{"text":"och hans här i Röda havet,","poem":3},{"text":"evig är hans nåd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Han förde sitt folk genom öknen,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"han slog stora kungar,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"och dräpte mäktiga kungar,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sichon, amoreernas kung,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"och Og, Bashans kung,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"och gav deras land som arvedel,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"som arvedel åt sin tjänare Israel,","poem":1},{"text":"evig är hans nåd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Han tänkte på oss i vår förnedring,","poem":1},{"text":"evig är hans nåd,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"och ryckte oss","poem":1},{"text":"ur våra fienders våld,","poem":3},{"text":"evig är hans nåd.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Han ger mat åt allt levande,","poem":1},{"text":"evig är hans nåd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Tacka himlens Gud,","poem":1},{"text":"evig är hans nåd!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}