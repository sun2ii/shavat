{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":137,"content":[{"type":"heading","content":["Vid Babels floder"]},{"type":"verse","number":1,"content":[{"text":"Vid Babels floder,","poem":1},{"text":"där satt vi och grät","poem":2},{"text":"när vi tänkte på Sion.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Där i pilträden","poem":1},{"text":"hängde vi våra harpor,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"för våra fångvaktare","poem":1},{"text":"bad oss sjunga,","poem":3},{"text":"våra plågare","poem":2},{"noteId":351},{"text":"bad oss vara glada:","poem":3},{"text":"\"Sjung för oss en av Sions sånger!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hur kan vi sjunga Herrens sång","poem":1},{"text":"i främmande land?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Glömmer jag dig, Jerusalem,","poem":1},{"text":"då ska min högra hand","poem":2},{"text":"glömma att spela.","poem":3},{"noteId":352}]},{"type":"verse","number":6,"content":[{"text":"Låt min tunga fastna i gommen","poem":1},{"text":"om jag inte tänker på dig,","poem":3},{"text":"om jag inte har Jerusalem","poem":2},{"text":"som min högsta glädje.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Herre, tänk på Jerusalems dag","poem":1},{"text":"då Edoms barn ropade:","poem":2},{"text":"\"Riv, riv ner ända till grunden!\"","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Dotter Babel, du fördärvade","poem":1},{"noteId":353},{"text":",","poem":1},{"text":"lycklig är den som får ge dig","poem":2},{"text":"för det du har gjort mot oss.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Lycklig är den","poem":1},{"text":"som får gripa dina späda barn","poem":2},{"text":"och krossa dem mot klippan.","poem":3}]}],"footnotes":[{"noteId":351,"caller":"-","text":"våra plågareAnnan översättning (så Septuaginta): \"de som fört bort oss\".","reference":{"chapter":137,"verse":3}},{"noteId":352,"caller":"-","text":"glömma att spelaOrdagrant: \"glömma\".","reference":{"chapter":137,"verse":5}},{"noteId":353,"caller":"-","text":"du fördärvadeAndra handskrifter: \"du fördärvare\".","reference":{"chapter":137,"verse":8}}]},"thisChapterLink":"/api/swe_fol/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}