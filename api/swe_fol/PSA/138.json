{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":138,"content":[{"type":"heading","content":["Tacksamhet för Herrens hjälp"]},{"type":"verse","number":1,"content":[{"text":"Av David.","descriptive":true},{"lineBreak":true},{"text":"Jag vill tacka dig av hela mitt hjärta,","poem":1},{"text":"lovsjunga dig inför gudarna.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jag vill tillbe inför ditt heliga tempel","poem":1},{"text":"och prisa ditt namn","poem":2},{"text":"för din nåd och din sanning,","poem":3},{"text":"för du har gjort ditt ord","poem":2},{"text":"och ditt namn större än allt.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"När jag ropade svarade du mig,","poem":1},{"text":"du gav mig frimodighet","poem":2},{"text":"och kraft i min själ.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Herre, jordens alla kungar","poem":1},{"text":"ska tacka dig","poem":3},{"text":"när de hör din muns ord.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"De ska sjunga om Herrens vägar,","poem":1},{"text":"för Herrens härlighet är stor.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Herren är upphöjd","poem":1},{"text":"men ser till den ringe.","poem":3},{"text":"Den högmodige känner han","poem":2},{"text":"fjärran ifrån.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"När jag går genom nöd","poem":1},{"text":"håller du mig vid liv,","poem":3},{"text":"du sträcker ut din hand","poem":2},{"text":"mot mina fienders vrede,","poem":3},{"text":"din högra hand frälser mig.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Herren ska fullborda sitt","poem":1},{"text":"verk för mig.","poem":3},{"text":"Herre, evig är din nåd.","poem":2},{"text":"Överge inte","poem":3},{"noteId":354},{"text":"dina händers verk!","poem":3}]}],"footnotes":[{"noteId":354,"caller":"-","text":"Överge inteAnnan översättning: \"Upphör inte med\".","reference":{"chapter":138,"verse":8}}]},"thisChapterLink":"/api/swe_fol/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}