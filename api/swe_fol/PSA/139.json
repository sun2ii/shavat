{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":139,"content":[{"type":"heading","content":["Herren känner mig"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true},{"lineBreak":true},{"text":"Herre, du rannsakar mig","poem":1},{"text":"och känner mig.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Om jag sitter eller står vet du det,","poem":1},{"text":"du förstår mina tankar fjärran ifrån.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Om jag går eller ligger ser du det,","poem":1},{"text":"med alla mina vägar","poem":2},{"text":"är du förtrogen.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Innan ordet är på min tunga","poem":1},{"text":"vet du, Herre, allt om det.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Du omsluter mig på alla sidor","poem":1},{"text":"och håller mig i din hand.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Den kunskapen är för underbar","poem":1},{"text":"för mig,","poem":3},{"text":"den är så hög att jag inte kan","poem":2},{"text":"fatta den.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vart kan jag gå för din Ande,","poem":1},{"text":"vart kan jag fly för ditt ansikte?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Stiger jag upp till himlen","poem":1},{"text":"är du där,","poem":3},{"text":"bäddar jag åt mig i dödsriket","poem":2},{"text":"är du där.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Tar jag morgonrodnadens vingar,","poem":1},{"text":"gör jag mig en boning","poem":2},{"text":"ytterst i havet,","poem":3}]},{"type":"verse","number":10,"content":[{"text":"ska också där din hand leda mig","poem":1},{"text":"och din högra hand hålla mig.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Säger jag:","poem":1},{"text":"\"Låt mörker täcka mig","poem":2},{"text":"och ljuset bli natt omkring mig\",","poem":3}]},{"type":"verse","number":12,"content":[{"text":"så är inte mörkret mörkt för dig.","poem":1},{"text":"Natten lyser som dagen,","poem":2},{"text":"mörkret är som ljuset.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Du har skapat mina njurar","poem":1},{"noteId":355},{"text":",","poem":1},{"text":"du vävde mig i moderlivet.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jag tackar dig för att","poem":1},{"text":"jag är så underbart skapad.","poem":3},{"text":"Underbara är dina verk,","poem":2},{"text":"min själ vet det så väl","poem":3},{"noteId":356},{"text":".","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Benen i min kropp","poem":1},{"text":"var inte osynliga för dig","poem":3},{"text":"när jag formades i det fördolda,","poem":2},{"text":"när jag bildades i jordens djup.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Dina ögon såg mig","poem":1},{"text":"när jag bara var ett foster.","poem":3},{"text":"Alla mina dagar blev skrivna","poem":2},{"text":"i din bok,","poem":3},{"text":"formade innan någon av dem","poem":2},{"text":"hade kommit.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hur ofattbara","poem":1},{"noteId":357},{"text":"är inte dina tankar","poem":1},{"text":"för mig, Gud,","poem":3},{"text":"hur väldig är inte","poem":2},{"text":"deras mångfald!","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Räknar jag dem","poem":1},{"text":"är de fler än sandkornen.","poem":3},{"text":"När jag vaknar är jag kvar hos dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Gud, om du bara ville döda","poem":1},{"text":"de gudlösa!","poem":3},{"text":"Bort från mig, ni blodtörstiga!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"De talar om dig med svek i sinnet,","poem":1},{"text":"de har fört dina städer i fördärvet","poem":2},{"noteId":358},{"text":".","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Skulle jag inte hata dem","poem":1},{"text":"som hatar dig, Herre,","poem":3},{"text":"och avsky dem","poem":2},{"text":"som gör uppror mot dig?","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Jag hatar dem med starkaste hat,","poem":1},{"text":"mina fiender har de blivit.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Rannsaka mig, Gud,","poem":1},{"text":"och känn mitt hjärta,","poem":3},{"text":"pröva mig och känn mina tankar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Se om jag är på en olycksväg,","poem":1},{"text":"och led mig på den eviga vägen.","poem":2}]}],"footnotes":[{"noteId":355,"caller":"-","text":"njurarSymbol för människans innersta.","reference":{"chapter":139,"verse":13}},{"noteId":356,"caller":"-","text":"min själ vet det så välAnnan översättning: \"du känner min själ så väl\".","reference":{"chapter":139,"verse":14}},{"noteId":357,"caller":"-","text":"ofattbaraAnnan översättning: \"dyrbara\".","reference":{"chapter":139,"verse":17}},{"noteId":358,"caller":"-","text":"fört dina städer i fördärvetAndra handskrifter: \"missbrukat ditt namn till lögn\".","reference":{"chapter":139,"verse":20}}]},"thisChapterLink":"/api/swe_fol/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}