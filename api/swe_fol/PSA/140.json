{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":140,"content":[{"type":"heading","content":["Bön om skydd mot onda människor"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rädda mig, Herre,","poem":1},{"text":"från onda människor,","poem":3},{"text":"skydda mig från våldsmän","poem":2}]},{"type":"verse","number":3,"content":[{"text":"som gör onda planer i sina hjärtan","poem":1},{"text":"och vållar strid varje dag.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"De vässar sina tungor som ormar,","poem":1},{"text":"de har huggormsgift","poem":2},{"text":"bakom sina läppar.","poem":3},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bevara mig, Herre,","poem":1},{"text":"från de gudlösas händer,","poem":3},{"text":"skydda mig från våldsmän","poem":2},{"text":"som planerar för att","poem":3},{"text":"få mina fötter på fall.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"De stolta gillrar fällor","poem":1},{"text":"med rep för mig,","poem":3},{"text":"de lägger nät vid vägens kant,","poem":2},{"text":"de sätter snaror för mig.","poem":3},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jag säger till Herren:","poem":1},{"text":"Du är min Gud.","poem":3},{"text":"Lyssna, Herre,","poem":2},{"text":"till mitt rop om nåd!","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Herre, min Herre,","poem":1},{"text":"min frälsnings styrka","poem":3},{"noteId":359},{"text":",","poem":3},{"text":"du skyddar mitt huvud","poem":2},{"text":"på stridens dag.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Herre, uppfyll inte","poem":1},{"text":"de gudlösas önskningar,","poem":3},{"text":"låt inte deras planer lyckas","poem":2},{"text":"så att de förhäver sig.","poem":3},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Låt dem som omringar mig","poem":1},{"text":"själva drabbas","poem":3},{"text":"av sina läppars ondska.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Låt glödande kol regna över dem,","poem":1},{"text":"låt dem kastas i eld,","poem":3},{"text":"i djup så att de aldrig","poem":2},{"text":"kommer upp.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Förtalare ska inte bestå i landet,","poem":1},{"text":"våldsmän ska jagas av olycka","poem":2},{"text":"med slag på slag.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jag vet att Herren ska ta sig an","poem":1},{"text":"den förtrycktes sak","poem":3},{"text":"och skipa rätt åt den fattige.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"De rättfärdiga ska prisa ditt namn,","poem":1},{"text":"de ärliga ska bo inför ditt ansikte.","poem":2}]}],"footnotes":[{"noteId":359,"caller":"-","text":"styrkaAnnan översättning: \"värn\".","reference":{"chapter":140,"verse":8}}]},"thisChapterLink":"/api/swe_fol/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":14}