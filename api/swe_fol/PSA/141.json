{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":141,"content":[{"type":"heading","content":["Bön om hjälp mot fiender"]},{"type":"verse","number":1,"content":[{"text":"En psalm av David.","descriptive":true},{"lineBreak":true},{"text":"Herre, jag ropar till dig,","poem":1},{"text":"skynda till mig!","poem":3},{"text":"Lyssna till min röst","poem":2},{"text":"när jag ropar till dig.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Låt min bön vara rökelse","poem":1},{"text":"inför dig,","poem":3},{"text":"mina lyfta händer ett aftonoffer.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Herre, sätt en vakt för min mun,","poem":1},{"text":"bevaka mina läppars dörr.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Låt inte mitt hjärta dras","poem":1},{"text":"till det som är ont","poem":3},{"noteId":360},{"text":",","poem":3},{"text":"till gudlösa gärningar","poem":2},{"text":"i lag med förbrytare.","poem":3},{"text":"Deras läckerheter vill jag inte äta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Om en rättfärdig slår mig","poem":1},{"text":"är det av kärlek,","poem":3},{"text":"straffar han mig","poem":2},{"text":"är det som olja på huvudet.","poem":3},{"text":"Mitt huvud ska inte avvisa det.","poem":4},{"text":"Men jag fortsätter att be","poem":2},{"text":"mot de ondas gärningar.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Deras ledare ska störtas ner","poem":1},{"text":"för klippan,","poem":3},{"text":"och då ska de förstå","poem":2},{"text":"att mina ord var goda.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Som när man plöjer","poem":1},{"text":"och river upp jorden,","poem":3},{"text":"så ligger våra ben utspridda","poem":2},{"text":"vid dödsrikets rand.","poem":3},{"noteId":361}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Men till dig, Herre min Herre,","poem":1},{"text":"ser mina ögon,","poem":3},{"text":"till dig tar jag min tillflykt.","poem":2},{"text":"Förkasta inte min själ","poem":3},{"noteId":362},{"text":"!","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Bevara mig från snarorna","poem":1},{"text":"de lägger för mig,","poem":3},{"text":"från förbrytarnas fällor.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Låt de gudlösa fastna","poem":1},{"text":"i sina egna nät","poem":3},{"text":"medan jag går trygg förbi.","poem":2}]}],"footnotes":[{"noteId":360,"caller":"-","text":"det som är ontAnnan översättning: \"onda ord\".","reference":{"chapter":141,"verse":4}},{"noteId":361,"caller":"-","text":"Grundtexten är i vers 5-7 svårtolkad.","reference":{"chapter":141,"verse":7}},{"noteId":362,"caller":"-","text":"Förkasta inte min själAnnan översättning: \"Låt inte min själ stå naken\".","reference":{"chapter":141,"verse":8}}]},"thisChapterLink":"/api/swe_fol/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}