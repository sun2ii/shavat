{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":142,"content":[{"type":"heading","content":["Bön i ensamhet och nöd"]},{"type":"verse","number":1,"content":[{"text":"En vishetspsalm av David. En bön när han var i grottan","descriptive":true},{"noteId":363},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Med hög röst","poem":1},{"text":"ropar jag till Herren,","poem":3},{"text":"med hög röst","poem":2},{"text":"ber jag Herren om nåd.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Jag utgjuter mitt bekymmer","poem":1},{"text":"för honom,","poem":3},{"text":"berättar om min nöd för honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"När min ande mattas i mig","poem":1},{"text":"är du den som känner min stig.","poem":3},{"text":"På vägen där jag går","poem":2},{"text":"har de lagt snaror för mig.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Se på min högra sida,","poem":1},{"text":"där finns ingen","poem":2},{"text":"som känns vid mig.","poem":3},{"text":"Jag har ingen tillflykt mer,","poem":2},{"text":"ingen som frågar efter min själ.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jag ropar till dig, Herre,","poem":1},{"text":"jag säger: Du är min tillflykt,","poem":2},{"text":"min lott i de levandes land.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Lyssna till mitt rop,","poem":1},{"text":"för jag är i stor nöd.","poem":3},{"text":"Rädda mig från mina förföljare,","poem":2},{"text":"för de är starkare än jag.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"För min själ ut ur fängelset,","poem":1},{"text":"så att jag kan prisa ditt namn.","poem":3},{"text":"De rättfärdiga ska samlas","poem":2},{"text":"omkring mig","poem":3},{"text":"när du visar din godhet mot mig.","poem":2}]}],"footnotes":[{"noteId":363,"caller":"-","text":"när han var i grottan på flykt undan kung Saul. Se 1 Sam 22:1 och Ps 57.","reference":{"chapter":142,"verse":1}}]},"thisChapterLink":"/api/swe_fol/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}