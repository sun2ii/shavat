{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":143,"content":[{"type":"heading","content":["Bön om räddning från undergång"]},{"type":"verse","number":1,"content":[{"text":"En psalm av David.","descriptive":true},{"noteId":364},{"lineBreak":true},{"text":"Herre, hör min bön,","poem":1},{"text":"lyssna till mitt rop om nåd!","poem":3},{"text":"Svara mig i din trofasthet,","poem":2},{"text":"i din rättfärdighet.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Gå inte till doms med din tjänare,","poem":1},{"text":"för ingen levande är rättfärdig","poem":2},{"text":"inför dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Fienden jagar min själ,","poem":1},{"text":"han trampar mitt liv till marken,","poem":3},{"text":"han lägger mig i mörker","poem":2},{"text":"likt dem som länge varit döda.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Min ande mattas i mig,","poem":1},{"text":"mitt hjärta stelnar i mitt bröst.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jag minns dagar som gått,","poem":1},{"text":"jag begrundar alla dina gärningar","poem":2},{"text":"och tänker på dina händers verk.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag sträcker mina händer mot dig,","poem":1},{"text":"min själ är som törstig jord","poem":2},{"text":"inför dig. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Herre, skynda att svara mig,","poem":1},{"text":"min ande förgås!","poem":3},{"text":"Dölj inte ditt ansikte för mig,","poem":2},{"text":"då blir jag som de","poem":3},{"text":"som går ner i graven.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Låt mig möta din nåd på morgonen,","poem":1},{"text":"för jag litar på dig.","poem":3},{"text":"Visa mig den väg jag ska gå,","poem":2},{"text":"för jag lyfter min själ till dig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Rädda mig från mina fiender,","poem":1},{"text":"Herre,","poem":3},{"text":"hos dig söker jag skydd.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lär mig att göra din vilja,","poem":1},{"text":"för du är min Gud.","poem":3},{"text":"Låt din gode Ande leda mig","poem":2},{"noteId":365},{"text":"på jämn mark.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Herre, ge mig liv","poem":1},{"text":"för ditt namns skull,","poem":3},{"text":"rädda min själ ur nöden","poem":2},{"text":"i din rättfärdighet.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Förinta mina fiender i din nåd,","poem":1},{"text":"förgör alla som plågar min själ,","poem":2},{"text":"för jag är din tjänare.","poem":3}]}],"footnotes":[{"noteId":364,"caller":"-","text":"Ps 4:2, 140:7.","reference":{"chapter":143,"verse":1}},{"noteId":365,"caller":"-","text":"Låt din gode Ande leda migAnnan översättning: \"Din Ande är god. Du ska leda mig\".","reference":{"chapter":143,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}