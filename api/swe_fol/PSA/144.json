{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":144,"content":[{"type":"heading","content":["Kungens lovsång och bön"]},{"type":"verse","number":1,"content":[{"text":"Av David.","descriptive":true},{"lineBreak":true},{"text":"Lovad är Herren, min klippa,","poem":1},{"text":"som övar mina armar för strid,","poem":2},{"text":"mina händer för krig –","poem":3}]},{"type":"verse","number":2,"content":[{"text":"min nåd och min borg,","poem":1},{"text":"mitt värn och min räddare,","poem":3},{"text":"min sköld och min tillflykt","poem":2},{"text":"som lägger mitt folk","poem":3},{"noteId":366},{"text":"under mig!","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Herre, vad är en människa","poem":1},{"text":"att du bryr dig om henne,","poem":3},{"text":"en människoson","poem":2},{"text":"att du tänker på honom?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Människan är som en vindpust,","poem":1},{"text":"hennes dagar som en försvinnande","poem":2},{"text":"skugga.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Herre, sänk din himmel och stig ner,","poem":1},{"text":"rör vid bergen så att de ryker.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Låt blixtar slå ner och skingra dem,","poem":1},{"text":"skjut dina pilar och förvirra dem!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Räck ut dina händer från höjden,","poem":1},{"text":"fräls mig och rädda mig","poem":3},{"text":"ur de väldiga vattnen,","poem":2},{"text":"ur främlingarnas hand!","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Deras mun talar lögn","poem":1},{"text":"och deras högra hand","poem":2},{"text":"är en svekfull hand.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gud, jag vill sjunga","poem":1},{"text":"en ny sång till dig,","poem":3},{"text":"sjunga ditt lov","poem":2},{"text":"till tiosträngad lyra,","poem":3}]},{"type":"verse","number":10,"content":[{"text":"du som ger seger åt kungar,","poem":1},{"text":"som räddar din tjänare David","poem":2},{"text":"från ondskans svärd.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Fräls mig och rädda mig","poem":1},{"text":"ur främlingarnas hand!","poem":3},{"text":"Deras mun talar lögn","poem":2},{"text":"och deras högra hand","poem":3},{"text":"är en svekfull hand.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"När våra söner i sin ungdom","poem":1},{"text":"står som välväxta plantor","poem":3},{"text":"och våra döttrar som hörnpelare","poem":2},{"text":"skurna för palats","poem":3},{"noteId":367},{"text":",","poem":3}]},{"type":"verse","number":13,"content":[{"text":"när våra lador är fulla","poem":1},{"text":"och ger förråd på förråd,","poem":3},{"text":"när våra får förökar sig tusenfalt","poem":2},{"text":"och tiotusenfalt på våra marker","poem":3}]},{"type":"verse","number":14,"content":[{"text":"och våra oxar går lastade","poem":1},{"noteId":368},{"text":",","poem":1},{"text":"när ingen rämna bryts i muren","poem":3},{"text":"och ingen förs ut som fånge","poem":2},{"text":"och inga skrik hörs","poem":3},{"text":"på våra gator –","poem":4}]},{"type":"verse","number":15,"content":[{"text":"saligt är det folk som har det så,","poem":1},{"text":"saligt är det folk","poem":2},{"text":"som har Herren till sin Gud!","poem":3}]}],"footnotes":[{"noteId":366,"caller":"-","text":"mitt folkAndra handskrifter: \"folken\" (jfr Ps 18:48).","reference":{"chapter":144,"verse":2}},{"noteId":367,"caller":"-","text":"palatsAnnan översättning: \"templet\".","reference":{"chapter":144,"verse":12}},{"noteId":368,"caller":"-","text":"lastadeAnnan översättning: \"feta\", \"dräktiga\".","reference":{"chapter":144,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}