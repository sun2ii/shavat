{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":145,"content":[{"type":"heading","content":["Herrens storhet och godhet"]},{"type":"verse","number":1,"content":[{"text":"En lovsång av David.","descriptive":true},{"lineBreak":true},{"text":"Jag vill upphöja dig,","poem":1},{"text":"min Gud och kung,","poem":3},{"text":"och lova ditt namn","poem":2},{"text":"för alltid och för evigt.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Jag vill lova dig varje dag","poem":1},{"text":"och prisa ditt namn","poem":2},{"text":"för alltid och för evigt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Stor är Herren och högt prisad,","poem":1},{"text":"hans storhet är ofattbar.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Släkte efter släkte prisar dina verk","poem":1},{"text":"och förkunnar dina väldiga","poem":2},{"text":"gärningar.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ditt majestäts härlighet och ära","poem":1},{"text":"och dina underbara verk","poem":2},{"text":"vill jag begrunda.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Dina väldiga gärningars makt","poem":1},{"text":"ska man tala om,","poem":3},{"text":"och din storhet ska jag förkunna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Man ska ropa ut ryktet","poem":1},{"text":"om din stora godhet","poem":3},{"text":"och jubla över din rättfärdighet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Herren är nådig och barmhärtig,","poem":1},{"text":"sen till vrede och stor i nåd.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Herren är god mot alla","poem":1},{"text":"och förbarmar sig","poem":2},{"text":"över alla sina verk.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Herre, alla dina verk ska tacka dig","poem":1},{"text":"och dina trogna ska lova dig.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"De ska tala om ditt rikes ära","poem":1},{"text":"och förkunna din makt,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"så att människors barn lär känna","poem":1},{"text":"dina mäktiga gärningar","poem":2},{"text":"och ditt rikes ära och härlighet.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ditt rike är ett rike för alla evigheter,","poem":1},{"text":"ditt välde består från släkte till släkte.","poem":2},{"lineBreak":true},{"text":"Herren är trofast i allt han säger","poem":1},{"text":"och kärleksfull i allt han gör.","poem":2},{"noteId":369}]},{"type":"verse","number":14,"content":[{"text":"Herren stöder alla som vacklar","poem":1},{"text":"och reser upp alla nerböjda.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Allas ögon hoppas på dig,","poem":1},{"text":"och du ger dem deras mat","poem":2},{"text":"i rätt tid.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Du öppnar din hand","poem":1},{"text":"och mättar allt levande med nåd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Herren är rättfärdig","poem":1},{"text":"i alla sina vägar","poem":3},{"text":"och nådig i allt han gör.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Herren är nära","poem":1},{"text":"alla som ropar till honom,","poem":2},{"text":"alla som ropar till honom","poem":3},{"text":"i sanning.","poem":4}]},{"type":"verse","number":19,"content":[{"text":"Han gör vad de gudfruktiga begär,","poem":1},{"text":"han hör deras rop och frälser dem.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Herren bevarar","poem":1},{"text":"alla som älskar honom,","poem":3},{"text":"men alla gudlösa ska han förgöra.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Min mun ska förkunna Herrens lov,","poem":1},{"text":"och allt som lever","poem":2},{"text":"ska lova hans heliga namn","poem":3},{"text":"för alltid och för evigt.","poem":4}]}],"footnotes":[{"noteId":369,"caller":"-","text":"Denna vers (\"Nun\") saknas i de flesta hebreiska handskrifter, men har påträffats i Dödahavsrullarna och i de gamla grekiska, latinska och syriska översättningarna.","reference":{"chapter":145,"verse":13}}]},"thisChapterLink":"/api/swe_fol/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}