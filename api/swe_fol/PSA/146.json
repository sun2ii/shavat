{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":146,"content":[{"type":"heading","content":["Herren vår hjälpare"]},{"type":"verse","number":1,"content":[{"text":"Halleluja!","poem":1},{"text":"Lova Herren, min själ!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jag vill lova Herren","poem":1},{"text":"så länge jag lever,","poem":3},{"text":"lovsjunga min Gud","poem":2},{"text":"så länge jag är till.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Lita inte till furstar,","poem":1},{"text":"till människors barn","poem":2},{"text":"som inte kan frälsa.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Deras ande lämnar dem,","poem":1},{"text":"de blir jord igen.","poem":3},{"text":"Den dagen går deras planer","poem":2},{"text":"om intet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Salig är den som har Jakobs Gud","poem":1},{"text":"till sin hjälpare,","poem":3},{"text":"som sätter sitt hopp","poem":2},{"text":"till Herren sin Gud,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"till honom som har gjort","poem":1},{"text":"himmel och jord och hav","poem":2},{"text":"och allt som finns i dem,","poem":3},{"text":"som är trofast för evigt,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"som skipar rätt för de förtryckta","poem":1},{"text":"och ger bröd åt de hungriga.","poem":2},{"lineBreak":true},{"text":"Herren befriar de fångna,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Herren öppnar de blindas ögon,","poem":1},{"text":"Herren reser upp de nerböjda,","poem":2},{"text":"Herren älskar de rättfärdiga,","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Herren bevarar främlingar","poem":1},{"text":"och stöder faderlösa och änkor,","poem":3},{"text":"men de gudlösas väg","poem":2},{"text":"gör han krokig.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Herren är kung för evigt,","poem":1},{"text":"din Gud, Sion,","poem":2},{"text":"från släkte till släkte.","poem":3},{"text":"Halleluja!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}