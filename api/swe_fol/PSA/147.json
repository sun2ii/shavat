{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":147,"content":[{"type":"heading","content":["Herrens välgärningar"]},{"type":"verse","number":1,"content":[{"text":"Halleluja!","poem":1},{"text":"Det är gott att lovsjunga vår Gud,","poem":2},{"text":"lovsång är ljuvligt och skönt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herren bygger upp Jerusalem,","poem":1},{"text":"han samlar Israels förskingrade.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Han helar dem som har","poem":1},{"text":"förkrossade hjärtan","poem":3},{"text":"och förbinder deras sår.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Han bestämmer stjärnornas antal,","poem":1},{"text":"han nämner dem alla vid namn.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Stor är vår Herre och väldig i kraft,","poem":1},{"text":"hans förstånd är utan gräns.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Herren stöder de ödmjuka,","poem":1},{"text":"men de gudlösa","poem":2},{"text":"slår han till jorden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sjung till Herren","poem":1},{"text":"med tacksamhet,","poem":3},{"text":"lovsjung vår Gud till harpa!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Han täcker himlen med moln","poem":1},{"text":"och bereder regn åt jorden,","poem":3},{"text":"han låter gräset gro på bergen","poem":2}]},{"type":"verse","number":9,"content":[{"text":"och ger föda åt djuren,","poem":1},{"text":"åt korpens ungar som ropar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Han har inte sin glädje","poem":1},{"text":"i hästens styrka,","poem":3},{"text":"inte sin fröjd i mannens snabbhet","poem":2},{"noteId":370},{"text":".","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Herren har sin glädje i dem","poem":1},{"text":"som vördar honom,","poem":2},{"text":"som hoppas på hans nåd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Jerusalem, prisa Herren,","poem":1},{"text":"Sion, lova din Gud!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Han stärker bommarna","poem":1},{"text":"för dina portar,","poem":3},{"text":"han välsignar dina barn i dig.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Han ger dina gränser fred,","poem":1},{"text":"han mättar dig med bästa vete.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Han sänder sitt budskap till jorden,","poem":1},{"text":"hans ord går ut med hast.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Han låter snö falla som ull,","poem":1},{"text":"sprider rimfrost som aska.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Han kastar sitt hagel som smulor.","poem":1},{"text":"Vem kan bestå inför hans köld?","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Han sänder sitt ord","poem":1},{"text":"och det frusna smälter,","poem":3},{"text":"han låter sin vind","poem":2},{"noteId":371},{"text":"blåsa","poem":2},{"text":"och vattnet strömmar.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Han förkunnar sitt ord för Jakob,","poem":1},{"text":"sina lagar och bud för Israel.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Så har han inte gjort","poem":1},{"text":"för något annat folk,","poem":3},{"text":"de känner inte hans domar.","poem":2},{"text":"Halleluja!","poem":3}]}],"footnotes":[{"noteId":370,"caller":"-","text":"snabbhetOrdagrant: \"ben\".","reference":{"chapter":147,"verse":10}},{"noteId":371,"caller":"-","text":"sin vindAnnan översättning: \"sin Ande\".","reference":{"chapter":147,"verse":18}}]},"thisChapterLink":"/api/swe_fol/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}