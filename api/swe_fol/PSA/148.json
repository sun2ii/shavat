m":3},{"noteId":372},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Prisa Herren från jorden,","poem":1},{"text":"ni havsdjur och alla djup,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"eld och hagel, snö och dimma,","poem":1},{"text":"du stormvind som utför","poem":2},{"text":"hans befallning,","poem":3}]},{"type":"verse","number":9,"content":[{"text":"ni berg och alla höjder,","poem":1},{"text":"ni fruktträd och alla cedrar,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ni vilda djur och all boskap,","poem":1},{"text":"ni kräldjur och bevingade fåglar,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ni jordens kungar och alla folk,","poem":1},{"text":"ni furstar och alla domare","poem":2},{"noteId":373},{"text":"på jorden,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ni ynglingar och flickor,","poem":1},{"text":"ni gamla med de unga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"De ska prisa Herrens namn,","poem":1},{"text":"för endast hans namn är högt,","poem":3},{"text":"hans majestät når över jord","poem":2},{"text":"och himmel.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Han har rest ett horn","poem":1},{"noteId":374},{"text":"för sitt folk","poem":1},{"text":"till lovsång för alla sina trogna,","poem":3},{"text":"för Israels barn,","poem":2},{"text":"det folk som står honom nära.","poem":3},{"text":"Halleluja!","poem":4}]}],"footnotes":[{"noteId":372,"caller":"-","text":"som ingen bryterAnnan översättning: \"som inte förgås\".","reference":{"chapter":148,"verse":6}},{"noteId":373,"caller":"-","text":"domareAnnan översättning: \"ledare\".","reference":{"chapter":148,"verse":11}},{"noteId":374,"caller":"-","text":"hornSymbol för styrka, för kungar (Dan 7-8, Upp 17:12) och för Messias (Luk 1:69).","reference":{"chapter":148,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PSA/148.json","thisChapterAudioLink