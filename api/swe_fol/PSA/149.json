t tveeggat svärd i sin hand,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"för att hämnas på hednafolken","poem":1},{"text":"och straffa folken,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"för att binda deras","poem":1},{"text":"kungar med kedjor","poem":3},{"text":"och deras stormän","poem":2},{"text":"med bojor av järn,","poem":3}]},{"type":"verse","number":9,"content":[{"text":"för att verkställa den dom","poem":1},{"text":"som står skriven.","poem":3},{"text":"Det blir en ära för alla hans trogna.","poem":2},{"text":"Halleluja!","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}