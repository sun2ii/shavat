:[{"text":"som inte ockrar med sina pengar","poem":1},{"text":"eller tar mutor mot den oskyldige.","poem":2},{"lineBreak":true},{"text":"Den som handlar så","poem":1},{"text":"ska aldrig någonsin vackla.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}