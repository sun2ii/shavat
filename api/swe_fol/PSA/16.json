{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":16,"content":[{"type":"heading","content":["Den trognes underbara arv"]},{"type":"verse","number":1,"content":[{"text":"En sång","descriptive":true},{"noteId":43},{"text":"av David.","descriptive":true},{"lineBreak":true},{"text":"Bevara mig, Gud,","poem":1},{"text":"för jag flyr till dig.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jag säger till Herren:","poem":1},{"text":"\"Du är min Herre,","poem":2},{"text":"jag har inget gott utom dig.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"De heliga i landet, de härliga,","poem":1},{"text":"hos dem har jag all min glädje.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"De som jagar efter andra gudar","poem":1},{"text":"får många sorger.","poem":3},{"text":"Jag offrar inte deras","poem":2},{"text":"dryckesoffer","poem":3},{"noteId":44},{"text":"av blod,","poem":3},{"text":"jag tar inte deras namn","poem":2},{"text":"på mina läppar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Herren är min lott","poem":1},{"text":"och min bägare,","poem":3},{"text":"du tryggar min arvedel.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"En ljuvlig lott har tillfallit mig,","poem":1},{"text":"ett underbart arv har jag fått.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag prisar Herren som ger mig råd.","poem":1},{"text":"Även mitt inre förmanar mig","poem":2},{"text":"om natten.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jag har alltid Herren för ögonen.","poem":1},{"text":"Han är vid min högra sida,","poem":2},{"text":"jag vacklar inte.","poem":3},{"noteId":45}]},{"type":"verse","number":9,"content":[{"text":"Därför gläds mitt hjärta","poem":1},{"text":"och jublar min ära.","poem":3},{"noteId":46},{"text":"Även min kropp får vila trygg,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"för du lämnar inte","poem":1},{"text":"min själ åt dödsriket,","poem":3},{"text":"du låter inte din Helige","poem":2},{"text":"se förgängelsen.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Du visar mig livets väg.","poem":1},{"text":"Jag mättas av glädje","poem":2},{"text":"inför ditt ansikte,","poem":3},{"text":"av ljuvlighet på din högra sida","poem":2},{"text":"för evigt.","poem":3}]}],"footnotes":[{"noteId":43,"caller":"-","text":"sångHebr. michtám(även i Ps 56-60). Möjliga betydelser som föreslagits är \"inskription\" (Septuaginta) och \"guldsång\" (rabbinerna).","reference":{"chapter":16,"verse":1}},{"noteId":44,"caller":"-","text":"dryckesofferav vin förekom både i Israels tempelgudstjänst (3 Mos 23:37) och vid avgudaoffer (5 Mos 32:38, Jer 7:18). Blodet är troligen symboliskt (jfr Upp 17:4, 6).","reference":{"chapter":16,"verse":4}},{"noteId":45,"caller":"-","text":"Citeras av Petrus i Apg 2:25-28 som profetia om Jesu uppståndelse (se även Apg 13:35).","reference":{"chapter":16,"verse":8}},{"noteId":46,"caller":"-","text":"min äraOfta uppfattat som liktydigt med \"min själ\". Kan också syfta på Herren själv som den troendes ära.","reference":{"chapter":16,"verse":9}}]},"thisChapterLink":"/api/swe_fol/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}