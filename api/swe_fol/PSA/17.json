{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":17,"content":[{"type":"heading","content":["Oskyldigt förföljd"]},{"type":"verse","number":1,"content":[{"text":"En bön av David.","descriptive":true},{"lineBreak":true},{"text":"Herre, hör en rättfärdig sak!","poem":1},{"text":"Lyssna till mitt rop,","poem":2},{"text":"vänd ditt öra till min bön.","poem":3},{"text":"Den kommer inte","poem":2},{"text":"från falska läppar.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Från dig kommer min dom,","poem":1},{"text":"dina ögon ser vad som är rätt.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Du prövar mitt hjärta,","poem":1},{"text":"du utforskar det om natten,","poem":3},{"text":"du rannsakar mig","poem":2},{"text":"men finner inget.","poem":3},{"text":"Ingen ond tanke","poem":2},{"text":"går ut ur min mun.","poem":3},{"noteId":47}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Vad människor än gör","poem":1},{"text":"aktar jag mig för","poem":2},{"text":"de våldsammas vägar","poem":3},{"text":"genom dina läppars ord.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Mina steg går stadigt","poem":1},{"text":"på dina stigar,","poem":3},{"text":"mina fötter stapplar inte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jag ropar till dig, för du, Gud,","poem":1},{"text":"kommer att svara mig.","poem":3},{"text":"Vänd ditt öra till mig","poem":2},{"text":"och hör mina ord!","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Visa din underbara nåd,","poem":1},{"text":"du som med din högra hand","poem":2},{"text":"frälser dem som flyr till dig","poem":3},{"text":"från sina förföljare.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Bevara mig som din ögonsten,","poem":1},{"text":"beskydda mig","poem":2},{"text":"i dina vingars skugga","poem":3}]},{"type":"verse","number":9,"content":[{"text":"från de gudlösa","poem":1},{"text":"som vill förgöra mig,","poem":3},{"text":"från mina dödsfiender","poem":2},{"text":"som omringar mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"De stänger sitt förhärdade hjärta,","poem":1},{"text":"de tar stora ord i sin mun.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nu är de runt mig var vi än går,","poem":1},{"text":"de siktar med sina ögon","poem":2},{"text":"för att slå mig till marken.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"De liknar ett rovlystet lejon,","poem":1},{"text":"ett ungt lejon som ligger på lur.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Res dig, Herre!","poem":1},{"text":"Gå emot honom, slå ner honom!","poem":3},{"text":"Rädda min själ med ditt svärd","poem":2},{"text":"från den gudlöse,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"med din hand från människorna,","poem":1},{"text":"Herre,","poem":3},{"text":"från denna världens människor","poem":2},{"text":"som har sin del i detta livet.","poem":3},{"text":"Du fyller deras buk","poem":2},{"text":"med dina gåvor,","poem":3},{"text":"de har söner i mängd","poem":2},{"text":"och lämnar sitt överflöd","poem":3},{"text":"till sina barn.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Men jag ska få se ditt ansikte","poem":1},{"text":"i rättfärdighet,","poem":3},{"text":"jag ska mättas av din åsyn","poem":2},{"text":"när jag vaknar.","poem":3}]}],"footnotes":[{"noteId":47,"caller":"-","text":"Ingen ond tanke går ut ur min munAnnan översättning: \"Jag har bestämt mig: min mun ska inte synda.\"","reference":{"chapter":17,"verse":3}}]},"thisChapterLink":"/api/swe_fol/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}