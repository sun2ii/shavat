{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":18,"content":[{"type":"heading","content":["Kungens tack för räddning och seger"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. Av Herrens tjänare David, som sjöng denna sång till Herren när Herrenhade räddat honom från alla hans fiender","descriptive":true},{"noteId":48},{"text":"och ur Sauls våld.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Han sade:","descriptive":true},{"lineBreak":true},{"text":"Hjärtligt kär har jag dig,","poem":1},{"text":"Herre min styrka,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Herre mitt bergfäste,","poem":1},{"text":"min borg och min räddare,","poem":3},{"text":"min Gud, min klippa","poem":2},{"text":"och min tillflykt,","poem":3},{"text":"min sköld och min frälsnings horn","poem":2},{"noteId":49},{"text":",","poem":2},{"text":"mitt värn!","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag ropar till Herren,","poem":1},{"text":"den högt lovade,","poem":3},{"text":"och jag blir frälst från mina fiender.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dödens band omgav mig,","poem":1},{"text":"fördärvets strömmar","poem":2},{"text":"skrämde mig,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"dödsrikets band omslöt mig,","poem":1},{"text":"dödens snaror mötte mig.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I min nöd åkallade jag Herren,","poem":1},{"text":"jag ropade till min Gud.","poem":3},{"text":"Från sitt tempel","poem":2},{"text":"hörde han min röst,","poem":3},{"text":"mitt rop till honom","poem":2},{"text":"nådde hans öron.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Då skakade jorden och bävade,","poem":1},{"text":"bergens grundvalar darrade,","poem":3},{"text":"de skakade av hans brinnande","poem":2},{"text":"vrede.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Rök steg ur hans näsa","poem":1},{"text":"och förtärande eld ur hans mun,","poem":3},{"text":"det gnistrade av glöd från honom.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Han sänkte himlen och steg ner","poem":1},{"text":"med mörka moln under sina fötter,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"han red på keruben och flög,","poem":1},{"text":"han svävade fram","poem":2},{"text":"på vindens vingar.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Han gjorde mörker till sitt skydd,","poem":1},{"text":"till sin hydda runt omkring honom:","poem":2},{"text":"mörka vatten, tjocka moln.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ur glansen framför honom","poem":1},{"text":"bröt molnen fram","poem":2},{"text":"med hagel och glödande kol.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Herren dundrade i himlen,","poem":1},{"text":"den Högste höjde sin röst","poem":2},{"text":"med hagel och glödande kol","poem":3},{"noteId":50},{"text":".","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Han sköt sina pilar","poem":1},{"text":"och skingrade dem,","poem":3},{"text":"blixtar i mängd och förvirrade dem.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Flodbäddar blev synliga,","poem":1},{"text":"jordens grundvalar blottades","poem":3},{"text":"för din tillrättavisning, Herre,","poem":2},{"text":"för din vredes stormvind.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Han räckte sin hand från höjden","poem":1},{"text":"och grep tag i mig,","poem":3},{"text":"han drog mig upp","poem":2},{"text":"ur de väldiga vattnen.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Han räddade mig","poem":1},{"text":"från min mäktige fiende,","poem":3},{"text":"från dem som hatade mig","poem":2},{"text":"och var starkare än jag.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"De anföll mig på min olyckas dag,","poem":1},{"text":"men Herren var mitt stöd.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Han förde mig ut på rymlig plats,","poem":1},{"text":"han räddade mig","poem":2},{"text":"eftersom han älskar mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Herren var god mot mig","poem":1},{"text":"efter min rättfärdighet,","poem":3},{"text":"han lönade mig","poem":2},{"text":"efter mina händers renhet,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"för jag har hållit mig","poem":1},{"text":"på Herrens vägar","poem":3},{"text":"och inte avfallit","poem":2},{"text":"från min Gud.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Jag har haft alla hans domar","poem":1},{"text":"för ögonen","poem":3},{"text":"och inte avvisat hans stadgar.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Jag har varit fullkomlig","poem":1},{"text":"inför honom","poem":3},{"text":"och aktat mig för synd.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Därför har Herren lönat mig","poem":1},{"text":"efter min rättfärdighet,","poem":2},{"text":"efter mina händers renhet","poem":3},{"text":"inför hans ögon.","poem":4}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mot den trogne är du trofast,","poem":1},{"text":"mot den fullkomlige","poem":2},{"text":"är du fullkomlig.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Mot den rene är du ren,","poem":1},{"text":"men mot den falske är du vrång.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ja, du frälser ett förtryckt folk,","poem":1},{"text":"men stolta ögon ödmjukar du.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Du låter min lampa brinna klart,","poem":1},{"text":"Herren min Gud","poem":2},{"text":"lyser upp mitt mörker.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Med dig slår jag ner en armé","poem":1},{"noteId":51},{"text":",","poem":1},{"text":"med min Gud stormar jag murar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Guds väg är fullkomlig,","poem":1},{"text":"Herrens ord är rent.","poem":3},{"text":"Han är en sköld","poem":2},{"text":"för alla som flyr till honom.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Vem är Gud förutom Herren,","poem":1},{"text":"vem är en klippa utom vår Gud?","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Gud, du rustar mig med kraft","poem":1},{"text":"och gör min väg fullkomlig,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"du gör mina fötter","poem":1},{"text":"som hindens","poem":3},{"text":"och ställer mig på mina höjder.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Du lär mina händer att strida,","poem":1},{"text":"mina armar att spänna","poem":2},{"text":"kopparbågen.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Du ger mig din frälsnings sköld,","poem":1},{"text":"din högra hand","poem":2},{"text":"stöder mig.","poem":3},{"text":"Din ödmjukhet gör mig stor.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Du gör plats för mina steg","poem":1},{"text":"där jag går,","poem":3},{"text":"mina fötter vacklar inte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Jag förföljde mina fiender","poem":1},{"text":"och hann upp dem,","poem":3},{"text":"jag vände inte","poem":2},{"text":"förrän jag gjort slut på dem.","poem":3}]},{"type":"verse","number":39,"content":[{"text":"Jag krossade dem","poem":1},{"text":"så att de inte kunde resa sig,","poem":3},{"text":"de föll under mina fötter.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Du rustade mig med kraft","poem":1},{"text":"för striden,","poem":3},{"text":"du böjde mina motståndare","poem":2},{"text":"under mig.","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Mina fiender drev du på flykten","poem":1},{"text":"för mig,","poem":3},{"text":"dem som hatade mig","poem":2},{"text":"förintade jag.","poem":3}]},{"type":"verse","number":42,"content":[{"text":"De ropade,","poem":1},{"text":"men ingen räddare fanns,","poem":3},{"text":"till Herren,","poem":2},{"text":"men han svarade dem inte.","poem":3}]},{"type":"verse","number":43,"content":[{"text":"Jag malde dem","poem":1},{"text":"till stoft för vinden,","poem":3},{"text":"jag slängde ut","poem":2},{"noteId":52},{"text":"dem","poem":2},{"text":"som smuts på gatan.","poem":3}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Du räddade mig","poem":1},{"text":"ur folkets strider,","poem":3},{"text":"du satte mig till huvud","poem":2},{"text":"över hednafolk,","poem":3},{"text":"folk som jag inte kände","poem":2},{"text":"blev mina tjänare.","poem":3}]},{"type":"verse","number":45,"content":[{"text":"Så snart de hörde om mig","poem":1},{"text":"lydde de mig,","poem":3},{"text":"främlingar kröp för mig.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Främlingarnas mod","poem":1},{"text":"vissnade bort,","poem":3},{"text":"bävande lämnade de sina fästen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Herren lever!","poem":1},{"text":"Lovad är min klippa,","poem":2},{"text":"upphöjd är min frälsnings Gud!","poem":3}]},{"type":"verse","number":48,"content":[{"text":"Gud, du har gett mig hämnd","poem":1},{"text":"och lagt folken under mig.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Du har befriat mig","poem":1},{"text":"från mina fiender,","poem":3},{"text":"du har upphöjt mig","poem":2},{"text":"över mina motståndare","poem":3},{"text":"och räddat mig från våldsmän.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Därför vill jag tacka dig","poem":1},{"text":"bland hednafolken, Herre,","poem":3},{"text":"och lovsjunga ditt namn,","poem":2},{"noteId":53}]},{"type":"verse","number":51,"content":[{"text":"för du ger stora segrar","poem":1},{"text":"till din kung","poem":3},{"text":"och visar nåd mot din smorde,","poem":2},{"lineBreak":true},{"text":"mot David och hans ätt","poem":2},{"noteId":54},{"text":"till evig tid.","poem":3}]}],"footnotes":[{"noteId":48,"caller":"-","text":"när Herren hade räddat honom från alla hans fienderTroligen vid slutet av Davids liv. En snarlik version av denna psalm återfinns i 2 Sam 22.","reference":{"chapter":18,"verse":1}},{"noteId":49,"caller":"-","text":"hornSymbol för styrka.","reference":{"chapter":18,"verse":3}},{"noteId":50,"caller":"-","text":"med hagel och glödande kolOrden saknas i vissa handskrifter och i 2 Sam 22:14.","reference":{"chapter":18,"verse":14}},{"noteId":51,"caller":"-","text":"slår jag ner en arméAnnan översättning: \"rusar jag fram mot vallar\".","reference":{"chapter":18,"verse":30}},{"noteId":52,"caller":"-","text":"slängde utAndra handskrifter (så Septuaginta och 2 Sam 22:43): \"trampade ner\".","reference":{"chapter":18,"verse":43}},{"noteId":53,"caller":"-","text":"Citeras av Paulus i Rom 15:9 som profetia om missionen bland hedningarna.","reference":{"chapter":18,"verse":50}},{"noteId":54,"caller":"-","text":"ättAnnan översättning: \"ättling\" (alltså Messias, Davids son).","reference":{"chapter":18,"verse":51}}]},"thisChapterLink":"/api/swe_fol/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":51}