{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":19,"content":[{"type":"heading","content":["Skapelsens och Ordets uppenbarelse"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Himlarna vittnar","poem":1},{"text":"om Guds härlighet,","poem":3},{"text":"himlavalvet förkunnar","poem":2},{"text":"hans händers verk.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Dag berättar för dag,","poem":1},{"text":"natt ger kunskap till natt,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"utan tal och utan ord,","poem":1},{"text":"utan att man hör deras röst.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Deras röst","poem":1},{"noteId":55},{"text":"når ut över hela jorden,","poem":1},{"text":"deras ord till världens ände.","poem":2},{"lineBreak":true},{"text":"I himlen har han gjort","poem":1},{"text":"en hydda åt solen.","poem":3},{"noteId":56}]},{"type":"verse","number":6,"content":[{"text":"Den liknar en brudgum","poem":1},{"text":"som kommer ut ur sin kammare,","poem":3},{"text":"den jublar som en hjälte","poem":2},{"text":"över att löpa sin bana.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Vid himlens ena ände går den upp","poem":1},{"text":"och följer sitt kretslopp","poem":2},{"text":"till den andra.","poem":3},{"text":"Ingenting är dolt för dess hetta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Herrens undervisning är fullkomlig,","poem":1},{"text":"den ger nytt liv åt","poem":3},{"noteId":57},{"text":"själen.","poem":3},{"text":"Herrens vittnesbörd är sant,","poem":2},{"text":"det ger vishet åt enkla människor.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Herrens befallningar är rätta,","poem":1},{"text":"de ger glädje åt hjärtat.","poem":3},{"text":"Herrens bud är klart,","poem":2},{"text":"det ger ljus åt ögonen.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Herrens vördnad är ren,","poem":1},{"text":"den består för evigt.","poem":3},{"text":"Herrens domar är sanna,","poem":2},{"text":"de är alla rättfärdiga.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"De är mer värda än guld,","poem":1},{"text":"än mängder av fint guld.","poem":3},{"text":"De är sötare än honung,","poem":2},{"text":"än renaste honung.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Genom dem blir din tjänare varnad.","poem":1},{"text":"Den som följer dem får stor lön.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Vem märker hur ofta han felar?","poem":1},{"text":"Förlåt mig mina hemliga brister.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bevara också din tjänare","poem":1},{"text":"från de fräcka","poem":3},{"noteId":58},{"text":",","poem":3},{"text":"låt dem inte få makt över mig,","poem":2},{"text":"så blir jag fullkomlig","poem":3},{"text":"och fri från svår synd.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Låt min muns ord","poem":1},{"text":"och mitt hjärtas tankar behaga dig,","poem":2},{"text":"Herre, min klippa och återlösare.","poem":3}]}],"footnotes":[{"noteId":55,"caller":"-","text":"Citeras av Paulus i Rom 10:18 för att visa att alla människor har fått kunskap om Gud.","reference":{"chapter":19,"verse":5}},{"noteId":56,"caller":"-","text":"röstSå Septuaginta och Rom 10:18. Annan översättning: \"utsträckning\".","reference":{"chapter":19,"verse":5}},{"noteId":57,"caller":"-","text":"ger nytt liv åtAnnan översättning (så Septuaginta): \"återför\", \"omvänder\".","reference":{"chapter":19,"verse":8}},{"noteId":58,"caller":"-","text":"de fräckaSyftar antingen på synder (jfr vers 13) eller på människor.","reference":{"chapter":19,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":15}