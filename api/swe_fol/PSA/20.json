{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":20,"content":[{"type":"heading","content":["En bön för Herrens smorde"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Må Herren svara dig","poem":1},{"text":"på nödens dag,","poem":3},{"text":"må Jakobs Guds namn","poem":2},{"text":"bevara dig.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Må han sända dig hjälp","poem":1},{"text":"från helgedomen","poem":3},{"text":"och stödja dig från Sion.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Må han minnas alla dina offer","poem":1},{"text":"och ta emot dina brännoffer","poem":2},{"text":"med välbehag. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Må han ge dig","poem":1},{"text":"vad ditt hjärta önskar","poem":3},{"noteId":59},{"text":"och fullborda alla dina planer.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vi ska jubla över din frälsning","poem":1},{"text":"och lyfta baneret","poem":2},{"text":"i vår Guds namn.","poem":3},{"text":"Må Herren uppfylla","poem":2},{"text":"alla dina böner!","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nu vet jag att Herren frälser","poem":1},{"text":"sin smorde.","poem":3},{"text":"Han svarar honom","poem":2},{"text":"från sin heliga himmel","poem":3},{"text":"med sin högra hands","poem":2},{"text":"frälsande storverk.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Vissa prisar","poem":1},{"noteId":60},{"text":"vagnar","poem":1},{"text":"och andra hästar,","poem":3},{"text":"men vi prisar","poem":2},{"text":"Herren vår Guds namn.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"De sjunker ner och faller,","poem":1},{"text":"men vi reser oss och står raka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Herre, fräls!","poem":1},{"text":"Må kungen svara oss","poem":2},{"noteId":61},{"text":"när vi ropar.","poem":3}]}],"footnotes":[{"noteId":59,"caller":"-","text":"vad ditt hjärta önskarOrdagrant: \"enligt ditt hjärta\".","reference":{"chapter":20,"verse":5}},{"noteId":60,"caller":"-","text":"prisarAnnan översättning: \"litar till\".","reference":{"chapter":20,"verse":8}},{"noteId":61,"caller":"-","text":"Annan översättning: \"Herre, fräls kungen! Må han svara …\".","reference":{"chapter":20,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}