{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":21,"content":[{"type":"heading","content":["Herrens hjälp till kungen"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, kungen gläds","poem":1},{"text":"över din makt,","poem":3},{"text":"hur högt jublar han inte","poem":2},{"text":"över din frälsning!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Du ger honom","poem":1},{"text":"vad hans hjärta begär,","poem":3},{"text":"du nekar honom inte","poem":2},{"text":"vad hans läppar ber om. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Du möter honom","poem":1},{"text":"med rika välsignelser,","poem":3},{"text":"du sätter en krona av rent guld","poem":2},{"text":"på hans huvud.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Han bad dig om liv","poem":1},{"text":"och du gav honom det,","poem":3},{"text":"långt liv i evigheters evighet.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Stor blir hans ära","poem":1},{"text":"genom din frälsning,","poem":3},{"text":"majestät och härlighet","poem":2},{"text":"skänker du honom.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Du gör honom till välsignelse","poem":1},{"text":"för evigt,","poem":3},{"text":"du fyller honom med glädje","poem":2},{"text":"inför ditt ansikte,","poem":3}]},{"type":"verse","number":8,"content":[{"text":"för kungen litar på Herren.","poem":1},{"text":"Genom den Högstes nåd","poem":2},{"text":"ska han inte vackla.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Din hand ska nå alla dina fiender,","poem":1},{"text":"din högra hand ska nå","poem":2},{"text":"dem som hatar dig.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Du ska sätta dem","poem":1},{"text":"som i en glödande ugn","poem":2},{"text":"när du visar ditt ansikte.","poem":3},{"text":"Herren ska sluka dem i sin vrede,","poem":2},{"text":"eld ska förtära dem.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Du ska utrota deras livsfrukt","poem":1},{"text":"från jorden,","poem":3},{"text":"deras avkomma","poem":2},{"text":"från människors barn,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"för de ville dra ondska över dig,","poem":1},{"text":"de smidde listiga planer","poem":2},{"text":"men förmår ingenting.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Du ska driva dem tillbaka,","poem":1},{"text":"du ska sikta med din båge","poem":2},{"text":"mot deras ansikten.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Res dig","poem":1},{"noteId":62},{"text":", Herre, i din makt!","poem":1},{"text":"Vi vill spela och sjunga","poem":2},{"text":"om din väldiga kraft.","poem":3}]}],"footnotes":[{"noteId":62,"caller":"-","text":"Res digAnnan översättning: \"Var upphöjd\".","reference":{"chapter":21,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}