{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":22,"content":[{"type":"heading","content":["Messias lidande och seger"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till \"Morgonrodnadens hind\". En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Min Gud, min Gud,","poem":1},{"text":"varför har du övergett mig?","poem":3},{"text":"Jag ropar och klagar,","poem":2},{"text":"men min frälsning är fjärran.","poem":3},{"noteId":63}]},{"type":"verse","number":3,"content":[{"text":"Min Gud, jag ropar om dagen","poem":1},{"text":"men du svarar inte,","poem":3},{"text":"och om natten","poem":2},{"text":"men får ingen ro.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ändå är du den Helige,","poem":1},{"text":"den som tronar på Israels","poem":2},{"text":"lovsånger.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"På dig förtröstade våra fäder,","poem":1},{"text":"de förtröstade och du befriade dem.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Till dig ropade de och fick hjälp,","poem":1},{"text":"de förtröstade på dig","poem":2},{"text":"och behövde inte skämmas.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Men jag är en mask","poem":1},{"text":"och inte en människa,","poem":3},{"text":"hånad av människor","poem":2},{"text":"och föraktad av folket.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Alla som ser mig hånar mig,","poem":1},{"text":"de grimaserar","poem":2},{"text":"och skakar på huvudet:","poem":3}]},{"type":"verse","number":9,"content":[{"text":"\"Anförtro dig","poem":1},{"noteId":64},{"text":"åt Herren!","poem":1},{"text":"Han får befria och rädda honom,","poem":2},{"text":"han älskar ju honom.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Det var du som drog mig","poem":1},{"text":"ut ur moderlivet,","poem":3},{"text":"du gjorde mig trygg","poem":2},{"text":"vid min mors bröst.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"På dig är jag kastad","poem":1},{"text":"ända från modersskötet,","poem":3},{"text":"från moderlivet är du min Gud.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Var inte långt ifrån mig,","poem":1},{"text":"för nöden är nära","poem":2},{"text":"och ingen hjälpare finns.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Tjurar i mängd omger mig,","poem":1},{"text":"Bashans oxar","poem":2},{"noteId":65},{"text":"omringar mig.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Som rovlystna, rytande lejon","poem":1},{"text":"spärrar de upp sitt gap mot mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Jag rinner bort som vatten,","poem":1},{"text":"alla mina leder har skilts åt.","poem":3},{"text":"Mitt hjärta är som vax,","poem":2},{"text":"det smälter i mitt inre.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Min kraft är uttorkad","poem":1},{"text":"som en krukskärva,","poem":3},{"text":"min tunga fastnar i gommen.","poem":2},{"text":"Du lägger mig i dödens stoft.","poem":3},{"noteId":66}]},{"type":"verse","number":17,"content":[{"text":"Hundar omger mig,","poem":1},{"text":"de ondas hop omringar mig,","poem":3},{"text":"de har genomborrat","poem":2},{"noteId":67},{"text":"mina händer och fötter.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Jag kan räkna alla mina ben,","poem":1},{"text":"de ser på mig, de stirrar.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"De delar mina kläder mellan sig","poem":1},{"text":"och kastar lott om min klädnad.","poem":2},{"noteId":68}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Men du, Herre,","poem":1},{"text":"var inte långt borta!","poem":3},{"text":"Du min styrka,","poem":2},{"text":"skynda till min hjälp!","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Rädda min själ från svärdet,","poem":1},{"text":"mitt liv ur hundarnas våld!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Fräls mig från lejonets gap","poem":1},{"text":"och vildoxarnas horn!","poem":3},{"text":"Du bönhör mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Jag ska förkunna ditt namn","poem":1},{"text":"för mina bröder,","poem":3},{"text":"mitt i församlingen","poem":2},{"text":"ska jag lovsjunga dig.","poem":3},{"noteId":69}]},{"type":"verse","number":24,"content":[{"text":"Ni som vördar Herren,","poem":1},{"text":"lova honom!","poem":3},{"text":"Ära honom, alla Jakobs barn,","poem":2},{"text":"och bäva för honom,","poem":3},{"text":"alla Israels barn,","poem":4}]},{"type":"verse","number":25,"content":[{"text":"för han föraktade inte","poem":1},{"text":"den förtrycktes lidande","poem":2},{"text":"och såg inte på honom med avsky.","poem":3},{"text":"Han dolde inte sitt ansikte","poem":2},{"text":"för honom","poem":3},{"text":"utan lyssnade när han ropade","poem":2},{"text":"till honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Från dig kommer mitt lov","poem":1},{"text":"i den stora församlingen.","poem":3},{"text":"Jag ska uppfylla mina löften","poem":2},{"text":"inför dem som vördar honom.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"De ödmjuka ska äta och bli mätta,","poem":1},{"text":"de som söker Herren","poem":2},{"text":"ska lova honom.","poem":3},{"text":"Era hjärtan ska leva för evigt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Alla jordens ändar ska minnas det","poem":1},{"text":"och omvända sig till Herren,","poem":3},{"text":"folkens alla släkter","poem":2},{"text":"ska tillbe inför dig,","poem":3}]},{"type":"verse","number":29,"content":[{"text":"för riket är Herrens","poem":1},{"text":"och han råder över folken.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Alla mäktiga på jorden","poem":1},{"text":"ska äta och tillbe,","poem":3},{"text":"inför honom ska de","poem":2},{"text":"böja knä,","poem":3},{"text":"alla som går ner i stoftet","poem":2},{"text":"och inte kan hålla sin själ vid liv.","poem":3},{"noteId":70}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Ättlingar ska tjäna honom,","poem":1},{"text":"kommande släkten","poem":2},{"text":"ska få höra om Herren.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"De ska träda fram","poem":1},{"text":"och förkunna hans rättfärdighet","poem":2},{"text":"för det folk som ska födas:","poem":3},{"text":"att han har gjort det.","poem":4}]}],"footnotes":[{"noteId":63,"caller":"-","text":"Denna vers, titelversen till själva psalmen, citeras av Jesus på korset (Matt 27:46, Mark 15:34).","reference":{"chapter":22,"verse":2}},{"noteId":64,"caller":"-","text":"Anförtro digAnnan översättning (så Septuaginta): ”Han har anförtrott sig”. Orden användes som hån mot Jesus (Matt 27:43).","reference":{"chapter":22,"verse":9}},{"noteId":65,"caller":"-","text":"Bashans oxarGolanhöjdernas frodiga bete gav välväxta oxar (jfr Hes 39:18).","reference":{"chapter":22,"verse":13}},{"noteId":66,"caller":"-","text":"På korset hänvisar Jesus till bl a denna vers när han \"för att Skriften skulle uppfyllas\" säger: \"Jag är törstig\" (Joh 19:28).","reference":{"chapter":22,"verse":16}},{"noteId":67,"caller":"-","text":"de har genomborratOrdagrant: ”de har grävt hål i” (jfr Ps 40:7), enligt Septuaginta och ett flertal hebreiska handskrifter. Masoretiska texten: \"som lejon\".","reference":{"chapter":22,"verse":17}},{"noteId":68,"caller":"-","text":"Citeras i Joh 19:24 som profetia om korsfästelsen.","reference":{"chapter":22,"verse":19}},{"noteId":69,"caller":"-","text":"Citeras i Hebr 2:12 som profetia om den uppståndne Jesus.","reference":{"chapter":22,"verse":23}},{"noteId":70,"caller":"-","text":"stoftet och inte kan hålla sin själ vid livAndra handskrifter (Septuaginta): \"stoftet. Men min själ lever för honom\".","reference":{"chapter":22,"verse":30}}]},"thisChapterLink":"/api/swe_fol/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":32}