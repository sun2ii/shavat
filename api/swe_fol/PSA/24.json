{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":24,"content":[{"type":"heading","content":["Ärans kung och hans rike"]},{"type":"verse","number":1,"content":[{"text":"Av David. En psalm.","descriptive":true},{"noteId":76},{"lineBreak":true},{"text":"Jorden är Herrens","poem":1},{"text":"med allt vad den rymmer,","poem":3},{"text":"världen med dem som bor i den,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"för han har grundat den på haven","poem":1},{"text":"och fäst den på de strömmande","poem":2},{"text":"vattnen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vem får gå upp på Herrens berg?","poem":1},{"text":"Vem får komma in","poem":2},{"text":"i hans helgedom?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Den som har oskyldiga händer","poem":1},{"text":"och rent hjärta,","poem":3},{"text":"som inte vänder sin själ till lögn","poem":2},{"text":"och inte svär falskt.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Han får välsignelse från Herren","poem":1},{"text":"och rättfärdighet","poem":2},{"text":"från sin frälsnings Gud.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Sådant är släktet","poem":1},{"text":"som frågar efter honom,","poem":3},{"text":"de som söker ditt ansikte","poem":2},{"text":"är Jakobs barn.","poem":3},{"noteId":77},{"text":"Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Höj era huvuden, ni portar,","poem":1},{"text":"höj er, ni eviga dörrar,","poem":3},{"text":"så att ärans kung kan tåga in!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vem är han, ärans kung?","poem":1},{"text":"Det är Herren, stark och väldig,","poem":2},{"text":"Herren, väldig i strid.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Höj era huvuden, ni portar,","poem":1},{"text":"höj er, ni eviga dörrar,","poem":3},{"text":"så att ärans kung kan tåga in!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vem är han, ärans kung?","poem":1},{"text":"Det är Herren Sebaot,","poem":2},{"text":"han är ärans kung. Sela","poem":3}]}],"footnotes":[{"noteId":76,"caller":"-","text":"sjöngs enligt Mishna varje söndag i templet av leviternas kör.","reference":{"chapter":24,"verse":1}},{"noteId":77,"caller":"-","text":"ditt ansikte är Jakobs barnAndra handskrifter (så Septuaginta): \"ditt ansikte, Jakobs Gud\".","reference":{"chapter":24,"verse":6}}]},"thisChapterLink":"/api/swe_fol/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}