{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":25,"content":[{"type":"heading","content":["Bön om ledning och nåd"]},{"type":"verse","number":1,"content":[{"text":"Av David.","descriptive":true},{"noteId":78},{"lineBreak":true},{"text":"Herre, jag lyfter min själ till dig.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Min Gud, jag litar på dig.","poem":2},{"text":"Låt mig inte behöva skämmas","poem":1},{"noteId":79},{"text":",","poem":1},{"text":"låt inte mina fiender","poem":2},{"text":"triumfera över mig!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Nej, ingen som hoppas på dig","poem":1},{"text":"ska skämmas.","poem":3},{"text":"Skämmas ska de som sviker","poem":2},{"text":"utan orsak.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Herre, visa mig dina vägar,","poem":1},{"text":"lär mig dina stigar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Led mig i din sanning och lär mig,","poem":1},{"text":"för du är min frälsnings Gud,","poem":2},{"text":"på dig hoppas jag alltid.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Tänk på din barmhärtighet","poem":1},{"text":"och din nåd, Herre,","poem":3},{"text":"för de är av evighet.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tänk inte på min ungdoms synder","poem":1},{"text":"och brott,","poem":3},{"text":"utan tänk på mig efter din nåd,","poem":2},{"text":"för din godhets skull, Herre.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Herren är god och rättfärdig,","poem":1},{"text":"därför undervisar han syndare","poem":2},{"text":"om vägen.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Han leder de ödmjuka rätt,","poem":1},{"text":"han lär de ödmjuka sin väg.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Alla Herrens vägar","poem":1},{"text":"är nåd och sanning","poem":3},{"text":"för dem som håller hans förbund","poem":2},{"text":"och vittnesbörd.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"För ditt namns skull, Herre,","poem":1},{"text":"förlåt min synd,","poem":2},{"text":"för den är stor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Den som vördar","poem":1},{"noteId":80},{"text":"Herren","poem":1},{"text":"undervisar han om vägen","poem":2},{"text":"han ska välja.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Hans själ ska vila i det goda,","poem":1},{"text":"och hans ättlingar ska ärva landet.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Herren är förtrolig","poem":1},{"text":"med dem som vördar honom,","poem":3},{"text":"sitt förbund gör han känt för dem","poem":2},{"noteId":81},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mina ögon ser alltid","poem":1},{"text":"upp till Herren,","poem":3},{"text":"för han drar mina fötter ur nätet.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vänd dig till mig","poem":1},{"text":"och förbarma dig över mig,","poem":3},{"text":"för jag är ensam och betryckt.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mitt hjärtas ångest är stor.","poem":1},{"text":"För mig ut ur min nöd!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Se hur plågad och trött jag är,","poem":1},{"text":"förlåt mig alla mina synder.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Se mina fiender,","poem":1},{"text":"de är många och hatar mig","poem":2},{"text":"med våldsamt hat.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Bevara min själ och rädda mig,","poem":1},{"text":"låt mig inte behöva skämmas,","poem":2},{"text":"för jag flyr till dig.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Låt oskuld och ärlighet bevara mig,","poem":1},{"text":"för jag hoppas på dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Gud, befria Israel","poem":1},{"text":"ur all dess nöd.","poem":2}]}],"footnotes":[{"noteId":78,"caller":"-","text":"Alfabetisk psalm: verserna börjar med det hebreiska alfabetets 22 bokstäver i följd.","reference":{"chapter":25,"verse":1}},{"noteId":79,"caller":"-","text":"skämmasAnnan översättning: \"bli besviken\" (även i vers 3 och 20).","reference":{"chapter":25,"verse":2}},{"noteId":80,"caller":"-","text":"vördarAnnan översättning: \"fruktar\". Grundtextens uttryck jerérymmer inte bara fruktan (Ps 3:7) utan även vördnad och värme (Ps 103:13, 130:4, 3 Mos 19:3, 30).","reference":{"chapter":25,"verse":12}},{"noteId":81,"caller":"-","text":"sitt förbund gör han känt för demAnnan översättning: \"hans förbund ger dem kunskap\".","reference":{"chapter":25,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}