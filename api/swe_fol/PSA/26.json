tvår mina händer i oskuld","poem":1},{"text":"och vandrar runt ditt altare, Herre,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"för att höja min röst i tacksamhet","poem":1},{"text":"och förkunna alla dina under.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Herre, jag älskar din boning,","poem":1},{"text":"den plats där din härlighet bor.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ryck inte bort min själ med syndare","poem":1},{"text":"eller mitt liv med de blodtörstiga,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"de som har ondska","poem":1},{"noteId":82},{"text":"i sina händer","poem":1},{"text":"och högra handen full av mutor.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jag är oskyldig, befria mig","poem":1},{"text":"och förbarma dig över mig!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Min fot står på säker mark.","poem":1},{"text":"I församlingarna","poem":2},{"text":"ska jag prisa Herren.","poem":3}]}],"footnotes":[{"noteId":82,"caller":"-","text":"ondskaAnnan översättning: \"slughet\".","reference":{"chapter":26,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}