{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":27,"content":[{"type":"heading","content":["Gemenskap med Herren"]},{"type":"verse","number":1,"content":[{"text":"Av David.","descriptive":true},{"lineBreak":true},{"text":"Herren är mitt ljus","poem":1},{"text":"och min frälsning.","poem":2},{"text":"Vem skulle jag frukta?","poem":3},{"text":"Herren försvarar mitt liv.","poem":2},{"text":"Vem skulle jag vara rädd för?","poem":3}]},{"type":"verse","number":2,"content":[{"text":"När de onda kommer emot mig","poem":1},{"text":"för att sluka mig,","poem":3},{"text":"mina motståndare och fiender,","poem":2},{"text":"då ska de själva snava och falla.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Om en här belägrar mig","poem":1},{"text":"räds inte mitt hjärta,","poem":3},{"text":"om krig bryter ut mot mig","poem":2},{"text":"är jag ändå trygg.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ett har jag begärt av Herren,","poem":1},{"text":"detta söker jag:","poem":3},{"text":"att få bo i Herrens hus","poem":2},{"text":"i alla mina livsdagar,","poem":3},{"text":"för att se Herrens ljuvlighet","poem":2},{"text":"och söka honom i","poem":3},{"noteId":83},{"text":"hans tempel.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Han gömmer mig i sin hydda","poem":1},{"text":"på olyckans dag,","poem":3},{"text":"han beskyddar mig i sitt tält,","poem":2},{"text":"han för mig upp på klippan.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Nu är mitt huvud högt","poem":1},{"text":"över mina fiender omkring mig.","poem":3},{"text":"Jag vill offra jublets offer i hans tält,","poem":2},{"text":"jag vill sjunga och spela","poem":3},{"text":"till Herren.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Herre, hör min röst när jag ropar,","poem":1},{"text":"förbarma dig över mig","poem":2},{"text":"och svara mig!","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Mitt hjärta tänker på ditt ord:","poem":1},{"text":"\"Sök mitt ansikte!\"","poem":3},{"noteId":84},{"text":"Ditt ansikte, Herre, söker jag.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Dölj inte ditt ansikte för mig,","poem":1},{"text":"avvisa inte din tjänare i vrede,","poem":2},{"text":"du som har varit min hjälp.","poem":3},{"text":"Släpp mig inte, överge mig inte,","poem":2},{"text":"du min frälsnings Gud.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Om min far och min mor","poem":1},{"text":"överger mig,","poem":3},{"text":"tar Herren emot mig.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Visa mig, Herre, din väg,","poem":1},{"text":"led mig på en jämn stig","poem":2},{"text":"för mina förföljares skull.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Utlämna mig inte","poem":1},{"text":"åt mina fienders vilja,","poem":3},{"text":"för falska vittnen stiger fram","poem":2},{"text":"mot mig och andas våld.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jag är viss om att få se","poem":1},{"text":"Herrens godhet","poem":2},{"text":"i de levandes land.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Hoppas på Herren,","poem":1},{"text":"var stark och modig i ditt hjärta","poem":2},{"text":"och hoppas på Herren!","poem":3}]}],"footnotes":[{"noteId":83,"caller":"-","text":"söka honom iAnnan översättning: \"besöka\".","reference":{"chapter":27,"verse":4}},{"noteId":84,"caller":"-","text":"tänker på ditt ord: \"Sök mitt ansikte!\"Andra handskrifter: \"säger om dig: Sök hans ansikte!\".","reference":{"chapter":27,"verse":8}}]},"thisChapterLink":"/api/swe_fol/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}