{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":28,"content":[{"type":"heading","content":["Bön om beskydd"]},{"type":"verse","number":1,"content":[{"text":"Av David.","descriptive":true},{"lineBreak":true},{"text":"Till dig, Herre, ropar jag.","poem":1},{"text":"Min klippa, var inte stum","poem":2},{"text":"mot mig!","poem":3},{"text":"Om du är tyst mot mig,","poem":2},{"text":"blir jag som de","poem":3},{"text":"som går ner i graven.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Hör min bön om nåd","poem":1},{"text":"när jag ropar till dig,","poem":3},{"text":"när jag lyfter mina händer","poem":2},{"text":"mot det allra heligaste","poem":3},{"text":"i din helgedom.","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Släpa inte bort mig","poem":1},{"text":"med gudlösa och förbrytare,","poem":3},{"text":"med dem som talar vänligt","poem":2},{"text":"med sin nästa","poem":3},{"text":"men har ondska i sitt hjärta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Löna dem för deras handlingar,","poem":1},{"text":"för deras onda gärningar.","poem":3},{"text":"Löna dem för deras händers verk,","poem":2},{"text":"ge dem för det de har gjort,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"för de bryr sig inte om","poem":1},{"text":"Herrens gärningar,","poem":2},{"text":"hans händers verk.","poem":3},{"text":"Därför ska han riva ner dem","poem":2},{"text":"och inte bygga upp dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Lovad är Herren,","poem":1},{"text":"för han har hört mina böner","poem":2},{"text":"om nåd!","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Herren är min styrka","poem":1},{"text":"och min sköld.","poem":3},{"text":"På honom litar mitt hjärta,","poem":2},{"text":"jag får hjälp","poem":3},{"text":"och mitt hjärta jublar.","poem":4},{"text":"Honom vill jag tacka","poem":2},{"text":"med min sång.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Herren är sitt folks styrka,","poem":1},{"text":"han är ett frälsningens värn","poem":2},{"text":"för sin smorde.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Fräls ditt folk","poem":1},{"text":"och välsigna din arvedel!","poem":3},{"text":"Var deras herde","poem":2},{"text":"och bär dem för evigt.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}