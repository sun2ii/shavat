{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":3,"content":[{"type":"heading","content":["Bön om hjälp mot fiender"]},{"type":"verse","number":1,"content":[{"text":"En psalm av David när han flydde för sin son Absalom","descriptive":true},{"noteId":10},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, hur många är inte","poem":1},{"text":"mina fiender!","poem":3},{"text":"Många reser sig mot mig,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"många säger om min själ:","poem":1},{"text":"\"Han får ingen frälsning","poem":2},{"text":"hos Gud.\" Sela","poem":3},{"noteId":11}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Men du, Herre, är en sköld","poem":1},{"text":"runt omkring mig.","poem":3},{"text":"Du är min ära,","poem":2},{"text":"du lyfter mitt huvud.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Jag ropar högt till Herren,","poem":1},{"text":"och han svarar mig","poem":2},{"text":"från sitt heliga berg. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jag lade mig ner och somnade,","poem":1},{"text":"jag vaknade igen,","poem":2},{"text":"för Herren stöder mig.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Jag fruktar inte tiotusen man","poem":1},{"text":"som omringar mig från alla håll.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Res dig, Herre!","poem":1},{"text":"Fräls mig, min Gud!","poem":3},{"text":"Du slår alla mina fiender på kinden","poem":2},{"noteId":12},{"text":",","poem":2},{"text":"du krossar de gudlösas tänder.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Frälsningen finns hos Herren.","poem":1},{"text":"Låt din välsignelse vila","poem":2},{"text":"över ditt folk! Sela","poem":3}]}],"footnotes":[{"noteId":10,"caller":"-","text":"Absalom gjorde uppror och fick med sig merparten av folket. Se 2 Sam 16:14f.","reference":{"chapter":3,"verse":1}},{"noteId":11,"caller":"-","text":"SelaMusikalisk anvisning som troligen motsvarade ett solo eller mellanspel (så Septuaginta), eller möjligen repris.","reference":{"chapter":3,"verse":3}},{"noteId":12,"caller":"-","text":"kindenAnnan översättning: \"käften\".","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/swe_fol/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}