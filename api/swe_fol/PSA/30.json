{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":30,"content":[{"type":"heading","content":["Tacksamhet för räddning"]},{"type":"verse","number":1,"content":[{"text":"En psalm, en sång för tempelinvigningen","descriptive":true},{"noteId":88},{"text":". Av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jag vill upphöja dig, Herre,","poem":1},{"text":"för du drog mig upp ur djupet","poem":2},{"text":"och lät inte mina fiender","poem":3},{"text":"triumfera över mig.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Herre min Gud,","poem":1},{"text":"jag ropade till dig","poem":2},{"text":"och du helade mig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Herre, du förde min själ","poem":1},{"text":"upp ur dödsriket,","poem":3},{"text":"du tog mig levande bort","poem":2},{"text":"från dem som går","poem":3},{"noteId":89},{"text":"ner","poem":3},{"text":"i graven.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lovsjung Herren, ni hans trogna,","poem":1},{"text":"prisa hans heliga namn!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hans vrede varar ett ögonblick,","poem":1},{"text":"hans nåd hela livet.","poem":3},{"noteId":90},{"text":"På kvällen gästar gråt,","poem":2},{"text":"på morgonen kommer jubel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jag sade i min trygghet:","poem":1},{"text":"\"Jag ska aldrig vackla.\"","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Herre, i din nåd gav du","poem":1},{"text":"styrka åt mitt berg,","poem":3},{"text":"men du dolde ditt ansikte","poem":2},{"text":"och jag blev förskräckt.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Till dig, Herre, ropade jag,","poem":1},{"text":"till Herren bad jag om nåd:","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vad vinner du på mitt blod,","poem":1},{"text":"på att jag går ner i graven?","poem":3},{"text":"Kan stoftet tacka dig?","poem":2},{"text":"Kan det förkunna din trofasthet?","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Hör, Herre,","poem":1},{"text":"och förbarma dig över mig!","poem":3},{"text":"Herre, var min hjälpare!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Du förvandlade min klagan till dans,","poem":1},{"text":"du lossade min sorgdräkt","poem":2},{"text":"och klädde mig i glädje.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Därför ska min ära","poem":1},{"noteId":91},{"text":"sjunga till dig utan att tystna.","poem":3},{"text":"Herre min Gud,","poem":2},{"text":"jag vill tacka dig för evigt.","poem":3}]}],"footnotes":[{"noteId":88,"caller":"-","text":"en sång för tempelinvigningenTroligen förberedd av kung David och framförd postumt. Se 1 Krön 28:2f, 2 Krön 7:6.","reference":{"chapter":30,"verse":1}},{"noteId":89,"caller":"-","text":"från dem som gårAndra handskrifter: \"från att gå\".","reference":{"chapter":30,"verse":4}},{"noteId":90,"caller":"-","text":"Andra handskrifter (så Septuaginta): \"Hans vrede ger bävan, hans nåd ger liv\".","reference":{"chapter":30,"verse":6}},{"noteId":91,"caller":"-","text":"min äraOfta uppfattat som liktydigt med \"min själ\".","reference":{"chapter":30,"verse":13}}]},"thisChapterLink":"/api/swe_fol/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":13}