{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":31,"content":[{"type":"heading","content":["Räddning undan förföljare"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Till dig, Herre, tar jag min tillflykt.","poem":1},{"text":"Låt mig aldrig behöva skämmas,","poem":2},{"text":"rädda mig i din rättfärdighet.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Vänd ditt öra till mig,","poem":1},{"text":"skynda till min räddning!","poem":3},{"text":"Var min fasta klippa,","poem":2},{"text":"en borg till min frälsning,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"för du är min klippa och min borg.","poem":1},{"text":"Du ska leda och föra mig","poem":2},{"text":"för ditt namns skull,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"du ska lossa mig ur nätet","poem":1},{"text":"de lagt ut för mig,","poem":3},{"text":"för du är mitt beskydd.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"I din hand","poem":1},{"noteId":92},{"text":"överlämnar jag","poem":1},{"text":"min ande.","poem":3},{"text":"Du har friköpt mig, Herre,","poem":2},{"text":"du trofaste Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jag hatar","poem":1},{"noteId":93},{"text":"dem som håller fast","poem":1},{"text":"vid tomma avgudar,","poem":3},{"text":"jag litar på Herren.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jag vill jubla och glädjas","poem":1},{"text":"över din nåd,","poem":3},{"text":"att du ser mitt lidande","poem":2},{"text":"och känner min själ i nöden.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Du utlämnar mig inte","poem":1},{"text":"i fiendens hand,","poem":3},{"text":"du ställer mina fötter","poem":2},{"text":"på rymlig plats.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Förbarma dig över mig, Herre,","poem":1},{"text":"jag är i nöd!","poem":3},{"text":"Grämelse förtär mitt öga,","poem":2},{"text":"min själ och min kropp.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Mitt liv försvinner i sorg,","poem":1},{"text":"mina år i suckan.","poem":3},{"text":"Min kraft är bruten","poem":2},{"text":"genom min synd","poem":3},{"noteId":94},{"text":",","poem":3},{"text":"mina ben","poem":2},{"noteId":95},{"text":"förtärs","poem":2}]},{"type":"verse","number":12,"content":[{"text":"för alla mina fienders skull.","poem":3},{"text":"Jag har blivit en skam","poem":2},{"text":"för mina grannar","poem":3},{"text":"och en skräck","poem":2},{"text":"för dem som känner mig.","poem":3},{"text":"De som ser mig på gatan","poem":2},{"text":"flyr för mig.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Jag är glömd och borta","poem":1},{"text":"ur deras hjärtan, som död,","poem":3},{"text":"jag har blivit som ett krossat kärl.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jag hör vad många viskar,","poem":1},{"text":"skräck från alla håll!","poem":3},{"text":"De gaddar ihop sig mot mig,","poem":2},{"text":"smider planer för att ta mitt liv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Men jag litar på dig, Herre,","poem":1},{"text":"jag säger: \"Du är min Gud.\"","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Min tid är i dina händer.","poem":1},{"text":"Rädda mig från mina fienders hand,","poem":2},{"text":"från dem som förföljer mig.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Låt ditt ansikte lysa","poem":1},{"text":"över din tjänare,","poem":3},{"text":"fräls mig genom din nåd.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Herre, låt mig inte","poem":1},{"text":"behöva skämmas,","poem":2},{"text":"jag ropar till dig!","poem":3},{"text":"Låt de gudlösa få skämmas,","poem":2},{"text":"låt dem tystna i dödsriket.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Låt lögnarnas läppar förstummas,","poem":1},{"text":"de som talar fräckhet i högmod","poem":2},{"text":"och förakt mot den rättfärdige.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hur stor är inte din godhet,","poem":1},{"text":"som du sparar åt dem","poem":2},{"text":"som vördar dig","poem":3},{"text":"och visar i människors åsyn","poem":2},{"text":"mot dem som flyr till dig!","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Du tar dem i ditt ansiktes beskydd","poem":1},{"text":"mot människors intriger,","poem":3},{"text":"du gömmer dem i din hydda","poem":2},{"text":"undan elaka tungor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Lovad är Herren!","poem":1},{"text":"Han har visat mig","poem":2},{"text":"sin underbara nåd","poem":3},{"text":"i en belägrad","poem":2},{"noteId":96},{"text":"stad.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Jag sade i min ångest:","poem":1},{"text":"\"Jag är avskuren från dina ögon!\"","poem":3},{"text":"Men du hörde min bön om nåd","poem":2},{"text":"när jag ropade till dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Älska Herren,","poem":1},{"text":"alla ni hans trogna!","poem":3},{"text":"Herren bevarar de trofasta,","poem":2},{"text":"men den som handlar i högmod","poem":3},{"text":"straffar han strängt.","poem":4}]},{"type":"verse","number":25,"content":[{"text":"Var starka och modiga i era hjärtan,","poem":1},{"text":"alla ni som hoppas på Herren!","poem":2}]}],"footnotes":[{"noteId":92,"caller":"-","text":"I din handAndra handskrifter (Septuaginta): \"I dina händer\" (jfr Jesu ord i Luk 23:46).","reference":{"chapter":31,"verse":6}},{"noteId":93,"caller":"-","text":"Jag hatarAndra handskrifter (så Septuaginta): \"Du hatar\".","reference":{"chapter":31,"verse":7}},{"noteId":94,"caller":"-","text":"min syndAnnan översättning (så Septuaginta): \"mitt lidande\".","reference":{"chapter":31,"verse":11}},{"noteId":95,"caller":"-","text":"benEtt uttryck för människans inre (djupt under muskler och hud).","reference":{"chapter":31,"verse":11}},{"noteId":96,"caller":"-","text":"belägradAnnan översättning: \"befäst\".","reference":{"chapter":31,"verse":22}}]},"thisChapterLink":"/api/swe_fol/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":25}