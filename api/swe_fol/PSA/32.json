,"number":5,"content":[{"text":"Då erkände jag min synd för dig","poem":1},{"text":"och dolde inte min skuld.","poem":3},{"text":"Jag sade: \"Jag vill bekänna","poem":2},{"text":"mina brott för Herren\" –","poem":3},{"text":"då förlät du mig min syndaskuld.","poem":2},{"text":"Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Därför ska alla trogna be till dig","poem":1},{"text":"medan du går att finna.","poem":3},{"text":"Om väldiga vattenfloder kommer","poem":2},{"text":"ska de inte nå dem.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Du är mitt beskydd,","poem":1},{"text":"du bevarar mig från nöd,","poem":3},{"text":"du omger mig","poem":2},{"text":"med frälsningens jubel. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jag vill lära dig och undervisa dig","poem":1},{"text":"om den väg du ska vandra,","poem":3},{"text":"jag vill ge dig råd","poem":2},{"text":"och låta mitt öga vaka över dig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Var inte som en häst eller mula","poem":1},{"text":"som saknar förstånd,","poem":3},{"text":"som måste tämjas","poem":2},{"text":"med töm och betsel","poem":3},{"text":"om de ska komma till dig.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Den gudlöse har många plågor,","poem":1},{"text":"men den som litar på Herren","poem":2},{"text":"omger han med nåd.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Gläd er i Herren och fröjda er,","poem":1},{"text":"ni rättfärdiga,","poem":3},{"text":"jubla, alla ni som har ärliga hjärtan!","poem":2}]}],"footnotes":[{"noteId":97,"caller":"-","text":"vishetspsalmHebr. maskíl(även i Ps 42, 44-45, 52-55, 74, 78, 88-89, 142).","reference":{"chapter":32,"verse":1}},{"noteId":98,"caller":"-","text":"min kraft rann bort som iAnnan översättning: \"jag blev som en åker i\".","reference":{"chapter":32,"verse":4}}]},"thisChapterLink":"/api/swe_fol/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}