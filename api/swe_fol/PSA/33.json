{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":33,"content":[{"type":"heading","content":["Herrens allmakt och nåd"]},{"type":"verse","number":1,"content":[{"text":"Jubla i Herren, ni rättfärdiga!","poem":1},{"text":"De ärligas lovsång är skön","poem":2},{"noteId":99},{"text":".","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tacka Herren med harpa,","poem":1},{"text":"sjung hans lov","poem":2},{"text":"med tiosträngad lyra.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Sjung till honom en ny sång,","poem":1},{"text":"spela vackert med jubelrop,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"för Herrens ord är rätt","poem":1},{"text":"och han är trofast i allt han gör.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Han älskar rättfärdighet och rätt,","poem":1},{"text":"jorden är full av Herrens nåd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Himlen är skapad","poem":1},{"text":"genom Herrens ord,","poem":3},{"text":"hela dess här","poem":2},{"text":"genom hans muns ande.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Han samlar havets vatten","poem":1},{"text":"som i en hög","poem":3},{"noteId":100},{"text":",","poem":3},{"text":"han lägger djupen","poem":2},{"text":"i förvaringsrum.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Hela jorden ska frukta Herren,","poem":1},{"text":"alla som bor i världen","poem":2},{"text":"ska bäva för honom,","poem":3}]},{"type":"verse","number":9,"content":[{"text":"för han sade och det blev till,","poem":1},{"text":"han befallde och det stod där","poem":2},{"noteId":101},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Herren gör hednafolkens planer","poem":1},{"text":"om intet,","poem":3},{"text":"han gäckar folkens tankar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Men Herrens plan","poem":1},{"text":"består för evigt,","poem":3},{"text":"hans hjärtas tankar","poem":2},{"text":"från släkte till släkte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Saligt är det folk","poem":1},{"text":"som har Herren till sin Gud,","poem":3},{"text":"det folk han har utvalt","poem":2},{"text":"till sin arvedel.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Från himlen blickar Herren ner,","poem":1},{"text":"han ser alla människors barn,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"från sin boning betraktar han","poem":1},{"text":"alla som bor på jorden.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Han formar alla deras hjärtan,","poem":1},{"text":"han förstår alla deras verk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"En kung segrar inte","poem":1},{"text":"genom stor armé,","poem":3},{"text":"en hjälte räddar sig inte","poem":2},{"text":"genom stor styrka.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"En häst ger inget hopp om seger,","poem":1},{"text":"med all sin kraft räddar den inte.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Men Herrens ögon ser till dem","poem":1},{"text":"som vördar honom,","poem":3},{"text":"till dem som hoppas på hans nåd,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"för att rädda deras själ från döden","poem":1},{"text":"och hålla dem vid liv","poem":2},{"text":"i hungerns tid.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Vår själ väntar på Herren,","poem":1},{"text":"han är vår hjälp","poem":2},{"text":"och vår sköld.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"I honom gläder sig vårt hjärta,","poem":1},{"text":"vi förtröstar på hans heliga namn.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Låt din nåd vila över oss, Herre!","poem":1},{"text":"Vi sätter vårt hopp till dig.","poem":2}]}],"footnotes":[{"noteId":99,"caller":"-","text":"De ärligas lovsång är skönAnnan översättning: \"Lovsång anstår de ärliga\".","reference":{"chapter":33,"verse":1}},{"noteId":100,"caller":"-","text":"högAndra handskrifter (Septuaginta): \"säck\".","reference":{"chapter":33,"verse":7}},{"noteId":101,"caller":"-","text":"stod därAnnan översättning: \"bestod\".","reference":{"chapter":33,"verse":9}}]},"thisChapterLink":"/api/swe_fol/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}