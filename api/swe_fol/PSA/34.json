{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":34,"content":[{"type":"heading","content":["Herrens godhet och hjälp"]},{"type":"verse","number":1,"content":[{"text":"Av David, när han spelade galen inför Abimelek","descriptive":true},{"noteId":102},{"text":", som drev bort honom så att han kom undan.","descriptive":true},{"noteId":103}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jag vill alltid prisa Herren,","poem":1},{"text":"hans lov ska ständigt","poem":2},{"text":"vara i min mun.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Min själ ska vara stolt i Herren,","poem":1},{"text":"de ödmjuka ska höra det","poem":2},{"text":"och glädjas.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Lova Herren med mig,","poem":1},{"text":"låt oss upphöja hans namn","poem":2},{"text":"tillsammans!","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jag sökte Herren","poem":1},{"text":"och han svarade mig,","poem":3},{"text":"han räddade mig","poem":2},{"text":"från allt som skrämde mig.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"De som ser upp till honom","poem":1},{"text":"strålar av fröjd,","poem":3},{"text":"deras ansikten","poem":2},{"noteId":104},{"text":"behöver inte","poem":2},{"text":"rodna av skam.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Här är en plågad som ropade,","poem":1},{"text":"och Herren hörde honom","poem":3},{"text":"och frälste honom","poem":2},{"text":"ur all hans nöd.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Herrens ängel vakar","poem":1},{"text":"runt dem som vördar honom,","poem":3},{"text":"och han befriar dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Smaka och se att Herren är god!","poem":1},{"text":"Salig är den som flyr till honom.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vörda Herren, ni hans heliga,","poem":1},{"text":"för de som vördar honom","poem":2},{"text":"saknar ingenting.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Unga lejon lider nöd och hungrar,","poem":1},{"text":"men de som söker Herren","poem":2},{"text":"saknar inget gott.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kom, barn, lyssna till mig!","poem":1},{"text":"Jag ska lära er att vörda Herren.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Är du en människa","poem":1},{"text":"som älskar livet","poem":3},{"text":"och vill se goda dagar?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Vakta då din tunga","poem":1},{"text":"från det som är ont,","poem":3},{"text":"dina läppar från att tala svek.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Undvik det onda och gör det goda,","poem":1},{"text":"sök friden och följ den.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Herrens ögon är vända","poem":1},{"text":"till de rättfärdiga","poem":3},{"text":"och hans öron till deras rop.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Men Herrens ansikte","poem":1},{"text":"är emot dem som gör det onda,","poem":3},{"text":"för att utplåna minnet av dem","poem":2},{"text":"från jorden.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"De rättfärdiga ropar","poem":1},{"text":"och Herren hör,","poem":3},{"text":"han räddar dem ur all deras nöd.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Herren är nära dem","poem":1},{"text":"som har ett förkrossat hjärta","poem":3},{"text":"och frälser dem","poem":2},{"text":"som har en bedrövad ande.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Mycket får den rättfärdige lida,","poem":1},{"text":"men Herren räddar honom ur allt.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Han bevarar alla hans ben,","poem":1},{"text":"inte ett enda av dem ska krossas.","poem":2},{"noteId":105}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ondskan blir den gudlöses död,","poem":1},{"text":"och de som hatar den rättfärdige","poem":2},{"text":"ska stå med skuld.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Men Herren friköper","poem":1},{"text":"sina tjänares själar,","poem":3},{"text":"och ingen som flyr till honom","poem":2},{"text":"ska stå med skuld.","poem":3}]}],"footnotes":[{"noteId":102,"caller":"-","text":"när han spelade galen inför AbimelekSe 1 Sam 21:10f. Kungen kallas där Akish, men Abimelek var ett vedertaget namn på härskare i Gazaområdet (jfr 1 Mos 20:2, 26:1).","reference":{"chapter":34,"verse":1}},{"noteId":103,"caller":"-","text":"Alfabetisk psalm: verserna (från 34:2) börjar med det hebreiska alfabetets 22 bokstäver i följd.","reference":{"chapter":34,"verse":1}},{"noteId":104,"caller":"-","text":"De som ser upp till honom … deras ansiktenAndra handskrifter: \"Se upp till honom … ert ansikte\".","reference":{"chapter":34,"verse":6}},{"noteId":105,"caller":"-","text":"Citeras i Joh 19:36 som profetia om Jesu korsfästelse (jfr 2 Mos 12:46).","reference":{"chapter":34,"verse":21}}]},"thisChapterLink":"/api/swe_fol/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":23}