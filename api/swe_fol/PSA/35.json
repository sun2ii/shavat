{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":35,"content":[{"type":"heading","content":["Oskyldigt anklagad"]},{"type":"verse","number":1,"content":[{"text":"Av David.","descriptive":true},{"lineBreak":true},{"text":"Herre, kämpa mot dem","poem":1},{"text":"som kämpar mot mig,","poem":3},{"text":"strid mot dem","poem":2},{"text":"som strider mot mig!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Grip sköld och skydd","poem":1},{"text":"och kom till min hjälp,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"dra fram spjutet","poem":1},{"text":"och spärra vägen","poem":2},{"text":"för mina förföljare.","poem":3},{"text":"Säg till min själ:","poem":2},{"text":"\"Jag är din frälsning!\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Låt dem som vill ta mitt liv","poem":1},{"text":"få skam och vanära,","poem":3},{"text":"låt dem som planerar min olycka","poem":2},{"text":"tvingas tillbaka med skam.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Låt dem bli som agnar för vinden,","poem":1},{"text":"låt Herrens ängel driva bort dem.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Låt deras väg bli mörk och hal,","poem":1},{"text":"låt Herrens ängel förfölja dem.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Utan orsak dolde de sin nätgrop","poem":1},{"text":"för att fånga mig,","poem":3},{"text":"utan orsak grävde de den","poem":2},{"text":"för att ta mitt liv.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Låt fördärvet drabba dem oväntat,","poem":1},{"text":"låt dem fastna i nätet de lagt ut","poem":3},{"text":"och falla i gropen","poem":2},{"text":"till sitt eget fördärv.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Min själ ska jubla i Herren","poem":1},{"text":"och glädjas över hans frälsning.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Varje ben i min kropp ska säga:","poem":1},{"text":"\"Herre, vem är som du?","poem":3},{"text":"Du räddar den svage","poem":2},{"text":"från hans överman,","poem":3},{"text":"den svage och fattige","poem":2},{"text":"från den som plundrar honom.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Falska vittnen träder fram,","poem":1},{"text":"de frågar mig om saker jag inte vet.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"De lönar mig med ont mot gott,","poem":1},{"text":"min själ är övergiven.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Men jag gick i sorgdräkt","poem":1},{"text":"när de var sjuka,","poem":3},{"text":"jag späkte min själ med fasta","poem":2},{"text":"och bad med böjt huvud","poem":3},{"noteId":106},{"text":".","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Jag gjorde som för min vän,","poem":1},{"text":"som för min bror,","poem":3},{"text":"jag gick sorgklädd och böjd","poem":2},{"text":"som när man sörjer sin mor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Men när jag faller","poem":1},{"text":"gläder de sig och gaddar ihop sig,","poem":3},{"text":"uslingar jag inte känner","poem":2},{"text":"gaddar ihop sig mot mig.","poem":3},{"text":"De river i mig utan uppehåll.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bland gudlösa som hånar","poem":1},{"text":"för en kaka bröd","poem":3},{"noteId":107},{"text":"gnisslar de tänder mot mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Herre, hur länge ska du se på?","poem":1},{"text":"Befria min själ från deras härjningar,","poem":2},{"text":"mitt dyrbara liv från lejonen.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Jag ska tacka dig","poem":1},{"text":"i den stora församlingen,","poem":3},{"text":"prisa dig bland mycket folk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Låt inte mina svekfulla","poem":1},{"noteId":108},{"text":"fiender","poem":1},{"text":"få triumfera över mig,","poem":3},{"text":"låt inte dem som hatar mig","poem":2},{"text":"utan orsak","poem":3},{"text":"få blinka med ögonen.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Det är inte frid de talar,","poem":1},{"text":"de tänker ut svekfulla ord","poem":2},{"text":"mot de stilla i landet.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"De spärrar upp sina gap mot mig,","poem":1},{"text":"de säger: \"Haha, haha!","poem":2},{"text":"Vi har sett det med egna ögon!\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Du ser det, Herre.","poem":1},{"text":"Var inte tyst, Herre,","poem":2},{"text":"var inte långt från mig.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Vakna, res dig till mitt försvar,","poem":1},{"text":"ta dig an min sak,","poem":2},{"text":"min Gud och Herre!","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Döm mig efter din rättfärdighet,","poem":1},{"text":"Herre min Gud!","poem":3},{"text":"Låt dem inte triumfera över mig,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"låt dem inte få säga i sina hjärtan:","poem":1},{"text":"\"Haha! Precis som vi ville!\"","poem":3},{"text":"Låt dem inte få säga:","poem":2},{"text":"\"Vi slukade honom!\"","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Låt alla som gläds åt min olycka","poem":1},{"text":"få skämmas och blygas,","poem":3},{"text":"låt dem som förhäver sig över mig","poem":2},{"text":"kläs i skam och vanära.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Men låt dem som unnar mig min rätt","poem":1},{"text":"få jubla och glädjas,","poem":3},{"text":"låt dem alltid få säga:","poem":2},{"text":"\"Herren är stor,","poem":3},{"text":"han unnar sin tjänare frid!\"","poem":4}]},{"type":"verse","number":28,"content":[{"text":"Då ska min tunga","poem":1},{"text":"förkunna din rättfärdighet,","poem":2},{"text":"ditt lov dagen lång.","poem":3}]}],"footnotes":[{"noteId":106,"caller":"-","text":"bad med böjt huvudAnnan översättning: \"min bön återvände till min famn\".","reference":{"chapter":35,"verse":13}},{"noteId":107,"caller":"-","text":"Bland gudlösa som hånar för en kaka brödAndra handskrifter (Septuaginta): \"De prövar mig, de hånar mig hånfullt, så\".","reference":{"chapter":35,"verse":16}},{"noteId":108,"caller":"-","text":"svekfullaAnnan översättning: \"oförtjänta\".","reference":{"chapter":35,"verse":19}}]},"thisChapterLink":"/api/swe_fol/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}