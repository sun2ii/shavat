{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":36,"content":[{"type":"heading","content":["Syndarens ondska och Guds godhet"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. Av Herrens tjänare David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"I mitt hjärta hör jag","poem":1},{"text":"vad synden viskar","poem":2},{"text":"till den gudlöse.","poem":3},{"text":"Han har ingen gudsfruktan","poem":2},{"text":"för ögonen,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"han intalar sig","poem":1},{"noteId":109},{"text":"att ingen","poem":1},{"text":"ska upptäcka och hata hans brott.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hans muns ord är ondska och svek,","poem":1},{"text":"han vill inte vara förståndig","poem":2},{"text":"och god.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Han tänker ut ondska på sin bädd,","poem":1},{"text":"han går en väg som inte är god.","poem":2},{"text":"Han skyr inte något ont.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Herre, till himlen räcker din nåd,","poem":1},{"text":"din trofasthet ända till skyarna.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Din rättfärdighet","poem":1},{"text":"är som väldiga berg,","poem":3},{"text":"dina domar","poem":2},{"text":"som det stora havsdjupet.","poem":3},{"text":"Både människor och djur","poem":2},{"text":"räddar du, Herre.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Hur dyrbar är inte din nåd, o Gud!","poem":1},{"text":"Människors barn har sin tillflykt","poem":2},{"text":"i dina vingars skugga.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"De mättas av rika gåvor i ditt hus,","poem":1},{"text":"av din ljuvlighets ström","poem":2},{"noteId":110},{"text":"ger du dem att dricka.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Hos dig är livets källa,","poem":1},{"text":"i ditt ljus ser vi ljus.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Låt din nåd bli kvar","poem":1},{"text":"över dem som känner dig,","poem":3},{"text":"din rättfärdighet över dem","poem":2},{"text":"som har ärliga hjärtan.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Låt inte de stoltas fot","poem":1},{"text":"trampa på mig","poem":3},{"text":"eller de gudlösas hand","poem":2},{"text":"driva bort mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Där ligger förbrytarna fallna,","poem":1},{"text":"nerslagna så att de inte kan resa sig.","poem":2}]}],"footnotes":[{"noteId":109,"caller":"-","text":"han intalar sigAnnan översättning: \"den (synden) intalar honom\".","reference":{"chapter":36,"verse":3}},{"noteId":110,"caller":"-","text":"din ljuvlighets strömSamma ordstam som Edens lustgård (1 Mos 2:10, Upp 22:1).","reference":{"chapter":36,"verse":9}}]},"thisChapterLink":"/api/swe_fol/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}