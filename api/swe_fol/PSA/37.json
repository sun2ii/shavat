ext":"Han ska låta din rättfärdighet","poem":1},{"text":"gå fram som ljuset,","poem":3},{"text":"din rätt som middagssolen.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Var stilla inför Herren","poem":1},{"text":"och vänta på honom.","poem":3},{"text":"Gräm dig inte över den","poem":2},{"text":"som har framgång,","poem":3},{"text":"som gör upp onda planer.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Släpp vreden och lämna ilskan.","poem":1},{"text":"Gräm dig inte,","poem":2},{"text":"det för bara ont med sig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"De onda ska utrotas,","poem":1},{"text":"men de som hoppas på Herren","poem":2},{"text":"ska ärva landet.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Ännu en liten tid,","poem":1},{"text":"så finns där ingen gudlös.","poem":3},{"text":"När du ser på hans plats","poem":2},{"text":"är han borta.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Men de ödmjuka ska ärva landet","poem":1},{"text":"och njuta stor frid.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Den gudlöse smider planer","poem":1},{"text":"mot den rättfärdige,","poem":3},{"text":"han gnisslar tänder mot honom.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Men Herren ler åt honom,","poem":1},{"text":"för han ser att hans stund kommer.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"De gudlösa drar svärdet","poem":1},{"text":"och spänner sin båge","poem":3},{"text":"för att fälla den svage och fattige,","poem":2},{"text":"för att slakta dem","poem":3},{"text":"som går på rätta vägar.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Men deras svärd","poem":1},{"text":"ska gå in i deras eget hjärta,","poem":3},{"text":"och deras bågar ska brista.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bättre det lilla som en rättfärdig har","poem":1},{"text":"än många gudlösas rikedom.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"De gudlösas armar ska brytas,","poem":1},{"text":"men Herren stöder de rättfärdiga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Herren känner","poem":1},{"text":"de oskyldigas dagar,","poem":3},{"text":"deras arvslott består för evigt.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"De behöver inte skämmas","poem":1},{"text":"i onda tider,","poem":3},{"text":"i hungerns dagar blir de mättade.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Men de gudlösa ska gå under.","poem":1},{"text":"Herrens fiender försvinner","poem":2},{"text":"som ängarnas prakt,","poem":3},{"text":"de försvinner som rök","poem":4},{"noteId":114},{"text":".","poem":4}]},{"type":"verse","number":21,"content":[{"text":"Den gudlöse lånar","poem":1},{"text":"och betalar inte tillbaka,","poem":3},{"text":"men den rättfärdige är barmhärtig","poem":2},{"text":"och generös.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"De Herren välsignar","poem":1},{"text":"ska ärva landet,","poem":3},{"text":"men de han förbannar ska utrotas.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Med Herren","poem":1},{"text":"blir en mans steg fasta","poem":2},{"text":"och han gläds över hans väg.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Om han faller ramlar han inte,","poem":1},{"text":"för Herren håller hans hand.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ung har jag varit","poem":1},{"text":"och nu är jag gammal,","poem":3},{"text":"men aldrig har jag sett","poem":2},{"text":"en rättfärdig övergiven","poem":3},{"text":"eller hans barn tigga om bröd.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Han är alltid barmhärtig","poem":1},{"text":"och lånar ut,","poem":3},{"text":"och hans barn är till välsignelse.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Undvik det onda","poem":1},{"text":"och gör det goda,","poem":3},{"text":"så får du bo kvar för evigt.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Herren älskar det rätta,","poem":1},{"text":"han överger inte sina trogna.","poem":2},"עAjin",{"text":"De blir bevarade för evigt,","poem":1},{"text":"men de gudlösas ättlingar","poem":2},{"text":"blir utrotade.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"De rättfärdiga ska ärva landet","poem":1},{"text":"och bo där för evigt.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Den rättfärdiges mun talar vishet,","poem":1},{"text":"hans tunga säger det som är rätt.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Han har sin Guds undervisning","poem":1},{"text":"i hjärtat,","poem":3},{"text":"hans steg vacklar inte.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Den gudlöse spejar","poem":1},{"text":"på den rättfärdige","poem":3},{"text":"och söker tillfälle att döda honom.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Men Herren utlämnar honom inte","poem":1},{"text":"i hans hand","poem":3},{"text":"och låter honom inte bli fälld","poem":2},{"text":"i rätten.","poem":3}]},{"type":"verse","number":34,"content":[{"text":"Hoppas på Herren","poem":1},{"text":"och håll dig på hans väg,","poem":3},{"text":"så upphöjer han dig","poem":2},{"text":"och du får ärva landet.","poem":3},{"text":"Du ska se hur de gudlösa utrotas.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Jag såg en gudlös tyrann,","poem":1},{"text":"han bredde ut sig","poem":2},{"text":"som ett frodigt rotat träd.","poem":3},{"noteId":115}]},{"type":"verse","number":36,"content":[{"text":"Men han försvann","poem":1},{"text":"och nu är han borta,","poem":3},{"noteId":116},{"text":"jag sökte honom","poem":2},{"text":"men fann honom inte.","poem":3}]},{"type":"verse","number":37,"content":[{"text":"Betrakta den oskyldige,","poem":1},{"text":"se på den ärlige,","poem":3},{"text":"det finns en framtid","poem":2},{"text":"för fridens man.","poem":3}]},{"type":"verse","number":38,"content":[{"text":"Men syndarna går alla under,","poem":1},{"text":"de gudlösas framtid blir avskuren.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"De rättfärdigas frälsning","poem":1},{"text":"kommer från Herren,","poem":3},{"text":"han är deras borg i nödens tid.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Herren hjälper dem och befriar dem,","poem":1},{"text":"han befriar dem från de gudlösa","poem":2},{"text":"och frälser dem,","poem":3},{"text":"för de tar sin tillflykt till honom.","poem":2}]}],"footnotes":[{"noteId":111,"caller":"-","text":"Alfabetisk psalm: versgrupperna börjar med det hebreiska alfabetets 22 bokstäver i följd.","reference":{"chapter":37,"verse":1}},{"noteId":112,"caller":"-","text":"torkar de bortAnnan översättning: \"klipps de av\".","reference":{"chapter":37,"verse":2}},{"noteId":113,"caller":"-","text":"lev iAnnan översättning: \"lev av\".","reference":{"chapter":37,"verse":3}},{"noteId":114,"caller":"-","text":"som rökAndra handskrifter: \"i rök\".","reference":{"chapter":37,"verse":20}},{"noteId":115,"caller":"-","text":"som ett frodigt rotat trädAndra handskrifter (Septuaginta): \"som cedrarna på Libanon\".","reference":{"chapter":37,"verse":35}},{"noteId":116,"caller":"-","text":"han försvannAndra handskrifter (Septuaginta): \"jag gick förbi\".","reference":{"chapter":37,"verse":36}}]},"thisChapterLink":"/api/swe_fol/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}