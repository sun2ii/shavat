{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":38,"content":[{"type":"heading","content":["Den ångerfulles bön"]},{"type":"verse","number":1,"content":[{"text":"En psalm av David. En bön.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, straffa mig inte i din vrede,","poem":1},{"text":"tukta mig inte i din glöd!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dina pilar har träffat mig,","poem":1},{"text":"din hand har drabbat mig.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jag har inget helt i min kropp","poem":1},{"text":"på grund av din vrede,","poem":3},{"text":"ingen frid i mina ben","poem":2},{"text":"på grund av min synd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Min syndaskuld","poem":1},{"text":"går mig över huvudet,","poem":3},{"text":"den tynger mig","poem":2},{"text":"som en alltför tung börda.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Mina sår stinker och rinner","poem":1},{"text":"på grund av min dårskap.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag går krokig och djupt böjd,","poem":1},{"text":"hela dagen går jag sörjande.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mina höfter är fulla av brand,","poem":1},{"text":"jag har inget helt i min kropp.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jag är maktlös och helt krossad,","poem":1},{"text":"jag ropar i mitt hjärtas ångest.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Herre, du känner all min längtan,","poem":1},{"text":"mina suckar är inte dolda för dig.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mitt hjärta slår häftigt,","poem":1},{"text":"min kraft har lämnat mig.","poem":3},{"text":"Mina ögons ljus är också borta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mina nära och kära","poem":1},{"text":"håller sig borta från min plåga,","poem":3},{"text":"mina närmaste stannar på avstånd.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"De som vill ta mitt liv lägger snaror,","poem":1},{"text":"de som söker min olycka","poem":2},{"text":"talar om min undergång.","poem":3},{"text":"Ständigt tänker de på svek.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Men jag liknar en döv som inte hör,","poem":1},{"text":"en stum som inte öppnar sin mun.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jag liknar en man som inte hör,","poem":1},{"text":"en vars mun saknar svar,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"för jag hoppas på dig, Herre.","poem":1},{"text":"Du ska svara, Herre min Gud.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jag tänker:","poem":1},{"text":"Låt dem inte triumfera över mig","poem":2},{"text":"eller förhäva sig över mig","poem":3},{"text":"när min fot vacklar,","poem":4}]},{"type":"verse","number":18,"content":[{"text":"för jag är nära att falla,","poem":1},{"text":"jag känner ständigt min smärta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Jag bekänner min skuld,","poem":1},{"text":"jag sörjer över min synd.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mina fiender lever och är mäktiga,","poem":1},{"text":"många hatar mig utan orsak.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"De lönar gott med ont,","poem":1},{"text":"de är emot mig","poem":3},{"text":"för att jag strävar efter det goda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Överge mig inte, Herre!","poem":1},{"text":"Min Gud, var inte långt ifrån mig.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Skynda till min hjälp,","poem":1},{"text":"Herre, min frälsning!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}