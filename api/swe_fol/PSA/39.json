{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":39,"content":[{"type":"heading","content":["Människans förgänglighet"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till Jedutun","descriptive":true},{"noteId":117},{"text":". En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jag sade:","poem":1},{"text":"\"Jag ska akta mig","poem":2},{"text":"för att synda med min tunga,","poem":3},{"text":"jag ska sätta lås för min mun","poem":2},{"text":"så länge den gudlöse","poem":3},{"text":"är framför mig.\"","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Jag blev stum och tyst,","poem":1},{"text":"jag höll inne även med det goda,","poem":2},{"text":"och min plåga blev allt värre.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Mitt hjärta brann inom mig,","poem":1},{"text":"medan jag grubblade","poem":2},{"text":"brann det som en eld.","poem":3},{"lineBreak":true},{"text":"Då talade jag","poem":1},{"text":"med min tunga:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Herre, lär mig förstå mitt slut,","poem":1},{"text":"att mina dagar har en gräns,","poem":3},{"text":"så att jag inser hur förgänglig","poem":2},{"text":"jag är.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Som en handsbredd","poem":1},{"text":"har du gjort mina dagar,","poem":3},{"text":"min livslängd är som ingenting","poem":2},{"text":"inför dig.","poem":3},{"text":"Alla människor är bara en vindpust,","poem":2},{"text":"hur säkra de än står. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Som en skuggbild","poem":1},{"text":"vandrar människan omkring,","poem":2},{"text":"oroar sig till ingen nytta,","poem":3},{"text":"samlar på hög","poem":2},{"text":"och vet inte vem som får det.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Men vad hoppas jag nu på, Herre?","poem":1},{"text":"Till dig står mitt hopp.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Rädda mig från alla mina synder,","poem":1},{"text":"låt mig inte bli hånad av dårar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jag tiger och öppnar inte min mun,","poem":1},{"text":"för det är du som har gjort det.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vänd bort din plåga ifrån mig,","poem":1},{"text":"jag går under av din hands aga.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"När du tuktar någon för hans skuld,","poem":1},{"text":"förtär du som mal det han har kärt.","poem":2},{"text":"Alla människor är bara","poem":3},{"text":"en vindpust. Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hör min bön, Herre,","poem":1},{"text":"lyssna till mitt rop!","poem":3},{"text":"Var inte tyst inför mina tårar,","poem":2},{"text":"för jag är en främling hos dig,","poem":3},{"text":"en gäst som alla mina fäder.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Vänd bort din blick från mig,","poem":1},{"text":"så att jag kan le igen","poem":3},{"text":"innan jag går bort","poem":2},{"text":"och inte finns här mer.","poem":3}]}],"footnotes":[{"noteId":117,"caller":"-","text":"JedutunLovsångsledare hos kung David (1 Krön 16:41). Hans tjänst gick i arv (1 Krön 25:1f).","reference":{"chapter":39,"verse":1}}]},"thisChapterLink":"/api/swe_fol/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}