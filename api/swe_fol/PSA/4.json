{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":4,"content":[{"type":"heading","content":["Aftonbön i nöd"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till stränginstrument. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Svara mig när jag ropar,","poem":1},{"text":"min rättfärdighets Gud!","poem":3},{"text":"När jag är trängd ger du mig rum.","poem":2},{"text":"Förbarma dig över mig","poem":3},{"text":"och hör min bön!","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Höga herrar,","poem":1},{"text":"hur länge ska ni kränka","poem":2},{"text":"min heder?","poem":3},{"text":"Hur länge ska ni älska tomhet","poem":2},{"text":"och jaga efter lögn? Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ni ska veta hur underbart","poem":1},{"text":"Herren tar till sig sin trogne,","poem":3},{"text":"Herren hör när jag ropar","poem":2},{"text":"till honom.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Grips ni av vrede, synda inte!","poem":1},{"text":"Tänk efter i era hjärtan på er bädd","poem":2},{"text":"och var stilla. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bär fram rätta offer","poem":1},{"text":"och lita på Herren.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Många säger:","poem":1},{"text":"\"Vem kan visa oss det goda?\"","poem":3},{"text":"Låt ditt ansiktes ljus","poem":2},{"text":"lysa över oss, Herre!","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Du har gett mig glädje i hjärtat,","poem":1},{"text":"mer än när andra får säd och vin","poem":2},{"text":"i mängd.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"I frid kan jag lägga mig ner","poem":1},{"text":"och sova","poem":3},{"noteId":13},{"text":",","poem":3},{"text":"för bara du, Herre,","poem":2},{"text":"låter mig bo i trygghet.","poem":3}]}],"footnotes":[{"noteId":13,"caller":"-","text":"bara du, Herre, låter mig bo i trygghetAnnan översättning: \"du, Herre, låter mig bo för mig själv i trygghet\".","reference":{"chapter":4,"verse":9}}]},"thisChapterLink":"/api/swe_fol/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}