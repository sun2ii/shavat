{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":40,"content":[{"type":"heading","content":["Tacksamhet och bön"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jag väntade och väntade på Herren,","poem":1},{"text":"och han böjde sig till mig","poem":2},{"text":"och hörde mitt rop.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Han drog mig upp ur fördärvets grop,","poem":1},{"text":"upp ur den djupa dyn.","poem":3},{"text":"Han ställde mina fötter på klippan","poem":2},{"text":"och gjorde mina steg fasta,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"han lade en ny sång i min mun,","poem":1},{"text":"en lovsång till vår Gud.","poem":3},{"text":"Många ska se det och frukta","poem":2},{"text":"och förtrösta på Herren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Salig är den som har Herren","poem":1},{"text":"till sin trygghet","poem":3},{"noteId":118},{"text":"och inte vänder sig till de stolta,","poem":2},{"text":"de som viker av till lögn.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Herre min Gud,","poem":1},{"text":"många är undren du gjort","poem":3},{"text":"och tankarna du tänkt för oss.","poem":2},{"text":"Inget kan liknas vid dig.","poem":3},{"text":"Jag vill förkunna","poem":2},{"text":"och berätta om dem,","poem":3},{"text":"de är fler än man kan räkna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Slaktoffer och matoffer","poem":1},{"text":"vill du inte ha","poem":2},{"text":"– du har öppnat mina öron","poem":3},{"noteId":119},{"text":"–","poem":3},{"text":"brännoffer och syndoffer","poem":2},{"text":"begär du inte.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Därför säger jag:","poem":1},{"text":"\"Se, jag kommer,","poem":2},{"text":"i bokrullen står det skrivet om mig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Att göra din vilja, min Gud,","poem":1},{"text":"är min glädje.","poem":3},{"text":"Din lag är i mitt hjärta.\"","poem":2},{"noteId":120}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jag förkunnar glädjebudet","poem":1},{"text":"om rättfärdighet","poem":2},{"text":"i den stora församlingen,","poem":3},{"text":"jag sluter inte mina läppar.","poem":2},{"text":"Du, Herre, vet det.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Jag döljer inte din rättfärdighet","poem":1},{"text":"i mitt hjärta,","poem":3},{"text":"jag talar om din trofasthet","poem":2},{"text":"och din frälsning.","poem":3},{"text":"Jag gömmer inte","poem":2},{"text":"din nåd och din sanning","poem":3},{"text":"för den stora församlingen.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Du, Herre, tar inte","poem":1},{"text":"din barmhärtighet ifrån mig.","poem":3},{"text":"Din nåd och din sanning","poem":2},{"text":"ska alltid bevara mig,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"för jag är omgiven av","poem":1},{"text":"otaliga onda ting.","poem":3},{"text":"Mina synder har hunnit ifatt mig,","poem":2},{"text":"jag orkar inte se dem","poem":3},{"noteId":121},{"text":".","poem":3},{"text":"De är fler än håren på mitt huvud.","poem":2},{"text":"Mitt mod sviker mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Var nådig, Herre, och rädda mig!","poem":1},{"text":"Herre, skynda till min hjälp!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Låt alla som vill ta mitt liv","poem":1},{"text":"möta skam och vanära,","poem":3},{"text":"låt dem som önskar mig ont","poem":2},{"text":"vika tillbaka och skämmas.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Låt dem häpna av skam,","poem":1},{"text":"de som säger till mig:","poem":2},{"text":"\"Haha, haha!\"","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Låt alla som söker dig","poem":1},{"text":"få jubla och glädjas i dig,","poem":3},{"text":"låt dem som älskar din frälsning","poem":2},{"text":"alltid säga: \"Herren är stor!\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Jag är betryckt och fattig,","poem":1},{"text":"men Herren tänker på mig.","poem":3},{"text":"Du är min hjälp och befriare.","poem":2},{"text":"Min Gud, dröj inte!","poem":3}]}],"footnotes":[{"noteId":118,"caller":"-","text":"har Herren till sin trygghetAnnan översättning (så Septuaginta): \"har sin trygghet i Herrens namn\".","reference":{"chapter":40,"verse":5}},{"noteId":119,"caller":"-","text":"öppnat mina öronAndra handskrifter (Septuaginta): \"berett mig en kropp\".","reference":{"chapter":40,"verse":7}},{"noteId":120,"caller":"-","text":"Citeras i Hebr 10:5-7 som profetia om Kristus.","reference":{"chapter":40,"verse":9}},{"noteId":121,"caller":"-","text":"orkar inte se demAnnan översättning: \"kan inte se\".","reference":{"chapter":40,"verse":13}}]},"thisChapterLink":"/api/swe_fol/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":18}