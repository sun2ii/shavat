{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":42,"content":[{"type":"heading","content":["Själens längtan efter Gud"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En vishetspsalm","descriptive":true},{"text":"av Koras söner.","descriptive":true},{"noteId":123}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Som hjorten längtar till vattenbäckar,","poem":1},{"text":"så längtar min själ efter dig, o Gud.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Min själ törstar efter Gud,","poem":1},{"text":"efter den levande Guden.","poem":3},{"text":"När får jag komma och träda fram","poem":2},{"text":"inför Guds ansikte?","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mina tårar är min mat","poem":1},{"text":"dag och natt.","poem":3},{"text":"Ständigt säger man till mig:","poem":2},{"text":"\"Var är din Gud?\"","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Jag utgjuter min själ","poem":1},{"text":"och minns hur jag gick","poem":2},{"text":"bland folket,","poem":3},{"text":"hur jag vandrade med dem","poem":2},{"text":"till Guds hus,","poem":3},{"text":"med jubelrop och tacksägelse","poem":2},{"text":"i skaran av högtidsfirare.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Varför så bedrövad, min själ,","poem":1},{"text":"varför så orolig i mig?","poem":2},{"text":"Hoppas på Gud.","poem":3},{"text":"Jag ska åter få tacka honom,","poem":2},{"text":"min frälsning och min Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Min själ är bedrövad i mig.","poem":1},{"text":"Därför tänker jag på dig","poem":2},{"text":"i Jordans land","poem":3},{"text":"och på Hermons höjder,","poem":2},{"text":"på Misars berg","poem":3},{"noteId":124},{"text":".","poem":3},{"noteId":125}]},{"type":"verse","number":8,"content":[{"text":"Djup ropar till djup","poem":1},{"text":"i dånet av dina vattenfall.","poem":3},{"text":"Alla dina svallande böljor","poem":2},{"text":"sköljer över mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Om dagen sänder Herren sin nåd,","poem":1},{"text":"och om natten","poem":2},{"text":"är hans sång hos mig,","poem":3},{"text":"en bön till mitt livs Gud.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Jag vill säga till Gud, min klippa:","poem":1},{"text":"\"Varför har du glömt mig?","poem":3},{"text":"Varför måste jag gå sörjande,","poem":2},{"text":"trängd av fiender?\"","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Det är som att man krossar mina ben","poem":1},{"text":"när mina fiender hånar mig","poem":3},{"text":"och ständigt frågar mig:","poem":2},{"text":"\"Var är din Gud?\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Varför så bedrövad, min själ,","poem":1},{"text":"varför så orolig i mig?","poem":2},{"text":"Hoppas på Gud.","poem":3},{"text":"Jag ska åter få tacka honom,","poem":2},{"text":"min frälsning och min Gud.","poem":3}]}],"footnotes":[{"noteId":123,"caller":"-","text":"Koras sönerAvdelning bland leviterna som tjänstgjorde med lovsång i templet (2 Krön 20:19). Angivna som författare till Ps 42-49, 84-85, 87.","reference":{"chapter":42,"verse":1}},{"noteId":124,"caller":"-","text":"tacka honom, min frälsning och min Gud. 7Min själAndra handskrifter: \"tacka honom för hans frälsning. 7Min Gud, min själ\". Jfr dock 42:12, 43:5.","reference":{"chapter":42,"verse":7}},{"noteId":125,"caller":"-","text":"Misars bergAnnan översättning (så Septuaginta): \"det lilla berget\", kanske en mindre topp i Hermonmassivet.","reference":{"chapter":42,"verse":7}}]},"thisChapterLink":"/api/swe_fol/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":12}