{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":43,"content":[{"type":"heading","content":["Fortsättning av föregående psalm"]},{"type":"verse","number":1,"content":[{"text":"Döm mig rättvist, Gud,","poem":1},{"text":"ta dig an min sak","poem":2},{"text":"mot ett kärlekslöst","poem":3},{"noteId":126},{"text":"folk!","poem":3},{"text":"Rädda mig från falska","poem":2},{"text":"och onda människor,","poem":3}]},{"type":"verse","number":2,"content":[{"text":"för du, Gud, är min styrka.","poem":1},{"text":"Varför har du förkastat mig?","poem":2},{"text":"Varför måste jag gå sorgsen,","poem":3},{"text":"trängd av fiender?","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sänd ditt ljus och din sanning.","poem":1},{"text":"Låt dem leda mig,","poem":2},{"text":"låt dem föra mig","poem":3},{"text":"till ditt heliga berg","poem":2},{"text":"och dina boningar,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"så att jag får gå in till Guds altare,","poem":1},{"text":"till Gud som är min glädje","poem":2},{"text":"och fröjd,","poem":3},{"text":"och tacka dig på harpa,","poem":2},{"text":"Gud, min Gud!","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Varför så bedrövad, min själ,","poem":1},{"text":"varför så orolig i mig?","poem":2},{"text":"Hoppas på Gud.","poem":3},{"text":"Jag ska åter få tacka honom,","poem":2},{"text":"min frälsning och min Gud.","poem":3}]}],"footnotes":[{"noteId":126,"caller":"-","text":"kärlekslöstAnnan översättning: \"trolöst\".","reference":{"chapter":43,"verse":1}}]},"thisChapterLink":"/api/swe_fol/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}