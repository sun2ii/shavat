{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":44,"content":[{"type":"heading","content":["Bön när fienderna tycks segra"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En vishetspsalm","descriptive":true},{"text":"av Koras söner.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gud, vi har hört med våra öron,","poem":1},{"text":"våra fäder har berättat för oss","poem":3},{"text":"om den gärning du gjorde","poem":2},{"text":"på deras tid, i forna dagar.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Med din hand","poem":1},{"text":"fördrev du hednafolken,","poem":2},{"text":"men våra fäder planterade du.","poem":3},{"text":"Andra folk förgjorde du,","poem":2},{"text":"men dem lät du breda ut sig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Det var inte med sitt svärd","poem":1},{"text":"som de intog landet,","poem":3},{"text":"inte deras egen arm","poem":2},{"text":"som frälste dem.","poem":3},{"text":"Nej, det var din högra hand,","poem":2},{"text":"din arm och ditt ansiktes ljus,","poem":3},{"text":"för du älskade dem.","poem":4}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Du är min kung, o Gud.","poem":1},{"text":"Ge befallning om frälsning","poem":2},{"text":"för Jakob!","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Genom dig ska vi slå ner","poem":1},{"text":"våra fiender,","poem":3},{"text":"genom ditt namn trampa ner","poem":2},{"text":"våra motståndare.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Jag litar inte till min båge,","poem":1},{"text":"mitt svärd kan inte frälsa mig.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nej, du har frälst oss","poem":1},{"text":"från våra fiender,","poem":3},{"text":"du lät dem som hatar oss","poem":2},{"text":"få skämmas.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Gud, vi lovar dig dagen lång,","poem":1},{"text":"vi prisar ditt namn för evigt.","poem":2},{"text":"Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ändå har du förkastat oss","poem":1},{"text":"och vanärat oss,","poem":3},{"text":"du drar inte ut med våra härar.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Du låter oss ge vika för fienden,","poem":1},{"text":"och de som hatar oss tar byte.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Du gör oss till slaktfår","poem":1},{"text":"och skingrar oss","poem":2},{"text":"bland hednafolken.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Du säljer ditt folk för ingenting,","poem":1},{"text":"du gör ingen vinst på affären.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Du gör oss till åtlöje","poem":1},{"text":"för våra grannar,","poem":3},{"text":"till spott och spe","poem":2},{"text":"för dem som bor omkring oss.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Du gör oss till ett ordspråk","poem":1},{"text":"bland hednafolken,","poem":3},{"text":"man skakar på huvudet","poem":2},{"text":"bland folken.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Dagen lång är min vanära inför mig,","poem":1},{"text":"mitt ansikte täcks av skam","poem":2}]},{"type":"verse","number":17,"content":[{"text":"när jag hör den som hånar och hädar,","poem":1},{"text":"när jag ser fienden","poem":2},{"text":"och den hämndlystne.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Allt detta har drabbat oss,","poem":1},{"text":"men vi har inte glömt dig","poem":2},{"text":"eller svikit ditt förbund.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Våra hjärtan har inte vänt sig bort,","poem":1},{"text":"våra steg har inte vikit från din väg.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Men du har krossat oss","poem":1},{"text":"där schakaler bor","poem":3},{"text":"och låtit dödens skugga","poem":2},{"text":"falla över oss.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Om vi hade glömt vår Guds namn","poem":1},{"text":"och sträckt våra händer","poem":2},{"text":"mot en främmande gud,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"skulle då inte Gud ha märkt det,","poem":1},{"text":"han som känner hjärtats","poem":2},{"text":"hemligheter?","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Nej, för din skull","poem":1},{"text":"dödas vi dagen lång,","poem":3},{"text":"vi räknas som slaktfår.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Vakna! Varför sover du, Herre?","poem":1},{"text":"Vakna upp, förkasta oss inte","poem":2},{"text":"för alltid!","poem":3}]},{"type":"verse","number":25,"content":[{"text":"Varför döljer du ditt ansikte","poem":1},{"text":"och glömmer vårt lidande","poem":2},{"text":"och betryck?","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Vår själ är nerböjd i stoftet,","poem":1},{"text":"vår kropp är nertryckt mot jorden.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Grip in och hjälp oss!","poem":1},{"text":"Friköp oss för din nåds skull.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":27}