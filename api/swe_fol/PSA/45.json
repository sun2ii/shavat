{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":45,"content":[{"type":"heading","content":["Messiaskungen och hans brud"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till \"Liljorna\". En vishetspsalm, en kärlekssång av Koras söner.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mitt hjärta flödar över av sköna ord,","poem":1},{"text":"jag säger: Min sång gäller en kung","poem":3},{"noteId":127},{"text":".","poem":3},{"text":"Min tunga är en snabb skrivares","poem":2},{"text":"penna.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Skönast är du bland människors barn,","poem":1},{"text":"nåd är utgjuten över dina läppar.","poem":3},{"text":"Därför har Gud välsignat dig","poem":2},{"text":"för evigt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fäst ditt svärd vid din sida, du hjälte,","poem":1},{"text":"i din höghet och härlighet.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dra så segerrik ut i din härlighet","poem":1},{"text":"för sanning, ödmjukhet","poem":2},{"text":"och rättfärdighet.","poem":3},{"text":"Din högra hand ska visa dig","poem":2},{"text":"underbara ting.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Dina pilar är skarpa,","poem":1},{"text":"folken ska falla för dig,","poem":2},{"text":"kungens fiender ska träffas","poem":3},{"text":"i hjärtat.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gud, din tron består","poem":1},{"text":"i evigheters evighet,","poem":3},{"text":"ditt rikes spira är rättens spira.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Du älskar rättfärdighet","poem":1},{"text":"och hatar orättfärdighet.","poem":3},{"text":"Därför, Gud, har din Gud","poem":2},{"text":"smort dig","poem":3},{"noteId":128},{"text":"med glädjens olja","poem":3},{"text":"mer än dina medbröder.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Av myrra, aloe och kassia","poem":1},{"text":"doftar alla dina kläder,","poem":3},{"text":"från elfenbenspalats","poem":2},{"text":"gläder dig strängars klang.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Kungadöttrar är bland dina utvalda","poem":1},{"noteId":129},{"text":",","poem":1},{"text":"drottningen står vid din högra sida","poem":2},{"text":"i guld från Ofir.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hör, dotter, se och lyssna!","poem":1},{"text":"Glöm ditt folk och din fars hus","poem":2}]},{"type":"verse","number":12,"content":[{"text":"och låt kungen åtrå din skönhet,","poem":1},{"text":"för han är din herre.","poem":3},{"text":"Böj dig och tillbe honom!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dottern Tyrus kommer med gåvor,","poem":1},{"text":"de rika bland folket","poem":2},{"text":"söker din gunst.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Full av härlighet","poem":1},{"text":"är kungadottern där inne,","poem":3},{"text":"av guldbrokad är hennes dräkt.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"I färggranna","poem":1},{"noteId":130},{"text":"kläder","poem":1},{"text":"förs hon till kungen,","poem":3},{"text":"åtföljd av jungfrur,","poem":2},{"text":"hennes väninnor","poem":3},{"text":"som leds in till dig.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Med glädje och jubel förs de fram,","poem":1},{"text":"de tågar in i kungens palats.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"I dina fäders ställe","poem":1},{"text":"ska dina söner komma,","poem":3},{"text":"du","poem":2},{"noteId":131},{"text":"ska sätta dem till furstar","poem":2},{"text":"över hela jorden","poem":3},{"noteId":132},{"text":".","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Ditt namn vill jag göra känt","poem":1},{"text":"genom alla släkten.","poem":3},{"text":"Därför ska folken lova dig","poem":2},{"text":"i evigheters evighet.","poem":3}]}],"footnotes":[{"noteId":127,"caller":"-","text":"jag säger: Min sång gäller en kungAnnan översättning: \"jag framför min sång för kungen\".","reference":{"chapter":45,"verse":2}},{"noteId":128,"caller":"-","text":"Därför, Gud, har din Gud smort digAnnan översättning: \"Därför har Gud, din Gud, smort dig.\" Jfr Hebr 1:9, där versen citeras som profetia om Kristus.","reference":{"chapter":45,"verse":8}},{"noteId":129,"caller":"-","text":"bland dina utvaldaAnnan översättning: \"(klädda) i dina skatter\".","reference":{"chapter":45,"verse":10}},{"noteId":130,"caller":"-","text":"färggrannaAnnan översättning: \"brokigt vävda\" eller \"broderade\".","reference":{"chapter":45,"verse":15}},{"noteId":131,"caller":"-","text":"dina … duSyftar på kungen, i maskulin form (jfr vers 3-10).","reference":{"chapter":45,"verse":17}},{"noteId":132,"caller":"-","text":"jordenAnnan översättning: \"landet\".","reference":{"chapter":45,"verse":17}}]},"thisChapterLink":"/api/swe_fol/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":18}