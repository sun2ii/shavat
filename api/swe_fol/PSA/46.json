{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":46,"content":[{"type":"heading","content":["Gud är vår borg"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En sång av Koras söner, till alamót","descriptive":true},{"noteId":133},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gud är vår tillflykt och styrka,","poem":1},{"text":"en hjälp i nöden, väl beprövad","poem":2},{"noteId":134},{"text":".","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Därför räds vi inte","poem":1},{"text":"även om jorden ger vika","poem":2},{"text":"och bergen störtar i havets djup,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"om vågorna brusar och svallar","poem":1},{"text":"så att bergen bävar","poem":2},{"text":"vid deras uppror. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"En ström går fram med flöden","poem":1},{"text":"som ger glädje åt Guds stad,","poem":2},{"text":"den Högstes heliga boning.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Gud bor där inne,","poem":1},{"text":"den vacklar inte.","poem":3},{"text":"Gud hjälper den","poem":2},{"text":"när morgonen gryr.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Folken larmar, riken vacklar,","poem":1},{"text":"han höjer sin röst –","poem":2},{"text":"då smälter jorden.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Herren Sebaot är med oss,","poem":1},{"text":"Jakobs Gud är vår borg. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kom och se Herrens verk,","poem":1},{"text":"häpnadsväckande saker","poem":2},{"noteId":135},{"text":"gör han på jorden.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Han stillar strider över hela jorden,","poem":1},{"text":"han bryter bågen","poem":2},{"text":"och bräcker spjutet,","poem":3},{"text":"bränner upp vagnarna","poem":2},{"noteId":136},{"text":"i eld.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"\"Bli stilla och besinna","poem":1},{"text":"att jag är Gud,","poem":3},{"text":"upphöjd bland folken,","poem":2},{"text":"upphöjd på jorden.\"","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Herren Sebaot är med oss,","poem":1},{"text":"Jakobs Gud är vår borg. Sela","poem":2}]}],"footnotes":[{"noteId":133,"caller":"-","text":"till alamótOrdagrant: \"till jungfrur\". Troligen en musikalisk term (sopranstämma) eller namnet på en melodi.","reference":{"chapter":46,"verse":1}},{"noteId":134,"caller":"-","text":"väl beprövadAnnan översättning: \"alltid nära\".","reference":{"chapter":46,"verse":2}},{"noteId":135,"caller":"-","text":"häpnadsväckande sakerAnnan översättning: \"ödeläggelser\".","reference":{"chapter":46,"verse":9}},{"noteId":136,"caller":"-","text":"vagnarnaAnnan översättning (så Septuaginta): \"sköldarna\".","reference":{"chapter":46,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":12}