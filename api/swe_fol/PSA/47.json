{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":47,"content":[{"type":"heading","content":["Gud är kung"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av Koras söner.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Klappa händer, alla folk,","poem":1},{"text":"ropa till Gud med jublande röst!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Herren, den Högste, är fruktad,","poem":1},{"text":"en stor kung över hela jorden.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Han lägger folk under oss,","poem":1},{"text":"folkslag under våra fötter.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Han utväljer åt oss vår arvedel,","poem":1},{"text":"hans älskade Jakobs stolthet. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gud har farit upp under jubel,","poem":1},{"text":"Herren under basuners ljud.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lovsjung Gud, lovsjung!","poem":1},{"text":"Lovsjung vår kung, lovsjung,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"för Gud är kung över hela jorden.","poem":1},{"text":"Lovsjung med vishet","poem":2},{"noteId":137},{"text":"!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Gud är kung över folken,","poem":1},{"text":"Gud sitter på sin heliga tron.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Folkens främsta samlas","poem":1},{"text":"som Abrahams Guds folk,","poem":3},{"text":"för jordens sköldar","poem":2},{"noteId":138},{"text":"tillhör Gud.","poem":2},{"text":"Högt är han upphöjd.","poem":3}]}],"footnotes":[{"noteId":137,"caller":"-","text":"vishetAnnan översättning: \"en vishetspsalm\" (hebr. maskíl, Ps 42, 44, 45, 52-55, 74, 78, 88, 143).","reference":{"chapter":47,"verse":8}},{"noteId":138,"caller":"-","text":"sköldarDvs ledare, beskyddare (jfr Ps 84:10).","reference":{"chapter":47,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}