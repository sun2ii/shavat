{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":48,"content":[{"type":"heading","content":["Kungens heliga stad"]},{"type":"verse","number":1,"content":[{"text":"En sång, en psalm av Koras söner.","descriptive":true},{"noteId":139}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Stor är Herren och högt lovad","poem":1},{"text":"i vår Guds stad,","poem":2},{"text":"på sitt heliga berg.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Skönt höjer det sig,","poem":1},{"text":"hela jordens fröjd,","poem":3},{"text":"Sions berg längst upp i norr","poem":2},{"noteId":140},{"text":",","poem":2},{"text":"den store kungens stad.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Gud bor i dess borgar,","poem":1},{"text":"känd som en tillflykt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Se, kungarna slog sig ihop,","poem":1},{"text":"de ryckte fram tillsammans.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"De såg, de häpnade,","poem":1},{"text":"förskräcktes och flydde.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"De greps där av bävan,","poem":1},{"text":"av vånda som en födande kvinna,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"som när östanvinden krossade","poem":1},{"text":"Tarshishskeppen","poem":2},{"noteId":141},{"text":".","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Det vi har hört om,","poem":1},{"text":"det fick vi se","poem":3},{"text":"i Herren Sebaots stad,","poem":2},{"text":"i vår Guds stad.","poem":3},{"text":"Gud bevarar den till evig tid. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Vi tänker, o Gud, på din nåd","poem":1},{"text":"här i ditt tempel.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Liksom ditt namn, o Gud,","poem":1},{"text":"når ditt lov till jordens ändar.","poem":3},{"text":"Din högra hand","poem":2},{"text":"är full av rättfärdighet.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Sions berg gläder sig,","poem":1},{"text":"Juda döttrar","poem":2},{"noteId":142},{"text":"jublar","poem":2},{"text":"över dina domar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Tåga runt Sion,","poem":1},{"text":"vandra omkring det,","poem":2},{"text":"räkna dess torn!","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Lägg märke till dess murar,","poem":1},{"text":"gå igenom dess borgar","poem":3},{"text":"så att ni kan berätta","poem":2},{"text":"för kommande släkten","poem":3}]},{"type":"verse","number":15,"content":[{"text":"att sådan är Gud, vår Gud,","poem":1},{"text":"alltid och för evigt.","poem":3},{"text":"Han ska leda oss bortom döden","poem":2},{"noteId":143},{"text":".","poem":2}]}],"footnotes":[{"noteId":139,"caller":"-","text":"sjöngs enligt Mishna varje måndag i templet av leviternas kör.","reference":{"chapter":48,"verse":1}},{"noteId":140,"caller":"-","text":"längst upp i norrPsalmisten skildrar Sion som Guds boning med en bild från den ugaritiska myten, där gudarnas boning är förlagd till det nordliga berget Safon (hebreiska för \"norr\").","reference":{"chapter":48,"verse":3}},{"noteId":141,"caller":"-","text":"TarshishskeppenHandelsflotta som förliste på Josafats tid (se 2 Krön 20:36f).","reference":{"chapter":48,"verse":8}},{"noteId":142,"caller":"-","text":"Juda döttrarTroligen Juda lands städer utanför moderstaden Jerusalem.","reference":{"chapter":48,"verse":12}},{"noteId":143,"caller":"-","text":"bortom dödenAnnan översättning (så Septuaginta): \"i evighet\".","reference":{"chapter":48,"verse":15}}]},"thisChapterLink":"/api/swe_fol/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}