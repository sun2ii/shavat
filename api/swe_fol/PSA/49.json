{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":49,"content":[{"type":"heading","content":["De rikas framgång är kort"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av Koras söner.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hör detta, alla folk!","poem":1},{"text":"Lyssna, alla som lever i världen,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"både låg och hög,","poem":1},{"text":"rik som fattig.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Min mun ska tala vishet,","poem":1},{"text":"mitt hjärtas tanke","poem":2},{"text":"ska vara förstånd.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Jag vänder mitt öra till visdomsord,","poem":1},{"text":"jag tyder min gåta","poem":2},{"text":"till harpans toner.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Varför vara rädd","poem":1},{"text":"under olyckans dagar","poem":3},{"text":"när mina förföljares","poem":2},{"noteId":144},{"text":"ondska","poem":2},{"text":"omger mig?","poem":3}]},{"type":"verse","number":7,"content":[{"text":"De litar till sina ägodelar","poem":1},{"text":"och stoltserar","poem":2},{"text":"med sin stora rikedom.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Men ingen kan köpa sin broder fri","poem":1},{"text":"eller ge Gud lösepenning","poem":2},{"text":"för honom.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Hans själs lösen är dyr,","poem":1},{"text":"den kan inte betalas till evig tid","poem":2}]},{"type":"verse","number":10,"content":[{"text":"så att han får leva för alltid","poem":1},{"text":"och aldrig se förgängelsen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nej, man ser att de visa dör,","poem":1},{"text":"att både dårar och oförnuftiga","poem":2},{"text":"går under","poem":3},{"text":"och lämnar sin rikedom åt andra.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"De tror att deras hus","poem":1},{"text":"ska bestå","poem":3},{"noteId":145},{"text":"för evigt,","poem":3},{"text":"deras boningar","poem":2},{"text":"från släkte till släkte.","poem":3},{"text":"De uppkallar sina marker","poem":2},{"text":"efter sina namn.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Men människan i all sin härlighet","poem":1},{"text":"har inte bestånd","poem":3},{"noteId":146},{"text":",","poem":3},{"text":"hon liknar djuren som förgås.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Så går det dem","poem":1},{"text":"som litar till sig själva","poem":3},{"noteId":147},{"text":"och deras efterföljare","poem":2},{"text":"som gillar deras ord. Sela","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Som får drivs de ner i dödsriket,","poem":1},{"text":"döden blir deras herde","poem":3},{"noteId":148},{"text":".","poem":3},{"text":"De rättfärdiga ska råda över dem","poem":2},{"text":"när morgonen gryr.","poem":3},{"text":"Deras gestalt tynar bort i dödsriket,","poem":2},{"text":"de får ingen upphöjd boning.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Men Gud ska friköpa min själ","poem":1},{"text":"från dödsrikets våld,","poem":3},{"text":"han ska ta emot mig. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Bli inte imponerad när någon blir rik,","poem":1},{"text":"när hans hus växer i härlighet,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"för han får inget med sig i döden,","poem":1},{"text":"hans härlighet följer inte","poem":2},{"text":"med honom ner.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Även om han skattar sig lycklig","poem":1},{"text":"under livet","poem":3},{"text":"och får beröm när han gör det gott","poem":2},{"text":"för sig själv,","poem":3}]},{"type":"verse","number":20,"content":[{"text":"så går hans själ till sina fäder,","poem":1},{"text":"till dem som aldrig mer ser ljuset.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"En människa som i all sin härlighet","poem":1},{"text":"inte har förstånd,","poem":3},{"text":"hon liknar djuren som förgås.","poem":2}]}],"footnotes":[{"noteId":144,"caller":"-","text":"förföljaresAnnan översättning: \"bedragares\".","reference":{"chapter":49,"verse":6}},{"noteId":145,"caller":"-","text":"De tror att deras hus ska beståAndra handskrifter (så Septuaginta): \"Deras gravar förblir deras hus\".","reference":{"chapter":49,"verse":12}},{"noteId":146,"caller":"-","text":"beståndAndra handskrifter (Septuaginta): \"förstånd\" (jfr vers 21).","reference":{"chapter":49,"verse":13}},{"noteId":147,"caller":"-","text":"litar till sig självaAnnan översättning: \"är dåraktiga\".","reference":{"chapter":49,"verse":14}},{"noteId":148,"caller":"-","text":"blir deras herdeAnnan översättning: \"förtär dem\".","reference":{"chapter":49,"verse":15}}]},"thisChapterLink":"/api/swe_fol/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":21}