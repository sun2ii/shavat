{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":5,"content":[{"type":"heading","content":["Morgonbön under förföljelse"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till flöjt. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hör mina ord, Herre,","poem":1},{"text":"tänk på mina suckar","poem":2},{"noteId":14},{"text":"!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lyssna när jag ropar,","poem":1},{"text":"min kung och min Gud!","poem":3},{"text":"Till dig går min bön.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Herre, om morgonen","poem":1},{"text":"hör du min röst,","poem":3},{"text":"om morgonen vänder jag mig","poem":2},{"text":"till dig och väntar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Du är inte en Gud","poem":1},{"text":"som älskar ondska,","poem":3},{"text":"den som är ond","poem":2},{"text":"får inte bo hos dig.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"De övermodiga består inte","poem":1},{"text":"inför dina ögon,","poem":3},{"text":"du hatar alla förbrytare.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Du förgör dem som ljuger,","poem":1},{"text":"Herren avskyr den som är","poem":2},{"text":"blodtörstig och falsk.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Men genom din stora nåd","poem":1},{"text":"får jag gå in i ditt hus,","poem":3},{"text":"jag får tillbe i vördnad för dig,","poem":2},{"text":"vänd mot ditt heliga tempel.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Herre, led mig i din rättfärdighet","poem":1},{"text":"för mina förföljares skull,","poem":3},{"text":"jämna din väg för mig.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Det finns ingen sanning","poem":1},{"text":"i deras mun.","poem":3},{"text":"Deras inre är fördärv,","poem":2},{"text":"deras strupe är en öppen grav","poem":3},{"text":"och sin tunga gör de hal.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Döm dem skyldiga, Gud,","poem":1},{"text":"låt deras planer bli deras fall!","poem":3},{"text":"Driv bort dem","poem":2},{"text":"för deras många brott,","poem":4},{"text":"eftersom de gör uppror mot dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Men alla som flyr till dig","poem":1},{"text":"ska få glädjas,","poem":2},{"text":"de ska jubla i evighet.","poem":3},{"text":"Du beskyddar dem,","poem":2},{"text":"de som älskar ditt namn","poem":3},{"text":"ska få fröjdas i dig,","poem":4}]},{"type":"verse","number":13,"content":[{"text":"för du, Herre,","poem":1},{"text":"välsignar den rättfärdige.","poem":3},{"text":"Du täcker honom med nåd","poem":2},{"text":"som en sköld.","poem":3}]}],"footnotes":[{"noteId":14,"caller":"-","text":"suckarAnnan översättning: \"tankar\".","reference":{"chapter":5,"verse":2}}]},"thisChapterLink":"/api/swe_fol/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}