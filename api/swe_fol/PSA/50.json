{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":50,"content":[{"type":"heading","content":["Herrens dom"]},{"type":"verse","number":1,"content":[{"text":"En psalm av Asaf.","descriptive":true},{"noteId":149},{"lineBreak":true},{"text":"Gud, Herren Gud, har talat.","poem":1},{"text":"Han kallar på jorden","poem":2},{"text":"från öster till väster.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Från Sion, skönhetens krona,","poem":1},{"text":"visar sig Gud i glans.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vår Gud kommer,","poem":1},{"text":"han tänker inte tiga.","poem":3},{"text":"Förtärande eld går framför honom,","poem":2},{"text":"kring honom rasar stormen.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Han kallar på himlen där ovan","poem":1},{"text":"och på jorden för att döma sitt folk:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"\"Samla till mig mina trogna","poem":1},{"text":"som sluter förbund med mig","poem":2},{"text":"genom offer.\"","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Och himlarna förkunnar","poem":1},{"text":"hans rättfärdighet,","poem":3},{"text":"att Gud är den som dömer. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"\"Hör, mitt folk, jag vill tala!","poem":1},{"text":"Israel, jag vill vittna mot dig:","poem":2},{"text":"Jag är Gud, din Gud.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Det är inte för dina slaktoffer","poem":1},{"text":"jag går till rätta med dig,","poem":3},{"text":"dina brännoffer är ständigt","poem":2},{"text":"inför mig.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Jag vill inte ta tjurar från ditt hus","poem":1},{"text":"eller bockar från dina fållor,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"för skogens alla djur är mina,","poem":1},{"text":"boskapen på de tusen bergen.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jag känner alla fåglar på bergen","poem":1},{"noteId":150},{"text":",","poem":1},{"text":"allt som rör sig på marken är mitt.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Om jag vore hungrig","poem":1},{"text":"skulle jag inte säga det till dig,","poem":3},{"text":"för världen är min","poem":2},{"text":"med allt vad den rymmer.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Skulle jag äta tjurars kött","poem":1},{"text":"eller dricka bockars blod?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nej, offra lovets offer till Gud,","poem":1},{"text":"uppfyll dina löften","poem":2},{"text":"till den Högste","poem":3}]},{"type":"verse","number":15,"content":[{"text":"och ropa till mig på nödens dag.","poem":1},{"text":"Jag ska rädda dig,","poem":2},{"text":"och du ska ära mig.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Men till den gudlöse säger Gud:","poem":1},{"text":"\"Hur kan du tala om mina stadgar","poem":2},{"text":"och ta mitt förbund i din mun,","poem":3}]},{"type":"verse","number":17,"content":[{"text":"du som hatar tillrättavisning","poem":1},{"text":"och kastar mina ord bakom dig?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ser du en tjuv","poem":1},{"text":"samtycker du med honom,","poem":3},{"text":"med äktenskapsbrytare","poem":2},{"text":"slår du följe.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Du sprider ondska med din mun","poem":1},{"text":"och spinner svek med din tunga.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Du sitter och förtalar din bror,","poem":1},{"text":"du smutskastar din mors son!","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sådant har du gjort","poem":1},{"text":"och jag har tigit,","poem":3},{"text":"då har du trott att jag är som du.","poem":2},{"text":"Men jag ska straffa dig","poem":3},{"text":"och låta dina ögon se det.","poem":4}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Tänk på detta,","poem":1},{"text":"ni som glömmer Gud,","poem":3},{"text":"så att jag inte sliter er i stycken","poem":2},{"text":"utan räddning:","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Den som offrar lovets offer ärar mig,","poem":1},{"text":"och den som ger akt på vägen","poem":2},{"noteId":151},{"text":"ska jag låta se Guds frälsning.\"","poem":3}]}],"footnotes":[{"noteId":149,"caller":"-","text":"AsafAnsvarade för lovsången i helgedomen under kung David (1 Krön 16:5f). Angiven som författare till Ps 50, 73-83.","reference":{"chapter":50,"verse":1}},{"noteId":150,"caller":"-","text":"på bergenAndra handskrifter (Septuaginta): \"i skyn\".","reference":{"chapter":50,"verse":11}},{"noteId":151,"caller":"-","text":"den som ger akt på vägenAndra handskrifter (så Septuaginta): \"detta är vägen, där\".","reference":{"chapter":50,"verse":23}}]},"thisChapterLink":"/api/swe_fol/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}