{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":51,"content":[{"type":"heading","content":["Bön om syndernas förlåtelse"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"när profeten Natan kom till honom efter att han gått in till Bat-Seba","descriptive":true},{"noteId":152},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gud, var mig nådig","poem":1},{"text":"efter din godhet,","poem":3},{"text":"utplåna mina överträdelser","poem":2},{"text":"efter din stora barmhärtighet.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Tvätta mig ren från min skuld,","poem":1},{"text":"rena mig från min synd,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"för jag känner mina överträdelser","poem":1},{"text":"och min synd är alltid inför mig.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mot dig, just mot dig, har jag syndat","poem":1},{"text":"och gjort det som är ont","poem":2},{"text":"i dina ögon.","poem":3},{"text":"Därför har du rätt när du talar,","poem":2},{"text":"du är ren när du dömer.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Ja, med skuld är jag född","poem":1},{"text":"och med synd blev jag till","poem":2},{"text":"i min moders liv.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Du älskar sanning i hjärtat,","poem":1},{"text":"lär mig då vishet i mitt innersta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Rena mig med isop","poem":1},{"noteId":153},{"text":"så att jag blir ren,","poem":3},{"text":"tvätta mig","poem":2},{"text":"så att jag blir vitare än snö.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Låt mig höra fröjd och glädje,","poem":1},{"text":"låt de ben du har krossat få jubla.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Vänd bort ditt ansikte","poem":1},{"text":"från mina synder,","poem":3},{"text":"utplåna all min skuld.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Skapa i mig, Gud, ett rent hjärta","poem":1},{"text":"och ge mig på nytt","poem":2},{"text":"en frimodig ande.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Förkasta mig inte från ditt ansikte","poem":1},{"text":"och ta inte din helige Ande","poem":2},{"text":"ifrån mig.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Låt mig åter få glädjas","poem":1},{"text":"över din frälsning","poem":3},{"text":"och håll mig uppe","poem":2},{"text":"med en villig","poem":3},{"noteId":154},{"text":"ande.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Jag ska lära överträdarna dina vägar","poem":1},{"text":"så att syndare omvänder sig","poem":2},{"text":"till dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Rädda mig från blodskuld,","poem":1},{"text":"Gud, du min frälsnings Gud,","poem":3},{"text":"så ska min tunga jubla","poem":2},{"text":"över din rättfärdighet.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Herre, öppna mina läppar,","poem":1},{"text":"så ska min mun förkunna ditt lov.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Slaktoffer gläder dig inte,","poem":1},{"text":"annars skulle jag ge dig det,","poem":3},{"text":"brännoffer vill du inte ha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Det offer Gud vill ha","poem":1},{"text":"är en förkrossad ande.","poem":3},{"text":"Ett förkrossat och bedrövat hjärta","poem":2},{"text":"föraktar du inte, Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Gör gott mot Sion i din nåd,","poem":1},{"text":"bygg upp Jerusalems murar.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Då ska du få glädjas åt rätta offer,","poem":1},{"text":"brännoffer och heloffer.","poem":3},{"text":"Då ska tjurar offras på ditt altare.","poem":2}]}],"footnotes":[{"noteId":152,"caller":"-","text":"efter att han gått in till Bat-Sebaoch begått äktenskapsbrott. Se 2 Sam 11-12.","reference":{"chapter":51,"verse":2}},{"noteId":153,"caller":"-","text":"isopLjungliknande växt som användes för reningsriter (t ex 4 Mos 19:18) och för påskalammets blod (2 Mos 12:22).","reference":{"chapter":51,"verse":9}},{"noteId":154,"caller":"-","text":"villigAnnan översättning: \"generös\" eller \"furstlig\" (så Septuaginta).","reference":{"chapter":51,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":21}