{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":52,"content":[{"type":"heading","content":["Tröst mot onda tungor"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En vishetspsalm av David,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"när edomiten Doeg kom","descriptive":true},{"noteId":155},{"text":"och berättade för Saul att David hade gått in i Ahimeleks hus.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Varför skryter du med det onda,","poem":1},{"text":"du mäktige man?","poem":3},{"text":"Guds nåd består för alltid.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Din tunga tänker ut fördärv,","poem":1},{"text":"den är som en vässad rakkniv.","poem":2},{"text":"Du begår svek.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Du älskar ont mer än gott,","poem":1},{"text":"lögn mer än att tala sanning. Sela","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Du älskar allt tal som skadar,","poem":1},{"text":"du falska tunga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Därför ska Gud","poem":1},{"text":"riva ner dig för alltid,","poem":3},{"text":"gripa dig och rycka dig","poem":2},{"text":"ur din hydda,","poem":3},{"text":"utrota dig ur de levandes land. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"De rättfärdiga ska se det och frukta,","poem":1},{"text":"de ska le åt honom:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"\"Där är en man som inte","poem":1},{"text":"gjorde Gud till sin borg!","poem":3},{"text":"Han litade till sin stora rikedom,","poem":2},{"text":"han sökte styrka","poem":3},{"text":"genom att roffa åt sig","poem":4},{"noteId":156},{"text":".\"","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Men jag är som ett grönskande","poem":1},{"text":"olivträd i Guds hus,","poem":3},{"text":"jag förtröstar på Guds nåd","poem":2},{"text":"i evigheters evighet.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Jag ska tacka dig i evighet","poem":1},{"text":"för det du har gjort.","poem":3},{"text":"Inför dina trogna","poem":2},{"text":"ska jag hoppas på ditt namn,","poem":3},{"text":"för det är gott.","poem":4}]}],"footnotes":[{"noteId":155,"caller":"-","text":"edomiten Doeg orsakade en massaker på prästerna i tabernaklet. Se 1 Sam 22:9f.","reference":{"chapter":52,"verse":2}},{"noteId":156,"caller":"-","text":"roffa åt sigAnnan översättning: \"fördärva\".","reference":{"chapter":52,"verse":9}}]},"thisChapterLink":"/api/swe_fol/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}