{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":54,"content":[{"type":"heading","content":["Räddning från fiender"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till stränginstrument. En vishetspsalm av David,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"när sifiterna kom","descriptive":true},{"noteId":160},{"text":"och sade till Saul: \"David håller sig gömd hos oss.\"","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gud, fräls mig genom ditt namn,","poem":1},{"text":"döm mig rättvist genom din makt!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gud, hör min bön,","poem":1},{"text":"lyssna till orden från min mun.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Främlingar reser sig mot mig,","poem":1},{"text":"våldsmän vill ta mitt liv.","poem":3},{"text":"De har inte Gud för ögonen. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Se, Gud är min hjälpare,","poem":1},{"text":"Herren stöder min själ.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Det onda ska slå tillbaka","poem":1},{"text":"mot mina förföljare.","poem":3},{"text":"Förgör dem i din trofasthet!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Villigt ska jag offra till dig,","poem":1},{"text":"jag ska prisa ditt namn, Herre,","poem":2},{"text":"för det är gott.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Ur all nöd räddar han mig.","poem":1},{"text":"Mitt öga får se mina fienders fall.","poem":2}]}],"footnotes":[{"noteId":160,"caller":"-","text":"när sifiterna komSe 1 Sam 23:19, 26:1.","reference":{"chapter":54,"verse":2}}]},"thisChapterLink":"/api/swe_fol/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}