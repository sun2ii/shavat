{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":55,"content":[{"type":"heading","content":["Förrådd av en falsk vän"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till stränginstrument. En vishetspsalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lyssna, Gud, till min bön,","poem":1},{"text":"göm dig inte när jag ber om nåd,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"hör på mig och svara mig!","poem":1},{"text":"Jag är rastlös av mitt bekymmer","poem":2},{"text":"och våndas","poem":3}]},{"type":"verse","number":4,"content":[{"text":"när fienden ropar","poem":1},{"text":"och den gudlöse skränar,","poem":3},{"text":"för de vräker ondska över mig","poem":2},{"text":"och jagar mig i vrede.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mitt hjärta grips av ångest","poem":1},{"text":"i mitt inre,","poem":3},{"text":"dödens fasor faller över mig.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Fruktan och bävan drabbar mig,","poem":1},{"text":"skräck lamslår mig","poem":2}]},{"type":"verse","number":7,"content":[{"text":"och jag säger:","poem":1},{"text":"Tänk om jag hade","poem":2},{"noteId":161},{"text":"vingar","poem":2},{"text":"som duvan!","poem":3},{"text":"Då skulle jag flyga bort","poem":2},{"text":"och söka mig ett bo,","poem":3}]},{"type":"verse","number":8,"content":[{"text":"ja, fly långt bort","poem":1},{"text":"och stanna i öknen. Sela","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jag skulle skynda mig","poem":1},{"text":"att söka skydd","poem":3},{"text":"mot vinande vind och storm.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Förvirra dem, Herre,","poem":1},{"text":"splittra deras tungor,","poem":3},{"text":"för jag ser våld och bråk i staden.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Dag och natt går de runt den","poem":1},{"text":"uppe på murarna,","poem":3},{"text":"ondska och olycka råder därinne.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Den är full av fördärv,","poem":1},{"text":"förtryck och svek viker inte","poem":2},{"text":"från dess torg.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Det är inte en fiende som hånar mig,","poem":1},{"text":"det kunde jag bära.","poem":3},{"text":"Det är inte min ovän","poem":2},{"text":"som förhäver sig mot mig,","poem":3},{"text":"för honom kunde jag","poem":2},{"text":"gömma mig.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Nej, det är du, min like,","poem":1},{"text":"min vän och förtrogne –","poem":2}]},{"type":"verse","number":15,"content":[{"text":"vi som levde i ljuvlig förtrolighet,","poem":1},{"text":"vi som gick till Guds hus","poem":2},{"text":"i högtidsskaran!","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Låt döden drabba dem,","poem":1},{"text":"låt dem gå levande ner","poem":2},{"text":"i dödsriket,","poem":3},{"text":"för ondskan råder i deras boning,","poem":2},{"text":"mitt ibland dem.","poem":3},{"noteId":162}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Men jag ropar till Gud,","poem":1},{"text":"och Herren ska frälsa mig.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Afton, morgon och middag","poem":1},{"text":"vill jag sucka och klaga,","poem":3},{"text":"och han ska höra min röst.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Han friköper min själ","poem":1},{"text":"och fredar mig","poem":3},{"text":"så att de inte kan närma sig","poem":2},{"noteId":163},{"text":",","poem":2},{"text":"för det är många","poem":3},{"text":"som är emot mig.","poem":4}]},{"type":"verse","number":20,"content":[{"text":"Gud ska höra mig","poem":1},{"text":"och förödmjuka dem,","poem":3},{"text":"han som från urminnes tid","poem":2},{"text":"sitter på sin tron. Sela","poem":3},{"text":"De ändrar sig inte,","poem":2},{"text":"de fruktar inte Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Han bär hand på sina vänner,","poem":1},{"text":"han kränker sitt förbund.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hans mun är halare än smör,","poem":1},{"text":"men han har strid i sitt hjärta.","poem":3},{"text":"Hans ord är lenare än olja,","poem":2},{"text":"men de är dragna svärd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kasta din börda på Herren,","poem":1},{"text":"han ska ta hand om dig.","poem":3},{"text":"Han låter aldrig","poem":2},{"text":"den rättfärdige vackla.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Du, Gud, ska störta dem ner","poem":1},{"text":"i fördärvets grop.","poem":3},{"text":"Blodtörstiga och bedragare","poem":2},{"text":"når inte ens halva sin ålder.","poem":3},{"text":"Men jag förtröstar på dig.","poem":2}]}],"footnotes":[{"noteId":161,"caller":"-","text":"Tänk om jag hadeAnnan översättning: \"Vem kan ge mig …?\".","reference":{"chapter":55,"verse":7}},{"noteId":162,"caller":"-","text":"i deras boning, mitt ibland demAnnan översättning: \"i deras hjärtan, inom dem\".","reference":{"chapter":55,"verse":16}},{"noteId":163,"caller":"-","text":"närma sigAnnan översättning: \"strida mot mig\".","reference":{"chapter":55,"verse":19}}]},"thisChapterLink":"/api/swe_fol/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":24}