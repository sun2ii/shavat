{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":56,"content":[{"type":"heading","content":["Förtröstan under förföljelse"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till \"Den stumma duvan i fjärran\". En sång av David, när filisteerna grep honom i Gat","descriptive":true},{"noteId":164},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Förbarma dig över mig, Gud,","poem":1},{"text":"för människor jagar min själ.","poem":3},{"text":"Ständigt angriper de","poem":2},{"text":"och tränger mig,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"ständigt jagar mina förföljare mig.","poem":1},{"text":"Många angriper mig i högmod.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"När fruktan fyller mig","poem":1},{"text":"litar jag på dig.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"På Gud, vars ord jag prisar,","poem":1},{"text":"på Gud litar jag","poem":2},{"text":"och fruktar inte.","poem":3},{"text":"Vad kan människor göra mig?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ständigt förvränger de mina ord,","poem":1},{"text":"alla deras tankar","poem":2},{"text":"går ut på att skada mig.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"De gaddar ihop sig,","poem":1},{"text":"de ligger på lur,","poem":3},{"text":"de vaktar på mina steg","poem":2},{"text":"och vill ta mitt liv.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Skulle de räddas i sin ondska?","poem":1},{"text":"Nej, slå ner folken","poem":2},{"text":"i din vrede, Gud!","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Du håller räkning","poem":1},{"text":"på min flykts dagar","poem":3},{"noteId":165},{"text":".","poem":3},{"text":"Samla mina tårar i ditt kärl","poem":2},{"noteId":166},{"text":",","poem":2},{"text":"för de står i din bok.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mina fiender ska vika tillbaka","poem":1},{"text":"när jag ropar till dig.","poem":3},{"text":"Detta vet jag,","poem":2},{"text":"för","poem":3},{"noteId":167},{"text":"Gud är med mig.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"På Gud, vars ord jag prisar,","poem":1},{"text":"på Herren, vars ord jag prisar,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"på Gud litar jag","poem":1},{"text":"och fruktar inte.","poem":3},{"text":"Vad kan människor göra mig?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jag har gett löften till dig, Gud,","poem":1},{"text":"och jag ska uppfylla dem","poem":2},{"text":"med tackoffer.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Du har räddat min själ från döden","poem":1},{"text":"och mina fötter från fall,","poem":3},{"text":"så att jag kan vandra inför Gud","poem":2},{"text":"i de levandes ljus.","poem":3}]}],"footnotes":[{"noteId":164,"caller":"-","text":"när filisteerna grep honom i GatSe 1 Sam 21:10f och Ps 34.","reference":{"chapter":56,"verse":1}},{"noteId":165,"caller":"-","text":"min flykts dagarAnnan översättning: \"mitt elände\".","reference":{"chapter":56,"verse":9}},{"noteId":166,"caller":"-","text":"kärlTäta skinnsäckar var behållare för vätskor, t ex vin (Matt 9:17) eller mjölk (Dom 4:19).","reference":{"chapter":56,"verse":9}},{"noteId":167,"caller":"-","text":"förAnnan översättning: \"att\".","reference":{"chapter":56,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":14}