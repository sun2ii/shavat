{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":57,"content":[{"type":"heading","content":["Bön och lovsång i nöden"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, \"Fördärva inte","descriptive":true},{"noteId":168},{"text":"\". En sång av David när han hade flytt undan Saul och var i grottan","descriptive":true},{"noteId":169},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Förbarma dig, Gud,","poem":1},{"text":"förbarma dig över mig!","poem":3},{"text":"Till dig flyr min själ,","poem":2},{"text":"i dina vingars skugga","poem":3},{"text":"tar jag min tillflykt","poem":2},{"text":"tills faran är över.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Jag ropar till Gud, den Högste,","poem":1},{"text":"till Gud, som fullbordar","poem":2},{"text":"sitt verk för mig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Han sänder sin hjälp från himlen","poem":1},{"text":"och frälser mig","poem":3},{"text":"när mina förföljare hånar mig.","poem":2},{"noteId":170},{"text":"Sela","poem":4},{"text":"Gud sänder sin nåd","poem":2},{"text":"och sin sanning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Min själ är omgiven av lejon,","poem":1},{"text":"jag ligger bland människoätare","poem":3},{"text":"med tänder","poem":2},{"noteId":171},{"text":"som spjut och pilar","poem":2},{"text":"och tungor som skarpa svärd.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Visa din höghet över himlen, Gud,","poem":1},{"text":"och din härlighet över hela jorden!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"De lägger nät för mina fötter,","poem":1},{"text":"min själ är nerböjd.","poem":3},{"text":"De gräver en grop för mig,","poem":2},{"text":"men de faller själva däri.","poem":3},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mitt hjärta är frimodigt, Gud,","poem":1},{"noteId":172},{"text":"mitt hjärta är frimodigt.","poem":3},{"noteId":173},{"text":"Jag vill sjunga och spela.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vakna, min ära","poem":1},{"noteId":174},{"text":",","poem":1},{"text":"vakna, lyra och harpa!","poem":3},{"text":"Jag vill väcka morgonrodnaden.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jag vill tacka dig bland folken,","poem":1},{"text":"Herre,","poem":3},{"text":"lovsjunga dig bland folkslagen,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"för din nåd är stor","poem":1},{"text":"och når till himlen,","poem":3},{"text":"din sanning ända till skyarna.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Visa din höghet över himlen, Gud,","poem":1},{"text":"och din härlighet över hela jorden!","poem":2}]}],"footnotes":[{"noteId":168,"caller":"-","text":"\"Fördärva inte\"Troligen namn på en melodi (även i Ps 58, 59, 75).","reference":{"chapter":57,"verse":1}},{"noteId":169,"caller":"-","text":"när han hade flytt undan Saul och var i grottanSe 1 Sam 22:1 och Ps 142.","reference":{"chapter":57,"verse":1}},{"noteId":170,"caller":"-","text":"när mina förföljare hånar migAnnan översättning (så Septuaginta): \"och vanärar mina förföljare\".","reference":{"chapter":57,"verse":4}},{"noteId":171,"caller":"-","text":"människoätare med tänderAnnan översättning: \"eldsprutare, människor med tänder\".","reference":{"chapter":57,"verse":5}},{"noteId":172,"caller":"-","text":"Stycket i vers 8-12 är närmast identiskt med Ps 108:2-6. De kan ha bevarats i två separata samlingar (42-72, 107-150) som sedan sammanförts.","reference":{"chapter":57,"verse":8}},{"noteId":173,"caller":"-","text":"frimodigtAnnan översättning: \"redo\".","reference":{"chapter":57,"verse":8}},{"noteId":174,"caller":"-","text":"min äraOfta uppfattat som liktydigt med \"min själ\". Kan också syfta på Herren själv som den troendes ära.","reference":{"chapter":57,"verse":9}}]},"thisChapterLink":"/api/swe_fol/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}