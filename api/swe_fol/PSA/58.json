{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":58,"content":[{"type":"heading","content":["Dom över de gudlösa"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, \"Fördärva inte\". En sång av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"För ni verkligen rättfärdighetens","poem":1},{"text":"talan när ni tiger","poem":3},{"noteId":175},{"text":"?","poem":3},{"text":"Dömer ni rätta domar,","poem":2},{"text":"ni människors barn?","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Nej, i hjärtat gör ni onda planer,","poem":1},{"text":"era händer banar väg","poem":2},{"text":"för våld i landet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"De gudlösa är avfälliga","poem":1},{"text":"från födseln,","poem":3},{"text":"lögnarna far vilse","poem":2},{"text":"ända från moderlivet.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"De har gift som ormens gift,","poem":1},{"text":"de liknar en döv huggorm","poem":2},{"text":"som stänger sitt öra","poem":3}]},{"type":"verse","number":6,"content":[{"text":"och inte hör ormtjusaren,","poem":1},{"text":"den skicklige besvärjaren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Gud, krossa tänderna i deras mun,","poem":1},{"text":"bryt de unga lejonens käkar,","poem":2},{"text":"Herre!","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Låt dem försvinna","poem":1},{"text":"likt vatten som rinner bort.","poem":3},{"text":"När han spänner bågen,","poem":2},{"text":"låt pilen vara utan udd.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Som snigeln smälter bort i slem","poem":1},{"text":"ska han försvinna,","poem":3},{"text":"som en kvinnas dödfödda foster","poem":2},{"text":"som aldrig fick se solen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Innan era grytor","poem":1},{"text":"känner hettan från törnet,","poem":3},{"text":"vare sig det är färskt","poem":2},{"text":"eller brinner,","poem":3},{"text":"ska han svepa bort det","poem":2},{"text":"med en stormvind.","poem":3},{"noteId":176}]},{"type":"verse","number":11,"content":[{"text":"Den rättfärdige ska glädja sig","poem":1},{"text":"när han ser hämnden,","poem":3},{"text":"han ska tvätta sina fötter","poem":2},{"text":"i den gudlöses blod,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"och människor ska säga:","poem":1},{"text":"\"Den rättfärdige får sin lön.","poem":3},{"text":"Det finns en Gud","poem":2},{"text":"som dömer på jorden.\"","poem":3}]}],"footnotes":[{"noteId":175,"caller":"-","text":"när ni tigerAnnan översättning: \"ni mäktiga\", \"ni gudar\".","reference":{"chapter":58,"verse":2}},{"noteId":176,"caller":"-","text":"Grundtextens innebörd är i denna vers oklar.","reference":{"chapter":58,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}