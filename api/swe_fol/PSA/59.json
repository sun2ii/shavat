{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":59,"content":[{"type":"heading","content":["Bön mot fienders försåt"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, \"Fördärva inte\". En sång av David när Saul sände män för att bevaka huset och döda honom","descriptive":true},{"noteId":177},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Rädda mig, min Gud,","poem":1},{"text":"från mina fiender,","poem":3},{"text":"beskydda mig","poem":2},{"text":"från mina motståndare!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Rädda mig från förbrytarna,","poem":1},{"text":"fräls mig från de blodtörstiga!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Se hur de lurar på min själ,","poem":1},{"text":"mäktiga män gaddar ihop sig","poem":2},{"text":"mot mig","poem":3},{"text":"utan att jag har begått","poem":2},{"text":"brott eller synd, Herre.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Jag är utan skuld,","poem":1},{"text":"men de rusar fram","poem":2},{"text":"och gör sig redo.","poem":3},{"text":"Vakna, kom till mig och se!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Herre Gud Sebaot, du Israels Gud,","poem":1},{"text":"vakna och ställ alla folk till svars,","poem":2},{"text":"skona inga trolösa förrädare!","poem":3},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"De kommer tillbaka mot kvällen,","poem":1},{"text":"de morrar som hundar","poem":2},{"text":"och stryker runt i staden.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Se vad de spyr ut med sina munnar.","poem":1},{"text":"De har svärd på sina läppar","poem":2},{"text":"och tänker: \"Vem hör oss?\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Men du, Herre, ler åt dem.","poem":1},{"text":"Du gör narr av alla hedningar.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Du min styrka,","poem":1},{"text":"jag vill hålla mig till dig,","poem":3},{"text":"för du, Gud, är min borg.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Min Gud möter mig med sin nåd,","poem":1},{"text":"Gud låter mig se","poem":2},{"text":"mina förföljares fall.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Döda dem inte,","poem":1},{"text":"då kan mitt folk glömma det.","poem":3},{"text":"Skingra dem med din kraft,","poem":2},{"text":"störta dem, Herre,","poem":3},{"text":"du vår sköld!","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Varje ord på deras läppar","poem":1},{"text":"är en synd i deras mun.","poem":3},{"text":"Låt dem fångas i sitt högmod","poem":2},{"text":"av den förbannelse och lögn","poem":3},{"text":"som de talar.","poem":4}]},{"type":"verse","number":14,"content":[{"text":"Förgör dem i vrede,","poem":1},{"text":"förgör dem så att de inte","poem":2},{"text":"finns mer!","poem":3},{"text":"Låt dem veta att Gud härskar","poem":2},{"text":"i Jakob och till jordens","poem":3},{"text":"yttersta ändar. Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"De kommer tillbaka mot kvällen,","poem":1},{"text":"de morrar som hundar","poem":2},{"text":"och stryker runt i staden.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"De strövar omkring efter föda,","poem":1},{"text":"blir de inte mätta så gnyr de","poem":2},{"noteId":178},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Men jag ska sjunga om din makt","poem":1},{"text":"och jubla var morgon","poem":2},{"text":"över din nåd,","poem":3},{"text":"för du är en borg för mig,","poem":2},{"text":"en tillflykt när jag är i nöd.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Du min styrka,","poem":1},{"text":"jag vill lovsjunga dig,","poem":3},{"text":"för Gud är min borg,","poem":2},{"text":"min nådige Gud.","poem":3}]}],"footnotes":[{"noteId":177,"caller":"-","text":"när Saul sände män för att bevaka huset och döda honomSe 1 Sam 19:11f.","reference":{"chapter":59,"verse":1}},{"noteId":178,"caller":"-","text":"gnyr deAnnan översättning: \"stannar de över natten\".","reference":{"chapter":59,"verse":16}}]},"thisChapterLink":"/api/swe_fol/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":18}