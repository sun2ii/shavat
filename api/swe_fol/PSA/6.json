{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":6,"content":[{"type":"heading","content":["Bön och bönesvar i djup nöd"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, med stränginstrument till sheminít.","descriptive":true},{"noteId":15},{"text":"En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, straffa mig inte","poem":1},{"text":"i din vrede,","poem":3},{"text":"tukta mig inte i din glöd!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Förbarma dig över mig, Herre,","poem":1},{"text":"för jag är kraftlös.","poem":3},{"text":"Hela mig, Herre,","poem":2},{"text":"för jag är förskräckt","poem":3},{"text":"i mitt innersta,","poem":4}]},{"type":"verse","number":4,"content":[{"text":"min själ är skräckslagen.","poem":1},{"text":"Herre, hur länge?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kom tillbaka, Herre,","poem":1},{"text":"rädda min själ,","poem":2},{"text":"fräls mig för din nåds skull!","poem":3}]},{"type":"verse","number":6,"content":[{"text":"I döden tänker ingen på dig.","poem":1},{"text":"Vem tackar dig i dödsriket?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Jag är så trött av mitt suckande.","poem":1},{"text":"Varje natt fuktar jag min bädd,","poem":2},{"text":"jag dränker min säng","poem":3},{"text":"med mina tårar.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Mina ögon är mörka av sorg,","poem":1},{"text":"de har åldrats av alla mina fiender.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bort från mig, alla förbrytare,","poem":1},{"text":"för Herren har hört","poem":2},{"text":"min högljudda gråt.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Herren har hört mitt rop om nåd,","poem":1},{"text":"Herren har tagit emot min bön.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Alla mina fiender ska skämmas","poem":1},{"text":"och bli skräckslagna,","poem":3},{"text":"plötsligt ska de vika tillbaka","poem":2},{"text":"med skam.","poem":3}]}],"footnotes":[{"noteId":15,"caller":"-","text":"sheminítMusikalisk term, ordagrant \"den åttonde\". Antingen en åttasträngad lyra eller en lägre basoktav (i 1 Krön 15:20-21 kontrasterat mot alamót, ev sopran).","reference":{"chapter":6,"verse":1}}]},"thisChapterLink":"/api/swe_fol/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}