{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":60,"content":[{"type":"heading","content":["Bön om räddning"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till \"Vittnesbördets lilja\", en sång till lärdom. Av David,","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"när han var i strid med Aram-Naharajim och Aram-Soba","descriptive":true},{"noteId":179},{"text":"och Joab kom tillbaka och slog edomiterna i Saltdalen, tolv tusen man.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Gud, du har förkastat oss","poem":1},{"text":"och krossat oss,","poem":3},{"text":"du har varit vred –","poem":2},{"text":"upprätta oss igen!","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Du lät landet bäva och rämna.","poem":1},{"text":"Läk nu dess sprickor,","poem":2},{"text":"för det vacklar.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Du lät ditt folk möta hårda ting,","poem":1},{"text":"du gav oss vin så att vi raglar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Men åt dem som vördar dig","poem":1},{"text":"gav du ett baner","poem":3},{"text":"att lyfta för sanningens skull","poem":2},{"noteId":180},{"text":". Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Fräls med din högra hand","poem":1},{"text":"och svara oss","poem":3},{"noteId":181},{"text":",","poem":3},{"text":"så att dina älskade blir räddade.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gud har talat i sin helgedom","poem":1},{"noteId":182},{"text":":","poem":1},{"text":"\"I triumf ska jag dela upp Shekem","poem":2},{"text":"och mäta upp Suckots dal.","poem":3},{"noteId":183}]},{"type":"verse","number":9,"content":[{"text":"Gilead är mitt, Manasse är mitt,","poem":1},{"text":"Efraim är min hjälm","poem":2},{"text":"och Juda min spira.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Moab är mitt tvättfat,","poem":1},{"text":"på Edom kastar jag min sko","poem":3},{"noteId":184},{"text":".","poem":3},{"text":"Ropa av fröjd över mig, filisteer","poem":2},{"noteId":185},{"text":"!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vem för mig","poem":1},{"text":"till den befästa staden,","poem":3},{"text":"vem leder mig till Edom?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Är det inte du, Gud –","poem":1},{"text":"du som har förkastat oss","poem":3},{"text":"och inte drar ut","poem":2},{"text":"med våra härar, Gud?","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Ge oss hjälp mot fienden,","poem":1},{"text":"människors hjälp är meningslös.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Med Gud ska vi göra storverk.","poem":1},{"text":"Han ska trampa ner våra fiender.","poem":2}]}],"footnotes":[{"noteId":179,"caller":"-","text":"Aram-Naharajim och Aram-SobaOmråden i östra Syrien. Se 2 Sam 8:3f, 1 Krön 18:3f.","reference":{"chapter":60,"verse":2}},{"noteId":180,"caller":"-","text":"för sanningens skullAnnan översättning: \"till skydd från pilbågen\".","reference":{"chapter":60,"verse":6}},{"noteId":181,"caller":"-","text":"ossAndra handskrifter (så Septuaginta): \"mig\" (jfr 108:7).","reference":{"chapter":60,"verse":7}},{"noteId":182,"caller":"-","text":"helgedomAnnan översättning: \"helighet\".","reference":{"chapter":60,"verse":8}},{"noteId":183,"caller":"-","text":"Stycket 60:7-14 är närmast identiskt med Ps 108:7-14. De kan ha bevarats i två separata samlingar (42-72, 107-150) som sedan sammanförts.","reference":{"chapter":60,"verse":8}},{"noteId":184,"caller":"-","text":"kastar jag min skoSymboliserar att området är erövrat.","reference":{"chapter":60,"verse":10}},{"noteId":185,"caller":"-","text":"Ropa av fröjd över mig, filisteerAndra handskrifter: \"Över filisteerna ropar jag i triumf\" (jfr Ps 108:10).","reference":{"chapter":60,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":14}