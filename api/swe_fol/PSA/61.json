{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":61,"content":[{"type":"heading","content":["Kungens bön om välsignelse"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till stränginstrument. Av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gud, hör mitt rop,","poem":1},{"text":"lyssna till min bön!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Från jordens ände ropar jag till dig","poem":1},{"text":"när mitt hjärta mattas.","poem":3},{"text":"För mig upp på klippan","poem":2},{"text":"som är högre än jag,","poem":3}]},{"type":"verse","number":4,"content":[{"text":"för du har varit min tillflykt,","poem":1},{"text":"ett starkt torn mot fienden.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Låt mig bo i ditt tält för evigt","poem":1},{"text":"och ha min tillflykt","poem":2},{"text":"under dina vingar. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Du, Gud, har hört mina löften,","poem":1},{"text":"du har gett mig en arvedel","poem":2},{"text":"bland dem som","poem":3},{"noteId":186},{"text":"vördar ditt namn.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Du förökar kungens dagar,","poem":1},{"text":"hans år ska vara","poem":2},{"text":"från släkte till släkte,","poem":3}]},{"type":"verse","number":8,"content":[{"text":"han ska trona för evigt inför Gud.","poem":1},{"text":"Låt nåd och sanning","poem":2},{"text":"bevara honom.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Då ska jag alltid lovsjunga ditt namn","poem":1},{"text":"och uppfylla mina löften","poem":2},{"text":"dag efter dag.","poem":3}]}],"footnotes":[{"noteId":186,"caller":"-","text":"gett mig en arvedel bland dem somAnnan översättning (så Septuaginta): \"gett dem en arvedel som\".","reference":{"chapter":61,"verse":6}}]},"thisChapterLink":"/api/swe_fol/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}