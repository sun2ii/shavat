{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":62,"content":[{"type":"heading","content":["En tröstepsalm"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till Jedutun. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bara hos Gud har min själ sin ro,","poem":1},{"text":"från honom kommer min frälsning.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bara han är min klippa","poem":1},{"text":"och min frälsning, min borg.","poem":3},{"text":"Jag ska inte vackla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hur länge ska ni storma","poem":1},{"text":"mot en enda man,","poem":3},{"text":"tillsammans slå ner honom","poem":2},{"text":"som en lutande vägg,","poem":3},{"text":"en fallfärdig mur?","poem":4}]},{"type":"verse","number":5,"content":[{"text":"De rådslår om att störta honom","poem":1},{"text":"från hans höjd.","poem":3},{"text":"De älskar lögn,","poem":2},{"text":"de välsignar med sin mun","poem":3},{"text":"men förbannar i sitt hjärta. Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bara hos Gud har du din ro,","poem":1},{"text":"min själ,","poem":3},{"text":"från honom kommer mitt hopp.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bara han är min klippa","poem":1},{"text":"och min frälsning, min borg.","poem":3},{"text":"Jag ska inte vackla.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hos Gud är min frälsning","poem":1},{"text":"och min ära,","poem":3},{"text":"i Gud är min starka klippa,","poem":2},{"text":"min tillflykt.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Lita alltid på honom, du folk,","poem":1},{"text":"utgjut era hjärtan för honom.","poem":2},{"text":"Gud är vår tillflykt. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Människors barn","poem":1},{"text":"är bara en vindpust,","poem":2},{"text":"myndiga herrar sviker.","poem":3},{"text":"I vågskålen är de för lätta,","poem":2},{"text":"tillsammans väger de","poem":3},{"text":"mindre än luft.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"Lita inte till våld,","poem":1},{"text":"hoppas inte på stulet gods.","poem":3},{"text":"Fäst inte hjärtat vid rikedom,","poem":2},{"text":"även om den växer.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ett har Gud talat,","poem":1},{"text":"två ting","poem":3},{"noteId":187},{"text":"har jag hört:","poem":3},{"text":"Hos Gud finns makten,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"och hos dig, Herre, finns nåd.","poem":1},{"text":"Du ska löna var och en","poem":2},{"text":"efter hans gärningar.","poem":3}]}],"footnotes":[{"noteId":187,"caller":"-","text":"Ett … två tingAnnan översättning: \"En gång … två gånger\".","reference":{"chapter":62,"verse":12}}]},"thisChapterLink":"/api/swe_fol/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}