{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":64,"content":[{"type":"heading","content":["Beskydd mot onda planer"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gud, hör min röst när jag klagar,","poem":1},{"text":"skydda mitt liv från fiendens hot!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Göm mig från de ondas","poem":1},{"text":"hemliga planer","poem":3},{"noteId":194},{"text":",","poem":3},{"text":"från förbrytarnas hetsiga hop.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"De gör sina tungor","poem":1},{"text":"skarpa som svärd,","poem":3},{"text":"de laddar med bittra ord","poem":2},{"text":"som pilar","poem":3}]},{"type":"verse","number":5,"content":[{"text":"för att skjuta den oskyldige","poem":1},{"text":"ur bakhåll.","poem":3},{"text":"Plötsligt skjuter de honom","poem":2},{"text":"utan fruktan.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"De uppmuntrar varandra","poem":1},{"text":"i sitt onda uppsåt","poem":3},{"noteId":195},{"text":",","poem":3},{"text":"de talar om att lägga snaror,","poem":2},{"text":"de säger: \"Vem skulle se oss?\"","poem":3}]},{"type":"verse","number":7,"content":[{"text":"De smider onda planer:","poem":1},{"text":"\"Nu har vi en färdig plan!\"","poem":3},{"text":"Människans tankar och hjärta","poem":2},{"text":"är djupa.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Då skjuter Gud dem,","poem":1},{"text":"en plötslig pil","poem":2},{"text":"och de är sårade.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Deras egna tungor får dem på fall,","poem":1},{"text":"alla som ser dem","poem":2},{"text":"skakar på huvudet.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Alla människor grips av skräck,","poem":1},{"text":"de förkunnar","poem":2},{"text":"vad Gud har gjort","poem":3},{"text":"och förstår att det är hans verk.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Den rättfärdige gläder sig i Herren","poem":1},{"text":"och flyr till honom,","poem":3},{"text":"och alla som har ärliga hjärtan","poem":2},{"text":"skattar sig lyckliga.","poem":3}]}],"footnotes":[{"noteId":194,"caller":"-","text":"hemliga planerAnnan översättning: \"följe\".","reference":{"chapter":64,"verse":3}},{"noteId":195,"caller":"-","text":"i sitt onda uppsåtAnnan översättning: \"med onda ord\".","reference":{"chapter":64,"verse":6}}]},"thisChapterLink":"/api/swe_fol/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}