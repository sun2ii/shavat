{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":66,"content":[{"type":"heading","content":["Tacksamhet och lovsång"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En sång, en psalm.","descriptive":true},{"lineBreak":true},{"text":"Ropa till Gud, hela jorden!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Lovsjung hans namns ära,","poem":2},{"text":"ge honom ära och pris!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Säg till Gud:","poem":1},{"text":"Hur förunderliga","poem":2},{"text":"är inte dina gärningar!","poem":3},{"text":"Dina fiender kryper för dig,","poem":2},{"text":"för din stora makt.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Hela jorden ska tillbe dig","poem":1},{"text":"och lovsjunga dig,","poem":3},{"text":"de ska lovsjunga ditt namn.","poem":2},{"text":"Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kom och se vad Gud har gjort,","poem":1},{"text":"förunderliga gärningar","poem":2},{"text":"bland människors barn.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Han förvandlade havet","poem":1},{"text":"till torr mark,","poem":3},{"text":"de gick till fots genom floden.","poem":2},{"noteId":202},{"text":"Där gladdes vi över honom.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"I sin makt härskar han för evigt,","poem":1},{"text":"hans ögon vakar över folken.","poem":3},{"text":"De upproriska får inte resa sig.","poem":2},{"text":"Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Prisa vår Gud, ni folk,","poem":1},{"text":"låt hans lov ljuda högt,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"för han gav liv åt vår själ","poem":1},{"text":"och lät inte vår fot vackla.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Du prövade oss, Gud,","poem":1},{"text":"du luttrade oss","poem":2},{"text":"som man luttrar silver.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Du lät oss fastna i nätet,","poem":1},{"text":"du lade tunga bördor på vår rygg.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Du lät människor fara fram","poem":1},{"text":"över vårt huvud,","poem":3},{"text":"vi gick genom eld och vatten.","poem":2},{"text":"Men du förde oss ut till överflöd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Jag kommer till ditt hus","poem":1},{"text":"med brännoffer,","poem":3},{"text":"jag vill uppfylla mina löften till dig,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"det som mina läppar utbrast","poem":1},{"text":"och min mun sade","poem":2},{"text":"när jag var i nöd.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Jag vill bära fram feta brännoffer","poem":1},{"text":"och rök av baggar till dig,","poem":3},{"text":"jag vill offra både tjurar och bockar.","poem":2},{"text":"Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kom och hör,","poem":1},{"text":"alla ni som vördar Gud!","poem":3},{"text":"Jag ska berätta","poem":2},{"text":"vad han gjort för min själ.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Jag ropade till honom med min mun","poem":1},{"text":"och hade lovsång på min tunga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hade jag haft ondska i mitt hjärta,","poem":1},{"text":"hade Herren inte hört mig.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Men Gud har verkligen hört,","poem":1},{"text":"han har lyssnat till min bön.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lovad är Gud,","poem":1},{"text":"som inte har avvisat min bön","poem":2},{"text":"eller tagit sin nåd ifrån mig!","poem":3}]}],"footnotes":[{"noteId":202,"caller":"-","text":"havet … flodenDe två vattenundren vid Röda havet (2 Mos 14) och Jordanfloden (Jos 3).","reference":{"chapter":66,"verse":6}}]},"thisChapterLink":"/api/swe_fol/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}