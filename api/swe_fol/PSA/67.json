{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":67,"content":[{"type":"heading","content":["Önskan om Guds välsignelse"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, med stränginstrument. En psalm, en sång.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Må Gud vara nådig mot oss","poem":1},{"text":"och välsigna oss,","poem":3},{"text":"må han låta sitt ansikte","poem":2},{"text":"lysa över oss. Sela","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Då ska din väg bli känd på jorden,","poem":1},{"text":"din frälsning bland alla hednafolk.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Folken ska tacka dig, Gud,","poem":1},{"text":"alla folk ska tacka dig.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Folkslagen ska glädjas och jubla,","poem":1},{"text":"för du dömer folken rätt","poem":2},{"text":"och leder folkslagen på jorden.","poem":3},{"text":"Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Folken ska tacka dig, Gud,","poem":1},{"text":"alla folk ska tacka dig.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jorden ger sin gröda","poem":1},{"text":"och Gud, vår Gud, välsignar oss.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Må Gud välsigna oss,","poem":1},{"text":"och må jordens alla ändar","poem":2},{"text":"vörda honom.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":8}