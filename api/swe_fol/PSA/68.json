{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":68,"content":[{"type":"heading","content":["Guds makt i dom och frälsning"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm, en sång av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gud reser sig,","poem":1},{"text":"hans fiender skingras,","poem":3},{"text":"de som hatar honom","poem":2},{"text":"flyr för hans ansikte.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Som rök driver bort","poem":1},{"text":"fördriver du dem,","poem":3},{"text":"som vax smälter för eld","poem":2},{"text":"förgås de gudlösa inför Gud.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Men de rättfärdiga gläder sig,","poem":1},{"text":"de jublar inför Gud","poem":2},{"text":"och fröjdas av glädje.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sjung till Gud,","poem":1},{"text":"lovsjung hans namn,","poem":3},{"text":"bana väg för honom","poem":2},{"text":"som drar fram genom öknarna","poem":3},{"noteId":203},{"text":"!","poem":3},{"text":"Herren är hans namn,","poem":2},{"text":"jubla inför honom,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"de faderlösas fader","poem":1},{"text":"och änkornas försvarare,","poem":3},{"text":"Gud i sin heliga boning.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gud ger de ensamma ett hem","poem":1},{"text":"och de fångna frihet och lycka.","poem":3},{"text":"Men de upproriska bor i en öken.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Gud, när du drog ut","poem":1},{"text":"i spetsen för ditt folk,","poem":3},{"text":"när du gick fram i ödemarken,","poem":2},{"text":"Sela","poem":3}]},{"type":"verse","number":9,"content":[{"text":"då bävade jorden,","poem":1},{"text":"då strömmade regn","poem":2},{"text":"från himlen inför Gud,","poem":3},{"text":"själva Sinai bävade inför Gud,","poem":2},{"text":"Israels Gud.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Rikligt regn lät du falla, Gud,","poem":1},{"text":"din trötta egendom gav du kraft.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Din skara fick bo där,","poem":1},{"text":"du sörjde för de svaga","poem":2},{"text":"i din godhet, Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Herren låter ordet höras,","poem":1},{"text":"en här av kvinnor bär glädjebudet:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"\"Härarnas kungar flyr,","poem":1},{"text":"de flyr och husmodern delar bytet!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ska ni då ligga stilla i era fållor?","poem":1},{"text":"Duvans vingar","poem":2},{"noteId":204},{"text":"är täckta med silver","poem":2},{"text":"och hennes fjädrar","poem":3},{"text":"med skimrande guld.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"När den Allsmäktige","poem":1},{"text":"skingrade kungarna i landet,","poem":3},{"text":"föll snön över Salmon","poem":2},{"noteId":205},{"text":".\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bashans berg","poem":1},{"noteId":206},{"text":"är ett Guds berg,","poem":1},{"text":"ett berg med höga toppar","poem":2},{"text":"är Bashans berg.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Ni höga berg,","poem":1},{"text":"varför ser ni ner på berget","poem":2},{"text":"som Gud har valt till sin boning?","poem":3},{"text":"Herren ska bo där för alltid.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Guds vagnar är tiotusentals,","poem":1},{"text":"tusen och åter tusen.","poem":3},{"text":"Herren är mitt ibland dem,","poem":2},{"text":"i helighet som på Sinai.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Du steg upp i höjden,","poem":1},{"text":"du tog fångar,","poem":3},{"text":"du fick gåvor bland människorna,","poem":2},{"text":"även de upproriska –","poem":3},{"text":"för att du, Herre vår Gud,","poem":2},{"text":"skulle bo där.","poem":3},{"noteId":207}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lovad är Herren!","poem":1},{"text":"Dag efter dag bär han oss,","poem":2},{"text":"Gud är vår frälsning. Sela","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Gud är för oss en frälsningens Gud,","poem":1},{"text":"hos Herren Gud","poem":2},{"noteId":208},{"text":"finns en utväg från döden.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Ja, Gud krossar","poem":1},{"text":"sina fienders huvuden,","poem":3},{"text":"den håriga hjässan hos den","poem":2},{"text":"som framhärdar i synd.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Herren säger:","poem":1},{"text":"\"Jag ska hämta dem från Bashan,","poem":2},{"text":"hämta dem från havets djup,","poem":3}]},{"type":"verse","number":24,"content":[{"text":"så att du får doppa din fot i blod","poem":1},{"text":"och dina hundars tunga","poem":2},{"text":"får sin del av fienderna.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Gud, man ser ditt högtidståg,","poem":1},{"text":"min Guds, min kungs tåg","poem":2},{"text":"i helgedomen.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Sångare går främst,","poem":1},{"text":"harpspelare följer efter","poem":3},{"text":"bland jungfrur som slår på","poem":2},{"text":"tamburin.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Lova Gud i församlingarna,","poem":1},{"text":"lova Herren, ni av Israels källa!","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Där går Benjamin,","poem":1},{"text":"den yngste som leder dem,","poem":3},{"text":"där går skaran av Juda furstar,","poem":2},{"text":"Sebulons furstar, Naftalis furstar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Gud, visa din styrka","poem":1},{"noteId":209},{"text":"!","poem":1},{"text":"Gud, stärk vad du gjort för oss!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"På grund av ditt tempel","poem":1},{"text":"i Jerusalem","poem":3},{"text":"ska kungar komma","poem":2},{"text":"med gåvor till dig.","poem":3}]},{"type":"verse","number":31,"content":[{"text":"Straffa odjuret i vassen,","poem":1},{"text":"tjurarnas hop och folkens kalvar.","poem":3},{"text":"Ödmjukt ska de hylla dig","poem":2},{"text":"med silverstycken.","poem":3},{"text":"Han skingrar","poem":2},{"noteId":210},{"text":"de folk","poem":2},{"text":"som vill ha krig.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Sändebud","poem":1},{"noteId":211},{"text":"ska komma från Egypten,","poem":1},{"text":"Nubien ska skynda att","poem":2},{"text":"sträcka sina händer till Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Jordens riken, sjung till Gud,","poem":1},{"text":"lovsjung Herren, Sela","poem":2}]},{"type":"verse","number":34,"content":[{"text":"honom som drar fram","poem":1},{"text":"över himlen, urtidens himmel.","poem":3},{"text":"Hör, han höjer sin röst,","poem":2},{"text":"en mäktig röst!","poem":3}]},{"type":"verse","number":35,"content":[{"text":"Ge Gud makten!","poem":1},{"text":"Hans majestät är över Israel,","poem":2},{"text":"hans makt är i skyarna.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"Fruktad är du, Gud,","poem":1},{"text":"i din helgedom.","poem":3},{"text":"Israels Gud ger makt och styrka","poem":2},{"text":"åt sitt folk.","poem":3},{"text":"Lovad är Gud!","poem":2}]}],"footnotes":[{"noteId":203,"caller":"-","text":"öknarnaAnnan översättning: \"molnen\".","reference":{"chapter":68,"verse":5}},{"noteId":204,"caller":"-","text":"Duvans vingarTroligen en symbol för Israel (jfr Ps 74:19).","reference":{"chapter":68,"verse":14}},{"noteId":205,"caller":"-","text":"Salmon\"Det mörka berget\", enligt Dom 9:48 beläget nära staden Shekem.","reference":{"chapter":68,"verse":15}},{"noteId":206,"caller":"-","text":"Bashans bergGolanhöjderna med de höga Hermonsbergen i norr.","reference":{"chapter":68,"verse":16}},{"noteId":207,"caller":"-","text":"Citeras av Paulus i Ef 4:8 som profetia om Kristi himmelsfärd.","reference":{"chapter":68,"verse":19}},{"noteId":208,"caller":"-","text":"Herren GudHebr. Adonaí Jhvh. Se not till Jes 1:24.","reference":{"chapter":68,"verse":21}},{"noteId":209,"caller":"-","text":"Gud, visa din styrkaAndra handskrifter: \"Din Gud har gett dig din styrka\".","reference":{"chapter":68,"verse":29}},{"noteId":210,"caller":"-","text":"Han skingrarAnnan översättning (så Septuaginta): \"Skingra\".","reference":{"chapter":68,"verse":31}},{"noteId":211,"caller":"-","text":"SändebudSå Septuaginta, det hebreiska ordets betydelse är oklar. Andra översättningar: \"Bronsföremål\", \"Röda tyger\".","reference":{"chapter":68,"verse":32}}]},"thisChapterLink":"/api/swe_fol/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":36}