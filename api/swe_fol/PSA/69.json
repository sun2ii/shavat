{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":69,"content":[{"type":"heading","content":["Messias lidande"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till \"Liljorna\".","descriptive":true},{"text":"Av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Fräls mig, Gud!","poem":1},{"text":"Vattnet når mig till halsen.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jag har sjunkit i djupaste dy","poem":1},{"text":"utan fotfäste,","poem":3},{"text":"jag är ute på djupt vatten","poem":2},{"text":"och strömmen sköljer över mig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Jag har ropat mig trött,","poem":1},{"text":"min strupe är hes,","poem":3},{"text":"min blick är matt","poem":2},{"text":"av väntan på Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"De som hatar mig utan anledning","poem":1},{"text":"är fler än håren på mitt huvud.","poem":3},{"text":"Många vill förgöra mig,","poem":2},{"text":"de är mina fiender utan orsak.","poem":3},{"text":"Vad jag inte har stulit","poem":2},{"text":"måste jag ersätta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Gud, du känner min dårskap,","poem":1},{"text":"min skuld är inte dold för dig.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Herre, Gud Sebaot,","poem":1},{"text":"låt inte dem som hoppas på dig","poem":2},{"text":"få skämmas för min skull,","poem":3},{"text":"låt inte dem som söker dig","poem":2},{"text":"få vanära för min skull,","poem":3},{"text":"du Israels Gud.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"För din skull får jag utstå hån,","poem":1},{"text":"vanära täcker mitt ansikte.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jag har blivit en främling","poem":1},{"text":"för mina bröder,","poem":3},{"text":"främmande för min mors barn.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Brinnande iver för ditt hus","poem":1},{"text":"har förtärt mig,","poem":3},{"text":"dina smädares smädelser","poem":2},{"text":"föll över mig.","poem":3},{"noteId":212}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jag grät i min själ","poem":1},{"noteId":213},{"text":"och fastade,","poem":1},{"text":"men det blev jag hånad för.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jag klädde mig i sorgdräkt,","poem":1},{"text":"men jag blev ett ordspråk för dem.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"De som sitter i porten","poem":1},{"text":"pratar om mig,","poem":3},{"text":"drinkare gör visor om mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Men jag bär min bön","poem":1},{"text":"till dig, Herre, i nådens tid.","poem":3},{"text":"Gud, svara mig i din stora godhet,","poem":2},{"text":"i din frälsande trofasthet!","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Rädda mig ur dyn","poem":1},{"text":"så att jag inte sjunker,","poem":3},{"text":"rädda mig","poem":2},{"text":"från dem som hatar mig","poem":3},{"text":"och från de djupa vattnen.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Låt inte vattenströmmarna","poem":1},{"text":"skölja över mig,","poem":3},{"text":"låt inte djupet sluka mig,","poem":2},{"text":"låt inte brunnens gap","poem":3},{"text":"slå igen över mig.","poem":4}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Svara mig, Herre,","poem":1},{"text":"för din nåd är god!","poem":3},{"text":"Vänd dig till mig","poem":2},{"text":"i din stora barmhärtighet.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Dölj inte ditt ansikte för din tjänare,","poem":1},{"text":"för jag är i nöd.","poem":2},{"text":"Skynda dig, svara mig!","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Kom till min själ, återlös den,","poem":1},{"text":"friköp mig från mina fiender.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Du känner den skymf,","poem":1},{"text":"skam och vanära jag får utstå.","poem":3},{"text":"Du ser alla mina ovänner.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Förakt har krossat mitt hjärta,","poem":1},{"text":"jag är sjuk.","poem":3},{"text":"Jag hoppades på medlidande","poem":2},{"text":"men fick inget,","poem":3},{"text":"på tröstare men fann ingen.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"De gav mig galla att äta","poem":1},{"text":"och ättika","poem":2},{"noteId":214},{"text":"att dricka i min törst.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Låt deras bord framför dem","poem":1},{"text":"bli en snara, ett straff och en fälla","poem":2},{"noteId":215},{"text":".","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Låt deras ögon förmörkas","poem":1},{"text":"så att de inte ser,","poem":3},{"text":"låt deras ben ständigt vackla.","poem":2},{"noteId":216}]},{"type":"verse","number":25,"content":[{"text":"Ös din vrede över dem,","poem":1},{"text":"låt din glödande harm","poem":2},{"text":"hinna upp dem.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Låt deras gård bli öde,","poem":1},{"text":"låt ingen bo i deras tält,","poem":2},{"noteId":217}]},{"type":"verse","number":27,"content":[{"text":"för de förföljer den du har slagit","poem":1},{"text":"och pratar om plågan","poem":2},{"noteId":218},{"text":"hos den du har sårat.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Lägg skuld till deras skuld,","poem":1},{"text":"låt dem inte få del","poem":2},{"text":"av din rättfärdighet.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Låt dem utplånas","poem":1},{"text":"ur de levandes bok,","poem":3},{"text":"låt dem inte bli skrivna","poem":2},{"text":"bland de rättfärdiga.","poem":3}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Men jag är plågad och lider.","poem":1},{"text":"Gud, låt din frälsning skydda mig!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Jag vill prisa Guds namn med sång","poem":1},{"text":"och upphöja honom","poem":2},{"text":"med tacksägelse.","poem":3}]},{"type":"verse","number":32,"content":[{"text":"Det ska glädja Herren","poem":1},{"text":"mer än tjurar och oxar","poem":2},{"text":"med horn och klövar.","poem":3}]},{"type":"verse","number":33,"content":[{"text":"De ödmjuka ska se det och glädjas.","poem":1},{"text":"Ni som söker Gud,","poem":2},{"text":"era hjärtan ska leva,","poem":3}]},{"type":"verse","number":34,"content":[{"text":"för Herren lyssnar till de fattiga","poem":1},{"text":"och föraktar inte sina fångna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Himmel och jord ska prisa honom,","poem":1},{"text":"haven och allt som rör sig i dem,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"för Gud ska frälsa Sion","poem":1},{"text":"och bygga upp Juda städer.","poem":3},{"text":"De ska bo där","poem":2},{"text":"och ta Sion i besittning.","poem":3}]},{"type":"verse","number":37,"content":[{"text":"Hans tjänares barn","poem":1},{"text":"ska få det till arv,","poem":3},{"text":"och de som älskar hans namn","poem":2},{"text":"ska bo där.","poem":3}]}],"footnotes":[{"noteId":212,"caller":"-","text":"Citeras i Joh 2:17, när Jesus rensar templet, och i Rom 15:3.","reference":{"chapter":69,"verse":10}},{"noteId":213,"caller":"-","text":"grät i min själAndra handskrifter (Septuaginta): \"tuktade min själ\".","reference":{"chapter":69,"verse":11}},{"noteId":214,"caller":"-","text":"galla … ättikaVid korsfästelsen fick Jesus ättikvin (Joh 19:28-30) med galla (Matt 27:34).","reference":{"chapter":69,"verse":22}},{"noteId":215,"caller":"-","text":"ett straff och en fällaAnnan översättning: \"och för de säkra en fälla\".","reference":{"chapter":69,"verse":23}},{"noteId":216,"caller":"-","text":"låt deras ben vacklaAndra handskrifter (Septuaginta): \"böj deras rygg\". Jfr Rom 11:10.","reference":{"chapter":69,"verse":24}},{"noteId":217,"caller":"-","text":"Citeras av Petrus i Apg 1:20 med hänsyftning på Judas Iskariots öde.","reference":{"chapter":69,"verse":26}},{"noteId":218,"caller":"-","text":"pratar om plåganAndra handskrifter (Septuaginta): \"ökar plågan\".","reference":{"chapter":69,"verse":27}}]},"thisChapterLink":"/api/swe_fol/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":37}