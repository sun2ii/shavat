{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":7,"content":[{"type":"heading","content":["Den oskyldiges bön om Herrens dom"]},{"type":"verse","number":1,"content":[{"text":"En klagopsalm av David, som sjöng den till Herren på grund av benjaminiten Kushs ord","descriptive":true},{"noteId":16},{"text":".","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre min Gud, jag flyr till dig.","poem":1},{"text":"Fräls mig från alla som jagar mig,","poem":2},{"text":"rädda mig!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Annars river de min själ som lejon,","poem":1},{"text":"rycker bort mig utan räddning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Herre min Gud,","poem":1},{"text":"om jag har gjort detta,","poem":2},{"text":"om jag har orätt på mina händer,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"om jag lönat min vän med ont","poem":1},{"text":"eller plundrat min ovän","poem":2},{"text":"utan orsak –","poem":3}]},{"type":"verse","number":6,"content":[{"text":"låt då fienden jaga min själ","poem":1},{"text":"och hinna upp mig,","poem":3},{"text":"låt honom trampa mitt liv","poem":2},{"text":"till marken","poem":3},{"text":"och lägga min ära","poem":2},{"noteId":17},{"text":"i stoftet. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Res dig, Herre, i din vrede,","poem":1},{"text":"stå upp mot mina","poem":2},{"text":"fienders raseri!","poem":3},{"text":"Vakna till min hjälp","poem":2},{"noteId":18},{"text":",","poem":2},{"text":"du som har kallat till dom.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Låt skaran av folkslag","poem":1},{"text":"samlas omkring dig,","poem":3},{"text":"trona åter över dem i höjden.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Herren håller dom över folken.","poem":1},{"text":"Döm mig, Herre,","poem":2},{"text":"efter min rättfärdighet,","poem":3},{"text":"efter den fullkomlighet","poem":2},{"text":"som täcker mig.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Gör slut på de gudlösas ondska,","poem":1},{"text":"låt den rättfärdige stå fast!","poem":3},{"text":"Du som prövar hjärtan och njurar","poem":2},{"noteId":19},{"text":"är en rättfärdig Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Min sköld är hos Gud,","poem":1},{"text":"han frälser dem","poem":2},{"text":"som har ärliga hjärtan.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Gud är en rättfärdig domare,","poem":1},{"text":"en Gud som visar sin vrede","poem":2},{"text":"varje dag.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Om någon inte omvänder sig","poem":1},{"text":"slipar han sitt svärd,","poem":3},{"text":"han spänner sin båge","poem":2},{"noteId":20},{"text":"och laddar den","poem":3},{"noteId":21},{"text":",","poem":3}]},{"type":"verse","number":14,"content":[{"text":"han förbereder","poem":1},{"text":"sina dödliga vapen","poem":3},{"text":"och gör sina pilar brinnande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Se, han är dräktig med ondska,","poem":1},{"text":"han går havande med olycka","poem":2},{"text":"och föder lögn.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Han gräver en grop","poem":1},{"text":"och gör den djup,","poem":3},{"text":"men faller själv i graven","poem":2},{"text":"han grävde.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Hans ondska slår tillbaka","poem":1},{"text":"mot hans eget huvud,","poem":3},{"text":"hans våld drabbar","poem":2},{"text":"hans egen hjässa.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Jag vill tacka Herren","poem":1},{"text":"för hans rättfärdighet","poem":3},{"text":"och lovsjunga","poem":2},{"text":"Herren den Högstes namn.","poem":3}]}],"footnotes":[{"noteId":16,"caller":"-","text":"på grund av benjaminiten Kushs ordAnnan översättning: \"på grund av saken med benjaminiten Kush\". Mannen är okänd men hörde troligen samman med benjaminiterna omkring kung Saul (se t ex 1 Sam 22:7).","reference":{"chapter":7,"verse":1}},{"noteId":17,"caller":"-","text":"min äraOfta uppfattat som liktydigt med \"min själ\".","reference":{"chapter":7,"verse":6}},{"noteId":18,"caller":"-","text":"till min hjälpAnnan översättning (så Septuaginta): \"min Gud\".","reference":{"chapter":7,"verse":7}},{"noteId":19,"caller":"-","text":"hjärtan och njurarEn bild för människans innersta (jfr Ps 139:13, Upp 2:23).","reference":{"chapter":7,"verse":10}},{"noteId":20,"caller":"-","text":"spänner sin bågeför att fästa strängen och göra den redo.","reference":{"chapter":7,"verse":13}},{"noteId":21,"caller":"-","text":"laddar denAnnan översättning: \"siktar med den\".","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/swe_fol/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":18}