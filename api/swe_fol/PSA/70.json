{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":70,"content":[{"type":"heading","content":["Bön om snar hjälp"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. Av David, till åminnelse.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gud, kom till min räddning!","poem":1},{"text":"Herre, skynda till min hjälp!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Låt dem som vill ta mitt liv","poem":1},{"text":"få skam och vanära,","poem":3},{"text":"låt dem som önskar mig olycka","poem":2},{"text":"vika tillbaka och blygas.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Låt dem vända om i sin skam,","poem":1},{"text":"de som säger: \"Haha!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Låt alla som söker dig","poem":1},{"text":"få jubla och glädjas i dig,","poem":3},{"text":"låt dem som älskar din frälsning","poem":2},{"text":"alltid få säga: \"Gud är stor!\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Men jag är svag och fattig.","poem":1},{"text":"Gud, skynda till mig!","poem":3},{"text":"Du är min hjälp och min befriare.","poem":2},{"text":"Herre, dröj inte!","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":6}