{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":71,"content":[{"type":"heading","content":["Bön om hjälp i ålderdomen"]},{"type":"verse","number":1,"content":[{"text":"Till dig, Herre,","poem":1},{"text":"tar jag min tillflykt.","poem":3},{"text":"Låt mig aldrig behöva skämmas.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Rädda mig och befria mig","poem":1},{"text":"i din rättfärdighet,","poem":3},{"text":"vänd ditt öra till mig och fräls mig.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Var min klippa där jag kan bo,","poem":1},{"text":"dit jag alltid kan komma,","poem":3},{"text":"du som gett befallning","poem":2},{"text":"om min frälsning.","poem":3},{"text":"Du är mitt bergfäste","poem":2},{"text":"och min borg.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Min Gud, befria mig","poem":1},{"text":"ur den gudlöses hand,","poem":3},{"text":"ur förbrytarens","poem":2},{"text":"och förtryckarens grepp,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"för du är mitt hopp, Herre,","poem":1},{"text":"Herre, min trygghet","poem":2},{"text":"ända från min ungdom.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Du har varit mitt stöd","poem":1},{"text":"ända från moderlivet,","poem":3},{"text":"du har förlöst mig","poem":2},{"text":"ur min mors inre.","poem":3},{"text":"Dig lovar jag alltid.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag har blivit som ett tecken","poem":1},{"text":"för många,","poem":3},{"text":"och du är min starka tillflykt.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Min mun ska fyllas av ditt lov,","poem":1},{"text":"av din ära dagen lång.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Förkasta mig inte","poem":1},{"text":"när jag blir gammal,","poem":3},{"text":"överge mig inte","poem":2},{"text":"när min kraft tar slut,","poem":3}]},{"type":"verse","number":10,"content":[{"text":"för mina fiender talar om mig,","poem":1},{"text":"de som vaktar på min själ","poem":2},{"text":"rådslår med varandra:","poem":3}]},{"type":"verse","number":11,"content":[{"text":"\"Gud har övergett honom.","poem":1},{"text":"Jaga och grip honom,","poem":2},{"text":"det finns ingen","poem":3},{"text":"som räddar honom!\"","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gud, var inte långt ifrån mig!","poem":1},{"text":"Min Gud, skynda till min hjälp!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Låt min själs fiender","poem":1},{"text":"få skämmas och gå under,","poem":3},{"text":"låt dem som vill mig ont","poem":2},{"text":"höljas i hån och vanära.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Men jag ska alltid hoppas","poem":1},{"text":"och prisa dig om och om igen.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Min mun ska förkunna","poem":1},{"text":"din rättfärdighet,","poem":2},{"text":"din frälsning dagen lång,","poem":3},{"text":"fast jag inte förstår dess vidd","poem":2},{"noteId":219},{"text":".","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Jag ska komma i Herrens,","poem":1},{"text":"Guds väldiga kraft,","poem":3},{"text":"jag ska prisa din rättfärdighet,","poem":2},{"text":"din och ingen annans.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Gud, du har undervisat mig","poem":1},{"text":"ända från min ungdom,","poem":3},{"text":"och än i dag förkunnar jag","poem":2},{"text":"dina under.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Överge mig inte, Gud,","poem":1},{"text":"när jag blir gammal och grå,","poem":3},{"text":"innan jag fått förkunna","poem":2},{"text":"din makt för nya släkten,","poem":3},{"text":"din kraft","poem":2},{"noteId":220},{"text":"för alla som ska komma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Din rättfärdighet","poem":1},{"text":"når upp till himlen, Gud,","poem":3},{"text":"du har gjort stora ting.","poem":2},{"text":"Gud, vem är som du?","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Du har låtit oss se","poem":1},{"text":"mycket nöd och olycka,","poem":3},{"text":"men du ska åter ge oss liv,","poem":2},{"text":"åter lyfta oss ur jordens djup.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Föröka min storhet","poem":1},{"text":"och trösta mig igen,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"så vill jag tacka dig till lyra","poem":1},{"text":"för din trofasthet, min Gud,","poem":3},{"text":"jag vill lovsjunga dig till harpa,","poem":2},{"text":"du Israels Helige.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Mina läppar ska jubla","poem":1},{"text":"när jag lovsjunger dig,","poem":3},{"text":"så även min själ som du har friköpt.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Min tunga ska tala","poem":1},{"text":"om din rättfärdighet dagen lång,","poem":3},{"text":"för de som ville mig ont","poem":2},{"text":"måste skämmas och blygas.","poem":3}]}],"footnotes":[{"noteId":219,"caller":"-","text":"förstår dess viddAnnan översättning: \"förmår att skildra allt\".","reference":{"chapter":71,"verse":15}},{"noteId":220,"caller":"-","text":"din kraftOrdagrant: \"din arm\" (jfr Jes 53:1).","reference":{"chapter":71,"verse":18}}]},"thisChapterLink":"/api/swe_fol/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}