{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":72,"content":[{"type":"heading","content":["Fredskungen och hans rike"]},{"type":"verse","number":1,"content":[{"text":"Av Salomo.","descriptive":true},{"lineBreak":true},{"text":"Gud, ge kungen dina domar,","poem":1},{"text":"kungasonen din rättfärdighet!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Han ska döma ditt folk","poem":1},{"text":"med rättfärdighet,","poem":3},{"text":"dina förtryckta med rättvisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bergen ska bära frid åt folket,","poem":1},{"text":"höjderna rättfärdighet.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Han ska skipa rätt","poem":1},{"text":"för de förtryckta bland folket,","poem":3},{"text":"han ska frälsa de fattigas barn","poem":2},{"text":"och krossa förtryckaren.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dig ska man vörda","poem":1},{"noteId":221},{"text":"så länge solen finns till,","poem":2},{"text":"så länge månen skiner,","poem":3},{"text":"från släkte till släkte.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Han ska komma som regn","poem":1},{"text":"över nyslagen äng,","poem":3},{"text":"en regnskur som vattnar jorden.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"I hans dagar","poem":1},{"text":"ska den rättfärdige blomstra,","poem":3},{"text":"stor frid ska råda","poem":2},{"text":"tills månen inte mer","poem":3},{"text":"finns till.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Han ska härska från hav till hav,","poem":1},{"text":"från floden","poem":2},{"noteId":222},{"text":"till jordens ändar.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Öknens folk","poem":1},{"text":"ska böja knä för honom,","poem":3},{"text":"hans fiender ska slicka stoftet.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kungar från Tarshish","poem":1},{"text":"och kustländerna","poem":2},{"text":"ska komma med tribut,","poem":3},{"text":"kungar från Saba och Seba","poem":2},{"noteId":223},{"text":"ska bära fram gåvor.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Alla kungar ska falla ner för honom,","poem":1},{"text":"alla folk ska tjäna honom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ja, han ska rädda den fattige","poem":1},{"text":"som ropar","poem":3},{"text":"och den förtryckte","poem":2},{"text":"som ingen hjälpare har.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Han ska vara mild","poem":1},{"text":"mot den svage och fattige","poem":3},{"text":"och frälsa de fattigas själar,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"han ska befria deras själ","poem":1},{"text":"från förtryck och våld.","poem":3},{"text":"Deras blod är dyrbart i hans ögon.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Må han leva och få guld från Saba,","poem":1},{"text":"må man ständigt be för honom","poem":2},{"text":"och välsigna honom dagen lång.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Må säden växa rikt i landet,","poem":1},{"text":"ända upp till bergens toppar.","poem":3},{"text":"Må dess frukt vaja","poem":2},{"text":"som Libanons skogar","poem":3},{"text":"och städernas folk blomstra","poem":2},{"text":"som markens örter.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Må hans namn leva för evigt,","poem":1},{"text":"må hans namn blomstra","poem":2},{"text":"så länge solen skiner.","poem":3},{"text":"I honom ska man välsigna sig,","poem":2},{"text":"alla hednafolk","poem":3},{"text":"ska prisa honom salig.","poem":4}]},{"type":"heading","content":["__"]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Välsignad är Herren Gud,","poem":1},{"text":"Israels Gud som ensam gör under!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Välsignat är hans härliga namn","poem":1},{"text":"för evigt.","poem":3},{"text":"Må hans ära fylla hela jorden!","poem":2},{"text":"Amen, amen.","poem":3}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Slut på Davids, Ishais sons, böner.","poem":1}]}],"footnotes":[{"noteId":221,"caller":"-","text":"Dig ska man vördaAndra handskrifter (Septuaginta): \"Han ska bestå\".","reference":{"chapter":72,"verse":5}},{"noteId":222,"caller":"-","text":"havet … flodenMedelhavet och troligen Eufrat (jfr 1 Kung 4:21).","reference":{"chapter":72,"verse":8}},{"noteId":223,"caller":"-","text":"Tarshish … Saba och SebaTroligen dagens Spanien eller Kartago, samt Jemen.","reference":{"chapter":72,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}