{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":73,"content":[{"type":"heading","content":["Undran över de gudlösas framgång"]},{"type":"verse","number":1,"content":[{"text":"En psalm av Asaf.","descriptive":true},{"lineBreak":true},{"text":"Gud är verkligen god mot Israel,","poem":1},{"text":"mot dem som har rena hjärtan.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Men jag var nära att snava","poem":1},{"text":"med mina fötter,","poem":3},{"text":"mina steg var nära att slinta,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"för jag greps av avund","poem":1},{"text":"mot de högmodiga","poem":3},{"text":"när jag såg de gudlösas framgång.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"De är fria från plågor","poem":1},{"text":"fram till sin död,","poem":3},{"text":"deras kroppar är välnärda.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"De drabbas inte av mänsklig nöd,","poem":1},{"text":"de plågas inte","poem":2},{"text":"som andra människor.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Därför är högmod deras halsband","poem":1},{"text":"och våld den dräkt de sveper sig i.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Deras ögon kikar fram","poem":1},{"noteId":224},{"text":"ur fetman,","poem":1},{"text":"deras hjärtans fantasier","poem":2},{"text":"har ingen gräns.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"De hånar och hotar med ondska,","poem":1},{"text":"överlägset hotar de med förtryck.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"De öppnar sin mun mot himlen","poem":1},{"text":"och deras tunga far fram på jorden.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Därför vänder sig folket till dem,","poem":1},{"text":"de suger i sig vatten i mängd.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"De säger:","poem":1},{"text":"\"Hur skulle Gud kunna veta?","poem":3},{"text":"Den Högste har väl ingen vetskap?\"","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sådana är de gudlösa,","poem":1},{"text":"ständigt trygga","poem":2},{"text":"med växande rikedom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Förgäves höll jag mitt hjärta rent","poem":1},{"text":"och tvådde mina händer i oskuld!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jag var plågad hela dagen","poem":1},{"text":"och tuktad varje morgon –","poem":2}]},{"type":"verse","number":15,"content":[{"text":"men hade jag sagt:","poem":1},{"text":"\"Så tänker jag tala\",","poem":3},{"text":"då hade jag svikit dina barns släkte.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Jag funderade","poem":1},{"text":"och försökte förstå det,","poem":3},{"text":"men det var för svårt för mig,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"tills jag kom in i Guds helgedom","poem":1},{"text":"och insåg deras öde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Du ställer dem på det hala,","poem":1},{"text":"du störtar dem i fördärvet.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hur plötsligt ska de inte gå under!","poem":1},{"text":"De förgås och får ett fruktansvärt","poem":2},{"text":"slut.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Så som en dröm är borta","poem":1},{"text":"när man vaknar","poem":3},{"text":"ska du, Herre, förakta dem","poem":2},{"text":"som skuggbilder när du griper in.","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"När mitt hjärta var bittert","poem":1},{"text":"och det stack i mitt inre,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"då var jag oförnuftig","poem":1},{"text":"och förstod ingenting,","poem":3},{"text":"jag var som ett djur inför dig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Men jag är alltid hos dig,","poem":1},{"text":"du håller mig i min högra hand.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Du leder mig med ditt råd","poem":1},{"text":"och tar sedan emot mig med ära.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Vem har jag i himlen utom dig?","poem":1},{"text":"Och har jag dig,","poem":2},{"text":"söker jag inget på jorden.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"När min kropp och mitt hjärta","poem":1},{"text":"ger upp,","poem":3},{"text":"är Gud mitt hjärtas klippa","poem":2},{"text":"och min lott för evigt.","poem":3}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"De som är fjärran från dig går under,","poem":1},{"text":"du förgör alla som är otrogna","poem":2},{"text":"mot dig.","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Men för mig är det gott","poem":1},{"text":"att vara nära Gud.","poem":3},{"text":"Jag tar min tillflykt","poem":2},{"text":"till Herren, Gud,","poem":3},{"text":"för att förkunna","poem":2},{"text":"alla dina gärningar.","poem":3}]}],"footnotes":[{"noteId":224,"caller":"-","text":"Deras ögon kikar framAndra handskrifter (Septuaginta): \"Deras synd tränger fram\".","reference":{"chapter":73,"verse":7}}]},"thisChapterLink":"/api/swe_fol/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}