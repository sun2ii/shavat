{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":74,"content":[{"type":"heading","content":["Templets förstöring"]},{"type":"verse","number":1,"content":[{"text":"En vishetspsalm av Asaf.","descriptive":true},{"lineBreak":true},{"text":"Varför, Gud, har du förkastat oss","poem":1},{"text":"för alltid?","poem":3},{"text":"Varför ryker din vrede","poem":2},{"text":"mot fåren i din hjord?","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Tänk på din församling","poem":1},{"text":"som du vann i forna tider,","poem":3},{"text":"din arvedels stam","poem":2},{"text":"som du återlöste.","poem":3},{"text":"Tänk på Sions berg","poem":2},{"text":"där du tog din boning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Vänd dina steg till dessa eviga ruiner.","poem":1},{"text":"Allt i helgedomen","poem":2},{"text":"har fienden förstört.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Dina motståndare skränade","poem":1},{"text":"på platsen där du möter oss,","poem":3},{"text":"de satte upp sina fälttecken","poem":2},{"text":"som tecken.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Det var som när yxor höjs","poem":1},{"text":"i en tät skog,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"alla ornament slog de sönder","poem":1},{"text":"med yxa och hacka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"De satte eld på din helgedom","poem":1},{"text":"och vanhelgade ditt namns boning","poem":2},{"text":"ända till grunden.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De sade i sina hjärtan:","poem":1},{"text":"\"Vi ska kuva dem fullständigt!\"","poem":3},{"text":"Alla Guds mötesplatser","poem":2},{"text":"brände de ner i landet.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Vi ser inte våra tecken,","poem":1},{"text":"ingen profet finns kvar","poem":3},{"text":"och ingen av oss vet","poem":2},{"text":"hur länge det varar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hur länge, Gud,","poem":1},{"text":"ska fienden få håna","poem":2},{"text":"och ständigt förakta ditt namn?","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Varför håller du tillbaka din hand,","poem":1},{"text":"din högra hand?","poem":3},{"text":"Dra fram den ur din famn","poem":2},{"text":"och förgör dem!","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Gud, min kung sedan urminnes tid,","poem":1},{"text":"du som skapar frälsning på jorden!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Du delade havet med din makt,","poem":1},{"text":"du krossade drakarnas huvuden","poem":2},{"text":"på vattnet,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"du knäckte Leviatans huvuden","poem":1},{"text":"och gav honom till mat","poem":2},{"text":"åt öknens skaror.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Du lät källa och bäck bryta fram,","poem":1},{"text":"du lät starka strömmar torka ut.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Din är dagen, din är också natten,","poem":1},{"text":"du har skapat ljuset","poem":2},{"noteId":225},{"text":"och solen.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Du har fastställt jordens alla gränser.","poem":1},{"text":"Sommar och vinter är skapade","poem":2},{"text":"av dig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Tänk på hur fienden hånar, Herre,","poem":1},{"text":"hur ett dåraktigt folk","poem":2},{"text":"föraktar ditt namn!","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Ge inte din turturduvas själ","poem":1},{"text":"åt vilddjuren,","poem":3},{"text":"glöm inte dina förtrycktas liv","poem":2},{"text":"för alltid!","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Tänk på förbundet,","poem":1},{"text":"för landets mörka vrår","poem":2},{"text":"är fulla av våldets nästen.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Låt inte den kuvade","poem":1},{"text":"vända skamsen tillbaka,","poem":3},{"text":"låt den förtryckte och fattige","poem":2},{"text":"få prisa ditt namn.","poem":3}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Res dig, Gud, och för din talan!","poem":1},{"text":"Tänk på hur dåren hånar dig","poem":2},{"text":"dagen lång.","poem":3}]},{"type":"verse","number":23,"content":[{"text":"Glöm inte dina fienders rop,","poem":1},{"text":"det skrän som ständigt stiger","poem":2},{"text":"från dina motståndare.","poem":3}]}],"footnotes":[{"noteId":225,"caller":"-","text":"ljusetAnnan översättning: \"himlaljusen\" (måne och stjärnor).","reference":{"chapter":74,"verse":16}}]},"thisChapterLink":"/api/swe_fol/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}