{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":75,"content":[{"type":"heading","content":["Guds dom över de trotsiga"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. \"Fördärva inte\".","descriptive":true},{"text":"En psalm, en sång av Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Vi tackar dig, Gud, vi tackar dig!","poem":1},{"text":"Ditt namn är nära,","poem":2},{"text":"man förkunnar dina under.","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"\"Vid den tid jag bestämt","poem":1},{"text":"ska jag fälla en rättvis dom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jorden och alla som bor där","poem":1},{"text":"kan vackla","poem":3},{"noteId":226},{"text":",","poem":3},{"text":"men jag har gett","poem":2},{"text":"dess pelare stadga.\"","poem":3},{"text":"Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jag säger till de skrytsamma:","poem":1},{"text":"\"Skryt inte!\"","poem":3},{"text":"och till de gudlösa:","poem":2},{"text":"\"Höj inte hornet!\"","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Höj inte ert horn så högt,","poem":1},{"text":"tala inte så trotsigt och fräckt.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Varken från öster eller väster","poem":1},{"text":"eller från öknen","poem":2},{"text":"kommer upphöjelsen.","poem":3},{"noteId":227}]},{"type":"verse","number":8,"content":[{"text":"Nej, Gud är den som dömer.","poem":1},{"text":"Den ene böjer han ner,","poem":2},{"text":"den andre reser han upp.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"I Herrens hand är en bägare","poem":1},{"noteId":228},{"text":"med skummande vin,","poem":2},{"text":"full av blandad dryck.","poem":3},{"text":"Han häller upp,","poem":2},{"text":"och jordens alla gudlösa","poem":3},{"text":"måste dricka den i botten.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Men jag ska för evigt förkunna","poem":1},{"noteId":229},{"text":"och lovsjunga Jakobs Gud.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Alla gudlösas horn","poem":1},{"text":"ska jag hugga av,","poem":3},{"text":"men den rättfärdiges horn","poem":2},{"text":"ska upphöjas.","poem":3}]}],"footnotes":[{"noteId":226,"caller":"-","text":"vacklaAnnan översättning (så Septuaginta): \"smälta\".","reference":{"chapter":75,"verse":4}},{"noteId":227,"caller":"-","text":"från öknen kommer upphöjelsenAnnan översättning: \"från bergsöknen kommer det\". Söder om Israels bebodda delar ligger den klippiga Negevöknen.","reference":{"chapter":75,"verse":7}},{"noteId":228,"caller":"-","text":"bägareEn bild för Guds vredesdom (jfr Matt 20:22f, 26:39f, Upp 14:10).","reference":{"chapter":75,"verse":9}},{"noteId":229,"caller":"-","text":"förkunnaAndra handskrifter (Septuaginta): \"jubla\".","reference":{"chapter":75,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}