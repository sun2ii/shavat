{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":76,"content":[{"type":"heading","content":["Guds dom över fienderna"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till stränginstrument.","descriptive":true},{"text":"En psalm, en sång av Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gud är känd i Juda,","poem":1},{"text":"hans namn är stort i Israel.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"I Salem","poem":1},{"noteId":230},{"text":"står hans hydda,","poem":1},{"text":"på Sion hans boning.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Där bröt han bågens blixtrande pilar,","poem":1},{"text":"sköld och svärd och krigets vapen.","poem":2},{"text":"Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Strålande är du,","poem":1},{"text":"härligare än berg rika på byte","poem":2},{"noteId":231},{"text":".","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Modiga män ligger plundrade,","poem":1},{"text":"de sover sin sömn,","poem":3},{"text":"ingen stridsman","poem":2},{"text":"kan lyfta sin hand.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"För ditt straffande ord,","poem":1},{"text":"du Jakobs Gud,","poem":3},{"text":"ligger ryttare och häst i dvala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Du, endast du, är värd att frukta.","poem":1},{"text":"Vem kan bestå inför dig","poem":2},{"text":"när du vredgas?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Från himlen låter du domen höras,","poem":1},{"text":"jorden förskräcks och blir stilla","poem":2}]},{"type":"verse","number":10,"content":[{"text":"när Gud står upp för att döma,","poem":1},{"text":"för att frälsa alla ödmjuka","poem":2},{"text":"på jorden. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Din vrede mot människor","poem":1},{"text":"ska bli till din ära,","poem":3},{"text":"dem som överlevt vreden","poem":2},{"text":"ska du ikläda dig","poem":3},{"noteId":232},{"text":".","poem":3},{"noteId":233}]},{"type":"verse","number":12,"content":[{"text":"Ge löften till Herren er Gud","poem":1},{"text":"och uppfyll dem!","poem":3},{"text":"Alla runt omkring ska komma","poem":2},{"text":"med gåvor till den Fruktade.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Han kuvar furstarnas ande,","poem":1},{"text":"fruktad av kungarna","poem":2},{"text":"på jorden.","poem":3}]}],"footnotes":[{"noteId":230,"caller":"-","text":"SalemTroligen en äldre och kortare namnform för Jerusalem (jfr 1 Mos 14:18).","reference":{"chapter":76,"verse":3}},{"noteId":231,"caller":"-","text":"berg rika på byteAndra handskrifter (Septuaginta): \"de eviga bergen\".","reference":{"chapter":76,"verse":5}},{"noteId":232,"caller":"-","text":"Grundtextens innebörd är oklar. Annan översättning: \"Människors vrede ska bli till din ära, resten av vreden ska du ikläda dig\" (som ett vapen).","reference":{"chapter":76,"verse":11}},{"noteId":233,"caller":"-","text":"ska du ikläda digAndra handskrifter (Septuaginta): \"ska hylla dig med högtid\".","reference":{"chapter":76,"verse":11}}]},"thisChapterLink":"/api/swe_fol/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}