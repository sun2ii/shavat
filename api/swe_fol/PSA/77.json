{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":77,"content":[{"type":"heading","content":["Tröst i tider av oro"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till Jedutun. En psalm av Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jag höjer min röst till Gud och ropar,","poem":1},{"text":"jag höjer min röst till Gud","poem":2},{"text":"och han lyssnar till mig.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"På nödens dag söker jag Herren,","poem":1},{"text":"om natten är min hand utsträckt","poem":2},{"text":"utan att tröttna.","poem":3},{"text":"Min själ vägrar låta sig tröstas.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jag tänker på Gud och suckar,","poem":1},{"text":"jag grubblar och min ande","poem":2},{"text":"mattas. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mina ögonlock håller du öppna,","poem":1},{"text":"jag är full av oro","poem":2},{"text":"och kan inte tala.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag tänker på forna dagar,","poem":1},{"text":"sedan länge flydda år.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag minns min sång","poem":1},{"noteId":234},{"text":"i natten,","poem":1},{"text":"jag grubblar i mitt hjärta","poem":2},{"text":"och min ande undrar:","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Ska Herren förkasta för evigt","poem":1},{"text":"och aldrig mer visa nåd?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Är hans godhet borta för alltid?","poem":1},{"text":"Är det slut med hans ord","poem":2},{"text":"för alla tider?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Har Gud glömt att vara nådig?","poem":1},{"text":"Eller har han i vrede hållit inne","poem":2},{"text":"sin barmhärtighet? Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jag svarar: Detta är min plåga,","poem":1},{"text":"att den Högstes högra hand","poem":2},{"text":"inte är som förr.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Jag minns Herrens gärningar,","poem":1},{"text":"jag minns dina forna under,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"jag tänker på alla dina verk","poem":1},{"text":"och begrundar det du har gjort.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gud, i helighet går din väg.","poem":1},{"text":"Vilken gud är så stor som Gud?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Du är den Gud som gör under,","poem":1},{"text":"du har visat din makt bland folken.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Med din arm har du","poem":1},{"text":"återlöst ditt folk,","poem":3},{"text":"Jakobs och Josefs barn. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Vattnen såg dig, Gud,","poem":1},{"text":"vattnen såg dig och bävade,","poem":2},{"text":"själva djupen darrade.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Från molnen strömmade vatten,","poem":1},{"text":"skyarna höjde sin röst","poem":2},{"text":"och dina pilar flög överallt.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Din åska dundrade i virvelstormen,","poem":1},{"text":"blixtar lyste upp världen,","poem":2},{"text":"jorden darrade och bävade.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Genom havet gick din väg,","poem":1},{"text":"din stig genom väldiga vatten,","poem":3},{"text":"och ingen såg dina fotspår.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Du förde ditt folk som en fårhjord","poem":1},{"text":"genom Moses och Arons hand.","poem":2}]}],"footnotes":[{"noteId":234,"caller":"-","text":"min sångAndra handskrifter (Septuaginta): \"mina tankar\".","reference":{"chapter":77,"verse":7}}]},"thisChapterLink":"/api/swe_fol/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":21}