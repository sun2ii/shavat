{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":78,"content":[{"type":"heading","content":["Dom och frälsning i Israels historia"]},{"type":"verse","number":1,"content":[{"text":"En vishetspsalm av Asaf.","descriptive":true},{"lineBreak":true},{"text":"Lyssna, mitt folk,","poem":1},{"text":"till min undervisning,","poem":3},{"text":"vänd era öron till min muns ord!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jag vill öppna min mun","poem":1},{"text":"för att tala visdomsord","poem":3},{"noteId":235},{"text":",","poem":3},{"text":"lägga fram gåtor från gången tid.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Vad vi har hört och lärt känna,","poem":1},{"text":"vad våra fäder berättat för oss","poem":2}]},{"type":"verse","number":4,"content":[{"text":"vill vi inte dölja för deras barn.","poem":1},{"text":"För det kommande släktet","poem":2},{"text":"förkunnar vi Herrens lov,","poem":3},{"text":"hans makt och de under han gjort.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Han upprättade","poem":1},{"text":"ett vittnesbörd i Jakob,","poem":2},{"text":"han gav sin undervisning i Israel","poem":3},{"text":"och befallde våra fäder","poem":2},{"text":"att lära ut den till sina barn,","poem":3}]},{"type":"verse","number":6,"content":[{"text":"så att den blev känd","poem":1},{"text":"för det kommande släktet,","poem":2},{"text":"de barn som skulle födas.","poem":3},{"text":"De i sin tur skulle","poem":2},{"text":"berätta för sina barn,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"så att de sätter sitt hopp till Gud","poem":1},{"text":"och inte glömmer Guds gärningar","poem":2},{"text":"utan följer hans bud.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De ska inte bli som sina fäder,","poem":1},{"text":"ett trotsigt och upproriskt släkte","poem":2},{"text":"med opålitligt hjärta","poem":3},{"text":"och en ande trolös mot Gud.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Efraims söner,","poem":1},{"text":"beväpnade bågskyttar,","poem":3},{"text":"vände på stridens dag.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"De höll inte Guds förbund","poem":1},{"text":"utan vägrade följa hans lag,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"de glömde hans gärningar","poem":1},{"text":"och undren han visat dem.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Inför deras fäder","poem":1},{"text":"hade han gjort under","poem":2},{"text":"i Egyptens land, på Soans mark","poem":3},{"noteId":236},{"text":".","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Han klöv havet","poem":1},{"text":"och förde dem igenom,","poem":3},{"text":"han lät vattnet stå som en mur.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Han ledde dem","poem":1},{"text":"med molnskyn om dagen","poem":3},{"text":"och med eldsken","poem":2},{"text":"hela natten.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Han klöv klippor i öknen","poem":1},{"text":"och lät dem dricka","poem":2},{"text":"som ur väldiga hav,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"han lät bäckar rinna fram","poem":1},{"text":"ur klippan","poem":3},{"text":"och vatten skölja ner","poem":2},{"text":"som strömmar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Men de fortsatte att synda","poem":1},{"text":"mot honom,","poem":3},{"text":"de gjorde uppror","poem":2},{"text":"mot den Högste i öknen.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"De frestade Gud i sina hjärtan","poem":1},{"text":"genom att kräva mat efter sitt begär.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"De talade mot Gud, de sade:","poem":1},{"text":"\"Kan Gud duka ett bord i öknen?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Visst slog han klippan","poem":1},{"text":"så att vattnet flödade","poem":2},{"text":"och bäckar strömmade fram,","poem":3},{"text":"men kan han också ge bröd","poem":2},{"text":"eller skaffa kött åt sitt folk?\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"När Herren hörde det","poem":1},{"text":"blev han vred.","poem":3},{"text":"Eld blossade upp mot Jakob,","poem":2},{"text":"vrede vällde fram mot Israel,","poem":3}]},{"type":"verse","number":22,"content":[{"text":"för de trodde inte på Gud","poem":1},{"text":"och litade inte på hans frälsning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ändå gav han befallning","poem":1},{"text":"åt skyarna i höjden","poem":2},{"text":"och öppnade himlens portar.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Han lät manna regna över dem","poem":1},{"text":"till mat","poem":3},{"text":"och gav dem säd från himlen.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Människor fick äta änglars bröd,","poem":1},{"text":"han sände dem mat","poem":2},{"text":"så att de blev mätta.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Han lät östanvinden","poem":1},{"text":"komma från himlen","poem":3},{"text":"och styrde sunnanvinden dit","poem":2},{"text":"med sin makt.","poem":3}]},{"type":"verse","number":27,"content":[{"text":"Han lät kött regna över dem","poem":1},{"text":"som stoft,","poem":3},{"text":"bevingade fåglar som havets sand.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Han lät dem falla mitt i deras läger,","poem":1},{"text":"runt omkring deras","poem":2},{"noteId":237},{"text":"boningar.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"De åt och blev övermätta,","poem":1},{"text":"han lät dem få vad de haft begär till.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Men innan de släckt sitt begär,","poem":1},{"text":"medan maten ännu var","poem":2},{"text":"i deras mun,","poem":3}]},{"type":"verse","number":31,"content":[{"text":"kom Guds vrede över dem.","poem":1},{"text":"Han dödade bland de starkaste","poem":2},{"text":"och slog ner Israels utvalda","poem":3},{"noteId":238},{"text":"män.","poem":3}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Ändå fortsatte de att synda","poem":1},{"text":"och trodde inte på hans under.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Då lät han deras dagar försvinna","poem":1},{"text":"i tomhet","poem":3},{"text":"och deras år i plötslig skräck.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"När han dräpte dem","poem":1},{"text":"frågade de efter honom,","poem":3},{"text":"de vände om och sökte Gud.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"De mindes att Gud är deras klippa,","poem":1},{"text":"att Gud den Högste","poem":2},{"text":"är deras befriare.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"De försökte bedra honom","poem":1},{"text":"med sina ord,","poem":3},{"text":"de ljög för honom med sin tunga.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Deras hjärtan var inte uppriktiga","poem":1},{"text":"mot honom,","poem":3},{"text":"de var inte trogna","poem":2},{"text":"mot hans förbund.","poem":3}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Men han är barmhärtig","poem":1},{"text":"och försonar skuld,","poem":2},{"text":"han vill inte förgöra.","poem":3},{"text":"Ofta höll han tillbaka sin vrede","poem":2},{"text":"och lät inte hela sin glöd","poem":3},{"text":"bryta fram.","poem":4}]},{"type":"verse","number":39,"content":[{"text":"Han tänkte på att de bara är kött,","poem":1},{"text":"en vind","poem":2},{"noteId":239},{"text":"som försvinner","poem":2},{"text":"och inte kommer åter.","poem":3}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Hur ofta trotsade de honom inte","poem":1},{"text":"i öknen","poem":3},{"text":"och bedrövade honom","poem":2},{"text":"i ödemarken!","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Gång på gång frestade de Gud","poem":1},{"text":"och kränkte Israels Helige.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"De kom inte ihåg hans hand","poem":1},{"text":"eller dagen då han befriade dem","poem":2},{"text":"från fienden,","poem":3}]},{"type":"verse","number":43,"content":[{"text":"då han gjorde sina tecken i Egypten","poem":1},{"text":"och sina under på Soans mark.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Han förvandlade deras floder","poem":1},{"text":"till blod","poem":3},{"text":"så att de inte kunde dricka","poem":2},{"text":"ur bäckarna.","poem":3}]},{"type":"verse","number":45,"content":[{"text":"Han sände flugsvärmar","poem":1},{"text":"som förtärde dem","poem":3},{"text":"och grodor som förstörde för dem,","poem":2}]},{"type":"verse","number":46,"content":[{"text":"han gav deras gröda åt larver","poem":1},{"text":"och deras skördar åt gräshoppor.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Han slog deras vinstockar","poem":1},{"text":"med hagel","poem":3},{"text":"och deras fikonträd med skyfall","poem":2},{"noteId":240},{"text":",","poem":2}]},{"type":"verse","number":48,"content":[{"text":"han utlämnade deras boskap åt hagel","poem":1},{"text":"och deras hjordar åt blixtar.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Han sände över dem sin vredesglöd,","poem":1},{"text":"harm, vrede och nöd,","poem":2},{"text":"en skara av olycksänglar.","poem":3}]},{"type":"verse","number":50,"content":[{"text":"Han gav fritt utlopp åt sin vrede,","poem":1},{"text":"han skonade inte deras själ","poem":2},{"text":"från döden","poem":3},{"text":"utan utlämnade deras liv åt pesten.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Han slog allt förstfött i Egypten,","poem":1},{"text":"livskraftens förstling","poem":2},{"text":"i Hams hyddor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Han lät sitt folk bryta upp","poem":1},{"text":"som en fårflock","poem":3},{"text":"och förde dem som en hjord","poem":2},{"text":"genom öknen.","poem":3}]},{"type":"verse","number":53,"content":[{"text":"Han ledde dem tryggt,","poem":1},{"text":"de behövde inte vara rädda,","poem":2},{"text":"deras fiender svaldes av havet.","poem":3}]},{"type":"verse","number":54,"content":[{"text":"Han förde dem till sitt heliga land,","poem":1},{"text":"till det berg som hans högra hand","poem":2},{"text":"hade vunnit.","poem":3}]},{"type":"verse","number":55,"content":[{"text":"Han fördrev hednafolken","poem":1},{"text":"framför dem,","poem":3},{"text":"han gav dem deras land","poem":2},{"text":"som arvedel","poem":3},{"text":"och lät Israels stammar bo","poem":2},{"text":"i deras hyddor.","poem":3}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Men de trotsade och frestade","poem":1},{"text":"Gud den Högste,","poem":3},{"text":"de höll inte fast","poem":2},{"text":"vid hans vittnesbörd.","poem":3}]},{"type":"verse","number":57,"content":[{"text":"De vek trolöst tillbaka","poem":1},{"text":"som sina fäder,","poem":3},{"text":"de gav vika som en opålitlig båge.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"De väckte hans vrede","poem":1},{"text":"med sina offerhöjder","poem":3},{"text":"och kränkte honom","poem":2},{"text":"med sina avgudabilder.","poem":3}]},{"type":"line_break"},{"type":"verse","number":59,"content":[{"text":"Gud hörde det och blev vred,","poem":1},{"text":"han förkastade Israel med all kraft.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Han övergav sin boning i Shilo","poem":1},{"noteId":241},{"text":",","poem":1},{"text":"det tält han rest bland människorna.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Han gav sin makt i fångenskap","poem":1},{"text":"och sin ära","poem":2},{"noteId":242},{"text":"i fiendehand.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Sitt folk utlämnade han åt svärdet,","poem":1},{"text":"han blev vred på sin arvedel.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Deras unga män förtärdes av eld,","poem":1},{"text":"deras unga kvinnor","poem":2},{"text":"blev utan brudsång.","poem":3}]},{"type":"verse","number":64,"content":[{"text":"Deras präster föll för svärd,","poem":1},{"text":"deras änkor kunde inte","poem":2},{"text":"hålla dödsklagan.","poem":3}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Då vaknade Herren som ur sömn,","poem":1},{"text":"som en hjälte bedövad av vin.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Han slog tillbaka sina fiender","poem":1},{"text":"och drog evig skam över dem.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Han förkastade Josefs hydda","poem":1},{"text":"och utvalde inte Efraims stam,","poem":2}]},{"type":"verse","number":68,"content":[{"text":"men Juda stam utvalde han,","poem":1},{"text":"Sions berg som han älskar.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Han byggde sin helgedom","poem":1},{"text":"hög som himlen,","poem":3},{"text":"grundade den likt jorden för evigt.","poem":2}]},{"type":"line_break"},{"type":"verse","number":70,"content":[{"text":"Han utvalde sin tjänare David","poem":1},{"text":"och tog honom från fårens fållor,","poem":2}]},{"type":"verse","number":71,"content":[{"text":"han hämtade honom från tackorna","poem":1},{"text":"och satte honom till herde","poem":2},{"text":"för Jakob, sitt folk,","poem":3},{"text":"för Israel, sin arvedel.","poem":4}]},{"type":"verse","number":72,"content":[{"text":"Han var deras herde med rent hjärta","poem":1},{"text":"och ledde dem","poem":2},{"text":"med förståndig hand.","poem":3}]}],"footnotes":[{"noteId":235,"caller":"-","text":"visdomsordAnnan översättning: \"liknelser\". Jfr Matt 13:35 där versen citeras i samband med Kristi undervisning.","reference":{"chapter":78,"verse":2}},{"noteId":236,"caller":"-","text":"Soans markDet deltaområde i nordöstra Egypten där israeliterna bodde före uttåget.","reference":{"chapter":78,"verse":12}},{"noteId":237,"caller":"-","text":"deras … derasAndra handskrifter: \"sitt … sina\".","reference":{"chapter":78,"verse":28}},{"noteId":238,"caller":"-","text":"utvaldaAnnan översättning: \"unga\".","reference":{"chapter":78,"verse":31}},{"noteId":239,"caller":"-","text":"vindAnnan översättning: \"ande\".","reference":{"chapter":78,"verse":39}},{"noteId":240,"caller":"-","text":"skyfallOrdets innebörd oklar. Annan möjlig översättning: \"frost\" (så Septuaginta).","reference":{"chapter":78,"verse":47}},{"noteId":241,"caller":"-","text":"ShiloPlats strax norr om Jerusalem där tabernaklet stod under domartiden (se t ex 1 Sam 1:3f).","reference":{"chapter":78,"verse":60}},{"noteId":242,"caller":"-","text":"sin makt … sin äraGuds förbundsark som utlämnades åt filisteerna (se 1 Sam 4-6).","reference":{"chapter":78,"verse":61}}]},"thisChapterLink":"/api/swe_fol/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/79.json","nextChapterAud