{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":79,"content":[{"type":"heading","content":["Bön efter Jerusalems förstöring"]},{"type":"verse","number":1,"content":[{"text":"En psalm av Asaf.","descriptive":true},{"lineBreak":true},{"text":"Gud, hednafolken trängde in","poem":1},{"text":"i din arvedel,","poem":3},{"text":"de vanhelgade ditt heliga tempel,","poem":2},{"text":"de gjorde Jerusalem","poem":3},{"text":"till en grushög.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"De gav dina tjänares kroppar","poem":1},{"text":"som mat åt himlens fåglar,","poem":3},{"text":"dina trognas kött åt markens djur.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"De spillde deras blod som vatten","poem":1},{"text":"runt Jerusalem,","poem":3},{"text":"och ingen begravde dem.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vi föraktas av våra grannar,","poem":1},{"text":"hånas av dem som bor","poem":2},{"text":"omkring oss.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hur länge, Herre?","poem":1},{"text":"Ska du vara vred för evigt?","poem":3},{"text":"Hur länge ska din lidelse","poem":2},{"text":"brinna som eld?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ös din vrede över hednafolken","poem":1},{"text":"som inte känner dig,","poem":3},{"text":"över de riken som inte åkallar","poem":2},{"text":"ditt namn,","poem":3}]},{"type":"verse","number":7,"content":[{"text":"för de har slukat Jakob","poem":1},{"text":"och ödelagt hans boning.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Tillräkna oss inte våra fäders synder,","poem":1},{"text":"låt din barmhärtighet","poem":2},{"text":"möta oss snart,","poem":4},{"text":"för vi har sjunkit mycket djupt.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Hjälp oss, du vår frälsnings Gud,","poem":1},{"text":"för ditt namns äras skull!","poem":3},{"text":"Rädda oss och försona","poem":2},{"text":"våra synder för ditt namns skull!","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Varför ska folken få säga:","poem":1},{"text":"\"Var är nu deras Gud?\"","poem":3},{"text":"Låt våra ögon få se","poem":2},{"text":"hur det blir känt bland folken","poem":3},{"text":"att du hämnas","poem":2},{"text":"dina tjänares spillda blod.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Låt fångarnas klagan","poem":1},{"text":"komma inför ditt ansikte,","poem":3},{"text":"låt dödens barn få leva","poem":2},{"text":"genom din starka arm.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Låt våra grannar få sjufalt igen","poem":1},{"text":"för sitt hån mot dig, Herre.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Då ska vi,","poem":1},{"text":"ditt folk och fåren i din hjord,","poem":3},{"text":"tacka dig för evigt","poem":2},{"text":"och förkunna ditt lov","poem":3},{"text":"från släkte till släkte.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}