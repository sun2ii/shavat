{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":8,"content":[{"type":"heading","content":["Människosonens ringhet och höghet"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till gittít.","descriptive":true},{"noteId":22},{"text":"En psalm av David.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, vår Herre,","poem":1},{"text":"hur härligt är inte ditt namn","poem":2},{"text":"över hela jorden,","poem":3},{"text":"du som satt ditt majestät","poem":2},{"text":"på himlen!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Av barns och spädbarns mun","poem":1},{"text":"har du berett en makt","poem":2},{"noteId":23},{"text":"för dina fienders skull,","poem":3},{"text":"för att förgöra fiende och hämnare.","poem":2},{"noteId":24}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"När jag ser din himmel,","poem":1},{"text":"dina fingrars verk,","poem":3},{"text":"månen och stjärnorna","poem":2},{"text":"som du har skapat –","poem":3}]},{"type":"verse","number":5,"content":[{"text":"vad är då en människa","poem":1},{"text":"att du tänker på henne,","poem":3},{"text":"en människoson","poem":2},{"text":"att du tar hand om honom?","poem":3},{"noteId":25}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"En liten tid","poem":1},{"noteId":26},{"text":"lät du honom","poem":1},{"text":"vara lägre än","poem":3},{"noteId":27},{"text":"Gud,","poem":3},{"text":"med ära och härlighet","poem":2},{"text":"krönte du honom.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Du satte honom att härska","poem":1},{"text":"över dina händers verk,","poem":3},{"text":"allt lade du under hans fötter:","poem":2},{"noteId":28}]},{"type":"verse","number":8,"content":[{"text":"alla får och oxar","poem":1},{"text":"liksom vildmarkens djur,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"himlens fåglar och havets fiskar,","poem":1},{"text":"de som vandrar havens vägar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Herre, vår Herre,","poem":1},{"text":"hur härligt är inte ditt namn","poem":2},{"text":"över hela jorden!","poem":3}]}],"footnotes":[{"noteId":22,"caller":"-","text":"gittítKan syfta på sångstil eller instrument från staden Gat, där David bodde en tid. Hebr. gatbetyder också \"vinpress\" (så Septuaginta).","reference":{"chapter":8,"verse":1}},{"noteId":23,"caller":"-","text":"Citeras av Jesus i Matt 21:16 när barnen i templet ropar ut sin hyllning till honom.","reference":{"chapter":8,"verse":3}},{"noteId":24,"caller":"-","text":"maktAnnan översättning: \"borg\". Andra handskrifter (Septuaginta): \"lovsång\".","reference":{"chapter":8,"verse":3}},{"noteId":25,"caller":"-","text":"Citeras i Hebr 2:6-8 som profetia om Jesus, som ofta kallade sig själv \"Människosonen\".","reference":{"chapter":8,"verse":5}},{"noteId":26,"caller":"-","text":"En liten tidAnnan översättning: \"Lite\" (en liten skillnad).","reference":{"chapter":8,"verse":6}},{"noteId":27,"caller":"-","text":"vara lägre änAnnan översättning: \"sakna\".","reference":{"chapter":8,"verse":6}},{"noteId":28,"caller":"-","text":"Citeras i 1 Kor 15:7, Ef 1:22 som profetia om Jesu upphöjelse.","reference":{"chapter":8,"verse":7}}]},"thisChapterLink":"/api/swe_fol/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":10}