{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":80,"content":[{"type":"heading","content":["Bön för Herrens vinstock"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till \"Liljorna\".","descriptive":true},{"text":"Ett vittnesbörd, en psalm av Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Lyssna, du Israels herde!","poem":1},{"text":"Du som leder Josef som en hjord,","poem":2},{"text":"du som tronar på keruberna,","poem":3},{"text":"visa dig i glans!","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Väck upp din makt till att gå","poem":1},{"text":"framför Efraim och Benjamin","poem":2},{"text":"och Manasse,","poem":3},{"text":"och kom till vår frälsning.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gud, upprätta oss","poem":1},{"noteId":243},{"text":"!","poem":1},{"text":"Låt ditt ansikte lysa","poem":2},{"text":"så att vi blir frälsta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Herre Gud Sebaot,","poem":1},{"text":"hur länge ska din vrede ryka","poem":2},{"text":"mot ditt folks bön?","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Du har låtit dem äta tårars bröd","poem":1},{"text":"och dricka tårar i fullt mått.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Du gör oss till ett stridsämne","poem":1},{"text":"för våra grannar,","poem":3},{"text":"och våra fiender hånar oss.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gud Sebaot, upprätta oss!","poem":1},{"text":"Låt ditt ansikte lysa","poem":2},{"text":"så att vi blir frälsta.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Du hämtade en vinstock","poem":1},{"text":"från Egypten,","poem":3},{"text":"du fördrev hednafolk","poem":2},{"lineBreak":true},{"text":"och planterade den.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Du röjde plats för den,","poem":1},{"text":"och den slog rot","poem":2},{"text":"och uppfyllde landet.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Den täckte bergen med sin skugga","poem":1},{"text":"och Guds cedrar med sina grenar,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"den sträckte ut sina skott till havet","poem":1},{"text":"och sina knoppar till floden","poem":2},{"noteId":244},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Varför rev du dess mur","poem":1},{"text":"så att alla som passerar","poem":2},{"text":"kan plocka av den?","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Vildsvin från skogen","poem":1},{"text":"frossar på den,","poem":3},{"text":"markens smådjur äter av den.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Gud Sebaot, kom tillbaka!","poem":1},{"text":"Blicka ner från himlen och se,","poem":2},{"text":"ta hand om denna vinstock!","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Skydda vad din högra hand","poem":1},{"text":"har planterat,","poem":3},{"text":"den son du har fostrat åt dig.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Den är bränd av eld och nerhuggen,","poem":1},{"text":"de går under inför din stränga blick.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Håll din hand över mannen","poem":1},{"text":"vid din högra sida,","poem":3},{"text":"den människoson","poem":2},{"text":"du har fostrat åt dig.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Då ska vi inte vika från dig.","poem":1},{"text":"Ge oss liv, och vi ska åkalla","poem":2},{"text":"ditt namn.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"Herre Gud Sebaot, upprätta oss!","poem":1},{"text":"Låt ditt ansikte lysa","poem":2},{"text":"så att vi blir frälsta.","poem":3}]}],"footnotes":[{"noteId":243,"caller":"-","text":"upprätta ossAnnan översättning (så Septuaginta): \"omvänd oss\" (även i vers 8 och 20).","reference":{"chapter":80,"verse":4}},{"noteId":244,"caller":"-","text":"flodenEufrat.","reference":{"chapter":80,"verse":12}}]},"thisChapterLink":"/api/swe_fol/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":20}