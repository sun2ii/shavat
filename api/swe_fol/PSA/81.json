{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":81,"content":[{"type":"heading","content":["Festglädje och lydnad"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till gittít","descriptive":true},{"noteId":245},{"text":". Av Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jubla inför Gud, vår styrka,","poem":1},{"text":"ropa av glädje till Jakobs Gud!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Stäm upp lovsång,","poem":1},{"text":"slå på tamburin,","poem":2},{"text":"på den ljuvliga harpan och lyran.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Blås i hornet vid nymåne","poem":1},{"text":"och vid fullmåne","poem":2},{"text":"på vår högtidsdag,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"för det är en lag för Israel","poem":1},{"noteId":246},{"text":",","poem":1},{"text":"ett beslut från Jakobs Gud.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Han bestämde det","poem":1},{"text":"som ett vittnesbörd i Josef","poem":3},{"text":"när han drog ut mot Egyptens land.","poem":2},{"lineBreak":true},{"text":"Jag hörde en röst","poem":1},{"text":"som jag inte kände:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"\"Jag lyfte bördan från hans axlar,","poem":1},{"text":"hans händer blev fria","poem":2},{"text":"från lastkorgen.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"I nöden ropade du","poem":1},{"text":"och jag räddade dig.","poem":3},{"text":"Jag svarade dig, dold i åska,","poem":2},{"text":"jag prövade dig","poem":3},{"text":"vid Meribas vatten. Sela","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hör, mitt folk, jag vill varna dig!","poem":1},{"text":"Israel, om du bara ville","poem":2},{"text":"lyssna på mig!","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Hos dig får ingen annan gud finnas,","poem":1},{"text":"du ska inte tillbe","poem":2},{"text":"en främmande gud.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Jag är Herren din Gud","poem":1},{"text":"som har fört dig upp","poem":2},{"text":"ur Egyptens land.","poem":3},{"text":"Öppna din mun helt","poem":2},{"text":"så ska jag fylla den!","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Men mitt folk","poem":1},{"text":"ville inte höra min röst,","poem":3},{"text":"Israel lydde mig inte.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Då lät jag dem gå","poem":1},{"text":"i sina hjärtans hårdhet,","poem":3},{"text":"de fick vandra","poem":2},{"text":"efter sina egna planer.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Om mitt folk bara ville höra mig,","poem":1},{"text":"om Israel ville vandra","poem":2},{"text":"på mina vägar!","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Då skulle jag snart kuva","poem":1},{"text":"deras fiender","poem":3},{"text":"och vända min hand","poem":2},{"text":"mot deras motståndare.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"De som hatar Herren","poem":1},{"text":"skulle krypa för honom,","poem":3},{"text":"och deras öde skulle vara för evigt.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Han skulle ge dig","poem":1},{"text":"finaste vete att äta","poem":3},{"text":"och mätta dig","poem":2},{"text":"med honung ur klippan.\"","poem":3}]}],"footnotes":[{"noteId":245,"caller":"-","text":"gittítKan syfta på sångstil eller instrument från staden Gat, där David bodde en tid. Hebr. gatbetyder också \"vinpress\" (så Septuaginta).","reference":{"chapter":81,"verse":1}},{"noteId":246,"caller":"-","text":"en lag för IsraelSe 4 Mos 10:10.","reference":{"chapter":81,"verse":5}}]},"thisChapterLink":"/api/swe_fol/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":17}