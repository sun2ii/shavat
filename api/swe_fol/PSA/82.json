{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":82,"content":[{"type":"heading","content":["Dom över orättfärdiga ledare"]},{"type":"verse","number":1,"content":[{"text":"En psalm av Asaf.","descriptive":true},{"lineBreak":true},{"text":"Gud står i gudaförsamlingen","poem":1},{"noteId":247},{"text":",","poem":1},{"text":"bland gudarna håller han dom:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"\"Hur länge ska ni döma orätt","poem":1},{"text":"och ta de gudlösas parti? Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Skipa rätt för den svage","poem":1},{"text":"och faderlöse,","poem":3},{"text":"ge den förtryckte","poem":2},{"text":"och fattige rättvisa!","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Befria den svage och fattige,","poem":1},{"text":"rädda honom","poem":2},{"text":"från de gudlösas hand!\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"De vet inget och förstår inget,","poem":1},{"text":"de vandrar i mörker.","poem":2},{"text":"Jordens alla grundvalar vacklar.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"\"Jag har sagt att ni är gudar,","poem":1},{"text":"att ni alla är den Högstes söner.","poem":2},{"noteId":248}]},{"type":"verse","number":7,"content":[{"text":"Men ni kommer att dö","poem":1},{"text":"som människor dör","poem":3},{"text":"och falla som alla furstar faller.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Grip in, Gud!","poem":1},{"text":"Håll dom över jorden,","poem":2},{"text":"för alla folk är din egendom.","poem":3}]}],"footnotes":[{"noteId":247,"caller":"-","text":"gudaförsamlingenAnnan översättning: \"Guds församling\". Domare kunde kallas \"gudar\" på grund av sitt gudomliga uppdrag i rättvisans tjänst (jfr Joh 10:35).","reference":{"chapter":82,"verse":1}},{"noteId":248,"caller":"-","text":"Citeras av Jesus i Joh 10:34.","reference":{"chapter":82,"verse":6}}]},"thisChapterLink":"/api/swe_fol/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}