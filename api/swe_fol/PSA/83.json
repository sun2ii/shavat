{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":83,"content":[{"type":"heading","content":["Hjälp mot Guds folks fiender"]},{"type":"verse","number":1,"content":[{"text":"En sång, en psalm av Asaf.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Gud, var inte tyst,","poem":1},{"text":"var inte stilla och stum, Gud!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Se, dina fiender larmar","poem":1},{"text":"och de som hatar dig","poem":2},{"text":"höjer sina huvuden.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"De smider listiga planer","poem":1},{"text":"mot ditt folk,","poem":3},{"text":"de rådslår mot dem du beskyddar,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"de säger: \"Kom,","poem":1},{"text":"vi utrotar dem som folk","poem":3},{"text":"så att ingen mer minns","poem":2},{"text":"Israels namn!\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Enigt rådslår de med varandra,","poem":1},{"text":"de sluter förbund mot dig:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Edoms tält och ismaeliterna,","poem":1},{"noteId":249},{"text":"Moab och hagariterna,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gebal, Ammon och Amalek,","poem":1},{"text":"filisteerna och Tyrus invånare.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Även Assur ansluter sig till dem,","poem":1},{"text":"han lånar sin arm åt Lots barn. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gör med dem som med Midjan,","poem":1},{"text":"som med Sisera och Jabin","poem":2},{"noteId":250},{"text":"vid Kishons bäck","poem":3}]},{"type":"verse","number":11,"content":[{"text":"när de förgjordes vid En-Dor","poem":1},{"text":"och blev till gödsel på marken.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Låt det gå deras stormän","poem":1},{"text":"som Oreb och Seeb,","poem":3},{"text":"och alla deras furstar","poem":2},{"text":"som Seba och Salmunna,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"eftersom de säger:","poem":1},{"text":"\"Vi ska ta över Guds betesmarker!\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Min Gud,","poem":1},{"text":"låt dem bli som virvlande löv,","poem":2},{"text":"som agnar för vinden!","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Som elden slukar skog","poem":1},{"text":"och lågan sveder berg,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"så ska du jaga dem","poem":1},{"text":"med din storm","poem":3},{"text":"och skräckslå dem","poem":2},{"text":"med ditt oväder.","poem":3}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Fyll deras ansikten med skam","poem":1},{"text":"så att de söker ditt namn, Herre.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"De ska skämmas","poem":1},{"text":"i skräck till evig tid,","poem":3},{"text":"de ska skämmas och gå under.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Låt dem veta att du ensam","poem":1},{"text":"bär namnet Herren,","poem":2},{"text":"den Högste över hela jorden.","poem":3}]}],"footnotes":[{"noteId":249,"caller":"-","text":"De uppräknade folken omgav Israel från alla håll. Assur i nuvarande Irak var dåtidens stormakt.","reference":{"chapter":83,"verse":7}},{"noteId":250,"caller":"-","text":"Midjan … Sisera och Jabin … Oreb och Seeb … Seba och SalmunnaHedniska erövrare under domartiden (se Dom 4-8).","reference":{"chapter":83,"verse":10}}]},"thisChapterLink":"/api/swe_fol/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}