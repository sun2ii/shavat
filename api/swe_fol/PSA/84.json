{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":84,"content":[{"type":"heading","content":["Längtan till Guds hus"]},{"type":"verse","number":1,"content":[{"text":"För körledaren, till gittít","descriptive":true},{"noteId":251},{"text":". En psalm av Koras söner.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Hur ljuvliga är inte dina boningar,","poem":1},{"text":"Herre Sebaot!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Min själ längtar och trängtar","poem":1},{"text":"till Herrens gårdar,","poem":3},{"text":"min själ och min kropp jublar","poem":2},{"text":"mot levande Gud.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sparven har funnit sig ett hem","poem":1},{"text":"och svalan ett bo","poem":2},{"text":"där hon kan lägga sina ungar:","poem":3},{"text":"dina altaren, Herre Sebaot,","poem":2},{"text":"min kung och min Gud.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Saliga är de som bor i ditt hus,","poem":1},{"text":"de lovar dig ständigt. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Saliga är de","poem":1},{"text":"som har sin styrka i dig,","poem":2},{"text":"som har dina vägar i sitt hjärta.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"När de vandrar genom tåredalen","poem":1},{"noteId":252},{"text":"gör de den rik på källor,","poem":3},{"text":"och höstregnet","poem":2},{"noteId":253},{"text":"täcker den","poem":2},{"text":"med välsignelser.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"De går från kraft till kraft,","poem":1},{"text":"de träder fram inför Gud på Sion.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Herre Gud Sebaot, hör min bön,","poem":1},{"text":"lyssna, du Jakobs Gud! Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Gud, se vår sköld,","poem":1},{"text":"se på din smordes ansikte!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"En dag i dina gårdar","poem":1},{"text":"är bättre än tusen andra.","poem":3},{"text":"Jag vill hellre vakta dörren","poem":2},{"noteId":254},{"text":"i min Guds hus","poem":3},{"text":"än bo i de gudlösas tält,","poem":4}]},{"type":"verse","number":12,"content":[{"text":"för Herren Gud är sol och sköld,","poem":1},{"text":"Herren ger nåd och ära.","poem":3},{"text":"Inget gott nekar han dem","poem":2},{"text":"som vandrar i fullkomlighet.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Herre Sebaot,","poem":1},{"text":"salig är den som förtröstar på dig.","poem":2}]}],"footnotes":[{"noteId":251,"caller":"-","text":"gittítKan syfta på sångstil eller instrument från staden Gat, där David bodde en tid. Hebr. gatbetyder också \"vinpress\" (så Septuaginta).","reference":{"chapter":84,"verse":1}},{"noteId":252,"caller":"-","text":"tåredalenAnnan översättning: \"Bakadalen\" (strax utanför Jerusalem, se 2 Sam 5:22f).","reference":{"chapter":84,"verse":7}},{"noteId":253,"caller":"-","text":"höstregnetAnnan översättning: \"Läraren\" eller \"Lagstiftaren\" (så Septuaginta).","reference":{"chapter":84,"verse":7}},{"noteId":254,"caller":"-","text":"vakta dörrenAnnan översättning: \"stå vid tröskeln\".","reference":{"chapter":84,"verse":11}}]},"thisChapterLink":"/api/swe_fol/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":13}