{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":85,"content":[{"type":"heading","content":["Bön om ny nåd för Herrens folk"]},{"type":"verse","number":1,"content":[{"text":"För körledaren. En psalm av Koras söner.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, förr var du nådig","poem":1},{"text":"mot ditt land,","poem":3},{"text":"du gjorde slut på Jakobs","poem":2},{"text":"fångenskap.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Du förlät ditt folks skuld,","poem":1},{"text":"du övertäckte all deras synd.","poem":2},{"text":"Sela","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Du drog tillbaka all din vrede,","poem":1},{"text":"du vände dig bort","poem":2},{"text":"från din vredesglöd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Upprätta oss","poem":1},{"noteId":255},{"text":"igen,","poem":1},{"text":"du vår frälsnings Gud,","poem":3},{"text":"upphör med din harm mot oss!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tänker du vredgas på oss","poem":1},{"text":"för alltid,","poem":3},{"text":"ska din vrede fortsätta","poem":2},{"text":"från släkte till släkte?","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Vill du inte ge oss liv igen,","poem":1},{"text":"så att ditt folk får glädjas i dig?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Herre, visa oss din nåd","poem":1},{"text":"och ge oss din frälsning!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Jag vill höra","poem":1},{"text":"vad Gud, Herren, talar.","poem":3},{"text":"Han talar frid till sitt folk,","poem":2},{"text":"till sina trogna,","poem":3},{"text":"men de får inte gå tillbaka","poem":2},{"text":"till dårskap.","poem":3},{"noteId":256}]},{"type":"verse","number":10,"content":[{"text":"Ja, hans frälsning är nära dem","poem":1},{"text":"som vördar honom,","poem":3},{"text":"för att härlighet ska bo","poem":2},{"text":"i vårt land.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nåd och sanning ska mötas,","poem":1},{"text":"rättfärdighet och frid","poem":2},{"text":"ska kyssas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Sanning ska växa upp ur jorden","poem":1},{"text":"och rättfärdighet blicka ner","poem":2},{"text":"från himlen.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Herren ska ge det som är gott,","poem":1},{"text":"och vårt land ska ge sin gröda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Rättfärdighet ska gå före honom","poem":1},{"text":"och bana väg för hans steg.","poem":2}]}],"footnotes":[{"noteId":255,"caller":"-","text":"Upprätta ossAnnan översättning (så Septuaginta): \"Omvänd oss\".","reference":{"chapter":85,"verse":5}},{"noteId":256,"caller":"-","text":"men de får inte gå tillbaka till dårskapAndra handskrifter (Septuaginta): \"till dem som vänder sitt hjärta till honom\".","reference":{"chapter":85,"verse":9}}]},"thisChapterLink":"/api/swe_fol/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":14}