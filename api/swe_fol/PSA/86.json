{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":86,"content":[{"type":"heading","content":["Bön om hjälp i svår nöd"]},{"type":"verse","number":1,"content":[{"text":"En bön av David.","descriptive":true},{"lineBreak":true},{"text":"Herre, vänd ditt öra till mig","poem":1},{"text":"och svara mig,","poem":3},{"text":"för jag är svag och fattig.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bevara min själ,","poem":1},{"text":"för jag är trogen.","poem":3},{"text":"Du är min Gud,","poem":2},{"text":"fräls din tjänare som litar på dig.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Förbarma dig över mig, Herre,","poem":1},{"text":"för jag ropar till dig dagen lång.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Gläd din tjänares själ,","poem":1},{"text":"för till dig, Herre, lyfter jag min själ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Du, Herre, är god och förlåtande,","poem":1},{"text":"stor i nåd mot alla","poem":2},{"text":"som ropar till dig.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Herre, hör min bön,","poem":1},{"text":"lyssna till mitt rop om nåd!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Jag ropar till dig på nödens dag,","poem":1},{"text":"för du kommer att svara mig.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ingen bland gudarna","poem":1},{"text":"är som du, Herre,","poem":3},{"text":"inga gärningar är som dina.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alla folk som du har gjort","poem":1},{"text":"ska komma och tillbe","poem":2},{"text":"inför dig, Herre.","poem":3},{"text":"De ska ära ditt namn,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"för du är stor och du gör under.","poem":1},{"text":"Du ensam är Gud.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Visa mig, Herre, din väg,","poem":1},{"text":"jag vill vandra i din sanning.","poem":3},{"text":"Ge mig ett odelat hjärta","poem":2},{"text":"så att jag vördar ditt namn.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Jag vill tacka dig, Herre min Gud,","poem":1},{"text":"av hela mitt hjärta","poem":3},{"text":"och ära ditt namn i evighet,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"för din nåd över mig är stor,","poem":1},{"text":"du räddar min själ","poem":2},{"text":"ur dödsrikets djup.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Gud, de fräcka reser sig mot mig,","poem":1},{"text":"en flock av våldsmän","poem":2},{"text":"vill ta mitt liv.","poem":3},{"text":"De har inte dig för ögonen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Men du, Herre,","poem":1},{"text":"är en barmhärtig och nådig Gud,","poem":3},{"text":"sen till vrede","poem":2},{"text":"och stor i nåd och sanning.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Vänd dig till mig","poem":1},{"text":"och förbarma dig över mig.","poem":3},{"text":"Ge din makt till din tjänare","poem":2},{"text":"och fräls din tjänarinnas son!","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Ge mig ett tecken på din godhet,","poem":1},{"text":"låt dem som hatar mig se det","poem":2},{"text":"och skämmas,","poem":3},{"text":"för du, Herre, hjälper","poem":2},{"text":"och tröstar mig.","poem":3}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}