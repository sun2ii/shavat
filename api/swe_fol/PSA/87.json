{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":87,"content":[{"type":"heading","content":["Staden där folken föds på nytt"]},{"type":"verse","number":1,"content":[{"text":"En psalm, en sång av Koras söner.","descriptive":true},{"lineBreak":true},{"text":"Han har grundat sin stad","poem":1},{"text":"på de heliga bergen.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Herren älskar Sions portar","poem":1},{"text":"mest av alla Jakobs boningar.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Härliga ting har sagts om dig,","poem":1},{"text":"Guds stad. Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"\"Jag ska räkna Rahab","poem":1},{"noteId":257},{"text":"och Babel","poem":1},{"text":"bland mina bekännare,","poem":3},{"text":"Filisteen och Tyrus","poem":2},{"text":"tillsammans med Kush","poem":3},{"noteId":258},{"text":".","poem":3},{"text":"De är födda där.\"","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Om Sion ska det sägas:","poem":1},{"text":"\"Den och den är född där.\"","poem":3},{"text":"Och han, den Högste,","poem":2},{"text":"håller det vid makt.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"När Herren upptecknar folken","poem":1},{"text":"ska han räkna så:","poem":3},{"text":"\"De är födda där.\" Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Under sång och dans ska man säga:","poem":1},{"text":"\"Alla mina källor har jag i dig.\"","poem":2}]}],"footnotes":[{"noteId":257,"caller":"-","text":"RahabPoetiskt namn för Egypten (jfr Jes 30:7).","reference":{"chapter":87,"verse":4}},{"noteId":258,"caller":"-","text":"Babel … Filisteen … Tyrus … KushOmråden i nuvarande Irak, Gaza, Libanon och Sudan.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/swe_fol/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}