{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":88,"content":[{"type":"heading","content":["Klagan i djupaste nöd"]},{"type":"verse","number":1,"content":[{"text":"En sång, en psalm av Koras söner. För körledaren, till mahalát-leannót","descriptive":true},{"noteId":259},{"text":". En vishetspsalm av esraiten Heman.","descriptive":true},{"noteId":260}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Herre, min frälsnings Gud,","poem":1},{"text":"dag och natt ropar jag till dig.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Låt min bön komma","poem":1},{"text":"inför ditt ansikte,","poem":3},{"text":"vänd ditt öra till mitt rop,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"för min själ är mättad med lidanden","poem":1},{"text":"och mitt liv närmar sig dödsriket.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Jag räknas bland dem","poem":1},{"text":"som går ner i graven,","poem":3},{"text":"jag är som en man utan livskraft.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Jag är övergiven bland de döda,","poem":1},{"text":"likt de fallna som ligger i graven,","poem":3},{"text":"dem du inte längre tänker på","poem":2},{"text":"och som inte mer","poem":3},{"text":"är i dina händer.","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Du har sänkt mig längst ner i hålan,","poem":1},{"text":"ner i mörkret, ner i djupet.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Din vrede vilar tung över mig,","poem":1},{"text":"alla dina böljor låter du","poem":2},{"text":"skölja över mig. Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Du har fjärmat mina förtrogna","poem":1},{"text":"från mig,","poem":3},{"text":"du har gjort mig vidrig för dem,","poem":2},{"text":"fångad så att jag inte kommer ut.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Mitt öga förtärs av lidande.","poem":1},{"text":"Herre, jag ropar till dig varje dag,","poem":2},{"text":"jag sträcker mina händer","poem":3},{"text":"mot dig.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Gör du under för de döda,","poem":1},{"text":"kan skuggorna resa sig","poem":2},{"text":"och tacka dig? Sela","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Förkunnar man din nåd i graven,","poem":1},{"text":"din trofasthet i avgrunden?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Känner man dina under i mörkret,","poem":1},{"text":"din rättfärdighet i glömskans land?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Men jag ropar till dig, Herre,","poem":1},{"text":"om morgonen möter dig min bön.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Varför, Herre,","poem":1},{"text":"förkastar du min själ?","poem":3},{"text":"Varför döljer du","poem":2},{"text":"ditt ansikte för mig?","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Plågad är jag och döende","poem":1},{"text":"från min ungdom,","poem":3},{"text":"jag bär förskräckelser från dig","poem":2},{"text":"och förtvivlar.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Din vredes lågor sveper över mig,","poem":1},{"text":"dina fasor förgör mig.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ständigt omsluter de mig","poem":1},{"text":"som vatten,","poem":3},{"text":"omringar mig helt och hållet.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mina nära och kära","poem":1},{"text":"har du fjärmat från mig.","poem":3},{"text":"I mina förtrognas ställe","poem":2},{"text":"har jag bara mörker.","poem":3}]}],"footnotes":[{"noteId":259,"caller":"-","text":"mahalát-leannótTroligen en musikterm, en melodi eller ett musikinstrument. Möjliga översättningar: \"plågsam sjukdom\" eller \"dans och sång\".","reference":{"chapter":88,"verse":1}},{"noteId":260,"caller":"-","text":"esraiten HemanBerömd vis man på Salomos tid (1 Kung 4:31), troligen identisk med Davids lovsångsledare (1 Krön 16:41).","reference":{"chapter":88,"verse":1}}]},"thisChapterLink":"/api/swe_fol/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":19}