{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":89,"content":[{"type":"heading","content":["Herrens löfte till David"]},{"type":"verse","number":1,"content":[{"text":"En vishetspsalm av esraiten Etan.","descriptive":true},{"noteId":261}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Jag vill sjunga om Herrens","poem":1},{"text":"nådegärningar för evigt,","poem":3},{"text":"med min mun","poem":2},{"text":"förkunna din trofasthet","poem":3},{"text":"från släkte till släkte.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"Jag säger:","poem":1},{"text":"För evigt är din nåd befäst,","poem":3},{"text":"i himlen är din trofasthet","poem":2},{"text":"grundad.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"\"Jag har slutit förbund","poem":1},{"text":"med min utvalde,","poem":3},{"text":"gett min ed till min tjänare David:","poem":2},{"noteId":262}]},{"type":"verse","number":5,"content":[{"text":"Jag ska låta din ätt bestå för evigt","poem":1},{"text":"och bygga din tron","poem":2},{"text":"från släkte till släkte.\" Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Himlarna prisar dina under, Herre,","poem":1},{"text":"och din trofasthet","poem":2},{"text":"i de heligas församling.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Vem i skyn kan jämföras","poem":1},{"text":"med Herren?","poem":3},{"text":"Vem bland Guds söner kan liknas","poem":2},{"text":"vid Herren?","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Gud är fruktad i de heligas råd,","poem":1},{"text":"stor och mer vördad","poem":2},{"text":"än alla omkring honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Herre Gud Sebaot,","poem":1},{"text":"vem är som du?","poem":3},{"text":"Stark är du, Herre,","poem":2},{"text":"och din trofasthet omger dig.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Du råder över det stolta havet,","poem":1},{"text":"när dess vågor reser sig","poem":2},{"text":"stillar du dem.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Du krossade Rahab som en slagen,","poem":1},{"text":"du skingrade dina fiender","poem":2},{"text":"med din mäktiga arm.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Din är himlen,","poem":1},{"text":"din är också jorden.","poem":3},{"text":"Du har grundat världen","poem":2},{"text":"med allt vad den rymmer.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Nord och syd har du skapat,","poem":1},{"text":"Tabor och Hermon","poem":2},{"text":"jublar i ditt namn.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Du har en arm med kraft,","poem":1},{"text":"din hand är mäktig,","poem":2},{"text":"din högra hand är upphöjd.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Rätt och rättfärdighet","poem":1},{"text":"är grunden för din tron,","poem":3},{"text":"nåd och sanning","poem":2},{"text":"står inför ditt ansikte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Saligt är det folk","poem":1},{"text":"som vet vad jubel är!","poem":3},{"text":"Herre, de vandrar","poem":2},{"text":"i ditt ansiktes ljus.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"I ditt namn jublar de ständigt,","poem":1},{"text":"i din rättfärdighet upphöjs de,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"för du är deras styrka","poem":1},{"text":"och härlighet,","poem":3},{"text":"i din nåd upphöjer du vårt horn.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ja, vår sköld tillhör Herren,","poem":1},{"text":"vår kung tillhör Israels Helige.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Du talade en gång i en syn","poem":1},{"text":"till dina trogna och sade:","poem":3},{"text":"\"Jag har sänt hjälp","poem":2},{"text":"genom en hjälte,","poem":3},{"text":"jag har upphöjt en yngling","poem":2},{"noteId":263},{"text":"ur folket.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Jag har funnit min tjänare David","poem":1},{"text":"och smort honom","poem":2},{"text":"med min heliga olja.","poem":3}]},{"type":"verse","number":22,"content":[{"text":"Min hand ska stödja honom,","poem":1},{"text":"min arm ska styrka honom.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ingen fiende ska plundra honom,","poem":1},{"text":"ingen orättfärdig","poem":2},{"text":"ska förtrycka honom.","poem":3}]},{"type":"verse","number":24,"content":[{"text":"Jag ska krossa hans fiender","poem":1},{"text":"framför honom","poem":3},{"text":"och slå ner dem","poem":2},{"text":"som hatar honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Min trofasthet och nåd","poem":1},{"text":"ska vara med honom,","poem":3},{"text":"i mitt namn ska hans horn","poem":2},{"text":"bli upphöjt.","poem":3}]},{"type":"verse","number":26,"content":[{"text":"Jag ska lägga havet","poem":1},{"text":"under hans hand,","poem":3},{"text":"floderna under hans högra hand.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Han ska ropa till mig:","poem":1},{"text":"\"Du är min Far, min Gud","poem":2},{"text":"och min frälsnings klippa!\"","poem":3}]},{"type":"verse","number":28,"content":[{"text":"Jag ska göra honom","poem":1},{"text":"till den förstfödde,","poem":3},{"text":"till den högste","poem":2},{"text":"bland","poem":3},{"noteId":264},{"text":"kungarna på jorden.","poem":3}]},{"type":"verse","number":29,"content":[{"text":"Jag ska bevara min nåd","poem":1},{"text":"mot honom för evigt,","poem":3},{"text":"mitt förbund med honom","poem":2},{"text":"ska stå fast.","poem":3}]},{"type":"verse","number":30,"content":[{"text":"Jag ska låta hans ätt","poem":1},{"noteId":265},{"text":"bestå i evighet","poem":3},{"text":"och hans tron","poem":2},{"text":"så länge himlen är till.","poem":3}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Om hans barn överger","poem":1},{"text":"min undervisning","poem":3},{"text":"och inte följer mina befallningar,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"om de bryter mina lagar","poem":1},{"text":"och inte håller mina bud,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"då ska jag straffa deras brott med ris","poem":1},{"text":"och deras synd med plågor.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Men min nåd","poem":1},{"text":"ska jag inte ta ifrån honom,","poem":3},{"text":"jag ska inte svika min trofasthet.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Jag ska inte bryta mitt förbund,","poem":1},{"text":"det mina läppar har sagt","poem":2},{"text":"ska jag inte ändra.","poem":3}]},{"type":"verse","number":36,"content":[{"text":"En gång för alla","poem":1},{"text":"har jag svurit vid min helighet,","poem":3},{"text":"jag sviker inte David:","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Hans ätt ska bestå för evigt","poem":1},{"text":"och hans tron som solen inför mig,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"den ska bestå som månen","poem":1},{"text":"i evigheters evighet.","poem":3},{"text":"Och vittnet i skyn är trofast.\" Sela","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Men nu har du förkastat","poem":1},{"text":"och förskjutit din smorde.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Du har upplöst förbundet","poem":1},{"text":"med din tjänare,","poem":3},{"text":"du har vanärat hans krona","poem":2},{"text":"och kastat den till marken.","poem":3}]},{"type":"verse","number":41,"content":[{"text":"Du har rivit alla hans murar","poem":1},{"text":"och lagt hans borgar i ruiner.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Alla som passerar på vägen","poem":1},{"text":"plundrar honom,","poem":3},{"text":"han blir hånad av sina grannar.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Du lyfte hans motståndares","poem":1},{"text":"högra hand,","poem":3},{"text":"du lät hans fiender jubla.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Du lät hans skarpa svärd ge vika","poem":1},{"text":"och stödde honom inte i striden.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Du har gjort slut på hans glans","poem":1},{"text":"och slagit hans tron till jorden.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Du har förkortat","poem":1},{"text":"hans ungdoms dagar,","poem":3},{"text":"du har täckt honom med skam.","poem":2},{"text":"Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Hur länge, Herre,","poem":1},{"text":"ska du hålla dig helt dold?","poem":3},{"text":"Hur länge ska din vrede","poem":2},{"text":"brinna som eld?","poem":3}]},{"type":"verse","number":48,"content":[{"text":"Tänk på hur kort mitt liv är,","poem":1},{"text":"hur förgängliga","poem":2},{"noteId":266},{"text":"du skapat","poem":2},{"text":"alla människors barn.","poem":3}]},{"type":"verse","number":49,"content":[{"text":"Vem kan leva och slippa se döden,","poem":1},{"text":"vem kan rädda sin själ","poem":2},{"text":"från dödsrikets våld? Sela","poem":3}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"Herre, var är dina nådegärningar","poem":1},{"text":"från förr","poem":3},{"text":"som du lovade David med ed","poem":2},{"text":"i din trofasthet?","poem":3}]},{"type":"verse","number":51,"content":[{"text":"Herre, tänk på dina tjänares","poem":1},{"noteId":267},{"text":"vanära,","poem":1},{"text":"vad jag bär inom mig","poem":2},{"text":"från de många folken,","poem":3}]},{"type":"verse","number":52,"content":[{"text":"hur dina fiender hånar, Herre,","poem":1},{"text":"hur de hånar din smordes fotspår.","poem":2}]},{"type":"heading","content":["__"]},{"type":"line_break"},{"type":"verse","number":53,"content":[{"text":"Välsignad är Herren i evighet!","poem":1},{"text":"Amen, amen.","poem":2}]}],"footnotes":[{"noteId":261,"caller":"-","text":"esraiten EtanBerömd vis man på Salomos tid (1 Kung 4:31), troligen identisk med Davids siare och lovsångsledare (1 Krön 6:44).","reference":{"chapter":89,"verse":1}},{"noteId":262,"caller":"-","text":"Psalmisten citerar i vers 4-5 Guds löfte (jfr 2 Sam 7:12, Ps 132:11f).","reference":{"chapter":89,"verse":4}},{"noteId":263,"caller":"-","text":"ynglingAnnan översättning: \"utvald\".","reference":{"chapter":89,"verse":20}},{"noteId":264,"caller":"-","text":"blandAnnan översättning: \"för\".","reference":{"chapter":89,"verse":28}},{"noteId":265,"caller":"-","text":"ättAnnan översättning: \"ättling\" (alltså Messias, Davids son). Även i vers 37.","reference":{"chapter":89,"verse":30}},{"noteId":266,"caller":"-","text":"hur förgängligaAnnan översättning: \"till vilken tomhet\".","reference":{"chapter":89,"verse":48}},{"noteId":267,"caller":"-","text":"dina tjänaresAndra handskrifter: \"din tjänares\".","reference":{"chapter":89,"verse":51}}]},"thisChapterLink":"/api/swe_fol/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":53}