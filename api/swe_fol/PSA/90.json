{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":90,"content":[{"type":"heading","content":["Guds evighet och vår förgänglighet"]},{"type":"verse","number":1,"content":[{"text":"En bön av gudsmannen Mose.","descriptive":true},{"lineBreak":true},{"text":"Herre, du har varit vår tillflykt","poem":1},{"noteId":268},{"text":"från släkte till släkte.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Innan bergen blev till","poem":1},{"text":"och du skapade jorden och världen,","poem":2},{"text":"från evighet till evighet är du,","poem":3},{"text":"Gud.","poem":4}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Du låter människan","poem":1},{"text":"vända åter till stoft,","poem":3},{"text":"du säger: \"Vänd om,","poem":2},{"text":"ni människors","poem":3},{"noteId":269},{"text":"barn!\"","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Tusen år är i dina ögon","poem":1},{"text":"som dagen i går som försvann,","poem":2},{"text":"som en av nattens timmar","poem":3},{"noteId":270},{"text":".","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Du sköljer bort dem,","poem":1},{"text":"de är som en sömn.","poem":3},{"text":"Om morgonen gror de som gräset,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"om morgonen gror det och blomstrar,","poem":1},{"text":"mot kvällen vissnar det och torkar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Vi går under genom din vrede,","poem":1},{"text":"förskräckta av din glöd.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Du ställer våra synder inför dig,","poem":1},{"text":"våra hemligheter","poem":2},{"text":"i ditt ansiktes ljus.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Alla våra dagar försvinner","poem":1},{"text":"genom din vrede,","poem":3},{"text":"vi slutar våra år som en suck.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vårt liv varar sjuttio år,","poem":1},{"text":"eller åttio om krafterna räcker.","poem":3},{"text":"När det är som bäst","poem":2},{"text":"är det möda och bekymmer.","poem":3},{"text":"Snart är det slut och vi flyger bort.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Vem känner din vredes kraft","poem":1},{"text":"och din harm","poem":3},{"text":"så att han fruktar dig?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lär oss att våra dagar är räknade,","poem":1},{"text":"så att vi får visa hjärtan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kom tillbaka, Herre!","poem":1},{"text":"Hur länge dröjer du?","poem":3},{"text":"Förbarma dig över dina tjänare!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mätta oss med din nåd","poem":1},{"text":"när morgonen gryr,","poem":3},{"text":"så att vi får jubla och glädjas","poem":2},{"text":"i alla våra dagar.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Gläd oss lika många dagar","poem":1},{"text":"som du plågat oss,","poem":3},{"text":"lika många år","poem":2},{"text":"som vi sett det onda.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Låt din gärning bli synlig","poem":1},{"text":"för dina tjänare","poem":3},{"text":"och din härlighet över deras barn,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"och låt Herren vår Guds ljuvlighet","poem":1},{"text":"vila över oss.","poem":3},{"text":"Ge oss framgång","poem":2},{"text":"med våra händers verk,","poem":3},{"text":"ja, ge framgång","poem":2},{"text":"åt våra händers verk.","poem":3}]}],"footnotes":[{"noteId":268,"caller":"-","text":"tillflyktAnnan översättning: \"boning\".","reference":{"chapter":90,"verse":1}},{"noteId":269,"caller":"-","text":"människorsAnnan översättning: \"Adams\".","reference":{"chapter":90,"verse":3}},{"noteId":270,"caller":"-","text":"en av nattens timmarOrdagrant: \"en nattväkt\" (tretimmarsperiod, se not till Matt 24:43).","reference":{"chapter":90,"verse":4}}]},"thisChapterLink":"/api/swe_fol/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}