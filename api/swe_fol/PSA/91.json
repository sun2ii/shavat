{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":91,"content":[{"type":"heading","content":["Under den Högstes beskydd"]},{"type":"verse","number":1,"content":[{"text":"Den som sitter","poem":1},{"text":"under den Högstes beskydd","poem":3},{"text":"och vilar","poem":2},{"text":"under den Allsmäktiges skugga,","poem":3}]},{"type":"verse","number":2,"content":[{"text":"han säger till Herren:","poem":1},{"text":"\"Min tillflykt och min borg,","poem":2},{"text":"min Gud som jag litar på.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Han ska rädda dig","poem":1},{"text":"från jägarens snara","poem":2},{"text":"och den härjande pesten.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Med sina fjädrar täcker han dig,","poem":1},{"text":"under hans vingar","poem":2},{"text":"finner du tillflykt.","poem":3},{"text":"Hans trofasthet är sköld och skärm.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Du ska inte frukta nattens fasor,","poem":1},{"text":"inte pilen som flyger om dagen,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"inte pesten som smyger i mörkret","poem":1},{"text":"eller sjukdomen som härjar","poem":2},{"text":"mitt på dagen.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Tusen kan falla vid din sida,","poem":1},{"text":"tiotusen vid din högra sida,","poem":3},{"text":"men dig drabbar det inte.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Du ska bara se det med egna ögon,","poem":1},{"text":"bevittna hur de gudlösa","poem":2},{"text":"får sitt straff.","poem":3}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Du har sagt att Herren","poem":1},{"text":"är ditt skydd,","poem":3},{"text":"du har gjort den Högste","poem":2},{"text":"till din tillflykt.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Inget ont ska drabba dig,","poem":1},{"text":"ingen plåga närma sig din hydda,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"för han ska befalla sina änglar","poem":1},{"text":"att bevara dig på alla dina vägar.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"De ska bära dig på sina händer","poem":1},{"text":"så att du inte stöter din fot","poem":2},{"text":"mot någon sten.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Du ska gå fram","poem":1},{"text":"över lejon och huggormar,","poem":3},{"text":"trampa på unga lejon","poem":2},{"text":"och drakar","poem":3},{"noteId":271},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"\"Han älskar","poem":1},{"noteId":272},{"text":"mig,","poem":1},{"text":"därför ska jag befria honom,","poem":3},{"text":"och jag ska beskydda honom","poem":2},{"text":"eftersom han känner mitt namn.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Han ropar till mig","poem":1},{"text":"och jag svarar honom.","poem":3},{"text":"Jag är med honom i nöden,","poem":2},{"text":"jag ska rädda honom","poem":3},{"text":"och ge honom ära.","poem":4}]},{"type":"verse","number":16,"content":[{"text":"Jag ska mätta honom med långt liv","poem":1},{"text":"och låta honom se min frälsning.\"","poem":2}]}],"footnotes":[{"noteId":271,"caller":"-","text":"drakarAnnan översättning: \"ormar\".","reference":{"chapter":91,"verse":13}},{"noteId":272,"caller":"-","text":"älskarAnnan översättning: \"håller sig nära\".","reference":{"chapter":91,"verse":14}}]},"thisChapterLink":"/api/swe_fol/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}