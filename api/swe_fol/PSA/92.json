{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":92,"content":[{"type":"heading","content":["Glädje över Herrens gärningar"]},{"type":"verse","number":1,"content":[{"text":"En psalm, en sång för sabbatsdagen.","descriptive":true}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Det är gott att tacka Herren","poem":1},{"text":"och att lovsjunga ditt namn,","poem":2},{"text":"du den Högste,","poem":3}]},{"type":"verse","number":3,"content":[{"text":"att på morgonen förkunna din nåd","poem":1},{"text":"och om natten din trofasthet,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"med tiosträngad lyra och luta,","poem":1},{"text":"med klingande","poem":2},{"noteId":273},{"text":"toner på harpan.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Du gläder mig, Herre,","poem":1},{"text":"med dina gärningar,","poem":3},{"text":"jag jublar över dina händers verk.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hur stora är inte dina verk, Herre,","poem":1},{"text":"hur djupa dina tankar!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"En oförnuftig man förstår det inte,","poem":1},{"text":"dåren fattar det inte.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"När de gudlösa grönskar som gräs","poem":1},{"text":"och alla förbrytare blomstrar,","poem":2},{"text":"går de ändå mot evig","poem":3},{"text":"undergång.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Men du, Herre,","poem":1},{"text":"är den Högste för evigt.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Se dina fiender, Herre,","poem":1},{"text":"se, dina fiender ska förgås,","poem":2},{"text":"alla förbrytare skingras!","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Men mitt horn höjer du","poem":1},{"text":"som vildoxens,","poem":3},{"text":"jag är överöst med frisk olja.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mina ögon får se","poem":1},{"text":"mina förföljare falla,","poem":3},{"text":"mina öron får höra om de onda","poem":2},{"text":"som reste sig mot mig.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"De rättfärdiga grönskar som palmer,","poem":1},{"text":"de växer som cedrar på Libanon,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"planterade i Herrens hus,","poem":1},{"text":"grönskande på vår Guds förgårdar.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Även vid hög ålder bär de frukt","poem":1},{"noteId":274},{"text":",","poem":1},{"text":"de frodas och grönskar","poem":2}]},{"type":"verse","number":16,"content":[{"text":"för att förkunna att Herren,","poem":1},{"text":"min klippa, är rättfärdig.","poem":2},{"text":"Ingen orätt finns i honom.","poem":3}]}],"footnotes":[{"noteId":273,"caller":"-","text":"klingandeAnnan översättning: \"tankfulla\" (hebr. higgajón, jfr Ps 9:17 med not).","reference":{"chapter":92,"verse":4}},{"noteId":274,"caller":"-","text":"bär de fruktAnnan översättning: \"skjuter de skott\".","reference":{"chapter":92,"verse":15}}]},"thisChapterLink":"/api/swe_fol/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":16}