{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":94,"content":[{"type":"heading","content":["Bön om Herrens hjälp mot fiender"]},{"type":"verse","number":1,"content":[{"text":"Hämndens Gud, Herre,","poem":1},{"text":"hämndens Gud, visa dig!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Res dig, du jordens domare,","poem":1},{"text":"ge de stolta vad de förtjänar!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hur länge ska de gudlösa, Herre,","poem":1},{"text":"hur länge ska de gudlösa","poem":2},{"text":"triumfera?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Deras tal flödar av fräckhet,","poem":1},{"text":"alla förbrytare förhäver sig.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Herre, de krossar ditt folk,","poem":1},{"text":"de förtrycker din arvedel,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"de dödar änkor och främlingar","poem":1},{"text":"och mördar de faderlösa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"och de säger:","poem":1},{"text":"\"Herren ser det inte,","poem":2},{"text":"Jakobs Gud märker det inte.\"","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Fatta, ni oförnuftiga bland folket!","poem":1},{"text":"Dårar, när ska ni bli kloka?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Han som har planterat örat,","poem":1},{"text":"skulle han inte höra?","poem":3},{"text":"Han som format ögat,","poem":2},{"text":"skulle han inte se?","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Han som fostrar folken,","poem":1},{"text":"skulle han inte straffa,","poem":3},{"text":"han som lär människan förstånd?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Herren känner","poem":1},{"text":"människornas tankar,","poem":3},{"text":"han vet att de är tomhet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Salig är den som du, Herre,","poem":1},{"text":"fostrar och lär från din lag","poem":2}]},{"type":"verse","number":13,"content":[{"text":"för att ge honom ro","poem":1},{"text":"från onda dagar","poem":3},{"text":"tills graven är grävd","poem":2},{"text":"för de gudlösa.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Herren förskjuter inte sitt folk,","poem":1},{"text":"han överger inte sin arvedel.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Rättvisa ska åter gälla i rätten,","poem":1},{"text":"och alla som har ärliga hjärtan","poem":2},{"text":"ska följa den","poem":3},{"noteId":275},{"text":".","poem":3}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Vem står upp för mig mot de onda?","poem":1},{"text":"Vem hjälper mig mot förbrytarna?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Om inte Herren var min hjälp","poem":1},{"text":"skulle min själ snart bo i det tysta.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"När jag säger: \"Min fot vacklar\",","poem":1},{"text":"då är din nåd mitt stöd, Herre.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"När mitt inre är fullt av bekymmer,","poem":1},{"text":"då gläder din tröst min själ.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kan en orättfärdig domstol","poem":1},{"noteId":276},{"text":"ha gemenskap med dig,","poem":3},{"text":"en som gör orätt","poem":2},{"noteId":277},{"text":"i lagens namn,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"som angriper en rättfärdig själ","poem":1},{"text":"och fördömer oskyldigt blod?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Men Herren har blivit min borg,","poem":1},{"text":"min Gud är min tillflykts klippa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Han låter deras brott","poem":1},{"text":"drabba dem själva,","poem":3},{"text":"han förgör dem","poem":2},{"text":"för deras ondska.","poem":3},{"text":"Herren vår Gud","poem":2},{"text":"ska förgöra dem.","poem":3}]}],"footnotes":[{"noteId":275,"caller":"-","text":"följa denAnnan översättning: \"ha en framtid\".","reference":{"chapter":94,"verse":15}},{"noteId":276,"caller":"-","text":"domstolAnnan översättning: \"tron\".","reference":{"chapter":94,"verse":20}},{"noteId":277,"caller":"-","text":"gör orättAnnan översättning: \"vållar lidande\".","reference":{"chapter":94,"verse":20}}]},"thisChapterLink":"/api/swe_fol/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}