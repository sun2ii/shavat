{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":96,"content":[{"type":"heading","content":["Hela jordens Kung"]},{"type":"verse","number":1,"content":[{"text":"Sjung till Herren en ny sång,","poem":1},{"text":"sjung till Herren, hela jorden!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sjung till Herren, lova hans namn,","poem":1},{"text":"ropa ut hans frälsning","poem":2},{"text":"dag efter dag!","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Förkunna hans ära","poem":1},{"text":"bland hednafolken,","poem":3},{"text":"bland alla folk hans under!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Stor är Herren och högt prisad,","poem":1},{"text":"värd att vörda mer än alla gudar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Folkens alla gudar är avgudar,","poem":1},{"text":"men Herren har gjort himlen.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Majestät och härlighet","poem":1},{"text":"är inför hans ansikte,","poem":3},{"text":"makt och glans i hans helgedom.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ge åt Herren, ni folkens släkter,","poem":1},{"text":"ge åt Herren ära och makt!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ge åt Herren hans namns ära,","poem":1},{"text":"kom med gåvor till hans gårdar!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tillbe Herren i helig skrud,","poem":1},{"text":"bäva inför honom, hela jorden!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Säg bland folken:","poem":1},{"text":"\"Herren är kung,","poem":2},{"text":"världen står fast och vacklar inte.","poem":3},{"text":"Han ska döma folken med rättvisa.\"","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Himlen ska glädjas","poem":1},{"text":"och jorden fröjda sig,","poem":3},{"text":"havet ska brusa","poem":2},{"text":"med allt som fyller det.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Marken ska jubla","poem":1},{"text":"med allt som den bär,","poem":3},{"text":"skogens alla träd","poem":2},{"text":"ska ropa av fröjd","poem":3}]},{"type":"verse","number":13,"content":[{"text":"inför Herren, för han kommer,","poem":1},{"text":"han kommer för att döma jorden.","poem":3},{"text":"Han ska döma världen","poem":2},{"text":"med rättfärdighet","poem":3},{"text":"och folken med sin trofasthet.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}