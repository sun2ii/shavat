{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":97,"content":[{"type":"heading","content":["Glädje över Herrens allmakt"]},{"type":"verse","number":1,"content":[{"text":"Herren är kung!","poem":1},{"text":"Jorden ska jubla","poem":2},{"text":"och alla havsländer glädja sig.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Moln och töcken omger honom,","poem":1},{"text":"rätt och rättfärdighet","poem":2},{"text":"är grunden för hans tron.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Eld går framför honom","poem":1},{"text":"och förtär hans fiender","poem":2},{"text":"runt omkring.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Hans blixtar lyser upp världen,","poem":1},{"text":"jorden ser dem och bävar.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bergen smälter som vax","poem":1},{"text":"inför Herren,","poem":2},{"text":"inför hela jordens Herre.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Himlen förkunnar hans rättfärdighet,","poem":1},{"text":"och alla folk ser hans härlighet.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alla ska de skämmas,","poem":1},{"text":"de som dyrkar avgudabilder","poem":3},{"text":"och stoltserar med","poem":2},{"text":"maktlösa gudar.","poem":3},{"text":"Tillbe honom, alla gudar!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sion hör det och gläds,","poem":1},{"text":"Juda döttrar","poem":2},{"noteId":280},{"text":"jublar","poem":2},{"text":"över dina domar, Herre,","poem":3}]},{"type":"verse","number":9,"content":[{"text":"för du, Herre, är den Högste","poem":1},{"text":"över hela jorden,","poem":3},{"text":"högt upphöjd över alla gudar.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ni som älskar Herren,","poem":1},{"text":"hata det onda!","poem":3},{"text":"Han vakar över","poem":2},{"text":"sina trognas själar,","poem":3},{"text":"han räddar dem","poem":2},{"text":"ur de gudlösas hand.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Ljus bryter fram","poem":1},{"noteId":281},{"text":"för den rättfärdige","poem":1},{"text":"och glädje för dem","poem":2},{"text":"som har ärliga hjärtan.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Gläd er i Herren, ni rättfärdiga,","poem":1},{"text":"och prisa hans heliga namn!","poem":2}]}],"footnotes":[{"noteId":280,"caller":"-","text":"Juda döttrarTroligen Juda lands städer utanför moderstaden Jerusalem.","reference":{"chapter":97,"verse":8}},{"noteId":281,"caller":"-","text":"bryter framAndra handskrifter: \"är utsått\".","reference":{"chapter":97,"verse":11}}]},"thisChapterLink":"/api/swe_fol/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}