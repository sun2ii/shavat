{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":98,"content":[{"type":"heading","content":["Jubel över Herrens frälsning"]},{"type":"verse","number":1,"content":[{"text":"En psalm.","descriptive":true},{"lineBreak":true},{"text":"Sjung till Herren en ny sång!","poem":1},{"text":"Han har gjort under,","poem":2},{"text":"han har gett frälsning","poem":3},{"text":"med sin högra hand,","poem":2},{"text":"sin heliga arm.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Herren har gjort sin frälsning känd,","poem":1},{"text":"han har visat sin rättfärdighet","poem":2},{"text":"inför folkens ögon.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Han har tänkt på sin nåd","poem":1},{"text":"och trofasthet mot Israels hus.","poem":3},{"text":"Jordens alla ändar har sett","poem":2},{"text":"vår Guds frälsning.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ropa till Herren, hela jorden,","poem":1},{"text":"brist ut i jubel och lovsång!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lovsjung Herren med harpa,","poem":1},{"text":"med harpa och lovsångsljud,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"med trumpeter och hornstötar.","poem":1},{"text":"Ropa av glädje inför kungen,","poem":2},{"text":"Herren!","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Havet ska brusa","poem":1},{"text":"med allt som fyller det,","poem":3},{"text":"världen och de som bor i den.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Strömmarna ska klappa händer","poem":1},{"text":"och bergen jubla tillsammans","poem":2}]},{"type":"verse","number":9,"content":[{"text":"inför Herren, för han kommer","poem":1},{"text":"för att döma jorden.","poem":3},{"text":"Han ska döma världen","poem":2},{"text":"med rättfärdighet","poem":3},{"text":"och folken med rättvisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}