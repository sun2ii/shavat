{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"PSA","translationId":"swe_fol","name":"Psaltaren","commonName":"Psaltaren","title":"Psaltaren","order":19,"numberOfChapters":150,"sha256":"7ca2dc2f8bf89d61c6099d3acf65e71e7f8f88569fad0fa0974ec6fff58e9cd4","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swe_fol/PSA/150.json","totalNumberOfVerses":2527},"chapter":{"number":99,"content":[{"type":"heading","content":["Den trefalt helige Kungen"]},{"type":"verse","number":1,"content":[{"text":"Herren är kung,","poem":1},{"text":"folken bävar!","poem":3},{"text":"Han tronar på keruberna,","poem":2},{"text":"jorden skälver!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Herren är stor i Sion,","poem":1},{"text":"upphöjd över alla folk.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"De prisar ditt namn,","poem":1},{"text":"det stora och fruktade.","poem":3},{"text":"Helig är han.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kungen är mäktig,","poem":1},{"text":"han älskar det rätta.","poem":3},{"text":"Du håller rättvisan vid makt,","poem":2},{"text":"rätt och rättfärdigt","poem":3},{"text":"handlar du i Jakob.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"Upphöj Herren vår Gud,","poem":1},{"text":"tillbe vid hans fötters pall!","poem":3},{"text":"Helig är han.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mose och Aron","poem":1},{"text":"var bland hans präster,","poem":3},{"text":"Samuel bland dem","poem":2},{"text":"som åkallar hans namn.","poem":3},{"text":"De ropade till Herren","poem":2},{"text":"och han svarade dem.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"I molnpelaren talade han till dem,","poem":1},{"text":"de höll hans vittnesbörd","poem":2},{"text":"och lagen han gav dem.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Herre vår Gud, du svarade dem,","poem":1},{"text":"du var en Gud som förlät dem","poem":2},{"text":"men som även hämnades","poem":3},{"text":"deras gärningar.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Upphöj Herren vår Gud,","poem":1},{"text":"tillbe vid hans heliga berg!","poem":3},{"text":"Ja, helig är Herren vår Gud.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swe_fol/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}