{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"SNG","translationId":"swe_fol","name":"Höga Visan","commonName":"Höga Visan","title":"Höga Visan","order":22,"numberOfChapters":8,"sha256":"11f1615b1939247804eede1624b71e0d319c649c044614a84c3705e28800331d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swe_fol/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Sångernas sång av Salomo."]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":2,"content":[{"text":"Kyss mig med","poem":1},{"noteId":0},{"text":"kyssar av din mun!","poem":1},{"text":"Din kärlek är ljuvare än vin.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ljuvlig är dina salvors doft,","poem":1},{"text":"en utgjuten salva","poem":3},{"noteId":1},{"text":"är ditt namn.","poem":3},{"text":"Därför älskar","poem":2},{"text":"de unga kvinnorna dig.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Dra mig med dig, låt oss skynda!","poem":1},{"text":"Kungen har fört mig in","poem":2},{"text":"i sina kammare.","poem":3},"Vännerna",{"text":"Vi vill jubla och glädjas över dig,","poem":1},{"text":"prisa din kärlek högre än vin.","poem":3},{"text":"Med rätta älskar man dig!","poem":2}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":5,"content":[{"text":"Mörk är jag, men vacker,","poem":1},{"text":"ni Jerusalems döttrar,","poem":3},{"text":"som Kedars hyddor","poem":2},{"noteId":2},{"text":",","poem":2},{"text":"som Salomos tält.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Se inte på mig för att jag är mörk,","poem":1},{"text":"för att solen har bränt mig.","poem":3},{"text":"Min mors söner blev arga på mig,","poem":2},{"text":"de satte mig att vakta","poem":3},{"text":"vingårdarna.","poem":4},{"text":"Min egen vingård vaktade jag inte.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Säg mig, du som min själ har kär:","poem":1},{"text":"Var vallar du din hjord,","poem":2},{"text":"var låter du den vila","poem":3},{"text":"vid middagstid?","poem":4},{"text":"Varför skulle jag gå som beslöjad","poem":2},{"noteId":3},{"text":"vid dina vänners hjordar?","poem":3}]},{"type":"heading","content":["Brudgummen"]},{"type":"verse","number":8,"content":[{"text":"Vet du inte det,","poem":1},{"text":"du skönaste bland kvinnor?","poem":3},{"text":"Gå då i hjordens spår","poem":2},{"text":"och valla dina killingar","poem":3},{"text":"vid herdarnas tält.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"Vid ett sto i faraos spann","poem":1},{"text":"liknar jag dig, min älskade.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Dina kinder är så vackra","poem":1},{"text":"med sina smycken,","poem":3},{"text":"din hals med rader av pärlor.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Smycken av guld","poem":1},{"text":"med pärlor av silver","poem":3},{"text":"ska vi göra åt dig.","poem":2}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":12,"content":[{"text":"Medan kungen håller sin fest","poem":1},{"text":"sprider min nardus","poem":2},{"noteId":4},{"text":"sin doft.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Min vän är för mig","poem":1},{"text":"ett myrragömme","poem":3},{"noteId":5},{"text":"som vilar mellan mina bröst.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Min vän är för mig","poem":1},{"text":"en klase hennablommor","poem":2},{"noteId":6},{"text":"från En-Gedis","poem":3},{"noteId":7},{"text":"vingårdar.","poem":3}]},{"type":"heading","content":["Brudgummen"]},{"type":"verse","number":15,"content":[{"text":"Vad du är vacker, min älskade,","poem":1},{"text":"vad du är vacker!","poem":3},{"text":"Dina ögon är duvor","poem":2},{"noteId":8},{"text":".","poem":2}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":16,"content":[{"text":"Vad du är vacker, min vän,","poem":1},{"text":"och ljuvlig!","poem":3},{"text":"Vårt viloläger grönskar.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Cedrar är bjälkar i vårt hus,","poem":1},{"text":"cypresser vår väggpanel.","poem":2},{"noteId":9}]}],"footnotes":[{"noteId":0,"caller":"-","text":"kyss mig medAnnan översättning: ”låt mig dricka”.","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"-","text":"salvors…salvaAnnan översättning: ”smörjelse”.","reference":{"chapter":1,"verse":3}},{"noteId":2,"caller":"-","text":"Kedars hyddorNordarabisk stam (se Jes 21:17, 42:11) med svarta gethårstält.","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"-","text":"gå sombeslöjadKvinnor kunde bära slöja inför främlingar (jfr 1 Mos 24:65). Slöjan bars även av prostituerade (1 Mos 38:15). Andra handskrifter (Peshitta, Symmachus etc): ”gå vilse”.","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"-","text":"nardusÄkta nardus är en dyrbar väldoftande olja som importerades ända från Himalayabergen (se Joh 12:3f med not).","reference":{"chapter":1,"verse":12}},{"noteId":5,"caller":"-","text":"myrragömmePåse med doftande kåda från södra delen av arabiska halvön.","reference":{"chapter":1,"verse":13}},{"noteId":6,"caller":"-","text":"hennablommorVita och rosendoftande. Annan översättning: ”försoning” (även i 4:13, 7:11).","reference":{"chapter":1,"verse":14}},{"noteId":7,"caller":"-","text":"En-Gedi”Killingkällan”, bördig oas bland klipporna vid Döda havets västra strand.","reference":{"chapter":1,"verse":14}},{"noteId":8,"caller":"-","text":"duvorAntik kärlekssymbol (jfr turturduvan i 2:12).","reference":{"chapter":1,"verse":15}},{"noteId":9,"caller":"-","text":"vår väggpanelAnnan översättning: ”vårt tak”.","reference":{"chapter":1,"verse":17}}]},"thisChapterLink":"/api/swe_fol/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}