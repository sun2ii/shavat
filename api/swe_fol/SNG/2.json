{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"SNG","translationId":"swe_fol","name":"Höga Visan","commonName":"Höga Visan","title":"Höga Visan","order":22,"numberOfChapters":8,"sha256":"11f1615b1939247804eede1624b71e0d319c649c044614a84c3705e28800331d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swe_fol/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Jag är en ros",{"noteId":10},"i Saron",{"noteId":11},",",{"text":"en lilja i dalen.","poem":3}]},{"type":"heading","content":["Brudgummen"]},{"type":"verse","number":2,"content":[{"text":"Som en lilja bland törnen,","poem":1},{"text":"så är min älskade bland flickor.","poem":2}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":3,"content":[{"text":"Som ett äppelträd bland skogens träd,","poem":1},{"text":"så är min vän bland unga män.","poem":3},{"text":"Jag längtar att få sitta","poem":2},{"text":"i hans skugga,","poem":3},{"text":"hans frukt är ljuv i min mun.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Han har fört mig in i vinsalen,","poem":1},{"text":"kärleken är hans baner över mig.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Stärk mig med druvkakor,","poem":1},{"text":"styrk mig med äpplen,","poem":3},{"text":"för jag är sjuk av kärlek!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hans vänstra arm vilar","poem":1},{"text":"under mitt huvud,","poem":3},{"text":"hans högra omfamnar mig.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lova mig, Jerusalems döttrar,","poem":1},{"text":"vid markens gaseller och hindar:","poem":3},{"text":"Stör inte kärleken, väck den inte","poem":2},{"text":"förrän den själv vill.","poem":3}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hör, min väns röst!","poem":1},{"text":"Se, där kommer han!","poem":3},{"text":"Han springer över bergen,","poem":2},{"text":"han hoppar fram över höjderna.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Min vän är som en gasell","poem":1},{"text":"eller en ung hjort.","poem":3},{"text":"Nu står han där bakom vår vägg,","poem":2},{"text":"han kikar in genom fönstret,","poem":3},{"text":"han ser in genom gallret.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Min vän börjar tala,","poem":1},{"text":"han säger till mig:","poem":3},"Brudgummen",{"text":"Res dig, min älskade,","poem":1},{"text":"min sköna, och kom!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Se, vintern är över,","poem":1},{"text":"regntiden slut och förbi.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Blommorna visar sig på marken,","poem":1},{"text":"sångens tid","poem":3},{"noteId":12},{"text":"har kommit","poem":3},{"text":"och turturduvans röst","poem":2},{"text":"hörs i vårt land.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Fikonträdets frukter rodnar,","poem":1},{"noteId":13},{"text":"vinstockarna blommar","poem":2},{"text":"och sprider sin doft.","poem":3},{"text":"Res dig, min älskade,","poem":2},{"text":"min sköna, och kom!","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Du min duva i bergsklyftan,","poem":1},{"text":"i klippväggens gömsle!","poem":3},{"text":"Låt mig se ditt ansikte,","poem":2},{"text":"låt mig höra din röst,","poem":3},{"text":"för din röst är ljuv","poem":2},{"text":"och ditt ansikte skönt.","poem":3}]},{"type":"heading","content":["Brudgummen och bruden"]},{"type":"verse","number":15,"content":[{"text":"Fånga rävarna","poem":1},{"noteId":14},{"text":"åt oss,","poem":1},{"text":"de små rävarna","poem":3},{"text":"som fördärvar vingårdarna,","poem":2},{"text":"våra vingårdar som står i blom.","poem":3}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":16,"content":[{"text":"Min vän är min och jag är hans,","poem":1},{"text":"han som vallar sin hjord","poem":2},{"text":"bland liljor.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"När dagen blir sval","poem":1},{"text":"och skuggorna flyr,","poem":3},{"text":"kom då tillbaka, min vän,","poem":2},{"text":"och var som en gasell","poem":3},{"text":"eller en ung hjort","poem":4},{"text":"på de kassiadoftande","poem":2},{"noteId":15},{"text":"bergen.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"-","text":"rosTraditionell översättning. Hebr. chavsélet syftar troligen på någon typ av narciss eller krokus.","reference":{"chapter":2,"verse":1}},{"noteId":11,"caller":"-","text":"SaronBördig slätt längs Israels västkust (1 Krön 27:29, Jes 35:2).","reference":{"chapter":2,"verse":1}},{"noteId":12,"caller":"-","text":"sångens tidAnnan översättning: ”ansningens tid” (för vinstockarna, jfr Joh 15:2).","reference":{"chapter":2,"verse":12}},{"noteId":13,"caller":"-","text":"fikonträdets frukter rodnarHebr. pag är fikonkart som mognar redan på våren (jfr Mark 11:13 med not).","reference":{"chapter":2,"verse":13}},{"noteId":14,"caller":"-","text":"rävarnaAnnan översättning: ”schakalerna”. Rävar åt gärna druvor. I egyptisk kärlekspoesi symboliserade rävar sexuellt giriga män.","reference":{"chapter":2,"verse":15}},{"noteId":15,"caller":"-","text":"kassiadoftandeVariant av kanel. Annan översättning: ”kluvna”.","reference":{"chapter":2,"verse":17}}]},"thisChapterLink":"/api/swe_fol/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}