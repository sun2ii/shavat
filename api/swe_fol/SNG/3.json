{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"SNG","translationId":"swe_fol","name":"Höga Visan","commonName":"Höga Visan","title":"Höga Visan","order":22,"numberOfChapters":8,"sha256":"11f1615b1939247804eede1624b71e0d319c649c044614a84c3705e28800331d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swe_fol/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Där jag låg i min bädd om natten",{"text":"sökte jag honom","poem":2},{"text":"som min själ har kär,","poem":3},{"text":"jag sökte honom","poem":2},{"text":"men fann honom inte.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Jag vill stiga upp","poem":1},{"text":"och gå runt i staden","poem":2},{"text":"på gator och torg,","poem":3},{"text":"jag vill söka honom","poem":2},{"text":"som min själ har kär.","poem":3},{"text":"Jag sökte honom","poem":2},{"text":"men fann honom inte.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Väktarna fann mig","poem":1},{"text":"där de gick runt i staden.","poem":3},{"text":"”Har ni sett honom","poem":2},{"text":"som min själ har kär?”","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Knappt var jag förbi dem,","poem":1},{"text":"så fann jag honom","poem":2},{"text":"som min själ har kär.","poem":3},{"text":"Jag grep honom","poem":2},{"text":"och släppte honom inte","poem":3},{"text":"förrän jag fört honom in","poem":2},{"text":"i min mors hus,","poem":3},{"text":"in i kammaren hos henne","poem":2},{"text":"som fött mig.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Lova mig, Jerusalems döttrar,","poem":1},{"text":"vid markens gaseller och hindar:","poem":3},{"text":"Stör inte kärleken, väck den inte","poem":2},{"text":"förrän den själv vill.","poem":3}]},{"type":"heading","content":["Brudtåget"]},{"type":"verse","number":6,"content":[{"text":"Vem är hon","poem":1},{"text":"som kommer upp från öknen","poem":3},{"text":"som i pelare av rök,","poem":2},{"text":"doftande av myrra och rökelse,","poem":3},{"text":"av köpmannens alla kryddor?","poem":4}]},{"type":"verse","number":7,"content":[{"text":"Se, där är Salomos bärstol","poem":1},{"noteId":16},{"text":"!","poem":1},{"text":"Sextio krigare omger den,","poem":2},{"text":"sextio av Israels hjältar.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Alla bär svärd","poem":1},{"text":"och är skickliga i strid,","poem":3},{"text":"var och en med svärd vid sidan","poem":2},{"text":"mot nattens faror.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Sin bärstol har kung Salomo","poem":1},{"text":"gjort av trä från Libanon,","poem":3}]},{"type":"verse","number":10,"content":[{"text":"med sidostöd av silver,","poem":1},{"text":"ryggstöd av guld","poem":2},{"text":"och säte av purpurtyg,","poem":3},{"text":"invändigt prydd i kärlek","poem":2},{"text":"av Jerusalems döttrar.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Kom ut, Sions döttrar,","poem":1},{"text":"se kung Salomo","poem":3},{"text":"och kronan","poem":2},{"noteId":17},{"text":"som hans mor","poem":2},{"text":"krönte honom med","poem":3},{"text":"på hans bröllopsdag,","poem":2},{"text":"på hans hjärtas glädjedag.","poem":3}]}],"footnotes":[{"noteId":16,"caller":"-","text":"bärstolAnnan översättning: ”bädd” (endast i vers 7).","reference":{"chapter":3,"verse":7}},{"noteId":17,"caller":"-","text":"kronanAnnan översättning: ”kransen” (vanligt vid bröllop). Salomos mor Bat-Seba var även aktiv när sonen Salomo kröntes till kung (se 1 Kung 1:15f).","reference":{"chapter":3,"verse":11}}]},"thisChapterLink":"/api/swe_fol/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}