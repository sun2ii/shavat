{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"SNG","translationId":"swe_fol","name":"Höga Visan","commonName":"Höga Visan","title":"Höga Visan","order":22,"numberOfChapters":8,"sha256":"11f1615b1939247804eede1624b71e0d319c649c044614a84c3705e28800331d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swe_fol/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"heading","content":["Brudgummen"]},{"type":"verse","number":1,"content":["Vad du är vacker, min älskade,",{"text":"vad du är vacker!","poem":4},{"text":"Dina ögon är duvor","poem":2},{"text":"bakom din slöja.","poem":3},{"text":"Ditt hår är som en hjord av getter","poem":2},{"text":"som strömmar ner","poem":3},{"text":"för Gileads berg.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Dina tänder är som en flock","poem":1},{"text":"av nyklippta tackor","poem":2},{"text":"som kommer upp ur badet,","poem":3},{"text":"där alla har tvillingar","poem":2},{"text":"och ingen är utan lamm.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Dina läppar är som","poem":1},{"text":"ett rosenrött band,","poem":2},{"text":"och din mun är ljuvlig.","poem":3},{"text":"Din kind","poem":2},{"noteId":18},{"text":"är som","poem":2},{"text":"en granatäppelskiva","poem":3},{"text":"bakom din slöja.","poem":4}]},{"type":"verse","number":4,"content":[{"text":"Din hals är som Davids torn,","poem":1},{"text":"byggt med rader av stenar","poem":3},{"noteId":19},{"text":"där tusen sköldar hänger,","poem":2},{"text":"hjältarnas alla sköldar","poem":3},{"noteId":20},{"text":".","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Dina båda bröst liknar två killingar,","poem":1},{"text":"tvillingar av en gasell","poem":2},{"text":"som betar bland liljor.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"När","poem":1},{"noteId":21},{"text":"dagen blir sval","poem":1},{"text":"och skuggorna flyr","poem":3},{"text":"vill jag gå till myrraberget,","poem":2},{"text":"till rökelsedoftens höjd.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Du är alltigenom vacker,","poem":1},{"text":"min älskade,","poem":3},{"text":"på dig finns ingen fläck.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kom med från Libanon, min brud,","poem":1},{"text":"kom med mig från Libanon!","poem":3},{"text":"Kom ner","poem":2},{"noteId":22},{"text":"från Amanas topp,","poem":2},{"text":"från toppen av Senir och Hermon,","poem":3},{"noteId":23},{"text":"från lejonens hålor,","poem":2},{"text":"från leopardernas berg.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Du har fångat mitt hjärta,","poem":1},{"text":"min syster, min brud,","poem":3},{"text":"du har fångat mitt hjärta","poem":2},{"text":"med en enda blick,","poem":3},{"text":"med en enda länk","poem":2},{"text":"i din halskedja.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Vad din kärlek är skön,","poem":1},{"text":"min syster, min brud!","poem":3},{"text":"Vad din kärlek är ljuv,","poem":2},{"text":"ljuvare än vin,","poem":3},{"text":"dina salvors doft","poem":2},{"text":"är ljuvare än alla parfymer.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Av sötma dryper dina läppar,","poem":1},{"text":"min brud,","poem":3},{"text":"din tunga gömmer honung","poem":2},{"text":"och mjölk,","poem":3},{"text":"dina kläders doft","poem":2},{"text":"är som Libanons doft.","poem":3}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"En sluten lustgård","poem":1},{"text":"är min syster, min brud,","poem":3},{"text":"en sluten brunn","poem":2},{"noteId":24},{"text":", en förseglad källa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dina växter","poem":1},{"noteId":25},{"text":"är en lustgård","poem":1},{"text":"av granatäppelträd","poem":3},{"text":"med härliga frukter,","poem":2},{"text":"med hennablommor och nardus,","poem":3}]},{"type":"verse","number":14,"content":[{"text":"med nardus och saffran,","poem":1},{"text":"kalmus och kanel","poem":2},{"text":"och alla slags rökelseträd,","poem":3},{"text":"med myrra och aloe","poem":2},{"text":"och de finaste kryddor","poem":3},{"text":"av alla slag.","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Du är en källa i lustgården,","poem":1},{"text":"en brunn med levande vatten","poem":2},{"text":"som strömmar från Libanon.","poem":3}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":16,"content":[{"text":"Vakna, du nordanvind,","poem":1},{"text":"och kom, du sunnanvind!","poem":3},{"text":"Blås genom min lustgård","poem":2},{"text":"så att dess dofter strömmar ut.","poem":3},{"text":"Kom, min vän, till din lustgård","poem":2},{"text":"och ät dess härliga frukter!","poem":3}]}],"footnotes":[{"noteId":18,"caller":"-","text":"kindAnnan översättning: ”tinning” (även i 6:6).","reference":{"chapter":4,"verse":3}},{"noteId":19,"caller":"-","text":"med rader av stenarAnnan översättning: ”som vapenförråd”.","reference":{"chapter":4,"verse":4}},{"noteId":20,"caller":"-","text":"sköldarAnnan översättning: ”koger” (pilfodral).","reference":{"chapter":4,"verse":4}},{"noteId":21,"caller":"-","text":"NärAnnan översättning: ”Tills” (även i 2:17).","reference":{"chapter":4,"verse":6}},{"noteId":22,"caller":"-","text":"Kom nerAnnan översättning: ”Blicka ner”.","reference":{"chapter":4,"verse":8}},{"noteId":23,"caller":"-","text":"Amanas topp … Senir och HermonAvlägsna bergstoppar vid Israels gräns i norr (Ps 89:13).","reference":{"chapter":4,"verse":8}},{"noteId":24,"caller":"-","text":"brunnAndra handskrifter (så Septuaginta): ”lustgård”.","reference":{"chapter":4,"verse":12}},{"noteId":25,"caller":"-","text":"växterAnnan översättning: ”lemmar”, ”strömmar”.","reference":{"chapter":4,"verse":13}}]},"thisChapterLink":"/api/swe_fol/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}