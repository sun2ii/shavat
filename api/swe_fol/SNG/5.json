{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"SNG","translationId":"swe_fol","name":"Höga Visan","commonName":"Höga Visan","title":"Höga Visan","order":22,"numberOfChapters":8,"sha256":"11f1615b1939247804eede1624b71e0d319c649c044614a84c3705e28800331d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swe_fol/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"heading","content":["Brudgummen"]},{"type":"verse","number":1,"content":["Jag kommer till min lustgård,",{"text":"min syster, min brud.","poem":3},{"text":"Jag plockar min myrra","poem":2},{"text":"och mina kryddor,","poem":3},{"text":"jag äter min honungskaka","poem":2},{"text":"och min honung,","poem":3},{"text":"jag dricker mitt vin","poem":2},{"text":"och min mjölk.","poem":3},{"text":"Ät, vänner, drick","poem":2},{"text":"och berusa er av kärlek!","poem":3}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":2,"content":[{"text":"Jag sover, men mitt hjärta är vaket.","poem":1},{"text":"Hör, min vän knackar på:","poem":3},{"text":"”Öppna för mig,","poem":2},{"text":"min syster, min älskade,","poem":3},{"text":"min duva, min fullkomliga!","poem":4},{"text":"Mitt huvud är fullt av dagg,","poem":2},{"text":"mina lockar av nattens droppar.”","poem":3}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jag har tagit av mig mitt linne,","poem":1},{"text":"ska jag ta på det igen?","poem":3},{"text":"Jag har tvättat mina fötter,","poem":2},{"text":"ska jag smutsa ner dem igen?","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Min vän räckte in sin hand","poem":1},{"text":"genom luckan,","poem":3},{"text":"då bultade mitt hjärta för honom.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jag steg upp för att öppna","poem":1},{"text":"för min vän.","poem":3},{"text":"Mina händer dröp av myrra,","poem":2},{"text":"mina fingrar av myrra","poem":4},{"text":"som rann över dörrens handtag.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag öppnade för min vän –","poem":1},{"text":"men min vän var borta,","poem":2},{"text":"han var försvunnen.","poem":3},{"text":"Min själ var utom sig","poem":2},{"text":"av hans ord.","poem":3},{"text":"Jag sökte honom","poem":2},{"text":"men fann honom inte,","poem":3},{"text":"jag ropade på honom","poem":2},{"text":"men han svarade mig inte.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Väktarna fann mig","poem":1},{"noteId":26},{"text":"där de gick runt i staden.","poem":3},{"text":"De slog mig och sårade mig,","poem":2},{"text":"de ryckte av mig min mantel,","poem":3},{"text":"dessa murarnas väktare.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Lova mig, Jerusalems döttrar:","poem":1},{"text":"Om ni finner min vän –","poem":2},{"text":"vad ska ni säga honom?","poem":3},{"text":"Att jag är sjuk av kärlek!","poem":2}]},{"type":"heading","content":["Vännerna"]},{"type":"verse","number":9,"content":[{"text":"Hur är din vän bättre än andra,","poem":1},{"text":"du skönaste bland kvinnor?","poem":3},{"text":"Hur är din vän bättre än andra,","poem":2},{"text":"eftersom du ber oss lova dig detta?","poem":3}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":10,"content":[{"text":"Min vän är strålande vit och röd,","poem":1},{"text":"ypperst bland tiotusen.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hans huvud är finaste guld,","poem":1},{"text":"hans hår är lockigt","poem":2},{"text":"och svart som korpen.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Hans ögon är som duvor","poem":1},{"text":"vid vattenbäckar,","poem":3},{"text":"duvor som badar i mjölk,","poem":2},{"text":"infattade som ädelstenar.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"Hans kinder liknar","poem":1},{"text":"doftande blomstersängar,","poem":2},{"text":"kullar av","poem":3},{"noteId":27},{"text":"kryddiga örter.","poem":3},{"text":"Hans läppar är liljor","poem":2},{"text":"som dryper av flytande myrra.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Hans händer är ringar","poem":1},{"noteId":28},{"text":"av guld","poem":1},{"text":"med infattade krysoliter.","poem":3},{"text":"Hans kropp är ett konstverk","poem":2},{"text":"av elfenben,","poem":3},{"text":"täckt med safirer.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hans ben är pelare av marmor","poem":1},{"text":"på socklar av finaste guld.","poem":3},{"text":"Hans gestalt är som Libanon,","poem":2},{"text":"ståtlig som cedrarna.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Hans mun är sötma,","poem":1},{"text":"allt hos honom är ljuvligt.","poem":3},{"text":"Sådan är min vän,","poem":2},{"text":"sådan är min älskade,","poem":3},{"text":"ni Jerusalems döttrar!","poem":2}]},{"type":"heading","content":["Vännerna"]},{"type":"verse","number":17,"content":[{"text":"Vart har din vän gått,","poem":1},{"text":"du skönaste bland kvinnor?","poem":3},{"text":"Vart har din vän tagit vägen?","poem":2},{"text":"Vi ska hjälpa dig","poem":3},{"text":"att söka honom.","poem":4}]}],"footnotes":[{"noteId":26,"caller":"-","text":"Väktarna fann migEn ensam kvinna ute mitt i natten kunde misstas för en prostituerad.","reference":{"chapter":5,"verse":7}},{"noteId":27,"caller":"-","text":"kullar avAnnan översättning: ”där det växer”.","reference":{"chapter":5,"verse":13}},{"noteId":28,"caller":"-","text":"ringarAnnan översättning: ”stavar”.","reference":{"chapter":5,"verse":14}}]},"thisChapterLink":"/api/swe_fol/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":17}