{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"SNG","translationId":"swe_fol","name":"Höga Visan","commonName":"Höga Visan","title":"Höga Visan","order":22,"numberOfChapters":8,"sha256":"11f1615b1939247804eede1624b71e0d319c649c044614a84c3705e28800331d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swe_fol/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"heading","content":["Bruden"]},{"type":"heading","content":["Brudgummen"]},{"type":"verse","number":1,"content":["Vad dina fötter är vackra",{"text":"i sandaler, du furstedotter!","poem":3},{"text":"Dina höfters rundning","poem":2},{"text":"är som ett smycke,","poem":3},{"text":"ett verk av en konstnärs händer.","poem":4}]},{"type":"verse","number":2,"content":[{"text":"Din navel","poem":1},{"noteId":32},{"text":"är en rundad skål,","poem":1},{"text":"må vinet aldrig fattas!","poem":3},{"text":"Din midja är en vetehög,","poem":2},{"text":"omgiven av liljor.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Dina bröst är som två killingar,","poem":1},{"text":"tvillingar av en gasell.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Din hals är som ett elfenbenstorn,","poem":1},{"text":"dina ögon som dammarna","poem":2},{"text":"i Heshbon","poem":3},{"noteId":33},{"text":"vid Bat-Rabbimsporten.","poem":3},{"text":"Din näsa är som Libanonstornet","poem":2},{"text":"som vetter mot Damaskus.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ditt huvud höjer sig som Karmel,","poem":1},{"text":"och ditt hårsvall är som purpur.","poem":3},{"text":"Kungen är fångad i dess lockar.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Vad du är skön och ljuv,","poem":1},{"text":"du kärlek, så full av njutning!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Din hållning är som palmens,","poem":1},{"text":"dina bröst som druvklasar.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Jag tänker: Jag vill upp i den palmen,","poem":1},{"text":"jag vill gripa dess frukt.","poem":3},{"text":"Låt dina bröst vara som druvklasar,","poem":2},{"text":"din andedräkt som äppeldoft","poem":3}]},{"type":"verse","number":9,"content":[{"text":"och din mun som ljuvaste vin.","poem":1},"Bruden",{"text":"Vinet rinner rakt ner i min vän","poem":1},{"text":"och fuktar de slumrandes läppar","poem":2},{"noteId":34},{"text":".","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Jag är min väns,","poem":1},{"text":"och till mig står hans åtrå.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kom, min vän,","poem":1},{"text":"vi går ut på fälten","poem":2},{"text":"och övernattar i byarna","poem":3},{"noteId":35},{"text":".","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Vi går tidigt till vingårdarna och ser","poem":1},{"text":"om vinstocken har fått skott,","poem":3},{"text":"om knopparna öppnat sig","poem":2},{"text":"och granatäppelträden","poem":3},{"text":"gått i blom.","poem":4},{"text":"Där vill jag ge dig min kärlek.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kärleksäpplena","poem":1},{"noteId":36},{"text":"sprider sin doft,","poem":1},{"text":"vid våra dörrar","poem":2},{"text":"finns alla slags härliga frukter,","poem":3},{"text":"både nya och gamla.","poem":4},{"text":"Min vän, jag har sparat dem åt dig.","poem":2}]}],"footnotes":[{"noteId":32,"caller":"-","text":"navelTroligen en anspelning på skötet.","reference":{"chapter":7,"verse":2}},{"noteId":33,"caller":"-","text":"dammarna i HeshbonStad drygt 2 mil öster om Döda havets nordspets. Utgrävningar har påvisat dammar från 800-talet f Kr där vinterns livgivande vatten lagrades under de torra sommarmånaderna.","reference":{"chapter":7,"verse":4}},{"noteId":34,"caller":"-","text":"de slumrandes läpparAndra handskrifter (Septuaginta): ”mina läppar och tänder”.","reference":{"chapter":7,"verse":9}},{"noteId":35,"caller":"-","text":"i byarnaAnnan översättning: ”bland hennabuskarna” (se not till 1:14).","reference":{"chapter":7,"verse":11}},{"noteId":36,"caller":"-","text":"kärleksäpplenaTroligen alruna, som skattades högt som afrodisiaka (jfr 1 Mos 30:14f).","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/swe_fol/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}