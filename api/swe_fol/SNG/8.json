{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"SNG","translationId":"swe_fol","name":"Höga Visan","commonName":"Höga Visan","title":"Höga Visan","order":22,"numberOfChapters":8,"sha256":"11f1615b1939247804eede1624b71e0d319c649c044614a84c3705e28800331d","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swe_fol/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"line_break"},{"type":"verse","number":1,"content":["Tänk om du hade varit",{"text":"som min bror,","poem":2},{"text":"ammad vid min mors bröst!","poem":3},{"text":"Då hade jag fått kyssa dig","poem":2},{"text":"om jag mött dig där ute,","poem":3},{"text":"och ingen hade föraktat mig.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jag hade fått leda dig,","poem":1},{"text":"föra dig in i min mors hus,","poem":2},{"text":"du hade undervisat mig","poem":3},{"noteId":37},{"text":".","poem":3},{"text":"Jag hade gett dig kryddat vin","poem":2},{"text":"att dricka,","poem":3},{"text":"saft från mina granatäpplen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hans vänstra arm","poem":1},{"text":"vilar under mitt huvud,","poem":3},{"text":"hans högra omfamnar mig.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lova mig, Jerusalems döttrar:","poem":1},{"text":"Stör inte kärleken, väck den inte","poem":2},{"text":"förrän den själv vill.","poem":3}]},{"type":"heading","content":["Vännerna"]},{"type":"verse","number":5,"content":[{"text":"Vem är hon","poem":1},{"text":"som kommer upp från öknen,","poem":3},{"text":"stödd på sin vän?","poem":2},"Bruden",{"text":"Där under äppelträdet","poem":1},{"text":"väckte jag dig,","poem":3},{"text":"där som din mor födde dig,","poem":2},{"text":"där hon som gav dig livet","poem":3},{"text":"födde dig","poem":4},{"noteId":38},{"text":".","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Sätt mig som ett sigill","poem":1},{"noteId":39},{"text":"på ditt hjärta,","poem":1},{"text":"som ett sigill på din arm,","poem":3},{"text":"för kärleken är stark som döden,","poem":2},{"text":"dess lidelse obeveklig","poem":3},{"text":"som dödsriket.","poem":4},{"text":"Dess glöd är eldens glöd,","poem":2},{"text":"en Herrens låga.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Väldiga vatten","poem":1},{"text":"kan inte släcka kärleken,","poem":3},{"text":"strömmar kan inte","poem":2},{"text":"dränka den.","poem":3},{"text":"Om någon ville ge","poem":2},{"text":"allt han har i sitt hus","poem":3},{"text":"för kärleken,","poem":4},{"text":"skulle han ändå bli avvisad.","poem":2}]},{"type":"heading","content":["Brudens bröder"]},{"type":"verse","number":8,"content":[{"text":"Vi har en liten syster","poem":1},{"text":"som ännu inte har fått bröst.","poem":3},{"text":"Vad ska vi göra med vår syster","poem":2},{"text":"den dag man vill vinna henne?","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Är hon en mur","poem":1},{"text":"bygger vi på den ett silverkrön,","poem":3},{"text":"men är hon en dörr","poem":2},{"text":"bommar vi för den","poem":3},{"text":"med en cederplanka.","poem":4}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":10,"content":[{"text":"Jag är en mur,","poem":1},{"text":"och mina bröst är som torn.","poem":3},{"text":"Så blev jag i hans ögon","poem":2},{"text":"som en som finner frid.","poem":3}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Salomo","poem":1},{"noteId":40},{"text":"hade en vingård","poem":1},{"text":"i Baal-Hamon","poem":3},{"noteId":41},{"text":",","poem":3},{"text":"en vingård som han lämnade","poem":2},{"text":"åt väktare.","poem":3},{"text":"Tusen siklar silver","poem":2},{"text":"fick man ge för dess frukt.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Min egen vingård tillhör mig.","poem":1},{"text":"Tusen tillhör dig, Salomo,","poem":2},{"text":"och tvåhundra dem","poem":3},{"text":"som vaktar dess frukt.","poem":4}]},{"type":"heading","content":["Brudgummen"]},{"type":"verse","number":13,"content":[{"text":"Du som bor i lustgårdarna,","poem":1},{"text":"vännerna lyssnar till din röst.","poem":3},{"text":"Låt mig få höra den!","poem":2}]},{"type":"heading","content":["Bruden"]},{"type":"verse","number":14,"content":[{"text":"Skynda, min vän,","poem":1},{"text":"och var som en gasell","poem":2},{"text":"eller en ung hjort","poem":3},{"text":"på de kryddoftande bergen.","poem":2}]}],"footnotes":[{"noteId":37,"caller":"-","text":"du hade undervisat migAnnan översättning: ”hon som har undervisat mig”.","reference":{"chapter":8,"verse":2}},{"noteId":38,"caller":"-","text":"födde digAnnan översättning: ”blev havande med dig”.","reference":{"chapter":8,"verse":5}},{"noteId":39,"caller":"-","text":"sigillPersonlig stämpel för underskrift som bars som ring (Est 8:2, Jer 22:24) eller runt halsen (1 Mos 38:18).","reference":{"chapter":8,"verse":6}},{"noteId":40,"caller":"-","text":"SalomoBetyder ”frid” (jfr vers 10).","reference":{"chapter":8,"verse":11}},{"noteId":41,"caller":"-","text":"Baal-HamonOkänd plats, kanske Baal-Gad vid foten av Hermon (Jos 11:17). Baal-Hamon kan översättas ”ägare till många”, en möjlig anspelning på kungens harem (6:7, 1 Kung 11:3). Tusen siklar silver motsvarade drygt 10 kg (jfr Jes 7:23).","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/swe_fol/SNG/8.json","th