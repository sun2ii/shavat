{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ZEC","translationId":"swe_fol","name":"Sakarja","commonName":"Sakarja","title":"Sakarja","order":38,"numberOfChapters":14,"sha256":"a5156f3f7050912286f76fb1d6a8e70fe776aa9ebc16476839e307c5af445669","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["Herren har omsorg om sitt folk"]},{"type":"verse","number":1,"content":["Be Herren om regn",{"text":"i vårregnets tid.","poem":2},{"lineBreak":true},{"text":"Herren gör åskmolnen,","poem":2},{"text":"han ger människorna","poem":3},{"text":"skurar av regn,","poem":4},{"text":"gröda på marken åt var och en.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Men husgudarna","poem":1},{"noteId":29},{"text":"talar svek,","poem":1},{"text":"spåmännen skådar lögn,","poem":3},{"text":"bedrägliga drömmar talar de,","poem":2},{"text":"tomhet är deras tröst.","poem":3},{"text":"Därför drar folket bort","poem":2},{"text":"som en fårhjord.","poem":3},{"text":"De lider nöd,","poem":2},{"text":"för de har ingen herde.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Min vrede brinner mot herdarna,","poem":1},{"text":"och jag ska straffa bockarna.","poem":3},{"text":"Herren Sebaot tar sig an","poem":2},{"text":"sin hjord, Juda hus,","poem":3},{"text":"och ska göra den","poem":2},{"text":"till sin stolta stridshäst.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Från Juda ska hörnstenen komma,","poem":1},{"text":"från honom stödjepelaren,","poem":3},{"text":"från honom bågen till striden,","poem":2},{"text":"från honom allt","poem":3},{"text":"vad styresman heter.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"De ska likna hjältar","poem":1},{"text":"som trampar ner sina fiender","poem":2},{"text":"som smuts på gatan i striden.","poem":3},{"text":"De ska strida,","poem":2},{"text":"för Herren är med dem,","poem":3},{"text":"och ryttarna på sina hästar","poem":2},{"text":"ska komma på skam.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Jag ska ge styrka åt Juda hus","poem":1},{"text":"och frälsa Josefs hus.","poem":3},{"text":"Jag ska föra dem tillbaka,","poem":2},{"text":"för jag ska förbarma mig","poem":3},{"text":"över dem.","poem":4},{"text":"De ska vara som om jag aldrig","poem":2},{"text":"hade förkastat dem,","poem":3},{"text":"för jag är Herren deras Gud,","poem":2},{"text":"jag ska bönhöra dem.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Efraims män ska bli som hjältar,","poem":1},{"text":"deras hjärtan ska glädjas","poem":2},{"text":"som av vin.","poem":3},{"text":"Deras barn ska se det","poem":2},{"text":"och glädja sig,","poem":3},{"text":"deras hjärtan ska fröjda sig","poem":2},{"text":"i Herren.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Jag ska vissla på dem","poem":1},{"text":"och föra dem samman,","poem":2},{"text":"för jag har befriat dem.","poem":3},{"text":"De ska bli lika talrika som förut.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"När jag planterar dem bland folken","poem":1},{"text":"ska de tänka på mig i fjärran land.","poem":3},{"text":"De ska få leva med sina barn","poem":2},{"text":"och komma tillbaka.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Jag ska föra dem tillbaka","poem":1},{"text":"från Egyptens land","poem":4},{"text":"och samla dem från Assur.","poem":3},{"text":"Till Gileads land och till Libanon","poem":2},{"text":"ska jag föra dem,","poem":3},{"text":"och där ska inte finnas utrymme","poem":2},{"text":"nog för dem.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Han ska dra fram genom","poem":1},{"text":"ett hav av nöd,","poem":3},{"text":"han ska slå ner havets vågor","poem":2},{"text":"och Nilflodens alla djup","poem":3},{"text":"ska torka ut.","poem":4},{"text":"Assurs stolthet ska brytas ner","poem":2},{"text":"och spiran tas ifrån Egypten.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Jag ska göra dem starka i Herren,","poem":1},{"text":"och i hans namn ska de gå fram,","poem":2},{"text":"säger Herren.","poem":3}]}],"footnotes":[{"noteId":29,"caller":"-","text":"husgudarnaHebr. terafím var statyetter, ofta små (1 Mos 31:34), som förknippades med familjers folktro och vidskepelse.","reference":{"chapter":10,"verse":2}}]},"thisChapterLink":"/api/swe_fol/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}