{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ZEC","translationId":"swe_fol","name":"Sakarja","commonName":"Sakarja","title":"Sakarja","order":38,"numberOfChapters":14,"sha256":"a5156f3f7050912286f76fb1d6a8e70fe776aa9ebc16476839e307c5af445669","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":8,"content":[{"type":"heading","content":["Framtida välsignelse över Jerusalem"]},{"type":"verse","number":1,"content":["Och Herren Sebaots ord kom till mig. Han sade:"]},{"type":"verse","number":2,"content":["Så säger Herren Sebaot:",{"lineBreak":true},{"text":"Jag ivrar för Sion med stor iver,","poem":1},{"text":"med stor vrede ivrar jag för henne.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Så säger Herren:","poem":1},{"text":"Jag ska vända åter till Sion","poem":2},{"text":"för att bo mitt i Jerusalem,","poem":3},{"text":"och Jerusalem ska kallas","poem":2},{"text":"”sanningens stad”","poem":3},{"text":"och Herren Sebaots berg","poem":2},{"text":"”det heliga berget”.","poem":3}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Än en gång ska det finnas","poem":2},{"text":"gamla män och kvinnor","poem":3},{"text":"på Jerusalems gator,","poem":4},{"text":"var och en med sin stav i handen","poem":2},{"text":"för sin höga ålders skull.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Och stadens gator ska vara fulla","poem":1},{"text":"av pojkar och flickor","poem":2},{"text":"som leker där.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Även om det verkar","poem":2},{"text":"alltför underbart","poem":3},{"text":"för dem som är kvar","poem":2},{"text":"av detta folk i de dagarna,","poem":3},{"text":"skulle det då vara","poem":2},{"text":"alltför underbart också för mig?","poem":3},{"text":"säger Herren Sebaot.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Se, jag ska frälsa mitt folk","poem":3},{"text":"från landet i öst","poem":2},{"text":"och från landet i väst.","poem":3}]},{"type":"verse","number":8,"content":[{"text":"Jag ska låta dem komma","poem":1},{"text":"och bo i Jerusalem,","poem":3},{"text":"de ska vara mitt folk","poem":2},{"text":"och jag ska vara deras Gud","poem":3},{"text":"i sanning och rättfärdighet.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Fatta mod, ni som i dessa dagar","poem":2},{"text":"hör dessa ord från profeterna","poem":3},{"text":"som talade när grunden lades","poem":2},{"text":"till Herren Sebaots hus,","poem":3},{"text":"templet som skulle byggas.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Före den tiden","poem":1},{"text":"fick varken människor eller djur","poem":2},{"text":"lön för sin strävan.","poem":3},{"text":"Ingen hade ro för sina fiender,","poem":2},{"text":"vare sig han gick ut eller in,","poem":3},{"text":"för jag vände alla människor","poem":2},{"text":"mot varandra.","poem":3}]},{"type":"verse","number":11,"content":[{"text":"Men nu är jag inte längre","poem":1},{"text":"som i forna dagar","poem":3},{"text":"mot dem som är kvar av detta folk,","poem":2},{"text":"säger Herren Sebaot,","poem":3}]},{"type":"verse","number":12,"content":[{"text":"för nu ska det sås i frid.","poem":1},{"text":"Vinstocken ska ge sin frukt,","poem":3},{"text":"jorden sin gröda","poem":2},{"text":"och himlen sin dagg.","poem":3},{"text":"Jag ska låta","poem":2},{"text":"dem som är kvar av detta folk","poem":3},{"text":"få ärva allt detta.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Och liksom ni,","poem":1},{"text":"både Juda hus och Israels hus,","poem":3},{"text":"har varit en förbannelse","poem":2},{"text":"bland hednafolken,","poem":3},{"text":"så ska ni nu när jag frälst er","poem":2},{"text":"bli en välsignelse.","poem":3},{"text":"Var inte rädda, fatta mod!","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":["Så säger Herren Sebaot: Liksom jag beslöt att sända olycka över er när era fäder väckte min vrede, säger Herren Sebaot, och jag då inte ångrade det,"]},{"type":"verse","number":15,"content":["så har jag i denna tid åter beslutat att göra gott mot Jerusalem och Juda hus. Var inte rädda!"]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Men detta är vad ni ska göra:","poem":1},{"text":"Tala sanning med varandra,","poem":3},{"text":"döm rätta domar i era portar,","poem":2},{"text":"domar som ger frid.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Tänk inte ut ont mot varandra","poem":1},{"text":"i era hjärtan","poem":3},{"text":"och ha inte kärlek till falska eder,","poem":2},{"text":"för allt sådant hatar jag,","poem":3},{"text":"säger Herren.","poem":4}]},{"type":"line_break"},{"type":"verse","number":18,"content":["Herren Sebaots ord kom till mig. Han sade:"]},{"type":"verse","number":19,"content":["Så säger Herren Sebaot:",{"lineBreak":true},{"text":"Fastedagarna i fjärde, femte,","poem":1},{"text":"sjunde och tionde månaden","poem":3},{"noteId":22},{"text":"ska för Juda hus","poem":2},{"text":"bli till fröjd och glädje,","poem":3},{"text":"till glada högtider.","poem":4},{"text":"Och ni ska älska sanning och frid.","poem":2}]},{"type":"heading","content":["Hedningarnas frälsning"]},{"type":"verse","number":20,"content":[{"text":"Så säger Herren Sebaot:","poem":1},{"text":"Än en gång ska folk komma hit,","poem":2},{"text":"ja, många städers invånare.","poem":3}]},{"type":"verse","number":21,"content":[{"text":"Och de som bor i en stad","poem":1},{"text":"ska gå till en annan och säga:","poem":3},{"text":"”Låt oss gå och bönfalla inför Herren","poem":2},{"text":"och söka Herren Sebaot.","poem":3},{"text":"Jag själv ska också gå.”","poem":4}]},{"type":"verse","number":22,"content":[{"text":"Ja, många folk","poem":1},{"text":"och mäktiga hednafolk","poem":3},{"text":"ska komma och söka","poem":2},{"text":"Herren Sebaot i Jerusalem,","poem":3},{"text":"och de ska åkalla Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":["Så säger Herren Sebaot: På den tiden ska tio män av alla språk och folk ta tag i mantelfållen på en judisk man och säga: ”Låt oss gå med er, för vi har hört att Gud är med er.”"]}],"footnotes":[{"noteId":22,"caller":"-","text":"fjärde, femte, sjunde och tionde månadenDen tionde månaden (jan år 588 f Kr) inleddes belägringen av Jerusalem (2 Kung 25:1). Den fjärde månaden år 587 f Kr (juli) flydde kung Sidkia (Jer 52:6), den femte månaden (augusti) föll staden (2 Kung 25:25) och den sjunde månaden (oktober) mördades ståthållaren Gedalja (2 Kung 25:25).","reference":{"chapter":8,"verse":19}}]},"thisChapterLink":"/api/swe_fol/ZEC/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ZEC/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ZEC/7.json","previousChapterAudioLinks":{},"numberOfVerses":23}