{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ZEC","translationId":"swe_fol","name":"Sakarja","commonName":"Sakarja","title":"Sakarja","order":38,"numberOfChapters":14,"sha256":"a5156f3f7050912286f76fb1d6a8e70fe776aa9ebc16476839e307c5af445669","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swe_fol/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["Domsord över Israels fiender"]},{"type":"verse","number":1,"content":["En profetia, Herrens ord mot Ha-draks land.",{"noteId":23},"I Damaskus ska det slå ner, för Herren har sitt öga på andra människor såväl som på Israels alla stammar."]},{"type":"verse","number":2,"content":["Det slår också ner i det angränsande Hamat, likaså i Tyrus och Sidon där man är så vis."]},{"type":"verse","number":3,"content":["Tyrus byggde sig ett fäste och samlade silver som stoft och guld som smuts på gatorna."]},{"type":"verse","number":4,"content":["Men se, Herren ska göra henne fattig och störta ner hennes välde i havet, och hon ska förtäras av eld."]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ashkelon ska se det och frukta,","poem":1},{"text":"Gaza ska darra av ångest","poem":2},{"text":"liksom Ekron,","poem":3},{"text":"för deras hopp kommer på skam.","poem":2},{"text":"Gaza mister sin kung,","poem":3},{"text":"och i Ashkelon","poem":2},{"text":"kommer ingen att bo.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Ett blandfolk ska bo i Ashdod,","poem":1},{"text":"och filisteernas stolthet","poem":2},{"text":"ska jag utrota.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Men när jag ryckt blodmaten","poem":1},{"text":"ur deras mun","poem":3},{"text":"och det vidriga från deras tänder,","poem":2},{"text":"då ska också de få bli kvar","poem":3},{"text":"åt vår Gud.","poem":4},{"text":"De ska bli som stamfurstar i Juda,","poem":2},{"text":"och Ekrons folk","poem":3},{"text":"ska bli som jebusiterna","poem":4},{"noteId":24},{"text":".","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Jag ska slå upp mitt läger","poem":1},{"text":"omkring mitt hus","poem":3},{"text":"mot härar","poem":2},{"text":"och mot den som kommer och går.","poem":3},{"text":"Ingen förtryckare","poem":2},{"text":"ska drabba dem längre,","poem":3},{"text":"för jag vaktar nu med öppna ögon.","poem":2}]},{"type":"heading","content":["Sions kung kommer"]},{"type":"verse","number":9,"content":[{"text":"Fröjda dig stort, dotter Sion!","poem":1},{"text":"Jubla, dotter Jerusalem!","poem":3},{"text":"Se, din kung kommer till dig,","poem":2},{"text":"rättfärdig och segerrik är han.","poem":3},{"text":"Han kommer ödmjuk,","poem":2},{"text":"ridande på en åsna","poem":3},{"noteId":25},{"text":",","poem":3},{"text":"på en åsninnas föl.","poem":4}]},{"type":"verse","number":10,"content":[{"text":"Jag ska ta bort vagnar ur Efraim","poem":1},{"text":"och hästar ur Jerusalem.","poem":3},{"text":"Stridens bågar ska bort,","poem":2},{"text":"och han ska tala frid","poem":3},{"text":"till hednafolken.","poem":4},{"text":"Hans välde ska nå från hav till hav,","poem":2},{"text":"och från floden till jordens ändar.","poem":3}]},{"type":"heading","content":["Befrielse genom förbundsblodet"]},{"type":"verse","number":11,"content":[{"text":"Och för dig ska jag","poem":1},{"text":"på grund av ditt förbundsblod","poem":3},{"text":"befria dina fångar","poem":2},{"text":"från den vattenlösa hålan.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Vänd åter till ert fäste,","poem":1},{"text":"ni fångar som har ett hopp.","poem":3},{"text":"Ja, i dag förkunnar jag för er","poem":2},{"text":"att jag ska ge er dubbelt igen.","poem":3}]},{"type":"verse","number":13,"content":[{"text":"För jag ska spänna Juda","poem":1},{"text":"som min båge","poem":3},{"text":"och lägga Efraim","poem":2},{"text":"som pil på den,","poem":3},{"text":"jag ska väcka upp dina söner, Sion,","poem":2},{"text":"mot dina söner, Grekland","poem":3},{"noteId":26},{"text":",","poem":3},{"text":"och göra dig lik en hjältes svärd.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ja, Herren ska uppenbara sig","poem":1},{"text":"över dem","poem":3},{"text":"och hans pil ska fara ut","poem":2},{"text":"som en blixt.","poem":3},{"text":"Herren Gud ska blåsa i basunen","poem":2},{"text":"och dra fram i söderns stormar.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Herren Sebaot ska beskydda dem.","poem":1},{"text":"De ska sluka sina fiender","poem":2},{"text":"och trampa på slungstenar","poem":3},{"noteId":27},{"text":".","poem":3},{"text":"De ska dricka och vråla","poem":2},{"text":"som av vin,","poem":3},{"noteId":28},{"text":"de ska fyllas som en offerskål,","poem":2},{"text":"som altarets hörn.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"Herren deras Gud","poem":1},{"text":"ska frälsa dem på den dagen,","poem":2},{"text":"för de är hans hjord, hans folk.","poem":3},{"text":"Som ädelstenar i en krona","poem":2},{"text":"ska de stråla över hans land.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Hur stor är inte hans godhet,","poem":1},{"text":"hur stor är inte hans skönhet!","poem":3},{"text":"Unga män ska blomstra av brödsäd","poem":2},{"text":"och unga kvinnor av vin.","poem":3}]}],"footnotes":[{"noteId":23,"caller":"-","text":"Hadraks landTroligen Hatarikka, persisk provins i Syrien norr om Damaskus.","reference":{"chapter":9,"verse":1}},{"noteId":24,"caller":"-","text":"jebusiternaJerusalems tidigare invånare som bodde kvar bland israeliterna (2 Sam 5:6, 1 Kung 9:20).","reference":{"chapter":9,"verse":7}},{"noteId":25,"caller":"-","text":"ridande på en åsnaCiteras i Matt 21:5 och Joh 12:15 som profetia om Jesu intåg i Jerusalem. Åsnan var ett enkelt och fredligt riddjur till skillnad från kungliga stridshästar.","reference":{"chapter":9,"verse":9}},{"noteId":26,"caller":"-","text":"GreklandHebr. Javán, jfr Jonien på nuvarande Turkiets västkust. Grekerna blev bittra fiender till judarna längre fram under mackabeertiden (100-talet f Kr).","reference":{"chapter":9,"verse":13}},{"noteId":27,"caller":"-","text":"trampa på slungstenarAnnan översättning: ”kuva dem med slungstenar”.","reference":{"chapter":9,"verse":15}},{"noteId":28,"caller":"-","text":"dricka och vråla som av vinVissa Septuagintahandskrifter: ”dricka blod som vin”.","reference":{"chapter":9,"verse":15}}]},"thisChapterLink":"/api/swe_fol/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}