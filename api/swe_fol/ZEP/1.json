{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ZEP","translationId":"swe_fol","name":"Sefanja","commonName":"Sefanja","title":"Sefanja","order":36,"numberOfChapters":3,"sha256":"47a134ae930b38e47e984646b8e713a4fba0d33de45c72bb2427f95c1ec01f32","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Detta är Herrens ord som kom till Sefanja, son till Kushi, son till Gedalja, son till Amarja, son till Hiskia",{"noteId":0},", när Josia",{"noteId":1},", Amons son, var kung i Juda."]},{"type":"heading","content":["Herrens stora vredesdag"]},{"type":"verse","number":2,"content":[{"text":"Jag ska sopa bort allt","poem":1},{"text":"från jordens yta, säger Herren.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jag ska sopa bort människor","poem":1},{"text":"och djur,","poem":3},{"text":"jag ska sopa bort himlens fåglar","poem":2},{"text":"och havets fiskar,","poem":3},{"text":"och dem som förleder","poem":2},{"text":"tillsammans med","poem":3},{"text":"de ogudaktiga.","poem":4},{"text":"Jag ska utrota människorna","poem":2},{"text":"från jordens yta,","poem":3},{"text":"säger Herren.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jag ska sträcka ut handen mot Juda","poem":1},{"text":"och mot alla som bor i Jerusalem.","poem":3},{"text":"Jag ska utrota från denna plats","poem":2},{"text":"vad som finns kvar av Baal,","poem":3},{"text":"avgudaprästernas namn","poem":2},{"text":"tillsammans med prästerna,","poem":3}]},{"type":"verse","number":5,"content":[{"text":"dem som tillber himlens här på taken","poem":1},{"text":"och dem som tillber och svär","poem":2},{"text":"vid Herren","poem":3},{"text":"men också svär vid Malkam","poem":2},{"noteId":2},{"text":",","poem":2}]},{"type":"verse","number":6,"content":[{"text":"dem som vikit bort från Herren","poem":1},{"text":"och varken har sökt Herren","poem":2},{"text":"eller frågat efter honom.","poem":3}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Var stilla inför Herren Gud,","poem":1},{"text":"för Herrens dag är nära.","poem":3},{"text":"Herren har förberett ett slaktoffer,","poem":2},{"text":"han har helgat dem","poem":3},{"text":"han har inbjudit.","poem":4}]},{"type":"verse","number":8,"content":[{"text":"Och det ska ske","poem":1},{"text":"på dagen för Herrens slaktoffer","poem":3},{"text":"att jag ska straffa furstarna","poem":2},{"text":"och kungasönerna","poem":3},{"text":"och alla som klär sig","poem":2},{"text":"i utländska kläder","poem":3},{"noteId":3},{"text":".","poem":3}]},{"type":"verse","number":9,"content":[{"text":"På den dagen ska jag straffa","poem":1},{"text":"alla som hoppar över tröskeln","poem":3},{"noteId":4},{"text":",","poem":3},{"text":"dem som fyller sin herres hus","poem":2},{"text":"med våld och svek.","poem":3}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Och det ska ske på den dagen,","poem":1},{"text":"säger Herren,","poem":3},{"text":"att sorgerop hörs från Fiskporten","poem":2},{"text":"och jämmer från Nya staden","poem":3},{"text":"och ett mäktigt dån från höjderna.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jämra er,","poem":1},{"text":"ni som bor i Mortelkvarteret,","poem":3},{"text":"för det är slut med hela skaran","poem":2},{"text":"av köpmän,","poem":3},{"text":"alla som handlar med silver","poem":2},{"text":"utrotas.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Och det ska ske på den tiden","poem":1},{"text":"att jag söker igenom Jerusalem","poem":2},{"text":"med lyktor","poem":3},{"text":"och straffar dem som sitter där","poem":2},{"text":"i lugn och ro","poem":3},{"noteId":5},{"text":"och säger i sina hjärtan:","poem":2},{"text":"”Inte gör Herren något gott","poem":3},{"text":"och inte gör han något ont.”","poem":4}]},{"type":"verse","number":13,"content":[{"text":"Och det ska ske","poem":1},{"text":"att deras ägodelar","poem":3},{"text":"lämnas till plundring","poem":2},{"text":"och deras hus läggs öde.","poem":3},{"text":"De ska bygga hus","poem":2},{"text":"men inte få bo i dem,","poem":3},{"text":"de ska plantera vingårdar","poem":2},{"text":"men inte få dricka vinet från dem.","poem":3}]},{"type":"heading","content":["Herrens stora dag"]},{"type":"verse","number":14,"content":[{"text":"Herrens stora dag är nära,","poem":1},{"text":"nära och kommer med hast.","poem":3},{"text":"Hör, det är Herrens dag!","poem":2},{"text":"Då ropar hjältarna i ångest.","poem":3}]},{"type":"verse","number":15,"content":[{"text":"Den dagen är en vredens dag,","poem":1},{"text":"en dag av ångest och nöd,","poem":2},{"text":"en dag av ödeläggelse","poem":3},{"text":"och förödelse,","poem":4},{"text":"en dag av mörker och dimma,","poem":2},{"text":"en dag av moln och dis,","poem":3}]},{"type":"verse","number":16,"content":[{"text":"en dag då hornstöt och härskri höjs","poem":1},{"text":"mot de befästa städerna","poem":2},{"text":"och de höga murtornen.","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Då ska jag ge människorna","poem":1},{"text":"sådan ångest","poem":3},{"text":"att de går omkring som blinda,","poem":2},{"text":"därför att de har syndat","poem":3},{"text":"mot Herren.","poem":4},{"text":"Deras blod ska spridas som stoft","poem":2},{"text":"och deras inälvor som gödsel.","poem":3}]},{"type":"verse","number":18,"content":[{"text":"Varken deras silver eller deras guld","poem":1},{"text":"ska kunna rädda dem","poem":2},{"text":"på Herrens vredes dag.","poem":3},{"text":"Av hans lidelses eld","poem":2},{"text":"ska hela jorden förtäras,","poem":3},{"text":"för fullständigt och med hast","poem":2},{"text":"ska han göra slut på alla","poem":3},{"text":"som bor på jorden.","poem":4}]}],"footnotes":[{"noteId":0,"caller":"-","text":"HiskiaTroligen den berömde kungen (regerade ca 715-687 f Kr) som återupprättade tron på Israels Gud (2 Kung 18-20, 2 Krön 29-32).","reference":{"chapter":1,"verse":1}},{"noteId":1,"caller":"-","text":"JosiaÄlskad reformator som regerade 640-609 f Kr (2 Kung 22-23).","reference":{"chapter":1,"verse":1}},{"noteId":2,"caller":"-","text":"MalkamTroligen ammoniternas avgud Milkom (1 Kung 11:33). Annan översättning: ”deras kung”.","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"-","text":"utländska kläderIsraeliternas kläder skulle påminna om förbundet med Gud (4 Mos 15:39). Kulturimport kunde medföra seder förknippade med avgudakulter (jfr t ex 2 Kung 16:10f).","reference":{"chapter":1,"verse":8}},{"noteId":4,"caller":"-","text":"alla som hoppar över tröskelnEn hednisk vidskepelse (se 1 Sam 5:5).","reference":{"chapter":1,"verse":9}},{"noteId":5,"caller":"-","text":"i lugn och roOrdagrant: ”på sin drägg” (bottensatsen i vinet).","reference":{"chapter":1,"verse":12}}]},"thisChapterLink":"/api/swe_fol/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}