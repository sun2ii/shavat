{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ZEP","translationId":"swe_fol","name":"Sefanja","commonName":"Sefanja","title":"Sefanja","order":36,"numberOfChapters":3,"sha256":"47a134ae930b38e47e984646b8e713a4fba0d33de45c72bb2427f95c1ec01f32","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["Varning till Herrens folk"]},{"type":"verse","number":1,"content":["Samla er och kom samman,",{"text":"du folk som inte skäms,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"innan beslutet genomförs","poem":1},{"text":"– den dagen far fram som agnar –","poem":3},{"text":"innan Herrens vredesglöd","poem":2},{"text":"drabbar er,","poem":3},{"text":"innan Herrens vredes dag","poem":2},{"text":"drabbar er.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Sök Herren,","poem":1},{"text":"alla ni ödmjuka i landet,","poem":2},{"text":"ni som gör vad han befaller.","poem":3},{"text":"Sök rättfärdighet, sök ödmjukhet!","poem":2},{"text":"Kanske blir ni beskyddade","poem":3},{"text":"på Herrens vredes dag.","poem":4}]},{"type":"heading","content":["Straffdom över Israels grannfolk"]},{"type":"verse","number":4,"content":[{"text":"Gaza ska bli övergivet","poem":1},{"noteId":6},{"text":"och Ashkelon förvandlas","poem":2},{"text":"till en ödemark.","poem":3},{"text":"Ashdod ska drivas ut","poem":2},{"text":"mitt på ljusa dagen","poem":3},{"text":"och Ekron ryckas upp","poem":2},{"text":"med rötterna.","poem":3}]},{"type":"verse","number":5,"content":[{"text":"Ve er som bor på kustremsan,","poem":1},{"text":"ni av kereteernas folk","poem":3},{"noteId":7},{"text":"!","poem":3},{"text":"Herrens ord är emot dig,","poem":2},{"text":"Kanaan, du filisteernas land.","poem":3},{"text":"Jag ska fördärva dig","poem":2},{"text":"så att ingen mer ska bo där.","poem":3}]},{"type":"verse","number":6,"content":[{"text":"Kustremsan ska bli betesmarker","poem":1},{"text":"där herdarna har sina brunnar","poem":2},{"text":"och fåren sina fållor.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Den ska tillfalla dem som är kvar","poem":1},{"text":"av Juda hus.","poem":3},{"text":"Där ska de föra sin boskap i bet.","poem":2},{"text":"I Ashkelons hus","poem":3},{"text":"ska de lägga sig om kvällen,","poem":4},{"text":"för Herren deras Gud","poem":2},{"text":"ska se till dem","poem":3},{"text":"och göra slut på deras fångenskap.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Jag har hört Moabs hån","poem":1},{"text":"och ammoniternas","poem":2},{"text":"förolämpningar,","poem":3},{"text":"hur de hånat mitt folk","poem":2},{"text":"och förhävt sig mot deras land.","poem":3}]},{"type":"verse","number":9,"content":[{"text":"Därför, så sant jag lever,","poem":1},{"text":"säger Herren Sebaot, Israels Gud:","poem":3},{"text":"Moab ska bli som Sodom","poem":2},{"text":"och ammoniterna","poem":3},{"noteId":8},{"text":"som Gomorra,","poem":3},{"text":"ett tillhåll för nässlor","poem":2},{"text":"och en saltgrop,","poem":4},{"text":"en ödemark till evig tid.","poem":3},{"text":"De som är kvar av mitt folk","poem":2},{"text":"ska plundra dem,","poem":3},{"text":"resten av mitt folk","poem":2},{"text":"ska få dem till arvedel.","poem":3}]},{"type":"verse","number":10,"content":[{"text":"Så ska det gå dem för deras högmod,","poem":1},{"text":"för de har hånat","poem":2},{"text":"Herren Sebaots folk","poem":3},{"text":"och förhävt sig mot dem.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Herren ska vara fruktansvärd","poem":1},{"text":"mot dem.","poem":3},{"text":"Han ska förgöra alla jordens gudar,","poem":2},{"text":"och folkens alla kustländer","poem":3},{"text":"ska tillbe honom,","poem":4},{"text":"varje folk på sin ort.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Också ni nubier ska genomborras","poem":1},{"text":"av mitt svärd.","poem":3}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Han ska sträcka ut handen mot norr","poem":1},{"text":"och fördärva Assur","poem":3},{"text":"och göra Nineve till en ödemark","poem":2},{"noteId":9},{"text":",","poem":2},{"text":"torr som öknen.","poem":3}]},{"type":"verse","number":14,"content":[{"text":"Där ska hjordar lägra sig,","poem":1},{"text":"alla slags vilda djur.","poem":3},{"text":"Både pelikaner och hägrar","poem":2},{"text":"ska övernatta","poem":3},{"text":"på dess pelarhuvuden.","poem":4},{"text":"Fågelsång ska eka genom fönstren","poem":2},{"text":"och bråte","poem":3},{"noteId":10},{"text":"finnas på trösklarna,","poem":3},{"text":"för cederpanelen är bortriven.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Detta är den glada staden","poem":1},{"text":"som satt så trygg","poem":3},{"text":"och tänkte för sig själv:","poem":2},{"text":"”Jag och ingen annan!”","poem":3},{"text":"Vilken ödemark den har blivit,","poem":2},{"text":"ett tillhåll för vilda djur!","poem":3},{"text":"Alla som går förbi ska vissla åt den","poem":2},{"text":"och slå ihop händerna.","poem":3}]}],"footnotes":[{"noteId":6,"caller":"-","text":"Gaza ska bli övergivetOmrådet skövlades av Babels kung Nebukadnessar år 588 f Kr.","reference":{"chapter":2,"verse":4}},{"noteId":7,"caller":"-","text":"kereteernas folkFilisteerna hade kommit från Kreta (Amos 9:7) och bosatt sig på Gazaremsan.","reference":{"chapter":2,"verse":5}},{"noteId":8,"caller":"-","text":"Moab … ammoniternaEfter att ha förstört Jerusalem år 587 f Kr återkom Nebukadnessar år 582 f Kr, enligt historikern Herodotos, och härjade grannarna Ammon och Moab.","reference":{"chapter":2,"verse":9}},{"noteId":9,"caller":"-","text":"göra Nineve till en ödemarkAssyriernas stora huvudstad (Jona 4:11) som ödelades av babylonierna 612 f Kr (se Nahums bok).","reference":{"chapter":2,"verse":13}},{"noteId":10,"caller":"-","text":"bråteAndra handskrifter (Septuaginta): ”korpar”.","reference":{"chapter":2,"verse":14}}]},"thisChapterLink":"/api/swe_fol/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}