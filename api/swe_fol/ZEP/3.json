{"translation":{"id":"swe_fol","name":"Svenska Folkbibeln","website":"https://ebible.org/Scriptures/details.php?id=swef","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swef","licenseNotes":null,"shortName":"FOL","englishName":"Swedish Folkbibleln","language":"swe","textDirection":"ltr","sha256":"a31141d60ba69166b98f16e90b93ba9000558b567102160bd7c25f4f293cd6fa","availableFormats":["json"],"listOfBooksApiLink":"/api/swe_fol/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31153,"languageName":"svenska","languageEnglishName":"Swedish"},"book":{"id":"ZEP","translationId":"swe_fol","name":"Sefanja","commonName":"Sefanja","title":"Sefanja","order":36,"numberOfChapters":3,"sha256":"47a134ae930b38e47e984646b8e713a4fba0d33de45c72bb2427f95c1ec01f32","firstChapterNumber":1,"firstChapterApiLink":"/api/swe_fol/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swe_fol/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Jerusalems synder"]},{"type":"verse","number":1,"content":["Ve över den upproriska",{"text":"och orena staden,","poem":2},{"text":"förtryckets stad!","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Hon lyssnar inte till någon,","poem":1},{"text":"hon tar inte emot tillrättavisning,","poem":3},{"text":"litar inte på Herren","poem":2},{"text":"och närmar sig inte sin Gud.","poem":3}]},{"type":"verse","number":3,"content":[{"text":"Hennes styresmän därinne","poem":1},{"text":"är rytande lejon,","poem":3},{"text":"hennes domare är stäppvargar","poem":2},{"noteId":11},{"text":"som inget spar till morgonen.","poem":3}]},{"type":"verse","number":4,"content":[{"text":"Hennes profeter är skrävlare,","poem":1},{"text":"trolösa män.","poem":3},{"text":"Hennes präster vanhelgar","poem":2},{"text":"det som är heligt","poem":3},{"text":"och gör våld på lagen.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Herren är rättfärdig därinne,","poem":1},{"text":"han gör inget orätt.","poem":3},{"text":"Morgon efter morgon","poem":2},{"text":"uppenbarar han sin dom,","poem":3},{"text":"den uteblir aldrig.","poem":4},{"text":"Men den orättfärdige","poem":2},{"text":"vet inte av någon skam.","poem":3}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Jag utrotade hednafolk,","poem":1},{"text":"deras murtorn förstördes.","poem":3},{"text":"Jag lade deras gator öde,","poem":2},{"text":"ingen gick där längre.","poem":3},{"text":"Deras städer skövlades,","poem":2},{"text":"tömda på folk och invånare.","poem":3}]},{"type":"verse","number":7,"content":[{"text":"Jag sade: ”Du ska frukta mig","poem":1},{"text":"och ta emot tuktan.”","poem":3},{"text":"Då skulle hennes boning","poem":2},{"text":"inte utplånas eller drabbas","poem":3},{"text":"av allt som jag bestämt","poem":2},{"text":"som straff.","poem":3},{"text":"Men i stället var de ivriga","poem":2},{"text":"att","poem":3},{"noteId":12},{"text":"göra sina fördärvliga","poem":3},{"text":"gärningar.","poem":4}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Vänta därför på mig, säger Herren,","poem":1},{"text":"på dagen då jag reser mig","poem":3},{"text":"för att ta byte","poem":4},{"noteId":13},{"text":",","poem":4},{"text":"för detta är mitt domslut:","poem":2},{"text":"Jag ska samla folk","poem":3},{"text":"och hämta riken","poem":4},{"text":"för att ösa min vrede över dem,","poem":2},{"text":"hela min glödande harm,","poem":3},{"text":"för hela jorden ska förtäras","poem":2},{"text":"av min lidelses eld.","poem":3}]},{"type":"heading","content":["Frälsning för en rest av Israel"]},{"type":"verse","number":9,"content":[{"text":"Då ska jag ge folken renade läppar,","poem":1},{"text":"och de ska alla","poem":2},{"text":"åkalla Herrens namn","poem":3},{"text":"och tjäna honom tillsammans","poem":2},{"noteId":14},{"text":".","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Från landet bortom Nubiens floder","poem":1},{"noteId":15},{"text":"ska mina tillbedjare,","poem":2},{"text":"mitt förskingrade folk,","poem":3},{"text":"frambära offer åt mig.","poem":4}]},{"type":"verse","number":11,"content":[{"text":"På den dagen","poem":1},{"text":"ska du inte behöva skämmas","poem":2},{"text":"för alla överträdelser","poem":3},{"text":"du begått mot mig,","poem":4},{"text":"för då ska jag rensa bort ur dig","poem":2},{"text":"dem som stoltserar","poem":3},{"text":"i högmod hos dig,","poem":4},{"text":"och du ska inte längre","poem":2},{"text":"förhäva dig på mitt heliga berg.","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Men jag ska lämna kvar i dig","poem":1},{"text":"ett folk som är ödmjukt och svagt","poem":2},{"text":"och har sin tillflykt","poem":3},{"text":"i Herrens namn.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"De som är kvar av Israel","poem":1},{"text":"ska inte göra orätt eller tala lögn,","poem":3},{"text":"och ingen falsk tunga","poem":2},{"text":"ska finnas i deras mun.","poem":3},{"text":"De ska få beta och lägga sig ner","poem":2},{"text":"utan att någon skrämmer dem.","poem":3}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Jubla, dotter Sion,","poem":1},{"text":"ropa av glädje, Israel!","poem":3},{"text":"Var glad och fröjda dig","poem":2},{"text":"av hela ditt hjärta,","poem":3},{"text":"dotter Jerusalem!","poem":4}]},{"type":"verse","number":15,"content":[{"text":"Herren har tagit bort","poem":1},{"text":"straffdomarna från dig","poem":2},{"text":"och röjt bort din fiende.","poem":3},{"text":"Herren, Israels Kung, bor i dig.","poem":2},{"text":"Du ska aldrig mer","poem":3},{"text":"frukta något ont.","poem":4}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"På den dagen ska det sägas","poem":1},{"text":"till Jerusalem:","poem":3},{"text":"”Var inte rädd, Sion,","poem":2},{"text":"låt inte dina händer sjunka!","poem":3}]},{"type":"verse","number":17,"content":[{"text":"Herren din Gud bor i dig,","poem":1},{"text":"en hjälte som frälser.","poem":3},{"text":"Han gläder sig över dig med lust,","poem":2},{"text":"han tiger stilla","poem":3},{"noteId":16},{"text":"i sin kärlek,","poem":3},{"text":"han fröjdas över dig med jubel.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Jag ska samla dem","poem":1},{"text":"som sörjer över högtiderna","poem":3},{"noteId":17},{"text":",","poem":3},{"text":"dem som varit skilda från dig","poem":2},{"text":"och nu bär föraktets börda.","poem":3}]},{"type":"verse","number":19,"content":[{"text":"Se, på den tiden ska jag","poem":1},{"text":"ta itu med alla som plågat dig.","poem":3},{"text":"Jag ska frälsa de haltande","poem":2},{"text":"och samla de fördrivna.","poem":3},{"text":"Jag ska göra dem","poem":2},{"text":"till lovsång och berömmelse","poem":3},{"text":"över hela jorden","poem":2},{"text":"där de varit så hånade.","poem":3}]},{"type":"verse","number":20,"content":[{"text":"På den tiden ska jag föra er hem,","poem":1},{"text":"då ska jag samla er,","poem":3},{"text":"för jag ska göra er","poem":2},{"text":"till berömmelse och lovsång","poem":3},{"text":"bland jordens alla folk","poem":4},{"text":"när jag gör slut på er fångenskap","poem":2},{"text":"inför era ögon, säger Herren.","poem":3}]}],"footnotes":[{"noteId":11,"caller":"-","text":"stäppvargarAnnan översättning: ”kvällens vargar”.","reference":{"chapter":3,"verse":3}},{"noteId":12,"caller":"-","text":"var de ivriga attAnnan översättning: ”steg de upp tidigt för att”.","reference":{"chapter":3,"verse":7}},{"noteId":13,"caller":"-","text":"ta byteAnnan översättning (så Septuaginta): ”vittna”.","reference":{"chapter":3,"verse":8}},{"noteId":14,"caller":"-","text":"tillsammansOrdagrant: ”med en enda axel”.","reference":{"chapter":3,"verse":9}},{"noteId":15,"caller":"-","text":"landet bortom Nubiens floderAfrika bortom Nilen, den då kända världens bortre gräns.","reference":{"chapter":3,"verse":10}},{"noteId":16,"caller":"-","text":"tiger stillaAndra handskrifter (Septuaginta): ”förnyar (dig)”.","reference":{"chapter":3,"verse":17}},{"noteId":17,"caller":"-","text":"sörjer över högtidernaAtt Herrens högtider (3 Mos 23, 5 Mos 16) inte kunde firas efter templets fall och folkets fördrivning (jfr Klag 1:4).","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/swe_fol/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swe_fol/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swe_fol/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}