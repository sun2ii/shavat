{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"2SA","translationId":"swh_bib","name":"2 Samweli","commonName":"2 Samweli","title":"2 Samweli","order":10,"numberOfChapters":24,"sha256":"8fec1afc124faebcdc1584d9ee11cc95b033a5e8730db5b7d28a2948bb3678eb","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/swh_bib/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["Wimbo Wa Daudi Wa Sifa"]},{"type":"verse","number":1,"content":["Daudi alimwimbia Bwana maneno ya wimbo huu wakati Bwana alipomwokoa mikononi mwa adui zake wote, na pia mkononi mwa Sauli."]},{"type":"verse","number":2,"content":["Akasema:",{"text":"“Bwana ni mwamba wangu,","poem":1},{"text":"ngome yangu na mwokozi wangu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mungu wangu ni mwamba wangu,","poem":1},{"text":"ambaye kwake ninakimbilia,","poem":2},{"lineBreak":true},{"text":"ngao yangu na pembe ya wokovu wangu.","poem":2},{"text":"Yeye ni ngome yangu, kimbilio langu","poem":1},{"text":"na mwokozi wangu,","poem":2},{"lineBreak":true},{"text":"huniokoa kutoka kwa watu wenye jeuri.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ninamwita Bwana, anayestahili kusifiwa,","poem":1},{"text":"nami ninaokolewa kutoka kwa adui zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mawimbi ya mauti yalinizunguka,","poem":1},{"text":"mafuriko ya maangamizi yalinilemea.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kamba za kuzimu","poem":1},{"noteId":18},{"text":"zilinizunguka,","poem":1},{"text":"mitego ya mauti ilinikabili.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katika shida yangu nalimwita Bwana,","poem":1},{"text":"nilimlilia Mungu wangu.","poem":2},{"text":"Kutoka Hekaluni mwake alisikia sauti yangu,","poem":1},{"text":"kilio changu kikafika masikioni mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Dunia ilitetemeka na kutikisika,","poem":1},{"text":"misingi ya mbingu ikatikisika,","poem":2},{"text":"vilitetemeka kwa sababu","poem":1},{"text":"alikuwa amekasirika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moshi ukapanda kutoka puani mwake,","poem":1},{"text":"moto uteketezao ukatoka kinywani mwake,","poem":2},{"text":"makaa ya moto yawakayo","poem":1},{"text":"yakatoka ndani mwake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Akazipasua mbingu akashuka chini,","poem":1},{"text":"mawingu meusi yalikuwa chini ya miguu yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Alipanda juu ya kerubi akaruka,","poem":1},{"text":"akapaa juu kwa mbawa za upepo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Alifanya giza hema lake la kujifunika:","poem":1},{"text":"mawingu meusi ya mvua ya angani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kutokana na mwanga wa uwepo wake","poem":1},{"text":"mawingu yalisogea,","poem":2},{"text":"ikanyesha mvua ya mawe","poem":1},{"text":"na umeme wa radi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bwana alinguruma kutoka mbinguni,","poem":1},{"text":"sauti ya Aliye Juu Sana ilisikika.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Aliipiga mishale na kutawanya adui,","poem":1},{"text":"umeme wa radi na kuwafukuza.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mabonde ya bahari yalifunuliwa,","poem":1},{"text":"na misingi ya dunia ikawa wazi","poem":2},{"text":"kwa kukaripia kwake Bwana,","poem":1},{"text":"kwa uvumi wa pumzi kutoka puani mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Alinyoosha mkono kutoka juu na kunishika;","poem":1},{"text":"alinitoa kutoka kilindi cha maji makuu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Aliniokoa kutoka adui wangu mwenye nguvu nyingi,","poem":1},{"text":"kutoka adui zangu waliokuwa na nguvu nyingi kuliko mimi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Walinikabili siku ya msiba wangu,","poem":1},{"text":"lakini Bwana alikuwa msaada wangu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Alinileta nje mahali penye nafasi tele,","poem":1},{"text":"akaniokoa kwa kuwa alipendezwa nami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Bwana alinitendea sawasawa na uadilifu wangu;","poem":1},{"text":"sawasawa na usafi wa mikono yangu amenilipa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kwa maana nimezishika njia za Bwana;","poem":1},{"text":"sijatenda ubaya nikamwacha Mungu wangu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sheria zake zote zi mbele yangu,","poem":1},{"text":"wala sijayaacha maagizo yake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nimekuwa sina hatia mbele zake,","poem":1},{"text":"nami nimejilinda nisitende dhambi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bwana amenilipa sawasawa na uadilifu wangu,","poem":1},{"text":"sawasawa na usafi wangu machoni pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Kwa yeye aliye mwaminifu unajionyesha kuwa mwaminifu,","poem":1},{"text":"kwa asiye na hatia unajionyesha kutokuwa na hatia,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kwa aliye mtakatifu unajionyesha kuwa mtakatifu,","poem":1},{"text":"lakini kwa aliyepotoka unajionyesha kuwa mkaidi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wewe huwaokoa wanyenyekevu,","poem":1},{"text":"lakini macho yako ni juu ya wenye kiburi","poem":2},{"lineBreak":true},{"text":"ili uwashushe.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wewe ni taa yangu, Ee Bwana.","poem":1},{"text":"Bwana hulifanya giza langu","poem":2},{"lineBreak":true},{"text":"kuwa mwanga.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kwa msaada wako naweza kushinda jeshi,","poem":1},{"text":"nikiwa pamoja na Mungu wangu","poem":2},{"lineBreak":true},{"text":"nitaweza kuruka ukuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Kuhusu Mungu, njia yake ni kamilifu;","poem":1},{"text":"neno la Bwana halina dosari.","poem":2},{"text":"Yeye ni ngao kwa wote","poem":1},{"text":"wanaokimbilia kwake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kwa maana ni nani aliye Mungu","poem":1},{"text":"zaidi ya Bwana?","poem":2},{"text":"Ni nani aliye Mwamba","poem":1},{"text":"isipokuwa Mungu wetu?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mungu ndiye anivikaye nguvu","poem":1},{"text":"na kufanya njia yangu kuwa kamilifu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Huifanya miguu yangu kama miguu ya kulungu,","poem":1},{"text":"huniwezesha kusimama mahali palipo juu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Huifundisha mikono yangu kupigana vita;","poem":1},{"text":"mikono yangu inaweza kupinda upinde wa shaba.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Hunipa ngao yako ya ushindi,","poem":1},{"text":"unajishusha chini ili kuniinua.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Huyapanua mapito yangu,","poem":1},{"text":"ili miguu yangu isiteleze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“Niliwafuatia adui zangu na nikawaseta,","poem":1},{"text":"sikurudi nyuma mpaka walipoangamizwa.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Niliwaseta kabisa, nao hawakuweza kuinuka tena;","poem":1},{"text":"walianguka chini ya miguu yangu.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ulinivika nguvu kwa ajili ya kupigana vita;","poem":1},{"text":"uliwafanya adui zangu wasujudu miguuni pangu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Uliwafanya adui zangu wageuke na kukimbia,","poem":1},{"text":"nami nikawaangamiza adui zangu.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Walipiga yowe, lakini hapakuwepo na yeyote wa kuwaokoa;","poem":1},{"text":"walimlilia Bwana, lakini hakuwajibu.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Niliwaponda kama mavumbi ya nchi;","poem":1},{"text":"niliwaponda na kuwakanyaga kama tope barabarani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“Umeniokoa kutokana na mashambulizi ya watu wangu;","poem":1},{"text":"umenihifadhi mimi kama kiongozi wa mataifa.","poem":2},{"text":"Watu ambao sikuwajua wananitumikia,","poem":1}]},{"type":"verse","number":45,"content":[{"text":"nao wageni huja wakininyenyekea,","poem":2},{"lineBreak":true},{"text":"mara wanisikiapo, hunitii.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Wote wanalegea,","poem":1},{"text":"wanatoka katika ngome zao wakitetemeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Bwana yu hai! Sifa ni kwa Mwamba wangu!","poem":1},{"text":"Atukuzwe Mungu,","poem":2},{"lineBreak":true},{"text":"Mwamba, Mwokozi wangu!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Yeye ndiye Mungu anilipiziaye kisasi,","poem":1},{"text":"ayawekaye mataifa chini yangu,","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"aniwekaye huru toka kwa adui zangu.","poem":2},{"text":"Uliniinua juu ya adui zangu;","poem":1},{"text":"uliniokoa toka kwa watu wajeuri.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Kwa hiyo nitakusifu, Ee Bwana,","poem":1},{"text":"katikati ya mataifa;","poem":2},{"lineBreak":true},{"text":"nitaliimbia sifa jina lako.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Humpa mfalme wake ushindi mkuu;","poem":1},{"text":"huonyesha fadhili zake kwa mpakwa mafuta wake,","poem":2},{"lineBreak":true},{"text":"kwa Daudi na wazao wake milele.”","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, maana yake ni Shimo lisilo na mwisho.","reference":{"chapter":22,"verse":6}}]},"thisChapterLink":"/api/swh_bib/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}