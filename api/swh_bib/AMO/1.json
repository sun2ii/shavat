{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_bib","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"b013943d723e4665bfd19fa87671ba3b046d22d42d94f49722a13766e913829c","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Maneno ya Amosi, mmoja wa wachunga wanyama wa Tekoa: yale aliyoyaona kuhusu Israeli miaka miwili kabla ya tetemeko la ardhi, wakati Uzia alikuwa mfalme wa Yuda, na Yeroboamu mwana wa Yehoashi alikuwa mfalme wa Israeli."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["Alisema:",{"text":"“Bwana ananguruma toka Sayuni,","poem":1},{"text":"pia ananguruma kutoka Yerusalemu;","poem":2},{"text":"malisho ya wachunga wanyama yanakauka,","poem":1},{"text":"kilele cha Karmeli kinanyauka.”","poem":2}]},{"type":"heading","content":["Hukumu Juu Ya Majirani Wa Israeli"]},{"type":"verse","number":3,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kwa dhambi tatu za Dameski,","poem":1},{"text":"hata kwa dhambi nne, sitaizuia ghadhabu yangu.","poem":2},{"text":"Kwa sababu aliipura Gileadi","poem":1},{"text":"kwa vyombo vya chuma vyenye meno.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nitatuma moto juu ya nyumba ya Hazaeli","poem":1},{"text":"ambao utateketeza ngome za Ben-Hadadi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nitalivunja lango la Dameski;","poem":1},{"text":"nitamwangamiza mfalme aliyeko katika Bonde la Aveni,","poem":2},{"noteId":0},{"text":"na yeye ambaye anaishika fimbo ya utawala katika Beth-Edeni.","poem":1},{"text":"Watu wote wa Aramu watakwenda uhamishoni huko Kiri,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":6,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kwa dhambi tatu za Gaza,","poem":1},{"text":"hata kwa dhambi nne, sitaizuia ghadhabu yangu.","poem":2},{"text":"Kwa sababu walichukua mateka jumuiya nzima","poem":1},{"text":"na kuwauza kwa Edomu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nitatuma moto juu ya kuta za Gaza","poem":1},{"text":"ambao utateketeza ngome zake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nitamwangamiza mfalme wa Ashdodi","poem":1},{"text":"na yeye aishikaye fimbo ya utawala katika Ashkeloni.","poem":2},{"text":"Nitaugeuza mkono wangu dhidi ya Ekroni,","poem":1},{"text":"hadi Mfilisti wa mwisho atakapokufa,”","poem":2},{"text":"asema Bwana Mwenyezi.","poem":4}]},{"type":"verse","number":9,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kwa dhambi tatu za Tiro,","poem":1},{"text":"hata kwa dhambi nne, sitaizuia ghadhabu yangu.","poem":2},{"text":"Kwa sababu ameuza jumuiya nzima ya mateka kwa Edomu,","poem":1},{"text":"na kutokujali mapatano ya undugu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nitatuma moto kwenye kuta za Tiro","poem":1},{"text":"ambao utateketeza ngome zake.”","poem":2}]},{"type":"verse","number":11,"content":["Hili ndilo Bwana asemalo:",{"text":"“Kwa dhambi tatu za Edomu,","poem":1},{"text":"hata kwa dhambi nne, sitaizuia ghadhabu yangu.","poem":2},{"text":"Kwa sababu alimfuatia ndugu yake kwa upanga,","poem":1},{"text":"alikataa kuonyesha huruma yoyote,","poem":2},{"text":"kwa sababu hasira yake kali iliendelea kupanda wakati wote","poem":1},{"text":"na ghadhabu iliwaka bila kuzuiliwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitatuma moto juu ya Temani","poem":1},{"text":"ambao utateketeza ngome za Bosra.”","poem":2}]},{"type":"verse","number":13,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kwa dhambi tatu za Amoni,","poem":1},{"text":"hata kwa dhambi nne, sitaizuia ghadhabu yangu.","poem":2},{"text":"Kwa sababu aliwatumbua wanawake wajawazito wa Gileadi","poem":1},{"text":"ili kuongeza mipaka yake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitatuma moto kwenye kuta za Raba","poem":1},{"text":"ambao utateketeza ngome zake","poem":2},{"text":"katikati ya vilio vya vita katika siku ya mapigano,","poem":1},{"text":"katikati ya upepo mkali katika siku ya dhoruba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mfalme wake atakwenda uhamishoni,","poem":1},{"text":"yeye pamoja na maafisa wake,”","poem":2},{"text":"asema Bwana.","poem":4}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Bonde la Aveni maana yake Bonde la Uovu.","reference":{"chapter":1,"verse":5}}]},"thisChapterLink":"/api/swh_bib/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}