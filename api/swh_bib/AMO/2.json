{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_bib","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"b013943d723e4665bfd19fa87671ba3b046d22d42d94f49722a13766e913829c","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kwa dhambi tatu za Moabu,","poem":1},{"text":"hata kwa dhambi nne, sitaizuia ghadhabu yangu.","poem":2},{"text":"Kwa sababu alichoma mifupa ya mfalme wa Edomu,","poem":1},{"text":"ikawa kama chokaa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitatuma moto juu ya Moabu","poem":1},{"text":"ambao utateketeza ngome za Keriothi.","poem":2},{"text":"Moabu ataanguka kwa ghasia kubwa","poem":1},{"text":"katikati ya vilio vya vita na mlio wa tarumbeta.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nitamwangamiza mtawala wake","poem":1},{"text":"na kuwaua maafisa wake wote pamoja naye,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":4,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kwa dhambi tatu za Yuda,","poem":1},{"text":"hata kwa dhambi nne, sitaizuia ghadhabu yangu.","poem":2},{"text":"Kwa sababu wameikataa sheria ya Bwana","poem":1},{"text":"na hawakuzishika amri zake,","poem":2},{"text":"kwa sababu wamepotoshwa na miungu ya uongo,","poem":1},{"text":"miungu ambayo babu zao waliifuata.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nitatuma moto juu ya Yuda","poem":1},{"text":"ambao utateketeza ngome za Yerusalemu.”","poem":2}]},{"type":"heading","content":["Hukumu Juu Ya Israeli"]},{"type":"verse","number":6,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kwa dhambi tatu za Israeli,","poem":1},{"text":"hata kwa dhambi nne, sitaizuia ghadhabu yangu.","poem":2},{"text":"Wanawauza wenye haki kwa fedha,","poem":1},{"text":"na maskini kwa jozi ya viatu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wanakanyaga juu ya vichwa vya maskini,","poem":1},{"text":"kama vile juu ya mavumbi ya nchi,","poem":2},{"lineBreak":true},{"text":"na kukataa haki kwa walioonewa.","poem":2},{"text":"Baba na mwanawe hushiriki msichana mmoja,","poem":1},{"text":"kwa hivyo hulinajisi Jina langu takatifu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Watu hulala kando ya kila madhabahu","poem":1},{"text":"juu ya nguo zilizowekwa rehani.","poem":2},{"text":"Katika nyumba ya mungu wao hunywa mvinyo","poem":1},{"text":"ulionunuliwa kwa fedha walizotozwa watu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nilimwangamiza Mwamori mbele yao,","poem":1},{"text":"ingawa alikuwa mrefu kama mierezi,","poem":2},{"lineBreak":true},{"text":"na mwenye nguvu kama mialoni.","poem":2},{"text":"Niliyaangamiza matunda yake juu","poem":1},{"text":"na mizizi yake chini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Niliwapandisha toka Misri,","poem":1},{"text":"na nikawaongoza miaka arobaini jangwani","poem":2},{"lineBreak":true},{"text":"niwape nchi ya Waamori.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pia niliinua manabii kutoka miongoni mwa wana wenu","poem":1},{"text":"na Wanadhiri kutoka miongoni mwa vijana wenu.","poem":2},{"text":"Je, hii si kweli, enyi watu wa Israeli?”","poem":1},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":12,"content":[{"text":"“Lakini mliwafanya Wanadhiri kunywa mvinyo","poem":1},{"text":"na kuwaamuru manabii wasitoe unabii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Sasa basi, nitawaponda","poem":1},{"text":"kama gari lipondavyo wakati limejazwa nafaka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mkimbiaji hodari hatanusurika,","poem":1},{"text":"wenye nguvu wataishiwa nguvu zao,","poem":2},{"lineBreak":true},{"text":"na shujaa hataweza kuokoa maisha yake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mpiga upinde atakimbia,","poem":1},{"text":"askari wapiga mbio hawataweza kutoroka,","poem":2},{"lineBreak":true},{"text":"na mpanda farasi hataokoa maisha yake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hata askari walio mashujaa sana","poem":1},{"text":"siku hiyo watakimbia uchi,”","poem":2},{"text":"asema Bwana.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}