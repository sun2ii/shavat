{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_bib","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"b013943d723e4665bfd19fa87671ba3b046d22d42d94f49722a13766e913829c","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Mashahidi Waitwa Dhidi Ya Israeli"]},{"type":"verse","number":1,"content":["Sikilizeni neno hili alilosema Bwana dhidi yenu, enyi watu wa Israeli, dhidi ya jamaa nzima niliowapandisha toka Misri:"]},{"type":"verse","number":2,"content":[{"text":"“Ni ninyi tu niliowachagua","poem":1},{"text":"kati ya jamaa zote za dunia;","poem":2},{"text":"kwa hiyo nitawaadhibu","poem":1},{"text":"kwa ajili ya dhambi zenu zote.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Je, watu wawili hutembea pamoja","poem":1},{"text":"wasipokubaliana kufanya hivyo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Je, simba hunguruma katika kichaka","poem":1},{"text":"wakati hana mawindo?","poem":2},{"text":"Aweza kuvuma katika pango","poem":1},{"text":"wakati ambao hajakamata chochote?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Je, ndege aweza kuanguka kwenye mtego ulio ardhini","poem":1},{"text":"ambapo hajategewa chambo?","poem":2},{"text":"Je, mtego unaweza kufyatuka toka ardhini","poem":1},{"text":"wakati ambapo hakuna chochote cha kunasa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, tarumbeta inapopigwa mjini kujulisha hatari,","poem":1},{"text":"watu hawatetemeki?","poem":2},{"text":"Mji upatwapo na maafa,","poem":1},{"text":"je, si Bwana amesababisha?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hakika Bwana Mwenyezi hatafanya neno lolote","poem":1},{"text":"bila kuwafunulia watumishi wake manabii siri yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Simba amenguruma:","poem":1},{"text":"je, ni nani ambaye hataogopa?","poem":2},{"text":"Bwana Mwenyezi ametamka:","poem":1},{"text":"je, ni nani awezaye kukosa kutoa unabii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tangazeni katika ngome za Ashdodi","poem":1},{"text":"na katika ngome za Misri:","poem":2},{"text":"“Kusanyikeni juu ya milima ya Samaria;","poem":1},{"text":"angalieni wingi wa wasiwasi ulio ndani yake,","poem":2},{"lineBreak":true},{"text":"na uonevu ulio miongoni mwa watu wake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bwana asema: “Hawajui kutenda lililo jema,","poem":1},{"text":"wale ambao hujilundikia nyara","poem":2},{"lineBreak":true},{"text":"na vitu vilivyotekwa katika ngome zao.”","poem":2}]},{"type":"verse","number":11,"content":["Kwa hiyo hili ndilo asemalo Bwana Mwenyezi:",{"text":"“Adui ataizingira nchi;","poem":1},{"text":"ataangusha chini ngome zenu","poem":2},{"lineBreak":true},{"text":"na kuteka nyara maboma yenu.”","poem":2}]},{"type":"verse","number":12,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kama vile mchungaji aokoavyo kinywani mwa simba","poem":1},{"text":"vipande viwili tu vya mfupa wa mguu","poem":2},{"lineBreak":true},{"text":"au kipande cha sikio,","poem":2},{"text":"hivyo ndivyo Waisraeli watakavyookolewa,","poem":1},{"text":"wale wakaao Samaria","poem":2},{"lineBreak":true},{"text":"kwenye kingo za vitanda vyao,","poem":2},{"text":"na katika Dameski","poem":1},{"text":"kwenye viti vyao vya fahari.”","poem":2}]},{"type":"verse","number":13,"content":["“Sikia hili na ushuhudie dhidi ya nyumba ya Yakobo,” asema Bwana, Bwana Mungu Mwenye Nguvu Zote."]},{"type":"verse","number":14,"content":[{"text":"“Siku nitakapomwadhibu Israeli kwa sababu ya dhambi zake,","poem":1},{"text":"nitaharibu madhabahu za Betheli;","poem":2},{"text":"pembe za madhabahu zitakatiliwa mbali","poem":1},{"text":"na kuanguka chini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitabomoa nyumba ya wakati wa masika,","poem":1},{"text":"pamoja na nyumba ya wakati wa kiangazi;","poem":2},{"text":"nyumba zilizonakshiwa kwa pembe za ndovu","poem":1},{"text":"na majumba makubwa ya fahari yatabomolewa,”","poem":2},{"text":"asema Bwana.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}