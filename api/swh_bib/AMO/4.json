{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_bib","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"b013943d723e4665bfd19fa87671ba3b046d22d42d94f49722a13766e913829c","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["Israeli Hajarudi Kwa Mungu"]},{"type":"verse","number":1,"content":[{"text":"Sikilizeni neno hili, ninyi ngʼombe wa Bashani","poem":1},{"text":"mlioko juu ya Mlima Samaria,","poem":2},{"text":"ninyi wanawake mnaowaonea maskini,","poem":1},{"text":"na kuwagandamiza wahitaji,","poem":2},{"text":"na kuwaambia wanaume wenu,","poem":1},{"text":"“Tuleteeni vinywaji!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwana Mwenyezi ameapa kwa utakatifu wake:","poem":1},{"text":"“Hakika wakati utakuja","poem":2},{"text":"mtakapochukuliwa na kulabu,","poem":1},{"text":"na wanaosalia kwa ndoana za samaki.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nanyi mtakwenda moja kwa moja","poem":1},{"text":"kupitia mahali palipobomolewa kwenye ukuta,","poem":2},{"lineBreak":true},{"text":"nanyi mtatupwa nje kuelekea Harmoni,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nendeni Betheli mkatende dhambi;","poem":1},{"text":"nendeni Gilgali mkazidi kutenda dhambi.","poem":2},{"text":"Leteni dhabihu zenu kila asubuhi,","poem":1},{"text":"zaka zenu kila mwaka wa tatu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mchome mkate uliotiwa chachu kama sadaka ya shukrani,","poem":1},{"text":"jisifuni kuhusu sadaka zenu za hiari:","poem":2},{"text":"jigambeni kwa ajili ya sadaka hizo, enyi Waisraeli,","poem":1},{"text":"kwa kuwa hili ndilo mnalopenda kulitenda,”","poem":2},{"text":"asema Bwana Mwenyezi.","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Niliwapa njaa kwenye kila mji,","poem":1},{"text":"na ukosefu wa chakula katika kila mji,","poem":2},{"lineBreak":true},{"text":"hata hivyo bado hamjanirudia mimi,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Pia niliwazuilia ninyi mvua miezi mitatu","poem":1},{"text":"kabla ya kufikia mavuno.","poem":2},{"text":"Nilinyesha mvua kwenye mji mmoja,","poem":1},{"text":"lakini niliizuia mvua isinyeshe mji mwingine.","poem":2},{"text":"Shamba moja lilipata mvua,","poem":1},{"text":"na lingine halikupata, nalo likakauka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Watu walitangatanga mji hata mji kutafuta maji,","poem":1},{"text":"lakini hawakupata ya kuwatosha kunywa,","poem":2},{"lineBreak":true},{"text":"hata hivyo hamjanirudia mimi,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mara nyingi nilizipiga bustani zenu na mashamba ya mizabibu,","poem":1},{"text":"niliyapiga kwa kutu na ukungu.","poem":2},{"text":"Nzige walitafuna tini zenu na miti ya mizeituni,","poem":1},{"text":"hata hivyo hamjanirudia mimi,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Niliwapelekea tauni miongoni mwenu","poem":1},{"text":"kama nilivyofanya kule Misri.","poem":2},{"text":"Niliwaua vijana wenu wa kiume kwa upanga,","poem":1},{"text":"niliwachukua farasi wenu.","poem":2},{"text":"Nilijaza pua zenu kwa uvundo kutoka kwenye kambi zenu,","poem":1},{"text":"hata hivyo hamjanirudia mimi,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Niliwaangamiza baadhi yenu kama","poem":1},{"text":"nilivyoangamiza Sodoma na Gomora.","poem":2},{"text":"Mlikuwa kama kijiti kiwakacho kilichonyakuliwa motoni,","poem":1},{"text":"hata hivyo hamjanirudia,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kwa hiyo hili ndilo nitakalowafanyia, Israeli,","poem":1},{"text":"na kwa sababu nitawafanyia hili,","poem":2},{"lineBreak":true},{"text":"jiandaeni kukutana na Mungu wenu, ee Israeli.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yeye ambaye hufanya milima, anaumba upepo,","poem":1},{"text":"na kufunua mawazo yake kwa mwanadamu,","poem":2},{"text":"yeye ageuzaye asubuhi kuwa giza,","poem":1},{"text":"na kukanyaga mahali pa juu pa nchi:","poem":2},{"lineBreak":true},{"text":"Bwana Mungu Mwenye Nguvu Zote ndilo jina lake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}