{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_bib","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"b013943d723e4665bfd19fa87671ba3b046d22d42d94f49722a13766e913829c","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Maombolezo Na Wito Wa Toba"]},{"type":"verse","number":1,"content":["Sikia neno hili, ee nyumba ya Israeli, ombolezo hili ninalifanya kuwahusu ninyi:"]},{"type":"verse","number":2,"content":[{"text":"“Bikira Israeli ameanguka,","poem":1},{"text":"kamwe hatainuka tena,","poem":2},{"text":"ameachwa pweke katika nchi yake,","poem":1},{"text":"hakuna yeyote wa kumwinua.”","poem":2}]},{"type":"verse","number":3,"content":["Hili ndilo Bwana Mwenyezi asemalo:",{"text":"“Wakati mmoja wa miji yako utakapopeleka watu elfu moja vitani kwa ajili ya Israeli,","poem":1},{"text":"mia moja tu watarudi;","poem":2},{"text":"wakati mji utakapopeleka mia moja,","poem":1},{"text":"kumi tu ndio watarudi hai.”","poem":2}]},{"type":"verse","number":4,"content":["Hili ndilo Bwana asemalo kwa nyumba ya Israeli:",{"text":"“Nitafuteni mpate kuishi;","poem":1}]},{"type":"verse","number":5,"content":[{"text":"msitafute Betheli,","poem":2},{"text":"msiende Gilgali,","poem":1},{"text":"msisafiri kwenda Beer-Sheba.","poem":2},{"text":"Kwa maana kwa hakika Gilgali itakwenda uhamishoni,","poem":1},{"text":"na Betheli itafanywa kuwa si kitu.”","poem":2},{"noteId":1}]},{"type":"verse","number":6,"content":[{"text":"Mtafuteni Bwana mpate kuishi,","poem":1},{"text":"au atafagia nyumba ya Yosefu kama moto;","poem":2},{"text":"utawateketeza, nayo Betheli","poem":1},{"text":"haitakuwa na yeyote wa kuuzima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ninyi ambao mnageuza haki kuwa uchungu","poem":1},{"text":"na kuiangusha haki chini","poem":2}]},{"type":"verse","number":8,"content":[{"text":"(yeye ambaye alifanya Kilimia na Orioni,","poem":1},{"text":"ambaye hugeuza giza kuwa mapambazuko","poem":2},{"lineBreak":true},{"text":"na mchana kuwa usiku,","poem":2},{"text":"ambaye huyaita maji ya bahari","poem":1},{"text":"na kuyamwaga juu ya uso wa nchi:","poem":2},{"lineBreak":true},{"text":"Bwana ndilo jina lake;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yeye hufanya maangamizo kwenye ngome","poem":1},{"text":"na kufanya mji uliozungushiwa ngome kuwa ukiwa),","poem":2}]},{"type":"verse","number":10,"content":[{"text":"mnamchukia yule akemeaye mahakamani,","poem":1},{"text":"na kumdharau yule ambaye husema kweli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mnamgandamiza maskini","poem":1},{"text":"na kumlazimisha awape nafaka.","poem":2},{"text":"Kwa hiyo, ingawa mmejenga majumba ya mawe ya fahari,","poem":1},{"text":"hamtaishi ndani yake;","poem":2},{"text":"ingawa mmepanda mashamba mazuri ya mizabibu,","poem":1},{"text":"hamtakunywa divai yake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa kuwa ninajua hesabu ya makosa yenu","poem":1},{"text":"na ukubwa wa dhambi zenu.","poem":2},{"lineBreak":true},{"text":"Mmewaonea wenye haki na kupokea rushwa","poem":1},{"text":"na kuzuia haki ya maskini mahakamani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa hiyo mtu mwenye busara hunyamaza kimya nyakati kama hizo,","poem":1},{"text":"kwa kuwa nyakati ni mbaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Tafuteni mema, wala si mabaya,","poem":1},{"text":"ili mpate kuishi.","poem":2},{"text":"Ndipo Bwana Mungu Mwenye Nguvu Zote atakuwa pamoja nanyi,","poem":1},{"text":"kama msemavyo yupo nanyi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yachukieni maovu, yapendeni mema;","poem":1},{"text":"dumisheni haki mahakamani.","poem":2},{"text":"Yamkini Bwana Mungu Mwenye Nguvu Zote","poem":1},{"text":"atawahurumia mabaki ya Yosefu.","poem":2}]},{"type":"verse","number":16,"content":["Kwa hiyo hili ndilo Bwana, Bwana Mungu Mwenye Nguvu Zote, asemalo:",{"text":"“Kutakuwepo maombolezo katika barabara zote","poem":1},{"text":"na vilio vya uchungu katika njia kuu zote.","poem":2},{"text":"Wakulima wataitwa kuja kulia,","poem":1},{"text":"na waombolezaji waje kuomboleza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kutakuwepo kuomboleza katika mashamba yote ya mizabibu,","poem":1},{"text":"kwa kuwa nitapita katikati yenu,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"heading","content":["Siku Ya Bwana"]},{"type":"verse","number":18,"content":[{"text":"Ole wenu ninyi mnaoitamani","poem":1},{"text":"siku ya Bwana!","poem":2},{"text":"Kwa nini mnaitamani siku ya Bwana?","poem":1},{"text":"Siku hiyo itakuwa giza, si nuru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Itakuwa kama vile mtu aliyemkimbia simba","poem":1},{"text":"kumbe akakutana na dubu,","poem":2},{"text":"kama vile mtu aliyeingia nyumbani mwake","poem":1},{"text":"na kuupumzisha mkono wake kwenye ukuta,","poem":2},{"lineBreak":true},{"text":"kumbe akaumwa na nyoka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Je, siku ya Bwana haitakuwa giza, na si nuru:","poem":1},{"text":"giza nene, bila mwonzi wa mwanga?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Ninachukia, ninazidharau sikukuu zenu za dini;","poem":1},{"text":"siwezi kuvumilia makusanyiko yenu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hata ingawa mnaniletea sadaka zenu za kuteketezwa na sadaka za nafaka,","poem":1},{"text":"sitazikubali.","poem":2},{"text":"Ingawa mnaniletea sadaka nzuri za amani,","poem":1},{"text":"sitazitambua.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Niondoleeni kelele za nyimbo zenu!","poem":1},{"text":"Sitasikiliza sauti za vinubi vyenu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lakini acheni haki itiririke kama mto,","poem":1},{"text":"na uadilifu uwe kama kijito kisichokauka!","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Je, mliniletea dhabihu na sadaka","poem":1},{"text":"kwa miaka arobaini kule jangwani,","poem":2},{"lineBreak":true},{"text":"ee nyumba ya Israeli?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mmeyainua madhabahu ya mfalme wenu,","poem":1},{"text":"Sikuthi mungu wenu mtawala,","poem":2},{"text":"na Kiuni mungu wenu wa nyota,","poem":1},{"text":"ambao mliwatengeneza wenyewe.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kwa sababu hiyo nitawapeleka uhamishoni mbali kupita Dameski,”","poem":1},{"text":"asema Bwana, ambaye jina lake ni Mungu Mwenye Nguvu Zote.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Yaani Aveni kwa Kiebrania, kumaanisha Beth-Aveni, jina lingine la Betheli kwa dhihaka.","reference":{"chapter":5,"verse":5}}]},"thisChapterLink":"/api/swh_bib/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}