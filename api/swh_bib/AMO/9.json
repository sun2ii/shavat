{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_bib","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"b013943d723e4665bfd19fa87671ba3b046d22d42d94f49722a13766e913829c","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_bib/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Israeli Kuangamizwa"]},{"type":"verse","number":1,"content":["Nilimwona Bwana akiwa amesimama kando ya madhabahu, naye akasema:",{"text":"“Piga vichwa vya nguzo","poem":1},{"text":"ili vizingiti vitikisike.","poem":2},{"text":"Viangushe juu ya vichwa vya watu wote;","poem":1},{"text":"na wale watakaosalia nitawaua kwa upanga.","poem":2},{"text":"Hakuna awaye yote atakayekimbia,","poem":1},{"text":"hakuna atakayetoroka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wajapojichimbia chini mpaka kwenye vina vya kuzimu,","poem":1},{"text":"kutoka huko mkono wangu utawatoa.","poem":2},{"text":"Wajapopanda juu hadi kwenye mbingu,","poem":1},{"text":"kutoka huko nitawashusha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wajapojificha juu ya kilele cha Karmeli,","poem":1},{"text":"huko nitawawinda na kuwakamata.","poem":2},{"text":"Wajapojificha kutoka kwenye uso wangu","poem":1},{"text":"katika vilindi vya bahari,","poem":2},{"lineBreak":true},{"text":"huko nako nitaamuru joka kuwauma.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wajapopelekwa uhamishoni na adui zao,","poem":1},{"text":"huko nako nitaamuru upanga uwaue.","poem":2},{"text":"Nitawakazia macho yangu kwa mabaya","poem":1},{"text":"wala si kwa mazuri.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwana, Bwana Mwenye Nguvu Zote,","poem":1},{"text":"yeye agusaye dunia nayo ikayeyuka,","poem":2},{"lineBreak":true},{"text":"na wote wakaao ndani mwake wakaomboleza:","poem":2},{"text":"nayo nchi yote huinuka kama Naili,","poem":1},{"text":"kisha hushuka kama mto wa Misri;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"yeye ambaye hujenga jumba lake la kifalme katika mbingu","poem":1},{"text":"na kuisimika misingi yake juu ya dunia,","poem":2},{"text":"yeye aitaye maji ya bahari","poem":1},{"text":"na kuyamwaga juu ya uso wa nchi:","poem":2},{"lineBreak":true},{"text":"Bwana ndilo jina lake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Je, Waisraeli,","poem":1},{"text":"ninyi si sawa kwangu kama Wakushi?”","poem":2},{"text":"asema Bwana.","poem":4},{"text":"“Je, sikuleta Israeli kutoka Misri,","poem":1},{"text":"Wafilisti kutoka Kaftori,","poem":2},{"noteId":2},{"lineBreak":true},{"text":"na Washamu kutoka Kiri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Hakika macho ya Bwana Mwenyezi","poem":1},{"text":"yako juu ya ufalme wenye dhambi.","poem":2},{"text":"Nami nitauangamiza","poem":1},{"text":"kutoka kwenye uso wa dunia:","poem":2},{"text":"hata hivyo sitaiangamiza kabisa","poem":1},{"text":"nyumba ya Yakobo,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"“Kwa kuwa nitatoa amri,","poem":1},{"text":"na nitaipepeta nyumba ya Israeli","poem":2},{"lineBreak":true},{"text":"miongoni mwa mataifa yote,","poem":2},{"text":"kama vile nafaka ipepetwavyo katika ungo,","poem":1},{"text":"na hakuna hata punje moja itakayoanguka chini.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watenda dhambi wote miongoni mwa watu wangu","poem":1},{"text":"watauawa kwa upanga,","poem":2},{"text":"wale wote wasemao,","poem":1},{"text":"‘Maafa hayatatupata wala kutukuta.’","poem":2}]},{"type":"heading","content":["Kurejezwa Kwa Israeli"]},{"type":"verse","number":11,"content":[{"text":"“Katika siku ile nitaisimamisha","poem":1},{"text":"hema ya Daudi iliyoanguka.","poem":2},{"text":"Nitakarabati mahali palipobomoka","poem":1},{"text":"na kujenga upya magofu yake,","poem":2},{"lineBreak":true},{"text":"na kuijenga kama ilivyokuwa awali,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ili wapate kuyamiliki mabaki ya Edomu,","poem":1},{"text":"na mataifa yote yale yanayobeba Jina langu,”","poem":2},{"text":"asema Bwana ambaye atafanya mambo haya.","poem":4}]},{"type":"verse","number":13,"content":["“Siku zinakuja,” asema Bwana,",{"text":"“wakati mvunaji atatanguliwa na mkulima,","poem":1},{"text":"naye mpanzi atatanguliwa na yeye akamuaye zabibu.","poem":2},{"text":"Divai mpya itadondoka kutoka milimani,","poem":1},{"text":"na kutiririka kutoka vilima vyote.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitawarejesha tena watu wangu Israeli waliohamishwa;","poem":1},{"text":"wataijenga tena miji iliyoachwa magofu,","poem":2},{"lineBreak":true},{"text":"nao wataishi ndani mwake.","poem":2},{"text":"Watapanda mizabibu na kunywa divai yake;","poem":1},{"text":"watalima bustani na kula matunda yake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitaipanda Israeli katika nchi yao wenyewe,","poem":1},{"text":"hawatangʼolewa tena","poem":2},{"lineBreak":true},{"text":"kutoka nchi ambayo nimewapa,”","poem":2},{"lineBreak":true},{"text":"asema Bwana Mungu wenu.","poem":4}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Yaani Krete.","reference":{"chapter":9,"verse":7}}]},"thisChapterLink":"/api/swh_bib/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}