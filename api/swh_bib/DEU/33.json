{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"DEU","translationId":"swh_bib","name":"Kumbukumbu La Torati","commonName":"Kumbukumbu La Torati","title":"Kumbukumbu La Torati","order":5,"numberOfChapters":34,"sha256":"0cc3b46a1d9492b74f04ef61f530f90a52a9739c71eb99f9e6da98db76053b7c","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/swh_bib/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["Mose Anayabariki Makabila"]},{"type":"verse","number":1,"content":["Hii ndiyo baraka Mose mtu wa Mungu aliyotamka kwa Waisraeli kabla ya kifo chake."]},{"type":"verse","number":2,"content":["Alisema:",{"text":"“Bwana alikuja kutoka Mlima Sinai,","poem":1},{"text":"akachomoza kama jua juu yao","poem":2},{"lineBreak":true},{"text":"kutoka Mlima Seiri,","poem":2},{"lineBreak":true},{"text":"akaangaza kutoka Mlima Parani.","poem":2},{"text":"Alikuja pamoja na watakatifu makumi elfu","poem":1},{"text":"kutoka kusini,","poem":2},{"lineBreak":true},{"text":"kutoka materemko ya mlima wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hakika ni wewe ambaye huwapenda watu,","poem":1},{"text":"watakatifu wako wote wamo mkononi mwako.","poem":2},{"text":"Miguuni pako wote wanasujudu","poem":1},{"text":"na kutoka kwako wanapokea mafundisho,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"sheria ile Mose aliyotupa sisi,","poem":1},{"text":"tulio milki ya kusanyiko la Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Alikuwa mfalme juu ya Yeshuruni","poem":1},{"noteId":9},{"text":"wakati viongozi wa watu walipokusanyika,","poem":2},{"lineBreak":true},{"text":"pamoja na makabila ya Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Reubeni na aishi, asife,","poem":1},{"text":"wala watu wake wasiwe wachache.”","poem":2}]},{"type":"verse","number":7,"content":["Akasema hili kuhusu Yuda:",{"text":"“Ee Bwana, sikia kilio cha Yuda,","poem":1},{"text":"mlete kwa watu wake.","poem":2},{"text":"Kwa mikono yake mwenyewe hujitetea.","poem":1},{"text":"Naam, uwe msaada wake","poem":2},{"lineBreak":true},{"text":"dhidi ya adui zake!”","poem":2}]},{"type":"verse","number":8,"content":["Kuhusu Lawi alisema:",{"text":"“Thumimu yako na Urimu","poem":1},{"noteId":10},{"text":"yako ulimpa,","poem":1},{"text":"mtu yule uliyemfadhili.","poem":2},{"text":"Ulimjaribu huko Masa","poem":1},{"text":"na kushindana naye","poem":2},{"lineBreak":true},{"text":"kwenye maji ya Meriba.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alinena hivi kuhusu baba yake na mama yake,","poem":1},{"text":"‘Mimi siwahitaji kamwe.’","poem":2},{"text":"Akawasahau jamaa zake,","poem":1},{"text":"asiwatambue hata watoto wake,","poem":2},{"text":"lakini akaliangalia neno lako","poem":1},{"text":"na kulilinda Agano lako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Humfundisha Yakobo mausia yako","poem":1},{"text":"na Israeli sheria yako.","poem":2},{"text":"Hufukiza uvumba mbele zako","poem":1},{"text":"na sadaka nzima za kuteketezwa","poem":2},{"lineBreak":true},{"text":"juu ya madhabahu yako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Bwana, bariki ustadi wake wote,","poem":1},{"text":"nawe upendezwe na kazi ya mikono yake.","poem":2},{"text":"Vipige viuno vya wale wainukao dhidi yake;","poem":1},{"text":"wapige adui zake hata wasiinuke tena.”","poem":2}]},{"type":"verse","number":12,"content":["Kuhusu Benyamini akasema:",{"text":"“Mwache mpenzi wa Bwana","poem":1},{"text":"apumzike salama kwake,","poem":2},{"text":"kwa maana humkinga mchana kutwa,","poem":1},{"text":"na yule Bwana ampendaye","poem":2},{"lineBreak":true},{"text":"hupumzika kati ya mabega yake.”","poem":2}]},{"type":"verse","number":13,"content":["Kuhusu Yosefu akasema:",{"text":"“Bwana na aibariki nchi yake","poem":1},{"text":"kwa umande wa thamani","poem":2},{"lineBreak":true},{"text":"kutoka mbinguni juu,","poem":2},{"text":"na vilindi vya maji","poem":1},{"text":"vilivyotulia chini;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"pamoja na vitu vilivyo bora sana","poem":1},{"text":"viletwavyo na jua,","poem":2},{"text":"na vitu vizuri sana vinavyoweza","poem":1},{"text":"kutolewa na mwezi;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"pamoja na zawadi bora sana","poem":1},{"text":"za milima ya zamani","poem":2},{"text":"na kwa wingi wa baraka","poem":1},{"text":"za vilima vya milele;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"pamoja na baraka nzuri mno","poem":1},{"text":"za ardhi na ukamilifu wake,","poem":2},{"text":"na upendeleo wake yeye","poem":1},{"text":"aliyeishi kwenye kichaka","poem":2},{"lineBreak":true},{"text":"kilichokuwa kinawaka moto.","poem":2},{"text":"Hivi vyote na vikae juu ya kichwa cha Yosefu,","poem":1},{"text":"juu ya paji la uso la aliye mkuu","poem":2},{"lineBreak":true},{"text":"miongoni mwa ndugu zake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Katika fahari yeye ni kama fahali mzaliwa wa kwanza;","poem":1},{"text":"pembe zake ni pembe za nyati,","poem":2},{"text":"na kwa pembe hizo atapiga mataifa,","poem":1},{"text":"hata yaliyo miisho ya dunia.","poem":2},{"text":"Hivyo ndivyo yalivyo makumi elfu ya Efraimu;","poem":1},{"text":"hivyo ndivyo yalivyo maelfu ya Manase.”","poem":2}]},{"type":"verse","number":18,"content":["Kuhusu Zabuloni akasema:",{"text":"“Shangilia, Zabuloni, wakati wa kutoka nje,","poem":1},{"text":"nawe Isakari, katika mahema yako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Watawaita mataifa kwenye mlima,","poem":1},{"text":"na huko mtatoa dhabihu za haki;","poem":2},{"text":"watajifurahisha kwa wingi uliojaza bahari,","poem":1},{"text":"kwa hazina zilizofichwa mchangani.”","poem":2}]},{"type":"verse","number":20,"content":["Kuhusu Gadi akasema:",{"text":"“Atabarikiwa yeye aongezaye milki ya Gadi!","poem":1},{"text":"Gadi huishi huko kama simba,","poem":2},{"lineBreak":true},{"text":"akirarua kwenye mkono au kichwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Alijichagulia nchi nzuri kuliko zote","poem":1},{"text":"kwa ajili yake mwenyewe;","poem":2},{"text":"fungu la kiongozi lilikuwa limehifadhiwa","poem":1},{"text":"kwa ajili yake.","poem":2},{"text":"Viongozi wa watu walipokusanyika,","poem":1},{"text":"alitimiza haki ya mapenzi ya Bwana,","poem":2},{"lineBreak":true},{"text":"na hukumu zake kuhusu Israeli.”","poem":2}]},{"type":"verse","number":22,"content":["Kuhusu Dani akasema:",{"text":"“Dani ni mwana simba,","poem":1},{"text":"akiruka kutoka Bashani.”","poem":2}]},{"type":"verse","number":23,"content":["Kuhusu Naftali akasema:",{"text":"“Naftali amejaa tele upendeleo wa Bwana,","poem":1},{"text":"naye amejaa baraka yake;","poem":2},{"lineBreak":true},{"text":"atarithi magharibi na kusini.”","poem":2}]},{"type":"verse","number":24,"content":["Kuhusu Asheri akasema:",{"text":"“Aliyebarikiwa zaidi sana katika wana ni Asheri;","poem":1},{"text":"yeye na apate upendeleo kwa ndugu zake,","poem":2},{"lineBreak":true},{"text":"yeye na anawe miguu yake kwenye mafuta.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Makomeo ya malango yako yawe chuma na shaba,","poem":1},{"text":"nazo nguvu zako zitakuwa sawa na siku zako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Hakuna mwingine kama Mungu wa Yeshuruni,","poem":1},{"text":"ambaye hupanda juu ya mbingu ili akusaidie,","poem":2},{"lineBreak":true},{"text":"na juu ya mawingu katika utukufu wake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mungu wa milele ni kimbilio lako,","poem":1},{"text":"na chini kuna mikono ya milele.","poem":2},{"text":"Atamfukuza adui yako mbele yako,","poem":1},{"text":"akisema, ‘Mwangamize yeye!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Hivyo Israeli ataishi salama peke yake.","poem":1},{"text":"Mzao wa Yakobo ni salama","poem":2},{"text":"katika nchi ya nafaka na divai mpya,","poem":1},{"text":"mahali ambapo mbingu","poem":2},{"lineBreak":true},{"text":"hudondosha umande.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ee Israeli, wewe umebarikiwa!","poem":1},{"text":"Ni nani kama wewe,","poem":2},{"lineBreak":true},{"text":"taifa lililookolewa na Bwana?","poem":2},{"text":"Yeye ni ngao yako na msaada wako,","poem":1},{"text":"na upanga wako uliotukuka.","poem":2},{"text":"Adui zako watatetemeka mbele yako,","poem":1},{"text":"nawe utapakanyaga","poem":2},{"lineBreak":true},{"text":"mahali pao pa juu.”","poem":2},{"noteId":11}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Yeshuruni maana yake ni Yeye aliye mnyofu, yaani Israeli.","reference":{"chapter":33,"verse":5}},{"noteId":10,"caller":"+","text":"Thumimu na Urimu maana yake Nuru na Kweli; vifaa hivi viliwekwa kwenye kifuko cha kifuani cha kisibau cha kuhani mkuu ili kujua mapenzi ya Mungu kwenye mambo ya kutatanisha.","reference":{"chapter":33,"verse":8}},{"noteId":11,"caller":"+","text":"Utapakanyaga mahali pao pa juu maana yake mtakanyaga juu ya miili yao.","reference":{"chapter":33,"verse":29}}]},"thisChapterLink":"/api/swh_bib/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}