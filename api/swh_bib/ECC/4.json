{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ECC","translationId":"swh_bib","name":"Mhubiri","commonName":"Mhubiri","title":"Mhubiri","order":21,"numberOfChapters":12,"sha256":"965522668421958ee72e29b419420f7b07bc8c521a1ba3dc695febcfc0bd5b4b","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/swh_bib/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["Uonevu, Taabu, Uadui"]},{"type":"verse","number":1,"content":["Nikatazama tena nikaona uonevu wote uliokuwa unafanyika chini ya jua:",{"text":"Nikaona machozi ya walioonewa,","poem":1},{"text":"wala hawana wa kuwafariji;","poem":2},{"text":"uwezo ulikuwa upande wa wale wanaowaonea,","poem":1},{"text":"wala hawana wa kuwafariji.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nami nikasema kwamba wafu,","poem":1},{"text":"waliokwisha kufa,","poem":2},{"text":"wana furaha kuliko watu walio hai,","poem":1},{"text":"ambao bado wanaishi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lakini aliye bora kuliko hao wawili","poem":1},{"text":"ni yule ambaye hajazaliwa bado,","poem":2},{"text":"ambaye hajaona ule uovu","poem":1},{"text":"unaofanyika chini ya jua.","poem":2}]},{"type":"verse","number":4,"content":["Tena nikaona kuwa kazi zote na mafanikio yote huchipuka kutokana na wivu wa mtu kwa jirani yake. Hili nalo ni ubatili, ni kukimbiza upepo."]},{"type":"verse","number":5,"content":[{"text":"Mpumbavu hukunja mikono yake","poem":1},{"text":"na kujiangamiza mwenyewe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Afadhali konzi moja pamoja","poem":1},{"text":"na utulivu kuliko konzi mbili pamoja na taabu","poem":2},{"lineBreak":true},{"text":"na kukimbiza upepo.","poem":2}]},{"type":"verse","number":7,"content":["Tena nikaona kitu kingine kilicho ubatili chini ya jua:"]},{"type":"verse","number":8,"content":[{"text":"Kulikuwepo mwanadamu aliye peke yake,","poem":1},{"text":"hakuwa na mwana wala ndugu.","poem":2},{"text":"Hapakuwa na mwisho wa kazi yake,","poem":1},{"text":"hata hivyo macho yake","poem":2},{"lineBreak":true},{"text":"hayakutosheka na utajiri wake.","poem":2},{"text":"Aliuliza, “Ninajitaabisha hivi kwa ajili ya nani,","poem":1},{"text":"nami kwa nini ninajinyima kufurahia?”","poem":2},{"text":"Hili pia ni ubatili,","poem":1},{"text":"ni shughuli yenye taabu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wawili ni afadhali kuliko mmoja,","poem":1},{"text":"kwa sababu wana malipo mazuri kwa kazi yao:","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kama mmoja akianguka,","poem":1},{"text":"mwenzake atamwinua.","poem":2},{"text":"Lakini ni jambo la kuhuzunisha","poem":1},{"text":"kwa mtu yule aangukaye","poem":2},{"lineBreak":true},{"text":"naye hana wa kumwinua!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pia, kama wawili wakilala pamoja","poem":1},{"text":"watapashana joto.","poem":2},{"text":"Lakini ni vipi mtu aweza","poem":1},{"text":"kujipasha joto mwenyewe?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ingawa mtu mmoja aweza kushindwa,","poem":1},{"text":"watu wawili wanaweza","poem":2},{"lineBreak":true},{"text":"kumkabili adui na kumshinda.","poem":2},{"text":"Kamba ya nyuzi tatu","poem":1},{"text":"haikatiki kwa urahisi.","poem":2}]},{"type":"heading","content":["Maendeleo Ni Ubatili"]},{"type":"verse","number":13,"content":["Afadhali kijana maskini mwenye hekima kuliko mfalme mzee mpumbavu ambaye hajui tena kupokea maonyo."]},{"type":"verse","number":14,"content":["Kijana huyo angeweza kutokea gerezani akapata ufalme, au angeweza kuwa amezaliwa katika umaskini kwenye huo ufalme."]},{"type":"verse","number":15,"content":["Nikaona kwamba wote walioishi na kutembea chini ya jua walimfuata kijana, aliyepokea ufalme."]},{"type":"verse","number":16,"content":["Hapakuwa na kikomo cha watu wote aliowatawala. Lakini wale waliokuja baadaye hawakufurahia kazi ya yule aliyepokea ufalme. Hili nalo pia ni ubatili, ni kukimbiza upepo."]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}