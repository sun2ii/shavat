{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"EXO","translationId":"swh_bib","name":"Kutoka","commonName":"Kutoka","title":"Kutoka","order":2,"numberOfChapters":40,"sha256":"e66d2a2d276c2d431982aa24ac9008983eab775c38ea535a663fdfe78e1f572f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/swh_bib/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Wimbo Wa Mose Na Miriamu"]},{"type":"verse","number":1,"content":["Ndipo Mose na Waisraeli wakamwimbia Bwana wimbo huu:",{"text":"“Nitamwimbia Bwana,","poem":1},{"text":"kwa kuwa ametukuzwa sana.","poem":2},{"text":"Farasi na mpanda farasi","poem":1},{"text":"amewatosa baharini.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwana ni nguvu zangu na wimbo wangu;","poem":1},{"text":"amekuwa wokovu wangu.","poem":2},{"text":"Yeye ni Mungu wangu, nami nitamsifu,","poem":1},{"text":"Mungu wa baba yangu, nami nitamtukuza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bwana ni shujaa wa vita;","poem":1},{"text":"Bwana ndilo jina lake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Magari ya vita ya Farao na jeshi lake","poem":1},{"text":"amewatosa baharini.","poem":2},{"text":"Maafisa wa Farao walio bora sana","poem":1},{"text":"wamezamishwa katika Bahari ya Shamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maji yenye kina yamewafunika,","poem":1},{"text":"wamezama mpaka vilindini kama jiwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mkono wako wa kuume, Ee Bwana","poem":1},{"text":"ulitukuka kwa uweza.","poem":2},{"text":"Mkono wako wa kuume, Ee Bwana,","poem":1},{"text":"ukamponda adui.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katika ukuu wa utukufu wako,","poem":1},{"text":"ukawaangusha chini wale waliokupinga.","poem":2},{"text":"Uliachia hasira yako kali,","poem":1},{"text":"ikawateketeza kama kapi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa pumzi ya pua zako","poem":1},{"text":"maji yalijilundika.","poem":2},{"text":"Mawimbi ya maji yakasimama imara kama ukuta,","poem":1},{"text":"vilindi vikagandamana ndani ya moyo wa bahari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Adui alijivuna,","poem":1},{"text":"‘Nitawafuatia, nitawapata.","poem":2},{"text":"Nitagawanya nyara;","poem":1},{"text":"nitajishibisha kwa wao.","poem":2},{"text":"Nitafuta upanga wangu","poem":1},{"text":"na mkono wangu utawaangamiza.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini ulipuliza kwa pumzi yako,","poem":1},{"text":"bahari ikawafunika.","poem":2},{"text":"Wakazama kama risasi","poem":1},{"text":"kwenye maji makuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ni nani miongoni mwa miungu aliye kama wewe, Ee Bwana?","poem":1},{"text":"Ni nani kama Wewe:","poem":2},{"text":"uliyetukuka katika utakatifu,","poem":3},{"lineBreak":true},{"text":"utishaye katika utukufu,","poem":3},{"lineBreak":true},{"text":"ukitenda maajabu?","poem":3}]},{"type":"verse","number":12,"content":[{"text":"Uliunyoosha mkono wako wa kuume","poem":1},{"text":"na nchi ikawameza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Katika upendo wako usiokoma utawaongoza","poem":1},{"text":"watu uliowakomboa.","poem":2},{"text":"Katika nguvu zako utawaongoza","poem":1},{"text":"mpaka makao yako matakatifu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mataifa watasikia na kutetemeka,","poem":1},{"text":"uchungu utawakamata watu wa Ufilisti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wakuu wa Edomu wataogopa,","poem":1},{"text":"viongozi wa Moabu watatetemeka kwa hofu,","poem":2},{"text":"watu wa Kanaani watayeyuka,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"vitisho na hofu vitawaangukia.","poem":2},{"text":"Kwa nguvu ya mkono wako","poem":1},{"text":"watatulia kama jiwe,","poem":2},{"text":"mpaka watu wako waishe kupita, Ee Bwana,","poem":1},{"text":"mpaka watu uliowanunua wapite.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Utawaingiza na kuwapandikiza","poem":1},{"text":"juu ya mlima wa urithi wako:","poem":2},{"text":"hapo mahali, Ee Bwana, ulipopafanya kuwa makao yako,","poem":1},{"text":"mahali patakatifu, Ee Bwana, ulipopajenga kwa mikono yako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bwana atatawala","poem":1},{"text":"milele na milele.”","poem":2}]},{"type":"verse","number":19,"content":["Farasi wa Farao, magari yake ya vita na wapanda farasi wake walipoingia baharini, Bwana aliyarudisha maji ya bahari yakawafunika, lakini wana wa Israeli walipita baharini mahali pakavu."]},{"type":"verse","number":20,"content":["Kisha Miriamu yule nabii mke, ndugu yake Aroni, akachukua matari mkononi mwake na wanawake wote wakamfuata na matari yao wakicheza."]},{"type":"verse","number":21,"content":["Miriamu akawaimbia:",{"text":"“Mwimbieni Bwana,","poem":1},{"text":"kwa maana ametukuka sana.","poem":2},{"text":"Farasi na mpanda farasi","poem":1},{"text":"amewatosa baharini.”","poem":2}]},{"type":"heading","content":["Maji Ya Mara Na Elimu"]},{"type":"verse","number":22,"content":["Kisha Mose akawaongoza Israeli kutoka Bahari ya Shamu na kuingia katika Jangwa la Shuri. Kwa siku tatu walisafiri jangwani bila kupata maji."]},{"type":"verse","number":23,"content":["Walipofika Mara, hawakuweza kunywa maji yake kwa sababu yalikuwa machungu. (Ndiyo sababu mahali hapo panaitwa Mara",{"noteId":2},")"]},{"type":"verse","number":24,"content":["Kwa hiyo watu wakamnungʼunikia Mose, wakisema, “Tunywe nini?”"]},{"type":"verse","number":25,"content":["Ndipo Mose akamlilia Bwana, naye Bwana akamwonyesha kipande cha mti. Akakitupa ndani ya maji, nayo maji yakawa matamu. Huko Bwana akawapa amri na sheria na huko akawajaribu."]},{"type":"verse","number":26,"content":["Mungu akasema, “Kama mkisikiliza kwa bidii sauti ya Bwana Mungu wenu na kuyafanya yaliyo sawa machoni pake, kama mkiyatii maagizo yake na kuzishika amri zake zote, sitaleta juu yenu ugonjwa wowote niliowaletea Wamisri, kwa kuwa Mimi ndimi Bwana, niwaponyaye.”"]},{"type":"verse","number":27,"content":["Kisha wakafika Elimu, mahali palipokuwa na chemchemi kumi na mbili, na miti sabini ya mitende, wakapiga kambi huko karibu na maji."]}],"footnotes":[{"noteId":2,"caller":"+","text":"Mara maana yake ni Chungu.","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/swh_bib/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}