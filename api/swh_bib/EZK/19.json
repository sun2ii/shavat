yake alipongoja na kuona tumaini lake halitimiziki,","poem":1},{"text":"nayo matarajio yake yametoweka,","poem":2},{"text":"akamchukua mwanawe mwingine","poem":1},{"text":"na kumfanya simba mwenye nguvu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alizungukazunguka miongoni mwa simba,","poem":1},{"text":"kwa kuwa sasa alikuwa simba mwenye nguvu.","poem":2},{"text":"Akajifunza kurarua mawindo","poem":1},{"text":"naye akala watu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akabomoa ngome zao","poem":1},{"text":"na kuiharibu miji yao.","poem":2},{"text":"Nchi na wote waliokuwa ndani yake","poem":1},{"text":"wakatiwa hofu kwa kunguruma kwake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kisha mataifa wakaja dhidi yake","poem":1},{"text":"kutoka sehemu zilizomzunguka.","poem":2},{"text":"Wakatanda nyavu zao kwa ajili yake,","poem":1},{"text":"naye akanaswa katika shimo lao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa kutumia ndoana wakamvutia kwenye tundu","poem":1},{"text":"na kumleta mpaka kwa mfalme wa Babeli.","poem":2},{"text":"Wakamtia gerezani, hivyo kunguruma kwake","poem":1},{"text":"hakukusikika tena","poem":2},{"lineBreak":true},{"text":"katika milima ya Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Mama yako alikuwa kama mzabibu","poem":1},{"text":"katika shamba lako la mizabibu","poem":2},{"lineBreak":true},{"text":"uliopandwa kando ya maji,","poem":2},{"text":"ukiwa unazaa sana na wenye matawi mengi","poem":1},{"text":"kwa sababu ya wingi wa maji.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Matawi yake yalikuwa na nguvu,","poem":1},{"text":"yaliyofaa kuwa fimbo ya enzi ya mtawala.","poem":2},{"text":"Ulikuwa mrefu kupita miti mingine","poem":1},{"text":"katikati ya matawi manene;","poem":2},{"text":"ulionekana kwa urahisi","poem":1},{"text":"kwa ajili ya urefu wake","poem":2},{"lineBreak":true},{"text":"na wingi wa matawi yake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini ulingʼolewa kwa hasira kali","poem":1},{"text":"na kutupwa chini.","poem":2},{"text":"Upepo wa mashariki uliufanya usinyae,","poem":1},{"text":"matunda yake yakapukutika,","poem":2},{"text":"matawi yake yenye nguvu yakanyauka","poem":1},{"text":"na moto ukayateketeza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sasa umepandwa jangwani","poem":1},{"text":"katika nchi kame na ya kiu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Moto ulienea kuanzia katika mmojawapo ya matawi yake makubwa","poem":1},{"text":"na kuteketeza matunda yake.","poem":2},{"text":"Hakuna tawi lenye nguvu lililobaki juu yake","poem":1},{"text":"lifaalo kuwa fimbo ya enzi ya mtawala.’","poem":2},"Hili ndilo ombolezo, na litumike kama ombolezo.”"]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}