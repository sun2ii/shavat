{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"EZK","translationId":"swh_bib","name":"Ezekieli","commonName":"Ezekieli","title":"Ezekieli","order":26,"numberOfChapters":48,"sha256":"6f59527a0fbfb00189dc7945fd03091814581fc29bf8751705bdd841967a9e57","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swh_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":28,"content":[{"type":"heading","content":["Unabii Dhidi Ya Mfalme Wa Tiro"]},{"type":"verse","number":1,"content":["Neno la Bwana likanijia kusema:"]},{"type":"verse","number":2,"content":["“Mwanadamu, mwambie mfalme wa Tiro, ‘Hili ndilo Bwana Mwenyezi asemalo:",{"text":"“ ‘Kwa sababu moyo wako umejivuna","poem":1},{"text":"na umesema, “Mimi ni mungu;","poem":2},{"text":"nami ninaketi katika kiti cha enzi cha mungu","poem":1},{"text":"katika moyo wa bahari.”","poem":2},{"text":"Lakini wewe ni mwanadamu, wala si mungu,","poem":1},{"text":"ingawa unafikiri kuwa una hekima kama mungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Je, wewe una hekima kuliko Danieli?","poem":1},{"text":"Je, hakuna siri iliyofichika kwako?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa hekima yako na ufahamu wako,","poem":1},{"text":"umejipatia utajiri,","poem":2},{"text":"nawe umejikusanyia dhahabu","poem":1},{"text":"na fedha katika hazina zako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa werevu wako mwingi katika biashara,","poem":1},{"text":"umeongeza utajiri wako","poem":2},{"text":"na kwa sababu ya utajiri wako","poem":1},{"text":"moyo wako umekuwa na kiburi.","poem":2}]},{"type":"verse","number":6,"content":["“ ‘Kwa hiyo, hili ndilo Bwana Mwenyezi asemalo:",{"text":"“ ‘Kwa sababu unafikiri una hekima,","poem":1},{"text":"mwenye hekima kama mungu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"mimi nitawaleta wageni dhidi yako,","poem":1},{"text":"taifa katili kuliko yote;","poem":2},{"text":"watafuta panga zao dhidi ya uzuri wa hekima yako,","poem":1},{"text":"na kuchafua fahari yako inayongʼaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Watakushusha chini shimoni,","poem":1},{"text":"nawe utakufa kifo cha kikatili","poem":2},{"lineBreak":true},{"text":"katika moyo wa bahari.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, wakati huo utasema, “Mimi ni mungu,”","poem":1},{"text":"mbele ya wale wanaokuua?","poem":2},{"text":"Utakuwa mwanadamu tu, wala si mungu,","poem":1},{"text":"mikononi mwa hao wanaokuua.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Utakufa kifo cha wasiotahiriwa","poem":1},{"text":"kwa mkono wa wageni.","poem":2},"Kwa kuwa mimi nimenena, asema Bwana Mwenyezi.’ ”"]},{"type":"line_break"},{"type":"verse","number":11,"content":["Neno la Bwana likanijia kusema:"]},{"type":"verse","number":12,"content":["“Mwanadamu, mfanyie maombolezo mfalme wa Tiro, nawe umwambie: ‘Hili ndilo Bwana Mwenyezi asemalo:",{"text":"“ ‘Ulikuwa kipeo cha ukamilifu,","poem":1},{"text":"ukiwa umejaa hekima","poem":2},{"lineBreak":true},{"text":"na mkamilifu katika uzuri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ulikuwa ndani ya Edeni,","poem":1},{"text":"bustani ya Mungu;","poem":2},{"text":"kila kito cha thamani kilikupamba:","poem":1},{"text":"akiki nyekundu, yakuti manjano na zumaridi,","poem":2},{"lineBreak":true},{"text":"krisolitho, shohamu na yaspi,","poem":2},{"lineBreak":true},{"text":"yakuti samawi, almasi na zabarajadi.","poem":2},{"text":"Kuwekwa kwa hayo mapambo na kushikizwa kwake","poem":1},{"text":"kulifanywa kwa dhahabu;","poem":2},{"lineBreak":true},{"text":"siku ile ulipoumbwa yaliandaliwa tayari.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ulitiwa mafuta kuwa kerubi mlinzi,","poem":1},{"text":"kwa kuwa hivyo ndivyo nilivyokuweka wakfu.","poem":2},{"text":"Ulikuwa kwenye mlima mtakatifu wa Mungu;","poem":1},{"text":"ulitembea katikati ya vito vya moto.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ulikuwa mnyofu katika njia zako","poem":1},{"text":"tangu siku ile ya kuumbwa kwako,","poem":2},{"lineBreak":true},{"text":"hadi uovu ulipoonekana ndani yako.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kutokana na biashara yako iliyoenea,","poem":1},{"text":"ulijazwa na dhuluma,","poem":2},{"lineBreak":true},{"text":"nawe ukatenda dhambi.","poem":2},{"text":"Hivyo nilikuondoa kwa aibu kutoka mlima wa Mungu,","poem":1},{"text":"nami nikakufukuza, ee kerubi mlinzi,","poem":2},{"lineBreak":true},{"text":"kutoka katikati ya vito vya moto.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Moyo wako ukawa na kiburi","poem":1},{"text":"kwa ajili ya uzuri wako,","poem":2},{"text":"nawe ukaiharibu hekima yako","poem":1},{"text":"kwa sababu ya fahari yako.","poem":2},{"text":"Kwa hiyo nikakutupa chini;","poem":1},{"text":"nimekufanya kioja mbele ya wafalme.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa dhambi zako nyingi na biashara yako ya dhuluma,","poem":1},{"text":"umenajisi mahali pako patakatifu.","poem":2},{"text":"Kwa hiyo nilifanya moto utoke ndani yako,","poem":1},{"text":"nao ukakuteketeza,","poem":2},{"text":"nami nikakufanya majivu juu ya nchi,","poem":1},{"text":"machoni pa wote waliokuwa wakitazama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mataifa yote yaliyokujua","poem":1},{"text":"yanakustajabia;","poem":2},{"text":"umefikia mwisho wa kutisha","poem":1},{"text":"na hutakuwepo tena milele.’ ”","poem":2}]},{"type":"heading","content":["Unabii Dhidi Ya Sidoni"]},{"type":"verse","number":20,"content":["Neno la Bwana likanijia kusema:"]},{"type":"verse","number":21,"content":["“Mwanadamu, elekeza uso wako juu ya Sidoni, ukatabiri dhidi yake,"]},{"type":"verse","number":22,"content":["nawe useme: ‘Hili ndilo Bwana Mwenyezi asemalo:",{"text":"“ ‘Mimi ni kinyume chako, ee Sidoni,","poem":1},{"text":"nami nitapata utukufu ndani yako.","poem":2},{"text":"Nao watajua kwamba Mimi ndimi Bwana,","poem":1},{"text":"nitakapotekeleza hukumu zangu","poem":2},{"lineBreak":true},{"text":"na kuonyesha utakatifu wangu ndani yake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nitapeleka tauni ndani yake","poem":1},{"text":"na kufanya damu itiririke katika barabara zake.","poem":2},{"text":"Waliochinjwa wataanguka ndani yake,","poem":1},{"text":"kwa upanga dhidi yake kila upande.","poem":2},{"text":"Ndipo watakapojua kwamba Mimi ndimi Bwana.","poem":1}]},{"type":"verse","number":24,"content":["“ ‘Nyumba ya Israeli hawatakuwa tena na majirani wenye nia ya kuwadhuru wanaoumiza kama michongoma na miiba mikali. Ndipo watakapojua kwamba Mimi ndimi Bwana Mwenyezi."]},{"type":"verse","number":25,"content":["“ ‘Hili ndilo Bwana Mwenyezi asemalo: Nitakapoikusanya nyumba ya Israeli kutoka mataifa ambako wametawanyika, nitajionyesha kuwa mtakatifu miongoni mwao machoni pa mataifa. Ndipo watakapoishi katika nchi yao wenyewe, niliyompa mtumishi wangu Yakobo."]},{"type":"verse","number":26,"content":["Wataishi humo kwa salama na watajenga nyumba na kupanda mashamba ya mizabibu, wataishi kwa salama nitakapowaadhibu majirani zao wote ambao waliwafanyia uovu. Ndipo watakapojua kwamba Mimi ndimi Bwana, Mungu wao.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/EZK/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/EZK/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/EZK/27.json","previousChapterAudioLinks":{},"numberOfVerses":26}