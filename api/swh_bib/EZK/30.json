{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"EZK","translationId":"swh_bib","name":"Ezekieli","commonName":"Ezekieli","title":"Ezekieli","order":26,"numberOfChapters":48,"sha256":"6f59527a0fbfb00189dc7945fd03091814581fc29bf8751705bdd841967a9e57","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swh_bib/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["Maombolezo Kwa Ajili Ya Misri"]},{"type":"verse","number":1,"content":["Neno la Bwana likanijia kusema:"]},{"type":"verse","number":2,"content":["“Mwanadamu, toa unabii na useme: ‘Hili ndilo Bwana Mwenyezi asemalo:",{"text":"“ ‘Ombolezeni ninyi na mseme,","poem":1},{"text":"“Ole wa siku ile!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa siku ile imekaribia,","poem":1},{"text":"siku ya Bwana imekaribia,","poem":2},{"text":"siku ya mawingu,","poem":1},{"text":"siku ya maangamizi kwa mataifa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Upanga utakuja dhidi ya Misri,","poem":1},{"text":"nayo maumivu makuu yataijia Ethiopia.","poem":2},{"text":"Mauaji yatakapoangukia Misri,","poem":1},{"text":"utajiri wake utachukuliwa","poem":2},{"lineBreak":true},{"text":"na misingi yake itabomolewa.","poem":2}]},{"type":"verse","number":5,"content":["Kushi",{"noteId":13},"na Putu, Ludi na Arabia yote, Libya",{"noteId":14},"na watu wa nchi ya Agano watauawa kwa upanga pamoja na Misri."]},{"type":"verse","number":6,"content":["“ ‘Hili ndilo Bwana asemalo:",{"text":"“ ‘Wale walioungana na Misri wataanguka","poem":1},{"text":"na kiburi cha nguvu zake kitashindwa.","poem":2},{"text":"Kutoka Migdoli hadi Aswani,","poem":1},{"text":"watauawa ndani yake kwa upanga,","poem":2},{"text":"asema Bwana Mwenyezi.","poem":4}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ ‘Hizo nchi zitakua ukiwa","poem":1},{"text":"miongoni mwa nchi zilizo ukiwa,","poem":2},{"text":"nayo miji yao itakuwa magofu","poem":1},{"text":"miongoni mwa miji iliyo magofu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndipo watakapojua kwamba mimi ndimi Bwana,","poem":1},{"text":"nitakapoiwasha Misri moto","poem":2},{"lineBreak":true},{"text":"na wote wamsaidiao watapondwa.","poem":2}]},{"type":"verse","number":9,"content":["“ ‘Siku hiyo wajumbe watatoka kwangu kwa merikebu, ili kuwatia hofu Ethiopia, wakiwa katika hali yao ya kuridhika. Maumivu makali yatawapata siku ya maangamizi ya Misri, kwa kuwa hakika itakuja."]},{"type":"verse","number":10,"content":["“ ‘Hili ndilo Bwana Mwenyezi asemalo:",{"text":"“ ‘Nitakomesha makundi ya wajeuri ya Misri","poem":1},{"text":"kwa mkono wa Nebukadneza mfalme wa Babeli.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yeye na jeshi lake, taifa lililo katili kuliko mataifa yote,","poem":1},{"text":"litaletwa ili kuangamiza nchi.","poem":2},{"text":"Watafuta panga zao dhidi ya Misri","poem":1},{"text":"na kuijaza nchi kwa waliouawa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitakausha vijito vya Naili","poem":1},{"text":"na nitaiuza nchi kwa watu waovu,","poem":2},{"text":"kwa mkono wa wageni,","poem":1},{"text":"nitaifanya nchi ukiwa na kila kitu","poem":2},{"lineBreak":true},{"text":"kilichomo ndani yake.","poem":2},"Mimi Bwana nimenena haya."]},{"type":"line_break"},{"type":"verse","number":13,"content":["“ ‘Hili ndilo Bwana Mwenyezi asemalo:",{"text":"“ ‘Nitaangamiza sanamu","poem":1},{"text":"na kukomesha vinyago katika Memfisi","poem":2},{"noteId":15},{"text":"Hapatakuwepo tena na mkuu katika nchi ya Misri,","poem":1},{"text":"nami nitaeneza hofu katika nchi nzima.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitaifanya Pathrosi","poem":1},{"noteId":16},{"text":"kuwa ukiwa","poem":1},{"text":"na kuitia moto Soani,","poem":2},{"lineBreak":true},{"text":"nami nitaipiga kwa adhabu Thebesi","poem":2},{"noteId":17}]},{"type":"verse","number":15,"content":[{"text":"Nitaimwaga ghadhabu yangu juu ya Pelusiumu,","poem":1},{"noteId":18},{"text":"ngome ya Misri,","poem":2},{"text":"nami nitakatilia mbali","poem":1},{"text":"makundi ya wajeuri wa Thebesi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nitaitia moto nchi ya Misri;","poem":1},{"text":"Pelusiumu itagaagaa kwa maumivu makuu.","poem":2},{"text":"Thebesi itachukuliwa na tufani,","poem":1},{"text":"Memfisi itakuwa katika taabu daima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wanaume vijana wa Oni","poem":1},{"noteId":19},{"text":"na wa Pi-Besethi","poem":1},{"noteId":20},{"text":"wataanguka kwa upanga","poem":2},{"lineBreak":true},{"text":"nayo hiyo miji itatekwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Huko Tahpanhesi mchana utatiwa giza","poem":1},{"text":"nitakapovunja kongwa la Misri;","poem":2},{"lineBreak":true},{"text":"hapo kiburi cha nguvu zake kitakoma.","poem":2},{"text":"Atafunikwa na mawingu","poem":1},{"text":"na vijiji vyake vitatekwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kwa hiyo nitaipiga Misri kwa adhabu,","poem":1},{"text":"nao watajua kuwa Mimi ndimi Bwana.’ ”","poem":2}]},{"type":"verse","number":20,"content":["Katika mwaka wa kumi na moja, mwezi wa kwanza, siku ya saba, neno la Bwana likanijia kusema:"]},{"type":"verse","number":21,"content":["“Mwanadamu, nimevunja mkono wa Farao mfalme wa Misri. Haukufungwa ili upone au kuwekewa kipande cha ubao ili upate nguvu za kuweza kuchukua upanga."]},{"type":"verse","number":22,"content":["Kwa hiyo hili ndilo Bwana Mwenyezi asemalo: Mimi ni kinyume na Farao mfalme wa Misri. Nitavunja mikono yake yote miwili, ule mkono ulio mzima pia na ule uliovunjika na kuufanya upanga uanguke toka mkononi mwake."]},{"type":"verse","number":23,"content":["Nitawatawanya Wamisri miongoni mwa mataifa na kuwafukuza huku na huko katika nchi zote."]},{"type":"verse","number":24,"content":["Nitaitia nguvu mikono ya mfalme wa Babeli na kuutia upanga wangu mkononi mwake, lakini nitavunja mikono ya Farao, naye atalia kwa huzuni mbele yake kama mtu aliyetiwa jeraha la kumfisha."]},{"type":"verse","number":25,"content":["Nitaitia nguvu mikono ya mfalme wa Babeli, lakini mikono ya Farao italegea. Ndipo watakapojua kwamba Mimi ndimi Bwana, nitakapoutia upanga wangu mkononi mwa mfalme wa Babeli, naye ataunyoosha dhidi ya Misri."]},{"type":"verse","number":26,"content":["Nitawatawanya Wamisri miongoni mwa mataifa na kuwafukuza huku na huko katika nchi mbalimbali. Ndipo watakapojua kwamba Mimi ndimi Bwana.”"]}],"footnotes":[{"noteId":13,"caller":"+","text":"Kushi ndiyo Ethiopia.","reference":{"chapter":30,"verse":5}},{"noteId":14,"caller":"+","text":"Libya ndiyo Kubu.","reference":{"chapter":30,"verse":5}},{"noteId":15,"caller":"+","text":"Kiebrania ni Nofu.","reference":{"chapter":30,"verse":13}},{"noteId":16,"caller":"+","text":"Pathrosi ni Misri ya Juu.","reference":{"chapter":30,"verse":14}},{"noteId":17,"caller":"+","text":"Thebesi kwa Kiebrania ni No (au No-Amoni), mji katika Misri.","reference":{"chapter":30,"verse":14}},{"noteId":18,"caller":"+","text":"Kiebrania ni Sini.","reference":{"chapter":30,"verse":15}},{"noteId":19,"caller":"+","text":"Yaani Heliopoli (Mji wa Jua).","reference":{"chapter":30,"verse":17}},{"noteId":20,"caller":"+","text":"Yaani Bubasti.","reference":{"chapter":30,"verse":17}}]},"thisChapterLink":"/api/swh_bib/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}