,{"type":"verse","number":39,"content":["wazao wa Harimu1,017"]},{"type":"line_break"},{"type":"verse","number":40,"content":["Walawi: wazao wa Yeshua na Kadmieli (kupitia jamaa ya Hodavia)74"]},{"type":"line_break"},{"type":"verse","number":41,"content":["Waimbaji: wazao wa Asafu128"]},{"type":"line_break"},{"type":"verse","number":42,"content":["Mabawabu wa lango la Hekalu: wazao waShalumu, Ateri, Talmoni,Akubu, Hatita na Shobai139"]},{"type":"line_break"},{"type":"verse","number":43,"content":["Watumishi wa Hekalu:",{"noteId":0},"wazao wa Siha, Hasufa, Tabaothi,"]},{"type":"verse","number":44,"content":["wazao wa Kerosi, Siaha, Padoni,"]},{"type":"verse","number":45,"content":["wazao wa Lebana, Hagaba, Akubu,"]},{"type":"verse","number":46,"content":["wazao wa Hagabu, Shalmai, Hanani,"]},{"type":"verse","number":47,"content":["wazao wa Gideli, Gahari, Reaya,"]},{"type":"verse","number":48,"content":["wazao wa Resini, Nekoda, Gazamu,"]},{"type":"verse","number":49,"content":["wazao wa Uza, Pasea, Besai,"]},{"type":"verse","number":50,"content":["wazao wa Asna, Meunimu, Nefusimu,"]},{"type":"verse","number":51,"content":["wazao wa Bakbuki, Hakufa, Harhuri,"]},{"type":"verse","number":52,"content":["wazao wa Basluthi, Mehida, Harsha,"]},{"type":"verse","number":53,"content":["wazao wa Barkosi, Sisera, Tema,"]},{"type":"verse","number":54,"content":["wazao wa Nesia na Hatifa."]},{"type":"line_break"},{"type":"verse","number":55,"content":["Wazao wa watumishi wa Solomoni: wazao wa Sotai, Hasaferethi, Peruda,"]},{"type":"verse","number":56,"content":["wazao wa Yaala, Darkoni, Gideli,"]},{"type":"verse","number":57,"content":["wazao wa Shefatia, Hatili, Pokereth-Hasebaimu na Ami."]},{"type":"line_break"},{"type":"verse","number":58,"content":["Watumishi wa Hekalu wote nawazao wa watumishiwa Solomoni392"]},{"type":"line_break"},{"type":"verse","number":59,"content":["Wafuatao walikuja kutoka miji ya Tel-Mela, Tel-Harsha, Kerubu, Adoni na Imeri, lakini hawakuweza kuthibitisha kwamba jamaa zao zilikuwa uzao wa Israeli:"]},{"type":"verse","number":60,"content":["wazao waDelaya, Tobia na Nekoda652"]},{"type":"line_break"},{"type":"verse","number":61,"content":["Kutoka miongoni mwa makuhani: Wazao wa Hobaya, Hakosi, Barzilai (mtu aliyekuwa amemwoa binti wa Barzilai, Mgileadi, naye akaitwa kwa jina hilo)."]},{"type":"verse","number":62,"content":["Hawa walitafuta orodha za jamaa zao, lakini hawakuonekana humo, kwa hiyo waliondolewa kutoka kundi la makuhani kwa kuwa walihesabiwa kuwa najisi."]},{"type":"verse","number":63,"content":["Mtawala aliagiza kuwa wasile chochote miongoni mwa vyakula vitakatifu hadi kuwe kuhani atakayehudumu kwa Urimu na Thumimu.",{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":64,"content":["Jumla ya watu wote waliorudi walikuwa 42,360;"]},{"type":"verse","number":65,"content":["tena zaidi ya hao walikuwepo watumishi wa kiume na wa kike 7,337; pia walikuwamo waimbaji wanaume na wanawake 200."]},{"type":"verse","number":66,"content":["Walikuwa na farasi 736, nyumbu 245,"]},{"type":"verse","number":67,"content":["ngamia 435 na punda 6,720."]},{"type":"line_break"},{"type":"verse","number":68,"content":["Walipofika kwenye nyumba ya Bwana huko Yerusalemu, baadhi ya viongozi wa jamaa walitoa sadaka za hiari kwa ajili ya kujenga upya nyumba ya Mungu katika eneo lake."]},{"type":"verse","number":69,"content":["Wakatoa kwa kadiri ya uwezo wao na kutia katika hazina darkoni 61,000",{"noteId":2},"za dhahabu, mane 5,000",{"noteId":3},"za fedha, na mavazi 100 ya ukuhani kwa ajili ya kazi hiyo."]},{"type":"verse","number":70,"content":["Makuhani, Walawi, waimbaji, mabawabu, na watumishi wa Hekalu waliishi katika miji yao wenyewe, pamoja na baadhi ya watu wengine, nao Waisraeli waliosalia waliishi katika miji yao."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Yaani Wanethini (pia 2:58, 70).","reference":{"chapter":2,"verse":43}},{"noteId":1,"caller":"+","text":"Urimu na Thumimu maana yake ni Nuru na Kweli; vifaa hivi viliwekwa kwenye kifuko cha kifuani cha kisibau cha kuhani mkuu ili kujua mapenzi ya Mungu kwenye mambo ya kutatanisha.","reference":{"chapter":2,"verse":63}},{"noteId":2,"caller":"+","text":"Darkoni 61,000 za dhahabu ni sawa na kilo 500.","reference":{"chapter":2,"verse":69}},{"noteId":3,"caller":"+","text":"Mane 5,000 za fedha ni sawa na kilo 2,900.","reference":{"chapter":2,"verse":69}}]},"thisChapterLink":"/api/swh_bib/EZR/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/EZR/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/EZR/1.json","previousChapterAudioLinks":{},"numberOfVerses":70}