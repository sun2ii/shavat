{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HAB","translationId":"swh_bib","name":"Habakuki","commonName":"Habakuki","title":"Habakuki","order":35,"numberOfChapters":3,"sha256":"c40f0def0a40a351fba8e3e3193964c08342e9da4e4fb0cfa5ecdeb7ba4ab3d4","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Nitasimama katika zamu yangu,","poem":1},{"text":"na kujiweka mwenyewe juu ya maboma;","poem":2},{"text":"nitatazama nione atakaloniambia,","poem":1},{"text":"na ni jibu gani nitakalotoa kuhusu lalamiko hili.","poem":2}]},{"type":"heading","content":["Jibu La Bwana"]},{"type":"verse","number":2,"content":["Kisha Bwana akajibu:",{"text":"“Andika ufunuo huu,","poem":1},{"text":"na ukaufanye wazi juu ya vibao,","poem":2},{"lineBreak":true},{"text":"ili mpiga mbiu akimbie nao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa ufunuo huu unasubiri wakati uliokubalika;","poem":1},{"text":"unazungumzia mambo ya mwisho,","poem":2},{"lineBreak":true},{"text":"na kamwe hautakosea.","poem":2},{"text":"Iwapo utakawia, wewe usubiri;","poem":1},{"text":"kwa hakika utakuja na hautachelewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Tazama, amejaa majivuno;","poem":1},{"text":"anavyovitamani si vya unyofu:","poem":2},{"lineBreak":true},{"text":"lakini mwenye haki ataishi kwa imani yake:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"hakika mvinyo humsaliti;","poem":1},{"text":"ni mwenye kiburi na hana amani.","poem":2},{"text":"Kwa sababu ni mlafi kama kuzimu","poem":1},{"text":"na kama kifo kamwe hatosheki;","poem":2},{"text":"anajikusanyia mataifa yote","poem":1},{"text":"na kuchukua watu wote mateka.","poem":2}]},{"type":"verse","number":6,"content":["“Je, watu wote hawatamsuta kwa dhihaka na kumbeza, wakisema,",{"text":"“ ‘Ole wake yeye akusanyaye bidhaa zilizoibwa","poem":1},{"text":"na kujifanyia utajiri kwa kutoza kwa nguvu!","poem":2},{"lineBreak":true},{"text":"Ataendelea hivi kwa muda gani?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je, wadai wako hawatainuka ghafula?","poem":1},{"text":"Je, hawataamka na kukufanya utetemeke?","poem":2},{"lineBreak":true},{"text":"Kisha utakuwa mhanga kwao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa kuwa umeteka nyara mataifa mengi,","poem":1},{"text":"watu waliobaki watakuteka nyara wewe.","poem":2},{"text":"Kwa kuwa umemwaga damu ya mtu;","poem":1},{"text":"umeharibu nchi na miji, na kila mmoja ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ole wake yeye ajengaye milki yake kwa mapato ya udhalimu,","poem":1},{"text":"awekaye kiota chake juu,","poem":2},{"lineBreak":true},{"text":"ili kukimbia makucha ya uharibifu!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Umefanya shauri la maangamizi ya watu wengi,","poem":1},{"text":"ukiaibisha nyumba yako mwenyewe, na kupotewa na maisha yako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mawe ya kuta yatapiga kelele,","poem":1},{"text":"na mihimili ya kazi ya mbao itarudisha mwangwi wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ole wake yeye ajengaye mji kwa kumwaga","poem":1},{"text":"damu na kuusimamisha mji kwa uhalifu!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Je, Bwana Mwenye Nguvu Zote hakuonyesha","poem":1},{"text":"kwamba kazi ya wanadamu ni mafuta tu kwa ajili ya moto,","poem":2},{"text":"na kwamba mataifa","poem":1},{"text":"yanajichosha bure?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa kuwa dunia itajazwa na maarifa ya utukufu wa Bwana,","poem":1},{"text":"kama maji yaifunikavyo bahari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ole wake yeye awapaye jirani zake kileo,","poem":1},{"text":"akiimimina kutoka kwenye kiriba","poem":2},{"lineBreak":true},{"text":"cha mvinyo mpaka wamelewa,","poem":2},{"lineBreak":true},{"text":"ili apate kutazama miili yao iliyo uchi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Utajazwa na aibu badala ya utukufu.","poem":1},{"text":"Sasa ni zamu yako! Kunywa na ujifunue!","poem":2},{"text":"Kikombe kutoka kwenye mkono wa kuume wa Bwana kinakujia,","poem":1},{"text":"na aibu itafunika utukufu wako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ukatili ulioifanyia Lebanoni utakufunika,","poem":1},{"text":"na uharibifu uliowafanyia wanyama utakutisha.","poem":2},{"text":"Kwa sababu umemwaga damu ya mtu;","poem":1},{"text":"umeharibu nchi na miji na kila mmoja aliyeko ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Sanamu ina thamani gani,","poem":1},{"text":"kwani mwanadamu ndiye alichonga?","poem":2},{"text":"Ama kinyago kinachofundisha uongo?","poem":1},{"text":"Kwa kuwa yeye aliyekitengeneza","poem":2},{"text":"hutegemea kazi ya mikono yake mwenyewe;","poem":1},{"text":"hutengeneza sanamu zisizoweza kuzungumza.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ole wake yeye auambiaye mti, ‘Uwe hai!’","poem":1},{"text":"Ama asemaye na jiwe lisilo na uhai, ‘Amka!’","poem":2},{"text":"Je, linaweza kuongoza?","poem":1},{"text":"Limefunikwa kwa dhahabu na fedha;","poem":2},{"lineBreak":true},{"text":"hakuna pumzi ndani yake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Lakini Bwana yuko katika Hekalu lake takatifu;","poem":1},{"text":"dunia yote na inyamaze mbele yake.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}