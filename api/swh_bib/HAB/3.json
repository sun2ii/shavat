{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HAB","translationId":"swh_bib","name":"Habakuki","commonName":"Habakuki","title":"Habakuki","order":35,"numberOfChapters":3,"sha256":"c40f0def0a40a351fba8e3e3193964c08342e9da4e4fb0cfa5ecdeb7ba4ab3d4","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Maombi Ya Habakuki"]},{"type":"verse","number":1,"content":["Sala ya nabii Habakuki iliyoimbwa kwa shigionothi.",{"noteId":0}]},{"type":"verse","number":2,"content":[{"text":"Bwana, nimezisikia sifa zako;","poem":1},{"text":"nami naogopa kwa matendo yako, Ee Bwana.","poem":2},{"text":"Fufua kazi yako katikati ya miaka,","poem":1},{"text":"katikati ya miaka tangaza habari yako;","poem":2},{"lineBreak":true},{"text":"katika ghadhabu kumbuka rehema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mungu alitoka Temani,","poem":1},{"text":"yeye Aliye Mtakatifu kutoka Mlima Parani.","poem":2},{"text":"Utukufu wake ulifunika mbingu,","poem":1},{"text":"na sifa zake zikaifunika dunia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mngʼao wake ulikuwa kama jua lichomozalo;","poem":1},{"text":"mionzi ilimulika kutoka mkononi mwake,","poem":2},{"lineBreak":true},{"text":"ambako nguvu zake zilifichwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tauni ilimtangulia;","poem":1},{"text":"maradhi ya kuambukiza yalifuata nyayo zake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alisimama, akaitikisa dunia;","poem":1},{"text":"alitazama, na kuyafanya mataifa yatetemeke.","poem":2},{"text":"Milima ya zamani iligeuka mavumbi","poem":1},{"text":"na vilima vilivyozeeka vikaanguka.","poem":2},{"lineBreak":true},{"text":"Njia zake ni za milele.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Niliona watu wa Kushani katika dhiki,","poem":1},{"text":"na makazi ya Midiani katika maumivu makali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Bwana, uliikasirikia mito?","poem":1},{"text":"Je, ghadhabu yako ilikuwa dhidi ya vijito?","poem":2},{"text":"Je, ulighadhibikia bahari","poem":1},{"text":"ulipoendesha farasi wako","poem":2},{"lineBreak":true},{"text":"na magari yako ya ushindi?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uliufunua upinde wako","poem":1},{"text":"na kuita mishale mingi.","poem":2},{"text":"Uliigawa dunia kwa mito;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"milima ilikuona ikatetemeka.","poem":2},{"text":"Mafuriko ya maji yakapita huko;","poem":1},{"text":"vilindi vilinguruma","poem":2},{"lineBreak":true},{"text":"na kuinua mawimbi yake juu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jua na mwezi vilisimama kimya mbinguni","poem":1},{"text":"katika mngʼao wa mishale yako inayoruka,","poem":2},{"lineBreak":true},{"text":"na katika mngʼao wa mkuki wako umeremetao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa ghadhabu ulipita juu ya dunia,","poem":1},{"text":"na katika hasira ulikanyaga mataifa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ulikuja kuwaokoa watu wako,","poem":1},{"text":"kumwokoa uliyemtia mafuta.","poem":2},{"text":"Ulimponda kiongozi wa nchi ya uovu,","poem":1},{"text":"ukamvua toka kichwani hadi wayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa mkuki wake mwenyewe ulitoboa kichwa chake","poem":1},{"text":"wakati mashujaa wake walifurika nje kwa kishindo kututawanya,","poem":2},{"text":"wakifurahi kama walio karibu kutafuna","poem":1},{"text":"wale wanyonge waliokuwa mafichoni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ulikanyaga bahari kwa farasi wako,","poem":1},{"text":"ukisukasuka maji makuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nilisikia na moyo wangu ukagonga kwa nguvu,","poem":1},{"text":"midomo yangu ikatetemeka kwa hofu niliposikia sauti;","poem":2},{"text":"uchakavu ukanyemelea mifupa yangu,","poem":1},{"text":"na miguu yangu ikatetemeka.","poem":2},{"text":"Hata hivyo nitasubiri kwa uvumilivu siku ya maafa","poem":1},{"text":"kuyajilia mataifa yaliyotuvamia.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ingawa mtini hauchanui maua","poem":1},{"text":"na hakuna zabibu juu ya mizabibu,","poem":2},{"text":"ingawaje mzeituni hauzai,","poem":1},{"text":"na hata mashamba hayatoi chakula,","poem":2},{"text":"iwapo hakuna kondoo katika banda,","poem":1},{"text":"wala ngʼombe katika zizi,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"hata hivyo nitashangilia katika Bwana,","poem":1},{"text":"nitamfurahia Mungu Mwokozi wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bwana Mwenyezi ni nguvu yangu;","poem":1},{"text":"huifanya miguu yangu kama miguu ya ayala,","poem":2},{"lineBreak":true},{"text":"huniwezesha kupita juu ya vilima.","poem":2},{"lineBreak":true},{"text":"Kwa kiongozi wa uimbaji. Kwa vinanda vyangu vya nyuzi.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Ni kifaa cha uimbaji chenye nyuzi; pia maombi kutumia kifaa hiki.","reference":{"chapter":3,"verse":1}}]},"thisChapterLink":"/api/swh_bib/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}