{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HEB","translationId":"swh_bib","name":"Waebrania","commonName":"Waebrania","title":"Waebrania","order":58,"numberOfChapters":13,"sha256":"65c0b7492a8fb428d9d9eefbbf4faec371a545c224eb664fac69e9f18b6f1796","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/swh_bib/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Mwana Ni Mkuu Kuliko Malaika"]},{"type":"verse","number":1,"content":["Zamani Mungu alisema na baba zetu kwa njia ya manabii mara nyingi na kwa njia mbalimbali,"]},{"type":"verse","number":2,"content":["lakini katika siku hizi za mwisho anasema nasi kwa njia ya Mwanawe, ambaye amemweka kuwa mrithi wa vitu vyote, na ambaye kupitia kwake aliuumba ulimwengu."]},{"type":"verse","number":3,"content":["Mwana ni mngʼao wa utukufu wa Mungu na mfano halisi wa nafsi yake, akivihifadhi vitu vyote kwa neno lake lenye uweza. Akiisha kufanya utakaso kwa ajili ya dhambi, aliketi mkono wa kuume wa Aliye Mkuu huko mbinguni."]},{"type":"verse","number":4,"content":["Kwa hiyo alifanyika bora kuliko malaika, kama jina alilorithi lilivyo bora kuliko lao."]},{"type":"verse","number":5,"content":["Kwa maana ni malaika yupi ambaye wakati wowote Mungu alipata kumwambia,",{"text":"“Wewe ni Mwanangu;","poem":1},{"text":"leo mimi nimekuzaa?”","poem":2},"Au tena,",{"text":"“Mimi nitakuwa Baba yake,","poem":1},{"text":"naye atakuwa Mwanangu?”","poem":2}]},{"type":"verse","number":6,"content":["Tena, Mungu amletapo mzaliwa wake wa kwanza ulimwenguni, anasema,",{"text":"“Malaika wote wa Mungu na wamsujudu.”","poem":1}]},{"type":"verse","number":7,"content":["Anenapo kuhusu malaika asema,",{"text":"“Huwafanya malaika wake kuwa pepo,","poem":1},{"text":"watumishi wake kuwa miali ya moto.”","poem":2}]},{"type":"verse","number":8,"content":["Lakini kwa habari za Mwana asema,",{"text":"“Kiti chako cha enzi, Ee Mungu,","poem":1},{"text":"kitadumu milele na milele,","poem":2},{"text":"nayo haki itakuwa fimbo ya utawala","poem":1},{"text":"ya ufalme wako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umependa haki na kuchukia uovu;","poem":1},{"text":"kwa hiyo Mungu, Mungu wako,","poem":2},{"lineBreak":true},{"text":"amekuweka juu ya wenzako","poem":2},{"lineBreak":true},{"text":"kwa kukupaka mafuta ya furaha.”","poem":2}]},{"type":"verse","number":10,"content":["Pia asema,",{"text":"“Hapo mwanzo, Ee Bwana, uliweka misingi ya dunia,","poem":1},{"text":"nazo mbingu ni kazi ya mikono yako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hizo zitatoweka, lakini wewe utadumu;","poem":1},{"text":"zote zitachakaa kama vazi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Utazikungʼutakungʼuta kama joho,","poem":1},{"text":"nazo zitachakaa kama vazi.","poem":2},{"text":"Lakini wewe hubadiliki,","poem":1},{"text":"nayo miaka yako haikomi kamwe.”","poem":2}]},{"type":"verse","number":13,"content":["Je, ni kwa malaika yupi ambaye Mungu amepata kumwambia wakati wowote,",{"text":"“Keti mkono wangu wa kuume,","poem":2},{"text":"hadi nitakapowaweka adui zako","poem":1},{"text":"chini ya miguu yako”?","poem":2}]},{"type":"verse","number":14,"content":["Je, malaika wote si roho watumikao, waliotumwa kuwahudumia wale watakaourithi wokovu?"]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}