{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"2596326562040fe43c36db6823e59eb7c02c1e8865448dc1fe884558f5817022","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Israeli alikuwa mzabibu uliostawi sana,","poem":1},{"text":"alijizalia matunda mwenyewe.","poem":2},{"text":"Kadiri matunda yake yalivyoongezeka,","poem":1},{"text":"alijenga madhabahu zaidi;","poem":2},{"text":"kadiri nchi yake ilivyostawi,","poem":1},{"text":"alipamba mawe yake ya ibada.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moyo wao ni mdanganyifu,","poem":1},{"text":"nao sasa lazima wachukue hatia yao.","poem":2},{"text":"Bwana atabomoa madhabahu zao","poem":1},{"text":"na kuharibu mawe yao ya ibada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kisha watasema, “Hatuna mfalme","poem":1},{"text":"kwa sababu hatukumheshimu Bwana.","poem":2},{"text":"Lakini hata kama tungelikuwa na mfalme,","poem":1},{"text":"angeweza kutufanyia nini?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wanaweka ahadi nyingi,","poem":1},{"text":"huapa viapo vya uongo","poem":2},{"lineBreak":true},{"text":"wanapofanya mapatano;","poem":2},{"text":"kwa hiyo mashtaka huchipuka","poem":1},{"text":"kama magugu ya sumu","poem":2},{"lineBreak":true},{"text":"katika shamba lililolimwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Watu wanaoishi Samaria huogopa","poem":1},{"text":"kwa ajili ya sanamu ya ndama ya Beth-Aveni.","poem":2},{"noteId":11},{"text":"Watu wake wataiombolezea,","poem":1},{"text":"vivyo hivyo kuhani wake wa kuabudu sanamu,","poem":2},{"text":"wale waliokuwa wamefurahia fahari yake,","poem":1},{"text":"kwa sababu itaondolewa kutoka kwao","poem":2},{"lineBreak":true},{"text":"kwenda uhamishoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Itachukuliwa kwenda Ashuru","poem":1},{"text":"kama ushuru kwa mfalme mkuu.","poem":2},{"text":"Efraimu atafedheheshwa;","poem":1},{"text":"Israeli ataaibika kwa ajili ya sanamu zake za mti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaria na mfalme wake wataelea","poem":1},{"text":"kama kijiti juu ya uso wa maji.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mahali pa kuabudia sanamu pa uovu","poem":1},{"noteId":12},{"text":"pataharibiwa:","poem":1},{"text":"ndiyo dhambi ya Israeli.","poem":2},{"text":"Miiba na mibaruti itaota","poem":1},{"text":"na kufunika madhabahu zao.","poem":2},{"text":"Kisha wataiambia milima, “Tufunikeni!”","poem":1},{"text":"na vilima, “Tuangukieni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Tangu siku za Gibea, mmetenda dhambi, ee Israeli,","poem":1},{"text":"huko ndiko mlikobaki.","poem":2},{"text":"Je, vita havikuwapata","poem":1},{"text":"watenda mabaya huko Gibea?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wakati nitakapopenda, nitawaadhibu;","poem":1},{"text":"mataifa yatakusanywa dhidi yao","poem":2},{"text":"ili kuwaweka katika vifungo","poem":1},{"text":"kwa ajili ya dhambi zao mbili.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraimu ni mtamba wa ngʼombe aliyefundishwa","poem":1},{"text":"ambaye hupenda kupura,","poem":2},{"text":"hivyo nitamfunga nira","poem":1},{"text":"juu ya shingo yake nzuri.","poem":2},{"text":"Nitamwendesha Efraimu,","poem":1},{"text":"Yuda lazima alime,","poem":2},{"text":"naye Yakobo lazima avunjavunje","poem":1},{"text":"mabonge ya udongo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jipandieni wenyewe haki,","poem":1},{"text":"vuneni matunda ya upendo usio na kikomo,","poem":2},{"text":"vunjeni ardhi yenu isiyolimwa;","poem":1},{"text":"kwa kuwa ni wakati wa kumtafuta Bwana,","poem":2},{"text":"mpaka atakapokuja","poem":1},{"text":"na kuwanyeshea juu yenu haki.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lakini mmepanda uovu,","poem":1},{"text":"mkavuna ubaya,","poem":2},{"lineBreak":true},{"text":"mmekula tunda la udanganyifu.","poem":2},{"text":"Kwa sababu mmetegemea nguvu zenu wenyewe","poem":1},{"text":"na wingi wa mashujaa wenu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mngurumo wa vita utainuka dhidi ya watu wako,","poem":1},{"text":"ili kwamba ngome zako zote zitaharibiwa:","poem":2},{"text":"kama Shalmani alivyoharibu Beth-Arbeli katika siku ile ya vita,","poem":1},{"text":"wakati mama pamoja na watoto wao","poem":2},{"lineBreak":true},{"text":"walipotupwa kwa nguvu ardhini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndivyo itakavyotokea kwako, ee Betheli,","poem":1},{"text":"kwa sababu uovu wako ni mkuu.","poem":2},{"text":"Siku ile itakapopambazuka,","poem":1},{"text":"mfalme wa Israeli ataharibiwa kabisa.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Beth-Aveni maana yake Nyumba ya Ubatili (au Uovu), jina lingine la Betheli kwa dhihaka.","reference":{"chapter":10,"verse":5}},{"noteId":12,"caller":"+","text":"Yaani Aveni kwa Kiebrania, kumaanisha Beth-Aveni, jina lingine la Betheli kwa dhihaka.","reference":{"chapter":10,"verse":8}}]},"thisChapterLink":"/api/swh_bib/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}