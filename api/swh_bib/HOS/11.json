{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"2596326562040fe43c36db6823e59eb7c02c1e8865448dc1fe884558f5817022","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Upendo Wa Mungu Kwa Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Wakati Israeli alipokuwa mtoto, nilimpenda,","poem":1},{"text":"nilimwita mwanangu kutoka Misri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lakini kadiri nilivyomwita Israeli,","poem":1},{"text":"ndivyo walivyokwenda mbali nami.","poem":2},{"text":"Walitoa dhabihu kwa Mabaali","poem":1},{"text":"na kufukiza uvumba kwa vinyago.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mimi ndiye niliyemfundisha Efraimu kutembea,","poem":1},{"text":"nikiwashika mikono;","poem":2},{"text":"lakini hawakutambua","poem":1},{"text":"kuwa ni mimi niliyewaponya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niliwaongoza kwa kamba za huruma ya kibinadamu,","poem":1},{"text":"kwa vifungo vya upendo;","poem":2},{"text":"niliondoa nira shingoni mwao","poem":1},{"text":"nami nikainama kuwalisha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Je, hawatarudi Misri,","poem":1},{"text":"nayo Ashuru haitawatawala","poem":2},{"lineBreak":true},{"text":"kwa sababu wamekataa kutubu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Panga zitametameta katika miji yao,","poem":1},{"text":"zitaharibu makomeo ya malango yao","poem":2},{"lineBreak":true},{"text":"na kukomesha mipango yao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Watu wangu wamedhamiria kuniacha.","poem":1},{"text":"Hata kama wakimwita Yeye Aliye Juu Sana,","poem":2},{"lineBreak":true},{"text":"kwa vyovyote hatawainua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efraimu, ninawezaje kukuacha?","poem":1},{"text":"Ee Israeli, ninawezaje kukutoa?","poem":2},{"text":"Nitawezaje kukutendea kama Adma?","poem":1},{"text":"Nitawezaje kukufanya kama Seboimu?","poem":2},{"text":"Moyo wangu umegeuka ndani yangu,","poem":1},{"text":"huruma zangu zote zimeamshwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sitatimiza hasira yangu kali,","poem":1},{"text":"wala sitageuka na kumharibu Efraimu.","poem":2},{"text":"Kwa kuwa mimi ndimi Mungu,","poem":1},{"text":"wala si mwanadamu,","poem":2},{"text":"Aliye Mtakatifu miongoni mwenu.","poem":1},{"text":"Sitakuja kwa ghadhabu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watamfuata Bwana;","poem":1},{"text":"atanguruma kama simba.","poem":2},{"text":"Wakati angurumapo,","poem":1},{"text":"watoto wake watakuja wakitetemeka","poem":2},{"lineBreak":true},{"text":"kutoka magharibi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Watakuja wakitetemeka","poem":1},{"text":"kama ndege wakitoka Misri,","poem":2},{"lineBreak":true},{"text":"kama hua wakitoka Ashuru.","poem":2},{"text":"Nitawakalisha katika nyumba zao,”","poem":1},{"text":"asema Bwana.","poem":2}]},{"type":"heading","content":["Dhambi Ya Israeli"]},{"type":"verse","number":12,"content":[{"text":"Efraimu amenizunguka kwa uongo,","poem":1},{"text":"nyumba ya Israeli kwa udanganyifu.","poem":2},{"text":"Naye Yuda ni mkaidi dhidi ya Mungu,","poem":1},{"text":"hata kinyume cha yule mwaminifu Aliye Mtakatifu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}