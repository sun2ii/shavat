{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"2596326562040fe43c36db6823e59eb7c02c1e8865448dc1fe884558f5817022","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efraimu anajilisha upepo;","poem":1},{"text":"hufukuzia upepo wa mashariki kutwa nzima","poem":2},{"lineBreak":true},{"text":"na kuzidisha uongo na jeuri.","poem":2},{"text":"Anafanya mkataba na Ashuru","poem":1},{"text":"na kutuma mafuta ya zeituni Misri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwana analo shtaka dhidi ya Yuda,","poem":1},{"text":"atamwadhibu Yakobo kwa kadiri ya njia zake","poem":2},{"lineBreak":true},{"text":"na kumlipa kwa kadiri ya matendo yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yakobo akiwa tumboni alishika kisigino cha kaka yake;","poem":1},{"text":"kama mwanadamu, alishindana na Mungu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alishindana na malaika na kumshinda;","poem":1},{"text":"alilia na kuomba upendeleo wake.","poem":2},{"text":"Alimkuta huko Betheli","poem":1},{"text":"na kuzungumza naye huko:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwana Mungu Mwenye Nguvu Zote,","poem":1},{"text":"Bwana ndilo jina lake!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lakini ni lazima urudi kwa Mungu wako;","poem":1},{"text":"dumisha upendo na haki,","poem":2},{"lineBreak":true},{"text":"nawe umngojee Mungu wako siku zote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mfanyabiashara hutumia vipimo vya udanganyifu;","poem":1},{"text":"hupenda kupunja.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraimu hujisifu akisema,","poem":1},{"text":"“Mimi ni tajiri sana; nimetajirika.","poem":2},{"text":"Pamoja na utajiri wangu wote hawatakuta ndani yangu","poem":1},{"text":"uovu wowote au dhambi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mimi ndimi Bwana Mungu wenu","poem":1},{"text":"niliyewaleta kutoka Misri;","poem":2},{"text":"nitawafanya mkae tena kwenye mahema,","poem":1},{"text":"kama vile katika siku","poem":2},{"lineBreak":true},{"text":"za sikukuu zenu zilizoamriwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Niliongea na manabii, nikawapa maono mengi","poem":1},{"text":"na kusema mifano kupitia wao.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Je, Gileadi si mwovu?","poem":1},{"text":"Watu wake hawafai kitu!","poem":2},{"text":"Je, hawatoi dhabihu za mafahali huko Gilgali?","poem":1},{"text":"Madhabahu zao zitakuwa","poem":2},{"lineBreak":true},{"text":"kama malundo ya mawe","poem":2},{"lineBreak":true},{"text":"katika shamba lililolimwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakobo alikimbilia katika nchi ya Aramu;","poem":1},{"text":"Israeli alitumika ili apate mke,","poem":2},{"lineBreak":true},{"text":"ili aweze kulipa kwa ajili yake alichunga kondoo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bwana alimtumia nabii","poem":1},{"text":"kumpandisha Israeli kutoka Misri,","poem":2},{"lineBreak":true},{"text":"kwa njia ya nabii alimtunza.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lakini Efraimu amemchochea sana hasira;","poem":1},{"text":"Bwana wake ataleta juu yake","poem":2},{"text":"hatia yake ya kumwaga damu naye atamlipiza","poem":1},{"text":"kwa ajili ya dharau yake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}