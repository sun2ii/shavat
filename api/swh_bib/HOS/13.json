{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"2596326562040fe43c36db6823e59eb7c02c1e8865448dc1fe884558f5817022","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Hasira Ya Bwana Dhidi Ya Israeli"]},{"type":"verse","number":1,"content":[{"text":"Wakati Efraimu alipozungumza, watu walitetemeka,","poem":1},{"text":"alikuwa ametukuzwa katika Israeli.","poem":2},{"text":"Lakini alikuwa na hatia ya kumwabudu Baali","poem":1},{"text":"naye akafa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sasa wanatenda dhambi zaidi na zaidi;","poem":1},{"text":"wanajitengenezea sanamu","poem":2},{"lineBreak":true},{"text":"kutokana na fedha yao,","poem":2},{"text":"vinyago vilivyotengenezwa kwa uhodari,","poem":1},{"text":"vyote kazi ya fundi stadi.","poem":2},{"text":"Inasemekana kuhusu hawa watu,","poem":1},{"text":"“Hutoa dhabihu za binadamu","poem":2},{"lineBreak":true},{"text":"na kubusu sanamu za ndama.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa hiyo watakuwa kama ukungu wa asubuhi,","poem":1},{"text":"kama umande wa alfajiri utowekao,","poem":2},{"text":"kama makapi yapeperushwayo","poem":1},{"text":"kutoka sakafu ya kupuria nafaka,","poem":2},{"lineBreak":true},{"text":"kama moshi utorokao kupitia dirishani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Bali mimi ndimi Bwana Mungu wenu,","poem":1},{"text":"niliyewaleta ninyi toka Misri.","poem":2},{"text":"Msimkubali Mungu mwingine ila mimi,","poem":1},{"text":"hakuna Mwokozi isipokuwa mimi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Niliwatunza huko jangwani,","poem":1},{"text":"katika nchi yenye joto liunguzalo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nilipowalisha, walishiba,","poem":1},{"text":"waliposhiba, wakajivuna,","poem":2},{"lineBreak":true},{"text":"kisha wakanisahau mimi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa hiyo nitakuja juu yao kama simba,","poem":1},{"text":"kama chui nitawavizia kando ya njia.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kama dubu aliyenyangʼanywa watoto wake,","poem":1},{"text":"nitawashambulia na kurarua vifua vyenu.","poem":2},{"text":"Kama simba nitawala;","poem":1},{"text":"mnyama pori atawararua vipande vipande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ee Israeli, umeangamizwa,","poem":1},{"text":"kwa sababu wewe u kinyume nami,","poem":2},{"lineBreak":true},{"text":"kinyume na msaidizi wako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yuko wapi mfalme wako,","poem":1},{"text":"ili apate kukuokoa?","poem":2},{"text":"Wako wapi watawala wako katika miji yako yote","poem":1},{"text":"ambao ulisema kuwahusu,","poem":2},{"lineBreak":true},{"text":"‘Nipe mfalme na wakuu’?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hivyo katika hasira yangu nilikupa mfalme","poem":1},{"text":"na katika ghadhabu yangu nilimwondoa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kosa la Efraimu limehifadhiwa,","poem":1},{"text":"dhambi zake zimewekwa katika kumbukumbu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Utungu kama wa mwanamke anayejifungua mtoto humjia,","poem":1},{"text":"lakini yeye ni mtoto asiyekuwa na hekima;","poem":2},{"text":"wakati utakapowadia hatatoka","poem":1},{"text":"katika tumbo la mama yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Nitawakomboa watu hawa kutoka nguvu za kaburi,","poem":1},{"text":"nitawakomboa kutoka mautini.","poem":2},{"text":"Yako wapi, ee mauti, mateso yako?","poem":1},{"lineBreak":true},{"text":"Uko wapi, ee kuzimu, uharibifu wako?","poem":1},{"lineBreak":true},{"text":"“Sitakuwa na huruma,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"hata ingawa Efraimu atastawi","poem":2},{"lineBreak":true},{"text":"miongoni mwa ndugu zake.","poem":2},{"text":"Upepo wa mashariki kutoka kwa Bwana utakuja,","poem":1},{"text":"ukivuma kutoka jangwani,","poem":2},{"text":"chemchemi yake haitatoa maji","poem":1},{"text":"na kisima chake kitakauka.","poem":2},{"text":"Ghala lake litatekwa","poem":1},{"text":"hazina zake zote.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Watu wa Samaria ni lazima wabebe hatia yao,","poem":1},{"text":"kwa sababu wameasi dhidi ya Mungu wao.","poem":2},{"text":"Wataanguka kwa upanga;","poem":1},{"text":"watoto wao wadogo watatupwa kwa nguvu ardhini,","poem":2},{"lineBreak":true},{"text":"wanawake wao walio na mimba watatumbuliwa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}