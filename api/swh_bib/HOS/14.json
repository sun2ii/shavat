{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"2596326562040fe43c36db6823e59eb7c02c1e8865448dc1fe884558f5817022","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["Toba Iletayo Baraka"]},{"type":"verse","number":1,"content":[{"text":"Rudi, ee Israeli, kwa Bwana Mungu wako.","poem":1},{"text":"Dhambi zako zimekuwa","poem":2},{"lineBreak":true},{"text":"ndilo anguko lako!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chukueni maneno pamoja nanyi,","poem":1},{"text":"mkamrudie Bwana.","poem":2},{"text":"Mwambieni:","poem":1},{"text":"“Samehe dhambi zetu zote","poem":2},{"text":"na utupokee kwa neema,","poem":1},{"text":"ili tuweze kutoa matunda yetu","poem":2},{"lineBreak":true},{"text":"kama sadaka za mafahali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ashuru hawezi kutuokoa,","poem":1},{"text":"hatutapanda farasi wa vita.","poem":2},{"text":"Kamwe hatutasema tena ‘Miungu yetu’","poem":1},{"text":"kwa kile ambacho mikono yetu wenyewe imetengeneza,","poem":2},{"lineBreak":true},{"text":"kwa kuwa kwako wewe yatima hupata huruma.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nitaponya ukaidi wao","poem":1},{"text":"na kuwapenda kwa hiari yangu,","poem":2},{"lineBreak":true},{"text":"kwa kuwa hasira yangu imeondoka kwao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nitakuwa kama umande kwa Israeli;","poem":1},{"text":"atachanua kama yungiyungi.","poem":2},{"text":"Kama mwerezi wa Lebanoni","poem":1},{"text":"atashusha mizizi yake chini;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"matawi yake yatatanda.","poem":1},{"lineBreak":true},{"text":"Fahari yake itakuwa kama mti wa mzeituni,","poem":1},{"text":"harufu yake nzuri kama mwerezi wa Lebanoni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Watu wataishi tena kwenye kivuli chake.","poem":1},{"text":"Atastawi kama nafaka.","poem":2},{"text":"Atachanua kama mzabibu,","poem":1},{"text":"nao umaarufu wake utakuwa","poem":2},{"lineBreak":true},{"text":"kama divai itokayo Lebanoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Efraimu, nina shughuli gani tena na sanamu?","poem":1},{"text":"Nitamjibu na kumtunza.","poem":2},{"text":"Mimi ni kama msunobari wenye majani mabichi;","poem":1},{"text":"kuzaa kwako matunda kunatoka kwangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ni nani mwenye hekima? Atayatambua mambo haya.","poem":1},{"text":"Ni nani mwenye ufahamu? Huyu atayaelewa.","poem":2},{"text":"Njia za Bwana ni adili;","poem":1},{"text":"wenye haki huenda katika njia hizo,","poem":2},{"lineBreak":true},{"text":"lakini waasi watajikwaa ndani yake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}