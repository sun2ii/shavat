{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"2596326562040fe43c36db6823e59eb7c02c1e8865448dc1fe884558f5817022","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["“Waambie ndugu zako, ‘Watu wangu,’ na pia waambie dada zako, ‘Wapendwa wangu.’"]},{"type":"heading","content":["Israeli Aadhibiwa Na Kurudishwa"]},{"type":"verse","number":2,"content":[{"text":"“Mkemeeni mama yenu, mkemeeni,","poem":1},{"text":"kwa maana yeye si mke wangu,","poem":2},{"lineBreak":true},{"text":"nami si mume wake.","poem":2},{"text":"Aondoe sura ya uzinzi katika uso wake","poem":1},{"text":"na uzinzi kati ya matiti yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kama sivyo nitamvua nguo zake awe uchi","poem":1},{"text":"na kumwacha uchi kama siku ile aliyozaliwa.","poem":2},{"text":"Nitamfanya kama jangwa,","poem":1},{"text":"nitamgeuza awe nchi ya kiu,","poem":2},{"lineBreak":true},{"text":"nami nitamuua kwa kiu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sitaonyesha upendo wangu kwa watoto wake,","poem":1},{"text":"kwa sababu ni watoto wa uzinzi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mama yao amekosa uaminifu","poem":1},{"text":"na amewachukua mimba katika aibu.","poem":2},{"text":"Gomeri alisema, ‘Nitawaendea wapenzi wangu,","poem":1},{"text":"ambao hunipa chakula changu","poem":2},{"lineBreak":true},{"text":"na maji yangu,","poem":2},{"text":"sufu yangu na kitani yangu, mafuta yangu","poem":1},{"text":"na kinywaji changu.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa hiyo mimi Mungu nitaizuia njia yake","poem":1},{"text":"kwa vichaka vya miiba,","poem":2},{"text":"nitamjengea ukuta ili kwamba","poem":1},{"text":"asiweze kutoka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gomeri atawafuatia wapenzi wake lakini hatawapata;","poem":1},{"text":"atawatafuta lakini hatawapata.","poem":2},{"text":"Kisha atasema,","poem":1},{"text":"‘Nitarudi kwa mume wangu kama kwanza,","poem":2},{"text":"kwa maana nilikuwa na hali njema zaidi","poem":1},{"text":"kuliko sasa.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gomeri hajakubali kuwa mimi ndiye","poem":1},{"text":"niliyempa nafaka, divai mpya na mafuta,","poem":2},{"text":"niliyemwongezea fedha na dhahabu waliyoitumia","poem":1},{"text":"kwa kumtumikia Baali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kwa hiyo nitachukua nafaka yangu wakati itakapokomaa","poem":1},{"text":"na divai yangu mpya wakati itakapokuwa tayari.","poem":2},{"text":"Nitamnyangʼanya sufu yangu na kitani yangu","poem":1},{"text":"iliyokusudiwa kufunika uchi wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Basi sasa nitaufunua ufisadi wake","poem":1},{"text":"mbele ya wapenzi wake;","poem":2},{"text":"hakuna yeyote atakayemtoa","poem":1},{"text":"mikononi mwangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nitakomesha furaha na macheko yake yote:","poem":1},{"text":"sikukuu zake za mwaka,","poem":2},{"lineBreak":true},{"text":"sikukuu za Miandamo ya Mwezi,","poem":2},{"lineBreak":true},{"text":"siku zake za Sabato,","poem":2},{"lineBreak":true},{"text":"sikukuu zake zote zilizoamriwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitaiharibu mizabibu yake na mitini yake,","poem":1},{"text":"ambayo alisema yalikuwa malipo yake","poem":2},{"lineBreak":true},{"text":"kutoka kwa wapenzi wake;","poem":2},{"text":"nitaifanya kuwa kichaka,","poem":1},{"text":"nao wanyama pori wataila.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nitamwadhibu kwa ajili ya siku","poem":1},{"text":"alizowafukizia uvumba Mabaali;","poem":2},{"text":"alipojipamba kwa pete","poem":1},{"text":"na kwa vito vya thamani,","poem":2},{"text":"na kuwaendea wapenzi wake,","poem":1},{"text":"lakini mimi alinisahau,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Kwa hiyo sasa nitamshawishi;","poem":1},{"text":"nitamwongoza hadi jangwani","poem":2},{"lineBreak":true},{"text":"na kuzungumza naye kwa upole.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Huko nitamrudishia mashamba yake ya mizabibu,","poem":1},{"text":"nami nitalifanya Bonde la Akori","poem":2},{"noteId":3},{"lineBreak":true},{"text":"mlango wa matumaini.","poem":2},{"text":"Huko ataimba kama alivyofanya katika siku za ujana wake,","poem":1},{"text":"kama siku zile alizotoka Misri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Katika siku ile,” asema Bwana,","poem":1},{"text":"“utaniita mimi ‘Mume wangu’;","poem":2},{"lineBreak":true},{"text":"hutaniita tena mimi ‘Bwana wangu.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nitaondoa majina ya Mabaali kutoka midomoni mwake,","poem":1},{"text":"wala hataomba tena kwa majina yao.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Katika siku ile nitafanya Agano kwa ajili yao","poem":1},{"text":"na wanyama wa kondeni, na ndege wa angani,","poem":2},{"lineBreak":true},{"text":"na viumbe vile vitambaavyo ardhini.","poem":2},{"text":"Upinde, upanga na vita,","poem":1},{"text":"nitaondolea mbali katika nchi,","poem":2},{"lineBreak":true},{"text":"ili kwamba wote waweze kukaa salama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nitakuposa uwe wangu milele;","poem":1},{"text":"nitakuposa kwa uadilifu na haki,","poem":2},{"lineBreak":true},{"text":"kwa upendo na huruma.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nitakuposa kwa uaminifu,","poem":1},{"text":"nawe utamkubali Bwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Katika siku ile nitajibu,”","poem":1},{"text":"asema Bwana,","poem":2},{"text":"“nitajibu kwa anga,","poem":1},{"text":"nazo anga zitajibu kwa nchi;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nayo nchi itajibu kwa nafaka,","poem":1},{"text":"divai mpya na mafuta,","poem":2},{"lineBreak":true},{"text":"navyo vitajibu kwa Yezreeli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nitampanda katika nchi kwa ajili yangu mwenyewe;","poem":1},{"text":"nami nitaonyesha pendo langu kwake","poem":2},{"lineBreak":true},{"text":"yule ambaye nilimwita, ‘Si mpenzi wangu.","poem":2},{"noteId":4},{"text":"’","poem":2},{"text":"Nitawaambia wale walioitwa, ‘Sio watu wangu,’","poem":1},{"noteId":5},{"text":"‘Ninyi ni watu wangu’;","poem":2},{"lineBreak":true},{"text":"nao watasema, ‘Wewe ndiwe Mungu wangu.’ ”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Akori maana yake ni Taabu.","reference":{"chapter":2,"verse":15}},{"noteId":4,"caller":"+","text":"Kiebrania ni Lo-Ruhama.","reference":{"chapter":2,"verse":23}},{"noteId":5,"caller":"+","text":"Kiebrania ni Lo-Ami.","reference":{"chapter":2,"verse":23}}]},"thisChapterLink":"/api/swh_bib/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":23}