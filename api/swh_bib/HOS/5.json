{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_bib","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"2596326562040fe43c36db6823e59eb7c02c1e8865448dc1fe884558f5817022","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_bib/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Hukumu Dhidi Ya Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Sikieni hili, enyi makuhani!","poem":1},{"text":"Kuweni wasikivu, enyi Waisraeli!","poem":2},{"text":"Sikieni, ee nyumba ya mfalme!","poem":1},{"text":"Hukumu hii ni dhidi yenu:","poem":2},{"text":"Mmekuwa mtego huko Mispa,","poem":1},{"text":"wavu uliotandwa juu ya Tabori.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waasi wamezidisha sana mauaji.","poem":1},{"text":"Mimi nitawatiisha wote.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ninajua yote kuhusu Efraimu,","poem":1},{"text":"Israeli hukufichika kwangu.","poem":2},{"text":"Efraimu, sasa umegeukia ukahaba,","poem":1},{"text":"Israeli amenajisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Matendo yao hayawaachii","poem":1},{"text":"kurudi kwa Mungu wao.","poem":2},{"text":"Roho ya ukahaba imo ndani ya mioyo yao,","poem":1},{"text":"hawamkubali Bwana.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kiburi cha Israeli kinashuhudia dhidi yao;","poem":1},{"text":"Waisraeli, hata Efraimu,","poem":2},{"text":"wanajikwaa katika dhambi zao;","poem":1},{"text":"pia Yuda atajikwaa pamoja nao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wakati wanapokwenda na makundi yao","poem":1},{"text":"ya kondoo na ngʼombe","poem":2},{"lineBreak":true},{"text":"kumtafuta Bwana,","poem":2},{"text":"hawatampata;","poem":1},{"text":"yeye amejiondoa kutoka kwao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wao si waaminifu kwa Bwana;","poem":1},{"text":"wamezaa watoto haramu.","poem":2},{"text":"Sasa sikukuu zao za Mwandamo wa Mwezi","poem":1},{"text":"zitawaangamiza wao","poem":2},{"lineBreak":true},{"text":"pamoja na mashamba yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Pigeni tarumbeta huko Gibea,","poem":1},{"text":"baragumu huko Rama.","poem":2},{"text":"Paza kilio cha vita huko Beth-Aveni,","poem":1},{"noteId":9},{"text":"ongoza, ee Benyamini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efraimu ataachwa ukiwa","poem":1},{"text":"katika siku ya kuadhibiwa.","poem":2},{"text":"Miongoni mwa makabila ya Israeli","poem":1},{"text":"ninatangaza lile ambalo halina budi kutukia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Viongozi wa Yuda ni kama wale","poem":1},{"text":"wanaosogeza mawe ya mpaka.","poem":2},{"text":"Nitamwaga ghadhabu yangu juu yao","poem":1},{"text":"kama mafuriko ya maji.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraimu ameonewa,","poem":1},{"text":"amekanyagwa katika hukumu","poem":2},{"lineBreak":true},{"text":"kwa kuwa amekusudia kufuatia sanamu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mimi ni kama nondo kwa Efraimu,","poem":1},{"text":"na kama uozo kwa watu wa Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Wakati Efraimu alipoona ugonjwa wake,","poem":1},{"text":"naye Yuda vidonda vyake,","poem":2},{"text":"ndipo Efraimu alipogeukia Ashuru,","poem":1},{"text":"na kuomba msaada kwa mfalme mkuu.","poem":2},{"text":"Lakini hawezi kukuponya,","poem":1},{"text":"wala hawezi kukuponya vidonda vyako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa maana nitakuwa kama simba kwa Efraimu,","poem":1},{"text":"kama simba mkubwa kwa Yuda.","poem":2},{"text":"Nitawararua vipande vipande na kuondoka;","poem":1},{"text":"nitawachukua mbali,","poem":2},{"lineBreak":true},{"text":"na hakuna wa kuwaokoa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kisha nitarudi mahali pangu","poem":1},{"text":"mpaka watakapokubali kosa lao.","poem":2},{"text":"Nao watautafuta uso wangu;","poem":1},{"text":"katika taabu yao watanitafuta kwa bidii.”","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Beth-Aveni maana yake Nyumba ya Ubatili (au Uovu), jina lingine la Betheli kwa dhihaka.","reference":{"chapter":5,"verse":8}}]},"thisChapterLink":"/api/swh_bib/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}