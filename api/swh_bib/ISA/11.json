{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["Tawi Kutoka Kwa Yese"]},{"type":"verse","number":1,"content":[{"text":"Chipukizi litatokea kutoka shina la Yese,","poem":1},{"text":"kutoka mizizi yake Tawi litazaa tunda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Roho wa Bwana atakaa juu yake,","poem":1},{"text":"Roho wa hekima na wa ufahamu,","poem":2},{"lineBreak":true},{"text":"Roho wa shauri na wa uweza,","poem":2},{"lineBreak":true},{"text":"Roho wa maarifa na wa kumcha Bwana","poem":2}]},{"type":"verse","number":3,"content":[{"text":"naye atafurahia kumcha Bwana.","poem":1},{"lineBreak":true},{"text":"Hatahukumu kwa yale ayaonayo kwa macho yake,","poem":1},{"text":"wala kuamua kwa yale ayasikiayo kwa masikio yake,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"bali kwa uadilifu atahukumu wahitaji,","poem":1},{"text":"kwa haki ataamua wanyenyekevu wa dunia.","poem":2},{"text":"Ataipiga dunia kwa fimbo ya kinywa chake,","poem":1},{"text":"kwa pumzi ya midomo yake atawaua waovu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haki itakuwa mkanda wake","poem":1},{"text":"na uaminifu utakuwa mshipi kiunoni mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mbwa mwitu ataishi pamoja na mwana-kondoo,","poem":1},{"text":"naye chui atalala pamoja na mbuzi,","poem":2},{"text":"ndama, mwana simba na ngʼombe wa mwaka mmoja watakaa pamoja,","poem":1},{"text":"naye mtoto mdogo atawaongoza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ngʼombe na dubu watalisha pamoja,","poem":1},{"text":"watoto wao watalala pamoja,","poem":2},{"lineBreak":true},{"text":"na simba atakula majani makavu kama maksai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mtoto mchanga atacheza karibu na shimo la nyoka,","poem":1},{"lineBreak":true},{"text":"naye mtoto mdogo ataweka mkono wake","poem":1},{"text":"kwenye kiota cha fira.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hawatadhuru wala kuharibu","poem":1},{"text":"juu ya mlima wangu mtakatifu wote,","poem":2},{"text":"kwa kuwa dunia itajawa na kumjua Bwana","poem":1},{"text":"kama maji yajazavyo bahari.","poem":2}]},{"type":"verse","number":10,"content":["Katika siku hiyo, Shina la Yese atasimama kama bendera kwa ajili ya mataifa. Mataifa yatakusanyika kwake, na mahali pake pa kupumzikia patakuwa utukufu."]},{"type":"verse","number":11,"content":["Katika siku hiyo Bwana atanyoosha mkono wake mara ya pili kurudisha mabaki ya watu wake waliosalia kutoka Ashuru, Misri, Pathrosi,",{"noteId":16},"Kushi, Elamu, Babeli, Hamathi na kutoka visiwa vya baharini."]},{"type":"verse","number":12,"content":[{"text":"Atainua bendera kwa mataifa","poem":1},{"text":"na kuwakusanya Waisraeli walioko uhamishoni;","poem":2},{"text":"atawakusanya watu wa Yuda waliotawanyika","poem":1},{"text":"kutoka pembe nne za dunia.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wivu wa Efraimu utatoweka,","poem":1},{"text":"na adui wa Yuda watakatiliwa mbali;","poem":2},{"text":"Efraimu hatamwonea Yuda wivu,","poem":1},{"text":"wala Yuda hatakuwa na uadui na Efraimu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Watawashukia katika miteremko ya Wafilisti","poem":1},{"text":"hadi upande wa magharibi,","poem":2},{"text":"kwa pamoja watawateka watu nyara","poem":1},{"text":"hadi upande wa mashariki.","poem":2},{"text":"Watawapiga Edomu na Moabu,","poem":1},{"text":"na Waamoni watatawaliwa nao.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bwana atakausha","poem":1},{"text":"ghuba ya bahari ya Misri;","poem":2},{"text":"kwa upepo mkavu ataupeleka mkono wake","poem":1},{"text":"juu ya Mto Frati.","poem":2},{"text":"Ataugawanya katika vijito saba","poem":1},{"text":"ili watu waweze kuuvuka wakiwa wamevaa viatu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Itakuwepo njia kuu kwa mabaki ya watu wake","poem":1},{"text":"wale waliosalia kutoka Ashuru,","poem":2},{"text":"kama ilivyokuwa kwa Israeli","poem":1},{"text":"walipopanda kutoka Misri.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Pathrosi ina maana Misri ya Juu.","reference":{"chapter":11,"verse":11}}]},"thisChapterLink":"/api/swh_bib/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}