{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Kushukuru Na Kusifu"]},{"type":"verse","number":1,"content":["Katika siku ile utasema:",{"text":"“Nitakusifu wewe, Ee Bwana.","poem":1},{"text":"Ingawa ulinikasirikia,","poem":2},{"text":"hasira yako imegeukia mbali","poem":1},{"text":"nawe umenifariji.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hakika Mungu ni wokovu wangu;","poem":1},{"text":"nitamtumaini wala sitaogopa.","poem":2},{"text":"Bwana, Bwana, ni nguvu zangu na wimbo wangu;","poem":1},{"text":"amekuwa wokovu wangu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa furaha mtachota maji","poem":1},{"text":"kutoka visima vya wokovu.","poem":2}]},{"type":"verse","number":4,"content":["Katika siku hiyo mtasema:",{"text":"“Mshukuruni Bwana, mliitie jina lake;","poem":1},{"text":"julisheni miongoni mwa mataifa yale aliyoyafanya,","poem":2},{"lineBreak":true},{"text":"tangazeni kuwa jina lake limetukuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwimbieni Bwana, kwa kuwa ametenda mambo makuu,","poem":1},{"text":"hili na lijulikane duniani kote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pazeni sauti mwimbe kwa furaha, watu wa Sayuni,","poem":1},{"text":"kwa maana mkuu ni yeye Aliye Mtakatifu wa Israeli miongoni mwenu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}