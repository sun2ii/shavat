{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"heading","content":["Yuda Kufanywa Upya"]},{"type":"verse","number":1,"content":[{"text":"Bwana atamhurumia Yakobo,","poem":1},{"text":"atamchagua Israeli tena,","poem":2},{"lineBreak":true},{"text":"na kuwakalisha katika nchi yao wenyewe.","poem":2},{"text":"Wageni wataungana nao","poem":1},{"text":"na kujiunga na nyumba ya Yakobo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mataifa watawachukua","poem":1},{"text":"na kuwaleta mahali pao wenyewe.","poem":2},{"text":"Nayo nyumba ya Israeli itamiliki mataifa","poem":1},{"text":"kama watumishi na wajakazi katika nchi ya Bwana.","poem":2},{"text":"Watawafanya watekaji wao kuwa mateka,","poem":1},{"text":"na kutawala juu ya wale waliowaonea.","poem":2}]},{"type":"verse","number":3,"content":["Katika siku Bwana atakapokuondolea mateso, udhia na utumwa wa kikatili,"]},{"type":"verse","number":4,"content":["utaichukua dhihaka hii dhidi ya mfalme wa Babeli:",{"text":"Tazama jinsi mtesi alivyofikia mwisho!","poem":1},{"text":"Tazama jinsi ghadhabu yake kali ilivyokoma!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwana amevunja fimbo ya mwovu,","poem":1},{"text":"fimbo ya utawala ya watawala,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ambayo kwa hasira waliyapiga mataifa","poem":1},{"text":"kwa mapigo yasiyo na kikomo,","poem":2},{"text":"nao kwa ghadhabu kali waliwatiisha mataifa","poem":1},{"text":"kwa jeuri pasipo huruma.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nchi zote ziko kwenye mapumziko na kwenye amani,","poem":1},{"text":"wanabubujika kwa kuimba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hata misunobari na mierezi ya Lebanoni","poem":1},{"text":"inashangilia mbele yako na kusema,","poem":2},{"text":"“Basi kwa sababu umeangushwa chini,","poem":1},{"text":"hakuna mkata miti atakayekuja kutukata.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kuzimu kote kumetaharuki","poem":1},{"text":"kukulaki unapokuja,","poem":2},{"text":"kunaamsha roho za waliokufa ili kukupokea,","poem":1},{"text":"wote waliokuwa viongozi katika ulimwengu,","poem":2},{"text":"kunawafanya wainuke kwenye viti vyao vya kifalme:","poem":1},{"text":"wale wote waliokuwa wafalme juu ya mataifa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wote wataitikia,","poem":1},{"text":"watakuambia,","poem":2},{"text":"“Wewe pia umekuwa dhaifu, kama sisi tulivyo;","poem":1},{"text":"wewe umekuwa kama sisi.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Majivuno yako yote yameshushwa mpaka kuzimu,","poem":1},{"text":"pamoja na kelele ya vinubi vyako,","poem":2},{"text":"mafunza yametanda chini yako,","poem":1},{"text":"na minyoo imekufunika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tazama jinsi ulivyoanguka kutoka mbinguni,","poem":1},{"text":"ewe nyota ya asubuhi, mwana wa mapambazuko!","poem":2},{"text":"Umetupwa chini duniani,","poem":1},{"text":"wewe uliyepata kuangusha mataifa!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ulisema moyoni mwako,","poem":1},{"text":"“Nitapanda juu hadi mbinguni,","poem":2},{"text":"nitakiinua kiti changu cha enzi","poem":1},{"text":"juu ya nyota za Mungu,","poem":2},{"text":"nitaketi nimetawazwa","poem":1},{"text":"juu ya mlima wa kusanyiko,","poem":2},{"lineBreak":true},{"text":"kwenye vimo vya juu sana vya Mlima Mtakatifu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitapaa juu kupita mawingu,","poem":1},{"text":"nitajifanya kama Yeye Aliye Juu Sana.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lakini umeshushwa chini hadi kuzimu,","poem":1},{"text":"hadi kwenye vina vya shimo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wale wanaokuona wanakukazia macho,","poem":1},{"text":"wanatafakari hatima yako:","poem":2},{"text":"“Je, huyu ndiye yule aliyetikisa dunia","poem":1},{"text":"na kufanya falme zitetemeke,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"yule aliyeifanya dunia kuwa jangwa,","poem":1},{"text":"aliyeipindua miji yake,","poem":2},{"text":"na ambaye hakuwaachia mateka wake","poem":1},{"text":"waende nyumbani?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Wafalme wote wa mataifa wamelala kwa heshima","poem":1},{"text":"kila mmoja katika kaburi lake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lakini wewe umetupwa nje ya kaburi lako","poem":1},{"text":"kama tawi lililokataliwa,","poem":2},{"text":"umefunikwa na waliouawa","poem":1},{"text":"pamoja na wale waliochomwa kwa upanga,","poem":2},{"text":"wale washukao mpaka","poem":1},{"text":"kwenye mawe ya shimo.","poem":2},{"text":"Kama mzoga uliokanyagwa chini ya nyayo,","poem":1}]},{"type":"verse","number":20,"content":[{"text":"Hutajumuika nao kwenye mazishi,","poem":2},{"text":"kwa kuwa umeharibu nchi yako","poem":1},{"text":"na kuwaua watu wako.","poem":2},{"lineBreak":true},{"text":"Mzao wa mwovu","poem":1},{"text":"hatatajwa tena kamwe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Andaa mahali pa kuwachinjia wanawe","poem":1},{"text":"kwa ajili ya dhambi za baba zao,","poem":2},{"text":"wasije wakainuka ili kuirithi nchi","poem":1},{"text":"na kuijaza dunia kwa miji yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Bwana Mwenye Nguvu Zote asema,","poem":1},{"text":"“Nitainuka dhidi yao,","poem":2},{"text":"nitalikatilia mbali jina lake kutoka Babeli pamoja na watu wake walionusurika,","poem":1},{"text":"watoto wake na wazao wake,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"“Nitaifanya kuwa mahali pa bundi,","poem":1},{"text":"na kuwa nchi ya matope;","poem":2},{"text":"nitaifagia kwa ufagio wa maangamizi,”","poem":1},{"text":"asema Bwana Mwenye Nguvu Zote.","poem":2}]},{"type":"heading","content":["Unabii Dhidi Ya Ashuru"]},{"type":"verse","number":24,"content":["Bwana Mwenye Nguvu Zote ameapa,",{"text":"“Hakika, kama vile nilivyopanga, ndivyo itakavyokuwa,","poem":1},{"text":"nami kama nilivyokusudia, ndivyo itakavyosimama.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nitamponda Mwashuru katika nchi yangu,","poem":1},{"text":"juu ya milima yangu nitawakanyagia chini.","poem":2},{"text":"Nira yake itaondolewa kutoka kwa watu wangu,","poem":1},{"text":"nao mzigo wake utaondolewa kutoka mabegani mwao.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Huu ndio mpango uliokusudiwa kwa ajili ya ulimwengu wote,","poem":1},{"text":"huu ni mkono ulionyooshwa juu ya mataifa yote.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kwa kuwa Bwana Mwenye Nguvu Zote amekusudia,","poem":1},{"text":"ni nani awezaye kumzuia?","poem":2},{"text":"Mkono wake umenyooshwa,","poem":1},{"text":"ni nani awezaye kuurudisha?","poem":2}]},{"type":"heading","content":["Unabii Dhidi Ya Wafilisti"]},{"type":"verse","number":28,"content":["Neno hili lilikuja mwaka ule Mfalme Ahazi alipofariki:"]},{"type":"verse","number":29,"content":[{"text":"Msifurahi, enyi Wafilisti wote,","poem":1},{"text":"kwamba fimbo iliyowapiga imevunjika;","poem":2},{"text":"kutoka mzizi wa huyo nyoka","poem":1},{"text":"atachipuka nyoka mwenye sumu kali,","poem":2},{"text":"uzao wake utakuwa joka lirukalo,","poem":1},{"text":"lenye sumu kali.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Maskini kuliko maskini wote watapata malisho,","poem":1},{"text":"nao wahitaji watalala salama.","poem":2},{"text":"Lakini mzizi wako nitauangamiza kwa njaa,","poem":1},{"text":"nayo njaa itawaua walionusurika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Piga yowe, ee lango! Bweka, ee mji!","poem":1},{"text":"Yeyukeni, enyi Wafilisti wote!","poem":2},{"text":"Wingu la moshi linakuja toka kaskazini,","poem":1},{"text":"wala hakuna atakayechelewa katika safu zake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ni jibu gani litakalotolewa","poem":1},{"text":"kwa wajumbe wa taifa hilo?","poem":2},{"text":"“Bwana ameifanya imara Sayuni,","poem":1},{"text":"nako ndani yake watu wake walioonewa watapata kimbilio.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}