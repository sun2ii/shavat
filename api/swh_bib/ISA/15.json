{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Unabii Dhidi Ya Moabu"]},{"type":"verse","number":1,"content":["Neno kuhusu Moabu:",{"text":"Ari iliyo Moabu imeangamizwa:","poem":1},{"text":"imeharibiwa kwa usiku mmoja!","poem":2},{"text":"Kiri iliyo Moabu imeangamizwa,","poem":1},{"text":"imeharibiwa kwa usiku mmoja!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Diboni anakwea hadi kwenye hekalu lake,","poem":1},{"text":"mpaka mahali pake pa juu ili walie,","poem":2},{"lineBreak":true},{"text":"Moabu anaombolezea Nebo na Medeba.","poem":2},{"text":"Kila kichwa kimenyolewa","poem":1},{"text":"na kila ndevu limeondolewa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wamevaa nguo za magunia barabarani,","poem":1},{"text":"juu ya mapaa na kwenye viwanja","poem":2},{"text":"wote wanaomboleza,","poem":1},{"text":"wamelala kifudifudi kwa kulia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Heshboni na Eleale wanalia,","poem":1},{"text":"sauti zao zinasikika hadi Yahazi.","poem":2},{"text":"Kwa hiyo watu wenye silaha wa Moabu wanapiga kelele,","poem":1},{"text":"nayo mioyo yao imezimia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Moyo wangu unamlilia Moabu;","poem":1},{"text":"wakimbizi wake wanakimbilia Soari,","poem":2},{"lineBreak":true},{"text":"hadi Eglath-Shelishiya.","poem":2},{"text":"Wanapanda njia ya kwenda Luhithi,","poem":1},{"text":"wanakwenda huku wanalia;","poem":2},{"text":"barabarani iendayo Horonaimu","poem":1},{"text":"wanaombolezea maangamizi yao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maji ya Nimrimu yamekauka","poem":1},{"text":"na majani yamenyauka;","poem":2},{"text":"mimea imekauka wala hakuna","poem":1},{"text":"kitu chochote kibichi kilichobaki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa hiyo mali waliyoipata na kujiwekea akiba","poem":1},{"text":"wamezichukua na kuvuka Bonde la Mierebi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwangwi wa kilio chao umefika hadi mpakani mwa Moabu,","poem":1},{"text":"kilio chao cha huzuni kimefika hadi Eglaimu,","poem":2},{"lineBreak":true},{"text":"maombolezo yao hadi Beer-Elimu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maji ya Dimoni yamejaa damu,","poem":1},{"text":"lakini bado nitaleta pigo jingine juu ya Dimoni:","poem":2},{"text":"simba juu ya wakimbizi wa Moabu","poem":1},{"text":"na juu ya wale wanaobaki katika nchi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}