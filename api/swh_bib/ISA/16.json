{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"heading","content":["Hali Ya Kukata Tamaa Ya Moabu"]},{"type":"verse","number":1,"content":[{"text":"Pelekeni wana-kondoo kama ushuru","poem":1},{"text":"kwa mtawala wa nchi,","poem":2},{"text":"Kutoka Sela, kupitia jangwani,","poem":1},{"text":"hadi mlima wa Binti Sayuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama ndege wanaopapatika","poem":1},{"text":"waliofukuzwa kutoka kwenye kiota,","poem":2},{"text":"ndivyo walivyo wanawake wa Moabu","poem":1},{"text":"kwenye vivuko vya Arnoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Tupeni shauri,","poem":1},{"text":"toeni uamuzi.","poem":2},{"text":"Wakati wa adhuhuri,","poem":1},{"text":"fanyeni kivuli chenu kama usiku.","poem":2},{"text":"Waficheni watoro,","poem":1},{"text":"msisaliti wakimbizi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waacheni watoro wa Moabu wakae pamoja nanyi;","poem":1},{"text":"kuweni mahali pao pa salama ili kuepuka mharabu.”","poem":2},{"lineBreak":true},{"text":"Mtesi atafikia mwisho na maangamizi yatakoma,","poem":1},{"text":"aletaye vita atatoweka kutoka nchi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa upendo kiti cha enzi kitaimarishwa,","poem":1},{"text":"kwa uaminifu mtu ataketi juu yake,","poem":2},{"lineBreak":true},{"text":"yeye atokaye nyumba ya Daudi:","poem":2},{"text":"yeye ambaye katika kuhukumu hutafuta haki,","poem":1},{"text":"na huhimiza njia ya haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tumesikia juu ya kiburi cha Moabu:","poem":1},{"text":"kiburi chake cha kujivuna na udanganyifu,","poem":2},{"text":"kiburi chake na ufidhuli wake,","poem":1},{"text":"lakini majivuno yake si kitu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa hiyo Wamoabu wanaomboleza,","poem":1},{"text":"wanaiombolezea Moabu kwa pamoja.","poem":2},{"text":"Wanaomboleza na kuhuzunika","poem":1},{"text":"kwa ajili ya watu wa Kir-Haresethi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mashamba ya Heshboni yananyauka,","poem":1},{"text":"pia na mizabibu ya Sibma.","poem":2},{"text":"Watawala wa mataifa","poem":1},{"text":"wamekanyaga mizabibu iliyo mizuri sana,","poem":2},{"text":"ambayo ilipata kufika Yazeri","poem":1},{"text":"na kuenea kuelekea jangwani.","poem":2},{"text":"Machipukizi yake yalienea","poem":1},{"text":"yakafika hadi baharini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hivyo ninalia kama Yazeri aliavyo,","poem":1},{"text":"kwa ajili ya mizabibu ya Sibma.","poem":2},{"text":"Ee Heshboni, ee Eleale,","poem":1},{"text":"ninakulowesha kwa machozi!","poem":2},{"text":"Kelele za furaha kwa ajili ya tunda lako lililoiva","poem":1},{"text":"na kwa ajili ya mavuno zimekomeshwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Furaha na shangwe zimeondolewa","poem":1},{"text":"kutoka mashamba ya matunda;","poem":2},{"text":"hakuna yeyote aimbaye wala apazaye sauti","poem":1},{"text":"katika mashamba ya mizabibu;","poem":2},{"text":"hakuna yeyote akanyagaye zabibu shinikizoni,","poem":1},{"text":"kwa kuwa nimekomesha makelele.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Moyo wangu unaomboleza kwa ajili ya Moabu kama kinubi,","poem":1},{"text":"nafsi yangu yote kwa ajili ya Kir-Haresethi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wakati Moabu anapojitokeza mahali pake pa juu,","poem":1},{"text":"anajichosha mwenyewe tu;","poem":2},{"text":"anapokwenda mahali pake pa kuabudia miungu ili kuomba,","poem":1},{"text":"haitamfaidi lolote.","poem":2}]},{"type":"verse","number":13,"content":["Hili ndilo neno ambalo Bwana ameshasema kuhusu Moabu."]},{"type":"verse","number":14,"content":["Lakini sasa Bwana anasema: “Katika miaka mitatu, kama vile mtumishi aliyefungwa na mkataba angeihesabu, fahari ya Moabu na watu wake wengi watadharauliwa, nao walionusurika watakuwa wachache sana, tena wanyonge.”"]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}