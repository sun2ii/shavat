{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Mlima Wa Bwana"]},{"type":"verse","number":1,"content":["Hili ndilo aliloliona Isaya mwana wa Amozi kuhusu Yuda na Yerusalemu:"]},{"type":"verse","number":2,"content":["Katika siku za mwisho",{"text":"mlima wa Hekalu la Bwana utaimarishwa","poem":1},{"text":"kama mlima mkuu miongoni mwa milima yote,","poem":2},{"text":"utainuliwa juu ya vilima,","poem":1},{"text":"na mataifa yote yatamiminika huko.","poem":2}]},{"type":"verse","number":3,"content":["Mataifa mengi yatakuja na kusema,",{"text":"“Njooni, twendeni mlimani mwa Bwana,","poem":1},{"text":"kwenye nyumba ya Mungu wa Yakobo.","poem":2},{"text":"Atatufundisha njia zake,","poem":1},{"text":"ili tuweze kuenenda katika mapito yake.”","poem":2},{"text":"Sheria itatoka Sayuni,","poem":1},{"text":"neno la Bwana litatoka Yerusalemu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atahukumu kati ya mataifa","poem":1},{"text":"na ataamua migogoro ya mataifa mengi.","poem":2},{"text":"Watafua panga zao ziwe majembe,","poem":1},{"text":"na mikuki yao kuwa miundu ya kukata matawi.","poem":2},{"text":"Taifa halitainua upanga dhidi ya taifa jingine,","poem":1},{"text":"wala hawatajifunza vita tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Njooni, enyi nyumba ya Yakobo,","poem":1},{"text":"tutembeeni katika nuru ya Bwana.","poem":2}]},{"type":"heading","content":["Siku Ya Bwana"]},{"type":"verse","number":6,"content":[{"text":"Umewatelekeza watu wako,","poem":1},{"text":"nyumba ya Yakobo.","poem":2},{"text":"Wamejaa ushirikina utokao Mashariki,","poem":1},{"text":"wanapiga ramli kama Wafilisti","poem":2},{"lineBreak":true},{"text":"na wanashikana mikono na wapagani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nchi yao imejaa fedha na dhahabu,","poem":1},{"text":"hakuna mwisho wa hazina zao.","poem":2},{"text":"Nchi yao imejaa farasi,","poem":1},{"text":"hakuna mwisho wa magari yao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nchi yao imejaa sanamu,","poem":1},{"text":"wanasujudia kazi za mikono yao,","poem":2},{"lineBreak":true},{"text":"vitu vile vidole vyao vimevitengeneza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa hiyo mwanadamu atashushwa","poem":1},{"text":"na binadamu atanyenyekezwa:","poem":2},{"lineBreak":true},{"text":"usiwasamehe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ingieni kwenye miamba,","poem":1},{"text":"jificheni ardhini","poem":2},{"text":"kutokana na utisho wa Bwana","poem":1},{"text":"na utukufu wa enzi yake!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Macho ya mtu mwenye majivuno yatanyenyekezwa","poem":1},{"text":"na kiburi cha wanadamu kitashushwa,","poem":2},{"text":"Bwana peke yake ndiye atakayetukuzwa siku hiyo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bwana Mwenye Nguvu Zote anayo siku aliyoiweka akiba","poem":1},{"text":"kwa wote wenye kujivuna na wenye kiburi,","poem":2},{"lineBreak":true},{"text":"kwa wote wanaojikweza","poem":2},{"lineBreak":true},{"text":"(nao watanyenyekezwa),","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kwa mierezi yote ya Lebanoni iliyo mirefu sana,","poem":1},{"text":"na mialoni yote ya Bashani,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kwa milima yote mirefu","poem":1},{"text":"na vilima vyote vilivyoinuka,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kwa kila mnara ulio mrefu sana","poem":1},{"text":"na kila ukuta wenye ngome,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kwa kila meli ya biashara,","poem":1},{"noteId":1},{"text":"na kila chombo cha baharini cha fahari.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Majivuno ya mwanadamu yatashushwa,","poem":1},{"text":"na kiburi cha wanadamu kitanyenyekezwa,","poem":2},{"text":"Bwana peke yake ndiye atatukuzwa siku hiyo,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"nazo sanamu zitatoweka kabisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Watu watakimbilia kwenye mapango ndani ya miamba,","poem":1},{"text":"na kwenye mahandaki ardhini","poem":2},{"text":"kutokana na utisho wa Bwana","poem":1},{"text":"na utukufu wa enzi yake,","poem":2},{"lineBreak":true},{"text":"ainukapo kuitikisa dunia.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Siku ile, watu watawatupia","poem":1},{"text":"panya na popo","poem":2},{"text":"sanamu zao za fedha na za dhahabu,","poem":1},{"text":"walizozitengeneza ili waziabudu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Watakimbilia kwenye mapango miambani","poem":1},{"text":"na kwenye nyufa za miamba","poem":2},{"text":"kutokana na utisho wa Bwana","poem":1},{"text":"na utukufu wa enzi yake,","poem":2},{"lineBreak":true},{"text":"ainukapo kuitikisa dunia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Acheni kumtumainia mwanadamu,","poem":1},{"text":"ambaye hana kitu ila pumzi katika pua zake.","poem":2},{"text":"Yeye ana thamani gani?","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Au: ya Tarshishi (ona pia 1Fal 10:22; 22:48; 2Nya 9:21; 20:36; Isa 60:9.)","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/swh_bib/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}