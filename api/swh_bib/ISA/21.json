{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["Unabii Dhidi Ya Babeli"]},{"type":"verse","number":1,"content":[{"text":"Neno kuhusu Jangwa kando ya Bahari:","poem":1},{"text":"Kama upepo wa kisulisuli unaopita katika nchi hadi kusini,","poem":2},{"lineBreak":true},{"text":"mshambuliaji anakuja kutoka jangwani,","poem":2},{"lineBreak":true},{"text":"kutoka nchi inayotisha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nimeonyeshwa maono ya kutisha:","poem":1},{"text":"Msaliti anasaliti, mteka nyara anateka nyara.","poem":2},{"text":"Elamu, shambulia! Umedi, izunguke kwa jeshi!","poem":1},{"text":"Nitakomesha huzuni zote alizosababisha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Katika hili mwili wangu umeteswa na maumivu,","poem":1},{"text":"maumivu makali ya ghafula yamenishika,","poem":2},{"lineBreak":true},{"text":"kama yale ya mwanamke mwenye utungu wa kuzaa.","poem":2},{"lineBreak":true},{"text":"Nimeduwazwa na lile ninalolisikia,","poem":2},{"lineBreak":true},{"text":"nimeshangazwa na lile ninaloliona.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moyo wangu unababaika,","poem":1},{"text":"woga unanifanya nitetemeke,","poem":2},{"lineBreak":true},{"text":"gizagiza la jioni nililolitamani sana,","poem":2},{"lineBreak":true},{"text":"limekuwa hofu kuu kwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wanaandaa meza,","poem":1},{"text":"wanatandaza mazulia,","poem":2},{"lineBreak":true},{"text":"wanakula, wanakunywa!","poem":2},{"lineBreak":true},{"text":"Amkeni, enyi maafisa,","poem":2},{"lineBreak":true},{"text":"zitieni ngao mafuta!","poem":2}]},{"type":"verse","number":6,"content":["Hili ndilo Bwana analoniambia:",{"text":"“Nenda, weka mlinzi,","poem":1},{"text":"na atoe taarifa ya kile anachokiona.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anapoona magari ya vita","poem":1},{"text":"pamoja na kundi la farasi,","poem":2},{"text":"wapanda punda au wapanda ngamia,","poem":1},{"text":"na awe macho, awe macho kikamilifu.”","poem":2}]},{"type":"verse","number":8,"content":["Naye mlinzi alipaza sauti,",{"text":"“Mchana baada ya mchana, bwana wangu, ninasimama katika mnara wa ulinzi,","poem":1},{"text":"kila usiku ninakaa mahali pangu nilipoamriwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tazama, yuaja mtu anayepanda gari la vita","poem":1},{"text":"pamoja na kundi la farasi.","poem":2},{"text":"Naye anajibu:","poem":1},{"text":"‘Babeli umeanguka, umeanguka!","poem":2},{"text":"Vinyago vyote vya miungu yake","poem":1},{"text":"vimelala chini vikiwa vimevunjwa!’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ee watu wangu, mliopondwa kwenye sakafu ya kupuria,","poem":1},{"text":"ninawaambia kile nilichokisikia","poem":2},{"text":"kutoka kwa Bwana Mwenye Nguvu Zote,","poem":1},{"text":"kutoka kwa Mungu wa Israeli.","poem":2}]},{"type":"heading","content":["Unabii Dhidi Ya Edomu"]},{"type":"verse","number":11,"content":["Neno kuhusu Duma:",{"text":"Mtu fulani ananiita kutoka Seiri,","poem":1},{"text":"“Mlinzi, usiku utaisha lini?","poem":2},{"lineBreak":true},{"text":"Mlinzi, usiku utaisha lini?”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mlinzi anajibu,","poem":1},{"text":"“Asubuhi inakuja, lakini pia usiku.","poem":2},{"text":"Kama ungeliuliza, basi uliza;","poem":1},{"text":"bado na urudi tena.”","poem":2}]},{"type":"heading","content":["Unabii Dhidi Ya Arabia"]},{"type":"verse","number":13,"content":["Neno kuhusu Arabia:",{"text":"Enyi misafara ya Wadedani,","poem":1},{"text":"mnaopiga kambi katika vichaka vya Arabia,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"leteni maji kwa wenye kiu,","poem":1},{"text":"ninyi mnaoishi Tema,","poem":2},{"lineBreak":true},{"text":"leteni chakula kwa ajili ya wakimbizi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wanaukimbia upanga,","poem":1},{"text":"kutoka upanga uliochomolewa alani,","poem":2},{"text":"kutoka upinde uliopindwa,","poem":1},{"text":"na kutoka kwenye joto la vita.","poem":2}]},{"type":"verse","number":16,"content":["Hili ndilo Bwana analoniambia: “Katika muda wa mwaka mmoja, kama vile mtumishi aliyefungwa na mkataba angeihesabu, majivuno yote ya Kedari yatafikia mwisho."]},{"type":"verse","number":17,"content":["Wanaume wavutao pinde walionusurika, mashujaa wa Kedari, watakuwa wachache.” Bwana, Mungu wa Israeli, amesema."]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}