{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Unabii Kuhusu Tiro"]},{"type":"verse","number":1,"content":["Neno kuhusu Tiro:",{"text":"Ombolezeni, enyi meli za Tarshishi!","poem":1},{"text":"Kwa kuwa Tiro imeangamizwa,","poem":2},{"lineBreak":true},{"text":"imeachwa bila nyumba wala bandari.","poem":2},{"text":"Kuanzia nchi ya Kitimu","poem":1},{"noteId":23},{"text":"neno limewajia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nyamazeni kimya, enyi watu wa kisiwani,","poem":1},{"text":"pia ninyi wafanyabiashara wa Sidoni,","poem":2},{"lineBreak":true},{"text":"ambao mabaharia wamewatajirisha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwenye maji makuu","poem":1},{"text":"nafaka za Shihori zilikuja;","poem":2},{"text":"mavuno ya Naili yalikuwa mapato ya Tiro,","poem":1},{"text":"naye akawa soko la mataifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Uaibishwe ee Sidoni, nawe ee ngome la bahari,","poem":1},{"text":"kwa kuwa bahari imesema:","poem":2},{"text":"“Sijapata kuwa na uchungu wa kuzaa wala sijapata kuzaa,","poem":1},{"text":"wala sijapata kulea wana wala kutunza mabinti.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Habari ifikapo Misri,","poem":1},{"text":"watakuwa katika maumivu makuu kwa ajili ya taarifa kutoka Tiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vukeni mpaka Tarshishi,","poem":1},{"text":"ombolezeni, enyi watu wa kisiwani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je, huu ndio mji wenu uliojaa sherehe,","poem":1},{"text":"mji wa zamani, zamani kabisa","poem":2},{"text":"ambao miguu yake imeuchukua","poem":1},{"text":"kufanya makao nchi za mbali sana?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ni nani amepanga hili dhidi ya Tiro,","poem":1},{"text":"mji utoao mataji,","poem":2},{"text":"ambao wafanyabiashara wake ni wana wa mfalme","poem":1},{"text":"na wachuuzi wake ni watu mashuhuri wa dunia?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bwana Mwenye Nguvu Zote ndiye alipanga jambo hili,","poem":1},{"text":"ili kukishusha kiburi cha utukufu wote","poem":2},{"text":"na kuwanyenyekesha wale wote","poem":1},{"text":"ambao ni mashuhuri duniani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ee Binti Tarshishi,","poem":1},{"text":"pita katika nchi yako kama vile Mto Naili","poem":2},{"lineBreak":true},{"text":"kwa kuwa huna tena bandari.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwana amenyoosha mkono wake juu ya bahari","poem":1},{"text":"na kuzifanya falme zake zitetemeke.","poem":2},{"text":"Ametoa amri kuhusu Kanaani","poem":1},{"text":"kwamba ngome zake ziangamizwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Alisema, “Usizidi kufurahi,","poem":1},{"text":"ee Bikira Binti Sidoni, sasa umepondwa!","poem":2},{"lineBreak":true},{"text":"“Simama, vuka uende Kitimu;","poem":1},{"text":"hata huko hutapata pumziko.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tazama katika nchi ya Wakaldayo,","poem":1},{"text":"watu hawa ambao sasa hawaonekani kama wapo!","poem":2},{"text":"Waashuru wameifanya nchi hiyo","poem":1},{"text":"kuwa mahali pa viumbe wa jangwani.","poem":2},{"text":"Wamesimamisha minara yao ya vita kuuzunguka,","poem":1},{"text":"wameziteka ngome zake na kuziacha tupu","poem":2},{"lineBreak":true},{"text":"na kuufanya kuwa magofu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ombolezeni, enyi meli za Tarshishi;","poem":1},{"text":"ngome yenu imeangamizwa!","poem":2}]},{"type":"verse","number":15,"content":["Wakati huo Tiro utasahauliwa kwa miaka sabini, muda wa maisha ya mfalme. Lakini mwisho wa miaka hiyo sabini, itakuwa kwa Tiro kama ilivyo katika wimbo wa kahaba:"]},{"type":"verse","number":16,"content":[{"text":"“Twaa kinubi, tembea mjini kote,","poem":1},{"text":"ewe kahaba uliyesahauliwa;","poem":2},{"text":"piga kinubi vizuri, imba nyimbo nyingi,","poem":1},{"text":"ili upate kukumbukwa.”","poem":2}]},{"type":"verse","number":17,"content":["Mwishoni mwa miaka sabini, Bwana atashughulika na Tiro. Naye atarudia ajira yake ya ukahaba, na atafanya biashara yake na falme zote juu ya uso wa dunia."]},{"type":"verse","number":18,"content":["Lakini faida na mapato yake yatawekwa wakfu kwa Bwana; hayatahifadhiwa wala kufichwa. Faida zake zitakwenda kwa wale wakaao mbele za Bwana kwa ajili ya chakula tele na mavazi mazuri."]}],"footnotes":[{"noteId":23,"caller":"+","text":"Kitimu hapa ni Kipro, kisiwa katika Bahari ya Mediterania.","reference":{"chapter":23,"verse":1}}]},"thisChapterLink":"/api/swh_bib/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}