{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["Dunia Kuharibiwa Upesi"]},{"type":"verse","number":1,"content":[{"text":"Tazama, Bwana ataifanya dunia kuwa ukiwa","poem":1},{"text":"na kuiharibu,","poem":2},{"text":"naye atauharibu uso wake","poem":1},{"text":"na kutawanya wakaao ndani yake:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ndivyo itakavyokuwa","poem":1},{"text":"kwa makuhani na kwa watu,","poem":2},{"lineBreak":true},{"text":"kwa bwana na kwa mtumishi,","poem":2},{"lineBreak":true},{"text":"kwa bibi na kwa mtumishi wake wa kike,","poem":2},{"lineBreak":true},{"text":"kwa muuzaji na kwa mnunuzi,","poem":2},{"lineBreak":true},{"text":"kwa mkopaji na kwa mkopeshaji,","poem":2},{"lineBreak":true},{"text":"kwa mdaiwa na kwa mdai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dunia itaharibiwa kabisa","poem":1},{"text":"na kutekwa nyara kabisa.","poem":2},{"text":"Bwana amesema neno hili.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dunia inakauka na kunyauka,","poem":1},{"text":"dunia inanyongʼonyea na kunyauka,","poem":2},{"lineBreak":true},{"text":"waliotukuzwa wa dunia wananyongʼonyea.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Dunia imetiwa unajisi na watu wake;","poem":1},{"text":"wameacha kutii sheria,","poem":2},{"text":"wamevunja amri","poem":1},{"text":"na kuvunja agano la milele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa hiyo laana inaiteketeza dunia,","poem":1},{"text":"watu wake lazima waichukue hatia yao.","poem":2},{"text":"Kwa hiyo wakazi wa dunia wameteketezwa,","poem":1},{"text":"nao waliosalia ni wachache sana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Divai mpya inakauka na mzabibu unanyauka,","poem":1},{"text":"watu wote wafurahishao wanalia kwa huzuni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Furaha ya matoazi imekoma,","poem":1},{"text":"kelele za wenye furaha zimekoma,","poem":2},{"lineBreak":true},{"text":"shangwe za kinubi zimenyamaza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hawanywi tena mvinyo pamoja na wimbo,","poem":1},{"text":"kileo ni kichungu kwa wanywaji wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mji ulioharibiwa umekuwa ukiwa,","poem":1},{"text":"mlango wa kila nyumba umefungwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Barabarani wanalilia kupata mvinyo,","poem":1},{"text":"furaha yote imegeuka kuwa majonzi,","poem":2},{"lineBreak":true},{"text":"furaha yote imefukuziwa mbali na dunia.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mji umeachwa katika uharibifu,","poem":1},{"text":"lango lake limevunjwa vipande.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndivyo itakavyokuwa duniani","poem":1},{"text":"na miongoni mwa mataifa,","poem":2},{"text":"kama vile wakati mzeituni upigwavyo,","poem":1},{"text":"au kama vile wakati masazo yabakiavyo baada ya zabibu kuvunwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wanainua sauti zao, wanapiga kelele kwa furaha,","poem":1},{"text":"kutoka magharibi wanasifu kwa ukelele utukufu wa Bwana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa hiyo upande wa mashariki mpeni Bwana utukufu,","poem":1},{"text":"liadhimisheni jina la Bwana, Mungu wa Israeli,","poem":2},{"lineBreak":true},{"text":"katika visiwa vya bahari.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kutoka miisho ya dunia tunasikia uimbaji:","poem":1},{"text":"“Utukufu kwa Yule Mwenye Haki.”","poem":2},{"lineBreak":true},{"text":"Lakini nilisema, “Ninadhoofika, ninadhoofika!","poem":1},{"text":"Ole wangu!","poem":2},{"text":"Watenda hila wanasaliti!","poem":1},{"text":"Kwa hila watenda hila wanasaliti!”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hofu, shimo na mtego vinakungojea,","poem":1},{"text":"ewe mtu ukaaye duniani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kila akimbiaye asikiapo sauti ya hofu","poem":1},{"text":"atatumbukia shimoni,","poem":2},{"text":"naye yeyote apandaye kutoka shimoni,","poem":1},{"text":"atanaswa kwenye mtego.","poem":2},{"lineBreak":true},{"text":"Malango ya gharika ya mbinguni yamefunguliwa,","poem":1},{"text":"misingi ya dunia inatikisika.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Dunia imepasuka,","poem":1},{"text":"dunia imechanika,","poem":2},{"lineBreak":true},{"text":"dunia imetikiswa kabisa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dunia inapepesuka kama mlevi,","poem":1},{"text":"inayumbayumba kama kibanda kwenye upepo;","poem":2},{"text":"imelemewa sana na mzigo wa hatia ya uasi wake","poem":1},{"text":"na ikianguka kamwe haitainuka tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Katika siku ile Bwana ataadhibu","poem":1},{"text":"nguvu zilizoko mbinguni juu,","poem":2},{"lineBreak":true},{"text":"na wafalme walioko duniani chini.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Watakusanywa pamoja","poem":1},{"text":"kama wafungwa waliofungwa gerezani,","poem":2},{"text":"watafungiwa gerezani","poem":1},{"text":"na kuadhibiwa baada ya siku nyingi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mwezi utatiwa haya, nalo jua litaaibishwa;","poem":1},{"text":"kwa maana Bwana Mwenye Nguvu Zote atawala","poem":2},{"text":"juu ya Mlima Sayuni na katika Yerusalemu,","poem":1},{"text":"tena mbele ya wazee wake kwa utukufu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}