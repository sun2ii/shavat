{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Msifuni Bwana"]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, wewe ni Mungu wangu,","poem":1},{"text":"nitakutukuza na kulisifu jina lako,","poem":2},{"text":"kwa maana katika ukamilifu wa uaminifu","poem":1},{"text":"umetenda mambo ya ajabu,","poem":2},{"lineBreak":true},{"text":"mambo yaliyokusudiwa tangu zamani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umeufanya mji kuwa lundo la kifusi,","poem":1},{"text":"mji wenye ngome kuwa magofu,","poem":2},{"text":"ngome imara ya wageni kuwa si mji tena,","poem":1},{"text":"wala hautajengwa tena kamwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa hiyo mataifa yenye nguvu yatakuheshimu,","poem":1},{"text":"miji ya mataifa katili itakuheshimu wewe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umekuwa kimbilio la watu maskini,","poem":1},{"text":"kimbilio la mhitaji katika taabu yake,","poem":2},{"text":"hifadhi wakati wa dhoruba","poem":1},{"text":"na kivuli wakati wa hari.","poem":2},{"text":"Kwa maana pumzi ya wakatili","poem":1},{"text":"ni kama dhoruba ipigayo ukuta","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"na kama joto la jangwani.","poem":2},{"text":"Wewe wanyamazisha makelele ya wageni;","poem":1},{"text":"kama vile hari ipunguzwavyo na kivuli cha wingu,","poem":2},{"lineBreak":true},{"text":"ndivyo wimbo wa wakatili unyamazishwavyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Juu ya mlima huu Bwana Mwenye Nguvu Zote ataandaa","poem":1},{"text":"karamu ya vinono kwa mataifa yote,","poem":2},{"text":"karamu ya mvinyo wa zamani,","poem":1},{"text":"nyama nzuri sana na divai zilizo bora sana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Juu ya mlima huu ataharibu","poem":1},{"text":"sitara ihifadhiyo mataifa yote,","poem":2},{"text":"kile kifuniko kifunikacho mataifa yote,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"yeye atameza mauti milele.","poem":2},{"text":"Bwana Mwenyezi atafuta machozi katika nyuso zote;","poem":1},{"text":"ataondoa aibu ya watu wake duniani kote.","poem":2},{"text":"Bwana amesema hili.","poem":4}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Katika siku ile watasema,","poem":1},{"text":"“Hakika huyu ndiye Mungu wetu;","poem":2},{"lineBreak":true},{"text":"tulimtumaini, naye akatuokoa.","poem":2},{"text":"Huyu ndiye Bwana, tuliyemtumaini;","poem":1},{"text":"sisi tushangilie na kufurahia katika wokovu wake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mkono wa Bwana utatulia juu ya mlima huu,","poem":1},{"text":"bali Moabu atakanyagwa chini","poem":2},{"lineBreak":true},{"text":"kama majani makavu yakanyagwavyo kwenye shimo la mbolea.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Watakunjua mikono yao katikati yake,","poem":1},{"text":"kama vile mwogeleaji akunjuavyo mikono yake ili aogelee.","poem":2},{"text":"Mungu atashusha kiburi chao","poem":1},{"text":"licha ya ujanja wa mikono yao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Atabomoa kuta ndefu za maboma yako","poem":1},{"text":"na kuziangusha chini,","poem":2},{"text":"atazishusha chini ardhini,","poem":1},{"text":"mpaka mavumbini kabisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}