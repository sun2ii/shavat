{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Wokovu Kwa Ajili Ya Israeli"]},{"type":"verse","number":1,"content":["Katika siku ile,",{"text":"Bwana ataadhibu kwa upanga wake,","poem":1},{"text":"upanga wake mkali, mkubwa na wenye nguvu,","poem":2},{"text":"ataadhibu Lewiathani","poem":1},{"noteId":24},{"text":"yule nyoka apitaye kwa mwendo laini,","poem":1},{"text":"Lewiathani yule nyoka mwenye kujipinda;","poem":2},{"text":"atamuua joka huyo mkubwa sana wa baharini.","poem":1}]},{"type":"verse","number":2,"content":["Katika siku ile:",{"text":"“Imbeni kuhusu shamba la mizabibu lililozaa:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Mimi, Bwana, ninalitunza,","poem":2},{"lineBreak":true},{"text":"nalinyweshea maji mfululizo.","poem":2},{"text":"Ninalichunga usiku na mchana","poem":1},{"text":"ili mtu yeyote asije akalidhuru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mimi sijakasirika.","poem":1},{"text":"Licha pangekuwepo michongoma na miiba kunikabili!","poem":2},{"lineBreak":true},{"text":"Ningepambana dhidi yake katika vita,","poem":2},{"lineBreak":true},{"text":"ningeliichoma moto yote.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Au niwaache waje kwangu kwa ajili ya kupata kimbilio,","poem":1},{"text":"wao na wafanye amani nami,","poem":2},{"lineBreak":true},{"text":"naam, wafanye amani nami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Katika siku zijazo, Yakobo atatia mizizi,","poem":1},{"text":"Israeli atatoa chipukizi na kuchanua maua,","poem":2},{"lineBreak":true},{"text":"naye atajaza ulimwengu wote kwa matunda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Je, Bwana amempiga","poem":1},{"text":"vile alivyowapiga wale waliompiga?","poem":2},{"text":"Je, yeye ameuawa","poem":1},{"text":"vile walivyouawa wale waliomuua yeye?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa vita na kwa kumfukuza unapingana naye:","poem":1},{"text":"kwa mshindo wake mkali anamfukuza,","poem":2},{"lineBreak":true},{"text":"kama siku ile uvumapo upepo wa mashariki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa hili, basi, hatia ya Yakobo itafanyiwa upatanisho,","poem":1},{"text":"nalo hili litakuwa matunda ya utimilizo wa kuondolewa kwa dhambi yake:","poem":2},{"text":"Wakati atakapoyafanya mawe yote ya madhabahu","poem":1},{"text":"kuwa kama mawe ya chokaa yaliyopondwa vipande vipande,","poem":2},{"text":"hakuna nguzo za Ashera au madhabahu za kufukizia uvumba","poem":1},{"text":"zitakazobaki zimesimama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mji ulio na boma umebaki ukiwa,","poem":1},{"text":"makao yaliyotelekezwa, yaliyoachwa kama jangwa.","poem":2},{"text":"Huko ndama hulisha,","poem":1},{"text":"huko hujilaza,","poem":2},{"lineBreak":true},{"text":"wanakwanyua matawi yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wakati vijiti vyake vimekauka, huvunjwa","poem":1},{"text":"nao wanawake huja na kuwasha navyo moto.","poem":2},{"text":"Kwa kuwa hili ni taifa lisilo na ufahamu,","poem":1},{"text":"kwa hiyo yeye aliyewafanya hana huruma juu yao,","poem":2},{"lineBreak":true},{"text":"Muumba wao hawaonyeshi fadhili.","poem":2}]},{"type":"verse","number":12,"content":["Katika siku ile Bwana atapura kutoka matiririko ya Mto Frati hadi Kijito cha Misri, nanyi ee Waisraeli, mtakusanywa mmoja mmoja."]},{"type":"verse","number":13,"content":["Katika siku ile tarumbeta kubwa italia. Wale waliokuwa wakiangamia katika nchi ya Ashuru, nao wale waliokuwa uhamishoni katika nchi ya Misri watakuja na kumwabudu Bwana katika mlima mtakatifu huko Yerusalemu."]}],"footnotes":[{"noteId":24,"caller":"+","text":"Lewiathani ni mnyama mkubwa wa baharini mwenye magamba anayefanana na joka kubwa, mwenye umbo la kutisha, asiyeweza kuvuliwa.","reference":{"chapter":27,"verse":1}}]},"thisChapterLink":"/api/swh_bib/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}