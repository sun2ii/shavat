{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["Ole Wa Efraimu"]},{"type":"verse","number":1,"content":[{"text":"Ole kwa lile taji la maua, kiburi cha walevi wa Efraimu,","poem":1},{"text":"kwa ua linalosinyaa, uzuri wa utukufu wake,","poem":2},{"text":"uliowekwa kwenye kichwa cha bonde lenye rutuba:","poem":1},{"text":"kwa ule mji, kiburi cha wale walioshushwa na mvinyo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tazama, Bwana anaye mmoja aliye na uwezo na nguvu.","poem":1},{"text":"Kama dhoruba ya mvua ya mawe na upepo uharibuo,","poem":2},{"text":"kama mvua inyeshayo kwa nguvu na mafuriko yashukayo,","poem":1},{"text":"atakiangusha chini kwa nguvu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lile taji la maua, kiburi cha walevi cha Efraimu,","poem":1},{"text":"kitakanyagwa chini ya nyayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lile ua linalosinyaa, uzuri wa utukufu wake,","poem":1},{"text":"uliowekwa kwenye kichwa cha bonde lenye rutuba,","poem":2},{"text":"litakuwa kama tini iliyoiva kabla ya mavuno:","poem":1},{"text":"mara mtu aionapo, huichuma na kuila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Katika siku ile, Bwana Mwenye Nguvu Zote","poem":1},{"text":"atakuwa taji la utukufu,","poem":2},{"text":"taji zuri la maua","poem":1},{"text":"kwa mabaki ya watu wake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atakuwa roho ya haki","poem":1},{"text":"kwa yeye aketiye katika kiti cha hukumu,","poem":2},{"text":"chanzo cha nguvu","poem":1},{"text":"kwa wale wazuiao vita langoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hawa pia wanapepesuka kwa sababu ya mvinyo,","poem":1},{"text":"wanayumbayumba kwa sababu ya kileo:","poem":2},{"text":"Makuhani na manabii wanapepesuka kwa sababu ya kileo,","poem":1},{"text":"wanachanganyikiwa kwa sababu ya mvinyo;","poem":2},{"text":"wanapepesuka wanapoona maono,","poem":1},{"text":"wanajikwaa wanapotoa maamuzi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Meza zote zimejawa na matapishi","poem":1},{"text":"wala hakuna sehemu hata ndogo","poem":2},{"lineBreak":true},{"text":"isiyokuwa na uchafu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Yeye anajaribu kumfundisha nani?","poem":1},{"text":"Yeye anamwelezea nani ujumbe wake?","poem":2},{"text":"Je, ni kwa watoto walioachishwa kunyonya?","poem":1},{"text":"Je, ni wale ambao ndipo tu wametolewa matitini?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa maana ni:","poem":1},{"text":"Amri juu ya amri, amri juu ya amri,","poem":2},{"lineBreak":true},{"text":"kanuni juu ya kanuni, kanuni juu ya kanuni;","poem":2},{"lineBreak":true},{"text":"hapa kidogo, kule kidogo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Sawa kabisa, kwa midomo migeni","poem":1},{"text":"na kwa lugha ngeni,","poem":2},{"lineBreak":true},{"text":"Mungu atasema na watu hawa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"wale ambao aliwaambia,","poem":1},{"text":"“Hapa ni mahali pa kupumzika,","poem":2},{"lineBreak":true},{"text":"waliochoka na wapumzike,”","poem":2},{"text":"na, “Hapa ni mahali pa mapumziko,”","poem":1},{"text":"lakini hawakutaka kusikiliza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hivyo basi, neno la Bwana kwao litakuwa:","poem":1},{"text":"Amri juu ya amri, amri juu ya amri,","poem":2},{"lineBreak":true},{"text":"kanuni juu ya kanuni, kanuni juu ya kanuni,","poem":2},{"lineBreak":true},{"text":"hapa kidogo, kule kidogo:","poem":2},{"text":"ili waende na kuanguka chali,","poem":1},{"text":"wakijeruhiwa, wakinaswa na kukamatwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kwa hiyo sikieni neno la Bwana, enyi watu wenye dharau","poem":1},{"text":"mnaotawala watu hawa wa Yerusalemu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ninyi mnajisifu, “Tumefanya agano na mauti,","poem":1},{"text":"tumefanya mapatano na kuzimu.","poem":2},{"text":"Wakati pigo lifurikalo litakapopita,","poem":1},{"text":"haliwezi kutugusa sisi,","poem":2},{"text":"kwa kuwa tumefanya uongo kuwa kimbilio letu","poem":1},{"text":"na miungu ya uongo kuwa mahali petu pa kujificha.”","poem":2}]},{"type":"verse","number":16,"content":["Kwa hiyo hivi ndivyo Bwana Mwenyezi asemavyo:",{"text":"“Tazama, ninaweka jiwe katika Sayuni,","poem":1},{"text":"jiwe lililojaribiwa,","poem":2},{"text":"jiwe la pembeni la thamani kwa ajili ya msingi thabiti.","poem":1},{"text":"Yeye atumainiye kamwe hatatiwa hofu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nitaifanya haki kuwa kamba ya kupimia","poem":1},{"text":"na uadilifu kuwa timazi;","poem":2},{"text":"mvua ya mawe itafagia kimbilio lenu, huo uongo,","poem":1},{"text":"nayo maji yatafurikia mahali penu pa kujificha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Agano lenu na kifo litabatilishwa,","poem":1},{"text":"patano lenu na kuzimu halitasimama.","poem":2},{"text":"Wakati pigo lifurikalo litakapowakumba,","poem":1},{"text":"litawaangusha chini.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kila mara lijapo litawachukua,","poem":1},{"text":"asubuhi baada ya asubuhi,","poem":2},{"text":"wakati wa mchana na wakati wa usiku,","poem":1},{"text":"litawakumba tangu mwanzo hadi mwisho.”","poem":2},{"lineBreak":true},{"text":"Kuuelewa ujumbe huu","poem":1},{"text":"utaleta hofu tupu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kitanda ni kifupi mno kujinyoosha juu yake,","poem":1},{"text":"nguo ya kujifunikia ni nyembamba mno","poem":2},{"lineBreak":true},{"text":"mtu hawezi kujifunikia.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Bwana atainuka kama alivyofanya kwenye Mlima Perasimu,","poem":1},{"text":"ataghadhibika kama alivyofanya katika Bonde la Gibeoni:","poem":2},{"text":"ili kufanya kazi yake, kazi yake ya ajabu,","poem":1},{"text":"ili kutimiza kazi yake, kazi yake ngeni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sasa acheni dharau zenu,","poem":1},{"text":"la sivyo minyororo yenu itakuwa mizito zaidi.","poem":2},{"text":"Bwana, Bwana Mwenye Nguvu Zote, ameniambia","poem":1},{"text":"habari za maangamizi yaliyoamriwa dhidi ya nchi yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Sikilizeni msikie sauti yangu,","poem":1},{"text":"tegeni masikio na msikie niyasemayo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wakati mkulima alimapo ili apande,","poem":1},{"text":"je, hulima siku zote?","poem":2},{"text":"Je, huendelea kubomoa ardhi","poem":1},{"text":"na kusawazisha udongo?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Akiisha kusawazisha shamba,","poem":1},{"text":"je, hatapanyi mbegu za bizari na kutawanya jira?","poem":2},{"text":"Je, hapandi ngano katika sehemu yake,","poem":1},{"text":"shayiri katika eneo lake,","poem":2},{"lineBreak":true},{"text":"na nafaka nyingine katika shamba lake?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mungu wake humwelekeza","poem":1},{"text":"na kumfundisha njia iliyo sahihi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Iliki haipurwi kwa nyundo,","poem":1},{"text":"wala gurudumu la gari halivingirishwi juu ya jira;","poem":2},{"text":"iliki hupurwa kwa fimbo,","poem":1},{"text":"na jira kwa ufito.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nafaka lazima isagwe ili kutengeneza mkate,","poem":1},{"text":"kwa hiyo mtu haendelei kuipura daima.","poem":2},{"text":"Ingawa huendesha magurudumu ya gari lake la kupuria juu yake,","poem":1},{"text":"farasi wake hawasagi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Haya yote pia hutoka kwa Bwana Mwenye Nguvu Zote,","poem":1},{"text":"mwenye mashauri ya ajabu, na anayepita wote kwa hekima.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}