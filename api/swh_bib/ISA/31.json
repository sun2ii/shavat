{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["Ole Wa Wale Wanaotegemea Misri"]},{"type":"verse","number":1,"content":[{"text":"Ole wao wale washukao Misri kwa ajili ya msaada,","poem":1},{"text":"wale wategemeao farasi,","poem":2},{"text":"wanaoweka tumaini katika wingi wa magari yao ya vita,","poem":1},{"text":"na katika nguvu nyingi za wapanda farasi,","poem":2},{"text":"lakini hawamwangalii yeye Aliye Mtakatifu wa Israeli,","poem":1},{"text":"wala hawatafuti msaada kwa Bwana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hata hivyo yeye pia ana hekima na anaweza kuleta maafa,","poem":1},{"text":"wala hayatangui maneno yake.","poem":2},{"text":"Yeye atainuka dhidi ya nyumba ya mwovu,","poem":1},{"text":"dhidi ya wale ambao huwasaidia watenda mabaya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lakini Wamisri ni wanadamu, wala si Mungu,","poem":1},{"text":"farasi wao ni nyama, wala si roho.","poem":2},{"text":"Wakati Bwana atakaponyoosha Mkono wake,","poem":1},{"text":"yeye anayesaidia atajikwaa,","poem":2},{"lineBreak":true},{"text":"naye anayesaidiwa ataanguka,","poem":2},{"lineBreak":true},{"text":"wote wawili wataangamia pamoja.","poem":2}]},{"type":"verse","number":4,"content":["Hili ndilo Bwana analoniambia:",{"text":"“Kama vile simba angurumavyo,","poem":1},{"text":"simba mkubwa juu ya mawindo yake:","poem":2},{"text":"hata ingawa kundi lote la wachunga mifugo","poem":1},{"text":"huitwa pamoja dhidi yake,","poem":2},{"text":"hatiwi hofu na kelele zao","poem":1},{"text":"wala kusumbuliwa na ghasia zao;","poem":2},{"text":"ndivyo Bwana Mwenye Nguvu Zote atakavyoshuka","poem":1},{"text":"kufanya vita juu ya Mlima Sayuni","poem":2},{"lineBreak":true},{"text":"na juu ya vilele vyake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kama ndege warukao,","poem":1},{"text":"Bwana Mwenye Nguvu Zote ataukinga Yerusalemu;","poem":2},{"text":"ataukinga na kuuokoa,","poem":1},{"text":"atapita juu yake na kuufanya salama.”","poem":2}]},{"type":"verse","number":6,"content":["Mrudieni yeye ambaye nyumba ya Israeli imemwasi sana."]},{"type":"verse","number":7,"content":["Kwa kuwa katika siku ile kila mmoja wenu atazikataa sanamu za fedha na za dhahabu zilizotengenezwa kwa mikono yenu yenye dhambi."]},{"type":"verse","number":8,"content":[{"text":"“Ashuru itaanguka kwa upanga ambao si wa mwanadamu;","poem":1},{"text":"upanga usio wa kibinadamu utawaangamiza.","poem":2},{"text":"Watakimbia mbele ya upanga","poem":1},{"text":"na vijana wao wa kiume watafanyizwa kazi kwa lazima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ngome zao zitaanguka kwa sababu ya hofu;","poem":1},{"text":"kwa kuona bendera ya vita,","poem":2},{"lineBreak":true},{"text":"majemadari wao watashikwa na hofu ya ghafula,”","poem":2},{"text":"asema Bwana,","poem":1},{"text":"ambaye moto wake uko Sayuni,","poem":2},{"lineBreak":true},{"text":"nayo tanuru yake iko Yerusalemu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}