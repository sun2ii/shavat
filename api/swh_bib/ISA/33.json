{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["Taabu Na Msaada"]},{"type":"verse","number":1,"content":[{"text":"Ole wako wewe, ee mharabu,","poem":1},{"text":"wewe ambaye hukuharibiwa!","poem":2},{"text":"Ole wako, ee msaliti,","poem":1},{"text":"wewe ambaye hukusalitiwa!","poem":2},{"text":"Utakapokwisha kuharibu,","poem":1},{"text":"utaharibiwa;","poem":2},{"text":"utakapokwisha kusaliti,","poem":1},{"text":"utasalitiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ee Bwana, uturehemu,","poem":1},{"text":"tunakutamani.","poem":2},{"text":"Uwe nguvu yetu kila asubuhi","poem":1},{"text":"na wokovu wetu wakati wa taabu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa ngurumo ya sauti yako, mataifa yanakimbia;","poem":1},{"text":"unapoinuka, mataifa hutawanyika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mateka yenu, enyi mataifa, yamevunwa kama vile wafanyavyo madumadu,","poem":1},{"text":"kama kundi la nzige watu huvamia juu yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwana ametukuka, kwa kuwa anakaa mahali palipoinuka,","poem":1},{"text":"ataijaza Sayuni kwa haki na uadilifu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atakuwa msingi ulio imara kwa wakati wenu,","poem":1},{"text":"ghala za wokovu tele, hekima na maarifa;","poem":2},{"lineBreak":true},{"text":"kumcha Bwana ni ufunguo wa hazina hii.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Angalia, watu wake mashujaa wanapiga kelele kwa nguvu barabarani,","poem":1},{"text":"wajumbe wa amani wanalia kwa uchungu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Njia kuu zimeachwa,","poem":1},{"text":"hakuna wasafiri barabarani.","poem":2},{"text":"Mkataba umevunjika,","poem":1},{"text":"mashahidi wake wamedharauliwa,","poem":2},{"noteId":25},{"lineBreak":true},{"text":"hakuna yeyote anayeheshimiwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ardhi inaomboleza","poem":1},{"noteId":26},{"text":"na kuchakaa,","poem":1},{"text":"Lebanoni imeaibika na kunyauka,","poem":2},{"text":"Sharoni ni kama Araba,","poem":1},{"text":"nayo Bashani na Karmeli","poem":2},{"lineBreak":true},{"text":"wanapukutisha majani yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Sasa nitainuka,” asema Bwana.","poem":1},{"text":"“Sasa nitatukuzwa;","poem":2},{"lineBreak":true},{"text":"sasa nitainuliwa juu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mlichukua mimba ya makapi,","poem":1},{"text":"mkazaa mabua,","poem":2},{"lineBreak":true},{"text":"pumzi yenu ni moto uwateketezao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mataifa yatachomwa kama ichomwavyo chokaa,","poem":1},{"text":"kama vichaka vya miiba vilivyokatwa ndivyo watakavyochomwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ninyi mlio mbali sana, sikieni lile nililofanya;","poem":1},{"text":"ninyi mlio karibu, tambueni uweza wangu!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wenye dhambi katika Sayuni wametiwa hofu,","poem":1},{"text":"kutetemeka kumewakumba wasiomcha Mungu:","poem":2},{"text":"“Ni nani miongoni mwetu awezaye kuishi na moto ulao?","poem":1},{"text":"Ni nani miongoni mwetu awezaye kuishi na moto unaowaka milele?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yeye aendaye kwa uadilifu","poem":1},{"text":"na kusema lililo haki,","poem":2},{"text":"yeye anayekataa faida ipatikanayo kwa dhuluma","poem":1},{"text":"na kuizuia mikono yake isipokee rushwa,","poem":2},{"text":"yeye azuiaye masikio yake dhidi ya mashauri ya mauaji,","poem":1},{"text":"na yeye afumbaye macho yake yasitazame sana uovu:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"huyu ndiye mtu atakayeishi mahali pa juu,","poem":1},{"text":"ambaye kimbilio lake litakuwa ngome ya mlimani.","poem":2},{"text":"Atapewa mkate wake,","poem":1},{"text":"na maji yake hayatakoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Macho yenu yatamwona mfalme katika uzuri wake","poem":1},{"text":"na kuiona nchi inayoenea mbali.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Katika mawazo yenu mtaifikiria hofu iliyopita:","poem":1},{"text":"“Yuko wapi yule afisa mkuu?","poem":2},{"lineBreak":true},{"text":"Yuko wapi yule aliyechukua ushuru?","poem":2},{"lineBreak":true},{"text":"Yuko wapi afisa msimamizi wa minara?”","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hutawaona tena wale watu wenye kiburi,","poem":1},{"text":"wale watu wenye usemi wa mafumbo,","poem":2},{"lineBreak":true},{"text":"wenye lugha ngeni, isiyoeleweka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mtazame Sayuni, mji wa sikukuu zetu;","poem":1},{"text":"macho yenu yatauona Yerusalemu,","poem":2},{"lineBreak":true},{"text":"mahali pa amani pa kuishi, hema ambalo halitaondolewa,","poem":2},{"text":"nguzo zake hazitangʼolewa kamwe,","poem":1},{"text":"wala hakuna kamba yake yoyote itakayokatika.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Huko Bwana atakuwa Mwenye Nguvu wetu.","poem":1},{"text":"Patakuwa kama mahali pa mito mipana na vijito.","poem":2},{"text":"Hakuna jahazi lenye makasia litakalopita huko,","poem":1},{"text":"wala hakuna meli yenye nguvu itakayopita huko.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kwa kuwa Bwana ni mwamuzi wetu,","poem":1},{"text":"Bwana ndiye mtoa sheria wetu,","poem":2},{"text":"Bwana ni mfalme wetu,","poem":1},{"text":"yeye ndiye atakayetuokoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kamba zenu za merikebu zimelegea:","poem":1},{"text":"Mlingoti haukusimama imara,","poem":2},{"lineBreak":true},{"text":"nalo tanga halikukunjuliwa.","poem":2},{"text":"Wingi wa mateka yatagawanywa,","poem":1},{"text":"hata yeye aliye mlemavu atachukua nyara.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hakuna yeyote aishiye Sayuni atakayesema, “Mimi ni mgonjwa”;","poem":1},{"text":"nazo dhambi za wale waishio humo zitasamehewa.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"Au: miji yake imedharauliwa.","reference":{"chapter":33,"verse":8}},{"noteId":26,"caller":"+","text":"Au: Ardhi inakauka.","reference":{"chapter":33,"verse":9}}]},"thisChapterLink":"/api/swh_bib/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}