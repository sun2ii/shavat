{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["Furaha Ya Waliokombolewa"]},{"type":"verse","number":1,"content":[{"text":"Jangwa na nchi kame vitafurahi;","poem":1},{"text":"nyika itashangilia na kuchanua maua.","poem":2},{"text":"Kama waridi,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"litachanua maua,","poem":1},{"text":"litashangilia sana na kupaza sauti kwa furaha.","poem":2},{"text":"Litapewa utukufu wa Lebanoni,","poem":1},{"text":"fahari ya Karmeli na Sharoni;","poem":2},{"text":"wataona utukufu wa Bwana,","poem":1},{"text":"fahari ya Mungu wetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Itieni nguvu mikono iliyo dhaifu,","poem":1},{"text":"yafanyeni imara magoti yaliyolegea,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"waambieni wale wenye mioyo ya hofu,","poem":1},{"text":"“Kuweni hodari, msiogope;","poem":2},{"text":"tazama, Mungu wenu atakuja,","poem":1},{"text":"pamoja na malipo ya Mungu,","poem":2},{"lineBreak":true},{"text":"atakuja na kuwaokoa ninyi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndipo macho ya vipofu yatafumbuliwa","poem":1},{"text":"na masikio ya viziwi yatazibuliwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndipo kilema atarukaruka kama kulungu,","poem":1},{"text":"nao ulimi wa aliye bubu utapaza sauti kwa shangwe.","poem":2},{"text":"Maji yatatiririka kwa kasi katika nyika,","poem":1},{"text":"na vijito katika jangwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mchanga wa moto utakuwa bwawa la maji,","poem":1},{"text":"ardhi yenye kiu itabubujika chemchemi.","poem":2},{"text":"Maskani ya mbweha walikolala hapo awali","poem":1},{"text":"patamea majani, matete na mafunjo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nako kutakuwa na njia kuu,","poem":1},{"text":"nayo itaitwa Njia ya Utakatifu.","poem":2},{"text":"Wasio safi hawatapita juu yake;","poem":1},{"text":"itakuwa ya wale watembeao katika Njia ile;","poem":2},{"text":"yeye asafiriye juu yake,","poem":1},{"text":"ajapokuwa mjinga, hatapotea.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huko hakutakuwepo na simba,","poem":1},{"text":"wala mnyama mkali hatapita njia hiyo,","poem":2},{"lineBreak":true},{"text":"wala hawatapatikana humo.","poem":2},{"text":"Ila waliokombolewa tu ndio watakaopita huko,","poem":1}]},{"type":"verse","number":10,"content":[{"text":"waliokombolewa na Bwana watarudi.","poem":2},{"text":"Wataingia Sayuni wakiimba;","poem":1},{"text":"furaha ya milele itakuwa juu ya vichwa vyao.","poem":2},{"text":"Watapata furaha na shangwe;","poem":1},{"text":"huzuni na majonzi vitakimbia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}