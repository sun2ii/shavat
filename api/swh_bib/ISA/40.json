{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["Faraja Kwa Watu Wa Mungu"]},{"type":"verse","number":1,"content":[{"text":"Wafarijini, wafarijini watu wangu,","poem":1},{"text":"asema Mungu wenu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sema na Yerusalemu kwa upole,","poem":1},{"text":"umtangazie","poem":2},{"text":"kwamba kazi yake ngumu imekamilika,","poem":1},{"text":"kwamba dhambi yake imefanyiwa fidia,","poem":2},{"text":"kwamba amepokea kutoka mkononi mwa Bwana","poem":1},{"text":"maradufu kwa ajili ya dhambi zake zote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Sauti ya mtu aliaye:","poem":1},{"text":"“Itengenezeni jangwani njia ya Bwana,","poem":2},{"text":"nyoosheni njia kuu nyikani","poem":1},{"text":"kwa ajili ya Mungu wetu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kila bonde litainuliwa,","poem":1},{"text":"kila mlima na kilima kitashushwa;","poem":2},{"text":"penye mabonde patanyooshwa,","poem":1},{"text":"napo palipoparuza patasawazishwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Utukufu wa Bwana utafunuliwa,","poem":1},{"text":"nao wanadamu wote watauona pamoja.","poem":2},{"text":"Kwa maana kinywa cha Bwana kimenena.”","poem":4}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sauti husema, “Piga kelele.”","poem":1},{"text":"Nami nikasema, “Nipige kelele gani?”","poem":2},{"lineBreak":true},{"text":"“Wanadamu wote ni kama majani,","poem":1},{"text":"nao utukufu wao wote","poem":2},{"lineBreak":true},{"text":"ni kama maua ya kondeni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Majani hunyauka na maua huanguka,","poem":1},{"text":"kwa sababu pumzi ya Bwana huyapuliza.","poem":2},{"lineBreak":true},{"text":"Hakika wanadamu ni majani.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Majani hunyauka na maua huanguka,","poem":1},{"text":"lakini neno la Mungu wetu ladumu milele.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wewe uletaye habari njema Sayuni,","poem":1},{"text":"panda juu ya mlima mrefu.","poem":2},{"text":"Wewe uletaye habari njema Yerusalemu,","poem":1},{"text":"inua sauti yako kwa kupiga kelele,","poem":2},{"lineBreak":true},{"text":"inua sauti, usiogope;","poem":2},{"text":"iambie miji ya Yuda,","poem":1},{"text":"“Yuko hapa Mungu wenu!”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tazameni, Bwana Mwenyezi anakuja na nguvu,","poem":1},{"text":"nao mkono wake ndio utawalao kwa ajili yake.","poem":2},{"text":"Tazameni, ujira wake u pamoja naye,","poem":1},{"text":"nayo malipo yake yanafuatana naye.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Huchunga kundi lake kama mchungaji wa mifugo:","poem":1},{"text":"Hukusanya wana-kondoo katika mikono yake","poem":2},{"text":"na kuwachukua karibu na moyo wake,","poem":1},{"text":"huwaongoza taratibu wale wanyonyeshao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ni nani aliyepima maji ya bahari","poem":1},{"text":"kwenye konzi ya mkono wake,","poem":2},{"lineBreak":true},{"text":"au kuzipima mbingu kwa shibiri","poem":2},{"noteId":29},{"text":"yake?","poem":2},{"text":"Ni nani aliyeyashika mavumbi ya dunia katika kikapu,","poem":1},{"text":"au kupima milima kwenye kipimio","poem":2},{"lineBreak":true},{"text":"na vilima kwenye mizani?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ni nani aliyeyafahamu mawazo ya Bwana,","poem":1},{"text":"au kumfundisha akiwa kama mshauri wake?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ni nani ambaye Bwana ametaka shauri kwake ili kumwelimisha,","poem":1},{"text":"naye ni nani aliyemfundisha njia iliyo sawa?","poem":2},{"text":"Ni nani aliyemfundisha maarifa","poem":1},{"text":"au kumwonyesha mapito ya ufahamu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hakika mataifa ni kama tone ndani ya ndoo,","poem":1},{"text":"ni kama vumbi jembamba juu ya mizani,","poem":2},{"lineBreak":true},{"text":"huvipima visiwa kana kwamba vilikuwa vumbi laini.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lebanoni hautoshi kwa moto wa madhabahuni,","poem":1},{"text":"wala wanyama wake hawatoshi kwa sadaka za kuteketezwa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbele yake mataifa yote ni kama si kitu,","poem":1},{"text":"yanaonekana yasio na thamani","poem":2},{"lineBreak":true},{"text":"na zaidi ya bure kabisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Basi, utamlinganisha Mungu na nani?","poem":1},{"text":"Utamlinganisha na kitu gani?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kwa habari ya sanamu, fundi huisubu,","poem":1},{"text":"naye mfua dhahabu huifunika kwa dhahabu","poem":2},{"lineBreak":true},{"text":"na kuitengenezea mikufu ya fedha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mtu aliye maskini sana asiyeweza kuleta sadaka kama hii","poem":1},{"text":"huuchagua mti usiooza.","poem":2},{"text":"Humtafuta fundi stadi","poem":1},{"text":"wa kusimamisha sanamu ambayo haitatikisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Je, hujui?","poem":1},{"text":"Je, hujasikia?","poem":2},{"text":"Je, hujaambiwa tangu mwanzo?","poem":1},{"text":"Je, hujafahamu tangu kuumbwa kwa dunia?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anakaa kwenye kiti cha enzi juu ya duara ya dunia,","poem":1},{"text":"nao watu wakaao ndani yake ni kama panzi.","poem":2},{"text":"Huzitandaza mbingu kama chandarua,","poem":1},{"text":"na kuzitandaza kama hema la kuishi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Huwafanya wakuu kuwa si kitu,","poem":1},{"text":"na kuwashusha watawala wa dunia hii kuwa kitu bure.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mara baada ya kupandwa,","poem":1},{"text":"mara baada ya kutiwa ardhini,","poem":2},{"lineBreak":true},{"text":"mara baada ya kutoa mizizi yao ardhini,","poem":2},{"text":"ndipo huwapulizia nao wakanyauka,","poem":1},{"text":"nao upepo wa kisulisuli","poem":2},{"lineBreak":true},{"text":"huwapeperusha kama makapi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Utanilinganisha mimi na nani?","poem":1},{"text":"Au ni nani anayelingana nami?” asema yeye Aliye Mtakatifu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inueni macho yenu mtazame mbinguni:","poem":1},{"text":"Ni nani aliyeumba hivi vyote?","poem":2},{"text":"Ni yeye aletaye nje jeshi la nyota moja baada ya nyingine","poem":1},{"text":"na kuziita kila moja kwa jina lake.","poem":2},{"text":"Kwa sababu ya uweza wake mkuu na nguvu zake kuu,","poem":1},{"text":"hakuna hata mojawapo inayokosekana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Kwa nini unasema, ee Yakobo,","poem":1},{"text":"nanyi ee Israeli, kulalamika,","poem":2},{"text":"“Njia yangu imefichwa Bwana asiione,","poem":1},{"text":"Mungu wangu hajali shauri langu?”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Je wewe, hufahamu?","poem":1},{"text":"Je wewe, hujasikia?","poem":2},{"text":"Bwana ni Mungu wa milele,","poem":1},{"text":"Muumba wa miisho ya dunia.","poem":2},{"text":"Hatachoka wala kulegea,","poem":1},{"text":"wala hakuna hata mmoja","poem":2},{"lineBreak":true},{"text":"awezaye kuupima ufahamu wake.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Huwapa nguvu waliolegea","poem":1},{"text":"na huongeza nguvu za wadhaifu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Hata vijana huchoka na kulegea,","poem":1},{"text":"nao vijana wanaume hujikwaa na kuanguka,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"bali wale wamtumainio Bwana","poem":1},{"text":"atafanya upya nguvu zao.","poem":2},{"text":"Watapaa juu kwa mbawa kama tai;","poem":1},{"text":"watapiga mbio wala hawatachoka,","poem":2},{"lineBreak":true},{"text":"watatembea kwa miguu wala hawatazimia.","poem":2}]}],"footnotes":[{"noteId":29,"caller":"+","text":"Shibiri ni sawa na sentimita 20 au inchi 8.","reference":{"chapter":40,"verse":12}}]},"thisChapterLink":"/api/swh_bib/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}