{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["Msaidizi Wa Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Nyamazeni kimya mbele zangu, enyi visiwa!","poem":1},{"text":"Mataifa na wafanye upya nguvu zao!","poem":2},{"text":"Wao na wajitokeze, kisha waseme,","poem":1},{"text":"tukutane pamoja mahali pa hukumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Ni nani aliyemchochea mmoja kutoka mashariki,","poem":1},{"text":"akimwita katika haki kwa utumishi wake?","poem":2},{"text":"Huyatia mataifa mikononi mwake,","poem":1},{"text":"na kuwatiisha wafalme mbele zake.","poem":2},{"text":"Huwafanya kuwa mavumbi kwa upanga wake,","poem":1},{"text":"huwafanya makapi yapeperushwayo na upepo kwa upinde wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Huwafuatia na kuendelea salama,","poem":1},{"text":"katika njia ambayo miguu yake haijawahi kupita.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ni nani aliyefanya jambo hili na kulitimiliza,","poem":1},{"text":"akiita vizazi tangu mwanzo?","poem":2},{"text":"Mimi, Bwana, ni wa kwanza","poem":1},{"text":"nami nitakuwa pamoja na wa mwisho:","poem":2},{"lineBreak":true},{"text":"mimi Bwana ndiye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Visiwa vimeliona na kuogopa,","poem":1},{"text":"miisho ya dunia inatetemeka.","poem":2},{"text":"Wanakaribia na kuja mbele,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"kila mmoja humsaidia mwingine","poem":2},{"lineBreak":true},{"text":"na kusema kwa ndugu yake, “Uwe hodari!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Fundi humtia moyo sonara,","poem":1},{"text":"yeye alainishaye kwa nyundo","poem":2},{"lineBreak":true},{"text":"humhimiza yeye agongeaye kwenye fuawe,","poem":2},{"text":"Humwambia yeye aunganishaye, “Ni kazi njema.”","poem":1},{"text":"Naye huikaza sanamu kwa misumari ili isitikisike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Lakini wewe, ee Israeli, mtumishi wangu,","poem":1},{"text":"Yakobo, niliyemchagua,","poem":2},{"lineBreak":true},{"text":"ninyi wazao wa Abrahamu rafiki yangu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"nilikuchukua toka miisho ya dunia,","poem":1},{"text":"nilikuita kutoka pembe zake za mbali.","poem":2},{"text":"Nilisema, ‘Wewe ni mtumishi wangu’;","poem":1},{"text":"nimekuchagua, wala sikukukataa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hivyo usiogope, kwa maana niko pamoja nawe;","poem":1},{"text":"usifadhaike, kwa maana mimi ni Mungu wako.","poem":2},{"text":"Nitakutia nguvu na kukusaidia;","poem":1},{"text":"nitakutegemeza kwa mkono wa kuume wa haki yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Wote walioona hasira dhidi yako","poem":1},{"text":"hakika wataaibika na kutahayarika,","poem":2},{"text":"wale wakupingao","poem":1},{"text":"watakuwa kama vile si kitu, na kuangamia.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ingawa utawatafuta adui zako,","poem":1},{"text":"hutawaona.","poem":2},{"text":"Wale wanaopigana vita dhidi yako","poem":1},{"text":"watakuwa kama vile si kitu kabisa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa maana Mimi ndimi Bwana, Mungu wako,","poem":1},{"text":"nikushikaye mkono wako wa kuume","poem":2},{"text":"na kukuambia, Usiwe na hofu,","poem":1},{"text":"nitakusaidia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Usiogope, ee Yakobo uliye mdudu,","poem":1},{"text":"ee Israeli uliye mdogo,","poem":2},{"text":"kwa kuwa Mimi mwenyewe nitakusaidia,” asema Bwana,","poem":1},{"text":"Mkombozi wako, yeye Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Tazama, nitakufanya chombo cha kupuria,","poem":1},{"text":"kipya na chenye makali, chenye meno mengi.","poem":2},{"text":"Utaipura milima na kuiponda","poem":1},{"text":"na kuvifanya vilima kuwa kama makapi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Utaipepeta, nao upepo utaichukua,","poem":1},{"text":"dhoruba itaipeperushia mbali.","poem":2},{"text":"Bali wewe utajifurahisha katika Bwana","poem":1},{"text":"na katika utukufu wa yeye Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Maskini na wahitaji wanatafuta maji,","poem":1},{"text":"lakini hayapo,","poem":2},{"lineBreak":true},{"text":"ndimi zao zimekauka kwa kiu.","poem":2},{"text":"Lakini Mimi Bwana nitawajibu,","poem":1},{"text":"Mimi, Mungu wa Israeli, sitawaacha.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nitaifanya mito itiririke juu ya vilima vilivyo kame,","poem":1},{"text":"nazo chemchemi ndani ya mabonde.","poem":2},{"text":"Nitaligeuza jangwa liwe mabwawa ya maji,","poem":1},{"text":"nayo ardhi iliyokauka kuwa chemchemi za maji.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Katika jangwa nitaotesha","poem":1},{"text":"mwerezi, mshita, mhadasi na mzeituni.","poem":2},{"text":"Nitaweka misunobari, mivinje na misanduku","poem":1},{"text":"pamoja huko nyikani,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ili kwamba watu wapate kuona na kujua,","poem":1},{"text":"wapate kufikiri na kuelewa,","poem":2},{"text":"kwamba mkono wa Bwana umetenda hili,","poem":1},{"text":"kwamba yeye Aliye Mtakatifu wa Israeli ndiye alilifanya.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Bwana asema, “Leta shauri lako.","poem":1},{"text":"Toa hoja yako,” asema Mfalme wa Yakobo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“Leteni sanamu zenu zituambie","poem":1},{"text":"ni nini kitakachotokea.","poem":2},{"text":"Tuambieni mambo ya zamani yalikuwa nini,","poem":1},{"text":"ili tupate kuyatafakari","poem":2},{"lineBreak":true},{"text":"na kujua matokeo yake ya mwisho.","poem":2},{"text":"Au tutangazieni mambo yatakayokuja,","poem":1}]},{"type":"verse","number":23,"content":[{"text":"tuambieni ni nini kitakachotokea baadaye,","poem":2},{"lineBreak":true},{"text":"ili tupate kujua kuwa ninyi ni miungu.","poem":2},{"text":"Fanyeni jambo lolote zuri au baya,","poem":1},{"text":"ili tupate kutishika na kujazwa na hofu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lakini ninyi ni zaidi ya bure kabisa,","poem":1},{"text":"na kazi zenu hazifai kitu kabisa;","poem":2},{"lineBreak":true},{"text":"yeye awachaguaye ni chukizo sana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Nimemchochea mtu mmoja kutoka kaskazini,","poem":1},{"text":"naye yuaja, mmoja toka mawio ya jua aliitaye Jina langu.","poem":2},{"text":"Huwakanyaga watawala kana kwamba ni matope,","poem":1},{"text":"kama mfinyanzi akanyagavyo udongo wa kufinyangia.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Ni nani aliyenena hili tokea mwanzoni, ili tupate kujua,","poem":1},{"text":"au kabla, ili tuweze kusema, ‘Alikuwa sawa’?","poem":2},{"text":"Hakuna aliyenena hili,","poem":1},{"text":"hakuna aliyetangulia kusema hili,","poem":2},{"lineBreak":true},{"text":"hakuna yeyote aliyesikia maneno kutoka kwenu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nilikuwa wa kwanza kumwambia Sayuni,","poem":1},{"text":"‘Tazama, wako hapa!’","poem":2},{"lineBreak":true},{"text":"Nilimpa Yerusalemu mjumbe wa habari njema.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ninatazama, lakini hakuna yeyote:","poem":1},{"text":"hakuna yeyote miongoni mwao awezaye kutoa shauri,","poem":2},{"lineBreak":true},{"text":"hakuna yeyote wa kutoa jibu wakati ninapowauliza.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tazama, wote ni ubatili!","poem":1},{"text":"Matendo yao ni bure;","poem":2},{"lineBreak":true},{"text":"vinyago vyao ni upepo mtupu na machafuko.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}