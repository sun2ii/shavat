{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["Mtumishi Wa Bwana"]},{"type":"verse","number":1,"content":[{"text":"“Huyu hapa mtumishi wangu, ninayemtegemeza,","poem":1},{"text":"mteule wangu, ambaye ninapendezwa naye;","poem":2},{"text":"nitaweka Roho yangu juu yake,","poem":1},{"text":"naye ataleta haki kwa mataifa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hatapaza sauti wala kupiga kelele,","poem":1},{"text":"wala hataiinua sauti yake barabarani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwanzi uliopondeka hatauvunja,","poem":1},{"text":"na utambi unaofuka moshi hatauzima.","poem":2},{"text":"Kwa uaminifu ataleta haki,","poem":1}]},{"type":"verse","number":4,"content":[{"text":"hatazimia roho wala kukata tamaa,","poem":2},{"text":"mpaka atakaposimamisha haki juu ya dunia.","poem":1},{"text":"Visiwa vitaweka tumaini lao katika sheria yake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hili ndilo asemalo Mungu, Bwana,","poem":1},{"text":"yeye aliyeziumba mbingu na kuzitanda,","poem":2},{"text":"aliyeitandaza dunia na vyote vitokavyo humo,","poem":1},{"text":"awapaye watu wake pumzi,","poem":2},{"lineBreak":true},{"text":"na uzima kwa wale waendao humo:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Mimi, Bwana, nimekuita katika haki;","poem":1},{"text":"nitakushika mkono wako.","poem":2},{"text":"Nitakulinda na kukufanya","poem":1},{"text":"kuwa Agano kwa ajili ya watu","poem":2},{"lineBreak":true},{"text":"na nuru kwa Mataifa,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kuwafungua macho wale wasioona,","poem":1},{"text":"kuwaacha huru kutoka kifungoni waliofungwa jela,","poem":2},{"text":"na kuwafungua kutoka gerezani","poem":1},{"text":"wale wanaokaa gizani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Mimi ndimi Bwana; hilo ndilo Jina langu!","poem":1},{"text":"Sitampa mwingine utukufu wangu","poem":2},{"lineBreak":true},{"text":"wala sanamu sifa zangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tazama, mambo ya kwanza yametokea,","poem":1},{"text":"nami natangaza mambo mapya;","poem":2},{"text":"kabla hayajatokea","poem":1},{"text":"nawatangazia habari zake.”","poem":2}]},{"type":"heading","content":["Wimbo Wa Kumsifu Bwana"]},{"type":"verse","number":10,"content":[{"text":"Mwimbieni Bwana wimbo mpya,","poem":1},{"text":"sifa zake toka miisho ya dunia,","poem":2},{"text":"ninyi mshukao chini baharini,","poem":1},{"text":"na vyote vilivyomo ndani yake,","poem":2},{"lineBreak":true},{"text":"enyi visiwa na wote wakaao ndani yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jangwa na miji yake na vipaze sauti zao;","poem":1},{"text":"makao anamoishi Kedari na yashangilie.","poem":2},{"text":"Watu wa Sela waimbe kwa furaha,","poem":1},{"text":"na wapige kelele kutoka vilele vya milima.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wampe Bwana utukufu,","poem":1},{"text":"na kutangaza sifa zake katika visiwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bwana ataenda kama mtu mwenye nguvu,","poem":1},{"text":"kama shujaa atachochea shauku yake,","poem":2},{"text":"kwa kelele ataamsha kilio cha vita,","poem":1},{"text":"naye atashinda adui zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Kwa muda mrefu nimenyamaza kimya,","poem":1},{"text":"nimekaa kimya na kujizuia.","poem":2},{"text":"Lakini sasa, kama mwanamke wakati wa kujifungua,","poem":1},{"text":"ninapiga kelele, ninatweta na kushusha pumzi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitaharibu milima na vilima","poem":1},{"text":"na kukausha mimea yako yote;","poem":2},{"text":"nitafanya mito kuwa visiwa","poem":1},{"text":"na kukausha mabwawa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nitawaongoza vipofu kwenye njia ambayo hawajaijua,","poem":1},{"text":"kwenye mapito wasiyoyazoea nitawaongoza;","poem":2},{"text":"nitafanya giza kuwa nuru mbele yao,","poem":1},{"text":"na kufanya mahali palipoparuza kuwa laini.","poem":2},{"text":"Haya ndiyo mambo nitakayofanya;","poem":1},{"text":"mimi sitawaacha.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lakini wale wanaotumaini sanamu,","poem":1},{"text":"wanaoviambia vinyago, ‘Ninyi ndio miungu yetu,’","poem":2},{"lineBreak":true},{"text":"watarudishwa nyuma kwa aibu kubwa.","poem":2}]},{"type":"heading","content":["Israeli Kipofu Na Kiziwi"]},{"type":"verse","number":18,"content":[{"text":"“Sikieni, enyi viziwi;","poem":1},{"text":"tazameni, enyi vipofu, mpate kuona!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ni nani aliye kipofu isipokuwa mtumishi wangu,","poem":1},{"text":"na kiziwi kama mjumbe ninayemtuma?","poem":2},{"text":"Ni nani aliye kipofu kama yeye aliyejitoa kwangu,","poem":1},{"text":"aliye kipofu kama mtumishi wa Bwana?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mmeona vitu vingi, lakini hamkuzingatia;","poem":1},{"text":"masikio yenu yako wazi, lakini hamsikii chochote.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ilimpendeza Bwana","poem":1},{"text":"kwa ajili ya haki yake","poem":2},{"lineBreak":true},{"text":"kufanya sheria yake kuwa kuu na tukufu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lakini hili ni taifa lililoibwa na kutekwa nyara,","poem":1},{"text":"wote wamenaswa katika mashimo,","poem":2},{"lineBreak":true},{"text":"au wamefichwa katika magereza.","poem":2},{"text":"Wamekuwa nyara,","poem":1},{"text":"wala hapana yeyote awaokoaye.","poem":2},{"text":"Wamefanywa mateka,","poem":1},{"text":"wala hapana yeyote asemaye, “Warudishe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ni nani miongoni mwenu atakayesikiliza hili,","poem":1},{"text":"au atakayezingatia kwa makini katika wakati ujao?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ni nani aliyemtoa Yakobo kuwa mateka,","poem":1},{"text":"na Israeli kwa wateka nyara?","poem":2},{"text":"Je, hakuwa yeye, Bwana,","poem":1},{"text":"ambaye tumetenda dhambi dhidi yake?","poem":2},{"text":"Kwa kuwa hawakufuata njia zake,","poem":1},{"text":"hawakutii sheria zake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hivyo akawamwagia hasira yake inayowaka,","poem":1},{"text":"ukali wa vita.","poem":2},{"text":"Iliwazunguka kwa miali ya moto, lakini hata hivyo hawakuelewa;","poem":1},{"text":"iliwateketeza, lakini hawakuyatia moyoni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}