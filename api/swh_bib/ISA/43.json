{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["Mwokozi Pekee Wa Israeli"]},{"type":"verse","number":1,"content":[{"text":"Lakini sasa hili ndilo asemalo Bwana,","poem":1},{"text":"yeye aliyekuumba, ee Yakobo,","poem":2},{"lineBreak":true},{"text":"yeye aliyekuhuluku, ee Israeli:","poem":2},{"text":"“Usiogope kwa maana nimekukomboa,","poem":1},{"text":"nimekuita wewe kwa jina lako, wewe u wangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unapopita kwenye maji makuu,","poem":1},{"text":"nitakuwa pamoja nawe,","poem":2},{"text":"unapopita katika mito ya maji,","poem":1},{"text":"hayatakugharikisha.","poem":2},{"text":"Utakapopita katika moto,","poem":1},{"text":"hutaungua,","poem":2},{"lineBreak":true},{"text":"miali ya moto haitakuunguza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa Mimi ndimi Bwana, Mungu wako,","poem":1},{"text":"yeye Aliye Mtakatifu wa Israeli, Mwokozi wako.","poem":2},{"text":"Ninaitoa Misri kuwa fidia yako,","poem":1},{"text":"Kushi na Seba badala yako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa kuwa wewe ni wa thamani na wa kuheshimiwa machoni pangu,","poem":1},{"text":"nami kwa kuwa ninakupenda,","poem":2},{"text":"nitatoa watu badala yako","poem":1},{"text":"na mataifa badala ya maisha yako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Usiogope, kwa kuwa mimi nipo pamoja nawe,","poem":1},{"text":"nitawaleta watoto wako kutoka mashariki,","poem":2},{"lineBreak":true},{"text":"na kukukusanya kutoka magharibi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nitaiambia kaskazini, ‘Watoe!’","poem":1},{"text":"nayo kusini, ‘Usiwazuie.’","poem":2},{"text":"Walete wana wangu kutoka mbali,","poem":1},{"text":"na binti zangu kutoka miisho ya dunia:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kila mmoja ambaye ameitwa kwa Jina langu,","poem":1},{"text":"niliyemuumba kwa utukufu wangu,","poem":2},{"lineBreak":true},{"text":"niliyemhuluku na kumfanya.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uwaongoze wale wenye macho lakini hawaoni,","poem":1},{"text":"wenye masikio lakini hawasikii.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mataifa yote yanakutanika pamoja,","poem":1},{"text":"na makabila yanakusanyika.","poem":2},{"text":"Ni nani miongoni mwao aliyetangulia kutuambia haya,","poem":1},{"text":"na kututangazia mambo yaliyopita?","poem":2},{"text":"Walete mashahidi wao ili kuwathibitisha kuwa walikuwa sahihi,","poem":1},{"text":"ili wengine waweze kusikia, waseme, “Ni kweli.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Ninyi ni mashahidi wangu,” asema Bwana,","poem":1},{"text":"“na mtumishi wangu niliyemchagua,","poem":2},{"text":"ili mpate kunijua na kuniamini,","poem":1},{"text":"na kutambua kwamba Mimi ndiye.","poem":2},{"text":"Kabla yangu hakuna mungu aliyefanyizwa,","poem":1},{"text":"wala hatakuwepo mwingine baada yangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mimi, naam mimi, ndimi Bwana,","poem":1},{"text":"zaidi yangu hakuna mwokozi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nimedhihirisha, kuokoa na kutangaza:","poem":1},{"text":"Mimi, wala si mungu mgeni katikati yenu.","poem":2},{"text":"Ninyi ni mashahidi wangu,” asema Bwana,","poem":1},{"text":"“kwamba Mimi ndimi Mungu.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Naam, tangu siku za kale, Mimi ndiye.","poem":2},{"text":"Hakuna hata mmoja awezaye kuokoa","poem":1},{"text":"kutoka mkononi wangu.","poem":2},{"text":"Mimi ninapotenda,","poem":1},{"text":"ni nani awezaye kutangua?”","poem":2}]},{"type":"heading","content":["Huruma Za Mungu, Na Kukosa Uaminifu Kwa Israeli"]},{"type":"verse","number":14,"content":[{"text":"Hili ndilo Bwana asemalo,","poem":1},{"text":"Mkombozi wako, yeye Aliye Mtakatifu wa Israeli:","poem":2},{"text":"“Kwa ajili yenu nitatumana Babeli","poem":1},{"text":"na kuwaleta Wakaldayo wote kama wakimbizi,","poem":2},{"lineBreak":true},{"text":"katika meli walizozionea fahari.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mimi ndimi Bwana, yeye Aliye Mtakatifu wako,","poem":1},{"text":"Muumba wa Israeli, Mfalme wako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Hili ndilo asemalo Bwana,","poem":1},{"text":"yeye aliyefanya njia baharini,","poem":2},{"lineBreak":true},{"text":"mahali pa kupita kwenye maji mengi,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"aliyeyakokota magari ya vita na farasi,","poem":1},{"text":"jeshi pamoja na askari wa msaada,","poem":2},{"text":"nao wakalala huko, wala hawatainuka tena kamwe,","poem":1},{"text":"wakakomeshwa, na wakazimika kama utambi:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“Msiyakumbuke mambo yaliyopita,","poem":1},{"text":"wala msiyatafakari mambo ya zamani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tazama, nitafanya jambo jipya!","poem":1},{"text":"Sasa litachipuka, je, hamtalitambua?","poem":2},{"text":"Nitafanya njia jangwani","poem":1},{"text":"na vijito vya maji katika nchi kame.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wanyama wa mwituni wataniheshimu,","poem":1},{"text":"mbweha na bundi,","poem":2},{"text":"kwa sababu ninawapatia maji jangwani,","poem":1},{"text":"na vijito katika nchi kame,","poem":2},{"text":"ili kuwapa watu wangu maji, wale niliowachagua,","poem":1}]},{"type":"verse","number":21,"content":[{"text":"watu wale niliowaumba kwa ajili yangu,","poem":2},{"lineBreak":true},{"text":"ili wapate kutangaza sifa zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Hata hivyo hukuniita mimi, ee Yakobo,","poem":1},{"text":"hujajitaabisha kwa ajili yangu, ee Israeli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hujaniletea kondoo kwa ajili ya sadaka za kuteketezwa,","poem":1},{"text":"wala kuniheshimu kwa dhabihu zako.","poem":2},{"text":"Sikukulemea kwa sadaka za nafaka","poem":1},{"text":"wala kukuchosha kwa kuhitaji uvumba.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hukuninunulia uvumba wowote wenye manukato,","poem":1},{"text":"wala hukunipa kwa ukarimu","poem":2},{"lineBreak":true},{"text":"mafuta ya wanyama wa dhabihu zako.","poem":2},{"text":"Lakini umenilemea kwa dhambi zako,","poem":1},{"text":"na kunitaabisha kwa makosa yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Mimi, naam mimi, ndimi nizifutaye dhambi zako,","poem":1},{"text":"kwa ajili yangu mwenyewe,","poem":2},{"lineBreak":true},{"text":"wala sizikumbuki dhambi zako tena.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tafakari mambo yaliyopita,","poem":1},{"text":"njoo na tuhojiane,","poem":2},{"lineBreak":true},{"text":"leta shauri lako uweze kupewa haki yako.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Baba yako wa kwanza alitenda dhambi,","poem":1},{"text":"wasemaji wako wameasi dhidi yangu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kwa hiyo nitawaaibisha wakuu wa Hekalu lako,","poem":1},{"text":"nami nitamtoa Yakobo aangamizwe,","poem":2},{"lineBreak":true},{"text":"na Israeli adhihakiwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}