{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["Miungu Ya Babeli"]},{"type":"verse","number":1,"content":[{"text":"Beli anasujudu hadi nchi, Nebo anainama;","poem":1},{"text":"sanamu zao zabebwa na wanyama wa mizigo.","poem":2},{"text":"Vinyago hivi mnavyobeba kila mahali ni mzigo wa kulemea,","poem":1},{"text":"mzigo kwa waliochoka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Vinyago pamoja na wale wanaovibeba wanainama chini;","poem":1},{"text":"hiyo miungu haiwezi kuwaokoa watu,","poem":2},{"lineBreak":true},{"text":"wote wanakwenda utumwani pamoja.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Nisikilizeni mimi, ee nyumba ya Yakobo,","poem":1},{"text":"ninyi nyote mliobaki wa nyumba ya Israeli,","poem":2},{"text":"ninyi ambao nimewategemeza tangu mlipotungwa mimba,","poem":1},{"text":"nami nimewabeba tangu kuzaliwa kwenu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hata mpaka wakati wa uzee wenu na mvi, Mimi ndiye,","poem":1},{"text":"Mimi ndiye nitakayewasaidia ninyi.","poem":2},{"text":"Nimewahuluku, nami nitawabeba,","poem":1},{"text":"nitawasaidia ninyi na kuwaokoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mtanilinganisha na nani, au mtanihesabu kuwa sawa na nani?","poem":1},{"text":"Ni nani mtakayenifananisha naye ili tuweze kulinganishwa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wengine humwaga dhahabu kutoka kwenye mifuko yao,","poem":1},{"text":"na kupima fedha kwenye mizani;","poem":2},{"text":"huajiri mfua dhahabu kutengeneza mungu,","poem":1},{"text":"kisha huisujudia na kuiabudu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Huiinua mabegani na kuichukua;","poem":1},{"text":"huiweka mahali pake, papo hapo ndipo isimamapo.","poem":2},{"lineBreak":true},{"text":"Wala haiwezi kusogea kutoka mahali pale.","poem":2},{"text":"Ingawa mtu huililia, haimjibu;","poem":1},{"text":"haiwezi kumwokoa kwenye taabu zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kumbukeni hili, litieni akilini,","poem":1},{"text":"liwekeni moyoni, enyi waasi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kumbukeni mambo yaliyopita, yale ya zamani za kale;","poem":1},{"text":"mimi ndimi Mungu, wala hakuna mwingine;","poem":2},{"text":"mimi ndimi Mungu,","poem":1},{"text":"wala hakuna mwingine aliye kama mimi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ni mimi nitangazaye mwisho tangu mwanzo,","poem":1},{"text":"naam, tangu zamani za kale,","poem":2},{"lineBreak":true},{"text":"mambo ambayo hayajatendeka.","poem":2},{"text":"Ninasema: Kusudi langu ndilo litakalosimama,","poem":1},{"text":"nami nitatenda mapenzi yangu yote.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kutoka mashariki ninaita ndege awindaye;","poem":1},{"text":"kutoka nchi ya mbali,","poem":2},{"lineBreak":true},{"text":"mtu atakayetimiza kusudi langu.","poem":2},{"text":"Lile ambalo nimelisema, ndilo nitakalolitimiza;","poem":1},{"text":"lile nililolipanga, ndilo nitakalolitenda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nisikilizeni, ninyi wenye mioyo migumu,","poem":1},{"text":"ninyi mlio mbali na haki.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ninaleta haki yangu karibu,","poem":1},{"text":"haiko mbali;","poem":2},{"lineBreak":true},{"text":"wala wokovu wangu hautachelewa.","poem":2},{"text":"Nitawapa Sayuni wokovu,","poem":1},{"text":"Israeli utukufu wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}