{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["Mtumishi Wa Bwana"]},{"type":"verse","number":1,"content":[{"text":"Nisikilizeni, enyi visiwa, sikieni hili,","poem":1},{"text":"ninyi mataifa mlio mbali:","poem":2},{"text":"Kabla sijazaliwa, Bwana aliniita,","poem":1},{"text":"tangu kuzaliwa kwangu, amelitaja jina langu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akafanya kinywa changu kuwa kama upanga ulionolewa,","poem":1},{"text":"katika uvuli wa mkono wake akanificha;","poem":2},{"text":"akanifanya kuwa mshale uliosuguliwa,","poem":1},{"text":"na kunificha katika podo lake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akaniambia, “Wewe u mtumishi wangu,","poem":1},{"text":"Israeli, ambaye katika yeye","poem":2},{"lineBreak":true},{"text":"nitaonyesha utukufu wangu.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini nilisema, “Nimetumika bure,","poem":1},{"text":"nimetumia nguvu zangu bure bila faida.","poem":2},{"text":"Hata hivyo linalonistahili liko mkononi mwa Bwana,","poem":1},{"text":"nao ujira wangu uko kwa Mungu wangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Sasa Bwana asema:","poem":1},{"text":"yeye aliyeniumba tumboni kuwa mtumishi wake,","poem":2},{"text":"kumrudisha tena Yakobo kwake","poem":1},{"text":"na kumkusanyia Israeli,","poem":2},{"text":"kwa maana nimepata heshima machoni pa Bwana,","poem":1},{"text":"naye Mungu wangu amekuwa nguvu yangu;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"yeye asema:","poem":1},{"lineBreak":true},{"text":"“Je, ni jambo dogo sana wewe kuwa mtumishi wangu","poem":1},{"text":"ili kurejeza makabila ya Yakobo,","poem":2},{"lineBreak":true},{"text":"na kuwarudisha wale Waisraeli niliowahifadhi?","poem":2},{"text":"Pia nitakufanya uwe nuru kwa ajili ya watu wa Mataifa,","poem":1},{"text":"ili upate kuleta wokovu wangu hata miisho ya dunia.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hili ndilo asemalo Bwana,","poem":1},{"text":"yeye Mkombozi na Aliye Mtakatifu wa Israeli,","poem":2},{"text":"kwake yeye aliyedharauliwa na kuchukiwa na taifa,","poem":1},{"text":"kwa mtumishi wa watawala:","poem":2},{"text":"“Wafalme watakuona na kusimama,","poem":1},{"text":"wakuu wataona na kuanguka kifudifudi,","poem":2},{"text":"kwa sababu ya Bwana, aliye mwaminifu,","poem":1},{"text":"yeye Aliye Mtakatifu wa Israeli, aliyekuchagua wewe.”","poem":2}]},{"type":"heading","content":["Kurejezwa Kwa Israeli"]},{"type":"verse","number":8,"content":["Hili ndilo asemalo Bwana:",{"text":"“Wakati wangu uliokubalika nitakujibu,","poem":1},{"text":"nami katika siku ya wokovu nitakusaidia;","poem":2},{"text":"nitakuhifadhi, nami nitakufanya","poem":1},{"text":"kuwa agano kwa ajili ya watu,","poem":2},{"text":"ili kurudisha nchi","poem":1},{"text":"na kugawanyia urithi tena wale waliokuwa ukiwa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kuwaambia mateka, ‘Tokeni nje,’","poem":1},{"text":"nao wale walio gizani, ‘Kuweni huru!’","poem":2},{"lineBreak":true},{"text":"“Watajilisha kando ya barabara","poem":1},{"text":"na kupata malisho yao juu ya kila kilima kilicho kitupu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hawataona njaa wala kuona kiu,","poem":1},{"text":"wala hari ya jangwani au jua halitawapiga.","poem":2},{"text":"Yeye mwenye huruma juu yao atawaonyesha njia,","poem":1},{"text":"na kuwaongoza kando ya chemchemi za maji.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nitaifanya milima yangu yote kuwa barabara,","poem":1},{"text":"na njia kuu zangu zitainuliwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tazama, watakuja kutoka mbali:","poem":1},{"text":"wengine kutoka kaskazini, wengine kutoka magharibi,","poem":2},{"lineBreak":true},{"text":"wengine kutoka nchi ya Sinimu.”","poem":2},{"noteId":31}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Pigeni kelele kwa furaha, enyi mbingu;","poem":1},{"text":"furahi, ee dunia;","poem":2},{"lineBreak":true},{"text":"pazeni sauti kwa kuimba, enyi milima!","poem":2},{"text":"Kwa maana Bwana anawafariji watu wake,","poem":1},{"text":"naye atakuwa na huruma kwa watu wake walioumizwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lakini Sayuni alisema, “Bwana ameniacha,","poem":1},{"text":"Bwana amenisahau.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Je, mama aweza kumsahau mtoto","poem":1},{"text":"aliyeko matitini mwake akinyonya,","poem":2},{"text":"wala asiwe na huruma","poem":1},{"text":"juu ya mtoto aliyemzaa?","poem":2},{"text":"Ingawa anaweza kusahau,","poem":1},{"text":"mimi sitakusahau wewe!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tazama, nimekuchora kama muhuri","poem":1},{"text":"katika vitanga vya mikono yangu,","poem":2},{"lineBreak":true},{"text":"kuta zako zi mbele yangu daima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wana wako wanaharakisha kurudi,","poem":1},{"text":"nao wale waliokuteka wanaondoka kwako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Inua macho yako ukatazame pande zote:","poem":1},{"text":"wana wako wote wanakusanyika na kukujia.","poem":2},{"text":"Kwa hakika kama vile niishivyo,","poem":1},{"text":"utawavaa wote kama mapambo,","poem":2},{"text":"na kujifunga nao kama bibi arusi,”","poem":1},{"text":"asema Bwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Ingawa uliangamizwa na kufanywa ukiwa,","poem":1},{"text":"na nchi yako ikaharibiwa,","poem":2},{"text":"sasa nafasi itakuwa finyu kwa ajili ya watu wako,","poem":1},{"text":"nao wale waliokuangamiza watakuwa mbali sana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Watoto waliozaliwa wakati wa msiba wako","poem":1},{"text":"bado watakuambia,","poem":2},{"text":"‘Mahali hapa ni finyu sana kwetu,","poem":1},{"text":"tupe eneo kubwa zaidi la kuishi.’","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndipo utasema moyoni mwako,","poem":1},{"text":"‘Ni nani aliyenizalia hawa?","poem":2},{"text":"Nilikuwa nimefiwa, tena tasa;","poem":1},{"text":"nilikuwa nimehamishwa na kukataliwa.","poem":2},{"lineBreak":true},{"text":"Ni nani aliyewalea hawa?","poem":2},{"text":"Niliachwa peke yangu,","poem":1},{"text":"lakini hawa wametoka wapi?’ ”","poem":2}]},{"type":"verse","number":22,"content":["Hili ndilo asemalo Bwana Mwenyezi:",{"text":"“Tazama, nitawaashiria watu wa Mataifa,","poem":1},{"text":"nitainua bendera yangu kwa mataifa;","poem":2},{"text":"watawaleta wana wako mikononi yao,","poem":1},{"text":"na kuwabeba binti zenu juu ya mabega yao.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wafalme watakuwa baba zenu wa kuwalea,","poem":1},{"text":"na malkia wao watakuwa mama zenu wa kuwalea.","poem":2},{"text":"Watasujudu mbele yako nyuso zao zikigusa ardhi;","poem":1},{"text":"wataramba mavumbi yaliyo miguuni mwako.","poem":2},{"text":"Ndipo utajua ya kuwa Mimi ndimi Bwana;","poem":1},{"text":"wale wanaonitumaini mimi hawataaibika.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Je, nyara zaweza kuchukuliwa kutoka kwa mashujaa wa vita,","poem":1},{"text":"au mateka kuokolewa kutoka kwa watu wakali?","poem":2}]},{"type":"verse","number":25,"content":["Lakini hili ndilo asemalo Bwana:",{"text":"“Naam, mateka watachukuliwa kutoka kwa mashujaa,","poem":1},{"text":"na nyara zitapokonywa kutoka kwa watu wakali.","poem":2},{"text":"Nitashindana na wale wanaoshindana nawe,","poem":1},{"text":"nami nitawaokoa watoto wako.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nitawafanya wale wanaokuonea kula nyama yao wenyewe,","poem":1},{"text":"watalewa kwa damu yao wenyewe,","poem":2},{"lineBreak":true},{"text":"kama vile kwa mvinyo.","poem":2},{"text":"Ndipo wanadamu wote watajua","poem":1},{"text":"ya kuwa Mimi, Bwana, ni Mwokozi wako,","poem":2},{"lineBreak":true},{"text":"Mkombozi wako, niliye Mwenye Nguvu wa Yakobo.”","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Sinimu hapa ina maana ya Aswani.","reference":{"chapter":49,"verse":12}}]},"thisChapterLink":"/api/swh_bib/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}