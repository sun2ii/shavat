{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["Dhambi Ya Israeli Na Utii Wa Mtumishi"]},{"type":"verse","number":1,"content":["Hili ndilo asemalo Bwana:",{"text":"“Iko wapi hati ya talaka ya mama yako","poem":1},{"text":"ambayo kwayo niliachana naye?","poem":2},{"text":"Au nimewauza ninyi kwa nani","poem":1},{"text":"miongoni mwa watu wanaonidai?","poem":2},{"text":"Kwa ajili ya dhambi zenu mliuzwa,","poem":1},{"text":"kwa sababu ya makosa, mama yenu aliachwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nilipokuja, kwa nini hakuwepo hata mmoja?","poem":1},{"text":"Nilipoita, kwa nini hakuwepo hata mmoja wa kujibu?","poem":2},{"text":"Je, mkono wangu ni mfupi mno hata nisiweze kuwakomboa?","poem":1},{"text":"Je, mimi sina nguvu za kukuokoa?","poem":2},{"text":"Kwa kukemea tu naikausha bahari,","poem":1},{"text":"naigeuza mito ya maji kuwa jangwa;","poem":2},{"text":"samaki wake wanaoza kwa kukosa maji","poem":1},{"text":"na kufa kwa ajili ya kiu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ninalivika anga weusi na kufanya nguo ya gunia","poem":1},{"text":"kuwa kifuniko chake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bwana Mwenyezi amenipa ulimi uliofundishwa,","poem":1},{"text":"ili kujua neno limtegemezalo aliyechoka.","poem":2},{"text":"Huniamsha asubuhi kwa asubuhi,","poem":1},{"text":"huamsha sikio langu lisikie kama mtu afundishwaye.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwana Mwenyezi amezibua masikio yangu,","poem":1},{"text":"nami sikuwa mwasi,","poem":2},{"lineBreak":true},{"text":"wala sikurudi nyuma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Niliwapa mgongo wangu wale wanipigao,","poem":1},{"text":"mashavu yangu wale wangʼoao ndevu zangu;","poem":2},{"text":"sikuuficha uso wangu kutokana na fedheha","poem":1},{"text":"na kutemewa mate.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa sababu Bwana Mwenyezi ananisaidia,","poem":1},{"text":"sitatahayarika.","poem":2},{"text":"Kwa hiyo nimekaza uso wangu kama jiwe la gumegume,","poem":1},{"text":"nami ninajua sitaaibika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeye anipatiaye haki yangu yu karibu.","poem":1},{"lineBreak":true},{"text":"Ni nani basi atakayeleta mashtaka dhidi yangu?","poem":1},{"text":"Tukabiliane uso kwa uso!","poem":2},{"text":"Mshtaki wangu ni nani?","poem":1},{"text":"Ni nani aliye mshtaki wangu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ni Bwana Mwenyezi anisaidiaye mimi.","poem":1},{"text":"Ni nani huyo atakayenihukumu?","poem":2},{"text":"Wote watachakaa kama vazi,","poem":1},{"text":"nondo watawala wawamalize.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ni nani miongoni mwenu amchaye Bwana,","poem":1},{"text":"na kulitii neno la mtumishi wake?","poem":2},{"text":"Yeye atembeaye gizani,","poem":1},{"text":"yeye asiye na nuru,","poem":2},{"text":"na alitumainie jina la Bwana,","poem":1},{"text":"na amtegemee Mungu wake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lakini sasa, ninyi nyote mnaowasha mioto,","poem":1},{"text":"na kupeana mienge iwakayo ninyi kwa ninyi,","poem":2},{"text":"nendeni, tembeeni katika nuru ya moto wenu","poem":1},{"text":"na ya mienge mliyoiwasha.","poem":2},{"text":"Hili ndilo mtakalolipokea kutoka mkononi mwangu:","poem":1},{"text":"Mtalala chini kwa mateso makali.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}