{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"Amka, amka, ee Sayuni,","poem":1},{"text":"jivike nguvu.","poem":2},{"text":"Vaa mavazi yako ya fahari,","poem":1},{"text":"ee Yerusalemu, mji mtakatifu.","poem":2},{"text":"Asiyetahiriwa na aliye najisi","poem":1},{"text":"hataingia kwako tena.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jikungʼute mavumbi yako,","poem":1},{"text":"inuka, uketi kwenye kiti cha enzi, ee Yerusalemu.","poem":2},{"text":"Jifungue minyororo iliyo shingoni mwako,","poem":1},{"text":"ee Binti Sayuni uliye mateka.","poem":2}]},{"type":"verse","number":3,"content":["Kwa kuwa hili ndilo asemalo Bwana:",{"text":"“Mliuzwa pasipo malipo,","poem":1},{"text":"nanyi mtakombolewa bila fedha.”","poem":2}]},{"type":"verse","number":4,"content":["Kwa maana hili ndilo asemalo Bwana Mwenyezi:",{"text":"“Hapo kwanza watu wangu walishuka Misri kuishi,","poem":1},{"text":"hatimaye, Ashuru wakawaonea.","poem":2}]},{"type":"verse","number":5,"content":["“Basi sasa nina nini hapa?” asema Bwana.",{"text":"“Kwa kuwa watu wangu wamechukuliwa pasipo malipo,","poem":1},{"text":"nao wale wanaowatawala wanawadhihaki,”","poem":2},{"text":"asema Bwana.","poem":4},{"text":"“Mchana kutwa","poem":1},{"text":"jina langu limetukanwa bila kikomo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa hiyo watu wangu watalijua Jina langu;","poem":1},{"text":"kwa hiyo katika siku ile watajua","poem":2},{"text":"kwamba ndimi niliyetangulia kulisema.","poem":1},{"text":"Naam, ni mimi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tazama jinsi miguu ya wale waletao habari njema","poem":1},{"text":"ilivyo mizuri juu ya milima,","poem":2},{"text":"wale wanaotangaza amani,","poem":1},{"text":"wanaoleta habari njema,","poem":2},{"lineBreak":true},{"text":"wanaotangaza wokovu,","poem":2},{"text":"wauambiao Sayuni,","poem":1},{"text":"“Mungu wako anatawala!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sikiliza! Walinzi wako wanapaza sauti zao,","poem":1},{"text":"pamoja wanapaza sauti zao kwa furaha.","poem":2},{"text":"Wakati Bwana atakaporejea Sayuni,","poem":1},{"text":"wataliona kwa macho yao wenyewe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pazeni sauti ya nyimbo za furaha pamoja,","poem":1},{"text":"enyi magofu ya Yerusalemu,","poem":2},{"text":"kwa maana Bwana amewafariji watu wake,","poem":1},{"text":"ameikomboa Yerusalemu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mkono mtakatifu wa Bwana umefunuliwa","poem":1},{"text":"machoni pa mataifa yote,","poem":2},{"text":"nayo miisho yote ya dunia itaona","poem":1},{"text":"wokovu wa Mungu wetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ondokeni, ondokeni, tokeni huko!","poem":1},{"text":"Msiguse kitu chochote kilicho najisi!","poem":2},{"text":"Tokeni kati yake mwe safi,","poem":1},{"text":"ninyi mchukuao vyombo vya Bwana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini hamtaondoka kwa haraka,","poem":1},{"text":"wala hamtakwenda kwa kukimbia;","poem":2},{"text":"kwa maana Bwana atatangulia mbele yenu,","poem":1},{"text":"Mungu wa Israeli atakuwa mlinzi nyuma yenu.","poem":2}]},{"type":"heading","content":["Mateso Na Utukufu Wa Mtumishi"]},{"type":"verse","number":13,"content":[{"text":"Tazama, mtumishi wangu atatenda kwa hekima;","poem":1},{"text":"atatukuzwa, na kuinuliwa juu, na kukwezwa sana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kama walivyokuwa wengi","poem":1},{"text":"walioshangazwa naye,","poem":2},{"text":"kwani uso wake ulikuwa umeharibiwa sana","poem":1},{"text":"zaidi ya mtu yeyote","poem":2},{"text":"na umbo lake kuharibiwa","poem":1},{"text":"zaidi ya mfano wa mwanadamu:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"hivyo atayashangaza mataifa mengi,","poem":1},{"text":"nao wafalme watafunga vinywa vyao kwa sababu yake.","poem":2},{"text":"Kwa kuwa yale ambayo hawakuambiwa, watayaona,","poem":1},{"text":"nayo yale wasiyoyasikia, watayafahamu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}