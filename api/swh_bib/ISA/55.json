{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["Mwaliko Kwa Wenye Kiu"]},{"type":"verse","number":1,"content":[{"text":"“Njooni, ninyi nyote wenye kiu,","poem":1},{"text":"njooni kwenye maji;","poem":2},{"text":"nanyi ambao hamna fedha,","poem":1},{"text":"njooni, nunueni na mle!","poem":2},{"text":"Njooni, nunueni divai na maziwa","poem":1},{"text":"bila fedha na bila gharama.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa nini kutumia fedha kwa kitu ambacho si chakula,","poem":1},{"text":"na kutaabikia kitu kisichoshibisha?","poem":2},{"text":"Sikilizeni, nisikilizeni mimi na mle kilicho kizuri,","poem":1},{"text":"nazo nafsi zenu zitafurahia utajiri wa unono.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tegeni sikio mje kwangu,","poem":1},{"text":"nisikieni mimi, ili nafsi zenu zipate kuishi.","poem":2},{"text":"Nitafanya agano la milele nanyi,","poem":1},{"text":"pendo la uaminifu nililomwahidi Daudi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tazama, nimemfanya kuwa shahidi wa mataifa,","poem":1},{"text":"kiongozi na jemadari wa mataifa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hakika utaita mataifa usiyoyajua,","poem":1},{"text":"nayo mataifa yale yasiyokujua yataharakisha kukujia,","poem":2},{"text":"kwa sababu ya Bwana Mungu wako,","poem":1},{"text":"yeye Aliye Mtakatifu wa Israeli,","poem":2},{"lineBreak":true},{"text":"kwa maana amekutukuza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mtafuteni Bwana maadamu anapatikana;","poem":1},{"text":"mwiteni maadamu yu karibu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mtu mwovu na aiache njia yake,","poem":1},{"text":"na mtu mbaya na ayaache mawazo yake.","poem":2},{"text":"Yeye na amrudie Bwana, naye atamrehemu,","poem":1},{"text":"arudi kwa Mungu wetu, kwa kuwa atamsamehe bure kabisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kwa kuwa mawazo yangu si mawazo yenu,","poem":1},{"text":"wala njia zenu si njia zangu,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":9,"content":[{"text":"“Kama vile mbingu zilivyo juu kuliko dunia,","poem":1},{"text":"ndivyo njia zangu zilivyo juu kuliko njia zenu","poem":2},{"lineBreak":true},{"text":"na mawazo yangu kuliko mawazo yenu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kama vile mvua na theluji","poem":1},{"text":"ishukavyo kutoka mbinguni,","poem":2},{"text":"nayo hairudi tena huko","poem":1},{"text":"bila kunywesha dunia","poem":2},{"text":"na kuichipusha na kuistawisha,","poem":1},{"text":"hivyo hutoa mbegu kwa mpanzi","poem":2},{"lineBreak":true},{"text":"na mkate kwa mlaji,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ndivyo lilivyo neno langu lile litokalo kinywani mwangu:","poem":1},{"text":"Halitanirudia tupu,","poem":2},{"text":"bali litatimiliza lile nililokusudia","poem":1},{"text":"na litafanikiwa katika kusudi lile nililolituma.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mtatoka nje kwa furaha","poem":1},{"text":"na kuongozwa kwa amani;","poem":2},{"text":"milima na vilima","poem":1},{"text":"vitapaza sauti kwa nyimbo mbele yenu,","poem":2},{"text":"nayo miti yote ya shambani","poem":1},{"text":"itapiga makofi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Badala ya kichaka cha miiba","poem":1},{"text":"itaota miti ya misunobari,","poem":2},{"text":"na badala ya michongoma","poem":1},{"text":"utaota mhadasi.","poem":2},{"noteId":32},{"text":"Hili litakuwa jambo la kumpatia Bwana jina,","poem":1},{"text":"kwa ajili ya ishara ya milele,","poem":2},{"lineBreak":true},{"text":"ambayo haitaharibiwa.”","poem":2}]}],"footnotes":[{"noteId":32,"caller":"+","text":"Mhadasi ni aina ya mti ambao huota milimani karibu na Yerusalemu, hutoa harufu nzuri itumikayo kutengeneza manukato; kwa Kiebrania ni “hadas”, na ilikuwa inatumika kujenga vibanda wakati wa Sikukuu ya Vibanda (ona pia Neh 8:15).","reference":{"chapter":55,"verse":13}}]},"thisChapterLink":"/api/swh_bib/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}