{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Wokovu Kwa Ajili Ya Wengine"]},{"type":"verse","number":1,"content":["Hili ndilo asemalo Bwana:",{"text":"“Dumisheni haki","poem":1},{"text":"na mkatende lile lililo sawa,","poem":2},{"text":"kwa maana wokovu wangu u karibu","poem":1},{"text":"na haki yangu itafunuliwa upesi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amebarikiwa mtu yule atendaye hili,","poem":1},{"text":"mtu yule alishikaye kwa uthabiti,","poem":2},{"text":"yeye ashikaye Sabato bila kuinajisi,","poem":1},{"text":"auzuiaye mkono wake usifanye uovu wowote.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Usimwache mgeni aambatanaye na Bwana aseme,","poem":1},{"text":"“Hakika Bwana atanitenga na watu wake.”","poem":2},{"text":"Usimwache towashi yeyote alalamike akisema,","poem":1},{"text":"“Mimi ni mti mkavu tu.”","poem":2}]},{"type":"verse","number":4,"content":["Kwa kuwa hili ndilo asemalo Bwana:",{"text":"“Kwa matowashi washikao Sabato zangu,","poem":1},{"text":"ambao huchagua kile kinachonipendeza","poem":2},{"lineBreak":true},{"text":"na kulishika sana agano langu:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"hao nitawapa ndani ya Hekalu langu na kuta zake","poem":1},{"text":"kumbukumbu na jina bora","poem":2},{"lineBreak":true},{"text":"kuliko kuwa na watoto wa kiume na wa kike:","poem":2},{"text":"nitawapa jina lidumulo milele,","poem":1},{"text":"ambalo halitakatiliwa mbali.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wageni wanaoambatana na Bwana","poem":1},{"text":"ili kumtumikia,","poem":2},{"text":"kulipenda jina la Bwana,","poem":1},{"text":"na kumwabudu yeye,","poem":2},{"text":"wote washikao Sabato bila kuinajisi","poem":1},{"text":"na ambao hushika sana agano langu:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"hawa nitawaleta kwenye mlima wangu mtakatifu","poem":1},{"text":"na kuwapa furaha ndani ya nyumba yangu ya sala.","poem":2},{"text":"Sadaka zao za kuteketeza na dhabihu zao","poem":1},{"text":"zitakubalika juu ya madhabahu yangu;","poem":2},{"text":"kwa maana nyumba yangu itaitwa","poem":1},{"text":"nyumba ya sala kwa mataifa yote.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bwana Mwenyezi asema, yeye awakusanyaye","poem":1},{"text":"Waisraeli waliohamishwa:","poem":2},{"text":"“Bado nitawakusanya wengine kwao","poem":1},{"text":"zaidi ya hao ambao wamekusanywa tayari.”","poem":2}]},{"type":"heading","content":["Mashtaka Ya Mungu Dhidi Ya Waovu"]},{"type":"verse","number":9,"content":[{"text":"Njooni, enyi wanyama wote wa kondeni,","poem":1},{"text":"njooni mle, ninyi wanyama wote wa mwituni!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Walinzi wa Israeli ni vipofu,","poem":1},{"text":"wote wamepungukiwa na maarifa;","poem":2},{"text":"wote ni mbwa walio bubu,","poem":1},{"text":"hawawezi kubweka;","poem":2},{"text":"hulala na kuota ndoto,","poem":1},{"text":"hupenda kulala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ni mbwa wenye tamaa kubwa,","poem":1},{"text":"kamwe hawatosheki.","poem":2},{"text":"Wao ni wachungaji waliopungukiwa na ufahamu;","poem":1},{"text":"wote wamegeukia njia yao wenyewe,","poem":2},{"lineBreak":true},{"text":"kila mmoja hutafuta faida yake mwenyewe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kila mmoja hulia, “Njooni, tupate mvinyo!","poem":1},{"text":"Tunywe kileo sana!","poem":2},{"text":"Kesho itakuwa kama leo,","poem":1},{"text":"au hata bora zaidi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}