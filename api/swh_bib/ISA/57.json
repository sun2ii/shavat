{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"heading","content":["Ibada Ya Sanamu Ya Israeli Iliyo Batili"]},{"type":"verse","number":1,"content":[{"text":"Mwenye haki hupotea,","poem":1},{"text":"wala hakuna hata mmoja awazaye hilo moyoni mwake;","poem":2},{"text":"watu wanaomcha Mungu huondolewa,","poem":1},{"text":"wala hakuna hata mmoja anayeelewa","poem":2},{"text":"kuwa wenye haki wameondolewa","poem":1},{"text":"ili wasipatikane na maovu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wale waendao kwa unyofu","poem":1},{"text":"huwa na amani;","poem":2},{"lineBreak":true},{"text":"hupata pumziko walalapo mautini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Lakini ninyi:","poem":1},{"text":"Njooni hapa, ninyi wana wa wachawi,","poem":2},{"lineBreak":true},{"text":"ninyi wazao wa wazinzi na makahaba!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mnamdhihaki nani?","poem":1},{"text":"Ni nani mnayemcheka kwa dharau,","poem":2},{"lineBreak":true},{"text":"na kumtolea ndimi zenu?","poem":2},{"lineBreak":true},{"text":"Je, ninyi si watoto wa waasi,","poem":2},{"lineBreak":true},{"text":"uzao wa waongo?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mnawaka tamaa katikati ya mialoni","poem":1},{"text":"na chini ya kila mti uliotanda matawi;","poem":2},{"text":"mnawatoa kafara watoto wenu kwenye mabonde","poem":1},{"text":"na chini ya majabali yenye mianya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Sanamu zilizo katikati ya mawe laini ya mabondeni ndizo fungu lenu;","poem":1},{"text":"hizo ndizo sehemu yenu.","poem":2},{"text":"Naam, kwa hizo mmemimina sadaka za vinywaji,","poem":1},{"text":"na kutoa sadaka za nafaka.","poem":2},{"text":"Katika haya yote,","poem":1},{"text":"niendelee kuona huruma?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Umeweka kitanda chako juu kwenye kilima kirefu kilichoinuka,","poem":1},{"text":"huko ulikwenda kutoa dhabihu zako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nyuma ya milango yako na miimo yako","poem":1},{"text":"umeweka alama zako za kipagani.","poem":2},{"text":"Kwa kuniacha mimi, ulifunua kitanda chako,","poem":1},{"text":"umepanda juu yake na kukipanua sana;","poem":2},{"text":"ulifanya patano na wale ambao unapenda vitanda vyao,","poem":1},{"text":"nawe uliangalia uchi wao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ulikwenda kwa Moleki","poem":1},{"noteId":33},{"text":"ukiwa na mafuta ya zeituni,","poem":1},{"text":"na ukaongeza manukato yako.","poem":2},{"text":"Ukawatuma wajumbe wako mbali sana,","poem":1},{"text":"ukashuka kwenye kaburi","poem":2},{"noteId":34},{"text":"lenyewe!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ulikuwa umechoshwa na njia zako zote,","poem":1},{"text":"lakini hukusema, ‘Hakuna tumaini.’","poem":2},{"text":"Ulipata uhuisho wa nguvu zako,","poem":1},{"text":"kwa sababu hiyo hukuzimia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ni nani uliyemhofu hivyo na kumwogopa","poem":1},{"text":"hata ukawa mwongo kwangu,","poem":2},{"text":"wala hukunikumbuka","poem":1},{"text":"au kutafakari hili moyoni mwako?","poem":2},{"text":"Si ni kwa sababu nimekuwa kimya muda mrefu","poem":1},{"text":"hata huniogopi?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitaifunua haki yako na matendo yako,","poem":1},{"text":"nayo hayatakufaidi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Utakapolia kwa kuhitaji msaada,","poem":1},{"text":"sanamu zako ulizojikusanyia na zikuokoe!","poem":2},{"text":"Upepo utazipeperusha zote,","poem":1},{"text":"pumzi peke yake itazipeperusha,","poem":2},{"text":"Lakini mtu atakayenifanya kimbilio lake,","poem":1},{"text":"atairithi nchi","poem":2},{"lineBreak":true},{"text":"na kuumiliki mlima wangu mtakatifu.”","poem":2}]},{"type":"heading","content":["Faraja Kwa Wenye Majuto"]},{"type":"verse","number":14,"content":["Tena itasemwa:",{"text":"“Jengeni, jengeni, itengenezeni njia!","poem":1},{"text":"Ondoeni vikwazo katika njia ya watu wangu.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa maana hili ndilo asemalo Aliye juu, yeye aliyeinuliwa sana,","poem":1},{"text":"yeye aishiye milele, ambaye jina lake ni Mtakatifu:","poem":2},{"text":"“Ninaishi mimi mahali palipoinuka na patakatifu,","poem":1},{"lineBreak":true},{"text":"lakini pia pamoja na yeye aliye na roho iliyotubu","poem":1},{"text":"na mwenye roho ya unyenyekevu,","poem":2},{"text":"ili kuzihuisha roho za wanyenyekevu","poem":1},{"text":"na kuihuisha mioyo yao waliotubu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sitaendelea kulaumu milele,","poem":1},{"text":"wala sitakasirika siku zote,","poem":2},{"text":"kwa kuwa roho ya mwanadamu","poem":1},{"text":"ingezimia mbele zangu:","poem":2},{"lineBreak":true},{"text":"yaani pumzi ya mwanadamu niliyemuumba.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nilighadhibika na tamaa yake ya dhambi;","poem":1},{"text":"nilimwadhibu, nikauficha uso wangu kwa hasira,","poem":2},{"lineBreak":true},{"text":"na bado aliendelea katika njia zake za tamaa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nimeziona njia zake, lakini nitamponya,","poem":1},{"text":"nitamwongoza na kumrudishia upya faraja,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"nikiumba sifa midomoni ya waombolezaji","poem":1},{"text":"katika Israeli.","poem":2},{"text":"Amani, amani, kwa wale walio mbali","poem":1},{"text":"na kwa wale walio karibu,”","poem":2},{"lineBreak":true},{"text":"asema Bwana. “Nami nitawaponya.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bali waovu ni kama bahari ichafukayo,","poem":1},{"text":"ambayo haiwezi kutulia,","poem":2},{"lineBreak":true},{"text":"mawimbi yake hutupa takataka na matope.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mungu wangu asema,","poem":1},{"text":"“Hakuna amani kwa waovu.”","poem":2}]}],"footnotes":[{"noteId":33,"caller":"+","text":"Moleki alikuwa mungu aliyekuwa anaabudiwa na Waamoni; pia alijulikana kama Malkomu, Maloki au Kemoshi wa Moabu.","reference":{"chapter":57,"verse":9}},{"noteId":34,"caller":"+","text":"Kaburi hapa maana yake ni Kuzimu, kwa Kiebrania ni Sheol.","reference":{"chapter":57,"verse":9}}]},"thisChapterLink":"/api/swh_bib/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}