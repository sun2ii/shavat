{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Dhambi, Toba Na Ukombozi"]},{"type":"verse","number":1,"content":[{"text":"Hakika mkono wa Bwana si mfupi hata usiweze kuokoa,","poem":1},{"text":"wala sikio lake si zito hata lisiweze kusikia.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lakini maovu yenu yamewatenga","poem":1},{"text":"ninyi na Mungu wenu,","poem":2},{"text":"dhambi zenu zimewaficha ninyi uso wake,","poem":1},{"text":"ili asisikie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa maana mikono yenu imetiwa mawaa kwa damu","poem":1},{"text":"na vidole vyenu kwa hatia.","poem":2},{"text":"Midomo yenu imenena uongo,","poem":1},{"text":"nazo ndimi zenu zimenongʼona mambo maovu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hakuna hata mmoja anayedai kwa haki;","poem":1},{"text":"hakuna hata mmoja anayetetea shauri lake kwa haki.","poem":2},{"text":"Wanategemea mabishano matupu na kusema uongo,","poem":1},{"text":"huchukua mimba ya magomvi na kuzaa uovu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Huangua mayai ya nyoka wenye sumu kali","poem":1},{"text":"na kutanda wavu wa buibui.","poem":2},{"text":"Yeyote alaye mayai yao atakufa,","poem":1},{"text":"na wakati moja lianguliwapo, nyoka hutoka humo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Utando wao wa buibui haufai kwa nguo;","poem":1},{"text":"hawawezi kujifunika kwa kile walichokitengeneza.","poem":2},{"text":"Matendo yao ni matendo maovu,","poem":1},{"text":"vitendo vya jeuri vipo mikononi mwao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Miguu yao hukimbilia kwenye dhambi,","poem":1},{"text":"ni myepesi kumwaga damu isiyo na hatia.","poem":2},{"text":"Mawazo yao ni mawazo maovu;","poem":1},{"text":"uharibifu na maangamizi huonekana katika njia zao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hawajui njia ya amani,","poem":1},{"text":"hakuna haki katika mapito yao.","poem":2},{"text":"Wameyageuza kuwa njia za upotovu,","poem":1},{"text":"hakuna apitaye njia hizo atakayeifahamu amani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hivyo uadilifu uko mbali nasi,","poem":1},{"text":"nayo haki haitufikii.","poem":2},{"text":"Tunatazamia nuru, kumbe! Yote ni giza,","poem":1},{"text":"tunatazamia mwanga, lakini tunatembea katika giza kuu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tunapapasa ukuta kama kipofu,","poem":1},{"text":"tunapapasa katika njia zetu kama watu wasio na macho.","poem":2},{"text":"Adhuhuri tunajikwaa kama wakati wa gizagiza;","poem":1},{"text":"katikati ya wenye nguvu, tuko kama wafu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wote tunanguruma kama dubu;","poem":1},{"text":"tunalia kwa maombolezo kama hua.","poem":2},{"text":"Tunatafuta haki, kumbe hakuna kabisa;","poem":1},{"text":"tunatafuta wokovu, lakini uko mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kwa sababu makosa yetu ni mengi machoni pako,","poem":1},{"text":"na dhambi zetu zinashuhudia dhidi yetu.","poem":2},{"text":"Makosa yetu yako pamoja nasi daima,","poem":1},{"text":"nasi tunayatambua maovu yetu:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uasi na udanganyifu dhidi ya Bwana,","poem":1},{"text":"kumgeuzia Mungu wetu kisogo,","poem":2},{"text":"tukichochea udhalimu na maasi,","poem":1},{"text":"tukinena uongo ambao mioyo yetu imeuhifadhi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hivyo uadilifu umerudishwa nyuma,","poem":1},{"text":"nayo haki inasimama mbali,","poem":2},{"text":"kweli imejikwaa njiani,","poem":1},{"text":"uaminifu hauwezi kuingia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kweli haipatikani popote,","poem":1},{"text":"na yeyote aepukaye uovu huwa mawindo.","poem":2},{"lineBreak":true},{"text":"Bwana alitazama naye akachukizwa","poem":1},{"text":"kwamba hapakuwepo haki.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Aliona kuwa hakuwepo hata mtu mmoja,","poem":1},{"text":"akashangaa kwamba hakuwepo hata mmoja wa kuingilia kati;","poem":2},{"text":"hivyo mkono wake mwenyewe","poem":1},{"text":"ndio uliomfanyia wokovu,","poem":2},{"text":"nayo haki yake mwenyewe","poem":1},{"text":"ndiyo iliyomtegemeza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Alivaa haki kama dirii kifuani mwake,","poem":1},{"text":"na chapeo ya wokovu kichwani mwake,","poem":2},{"text":"alivaa mavazi ya kisasi","poem":1},{"text":"naye akajifunga wivu kama joho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kulingana na kile walichokuwa wametenda,","poem":1},{"text":"ndivyo atakavyolipa","poem":2},{"text":"ghadhabu kwa watesi wake","poem":1},{"text":"na kisasi kwa adui zake,","poem":2},{"lineBreak":true},{"text":"atavilipa visiwa sawa na wanavyostahili.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kuanzia magharibi, watu wataliogopa jina la Bwana","poem":1},{"text":"na kuanzia mawio ya jua, watauheshimu utukufu wake.","poem":2},{"text":"Wakati adui atakapokuja kama mafuriko,","poem":1},{"text":"Roho wa Bwana atainua kiwango dhidi yake na kumshinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mkombozi atakuja Sayuni,","poem":1},{"text":"kwa wale wa Yakobo","poem":2},{"lineBreak":true},{"text":"wanaozitubu dhambi zao,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":21,"content":["“Kwa habari yangu mimi, hili ndilo agano langu nao,” asema Bwana. “Roho wangu, aliye juu yenu, na maneno yangu ambayo nimeyaweka katika vinywa vyenu, havitaondoka vinywani mwenu, wala kutoka vinywani mwa watoto wenu, wala kutoka vinywani mwa wazao wao, kuanzia sasa na hata milele,” asema Bwana."]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}