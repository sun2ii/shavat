{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["Mwaka Wa Upendeleo Wa Bwana"]},{"type":"verse","number":1,"content":[{"text":"Roho wa Bwana Mwenyezi yu juu yangu,","poem":1},{"text":"kwa sababu Bwana amenitia mafuta","poem":2},{"lineBreak":true},{"text":"kuwahubiria maskini habari njema.","poem":2},{"text":"Amenituma kuwaganga waliovunjika moyo,","poem":1},{"text":"kuwatangazia mateka uhuru wao,","poem":2},{"text":"na hao waliofungwa","poem":1},{"text":"habari za kufunguliwa kwao;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kutangaza mwaka wa Bwana uliokubaliwa,","poem":1},{"text":"na siku ya kisasi ya Mungu wetu,","poem":2},{"text":"kuwafariji wote waombolezao,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"na kuwapa mahitaji","poem":2},{"lineBreak":true},{"text":"wale wanaohuzunika katika Sayuni,","poem":2},{"text":"ili kuwapa taji ya uzuri badala ya majivu,","poem":1},{"text":"mafuta ya furaha badala ya maombolezo,","poem":2},{"lineBreak":true},{"text":"vazi la sifa badala ya roho ya kukata tamaa.","poem":2},{"text":"Nao wataitwa mialoni ya haki,","poem":1},{"text":"pando la Bwana,","poem":2},{"lineBreak":true},{"text":"ili kuonyesha utukufu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Watajenga upya magofu ya zamani","poem":1},{"text":"na kupatengeneza mahali palipoachwa ukiwa zamani;","poem":2},{"text":"watafanya upya miji iliyoharibiwa,","poem":1},{"text":"iliyoachwa ukiwa kwa vizazi vingi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wageni watayachunga makundi yenu,","poem":1},{"text":"wageni watafanya kazi katika mashamba yenu,","poem":2},{"lineBreak":true},{"text":"na kutunza mashamba yenu ya mizabibu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nanyi mtaitwa makuhani wa Bwana,","poem":1},{"text":"mtaitwa watumishi wa Mungu wetu.","poem":2},{"text":"Mtakula utajiri wa mataifa,","poem":1},{"text":"nanyi katika utajiri wao mtajisifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Badala ya aibu yao","poem":1},{"text":"watu wangu watapokea sehemu maradufu,","poem":2},{"text":"na badala ya fedheha","poem":1},{"text":"watafurahia katika urithi wao;","poem":2},{"text":"hivyo watarithi sehemu maradufu katika nchi yao,","poem":1},{"text":"nayo furaha ya milele itakuwa yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kwa maana Mimi, Bwana, napenda haki,","poem":1},{"text":"na ninachukia unyangʼanyi na uovu.","poem":2},{"text":"Katika uaminifu wangu nitawapa malipo yao","poem":1},{"text":"na kufanya agano la milele nao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wazao wao watajulikana miongoni mwa mataifa,","poem":1},{"text":"na uzao wao miongoni mwa kabila za watu.","poem":2},{"text":"Wale wote watakaowaona watatambua","poem":1},{"text":"kuwa ni taifa ambalo Bwana amelibariki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ninafurahia sana katika Bwana,","poem":1},{"text":"nafsi yangu inashangilia katika Mungu wangu.","poem":2},{"text":"Kwa maana amenivika mavazi ya wokovu,","poem":1},{"text":"na kunipamba kwa joho la haki,","poem":2},{"text":"kama vile bwana arusi apambavyo","poem":1},{"text":"kichwa chake kama kuhani,","poem":2},{"text":"na kama bibi arusi ajipambavyo","poem":1},{"text":"kwa vito vyake vya thamani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa maana kama vile ardhi ifanyavyo chipukizi kuota,","poem":1},{"text":"na bustani isababishavyo mbegu kuota,","poem":2},{"text":"ndivyo Bwana Mwenyezi atafanya haki na sifa","poem":1},{"text":"zichipuke mbele ya mataifa yote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}