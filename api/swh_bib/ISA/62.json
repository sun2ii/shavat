{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["Jina Jipya La Sayuni"]},{"type":"verse","number":1,"content":[{"text":"Kwa ajili ya Sayuni sitanyamaza,","poem":1},{"text":"kwa ajili ya Yerusalemu sitatulia,","poem":2},{"text":"mpaka haki yake itakapoangaza kama mapambazuko,","poem":1},{"text":"wokovu wake kama mwanga wa moto.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mataifa wataona haki yako,","poem":1},{"text":"nao wafalme wote wataona utukufu wako;","poem":2},{"text":"wewe utaitwa kwa jina jipya","poem":1},{"text":"lile ambalo kinywa cha Bwana kitatamka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Utakuwa taji ya fahari mkononi mwa Bwana,","poem":1},{"text":"taji ya kifalme mkononi mwa Mungu wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hawatakuita tena Aliyeachwa,","poem":1},{"text":"wala nchi yako kuiita Ukiwa.","poem":2},{"text":"Bali utaitwa Hefsiba,","poem":1},{"noteId":36},{"text":"nayo nchi yako itaitwa Beula,","poem":2},{"noteId":37},{"text":"kwa maana Bwana atakufurahia,","poem":1},{"text":"nayo nchi yako itaolewa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kama vile kijana aoavyo mwanamwali,","poem":1},{"text":"ndivyo wanao","poem":2},{"noteId":38},{"text":"watakavyokuoa wewe;","poem":2},{"text":"kama bwana arusi amfurahiavyo bibi arusi wake,","poem":1},{"text":"ndivyo Mungu wako atakavyokufurahia wewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nimeweka walinzi juu ya kuta zako, ee Yerusalemu,","poem":1},{"text":"hawatanyamaza mchana wala usiku.","poem":2},{"text":"Ninyi wenye kumwita Bwana,","poem":1},{"text":"msitulie,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"msimwache apumzike hadi atakapoufanya imara Yerusalemu","poem":1},{"text":"na kuufanya uwe sifa ya dunia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bwana ameapa kwa mkono wake wa kuume","poem":1},{"text":"na kwa mkono wake wenye nguvu:","poem":2},{"text":"“Kamwe sitawapa tena adui zenu","poem":1},{"text":"nafaka zenu kama chakula chao;","poem":2},{"text":"kamwe wageni hawatakunywa tena","poem":1},{"text":"divai mpya ambayo mmeitaabikia,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lakini wale waivunao nafaka wataila","poem":1},{"text":"na kumsifu Bwana,","poem":2},{"text":"nao wale wakusanyao zabibu watainywa divai yake","poem":1},{"text":"katika nyua za patakatifu pangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Piteni, piteni katika malango!","poem":1},{"text":"Tengenezeni njia kwa ajili ya watu.","poem":2},{"text":"Jengeni, jengeni njia kuu!","poem":1},{"text":"Ondoeni mawe.","poem":2},{"text":"Inueni bendera kwa ajili ya mataifa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bwana ametoa tangazo","poem":1},{"text":"mpaka miisho ya dunia:","poem":2},{"text":"“Mwambie Binti Sayuni,","poem":1},{"text":"‘Tazama, mwokozi wako anakuja!","poem":2},{"text":"Tazama ujira wake uko pamoja naye,","poem":1},{"text":"na malipo yake yanafuatana naye!’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wataitwa Watu Watakatifu,","poem":1},{"text":"Waliokombolewa na Bwana;","poem":2},{"lineBreak":true},{"text":"nawe utaitwa Aliyetafutwa,","poem":2},{"lineBreak":true},{"text":"Mji Usioachwa Tena.","poem":2}]}],"footnotes":[{"noteId":36,"caller":"+","text":"Hefsiba maana yake Yeye ninayemfurahia.","reference":{"chapter":62,"verse":4}},{"noteId":37,"caller":"+","text":"Beula maana yake Aliyeolewa.","reference":{"chapter":62,"verse":4}},{"noteId":38,"caller":"+","text":"Au: wajenzi wako.","reference":{"chapter":62,"verse":5}}]},"thisChapterLink":"/api/swh_bib/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}