{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["Hukumu Na Wokovu"]},{"type":"verse","number":1,"content":[{"text":"“Nilijifunua kwa watu wale ambao hawakuniulizia.","poem":1},{"text":"Nimeonekana na watu wale ambao hawakunitafuta.","poem":2},{"text":"Kwa taifa lile ambalo halikuliita Jina langu,","poem":1},{"text":"nilisema, ‘Niko hapa, niko hapa.’","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mchana kutwa nimeinyoosha mikono yangu","poem":1},{"text":"kwa watu wakaidi,","poem":2},{"text":"wanaokwenda katika njia ambazo si nzuri,","poem":1},{"text":"wafuatao mawazo yao wenyewe:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"taifa ambalo daima hunikasirisha","poem":1},{"text":"machoni pangu,","poem":2},{"text":"wakitoa dhabihu katika bustani","poem":1},{"text":"na kufukiza uvumba juu ya madhabahu za matofali;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"watu waketio katikati ya makaburi","poem":1},{"text":"na kukesha mahali pa siri,","poem":2},{"text":"walao nyama za nguruwe,","poem":1},{"text":"nazo sufuria zao zina mchuzi wa nyama zilizo najisi,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wasemao, ‘Kaa mbali; usinikaribie,","poem":1},{"text":"kwa maana mimi ni mtakatifu mno kwako!’","poem":2},{"text":"Watu wa aina hiyo ni moshi katika pua zangu,","poem":1},{"text":"ni moto uwakao mchana kutwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Tazama, jambo hili hubakia limeandikwa mbele zangu:","poem":1},{"text":"sitanyamaza, bali nitalipiza kwa ukamilifu;","poem":2},{"lineBreak":true},{"text":"nitalipiza mapajani mwao:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"dhambi zenu na dhambi za baba zenu,”","poem":1},{"text":"asema Bwana.","poem":2},{"text":"“Kwa sababu walitoa dhabihu za kuteketezwa juu ya milima","poem":1},{"text":"na kunichokoza mimi juu ya vilima,","poem":2},{"text":"nitawapimia mapajani mwao","poem":1},{"text":"malipo makamilifu kwa matendo yao ya zamani.”","poem":2}]},{"type":"verse","number":8,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kama vile divai mpya ingali bado inapatikana","poem":1},{"text":"katika kishada cha zabibu,","poem":2},{"text":"nao watu husema, ‘Usikiharibu,","poem":1},{"text":"kwa kuwa bado kuna kitu kizuri ndani yake,’","poem":2},{"text":"hivyo ndivyo nitakavyofanya kwa ajili ya watumishi wangu;","poem":1},{"text":"sitawaangamiza wote.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nitawaleta wazao kutoka kwa Yakobo,","poem":1},{"text":"na kutoka kwa Yuda wale watakaomiliki milima yangu,","poem":2},{"text":"nao watu wangu wateule watairithi,","poem":1},{"text":"nako huko wataishi watumishi wangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sharoni itakuwa malisho","poem":1},{"text":"kwa ajili ya makundi ya kondoo,","poem":2},{"text":"na Bonde la Akori mahali pa kupumzikia","poem":1},{"text":"kwa makundi ya ngʼombe,","poem":2},{"lineBreak":true},{"text":"kwa ajili ya watu wangu wanaonitafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Bali kwenu ninyi mnaomwacha Bwana","poem":1},{"text":"na kuusahau mlima wangu mtakatifu,","poem":2},{"text":"ninyi mnaoandaa meza kwa ajili ya Bahati,","poem":1},{"noteId":39},{"text":"na kujaza mabakuli ya mvinyo uliochanganywa","poem":2},{"lineBreak":true},{"text":"kwa ajili ya Ajali,","poem":2},{"noteId":40}]},{"type":"verse","number":12,"content":[{"text":"nitawaagiza mfe kwa upanga,","poem":1},{"text":"nanyi nyote mtainama chini ili kuchinjwa;","poem":2},{"text":"kwa kuwa niliwaita lakini hamkuitika,","poem":1},{"text":"nilisema lakini hamkusikiliza.","poem":2},{"text":"Mlitenda maovu machoni pangu,","poem":1},{"text":"nanyi mkachagua mambo yale yanayonichukiza.”","poem":2}]},{"type":"verse","number":13,"content":["Kwa hiyo hili ndilo asemalo Bwana Mwenyezi:",{"text":"“Watumishi wangu watakula,","poem":1},{"text":"lakini ninyi mtaona njaa;","poem":2},{"text":"watumishi wangu watakunywa","poem":1},{"text":"lakini ninyi mtaona kiu;","poem":2},{"text":"watumishi wangu watafurahi,","poem":1},{"text":"lakini ninyi mtaona haya.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Watumishi wangu wataimba","poem":1},{"text":"kwa furaha ya mioyo yao,","poem":2},{"text":"lakini ninyi mtalia","poem":1},{"text":"kutokana na uchungu wa moyoni,","poem":2},{"text":"na kupiga yowe kwa sababu","poem":1},{"text":"ya uchungu wa roho zenu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mtaliacha jina lenu","poem":1},{"text":"kuwa laana kwa watu wangu waliochaguliwa;","poem":2},{"text":"Bwana Mwenyezi atawaua ninyi,","poem":1},{"text":"lakini watumishi wake atawapa jina jingine.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yeye aombaye baraka katika nchi","poem":1},{"text":"atafanya hivyo kwa Mungu wa kweli;","poem":2},{"text":"yeye aapaye katika nchi","poem":1},{"text":"ataapa kwa Mungu wa kweli.","poem":2},{"text":"Kwa kuwa taabu za zamani zitasahaulika","poem":1},{"text":"na kufichwa kutoka machoni pangu.","poem":2}]},{"type":"heading","content":["Mbingu Mpya Na Dunia Mpya"]},{"type":"verse","number":17,"content":[{"text":"“Tazama, nitaumba","poem":1},{"text":"mbingu mpya na dunia mpya.","poem":2},{"text":"Mambo ya zamani hayatakumbukwa,","poem":1},{"text":"wala hayatakuja akilini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lakini furahini na kushangilia daima","poem":1},{"text":"katika hivi nitakavyoumba,","poem":2},{"text":"kwa kuwa nitaumba Yerusalemu uwe wa kupendeza,","poem":1},{"text":"nao watu wake wawe furaha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nami nitaifurahia Yerusalemu","poem":1},{"text":"na kuwafurahia watu wangu;","poem":2},{"text":"sauti ya maombolezo na ya kilio","poem":1},{"text":"haitasikika humo tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Kamwe hatakuwepo tena ndani yake","poem":1},{"text":"mtoto mchanga atakayeishi siku chache tu,","poem":2},{"lineBreak":true},{"text":"au mzee ambaye hataishi akatimiza miaka yake.","poem":2},{"text":"Yeye atakayekufa akiwa na umri wa miaka mia moja","poem":1},{"text":"atahesabiwa kwamba ni kijana tu,","poem":2},{"text":"yeye ambaye hatafika miaka mia moja,","poem":1},{"text":"atahesabiwa kuwa amelaaniwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Watajenga nyumba na kuishi ndani yake;","poem":1},{"text":"watapanda mashamba ya mizabibu na kula matunda yake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hawatajenga nyumba, nao watu wengine waishi ndani yake,","poem":1},{"text":"au kupanda mazao na wengine wale.","poem":2},{"text":"Kwa kuwa kama zilivyo siku za mti,","poem":1},{"text":"ndivyo zitakavyokuwa siku za watu wangu,","poem":2},{"text":"wateule wangu watafurahia kwa siku nyingi","poem":1},{"text":"kazi za mikono yao.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hawatajitaabisha kwa kazi bure,","poem":1},{"text":"wala hawatazaa watoto ili wapatwe na majanga,","poem":2},{"text":"kwa kuwa watakuwa taifa lililobarikiwa na Bwana,","poem":1},{"text":"wao na wazao wao pamoja nao.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kabla hawajaita, nitajibu,","poem":1},{"text":"nao wakiwa katika kunena, nitasikia.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mbwa mwitu na mwana-kondoo watalisha pamoja,","poem":1},{"text":"naye simba atakula nyasi kama maksai,","poem":2},{"lineBreak":true},{"text":"lakini mavumbi yatakuwa chakula cha nyoka.","poem":2},{"text":"Hawatadhuru wala kuharibu","poem":1},{"text":"katika mlima wangu mtakatifu wote,”","poem":2},{"text":"asema Bwana.","poem":4}]}],"footnotes":[{"noteId":39,"caller":"+","text":"Bahati alikuwa mungu wa Wakaldayo ambaye pia alijulikana kama Gadi.","reference":{"chapter":65,"verse":11}},{"noteId":40,"caller":"+","text":"Ajali au Meni alikuwa mungu wa majaliwa.","reference":{"chapter":65,"verse":11}}]},"thisChapterLink":"/api/swh_bib/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}