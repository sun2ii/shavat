{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_bib","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e7e8272c6a50ee56bb058427f67e6f91f64059f76bf9a3a1bc83166c8ad7a290","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_bib/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Kwa Ajili Yetu Mtoto Amezaliwa"]},{"type":"verse","number":1,"content":["Hata hivyo, hapatakuwepo huzuni tena kwa wale waliokuwa katika dhiki. Wakati uliopita aliidhili nchi ya Zabuloni na nchi ya Naftali, lakini katika siku zijazo ataiheshimu Galilaya ya Mataifa, karibu na njia ya bahari, kando ya Yordani:"]},{"type":"verse","number":2,"content":[{"text":"Watu wanaotembea katika giza","poem":1},{"text":"wameona nuru kuu,","poem":2},{"text":"wale wanaoishi katika nchi ya uvuli wa mauti,","poem":1},{"text":"nuru imewazukia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umelikuza taifa,","poem":1},{"text":"na kuzidisha furaha yao,","poem":2},{"text":"wanafurahia mbele zako,","poem":1},{"text":"kama watu wanavyofurahia wakati wa mavuno,","poem":2},{"text":"kama watu wafurahivyo","poem":1},{"text":"wagawanyapo nyara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kama vile siku ya kushindwa kwa Wamidiani,","poem":1},{"text":"umevunja nira iliyowalemea,","poem":2},{"text":"ile gongo mabegani mwao na","poem":1},{"text":"fimbo yake yeye aliyewaonea.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kila kiatu cha askari kilichotumiwa vitani,","poem":1},{"text":"na kila vazi lililovingirishwa katika damu","poem":2},{"text":"vitawekwa kwa ajili ya kuchomwa,","poem":1},{"text":"vitakuwa kuni za kuwasha moto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa maana, kwa ajili yetu mtoto amezaliwa,","poem":1},{"text":"tumepewa mtoto mwanaume,","poem":2},{"lineBreak":true},{"text":"nao utawala utakuwa mabegani mwake.","poem":2},{"text":"Naye ataitwa","poem":1},{"text":"Mshauri wa Ajabu, Mungu Mwenye Nguvu,","poem":2},{"lineBreak":true},{"text":"Baba wa Milele, Mfalme wa Amani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kuongezeka kwa utawala wake na amani","poem":1},{"text":"hakutakuwa na mwisho.","poem":2},{"text":"Atatawala katika kiti cha enzi cha Daudi","poem":1},{"text":"na juu ya ufalme wake,","poem":2},{"text":"akiuthibitisha na kuutegemeza","poem":1},{"text":"kwa haki na kwa adili,","poem":2},{"lineBreak":true},{"text":"tangu wakati huo na hata milele.","poem":2},{"text":"Wivu wa Bwana Mwenye Nguvu Zote","poem":1},{"text":"utatimiza haya.","poem":2}]},{"type":"heading","content":["Hasira Ya Bwana Dhidi Ya Israeli"]},{"type":"verse","number":8,"content":[{"text":"Bwana ametuma ujumbe dhidi ya Yakobo,","poem":1},{"text":"utamwangukia Israeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Watu wote watajua hili:","poem":1},{"text":"Efraimu na wakazi wa Samaria,","poem":2},{"text":"wanaosema kwa kiburi","poem":1},{"text":"na majivuno ya mioyo,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Matofali yameanguka chini,","poem":1},{"text":"lakini tutajenga tena kwa mawe yaliyochongwa,","poem":2},{"text":"mitini imeangushwa,","poem":1},{"text":"lakini tutapanda mierezi badala yake.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lakini Bwana amemtia nguvu adui wa Resini dhidi yao","poem":1},{"text":"na kuchochea watesi wao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Waashuru kutoka upande wa mashariki","poem":1},{"text":"na Wafilisti kutoka upande wa magharibi","poem":2},{"lineBreak":true},{"text":"wameila Israeli kwa kinywa kilichopanuliwa.","poem":2},{"lineBreak":true},{"text":"Hata kwa haya yote, hasira yake haijageukia mbali,","poem":1},{"text":"mkono wake bado umeinuliwa juu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini watu hawajamrudia yeye aliyewapiga,","poem":1},{"text":"wala hawajamtafuta Bwana Mwenye Nguvu Zote.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa hiyo Bwana atakatilia mbali kutoka Israeli kichwa na mkia,","poem":1},{"text":"tawi la mtende na tete katika siku moja.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wazee na watu mashuhuri ndio vichwa,","poem":1},{"text":"nao manabii wanaofundisha uongo ndio mkia.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wale wanaowaongoza watu hawa wanawapotosha,","poem":1},{"text":"nao wale wanaoongozwa wamepotoka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwa hiyo Bwana hatawafurahia vijana,","poem":1},{"text":"wala hatawahurumia yatima na wajane,","poem":2},{"text":"kwa kuwa kila mmoja wao hamchi Mungu, nao ni waovu,","poem":1},{"text":"na kila kinywa kinanena upotovu.","poem":2},{"lineBreak":true},{"text":"Hata kwa haya yote, hasira yake haijageukia mbali,","poem":1},{"text":"mkono wake bado umeinuliwa juu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hakika uovu huwaka kama moto;","poem":1},{"text":"huteketeza michongoma na miiba,","poem":2},{"text":"huwasha moto vichaka vya msituni,","poem":1},{"text":"hujiviringisha kuelekea juu kama nguzo ya moshi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kwa hasira ya Bwana Mwenye Nguvu Zote","poem":1},{"text":"nchi itachomwa kwa moto,","poem":2},{"text":"nao watu watakuwa kuni za kuchochea moto.","poem":1},{"text":"Hakuna mtu atakayemhurumia ndugu yake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Upande wa kuume watakuwa wakitafuna,","poem":1},{"text":"lakini bado wataona njaa;","poem":2},{"text":"upande wa kushoto watakuwa wakila,","poem":1},{"text":"lakini hawatashiba.","poem":2},{"text":"Kila mmoja atajilisha kwa nyama ya mtoto wake mwenyewe:","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Manase atamla Efraimu,","poem":2},{"lineBreak":true},{"text":"naye Efraimu atamla Manase;","poem":2},{"lineBreak":true},{"text":"nao pamoja watakuwa kinyume na Yuda.","poem":2},{"lineBreak":true},{"text":"Hata kwa haya yote, hasira yake haijageukia mbali,","poem":1},{"text":"mkono wake bado umeinuliwa juu.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}