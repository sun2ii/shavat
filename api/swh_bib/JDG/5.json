{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JDG","translationId":"swh_bib","name":"Waamuzi","commonName":"Waamuzi","title":"Waamuzi","order":7,"numberOfChapters":21,"sha256":"3c5f6187fa794369ca2872bbdb16251fec79cb2ee8a713722600d5119ac3388a","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/swh_bib/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["Wimbo Wa Debora"]},{"type":"verse","number":1,"content":["Ndipo Debora na Baraka mwana wa Abinoamu wakaimba wimbo huu:"]},{"type":"verse","number":2,"content":[{"text":"“Wakuu katika Israeli wanapoongoza,","poem":1},{"text":"wakati watu wanapojitoa","poem":2},{"lineBreak":true},{"text":"kwa hiari yao wenyewe:","poem":2},{"lineBreak":true},{"text":"mhimidini Bwana!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Sikieni hili, enyi wafalme!","poem":1},{"text":"Sikilizeni, enyi watawala!","poem":2},{"text":"Nitamwimbia Bwana, nitaimba;","poem":1},{"text":"kwa wimbo nitamhimidi Bwana,","poem":2},{"lineBreak":true},{"text":"Mungu wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ee Bwana, ulipotoka katika Seiri,","poem":1},{"text":"ulipopita katika mashamba ya Edomu,","poem":2},{"text":"nchi ilitetemeka, mbingu nazo zikamwaga,","poem":1},{"text":"naam, mawingu yakamwaga maji.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Milima ilitetemeka mbele za Bwana,","poem":1},{"text":"hata ule wa Sinai,","poem":2},{"lineBreak":true},{"text":"mbele za Bwana,","poem":2},{"lineBreak":true},{"text":"Mungu wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Katika siku za Shamgari mwana wa Anathi,","poem":1},{"text":"katika siku za Yaeli,","poem":2},{"text":"barabara kuu hazikuwa na watu;","poem":1},{"text":"wasafiri walipita njia za kando.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mashujaa walikoma katika Israeli,","poem":1},{"text":"walikoma mpaka mimi, Debora, nilipoinuka,","poem":2},{"lineBreak":true},{"text":"nilipoinuka kama mama katika Israeli.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Walipochagua miungu migeni,","poem":1},{"text":"vita vilikuja katika malango ya mji,","poem":2},{"text":"hapakuonekana ngao wala mkuki","poem":1},{"text":"miongoni mwa mashujaa 40,000 katika Israeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Moyo wangu u pamoja na wakuu wa Israeli,","poem":1},{"text":"pamoja na wale wanaojitoa wenyewe","poem":2},{"lineBreak":true},{"text":"kwa hiari yao miongoni mwa watu.","poem":2},{"lineBreak":true},{"text":"Mhimidini Bwana!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Nanyi mpandao punda weupe,","poem":1},{"text":"mkiketi juu ya matandiko ya thamani,","poem":2},{"lineBreak":true},{"text":"nanyi mtembeao barabarani,","poem":2},{"text":"fikirini","poem":1}]},{"type":"verse","number":11,"content":[{"text":"juu ya sauti za waimbaji","poem":1},{"text":"mahali pa kunyweshea maji.","poem":2},{"text":"Wanasimulia matendo ya haki ya Bwana,","poem":1},{"text":"matendo ya haki ya mashujaa wake","poem":2},{"lineBreak":true},{"text":"katika Israeli.","poem":2},{"lineBreak":true},{"text":"“Ndipo watu wa Bwana","poem":1},{"text":"walipoteremka malangoni pa mji.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"‘Amka, amka! Debora!","poem":1},{"text":"Amka, amka, uimbe!","poem":2},{"text":"Ee Baraka! Inuka,","poem":1},{"text":"chukua mateka wako uliowateka,","poem":2},{"lineBreak":true},{"text":"ee mwana wa Abinoamu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ndipo mabaki ya watu","poem":1},{"text":"wakashuka dhidi ya wenye nguvu,","poem":2},{"text":"watu wa Bwana,","poem":1},{"text":"wakashuka dhidi ya mashujaa wenye nguvu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kutoka Efraimu wakaja watu, ambao chimbuko lao ni Amaleki;","poem":1},{"text":"Benyamini akiwa miongoni","poem":2},{"lineBreak":true},{"text":"mwa watu waliokufuata.","poem":2},{"text":"Kutoka Makiri wakashuka viongozi,","poem":1},{"text":"na kutoka Zabuloni wale washikao","poem":2},{"lineBreak":true},{"text":"fimbo ya jemadari.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wakuu wa Isakari walikuwa pamoja na Debora;","poem":1},{"text":"naam, Isakari alikuwa pamoja na Baraka,","poem":2},{"text":"wakija nyuma yake kwa mbio","poem":1},{"text":"wakielekea bondeni.","poem":2},{"text":"Katika jamaa za Reubeni,","poem":1},{"text":"palikuwa na kujihoji kukubwa moyoni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa nini ulikaa katikati ya mazizi ya kondoo","poem":1},{"text":"kusikiliza sauti ya filimbi zinazoita makundi?","poem":2},{"text":"Kwa jamaa za Reubeni,","poem":1},{"text":"palikuwa na kujihoji kukubwa moyoni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Gileadi alikaa ngʼambo ya Yordani.","poem":1},{"text":"Naye Dani, kwa nini alikaa","poem":2},{"lineBreak":true},{"text":"kwenye merikebu siku nyingi?","poem":2},{"text":"Asheri alikaa kwa utulivu ufuoni mwa bahari,","poem":1},{"text":"akikaa kwenye ghuba zake ndogo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Watu wa Zabuloni walihatarisha maisha yao,","poem":1},{"text":"vilevile nao watu wa Naftali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Wafalme walikuja na kufanya vita;","poem":1},{"text":"wafalme wa Kanaani walipigana","poem":2},{"lineBreak":true},{"text":"huko Taanaki karibu na maji ya Megido,","poem":2},{"lineBreak":true},{"text":"lakini hawakuchukua fedha wala nyara.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kutoka mbinguni nyota zilipigana,","poem":1},{"text":"nyota kutoka njia zake","poem":2},{"lineBreak":true},{"text":"zilipigana na Sisera.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mto wa Kishoni uliwasomba,","poem":1},{"text":"ule mto wa zamani, mto wa Kishoni.","poem":2},{"text":"Songa mbele, ee nafsi yangu,","poem":1},{"text":"kwa ujasiri!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ndipo kwato za farasi zikafanya mshindo:","poem":1},{"text":"farasi wake wenye nguvu","poem":2},{"lineBreak":true},{"text":"huenda mbio kwa kurukaruka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Malaika wa Bwana akasema, ‘Merozi alaaniwe.","poem":1},{"text":"Walaaniwe watu wake kwa uchungu,","poem":2},{"text":"kwa kuwa hawakuja kumsaidia Bwana,","poem":1},{"text":"kumsaidia Bwana dhidi ya hao wenye nguvu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Yaeli abarikiwe kuliko wanawake wote,","poem":1},{"text":"mkewe Heberi, Mkeni,","poem":2},{"text":"abarikiwe kuliko wanawake wote","poem":1},{"text":"waishio kwenye mahema.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Aliomba maji, naye akampa maziwa;","poem":1},{"text":"kwenye bakuli la heshima","poem":2},{"lineBreak":true},{"text":"akamletea maziwa mgando.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akanyoosha mkono wake","poem":1},{"text":"akashika kigingi cha hema,","poem":2},{"text":"mkono wake wa kuume","poem":1},{"text":"ukashika nyundo ya fundi.","poem":2},{"text":"Akampiga Sisera kwa nyundo,","poem":1},{"text":"akamponda kichwa chake,","poem":2},{"text":"akamvunjavunja na kumtoboa","poem":1},{"text":"paji lake la uso.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Aliinama miguuni pa Yaeli,","poem":1},{"text":"akaanguka; akalala hapo.","poem":2},{"text":"Pale alipoinama miguuni pake,","poem":1},{"text":"alianguka;","poem":2},{"text":"pale alipoinamia, ndipo alipoanguka,","poem":1},{"text":"akiwa amekufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Kupitia dirishani mamaye Sisera alichungulia;","poem":1},{"text":"nyuma ya dirisha alilia, akasema,","poem":2},{"text":"‘Mbona gari lake linachelewa kufika?","poem":1},{"text":"Mbona vishindo vya magari yake","poem":2},{"lineBreak":true},{"text":"vimechelewa?’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wanawake wenye busara","poem":1},{"text":"kuliko wengine wote wakamjibu;","poem":2},{"lineBreak":true},{"text":"naam, husema moyoni mwake,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘Je, hawapati na kugawanya nyara:","poem":1},{"text":"msichana mmoja au wawili kwa kila mtu,","poem":2},{"lineBreak":true},{"text":"mavazi ya rangi mbalimbali kwa Sisera kuwa nyara,","poem":2},{"lineBreak":true},{"text":"mavazi ya rangi mbalimbali yaliyotariziwa,","poem":2},{"lineBreak":true},{"text":"mavazi yaliyotariziwa vizuri kwa ajili ya shingo yangu:","poem":2},{"text":"yote haya yakiwa nyara?’","poem":1}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Adui zako wote na waangamie, Ee Bwana!","poem":1},{"text":"Bali wote wakupendao na wawe kama jua","poem":2},{"lineBreak":true},{"text":"lichomozavyo kwa nguvu zake.”","poem":2},"Hivyo nchi ikawa na amani kwa miaka arobaini."]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}