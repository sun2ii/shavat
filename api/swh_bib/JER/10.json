{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["Mungu Na Sanamu"]},{"type":"verse","number":1,"content":["Sikieni lile ambalo Bwana, anena nanyi ee nyumba ya Israeli."]},{"type":"verse","number":2,"content":["Hili ndilo asemalo Bwana:",{"text":"“Usijifunze njia za mataifa","poem":1},{"text":"wala usitishwe na ishara katika anga,","poem":2},{"lineBreak":true},{"text":"ingawa mataifa yanatishwa nazo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa maana desturi za mataifa hazina maana,","poem":1},{"text":"wanakata mti msituni,","poem":2},{"lineBreak":true},{"text":"na fundi anauchonga kwa patasi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wanaparemba kwa fedha na dhahabu,","poem":1},{"text":"wanakikaza kwa nyundo na misumari ili kisitikisike.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sanamu zao ni kama sanamu","poem":1},{"text":"iliyowekwa shambani la matango kutishia ndege","poem":2},{"lineBreak":true},{"text":"nazo haziwezi kuongea;","poem":2},{"text":"sharti zibebwe","poem":1},{"text":"sababu haziwezi kutembea.","poem":2},{"text":"Usiziogope; haziwezi kudhuru,","poem":1},{"text":"wala kutenda lolote jema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hakuna aliye kama wewe, Ee Bwana;","poem":1},{"text":"wewe ni mkuu,","poem":2},{"lineBreak":true},{"text":"jina lako ni lenye nguvu katika uweza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ni nani ambaye haimpasi kukuheshimu wewe,","poem":1},{"text":"Ee Mfalme wa mataifa?","poem":2},{"lineBreak":true},{"text":"Hii ni stahili yako.","poem":2},{"text":"Miongoni mwa watu wote wenye hekima","poem":1},{"text":"katika mataifa na katika falme zao zote,","poem":2},{"lineBreak":true},{"text":"hakuna aliye kama wewe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wote hawana akili, tena ni wapumbavu,","poem":1},{"text":"wanafundishwa na sanamu za miti zisizofaa lolote.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huleta fedha iliyofuliwa kutoka Tarshishi","poem":1},{"text":"na dhahabu kutoka Ufazi.","poem":2},{"text":"Kile ambacho fundi na sonara wametengeneza","poem":1},{"text":"huvikwa mavazi ya rangi ya samawi na urujuani:","poem":2},{"text":"vyote vikiwa vimetengenezwa","poem":1},{"text":"na mafundi stadi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini Bwana ni Mungu wa kweli,","poem":1},{"text":"yeye ndiye Mungu aliye hai, Mfalme wa milele.","poem":2},{"text":"Anapokasirika, dunia hutetemeka,","poem":1},{"text":"mataifa hayawezi kustahimili hasira yake.","poem":2}]},{"type":"verse","number":11,"content":["“Waambie hivi: ‘Miungu hii, ambayo haikuumba mbingu na dunia, itaangamia kutoka dunia na kutoka chini ya mbingu.’ ”"]},{"type":"verse","number":12,"content":[{"text":"Lakini Mungu aliiumba dunia kwa uweza wake,","poem":1},{"text":"akaweka misingi ya ulimwengu kwa hekima yake,","poem":2},{"lineBreak":true},{"text":"na akazitandaza mbingu kwa ufahamu wake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Atoapo sauti yake, maji yaliyo katika mbingu hunguruma;","poem":1},{"text":"huyafanya mawingu yainuke kutoka miisho ya dunia.","poem":2},{"text":"Hupeleka umeme wa radi pamoja na mvua,","poem":1},{"text":"naye huuleta upepo kutoka ghala zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kila mmoja ni mjinga na hana maarifa,","poem":1},{"text":"kila sonara ameaibishwa na sanamu zake.","poem":2},{"text":"Vinyago vyake ni vya udanganyifu,","poem":1},{"text":"havina pumzi ndani yavyo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Havifai kitu, ni vitu vya kufanyia mzaha tu,","poem":1},{"text":"hukumu yavyo itakapowadia, vitaangamia.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yeye aliye Fungu la Yakobo sivyo alivyo,","poem":1},{"text":"kwani ndiye Muumba wa vitu vyote,","poem":2},{"text":"pamoja na Israeli, kabila la urithi wake:","poem":1},{"text":"Bwana Mwenye Nguvu Zote ndilo jina lake.","poem":2}]},{"type":"heading","content":["Maangamizi Yajayo"]},{"type":"verse","number":17,"content":[{"text":"Kusanyeni mali na vitu vyenu mwondoke nchi hii,","poem":1},{"text":"enyi mnaoishi katika hali ya kuzingirwa na jeshi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa kuwa hili ndilo asemalo Bwana:","poem":1},{"text":"“Wakati huu, nitawatupa nje kwa nguvu","poem":2},{"lineBreak":true},{"text":"wote waishio katika nchi hii;","poem":2},{"text":"nitawataabisha","poem":1},{"text":"ili waweze kutekwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ole wangu mimi kwa ajili ya kuumia kwangu!","poem":1},{"text":"Jeraha langu ni kubwa!","poem":2},{"text":"Lakini nilisema,","poem":1},{"text":"“Kweli hii ni adhabu yangu,","poem":2},{"lineBreak":true},{"text":"nami sharti niistahimili.”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hema langu limeangamizwa;","poem":1},{"text":"kamba zake zote zimekatwa.","poem":2},{"text":"Wana wangu wametekwa na hawapo tena;","poem":1},{"text":"hakuna hata mmoja aliyebaki wa kusimamisha hema langu","poem":2},{"lineBreak":true},{"text":"wala wa kusimamisha kibanda changu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wachungaji hawana akili","poem":1},{"text":"wala hawamuulizi Bwana,","poem":2},{"text":"hivyo hawastawi","poem":1},{"text":"na kundi lao lote la kondoo limetawanyika.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sikilizeni! Taarifa inakuja:","poem":1},{"text":"ghasia kubwa kutoka nchi ya kaskazini!","poem":2},{"text":"Hii itafanya miji ya Yuda ukiwa,","poem":1},{"text":"makao ya mbweha.","poem":2}]},{"type":"heading","content":["Maombi Ya Yeremia"]},{"type":"verse","number":23,"content":[{"text":"Ninajua, Ee Bwana, kwamba maisha ya mwanadamu si yake mwenyewe;","poem":1},{"text":"hawezi kuziongoza hatua zake mwenyewe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Unirudi, Ee Bwana, lakini kwa kipimo cha haki:","poem":1},{"text":"si katika hasira yako,","poem":2},{"lineBreak":true},{"text":"usije ukaniangamiza.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Umwage ghadhabu yako juu ya mataifa","poem":1},{"text":"wasiokujua wewe,","poem":2},{"lineBreak":true},{"text":"juu ya mataifa wasioliitia jina lako.","poem":2},{"text":"Kwa kuwa wamemwangamiza Yakobo;","poem":1},{"text":"wamemwangamiza kabisa","poem":2},{"lineBreak":true},{"text":"na kuiharibu nchi yake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}