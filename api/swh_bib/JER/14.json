{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["Ukame, Njaa Na Upanga"]},{"type":"verse","number":1,"content":["Hili ndilo neno la Bwana kwa Yeremia kuhusu ukame:"]},{"type":"verse","number":2,"content":[{"text":"“Yuda anaomboleza,","poem":1},{"text":"miji yake inayodhoofika;","poem":2},{"text":"wanaomboleza kwa ajili ya nchi,","poem":1},{"text":"nacho kilio kinapanda kutoka Yerusalemu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wakuu wanawatuma watumishi wao maji;","poem":1},{"text":"wanakwenda visimani","poem":2},{"lineBreak":true},{"text":"lakini humo hakuna maji.","poem":2},{"text":"Wanarudi na vyombo bila maji;","poem":1},{"text":"wakiwa na hofu na kukata tamaa,","poem":2},{"lineBreak":true},{"text":"wanafunika vichwa vyao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ardhi imepasuka nyufa","poem":1},{"text":"kwa sababu hakuna mvua katika nchi;","poem":2},{"text":"wakulima wana hofu","poem":1},{"text":"na wanafunika vichwa vyao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hata kulungu mashambani","poem":1},{"text":"anamwacha mtoto wake aliyezaliwa wakati huo huo","poem":2},{"lineBreak":true},{"text":"kwa sababu hakuna majani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Punda-mwitu wanasimama juu ya miinuko iliyo kame","poem":1},{"text":"na kutweta kama mbweha;","poem":2},{"text":"macho yao yanakosa nguvu za kuona","poem":1},{"text":"kwa ajili ya kukosa malisho.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ingawa dhambi zetu zinashuhudia juu yetu,","poem":1},{"text":"Ee Bwana, tenda jambo kwa ajili ya jina lako.","poem":2},{"text":"Kwa kuwa kukengeuka kwetu ni kukubwa,","poem":1},{"text":"nasi tumetenda dhambi dhidi yako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Tumaini la Israeli,","poem":1},{"text":"Mwokozi wake wakati wa taabu,","poem":2},{"text":"kwa nini unakuwa kama mgeni katika nchi,","poem":1},{"text":"kama msafiri anayekaa kwa usiku mmoja tu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mbona unakuwa kama mtu aliyeshtukizwa,","poem":1},{"text":"kama shujaa asiye na uwezo wa kuokoa?","poem":2},{"text":"Wewe uko katikati yetu, Ee Bwana,","poem":1},{"text":"nasi tunaitwa kwa jina lako;","poem":2},{"lineBreak":true},{"text":"usituache!","poem":2}]},{"type":"verse","number":10,"content":["Hili ndilo Bwana asemalo kuhusu watu hawa:",{"text":"“Wanapenda sana kutangatanga,","poem":1},{"text":"hawaizuii miguu yao.","poem":2},{"text":"Hivyo Bwana hawakubali;","poem":1},{"text":"sasa ataukumbuka uovu wao","poem":2},{"lineBreak":true},{"text":"na kuwaadhibu kwa ajili ya dhambi zao.”","poem":2}]},{"type":"verse","number":11,"content":["Kisha Bwana akaniambia, “Usiombe kwa ajili ya mafanikio ya watu hawa."]},{"type":"verse","number":12,"content":["Ingawa wanafunga, sitasikiliza kilio chao; hata wakitoa dhabihu za kuteketezwa na dhabihu za nafaka, sitazikubali. Badala yake, nitawaangamiza kwa upanga, njaa na tauni.”"]},{"type":"verse","number":13,"content":["Lakini nikasema, “Aa, Bwana Mwenyezi, manabii wanaendelea kuwaambia, ‘Hamtaona upanga wala kukabiliwa na njaa. Naam, nitawapa amani ya kudumu mahali hapa.’ ”"]},{"type":"verse","number":14,"content":["Ndipo Bwana akaniambia, “Manabii wanatabiri uongo kwa jina langu. Sikuwatuma, wala sikuwaweka, wala sikusema nao. Wanawatabiria maono ya uongo, maaguzi, maono ya sanamu zisizofaa kitu, na madanganyo ya mawazo yao wenyewe."]},{"type":"verse","number":15,"content":["Kwa hiyo, hili ndilo Bwana asemalo kuhusu manabii wanaotabiri kwa jina langu: Mimi sikuwatuma, lakini wanasema, ‘Hakuna upanga wala njaa itakayoigusa nchi hii.’ Manabii hao hao watakufa kwa upanga na njaa."]},{"type":"verse","number":16,"content":["Nao watu hao wanaowatabiria watatupwa nje katika barabara za Yerusalemu kwa sababu ya njaa na upanga. Hapatakuwepo yeyote wa kuwazika wao au wake zao, wana wao au binti zao. Nitawamwagia maafa wanayostahili."]},{"type":"verse","number":17,"content":["“Nena nao neno hili:",{"text":"“ ‘Macho yangu na yatiririkwe na machozi","poem":1},{"text":"usiku na mchana bila kukoma;","poem":2},{"text":"kwa kuwa binti yangu aliye bikira, yaani watu wangu,","poem":1},{"text":"amepata jeraha baya,","poem":2},{"lineBreak":true},{"text":"pigo la kuangamiza.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kama nikienda mashambani,","poem":1},{"text":"ninaona wale waliouawa kwa upanga;","poem":2},{"text":"kama nikienda mjini,","poem":1},{"text":"ninaona maangamizi ya njaa.","poem":2},{"text":"Nabii na kuhani kwa pamoja","poem":1},{"text":"wamekwenda katika nchi wasiyoijua.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Je, umemkataa Yuda kabisa?","poem":1},{"text":"Umemchukia Sayuni kabisa?","poem":2},{"text":"Kwa nini umetuumiza","poem":1},{"text":"hata hatuwezi kuponyeka?","poem":2},{"text":"Tulitarajia amani,","poem":1},{"text":"lakini hakuna jema lililotujia;","poem":2},{"text":"tulitarajia wakati wa kupona","poem":1},{"text":"lakini kuna hofu kuu tu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ee Bwana, tunatambua uovu wetu","poem":1},{"text":"na kosa la baba zetu;","poem":2},{"lineBreak":true},{"text":"kweli tumetenda dhambi dhidi yako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwa ajili ya jina lako usituchukie kabisa;","poem":1},{"text":"usikidharau kiti chako cha enzi kilichotukuka.","poem":2},{"text":"Kumbuka agano lako nasi","poem":1},{"text":"na usilivunje.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Je, kuna sanamu yoyote isiyofaa kitu ya mataifa","poem":1},{"text":"iwezayo kuleta mvua?","poem":2},{"text":"Je, anga peke yake zaweza kutoa mvua?","poem":1},{"text":"La hasha, ni wewe peke yako,","poem":2},{"lineBreak":true},{"text":"Ee Bwana, Mungu wetu.","poem":2},{"text":"Kwa hiyo tumaini letu liko kwako,","poem":1},{"text":"kwa kuwa wewe ndiwe ufanyaye haya yote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}