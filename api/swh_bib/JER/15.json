{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":15,"content":[{"type":"heading","content":["Adhabu Isiyoepukika"]},{"type":"verse","number":1,"content":["Kisha Bwana akaniambia: “Hata kama Mose na Samweli wangesimama mbele zangu, moyo wangu usingewaelekea watu hawa. Waondoe mbele za macho yangu! Waache waende!"]},{"type":"verse","number":2,"content":["Nao kama wakikuuliza, ‘Twende wapi?’ Waambie, ‘Hili ndilo Bwana asemalo:",{"text":"“ ‘Wale waliowekwa kwa ajili ya kufa, wakafe;","poem":1},{"text":"waliowekwa kwa ajili ya upanga, kwa upanga;","poem":2},{"text":"waliowekwa kwa ajili ya njaa, kwa njaa:","poem":1},{"text":"waliowekwa kwa ajili ya kutekwa, watekwe.’ ”","poem":2}]},{"type":"verse","number":3,"content":["Bwana asema, “Nitatuma aina nne za waharabu dhidi yao: nazo ni upanga ili kuua na mbwa ili wakokote mbali, ndege wa angani na wanyama wa nchi ili kula na kuangamiza."]},{"type":"verse","number":4,"content":["Nitawafanya wawe machukizo kwa falme zote za dunia kwa sababu ya kile alichofanya Manase mwana wa Hezekia mfalme wa Yuda huko Yerusalemu."]},{"type":"verse","number":5,"content":[{"text":"“Ni nani atakayekuhurumia, ee Yerusalemu?","poem":1},{"text":"Ni nani atakayeomboleza kwa ajili yako?","poem":2},{"text":"Ni nani atakayesimama ili kuuliza","poem":1},{"text":"kuhusu hali yako?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Umenikataa mimi,” asema Bwana.","poem":1},{"text":"“Unazidi kukengeuka.","poem":2},{"text":"Hivyo nitanyoosha mkono wangu juu yako na kukuangamiza,","poem":1},{"text":"siwezi kuendelea kukuonea huruma.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nitawapepeta kwa uma wa kupepetea","poem":1},{"text":"kwenye malango ya miji katika nchi.","poem":2},{"text":"Nitaleta msiba na maangamizi juu ya watu wangu,","poem":1},{"text":"kwa maana hawajabadili njia zao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nitawafanya wajane wao kuwa wengi","poem":1},{"text":"kuliko mchanga wa bahari.","poem":2},{"text":"Wakati wa adhuhuri nitamleta mharabu","poem":1},{"text":"dhidi ya mama wa vijana wao waume;","poem":2},{"text":"kwa ghafula nitaleta juu yao","poem":1},{"text":"maumivu makuu na hofu kuu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mama mwenye watoto saba atazimia","poem":1},{"text":"na kupumua pumzi yake ya mwisho.","poem":2},{"text":"Jua lake litatua kungali bado mchana,","poem":1},{"text":"atatahayarika na kufedheheka.","poem":2},{"text":"Wale wote waliobaki nitawaua kwa upanga","poem":1},{"text":"mbele ya adui zao,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ole wangu, mama yangu, kwamba ulinizaa,","poem":1},{"text":"mtu ambaye ulimwengu wote","poem":2},{"lineBreak":true},{"text":"unashindana na kugombana naye!","poem":2},{"text":"Sikukopa wala sikukopesha,","poem":1},{"text":"lakini kila mmoja ananilaani.","poem":2}]},{"type":"verse","number":11,"content":["Bwana akasema,",{"text":"“Hakika nitakuokoa kwa kusudi jema,","poem":1},{"text":"hakika nitawafanya adui zako wakuombe msaada","poem":2},{"lineBreak":true},{"text":"nyakati za maafa na nyakati za dhiki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Je, mtu aweza kuvunja chuma,","poem":1},{"text":"chuma kitokacho kaskazini, au shaba?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Utajiri wako na hazina zako nitavitoa kuwa nyara,","poem":1},{"text":"bila gharama,","poem":2},{"text":"kwa sababu ya dhambi zako zote","poem":1},{"text":"katika nchi yako yote.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitakufanya uwe mtumwa wa adui zako","poem":1},{"text":"katika nchi usiyoijua,","poem":2},{"text":"kwa kuwa katika hasira yangu moto umewashwa","poem":1},{"text":"utakaowaka juu yako daima.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wewe unafahamu, Ee Bwana,","poem":1},{"text":"unikumbuke na unitunze mimi.","poem":2},{"lineBreak":true},{"text":"Lipiza kisasi juu ya watesi wangu.","poem":2},{"text":"Kwa uvumilivu wako usiniondolee mbali;","poem":1},{"text":"kumbuka jinsi ninavyoshutumiwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maneno yako yalipokuja, niliyala;","poem":1},{"text":"yakawa shangwe yangu","poem":2},{"lineBreak":true},{"text":"na furaha ya moyo wangu,","poem":2},{"text":"kwa kuwa nimeitwa kwa jina lako,","poem":1},{"text":"Ee Bwana Mungu Mwenye Nguvu Zote.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kamwe sikuketi katika kundi la wafanyao sherehe,","poem":1},{"text":"wala kamwe sikujifurahisha pamoja nao;","poem":2},{"text":"niliketi peke yangu kwa sababu mkono wako ulikuwa juu yangu,","poem":1},{"text":"na wewe ulikuwa umenijaza hasira.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa nini maumivu yangu hayakomi,","poem":1},{"text":"na jeraha langu ni la kuhuzunisha,","poem":2},{"lineBreak":true},{"text":"wala haliponyeki?","poem":2},{"text":"Je, utakuwa kwangu kama kijito cha udanganyifu,","poem":1},{"text":"kama chemchemi iliyokauka?","poem":2}]},{"type":"verse","number":19,"content":["Kwa hiyo hili ndilo asemalo Bwana:",{"text":"“Kama ukitubu, nitakurejeza","poem":1},{"text":"ili uweze kunitumikia;","poem":2},{"text":"kama ukinena maneno yenye maana,","poem":1},{"text":"wala si ya upuzi,","poem":2},{"lineBreak":true},{"text":"utakuwa mnenaji wangu.","poem":2},{"text":"Watu hawa ndio watakaokugeukia,","poem":1},{"text":"wala si wewe utakayewageukia wao.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nitakufanya wewe uwe ukuta kwa watu hawa,","poem":1},{"text":"ngome ya ukuta wa shaba;","poem":2},{"text":"watapigana nawe","poem":1},{"text":"lakini hawatakushinda,","poem":2},{"text":"kwa maana mimi niko pamoja nawe","poem":1},{"text":"kukuponya na kukuokoa,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":21,"content":[{"text":"“Nitakuokoa kutoka mikono ya waovu,","poem":1},{"text":"na kukukomboa kutoka makucha ya watu wakatili.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JER/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/14.json","previousChapterAudioLinks":{},"numberOfVerses":21}