{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":2,"content":[{"type":"heading","content":["Israeli Amwacha Mungu"]},{"type":"verse","number":1,"content":["Neno la Bwana lilinijia kusema,"]},{"type":"verse","number":2,"content":["“Nenda ukahubiri masikioni mwa watu wa Yerusalemu:",{"text":"“ ‘Nakumbuka moyo wako wa uchaji katika ujana wako,","poem":1},{"text":"jinsi ulivyonipenda kama bibi arusi","poem":2},{"text":"na kunifuata katika jangwa lile lote,","poem":1},{"text":"katika nchi isiyopandwa mbegu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Israeli alikuwa mtakatifu kwa Bwana,","poem":1},{"text":"kama malimbuko ya kwanza ya mavuno yake;","poem":2},{"text":"wote waliowaangamiza walihesabiwa kuwa na hatia,","poem":1},{"text":"nayo maafa yaliwakumba,’ ”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sikia neno la Bwana, ee nyumba ya Yakobo,","poem":1},{"text":"nanyi nyote jamaa za nyumba ya Israeli.","poem":2}]},{"type":"verse","number":5,"content":["Hivi ndivyo asemavyo Bwana:",{"text":"“Je, baba zenu waliona kosa gani kwangu,","poem":1},{"text":"hata wakatangatanga mbali nami hivyo?","poem":2},{"text":"Walifuata sanamu zisizofaa,","poem":1},{"text":"nao wenyewe wakawa hawafai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hawakuuliza, ‘Yuko wapi Bwana,","poem":1},{"text":"aliyetupandisha kutoka Misri","poem":2},{"text":"na kutuongoza kupitia nyika kame,","poem":1},{"text":"kupitia nchi ya majangwa na mabonde,","poem":2},{"text":"nchi ya ukame na giza,","poem":1},{"text":"nchi ambayo hakuna mtu asafiriye ndani yake","poem":2},{"lineBreak":true},{"text":"wala hakuna mtu aishiye humo?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Niliwaleta katika nchi yenye wingi wa vitu","poem":1},{"text":"ili mpate kula matunda yake","poem":2},{"lineBreak":true},{"text":"na utajiri wa mazao yake.","poem":2},{"text":"Lakini mkaja na kuinajisi nchi yangu,","poem":1},{"text":"na kuufanya urithi wangu chukizo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Makuhani hawakuuliza,","poem":1},{"text":"‘Yuko wapi Bwana?’","poem":2},{"text":"Wale wanaoshughulikia sheria hawakunijua mimi;","poem":1},{"text":"viongozi waliasi dhidi yangu.","poem":2},{"text":"Manabii walitabiri kwa jina la Baali,","poem":1},{"text":"wakifuata sanamu zisizofaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kwa hiyo naleta tena mashtaka dhidi yako,”","poem":1},{"text":"asema Bwana.","poem":4},{"text":"“Nami nitaleta mashtaka dhidi ya watoto wa watoto wako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Vuka, nenda ngʼambo mpaka pwani ya Kitimu","poem":1},{"noteId":0},{"text":"nawe uangalie,","poem":1},{"text":"tuma watu waende Kedari, wachunguze kwa makini,","poem":2},{"lineBreak":true},{"text":"uone kama kumekuwepo kitu kama hiki.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Je, taifa limebadili miungu yake wakati wowote?","poem":1},{"text":"(Hata ingawa hao si miungu kamwe.)","poem":2},{"text":"Lakini watu wangu wamebadili Utukufu wao","poem":1},{"text":"kwa sanamu zisizofaa kitu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Shangaeni katika hili, ee mbingu,","poem":1},{"text":"nanyi tetemekeni kwa hofu kuu,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"“Watu wangu wametenda dhambi mbili:","poem":1},{"text":"Wameniacha mimi,","poem":2},{"lineBreak":true},{"text":"niliye chemchemi ya maji yaliyo hai,","poem":2},{"text":"nao wamejichimbia visima vyao wenyewe,","poem":1},{"text":"visima vilivyobomoka, visivyoweza kuhifadhi maji.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Je, Israeli ni mtumishi, yaani mtumwa kwa kuzaliwa?","poem":1},{"text":"Kwa nini basi amekuwa mateka?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Simba wamenguruma;","poem":1},{"text":"wamemngurumia.","poem":2},{"text":"Wameifanya nchi yake kuwa ukiwa;","poem":1},{"text":"miji yake imeteketezwa, nayo imeachwa haina watu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pia watu wa Memfisi","poem":1},{"noteId":1},{"text":"na Tahpanhesi","poem":1},{"noteId":2},{"text":"wamevunja taji ya kichwa chako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Je, hukujiletea hili wewe mwenyewe","poem":1},{"text":"kwa kumwacha Bwana, Mungu wako","poem":2},{"lineBreak":true},{"text":"alipowaongoza njiani?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sasa kwa nini uende Misri","poem":1},{"text":"kunywa maji ya Shihori?","poem":2},{"noteId":3},{"text":"Nawe kwa nini kwenda Ashuru","poem":1},{"text":"kunywa maji ya Mto Frati?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Uovu wako utakuadhibu;","poem":1},{"text":"kurudi nyuma kwako kutakukemea.","poem":2},{"text":"Basi kumbuka, utambue","poem":1},{"text":"jinsi lilivyo ovu na chungu kwako","poem":2},{"text":"unapomwacha Bwana Mungu wako","poem":1},{"text":"na kutokuwa na hofu yangu,”","poem":2},{"text":"asema Bwana, Bwana Mwenye Nguvu Zote.","poem":4}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Zamani nilivunja nira yako","poem":1},{"text":"na kukatilia mbali vifungo vyako;","poem":2},{"lineBreak":true},{"text":"ukasema, ‘Sitakutumikia!’","poem":2},{"text":"Naam kweli, kwenye kila kilima kirefu","poem":1},{"text":"na chini ya kila mti uliotanda matawi yake","poem":2},{"lineBreak":true},{"text":"ulijilaza kama kahaba.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nilikupanda ukiwa mzabibu ulio bora sana,","poem":1},{"text":"mkamilifu na wa mbegu nzuri.","poem":2},{"text":"Ilikuwaje basi ukawa kinyume nami,","poem":1},{"text":"ukaharibika na kuwa mzabibu mwitu?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hata ujisafishe kwa magadi","poem":1},{"text":"na kutumia sabuni nyingi,","poem":2},{"lineBreak":true},{"text":"bado doa la hatia yako liko mbele zangu,”","poem":2},{"text":"asema Bwana Mwenyezi.","poem":4}]},{"type":"verse","number":23,"content":[{"text":"“Wawezaje kusema, ‘Mimi si najisi,","poem":1},{"text":"sijawafuata Mabaali’?","poem":2},{"text":"Kumbuka jinsi ulivyotenda kule bondeni;","poem":1},{"text":"fikiri uliyoyafanya.","poem":2},{"text":"Wewe ni ngamia jike mwenye mbio","poem":1},{"text":"ukikimbia hapa na pale,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"punda-mwitu aliyezoea jangwa,","poem":1},{"text":"anayenusa upepo katika tamaa yake kubwa:","poem":2},{"text":"katika wakati wake wa kuhitaji mbegu","poem":1},{"text":"ni nani awezaye kumzuia?","poem":2},{"text":"Madume yoyote yanayomfuatilia","poem":1},{"text":"hayana haja ya kujichosha;","poem":2},{"lineBreak":true},{"text":"wakati wa kupandwa kwake watampata tu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usikimbie hadi miguu yako iwe haina viatu,","poem":1},{"text":"na koo lako liwe limekauka.","poem":2},{"text":"Lakini ulisema, ‘Haina maana!","poem":1},{"text":"Ninaipenda miungu ya kigeni,","poem":2},{"lineBreak":true},{"text":"nami lazima niifuatie.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Kama vile mwizi aaibikavyo wakati amekamatwa,","poem":1},{"text":"hivyo ndivyo nyumba ya Israeli inavyoaibishwa:","poem":2},{"text":"wao wenyewe, wafalme wao na maafisa wao,","poem":1},{"text":"makuhani wao na manabii wao.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wanaiambia miti, ‘Wewe ndiwe baba yangu,’","poem":1},{"text":"nalo jiwe, ‘Wewe ndiwe uliyenizaa.’","poem":2},{"text":"Wamenipa visogo vyao","poem":1},{"text":"wala hawakunigeuzia nyuso zao;","poem":2},{"text":"lakini wakiwa katika taabu, wanasema,","poem":1},{"text":"‘Njoo utuokoe!’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Iko wapi basi ile miungu mliyojitengenezea?","poem":1},{"text":"Yenyewe na ije kama inaweza kuwaokoa","poem":2},{"lineBreak":true},{"text":"wakati mko katika taabu!","poem":2},{"text":"Kwa maana mna miungu mingi","poem":1},{"text":"kama mlivyo na miji, ee Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Kwa nini mnaleta mashtaka dhidi yangu?","poem":1},{"text":"Ninyi nyote mmeniasi,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":30,"content":[{"text":"“Nimeadhibu watu wako bure tu,","poem":1},{"text":"hawakujirekebisha.","poem":2},{"text":"Upanga wako umewala manabii wako","poem":1},{"text":"kama simba mwenye njaa.","poem":2}]},{"type":"verse","number":31,"content":["“Enyi wa kizazi hiki, tafakarini neno la Bwana:",{"text":"“Je, nimekuwa jangwa kwa Israeli","poem":1},{"text":"au nchi ya giza kuu?","poem":2},{"text":"Kwa nini watu wangu wanasema, ‘Sisi tuko huru kuzurura,","poem":1},{"text":"hatutarudi kwako tena’?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Je, mwanamwali husahau vito vyake,","poem":1},{"text":"au bibi arusi mapambo yake ya arusi?","poem":2},{"text":"Lakini watu wangu wamenisahau mimi,","poem":1},{"text":"tena kwa siku zisizo na hesabu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Je, wewe una ustadi kiasi gani katika kufuatia mapenzi!","poem":1},{"text":"Hata wale wanawake wabaya kuliko wote","poem":2},{"lineBreak":true},{"text":"wanaweza kujifunza kutokana na njia zako.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Katika nguo zako watu huona","poem":1},{"text":"damu ya uhai ya maskini wasio na hatia,","poem":2},{"lineBreak":true},{"text":"ingawa hukuwakamata wakivunja nyumba.","poem":2},{"text":"Lakini katika haya yote","poem":1}]},{"type":"verse","number":35,"content":[{"text":"unasema, ‘Sina hatia;","poem":2},{"lineBreak":true},{"text":"Mungu hajanikasirikia.’","poem":2},{"text":"Lakini nitakuhukumu kwa sababu unasema,","poem":1},{"text":"‘Mimi sijatenda dhambi.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kwa nini unatangatanga sana,","poem":1},{"text":"kubadili njia zako?","poem":2},{"text":"Utakatishwa tamaa na Misri","poem":1},{"text":"kama ulivyokatishwa na Ashuru.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Pia utaondoka mahali hapo","poem":1},{"text":"ukiwa umeweka mikono kichwani,","poem":2},{"text":"kwa kuwa Bwana amewakataa wale unaowatumainia;","poem":1},{"text":"hutasaidiwa nao.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kitimu hapa ni Kipro, kisiwa katika Bahari ya Mediterania.","reference":{"chapter":2,"verse":10}},{"noteId":1,"caller":"+","text":"Memfisi kwa Kiebrania ni Nofu.","reference":{"chapter":2,"verse":16}},{"noteId":2,"caller":"+","text":"Tahpanhesi ni mji katika nchi ya Misri.","reference":{"chapter":2,"verse":16}},{"noteId":3,"caller":"+","text":"Kijito kinachoelekeza maji katika Mto Naili.","reference":{"chapter":2,"verse":18}}]},"thisChapterLink":"/api/swh_bib/JER/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/1.json","previousChapterAudioLinks":{},"numberOfVerses":37}