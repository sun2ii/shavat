{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["Yeremia Ateswa Na Pashuri"]},{"type":"verse","number":1,"content":["Ikawa kuhani Pashuri mwana wa Imeri, mkuu wa maafisa wa Hekalu la Bwana, alipomsikia Yeremia akitoa unabii juu ya mambo haya,"]},{"type":"verse","number":2,"content":["akaamuru Yeremia nabii apigwe na kufungwa kwenye mkatale katika Lango la Juu la Benyamini huko Hekaluni la Bwana."]},{"type":"verse","number":3,"content":["Siku ya pili Pashuri alipomwachia kutoka kwenye mkatale, Yeremia akamwambia, “Bwana hakukuita jina lako kuwa Pashuri bali Magor-Misabibu.",{"noteId":6}]},{"type":"verse","number":4,"content":["Kwa kuwa hili ndilo asemalo Bwana: ‘Nitakufanya kuwa hofu kuu kwako wewe mwenyewe na rafiki zako wote, na kwa macho yako mwenyewe utawaona wakianguka kwa upanga wa adui zao. Nitawatia Yuda wote mikononi mwa mfalme wa Babeli, ambaye atawachukua na kuwapeleka Babeli, ama awaue kwa upanga."]},{"type":"verse","number":5,"content":["Nitatia utajiri wote wa mji huu kwa adui zao: yaani mazao yao yote, vitu vyao vyote vya thamani, na hazina zote za wafalme wa Yuda. Watavitwaa kwa nyara na kuvipeleka Babeli."]},{"type":"verse","number":6,"content":["Nawe Pashuri pamoja na wote waishio katika nyumba yako mtakwenda uhamishoni Babeli. Mtafia humo na kuzikwa, wewe na rafiki zako wote ambao umewatabiria uongo.’ ”"]},{"type":"heading","content":["Malalamiko Ya Yeremia"]},{"type":"verse","number":7,"content":[{"text":"Ee Bwana, umenidanganya,","poem":1},{"text":"nami nikadanganyika;","poem":2},{"text":"wewe una nguvu kuniliko,","poem":1},{"text":"nawe umenishinda.","poem":2},{"text":"Ninadharauliwa mchana kutwa,","poem":1},{"text":"kila mmoja ananidhihaki.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kila ninenapo, ninapiga kelele","poem":1},{"text":"nikitangaza ukatili na uharibifu.","poem":2},{"text":"Kwa hiyo neno la Bwana limeniletea matukano","poem":1},{"text":"na mashutumu mchana kutwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lakini kama nikisema, “Sitamtaja","poem":1},{"text":"wala kusema tena kwa jina lake,”","poem":2},{"text":"neno lake linawaka ndani ya moyo wangu kama moto,","poem":1},{"text":"moto uliofungwa ndani ya mifupa yangu.","poem":2},{"text":"Nimechoka sana kwa kulizuia ndani mwangu;","poem":1},{"text":"kweli, siwezi kujizuia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ninasikia minongʼono mingi,","poem":1},{"text":"“Hofu iko pande zote!","poem":2},{"lineBreak":true},{"text":"Mshtakini! Twendeni tumshtaki!”","poem":2},{"text":"Rafiki zangu wote wananisubiri niteleze,","poem":1},{"text":"wakisema,","poem":2},{"text":"“Labda atadanganyika;","poem":1},{"text":"kisha tutamshinda","poem":2},{"lineBreak":true},{"text":"na kulipiza kisasi juu yake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakini Bwana yu pamoja nami","poem":1},{"text":"kama shujaa mwenye nguvu;","poem":2},{"text":"hivyo washtaki wangu watajikwaa","poem":1},{"text":"na kamwe hawatashinda.","poem":2},{"text":"Watashindwa, nao wataaibika kabisa;","poem":1},{"text":"kukosa adabu kwao hakutasahauliwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee Bwana Mwenye Nguvu Zote,","poem":1},{"text":"wewe umjaribuye mwenye haki","poem":2},{"lineBreak":true},{"text":"na kupima moyo na nia,","poem":2},{"text":"hebu nione ukilipiza kisasi juu yao,","poem":1},{"text":"kwa maana kwako","poem":2},{"lineBreak":true},{"text":"nimeliweka shauri langu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwimbieni Bwana!","poem":1},{"text":"Mpeni Bwana sifa!","poem":2},{"text":"Yeye huokoa uhai wa mhitaji","poem":1},{"text":"kutoka mikononi mwa waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ilaaniwe siku niliyozaliwa!","poem":1},{"text":"Nayo isibarikiwe ile siku","poem":2},{"lineBreak":true},{"text":"mama yangu aliyonizaa!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Alaaniwe mtu yule aliyemletea baba yangu habari,","poem":1},{"text":"yule aliyemfanya afurahi sana, akisema,","poem":2},{"text":"“Mtoto amezaliwa kwako,","poem":1},{"text":"tena mtoto wa kiume!”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mtu huyo na awe kama miji ile","poem":1},{"text":"ambayo Bwana Mungu","poem":2},{"lineBreak":true},{"text":"aliiangamiza bila huruma.","poem":2},{"text":"Yeye na asikie maombolezo asubuhi","poem":1},{"text":"na kilio cha vita adhuhuri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwa sababu hakuniua nikiwa tumboni,","poem":1},{"text":"hivyo mama yangu angekuwa kaburi langu,","poem":2},{"text":"nalo tumbo lake la uzazi","poem":1},{"text":"lingebaki kuwa kubwa daima.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa nini basi nilitoka tumboni","poem":1},{"text":"ili kuona taabu na huzuni,","poem":2},{"lineBreak":true},{"text":"na kuzimaliza siku zangu katika aibu?","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Magor-Misabibu maana yake hapa ni Vitisho pande zote.","reference":{"chapter":20,"verse":3}}]},"thisChapterLink":"/api/swh_bib/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}