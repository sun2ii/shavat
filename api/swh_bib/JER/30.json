{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":30,"content":[{"type":"heading","content":["Kurudishwa Kwa Israeli"]},{"type":"verse","number":1,"content":["Hili ndilo neno lililomjia Yeremia kutoka kwa Bwana:"]},{"type":"verse","number":2,"content":["“Hili ndilo asemalo Bwana, Mungu wa Israeli: ‘Andika katika kitabu maneno yote niliyonena na wewe."]},{"type":"verse","number":3,"content":["Siku zinakuja,’ asema Bwana, ‘nitakapowaleta watu wangu Israeli na Yuda kutoka uhamishoni, na kuwarudisha katika nchi niliyowapa baba zao ili kuimiliki,’ asema Bwana.”"]},{"type":"verse","number":4,"content":["Haya ndiyo maneno Bwana aliyoyanena kuhusu Israeli na Yuda:"]},{"type":"verse","number":5,"content":["“Hili ndilo asemalo Bwana:",{"text":"“ ‘Vilio vya woga vinasikika:","poem":1},{"text":"hofu kuu, wala si amani.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ulizeni na mkaone:","poem":1},{"text":"Je, mwanaume aweza kuzaa watoto?","poem":2},{"text":"Kwa nini basi ninaona kila mwanaume mwenye nguvu","poem":1},{"text":"ameweka mikono yake tumboni","poem":2},{"text":"kama mwanamke aliye na utungu wa kuzaa,","poem":1},{"text":"kila uso ukigeuka rangi kabisa?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tazama jinsi ile siku itakavyokuwa ya kutisha!","poem":1},{"text":"Hakutakuwa na nyingine mfano wake.","poem":2},{"text":"Utakuwa wakati wa dhiki kwa Yakobo,","poem":1},{"text":"lakini ataokolewa kutoka hiyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Katika siku ile,’ asema Bwana Mwenye Nguvu Zote,","poem":1},{"text":"‘nitaivunja nira kutoka shingoni mwao","poem":2},{"text":"na kuvipasua vifungo vyao;","poem":1},{"text":"wageni hawatawafanya tena watumwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Badala yake, watamtumikia Bwana, Mungu wao","poem":1},{"text":"na Daudi mfalme wao,","poem":2},{"lineBreak":true},{"text":"nitakayemwinua kwa ajili yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Hivyo usiogope, ee Yakobo mtumishi wangu,","poem":1},{"text":"usifadhaike, ee Israeli,’","poem":2},{"text":"asema Bwana.","poem":4},{"text":"‘Hakika, nitakuokoa kutoka mbali,","poem":1},{"text":"wazao wako kutoka nchi ya uhamisho wao.","poem":2},{"text":"Yakobo atakuwa tena na amani na usalama,","poem":1},{"text":"wala hakuna atakayemtia hofu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mimi niko pamoja nawe, nami nitakuokoa,’","poem":1},{"text":"asema Bwana.","poem":2},{"text":"‘Ingawa nitayaangamiza kabisa mataifa yote","poem":1},{"text":"ambamo miongoni mwao nimewatawanya,","poem":2},{"lineBreak":true},{"text":"sitawaangamiza ninyi kabisa.","poem":2},{"text":"Nitawaadhibu, lakini kwa haki.","poem":1},{"text":"Sitawaacha kabisa bila adhabu.’","poem":2}]},{"type":"verse","number":12,"content":["“Hili ndilo asemalo Bwana:",{"text":"“ ‘Kidonda chako hakina dawa,","poem":1},{"text":"jeraha lako haliponyeki.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hakuna yeyote wa kukutetea shauri lako,","poem":1},{"text":"hakuna dawa ya kidonda chako,","poem":2},{"lineBreak":true},{"text":"wewe hutapona.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wale walioungana nawe wote wamekusahau,","poem":1},{"text":"hawajali chochote kukuhusu wewe.","poem":2},{"text":"Nimekupiga kama vile adui angelifanya,","poem":1},{"text":"na kukuadhibu kama vile mtu mkatili angelifanya,","poem":2},{"text":"kwa sababu hatia yako ni kubwa mno","poem":1},{"text":"na dhambi zako ni nyingi sana.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa nini unalia kwa ajili ya jeraha lako,","poem":1},{"text":"yale maumivu yako yasiyoponyeka?","poem":2},{"text":"Kwa sababu ya uovu wako mkubwa na dhambi zako nyingi","poem":1},{"text":"nimekufanyia mambo haya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“ ‘Lakini watu wote wakuangamizao wataangamizwa;","poem":1},{"text":"adui zako wote watakwenda uhamishoni.","poem":2},{"text":"Wale wote wakutekao nyara watatekwa nyara;","poem":1},{"text":"wote wakufanyao mateka nitawafanya mateka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lakini nitakurudishia afya yako","poem":1},{"text":"na kuyaponya majeraha yako,’","poem":2},{"text":"asema Bwana,","poem":4},{"text":"‘kwa sababu umeitwa mwenye kutupwa,","poem":1},{"text":"Sayuni ambaye hakuna yeyote anayekujali.’","poem":2}]},{"type":"verse","number":18,"content":["“Hili ndilo asemalo Bwana:",{"text":"“ ‘Nitarudisha baraka za mahema ya Yakobo,","poem":1},{"text":"na kuhurumia maskani yake.","poem":2},{"text":"Mji utajengwa tena juu ya magofu yake,","poem":1},{"text":"nalo jumba la kifalme litasimama mahali pake halisi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nyimbo za kushukuru zitatoka kwao","poem":1},{"text":"na sauti ya furaha.","poem":2},{"text":"Nitaiongeza idadi yao","poem":1},{"text":"wala hawatapungua,","poem":2},{"text":"nitawapa heshima","poem":1},{"text":"na hawatadharauliwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Watoto wao watakuwa kama walivyokuwa","poem":1},{"text":"siku za zamani,","poem":2},{"text":"nayo jumuiya yao itaimarishwa mbele yangu;","poem":1},{"text":"nitawaadhibu wale wote wawaoneao.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mmoja wao atakuwa kiongozi wao;","poem":1},{"text":"mtawala wao atainuka miongoni mwao.","poem":2},{"text":"Nitamleta karibu nami,","poem":1},{"text":"naye atanikaribia mimi,","poem":2},{"text":"kwa maana ni nani yule atakayejitolea","poem":1},{"text":"kuwa karibu nami?’","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":22,"content":[{"text":"‘Kwa hiyo ninyi mtakuwa watu wangu,","poem":1},{"text":"nami nitakuwa Mungu wenu.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Tazama, tufani ya Bwana","poem":1},{"text":"italipuka kwa ghadhabu,","poem":2},{"text":"upepo wa kisulisuli uendao kasi","poem":1},{"text":"utashuka juu ya vichwa vya waovu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hasira kali ya Bwana haitarudi nyuma","poem":1},{"text":"mpaka atakapotimiza makusudi yote ya moyo wake.","poem":2},{"text":"Siku zijazo","poem":1},{"text":"mtayaelewa haya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JER/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/29.json","previousChapterAudioLinks":{},"numberOfVerses":24}