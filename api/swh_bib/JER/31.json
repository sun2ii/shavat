{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":31,"content":[{"type":"heading","content":["Mahamisho Kurudi Kwa Shangwe"]},{"type":"verse","number":1,"content":["“Wakati huo, nitakuwa Mungu wa koo zote za Israeli nao watakuwa watu wangu,” asema Bwana."]},{"type":"verse","number":2,"content":["Hili ndilo asemalo Bwana:",{"text":"“Watu watakaopona upanga","poem":1},{"text":"watapata upendeleo jangwani;","poem":2},{"lineBreak":true},{"text":"nitakuja niwape Israeli pumziko.”","poem":2}]},{"type":"verse","number":3,"content":["Bwana alitutokea wakati uliopita, akisema:",{"text":"“Nimekupenda kwa upendo wa milele,","poem":1},{"text":"nimekuvuta kwa wema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nitakujenga tena nawe utajengeka upya,","poem":1},{"text":"ewe Bikira Israeli.","poem":2},{"text":"Utachukua tena matari yako","poem":1},{"text":"na kwenda kucheza na wenye furaha.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Utapanda tena shamba la mizabibu","poem":1},{"text":"juu ya vilima vya Samaria,","poem":2},{"text":"wakulima watapanda","poem":1},{"text":"na kufurahia matunda yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Itakuja siku wakati walinzi watakapowapigia kelele","poem":1},{"text":"juu ya vilima vya Efraimu wakisema,","poem":2},{"text":"‘Njooni, twendeni juu Sayuni,","poem":1},{"text":"kwake Bwana Mungu wetu.’ ”","poem":2}]},{"type":"verse","number":7,"content":["Hili ndilo asemalo Bwana:",{"text":"“Mwimbieni Yakobo kwa furaha,","poem":1},{"text":"mpigieni kelele aliye mkuu wa mataifa.","poem":2},{"text":"Zifanyeni sifa zenu zisikike, nanyi mseme,","poem":1},{"text":"‘Ee Bwana, okoa watu wako,","poem":2},{"lineBreak":true},{"text":"mabaki ya Israeli.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tazama, nitawaleta kutoka nchi ya kaskazini","poem":1},{"text":"na kuwakusanya kutoka miisho ya dunia.","poem":2},{"text":"Miongoni mwao watakuwepo vipofu na viwete,","poem":1},{"text":"mama wajawazito na wenye utungu wa kuzaa.","poem":2},{"lineBreak":true},{"text":"Umati mkubwa wa watu utarudi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Watakuja wakilia;","poem":1},{"text":"wataomba wakati ninawarudisha.","poem":2},{"text":"Nitawaongoza kando ya vijito vya maji","poem":1},{"text":"katika mapito yaliyo tambarare ambapo hawatajikwaa,","poem":2},{"text":"kwa sababu mimi ndimi baba wa Israeli,","poem":1},{"text":"naye Efraimu ni mzaliwa wangu wa kwanza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Sikieni neno la Bwana, enyi mataifa,","poem":1},{"text":"litangazeni katika nchi za pwani ya mbali:","poem":2},{"text":"‘Yeye aliyewatawanya Israeli atawakusanya","poem":1},{"text":"na atalichunga kundi lake la kondoo kama mchungaji.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa kuwa Bwana atamlipia fidia Yakobo","poem":1},{"text":"na kuwakomboa mkononi mwa walio na nguvu kuliko wao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watakuja na kupiga kelele kwa furaha katika miinuko ya Sayuni;","poem":1},{"text":"watashangilia ukarimu wa Bwana:","poem":2},{"text":"nafaka, divai mpya na mafuta,","poem":1},{"text":"wana-kondoo wachanga","poem":2},{"lineBreak":true},{"text":"na ndama wa makundi ya ngʼombe nitakaowapa.","poem":2},{"text":"Watakuwa kama bustani iliyonyeshewa vizuri,","poem":1},{"text":"wala hawatahuzunika tena.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kisha wanawali watacheza na kufurahi,","poem":1},{"text":"vijana waume na wazee pia.","poem":2},{"text":"Nitageuza maombolezo yao kuwa furaha,","poem":1},{"text":"nitawapa faraja na furaha badala ya huzuni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitawashibisha makuhani kwa wingi,","poem":1},{"text":"nao watu wangu watajazwa kwa ukarimu wangu,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":15,"content":["Hili ndilo asemalo Bwana:",{"text":"“Sauti imesikika huko Rama,","poem":1},{"text":"maombolezo na kilio kikubwa,","poem":2},{"text":"Raheli akiwalilia watoto wake","poem":1},{"text":"na anakataa kufarijiwa,","poem":2},{"lineBreak":true},{"text":"kwa sababu watoto wake hawako tena.”","poem":2}]},{"type":"verse","number":16,"content":["Hili ndilo asemalo Bwana:",{"text":"“Izuie sauti yako kulia,","poem":1},{"text":"na macho yako yasitoe machozi,","poem":2},{"text":"kwa kuwa kazi yako itapata thawabu,”","poem":1},{"text":"asema Bwana.","poem":4},{"text":"“Watarudi kutoka nchi ya adui.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwa hiyo kuna tumaini kwa siku zijazo,”","poem":1},{"text":"asema Bwana.","poem":4},{"text":"“Watoto wako watarudi nchi yao yenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Hakika nimeyasikia maombolezo ya Efraimu:","poem":1},{"text":"‘Ulinirudi kama ndama mkaidi,","poem":2},{"lineBreak":true},{"text":"nami nimekubali kutii.","poem":2},{"text":"Unirudishe, nami nitarudi,","poem":1},{"text":"kwa sababu wewe ndiwe Bwana, Mungu wangu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Baada ya kupotea, nilitubu;","poem":1},{"text":"baada ya kuelewa, nilijipiga kifua.","poem":2},{"text":"Niliaibika na kuona haya","poem":1},{"text":"kwa sababu niliibeba aibu ya ujana wangu.’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Je, Efraimu si mwanangu mpendwa,","poem":1},{"text":"mtoto ninayependezwa naye?","poem":2},{"text":"Ingawa mara kwa mara ninanena dhidi yake,","poem":1},{"text":"bado ninamkumbuka.","poem":2},{"text":"Kwa hiyo moyo wangu unamwonea shauku,","poem":1},{"text":"nina huruma kubwa kwa ajili yake,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Weka alama za barabara,","poem":1},{"text":"weka vibao vya kuelekeza.","poem":2},{"text":"Zingatia vyema njia kuu,","poem":1},{"text":"barabara ile unayoipita.","poem":2},{"text":"Rudi, ee Bikira Israeli,","poem":1},{"text":"rudi kwenye miji yako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Utatangatanga hata lini,","poem":1},{"text":"ee binti usiye mwaminifu?","poem":2},{"text":"Bwana ameumba kitu kipya duniani:","poem":1},{"text":"mwanamke atamlinda mwanaume.”","poem":2}]},{"type":"verse","number":23,"content":["Hili ndilo Bwana Mwenye Nguvu Zote, Mungu wa Israeli, asemalo, “Nitakapowarudisha toka nchi ya kutekwa kwenu, watu walio katika nchi ya Yuda na miji yake kwa mara nyingine tena watatumia maneno haya: ‘Bwana akubariki, ee makao ya haki, ee mlima mtakatifu.’"]},{"type":"verse","number":24,"content":["Watu wataishi pamoja katika Yuda na miji yake yote, wakulima na wote wanaohamahama na mifugo yao."]},{"type":"verse","number":25,"content":["Nitawaburudisha waliochoka na kuwatuliza walio na huzuni.”"]},{"type":"verse","number":26,"content":["Kwa jambo hili niliamka na kuangalia pande zote. Usingizi wangu ulikuwa mtamu kwangu."]},{"type":"verse","number":27,"content":["Bwana asema, “Siku zinakuja, nitakapoongeza idadi ya watu, na kuzidisha hesabu ya mifugo katika nyumba ya Israeli na nyumba ya Yuda."]},{"type":"verse","number":28,"content":["Kama vile nilivyowaangalia ili kungʼoa na kubomoa, kuharibu, kuangamiza na kuleta maafa juu yao, vivyo hivyo nitawaangalia ili kujenga na kupanda,” asema Bwana."]},{"type":"verse","number":29,"content":["“Katika siku hizo, watu hawatasema tena,",{"text":"“ ‘Baba wamekula zabibu chachu,","poem":1},{"text":"nayo meno ya watoto yakatiwa ganzi.’","poem":2}]},{"type":"verse","number":30,"content":["Badala yake, kila mmoja atakufa kwa ajili ya dhambi zake mwenyewe; yeyote alaye zabibu chachu, meno yake mwenyewe yatatiwa ganzi."]},{"type":"verse","number":31,"content":[{"text":"“Siku zinakuja,” asema Bwana,","poem":1},{"text":"“nitakapofanya agano jipya","poem":2},{"text":"na nyumba ya Israeli","poem":1},{"text":"na nyumba ya Yuda.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Halitafanana na agano","poem":1},{"text":"nililofanya na baba zao","poem":2},{"text":"wakati nilipowashika mkono","poem":1},{"text":"kuwaongoza watoke Misri,","poem":2},{"text":"kwa sababu walivunja agano langu,","poem":1},{"text":"ijapokuwa nilikuwa mume kwao,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"“Hili ndilo agano nitakalofanya na nyumba ya Israeli","poem":1},{"text":"baada ya siku zile,” asema Bwana.","poem":2},{"text":"“Nitaweka sheria yangu katika nia zao,","poem":1},{"text":"na kuiandika mioyoni mwao.","poem":2},{"text":"Nitakuwa Mungu wao,","poem":1},{"text":"nao watakuwa watu wangu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mtu hatamfundisha tena jirani yake,","poem":1},{"text":"wala mtu kumfundisha ndugu yake akisema, ‘Mjue Bwana Mungu,’","poem":2},{"text":"kwa sababu wote watanijua mimi,","poem":1},{"text":"tangu aliye mdogo kabisa kwao, hadi aliye mkuu sana,”","poem":2},{"text":"asema Bwana.","poem":4},{"text":"“Kwa sababu nitasamehe uovu wao,","poem":1},{"text":"wala sitazikumbuka dhambi zao tena.”","poem":2}]},{"type":"verse","number":35,"content":["Hili ndilo asemalo Bwana,",{"text":"yeye aliyeweka jua","poem":1},{"text":"liwake mchana,","poem":2},{"text":"yeye anayeamuru mwezi na nyota","poem":1},{"text":"kungʼaa usiku,","poem":2},{"text":"yeye aichafuaye bahari","poem":1},{"text":"ili mawimbi yake yangurume;","poem":2},{"lineBreak":true},{"text":"Bwana Mwenye Nguvu Zote ndilo jina lake:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Ikiwa amri hizi zitaondoka machoni pangu,”","poem":1},{"text":"asema Bwana,","poem":2},{"text":"“ndipo wazao wa Israeli watakoma","poem":1},{"text":"kuwa taifa mbele yangu daima.”","poem":2}]},{"type":"verse","number":37,"content":["Hili ndilo asemalo Bwana:",{"text":"“Ikiwa mbingu zilizo juu zitaweza kupimika","poem":1},{"text":"na misingi ya dunia chini","poem":2},{"lineBreak":true},{"text":"ikaweza kuchunguzwa,","poem":2},{"text":"ndipo nitakapowakataa wazao wote wa Israeli","poem":1},{"text":"kwa sababu ya yote waliyoyatenda,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":38,"content":["“Siku zinakuja,” asema Bwana, “wakati mji huu utajengwa upya kwa ajili yangu, kuanzia mnara wa Hananeli hadi Lango la Pembeni."]},{"type":"verse","number":39,"content":["Kamba ya kupimia itaanzia hapo kuendelea hadi kwenye kilima cha Garebu, na kisha kugeuka kuelekea Goa."]},{"type":"verse","number":40,"content":["Bonde lote watupwapo maiti na majivu pia na matuta yote kutoka Bonde la Kidroni upande wa mashariki hadi pembe ya Lango la Farasi, itakuwa takatifu kwa Bwana. Kamwe mji huu hautangʼolewa tena wala kubomolewa.”"]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JER/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/30.json","previousChapterAudioLinks":{},"numberOfVerses":40}