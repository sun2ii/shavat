{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"“Ikiwa utataka kurudi, ee Israeli,","poem":1},{"text":"nirudie mimi,”","poem":2},{"text":"asema Bwana.","poem":4},{"text":"“Ikiwa utaondoa sanamu zako za kuchukiza mbele ya macho yangu","poem":1},{"text":"na usiendelee kutangatanga,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ikiwa kwa kweli, kwa haki na kwa unyofu utaapa,","poem":1},{"text":"‘Kwa hakika kama vile Bwana aishivyo,’","poem":2},{"text":"ndipo mataifa yatakapobarikiwa naye","poem":1},{"text":"na katika yeye watajitukuza.”","poem":2}]},{"type":"verse","number":3,"content":["Hili ndilo asemalo Bwana kwa watu wa Yuda na kwa Yerusalemu:",{"text":"“Vunjeni mabonge kwenye mashamba yenu,","poem":1},{"text":"wala msipande katikati ya miiba.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jitahirini katika Bwana,","poem":1},{"text":"tahirini mioyo yenu,","poem":2},{"text":"enyi wanaume wa Yuda","poem":1},{"text":"na watu wa Yerusalemu,","poem":2},{"text":"la sivyo ghadhabu yangu itatoka kwa nguvu","poem":1},{"text":"na kuwaka kama moto","poem":2},{"text":"kwa sababu ya uovu mliotenda,","poem":1},{"text":"ikiwaka pasipo wa kuizima.","poem":2}]},{"type":"heading","content":["Maafa Kutoka Kaskazini"]},{"type":"verse","number":5,"content":[{"text":"“Tangaza katika Yuda na upige mbiu katika Yerusalemu na kusema:","poem":1},{"text":"‘Piga tarumbeta katika nchi yote!’","poem":2},{"text":"Piga kelele na kusema:","poem":1},{"text":"‘Kusanyikeni pamoja!","poem":2},{"lineBreak":true},{"text":"Tukimbilie katika miji yenye maboma!’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Onyesheni ishara ili kwenda Sayuni!","poem":1},{"text":"Kimbilieni usalama pasipo kuchelewa!","poem":2},{"text":"Kwa kuwa ninaleta maafa kutoka kaskazini,","poem":1},{"text":"maangamizi ya kutisha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Simba ametoka nje ya pango lake,","poem":1},{"text":"mharabu wa mataifa amejipanga.","poem":2},{"text":"Ametoka mahali pake","poem":1},{"text":"ili aangamize nchi yenu.","poem":2},{"text":"Miji yenu itakuwa magofu","poem":1},{"text":"pasipo mtu wa kuishi humo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hivyo vaeni nguo za magunia,","poem":1},{"text":"ombolezeni na kulia kwa huzuni,","poem":2},{"text":"kwa kuwa hasira kali ya Bwana","poem":1},{"text":"haijaondolewa kwetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Katika siku ile,” asema Bwana","poem":1},{"text":"“mfalme na maafisa watakata tamaa,","poem":2},{"text":"makuhani watafadhaika,","poem":1},{"text":"na manabii watashangazwa mno.”","poem":2}]},{"type":"verse","number":10,"content":["Ndipo niliposema, “Aa, Bwana Mwenyezi, umewadanganyaje kabisa watu hawa na Yerusalemu kwa kusema, ‘Mtakuwa na amani,’ wakati upanga uko kwenye koo zetu!”"]},{"type":"verse","number":11,"content":["Wakati huo watu hawa na Yerusalemu wataambiwa, “Upepo wa moto kutoka miinuko iliyo kame katika jangwa unavuma kuelekea watu wangu, lakini sio kupepeta au kutakasa,"]},{"type":"verse","number":12,"content":["upepo wenye nguvu sana kuliko wa kupepeta na kutakasa utakuja kwa amri yangu. Sasa natangaza hukumu zangu dhidi yao.”"]},{"type":"verse","number":13,"content":[{"text":"Tazama! Anakuja kama mawingu,","poem":1},{"text":"magari yake yanakuja kama upepo wa kisulisuli,","poem":2},{"text":"farasi wake wana mbio kuliko tai.","poem":1},{"text":"Ole wetu! Tunaangamia!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ee Yerusalemu, usafishe uovu kutoka moyoni mwako na uokolewe.","poem":1},{"text":"Utaendelea kuficha mawazo mapotovu mpaka lini?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Sauti inatangaza kutoka Dani,","poem":1},{"text":"ikipiga mbiu ya maafa kutoka vilima vya Efraimu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Waambie mataifa jambo hili,","poem":1},{"text":"piga mbiu hii dhidi ya Yerusalemu:","poem":2},{"text":"‘Jeshi la kuzingira linakuja kutoka nchi ya mbali,","poem":1},{"text":"likipiga kelele ya vita dhidi ya miji ya Yuda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wamemzunguka kama watu walindao shamba,","poem":1},{"text":"kwa sababu amefanya uasi dhidi yangu,’ ”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":18,"content":[{"text":"“Mwenendo wako na matendo yako mwenyewe","poem":1},{"text":"yameleta haya juu yako.","poem":2},{"text":"Hii ndiyo adhabu yako.","poem":1},{"text":"Tazama jinsi ilivyo chungu!","poem":2},{"lineBreak":true},{"text":"Tazama jinsi inavyochoma moyo!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee mtima wangu, mtima wangu!","poem":1},{"text":"Ninagaagaa kwa maumivu.","poem":2},{"text":"Ee maumivu makuu ya moyo wangu!","poem":1},{"text":"Moyo wangu umefadhaika ndani yangu,","poem":2},{"lineBreak":true},{"text":"siwezi kunyamaza.","poem":2},{"text":"Kwa sababu nimesikia sauti ya tarumbeta,","poem":1},{"text":"nimesikia kelele ya vita.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Maafa baada ya maafa,","poem":1},{"text":"nchi yote imekuwa magofu.","poem":2},{"text":"Kwa ghafula mahema yangu yameangamizwa,","poem":1},{"text":"makazi yangu kwa muda mfupi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hata lini nitaendelea kuona bendera ya vita","poem":1},{"text":"na kusikia sauti za tarumbeta?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Watu wangu ni wapumbavu,","poem":1},{"text":"hawanijui mimi.","poem":2},{"text":"Ni watoto wasio na akili,","poem":1},{"text":"hawana ufahamu.","poem":2},{"text":"Ni hodari kutenda mabaya,","poem":1},{"text":"hawajui kutenda yaliyo mema.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Niliitazama dunia,","poem":1},{"text":"nayo haikuwa na umbo tena ni tupu;","poem":2},{"text":"niliziangalia mbingu,","poem":1},{"text":"mianga ilikuwa imetoweka.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Niliitazama milima, nayo ilikuwa ikitetemeka,","poem":1},{"text":"vilima vyote vilikuwa vikiyumbayumba.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nilitazama, wala watu hawakuwepo;","poem":1},{"text":"kila ndege wa angani alikuwa ameruka zake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nilitazama, hata nchi iliyokuwa imestawi vizuri imekuwa jangwa,","poem":1},{"text":"miji yake yote ilikuwa magofu","poem":2},{"text":"mbele za Bwana,","poem":1},{"text":"mbele ya hasira yake kali.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Hivi ndivyo Bwana asemavyo:","poem":1},{"text":"“Nchi yote itaharibiwa,","poem":2},{"lineBreak":true},{"text":"ingawa sitaiangamiza kabisa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kwa hiyo dunia itaomboleza","poem":1},{"text":"na mbingu zilizo juu zitakuwa giza,","poem":2},{"text":"kwa sababu nimesema nami sitarudi nyuma,","poem":1},{"text":"nimeamua na wala sitageuka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Kwa sauti ya wapanda farasi na wapiga upinde","poem":1},{"text":"kila mji unakimbia.","poem":2},{"text":"Baadhi wanakimbilia vichakani,","poem":1},{"text":"baadhi wanapanda juu ya miamba.","poem":2},{"text":"Miji yote imeachwa,","poem":1},{"text":"hakuna aishiye ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Unafanya nini, ewe uliyeharibiwa?","poem":1},{"text":"Kwa nini unajivika vazi jekundu","poem":2},{"lineBreak":true},{"text":"na kuvaa vito vya dhahabu?","poem":2},{"text":"Kwa nini unapaka macho yako rangi?","poem":1},{"text":"Unajipamba bure.","poem":2},{"text":"Wapenzi wako wanakudharau,","poem":1},{"text":"wanautafuta uhai wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Nasikia kilio kama cha mwanamke","poem":1},{"text":"katika utungu wa kuzaa,","poem":2},{"text":"kilio cha uchungu kama cha anayemzaa","poem":1},{"text":"mtoto wake wa kwanza:","poem":2},{"text":"kilio cha Binti Sayuni akitweta ili aweze kupumua,","poem":1},{"text":"akiinua mikono yake, akisema,","poem":2},{"text":"“Ole wangu! Ninazimia;","poem":1},{"text":"maisha yangu yamekabidhiwa kwa wauaji.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}