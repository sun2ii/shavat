{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":46,"content":[{"type":"heading","content":["Ujumbe Kuhusu Misri"]},{"type":"verse","number":1,"content":["Hili ni neno la Bwana lililomjia nabii Yeremia kuhusu mataifa:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Kuhusu Misri:",{"lineBreak":true},"Huu ni ujumbe dhidi ya jeshi la Farao Neko mfalme wa Misri, lililoshindwa huko Karkemishi kwenye Mto Frati na Nebukadneza mfalme wa Babeli, katika mwaka wa nne wa utawala wa Yehoyakimu mwana wa Yosia mfalme wa Yuda:"]},{"type":"verse","number":3,"content":[{"text":"“Wekeni tayari ngao zenu, kubwa na ndogo,","poem":1},{"text":"mtoke kwa ajili ya vita!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Fungieni farasi lijamu,","poem":1},{"text":"pandeni farasi!","poem":2},{"text":"Shikeni nafasi zenu","poem":1},{"text":"mkiwa mmevaa chapeo!","poem":2},{"text":"Isugueni mikuki yenu,","poem":1},{"text":"vaeni dirii vifuani!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Je, ninaona nini?","poem":1},{"text":"Wametiwa hofu,","poem":2},{"text":"wanarudi nyuma,","poem":1},{"text":"askari wao wameshindwa.","poem":2},{"text":"Wanakimbia kwa haraka","poem":1},{"text":"pasipo kutazama nyuma,","poem":2},{"lineBreak":true},{"text":"tena kuna hofu kuu kila upande,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":6,"content":[{"text":"Walio wepesi na wenye mbio hawawezi kukimbia,","poem":1},{"text":"wala wenye nguvu hawawezi kutoroka.","poem":2},{"text":"Kaskazini, kando ya Mto Frati,","poem":1},{"text":"wanajikwaa na kuanguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ni nani huyu ajiinuaye kama Mto Naili,","poem":1},{"text":"kama mito yenye maji yanayofanya mawimbi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Misri hujiinua kama Mto Naili,","poem":1},{"text":"kama mito yenye maji yanayofanya mawimbi.","poem":2},{"text":"Husema, ‘Nitainuka na kufunika dunia,","poem":1},{"text":"nitaiangamiza miji na watu wake.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Songeni mbele, enyi farasi!","poem":1},{"text":"Endesheni kwa ukali, enyi magari ya farasi,","poem":2},{"text":"Endeleeni mbele, enyi mashujaa:","poem":1},{"text":"watu wa Kushi","poem":2},{"noteId":21},{"text":"na Putu","poem":2},{"noteId":22},{"text":"wachukuao ngao,","poem":2},{"lineBreak":true},{"text":"watu wa Ludi","poem":2},{"noteId":23},{"text":"wavutao upinde.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini ile siku ni ya Bwana, Bwana Mwenye Nguvu Zote,","poem":1},{"text":"siku ya kulipiza kisasi,","poem":2},{"lineBreak":true},{"text":"kisasi juu ya adui zake.","poem":2},{"text":"Upanga utakula hata utakapotosheka,","poem":1},{"text":"hadi utakapozima kiu yake kwa damu.","poem":2},{"text":"Kwa maana Bwana, Bwana Mwenye Nguvu Zote, atatoa dhabihu","poem":1},{"text":"kwenye nchi ya kaskazini, kando ya Mto Frati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Panda hadi Gileadi ukapate zeri,","poem":1},{"text":"ee Bikira Binti wa Misri.","poem":2},{"text":"Lakini umetumia dawa nyingi bila mafanikio;","poem":1},{"text":"huwezi kupona.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mataifa yatasikia juu ya aibu yako,","poem":1},{"text":"kilio chako kitaijaza dunia.","poem":2},{"text":"Shujaa mmoja atajikwaa juu ya mwingine,","poem":1},{"text":"nao wataanguka chini pamoja.”","poem":2}]},{"type":"verse","number":13,"content":["Huu ndio ujumbe Bwana aliomwambia nabii Yeremia kuhusu kuja kwa Nebukadneza mfalme wa Babeli ili kuishambulia Misri:"]},{"type":"verse","number":14,"content":[{"text":"“Tangaza hili katika Misri, nawe ulihubiri katika Migdoli,","poem":1},{"text":"hubiri pia katika Memfisi","poem":2},{"noteId":24},{"text":"na Tahpanhesi:","poem":2},{"noteId":25},{"text":"‘Shikeni nafasi zenu na mwe tayari,","poem":1},{"text":"kwa kuwa upanga unawala wale wanaokuzunguka.’","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa nini mashujaa wako wamesombwa","poem":1},{"text":"na kupelekwa mbali?","poem":2},{"text":"Hawawezi kusimama, kwa maana Bwana","poem":1},{"text":"atawasukuma awaangushe chini.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Watajikwaa mara kwa mara,","poem":1},{"text":"wataangukiana wao kwa wao.","poem":2},{"text":"Watasema, ‘Amka, turudi","poem":1},{"text":"kwa watu wetu na nchi yetu,","poem":2},{"lineBreak":true},{"text":"mbali na upanga wa mtesi.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Huko watatangaza,","poem":1},{"text":"‘Farao mfalme wa Misri ni makelele tu,","poem":2},{"lineBreak":true},{"text":"amekosa wasaa wake.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Kwa hakika kama niishivyo,” asema Mfalme,","poem":1},{"text":"ambaye jina lake ni Bwana Mwenye Nguvu Zote,","poem":2},{"text":"“mmoja atakuja ambaye ni kama Tabori miongoni mwa milima,","poem":1},{"text":"kama Karmeli kando ya bahari.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Funga mizigo yako kwenda uhamishoni,","poem":1},{"text":"wewe ukaaye Misri,","poem":2},{"text":"kwa kuwa Memfisi utaangamizwa","poem":1},{"text":"na kuwa magofu pasipo mkazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Misri ni mtamba mzuri,","poem":1},{"text":"lakini kipanga anakuja dhidi yake kutoka kaskazini.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Askari wake waliokodiwa katika safu zake","poem":1},{"text":"wako kama ndama walionenepeshwa.","poem":2},{"text":"Wao pia watageuka na kukimbia pamoja,","poem":1},{"text":"hawataweza kuhimili vita,","poem":2},{"text":"kwa maana siku ya msiba inakuja juu yao,","poem":1},{"text":"wakati wao wa kuadhibiwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Misri atatoa sauti kama ya nyoka anayekimbia","poem":1},{"text":"kadiri adui anavyowasogelea na majeshi,","poem":2},{"text":"watakuja dhidi yake wakiwa na mashoka,","poem":1},{"text":"kama watu wakatao miti.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wataufyeka msitu wake,”","poem":1},{"text":"asema Bwana,","poem":4},{"text":"“hata kama umesongamana kiasi gani.","poem":2},{"text":"Ni wengi kuliko nzige,","poem":1},{"text":"hawawezi kuhesabika.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Binti wa Misri ataaibishwa,","poem":1},{"text":"atatiwa mikononi mwa watu wa kaskazini.”","poem":2}]},{"type":"verse","number":25,"content":["Bwana Mwenye Nguvu Zote, Mungu wa Israeli, asema: “Nakaribia kuleta adhabu juu ya Amoni mungu wa Thebesi,",{"noteId":26},"na juu ya Farao, Misri na miungu yake, na wafalme wake, pamoja na wale wanaomtegemea Farao."]},{"type":"verse","number":26,"content":["Nitawatia mikononi mwa wale wanaotafuta uhai wao, yaani Nebukadneza mfalme wa Babeli na maafisa wake. Hatimaye, hata hivyo, Misri itakaliwa kama nyakati zilizopita,” asema Bwana."]},{"type":"verse","number":27,"content":[{"text":"“Usiogope, ee Yakobo mtumishi wangu,","poem":1},{"text":"usifadhaike, ee Israeli.","poem":2},{"text":"Hakika nitakuokoa kutoka nchi za mbali,","poem":1},{"text":"uzao wako kutoka nchi ya uhamisho wao.","poem":2},{"text":"Yakobo atakuwa tena na amani na salama,","poem":1},{"text":"wala hakuna hata mmoja atakayewatia hofu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Usiogope, ee Yakobo mtumishi wangu,","poem":1},{"text":"kwa maana mimi niko pamoja nawe,”","poem":2},{"lineBreak":true},{"text":"asema Bwana.","poem":2},{"text":"“Ingawa nitayaangamiza kabisa mataifa yote","poem":1},{"text":"ambayo miongoni mwake nimekutawanya,","poem":2},{"lineBreak":true},{"text":"sitakuangamiza wewe kabisa.","poem":2},{"text":"Nitakurudi, lakini kwa haki tu,","poem":1},{"text":"wala sitakuacha kabisa bila kukuadhibu.”","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"Kushi ni Naili ya Juu; sasa ni Sudan.","reference":{"chapter":46,"verse":9}},{"noteId":22,"caller":"+","text":"Putu sasa ni Libya.","reference":{"chapter":46,"verse":9}},{"noteId":23,"caller":"+","text":"Nchi iliyo Afrika ya Kaskazini, magharibi ya Mto Naili; sasa ni Libya.","reference":{"chapter":46,"verse":9}},{"noteId":24,"caller":"+","text":"Memfisi kwa Kiebrania ni Nofu.","reference":{"chapter":46,"verse":14}},{"noteId":25,"caller":"+","text":"Ni mji katika Misri.","reference":{"chapter":46,"verse":14}},{"noteId":26,"caller":"+","text":"Thebesi kwa Kiebrania ni No (au No-Amoni), mji katika Misri.","reference":{"chapter":46,"verse":25}}]},"thisChapterLink":"/api/swh_bib/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}