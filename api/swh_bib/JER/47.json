{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Ujumbe Kuhusu Wafilisti"]},{"type":"verse","number":1,"content":["Hili ndilo neno la Bwana lililomjia nabii Yeremia kuhusu Wafilisti, kabla Farao hajaishambulia Gaza:"]},{"type":"verse","number":2,"content":["Hili ndilo asemalo Bwana:",{"text":"“Tazama jinsi maji yanavyoinuka huko kaskazini,","poem":1},{"text":"yatakuwa mafuriko yenye nguvu sana.","poem":2},{"text":"Yataifurikia nchi na vitu vyote vilivyomo ndani yake,","poem":1},{"text":"miji na wale waishio ndani yake.","poem":2},{"text":"Watu watapiga kelele;","poem":1},{"text":"wote waishio katika nchi wataomboleza","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwa sauti ya kwato za farasi waendao mbio,","poem":1},{"text":"kwa sauti ya magari ya adui","poem":2},{"lineBreak":true},{"text":"na mngurumo wa magurudumu yake.","poem":2},{"text":"Baba hawatageuka kuwasaidia watoto wao,","poem":1},{"text":"mikono yao italegea.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa maana siku imewadia","poem":1},{"text":"kuwaangamiza Wafilisti wote","poem":2},{"text":"na kuwakatilia mbali walionusurika wote","poem":1},{"text":"ambao wangeweza kusaidia Tiro na Sidoni.","poem":2},{"text":"Bwana anakaribia kuwaangamiza Wafilisti,","poem":1},{"text":"mabaki toka pwani za Kaftori.","poem":2},{"noteId":27}]},{"type":"verse","number":5,"content":[{"text":"Gaza atanyoa kichwa chake katika kuomboleza,","poem":1},{"text":"Ashkeloni atanyamazishwa.","poem":2},{"text":"Enyi mabaki kwenye tambarare,","poem":1},{"text":"mtajikatakata wenyewe mpaka lini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mnalia, ‘Aa, upanga wa Bwana,","poem":1},{"text":"utaendelea mpaka lini ndipo upumzike?","poem":2},{"text":"Rudi ndani ya ala yako;","poem":1},{"text":"acha na utulie.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lakini upanga utatuliaje","poem":1},{"text":"wakati Bwana ameuamuru,","poem":2},{"text":"wakati ameuagiza kuishambulia Ashkeloni","poem":1},{"text":"pamoja na pwani yake?”","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"Kaftori ndio Krete.","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/swh_bib/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}