{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Ujumbe Kuhusu Moabu"]},{"type":"verse","number":1,"content":["Kuhusu Moabu:",{"lineBreak":true},"Hili ndilo Bwana Mwenye Nguvu Zote, Mungu wa Israeli, asemalo:",{"text":"“Ole wake Nebo, kwa maana utaharibiwa.","poem":1},{"text":"Kiriathaimu utaaibishwa na kutekwa;","poem":2},{"lineBreak":true},{"text":"Misgabu itaaibishwa na kuvunjavunjwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moabu haitasifiwa tena;","poem":1},{"text":"huko Heshboni watu watafanya shauri baya la anguko lake:","poem":2},{"lineBreak":true},{"text":"‘Njooni na tuangamize taifa lile.’","poem":2},{"text":"Wewe nawe, ee Madmena, utanyamazishwa;","poem":1},{"text":"upanga utakufuatia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sikiliza kilio kutoka Horonaimu,","poem":1},{"text":"kilio cha maangamizi makuu na uharibifu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moabu utavunjwa,","poem":1},{"text":"wadogo wake watapiga kelele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wanapanda kwenda njia ya kuelekea Luhithi,","poem":1},{"text":"wakilia kwa uchungu wanapotembea,","poem":2},{"text":"kwenye njia inayoshuka kwenda Horonaimu,","poem":1},{"text":"kilio cha uchungu kwa ajili ya uharibifu kinasikika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kimbieni! Okoeni maisha yenu,","poem":1},{"text":"kuweni kama kichaka jangwani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa kuwa mmetumainia matendo yenu na mali zenu,","poem":1},{"text":"ninyi pia mtachukuliwa mateka,","poem":2},{"text":"naye Kemoshi","poem":1},{"noteId":28},{"text":"atakwenda uhamishoni,","poem":1},{"text":"pamoja na makuhani wake na maafisa wake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mharabu atakuja dhidi ya kila mji,","poem":1},{"text":"wala hakuna mji utakaookoka.","poem":2},{"text":"Bonde litaangamizwa na uwanda utaharibiwa,","poem":1},{"text":"kwa sababu Bwana amesema.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wekeni chumvi kwa ajili ya Moabu,","poem":1},{"text":"kwa kuwa ataangamizwa;","poem":2},{"text":"miji yake itakuwa ukiwa,","poem":1},{"text":"pasipo kuwa na mtu atakayeishi ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Alaaniwe yeye afanyaye kazi ya Bwana kwa hila!","poem":1},{"text":"Alaaniwe yeye auzuiaye upanga wake usimwage damu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Moabu amestarehe tangu ujana wake,","poem":1},{"text":"kama divai iliyoachwa kwenye machujo yake,","poem":2},{"text":"haikumiminwa kutoka chombo kimoja hadi kingine,","poem":1},{"text":"hajaenda uhamishoni.","poem":2},{"text":"Kwa hiyo ana ladha ile ile kama aliyokuwa nayo,","poem":1},{"text":"nayo harufu yake haijabadilika.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini siku zinakuja,”","poem":1},{"text":"asema Bwana,","poem":2},{"text":"“nitakapotuma watu wamiminao kutoka kwenye magudulia,","poem":1},{"text":"nao watamimina;","poem":2},{"text":"wataacha magudulia yake yakiwa matupu","poem":1},{"text":"na kuvunja mitungi yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kisha Moabu atamwonea aibu mungu wao Kemoshi,","poem":1},{"text":"kama vile nyumba ya Israeli walivyoona aibu","poem":2},{"lineBreak":true},{"text":"walipotegemea mungu wa Betheli.","poem":2},{"noteId":29}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mwawezaje kusema, ‘Sisi ni mashujaa,","poem":1},{"text":"watu jasiri katika vita’?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moabu ataangamizwa na miji yake itavamiwa,","poem":1},{"text":"vijana wake waume walio bora sana watachinjwa,”","poem":2},{"text":"asema Mfalme, ambaye jina lake","poem":1},{"text":"ni Bwana Mungu Mwenye Nguvu Zote.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Kuanguka kwa Moabu kumekaribia,","poem":1},{"text":"janga kubwa litamjia kwa haraka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ombolezeni kwa ajili yake, ninyi nyote mnaomzunguka,","poem":1},{"text":"ninyi nyote mnaojua sifa zake,","poem":2},{"text":"semeni, ‘Tazama jinsi ilivyovunjika fimbo ya kifalme yenye nguvu,","poem":1},{"text":"tazama jinsi ilivyovunjika fimbo iliyotukuka!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Shuka kutoka fahari yako","poem":1},{"text":"na uketi katika ardhi iliyokauka,","poem":2},{"lineBreak":true},{"text":"enyi wenyeji wa Binti wa Diboni,","poem":2},{"text":"kwa maana yeye aangamizaye Moabu atakuja dhidi yako,","poem":1},{"text":"na kuangamiza miji yako iliyozungushiwa maboma.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Simama kando ya barabara na utazame,","poem":1},{"text":"wewe unayeishi Aroeri.","poem":2},{"text":"Muulize mwanaume anayekimbia","poem":1},{"text":"na mwanamke anayetoroka,","poem":2},{"lineBreak":true},{"text":"waulize, ‘Kumetokea nini?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moabu amefedheheshwa, kwa kuwa amevunjavunjwa.","poem":1},{"text":"Lieni kwa huzuni na kupiga kelele!","poem":2},{"text":"Tangazeni kando ya Arnoni","poem":1},{"text":"kwamba Moabu ameangamizwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hukumu imefika kwenye uwanda wa juu:","poem":1},{"text":"katika Holoni, Yahasa na Mefaathi,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"katika Diboni, Nebo","poem":1},{"text":"na Beth-Diblathaimu,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"katika Kiriathaimu, Beth-Gamuli","poem":1},{"text":"na Beth-Meoni,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"katika Keriothi na Bosra;","poem":1},{"text":"kwa miji yote ya Moabu,","poem":2},{"lineBreak":true},{"text":"iliyoko mbali na karibu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pembe","poem":1},{"noteId":30},{"text":"ya Moabu imekatwa,","poem":1},{"text":"mkono wake umevunjwa,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Mlevye,","poem":1},{"text":"kwa kuwa amemdharau Bwana.","poem":2},{"text":"Moabu na agaegae katika matapishi yake,","poem":1},{"text":"yeye na awe kitu cha dhihaka.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Je, Israeli hakuwa kitu chako cha kudhihakiwa?","poem":1},{"text":"Je, alikamatwa miongoni mwa wezi,","poem":2},{"text":"kiasi cha kutikisa kichwa chako kwa dharau","poem":1},{"text":"kila mara unapozungumza juu yake?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ondokeni kwenye miji yenu, mkaishi katikati ya miamba,","poem":1},{"text":"enyi mnaoishi Moabu.","poem":2},{"text":"Kuweni kama huwa ambaye hutengeneza kiota chake","poem":1},{"text":"kwenye mdomo wa pango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Tumesikia juu ya kiburi cha Moabu:","poem":1},{"text":"kutakabari kwake kwa kiburi na majivuno,","poem":2},{"text":"kiburi chake na ufidhuli wake,","poem":1},{"text":"na kujivuna kwa moyo wake.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ninaujua ujeuri wake, lakini ni bure,”","poem":1},{"text":"asema Bwana,","poem":4},{"text":"“nako kujisifu kwake hakumsaidii chochote.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kwa hiyo namlilia Moabu,","poem":1},{"text":"kwa ajili ya Moabu yote ninalia,","poem":2},{"text":"ninaomboleza kwa ajili","poem":1},{"text":"ya watu wa Kir-Haresethi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ninalia machozi kwa ajili yenu, kama Yazeri aliavyo,","poem":1},{"text":"enyi mizabibu ya Sibma.","poem":2},{"text":"Matawi yako yameenea hadi baharini;","poem":1},{"text":"yamefika hadi bahari ya Yazeri.","poem":2},{"text":"Mharabu ameyaangukia matunda yako yaliyoiva","poem":1},{"text":"na mizabibu yako iliyoiva.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Shangwe na furaha vimetoweka","poem":1},{"text":"kutoka bustani na mashamba ya Moabu.","poem":2},{"text":"Nimekomesha kutiririka kwa divai kutoka mashinikizo;","poem":1},{"text":"hakuna hata mmoja ayakanyagaye kwa kelele za shangwe.","poem":2},{"text":"Ingawa kuna kelele,","poem":1},{"text":"sio kelele za shangwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Sauti ya kilio chao inapanda","poem":1},{"text":"kutoka Heshboni hadi Eleale na Yahazi,","poem":2},{"text":"kutoka Soari hadi Horonaimu na Eglath-Shelishiya,","poem":1},{"text":"kwa kuwa hata maji ya Nimrimu yamekauka.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nitakomesha wale wote katika Moabu","poem":1},{"text":"watoao sadaka mahali pa juu,","poem":2},{"lineBreak":true},{"text":"na kufukiza uvumba kwa miungu yao,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":36,"content":[{"text":"“Kwa hiyo moyo wangu unaomboleza kwa ajili ya Moabu kama filimbi;","poem":1},{"text":"unaomboleza kama filimbi kwa ajili ya watu wa Kir-Haresethi.","poem":2},{"lineBreak":true},{"text":"Utajiri waliojipatia umetoweka.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Kila kichwa kimenyolewa","poem":1},{"text":"na kila mwenye ndevu zimekatwa;","poem":2},{"text":"kila mkono umekatwa","poem":1},{"text":"na kila kiuno kimefunikwa kwa nguo ya gunia.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Juu ya mapaa yote katika Moabu","poem":1},{"text":"na katika viwanja","poem":2},{"text":"hakuna kitu chochote isipokuwa maombolezo,","poem":1},{"text":"kwa kuwa nimemvunja Moabu","poem":2},{"lineBreak":true},{"text":"kama gudulia ambalo hakuna mtu yeyote anayelitaka,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":39,"content":[{"text":"“Tazama jinsi alivyovunjikavunjika!","poem":1},{"text":"Jinsi wanavyolia kwa huzuni!","poem":2},{"text":"Tazama jinsi Moabu anavyogeuka kwa aibu!","poem":1},{"text":"Moabu amekuwa kitu cha kudhihakiwa,","poem":2},{"text":"kitu cha kutisha kwa wale wote","poem":1},{"text":"wanaomzunguka.”","poem":2}]},{"type":"verse","number":40,"content":["Hili ndilo asemalo Bwana:",{"text":"“Tazama! Tai anashuka chini,","poem":1},{"text":"akitanda mabawa yake juu ya Moabu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Miji itatekwa na ngome zake","poem":1},{"text":"zitatwaliwa.","poem":2},{"text":"Katika siku hiyo, mioyo ya mashujaa wa Moabu","poem":1},{"text":"itakuwa kama moyo wa mwanamke katika utungu wa kuzaa.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Moabu ataangamizwa kama taifa","poem":1},{"text":"kwa sababu amemdharau Bwana.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Hofu kuu, shimo na mtego vinawangojea,","poem":1},{"text":"enyi watu wa Moabu,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":44,"content":[{"text":"“Yeyote atakayeikimbia hiyo hofu kuu","poem":1},{"text":"ataanguka ndani ya shimo,","poem":2},{"text":"yeyote atakayepanda kutoka shimoni,","poem":1},{"text":"atanaswa katika mtego,","poem":2},{"text":"kwa sababu nitaletea Moabu","poem":1},{"text":"mwaka wa adhabu yake,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Katika kivuli cha Heshboni,","poem":1},{"text":"wakimbizi wamesimama pasipo msaada,","poem":2},{"text":"kwa kuwa moto umezimika huko Heshboni,","poem":1},{"text":"mwali wa moto kutoka katikati ya Sihoni;","poem":2},{"text":"unaunguza vipaji vya nyuso za Moabu,","poem":1},{"text":"mafuvu yao wenye kujivuna kwa kelele.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ole wako, ee Moabu!","poem":1},{"text":"Watu wa Kemoshi wameangamizwa;","poem":2},{"text":"wana wako wamepelekwa uhamishoni","poem":1},{"text":"na binti zako wamechukuliwa mateka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Lakini nitarudisha mateka wa Moabu,","poem":1},{"text":"katika siku zijazo,”","poem":2},{"text":"asema Bwana.","poem":4},"Huu ndio mwisho wa hukumu juu ya Moabu."]}],"footnotes":[{"noteId":28,"caller":"+","text":"Kemoshi alikuwa mungu wa Wamoabu.","reference":{"chapter":48,"verse":7}},{"noteId":29,"caller":"+","text":"Betheli ina maana ya Nyumba ya Mungu; lakini pia ni mahali ambapo Mfalme Yeroboamu alisimamisha moja ya sanamu za ndama ili kuabudiwa; nyingine aliiweka huko Dani (1Fal 12:29-33).","reference":{"chapter":48,"verse":13}},{"noteId":30,"caller":"+","text":"Pembe hapa ni ishara ya nguvu.","reference":{"chapter":48,"verse":25}}]},"thisChapterLink":"/api/swh_bib/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}