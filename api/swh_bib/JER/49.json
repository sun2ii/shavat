{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["Ujumbe Kuhusu Amoni"]},{"type":"verse","number":1,"content":["Kuhusu Waamoni:",{"lineBreak":true},"Hili ndilo asemalo Bwana:",{"text":"“Je, Israeli hana wana?","poem":1},{"text":"Je, hana warithi?","poem":2},{"text":"Kwa nini basi Moleki amechukua milki ya Gadi?","poem":1},{"text":"Kwa nini watu wake wanaishi katika miji yake?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lakini siku zinakuja,”","poem":1},{"text":"asema Bwana,","poem":2},{"text":"“nitakapopiga kelele ya vita","poem":1},{"text":"dhidi ya Raba mji wa Waamoni;","poem":2},{"text":"utakuwa kilima cha magofu,","poem":1},{"text":"navyo vijiji vinavyouzunguka","poem":2},{"lineBreak":true},{"text":"vitateketezwa kwa moto.","poem":2},{"text":"Kisha Israeli atawafukuza","poem":1},{"text":"wale waliomfukuza,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":3,"content":[{"text":"“Lia kwa huzuni, ee Heshboni, kwa kuwa Ai umeangamizwa!","poem":1},{"text":"Pigeni kelele, enyi wakazi wa Raba!","poem":2},{"text":"Vaeni nguo za gunia na kuomboleza,","poem":1},{"text":"kimbieni hapa na pale ndani ya kuta,","poem":2},{"text":"kwa kuwa Moleki atakwenda uhamishoni,","poem":1},{"text":"yeye pamoja na makuhani na maafisa wake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa nini unajivunia mabonde yako,","poem":1},{"text":"kujivunia mabonde yako yaliyozaa sana?","poem":2},{"text":"Ee binti usiye mwaminifu, unayeutumainia utajiri wako na kusema,","poem":1},{"text":"‘Ni nani atakayenishambulia?’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nitaleta hofu kuu juu yako","poem":1},{"text":"kutoka kwa wale wote wanaokuzunguka,”","poem":2},{"text":"asema Bwana, Bwana Mwenye Nguvu Zote.","poem":4},{"text":"“Kila mmoja wenu ataondolewa,","poem":1},{"text":"wala hakuna hata mmoja atakayekusanya wakimbizi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Lakini hatimaye,","poem":1},{"text":"nitarudisha mateka wa Waamoni,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"heading","content":["Ujumbe Kuhusu Edomu"]},{"type":"verse","number":7,"content":["Kuhusu Edomu:",{"lineBreak":true},"Hili ndilo asemalo Bwana Mwenye Nguvu Zote:",{"text":"“Je, hakuna tena hekima katika Temani?","poem":1},{"text":"Je, shauri limewapotea wenye busara?","poem":2},{"lineBreak":true},{"text":"Je, hekima yao imechakaa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Geuka na ukimbie, jifiche katika mapango marefu kabisa,","poem":1},{"text":"wewe uishiye Dedani,","poem":2},{"text":"kwa kuwa nitaleta maafa juu ya Esau","poem":1},{"text":"wakati nitakapomwadhibu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, kama wachuma zabibu wangekuja kwako,","poem":1},{"text":"wasingebakiza zabibu chache?","poem":2},{"text":"Kama wezi wangekujia usiku,","poem":1},{"text":"je, si wangeiba tu kiasi ambacho wangehitaji?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini nitamvua Esau nguo abaki uchi,","poem":1},{"text":"nitayafunua maficho yake,","poem":2},{"lineBreak":true},{"text":"ili asiweze kujificha.","poem":2},{"text":"Watoto wake, jamaa na majirani wataangamia,","poem":1},{"text":"naye hatakuwepo tena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Waache yatima wako; nitayalinda maisha yao.","poem":1},{"lineBreak":true},{"text":"Wajane wako pia","poem":1},{"text":"wanaweza kunitumaini mimi.”","poem":2}]},{"type":"verse","number":12,"content":["Hili ndilo asemalo Bwana: “Kama wale wasiostahili kukinywea kikombe ni lazima wakinywe, kwa nini wewe usiadhibiwe? Hutakwepa kuadhibiwa, ni lazima ukinywe."]},{"type":"verse","number":13,"content":["Ninaapa kwa nafsi yangu,” asema Bwana, “kwamba Bosra utakuwa magofu na kitu cha kutisha, cha aibu na cha kulaania; miji yake yote itakuwa magofu milele.”"]},{"type":"verse","number":14,"content":[{"text":"Nimesikia ujumbe kutoka kwa Bwana:","poem":1},{"text":"Mjumbe alitumwa kwa mataifa kusema,","poem":2},{"text":"“Jikusanyeni ili kuushambulia!","poem":1},{"text":"Inukeni kwa ajili ya vita!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Sasa nitakufanya uwe mdogo miongoni mwa mataifa,","poem":1},{"text":"aliyedharauliwa miongoni mwa watu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Vitisho vyako na kiburi cha moyo wako","poem":1},{"text":"vimekudanganya,","poem":2},{"text":"wewe unayeishi katika majabali ya miamba,","poem":1},{"text":"wewe unayedumu katika miinuko ya kilima.","poem":2},{"text":"Ujapojenga kiota chako juu sana kama cha tai,","poem":1},{"text":"nitakushusha chini kutoka huko,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":17,"content":[{"text":"“Edomu atakuwa kitu cha kuogofya;","poem":1},{"text":"wote wapitao karibu","poem":2},{"text":"watashangaa na kuzomea","poem":1},{"text":"kwa sababu ya majeraha yake yote.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kama vile Sodoma na Gomora zilivyoangamizwa,","poem":1},{"text":"pamoja na miji iliyokuwa jirani nayo,”","poem":2},{"text":"asema Bwana,","poem":4},{"text":"“vivyo hivyo hakuna mtu yeyote atakayeishi humo.","poem":1},{"text":"Naam, hakuna mtu yeyote atakayekaa humo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Kama simba anayepanda kutoka vichaka vya Yordani","poem":1},{"text":"kuja kwenye nchi ya malisho mengi,","poem":2},{"text":"ndivyo nitamfukuza Edomu kutoka nchi yake ghafula.","poem":1},{"text":"Ni nani aliye mteule nitakayemweka kwa ajili ya jambo hili?","poem":2},{"text":"Ni nani aliye kama mimi,","poem":1},{"text":"na ni nani awezaye kunipinga?","poem":2},{"text":"Tena ni mchungaji yupi awezaye","poem":1},{"text":"kusimama kinyume nami?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kwa hiyo, sikia kile Bwana alichokipanga dhidi ya Edomu,","poem":1},{"text":"kile alichokusudia dhidi ya wale waishio Temani:","poem":2},{"text":"Aliye mchanga katika kundi ataburutwa mbali;","poem":1},{"text":"yeye ataharibu kabisa malisho yao kwa sababu yao.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwa sauti ya anguko lao, dunia itatetemeka.","poem":1},{"text":"Kilio chao kitasikika hadi Bahari ya Shamu.","poem":2},{"noteId":31}]},{"type":"verse","number":22,"content":[{"text":"Tazama! Tai atapaa juu angani na kuruka chini kwa ghafula,","poem":1},{"text":"akitandaza mabawa yake juu ya Bosra.","poem":2},{"text":"Katika siku hiyo, mioyo ya mashujaa wa Edomu","poem":1},{"text":"itakuwa kama moyo wa mwanamke katika utungu wa kuzaa.","poem":2}]},{"type":"heading","content":["Ujumbe Kuhusu Dameski"]},{"type":"verse","number":23,"content":["Kuhusu Dameski:",{"text":"“Hamathi na Arpadi imetahayarika,","poem":1},{"text":"kwa kuwa wamesikia habari mbaya.","poem":2},{"text":"Wamevunjika moyo na wametaabika","poem":1},{"text":"kama bahari iliyochafuka.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Dameski amedhoofika,","poem":1},{"text":"amegeuka na kukimbia,","poem":2},{"lineBreak":true},{"text":"hofu ya ghafula imemkamata sana;","poem":2},{"text":"amepatwa na uchungu na maumivu,","poem":1},{"text":"maumivu kama ya mwanamke katika utungu wa kuzaa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kwa nini mji ambao unajulikana haujaachwa,","poem":1},{"text":"mji ambao ninaupenda?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hakika, vijana wake wanaume wataanguka barabarani;","poem":1},{"text":"askari wake wote watanyamazishwa siku hiyo,”","poem":2},{"text":"asema Bwana Mwenye Nguvu Zote.","poem":4}]},{"type":"verse","number":27,"content":[{"text":"“Nitatia moto kuta za Dameski;","poem":1},{"text":"utaangamiza ngome za Ben-Hadadi.”","poem":2}]},{"type":"heading","content":["Ujumbe Kuhusu Kedari Na Hazori"]},{"type":"verse","number":28,"content":["Kuhusu Kedari na falme za Hazori, ambazo Nebukadneza mfalme wa Babeli alizishambulia:",{"lineBreak":true},"Hili ndilo asemalo Bwana:",{"text":"“Inuka, ushambulie Kedari","poem":1},{"text":"na kuwaangamiza watu wa mashariki.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hema zao na makundi yao ya kondoo yatachukuliwa;","poem":1},{"text":"vibanda vyao vitatwaliwa","poem":2},{"lineBreak":true},{"text":"pamoja na mali zao zote na ngamia zao.","poem":2},{"text":"Watu watawapigia kelele,","poem":1},{"text":"‘Hofu kuu iko kila upande!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Kimbieni haraka!","poem":1},{"text":"Kaeni kwenye mapango marefu sana, ninyi mkaao Hazori,”","poem":2},{"text":"asema Bwana.","poem":4},{"text":"“Nebukadneza, mfalme wa Babeli amepanga shauri baya dhidi yenu;","poem":2},{"lineBreak":true},{"text":"amebuni hila dhidi yenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Inuka na ulishambulie taifa lililo starehe,","poem":1},{"text":"linaloishi kwa kujiamini,”","poem":2},{"text":"asema Bwana,","poem":4},{"text":"“taifa lisilo na malango wala makomeo;","poem":1},{"text":"watu wake huishi peke yao.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ngamia wao watakuwa nyara,","poem":1},{"text":"nayo makundi yao makubwa ya ngʼombe yatatekwa.","poem":2},{"text":"Wale walio maeneo ya mbali","poem":1},{"text":"nitawatawanya pande zote,","poem":2},{"text":"nami nitaleta maafa juu yao","poem":1},{"text":"kutoka kila upande,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":33,"content":[{"text":"“Hazori itakuwa makao ya mbweha,","poem":1},{"text":"mahali pa ukiwa milele.","poem":2},{"text":"Hakuna yeyote atakayeishi humo;","poem":1},{"text":"hakuna mtu atakayekaa ndani yake.”","poem":2}]},{"type":"heading","content":["Ujumbe Kuhusu Elamu"]},{"type":"verse","number":34,"content":["Hili ndilo neno la Bwana lililomjia nabii Yeremia kuhusu Elamu, mapema katika utawala wa Sedekia mfalme wa Yuda:"]},{"type":"line_break"},{"type":"verse","number":35,"content":["Hili ndilo Bwana Mwenye Nguvu Zote asemalo:",{"text":"“Tazama, nitavunja upinde wa Elamu,","poem":1},{"text":"ulio tegemeo la nguvu zao.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Nitaleta pepo nne dhidi ya Elamu","poem":1},{"text":"toka pande nne za mbingu,","poem":2},{"text":"nitawatawanya katika hizo pande nne,","poem":1},{"text":"wala hapatakuwa na taifa","poem":2},{"text":"ambalo watu wa Elamu waliofukuzwa","poem":1},{"text":"hawatakwenda.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Nitamfadhaisha Elamu mbele ya adui zao,","poem":1},{"text":"mbele yao wale wanaotafuta uhai wao;","poem":2},{"text":"nitaleta maafa juu yao,","poem":1},{"text":"naam, hasira yangu kali,”","poem":2},{"text":"asema Bwana.","poem":4},{"text":"“Nitawafuatia kwa upanga","poem":1},{"text":"mpaka nitakapowamaliza.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Nitaweka kiti changu cha enzi huko Elamu","poem":1},{"text":"na kumwangamiza mfalme wake na maafisa wake,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Lakini nitarudisha mateka wa Elamu","poem":1},{"text":"katika siku zijazo,”","poem":2},{"text":"asema Bwana.","poem":4}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Kwa Kiebrania ni Bahari ya Mafunjo.","reference":{"chapter":49,"verse":21}}]},"thisChapterLink":"/api/swh_bib/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}