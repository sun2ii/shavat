{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["Hakuna Hata Mmoja Aliye Mkamilifu"]},{"type":"verse","number":1,"content":[{"text":"“Pandeni na kushuka katika mitaa ya Yerusalemu,","poem":1},{"text":"tazameni pande zote na mtafakari,","poem":2},{"lineBreak":true},{"text":"tafuteni katika viwanja vyake.","poem":2},{"text":"Kama mtaweza kumpata hata mtu mmoja tu","poem":1},{"text":"atendaye kwa uaminifu na kutafuta kweli,","poem":2},{"lineBreak":true},{"text":"nitausamehe mji huu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ingawa wanasema, ‘Kwa hakika kama Bwana aishivyo,’","poem":1},{"text":"bado wanaapa kwa uongo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Bwana, je, macho yako hayaitafuti kweli?","poem":1},{"text":"Uliwapiga, lakini hawakusikia maumivu,","poem":2},{"lineBreak":true},{"text":"uliwapondaponda, lakini walikataa maonyo.","poem":2},{"text":"Walifanya nyuso zao kuwa ngumu kuliko jiwe","poem":1},{"text":"nao walikataa kutubu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo nikasema, “Hawa ni maskini tu;","poem":1},{"text":"wao ni wapumbavu,","poem":2},{"text":"kwa maana hawaijui njia ya Bwana,","poem":1},{"text":"sheria ya Mungu wao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa hiyo nitakwenda kwa viongozi","poem":1},{"text":"na kuzungumza nao,","poem":2},{"text":"hakika wao wanaijua njia ya Bwana,","poem":1},{"text":"sheria ya Mungu wao.”","poem":2},{"text":"Lakini kwa nia moja nao pia walikuwa wameivunja nira","poem":1},{"text":"na kuvivunja vifungo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa hiyo simba kutoka mwituni atawashambulia,","poem":1},{"text":"mbwa mwitu kutoka jangwani atawaangamiza,","poem":2},{"text":"chui atawavizia karibu na miji yao,","poem":1},{"text":"ili kumrarua vipande vipande yeyote atakayethubutu kutoka nje,","poem":2},{"text":"kwa maana maasi yao ni makubwa,","poem":1},{"text":"na kukengeuka kwao kumekuwa ni kwingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kwa nini niwasamehe?","poem":1},{"text":"Watoto wenu wameniacha na kuapa kwa miungu ambayo si miungu.","poem":2},{"text":"Niliwapatia mahitaji yao yote,","poem":1},{"text":"lakini bado wamefanya uzinzi na kusongana katika nyumba za makahaba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wamelishwa vizuri, kama farasi waume wenye tamaa nyingi,","poem":1},{"text":"kila mmoja akimlilia mke wa mwanaume mwingine.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, nisiwaadhibu kwa ajili ya hili?”","poem":1},{"text":"asema Bwana.","poem":2},{"text":"“Je, nisijilipizie kisasi","poem":1},{"text":"juu ya taifa kama hili?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Piteni katika mashamba yake ya mizabibu na kuyaharibu,","poem":1},{"text":"lakini msiangamize kabisa.","poem":2},{"text":"Pogoeni matawi yake,","poem":1},{"text":"kwa kuwa watu hawa sio wa Bwana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nyumba ya Israeli na nyumba ya Yuda","poem":1},{"text":"wamekuwa si waaminifu kwangu kamwe,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wamedanganya kuhusu Bwana.","poem":1},{"text":"Wamesema, “Yeye hatafanya jambo lolote!","poem":2},{"text":"Hakuna dhara litakalotupata;","poem":1},{"text":"kamwe hatutaona upanga wala njaa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Manabii ni upepo tu, wala neno halimo ndani yao,","poem":1},{"text":"kwa hiyo hayo wayasemayo na yatendeke kwao.”","poem":2}]},{"type":"verse","number":14,"content":["Kwa hiyo hili ndilo asemalo Bwana Mungu Mwenye Nguvu Zote:",{"text":"“Kwa sababu watu hawa wamesema maneno haya,","poem":1},{"text":"nitayafanya maneno yangu vinywani mwenu kuwa moto,","poem":2},{"text":"na watu hawa wawe kuni","poem":1},{"text":"zinazoliwa na huo moto.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ee nyumba ya Israeli,” asema Bwana,","poem":1},{"text":"“Ninaleta taifa toka mbali dhidi yako,","poem":2},{"text":"taifa la kale na linaloendelea kudumu,","poem":1},{"text":"taifa ambalo lugha yao huijui,","poem":2},{"lineBreak":true},{"text":"wala msemo wao huwezi kuuelewa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Podo zao ni kama kaburi lililo wazi,","poem":1},{"text":"wote ni mashujaa hodari wa vita.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Watayaangamiza mazao yenu na chakula chenu,","poem":1},{"text":"wataangamiza wana wenu na mabinti zenu;","poem":2},{"text":"wataangamiza makundi yenu ya kondoo na ya ngʼombe,","poem":1},{"text":"wataangamiza mizabibu yenu na mitini yenu.","poem":2},{"text":"Kwa upanga wataangamiza","poem":1},{"text":"miji yenye maboma mliyoitumainia.","poem":2}]},{"type":"verse","number":18,"content":["“Hata hivyo katika siku hizo, sitakuangamiza kabisa,” asema Bwana."]},{"type":"verse","number":19,"content":["“Nao watu watakapouliza, ‘Kwa nini Bwana, Mungu wetu ametufanyia mambo haya yote?’ utawaambia, ‘Kama vile mlivyoniacha mimi na kutumikia miungu migeni katika nchi yenu wenyewe, ndivyo sasa mtakavyowatumikia wageni katika nchi ambayo si yenu.’"]},{"type":"verse","number":20,"content":[{"text":"“Itangazie nyumba ya Yakobo hili","poem":1},{"text":"na ulipigie mbiu katika Yuda:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sikieni hili, enyi watu wapumbavu, msio na akili,","poem":1},{"text":"mlio na macho lakini hamwoni,","poem":2},{"lineBreak":true},{"text":"mlio na masikio lakini hamsikii:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Je, haiwapasi kuniogopa mimi?” asema Bwana.","poem":1},{"text":"“Je, haiwapasi kutetemeka mbele zangu?","poem":2},{"text":"Niliufanya mchanga kuwa mpaka wa bahari,","poem":1},{"text":"kizuizi cha milele ambacho haiwezi kupita.","poem":2},{"text":"Mawimbi yanaweza kuumuka, lakini hayawezi kuupita;","poem":1},{"text":"yanaweza kunguruma, lakini hayawezi kuuvuka.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lakini watu hawa wana mioyo ya ukaidi na ya uasi,","poem":1},{"text":"wamegeukia mbali na kwenda zao.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wao hawaambiani wenyewe,","poem":1},{"text":"‘Sisi na tumwogope Bwana Mungu wetu,","poem":2},{"text":"anayetupatia mvua za masika na za vuli kwa majira yake,","poem":1},{"text":"anayetuhakikishia majuma ya mavuno kwa utaratibu.’","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Matendo yenu mabaya yamezuia haya yote,","poem":1},{"text":"dhambi zenu zimewazuia msipate mema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Miongoni mwa watu wangu wamo walio waovu","poem":1},{"text":"wanaovizia kama watu wanaotega ndege,","poem":2},{"text":"na kama wale wanaoweka mitego","poem":1},{"text":"kuwakamata watu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kama vitundu vilivyojaa ndege,","poem":1},{"text":"nyumba zao zimejaa udanganyifu;","poem":2},{"text":"wamekuwa matajiri na wenye nguvu,","poem":1}]},{"type":"verse","number":28,"content":[{"text":"wamenenepa na kunawiri.","poem":2},{"text":"Matendo yao maovu hayana kikomo;","poem":1},{"text":"hawatetei mashauri ya yatima wapate kushinda,","poem":2},{"lineBreak":true},{"text":"hawatetei haki za maskini.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Je, nisiwaadhibu kwa ajili ya hili?”","poem":1},{"text":"asema Bwana.","poem":2},{"text":"“Je, nisijilipizie kisasi","poem":1},{"text":"juu ya taifa kama hili?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Jambo la kutisha na kushtusha","poem":1},{"text":"limetokea katika nchi hii:","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Manabii wanatabiri uongo,","poem":1},{"text":"makuhani wanatawala kwa mamlaka yao wenyewe,","poem":2},{"text":"nao watu wangu wanapenda hivyo.","poem":1},{"text":"Lakini mtafanya nini mwisho wake?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}