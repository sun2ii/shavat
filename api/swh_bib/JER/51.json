{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["Hili ndilo asemalo Bwana:",{"text":"“Tazama nitaamsha roho ya mwangamizi","poem":1},{"text":"dhidi ya Babeli na watu wakaao Leb-Kamai.","poem":2},{"noteId":32}]},{"type":"verse","number":2,"content":[{"text":"Nitawatuma wageni Babeli","poem":1},{"text":"kumpepeta na kuiharibu nchi yake;","poem":2},{"text":"watampinga kila upande","poem":1},{"text":"katika siku ya maafa yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usimwache mpiga upinde afunge kamba upinde wake,","poem":1},{"text":"wala usimwache avae silaha zake.","poem":2},{"text":"Usiwaonee huruma vijana wake;","poem":1},{"text":"angamiza jeshi lake kabisa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wataanguka waliouawa katika Babeli,","poem":1},{"text":"wakiwa na majeraha ya kutisha barabarani zake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa maana Israeli na Yuda hawajaachwa","poem":1},{"text":"na Mungu wao, Bwana Mwenye Nguvu Zote,","poem":2},{"text":"ingawa nchi yao imejaa uovu","poem":1},{"text":"mbele zake yeye Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Kimbieni kutoka Babeli!","poem":1},{"text":"Okoeni maisha yenu!","poem":2},{"lineBreak":true},{"text":"Msiangamizwe kwa sababu ya dhambi zake.","poem":2},{"text":"Ni wakati wa kisasi cha Bwana,","poem":1},{"text":"atamlipa kile anachostahili.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Babeli alikuwa kikombe cha dhahabu katika mkono wa Bwana;","poem":1},{"text":"aliufanya ulimwengu wote ulewe.","poem":2},{"text":"Mataifa walikunywa mvinyo wake;","poem":1},{"text":"kwa hiyo sasa wameingiwa na wazimu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Babeli ataanguka ghafula na kuvunjika.","poem":1},{"text":"Mwombolezeni!","poem":2},{"text":"Tafuteni zeri ya kutuliza maumivu yake,","poem":1},{"text":"labda anaweza kupona.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘Tungemponya Babeli,","poem":1},{"text":"lakini hawezi kuponyeka;","poem":2},{"text":"tumwacheni, na kila mmoja wetu aende nchi yake mwenyewe,","poem":1},{"text":"kwa kuwa hukumu yake inafika angani,","poem":2},{"lineBreak":true},{"text":"inapanda juu hadi mawinguni.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Bwana amethibitisha haki yetu;","poem":1},{"text":"njooni, tutangaze katika Sayuni","poem":2},{"lineBreak":true},{"text":"kitu ambacho Bwana Mungu wetu amefanya.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Noeni mishale,","poem":1},{"text":"chukueni ngao!","poem":2},{"text":"Bwana amewaamsha wafalme wa Wamedi,","poem":1},{"text":"kwa sababu nia yake ni kuangamiza Babeli.","poem":2},{"text":"Bwana atalipiza kisasi,","poem":1},{"text":"kisasi kwa ajili ya Hekalu lake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Twekeni bendera juu ya kuta za Babeli!","poem":1},{"text":"Imarisheni ulinzi,","poem":2},{"text":"wekeni walinzi,","poem":1},{"text":"andaeni waviziao!","poem":2},{"text":"Bwana atatimiza kusudi lake,","poem":1},{"text":"amri yake juu ya watu wa Babeli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wewe uishiye kando ya maji mengi","poem":1},{"text":"na uliye na wingi wa hazina,","poem":2},{"text":"mwisho wako umekuja,","poem":1},{"text":"wakati wako wa kukatiliwa mbali.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bwana Mwenye Nguvu Zote","poem":1},{"text":"ameapa kwa nafsi yake mwenyewe:","poem":2},{"text":"‘Hakika nitakujaza na watu, kama kundi la nzige,","poem":1},{"text":"nao watapiga kelele za ushindi juu yako.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Aliiumba dunia kwa uweza wake;","poem":1},{"text":"akaweka misingi ya ulimwengu kwa hekima yake","poem":2},{"lineBreak":true},{"text":"na akazitandaza mbingu kwa ufahamu wake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Atoapo sauti yake, maji yaliyo katika mbingu hunguruma,","poem":1},{"text":"huyafanya mawingu yainuke kutoka miisho ya dunia.","poem":2},{"text":"Hupeleka umeme wa radi pamoja na mvua,","poem":1},{"text":"naye huuleta upepo kutoka ghala zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Kila mtu ni mjinga na hana maarifa;","poem":1},{"text":"kila sonara ameaibishwa na sanamu zake.","poem":2},{"text":"Vinyago vyake ni vya udanganyifu,","poem":1},{"text":"havina pumzi ndani yavyo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Havifai kitu, ni vitu vya kufanyia mzaha,","poem":1},{"text":"hukumu yavyo itakapowadia, vitaangamia.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yeye Aliye Fungu la Yakobo sivyo alivyo,","poem":1},{"text":"kwani ndiye Muumba wa vitu vyote,","poem":2},{"text":"pamoja na kabila la urithi wake:","poem":1},{"text":"Bwana Mwenye Nguvu Zote ndilo jina lake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Wewe ndiwe rungu langu la vita,","poem":1},{"text":"silaha yangu ya vita:","poem":2},{"text":"kwa wewe navunjavunja mataifa,","poem":1},{"text":"kwa wewe naangamiza falme,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kwa wewe navunjavunja","poem":1},{"text":"farasi na mpanda farasi,","poem":2},{"text":"kwa wewe navunjavunja","poem":1},{"text":"gari la vita na mwendeshaji wake,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kwa wewe napondaponda","poem":1},{"text":"mwanaume na mwanamke,","poem":2},{"text":"kwa wewe napondaponda","poem":1},{"text":"mzee na kijana,","poem":2},{"text":"kwa wewe napondaponda","poem":1},{"text":"kijana wa kiume na mwanamwali,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"kwa wewe nampondaponda","poem":1},{"text":"mchungaji na kundi,","poem":2},{"text":"kwa wewe nampondaponda","poem":1},{"text":"mkulima na maksai,","poem":2},{"text":"kwa wewe nawapondaponda","poem":1},{"text":"watawala na maafisa.","poem":2}]},{"type":"verse","number":24,"content":["“Mbele ya macho yako nitamlipiza Babeli na wote waishio Ukaldayo kwa ajili ya makosa yote waliyofanya katika Sayuni,” asema Bwana."]},{"type":"verse","number":25,"content":[{"text":"“Mimi niko kinyume nawe, ee mlima unaoharibu,","poem":1},{"text":"wewe uangamizaye dunia yote,”","poem":2},{"text":"asema Bwana.","poem":4},{"text":"“Nitanyoosha mkono wangu dhidi yako,","poem":1},{"text":"nikuvingirishe kutoka kwenye kilele cha mwamba,","poem":2},{"lineBreak":true},{"text":"na kukufanya mlima ulioteketezwa kwa moto.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hakuna jiwe litakalochukuliwa kutoka kwako","poem":1},{"text":"kwa ajili ya kufanywa jiwe la pembeni,","poem":2},{"text":"wala jiwe lolote kwa ajili ya msingi,","poem":1},{"text":"kwa maana utakuwa ukiwa milele,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Twekeni bendera katika nchi!","poem":1},{"text":"Pigeni tarumbeta katikati ya mataifa!","poem":2},{"text":"Andaeni mataifa kwa ajili ya vita dhidi yake,","poem":1},{"text":"iteni falme hizi dhidi yake:","poem":2},{"lineBreak":true},{"text":"Ararati, Mini na Ashkenazi.","poem":2},{"text":"Wekeni jemadari dhidi yake,","poem":1},{"text":"pelekeni farasi wengi kama kundi la nzige.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Andaeni mataifa kwa ajili ya vita dhidi yake,","poem":1},{"text":"wafalme wa Wamedi,","poem":2},{"text":"watawala wao na maafisa wao wote,","poem":1},{"text":"pamoja na nchi zote wanazotawala.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nchi inatetemeka na kugaagaa,","poem":1},{"text":"kwa kuwa makusudi ya Bwana dhidi ya Babeli yanasimama:","poem":2},{"text":"yaani, kuangamiza nchi ya Babeli","poem":1},{"text":"ili pasiwe na yeyote atakayeishi humo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mashujaa wa Babeli wameacha kupigana,","poem":1},{"text":"wamebaki katika ngome zao.","poem":2},{"text":"Nguvu zao zimekwisha,","poem":1},{"text":"wamekuwa kama wanawake.","poem":2},{"text":"Makazi yake yameteketezwa kwa moto,","poem":1},{"text":"makomeo ya malango yake yamevunjika.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Tarishi mmoja humfuata mwingine,","poem":1},{"text":"na mjumbe humfuata mjumbe,","poem":2},{"text":"kumtangazia mfalme wa Babeli","poem":1},{"text":"kwamba mji wake wote umetekwa,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Vivuko vya mito vimekamatwa,","poem":1},{"text":"mabwawa yenye mafunjo yametiwa moto,","poem":2},{"lineBreak":true},{"text":"nao askari wameingiwa na hofu kuu.”","poem":2}]},{"type":"verse","number":33,"content":["Hili ndilo Bwana Mwenye Nguvu Zote, Mungu wa Israeli, asemalo:",{"text":"“Binti Babeli ni kama sakafu ya kupuria","poem":1},{"text":"wakati inapokanyagwa;","poem":2},{"lineBreak":true},{"text":"wakati wa kumvuna utakuja upesi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Nebukadneza mfalme wa Babeli ametula,","poem":1},{"text":"ametufanya tuchangayikiwe,","poem":2},{"lineBreak":true},{"text":"ametufanya tuwe gudulia tupu.","poem":2},{"text":"Kama nyoka ametumeza","poem":1},{"text":"na kujaza tumbo lake kwa vyakula vyetu vizuri,","poem":2},{"lineBreak":true},{"text":"kisha akatutapika.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Jeuri iliyofanyiwa miili yetu","poem":1},{"noteId":33},{"text":"na iwe juu ya Babeli,”","poem":1},{"text":"ndivyo wasemavyo wakaao Sayuni.","poem":2},{"text":"“Damu yetu na iwe juu ya wale waishio Babeli,”","poem":1},{"text":"asema Yerusalemu.","poem":2}]},{"type":"verse","number":36,"content":["Kwa hiyo, hili ndilo Bwana asemalo:",{"text":"“Tazama, nitatetea shauri lako","poem":1},{"text":"na kulipiza kisasi kwa ajili yako;","poem":2},{"text":"nitaikausha bahari yake","poem":1},{"text":"na kuzikausha chemchemi zake.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Babeli utakuwa lundo la magofu","poem":1},{"text":"na makao ya mbweha,","poem":2},{"text":"kitu cha kutisha na kudharauliwa,","poem":1},{"text":"mahali asipoishi mtu.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Watu wake wote wananguruma kama simba wadogo,","poem":1},{"text":"wanakoroma kama wana simba.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Lakini wakati wakiwa wameamshwa,","poem":1},{"text":"nitawaandalia karamu","poem":2},{"lineBreak":true},{"text":"na kuwafanya walewe,","poem":2},{"text":"ili wapige kelele kwa kicheko,","poem":1},{"text":"kisha walale milele na wasiamke,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":40,"content":[{"text":"“Nitawateremsha kama wana-kondoo waendao machinjoni,","poem":1},{"text":"kama kondoo dume na mbuzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Tazama jinsi Sheshaki","poem":1},{"noteId":34},{"text":"atakamatwa,","poem":1},{"text":"majivuno ya dunia yote yatakavyonyakuliwa.","poem":2},{"text":"Babeli atakuwa mwenye hofu kiasi gani","poem":1},{"text":"kati ya mataifa!","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Bahari itainuka juu ya Babeli;","poem":1},{"text":"mawimbi yake yenye kunguruma yatamfunika.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Miji yake itakuwa ukiwa,","poem":1},{"text":"kame na jangwa,","poem":2},{"text":"nchi ambayo hakuna yeyote anayeishi ndani yake,","poem":1},{"text":"ambayo hakuna mtu anayepita humo.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Nitamwadhibu Beli katika Babeli,","poem":1},{"text":"na kumfanya atapike kile alichokimeza.","poem":2},{"text":"Mataifa hayatamiminika tena kwake.","poem":1},{"text":"Nao ukuta wa Babeli utaanguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Tokeni ndani yake, enyi watu wangu!","poem":1},{"text":"Okoeni maisha yenu!","poem":2},{"lineBreak":true},{"text":"Ikimbieni hasira kali ya Bwana.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Msikate tamaa wala msiogope tetesi","poem":1},{"text":"zitakaposikika katika nchi;","poem":2},{"text":"tetesi moja inasikika mwaka huu,","poem":1},{"text":"nyingine mwaka unaofuata;","poem":2},{"text":"tetesi juu ya jeuri katika nchi,","poem":1},{"text":"na ya mtawala dhidi ya mtawala.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Kwa kuwa hakika wakati utawadia","poem":1},{"text":"nitakapoziadhibu sanamu za Babeli;","poem":2},{"text":"nchi yake yote itatiwa aibu,","poem":1},{"text":"na watu wake wote waliouawa","poem":2},{"lineBreak":true},{"text":"wataangukia ndani yake.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ndipo mbingu na dunia na vyote vilivyomo ndani yake","poem":1},{"text":"vitapiga kelele za shangwe juu ya Babeli,","poem":2},{"text":"kwa kuwa kutoka kaskazini","poem":1},{"text":"waharabu watamshambulia,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“Babeli ni lazima aanguke kwa sababu ya kuwaua Waisraeli,","poem":1},{"text":"kama vile waliouawa duniani kote","poem":2},{"lineBreak":true},{"text":"walivyoanguka kwa sababu ya Babeli.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Wewe uliyepona upanga,","poem":1},{"text":"ondoka wala usikawie!","poem":2},{"text":"Mkumbuke Bwana ukiwa katika nchi ya mbali,","poem":1},{"text":"na utafakari juu ya Yerusalemu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“Tumetahayari, kwa maana tumetukanwa","poem":1},{"text":"na aibu imefunika nyuso zetu,","poem":2},{"text":"kwa sababu wageni wameingia","poem":1},{"text":"mahali patakatifu pa nyumba ya Bwana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“Lakini siku zinakuja,” asema Bwana,","poem":1},{"text":"“nitakapoadhibu sanamu zake,","poem":2},{"text":"na katika nchi yake yote","poem":1},{"text":"waliojeruhiwa watalia kwa maumivu makali.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Hata kama Babeli ikifika angani","poem":1},{"text":"na kuziimarisha ngome zake ndefu,","poem":2},{"lineBreak":true},{"text":"nitatuma waharabu dhidi yake,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“Sauti ya kilio inasikika kutoka Babeli,","poem":1},{"text":"sauti ya uharibifu mkuu","poem":2},{"lineBreak":true},{"text":"kutoka nchi ya Wakaldayo.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Bwana ataiangamiza Babeli,","poem":1},{"text":"atanyamazisha makelele ya kishindo chake.","poem":2},{"text":"Mawimbi ya adui yatanguruma kama maji makuu,","poem":1},{"text":"ngurumo ya sauti zao itavuma.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Mharabu atakuja dhidi ya Babeli,","poem":1},{"text":"mashujaa wake watakamatwa,","poem":2},{"lineBreak":true},{"text":"nazo pinde zao zitavunjwa.","poem":2},{"text":"Kwa kuwa Bwana ni Mungu wa kisasi,","poem":1},{"text":"yeye atalipiza kikamilifu.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Nitawafanya maafisa wake na wenye busara walewe,","poem":1},{"text":"watawala wao, maafisa, pamoja na wapiganaji wao;","poem":2},{"text":"watalala milele na hawataamka,”","poem":1},{"text":"asema Mfalme, ambaye jina lake ni Bwana Mwenye Nguvu Zote.","poem":2}]},{"type":"verse","number":58,"content":["Hili ndilo Bwana Mwenye Nguvu Zote asemalo:",{"text":"“Ukuta mnene wa Babeli utasawazishwa,","poem":1},{"text":"na malango yaliyoinuka yatateketezwa kwa moto;","poem":2},{"text":"mataifa yanajichosha bure,","poem":1},{"text":"taabu ya mataifa ni nishati tu ya miali ya moto.”","poem":2}]},{"type":"verse","number":59,"content":["Huu ndio ujumbe Yeremia aliompa afisa Seraya mwana wa Neria mwana wa Maaseya, alipokwenda Babeli pamoja na Sedekia mfalme wa Yuda, katika mwaka wa nne wa utawala wake."]},{"type":"verse","number":60,"content":["Yeremia alikuwa ameandika ndani ya kitabu kuhusu maafa yote yatakayoipata Babeli, yaani yote yaliyokuwa yameandikwa kuhusu Babeli."]},{"type":"verse","number":61,"content":["Yeremia akamwambia Seraya, “Utakapofika Babeli, hakikisha kwamba umesoma maneno haya yote kwa sauti kubwa."]},{"type":"verse","number":62,"content":["Kisha sema, ‘Ee Bwana, umesema utaangamiza mahali hapa ili mtu wala mnyama asiishi ndani yake, napo patakuwa ukiwa milele.’"]},{"type":"verse","number":63,"content":["Utakapomaliza kusoma hiki kitabu, kifungie jiwe kisha ukitupe ndani ya Mto Frati."]},{"type":"verse","number":64,"content":["Kisha sema, ‘Hivi ndivyo Babeli utakavyozama na usiinuke tena, kwa sababu ya maafa nitakayoleta juu yake. Nao watu wake wataanguka.’ ”",{"lineBreak":true},"Maneno ya Yeremia yanaishia hapa."]}],"footnotes":[{"noteId":32,"caller":"+","text":"Leb-Kamai ni Ukaldayo, yaani Babeli, kwa fumbo.","reference":{"chapter":51,"verse":1}},{"noteId":33,"caller":"+","text":"Au: Jeuri tuliyofanyiwa sisi na watoto wetu.","reference":{"chapter":51,"verse":35}},{"noteId":34,"caller":"+","text":"Sheshaki ni Babeli kwa fumbo.","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/swh_bib/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}