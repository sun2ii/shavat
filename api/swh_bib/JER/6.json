{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_bib","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"7860f5ef33056f28b3a643e9d9c65c00108d86fe0496ea73ef931f992b806922","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_bib/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["Yerusalemu Imezingirwa Na Jeshi"]},{"type":"verse","number":1,"content":[{"text":"“Kimbieni kwa usalama wenu, enyi watu wa Benyamini!","poem":1},{"text":"Kimbieni kutoka Yerusalemu!","poem":2},{"text":"Pigeni tarumbeta katika Tekoa!","poem":1},{"text":"Inueni ishara juu ya Beth-Hakeremu!","poem":2},{"text":"Kwa kuwa maafa yanaonekana yakitoka kaskazini,","poem":1},{"text":"na uharibifu wa kutisha.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitamwangamiza Binti Sayuni,","poem":1},{"text":"aliye mzuri sana na mwororo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wachungaji pamoja na makundi yao","poem":1},{"text":"watakuja dhidi yake;","poem":2},{"text":"watapiga mahema yao kumzunguka,","poem":1},{"text":"kila mmoja akichunga kundi lake mwenyewe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Jiandaeni kwa vita dhidi yake!","poem":1},{"text":"Inukeni tumshambulie mchana!","poem":2},{"text":"Lakini, ole wetu, mchana unaisha,","poem":1},{"text":"na vivuli vya jioni vinazidi kuwa virefu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa hiyo inukeni, tufanye mashambulizi usiku,","poem":1},{"text":"na kuharibu ngome zake!”","poem":2}]},{"type":"verse","number":6,"content":["Hivi ndivyo asemavyo Bwana Mwenye Nguvu Zote:",{"text":"“Kateni miti mjenge boma","poem":1},{"text":"kuzunguka Yerusalemu.","poem":2},{"text":"Mji huu ni lazima uadhibiwe,","poem":1},{"text":"umejazwa na uonevu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kama vile kisima kinavyomwaga maji yake,","poem":1},{"text":"ndivyo anavyomwaga uovu wake.","poem":2},{"text":"Ukatili na maangamizi yasikika ndani yake,","poem":1},{"text":"ugonjwa wake na majeraha yake viko mbele yangu daima.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pokea onyo, ee Yerusalemu,","poem":1},{"text":"la sivyo nitageukia mbali nawe","poem":2},{"text":"na kuifanya nchi yako kuwa ukiwa,","poem":1},{"text":"asiweze mtu kuishi ndani yake.”","poem":2}]},{"type":"verse","number":9,"content":["Hivi ndivyo asemavyo Bwana Mwenye Nguvu Zote:",{"text":"“Wao na wayakusanye mabaki ya Israeli","poem":1},{"text":"kwa uangalifu kama kwenye mzabibu;","poem":2},{"text":"pitisha mkono wako kwenye matawi tena,","poem":1},{"text":"kama yeye avunaye zabibu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Niseme na nani na kumpa onyo?","poem":1},{"text":"Ni nani atakayenisikiliza mimi?","poem":2},{"text":"Masikio yao yameziba,","poem":1},{"noteId":4},{"text":"kwa hiyo hawawezi kusikia.","poem":2},{"text":"Neno la Bwana ni chukizo kwao,","poem":1},{"text":"hawalifurahii.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lakini nimejaa ghadhabu ya Bwana,","poem":1},{"text":"nami siwezi kuizuia.","poem":2},{"lineBreak":true},{"text":"“Wamwagie watoto walioko barabarani,","poem":1},{"text":"na juu ya vijana waume waliokusanyika;","poem":2},{"text":"mume na mke watakumbwa pamoja ndani yake,","poem":1},{"text":"hata nao wazee waliolemewa na miaka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nyumba zao zitapewa watu wengine,","poem":1},{"text":"pamoja na mashamba yao na wake zao,","poem":2},{"text":"nitakapounyoosha mkono wangu","poem":1},{"text":"dhidi ya wale waishio katika nchi,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":13,"content":[{"text":"“Kuanzia aliye mdogo kabisa hadi aliye mkubwa kabisa,","poem":1},{"text":"wote wana tamaa ya kupata faida zaidi;","poem":2},{"text":"manabii na makuhani wanafanana,","poem":1},{"text":"wote wanafanya udanganyifu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wanafunga majeraha ya watu wangu","poem":1},{"text":"bila uangalifu.","poem":2},{"text":"Wanasema, ‘Amani, amani,’","poem":1},{"text":"wakati hakuna amani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Je, wanaona aibu kwa ajili ya tabia yao","poem":1},{"text":"inayochukiza mno?","poem":2},{"text":"Hapana, hawana aibu hata kidogo;","poem":1},{"text":"hawajui hata kuona haya.","poem":2},{"text":"Kwa hiyo wataanguka miongoni mwa hao walioanguka,","poem":1},{"text":"watashushwa chini nitakapowaadhibu,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":16,"content":["Hivi ndivyo asemavyo Bwana:",{"text":"“Simama kwenye njia panda utazame,","poem":1},{"text":"ulizia mapito ya zamani,","poem":2},{"text":"ulizia wapi ilipo njia nzuri, uifuate hiyo,","poem":1},{"text":"nanyi mtapata raha nafsini mwenu.","poem":2},{"lineBreak":true},{"text":"Lakini ninyi mlisema, ‘Hatutaipita hiyo.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Niliweka walinzi juu yenu na kusema,","poem":1},{"text":"‘Sikieni sauti ya tarumbeta!’","poem":2},{"lineBreak":true},{"text":"Lakini mkasema, ‘Hatutasikiliza.’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa hiyo sikilizeni, enyi mataifa,","poem":1},{"text":"angalieni, enyi mashahidi,","poem":2},{"lineBreak":true},{"text":"lile litakalowatokea.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sikia, ee nchi:","poem":1},{"lineBreak":true},{"text":"Ninaleta maafa juu ya watu hawa,","poem":1},{"text":"matunda ya mipango yao,","poem":2},{"text":"kwa sababu hawakusikiliza maneno yangu","poem":1},{"text":"na wameikataa sheria yangu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unanifaa nini uvumba kutoka Sheba,","poem":1},{"text":"au udi wa harufu nzuri kutoka nchi ya mbali?","poem":2},{"text":"Sadaka zako za kuteketezwa hazikubaliki,","poem":1},{"text":"dhabihu zako hazinifurahishi mimi.”","poem":2}]},{"type":"verse","number":21,"content":["Kwa hiyo hivi ndivyo asemavyo Bwana:",{"text":"“Nitaweka vikwazo mbele ya watu hawa.","poem":1},{"text":"Baba na wana wao watajikwaa juu yake,","poem":2},{"lineBreak":true},{"text":"majirani na marafiki wataangamia.”","poem":2}]},{"type":"verse","number":22,"content":["Hivi ndivyo asemavyo Bwana:",{"text":"“Tazama, jeshi linakuja","poem":1},{"text":"kutoka nchi ya kaskazini,","poem":2},{"text":"taifa kubwa linaamshwa","poem":1},{"text":"kutoka miisho ya dunia.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Wamejifunga pinde na mkuki,","poem":1},{"text":"ni wakatili na hawana huruma.","poem":2},{"text":"Wanatoa sauti kama bahari inayonguruma","poem":1},{"text":"wanapoendesha farasi zao.","poem":2},{"text":"Wanakuja kama watu waliojipanga tayari kwa vita","poem":1},{"text":"ili kukushambulia, ee Binti Sayuni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Tumesikia taarifa zao,","poem":1},{"text":"nayo mikono yetu imelegea.","poem":2},{"text":"Uchungu umetushika,","poem":1},{"text":"maumivu kama ya mwanamke katika utungu wa kuzaa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usitoke kwenda mashambani","poem":1},{"text":"au kutembea barabarani,","poem":2},{"text":"kwa kuwa adui ana upanga,","poem":1},{"text":"na kuna vitisho kila upande.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Enyi watu wangu, vaeni magunia","poem":1},{"text":"mjivingirishe kwenye majivu,","poem":2},{"text":"ombolezeni kwa kilio cha uchungu","poem":1},{"text":"kama amliliaye mwana pekee,","poem":2},{"text":"kwa maana ghafula","poem":1},{"text":"mharabu atatujia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Nimekufanya wewe kuwa kitu cha kujaribu chuma,","poem":1},{"text":"nao watu wangu kama mawe yenye madini,","poem":2},{"lineBreak":true},{"text":"ili upate kuzijua na kuzijaribu njia zao.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wote ni waasi sugu,","poem":1},{"text":"wakienda huku na huko kusengenya.","poem":2},{"text":"Wao ni shaba na chuma,","poem":1},{"text":"wote wanatenda upotovu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Mivuo inavuma kwa nguvu,","poem":1},{"text":"kinachoungua kwa huo moto ni risasi,","poem":2},{"text":"lakini pamoja na kusafisha kote huku ni bure;","poem":1},{"text":"waovu hawaondolewi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Wanaitwa fedha iliyokataliwa,","poem":1},{"text":"kwa sababu Bwana amewakataa.”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Masikio yameziba kwa Kiebrania ina maana kwamba masikio yao hayajatahiriwa.","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/swh_bib/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}