{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["Sofari Anasema: Hatia Ya Ayubu Inastahili Adhabu"]},{"type":"verse","number":1,"content":["Ndipo Sofari Mnaamathi akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Je, maneno haya yote yapite bila kujibiwa?","poem":1},{"text":"Je, huyu mnenaji athibitishwe kuwa na haki?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Je, maneno yako ya upuzi yawafanye watu wanyamaze kimya?","poem":1},{"text":"Je, mtu asikukemee unapofanya dhihaka?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unamwambia Mungu, ‘Imani yangu ni kamili","poem":1},{"text":"nami ni safi mbele zako.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aha! Laiti kwamba Mungu angesema,","poem":1},{"text":"kwamba angefungua midomo yake dhidi yako,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"naye akufunulie siri za hekima,","poem":1},{"text":"kwa kuwa hekima ya kweli ina pande mbili.","poem":2},{"lineBreak":true},{"text":"Ujue hili: Mungu amesahau hata baadhi ya dhambi zako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Je, waweza kujua siri za Mungu?","poem":1},{"text":"Je, waweza kuyachunguza mambo yote kumhusu Mwenyezi?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ni juu mno kuliko mbingu: waweza kufanya nini?","poem":1},{"text":"Kina chake ni kirefu kuliko kuzimu:","poem":2},{"lineBreak":true},{"text":"wewe waweza kujua nini?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kipimo chake ni kirefu kuliko dunia,","poem":1},{"text":"nacho ni kipana kuliko bahari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kama akija na kukufunga gerezani,","poem":1},{"text":"na kuitisha mahakama, ni nani awezaye kumpinga?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hakika anawatambua watu wadanganyifu;","poem":1},{"text":"naye aonapo uovu, je, haangalii?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mpumbavu aweza kuwa mwenye hekima,","poem":1},{"text":"endapo mtoto wa punda-mwitu atazaliwa mwanadamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Hata sasa ukiutoa moyo wako kwake","poem":1},{"text":"na kumwinulia mikono yako,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ukiiondolea mbali ile dhambi iliyo mkononi mwako","poem":1},{"text":"wala usiuruhusu uovu ukae hemani mwako,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ndipo utainua uso wako bila aibu;","poem":1},{"text":"utasimama imara bila hofu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hakika utaisahau taabu yako,","poem":1},{"text":"utaikumbuka tu kama maji yaliyokwisha kupita.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Maisha yako yatangʼaa kuliko adhuhuri,","poem":1},{"text":"nalo giza litakuwa kama alfajiri.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Utakuwa salama, kwa kuwa lipo tumaini;","poem":1},{"text":"utatazama pande zote na kupumzika kwa salama.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Utalala, wala hakuna atakayekuogofya,","poem":1},{"text":"naam, wengi watajipendekeza kwako.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Bali macho ya waovu hayataona,","poem":1},{"text":"wokovu utawaepuka;","poem":2},{"text":"tarajio lao litakuwa ni hangaiko","poem":1},{"text":"la mtu anayekata roho.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}