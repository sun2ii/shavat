{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["Ayubu Anajibu: Mimi Ni Mtu Wa Kuchekwa"]},{"type":"verse","number":1,"content":["Ndipo Ayubu akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Bila shaka ninyi ndio watu,","poem":1},{"text":"nayo hekima itakoma mtakapokufa!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lakini mimi ninao ufahamu kama ninyi;","poem":1},{"text":"mimi si duni kwenu.","poem":2},{"lineBreak":true},{"text":"Ni nani asiyejua mambo haya yote?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nimekuwa mtu wa kuchekwa na rafiki zangu,","poem":1},{"text":"ingawa nilimwita Mungu naye akanijibu:","poem":2},{"text":"mimi ni mtu wa kuchekwa tu,","poem":1},{"text":"ingawa ni mwadilifu na nisiye na hatia!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wanadamu wakiwa katika utulivu huwa na dharau kwa wale wenye msiba","poem":1},{"lineBreak":true},{"text":"kana kwamba ndiyo haki ya wale ambao miguu yao inateleza.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Hema za wanyangʼanyi hazisumbuliwi,","poem":1},{"text":"wale wanaomghadhibisha Mungu wako salama:","poem":2},{"lineBreak":true},{"text":"wale wamchukuao mungu wao mikononi mwao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Lakini ulizeni wanyama, nao watawafundisha,","poem":1},{"text":"au ndege wa angani, nao watawaambia;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"au zungumzeni na dunia, nayo itawafundisha,","poem":1},{"text":"au acheni samaki wa baharini wawape taarifa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ni nani miongoni mwa hawa wote asiyejua","poem":1},{"text":"kwamba mkono wa Bwana ndio uliofanya hili?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mkononi mwake kuna uhai wa kila kiumbe,","poem":1},{"text":"na pumzi ya wanadamu wote.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Je, sikio haliyajaribu maneno","poem":1},{"text":"kama vile ulimi uonjavyo chakula?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Je, hekima haipatikani katikati ya wazee?","poem":1},{"text":"Je, maisha marefu hayaleti ufahamu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Hekima na nguvu ni vya Mungu;","poem":1},{"text":"shauri na ufahamu ni vyake yeye.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kile anachokibomoa hakiwezi kujengeka tena;","poem":1},{"text":"mtu aliyefungiwa naye hawezi kufunguliwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Akizuia maji, huwa pana ukame;","poem":1},{"text":"akiyaachia maji, huharibu nchi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwake kuna nguvu na ushindi;","poem":1},{"text":"adanganywaye na adanganyaye, wote wawili ni wake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Yeye huwaondoa washauri wakiwa wametekwa nyara,","poem":1},{"text":"naye huwapumbaza wanaotoa maamuzi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Huondoa pingu zilizofungwa na wafalme,","poem":1},{"text":"na kuwafunga mishipi ya kiunoni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Huwaondoa makuhani wakiwa wametekwa nyara,","poem":1},{"text":"na kuwaangusha waliojiimarisha muda mrefu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hunyamazisha midomo ya washauri wanaoaminika,","poem":1},{"text":"na kuondoa busara ya wazee.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Huwamwagia dharau wanaoheshimika,","poem":1},{"text":"na kuwavua silaha wenye nguvu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hufunua mambo ya ndani ya gizani,","poem":1},{"text":"na kuyaleta nuruni yale yaliyositirika sana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Huyafanya mataifa yatukuke na kuyaangamiza;","poem":1},{"text":"hufanya mataifa kuwa makubwa, naye huyatawanya.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Huwaondolea viongozi wa nchi akili zao;","poem":1},{"text":"huwapeleka watangetange nyikani pasipo na njia.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hupapasa gizani pasipokuwa na mwanga;","poem":1},{"text":"huwafanya wapepesuke kama walevi.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}