{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Ayubu Anathibitisha Tena Hali Yake Ya Kutokuwa Na Hatia"]},{"type":"verse","number":1,"content":["Kisha Ayubu akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Nimepata kusikia mambo mengi kama haya,","poem":1},{"text":"nanyi nyote ni wafariji wenye kutaabisha!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Je, maneno yenu mengi yasiyo na maana hayana mwisho?","poem":1},{"text":"Mna nini hata mwendelee kushindana kwa maneno?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mimi pia ningeweza kuzungumza kama ninyi,","poem":1},{"text":"kama mngekuwa katika hali yangu;","poem":2},{"text":"ningeweza kutoa hotuba nzuri dhidi yenu,","poem":1},{"text":"na kuwatikisia ninyi kichwa changu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lakini kinywa changu kingewatia moyo;","poem":1},{"text":"faraja kutoka midomoni mwangu, ingewaletea nafuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Lakini kama nikisema, maumivu yangu bado hayatulizwi;","poem":1},{"text":"nami kama nikijizuia, wala hayaondoki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mungu, hakika umenichakaza;","poem":1},{"text":"umewaangamiza kabisa watu wa nyumbani mwangu wote.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umenikunjakunja, nalo limekuwa ushahidi;","poem":1},{"text":"nako kukonda kwangu kumeongezeka sana na kushuhudia dhidi yangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mungu amenishambulia na kunirarua katika hasira yake,","poem":1},{"text":"na kunisagia meno yake;","poem":2},{"lineBreak":true},{"text":"adui yangu hunikazia macho yake makali.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watu wamenifumbulia vinywa vyao kunidhihaki;","poem":1},{"text":"hunipiga shavuni mwangu kwa dharau,","poem":2},{"lineBreak":true},{"text":"na kuungana pamoja dhidi yangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mungu amenigeuzia kwa watu wabaya,","poem":1},{"text":"na kunitupa katika makucha ya waovu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mambo yote yalikuwa mazuri, lakini alinivunjavunja;","poem":1},{"text":"amenikamata shingo na kuniponda.","poem":2},{"lineBreak":true},{"text":"Amenifanya mimi kuwa shabaha yake;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"wapiga upinde wake wananizunguka.","poem":1},{"text":"Bila huruma, huchoma figo zangu,","poem":2},{"lineBreak":true},{"text":"na kuimwaga nyongo yangu juu ya nchi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Huniponda tena na tena;","poem":1},{"text":"hunishambulia kama shujaa wa vita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Nimejishonea nguo ya gunia juu ya mwili wangu","poem":1},{"text":"nami nimekizika kipaji cha uso wangu kwenye vumbi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uso wangu umekuwa mwekundu kwa kulia,","poem":1},{"text":"macho yangu yamepigwa na giza kuu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hata hivyo mikono yangu haijafanya jeuri,","poem":1},{"text":"na maombi yangu ni safi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ee nchi, usiifunike damu yangu,","poem":1},{"text":"nacho kilio changu kisinyamazishwe kamwe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hata sasa shahidi wangu yuko mbinguni;","poem":1},{"text":"wakili wangu yuko juu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mwombezi wangu ni rafiki yangu","poem":1},{"text":"macho yangu yamwagapo machozi kwa Mungu;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kwa niaba ya mtu anamsihi Mungu","poem":1},{"text":"kama mtu anavyosihi kwa ajili ya rafiki yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ni miaka michache tu itapita","poem":1},{"text":"kabla sijaenda safari ambayo sitarudi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}