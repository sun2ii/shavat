{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["Sofari Anasema: Uovu Hupokea Malipo Ya Haki"]},{"type":"verse","number":1,"content":["Ndipo Sofari Mnaamathi akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Mawazo yanayonisumbua yananisukuma kujibu,","poem":1},{"text":"kwa sababu nimehangaika sana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ninasikia makaripio ambayo yananivunjia heshima,","poem":1},{"text":"nao ufahamu wangu unanisukuma kujibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Hakika unajua jinsi ilivyokuwa tangu zamani,","poem":1},{"text":"tangu zamani mwanadamu alipowekwa duniani,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"macheko ya mtu mwovu ni ya muda mfupi,","poem":1},{"text":"nayo furaha ya wasiomcha Mungu hudumu kwa kitambo tu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ingawa kujikweza kwake hufikia mbinguni","poem":1},{"text":"na kichwa chake hugusa mawingu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ataangamia milele kama mavi yake mwenyewe.","poem":1},{"text":"Wale waliomwona watauliza, ‘Yuko wapi?’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kama ndoto hutoweka, wala hapatikani tena,","poem":1},{"text":"amefukuziwa mbali kama maono ya usiku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Jicho lililomwona halitamwona tena;","poem":1},{"text":"mahali pake hapatamwona tena.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watoto wake watalipa yote baba yao aliyowadhulumu maskini,","poem":1},{"text":"nayo mikono yake itarudisha mali yote aliyonyangʼanya watu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nguvu za ujana zilizoijaza mifupa yake,","poem":1},{"text":"zitalala naye mavumbini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ingawa uovu ni mtamu kinywani mwake","poem":1},{"text":"naye huuficha chini ya ulimi wake,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ingawa hawezi kukubali kuuachia uende,","poem":1},{"text":"lakini huuweka kinywani mwake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hata hivyo chakula chake kitakuwa kichungu tumboni mwake,","poem":1},{"text":"nacho kitakuwa sumu kali ya nyoka ndani yake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Atatema mali alizozimeza;","poem":1},{"text":"Mungu atalifanya tumbo lake kuzitapika.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Atanyonya sumu za majoka;","poem":1},{"text":"meno ya nyoka mwenye sumu kali yatamuua.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hatafurahia vijito,","poem":1},{"text":"mito inayotiririsha asali na siagi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Vile alivyovitaabikia atavirudisha bila kuvila;","poem":1},{"text":"hatafurahia faida itokanayo na biashara yake.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kwa kuwa aliwaonea maskini na kuwaacha pasipo kitu;","poem":1},{"text":"amenyangʼanya kwa nguvu nyumba asizozijenga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Hakika hatakuwa na raha katika kutamani kwake sana;","poem":1},{"text":"hawezi kujiokoa mwenyewe kwa hazina zake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hakuna chochote kitakachosalia kwa ajili yake ili ale;","poem":1},{"text":"kufanikiwa kwake hakutadumu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Katikati ya wingi wa ustawi wake, dhiki itampata;","poem":1},{"text":"taabu itamjia kwa nguvu zote.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Atakapokuwa amelijaza tumbo lake,","poem":1},{"text":"Mungu ataionyesha ghadhabu kali dhidi yake,","poem":2},{"lineBreak":true},{"text":"na kumnyeshea mapigo juu yake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ijapokuwa aikimbia silaha ya chuma,","poem":1},{"text":"mshale wa shaba utamchoma.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Atauchomoa katika mgongo wake,","poem":1},{"text":"ncha ingʼaayo kutoka ini lake.","poem":2},{"text":"Vitisho vitakuja juu yake;","poem":1}]},{"type":"verse","number":26,"content":[{"text":"giza nene linavizia hazina zake.","poem":2},{"text":"Moto usiopepewa na mtu utamteketeza,","poem":1},{"text":"na kuangamiza yaliyosalia nyumbani mwake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mbingu zitaweka wazi hatia yake,","poem":1},{"text":"nayo nchi itainuka kinyume chake.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mafuriko yataichukua nyumba yake,","poem":1},{"text":"maji yaendayo kasi katika siku ya ghadhabu ya Mungu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hili ndilo fungu Mungu alilowagawia waovu,","poem":1},{"text":"urithi uliowekwa kwa ajili yao na Mungu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}