{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Ayubu Anajibu: Kulalamika Kwangu Ni Uchungu"]},{"type":"verse","number":1,"content":["Ndipo Ayubu akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Hata leo malalamiko yangu ni chungu;","poem":1},{"text":"mkono wake ni mzito juu yangu hata nikiugua.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Laiti ningefahamu mahali pa kumwona;","poem":1},{"text":"laiti ningeweza kwenda mahali akaapo!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ningeliweka shauri langu mbele zake,","poem":1},{"text":"na kukijaza kinywa changu na hoja.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ningejua kwamba angenijibu nini,","poem":1},{"text":"na kuelewa lile ambalo angelisema.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, angenipinga kwa nguvu nyingi?","poem":1},{"text":"La, asingenigandamiza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hapo mtu mwadilifu angeweka shauri lake mbele zake,","poem":1},{"text":"nami ningeokolewa milele na mhukumu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Lakini nikienda mashariki, hayupo;","poem":1},{"text":"nikienda magharibi, simpati.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anapokuwa kazini pande za kaskazini, simwoni;","poem":1},{"text":"akigeukia kusini, nako simwoni hata kidogo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini anaijua njia niiendeayo;","poem":1},{"text":"akiisha kunijaribu, nitatoka kama dhahabu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nyayo zangu zimefuata hatua zake kwa karibu;","poem":1},{"text":"nimeishika njia yake bila kukengeuka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sijaziacha amri zilizotoka midomoni mwake;","poem":1},{"text":"nimeyathamini maneno ya kinywa chake kuliko chakula changu cha kila siku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Lakini yeye husimama peke yake; ni nani awezaye kumpinga?","poem":1},{"text":"Yeye hufanya lolote atakalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hutimiliza maagizo yake dhidi yangu,","poem":1},{"text":"na bado anayo mipango mingi kama hiyo ambayo ameiweka akiba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hiyo ndiyo sababu ninaingiwa na hofu mbele zake;","poem":1},{"text":"nifikiriapo haya yote ninamwogopa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mungu ameufanya moyo wangu kuzimia;","poem":1},{"text":"yeye Mwenyezi amenitia hofu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hata hivyo sijanyamazishwa na giza,","poem":1},{"text":"wala kwa giza nene linalofunika uso wangu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}