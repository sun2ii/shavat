"text":"Uharibifu","poem":2},{"noteId":17},{"text":"haukufunikwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hutandaza anga la kaskazini mahali patupu;","poem":1},{"text":"naye huiningʼiniza dunia mahali pasipo na kitu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Huyafungia maji kwenye mawingu yake,","poem":1},{"text":"hata hivyo mawingu hayapasuki kwa uzito wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huufunika uso wa mwezi mpevu,","poem":1},{"text":"akitandaza mawingu juu yake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amechora mstari wa upeo juu ya uso wa maji,","poem":1},{"text":"ameweka mpaka wa nuru na giza.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nguzo za mbingu nazo zatetemeka,","poem":1},{"text":"zinatishika anapozikemea.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa nguvu zake aliisukasuka bahari;","poem":1},{"text":"kwa hekima yake alimkata Rahabu","poem":2},{"noteId":18},{"text":"vipande vipande.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aliisafisha anga kwa pumzi yake;","poem":1},{"text":"kwa mkono wake alimchoma joka aendaye mbio.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Haya ni mambo madogo tu katika matendo yake;","poem":1},{"text":"tazama jinsi ulivyo mdogo mnongʼono tunaousikia kumhusu!","poem":2},{"text":"Ni nani basi awezaye kuelewa","poem":1},{"text":"ngurumo za nguvu zake?”","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"Yaani Kuzimu; Kiebrania ni Sheol.","reference":{"chapter":26,"verse":6}},{"noteId":17,"caller":"+","text":"Kwa Kiebrania ni Abadon.","reference":{"chapter":26,"verse":6}},{"noteId":18,"caller":"+","text":"Rahabu hapa ni fumbo la kumaanisha Lewiathani, mnyama mkubwa wa baharini mwenye magamba anayefanana na joka kubwa, mwenye umbo la kutisha, asiyeweza kuvuliwa.","reference":{"chapter":26,"verse":12}}]},"thisChapterLink":"/api/swh_bib/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}