{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"heading","content":["Ayubu Anadumisha Uadilifu Wake"]},{"type":"verse","number":1,"content":["Ndipo Ayubu akaendelea na hoja yake, akasema:"]},{"type":"verse","number":2,"content":[{"text":"“Hakika kama Mungu aishivyo, aliyeninyima haki yangu,","poem":1},{"text":"Mwenyezi ambaye amenifanya","poem":2},{"lineBreak":true},{"text":"nionje uchungu wa nafsi,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwa muda wote nitakaokuwa na uhai ndani yangu,","poem":1},{"text":"nayo pumzi ya Mungu ikiwa puani mwangu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"midomo yangu haitanena uovu,","poem":1},{"text":"wala ulimi wangu hautatamka udanganyifu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sitakubaliana nanyi kabisa kuwa mko sahihi;","poem":1},{"text":"hadi nife, sitakana uadilifu wangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nitadumisha haki yangu wala sitaiacha;","poem":1},{"text":"dhamiri yangu haitanisuta muda wote ninaoishi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Watesi wangu wawe kama waovu,","poem":1},{"text":"nao adui zangu wawe kama wasio haki!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa maana mtu asiyemcha Mungu","poem":1},{"text":"analo tegemeo gani anapokatiliwa mbali,","poem":2},{"lineBreak":true},{"text":"Mungu anapouondoa uhai wake?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, Mungu husikiliza kilio chake,","poem":1},{"text":"shida zimjiapo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Je, anaweza kumfurahia Mwenyezi?","poem":1},{"text":"Je, atamwita Mungu nyakati zote?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nitawafundisha juu ya uweza wa Mungu;","poem":1},{"text":"njia za Mwenyezi sitazificha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ninyi nyote mmeona hili wenyewe.","poem":1},{"text":"Ni ya nini basi mazungumzo haya yasiyo na maana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Hili ndilo fungu ambalo Mungu humpa mtu mwovu,","poem":1},{"text":"urithi ule mtu mdhalimu anapokea kutoka kwa Mwenyezi:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hata kama watoto wake watakuwa wengi kiasi gani,","poem":1},{"text":"fungu lao ni kuuawa kwa upanga;","poem":2},{"text":"wazao wake hawatakuwa kamwe","poem":1},{"text":"na chakula cha kuwatosha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tauni itawazika wale watakaonusurika miongoni mwao,","poem":1},{"text":"nao wajane wao hawatawaombolezea.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ajapokusanya fedha nyingi kama mavumbi,","poem":1},{"text":"na mavazi kama malundo ya udongo wa mfinyanzi,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"yale yote mtu mwovu aliyojiwekea akiba, mwenye haki atayavaa,","poem":1},{"text":"naye asiye na hatia ataigawanya fedha yake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nyumba aijengayo ni kama utando wa buibui,","poem":1},{"text":"kama kibanda alichotengeneza mlinzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yeye hulala akiwa tajiri, lakini ndiyo mara ya mwisho;","poem":1},{"text":"afunguapo macho yake, yote yametoweka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Vitisho humjia kama mafuriko;","poem":1},{"text":"dhoruba humkumba ghafula usiku.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Upepo mkali wa mashariki humchukua, naye hutoweka;","poem":1},{"text":"humzoa kutoka mahali pake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Humvurumisha bila huruma,","poem":1},{"text":"huku akikimbia kasi kukwepa nguvu zake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Upepo humpigia makofi kwa dharau,","poem":1},{"text":"na kumfukuza atoke mahali pake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}