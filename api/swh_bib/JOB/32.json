{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["Elihu Awakemea Rafiki Za Ayubu"]},{"type":"verse","number":1,"content":["Basi watu hawa watatu wakaacha kumjibu Ayubu, kwa kuwa alikuwa mwadilifu machoni pake mwenyewe."]},{"type":"verse","number":2,"content":["Lakini Elihu mwana wa Barakeli, wa kabila la Buzi wa jamaa ya Ramu, akamkasirikia sana Ayubu, kwa sababu ya kujihesabia haki mwenyewe badala ya Mungu."]},{"type":"verse","number":3,"content":["Pia aliwakasirikia hao rafiki watatu wa Ayubu, kwa sababu hawakuweza kupata njia ya kuthibitisha ya kuwa hayo maneno ya Ayubu hayakuwa ya kweli, nao bado walikuwa wamemlaumu."]},{"type":"verse","number":4,"content":["Basi Elihu alikuwa amesubiri kwanza waongee na Ayubu kwa sababu walikuwa na umri mkubwa kumliko yeye."]},{"type":"verse","number":5,"content":["Lakini alipoona watu hao watatu hawakuwa na kitu zaidi cha kusema, hasira yake ikaamka."]},{"type":"verse","number":6,"content":["Basi Elihu mwana wa Barakeli wa kabila la Buzi akasema:",{"text":"“Mimi ni mdogo kwa umri,","poem":1},{"text":"nanyi ni wazee;","poem":2},{"text":"ndiyo sababu niliogopa,","poem":1},{"text":"sikuthubutu kuwaambia kile ninachojua.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nilifikiri, ‘Yafaa umri useme,","poem":1},{"text":"nao wingi wa miaka ungefundisha hekima.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lakini ni Roho iliyoko ndani ya mwanadamu,","poem":1},{"text":"pumzi ya Mwenyezi, ndiyo impayo yeye ufahamu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sio wazee peke yao walio na hekima,","poem":1},{"text":"sio wenye umri mkubwa peke yao wanaofahamu lililo sawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kwa hiyo nasema: Nisikilizeni mimi;","poem":1},{"text":"mimi nami nitawaambia lile ninalojua.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nilingojea mlipokuwa mnaongea,","poem":1},{"text":"nilizisikiliza hoja zenu;","poem":2},{"text":"mlipokuwa mkitafuta maneno ya kusema,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"niliwasikiliza kwa makini.","poem":2},{"text":"Lakini hakuna hata mmoja wenu","poem":1},{"text":"aliyethibitisha kwamba Ayubu amekosa;","poem":2},{"text":"hakuna hata mmoja wenu","poem":1},{"text":"aliyeweza kujibu hoja zake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Msiseme, ‘Tumepata hekima;","poem":1},{"text":"Mungu na amthibitishe kuwa mwongo,","poem":2},{"lineBreak":true},{"text":"wala si mwanadamu.’","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lakini Ayubu hajayapanga maneno yake dhidi yangu,","poem":1},{"text":"nami sitamjibu kwa kutumia hoja zenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Wametiwa hofu na hawana la zaidi la kusema;","poem":1},{"text":"maneno yamewaishia.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Je, ningoje sasa kwa sababu wamekuwa kimya,","poem":1},{"text":"kwa vile sasa wanasimama bila kuwa na la kujibu?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mimi nami nitakuwa na la kusema;","poem":1},{"text":"mimi nami nitasema lile nilijualo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa kuwa nimejawa na maneno,","poem":1},{"text":"nayo Roho iliyomo ndani yangu yanisukuma;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ndani yangu niko kama chupa iliyojazwa divai,","poem":1},{"text":"kama kiriba kipya cha divai kilicho tayari kupasuka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ni lazima niseme ili niweze kutulia;","poem":1},{"text":"ni lazima nifumbue midomo yangu nipate kujibu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sitampendelea mtu yeyote,","poem":1},{"text":"wala sitajipendekeza kwa mtu yeyote;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kwa kuwa kama ningekuwa stadi wa kujipendekeza,","poem":1},{"text":"Muumba wangu angeniondolea mbali kwa upesi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}