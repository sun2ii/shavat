{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"heading","content":["Elihu Anamkemea Ayubu"]},{"type":"verse","number":1,"content":[{"text":"“Lakini Ayubu, sasa, sikiliza maneno yangu;","poem":1},{"text":"zingatia kila kitu nitakachosema.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Karibu nitafungua kinywa changu;","poem":1},{"text":"maneno yangu yapo katika ncha ya ulimi wangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maneno yangu yanatoka katika moyo mnyofu;","poem":1},{"text":"midomo yangu hunena kwa uaminifu yale niyajuayo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Roho wa Mungu ameniumba;","poem":1},{"text":"pumzi ya Mwenyezi hunipa uhai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unijibu basi, kama unaweza;","poem":1},{"text":"jiandae kunikabili mimi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mimi ni kama wewe mbele za Mungu;","poem":1},{"text":"mimi pia nimetolewa kwenye udongo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Huna sababu ya kuniogopa,","poem":1},{"text":"wala mkono wangu haupaswi kukulemea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Lakini umesema nikiwa ninakusikia,","poem":1},{"text":"nami nilisikia maneno yenyewe:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"‘Mimi ni safi na sina dhambi;","poem":1},{"text":"mimi ni safi na sina hatia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini bado Mungu amepata dosari kwangu,","poem":1},{"text":"naye ananiona kama adui yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ananifunga miguu kwa pingu,","poem":1},{"text":"tena anaziangalia njia zangu zote kwa karibu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Lakini mimi ninakuambia, katika jambo hili wewe una makosa,","poem":1},{"text":"kwa maana Mungu ni mkuu kuliko mwanadamu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa nini unamlalamikia","poem":1},{"text":"kwamba yeye hamjibu mwanadamu?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa kuwa Mungu husema, wakati huu kwa njia moja,","poem":1},{"text":"au wakati mwingine kwa njia nyingine,","poem":2},{"lineBreak":true},{"text":"ingawa mwanadamu anaweza asielewe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mungu husema na mwanadamu katika ndoto,","poem":1},{"text":"katika maono ya usiku,","poem":2},{"text":"wakati usingizi mzito uwaangukiapo","poem":1},{"text":"wanadamu wasinziapo vitandani mwao,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"anaweza akasemea masikioni mwao,","poem":1},{"text":"na kuwatia hofu kwa maonyo,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ili kumgeuza mtu kutoka kwenye kutenda mabaya","poem":1},{"text":"na kumwepusha na kiburi,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kuiokoa nafsi yake na shimo,","poem":1},{"text":"uhai wake usiangamizwe kwa upanga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mtu anaweza kutiwa adabu kwa maumivu kitandani mwake,","poem":1},{"text":"kwa dhiki za mfululizo katika mifupa yake,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kiasi kwamba maisha yake yenyewe yanakataa chakula","poem":1},{"text":"nayo nafsi yake ikakichukia kabisa hata chakula kizuri.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nyama ya mwili wake huisha kwa kukonda,","poem":1},{"text":"nayo mifupa yake ambayo mwanzoni ilikuwa imefichika,","poem":2},{"lineBreak":true},{"text":"sasa inatokeza nje.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nafsi yake inakaribia kaburi,","poem":1},{"text":"nao uhai wake karibu na wajumbe wa kifo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Kama bado kuna malaika upande wake","poem":1},{"text":"kama mtetezi, mmoja miongoni mwa elfu,","poem":2},{"lineBreak":true},{"text":"wa kumwambia mwanadamu lililo jema kwake,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kumwonea huruma na kusema,","poem":1},{"text":"‘Mwokoe asije akatumbukia shimoni;","poem":2},{"lineBreak":true},{"text":"nimepata ukombozi kwa ajili yake’:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ndipo nyama ya mwili wake hufanywa mpya kama ya mtoto;","poem":1},{"text":"hurudishwa upya kama siku za ujana wake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Humwomba Mungu, akapata kibali kwake,","poem":1},{"text":"huuona uso wa Mungu na kushangilia kwa furaha;","poem":2},{"lineBreak":true},{"text":"Mungu humrudisha katika hali yake ya uadilifu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ndipo huja mbele za watu na kusema,","poem":1},{"text":"‘Nilitenda dhambi na kupotosha kilichokuwa haki,","poem":2},{"lineBreak":true},{"text":"lakini sikuadhibiwa kama nilivyostahili.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Alinikomboa nafsi yangu nisitumbukie shimoni,","poem":1},{"text":"nami nitaishi ili kuufurahia mwanga.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Mungu hufanya haya yote kwa mwanadamu;","poem":1},{"text":"mara mbili hata mara tatu,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ili aigeuze nafsi yake toka shimoni,","poem":1},{"text":"ili nuru ya uzima imwangazie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Ayubu, zingatia, nisikilize mimi;","poem":1},{"text":"nyamaza, nami nitanena.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kama unalo lolote la kusema, unijibu;","poem":1},{"text":"sema, kwa maana ninataka uonekane huna hatia.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Lakini kama huna la kusema, basi nisikilize mimi;","poem":1},{"text":"nyamaza, nami nitakufundisha hekima.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}