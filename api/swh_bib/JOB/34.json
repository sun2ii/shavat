{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"heading","content":["Elihu Anatangaza Haki Ya Mungu"]},{"type":"verse","number":1,"content":["Kisha Elihu akasema:"]},{"type":"verse","number":2,"content":[{"text":"“Sikieni maneno yangu, enyi watu wenye hekima;","poem":1},{"text":"nisikilizeni mimi, ninyi watu wenye maarifa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa sikio huyajaribu maneno","poem":1},{"text":"kama vile ulimi uonjavyo chakula.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tujichagulie wenyewe yaliyo sawa,","poem":1},{"text":"nasi tujifunze pamoja yaliyo mema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Ayubu anasema, ‘Mimi sina hatia,","poem":1},{"text":"lakini Mungu ameninyima haki yangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ingawa niko sawa,","poem":1},{"text":"ninaonekana mwongo;","poem":2},{"text":"nami ingawa sina kosa,","poem":1},{"text":"kidonda changu hakiponi.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ni mtu gani aliye kama Ayubu,","poem":1},{"text":"anywaye dharau kama maji?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ashirikianaye na watenda mabaya","poem":1},{"text":"na kuchangamana na watu waovu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa kuwa anasema, ‘Haimfaidi mwanadamu kitu chochote","poem":1},{"text":"anapojitahidi kumpendeza Mungu.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Hivyo nisikilizeni mimi, ninyi watu wenye ufahamu.","poem":1},{"text":"Kamwe Mungu hatendi uovu,","poem":2},{"lineBreak":true},{"text":"Mwenyezi hafanyi kosa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Humlipa mwanadamu kwa ajili ya lile alilotenda;","poem":1},{"text":"huleta juu yake kile ambacho matendo yake yanastahili.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ni jambo lisiloweza kufikiriwa kwamba Mungu angefanya makosa,","poem":1},{"text":"kwamba Mwenyezi angepotosha hukumu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Je, ni nani aliyemtawaza juu ya dunia?","poem":1},{"text":"Ni nani aliyemweka kuwa mwangalizi wa ulimwengu wote?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kama lilikuwa kusudi la Mungu,","poem":1},{"text":"naye akaiondoa Roho yake na pumzi yake,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"wanadamu wote wangeliangamia kwa pamoja,","poem":1},{"text":"na mtu angerudi mavumbini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Kama ninyi mnaufahamu, sikieni hili;","poem":1},{"text":"sikilizeni hili nisemalo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Je, yeye aichukiaye haki aweza kutawala?","poem":1},{"text":"Je, utamhukumu mwenye haki, Aliye na Nguvu Zote?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Je, si ni yeye awaambiaye wafalme, ‘Ninyi hamfai kitu,’","poem":1},{"text":"nao watu mashuhuri, ‘Ninyi ni waovu,’","poem":2}]},{"type":"verse","number":19,"content":[{"text":"yeye asiyependelea wakuu,","poem":1},{"text":"wala haonyeshi upendeleo kwa matajiri kuliko maskini,","poem":2},{"lineBreak":true},{"text":"kwa kuwa wote ni kazi ya mikono yake?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wanakufa ghafula, usiku wa manane;","poem":1},{"text":"watu wanatikiswa nao hupita;","poem":2},{"text":"wenye nguvu huondolewa","poem":1},{"text":"bila mkono wa mwanadamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Macho yake yanazitazama njia za wanadamu;","poem":1},{"text":"anaona kila hatua yao.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hakuna mahali penye giza nene, wala uvuli mkubwa,","poem":1},{"text":"ambapo watenda mabaya wanaweza kujificha.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mungu hana haja ya kumchunguza mtu sana,","poem":1},{"text":"ili apate kuja mbele zake kwa hukumu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Bila kuuliza huwapondaponda wenye nguvu nyingi","poem":1},{"text":"na kuwaweka wengine mahali pao.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kwa sababu huyaangalia matendo yao yote,","poem":1},{"text":"huwaondoa usiku, nao wakaangamia.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Anawaadhibu kwa ajili ya uovu wao","poem":1},{"text":"mahali ambapo kila mmoja ataweza kuwaona,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kwa sababu wameacha kumfuata Mungu,","poem":1},{"text":"nao hawakuiheshimu njia yake hata moja.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wamesababisha kilio cha maskini kifike mbele zake,","poem":1},{"text":"hivyo akasikia kilio cha wahitaji.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Lakini kama akinyamaza kimya,","poem":1},{"text":"ni nani awezaye kumhukumu?","poem":2},{"text":"Kama akiuficha uso wake,","poem":1},{"text":"ni nani awezaye kumwona?","poem":2},{"text":"Ikiwa ni taifa au mtu mmoja, kwake ni sawa,","poem":1}]},{"type":"verse","number":30,"content":[{"text":"ili kumzuia mtu mwovu kutawala,","poem":2},{"lineBreak":true},{"text":"au wale ambao huwategea watu mitego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“Kama mwanadamu akimwambia Mungu,","poem":1},{"text":"‘Nimekosa lakini sitatenda dhambi tena.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nifundishe nisichoweza kuona;","poem":1},{"text":"kama nimekukosea, sitafanya hivyo tena.’","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Je basi, Mungu atakulipa kwa masharti yako,","poem":1},{"text":"wakati wewe umekataa kutubu?","poem":2},{"text":"Yakupasa wewe uamue, wala si mimi;","poem":1},{"text":"sasa niambie lile ulijualo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Wanadamu wenye ufahamu husema,","poem":1},{"text":"wenye hekima wanaonisikia huniambia,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘Ayubu huongea bila maarifa;","poem":1},{"text":"maneno yake hayana busara.’","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Laiti Ayubu angejaribiwa hadi kikomo cha mwisho,","poem":1},{"text":"kwa sababu anajibu kama mtu mwovu!","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Kwenye dhambi yake huongeza uasi;","poem":1},{"text":"kwa dharau hupiga makofi miongoni mwetu,","poem":2},{"lineBreak":true},{"text":"na kuzidisha maneno yake dhidi ya Mungu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}