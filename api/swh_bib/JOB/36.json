{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"heading","content":["Elihu Atukuza Wema Wa Mungu"]},{"type":"verse","number":1,"content":["Elihu akaendelea kusema:"]},{"type":"verse","number":2,"content":[{"text":"“Nivumilie kidogo zaidi nami nitakuonyesha","poem":1},{"text":"kwamba yako mengi zaidi ya kusemwa kwa ajili ya Mungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ninayapata maarifa yangu kutoka mbali,","poem":1},{"text":"nami nitamhesabia haki Muumba wangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uwe na hakika kwamba maneno yangu si ya uongo;","poem":1},{"text":"mmoja aliye mkamilifu katika maarifa yuko pamoja na wewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Mungu ni mwenye nguvu, lakini hamdharau mwanadamu;","poem":1},{"text":"ni mwenye nguvu, naye ni thabiti katika shauri lake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hawaachi waovu waendelee kuishi,","poem":1},{"text":"bali huwapa walioteswa haki yao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeye haondoi macho yake kwa wenye haki;","poem":1},{"text":"huwaketisha penye viti vya enzi pamoja na wafalme","poem":2},{"lineBreak":true},{"text":"na kuwatukuza milele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lakini ikiwa watu wamefungwa kwenye minyororo,","poem":1},{"text":"wakiwa wameshikiliwa na kamba za mateso,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"huwaonyesha yale waliyoyatenda,","poem":1},{"text":"kwamba wametenda dhambi kwa majivuno.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Huwafanya wao kusikia maonyo,","poem":1},{"text":"na huwaagiza kutubu uovu wao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kama wakitii na kumtumikia,","poem":1},{"text":"wataishi siku zao zilizobaki katika mafanikio,","poem":2},{"lineBreak":true},{"text":"na miaka yao katika utoshelevu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini wasiposikiliza,","poem":1},{"text":"wataangamia kwa upanga,","poem":2},{"lineBreak":true},{"text":"nao watakufa pasipo maarifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Wasiomcha Mungu moyoni mwao huficha chuki;","poem":1},{"text":"hata anapowafunga, hawamwombi msaada.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wanakufa wangali vijana,","poem":1},{"text":"miongoni mwa wanaume hanithi wa mahali pa kuabudia miungu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bali wao wanaoteseka huwaokoa katika mateso yao,","poem":1},{"text":"na kuzungumza nao katika dhiki zao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Yeye anakubembeleza utoke katika mataya ya dhiki,","poem":1},{"text":"ili kukuweka mahali palipo na nafasi mbali na kizuizi,","poem":2},{"lineBreak":true},{"text":"hadi kwenye meza yako ya faraja iliyojaa vyakula vizuri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lakini sasa umelemewa na hukumu kwa ajili ya uovu;","poem":1},{"text":"hukumu na haki vimekukamata.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uwe mwangalifu ili yeyote asikushawishi kwa utajiri;","poem":1},{"text":"usipotoshwe kwa fungu kubwa la rushwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Je, utajiri wako hata nguvu zako nyingi","poem":1},{"text":"vinaweza kukusaidia usiingie kwenye dhiki?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Usiutamani usiku uje,","poem":1},{"text":"ili uwaburute watu mbali na nyumba zao.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Jihadhari usigeukie uovu,","poem":1},{"text":"ambao unaupenda zaidi kuliko mateso.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Mungu ametukuzwa katika nguvu zake.","poem":1},{"text":"Ni nani aliye mwalimu kama yeye?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ni nani aliyemwelekeza katika njia zake,","poem":1},{"text":"au kumwambia, ‘Wewe umetenda yasiyo sawa’?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kumbuka kuzitukuza kazi zake,","poem":1},{"text":"ambazo watu wamezisifu katika wimbo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wanadamu wote wameiona;","poem":1},{"text":"watu wanaikazia macho kwa mbali.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Tazama jinsi Mungu alivyo mkuu,","poem":1},{"text":"kupita ufahamu wetu!","poem":2},{"lineBreak":true},{"text":"Hesabu ya miaka yake haitafutiki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Yeye huvuta juu matone ya maji,","poem":1},{"text":"ayachujayo kama mvua kutoka kwenye vijito;","poem":2}]},{"type":"verse","number":28,"content":[{"text":"mawingu huangusha chini maji yake,","poem":1},{"text":"nayo mvua nyingi huwanyeshea wanadamu.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ni nani ajuaye jinsi ayatandazavyo mawingu,","poem":1},{"text":"jinsi angurumavyo kutoka hemani mwake.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Tazama jinsi anavyotandaza umeme wa radi kumzunguka,","poem":1},{"text":"naye huvifunika vilindi vya bahari.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Hivi ndivyo atawalavyo mataifa,","poem":1},{"text":"na kuwapa chakula kwa wingi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Huujaza mkono wake kwa umeme wa radi,","poem":1},{"text":"na kuuagiza kulenga shabaha yake.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Ngurumo zake hutangaza dhoruba inayokuja;","poem":1},{"text":"hata mifugo hujulisha kukaribia kwake.","poem":2},{"noteId":20}]},{"type":"line_break"}],"footnotes":[{"noteId":20,"caller":"+","text":"Au: hutangaza kuja kwake.","reference":{"chapter":36,"verse":33}}]},"thisChapterLink":"/api/swh_bib/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}