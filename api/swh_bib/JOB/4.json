{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_bib","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"6108580dc3c0892279519d5ad515e900453b83da00c0a21efaad0faf5098e47d","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_bib/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifazi Anazungumza: Ayubu Ametenda Dhambi"]},{"type":"verse","number":1,"content":["Ndipo Elifazi Mtemani akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Kama mtu akithubutu kuzungumza nawe,","poem":1},{"text":"kutakukasirisha?","poem":2},{"text":"Lakini ni nani awezaye","poem":1},{"text":"kujizuia asiseme?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fikiri jinsi ambavyo umewafundisha watu wengi,","poem":1},{"text":"jinsi ambavyo umeitia nguvu","poem":2},{"lineBreak":true},{"text":"mikono iliyokuwa dhaifu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maneno yako yamewategemeza wale waliojikwaa;","poem":1},{"text":"umeyatia nguvu magoti yaliyokuwa dhaifu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lakini sasa hii taabu imekujia wewe,","poem":1},{"text":"nawe unashuka moyo;","poem":2},{"text":"imekupiga wewe,","poem":1},{"text":"nawe unafadhaika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, kumcha Mungu kwako hakupaswi kuwa","poem":1},{"text":"ndiyo matumaini yako","poem":2},{"text":"na njia zako kutokuwa na lawama","poem":1},{"text":"ndilo taraja lako?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Fikiri sasa: Ni mtu yupi asiye na hatia ambaye aliwahi kuangamia?","poem":1},{"text":"Ni wapi wanyofu waliwahi kuangamizwa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa jinsi ambavyo mimi nimechunguza,","poem":1},{"text":"wale walimao ubaya","poem":2},{"text":"na wale hupanda uovu,","poem":1},{"text":"huvuna hayo hayo hayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa pumzi ya Mungu huangamizwa;","poem":1},{"text":"kwa mshindo wa hasira zake huangamia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Simba anaweza kunguruma na kukoroma,","poem":1},{"text":"lakini bado meno ya simba mkubwa huvunjika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Simba anaweza kuangamia kwa kukosa mawindo,","poem":1},{"text":"nao wana wa simba jike hutawanyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Neno lililetwa kwangu kwa siri,","poem":1},{"text":"masikio yangu yakasikia mnongʼono wake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Katikati ya ndoto za kutia wasiwasi wakati wa usiku,","poem":1},{"text":"hapo usingizi mzito uwapatapo wanadamu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"hofu na kutetemeka kulinishika","poem":1},{"text":"na kufanya mifupa yangu yote itetemeke.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kuna roho aliyepita mbele ya uso wangu,","poem":1},{"text":"nazo nywele za mwili wangu zikasimama.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yule roho akasimama,","poem":1},{"text":"lakini sikuweza kutambua kilikuwa kitu gani.","poem":2},{"text":"Umbo fulani lilisimama mbele ya macho yangu,","poem":1},{"text":"kukawa na ukimya kisha nikasikia sauti:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘Je, binadamu aweza kuwa mwadilifu kuliko Mungu?","poem":1},{"text":"Je, mtu aweza kuwa safi kuliko Muumba wake?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kama Mungu hawaamini watumishi wake,","poem":1},{"text":"kama yeye huwalaumu malaika zake kwa kukosea,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ni mara ngapi zaidi wale waishio katika nyumba","poem":1},{"text":"za udongo wa mfinyanzi,","poem":2},{"text":"ambazo misingi yake ipo mavumbini,","poem":1},{"text":"ambao wamepondwa kama nondo!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kati ya mawio na machweo","poem":1},{"text":"huvunjwa vipande vipande;","poem":2},{"text":"bila yeyote kutambua,","poem":1},{"text":"huangamia milele.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Je, kamba za hema yao hazikungʼolewa,","poem":1},{"text":"hivyo hufa bila hekima?’","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}