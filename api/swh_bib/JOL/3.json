{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOL","translationId":"swh_bib","name":"Yoeli","commonName":"Yoeli","title":"Yoeli","order":29,"numberOfChapters":3,"sha256":"a5a0cfa1033109a678185ffce469a5a0626e6a82a478ad962a3d7accf449e824","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Mataifa Yahukumiwa"]},{"type":"verse","number":1,"content":[{"text":"“Katika siku hizo na wakati huo,","poem":1},{"text":"nitakaporejesha neema ya Yuda na Yerusalemu,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"nitayakusanya mataifa yote na kuyaleta","poem":1},{"text":"katika Bonde la Yehoshafati","poem":2},{"noteId":1},{"text":"Hapo nitaingia kwenye hukumu dhidi yao","poem":1},{"text":"kuhusu urithi wangu, watu wangu Israeli,","poem":2},{"text":"kwa kuwa waliwatawanya watu wangu","poem":1},{"text":"miongoni mwa mataifa","poem":2},{"lineBreak":true},{"text":"na kuigawa nchi yangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wanawapigia kura watu wangu","poem":1},{"text":"na kuwauza wavulana ili kupata makahaba;","poem":2},{"text":"waliwauza wasichana","poem":1},{"text":"ili wapate kunywa mvinyo.","poem":2}]},{"type":"verse","number":4,"content":["“Sasa una nini dhidi yangu, ee Tiro na Sidoni, nanyi nchi zote za Ufilisti? Je, mnanilipiza kwa yale niliyoyafanya? Kama mnalipa, mimi nitalipiza juu ya vichwa vyenu kwa kasi na kwa haraka yale mliyoyatenda."]},{"type":"verse","number":5,"content":["Kwa kuwa mlichukua fedha na dhahabu yangu pia mkabeba hazina zangu nzuri sana mkapeleka kwenye mahekalu yenu."]},{"type":"verse","number":6,"content":["Mliwauza watu wa Yuda na Yerusalemu kwa Wayunani, ili kwamba mpate kuwapeleka mbali na nchi yao."]},{"type":"verse","number":7,"content":["“Tazama nitawaamsha kutoka zile sehemu mlizowauza, nami nitawalipiza juu ya vichwa vyenu kile mlichofanya."]},{"type":"verse","number":8,"content":["Nitawauza wana wenu na binti zenu kwa watu wa Yuda, nao watawauza kwa Waseba, taifa lililo mbali.” Bwana amesema."]},{"type":"verse","number":9,"content":[{"text":"Tangazeni hili miongoni mwa mataifa:","poem":1},{"text":"Jiandaeni kwa vita!","poem":2},{"text":"Amsha askari!","poem":1},{"text":"Wanaume wote wapiganaji","poem":2},{"lineBreak":true},{"text":"wasogee karibu na kushambulia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Majembe yenu yafueni yawe panga","poem":1},{"text":"na miundu yenu ya kukatia iwe mikuki.","poem":2},{"text":"Aliye dhaifu na aseme,","poem":1},{"text":"“Mimi nina nguvu!”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Njooni haraka, ninyi mataifa yote kutoka pande zote,","poem":1},{"text":"kusanyikeni huko.","poem":2},{"lineBreak":true},{"text":"Shusha wapiganaji wako, Ee Bwana!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Mataifa na yaamshwe;","poem":1},{"text":"na yasonge mbele kuelekea Bonde la Yehoshafati,","poem":2},{"text":"kwa kuwa nitaketi mahali pale","poem":1},{"text":"kuhukumu mataifa yote yaliyoko kila upande.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tia mundu,","poem":1},{"text":"kwa kuwa mavuno yamekomaa.","poem":2},{"text":"Njooni, mkanyage zabibu,","poem":1},{"text":"kwa kuwa shinikizo la kukamua zabibu limejaa","poem":2},{"lineBreak":true},{"text":"na mapipa yanafurika:","poem":2},{"text":"kwa kuwa uovu wao ni mkubwa!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Umati mkubwa, umati mkubwa","poem":1},{"text":"katika bonde la uamuzi!","poem":2},{"text":"Kwa kuwa siku ya Bwana ni karibu","poem":1},{"text":"katika bonde la uamuzi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Jua na mwezi vitatiwa giza,","poem":1},{"text":"na nyota hazitatoa mwanga wake tena.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bwana atanguruma kutoka Sayuni","poem":1},{"text":"na mshindo wa ngurumo kutoka Yerusalemu;","poem":2},{"lineBreak":true},{"text":"dunia na mbingu vitatikisika.","poem":2},{"text":"Lakini Bwana atakuwa kimbilio la watu wake,","poem":1},{"text":"ngome imara kwa ajili ya watu wa Israeli.","poem":2}]},{"type":"heading","content":["Baraka Kwa Watu Wa Mungu"]},{"type":"verse","number":17,"content":[{"text":"“Ndipo mtakapojua kwamba Mimi, Bwana Mungu wenu,","poem":1},{"text":"nakaa Sayuni, mlima wangu mtakatifu.","poem":2},{"text":"Yerusalemu utakuwa mtakatifu;","poem":1},{"text":"kamwe wageni hawatavamia tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Katika siku hiyo milima itadondosha divai mpya,","poem":1},{"text":"na vilima vitatiririka maziwa;","poem":2},{"lineBreak":true},{"text":"mabonde yote ya Yuda yatatiririka maji.","poem":2},{"text":"Chemchemi itatiririka kutoka kwenye nyumba ya Bwana","poem":1},{"text":"na kunywesha Bonde la Shitimu.","poem":2},{"noteId":2}]},{"type":"verse","number":19,"content":[{"text":"Lakini Misri itakuwa ukiwa,","poem":1},{"text":"Edomu itakuwa jangwa tupu,","poem":2},{"text":"kwa sababu ya jeuri waliofanya kwa watu wa Yuda,","poem":1},{"text":"ambao katika nchi yao","poem":2},{"lineBreak":true},{"text":"walimwaga damu isiyo na hatia.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Yuda itakaliwa na watu milele","poem":1},{"text":"na Yerusalemu itadumu vizazi vyote.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hatia yao ya damu, ambayo sijasamehe,","poem":1},{"text":"nitasamehe.”","poem":2},{"lineBreak":true},"Bwana anakaa Sayuni!"]}],"footnotes":[{"noteId":1,"caller":"+","text":"Yehoshafati maana yake Bwana huhukumu.","reference":{"chapter":3,"verse":2}},{"noteId":2,"caller":"+","text":"Au: Bonde la Migunga.","reference":{"chapter":3,"verse":18}}]},"thisChapterLink":"/api/swh_bib/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}