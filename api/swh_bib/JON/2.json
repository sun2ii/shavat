{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JON","translationId":"swh_bib","name":"Yona","commonName":"Yona","title":"Yona","order":32,"numberOfChapters":4,"sha256":"33d9b4a5fbdbea779fa02150b1d58c966b3983b356834f9b6a84a4ff1a200ede","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/swh_bib/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Maombi Ya Yona Katika Tumbo La Nyangumi"]},{"type":"verse","number":1,"content":["Akiwa ndani ya tumbo la nyangumi, Yona alimwomba Bwana Mungu wake."]},{"type":"verse","number":2,"content":["Akasema:",{"text":"“Katika shida yangu nalimwita Bwana,","poem":1},{"text":"naye akanijibu.","poem":2},{"text":"Kutoka kina cha kaburi","poem":1},{"noteId":1},{"text":"niliomba msaada,","poem":1},{"text":"nawe ukasikiliza kilio changu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ulinitupa kwenye kilindi,","poem":1},{"text":"ndani kabisa ya moyo wa bahari,","poem":2},{"lineBreak":true},{"text":"mikondo ya maji ilinizunguka,","poem":2},{"text":"mawimbi yako yote na viwimbi","poem":1},{"text":"vilipita juu yangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nikasema, ‘Nimefukuziwa","poem":1},{"text":"mbali na uso wako,","poem":2},{"text":"hata hivyo nitatazama tena","poem":1},{"text":"kuelekea Hekalu lako takatifu.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maji yaliyonimeza yalinitisha,","poem":1},{"text":"kilindi kilinizunguka;","poem":2},{"lineBreak":true},{"text":"mwani","poem":2},{"noteId":2},{"text":"ulijisokota kichwani pangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nilizama chini sana mpaka pande za mwisho za milima,","poem":1},{"text":"makomeo ya hiyo nchi yalinifungia hata milele.","poem":2},{"text":"Lakini uliuleta uhai wangu kutoka shimoni,","poem":1},{"text":"Ee Bwana Mungu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wakati uhai wangu ulipokuwa unatoka,","poem":1},{"text":"nilikukumbuka wewe, Bwana,","poem":2},{"text":"nayo maombi yangu yalikufikia wewe,","poem":1},{"text":"katika Hekalu lako takatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Wale watu wanaongʼangʼana na sanamu zisizofaa","poem":1},{"text":"hupoteza neema ile ambayo ingekuwa yao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lakini mimi, kwa wimbo wa shukrani,","poem":1},{"text":"nitakutolea dhabihu.","poem":2},{"text":"Lile nililowekea nadhiri nitalitimiza.","poem":1},{"text":"Wokovu watoka kwa Bwana.”","poem":2}]},{"type":"verse","number":10,"content":["Basi Bwana akamwamuru yule nyangumi, naye akamtapika Yona katika nchi kavu."]}],"footnotes":[{"noteId":1,"caller":"+","text":"Kaburi hapa maana yake ni Kuzimu, kwa Kiebrania ni Sheol.","reference":{"chapter":2,"verse":2}},{"noteId":2,"caller":"+","text":"Mwani hapa maana yake ni magugu yaotayo kwenye sakafu ya kilindi cha bahari.","reference":{"chapter":2,"verse":5}}]},"thisChapterLink":"/api/swh_bib/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}