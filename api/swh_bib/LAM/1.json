{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"LAM","translationId":"swh_bib","name":"Maombolezo","commonName":"Maombolezo","title":"Maombolezo","order":25,"numberOfChapters":5,"sha256":"f1212bb650acd2ba687c25ea471e773e8b46092acde85ceaac39708c8c067f7f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swh_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"Tazama jinsi mji ulivyoachwa ukiwa,","poem":1},{"text":"mji ambao zamani ulikuwa umejaa watu!","poem":2},{"text":"Jinsi ambavyo umekuwa kama mama mjane,","poem":1},{"text":"ambaye wakati fulani alikuwa maarufu miongoni mwa mataifa!","poem":2},{"text":"Yule ambaye alikuwa malkia miongoni mwa majimbo","poem":1},{"text":"sasa amekuwa mtumwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kwa uchungu, hulia sana usiku,","poem":1},{"text":"machozi yapo kwenye mashavu yake.","poem":2},{"text":"Miongoni mwa wapenzi wake wote","poem":1},{"text":"hakuna yeyote wa kumfariji.","poem":2},{"text":"Rafiki zake wote wamemsaliti,","poem":1},{"text":"wamekuwa adui zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Baada ya mateso na kufanyishwa kazi kikatili,","poem":1},{"text":"Yuda amekwenda uhamishoni.","poem":2},{"text":"Anakaa miongoni mwa mataifa,","poem":1},{"text":"hapati mahali pa kupumzika.","poem":2},{"text":"Wote ambao wanamsaka wamemkamata","poem":1},{"text":"katikati ya dhiki yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Barabara zielekeazo Sayuni zaomboleza,","poem":1},{"text":"kwa kuwa hakuna yeyote anayekuja","poem":2},{"lineBreak":true},{"text":"kwenye sikukuu zake zilizoamriwa.","poem":2},{"text":"Malango yake yote yamekuwa ukiwa,","poem":1},{"text":"makuhani wake wanalia kwa uchungu,","poem":2},{"text":"wanawali wake wanahuzunika,","poem":1},{"text":"naye yuko katika uchungu wa maumivu makuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Adui zake wamekuwa mabwana zake,","poem":1},{"text":"watesi wake wana raha.","poem":2},{"text":"Bwana amemletea huzuni","poem":1},{"text":"kwa sababu ya dhambi zake nyingi.","poem":2},{"text":"Watoto wake wamekwenda uhamishoni,","poem":1},{"text":"mateka mbele ya adui.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Fahari yote imeondoka","poem":1},{"text":"kutoka kwa Binti Sayuni.","poem":2},{"text":"Wakuu wake wako kama ayala","poem":1},{"text":"ambaye hapati malisho,","poem":2},{"text":"katika udhaifu wamekimbia","poem":1},{"text":"mbele ya anayewasaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Katika siku za mateso yake na kutangatanga,","poem":1},{"text":"Yerusalemu hukumbuka hazina zote","poem":2},{"lineBreak":true},{"text":"ambazo zilikuwa zake siku za kale.","poem":2},{"text":"Wakati watu wake walipoanguka katika mikono ya adui,","poem":1},{"text":"hapakuwepo na yeyote wa kumsaidia.","poem":2},{"text":"Watesi wake walimtazama","poem":1},{"text":"na kumcheka katika maangamizi yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalemu ametenda dhambi sana","poem":1},{"text":"kwa hiyo amekuwa najisi.","poem":2},{"text":"Wote waliomheshimu wanamdharau,","poem":1},{"text":"kwa maana wameuona uchi wake.","poem":2},{"text":"Yeye mwenyewe anapiga kite","poem":1},{"text":"na kugeukia mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uchafu wake umegandamana na nguo zake;","poem":1},{"text":"hakuwaza juu ya maisha yake ya baadaye.","poem":2},{"text":"Anguko lake lilikuwa la kushangaza,","poem":1},{"text":"hapakuwepo na yeyote wa kumfariji.","poem":2},{"text":"“Tazama, Ee Bwana, teso langu,","poem":1},{"text":"kwa maana adui ameshinda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Adui ametia mikono","poem":1},{"text":"juu ya hazina zake zote,","poem":2},{"text":"aliona mataifa ya kipagani","poem":1},{"text":"wakiingia mahali patakatifu pake,","poem":2},{"text":"wale uliowakataza kuingia","poem":1},{"text":"kwenye kusanyiko lako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Watu wake wote wanalia kwa uchungu","poem":1},{"text":"watafutapo chakula;","poem":2},{"text":"wanabadilisha hazina zao kwa chakula","poem":1},{"text":"ili waweze kuendelea kuishi.","poem":2},{"text":"“Tazama, Ee Bwana, ufikiri,","poem":1},{"text":"kwa maana nimedharauliwa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Je, si kitu kwenu, ninyi nyote mpitao kando?","poem":1},{"text":"Angalieni kote mwone.","poem":2},{"text":"Je, kuna maumivu kama maumivu yangu","poem":1},{"text":"yale yaliyotiwa juu yangu,","poem":2},{"text":"yale Bwana aliyoyaleta juu yangu","poem":1},{"text":"katika siku ya hasira yake kali?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Kutoka juu alipeleka moto,","poem":1},{"text":"akaushusha katika mifupa yangu.","poem":2},{"text":"Aliitandia wavu miguu yangu","poem":1},{"text":"na akanirudisha nyuma.","poem":2},{"text":"Akanifanya mkiwa,","poem":1},{"text":"na mdhaifu mchana kutwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Dhambi zangu zimefungwa kwenye nira,","poem":1},{"text":"kwa mikono yake zilifumwa pamoja.","poem":2},{"text":"Zimefika shingoni mwangu","poem":1},{"text":"na Bwana ameziondoa nguvu zangu.","poem":2},{"text":"Amenitia mikononi mwa wale","poem":1},{"text":"ambao siwezi kushindana nao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Bwana amewakataa wapiganaji wa vita","poem":1},{"text":"wote walio kati yangu,","poem":2},{"text":"ameagiza jeshi dhidi yangu","poem":1},{"text":"kuwaponda vijana wangu wa kiume.","poem":2},{"text":"Katika shinikizo lake la divai Bwana amemkanyaga","poem":1},{"text":"Bikira Binti Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Hii ndiyo sababu ninalia","poem":1},{"text":"na macho yangu yanafurika machozi.","poem":2},{"text":"Hakuna yeyote aliye karibu kunifariji,","poem":1},{"text":"hakuna yeyote wa kuhuisha roho yangu.","poem":2},{"text":"Watoto wangu ni wakiwa","poem":1},{"text":"kwa sababu adui ameshinda.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sayuni ananyoosha mikono yake,","poem":1},{"text":"lakini hakuna yeyote wa kumfariji.","poem":2},{"text":"Bwana ametoa amri kwa ajili ya Yakobo","poem":1},{"text":"kwamba majirani zake wawe adui zake;","poem":2},{"lineBreak":true},{"text":"Yerusalemu umekuwa","poem":2},{"lineBreak":true},{"text":"kitu najisi miongoni mwao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Bwana ni mwenye haki,","poem":1},{"text":"hata hivyo niliasi dhidi ya amri yake.","poem":2},{"text":"Sikilizeni, enyi mataifa yote,","poem":1},{"text":"tazameni maumivu yangu.","poem":2},{"text":"Wavulana wangu na wasichana wangu","poem":1},{"text":"wamekwenda uhamishoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Niliita washirika wangu","poem":1},{"text":"lakini walinisaliti.","poem":2},{"text":"Makuhani wangu na wazee wangu","poem":1},{"text":"waliangamia mjini","poem":2},{"text":"walipokuwa wakitafuta chakula","poem":1},{"text":"ili waweze kuishi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Angalia, Ee Bwana, jinsi nilivyo katika dhiki!","poem":1},{"text":"Nina maumivu makali ndani yangu,","poem":2},{"text":"nami ninahangaika moyoni mwangu,","poem":1},{"text":"kwa kuwa nimekuwa mwasi sana.","poem":2},{"text":"Huko nje, upanga unaua watu,","poem":1},{"text":"ndani, kipo kifo tu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Watu wamesikia ninavyolia kwa uchungu,","poem":1},{"text":"lakini hakuna yeyote wa kunifariji.","poem":2},{"text":"Adui zangu wote wamesikia juu ya dhiki yangu,","poem":1},{"text":"wanafurahia lile ulilolitenda.","poem":2},{"text":"Naomba uilete siku uliyoitangaza","poem":1},{"text":"ili wawe kama mimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Uovu wao wote na uje mbele zako;","poem":1},{"text":"uwashughulikie wao","poem":2},{"text":"kama vile ulivyonishughulikia mimi","poem":1},{"text":"kwa sababu ya dhambi zangu zote.","poem":2},{"text":"Kulia kwangu kwa uchungu ni kwingi","poem":1},{"text":"na moyo wangu umedhoofika.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}