{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"LAM","translationId":"swh_bib","name":"Maombolezo","commonName":"Maombolezo","title":"Maombolezo","order":25,"numberOfChapters":5,"sha256":"f1212bb650acd2ba687c25ea471e773e8b46092acde85ceaac39708c8c067f7f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swh_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Mimi ndiye mtu aliyeona mateso","poem":1},{"text":"kwa fimbo ya ghadhabu yake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amenifukuzia mbali na kunifanya nitembee","poem":1},{"text":"gizani wala si katika nuru;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"hakika, amegeuza mkono wake dhidi yangu","poem":1},{"text":"tena na tena, mchana kutwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Amefanya ngozi yangu na nyama yangu kuchakaa","poem":1},{"text":"na ameivunja mifupa yangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amenizingira na kunizunguka","poem":1},{"text":"kwa uchungu na taabu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amenifanya niishi gizani","poem":1},{"text":"kama wale waliokufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Amenizungushia ukuta ili nisiweze kutoroka,","poem":1},{"text":"amenifunga kwa minyororo mizito.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hata ninapoita au kulia ili kuomba msaada,","poem":1},{"text":"anakataa kupokea maombi yangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ameizuia njia yangu kwa mapande ya mawe,","poem":1},{"text":"amepotosha njia zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kama dubu aviziaye,","poem":1},{"text":"kama simba mafichoni,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ameniburuta kutoka njia,","poem":1},{"text":"akanirarua na kuniacha bila msaada.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Amevuta upinde wake","poem":1},{"text":"na kunifanya mimi niwe lengo","poem":2},{"lineBreak":true},{"text":"kwa ajili ya mishale yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Alinichoma moyo wangu kwa mishale","poem":1},{"text":"iliyotoka kwenye podo lake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nimekuwa kichekesho kwa watu wangu wote,","poem":1},{"text":"wananidhihaki kwa wimbo mchana kutwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Amenijaza kwa majani machungu","poem":1},{"text":"na kunishibisha kwa nyongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Amevunja meno yangu kwa changarawe,","poem":1},{"text":"amenikanyagia mavumbini.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Amani yangu imeondolewa,","poem":1},{"text":"nimesahau kufanikiwa ni nini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa hiyo nasema, “Fahari yangu imeondoka","poem":1},{"text":"na yale yote niliyokuwa nimetarajia kutoka kwa Bwana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nayakumbuka mateso yangu na kutangatanga kwangu,","poem":1},{"text":"uchungu na nyongo.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ninayakumbuka vyema,","poem":1},{"text":"nayo nafsi yangu imezimia ndani yangu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hata hivyo najikumbusha neno hili","poem":1},{"text":"na kwa hiyo ninalo tumaini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Kwa sababu ya upendo mkuu wa Bwana, hatuangamii,","poem":1},{"text":"kwa kuwa huruma zake hazikomi kamwe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ni mpya kila asubuhi,","poem":1},{"text":"uaminifu wako ni mkuu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nimeiambia nafsi yangu, “Bwana ni fungu langu,","poem":1},{"text":"kwa hiyo nitamngojea.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Bwana ni mwema kwa wale ambao tumaini lao ni kwake,","poem":1},{"text":"kwa yule ambaye humtafuta;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ni vyema kungojea kwa utulivu","poem":1},{"text":"kwa ajili ya wokovu wa Bwana.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ni vyema mtu kuchukua nira","poem":1},{"text":"bado angali kijana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Na akae peke yake awe kimya,","poem":1},{"text":"kwa maana Bwana ameiweka juu yake.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Na azike uso wake mavumbini","poem":1},{"text":"bado panawezekana kuwa na matumaini.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Na atoe shavu lake kwa yule ampigaye,","poem":1},{"text":"na ajazwe na aibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Kwa kuwa watu hawakatiliwi mbali","poem":1},{"text":"na Bwana milele.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ingawa huleta huzuni, ataonyesha huruma,","poem":1},{"text":"kwa kuwa upendo wake usiokoma ni mkuu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kwa maana hapendi kuwaletea mateso","poem":1},{"text":"au huzuni watoto wa wanadamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Kuwaponda chini ya nyayo","poem":1},{"text":"wafungwa wote katika nchi,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kumnyima mtu haki zake","poem":1},{"text":"mbele za Aliye Juu Sana,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"kumnyima mtu haki:","poem":1},{"text":"Je, Bwana asione mambo kama haya?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Nani awezaye kusema nalo likatendeka","poem":1},{"text":"kama Bwana hajaamuru?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Je, si ni kwenye kinywa cha Aliye Juu Sana","poem":1},{"text":"ndiko yatokako maafa na mambo mema?","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Mwanadamu yeyote aliye hai aweza kulalamika","poem":1},{"text":"wakati anapoadhibiwa kwa ajili ya dhambi zake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Tuzichunguze njia zetu na kuzijaribu,","poem":1},{"text":"na tumrudie Bwana Mungu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Tuinue mioyo yetu pamoja na mikono yetu","poem":1},{"text":"kwa Mungu mbinguni, na tuseme:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“Tumetenda dhambi na kuasi","poem":1},{"text":"nawe hujasamehe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“Umejifunika mwenyewe kwa hasira na kutufuatilia;","poem":1},{"text":"umetuchinja bila huruma.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Unajifunika mwenyewe kwa wingu,","poem":1},{"text":"ili pasiwe na ombi","poem":2},{"lineBreak":true},{"text":"litakaloweza kupenya.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Umetufanya takataka na uchafu","poem":1},{"text":"miongoni mwa mataifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“Adui zetu wote wamefumbua vinywa vyao","poem":1},{"text":"wazi dhidi yetu.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Tumeteseka kwa hofu kuu na shida ya ghafula,","poem":1},{"text":"uharibifu na maangamizi.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Vijito vya machozi vinatiririka kutoka machoni mwangu,","poem":1},{"text":"kwa sababu watu wangu wameangamizwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Macho yangu yatatiririka machozi bila kukoma,","poem":1},{"text":"bila kupata nafuu,","poem":2}]},{"type":"verse","number":50,"content":[{"text":"hadi Bwana atazame chini","poem":1},{"text":"kutoka mbinguni na kuona.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Lile ninaloliona huniletea huzuni nafsini","poem":1},{"text":"kwa sababu ya wanawake wote wa mji wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Wale waliokuwa adui zangu bila sababu","poem":1},{"text":"wameniwinda kama ndege.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Walijaribu kukomesha maisha yangu ndani ya shimo","poem":1},{"text":"na kunitupia mawe;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"maji yalifunika juu ya kichwa changu,","poem":1},{"text":"nami nikafikiri nilikuwa karibu","poem":2},{"lineBreak":true},{"text":"kukatiliwa mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"Nililiitia jina lako, Ee Bwana,","poem":1},{"text":"kutoka vina vya shimo.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Ulisikia ombi langu: “Usikizibie masikio yako","poem":1},{"text":"kilio changu nikuombapo msaada.”","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Ulikuja karibu nilipokuita,","poem":1},{"text":"nawe ukasema, “Usiogope.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"Ee Bwana, ulichukua shauri langu,","poem":1},{"text":"ukaukomboa uhai wangu.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Umeona, Ee Bwana, ubaya niliotendewa.","poem":1},{"text":"Tetea shauri langu!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Umeona kina cha kisasi chao,","poem":1},{"text":"mashauri yao yote mabaya dhidi yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"Ee Bwana, umesikia matukano yao,","poem":1},{"text":"mashauri yao yote mabaya dhidi yangu:","poem":2}]},{"type":"verse","number":62,"content":[{"text":"kile adui zangu wanachonongʼona na kunungʼunikia","poem":1},{"text":"dhidi yangu mchana kutwa.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Watazame! Wakiwa wameketi au wamesimama,","poem":1},{"text":"wananidhihaki katika nyimbo zao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"Uwalipe kile wanachostahili, Ee Bwana,","poem":1},{"text":"kwa yale ambayo mikono yao imetenda.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"Weka pazia juu ya mioyo yao,","poem":1},{"text":"laana yako na iwe juu yao!","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Wafuatilie katika hasira na uwaangamize","poem":1},{"text":"kutoka chini ya mbingu za Bwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}