{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"LAM","translationId":"swh_bib","name":"Maombolezo","commonName":"Maombolezo","title":"Maombolezo","order":25,"numberOfChapters":5,"sha256":"f1212bb650acd2ba687c25ea471e773e8b46092acde85ceaac39708c8c067f7f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swh_bib/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Jinsi dhahabu ilivyopoteza mngʼao wake,","poem":1},{"text":"dhahabu iliyo safi haingʼai!","poem":2},{"text":"Vito vya thamani vimetawanywa","poem":1},{"text":"kwenye mwanzo wa kila barabara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Wana wa Sayuni wenye thamani,","poem":1},{"text":"ambao mwanzo uzito wa thamani yao","poem":2},{"lineBreak":true},{"text":"ulikuwa wa dhahabu,","poem":2},{"text":"sasa wanaangaliwa kama vyungu vya udongo,","poem":1},{"text":"kazi ya mikono ya mfinyanzi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hata mbweha hutoa matiti yao","poem":1},{"text":"kunyonyesha watoto wao,","poem":2},{"text":"lakini watu wangu wamekuwa wasio na huruma","poem":1},{"text":"kama mbuni jangwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwa sababu ya kiu ulimi wa mtoto mchanga","poem":1},{"text":"umegandamana na kaakaa la kinywa chake,","poem":2},{"text":"watoto huomba mkate,","poem":1},{"text":"lakini hakuna yeyote awapaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wale waliokula vyakula vya kifahari","poem":1},{"text":"ni maskini barabarani.","poem":2},{"text":"Wale waliokuzwa wakivaa nguo za zambarau","poem":1},{"text":"sasa wanalalia majivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Adhabu ya watu wangu","poem":1},{"text":"ni kubwa kuliko ile ya Sodoma,","poem":2},{"text":"ambayo ilipinduliwa ghafula","poem":1},{"text":"bila kuwepo mkono wa msaada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wakuu wao walikuwa wamengʼaa kuliko theluji","poem":1},{"text":"na weupe kuliko maziwa,","poem":2},{"text":"miili yao ilikuwa myekundu kuliko marijani,","poem":1},{"text":"kuonekana kwao kama yakuti samawi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lakini sasa ni weusi kuliko masizi;","poem":1},{"text":"hawatambulikani barabarani.","poem":2},{"text":"Ngozi yao imeshikamana juu ya mifupa yao,","poem":1},{"text":"imekuwa mikavu kama fimbo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wale waliouawa kwa upanga ni bora","poem":1},{"text":"kuliko wale wanaokufa njaa;","poem":2},{"text":"wanateseka kwa njaa, wanatokomea","poem":1},{"text":"kwa kukosa chakula kutoka shambani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kwa mikono yao wenyewe wanawake wenye huruma","poem":1},{"text":"wanapika watoto wao wenyewe,","poem":2},{"text":"waliokuwa chakula chao","poem":1},{"text":"watu wangu walipoangamizwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bwana ametoa nafasi kamilifu ya ghadhabu yake;","poem":1},{"text":"ameimwaga hasira yake kali.","poem":2},{"text":"Amewasha moto katika Sayuni","poem":1},{"text":"ambao umeteketeza misingi yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wafalme wa dunia hawakuamini,","poem":1},{"text":"wala mtu yeyote wa duniani,","poem":2},{"text":"kwamba adui na watesi wangeweza kuingia","poem":1},{"text":"kwenye malango ya Yerusalemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini hili lilitokea kwa sababu ya dhambi za manabii wake,","poem":1},{"text":"na maovu ya makuhani wake,","poem":2},{"text":"waliomwaga ndani yake","poem":1},{"text":"damu ya wenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Sasa wanapapasa papasa barabarani","poem":1},{"text":"kama watu ambao ni vipofu.","poem":2},{"text":"Wamenajisiwa kabisa kwa damu,","poem":1},{"text":"hata hakuna anayethubutu kugusa mavazi yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Watu wanawapigia kelele, “Ondokeni! Ninyi ni najisi!","poem":1},{"text":"Ondokeni! Ondokeni! Msituguse!”","poem":2},{"text":"Wanapokimbia na kutangatanga huku na huko,","poem":1},{"text":"watu miongoni mwa mataifa wanasema,","poem":2},{"lineBreak":true},{"text":"“Hawawezi kukaa hapa zaidi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bwana mwenyewe amewatawanya;","poem":1},{"text":"hawaangalii tena.","poem":2},{"text":"Makuhani hawaonyeshwi heshima,","poem":1},{"text":"wazee hawakubaliki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Zaidi ya hayo, macho yetu yalichoka,","poem":1},{"text":"kwa kutazamia bure msaada;","poem":2},{"text":"tuliangalia kutoka minara yetu","poem":1},{"text":"kwa taifa lisiloweza kutuokoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Watu walituvizia katika kila hatua","poem":1},{"text":"hata hatukuweza kutembea katika barabara zetu.","poem":2},{"text":"Mwisho wetu ulikuwa karibu, siku zetu zilikuwa zimetimia,","poem":1},{"text":"kwa maana mwisho wetu ulikuwa umefika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Waliotufuatia walikuwa wepesi","poem":1},{"text":"kuliko tai angani;","poem":2},{"lineBreak":true},{"text":"walitusaka juu milimani","poem":2},{"lineBreak":true},{"text":"na kutuvizia jangwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mpakwa mafuta wa Bwana, pumzi ya uhai wetu hasa,","poem":1},{"text":"alinaswa katika mitego yao.","poem":2},{"text":"Tulifikiri kwamba chini ya kivuli chake","poem":1},{"text":"tungeliweza kuishi miongoni mwa mataifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Shangilia na ufurahi, ee Binti Edomu,","poem":1},{"text":"wewe unayeishi nchi ya Usi.","poem":2},{"text":"Lakini kwako pia kikombe kitapitishwa,","poem":1},{"text":"Utalewa na kuvuliwa nguo ubaki uchi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ee Binti Sayuni, adhabu yako itaisha,","poem":1},{"text":"hatarefusha muda wako wa kukaa uhamishoni.","poem":2},{"text":"Lakini, ee Binti Edomu, ataadhibu dhambi yako,","poem":1},{"text":"na atafunua uovu wako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}