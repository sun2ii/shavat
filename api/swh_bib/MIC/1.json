{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"655c7fe3c73ed447489bee9b4def6de20725f25f88856303c2840065c672f77b","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Neno la Bwana lilimjia Mika, Mmoreshethi, wakati wa utawala wa Yothamu, Ahazi na Hezekia, wafalme wa Yuda; ufunuo aliouona kuhusu Samaria na Yerusalemu."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sikieni, enyi mataifa, enyi nyote,","poem":1},{"text":"sikilizeni, ee dunia na wote mliomo ndani yake,","poem":2},{"text":"ili Bwana Mwenyezi ashuhudie dhidi yenu,","poem":1},{"text":"Bwana kutoka Hekalu lake takatifu.","poem":2}]},{"type":"heading","content":["Hukumu Dhidi Ya Samaria Na Yerusalemu"]},{"type":"verse","number":3,"content":[{"text":"Tazama! Bwana anakuja kutoka mahali pake;","poem":1},{"text":"anashuka na kukanyaga","poem":2},{"lineBreak":true},{"text":"mahali palipoinuka juu pa dunia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Milima inayeyuka chini yake","poem":1},{"text":"na mabonde yanagawanyika","poem":2},{"text":"kama nta mbele ya moto,","poem":1},{"text":"kama maji yatiririkayo kasi","poem":2},{"lineBreak":true},{"text":"kwenye mteremko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yote haya ni kwa sababu ya kosa la Yakobo,","poem":1},{"text":"ni kwa sababu ya dhambi za nyumba ya Israeli.","poem":2},{"text":"Kosa la Yakobo ni lipi?","poem":1},{"text":"Je, sio Samaria?","poem":2},{"text":"Je, mahali pa juu pa Yuda pa kuabudia miungu ni nini?","poem":1},{"text":"Je, sio Yerusalemu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Kwa hiyo nitaufanya Samaria kuwa lundo la kokoto,","poem":1},{"text":"mahali pa kuotesha mizabibu.","poem":2},{"text":"Nitayamwaga mawe yake katika bonde","poem":1},{"text":"na kuacha wazi misingi yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sanamu zake zote","poem":1},{"text":"zitavunjwa vipande vipande;","poem":2},{"text":"zawadi zake zote za Hekalu","poem":1},{"text":"zitachomwa kwa moto;","poem":2},{"lineBreak":true},{"text":"nitaharibu vinyago vyake vyote.","poem":2},{"text":"Kwa kuwa alikusanya zawadi zake","poem":1},{"text":"kutokana na ujira wa kahaba,","poem":2},{"text":"nazo zitatumika tena","poem":1},{"text":"kulipa mishahara ya kahaba.”","poem":2}]},{"type":"heading","content":["Kulia Na Kuomboleza"]},{"type":"verse","number":8,"content":[{"text":"Kwa ajili ya hili nitalia na kuomboleza;","poem":1},{"text":"nitatembea bila viatu na tena uchi.","poem":2},{"text":"Nitabweka kama mbweha","poem":1},{"text":"na kuomboleza kama bundi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa sababu jeraha lake halitibiki;","poem":1},{"text":"limekuja Yuda.","poem":2},{"text":"Limefika hasa kwenye lango la watu wangu,","poem":1},{"text":"hata Yerusalemu kwenyewe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Usiliseme hili huko Gathi;","poem":1},{"text":"usilie hata kidogo.","poem":2},{"text":"Huko Beth-le-Afra","poem":1},{"text":"gaagaa mavumbini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Piteni mkiwa uchi na wenye aibu,","poem":1},{"text":"ninyi mkaao Shafiri.","poem":2},{"text":"Wale waishio Saanani","poem":1},{"text":"hawatatoka nje.","poem":2},{"text":"Beth-Eseli iko katika maombolezo;","poem":1},{"text":"kinga yake imeondolewa kwako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wale waishio Marothi wanagaagaa kwa maumivu","poem":1},{"text":"wakingoja msaada,","poem":2},{"text":"kwa sababu maangamizi yamekuja","poem":1},{"text":"kutoka kwa Bwana,","poem":2},{"lineBreak":true},{"text":"hata katika lango la Yerusalemu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Enyi mkaao Lakishi,","poem":1},{"text":"fungeni farasi kwenye magari ya vita.","poem":2},{"text":"Mlikuwa chanzo cha dhambi","poem":1},{"text":"kwa Binti Sayuni,","poem":2},{"text":"kwa kuwa makosa ya Israeli","poem":1},{"text":"yalikutwa kwako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa hiyo utaipa Moresheth-Gathi","poem":1},{"text":"zawadi za kuagana.","poem":2},{"text":"Mji wa Akzibu utaonyesha wazi udanganyifu","poem":1},{"text":"kwa wafalme wa Israeli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitawaleteeni atakayewashinda","poem":1},{"text":"ninyi mnaoishi Maresha.","poem":2},{"text":"Yeye aliye utukufu wa Israeli","poem":1},{"text":"atakuja Adulamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nyoeni nywele zenu katika kuomboleza","poem":1},{"text":"kwa ajili ya watoto wenu mnaowafurahia;","poem":2},{"text":"jifanyieni upara kama tai,","poem":1},{"text":"kwa kuwa watawaacha","poem":2},{"lineBreak":true},{"text":"na kwenda uhamishoni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}