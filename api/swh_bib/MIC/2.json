{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"655c7fe3c73ed447489bee9b4def6de20725f25f88856303c2840065c672f77b","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Mipango Ya Mwanadamu Na Ya Mungu"]},{"type":"verse","number":1,"content":[{"text":"Ole kwa wale wapangao uovu,","poem":1},{"text":"kwa wale wafanyao shauri la hila vitandani mwao!","poem":2},{"text":"Kunapopambazuka wanalitimiza","poem":1},{"text":"kwa sababu uko katika uwezo wao kutekeleza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wanatamani mashamba na kuyakamata,","poem":1},{"text":"pia nyumba na kuzichukua.","poem":2},{"text":"Wanamlaghai mwanaume nyumba yake,","poem":1},{"text":"mwanadamu mwenzake urithi wake.","poem":2}]},{"type":"verse","number":3,"content":["Kwa hiyo, Bwana asema:",{"text":"“Ninapanga maangamizi dhidi ya watu hawa,","poem":1},{"text":"ambayo hamwezi kujiokoa wenyewe.","poem":2},{"text":"Hamtatembea tena kwa majivuno,","poem":1},{"text":"kwa kuwa utakuwa ni wakati wa maafa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Siku hiyo watu watawadhihaki,","poem":1},{"text":"watawafanyia mzaha","poem":2},{"lineBreak":true},{"text":"kwa wimbo huu wa maombolezo:","poem":2},{"text":"‘Tumeangamizwa kabisa;","poem":1},{"text":"mali ya watu wangu imegawanywa.","poem":2},{"text":"Ameninyangʼanya!","poem":1},{"text":"Ametoa mashamba yetu kwa wasaliti.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa hiyo hutakuwa na yeyote katika kusanyiko la Bwana","poem":1},{"text":"wa kugawanya mashamba kwa kura.","poem":2}]},{"type":"heading","content":["Manabii Wa Uongo"]},{"type":"verse","number":6,"content":[{"text":"Manabii wao husema, “Usitabiri.","poem":1},{"text":"Usitabiri kuhusu vitu hivi;","poem":2},{"lineBreak":true},{"text":"aibu haitatupata.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je, ingesemwa, ee nyumba ya Yakobo:","poem":1},{"text":"“Je, Roho wa Bwana amekasirika?","poem":2},{"lineBreak":true},{"text":"Je, yeye hufanya vitu kama hivyo?”","poem":2},{"lineBreak":true},{"text":"“Je, maneno yangu hayamfanyii mema","poem":1},{"text":"yeye ambaye njia zake ni nyofu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siku hizi watu wangu wameinuka","poem":1},{"text":"kama adui.","poem":2},{"text":"Unawavua joho la kitajiri wale wanaopita","poem":1},{"text":"pasipo kujali,","poem":2},{"lineBreak":true},{"text":"kama watu warudio kutoka vitani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unawahamisha wanawake wa watu wangu","poem":1},{"text":"kutoka kwenye nyumba zao za kupendeza.","poem":2},{"text":"Unaondoa baraka yangu","poem":1},{"text":"kwa watoto wao milele.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inuka, nenda zako!","poem":1},{"text":"Kwa maana hapa sio mahali pako pa kupumzikia,","poem":2},{"text":"kwa sababu pametiwa unajisi,","poem":1},{"text":"pameharibiwa, wala hapatengenezeki tena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ikiwa mwongo na mdanganyifu atakuja na kusema,","poem":1},{"text":"‘Nitawatabiria divai na pombe kwa wingi,’","poem":2},{"text":"angekuwa ndiye nabii","poem":1},{"text":"anayekubalika na watu hawa!","poem":2}]},{"type":"heading","content":["Ahadi Ya Ukombozi"]},{"type":"verse","number":12,"content":[{"text":"“Hakika nitawakusanya ninyi nyote, ee Yakobo,","poem":1},{"text":"Hakika nitawaleta pamoja mabaki ya Israeli.","poem":2},{"text":"Nitawaleta pamoja kama kondoo ndani ya zizi,","poem":1},{"text":"kama kundi kwenye malisho yake,","poem":2},{"lineBreak":true},{"text":"mahali hapa patakuwa na msongamano wa watu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yeye afunguaye njia atawatangulia;","poem":1},{"text":"watapita kwenye lango na kutoka nje.","poem":2},{"text":"Mfalme wao atawatangulia,","poem":1},{"text":"Bwana atakuwa kiongozi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}