{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"655c7fe3c73ed447489bee9b4def6de20725f25f88856303c2840065c672f77b","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Viongozi Na Manabii Wakemewa"]},{"type":"verse","number":1,"content":["Kisha nikasema,",{"text":"“Sikilizeni enyi viongozi wa Yakobo,","poem":1},{"text":"enyi watawala wa nyumba ya Israeli.","poem":2},{"text":"Je, hampaswi kujua hukumu,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ninyi mnaochukia mema","poem":2},{"lineBreak":true},{"text":"na kupenda maovu;","poem":2},{"text":"ninyi mnaowachuna watu wangu ngozi","poem":1},{"text":"na kuondoa nyama kwenye mifupa yao;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ninyi mnaokula nyama ya watu wangu,","poem":1},{"text":"mnaowachuna ngozi","poem":2},{"lineBreak":true},{"text":"na kuvunja mifupa yao vipande vipande;","poem":2},{"text":"mnaowakatakata kama nyama","poem":1},{"text":"ya kuwekwa kwenye sufuria","poem":2},{"text":"na kama nyama","poem":1},{"text":"ya kuwekwa kwenye chungu?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kisha watamlilia Bwana,","poem":1},{"text":"lakini hatawajibu.","poem":2},{"text":"Wakati huo atawaficha uso wake","poem":1},{"text":"kwa sababu ya uovu waliotenda.","poem":2}]},{"type":"verse","number":5,"content":["Hili ndilo asemalo Bwana:",{"text":"“Kuhusu manabii wanaowapotosha watu wangu,","poem":1},{"text":"mtu akiwalisha,","poem":2},{"lineBreak":true},{"text":"wanatangaza ‘amani’;","poem":2},{"text":"kama hakufanya hivyo,","poem":1},{"text":"wanaandaa kupigana vita dhidi yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa hiyo usiku utawajieni, msiweze kuwa na maono,","poem":1},{"text":"na giza, msiweze kubashiri.","poem":2},{"text":"Jua litawachwea manabii hao,","poem":1},{"text":"nao mchana utakuwa giza kwao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waonaji wataaibika","poem":1},{"text":"na waaguzi watafedheheka.","poem":2},{"text":"Wote watafunika nyuso zao","poem":1},{"text":"kwa sababu hakuna jibu litokalo kwa Mungu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lakini kuhusu mimi, nimejazwa nguvu,","poem":1},{"text":"nimejazwa Roho wa Bwana,","poem":2},{"lineBreak":true},{"text":"haki na uweza,","poem":2},{"text":"kumtangazia Yakobo kosa lake,","poem":1},{"text":"na Israeli dhambi yake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sikieni hili, enyi viongozi wa nyumba ya Yakobo,","poem":1},{"text":"enyi watawala wa nyumba ya Israeli,","poem":2},{"text":"mnaodharau haki","poem":1},{"text":"na kupotosha kila lililo sawa;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"mnaojenga Sayuni kwa kumwaga damu","poem":1},{"text":"na Yerusalemu kwa uovu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Viongozi wake wanahukumu kwa rushwa,","poem":1},{"text":"na makuhani wake wanafundisha kwa malipo,","poem":2},{"lineBreak":true},{"text":"nao manabii wake wanatabiri kwa fedha.","poem":2},{"text":"Hata hivyo wanamwegemea Bwana na kusema,","poem":1},{"text":"“Je, Bwana si yumo miongoni mwetu?","poem":2},{"lineBreak":true},{"text":"Hakuna maafa yatakayotupata.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa hiyo kwa sababu yenu,","poem":1},{"text":"Sayuni italimwa kama shamba,","poem":2},{"text":"Yerusalemu itakuwa lundo la kokoto,","poem":1},{"text":"na kilima cha Hekalu","poem":2},{"text":"kitakuwa kichuguu","poem":1},{"text":"kilichofunikwa na vichaka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}