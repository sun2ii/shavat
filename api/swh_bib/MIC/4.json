{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"655c7fe3c73ed447489bee9b4def6de20725f25f88856303c2840065c672f77b","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Mlima Wa Bwana"]},{"type":"verse","number":1,"content":["Katika siku za mwisho",{"text":"mlima wa Hekalu la Bwana utaimarishwa","poem":1},{"text":"kama mlima mkuu miongoni mwa milima yote;","poem":2},{"text":"utainuliwa juu ya vilima,","poem":1},{"text":"na watu wa mataifa watamiminika humo.","poem":2}]},{"type":"verse","number":2,"content":["Mataifa mengi yatakuja na kusema,",{"text":"“Njooni, twendeni mlimani mwa Bwana,","poem":1},{"text":"kwenye nyumba ya Mungu wa Yakobo.","poem":2},{"text":"Atatufundisha njia zake,","poem":1},{"text":"ili tuweze kuenenda katika mapito yake.”","poem":2},{"text":"Sheria itatoka Sayuni,","poem":1},{"text":"neno la Bwana litatoka Yerusalemu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Atahukumu kati ya mataifa mengi,","poem":1},{"text":"na ataamua migogoro ya mataifa","poem":2},{"lineBreak":true},{"text":"yenye nguvu na yaliyo mbali.","poem":2},{"text":"Watafua panga zao ziwe majembe,","poem":1},{"text":"na mikuki yao kuwa miundu ya kukata matawi.","poem":2},{"text":"Taifa halitainua upanga dhidi ya taifa jingine,","poem":1},{"text":"wala hawatajifunza vita tena.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kila mtu ataketi chini ya mzabibu wake","poem":1},{"text":"na chini ya mtini wake,","poem":2},{"text":"wala hakuna mtu atakayewaogopesha,","poem":1},{"text":"kwa kuwa Bwana Mwenye Nguvu Zote amesema.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mataifa yote yanaweza kutembea","poem":1},{"text":"katika jina la miungu yao;","poem":2},{"text":"sisi tutatembea katika jina la Bwana","poem":1},{"text":"Mungu wetu milele na milele.","poem":2}]},{"type":"heading","content":["Mpango Wa Bwana"]},{"type":"verse","number":6,"content":["“Katika siku hiyo,” asema Bwana,",{"text":"“nitawakusanya walemavu;","poem":1},{"text":"nitawakusanya walio uhamishoni","poem":2},{"lineBreak":true},{"text":"na wale niliowahuzunisha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nitawafanya walemavu kuwa mabaki,","poem":1},{"text":"wale waliofukuzwa kuwa taifa lenye nguvu.","poem":2},{"text":"Bwana atatawala juu yao katika Mlima Sayuni","poem":1},{"text":"kuanzia siku hiyo na hata milele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lakini kuhusu wewe, ee mnara wa ulinzi wa kundi,","poem":1},{"text":"ee ngome ya Binti Sayuni,","poem":2},{"text":"milki ya awali itarudishwa kwako,","poem":1},{"text":"ufalme utakuja kwa Binti Yerusalemu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kwa nini sasa unalia kwa nguvu:","poem":1},{"text":"kwani huna mfalme?","poem":2},{"text":"Je, mshauri wako amekufa, hata maumivu yakukamate","poem":1},{"text":"kama ya mwanamke","poem":2},{"lineBreak":true},{"text":"aliye na utungu wa kuzaa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaagaa kwa utungu, ee Binti Sayuni,","poem":1},{"text":"kama mwanamke mwenye utungu wa kuzaa,","poem":2},{"text":"kwa kuwa sasa ni lazima uuache mji","poem":1},{"text":"ukapige kambi uwanjani.","poem":2},{"text":"Utakwenda Babeli;","poem":1},{"text":"huko utaokolewa.","poem":2},{"text":"Huko Bwana atakukomboa","poem":1},{"text":"kutoka mikononi mwa adui zako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakini sasa mataifa mengi","poem":1},{"text":"yamekusanyika dhidi yako.","poem":2},{"text":"Wanasema, “Mwache anajisiwe,","poem":1},{"text":"macho yetu na yatazame Sayuni kwa furaha!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini hawayajui","poem":1},{"text":"mawazo ya Bwana;","poem":2},{"text":"hawauelewi mpango wake,","poem":1},{"text":"yeye awakusanyaye kama miganda","poem":2},{"lineBreak":true},{"text":"kwenye sakafu ya kupuria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Inuka upure, ee Binti Sayuni,","poem":1},{"text":"kwa kuwa nitakupa pembe za chuma;","poem":2},{"text":"nitakupa kwato za shaba","poem":1},{"text":"na utavunja vipande vipande mataifa mengi.”","poem":2},{"lineBreak":true},{"text":"Utatoa mapato yao waliopata kwa udanganyifu kwa Bwana,","poem":1},{"text":"utajiri wao kwa Bwana wa dunia yote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}