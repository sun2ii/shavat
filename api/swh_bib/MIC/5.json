{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"655c7fe3c73ed447489bee9b4def6de20725f25f88856303c2840065c672f77b","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Mtawala Aliyeahidiwa Kutoka Bethlehemu"]},{"type":"verse","number":1,"content":[{"text":"Panga majeshi yako, ee mji wa majeshi,","poem":1},{"text":"kwa kuwa kuzingirwa kumepangwa dhidi yetu.","poem":2},{"text":"Watampiga mtawala wa Israeli","poem":1},{"text":"shavuni kwa fimbo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Lakini wewe, Bethlehemu Efrathi,","poem":1},{"text":"ingawa u mdogo miongoni mwa koo za Yuda,","poem":2},{"text":"kutoka kwako atatokea kwa ajili yangu","poem":1},{"text":"yeye atakayekuwa mtawala katika Israeli,","poem":2},{"text":"ambaye asili yake ni kutoka zamani,","poem":1},{"text":"kutoka milele.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwa hiyo Israeli utaachwa mpaka wakati","poem":1},{"text":"mwanamke aliye na utungu atakapozaa","poem":2},{"text":"na ndugu zake wengine warudi","poem":1},{"text":"kujiunga na Waisraeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Atasimama na kulichunga kundi lake","poem":1},{"text":"katika nguvu ya Bwana,","poem":2},{"lineBreak":true},{"text":"katika utukufu wa jina la Bwana Mungu wake.","poem":2},{"text":"Nao wataishi kwa usalama, kwa kuwa wakati huo","poem":1},{"text":"ukuu wake utaenea hadi miisho ya dunia.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naye atakuwa amani yao.","poem":2},"Ukombozi Na Uharibifu",{"text":"Wakati Mwashuru atakapovamia nchi yetu","poem":1},{"text":"na kupita katika ngome zetu,","poem":2},{"text":"tutawainua wachungaji saba dhidi yake,","poem":1},{"text":"hata viongozi wanane wa watu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wataitawala nchi ya Ashuru kwa upanga,","poem":1},{"text":"nchi ya Nimrodi kwa upanga.","poem":2},{"text":"Atatuokoa kutoka kwa Mwashuru","poem":1},{"text":"atakapoivamia nchi yetu","poem":2},{"lineBreak":true},{"text":"na kuingia katika mipaka yetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mabaki ya Yakobo yatakuwa","poem":1},{"text":"katikati ya mataifa mengi","poem":2},{"text":"kama umande kutoka kwa Bwana,","poem":1},{"text":"kama manyunyu juu ya majani,","poem":2},{"text":"ambayo hayamngoji mtu","poem":1},{"text":"wala kukawia kwa mwanadamu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mabaki ya Yakobo yatakuwa miongoni mwa mataifa,","poem":1},{"text":"katikati ya mataifa mengi,","poem":2},{"text":"kama simba miongoni mwa wanyama wa msituni,","poem":1},{"text":"kama mwana simba miongoni","poem":2},{"lineBreak":true},{"text":"mwa makundi ya kondoo,","poem":2},{"text":"ambaye anaumiza vibaya na kuwararua","poem":1},{"text":"kila anapopita katikati yao,","poem":2},{"lineBreak":true},{"text":"wala hakuna awezaye kuokoa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mkono wako utainuliwa juu kwa ushindi juu ya watesi wako,","poem":1},{"text":"nao adui zako wote wataangamizwa.","poem":2}]},{"type":"verse","number":10,"content":["“Katika siku ile,” asema Bwana,",{"text":"“nitaangamiza farasi zenu katikati yenu","poem":1},{"text":"na kubomoa magari yenu ya vita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nitaiangamiza miji ya nchi yenu","poem":1},{"text":"na kuziangusha chini ngome zenu zote.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitaangamiza uchawi wenu","poem":1},{"text":"na hamtapiga tena ramli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nitaangamiza vinyago vyenu vya kuchonga","poem":1},{"text":"na mawe yenu ya ibada yatoke katikati yenu;","poem":2},{"text":"hamtasujudia tena","poem":1},{"text":"kazi ya mikono yenu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitangʼoa nguzo za Ashera katikati yenu","poem":1},{"text":"na kubomoa miji yenu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitalipiza kisasi kwa hasira na ghadhabu","poem":1},{"text":"juu ya mataifa ambayo hayajanitii.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}