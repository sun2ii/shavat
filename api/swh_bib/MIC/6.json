{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_bib","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"655c7fe3c73ed447489bee9b4def6de20725f25f88856303c2840065c672f77b","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_bib/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["Shauri La Bwana Dhidi Ya Israeli"]},{"type":"verse","number":1,"content":["Sikiliza asemalo Bwana:",{"text":"“Simama, tetea shauri lako mbele ya milima;","poem":1},{"text":"vilima na visikie lile unalotaka kusema.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sikilizeni, ee milima, mashtaka ya Bwana,","poem":1},{"text":"sikilizeni, enyi misingi ya milele ya dunia.","poem":2},{"text":"Kwa kuwa Bwana ana shauri dhidi ya watu wake;","poem":1},{"text":"anatoa mashtaka dhidi ya Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Watu wangu, nimewatendea nini?","poem":1},{"lineBreak":true},{"text":"Nimewalemea kwa jinsi gani? Mnijibu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Nimewatoa kutoka Misri na kuwakomboa","poem":1},{"text":"kutoka nchi ya utumwa.","poem":2},{"text":"Nilimtuma Mose awaongoze,","poem":1},{"text":"pia Aroni na Miriamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Watu wangu, kumbukeni jinsi Balaki mfalme wa Moabu","poem":1},{"text":"alivyofanya shauri","poem":2},{"lineBreak":true},{"text":"na kile Balaamu mwana wa Beori alichojibu.","poem":2},{"text":"Kumbukeni safari yenu kutoka Shitimu mpaka Gilgali,","poem":1},{"text":"ili mfahamu matendo ya haki ya Bwana.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nimjie Bwana na kitu gani na kusujudu","poem":1},{"text":"mbele za Mungu aliyetukuka?","poem":2},{"text":"Je, nije mbele zake na sadaka za kuteketezwa,","poem":1},{"text":"nije na ndama za mwaka mmoja?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je, Bwana atafurahishwa na kondoo dume elfu,","poem":1},{"text":"au mito elfu kumi ya mafuta?","poem":2},{"text":"Je, nimtoe mzaliwa wangu wa kwanza kwa ajili ya kosa langu,","poem":1},{"text":"mtoto wangu mwenyewe","poem":2},{"lineBreak":true},{"text":"kwa ajili ya dhambi ya nafsi yangu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amekuonyesha yaliyo mema, ee mwanadamu.","poem":1},{"text":"Bwana anataka nini kwako?","poem":2},{"text":"Ila kutenda kwa haki na kupenda rehema,","poem":1},{"text":"na kwenda kwa unyenyekevu na Mungu wako.","poem":2}]},{"type":"heading","content":["Hatia Na Adhabu Ya Israeli"]},{"type":"verse","number":9,"content":[{"text":"Sikiliza! Bwana anauita mji:","poem":1},{"text":"kulicha jina lako ni hekima:","poem":2},{"lineBreak":true},{"text":"“Tii hiyo fimbo na yeye aliyeiamuru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Je, bado nisahau, ee nyumba ya uovu,","poem":1},{"text":"hazina yako uliyopata kwa udanganyifu","poem":2},{"text":"na vipimo vilivyopunguka,","poem":1},{"text":"ambavyo vimelaaniwa?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Je, naweza kuhukumu kuwa","poem":1},{"text":"mtu mwenye mizani ya udanganyifu hana hatia,","poem":2},{"lineBreak":true},{"text":"aliye na mfuko wa mawe ya kupimia ya uongo?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Matajiri wake ni wajeuri;","poem":1},{"text":"watu wake ni waongo","poem":2},{"text":"na ndimi zao zinazungumza","poem":1},{"text":"kwa udanganyifu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa hiyo, nimeanza kukuharibu,","poem":1},{"text":"kuwaangamiza kwa sababu ya dhambi zenu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mtakula lakini hamtashiba;","poem":1},{"text":"matumbo yenu bado yatakuwa matupu.","poem":2},{"text":"Mtaweka akiba lakini hamtaokoa chochote,","poem":1},{"text":"kwa sababu mtakachoweka akiba","poem":2},{"lineBreak":true},{"text":"nitatoa kwa upanga.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mtapanda lakini hamtavuna;","poem":1},{"text":"mtakamua zeituni lakini","poem":2},{"lineBreak":true},{"text":"hamtatumia mafuta yake.","poem":2},{"text":"Mtakamua zabibu","poem":1},{"text":"lakini hamtakunywa hiyo divai.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mmezishika sheria za Omri","poem":1},{"text":"na matendo yote ya nyumba ya Ahabu,","poem":2},{"lineBreak":true},{"text":"tena umefuata desturi zao.","poem":2},{"text":"Kwa hiyo nitakutoa kwa maangamizi","poem":1},{"text":"na watu wako kuwa dhihaka;","poem":2},{"lineBreak":true},{"text":"mtachukua dharau za mataifa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}