{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"NAM","translationId":"swh_bib","name":"Nahumu","commonName":"Nahumu","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"b818432654110f2e60a7fce4e02f664b7e1a4a94a87f76d95beac4299d129793","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Neno alilosema Mungu kuhusu Ninawi. Kitabu cha maono cha Nahumu, Mwelkoshi."]},{"type":"line_break"},{"type":"heading","content":["Hasira Ya Mungu Dhidi Ya Ninawi"]},{"type":"verse","number":2,"content":[{"text":"Bwana ni mwenye wivu na Mungu mlipiza kisasi;","poem":1},{"text":"Bwana hulipiza kisasi na amejaa ghadhabu.","poem":2},{"text":"Bwana hulipiza kisasi juu ya watesi wake,","poem":1},{"text":"naye anadumisha ghadhabu yake dhidi ya adui zake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bwana si mwepesi wa hasira naye ni mwenye nguvu,","poem":1},{"text":"Bwana hataacha kuadhibu wenye hatia.","poem":2},{"text":"Njia yake ipo katika kisulisuli na tufani,","poem":1},{"text":"na mawingu ni vumbi la miguu yake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anakemea bahari na kuikausha,","poem":1},{"text":"anafanya mito yote kukauka.","poem":2},{"text":"Bashani na Karmeli zinanyauka","poem":1},{"text":"na maua ya Lebanoni hukauka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Milima hutikisika mbele yake","poem":1},{"text":"na vilima huyeyuka.","poem":2},{"text":"Nchi hutetemeka mbele yake,","poem":1},{"text":"dunia na wote waishio ndani yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ni nani awezaye kuzuia hasira yake yenye uchungu?","poem":1},{"text":"Nani awezaye kuvumilia hasira yake kali?","poem":2},{"text":"Ghadhabu yake imemiminwa kama moto,","poem":1},{"text":"na miamba inapasuka mbele zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bwana ni Mwema,","poem":1},{"text":"kimbilio wakati wa taabu.","poem":2},{"text":"Huwatunza wale wanaomtegemea,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"lakini kwa mafuriko makubwa,","poem":2},{"text":"ataangamiza Ninawi;","poem":1},{"text":"atafuatilia adui zake hadi gizani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Shauri baya lolote wapangalo dhidi ya Bwana","poem":1},{"text":"yeye atalikomesha;","poem":2},{"lineBreak":true},{"text":"taabu haitatokea mara ya pili.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watasongwa katikati ya miiba","poem":1},{"text":"na kulewa kwa mvinyo wao.","poem":2},{"lineBreak":true},{"text":"Watateketezwa kama mabua makavu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Ninawi, kutoka kwako amejitokeza mmoja,","poem":1},{"text":"ambaye anapanga shauri baya","poem":2},{"text":"dhidi ya Bwana","poem":1},{"text":"na kushauri uovu.","poem":2}]},{"type":"verse","number":12,"content":["Hili ndilo asemalo Bwana:",{"text":"“Ingawa wana muungano nao ni wengi sana,","poem":1},{"text":"watakatiliwa mbali na kuangamia.","poem":2},{"text":"Ingawa nimekutesa wewe, ee Yuda,","poem":1},{"text":"sitakutesa tena.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sasa nitavunja nira zao kutoka shingo yako,","poem":1},{"text":"nami nitazivunjilia mbali pingu zako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hii ndiyo amri Bwana aliyoitoa kukuhusu wewe, Ninawi:","poem":1},{"text":"“Hutakuwa na wazao","poem":2},{"lineBreak":true},{"text":"watakaoendeleza jina lako.","poem":2},{"text":"Nitaharibu sanamu za kuchonga na sanamu za kuyeyusha","poem":1},{"text":"ambazo zipo katika hekalu la miungu yenu.","poem":2},{"text":"Nitaandaa kaburi lako,","poem":1},{"text":"kwa maana wewe ni mwovu kabisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tazama, huko juu milimani,","poem":1},{"text":"miguu ya huyo mmoja aletaye habari njema,","poem":2},{"lineBreak":true},{"text":"ambaye anatangaza amani!","poem":2},{"text":"Ee Yuda, sherehekea sikukuu zako,","poem":1},{"text":"nawe utimize nadhiri zako.","poem":2},{"text":"Waovu hawatakuvamia tena;","poem":1},{"text":"wataangamizwa kabisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}