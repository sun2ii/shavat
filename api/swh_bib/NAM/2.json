{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"NAM","translationId":"swh_bib","name":"Nahumu","commonName":"Nahumu","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"b818432654110f2e60a7fce4e02f664b7e1a4a94a87f76d95beac4299d129793","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Ninawi Kuanguka"]},{"type":"verse","number":1,"content":[{"text":"Mshambuliaji anasogea dhidi yako, Ninawi.","poem":1},{"text":"Linda ngome,","poem":2},{"lineBreak":true},{"text":"chunga barabara,","poem":2},{"lineBreak":true},{"text":"jitieni nguvu wenyewe,","poem":2},{"lineBreak":true},{"text":"kusanya nguvu zako zote!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwana atarudisha fahari ya Yakobo,","poem":1},{"text":"kama fahari ya Israeli,","poem":2},{"text":"ingawa waangamizi wamewaacha ukiwa","poem":1},{"text":"na wameharibu mizabibu yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngao za askari wake ni nyekundu,","poem":1},{"text":"mashujaa wamevaa nguo nyekundu.","poem":2},{"text":"Chuma kwenye magari ya vita chametameta,","poem":1},{"text":"katika siku aliyoyaweka tayari,","poem":2},{"lineBreak":true},{"text":"mikuki ya mierezi inametameta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Magari ya vita yanafanya msukosuko barabarani,","poem":1},{"text":"yakikimbia nyuma na mbele uwanjani.","poem":2},{"text":"Yanaonekana kama mienge ya moto;","poem":1},{"text":"yanakwenda kasi kama umeme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anaita vikosi vilivyochaguliwa,","poem":1},{"text":"lakini bado wanajikwaa njiani.","poem":2},{"text":"Wanakimbilia haraka kwenye ukuta wa mji,","poem":1},{"text":"ile ngao ya kuwakinga imetayarishwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Malango ya mto yamefunguliwa wazi,","poem":1},{"text":"na jumba la kifalme limeanguka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Imeagizwa kwamba mji uchukuliwe","poem":1},{"text":"na upelekwe uhamishoni.","poem":2},{"text":"Vijakazi wake wanaomboleza kama hua","poem":1},{"text":"na kupigapiga vifua vyao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ninawi ni kama dimbwi,","poem":1},{"text":"nayo maji yake yanakauka.","poem":2},{"text":"Wanalia, “Simama! Simama!”","poem":1},{"text":"Lakini hakuna anayegeuka nyuma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chukueni nyara za fedha!","poem":1},{"text":"Chukueni nyara za dhahabu!","poem":2},{"text":"Wingi wake hauna mwisho,","poem":1},{"text":"utajiri kutoka hazina zake zote!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ameharibiwa, ametekwa nyara, ameachwa uchi!","poem":1},{"text":"Mioyo inayeyuka, magoti yanalegea,","poem":2},{"text":"miili inatetemeka,","poem":1},{"text":"na kila uso umebadilika rangi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Liko wapi sasa pango la simba,","poem":1},{"text":"mahali ambapo waliwalisha watoto wao,","poem":2},{"text":"ambapo simba dume na simba jike walikwenda","poem":1},{"text":"na ambapo wana simba walikwenda","poem":2},{"lineBreak":true},{"text":"bila kuogopa chochote?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Simba aliua mawindo ya kutosha watoto wake,","poem":1},{"text":"alinyonga mawindo kwa ajili ya mwenzi wake,","poem":2},{"text":"akijaza makao yake kwa alivyoua","poem":1},{"text":"na mapango yake kwa mawindo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Bwana Mwenye Nguvu Zote anatangaza,","poem":1},{"text":"“Mimi ni kinyume na ninyi.","poem":2},{"text":"Magari yenu ya vita nitayateketeza kwa moto,","poem":1},{"text":"na upanga utakula wana simba wako.","poem":2},{"lineBreak":true},{"text":"Sitawaachia mawindo juu ya nchi.","poem":2},{"text":"Sauti za wajumbe wako","poem":1},{"text":"hazitasikika tena.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}