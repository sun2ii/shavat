{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"NAM","translationId":"swh_bib","name":"Nahumu","commonName":"Nahumu","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"b818432654110f2e60a7fce4e02f664b7e1a4a94a87f76d95beac4299d129793","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["Ole Wa Ninawi"]},{"type":"verse","number":1,"content":[{"text":"Ole wa mji umwagao damu,","poem":1},{"text":"uliojaa uongo,","poem":2},{"text":"umejaa nyara,","poem":1},{"text":"usiokosa kuwa na vitu vya kuteka nyara.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kelele za mijeledi,","poem":1},{"text":"vishindo vya magurudumu,","poem":2},{"text":"farasi waendao mbio","poem":1},{"text":"na mshtuo wa magari ya vita!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wapanda farasi wanaenda mbio,","poem":1},{"text":"panga zinameremeta,","poem":2},{"lineBreak":true},{"text":"na mikuki inangʼaa!","poem":2},{"text":"Majeruhi wengi,","poem":1},{"text":"malundo ya maiti,","poem":2},{"text":"idadi kubwa ya miili isiyohesabika,","poem":1},{"text":"watu wanajikwaa juu ya mizoga:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"yote haya kwa sababu ya wingi wa tamaa za kahaba,","poem":1},{"text":"anayeshawishi, bibi wa mambo ya uchawi,","poem":2},{"text":"anayewatia utumwani mataifa kwa ukahaba wake","poem":1},{"text":"na pia jamaa za watu kwa ulozi wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwana Mwenye Nguvu Zote anasema,","poem":1},{"text":"“Mimi ni kinyume na ninyi.","poem":2},{"lineBreak":true},{"text":"Nitafunika uso wako kwa gauni lako.","poem":2},{"text":"Nitaonyesha mataifa uchi wako","poem":1},{"text":"na falme aibu yako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nitakutupia uchafu,","poem":1},{"text":"nitakufanyia dharau","poem":2},{"lineBreak":true},{"text":"na kukufanya kioja.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wote wanaokuona watakukimbia na kusema,","poem":1},{"text":"‘Ninawi ipo katika kuangamia:","poem":2},{"text":"ni nani atakayeomboleza kwa ajili yake?’","poem":1},{"text":"Nitampata wapi yeyote wa kukufariji?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Je, wewe ni bora kuliko No-Amoni,","poem":1},{"text":"uliopo katika Mto Naili,","poem":2},{"lineBreak":true},{"text":"uliozungukwa na maji?","poem":2},{"text":"Mto ulikuwa kinga yake,","poem":1},{"text":"nayo maji yalikuwa ukuta wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kushi","poem":1},{"noteId":0},{"text":"na Misri walikuwa nguvu zake zisizo na mpaka;","poem":1},{"text":"Putu na Libia walikuwa miongoni mwa wale walioungana naye.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hata hivyo alichukuliwa mateka","poem":1},{"text":"na kwenda uhamishoni.","poem":2},{"text":"Watoto wake wachanga walivunjwa vunjwa vipande","poem":1},{"text":"kwenye mwanzo wa kila barabara.","poem":2},{"text":"Kura zilipigwa kwa watu wake wenye heshima,","poem":1},{"text":"na watu wake wote wakuu walifungwa kwa minyororo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wewe pia utalewa;","poem":1},{"text":"utakwenda mafichoni","poem":2},{"lineBreak":true},{"text":"na kutafuta kimbilio kutoka kwa adui.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ngome zako zote ni kama mitini","poem":1},{"text":"yenye matunda yake ya kwanza yaliyoiva;","poem":2},{"text":"wakati inapotikiswa,","poem":1},{"text":"tini huanguka kwenye kinywa chake alaye.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tazama vikosi vyako:","poem":1},{"text":"wote ni wanawake!","poem":2},{"text":"Malango ya nchi yako","poem":1},{"text":"yamekuwa wazi kwa adui zako;","poem":2},{"lineBreak":true},{"text":"moto umeteketeza mapingo yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Teka maji kwa ajili ya kuzingirwa kwako,","poem":1},{"text":"imarisha ulinzi wako,","poem":2},{"text":"Ufanyie udongo wa mfinyanzi kazi,","poem":1},{"text":"yakanyage matope,","poem":2},{"lineBreak":true},{"text":"karabati tanuru la kuchomea matofali!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Huko moto utakuteketeza,","poem":1},{"text":"huko upanga utakuangusha chini","poem":2},{"lineBreak":true},{"text":"na kama vile panzi, watakumaliza.","poem":2},{"text":"Ongezeka kama panzi,","poem":1},{"text":"ongezeka kama nzige!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Umeongeza idadi ya wafanyabiashara wako","poem":1},{"text":"mpaka wamekuwa wengi kuliko nyota za angani,","poem":2},{"text":"lakini kama nzige wanaacha nchi tupu","poem":1},{"text":"kisha huruka na kwenda zake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Walinzi wako ni kama nzige,","poem":1},{"text":"maafisa wako ni kama makundi ya nzige","poem":2},{"lineBreak":true},{"text":"watuao kwenye kuta wakati wa siku ya baridi:","poem":2},{"text":"lakini wakati jua linapotokea wanaruka kwenda zao,","poem":1},{"text":"na hakuna ajuaye waendako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ee mfalme wa Ashuru, wachungaji wako wanasinzia;","poem":1},{"text":"wakuu wako wanalala chini mavumbini kupumzika.","poem":2},{"text":"Watu wako wametawanyika juu ya milima","poem":1},{"text":"bila kuwa na mtu yeyote wa kuwakusanya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hakuna kitu kinachoweza kuponya jeraha lako;","poem":1},{"text":"jeraha lako ni la kukuua.","poem":2},{"text":"Kila anayesikia habari zako,","poem":1},{"text":"hupiga makofi kwa kuanguka kwako,","poem":2},{"text":"kwa kuwa ni nani ambaye hajaguswa","poem":1},{"text":"na ukatili wako usio na mwisho?","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kushi ni Ethiopia.","reference":{"chapter":3,"verse":9}}]},"thisChapterLink":"/api/swh_bib/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}