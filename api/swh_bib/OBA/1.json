{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"OBA","translationId":"swh_bib","name":"Obadia","commonName":"Obadia","title":"Obadia","order":31,"numberOfChapters":1,"sha256":"d5402590879d00436a4eb3e931a05afa93fabccbdf0d83972c3778de518df4ed","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/swh_bib/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Maono ya Obadia.",{"lineBreak":true},{"lineBreak":true},"Hili ndilo asemalo Bwana Mwenyezi kuhusu Edomu:",{"text":"Tumesikia ujumbe kutoka kwa Bwana:","poem":1},{"text":"Mjumbe alitumwa kwa mataifa kusema,","poem":2},{"text":"“Inukeni, twendeni tukapigane vita dhidi yake.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Angalieni, nitawafanya wadogo miongoni mwa mataifa,","poem":1},{"text":"mtadharauliwa kabisa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kiburi cha moyo wako kimekudanganya,","poem":1},{"text":"wewe unayeishi katika majabali ya miamba","poem":2},{"lineBreak":true},{"text":"na kufanya makao yako juu,","poem":2},{"text":"wewe unayejiambia mwenyewe,","poem":1},{"text":"‘Ni nani awezaye kunishusha chini?’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ingawa unapaa juu kama tai","poem":1},{"text":"na kufanya kiota chako kati ya nyota,","poem":2},{"lineBreak":true},{"text":"nitakushusha chini kutoka huko,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"verse","number":5,"content":[{"text":"“Ikiwa wevi wangekuja kwako,","poem":1},{"text":"ikiwa wanyangʼanyi wangekujia usiku:","poem":2},{"text":"Lo! Tazama ni maafa kiasi gani yangekuwa yanakungojea:","poem":1},{"text":"je, si wangeiba tu kiasi ambacho wangehitaji?","poem":2},{"text":"Kama wachuma zabibu wangekuja kwako,","poem":1},{"text":"je, wasingebakiza zabibu chache?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lakini tazama jinsi Esau atakavyotekwa,","poem":1},{"text":"jinsi hazina zake zilizofichwa zitatekwa nyara!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wote ulioungana nao watakufukuza hadi mpakani,","poem":1},{"text":"rafiki zako watakudanganya na kukushinda,","poem":2},{"text":"wale wanaokula mkate wako watakutegea mtego,","poem":1},{"text":"lakini hutaweza kuugundua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Katika siku hiyo,” asema Bwana,","poem":1},{"text":"“je, sitaangamiza watu wenye hekima wa Edomu,","poem":2},{"lineBreak":true},{"text":"watu wenye ufahamu katika milima ya Esau?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Temani, mashujaa wako watatiwa hofu,","poem":1},{"text":"kila mmoja katika milima ya Esau","poem":2},{"lineBreak":true},{"text":"ataangushwa chini kwa kuchinjwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa sababu ya jeuri uliyofanya dhidi ya ndugu yako Yakobo,","poem":1},{"text":"aibu itakufunika;","poem":2},{"lineBreak":true},{"text":"utaangamizwa milele.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siku ile ulisimama mbali ukiangalia","poem":1},{"text":"wakati wageni walipojichukulia utajiri wake","poem":2},{"text":"na watu wa nchi nyingine walipoingia malango yake","poem":1},{"text":"wakipiga kura kwa ajili ya Yerusalemu,","poem":2},{"lineBreak":true},{"text":"ulikuwa kama mmoja wao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Usingemdharau ndugu yako","poem":1},{"text":"katika siku ya msiba wake,","poem":2},{"text":"wala kufurahia juu ya watu wa Yuda","poem":1},{"text":"katika siku ya maangamizi yao,","poem":2},{"text":"wala kujigamba sana","poem":1},{"text":"katika siku ya taabu yao.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Usingeingia katika malango ya watu wangu","poem":1},{"text":"katika siku ya maafa yao,","poem":2},{"text":"wala kuwadharau katika janga lao","poem":1},{"text":"katika siku ya maafa yao,","poem":2},{"text":"wala kunyangʼanya mali zao","poem":1},{"text":"katika siku ya maafa yao.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Usingengoja kwenye njia panda","poem":1},{"text":"na kuwaua wakimbizi wao,","poem":2},{"text":"wala kuwatoa watu wake waliosalia","poem":1},{"text":"katika siku ya shida yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Siku ya Bwana iko karibu","poem":1},{"text":"kwa mataifa yote.","poem":2},{"text":"Kama ulivyofanya, nawe utafanyiwa vivyo hivyo,","poem":1},{"text":"matendo yako yatakurudia juu ya kichwa chako.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kama vile ulivyokunywa juu ya mlima wangu mtakatifu,","poem":1},{"text":"vivyo hivyo mataifa yote watakunywa mfululizo,","poem":2},{"text":"watakunywa na kunywa,","poem":1},{"text":"nao watatoweka kana kwamba hawajawahi kuwepo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lakini katika Mlima Sayuni kutakuwepo","poem":1},{"text":"na wale watakaookoka;","poem":2},{"lineBreak":true},{"text":"nao utakuwa mtakatifu,","poem":2},{"text":"nayo nyumba ya Yakobo","poem":1},{"text":"itamiliki urithi wake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nyumba ya Yakobo itakuwa moto,","poem":1},{"text":"na nyumba ya Yosefu itakuwa mwali wa moto;","poem":2},{"text":"nayo nyumba ya Esau itakuwa bua kavu,","poem":1},{"text":"nao wataiwasha moto na kuiteketeza.","poem":2},{"text":"Hakutakuwa na watakaosalimika","poem":1},{"text":"kutoka nyumba ya Esau.”","poem":2},{"text":"Bwana amesema.","poem":4}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Watu kutoka nchi ya Negebu","poem":1},{"text":"wataikalia milima ya Esau,","poem":2},{"text":"na watu kutoka miteremko ya vilima","poem":1},{"text":"watamiliki nchi ya Wafilisti.","poem":2},{"text":"Watayakalia mashamba ya Efraimu na Samaria,","poem":1},{"text":"naye Benyamini atamiliki Gileadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kundi la Waisraeli walioko uhamishoni Kanaani","poem":1},{"text":"watarudi na kumiliki nchi mpaka Sarepta.","poem":2},{"text":"Walioko uhamishoni Sefaradi kutoka Yerusalemu","poem":1},{"text":"watamiliki miji ya Negebu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Waokoaji watakwea juu ya Mlima Sayuni","poem":1},{"text":"kutawala milima ya Esau.","poem":2},{"lineBreak":true},{"text":"Nao ufalme utakuwa wa Bwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}