{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_bib","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"f60d9d80608cd39bf4c0da488bd373d715d03ee27685ce659875ae65a0e6d805","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["Utangulizi: Kusudi Na Kiini"]},{"type":"verse","number":1,"content":["Mithali za Solomoni mwana wa Daudi, mfalme wa Israeli:"]},{"type":"verse","number":2,"content":[{"text":"Kwa kupata hekima na nidhamu;","poem":1},{"text":"kwa kufahamu maneno ya busara;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwa kujipatia nidhamu na busara,","poem":1},{"text":"kufanya lililo sawa, haki na bila kupendelea;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"huwapa busara wajinga,","poem":1},{"text":"maarifa na akili kwa vijana;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wenye hekima na wasikilize nao waongeze elimu yao,","poem":1},{"text":"wenye kupambanua na wapate mwongozo;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kwa kufahamu mithali na mifano,","poem":1},{"text":"misemo na vitendawili vya wenye hekima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumcha Bwana ndicho chanzo cha maarifa,","poem":1},{"text":"lakini wapumbavu hudharau hekima na adabu.","poem":2}]},{"type":"heading","content":["Onyo Dhidi Ya Ushawishi Wa Marafiki Waovu"]},{"type":"verse","number":8,"content":[{"text":"Mwanangu, sikiliza mwongozo wa baba yako,","poem":1},{"text":"wala usiyaache mafundisho ya mama yako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hayo yatakuwa taji la maua la neema kichwani pako,","poem":1},{"text":"na mkufu wa kuipamba shingo yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwanangu, kama wenye dhambi wakikushawishi,","poem":1},{"text":"usikubaliane nao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kama wakisema, “Twende tufuatane;","poem":1},{"text":"tukamvizie mtu na kumwaga damu,","poem":2},{"lineBreak":true},{"text":"njoo tukavizie nafsi isiyo na hatia;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"tuwameze wakiwa hai kama kaburi,","poem":1},{"noteId":0},{"text":"wakiwa wazima kama wale wanaotumbukia shimoni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tutapata aina zote za vitu vya thamani","poem":1},{"text":"na kujaza nyumba zetu kwa nyara.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njoo ushirikiane nasi,","poem":1},{"text":"vitu vyote tutakavyopata tutagawana.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mwanangu, usiandamane nao.","poem":1},{"text":"Usiweke mguu wako katika njia zao,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kwa kuwa miguu yao hukimbilia kwenye dhambi,","poem":1},{"text":"ni wepesi kumwaga damu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Tazama ni jinsi gani ilivyo kazi bure kutandaza wavu","poem":1},{"text":"wakati ndege wote wanakuona!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Watu hawa huvizia kumwaga damu yao wenyewe;","poem":1},{"text":"hujivizia tu wenyewe!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Huu ndio mwisho wa wote ambao wanajipatia mali kwa hila;","poem":1},{"text":"huuondoa uhai wa wale wenye mali.","poem":2}]},{"type":"heading","content":["Onyo Dhidi Ya Kukataa Hekima"]},{"type":"verse","number":20,"content":[{"text":"Hekima huita kwa sauti kuu barabarani,","poem":1},{"text":"hupaza sauti yake kwenye viwanja vikubwa;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kwenye makutano ya barabara za mji","poem":1},{"text":"zenye makelele mengi hupaza sauti,","poem":2},{"lineBreak":true},{"text":"kwenye malango ya mji hutoa hotuba yake:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Enyi wajinga, mtangʼangʼania ujinga wenu hadi lini?","poem":1},{"text":"Mpaka lini wenye mizaha watafurahia mizaha,","poem":2},{"lineBreak":true},{"text":"na wapumbavu kuchukia maarifa?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kama mngekuwa mmeitikia karipio langu,","poem":1},{"text":"ningekuwa nimemimina roho yangu kwenu","poem":2},{"lineBreak":true},{"text":"na kuwafahamisha maneno yangu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Lakini kwa kuwa mlinikataa nilipowaita","poem":1},{"text":"na hakuna yeyote aliyekubali","poem":2},{"lineBreak":true},{"text":"niliponyoosha mkono wangu,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"kwa kuwa mliyapuuza mashauri yangu yote","poem":1},{"text":"na hamkukubali karipio langu,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"mimi nami nitawacheka katika maafa yenu,","poem":1},{"text":"nitawadhihaki wakati janga litawapata:","poem":2}]},{"type":"verse","number":27,"content":[{"text":"wakati janga litawapata kama tufani,","poem":1},{"text":"wakati maafa yatawazoa kama upepo wa kisulisuli,","poem":2},{"lineBreak":true},{"text":"wakati dhiki na taabu zitawalemea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Ndipo watakaponiita lakini sitawajibu;","poem":1},{"text":"watanitafuta lakini hawatanipata.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kwa kuwa walichukia maarifa,","poem":1},{"text":"wala hawakuchagua kumcha Bwana,","poem":2}]},{"type":"verse","number":30,"content":[{"text":"kwa kuwa hawakukubali mashauri yangu,","poem":1},{"text":"na kukataa maonyo yangu,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"watakula matunda ya njia zao,","poem":1},{"text":"na watashibishwa matunda ya hila zao.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Kwa kuwa ukaidi wa wajinga utawaua,","poem":1},{"text":"nako kuridhika kwa wajinga kutawaangamiza.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Lakini yeyote anisikilizaye ataishi kwa usalama,","poem":1},{"text":"atatulia, bila kuwa na hofu ya madhara.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kaburi hapa maana yake ni Kuzimu, kwa Kiebrania ni Sheol.","reference":{"chapter":1,"verse":12}}]},"thisChapterLink":"/api/swh_bib/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}