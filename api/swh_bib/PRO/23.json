{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_bib","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"f60d9d80608cd39bf4c0da488bd373d715d03ee27685ce659875ae65a0e6d805","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"verse","number":1,"content":[{"text":"Uketipo kula chakula na mtawala,","poem":1},{"text":"angalia vyema kile kilicho mbele yako,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"na utie kisu kooni mwako","poem":1},{"text":"kama ukiwa mlafi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usitamani vyakula vyake vitamu","poem":1},{"text":"kwa kuwa chakula hicho ni cha hila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Usijitaabishe ili kuupata utajiri,","poem":1},{"text":"uwe na hekima kuonyesha kujizuia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kufumba na kufumbua utajiri hutoweka,","poem":1},{"text":"huwa kama umepata mabawa ghafula,","poem":2},{"lineBreak":true},{"text":"ukaruka na kutoweka angani kama tai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Usile chakula cha mtu mchoyo,","poem":1},{"text":"usitamani vyakula vyake vitamu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kwa maana yeye ni aina ya mtu","poem":1},{"text":"ambaye kila mara anafikiri juu ya gharama.","poem":2},{"text":"Anakuambia, “Kula na kunywa,”","poem":1},{"text":"lakini moyo wake hauko pamoja nawe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Utatapika kile kidogo ulichokula,","poem":1},{"text":"nawe utakuwa umepoteza bure","poem":2},{"lineBreak":true},{"text":"maneno yako ya kumsifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Usizungumze na mpumbavu,","poem":1},{"text":"kwa maana atadhihaki hekima ya maneno yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Usisogeze jiwe la mpaka wa zamani","poem":1},{"text":"wala kunyemelea kwenye mashamba ya yatima,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kwa kuwa Mtetezi wao ni mwenye nguvu,","poem":1},{"text":"atalichukua shauri lao dhidi yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Elekeza moyo wako kwenye mafundisho","poem":1},{"text":"na masikio yako kwenye maneno ya maarifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Usimnyime mtoto adhabu,","poem":1},{"text":"ukimwadhibu kwa fimbo, hatakufa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mwadhibu kwa fimbo","poem":1},{"text":"na kuiokoa nafsi yake kutoka mautini.","poem":2},{"noteId":6}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mwanangu, kama moyo wako una hekima,","poem":1},{"text":"basi moyo wangu utafurahi,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"utu wangu wa ndani utafurahi,","poem":1},{"text":"wakati midomo yako","poem":2},{"lineBreak":true},{"text":"itakapozungumza lililo sawa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Usiuruhusu moyo wako kuwaonea wivu wenye dhambi,","poem":1},{"text":"bali kila mara uwe na bidii katika kumcha Bwana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hakika kuna tumaini la baadaye kwa ajili yako,","poem":1},{"text":"nalo tarajio lako halitakatiliwa mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sikiliza, mwanangu na uwe na hekima,","poem":1},{"text":"weka moyo wako kwenye njia iliyo sawa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Usiwe miongoni mwa wanywao mvinyo,","poem":1},{"text":"au wale walao nyama kwa pupa,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kwa maana walevi na walafi huwa maskini,","poem":1},{"text":"nako kusinzia huwavika matambara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Msikilize baba yako, aliyekuzaa,","poem":1},{"text":"wala usimdharau mama yako atakapokuwa mzee.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nunua kweli wala usiiuze,","poem":1},{"text":"pata hekima, adabu na ufahamu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Baba wa mwenye haki ana furaha kubwa,","poem":1},{"text":"naye aliye na mwana mwenye hekima humfurahia.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Baba yako na mama yako na wafurahi,","poem":1},{"text":"mama aliyekuzaa na ashangilie!","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mwanangu, nipe moyo wako,","poem":1},{"text":"macho yako na yafuate njia zangu,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kwa maana kahaba ni shimo refu","poem":1},{"text":"na mwanamke mpotovu ni kisima chembamba.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kama mnyangʼanyi, hungojea akivizia,","poem":1},{"text":"naye huzidisha wasio waaminifu miongoni mwa wanaume.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Ni nani mwenye ole?","poem":1},{"text":"Ni nani mwenye huzuni?","poem":2},{"text":"Ni nani mwenye ugomvi?","poem":1},{"text":"Ni nani mwenye malalamiko?","poem":2},{"text":"Ni nani aliye na majeraha yasiyo na sababu?","poem":1},{"text":"Ni nani mwenye macho mekundu?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ni hao wakaao sana kwenye mvinyo,","poem":1},{"text":"hao waendao kuonja mabakuli ya mvinyo uliochanganywa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Usiukodolee macho mvinyo wakati ukiwa mwekundu,","poem":1},{"text":"wakati unapometameta kwenye bilauri,","poem":2},{"lineBreak":true},{"text":"wakati ushukapo taratibu!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mwishowe huuma kama nyoka","poem":1},{"text":"na kutia sumu yake kama nyoka mwenye sumu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Macho yako yataona mambo mageni","poem":1},{"text":"na moyo wako kuwazia mambo yaliyopotoka.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Utakuwa kama alalaye katikati ya bahari,","poem":1},{"text":"alalaye juu ya kamba ya merikebu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Utasema, “Wamenipiga lakini sikuumia!","poem":1},{"text":"Wamenichapa, lakini sisikii!","poem":2},{"text":"Nitaamka lini","poem":1},{"text":"ili nikanywe tena?”","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":6,"caller":"+","text":"Mautini maana yake ni Kuzimu.","reference":{"chapter":23,"verse":14}}]},"thisChapterLink":"/api/swh_bib/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}