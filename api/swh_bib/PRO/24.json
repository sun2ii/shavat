{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_bib","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"f60d9d80608cd39bf4c0da488bd373d715d03ee27685ce659875ae65a0e6d805","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"Usiwaonee wivu watu waovu,","poem":1},{"text":"usitamani ushirika nao;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kwa maana mioyo yao hupanga mambo ya jeuri,","poem":1},{"text":"nayo midomo yao husema juu ya kuleta madhara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwa hekima nyumba hujengwa,","poem":1},{"text":"nayo kwa njia ya ufahamu huimarishwa","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kwa njia ya maarifa vyumba vyake hujazwa","poem":1},{"text":"vitu vya thamani na vya kupendeza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mtu mwenye hekima ana uwezo mkubwa,","poem":1},{"text":"naye mtu mwenye maarifa huongeza nguvu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kwa kufanya vita unahitaji uongozi","poem":1},{"text":"na kwa ushindi washauri wengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hekima i juu mno kwa mpumbavu,","poem":1},{"text":"katika kusanyiko langoni","poem":2},{"lineBreak":true},{"text":"hana lolote la kusema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yeye apangaye mabaya","poem":1},{"text":"atajulikana kama mtu wa hila.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mipango ya upumbavu ni dhambi,","poem":1},{"text":"watu huchukizwa na mwenye dhihaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ukikata tamaa wakati wa taabu,","poem":1},{"text":"jinsi gani nguvu zako ni kidogo!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Okoa wale wanaoongozwa kwenye kifo;","poem":1},{"text":"wazuie wote wanaojikokota","poem":2},{"lineBreak":true},{"text":"kuelekea machinjoni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kama mkisema, “Lakini hatukujua lolote kuhusu hili,”","poem":1},{"text":"je, yule apimaye mioyo halitambui hili?","poem":2},{"text":"Je, yule awalindaye maisha yenu halijui hili?","poem":1},{"text":"Je, hatamlipa kila mtu kulingana na aliyotenda?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ule asali mwanangu, kwa kuwa ni nzuri;","poem":1},{"text":"asali kutoka kwenye sega ni tamu kwa kuonja.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ujue pia kwamba hekima ni tamu kwa nafsi yako,","poem":1},{"text":"kama ukiipata, kuna matumaini kwako ya siku zijazo,","poem":2},{"lineBreak":true},{"text":"nalo tumaini lako halitakatiliwa mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Usivizie kama haramia afanyavyo ili kuyashambulia","poem":1},{"text":"makao ya mwenye haki,","poem":2},{"lineBreak":true},{"text":"wala usiyavamie makazi yake,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa maana ingawa mtu mwenye haki huanguka mara saba, huinuka tena,","poem":1},{"text":"lakini waovu huangushwa chini na maafa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Usitazame kwa kufurahia adui yako aangukapo;","poem":1},{"text":"wakati ajikwaapo,","poem":2},{"lineBreak":true},{"text":"usiruhusu moyo wako ushangilie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bwana asije akaona na kuchukia","poem":1},{"text":"akaiondoa ghadhabu yake mbali naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Usikasirike kwa sababu ya watu wabaya","poem":1},{"text":"wala usiwaonee wivu waovu,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kwa maana mtu mbaya hana tumaini la siku zijazo,","poem":1},{"text":"nayo taa ya waovu itazimwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwanangu, mche Bwana na mfalme,","poem":1},{"text":"wala usijiunge na waasi,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kwa maana hao wawili watatuma maangamizi ya ghafula juu yao,","poem":1},{"text":"naye ni nani ajuaye maafa wawezayo kuleta?","poem":2}]},{"type":"heading","content":["Misemo Zaidi Ya Wenye Hekima"]},{"type":"verse","number":23,"content":["Hii pia ni misemo ya wenye hekima:",{"text":"Kuonyesha upendeleo katika hukumu si vyema:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yeyote amwambiaye mwenye hatia,","poem":1},{"text":"“Wewe huna hatia,”","poem":2},{"text":"Kabila zitamlaani","poem":1},{"text":"na mataifa yatamkana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bali itakuwa vyema kwa wale watakaowatia hatiani wenye hatia,","poem":1},{"text":"nazo baraka tele zitawajilia juu yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Jawabu la uaminifu","poem":1},{"text":"ni kama busu la midomoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Maliza kazi zako za nje,","poem":1},{"text":"nawe uweke mashamba yako tayari,","poem":2},{"lineBreak":true},{"text":"baada ya hayo, jenga nyumba yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Usishuhudie dhidi ya jirani yako bila sababu,","poem":1},{"text":"au kutumia midomo yako kudanganya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Usiseme, “Nitamtenda kama alivyonitenda mimi;","poem":1},{"text":"nitamlipiza mtu yule kwa kile alichonitendea.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nilipita karibu na shamba la mvivu,","poem":1},{"text":"karibu na shamba la mizabibu la mtu asiye na akili,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"miiba ilikuwa imeota kila mahali,","poem":1},{"text":"ardhi ilikuwa imefunikwa na magugu, na","poem":2},{"lineBreak":true},{"text":"ukuta wa mawe ulikuwa umebomoka.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nikatafakari moyoni mwangu lile nililoliona,","poem":1},{"text":"nami nikajifunza somo kutokana na niliyoyaona:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bado kulala kidogo, kusinzia kidogo,","poem":1},{"text":"bado kukunja mikono kidogo upate kupumzika:","poem":2}]},{"type":"verse","number":34,"content":[{"text":"hivyo umaskini utakuja juu yako kama mnyangʼanyi,","poem":1},{"text":"na kupungukiwa kutakujia kama mtu mwenye silaha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}