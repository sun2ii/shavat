{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_bib","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"f60d9d80608cd39bf4c0da488bd373d715d03ee27685ce659875ae65a0e6d805","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Usijisifu kwa ajili ya kesho,","poem":1},{"text":"kwa kuwa hujui ni nini kitakachozaliwa kwa siku moja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwache mwingine akusifu,","poem":1},{"text":"wala si kinywa chako mwenyewe;","poem":2},{"text":"mtu mwingine afanye hivyo","poem":1},{"text":"na si midomo yako mwenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jiwe ni zito na mchanga ni mzigo,","poem":1},{"text":"lakini kukasirishwa na mpumbavu ni kuzito kuliko vyote viwili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hasira ni ukatili na ghadhabu kali ni gharika,","poem":1},{"text":"lakini ni nani awezaye kusimama mbele ya wivu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Afadhali karipio la wazi","poem":1},{"text":"kuliko upendo uliofichika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Majeraha kutoka kwa rafiki yaonyesha uaminifu,","poem":1},{"text":"bali kubusu kwa adui ni kwingi sana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yeye aliyeshiba huchukia kabisa asali,","poem":1},{"text":"bali kwa mwenye njaa","poem":2},{"lineBreak":true},{"text":"hata kile kilicho kichungu","poem":2},{"lineBreak":true},{"text":"kwake ni kitamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kama ndege atangatangavyo mbali na kiota chake,","poem":1},{"text":"ndivyo alivyo mtu atangatangaye","poem":2},{"lineBreak":true},{"text":"mbali na nyumbani mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Manukato na uvumba huleta furaha moyoni,","poem":1},{"text":"nao uzuri wa rafiki huchipuka","poem":2},{"lineBreak":true},{"text":"kutoka kwenye ushauri wake wa uaminifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Usimwache rafiki yako wala rafiki wa baba yako,","poem":1},{"text":"tena usiende nyumbani mwa ndugu yako","poem":2},{"lineBreak":true},{"text":"wakati umepatwa na maafa.","poem":2},{"text":"Bora jirani wa karibu","poem":1},{"text":"kuliko ndugu aliye mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwanangu, uwe na hekima,","poem":1},{"text":"nawe ulete furaha moyoni mwangu,","poem":2},{"text":"ndipo nitakapoweza kumjibu yeyote","poem":1},{"text":"anitendaye kwa dharau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mtu mwenye busara huona hatari na kujificha,","poem":1},{"text":"bali mjinga huendelea mbele nayo ikamtesa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Chukua vazi la yule awekaye dhamana","poem":1},{"text":"kwa ajili ya mgeni;","poem":2},{"text":"lishikilie iwe dhamana kama anafanya hivyo","poem":1},{"text":"kwa ajili ya mwanamke mpotovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kama mtu akimbariki jirani yake kwa sauti kuu","poem":1},{"text":"asubuhi na mapema,","poem":2},{"lineBreak":true},{"text":"itahesabiwa kama ni laana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mke mgomvi ni kama","poem":1},{"text":"matone yasiyokoma ya siku ya mvua.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kumzuia yeye ni kama kuuzuia upepo","poem":1},{"text":"au kukamata mafuta kwa kiganja cha mkono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kama vile chuma kinoavyo chuma,","poem":1},{"text":"ndivyo mtu amnoavyo mwenzake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yeye autunzaye mtini atakula tunda lake,","poem":1},{"text":"naye amtunzaye bwana wake ataheshimiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kama uso uonekanavyo kwenye maji,","poem":1},{"text":"ndivyo hivyo moyo wa mtu humwonyesha alivyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kuzimu na Uharibifu havishibi","poem":1},{"text":"kadhalika macho ya mwanadamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kalibu ni kwa ajili ya fedha","poem":1},{"text":"na tanuru kwa ajili ya dhahabu,","poem":2},{"lineBreak":true},{"text":"bali mtu hupimwa kwa sifa azipokeazo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Hata ukimtwanga mpumbavu kwenye kinu,","poem":1},{"text":"ukimtwanga kama nafaka kwa mchi,","poem":2},{"lineBreak":true},{"text":"hutauondoa upumbavu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hakikisha kuwa unajua hali ya makundi yako","poem":1},{"text":"ya kondoo na mbuzi,","poem":2},{"lineBreak":true},{"text":"angalia kwa bidii ngʼombe zako.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kwa kuwa utajiri haudumu milele,","poem":1},{"text":"nayo taji haidumu vizazi vyote.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wakati majani makavu yameondolewa","poem":1},{"text":"na mapya yamechipua,","poem":2},{"lineBreak":true},{"text":"nayo majani toka milimani yamekusanywa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"wana-kondoo watakupatia mavazi","poem":1},{"text":"na mbuzi thamani ya shamba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Utakuwa na maziwa mengi ya mbuzi","poem":1},{"text":"kukulisha wewe na jamaa yako,","poem":2},{"lineBreak":true},{"text":"na kuwalisha watumishi wako wa kike.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}