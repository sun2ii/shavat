{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_bib","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"f60d9d80608cd39bf4c0da488bd373d715d03ee27685ce659875ae65a0e6d805","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Faida Nyingine Za Hekima"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, usisahau mafundisho yangu,","poem":1},{"text":"bali zitunze amri zangu moyoni mwako,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kwa kuwa zitakuongezea miaka mingi ya maisha yako","poem":1},{"text":"na kukuletea mafanikio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Usiache kamwe upendo na uaminifu vitengane nawe;","poem":1},{"text":"vifunge shingoni mwako,","poem":2},{"lineBreak":true},{"text":"viandike katika ubao wa moyo wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo utapata kibali na jina zuri","poem":1},{"text":"mbele za Mungu na mwanadamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mtumaini Bwana kwa moyo wako wote","poem":1},{"text":"wala usizitegemee akili zako mwenyewe;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"katika njia zako zote mkiri yeye,","poem":1},{"text":"naye atayanyoosha mapito yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Usiwe mwenye hekima machoni pako mwenyewe;","poem":1},{"text":"mche Bwana ukajiepushe na uovu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hii itakuletea afya mwilini mwako,","poem":1},{"text":"na mafuta kwenye mifupa yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mheshimu Bwana kwa mali zako na","poem":1},{"text":"kwa malimbuko ya mazao yako yote;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ndipo ghala zako zitakapojaa hadi kufurika,","poem":1},{"text":"viriba vyako vitafurika kwa mvinyo mpya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwanangu, usiidharau adhabu ya Bwana","poem":1},{"text":"na usichukie kukaripiwa naye,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kwa sababu Bwana huwaadibisha wale awapendao,","poem":1},{"text":"kama vile baba afanyavyo","poem":2},{"lineBreak":true},{"text":"kwa mwana apendezwaye naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Heri mtu yule aonaye hekima,","poem":1},{"text":"mtu yule apataye ufahamu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kwa maana hekima ana faida kuliko fedha","poem":1},{"text":"na mapato yake ni bora kuliko ya dhahabu safi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hekima ana thamani kuliko marijani;","poem":1},{"text":"hakuna chochote unachokitamani","poem":2},{"lineBreak":true},{"text":"kinachoweza kulinganishwa naye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maisha marefu yako katika mkono wake wa kuume;","poem":1},{"text":"katika mkono wake wa kushoto","poem":2},{"lineBreak":true},{"text":"kuna utajiri na heshima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Njia zake zinapendeza,","poem":1},{"text":"mapito yake yote ni amani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yeye ni mti wa uzima kwa wale wanaomkumbatia;","poem":1},{"text":"wale wamshikao watabarikiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kwa hekima Bwana aliiweka misingi ya dunia,","poem":1},{"text":"kwa ufahamu aliziweka mbingu mahali pake;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kwa maarifa yake vilindi viligawanywa,","poem":1},{"text":"nayo mawingu yanadondosha umande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwanangu, hifadhi maamuzi mema na busara,","poem":1},{"text":"usiache vitoke machoni pako;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ndipo vitakapokuwa uzima nafsini mwako","poem":1},{"text":"na pambo la neema shingoni mwako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kisha utaenda katika njia yako salama,","poem":1},{"text":"wala mguu wako hautajikwaa;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ulalapo, hautaogopa;","poem":1},{"text":"ulalapo usingizi wako utakuwa mtamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Usiogope maafa ya ghafula","poem":1},{"text":"au maangamizi yanayowapata waovu,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kwa kuwa Bwana atakuwa tumaini lako","poem":1},{"text":"na kuepusha mguu wako kunaswa katika mtego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Usizuie wema kwa wale wanaostahili","poem":1},{"text":"ikiwa katika uwezo wako kutenda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Usimwambie jirani yako,","poem":1},{"text":"“Njoo baadaye, nitakupa kesho”:","poem":2},{"lineBreak":true},{"text":"wakati wewe unacho kitu kile karibu nawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Usifanye hila ya kumdhuru jirani yako,","poem":1},{"text":"ambaye anaishi karibu na wewe akikuamini.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Usimshtaki mtu bila sababu,","poem":1},{"text":"wakati hajakutenda dhara lolote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Usimwonee wivu mtu mwenye jeuri","poem":1},{"text":"wala kuchagua njia yake iwayo yote,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"kwa kuwa Bwana humchukia mtu mpotovu,","poem":1},{"text":"lakini siri yake iko kwa mwenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Laana ya Bwana i juu ya nyumba ya mwovu,","poem":1},{"text":"lakini yeye huibariki nyumba ya mwenye haki.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Huwadhihaki wale wanaodhihaki,","poem":1},{"text":"lakini huwapa neema wale wanyenyekevu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Wenye hekima hurithi heshima,","poem":1},{"text":"bali huwaaibisha wapumbavu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}