{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_bib","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"f60d9d80608cd39bf4c0da488bd373d715d03ee27685ce659875ae65a0e6d805","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["Misemo Ya Aguri"]},{"type":"verse","number":1,"content":["Misemo ya Aguri mwana wa Yake, usia:",{"text":"Huyu mtu alimwambia Ithieli,","poem":1},{"text":"naam, kwa Ithieli na kwa Ukali:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Mimi ni mjinga kuliko wanadamu wote;","poem":1},{"text":"sina ufahamu wa kibinadamu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sijajifunza hekima,","poem":1},{"text":"wala sina maarifa ya kumjua yeye Aliye Mtakatifu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ni nani ameshapanda mbinguni na kushuka?","poem":1},{"text":"Ni nani ameshakusanya upepo","poem":2},{"lineBreak":true},{"text":"kwenye vitanga vya mikono yake?","poem":2},{"text":"Ni nani ameshafungia maji kwenye nguo yake?","poem":1},{"text":"Ni nani ameimarisha miisho yote ya dunia?","poem":2},{"text":"Jina lake ni nani, na mwanawe anaitwa nani?","poem":1},{"text":"Niambie kama unajua!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Kila neno la Mungu ni kamilifu;","poem":1},{"text":"yeye ni ngao kwa wale wanaomkimbilia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Usiongeze kwenye maneno yake,","poem":1},{"text":"ama atakukemea na kukuthibitisha kuwa mwongo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ninakuomba vitu viwili, Ee Bwana;","poem":1},{"text":"usininyime kabla sijafa:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uutenge mbali nami udanganyifu na uongo;","poem":1},{"text":"usinipe umaskini wala utajiri,","poem":2},{"lineBreak":true},{"text":"bali unipe chakula cha kunitosha kila siku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nisije nikawa na vingi vya kuzidi nikakukana","poem":1},{"text":"na kusema, ‘Bwana ni nani?’","poem":2},{"text":"Au nisije nikawa maskini nikaiba,","poem":1},{"text":"nami nikaliaibisha jina la Mungu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Usimchongee mtumishi kwa bwana wake,","poem":1},{"text":"asije akakulaani, ukapatilizwa kwalo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Wako watu wale ambao huwalaani baba zao","poem":1},{"text":"na wala hawawabariki mama zao;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"wale ambao ni safi machoni pao wenyewe","poem":1},{"text":"kumbe hawakuoshwa uchafu wao;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"wale ambao daima macho yao ni ya kiburi,","poem":1},{"text":"ambao kutazama kwao ni kwa dharau;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"wale ambao meno yao ni panga","poem":1},{"text":"na ambao mataya yao yamewekwa visu","poem":2},{"text":"kuwaangamiza maskini katika nchi,","poem":1},{"text":"na wahitaji kutoka miongoni mwa wanadamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Mruba anao binti wawili waliao,","poem":1},{"text":"‘Nipe! Nipe!’","poem":2},{"lineBreak":true},{"text":"“Kuna vitu vitatu visivyotosheka kamwe,","poem":1},{"text":"naam, viko vinne visivyosema, ‘Yatosha!’:","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ni kaburi, tumbo lisilozaa,","poem":1},{"text":"nchi isiyoshiba maji kamwe,","poem":2},{"lineBreak":true},{"text":"na moto, usiosema kamwe, ‘Yatosha!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Jicho lile limdhihakilo baba,","poem":1},{"text":"lile linalodharau kumtii mama,","poem":2},{"text":"litangʼolewa na kunguru wa bondeni,","poem":1},{"text":"litaliwa na tai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Kuna vitu vitatu vinavyonishangaza sana,","poem":1},{"text":"naam, vinne nisivyovielewa:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ni mwendo wa tai katika anga,","poem":1},{"text":"mwendo wa nyoka juu ya mwamba,","poem":2},{"text":"mwendo wa meli katika maji makuu ya bahari,","poem":1},{"text":"nao mwendo wa mtu pamoja na msichana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Huu ndio mwendo wa mwanamke mzinzi,","poem":1},{"text":"hula akapangusa kinywa chake na kusema,","poem":2},{"lineBreak":true},{"text":"‘Sikufanya chochote kibaya.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Kwa mambo matatu nchi hutetemeka,","poem":1},{"text":"naam, kwa mambo manne haiwezi kuvumilia:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mtumwa awapo mfalme,","poem":1},{"text":"mpumbavu ashibapo chakula,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"mwanamke asiyependwa aolewapo,","poem":1},{"text":"naye mtumishi wa kike achukuapo nafasi ya bibi yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Vitu vinne duniani vilivyo vidogo,","poem":1},{"text":"lakini vina akili nyingi sana:","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mchwa ni viumbe wenye nguvu ndogo,","poem":1},{"text":"hata hivyo hujiwekea akiba ya chakula chao wakati wa kiangazi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Pelele ni viumbe vyenye uwezo mdogo","poem":1},{"text":"hata hivyo hujitengenezea nyumba zao kwenye miamba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nzige hawana mfalme,","poem":1},{"text":"hata hivyo huenda pamoja vikosi vikosi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Mjusi anaweza kushikwa kwa mkono,","poem":1},{"text":"hata hivyo huonekana katika majumba ya kifalme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Viko vitu vitatu ambavyo vinapendeza katika mwendo wao,","poem":1},{"text":"naam, vinne ambavyo hutembea kwa mwendo wa madaha:","poem":2}]},{"type":"verse","number":30,"content":[{"text":"simba, mwenye nguvu miongoni mwa wanyama,","poem":1},{"text":"asiyerudi nyuma kwa chochote;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"jogoo atembeaye kwa maringo, pia beberu,","poem":1},{"text":"naye mfalme pamoja na jeshi lake lililomzunguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Ikiwa umefanya upumbavu na ukajitukuza mwenyewe,","poem":1},{"text":"au kama umepanga mabaya,","poem":2},{"lineBreak":true},{"text":"basi funika mdomo wako na mkono wako.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kwa maana kama vile kusukasuka maziwa hutoa siagi,","poem":1},{"text":"na pia kule kufinya pua hutoa damu,","poem":2},{"lineBreak":true},{"text":"kadhalika kuchochea hasira hutokeza ugomvi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}