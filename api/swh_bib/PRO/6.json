{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_bib","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"f60d9d80608cd39bf4c0da488bd373d715d03ee27685ce659875ae65a0e6d805","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Maonyo Dhidi Ya Upumbavu"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, kama umekuwa mdhamini wa jirani yako,","poem":1},{"text":"ikiwa umeshika mikono kwa kuweka ahadi","poem":2},{"lineBreak":true},{"text":"kwa ajili ya mwingine,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kama umetegwa na ulichosema,","poem":1},{"text":"umenaswa kwa maneno ya kinywa chako,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"basi fanya hivi mwanangu, ili ujiweke huru,","poem":1},{"text":"kwa kuwa umeanguka mikononi mwa jirani yako:","poem":2},{"text":"Nenda ukajinyenyekeshe kwake;","poem":1},{"text":"msihi jirani yako!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Usiruhusu usingizi machoni pako,","poem":1},{"text":"usiruhusu kope zako zisinzie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jiweke huru, kama swala mkononi mwa mwindaji,","poem":1},{"text":"kama ndege kutoka kwenye mtego wa mwindaji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ewe mvivu, mwendee mchwa;","poem":1},{"text":"zitafakari njia zake ukapate hekima!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa maana yeye hana msimamizi,","poem":1},{"text":"wala mwangalizi, au mtawala,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"lakini hujiwekea akiba wakati wa kiangazi","poem":1},{"text":"na hukusanya chakula chake wakati wa mavuno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ewe mvivu, utalala hata lini?","poem":1},{"text":"Utaamka lini kutoka usingizi wako?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bado kulala kidogo, kusinzia kidogo,","poem":1},{"text":"bado kukunja mikono kidogo upate kupumzika:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"hivyo umaskini utakuja juu yako kama mnyangʼanyi,","poem":1},{"text":"na kupungukiwa kutakujia kama mtu mwenye silaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mtu mbaya sana na mlaghai,","poem":1},{"text":"ambaye huzungukazunguka","poem":2},{"text":"na maneno ya upotovu,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ambaye anakonyeza kwa jicho lake,","poem":2},{"lineBreak":true},{"text":"anayetoa ishara kwa miguu yake","poem":2},{"lineBreak":true},{"text":"na kuashiria kwa vidole vyake,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ambaye hupanga ubaya","poem":2},{"text":"kwa udanganyifu moyoni mwake:","poem":3},{"text":"daima huchochea fitina.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa hiyo maafa yatamkumba ghafula;","poem":1},{"text":"ataangamizwa mara, pasipo msaada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kuna vitu sita anavyovichukia Bwana,","poem":1},{"text":"naam, viko saba vilivyo chukizo kwake:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"macho ya kiburi,","poem":3},{"lineBreak":true},{"text":"ulimi udanganyao,","poem":3},{"lineBreak":true},{"text":"mikono imwagayo damu isiyo na hatia,","poem":3}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"moyo uwazao mipango miovu,","poem":3},{"lineBreak":true},{"text":"miguu iliyo myepesi kukimbilia uovu,","poem":3}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"shahidi wa uongo ambaye humwaga uongo,","poem":3},{"lineBreak":true},{"text":"na mtu ambaye huchochea fitina kati ya ndugu.","poem":3}]},{"type":"heading","content":["Onyo Dhidi Ya Uasherati"]},{"type":"verse","number":20,"content":[{"text":"Mwanangu, zishike amri za baba yako,","poem":1},{"text":"wala usiyaache mafundisho ya mama yako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yafunge katika moyo wako daima,","poem":1},{"text":"yakaze kuizunguka shingo yako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wakati utembeapo, yatakuongoza;","poem":1},{"text":"wakati ulalapo, yatakulinda;","poem":2},{"lineBreak":true},{"text":"wakati uamkapo, yatazungumza nawe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kwa maana amri hizi ni taa,","poem":1},{"text":"mafundisho haya ni mwanga","poem":2},{"lineBreak":true},{"text":"na maonyo ya maadili ni njia ya uzima,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"yakikulinda na mwanamke aliyepotoka,","poem":1},{"text":"kutokana na maneno laini ya mwanamke aliyepotoka.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Moyo wako usitamani uzuri wake","poem":1},{"text":"wala macho yake yasikuteke,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kwa maana kahaba atakufanya uwe maskini,","poem":1},{"text":"hata ukose kipande cha mkate,","poem":2},{"lineBreak":true},{"text":"naye mwanamke mzinzi huwinda maisha yako hasa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Je, mtu aweza kuchotea moto kwenye paja lake","poem":1},{"text":"bila nguo zake kuungua?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Je, mtu aweza kutembea juu ya makaa ya moto yanayowaka","poem":1},{"text":"bila miguu yake kuungua?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndivyo alivyo mtu alalaye na mke wa mwanaume mwingine;","poem":1},{"text":"hakuna yeyote amgusaye huyo mwanamke ambaye hataadhibiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Watu hawamdharau mwizi kama akiiba","poem":1},{"text":"kukidhi njaa yake wakati ana njaa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Pamoja na hayo, kama akikamatwa,","poem":1},{"text":"lazima alipe mara saba,","poem":2},{"lineBreak":true},{"text":"ingawa inamgharimu utajiri wote wa nyumba yake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Lakini mwanaume aziniye na mwanamke hana akili kabisa;","poem":1},{"text":"yeyote afanyaye hivyo hujiangamiza mwenyewe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mapigo na aibu ni fungu lake","poem":1},{"text":"na aibu yake haitafutika kamwe;","poem":2}]},{"type":"verse","number":34,"content":[{"text":"kwa maana wivu huamsha ghadhabu ya mume,","poem":1},{"text":"naye hataonyesha huruma alipizapo kisasi.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Hatakubali fidia yoyote;","poem":1},{"text":"atakataa malipo, hata yakiwa makubwa kiasi gani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}