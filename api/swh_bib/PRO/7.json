{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_bib","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"f60d9d80608cd39bf4c0da488bd373d715d03ee27685ce659875ae65a0e6d805","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_bib/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["Onyo Dhidi Ya Mwanamke Mzinzi"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, shika maneno yangu","poem":1},{"text":"na kuzihifadhi amri zangu ndani yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Shika amri zangu nawe utaishi;","poem":1},{"text":"linda mafundisho yangu kama mboni ya jicho lako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yafunge katika vidole vyako;","poem":1},{"text":"yaandike katika kibao cha moyo wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwambie hekima, “Wewe ni dada yangu,”","poem":1},{"text":"uite ufahamu jamaa yako;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"watakuepusha na mwanamke mzinzi,","poem":1},{"text":"kutokana na mwanamke mpotovu","poem":2},{"lineBreak":true},{"text":"na maneno yake ya kubembeleza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kwenye dirisha la nyumba yangu","poem":1},{"text":"nilitazama nje kupitia upenyo","poem":2},{"lineBreak":true},{"text":"kwenye mwimo wa dirisha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Niliona miongoni mwa wajinga,","poem":1},{"text":"nikagundua miongoni mwa wanaume vijana,","poem":2},{"lineBreak":true},{"text":"kijana asiye na akili.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Alikuwa akishuka njiani karibu na pembe ya kwake,","poem":1},{"text":"akielekea kwenye nyumba ya huyo mwanamke","poem":2}]},{"type":"verse","number":9,"content":[{"text":"wakati wa machweo, jua likipungua nuru yake,","poem":1},{"text":"giza la usiku lilipokuwa likiingia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndipo huyo mwanamke akatoka kumlaki,","poem":1},{"text":"hali amevaa kama kahaba akiwa na nia ya udanganyifu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"(Ni mwanamke mwenye makelele na mkaidi,","poem":1},{"text":"miguu yake haitulii nyumbani;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mara kwenye barabara za mji,","poem":1},{"text":"mara kwenye viwanja vikubwa,","poem":2},{"lineBreak":true},{"text":"kwenye kila pembe huvizia.)","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Huyo mwanamke alimkumbatia kijana na kumbusu,","poem":1},{"text":"na kwa uso usio na haya akamwambia:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Nina sadaka za amani nyumbani;","poem":1},{"text":"leo nimetimiza nadhiri zangu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa hiyo nimetoka nje kukulaki;","poem":1},{"text":"nimekutafuta na nimekupata!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nimetandika kitanda changu","poem":1},{"text":"kwa kitani za rangi kutoka Misri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nimetia manukato kitanda changu","poem":1},{"text":"kwa manemane, udi na mdalasini.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Njoo, tuzame katika mapenzi mpaka asubuhi;","poem":1},{"text":"tujifurahishe wenyewe kwa mapenzi!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mume wangu hayupo nyumbani;","poem":1},{"text":"amekwenda safari ya mbali.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Amechukua mkoba uliojazwa fedha","poem":1},{"text":"na hatakuwepo nyumbani karibuni.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kwa maneno laini yule mwanamke akampotosha;","poem":1},{"text":"alimshawishi kwa maneno yake laini.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mara huyo kijana alimfuata yule mwanamke","poem":1},{"text":"kama fahali aendaye machinjoni,","poem":2},{"lineBreak":true},{"text":"kama kulungu aingiaye kwenye kitanzi,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"mpaka mshale umchome ini lake,","poem":1},{"text":"kama ndege anayenaswa kwenye mtego,","poem":2},{"lineBreak":true},{"text":"bila kujua itamgharimu maisha yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Sasa basi wanangu, nisikilizeni;","poem":1},{"text":"sikilizeni kwa makini nisemalo.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usiruhusu moyo wako ugeukie njia za huyo mwanamke,","poem":1},{"text":"wala usitangetange katika mapito yake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Aliowaangusha ni wengi;","poem":1},{"text":"aliowachinja ni kundi kubwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nyumba yake ni njia kuu iendayo kaburini,","poem":1},{"noteId":2},{"text":"ielekeayo chini kwenye vyumba vya mauti.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Kaburini hapa maana yake ni Kuzimu, kwa Kiebrania ni Sheol.","reference":{"chapter":7,"verse":27}}]},"thisChapterLink":"/api/swh_bib/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}