true},{"text":"yapeperushwayo na upepo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa hiyo waovu hawatastahimili hukumu,","poem":1},{"text":"wala wenye dhambi katika kusanyiko la wenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kwa maana Bwana huziangalia njia za mwenye haki,","poem":1},{"text":"bali njia ya waovu itaangamia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}