{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"heading","content":["Sala Kwa Ajili Ya Haki"]},{"type":"verse","number":1,"content":[{"text":"Kwa nini, Ee Bwana, unasimama mbali?","poem":1},{"text":"Kwa nini unajificha wakati wa shida?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Katika kiburi chake, mwovu humtesa maskini,","poem":1},{"text":"waovu na wanaswe katika hila wanazozitunga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hujivunia tamaa za moyo wake;","poem":1},{"text":"humbariki mlafi na kumtukana Bwana.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Katika kiburi chake, mwovu hamtafuti Mungu,","poem":1},{"text":"katika mawazo yake yote","poem":2},{"lineBreak":true},{"text":"hakuna nafasi ya Mungu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Njia zake daima hufanikiwa;","poem":1},{"text":"hujivuna na amri zako ziko mbali naye,","poem":2},{"lineBreak":true},{"text":"huwacheka kwa dharau adui zake wote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anajisemea mwenyewe, “Hakuna kitakachonitikisa,","poem":1},{"text":"daima nitakuwa na furaha,","poem":2},{"lineBreak":true},{"text":"kamwe sitakuwa na shida.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kinywa chake kimejaa laana, uongo na vitisho;","poem":1},{"text":"shida na ubaya viko chini ya ulimi wake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Huvizia karibu na vijiji;","poem":1},{"text":"kutoka mafichoni huwanasa wasio na hatia,","poem":2},{"lineBreak":true},{"text":"akivizia wapitaji.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huvizia kama simba aliye mawindoni;","poem":1},{"text":"huvizia kumkamata mnyonge,","poem":2},{"text":"huwakamata wanyonge na kuwaburuza","poem":1},{"text":"katika wavu wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mateka wake hupondwa, huzimia;","poem":1},{"text":"wanaanguka katika nguvu zake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anajisemea mwenyewe, “Mungu amesahau,","poem":1},{"text":"huficha uso wake na haoni kabisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Inuka Bwana! Inua mkono wako, Ee Mungu.","poem":1},{"text":"Usiwasahau wanyonge.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa nini mtu mwovu anamtukana Mungu?","poem":1},{"text":"Kwa nini anajiambia mwenyewe,","poem":2},{"lineBreak":true},{"text":"“Hataniita nitoe hesabu?”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lakini wewe, Ee Mungu, unaona shida na huzuni,","poem":1},{"text":"umekubali kuyapokea mkononi mwako.","poem":2},{"text":"Mhanga anajisalimisha kwako,","poem":1},{"text":"wewe ni msaada wa yatima.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vunja mkono wa mtu mwovu na mbaya,","poem":1},{"text":"mwite atoe hesabu ya maovu yake","poem":2},{"lineBreak":true},{"text":"ambayo yasingejulikana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bwana ni Mfalme milele na milele,","poem":1},{"text":"mataifa wataangamia watoke nchini mwake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unasikia, Ee Bwana, shauku ya wanaoonewa,","poem":1},{"text":"wewe huwatia moyo, na kusikiliza kilio chao,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ukiwatetea yatima na walioonewa,","poem":1},{"text":"ili mwanadamu, ambaye ni udongo, asiogopeshe tena.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}