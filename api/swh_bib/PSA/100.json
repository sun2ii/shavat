a","poem":1},{"text":"na upendo wake wadumu milele;","poem":2},{"lineBreak":true},{"text":"uaminifu wake unadumu kwa vizazi vyote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}