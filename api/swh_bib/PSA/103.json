{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"heading","content":["Upendo Wa Mungu"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee nafsi yangu, umhimidi Bwana.","poem":1},{"text":"Vyote vilivyomo ndani yangu","poem":2},{"lineBreak":true},{"text":"vilihimidi jina lake takatifu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee nafsi yangu, umhimidi Bwana,","poem":1},{"text":"wala usisahau wema wake wote,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"akusamehe dhambi zako zote,","poem":1},{"text":"akuponya magonjwa yako yote,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"aukomboa uhai wako na kaburi,","poem":1},{"text":"akuvika taji ya upendo na huruma,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"atosheleza mahitaji yako kwa vitu vyema,","poem":1},{"text":"ili ujana wako uhuishwe kama wa tai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bwana hutenda haki,","poem":1},{"text":"naye huwapa hukumu ya haki wote wanaoonewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Alijulisha Mose njia zake,","poem":1},{"text":"na wana wa Israeli matendo yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bwana ni mwingi wa huruma na mwenye neema;","poem":1},{"text":"si mwepesi wa hasira, bali amejaa upendo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yeye hatalaumu siku zote,","poem":1},{"text":"wala haweki hasira yake milele,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"yeye hatutendei kulingana na dhambi zetu","poem":1},{"text":"wala hatupatilizi kwa kadiri ya maovu yetu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kama vile mbingu zilivyo juu ya dunia sana,","poem":1},{"text":"ndivyo wema wake ulivyo mwingi kwa wanaomcha;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kama mashariki ilivyo mbali na magharibi,","poem":1},{"text":"ndivyo Mungu alivyoziweka dhambi zetu mbali nasi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kama baba alivyo na huruma kwa watoto wake,","poem":1},{"text":"ndivyo Bwana anavyowahurumia wale wanaomcha;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kwa kuwa anajua tulivyoumbwa,","poem":1},{"text":"anakumbuka kwamba sisi tu mavumbi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kuhusu mwanadamu, siku zake ni kama majani,","poem":1},{"text":"anachanua kama ua la shambani;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"upepo huvuma juu yake nalo hutoweka,","poem":1},{"text":"mahali pake hapalikumbuki tena.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lakini kutoka milele hata milele","poem":1},{"text":"upendo wa Bwana uko kwa wale wamchao,","poem":2},{"lineBreak":true},{"text":"nayo haki yake kwa watoto wa watoto wao:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kwa wale walishikao agano lake","poem":1},{"text":"na kukumbuka kuyatii mausia yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bwana ameweka imara kiti chake cha enzi mbinguni,","poem":1},{"text":"ufalme wake unatawala juu ya vyote.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mhimidini Bwana, enyi malaika zake,","poem":1},{"text":"ninyi mlio mashujaa mnaozitii amri zake,","poem":2},{"lineBreak":true},{"text":"ninyi mnaotii neno lake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mhimidini Bwana, ninyi jeshi lake lote la mbinguni,","poem":1},{"text":"ninyi watumishi wake mnaofanya mapenzi yake.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mhimidini Bwana, kazi zake zote","poem":1},{"text":"kila mahali katika milki yake.","poem":2},{"lineBreak":true},{"text":"Ee nafsi yangu, umhimidi Bwana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}