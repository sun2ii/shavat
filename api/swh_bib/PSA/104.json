{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"heading","content":["Kumsifu Muumba"]},{"type":"verse","number":1,"content":[{"text":"Ee nafsi yangu, umhimidi Bwana.","poem":1},{"lineBreak":true},{"text":"Ee Bwana Mungu wangu, wewe ni mkuu sana,","poem":1},{"text":"umejivika utukufu na enzi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amejifunika katika nuru kama vile kwa vazi,","poem":1},{"text":"amezitandaza mbingu kama hema","poem":2}]},{"type":"verse","number":3,"content":[{"text":"na kuziweka nguzo za orofa yake juu ya maji.","poem":1},{"lineBreak":true},{"text":"Huyafanya mawingu kuwa gari lake,","poem":1},{"text":"na hupanda kwenye mbawa za upepo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Huzifanya pepo kuwa wajumbe","poem":1},{"noteId":34},{"text":"wake,","poem":1},{"text":"miali ya moto watumishi wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ameiweka dunia kwenye misingi yake,","poem":1},{"text":"haiwezi kamwe kuondoshwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uliifunika kwa kilindi kama kwa vazi,","poem":1},{"text":"maji yalisimama juu ya milima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lakini kwa kukemea kwako maji yalikimbia,","poem":1},{"text":"kwa sauti ya radi yako yakatoroka,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"yakapanda milima, yakateremka mabondeni,","poem":1},{"text":"hadi mahali pale ulipoyakusudia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uliyawekea mpaka ambao hayawezi kuuvuka,","poem":1},{"text":"kamwe hayataifunika dunia tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Huzifanya chemchemi zimwage maji mabondeni,","poem":1},{"text":"hutiririka kati ya milima.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Huwapa maji wanyama wote wa kondeni,","poem":1},{"text":"punda-mwitu huzima kiu yao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndege wa angani hufanya viota kando ya maji,","poem":1},{"text":"huimba katikati ya matawi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Huinyeshea milima kutoka orofa zake,","poem":1},{"text":"dunia inatoshelezwa kwa matunda ya kazi yake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Huyafanya majani ya mifugo yaote,","poem":1},{"text":"na mimea kwa watu kulima,","poem":2},{"lineBreak":true},{"text":"wajipatie chakula kutoka ardhini:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"divai ya kuufurahisha moyo wa mwanadamu,","poem":1},{"text":"mafuta kwa ajili ya kungʼarisha uso wake,","poem":2},{"lineBreak":true},{"text":"na mkate wa kutia mwili nguvu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Miti ya Bwana inanyeshewa vizuri,","poem":1},{"text":"mierezi ya Lebanoni aliyoipanda.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Humo ndege hufanya viota vyao,","poem":1},{"text":"korongo ana nyumba yake kwenye msunobari.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Milima mirefu ni makao ya mbuzi-mwitu,","poem":1},{"text":"majabali ni kimbilio la pelele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwezi hugawanya majira,","poem":1},{"text":"na jua hutambua wakati wake wa kutua.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unaleta giza, kunakuwa usiku,","poem":1},{"text":"wanyama wote wa mwituni huzurura.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Simba hunguruma kwa mawindo yao,","poem":1},{"text":"na kutafuta chakula chao kutoka kwa Mungu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Jua huchomoza, nao huondoka,","poem":1},{"text":"hurudi na kulala katika mapango yao.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kisha mwanadamu huenda kazini mwake,","poem":1},{"text":"katika kazi yake mpaka jioni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ee Bwana, jinsi matendo yako yalivyo mengi!","poem":1},{"text":"Kwa hekima ulizifanya zote,","poem":2},{"lineBreak":true},{"text":"dunia imejaa viumbe vyako.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pale kuna bahari, kubwa na yenye nafasi tele,","poem":1},{"text":"imejaa viumbe visivyo na idadi,","poem":2},{"lineBreak":true},{"text":"vitu vyenye uhai vikubwa na vidogo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Huko meli huenda na kurudi,","poem":1},{"text":"pia Lewiathani,","poem":2},{"noteId":35},{"text":"uliyemuumba acheze ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Hawa wote wanakutazamia wewe,","poem":1},{"text":"uwape chakula chao kwa wakati wake.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wakati unapowapa,","poem":1},{"text":"wanakikusanya,","poem":2},{"text":"unapofumbua mkono wako,","poem":1},{"text":"wao wanashibishwa mema.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Unapoficha uso wako,","poem":1},{"text":"wanapata hofu,","poem":2},{"text":"unapoondoa pumzi yao,","poem":1},{"text":"wanakufa na kurudi mavumbini.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Unapopeleka Roho wako,","poem":1},{"text":"wanaumbwa,","poem":2},{"lineBreak":true},{"text":"nawe huufanya upya uso wa dunia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Utukufu wa Bwana na udumu milele,","poem":1},{"text":"Bwana na azifurahie kazi zake:","poem":2}]},{"type":"verse","number":32,"content":[{"text":"yeye aitazamaye dunia, nayo ikatetemeka,","poem":1},{"text":"aigusaye milima, nayo ikatoa moshi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Nitamwimbia Bwana maisha yangu yote;","poem":1},{"text":"nitaimba sifa kwa Mungu wangu muda wote ninaoishi.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kutafakari kwangu na kumpendeze yeye,","poem":1},{"text":"ninapofurahi katika Bwana.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Lakini wenye dhambi na watoweke katika dunia","poem":1},{"text":"na waovu wasiwepo tena.","poem":2},{"lineBreak":true},{"text":"Ee nafsi yangu, msifu Bwana.","poem":1},{"lineBreak":true},{"text":"Msifuni Bwana.","poem":1},{"noteId":36}]}],"footnotes":[{"noteId":34,"caller":"+","text":"Au: malaika.","reference":{"chapter":104,"verse":4}},{"noteId":35,"caller":"+","text":"Lewiathani ni mnyama mkubwa wa baharini mwenye magamba anayefanana na joka kubwa, mwenye umbo la kutisha, asiyeweza kuvuliwa.","reference":{"chapter":104,"verse":26}},{"noteId":36,"caller":"+","text":"Msifuni Bwana kwa Kiebrania ni Hallelu Yah.","reference":{"chapter":104,"verse":35}}]},"thisChapterLink":"/api/swh_bib/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}