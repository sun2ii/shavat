ext":"Ndipo walipomlilia Bwana katika shida yao,","poem":1},{"text":"naye akawaokoa kutoka taabu yao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akawaongoza kwa njia iliyo sawa","poem":1},{"text":"hadi mji ambao wangeweza kuishi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Basi na wamshukuru Bwana kwa upendo wake usiokoma,","poem":1},{"text":"na kwa matendo yake ya ajabu kwa wanadamu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kwa maana yeye humtosheleza mwenye kiu,","poem":1},{"text":"na kumshibisha mwenye njaa kwa vitu vyema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wengine walikaa gizani na katika huzuni kuu,","poem":1},{"text":"wafungwa wakiteseka katika minyororo,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kwa sababu walikuwa wameasi","poem":1},{"text":"dhidi ya maneno ya Mungu","poem":2},{"text":"na kudharau shauri","poem":1},{"text":"la Aliye Juu Sana.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Aliwatumikisha kwa kazi ngumu;","poem":1},{"text":"walijikwaa na hapakuwepo yeyote wa kuwasaidia.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndipo walipomlilia Bwana katika shida yao,","poem":1},{"text":"naye akawaokoa kutoka taabu yao.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Akawatoa katika giza na huzuni kuu","poem":1},{"text":"na akavunja minyororo yao.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Basi na wamshukuru Bwana kwa upendo wake usiokoma,","poem":1},{"text":"na kwa matendo yake ya ajabu kwa wanadamu,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kwa kuwa yeye huvunja malango ya shaba","poem":1},{"text":"na kukata mapingo ya chuma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wengine wakawa wapumbavu kutokana na uasi wao,","poem":1},{"text":"wakapata mateso kwa sababu ya uovu wao.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wakachukia kabisa vyakula vyote,","poem":1},{"text":"wakakaribia malango ya mauti.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Ndipo walipomlilia Bwana katika shida yao,","poem":1},{"text":"naye akawaokoa kutoka taabu yao.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akalituma neno lake na kuwaponya,","poem":1},{"text":"akawaokoa kutoka maangamizo yao.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Basi na wamshukuru Bwana kwa upendo wake usiokoma,","poem":1},{"text":"na kwa matendo yake ya ajabu kwa wanadamu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Na watoe dhabihu za kushukuru,","poem":1},{"text":"na wasimulie matendo yake kwa nyimbo za furaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Wengine walisafiri baharini kwa meli,","poem":1},{"text":"walikuwa wafanyabiashara kwenye maji makuu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Waliziona kazi za Bwana,","poem":1},{"text":"matendo yake ya ajabu kilindini.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Kwa maana alisema na kuamsha tufani","poem":1},{"text":"iliyoinua mawimbi juu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Yakainuka juu mbinguni, yakashuka chini hadi vilindini,","poem":1},{"text":"katika hatari hii ujasiri wao uliyeyuka.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Walipepesuka na kuyumbayumba kama walevi,","poem":1},{"text":"ujanja wao ukafikia ukomo.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ndipo walipomlilia Bwana katika shida yao,","poem":1},{"text":"naye akawatoa kwenye taabu yao.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Akatuliza dhoruba kwa mnongʼono,","poem":1},{"text":"mawimbi ya bahari yakatulia.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Walifurahi ilipokuwa shwari,","poem":1},{"text":"naye akawaongoza hadi bandari waliyoitamani.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Basi na wamshukuru Bwana kwa upendo wake usiokoma,","poem":1},{"text":"na kwa matendo yake ya ajabu kwa wanadamu.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Na wamtukuze yeye katika kusanyiko la watu,","poem":1},{"text":"na wamsifu katika baraza la wazee.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Yeye aligeuza mito kuwa jangwa,","poem":1},{"text":"chemchemi za maji zitiririkazo kuwa ardhi yenye kiu,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"nchi izaayo ikawa ya chumvi isiyofaa,","poem":1},{"text":"kwa sababu ya uovu wa wale walioishi humo.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Aligeuza jangwa likawa madimbwi ya maji,","poem":1},{"text":"nayo ardhi kame kuwa chemchemi za maji zitiririkazo;","poem":2}]},{"type":"verse","number":36,"content":[{"text":"aliwaleta wenye njaa wakaishi humo,","poem":1},{"text":"nao wakajenga mji wangeweza kuishi.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Walilima mashamba na kupanda mizabibu,","poem":1},{"text":"nayo ikazaa matunda mengi,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Mungu aliwabariki, hesabu yao ikaongezeka sana,","poem":1},{"text":"wala hakuruhusu mifugo yao kupungua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Kisha hesabu yao ilipungua, na walinyenyekeshwa","poem":1},{"text":"kwa kuonewa, maafa na huzuni.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Yeye ambaye huwamwagia dharau wakuu,","poem":1},{"text":"aliwafanya watangetange nyikani isiyo na njia.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Lakini yeye aliwainua wahitaji katika taabu zao,","poem":1},{"text":"na kuongeza jamaa zao kama makundi ya kondoo.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Wanyofu wataona na kufurahi,","poem":1},{"text":"lakini waovu wote watafunga vinywa vyao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Yeyote aliye na hekima, ayasikie mambo haya,","poem":1},{"text":"na atafakari upendo mkuu wa Bwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}