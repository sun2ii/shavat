{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Kumtumaini Bwana"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Kwa Bwana ninakimbilia,","poem":1},{"text":"unawezaje basi kuniambia:","poem":2},{"lineBreak":true},{"text":"“Ruka kama ndege kwenye mlima wako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hebu tazama, waovu wanapinda pinde zao,","poem":1},{"text":"huweka mishale kwenye uzi wake,","poem":2},{"text":"wakiwa gizani ili kuwapiga","poem":1},{"text":"wale wanyofu wa moyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wakati misingi imeharibiwa,","poem":1},{"text":"mwenye haki anaweza kufanya nini?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bwana yuko ndani ya Hekalu lake takatifu;","poem":1},{"text":"Bwana yuko kwenye kiti chake cha enzi mbinguni.","poem":2},{"text":"Huwaangalia wana wa watu,","poem":1},{"text":"macho yake yanawajaribu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwana huwajaribu wenye haki,","poem":1},{"text":"lakini waovu na wanaopenda jeuri,","poem":2},{"lineBreak":true},{"text":"nafsi yake huwachukia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atawanyeshea waovu makaa ya moto mkali","poem":1},{"text":"na kiberiti kinachowaka,","poem":2},{"lineBreak":true},{"text":"upepo wenye joto kali ndio fungu lao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwa kuwa Bwana ni mwenye haki,","poem":1},{"text":"yeye hupenda haki.","poem":2},{"lineBreak":true},{"text":"Wanyofu watauona uso wake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}