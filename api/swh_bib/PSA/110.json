{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"heading","content":["Bwana Na Mfalme Wake Mteule"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Bwana amwambia Bwana wangu:","poem":1},{"text":"“Keti mkono wangu wa kuume,","poem":2},{"text":"mpaka nitakapowafanya adui zako","poem":1},{"text":"kuwa mahali pa kuweka miguu yako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bwana ataeneza fimbo yako ya utawala yenye nguvu kutoka Sayuni;","poem":1},{"text":"utatawala katikati ya adui zako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Askari wako watajitolea kwa hiari","poem":1},{"text":"katika siku yako ya vita.","poem":2},{"text":"Ukiwa umevikwa fahari takatifu,","poem":1},{"text":"kutoka tumbo la mapambazuko","poem":2},{"lineBreak":true},{"text":"utapokea umande wa ujana wako.","poem":2},{"noteId":39}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bwana ameapa,","poem":1},{"text":"naye hatabadilisha mawazo yake:","poem":2},{"lineBreak":true},{"text":"“Wewe ni kuhani milele,","poem":2},{"lineBreak":true},{"text":"kwa mfano wa Melkizedeki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwana yuko mkono wako wa kuume,","poem":1},{"text":"atawaponda wafalme siku ya ghadhabu yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atawahukumu mataifa, akilundika mizoga","poem":1},{"text":"na kuwaponda watawala wa dunia nzima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Atakunywa maji katika kijito kando ya njia,","poem":1},{"noteId":40},{"text":"kwa hiyo atainua kichwa chake juu.","poem":2}]}],"footnotes":[{"noteId":39,"caller":"+","text":"Au: vijana wako watakujia kama umande.","reference":{"chapter":110,"verse":3}},{"noteId":40,"caller":"+","text":"Au: Yeye atoaye mtu wa kurithi mwingine atamweka kwenye mamlaka.","reference":{"chapter":110,"verse":7}}]},"thisChapterLink":"/api/swh_bib/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}