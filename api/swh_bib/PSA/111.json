wa kazi zake,","poem":1},{"text":"akiwapa nchi za mataifa mengine.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kazi za mikono yake ni za uaminifu na haki,","poem":1},{"text":"mausia yake yote ni ya kuaminika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zinadumu milele na milele,","poem":1},{"text":"zikifanyika kwa uaminifu na unyofu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aliwapa watu wake ukombozi,","poem":1},{"text":"aliamuru agano lake milele:","poem":2},{"lineBreak":true},{"text":"jina lake ni takatifu na la kuogopwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kumcha Bwana ndicho chanzo cha hekima,","poem":1},{"text":"wote wanaozifuata amri zake wana busara.","poem":2},{"lineBreak":true},{"text":"Sifa zake zadumu milele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}