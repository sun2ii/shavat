{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["Baraka Za Mwenye Haki"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Bwana.","poem":1},{"lineBreak":true},{"text":"Heri mtu yule amchaye Bwana,","poem":1},{"text":"mtu yule apendezwaye sana na amri zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Watoto wake watakuwa wenye uwezo katika nchi,","poem":1},{"text":"kizazi cha watu waadilifu kitabarikiwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyumbani mwake kuna mali na utajiri,","poem":1},{"text":"haki yake hudumu milele.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hata gizani nuru humzukia mtu mwadilifu,","poem":1},{"text":"yule mwenye rehema, huruma na haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mema yatamjia mtu yule aliye mkarimu na mwenye kukopesha bila riba,","poem":1},{"text":"anayefanya mambo yake kwa haki.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hakika hatatikisika kamwe,","poem":1},{"text":"mtu mwenye haki atakumbukwa milele.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hataogopa habari mbaya,","poem":1},{"text":"moyo wake ni thabiti, ukimtegemea Bwana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moyo wake ni salama, hatakuwa na hofu,","poem":1},{"text":"mwishoni ataona ushindi dhidi ya adui zake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ametawanya vipawa vyake kwa ukarimu akawapa maskini;","poem":1},{"text":"haki yake hudumu milele;","poem":2},{"lineBreak":true},{"text":"pembe yake itatukuzwa kwa heshima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mtu mwovu ataona na kuchukizwa,","poem":1},{"text":"atasaga meno yake na kutoweka,","poem":2},{"lineBreak":true},{"text":"kutamani kwa mtu mwovu kutaishia patupu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}