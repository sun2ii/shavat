xt":"aone mbingu na nchi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Huwainua maskini kutoka mavumbini,","poem":1},{"text":"na kuwanyanyua wahitaji kutoka kwenye jalala,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"huwaketisha pamoja na wakuu,","poem":1},{"text":"pamoja na wakuu wa watu wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Humjalia mwanamke tasa kutulia nyumbani mwake,","poem":1},{"text":"akiwa mama watoto mwenye furaha.","poem":2},{"lineBreak":true},{"text":"Msifuni Bwana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}