{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"heading","content":["Mungu Mmoja Wa Kweli"]},{"type":"verse","number":1,"content":[{"text":"Sio kwetu sisi, Ee Bwana, sio kwetu sisi,","poem":1},{"text":"bali utukufu ni kwa jina lako,","poem":2},{"text":"kwa sababu ya upendo","poem":1},{"text":"na uaminifu wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kwa nini mataifa waseme,","poem":1},{"text":"“Yuko wapi Mungu wao?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mungu wetu yuko mbinguni,","poem":1},{"text":"naye hufanya lolote limpendezalo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini sanamu zao ni za fedha na dhahabu,","poem":1},{"text":"zilizotengenezwa kwa mikono ya wanadamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zina vinywa, lakini haziwezi kusema,","poem":1},{"text":"zina macho, lakini haziwezi kuona;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"zina masikio, lakini haziwezi kusikia,","poem":1},{"text":"zina pua, lakini haziwezi kunusa;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"zina mikono, lakini haziwezi kupapasa,","poem":1},{"text":"zina miguu, lakini haziwezi kutembea;","poem":2},{"lineBreak":true},{"text":"wala koo zao haziwezi kutoa sauti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wale wanaozitengeneza watafanana nazo,","poem":1},{"text":"vivyo hivyo wale wote wanaozitumainia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee nyumba ya Israeli, mtumainini Bwana,","poem":1},{"text":"yeye ni msaada na ngao yao.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee nyumba ya Aroni, mtumainini Bwana,","poem":1},{"text":"yeye ni msaada na ngao yao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ninyi mnaomcha, mtumainini Bwana,","poem":1},{"text":"yeye ni msaada na ngao yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Bwana anatukumbuka na atatubariki:","poem":1},{"text":"ataibariki nyumba ya Israeli,","poem":2},{"lineBreak":true},{"text":"ataibariki nyumba ya Aroni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"atawabariki wale wanaomcha Bwana,","poem":1},{"text":"wadogo kwa wakubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bwana na awawezeshe kuongezeka,","poem":1},{"text":"ninyi na watoto wenu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mbarikiwe na Bwana","poem":1},{"text":"Muumba wa mbingu na dunia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mbingu zilizo juu sana ni mali ya Bwana,","poem":1},{"text":"lakini dunia amempa mwanadamu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sio wafu wanaomsifu Bwana,","poem":1},{"text":"wale washukao mahali pa kimya,","poem":2},{"noteId":41}]},{"type":"verse","number":18,"content":[{"text":"bali ni sisi tunaomtukuza Bwana,","poem":1},{"text":"sasa na hata milele.","poem":2},{"lineBreak":true},{"text":"Msifuni Bwana.","poem":1},{"noteId":42}]}],"footnotes":[{"noteId":41,"caller":"+","text":"Mahali pa kimya maana yake ni Kuzimu, yaani Sheol kwa Kiebrania.","reference":{"chapter":115,"verse":17}},{"noteId":42,"caller":"+","text":"Msifuni Bwana ni Kiebrania Hallelu Yah.","reference":{"chapter":115,"verse":18}}]},"thisChapterLink":"/api/swh_bib/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}