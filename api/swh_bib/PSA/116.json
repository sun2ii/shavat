{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["Shukrani Kwa Kuokolewa Kutoka Mauti"]},{"type":"verse","number":1,"content":[{"text":"Ninampenda Bwana kwa maana amesikia sauti yangu;","poem":1},{"text":"amesikia kilio changu ili anihurumie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa sababu amenitegea sikio lake,","poem":1},{"text":"nitamwita siku zote za maisha yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kamba za mauti zilinizunguka,","poem":1},{"text":"maumivu makuu ya kuzimu yalinipata,","poem":2},{"lineBreak":true},{"text":"nikalemewa na taabu na huzuni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo nikaliitia jina la Bwana:","poem":1},{"text":"“Ee Bwana, niokoe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwana ni mwenye neema na haki,","poem":1},{"text":"Mungu wetu ni mwingi wa huruma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwana huwalinda wanyenyekevu,","poem":1},{"text":"nilipokuwa katika shida kubwa, aliniokoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee nafsi yangu, tulia tena,","poem":1},{"text":"kwa kuwa Bwana amekuwa mwema kwako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa kuwa wewe, Ee Bwana,","poem":1},{"text":"umeniokoa nafsi yangu na mauti,","poem":2},{"text":"macho yangu kutokana na machozi,","poem":1},{"text":"miguu yangu kutokana na kujikwaa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ili niweze kutembea mbele za Bwana,","poem":1},{"text":"katika nchi ya walio hai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Niliamini, kwa hiyo nilisema,","poem":1},{"text":"“Mimi nimeteseka sana.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Katika taabu yangu nilisema,","poem":1},{"text":"“Wanadamu wote ni waongo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nimrudishie Bwana nini","poem":1},{"text":"kwa wema wake wote alionitendea?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nitakiinua kikombe cha wokovu","poem":1},{"text":"na kulitangaza jina la Bwana.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitazitimiza nadhiri zangu kwa Bwana","poem":1},{"text":"mbele za watu wake wote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kifo cha watakatifu kina thamani","poem":1},{"text":"machoni pa Bwana.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Bwana, hakika mimi ni mtumishi wako,","poem":1},{"text":"mimi ni mtumishi wako,","poem":2},{"lineBreak":true},{"text":"mwana wa mjakazi wako;","poem":2},{"noteId":43},{"text":"umeniweka huru","poem":1},{"text":"toka katika minyororo yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nitakutolea dhabihu ya kukushukuru","poem":1},{"text":"na kuliita jina la Bwana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nitazitimiza nadhiri zangu kwa Bwana","poem":1},{"text":"mbele za watu wake wote,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"katika nyua za nyumba ya Bwana,","poem":1},{"text":"katikati yako, ee Yerusalemu.","poem":2},{"lineBreak":true},{"text":"Msifuni Bwana.","poem":2}]}],"footnotes":[{"noteId":43,"caller":"+","text":"Au: mwanao mwaminifu.","reference":{"chapter":116,"verse":16}}]},"thisChapterLink":"/api/swh_bib/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}