{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"heading","content":["Shukrani Kwa Ajili Ya Ushindi"]},{"type":"verse","number":1,"content":[{"text":"Mshukuruni Bwana, kwa kuwa ni mwema;","poem":1},{"text":"upendo wake wadumu milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Israeli na aseme sasa:","poem":1},{"text":"“Upendo wake wadumu milele.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyumba ya Aroni na iseme sasa:","poem":1},{"text":"“Upendo wake wadumu milele.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wote wamchao Bwana na waseme sasa:","poem":1},{"text":"“Upendo wake wadumu milele.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wakati wa maumivu yangu makuu nilimlilia Bwana,","poem":1},{"text":"naye akanijibu kwa kuniweka huru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwana yuko pamoja nami, sitaogopa.","poem":1},{"text":"Mwanadamu anaweza kunitenda nini?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bwana yuko pamoja nami,","poem":1},{"text":"yeye ni msaidizi wangu.","poem":2},{"text":"Nitawatazama adui zangu","poem":1},{"text":"wakiwa wameshindwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ni bora kumkimbilia Bwana","poem":1},{"text":"kuliko kumtumainia mwanadamu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ni bora kumkimbilia Bwana","poem":1},{"text":"kuliko kuwatumainia wakuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mataifa yote yalinizunguka,","poem":1},{"text":"lakini kwa jina la Bwana naliwakatilia mbali.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Walinizunguka pande zote,","poem":1},{"text":"lakini kwa jina la Bwana naliwakatilia mbali.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Walinizunguka kama kundi la nyuki,","poem":1},{"text":"lakini walikufa haraka kama miiba iteketeayo;","poem":2},{"lineBreak":true},{"text":"kwa jina la Bwana naliwakatilia mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nilisukumwa nyuma karibu kuanguka,","poem":1},{"text":"lakini Bwana alinisaidia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bwana ni nguvu yangu na wimbo wangu,","poem":1},{"text":"yeye amefanyika wokovu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sauti za shangwe na ushindi","poem":1},{"text":"zinavuma hemani mwa wenye haki:","poem":2},{"text":"“Mkono wa kuume wa Bwana","poem":1},{"text":"umetenda mambo makuu!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mkono wa kuume wa Bwana","poem":1},{"text":"umeinuliwa juu,","poem":2},{"text":"mkono wa kuume wa Bwana","poem":1},{"text":"umetenda mambo makuu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sitakufa, bali nitaishi,","poem":1},{"text":"nami nitatangaza yale Bwana aliyoyatenda.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bwana ameniadhibu vikali,","poem":1},{"text":"lakini hakuniacha nife.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nifungulie malango ya haki,","poem":1},{"text":"nami nitaingia na kumshukuru Bwana.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hili ni lango la Bwana","poem":1},{"text":"ambalo wenye haki wanaweza kuliingia.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nitakushukuru, kwa kuwa ulinijibu,","poem":1},{"text":"umekuwa wokovu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Jiwe walilolikataa waashi,","poem":1},{"text":"limekuwa jiwe kuu la pembeni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Bwana ametenda hili,","poem":1},{"text":"nalo ni la kushangaza machoni petu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hii ndiyo siku Bwana aliyoifanya,","poem":1},{"text":"tushangilie na kufurahi ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ee Bwana, tuokoe,","poem":1},{"text":"Ee Bwana, utujalie mafanikio.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Heri yule ajaye kwa jina la Bwana.","poem":1},{"text":"Kutoka nyumba ya Bwana tunakubariki.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Bwana ndiye Mungu,","poem":1},{"text":"naye ametuangazia nuru yake.","poem":2},{"text":"Mkiwa na matawi mkononi,","poem":1},{"text":"unganeni kwenye maandamano ya sikukuu","poem":2},{"lineBreak":true},{"text":"hadi kwenye pembe za madhabahu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wewe ni Mungu wangu, nitakushukuru,","poem":1},{"text":"wewe ni Mungu wangu, nitakutukuza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mshukuruni Bwana kwa kuwa ni mwema;","poem":1},{"text":"upendo wake wadumu milele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}