{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"heading","content":["Sifa Za Sheria Ya Bwana"]},{"type":"heading","content":["Kujifunza Sheria Ya Bwana"]},{"type":"verse","number":1,"content":[{"text":"Heri wale walio waadilifu katika njia zao,","poem":1},{"text":"wanaoenenda katika sheria ya Bwana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Heri wale wanaozishika shuhuda zake,","poem":1},{"text":"wamtafutao kwa moyo wao wote.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wasiofanya lolote lililo baya,","poem":1},{"text":"wanaoenenda katika njia zake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umetoa maagizo yako","poem":1},{"text":"ili tuyatii kwa ukamilifu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Laiti mwenendo wangu ungekuwa imara","poem":1},{"text":"katika kuyatii maagizo yako!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hivyo mimi sitaaibishwa","poem":1},{"text":"ninapozingatia amri zako zote.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nitakusifu kwa moyo mnyofu","poem":1},{"text":"ninapojifunza sheria zako za haki.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nitayatii maagizo yako;","poem":1},{"text":"usiniache kabisa.","poem":2}]},{"type":"heading","content":["Kutii Sheria Ya Bwana"]},{"type":"verse","number":9,"content":[{"text":"Kijana aifanye njia yake kuwa safi jinsi gani?","poem":1},{"text":"Ni kwa kutii, akilifuata neno lako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ninakutafuta kwa moyo wangu wote,","poem":1},{"text":"usiniache niende mbali na amri zako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nimelificha neno lako moyoni mwangu","poem":1},{"text":"ili nisikutende dhambi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sifa ni zako, Ee Bwana,","poem":1},{"text":"nifundishe maagizo yako.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa midomo yangu nitasimulia sheria zote","poem":1},{"text":"zinazotoka katika kinywa chako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ninafurahia kufuata sheria zako","poem":1},{"text":"kama mtu afurahiaye mali nyingi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ninatafakari maagizo yako","poem":1},{"text":"na kuziangalia njia zako.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ninafurahia maagizo yako,","poem":1},{"text":"wala sitalipuuza neno lako.","poem":2}]},{"type":"heading","content":["Furaha Katika Sheria Ya Bwana"]},{"type":"verse","number":17,"content":[{"text":"Mtendee mema mtumishi wako, nami nitaishi;","poem":1},{"text":"nitalitii neno lako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yafungue macho yangu nipate kuona","poem":1},{"text":"mambo ya ajabu katika sheria yako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mimi ni mgeni duniani,","poem":1},{"text":"usinifiche amri zako.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nafsi yangu inataabika kwa shauku kubwa","poem":1},{"text":"juu ya sheria zako wakati wote.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Unawakemea wenye majivuno, waliolaaniwa","poem":1},{"text":"waendao mbali na amri zako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Niondolee dharau na dhihaka,","poem":1},{"text":"kwa kuwa ninazishika sheria zako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ingawa watawala huketi pamoja na kunisingizia,","poem":1},{"text":"mtumishi wako atatafakari juu ya maagizo yako.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sheria zako ni furaha yangu,","poem":1},{"text":"nazo ni washauri wangu.","poem":2}]},{"type":"heading","content":["Kuamua Kuitii Sheria Ya Bwana"]},{"type":"verse","number":25,"content":[{"text":"Nimelazwa chini mavumbini,","poem":1},{"text":"yahifadhi maisha yangu sawasawa na neno lako.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nilikueleza njia zangu ukanijibu,","poem":1},{"text":"nifundishe sheria zako.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nijulishe mafundisho ya mausia yako,","poem":1},{"text":"nami nitatafakari maajabu yako.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nafsi yangu imechakazwa kwa huzuni,","poem":1},{"text":"uniimarishe sawasawa na neno lako.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Niepushe na njia za udanganyifu,","poem":1},{"text":"kwa neema unifundishe sheria zako.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nimechagua njia ya kweli,","poem":1},{"text":"nimekaza moyo wangu katika sheria zako.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Nimengʼangʼania sheria zako, Ee Bwana,","poem":1},{"text":"usiniache niaibishwe.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nakimbilia katika njia ya maagizo yako,","poem":1},{"text":"kwa kuwa umeuweka moyo wangu huru.","poem":2}]},{"type":"heading","content":["Maombi Ili Kupata Ufahamu Wa Sheria"]},{"type":"verse","number":33,"content":[{"text":"Ee Bwana, nifundishe kuyafuata maagizo yako,","poem":1},{"text":"nami nitayashika mpaka mwisho.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Nipe ufahamu, nami nitaishika sheria yako","poem":1},{"text":"na kuitii kwa moyo wangu wote.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Niongoze kwenye njia ya amri zako,","poem":1},{"text":"kwa kuwa huko napata furaha.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Ugeuze moyo wangu kuelekea sheria zako,","poem":1},{"text":"na siyo kwenye mambo ya ubinafsi.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Geuza macho yangu kutoka kwenye mambo yasiyofaa,","poem":1},{"text":"uyahifadhi maisha yangu sawasawa na neno lako.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Mtimizie mtumishi wako ahadi yako,","poem":1},{"text":"ili upate kuogopwa.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Niondolee aibu ninayoiogopa,","poem":1},{"text":"kwa kuwa sheria zako ni njema.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Tazama jinsi ninavyoonea shauku mausia yako!","poem":1},{"text":"Hifadhi maisha yangu katika haki yako.","poem":2}]},{"type":"heading","content":["Kuitumainia Sheria Ya Bwana"]},{"type":"verse","number":41,"content":[{"text":"Ee Bwana, upendo wako usiokoma unijie,","poem":1},{"text":"wokovu wako sawasawa na ahadi yako,","poem":2}]},{"type":"verse","number":42,"content":[{"text":"ndipo nitakapomjibu anayenidhihaki,","poem":1},{"text":"kwa kuwa ninalitumainia neno lako.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Usilinyakue neno la kweli kutoka kinywani mwangu,","poem":1},{"text":"kwa kuwa nimeweka tumaini langu katika amri zako.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Nitaitii amri yako daima,","poem":1},{"text":"naam, milele na milele.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Nitatembea nikiwa huru,","poem":1},{"text":"kwa kuwa nimejifunza mausia yako.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Nitasema sheria zako mbele za wafalme","poem":1},{"text":"wala sitaaibishwa,","poem":2}]},{"type":"verse","number":47,"content":[{"text":"kwa kuwa ninazifurahia amri zako","poem":1},{"text":"kwa sababu ninazipenda.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ninaziinulia amri zako ambazo ninazipenda mikono yangu,","poem":1},{"text":"nami ninatafakari juu ya maagizo yako.","poem":2}]},{"type":"heading","content":["Matumaini Katika Sheria Ya Bwana"]},{"type":"verse","number":49,"content":[{"text":"Kumbuka neno lako kwa mtumishi wako,","poem":1},{"text":"kwa sababu umenipa tumaini.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Faraja yangu katika mateso yangu ni hii:","poem":1},{"text":"Ahadi yako inahifadhi maisha yangu.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Wenye majivuno wamenisimanga bila kuchoka,","poem":1},{"text":"hata hivyo sitaiacha sheria yako.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Ee Bwana, ninazikumbuka sheria zako za zamani,","poem":1},{"text":"nazo zinanifariji.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Nimeshikwa sana na ghadhabu kwa ajili ya waovu,","poem":1},{"text":"ambao wameacha sheria yako.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Maagizo yako ni kiini cha nyimbo zangu","poem":1},{"text":"popote ninapoishi.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Ee Bwana, wakati wa usiku ninalikumbuka jina lako,","poem":1},{"text":"nami nitatii sheria yako.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"Hili limekuwa zoezi langu:","poem":1},{"text":"nami ninayatii mausia yako.","poem":2}]},{"type":"heading","content":["Kujitolea Katika Sheria Ya Bwana"]},{"type":"verse","number":57,"content":[{"text":"Ee Bwana, wewe ni fungu langu,","poem":1},{"text":"nimeahidi kuyatii maneno yako.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Nimetafuta uso wako kwa moyo wangu wote,","poem":1},{"text":"nihurumie sawasawa na ahadi yako.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Nimezifikiri njia zangu","poem":1},{"text":"na nimeelekeza hatua zangu katika mausia yako.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Nitafanya haraka bila kuchelewa","poem":1},{"text":"kuzitii amri zako.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Hata waovu wanifunge kwa kamba,","poem":1},{"text":"sitasahau sheria yako.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Usiku wa manane ninaamka kukushukuru","poem":1},{"text":"kwa sababu ya sheria zako za haki.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Mimi ni rafiki kwa wale wote wakuchao,","poem":1},{"text":"kwa wote wanaofuata mausia yako.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"Ee Bwana, dunia imejaa upendo wako,","poem":1},{"text":"nifundishe maagizo yako.","poem":2}]},{"type":"heading","content":["Thamani Ya Sheria Ya Bwana"]},{"type":"verse","number":65,"content":[{"text":"Mtendee wema mtumishi wako","poem":1},{"text":"Ee Bwana, sawasawa na neno lako.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Nifundishe maarifa na uamuzi mzuri,","poem":1},{"text":"kwa kuwa ninaamini amri zako.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Kabla sijapata shida nilipotea njia,","poem":1},{"text":"lakini sasa ninalitii neno lako.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"Wewe ni mwema, unalotenda ni jema,","poem":1},{"text":"nifundishe maagizo yako.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Ingawa wenye majivuno wamenisingizia uongo,","poem":1},{"text":"nitafuata mausia yako kwa moyo wangu wote.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Mioyo yao ni katili na migumu,","poem":1},{"text":"bali mimi napendezwa na sheria yako.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Ilikuwa vyema mimi kupata shida","poem":1},{"text":"ili nipate kujifunza maagizo yako.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Sheria inayotoka kinywani mwako ina thamani kubwa kwangu","poem":1},{"text":"kuliko maelfu ya vipande vya fedha na dhahabu.","poem":2}]},{"type":"heading","content":["Haki Ya Sheria Ya Bwana"]},{"type":"verse","number":73,"content":[{"text":"Mikono yako ilinifanya na kuniumba,","poem":1},{"text":"nipe ufahamu niweze kujifunza amri zako.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"Wakuchao wafurahie wanaponiona,","poem":1},{"text":"kwa kuwa nimeweka tumaini langu katika neno lako.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"Ee Bwana, ninajua kwamba sheria zako ni za haki,","poem":1},{"text":"katika uaminifu wako umeniadhibu.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"Upendo wako usiokoma uwe faraja yangu,","poem":1},{"text":"sawasawa na ahadi yako kwa mtumishi wako.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"Huruma yako na inijie ili nipate kuishi,","poem":1},{"text":"kwa kuwa naifurahia sheria yako.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"Wenye majivuno na waaibishwe kwa kunikosea mimi bila sababu,","poem":1},{"text":"lakini mimi nitatafakari juu ya mausia yako.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"Wale wakuchao na wanigeukie mimi,","poem":1},{"text":"hao ambao wanazielewa sheria zako.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"Moyo wangu usiwe na lawama katika kutii maagizo yako,","poem":1},{"text":"ili nisiaibishwe.","poem":2}]},{"type":"heading","content":["Maombi Kwa Ajili Ya Kuokolewa"]},{"type":"verse","number":81,"content":[{"text":"Nafsi yangu inazimia kwa kutamani wokovu wako,","poem":1},{"text":"lakini nimeweka tumaini langu katika neno lako.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"Macho yangu yamefifia, nikingoja ahadi yako;","poem":1},{"text":"ninasema, “Utanifajiri lini?”","poem":2}]},{"type":"verse","number":83,"content":[{"text":"Ingawa nimekuwa kama kiriba kwenye moshi,","poem":1},{"text":"bado sijasahau maagizo yako.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"Mtumishi wako itampasa angoje mpaka lini?","poem":1},{"text":"Ni lini utawaadhibu washtaki wangu?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"Wenye majivuno wananichimbia mashimo,","poem":1},{"text":"kinyume na sheria yako.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"Amri zako zote ni za kuaminika;","poem":1},{"text":"unisaidie, kwa sababu watu wananishtaki bila sababu.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"Walikaribia kabisa kunifuta kutoka uso wa dunia,","poem":1},{"text":"lakini sijaacha mausia yako.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"Yahifadhi maisha yangu sawasawa na upendo wako,","poem":1},{"text":"nami nitatii sheria za kinywa chako.","poem":2}]},{"type":"heading","content":["Imani Katika Sheria Ya Bwana"]},{"type":"verse","number":89,"content":[{"text":"Ee Bwana, neno lako ni la milele,","poem":1},{"text":"linasimama imara mbinguni.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"Uaminifu wako unaendelea kwa vizazi vyote,","poem":1},{"text":"umeiumba dunia, nayo inadumu.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"Sheria zako zinadumu hadi leo,","poem":1},{"text":"kwa kuwa vitu vyote vinakutumikia.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"Kama nisingefurahia sheria yako,","poem":1},{"text":"ningeangamia katika taabu zangu.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"Sitasahau mausia yako kamwe,","poem":1},{"text":"kwa maana kwayo umehifadhi maisha yangu.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"Uniokoe, kwa maana mimi ni wako,","poem":1},{"text":"kwa kuwa nimetafuta mausia yako.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"Waovu wanangojea kuniangamiza,","poem":1},{"text":"bali mimi ninatafakari sheria zako.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"Katika ukamilifu wote ninaona mna kikomo,","poem":1},{"text":"lakini amri zako hazina mpaka.","poem":2}]},{"type":"heading","content":["Kuipenda Sheria Ya Bwana"]},{"type":"verse","number":97,"content":[{"text":"Aha! Tazama, sheria yako naipenda mno ajabu.","poem":1},{"text":"Ninaitafakari mchana kutwa.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"Amri zako zimenipa hekima zaidi kuliko adui zangu,","poem":1},{"text":"kwa kuwa nimezishika daima.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"Nina akili zaidi kuliko walimu wangu wote,","poem":1},{"text":"kwa kuwa ninatafakari juu ya sheria zako.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"Nina ufahamu zaidi kuliko wazee,","poem":1},{"text":"kwa kuwa ninayatii mausia yako.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"Nimezuia miguu yangu isiende kwenye kila njia mbaya,","poem":1},{"text":"ili niweze kutii neno lako.","poem":2}]},{"type":"verse","number":102,"content":[{"text":"Sijaziacha sheria zako,","poem":1},{"text":"kwa kuwa umenifundisha wewe mwenyewe.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"Tazama jinsi maneno yako yalivyo matamu kwangu,","poem":1},{"text":"matamu kuliko asali katika kinywa changu!","poem":2}]},{"type":"verse","number":104,"content":[{"text":"Ninapata ufahamu kutoka mausia yako,","poem":1},{"text":"kwa hiyo ninachukia kila njia ya upotovu.","poem":2}]},{"type":"heading","content":["Nuru Kutoka Kwenye Sheria Ya Bwana"]},{"type":"verse","number":105,"content":[{"text":"Neno lako ni taa ya miguu yangu","poem":1},{"text":"na mwanga katika njia yangu.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"Nimeapa na nimethibitisha,","poem":1},{"text":"kwamba nitafuata sheria zako za haki.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"Nimeteseka sana, uhifadhi maisha yangu, Ee Bwana,","poem":1},{"text":"sawasawa na neno lako.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"Ee Bwana, pokea sifa za hiari za kinywa changu,","poem":1},{"text":"nifundishe sheria zako.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"Ingawa maisha yangu yako hatarini siku zote,","poem":1},{"text":"sitasahau sheria yako.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"Waovu wamenitegea mtego,","poem":1},{"text":"lakini sijayakiuka maagizo yako.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"Sheria zako ni urithi wangu milele,","poem":1},{"text":"naam ni furaha ya moyo wangu.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"Nimekusudia moyoni mwangu","poem":1},{"text":"kuyafuata maagizo yako mpaka mwisho.","poem":2}]},{"type":"heading","content":["Usalama Ndani Ya Sheria Ya Bwana"]},{"type":"verse","number":113,"content":[{"text":"Ninachukia watu wa nia mbili,","poem":1},{"text":"lakini ninapenda sheria yako.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"Wewe ni kimbilio langu na ngao yangu,","poem":1},{"text":"nimeweka tumaini langu katika neno lako.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"Ondokeni kwangu, ninyi mtendao mabaya,","poem":1},{"text":"ili niweze kushika amri za Mungu wangu!","poem":2}]},{"type":"verse","number":116,"content":[{"text":"Nihifadhi sawasawa na ahadi yako, nami nitaishi;","poem":1},{"text":"usiache matumaini yangu yakavunjwa.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"Nitegemeze, nami nitaokolewa,","poem":1},{"text":"nami daima nitayaheshimu maagizo yako.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"Unawakataa wote wanaoyaasi maagizo yako,","poem":1},{"text":"kwa maana udanganyifu wao ni bure.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"Waovu wa nchi unawatupa kama takataka,","poem":1},{"text":"kwa hivyo nazipenda sheria zako.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"Mwili wangu unatetemeka kwa kukuogopa wewe,","poem":1},{"text":"ninaziogopa sheria zako.","poem":2}]},{"type":"heading","content":["Kuitii Sheria Ya Bwana"]},{"type":"verse","number":121,"content":[{"text":"Nimetenda yaliyo haki na sawa,","poem":1},{"text":"usiniache mikononi mwa watesi wangu.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"Mhakikishie mtumishi wako usalama,","poem":1},{"text":"usiache wenye kiburi wanionee.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"Macho yangu yamefifia, yakitazamia wokovu wako,","poem":1},{"text":"na kuitazamia ahadi yako ya kweli.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"Mfanyie mtumishi wako kulingana na upendo wako","poem":1},{"text":"na unifundishe maagizo yako.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"Mimi ni mtumishi wako; nipe ufahamu","poem":1},{"text":"ili niweze kuelewa sheria zako.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"Ee Bwana, wakati wako wa kutenda umewadia,","poem":1},{"text":"kwa kuwa sheria yako inavunjwa.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"Kwa sababu nazipenda amri zako zaidi ya dhahabu,","poem":1},{"text":"naam, zaidi ya dhahabu safi,","poem":2}]},{"type":"verse","number":128,"content":[{"text":"na kwa sababu naona maagizo yako yote ni adili,","poem":1},{"text":"nachukia kila njia potovu.","poem":2}]},{"type":"heading","content":["Shauku Ya Kuitii Sheria Ya Bwana"]},{"type":"verse","number":129,"content":[{"text":"Sheria zako ni za ajabu,","poem":1},{"text":"hivyo ninazitii.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"Kuingia kwa maneno yako kunaleta nuru,","poem":1},{"text":"kunampa mjinga ufahamu.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"Nimefungua kinywa changu na kuhema,","poem":1},{"text":"nikitamani amri zako.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"Nigeukie na unihurumie, kama uwafanyiavyo siku zote","poem":1},{"text":"wale wanaolipenda jina lako.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"Ongoza hatua zangu kulingana na neno lako,","poem":1},{"text":"usiache dhambi yoyote initawale.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"Niokoe na uonevu wa wanadamu,","poem":1},{"text":"ili niweze kutii mausia yako.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"Mwangazie mtumishi wako uso wako","poem":1},{"text":"na unifundishe amri zako.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"Chemchemi za machozi zinatiririka kutoka machoni yangu,","poem":1},{"text":"kwa kuwa sheria yako haifuatwi.","poem":2}]},{"type":"heading","content":["Haki Ya Sheria Ya Bwana"]},{"type":"verse","number":137,"content":[{"text":"Ee Bwana, wewe ni mwenye haki,","poem":1},{"text":"sheria zako ni sahihi.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"Sheria ulizoziweka ni za haki,","poem":1},{"text":"ni za kuaminika kikamilifu.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"Jitihada yangu imenidhoofisha, kwa kuwa adui zangu","poem":1},{"text":"wanayapuuza maneno yako.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"Ahadi zako zimejaribiwa kikamilifu,","poem":1},{"text":"mtumishi wako anazipenda.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"Ingawa ni mdogo na ninadharauliwa,","poem":1},{"text":"sisahau mausia yako.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"Haki yako ni ya milele,","poem":1},{"text":"na sheria yako ni kweli.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"Shida na dhiki zimenipata,","poem":1},{"text":"lakini amri zako ni furaha yangu.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"Sheria zako ni sahihi milele,","poem":1},{"text":"hunipa ufahamu ili nipate kuishi.","poem":2}]},{"type":"heading","content":["Maombi Kwa Ajili Ya Kuokolewa"]},{"type":"verse","number":145,"content":[{"text":"Ee Bwana, ninakuita kwa moyo wangu wote,","poem":1},{"text":"nami nitayatii maagizo yako.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"Ninakuita; niokoe","poem":1},{"text":"nami nitazishika sheria zako.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"Ninaamka asubuhi na mapema na kukuomba msaada;","poem":1},{"text":"nimeweka tumaini langu katika neno lako.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"Sikufumba macho yangu usiku kucha,","poem":1},{"text":"ili niweze kutafakari juu ya ahadi zako.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"Usikie sauti yangu sawasawa na upendo wako,","poem":1},{"text":"Ee Bwana, uyahifadhi maisha yangu, sawasawa na sheria zako.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"Wale wanaopanga mipango miovu wako karibu nami,","poem":1},{"text":"lakini wako mbali na sheria yako.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"Ee Bwana, hata hivyo wewe u karibu,","poem":1},{"text":"na amri zako zote ni za kweli.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"Tangu zamani nimejifunza kutoka shuhuda zako","poem":1},{"text":"kwamba umezithibitisha ili zidumu milele.","poem":2}]},{"type":"heading","content":["Maombi Kwa Ajili Ya Msaada"]},{"type":"verse","number":153,"content":[{"text":"Yaangalie mateso yangu, uniokoe,","poem":1},{"text":"kwa kuwa sijasahau sheria yako.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"Nitetee katika hali hii yangu na unikomboe,","poem":1},{"text":"uyahifadhi maisha yangu sawasawa na ahadi yako.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"Wokovu uko mbali na waovu,","poem":1},{"text":"kwa kuwa hawatafuti maagizo yako.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"Ee Bwana, huruma zako ni kuu,","poem":1},{"text":"uyahifadhi maisha yangu sawasawa na sheria zako.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"Adui wanaonitesa ni wengi,","poem":1},{"text":"lakini mimi sitaziacha sheria zako.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"Ninawatazama wasioamini kwa chuki,","poem":1},{"text":"kwa kuwa hawalitii neno lako.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"Tazama jinsi ninavyopenda mausia yako;","poem":1},{"text":"Ee Bwana, uyahifadhi maisha yangu, sawasawa na upendo wako.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"Maneno yako yote ni kweli,","poem":1},{"text":"sheria zako zote za haki ni za milele.","poem":2}]},{"type":"heading","content":["Kujiweka Wakfu Kwa Sheria Ya Bwana"]},{"type":"verse","number":161,"content":[{"text":"Watawala wamenitesa bila sababu,","poem":1},{"text":"lakini moyo wangu unatetemeka kwa neno lako.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"Nafurahia ahadi zako","poem":1},{"text":"kama mtu aliyepata mateka mengi.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"Ninachukia na kuchukizwa sana na uongo,","poem":1},{"text":"lakini napenda sheria yako.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"Ninakusifu mara saba kwa siku,","poem":1},{"text":"kwa ajili ya sheria zako za haki.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"Wanaopenda sheria yako wana amani tele,","poem":1},{"text":"wala hakuna kitu kinachoweza kuwakwaza.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"Ee Bwana, ninangojea wokovu wako,","poem":1},{"text":"nami ninafuata amri zako,","poem":2}]},{"type":"verse","number":167,"content":[{"text":"Ninazitii sheria zako,","poem":1},{"text":"kwa sababu ninazipenda mno.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"Nimetii mausia yako na sheria zako,","poem":1},{"text":"kwa kuwa njia zangu zote zinajulikana kwako.","poem":2}]},{"type":"heading","content":["Kuomba Msaada"]},{"type":"verse","number":169,"content":[{"text":"Ee Bwana, kilio changu na kifike mbele zako,","poem":1},{"text":"nipe ufahamu sawasawa na neno lako.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"Maombi yangu na yafike mbele zako,","poem":1},{"text":"niokoe sawasawa na ahadi yako.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"Midomo yangu na ibubujike sifa,","poem":1},{"text":"kwa kuwa unanifundisha maagizo yako.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"Ulimi wangu na uimbe kuhusu neno lako,","poem":1},{"text":"kwa kuwa amri zako zote ni za haki.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"Mkono wako uwe tayari kunisaidia,","poem":1},{"text":"kwa kuwa nimechagua mausia yako.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"Ee Bwana, ninatamani wokovu wako,","poem":1},{"text":"na sheria yako ni furaha yangu.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"Nijalie kuishi ili nipate kukusifu,","poem":1},{"text":"na sheria zako zinitegemeze.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"Nimetangatanga kama kondoo aliyepotea.","poem":1},{"text":"Mtafute mtumishi wako,","poem":2},{"lineBreak":true},{"text":"kwa kuwa sijasahau amri zako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}