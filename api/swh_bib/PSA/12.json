{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["Kuomba Msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa sheminithi. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Bwana tusaidie, kwa kuwa wacha Mungu wametoweka;","poem":1},{"text":"waaminifu wametoweka miongoni mwa wanadamu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kila mmoja humwambia jirani yake uongo;","poem":1},{"text":"midomo yao ya hila huzungumza kwa udanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bwana na akatilie mbali midomo yote ya hila","poem":1},{"text":"na kila ulimi uliojaa majivuno,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ule unaosema, “Kwa ndimi zetu tutashinda;","poem":1},{"text":"midomo ni mali yetu, bwana wetu ni nani?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Kwa sababu ya uonevu wa wanyonge","poem":1},{"text":"na kulia kwa uchungu kwa wahitaji,","poem":2},{"text":"nitainuka sasa,” asema Bwana.","poem":1},{"text":"“Nitawalinda kutokana na wale","poem":2},{"lineBreak":true},{"text":"wenye nia mbaya juu yao.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maneno ya Bwana ni safi,","poem":1},{"text":"kama fedha iliyosafishwa katika tanuru,","poem":2},{"lineBreak":true},{"text":"iliyosafishwa mara saba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Bwana, utatuweka salama","poem":1},{"text":"na kutulinda na kizazi hiki milele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Watu waovu huenda wakiringa kila mahali","poem":1},{"text":"wakati ambapo yule aliye mbaya sana","poem":2},{"lineBreak":true},{"text":"ndiye anayeheshimiwa miongoni mwa watu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}