{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Sifa Kwa Yerusalemu"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu. Wa Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nilishangilia pamoja na wale walioniambia,","poem":1},{"text":"“Twende nyumbani ya Bwana.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Yerusalemu, miguu yetu imesimama","poem":1},{"text":"malangoni mwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yerusalemu imejengwa vyema kama mji","poem":1},{"text":"ambao umeshikamanishwa pamoja.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Huko ndiko makabila hukwea,","poem":1},{"text":"makabila ya Bwana,","poem":2},{"text":"kulisifu jina la Bwana kulingana na maagizo","poem":1},{"text":"waliopewa Israeli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Huko viti vya enzi vya hukumu hukaa,","poem":1},{"text":"viti vya enzi vya nyumba ya Daudi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Omba kwa ajili ya amani ya Yerusalemu:","poem":1},{"text":"“Wote wakupendao na wawe salama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amani na iwepo ndani ya kuta zako","poem":1},{"text":"na usalama ndani ya ngome zako.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa ajili ya ndugu zangu na marafiki,","poem":1},{"text":"nitasema, “Amani iwe ndani yako.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa ajili ya nyumba ya Bwana Mungu wetu,","poem":1},{"text":"nitatafuta mafanikio yako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}