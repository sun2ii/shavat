{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["Usalama Wa Watu Wa Mungu"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu."]},{"type":"verse","number":1,"content":[{"text":"Wale wamtumainio Bwana ni kama mlima Sayuni,","poem":1},{"text":"ambao hauwezi kutikisika, bali wadumu milele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama milima inavyozunguka Yerusalemu,","poem":1},{"text":"ndivyo Bwana anavyowazunguka watu wake","poem":2},{"lineBreak":true},{"text":"sasa na hata milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Fimbo ya waovu haitadumu juu ya nchi","poem":1},{"text":"waliopewa wenye haki,","poem":2},{"text":"ili wenye haki wasije wakatumia","poem":1},{"text":"mikono yao kutenda ubaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Bwana, watendee mema walio wema,","poem":1},{"text":"wale walio wanyofu wa moyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bali wale wanaogeukia njia zilizopotoka,","poem":1},{"text":"Bwana atawafukuza pamoja na watenda mabaya.","poem":2},{"lineBreak":true},{"text":"Amani iwe juu ya Israeli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}