{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["Sala Ya Kuomba Msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mpaka lini, Ee Bwana? Je, utanisahau milele?","poem":1},{"text":"Utanificha uso wako mpaka lini?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitapambana na mawazo yangu mpaka lini,","poem":1},{"text":"na kila siku kuwa na majonzi moyoni mwangu?","poem":2},{"lineBreak":true},{"text":"Adui zangu watanishinda mpaka lini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nitazame, unijibu, Ee Bwana Mungu wangu.","poem":1},{"text":"Yatie nuru macho yangu,","poem":2},{"lineBreak":true},{"text":"ama sivyo nitalala usingizi wa mauti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adui yangu atasema, “Nimemshinda,”","poem":1},{"text":"nao adui zangu watashangilia nitakapoanguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lakini ninategemea upendo wako usiokoma;","poem":1},{"text":"moyo wangu unashangilia katika wokovu wako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nitamwimbia Bwana,","poem":1},{"text":"kwa kuwa amekuwa mwema kwangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}