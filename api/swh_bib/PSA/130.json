{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Kuomba Msaada"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu."]},{"type":"verse","number":1,"content":[{"text":"Kutoka vilindini ninakulilia, Ee Bwana.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ee Bwana, sikia sauti yangu.","poem":2},{"text":"Masikio yako na yawe masikivu","poem":1},{"text":"kwa kilio changu unihurumie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kama wewe, Ee Bwana, ungeweka kumbukumbu ya dhambi,","poem":1},{"text":"Ee Bwana, ni nani angeliweza kusimama?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini kwako kuna msamaha,","poem":1},{"text":"kwa hiyo wewe unaogopwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Namngojea Bwana, nafsi yangu inangojea,","poem":1},{"text":"katika neno lake naweka tumaini langu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nafsi yangu inamngojea Bwana","poem":1},{"text":"kuliko walinzi waingojeavyo asubuhi,","poem":2},{"text":"naam, kuliko walinzi","poem":1},{"text":"waingojeavyo asubuhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Israeli, mtumaini Bwana,","poem":1},{"text":"maana kwa Bwana kuna upendo usiokoma,","poem":2},{"lineBreak":true},{"text":"na kwake kuna ukombozi kamili.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeye mwenyewe ataikomboa Israeli","poem":1},{"text":"kutoka dhambi zao zote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}