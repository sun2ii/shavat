{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["Maskani Ya Mungu Ya Milele Katika Sayuni"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, mkumbuke Daudi","poem":1},{"text":"na taabu zote alizozistahimili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aliapa kiapo kwa Bwana","poem":1},{"text":"na akaweka nadhiri kwa Yule Mwenye Nguvu wa Yakobo:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Sitaingia nyumbani mwangu","poem":1},{"text":"au kwenda kitandani mwangu:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"sitaruhusu usingizi katika macho yangu,","poem":1},{"text":"wala kope zangu kusinzia,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mpaka nitakapompatia Bwana mahali,","poem":1},{"text":"makao kwa ajili ya Yule Mwenye Nguvu wa Yakobo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tulisikia habari hii huko Efrathi,","poem":1},{"text":"tulikutana nayo katika mashamba ya Yaara:","poem":2},{"noteId":44}]},{"type":"verse","number":7,"content":[{"text":"“Twendeni kwenye makao yake,","poem":1},{"text":"na tuabudu kwenye kiti cha kuwekea miguu yake;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"inuka, Ee Bwana, uje mahali pako pa kupumzikia,","poem":1},{"text":"wewe na Sanduku la nguvu zako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makuhani wako na wavikwe haki,","poem":1},{"text":"watakatifu wako na waimbe kwa furaha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kwa ajili ya Daudi mtumishi wako,","poem":1},{"text":"usimkatae mpakwa mafuta wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bwana alimwapia Daudi kiapo,","poem":1},{"text":"kiapo cha uhakika ambacho hatakitangua:","poem":2},{"text":"“Nitamweka mmoja wa wazao wako mwenyewe","poem":1},{"text":"katika kiti chako cha enzi,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kama wanao watashika Agano langu","poem":1},{"text":"na sheria ninazowafundisha,","poem":2},{"text":"ndipo wana wao watarithi","poem":1},{"text":"kiti chako cha enzi milele na milele.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kwa maana Bwana ameichagua Sayuni,","poem":1},{"text":"amepaonea shauku pawe maskani yake:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Hapa ni mahali pangu pa kupumzika milele na milele;","poem":1},{"text":"hapa ndipo nitakapoketi nikitawala, kwa sababu nimepaonea shauku:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitambariki kwa kumpa mahitaji tele:","poem":1},{"text":"nitashibisha maskini wake kwa chakula.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nitawavika makuhani wake wokovu,","poem":1},{"text":"nao watakatifu wake watadumu wakiimba kwa furaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Hapa nitamchipushia Daudi pembe,","poem":1},{"noteId":45},{"text":"na kuweka taa kwa ajili ya masiya","poem":2},{"noteId":46},{"text":"wangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Adui zake nitawavika aibu,","poem":1},{"text":"bali taji kichwani pake itangʼaa sana.”","poem":2}]}],"footnotes":[{"noteId":44,"caller":"+","text":"Yaani Kiriath-Yearimu.","reference":{"chapter":132,"verse":6}},{"noteId":45,"caller":"+","text":"Pembe inawakilisha nguvu.","reference":{"chapter":132,"verse":17}},{"noteId":46,"caller":"+","text":"Masiya yaani mpakwa mafuta.","reference":{"chapter":132,"verse":17}}]},"thisChapterLink":"/api/swh_bib/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}