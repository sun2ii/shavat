{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"heading","content":["Wimbo Wa Sifa Kwa Mungu"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Bwana.","poem":1},{"lineBreak":true},{"text":"Lisifuni jina la Bwana,","poem":1},{"text":"msifuni, enyi watumishi wa Bwana,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ninyi ambao mnatumika ndani ya nyumba ya Bwana,","poem":1},{"text":"katika nyua za nyumba ya Mungu wetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Msifuni Bwana, kwa kuwa Bwana ni mwema,","poem":1},{"text":"liimbieni sifa jina lake, kwa maana hilo lapendeza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa maana Bwana amemchagua Yakobo kuwa wake mwenyewe,","poem":1},{"text":"Israeli kuwa mali yake ya thamani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ninajua ya kuwa Bwana ni mkuu,","poem":1},{"text":"kwamba Bwana wetu ni mkuu kuliko miungu yote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwana hufanya lolote apendalo,","poem":1},{"text":"mbinguni na duniani,","poem":2},{"lineBreak":true},{"text":"katika bahari na vilindi vyake vyote.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hufanya mawingu kupanda kutoka miisho ya dunia;","poem":1},{"text":"hupeleka umeme wa radi pamoja na mvua","poem":2},{"lineBreak":true},{"text":"na huleta upepo kutoka ghala zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Alimuua mzaliwa wa kwanza wa Misri,","poem":1},{"text":"mzaliwa wa kwanza wa wanadamu na wanyama.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alipeleka ishara zake na maajabu katikati yako, ee Misri,","poem":1},{"text":"dhidi ya Farao na watumishi wake wote.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aliyapiga mataifa mengi,","poem":1},{"text":"na akaua wafalme wenye nguvu:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mfalme Sihoni na Waamori,","poem":1},{"text":"Ogu mfalme wa Bashani","poem":2},{"lineBreak":true},{"text":"na wafalme wote wa Kanaani:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"akatoa nchi yao kuwa urithi,","poem":1},{"text":"urithi kwa watu wake Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Bwana, jina lako ladumu milele,","poem":1},{"text":"kumbukumbu za fahari zako, Ee Bwana, kwa vizazi vyote.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maana Bwana atawathibitisha watu wake,","poem":1},{"text":"na kuwahurumia watumishi wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sanamu za mataifa ni fedha na dhahabu,","poem":1},{"text":"zilizotengenezwa kwa mikono ya wanadamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Zina vinywa, lakini haziwezi kusema,","poem":1},{"text":"zina macho, lakini haziwezi kuona;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"zina masikio, lakini haziwezi kusikia,","poem":1},{"text":"wala hakuna pumzi katika vinywa vyao.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wale wanaozitengeneza watafanana nazo,","poem":1},{"text":"vivyo hivyo wale wote wanaozitumainia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee nyumba ya Israeli, msifuni Bwana;","poem":1},{"text":"ee nyumba ya Aroni, msifuni Bwana;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ee nyumba ya Lawi, msifuni Bwana;","poem":1},{"text":"ninyi mnaomcha, msifuni Bwana.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Msifuni Bwana kutoka Sayuni,","poem":1},{"text":"msifuni yeye aishiye Yerusalemu.","poem":2},{"lineBreak":true},{"text":"Msifuni Bwana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}