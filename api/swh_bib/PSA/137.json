{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Maombolezo Ya Israeli Uhamishoni"]},{"type":"verse","number":1,"content":[{"text":"Kando ya mito ya Babeli tuliketi, tukaomboleza","poem":1},{"text":"tulipokumbuka Sayuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwenye miti ya huko","poem":1},{"text":"tulitundika vinubi vyetu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwa maana huko hao waliotuteka","poem":1},{"text":"walitaka tuwaimbie nyimbo,","poem":2},{"text":"watesi wetu walidai nyimbo za furaha;","poem":1},{"text":"walisema, “Tuimbieni wimbo mmoja kati ya nyimbo za Sayuni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tutaimbaje nyimbo za Bwana,","poem":1},{"text":"tukiwa nchi ya kigeni?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nikikusahau wewe, ee Yerusalemu,","poem":1},{"text":"basi mkono wangu wa kuume na usahau ujuzi wake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ulimi wangu ushikamane na kaakaa la kinywa changu","poem":1},{"text":"kama sitakukumbuka wewe,","poem":2},{"text":"kama nisipokufikiri Yerusalemu","poem":1},{"text":"kuwa furaha yangu kubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumbuka, Ee Bwana, walichokifanya Waedomu,","poem":1},{"text":"siku ile Yerusalemu ilipoanguka.","poem":2},{"text":"Walisema, “Bomoa, Bomoa","poem":1},{"text":"mpaka kwenye misingi yake!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee binti Babeli, uliyehukumiwa kuangamizwa,","poem":1},{"text":"heri yeye atakayekulipiza wewe","poem":2},{"lineBreak":true},{"text":"kwa yale uliyotutenda sisi:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yeye ambaye atawakamata watoto wako wachanga","poem":1},{"text":"na kuwaponda juu ya miamba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}