{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["Maombi Ya Shukrani"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nitakusifu wewe, Ee Bwana, kwa moyo wangu wote,","poem":1},{"text":"mbele ya “miungu” nitaimba sifa zako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitasujudu nikielekea Hekalu lako takatifu,","poem":1},{"text":"nami nitalisifu jina lako","poem":2},{"text":"kwa ajili ya upendo wako","poem":1},{"text":"na uaminifu,","poem":2},{"text":"kwa kuwa umelikuza jina lako na neno lako","poem":1},{"text":"juu ya vitu vyote.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nilipoita, ulinijibu;","poem":1},{"text":"ulinifanya jasiri na mwenye moyo hodari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wafalme wote wa dunia wakusifu wewe Ee Bwana,","poem":1},{"text":"wakati wanaposikia maneno ya kinywa chako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wao na waimbe kuhusu njia za Bwana,","poem":1},{"text":"kwa maana utukufu wa Bwana ni mkuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ingawa Bwana yuko juu,","poem":1},{"text":"humwangalia mnyonge,","poem":2},{"text":"bali mwenye kiburi","poem":1},{"text":"yeye anamjua kutokea mbali.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nijapopita katikati ya shida,","poem":1},{"text":"wewe unayahifadhi maisha yangu,","poem":2},{"text":"unanyoosha mkono wako dhidi ya hasira ya adui zangu,","poem":1},{"text":"kwa mkono wako wa kuume unaniokoa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bwana atatimiza kusudi lake kwangu,","poem":1},{"text":"Ee Bwana, upendo wako wadumu milele:","poem":2},{"lineBreak":true},{"text":"usiziache kazi za mikono yako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}