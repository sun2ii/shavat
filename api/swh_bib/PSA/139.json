{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"heading","content":["Mungu Asiyeweza Kukwepwa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, umenichunguza","poem":1},{"text":"na kunijua.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unajua ninapoketi na ninapoinuka;","poem":1},{"text":"unatambua mawazo yangu tokea mbali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unafahamu kutoka kwangu na kulala kwangu;","poem":1},{"text":"unaelewa njia zangu zote.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kabla neno halijafika katika ulimi wangu,","poem":1},{"text":"wewe walijua kikamilifu, Ee Bwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Umenizunguka nyuma na mbele;","poem":1},{"text":"umeweka mkono wako juu yangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maarifa haya ni ya ajabu mno kwangu,","poem":1},{"text":"ni ya juu sana kwangu kuyafikia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Niende wapi nijiepushe na Roho yako?","poem":1},{"text":"Niende wapi niukimbie uso wako?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kama nikienda juu mbinguni, wewe uko huko;","poem":1},{"text":"nikifanya vilindi","poem":2},{"noteId":47},{"text":"kuwa kitanda changu,","poem":2},{"lineBreak":true},{"text":"wewe uko huko.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kama nikipanda juu ya mbawa za mapambazuko,","poem":1},{"text":"kama nikikaa pande za mbali za bahari,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"hata huko mkono wako utaniongoza,","poem":1},{"text":"mkono wako wa kuume utanishika kwa uthabiti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kama nikisema, “Hakika giza litanificha","poem":1},{"text":"na nuru inayonizunguka iwe usiku,”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"hata giza halitakuwa giza kwako,","poem":1},{"text":"usiku utangʼaa kama mchana,","poem":2},{"lineBreak":true},{"text":"kwa kuwa giza ni kama nuru kwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kwa maana wewe ndiwe uliyeumba utu wangu wa ndani;","poem":1},{"text":"uliniunga pamoja tumboni mwa mama yangu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ninakusifu kwa sababu nimeumbwa","poem":1},{"text":"kwa namna ya ajabu na ya kutisha;","poem":2},{"text":"kazi zako ni za ajabu,","poem":1},{"text":"ninajua hayo kikamilifu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Umbile langu halikufichika kwako,","poem":1},{"text":"nilipoumbwa mahali pa siri.","poem":2},{"text":"Nilipoungwa pamoja kwa ustadi katika vilindi vya nchi,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"macho yako yaliniona kabla mwili wangu haujakamilika.","poem":2},{"text":"Siku zangu zote ulizonipangia","poem":1},{"text":"ziliandikwa katika kitabu chako","poem":2},{"lineBreak":true},{"text":"kabla haijakuwepo hata moja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tazama jinsi yalivyo ya thamani mawazo yako kwangu, Ee Mungu!","poem":1},{"text":"Jinsi jumla yake ilivyo kubwa!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kama ningezihesabu,","poem":1},{"text":"zingekuwa nyingi kuliko mchanga.","poem":2},{"text":"Niamkapo,","poem":1},{"text":"bado niko pamoja nawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Laiti ungewachinja waovu, Ee Mungu!","poem":1},{"text":"Ondokeni kwangu, ninyi wamwaga damu!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wanazungumza juu yako wakiwa na kusudi baya,","poem":1},{"text":"adui zako wanatumia vibaya jina lako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ee Bwana, je, nisiwachukie wanaokuchukia?","poem":1},{"text":"Nisiwachukie sana wanaoinuka dhidi yako?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sina kitu zaidi ya chuki dhidi yao,","poem":1},{"text":"ninawahesabu ni adui zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ee Mungu, nichunguze, uujue moyo wangu,","poem":1},{"text":"nijaribu na ujue mawazo yangu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uone kama kuna njia iletayo machukizo ndani yangu,","poem":1},{"text":"uniongoze katika njia ya milele.","poem":2}]}],"footnotes":[{"noteId":47,"caller":"+","text":"Vilindi ina maana ya Kuzimu, ambayo ni Sheol kwa Kiebrania.","reference":{"chapter":139,"verse":8}}]},"thisChapterLink":"/api/swh_bib/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}