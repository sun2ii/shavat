{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["Uovu Wa Wanadamu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mpumbavu anasema moyoni mwake,","poem":1},{"text":"“Hakuna Mungu.”","poem":2},{"text":"Wameharibika, matendo yao ni maovu kabisa;","poem":1},{"text":"hakuna hata mmoja atendaye mema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bwana anawachungulia wanadamu chini","poem":1},{"text":"kutoka mbinguni","poem":2},{"text":"aone kama wako wenye akili,","poem":1},{"text":"wowote wanaomtafuta Mungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wote wamepotoka,","poem":1},{"text":"wameharibika wote pamoja,","poem":2},{"text":"hakuna atendaye mema.","poem":1},{"text":"Naam, hakuna hata mmoja!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Je, watendao mabaya kamwe hawatajifunza:","poem":1},{"text":"wale ambao huwala watu wangu","poem":2},{"text":"kama watu walavyo mkate,","poem":1},{"text":"hao ambao hawamwiti Bwana?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wako hapo, wameingiwa na hofu kuu,","poem":1},{"text":"maana Mungu yupo pamoja na wenye haki.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ninyi watenda mabaya mnakwamisha mipango ya maskini,","poem":1},{"text":"bali Bwana ndiye kimbilio lao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Laiti wokovu wa Israeli","poem":1},{"text":"ungalikuja kutoka Sayuni!","poem":2},{"text":"Wakati Bwana arejeshapo","poem":1},{"text":"wafungwa wa watu wake,","poem":2},{"text":"Yakobo na ashangilie,","poem":1},{"text":"Israeli na afurahi!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}