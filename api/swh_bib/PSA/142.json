{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["Maombi Ya Kuokolewa Dhidi Ya Watesi"]},{"type":"hebrew_subtitle","content":["Utenzi wa Daudi. Alipokuwa pangoni. Maombi."]},{"type":"verse","number":1,"content":[{"text":"Namlilia Bwana kwa sauti,","poem":1},{"text":"nainua sauti yangu kwa Bwana anihurumie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namimina malalamiko yangu mbele zake,","poem":1},{"text":"mbele zake naeleza shida zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wakati roho yangu inapozimia ndani yangu,","poem":1},{"text":"wewe ndiwe unajua njia zangu.","poem":2},{"text":"Katika njia ninayopita","poem":1},{"text":"watu wameniwekea mtego.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tazama kuume kwangu na uone,","poem":1},{"text":"hakuna hata mmoja anayejihusisha nami.","poem":2},{"text":"Sina kimbilio,","poem":1},{"text":"hakuna anayejali maisha yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Bwana, nakulilia wewe,","poem":1},{"text":"nasema, “Wewe ni kimbilio langu,","poem":2},{"lineBreak":true},{"text":"fungu langu katika nchi ya walio hai.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sikiliza kilio changu,","poem":1},{"text":"kwa sababu mimi ni mhitaji sana;","poem":2},{"text":"niokoe na wale wanaonifuatilia,","poem":1},{"text":"kwa kuwa wamenizidi nguvu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nifungue kutoka kifungo changu,","poem":1},{"text":"ili niweze kulisifu jina lako.","poem":2},{"lineBreak":true},{"text":"Ndipo wenye haki watanizunguka,","poem":1},{"text":"kwa sababu ya wema wako kwangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}