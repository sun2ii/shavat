{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"heading","content":["Mfalme Amshukuru Mungu Kwa Ushindi"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Sifa ni kwa Bwana Mwamba wangu,","poem":1},{"text":"aifundishaye mikono yangu vita,","poem":2},{"lineBreak":true},{"text":"na vidole vyangu kupigana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yeye ni Mungu wangu wa upendo na boma langu,","poem":1},{"text":"ngome yangu na mwokozi wangu,","poem":2},{"text":"ngao yangu ninayemkimbilia,","poem":1},{"text":"ambaye huwatiisha mataifa chini yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Bwana, mwanadamu ni nini hata umjali,","poem":1},{"text":"Binadamu ni nini hata umfikirie?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwanadamu ni kama pumzi,","poem":1},{"text":"siku zake ni kama kivuli kinachopita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Bwana, pasua mbingu zako, ushuke,","poem":1},{"text":"gusa milima ili itoe moshi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peleka umeme uwatawanye adui,","poem":1},{"text":"lenga mishale yako uwashinde.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyoosha mkono wako kutoka juu,","poem":1},{"text":"nikomboe na kuniokoa","poem":2},{"text":"kutoka maji makuu,","poem":1},{"text":"kutoka mikononi mwa wageni","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ambao vinywa vyao vimejaa uongo,","poem":1},{"text":"na mikono yao ya kuume ni midanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mungu, nitakuimbia wimbo mpya,","poem":1},{"text":"kwa zeze yenye nyuzi kumi nitakuimbia,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kwa Yule awapaye wafalme ushindi,","poem":1},{"text":"ambaye humwokoa Daudi, mtumishi wake kutokana na upanga hatari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nikomboe na uniokoe","poem":1},{"text":"kutoka mikononi mwa wageni","poem":2},{"text":"ambao vinywa vyao vimejaa uongo,","poem":1},{"text":"na mikono yao ya kuume ni midanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kisha wana wetu wakati wa ujana wao","poem":1},{"text":"watakuwa kama mimea iliyotunzwa vizuri,","poem":2},{"text":"binti zetu watakuwa kama nguzo zilizoviringwa","poem":1},{"text":"kurembesha jumba la kifalme.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ghala zetu zitajazwa","poem":1},{"text":"aina zote za mahitaji.","poem":2},{"text":"Kondoo zetu watazaa kwa maelfu,","poem":1},{"text":"kwa makumi ya maelfu katika mashamba yetu;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"maksai wetu watakokota","poem":1},{"text":"mizigo mizito.","poem":2},{"text":"Hakutakuwa na kubomoka kuta,","poem":1},{"text":"hakuna kuchukuliwa mateka,","poem":2},{"text":"wala kilio cha taabu","poem":1},{"text":"katika barabara zetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Heri watu ambao hili ni kweli;","poem":1},{"text":"heri wale ambao Bwana ni Mungu wao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}