{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"heading","content":["Kumsifu Mungu Mwokozi"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Bwana!","poem":1},{"noteId":48},{"lineBreak":true},{"text":"Ee nafsi yangu, umsifu Bwana,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Nitamsifu Bwana maisha yangu yote;","poem":2},{"text":"nitamwimbia Mungu wangu sifa","poem":1},{"text":"wakati wote niishipo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usiweke tumaini lako kwa wakuu,","poem":1},{"text":"kwa wanadamu ambao hufa,","poem":2},{"lineBreak":true},{"text":"ambao hawawezi kuokoa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Roho yao itokapo hurudi mavumbini,","poem":1},{"text":"siku hiyo hiyo mipango yao yote hukoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Heri yeye ambaye Mungu wa Yakobo ni msaada wake,","poem":1},{"text":"ambaye tumaini lake ni katika Bwana, Mungu wake,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muumba wa mbingu na nchi,","poem":1},{"text":"na bahari na vyote vilivyomo ndani yake:","poem":2},{"text":"Bwana anayedumu kuwa mwaminifu","poem":1},{"text":"milele na milele.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naye huwapatia haki walioonewa","poem":1},{"text":"na kuwapa wenye njaa chakula.","poem":2},{"text":"Bwana huwaweka wafungwa huru,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Bwana huwafumbua vipofu macho,","poem":2},{"text":"Bwana huwainua waliolemewa na mizigo yao,","poem":1},{"text":"Bwana huwapenda wenye haki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bwana huwalinda wageni","poem":1},{"text":"na kuwategemeza yatima na wajane,","poem":2},{"lineBreak":true},{"text":"lakini hupinga njia za waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bwana atamiliki milele,","poem":1},{"text":"Mungu wako, ee Sayuni,","poem":2},{"lineBreak":true},{"text":"kwa vizazi vyote.","poem":2},{"lineBreak":true},{"text":"Msifuni Bwana.","poem":1}]}],"footnotes":[{"noteId":48,"caller":"+","text":"Msifuni Bwana kwa Kiebrania ni Hallelu Yah.","reference":{"chapter":146,"verse":1}}]},"thisChapterLink":"/api/swh_bib/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}