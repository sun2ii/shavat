{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"heading","content":["Kumsifu Mungu Mwenye Nguvu Zote"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Bwana.","poem":1},{"lineBreak":true},{"text":"Tazama jinsi ilivyo vyema kumwimbia Mungu wetu sifa,","poem":1},{"text":"jinsi inavyopendeza na kustahili kumsifu yeye!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bwana hujenga Yerusalemu,","poem":1},{"text":"huwakusanya Israeli walio uhamishoni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anawaponya waliovunjika mioyo","poem":1},{"text":"na kuvifunga vidonda vyao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Huzihesabu nyota","poem":1},{"text":"na huipa kila moja jina lake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwana wetu ni mkuu na mwenye uwezo mwingi,","poem":1},{"text":"ufahamu wake hauna kikomo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwana huwahifadhi wanyenyekevu","poem":1},{"text":"lakini huwashusha waovu mpaka mavumbini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwimbieni Bwana kwa shukrani,","poem":1},{"text":"mpigieni Mungu wetu kinubi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeye huzifunika anga kwa mawingu,","poem":1},{"text":"huinyeshea ardhi mvua,","poem":2},{"lineBreak":true},{"text":"na kuzifanya nyasi kuota juu ya vilima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huwapa chakula mifugo","poem":1},{"text":"na pia makinda ya kunguru yanapolia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Furaha yake haipo katika nguvu za farasi,","poem":1},{"text":"wala furaha yake kwenye miguu ya mwanadamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwana hupendezwa na wale wamchao,","poem":1},{"text":"wale wanaoweka tumaini lao katika upendo wake usiokoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mtukuze Bwana, ee Yerusalemu,","poem":1},{"text":"msifu Mungu wako, ee Sayuni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kwa maana huimarisha makomeo ya malango yako","poem":1},{"text":"na huwabariki watu wako walio ndani yako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Huwapa amani mipakani mwenu","poem":1},{"text":"na kukushibisha kwa ngano safi kabisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hutuma amri yake duniani,","poem":1},{"text":"neno lake hukimbia kasi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anatandaza theluji kama sufu","poem":1},{"text":"na kutawanya umande kama majivu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Huvurumisha mvua yake ya mawe kama changarawe.","poem":1},{"text":"Ni nani awezaye kustahimili ukali wa baridi yake?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hutuma neno lake na kuviyeyusha,","poem":1},{"text":"huvumisha upepo wake, nayo maji hutiririka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Amemfunulia Yakobo neno lake,","poem":1},{"text":"sheria zake na maagizo yake kwa Israeli.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hajafanya hivyo kwa taifa lingine lolote,","poem":1},{"text":"hawazijui sheria zake.","poem":2},{"lineBreak":true},{"text":"Msifuni Bwana.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}