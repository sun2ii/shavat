{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"heading","content":["Wimbo Wa Kumsifu Mungu Kwa Wema Wake"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Bwana.","poem":1},{"lineBreak":true},{"text":"Mwimbieni Bwana wimbo mpya,","poem":1},{"text":"sifa zake katika kusanyiko la watakatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Israeli na washangilie katika Muumba wao,","poem":1},{"text":"watu wa Sayuni na wafurahi katika Mfalme wao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na walisifu jina lake kwa kucheza","poem":1},{"text":"na wampigie muziki kwa matari na kinubi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa maana Bwana anapendezwa na watu wake,","poem":1},{"text":"anawavika wanyenyekevu taji ya wokovu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Watakatifu washangilie katika heshima hii,","poem":1},{"text":"na waimbe kwa shangwe vitandani mwao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sifa za Mungu na ziwe vinywani mwao","poem":1},{"text":"na upanga ukatao kuwili mikononi mwao,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ili walipize mataifa kisasi","poem":1},{"text":"na adhabu juu ya mataifa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"wawafunge wafalme wao kwa minyororo,","poem":1},{"text":"wakuu wao kwa pingu za chuma,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ili kuwafanyia hukumu iliyoandikwa dhidi yao.","poem":1},{"text":"Huu ndio utukufu wa watakatifu wake wote.","poem":2},{"lineBreak":true},{"text":"Msifuni Bwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}