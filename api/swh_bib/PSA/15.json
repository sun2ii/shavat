{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Kitu Mungu Anachotaka"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Bwana, ni nani awezaye kukaa","poem":1},{"text":"katika Hekalu lako?","poem":2},{"text":"Nani awezaye kuishi","poem":1},{"text":"katika mlima wako mtakatifu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ni yule aendaye pasipo mawaa,","poem":1},{"text":"atendaye yaliyo haki,","poem":2},{"text":"asemaye kweli toka moyoni mwake,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"na hana masingizio ulimini mwake,","poem":2},{"text":"asiyemtenda jirani yake vibaya,","poem":1},{"text":"na asiyemsingizia mwenzake,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ambaye humdharau mtu mbaya,","poem":1},{"text":"lakini huwaheshimu wale wamwogopao Bwana,","poem":2},{"text":"yule atunzaye kiapo chake","poem":1},{"text":"hata kama anaumia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeye akopeshaye fedha yake bila riba,","poem":1},{"text":"na hapokei rushwa dhidi ya mtu asiye na hatia.","poem":2},{"lineBreak":true},{"text":"Mtu afanyaye haya","poem":1},{"text":"kamwe hatatikisika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}