{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["Sala Ya Matumaini"]},{"type":"hebrew_subtitle","content":["Utenzi wa Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, uniweke salama,","poem":1},{"text":"kwa maana kwako nimekimbilia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nilimwambia Bwana, “Wewe ndiwe Bwana wangu;","poem":1},{"text":"pasipo wewe sina jambo jema.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa habari ya watakatifu walioko duniani,","poem":1},{"text":"ndio walio wa fahari ambao ninapendezwa nao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Huzuni itaongezeka kwa wale","poem":1},{"text":"wanaokimbilia miungu mingine.","poem":2},{"text":"Sitazimimina sadaka zao za damu","poem":1},{"text":"au kutaja majina yao midomoni mwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwana umeniwekea fungu langu na kikombe changu;","poem":1},{"text":"umeyafanya mambo yangu yote yawe salama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alama za mipaka zimeniangukia mahali pazuri,","poem":1},{"text":"hakika nimepata urithi mzuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nitamsifu Bwana ambaye hunishauri,","poem":1},{"text":"hata wakati wa usiku moyo wangu hunifundisha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nimemweka Bwana mbele yangu daima.","poem":1},{"text":"Kwa sababu yuko mkono wangu wa kuume,","poem":2},{"lineBreak":true},{"text":"sitatikisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kwa hiyo moyo wangu unafurahia, na ulimi wangu unashangilia;","poem":1},{"text":"mwili wangu nao utapumzika salama,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kwa maana hutaniacha kaburini,","poem":1},{"text":"wala hutamwacha Mtakatifu Wako kuona uharibifu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Umenijulisha njia ya uzima;","poem":1},{"text":"utanijaza na furaha mbele zako,","poem":2},{"text":"pamoja na furaha za milele","poem":1},{"text":"katika mkono wako wa kuume.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}