{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"heading","content":["Utukufu Wa Mungu Katika Uumbaji"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mbingu zinatangaza utukufu wa Mungu,","poem":1},{"text":"anga zahubiri kazi ya mikono yake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Siku baada ya siku zinatoa habari,","poem":1},{"text":"usiku baada ya usiku zinatangaza maarifa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hakuna msemo wala lugha,","poem":1},{"text":"ambapo sauti zao hazisikiki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sauti yao imeenea duniani pote,","poem":1},{"text":"nayo maneno yao yameenea","poem":2},{"lineBreak":true},{"text":"hadi miisho ya ulimwengu.","poem":2},{"lineBreak":true},{"text":"Katika mbingu amepiga hema kwa ajili ya jua,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"linafanana na bwana arusi","poem":2},{"lineBreak":true},{"text":"akitoka chumbani mwake,","poem":2},{"text":"kama shujaa afurahiavyo","poem":1},{"text":"kukamilisha kushindana kwake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Huchomoza upande mmoja wa mbingu,","poem":1},{"text":"na kufanya mzunguko wake","poem":2},{"lineBreak":true},{"text":"hadi upande mwingine.","poem":2},{"lineBreak":true},{"text":"Hakuna kilichojificha joto lake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Sheria ya Bwana ni kamilifu,","poem":1},{"text":"ikihuisha nafsi.","poem":2},{"text":"Shuhuda za Bwana ni za kuaminika,","poem":1},{"text":"zikimpa mjinga hekima.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maagizo ya Bwana ni kamili,","poem":1},{"text":"nayo hufurahisha moyo.","poem":2},{"text":"Amri za Bwana huangaza,","poem":1},{"text":"zatia nuru machoni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kumcha Bwana ni utakatifu,","poem":1},{"text":"nako kwadumu milele.","poem":2},{"text":"Amri za Bwana ni za hakika,","poem":1},{"text":"nazo zina haki.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ni za thamani kuliko dhahabu,","poem":1},{"text":"kuliko dhahabu iliyo safi sana,","poem":2},{"text":"ni tamu kuliko asali,","poem":1},{"text":"kuliko asali kutoka kwenye sega.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa hizo mtumishi wako anaonywa,","poem":1},{"text":"katika kuzishika kuna thawabu kubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ni nani awezaye kutambua makosa yake?","poem":1},{"text":"Nisamehe makosa yangu nisiyoyajua.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mlinde mtumishi wako na dhambi za makusudi,","poem":1},{"text":"nazo zisinitawale.","poem":2},{"text":"Ndipo nitakapokuwa sina lawama,","poem":1},{"text":"wala sitakuwa na hatia ya kosa kubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Maneno ya kinywa changu","poem":1},{"text":"na mawazo ya moyo wangu,","poem":2},{"text":"yapate kibali mbele zako, Ee Bwana,","poem":1},{"text":"Mwamba wangu na Mkombozi wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}