{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"heading","content":["Mfalme Aliyechaguliwa Na Mungu"]},{"type":"verse","number":1,"content":[{"text":"Kwa nini mataifa wanashauriana kufanya mabaya,","poem":1},{"text":"na kabila za watu kula njama bure?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wafalme wa dunia wanajipanga","poem":1},{"text":"na watawala wanajikusanya pamoja","poem":2},{"text":"dhidi ya Bwana","poem":1},{"text":"na dhidi ya Mpakwa Mafuta wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wanasema, “Tuvunje minyororo yao","poem":1},{"text":"na kuvitupilia mbali vifungo vyao.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yeye atawalaye mbinguni hucheka,","poem":1},{"text":"Bwana huwadharau.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kisha huwakemea katika hasira yake","poem":1},{"text":"na kuwaogopesha katika ghadhabu yake, akisema,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Nimemtawaza Mfalme wangu","poem":1},{"text":"juu ya Sayuni, mlima wangu mtakatifu.”","poem":2}]},{"type":"heading","content":["Ushindi Wa Mfalme"]},{"type":"verse","number":7,"content":[{"text":"Nitatangaza amri ya Bwana:","poem":1},{"text":"Yeye aliniambia, “Wewe ni Mwanangu,","poem":2},{"lineBreak":true},{"text":"leo mimi nimekuzaa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niombe, nami nitayafanya mataifa","poem":1},{"text":"kuwa urithi wako,","poem":2},{"lineBreak":true},{"text":"miisho ya dunia kuwa milki yako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Utawatawala kwa fimbo ya chuma","poem":1},{"text":"na kuwavunjavunja kama chombo cha mfinyanzi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kwa hiyo, ninyi wafalme, kuweni na hekima;","poem":1},{"text":"mwonyeke, enyi watawala wa dunia.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mtumikieni Bwana kwa hofu","poem":1},{"text":"na mshangilie kwa kutetemeka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mbusu Mwana, asije akakasirika","poem":1},{"text":"nawe ukaangamizwa katika njia yako,","poem":2},{"text":"kwa maana hasira yake inaweza kuwaka ghafula.","poem":1},{"text":"Heri wote wanaomkimbilia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}