{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["Maombi Kwa Ajili Ya Ushindi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Bwana na akujibu unapokuwa katika dhiki,","poem":1},{"text":"jina la Mungu wa Yakobo na liwe kinga yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Na akutumie msaada kutoka patakatifu","poem":1},{"text":"na akupatie msaada kutoka Sayuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na azikumbuke dhabihu zako zote,","poem":1},{"text":"na azikubali sadaka zako za kuteketezwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na akujalie haja ya moyo wako,","poem":1},{"text":"na aifanikishe mipango yako yote.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tutashangilia kwa furaha utakaposhinda,","poem":1},{"text":"tutainua bendera zetu kwa jina la Mungu wetu.","poem":2},{"text":"Bwana na akupe haja zako zote.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sasa nafahamu kuwa Bwana","poem":1},{"text":"humwokoa mpakwa mafuta wake,","poem":2},{"text":"humjibu kutoka mbingu yake takatifu","poem":1},{"text":"kwa nguvu za wokovu wa mkono wake wa kuume.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wengine wanatumaini magari ya vita, na wengine farasi,","poem":1},{"text":"bali sisi tutalitumainia jina la Bwana, Mungu wetu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wao wameshushwa chini na kuanguka,","poem":1},{"text":"bali sisi tunainuka na kusimama imara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Bwana, mwokoe mfalme!","poem":1},{"text":"Tujibu tunapokuita!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}