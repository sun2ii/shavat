{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"heading","content":["Shukrani Kwa Mungu Kwa Ajili Ya Ushindi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, mfalme huzifurahia nguvu zako.","poem":1},{"text":"Tazama jinsi ilivyo kuu furaha yake","poem":2},{"lineBreak":true},{"text":"kwa ushindi unaompa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umempa haja ya moyo wake","poem":1},{"text":"na hukumzuilia maombi ya midomo yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ulimkaribisha kwa baraka tele","poem":1},{"text":"na kumvika taji ya dhahabu safi kichwani pake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alikuomba maisha, nawe ukampa,","poem":1},{"text":"wingi wa siku milele na milele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kutokana na ushindi uliompa, utukufu wake ni mkubwa,","poem":1},{"text":"umeweka juu yake fahari na utukufu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hakika umempa baraka za milele,","poem":1},{"text":"umemfanya awe na furaha","poem":2},{"lineBreak":true},{"text":"kwa shangwe ya uwepo wako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa kuwa mfalme anamtumaini Bwana;","poem":1},{"text":"kwa upendo usiokoma wa Aliye Juu Sana hatatikiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mkono wako utawashika adui zako wote,","poem":1},{"text":"mkono wako wa kuume utawakamata adui zako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wakati utakapojitokeza","poem":1},{"text":"utawafanya kama tanuru ya moto.","poem":2},{"text":"Katika ghadhabu yake Bwana atawameza,","poem":1},{"text":"moto wake utawateketeza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Utawaangamiza wazao wao kutoka duniani,","poem":1},{"text":"uzao wao kutoka wanadamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ingawa watapanga mabaya dhidi yako","poem":1},{"text":"na kutunga hila, hawawezi kufanikiwa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kwa kuwa utawafanya wakimbie","poem":1},{"text":"utakapowalenga usoni pao","poem":2},{"lineBreak":true},{"text":"kwa mshale kutoka kwenye upinde wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Bwana, utukuzwe katika nguvu zako,","poem":1},{"text":"tutaimba na kusifu nguvu zako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}