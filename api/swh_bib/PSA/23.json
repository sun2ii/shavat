,"content":[{"text":"Waandaa meza mbele yangu","poem":1},{"text":"machoni pa adui zangu.","poem":2},{"text":"Umenipaka mafuta kichwani pangu,","poem":1},{"text":"kikombe changu kinafurika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hakika wema na upendo vitanifuata","poem":1},{"text":"siku zote za maisha yangu,","poem":2},{"text":"nami nitakaa nyumbani mwa Bwana","poem":1},{"text":"milele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}