ya haki kutoka kwa Mungu Mwokozi wake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hiki ndicho kizazi cha wale wamtafutao,","poem":1},{"text":"wale wautafutao uso wako, Ee Mungu wa Yakobo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Inueni vichwa vyenu, enyi malango,","poem":1},{"text":"inukeni enyi milango ya kale,","poem":2},{"lineBreak":true},{"text":"ili mfalme wa utukufu apate kuingia.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ni nani huyu Mfalme wa utukufu?","poem":1},{"text":"Ni Bwana aliye na nguvu na uweza,","poem":2},{"lineBreak":true},{"text":"ni Bwana aliye hodari katika vita.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inueni vichwa vyenu, enyi malango,","poem":1},{"text":"viinueni juu enyi milango ya kale,","poem":2},{"lineBreak":true},{"text":"ili Mfalme wa utukufu apate kuingia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ni nani yeye, huyu Mfalme wa utukufu?","poem":1},{"text":"Ni Bwana Mwenye Nguvu Zote;","poem":2},{"lineBreak":true},{"text":"yeye ndiye Mfalme wa utukufu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}