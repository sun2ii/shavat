watenda mabaya","poem":1},{"text":"na ninakataa kuketi pamoja na waovu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ninanawa mikono yangu kwa kuwa sina hatia,","poem":1},{"text":"naikaribia madhabahu yako, Ee Bwana,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nikitangaza sifa yako kwa sauti kubwa,","poem":1},{"text":"huku nikisimulia matendo yako ya ajabu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Bwana, naipenda nyumba yako mahali unakoishi,","poem":1},{"text":"mahali ambapo utukufu wako hukaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Usiiondoe nafsi yangu pamoja na watenda dhambi,","poem":1},{"text":"wala uhai wangu pamoja na wamwagao damu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ambao mikononi mwao kuna mipango miovu,","poem":1},{"text":"ambao mikono yao ya kuume imejaa rushwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bali mimi ninaishi maisha yasiyo na lawama;","poem":1},{"text":"nikomboe na unihurumie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Miguu yangu imesimama katika uwanja tambarare;","poem":1},{"text":"katika kusanyiko kuu nitamsifu Bwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}