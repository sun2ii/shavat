{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"heading","content":["Sala Ya Kusifu"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Bwana ni nuru yangu na wokovu wangu,","poem":1},{"text":"nimwogope nani?","poem":2},{"text":"Bwana ni ngome ya uzima wangu,","poem":1},{"text":"nimhofu nani?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waovu watakaposogea dhidi yangu","poem":1},{"text":"ili wanile nyama yangu,","poem":2},{"text":"adui zangu na watesi wangu watakaponishambulia,","poem":1},{"text":"watajikwaa na kuanguka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hata jeshi linizunguke pande zote,","poem":1},{"text":"moyo wangu hautaogopa;","poem":2},{"text":"hata vita vitokee dhidi yangu,","poem":1},{"text":"hata hapo nitakuwa na ujasiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jambo moja ninamwomba Bwana,","poem":1},{"text":"hili ndilo ninalolitafuta:","poem":2},{"text":"niweze kukaa nyumbani mwa Bwana","poem":1},{"text":"siku zote za maisha yangu,","poem":2},{"text":"niutazame uzuri wa Bwana","poem":1},{"text":"na kumtafuta hekaluni mwake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa kuwa siku ya shida,","poem":1},{"text":"atanihifadhi salama katika maskani yake,","poem":2},{"text":"atanificha uvulini mwa hema yake","poem":1},{"text":"na kuniweka juu kwenye mwamba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kisha kichwa changu kitainuliwa","poem":1},{"text":"juu ya adui zangu wanaonizunguka.","poem":2},{"text":"Katika maskani yake nitatoa dhabihu kwa kelele za shangwe;","poem":1},{"text":"nitamwimbia Bwana na kumsifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isikie sauti yangu nikuitapo, Ee Bwana,","poem":1},{"text":"unihurumie na unijibu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moyo wangu unasema kuhusu wewe,","poem":1},{"text":"“Utafute uso wake!”","poem":2},{"lineBreak":true},{"text":"Uso wako, Bwana “Nitautafuta.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Usinifiche uso wako,","poem":1},{"text":"usimkatae mtumishi wako kwa hasira;","poem":2},{"lineBreak":true},{"text":"wewe umekuwa msaada wangu.","poem":2},{"text":"Usinikatae wala usiniache,","poem":1},{"text":"Ee Mungu Mwokozi wangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hata kama baba yangu na mama wakiniacha,","poem":1},{"text":"Bwana atanipokea.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nifundishe njia yako, Ee Bwana,","poem":1},{"text":"niongoze katika njia iliyonyooka","poem":2},{"lineBreak":true},{"text":"kwa sababu ya watesi wangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Usiniachilie kwa nia za adui zangu,","poem":1},{"text":"kwa maana mashahidi wa uongo","poem":2},{"lineBreak":true},{"text":"wameinuka dhidi yangu,","poem":2},{"lineBreak":true},{"text":"wakipumua ujeuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nami bado nina tumaini hili:","poem":1},{"text":"nitauona wema wa Bwana","poem":2},{"lineBreak":true},{"text":"katika nchi ya walio hai.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mngojee Bwana,","poem":1},{"text":"uwe hodari na mwenye moyo mkuu,","poem":2},{"lineBreak":true},{"text":"nawe, umngojee Bwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}