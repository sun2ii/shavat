,"poem":1},{"text":"sawasawa na matendo yao maovu;","poem":2},{"text":"walipe sawasawa na kazi za mikono yao,","poem":1},{"text":"uwalipe wanavyostahili.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa kuwa hawaheshimu kazi za Bwana,","poem":1},{"text":"na yale ambayo mikono yake imetenda,","poem":2},{"text":"atawabomoa na kamwe","poem":1},{"text":"hatawajenga tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bwana asifiwe,","poem":1},{"text":"kwa maana amesikia kilio changu","poem":2},{"lineBreak":true},{"text":"nikimwomba anihurumie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bwana ni nguvu zangu na ngao yangu,","poem":1},{"text":"moyo wangu umemtumaini yeye,","poem":2},{"lineBreak":true},{"text":"nami nimesaidiwa.","poem":2},{"text":"Moyo wangu unarukaruka kwa furaha","poem":1},{"text":"nami nitamshukuru kwa wimbo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bwana ni nguvu ya watu wake,","poem":1},{"text":"ngome ya wokovu kwa mpakwa mafuta wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waokoe watu wako na uubariki urithi wako;","poem":1},{"text":"uwe mchungaji wao na uwabebe milele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}