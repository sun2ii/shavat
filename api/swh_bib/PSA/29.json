{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"heading","content":["Sauti Ya Bwana Wakati Wa Dhoruba"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mpeni Bwana, enyi mashujaa,","poem":1},{"text":"mpeni Bwana utukufu na nguvu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mpeni Bwana utukufu unaostahili jina lake;","poem":1},{"text":"mwabuduni Bwana katika uzuri wa utakatifu wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sauti ya Bwana iko juu ya maji;","poem":1},{"text":"Mungu wa utukufu hupiga radi,","poem":2},{"lineBreak":true},{"text":"Bwana hupiga radi juu ya maji makuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sauti ya Bwana ina nguvu;","poem":1},{"text":"sauti ya Bwana ni tukufu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Sauti ya Bwana huvunja mierezi;","poem":1},{"text":"Bwana huvunja vipande vipande","poem":2},{"lineBreak":true},{"text":"mierezi ya Lebanoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hufanya Lebanoni irukaruke kama ndama,","poem":1},{"text":"Sirioni","poem":2},{"noteId":3},{"text":"urukaruke kama mwana nyati.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sauti ya Bwana hupiga kwa miali","poem":1},{"text":"ya umeme wa radi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sauti ya Bwana hutikisa jangwa;","poem":1},{"text":"Bwana hutikisa Jangwa la Kadeshi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sauti ya Bwana huzalisha ayala,","poem":1},{"text":"na huuacha msitu wazi.","poem":2},{"text":"Hekaluni mwake wote wasema,","poem":1},{"text":"“Utukufu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bwana huketi akiwa ametawazwa juu ya gharika;","poem":1},{"text":"Bwana ametawazwa kuwa Mfalme milele.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwana huwapa watu wake nguvu;","poem":1},{"text":"Bwana huwabariki watu wake kwa kuwapa amani.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"Yaani Mlima Hermoni.","reference":{"chapter":29,"verse":6}}]},"thisChapterLink":"/api/swh_bib/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}