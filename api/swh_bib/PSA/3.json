{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Sala Ya Asubuhi Ya Kuomba Msaada"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi. Alipomkimbia mwanawe Absalomu."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, tazama adui zangu walivyo wengi!","poem":1},{"text":"Ni wengi kiasi gani wanaoinuka dhidi yangu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wengi wanasema juu yangu,","poem":1},{"text":"“Mungu hatamwokoa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lakini wewe, Ee Bwana, ni ngao pande zote;","poem":1},{"text":"umeniwekea utukufu na kuinua kichwa changu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ninamlilia Bwana kwa sauti kuu,","poem":1},{"text":"naye ananijibu kutoka mlima wake mtakatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ninajilaza na kupata usingizi;","poem":1},{"text":"naamka tena, kwa maana Bwana hunitegemeza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sitaogopa makumi elfu ya adui,","poem":1},{"text":"wanaojipanga dhidi yangu kila upande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Bwana, amka!","poem":1},{"text":"Niokoe, Ee Mungu wangu!","poem":2},{"text":"Wapige adui zangu wote kwenye taya,","poem":1},{"text":"vunja meno ya waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwa maana wokovu watoka kwa Bwana.","poem":1},{"lineBreak":true},{"text":"Baraka yako na iwe juu ya watu wako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}