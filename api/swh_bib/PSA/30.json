{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"heading","content":["Maombi Ya Shukrani"]},{"type":"hebrew_subtitle","content":["Utenzi wa kuweka wakfu hekalu. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nitakutukuza wewe, Ee Bwana,","poem":1},{"text":"kwa kuwa umeniinua kutoka vilindi,","poem":2},{"text":"na hukuacha adui zangu","poem":1},{"text":"washangilie juu yangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Bwana, Mungu wangu, nilikuita unisaidie","poem":1},{"text":"na wewe umeniponya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee Bwana, umenitoa Kuzimu,","poem":1},{"text":"umeniokoa nisishuke kwenye shimo la mauti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwimbieni Bwana, enyi watakatifu wake;","poem":1},{"text":"lisifuni jina lake takatifu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa maana hasira yake ni ya muda mfupi,","poem":1},{"text":"bali upendo wake hudumu siku zote.","poem":2},{"text":"Inawezekana kilio kiwepo usiku kucha,","poem":1},{"text":"lakini asubuhi kukawa na furaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nilipofanikiwa nilisema,","poem":1},{"text":"“Sitatikiswa kamwe.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Bwana, uliponijalia,","poem":1},{"text":"uliuimarisha mlima wangu,","poem":2},{"text":"lakini ulipouficha uso wako","poem":1},{"text":"nilifadhaika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwako wewe, Ee Bwana, niliita,","poem":1},{"text":"kwa Bwana niliomba rehema:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Kuna faida gani katika kuangamia kwangu?","poem":1},{"text":"Katika kushuka kwangu shimoni?","poem":2},{"text":"Je, mavumbi yatakusifu?","poem":1},{"text":"Je, yatatangaza uaminifu wako?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Bwana, unisikie na kunihurumia,","poem":1},{"text":"Ee Bwana, uwe msaada wangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Uligeuza maombolezo yangu kuwa kucheza,","poem":1},{"text":"ulinivua nguo za gunia ukanivika shangwe,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ili moyo wangu uweze kukusifu na usikae kimya.","poem":1},{"text":"Ee Bwana Mungu wangu, nitakushukuru milele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}