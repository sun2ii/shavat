{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"heading","content":["Maombi Na Sifa Kwa Kuokolewa Kutoka Kwa Adui"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, nimekukimbilia wewe,","poem":1},{"text":"usiache nikaaibika kamwe,","poem":2},{"lineBreak":true},{"text":"kwa haki yako uniokoe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitegee sikio lako,","poem":1},{"text":"uje uniokoe haraka;","poem":2},{"text":"uwe kwangu mwamba wa kimbilio,","poem":1},{"text":"ngome imara ya kuniokoa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa wewe ni mwamba wangu na ngome yangu,","poem":1},{"text":"uniongoze na kunilinda kwa ajili ya jina lako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uniepushe na mtego niliotegewa,","poem":1},{"text":"maana wewe ndiwe kimbilio langu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ninaikabidhi roho yangu mikononi mwako,","poem":1},{"text":"unikomboe Ee Bwana, uliye Mungu wa kweli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ninawachukia wale wanaongʼangʼania sanamu batili;","poem":1},{"text":"mimi ninamtumaini Bwana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nitafurahia na kushangilia upendo wako,","poem":1},{"text":"kwa kuwa uliona mateso yangu","poem":2},{"lineBreak":true},{"text":"na ulijua maumivu ya nafsi yangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hukunikabidhi kwa adui yangu","poem":1},{"text":"bali umeiweka miguu yangu mahali penye nafasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Bwana unihurumie, kwa kuwa niko kwenye shida;","poem":1},{"text":"macho yangu yanafifia kwa huzuni,","poem":2},{"lineBreak":true},{"text":"nafsi yangu na mwili wangu kwa sikitiko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maisha yangu yamedhoofika kwa majonzi,","poem":1},{"text":"naam, miaka yangu kwa kulia kwa maumivu makali;","poem":2},{"text":"nguvu zangu zinaisha kwa ajili ya mateso,","poem":1},{"text":"na mifupa yangu inachakaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa sababu ya adui zangu wote,","poem":1},{"text":"nimedharauliwa kabisa na jirani zangu,","poem":2},{"text":"hata kwa rafiki zangu nimekuwa tisho,","poem":1},{"text":"wale wanionao barabarani hunikimbia.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nimesahaulika miongoni mwao kama mtu aliyekufa,","poem":1},{"text":"nimekuwa kama chombo cha mfinyanzi kilichovunjika.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa maana nimesikia maneno niliyosingiziwa na wengi;","poem":1},{"text":"vitisho viko pande zote;","poem":2},{"text":"kwa kuwa wamefanya mashauri dhidi yangu,","poem":1},{"text":"na kula njama kuniua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lakini mimi ninakutumaini wewe peke yako, Ee Bwana;","poem":1},{"text":"nimesema, “Wewe ndiwe Mungu wangu.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Siku za maisha yangu ziko mikononi mwako,","poem":1},{"text":"uniokoe mikononi mwa adui zangu","poem":2},{"lineBreak":true},{"text":"na wale wanifuatiao.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwangazie mtumishi wako uso wako,","poem":1},{"text":"uniokoe kwa ajili ya upendo wako usiokoma.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Usiniache niaibike, Ee Bwana,","poem":1},{"text":"kwa maana nimekulilia wewe,","poem":2},{"text":"bali waovu waaibishwe","poem":1},{"text":"na kunyamazishwa Kuzimu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Midomo yao isemayo uongo na inyamazishwe,","poem":1},{"text":"kwa maana kwa kiburi na dharau","poem":2},{"text":"wao husema kwa majivuno","poem":1},{"text":"dhidi ya wenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tazama jinsi ulivyo mkuu wema wako,","poem":1},{"text":"uliowawekea akiba wakuchao,","poem":2},{"text":"ambao huwapa wale wakukimbiliao","poem":1},{"text":"machoni pa watu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unawahifadhi katika uvuli wa uwepo wako","poem":1},{"text":"kutokana na hila za wanadamu;","poem":2},{"text":"katika makao yako huwaweka salama","poem":1},{"text":"kutokana na ndimi za mashtaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Atukuzwe Bwana,","poem":1},{"text":"kwa kuwa amenionyesha upendo wake wa ajabu","poem":2},{"lineBreak":true},{"text":"nilipokuwa katika mji uliozingirwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Katika hofu yangu nilisema,","poem":1},{"text":"“Nimekatiliwa mbali na macho yako!”","poem":2},{"text":"Hata hivyo ulisikia kilio changu","poem":1},{"text":"ukanihurumia nilipokuita unisaidie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mpendeni Bwana ninyi watakatifu wake wote!","poem":1},{"text":"Bwana huwahifadhi waaminifu,","poem":2},{"lineBreak":true},{"text":"lakini wenye kiburi huwalipiza kikamilifu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kuweni hodari na mjipe moyo,","poem":1},{"text":"ninyi nyote mnaomtumaini Bwana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}