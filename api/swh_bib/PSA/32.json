{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"heading","content":["Furaha Ya Msamaha"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi. Funzo."]},{"type":"verse","number":1,"content":[{"text":"Heri mtu yule ambaye amesamehewa makosa yake,","poem":1},{"text":"ambaye dhambi zake zimefunikwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Heri mtu yule ambaye Bwana","poem":1},{"text":"hamhesabii dhambi,","poem":2},{"text":"na ambaye rohoni mwake","poem":1},{"text":"hamna udanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Niliponyamaza, mifupa yangu ilichakaa","poem":1},{"text":"kwa kulia kwa maumivu makali mchana kutwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Usiku na mchana","poem":1},{"text":"mkono wako ulinilemea,","poem":2},{"text":"nguvu zangu zilinyonywa","poem":1},{"text":"kama vile katika joto la kiangazi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kisha nilikujulisha dhambi yangu","poem":1},{"text":"wala sikuficha uovu wangu.","poem":2},{"text":"Nilisema, “Nitaungama","poem":1},{"text":"makosa yangu kwa Bwana.”","poem":2},{"text":"Ndipo uliponisamehe","poem":1},{"text":"hatia ya dhambi yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kwa hiyo kila mtu mcha Mungu akuombe","poem":1},{"text":"wakati unapopatikana,","poem":2},{"text":"hakika maji makuu yatakapofurika","poem":1},{"text":"hayatamfikia yeye.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wewe ndiwe mahali pangu pa kujificha,","poem":1},{"text":"utaniepusha na taabu","poem":2},{"lineBreak":true},{"text":"na kunizunguka kwa nyimbo za wokovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nitakufundisha na kukuonyesha njia utakayoiendea;","poem":1},{"text":"nitakushauri na kukuangalia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Usiwe kama farasi au nyumbu","poem":1},{"text":"wasio na akili,","poem":2},{"text":"ambao ni lazima waongozwe kwa lijamu na hatamu","poem":1},{"text":"la sivyo hawatakukaribia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mtu mwovu ana taabu nyingi,","poem":1},{"text":"bali upendo usio na kikomo wa Bwana","poem":2},{"lineBreak":true},{"text":"unamzunguka mtu anayemtumaini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Shangilieni katika Bwana na mfurahi, enyi wenye haki!","poem":1},{"text":"Imbeni, nyote mlio wanyofu wa moyo!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}