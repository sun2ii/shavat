{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"heading","content":["Ukuu Na Wema Wa Mungu"]},{"type":"verse","number":1,"content":[{"text":"Mwimbieni Bwana kwa furaha, enyi wenye haki;","poem":1},{"text":"kusifu kunawapasa wanyofu wa moyo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Msifuni Bwana kwa kinubi,","poem":1},{"text":"mwimbieni sifa kwa zeze la nyuzi kumi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwimbieni wimbo mpya;","poem":1},{"text":"pigeni kwa ustadi, na mpaze sauti za shangwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Maana neno la Bwana ni haki na kweli,","poem":1},{"text":"ni mwaminifu kwa yote atendayo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwana hupenda uadilifu na haki;","poem":1},{"text":"dunia imejaa upendo wake usiokoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kwa neno la Bwana mbingu ziliumbwa,","poem":1},{"text":"jeshi lao la angani kwa pumzi ya kinywa chake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ameyakusanya maji ya bahari","poem":1},{"text":"kama kwenye chungu;","poem":2},{"text":"vilindi vya bahari","poem":1},{"text":"ameviweka katika ghala.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Dunia yote na imwogope Bwana,","poem":1},{"text":"watu wote wa dunia wamche.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa maana Mungu alisema, na ikawa,","poem":1},{"text":"aliamuru na ikasimama imara.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bwana huzuia mipango ya mataifa,","poem":1},{"text":"hupinga makusudi ya mataifa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lakini mipango ya Bwana inasimama imara milele,","poem":1},{"text":"makusudi ya moyo wake kwa vizazi vyote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Heri taifa ambalo Bwana ni Mungu wao,","poem":1},{"text":"watu ambao aliwachagua kuwa urithi wake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kutoka mbinguni Bwana hutazama chini","poem":1},{"text":"na kuwaona wanadamu wote;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kutoka maskani mwake huwaangalia","poem":1},{"text":"wote wakaao duniani:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"yeye ambaye huumba mioyo yao wote,","poem":1},{"text":"ambaye huangalia kila kitu wanachokitenda.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hakuna mfalme aokokaye kwa ukubwa wa jeshi lake;","poem":1},{"text":"hakuna shujaa aokokaye kwa wingi wa nguvu zake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Farasi ni tumaini la bure kwa wokovu,","poem":1},{"text":"licha ya nguvu zake nyingi, hawezi kuokoa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lakini macho ya Bwana yako kwa wale wamchao,","poem":1},{"text":"kwa wale tumaini lao liko katika upendo wake usio na kikomo,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ili awaokoe na mauti,","poem":1},{"text":"na kuwahifadhi wakati wa njaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Sisi tunamngojea Bwana kwa matumaini,","poem":1},{"text":"yeye ni msaada wetu na ngao yetu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mioyo yetu humshangilia,","poem":1},{"text":"kwa maana tunalitumainia jina lake takatifu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Upendo wako usio na mwisho ukae juu yetu, Ee Bwana,","poem":1},{"text":"tunapoliweka tumaini letu kwako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}