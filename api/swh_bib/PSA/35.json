{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"heading","content":["Kuomba Msaada: Kuokolewa Kutokana Na Maadui"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, pingana na wale wanaopingana nami,","poem":1},{"text":"upigane na hao wanaopigana nami.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Chukua ngao na kigao.","poem":1},{"text":"Inuka unisaidie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inua mkuki wako na fumo","poem":1},{"noteId":4},{"text":"lako","poem":1},{"text":"dhidi ya hao wanaonifuatia.","poem":2},{"text":"Iambie nafsi yangu,","poem":1},{"text":"“Mimi ni wokovu wako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wafedheheshwe na waaibishwe","poem":1},{"text":"wale wanaotafuta uhai wangu.","poem":2},{"text":"Wanaofanya shauri kuniangamiza","poem":1},{"text":"warudishwe nyuma kwa hofu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wawe kama makapi yapeperushwayo na upepo,","poem":1},{"text":"malaika wa Bwana akiwafukuza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Njia yao na iwe giza na ya utelezi,","poem":1},{"text":"malaika wa Bwana akiwafuatilia.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa vile walinifichia wavu wao bila sababu,","poem":1},{"text":"na bila sababu wamenichimbia shimo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"maafa na yawapate ghafula:","poem":1},{"text":"wavu walionifichia na uwatege wenyewe,","poem":2},{"text":"na waanguke katika shimo hilo,","poem":1},{"text":"kwa maangamizo yao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndipo nafsi yangu itashangilia katika Bwana","poem":1},{"text":"na kuufurahia wokovu wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nitapaza sauti yangu nikisema,","poem":1},{"text":"“Ni nani aliye kama wewe, Ee Bwana?","poem":2},{"text":"Wewe huwaokoa maskini kutokana na wale walio na nguvu kuliko wao,","poem":1},{"text":"maskini na mhitaji kutokana na wanaowanyangʼanya!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mashahidi wakatili wanainuka,","poem":1},{"text":"wananiuliza mambo nisiyoyajua.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wananilipa baya kwa jema","poem":1},{"text":"na kuiacha nafsi yangu ukiwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lakini walipokuwa wagonjwa, nilivaa nguo ya gunia","poem":1},{"text":"na nikajinyenyekesha kwa kufunga.","poem":2},{"text":"Maombi yangu yaliponirudia bila kujibiwa,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"niliendelea kuomboleza","poem":2},{"lineBreak":true},{"text":"kama vile wao ni rafiki au ndugu.","poem":2},{"text":"Niliinamisha kichwa chini kwa huzuni","poem":1},{"text":"kama ninayemwombolezea mama yangu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lakini nilipojikwaa,","poem":1},{"text":"walikusanyika kwa shangwe;","poem":2},{"text":"washambuliaji walijikusanya dhidi yangu","poem":1},{"text":"bila mimi kujua.","poem":2},{"lineBreak":true},{"text":"Walinisingizia pasipo kukoma.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kama watu wasiomcha Mungu, wamenidhihaki,","poem":1},{"text":"wamenisagia meno.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Bwana, utatazama mpaka lini?","poem":1},{"text":"Niokoe maisha yangu na maangamizi yao,","poem":2},{"text":"uhai wangu wa thamani","poem":1},{"text":"kutokana na simba hawa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nami nitakushukuru mbele ya kusanyiko kubwa,","poem":1},{"text":"nitakusifu katikati ya watu wengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Usiwaache wale wanaonisimanga,","poem":1},{"text":"wale ambao ni adui zangu bila sababu;","poem":2},{"text":"usiwaache wale ambao ni adui zangu bila sababu","poem":1},{"text":"wakonyeze jicho kwa hila.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hawazungumzi kwa amani,","poem":1},{"text":"bali wanatunga mashtaka ya uongo","poem":2},{"text":"dhidi ya wale wanaoishi","poem":1},{"text":"kwa utulivu katika nchi.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hunifumbulia vinywa vyao wakisema, “Aha! Aha!","poem":1},{"text":"Kwa macho yetu wenyewe tumeliona.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ee Bwana, umeona hili, usiwe kimya.","poem":1},{"text":"Usiwe mbali nami, Ee Bwana.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Amka, inuka unitetee!","poem":1},{"text":"Unipiganie Mungu wangu na Bwana wangu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nihukumu kwa haki yako, Ee Bwana Mungu wangu,","poem":1},{"text":"sawasawa na haki yako;","poem":2},{"lineBreak":true},{"text":"usiwaache wakusimange.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Usiwaache wafikiri, “Aha, hili ndilo tulilotaka!”","poem":1},{"text":"Au waseme, “Tumemmeza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Wote wanaofurahia dhiki yangu","poem":1},{"text":"waaibishwe na wachanganyikiwe;","poem":2},{"text":"hao wanaojiinua dhidi yangu","poem":1},{"text":"wavikwe aibu na dharau.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wale wanaofurahia hukumu yangu ya haki","poem":1},{"text":"wapige kelele za shangwe na furaha;","poem":2},{"text":"hebu waseme siku zote, “Bwana atukuzwe,","poem":1},{"text":"ambaye amefurahia mafanikio ya mtumishi wake.”","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ulimi wangu utanena haki yako","poem":1},{"text":"na sifa zako mchana kutwa.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Fumo ni sawa na sagai, maana yake ni mkuki mfupi.","reference":{"chapter":35,"verse":3}}]},"thisChapterLink":"/api/swh_bib/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}