{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"heading","content":["Uovu Wa Mwanadamu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi mtumishi wa Bwana."]},{"type":"verse","number":1,"content":[{"text":"Kuna neno moyoni mwangu","poem":1},{"text":"kuhusu hali ya dhambi ya mwovu.","poem":2},{"text":"Hakuna hofu ya Mungu","poem":1},{"text":"mbele ya macho yake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa kuwa machoni pake mwenyewe hujisifu mno","poem":1},{"text":"hata hawezi kugundua au kuichukia dhambi yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maneno ya kinywa chake ni maovu na ya udanganyifu,","poem":1},{"text":"ameacha kuwa mwenye hekima na kutenda mema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hata kitandani mwake hupanga hila mbaya,","poem":1},{"text":"hujitia katika njia ya dhambi","poem":2},{"lineBreak":true},{"text":"na hakatai lililo baya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Upendo wako, Ee Bwana, unafika hadi mbinguni,","poem":1},{"text":"uaminifu wako hadi kwenye anga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haki yako ni kama milima mikubwa,","poem":1},{"text":"hukumu zako ni kama kilindi kikuu.","poem":2},{"text":"Ee Bwana, wewe huwahifadhi","poem":1},{"text":"mwanadamu na mnyama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Upendo wako usiokoma","poem":1},{"text":"ni wa thamani mno!","poem":2},{"text":"Watu wakuu na wadogo","poem":1},{"text":"hujificha uvulini wa mbawa zako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wanajifurahisha katika wingi nyumbani mwako,","poem":1},{"text":"nawe utawanywesha katika mto wa furaha zako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuwa pamoja nawe ni kijito cha uzima,","poem":1},{"text":"katika nuru yako twaona nuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dumisha upendo wako kwa wale wanaokujua wewe,","poem":1},{"text":"haki yako kwa wale walio wanyofu wa moyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mguu wa mwenye kiburi usije dhidi yangu,","poem":1},{"text":"wala mkono wa mwovu usinifukuze.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Angalia jinsi watenda mabaya walivyoanguka:","poem":1},{"text":"wametupwa chini, hawawezi kuinuka!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}