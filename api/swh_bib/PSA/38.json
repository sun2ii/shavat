{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"heading","content":["Maombi Ya Mtu Anayeteseka"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi. Maombi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, usinikemee katika hasira yako,","poem":1},{"text":"wala kuniadhibu katika ghadhabu yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa kuwa mishale yako imenichoma,","poem":1},{"text":"na mkono wako umenishukia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hakuna afya mwilini mwangu","poem":1},{"text":"kwa sababu ya ghadhabu yako,","poem":2},{"text":"mifupa yangu haina uzima","poem":1},{"text":"kwa sababu ya dhambi zangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maovu yangu yamenifunika","poem":1},{"text":"kama mzigo usiochukulika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Majeraha yangu yameoza na yananuka,","poem":1},{"text":"kwa sababu ya upumbavu wa dhambi zangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimeinamishwa chini na kushushwa sana,","poem":1},{"text":"mchana kutwa nazunguka nikiomboleza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Viuno vyangu vimejaa maumivu yaunguzayo,","poem":1},{"text":"hakuna afya mwilini mwangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nimedhoofika na kupondwa kabisa,","poem":1},{"text":"nasononeka kwa maumivu makuu ya moyoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Bwana, yote ninayoyaonea shauku","poem":1},{"text":"yako wazi mbele zako,","poem":2},{"text":"kutamani kwangu sana","poem":1},{"text":"hakufichiki mbele zako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Moyo wangu unapigapiga,","poem":1},{"text":"nguvu zangu zimeniishia;","poem":2},{"lineBreak":true},{"text":"hata macho yangu yametiwa giza.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Rafiki na wenzangu wananikwepa","poem":1},{"text":"kwa sababu ya majeraha yangu;","poem":2},{"lineBreak":true},{"text":"majirani zangu wanakaa mbali nami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wale wanaotafuta uhai wangu","poem":1},{"text":"wanatega mitego yao,","poem":2},{"text":"wale ambao wangetaka kunidhuru","poem":1},{"text":"huongea juu ya maangamizi yangu;","poem":2},{"lineBreak":true},{"text":"hufanya shauri la hila mchana kutwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mimi ni kama mtu kiziwi, asiyeweza kusikia,","poem":1},{"text":"ni kama bubu, asiyeweza kufungua kinywa chake,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nimekuwa kama mtu asiyesikia,","poem":1},{"text":"ambaye kinywa chake hakiwezi kutoa jibu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ee Bwana, ninakungojea wewe,","poem":1},{"text":"Ee Bwana Mungu wangu, utajibu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa kuwa nilisema, “Usiwaache wafurahie,","poem":1},{"text":"wala wasijitukuze juu yangu","poem":2},{"lineBreak":true},{"text":"mguu wangu unapoteleza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kwa maana ninakaribia kuanguka,","poem":1},{"text":"na maumivu yangu yananiandama siku zote.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naungama uovu wangu,","poem":1},{"text":"ninataabishwa na dhambi yangu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wengi ni wale ambao ni adui zangu hodari,","poem":1},{"text":"wale wanaonichukia bila sababu ni wengi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wanaolipa maovu kwa wema wangu","poem":1},{"text":"hunisingizia ninapofuata lililo jema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ee Bwana, usiniache,","poem":1},{"text":"usiwe mbali nami, Ee Mungu wangu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ee Bwana Mwokozi wangu,","poem":1},{"text":"uje upesi kunisaidia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}