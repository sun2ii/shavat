{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"heading","content":["Maombi Ya Mtu Anayeteseka"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa Yeduthuni. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nilisema, “Nitaziangalia njia zangu","poem":1},{"text":"na kuuzuia ulimi wangu usije ukatenda dhambi;","poem":2},{"text":"nitaweka lijamu kinywani mwangu","poem":1},{"text":"wakati wote waovu wanapokuwa karibu nami.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lakini niliponyamaza kimya na kutulia,","poem":1},{"text":"hata pasipo kusema lolote jema,","poem":2},{"lineBreak":true},{"text":"uchungu wangu uliongezeka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Moyo wangu ulipata moto ndani yangu,","poem":1},{"text":"nilipotafakari, moto uliwaka,","poem":2},{"lineBreak":true},{"text":"ndipo nikasema kwa ulimi wangu:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ee Bwana, nijulishe mwisho wa maisha yangu","poem":1},{"text":"na hesabu ya siku zangu;","poem":2},{"text":"nijalie kujua jinsi maisha yangu","poem":1},{"text":"yanavyopita upesi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umefanya maisha yangu mafupi kama pumzi;","poem":1},{"text":"muda wangu wa kuishi ni kama","poem":2},{"lineBreak":true},{"text":"hauna thamani kwako.","poem":2},{"text":"Maisha ya kila mwanadamu","poem":1},{"text":"ni kama pumzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hakika kila binadamu ni kama njozi","poem":1},{"text":"aendapo huku na huko:","poem":2},{"text":"hujishughulisha na mengi lakini ni ubatili;","poem":1},{"text":"anakusanya mali nyingi,","poem":2},{"lineBreak":true},{"text":"wala hajui ni nani atakayeifaidi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Lakini sasa Bwana, nitafute nini?","poem":1},{"text":"Tumaini langu ni kwako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niokoe kutoka kwenye makosa yangu yote,","poem":1},{"text":"usinifanye kuwa dhihaka ya wapumbavu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nilinyamaza kimya,","poem":1},{"text":"sikufumbua kinywa changu,","poem":2},{"lineBreak":true},{"text":"kwa sababu wewe ndiwe uliyetenda hili.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Niondolee mjeledi wako,","poem":1},{"text":"nimeshindwa kwa mapigo ya mkono wako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unakemea na kuadhibu wanadamu","poem":1},{"text":"kwa ajili ya dhambi zao;","poem":2},{"text":"unaharibu utajiri wao kama nondo aharibuvyo:","poem":1},{"text":"kila mwanadamu ni kama pumzi tu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ee Bwana, usikie maombi yangu,","poem":1},{"text":"usikie kilio changu unisaidie,","poem":2},{"lineBreak":true},{"text":"usiwe kiziwi kwa kulia kwangu.","poem":2},{"text":"Kwani mimi ninaishi na wewe kama mgeni,","poem":1},{"text":"kama walivyokuwa baba zangu wote,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tazama mbali nami, ili niweze kufurahi tena","poem":1},{"text":"kabla sijaondoka na nisiwepo tena.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}