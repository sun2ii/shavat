{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["Sala Ya Jioni Ya Kuomba Msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa ala za nyuzi za muziki. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nijibu nikuitapo,","poem":1},{"text":"Ee Mungu wangu mwenye haki!","poem":2},{"text":"Nipumzishe katika shida zangu;","poem":1},{"text":"nirehemu, usikie ombi langu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Enyi watu, mtabadilisha utukufu wangu","poem":1},{"text":"kuwa aibu mpaka lini?","poem":2},{"text":"Mtapenda udanganyifu","poem":1},{"text":"na kufuata miungu ya uongo mpaka lini?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fahamuni hakika kwamba Bwana amewatenga","poem":1},{"text":"wale wamchao kwa ajili yake;","poem":2},{"lineBreak":true},{"text":"Bwana atanisikia nimwitapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Katika hasira yako, usitende dhambi.","poem":1},{"text":"Mkiwa vitandani mwenu, mtulie kimya","poem":2},{"lineBreak":true},{"text":"mkiichunguza mioyo yenu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Toeni dhabihu zilizo haki;","poem":1},{"text":"mtegemeeni Bwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wengi wanauliza, “Ni nani awezaye","poem":1},{"text":"kutuonyesha jema lolote?”","poem":2},{"lineBreak":true},{"text":"Ee Bwana, tuangazie nuru ya uso wako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wewe umejaza moyo wangu kwa furaha kubwa","poem":1},{"text":"kuliko watu waliopata nafaka na divai kwa wingi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nitajilaza chini na kulala kwa amani,","poem":1},{"text":"kwa kuwa wewe peke yako, Ee Bwana,","poem":2},{"lineBreak":true},{"text":"waniwezesha kukaa kwa salama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}