{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"heading","content":["Maombi Ya Mtu Mgonjwa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Heri mtu yule anayemjali mnyonge,","poem":1},{"text":"Bwana atamwokoa wakati wa shida.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwana atamlinda na kuyahifadhi maisha yake,","poem":1},{"text":"atambariki katika nchi","poem":2},{"lineBreak":true},{"text":"na hatamwacha katika tamaa ya adui zake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bwana atamtegemeza awapo mgonjwa kitandani,","poem":1},{"text":"atamwinua kutoka kitandani mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nilisema, “Ee Bwana nihurumie,","poem":1},{"text":"niponye, maana nimekutenda dhambi wewe.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adui zangu wanasema kwa hila,","poem":1},{"text":"“Lini atakufa, na jina lake litokomee kabisa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kila anapokuja mtu kunitazama,","poem":1},{"text":"huzungumza uongo,","poem":2},{"text":"huku moyo wake hukusanya masingizio;","poem":1},{"text":"kisha huondoka na kuyasambaza huku na huko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Adui zangu wote hunongʼonezana dhidi yangu,","poem":1},{"text":"hao huniwazia mabaya sana, wakisema,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ugonjwa mbaya sana umempata,","poem":1},{"text":"kamwe hatainuka tena kitandani mwake.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hata rafiki yangu wa karibu niliyemwamini,","poem":1},{"text":"yule aliyekula chakula changu","poem":2},{"lineBreak":true},{"text":"ameniinulia kisigino chake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lakini wewe, Ee Bwana, nihurumie,","poem":1},{"text":"ukaniinue tena, ili niweze kuwalipiza kisasi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Najua kwamba wapendezwa nami,","poem":1},{"text":"kwa kuwa adui yangu hanishindi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Katika uadilifu wangu unanitegemeza","poem":1},{"text":"na kuniweka kwenye uwepo wako milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Msifuni Bwana, Mungu wa Israeli,","poem":1},{"text":"tangu milele na hata milele.","poem":2},"Amen na Amen."]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}