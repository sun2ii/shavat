{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"heading","content":["Maombi Ya Mtu Aliye Uhamishoni"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Utenzi wa wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Kama vile ayala aoneavyo shauku vijito vya maji,","poem":1},{"text":"ndivyo nafsi yangu ikuoneavyo shauku, Ee Mungu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nafsi yangu inamwonea Mungu kiu, Mungu aliye hai.","poem":1},{"text":"Ni lini nitaweza kwenda kukutana na Mungu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Machozi yangu yamekuwa chakula changu","poem":1},{"text":"usiku na mchana,","poem":2},{"text":"huku watu wakiniambia mchana kutwa,","poem":1},{"text":"“Yuko wapi Mungu wako?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mambo haya nayakumbuka","poem":1},{"text":"ninapoimimina nafsi yangu:","poem":2},{"text":"Jinsi nilivyokuwa nikienda na umati wa watu,","poem":1},{"text":"nikiongoza maandamano kuelekea kwenye nyumba ya Mungu,","poem":2},{"text":"kwa kelele za shangwe na za shukrani","poem":1},{"text":"katikati ya umati uliosherehekea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee nafsi yangu, kwa nini unasononeka?","poem":1},{"text":"Kwa nini unafadhaika hivyo ndani yangu?","poem":2},{"text":"Weka tumaini lako kwa Mungu,","poem":1},{"text":"kwa sababu bado nitamsifu,","poem":2},{"lineBreak":true},{"text":"Mwokozi wangu na","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Mungu wangu.","poem":2},{"lineBreak":true},{"text":"Nafsi yangu inasononeka ndani yangu;","poem":1},{"text":"kwa hiyo nitakukumbuka","poem":2},{"text":"kutoka nchi ya Yordani,","poem":1},{"text":"katika vilele vya Hermoni,","poem":2},{"lineBreak":true},{"text":"kutoka Mlima Mizari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kilindi huita kilindi,","poem":1},{"text":"katika ngurumo za maporomoko ya maji yako;","poem":2},{"text":"mawimbi yako yote pamoja na viwimbi","poem":1},{"text":"vimepita juu yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mchana Bwana huelekeza upendo wake,","poem":1},{"text":"usiku wimbo wake uko nami:","poem":2},{"lineBreak":true},{"text":"maombi kwa Mungu wa uzima wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ninamwambia Mungu Mwamba wangu,","poem":1},{"text":"“Kwa nini umenisahau?","poem":2},{"text":"Kwa nini niendelee kuomboleza,","poem":1},{"text":"nikiwa nimeonewa na adui?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mifupa yangu inateseka kwa maumivu makali","poem":1},{"text":"adui zangu wanaponidhihaki,","poem":2},{"text":"wakiniambia mchana kutwa,","poem":1},{"text":"“Yuko wapi Mungu wako?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee nafsi yangu, kwa nini unasononeka?","poem":1},{"text":"Kwa nini unafadhaika hivyo ndani yangu?","poem":2},{"text":"Weka tumaini lako kwa Mungu,","poem":1},{"text":"kwa sababu bado nitamsifu,","poem":2},{"lineBreak":true},{"text":"Mwokozi wangu na Mungu wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}