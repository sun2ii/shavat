{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Maombi Ya Mtu Aliyeko Uhamishoni Yanaendelea"]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu unihukumu,","poem":1},{"text":"nitetee dhidi ya taifa lisilomcha Mungu,","poem":2},{"lineBreak":true},{"text":"niokoe na watu wadanganyifu na waovu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wewe ni Mungu ngome yangu.","poem":1},{"text":"Kwa nini umenikataa?","poem":2},{"text":"Kwa nini niendelee kuomboleza,","poem":1},{"text":"nikiwa nimeonewa na adui?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tuma hima nuru yako na kweli yako","poem":1},{"text":"na viniongoze;","poem":2},{"text":"vinilete mpaka mlima wako mtakatifu,","poem":1},{"text":"mpaka mahali unapoishi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo nitakwenda madhabahuni pa Mungu,","poem":1},{"text":"kwa Mungu, furaha yangu na shangwe yangu.","poem":2},{"text":"Nitakusifu kwa kinubi,","poem":1},{"text":"Ee Mungu, Mungu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee nafsi yangu, kwa nini unasononeka?","poem":1},{"text":"Kwa nini unafadhaika hivyo ndani yangu?","poem":2},{"text":"Weka tumaini lako kwa Mungu,","poem":1},{"text":"kwa sababu bado nitamsifu","poem":2},{"lineBreak":true},{"text":"Mwokozi wangu na Mungu wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}