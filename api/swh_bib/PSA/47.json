{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["Mtawala Mwenye Enzi Yote"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Pigeni makofi, enyi mataifa yote,","poem":1},{"text":"mpigieni Mungu kelele za shangwe!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jinsi gani alivyo wa kutisha, Bwana Aliye Juu Sana,","poem":1},{"text":"Mfalme mkuu juu ya dunia yote!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ametiisha mataifa chini yetu","poem":1},{"text":"watu wengi chini ya miguu yetu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alituchagulia urithi wetu,","poem":1},{"text":"fahari ya Yakobo, aliyempenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mungu amepaa kwa kelele za shangwe,","poem":1},{"text":"Bwana kwa sauti za tarumbeta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwimbieni Mungu sifa, imbeni sifa,","poem":1},{"text":"mwimbieni sifa Mfalme wetu, imbeni sifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwa kuwa Mungu ni mfalme wa dunia yote,","poem":1},{"text":"mwimbieni zaburi za sifa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mungu anatawala juu ya mataifa,","poem":1},{"text":"Mungu ameketi juu ya kiti chake cha enzi kitakatifu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wakuu wa mataifa wanakusanyika","poem":1},{"text":"kama watu wa Mungu wa Abrahamu,","poem":2},{"text":"kwa kuwa wafalme wa dunia ni mali ya Mungu;","poem":1},{"text":"yeye ametukuka sana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}