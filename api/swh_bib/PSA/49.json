{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"heading","content":["Upumbavu Wa Kutegemea Mali"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Sikieni haya, enyi mataifa yote,","poem":1},{"text":"sikilizeni, ninyi wote mkaao dunia hii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wakubwa kwa wadogo,","poem":1},{"text":"matajiri na maskini pamoja:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kinywa changu kitasema maneno ya hekima,","poem":1},{"text":"usemi wa moyo wangu utatoa ufahamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nitatega sikio langu nisikilize mithali,","poem":1},{"text":"nitafafanua kitendawili kwa zeze:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa nini niogope siku mbaya zinapokuja,","poem":1},{"text":"wakati wadanganyifu waovu wanaponizunguka,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wale wanaotegemea mali zao","poem":1},{"text":"na kujivunia utajiri wao mwingi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hakuna mwanadamu awaye yote","poem":1},{"text":"awezaye kuukomboa uhai wa mwingine,","poem":2},{"lineBreak":true},{"text":"au kumpa Mungu fidia kwa ajili yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Fidia ya uhai ni gharama kubwa,","poem":1},{"text":"hakuna malipo yoyote yanayotosha,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ili kwamba aishi milele","poem":1},{"text":"na asione uharibifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wote wanaona kwamba watu wenye hekima hufa;","poem":1},{"text":"wajinga na wapumbavu vivyo hivyo huangamia","poem":2},{"lineBreak":true},{"text":"na kuwaachia wengine mali zao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Makaburi yao yatabaki kuwa nyumba zao za milele,","poem":1},{"text":"makao yao vizazi vyote;","poem":2},{"text":"ingawa walikuwa na mashamba","poem":1},{"text":"na kuyaita kwa majina yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lakini mwanadamu, licha ya utajiri wake, hadumu;","poem":1},{"text":"anafanana na mnyama aangamiaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hii ndiyo hatima ya wale wanaojitumainia wenyewe,","poem":1},{"text":"pia ya wafuasi wao, waliothibitisha misemo yao.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kama kondoo, wamewekewa kwenda kaburini,","poem":1},{"noteId":7},{"text":"nacho kifo kitawala.","poem":2},{"text":"Wanyofu watawatawala asubuhi,","poem":1},{"text":"maumbile yao yataozea kaburini,","poem":2},{"lineBreak":true},{"text":"mbali na majumba yao makubwa ya fahari.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lakini Mungu atakomboa uhai","poem":1},{"noteId":8},{"text":"wangu na kaburi,","poem":1},{"text":"hakika atanichukua kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Usitishwe mtu anapotajirika,","poem":1},{"text":"fahari ya nyumba yake inapoongezeka,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kwa maana hatachukua chochote atakapokufa,","poem":1},{"text":"fahari yake haitashuka pamoja naye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ingawa alipokuwa akiishi alijihesabu kuwa heri,","poem":1},{"text":"na wanadamu wanakusifu unapofanikiwa,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"atajiunga na kizazi cha baba zake,","poem":1},{"text":"ambao hawataona kamwe nuru ya uzima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mwanadamu mwenye utajiri bila ufahamu","poem":1},{"text":"ni kama wanyama waangamiao.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Kaburini hapa ina maana ya Sheol kwa Kiebrania, yaani Kuzimu.","reference":{"chapter":49,"verse":14}},{"noteId":8,"caller":"+","text":"Au: nafsi.","reference":{"chapter":49,"verse":15}}]},"thisChapterLink":"/api/swh_bib/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}