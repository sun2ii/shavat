{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"heading","content":["Sala Kwa Ajili Ya Ulinzi Wakati Wa Hatari"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa filimbi. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, tegea sikio maneno yangu,","poem":1},{"text":"uangalie kupiga kite kwangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sikiliza kilio changu ili unisaidie,","poem":1},{"text":"Mfalme wangu na Mungu wangu,","poem":2},{"lineBreak":true},{"text":"kwa maana kwako ninaomba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asubuhi, unasikia sauti yangu, Ee Bwana;","poem":1},{"text":"asubuhi naleta haja zangu mbele zako,","poem":2},{"lineBreak":true},{"text":"na kusubiri kwa matumaini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wewe si Mungu unayefurahia uovu,","poem":1},{"text":"kwako mtu mwovu hataishi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wenye kiburi hawawezi kusimama mbele yako,","poem":1},{"text":"unawachukia wote watendao mabaya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unawaangamiza wasemao uongo.","poem":1},{"text":"Bwana huwachukia","poem":2},{"lineBreak":true},{"text":"wamwagao damu na wadanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lakini mimi, kwa rehema zako kuu,","poem":1},{"text":"nitakuja katika nyumba yako,","poem":2},{"text":"kwa unyenyekevu, nitasujudu","poem":1},{"text":"kuelekea Hekalu lako takatifu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niongoze katika haki yako, Ee Bwana,","poem":1},{"text":"kwa sababu ya adui zangu,","poem":2},{"lineBreak":true},{"text":"nyoosha njia yako mbele yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hakuna neno kinywani mwao linaloweza kuaminika,","poem":1},{"text":"mioyo yao imejaa maangamizi.","poem":2},{"text":"Koo lao ni kaburi lililo wazi,","poem":1},{"text":"kwa ndimi zao, wao hunena udanganyifu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uwatangaze kuwa wenye hatia, Ee Mungu!","poem":1},{"text":"Hila zao ziwe anguko lao wenyewe.","poem":2},{"text":"Wafukuzie mbali kwa sababu ya dhambi zao nyingi,","poem":1},{"text":"kwa kuwa wamekuasi wewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakini wote wakimbiliao kwako na wafurahi,","poem":1},{"text":"waimbe kwa shangwe daima.","poem":2},{"text":"Ueneze ulinzi wako juu yao,","poem":1},{"text":"ili wale wapendao jina lako","poem":2},{"lineBreak":true},{"text":"wapate kukushangilia.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa hakika, Ee Bwana, unawabariki wenye haki,","poem":1},{"text":"unawazunguka kwa wema wako kama ngao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}