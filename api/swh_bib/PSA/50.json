{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"heading","content":["Ibada Ya Kweli"]},{"type":"hebrew_subtitle","content":["Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mwenye Nguvu, Mungu, Bwana,","poem":1},{"text":"asema na kuiita dunia,","poem":2},{"text":"tangu mawio ya jua","poem":1},{"text":"hadi mahali pake liendapo kutua.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kutoka Sayuni, penye uzuri mkamilifu,","poem":1},{"text":"Mungu anaangaza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mungu wetu anakuja na hatakaa kimya,","poem":1},{"text":"moto uteketezao unamtangulia,","poem":2},{"lineBreak":true},{"text":"akiwa amezungukwa na tufani kali.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anaziita mbingu zilizo juu,","poem":1},{"text":"na nchi, ili aweze kuwahukumu watu wake:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Nikusanyieni watu wangu waliowekwa wakfu,","poem":1},{"text":"waliofanya agano nami kwa dhabihu.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nazo mbingu zinatangaza haki yake,","poem":1},{"text":"kwa maana Mungu mwenyewe ni hakimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Sikieni, enyi watu wangu, nami nitasema,","poem":1},{"text":"ee Israeli, nami nitashuhudia dhidi yenu:","poem":2},{"lineBreak":true},{"text":"Mimi ndimi Mungu, Mungu wenu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sikukemei kwa sababu ya dhabihu zako,","poem":1},{"text":"au sadaka zako za kuteketezwa,","poem":2},{"lineBreak":true},{"text":"ambazo daima ziko mbele zangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sina haja ya fahali wa banda lako,","poem":1},{"text":"au mbuzi wa zizi lako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa maana kila mnyama wa msituni ni wangu,","poem":1},{"text":"na pia makundi ya mifugo juu ya vilima elfu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ninamjua kila ndege mlimani,","poem":1},{"text":"nao viumbe wa kondeni ni wangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kama ningekuwa na njaa, nisingewaambia ninyi,","poem":1},{"text":"kwa maana ulimwengu ni wangu,","poem":2},{"lineBreak":true},{"text":"pamoja na vyote vilivyomo ndani yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Je, mimi hula nyama ya mafahali","poem":1},{"text":"au kunywa damu ya mbuzi?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Toa sadaka za shukrani kwa Mungu,","poem":1},{"text":"timiza nadhiri zako kwake Yeye Aliye Juu Sana,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"na uniite siku ya taabu;","poem":1},{"text":"nami nitakuokoa, nawe utanitukuza.”","poem":2}]},{"type":"verse","number":16,"content":["Lakini kwake mtu mwovu, Mungu asema:",{"text":"“Una haki gani kunena sheria zangu","poem":1},{"text":"au kuchukua agano langu midomoni mwako?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unachukia mafundisho yangu","poem":1},{"text":"na kuyatupa maneno yangu nyuma yako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Unapomwona mwizi, unaungana naye,","poem":1},{"text":"unapiga kura yako pamoja na wazinzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Unakitumia kinywa chako kwa mabaya","poem":1},{"text":"na kuuongoza ulimi wako kwa hila.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wanena daima dhidi ya ndugu yako","poem":1},{"text":"na kumsingizia mwana wa mama yako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mambo haya unayafanya, nami nimekaa kimya,","poem":1},{"text":"ukafikiri Mimi nami ni kama wewe.","poem":2},{"text":"Lakini nitakukemea","poem":1},{"text":"na kuweka mashtaka mbele yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Yatafakarini haya, ninyi mnaomsahau Mungu,","poem":1},{"text":"ama sivyo nitawararua vipande vipande,","poem":2},{"lineBreak":true},{"text":"wala hapatakuwepo na yeyote wa kuwaokoa:","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Atoaye dhabihu za shukrani ananiheshimu mimi,","poem":1},{"text":"naye aiandaa njia yake","poem":2},{"lineBreak":true},{"text":"ili nimwonyeshe wokovu wa Mungu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}