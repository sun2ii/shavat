{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"heading","content":["Hukumu Ya Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Utenzi wa Daudi. Baada ya Doegi, Mwedomu kumwendea Sauli na kumjulisha kuwa: “Daudi amekwenda nyumbani kwa Ahimeleki.”"]},{"type":"verse","number":1,"content":[{"text":"Ewe jitu, mbona unajivunia ubaya?","poem":1},{"text":"Kwa nini unajivuna mchana kutwa,","poem":2},{"lineBreak":true},{"text":"wewe ambaye ni fedheha mbele za Mungu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ulimi wako hupanga mashauri mabaya ya maangamizi.","poem":1},{"text":"Ni kama wembe mkali, ninyi mfanyao hila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unapenda mabaya kuliko mema,","poem":1},{"text":"uongo kuliko kusema kweli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unapenda kila neno lenye kudhuru,","poem":1},{"text":"ewe ulimi wenye hila!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hakika Mungu atakushusha chini","poem":1},{"text":"kwa maangamizi ya milele:","poem":2},{"text":"atakunyakua na kukuondoa kwa nguvu","poem":1},{"text":"kutoka hema yako,","poem":2},{"lineBreak":true},{"text":"atakungʼoa kutoka nchi ya walio hai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wenye haki wataona na kuogopa,","poem":1},{"text":"watamcheka, wakisema,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Huyu ni yule mtu ambaye","poem":1},{"text":"hakumfanya Mungu kuwa ngome yake,","poem":2},{"text":"bali alitumainia wingi wa utajiri wake,","poem":1},{"text":"na akawa hodari kwa kuwaangamiza wengine!”","poem":2}]},{"type":"heading","content":["Neema Ya Mungu"]},{"type":"verse","number":8,"content":[{"text":"Lakini mimi ni kama mti wa mzeituni","poem":1},{"text":"unaostawi katika nyumba ya Mungu,","poem":2},{"text":"nautegemea upendo wa Mungu usiokoma","poem":1},{"text":"milele na milele.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nitakusifu milele kwa yale uliyoyatenda,","poem":1},{"text":"nitatumaini jina lako, kwa kuwa jina lako ni jema.","poem":2},{"lineBreak":true},{"text":"Nitakusifu mbele ya watakatifu wako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}