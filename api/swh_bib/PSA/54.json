{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Kuomba Ulinzi Wa Mungu Kutokana Na Adui"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Na ala za nyuzi za uimbaji. Utenzi wa Daudi. Wakati Wazifu walimwendea Sauli na kumjulisha, “Je, Daudi hajifichi miongoni mwetu?”"]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu uniokoe kwa jina lako,","poem":1},{"text":"unifanyie hukumu kwa uwezo wako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Mungu, sikia maombi yangu,","poem":1},{"text":"usikilize maneno ya kinywa changu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wageni wananishambulia,","poem":1},{"text":"watu wakatili wanayatafuta maisha yangu,","poem":2},{"lineBreak":true},{"text":"watu wasiomjali Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hakika Mungu ni msaada wangu,","poem":1},{"text":"Bwana ndiye anayenitegemeza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mabaya na yawarudie wale wanaonisingizia,","poem":1},{"text":"kwa uaminifu wako uwaangamize.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nitakutolea dhabihu za hiari;","poem":1},{"text":"Ee Bwana, nitalisifu jina lako","poem":2},{"lineBreak":true},{"text":"kwa kuwa ni vyema.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa maana ameniokoa katika shida zangu zote,","poem":1},{"text":"na macho yangu yamewatazama adui zangu kwa ushindi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}