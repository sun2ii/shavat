{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["Kuomba Msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa “Usiharibu!” Utenzi wa Daudi. Baada ya kumponyoka Sauli pangoni."]},{"type":"verse","number":1,"content":[{"text":"Unihurumie, Ee Mungu, unihurumie,","poem":1},{"text":"kwa maana nafsi yangu inakukimbilia.","poem":2},{"text":"Chini ya uvuli wa mbawa zako nitakimbilia","poem":1},{"text":"mpaka maafa yapite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Namlilia Mungu Aliye Juu Sana,","poem":1},{"text":"Mungu atimizaye makusudi yake kwangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hutumana kutoka mbinguni na kuniokoa,","poem":1},{"text":"akiwakemea wale wanaonifuatilia vikali;","poem":2},{"lineBreak":true},{"text":"Mungu huutuma upendo wake na uaminifu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Niko katikati ya simba,","poem":1},{"text":"nimelala katikati ya wanyama wenye njaa kuu:","poem":2},{"lineBreak":true},{"text":"watu ambao meno yao ni mikuki na mishale,","poem":2},{"lineBreak":true},{"text":"ambao ndimi zao ni panga kali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mungu, utukuzwe juu ya mbingu,","poem":1},{"text":"utukufu wako na uenee duniani kote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waliitegea miguu yangu nyavu,","poem":1},{"text":"nikainamishwa chini na dhiki.","poem":2},{"text":"Wamechimba shimo katika njia yangu,","poem":1},{"text":"lakini wametumbukia humo wao wenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mungu, moyo wangu ni thabiti;","poem":1},{"text":"nitaimba na kusifu kwa moyo wangu wote.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amka, nafsi yangu!","poem":1},{"text":"Amka, kinubi na zeze!","poem":2},{"lineBreak":true},{"text":"Nitayaamsha mapambazuko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nitakusifu wewe, Ee Bwana, katikati ya mataifa;","poem":1},{"text":"nitaimba habari zako, katikati ya jamaa za watu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa maana upendo wako ni mkuu, waenea hadi mbinguni,","poem":1},{"text":"uaminifu wako unazifikia anga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Mungu, utukuzwe juu mbinguni,","poem":1},{"text":"utukufu wako na uwe duniani pote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}