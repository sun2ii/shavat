{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"heading","content":["Kuomba Ulinzi Wa Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa “Usiharibu!” Utenzi wa Daudi. Wakati Sauli alipotuma wapelelezi nyumbani mwa Daudi ili wamuue."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, uniokoe na adui zangu,","poem":1},{"text":"unilinde kutokana na hao wanaoinuka dhidi yangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Uniponye na watu watendao mabaya,","poem":1},{"text":"uniokoe kutokana na wamwagao damu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Tazama wanavyonivizia!","poem":1},{"text":"Watu wakali wananifanyia hila,","poem":2},{"text":"ingawa Ee Bwana, mimi sijakosea","poem":1},{"text":"wala kutenda dhambi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sijatenda kosa; hata hivyo wako tayari kunishambulia.","poem":1},{"text":"Inuka unisaidie, uone hali yangu mbaya!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Bwana Mwenye Nguvu Zote, Mungu wa Israeli!","poem":1},{"text":"Zinduka uyaadhibu mataifa yote,","poem":2},{"lineBreak":true},{"text":"usionyeshe huruma kwa wasaliti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hurudi wakati wa jioni,","poem":1},{"text":"wakibweka kama mbwa,","poem":2},{"lineBreak":true},{"text":"wakiuzurura mji.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tazama yale wanayotema kutoka vinywa vyao,","poem":1},{"text":"hutema upanga kutoka midomo yao,","poem":2},{"lineBreak":true},{"text":"nao husema, “Ni nani atakayetusikia?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lakini wewe, Bwana, uwacheke;","poem":1},{"text":"unayadharau mataifa hayo yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee nguvu yangu, ninakutazama wewe,","poem":1},{"text":"wewe, Ee Mungu, ndiwe ngome yangu,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mungu wangu unipendaye.","poem":2},{"lineBreak":true},{"text":"Mungu atanitangulia,","poem":1},{"text":"naye atanifanya niwachekelee","poem":2},{"lineBreak":true},{"text":"wale wanaonisingizia.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lakini usiwaue, Ee Bwana, ngao yetu,","poem":1},{"text":"au sivyo watu wangu watasahau.","poem":2},{"text":"Katika uwezo wako wafanye watangetange","poem":1},{"text":"na uwashushe chini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa ajili ya dhambi za vinywa vyao,","poem":1},{"text":"kwa ajili ya maneno ya midomo yao,","poem":2},{"lineBreak":true},{"text":"waache wanaswe katika kiburi chao.","poem":2},{"text":"Kwa ajili ya laana na uongo wanaotamka,","poem":1}]},{"type":"verse","number":13,"content":[{"text":"wateketeze katika ghadhabu,","poem":2},{"lineBreak":true},{"text":"wateketeze hadi wasiwepo tena.","poem":2},{"text":"Ndipo itakapofahamika katika miisho ya dunia","poem":1},{"text":"kwamba Mungu anatawala juu ya Yakobo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hurudi jioni,","poem":1},{"text":"wakibweka kama mbwa,","poem":2},{"lineBreak":true},{"text":"wakiuzurura mji.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wanatangatanga wakitafuta chakula,","poem":1},{"text":"wasipotosheka hubweka kama mbwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lakini mimi nitaziimba nguvu zako,","poem":1},{"text":"asubuhi nitaimba juu ya upendo wako;","poem":2},{"text":"kwa maana wewe ndiwe ngome yangu","poem":1},{"text":"na kimbilio langu wakati wa shida.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee uliye Nguvu zangu, ninakuimbia sifa.","poem":1},{"text":"Wewe, Ee Mungu, ndiwe ngome yangu,","poem":2},{"lineBreak":true},{"text":"Mungu unipendaye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}