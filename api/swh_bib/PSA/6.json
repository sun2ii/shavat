{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"heading","content":["Sala Kwa Ajili Ya Msaada Wakati Wa Taabu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa ala za nyuzi za muziki. Mtindo wa sheminithi.",{"noteId":0},"Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, usinikemee katika hasira yako,","poem":1},{"text":"wala usiniadhibu katika ghadhabu yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unirehemu Bwana,","poem":1},{"text":"kwa maana nimedhoofika;","poem":2},{"text":"Ee Bwana, uniponye,","poem":1},{"text":"kwa maana mifupa yangu","poem":2},{"lineBreak":true},{"text":"ina maumivu makali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nafsi yangu ina uchungu mwingi.","poem":1},{"text":"Mpaka lini, Ee Bwana, mpaka lini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Geuka Ee Bwana, unikomboe,","poem":1},{"text":"uniokoe kwa sababu ya fadhili zako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hakuna mtu anayekukumbuka","poem":1},{"text":"akiwa amekufa.","poem":2},{"text":"Ni nani awezaye kukusifu","poem":1},{"text":"akiwa kuzimu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nimechakaa kwa kulia kwa huzuni;","poem":1},{"text":"usiku kucha nafurikisha","poem":2},{"lineBreak":true},{"text":"kitanda changu kwa machozi;","poem":2},{"text":"nimelowesha viti vyangu vya fahari","poem":1},{"text":"kwa machozi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Macho yangu yamedhoofika kwa kuhuzunika,","poem":1},{"text":"yamedhoofika kwa sababu ya adui zangu wote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kaeni mbali nami, ninyi nyote mtendao mabaya,","poem":1},{"text":"kwa maana Bwana amesikia kulia kwangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bwana amesikia kilio changu kwa huruma,","poem":1},{"text":"Bwana amekubali sala yangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Adui zangu wote wataaibika na kufadhaika,","poem":1},{"text":"watarudi nyuma kwa aibu ya ghafula.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Sheminithi ni mtajo mmojawapo katika lugha ya uimbaji.","reference":{"chapter":6,"verse":0}}]},"thisChapterLink":"/api/swh_bib/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}