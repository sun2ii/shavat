{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Kuomba Ulinzi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa ala za nyuzi za uimbaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, sikia kilio changu,","poem":1},{"text":"usikilize maombi yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kutoka miisho ya dunia ninakuita,","poem":1},{"text":"ninaita huku moyo wangu unadhoofika;","poem":2},{"text":"uniongoze kwenye mwamba","poem":1},{"text":"ule ulio juu kuliko mimi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa umekuwa kimbilio langu,","poem":1},{"text":"ngome imara dhidi ya adui.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Natamani kukaa hemani mwako milele,","poem":1},{"text":"na kukimbilia chini ya uvuli wa mbawa zako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mungu, kwa kuwa umesikia nadhiri zangu,","poem":1},{"text":"umenipa urithi wa wale wanaoliogopa jina lako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mwongezee mfalme siku za maisha yake,","poem":1},{"text":"miaka yake kwa vizazi vingi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeye na atawazwe kwenye kiti cha enzi mbele za Mungu milele;","poem":1},{"text":"amuru upendo wako na uaminifu wako vimlinde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndipo daima nitaliimbia sifa jina lako","poem":1},{"text":"na kuzitimiza nadhiri zangu siku baada ya siku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}