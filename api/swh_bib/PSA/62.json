{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"heading","content":["Mungu Kimbilio La Pekee"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa Yeduthuni. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Kwa Mungu peke yake nafsi yangu inapata pumziko;","poem":1},{"text":"wokovu wangu watoka kwake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yeye peke yake ndiye mwamba wangu na wokovu wangu;","poem":1},{"lineBreak":true},{"text":"yeye ni ngome yangu, sitatikisika kamwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mtamshambulia mtu hata lini?","poem":1},{"text":"Je, ninyi nyote mtamtupa chini,","poem":2},{"lineBreak":true},{"text":"ukuta huu ulioinama na uzio huu unaotikisika?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Walikusudia kikamilifu kumwangusha","poem":1},{"text":"toka mahali pake pa fahari;","poem":2},{"lineBreak":true},{"text":"wanafurahia uongo.","poem":2},{"text":"Kwa vinywa vyao hubariki,","poem":1},{"text":"lakini ndani ya mioyo yao hulaani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee nafsi yangu, upumzike, kwa Mungu peke yake,","poem":1},{"text":"tumaini langu latoka kwake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeye peke yake ndiye mwamba wangu na wokovu wangu;","poem":1},{"text":"ndiye ngome yangu, sitatikisika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wokovu wangu na heshima yangu viko kwa Mungu,","poem":1},{"text":"ndiye mwamba wangu wenye nguvu","poem":2},{"lineBreak":true},{"text":"na kimbilio langu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enyi watu, mtumainini yeye wakati wote,","poem":1},{"text":"miminieni mioyo yenu kwake,","poem":2},{"lineBreak":true},{"text":"kwa kuwa Mungu ni kimbilio letu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Binadamu wa ngazi ya chini ni pumzi tu,","poem":1},{"text":"nao wa ngazi ya juu ni uongo tu;","poem":2},{"text":"wakipimwa kwenye mizani, si chochote;","poem":1},{"text":"wote kwa pamoja ni pumzi tu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Usitumainie vya udhalimu","poem":1},{"text":"wala usijivune kwa vitu vya wizi;","poem":2},{"text":"ingawa utajiri wako utaongezeka,","poem":1},{"text":"usiviwekee moyo wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jambo moja Mungu amelisema,","poem":1},{"text":"mambo mawili nimeyasikia:","poem":2},{"text":"kwamba, Ee Mungu,","poem":1},{"text":"wewe una nguvu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"na kwamba, Ee Bwana,","poem":1},{"text":"wewe ni mwenye upendo.","poem":2},{"text":"Hakika utampa kila mtu thawabu","poem":1},{"text":"kwa kadiri ya alivyotenda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}