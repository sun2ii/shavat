{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["Shauku Kwa Ajili Ya Uwepo Wa Mungu"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi. Wakati alipokuwa katika Jangwa la Yuda."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, wewe ni Mungu wangu,","poem":1},{"text":"nakutafuta kwa moyo wote;","poem":2},{"text":"nafsi yangu inakuonea kiu,","poem":1},{"text":"mwili wangu unakuonea wewe shauku,","poem":2},{"text":"katika nchi kame na iliyochoka","poem":1},{"text":"mahali ambapo hapana maji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nimekuona katika mahali patakatifu","poem":1},{"text":"na kuuona uwezo wako na utukufu wako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa sababu upendo wako ni bora kuliko uhai,","poem":1},{"text":"midomo yangu itakuadhimisha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nitakusifu siku zote za maisha yangu,","poem":1},{"text":"na kwa jina lako nitainua mikono yangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nafsi yangu itatoshelezwa","poem":1},{"text":"kama kwa wingi wa vyakula;","poem":2},{"text":"kwa midomo iimbayo","poem":1},{"text":"kinywa changu kitakusifu wewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kitandani mwangu ninakukumbuka wewe,","poem":1},{"text":"ninawaza juu yako makesha yote ya usiku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa sababu wewe ndiwe msaada wangu,","poem":1},{"text":"chini ya uvuli wa mbawa zako naimba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nafsi yangu inaambatana nawe,","poem":1},{"text":"mkono wako wa kuume hunishika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wale wanaotafuta uhai wangu wataharibiwa,","poem":1},{"text":"watakwenda chini kwenye vilindi vya dunia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watatolewa wafe kwa upanga,","poem":1},{"text":"nao watakuwa chakula cha mbweha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bali mfalme atafurahi katika Mungu,","poem":1},{"text":"wale wote waapao kwa jina la Mungu watamsifu,","poem":2},{"lineBreak":true},{"text":"bali vinywa vya waongo vitanyamazishwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}