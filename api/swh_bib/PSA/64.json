{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["Kuomba Ulinzi Dhidi Ya Maadui"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, unisikie ninapoeleza lalamiko langu,","poem":1},{"text":"uyahifadhi maisha yangu kutokana na vitisho vya adui.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unifiche kutokana na shauri la siri la waovu,","poem":1},{"text":"kutokana na zile kelele za kundi la watenda mabaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wananoa ndimi zao kama panga","poem":1},{"text":"na kuelekeza maneno yao kama mishale ya kufisha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hurusha mishale kutoka kwenye mavizio kwa mtu asiye na hatia,","poem":1},{"text":"humrushia ghafula bila woga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kila mmoja humtia moyo mwenzake","poem":1},{"text":"katika mipango mibaya;","poem":2},{"text":"huzungumza juu ya kuficha mitego yao,","poem":1},{"text":"nao husema, “Ni nani ataiona?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hufanya shauri baya la dhuluma na kusema,","poem":1},{"text":"“Tumebuni mpango mkamilifu!”","poem":2},{"lineBreak":true},{"text":"Hakika nia na moyo wa mwanadamu vina hila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bali Mungu atawapiga kwa mishale,","poem":1},{"text":"nao ghafula wataangushwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Atageuza ndimi zao wenyewe dhidi yao","poem":1},{"text":"na kuwaleta kwenye maangamizi;","poem":2},{"text":"wote wawaonao watatikisa vichwa vyao","poem":1},{"text":"kwa dharau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wanadamu wote wataogopa,","poem":1},{"text":"watatangaza kazi za Mungu","poem":2},{"lineBreak":true},{"text":"na kutafakari yale aliyoyatenda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wenye haki na wafurahi katika Bwana,","poem":1},{"text":"na wakimbilie kwake;","poem":2},{"lineBreak":true},{"text":"wanyofu wote wa moyo na wamsifu yeye!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}