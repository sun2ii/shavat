{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"heading","content":["Kusifu Na Kushukuru"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi. Wimbo."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, sifa zakungojea katika Sayuni;","poem":1},{"text":"kwako wewe nadhiri zetu zitatimizwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ewe usikiaye maombi,","poem":1},{"text":"kwako wewe watu wote watakuja.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tulipokuwa tumefunikwa kabisa na dhambi,","poem":1},{"text":"wewe ulisamehe makosa yetu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Heri wale uliowachagua","poem":1},{"text":"na kuwaleta karibu ili waishi katika nyua zako!","poem":2},{"text":"Tunashibishwa kwa mema ya nyumba yako,","poem":1},{"text":"mema ya Hekalu lako takatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Unatujibu kwa matendo ya kushangaza ya haki,","poem":1},{"text":"Ee Mungu Mwokozi wetu,","poem":2},{"text":"tumaini la miisho yote ya duniani","poem":1},{"text":"na la bahari zilizo mbali sana,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"uliyeumba milima kwa uwezo wako,","poem":1},{"text":"ukiwa umejivika nguvu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"uliyenyamazisha dhoruba za bahari,","poem":1},{"text":"ngurumo za mawimbi yake,","poem":2},{"lineBreak":true},{"text":"na ghasia za mataifa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wale wanaoishi mbali sana","poem":1},{"text":"wanaogopa maajabu yako,","poem":2},{"text":"kule asubuhi ipambazukiapo","poem":1},{"text":"na kule jioni inakofifilia","poem":2},{"lineBreak":true},{"text":"umeziita nyimbo za furaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Waitunza nchi na kuinyeshea,","poem":1},{"text":"waitajirisha kwa wingi.","poem":2},{"text":"Vijito vya Mungu vimejaa maji","poem":1},{"text":"ili kuwapa watu nafaka,","poem":2},{"lineBreak":true},{"text":"kwa maana wewe umeviamuru.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Umeilowesha mifereji yake","poem":1},{"text":"na kusawazisha kingo zake;","poem":2},{"text":"umeilainisha kwa manyunyu","poem":1},{"text":"na kuibariki mimea yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Umeuvika mwaka taji ya baraka,","poem":1},{"text":"magari yako yanafurika kwa wingi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mbuga za majani za jangwani umezineemesha;","poem":1},{"text":"vilima vimevikwa furaha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Penye nyanda za malisho pamejaa makundi ya wanyama,","poem":1},{"text":"na mabonde yamepambwa kwa mavuno;","poem":2},{"lineBreak":true},{"text":"vyote vinashangilia kwa furaha na kuimba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}