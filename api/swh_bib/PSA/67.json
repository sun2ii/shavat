{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Mataifa Yahimizwa Kumsifu Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Na ala za nyuzi za muziki. Zaburi. Wimbo."]},{"type":"verse","number":1,"content":[{"text":"Mungu aturehemu na kutubariki,","poem":1},{"text":"na kutuangazia nuru za uso wake,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ili njia zako zijulikane duniani,","poem":1},{"text":"wokovu wako katikati ya mataifa yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Mungu, mataifa na wakusifu,","poem":1},{"text":"mataifa yote na wakusifu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mataifa yote wafurahi na kuimba kwa shangwe,","poem":1},{"text":"kwa kuwa unatawala watu kwa haki","poem":2},{"lineBreak":true},{"text":"na kuongoza mataifa ya dunia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mungu, mataifa na wakusifu,","poem":1},{"text":"mataifa yote na wakusifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndipo nchi itatoa mazao yake,","poem":1},{"text":"naye Mungu, Mungu wetu, atatubariki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mungu atatubariki","poem":1},{"text":"na miisho yote ya dunia itamcha yeye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}