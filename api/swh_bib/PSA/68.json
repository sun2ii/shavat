{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"heading","content":["Wimbo Wa Taifa Wa Shangwe Kwa Ushindi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi. Wimbo."]},{"type":"verse","number":1,"content":[{"text":"Mungu na ainuke, watesi wake watawanyike,","poem":1},{"text":"adui zake na wakimbie mbele zake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama vile moshi upeperushwavyo na upepo,","poem":1},{"text":"vivyo hivyo uwapeperushe mbali,","poem":2},{"text":"kama vile nta iyeyukavyo kwenye moto,","poem":1},{"text":"vivyo hivyo waovu na waangamie mbele za Mungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bali wenye haki na wafurahi,","poem":1},{"text":"washangilie mbele za Mungu,","poem":2},{"lineBreak":true},{"text":"wafurahi na kushangilia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwimbieni Mungu, liimbieni sifa jina lake,","poem":1},{"text":"mtukuzeni yeye aendeshwaye juu ya mawingu:","poem":2},{"text":"jina lake ni Bwana,","poem":1},{"text":"furahini mbele zake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baba wa yatima, mtetezi wa wajane,","poem":1},{"text":"ni Mungu katika makao yake matakatifu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mungu huwaweka wapweke katika jamaa,","poem":1},{"text":"huwaongoza wafungwa wakiimba,","poem":2},{"lineBreak":true},{"text":"bali waasi huishi katika nchi kame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mungu, ulipowatangulia watu wako,","poem":1},{"text":"ulipopita nyikani,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"dunia ilitikisika,","poem":1},{"text":"mbingu zikanyesha mvua,","poem":2},{"text":"mbele za Mungu, Yule wa Sinai,","poem":1},{"text":"mbele za Mungu, Mungu wa Israeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mungu, ulinyesha mvua nyingi","poem":1},{"text":"na kuiburudisha ardhi iliyokuwa imechoka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Mungu, watu wako waliishi huko,","poem":1},{"text":"nawe kwa wingi wa utajiri wako","poem":2},{"lineBreak":true},{"text":"uliwapa maskini mahitaji yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bwana alitangaza neno,","poem":1},{"text":"waliolitangaza neno hilo walikuwa kundi kubwa:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Wafalme na majeshi walikimbia upesi,","poem":1},{"text":"watu waliobaki kambini waligawana nyara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hata ulalapo katikati ya mioto ya kambini,","poem":1},{"text":"mabawa ya njiwa wangu yamefunikwa kwa fedha,","poem":2},{"lineBreak":true},{"text":"manyoya yake kwa dhahabu ingʼaayo.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wakati Mwenyezi","poem":1},{"noteId":9},{"text":"alipowatawanya wafalme katika nchi,","poem":1},{"text":"ilikuwa kama theluji iliyoanguka juu ya Salmoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Milima ya Bashani ni milima iliyotukuka,","poem":1},{"text":"milima ya Bashani ina vilele vilivyochongoka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enyi milima yenye vilele vilivyochongoka,","poem":1},{"text":"kwa nini mnakazia macho kwa wivu,","poem":2},{"text":"katika mlima Mungu anaochagua kutawala,","poem":1},{"text":"ambako Bwana mwenyewe ataishi milele?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Magari ya Mungu ni makumi ya maelfu,","poem":1},{"text":"na maelfu ya maelfu;","poem":2},{"text":"Bwana amekuja kutoka Sinai","poem":1},{"text":"hadi katika patakatifu pake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ulipopanda juu, uliteka mateka,","poem":1},{"text":"ukapokea vipawa kutoka kwa wanadamu,","poem":2},{"text":"hata kutoka kwa wale walioasi,","poem":1},{"text":"ili wewe, Ee Bwana Mungu, upate kuishi huko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Sifa apewe Bwana, Mungu Mwokozi wetu,","poem":1},{"text":"ambaye siku kwa siku hutuchukulia mizigo yetu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mungu wetu ni Mungu aokoaye,","poem":1},{"text":"Bwana Mwenyezi hutuokoa na kifo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hakika Mungu ataponda vichwa vya adui zake,","poem":1},{"text":"vichwa vya hao waendao katika njia za dhambi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bwana alisema, “Nitawarudisha kutoka Bashani;","poem":1},{"text":"nitawarudisha kutoka vilindi vya bahari,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ili uweze kuchovya miguu yako katika damu ya adui zako,","poem":1},{"text":"huku ndimi za mbwa wako zikiwa na fungu lake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ee Mungu, maandamano yako yameonekana,","poem":1},{"text":"maandamano ya Mungu wangu, Mfalme wangu,","poem":2},{"lineBreak":true},{"text":"yakielekea patakatifu pake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mbele wako waimbaji, baada yao wapiga vinanda,","poem":1},{"text":"pamoja nao wako wanawali wakipiga matari.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Msifuni Mungu katika kusanyiko kubwa,","poem":1},{"text":"msifuni Bwana katika kusanyiko la Israeli.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Liko kabila dogo la Benyamini likiwaongoza,","poem":1},{"text":"wakifuatwa na kundi kubwa la watawala wa Yuda,","poem":2},{"lineBreak":true},{"text":"hatimaye watawala wa Zabuloni na Naftali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ee Mungu, amuru uwezo wako,","poem":1},{"text":"Ee Mungu tuonyeshe nguvu zako,","poem":2},{"lineBreak":true},{"text":"kama ulivyofanya hapo awali.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kwa sababu ya Hekalu lako Yerusalemu","poem":1},{"text":"wafalme watakuletea zawadi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mkemee mnyama aliyeko kwenye manyasi,","poem":1},{"text":"kundi la mafahali katikati ya ndama za mataifa.","poem":2},{"text":"Na walete minara ya madini ya fedha wakinyenyekea.","poem":1},{"text":"Tawanya mataifa yapendayo vita.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Wajumbe watakuja kutoka Misri,","poem":1},{"text":"Kushi","poem":2},{"noteId":10},{"text":"atajisalimisha kwa Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Mwimbieni Mungu, enyi falme za dunia,","poem":1},{"text":"mwimbieni Bwana sifa,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"mwimbieni sifa yeye apandaye mbingu za kale zilizo juu,","poem":1},{"text":"yeye angurumaye kwa sauti kuu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Tangazeni uwezo wa Mungu,","poem":1},{"text":"ambaye fahari yake iko juu ya Israeli,","poem":2},{"lineBreak":true},{"text":"ambaye uwezo wake uko katika anga.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ee Mungu, wewe unatisha katika mahali patakatifu pako,","poem":1},{"text":"Mungu wa Israeli huwapa watu wake uwezo na nguvu.","poem":2},{"lineBreak":true},{"text":"Mungu Asifiwe!","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"Mwenyezi hapa ina maana ya Shaddai kwa Kiebrania.","reference":{"chapter":68,"verse":14}},{"noteId":10,"caller":"+","text":"Kushi hapa ina maana maeneo ya Naili ya juu, yaani Ethiopia.","reference":{"chapter":68,"verse":31}}]},"thisChapterLink":"/api/swh_bib/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}