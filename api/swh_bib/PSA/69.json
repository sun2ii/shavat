{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"heading","content":["Kilio Cha Kuomba Msaada Wakati Wa Dhiki"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa “Yungiyungi.” Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, niokoe,","poem":1},{"text":"kwa maana maji yamenifika shingoni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ninazama kwenye vilindi vya matope,","poem":1},{"text":"pasipo mahali pa kukanyaga,","poem":2},{"text":"Nimefika kwenye maji makuu,","poem":1},{"text":"mafuriko yamenigharikisha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nimechoka kwa kuomba msaada,","poem":1},{"text":"koo langu limekauka.","poem":2},{"text":"Macho yangu yanafifia,","poem":1},{"text":"nikimtafuta Mungu wangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wale wanaonichukia bila sababu","poem":1},{"text":"ni wengi kuliko nywele za kichwa changu;","poem":2},{"text":"wengi ni adui kwangu bila sababu,","poem":1},{"text":"wale wanaotafuta kuniangamiza.","poem":2},{"text":"Ninalazimishwa kurudisha","poem":1},{"text":"kitu ambacho sikuiba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mungu, wewe unajua upumbavu wangu,","poem":1},{"text":"wala hatia yangu haikufichika kwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ee Bwana, ewe Bwana Mwenye Nguvu Zote,","poem":1},{"text":"wakutumainio wasiaibishwe","poem":2},{"lineBreak":true},{"text":"kwa ajili yangu;","poem":2},{"text":"wakutafutao wasifedheheshwe kwa ajili yangu,","poem":1},{"text":"Ee Mungu wa Israeli.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa maana nimestahimili dharau kwa ajili yako,","poem":1},{"text":"aibu imefunika uso wangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nimekuwa mgeni kwa ndugu zangu,","poem":1},{"text":"mgeni kwa wana wa mama yangu mwenyewe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa kuwa wivu wa nyumba yako unanila,","poem":1},{"text":"matukano ya wale wanaokutukana yameniangukia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ninapolia na kufunga,","poem":1},{"text":"lazima nivumilie matusi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ninapovaa nguo ya gunia,","poem":1},{"text":"watu hunidharau.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wale wanaoketi mlangoni wananisimanga,","poem":1},{"text":"nimekuwa wimbo wa walevi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini Ee Bwana, ninakuomba,","poem":1},{"text":"kwa wakati ukupendezao;","poem":2},{"text":"katika upendo wako mkuu, Ee Mungu,","poem":1},{"text":"unijibu kwa wokovu wako wa hakika.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Uniokoe katika matope,","poem":1},{"text":"usiniache nizame;","poem":2},{"text":"niokoe na hao wanichukiao,","poem":1},{"text":"kutoka kwenye vilindi vya maji.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Usiache mafuriko yanigharikishe","poem":1},{"text":"au vilindi vinimeze,","poem":2},{"lineBreak":true},{"text":"au shimo lifumbe kinywa chake juu yangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Bwana, unijibu, kwa wema wa upendo wako;","poem":1},{"text":"kwa huruma zako nyingi unigeukie.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Usimfiche mtumishi wako uso wako,","poem":1},{"text":"uharakishe kunijibu, kwa sababu niko katika shida.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Njoo karibu uniokoe,","poem":1},{"text":"nikomboe kwa sababu ya adui zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Unajua jinsi ninavyodharauliwa,","poem":1},{"text":"kufedheheshwa na kuaibishwa,","poem":2},{"lineBreak":true},{"text":"adui zangu wote unawajua.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Dharau zimenivunja moyo","poem":1},{"text":"na nimekata tamaa,","poem":2},{"text":"nimetafuta wa kunihurumia, lakini sikumpata,","poem":1},{"text":"wa kunituliza, lakini sikumpata.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Waliweka nyongo katika chakula changu","poem":1},{"text":"na walinipa siki nilipokuwa na kiu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Meza iliyoandaliwa mbele yao na iwe mtego,","poem":1},{"text":"nayo iwe upatilizo na tanzi.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Macho yao yatiwe giza ili wasiweze kuona,","poem":1},{"text":"nayo migongo yao iinamishwe daima.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Uwamwagie ghadhabu yako,","poem":1},{"text":"hasira yako kali na iwapate.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mahali pao na pawe ukiwa,","poem":1},{"text":"wala asiwepo yeyote atakayeishi katika mahema yao.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kwa kuwa wanawatesa wale uliowajeruhi,","poem":1},{"text":"na kuzungumza juu ya maumivu ya wale uliowaumiza.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Walipize uovu juu ya uovu,","poem":1},{"text":"usiwaache washiriki katika wokovu wako.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wafutwe kutoka kitabu cha uzima","poem":1},{"text":"na wasiorodheshwe pamoja na wenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mimi niko katika maumivu na dhiki;","poem":1},{"text":"Ee Mungu, wokovu wako na unihifadhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nitalisifu jina la Mungu kwa wimbo,","poem":1},{"text":"nami nitamtukuza kwa kumtolea shukrani.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Hili litampendeza Bwana kuliko ngʼombe dume,","poem":1},{"text":"zaidi ya fahali akiwa na pembe na kwato zake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Maskini wataona na kufurahi:","poem":1},{"text":"ninyi mnaomtafuta Mungu, mioyo yenu na iishi!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bwana huwasikia wahitaji","poem":1},{"text":"wala hadharau watu wake waliotekwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Mbingu na dunia zimsifu,","poem":1},{"text":"bahari na vyote viendavyo ndani yake,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"kwa maana Mungu ataiokoa Sayuni","poem":1},{"text":"na kuijenga tena miji ya Yuda.","poem":2},{"text":"Kisha watu watafanya makao yao humo na kuimiliki,","poem":1}]},{"type":"verse","number":36,"content":[{"text":"watoto wa watumishi wake watairithi","poem":2},{"text":"na wale wote walipendao jina lake","poem":1},{"text":"wataishi humo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}