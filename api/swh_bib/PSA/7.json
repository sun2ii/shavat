{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"heading","content":["Sala Ya Mtu Anayedhulumiwa"]},{"type":"hebrew_subtitle","content":["Ombolezo la Daudi kwa Bwana kwa sababu ya Kushi, Mbenyamini."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, Mungu wangu, ninakukimbilia wewe,","poem":1},{"text":"uniokoe na kunikomboa na wote wanaonifuatia,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"la sivyo watanirarua kama simba","poem":1},{"text":"na kunichana vipande vipande, asiwepo wa kuniokoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Bwana, Mungu wangu, kama nimetenda haya","poem":1},{"text":"na kuna hatia mikononi mwangu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"au ikiwa nimemtenda uovu aliye na amani nami,","poem":1},{"text":"au nimemnyangʼanya adui yangu pasipo sababu,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"basi adui anifuatie na kunipata,","poem":1},{"text":"auponde uhai wangu ardhini","poem":2},{"lineBreak":true},{"text":"na kunilaza mavumbini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Amka kwa hasira yako, Ee Bwana,","poem":1},{"text":"inuka dhidi ya ghadhabu ya adui zangu.","poem":2},{"lineBreak":true},{"text":"Amka, Mungu wangu, uamue haki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kusanyiko la watu na likuzunguke.","poem":1},{"text":"Watawale kutoka juu.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bwana na awahukumu kabila za watu.","poem":2},{"text":"Nihukumu Ee Bwana,","poem":1},{"text":"kwa kadiri ya haki yangu,","poem":2},{"text":"kwa kadiri ya uadilifu wangu,","poem":1},{"text":"Ewe Uliye Juu Sana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mungu mwenye haki,","poem":1},{"text":"uchunguzaye mawazo na mioyo,","poem":2},{"text":"komesha ghasia za waovu","poem":1},{"text":"na ufanye wenye haki waishi kwa amani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngao langu ni Mungu Aliye Juu Sana,","poem":1},{"text":"awaokoaye wanyofu wa moyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mungu ni mwamuzi mwenye haki,","poem":1},{"text":"Mungu aghadhibikaye kila siku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kama hakutuhurumia,","poem":1},{"text":"atanoa upanga wake,","poem":2},{"lineBreak":true},{"text":"ataupinda na kuufunga uzi upinde wake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ameandaa silaha zake kali,","poem":1},{"text":"ameweka tayari mishale yake ya moto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yeye aliye na mimba ya uovu","poem":1},{"text":"na achukuaye mimba ya ghasia huzaa uongo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yeye achimbaye shimo na kulifukua","poem":1},{"text":"hutumbukia katika shimo alilochimba mwenyewe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ghasia azianzishazo humrudia mwenyewe,","poem":1},{"text":"ukatili wake humrudia kichwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nitamshukuru Bwana kwa ajili ya haki yake,","poem":1},{"text":"na nitaliimbia sifa jina la Bwana Aliye Juu Sana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}