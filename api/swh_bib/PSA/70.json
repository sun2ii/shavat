{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["Kuomba Msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi. Maombi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, ufanye haraka kuniokoa;","poem":1},{"text":"Ee Bwana, njoo hima unisaidie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wale wanaotafuta kuuondoa uhai wangu,","poem":1},{"text":"waaibishwe na kufadhaishwa;","poem":2},{"text":"wote wanaotamani kuangamizwa kwangu,","poem":1},{"text":"warudishwe nyuma kwa aibu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wale waniambiao, “Aha! Aha!”","poem":1},{"text":"warudi nyuma kwa sababu ya aibu yao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini wote wakutafutao","poem":1},{"text":"washangilie na kukufurahia,","poem":2},{"text":"wale wapendao wokovu wako siku zote waseme,","poem":1},{"text":"“Mungu na atukuzwe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lakini bado mimi ni maskini na mhitaji;","poem":1},{"text":"Ee Mungu, unijie haraka.","poem":2},{"text":"Wewe ndiwe msaada wangu na mwokozi wangu;","poem":1},{"text":"Ee Bwana, usikawie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}