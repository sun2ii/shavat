{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"heading","content":["Kuomba Ulinzi Na Msaada Siku Zote Za Maisha"]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, nimekukimbilia wewe,","poem":1},{"text":"usiache nikaaibika kamwe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa haki yako uniponye na kuniokoa,","poem":1},{"text":"unitegee sikio lako uniokoe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uwe kwangu mwamba wa kimbilio,","poem":1},{"text":"mahali nitakapokimbilia kila wakati;","poem":2},{"text":"toa amri ya kuniokoa, kwa kuwa wewe","poem":1},{"text":"ni mwamba wangu na ngome yangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ee Mungu wangu uniokoe kutoka kwenye mkono wa mwovu,","poem":1},{"text":"kutoka kwenye makucha ya watu wabaya na wakatili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa kuwa umekuwa tumaini langu, Ee Bwana Mwenyezi,","poem":1},{"text":"tegemeo langu tangu ujana wangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tangu kuzaliwa nimekutegemea wewe,","poem":1},{"text":"ulinitoa tumboni mwa mama yangu.","poem":2},{"lineBreak":true},{"text":"Nitakusifu wewe daima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nimekuwa kama kioja kwa wengi,","poem":1},{"text":"lakini wewe ni kimbilio langu imara.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kinywa changu kimejazwa sifa zako,","poem":1},{"text":"nikitangaza utukufu wako mchana kutwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Usinitupe wakati wa uzee,","poem":1},{"text":"wala usiniache nguvu zangu zinapopungua.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa maana adui zangu wananisengenya,","poem":1},{"text":"wale wanaonivizia kuniua wafanya hila.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wanasema, “Mungu amemwacha,","poem":1},{"text":"mkimbilieni mkamkamate,","poem":2},{"lineBreak":true},{"text":"kwani hakuna wa kumwokoa.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee Mungu, usiwe mbali nami,","poem":1},{"text":"njoo haraka kunisaidia, Ee Mungu wangu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Washtaki wangu na waangamie kwa aibu,","poem":1},{"text":"wale wanaotaka kunidhuru","poem":2},{"lineBreak":true},{"text":"na wafunikwe kwa dharau na fedheha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lakini mimi, nitatumaini siku zote,","poem":1},{"text":"nitakusifu zaidi na zaidi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kinywa changu kitasimulia haki yako,","poem":1},{"text":"wokovu wako mchana kutwa,","poem":2},{"lineBreak":true},{"text":"ingawa sifahamu kipimo chake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Bwana Mwenyezi, nitakuja","poem":1},{"text":"na kutangaza matendo yako makuu,","poem":2},{"lineBreak":true},{"text":"nitatangaza haki yako, yako peke yako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ee Mungu, umenifundisha tangu ujana wangu,","poem":1},{"text":"hadi leo ninatangaza matendo yako ya ajabu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ee Mungu, usiniache,","poem":1},{"text":"hata niwapo mzee wa mvi,","poem":2},{"text":"mpaka nitangaze uwezo wako kwa kizazi kijacho,","poem":1},{"text":"nguvu zako kwa wote watakaokuja baadaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Mungu, haki yako imefika juu katika mbingu,","poem":1},{"text":"wewe ambaye umefanya mambo makuu.","poem":2},{"lineBreak":true},{"text":"Ee Mungu, ni nani aliye kama wewe?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ingawa umenifanya nipate taabu, nyingi na chungu,","poem":1},{"text":"utanihuisha tena,","poem":2},{"text":"kutoka vilindi vya dunia","poem":1},{"text":"utaniinua tena.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Utaongeza heshima yangu","poem":1},{"text":"na kunifariji tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ee Mungu wangu, nitakusifu kwa kinubi","poem":1},{"text":"kwa ajili ya uaminifu wako;","poem":2},{"text":"Ee Uliye Mtakatifu wa Israeli,","poem":1},{"text":"nitakuimbia sifa kwa zeze.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Midomo yangu itapaza sauti kwa furaha","poem":1},{"text":"ninapokuimbia sifa,","poem":2},{"lineBreak":true},{"text":"mimi, ambaye umenikomboa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ulimi wangu utasimulia matendo yako ya haki","poem":1},{"text":"mchana kutwa,","poem":2},{"text":"kwa maana wale waliotaka kunidhuru,","poem":1},{"text":"wameaibishwa na kufadhaishwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}