{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"heading","content":["Maombi Kwa Ajili Ya Mfalme"]},{"type":"hebrew_subtitle","content":["Zaburi ya Solomoni."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, mjalie mfalme aamue kwa haki yako,","poem":1},{"text":"mwana wa mfalme kwa haki yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Atawaamua watu wako kwa haki,","poem":1},{"text":"watu wako walioonewa kwa haki.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Milima italeta mafanikio kwa watu,","poem":1},{"text":"vilima tunda la haki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atawatetea walioonewa miongoni mwa watu","poem":1},{"text":"na atawaokoa watoto wa wahitaji,","poem":2},{"lineBreak":true},{"text":"ataponda mdhalimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Atadumu kama jua lidumuvyo, kama mwezi, vizazi vyote.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atakuwa kama mvua inyeshayo juu ya shamba lililofyekwa,","poem":1},{"text":"kama manyunyu yanyeshayo ardhi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katika siku zake wenye haki watastawi;","poem":1},{"text":"mafanikio yatakuwepo mpaka mwezi utakapokoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Atatawala kutoka bahari hadi bahari","poem":1},{"text":"na kutoka Mto","poem":2},{"noteId":11},{"text":"mpaka miisho ya dunia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makabila ya jangwani watamsujudia,","poem":1},{"text":"na adui zake wataramba mavumbi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wafalme wa Tarshishi na wa pwani za mbali","poem":1},{"text":"watamletea kodi;","poem":2},{"text":"wafalme wa Sheba na Seba","poem":1},{"text":"watampa zawadi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wafalme wote watamsujudia","poem":1},{"text":"na mataifa yote yatamtumikia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kwa maana atamwokoa mhitaji anayemlilia,","poem":1},{"text":"aliyeonewa asiye na wa kumsaidia.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Atawahurumia wanyonge na wahitaji","poem":1},{"text":"na kuwaokoa wahitaji kutoka mauti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Atawaokoa kutoka uonevu na ukatili,","poem":1},{"text":"kwani damu yao ni ya thamani machoni pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aishi maisha marefu!","poem":1},{"text":"Na apewe dhahabu ya Sheba.","poem":2},{"text":"Watu wamwombee daima","poem":1},{"text":"na kumbariki mchana kutwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nafaka ijae tele katika nchi yote,","poem":1},{"text":"juu ya vilele vya vilima na istawi.","poem":2},{"text":"Tunda lake na listawi kama Lebanoni,","poem":1},{"text":"listawi kama majani ya kondeni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jina lake na lidumu milele,","poem":1},{"text":"na lidumu kama jua.","poem":2},{"lineBreak":true},{"text":"Mataifa yote yatabarikiwa kupitia kwake,","poem":1},{"text":"nao watamwita aliyebarikiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Bwana Mungu, Mungu wa Israeli, apewe sifa,","poem":1},{"text":"yeye ambaye peke yake hutenda mambo ya ajabu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jina lake tukufu lisifiwe milele,","poem":1},{"text":"ulimwengu wote ujae utukufu wake.","poem":2},"Amen na Amen."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Huu ndio mwisho wa maombi ya Daudi mwana wa Yese.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"Yaani Mto Frati.","reference":{"chapter":72,"verse":8}}]},"thisChapterLink":"/api/swh_bib/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}