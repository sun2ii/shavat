{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["Mungu Wa Israeli Ni Mhukumu Wa Dunia Yote"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa ala za nyuzi za muziki. Zaburi ya Asafu. Wimbo."]},{"type":"verse","number":1,"content":[{"text":"Katika Yuda, Mungu anajulikana,","poem":1},{"text":"jina lake ni kuu katika Israeli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hema lake liko Salemu,","poem":1},{"text":"makao yake katika Sayuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Huko alivunja mishale imetametayo,","poem":1},{"text":"ngao na panga, silaha za vita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wewe unangʼaa kwa mwanga,","poem":1},{"text":"mwenye fahari zaidi ya milima yenye utajiri wa wanyama pori.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mashujaa hulala wametekwa nyara,","poem":1},{"text":"hulala usingizi wao wa mwisho;","poem":2},{"text":"hakuna hata mmoja wa watu wa vita","poem":1},{"text":"anayeweza kuinua mikono yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa kukemea kwako, Ee Mungu wa Yakobo,","poem":1},{"text":"farasi na gari la vita vilikaa kimya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wewe peke yako ndiye wa kuogopwa.","poem":1},{"text":"Ni nani awezaye kusimama mbele yako unapokasirika?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kutoka mbinguni ulitamka hukumu,","poem":1},{"text":"nayo nchi ikaogopa, ikawa kimya:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"wakati wewe, Ee Mungu, ulipoinuka kuhukumu,","poem":1},{"text":"kuwaokoa wote walioonewa katika nchi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hakika ghadhabu yako dhidi ya wanadamu inakuletea sifa,","poem":1},{"text":"na masalia ya ghadhabu yako unajifunga mshipi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wekeni nadhiri kwa Bwana Mungu wenu na kuzitimiza;","poem":1},{"text":"nchi zote za jirani na walete zawadi","poem":2},{"lineBreak":true},{"text":"kwa Yule astahiliye kuogopwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Huvunja roho za watawala;","poem":1},{"text":"anaogopwa na wafalme wa dunia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}