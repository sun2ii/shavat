{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"heading","content":["Maombi Kwa Ajili Ya Wokovu Wa Taifa"]},{"type":"hebrew_subtitle","content":["Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, mataifa yameuvamia urithi wako,","poem":1},{"text":"wamelinajisi Hekalu lako takatifu,","poem":2},{"lineBreak":true},{"text":"wameifanya Yerusalemu kuwa magofu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wametoa maiti za watumishi","poem":1},{"text":"kuwa chakula cha ndege wa angani","poem":2},{"text":"na nyama ya watakatifu wako","poem":1},{"text":"kwa wanyama wa nchi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wamemwaga damu kama maji","poem":1},{"text":"kuzunguka Yerusalemu yote,","poem":2},{"lineBreak":true},{"text":"wala hakuna yeyote wa kuwazika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tumekuwa kitu cha aibu kwa jirani zetu,","poem":1},{"text":"cha dharau na mzaha kwa wale wanaotuzunguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hata lini, Ee Bwana? Je, wewe utakasirika milele?","poem":1},{"text":"Wivu wako utawaka kama moto hadi lini?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwaga ghadhabu yako kwa mataifa yasiyokukubali,","poem":1},{"text":"juu ya falme za hao wasioliitia jina lako,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kwa maana wamemrarua Yakobo","poem":1},{"text":"na kuharibu nchi ya makao yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usituhesabie dhambi za baba zetu,","poem":1},{"text":"huruma yako na itujie hima,","poem":2},{"lineBreak":true},{"text":"kwa maana tu wahitaji mno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mungu Mwokozi wetu, utusaidie,","poem":1},{"text":"kwa ajili ya utukufu wa jina lako;","poem":2},{"text":"tuokoe na kutusamehe dhambi zetu","poem":1},{"text":"kwa ajili ya jina lako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa nini mataifa waseme,","poem":1},{"text":"“Yuko wapi Mungu wenu?”","poem":2},{"text":"Mbele ya macho yetu,","poem":1},{"text":"dhihirisha kati ya mataifa","poem":2},{"text":"kwamba unalipiza kisasi damu iliyomwagwa","poem":1},{"text":"ya watumishi wako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kilio cha huzuni cha wafungwa kifike mbele zako;","poem":1},{"text":"kwa nguvu za mkono wako","poem":2},{"lineBreak":true},{"text":"hifadhi wale waliohukumiwa kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Walipize jirani zetu mara saba vifuani mwao","poem":1},{"text":"aibu walizovurumisha juu yako, Ee Bwana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndipo sisi watu wako, kondoo wa malisho yako,","poem":1},{"text":"tutakusifu milele;","poem":2},{"text":"toka kizazi hadi kizazi","poem":1},{"text":"tutasimulia sifa zako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}