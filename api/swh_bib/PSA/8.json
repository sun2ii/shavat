{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["Utukufu Wa Mungu Na Heshima Ya Mwanadamu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa gitithi. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, Bwana wetu,","poem":1},{"text":"tazama jinsi lilivyo tukufu jina lako duniani mwote!","poem":2},{"lineBreak":true},{"text":"Umeuweka utukufu wako","poem":1},{"text":"juu ya mbingu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Midomoni mwa watoto wachanga na wanyonyao","poem":1},{"text":"umeamuru sifa,","poem":2},{"text":"kwa sababu ya watesi wako,","poem":1},{"text":"kumnyamazisha adui na mlipiza kisasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nikiziangalia mbingu zako,","poem":1},{"text":"kazi ya vidole vyako,","poem":2},{"text":"mwezi na nyota,","poem":1},{"text":"ulizoziratibisha,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mwanadamu ni kitu gani hata unamfikiria,","poem":1},{"text":"binadamu ni nani hata unamjali?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umemfanya chini kidogo kuliko viumbe wa mbinguni,","poem":1},{"text":"ukamvika taji ya utukufu na heshima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Umemfanya mtawala juu ya kazi za mikono yako;","poem":1},{"text":"umeweka vitu vyote chini ya miguu yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mifugo na makundi yote pia,","poem":1},{"text":"naam, na wanyama wa kondeni,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ndege wa angani na samaki wa baharini,","poem":1},{"text":"naam, kila kiogeleacho katika njia za bahari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Bwana, Bwana wetu,","poem":1},{"text":"tazama jinsi lilivyo tukufu jina lako duniani mwote!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}