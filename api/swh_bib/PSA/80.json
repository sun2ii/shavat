{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"heading","content":["Maombi Kwa Ajili Ya Kuponywa Kwa Taifa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa “Yungiyungi za Agano.” Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mchungaji wa Israeli tusikie,","poem":1},{"text":"wewe umwongozaye Yosefu kama kundi;","poem":2},{"text":"wewe uketiye katika kiti cha enzi","poem":1},{"text":"katikati ya makerubi, angaza","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"mbele ya Efraimu, Benyamini na Manase.","poem":2},{"text":"Uamshe nguvu zako,","poem":1},{"text":"uje utuokoe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Mungu, uturejeshe,","poem":1},{"text":"utuangazie uso wako,","poem":2},{"lineBreak":true},{"text":"ili tuweze kuokolewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Bwana Mungu Mwenye Nguvu Zote,","poem":1},{"text":"hata lini hasira yako itawaka na kufoka moshi","poem":2},{"lineBreak":true},{"text":"dhidi ya maombi ya watu wako?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umewalisha kwa mkate wa machozi,","poem":1},{"text":"umewafanya wanywe machozi bakuli tele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tumekuwa chanzo cha ugomvi kwa jirani zetu,","poem":1},{"text":"na adui zetu wanatudhihaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mungu Mwenye Nguvu Zote, uturejeshe;","poem":1},{"text":"utuangazie uso wako,","poem":2},{"lineBreak":true},{"text":"nasi tuweze kuokolewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ulileta mzabibu kutoka Misri,","poem":1},{"text":"ukawafukuza mataifa, ukaupanda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uliandaa shamba kwa ajili yake,","poem":1},{"text":"mizizi ikawa imara, ukajaza nchi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Milima ilifunikwa kwa kivuli chake,","poem":1},{"text":"matawi yake yakafunika mierezi mikubwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Matawi yake yalienea mpaka Baharini,","poem":1},{"noteId":15},{"text":"machipukizi yake mpaka kwenye Mto.","poem":2},{"noteId":16}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mbona umebomoa kuta zake","poem":1},{"text":"ili wote wapitao karibu","poem":2},{"lineBreak":true},{"text":"wazichume zabibu zake?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nguruwe mwitu wanauharibu","poem":1},{"text":"na wanyama wa kondeni hujilisha humo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Turudie, Ee Mungu Mwenye Nguvu Zote!","poem":1},{"text":"Tazama chini kutoka mbinguni na uone!","poem":2},{"text":"Linda mzabibu huu,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"mche ulioupanda kwa mkono wako wa kuume,","poem":2},{"text":"mwana uliyemlea","poem":1},{"text":"kwa ajili yako mwenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mzabibu wako umekatwa, umechomwa moto,","poem":1},{"text":"unapowakemea, watu wako huangamia.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mkono wako na utulie juu ya mtu aliyeko mkono wako wa kuume,","poem":1},{"text":"mwana wa mtu uliyemlea kwa ajili yako mwenyewe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndipo hatutakuacha tena,","poem":1},{"text":"utuhuishe, nasi tutaliitia jina lako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Bwana Mungu Mwenye Nguvu Zote, uturejeshe;","poem":1},{"text":"utuangazie uso wako,","poem":2},{"lineBreak":true},{"text":"ili tuweze kuokolewa.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Huenda inamaanisha Bahari ya Mediterania.","reference":{"chapter":80,"verse":11}},{"noteId":16,"caller":"+","text":"Yaani Mto Frati.","reference":{"chapter":80,"verse":11}}]},"thisChapterLink":"/api/swh_bib/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}