{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"heading","content":["Wimbo Wa Sikukuu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa gitithi. Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mwimbieni kwa furaha, Mungu aliye nguvu yetu;","poem":1},{"text":"mpigieni kelele za shangwe Mungu wa Yakobo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anzeni wimbo, pigeni matari,","poem":1},{"text":"pigeni kinubi na zeze kwa sauti nzuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pigeni baragumu za pembe za kondoo dume","poem":1},{"text":"wakati wa Mwandamo wa Mwezi,","poem":2},{"text":"na wakati wa mwezi mpevu,","poem":1},{"text":"katika siku ya Sikukuu yetu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"hii ni amri kwa Israeli,","poem":1},{"text":"agizo la Mungu wa Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aliiweka iwe kama sheria kwa Yosefu","poem":1},{"text":"alipotoka dhidi ya Misri,","poem":2},{"lineBreak":true},{"text":"huko tulikosikia lugha ambayo hatukuielewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Asema, “Nimeondoa mzigo mabegani mwao;","poem":1},{"text":"mikono yao iliwekwa huru kutoka kwenye kikapu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katika shida yako uliniita nami nikakuokoa,","poem":1},{"text":"nilikujibu katika mawingu yenye ngurumo;","poem":2},{"lineBreak":true},{"text":"nilikujaribu katika maji ya Meriba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Enyi watu wangu, sikieni, nami nitawaonya:","poem":1},{"text":"laiti kama mngenisikiliza, ee Israeli!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hamtakuwa na mungu mgeni miongoni mwenu;","poem":1},{"text":"msimsujudie mungu wa kigeni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mimi ni Bwana Mungu wako,","poem":1},{"text":"niliyekutoa nchi ya Misri.","poem":2},{"text":"Panua sana kinywa chako","poem":1},{"text":"nami nitakijaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Lakini watu wangu hawakutaka kunisikiliza;","poem":1},{"text":"Israeli hakutaka kunitii.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Basi niliwaacha katika ukaidi wa mioyo yao","poem":1},{"text":"wafuate mashauri yao wenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Laiti kama watu wangu wangalinisikiliza,","poem":1},{"text":"kama Israeli wangalifuata njia zangu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ningaliwatiisha adui zao kwa haraka,","poem":1},{"text":"na kuugeuza mkono wangu dhidi ya watesi wao!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wale wanaomchukia Bwana wangalinyenyekea mbele zake,","poem":1},{"text":"na adhabu yao ingedumu milele.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bali ninyi mngalilishwa ngano iliyo bora,","poem":1},{"text":"na kuwatosheleza kwa asali itokayo kwenye mwamba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}