{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Maombi Kwa Ajili Ya Kutaka Haki"]},{"type":"hebrew_subtitle","content":["Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mungu anaongoza kusanyiko kuu,","poem":1},{"text":"anatoa hukumu miongoni mwa “miungu”:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Hata lini utaendelea kuwatetea wasio haki","poem":1},{"text":"na kuonyesha upendeleo kwa waovu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Teteeni wanyonge na yatima,","poem":1},{"text":"tunzeni haki za maskini na walioonewa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwokoeni mnyonge na mhitaji,","poem":1},{"text":"wakomboeni kutoka mkononi mwa mwovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Hawajui lolote, hawaelewi lolote.","poem":1},{"text":"Wanatembea gizani;","poem":2},{"lineBreak":true},{"text":"misingi yote ya dunia imetikisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nilisema, ‘Ninyi ni “miungu”;","poem":1},{"text":"ninyi nyote ni wana wa Aliye Juu Sana.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lakini mtakufa kama wanadamu wa kawaida;","poem":1},{"text":"mtaanguka kama mtawala mwingine yeyote.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mungu, inuka uihukumu nchi,","poem":1},{"text":"kwa kuwa mataifa yote ni urithi wako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}