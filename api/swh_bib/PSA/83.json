{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["Maombi Kwa Ajili Ya Kushindwa Kwa Adui Wa Israeli"]},{"type":"hebrew_subtitle","content":["Wimbo. Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, usinyamaze kimya,","poem":1},{"text":"usinyamaze, Ee Mungu, usitulie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tazama watesi wako wanafanya fujo,","poem":1},{"text":"jinsi adui zako wanavyoinua vichwa vyao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa hila, wanafanya shauri dhidi ya watu wako,","poem":1},{"text":"wanafanya shauri baya dhidi ya wale unaowapenda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wanasema, “Njooni, tuwaangamize kama taifa,","poem":1},{"text":"ili jina la Israeli lisikumbukwe tena.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa nia moja wanapanga mashauri mabaya pamoja,","poem":1},{"text":"wanafanya muungano dhidi yako,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mahema ya Edomu na Waishmaeli,","poem":1},{"text":"ya Wamoabu na Wahagari,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gebali,","poem":1},{"noteId":17},{"text":"Amoni na Amaleki,","poem":1},{"text":"Ufilisti, pamoja na watu wa Tiro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hata Ashuru wameungana nao","poem":1},{"text":"kuwapa nguvu wazao wa Loti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uwatendee kama vile ulivyowatendea Midiani,","poem":1},{"text":"na kama vile ulivyowatendea Sisera na Yabini","poem":2},{"lineBreak":true},{"text":"hapo kijito cha Kishoni,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ambao waliangamia huko Endori","poem":1},{"text":"na wakawa kama takataka juu ya nchi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wafanye wakuu wao kama Orebu na Zeebu,","poem":1},{"text":"watawala wao kama Zeba na Salmuna,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ambao walisema, “Na tumiliki nchi","poem":1},{"text":"ya malisho ya Mungu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mungu wangu, wapeperushe kama mavumbi ya kisulisuli,","poem":1},{"text":"kama makapi yapeperushwayo na upepo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kama vile moto uteketezavyo msitu","poem":1},{"text":"au mwali wa moto unavyounguza milima,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"wafuatilie kwa tufani yako","poem":1},{"text":"na kuwafadhaisha kwa dhoruba yako.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Funika nyuso zao kwa aibu","poem":1},{"text":"ili watu walitafute jina lako, Ee Bwana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wao na waaibishwe na kufadhaishwa milele,","poem":1},{"text":"na waangamie kwa aibu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hebu wajue kwamba wewe, ambaye jina lako ni Bwana,","poem":1},{"text":"kwamba wewe peke yako ndiwe Uliye Juu Sana ya dunia yote.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Yaani Bubilo, mji wa zamani sana wa Ufoinike (kama kilomita 80 kaskazini mwa Beiruti).","reference":{"chapter":83,"verse":7}}]},"thisChapterLink":"/api/swh_bib/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}