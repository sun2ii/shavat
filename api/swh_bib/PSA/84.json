{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"heading","content":["Kuionea Shauku Nyumba Ya Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa gitithi. Zaburi ya wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana Mwenye Nguvu Zote,","poem":1},{"text":"makao yako yapendeza kama nini!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nafsi yangu inatamani sana,","poem":1},{"text":"naam, hata kuona shauku,","poem":2},{"lineBreak":true},{"text":"kwa ajili ya nyua za Bwana;","poem":2},{"text":"moyo wangu na mwili wangu","poem":1},{"text":"vinamlilia Mungu Aliye Hai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hata shomoro amejipatia makao,","poem":1},{"text":"mbayuwayu amejipatia kiota","poem":2},{"lineBreak":true},{"text":"mahali awezapo kuweka makinda yake:","poem":2},{"text":"mahali karibu na madhabahu yako,","poem":1},{"text":"Ee Bwana Mwenye Nguvu Zote,","poem":2},{"lineBreak":true},{"text":"Mfalme wangu na Mungu wangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Heri wale wanaokaa nyumbani mwako,","poem":1},{"text":"wanaokusifu wewe daima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Heri wale ambao nguvu zao ziko kwako,","poem":1},{"text":"na njia ziendazo Sayuni zimo mioyoni mwao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wanapopita katika Bonde la Baka,","poem":1},{"noteId":18},{"text":"hulifanya mahali pa chemchemi,","poem":2},{"lineBreak":true},{"text":"pia mvua za vuli hulijaza kwa madimbwi.","poem":2},{"noteId":19}]},{"type":"verse","number":7,"content":[{"text":"Huendelea toka nguvu hadi nguvu,","poem":1},{"text":"hadi kila mmoja afikapo","poem":2},{"lineBreak":true},{"text":"mbele za Mungu huko Sayuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Bwana Mungu Mwenye Nguvu Zote, sikia maombi yangu;","poem":1},{"text":"nisikilize, Ee Mungu wa Yakobo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mungu, uitazame ngao yetu,","poem":1},{"text":"mtazame kwa wema mpakwa mafuta wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Siku moja katika nyua zako ni bora","poem":1},{"text":"kuliko siku elfu mahali pengine;","poem":2},{"text":"afadhali ningekuwa bawabu katika nyumba ya Mungu wangu","poem":1},{"text":"kuliko kukaa katika mahema ya waovu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa kuwa Bwana ni jua na ngao,","poem":1},{"text":"Bwana hutoa wema na heshima;","poem":2},{"text":"hakuna kitu chema anachowanyima","poem":1},{"text":"wale ambao hawana hatia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Bwana Mwenye Nguvu Zote,","poem":1},{"text":"heri ni mtu yule anayekutumaini wewe.","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"Yaani Bonde la Vilio.","reference":{"chapter":84,"verse":6}},{"noteId":19,"caller":"+","text":"Au: baraka.","reference":{"chapter":84,"verse":6}}]},"thisChapterLink":"/api/swh_bib/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}