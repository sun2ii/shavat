":1},{"text":"“Huyu na yule walizaliwa humo,","poem":2},{"text":"naye Aliye Juu Sana mwenyewe","poem":1},{"text":"atamwimarisha.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Bwana ataandika katika orodha ya mataifa:","poem":1},{"text":"“Huyu alizaliwa Sayuni.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Watakapokuwa wanapiga vinanda wataimba,","poem":1},{"text":"“Chemchemi zangu zote ziko kwako.”","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"Rahabu hapa ni jina la ushairi la Misri.","reference":{"chapter":87,"verse":4}},{"noteId":24,"caller":"+","text":"Kushi hapa ina maana ya Naili ya juu, yaani Ethiopia.","reference":{"chapter":87,"verse":4}}]},"thisChapterLink":"/api/swh_bib/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}