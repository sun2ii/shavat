{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"heading","content":["Kilio Kwa Ajili Ya Kuomba Msaada"]},{"type":"hebrew_subtitle","content":["Wimbo. Zaburi ya wana wa Kora. Kwa mwimbishaji. Mtindo wa mahalathi leanothi. Utenzi wa Hemani Mwezrahi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, Mungu uniokoaye,","poem":1},{"text":"nimelia mbele zako usiku na mchana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Maombi yangu yafike mbele zako,","poem":1},{"text":"utegee kilio changu sikio lako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwa maana nafsi yangu imejaa taabu,","poem":1},{"text":"na maisha yangu yanakaribia kaburi.","poem":2},{"noteId":25}]},{"type":"verse","number":4,"content":[{"text":"Nimehesabiwa miongoni mwa wale waendao shimoni,","poem":1},{"text":"niko kama mtu asiye na nguvu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nimetengwa pamoja na wafu,","poem":1},{"text":"kama waliochinjwa walalao kaburini,","poem":2},{"text":"ambao huwakumbuki tena,","poem":1},{"text":"ambao wamekatiliwa mbali na uangalizi wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Umenitupa katika shimo lenye kina kirefu sana,","poem":1},{"text":"katika vina vya giza nene.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ghadhabu yako imekuwa nzito juu yangu,","poem":1},{"text":"umenigharikisha kwa mawimbi yako yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Umenitenga na rafiki zangu wa karibu","poem":1},{"text":"na kunifanya chukizo kwao.","poem":2},{"text":"Nimezuiliwa, wala siwezi kutoroka;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"nuru ya macho yangu","poem":2},{"lineBreak":true},{"text":"imefifia kwa ajili ya huzuni.","poem":2},{"lineBreak":true},{"text":"Ee Bwana, ninakuita kila siku,","poem":1},{"text":"ninakunyooshea wewe mikono yangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Je, wewe huwaonyesha wafu maajabu yako?","poem":1},{"text":"Je, wale waliokufa huinuka na kukusifu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Je, upendo wako hutangazwa kaburini,","poem":1},{"text":"uaminifu wako katika Uharibifu?","poem":2},{"noteId":26}]},{"type":"verse","number":12,"content":[{"text":"Je, maajabu yako hujulikana mahali pa giza,","poem":1},{"text":"au matendo yako ya haki katika nchi ya usahaulifu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini ninakulilia wewe, Ee Bwana, unisaidie;","poem":1},{"text":"asubuhi maombi yangu huja mbele zako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ee Bwana, kwa nini unanikataa","poem":1},{"text":"na kunificha uso wako?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tangu ujana wangu nimeteseka, nikakaribia kifo;","poem":1},{"text":"nimepatwa na hofu zako, nami nimekata tamaa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ghadhabu yako imepita juu yangu;","poem":1},{"text":"hofu zako zimeniangamiza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mchana kutwa zinanizunguka kama mafuriko;","poem":1},{"text":"zimenimeza kabisa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Umeniondolea marafiki na wapendwa wangu;","poem":1},{"text":"giza limekuwa ndilo rafiki yangu wa karibu kuliko wote.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"Kaburi hapa maana yake ni Kuzimu, kwa Kiebrania ni Sheol.","reference":{"chapter":88,"verse":3}},{"noteId":26,"caller":"+","text":"Yaani Abadon.","reference":{"chapter":88,"verse":11}}]},"thisChapterLink":"/api/swh_bib/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}