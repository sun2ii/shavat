{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"heading","content":["Shukrani Kwa Mungu Kwa Ajili Ya Haki Yake"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa muth-labeni.",{"noteId":1},"Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, nitakutukuza kwa moyo wangu wote,","poem":1},{"text":"nitayasimulia matendo yako yote ya ajabu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitafurahi na kushangilia ndani yako.","poem":1},{"text":"Nitaliimbia sifa jina lako, Ewe Uliye Juu Sana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Adui zangu wamerudi nyuma,","poem":1},{"text":"wamejikwaa na kuangamia mbele zako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa maana umetetea haki yangu na msimamo wangu;","poem":1},{"text":"umeketi kwenye kiti chako cha enzi,","poem":2},{"lineBreak":true},{"text":"ukihukumu kwa haki.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umekemea mataifa na kuwaangamiza waovu;","poem":1},{"text":"umeyafuta majina yao milele na milele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uharibifu usiokoma umempata adui,","poem":1},{"text":"umeingʼoa miji yao;","poem":2},{"lineBreak":true},{"text":"hata kumbukumbu lao limetoweka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bwana anatawala milele,","poem":1},{"text":"ameweka kiti chake cha enzi apate kuhukumu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mungu atahukumu ulimwengu kwa haki,","poem":1},{"text":"atatawala mataifa kwa haki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bwana ni kimbilio la watu wanaoonewa,","poem":1},{"text":"ni ngome imara wakati wa shida.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wote wanaolijua jina lako watakutumaini wewe,","poem":1},{"text":"kwa maana wewe Bwana,","poem":2},{"lineBreak":true},{"text":"hujawaacha kamwe wakutafutao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwimbieni Bwana sifa, amefanywa mtawala Sayuni,","poem":1},{"text":"tangazeni miongoni mwa mataifa, yale aliyoyatenda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa maana yeye alipizaye kisasi cha damu hukumbuka,","poem":1},{"text":"hapuuzi kilio cha wanaoonewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Bwana, tazama jinsi walivyo wengi adui zangu wanaonitesa!","poem":1},{"text":"Nihurumie, uniinue kutoka malango ya mauti,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ili niweze kutangaza sifa zako","poem":1},{"text":"katika malango ya Binti Sayuni","poem":2},{"lineBreak":true},{"text":"na huko niushangilie wokovu wako.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mataifa wameanguka kwenye shimo walilolichimba,","poem":1},{"text":"miguu yao imenaswa kwenye wavu waliouficha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bwana anajulikana kwa haki yake,","poem":1},{"text":"waovu wamenaswa katika kazi za mikono yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Waovu wataishia kuzimu,","poem":1},{"text":"naam, mataifa yote wanaomsahau Mungu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lakini mhitaji hatasahaulika siku zote,","poem":1},{"text":"wala matumaini ya walioonewa hayatapotea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Bwana, inuka, usimwache binadamu ashinde.","poem":1},{"text":"Mataifa na yahukumiwe mbele zako.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ee Bwana, wapige kwa hofu,","poem":1},{"text":"mataifa na yajue kuwa wao ni watu tu.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Muth-labeni ni mtajo mmojawapo katika lugha za muziki.","reference":{"chapter":9,"verse":0}}]},"thisChapterLink":"/api/swh_bib/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}