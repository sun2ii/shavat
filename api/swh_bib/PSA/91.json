{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"heading","content":["Mungu Mlinzi Wetu"]},{"type":"verse","number":1,"content":[{"text":"Yeye akaaye mahali pa salama pake Yeye Aliye Juu Sana,","poem":1},{"text":"atadumu katika uvuli wake Mwenyezi.","poem":2},{"noteId":30}]},{"type":"verse","number":2,"content":[{"text":"Nitasema kumhusu Bwana, “Yeye ndiye kimbilio langu na ngome yangu,","poem":1},{"text":"Mungu wangu, ambaye ninamtumaini.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hakika yeye ataniokoa na mtego wa mwindaji,","poem":1},{"text":"na maradhi ya kuambukiza ya kuua.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atakufunika kwa manyoya yake,","poem":1},{"text":"chini ya mbawa zake utapata kimbilio,","poem":2},{"lineBreak":true},{"text":"uaminifu wake utakuwa ngao na kinga yako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hutaogopa vitisho vya usiku,","poem":1},{"text":"wala mshale urukao mchana,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wala maradhi ya kuambukiza","poem":1},{"text":"yanayonyemelea gizani,","poem":2},{"lineBreak":true},{"text":"wala tauni iharibuyo adhuhuri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ijapo watu elfu wataangukia kando yako,","poem":1},{"text":"kumi elfu mkono wako wa kuume,","poem":2},{"lineBreak":true},{"text":"lakini haitakukaribia wewe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Utatazama tu kwa macho yako","poem":1},{"text":"na kuona adhabu ya waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kama ukimfanya Aliye Juu Sana kuwa makao yako:","poem":1},{"text":"naam, Bwana ambaye ni kimbilio langu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"basi hakuna madhara yatakayokupata wewe,","poem":1},{"text":"hakuna maafa yataikaribia hema yako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa kuwa atawaagiza malaika zake kwa ajili yako,","poem":1},{"text":"wakulinde katika njia zako zote.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mikononi mwao watakuinua,","poem":1},{"text":"ili usijikwae mguu wako kwenye jiwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Utawakanyaga simba na nyoka wakali,","poem":1},{"text":"simba mkubwa na nyoka utawaponda kwa miguu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Bwana asema, “Kwa kuwa ananipenda, nitamwokoa;","poem":1},{"text":"nitamlinda, kwa kuwa analikiri Jina langu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ataniita, nami nitamjibu;","poem":1},{"text":"nitakuwa pamoja naye katika taabu,","poem":2},{"lineBreak":true},{"text":"nitamwokoa na kumheshimu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa siku nyingi nitamshibisha","poem":1},{"text":"na kumwonyesha wokovu wangu.”","poem":2}]}],"footnotes":[{"noteId":30,"caller":"+","text":"Mwenyezi hapa ina maana ya Shaddai kwa Kiebrania.","reference":{"chapter":91,"verse":1}}]},"thisChapterLink":"/api/swh_bib/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}