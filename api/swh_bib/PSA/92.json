{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"heading","content":["Wimbo Wa Kumsifu Mungu"]},{"type":"hebrew_subtitle","content":["Zaburi. Wimbo wa siku ya Sabato."]},{"type":"verse","number":1,"content":[{"text":"Ni vyema kumshukuru Bwana","poem":1},{"text":"na kuliimbia jina lako, Ee Uliye Juu Sana,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuutangaza upendo wako asubuhi,","poem":1},{"text":"na uaminifu wako wakati wa usiku,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwa zeze yenye nyuzi kumi","poem":1},{"text":"na kwa sauti ya kinubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Bwana, kwa kuwa matendo yako yamenifurahisha,","poem":1},{"text":"nitaziimba kwa shangwe kazi za mikono yako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Bwana, tazama jinsi yalivyo makuu matendo yako,","poem":1},{"text":"tazama jinsi yalivyo ya kina mawazo yako!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mjinga hafahamu,","poem":1},{"text":"mpumbavu haelewi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ingawa waovu huchipua kama majani","poem":1},{"text":"na wote watendao mabaya wanastawi,","poem":2},{"lineBreak":true},{"text":"wataangamizwa milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bali wewe, Ee Bwana,","poem":1},{"text":"utatukuzwa milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Bwana, hakika adui zako,","poem":1},{"text":"hakika adui zako wataangamia.","poem":2},{"lineBreak":true},{"text":"Wote watendao mabaya watatawanyika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Umeitukuza pembe","poem":1},{"noteId":31},{"text":"yangu kama ile ya nyati dume,","poem":1},{"text":"mafuta mazuri yamemiminwa juu yangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Macho yangu yamewaona adui zangu wakishindwa,","poem":1},{"text":"masikio yangu yamesikia maangamizi ya adui zangu waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wenye haki watastawi kama mtende,","poem":1},{"text":"watakuwa kama mwerezi wa Lebanoni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"waliopandwa katika nyumba ya Bwana,","poem":1},{"text":"watastawi katika nyua za Mungu wetu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wakati wa uzee watakuwa bado wanazaa matunda,","poem":1},{"text":"watakuwa wabichi tena wamejaa nguvu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"wakitangaza, “Bwana ni mkamilifu;","poem":1},{"text":"yeye ni Mwamba wangu,","poem":2},{"lineBreak":true},{"text":"na ndani yake hamna uovu.”","poem":2}]}],"footnotes":[{"noteId":31,"caller":"+","text":"Pembe inawakilisha nguvu.","reference":{"chapter":92,"verse":10}}]},"thisChapterLink":"/api/swh_bib/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}