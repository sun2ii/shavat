{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["Mungu Mfalme"]},{"type":"verse","number":1,"content":[{"text":"Bwana anatawala, amejivika utukufu;","poem":1},{"text":"Bwana amejivika utukufu","poem":2},{"lineBreak":true},{"text":"tena amejivika nguvu.","poem":2},{"text":"Dunia imewekwa imara,","poem":1},{"text":"haitaondoshwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kiti chako cha enzi kimekuwa thabiti tangu zamani;","poem":1},{"text":"wewe umekuwako tangu milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bahari zimeinua, Ee Bwana,","poem":1},{"text":"bahari zimeinua sauti zake;","poem":2},{"lineBreak":true},{"text":"bahari zimeinua sauti za mawimbi yake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yeye ni mkuu kuliko ngurumo ya maji makuu,","poem":1},{"text":"ni mkuu kuliko mawimbi ya bahari:","poem":2},{"lineBreak":true},{"text":"Bwana aishiye juu sana ni mkuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Bwana, sheria zako ni imara;","poem":1},{"text":"utakatifu umepamba nyumba yako","poem":2},{"lineBreak":true},{"text":"pasipo mwisho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}