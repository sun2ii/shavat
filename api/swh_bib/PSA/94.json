{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"heading","content":["Mungu Mlipiza Kisasi Kwa Ajili Ya Wenye Haki"]},{"type":"verse","number":1,"content":[{"text":"Ee Bwana, ulipizaye kisasi,","poem":1},{"text":"Ee Mungu ulipizaye kisasi, uangaze sasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Mhukumu wa dunia, inuka,","poem":1},{"text":"uwalipize wenye kiburi kama wanavyostahili.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hata lini, waovu, Ee Bwana,","poem":1},{"text":"hata lini waovu watashangilia?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wanamimina maneno ya kiburi,","poem":1},{"text":"watenda mabaya wote wamejaa majivuno.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Bwana, wanawaponda watu wako,","poem":1},{"text":"wanawaonea urithi wako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wanamchinja mjane na mgeni,","poem":1},{"text":"na kuwaua yatima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nao husema, “Bwana haoni,","poem":1},{"text":"Mungu wa Yakobo hafahamu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sikizeni, enyi wajinga miongoni mwa watu;","poem":1},{"text":"enyi wapumbavu, lini mtakuwa na hekima?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, aliyeweka sikio asisikie?","poem":1},{"text":"Aliyeumba jicho asione?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Je, anayeadhibisha mataifa asiadhibu?","poem":1},{"text":"Je, awafundishaye wanadamu asiwe na maarifa?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwana anajua mawazo ya mwanadamu;","poem":1},{"text":"anajua kwamba ni ubatili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Bwana, heri mtu anayeadhibishwa na wewe,","poem":1},{"text":"mtu unayemfundisha kwa sheria yako,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"unampa utulivu siku za shida,","poem":1},{"text":"mpaka shimo litakapokuwa limechimbwa","poem":2},{"lineBreak":true},{"text":"kwa ajili ya mwovu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa kuwa Bwana hatawakataa watu wake,","poem":1},{"text":"hatauacha urithi wake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hukumu itasimamishwa tena kwenye haki,","poem":1},{"text":"wote walio na mioyo minyofu wataifuata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ni nani atakayeinuka dhidi ya mwovu kwa ajili yangu?","poem":1},{"text":"Ni nani atakayenikinga dhidi ya watenda maovu?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kama Bwana asingelinisaidia upesi,","poem":1},{"text":"ningelikuwa ninaishi katika ukimya wa kifo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Niliposema, “Mguu wangu unateleza,”","poem":1},{"text":"Ee Bwana, upendo wako ulinishikilia.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wakati wasiwasi ulipokuwa mwingi ndani yangu,","poem":1},{"text":"faraja yako ilinipa furaha nafsini mwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Je, kiti cha utawala wa udhalimu kitajiunga nawe,","poem":1},{"text":"ule utawala uletao taabu kutokana na sheria zake?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Huungana kuwashambulia wenye haki,","poem":1},{"text":"kuwahukumu kufa wasio na hatia.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lakini Bwana amekuwa ngome yangu,","poem":1},{"text":"na Mungu wangu amekuwa mwamba ninaoukimbilia.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yeye atawalipa kwa ajili ya dhambi zao","poem":1},{"text":"na atawaangamiza kwa ajili ya maovu yao;","poem":2},{"lineBreak":true},{"text":"Bwana Mungu wetu atawaangamiza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}