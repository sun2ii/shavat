{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"heading","content":["Wimbo Wa Kumsifu Mungu"]},{"type":"verse","number":1,"content":[{"text":"Njooni, tumwimbie Bwana kwa furaha;","poem":1},{"text":"tumfanyie kelele za shangwe","poem":2},{"lineBreak":true},{"text":"Mwamba wa wokovu wetu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tuje mbele zake kwa shukrani,","poem":1},{"text":"tumtukuze kwa vinanda na nyimbo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa Bwana ni Mungu mkuu,","poem":1},{"text":"mfalme mkuu juu ya miungu yote.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mkononi mwake mna vilindi vya dunia,","poem":1},{"text":"na vilele vya milima ni mali yake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bahari ni yake, kwani ndiye aliifanya,","poem":1},{"text":"na mikono yake iliumba nchi kavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Njooni, tusujudu, tumwabudu,","poem":1},{"text":"tupige magoti mbele za Bwana Muumba wetu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kwa maana yeye ndiye Mungu wetu,","poem":1},{"text":"na sisi ni watu wa malisho yake,","poem":2},{"lineBreak":true},{"text":"kondoo chini ya utunzaji wake.","poem":2},{"lineBreak":true},{"text":"Kama mkiisikia sauti yake leo,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"msiifanye mioyo yenu migumu","poem":2},{"lineBreak":true},{"text":"kama mlivyofanya kule Meriba,","poem":2},{"noteId":32},{"text":"kama mlivyofanya siku ile","poem":1},{"text":"kule Masa","poem":2},{"noteId":33},{"text":"jangwani,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ambapo baba zenu walinijaribu na kunipima,","poem":1},{"text":"ingawa walikuwa wameyaona matendo yangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa miaka arobaini nilikasirikia kizazi kile,","poem":1},{"text":"nikasema, “Hawa ni taifa ambalo mioyo yao imepotoka,","poem":2},{"lineBreak":true},{"text":"nao hawajazijua njia zangu.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hivyo nikatangaza kwa kiapo katika hasira yangu,","poem":1},{"text":"“Kamwe hawataingia rahani mwangu.”","poem":2}]}],"footnotes":[{"noteId":32,"caller":"+","text":"Meriba maana yake ni Kugombana.","reference":{"chapter":95,"verse":8}},{"noteId":33,"caller":"+","text":"Masa maana yake ni Kujaribiwa.","reference":{"chapter":95,"verse":8}}]},"thisChapterLink":"/api/swh_bib/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}