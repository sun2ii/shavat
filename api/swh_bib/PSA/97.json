{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"heading","content":["Mungu Mtawala Mkuu"]},{"type":"verse","number":1,"content":[{"text":"Bwana anatawala, nchi na ifurahi,","poem":1},{"text":"visiwa vyote vishangilie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mawingu na giza nene vinamzunguka,","poem":1},{"text":"haki na hukumu ndio msingi wa kiti chake cha enzi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Moto hutangulia mbele zake","poem":1},{"text":"na huteketeza adui zake pande zote.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umeme wake wa radi humulika dunia,","poem":1},{"text":"nchi huona na kutetemeka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Milima huyeyuka kama nta mbele za Bwana,","poem":1},{"text":"mbele za Bwana wa dunia yote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mbingu zinatangaza haki yake,","poem":1},{"text":"na mataifa yote huona utukufu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wote waabuduo sanamu waaibishwa,","poem":1},{"text":"wale wajisifiao sanamu:","poem":2},{"lineBreak":true},{"text":"mwabuduni yeye, enyi miungu yote!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sayuni husikia na kushangilia,","poem":1},{"text":"vijiji vya Yuda vinafurahi","poem":2},{"lineBreak":true},{"text":"kwa sababu ya hukumu zako, Ee Bwana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa kuwa wewe, Ee Bwana, ndiwe Uliye Juu Sana kuliko dunia yote;","poem":1},{"text":"umetukuka sana juu ya miungu yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wale wanaompenda Bwana na wauchukie uovu,","poem":1},{"text":"kwa maana yeye hulinda maisha ya waaminifu wake","poem":2},{"lineBreak":true},{"text":"na kuwaokoa kutoka mkononi mwa mwovu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nuru huangaza wenye haki","poem":1},{"text":"na furaha kwa watu wanyofu wa moyo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Furahini katika Bwana, ninyi mlio wenye haki,","poem":1},{"text":"lisifuni jina lake takatifu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}