{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"heading","content":["Mungu Mtawala Wa Dunia"]},{"type":"hebrew_subtitle","content":["Zaburi."]},{"type":"verse","number":1,"content":[{"text":"Mwimbieni Bwana wimbo mpya,","poem":1},{"text":"kwa maana ametenda mambo ya ajabu;","poem":2},{"text":"kitanga chake cha kuume na mkono wake mtakatifu","poem":1},{"text":"umemfanyia wokovu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwana ameufanya wokovu wake ujulikane","poem":1},{"text":"na amedhihirisha haki yake kwa mataifa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ameukumbuka upendo wake","poem":1},{"text":"na uaminifu wake kwa nyumba ya Israeli;","poem":2},{"text":"miisho yote ya dunia imeuona","poem":1},{"text":"wokovu wa Mungu wetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mpigieni Bwana kelele za shangwe, dunia yote,","poem":1},{"text":"ipaze sauti kwa nyimbo za shangwe na vinanda;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"mwimbieni Bwana kwa kinubi,","poem":1},{"text":"kwa kinubi na sauti za kuimba,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kwa tarumbeta na mvumo wa baragumu za pembe za kondoo dume:","poem":1},{"text":"shangilieni kwa furaha mbele za Bwana, aliye Mfalme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bahari na ivume na kila kiliomo ndani yake,","poem":1},{"text":"dunia na wote wakaao ndani yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mito na ipige makofi,","poem":1},{"text":"milima na iimbe pamoja kwa furaha,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"vyote na viimbe mbele za Bwana,","poem":1},{"text":"kwa maana yuaja kuhukumu dunia.","poem":2},{"text":"Atahukumu dunia kwa haki","poem":1},{"text":"na mataifa kwa haki.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}