{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_bib","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d44493dcc83a69de5b276652edc2bd17a6b319a7194a0eb85bdd0c59de971b32","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_bib/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["Mungu Mfalme Mkuu"]},{"type":"verse","number":1,"content":[{"text":"Bwana anatawala,","poem":1},{"text":"mataifa na yatetemeke;","poem":2},{"text":"anakalia kiti cha enzi katikati ya makerubi,","poem":1},{"text":"dunia na itikisike.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwana ni mkuu katika Sayuni;","poem":1},{"text":"ametukuzwa juu ya mataifa yote.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wanalisifu jina lako ambalo ni kuu na la kuogopwa:","poem":1},{"text":"yeye ni mtakatifu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mfalme ni mwenye nguvu na hupenda haki,","poem":1},{"text":"wewe umethibitisha adili;","poem":2},{"text":"katika Yakobo umefanya","poem":1},{"text":"yaliyo haki na sawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mtukuzeni Bwana Mungu wetu,","poem":1},{"text":"na mkaabudu katika mahali pa kuwekea miguu yake;","poem":2},{"lineBreak":true},{"text":"yeye ni mtakatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mose na Aroni walikuwa miongoni mwa makuhani wake,","poem":1},{"text":"Samweli alikuwa miongoni mwa walioliitia jina lake;","poem":2},{"text":"walimwita Bwana,","poem":1},{"text":"naye aliwajibu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alizungumza nao kutoka nguzo ya wingu;","poem":1},{"text":"walizishika sheria zake na amri alizowapa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Bwana, wetu,","poem":1},{"text":"ndiwe uliyewajibu,","poem":2},{"text":"kwa Israeli ulikuwa Mungu mwenye kusamehe,","poem":1},{"text":"ingawa uliadhibu matendo yao mabaya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mtukuzeni Bwana Mungu wetu,","poem":1},{"text":"mwabuduni kwenye mlima wake mtakatifu,","poem":2},{"lineBreak":true},{"text":"kwa maana Bwana Mungu wetu ni mtakatifu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}