{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"SNG","translationId":"swh_bib","name":"Wimbo Ulio Bora","commonName":"Wimbo Ulio Bora","title":"Wimbo Ulio Bora","order":22,"numberOfChapters":8,"sha256":"8e585afda8366de99ef6ffcd4926d7a513e113fdd16b6e066b0317be671bbc17","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swh_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Mimi ni ua la Sharoni,","poem":1},{"text":"yungiyungi ya bondeni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama yungiyungi katikati ya miiba","poem":1},{"text":"ndivyo alivyo mpenzi wangu katikati ya wanawali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kama mti wa mtofaa miongoni mwa miti ya msituni","poem":1},{"text":"ndivyo alivyo mpenzi wangu","poem":2},{"lineBreak":true},{"text":"miongoni mwa wanaume vijana.","poem":2},{"text":"Ninafurahia kuketi kivulini mwa mwanaume huyu,","poem":1},{"text":"na tunda lake ni tamu kwangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amenichukua mpaka kwenye ukumbi wa karamu,","poem":1},{"text":"na bendera ya huyu mwanaume","poem":2},{"lineBreak":true},{"text":"juu yangu ni upendo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nitie nguvu kwa zabibu kavu,","poem":1},{"text":"niburudishe kwa matofaa,","poem":2},{"lineBreak":true},{"text":"kwa maana ninazimia kwa mapenzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mkono wake wa kushoto uko chini ya kichwa changu,","poem":1},{"text":"na mkono wake wa kuume unanikumbatia.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Binti za Yerusalemu, ninawaagiza","poem":1},{"text":"kwa paa na kwa ayala wa shambani:","poem":2},{"text":"Msichochee wala kuamsha mapenzi","poem":1},{"text":"hata yatakapotaka yenyewe.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Shairi La Pili"]},{"type":"verse","number":8,"content":[{"text":"Sikiliza! Mpenzi wangu!","poem":1},{"text":"Tazama! Huyu hapa anakuja,","poem":2},{"text":"akirukaruka juu milimani","poem":1},{"text":"akizunguka juu ya vilima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mpenzi wangu ni kama paa au ayala kijana.","poem":1},{"text":"Tazama! Anasimama nyuma ya ukuta wetu,","poem":2},{"text":"akitazama kupitia madirishani,","poem":1},{"text":"akichungulia kimiani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mpenzi wangu alizungumza na kuniambia,","poem":1},{"text":"“Inuka, mpenzi wangu,","poem":2},{"lineBreak":true},{"text":"mrembo wangu, tufuatane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tazama! Wakati wa masika umepita,","poem":1},{"text":"mvua imekwisha na ikapita.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maua yanatokea juu ya nchi;","poem":1},{"text":"majira ya kuimba yamewadia,","poem":2},{"text":"sauti za njiwa zinasikika","poem":1},{"text":"katika nchi yetu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mtini unatunga matunda yake ya mwanzoni,","poem":1},{"text":"zabibu zinazochanua zaeneza harufu nzuri.","poem":2},{"text":"Inuka, njoo mpenzi wangu.","poem":1},{"text":"Mrembo wangu, tufuatane.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hua wangu penye nyufa za majabali,","poem":1},{"text":"mafichoni pembezoni mwa mlima,","poem":2},{"text":"nionyeshe uso wako,","poem":1},{"text":"na niisikie sauti yako,","poem":2},{"text":"kwa maana sauti yako ni tamu,","poem":1},{"text":"na uso wako unapendeza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tukamatie mbweha,","poem":1},{"text":"mbweha wale wadogo","poem":2},{"text":"wanaoharibu mashamba ya mizabibu,","poem":1},{"text":"mashamba yetu ya mizabibu yaliyochanua.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mpenzi wangu ni wangu, nami ni wake,","poem":1},{"text":"yeye hujilisha katikati ya yungiyungi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mpaka jua linapochomoza,","poem":1},{"text":"na vivuli vikimbie,","poem":2},{"text":"rudi, mpenzi wangu,","poem":1},{"text":"na uwe kama paa,","poem":2},{"text":"au kama ayala kijana","poem":1},{"text":"juu ya vilima vya Betheri.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}