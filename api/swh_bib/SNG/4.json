{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"SNG","translationId":"swh_bib","name":"Wimbo Ulio Bora","commonName":"Wimbo Ulio Bora","title":"Wimbo Ulio Bora","order":22,"numberOfChapters":8,"sha256":"8e585afda8366de99ef6ffcd4926d7a513e113fdd16b6e066b0317be671bbc17","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swh_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Tazama jinsi ulivyo mzuri, mpenzi wangu!","poem":1},{"text":"Ee, jinsi ulivyo mzuri!","poem":2},{"text":"Macho yako nyuma ya shela yako","poem":1},{"text":"ni kama ya hua.","poem":2},{"text":"Nywele zako ni kama kundi la mbuzi","poem":1},{"text":"zikishuka kutoka Mlima Gileadi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Meno yako ni kama kundi la kondoo waliokatwa manyoya sasa hivi,","poem":1},{"text":"watokao kuogeshwa.","poem":2},{"text":"Kila mmoja ana pacha lake,","poem":1},{"text":"hakuna hata mmoja aliye peke yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Midomo yako ni kama uzi mwekundu,","poem":1},{"text":"kinywa chako kinapendeza.","poem":2},{"text":"Mashavu yako nyuma ya shela yako","poem":1},{"text":"ni kama vipande viwili vya komamanga.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shingo yako ni kama mnara wa Daudi,","poem":1},{"text":"uliojengwa kwa madaha,","poem":2},{"text":"juu yake zimetundikwa ngao elfu,","poem":1},{"text":"zote ni ngao za mashujaa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Matiti yako mawili ni kama wana-paa wawili,","poem":1},{"text":"kama wana-paa mapacha","poem":2},{"lineBreak":true},{"text":"wajilishao katikati ya yungiyungi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hata kupambazuke na vivuli vikimbie,","poem":1},{"text":"nitakwenda kwenye mlima wa manemane","poem":2},{"lineBreak":true},{"text":"na kwenye kilima cha uvumba.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wewe ni mzuri kote, mpenzi wangu,","poem":1},{"text":"hakuna hitilafu ndani yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Enda nami kutoka Lebanoni, bibi arusi wangu,","poem":1},{"text":"enda nami kutoka Lebanoni.","poem":2},{"text":"Shuka kutoka ncha ya Amana,","poem":1},{"text":"kutoka juu ya Seniri, kilele cha Hermoni,","poem":2},{"text":"kutoka mapango ya simba","poem":1},{"text":"na kutoka mlima wapendapo kukaa chui.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umeiba moyo wangu, dada yangu, bibi arusi wangu;","poem":1},{"text":"umeiba moyo wangu","poem":2},{"text":"kwa mtazamo mmoja wa macho yako,","poem":1},{"text":"kwa kito kimoja cha mkufu wako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tazama jinsi pendo lako linavyofurahisha,","poem":1},{"text":"dada yangu, bibi arusi wangu!","poem":2},{"text":"Pendo lako linafurahisha aje zaidi ya divai,","poem":1},{"text":"na harufu ya manukato yako zaidi ya kikolezo chochote!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Midomo yako inadondosha utamu kama sega la asali,","poem":1},{"text":"bibi arusi wangu;","poem":2},{"text":"maziwa na asali viko chini ya ulimi wako.","poem":1},{"text":"Harufu nzuri ya mavazi yako ni kama ile ya Lebanoni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wewe ni bustani iliyofungwa, dada yangu,","poem":1},{"text":"bibi arusi wangu;","poem":2},{"text":"wewe ni chanzo cha maji kilichozungushiwa kabisa,","poem":1},{"text":"chemchemi yangu peke yangu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mimea yako ni bustani ya mikomamanga","poem":1},{"text":"yenye matunda mazuri sana,","poem":2},{"lineBreak":true},{"text":"yenye hina na nardo,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nardo na zafarani,","poem":1},{"text":"mchai na mdalasini,","poem":2},{"lineBreak":true},{"text":"pamoja na kila aina ya mti wa uvumba,","poem":2},{"lineBreak":true},{"text":"manemane na udi,","poem":2},{"lineBreak":true},{"text":"na aina zote za vikolezo bora kuliko vyote.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wewe ni chemchemi ya bustani,","poem":1},{"text":"kisima cha maji yatiririkayo,","poem":2},{"lineBreak":true},{"text":"yakitiririka kutoka Lebanoni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Amka, upepo wa kaskazini,","poem":1},{"text":"na uje, upepo wa kusini!","poem":2},{"lineBreak":true},{"text":"Vuma juu ya bustani yangu,","poem":2},{"lineBreak":true},{"text":"ili harufu yake nzuri iweze kuenea mpaka ngʼambo.","poem":2},{"text":"Mpendwa wangu na aje bustanini mwake","poem":1},{"text":"na kuonja matunda mazuri sana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}