{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"SNG","translationId":"swh_bib","name":"Wimbo Ulio Bora","commonName":"Wimbo Ulio Bora","title":"Wimbo Ulio Bora","order":22,"numberOfChapters":8,"sha256":"8e585afda8366de99ef6ffcd4926d7a513e113fdd16b6e066b0317be671bbc17","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swh_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"Mpenzi wako amekwenda wapi,","poem":1},{"text":"ewe mzuri kupita wanawake wote?","poem":2},{"text":"Mpenzi wako amegeukia njia ipi,","poem":1},{"text":"tupate kumtafuta pamoja nawe?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mpenzi wangu amekwenda bustanini mwake,","poem":1},{"text":"kwenye vitalu vya vikolezo,","poem":2},{"text":"kujilisha bustanini","poem":1},{"text":"na kukusanya yungiyungi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mimi ni wake mpenzi wangu,","poem":1},{"text":"na mpenzi wangu ni wangu;","poem":2},{"lineBreak":true},{"text":"yeye hujilisha katikati ya yungiyungi.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Shairi La Tano"]},{"type":"verse","number":4,"content":[{"text":"Wewe ni mzuri, mpenzi wangu, kama Tirsa,","poem":1},{"text":"upendezaye kama Yerusalemu,","poem":2},{"lineBreak":true},{"text":"umetukuka kama jeshi lenye bendera.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Uyageuze macho yako mbali nami,","poem":1},{"text":"yananigharikisha.","poem":2},{"text":"Nywele zako ni kama kundi la mbuzi","poem":1},{"text":"wanaoteremka kutoka Gileadi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Meno yako ni kama kundi la kondoo","poem":1},{"text":"watokao kuogeshwa.","poem":2},{"text":"Kila mmoja ana pacha lake,","poem":1},{"text":"hakuna hata mmoja aliye peke yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mashavu yako nyuma ya shela yako","poem":1},{"text":"ni kama vipande viwili vya komamanga.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Panaweza kuwepo malkia sitini,","poem":1},{"text":"masuria themanini","poem":2},{"lineBreak":true},{"text":"na mabikira wasiohesabika;","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lakini hua wangu, mkamilifu wangu,","poem":1},{"text":"ni wa namna ya pekee,","poem":2},{"text":"binti pekee kwa mama yake,","poem":1},{"text":"kipenzi cha yeye aliyemzaa.","poem":2},{"text":"Wanawali walimwona na kumwita aliyebarikiwa;","poem":1},{"text":"malkia na masuria walimsifu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ni nani huyu atokeaye kama mapambazuko,","poem":1},{"text":"mzuri kama mwezi, mwangavu kama jua,","poem":2},{"lineBreak":true},{"text":"ametukuka kama nyota zifuatanazo?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Niliteremka kwenye bustani ya miti ya milozi","poem":1},{"text":"ili kutazama machipuko ya bondeni,","poem":2},{"text":"kuona kama mizabibu imechipua","poem":1},{"text":"au kama mikomamanga imechanua maua.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kabla sijangʼamua,","poem":1},{"text":"shauku yangu iliniweka","poem":2},{"lineBreak":true},{"text":"katikati ya magari ya kifalme ya kukokotwa na farasi ya watu wangu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Rudi, rudi, ee Mshulami;","poem":1},{"text":"rudi, rudi ili tupate kukutazama!","poem":2},"Mpenzi",{"text":"Kwa nini kumtazama Mshulami,","poem":1},{"text":"kama kutazama ngoma ya Mahanaimu?","poem":2},{"noteId":0}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"Mahanaimu hapa ina maana ya majeshi mawili.","reference":{"chapter":6,"verse":13}}]},"thisChapterLink":"/api/swh_bib/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}