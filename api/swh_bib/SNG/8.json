{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"SNG","translationId":"swh_bib","name":"Wimbo Ulio Bora","commonName":"Wimbo Ulio Bora","title":"Wimbo Ulio Bora","order":22,"numberOfChapters":8,"sha256":"8e585afda8366de99ef6ffcd4926d7a513e113fdd16b6e066b0317be671bbc17","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swh_bib/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Laiti ungelikuwa kwangu kama ndugu wa kiume,","poem":1},{"text":"ambaye aliyanyonya matiti ya mama yangu!","poem":2},{"text":"Kisha, kama ningekukuta huko nje,","poem":1},{"text":"ningelikubusu,","poem":2},{"lineBreak":true},{"text":"wala hakuna mtu yeyote angelinidharau.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ningelikuongoza na kukuleta","poem":1},{"text":"katika nyumba ya mama yangu,","poem":2},{"lineBreak":true},{"text":"yeye ambaye amenifundisha.","poem":2},{"text":"Ningelikupa divai iliyokolezwa unywe,","poem":1},{"text":"asali ya maua ya mikomamanga yangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mkono wake wa kushoto uko chini ya kichwa changu,","poem":1},{"text":"na mkono wake wa kuume unanikumbatia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Binti za Yerusalemu, ninawaagiza:","poem":1},{"text":"msichochee wala kuamsha mapenzi","poem":2},{"lineBreak":true},{"text":"hata yatakapotaka yenyewe.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Shairi La Sita"]},{"type":"verse","number":5,"content":[{"text":"Ni nani huyu anayekuja kutoka nyikani","poem":1},{"text":"akimwegemea mpenzi wake?","poem":2},"Mpendwa",{"text":"Nilikuamsha chini ya mtofaa,","poem":1},{"text":"huko mama yako alipotunga mimba yako,","poem":2},{"lineBreak":true},{"text":"huko yeye alipata utungu akakuzaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nitie kama muhuri moyoni mwako,","poem":1},{"text":"kama muhuri kwenye mkono wako;","poem":2},{"text":"kwa maana upendo una nguvu kama mauti,","poem":1},{"text":"wivu wake ni mkatili kama kuzimu.","poem":2},{"text":"Unachoma kama mwali wa moto,","poem":1},{"text":"kama mwali mkubwa wa moto wa Bwana hasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maji mengi hayawezi kuuzimisha upendo,","poem":1},{"text":"mito haiwezi kuugharikisha.","poem":2},{"text":"Kama mtu angelitoa mali yote ya nyumbani mwake","poem":1},{"text":"kwa ajili ya upendo,","poem":2},{"lineBreak":true},{"text":"angelidharauliwa kabisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tunaye dada mdogo,","poem":1},{"text":"matiti yake hayajakua bado.","poem":2},{"text":"Tutafanya nini kwa ajili ya dada yetu","poem":1},{"text":"wakati atakapokuja kuposwa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kama yeye ni ukuta,","poem":1},{"text":"tutajenga minara ya fedha juu yake.","poem":2},{"text":"Na kama yeye ni mlango,","poem":1},{"text":"tutamzungushia mbao za mierezi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mimi ni ukuta,","poem":1},{"text":"nayo matiti yangu ni kama minara.","poem":2},{"text":"Ndivyo ambavyo nimekuwa machoni pake","poem":1},{"text":"kama yule anayeleta utoshelevu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Solomoni alikuwa na shamba la mizabibu huko Baal-Hamoni;","poem":1},{"text":"alikodisha shamba lake la mizabibu kwa wapangaji.","poem":2},{"text":"Kila mmoja angeleta kwa ajili ya matunda yake","poem":1},{"text":"shekeli 1,000","poem":2},{"noteId":1},{"text":"za fedha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini shamba langu la mizabibu","poem":1},{"text":"ambalo ni langu mwenyewe","poem":2},{"lineBreak":true},{"text":"ni langu kutoa;","poem":2},{"text":"hizo shekeli 1,000 ni kwa ajili yako, ee Solomoni,","poem":1},{"text":"na shekeli mia mbili","poem":2},{"noteId":2},{"text":"ni kwa ajili","poem":2},{"lineBreak":true},{"text":"ya wale wanaotunza matunda yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wewe ukaaye bustanini","poem":1},{"text":"pamoja na marafiki mliohudhuria,","poem":2},{"lineBreak":true},{"text":"hebu nisikie sauti yako!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njoo, mpenzi wangu,","poem":1},{"text":"uwe kama swala","poem":2},{"text":"au kama ayala kijana","poem":1},{"text":"juu ya milima iliyojaa vikolezo.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Shekeli 1,000 ni kama kilo 11.5.","reference":{"chapter":8,"verse":11}},{"noteId":2,"caller":"+","text":"Shekeli 200 ni kama kilo 2.3.","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/swh_bib/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}