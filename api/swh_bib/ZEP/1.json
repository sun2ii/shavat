{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ZEP","translationId":"swh_bib","name":"Sefania","commonName":"Sefania","title":"Sefania","order":36,"numberOfChapters":3,"sha256":"3ccc858e418e5ffe756446b75728ca4b03411c1adad4f656b18d3ceca30fdf74","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Neno la Bwana lililomjia Sefania mwana wa Kushi, mwana wa Gedalia, mwana wa Amaria, mwana wa Hezekia, wakati wa utawala wa Yosia mwana wa Amoni mfalme wa Yuda:"]},{"type":"line_break"},{"type":"heading","content":["Onyo La Maangamizi Yanayokuja"]},{"type":"verse","number":2,"content":[{"text":"Bwana asema,","poem":1},{"text":"“Nitafagia kila kitu","poem":2},{"lineBreak":true},{"text":"kutoka kwenye uso wa dunia.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Nitafagilia mbali watu na wanyama;","poem":1},{"text":"nitafagilia mbali ndege wa angani","poem":2},{"lineBreak":true},{"text":"na samaki wa baharini.","poem":2},{"text":"Wafanyao maovu watapata tu kokoto,","poem":1},{"text":"nami nitamkatilia mbali mwanadamu atoke katika dunia,”","poem":2},{"text":"asema Bwana.","poem":4}]},{"type":"heading","content":["Dhidi Ya Yuda"]},{"type":"verse","number":4,"content":[{"text":"“Nitaiadhibu Yuda","poem":1},{"text":"na wote wakaao Yerusalemu.","poem":2},{"text":"Kutoka mahali hapa nitakatilia mbali","poem":1},{"text":"kila mabaki ya Baali,","poem":2},{"text":"majina ya wapagani na makuhani","poem":1},{"text":"waabuduo sanamu:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wale ambao husujudu juu ya mapaa","poem":1},{"text":"kuabudu jeshi la vitu vya angani,","poem":2},{"text":"wale ambao husujudu na kuapa kwa Bwana","poem":1},{"text":"na ambao pia huapa kwa Malkamu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wale wanaoacha kumfuata Bwana,","poem":1},{"text":"wala hawamtafuti Bwana","poem":2},{"lineBreak":true},{"text":"wala kutaka shauri lake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyamazeni mbele za Bwana Mwenyezi,","poem":1},{"text":"kwa maana siku ya Bwana iko karibu.","poem":2},{"text":"Bwana ameandaa dhabihu,","poem":1},{"text":"amewaweka wakfu wale aliowaalika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Katika siku ya dhabihu ya Bwana","poem":1},{"text":"nitawaadhibu wakuu","poem":2},{"lineBreak":true},{"text":"na wana wa mfalme","poem":2},{"text":"na wale wote wanaovaa","poem":1},{"text":"nguo za kigeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Katika siku hiyo nitaadhibu wote ambao","poem":1},{"text":"hukwepa kukanyaga kizingiti,","poem":2},{"text":"ambao hujaza hekalu la miungu yao","poem":1},{"text":"kwa dhuluma na udanganyifu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bwana asema, “Katika siku hiyo","poem":1},{"text":"kilio kitapanda juu kutoka lango la Samaki,","poem":2},{"lineBreak":true},{"text":"maombolezo kutoka mtaa wa pili,","poem":2},{"lineBreak":true},{"text":"na mshindo mkubwa kutoka vilimani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ombolezeni, ninyi mnaoishi katika eneo la sokoni;","poem":1},{"text":"wafanyabiashara wenu wote wameangamizwa,","poem":2},{"text":"wote ambao wanafanya biashara ya fedha","poem":1},{"text":"wataangamizwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wakati huo nitasaka mji wa Yerusalemu kwa taa,","poem":1},{"text":"na kuwaadhibu wale ambao","poem":2},{"lineBreak":true},{"text":"wanakaa katika hali ya kuridhika,","poem":2},{"text":"ambao ni kama divai","poem":1},{"text":"iliyobaki kwenye machicha,","poem":2},{"text":"ambao hudhani, ‘Bwana hatafanya lolote,","poem":1},{"text":"jema au baya.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Utajiri wao utatekwa nyara,","poem":1},{"text":"nyumba zao zitabomolewa.","poem":2},{"text":"Watajenga nyumba,","poem":1},{"text":"lakini hawataishi ndani yake;","poem":2},{"text":"watapanda mizabibu","poem":1},{"text":"lakini hawatakunywa divai yake.","poem":2}]},{"type":"heading","content":["Siku Kubwa Ya Bwana"]},{"type":"verse","number":14,"content":[{"text":"“Siku kubwa ya Bwana iko karibu:","poem":1},{"text":"iko karibu na inakuja haraka.","poem":2},{"text":"Sikilizeni! Kilio katika siku ya Bwana","poem":1},{"text":"kitakuwa kichungu,","poem":2},{"lineBreak":true},{"text":"hata shujaa atapiga kelele.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Siku ile ni siku ya ghadhabu,","poem":1},{"text":"siku ya fadhaa na dhiki,","poem":2},{"text":"siku ya uharibifu na ukiwa,","poem":1},{"text":"siku ya giza na utusitusi,","poem":2},{"lineBreak":true},{"text":"siku ya mawingu na giza nene,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"siku ya tarumbeta na mlio wa vita","poem":1},{"text":"dhidi ya miji yenye ngome","poem":2},{"lineBreak":true},{"text":"na dhidi ya minara mirefu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nitawaletea watu dhiki,","poem":1},{"text":"nao watatembea kama vipofu,","poem":2},{"text":"kwa sababu wametenda dhambi","poem":1},{"text":"dhidi ya Bwana.","poem":2},{"text":"Damu yao itamwagwa kama vumbi","poem":1},{"text":"na matumbo yao kama taka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Fedha yao wala dhahabu yao","poem":1},{"text":"hazitaweza kuwaokoa","poem":2},{"lineBreak":true},{"text":"katika siku hiyo ya ghadhabu ya Bwana.","poem":2},{"text":"Katika moto wa wivu wake","poem":1},{"text":"dunia yote itateketezwa,","poem":2},{"text":"kwa maana ataleta mwisho","poem":1},{"text":"wa wote wanaoishi katika dunia ghafula.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}