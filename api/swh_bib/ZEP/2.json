{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ZEP","translationId":"swh_bib","name":"Sefania","commonName":"Sefania","title":"Sefania","order":36,"numberOfChapters":3,"sha256":"3ccc858e418e5ffe756446b75728ca4b03411c1adad4f656b18d3ceca30fdf74","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Kusanyikeni pamoja, kusanyikeni pamoja,","poem":1},{"text":"enyi taifa lisilo na aibu,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kabla ya wakati ulioamriwa haujafika","poem":1},{"text":"na siku ile inayopeperusha kama makapi,","poem":2},{"text":"kabla hasira kali ya Bwana haijaja juu yenu,","poem":1},{"text":"kabla siku ya ghadhabu ya Bwana","poem":2},{"lineBreak":true},{"text":"haijaja juu yenu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mtafuteni Bwana, enyi nyote wanyenyekevu wa nchi,","poem":1},{"text":"ninyi ambao hufanya lile analoamuru.","poem":2},{"text":"Tafuteni haki, tafuteni unyenyekevu;","poem":1},{"text":"labda mtahifadhiwa","poem":2},{"lineBreak":true},{"text":"siku ya hasira ya Bwana.","poem":2}]},{"type":"heading","content":["Dhidi Ya Ufilisti"]},{"type":"verse","number":4,"content":[{"text":"Gaza utaachwa","poem":1},{"text":"na Ashkeloni utaachwa magofu.","poem":2},{"text":"Wakati wa adhuhuri Ashdodi utaachwa mtupu","poem":1},{"text":"na Ekroni utangʼolewa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ole wenu ninyi ambao mnaishi kando ya bahari,","poem":1},{"text":"enyi Wakerethi;","poem":2},{"text":"neno la Bwana liko dhidi yenu,","poem":1},{"text":"ee Kanaani, nchi ya Wafilisti.","poem":2},{"lineBreak":true},{"text":"“Mimi nitawaangamiza,","poem":1},{"text":"na hakuna atakayebaki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nchi kando ya bahari, mahali ambapo wanaishi Wakerethi,","poem":1},{"text":"patakuwa mahali pa wachungaji","poem":2},{"lineBreak":true},{"text":"na mazizi ya kondoo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Itakuwa mali ya mabaki ya nyumba ya Yuda,","poem":1},{"text":"hapo watapata malisho.","poem":2},{"text":"Wakati wa jioni watajilaza chini","poem":1},{"text":"katika nyumba za Ashkeloni.","poem":2},{"text":"Bwana Mungu wao atawatunza,","poem":1},{"text":"naye atawarudishia wafungwa wao.","poem":2}]},{"type":"heading","content":["Dhidi Ya Moabu Na Amoni"]},{"type":"verse","number":8,"content":[{"text":"“Nimeyasikia matukano ya Moabu","poem":1},{"text":"nazo dhihaka za Waamoni,","poem":2},{"text":"ambao waliwatukana watu wangu","poem":1},{"text":"na kutoa vitisho dhidi ya nchi yao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hakika, kama niishivyo,”","poem":1},{"text":"asema Bwana Mwenye Nguvu Zote,","poem":2},{"lineBreak":true},{"text":"Mungu wa Israeli,","poem":2},{"text":"“hakika Moabu itakuwa kama Sodoma,","poem":1},{"text":"Waamoni kama Gomora:","poem":2},{"text":"mahali pa magugu na mashimo ya chumvi,","poem":1},{"text":"nchi ya ukiwa milele.","poem":2},{"text":"Mabaki ya watu wangu watawateka nyara;","poem":1},{"text":"mabaki ya taifa langu watarithi nchi yao.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hiki ndicho watarudishiwa kwa ajili ya kiburi chao,","poem":1},{"text":"kwa kutukana na kudhihaki","poem":2},{"lineBreak":true},{"text":"watu wa Bwana Mwenye Nguvu Zote.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bwana atakuwa wa kuhofisha kwao","poem":1},{"text":"atakapoangamiza miungu yote ya nchi.","poem":2},{"text":"Mataifa katika kila pwani yatamwabudu,","poem":1},{"text":"kila moja katika nchi yake.","poem":2}]},{"type":"heading","content":["Dhidi Ya Kushi"]},{"type":"verse","number":12,"content":[{"text":"“Ninyi pia, ee Wakushi,","poem":1},{"text":"mtauawa kwa upanga wangu.”","poem":2}]},{"type":"heading","content":["Dhidi Ya Ashuru"]},{"type":"verse","number":13,"content":[{"text":"Mungu atanyoosha mkono wake dhidi ya kaskazini","poem":1},{"text":"na kuangamiza Waashuru,","poem":2},{"text":"akiiacha Ninawi ukiwa","poem":1},{"text":"na pakame kama jangwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Makundi ya kondoo na ngʼombe yatajilaza pale,","poem":1},{"text":"viumbe vya kila aina.","poem":2},{"text":"Bundi wa jangwani na bundi waliao kwa sauti nyembamba","poem":1},{"text":"wataishi juu ya nguzo zake.","poem":2},{"text":"Mwangwi wa kuita kwao utapita madirishani,","poem":1},{"text":"kifusi kitakuwa milangoni,","poem":2},{"lineBreak":true},{"text":"boriti za mierezi zitaachwa wazi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Huu ndio mji uliotukuka na kuishi kwa furaha","poem":1},{"text":"wakijisikia salama.","poem":2},{"text":"Ulisema moyoni mwako,","poem":1},{"text":"“Mimi ndimi, na wala hapana mwingine ila mimi.”","poem":2},{"text":"Jinsi gani umekuwa gofu,","poem":1},{"text":"mahali pa kulala wanyama pori!","poem":2},{"text":"Wote wanaopita kando yake wanauzomea","poem":1},{"text":"na kutikisa mkono kwa dharau.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}