{"translation":{"id":"swh_bib","name":"Biblica® Toleo Wazi Neno: Bibilia Takatifu™","website":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonen","licenseNotes":null,"shortName":"BIB","englishName":"Kiswahili Contemporary Version","language":"swh","textDirection":"ltr","sha256":"e8578ff09a2e15f881cdc52bcd19792afe320ee6add595f700df5355ea5d22c9","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_bib/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ZEP","translationId":"swh_bib","name":"Sefania","commonName":"Sefania","title":"Sefania","order":36,"numberOfChapters":3,"sha256":"3ccc858e418e5ffe756446b75728ca4b03411c1adad4f656b18d3ceca30fdf74","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_bib/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_bib/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["Hatima Ya Yerusalemu"]},{"type":"verse","number":1,"content":[{"text":"Ole mji wa wadhalimu,","poem":1},{"text":"waasi na waliotiwa unajisi!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hautii mtu yeyote,","poem":1},{"text":"haukubali maonyo.","poem":2},{"text":"Haumtumaini Bwana,","poem":1},{"text":"haukaribii karibu na Mungu wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maafisa wake ni simba wangurumao,","poem":1},{"text":"watawala wake ni mbwa mwitu wa jioni,","poem":2},{"text":"ambao hawabakizi chochote","poem":1},{"text":"kwa ajili ya asubuhi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Manabii wake ni wenye kiburi,","poem":1},{"text":"ni wadanganyifu.","poem":2},{"text":"Makuhani wake hunajisi patakatifu","poem":1},{"text":"na kuihalifu sheria.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bwana aliye ndani yake ni mwenye haki,","poem":1},{"text":"hafanyi kosa.","poem":2},{"text":"Asubuhi kwa asubuhi hutoa haki yake,","poem":1},{"text":"kila kukipambazuka huitimiza,","poem":2},{"lineBreak":true},{"text":"bali mtu dhalimu hana aibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nimeyafutilia mbali mataifa,","poem":1},{"text":"ngome zao zimebomolewa.","poem":2},{"text":"Nimeziacha barabara ukiwa,","poem":1},{"text":"hakuna anayepita humo.","poem":2},{"text":"Miji yao imeharibiwa;","poem":1},{"text":"hakuna mmoja atakayeachwa:","poem":2},{"lineBreak":true},{"text":"hakuna hata mmoja.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Niliuambia huo mji,","poem":1},{"text":"‘Hakika utaniogopa na kukubali maonyo!’","poem":2},{"text":"Ndipo makao yake hayatafutiliwa mbali,","poem":1},{"text":"wala adhabu zangu zote hazitakuja juu yake.","poem":2},{"text":"Lakini walikuwa bado na shauku","poem":1},{"text":"kutenda kwa upotovu katika yote waliyofanya.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bwana anasema,","poem":1},{"text":"“Kwa hiyo ningojee mimi,","poem":2},{"lineBreak":true},{"text":"siku nitakayosimama kuteka nyara.","poem":2},{"text":"Nimeamua kukusanya mataifa,","poem":1},{"text":"kukusanya falme","poem":2},{"text":"na kumimina ghadhabu yangu juu yao,","poem":1},{"text":"hasira yangu kali yote.","poem":2},{"text":"Dunia yote itateketezwa","poem":1},{"text":"kwa moto wa wivu wa hasira yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ndipo nitatakasa midomo ya mataifa,","poem":1},{"text":"kwamba wote waweze kuliitia jina la Bwana","poem":2},{"lineBreak":true},{"text":"na kumtumikia kwa pamoja.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kutoka ngʼambo ya mito ya Kushi","poem":1},{"text":"watu wangu wanaoniabudu,","poem":2},{"text":"watu wangu waliotawanyika,","poem":1},{"text":"wataniletea sadaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siku hiyo hutaaibishwa","poem":1},{"text":"kwa ajili ya makosa yote ulionitendea,","poem":2},{"text":"kwa sababu nitawaondoa kutoka mji huu","poem":1},{"text":"wale wote wanaoshangilia","poem":2},{"lineBreak":true},{"text":"katika kiburi chao.","poem":2},{"text":"Kamwe hutajivuna tena","poem":1},{"text":"katika kilima changu kitakatifu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini nitakuachia ndani yako","poem":1},{"text":"wapole na wanyenyekevu,","poem":2},{"lineBreak":true},{"text":"ambao wanatumaini jina la Bwana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mabaki ya Israeli hayatafanya kosa;","poem":1},{"text":"hawatasema uongo,","poem":2},{"text":"wala udanganyifu hautakuwa","poem":1},{"text":"katika vinywa vyao.","poem":2},{"text":"Watakula na kulala","poem":1},{"text":"wala hakuna yeyote","poem":2},{"lineBreak":true},{"text":"atakayewaogopesha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Imba, ee Binti Sayuni;","poem":1},{"text":"paza sauti, ee Israeli!","poem":2},{"text":"Furahi na kushangilia kwa moyo wako wote,","poem":1},{"text":"ee Binti Yerusalemu!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bwana amekuondolea adhabu yako,","poem":1},{"text":"amewarudisha nyuma adui zako.","poem":2},{"text":"Bwana, Mfalme wa Israeli, yu pamoja nawe;","poem":1},{"text":"kamwe hutaogopa tena madhara yoyote.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Katika siku hiyo watauambia Yerusalemu,","poem":1},{"text":"“Usiogope, ee Sayuni;","poem":2},{"lineBreak":true},{"text":"usiiache mikono yako ilegee.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Bwana Mungu wako yu pamoja nawe,","poem":1},{"text":"yeye ni mwenye nguvu kuokoa.","poem":2},{"text":"Atakufurahia kwa furaha kubwa,","poem":1},{"text":"atakutuliza kwa pendo lake,","poem":2},{"lineBreak":true},{"text":"atakufurahia kwa kuimba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Huzuni katika sikukuu zilizoamriwa","poem":1},{"text":"nitaziondoa kwenu;","poem":2},{"lineBreak":true},{"text":"hizo ni mzigo na fedheha kwenu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wakati huo nitawashughulikia","poem":1},{"text":"wote waliokudhulumu;","poem":2},{"text":"nitaokoa vilema na kukusanya","poem":1},{"text":"wale ambao wametawanywa.","poem":2},{"text":"Nitawapa sifa na heshima","poem":1},{"text":"katika kila nchi ambayo waliaibishwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wakati huo nitawakusanya;","poem":1},{"text":"wakati huo nitawaleta nyumbani.","poem":2},{"text":"Nitawapa sifa na heshima","poem":1},{"text":"miongoni mwa mataifa yote ya dunia","poem":2},{"text":"wakati nitakapowarudishia mateka yenu","poem":1},{"text":"mbele ya macho yenu hasa,”","poem":2},{"text":"asema Bwana.","poem":4}]}],"footnotes":[]},"thisChapterLink":"/api/swh_bib/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_bib/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_bib/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}