{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_onmm","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"41679c85ea7a24311678072a1fc1669e1cf8d6c9f09b1b42a822c3c63b7924a2","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_onmm/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["Mashahidi waitwa dhidi ya Israeli"]},{"type":"verse","number":1,"content":["Sikilizeni neno hili alilosema Mwenyezi Mungu dhidi yenu, enyi watu wa Israeli, dhidi ya jamaa nzima niliowapandisha toka Misri:"]},{"type":"verse","number":2,"content":[{"text":"“Ni ninyi tu niliowachagua","poem":1},{"text":"kati ya jamaa zote za dunia;","poem":2},{"text":"kwa hiyo nitawaadhibu","poem":1},{"text":"kwa ajili ya dhambi zenu zote.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Je, watu wawili hutembea pamoja","poem":1},{"text":"wasipokubaliana kufanya hivyo?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Je, simba hunguruma katika kichaka","poem":1},{"text":"wakati hana mawindo?","poem":2},{"text":"Aweza kuvuma katika pango","poem":1},{"text":"wakati ambao hajakamata chochote?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Je, ndege aweza kuanguka kwenye mtego ulio ardhini","poem":1},{"text":"ambapo hajategewa chambo?","poem":2},{"text":"Je, mtego unaweza kufyatuka toka ardhini","poem":1},{"text":"wakati hakuna chochote cha kunasa?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, tarumbeta inapopigwa mjini kujulisha hatari,","poem":1},{"text":"watu hawatetemeki?","poem":2},{"text":"Mji unapopatwa na maafa,","poem":1},{"text":"je, si Mwenyezi Mungu amesababisha?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Hakika Bwana Mungu Mwenyezi hatafanya neno lolote","poem":1},{"text":"bila kuwafunulia watumishi wake manabii siri yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Simba amenguruma:","poem":1},{"text":"je, ni nani ambaye hataogopa?","poem":2},{"text":"Bwana Mungu Mwenyezi ametamka:","poem":1},{"text":"je, ni nani awezaye kukosa kutoa unabii?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tangazeni katika ngome za Ashdodi","poem":1},{"text":"na katika ngome za Misri:","poem":2},{"text":"“Kusanyikeni juu ya milima ya Samaria;","poem":1},{"text":"angalieni wingi wa wasiwasi ulio ndani yake,","poem":2},{"lineBreak":true},{"text":"na uonevu ulio miongoni mwa watu wake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwenyezi Mungu asema: “Hawajui kutenda lililo jema,","poem":1},{"text":"wale ambao hujilundikia nyara","poem":2},{"lineBreak":true},{"text":"na vitu vilivyotekwa katika ngome zao.”","poem":2}]},{"type":"verse","number":11,"content":["Kwa hiyo hili ndilo asemalo Bwana Mungu Mwenyezi:",{"text":"“Adui ataizingira nchi;","poem":1},{"text":"ataangusha chini ngome zenu","poem":2},{"lineBreak":true},{"text":"na kuteka nyara maboma yenu.”","poem":2}]},{"type":"verse","number":12,"content":["Hili ndilo asemalo Mwenyezi Mungu:",{"text":"“Kama vile mchungaji aokoavyo kinywani mwa simba","poem":1},{"text":"vipande viwili tu vya mfupa wa mguu","poem":2},{"lineBreak":true},{"text":"au kipande cha sikio,","poem":2},{"text":"hivyo ndivyo Waisraeli watakavyookolewa,","poem":1},{"text":"wale wanaokaa Samaria","poem":2},{"lineBreak":true},{"text":"kwenye kingo za vitanda vyao,","poem":2},{"text":"na katika Dameski","poem":1},{"text":"kwenye viti vyao vya fahari.”","poem":2}]},{"type":"verse","number":13,"content":["“Sikia hili na ushuhudie dhidi ya nyumba ya Yakobo,” asema Bwana, yeye Bwana Mwenyezi Mungu, Mungu wa majeshi ya mbinguni."]},{"type":"verse","number":14,"content":[{"text":"“Siku nitakapomwadhibu Israeli kwa sababu ya dhambi zake,","poem":1},{"text":"nitaharibu madhabahu za Betheli;","poem":2},{"text":"pembe za madhabahu zitakatiliwa mbali","poem":1},{"text":"na kuanguka chini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitabomoa nyumba ya wakati wa masika,","poem":1},{"text":"pamoja na nyumba ya wakati wa kiangazi;","poem":2},{"text":"nyumba zilizonakshiwa kwa pembe za ndovu","poem":1},{"text":"na majumba makubwa ya fahari yatabomolewa,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}