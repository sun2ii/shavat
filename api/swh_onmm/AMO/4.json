{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_onmm","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"41679c85ea7a24311678072a1fc1669e1cf8d6c9f09b1b42a822c3c63b7924a2","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_onmm/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["Israeli hajamrudia Mwenyezi Mungu"]},{"type":"verse","number":1,"content":[{"text":"Sikilizeni neno hili, ninyi ng’ombe wa Bashani","poem":1},{"text":"mlioko juu ya Mlima Samaria,","poem":2},{"text":"ninyi wanawake mnaowadhulumu maskini,","poem":1},{"text":"na kuwagandamiza wahitaji,","poem":2},{"text":"na kuwaambia wanaume wenu,","poem":1},{"text":"“Tuleteeni vinywaji!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwana Mungu Mwenyezi ameapa kwa utakatifu wake:","poem":1},{"text":"“Hakika wakati utakuja","poem":2},{"text":"mtakapochukuliwa na kulabu,","poem":1},{"text":"na wanaosalia kwa ndoana za samaki.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nanyi mtaenda moja kwa moja","poem":1},{"text":"kupitia mahali palipobomolewa kwenye ukuta,","poem":2},{"lineBreak":true},{"text":"nanyi mtatupwa nje kuelekea Harmoni,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nendeni Betheli mkatende dhambi;","poem":1},{"text":"nendeni Gilgali mkazidi kutenda dhambi.","poem":2},{"text":"Leteni dhabihu zenu kila asubuhi,","poem":1},{"text":"zaka zenu kila mwaka wa tatu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mchome mkate uliotiwa chachu kama sadaka ya shukrani,","poem":1},{"text":"jisifuni kuhusu sadaka zenu za hiari:","poem":2},{"text":"jigambeni kwa ajili ya sadaka hizo, enyi Waisraeli,","poem":1},{"text":"kwa kuwa hili ndilo mnalopenda kulitenda,”","poem":2},{"lineBreak":true},{"text":"asema Bwana Mungu Mwenyezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Niliwapa njaa kwenye kila mji,","poem":1},{"text":"na ukosefu wa chakula katika kila mji,","poem":2},{"lineBreak":true},{"text":"hata hivyo bado hamjanirudia mimi,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Pia niliwazuilia ninyi mvua miezi mitatu","poem":1},{"text":"kabla ya kufikia mavuno.","poem":2},{"text":"Nilinyesha mvua kwenye mji mmoja,","poem":1},{"text":"lakini niliizuia mvua isinyeshe mji mwingine.","poem":2},{"text":"Shamba moja lilipata mvua,","poem":1},{"text":"na lingine halikupata, nalo likakauka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Watu walitangatanga mji hata mji kutafuta maji,","poem":1},{"text":"lakini hawakupata ya kuwatosha kunywa,","poem":2},{"lineBreak":true},{"text":"hata hivyo hamjanirudia mimi,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Mara nyingi nilizipiga bustani zenu na mashamba ya mizabibu,","poem":1},{"text":"niliyapiga kwa kutu na ukungu.","poem":2},{"text":"Nzige walitafuna tini zenu na miti ya mizeituni,","poem":1},{"text":"hata hivyo hamjanirudia mimi,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Niliwapelekea tauni miongoni mwenu","poem":1},{"text":"kama nilivyofanya kule Misri.","poem":2},{"text":"Niliwaua vijana wenu wa kiume kwa upanga,","poem":1},{"text":"na nikawachukua farasi wenu.","poem":2},{"text":"Nilijaza pua zenu kwa uvundo kutoka kambi zenu,","poem":1},{"text":"hata hivyo hamjanirudia mimi,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Niliwaangamiza baadhi yenu kama","poem":1},{"text":"nilivyoangamiza Sodoma na Gomora.","poem":2},{"text":"Mlikuwa kama kijiti kiwakacho kilichonyakuliwa motoni,","poem":1},{"text":"hata hivyo hamjanirudia,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Kwa hiyo hili ndilo nitakalowafanyia, Israeli,","poem":1},{"text":"na kwa sababu nitawafanyia hili,","poem":2},{"lineBreak":true},{"text":"jiandaeni kukutana na Mungu wenu, ee Israeli.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yeye ambaye hufanya milima, anaumba upepo,","poem":1},{"text":"na kufunua mawazo yake kwa mwanadamu,","poem":2},{"text":"yeye ageuzaye asubuhi kuwa giza,","poem":1},{"text":"na kukanyaga mahali pa juu pa nchi:","poem":2},{"text":"Bwana Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni","poem":2},{"lineBreak":true},{"text":"ndilo jina lake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}