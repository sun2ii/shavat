{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"AMO","translationId":"swh_onmm","name":"Amosi","commonName":"Amosi","title":"Amosi","order":30,"numberOfChapters":9,"sha256":"41679c85ea7a24311678072a1fc1669e1cf8d6c9f09b1b42a822c3c63b7924a2","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/swh_onmm/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["Ole kwa wanaoridhika"]},{"type":"verse","number":1,"content":[{"text":"Ole wenu ninyi mnaostarehe na kuridhika katika Sayuni,","poem":1},{"text":"na ninyi mnaojisikia salama juu ya Mlima Samaria,","poem":2},{"text":"ninyi watu mashuhuri wa taifa lililoendelea kuliko mataifa mengine,","poem":1},{"text":"ambao watu wa Israeli wanawategemea!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nendeni Kalne mkaone kutoka huko;","poem":1},{"text":"mwende hadi Hamathi iliyo kuu,","poem":2},{"lineBreak":true},{"text":"kisha mshuke hadi Gathi ya Wafilisti.","poem":2},{"text":"Je, wao ni bora kuliko falme zenu mbili?","poem":1},{"text":"Je, nchi yao ni kubwa kuliko yenu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mnaiweka mbali siku iliyo mbaya","poem":1},{"text":"na kuleta karibu utawala wa kuogofya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ninyi mnalala juu ya vitanda vilivyofunikwa kwa pembe za ndovu,","poem":1},{"text":"na kujinyoosha juu ya viti vya fahari.","poem":2},{"text":"Mnajilisha kwa wana-kondoo wazuri","poem":1},{"text":"na ndama walionenepeshwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ninyi mnapiga vinubi kama Daudi,","poem":1},{"text":"huku mkitunga nyimbo za vinanda mbalimbali.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mnakunywa mvinyo kwa bakuli zilizojazwa,","poem":1},{"text":"na mnajipaka mafuta mazuri,","poem":2},{"lineBreak":true},{"text":"lakini hamhuzuniki kwa maangamizi ya Yusufu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa hiyo mtakuwa miongoni mwa watu wa kwanza kwenda uhamishoni;","poem":1},{"text":"karamu zenu na kustarehe kutakoma.","poem":2}]},{"type":"heading","content":["Mwenyezi Mungu anachukia kiburi cha Israeli"]},{"type":"verse","number":8,"content":["Bwana Mungu Mwenyezi ameapa kwa nafsi yake mwenyewe: Bwana Mwenyezi Mungu, Mungu wa majeshi ya mbinguni, asema:",{"text":"“Nachukia kiburi cha Yakobo,","poem":1},{"text":"nachukia ngome zake;","poem":2},{"text":"nitautoa mji wao na kila kitu","poem":1},{"text":"kilicho ndani yake.”","poem":2}]},{"type":"verse","number":9,"content":["Kama watu kumi watabaki katika nyumba moja, wao pia watakufa."]},{"type":"verse","number":10,"content":["Kama jamaa ambaye atachoma miili akija ili kuitoa nje ya nyumba, na kumuuliza yeyote ambaye bado anajificha humo, “Je, yuko mtu yeyote pamoja nawe?” Naye akisema, “Hapana,” ndipo atakaposema, “Nyamaza! Haturuhusiwi kutaja jina la Mwenyezi Mungu.”"]},{"type":"verse","number":11,"content":[{"text":"Kwa kuwa Mwenyezi Mungu ameamuru,","poem":1},{"text":"naye atabomoa jumba kubwa vipande vipande","poem":2},{"lineBreak":true},{"text":"na nyumba ndogo vipande vidogo vidogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Je, farasi wanaweza kukimbia","poem":1},{"text":"kwenye miamba iliyochongoka?","poem":2},{"lineBreak":true},{"text":"Je, mtu aweza kulima kwa maksai huko?","poem":2},{"text":"Lakini mmegeuza haki kuwa sumu","poem":1},{"text":"na matunda ya uadilifu kuwa uchungu:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ninyi mnaoshangilia kushindwa kwa Lo-Debari","poem":1},{"text":"na kusema, “Je, hatukuteka Karnaimu","poem":2},{"lineBreak":true},{"text":"kwa nguvu zetu wenyewe?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Maana Bwana Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni, asema,","poem":2},{"text":"“Nitainua taifa dhidi yenu, ee nyumba ya Israeli,","poem":1},{"text":"nalo litawatesa kuanzia Lebo-Hamathi","poem":2},{"lineBreak":true},{"text":"hadi Bonde la Araba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}