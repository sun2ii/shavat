{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"DEU","translationId":"swh_onmm","name":"Kumbukumbu La Torati","commonName":"Kumbukumbu La Torati","title":"Kumbukumbu La Torati","order":5,"numberOfChapters":34,"sha256":"5d9da9c0dd28f731819fc5545fea742a7f90fc097f8c9ad12acf45b502bc31d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/swh_onmm/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"Sikilizeni, enyi mbingu, nami nitasema;","poem":1},{"text":"sikia, ee nchi, maneno ya kinywa changu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mafundisho yangu na yanyeshe kama mvua,","poem":1},{"text":"na maneno yangu na yashuke kama umande,","poem":2},{"text":"kama manyunyu juu ya majani mabichi,","poem":1},{"text":"kama mvua tele juu ya mimea myororo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nitalitangaza jina la Mwenyezi Mungu.","poem":1},{"text":"Naam, sifuni ukuu wa Mungu wetu!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yeye ni Mwamba, kazi zake ni kamilifu,","poem":1},{"text":"njia zake zote ni haki.","poem":2},{"text":"Mungu mwaminifu ambaye hakosei,","poem":1},{"text":"yeye ni mnyofu na mwenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wamefanya mambo ya upotovu mbele zake;","poem":1},{"text":"kwa aibu yao, wao si watoto wake tena,","poem":2},{"lineBreak":true},{"text":"lakini ni kizazi kilicho kiovu na kilichopotoka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, hii ndiyo njia ya kumlipa Mwenyezi Mungu,","poem":1},{"text":"enyi watu wajinga na wasio na busara?","poem":2},{"text":"Je, yeye siye Baba yenu, Muumba wenu,","poem":1},{"text":"aliyewafanya ninyi na kuwaumba?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumbuka siku za kale;","poem":1},{"text":"tafakari vizazi vya zamani vilivyopita.","poem":2},{"text":"Uliza baba yako, naye atakuambia,","poem":1},{"text":"wazee wako, nao watakueleza.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aliye Juu Sana alipowapa mataifa urithi wao,","poem":1},{"text":"alipogawanya wanadamu wote,","poem":2},{"text":"aliweka mipaka kwa ajili ya mataifa","poem":1},{"text":"sawasawa na hesabu ya wana wa Israeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa kuwa fungu la Mwenyezi Mungu ni watu wake,","poem":1},{"text":"Yakobo kura yake ya urithi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Katika nchi ya jangwa alimkuta,","poem":1},{"text":"katika nyika tupu ivumayo upepo.","poem":2},{"text":"Alimhifadhi na kumtunza;","poem":1},{"text":"akamlinda kama mboni ya jicho lake,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kama tai avurugaye kiota chake,","poem":1},{"text":"na kurukaruka juu ya makinda yake,","poem":2},{"text":"ambaye hutanda mabawa yake kuwadaka,","poem":1},{"text":"na huwachukua kwenye mabawa yake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mwenyezi Mungu peke yake alimwongoza;","poem":1},{"text":"hapakuwa na mungu mgeni pamoja naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Akamfanya apande sehemu zilizoinuka za nchi,","poem":1},{"text":"akamlisha kwa mavuno ya mashamba.","poem":2},{"text":"Akamlea kwa asali toka mwambani,","poem":1},{"text":"na kwa mafuta kutoka mwamba wa gumegume,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kwa jibini na maziwa kutoka makundi ya ng’ombe","poem":1},{"text":"na kutoka makundi ya mbuzi,","poem":2},{"lineBreak":true},{"text":"kwa mafuta ya wana-kondoo na mbuzi,","poem":2},{"text":"kwa kondoo dume wazuri wa Bashani,","poem":1},{"text":"na kwa ngano nzuri.","poem":2},{"text":"Ukanywa damu ya zabibu inayotoa povu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Yeshuruni","poem":1},{"noteId":6},{"text":"alinenepa na kupiga teke;","poem":1},{"text":"alikuwa na chakula tele,","poem":2},{"lineBreak":true},{"text":"akawa mzito na akapendeza sana.","poem":2},{"text":"Akamwacha Mungu aliyemuumba,","poem":1},{"text":"na kumkataa Mwamba Mwokozi wake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wakamfanya Mungu kuwa na wivu kwa miungu yao migeni,","poem":1},{"text":"na kumkasirisha kwa sanamu zao","poem":2},{"lineBreak":true},{"text":"za machukizo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wakatoa dhabihu kwa pepo, ambao si Mungu:","poem":1},{"text":"miungu wasiyoijua,","poem":2},{"lineBreak":true},{"text":"miungu iliyojitokeza siku za karibuni,","poem":2},{"lineBreak":true},{"text":"miungu ambayo baba zenu hawakuiogopa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mkamwacha Mwamba, aliyewazaa ninyi;","poem":1},{"text":"mkamsahau Mungu aliyewazaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwenyezi Mungu akaona hili, akawakataa,","poem":1},{"text":"kwa sababu alikasirishwa","poem":2},{"lineBreak":true},{"text":"na wanawe wa kiume na wa kike.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Akasema, “Nitawaficha uso wangu,","poem":1},{"text":"nami nione mwisho wao utakuwa nini,","poem":2},{"text":"kwa kuwa wao ni kizazi kilichopotoka,","poem":1},{"text":"watoto ambao si waaminifu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wamenifanya niwe na wivu","poem":1},{"text":"kwa kile ambacho si mungu,","poem":2},{"text":"na kunikasirisha","poem":1},{"text":"kwa sanamu zao batili.","poem":2},{"text":"Nitawafanya wawaonee wivu wale ambao si taifa.","poem":1},{"text":"Nitawafanya wakasirishwe","poem":2},{"lineBreak":true},{"text":"na taifa lile lisilo na ufahamu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kwa maana moto umewashwa kwa hasira yangu,","poem":1},{"text":"ule uwakao hadi kwenye vina vya mauti.","poem":2},{"text":"Utateketeza dunia pamoja na mazao yake,","poem":1},{"text":"na kuwasha moto katika misingi ya milima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Nitalundika majanga juu yao","poem":1},{"text":"na kutumia mishale yangu dhidi yao.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nitatuma njaa ya kudhoofisha dhidi yao,","poem":1},{"text":"maradhi mabaya yateketezayo,","poem":2},{"lineBreak":true},{"text":"na tauni ya kufisha;","poem":2},{"text":"nitawapelekea wanyama mwitu wenye meno makali,","poem":1},{"text":"na nyoka wenye sumu watambaao mavumbini.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Barabarani upanga utawakosesha watoto;","poem":1},{"text":"nyumbani mwao hofu itatawala.","poem":2},{"text":"Vijana wao wa kiume na wa kike wataangamia,","poem":1},{"text":"pia watoto wachanga na wazee wenye mvi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nilisema ningewatawanya","poem":1},{"text":"na kufuta kumbukumbu lao","poem":2},{"lineBreak":true},{"text":"katika mwanadamu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Lakini nilihofia dhihaka za adui,","poem":1},{"text":"adui asije akashindwa kuelewa,","poem":2},{"text":"na kusema, ‘Mikono yetu imeshinda;","poem":1},{"text":"Mwenyezi Mungu hakufanya haya yote.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wao ni taifa lisilo na akili,","poem":1},{"text":"hakuna busara ndani yao.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Laiti wangekuwa na hekima wangefahamu hili,","poem":1},{"text":"na kutambua mwisho wao utakuwaje!","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mtu mmoja angewezaje kufukuza elfu moja,","poem":1},{"text":"au wawili kufukuza elfu kumi,","poem":2},{"text":"kama si kwamba Mwamba wao amewauza,","poem":1},{"text":"kama si kwamba Mwenyezi Mungu amewaacha?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kwa kuwa mwamba wao si kama Mwamba wetu,","poem":1},{"text":"sawasawa na vile adui zetu wanavyokiri.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mzabibu wao unatoka mzabibu wa Sodoma,","poem":1},{"text":"na kutoka mashamba ya Gomora.","poem":2},{"text":"Zabibu zake zimejaa sumu,","poem":1},{"text":"na vishada vyake vimejaa uchungu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mvinyo wao ni sumu ya nyoka,","poem":1},{"text":"sumu yenye kufisha ya swila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Je, hili sikuliweka akiba","poem":1},{"text":"na kulifungia kwenye vyumba vyangu vya hazina?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ni juu yangu kulipiza kisasi; nitalipiza.","poem":1},{"text":"Wakati utakapowadia, mguu wao utateleza;","poem":2},{"text":"siku yao ya maafa ni karibu,","poem":1},{"text":"na maangamizi yao yanawajia haraka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"Mwenyezi Mungu atawahukumu watu wake,","poem":1},{"text":"na kuwahurumia watumishi wake","poem":2},{"text":"atakapoona nguvu zao zimekwisha","poem":1},{"text":"wala hakuna yeyote aliyebaki,","poem":2},{"lineBreak":true},{"text":"mtumwa au aliye huru.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Atasema: “Sasa iko wapi miungu yao,","poem":1},{"text":"mwamba walioukimbilia,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"miungu wale waliokula mafuta ya dhabihu zao","poem":1},{"text":"na kunywa mvinyo wa sadaka zao za vinywaji?","poem":2},{"text":"Wainuke basi, wawasaidie!","poem":1},{"text":"Wawapeni basi ulinzi!","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Tazama basi, Mimi mwenyewe, Mimi Ndiye!","poem":1},{"text":"Hakuna mungu mwingine ila Mimi.","poem":2},{"text":"Mimi ninaua na Mimi ninafufua,","poem":1},{"text":"Mimi nimejeruhi na Mimi nitaponya,","poem":2},{"lineBreak":true},{"text":"wala hakuna awezaye kuokoa kutoka mkononi mwangu.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Ninainua mkono wangu kuelekea mbinguni na kusema:","poem":1},{"text":"Hakika kama niishivyo milele,","poem":2}]},{"type":"verse","number":41,"content":[{"text":"wakati ninapounoa upanga wangu unaometameta","poem":1},{"text":"na mkono wangu unapoushika ili kutoa hukumu,","poem":2},{"text":"nitalipiza kisasi juu ya adui zangu","poem":1},{"text":"na kuwalipiza wale wanaonichukia.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Nitailevya mishale yangu kwa damu,","poem":1},{"text":"wakati upanga wangu ukitafuna nyama:","poem":2},{"text":"damu ya waliochinjwa pamoja na mateka,","poem":1},{"text":"vichwa vya viongozi wa adui.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Furahini, enyi mataifa, pamoja na watu wake,","poem":1},{"text":"kwa kuwa atailipiza damu ya watumishi wake,","poem":2},{"text":"atalipiza kisasi juu ya adui zake","poem":1},{"text":"na kufanya upatanisho","poem":2},{"lineBreak":true},{"text":"kwa ajili ya nchi na watu wake.","poem":2}]},{"type":"verse","number":44,"content":["Musa na Yoshua",{"noteId":7},"mwana wa Nuni wakaja, wakanena maneno yote ya wimbo watu wakiwa wanasikia."]},{"type":"verse","number":45,"content":["Musa alipomaliza kuyasoma maneno haya yote kwa Israeli wote,"]},{"type":"verse","number":46,"content":["akawaambia, “Yawekeni moyoni maneno yote ambayo nimewatangazia kwa makini siku hii ya leo, ili mpate kuwaagiza watoto wenu wayatii kwa bidii maneno yote ya sheria hii."]},{"type":"verse","number":47,"content":["Siyo maneno matupu tu kwenu, bali ni uzima wenu. Kwa hayo mtaishi maisha marefu katika nchi mnayovuka Yordani kuimiliki.”"]},{"type":"heading","content":["Musa aelezwa kifo chake"]},{"type":"verse","number":48,"content":["Siku hiyo hiyo Mwenyezi Mungu akamwambia Musa,"]},{"type":"verse","number":49,"content":["“Kwea katika safu za Abarimu hadi kilima cha Nebo kilicho Moabu, ng’ambo ya Yeriko, na uitazame Kanaani, nchi ninayowapa Waisraeli kama milki yao wenyewe."]},{"type":"verse","number":50,"content":["Utafia kwenye mlima huo unaokwea na kukusanyika pamoja na watu wako, kama ndugu yako Haruni alivyofia juu ya Mlima Hori naye akakusanyika kwa watu wake."]},{"type":"verse","number":51,"content":["Hii ni kwa sababu ninyi wawili mlivunja uaminifu nami mbele ya Waisraeli kwenye maji ya Meriba-Kadeshi katika Jangwa la Sini, na kwa sababu hamkuuinua utakatifu wangu miongoni mwa Waisraeli."]},{"type":"verse","number":52,"content":["Kwa hiyo, utaiona tu nchi kwa mbali; wewe hutaingia nchi ninayowapa watu wa Israeli.”"]}],"footnotes":[{"noteId":6,"caller":"+","text":"maana yake Yeye aliye mnyofu, yaani Israeli","reference":{"chapter":32,"verse":15}},{"noteId":7,"caller":"+","text":"yaani Yehoshea kwa Kiebrania, maana yake Yehova ni Mwokozi","reference":{"chapter":32,"verse":44}}]},"thisChapterLink":"/api/swh_onmm/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}