{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ECC","translationId":"swh_onmm","name":"Mhubiri","commonName":"Mhubiri","title":"Mhubiri","order":21,"numberOfChapters":12,"sha256":"619ac9c5a2c485598adac867a7485af16a3499ff600f4a60827abb7349d4328f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/swh_onmm/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["Kila kitu ni ubatili"]},{"type":"verse","number":1,"content":["Maneno ya Mhubiri, mwana wa Daudi, mfalme huko Yerusalemu:"]},{"type":"verse","number":2,"content":[{"text":"“Ubatili! Ubatili!”","poem":1},{"text":"Mhubiri anasema.","poem":2},{"text":"“Ubatili mtupu!","poem":1},{"text":"Kila kitu ni ubatili.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwanadamu anafaidi nini kutokana na kazi yake yote","poem":1},{"text":"anayotaabikia chini ya jua?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Vizazi huja na vizazi hupita,","poem":1},{"text":"lakini dunia inadumu milele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jua huchomoza na jua huzama,","poem":1},{"text":"nalo huharakisha kurudi mawioni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Upepo huvuma kuelekea kusini","poem":1},{"text":"na kugeukia kaskazini;","poem":2},{"text":"hurudia mzunguko huo huo,","poem":1},{"text":"daima ukirudia njia yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mito yote hutiririka baharini,","poem":1},{"text":"hata hivyo bahari kamwe haijai.","poem":2},{"text":"Mahali mito inapotoka,","poem":1},{"text":"huko hurudi tena.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Vitu vyote vinachosha,","poem":1},{"text":"kuliko mtu anavyoweza kusema.","poem":2},{"text":"Jicho kamwe halitosheki kutazama,","poem":1},{"text":"wala sikio halishibi kusikia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kile kilichokuwepo kitakuwepo tena,","poem":1},{"text":"kile kilichofanyika kitafanyika tena,","poem":2},{"lineBreak":true},{"text":"hakuna kilicho kipya chini ya jua.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kuna kitu chochote ambacho mtu anaweza kusema,","poem":1},{"text":"“Tazama! Kitu hiki ni kipya”?","poem":2},{"text":"Kilikuwepo tangu zamani za kale,","poem":1},{"text":"kilikuwepo kabla ya wakati wetu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hakuna kumbukumbu ya watu wa zamani,","poem":1},{"text":"hata na wale ambao hawajaja bado","poem":2},{"text":"hawatakumbukwa","poem":1},{"text":"na wale watakaofuata baadaye.","poem":2}]},{"type":"heading","content":["Hekima ni ubatili"]},{"type":"verse","number":12,"content":["Mimi, Mhubiri, nilikuwa mfalme wa Israeli katika Yerusalemu."]},{"type":"verse","number":13,"content":["Nilitumia muda wangu wote kujifunza na kuvumbua kwa hekima yote yanayofanyika chini ya mbingu. Jinsi gani Mungu ameweka mzigo mzito juu ya wanadamu!"]},{"type":"verse","number":14,"content":["Nimeshaona mambo yote yanayotendeka chini ya jua, hayo yote ni ubatili, hii ni kukimbiza upepo."]},{"type":"verse","number":15,"content":[{"text":"Kilichopindika hakiwezi kunyooshwa;","poem":1},{"text":"kile ambacho hakipo haiwezekani kukihesabu.","poem":2}]},{"type":"verse","number":16,"content":["Niliwaza mwenyewe, “Tazama, nimekua na kuongezeka katika hekima kuliko yeyote aliyewahi kutawala Yerusalemu kabla yangu. Nimekuwa na uzoefu mkubwa wa hekima na maarifa.”"]},{"type":"verse","number":17,"content":["Ndipo nilipojitahidi kufahamu kutofautisha hekima, wazimu na upumbavu, lakini nikatambua hata hili nalo ni kukimbiza upepo."]},{"type":"verse","number":18,"content":[{"text":"Kwa kuwa hekima nyingi huleta huzuni kubwa;","poem":1},{"text":"maarifa yanapoongezeka, masikitiko yanaongezeka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}