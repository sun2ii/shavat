{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ECC","translationId":"swh_onmm","name":"Mhubiri","commonName":"Mhubiri","title":"Mhubiri","order":21,"numberOfChapters":12,"sha256":"619ac9c5a2c485598adac867a7485af16a3499ff600f4a60827abb7349d4328f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/swh_onmm/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Kama vile inzi waliokufa huacha harufu mbaya kwenye manukato,","poem":1},{"text":"ndivyo upumbavu kidogo huzidi nguvu hekima na heshima.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moyo wa mwenye hekima huelekea kuume,","poem":1},{"text":"lakini moyo wa mpumbavu huelekea kushoto.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hata anapotembea barabarani,","poem":1},{"text":"mpumbavu hukosa ufahamu","poem":2},{"text":"na kudhihirisha kwa kila mmoja","poem":1},{"text":"jinsi alivyo mpumbavu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kama hasira ya mtawala ikiwaka dhidi yako,","poem":1},{"text":"usiache mahali pako,","poem":2},{"lineBreak":true},{"text":"utulivu huweza kuzuia makosa mengi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kuna ubaya niliouona chini ya jua,","poem":1},{"text":"aina ya kosa litokalo kwa mtawala:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wapumbavu kuwekwa kwenye nafasi nyingi za utawala,","poem":1},{"text":"hali matajiri wanashika nafasi za chini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mimi nimeona watumwa wamepanda farasi,","poem":1},{"text":"wakati wakuu wakitembea","poem":2},{"lineBreak":true},{"text":"kwa miguu kama watumwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yeye achimbaye shimo","poem":1},{"text":"aweza kutumbukia ndani yake,","poem":2},{"text":"yeyote abomoaye ukuta","poem":1},{"text":"anaweza kuumwa na nyoka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yeyote apasuaye mawe","poem":1},{"text":"inawezekana yakamuumiza,","poem":2},{"text":"yeyote apasuaye magogo","poem":1},{"text":"inawezekana yakamuumiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kama shoka ni butu","poem":1},{"text":"na halikunolewa,","poem":2},{"text":"nguvu nyingi zinahitajika,","poem":1},{"text":"lakini ustadi utaleta mafanikio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nyoka akiuma kabla ya kuchezeshwa,","poem":1},{"text":"mchezeshaji hatahitajika tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Maneno yanayotoka kinywani mwa mtu mwenye hekima yana neema,","poem":1},{"text":"bali mpumbavu huangamizwa","poem":2},{"lineBreak":true},{"text":"na midomo yake mwenyewe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mwanzoni maneno yake ni upumbavu,","poem":1},{"text":"mwishoni ni wazimu mbaya,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"naye mpumbavu huzidisha maneno.","poem":2},{"lineBreak":true},{"text":"Hakuna yeyote ajuaye linalokuja,","poem":1},{"text":"ni nani awezaye kueleza ni jambo gani","poem":2},{"lineBreak":true},{"text":"litakalotokea baada yake?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kazi ya mpumbavu humchosha mwenyewe,","poem":1},{"text":"hajui njia iendayo mjini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ole wako, ee nchi ambayo mfalme wako alikuwa mtumwa","poem":1},{"text":"na ambayo wakuu wako hufanya karamu asubuhi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Heri wewe, ee nchi ambayo mfalme wako","poem":1},{"text":"ni wa uzao wenye kuheshimika,","poem":2},{"text":"na ambayo wakuu wako hula chakula","poem":1},{"text":"kwa wakati unaofaa:","poem":2},{"text":"wao hula ili kupata nguvu","poem":1},{"text":"na si kwa ajili ya ulevi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kama mtu ni mvivu, paa la nyumba huinama;","poem":1},{"text":"kutokana na mikono milegevu, nyumba huvuja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Karamu hufanywa kwa ajili ya kicheko,","poem":1},{"text":"nao mvinyo hufurahisha maisha,","poem":2},{"lineBreak":true},{"text":"lakini fedha ni jawabu la mambo yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Usimshutumu mfalme hata ikiwa ni katika mawazo yako,","poem":1},{"text":"au kumlaani tajiri katika chumba chako cha kulala,","poem":2},{"text":"kwa sababu ndege wa angani wanaweza kuchukua maneno yako,","poem":1},{"text":"naye ndege anayeruka anaweza kutoa taarifa ya yale uliyosema.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}