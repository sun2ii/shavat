{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ECC","translationId":"swh_onmm","name":"Mhubiri","commonName":"Mhubiri","title":"Mhubiri","order":21,"numberOfChapters":12,"sha256":"619ac9c5a2c485598adac867a7485af16a3499ff600f4a60827abb7349d4328f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/swh_onmm/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["Mkate juu ya maji"]},{"type":"verse","number":1,"content":[{"text":"Tupa mkate wako juu ya maji,","poem":1},{"text":"kwa maana baada ya siku nyingi","poem":2},{"lineBreak":true},{"text":"utaupata tena.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wape sehemu watu saba, naam hata wanane,","poem":1},{"text":"kwa maana hujui ni baa gani","poem":2},{"lineBreak":true},{"text":"litakalokuwa juu ya nchi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kama mawingu yamejaa maji,","poem":1},{"text":"hunyesha mvua juu ya nchi.","poem":2},{"text":"Kama mti ukianguka kuelekea kusini","poem":1},{"text":"au kuelekea kaskazini,","poem":2},{"text":"mahali ulipoangukia,","poem":1},{"text":"hapo ndipo utakapolala.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yeyote atazamaye upepo hatapanda,","poem":1},{"text":"yeyote anayeangalia mawingu hatavuna.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kama vile usivyofahamu njia ya upepo,","poem":1},{"text":"au jinsi mwili uumbwavyo","poem":2},{"lineBreak":true},{"text":"ndani ya tumbo la mama,","poem":2},{"text":"vivyo hivyo huwezi kufahamu kazi ya Mungu,","poem":1},{"text":"Muumba wa vitu vyote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Panda mbegu yako asubuhi,","poem":1},{"text":"nako jioni usiruhusu mikono yako ilegee,","poem":2},{"text":"kwa maana hujui ni ipi itakayofanikiwa,","poem":1},{"text":"kwamba ni hii au ni ile,","poem":2},{"lineBreak":true},{"text":"au kwamba zote zitafanikiwa sawasawa.","poem":2}]},{"type":"heading","content":["Mkumbuke Muumba wako ukiwa bado kijana"]},{"type":"verse","number":7,"content":[{"text":"Nuru ni tamu,","poem":1},{"text":"tena inafurahisha macho kuona jua.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mtu akiishi miaka mingi kiasi gani,","poem":1},{"text":"na aifurahie yote.","poem":2},{"text":"Lakini akumbuke siku za giza,","poem":1},{"text":"kwa maana zitakuwa nyingi.","poem":2},{"lineBreak":true},{"text":"Kila kitu kitakachokuja ni ubatili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Furahi ewe kijana, ukiwa bado kijana,","poem":1},{"text":"moyo wako na ukupe furaha","poem":2},{"lineBreak":true},{"text":"siku za ujana wako.","poem":2},{"text":"Fuata njia za moyo wako","poem":1},{"text":"na chochote macho yako yanaona,","poem":2},{"text":"lakini ujue kwamba kwa ajili ya haya yote","poem":1},{"text":"Mungu atakuleta hukumuni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa hiyo, ondoa wasiwasi moyoni mwako","poem":1},{"text":"na utupilie mbali masumbufu ya mwili wako,","poem":2},{"lineBreak":true},{"text":"kwa kuwa ujana na nguvu ni ubatili.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}