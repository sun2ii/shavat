{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ECC","translationId":"swh_onmm","name":"Mhubiri","commonName":"Mhubiri","title":"Mhubiri","order":21,"numberOfChapters":12,"sha256":"619ac9c5a2c485598adac867a7485af16a3499ff600f4a60827abb7349d4328f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/swh_onmm/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Mkumbuke Muumba wako","poem":1},{"text":"siku za ujana wako,","poem":2},{"text":"kabla hazijaja siku za taabu,","poem":1},{"text":"wala haijakaribia miaka utakaposema,","poem":2},{"lineBreak":true},{"text":"“Mimi sifurahii hiyo”:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kabla jua na nuru,","poem":1},{"text":"nao mwezi na nyota havijatiwa giza,","poem":2},{"lineBreak":true},{"text":"kabla ya kurudi mawingu baada ya mvua;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"siku ile walinzi wa nyumba watakapotetemeka,","poem":1},{"text":"nao watu wenye nguvu watakapojiinamisha,","poem":2},{"text":"wakati wasagao watakapokoma kwa sababu ya uchache,","poem":1},{"text":"nao wachunguliao madirishani kutiwa giza;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"wakati milango ya kuingia barabarani itakapofungwa","poem":1},{"text":"na sauti ya kusaga kufifia;","poem":2},{"text":"wakati watu wataamshwa kwa sauti ya ndege,","poem":1},{"text":"lakini nyimbo zao zote zikififia;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wakati watu watakapoogopa kilichoinuka juu","poem":1},{"text":"na hatari zitakazokuwepo barabarani;","poem":2},{"text":"wakati mlozi utakapochanua maua","poem":1},{"text":"na panzi kujikokota","poem":2},{"lineBreak":true},{"text":"nawe usiwe na shauku ya kitu chochote.","poem":2},{"text":"Ndipo mwanadamu aiendea nyumba yake ya milele","poem":1},{"text":"nao waombolezaji wakizunguka barabarani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mkumbuke Muumba wako: kabla haijakatika kamba ya fedha,","poem":1},{"text":"au bakuli la dhahabu halijavunjika;","poem":2},{"text":"kabla mtungi kuvunjika kwenye chemchemi,","poem":1},{"text":"au gurudumu kuvunjika kisimani,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"nayo mavumbi kurudi ardhini yalikotoka,","poem":1},{"text":"na roho kurudi kwa Mungu aliyeitoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mhubiri asema, “Ubatili! Ubatili!","poem":1},{"text":"Kila kitu ni ubatili!”","poem":2}]},{"type":"heading","content":["Hitimisho la mambo yote"]},{"type":"verse","number":9,"content":["Mhubiri hakuwa tu na hekima, bali aliwagawia watu maarifa pia. Alitafakari na kutafiti na akaweka katika utaratibu mithali nyingi."]},{"type":"verse","number":10,"content":["Mhubiri alitafiti ili kupata maneno sahihi na kila alichoandika kilikuwa sawa na kweli."]},{"type":"verse","number":11,"content":["Maneno ya wenye hekima ni kama mchokoro, mithali zao zilizokusanywa pamoja ni kama misumari iliyopigiliwa ikawa imara, yaliyotolewa na Mchungaji mmoja."]},{"type":"verse","number":12,"content":["Zaidi ya hayo, mwanangu, kubali maonyo. Hakuna mwisho wa kutunga vitabu vingi, nako kusoma sana huuchosha mwili."]},{"type":"verse","number":13,"content":[{"text":"Hii ndiyo jumla ya maneno;","poem":1},{"text":"yote yamekwisha sikiwa:","poem":2},{"text":"Mche Mungu, nawe uzishike amri zake,","poem":1},{"text":"maana kwa jumla ndiyo impasayo mtu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa maana Mungu ataleta hukumuni kila kazi,","poem":1},{"text":"pamoja na kila neno la siri,","poem":2},{"lineBreak":true},{"text":"likiwa jema au baya.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}