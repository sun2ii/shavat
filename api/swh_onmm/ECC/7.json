{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ECC","translationId":"swh_onmm","name":"Mhubiri","commonName":"Mhubiri","title":"Mhubiri","order":21,"numberOfChapters":12,"sha256":"619ac9c5a2c485598adac867a7485af16a3499ff600f4a60827abb7349d4328f","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/swh_onmm/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["Hekima"]},{"type":"verse","number":1,"content":[{"text":"Afadhali sifa nzuri kuliko manukato safi,","poem":1},{"text":"nayo siku ya kufa kuliko ya kuzaliwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Afadhali kwenda kwenye nyumba ya msiba","poem":1},{"text":"kuliko kwenda kwenye nyumba ya karamu,","poem":2},{"text":"kwa kuwa kifo ni hatima ya kila mwanadamu,","poem":1},{"text":"imewapasa walio hai kuliweka hili mioyoni mwao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Huzuni ni afadhali kuliko kicheko,","poem":1},{"text":"kwa sababu uso wenye huzuni wafaa kwa moyo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moyo wa wenye hekima uko katika nyumba ya msiba,","poem":1},{"text":"lakini moyo wa wapumbavu uko katika nyumba ya anasa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Afadhali kusikia karipio la mtu mwenye hekima,","poem":1},{"text":"kuliko kusikiliza wimbo wa wapumbavu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kama ilivyo kuvunjika kwa miiba chini ya sufuria,","poem":1},{"text":"ndivyo kilivyo kicheko cha wapumbavu.","poem":2},{"lineBreak":true},{"text":"Hili nalo pia ni ubatili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dhuluma humfanya mtu mwenye hekima kuwa mpumbavu,","poem":1},{"text":"nayo rushwa huuharibu moyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwisho wa jambo ni bora kuliko mwanzo wake,","poem":1},{"text":"uvumilivu ni bora kuliko kiburi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Usiwe mwepesi kukasirika rohoni mwako,","poem":1},{"text":"kwa kuwa hasira hukaa kifuani mwa wapumbavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Usiseme, “Kwa nini siku za kale","poem":1},{"text":"zilikuwa bora kuliko siku hizi?”","poem":2},{"text":"Kwa maana si hekima","poem":1},{"text":"kuuliza maswali kama hayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Hekima, kama ulivyo urithi, ni kitu chema","poem":1},{"text":"na huwafaidia wale walionalo jua.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hekima ni ulinzi","poem":1},{"text":"kama fedha ilivyo ulinzi,","poem":2},{"text":"lakini faida ya maarifa ni hii:","poem":1},{"text":"kwamba hekima huhifadhi maisha ya aliye nayo.","poem":2}]},{"type":"verse","number":13,"content":["Tafakari kile Mungu alichokitenda:",{"text":"Nani awezaye kunyoosha","poem":1},{"text":"kile ambacho yeye amekipinda?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nyakati zikiwa nzuri, ufurahi,","poem":1},{"text":"lakini nyakati zikiwa mbaya, tafakari hili:","poem":2},{"text":"Mungu amefanya hiyo moja;","poem":1},{"text":"naam, pia na hiyo nyingine.","poem":2},{"text":"Kwa hiyo, mwanadamu hawezi kugundua","poem":1},{"text":"kitu chochote kuhusu maisha yake ya baadaye.","poem":2}]},{"type":"verse","number":15,"content":["Katika maisha haya yangu ya ubatili nimeshaona haya mawili:",{"text":"mtu mwadilifu akiangamia katika uadilifu wake,","poem":1},{"text":"naye mtu mwovu akiishi maisha marefu katika uovu wake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Usiwe mwenye haki kupita kiasi,","poem":1},{"text":"wala usiwe na hekima kupita kiasi:","poem":2},{"lineBreak":true},{"text":"kwa nini kujiangamiza mwenyewe?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Usiwe mwovu kupita kiasi,","poem":1},{"text":"wala usiwe mpumbavu:","poem":2},{"lineBreak":true},{"text":"kwa nini kufa kabla ya wakati wako?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ni vyema kushika hilo moja","poem":1},{"text":"na wala usiache hilo jingine likupite.","poem":2},{"lineBreak":true},{"text":"Mtu amchaye Mungu ataepuka huko kupita kiasi.","poem":2},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Hekima humfanya yeye aliye nayo kuwa na uwezo","poem":1},{"text":"kuliko watawala kumi katika mji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Hakuna mtu mwenye haki duniani","poem":1},{"text":"ambaye hufanya mambo ya haki","poem":2},{"lineBreak":true},{"text":"na kamwe asitende dhambi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Usitie maanani kila neno linalosemwa na watu,","poem":1},{"text":"la sivyo, unaweza kumsikia","poem":2},{"lineBreak":true},{"text":"mtumishi wako akikulaani:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kwa kuwa unafahamu moyoni mwako","poem":1},{"text":"kwamba wewe mwenyewe mara nyingi","poem":2},{"lineBreak":true},{"text":"umewalaani wengine.","poem":2}]},{"type":"verse","number":23,"content":["Yote haya niliyajaribu kwa hekima, nikasema,",{"text":"“Nimeamua kuwa na hekima”:","poem":1},{"text":"lakini hii ilikuwa nje ya uwezo wangu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Vyovyote hekima ilivyo,","poem":1},{"text":"hekima iko mbali sana na imejificha,","poem":2},{"lineBreak":true},{"text":"ni nani awezaye kuigundua?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nikageuza fikira zangu ili kuelewa,","poem":1},{"text":"kuchunguza na kuitafuta hekima","poem":2},{"lineBreak":true},{"text":"na kusudi la mambo,","poem":2},{"text":"na ili kuelewa ujinga wa uovu,","poem":1},{"text":"na wazimu wa upumbavu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Nimeona jambo lililo chungu kuliko mauti,","poem":1},{"text":"mwanamke ambaye ni mtego,","poem":2},{"text":"ambaye moyo wake ni wavu wa kutegea","poem":1},{"text":"na mikono yake ni minyororo.","poem":2},{"text":"Mtu ampendezaye Mungu atamkwepa,","poem":1},{"text":"bali mwenye dhambi atanaswa naye.","poem":2}]},{"type":"verse","number":27,"content":["Mhubiri anasema, “Tazama, hili ndilo nililogundua:",{"text":"“Nimegundua kitu kimoja baada ya kingine nilipokuwa katika kusudi la mambo:","poem":1}]},{"type":"verse","number":28,"content":[{"text":"ningali natafiti","poem":2},{"lineBreak":true},{"text":"lakini sipati:","poem":2},{"text":"nilimpata mwanaume mmoja mnyofu miongoni mwa elfu,","poem":1},{"text":"lakini hakuna mwanamke mmoja mnyofu miongoni mwao.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hili ndilo peke yake nililolipata:","poem":1},{"text":"Mungu amemuumba mwanadamu mnyofu,","poem":2},{"lineBreak":true},{"text":"lakini mwanadamu amebuni mambo mengi.”","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"au Mtu amchaye Mwenyezi Mungu atafuata hayo yote mawili.","reference":{"chapter":7,"verse":18}}]},"thisChapterLink":"/api/swh_onmm/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}