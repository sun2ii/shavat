{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"EXO","translationId":"swh_onmm","name":"Kutoka","commonName":"Kutoka","title":"Kutoka","order":2,"numberOfChapters":40,"sha256":"d5122ca0e870f3c6a63b7155210dd0b9a16a2a7804a549c2aaaac0a2547fd2ad","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/swh_onmm/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["Wimbo wa Musa na Miriamu"]},{"type":"verse","number":1,"content":["Ndipo Musa na Waisraeli wakamwimbia Mwenyezi Mungu wimbo huu:",{"text":"“Nitamwimbia Mwenyezi Mungu,","poem":1},{"text":"kwa kuwa ametukuzwa sana.","poem":2},{"text":"Farasi na mpanda farasi","poem":1},{"text":"amewatosa baharini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Mwenyezi Mungu ni nguvu zangu na wimbo wangu;","poem":1},{"text":"amekuwa wokovu wangu.","poem":2},{"text":"Yeye ni Mungu wangu, nami nitamsifu,","poem":1},{"text":"Mungu wa baba yangu, nami nitamtukuza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwenyezi Mungu ni shujaa wa vita;","poem":1},{"text":"Mwenyezi Mungu ndilo jina lake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Magari ya vita ya Farao na jeshi lake","poem":1},{"text":"amewatosa baharini.","poem":2},{"text":"Maafisa wa Farao walio bora sana","poem":1},{"text":"wamezamishwa katika Bahari ya Shamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maji yenye kina yamewafunika,","poem":1},{"text":"wamezama vilindini kama jiwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mkono wako wa kuume, Ee Mwenyezi Mungu","poem":1},{"text":"ulitukuka kwa uweza.","poem":2},{"text":"Mkono wako wa kuume, Ee Mwenyezi Mungu,","poem":1},{"text":"ukamponda adui.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Katika ukuu wa utukufu wako,","poem":1},{"text":"ukawaangusha chini wale waliokupinga.","poem":2},{"text":"Uliachia hasira yako kali,","poem":1},{"text":"ikawateketeza kama kapi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa pumzi ya pua yako","poem":1},{"text":"maji yalijilundika.","poem":2},{"text":"Mawimbi ya maji yakasimama imara kama ukuta,","poem":1},{"text":"vilindi vikagandamana ndani ya moyo wa bahari.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Adui alijivuna,","poem":1},{"text":"‘Nitawafuatia, nitawapata.","poem":2},{"text":"Nitagawanya nyara;","poem":1},{"text":"nitajishibisha kwao.","poem":2},{"text":"Nitafuta upanga wangu","poem":1},{"text":"na mkono wangu utawaangamiza.’","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini ulipuliza kwa pumzi yako,","poem":1},{"text":"bahari ikawafunika.","poem":2},{"text":"Wakazama kama risasi","poem":1},{"text":"kwenye maji makuu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ni nani miongoni mwa miungu aliye kama wewe, Ee Mwenyezi Mungu?","poem":1},{"lineBreak":true},{"text":"Ni nani kama Wewe:","poem":1},{"text":"uliyetukuka katika utakatifu,","poem":2},{"text":"utishaye katika utukufu,","poem":1},{"text":"ukitenda maajabu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Uliunyoosha mkono wako wa kuume","poem":1},{"text":"na nchi ikawameza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Katika upendo wako usiokoma utawaongoza","poem":1},{"text":"watu uliowakomboa.","poem":2},{"text":"Katika nguvu zako utawaongoza","poem":1},{"text":"hadi makao yako matakatifu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mataifa watasikia na kutetemeka,","poem":1},{"text":"uchungu utawakamata Wafilisti.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wakuu wa Edomu wataogopa,","poem":1},{"text":"viongozi wa Moabu watatetemeka kwa hofu,","poem":2},{"text":"Wakanaani watayeyuka,","poem":1}]},{"type":"verse","number":16,"content":[{"text":"vitisho na hofu vitawaangukia.","poem":2},{"text":"Kwa nguvu ya mkono wako","poem":1},{"text":"watatulia kama jiwe,","poem":2},{"text":"hadi watu wako wapite, Ee Mwenyezi Mungu,","poem":1},{"text":"hadi watu uliowanunua wapite.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Utawaingiza na kuwapandikiza","poem":1},{"text":"juu ya mlima wa urithi wako:","poem":2},{"text":"hapo mahali, Ee Mwenyezi Mungu,","poem":1},{"text":"ulipopafanya kuwa makao yako,","poem":2},{"text":"mahali patakatifu, Ee Mwenyezi Mungu,","poem":1},{"text":"ulipopajenga kwa mikono yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Mwenyezi Mungu atatawala","poem":1},{"text":"milele na milele.”","poem":2}]},{"type":"verse","number":19,"content":["Farasi wa Farao, magari yake ya vita na wapanda farasi wake walipoingia baharini, Mwenyezi Mungu aliyarudisha maji ya bahari yakawafunika, lakini Waisraeli walipita baharini mahali pakavu."]},{"type":"verse","number":20,"content":["Kisha Miriamu yule nabii mke, ndugu yake Haruni, akachukua matari mkononi mwake na wanawake wote wakamfuata na matari yao wakicheza."]},{"type":"verse","number":21,"content":["Miriamu akawaimbia:",{"text":"“Mwimbieni Mwenyezi Mungu,","poem":1},{"text":"kwa maana ametukuka sana.","poem":2},{"text":"Farasi na mpanda farasi","poem":1},{"text":"amewatosa baharini.”","poem":2}]},{"type":"heading","content":["Maji ya Mara na Elimu"]},{"type":"verse","number":22,"content":["Kisha Musa akawaongoza Israeli kutoka Bahari ya Shamu na kuingia katika Jangwa la Shuri. Kwa siku tatu walisafiri jangwani bila kupata maji."]},{"type":"verse","number":23,"content":["Walipofika Mara, hawakuweza kunywa maji yake kwa sababu yalikuwa machungu. (Ndiyo sababu mahali hapo panaitwa Mara",{"noteId":4},".)"]},{"type":"verse","number":24,"content":["Kwa hiyo watu wakamnung’unikia Musa, wakisema, “Tunywe nini?”"]},{"type":"verse","number":25,"content":["Ndipo Musa akamlilia Mwenyezi Mungu, naye Mwenyezi Mungu akamwonesha kipande cha mti. Akakitupa ndani ya maji, nayo maji yakawa matamu. Huko Mwenyezi Mungu akawapa amri na sheria na huko akawajaribu."]},{"type":"verse","number":26,"content":["Mungu akasema, “Mkisikiliza kwa makini sauti ya Mwenyezi Mungu, Mungu wenu, na kuyafanya yaliyo mema machoni pake, na mkiyatii maagizo yake na kuzishika amri zake zote, sitaleta juu yenu ugonjwa wowote niliowaletea Wamisri, kwa kuwa Mimi ndimi Mwenyezi Mungu, niwaponyaye.”"]},{"type":"verse","number":27,"content":["Kisha wakafika Elimu, mahali palipokuwa na chemchemi kumi na mbili, na miti sabini ya mitende, wakapiga kambi huko karibu na maji."]}],"footnotes":[{"noteId":4,"caller":"+","text":"maana yake Chungu","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/swh_onmm/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}