{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"EZK","translationId":"swh_onmm","name":"Ezekieli","commonName":"Ezekieli","title":"Ezekieli","order":26,"numberOfChapters":48,"sha256":"20e187254ed84afaa7c2e084664eb66ce1693537b80ad2e38803b88c09ac2dd1","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swh_onmm/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["Maombolezo kwa ajili ya wakuu wa Israeli"]},{"type":"verse","number":1,"content":["“Wewe fanya maombolezo kuhusu wakuu wa Israeli"]},{"type":"verse","number":2,"content":["na useme:",{"text":"“ ‘Tazama jinsi gani mama yako alivyokuwa simba jike","poem":1},{"text":"miongoni mwa simba!","poem":2},{"text":"Alilala katikati ya wana simba","poem":1},{"text":"na kulisha watoto wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Alimlea mmoja wa watoto wake,","poem":1},{"text":"naye akawa simba mwenye nguvu.","poem":2},{"text":"Akajifunza kurarua mawindo","poem":1},{"text":"naye akala watu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mataifa wakasikia habari zake,","poem":1},{"text":"naye akanaswa katika shimo lao.","poem":2},{"text":"Wakamwongoza kwa ndoana","poem":1},{"text":"hadi nchi ya Misri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘Mama yake alipongoja na kuona tumaini lake halitimiziki,","poem":1},{"text":"nayo matarajio yake yametoweka,","poem":2},{"text":"akamchukua mwanawe mwingine","poem":1},{"text":"na kumfanya simba mwenye nguvu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alizungukazunguka miongoni mwa simba,","poem":1},{"text":"kwa kuwa sasa alikuwa simba mwenye nguvu.","poem":2},{"text":"Akajifunza kurarua mawindo","poem":1},{"text":"naye akala watu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Akabomoa ngome zao","poem":1},{"text":"na kuiharibu miji yao.","poem":2},{"text":"Nchi na wote waliokuwa ndani yake","poem":1},{"text":"wakatiwa hofu kwa kunguruma kwake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kisha mataifa wakaja dhidi yake","poem":1},{"text":"kutoka sehemu zilizomzunguka.","poem":2},{"text":"Wakatanda nyavu zao kwa ajili yake,","poem":1},{"text":"naye akanaswa katika shimo lao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wakamvutia kwenye tundu kwa kutumia ndoana,","poem":1},{"text":"wakamleta kwa mfalme wa Babeli.","poem":2},{"text":"Wakamfunga gerezani, hivyo kunguruma kwake","poem":1},{"text":"hakukusikika tena","poem":2},{"lineBreak":true},{"text":"katika milima ya Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘Mama yako alikuwa kama mzabibu","poem":1},{"text":"katika shamba lako la mizabibu","poem":2},{"lineBreak":true},{"text":"uliopandwa kando ya maji,","poem":2},{"text":"ukiwa unazaa sana na wenye matawi mengi","poem":1},{"text":"kwa sababu ya wingi wa maji.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Matawi yake yalikuwa na nguvu,","poem":1},{"text":"yaliyofaa kuwa fimbo ya mtawala.","poem":2},{"text":"Ulikuwa mrefu kupita miti mingine","poem":1},{"text":"katikati ya matawi manene;","poem":2},{"text":"ulionekana kwa urahisi","poem":1},{"text":"kwa ajili ya urefu wake","poem":2},{"lineBreak":true},{"text":"na wingi wa matawi yake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini uling’olewa kwa hasira kali","poem":1},{"text":"na kutupwa chini.","poem":2},{"text":"Upepo wa mashariki uliufanya usinyae,","poem":1},{"text":"matunda yake yakapukutika,","poem":2},{"text":"matawi yake yenye nguvu yakanyauka","poem":1},{"text":"na moto ukayateketeza.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sasa umepandwa jangwani","poem":1},{"text":"katika nchi kame na ya kiu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Moto ulienea kuanzia mojawapo ya matawi yake makubwa","poem":1},{"text":"na kuteketeza matunda yake.","poem":2},{"text":"Hakuna tawi lenye nguvu lililobaki juu yake","poem":1},{"text":"linalofaa kuwa fimbo ya mtawala.’","poem":2},"Hili ndilo ombolezo, na litumike kama ombolezo.”"]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}