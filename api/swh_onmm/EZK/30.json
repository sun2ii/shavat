{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"EZK","translationId":"swh_onmm","name":"Ezekieli","commonName":"Ezekieli","title":"Ezekieli","order":26,"numberOfChapters":48,"sha256":"20e187254ed84afaa7c2e084664eb66ce1693537b80ad2e38803b88c09ac2dd1","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swh_onmm/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":30,"content":[{"type":"heading","content":["Maombolezo kwa ajili ya Misri"]},{"type":"verse","number":1,"content":["Neno la Mwenyezi Mungu likanijia kusema:"]},{"type":"verse","number":2,"content":["“Mwanadamu, toa unabii na useme: ‘Hili ndilo asemalo Bwana Mungu Mwenyezi:",{"text":"“ ‘Ombolezeni ninyi na mseme,","poem":1},{"text":"“Ole wa siku ile!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa siku ile imekaribia,","poem":1},{"text":"siku ya Mwenyezi Mungu imekaribia,","poem":2},{"text":"siku ya mawingu,","poem":1},{"text":"siku ya maangamizi kwa mataifa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Upanga utakuja dhidi ya Misri,","poem":1},{"text":"nayo maumivu makuu yataijia Kushi.","poem":2},{"text":"Mauaji yatakapoangukia Misri,","poem":1},{"text":"utajiri wake utachukuliwa","poem":2},{"lineBreak":true},{"text":"na misingi yake itabomolewa.","poem":2}]},{"type":"verse","number":5,"content":["Kushi na Putu, Ludi na Arabia yote, Kubu na watu wa nchi ya agano watauawa kwa upanga pamoja na Misri."]},{"type":"verse","number":6,"content":["“ ‘Hili ndilo asemalo Mwenyezi Mungu:",{"text":"“ ‘Wale walioungana na Misri wataanguka","poem":1},{"text":"na kiburi cha nguvu zake kitashindwa.","poem":2},{"text":"Kutoka Migdoli hadi Aswani,","poem":1},{"text":"watauawa ndani yake kwa upanga,","poem":2},{"lineBreak":true},{"text":"asema Bwana Mungu Mwenyezi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hizo nchi zitakua ukiwa","poem":1},{"text":"miongoni mwa nchi zilizo ukiwa,","poem":2},{"text":"nayo miji yao itakuwa magofu","poem":1},{"text":"miongoni mwa miji iliyo magofu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndipo watajua kuwa mimi ndimi Mwenyezi Mungu,","poem":1},{"text":"nitakapoiwasha Misri moto","poem":2},{"lineBreak":true},{"text":"na wasaidizi wake wote watapondwa.","poem":2}]},{"type":"verse","number":9,"content":["“ ‘Siku hiyo wajumbe watatoka kwangu kwa merikebu, ili kuwatia hofu Ethiopia, wakiwa katika hali yao ya kuridhika. Maumivu makali yatawapata siku ya maangamizi ya Misri, kwa kuwa hakika itakuja."]},{"type":"line_break"},{"type":"verse","number":10,"content":["“ ‘Hili ndilo asemalo Bwana Mungu Mwenyezi:",{"text":"“ ‘Nitakomesha makundi ya Misri","poem":1},{"text":"kwa mkono wa Nebukadneza mfalme wa Babeli.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yeye na jeshi lake, taifa lililo katili","poem":1},{"text":"kuliko mataifa yote,","poem":2},{"lineBreak":true},{"text":"ataletwa ili kuangamiza nchi.","poem":2},{"text":"Watafuta panga zao dhidi ya Misri","poem":1},{"text":"na kuijaza nchi kwa waliouawa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitakausha vijito vya Mto Naili,","poem":1},{"text":"na kuiuza nchi kwa watu waovu;","poem":2},{"text":"kwa mkono wa wageni, nitaifanya nchi ukiwa","poem":1},{"text":"na kila kitu kilicho ndani yake.","poem":2},"Mimi Mwenyezi Mungu nimenena haya."]},{"type":"line_break"},{"type":"verse","number":13,"content":["“ ‘Hili ndilo asemalo Bwana Mungu Mwenyezi:",{"text":"“ ‘Nitaangamiza sanamu","poem":1},{"text":"na kukomesha vinyago katika Memfisi","poem":2},{"noteId":12},{"text":".","poem":2},{"text":"Hapatakuwa tena na mkuu katika nchi ya Misri,","poem":1},{"text":"nami nitaeneza hofu katika nchi nzima.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitaifanya Pathrosi","poem":1},{"noteId":13},{"text":"kuwa ukiwa","poem":1},{"text":"na kuitia moto Soani,","poem":2},{"lineBreak":true},{"text":"nami nitaipiga Thebesi","poem":2},{"noteId":14},{"text":"kwa adhabu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitaimwaga ghadhabu yangu juu ya Pelusiumu","poem":1},{"noteId":15},{"text":",","poem":1},{"text":"ngome ya Misri,","poem":2},{"text":"nami nitakatilia mbali","poem":1},{"text":"makundi ya Thebesi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nitaitia moto nchi ya Misri;","poem":1},{"text":"Pelusiumu itagaagaa kwa maumivu makuu.","poem":2},{"text":"Thebesi itachukuliwa na tufani,","poem":1},{"text":"Memfisi itakuwa katika taabu daima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wanaume vijana wa Oni","poem":1},{"noteId":16},{"text":"na wa Pi-Besethi","poem":1},{"noteId":17},{"text":"wataanguka kwa upanga","poem":2},{"lineBreak":true},{"text":"nayo hiyo miji itatekwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Huko Tapanesi mchana utatiwa giza","poem":1},{"text":"nitakapovunja nira ya Misri;","poem":2},{"lineBreak":true},{"text":"hapo kiburi cha nguvu zake kitakoma.","poem":2},{"text":"Atafunikwa na mawingu","poem":1},{"text":"na vijiji vyake vitatekwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kwa hiyo nitaipiga Misri kwa adhabu,","poem":1},{"text":"nao watajua kuwa Mimi ndimi Mwenyezi Mungu.’ ”","poem":2}]},{"type":"heading","content":["Mkono wa Farao umevunjwa"]},{"type":"verse","number":20,"content":["Katika mwaka wa kumi na moja, mwezi wa kwanza, siku ya saba, neno la Mwenyezi Mungu likanijia kusema:"]},{"type":"verse","number":21,"content":["“Mwanadamu, nimevunja mkono wa Farao mfalme wa Misri. Haukufungwa ili upone au kuwekewa kipande cha ubao ili upate nguvu za kuweza kuchukua upanga."]},{"type":"verse","number":22,"content":["Kwa hiyo hili ndilo asemalo Bwana Mungu Mwenyezi: Mimi ni kinyume na Farao mfalme wa Misri. Nitavunja mikono yake yote miwili, ule mkono ulio mzima pia na ule uliovunjika na kuufanya upanga uanguke toka mkononi mwake."]},{"type":"verse","number":23,"content":["Nitawatawanya Wamisri miongoni mwa mataifa na kuwatapanya katika nchi zote."]},{"type":"verse","number":24,"content":["Nitaitia nguvu mikono ya mfalme wa Babeli na kuutia upanga wangu mkononi mwake, lakini nitavunja mikono ya Farao, naye atalia kwa huzuni mbele yake kama mtu aliyetiwa jeraha la kumfisha."]},{"type":"verse","number":25,"content":["Nitaitia nguvu mikono ya mfalme wa Babeli, lakini mikono ya Farao italegea. Ndipo watajua kuwa Mimi ndimi Mwenyezi Mungu, nitakapoutia upanga wangu mkononi mwa mfalme wa Babeli, naye ataunyoosha dhidi ya Misri."]},{"type":"verse","number":26,"content":["Nitawatawanya Wamisri miongoni mwa mataifa na kuwatapanya katika nchi nyingine. Ndipo watajua kuwa Mimi ndimi Mwenyezi Mungu.”"]}],"footnotes":[{"noteId":12,"caller":"+","text":"au Nofu","reference":{"chapter":30,"verse":13}},{"noteId":13,"caller":"+","text":"yaani Misri ya Juu","reference":{"chapter":30,"verse":14}},{"noteId":14,"caller":"+","text":"yaani No (au No-Amoni)","reference":{"chapter":30,"verse":14}},{"noteId":15,"caller":"+","text":"Kiebrania ni Sini","reference":{"chapter":30,"verse":15}},{"noteId":16,"caller":"+","text":"yaani Heliopoli (Mji wa Jua)","reference":{"chapter":30,"verse":17}},{"noteId":17,"caller":"+","text":"yaani Bubasti","reference":{"chapter":30,"verse":17}}]},"thisChapterLink":"/api/swh_onmm/EZK/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/EZK/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/EZK/29.json","previousChapterAudioLinks":{},"numberOfVerses":26}