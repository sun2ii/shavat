{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"EZK","translationId":"swh_onmm","name":"Ezekieli","commonName":"Ezekieli","title":"Ezekieli","order":26,"numberOfChapters":48,"sha256":"20e187254ed84afaa7c2e084664eb66ce1693537b80ad2e38803b88c09ac2dd1","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/swh_onmm/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["Mwisho umewadia"]},{"type":"verse","number":1,"content":["Neno la Mwenyezi Mungu likanijia kusema:"]},{"type":"verse","number":2,"content":["“Mwanadamu, hili ndilo asemalo Bwana Mungu Mwenyezi kwa nchi ya Israeli:",{"text":"“ ‘Mwisho! Mwisho umekuja","poem":1},{"text":"juu ya pembe nne za nchi!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sasa mwisho umekuja juu yenu,","poem":1},{"text":"nami nitamwaga hasira yangu dhidi yenu.","poem":2},{"text":"Nitawahukumu sawasawa na matendo yenu","poem":1},{"text":"na kuwalipiza kwa ajili ya desturi zenu zote za kuchukiza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sitawaonea huruma","poem":1},{"text":"wala kuwarehemu.","poem":2},{"text":"Hakika nitawalipiza kwa ajili ya matendo yenu","poem":1},{"text":"na desturi za machukizo miongoni mwenu.","poem":2},"Ndipo mtajua kuwa Mimi ndimi Mwenyezi Mungu.’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“Hili ndilo asemalo Bwana Mungu Mwenyezi:",{"text":"“ ‘Maafa! Maafa ambayo hayajasikiwa!","poem":1},{"text":"Tazama, yanakuja!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwisho umewadia!","poem":1},{"text":"Mwisho umewadia!","poem":2},{"text":"Umejiinua wenyewe dhidi yenu.","poem":1},{"text":"Tazama, umewadia!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maangamizi yamekuja juu yenu,","poem":1},{"text":"ninyi mnaoishi katika nchi.","poem":2},{"text":"Wakati umewadia! Siku imekaribia!","poem":1},{"text":"Kuna hofu kuu ya ghafula juu ya milima, wala si furaha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ninakaribia kumwaga ghadhabu yangu juu yenu","poem":1},{"text":"na kumaliza hasira yangu dhidi yenu.","poem":2},{"text":"Nitawahukumu sawasawa na matendo yenu","poem":1},{"text":"na kuwalipiza kwa ajili ya desturi zenu zote za machukizo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sitawaonea huruma","poem":1},{"text":"wala kuwarehemu.","poem":2},{"text":"Nitawalipiza kwa ajili ya matendo yenu","poem":1},{"text":"na desturi za machukizo miongoni mwenu.","poem":2},{"lineBreak":true},"“ ‘Ndipo mtajua kuwa Mimi ndimi Mwenyezi Mungu ambaye huwapiga."]},{"type":"verse","number":10,"content":[{"text":"“ ‘Tazama, siku imefika!","poem":1},{"text":"Tazama, imewadia!","poem":2},{"text":"Maangamizi yamezuka ghafula,","poem":1},{"text":"fimbo imechanua,","poem":2},{"lineBreak":true},{"text":"nayo majivuno yamechipua!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Jeuri imeinuka","poem":1},{"text":"kuwa fimbo ya kuadhibu waovu.","poem":2},{"text":"Hakuna hata mmoja wa hao watu atakayeachwa,","poem":1},{"text":"hata mmoja wa kundi hilo:","poem":2},{"text":"hakuna utajiri wao utabaki,","poem":1},{"text":"wala chochote cha thamani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wakati umewadia,","poem":1},{"text":"siku imefika.","poem":2},{"text":"Mnunuzi na asifurahi","poem":1},{"text":"wala muuzaji asihuzunike,","poem":2},{"lineBreak":true},{"text":"kwa maana ghadhabu iko juu ya kundi lote.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Muuzaji hatajipatia tena","poem":1},{"text":"ardhi aliyoiuza","poem":2},{"lineBreak":true},{"text":"wakati wote wawili wangali hai.","poem":2},{"text":"Kwa kuwa maono kuhusu kundi lote","poem":1},{"text":"hayatatanguka.","poem":2},{"text":"Kwa sababu ya dhambi zao, hakuna hata mmoja","poem":1},{"text":"atakayeokoa maisha yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘Wajapopiga tarumbeta","poem":1},{"text":"na kuweka kila kitu tayari,","poem":2},{"text":"hakuna hata mmoja atakayeenda vitani,","poem":1},{"text":"kwa maana ghadhabu yangu iko juu ya kundi lote.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nje ni upanga,","poem":1},{"text":"ndani ni tauni na njaa.","poem":2},{"text":"Walio shambani","poem":1},{"text":"watakufa kwa upanga,","poem":2},{"text":"nao waliomo mjini","poem":1},{"text":"njaa na tauni vitawala.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wote watakaopona","poem":1},{"text":"na kutoroka watakuwa milimani,","poem":2},{"text":"wakiomboleza kama hua wa mabondeni,","poem":1},{"text":"kila mmoja kwa sababu ya dhambi zake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kila mkono utalegea","poem":1},{"text":"na kila goti litakuwa dhaifu kama maji.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Watavaa gunia","poem":1},{"text":"na kufunikwa na hofu.","poem":2},{"text":"Nyuso zao zitafunikwa na aibu,","poem":1},{"text":"na vichwa vyao vitanyolewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘Watatupa fedha yao barabarani,","poem":1},{"text":"nayo dhahabu yao itakuwa najisi.","poem":2},{"text":"Fedha yao na dhahabu yao","poem":1},{"text":"havitaweza kuwaokoa","poem":2},{"lineBreak":true},{"text":"katika siku hiyo ya ghadhabu ya Mwenyezi Mungu.","poem":2},{"text":"Hawatashibisha njaa yao","poem":1},{"text":"au kujaza tumbo zao kwa hiyo fedha wala dhahabu,","poem":2},{"lineBreak":true},{"text":"kwa sababu imewaponza wajikwae dhambini.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Walijivunia vito vyao vizuri","poem":1},{"text":"na kuvitumia kutengeneza sanamu za machukizo","poem":2},{"lineBreak":true},{"text":"na vinyago vya upotovu.","poem":2},{"lineBreak":true},{"text":"Kwa hiyo nitavifanya vitu hivyo kuwa najisi kwao.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nitavitia vyote mikononi mwa wageni","poem":1},{"text":"kuwa nyara na kuwa vitu vilivyotekwa mikononi mwa watu waovu wa dunia,","poem":2},{"lineBreak":true},{"text":"nao watavinajisi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nitaugeuza uso wangu mbali nao,","poem":1},{"text":"nao waovu wa dunia watapanajisi mahali pangu pa thamani.","poem":2},{"text":"Wanyang’anyi watapaingia","poem":1},{"text":"na kupanajisi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘Andaa minyororo,","poem":1},{"text":"kwa sababu nchi imejaa umwagaji wa damu","poem":2},{"lineBreak":true},{"text":"na mji umejaa udhalimu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nitaleta taifa ovu kuliko yote","poem":1},{"text":"kumiliki nyumba zao.","poem":2},{"text":"Nitakomesha kiburi cha wenye nguvu","poem":1},{"text":"na mahali pao patakatifu patatiwa unajisi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hofu ya ghafula itakapokuja,","poem":1},{"text":"watatafuta amani, lakini haitapatikana.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Maafa juu ya maafa yatakuja,","poem":1},{"text":"tetesi ya mabaya juu ya tetesi ya mabaya.","poem":2},{"text":"Watajitahidi kupata maono kutoka kwa nabii;","poem":1},{"text":"mafundisho ya sheria toka kwa kuhani yatapotea,","poem":2},{"lineBreak":true},{"text":"vivyo hivyo shauri kutoka kwa wazee.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mfalme ataomboleza,","poem":1},{"text":"mwana wa mfalme atavikwa kukata tamaa,","poem":2},{"lineBreak":true},{"text":"nayo mikono ya watu wa nchi itatetemeka.","poem":2},{"text":"Nitawaadhibu kulingana na matendo yao,","poem":1},{"text":"na kwa kanuni zao wenyewe nitawahukumu.","poem":2},{"lineBreak":true},"“ ‘Ndipo watajua kwamba Mimi ndimi Mwenyezi Mungu.’ ”"]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}