{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HAB","translationId":"swh_onmm","name":"Habakuki","commonName":"Habakuki","title":"Habakuki","order":35,"numberOfChapters":3,"sha256":"67db60264381fbe26784315071ee2e2b7a6c9844fbc144004d3ef6e796909d80","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_onmm/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Neno la unabii alilopokea nabii Habakuki."]},{"type":"line_break"},{"type":"heading","content":["Lalamiko la Habakuki"]},{"type":"verse","number":2,"content":[{"text":"Ee Mwenyezi Mungu, hata lini nitakuomba msaada,","poem":1},{"text":"lakini wewe husikilizi?","poem":2},{"text":"Au kukulilia, “Udhalimu!”","poem":1},{"text":"lakini hutaki kuokoa?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa nini unanifanya nitazame dhuluma?","poem":1},{"text":"Kwa nini unavumilia makosa?","poem":2},{"text":"Uharibifu na udhalimu viko mbele yangu;","poem":1},{"text":"kuna mabishano na mapambano kwa wingi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa hiyo sheria imepotoshwa,","poem":1},{"text":"nayo haki haipo kabisa.","poem":2},{"text":"Waovu wanawazunguka wenye haki,","poem":1},{"text":"kwa hiyo haki imepotoshwa.","poem":2}]},{"type":"heading","content":["Jibu la Mwenyezi Mungu"]},{"type":"verse","number":5,"content":[{"text":"“Yatazame mataifa,","poem":1},{"text":"uangalie na ushangae kabisa.","poem":2},{"text":"Kwa sababu katika siku zako nitafanya kitu","poem":1},{"text":"ambacho hungeamini,","poem":2},{"lineBreak":true},{"text":"hata kama ungeambiwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tazama! Nitawainua Wakaldayo,","poem":1},{"text":"watu wakatili na wenye haraka,","poem":2},{"text":"ambao hupita dunia yote","poem":1},{"text":"ili kuteka makazi yasiyo yao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ni watu wanoogopwa na wanaotisha;","poem":1},{"text":"wenyewe ndio sheria yao,","poem":2},{"lineBreak":true},{"text":"na huinua heshima yao wenyewe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Farasi wao ni wepesi kuliko chui,","poem":1},{"text":"na wakali kuliko mbwa-mwitu wakati wa machweo.","poem":2},{"text":"Askari wapanda farasi wao huenda mbio;","poem":1},{"text":"waendesha farasi wao wanatoka mbali.","poem":2},{"text":"Wanaruka kasi kama tai","poem":1},{"text":"ili kurarua mawindo;","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"wote wanakuja tayari kutenda udhalimu.","poem":2},{"text":"Makundi yao wanasonga mbele","poem":1},{"text":"kama upepo wa jangwani,","poem":2},{"text":"na kukusanya wafungwa","poem":1},{"text":"kama mchanga.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wanawabeza wafalme,","poem":1},{"text":"na kuwadhihaki watawala.","poem":2},{"text":"Wanaicheka miji yote yenye ngome;","poem":1},{"text":"wanalundika udongo na kuiteka hiyo miji.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kisha wanapita kasi kama upepo na kusonga mbele:","poem":1},{"text":"watu wenye hatia, ambao nguvu zao ndio mungu wao.”","poem":2}]},{"type":"heading","content":["Lalamiko la pili la Habakuki"]},{"type":"verse","number":12,"content":[{"text":"Ee Mwenyezi Mungu, je, wewe sio wa tangu milele?","poem":1},{"text":"Mungu wangu, Uliye Mtakatifu wangu, hatutakufa.","poem":2},{"text":"Ee Mwenyezi Mungu, umewachagua wao ili watekeleze hukumu;","poem":1},{"text":"Ee Mwamba, umewaamuru watuadhibu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Macho yako ni safi mno hata yasiweze kuutazama uovu,","poem":1},{"text":"wala huwezi kuvumilia makosa.","poem":2},{"text":"Kwa nini basi unawavumilia wadanganyifu?","poem":1},{"text":"Kwa nini unakuwa kimya wakati waovu","poem":2},{"text":"wanawameza wale wenye haki","poem":1},{"text":"kuliko wao wenyewe?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Umewafanya watu kama samaki baharini,","poem":1},{"text":"kama viumbe wa bahari wasio na mtawala.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Adui mwovu anawavuta wote kwa ndoana,","poem":1},{"text":"anawakamata katika wavu wake,","poem":2},{"text":"anawakusanya katika juya lake;","poem":1},{"text":"kwa hiyo anashangilia na anafurahi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa hiyo anatoa sadaka kwa wavu wake,","poem":1},{"text":"na kuchoma uvumba kwa juya lake,","poem":2},{"text":"kwa kuwa kwa wavu wake anaishi kwa starehe,","poem":1},{"text":"na anafurahia chakula kizuri.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Je, aendelee kuwatoa walio katika wavu wake,","poem":1},{"text":"akiangamiza mataifa bila huruma?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}