{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HAB","translationId":"swh_onmm","name":"Habakuki","commonName":"Habakuki","title":"Habakuki","order":35,"numberOfChapters":3,"sha256":"67db60264381fbe26784315071ee2e2b7a6c9844fbc144004d3ef6e796909d80","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_onmm/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["Maombi ya Habakuki"]},{"type":"verse","number":1,"content":[{"text":"Sala ya nabii Habakuki iliyoimbwa kwa shigionothi","descriptive":true},{"noteId":1},{"text":".","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu, nimezisikia sifa zako;","poem":1},{"text":"nami naogopa kwa matendo yako, Ee Mwenyezi Mungu.","poem":2},{"text":"Fufua kazi yako katika siku hizi zetu,","poem":1},{"text":"tangaza habari yako wakati huu wetu;","poem":2},{"lineBreak":true},{"text":"katika ghadhabu kumbuka rehema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mungu alitoka Temani,","poem":1},{"text":"yeye Aliye Mtakatifu kutoka Mlima Parani.","poem":2},{"text":"Utukufu wake ulifunika mbingu,","poem":1},{"text":"na sifa zake zikaifunika dunia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mng’ao wake ulikuwa kama jua linapochomoza;","poem":1},{"text":"miali ilimulika kutoka mkononi mwake,","poem":2},{"lineBreak":true},{"text":"ambako nguvu zake zilifichwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tauni ilimtangulia;","poem":1},{"text":"maradhi ya kuambukiza yalifuata nyayo zake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alisimama, akaitikisa dunia;","poem":1},{"text":"alitazama, na kuyafanya mataifa yatetemeke.","poem":2},{"text":"Milima ya zamani iligeuka mavumbi","poem":1},{"text":"na vilima vilivyozeeka vikaanguka.","poem":2},{"lineBreak":true},{"text":"Njia zake ni za milele.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Niliona watu wa Kushani katika dhiki,","poem":1},{"text":"na makazi ya Midiani katika maumivu makali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mwenyezi Mungu, uliikasirikia mito?","poem":1},{"text":"Je, ghadhabu yako ilikuwa dhidi ya vijito?","poem":2},{"text":"Je, ulighadhibikia bahari","poem":1},{"text":"ulipoendesha farasi wako","poem":2},{"lineBreak":true},{"text":"na magari yako ya vita ili ushinde?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uliufunua upinde wako","poem":1},{"text":"na kuitisha mishale mingi.","poem":2},{"text":"Uliigawa dunia kwa mito;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"milima ilikuona ikatetemeka.","poem":2},{"text":"Mafuriko ya maji yakapita huko;","poem":1},{"text":"vilindi vilinguruma","poem":2},{"lineBreak":true},{"text":"na kuinua mawimbi yake juu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jua na mwezi vilisimama kimya mbinguni","poem":1},{"text":"katika mng’ao wa mishale yako inayoruka,","poem":2},{"lineBreak":true},{"text":"na katika mng’ao wa mkuki wako umeremetao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa ghadhabu ulipitia kwenye dunia,","poem":1},{"text":"na katika hasira ulikanyaga mataifa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ulikuja kuwaokoa watu wako,","poem":1},{"text":"kumwokoa uliyempaka mafuta.","poem":2},{"text":"Ulimponda kiongozi wa nchi ya uovu,","poem":1},{"text":"ukamvua toka kichwani hadi wayo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa mkuki wake mwenyewe ulitoboa kichwa chake","poem":1},{"text":"wakati mashujaa wake walifurika nje kwa kishindo kututawanya,","poem":2},{"text":"wakifurahi kama walio karibu kutafuna","poem":1},{"text":"wale wanyonge waliokuwa mafichoni.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ulikanyaga bahari kwa farasi wako,","poem":1},{"text":"ukisukasuka maji makuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nilisikia na moyo wangu ukagonga kwa nguvu,","poem":1},{"text":"midomo yangu ikatetemeka kwa hofu niliposikia sauti;","poem":2},{"text":"uchakavu ukanyemelea mifupa yangu,","poem":1},{"text":"na miguu yangu ikatetemeka.","poem":2},{"text":"Hata hivyo nitasubiri kwa uvumilivu siku ya maafa","poem":1},{"text":"kuyajilia mataifa yaliyotuvamia.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ingawa mtini hauchanui maua","poem":1},{"text":"na hakuna zabibu juu ya mizabibu,","poem":2},{"text":"ingawaje mzeituni hauzai,","poem":1},{"text":"na hata mashamba hayatoi chakula,","poem":2},{"text":"iwapo hakuna kondoo katika banda,","poem":1},{"text":"wala ng’ombe katika zizi,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"hata hivyo nitashangilia katika Mwenyezi Mungu,","poem":1},{"text":"nitamfurahia Mungu Mwokozi wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Bwana Mungu Mwenyezi ni nguvu yangu;","poem":1},{"text":"huifanya miguu yangu kama miguu ya ayala,","poem":2},{"lineBreak":true},{"text":"huniwezesha kupita juu ya vilima.","poem":2},{"text":"Kwa kiongozi wa uimbaji. Kwa vinanda vyangu vya nyuzi.","descriptive":true}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Ni kifaa cha uimbaji chenye nyuzi; pia maombi kutumia kifaa hiki.","reference":{"chapter":3,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}