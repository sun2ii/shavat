{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HEB","translationId":"swh_onmm","name":"Waebrania","commonName":"Waebrania","title":"Waebrania","order":58,"numberOfChapters":13,"sha256":"3a529df13ba9f3cf0381333c4dcad726549285c671cddc3e73ccc6741f805d97","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/swh_onmm/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Mwenyezi Mungu amesema kupitia Mwana"]},{"type":"verse","number":1,"content":["Zamani, Mungu alisema na baba zetu kupitia kwa manabii mara nyingi na kwa njia mbalimbali,"]},{"type":"verse","number":2,"content":["lakini katika siku hizi za mwisho anasema nasi kupitia kwa Mwanawe, ambaye amemweka kuwa mrithi wa vitu vyote, na ambaye kupitia kwake aliuumba ulimwengu."]},{"type":"verse","number":3,"content":["Mwana ni mng’ao wa utukufu wa Mungu na mfano halisi wa nafsi yake, akivihifadhi vitu vyote kwa neno lake lenye uweza. Baada ya kufanya utakaso kwa ajili ya dhambi, aliketi mkono wa kuume wa Aliye Mkuu huko mbinguni."]},{"type":"verse","number":4,"content":["Kwa hiyo alifanyika bora kuliko malaika, kama jina alilorithi lilivyo bora kuliko lao."]},{"type":"heading","content":["Mwana ni mkuu kuliko malaika"]},{"type":"verse","number":5,"content":["Kwa maana ni kwa malaika yupi Mungu aliwahi kusema,",{"text":"“Wewe ni Mwanangu;","poem":1},{"text":"leo mimi nimekuwa Baba yako”?","poem":2},"Au tena,",{"text":"“Mimi nitakuwa Baba yake,","poem":1},{"text":"naye atakuwa Mwanangu”?","poem":2}]},{"type":"verse","number":6,"content":["Tena, Mungu amletapo mzaliwa wake wa kwanza ulimwenguni, anasema,",{"text":"“Malaika wote wa Mungu na wamsujudu.”","poem":1}]},{"type":"verse","number":7,"content":["Anaponena kuhusu malaika, anasema,",{"text":"“Huwafanya malaika wake kuwa pepo,","poem":1},{"text":"watumishi wake kuwa miali ya moto.”","poem":2}]},{"type":"verse","number":8,"content":["Lakini kwa habari za Mwana asema,",{"text":"“Kiti chako cha enzi, Ee Mungu,","poem":1},{"text":"kitadumu milele na milele,","poem":2},{"text":"nayo haki itakuwa fimbo ya utawala","poem":1},{"text":"ya ufalme wako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umependa haki na kuchukia uovu;","poem":1},{"text":"kwa hiyo Mungu, Mungu wako,","poem":2},{"lineBreak":true},{"text":"amekuweka juu ya wenzako","poem":2},{"lineBreak":true},{"text":"kwa kukupaka mafuta ya furaha.”","poem":2}]},{"type":"verse","number":10,"content":["Pia asema,",{"text":"“Hapo mwanzo, Ee Mwenyezi Mungu,","poem":1},{"text":"uliweka misingi ya dunia,","poem":2},{"lineBreak":true},{"text":"nazo mbingu ni kazi ya mikono yako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hizo zitatoweka, lakini wewe utadumu;","poem":1},{"text":"zote zitachakaa kama vazi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Utazikunjakunja kama joho,","poem":1},{"text":"nazo zitabadilishwa kama vazi.","poem":2},{"text":"Lakini wewe hubadiliki,","poem":1},{"text":"nayo miaka yako haikomi kamwe.”","poem":2}]},{"type":"verse","number":13,"content":["Je, ni kwa malaika yupi Mungu aliwahi kusema,",{"text":"“Keti mkono wangu wa kuume,","poem":2},{"text":"hadi nitakapowaweka adui zako","poem":1},{"text":"chini ya miguu yako”?","poem":2}]},{"type":"verse","number":14,"content":["Je, malaika wote si roho watumikao, waliotumwa kuwahudumia wale watakaourithi wokovu?"]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}