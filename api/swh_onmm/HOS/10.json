{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Israeli alikuwa mzabibu uliostawi sana,","poem":1},{"text":"alijizalia matunda mwenyewe.","poem":2},{"text":"Kadiri matunda yake yalivyoongezeka,","poem":1},{"text":"alijenga madhabahu zaidi;","poem":2},{"text":"kadiri nchi yake ilivyostawi,","poem":1},{"text":"alipamba mawe yake ya ibada.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moyo wao ni mdanganyifu,","poem":1},{"text":"nao sasa lazima wachukue hatia yao.","poem":2},{"text":"Mwenyezi Mungu atabomoa madhabahu zao","poem":1},{"text":"na kuharibu mawe yao ya ibada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kisha watasema, “Hatuna mfalme","poem":1},{"text":"kwa sababu hatukumheshimu Mwenyezi Mungu.","poem":2},{"text":"Lakini hata kama tungekuwa na mfalme,","poem":1},{"text":"angeweza kutufanyia nini?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wanaweka ahadi nyingi,","poem":1},{"text":"huapa viapo vya uongo","poem":2},{"lineBreak":true},{"text":"wanapofanya mapatano;","poem":2},{"text":"kwa hiyo mashtaka huchipuka","poem":1},{"text":"kama magugu ya sumu","poem":2},{"lineBreak":true},{"text":"katika shamba lililolimwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Watu wanaoishi Samaria huogopa","poem":1},{"text":"kwa ajili ya sanamu ya ndama ya Beth-Aveni","poem":2},{"noteId":13},{"text":".","poem":2},{"text":"Watu wake wataiombolezea,","poem":1},{"text":"vivyo hivyo kuhani wake wa kuabudu sanamu,","poem":2},{"text":"wale waliokuwa wamefurahia fahari yake,","poem":1},{"text":"kwa sababu itaondolewa kutoka kwao","poem":2},{"lineBreak":true},{"text":"kwenda uhamishoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Itachukuliwa kwenda Ashuru","poem":1},{"text":"kama ushuru kwa mfalme mkuu.","poem":2},{"text":"Efraimu atafedheheshwa;","poem":1},{"text":"Israeli ataaibika kwa ajili ya sanamu zake za mti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Samaria na mfalme wake wataelea","poem":1},{"text":"kama kijiti juu ya maji.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mahali pa juu pa uovu","poem":1},{"noteId":14},{"text":"pataharibiwa:","poem":1},{"text":"ndiyo dhambi ya Israeli.","poem":2},{"text":"Miiba na mibaruti itaota","poem":1},{"text":"na kufunika madhabahu zao.","poem":2},{"text":"Kisha wataiambia milima, “Tufunikeni!”","poem":1},{"text":"na vilima, “Tuangukieni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Tangu siku za Gibea, umetenda dhambi, ee Israeli,","poem":1},{"text":"huko ndiko ulibaki.","poem":2},{"text":"Je, vita havikuwapata","poem":1},{"text":"watenda maovu huko Gibea?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wakati nitakapopenda, nitawaadhibu;","poem":1},{"text":"mataifa yatakusanywa dhidi yao","poem":2},{"text":"ili kuwaweka katika vifungo","poem":1},{"text":"kwa ajili ya dhambi zao mbili.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraimu ni ndama jike aliyefundishwa","poem":1},{"text":"ambaye hupenda kupura;","poem":2},{"text":"hivyo nitamfunga nira","poem":1},{"text":"juu ya shingo yake nzuri.","poem":2},{"text":"Nitamwendesha Efraimu,","poem":1},{"text":"Yuda lazima alime,","poem":2},{"text":"naye Yakobo lazima avunjavunje","poem":1},{"text":"mabonge ya udongo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Jipandieni wenyewe haki,","poem":1},{"text":"vuneni matunda ya upendo usio na kikomo,","poem":2},{"text":"vunjeni ardhi yenu isiyolimwa;","poem":1},{"text":"kwa kuwa ni wakati wa kumtafuta Mwenyezi Mungu,","poem":2},{"text":"hadi atakapokuja","poem":1},{"text":"na kuwanyeshea juu yenu haki.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lakini mmepanda uovu,","poem":1},{"text":"mkavuna ubaya,","poem":2},{"lineBreak":true},{"text":"mmekula tunda la udanganyifu.","poem":2},{"text":"Kwa sababu mmetegemea nguvu zenu wenyewe","poem":1},{"text":"na wingi wa mashujaa wenu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"mngurumo wa vita utainuka dhidi ya watu wako,","poem":1},{"text":"na ngome zako zote zitaharibiwa:","poem":2},{"text":"kama Shalmani alivyoharibu Beth-Arbeli katika siku ile ya vita,","poem":1},{"text":"wakati mama pamoja na watoto wao","poem":2},{"lineBreak":true},{"text":"walipotupwa kwa nguvu ardhini.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndivyo itakavyotokea kwako, ee Betheli,","poem":1},{"text":"kwa sababu uovu wako ni mkuu.","poem":2},{"text":"Siku ile itakapopambazuka,","poem":1},{"text":"mfalme wa Israeli ataharibiwa kabisa.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"maana yake Nyumba ya Ubatili (au Uovu); yaani Betheli kwa dhihaka","reference":{"chapter":10,"verse":5}},{"noteId":14,"caller":"+","text":"yaani Aveni kwa Kiebrania, kumaanisha Beth-Aveni","reference":{"chapter":10,"verse":8}}]},"thisChapterLink":"/api/swh_onmm/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}