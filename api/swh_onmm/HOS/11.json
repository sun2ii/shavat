{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["Upendo wa Mwenyezi Mungu kwa Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Israeli alipokuwa mtoto, nilimpenda;","poem":1},{"text":"nilimwita mwanangu kutoka Misri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lakini kadiri nilivyomwita Israeli,","poem":1},{"text":"ndivyo walivyoenda mbali nami.","poem":2},{"text":"Walitoa dhabihu kwa Mabaali","poem":1},{"text":"na kufukiza uvumba kwa vinyago.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mimi ndiye niliyemfundisha Efraimu kutembea,","poem":1},{"text":"nikiwashika mikono;","poem":2},{"text":"lakini hawakutambua","poem":1},{"text":"kuwa ni mimi niliyewaponya.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Niliwaongoza kwa kamba za huruma ya kibinadamu,","poem":1},{"text":"kwa vifungo vya upendo;","poem":2},{"text":"niliondoa nira shingoni mwao","poem":1},{"text":"nami nikainama kuwalisha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Je, hawatarudi Misri,","poem":1},{"text":"nayo Ashuru haitawatawala","poem":2},{"lineBreak":true},{"text":"kwa sababu wamekataa kutubu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Upanga utavurumishwa katika miji yao,","poem":1},{"text":"nao utaharibu makomeo ya malango yao","poem":2},{"lineBreak":true},{"text":"na kukomesha mipango yao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Watu wangu wamedhamiria kuniacha.","poem":1},{"text":"Hata wakimwita Yeye Aliye Juu Sana,","poem":2},{"lineBreak":true},{"text":"kwa vyovyote hatawainua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efraimu, ninawezaje kukuacha?","poem":1},{"text":"Ee Israeli, ninawezaje kukutoa?","poem":2},{"text":"Nitawezaje kukutendea kama Adma?","poem":1},{"text":"Nitawezaje kukufanya kama Seboimu?","poem":2},{"text":"Moyo wangu umegeuka ndani yangu,","poem":1},{"text":"huruma zangu zote zimeamshwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sitatimiza hasira yangu kali,","poem":1},{"text":"wala sitageuka na kumharibu Efraimu.","poem":2},{"text":"Kwa kuwa mimi ndimi Mungu,","poem":1},{"text":"wala si mwanadamu,","poem":2},{"text":"Aliye Mtakatifu miongoni mwenu.","poem":1},{"text":"Sitakuja kwa ghadhabu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watamfuata Mwenyezi Mungu;","poem":1},{"text":"atanguruma kama simba.","poem":2},{"text":"Anaponguruma,","poem":1},{"text":"watoto wake watakuja wakitetemeka","poem":2},{"lineBreak":true},{"text":"kutoka magharibi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Watakuja wakitetemeka","poem":1},{"text":"kama ndege wakitoka Misri,","poem":2},{"lineBreak":true},{"text":"kama hua wakitoka Ashuru.","poem":2},{"text":"Nitawafanya waishi katika nyumba zao,”","poem":1},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"heading","content":["Dhambi ya Israeli"]},{"type":"verse","number":12,"content":[{"text":"Efraimu amenizunguka kwa uongo,","poem":1},{"text":"nyumba ya Israeli kwa udanganyifu.","poem":2},{"text":"Naye Yuda ni mkaidi dhidi ya Mungu,","poem":1},{"text":"hata kinyume cha yule mwaminifu Aliye Mtakatifu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}