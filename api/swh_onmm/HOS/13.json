{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["Hasira ya Mwenyezi Mungu dhidi ya Israeli"]},{"type":"verse","number":1,"content":[{"text":"Efraimu alipozungumza, watu walitetemeka;","poem":1},{"text":"alitukuzwa katika Israeli.","poem":2},{"text":"Lakini alikuwa na hatia ya kumwabudu Baali,","poem":1},{"text":"naye akafa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sasa wanatenda dhambi zaidi na zaidi;","poem":1},{"text":"wanajitengenezea sanamu","poem":2},{"lineBreak":true},{"text":"kutokana na fedha yao,","poem":2},{"text":"vinyago vilivyotengenezwa kwa uhodari,","poem":1},{"text":"vyote kazi ya fundi stadi.","poem":2},{"text":"Inasemekana kuhusu hawa watu,","poem":1},{"text":"“Hutoa dhabihu za binadamu","poem":2},{"lineBreak":true},{"text":"na kubusu sanamu za ndama.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa hiyo watakuwa kama ukungu wa asubuhi,","poem":1},{"text":"kama umande wa alfajiri utowekao,","poem":2},{"text":"kama makapi yapeperushwayo","poem":1},{"text":"kutoka sakafu ya kupuria nafaka,","poem":2},{"lineBreak":true},{"text":"kama moshi utorokao kupitia dirishani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Bali mimi ndimi Mwenyezi Mungu, Mungu wenu,","poem":1},{"text":"niliyewaleta ninyi toka Misri.","poem":2},{"text":"Msimkubali Mungu mwingine ila mimi,","poem":1},{"text":"hakuna Mwokozi isipokuwa mimi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Niliwatunza huko jangwani,","poem":1},{"text":"katika nchi yenye joto liunguzalo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nilipowalisha, walishiba,","poem":1},{"text":"waliposhiba, wakajivuna,","poem":2},{"lineBreak":true},{"text":"kisha wakanisahau mimi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa hiyo nitakuja juu yao kama simba,","poem":1},{"text":"kama chui nitawavizia kando ya njia.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kama dubu aliyenyang’anywa watoto wake,","poem":1},{"text":"nitawashambulia na kurarua vifua vyenu.","poem":2},{"text":"Kama simba nitawala;","poem":1},{"text":"mnyama pori atawararua vipande vipande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ee Israeli, umeangamizwa,","poem":1},{"text":"kwa sababu wewe u kinyume nami,","poem":2},{"lineBreak":true},{"text":"kinyume na msaidizi wako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yuko wapi mfalme wako,","poem":1},{"text":"ili apate kukuokoa?","poem":2},{"text":"Wako wapi watawala wako katika miji yako yote","poem":1},{"text":"ambao ulisema kuwahusu,","poem":2},{"lineBreak":true},{"text":"‘Nipe mfalme na wakuu’?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hivyo katika hasira yangu nilikupa mfalme","poem":1},{"text":"na katika ghadhabu yangu nilimwondoa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kosa la Efraimu limehifadhiwa,","poem":1},{"text":"dhambi zake zimewekwa katika kumbukumbu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uchungu kama wa mwanamke anayejifungua mtoto humjia,","poem":1},{"text":"lakini yeye ni mtoto asiyekuwa na hekima;","poem":2},{"text":"wakati utakapowadia hatatoka","poem":1},{"text":"katika tumbo la mama yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Nitawakomboa watu hawa kutoka nguvu za kaburi,","poem":1},{"text":"nitawakomboa kutoka mautini.","poem":2},{"text":"Yako wapi, ee mauti, mateso yako?","poem":1},{"lineBreak":true},{"text":"Uko wapi, ee Kuzimu","poem":1},{"noteId":15},{"text":", uharibifu wako?","poem":1},{"lineBreak":true},{"text":"“Sitakuwa na huruma,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"hata ingawa Efraimu atastawi","poem":2},{"lineBreak":true},{"text":"miongoni mwa ndugu zake.","poem":2},{"text":"Upepo wa mashariki kutoka kwa Mwenyezi Mungu utakuja,","poem":1},{"text":"ukivuma kutoka jangwani,","poem":2},{"text":"chemchemi yake haitatoa maji","poem":1},{"text":"na kisima chake kitakauka.","poem":2},{"text":"Ghala lake litatekwa","poem":1},{"text":"hazina zake zote.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Watu wa Samaria ni lazima wabebe hatia yao,","poem":1},{"text":"kwa sababu wameasi dhidi ya Mungu wao.","poem":2},{"text":"Wataanguka kwa upanga;","poem":1},{"text":"watoto wao wadogo watatupwa kwa nguvu ardhini,","poem":2},{"lineBreak":true},{"text":"wanawake wao walio na mimba watatumbuliwa.”","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":13,"verse":14}}]},"thisChapterLink":"/api/swh_onmm/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}