{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["Shtaka dhidi ya Israeli"]},{"type":"verse","number":1,"content":[{"text":"Sikieni neno la Mwenyezi Mungu, enyi Waisraeli,","poem":1},{"text":"kwa sababu Mwenyezi Mungu analo shtaka","poem":2},{"lineBreak":true},{"text":"dhidi yenu ninyi mnaoishi katika nchi:","poem":2},{"text":"“Hakuna uaminifu, hakuna upendo,","poem":1},{"text":"hakuna kumjua Mungu katika nchi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuna kulaani tu, uongo na uuaji,","poem":1},{"text":"wizi na uzinzi,","poem":2},{"text":"bila kuwa na mipaka,","poem":1},{"text":"nao umwagaji damu mmoja","poem":2},{"lineBreak":true},{"text":"baada ya mwingine.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa sababu hii nchi huomboleza,","poem":1},{"text":"wote wanaoishi ndani yake wanadhoofika;","poem":2},{"text":"wanyama wa kondeni, ndege wa angani","poem":1},{"text":"na samaki wa baharini wanakufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Lakini mtu yeyote na asilete shtaka,","poem":1},{"text":"mtu yeyote na asimlaumu mwenzake,","poem":2},{"text":"kwa maana watu wako ni kama wale","poem":1},{"text":"waletao mashtaka dhidi ya kuhani.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unajikwaa usiku na mchana,","poem":1},{"text":"nao manabii hujikwaa pamoja nawe.","poem":2},{"text":"Kwa hiyo nitamwangamiza mama yako:","poem":1}]},{"type":"verse","number":6,"content":[{"text":"watu wangu wanaangamizwa","poem":2},{"lineBreak":true},{"text":"kwa kukosa maarifa.","poem":2},{"lineBreak":true},{"text":"“Kwa kuwa wewe umeyakataa maarifa,","poem":1},{"text":"mimi nami nitakukataa wewe","poem":2},{"lineBreak":true},{"text":"usiwe kuhani kwangu mimi;","poem":2},{"text":"kwa kuwa umeacha kuijali Torati ya Mungu wako","poem":1},{"text":"mimi nami sitawajali watoto wako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kadiri makuhani walivyoongezeka,","poem":1},{"text":"ndivyo walivyozidi kutenda dhambi dhidi yangu,","poem":2},{"lineBreak":true},{"text":"walibadilisha utukufu wao kwa kitu cha aibu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wanajilisha dhambi za watu wangu","poem":1},{"text":"na kupendezwa na uovu wao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hata itakuwa: Kama walivyo watu,","poem":1},{"text":"ndivyo walivyo makuhani.","poem":2},{"text":"Nitawaadhibu wote wawili kwa ajili ya njia zao","poem":1},{"text":"na kuwalipa kwa matendo yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Watakula lakini hawatashiba;","poem":1},{"text":"watajiingiza katika ukahaba","poem":2},{"lineBreak":true},{"text":"lakini hawataongezeka,","poem":2},{"text":"kwa sababu wamemwacha Mwenyezi Mungu","poem":1},{"text":"na kujiingiza wenyewe","poem":2}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"katika ukahaba;","poem":2},{"text":"kunywa divai ya zamani na divai mpya","poem":1},{"text":"huondoa ufahamu","poem":2}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"wa watu wangu.","poem":2},{"text":"Hutaka shauri kutoka kwa sanamu ya mti","poem":1},{"text":"nao hujibiwa na fimbo ya mti.","poem":2},{"text":"Roho ya ukahaba imewapotosha,","poem":1},{"text":"hawana uaminifu kwa Mungu wao.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wanatoa dhabihu juu ya vilele vya milima","poem":1},{"text":"na sadaka za kuteketezwa juu ya vilima,","poem":2},{"text":"chini ya mialoni, milibua na miela,","poem":1},{"text":"ambako kuna vivuli vizuri.","poem":2},{"text":"Kwa hiyo binti zenu wamegeukia ukahaba","poem":1},{"text":"na wake za wana wenu uzinzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Sitawaadhibu binti zenu wakati","poem":1},{"text":"wanapogeukia ukahaba,","poem":2},{"text":"wala wake za wana wenu","poem":1},{"text":"wanapofanya uzinzi,","poem":2},{"text":"kwa sababu wanaume wenyewe huandamana na malaya","poem":1},{"text":"na kutambikia pamoja na makahaba","poem":2},{"lineBreak":true},{"text":"wa mahali pa ibada za sanamu:","poem":2},{"text":"watu wasiokuwa na ufahamu","poem":1},{"text":"wataangamia!","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ingawa umefanya uzinzi, ee Israeli,","poem":1},{"text":"Yuda naye asije akawa na hatia.","poem":2},{"lineBreak":true},{"text":"“Usiende Gilgali,","poem":1},{"text":"usipande kwenda Beth-Aveni","poem":2},{"noteId":10},{"text":".","poem":2},{"text":"Wala usiape,","poem":1},{"text":"‘Hakika kama Mwenyezi Mungu aishivyo!’","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waisraeli ni wakaidi,","poem":1},{"text":"kama ndama jike mkaidi.","poem":2},{"text":"Ni jinsi gani basi Mwenyezi Mungu anaweza kuwachunga","poem":1},{"text":"kama wana-kondoo","poem":2},{"lineBreak":true},{"text":"katika shamba la majani?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efraimu amejiunga na sanamu,","poem":1},{"text":"achana naye!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hata wakati wamemaliza vileo vyao","poem":1},{"text":"wanaendelea na ukahaba wao,","poem":2},{"text":"watawala wao hupenda sana","poem":1},{"text":"njia za aibu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kisulisuli kitawafagilia mbali","poem":1},{"text":"na dhabihu zao zitawaletea aibu.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"maana yake Nyumba ya Ubatili (au Uovu); yaani Betheli kwa dhihaka","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/swh_onmm/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}