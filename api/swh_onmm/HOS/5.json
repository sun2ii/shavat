{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["Hukumu dhidi ya Israeli"]},{"type":"verse","number":1,"content":[{"text":"“Sikieni hili, enyi makuhani!","poem":1},{"text":"Kuweni wasikivu, enyi Waisraeli!","poem":2},{"text":"Sikieni, ee nyumba ya mfalme!","poem":1},{"text":"Hukumu hii ni dhidi yenu:","poem":2},{"text":"Mmekuwa mtego huko Mispa,","poem":1},{"text":"wavu uliotandwa juu ya Tabori.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waasi wamezidisha sana mauaji.","poem":1},{"text":"Mimi nitawatiisha wote.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ninajua yote kuhusu Efraimu,","poem":1},{"text":"Israeli hukufichika kwangu.","poem":2},{"text":"Efraimu, sasa umegeukia ukahaba,","poem":1},{"text":"Israeli amenajisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Matendo yao hayawaachii","poem":1},{"text":"kurudi kwa Mungu wao.","poem":2},{"text":"Roho ya ukahaba iko ndani ya mioyo yao,","poem":1},{"text":"hawamkubali Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kiburi cha Israeli kinashuhudia dhidi yao;","poem":1},{"text":"Waisraeli, hata Efraimu,","poem":2},{"text":"wanajikwaa katika dhambi zao;","poem":1},{"text":"pia Yuda atajikwaa pamoja nao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wanapoenda na makundi yao ya kondoo na ng’ombe","poem":1},{"text":"kumtafuta Mwenyezi Mungu,","poem":2},{"text":"hawatampata;","poem":1},{"text":"yeye amejiondoa kutoka kwao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wao si waaminifu kwa Mwenyezi Mungu;","poem":1},{"text":"wamezaa watoto haramu.","poem":2},{"text":"Sasa sikukuu zao za Mwandamo wa Mwezi","poem":1},{"text":"zitawaangamiza wao","poem":2},{"lineBreak":true},{"text":"pamoja na mashamba yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Pigeni tarumbeta huko Gibea,","poem":1},{"text":"na baragumu huko Rama.","poem":2},{"text":"Pazeni kelele za vita huko Beth-Aveni","poem":1},{"noteId":11},{"text":";","poem":1},{"text":"ongoza, ee Benyamini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efraimu ataachwa ukiwa","poem":1},{"text":"katika siku ya kuadhibiwa.","poem":2},{"text":"Miongoni mwa makabila ya Israeli","poem":1},{"text":"ninatangaza lile ambalo halina budi kutukia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Viongozi wa Yuda ni kama wale","poem":1},{"text":"wanaosogeza mawe ya mpaka.","poem":2},{"text":"Nitamwaga ghadhabu yangu juu yao","poem":1},{"text":"kama mafuriko ya maji.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraimu amedhulumiwa,","poem":1},{"text":"amekanyagwa katika hukumu","poem":2},{"lineBreak":true},{"text":"kwa kuwa amekusudia kufuatia sanamu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mimi ni kama nondo kwa Efraimu,","poem":1},{"text":"na kama uozo kwa watu wa Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Efraimu alipoona ugonjwa wake,","poem":1},{"text":"naye Yuda vidonda vyake,","poem":2},{"text":"ndipo Efraimu aligeukia Ashuru,","poem":1},{"text":"na kuomba msaada kwa mfalme mkuu.","poem":2},{"text":"Lakini hawezi kukuponya,","poem":1},{"text":"hawezi kukuponya vidonda vyako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa maana nitakuwa kama simba kwa Efraimu,","poem":1},{"text":"kama simba mkubwa kwa Yuda.","poem":2},{"text":"Nitawararua vipande vipande na kuondoka;","poem":1},{"text":"nitawachukua mbali,","poem":2},{"lineBreak":true},{"text":"na hakuna wa kuwaokoa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kisha nitarudi mahali pangu","poem":1},{"text":"hadi watakapokubali kosa lao.","poem":2},{"text":"Nao watautafuta uso wangu;","poem":1},{"text":"katika taabu yao watanitafuta kwa bidii.”","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"maana yake Nyumba ya Ubatili (au Uovu); yaani Betheli kwa dhihaka","reference":{"chapter":5,"verse":8}}]},"thisChapterLink":"/api/swh_onmm/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}