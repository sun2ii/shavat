{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["Israeli asiye tubu"]},{"type":"verse","number":1,"content":[{"text":"“Njooni, tumrudie Mwenyezi Mungu.","poem":1},{"lineBreak":true},{"text":"Ameturarua vipande vipande","poem":1},{"text":"lakini atatuponya;","poem":2},{"text":"ametujeruhi lakini","poem":1},{"text":"atatufunga majeraha yetu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Baada ya siku mbili atatufufua;","poem":1},{"text":"katika siku ya tatu atatuinua,","poem":2},{"lineBreak":true},{"text":"ili tuweze kuishi mbele zake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tumkubali Mwenyezi Mungu,","poem":1},{"text":"tukaze kumkubali yeye.","poem":2},{"text":"Kutokea kwake ni hakika kama vile","poem":1},{"text":"kuchomoza kwa jua;","poem":2},{"text":"atatujia kama mvua za masika,","poem":1},{"text":"kama vile mvua za vuli","poem":2},{"lineBreak":true},{"text":"ziinyweshavyo nchi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nifanye nini nawe, Efraimu?","poem":1},{"text":"Nifanye nini nawe, Yuda?","poem":2},{"text":"Upendo wako ni kama ukungu wa asubuhi,","poem":1},{"text":"kama umande wa alfajiri utowekao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa hiyo nimewakata ninyi vipande vipande","poem":1},{"text":"nikitumia manabii wangu;","poem":2},{"text":"nimewaua ninyi kwa maneno ya kinywa changu,","poem":1},{"text":"hukumu zangu zinawaka","poem":2},{"lineBreak":true},{"text":"kama umeme juu yenu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa maana nataka rehema, wala si dhabihu,","poem":1},{"text":"na kumkubali Mungu","poem":2},{"lineBreak":true},{"text":"kuliko sadaka za kuteketezwa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wamevunja agano kama Adamu:","poem":1},{"text":"hawakuwa waaminifu kwangu huko.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gileadi ni mji wa watenda maovu,","poem":1},{"text":"umetiwa madoa kwa nyayo za damu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kama wanyang’anyi wamviziavyo mtu,","poem":1},{"text":"ndivyo magenge ya makuhani wafanyavyo;","poem":2},{"text":"wanaulia watu kwenye njia iendayo Shekemu,","poem":1},{"text":"wakifanya uhalifu wa aibu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nimeona jambo la kutisha","poem":1},{"text":"katika nyumba ya Israeli.","poem":2},{"text":"Huko Efraimu amejitolea kwa ukahaba","poem":1},{"text":"na Israeli amenajisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Pia kwa ajili yako, Yuda,","poem":1},{"text":"mavuno yameamriwa.","poem":2},{"lineBreak":true},{"text":"“Wakati wowote ningerejesha neema ya watu wangu,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}