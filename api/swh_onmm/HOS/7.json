{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"kila mara nilipotaka kumponya Israeli,","poem":2},{"text":"dhambi za Efraimu zinafichuliwa","poem":1},{"text":"na maovu ya Samaria yanafunuliwa.","poem":2},{"text":"Wanafanya udanganyifu,","poem":1},{"text":"wezi huvunja nyumba,","poem":2},{"lineBreak":true},{"text":"maharamia hunyang’anya barabarani,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"lakini hawafahamu kwamba","poem":1},{"text":"ninakumbuka matendo yao yote mabaya.","poem":2},{"text":"Dhambi zao zimewameza,","poem":1},{"text":"ziko mbele zangu siku zote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Wanamfurahisha sana mfalme kwa maovu yao,","poem":1},{"text":"wakuu wao kwa uongo wao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wote ni wazinzi,","poem":1},{"text":"wanawaka kama tanuru","poem":2},{"text":"ambalo moto wake mwokaji hana haja ya kuuchochea","poem":1},{"text":"kuanzia kukanda unga","poem":2},{"lineBreak":true},{"text":"hadi umekwisha kuumuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Katika sikukuu ya mfalme wetu","poem":1},{"text":"wakuu wanawaka kwa mvinyo,","poem":2},{"lineBreak":true},{"text":"naye anawaunga mkono wenye mizaha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mioyo yao ni kama tanuru,","poem":1},{"text":"wanamwendea kwa hila.","poem":2},{"text":"Hasira yao inafoka moshi usiku kucha,","poem":1},{"text":"wakati wa asubuhi inalipuka","poem":2},{"lineBreak":true},{"text":"kama miali ya moto.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wote ni moto kama tanuru;","poem":1},{"text":"wanawaangamiza watawala wao.","poem":2},{"text":"Wafalme wake wote wanaanguka,","poem":1},{"text":"wala hakuna yeyote kati yao aniitaye mimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efraimu anajichanganya na mataifa;","poem":1},{"text":"Efraimu ni mkate ambao haukuiva.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wageni wananyonya nguvu zake,","poem":1},{"text":"lakini hafahamu hilo.","poem":2},{"text":"Nywele zake zina mvi hapa na pale,","poem":1},{"text":"lakini hana habari.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kiburi cha Israeli kinashuhudia dhidi yake,","poem":1},{"text":"lakini pamoja na haya yote","poem":2},{"text":"harudi kwa Mwenyezi Mungu, Mungu wake,","poem":1},{"text":"wala kumtafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efraimu ni kama hua,","poem":1},{"text":"hudanganywa kwa urahisi na hana akili:","poem":2},{"text":"mara anaita Misri,","poem":1},{"text":"mara anageukia Ashuru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watakapoenda, nitatupa wavu wangu juu yao;","poem":1},{"text":"nitawavuta chini waanguke kama ndege wa angani.","poem":2},{"text":"Nitakaposikia wakikusanyika pamoja,","poem":1},{"text":"nitawanasa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ole wao, kwa sababu","poem":1},{"text":"wamepotoka kutoka kwangu!","poem":2},{"text":"Maangamizi ni yao","poem":1},{"text":"kwa sababu wameniasi!","poem":2},{"text":"Ninatamani kuwakomboa,","poem":1},{"text":"lakini wanasema uongo dhidi yangu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hawanililii mimi kutoka mioyoni mwao,","poem":1},{"text":"bali wanaomboleza vitandani mwao.","poem":2},{"text":"Hukusanyika pamoja kwa ajili ya nafaka na divai mpya,","poem":1},{"text":"lakini hugeukia mbali nami.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Niliwafundisha na kuwatia nguvu,","poem":1},{"text":"lakini wanapanga mabaya dhidi yangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hawamgeukii Yeye Aliye Juu Sana,","poem":1},{"text":"wako kama upinde wenye kasoro.","poem":2},{"text":"Viongozi wao wataanguka kwa upanga","poem":1},{"text":"kwa sababu ya maneno yao ya jeuri.","poem":2},{"text":"Kwa ajili ya hili watadhihakiwa","poem":1},{"text":"katika nchi ya Misri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}