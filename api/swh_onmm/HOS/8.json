{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["Israeli kuvuna kisulisuli"]},{"type":"verse","number":1,"content":[{"text":"“Wekeni tarumbeta midomoni mwenu!","poem":1},{"text":"Tai yuko juu ya nyumba ya Mwenyezi Mungu","poem":2},{"text":"kwa sababu watu wamevunja agano langu,","poem":1},{"text":"wameasi dhidi ya sheria yangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Israeli ananililia,","poem":1},{"text":"‘Ee Mungu wetu, tunakukubali!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lakini Israeli amekataa lile lililo jema,","poem":1},{"text":"adui atamfuatia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wanaweka wafalme bila idhini yangu,","poem":1},{"text":"wamechagua wakuu bila kibali changu.","poem":2},{"text":"Kwa fedha zao na dhahabu","poem":1},{"text":"wamejitengenezea sanamu kwa ajili","poem":2},{"lineBreak":true},{"text":"ya maangamizi yao wenyewe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Samaria, tupilieni mbali sanamu yenu ya ndama!","poem":1},{"text":"Hasira yangu inawaka dhidi yao.","poem":2},{"text":"Watakuwa najisi hadi lini?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Zimetoka katika Israeli!","poem":2},{"text":"Ndama huyu: ametengenezwa na fundi, si Mungu.","poem":1},{"text":"Atavunjwa vipande vipande,","poem":2},{"lineBreak":true},{"text":"yule ndama wa Samaria.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Wanapanda upepo","poem":1},{"text":"na kuvuna kisulisuli.","poem":2},{"text":"Bua halina suke,","poem":1},{"text":"halitatoa unga.","poem":2},{"text":"Kama lingetoa nafaka,","poem":1},{"text":"wageni wangeila yote.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Israeli amemezwa;","poem":1},{"text":"sasa yupo miongoni mwa mataifa","poem":2},{"lineBreak":true},{"text":"kama kitu kisicho na thamani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa kuwa wamepanda kwenda Ashuru","poem":1},{"text":"kama punda-mwitu anayetangatanga peke yake.","poem":2},{"text":"Efraimu amejiuza mwenyewe","poem":1},{"text":"kwa wapenzi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ingawa wamejiuza wenyewe miongoni mwa mataifa,","poem":1},{"text":"sasa nitawakusanya pamoja.","poem":2},{"text":"Wataanza kudhoofika chini ya uonevu","poem":1},{"text":"wa mfalme mwenye nguvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ingawa Efraimu alijenga madhabahu nyingi","poem":1},{"text":"kwa ajili ya sadaka za dhambi,","poem":2},{"text":"hizi zimekuwa madhabahu","poem":1},{"text":"za kufanyia dhambi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Niliwaandikia mambo mengi yaliyohusu sheria yangu,","poem":1},{"text":"lakini waliziangalia kama kitu kigeni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wanatoa dhabihu nilizopewa mimi","poem":1},{"text":"nao wanakula hiyo nyama,","poem":2},{"lineBreak":true},{"text":"lakini Mwenyezi Mungu hapendezwi nao.","poem":2},{"text":"Sasa ataukumbuka uovu wao","poem":1},{"text":"na kuadhibu dhambi zao:","poem":2},{"lineBreak":true},{"text":"Watarudi Misri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Israeli amemsahau Muumba wake","poem":1},{"text":"na kujenga majumba ya kifalme,","poem":2},{"lineBreak":true},{"text":"Yuda amejengea miji mingi ngome.","poem":2},{"text":"Lakini nitatuma moto kwenye miji yao","poem":1},{"text":"utakaoteketeza ngome zao.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}