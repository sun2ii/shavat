{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"HOS","translationId":"swh_onmm","name":"Hosea","commonName":"Hosea","title":"Hosea","order":28,"numberOfChapters":14,"sha256":"6568866dace38c0d0a6ebe8b00397f012e0d836e3605dfacce8a9827d5906596","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["Adhabu kwa Israeli"]},{"type":"verse","number":1,"content":[{"text":"Usifurahie, ee Israeli;","poem":1},{"text":"usishangilie kama mataifa mengine.","poem":2},{"text":"Kwa kuwa hukuwa","poem":1},{"text":"mwaminifu kwa Mungu wako;","poem":2},{"text":"umependa ujira wa kahaba kwenye kila sakafu","poem":1},{"text":"ya kupuria nafaka.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sakafu za kupuria nafaka na mashinikizo ya kukamulia divai","poem":1},{"text":"havitalisha watu,","poem":2},{"lineBreak":true},{"text":"divai mpya itawapungukia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hawataishi katika nchi ya Mwenyezi Mungu,","poem":1},{"text":"Efraimu atarudi Misri","poem":2},{"text":"na atakula chakula","poem":1},{"text":"kilicho najisi huko Ashuru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hawatammiminia Mwenyezi Mungu sadaka ya divai","poem":1},{"text":"wala dhabihu zao hazitampendeza.","poem":2},{"text":"Dhabihu kama hizo zitakuwa kwao","poem":1},{"text":"kama mkate wa waombolezaji;","poem":2},{"lineBreak":true},{"text":"nao wote wazilao watakuwa najisi.","poem":2},{"text":"Chakula hiki kitakuwa kwa ajili yao wenyewe;","poem":1},{"text":"kisije katika Hekalu la Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mtafanya nini katika siku ya sikukuu zenu zilizoamriwa,","poem":1},{"text":"katika siku za sikukuu za Mwenyezi Mungu?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hata ikiwa wataokoka maangamizi,","poem":1},{"text":"Misri atawakusanya,","poem":2},{"lineBreak":true},{"text":"nayo Memfisi","poem":2},{"noteId":12},{"text":"itawazika.","poem":2},{"text":"Hazina zao za fedha zitasongwa na michongoma,","poem":1},{"text":"nayo miiba itafunika mahema yao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Siku za adhabu zinakuja,","poem":1},{"text":"siku za malipo zimewadia.","poem":2},{"lineBreak":true},{"text":"Israeli na afahamu hili.","poem":2},{"text":"Kwa sababu dhambi zenu ni nyingi sana","poem":1},{"text":"na uadui wenu ni mkubwa sana,","poem":2},{"text":"nabii anadhaniwa ni mpumbavu,","poem":1},{"text":"mtu aliyeongozwa na Mungu","poem":2},{"lineBreak":true},{"text":"anaonekana mwendawazimu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nabii, pamoja na Mungu wangu,","poem":1},{"text":"ndiye mlinzi juu ya Efraimu,","poem":2},{"text":"hata hivyo mitego inamngojea","poem":1},{"text":"katika mapito yake yote,","poem":2},{"lineBreak":true},{"text":"na uadui katika nyumba ya Mungu wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wamezama sana katika rushwa,","poem":1},{"text":"kama katika siku za Gibea.","poem":2},{"text":"Mungu atakumbuka uovu wao","poem":1},{"text":"na kuwaadhibu kwa ajili ya dhambi zao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Nilipompata Israeli, ilikuwa kama","poem":1},{"text":"kupata zabibu jangwani;","poem":2},{"text":"nilipowaona baba zenu, ilikuwa kama kuona","poem":1},{"text":"matunda ya kwanza katika mtini.","poem":2},{"text":"Lakini walipofika Baal-Peori, walijiweka wakfu","poem":1},{"text":"kwa ile sanamu ya aibu,","poem":2},{"text":"nao wakawa najisi","poem":1},{"text":"kama kitu kile walichokipenda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Utukufu wa Efraimu utaruka kama ndege:","poem":1},{"text":"hakuna kuzaa, hakuna kubeba mimba,","poem":2},{"lineBreak":true},{"text":"hakuna kuchukua mimba.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hata wakilea watoto,","poem":1},{"text":"nitamuua kila mmoja.","poem":2},{"text":"Ole wao","poem":1},{"text":"nitakapowapiga kisogo!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nimemwona Efraimu, kama Tiro,","poem":1},{"text":"aliyeoteshwa mahali pazuri.","poem":2},{"text":"Lakini Efraimu wataleta","poem":1},{"text":"watoto wao kwa mchinjaji.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Wape, Ee Mwenyezi Mungu,","poem":1},{"text":"je, utawapa nini?","poem":2},{"text":"Wape tumbo zinazoharibu mimba","poem":1},{"text":"na matiti yaliyokauka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Kwa sababu ya uovu wao wote huko Gilgali,","poem":1},{"text":"niliwachukia huko.","poem":2},{"text":"Kwa sababu ya matendo yao ya dhambi,","poem":1},{"text":"nitawafukuza katika nyumba yangu.","poem":2},{"text":"Sitawapenda tena,","poem":1},{"text":"viongozi wao wote ni waasi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efraimu ameharibiwa,","poem":1},{"text":"mzizi wao umenyauka,","poem":2},{"lineBreak":true},{"text":"hawazai tunda.","poem":2},{"text":"Hata kama watazaa watoto,","poem":1},{"text":"nitawachinja wazao wao","poem":2},{"lineBreak":true},{"text":"waliotunzwa vizuri.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mungu wangu atawakataa","poem":1},{"text":"kwa sababu hawakumtii;","poem":2},{"text":"watakuwa watu wa kutangatanga","poem":1},{"text":"miongoni mwa mataifa.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":12,"caller":"+","text":"yaani Nofu","reference":{"chapter":9,"verse":6}}]},"thisChapterLink":"/api/swh_onmm/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}