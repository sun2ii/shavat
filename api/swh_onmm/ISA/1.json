{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Maono kuhusu Yuda na Yerusalemu ambayo Isaya mwana wa Amozi aliyaona wakati wa utawala wa Uzia, Yothamu, Ahazi na Hezekia, wafalme wa Yuda."]},{"type":"line_break"},{"type":"heading","content":["Taifa asi"]},{"type":"verse","number":2,"content":[{"text":"Sikieni, enyi mbingu! Sikilizeni, enyi dunia!","poem":1},{"text":"Kwa maana Mwenyezi Mungu amesema:","poem":2},{"text":"“Nimewalisha watoto na kuwalea,","poem":1},{"text":"lakini wameniasi mimi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ng’ombe anamjua bwana wake,","poem":1},{"text":"naye punda anajua hori la mmiliki wake,","poem":2},{"text":"lakini Israeli hajui,","poem":1},{"text":"watu wangu hawaelewi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ole wa taifa lenye dhambi,","poem":1},{"text":"watu waliolemewa na uovu,","poem":2},{"text":"uzao wa watenda mabaya,","poem":1},{"text":"watoto waliozoelea upotovu!","poem":2},{"text":"Wamemwacha Mwenyezi Mungu,","poem":1},{"text":"Wamemkataa kwa dharau","poem":2},{"lineBreak":true},{"text":"yeye Aliye Mtakatifu wa Israeli","poem":2},{"lineBreak":true},{"text":"na kumgeuzia kisogo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa nini mzidi kupigwa?","poem":1},{"text":"Kwa nini kudumu katika uasi?","poem":2},{"text":"Kichwa chako chote kimejeruhiwa,","poem":1},{"text":"moyo wako wote ni mgonjwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kutoka wayo wako wa mguu hadi kwenye utosi wa kichwa chako","poem":1},{"text":"hakuna uzima:","poem":2},{"text":"ni majeraha matupu na makovu","poem":1},{"text":"na vidonda vinavyotoa damu,","poem":2},{"text":"havikusafishwa au kufungwa","poem":1},{"text":"wala kulainishwa kwa mafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nchi yenu imekuwa ukiwa,","poem":1},{"text":"miji yenu imeteketezwa kwa moto;","poem":2},{"text":"mashamba yenu yameachwa tupu na wageni","poem":1},{"text":"mbele ya macho yenu,","poem":2},{"lineBreak":true},{"text":"yameharibiwa kama yaliyopinduliwa na wageni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Binti Sayuni ameachwa kama kipenu","poem":1},{"text":"katika shamba la mizabibu,","poem":2},{"text":"kama kibanda katika shamba la matango,","poem":1},{"text":"kama mji uliozingirwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kama Mwenyezi Mungu, Mungu wa majeshi ya mbinguni","poem":1},{"noteId":0},{"text":"hakutuachia walionusurika,","poem":2},{"text":"tungekuwa kama Sodoma,","poem":1},{"text":"tungefanana na Gomora.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Sikieni neno la Mwenyezi Mungu,","poem":1},{"text":"ninyi watawala wa Sodoma;","poem":2},{"text":"sikilizeni Torati ya Mungu wetu,","poem":1},{"text":"enyi watu wa Gomora!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu anasema, “Wingi wa sadaka zenu,","poem":1},{"text":"ni kitu gani kwangu?","poem":2},{"text":"Nina sadaka za kuteketezwa nyingi kupita kiasi,","poem":1},{"text":"za kondoo dume na mafuta ya wanyama walionona.","poem":2},{"text":"Sipendezwi na damu za mafahali","poem":1},{"text":"wala za wana-kondoo na mbuzi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mnapokuja kujihudhurisha mbele zangu,","poem":1},{"text":"ni nani aliyewataka ninyi mfanye hivyo,","poem":2},{"lineBreak":true},{"text":"huku kuzikanyaga nyua zangu?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Acheni kuniletea sadaka zisizokuwa na maana!","poem":1},{"text":"Uvumba wenu ni chukizo kwangu.","poem":2},{"text":"Miandamo ya Mwezi, Sabato na makusanyiko ya ibada:","poem":1},{"text":"siwezi kuvumilia makusanyiko yenu maovu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Sikukuu zenu za Miandamo ya Mwezi,","poem":1},{"text":"na sikukuu zenu zilizoamriwa:","poem":2},{"lineBreak":true},{"text":"moyo wangu unazichukia kabisa.","poem":2},{"text":"Zimekuwa mzigo kwangu,","poem":1},{"text":"nimechoka kuzivumilia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mnaponyoosha mikono yenu katika maombi,","poem":1},{"text":"nitaficha macho yangu nisiwaone;","poem":2},{"text":"hata mkiomba maombi mengi","poem":1},{"text":"sitasikiliza.","poem":2},{"lineBreak":true},{"text":"“Mikono yenu imejaa damu!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Jiosheni na mkajitakase.","poem":1},{"text":"Yaondoeni matendo yenu maovu mbele zangu;","poem":2},{"lineBreak":true},{"text":"acheni kutenda mabaya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jifunzeni kutenda mema, tafuteni haki.","poem":1},{"text":"Wateteeni waliodhulumiwa.","poem":2},{"text":"Teteeni shauri la yatima,","poem":1},{"text":"wateteeni wajane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Njooni basi tujadiliane,”","poem":1},{"text":"asema Mwenyezi Mungu.","poem":2},{"text":"“Ingawa dhambi zenu ni kama rangi nyekundu,","poem":1},{"text":"zitakuwa nyeupe kama theluji;","poem":2},{"text":"ingawa ni nyekundu sana kama damu,","poem":1},{"text":"zitakuwa nyeupe kama sufu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mkikubali na kutii,","poem":1},{"text":"mtakula mema ya nchi,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"lakini mkikataa na kuasi,","poem":1},{"text":"mtaangamizwa kwa upanga.”","poem":2},{"lineBreak":true},{"text":"Kwa kuwa kinywa cha Mwenyezi Mungu kimenena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Tazama jinsi mji uliokuwa mwaminifu","poem":1},{"text":"umekuwa kahaba!","poem":2},{"text":"Mwanzoni ulikuwa umejaa unyofu,","poem":1},{"text":"haki ilikuwa inakaa ndani yake,","poem":2},{"lineBreak":true},{"text":"lakini sasa ni wauaji!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Fedha yenu imekuwa takataka,","poem":1},{"text":"divai yenu nzuri imechanganywa na maji.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Watawala wenu ni waasi,","poem":1},{"text":"rafiki wa wezi,","poem":2},{"text":"wote wanapenda rushwa","poem":1},{"text":"na kukimbilia hongo.","poem":2},{"text":"Hawatetei yatima;","poem":1},{"text":"shauri la mjane haliletwi mbele yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kwa hiyo Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":1},{"text":"Mwenye Nguvu wa Israeli, asema hivi:","poem":2},{"text":"“Lo! Nitapata faraja kutoka kwa adui zangu,","poem":1},{"text":"na kujilipizia kisasi kwa watesi wangu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nitauelekeza mkono wangu dhidi yenu,","poem":1},{"text":"nitawasafisha takataka zenu zote","poem":2},{"lineBreak":true},{"text":"na kuwaondolea unajisi wenu wote.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nitawarudishia waamuzi wenu kama ilivyokuwa siku za zamani,","poem":1},{"text":"nao washauri wenu kama ilivyokuwa mwanzoni.","poem":2},{"text":"Baadaye utaitwa,","poem":1},{"text":"Mji wa Haki,","poem":2},{"lineBreak":true},{"text":"Mji Mwaminifu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Sayuni itakombolewa kwa haki,","poem":1},{"text":"wale walio ndani yake waliotubu, kwa uaminifu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Lakini waasi na wenye dhambi wote wataangamizwa,","poem":1},{"text":"nao wanaomwacha Mwenyezi Mungu wataangamia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Mtaaibika kwa sababu ya hiyo mialoni","poem":1},{"text":"ambayo mlifurahia,","poem":2},{"text":"mtafadhaika kwa sababu ya bustani","poem":1},{"text":"mlizozichagua.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mtakuwa kama mwaloni ulio na majani yanayonyauka,","poem":1},{"text":"kama bustani isiyokuwa na maji.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mtu mwenye nguvu atatoweka kama majani makavu yanayowaka moto,","poem":1},{"text":"na kazi yake kama cheche ya moto;","poem":2},{"text":"vyote vitaungua pamoja,","poem":1},{"text":"wala hakuna wa kuuzima huo moto.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni hapa ni Yahweh Sabaoth; pia Warumi 9:29 na Yakobo 5:4.","reference":{"chapter":1,"verse":9}}]},"thisChapterLink":"/api/swh_onmm/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}