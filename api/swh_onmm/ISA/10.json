{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Ole wao wawekao sheria zisizo za haki,","poem":1},{"text":"kwa wale watoao amri za kuonea,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuwanyima maskini haki zao","poem":1},{"text":"na kuzuilia haki za watu wangu waliodhulumiwa,","poem":2},{"text":"kuwafanya wajane mawindo yao","poem":1},{"text":"na kuwanyang’anya yatima.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mtafanya nini siku ya hukumu,","poem":1},{"text":"wakati maafa yatakapokuja kutoka mbali?","poem":2},{"text":"Mtamkimbilia nani awape msaada?","poem":1},{"text":"Mtaacha wapi mali yenu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hakutasalia kitu chochote,","poem":1},{"text":"isipokuwa kujikunyata miongoni mwa mateka,","poem":2},{"lineBreak":true},{"text":"au kuanguka miongoni mwa waliouawa.","poem":2},{"lineBreak":true},{"text":"Hata kwa haya yote, hasira yake haijageukia mbali,","poem":1},{"text":"mkono wake bado umeinuliwa juu.","poem":2}]},{"type":"heading","content":["Hukumu ya Mwenyezi Mungu juu ya Ashuru"]},{"type":"verse","number":5,"content":[{"text":"“Ole kwa Ashuru, fimbo ya hasira yangu,","poem":1},{"text":"ambaye mkononi mwake ana rungu ya ghadhabu yangu!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ninamtuma dhidi ya taifa lisilomjua Mungu,","poem":1},{"text":"ninamtuma dhidi ya taifa linalonikasirisha,","poem":2},{"text":"kukamata mateka na kunyakua nyara,","poem":1},{"text":"pia kuwakanyaga chini kama matope ya barabarani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lakini hili silo analokusudia,","poem":1},{"text":"hili silo alilo nalo akilini;","poem":2},{"text":"kusudi lake ni kuangamiza,","poem":1},{"text":"kuyakomesha mataifa mengi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maana asema, ‘Je, wafalme wote","poem":1},{"text":"si majemadari wangu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, Kalno hakutendwa kama Karkemishi?","poem":1},{"text":"Hamathi si kama Arpadi,","poem":2},{"lineBreak":true},{"text":"nayo Samaria si kama Dameski?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kama vile mkono wangu ulivyotwaa falme za sanamu,","poem":1},{"text":"falme ambazo vinyago vyao vilizidi vile vya Yerusalemu na Samaria:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"je, nisiutendee Yerusalemu na sanamu zake","poem":1},{"text":"kama nilivyoutendea Samaria na vinyago vyake?’ ”","poem":2}]},{"type":"verse","number":12,"content":["Bwana atakapokuwa amemaliza kazi yake yote dhidi ya Mlima Sayuni na Yerusalemu, atasema, “Nitamwadhibu mfalme wa Ashuru kwa ajili ya majivuno ya ukaidi wa moyo wake na kutazama kwa macho yenye dharau.”"]},{"type":"verse","number":13,"content":["Kwa kuwa anasema:",{"text":"“ ‘Kwa nguvu za mkono wangu nimefanya hili,","poem":1},{"text":"kwa hekima yangu, kwa sababu nina ufahamu.","poem":2},{"text":"Niliondoa mipaka ya mataifa,","poem":1},{"text":"niliteka nyara hazina zao,","poem":2},{"text":"kama yeye aliye shujaa","poem":1},{"text":"niliwatiisha wafalme wao.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kama mtu atiavyo mkono kwenye kiota,","poem":1},{"text":"ndivyo mkono wangu ulivyochukua utajiri wa mataifa;","poem":2},{"text":"kama watu wakusanyavyo mayai yaliyoachwa,","poem":1},{"text":"ndivyo nilivyokusanya nchi zote;","poem":2},{"text":"wala hakuna hata mmoja aliyepiga bawa","poem":1},{"text":"au kufungua kinywa chake kutoa mlio.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Je, shoka laweza kujigamba kuwa na nguvu","poem":1},{"text":"kuliko yule anayelitumia,","poem":2},{"text":"au msumeno kujisifu","poem":1},{"text":"dhidi ya yule anayeutumia?","poem":2},{"text":"Ni kana kwamba fimbo ingeweza kumwinua yeye aichukuaye,","poem":1},{"text":"au mkongojo ungemwinua mwenye kuutumia!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa hiyo Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":1},{"text":"atatuma ugonjwa wa kudhoofisha","poem":2},{"lineBreak":true},{"text":"kwa mashujaa wake wanene,","poem":2},{"text":"katika fahari yake moto utawaka","poem":1},{"text":"kama mwali wa moto.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nuru ya Israeli itakuwa moto,","poem":1},{"text":"Aliye Mtakatifu wao mwali wa moto;","poem":2},{"text":"katika siku moja utaunguza na kuteketeza miiba","poem":1},{"text":"na michongoma yake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Fahari ya misitu yake na mashamba yenye rutuba","poem":1},{"text":"utateketeza kabisa,","poem":2},{"lineBreak":true},{"text":"kama vile mtu mgonjwa adhoofikavyo.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Nayo miti inayobaki katika misitu yake itakuwa michache sana","poem":1},{"text":"hata mtoto mdogo angeweza kuihesabu.","poem":2}]},{"type":"heading","content":["Mabaki ya Israeli"]},{"type":"verse","number":20,"content":[{"text":"Katika siku ile, mabaki ya Israeli,","poem":1},{"text":"walionusurika wa nyumba ya Yakobo,","poem":2},{"text":"hawatamtegemea tena yeye aliyewapiga,","poem":1},{"text":"lakini watamtegemea kwa kweli","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mabaki watarudi","poem":1},{"noteId":15},{"text":", mabaki wa Yakobo","poem":1},{"text":"watamrudia Mungu Mwenye Nguvu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Ingawa watu wako, ee Israeli,","poem":1},{"text":"ni wengi kama mchanga wa pwani,","poem":2},{"lineBreak":true},{"text":"ni mabaki yao tu watakaorudi.","poem":2},{"text":"Maangamizi yamekwisha amriwa,","poem":1},{"text":"ni mengi tena ni haki.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni, atatekeleza","poem":1},{"text":"maangamizi yaliyoamriwa juu ya nchi yote.","poem":2}]},{"type":"verse","number":24,"content":["Kwa hiyo, hili ndilo asemalo Mwenyezi Mungu, Mungu wa majeshi ya mbinguni:",{"text":"“Enyi watu wangu mnaoishi Sayuni,","poem":1},{"text":"msiwaogope Waashuru,","poem":2},{"text":"wanaowapiga ninyi kwa fimbo","poem":1},{"text":"na kuinua rungu dhidi yenu, kama Misri ilivyofanya.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bado kitambo kidogo sana hasira yangu dhidi yenu itakoma,","poem":1},{"text":"na ghadhabu yangu itaelekezwa kwenye maangamizi yao.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni atawachapa kwa mjeledi,","poem":1},{"text":"kama alivyowapiga Wamidiani katika mwamba wa Orebu,","poem":2},{"text":"naye atainua fimbo yake juu ya maji,","poem":1},{"text":"kama alivyofanya huko Misri.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Katika siku hiyo mzigo wao utainuliwa kutoka mabegani mwenu,","poem":1},{"text":"na nira yao kutoka shingoni mwenu;","poem":2},{"text":"nira itavunjwa","poem":1},{"text":"kwa sababu ya kupakwa mafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wanaingia Ayathi,","poem":1},{"text":"wanapita katikati ya Migroni,","poem":2},{"lineBreak":true},{"text":"wanahifadhi mahitaji huko Mikmashi.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wanavuka kivukoni, nao wanasema,","poem":1},{"text":"“Tutapiga kambi huko Geba usiku kucha.”","poem":2},{"text":"Rama inatetemeka;","poem":1},{"text":"Gibea ya Sauli inakimbia.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Piga kelele, ee Binti Galimu!","poem":1},{"text":"Sikiliza, ee Laisha!","poem":2},{"lineBreak":true},{"text":"Maskini Anathothi!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Madmena inakimbia;","poem":1},{"text":"watu wa Gebimu wanajificha.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Siku hii ya leo watasimama Nobu;","poem":1},{"text":"watatikisa ngumi zao","poem":2},{"text":"kwa mlima wa Binti Sayuni,","poem":1},{"text":"kwa kilima cha Yerusalemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Tazama, Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":1},{"text":"atayakata matawi kwa nguvu kuu.","poem":2},{"text":"Miti mirefu sana itaangushwa,","poem":1},{"text":"ile mirefu itashushwa chini.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Atakata vichaka vya msitu kwa shoka;","poem":1},{"text":"Lebanoni itaanguka mbele zake yeye Mwenye Nguvu.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Kiebrania ni Shear-Yashubu; pia 10:22.","reference":{"chapter":10,"verse":21}}]},"thisChapterLink":"/api/swh_onmm/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}