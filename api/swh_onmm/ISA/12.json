{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["Kushukuru na kusifu"]},{"type":"verse","number":1,"content":["Katika siku ile utasema:",{"text":"“Nitakusifu wewe, Ee Mwenyezi Mungu.","poem":1},{"text":"Ingawa ulinikasirikia,","poem":2},{"text":"hasira yako imegeukia mbali","poem":1},{"text":"nawe umenifariji.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hakika Mungu ni wokovu wangu;","poem":1},{"text":"nitamtumaini wala sitaogopa.","poem":2},{"text":"Mwenyezi Mungu, Mwenyezi Mungu,","poem":1},{"text":"ni nguvu zangu na wimbo wangu;","poem":2},{"lineBreak":true},{"text":"amekuwa wokovu wangu.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa furaha mtachota maji","poem":1},{"text":"kutoka visima vya wokovu.","poem":2}]},{"type":"verse","number":4,"content":["Katika siku hiyo mtasema:",{"text":"“Mshukuruni Mwenyezi Mungu, mliitie jina lake;","poem":1},{"text":"julisheni miongoni mwa mataifa yale aliyoyafanya,","poem":2},{"lineBreak":true},{"text":"tangazeni kuwa jina lake limetukuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwimbieni Mwenyezi Mungu, kwa kuwa ametenda mambo makuu,","poem":1},{"text":"hili na lijulikane duniani kote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pazeni sauti mwimbe kwa furaha, watu wa Sayuni,","poem":1},{"text":"kwa maana mkuu ni yeye Aliye Mtakatifu wa Israeli miongoni mwenu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}