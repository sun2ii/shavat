{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["Unabii dhidi ya Babeli"]},{"type":"verse","number":1,"content":["Neno la unabii kuhusu Babeli ambalo Isaya mwana wa Amozi aliliona:"]},{"type":"verse","number":2,"content":[{"text":"Twekeni bendera juu ya mlima usio na kitu,","poem":1},{"text":"wapazieni sauti,","poem":2},{"text":"wapungieni mkono waingie","poem":1},{"text":"katika malango ya wenye heshima.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nimewaamuru watakatifu wangu;","poem":1},{"text":"nimewaita mashujaa wangu waitimize hasira yangu:","poem":2},{"lineBreak":true},{"text":"wale wanaoshangilia ushindi wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Sikilizeni kelele juu ya milima,","poem":1},{"text":"kama ile ya umati mkubwa wa watu!","poem":2},{"text":"Sikilizeni, makelele katika falme,","poem":1},{"text":"kama mataifa yanayokusanyika pamoja!","poem":2},{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni anakusanya","poem":1},{"text":"jeshi kwa ajili ya vita.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wanakuja kutoka nchi za mbali sana,","poem":1},{"text":"kutoka miisho ya mbingu,","poem":2},{"text":"Mwenyezi Mungu na silaha za ghadhabu yake,","poem":1},{"text":"kuangamiza nchi yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ombolezeni, kwa maana siku ya Mwenyezi Mungu i karibu,","poem":1},{"text":"itakuja kama uharibifu kutoka kwa Mwenyezi","poem":2},{"noteId":17},{"text":".","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa sababu ya hili, mikono yote italegea,","poem":1},{"text":"moyo wa kila mtu utayeyuka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hofu itawakamata,","poem":1},{"text":"uchungu na maumivu makali yatawashika,","poem":2},{"text":"watagaagaa kama mwanamke aliye na uchungu wa kuzaa.","poem":1},{"lineBreak":true},{"text":"Watatazamana kwa hofu kila mtu na mwenzake,","poem":1},{"text":"nyuso zao zikiwaka kama moto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Tazameni, siku ya Mwenyezi Mungu inakuja,","poem":1},{"text":"siku katili, yenye ghadhabu na hasira kali,","poem":2},{"text":"kuifanya nchi kuwa ukiwa,","poem":1},{"text":"na kuwaangamiza wenye dhambi waliomo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nyota za mbinguni na makundi ya nyota","poem":1},{"text":"havitatoa mwanga wake.","poem":2},{"text":"Jua linalochomoza litatiwa giza","poem":1},{"text":"na mwezi hautatoa nuru yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nitauadhibu ulimwengu kwa ajili ya uovu wake,","poem":1},{"text":"waovu kwa ajili ya dhambi zao.","poem":2},{"text":"Nitakomesha majivuno ya wenye kiburi,","poem":1},{"text":"na nitakishusha kiburi cha watu wakatili.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitawafanya wanadamu kuwa adimu kuliko dhahabu safi,","poem":1},{"text":"watakuwa wachache sana kuliko dhahabu ya Ofiri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa hiyo nitazifanya mbingu zitetemeke,","poem":1},{"text":"nayo dunia itatikisika kutoka mahali pake","poem":2},{"text":"katika ghadhabu ya Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni,","poem":2},{"lineBreak":true},{"text":"katika siku ya hasira yake iwakayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kama paa awindwaye,","poem":1},{"text":"kama kondoo wasio na mchungaji,","poem":2},{"text":"kila mmoja atarudi kwa watu wake mwenyewe,","poem":1},{"text":"kila mmoja atakimbilia nchi yake ya kuzaliwa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yeyote atakayetekwa atapasuliwa tumbo,","poem":1},{"text":"wote watakaokamatwa watauawa kwa upanga.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Watoto wao wachanga watavunjwa vipande vipande","poem":1},{"text":"mbele ya macho yao;","poem":2},{"text":"nyumba zao zitatekwa,","poem":1},{"text":"na wake zao watanajisiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Tazama, nitawachochea Wamedi dhidi yao,","poem":1},{"text":"ambao hawajali fedha","poem":2},{"lineBreak":true},{"text":"wala hawafurahii dhahabu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mishale yao itawaangusha vijana,","poem":1},{"text":"hawatakuwa na huruma kwa watoto wachanga","poem":2},{"lineBreak":true},{"text":"wala hawataangalia watoto kwa huruma.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Babeli, johari ya falme,","poem":1},{"text":"utukufu wa kiburi cha Wababeli","poem":2},{"noteId":18},{"text":",","poem":2},{"text":"utaangushwa na Mungu","poem":1},{"text":"kama Sodoma na Gomora.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hautakaliwa na watu kamwe,","poem":1},{"text":"wala watu hawataishi humo kwa vizazi vyote.","poem":2},{"text":"Hakuna Mwarabu atakayepiga hema lake huko,","poem":1},{"text":"hakuna mchungaji atakayepumzisha makundi yake huko.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Lakini viumbe wa jangwani watalala huko,","poem":1},{"text":"mbweha watajaza nyumba zake,","poem":2},{"text":"bundi wataishi humo","poem":1},{"text":"nao mbuzi-mwitu watarukaruka humo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Fisi watalia ndani ya ngome zake,","poem":1},{"text":"mbweha ndani ya majumba yake ya kifahari.","poem":2},{"text":"Wakati wake umewadia,","poem":1},{"text":"na siku zake hazitaongezwa.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"Mwenyezi hapa ina maana ya Shaddai kwa Kiebrania.","reference":{"chapter":13,"verse":6}},{"noteId":18,"caller":"+","text":"yaani Wakaldayo","reference":{"chapter":13,"verse":19}}]},"thisChapterLink":"/api/swh_onmm/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}