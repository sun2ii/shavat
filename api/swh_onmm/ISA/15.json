{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["Unabii dhidi ya Moabu"]},{"type":"verse","number":1,"content":["Neno la unabii kuhusu Moabu:",{"text":"Ari iliyo Moabu imeangamizwa:","poem":1},{"text":"imeharibiwa kwa usiku mmoja!","poem":2},{"text":"Kiri iliyo Moabu imeangamizwa,","poem":1},{"text":"imeharibiwa kwa usiku mmoja!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Diboni anakwea hadi kwenye hekalu lake,","poem":1},{"text":"hadi mahali pake pa juu pa kuabudia ili walie,","poem":2},{"lineBreak":true},{"text":"Moabu anaombolezea Nebo na Medeba.","poem":2},{"text":"Kila kichwa kimenyolewa","poem":1},{"text":"na kila ndevu limeondolewa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wamevaa magunia barabarani;","poem":1},{"text":"juu ya mapaa na kwenye viwanja","poem":2},{"text":"wote wanaomboleza,","poem":1},{"text":"wakilala kifudifudi na kulia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Heshboni na Eleale wanalia,","poem":1},{"text":"sauti zao zinasikika hadi Yahazi.","poem":2},{"text":"Kwa hiyo watu wenye silaha wa Moabu wanapiga kelele,","poem":1},{"text":"nayo mioyo yao imezimia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Moyo wangu unamlilia Moabu;","poem":1},{"text":"wakimbizi wake wanakimbilia Soari,","poem":2},{"lineBreak":true},{"text":"hadi Eglath-Shelishiya.","poem":2},{"text":"Wanapanda njia ya kwenda Luhithi,","poem":1},{"text":"wanaenda huku wanalia;","poem":2},{"text":"barabarani iendayo Horonaimu","poem":1},{"text":"wanaombolezea maangamizi yao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maji ya Nimrimu yamekauka","poem":1},{"text":"na majani yamenyauka;","poem":2},{"text":"mimea imekauka wala hakuna","poem":1},{"text":"kitu chochote kibichi kilichobaki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa hiyo mali waliyoipata na kujiwekea akiba","poem":1},{"text":"wamezichukua na kuvuka Bonde la Mierebi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwangwi wa kilio chao umefika hadi mpakani mwa Moabu,","poem":1},{"text":"kilio chao cha huzuni kimefika hadi Eglaimu,","poem":2},{"lineBreak":true},{"text":"maombolezo yao hadi Beer-Elimu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Maji ya Dimoni yamejaa damu,","poem":1},{"text":"lakini bado nitaleta pigo jingine juu ya Dimoni:","poem":2},{"text":"simba juu ya wakimbizi wa Moabu","poem":1},{"text":"na juu ya wale wanaobaki katika nchi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}