{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"heading","content":["Hali ya kukata tamaa ya Moabu"]},{"type":"verse","number":1,"content":[{"text":"Pelekeni wana-kondoo kama ushuru","poem":1},{"text":"kwa mtawala wa nchi,","poem":2},{"text":"Kutoka Sela, kupitia jangwani,","poem":1},{"text":"hadi mlima wa Binti Sayuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama ndege wanaopapatika","poem":1},{"text":"waliofukuzwa kutoka kiota,","poem":2},{"text":"ndivyo walivyo wanawake wa Moabu","poem":1},{"text":"kwenye vivuko vya Mto Arnoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Tupeni shauri,","poem":1},{"text":"toeni uamuzi.","poem":2},{"text":"Wakati wa adhuhuri,","poem":1},{"text":"fanyeni kivuli chenu kama usiku.","poem":2},{"text":"Waficheni watoro,","poem":1},{"text":"msisaliti wakimbizi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waacheni watoro wa Moabu wakae pamoja nanyi;","poem":1},{"text":"kuweni mahali pao pa salama ili kuepuka mwangamizi.”","poem":2},{"lineBreak":true},{"text":"Mtesi atafikia mwisho na maangamizi yatakoma,","poem":1},{"text":"aletaye vita atatoweka kutoka nchi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa upendo kiti cha utawala kitaimarishwa,","poem":1},{"text":"kwa uaminifu mtu ataketi juu yake,","poem":2},{"lineBreak":true},{"text":"yeye atokaye nyumba ya Daudi:","poem":2},{"text":"yeye ambaye katika kuhukumu hutafuta haki,","poem":1},{"text":"na huhimiza njia ya haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tumesikia juu ya kiburi cha Moabu:","poem":1},{"text":"kiburi chake cha kujivuna na udanganyifu,","poem":2},{"text":"kiburi chake na ufidhuli wake,","poem":1},{"text":"lakini majivuno yake si kitu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa hiyo Wamoabu wanaomboleza,","poem":1},{"text":"wanaiombolezea Moabu kwa pamoja.","poem":2},{"text":"Wanaomboleza na kuhuzunika","poem":1},{"text":"kwa ajili ya watu wa Kir-Haresethi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mashamba ya Heshboni yananyauka,","poem":1},{"text":"pia na mizabibu ya Sibma.","poem":2},{"text":"Watawala wa mataifa","poem":1},{"text":"wamekanyaga mizabibu iliyo mizuri sana,","poem":2},{"text":"ambayo ilipata kufika Yazeri","poem":1},{"text":"na kuenea kuelekea jangwani.","poem":2},{"text":"Machipukizi yake yalienea","poem":1},{"text":"yakafika hadi baharini.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hivyo ninalia kama Yazeri aliavyo,","poem":1},{"text":"kwa ajili ya mizabibu ya Sibma.","poem":2},{"text":"Ee Heshboni, ee Eleale,","poem":1},{"text":"ninakulowesha kwa machozi!","poem":2},{"text":"Shangwe za furaha kwa ajili ya tunda lako lililoiva","poem":1},{"text":"na kwa ajili ya mavuno zimekomeshwa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Furaha na shangwe zimeondolewa","poem":1},{"text":"kutoka mashamba ya matunda;","poem":2},{"text":"hakuna yeyote aimbaye wala apazaye sauti","poem":1},{"text":"katika mashamba ya mizabibu;","poem":2},{"text":"hakuna yeyote akanyagaye zabibu shinikizoni,","poem":1},{"text":"kwa kuwa nimekomesha makelele.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Moyo wangu unaomboleza kwa ajili ya Moabu kama kinubi,","poem":1},{"text":"nafsi yangu yote kwa ajili ya Kir-Haresethi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Moabu anapojitokeza mahali pake pa juu pa kuabudia,","poem":1},{"text":"anajichosha mwenyewe tu;","poem":2},{"text":"anapoenda mahali pake pa ibada za sanamu ili kuomba,","poem":1},{"text":"haitamfaidi lolote.","poem":2}]},{"type":"verse","number":13,"content":["Hili ndilo neno ambalo Mwenyezi Mungu ameshasema kuhusu Moabu."]},{"type":"verse","number":14,"content":["Lakini sasa Mwenyezi Mungu anasema: “Katika miaka mitatu, kama vile mtumishi aliyefungwa na mkataba angeihesabu, fahari ya Moabu na watu wake wengi watadharauliwa, nao walionusurika watakuwa wachache sana, tena wanyonge.”"]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}