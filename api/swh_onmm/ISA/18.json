{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["Unabii dhidi ya Kushi"]},{"type":"verse","number":1,"content":[{"text":"Ole kwa nchi ya mvumo wa mabawa","poem":1},{"noteId":20},{"text":",","poem":1},{"text":"kando ya mito ya Kushi,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"iwapelekayo wajumbe wake kupitia bahari","poem":1},{"text":"kwa mashua za mafunjo juu ya maji.","poem":2},{"lineBreak":true},{"text":"Nendeni, wajumbe wepesi,","poem":1},{"text":"kwa taifa la watu warefu wenye ngozi nyororo,","poem":2},{"lineBreak":true},{"text":"kwa taifa linaloogopwa mbali na karibu,","poem":2},{"text":"taifa gomvi lenye lugha ngeni,","poem":1},{"text":"ambalo nchi yao imegawanywa kwa mito.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Enyi mataifa yote ya ulimwengu,","poem":1},{"text":"ninyi mnaoishi duniani","poem":2},{"text":"wakati bendera itakapoinuliwa milimani,","poem":1},{"text":"mtaiona,","poem":2},{"text":"nayo tarumbeta itakapolia,","poem":1},{"text":"mtaisikia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hili ndilo Mwenyezi Mungu aliloniambia:","poem":1},{"text":"“Nitatulia kimya na kutazama","poem":2},{"lineBreak":true},{"text":"kutoka maskani yangu,","poem":2},{"text":"kama joto linalometameta katika mwanga wa jua,","poem":1},{"text":"kama wingu la umande","poem":2},{"lineBreak":true},{"text":"katika joto la wakati wa mavuno.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa maana, kabla ya mavuno,","poem":1},{"text":"wakati wa kuchanua ukishapita","poem":2},{"lineBreak":true},{"text":"na maua yakawa zabibu zinazoiva,","poem":2},{"text":"atayakata machipukizi kwa mundu wa kupogolea matawi,","poem":1},{"text":"naye atakata na kuyaondoa matawi yaliyopanuka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yote yataachwa kwa ajili ya ndege wawindao wa mlimani","poem":1},{"text":"na wanyama pori,","poem":2},{"text":"ndege watajilisha juu yake wakati wote wa kiangazi,","poem":1},{"text":"nao wanyama pori wakati wote wa masika.","poem":2}]},{"type":"verse","number":7,"content":["Wakati huo matoleo yataletwa kwa Mwenyezi Mungu, Mungu wa majeshi ya mbinguni",{"text":"kutoka kwa taifa la watu warefu wenye ngozi nyororo,","poem":1},{"text":"kutoka kwa taifa linaloogopwa mbali na karibu,","poem":2},{"text":"kutoka taifa gomvi lenye lugha ngeni,","poem":1},{"text":"ambalo nchi yao imegawanywa kwa mito,","poem":2},"matoleo yataletwa katika Mlima Sayuni, mahali pa Jina la Mwenyezi Mungu, Mungu wa majeshi ya mbinguni."]}],"footnotes":[{"noteId":20,"caller":"+","text":"au wa nzige","reference":{"chapter":18,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}