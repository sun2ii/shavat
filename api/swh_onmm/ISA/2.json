{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["Mlima wa Mwenyezi Mungu"]},{"type":"verse","number":1,"content":["Hili ndilo aliloliona Isaya mwana wa Amozi kuhusu Yuda na Yerusalemu:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["Katika siku za mwisho",{"text":"mlima wa Hekalu la Mwenyezi Mungu utaimarishwa","poem":1},{"text":"kama mlima mkuu miongoni mwa milima yote,","poem":2},{"text":"utainuliwa juu ya vilima,","poem":1},{"text":"na mataifa yote yatamiminika huko.","poem":2}]},{"type":"verse","number":3,"content":["Mataifa mengi yatakuja na kusema,",{"text":"“Njooni, twendeni kwenye mlima wa Mwenyezi Mungu,","poem":1},{"text":"kwenye nyumba ya Mungu wa Yakobo.","poem":2},{"text":"Atatufundisha njia zake,","poem":1},{"text":"ili tuweze kuenenda katika mapito yake.”","poem":2},{"text":"Torati itatoka Sayuni,","poem":1},{"text":"neno la Mwenyezi Mungu litatoka Yerusalemu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atahukumu kati ya mataifa","poem":1},{"text":"na ataamua migogoro ya mataifa mengi.","poem":2},{"text":"Watafua panga zao ziwe majembe,","poem":1},{"text":"na mikuki yao kuwa miundu ya kukata matawi.","poem":2},{"text":"Taifa halitainua upanga dhidi ya taifa jingine,","poem":1},{"text":"wala hawatajifunza vita tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Njooni, enyi nyumba ya Yakobo,","poem":1},{"text":"tutembeeni katika nuru ya Mwenyezi Mungu.","poem":2}]},{"type":"heading","content":["Siku ya Mwenyezi Mungu"]},{"type":"verse","number":6,"content":[{"text":"Mwenyezi Mungu umewatelekeza watu wako,","poem":1},{"text":"nyumba ya Yakobo.","poem":2},{"text":"Wamejaa ushirikina unaotoka Mashariki,","poem":1},{"text":"wanapiga ramli kama Wafilisti","poem":2},{"lineBreak":true},{"text":"na wanashikana mikono na wapagani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nchi yao imejaa fedha na dhahabu,","poem":1},{"text":"hakuna mwisho wa hazina zao.","poem":2},{"text":"Nchi yao imejaa farasi,","poem":1},{"text":"hakuna mwisho wa magari yao ya vita.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nchi yao imejaa sanamu;","poem":1},{"text":"wanasujudia kazi za mikono yao,","poem":2},{"lineBreak":true},{"text":"vitu vile vidole vyao vimevitengeneza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa hiyo mwanadamu atashushwa","poem":1},{"text":"na binadamu atanyenyekezwa:","poem":2},{"lineBreak":true},{"text":"usiwasamehe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ingieni kwenye miamba,","poem":1},{"text":"jificheni ardhini","poem":2},{"text":"kutokana na utisho wa Mwenyezi Mungu","poem":1},{"text":"na utukufu wa enzi yake!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Macho ya mtu mwenye majivuno yatanyenyekezwa","poem":1},{"text":"na kiburi cha wanadamu kitashushwa,","poem":2},{"text":"Mwenyezi Mungu peke yake ndiye atakayetukuzwa siku hiyo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni anayo siku aliyoiweka akiba","poem":1},{"text":"kwa wote wenye kujivuna na wenye kiburi,","poem":2},{"lineBreak":true},{"text":"kwa wote wanaojikweza","poem":2},{"lineBreak":true},{"text":"(nao watanyenyekezwa),","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kwa mierezi yote ya Lebanoni iliyo mirefu sana,","poem":1},{"text":"na mialoni yote ya Bashani,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kwa milima yote mirefu","poem":1},{"text":"na vilima vyote vilivyoinuka,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"kwa kila mnara ulio mrefu sana","poem":1},{"text":"na kila ukuta wenye ngome,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kwa kila meli ya biashara","poem":1},{"noteId":1},{"text":",","poem":1},{"text":"na kila mashua ya kifahari.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Majivuno ya mwanadamu yatashushwa,","poem":1},{"text":"na kiburi cha wanadamu kitanyenyekezwa,","poem":2},{"text":"Mwenyezi Mungu peke yake ndiye atatukuzwa siku hiyo,","poem":1}]},{"type":"verse","number":18,"content":[{"text":"nazo sanamu zitatoweka kabisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Watu watakimbilia kwenye mapango ndani ya miamba,","poem":1},{"text":"na kwenye mahandaki ardhini","poem":2},{"text":"kutokana na utisho wa Mwenyezi Mungu","poem":1},{"text":"na utukufu wa enzi yake,","poem":2},{"lineBreak":true},{"text":"ainukapo kuitikisa dunia.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Siku ile, watu watawatupia","poem":1},{"text":"panya na popo","poem":2},{"text":"sanamu zao za fedha na za dhahabu,","poem":1},{"text":"walizozitengeneza ili waziabudu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Watakimbilia kwenye mapango miambani","poem":1},{"text":"na kwenye nyufa za miamba","poem":2},{"text":"kutokana na utisho wa Mwenyezi Mungu","poem":1},{"text":"na utukufu wa enzi yake,","poem":2},{"lineBreak":true},{"text":"ainukapo kuitikisa dunia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Acheni kumtumainia mwanadamu,","poem":1},{"text":"ambaye hana kitu ila pumzi katika pua zake.","poem":2},{"text":"Yeye ana thamani gani?","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"au ya Tarshishi (taz. 1 Wafalme 10:22; 22:48; 2 Nyakati 9:21; 20:36; Isaya 60:9).","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/swh_onmm/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}