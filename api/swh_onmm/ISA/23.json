{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["Unabii kuhusu Tiro"]},{"type":"verse","number":1,"content":["Neno la unabii kuhusu Tiro:",{"text":"Ombolezeni, enyi meli za Tarshishi!","poem":1},{"text":"Kwa kuwa Tiro imeangamizwa,","poem":2},{"lineBreak":true},{"text":"imeachwa bila nyumba wala bandari.","poem":2},{"text":"Kuanzia nchi ya Kitimu","poem":1},{"noteId":23},{"text":"neno limewajia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nyamazeni kimya, enyi watu wa kisiwani,","poem":1},{"text":"pia ninyi wafanyabiashara wa Sidoni,","poem":2},{"lineBreak":true},{"text":"ambao mabaharia wamewatajirisha.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwenye maji makuu","poem":1},{"text":"nafaka za Shihori zilikuja;","poem":2},{"text":"mavuno ya Mto Naili yalikuwa mapato ya Tiro,","poem":1},{"text":"naye akawa soko la mataifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Uaibishwe ee Sidoni, nawe ee ngome la bahari,","poem":1},{"text":"kwa kuwa bahari imesema:","poem":2},{"text":"“Sijapata kuwa na uchungu wa kuzaa wala sijapata kuzaa,","poem":1},{"text":"wala sijapata kulea wana wala kutunza binti.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Habari ifikapo Misri,","poem":1},{"text":"watakuwa katika maumivu makuu kwa ajili ya taarifa kutoka Tiro.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Vukeni hadi Tarshishi,","poem":1},{"text":"ombolezeni, enyi watu wa kisiwani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je, huu ndio mji wenu uliojaa sherehe,","poem":1},{"text":"mji wa zamani, zamani kabisa","poem":2},{"text":"ambao miguu yake imeuchukua","poem":1},{"text":"kufanya makao nchi za mbali sana?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ni nani amepanga hili dhidi ya Tiro,","poem":1},{"text":"mji utoao mataji,","poem":2},{"text":"ambao wafanyabiashara wake ni wana wa mfalme","poem":1},{"text":"na wachuuzi wake ni watu mashuhuri wa dunia?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni ndiye alipanga jambo hili,","poem":1},{"text":"ili kukishusha kiburi cha utukufu wote","poem":2},{"text":"na kuwanyenyekeza wale wote","poem":1},{"text":"ambao ni mashuhuri duniani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ee Binti Tarshishi,","poem":1},{"text":"pita katika nchi yako kama vile Mto Naili","poem":2},{"lineBreak":true},{"text":"kwa kuwa huna tena bandari.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu amenyoosha mkono wake juu ya bahari","poem":1},{"text":"na kuzifanya falme zake zitetemeke.","poem":2},{"text":"Ametoa amri kuhusu Kanaani","poem":1},{"text":"kwamba ngome zake ziangamizwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Alisema, “Usizidi kufurahi,","poem":1},{"text":"ee Bikira Binti Sidoni, sasa umepondwa!","poem":2},{"lineBreak":true},{"text":"“Simama, vuka uende Kitimu;","poem":1},{"text":"hata huko hutapata pumziko.”","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tazama katika nchi ya Wakaldayo,","poem":1},{"text":"watu hawa ambao sasa hawaonekani kama wapo!","poem":2},{"text":"Waashuru wameifanya nchi hiyo","poem":1},{"text":"kuwa mahali pa viumbe wa jangwani.","poem":2},{"text":"Wamesimamisha minara yao ya kuuzingira,","poem":1},{"text":"wameziteka ngome zake na kuziacha tupu","poem":2},{"lineBreak":true},{"text":"na kuufanya kuwa magofu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ombolezeni, enyi meli za Tarshishi;","poem":1},{"text":"ngome yenu imeangamizwa!","poem":2}]},{"type":"verse","number":15,"content":["Wakati huo Tiro utasahauliwa kwa miaka sabini, muda wa maisha ya mfalme. Lakini mwisho wa miaka hiyo sabini, itakuwa kwa Tiro kama ilivyo katika wimbo wa kahaba:"]},{"type":"verse","number":16,"content":[{"text":"“Twaa kinubi, tembea mjini kote,","poem":1},{"text":"ewe kahaba uliyesahauliwa;","poem":2},{"text":"piga kinubi vizuri, imba nyimbo nyingi,","poem":1},{"text":"ili upate kukumbukwa.”","poem":2}]},{"type":"verse","number":17,"content":["Mwishoni mwa miaka sabini, Mwenyezi Mungu atatembelea Tiro. Naye Tiro atarudia ajira yake ya ukahaba, na atafanya biashara yake na falme zote duniani."]},{"type":"verse","number":18,"content":["Lakini faida na mapato yake yatawekwa wakfu kwa Mwenyezi Mungu; hayatahifadhiwa wala kufichwa. Faida zake zitaenda kwa wale wanaoishi mbele za Mwenyezi Mungu kwa ajili ya chakula tele na mavazi mazuri."]}],"footnotes":[{"noteId":23,"caller":"+","text":"yaani Kipro, kisiwa katika Bahari ya Mediterania","reference":{"chapter":23,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}