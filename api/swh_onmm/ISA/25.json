{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["Sifa kwa Mwenyezi Mungu"]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, wewe ni Mungu wangu,","poem":1},{"text":"nitakutukuza na kulisifu jina lako,","poem":2},{"text":"kwa maana katika ukamilifu wa uaminifu","poem":1},{"text":"umetenda mambo ya ajabu,","poem":2},{"lineBreak":true},{"text":"mambo yaliyokusudiwa tangu zamani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umeufanya mji kuwa lundo la kifusi,","poem":1},{"text":"mji wenye ngome kuwa magofu,","poem":2},{"text":"ngome imara ya wageni kuwa si mji tena,","poem":1},{"text":"wala hautajengwa tena kamwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa hiyo mataifa yenye nguvu yatakuheshimu,","poem":1},{"text":"miji ya mataifa katili itakuogopa wewe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Umekuwa kimbilio la watu maskini,","poem":1},{"text":"kimbilio la mhitaji katika taabu yake,","poem":2},{"text":"hifadhi wakati wa dhoruba","poem":1},{"text":"na kivuli wakati wa hari.","poem":2},{"text":"Kwa maana pumzi ya wakatili","poem":1},{"text":"ni kama dhoruba ipigayo ukuta","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"na kama joto la jangwani.","poem":2},{"text":"Wewe wanyamazisha kelele ya wageni;","poem":1},{"text":"kama vile hari ipunguzwavyo na kivuli cha wingu,","poem":2},{"lineBreak":true},{"text":"ndivyo wimbo wa wakatili unyamazishwavyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Juu ya mlima huu Mwenyezi Mungu, Mungu wa majeshi ya mbinguni ataandaa","poem":1},{"text":"karamu ya vinono kwa mataifa yote,","poem":2},{"text":"karamu ya mvinyo wa zamani,","poem":1},{"text":"nyama nzuri sana na divai zilizo bora sana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Juu ya mlima huu ataharibu","poem":1},{"text":"sitara ihifadhiyo mataifa yote,","poem":2},{"text":"kile kifuniko kifunikacho mataifa yote,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"yeye atameza mauti milele.","poem":2},{"text":"Bwana Mungu Mwenyezi atafuta machozi katika nyuso zote;","poem":1},{"text":"ataondoa aibu ya watu wake duniani kote.","poem":2},{"text":"Mwenyezi Mungu amesema hili.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Katika siku ile watasema,","poem":1},{"text":"“Hakika huyu ndiye Mungu wetu;","poem":2},{"lineBreak":true},{"text":"tulimtumaini, naye akatuokoa.","poem":2},{"text":"Huyu ndiye Mwenyezi Mungu, tuliyemtumaini;","poem":1},{"text":"sisi tushangilie na kufurahia katika wokovu wake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mkono wa Mwenyezi Mungu utatulia juu ya mlima huu,","poem":1},{"text":"bali Moabu atakanyagwa chini","poem":2},{"lineBreak":true},{"text":"kama majani makavu yakanyagwavyo kwenye shimo la mbolea.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Watakunjua mikono yao katikati yake,","poem":1},{"text":"kama vile mwogeleaji akunjuavyo mikono yake ili aogelee.","poem":2},{"text":"Mungu atashusha kiburi chao","poem":1},{"text":"licha ya ujanja wa mikono yao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Atabomoa kuta ndefu za ngome yako","poem":1},{"text":"na kuziangusha chini,","poem":2},{"text":"atazishusha chini ardhini,","poem":1},{"text":"hadi mavumbini kabisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}