{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["Wimbo wa ushindi"]},{"type":"verse","number":1,"content":["Katika siku ile, wimbo huu utaimbwa katika nchi ya Yuda:",{"text":"Tuna mji ulio na nguvu,","poem":1},{"text":"Mungu huufanya wokovu","poem":2},{"lineBreak":true},{"text":"kuwa kuta zake na maboma yake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Fungua malango ili taifa lenye haki lipate kuingia,","poem":1},{"text":"taifa lidumishalo imani.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Utamlinda katika amani kamilifu","poem":1},{"text":"yeye ambaye moyo wake ni thabiti","poem":2},{"lineBreak":true},{"text":"kwa sababu anakutumaini wewe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mtumaini Mwenyezi Mungu milele,","poem":1},{"text":"kwa kuwa Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"ni Mwamba wa milele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Huwashusha wale wajikwezao,","poem":1},{"text":"huushusha chini mji wenye kiburi,","poem":2},{"text":"huushusha hadi ardhini","poem":1},{"text":"na kuutupa chini mavumbini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Miguu huukanyagia chini:","poem":1},{"text":"miguu ya hao waliodhulumiwa,","poem":2},{"lineBreak":true},{"text":"hatua za hao maskini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mapito ya wenye haki ni nyoofu.","poem":1},{"text":"Ewe uliye Mwenye Haki,","poem":2},{"lineBreak":true},{"text":"waisawazisha njia ya mtu mnyofu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Naam, Mwenyezi Mungu, tukienenda katika sheria zako,","poem":1},{"text":"twakungojea wewe,","poem":2},{"text":"jina lako na sifa zako","poem":1},{"text":"ndizo shauku za mioyo yetu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nafsi yangu yakutamani wakati wa usiku,","poem":1},{"text":"wakati wa asubuhi roho yangu yakuonea shauku.","poem":2},{"text":"Hukumu zako zinapokuja juu ya dunia,","poem":1},{"text":"watu wa ulimwengu hujifunza haki.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ingawa neema yaoneshwa kwa waovu,","poem":1},{"text":"hawajifunzi haki;","poem":2},{"text":"hata katika nchi ya unyofu huendelea kutenda mabaya","poem":1},{"text":"wala hawazingatii utukufu wa Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Mwenyezi Mungu, mkono wako umeinuliwa juu,","poem":1},{"text":"lakini hawauoni.","poem":2},{"text":"Wao na waone wivu wako kwa ajili ya watu wako tena waaibishwe,","poem":1},{"text":"moto uliowekwa akiba kwa ajili ya adui zako na uwateketeze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mwenyezi Mungu, unaamuru amani kwa ajili yetu,","poem":1},{"text":"yale yote tuliyoweza kuyakamilisha ni wewe uliyetenda kwa ajili yetu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wetu, mabwana wengine zaidi ya wewe wametutawala,","poem":1},{"text":"lakini jina lako pekee ndilo tunaloliheshimu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wao sasa wamekufa, wala hawako tena hai,","poem":1},{"text":"roho za waliokufa hazitarudi tena.","poem":2},{"text":"Uliwaadhibu na kuwaangamiza,","poem":1},{"text":"umefuta kumbukumbu lao lote.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Umeliongeza hilo taifa, Ee Mwenyezi Mungu,","poem":1},{"text":"umeliongeza hilo taifa.","poem":2},{"text":"Umejipatia utukufu kwa ajili yako mwenyewe,","poem":1},{"text":"umepanua mipaka yote ya nchi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mwenyezi Mungu, walikujia katika taabu yao,","poem":1},{"text":"wewe ulipowarudi,","poem":2},{"lineBreak":true},{"text":"waliweza kuomba kwa kunong’ona tu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kama mwanamke mwenye mimba aliyekaribia kuzaa","poem":1},{"text":"anavyogaagaa na kulia kwa ajili ya maumivu yake,","poem":2},{"lineBreak":true},{"text":"ndivyo tulivyokuwa mbele zako, Ee Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Tulikuwa na mimba, tuligaagaa kwa maumivu,","poem":1},{"text":"lakini tulizaa upepo.","poem":2},{"text":"Hatukuleta wokovu duniani,","poem":1},{"text":"hatujazaa watu katika ulimwengu huu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lakini wafu wenu wataishi,","poem":1},{"text":"nayo miili yao itafufuka.","poem":2},{"text":"Ninyi mnaokaa katika mavumbi,","poem":1},{"text":"amkeni mkashangilie kwa furaha.","poem":2},{"text":"Umande wenu ni kama umande wa asubuhi,","poem":1},{"text":"dunia itawazaa wafu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Nendeni, watu wangu, ingieni vyumbani mwenu","poem":1},{"text":"na mfunge milango nyuma yenu,","poem":2},{"text":"jificheni kwa kitambo kidogo","poem":1},{"text":"hadi ghadhabu yake ipite.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tazama, Mwenyezi Mungu anakuja kutoka makao yake","poem":1},{"text":"ili kuwaadhibu watu wa dunia kwa ajili ya dhambi zao.","poem":2},{"text":"Dunia itadhihirisha umwagaji damu juu yake,","poem":1},{"text":"wala haitaendelea kuwaficha watu wake waliouawa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}