{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["Wokovu kwa ajili ya Israeli"]},{"type":"verse","number":1,"content":["Katika siku ile,",{"text":"Mwenyezi Mungu ataadhibu kwa upanga wake,","poem":1},{"text":"upanga wake mkali, mkubwa na wenye nguvu;","poem":2},{"text":"ataadhibu Lewiathani","poem":1},{"noteId":24},{"text":"yule nyoka apitaye kwa mwendo laini,","poem":1},{"text":"Lewiathani yule nyoka mwenye kujipinda;","poem":2},{"text":"atamuua yule mnyama mkubwa wa baharini.","poem":1}]},{"type":"verse","number":2,"content":["Katika siku ile:",{"text":"“Imbeni kuhusu shamba la mizabibu lililozaa:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"Mimi, Mwenyezi Mungu, ninalitunza,","poem":2},{"lineBreak":true},{"text":"ninalinywesha maji mfululizo.","poem":2},{"text":"Ninalichunga usiku na mchana","poem":1},{"text":"ili mtu yeyote asije akalidhuru.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mimi sijakasirika.","poem":1},{"text":"Laiti michongoma na miiba ingenikabili!","poem":2},{"lineBreak":true},{"text":"Ningepambana dhidi yake katika vita,","poem":2},{"lineBreak":true},{"text":"ningeichoma moto yote.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Au niwaache waje kwangu kwa ajili ya kupata kimbilio,","poem":1},{"text":"wao na wafanye amani nami,","poem":2},{"lineBreak":true},{"text":"naam, wafanye amani nami.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Katika siku zijazo, Yakobo atatia mizizi,","poem":1},{"text":"Israeli atatoa chipukizi na kuchanua maua,","poem":2},{"lineBreak":true},{"text":"naye atajaza ulimwengu wote kwa matunda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Je, Mwenyezi Mungu amempiga","poem":1},{"text":"vile alivyowapiga wale waliompiga?","poem":2},{"text":"Je, yeye ameuawa","poem":1},{"text":"vile walivyouawa wale waliomuua yeye?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa vita na kwa kumfukuza unapingana naye:","poem":1},{"text":"kwa mshindo wake mkali anamfukuza,","poem":2},{"lineBreak":true},{"text":"kama siku ile uvumapo upepo wa mashariki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa hili, basi, hatia ya Yakobo itafanyiwa upatanisho,","poem":1},{"text":"nalo hili litakuwa matunda ya utimilizo wa kuondolewa kwa dhambi yake:","poem":2},{"text":"Wakati atayafanya mawe yote ya madhabahu","poem":1},{"text":"kuwa kama mawe ya chokaa yaliyopondwa vipande vipande,","poem":2},{"text":"hakuna nguzo za Ashera au madhabahu za kufukizia uvumba","poem":1},{"text":"zitakazobaki zimesimama.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mji wenye ngome umebaki ukiwa,","poem":1},{"text":"makazi yaliyotelekezwa, yaliyoachwa kama jangwa.","poem":2},{"text":"Huko ndama hulisha,","poem":1},{"text":"huko hujilaza,","poem":2},{"lineBreak":true},{"text":"wanakwanyua matawi yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wakati vijiti vyake vimekauka, huvunjwa","poem":1},{"text":"nao wanawake huja na kuwasha navyo moto.","poem":2},{"text":"Kwa kuwa hili ni taifa lisilo na ufahamu,","poem":1},{"text":"kwa hiyo yeye aliyewafanya hana huruma juu yao,","poem":2},{"lineBreak":true},{"text":"Muumba wao hawaoneshi fadhili.","poem":2}]},{"type":"verse","number":12,"content":["Katika siku ile Mwenyezi Mungu atapura kutoka matiririko ya Mto Frati hadi Kijito cha Misri, nanyi ee Waisraeli, mtakusanywa mmoja mmoja."]},{"type":"verse","number":13,"content":["Katika siku ile tarumbeta kubwa italia. Wale waliokuwa wakiangamia katika nchi ya Ashuru, nao wale waliokuwa uhamishoni katika nchi ya Misri watakuja na kumwabudu Mwenyezi Mungu katika mlima mtakatifu huko Yerusalemu."]}],"footnotes":[{"noteId":24,"caller":"+","text":"Lewiathani ni mnyama mkubwa wa baharini mwenye magamba anayefanana na joka kubwa, mwenye umbo la kutisha, asiyeweza kuvuliwa.","reference":{"chapter":27,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}