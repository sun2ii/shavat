{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["Ole wa Mji wa Daudi"]},{"type":"verse","number":1,"content":[{"text":"Ole wako, wewe Arieli, Arieli,","poem":1},{"text":"mji alimokaa Daudi!","poem":2},{"text":"Ongezeni mwaka kwa mwaka,","poem":1},{"text":"na mzunguko wa sikukuu zenu uendelee.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hata hivyo nitauzingira Arieli kwa jeshi,","poem":1},{"text":"utalia na kuomboleza,","poem":2},{"text":"utakuwa kwangu kama mahali","poem":1},{"text":"pa kuwashia moto madhabahuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nitapiga kambi pande zote dhidi yako,","poem":1},{"text":"nitakuzunguka kwa minara","poem":2},{"lineBreak":true},{"text":"na kujenga ngome yakukuzingira.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Utakaposhushwa, utanena kutoka ardhini,","poem":1},{"text":"utamumunya maneno yako kutoka mavumbini.","poem":2},{"text":"Sauti yako itatoka katika nchi kama vile ya mzimu,","poem":1},{"text":"utanong’ona maneno yako toka mavumbini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lakini adui zako wengi watakuwa kama vumbi laini;","poem":1},{"text":"makundi ya watu wakatili watakuwa","poem":2},{"lineBreak":true},{"text":"kama makapi yanayopeperushwa.","poem":2},{"text":"Naam, ghafula, mara moja,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni atakuja","poem":2},{"text":"na ngurumo, tetemeko la ardhi, na kwa sauti kuu,","poem":1},{"text":"atakuja na dhoruba, tufani na miali ya moto iteketezayo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kisha makundi ya mataifa yote yanayopigana dhidi ya Arieli,","poem":1},{"text":"yale yanayomshambulia yeye na ngome zake,","poem":2},{"lineBreak":true},{"text":"na kumzingira kwa jeshi,","poem":2},{"text":"watakuwa kama ilivyo ndoto,","poem":1},{"text":"kama maono wakati wa usiku:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"kama vile mtu aliye na njaa aotavyo kuwa anakula,","poem":1},{"text":"lakini huamka, bado njaa yake ingalipo,","poem":2},{"text":"kama vile mtu mwenye kiu aotavyo kuwa anakunywa maji,","poem":1},{"text":"lakini huamka akiwa anazimia, akiwa bado angali ana kiu.","poem":2},{"text":"Hivyo ndivyo itakavyokuwa kwa makundi yote ya mataifa","poem":1},{"text":"yanayopigana dhidi ya Mlima Sayuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Pigweni na butwaa na mshangae;","poem":1},{"text":"jifanyeni vipofu wenyewe na msione;","poem":2},{"text":"leweni, lakini si kwa mvinyo,","poem":1},{"text":"pepesukeni lakini si kwa kileo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mwenyezi Mungu amewaleteeni usingizi mzito:","poem":1},{"text":"Ameziba macho yenu ninyi manabii;","poem":2},{"lineBreak":true},{"text":"amefunika vichwa vyenu ninyi waonaji.","poem":2}]},{"type":"verse","number":11,"content":["Kwenu ninyi, maono haya yote si kitu ila maneno yaliyotiwa muhuri katika kitabu. Mkimpa mtu yeyote awezaye kusoma kitabu hiki, nanyi mkamwambia, “Tafadhali kisome,” yeye atajibu, “Mimi siwezi, kwa kuwa kimetiwa muhuri.”"]},{"type":"verse","number":12,"content":["Au mkimpa mtu yeyote kitabu hiki asiyeweza kusoma na kumwambia, “Tafadhali kisome,” atajibu, “Mimi sijui kusoma.”"]},{"type":"verse","number":13,"content":["Bwana asema:",{"text":"“Watu hawa hunikaribia kwa vinywa vyao","poem":1},{"text":"na kuniheshimu kwa midomo yao,","poem":2},{"lineBreak":true},{"text":"lakini mioyo yao iko mbali nami.","poem":2},{"text":"Ibada yao kwangu inatokana na maagizo","poem":1},{"text":"waliyofundishwa na wanadamu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa hiyo mara nyingine tena nitawashangaza watu hawa,","poem":1},{"text":"kwa ajabu juu ya ajabu.","poem":2},{"text":"Hekima ya wenye hekima itapotea,","poem":1},{"text":"nayo akili ya wenye akili itatoweka.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ole kwa wale wanaoenda kwenye vilindi virefu","poem":1},{"text":"kumficha Mwenyezi Mungu mipango yao,","poem":2},{"text":"wafanyao kazi zao gizani na kufikiri,","poem":1},{"text":"“Ni nani anayetuona? Ni nani atakayejua?”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mnapindua mambo juu chini,","poem":1},{"text":"kana kwamba mfinyanzi aweza kufikiriwa kuwa kama udongo wa mfinyanzi!","poem":2},{"text":"Je, kile kilichofinyangwa","poem":1},{"text":"chaweza kumwambia yule aliyekifinyanga,","poem":2},{"lineBreak":true},{"text":"“Wewe hukunifinyanga mimi”?","poem":2},{"text":"Je, chungu kinaweza kumwambia mfinyanzi,","poem":1},{"text":"“Wewe hujui chochote”?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kwa muda mfupi sana, je, Lebanoni haitageuzwa","poem":1},{"text":"kuwa shamba lenye rutuba,","poem":2},{"text":"na shamba lenye rutuba","poem":1},{"text":"liwe kama msitu?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Katika siku ile viziwi watasikia maneno ya kitabu,","poem":1},{"text":"na katika utusitusi na giza","poem":2},{"lineBreak":true},{"text":"macho ya kipofu yataona.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mara nyingine tena wanyenyekevu watafurahi katika Mwenyezi Mungu,","poem":1},{"text":"wahitaji watafurahi ndani yake Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wakatili watatoweka na wenye kudhihaki watatokomea,","poem":1},{"text":"nao wote wenye jicho la uovu watakatiliwa mbali,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"wale ambao kwa neno humfanya mtu kuwa mwenye hatia,","poem":1},{"text":"wamtegeao mtego mtetezi katika mahakama,","poem":2},{"text":"na kwa ushuhuda wa uongo humnyima haki","poem":1},{"text":"yeye asiye na hatia.","poem":2}]},{"type":"verse","number":22,"content":["Kwa hiyo hili ndilo Mwenyezi Mungu, aliyemkomboa Ibrahimu, analosema kwa nyumba ya Yakobo:",{"text":"“Yakobo hataaibishwa tena,","poem":1},{"text":"wala nyuso zao hazitabadilika sura tena.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Watakapoona watoto wao miongoni mwao,","poem":1},{"text":"kazi ya mikono yangu,","poem":2},{"text":"watalitakasa Jina langu takatifu;","poem":1},{"text":"wataukubali utakatifu wa yeye Aliye Mtakatifu wa Yakobo,","poem":2},{"lineBreak":true},{"text":"nao watamcha Mungu wa Israeli.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wale wanaopotoka rohoni watapata ufahamu,","poem":1},{"text":"nao wale wanaolalamika watayakubali mafundisho.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}