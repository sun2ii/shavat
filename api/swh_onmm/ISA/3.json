{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["Hukumu kwa Yerusalemu na Yuda"]},{"type":"verse","number":1,"content":[{"text":"Tazama sasa, Bwana,","poem":1},{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":2},{"text":"yu karibu kuwaondolea Yerusalemu na Yuda","poem":1},{"text":"upatikanaji wa mahitaji na misaada,","poem":2},{"text":"upatikanaji wote wa chakula na tegemeo lote la maji,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"shujaa na mtu wa vita,","poem":2},{"text":"mwamuzi na nabii,","poem":1},{"text":"mwaguzi na mzee,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"jemadari wa kikosi cha watu hamsini","poem":1},{"text":"na mtu mwenye cheo, mshauri,","poem":2},{"lineBreak":true},{"text":"fundi stadi na msihiri mjanja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nitawafanya wavulana wawe viongozi wao;","poem":1},{"text":"watoto ndio watakaowatawala.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Watu watadhulumiana:","poem":1},{"text":"mtu dhidi ya mtu, na jirani dhidi ya jirani yake.","poem":2},{"text":"Kijana atainuka dhidi ya mzee,","poem":1},{"text":"mtu mnyonge dhidi ya mtu mwenye heshima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mtu atamkamata mmoja wa ndugu zake","poem":1},{"text":"katika nyumba ya baba yake na kusema,","poem":2},{"lineBreak":true},{"text":"“Unalo joho, sasa uwe kiongozi wetu,","poem":2},{"lineBreak":true},{"text":"tawala lundo hili la magofu!”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lakini siku hiyo atapiga kelele akisema,","poem":1},{"text":"“Sina msaada.","poem":2},{"text":"Sina chakula wala mavazi katika nyumba yangu,","poem":1},{"text":"msinifanye niwe kiongozi wa watu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yerusalemu inapepesuka,","poem":1},{"text":"Yuda inaanguka;","poem":2},{"text":"maneno yao na matendo yao ni kinyume na Mwenyezi Mungu,","poem":1},{"text":"wakiudharau uwepo wake uliotukuka.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyuso zao zinavyoonekana zinashuhudia dhidi yao,","poem":1},{"text":"hujivunia dhambi yao kama Sodoma,","poem":2},{"lineBreak":true},{"text":"wala hawaifichi.","poem":2},{"text":"Ole wao!","poem":1},{"text":"Wamejiletea maafa juu yao wenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Waambie wanyofu itakuwa heri kwao,","poem":1},{"text":"kwa kuwa watafurahia tunda la matendo yao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ole kwa watu waovu! Maafa yapo juu yao!","poem":1},{"text":"Watalipwa kwa ajili ya yale mikono yao iliyotenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Vijana wanawatesa watu wangu,","poem":1},{"text":"wanawake wanawatawala.","poem":2},{"text":"Enyi watu wangu, viongozi wenu wanawapotosha,","poem":1},{"text":"wanawapoteza njia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwenyezi Mungu anachukua nafasi yake mahakamani,","poem":1},{"text":"anasimama kuhukumu watu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mwenyezi Mungu anaingia katika hukumu","poem":1},{"text":"dhidi ya wazee na viongozi wa watu wake:","poem":2},{"text":"“Ninyi ndio mlioharibu shamba langu la mizabibu,","poem":1},{"text":"mali iliyonyang’anywa maskini imo nyumbani mwenu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mnamaanisha nini kuwaponda watu wangu","poem":1},{"text":"na kuzisaga nyuso za maskini?”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu, Mungu wa majeshi ya mbinguni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mwenyezi Mungu asema,","poem":1},{"text":"“Wanawake wa Sayuni wana kiburi,","poem":2},{"text":"wanatembea na shingo ndefu,","poem":1},{"text":"wakikonyeza kwa macho yao,","poem":2},{"text":"wanatembea kwa hatua za madaha,","poem":1},{"text":"wakiwa na mapambo ya njuga kwenye vifundo vya miguu yao.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwa hiyo Bwana ataleta majipu kwenye vichwa vya wanawake wa Sayuni;","poem":1},{"text":"Mwenyezi Mungu atazifanya ngozi za vichwa vyao kuwa vipara.”","poem":2}]},{"type":"verse","number":18,"content":["Katika siku ile Bwana atawanyang’anya uzuri wao: bangili, tepe za kichwani, mikufu yenye alama za mwezi mwandamo,"]},{"type":"verse","number":19,"content":["vipuli, vikuku, shela,"]},{"type":"verse","number":20,"content":["vilemba, mikufu ya vifundo vya miguu, mshipi, chupa za manukato na hirizi,"]},{"type":"verse","number":21,"content":["pete zenye muhuri, pete za puani,"]},{"type":"verse","number":22,"content":["majoho mazuri, mitandio, mavazi, kifuko cha kutilia fedha,"]},{"type":"verse","number":23,"content":["vioo, mavazi ya kitani, taji na shali."]},{"type":"verse","number":24,"content":[{"text":"Badala ya harufu ya manukato kutakuwa na uvundo;","poem":1},{"text":"badala ya mishipi, ni kamba;","poem":2},{"text":"badala ya nywele zilizotengenezwa vizuri, ni upara;","poem":1},{"text":"badala ya mavazi mazuri, ni magunia;","poem":2},{"lineBreak":true},{"text":"badala ya uzuri, ni alama ya aibu kwa chuma cha moto.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wanaume wako watauawa kwa upanga,","poem":1},{"text":"nao mashujaa wako watauawa vitani.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Malango ya Sayuni yataomboleza na kulia,","poem":1},{"text":"ataketi mavumbini akiwa fukara.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}