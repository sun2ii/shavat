{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["Hukumu dhidi ya mataifa"]},{"type":"verse","number":1,"content":[{"text":"Njooni karibu, enyi mataifa, nanyi msikilize;","poem":1},{"text":"sikilizeni kwa makini,","poem":2},{"lineBreak":true},{"text":"enyi makabila ya watu!","poem":2},{"text":"Dunia na isikie, navyo vyote vilivyo ndani yake,","poem":1},{"text":"ulimwengu na vyote vinavyotoka ndani yake!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu ameyakasirikia mataifa yote;","poem":1},{"text":"ghadhabu yake ni juu ya majeshi yao yote.","poem":2},{"text":"Atawaangamiza kabisa,","poem":1},{"text":"atawatia mikononi mwa wachinjaji.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waliouawa watatupwa nje,","poem":1},{"text":"maiti zao zitatoa uvundo,","poem":2},{"lineBreak":true},{"text":"milima itatota kwa damu zao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nyota zote za mbinguni zitayeyuka","poem":1},{"text":"na mbingu itakunjwa kama kitabu,","poem":2},{"text":"jeshi lote la angani litaanguka","poem":1},{"text":"kama majani yaliyonyauka kwenye mzabibu,","poem":2},{"lineBreak":true},{"text":"kama tini iliyonyauka kwenye mtini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Upanga wangu umekunywa na kushiba huko mbinguni,","poem":1},{"text":"tazama, unashuka katika hukumu juu ya Edomu,","poem":2},{"text":"wale watu ambao nimeshawahukumu,","poem":1},{"text":"kuwaangamiza kabisa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Upanga wa Mwenyezi Mungu umeoga katika damu,","poem":1},{"text":"umefunikwa na mafuta ya nyama:","poem":2},{"text":"damu ya kondoo na mbuzi,","poem":1},{"text":"mafuta kutoka figo za kondoo dume.","poem":2},{"text":"Kwa maana Mwenyezi Mungu ana dhabihu huko Bosra,","poem":1},{"text":"na machinjo makuu huko Edomu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyati wataanguka pamoja nao,","poem":1},{"text":"ndama dume na mafahali wakubwa.","poem":2},{"text":"Nchi yao italowana kwa damu,","poem":1},{"text":"nayo mavumbi yataloa mafuta ya nyama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwa sababu Mwenyezi Mungu anayo siku ya kulipiza kisasi,","poem":1},{"text":"mwaka wa malipo,","poem":2},{"lineBreak":true},{"text":"siku ya kushindania shauri la Sayuni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vijito vya Edomu vitageuka kuwa lami,","poem":1},{"text":"mavumbi yake yatakuwa kiberiti kiunguzacho,","poem":2},{"lineBreak":true},{"text":"nchi yake itakuwa lami iwakayo!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Haitazimishwa usiku wala mchana,","poem":1},{"text":"moshi wake utapaa juu milele.","poem":2},{"text":"Kizazi hadi kizazi itakuwa ukiwa;","poem":1},{"text":"hakuna mtu yeyote atakayepita huko tena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bundi wa jangwani na bundi mwenye sauti nyembamba wataimiliki,","poem":1},{"text":"bundi wakubwa na kunguru wataweka viota humo.","poem":2},{"text":"Mungu atanyoosha juu ya Edomu","poem":1},{"text":"kamba ya kupimia ya machafuko matupu,","poem":2},{"lineBreak":true},{"text":"na timazi ya ukiwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watu wake wa kuheshimiwa hawatakuwa na chochote","poem":1},{"text":"kitakachoitwa ufalme huko,","poem":2},{"lineBreak":true},{"text":"nao wakuu wao wote watatoweka.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Miiba itaenea katika ngome za ndani,","poem":1},{"text":"viwawi na michongoma itaota","poem":2},{"lineBreak":true},{"text":"kwenye ngome zake.","poem":2},{"text":"Itakuwa maskani ya mbweha,","poem":1},{"text":"makao ya bundi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Viumbe vya jangwani vitakutana na fisi,","poem":1},{"text":"nao mbuzi-mwitu watalia wakiitana;","poem":2},{"text":"huko viumbe vya usiku vitastarehe pia","poem":1},{"text":"na kujitafutia mahali pa kupumzika.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Bundi wataweka viota huko na kutaga mayai,","poem":1},{"text":"atayaangua na kutunza makinda yake","poem":2},{"lineBreak":true},{"text":"chini ya uvuli wa mabawa yake;","poem":2},{"text":"pia huko vipanga watakusanyika,","poem":1},{"text":"kila mmoja na mwenzi wake.","poem":2}]},{"type":"verse","number":16,"content":["Angalieni katika kitabu cha Mwenyezi Mungu na msome:",{"text":"Hakuna hata mmoja katika hawa atakayekosekana,","poem":1},{"text":"hakuna hata mmoja atakayemkosa mwenzi wake.","poem":2},{"text":"Kwa kuwa ni kinywa chake Mungu kimeagiza,","poem":1},{"text":"na Roho wake Mtakatifu atawakusanya.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Huwagawia sehemu zao,","poem":1},{"text":"mkono wake huwagawanyia kwa kipimo.","poem":2},{"text":"Wataimiliki hata milele","poem":1},{"text":"na kuishi humo kizazi hadi kizazi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}