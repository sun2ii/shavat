{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["Israeli aliyechaguliwa"]},{"type":"verse","number":1,"content":[{"text":"“Lakini sasa sikiliza, ee Yakobo, mtumishi wangu,","poem":1},{"text":"Israeli, niliyemchagua.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hili ndilo asemalo Mwenyezi Mungu,","poem":1},{"text":"yeye aliyekuhuluku, aliyekuumba tumboni,","poem":2},{"lineBreak":true},{"text":"yeye atakayekusaidia:","poem":2},{"text":"Usiogope, ee Yakobo, mtumishi wangu,","poem":1},{"text":"Yeshuruni","poem":2},{"noteId":30},{"text":", niliyekuchagua.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa maana nitamimina maji juu ya nchi yenye kiu,","poem":1},{"text":"na vijito vya maji juu ya ardhi iliyokauka;","poem":2},{"text":"nitamimina Roho wangu Mtakatifu juu ya watoto wako,","poem":1},{"text":"nayo baraka yangu juu ya wazao wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nao watachipua kama nyasi katika shamba la majani,","poem":1},{"text":"kama mierezi kando ya vijito vya maji yanayotiririka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mmoja atasema, ‘Mimi ni wa Mwenyezi Mungu’;","poem":1},{"text":"mwingine atajiita kwa jina la Yakobo;","poem":2},{"text":"vilevile mwingine ataandika juu ya mkono wake,","poem":1},{"text":"‘Wa Mwenyezi Mungu,’","poem":2},{"lineBreak":true},{"text":"na kujiita kwa jina la Israeli.","poem":2}]},{"type":"heading","content":["Ni Mwenyezi Mungu, siyo sanamu"]},{"type":"verse","number":6,"content":[{"text":"“Hili ndilo asemalo Mwenyezi Mungu,","poem":1},{"text":"Mfalme wa Israeli na Mkombozi,","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni:","poem":2},{"text":"Mimi ni wa kwanza na Mimi ni wa mwisho;","poem":1},{"text":"zaidi yangu hakuna Mungu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ni nani basi aliye kama mimi? Yeye na atangaze.","poem":1},{"text":"Yeye atangaze na kuweka mbele yangu","poem":2},{"text":"ni kitu gani kilichotokea tangu nilipoumba watu wangu wa kale,","poem":1},{"text":"tena ni nini kitakachotokea:","poem":2},{"lineBreak":true},{"text":"naam, yeye na atoe unabii ni nini kitakachokuja.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Msitetemeke, msiogope.","poem":1},{"text":"Je, sikutangaza hili, na kutoa unabii tangu zamani?","poem":2},{"text":"Ninyi ni mashahidi wangu.","poem":1},{"text":"Je, yuko Mungu zaidi yangu mimi?","poem":2},{"text":"Hasha, hakuna Mwamba mwingine;","poem":1},{"text":"mimi simjui mwingine.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wote wachongao sanamu ni ubatili,","poem":1},{"text":"navyo vitu wanavyovithamini havifai kitu.","poem":2},{"text":"Wale ambao wanazitetea ni vipofu,","poem":1},{"text":"ni wajinga, nao waaibika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ni nani atengenezaye mungu na kusubu sanamu,","poem":1},{"text":"ambayo haiwezi kumfaidia kitu chochote?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yeye pamoja na wenziwe wa aina yake wataaibishwa,","poem":1},{"text":"mafundi wao si kitu ila ni wanadamu tu.","poem":2},{"text":"Wote wakusanyike pamoja na kuwa na msimamo wao,","poem":1},{"text":"watashushwa chini kwa hofu na kwa fedheha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Muhunzi huchukua kifaa","poem":1},{"text":"na kukifanyia kazi kwenye makaa ya moto,","poem":2},{"text":"hutengeneza sanamu kwa nyundo,","poem":1},{"text":"huifanyiza kwa nguvu za mkono wake.","poem":2},{"text":"Huona njaa na kupoteza nguvu zake,","poem":1},{"text":"asipokunywa maji huzimia.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Seremala hupima kwa kutumia kamba,","poem":1},{"text":"na huuchora mstari kwa kalamu;","poem":2},{"text":"huchonga kwa patasi","poem":1},{"text":"na kutia alama kwa bikari.","poem":2},{"text":"Huitengeneza katika umbo la binadamu,","poem":1},{"text":"umbo la binadamu katika utukufu wake wote,","poem":2},{"lineBreak":true},{"text":"ili iweze kukaa katika mahali pake pa ibada za sanamu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hukata miti ya mierezi,","poem":1},{"text":"huchukua mtiriza au mwaloni.","poem":2},{"text":"Huuacha ukue miongoni mwa miti ya msituni,","poem":1},{"text":"au hupanda msunobari, nayo mvua huufanya ukue.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ni kuni ya binadamu:","poem":1},{"text":"yeye huchukua baadhi yake na kuota moto,","poem":2},{"lineBreak":true},{"text":"huwasha moto na kuoka mkate.","poem":2},{"text":"Lakini pia huutumia kumtengeneza mungu na akamwabudu,","poem":1},{"text":"huitengeneza sanamu na kuisujudia.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Sehemu ya kuni huziweka motoni,","poem":1},{"text":"akapikia chakula chake,","poem":2},{"lineBreak":true},{"text":"hubanika nyama na kula hadi ashibe.","poem":2},{"text":"Huota moto na kusema,","poem":1},{"text":"“Aha! Ninahisi joto, ninaona moto.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mabaki yake hutengeneza mungu, sanamu yake;","poem":1},{"text":"yeye huisujudia na kuiabudu.","poem":2},{"text":"Huiomba na kusema,","poem":1},{"text":"“Niokoe; wewe ni mungu wangu.”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hawajui chochote, hawaelewi chochote,","poem":1},{"text":"macho yao yamefungwa hata hawawezi kuona,","poem":2},{"lineBreak":true},{"text":"akili zao zimefungwa hata hawawezi kufahamu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hakuna anayefikiri,","poem":1},{"text":"hakuna mwenye maarifa wala ufahamu wa kusema,","poem":2},{"text":"“Sehemu yake nilitumia kwa kuni;","poem":1},{"text":"hata pia nilioka mkate juu ya makaa yake,","poem":2},{"lineBreak":true},{"text":"nikabanika nyama na kuila.","poem":2},{"text":"Je, nifanye machukizo kwa kile kilichobaki?","poem":1},{"text":"Je, nisujudie gogo la mti?”","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hujilisha kwa majivu, moyo uliodanganyika humpotosha;","poem":1},{"text":"hawezi kujiokoa mwenyewe, au kusema,","poem":2},{"text":"“Je, kitu hiki kilicho mkononi wangu wa kuume","poem":1},{"text":"si ni uongo?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Ee Yakobo, kumbuka mambo haya,","poem":1},{"text":"ee Israeli, kwa kuwa wewe ni mtumishi wangu.","poem":2},{"text":"Nimekuumba wewe, wewe ni mtumishi wangu.","poem":1},{"text":"Ee Israeli, sitakusahau.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Nimeyafuta makosa yako kama wingu,","poem":1},{"text":"dhambi zako kama ukungu wa asubuhi.","poem":2},{"text":"Nirudie mimi,","poem":1},{"text":"kwa kuwa nimekukomboa wewe.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Enyi mbingu, imbeni kwa furaha,","poem":1},{"text":"kwa maana Mwenyezi Mungu amefanya jambo hili.","poem":2},{"lineBreak":true},{"text":"Ee vilindi vya dunia, piga kelele.","poem":2},{"text":"Enyi milima, pazeni sauti kwa nyimbo,","poem":1},{"text":"enyi misitu na miti yenu yote,","poem":2},{"text":"kwa maana Mwenyezi Mungu amemkomboa Yakobo,","poem":1},{"text":"ameuonesha utukufu wake katika Israeli.","poem":2}]},{"type":"heading","content":["Yerusalemu itakaliwa"]},{"type":"verse","number":24,"content":[{"text":"“Hili ndilo asemalo Mwenyezi Mungu,","poem":1},{"text":"Mkombozi wako, aliyekuumba tumboni:","poem":2},{"lineBreak":true},{"text":"“Mimi ni Mwenyezi Mungu,","poem":1},{"text":"niliyeumba vitu vyote,","poem":2},{"lineBreak":true},{"text":"niliyezitanda mbingu peke yangu,","poem":2},{"lineBreak":true},{"text":"niliyeitandaza nchi mwenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Mimi huzipinga ishara za manabii wa uongo,","poem":1},{"text":"na kuwatia upumbavu waaguzi,","poem":2},{"text":"niyapinduaye maarifa ya wenye hekima,","poem":1},{"text":"na kuyafanya kuwa upuzi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mimi ndimi niyathibitishaye maneno ya watumishi wake,","poem":1},{"text":"na kutimiza utabiri wa wajumbe wake.","poem":2},{"lineBreak":true},{"text":"“Mimi ndiye niiambiaye Yerusalemu, ‘Itakaliwa na watu,’","poem":1},{"text":"niiambiaye miji ya Yuda kuwa, ‘Itajengwa,’","poem":2},{"lineBreak":true},{"text":"na kuhusu magofu yake, ‘Mimi nitayatengeneza,’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"niiambiaye kilindi cha maji, ‘Kauka,","poem":1},{"text":"nami nitakausha vijito vyako,’","poem":2}]},{"type":"verse","number":28,"content":[{"text":"nisemaye kuhusu Koreshi, ‘Yeye ni mchungaji wangu,","poem":1},{"text":"naye atatimiza yote yanipendezayo;","poem":2},{"text":"atauambia Yerusalemu, “Ukajengwe tena,”","poem":1},{"text":"na kuhusu Hekalu, “Misingi yake na iwekwe.” ’","poem":2}]}],"footnotes":[{"noteId":30,"caller":"+","text":"maana yake Yeye aliye mnyofu, yaani Israeli","reference":{"chapter":44,"verse":2}}]},"thisChapterLink":"/api/swh_onmm/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}