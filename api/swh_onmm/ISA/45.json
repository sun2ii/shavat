{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"heading","content":["Koreshi ni chombo cha Mwenyezi Mungu"]},{"type":"verse","number":1,"content":[{"text":"“Hili ndilo asemalo Mwenyezi Mungu kwa mpakwa mafuta wake,","poem":1},{"text":"Koreshi, ambaye nimemshika mkono wake wa kuume","poem":2},{"text":"kutiisha mataifa mbele yake","poem":1},{"text":"na kuwavua wafalme silaha zao,","poem":2},{"text":"kufungua milango mbele yake","poem":1},{"text":"ili malango yasije yakafungwa:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitaenda mbele yako","poem":1},{"text":"na kusawazisha milima;","poem":2},{"text":"nitavunjavunja malango ya shaba","poem":1},{"text":"na kukatakata mapingo ya chuma.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nitakupa hazina za gizani,","poem":1},{"text":"mali iliyofichwa mahali pa siri,","poem":2},{"text":"ili upate kujua kwamba Mimi ndimi Mwenyezi Mungu,","poem":1},{"text":"Mungu wa Israeli, akuitaye kwa jina lako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa ajili ya Yakobo mtumishi wangu,","poem":1},{"text":"Israeli niliyemchagua,","poem":2},{"text":"nimekuita wewe kwa jina lako,","poem":1},{"text":"na kukupa jina la heshima,","poem":2},{"lineBreak":true},{"text":"ingawa wewe hunitambui.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mimi ndimi Mwenyezi Mungu, wala hakuna mwingine,","poem":1},{"text":"zaidi yangu hakuna Mungu.","poem":2},{"text":"Nitakutia nguvu,","poem":1},{"text":"ingawa wewe hujanitambua,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ili kutoka mawio ya jua","poem":1},{"text":"hadi machweo yake,","poem":2},{"text":"watu wapate kujua kwamba hakuna Mungu mwingine ila Mimi.","poem":1},{"text":"Mimi ndimi Mwenyezi Mungu wala hakuna mwingine.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mimi ninaumba nuru na kuhuluku giza,","poem":1},{"text":"ninaleta mafanikio na kusababisha maafa.","poem":2},{"lineBreak":true},{"text":"Mimi, Mwenyezi Mungu, huyatenda haya yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Enyi mbingu juu, nyesheni haki,","poem":1},{"text":"mawingu na yaidondoshe.","poem":2},{"text":"Dunia na ifunguke sana,","poem":1},{"text":"wokovu na uchipuke,","poem":2},{"text":"haki na ikue pamoja nao.","poem":1},{"text":"Mimi, Mwenyezi Mungu, ndiye niliyeiumba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Ole wake yeye ashindanaye na Muumba wake,","poem":1},{"text":"yeye ambaye ni kigae tu kati ya vigae juu ya ardhi.","poem":2},{"text":"Je, udongo wa kufinyangia humwambia mfinyanzi,","poem":1},{"text":"‘Unatengeneza nini wewe?’","poem":2},{"lineBreak":true},{"text":"Je, kazi yako husema,","poem":2},{"text":"‘Hana mikono’?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ole wake amwambiaye baba yake,","poem":1},{"text":"‘Umezaa nini?’","poem":2},{"lineBreak":true},{"text":"Au kumwambia mama yake,","poem":2},{"lineBreak":true},{"text":"‘Umezaa kitu gani?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Hili ndilo asemalo Mwenyezi Mungu,","poem":1},{"text":"yeye Aliye Mtakatifu wa Israeli na Muumba wake:","poem":2},{"text":"Kuhusu mambo yatakayokuja,","poem":1},{"text":"je, unaniuliza habari za watoto wangu,","poem":2},{"lineBreak":true},{"text":"au kunipa amri kuhusu kazi za mikono yangu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mimi ndiye niliyeumba dunia","poem":1},{"text":"na kumuumba mwanadamu juu yake.","poem":2},{"text":"Mikono yangu mwenyewe ndiyo iliyozitanda mbingu,","poem":1},{"text":"nikayapanga majeshi yake yote ya angani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mimi nitamwinua Koreshi katika haki yangu:","poem":1},{"text":"nitazinyoosha njia zake zote.","poem":2},{"text":"Yeye atajenga mji wangu upya,","poem":1},{"text":"na kuwaweka huru watu wangu walio uhamishoni,","poem":2},{"text":"lakini si kwa kulipiwa fedha wala kupewa zawadi,","poem":1},{"text":"asema Mwenyezi Mungu, Mungu wa majeshi ya mbinguni.”","poem":2}]},{"type":"verse","number":14,"content":["Hili ndilo asemalo Mwenyezi Mungu:",{"text":"“Mazao ya Misri na bidhaa za Kushi,","poem":1},{"text":"nao wale Waseba warefu,","poem":2},{"text":"watakujia na kuwa wako,","poem":1},{"text":"watakujia wakijikokota nyuma yako,","poem":2},{"lineBreak":true},{"text":"watakujia wamefungwa minyororo.","poem":2},{"text":"Watasujudu mbele yako,","poem":1},{"text":"wakikusihi na kusema,","poem":2},{"text":"‘Hakika Mungu yu pamoja nawe,","poem":1},{"text":"wala hakuna mwingine;","poem":2},{"lineBreak":true},{"text":"hakuna Mungu mwingine.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hakika wewe u Mungu unayejificha,","poem":1},{"text":"Ee Mungu na Mwokozi wa Israeli.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wote watengenezao sanamu wataaibika na kutahayarika;","poem":1},{"text":"wataenda kutahayarika pamoja.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Lakini Israeli ataokolewa na Mwenyezi Mungu","poem":1},{"text":"kwa wokovu wa milele;","poem":2},{"text":"kamwe hutaaibika wala kutatahayarika,","poem":1},{"text":"milele yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kwa kuwa hili ndilo asemalo Mwenyezi Mungu,","poem":1},{"text":"yeye aliyeumba mbingu,","poem":2},{"lineBreak":true},{"text":"ndiye Mungu;","poem":2},{"text":"yeye aliyeifanya dunia na kuiumba,","poem":1},{"text":"yeye ndiye aliiwekea misingi imara,","poem":2},{"text":"hakuiumba ili iwe tupu,","poem":1},{"text":"bali aliiumba ikaliwe na viumbe vyake.","poem":2},{"text":"Anasema:","poem":1},{"text":"“Mimi ndimi Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"wala hakuna mwingine.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sijasema sirini,","poem":1},{"text":"kutoka mahali fulani katika nchi ya giza;","poem":2},{"text":"sijawaambia wazao wa Yakobo,","poem":1},{"text":"‘Nitafuteni bure.’","poem":2},{"text":"Mimi, Mwenyezi Mungu, nasema kweli;","poem":1},{"text":"ninatangaza lililo sahihi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Kusanyikeni pamoja mje,","poem":1},{"text":"enyi wakimbizi kutoka mataifa.","poem":2},{"text":"Wale wabebao sanamu za mti ni watu wasio na akili,","poem":1},{"text":"wale waombao miungu isiyoweza kuokoa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tangazeni litakalokuwepo, lisemeni hilo;","poem":1},{"text":"wao na wafanye shauri pamoja.","poem":2},{"text":"Ni nani aliyetangulia kusema hili tangu zamani,","poem":1},{"text":"aliyelitangaza tangu zamani za kale?","poem":2},{"text":"Je, haikuwa Mimi, Mwenyezi Mungu?","poem":1},{"text":"Wala hapana Mungu mwingine","poem":2},{"lineBreak":true},{"text":"zaidi yangu mimi,","poem":2},{"text":"Mungu mwenye haki na Mwokozi;","poem":1},{"text":"hapana mwingine ila mimi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Nigeukieni mimi, nanyi mkaokolewe,","poem":1},{"text":"enyi miisho yote ya dunia;","poem":2},{"text":"kwa maana mimi ndimi Mungu,","poem":1},{"text":"wala hapana mwingine.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nimeapa kwa nafsi yangu,","poem":1},{"text":"kinywa changu kimenena katika uadilifu wote","poem":2},{"lineBreak":true},{"text":"neno ambalo halitatanguka:","poem":2},{"text":"Kila goti litapigwa mbele zangu,","poem":1},{"text":"kwangu mimi kila ulimi utaapa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Watasema kunihusu,","poem":1},{"text":"‘Katika Mwenyezi Mungu peke yake","poem":2},{"lineBreak":true},{"text":"ndiko kuna haki na nguvu.’ ”","poem":2},{"text":"Wote ambao wamemkasirikia Mungu","poem":1},{"text":"watamjia yeye, nao watatahayarika.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Lakini katika Mwenyezi Mungu wazao wote wa Israeli","poem":1},{"text":"wataonekana wenye haki na watashangilia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}