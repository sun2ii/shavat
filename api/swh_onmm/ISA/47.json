{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["Anguko la Babeli"]},{"type":"verse","number":1,"content":[{"text":"“Shuka uketi mavumbini,","poem":1},{"text":"ee Bikira Binti Babeli;","poem":2},{"text":"keti chini pasipo na kiti cha utawala,","poem":1},{"text":"ee Binti wa Wakaldayo.","poem":2},{"text":"Hutaitwa tena mwororo wala wa kupendeza.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Chukua mawe ya kusagia, usage unga,","poem":1},{"text":"vua shela yako.","poem":2},{"text":"Pandisha mavazi yako, ondoa viatu vyako,","poem":1},{"text":"vuka vijito kwa shida.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uchi wako utafunuliwa","poem":1},{"text":"na aibu yako itaonekana.","poem":2},{"text":"Nitalipa kisasi;","poem":1},{"text":"sitamhurumia hata mmoja.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mkombozi wetu: Mwenyezi Mungu, Mungu wa majeshi ya mbinguni ndilo jina lake;","poem":1},{"text":"ndiye yeye Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Keti kimya, ingia gizani,","poem":1},{"text":"Binti wa Wakaldayo,","poem":2},{"lineBreak":true},{"text":"hutaitwa tena malkia wa falme.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Niliwakasirikia watu wangu","poem":1},{"text":"na kuaibisha urithi wangu;","poem":2},{"text":"niliwatia mikononi mwako,","poem":1},{"text":"nawe hukuwaonea huruma.","poem":2},{"text":"Hata juu ya wazee","poem":1},{"text":"uliweka nira nzito sana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ukasema, ‘Nitaendelea","poem":1},{"text":"kuwa malkia milele!’","poem":2},{"text":"Lakini hukutafakari mambo haya","poem":1},{"text":"wala hukuwaza juu ya kile kingeweza kutokea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Sasa basi, sikiliza, ewe kiumbe mpenda anasa,","poem":1},{"text":"ukaaye mahali pako pa salama,","poem":2},{"text":"na kujiambia mwenyewe,","poem":1},{"text":"‘Mimi ndiye, wala hakuna mwingine zaidi yangu.","poem":2},{"text":"Kamwe sitakuwa mjane,","poem":1},{"text":"wala sitafiwa na watoto.’","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Haya mawili yatakupata, kufumba na kufumbua,","poem":1},{"text":"katika siku moja:","poem":2},{"lineBreak":true},{"text":"kufiwa na watoto, na ujane.","poem":2},{"text":"Yote yatakupata kwa kipimo kikamilifu,","poem":1},{"text":"ijapokuwa uchawi wako ni mwingi,","poem":2},{"lineBreak":true},{"text":"na uaguzi wako ni mwingi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Umeutegemea uovu wako,","poem":1},{"text":"nawe umesema, ‘Hakuna yeyote anionaye.’","poem":2},{"text":"Hekima yako na maarifa yako vinakupoteza","poem":1},{"text":"unapojiambia mwenyewe,","poem":2},{"lineBreak":true},{"text":"‘Mimi ndiye, wala hakuna mwingine zaidi yangu.’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Maafa yatakujia,","poem":1},{"text":"nawe hutaweza kuyaondoa kwa uaguzi.","poem":2},{"text":"Janga litakuangukia,","poem":1},{"text":"wala hutaweza kulikinga kwa fidia;","poem":2},{"text":"msiba mkuu usioweza kuutabiri","poem":1},{"text":"utakujia ghafula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Endelea basi na uaguzi wako,","poem":1},{"text":"na wingi wa uchawi wako,","poem":2},{"lineBreak":true},{"text":"ambao umeutumikia tangu utoto wako.","poem":2},{"text":"Labda utafanikiwa,","poem":1},{"text":"labda unaweza ukasababisha hofu kuu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ushauri wote uliopokea umekuchosha bure!","poem":1},{"text":"Wanajimu wako na waje mbele,","poem":2},{"text":"wale watazama nyota watabiriao mwezi baada ya mwezi,","poem":1},{"text":"wao na wawaokoe na lile linalokuja juu yenu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hakika wako kama mabua makavu;","poem":1},{"text":"moto utawateketeza.","poem":2},{"text":"Hawawezi hata kujiokoa wao wenyewe","poem":1},{"text":"kutokana na nguvu za mwali wa moto.","poem":2},{"text":"Hapa hakuna makaa ya kumtia mtu yeyote joto;","poem":1},{"text":"hapa hakuna moto wa kuota.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hayo ndiyo yote wanayoweza kuwatendea ninyi,","poem":1},{"text":"hawa ambao umetaabika nao","poem":2},{"lineBreak":true},{"text":"na kufanya nao biashara tangu utoto.","poem":2},{"text":"Kila mmoja atatoroka;","poem":1},{"text":"hakuna yeyote awezaye kukuokoa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}