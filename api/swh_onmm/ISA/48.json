{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["Israeli mkaidi"]},{"type":"verse","number":1,"content":[{"text":"“Sikilizeni hili, ee nyumba ya Yakobo,","poem":1},{"text":"ninyi mnaoitwa kwa jina la Israeli,","poem":2},{"lineBreak":true},{"text":"na mnaotoka katika ukoo wa Yuda,","poem":2},{"text":"ninyi mnaoapa kwa jina la Mwenyezi Mungu,","poem":1},{"text":"mnaomwomba Mungu wa Israeli,","poem":2},{"lineBreak":true},{"text":"lakini si katika kweli au kwa haki;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ninyi mnaojiita raia wa mji mtakatifu,","poem":1},{"text":"na kumtegemea Mungu wa Israeli,","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni ndilo jina lake:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nilitoa unabii mambo ya kwanza tangu zamani,","poem":1},{"text":"kinywa changu kiliyatangaza na kuyafanya yajulikane;","poem":2},{"lineBreak":true},{"text":"kisha ghafula nikayatenda, nayo yakatokea.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa kuwa nalijua jinsi ulivyokuwa mkaidi;","poem":1},{"text":"mishipa ya shingo yako ilikuwa chuma,","poem":2},{"lineBreak":true},{"text":"paji la uso wako lilikuwa shaba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa hiyo nilikuambia mambo haya tangu zamani,","poem":1},{"text":"kabla hayajatokea nilikutangazia","poem":2},{"text":"ili usije ukasema,","poem":1},{"text":"‘Sanamu zangu zilifanya hayo;","poem":2},{"lineBreak":true},{"text":"sanamu yangu ya mti, na mungu wangu wa chuma aliyaamuru.’","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Umesikia mambo haya; yaangalie hayo yote.","poem":1},{"text":"Je, hutayakubali?","poem":2},{"lineBreak":true},{"text":"“Kuanzia sasa na kuendelea nitakueleza mambo mapya,","poem":1},{"text":"juu ya mambo yaliyofichika usiyoyajua.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yameumbwa sasa, wala si tangu zamani;","poem":1},{"text":"hukupata kuyasikia kabla ya siku ya leo.","poem":2},{"text":"Hivyo huwezi kusema,","poem":1},{"text":"‘Naam, niliyajua hayo.’","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hujayasikia wala kuyaelewa,","poem":1},{"text":"tangu zamani sikio lako halikufunguka.","poem":2},{"text":"Ninafahamu vyema jinsi ulivyo mdanganyifu,","poem":1},{"text":"uliitwa mwasi tangu kuzaliwa kwako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa ajili ya Jina langu mwenyewe","poem":1},{"text":"ninaichelewesha ghadhabu yangu,","poem":2},{"text":"kwa ajili ya sifa zangu nimeizuia isikupate,","poem":1},{"text":"ili nisije nikakukatilia mbali.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tazama, nimekusafisha, ingawa si kama fedha,","poem":1},{"text":"nimekujaribu katika tanuru la mateso.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa ajili yangu mwenyewe,","poem":1},{"text":"kwa ajili yangu mwenyewe, nafanya hili.","poem":2},{"text":"Jinsi gani niliache Jina langu lichafuliwe?","poem":1},{"text":"Sitautoa utukufu wangu kwa mwingine.","poem":2}]},{"type":"heading","content":["Israeli anawekwa huru"]},{"type":"verse","number":12,"content":[{"text":"“Ee Yakobo, nisikilize mimi,","poem":1},{"text":"Israeli, ambaye nimekuita:","poem":2},{"text":"Mimi ndiye;","poem":1},{"text":"mimi ndimi mwanzo na mwisho.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mkono wangu mwenyewe uliweka misingi ya dunia,","poem":1},{"text":"nao mkono wangu wa kuume umezitanda mbingu;","poem":2},{"lineBreak":true},{"text":"niziitapo, zote husimama pamoja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Kusanyikeni, ninyi nyote, msikilize:","poem":1},{"text":"Ni ipi miongoni mwa hizo sanamu","poem":2},{"lineBreak":true},{"text":"ambayo imetabiri vitu hivi?","poem":2},{"text":"Watu wa Mwenyezi Mungu waliochaguliwa na kuungana","poem":1},{"text":"watatimiza kusudi lake dhidi ya Babeli;","poem":2},{"lineBreak":true},{"text":"mkono wa Mungu utakuwa dhidi ya Wakaldayo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mimi, naam, Mimi, nimenena;","poem":1},{"text":"naam, nimemwita yeye.","poem":2},{"text":"Nitamleta,","poem":1},{"text":"naye atafanikiwa katika lile nililomtuma.","poem":2}]},{"type":"verse","number":16,"content":["“Nikaribieni na msikilize hili:",{"text":"“Tangu tangazo la kwanza sikusema kwa siri;","poem":1},{"text":"wakati litokeapo, nitakuwako hapo.”","poem":2},{"lineBreak":true},{"text":"Sasa Bwana Mungu Mwenyezi amenituma,","poem":1},{"text":"kwa Roho wake Mtakatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hili ndilo asemalo Mwenyezi Mungu,","poem":1},{"text":"Mkombozi wako, yeye Aliye Mtakatifu wa Israeli:","poem":2},{"text":"“Mimi ni Mwenyezi Mungu, Mungu wako,","poem":1},{"text":"nikufundishaye ili upate faida,","poem":2},{"lineBreak":true},{"text":"nikuongozaye katika njia ikupasayo kuiendea.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Laiti ungesikiliza kwa makini maagizo yangu,","poem":1},{"text":"amani yako ingekuwa kama mto,","poem":2},{"lineBreak":true},{"text":"haki yako kama mawimbi ya bahari.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wazao wako wangekuwa kama mchanga,","poem":1},{"text":"watoto wako kama chembe zake zisizohesabika;","poem":2},{"text":"kamwe jina lao lisingefutiliwa mbali,","poem":1},{"text":"wala kuangamizwa kutoka mbele zangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Tokeni huko Babeli,","poem":1},{"text":"kimbieni kutoka kwa Wakaldayo!","poem":2},{"text":"Tangazeni hili kwa kelele za shangwe","poem":1},{"text":"na kulihubiri.","poem":2},{"text":"Lipelekeni hadi miisho ya dunia;","poem":1},{"text":"semeni, “Mwenyezi Mungu amemkomboa","poem":2},{"lineBreak":true},{"text":"mtumishi wake Yakobo.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hawakuona kiu alipowaongoza kupita jangwani;","poem":1},{"text":"alifanya maji yatiririke kutoka mwamba kwa ajili yao;","poem":2},{"text":"akapasua mwamba","poem":1},{"text":"na maji yakatoka kwa nguvu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Hakuna amani kwa waovu,” asema Mwenyezi Mungu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}