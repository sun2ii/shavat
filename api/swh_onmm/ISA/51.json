{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["Wokovu wa milele kwa Sayuni"]},{"type":"verse","number":1,"content":[{"text":"“Nisikilizeni, ninyi mnaofuatia haki","poem":1},{"text":"na mnaomtafuta Mwenyezi Mungu:","poem":2},{"text":"Tazameni mwamba ambako mlichongwa,","poem":1},{"text":"na mahali pa kuvunjia mawe ambako mlichimbwa;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"mwangalieni Ibrahimu, baba yenu,","poem":1},{"text":"na Sara, ambaye aliwazaa.","poem":2},{"text":"Wakati nilimwita alikuwa mmoja tu,","poem":1},{"text":"nami nikambariki na kumfanya kuwa wengi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hakika Mwenyezi Mungu ataifariji Sayuni,","poem":1},{"text":"naye atayaangalia kwa huruma magofu yake yote;","poem":2},{"text":"atayafanya majangwa yake yawe kama Edeni,","poem":1},{"text":"nazo sehemu zake zisizolimika ziwe kama bustani ya Mwenyezi Mungu.","poem":2},{"text":"Shangwe na furaha zitakuwa ndani yake,","poem":1},{"text":"shukrani na sauti za kuimba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Nisikilizeni, watu wangu;","poem":1},{"text":"nisikieni, taifa langu:","poem":2},{"text":"Torati itatoka kwangu;","poem":1},{"text":"haki yangu itakuwa nuru kwa mataifa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Haki yangu inakaribia mbio,","poem":1},{"text":"wokovu wangu unakuja,","poem":2},{"lineBreak":true},{"text":"nao mkono wangu utaleta hukumu kwa mataifa.","poem":2},{"text":"Visiwa vitanitegemea","poem":1},{"text":"na kungojea mkono wangu kwa matumaini.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inueni macho yenu mbinguni,","poem":1},{"text":"mkaitazame dunia chini;","poem":2},{"text":"mbingu zitatoweka kama moshi,","poem":1},{"text":"dunia itachakaa kama vazi,","poem":2},{"lineBreak":true},{"text":"na wakazi wake kufa kama inzi.","poem":2},{"text":"Bali wokovu wangu utadumu milele,","poem":1},{"text":"haki yangu haitakoma kamwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Nisikieni, ninyi mnaojua lililo sawa,","poem":1},{"text":"ninyi watu ambao mna sheria yangu mioyoni mwenu:","poem":2},{"text":"Msiogope mashutumu ya wanadamu","poem":1},{"text":"wala msitiwe hofu na matukano yao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa maana nondo atawala kama vazi,","poem":1},{"text":"nao funza atawatafuna kama sufu.","poem":2},{"text":"Lakini haki yangu itadumu milele,","poem":1},{"text":"wokovu wangu kwa vizazi vyote.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Amka, Amka! Jivike nguvu,","poem":1},{"text":"ewe mkono wa Mwenyezi Mungu,","poem":2},{"text":"Amka, kama siku zilizopita,","poem":1},{"text":"kama vile vizazi vya zamani.","poem":2},{"text":"Si ni wewe uliyemkata Rahabu vipande vipande,","poem":1},{"text":"uliyemchoma huyo mnyama mkubwa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Si ni wewe uliyekausha bahari,","poem":1},{"text":"maji ya kilindi kikuu,","poem":2},{"text":"uliyefanya barabara katika vilindi vya bahari","poem":1},{"text":"ili waliokombolewa wapate kuvuka?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wale waliolipiwa fidia na Mwenyezi Mungu watarudi.","poem":1},{"text":"Wataingia Sayuni wakiimba;","poem":2},{"lineBreak":true},{"text":"furaha ya milele itakuwa taji juu ya vichwa vyao.","poem":2},{"text":"Furaha na shangwe zitawapata,","poem":1},{"text":"huzuni na kulia kwa uchungu kutatoweka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Mimi, naam mimi,","poem":1},{"text":"ndimi niwafarijie ninyi.","poem":2},{"text":"Ninyi ni nani hata kuwaogopa","poem":1},{"text":"wanadamu wanaokufa,","poem":2},{"lineBreak":true},{"text":"wanadamu ambao ni majani tu,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kwamba mnamsahau Mwenyezi Mungu Muumba wenu,","poem":1},{"text":"aliyezitanda mbingu","poem":2},{"lineBreak":true},{"text":"na kuiweka misingi ya dunia,","poem":2},{"text":"kwamba mnaishi katika hofu siku zote","poem":1},{"text":"kwa sababu ya ghadhabu ya mdhalimu,","poem":2},{"lineBreak":true},{"text":"ambaye nia yake ni kuangamiza?","poem":2},{"text":"Iko wapi basi ghadhabu ya mdhalimu?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"Wafungwa waliojikunyata kwa hofu","poem":2},{"lineBreak":true},{"text":"watawekwa huru karibuni;","poem":2},{"text":"hawatafia kwenye gereza lao,","poem":1},{"text":"wala hawatakosa chakula.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa maana Mimi ndimi Mwenyezi Mungu, Mungu wako,","poem":1},{"text":"ambaye huisukasuka bahari ili mawimbi yake yangurume:","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni ndilo jina lake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nimeweka maneno yangu kinywani mwako","poem":1},{"text":"na kukufunika kwa uvuli wa mkono wangu:","poem":2},{"text":"Mimi niliyeweka mbingu mahali pake,","poem":1},{"text":"niliyeweka misingi ya dunia,","poem":2},{"text":"niwaambiaye Sayuni,","poem":1},{"text":"‘Ninyi ni watu wangu.’ ”","poem":2}]},{"type":"heading","content":["Kikombe cha ghadhabu ya Mwenyezi Mungu"]},{"type":"verse","number":17,"content":[{"text":"Amka, amka!","poem":1},{"text":"Simama, ee Yerusalemu,","poem":2},{"text":"wewe uliyekunywa kutoka mkono wa Mwenyezi Mungu","poem":1},{"text":"kikombe cha ghadhabu yake,","poem":2},{"text":"wewe uliyekunywa hata machujo yake,","poem":1},{"text":"kikombe kile cha kunywea","poem":2},{"lineBreak":true},{"text":"kiwafanyacho watu kuyumbayumba.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kati ya wana wote aliowazaa","poem":1},{"text":"hapakuwa na hata mmoja wa kumwongoza;","poem":2},{"text":"kati ya wana wote aliowalea","poem":1},{"text":"hapakuwa hata mmoja wa kumshika mkono.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Majanga haya mawili yamekuja juu yako:","poem":1},{"text":"ni nani awezaye kukufariji?","poem":2},{"text":"Maangamizi, uharibifu, njaa na upanga:","poem":1},{"text":"ni nani awezaye kukutuliza?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wana wako wamezimia,","poem":1},{"text":"wamelala kwenye mwanzo wa kila barabara,","poem":2},{"lineBreak":true},{"text":"kama swala aliyenaswa kwenye wavu.","poem":2},{"text":"Wamejazwa na ghadhabu ya Mwenyezi Mungu","poem":1},{"text":"na makaripio ya Mungu wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kwa hiyo sikiliza hili, wewe uliyeteswa,","poem":1},{"text":"uliyelewa, lakini si kwa mvinyo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hili ndilo asemalo Bwana Mungu Mwenyezi wako,","poem":1},{"text":"Mungu wako, yeye ambaye huwatetea watu wake:","poem":2},{"text":"“Tazama, nimeondoa mkononi mwako","poem":1},{"text":"kikombe kilichokufanya uyumbayumbe;","poem":2},{"text":"kutoka kikombe hicho,","poem":1},{"text":"kikombe cha kunywa cha ghadhabu yangu,","poem":2},{"lineBreak":true},{"text":"kamwe hutakunywa tena.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nitakiweka mikononi mwa watesi wako,","poem":1},{"text":"wale waliokuambia,","poem":2},{"text":"‘Anguka kifudifudi","poem":1},{"text":"ili tuweze kutembea juu yako.’","poem":2},{"text":"Ukaufanya mgongo wako kama ardhi,","poem":1},{"text":"kama njia yao ya kupita.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}