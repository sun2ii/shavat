{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["Utukufu wa baadaye wa Sayuni"]},{"type":"verse","number":1,"content":[{"text":"“Imba, ewe mwanamke tasa,","poem":1},{"text":"wewe ambaye kamwe hukuzaa mtoto;","poem":2},{"text":"paza sauti kwa kuimba, piga kelele kwa furaha,","poem":1},{"text":"wewe ambaye kamwe hukupata uchungu;","poem":2},{"text":"kwa sababu watoto wa mwanamke aliyeachwa ukiwa ni wengi","poem":1},{"text":"kuliko wa mwanamke mwenye mume,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Panua mahali pa hema lako,","poem":1},{"text":"tandaza mapazia ya hema lako uyaeneze mbali,","poem":2},{"lineBreak":true},{"text":"wala usiyazuie;","poem":2},{"text":"ongeza urefu wa kamba zako,","poem":1},{"text":"imarisha vigingi vyako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa maana utaenea upande wa kuume","poem":1},{"text":"na upande wa kushoto;","poem":2},{"text":"wazao wako watayamiliki mataifa","poem":1},{"text":"na kukaa katika miji yao iliyoachwa ukiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Usiogope, wewe hutaaibika.","poem":1},{"text":"Usiogope aibu, wewe hutaaibishwa.","poem":2},{"text":"Wewe utasahau aibu ya ujana wako,","poem":1},{"text":"wala hutakumbuka tena mashutumu ya ujane wako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa maana Muumba wako ndiye mume wako,","poem":1},{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni ndilo jina lake,","poem":2},{"text":"yeye Aliye Mtakatifu wa Israeli ni Mkombozi wako,","poem":1},{"text":"yeye anaitwa Mungu wa dunia yote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwenyezi Mungu atakuita urudi","poem":1},{"text":"kana kwamba ulikuwa mke aliyeachwa na kuhuzunishwa rohoni;","poem":2},{"text":"kama mke aliyeolewa bado angali kijana","poem":1},{"text":"na kukataliwa,” asema Mungu wako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Kwa kitambo kidogo nilikuacha,","poem":1},{"text":"lakini kwa huruma nyingi nitakurudisha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Katika ukali wa hasira","poem":1},{"text":"nilikuficha uso wangu kwa kitambo,","poem":2},{"text":"lakini kwa fadhili za milele","poem":1},{"text":"nitakuwa na huruma juu yako,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu Mkombozi wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Kwangu mimi jambo hili ni kama siku za Nuhu,","poem":1},{"text":"nilipoapa kuwa maji ya Nuhu kamwe hayatafunika tena dunia.","poem":2},{"text":"Hivyo sasa nimeapa sitawakasirikia ninyi,","poem":1},{"text":"kamwe sitawakemea tena.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ijapotikisika milima, na vilima viondolewe,","poem":1},{"text":"hata hivyo upendo wangu usiokoma kwenu hautatikisika,","poem":2},{"text":"wala agano langu la amani halitaondolewa,”","poem":1},{"text":"asema Mwenyezi Mungu, mwenye huruma juu yenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ewe mji uliyeteswa, uliyepigwa kwa dhoruba","poem":1},{"text":"na usiyetulizwa,","poem":2},{"text":"nitakujenga kwa almasi,","poem":1},{"text":"nitaweka misingi yako","poem":2},{"lineBreak":true},{"text":"kwa yakuti samawi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitafanya minara yako ya akiki,","poem":1},{"text":"malango yako kwa vito ving’aavyo,","poem":2},{"lineBreak":true},{"text":"nazo kuta zako zote za vito vya thamani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Watoto wako wote watafundishwa na Mwenyezi Mungu,","poem":1},{"text":"nayo amani ya watoto wako itakuwa kuu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa haki utathibitika:","poem":1},{"lineBreak":true},{"text":"Kuonewa kutakuwa mbali nawe;","poem":1},{"text":"hutaogopa chochote.","poem":2},{"text":"Hofu itakuwa mbali nawe;","poem":1},{"text":"haitakukaribia wewe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kama mtu yeyote akikushambulia,","poem":1},{"text":"haitakuwa kwa ruhusa yangu;","poem":2},{"text":"yeyote akushambuliaye","poem":1},{"text":"atajisalimisha kwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Tazama, ni mimi niliyemuumba mhunzi,","poem":1},{"text":"yeye afukutaye makaa kuwa moto,","poem":2},{"lineBreak":true},{"text":"na kutengeneza silaha inayofaa kwa kazi yake.","poem":2},{"text":"Tena ni mimi niliyemwambia mharibu","poem":1},{"text":"kufanya uharibifu mwingi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hakuna silaha itakayofanyizwa dhidi yako","poem":1},{"text":"itakayofanikiwa,","poem":2},{"text":"nawe utauthibitisha kuwa mwongo","poem":1},{"text":"kila ulimi utakaokushtaki.","poem":2},{"text":"Huu ndio urithi wa watumishi wa Mwenyezi Mungu","poem":1},{"text":"na hii ndiyo haki yao inayotoka kwangu,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}