{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["Wokovu kwa wengine"]},{"type":"verse","number":1,"content":["Hili ndilo asemalo Mwenyezi Mungu:",{"text":"“Dumisheni haki","poem":1},{"text":"na mkatende lile lililo sawa,","poem":2},{"text":"kwa maana wokovu wangu u karibu","poem":1},{"text":"na haki yangu itafunuliwa upesi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Amebarikiwa mtu yule atendaye hili,","poem":1},{"text":"mtu yule alishikaye kwa uthabiti,","poem":2},{"text":"yeye ashikaye Sabato bila kuinajisi,","poem":1},{"text":"auzuiaye mkono wake usifanye uovu wowote.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Usimwache mgeni aambatanaye na Mwenyezi Mungu aseme,","poem":1},{"text":"“Hakika Mwenyezi Mungu atanitenga na watu wake.”","poem":2},{"text":"Usimwache towashi yeyote alalamike akisema,","poem":1},{"text":"“Mimi ni mti mkavu tu.”","poem":2}]},{"type":"verse","number":4,"content":["Kwa kuwa hili ndilo asemalo Mwenyezi Mungu:",{"text":"“Kwa matowashi washikao Sabato zangu,","poem":1},{"text":"ambao huchagua kile kinachonipendeza","poem":2},{"lineBreak":true},{"text":"na kulishika sana agano langu:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"hao nitawapa ndani ya Hekalu langu na kuta zake","poem":1},{"text":"kumbukumbu na jina bora","poem":2},{"lineBreak":true},{"text":"kuliko kuwa na watoto wa kiume na wa kike:","poem":2},{"text":"nitawapa jina lidumulo milele,","poem":1},{"text":"ambalo halitakatiliwa mbali.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wageni wanaoambatana na Mwenyezi Mungu","poem":1},{"text":"ili kumtumikia,","poem":2},{"text":"kulipenda jina la Mwenyezi Mungu,","poem":1},{"text":"na kumwabudu yeye,","poem":2},{"text":"wote washikao Sabato bila kuinajisi","poem":1},{"text":"na ambao hushika sana agano langu:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"hawa nitawaleta kwenye mlima wangu mtakatifu","poem":1},{"text":"na kuwapa furaha ndani ya nyumba yangu ya sala.","poem":2},{"text":"Sadaka zao za kuteketeza na dhabihu zao","poem":1},{"text":"zitakubalika juu ya madhabahu yangu;","poem":2},{"text":"kwa maana nyumba yangu itaitwa","poem":1},{"text":"nyumba ya sala kwa mataifa yote.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bwana Mungu Mwenyezi asema, yeye awakusanyaye","poem":1},{"text":"Waisraeli waliohamishwa:","poem":2},{"text":"“Bado nitawakusanya wengine kwao","poem":1},{"text":"zaidi ya hao ambao wamekusanywa tayari.”","poem":2}]},{"type":"heading","content":["Mashtaka ya Mwenyezi Mungu dhidi ya waovu"]},{"type":"verse","number":9,"content":[{"text":"Njooni, enyi wanyama wote wa kondeni,","poem":1},{"text":"njooni mle, ninyi wanyama wote wa mwituni!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Walinzi wa Israeli ni vipofu,","poem":1},{"text":"wote wamepungukiwa na maarifa;","poem":2},{"text":"wote ni mbwa walio bubu,","poem":1},{"text":"hawawezi kubweka;","poem":2},{"text":"hulala na kuota ndoto,","poem":1},{"text":"hupenda kulala.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ni mbwa wenye tamaa kubwa,","poem":1},{"text":"kamwe hawatosheki.","poem":2},{"text":"Wao ni wachungaji waliopungukiwa na ufahamu;","poem":1},{"text":"wote wamegeukia njia yao wenyewe,","poem":2},{"lineBreak":true},{"text":"kila mmoja hutafuta faida yake mwenyewe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kila mmoja hulia, “Njooni, tupate mvinyo!","poem":1},{"text":"Tunywe kileo sana!","poem":2},{"text":"Kesho itakuwa kama leo,","poem":1},{"text":"au hata bora zaidi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}