{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["Mfungo wa kweli"]},{"type":"verse","number":1,"content":[{"text":"“Piga kelele, usizuie.","poem":1},{"text":"Paza sauti yako kama tarumbeta.","poem":2},{"text":"Watangazieni watu wangu uasi wao,","poem":1},{"text":"na kwa nyumba ya Yakobo dhambi zao.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa maana kila siku hunitafuta,","poem":1},{"text":"wanaonekana kutaka kujua njia zangu,","poem":2},{"text":"kana kwamba walikuwa taifa linalotenda lililo sawa,","poem":1},{"text":"na ambalo halijaziacha amri za Mungu wake.","poem":2},{"text":"Hutaka kwangu maamuzi ya haki,","poem":1},{"text":"nao hutamani Mungu awakaribie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wao husema, ‘Mbona tumefunga, nawe hujaona?","poem":1},{"text":"Mbona tumejinyenyekeza, nawe huangalii?’","poem":2},{"lineBreak":true},{"text":"“Lakini katika siku ya kufunga kwenu, mnafanya mnavyotaka","poem":1},{"text":"na kuwadhulumu wafanyakazi wenu wote.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kufunga kwenu huishia kwenye magomvi na mapigano,","poem":1},{"text":"na kupigana ninyi kwa ninyi kwa ngumi za uovu.","poem":2},{"text":"Hamwezi kufunga kama mnavyofanya leo","poem":1},{"text":"na kutazamia sauti zenu kusikiwa huko juu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Je, hii ndiyo aina ya mfungo niliouchagua,","poem":1},{"text":"siku moja tu ya mtu kujinyenyekeza?","poem":2},{"text":"Je, ni kwa kuinamisha kichwa chini kama tete,","poem":1},{"text":"na kwa kujilaza juu ya gunia na majivu?","poem":2},{"text":"Je, huo ndio mnaouita mfungo,","poem":1},{"text":"siku iliyokubalika kwa Mwenyezi Mungu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Je, hii si ndiyo aina ya mfungo niliyoichagua:","poem":1},{"text":"kufungua minyororo ya udhalimu,","poem":2},{"lineBreak":true},{"text":"na kufungua kamba za nira,","poem":2},{"text":"kuwaweka huru waliodhulumiwa,","poem":1},{"text":"na kuvunja kila nira?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je, sio kushirikiana chakula chako na wenye njaa","poem":1},{"text":"na kuwapatia maskini wasiokuwa na makao hifadhi,","poem":2},{"text":"unapomwona aliye uchi, umvike,","poem":1},{"text":"wala si kumkimbia mtu wa mwili wako","poem":2},{"lineBreak":true},{"text":"na damu yako mwenyewe?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ndipo nuru yako itajitokeza kama mapambazuko","poem":1},{"text":"na uponyaji wako utatokea upesi;","poem":2},{"text":"ndipo haki yako itakapokutangulia mbele yako,","poem":1},{"text":"na utukufu wa Mwenyezi Mungu utakuwa mlinzi nyuma yako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ndipo utaita, naye Mwenyezi Mungu atajibu,","poem":1},{"text":"utalia kuomba msaada,","poem":2},{"lineBreak":true},{"text":"naye atasema: Mimi hapa.","poem":2},{"lineBreak":true},{"text":"“Ukiiondoa nira ya udhalimu,","poem":1},{"text":"na kunyoosha kidole na kuzungumza maovu,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"nanyi mkimkunjulia mtu mwenye njaa nafsi zenu","poem":1},{"text":"na kutosheleza mahitaji ya waliodhulumiwa,","poem":2},{"text":"ndipo nuru yenu itang’aa gizani,","poem":1},{"text":"nao usiku wenu utakuwa kama adhuhuri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu atakuongoza siku zote,","poem":1},{"text":"atayatosheleza mahitaji yako katika nchi kame,","poem":2},{"lineBreak":true},{"text":"naye ataitia nguvu mifupa yako.","poem":2},{"text":"Utakuwa kama bustani iliyonyweshwa vizuri,","poem":1},{"text":"kama chemchemi ambayo maji yake hayakauki kamwe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watu wako watajenga tena magofu ya zamani","poem":1},{"text":"na kuinua misingi ya kale;","poem":2},{"text":"utaitwa Mwenye Kukarabati Kuta Zilizobomoka,","poem":1},{"text":"Mwenye Kurejesha Barabara za Makao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Ukitunza miguu yako isivunje Sabato,","poem":1},{"text":"na kutokufanya kama vile upendavyo katika siku yangu takatifu,","poem":2},{"text":"ukiita Sabato siku ya furaha","poem":1},{"text":"na siku takatifu ya Mwenyezi Mungu ya kuheshimiwa,","poem":2},{"text":"kama utaiheshimu kwa kutoenenda","poem":1},{"text":"katika njia zako mwenyewe,","poem":2},{"text":"na kutokufanya yakupendezayo","poem":1},{"text":"au kusema maneno ya upuzi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ndipo utakapojipatia furaha yako katika Mwenyezi Mungu,","poem":1},{"text":"nami nitakufanya upande juu ya miinuko ya nchi","poem":2},{"lineBreak":true},{"text":"na kusherehekea urithi wa Yakobo baba yako.”","poem":2},{"text":"Kinywa cha Mwenyezi Mungu kimenena haya.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}