{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["Dhambi, toba na ukombozi"]},{"type":"verse","number":1,"content":[{"text":"Hakika mkono wa Mwenyezi Mungu si mfupi hata usiweze kuokoa,","poem":1},{"text":"wala sikio lake si zito hata lisiweze kusikia.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lakini maovu yenu yamewatenga","poem":1},{"text":"ninyi na Mungu wenu,","poem":2},{"text":"dhambi zenu zimewaficha ninyi uso wake,","poem":1},{"text":"ili asisikie.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa maana mikono yenu imetiwa unajisi kwa damu,","poem":1},{"text":"na vidole vyenu kwa hatia.","poem":2},{"text":"Midomo yenu imenena uongo,","poem":1},{"text":"nazo ndimi zenu zimenong’ona mambo maovu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hakuna hata mmoja anayedai kwa haki;","poem":1},{"text":"hakuna hata mmoja anayetetea kwa haki.","poem":2},{"text":"Wanategemea mabishano matupu na kusema uongo,","poem":1},{"text":"huchukua mimba ya magomvi na kuzaa uovu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Huangua mayai ya nyoka wenye sumu kali","poem":1},{"text":"na kutanda wavu wa buibui.","poem":2},{"text":"Yeyote alaye mayai yao atakufa,","poem":1},{"text":"nalo moja likianguliwa, nyoka hutoka humo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Utando wao wa buibui haufai kwa mavazi;","poem":1},{"text":"hawawezi kujifunika kwa kile walichokitengeneza.","poem":2},{"text":"Matendo yao ni matendo maovu,","poem":1},{"text":"vitendo vya jeuri vipo mikononi mwao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Miguu yao hukimbilia kwenye dhambi,","poem":1},{"text":"ni myepesi kumwaga damu isiyo na hatia.","poem":2},{"text":"Mawazo yao ni mawazo maovu;","poem":1},{"text":"uharibifu na maangamizi huonekana katika njia zao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hawajui njia ya amani,","poem":1},{"text":"hakuna haki katika mapito yao.","poem":2},{"text":"Wameyageuza kuwa njia za upotovu,","poem":1},{"text":"hakuna apitaye njia hizo atakayeifahamu amani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hivyo uadilifu uko mbali nasi,","poem":1},{"text":"nayo haki haitufikii.","poem":2},{"text":"Tunatazamia nuru, kumbe! Yote ni giza,","poem":1},{"text":"tunatazamia mwanga, lakini tunatembea katika giza nene.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Tunapapasa ukuta kama vipofu,","poem":1},{"text":"tunapapasa katika njia zetu kama watu wasio na macho.","poem":2},{"text":"Adhuhuri tunajikwaa kama wakati wa gizagiza;","poem":1},{"text":"kati ya wenye nguvu, tuko kama wafu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wote tunanguruma kama dubu;","poem":1},{"text":"tunalia kwa maombolezo kama hua.","poem":2},{"text":"Tunatafuta haki, kumbe hakuna kabisa;","poem":1},{"text":"tunatafuta wokovu, lakini uko mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kwa sababu makosa yetu ni mengi machoni pako,","poem":1},{"text":"na dhambi zetu zinashuhudia dhidi yetu.","poem":2},{"text":"Makosa yetu yako pamoja nasi daima,","poem":1},{"text":"nasi tunayatambua maovu yetu:","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uasi na udanganyifu dhidi ya Mwenyezi Mungu,","poem":1},{"text":"kumgeuzia Mungu wetu kisogo,","poem":2},{"text":"tukichochea udhalimu na maasi,","poem":1},{"text":"tukinena uongo ambao mioyo yetu imeuhifadhi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hivyo uadilifu umerudishwa nyuma,","poem":1},{"text":"nayo haki inasimama mbali,","poem":2},{"text":"kweli imejikwaa njiani,","poem":1},{"text":"uaminifu hauwezi kuingia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kweli haipatikani popote,","poem":1},{"text":"na yeyote aepukaye uovu huwa mawindo.","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu alitazama, naye akachukizwa","poem":1},{"text":"kwamba hapakuwa na haki.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Aliona kuwa hapakuwa hata mtu mmoja,","poem":1},{"text":"akashangaa kwamba hapakuwa hata mtu mmoja wa kuingilia kati.","poem":2},{"text":"Hivyo mkono wake mwenyewe","poem":1},{"text":"ndio uliomfanyia wokovu,","poem":2},{"text":"nayo haki yake mwenyewe","poem":1},{"text":"ndiyo iliyomtegemeza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Alivaa haki kama dirii kifuani mwake,","poem":1},{"text":"na chapeo ya wokovu kichwani mwake,","poem":2},{"text":"alivaa mavazi ya kisasi","poem":1},{"text":"naye akajifunga wivu kama joho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kulingana na kile walichokuwa wametenda,","poem":1},{"text":"ndivyo atakavyolipa","poem":2},{"text":"ghadhabu kwa watesi wake","poem":1},{"text":"na kisasi kwa adui zake,","poem":2},{"lineBreak":true},{"text":"atavilipa visiwa sawa na wanavyostahili.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kuanzia magharibi, watu wataliogopa jina la Mwenyezi Mungu","poem":1},{"text":"na kuanzia mawio ya jua, watauheshimu utukufu wake.","poem":2},{"text":"Adui atakapokuja kama mafuriko,","poem":1},{"text":"Roho wa Mwenyezi Mungu atainua kiwango dhidi yake na kumshinda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mkombozi atakuja Sayuni,","poem":1},{"text":"kwa wale wa Yakobo","poem":2},{"lineBreak":true},{"text":"wanaozitubu dhambi zao,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":21,"content":["“Bali mimi, hili ndilo agano langu nao,” asema Mwenyezi Mungu. “Roho wangu Mtakatifu, aliye juu yenu, na maneno yangu niliyoyaweka vinywani vyenu, havitaondoka vinywani mwenu, wala kutoka vinywani mwa watoto wenu, wala kutoka vinywani mwa wazao wao, kuanzia sasa na hata milele,” asema Mwenyezi Mungu."]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}