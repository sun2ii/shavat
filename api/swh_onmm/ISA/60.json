{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["Utukufu wa Sayuni"]},{"type":"verse","number":1,"content":[{"text":"“Ondoka, angaza, kwa kuwa nuru yako imekuja","poem":1},{"text":"na utukufu wa Mwenyezi Mungu umezuka juu yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tazama, giza litaifunika dunia,","poem":1},{"text":"na giza nene litayafunika mataifa,","poem":2},{"text":"lakini Mwenyezi Mungu atazuka juu yako","poem":1},{"text":"na utukufu wake utaonekana juu yako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mataifa watakuja kwenye nuru yako","poem":1},{"text":"na wafalme kwa mwanga wa mapambazuko yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Inua macho yako na utazame pande zote:","poem":1},{"text":"Wote wanakusanyika na kukujia,","poem":2},{"text":"wana wako wanakuja toka mbali,","poem":1},{"text":"nao binti zako wanabebwa mikononi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ndipo utatazama na kutiwa nuru,","poem":1},{"text":"moyo wako utasisimka na kujaa furaha,","poem":2},{"text":"mali iliyo baharini italetwa kwako,","poem":1},{"text":"utajiri wa mataifa utakujilia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Makundi ya ngamia yatajaa katika nchi yako,","poem":1},{"text":"ngamia vijana wa Midiani na Efa.","poem":2},{"text":"Nao watu wote wanaotoka Sheba watakuja,","poem":1},{"text":"wakichukua dhahabu na uvumba","poem":2},{"lineBreak":true},{"text":"na kutangaza sifa za Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Makundi yote ya Kedari yatakusanyika kwako,","poem":1},{"text":"kondoo dume wa Nebayothi watakutumikia,","poem":2},{"text":"watakubalika kama sadaka juu ya madhabahu yangu,","poem":1},{"text":"nami nitalipamba Hekalu langu tukufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Ni nani hawa warukao kama mawingu,","poem":1},{"text":"kama hua kuelekea kwenye viota vyao?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hakika visiwa vinanitazama;","poem":1},{"text":"merikebu za Tarshishi","poem":2},{"noteId":34},{"text":"ndizo zinazotangulia,","poem":2},{"text":"zikiwaleta wana wenu kutoka mbali,","poem":1},{"text":"wakiwa na fedha na dhahabu zao,","poem":2},{"text":"kwa heshima ya Mwenyezi Mungu, Mungu wenu,","poem":1},{"text":"yeye Aliye Mtakatifu wa Israeli,","poem":2},{"lineBreak":true},{"text":"kwa maana amekujalia utukufu.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Wageni watazijenga upya kuta zako,","poem":1},{"text":"na wafalme wao watakutumikia.","poem":2},{"text":"Ingawa katika hasira nilikupiga,","poem":1},{"text":"lakini katika upendeleo wangu","poem":2},{"lineBreak":true},{"text":"nitakuonesha huruma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Malango yako yatakuwa wazi siku zote,","poem":1},{"text":"kamwe hayatafungwa, mchana wala usiku,","poem":2},{"text":"ili watu wapate kukuletea utajiri wa mataifa:","poem":1},{"text":"wafalme wao wakiongoza maandamano ya ushindi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa maana taifa au ufalme ule ambao hautakutumikia utaangamia;","poem":1},{"text":"utaharibiwa kabisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Utukufu wa Lebanoni utakujilia,","poem":1},{"text":"msunobari, mvinje pamoja na mteashuri,","poem":2},{"text":"ili kupapamba mahali pangu patakatifu,","poem":1},{"text":"nami nitapatukuza mahali pa miguu yangu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wana wa wale waliokutesa watakuja wakisujudu mbele yako;","poem":1},{"text":"wote wanaokudharau watasujudu miguuni pako;","poem":2},{"text":"nao watakuita Mji wa Mwenyezi Mungu,","poem":1},{"text":"Sayuni ya Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Ingawa umeachwa na kuchukiwa,","poem":1},{"text":"bila yeyote anayesafiri ndani yako,","poem":2},{"text":"nitakufanya kuwa fahari ya milele,","poem":1},{"text":"na furaha ya vizazi vyote.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Utanyonya maziwa ya mataifa,","poem":1},{"text":"na kunyonyeshwa matiti ya wafalme.","poem":2},{"text":"Ndipo utakapojua kwamba Mimi, Mwenyezi Mungu,","poem":1},{"text":"ni Mwokozi wako, Mkombozi wako,","poem":2},{"lineBreak":true},{"text":"niliye Mwenye Nguvu wa Yakobo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Badala ya shaba nitakuletea dhahabu,","poem":1},{"text":"na fedha badala ya chuma.","poem":2},{"text":"Badala ya mti nitakuletea shaba,","poem":1},{"text":"na chuma badala ya mawe.","poem":2},{"text":"Nitafanya amani kuwa mtawala wako,","poem":1},{"text":"na haki kuwa mfalme wako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jeuri hazitasikika tena katika nchi yako,","poem":1},{"text":"wala maangamizi au uharibifu","poem":2},{"lineBreak":true},{"text":"ndani ya mipaka yako,","poem":2},{"text":"lakini utaita kuta zako Wokovu,","poem":1},{"text":"na malango yako Sifa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jua halitakuwa tena nuru yako mchana,","poem":1},{"text":"wala mwangaza wa mwezi hautakuangazia,","poem":2},{"text":"kwa maana Mwenyezi Mungu atakuwa nuru yako ya milele,","poem":1},{"text":"naye Mungu wako atakuwa utukufu wako.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Jua lako halitazama tena,","poem":1},{"text":"nao mwezi wako hautafifia tena;","poem":2},{"text":"Mwenyezi Mungu atakuwa nuru yako milele,","poem":1},{"text":"nazo siku zako za huzuni zitakoma.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndipo watu wako wote watakuwa waadilifu,","poem":1},{"text":"nao wataimiliki nchi milele.","poem":2},{"text":"Wao ni chipukizi nililolipanda,","poem":1},{"text":"kazi ya mikono yangu,","poem":2},{"lineBreak":true},{"text":"ili kuonesha utukufu wangu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Aliye mdogo kwenu atakuwa elfu,","poem":1},{"text":"mdogo kuliko wote atakuwa taifa lenye nguvu.","poem":2},{"text":"Mimi ndimi Mwenyezi Mungu;","poem":1},{"text":"katika wakati wake nitayatimiza haya upesi.”","poem":2}]}],"footnotes":[{"noteId":34,"caller":"+","text":"au: za biashara(taz. 1 Wafalme 10:22; 22:48; 2 Nyakati 9:21; 20:36; Isaya 2:16).","reference":{"chapter":60,"verse":9}}]},"thisChapterLink":"/api/swh_onmm/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}