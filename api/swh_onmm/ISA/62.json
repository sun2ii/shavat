ext":"nayo nchi yako itaitwa Beula","poem":2},{"noteId":36},{"text":",","poem":2},{"text":"kwa maana Mwenyezi Mungu atakufurahia,","poem":1},{"text":"nayo nchi yako itaolewa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kama vile kijana aoavyo mwanamwali,","poem":1},{"text":"ndivyo Mwashi wako atakavyokuoa","poem":2},{"noteId":37},{"text":";","poem":2},{"text":"kama bwana arusi amfurahiavyo bibi arusi wake,","poem":1},{"text":"ndivyo Mungu wako atakavyokufurahia wewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nimeweka walinzi juu ya kuta zako, ee Yerusalemu,","poem":1},{"text":"hawatanyamaza mchana wala usiku.","poem":2},{"text":"Ninyi wenye kumwita Mwenyezi Mungu,","poem":1},{"text":"msitulie,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"msimwache apumzike hadi atakapoufanya imara Yerusalemu","poem":1},{"text":"na kuufanya uwe sifa ya dunia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu ameapa kwa mkono wake wa kuume","poem":1},{"text":"na kwa mkono wake wenye nguvu:","poem":2},{"text":"“Kamwe sitawapa tena adui zenu","poem":1},{"text":"nafaka zenu kama chakula chao;","poem":2},{"text":"kamwe wageni hawatakunywa tena","poem":1},{"text":"divai mpya ambayo mmeitaabikia,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lakini wale waivunao nafaka wataila","poem":1},{"text":"na kumsifu Mwenyezi Mungu,","poem":2},{"text":"nao wale wakusanyao zabibu watainywa divai yake","poem":1},{"text":"katika nyua za patakatifu pangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Piteni, piteni katika malango!","poem":1},{"text":"Tengenezeni njia kwa ajili ya watu.","poem":2},{"text":"Jengeni, jengeni njia kuu!","poem":1},{"text":"Ondoeni mawe.","poem":2},{"text":"Inueni bendera kwa ajili ya mataifa.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu ametoa tangazo","poem":1},{"text":"hadi miisho ya dunia:","poem":2},{"text":"“Mwambie Binti Sayuni,","poem":1},{"text":"‘Tazama, mwokozi wako anakuja!","poem":2},{"text":"Tazama ujira wake uko pamoja naye,","poem":1},{"text":"na malipo yake yanafuatana naye!’ ”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wataitwa Watu Watakatifu,","poem":1},{"text":"Waliokombolewa na Mwenyezi Mungu;","poem":2},{"text":"nawe utaitwa Aliyetafutwa,","poem":1},{"text":"Mji Usioachwa Tena.","poem":2}]}],"footnotes":[{"noteId":35,"caller":"+","text":"maana yake Yeye ninayemfurahia","reference":{"chapter":62,"verse":4}},{"noteId":36,"caller":"+","text":"maana yake Aliyeolewa","reference":{"chapter":62,"verse":4}},{"noteId":37,"caller":"+","text":"au ndivyo wanao watakavyokuoa wewe","reference":{"chapter":62,"verse":5}}]},"thisChapterLink":"/api/swh_onmm/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}