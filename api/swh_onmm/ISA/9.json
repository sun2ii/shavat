{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ISA","translationId":"swh_onmm","name":"Isaya","commonName":"Isaya","title":"Isaya","order":23,"numberOfChapters":66,"sha256":"e3d236038d6313b8c16121b0b6f30493ed55e416dfe381a96b93babc536487f3","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/swh_onmm/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"heading","content":["Mtoto amezaliwa kwa ajili yetu"]},{"type":"verse","number":1,"content":["Hata hivyo, hakutakuwa huzuni tena kwa wale waliokuwa katika dhiki. Hapo awali aliidhili nchi ya Zabuloni na nchi ya Naftali, lakini katika siku zijazo ataipa heshima Galilaya ya Mataifa, karibu na njia ya bahari, ng’ambo ya Yordani:"]},{"type":"verse","number":2,"content":[{"text":"Watu wanaotembea katika giza","poem":1},{"text":"wameona nuru kuu,","poem":2},{"text":"wale wanaoishi katika nchi ya uvuli wa mauti,","poem":1},{"text":"nuru imewazukia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Umelikuza taifa,","poem":1},{"text":"na kuzidisha furaha yao,","poem":2},{"text":"wanafurahia mbele zako,","poem":1},{"text":"kama watu wanavyofurahia wakati wa mavuno,","poem":2},{"text":"kama mashujaa wanavyofurahia","poem":1},{"text":"wakigawanya nyara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kama vile siku ya kushindwa kwa Wamidiani,","poem":1},{"text":"umevunja nira iliyowalemea,","poem":2},{"text":"ile gongo mabegani mwao","poem":1},{"text":"na fimbo ya aliyewadhulumu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kila kiatu cha shujaa kilichotumiwa vitani,","poem":1},{"text":"na kila vazi lililovingirishwa katika damu","poem":2},{"text":"vitawekwa kwa ajili ya kuchomwa,","poem":1},{"text":"vitakuwa kuni za kuwasha moto.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa maana, kwa ajili yetu mtoto amezaliwa,","poem":1},{"text":"tumepewa mtoto wa kiume,","poem":2},{"lineBreak":true},{"text":"nao utawala utakuwa begani mwake.","poem":2},{"text":"Naye ataitwa","poem":1},{"text":"Mshauri wa Ajabu, Mungu Mwenye Nguvu,","poem":2},{"lineBreak":true},{"text":"Baba wa Milele, Mfalme wa Amani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kuongezeka kwa utawala wake na amani","poem":1},{"text":"hakutakuwa na mwisho.","poem":2},{"text":"Atatawala kwenye kiti cha utawala cha Daudi","poem":1},{"text":"na juu ya ufalme wake,","poem":2},{"text":"akiuthibitisha na kuutegemeza","poem":1},{"text":"kwa haki na kwa adili,","poem":2},{"lineBreak":true},{"text":"tangu wakati huo na hata milele.","poem":2},{"text":"Wivu wa Mwenyezi Mungu, Mungu wa majeshi ya mbinguni","poem":1},{"text":"utatimiza haya.","poem":2}]},{"type":"heading","content":["Hasira ya Mwenyezi Mungu dhidi ya Israeli"]},{"type":"verse","number":8,"content":[{"text":"Bwana ametuma ujumbe dhidi ya Yakobo,","poem":1},{"text":"utamwangukia Israeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Watu wote watajua hili:","poem":1},{"text":"Efraimu na wakazi wa Samaria,","poem":2},{"text":"wanaosema kwa kiburi","poem":1},{"text":"na majivuno ya mioyo,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“Matofali yameanguka chini,","poem":1},{"text":"lakini tutajenga tena kwa mawe yaliyochongwa,","poem":2},{"text":"mikuyu imekatwa,","poem":1},{"text":"na tutapanda mierezi badala yake.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Lakini Mwenyezi Mungu amemtia nguvu adui wa Resini dhidi yao","poem":1},{"text":"na kuchochea watesi wao.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Waaramu kutoka upande wa mashariki","poem":1},{"text":"na Wafilisti kutoka upande wa magharibi","poem":2},{"lineBreak":true},{"text":"wameila Israeli kwa kinywa kilichopanuliwa.","poem":2},{"lineBreak":true},{"text":"Hata kwa haya yote, hasira yake haijageukia mbali,","poem":1},{"text":"mkono wake bado umeinuliwa juu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini watu hawajamrudia yeye aliyewapiga,","poem":1},{"text":"wala hawajamtafuta Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"Mungu wa majeshi ya mbinguni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa hiyo Mwenyezi Mungu atakatilia mbali kutoka Israeli kichwa na mkia,","poem":1},{"text":"tawi la mtende na tete katika siku moja.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wazee na watu mashuhuri ndio vichwa,","poem":1},{"text":"nao manabii wanaofundisha uongo ndio mkia.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wale wanaowaongoza watu hawa wanawapotosha,","poem":1},{"text":"nao wale wanaoongozwa wamepotoka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwa hiyo Bwana hatawafurahia vijana,","poem":1},{"text":"wala hatawahurumia yatima na wajane,","poem":2},{"text":"kwa kuwa kila mmoja wao hamchi Mungu, nao ni waovu,","poem":1},{"text":"na kila kinywa kinanena upumbavu.","poem":2},{"lineBreak":true},{"text":"Hata kwa haya yote, hasira yake haijageukia mbali,","poem":1},{"text":"mkono wake bado umeinuliwa juu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hakika uovu huwaka kama moto;","poem":1},{"text":"huteketeza michongoma na miiba,","poem":2},{"text":"huwasha moto vichaka vya msituni,","poem":1},{"text":"hujiviringisha kuelekea juu kama nguzo ya moshi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kwa hasira ya Mwenyezi Mungu, Mungu wa majeshi ya mbinguni","poem":1},{"text":"nchi itachomwa kwa moto,","poem":2},{"text":"nao watu watakuwa kuni za kuchochea moto.","poem":1},{"text":"Hakuna mtu atakayemhurumia ndugu yake.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Upande wa kuume watakuwa wakitafuna,","poem":1},{"text":"lakini bado wataona njaa;","poem":2},{"text":"upande wa kushoto watakuwa wakila,","poem":1},{"text":"lakini hawatashiba.","poem":2},{"text":"Kila mmoja atajilisha kwa nyama ya uzao wake mwenyewe:","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Manase atamla Efraimu,","poem":2},{"lineBreak":true},{"text":"naye Efraimu atamla Manase;","poem":2},{"lineBreak":true},{"text":"nao pamoja watakuwa kinyume na Yuda.","poem":2},{"lineBreak":true},{"text":"Hata kwa haya yote, hasira yake haijageukia mbali,","poem":1},{"text":"mkono wake bado umeinuliwa juu.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}