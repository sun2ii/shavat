{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_onmm","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"61deebf475b7135768e2a244a1aed945373957704c024a1e7b4163b253b28fde","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_onmm/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["Lalamiko la Yeremia"]},{"type":"verse","number":1,"content":[{"text":"Wewe daima u mwenye haki, Ee Mwenyezi Mungu,","poem":1},{"text":"niletapo mashtaka mbele yako.","poem":2},{"text":"Hata hivyo nitazungumza nawe kuhusu hukumu yako:","poem":1},{"text":"Kwa nini njia ya waovu inafanikiwa?","poem":2},{"text":"Kwa nini wasio waaminifu","poem":1},{"text":"wote wanaishi salama?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umewapanda, nao wameota,","poem":1},{"text":"wanakua na kuzaa matunda.","poem":2},{"text":"Daima u midomoni mwao,","poem":1},{"text":"lakini mbali na mioyo yao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hata hivyo unanijua mimi, Ee Mwenyezi Mungu;","poem":1},{"text":"unaniona na kuyachunguza mawazo yangu kukuhusu wewe.","poem":2},{"text":"Wakokote kama kondoo wanaoenda kuchinjwa!","poem":1},{"text":"Watenge kwa ajili ya siku ya kuchinjwa!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Je, nchi itakaa katika hali ya kuomboleza hadi lini,","poem":1},{"text":"na majani katika kila shamba kunyauka?","poem":2},{"text":"Kwa sababu wale wanaoishi ndani yake ni waovu,","poem":1},{"text":"wanyama na ndege wameangamia.","poem":2},{"text":"Zaidi ya hayo, watu wanasema,","poem":1},{"text":"“Mwenyezi Mungu hataona yatakayotupata sisi.”","poem":2}]},{"type":"heading","content":["Jibu la Mwenyezi Mungu"]},{"type":"verse","number":5,"content":[{"text":"“Ikiwa umeshindana mbio na watu kwa mguu na wakakushinda,","poem":1},{"text":"unawezaje kushindana na farasi?","poem":2},{"text":"Ikiwa unajikwaa kwenye nchi ambayo ni salama,","poem":1},{"text":"utawezaje kwenye vichaka kando ya Yordani?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ndugu zako na jamaa zako nao wamekusaliti,","poem":1},{"text":"wameinua kilio kikubwa dhidi yako.","poem":2},{"text":"Usiwaamini hata wakisema","poem":1},{"text":"mema juu yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Nitaiacha nyumba yangu,","poem":1},{"text":"nitupe urithi wangu;","poem":2},{"text":"nitamtia yeye nimpendaye","poem":1},{"text":"mikononi mwa adui zake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Urithi wangu umekuwa kwangu","poem":1},{"text":"kama simba wa msituni.","poem":2},{"text":"Nauchukia kwa kuwa","poem":1},{"text":"unaningurumia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, urithi wangu haukuwa","poem":1},{"text":"kama ndege wa mawindo wa madoadoa","poem":2},{"text":"ambaye ndege wengine wawindao","poem":1},{"text":"humzunguka na kumshambulia?","poem":2},{"text":"Nenda ukawakusanye pamoja wanyama wote wa mwituni;","poem":1},{"text":"walete ili wale.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wachungaji wengi wataliharibu shamba langu la mizabibu","poem":1},{"text":"na kulikanyaga shamba langu;","poem":2},{"text":"watalifanya shamba langu zuri","poem":1},{"text":"kuwa jangwa la ukiwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Litafanywa kuwa jangwa,","poem":1},{"text":"lililokauka na kuachwa ukiwa mbele zangu;","poem":2},{"text":"nchi yote itafanywa jangwa","poem":1},{"text":"kwa sababu hakuna hata mmoja anayejali.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Juu ya miinuko yote ilivyo kama jangwani","poem":1},{"text":"waangamizi watavamia,","poem":2},{"text":"kwa maana upanga wa Mwenyezi Mungu utawala,","poem":1},{"text":"kuanzia ncha moja ya nchi hadi nyingine;","poem":2},{"lineBreak":true},{"text":"hakuna hata mmoja atakayekuwa salama.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Watapanda ngano lakini watavuna miiba;","poem":1},{"text":"watajitaabisha lakini hawatafaidi chochote.","poem":2},{"text":"Kwa hiyo beba aibu ya mavuno yako","poem":1},{"text":"kwa sababu ya hasira kali ya Mwenyezi Mungu.”","poem":2}]},{"type":"verse","number":14,"content":["Hili ndilo asemalo Mwenyezi Mungu: “Kwa habari ya majirani zangu wote wabaya wanaonyang’anya urithi ambao ninawapa watu wangu Israeli, nitawang’oa kutoka nchi zao, nami nitaing’oa nyumba ya Yuda kutoka katikati yao."]},{"type":"verse","number":15,"content":["Lakini baada ya kuwang’oa, nitawahurumia tena na kumrudisha kila mmoja wao kwenye urithi wake mwenyewe na kwenye nchi yake mwenyewe."]},{"type":"verse","number":16,"content":["Ikiwa watajifunza vyema njia za watu wangu na kuapa kwa Jina langu, wakisema, ‘Hakika kama Mwenyezi Mungu aishivyo,’ hata kama wakati fulani walifundisha watu wangu kuapa kwa Baali, ndipo watafanywa imara katikati ya watu wangu."]},{"type":"verse","number":17,"content":["Lakini kama taifa lolote halitasikiliza na kutii, nitaling’oa kabisa na kuliangamiza,” asema Mwenyezi Mungu."]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}