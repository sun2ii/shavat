{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_onmm","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"61deebf475b7135768e2a244a1aed945373957704c024a1e7b4163b253b28fde","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_onmm/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["Ujumbe kuhusu Wafilisti"]},{"type":"verse","number":1,"content":["Hili ndilo neno la Mwenyezi Mungu lililomjia nabii Yeremia kuhusu Wafilisti, kabla Farao hajaishambulia Gaza:"]},{"type":"verse","number":2,"content":["Hili ndilo asemalo Mwenyezi Mungu:",{"text":"“Tazama jinsi maji yanavyoinuka huko kaskazini,","poem":1},{"text":"yatakuwa mafuriko yenye nguvu sana.","poem":2},{"text":"Yataifurikia nchi na vitu vyote vilivyo ndani yake,","poem":1},{"text":"miji na wanaoishi ndani yake.","poem":2},{"text":"Watu watapiga kelele;","poem":1},{"text":"wote wanaoishi katika nchi wataomboleza","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwa sauti ya kwato za farasi wanaoenda mbio,","poem":1},{"text":"kwa sauti ya magari ya vita ya adui,","poem":2},{"lineBreak":true},{"text":"na mngurumo wa magurudumu yake.","poem":2},{"text":"Baba hawatageuka kuwasaidia watoto wao,","poem":1},{"text":"mikono yao italegea.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa maana siku imewadia","poem":1},{"text":"kuwaangamiza Wafilisti wote","poem":2},{"text":"na kuwakatilia mbali walionusurika wote","poem":1},{"text":"ambao wangeweza kusaidia Tiro na Sidoni.","poem":2},{"text":"Mwenyezi Mungu anakaribia kuwaangamiza Wafilisti,","poem":1},{"text":"mabaki toka pwani za Kaftori","poem":2},{"noteId":25},{"text":".","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Gaza atanyoa kichwa chake katika kuomboleza,","poem":1},{"text":"Ashkeloni atanyamazishwa.","poem":2},{"text":"Enyi mabaki kwenye tambarare,","poem":1},{"text":"mtajikatakata wenyewe hadi lini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Mnalia, ‘Aa, upanga wa Mwenyezi Mungu,","poem":1},{"text":"utaendelea hadi lini ndipo upumzike?","poem":2},{"text":"Rudi ndani ya ala yako;","poem":1},{"text":"acha na utulie.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lakini upanga utatuliaje","poem":1},{"text":"wakati Mwenyezi Mungu ameuamuru,","poem":2},{"text":"wakati ameuagiza kuishambulia Ashkeloni","poem":1},{"text":"pamoja na pwani yake?”","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"yaani Krete","reference":{"chapter":47,"verse":4}}]},"thisChapterLink":"/api/swh_onmm/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}