{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_onmm","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"61deebf475b7135768e2a244a1aed945373957704c024a1e7b4163b253b28fde","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_onmm/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["Ujumbe kuhusu Moabu"]},{"type":"verse","number":1,"content":["Kuhusu Moabu:",{"lineBreak":true},"Hili ndilo Mwenyezi Mungu, Mungu wa majeshi ya mbinguni, Mungu wa Israeli, asemalo:",{"text":"“Ole wake Nebo, kwa maana utaharibiwa.","poem":1},{"text":"Kiriathaimu utaaibishwa na kutekwa;","poem":2},{"lineBreak":true},{"text":"Misgabu itaaibishwa na kuvunjavunjwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Moabu haitasifiwa tena;","poem":1},{"text":"huko Heshboni watu watapanga jinsi ya kumwangusha:","poem":2},{"lineBreak":true},{"text":"‘Njooni na tuliangamize taifa lile.’","poem":2},{"text":"Wewe nawe, ee Madmena, utanyamazishwa;","poem":1},{"text":"upanga utakufuatia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sikiliza kilio kutoka Horonaimu,","poem":1},{"text":"kilio cha maangamizi makuu na uharibifu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moabu utavunjwa,","poem":1},{"text":"wadogo wake watapiga kelele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wanapanda kwenda njia ya kuelekea Luhithi,","poem":1},{"text":"wakilia kwa uchungu wanapotembea,","poem":2},{"text":"kwenye njia inayoshuka kwenda Horonaimu,","poem":1},{"text":"kilio cha uchungu kwa ajili ya uharibifu kinasikika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kimbieni! Okoeni maisha yenu,","poem":1},{"text":"kuweni kama kichaka jangwani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa kuwa mmetumainia matendo yenu na mali yenu,","poem":1},{"text":"ninyi pia mtachukuliwa mateka,","poem":2},{"text":"naye Kemoshi","poem":1},{"noteId":26},{"text":"ataenda uhamishoni,","poem":1},{"text":"pamoja na makuhani wake na maafisa wake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwangamizi atakuja dhidi ya kila mji,","poem":1},{"text":"wala hakuna mji utakaookoka.","poem":2},{"text":"Bonde litaangamizwa na uwanda utaharibiwa,","poem":1},{"text":"kwa sababu Mwenyezi Mungu amesema.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wekeni chumvi kwa ajili ya Moabu,","poem":1},{"text":"kwa kuwa ataangamizwa;","poem":2},{"text":"miji yake itakuwa ukiwa,","poem":1},{"text":"hakutakuwa na mtu atakayeishi ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Alaaniwe yeye afanyaye kazi ya Mwenyezi Mungu kwa ulegevu!","poem":1},{"text":"Alaaniwe yeye auzuiaye upanga wake usimwage damu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Moabu amestarehe tangu ujana wake,","poem":1},{"text":"kama divai iliyoachwa kwenye machujo yake,","poem":2},{"text":"haikumiminwa kutoka chombo kimoja hadi kingine,","poem":1},{"text":"hajaenda uhamishoni.","poem":2},{"text":"Kwa hiyo ana ladha ile ile kama aliyokuwa nayo,","poem":1},{"text":"nayo harufu yake haijabadilika.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini siku zinakuja,”","poem":1},{"text":"asema Mwenyezi Mungu,","poem":2},{"text":"“nitakapotuma watu wamiminao kutoka magudulia,","poem":1},{"text":"nao watamimina;","poem":2},{"text":"wataacha magudulia yake yakiwa matupu","poem":1},{"text":"na kuvunja mitungi yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kisha Moabu atamwonea aibu Kemoshi,","poem":1},{"text":"kama vile nyumba ya Israeli walivyoona aibu","poem":2},{"lineBreak":true},{"text":"walipotegemea Betheli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mwawezaje kusema, ‘Sisi ni mashujaa,","poem":1},{"text":"watu hodari katika vita’?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Moabu ataangamizwa na miji yake itavamiwa,","poem":1},{"text":"vijana wake wa kiume walio bora sana watachinjwa,”","poem":2},{"text":"asema Mfalme, ambaye jina lake","poem":1},{"text":"ni Mwenyezi Mungu, Mungu wa majeshi ya mbinguni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“Kuanguka kwa Moabu kumekaribia,","poem":1},{"text":"janga kubwa litamjia kwa haraka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ombolezeni kwa ajili yake, ninyi nyote mnaomzunguka,","poem":1},{"text":"ninyi nyote mnaojua sifa zake,","poem":2},{"text":"semeni, ‘Tazama jinsi ilivyovunjika","poem":1},{"text":"fimbo ya kifalme yenye nguvu,","poem":2},{"text":"tazama jinsi ilivyovunjika","poem":1},{"text":"fimbo iliyotukuka!’","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Shuka kutoka fahari yako","poem":1},{"text":"uketi katika ardhi iliyokauka,","poem":2},{"lineBreak":true},{"text":"enyi wenyeji wa Binti Diboni,","poem":2},{"text":"kwa maana yeye aangamizaye Moabu","poem":1},{"text":"atakuja dhidi yako,","poem":2},{"lineBreak":true},{"text":"na kuangamiza miji yako yenye ngome.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Simama kando ya barabara na utazame,","poem":1},{"text":"wewe unayeishi Aroeri.","poem":2},{"text":"Muulize mwanaume anayekimbia","poem":1},{"text":"na mwanamke anayetoroka,","poem":2},{"lineBreak":true},{"text":"waulize, ‘Kumetokea nini?’","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Moabu amefedheheshwa, kwa kuwa amevunjavunjwa.","poem":1},{"text":"Lieni kwa huzuni na kupiga kelele!","poem":2},{"text":"Tangazeni kando ya Mto Arnoni","poem":1},{"text":"kwamba Moabu ameangamizwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Hukumu imefika kwenye uwanda wa juu:","poem":1},{"text":"katika Holoni, Yahasa na Mefaathi,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"katika Diboni, Nebo","poem":1},{"text":"na Beth-Diblathaimu,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"katika Kiriathaimu, Beth-Gamuli","poem":1},{"text":"na Beth-Meoni,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"katika Keriothi na Bosra;","poem":1},{"text":"kwa miji yote ya Moabu,","poem":2},{"lineBreak":true},{"text":"iliyo mbali na karibu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Pembe","poem":1},{"noteId":27},{"text":"ya Moabu imekatwa,","poem":1},{"text":"mkono wake umevunjwa,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“Mleweshe,","poem":1},{"text":"kwa kuwa amemdharau Mwenyezi Mungu.","poem":2},{"text":"Moabu atagaagaa katika matapishi yake,","poem":1},{"text":"awe kichekesho.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Je, Israeli hakuwa kitu chako cha kudhihakiwa?","poem":1},{"text":"Je, alikamatwa miongoni mwa wezi,","poem":2},{"text":"kiasi cha kutikisa kichwa chako kwa dharau","poem":1},{"text":"kila mara unapozungumza juu yake?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ondokeni miji yenu, mkaishi katikati ya miamba,","poem":1},{"text":"enyi mnaoishi Moabu.","poem":2},{"text":"Kuweni kama njiwa ambaye hutengeneza kiota chake","poem":1},{"text":"kwenye mlango wa pango.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Tumesikia kuhusu kiburi cha Moabu:","poem":1},{"text":"kutakabari kwake kwa kiburi na majivuno,","poem":2},{"text":"kiburi chake na ufidhuli wake,","poem":1},{"text":"na kujivuna kwa moyo wake.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ninaujua ujeuri wake, lakini ni bure,”","poem":1},{"text":"asema Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"“nako kujisifu kwake hakumsaidii chochote.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kwa hiyo namlilia Moabu,","poem":1},{"text":"kwa ajili ya Moabu yote ninalia,","poem":2},{"text":"ninaomboleza kwa ajili","poem":1},{"text":"ya watu wa Kir-Haresethi.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Ninalia machozi kwa ajili yenu, kama Yazeri aliavyo,","poem":1},{"text":"enyi mizabibu ya Sibma.","poem":2},{"text":"Matawi yako yameenea hadi baharini;","poem":1},{"text":"yamefika hadi bahari ya Yazeri.","poem":2},{"text":"Mwangamizi ameyaangukia","poem":1},{"text":"matunda yako yaliyoiva","poem":2},{"lineBreak":true},{"text":"na mizabibu yako iliyoiva.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Shangwe na furaha vimetoweka","poem":1},{"text":"kutoka bustani na mashamba ya Moabu.","poem":2},{"text":"Nimekomesha kutiririka kwa divai kutoka mashinikizo;","poem":1},{"text":"hakuna hata mmoja ayakanyagaye kwa kelele za shangwe.","poem":2},{"text":"Ingawa kuna kelele,","poem":1},{"text":"sio kelele za shangwe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“Sauti ya kilio chao inapanda","poem":1},{"text":"kutoka Heshboni hadi Eleale na Yahazi,","poem":2},{"text":"kutoka Soari hadi Horonaimu na Eglath-Shelishiya,","poem":1},{"text":"kwa kuwa hata maji ya Nimrimu yamekauka.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Nitakomesha wote katika Moabu","poem":1},{"text":"watoao sadaka mahali pa juu pa kuabudia,","poem":2},{"lineBreak":true},{"text":"na kufukiza uvumba kwa miungu yao,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“Kwa hiyo moyo wangu unaomboleza kwa ajili ya Moabu kama filimbi;","poem":1},{"text":"unaomboleza kama filimbi kwa ajili ya watu wa Kir-Haresethi.","poem":2},{"lineBreak":true},{"text":"Utajiri waliojipatia umetoweka.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Kila kichwa kimenyolewa","poem":1},{"text":"na kila mwenye ndevu zimekatwa;","poem":2},{"text":"kila mkono umekatwa","poem":1},{"text":"na kila kiuno kimevalishwa gunia.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Juu ya mapaa yote katika Moabu","poem":1},{"text":"na katika viwanja","poem":2},{"text":"hakuna kitu isipokuwa maombolezo,","poem":1},{"text":"kwa kuwa nimemvunja Moabu","poem":2},{"lineBreak":true},{"text":"kama gudulia lisilotakiwa na mtu yeyote,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“Tazama jinsi alivyovunjikavunjika!","poem":1},{"text":"Jinsi wanavyolia kwa huzuni!","poem":2},{"text":"Tazama jinsi Moabu anavyogeuka kwa aibu!","poem":1},{"text":"Moabu amekuwa kitu cha kudhihakiwa,","poem":2},{"text":"kitu cha kutisha kwa wale wote","poem":1},{"text":"wanaomzunguka.”","poem":2}]},{"type":"verse","number":40,"content":["Hili ndilo asemalo Mwenyezi Mungu:",{"text":"“Tazama! Tai anashuka chini,","poem":1},{"text":"akitanda mabawa yake juu ya Moabu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Miji itatekwa na ngome zake","poem":1},{"text":"zitatwaliwa.","poem":2},{"text":"Katika siku hiyo, mioyo ya mashujaa wa Moabu","poem":1},{"text":"itakuwa kama moyo wa mwanamke katika uchungu wa kuzaa.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Moabu ataangamizwa kama taifa","poem":1},{"text":"kwa sababu amemdharau Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Hofu kuu, shimo na mtego vinawangojea,","poem":1},{"text":"enyi watu wa Moabu,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“Yeyote atakayeikimbia hiyo hofu kuu","poem":1},{"text":"ataanguka ndani ya shimo,","poem":2},{"text":"yeyote atakayepanda kutoka shimoni,","poem":1},{"text":"atanaswa katika mtego,","poem":2},{"text":"kwa sababu nitailetea Moabu","poem":1},{"text":"mwaka wa adhabu yake,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“Katika kivuli cha Heshboni,","poem":1},{"text":"wakimbizi wamesimama pasipo msaada,","poem":2},{"text":"kwa kuwa moto umezimika huko Heshboni,","poem":1},{"text":"Mwali wa moto kutoka katikati ya Sihoni;","poem":2},{"text":"unaunguza paji za nyuso za Wamoabu,","poem":1},{"text":"mafuvu ya wanaojivuna kwa kelele.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Ole wako, ee Moabu!","poem":1},{"text":"Watu wa Kemoshi wameangamizwa;","poem":2},{"text":"watoto wako wa kiume wamepelekwa uhamishoni,","poem":1},{"text":"na binti zako wamechukuliwa mateka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“Lakini nitarudisha mateka wa Moabu,","poem":1},{"text":"katika siku zijazo,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2},"Huu ndio mwisho wa hukumu ya Moabu."]}],"footnotes":[{"noteId":26,"caller":"+","text":"mungu wa Wamoabu","reference":{"chapter":48,"verse":7}},{"noteId":27,"caller":"+","text":"pembe inawakilisha nguvu","reference":{"chapter":48,"verse":25}}]},"thisChapterLink":"/api/swh_onmm/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}