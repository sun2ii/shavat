{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_onmm","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"61deebf475b7135768e2a244a1aed945373957704c024a1e7b4163b253b28fde","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_onmm/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["Ujumbe kuhusu Babeli"]},{"type":"verse","number":1,"content":["Hili ndilo neno alilosema Mwenyezi Mungu kupitia nabii Yeremia kuhusu Babeli na nchi ya Wakaldayo:"]},{"type":"verse","number":2,"content":[{"text":"“Tangazeni! Hubirini katikati ya mataifa,","poem":1},{"text":"Inueni bendera na mkahubiri;","poem":2},{"lineBreak":true},{"text":"msiache kitu chochote, bali semeni,","poem":2},{"text":"‘Babeli utatekwa;","poem":1},{"text":"Beli ataaibishwa,","poem":2},{"lineBreak":true},{"text":"Merodaki atajazwa na hofu kuu.","poem":2},{"text":"Sanamu zake zitaaibishwa","poem":1},{"text":"na vinyago vyake vitajazwa hofu kuu.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Taifa kutoka kaskazini litamshambulia,","poem":1},{"text":"na kuifanya nchi yake ukiwa.","poem":2},{"text":"Hakuna atakayeishi ndani yake,","poem":1},{"text":"watu na wanyama wataikimbia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Katika siku hizo, wakati huo,”","poem":1},{"text":"asema Mwenyezi Mungu,","poem":2},{"text":"“watu wa Israeli pamoja na watu wa Yuda","poem":1},{"text":"wataenda wakilia ili kumtafuta Mwenyezi Mungu, Mungu wao.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wataulizia njia iendayo Sayuni","poem":1},{"text":"na kuelekeza nyuso zao huko.","poem":2},{"text":"Watakuja na kuambatana na Mwenyezi Mungu","poem":1},{"text":"katika agano la milele","poem":2},{"lineBreak":true},{"text":"ambalo halitasahaulika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Watu wangu wamekuwa kondoo waliopotea;","poem":1},{"text":"wachungaji wao wamewapotosha","poem":2},{"lineBreak":true},{"text":"na kuwafanya wazurure mlimani.","poem":2},{"text":"Walitangatanga juu ya mlima na kilima,","poem":1},{"text":"na kusahau mahali pao pa kupumzikia.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeyote aliyewakuta aliwala;","poem":1},{"text":"adui zao walisema, ‘Sisi hatuna hatia,","poem":2},{"text":"kwa kuwa wao walitenda dhambi dhidi ya","poem":1},{"text":"Mwenyezi Mungu, malisho yao halisi,","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu, aliye tumaini la baba zao.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kimbieni kutoka Babeli;","poem":1},{"text":"ondokeni katika nchi ya Wakaldayo,","poem":2},{"lineBreak":true},{"text":"kuweni kama mbuzi wale waongozao kundi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa maana nitaamsha na kuleta dhidi ya Babeli","poem":1},{"text":"muungano wa mataifa makubwa kutoka nchi ya kaskazini.","poem":2},{"text":"Watashika nafasi zao dhidi yake,","poem":1},{"text":"naye kutokea kaskazini atatekwa.","poem":2},{"text":"Mishale yao itakuwa kama mishale ya mashujaa walio hodari,","poem":1},{"text":"ambao hawawezi kurudi mikono mitupu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa hiyo Ukaldayo utatekwa nyara;","poem":1},{"text":"wote wanaouteka, watapata nyara za kutosha,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kwa sababu hushangilia na kufurahi,","poem":1},{"text":"wewe utekaye urithi wangu,","poem":2},{"text":"kwa sababu unachezacheza kama mtamba anayepura nafaka,","poem":1},{"text":"na kulia kama farasi dume,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"mama yako ataaibika mno,","poem":1},{"text":"yeye aliyekuzaa atatahayari.","poem":2},{"text":"Atakuwa mdogo kuliko mataifa mengine yote,","poem":1},{"text":"atakuwa nyika, nchi kame na jangwa.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa sababu ya hasira ya Mwenyezi Mungu hatakaliwa na mtu,","poem":1},{"text":"lakini ataachwa ukiwa kabisa.","poem":2},{"text":"Wote watakaopita Babeli watatiwa hofu na kudhihaki","poem":1},{"text":"kwa sababu ya majeraha yake yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Shikeni nafasi zenu kuzunguka Babeli,","poem":1},{"text":"enyi nyote mvutao upinde.","poem":2},{"text":"Mpigeni! Msibakize mshale wowote,","poem":1},{"text":"kwa kuwa ametenda dhambi dhidi ya Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Piga kelele dhidi yake kila upande!","poem":1},{"text":"Anajisalimisha, minara yake inaanguka,","poem":2},{"lineBreak":true},{"text":"kuta zake zimebomoka.","poem":2},{"text":"Kwa kuwa hiki ni kisasi cha Mwenyezi Mungu,","poem":1},{"text":"mlipizeni kisasi;","poem":2},{"lineBreak":true},{"text":"mtendeeni kama alivyowatendea wengine.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Katilieni mbali mpanzi kutoka Babeli,","poem":1},{"text":"pamoja na mvunaji na mundu wake akivuna.","poem":2},{"text":"Kwa sababu ya upanga wa mdhalimu","poem":1},{"text":"kila mmoja na arejee kwa watu wake mwenyewe,","poem":2},{"text":"kila mmoja na akimbilie","poem":1},{"text":"kwenye nchi yake mwenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Israeli ni kundi lililotawanyika","poem":1},{"text":"ambalo simba wamelifukuzia mbali.","poem":2},{"text":"Wa kwanza kumla alikuwa mfalme wa Ashuru,","poem":1},{"text":"wa mwisho kuponda mifupa yake","poem":2},{"lineBreak":true},{"text":"alikuwa Nebukadneza mfalme wa Babeli.”","poem":2}]},{"type":"verse","number":18,"content":["Kwa hiyo hili ndilo Mwenyezi Mungu, Mungu wa majeshi ya mbinguni, Mungu wa Israeli, asemalo:",{"text":"“Nitamwadhibu mfalme wa Babeli na nchi yake","poem":1},{"text":"kama nilivyomwadhibu mfalme wa Ashuru.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lakini nitamrudisha Israeli katika malisho yake mwenyewe","poem":1},{"text":"naye atalisha huko Karmeli na Bashani;","poem":2},{"text":"njaa yake itashibishwa","poem":1},{"text":"juu ya vilima vya Efraimu na Gileadi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Katika siku hizo, wakati huo,”","poem":1},{"text":"asema Mwenyezi Mungu,","poem":2},{"text":"“uchunguzi utafanyika kwa ajili ya kosa la Israeli,","poem":1},{"text":"lakini halitaonekana,","poem":2},{"text":"na kwa ajili ya dhambi za Yuda,","poem":1},{"text":"lakini haitapatikana hata moja,","poem":2},{"text":"kwa kuwa nitawasamehe","poem":1},{"text":"mabaki nitakaowaacha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Shambulieni nchi ya Merathaimu","poem":1},{"text":"na wale wanaoishi huko Pekodi.","poem":2},{"text":"Wafuatieni, waueni","poem":1},{"text":"na kuwaangamiza kabisa,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2},{"lineBreak":true},{"text":"“Fanyeni kila kitu nilichowaamuru.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kelele ya vita iko ndani ya nchi,","poem":1},{"text":"kelele ya maangamizi makuu!","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Tazama jinsi nyundo ya dunia yote","poem":1},{"text":"ilivyovunjika na kuharibika!","poem":2},{"text":"Tazama jinsi Babeli ilivyokuwa ukiwa","poem":1},{"text":"miongoni mwa mataifa!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nimetega mtego kwa ajili yako, ee Babeli,","poem":1},{"text":"nawe ukakamatwa kabla hujafahamu;","poem":2},{"text":"ulipatikana na ukakamatwa","poem":1},{"text":"kwa sababu ulimpinga Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mwenyezi Mungu amefungua ghala lake la silaha","poem":1},{"text":"na kuzitoa silaha za ghadhabu yake,","poem":2},{"text":"kwa kuwa Bwana Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni,","poem":2},{"lineBreak":true},{"text":"anayo kazi ya kufanya","poem":2},{"lineBreak":true},{"text":"katika nchi ya Wakaldayo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Njooni dhidi yake kutoka mbali.","poem":1},{"text":"Zifungueni ghala zake za nafaka;","poem":2},{"lineBreak":true},{"text":"mlundikeni kama lundo la nafaka.","poem":2},{"text":"Mwangamizeni kabisa","poem":1},{"text":"na msimwachie mabaki yoyote.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Waueni mafahali wake wachanga wote;","poem":1},{"text":"waacheni washuke machinjoni!","poem":2},{"text":"Ole wao! Kwa kuwa siku yao imewadia,","poem":1},{"text":"wakati wao wa kuadhibiwa.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wasikilizeni watoro na wakimbizi kutoka Babeli","poem":1},{"text":"wakitangaza katika Sayuni","poem":2},{"text":"jinsi Mwenyezi Mungu, Mungu wetu","poem":1},{"text":"alivyolipiza kisasi,","poem":2},{"lineBreak":true},{"text":"kisasi kwa ajili ya Hekalu lake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“Waiteni wapiga mishale dhidi ya Babeli,","poem":1},{"text":"wote wavutao upinde.","poem":2},{"text":"Pigeni kambi kumzunguka kabisa,","poem":1},{"text":"asitoroke mtu yeyote.","poem":2},{"text":"Mlipizeni kwa matendo yake;","poem":1},{"text":"mtendeeni kama alivyotenda.","poem":2},{"text":"Kwa kuwa alimdharau Mwenyezi Mungu,","poem":1},{"text":"yeye Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kwa hiyo, vijana wake wanaume wataanguka barabarani;","poem":1},{"text":"askari wake wote watanyamazishwa siku ile,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“Tazama, niko kinyume nawe, ewe mwenye majivuno,”","poem":1},{"text":"asema Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":2},{"text":"“kwa kuwa siku yako imewadia,","poem":1},{"text":"yaani wakati wako wa kuadhibiwa.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mwenye majivuno atajikwaa na kuanguka,","poem":1},{"text":"wala hakuna yeyote atakayemuinua;","poem":2},{"text":"nitawasha moto katika miji yake,","poem":1},{"text":"utakaowateketeza wote wanaomzunguka.”","poem":2}]},{"type":"verse","number":33,"content":["Hili ndilo asemalo Mwenyezi Mungu, Mungu wa majeshi ya mbinguni:",{"text":"“Watu wa Israeli wamedhulumiwa,","poem":1},{"text":"hata watu wa Yuda pia.","poem":2},{"text":"Wote waliowateka wamewashikilia sana,","poem":1},{"text":"wanakataa kuwaachia waende.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Lakini Mkombozi wao ana nguvu;","poem":1},{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni ndilo jina lake.","poem":2},{"text":"Atatetea shauri lao kwa nguvu","poem":1},{"text":"ili alete amani nchini mwao,","poem":2},{"text":"lakini ataleta msukosuko","poem":1},{"text":"kwa wale wanaoishi Babeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"“Upanga dhidi ya Wakaldayo!”","poem":1},{"text":"asema Mwenyezi Mungu,","poem":2},{"text":"“dhidi ya wale wanaoishi Babeli,","poem":1},{"text":"na dhidi ya maafisa wake na wenye busara!","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Upanga dhidi ya manabii wake wa uongo!","poem":1},{"text":"Watakuwa wapumbavu.","poem":2},{"text":"Upanga dhidi ya mashujaa wake!","poem":1},{"text":"Watajazwa na hofu kuu","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Upanga dhidi ya farasi na magari yake ya vita","poem":1},{"text":"pamoja na askari wake wote wa kigeni katika safu zake!","poem":2},{"lineBreak":true},{"text":"Wao watakuwa kama wanawake.","poem":2},{"text":"Upanga dhidi ya hazina zake!","poem":1},{"text":"Hizo zitatekwa nyara.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Ukame juu ya maji yake!","poem":1},{"text":"Nayo yatakauka.","poem":2},{"text":"Kwa kuwa ni nchi ya sanamu,","poem":1},{"text":"wao wanaenda wazimu kwa ajili ya sanamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“Kwa hiyo, viumbe vya jangwani na fisi wataishi humo,","poem":1},{"text":"nao bundi watakaa humo.","poem":2},{"text":"Kamwe haitakaliwa tena","poem":1},{"text":"wala watu hawataishi humo kizazi hadi kizazi.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Kama Mungu alivyoangamiza Sodoma na Gomora","poem":1},{"text":"pamoja na miji iliyokuwa jirani nayo,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu,","poem":2},{"text":"“vivyo hivyo hakuna mtu atakayeishi humo.","poem":1},{"lineBreak":true},{"text":"Naam, hakuna mtu atakayekaa humo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“Tazama! Jeshi linakuja kutoka kaskazini;","poem":1},{"text":"taifa kubwa na wafalme wengi","poem":2},{"lineBreak":true},{"text":"wanaamshwa kutoka miisho ya dunia.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Wamejifunga pinde na mikuki;","poem":1},{"text":"ni wakatili na hawana huruma.","poem":2},{"text":"Wanatoa sauti kama bahari inayounguruma","poem":1},{"text":"wanapoendesha farasi wao;","poem":2},{"text":"wanakuja kama watu waliojipanga tayari kwa vita","poem":1},{"text":"ili kukushambulia, ee Binti Babeli.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mfalme wa Babeli amesikia habari kuwahusu,","poem":1},{"text":"nayo mikono yake imelegea.","poem":2},{"text":"Uchungu umemshika,","poem":1},{"text":"maumivu kama ya mwanamke katika uchungu wa kuzaa.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Kama simba anayepanda kutoka vichaka vya Yordani","poem":1},{"text":"kuja kwenye nchi ya malisho mengi,","poem":2},{"text":"ndivyo nitakavyomfukuza Babeli kutoka nchi yake ghafula.","poem":1},{"text":"Ni nani aliye mteule,","poem":2},{"lineBreak":true},{"text":"nitakayemweka kwa ajili ya jambo hili?","poem":2},{"text":"Ni nani aliye kama mimi,","poem":1},{"text":"na ni nani awezaye kunipinga?","poem":2},{"text":"Tena ni mchungaji yupi","poem":1},{"text":"awezaye kusimama kinyume nami?”","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Kwa hiyo, sikia ambacho Mwenyezi Mungu amepanga dhidi ya Babeli,","poem":1},{"text":"kile alichokusudia dhidi ya nchi ya Wakaldayo:","poem":2},{"text":"Aliye mchanga katika kundi ataburutwa mbali.","poem":1},{"text":"Yeye ataharibu kabisa malisho yao kwa sababu yao.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Kwa sauti ya kutekwa kwa Babeli, dunia itatetemeka;","poem":1},{"text":"kilio chake kitasikika pote miongoni mwa mataifa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}