{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JER","translationId":"swh_onmm","name":"Yeremia","commonName":"Yeremia","title":"Yeremia","order":24,"numberOfChapters":52,"sha256":"61deebf475b7135768e2a244a1aed945373957704c024a1e7b4163b253b28fde","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/swh_onmm/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":8,"content":[{"type":"heading","content":["Dhambi na uasi wa Yuda"]},{"type":"verse","number":1,"content":["“ ‘Wakati huo, asema Mwenyezi Mungu, mifupa ya wafalme na maafisa wa Yuda, mifupa ya makuhani na manabii, na mifupa ya watu wa Yerusalemu itaondolewa kutoka makaburi yao."]},{"type":"verse","number":2,"content":["Itawekwa wazi kwa jua, na mwezi, na nyota zote za mbingu, ambazo walizipenda na kuzitumikia, na ambazo wamezifuata kutafuta ushauri na kuziabudu. Hawatakusanywa pamoja au kuzikwa, lakini watakuwa kama kinyesi juu ya ardhi."]},{"type":"verse","number":3,"content":["Popote nitakapowafukuzia, mabaki wote wa kizazi hiki kiovu watatamani kufa kuliko kuishi, asema Mwenyezi Mungu, Mungu wa majeshi ya mbinguni.’"]},{"type":"heading","content":["Dhambi na adhabu"]},{"type":"verse","number":4,"content":["“Waambie, ‘Hivi ndivyo asemavyo Mwenyezi Mungu:",{"text":"“ ‘Je, watu wanapoanguka hawainuki?","poem":1},{"text":"Je, mtu anapopotea harudi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa nini basi watu hawa waliasi?","poem":1},{"text":"Kwa nini Yerusalemu wanaasi kila mara?","poem":2},{"text":"Wanang’ang’ania udanganyifu","poem":1},{"text":"na wanakataa kurudi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimewasikiliza kwa makini,","poem":1},{"text":"lakini hawataki kusema lililo sawa.","poem":2},{"text":"Hakuna anayetubu makosa yake","poem":1},{"text":"akisema, “Nimefanya nini?”","poem":2},{"text":"Kila mmoja hufuata njia yake mwenyewe","poem":1},{"text":"kama farasi anayeenda vitani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hata korongo aliye angani","poem":1},{"text":"anayajua majira yake yaliyoamriwa,","poem":2},{"text":"nao njiwa, mbayuwayu na koikoi","poem":1},{"text":"hufuata majira yao ya kurudi.","poem":2},{"text":"Lakini watu wangu hawajui","poem":1},{"text":"Mwenyezi Mungu anachotaka kwao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ ‘Mwawezaje kusema, “Sisi tuna busara","poem":1},{"text":"kwa sababu tunayo Torati ya Mwenyezi Mungu,”","poem":2},{"text":"wakati kwa hakika kalamu ya uongo ya waandishi","poem":1},{"text":"imeandika kwa udanganyifu?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wenye hekima wataaibika,","poem":1},{"text":"watafadhaika na kunaswa.","poem":2},{"text":"Kwa kuwa wamelikataa neno la Mwenyezi Mungu,","poem":1},{"text":"hiyo hekima waliyo nayo ni ya namna gani?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa hiyo nitawapa watu wengine wake zao,","poem":1},{"text":"na mashamba yao kwa wamiliki wengine.","poem":2},{"text":"Kuanzia aliye mdogo kabisa hadi aliye mkubwa kabisa,","poem":1},{"text":"wote wana tamaa ya kupata zaidi;","poem":2},{"text":"manabii na makuhani wanafanana,","poem":1},{"text":"wote wanafanya udanganyifu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wanafunga majeraha ya watu wangu","poem":1},{"text":"bila uangalifu.","poem":2},{"text":"Wanasema, “Amani, amani,”","poem":1},{"text":"wakati hakuna amani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Je, wanaona aibu kwa ajili ya tabia yao inayochukiza mno?","poem":1},{"text":"Hapana, hawana haya hata kidogo,","poem":2},{"lineBreak":true},{"text":"hawajui hata kuona aibu.","poem":2},{"text":"Kwa hiyo wataanguka miongoni mwa hao walioanguka,","poem":1},{"text":"watashushwa chini watakapoadhibiwa,","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ ‘Nitayaondoa mavuno yao,","poem":1},{"text":"asema Mwenyezi Mungu.","poem":2},{"lineBreak":true},{"text":"Hapatakuwa zabibu kwenye mzabibu.","poem":2},{"text":"Hapatakuwa na tini kwenye mtini,","poem":1},{"text":"na majani yake yatanyauka.","poem":2},{"text":"Kile nilichowapa","poem":1},{"text":"watanyang’anywa.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kwa nini tunaketi hapa?","poem":1},{"text":"Kusanyikeni pamoja!","poem":2},{"text":"Tukimbilie kwenye miji yenye ngome,","poem":1},{"text":"tukaangamie huko!","poem":2},{"text":"Kwa kuwa Mwenyezi Mungu, Mungu wetu,","poem":1},{"text":"ametuhukumu kuangamia,","poem":2},{"text":"na kutupatia maji yenye sumu tunywe,","poem":1},{"text":"kwa sababu tumemtenda dhambi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tulitegemea amani,","poem":1},{"text":"lakini hakuna jema lililokuja,","poem":2},{"text":"tulitegemea wakati wa kupona,","poem":1},{"text":"lakini kulikuwa hofu tu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mkoromo wa farasi wa adui","poem":1},{"text":"umesikika kuanzia Dani,","poem":2},{"text":"kwa mlio wa madume yao ya farasi,","poem":1},{"text":"nchi yote inatetemeka.","poem":2},{"text":"Wamekuja kuangamiza nchi na vyote vilivyomo,","poem":1},{"text":"mji na wote wanaoishi ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Tazama, nitatuma nyoka wenye sumu kali kati yenu,","poem":1},{"text":"fira ambao hawawezi kulogwa,","poem":2},{"lineBreak":true},{"text":"nao watawauma,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ee Mfariji wangu katika huzuni,","poem":1},{"text":"moyo wangu umezimia ndani yangu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Sikia kilio cha watu wangu","poem":1},{"text":"kutoka nchi ya mbali:","poem":2},{"text":"“Je, Mwenyezi Mungu hayuko Sayuni?","poem":1},{"text":"Je, Mfalme wake hayuko tena huko?”","poem":2},{"lineBreak":true},{"text":"“Kwa nini wamenikasirisha kwa vinyago vyao,","poem":1},{"text":"kwa sanamu zao za kigeni zisizofaa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mavuno yamepita,","poem":1},{"text":"kiangazi kimekwisha,","poem":2},{"lineBreak":true},{"text":"nasi hatujaokolewa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kwa kuwa watu wangu wamepondwa, nami nimepondeka pia;","poem":1},{"text":"ninaomboleza, nayo hofu kuu imenishika.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Je, hakuna zeri ya kuponya katika Gileadi?","poem":1},{"text":"Je, hakuna tabibu huko?","poem":2},{"text":"Kwa nini basi hakuna uponyaji","poem":1},{"text":"wa majeraha ya watu wangu?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JER/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JER/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JER/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}