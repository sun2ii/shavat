{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"heading","content":["Ayubu anaendelea"]},{"type":"verse","number":1,"content":[{"text":"“Macho yangu yameona hili lote,","poem":1},{"text":"masikio yangu yamesikia na kulielewa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hayo mnayoyajua mimi pia ninayajua;","poem":1},{"text":"mimi si mtu duni kuliko ninyi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lakini ninayo shauku ya kuzungumza na Mwenyezi","poem":1},{"text":"na kuhojiana shauri langu na Mungu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ninyi, hata hivyo, hunipakaza uongo;","poem":1},{"text":"ninyi ni matabibu wasiofaa kitu, ninyi nyote!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Laiti wote mngenyamaza!","poem":1},{"text":"Kwa kuwa kwenu hilo lingekuwa hekima.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sikieni sasa hoja yangu;","poem":1},{"text":"sikilizeni kusihi kwangu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je, mtazungumza kwa uovu kwa niaba ya Mungu?","poem":1},{"text":"Je, mtazungumza kwa udanganyifu kwa niaba yake?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mtamwonesha upendeleo?","poem":1},{"text":"Mtamtetea Mungu kwenye mashtaka yake?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, ingekuwa vyema","poem":1},{"text":"Mungu akiwahoji ninyi?","poem":2},{"text":"Je, mngeweza kumdanganya kama ambavyo","poem":1},{"text":"mngeweza kuwadanganya wanadamu?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hakika angewakemea","poem":1},{"text":"mkiwapendelea watu kwa siri.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Je, huo ukuu wake haungewatisha ninyi?","poem":1},{"text":"Je, hofu yake isingewaangukia ninyi?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Maneno yenu ni mithali za majivu;","poem":1},{"text":"utetezi wenu ni ngome za udongo wa mfinyanzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Nyamazeni kimya nipate kusema;","poem":1},{"text":"kisha na yanipate yatakayonipata.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa nini nijiweke mwenyewe kwenye hatari","poem":1},{"text":"na kuyaweka maisha yangu mikononi mwangu?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ingawa ataniua, bado nitamtumaini;","poem":1},{"text":"hakika nitazitetea njia zangu mbele zake.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Naam, hili litanigeukia kuwa wokovu wangu,","poem":1},{"text":"kwa maana hakuna mtu asiyemcha Mungu","poem":2},{"lineBreak":true},{"text":"atakayethubutu kuja mbele yake!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sikilizeni maneno yangu kwa makini;","poem":1},{"text":"nayo masikio yenu yaingize kile nisemacho.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Sasa kwa kuwa nimekwisha tayarisha kesi yangu,","poem":1},{"text":"ninajua nitahesabiwa kuwa haki.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Je, kuna yeyote anayeweza kuleta mashtaka dhidi yangu?","poem":1},{"text":"Kama ndivyo, nitanyamaza na nife.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ee Mungu, unijalie tu mimi haya mambo mawili,","poem":1},{"text":"nami sitajificha uso wako:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ondoa mkono wako uwe mbali nami,","poem":1},{"text":"uache kuniogofya kwa vitisho vyako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Niite kwenye shauri nami nitajibu,","poem":1},{"text":"au niache niseme, nawe upate kujibu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ni makosa na dhambi ngapi nilizotenda?","poem":1},{"text":"Nioneshe kosa langu na dhambi yangu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kwa nini kuuficha uso wako","poem":1},{"text":"na kunihesabu mimi kuwa adui yako?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Je, utaliadhibu jani lipeperushwalo na upepo?","poem":1},{"text":"Je, utayasaka makapi makavu?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kwa kuwa unaandika mambo machungu dhidi yangu","poem":1},{"text":"na kunifanya nizirithi dhambi za ujana wangu.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Umeifunga miguu yangu kwenye pingu.","poem":1},{"text":"Unazichunga kwa makini njia zangu zote","poem":2},{"lineBreak":true},{"text":"kwa kutia alama kwenye nyayo za miguu yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Hivyo mwanadamu huangamia kama kitu kilichooza,","poem":1},{"text":"kama vazi lililoliwa na nondo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}