{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"heading","content":["Ayubu anaendelea"]},{"type":"verse","number":1,"content":[{"text":"“Mwanadamu aliyezaliwa na mwanamke","poem":1},{"text":"siku zake ni chache nazo zimejaa taabu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Huchanua kama ua kisha hunyauka;","poem":1},{"text":"huwa kama kivuli kipitacho upesi, wala hadumu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Je, unamwekea jicho lako mtu kama huyo?","poem":1},{"text":"Je, utamleta mbele yako katika hukumu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ni nani awezaye kutoa kitu safi kutoka kitu najisi?","poem":1},{"text":"Hakuna awezaye!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Siku za mwanadamu zimewekewa mpaka;","poem":1},{"text":"umekwisha kutangaza idadi ya miezi yake","poem":2},{"lineBreak":true},{"text":"na kuweka mpaka ambao hawezi kuuvuka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hivyo angalia mbali umwache,","poem":1},{"text":"hadi awe amekamilisha muda wake","poem":2},{"lineBreak":true},{"text":"kama mtu aliyeajiriwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Kwa maana lipo tumaini kwa mti;","poem":1},{"text":"kama ukikatwa utachipuka tena,","poem":2},{"lineBreak":true},{"text":"nayo machipukizi yake mapya hayatakoma.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mizizi yake yaweza kuchakaa ardhini","poem":1},{"text":"na kisiki chake kufa udongoni,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"lakini kwa kupata dalili ya maji utachipua","poem":1},{"text":"na kutoa machipukizi kama mche.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini mwanadamu hufa, na huo ndio mwisho wake;","poem":1},{"text":"hutoa pumzi ya mwisho, naye hayuko tena!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kama vile maji yanavyotoweka katika bahari,","poem":1},{"text":"au mkondo wa mto ukaushwavyo na kuwa mkavu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ndivyo mwanadamu alalavyo chini asiamke;","poem":1},{"text":"hadi mbingu zitakapokuwa hazipo tena,","poem":2},{"text":"wanadamu hawataamka au kuamshwa","poem":1},{"text":"kutoka usingizi wao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Laiti kama ungenificha kaburini","poem":1},{"noteId":13},{"text":",","poem":1},{"text":"na kunisitiri hadi hasira yako ipite!","poem":2},{"text":"Laiti ungeniwekea wakati,","poem":1},{"text":"na kisha ukanikumbuka!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Je, kama mtu akifa, aweza kuishi tena?","poem":1},{"text":"Siku zote za kazi zangu ngumu","poem":2},{"lineBreak":true},{"text":"nitangojea kufanywa upya kwangu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Utaniita nami nitakuitika;","poem":1},{"text":"utakionea shauku kiumbe ambacho mikono yako ilikiumba.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hakika ndipo utakapozihesabu hatua zangu,","poem":1},{"text":"lakini hutazifuatia dhambi zangu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Makosa yangu yatatiwa muhuri kwenye mfuko,","poem":1},{"text":"nawe utazifunika dhambi zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Lakini kama mlima umomonyokavyo na kufikichika","poem":1},{"text":"na kama vile mwamba uondolewavyo mahali pake,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"kama maji yamalizavyo mawe,","poem":1},{"text":"na mafuriko yachukuavyo udongo,","poem":2},{"lineBreak":true},{"text":"ndivyo unavyoharibu tegemeo la mwanadamu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Humshinda mara moja kwa daima, naye hutoweka;","poem":1},{"text":"waibadilisha sura yake na kumwondoa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kama wanawe wakipewa heshima, yeye hafahamu;","poem":1},{"text":"kama wazao wake wakidharauliwa, yeye haoni.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yeye hasikii kingine isipokuwa maumivu ya mwili wake mwenyewe,","poem":1},{"text":"naye huomboleza kwa ajili yake mwenyewe.”","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"Kaburini maana yake ni Kuzimu; kwa Kiebrania ni Sheol.","reference":{"chapter":14,"verse":13}}]},"thisChapterLink":"/api/swh_onmm/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}