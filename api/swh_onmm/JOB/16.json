{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["Ayubu anajibu: Hakika sina hatia"]},{"type":"verse","number":1,"content":["Kisha Ayubu akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Nimepata kusikia mambo mengi kama haya,","poem":1},{"text":"nanyi nyote ni wafariji wenye kutaabisha!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Je, maneno yenu mengi yasiyo na maana hayana mwisho?","poem":1},{"text":"Mna nini hata mwendelee kushindana kwa maneno?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mimi pia ningeweza kuzungumza kama ninyi,","poem":1},{"text":"kama mngekuwa katika hali yangu;","poem":2},{"text":"ningeweza kutoa hotuba nzuri dhidi yenu,","poem":1},{"text":"na kuwatikisia ninyi kichwa changu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lakini kinywa changu kingewatia moyo;","poem":1},{"text":"faraja kutoka mdomoni mwangu ingewaletea nafuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Lakini nikisema, maumivu yangu bado hayatulizwi;","poem":1},{"text":"na nikijizuia, bado hayaondoki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mungu, hakika umenichakaza;","poem":1},{"text":"umewaangamiza kabisa watu wa nyumbani mwangu wote.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umenikunjakunja, nalo limekuwa ushahidi;","poem":1},{"text":"nako kukonda kwangu kumeongezeka sana na kushuhudia dhidi yangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mungu amenishambulia na kunirarua katika hasira yake,","poem":1},{"text":"na kunisagia meno yake;","poem":2},{"lineBreak":true},{"text":"adui yangu hunikazia macho yake makali.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watu wamenifumbulia vinywa vyao kunidhihaki;","poem":1},{"text":"hunipiga shavuni mwangu kwa dharau,","poem":2},{"lineBreak":true},{"text":"na kuungana pamoja dhidi yangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mungu amenigeuzia kwa watu wapotovu,","poem":1},{"text":"na kunitupa katika makucha ya waovu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mambo yote yalikuwa mazuri, lakini alinivunjavunja;","poem":1},{"text":"amenikamata shingo na kuniponda.","poem":2},{"lineBreak":true},{"text":"Amenifanya mimi kuwa shabaha yake;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"wapiga upinde wake wananizunguka.","poem":1},{"text":"Bila huruma, huchoma figo zangu,","poem":2},{"lineBreak":true},{"text":"na kuimwaga nyongo yangu juu ya nchi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Huniponda tena na tena;","poem":1},{"text":"hunishambulia kama shujaa wa vita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Nimejishonea gunia juu ya mwili wangu,","poem":1},{"text":"nami nimezika paji la uso wangu kwenye vumbi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uso wangu umekuwa mwekundu kwa kulia,","poem":1},{"text":"macho yangu yamepigwa na giza.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hata hivyo mikono yangu haijafanya jeuri,","poem":1},{"text":"na maombi yangu ni safi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Ee nchi, usiifunike damu yangu,","poem":1},{"text":"nacho kilio changu kisinyamazishwe kamwe.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Hata sasa shahidi wangu yuko mbinguni;","poem":1},{"text":"wakili wangu yuko juu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mwombezi wangu ni rafiki yangu","poem":1},{"text":"macho yangu yanapomwaga machozi kwa Mungu;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"kwa niaba ya mtu anamsihi Mungu","poem":1},{"text":"kama mtu anavyosihi kwa ajili ya rafiki yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Ni miaka michache tu itapita","poem":1},{"text":"kabla sijaenda safari ambayo sitarudi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}