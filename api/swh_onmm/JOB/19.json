{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["Ayubu anajibu: Najua Mkombozi wangu yu hai"]},{"type":"verse","number":1,"content":["Ndipo Ayubu akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Je, mtaendelea kunitesa hadi lini,","poem":1},{"text":"na kuniponda kwa maneno yenu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mara kumi hizi mmenishutumu;","poem":1},{"text":"bila aibu mnanishambulia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kama ni kweli nimepotoka,","poem":1},{"text":"kosa langu ninabaki kuhusika nalo mwenyewe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kama kweli mngejitukuza wenyewe juu yangu,","poem":1},{"text":"na kutumia unyonge wangu dhidi yangu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"basi jueni kuwa Mungu amenitendea yaliyo mabaya,","poem":1},{"text":"naye amekokota wavu wake kunizunguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ingawa ninalia, ‘Nimetendewa mabaya!’ sipati jibu;","poem":1},{"text":"ingawa ninaomba msaada, hakuna haki.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeye ameizuia njia yangu hivyo siwezi kupita;","poem":1},{"text":"ameyafunika mapito yangu na giza.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Amenivua heshima yangu,","poem":1},{"text":"na kuniondolea taji kichwani pangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Amenibomoa kila upande hadi nimeisha;","poem":1},{"text":"ameling’oa tegemeo langu kama mti.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Hasira yake imewaka juu yangu;","poem":1},{"text":"amenihesabu kuwa miongoni mwa adui zake.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Majeshi yake yananisogelea kwa nguvu;","poem":1},{"text":"yamenizingira,","poem":2},{"lineBreak":true},{"text":"yamepiga kambi kulizunguka hema langu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Amewatenga ndugu zangu mbali nami;","poem":1},{"text":"wale tunaojuana nao wamefarakana nami kabisa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Watu wa jamaa zangu wameenda mbali;","poem":1},{"text":"rafiki zangu wamenisahau.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wageni wangu na wajakazi wangu wananiona kama mgeni;","poem":1},{"text":"wananitazama kama mgeni.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Namwita mtumishi wangu, wala haitiki,","poem":1},{"text":"ingawa namwomba kwa kinywa changu mwenyewe.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pumzi ya kinywa changu ni kinyaa kwa mke wangu;","poem":1},{"text":"nimekuwa chukizo mno kwa ndugu zangu mwenyewe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hata watoto wadogo hunidhihaki;","poem":1},{"text":"ninapojitokeza, hunifanyia mzaha.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Rafiki zangu wa moyoni wote wananichukia kabisa;","poem":1},{"text":"wale ninaowapenda wamekuwa kinyume nami.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mimi nimebaki mifupa na ngozi tu;","poem":1},{"text":"nimeponea nikiwa karibu kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Nihurumieni, rafiki zangu, kuweni na huruma,","poem":1},{"text":"kwa kuwa mkono wa Mungu umenipiga.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Kwa nini mnanifuatia kama Mungu afanyavyo?","poem":1},{"text":"Hamtosheki kamwe na mwili wangu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Laiti maneno yangu yangewekwa kwenye kumbukumbu,","poem":1},{"text":"laiti kwamba yangeandikwa kwenye kitabu,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kwamba yangechorwa kwenye risasi kwa kifaa cha chuma,","poem":1},{"text":"au kuyachonga juu ya mwamba milele!","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ninajua kwamba Mkombozi","poem":1},{"noteId":16},{"text":"wangu yu hai,","poem":1},{"text":"naye kwamba mwishoni atasimama juu ya nchi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Nami baada ya ngozi yangu kuharibiwa,","poem":1},{"text":"bado nikiwa na mwili huu nitamwona Mungu;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"mimi nitamwona kwa macho yangu mwenyewe:","poem":1},{"text":"mimi, wala si mwingine.","poem":2},{"lineBreak":true},{"text":"Tazama jinsi moyo wangu unavyomtamani sana!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Mkisema, ‘Tazama tutakavyomwinda,","poem":1},{"text":"maadamu mzizi wa tatizo uko ndani yake,’","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ninyi wenyewe uogopeni upanga,","poem":1},{"text":"kwa kuwa ghadhabu italeta adhabu kwa upanga,","poem":2},{"lineBreak":true},{"text":"nanyi ndipo mtajua kuwa kuna hukumu.”","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"au Mtetezi","reference":{"chapter":19,"verse":25}}]},"thisChapterLink":"/api/swh_onmm/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}