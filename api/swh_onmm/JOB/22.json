{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["Elifazi anasema: Uovu wa Ayubu ni mkubwa"]},{"type":"verse","number":1,"content":["Ndipo Elifazi Mtemani akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Je, mwanadamu aweza kuwa wa faida kwa Mungu?","poem":1},{"text":"Je, hata mtu mwenye hekima aweza kumfaidi?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Je, Mwenyezi angefurahia nini","poem":1},{"text":"kama ungekuwa mwadilifu?","poem":2},{"text":"Au je, yeye angepata faida gani","poem":1},{"text":"kama njia zako zingekuwa kamilifu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Je, ni kwa ajili ya utaua wako ndiyo maana anakukemea","poem":1},{"text":"na kuleta mashtaka dhidi yako?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Je, uovu wako si mkuu?","poem":1},{"text":"Dhambi zako si hazina mwisho?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Umedai dhamana kwa ndugu zako bila sababu;","poem":1},{"text":"umewavua watu nguo zao, ukawaacha uchi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hukumpa maji aliyechoka,","poem":1},{"text":"nawe ulimnyima chakula mwenye njaa,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ingawa ulikuwa mtu mwenye uwezo ukimiliki nchi:","poem":1},{"text":"mtu uliyeheshimiwa, ukiishi ndani yake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Umewafukuza wajane mikono mitupu","poem":1},{"text":"na kuzivunja nguvu za yatima.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndiyo sababu mitego imekuzunguka pande zote,","poem":1},{"text":"hatari ya ghafula inakutia hofu,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ndiyo sababu ni giza sana huwezi kuona,","poem":1},{"text":"tena ndiyo sababu mafuriko ya maji yamekufunika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Je, Mungu hayuko katika mbingu za juu?","poem":1},{"text":"Juu kuliko nyota zilizo juu sana!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hivyo wewe wasema, ‘Mungu anajua nini?’","poem":1},{"text":"Je, yeye huhukumu katika giza kama hilo?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mawingu mazito ni pazia lake, hivyo hatuoni sisi","poem":1},{"text":"atembeapo juu ya anga la dunia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Je, utaifuata njia ya zamani,","poem":1},{"text":"ambayo watu waovu waliikanyaga?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Waliondolewa kabla ya wakati wao,","poem":1},{"text":"misingi yao ikachukuliwa na mafuriko.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Walimwambia Mungu, ‘Tuache sisi!","poem":1},{"text":"Huyo Mwenyezi aweza kutufanyia nini?’","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lakini ndiye alizijaza nyumba zao na vitu vizuri,","poem":1},{"text":"hivyo ninajitenga mbali na mashauri ya waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“Wenye haki wanaona maangamizi yao na kufurahi,","poem":1},{"text":"nao wasio na hatia huwadhihaki, wakisema,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘Hakika adui zetu wameangamizwa,","poem":1},{"text":"nao moto umeteketeza mali yao.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mjue sana Mungu ili uwe na amani,","poem":1},{"text":"ndipo mema yatakapokujia.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Uyapokee mafundisho toka kinywani mwake,","poem":1},{"text":"na maneno yake uyaweke moyoni mwako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ukimrudia Mwenyezi, utarudishwa upya:","poem":1},{"text":"Ukiuondoa uovu uwe mbali na hema lako,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"kama dhahabu yako ukiihesabu kama mavumbi,","poem":1},{"text":"dhahabu yako ya Ofiri kama miamba ya mabondeni,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ndipo Mwenyezi atakuwa dhahabu yako,","poem":1},{"text":"naye atakuwa fedha yako iliyo bora.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hakika ndipo utakapojifurahisha kwa Mwenyezi,","poem":1},{"text":"nawe utamwinulia Mungu uso wako.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Utamwomba yeye, naye atakusikia,","poem":1},{"text":"nawe utazitimiza nadhiri zako.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Utakusudia jambo nalo litatendeka,","poem":1},{"text":"nao mwanga utaangazia njia zako.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Watu watakaposhushwa, nawe ukasema, ‘Wainue!’","poem":1},{"text":"ndipo atamwokoa aliyevunjika moyo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Atamwokoa hata yule ambaye ana hatia,","poem":1},{"text":"ataokolewa kwa sababu ya usafi wa mikono yako.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}