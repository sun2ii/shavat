{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["Ayubu anajibu: Nalalamika kwa uchungu"]},{"type":"verse","number":1,"content":["Ndipo Ayubu akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Hata leo malalamiko yangu ni ya uchungu;","poem":1},{"text":"mkono wake ni mzito juu yangu hata nikiugua.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Laiti ningefahamu mahali pa kumwona;","poem":1},{"text":"laiti ningeweza kwenda mahali akaapo!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ningeleta kesi yangu mbele zake,","poem":1},{"text":"na kukijaza kinywa changu na hoja.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ningejua kwamba angenijibu nini,","poem":1},{"text":"na kuelewa lile angeniambia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, angenipinga kwa nguvu nyingi?","poem":1},{"text":"La, hangenigandamiza.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hapo mtu mwadilifu angeleta kesi yake mbele zake,","poem":1},{"text":"nami ningeokolewa milele na mhukumu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Lakini nikienda mashariki, hayupo;","poem":1},{"text":"nikienda magharibi, simpati.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Anapokuwa kazini pande za kaskazini, simwoni;","poem":1},{"text":"akigeukia kusini, nako simwoni hata kidogo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini anaijua njia niiendeayo;","poem":1},{"text":"akiisha kunijaribu, nitatoka kama dhahabu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nyayo zangu zimefuata hatua zake kwa karibu;","poem":1},{"text":"nimeishika njia yake bila kukengeuka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Sijaziacha amri zilizotoka mdomoni mwake;","poem":1},{"text":"nimeyathamini maneno ya kinywa chake","poem":2},{"lineBreak":true},{"text":"kuliko chakula changu cha kila siku.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Lakini yeye husimama peke yake; ni nani awezaye kumpinga?","poem":1},{"text":"Yeye hufanya lolote atakalo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hutimiliza maagizo yake dhidi yangu,","poem":1},{"text":"na bado anayo mipango mingi kama hiyo ambayo ameiweka akiba.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hiyo ndiyo sababu ninaingiwa na hofu mbele zake;","poem":1},{"text":"nifikiriapo haya yote ninamwogopa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mungu ameufanya moyo wangu kuzimia;","poem":1},{"text":"yeye Mwenyezi amenitia hofu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hata hivyo sijanyamazishwa na giza,","poem":1},{"text":"wala kwa giza nene linalofunika uso wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}