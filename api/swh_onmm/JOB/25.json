{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["Bildadi anasema: Mwanadamu awezaje kuwa mwadilifu mbele za Mwenyezi Mungu?"]},{"type":"verse","number":1,"content":["Ndipo Bildadi Mshuhi akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Mamlaka na kuheshimiwa ni vyake Mungu;","poem":1},{"text":"yeye huthibitisha amani katika mbingu juu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Je, majeshi yake yaweza kuhesabika?","poem":1},{"text":"Ni nani asiyeangaziwa na nuru yake?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mtu awezaje kuwa mwadilifu mbele za Mungu?","poem":1},{"text":"Awezaje mtu aliyezaliwa na mwanamke kuwa safi?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ikiwa hata mwezi sio mwangavu","poem":1},{"text":"nazo nyota si safi machoni pake,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"sembuse mtu ambaye ni funza:","poem":1},{"text":"mwanadamu ambaye ni buu tu!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}