{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["Ayubu anailaani siku aliyozaliwa"]},{"type":"verse","number":1,"content":["Baada ya jambo hili, Ayubu akafumbua kinywa chake na kuilaani siku ya kuzaliwa kwake."]},{"type":"verse","number":2,"content":["Kisha akasema:"]},{"type":"verse","number":3,"content":[{"text":"“Siku ya kuzaliwa kwangu na ipotelee mbali,","poem":1},{"text":"na usiku ule iliposemekana,","poem":2},{"lineBreak":true},{"text":"‘Mtoto wa kiume amezaliwa!’","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Siku ile na iwe giza;","poem":1},{"text":"Mungu juu na asiiangalie;","poem":2},{"lineBreak":true},{"text":"nayo nuru isiiangazie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Giza na kivuli kikuu viikalie tena;","poem":1},{"text":"wingu na likae juu yake;","poem":2},{"lineBreak":true},{"text":"weusi na uifunike nuru yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Usiku ule na ushikwe na giza nene;","poem":1},{"text":"usihesabiwe katika siku za mwaka,","poem":2},{"lineBreak":true},{"text":"wala usihesabiwe katika siku za mwezi wowote.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Usiku ule na uwe tasa;","poem":1},{"text":"sauti ya furaha na isisikike ndani yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wale wanaozilaani siku na wailaani hiyo siku,","poem":1},{"text":"wale walio tayari kumwamsha Lewiathani","poem":2},{"noteId":4},{"text":".","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nyota zake za alfajiri na ziwe giza;","poem":1},{"text":"nao ungojee mwanga bila mafanikio,","poem":2},{"text":"wala usiione miali","poem":1},{"text":"ya mapambazuko,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kwa sababu huo usiku haukunifungia","poem":1},{"text":"mlango wa tumbo la mama yangu,","poem":2},{"text":"ili kuyaficha macho yangu","poem":1},{"text":"kutokana na taabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kwa nini sikuangamia wakati wa kuzaliwa?","poem":1},{"text":"Kwa nini sikufa nilipokuwa ninatoka tumboni?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa nini pakawa na magoti ya kunipokea","poem":1},{"text":"na matiti ili nipate kunyonyeshwa?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa maana sasa ningekuwa nimepumzika kwa amani.","poem":1},{"text":"Ningekuwa nimelala na kupumzika","poem":2}]},{"type":"verse","number":14,"content":[{"text":"pamoja na wafalme na washauri wa dunia,","poem":1},{"text":"waliojijengea mahali ambapo sasa ni magofu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"pamoja na watawala waliokuwa na dhahabu,","poem":1},{"text":"waliozijaza nyumba zao kwa fedha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Au kwa nini sikufichwa ardhini kama mtoto aliyezaliwa mfu,","poem":1},{"text":"kama mtoto mchanga ambaye kamwe hakuuona mwanga?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Huko waovu huacha kusumbua","poem":1},{"text":"na huko waliochoka hupumzika.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wafungwa nao hufurahia utulivu wao,","poem":1},{"text":"hawasikii tena sauti ya kukemea ya kiongozi wa watumwa.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wadogo kwa wakubwa wamo humo,","poem":1},{"text":"na mtumwa ameachiwa huru kutoka kwa bwana wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Mbona nuru inawaangazia wale walio taabuni,","poem":1},{"text":"na hao wenye uchungu kupewa uhai,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"wale wanaotamani kifo ambacho hakiji,","poem":1},{"text":"wale wanaotafuta kufa zaidi ya kutafuta hazina iliyofichwa,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ambao hujawa na furaha,","poem":1},{"text":"na hushangilia wanapofika kaburini?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kwa nini uhai hupewa mtu","poem":1},{"text":"ambaye njia yake imefichika,","poem":2},{"lineBreak":true},{"text":"ambaye Mungu amemzingira?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kwa maana kulia kwangu kwa uchungu kwanijia badala ya chakula;","poem":1},{"text":"kusononeka kwangu kunamwagika kama maji.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Lile nililokuwa nikiogopa limenijia;","poem":1},{"text":"lile nililokuwa nikihofia limenipata.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Sina amani, wala utulivu;","poem":1},{"text":"sina pumziko, bali taabu tu.”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Lewiathani ni mnyama mkubwa wa baharini mwenye magamba anayefanana na joka kubwa, mwenye umbo la kutisha, asiyeweza kuvuliwa.","reference":{"chapter":3,"verse":8}}]},"thisChapterLink":"/api/swh_onmm/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}