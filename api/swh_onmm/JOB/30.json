{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"heading","content":["Ayubu anaendelea"]},{"type":"verse","number":1,"content":[{"text":"“Lakini sasa watu wadogo kwa umri kuliko mimi wananidhihaki,","poem":1},{"lineBreak":true},{"text":"watu ambao baba zao ningekataa kwa dharau","poem":1},{"text":"kuwaweka pamoja na mbwa wangu wa kulinda kondoo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nguvu za mikono yao zingekuwa na faida gani kwangu,","poem":1},{"text":"kwa kuwa nguvu zao zilikuwa zimewaishia?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wakiwa wamekonda kutokana na kupungukiwa na kwa njaa,","poem":1},{"text":"walizurura usiku katika nchi kame iliyo ukiwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Katika vichaka walikusanya mimea ya chumvi,","poem":1},{"text":"nacho chakula chao kilikuwa mizizi ya mti wa mfagio.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Walifukuzwa mbali na watu wao,","poem":1},{"text":"wakipigiwa kelele kama wezi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Walilazimika kuishi katika mikondo ya vijito vilivyokauka,","poem":1},{"text":"kwenye majabali na mahandaki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwenye vichaka walilia kama punda,","poem":1},{"text":"na walijisongasonga pamoja kwenye vichaka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wao ni watoto wa wapumbavu wenye asili ya ubaya,","poem":1},{"text":"waliofukuzwa watoke katika nchi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nao sasa wana wao wananidhihaki katika nyimbo;","poem":1},{"text":"nimekuwa kitu cha dhihaka kwao.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wananichukia sana na kujitenga nami,","poem":1},{"text":"wala hawasiti kunitemea mate usoni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sasa kwa kuwa Mungu ameilegeza kamba ya upinde wangu na kunitesa,","poem":1},{"text":"wamekuwa huru kunitendea wanavyopenda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kuume kwangu kundi linashambulia;","poem":1},{"text":"wao huitegea miguu yangu tanzi,","poem":2},{"lineBreak":true},{"text":"na kunizingira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Huizuia njia yangu,","poem":1},{"text":"nao hufanikiwa katika kuniletea maafa,","poem":2},{"lineBreak":true},{"text":"nami sina yeyote wa kunisaidia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wananijia kama watu wapitao katika ufa mpana;","poem":1},{"text":"katikati ya magofu huja na kunishambulia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vitisho vimenifunika;","poem":1},{"text":"heshima yangu imetoweshwa kama kwa upepo,","poem":2},{"lineBreak":true},{"text":"salama yangu imetoweka kama wingu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“Sasa maisha yangu yamefikia mwisho;","poem":1},{"text":"siku za mateso zimenikamata.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Usiku mifupa yangu inachoma;","poem":1},{"text":"maumivu yanayonitafuna hayatulii kamwe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa uwezo wake mkuu Mungu huwa kwangu kama nguo;","poem":1},{"text":"hushikamana nami kama ukosi wa vazi langu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yeye amenitupa kwenye matope,","poem":1},{"text":"nami nimekuwa kama mavumbi na majivu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Ee Mwenyezi Mungu, ninakulilia wewe lakini hunijibu;","poem":1},{"text":"ninasimama, nawe unanitazama tu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Wewe unanigeukia bila huruma;","poem":1},{"text":"unanishambulia kwa nguvu za mkono wako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Unaninyakua na kunipeperusha kwa upepo;","poem":1},{"text":"umenirusharusha kwenye dhoruba.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ninajua utanileta hadi kifoni,","poem":1},{"text":"mahali wenye uhai wote wamewekewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Hakika hakuna mtu anayemshambulia mhitaji","poem":1},{"text":"anapoomba msaada katika shida yake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Je, sikulia kwa ajili ya wale waliokuwa katika taabu?","poem":1},{"text":"Je, nafsi yangu haikusononeka kwa ajili ya maskini?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Lakini nilipotazamia mema, mabaya yalinijia;","poem":1},{"text":"nilipotafuta nuru, ndipo giza lilipokuja.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Kusukwasukwa ndani yangu kamwe hakutulii;","poem":1},{"text":"siku za mateso zinanikabili.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Ninazunguka nikiwa nimeungua, lakini si kwa jua;","poem":1},{"text":"ninasimama katika kusanyiko nikiomba msaada.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nimekuwa ndugu wa mbweha,","poem":1},{"text":"rafiki wa mabundi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Ngozi yangu imekuwa nyeusi nayo inachunika;","poem":1},{"text":"mifupa yangu inaungua kwa homa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kinubi changu kimegeuka kuwa maombolezo,","poem":1},{"text":"nayo filimbi yangu imekuwa sauti ya kilio.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}