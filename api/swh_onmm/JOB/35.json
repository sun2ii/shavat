{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"heading","content":["Elihu alaumu mtu kujiona kuwa mwenye haki"]},{"type":"verse","number":1,"content":["Ndipo Elihu akasema:"]},{"type":"verse","number":2,"content":[{"text":"“Je, unadhani hili ni haki?","poem":1},{"text":"Wewe unasema, ‘Nina haki mbele za Mungu.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bado unamuuliza, ‘Ni faida gani nimepata,","poem":1},{"text":"na imenifaidi nini kwa kutokutenda dhambi?’","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ningependa nikujibu wewe","poem":1},{"text":"na rafiki zako walio nawe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tazama juu mbinguni ukaone;","poem":1},{"text":"yaangalie mawingu yaliyo juu sana juu yako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, ukitenda dhambi, inamdhuruje Mungu?","poem":1},{"text":"Kama dhambi zako zikiwa nyingi,","poem":2},{"lineBreak":true},{"text":"hilo linamfanyia nini Mungu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kama wewe ni mwadilifu, unampa nini,","poem":1},{"text":"au yeye anapokea nini mkononi kwako?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Uovu wako unamdhuru tu mtu mwingine kama wewe,","poem":1},{"text":"nayo haki yako inawafaa wanadamu tu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Wanadamu hulia kwa kulemewa na mateso;","poem":1},{"text":"huomba msaada kutoka mkono wenye nguvu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Lakini hakuna asemaye, ‘Yuko wapi Mungu Muumba wangu,","poem":1},{"text":"yeye anifanyaye niimbe usiku,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"yeye atufundishaye sisi zaidi ya wanyama wa nchi,","poem":1},{"text":"na kutufanya wenye hekima kuliko ndege wa angani?’","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yeye hajibu wakati watu waliapo","poem":1},{"text":"kwa sababu ya kiburi cha watu waovu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naam, Mungu hasikilizi maombi yao ya ubatili;","poem":1},{"text":"Mwenyezi hayazingatii.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Si zaidi sana kwamba hatakusikiliza","poem":1},{"text":"wewe usemapo humwoni,","poem":2},{"text":"tena kwamba kesi yako iko mbele zake","poem":1},{"text":"na wewe lazima umngojee,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"pia zaidi, kwamba hasira yake kamwe haiadhibu","poem":1},{"text":"wala haangalii uovu hata kidogo?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Hivyo Ayubu hufumbua kinywa chake kwa maneno yasiyo na maana;","poem":1},{"text":"anaongea maneno mengi bila maarifa.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}