{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["Elifazi anasema: Ayubu ametenda dhambi"]},{"type":"verse","number":1,"content":["Ndipo Elifazi Mtemani akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Kama mtu akithubutu kuzungumza nawe,","poem":1},{"text":"kutakukasirisha?","poem":2},{"text":"Lakini ni nani awezaye","poem":1},{"text":"kujizuia asiseme?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fikiri jinsi umewafundisha watu wengi,","poem":1},{"text":"jinsi umeitia nguvu","poem":2},{"lineBreak":true},{"text":"mikono iliyokuwa dhaifu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Maneno yako yamewategemeza wale waliojikwaa;","poem":1},{"text":"umeyatia nguvu magoti yaliyokuwa dhaifu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Lakini sasa hii taabu imekujia wewe,","poem":1},{"text":"nawe unashuka moyo;","poem":2},{"text":"imekupiga wewe,","poem":1},{"text":"nawe unafadhaika.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, kumcha Mungu kwako hakupaswi kuwa","poem":1},{"text":"ndiyo matumaini yako","poem":2},{"text":"na njia zako kutokuwa na lawama","poem":1},{"text":"ndilo taraja lako?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Fikiri sasa: Ni mtu yupi asiye na hatia","poem":1},{"text":"ambaye aliwahi kuangamia?","poem":2},{"text":"Ni wapi wanyofu","poem":1},{"text":"waliwahi kuangamizwa?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa jinsi mimi nimechunguza,","poem":1},{"text":"wale walimao ubaya","poem":2},{"text":"na wale hupanda uovu,","poem":1},{"text":"huvuna hayo hayo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa pumzi ya Mungu huangamizwa;","poem":1},{"text":"kwa mshindo wa hasira zake huangamia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Simba anaweza kunguruma na kukoroma,","poem":1},{"text":"lakini bado meno ya simba mkubwa huvunjika.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Simba anaweza kuangamia kwa kukosa mawindo,","poem":1},{"text":"nao wana wa simba jike hutawanyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Neno lililetwa kwangu kwa siri,","poem":1},{"text":"masikio yangu yakasikia mnong’ono wake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Katikati ya ndoto za kutia wasiwasi wakati wa usiku,","poem":1},{"text":"hapo usingizi mzito uwapatapo wanadamu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"hofu na kutetemeka kulinishika","poem":1},{"text":"na kufanya mifupa yangu yote itetemeke.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kuna roho aliyepita mbele ya uso wangu,","poem":1},{"text":"nazo nywele za mwili wangu zikasimama.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Yule roho akasimama,","poem":1},{"text":"lakini sikuweza kutambua kilikuwa kitu gani.","poem":2},{"text":"Umbo fulani lilisimama mbele ya macho yangu,","poem":1},{"text":"kukawa na ukimya kisha nikasikia sauti:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘Je, binadamu aweza kuwa mwadilifu kuliko Mungu?","poem":1},{"text":"Je, mtu aweza kuwa safi kuliko Muumba wake?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ikiwa Mungu hawaamini watumishi wake,","poem":1},{"text":"ikiwa yeye huwalaumu malaika wake kwa kukosea,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ni mara ngapi zaidi wale wanaoishi katika nyumba","poem":1},{"text":"za udongo wa mfinyanzi,","poem":2},{"text":"ambazo misingi yake ipo mavumbini,","poem":1},{"text":"ambao wamepondwa kama nondo!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kati ya mawio na machweo","poem":1},{"text":"huvunjwa vipande vipande;","poem":2},{"text":"bila yeyote kutambua,","poem":1},{"text":"huangamia milele.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Je, kamba za hema lao hazikung’olewa,","poem":1},{"text":"hivyo hufa bila hekima?’","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}