{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"heading","content":["Elifazi anaendelea"]},{"type":"verse","number":1,"content":[{"text":"“Itana, ukitaka, lakini ni nani atakayekujibu?","poem":1},{"text":"Ni yupi kati ya hao watakatifu utakayemgeukia?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kuweka uchungu moyoni humuua mpumbavu,","poem":1},{"text":"nao wivu humchinja mjinga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mimi mwenyewe nimemwona mpumbavu akistawi,","poem":1},{"text":"lakini ghafula nyumba yake ikawa imelaaniwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Watoto wake wako mbali na usalama,","poem":1},{"text":"hushindwa mahakamani bila mtetezi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wenye njaa huyala mavuno yake,","poem":1},{"text":"wakiyatoa hata katikati ya miiba,","poem":2},{"lineBreak":true},{"text":"nao wenye kiu huitamani sana mali yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa maana taabu haioti kutoka kwa udongo,","poem":1},{"text":"wala ubaya hauchipui kutoka ardhini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lakini mwanadamu huzaliwa ili kutaabika,","poem":1},{"text":"kwa hakika kama cheche za moto zinavyoruka kuelekea juu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Lakini ingekuwa ni mimi, ningemlalamikia Mungu,","poem":1},{"text":"ningeweka shauri langu mbele zake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Yeye hutenda maajabu yasiyoweza kutambuliwa,","poem":1},{"text":"miujiza isiyoweza kuhesabika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Yeye huipa nchi mvua,","poem":1},{"text":"huyapeleka maji kunyesha mashamba.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Huwainua juu wanyonge,","poem":1},{"text":"nao wale wanaoomboleza","poem":2},{"lineBreak":true},{"text":"huinuliwa wakawa salama.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Huipinga mipango ya wenye hila,","poem":1},{"text":"ili mikono yao isifikie ufanisi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yeye huwanasa wenye hekima katika hila yao,","poem":1},{"text":"nayo mipango ya wadanganyifu huifagilia mbali.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Giza huwapata wakati wa mchana;","poem":1},{"text":"wakati wa adhuhuri hupapasa kama vile usiku.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Humwokoa mhitaji kutokana na upanga ulioko kinywani mwao;","poem":1},{"text":"huwaokoa kutokana na makucha ya wenye nguvu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa hiyo maskini analo tarajio,","poem":1},{"text":"nao udhalimu hufumba kinywa chake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Heri mtu yule ambaye Mungu humkanya;","poem":1},{"text":"kwa hiyo usidharau adhabu yake Mwenyezi","poem":2},{"noteId":5},{"text":".","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa kuwa hutia jeraha, lakini pia huyafunga;","poem":1},{"text":"huumiza, lakini mikono yake pia huponya.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kutoka majanga sita atakuokoa;","poem":1},{"text":"naam, hata katika saba hakuna dhara litakalokupata wewe.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wakati wa njaa atakukomboa wewe na kifo,","poem":1},{"text":"naye katika vita atakukomboa na pigo la upanga.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Utalindwa kutokana na kichapo cha ulimi,","poem":1},{"text":"wala hutakuwa na sababu ya kuogopa maangamizi yatakapokujia.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Utayacheka maangamizi na njaa,","poem":1},{"text":"wala hutakuwa na sababu ya kuwaogopa","poem":2},{"lineBreak":true},{"text":"wanyama wakali wa mwituni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kwa kuwa utakuwa na agano na mawe ya mashamba,","poem":1},{"text":"nao wanyama pori watakuwa na amani nawe.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Utajua kwamba hema lako li salama;","poem":1},{"text":"utahesabu mali yako wala hutakuta chochote kilichopungua.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Utajua kuwa watoto wako watakuwa wengi,","poem":1},{"text":"nao wazao wako wengi kama majani ya nchi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Utaingia kaburini ukiwa na umri wa uzee mtimilifu,","poem":1},{"text":"kama masuke ya ngano yanapokusanywa kwa wakati wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“Tumelichunguza hili, nalo ni kweli.","poem":1},{"text":"Hivyo lisikie na ulitendee kazi.”","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Mwenyezi hapa ni jina la Kiebrania Shaddai (na kila mahali katika kitabu hiki cha Ayubu).","reference":{"chapter":5,"verse":17}}]},"thisChapterLink":"/api/swh_onmm/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}