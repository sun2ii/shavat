{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["Ayubu anajibu: Malalamiko yangu ni ya haki"]},{"type":"verse","number":1,"content":["Kisha Ayubu akajibu:"]},{"type":"verse","number":2,"content":[{"text":"“Laiti uchungu wangu ungeweza kupimwa,","poem":1},{"text":"nayo taabu yangu yote ingewekwa kwenye mizani!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa hakika ingekuwa nzito kuliko mchanga wa bahari zote,","poem":1},{"text":"kwa hiyo si ajabu maneno yangu yamekuwa ya haraka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mishale ya Mwenyezi iko ndani yangu,","poem":1},{"text":"roho yangu inakunywa sumu yake;","poem":2},{"lineBreak":true},{"text":"vitisho vya Mungu vimejipanga dhidi yangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Je, punda-mwitu hulia akiwa na majani,","poem":1},{"text":"au fahali hulia akiwa na chakula?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, chakula kisicho na ladha huliwa bila chumvi,","poem":1},{"text":"au upo utamu katika ute mweupe wa yai?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ninakataa kuvigusa;","poem":1},{"text":"vyakula vya aina hii hunichukiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Laiti ningepata haja yangu,","poem":1},{"text":"kwamba Mungu angenijalia hilo nililotarajia,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"kwamba Mungu angekuwa radhi kuniponda,","poem":1},{"text":"kuuachia mkono wake na kunikatilia mbali!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ndipo bado ningekuwa na hii faraja,","poem":1},{"text":"furaha yangu katika maumivu makali:","poem":2},{"lineBreak":true},{"text":"kwamba sikuwa nimeyakana maneno yake yeye Aliye Mtakatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Nina nguvu gani, hata niendelee kutumaini?","poem":1},{"text":"Matazamio yangu ni nini,","poem":2},{"lineBreak":true},{"text":"hata niendelee kuwa mvumilivu?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Je, mimi nina nguvu za jiwe?","poem":1},{"text":"Je, mwili wangu ni shaba?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Je, ninao uwezo wowote wa kujisaidia mimi mwenyewe,","poem":1},{"text":"wakati mafanikio yamefukuziwa mbali nami?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Mtu anayekata tamaa angetazamia moyo wa kujitoa wa rafiki zake,","poem":1},{"text":"hata akiacha uchaji wa Mwenyezi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lakini ndugu zangu sio wa kutegemewa,","poem":1},{"text":"ni kama vijito vya msimu,","poem":2},{"lineBreak":true},{"text":"ni kama vijito ambavyo hufurika","poem":2}]},{"type":"verse","number":16,"content":[{"text":"wakati vimefunikwa barafu iyeyukayo,","poem":1},{"text":"ambavyo hujazwa na theluji inayoyeyuka,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"lakini hukauka majira ya ukame,","poem":1},{"text":"na wakati wa hari hutoweka katika mikondo yake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Misafara hugeuka kutoka njia zake;","poem":1},{"text":"hukwea kwenda kwenye nchi ya ukiwa na kuangamia.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Misafara ya Tema inatafuta maji,","poem":1},{"text":"wafanyabiashara wa Sheba wanaosafiri","poem":2},{"lineBreak":true},{"text":"hutazama kwa matarajio.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wamedhikika, kwa sababu walikuwa na matumaini;","poem":1},{"text":"wanafika huko, lakini wanahuzunika","poem":2},{"lineBreak":true},{"text":"kwa kukosa walichotarajia.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Sasa nanyi mmethibitika","poem":1},{"text":"kwamba hamna msaada wowote;","poem":2},{"text":"mnaona jambo la kutisha,","poem":1},{"text":"nanyi mnaogopa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Je, nimewahi kusema, ‘Toeni kitu kwa ajili yangu,","poem":1},{"text":"au mnilipie fidia kutoka mali yenu,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"au niokoeni mikononi mwa adui,","poem":1},{"text":"au nikomboeni kutoka makucha ya wasio na huruma’?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“Nifundisheni, nami nitakaa kimya;","poem":1},{"text":"nionesheni nilikokosea.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Tazama yalivyo ya kuumiza maneno ya kweli!","poem":1},{"text":"Lakini mabishano yenu yanathibitisha nini?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Je, mna maana ya kuyasahihisha ninayosema,","poem":1},{"text":"na kuyafanya maneno ya mtu anayekata tamaa kama upepo?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mngeweza hata kupiga kura kwa ajili ya yatima,","poem":1},{"text":"na kubadilishana rafiki yenu na mali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“Lakini sasa kuweni na huruma mkaniangalie mimi.","poem":1},{"text":"Je, ningeweza kusema uongo mbele zenu?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Tulizeni hasira, msiwe wadhalimu;","poem":1},{"text":"angalieni tena, kwa maana nimehatarisha uadilifu wangu","poem":2},{"noteId":6},{"text":".","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Je, pana uovu wowote mdomoni mwangu?","poem":1},{"text":"Je, kinywa changu hakiwezi kupambanua hila?","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"au haki yangu bado inasimama","reference":{"chapter":6,"verse":29}}]},"thisChapterLink":"/api/swh_onmm/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}