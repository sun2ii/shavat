{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOB","translationId":"swh_onmm","name":"Ayubu","commonName":"Ayubu","title":"Ayubu","order":18,"numberOfChapters":42,"sha256":"af866cf308dba7a418a41066a0d7c7db2bc3591640eb8c5d7db6a075c2394081","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/swh_onmm/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"heading","content":["Ayubu anaendelea"]},{"type":"verse","number":1,"content":[{"text":"“Je, mwanadamu hana kazi ngumu duniani?","poem":1},{"text":"Siku zake si kama zile za mtu aliyeajiriwa?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama mtumwa anavyovionea shauku vivuli vya jioni,","poem":1},{"text":"au mtu aliyeajiriwa anavyoungojea mshahara wake,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ndivyo nilivyogawiwa miezi ya ubatili,","poem":1},{"text":"nami nimeandikiwa huzuni usiku hata usiku.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nilalapo ninawaza, ‘Itachukua muda gani kabla sijaamka?’","poem":1},{"text":"Usiku huwa mrefu, nami najigeuzageuza hadi mapambazuko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwili wangu umevikwa mabuu na uchafu,","poem":1},{"text":"ngozi yangu imetumbuka na kutunga usaha.","poem":2}]},{"type":"line_break"},{"type":"heading","content":["Ayubu amlilia Mwenyezi Mungu"]},{"type":"verse","number":6,"content":[{"text":"“Siku zangu zinapita upesi kuliko mtande wa kufuma,","poem":1},{"text":"nazo zinafikia mwisho wake bila matumaini.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kumbuka, Ee Mungu, maisha yangu ni kama pumzi;","poem":1},{"text":"macho yangu kamwe hayataona tena raha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lile jicho linaloniona sasa halitaniona tena;","poem":1},{"text":"utanitafuta, wala sitakuwepo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kama vile wingu liondokavyo na kutoweka,","poem":1},{"text":"vivyo hivyo yeye ashukaye kaburini","poem":2},{"noteId":7},{"text":"harudi tena.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kamwe harudi tena nyumbani mwake;","poem":1},{"text":"wala mahali pake hapatamjua tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Kwa hiyo sitanyamaza;","poem":1},{"text":"nitanena kutokana na maumivu makuu ya roho yangu,","poem":2},{"lineBreak":true},{"text":"nitalalama kwa uchungu wa nafsi yangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Je, mimi ni bahari, au yule mnyama mkubwa wa baharini,","poem":1},{"text":"hata uniweke chini ya ulinzi?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ninapofikiri kwamba kitanda changu kitanifariji,","poem":1},{"text":"nacho kiti changu cha fahari kitapunguza malalamiko yangu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ndipo wanitisha kwa ndoto","poem":1},{"text":"na kunitia hofu kwa maono,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"hivyo ninachagua kujinyonga na kufa,","poem":1},{"text":"kuliko huu mwili wangu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ninayachukia maisha yangu; nisingetamani kuendelea kuishi.","poem":1},{"text":"Niache; siku zangu ni ubatili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Mwanadamu ni kitu gani hata umjali kiasi hiki,","poem":1},{"text":"kwamba unamtia sana maanani,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kwamba unamwangalia kila asubuhi","poem":1},{"text":"na kumjaribu kila wakati?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Je, hutaacha kamwe kunitazama,","poem":1},{"text":"au kuniacha japo kwa kitambo kidogo tu?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ikiwa nimetenda dhambi, nimekufanyia nini,","poem":1},{"text":"Ewe mlinzi wa wanadamu?","poem":2},{"text":"Kwa nini umeniweka niwe shabaha yako?","poem":1},{"text":"Je, nimekuwa mzigo kwako?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwa nini husamehi makosa yangu","poem":1},{"text":"na kuachilia dhambi zangu?","poem":2},{"text":"Kwa kuwa hivi karibuni nitalala mavumbini;","poem":1},{"text":"nawe utanitafuta, wala sitakuwepo.”","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"Kaburini maana yake ni Kuzimu; kwa Kiebrania ni Sheol.","reference":{"chapter":7,"verse":9}}]},"thisChapterLink":"/api/swh_onmm/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}