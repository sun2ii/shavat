{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOL","translationId":"swh_onmm","name":"Yoeli","commonName":"Yoeli","title":"Yoeli","order":29,"numberOfChapters":3,"sha256":"6b7bf0b6b85564525d97de492b5c0ca326bab0ee5a8637d610bb1e3a05525de2","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_onmm/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Neno la Mwenyezi Mungu ambalo lilimjia Yoeli mwana wa Pethueli."]},{"type":"line_break"},{"type":"heading","content":["Kuvamiwa wa nzige"]},{"type":"verse","number":2,"content":[{"text":"Sikilizeni hili, enyi wazee;","poem":1},{"text":"sikilizeni, ninyi nyote mnaoishi katika nchi.","poem":2},{"text":"Je, jambo kama hili lilishawahi kutokea","poem":1},{"text":"katika siku zenu au katika siku za babu zenu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Waelezeni watoto wenu,","poem":1},{"text":"na watoto wenu wawaambie watoto wao,","poem":2},{"lineBreak":true},{"text":"na watoto wao kwa kizazi kitakachofuata.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kilichosazwa na kundi la tunutu","poem":1},{"text":"nzige wakubwa wamekula,","poem":2},{"text":"kilichosazwa na nzige wakubwa","poem":1},{"text":"parare wamekula,","poem":2},{"text":"kilichosazwa na parare","poem":1},{"text":"madumadu wamekula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Amkeni, enyi walevi, mlie!","poem":1},{"text":"Pigeni yowe enyi wanywaji wote wa mvinyo,","poem":2},{"text":"pigeni yowe kwa sababu ya mvinyo mpya,","poem":1},{"text":"kwa kuwa mmenyang’anywa","poem":2},{"lineBreak":true},{"text":"kutoka midomoni mwenu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Taifa limevamia nchi yangu,","poem":1},{"text":"lenye nguvu tena lisilo na idadi;","poem":2},{"text":"lina meno ya simba,","poem":1},{"text":"magego ya simba jike.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Limeharibu mizabibu yangu","poem":1},{"text":"na kuangamiza mitini yangu.","poem":2},{"text":"Limebambua magome yake","poem":1},{"text":"na kuyatupilia mbali,","poem":2},{"lineBreak":true},{"text":"likayaacha matawi yake yakiwa meupe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Omboleza kama bikira aliyevaa gunia","poem":1},{"text":"akimwomboleza mume wa ujana wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sadaka za nafaka na sadaka za kinywaji","poem":1},{"text":"zimekatiliwa mbali kutoka nyumba ya Mwenyezi Mungu.","poem":2},{"text":"Makuhani wanaomboleza,","poem":1},{"text":"wale wanaohudumu mbele za Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mashamba yameharibiwa,","poem":1},{"text":"ardhi imekauka;","poem":2},{"text":"nafaka imeharibiwa,","poem":1},{"text":"mvinyo mpya umekauka,","poem":2},{"lineBreak":true},{"text":"mafuta yamekoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kateni tamaa, enyi wakulima,","poem":1},{"text":"lieni, enyi mlimao mizabibu;","poem":2},{"text":"huzunikeni kwa ajili ya ngano na shayiri,","poem":1},{"text":"kwa sababu mavuno ya shambani yameharibiwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mzabibu umekauka","poem":1},{"text":"na mtini umenyauka;","poem":2},{"text":"mkomamanga, mtende na mtofaa,","poem":1},{"text":"miti yote shambani, imekauka.","poem":2},{"text":"Hakika furaha yote ya mwanadamu","poem":1},{"text":"imeondoka.","poem":2}]},{"type":"heading","content":["Wito wa kuomboleza"]},{"type":"verse","number":13,"content":[{"text":"Vaeni gunia, enyi makuhani, mwomboleze;","poem":1},{"text":"pigeni yowe, enyi mnaohudumu madhabahuni.","poem":2},{"text":"Njooni, vaeni gunia usiku kucha,","poem":1},{"text":"enyi mnaohudumu mbele za Mungu wangu;","poem":2},{"text":"kwa kuwa sadaka za nafaka na sadaka za kinywaji","poem":1},{"text":"zimezuiliwa kufika katika nyumba ya Mungu wenu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tangazeni saumu takatifu;","poem":1},{"text":"liiteni kusanyiko takatifu.","poem":2},{"text":"Waiteni wazee","poem":1},{"text":"na wote wanaoishi katika nchi","poem":2},{"text":"waende katika nyumba ya Mwenyezi Mungu, Mungu wenu,","poem":1},{"text":"wakamlilie Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Ole kwa siku hiyo!","poem":1},{"text":"Kwa kuwa siku ya Mwenyezi Mungu iko karibu;","poem":2},{"text":"itakuja kama uharibifu","poem":1},{"text":"kutoka kwa Mwenyezi.","poem":2},{"noteId":0}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Je, chakula hakikukatiliwa mbali","poem":1},{"text":"mbele ya macho yetu:","poem":2},{"text":"furaha na shangwe","poem":1},{"text":"kutoka nyumba ya Mungu wetu?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbegu zinakauka","poem":1},{"text":"chini ya mabonge ya udongo.","poem":2},{"text":"Maghala yameachwa katika uharibifu,","poem":1},{"text":"maghala ya nafaka yamebomolewa,","poem":2},{"lineBreak":true},{"text":"kwa maana hakuna nafaka.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Jinsi gani ng’ombe wanavyolia!","poem":1},{"text":"Makundi ya mifugo yanahangaika","poem":2},{"text":"kwa sababu hawana malisho;","poem":1},{"text":"hata makundi ya kondoo yanateseka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kwako, Ee Mwenyezi Mungu, naita,","poem":1},{"text":"kwa kuwa moto umeteketeza","poem":2},{"lineBreak":true},{"text":"malisho ya mbugani","poem":2},{"text":"na miali ya moto imeunguza","poem":1},{"text":"miti yote shambani.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hata wanyama pori wanakuonea shauku;","poem":1},{"text":"vijito vya maji vimekauka,","poem":2},{"text":"na moto umeteketeza","poem":1},{"text":"malisho yote ya mbugani.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Mwenyezi hapa ina maana ya Shaddai kwa Kiebrania.","reference":{"chapter":1,"verse":15}}]},"thisChapterLink":"/api/swh_onmm/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}