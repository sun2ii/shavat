{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JOL","translationId":"swh_onmm","name":"Yoeli","commonName":"Yoeli","title":"Yoeli","order":29,"numberOfChapters":3,"sha256":"6b7bf0b6b85564525d97de492b5c0ca326bab0ee5a8637d610bb1e3a05525de2","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_onmm/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["Jeshi la nzige"]},{"type":"verse","number":1,"content":[{"text":"Pigeni tarumbeta katika Sayuni;","poem":1},{"text":"pigeni mbiu katika mlima wangu mtakatifu.","poem":2},{"lineBreak":true},{"text":"Wote wanaoishi katika nchi na watetemeke,","poem":1},{"text":"kwa kuwa siku ya Mwenyezi Mungu inakuja. Iko karibu,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"siku ya giza na huzuni,","poem":1},{"text":"siku ya mawingu na utusitusi.","poem":2},{"text":"Kama mapambazuko yanavyosambaa","poem":1},{"text":"toka upande huu wa milima","poem":2},{"lineBreak":true},{"text":"hata upande mwingine,","poem":2},{"lineBreak":true},{"text":"jeshi kubwa na lenye nguvu linakuja.","poem":2},{"text":"Jambo kama hili halijakuwepo tangu zamani,","poem":1},{"text":"wala halitakuwepo tena kamwe","poem":2},{"lineBreak":true},{"text":"kwa vizazi vijavyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mbele yao moto unateketeza,","poem":1},{"text":"nyuma yao miali ya moto","poem":2},{"lineBreak":true},{"text":"inawaka kwa nguvu.","poem":2},{"text":"Mbele yao nchi iko kama bustani ya Edeni,","poem":1},{"text":"nyuma yao ni jangwa lisilofaa:","poem":2},{"lineBreak":true},{"text":"hakuna kitu kinachowaepuka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wanaonekana kama farasi;","poem":1},{"text":"wanaenda mbio","poem":2},{"lineBreak":true},{"text":"kama askari wapanda farasi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wanatoa sauti kama magari ya vita,","poem":1},{"text":"wanaporukaruka juu ya vilele vya milima,","poem":2},{"text":"kama mlio wa miali ya moto ilayo mabua,","poem":1},{"text":"kama jeshi kubwa lililojipanga kwa ajili ya vita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wanapoonekana, mataifa yanakuwa katika maumivu makuu;","poem":1},{"text":"kila uso unabadilika rangi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wanashambulia kama mashujaa;","poem":1},{"text":"wanapanda kuta kama askari.","poem":2},{"text":"Wote wanatembea katika safu,","poem":1},{"text":"hawapotoshi safu zao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hakuna anayemsukuma mwenzake;","poem":1},{"text":"kila mmoja anaenda mbele moja kwa moja.","poem":2},{"text":"Wanapita katika vizuizi","poem":1},{"text":"bila kuharibu safu zao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wanaenda kasi kuingia mjini;","poem":1},{"text":"wanakimbia ukutani.","poem":2},{"text":"Wanaingia ndani ya nyumba;","poem":1},{"text":"kwa kuingilia madirishani kama wezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mbele yao dunia inatikisika,","poem":1},{"text":"anga linatetemeka,","poem":2},{"text":"jua na mwezi vinatiwa giza,","poem":1},{"text":"na nyota hazitoi mwanga wake tena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu anatoa mshindo wa ngurumo","poem":1},{"text":"mbele ya jeshi lake;","poem":2},{"text":"majeshi yake hayana idadi,","poem":1},{"text":"ni wenye nguvu nyingi","poem":2},{"lineBreak":true},{"text":"wale ambao hutii agizo lake.","poem":2},{"text":"Siku ya Mwenyezi Mungu ni kuu,","poem":1},{"text":"ni ya kutisha.","poem":2},{"lineBreak":true},{"text":"Ni nani anayeweza kuistahimili?","poem":2}]},{"type":"heading","content":["Rarueni mioyo yenu"]},{"type":"verse","number":12,"content":[{"text":"“Hata sasa,” asema Mwenyezi Mungu,","poem":1},{"text":"“nirudieni kwa mioyo yenu yote,","poem":2},{"lineBreak":true},{"text":"kwa kufunga, kwa kulia na kuomboleza.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Rarueni mioyo yenu","poem":1},{"text":"na siyo mavazi yenu.","poem":2},{"text":"Mrudieni Mwenyezi Mungu, Mungu wenu,","poem":1},{"text":"kwa maana yeye ndiye mwenye neema","poem":2},{"lineBreak":true},{"text":"na mwingi wa huruma,","poem":2},{"text":"si mwepesi wa hasira, ni mwingi wa upendo,","poem":1},{"text":"huona huruma, hujizuia kuleta maafa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ni nani ajuaye? Yeye aweza kugeuka na kuwa na huruma","poem":1},{"text":"na kuacha baraka nyuma yake:","poem":2},{"text":"sadaka za nafaka na sadaka za vinywaji","poem":1},{"text":"kwa ajili ya Mwenyezi Mungu, Mungu wenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Pigeni tarumbeta katika Sayuni,","poem":1},{"text":"tangazeni saumu takatifu,","poem":2},{"lineBreak":true},{"text":"liiteni kusanyiko takatifu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wakusanyeni watu,","poem":1},{"text":"wekeni wakfu kusanyiko;","poem":2},{"text":"waleteni pamoja wazee,","poem":1},{"text":"wakusanyeni watoto,","poem":2},{"lineBreak":true},{"text":"wale wanyonyao maziwa.","poem":2},{"text":"Bwana arusi na atoke chumbani mwake","poem":1},{"text":"na bibi arusi naye atoke katika chumba chake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Makuhani, ambao wanahudumu mbele za Mwenyezi Mungu,","poem":1},{"text":"na walie katikati ya ukumbi","poem":2},{"lineBreak":true},{"text":"wa Hekalu na madhabahu.","poem":2},{"text":"Waseme, “Wahurumie watu wako, Ee Mwenyezi Mungu.","poem":1},{"text":"Usifanye urithi wako kitu cha kudharauliwa,","poem":2},{"lineBreak":true},{"text":"neno la dhihaka kati ya mataifa.","poem":2},{"text":"Kwa nini wasemezane miongoni mwao,","poem":1},{"text":"‘Yuko wapi Mungu wao?’ ”","poem":2}]},{"type":"heading","content":["Jibu la Mwenyezi Mungu"]},{"type":"verse","number":18,"content":[{"text":"Kisha Mwenyezi Mungu atakuwa na wivu kwa ajili ya nchi yake","poem":1},{"text":"na kuwa na huruma juu ya watu wake.","poem":2}]},{"type":"verse","number":19,"content":["Mwenyezi Mungu atawajibu:",{"text":"“Ninawapelekea nafaka,","poem":1},{"text":"mvinyo mpya na mafuta,","poem":2},{"text":"vya kuwatosha ninyi","poem":1},{"text":"hadi mridhike kabisa;","poem":2},{"text":"kamwe sitawafanya tena","poem":1},{"text":"kitu cha kudharauliwa na mataifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Nitafukuza jeshi la kaskazini likae mbali nanyi,","poem":1},{"text":"nikilisukuma ndani ya jangwa,","poem":2},{"text":"askari wa safu za mbele wakienda","poem":1},{"text":"ndani ya bahari ya mashariki","poem":2},{"text":"na wale wa safu za nyuma","poem":1},{"text":"katika bahari ya magharibi.","poem":2},{"text":"Uvundo wake utapaa juu;","poem":1},{"text":"harufu yake itapanda juu.”","poem":2},{"lineBreak":true},{"text":"Hakika ametenda mambo makubwa.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"Usiogope, ee nchi;","poem":2},{"lineBreak":true},{"text":"furahi na kushangilia.","poem":2},{"text":"Hakika Mwenyezi Mungu ametenda mambo makubwa.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"Msiogope, enyi wanyama pori,","poem":2},{"text":"kwa kuwa mbuga za malisho yenu","poem":1},{"text":"zinarudia ubichi.","poem":2},{"text":"Miti nayo inazaa matunda,","poem":1},{"text":"mtini na mzabibu inatoa utajiri wake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Furahini, enyi watu wa Sayuni,","poem":1},{"text":"shangilieni katika Mwenyezi Mungu, Mungu wenu,","poem":2},{"text":"kwa kuwa amewapa mvua za vuli","poem":1},{"text":"kwa kipimo cha haki.","poem":2},{"text":"Anawapelekea mvua nyingi,","poem":1},{"text":"mvua ya vuli na ya masika, kama mwanzoni.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sakafu za kupuria zitajaa nafaka,","poem":1},{"text":"mapipa yatafurika mvinyo mpya na mafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Nitawalipa kwa ajili ya miaka ile iliyoliwa na nzige:","poem":1},{"text":"parare, madumadu na tunutu,","poem":2},{"text":"jeshi langu kubwa ambalo","poem":1},{"text":"nililituma kati yenu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mtakuwa na wingi wa vyakula hadi mshibe,","poem":1},{"text":"na mtalisifu jina la Mwenyezi Mungu, Mungu wenu,","poem":2},{"text":"ambaye amefanya maajabu kwa ajili yenu;","poem":1},{"text":"kamwe watu wangu hawataaibishwa tena.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ndipo mtajua kuwa mimi niko katika Israeli,","poem":1},{"text":"kuwa mimi ndimi Mwenyezi Mungu, Mungu wenu,","poem":2},{"lineBreak":true},{"text":"na kwamba hakuna mwingine;","poem":2},{"text":"kamwe watu wangu hawataaibika tena.","poem":1}]},{"type":"heading","content":["Siku ya Mwenyezi Mungu"]},{"type":"verse","number":28,"content":[{"text":"“Hata itakuwa, baada ya hayo,","poem":1},{"text":"nitamimina Roho wangu Mtakatifu juu ya wote wenye mwili.","poem":2},{"text":"Wana wenu wa kiume na wa kike watatabiri,","poem":1},{"text":"wazee wenu wataota ndoto,","poem":2},{"lineBreak":true},{"text":"na vijana wenu wataona maono.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Hata juu ya watumishi wangu, wanaume kwa wanawake,","poem":1},{"text":"katika siku zile nitamimina Roho wangu Mtakatifu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nami nitaonesha maajabu katika mbingu","poem":1},{"text":"na duniani:","poem":2},{"lineBreak":true},{"text":"damu, moto na mawimbi ya moshi.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Jua litageuzwa kuwa giza","poem":1},{"text":"na mwezi kuwa mwekundu kama damu,","poem":2},{"text":"kabla ya kuja siku ya Mwenyezi Mungu","poem":1},{"text":"ile kuu na ya kutisha.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Na kila mtu atakayeliitia","poem":1},{"text":"jina la Mwenyezi Mungu ataokolewa.","poem":2},{"text":"Kwa maana juu ya Mlima Sayuni na katika Yerusalemu","poem":1},{"text":"kutakuwa na wokovu,","poem":2},{"lineBreak":true},{"text":"kama Mwenyezi Mungu alivyosema,","poem":2},{"text":"miongoni mwa walionusurika","poem":1},{"text":"ambao Mwenyezi Mungu awaita.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}