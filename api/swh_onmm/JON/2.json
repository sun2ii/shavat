{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"JON","translationId":"swh_onmm","name":"Yona","commonName":"Yona","title":"Yona","order":32,"numberOfChapters":4,"sha256":"81c66eaf5065e4a1dade5be6169639a59b9204aef42db0e61ebaec4844974241","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/swh_onmm/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Maombi ya Yona na kuokolewa"]},{"type":"verse","number":1,"content":["Akiwa ndani ya tumbo la samaki, Yona alimwomba Mwenyezi Mungu, Mungu wake."]},{"type":"verse","number":2,"content":["Akasema:",{"text":"“Katika shida yangu nalimwita Mwenyezi Mungu,","poem":1},{"text":"naye akanijibu.","poem":2},{"text":"Kutoka kina cha kaburi","poem":1},{"noteId":0},{"text":"niliomba msaada,","poem":1},{"text":"nawe ukasikiliza kilio changu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ulinitupa kwenye kilindi,","poem":1},{"text":"ndani kabisa ya moyo wa bahari,","poem":2},{"lineBreak":true},{"text":"mikondo ya maji ilinizunguka;","poem":2},{"text":"mawimbi yako yote na viwimbi","poem":1},{"text":"vilipita juu yangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nikasema, ‘Nimefukuziwa","poem":1},{"text":"mbali na uso wako,","poem":2},{"text":"hata hivyo nitatazama tena","poem":1},{"text":"kuelekea Hekalu lako takatifu.’","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Maji yaliyonimeza yalinitisha,","poem":1},{"text":"kilindi kilinizunguka;","poem":2},{"lineBreak":true},{"text":"mwani ulijisokota kichwani pangu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nilizama chini sana hata pande za mwisho za milima,","poem":1},{"text":"makomeo ya hiyo nchi yalinifungia hata milele.","poem":2},{"text":"Lakini uliuleta uhai wangu kutoka shimoni,","poem":1},{"text":"Ee Mwenyezi Mungu, Mungu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Uhai wangu ulipokuwa unatoka,","poem":1},{"text":"nilikukumbuka wewe, Mwenyezi Mungu,","poem":2},{"text":"nayo maombi yangu yalikufikia wewe,","poem":1},{"text":"katika Hekalu lako takatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Wale watu wanaoshikilia sanamu batili","poem":1},{"text":"hupoteza neema yao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lakini mimi nitakutolea dhabihu,","poem":1},{"text":"kwa sauti za shukrani na shangwe.","poem":2},{"text":"Lile nililowekea nadhiri nitalitimiza.","poem":1},{"text":"Wokovu watoka kwa Mwenyezi Mungu.”","poem":2}]},{"type":"verse","number":10,"content":["Basi Mwenyezi Mungu akamwamuru yule samaki, naye akamtapika Yona katika nchi kavu."]}],"footnotes":[{"noteId":0,"caller":"+","text":"Kaburi hapa maana yake ni Kuzimu; kwa Kiebrania ni Sheol.","reference":{"chapter":2,"verse":2}}]},"thisChapterLink":"/api/swh_onmm/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}