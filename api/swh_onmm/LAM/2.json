{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"LAM","translationId":"swh_onmm","name":"Maombolezo","commonName":"Maombolezo","title":"Maombolezo","order":25,"numberOfChapters":5,"sha256":"a41fec3037269dc8afff12cf464cd655437afe0b7464d48a45d9ae029ea8aab7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swh_onmm/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"Tazama jinsi Bwana alivyomfunika Binti Sayuni","poem":1},{"text":"kwa wingu la hasira yake!","poem":2},{"text":"Ameitupa chini fahari ya Israeli","poem":1},{"text":"kutoka mbinguni hadi duniani,","poem":2},{"text":"hakukumbuka kiti chake cha kuwekea miguu","poem":1},{"text":"katika siku ya hasira yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bila huruma Bwana ameyameza","poem":1},{"text":"makao yote ya Yakobo;","poem":2},{"text":"katika ghadhabu yake amebomoa","poem":1},{"text":"ngome za Binti Yuda.","poem":2},{"text":"Ameuangusha ufalme wake na wakuu wake","poem":1},{"text":"chini kwa aibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Katika hasira kali amevunja","poem":1},{"text":"kila pembe","poem":2},{"noteId":0},{"text":"ya Israeli.","poem":2},{"text":"Ameuondoa mkono wake wa kuume","poem":1},{"text":"alipokaribia adui.","poem":2},{"text":"Amemteketeza Yakobo kama moto uwakao","poem":1},{"text":"ule uteketezao kila kitu kinachouzunguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ameupinda upinde wake kama adui,","poem":1},{"text":"mkono wake wa kuume uko tayari.","poem":2},{"text":"Kama vile adui amewaua","poem":1},{"text":"wote waliokuwa wanapendeza jicho,","poem":2},{"text":"amemwaga ghadhabu yake kama moto","poem":1},{"text":"juu ya hema la Binti Sayuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwana ni kama adui;","poem":1},{"text":"amemmeza Israeli.","poem":2},{"text":"Ameyameza majumba yake yote ya kifalme","poem":1},{"text":"na kuangamiza ngome zake.","poem":2},{"text":"Ameongeza huzuni na maombolezo","poem":1},{"text":"kwa Binti Yuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ameharibu maskani yake kama bustani,","poem":1},{"text":"ameharibu mahali pake pa mkutano.","poem":2},{"text":"Mwenyezi Mungu amemfanya Sayuni kusahau","poem":1},{"text":"sikukuu zake zilizoamriwa na Sabato zake;","poem":2},{"text":"katika hasira yake kali amewadharau","poem":1},{"text":"mfalme na kuhani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bwana amekataa madhabahu yake","poem":1},{"text":"na kuacha mahali patakatifu pake.","poem":2},{"text":"Amemkabidhi adui kuta","poem":1},{"text":"za majumba yake ya kifalme;","poem":2},{"text":"wameshangilia katika nyumba ya Mwenyezi Mungu","poem":1},{"text":"kama katika siku ya sikukuu iliyoamriwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu alikusudia kuangusha","poem":1},{"text":"ukuta uliomzunguka Binti Sayuni.","poem":2},{"text":"Ameinyoosha kamba ya kupimia","poem":1},{"text":"na hakuuzuia mkono wake usiangamize.","poem":2},{"text":"Alifanya maboma na kuta ziomboleze,","poem":1},{"text":"vyote vikaharibika pamoja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Malango yake yamezama ardhini,","poem":1},{"text":"makomeo yake ameyavunja na kuyaharibu.","poem":2},{"text":"Mfalme wake na wakuu wake wamepelekwa uhamishoni","poem":1},{"text":"miongoni mwa mataifa,","poem":2},{"lineBreak":true},{"text":"sheria haipo tena,","poem":2},{"text":"na manabii wake hawapati tena","poem":1},{"text":"maono kutoka kwa Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wazee wa Binti Sayuni","poem":1},{"text":"wanaketi chini kimya,","poem":2},{"text":"wamenyunyiza mavumbi kwenye vichwa vyao","poem":1},{"text":"na kuvaa gunia.","poem":2},{"text":"Wanawali wa Yerusalemu","poem":1},{"text":"wameinamisha vichwa vyao hadi chini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Macho yangu yamedhoofika kwa kulia,","poem":1},{"text":"nina maumivu makali ndani,","poem":2},{"text":"moyo wangu umemiminwa ardhini","poem":1},{"text":"kwa sababu watu wangu wameangamizwa,","poem":2},{"text":"kwa sababu watoto na wanyonyao wanazimia","poem":1},{"text":"kwenye barabara za mji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wanawaambia mama zao,","poem":1},{"text":"“Wapi mkate na divai?”","poem":2},{"text":"wazimiapo kama watu waliojeruhiwa","poem":1},{"text":"katika barabara za mji,","poem":2},{"text":"maisha yao yadhoofikavyo","poem":1},{"text":"mikononi mwa mama zao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ninaweza kusema nini kwa ajili yako?","poem":1},{"text":"Nikulinganishe na nini,","poem":2},{"lineBreak":true},{"text":"ee Binti Yerusalemu?","poem":2},{"text":"Nitakufananisha na nini,","poem":1},{"text":"ili nipate kukufariji,","poem":2},{"lineBreak":true},{"text":"ee Bikira Binti Sayuni?","poem":2},{"text":"Jeraha lako lina kina kama bahari.","poem":1},{"text":"Ni nani awezaye kukuponya?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Maono ya manabii wako","poem":1},{"text":"yalikuwa ya uongo na yasiyofaa kitu,","poem":2},{"text":"hawakuifunua dhambi yako","poem":1},{"text":"ili kukuzuilia kwenda utumwani.","poem":2},{"text":"Maneno waliyokupa","poem":1},{"text":"yalikuwa ya uongo na ya kupotosha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Wote wapitiao njia yako","poem":1},{"text":"wanakupigia makofi,","poem":2},{"text":"wanakudhihaki na kutikisa vichwa vyao","poem":1},{"text":"kwa Binti Yerusalemu:","poem":2},{"text":"“Huu ndio ule mji ulioitwa","poem":1},{"text":"mkamilifu wa uzuri,","poem":2},{"lineBreak":true},{"text":"furaha ya dunia yote?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Adui zako wote wanapanua","poem":1},{"text":"vinywa vyao dhidi yako,","poem":2},{"text":"wanadhihaki na kusaga meno yao","poem":1},{"text":"na kusema, “Tumemmeza.","poem":2},{"text":"Hii ndiyo siku tuliyoingojea,","poem":1},{"text":"tumeishi na kuiona.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mwenyezi Mungu amefanya lile alilolipanga;","poem":1},{"text":"ametimiza neno lake","poem":2},{"lineBreak":true},{"text":"aliloliamuru siku za kale.","poem":2},{"text":"Amekuangusha bila huruma,","poem":1},{"text":"amewaacha adui wakusimange,","poem":2},{"lineBreak":true},{"text":"ametukuza pembe ya adui yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mioyo ya watu","poem":1},{"text":"inamlilia Bwana.","poem":2},{"text":"Ee ukuta wa Binti Sayuni,","poem":1},{"text":"machozi yako na yatiririke kama mto","poem":2},{"lineBreak":true},{"text":"usiku na mchana;","poem":2},{"text":"usijipe nafuu,","poem":1},{"text":"macho yako yasipumzike.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Inuka, lia usiku,","poem":1},{"text":"zamu za usiku zianzapo;","poem":2},{"text":"mimina moyo wako kama maji","poem":1},{"text":"mbele za Bwana.","poem":2},{"text":"Mwinulie yeye mikono yako","poem":1},{"text":"kwa ajili ya maisha ya watoto wako,","poem":2},{"text":"ambao wanazimia kwa njaa","poem":1},{"text":"kwenye kila mwanzo wa barabara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“Tazama, Ee Mwenyezi Mungu, ufikirie:","poem":1},{"text":"Ni nani ambaye umepata kumtendea namna hii?","poem":2},{"text":"Je, wanawake wale wazao wao,","poem":1},{"text":"watoto waliowalea?","poem":2},{"text":"Je, kuhani na nabii auawe","poem":1},{"text":"mahali patakatifu pa Bwana?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Vijana na wazee hujilaza pamoja","poem":1},{"text":"katika mavumbi ya barabarani,","poem":2},{"text":"wasichana wangu na wavulana wangu","poem":1},{"text":"wameanguka kwa upanga.","poem":2},{"text":"Umewaua katika siku ya hasira yako,","poem":1},{"text":"umewachinja bila huruma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Kama ulivyoita siku ya karamu,","poem":1},{"text":"ndivyo ulivyoagiza mapigo dhidi yangu kila upande.","poem":2},{"text":"Katika siku ya hasira ya Mwenyezi Mungu","poem":1},{"text":"hakuna yeyote aliyekwepa au kupona;","poem":2},{"text":"wale niliowatunza na kuwalea,","poem":1},{"text":"adui yangu amewaangamiza.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"pembe inawakilisha nguvu; pia 2:17","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/swh_onmm/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}