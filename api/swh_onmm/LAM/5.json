{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"LAM","translationId":"swh_onmm","name":"Maombolezo","commonName":"Maombolezo","title":"Maombolezo","order":25,"numberOfChapters":5,"sha256":"a41fec3037269dc8afff12cf464cd655437afe0b7464d48a45d9ae029ea8aab7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/swh_onmm/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Kumbuka, Ee Mwenyezi Mungu, yaliyotupata,","poem":1},{"text":"tazama, nawe uione aibu yetu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Urithi wetu umegeuziwa kwa wageni,","poem":1},{"text":"na nyumba zetu kwa wageni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tumekuwa yatima wasio na baba,","poem":1},{"text":"mama zetu wamekuwa kama wajane.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ni lazima tununue maji tunayokunywa,","poem":1},{"text":"kuni zetu zapatikana tu kwa kununua.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wanaotufuatilia wapo kwenye visigino vyetu,","poem":1},{"text":"tumechoka na hakuna pumziko.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tumejitolea kwa Misri na Ashuru","poem":1},{"text":"tupate chakula cha kutosha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Baba zetu walitenda dhambi na hawapo tena,","poem":1},{"text":"na sisi tunachukua adhabu yao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Watumwa wanatutawala","poem":1},{"text":"na hakuna wa kutuokoa mikononi yao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tunapata chakula chetu kwa kuhatarisha maisha yetu","poem":1},{"text":"kwa sababu ya upanga jangwani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ngozi yetu ina joto kama tanuru,","poem":1},{"text":"kutokana na fadhaa ya njaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wanawake wametendwa jeuri katika Sayuni,","poem":1},{"text":"na mabikira katika miji ya Yuda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wakuu wametungikwa juu kwa mikono yao,","poem":1},{"text":"wazee hawapewi heshima.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Vijana wanataabika kwenye mawe ya kusagia,","poem":1},{"text":"wavulana wanayumbayumba chini ya mizigo ya kuni.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wazee wameondoka katika lango la mji,","poem":1},{"text":"vijana wameacha kuimba nyimbo zao.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Furaha imeondoka mioyoni mwetu,","poem":1},{"text":"kucheza kwetu kumegeuka maombolezo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Taji limeanguka kutoka kichwani petu.","poem":1},{"text":"Ole wetu, kwa maana tumetenda dhambi!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwa sababu hiyo, mioyo yetu inazimia,","poem":1},{"text":"kwa sababu ya hayo, macho yetu yamefifia,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"kwa sababu Mlima Sayuni umekaa ukiwa,","poem":1},{"text":"na mbweha wanatembea juu yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Wewe, Ee Mwenyezi Mungu unatawala milele,","poem":1},{"text":"kiti chako cha enzi chadumu kizazi hadi kizazi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kwa nini watusahau siku zote?","poem":1},{"text":"Kwa nini umetuacha kwa muda mrefu?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Turudishe kwako mwenyewe, Ee Mwenyezi Mungu,","poem":1},{"text":"ili tupate kurudi.","poem":2},{"lineBreak":true},{"text":"Zifanye mpya siku zetu kama siku za kale,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"isipokuwa uwe umetukataa kabisa","poem":1},{"text":"na umetukasirikia pasipo kipimo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}