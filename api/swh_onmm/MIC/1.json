{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_onmm","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"002b07ef85820ab485273cb8b09b2075131be66c26dfff628096111abe611a81","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_onmm/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Neno la Mwenyezi Mungu lilimjia Mika Mmoreshethi wakati wa utawala wa Yothamu, Ahazi na Hezekia, wafalme wa Yuda, ufunuo aliouona kuhusu Samaria na Yerusalemu."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Sikieni, enyi mataifa, enyi nyote,","poem":1},{"text":"sikilizeni, ee dunia na wote mliomo,","poem":2},{"text":"ili Bwana Mungu Mwenyezi ashuhudie dhidi yenu,","poem":1},{"text":"Bwana kutoka Hekalu lake takatifu.","poem":2}]},{"type":"heading","content":["Hukumu dhidi ya Samaria na Yerusalemu"]},{"type":"verse","number":3,"content":[{"text":"Tazama! Mwenyezi Mungu anakuja kutoka mahali pake;","poem":1},{"text":"anashuka na kukanyaga","poem":2},{"lineBreak":true},{"text":"mahali palipoinuka juu pa dunia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Milima inayeyuka chini yake","poem":1},{"text":"na mabonde yanagawanyika","poem":2},{"text":"kama nta mbele ya moto,","poem":1},{"text":"kama maji yanayotiririka kasi","poem":2},{"lineBreak":true},{"text":"kwenye mteremko.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yote haya ni kwa sababu ya kosa la Yakobo,","poem":1},{"text":"ni kwa sababu ya dhambi za nyumba ya Israeli.","poem":2},{"text":"Kosa la Yakobo ni lipi?","poem":1},{"text":"Je, sio Samaria?","poem":2},{"text":"Je, mahali pa juu pa Yuda pa kuabudia ni nini?","poem":1},{"text":"Je, sio Yerusalemu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Kwa hiyo nitaufanya Samaria kuwa lundo la kokoto,","poem":1},{"text":"mahali pa kuotesha mizabibu.","poem":2},{"text":"Nitayamwaga mawe yake katika bonde","poem":1},{"text":"na kuacha wazi misingi yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Sanamu zake zote","poem":1},{"text":"zitavunjwa vipande vipande;","poem":2},{"text":"zawadi zake zote za Hekalu","poem":1},{"text":"zitachomwa kwa moto;","poem":2},{"lineBreak":true},{"text":"nitaharibu vinyago vyake vyote.","poem":2},{"text":"Kwa kuwa alikusanya zawadi zake","poem":1},{"text":"kutokana na ujira wa kahaba,","poem":2},{"text":"nazo zitatumika tena","poem":1},{"text":"kulipa mishahara ya kahaba.”","poem":2}]},{"type":"heading","content":["Kulia na kuomboleza"]},{"type":"verse","number":8,"content":[{"text":"Kwa ajili ya hili nitalia na kuomboleza;","poem":1},{"text":"nitatembea bila viatu na tena uchi.","poem":2},{"text":"Nitabweka kama mbweha","poem":1},{"text":"na kuomboleza kama bundi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa sababu jeraha lake halitibiki;","poem":1},{"text":"limekuja kwa Yuda.","poem":2},{"text":"Limefika hasa kwenye lango la watu wangu,","poem":1},{"text":"hata Yerusalemu kwenyewe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Usiliseme hili huko Gathi;","poem":1},{"text":"usilie hata kidogo.","poem":2},{"text":"Huko Beth-le-Afra","poem":1},{"text":"gaagaa mavumbini.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Piteni mkiwa uchi na wenye aibu,","poem":1},{"text":"ninyi mnaoishi Shafiri.","poem":2},{"text":"Wale wanaoishi Saanani","poem":1},{"text":"hawatatoka nje.","poem":2},{"text":"Beth-Eseli iko katika maombolezo;","poem":1},{"text":"kinga yake imeondolewa kwako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wale wanaoishi Marothi wanagaagaa kwa maumivu","poem":1},{"text":"wakingoja msaada,","poem":2},{"text":"kwa sababu maangamizi yamekuja","poem":1},{"text":"kutoka kwa Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"hata katika lango la Yerusalemu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Enyi mnaoishi Lakishi,","poem":1},{"text":"fungeni farasi kwenye magari ya vita.","poem":2},{"text":"Mlikuwa chanzo cha dhambi","poem":1},{"text":"kwa Binti Sayuni,","poem":2},{"text":"kwa kuwa makosa ya Israeli","poem":1},{"text":"yalikutwa kwako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa hiyo utaipa Moresheth-Gathi","poem":1},{"text":"zawadi za kuagana.","poem":2},{"text":"Mji wa Akzibu utaonesha wazi udanganyifu","poem":1},{"text":"kwa wafalme wa Israeli.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitawaleteeni atakayewashinda","poem":1},{"text":"ninyi mnaoishi Maresha.","poem":2},{"text":"Yeye aliye utukufu wa Israeli","poem":1},{"text":"atakuja Adulamu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nyoeni nywele zenu katika kuomboleza","poem":1},{"text":"kwa ajili ya watoto wenu mnaowafurahia;","poem":2},{"text":"jifanyieni upara kama tai,","poem":1},{"text":"kwa kuwa watawaacha","poem":2},{"lineBreak":true},{"text":"na kwenda uhamishoni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}