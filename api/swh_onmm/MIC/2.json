{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_onmm","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"002b07ef85820ab485273cb8b09b2075131be66c26dfff628096111abe611a81","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_onmm/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["Mipango ya mwanadamu na mipango ya Mwenyezi Mungu"]},{"type":"verse","number":1,"content":[{"text":"Ole kwa wale wapangao uovu,","poem":1},{"text":"kwa wale wapangao hila vitandani mwao!","poem":2},{"text":"Kunapopambazuka wanalitimiza","poem":1},{"text":"kwa sababu uko katika uwezo wao kutekeleza.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wanatamani mashamba na kuyakamata,","poem":1},{"text":"pia nyumba na kuzichukua.","poem":2},{"text":"Wanamlaghai mwanaume nyumba yake,","poem":1},{"text":"mwanadamu mwenzake urithi wake.","poem":2}]},{"type":"verse","number":3,"content":["Kwa hiyo, Mwenyezi Mungu asema:",{"text":"“Ninapanga maangamizi dhidi ya watu hawa,","poem":1},{"text":"ambayo hamwezi kujiokoa wenyewe.","poem":2},{"text":"Hamtatembea tena kwa majivuno,","poem":1},{"text":"kwa kuwa utakuwa ni wakati wa maafa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Siku hiyo watu watawadhihaki,","poem":1},{"text":"watawafanyia mzaha","poem":2},{"lineBreak":true},{"text":"kwa wimbo huu wa maombolezo:","poem":2},{"text":"‘Tumeangamizwa kabisa;","poem":1},{"text":"mali ya watu wangu imegawanywa.","poem":2},{"text":"Ameninyang’anya!","poem":1},{"text":"Ametoa mashamba yetu kwa wasaliti.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa hiyo hutakuwa na yeyote katika kusanyiko la Mwenyezi Mungu","poem":1},{"text":"wa kugawanya mashamba kwa kura.","poem":2}]},{"type":"heading","content":["Manabii wa uongo"]},{"type":"verse","number":6,"content":[{"text":"Manabii wao husema, “Usitabiri.","poem":1},{"text":"Usitabiri kuhusu vitu hivi;","poem":2},{"lineBreak":true},{"text":"aibu haitatupata.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Je, ingesemwa, ee nyumba ya Yakobo:","poem":1},{"text":"“Je, Roho wa Mwenyezi Mungu amekasirika?","poem":2},{"lineBreak":true},{"text":"Je, yeye hufanya vitu kama hivyo?”","poem":2},{"lineBreak":true},{"text":"“Je, maneno yangu hayamfanyii mema","poem":1},{"text":"yeye ambaye njia zake ni nyofu?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siku hizi watu wangu wameinuka","poem":1},{"text":"kama adui.","poem":2},{"text":"Unawavua joho la kitajiri wale wanaopita","poem":1},{"text":"pasipo kujali,","poem":2},{"lineBreak":true},{"text":"kama watu warudio kutoka vitani.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Unawahamisha wanawake wa watu wangu","poem":1},{"text":"kutoka nyumba zao za kupendeza.","poem":2},{"text":"Unaondoa baraka yangu","poem":1},{"text":"kwa watoto wao milele.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Inuka, nenda zako!","poem":1},{"text":"Kwa maana hapa sio mahali pako pa kupumzikia,","poem":2},{"text":"kwa sababu pametiwa unajisi,","poem":1},{"text":"pameharibiwa, wala hapatengenezeki tena.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ikiwa mwongo na mdanganyifu atakuja na kusema,","poem":1},{"text":"‘Nitawatabiria divai na pombe kwa wingi,’","poem":2},{"text":"angekuwa ndiye nabii","poem":1},{"text":"anayekubalika na watu hawa!","poem":2}]},{"type":"heading","content":["Ahadi ya ukombozi"]},{"type":"verse","number":12,"content":[{"text":"“Hakika nitawakusanya ninyi nyote, ee Yakobo,","poem":1},{"text":"Hakika nitawaleta pamoja mabaki ya Israeli.","poem":2},{"text":"Nitawaleta pamoja kama kondoo ndani ya zizi,","poem":1},{"text":"kama kundi kwenye malisho yake,","poem":2},{"lineBreak":true},{"text":"mahali hapa patakuwa na msongamano wa watu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yeye afunguaye njia atawatangulia;","poem":1},{"text":"watapita kwenye lango na kutoka nje.","poem":2},{"text":"Mfalme wao atawatangulia,","poem":1},{"text":"Mwenyezi Mungu atakuwa kiongozi.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}