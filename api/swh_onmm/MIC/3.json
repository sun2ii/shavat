{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_onmm","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"002b07ef85820ab485273cb8b09b2075131be66c26dfff628096111abe611a81","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_onmm/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["Viongozi na manabii wakemewa"]},{"type":"verse","number":1,"content":["Kisha nikasema,",{"text":"“Sikilizeni enyi viongozi wa Yakobo,","poem":1},{"text":"enyi watawala wa nyumba ya Israeli.","poem":2},{"text":"Je, hampaswi kujua hukumu,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ninyi mnaochukia mema","poem":2},{"lineBreak":true},{"text":"na kupenda maovu;","poem":2},{"text":"ninyi mnaowachuna watu wangu ngozi","poem":1},{"text":"na kuondoa nyama kwenye mifupa yao;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ninyi mnaokula nyama ya watu wangu,","poem":1},{"text":"mnaowachuna ngozi","poem":2},{"lineBreak":true},{"text":"na kuvunja mifupa yao vipande vipande;","poem":2},{"text":"mnaowakatakata kama nyama","poem":1},{"text":"ya kuwekwa kwenye sufuria","poem":2},{"text":"na kama nyama","poem":1},{"text":"ya kuwekwa kwenye chungu?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kisha watamlilia Mwenyezi Mungu,","poem":1},{"text":"lakini hatawajibu.","poem":2},{"text":"Wakati huo atawaficha uso wake","poem":1},{"text":"kwa sababu ya uovu waliotenda.","poem":2}]},{"type":"verse","number":5,"content":["Hili ndilo asemalo Mwenyezi Mungu:",{"text":"“Kuhusu manabii wanaowapotosha watu wangu,","poem":1},{"text":"mtu akiwalisha,","poem":2},{"lineBreak":true},{"text":"wanatangaza ‘amani’;","poem":2},{"text":"kama hakufanya hivyo,","poem":1},{"text":"wanaandaa kupigana vita dhidi yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa hiyo usiku utawajieni, msiweze kuwa na maono,","poem":1},{"text":"na giza, msiweze kubashiri.","poem":2},{"text":"Jua litawachwea manabii hao,","poem":1},{"text":"nao mchana utakuwa giza kwao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waonaji wataaibika","poem":1},{"text":"na waaguzi watafedheheka.","poem":2},{"text":"Wote watafunika nyuso zao","poem":1},{"text":"kwa sababu hakuna jibu litokalo kwa Mungu.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lakini mimi nimejazwa nguvu,","poem":1},{"text":"nimejazwa Roho wa Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"haki na uweza,","poem":2},{"text":"kumtangazia Yakobo kosa lake,","poem":1},{"text":"na Israeli dhambi yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Sikieni hili, enyi viongozi wa nyumba ya Yakobo,","poem":1},{"text":"enyi watawala wa nyumba ya Israeli,","poem":2},{"text":"mnaodharau haki","poem":1},{"text":"na kupotosha kila lililo sawa;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"mnaojenga Sayuni kwa kumwaga damu","poem":1},{"text":"na Yerusalemu kwa uovu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Viongozi wake wanahukumu kwa rushwa,","poem":1},{"text":"na makuhani wake wanafundisha kwa malipo,","poem":2},{"lineBreak":true},{"text":"nao manabii wake wanatabiri kwa fedha.","poem":2},{"text":"Hata hivyo wanamwegemea Mwenyezi Mungu na kusema,","poem":1},{"text":"“Je, Mwenyezi Mungu si yumo miongoni mwetu?","poem":2},{"lineBreak":true},{"text":"Hakuna maafa yatakayotupata.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa ajili yenu,","poem":1},{"text":"Sayuni italimwa kama shamba,","poem":2},{"text":"Yerusalemu itakuwa lundo la kokoto,","poem":1},{"text":"na kilima cha Hekalu","poem":2},{"text":"kitakuwa kichuguu","poem":1},{"text":"kilichofunikwa na vichaka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}