{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_onmm","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"002b07ef85820ab485273cb8b09b2075131be66c26dfff628096111abe611a81","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_onmm/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["Mlima wa Mwenyezi Mungu"]},{"type":"verse","number":1,"content":["Katika siku za mwisho",{"text":"mlima wa Hekalu la Mwenyezi Mungu utaimarishwa","poem":1},{"text":"kama mlima mkuu miongoni mwa milima yote;","poem":2},{"text":"utainuliwa juu ya vilima,","poem":1},{"text":"na watu wa mataifa watamiminika humo.","poem":2}]},{"type":"verse","number":2,"content":["Mataifa mengi yatakuja na kusema,",{"text":"“Njooni, twendeni kwenye mlima wa Mwenyezi Mungu,","poem":1},{"text":"kwenye nyumba ya Mungu wa Yakobo.","poem":2},{"text":"Atatufundisha njia zake,","poem":1},{"text":"ili tuweze kuenenda katika mapito yake.”","poem":2},{"text":"Torati itatoka Sayuni,","poem":1},{"text":"neno la Mwenyezi Mungu litatoka Yerusalemu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Atahukumu kati ya mataifa mengi,","poem":1},{"text":"na ataamua migogoro ya mataifa","poem":2},{"lineBreak":true},{"text":"yenye nguvu na yaliyo mbali.","poem":2},{"text":"Watafua panga zao ziwe majembe,","poem":1},{"text":"na mikuki yao kuwa miundu ya kukata matawi.","poem":2},{"text":"Taifa halitainua upanga dhidi ya taifa jingine,","poem":1},{"text":"wala hawatajifunza vita tena.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kila mtu ataketi chini ya mzabibu wake","poem":1},{"text":"na chini ya mtini wake,","poem":2},{"text":"wala hakuna mtu atakayewaogopesha,","poem":1},{"text":"kwa kuwa Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"Mungu wa majeshi ya mbinguni amesema.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mataifa yote yanaweza kutembea","poem":1},{"text":"katika jina la miungu yao;","poem":2},{"text":"sisi tutatembea katika jina la Mwenyezi Mungu,","poem":1},{"text":"Mungu wetu milele na milele.","poem":2}]},{"type":"heading","content":["Mpango wa Mwenyezi Mungu"]},{"type":"verse","number":6,"content":["“Katika siku hiyo,” asema Mwenyezi Mungu,",{"text":"“nitawakusanya walemavu;","poem":1},{"text":"nitawakusanya walio uhamishoni","poem":2},{"lineBreak":true},{"text":"na wale niliowahuzunisha.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nitawafanya walemavu kuwa mabaki,","poem":1},{"text":"wale waliofukuzwa kuwa taifa lenye nguvu.","poem":2},{"text":"Mwenyezi Mungu atawatawala katika Mlima Sayuni","poem":1},{"text":"kuanzia siku hiyo na hata milele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lakini kwako wewe, ee mnara wa ulinzi wa kundi,","poem":1},{"text":"ee ngome ya Binti Sayuni,","poem":2},{"text":"milki ya awali itarudishwa kwako,","poem":1},{"text":"ufalme utakuja kwa Binti Yerusalemu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kwa nini sasa unalia kwa nguvu:","poem":1},{"text":"kwani huna mfalme?","poem":2},{"text":"Je, mshauri wako amekufa, hata maumivu yakukamate","poem":1},{"text":"kama ya mwanamke","poem":2},{"lineBreak":true},{"text":"aliye na uchungu wa kuzaa?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Gaagaa kwa uchungu, ee Binti Sayuni,","poem":1},{"text":"kama mwanamke mwenye uchungu wa kuzaa,","poem":2},{"text":"kwa kuwa sasa ni lazima uuache mji","poem":1},{"text":"ukapige kambi uwanjani.","poem":2},{"text":"Utaenda Babeli;","poem":1},{"text":"huko utaokolewa.","poem":2},{"text":"Huko Mwenyezi Mungu atakukomboa","poem":1},{"text":"kutoka mikononi mwa adui zako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakini sasa mataifa mengi","poem":1},{"text":"yamekusanyika dhidi yako.","poem":2},{"text":"Wanasema, “Mwache anajisiwe,","poem":1},{"text":"macho yetu na yatazame Sayuni kwa furaha!”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini hawayajui","poem":1},{"text":"mawazo ya Mwenyezi Mungu;","poem":2},{"text":"hawauelewi mpango wake,","poem":1},{"text":"yeye awakusanyaye kama miganda","poem":2},{"lineBreak":true},{"text":"kwenye sakafu ya kupuria.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"“Inuka upure, ee Binti Sayuni,","poem":1},{"text":"kwa kuwa nitakupa pembe za chuma;","poem":2},{"text":"nitakupa kwato za shaba","poem":1},{"text":"na utavunja vipande vipande mataifa mengi.”","poem":2},{"text":"Utatoa mapato yao waliopata kwa udanganyifu kwa Mwenyezi Mungu,","poem":1},{"text":"utajiri wao kwa Bwana wa dunia yote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}