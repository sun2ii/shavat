{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_onmm","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"002b07ef85820ab485273cb8b09b2075131be66c26dfff628096111abe611a81","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_onmm/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["Mtawala aliyeahidiwa kutoka Bethlehemu"]},{"type":"verse","number":1,"content":[{"text":"Panga majeshi yako, ee mji wa majeshi,","poem":1},{"text":"kwa kuwa kuzingirwa kumepangwa dhidi yetu.","poem":2},{"text":"Watampiga mtawala wa Israeli","poem":1},{"text":"shavuni kwa fimbo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Lakini wewe, Bethlehemu Efrata,","poem":1},{"text":"ingawa u mdogo miongoni mwa koo za Yuda,","poem":2},{"text":"kutoka kwako atatokea kwa ajili yangu","poem":1},{"text":"yeye atakayekuwa mtawala katika Israeli,","poem":2},{"text":"ambaye asili yake ni kutoka zamani,","poem":1},{"text":"kutoka milele.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwa hiyo Israeli utaachwa","poem":1},{"text":"hadi mwanamke aliye na uchungu atakapozaa mwana,","poem":2},{"text":"na ndugu zake wengine warudi","poem":1},{"text":"kujiunga na Waisraeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Atasimama na kulichunga kundi lake","poem":1},{"text":"katika nguvu ya Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"katika utukufu wa jina la Mwenyezi Mungu, Mungu wake.","poem":2},{"text":"Nao wataishi kwa usalama, kwa kuwa wakati huo","poem":1},{"text":"ukuu wake utaenea hadi miisho ya dunia.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Naye atakuwa amani yao.","poem":2},"Ukombozi na uharibifu",{"text":"Mwashuru atakapovamia nchi yetu","poem":1},{"text":"na kupita katika ngome zetu,","poem":2},{"text":"tutawainua wachungaji saba dhidi yake,","poem":1},{"text":"hata viongozi wanane wa watu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wataitawala nchi ya Ashuru kwa upanga,","poem":1},{"text":"nchi ya Nimrodi kwa upanga.","poem":2},{"text":"Atatuokoa kutoka kwa Mwashuru","poem":1},{"text":"atakapoivamia nchi yetu","poem":2},{"lineBreak":true},{"text":"na kuingia katika mipaka yetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mabaki ya Yakobo yatakuwa","poem":1},{"text":"katikati ya mataifa mengi","poem":2},{"text":"kama umande kutoka kwa Mwenyezi Mungu,","poem":1},{"text":"kama manyunyu juu ya majani,","poem":2},{"text":"ambayo hayamngoji mtu","poem":1},{"text":"wala kukawia kwa mwanadamu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mabaki ya Yakobo yatakuwa miongoni mwa mataifa,","poem":1},{"text":"katikati ya mataifa mengi,","poem":2},{"text":"kama simba miongoni mwa wanyama wa msituni,","poem":1},{"text":"kama mwana simba miongoni","poem":2},{"lineBreak":true},{"text":"mwa makundi ya kondoo,","poem":2},{"text":"ambaye anaumiza vibaya na kuwararua","poem":1},{"text":"kila anapopita katikati yao,","poem":2},{"lineBreak":true},{"text":"wala hakuna awezaye kuokoa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mkono wako utainuliwa juu kwa ushindi juu ya watesi wako,","poem":1},{"text":"nao adui zako wote wataangamizwa.","poem":2}]},{"type":"verse","number":10,"content":["“Katika siku ile,” asema Mwenyezi Mungu,",{"text":"“nitaangamiza farasi wenu kati yenu,","poem":1},{"text":"na kubomoa magari yenu ya vita.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nitaiangamiza miji ya nchi yenu,","poem":1},{"text":"na kuziangusha chini ngome zenu zote.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitaangamiza uchawi wenu,","poem":1},{"text":"na hamtapiga tena ramli.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nitaangamiza sanamu zenu,","poem":1},{"text":"na mawe yenu ya ibada yatoke kati yenu;","poem":2},{"text":"hamtasujudia tena","poem":1},{"text":"kazi ya mikono yenu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitang’oa nguzo za Ashera kati yenu,","poem":1},{"text":"na kubomoa miji yenu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitalipiza kisasi kwa hasira na ghadhabu,","poem":1},{"text":"kwa mataifa ambayo hayajanitii.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}