{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"MIC","translationId":"swh_onmm","name":"Mika","commonName":"Mika","title":"Mika","order":33,"numberOfChapters":7,"sha256":"002b07ef85820ab485273cb8b09b2075131be66c26dfff628096111abe611a81","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/swh_onmm/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["Taabu ya Israeli"]},{"type":"verse","number":1,"content":[{"text":"Taabu gani hii niliyo nayo!","poem":1},{"lineBreak":true},{"text":"Nimefanana na yule akusanyaye","poem":1},{"text":"matunda ya kiangazi,","poem":2},{"text":"aokotaye masazo baada ya kuvunwa","poem":1},{"text":"shamba la mizabibu;","poem":2},{"text":"hakuna kishada chenye matunda ya kula,","poem":1},{"text":"hakuna hata ile tini ya mwanzoni ninayoitamani.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wanaomcha Mungu wameondolewa kutoka nchi;","poem":1},{"text":"hakuna mtu mnyofu hata mmoja aliyebaki.","poem":2},{"text":"Watu wote wanavizia kumwaga damu,","poem":1},{"text":"kila mmoja anamwinda ndugu yake kwa wavu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mikono yote miwili ni hodari katika kufanya ubaya,","poem":1},{"text":"mtawala anadai zawadi,","poem":2},{"text":"hakimu anapokea rushwa,","poem":1},{"text":"wenye nguvu wanaamuru wanachotaka:","poem":2},{"lineBreak":true},{"text":"wote wanapanga njama pamoja.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Aliye mwema kupita wote kati yao","poem":1},{"text":"ni kama mchongoma,","poem":2},{"text":"anayeonekana mnyofu zaidi miongoni mwao","poem":1},{"text":"ni mbaya kuliko uzio wa miiba.","poem":2},{"text":"Siku ya walinzi wako imewadia,","poem":1},{"text":"siku Mungu atakayokutembelea.","poem":2},{"text":"Sasa ni wakati wao","poem":1},{"text":"wa kuchanganyikiwa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Usimtumaini jirani;","poem":1},{"text":"usiweke matumaini kwa rafiki.","poem":2},{"text":"Hata kwa yule alalaye kifuani mwako","poem":1},{"text":"uwe mwangalifu kwa maneno yako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa kuwa mwana humdharau baba yake,","poem":1},{"text":"naye binti huinuka dhidi ya mama yake,","poem":2},{"text":"mkwe kuwa kinyume na mama mkwe wake:","poem":1},{"text":"adui wa mtu ni wale wa nyumbani mwake hasa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lakini mimi, namtazama Mwenyezi Mungu kwa matumaini,","poem":1},{"text":"namngoja Mungu Mwokozi wangu;","poem":2},{"lineBreak":true},{"text":"Mungu wangu atanisikia mimi.","poem":2}]},{"type":"heading","content":["Israeli atainuka"]},{"type":"verse","number":8,"content":[{"text":"Usifurahie msiba wangu, ee adui yangu!","poem":1},{"text":"Ingawa nimeanguka, nitainuka.","poem":2},{"text":"Japo ninaketi gizani,","poem":1},{"text":"Mwenyezi Mungu atakuwa nuru yangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa sababu nimetenda dhambi dhidi yake,","poem":1},{"text":"nitabeba ghadhabu ya Mwenyezi Mungu,","poem":2},{"text":"hadi atakapotetea shauri langu","poem":1},{"text":"na kuithibitisha haki yangu.","poem":2},{"text":"Atanileta nje kwenye mwanga,","poem":1},{"text":"nami nitaiona haki yake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kisha adui yangu ataliona","poem":1},{"text":"naye atafunikwa na aibu,","poem":2},{"text":"yule aliyeniambia,","poem":1},{"text":"“Yu wapi Mwenyezi Mungu, Mungu wako?”","poem":2},{"text":"Macho yangu yataona kuanguka kwake,","poem":1},{"text":"hata sasa atakanyagwa chini ya mguu","poem":2},{"lineBreak":true},{"text":"kama tope barabarani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Siku ya kujenga kuta zako itawadia,","poem":1},{"text":"siku ya kupanua mipaka yako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Siku hiyo watu watakuja kwako","poem":1},{"text":"kutoka Ashuru na miji ya Misri,","poem":2},{"text":"hata kutoka Misri hadi Mto Frati,","poem":1},{"text":"na kutoka bahari hadi bahari,","poem":2},{"lineBreak":true},{"text":"na kutoka mlima hadi mlima.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Dunia itakuwa ukiwa kwa sababu ya wakazi wake,","poem":1},{"text":"kwa sababu ya matunda ya matendo yao.","poem":2}]},{"type":"heading","content":["Sala na sifa"]},{"type":"verse","number":14,"content":[{"text":"Wachunge watu wako kwa fimbo yako,","poem":1},{"text":"kundi la urithi wako,","poem":2},{"text":"ambalo linaishi peke yake msituni,","poem":1},{"text":"katika maeneo ya malisho yenye rutuba.","poem":2},{"text":"Waache walishe katika Bashani na Gileadi","poem":1},{"text":"kama ilivyokuwa siku za kale.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Kama siku zile mlipotoka Misri,","poem":1},{"text":"nitawaonesha maajabu yangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mataifa yataona na kuaibika,","poem":1},{"text":"waliondolewa nguvu zao zote.","poem":2},{"text":"Wataweka mikono yao kwenye vinywa vyao","poem":1},{"text":"na masikio yao yatakuwa na uziwi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Wataramba mavumbi kama nyoka,","poem":1},{"text":"kama viumbe vinavyotambaa ardhini.","poem":2},{"text":"Watatoka nje ya mapango yao wakitetemeka;","poem":1},{"text":"watamgeukia Mwenyezi Mungu, Mungu wetu, kwa hofu","poem":2},{"lineBreak":true},{"text":"nao watakuogopa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ni nani Mungu kama wewe,","poem":1},{"text":"ambaye anaachilia dhambi","poem":2},{"text":"na kusamehe makosa","poem":1},{"text":"ya mabaki ya urithi wake?","poem":2},{"text":"Wewe huwi na hasira milele,","poem":1},{"text":"bali unafurahia kuonesha rehema.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Utatuhurumia tena,","poem":1},{"text":"utazikanyaga dhambi zetu","poem":2},{"lineBreak":true},{"text":"chini ya nyayo zako,","poem":2},{"text":"na kutupa maovu yetu yote","poem":1},{"text":"katika vilindi vya bahari.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Utakuwa wa kweli kwa Yakobo,","poem":1},{"text":"nawe utamwonesha Ibrahimu rehema,","poem":2},{"text":"kama ulivyowaahidi kwa kiapo baba zetu","poem":1},{"text":"siku za kale.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}