{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"NAM","translationId":"swh_onmm","name":"Nahumu","commonName":"Nahumu","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"916f05ea517e997dd542811c8544bd68506f8f95b2f8a75b54585725b2aac173","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_onmm/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Neno la unabii kuhusu Ninawi. Kitabu cha maono cha Nahumu Mwelkoshi."]},{"type":"line_break"},{"type":"heading","content":["Hasira ya Mwenyezi Mungu dhidi ya Ninawi"]},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu ni mwenye wivu na Mungu mlipiza kisasi;","poem":1},{"text":"Mwenyezi Mungu hulipiza kisasi na amejaa ghadhabu.","poem":2},{"text":"Mwenyezi Mungu hulipiza kisasi juu ya watesi wake,","poem":1},{"text":"naye anadumisha ghadhabu yake dhidi ya adui zake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwenyezi Mungu si mwepesi wa hasira naye ni mwenye nguvu,","poem":1},{"text":"Mwenyezi Mungu hataacha kuadhibu wenye hatia.","poem":2},{"text":"Njia yake ipo katika kisulisuli na tufani,","poem":1},{"text":"na mawingu ni vumbi la miguu yake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anakemea bahari na kuikausha,","poem":1},{"text":"anafanya mito yote kukauka.","poem":2},{"text":"Bashani na Karmeli zinanyauka","poem":1},{"text":"na maua ya Lebanoni hukauka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Milima hutikisika mbele yake","poem":1},{"text":"na vilima huyeyuka.","poem":2},{"text":"Nchi hutetemeka mbele yake,","poem":1},{"text":"dunia na wote wanaoishi ndani yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ni nani awezaye kuzuia hasira yake yenye uchungu?","poem":1},{"text":"Nani awezaye kuvumilia hasira yake kali?","poem":2},{"text":"Ghadhabu yake imemiminwa kama moto,","poem":1},{"text":"na miamba inapasuka mbele zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwenyezi Mungu ni Mwema,","poem":1},{"text":"kimbilio wakati wa taabu.","poem":2},{"text":"Huwatunza wale wanaomtegemea,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"lakini kwa mafuriko makubwa,","poem":2},{"text":"ataangamiza Ninawi;","poem":1},{"text":"atafuatilia adui zake hadi gizani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kila njama wanayopanga dhidi ya Mwenyezi Mungu","poem":1},{"text":"yeye atalikomesha;","poem":2},{"lineBreak":true},{"text":"taabu haitatokea mara ya pili.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watasongwa katikati ya miiba","poem":1},{"text":"na kulewa kwa mvinyo wao.","poem":2},{"lineBreak":true},{"text":"Watateketezwa kama mabua makavu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Ninawi, kutoka kwako amejitokeza mmoja,","poem":1},{"text":"ambaye anapanga njama","poem":2},{"text":"dhidi ya Mwenyezi Mungu","poem":1},{"text":"na kushauri uovu.","poem":2}]},{"type":"verse","number":12,"content":["Hili ndilo asemalo Mwenyezi Mungu:",{"text":"“Ingawa wana muungano nao ni wengi sana,","poem":1},{"text":"watakatiliwa mbali na kuangamia.","poem":2},{"text":"Ingawa nimekutesa wewe, ee Yuda,","poem":1},{"text":"sitakutesa tena.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Sasa nitavunja nira zao kutoka shingo yako,","poem":1},{"text":"nami nitazivunjilia mbali pingu zako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Hii ndiyo amri Mwenyezi Mungu aliyoitoa kukuhusu wewe, Ninawi:","poem":1},{"text":"“Hutakuwa na wazao","poem":2},{"lineBreak":true},{"text":"watakaoendeleza jina lako.","poem":2},{"text":"Nitaharibu sanamu za kuchonga na sanamu za kusubu","poem":1},{"text":"zilizopo katika hekalu la miungu yenu.","poem":2},{"text":"Nitaandaa kaburi lako,","poem":1},{"text":"kwa maana wewe ni mwovu kabisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Tazama, huko juu milimani,","poem":1},{"text":"miguu ya huyo mmoja aletaye habari njema,","poem":2},{"lineBreak":true},{"text":"ambaye anatangaza amani!","poem":2},{"text":"Ee Yuda, sherehekea sikukuu zako,","poem":1},{"text":"nawe utimize nadhiri zako.","poem":2},{"text":"Waovu hawatakuvamia tena;","poem":1},{"text":"wataangamizwa kabisa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}