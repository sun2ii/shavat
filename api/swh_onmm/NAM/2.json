{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"NAM","translationId":"swh_onmm","name":"Nahumu","commonName":"Nahumu","title":"Nahumu","order":34,"numberOfChapters":3,"sha256":"916f05ea517e997dd542811c8544bd68506f8f95b2f8a75b54585725b2aac173","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_onmm/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["Kuanguka kwa Ninawi"]},{"type":"verse","number":1,"content":[{"text":"Mshambuliaji anasogea dhidi yako, Ninawi.","poem":1},{"text":"Linda ngome yako,","poem":2},{"lineBreak":true},{"text":"chunga barabara,","poem":2},{"lineBreak":true},{"text":"jitieni nguvu wenyewe,","poem":2},{"lineBreak":true},{"text":"kusanya nguvu zako zote!","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu atarudisha fahari ya Yakobo,","poem":1},{"text":"kama fahari ya Israeli,","poem":2},{"text":"ingawa waangamizi wamewaacha ukiwa","poem":1},{"text":"na wameharibu mizabibu yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ngao za askari wake ni nyekundu,","poem":1},{"text":"mashujaa wamevaa nguo nyekundu.","poem":2},{"text":"Chuma kwenye magari ya vita chametameta,","poem":1},{"text":"katika siku aliyoyaweka tayari,","poem":2},{"lineBreak":true},{"text":"mikuki ya msunobari inametameta.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Magari ya vita yanafanya msukosuko barabarani,","poem":1},{"text":"yakikimbia nyuma na mbele uwanjani.","poem":2},{"text":"Yanaonekana kama mienge ya moto;","poem":1},{"text":"yanaenda kasi kama umeme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Anaita vikosi vilivyochaguliwa,","poem":1},{"text":"lakini bado wanajikwaa njiani.","poem":2},{"text":"Wanakimbilia haraka kwenye ukuta wa mji,","poem":1},{"text":"ile ngao ya kuwakinga imetayarishwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Malango ya mto yamefunguliwa wazi,","poem":1},{"text":"na jumba la kifalme limeanguka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Imeagizwa kwamba mji uchukuliwe","poem":1},{"text":"na upelekwe uhamishoni.","poem":2},{"text":"Vijakazi wake wanaomboleza kama hua","poem":1},{"text":"na kupigapiga vifua vyao.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ninawi ni kama dimbwi,","poem":1},{"text":"nayo maji yake yanakauka.","poem":2},{"text":"Wanalia, “Simama! Simama!”","poem":1},{"text":"Lakini hakuna anayegeuka nyuma.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Chukueni nyara za fedha!","poem":1},{"text":"Chukueni nyara za dhahabu!","poem":2},{"text":"Wingi wake hauna mwisho,","poem":1},{"text":"utajiri kutoka hazina zake zote!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ameharibiwa, ametekwa nyara, ameachwa uchi!","poem":1},{"text":"Mioyo inayeyuka, magoti yanalegea,","poem":2},{"text":"miili inatetemeka,","poem":1},{"text":"na kila uso umebadilika rangi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Liko wapi sasa pango la simba,","poem":1},{"text":"ambapo waliwalisha watoto wao,","poem":2},{"text":"ambapo simba dume na simba jike walienda,","poem":1},{"text":"na wana simba pia,","poem":2},{"lineBreak":true},{"text":"bila kuogopa chochote?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Simba aliua mawindo ya kutosha watoto wake,","poem":1},{"text":"alinyonga mawindo kwa ajili ya mwenzi wake,","poem":2},{"text":"akijaza makao yake kwa alivyoua","poem":1},{"text":"na mapango yake kwa mawindo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwenyezi Mungu, Mungu wa majeshi ya mbinguni anatangaza,","poem":1},{"text":"“Mimi ni kinyume na ninyi.","poem":2},{"text":"Magari yenu ya vita nitayateketeza kwa moto,","poem":1},{"text":"na upanga utakula wana simba wako.","poem":2},{"lineBreak":true},{"text":"Sitawaachia mawindo juu ya nchi.","poem":2},{"text":"Sauti za wajumbe wako","poem":1},{"text":"hazitasikika tena.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}