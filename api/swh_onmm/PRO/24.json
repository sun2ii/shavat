{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_onmm","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"fdf9b9ff9ffd12371948f1314193ff6f7795eb95a3c985b7bf122d53b5fba282","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_onmm/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["Msemo 20"]},{"type":"verse","number":1,"content":[{"text":"Usiwaonee wivu watu waovu,","poem":1},{"text":"usitamani ushirika nao;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kwa maana mioyo yao hupanga mambo ya jeuri,","poem":1},{"text":"nayo midomo yao husema kuhusu kuleta madhara.","poem":2}]},{"type":"heading","content":["Msemo 21"]},{"type":"verse","number":3,"content":[{"text":"Kwa hekima nyumba hujengwa,","poem":1},{"text":"nayo kupitia ufahamu huimarishwa;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"kwa maarifa vyumba vyake hujazwa","poem":1},{"text":"vitu vya thamani na vya kupendeza.","poem":2}]},{"type":"heading","content":["Msemo 22"]},{"type":"verse","number":5,"content":[{"text":"Mtu mwenye hekima ana uwezo mkubwa,","poem":1},{"text":"naye mtu mwenye maarifa huongeza nguvu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"kwa kufanya vita unahitaji uongozi","poem":1},{"text":"na kwa ushindi washauri wengi.","poem":2}]},{"type":"heading","content":["Msemo 23"]},{"type":"verse","number":7,"content":[{"text":"Hekima i juu mno kwa mpumbavu,","poem":1},{"text":"katika kusanyiko langoni","poem":2},{"lineBreak":true},{"text":"hana lolote la kusema.","poem":2}]},{"type":"heading","content":["Msemo 24"]},{"type":"verse","number":8,"content":[{"text":"Yeye apangaye mabaya","poem":1},{"text":"atajulikana kama mtu wa hila.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mipango ya upumbavu ni dhambi,","poem":1},{"text":"watu huchukizwa na mwenye dhihaka.","poem":2}]},{"type":"heading","content":["Msemo 25"]},{"type":"verse","number":10,"content":[{"text":"Ukikata tamaa wakati wa taabu,","poem":1},{"text":"jinsi gani nguvu zako ni kidogo!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Okoa wale wanaoongozwa kwenye kifo;","poem":1},{"text":"wazuie wote wanaojikokota","poem":2},{"lineBreak":true},{"text":"kuelekea machinjoni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mkisema, “Lakini hatukujua lolote kuhusu hili,”","poem":1},{"text":"je, yule apimaye mioyo halitambui hili?","poem":2},{"text":"Je, yule awalindaye maisha yenu halijui hili?","poem":1},{"text":"Je, hatamlipa kila mtu kulingana na aliyotenda?","poem":2}]},{"type":"heading","content":["Msemo 26"]},{"type":"verse","number":13,"content":[{"text":"Ule asali mwanangu, kwa kuwa ni nzuri;","poem":1},{"text":"asali kutoka sega ni tamu kwa kuonja.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ujue pia kwamba hekima ni tamu kwa nafsi yako:","poem":1},{"text":"Ukiipata, kuna matumaini kwako ya siku zijazo,","poem":2},{"lineBreak":true},{"text":"nalo tumaini lako halitakatiliwa mbali.","poem":2}]},{"type":"heading","content":["Msemo 27"]},{"type":"verse","number":15,"content":[{"text":"Usivizie kama haramia afanyavyo ili kuyashambulia","poem":1},{"text":"makao ya mwenye haki,","poem":2},{"lineBreak":true},{"text":"wala usiyavamie makazi yake,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kwa maana ingawa mtu mwenye haki huanguka mara saba,","poem":1},{"text":"huinuka tena;","poem":2},{"lineBreak":true},{"text":"lakini waovu huangushwa chini na maafa.","poem":2}]},{"type":"heading","content":["Msemo 28"]},{"type":"verse","number":17,"content":[{"text":"Usitazame kwa kufurahia adui yako aangukapo;","poem":1},{"text":"wakati anapojikwaa,","poem":2},{"lineBreak":true},{"text":"usiruhusu moyo wako ushangilie.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mwenyezi Mungu asije akaona na kuchukia","poem":1},{"text":"akaiondoa ghadhabu yake mbali naye.","poem":2}]},{"type":"heading","content":["Msemo 29"]},{"type":"verse","number":19,"content":[{"text":"Usikasirike kwa sababu ya wapotovu,","poem":1},{"text":"wala usiwaonee wivu waovu,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kwa maana mpotovu hana tumaini la siku zijazo,","poem":1},{"text":"nayo taa ya waovu itazimwa.","poem":2}]},{"type":"heading","content":["Msemo 30"]},{"type":"verse","number":21,"content":[{"text":"Mwanangu, mche Mwenyezi Mungu na mfalme,","poem":1},{"text":"wala usijiunge na waasi,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kwa maana hao wawili watatuma maangamizi ya ghafula juu yao,","poem":1},{"text":"naye ni nani ajuaye maafa wawezayo kuleta?","poem":2}]},{"type":"verse","number":23,"content":["Hii pia ni misemo ya wenye hekima:",{"text":"Kuonesha upendeleo katika hukumu si vyema:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Yeyote amwambiaye mwenye hatia,","poem":1},{"text":"“Wewe huna hatia,”","poem":2},{"text":"makabila ya watu watamlaani,","poem":1},{"text":"na mataifa watamkana.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Bali itakuwa vyema kwa wale watakaowatia hatiani wenye hatia,","poem":1},{"text":"nazo baraka tele zitawajilia juu yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Jawabu la uaminifu","poem":1},{"text":"ni kama busu la mdomoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Maliza kazi zako za nje,","poem":1},{"text":"nawe uweke mashamba yako tayari,","poem":2},{"lineBreak":true},{"text":"baada ya hayo, jenga nyumba yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Usishuhudie dhidi ya jirani yako bila sababu,","poem":1},{"text":"au kutumia midomo yako kudanganya.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Usiseme, “Nitamtenda kama alivyonitenda mimi;","poem":1},{"text":"nitamlipiza mtu yule kwa kile alichonitendea.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Nilipita karibu na shamba la mvivu,","poem":1},{"text":"karibu na shamba la mizabibu la mtu asiye na akili,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"miiba ilikuwa imeota kila mahali,","poem":1},{"text":"ardhi ilikuwa imefunikwa na magugu, na","poem":2},{"lineBreak":true},{"text":"ukuta wa mawe ulikuwa umebomoka.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Nikatafakari moyoni mwangu lile nililoliona,","poem":1},{"text":"nami nikajifunza somo kutokana na niliyoyaona:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Bado kulala kidogo, kusinzia kidogo,","poem":1},{"text":"bado kukunja mikono kidogo upate kupumzika:","poem":2}]},{"type":"verse","number":34,"content":[{"text":"na umaskini utakuja juu yako kama mnyang’anyi,","poem":1},{"text":"na kupungukiwa kutakujia kama mtu mwenye silaha.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}