{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_onmm","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"fdf9b9ff9ffd12371948f1314193ff6f7795eb95a3c985b7bf122d53b5fba282","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_onmm/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"Usijisifu kwa ajili ya kesho,","poem":1},{"text":"kwa kuwa hujui ni nini kitakachozaliwa kwa siku moja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwache mwingine akusifu,","poem":1},{"text":"wala si kinywa chako mwenyewe;","poem":2},{"text":"mtu mwingine afanye hivyo","poem":1},{"text":"na si midomo yako mwenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Jiwe ni zito na mchanga ni mzigo,","poem":1},{"text":"lakini kukasirishwa na mpumbavu ni kuzito kuliko vyote viwili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hasira ni ukatili na ghadhabu kali ni gharika,","poem":1},{"text":"lakini ni nani awezaye kusimama mbele ya wivu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Afadhali karipio la wazi","poem":1},{"text":"kuliko upendo uliofichika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Majeraha kutoka kwa rafiki yaonesha uaminifu,","poem":1},{"text":"lakini adui huzidisha busu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yeye aliyeshiba huchukia kabisa asali,","poem":1},{"text":"bali kwa mwenye njaa","poem":2},{"lineBreak":true},{"text":"hata kile kilicho kichungu","poem":2},{"lineBreak":true},{"text":"kwake ni kitamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kama ndege atangatangavyo mbali na kiota chake,","poem":1},{"text":"ndivyo alivyo mtu atangatangaye","poem":2},{"lineBreak":true},{"text":"mbali na nyumbani mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Manukato na uvumba huleta furaha moyoni,","poem":1},{"text":"nao uzuri wa rafiki huchipuka","poem":2},{"lineBreak":true},{"text":"katika ushauri wake wa uaminifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Usimwache rafiki yako wala rafiki wa baba yako,","poem":1},{"text":"tena usiende nyumbani mwa ndugu yako","poem":2},{"lineBreak":true},{"text":"wakati umepatwa na maafa.","poem":2},{"text":"Bora jirani wa karibu","poem":1},{"text":"kuliko ndugu aliye mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwanangu, uwe na hekima,","poem":1},{"text":"nawe ulete furaha moyoni mwangu,","poem":2},{"text":"ndipo nitakapoweza kumjibu yeyote","poem":1},{"text":"anitendaye kwa dharau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mtu mwenye busara huona hatari na kujificha,","poem":1},{"text":"bali mjinga huendelea mbele, naye hupata madhara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Chukua vazi la yule awekaye dhamana","poem":1},{"text":"kwa ajili ya mgeni;","poem":2},{"text":"lishikilie liwe dhamana","poem":1},{"text":"kwa ajili ya mgeni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mtu akimbariki jirani yake kwa sauti kuu","poem":1},{"text":"asubuhi na mapema,","poem":2},{"lineBreak":true},{"text":"itahesabiwa kuwa ni laana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Mke mgomvi ni kama","poem":1},{"text":"matone yasiyokoma siku ya mvua.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kumzuia ni kama kuuzuia upepo,","poem":1},{"text":"au kukamata mafuta kwa kiganja cha mkono.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Kama vile chuma kinoavyo chuma,","poem":1},{"text":"ndivyo mtu amnoavyo mwenzake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yeye autunzaye mtini atakula tunda lake,","poem":1},{"text":"naye amtunzaye bwana wake ataheshimiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kama uso uonekanavyo kwenye maji,","poem":1},{"text":"ndivyo hivyo moyo wa mtu humwonesha alivyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kuzimu","poem":1},{"noteId":9},{"text":"na Uharibifu","poem":1},{"noteId":10},{"text":"havishibi,","poem":1},{"text":"wala macho ya mwanadamu hayashibi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kalibu husafisha fedha na tanuru husafisha dhahabu,","poem":1},{"text":"bali mtu hupimwa kwa sifa anazopewa na watu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Hata ukimtwanga mpumbavu kwenye kinu,","poem":1},{"text":"ukimtwanga kama nafaka kwa mchi,","poem":2},{"lineBreak":true},{"text":"hutauondoa upumbavu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hakikisha kuwa unajua hali ya makundi yako ya kondoo na mbuzi;","poem":1},{"text":"angalia ng’ombe wako kwa makini.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kwa kuwa utajiri haudumu milele,","poem":1},{"text":"nalo taji halidumu vizazi vyote.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Wakati majani makavu yameondolewa","poem":1},{"text":"na mapya yamechipua,","poem":2},{"lineBreak":true},{"text":"nayo majani toka milimani yamekusanywa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"wana-kondoo watakupatia mavazi","poem":1},{"text":"na mbuzi thamani ya shamba.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Utakuwa na maziwa mengi ya mbuzi","poem":1},{"text":"kukulisha wewe na jamaa yako,","poem":2},{"lineBreak":true},{"text":"na kuwalisha wajakazi wako.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":9,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":27,"verse":20}},{"noteId":10,"caller":"+","text":"kwa Kiebrania ni Abadon","reference":{"chapter":27,"verse":20}}]},"thisChapterLink":"/api/swh_onmm/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}