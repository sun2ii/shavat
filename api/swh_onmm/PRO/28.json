{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_onmm","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"fdf9b9ff9ffd12371948f1314193ff6f7795eb95a3c985b7bf122d53b5fba282","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_onmm/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"Mtu mwovu hukimbia ingawa hakuna yeyote anayemfukuza,","poem":1},{"text":"bali wenye haki ni wajasiri kama simba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nchi inapokuwa na uasi,","poem":1},{"text":"inakuwa na viongozi wengi,","poem":2},{"lineBreak":true},{"text":"bali kiongozi mwenye ufahamu na maarifa","poem":2},{"lineBreak":true},{"text":"hudumisha utaratibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mtawala anayewadhulumu maskini,","poem":1},{"text":"ni kama mvua ya dhoruba inayoharibu mazao yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wale wanaoacha sheria huwasifu waovu,","poem":1},{"text":"bali wale wanaotii sheria huwapinga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wapotovu hawaelewi haki,","poem":1},{"text":"bali wale wanaomtafuta Mwenyezi Mungu wanaielewa kikamilifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Afadhali maskini ambaye mwenendo wake hauna lawama,","poem":1},{"text":"kuliko tajiri ambaye njia zake ni potovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yeye anayetii sheria ni mwana mwenye ufahamu,","poem":1},{"text":"bali rafiki wa walafi humwaibisha baba yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Yeye aongezaye utajiri wake kwa riba kubwa mno","poem":1},{"text":"hukusanya kwa ajili ya mwingine,","poem":2},{"lineBreak":true},{"text":"ambaye atawahurumia maskini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mtu yeyote akikataa kusikia sheria,","poem":1},{"text":"hata maombi yake ni chukizo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yeye anayemwongoza mwenye haki kwenye mapito mabaya,","poem":1},{"text":"ataanguka kwenye mtego wake mwenyewe,","poem":2},{"lineBreak":true},{"text":"bali wasio na lawama watapokea urithi mwema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mtu tajiri anaweza kuwa na hekima machoni pake mwenyewe,","poem":1},{"text":"bali mtu maskini mwenye busara","poem":2},{"lineBreak":true},{"text":"humtambua alivyodanganyika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mwenye haki ashindapo, kuna furaha kubwa,","poem":1},{"text":"bali waovu watawalapo, watu hujificha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Yeye afichaye dhambi zake hatafanikiwa,","poem":1},{"text":"bali yeyote aziungamaye na kuziacha hupata rehema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Amebarikiwa mtu ambaye siku zote humcha Mwenyezi Mungu,","poem":1},{"text":"bali yeye afanyaye moyo wake kuwa mgumu","poem":2},{"lineBreak":true},{"text":"huanguka kwenye taabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kama simba angurumaye au dubu ashambuliaye,","poem":1},{"text":"ndivyo alivyo mtu mwovu anayetawala wanyonge.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mtawala dhalimu hana akili,","poem":1},{"text":"bali yeye achukiaye mapato ya udhalimu","poem":2},{"lineBreak":true},{"text":"atafurahia maisha marefu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Mtu mwenye kusumbuliwa na hatia ya kuua","poem":1},{"text":"atakuwa mtoro hadi kufa;","poem":2},{"lineBreak":true},{"text":"mtu yeyote asimsaidie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Yeye ambaye mwenendo wake hauna lawama","poem":1},{"text":"hulindwa salama,","poem":2},{"text":"bali yeye ambaye njia zake ni potovu","poem":1},{"text":"ataanguka ghafula.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Yeye alimaye shamba lake atakuwa na chakula tele,","poem":1},{"text":"bali yule afuataye mambo ya upuzi atakuwa na umaskini wa kumtosha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mtu mwaminifu atabarikiwa sana,","poem":1},{"text":"bali yeye atamaniye kupata utajiri kwa haraka","poem":2},{"lineBreak":true},{"text":"hataacha kuadhibiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Kuonesha upendeleo si vizuri,","poem":1},{"text":"hata hivyo mtu atafanya kosa kwa kipande cha mkate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mtu mchoyo ana tamaa ya kupata utajiri,","poem":1},{"text":"naye hana habari kuwa umaskini unamngojea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Yeye amkemeaye mtu mwishoni hupata kibali zaidi,","poem":1},{"text":"kuliko mwenye maneno ya kusifu isivyostahili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Yeye amwibiaye babaye au mamaye","poem":1},{"text":"na kusema, “Si kosa,”","poem":2},{"lineBreak":true},{"text":"yeye ni mwenzi wa yule aharibuye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Mtu mwenye tamaa huchochea fitina,","poem":1},{"text":"bali yule amtegemeaye Mwenyezi Mungu atafanikiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Yeye ajitumainiaye mwenyewe ni mpumbavu,","poem":1},{"text":"bali yeye atembeaye katika hekima hulindwa salama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Yeye ampaye maskini","poem":1},{"text":"hatapungukiwa na kitu chochote,","poem":2},{"text":"bali yeye awafumbiaye maskini macho","poem":1},{"text":"hupata laana nyingi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wakati waovu wanatawala,","poem":1},{"text":"watu huenda mafichoni,","poem":2},{"text":"bali waovu wanapoangamia,","poem":1},{"text":"wenye haki hufanikiwa.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}