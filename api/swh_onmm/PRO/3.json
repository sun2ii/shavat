{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_onmm","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"fdf9b9ff9ffd12371948f1314193ff6f7795eb95a3c985b7bf122d53b5fba282","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_onmm/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["Faida nyingine za hekima"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, usisahau mafundisho yangu,","poem":1},{"text":"bali zitunze amri zangu moyoni mwako,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kwa kuwa zitakuongezea miaka mingi ya maisha yako","poem":1},{"text":"na kukuletea mafanikio.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Usiache kamwe upendo na uaminifu vitengane nawe;","poem":1},{"text":"vifunge shingoni mwako,","poem":2},{"lineBreak":true},{"text":"viandike katika ubao wa moyo wako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo utapata kibali na jina zuri","poem":1},{"text":"mbele za Mungu na mwanadamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mtumaini Mwenyezi Mungu kwa moyo wako wote","poem":1},{"text":"wala usizitegemee akili zako mwenyewe;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"katika njia zako zote mkiri yeye,","poem":1},{"text":"naye atayanyoosha mapito yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Usiwe mwenye hekima machoni pako mwenyewe;","poem":1},{"text":"mche Mwenyezi Mungu ukajiepushe na uovu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hii itakuletea afya mwilini mwako,","poem":1},{"text":"na lishe kwenye mifupa yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Mheshimu Mwenyezi Mungu kwa mali yako","poem":1},{"text":"na kwa malimbuko ya mazao yako yote;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ndipo ghala zako zitakapojaa hadi kufurika,","poem":1},{"text":"viriba vyako vitafurika kwa mvinyo mpya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwanangu, usidharau adhabu ya Mwenyezi Mungu","poem":1},{"text":"na usichukie maonyo yake,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kwa sababu Mwenyezi Mungu huwaadibisha wale anaowapenda,","poem":1},{"text":"kama vile baba afanyavyo","poem":2},{"lineBreak":true},{"text":"kwa mwana apendezwaye naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Heri mtu yule apataye hekima,","poem":1},{"text":"mtu yule apataye ufahamu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"kwa maana hekima ana faida kuliko fedha","poem":1},{"text":"na mapato yake ni bora kuliko ya dhahabu safi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hekima ana thamani kuliko marijani;","poem":1},{"text":"hakuna chochote unachokitamani","poem":2},{"lineBreak":true},{"text":"kinachoweza kulinganishwa naye.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Maisha marefu yako katika mkono wake wa kuume;","poem":1},{"text":"katika mkono wake wa kushoto","poem":2},{"lineBreak":true},{"text":"kuna utajiri na heshima.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Njia zake zinapendeza,","poem":1},{"text":"mapito yake yote ni amani.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Yeye ni mti wa uzima kwa wale wanaomkumbatia;","poem":1},{"text":"wale wamshikao watabarikiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Kwa hekima Mwenyezi Mungu aliiweka misingi ya dunia,","poem":1},{"text":"kwa ufahamu aliziweka mbingu mahali pake;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kwa maarifa yake vilindi viligawanywa,","poem":1},{"text":"nayo mawingu yanadondosha umande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Mwanangu, hifadhi maamuzi mema na busara,","poem":1},{"text":"usiache vitoke machoni pako;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ndipo vitakapokuwa uzima nafsini mwako","poem":1},{"text":"na pambo la neema shingoni mwako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kisha utaenda katika njia yako salama,","poem":1},{"text":"wala mguu wako hautajikwaa;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"unapolala, hutaogopa;","poem":1},{"text":"unapolala, usingizi wako utakuwa mtamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Usiogope maafa ya ghafula","poem":1},{"text":"au maangamizi yanayowapata waovu,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kwa kuwa Mwenyezi Mungu atakuwa tumaini lako","poem":1},{"text":"na kuepusha mguu wako kunaswa katika mtego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Usizuie wema kwa wale wanaostahili","poem":1},{"text":"ikiwa katika uwezo wako kutenda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Usimwambie jirani yako,","poem":1},{"text":"“Njoo baadaye, nitakupa kesho”:","poem":2},{"lineBreak":true},{"text":"wakati wewe unacho kitu kile karibu nawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Usipange mabaya dhidi ya jirani yako,","poem":1},{"text":"anayeishi karibu nawe kwa uaminifu.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Usimshtaki mtu bila sababu,","poem":1},{"text":"wakati hajakudhuru kwa lolote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"Usimwonee wivu mtu mwenye jeuri","poem":1},{"text":"wala kuchagua njia yake yoyote,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"kwa kuwa Mwenyezi Mungu humchukia mtu mpotovu,","poem":1},{"text":"lakini siri yake iko kwa mwenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"Laana ya Mwenyezi Mungu i juu ya nyumba ya mwovu,","poem":1},{"text":"lakini yeye huibariki nyumba ya mwenye haki.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Huwadhihaki wale wanaodhihaki,","poem":1},{"text":"lakini huwapa neema wale wanyenyekevu na walioonewa.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Wenye hekima hurithi heshima,","poem":1},{"text":"bali huwaaibisha wapumbavu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}