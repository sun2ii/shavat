{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_onmm","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"fdf9b9ff9ffd12371948f1314193ff6f7795eb95a3c985b7bf122d53b5fba282","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_onmm/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["Misemo ya Mfalme Lemueli, usia wa mama yake aliyomfundisha:"]},{"type":"verse","number":2,"content":[{"text":"“Sikiliza, ee mwanangu! Sikiliza, ee mwana wa tumbo langu!","poem":1},{"text":"Sikiliza, ee mwana wa nadhiri zangu!","poem":2},{"noteId":11}]},{"type":"verse","number":3,"content":[{"text":"Usitumie nguvu zako kwa wanawake,","poem":1},{"text":"uhodari wako kwa wale wanaowaharibu wafalme.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ee Lemueli, haifai wafalme,","poem":1},{"text":"haifai wafalme kunywa mvinyo,","poem":2},{"lineBreak":true},{"text":"haifai watawala kutamani sana kileo,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wasije wakanywa na kusahau vile sheria inavyoamuru","poem":1},{"text":"na kuwanyima haki zao wote waliodhulumiwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wape kileo wale wanaoangamia,","poem":1},{"text":"mvinyo wale walio na uchungu,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wanywe na kusahau umaskini wao","poem":1},{"text":"na wasikumbuke taabu yao tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Sema kwa ajili ya wale wasioweza kujisemea,","poem":1},{"text":"kwa ajili ya haki za wote walioachwa ukiwa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sema na uamue kwa haki,","poem":1},{"text":"tetea haki za maskini na wahitaji.”","poem":2}]},{"type":"verse","number":10,"content":[{"noteId":12},{"text":"Mke mwenye sifa nzuri, ni nani awezaye kumpata?","poem":1},{"text":"Yeye ni wa thamani sana kuliko marijani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mume wake anamwamini kikamilifu,","poem":1},{"text":"wala hakosi kitu chochote cha thamani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Humtendea mumewe mema, wala si mabaya,","poem":1},{"text":"siku zote za maisha yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Huchagua sufu na kitani,","poem":1},{"text":"naye hufanya kazi kwa mikono yenye bidii.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Yeye ni kama meli za biashara,","poem":1},{"text":"akileta chakula chake kutoka mbali.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yeye huamka kukiwa bado giza,","poem":1},{"text":"naye huwapa jamaa yake chakula","poem":2},{"lineBreak":true},{"text":"na wajakazi wake mafungu yao.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Huangalia shamba na kulinunua;","poem":1},{"text":"kutokana na mapato yake hupanda shamba la mizabibu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hufanya kazi zake kwa nguvu,","poem":1},{"text":"mikono yake ina nguvu kwa ajili ya kazi zake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Huona kwamba biashara yake ina faida,","poem":1},{"text":"wala taa yake haizimiki usiku.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Huweka mikono yake kwenye pia,","poem":1},{"text":"navyo vidole vyake hushikilia kijiti chenye uzi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Huwanyooshea maskini mikono yake","poem":1},{"text":"na kuwakunjulia wahitaji vitanga vyake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Theluji inaposhuka, hana hofu","poem":1},{"text":"kwa ajili ya watu wa nyumbani mwake,","poem":2},{"text":"kwa maana wote wamevikwa","poem":1},{"text":"nguo za kutia joto.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Yeye hutengeneza mazulia ya urembo","poem":1},{"text":"ya kufunika kitanda chake,","poem":2},{"lineBreak":true},{"text":"huvaa kitani safi na urujuani.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mume wake anaheshimiwa kwenye lango la mji,","poem":1},{"text":"aketipo miongoni mwa wazee wa nchi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hutengeneza mavazi ya kitani na kuyauza,","poem":1},{"text":"naye huwauzia wafanyabiashara mishipi.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Amevikwa nguvu na heshima,","poem":1},{"text":"anaweza kucheka bila kuwa na hofu kwa siku zijazo.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Huzungumza kwa hekima,","poem":1},{"text":"na mafundisho ya kuaminika yapo ulimini mwake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Huangalia mambo ya nyumbani mwake","poem":1},{"text":"wala hali chakula cha uvivu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Watoto wake huamka na kumwita aliyebarikiwa,","poem":1},{"text":"mumewe pia humsifu, akisema:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“Wanawake wengi hufanya vitu vyenye sifa nzuri,","poem":1},{"text":"lakini wewe umewapita wote.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kujipamba ili kuvutia ni udanganyifu,","poem":1},{"text":"na uzuri unapita upesi;","poem":2},{"lineBreak":true},{"text":"bali mwanamke anayemcha Mwenyezi Mungu atasifiwa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Mpe thawabu anayostahili,","poem":1},{"text":"nazo kazi zake na zimletee sifa kwenye lango la mji.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"au Ewe uliye jibu la maombi yangu.","reference":{"chapter":31,"verse":2}},{"noteId":12,"caller":"+","text":"Mithali 31:10-31 imetungwa kila mstari ukianzia na herufi ya alfabeti ya Kiebrania zikifuatana tangu Aleph (A) hadi Taw (T); zote ni 22.","reference":{"chapter":31,"verse":10}}]},"thisChapterLink":"/api/swh_onmm/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}