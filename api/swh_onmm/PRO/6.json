{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_onmm","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"fdf9b9ff9ffd12371948f1314193ff6f7795eb95a3c985b7bf122d53b5fba282","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_onmm/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["Maonyo dhidi ya upumbavu"]},{"type":"verse","number":1,"content":[{"text":"Mwanangu, kama umekuwa mdhamini wa jirani yako,","poem":1},{"text":"ikiwa umeshikana mikono kwa kuweka ahadi","poem":2},{"lineBreak":true},{"text":"kwa ajili ya mwingine,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kama umetegwa na ulichosema,","poem":1},{"text":"umenaswa kwa maneno ya kinywa chako,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"basi fanya hivi mwanangu, ili ujiweke huru,","poem":1},{"text":"kwa kuwa umeanguka mikononi mwa jirani yako:","poem":2},{"text":"Nenda ukajinyenyekeshe kwake;","poem":1},{"text":"msihi jirani yako!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Usiruhusu usingizi machoni pako,","poem":1},{"text":"usiruhusu kope zako zisinzie.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Jiweke huru, kama paa kutoka mkononi mwa mwindaji,","poem":1},{"text":"kama ndege kutoka mtego wa mwindaji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ewe mvivu, mwendee mchwa;","poem":1},{"text":"zitafakari njia zake ukapate hekima!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa maana yeye hana msimamizi,","poem":1},{"text":"wala mwangalizi, au mtawala,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"lakini hujiwekea akiba wakati wa kiangazi","poem":1},{"text":"na hukusanya chakula chake wakati wa mavuno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ewe mvivu, utalala hata lini?","poem":1},{"text":"Utaamka lini kutoka usingizi wako?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kulala kidogo, kusinzia kidogo,","poem":1},{"text":"kukunja mikono kidogo upate kupumzika:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"umaskini utakuja juu yako kama mnyang’anyi,","poem":1},{"text":"na kupungukiwa kutakujia kama mtu mwenye silaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mtu mbaya sana na mlaghai,","poem":1},{"text":"ambaye huzungukazunguka","poem":2},{"text":"na maneno ya upotovu,","poem":3}]},{"type":"verse","number":13,"content":[{"text":"ambaye anakonyeza kwa jicho lake,","poem":2},{"lineBreak":true},{"text":"anayetoa ishara kwa miguu yake","poem":2},{"lineBreak":true},{"text":"na kuashiria kwa vidole vyake,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ambaye hupanga ubaya","poem":2},{"text":"kwa udanganyifu moyoni mwake:","poem":3},{"text":"daima huchochea fitina.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa hiyo maafa yatamkumba ghafula;","poem":1},{"text":"ataangamizwa mara moja, pasipo msaada.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["Kuna vitu sita anavyovichukia Mwenyezi Mungu, naam, viko saba vilivyo chukizo kwake:"]},{"type":"verse","number":17,"content":["macho ya kiburi, ulimi udanganyao, mikono imwagayo damu isiyo na hatia,"]},{"type":"verse","number":18,"content":["moyo uwazao mipango miovu, miguu iliyo myepesi kukimbilia uovu,"]},{"type":"verse","number":19,"content":["shahidi wa uongo ambaye humwaga uongo, na mtu ambaye huchochea fitina kati ya ndugu."]},{"type":"heading","content":["Onyo dhidi ya uasherati"]},{"type":"verse","number":20,"content":[{"text":"Mwanangu, zishike amri za baba yako,","poem":1},{"text":"wala usiyaache mafundisho ya mama yako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Yafunge katika moyo wako daima,","poem":1},{"text":"yakaze kuizunguka shingo yako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Unapotembea, yatakuongoza;","poem":1},{"text":"unapolala, yatakulinda;","poem":2},{"lineBreak":true},{"text":"unapoamka, yatazungumza nawe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kwa maana amri hii ni taa,","poem":1},{"text":"mafundisho haya ni mwanga,","poem":2},{"text":"na maonyo ya nidhamu","poem":1},{"text":"ni njia ya uzima,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"yakikulinda na mwanamke aliyepotoka,","poem":1},{"text":"kutokana na maneno laini ya mwanamke aliyepotoka.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Moyo wako usitamani uzuri wake,","poem":1},{"text":"wala macho yake yasikuteke,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kwa maana kahaba atakufanya uwe maskini,","poem":1},{"text":"hata ukose kipande cha mkate,","poem":2},{"lineBreak":true},{"text":"naye mwanamke mzinzi huwinda maisha yako hasa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Je, mtu aweza kuchotea moto kwenye paja lake","poem":1},{"text":"bila nguo zake kuungua?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Je, mtu aweza kutembea juu ya makaa ya moto","poem":1},{"text":"bila miguu yake kuungua?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Ndivyo alivyo mtu alalaye na mke wa mwanaume mwingine;","poem":1},{"text":"hakuna yeyote amgusaye huyo mwanamke ambaye hataadhibiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Watu hawamdharau mwizi akiiba","poem":1},{"text":"ili kukidhi njaa yake akiwa na njaa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Lakini akikamatwa, lazima alipe mara saba,","poem":1},{"text":"ingawa inamgharimu utajiri wote wa nyumba yake.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Lakini mwanaume aziniye na mwanamke hana akili kabisa;","poem":1},{"text":"yeyote afanyaye hivyo hujiangamiza mwenyewe.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Mapigo na aibu ni fungu lake","poem":1},{"text":"na aibu yake haitafutika kamwe;","poem":2}]},{"type":"verse","number":34,"content":[{"text":"kwa maana wivu huamsha ghadhabu ya mume,","poem":1},{"text":"naye hataonesha huruma alipizapo kisasi.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Hatakubali fidia yoyote;","poem":1},{"text":"atakataa malipo, hata yakiwa makubwa kiasi gani.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}