{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_onmm","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"fdf9b9ff9ffd12371948f1314193ff6f7795eb95a3c985b7bf122d53b5fba282","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_onmm/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Wito wa hekima"]},{"type":"verse","number":1,"content":[{"text":"Je, hekima haitani?","poem":1},{"text":"Je, ufahamu hapazi sauti?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Juu ya miinuko karibu na njia,","poem":1},{"text":"penye njia panda, ndipo asimamapo;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kando ya malango yaelekeayo mjini,","poem":1},{"text":"kwenye maingilio, hulia kwa sauti kubwa, akisema:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Ni ninyi watu, ninaowaita;","poem":1},{"text":"ninapaza sauti yangu kwa wanadamu wote.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ninyi ambao ni wajinga, pateni akili;","poem":1},{"text":"ninyi mlio wapumbavu, pateni ufahamu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sikilizeni, kwa maana nina mambo muhimu ya kusema;","poem":1},{"text":"ninafungua midomo yangu kusema lililo sawa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kinywa changu husema lililo kweli,","poem":1},{"text":"kwa maana midomo yangu huchukia uovu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maneno yote ya kinywa changu ni ya haki;","poem":1},{"text":"hakuna mojawapo lililopotoka au la ukaidi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa wenye kupambanua, yote ni sahihi;","poem":1},{"text":"hayana kasoro kwa wale wenye maarifa.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Chagua mafundisho yangu badala ya fedha,","poem":1},{"text":"maarifa badala ya dhahabu safi,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"kwa maana hekima ina thamani kuliko marijani","poem":1},{"text":"na hakuna chochote unachohitaji kinacholingana naye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Mimi hekima, nakaa pamoja na busara;","poem":1},{"text":"ninamiliki maarifa na busara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kumcha Mwenyezi Mungu ni kuchukia uovu;","poem":1},{"text":"ninachukia kiburi na majivuno,","poem":2},{"lineBreak":true},{"text":"tabia mbaya na mazungumzo potovu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ushauri na hukumu sahihi ni vyangu;","poem":1},{"text":"nina ufahamu na nina nguvu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa msaada wangu wafalme hutawala","poem":1},{"text":"na watawala hutunga sheria zilizo za haki,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kwa msaada wangu wakuu hutawala,","poem":1},{"text":"na wenye vyeo wote watawalao dunia.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nawapenda wale wanaonipenda,","poem":1},{"text":"na wale wanaonitafuta kwa bidii wataniona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Utajiri na heshima viko kwangu,","poem":1},{"text":"utajiri unaodumu na mafanikio.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tunda langu ni bora kuliko dhahabu safi;","poem":1},{"text":"kile ninachotoa hupita fedha iliyo bora.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Natembea katika njia ya unyofu","poem":1},{"text":"katika mapito ya haki,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"nawapa utajiri wale wanaonipenda","poem":1},{"text":"na kuzijaza hazina zao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Mwenyezi Mungu aliniumba mwanzoni mwa kazi yake,","poem":1},{"text":"kabla ya matendo yake ya zamani;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"niliteuliwa tangu milele,","poem":1},{"text":"tangu mwanzoni, kabla ya dunia kuumbwa.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Wakati hazijakuwepo bahari, nilikwishazaliwa,","poem":1},{"text":"wakati hazijakuwepo chemchemi zilizojaa maji;","poem":2}]},{"type":"verse","number":25,"content":[{"text":"kabla milima haijawekwa mahali pake,","poem":1},{"text":"kabla vilima havijakuwepo, nilikwishazaliwa,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"kabla hajaumba dunia wala mashamba yake","poem":1},{"text":"au vumbi lolote la dunia.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nilikuwepo alipoziweka mbingu mahali pake,","poem":1},{"text":"wakati alichora mstari wa upeo wa macho","poem":2},{"lineBreak":true},{"text":"kwenye uso wa kilindi,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"wakati aliweka mawingu juu","poem":1},{"text":"na kuziweka imara chemchemi za bahari,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"wakati aliiwekea bahari mpaka wake","poem":1},{"text":"ili maji yasivunje agizo lake,","poem":2},{"text":"na wakati aliweka misingi ya dunia.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"Wakati huo nilikuwa fundi stadi kando yake.","poem":2},{"text":"Nilijazwa na furaha siku baada ya siku,","poem":1},{"text":"nikifurahi daima mbele zake,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"nikifurahi katika dunia yake yote","poem":1},{"text":"nami nikiwafurahia wanadamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Basi sasa wanangu, nisikilizeni;","poem":1},{"text":"heri wale wanaozishika njia zangu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Sikilizeni mafundisho yangu mwe na hekima;","poem":1},{"text":"msiyapuuze.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Heri mtu yule anisikilizaye mimi,","poem":1},{"text":"akisubiri siku zote malangoni mwangu,","poem":2},{"lineBreak":true},{"text":"akingoja kwenye vizingiti vya mlango wangu.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Kwa maana yeyote anipataye mimi amepata uzima,","poem":1},{"text":"na kujipatia kibali kutoka kwa Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Lakini yeyote ashindwaye kunipata","poem":1},{"text":"hujiumiza mwenyewe;","poem":2},{"lineBreak":true},{"text":"na wote wanaonichukia mimi hupenda mauti.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}