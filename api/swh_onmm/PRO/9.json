{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PRO","translationId":"swh_onmm","name":"Mithali","commonName":"Mithali","title":"Mithali","order":20,"numberOfChapters":31,"sha256":"fdf9b9ff9ffd12371948f1314193ff6f7795eb95a3c985b7bf122d53b5fba282","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/swh_onmm/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["Makaribisho ya hekima na ya upumbavu"]},{"type":"verse","number":1,"content":[{"text":"Hekima amejenga nyumba yake;","poem":1},{"text":"amechonga nguzo zake saba.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ameandaa nyama na kuchanganya divai yake;","poem":1},{"text":"pia ameandaa meza yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Amewatuma wajakazi wake, naye huita","poem":1},{"text":"kutoka mahali pa juu sana pa mji.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anawaambia wale wasio na akili,","poem":1},{"text":"“Wote ambao ni wajinga na waje hapa!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Njooni, mle chakula changu","poem":1},{"text":"na mnywe divai niliyoichanganya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Acheni njia zenu za ujinga nanyi mtaishi;","poem":1},{"text":"tembeeni katika njia ya ufahamu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Yeyote anayemkosoa mwenye dhihaka","poem":1},{"text":"hukaribisha matusi;","poem":2},{"text":"yeyote anayekemea mtu mwovu","poem":1},{"text":"hupatwa na matusi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usimkemee mwenye dhihaka, la sivyo atakuchukia;","poem":1},{"text":"mkemee mwenye hekima naye atakupenda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mfundishe mtu mwenye hekima","poem":1},{"text":"naye atakuwa na hekima zaidi;","poem":2},{"text":"mfundishe mtu mwadilifu","poem":1},{"text":"naye atazidi kufundishika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Kumcha Mwenyezi Mungu ndicho chanzo cha hekima,","poem":1},{"text":"na kumjua Aliye Mtakatifu ni ufahamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa maana kwa msaada wangu","poem":1},{"text":"siku zako zitakuwa nyingi,","poem":2},{"lineBreak":true},{"text":"na miaka itaongezwa katika maisha yako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kama wewe una hekima, hekima yako itakupa tuzo;","poem":1},{"text":"kama wewe ni mtu wa mzaha,","poem":2},{"lineBreak":true},{"text":"wewe mwenyewe ndiwe utateseka.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mwanamke aitwaye Mpumbavu ana kelele;","poem":1},{"text":"hana adabu na hana maarifa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Huketi kwenye mlango wa nyumba yake,","poem":1},{"text":"kwenye kiti katika mahali pa juu sana pa mji,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"akiita wale wanaopita karibu,","poem":1},{"text":"wanaoenda moja kwa moja kwenye njia yao.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anawaambia wale wasio na akili,","poem":1},{"text":"“Wote ambao ni wajinga na waje hapa ndani!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Maji yaliyoibiwa ni matamu;","poem":1},{"text":"chakula kinacholiwa sirini ni kitamu!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lakini hawajui hata kidogo kuwa wafu wako humo,","poem":1},{"text":"kwamba wageni wake huyo mwanamke","poem":2},{"lineBreak":true},{"text":"wako katika vilindi vya Kuzimu","poem":2},{"noteId":5},{"text":".","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":9,"verse":18}}]},"thisChapterLink":"/api/swh_onmm/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}