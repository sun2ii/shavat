rue},{"text":"yanayopeperushwa na upepo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa hiyo waovu hawatastahimili hukumu,","poem":1},{"text":"wala wenye dhambi katika kusanyiko la wenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kwa maana Mwenyezi Mungu huziangalia njia za mwenye haki,","poem":1},{"text":"bali njia za waovu zitaangamia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}