{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":10,"content":[{"type":"heading","content":["Sala kwa ajili ya haki"]},{"type":"verse","number":1,"content":[{"text":"Kwa nini, Ee Mwenyezi Mungu, unasimama mbali?","poem":1},{"text":"Kwa nini unajificha wakati wa shida?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Katika kiburi chake, mwovu humtesa maskini,","poem":1},{"text":"waovu na wanaswe katika hila wanazozitunga.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hujivunia tamaa za moyo wake;","poem":1},{"text":"humbariki mlafi na kumtukana Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Katika kiburi chake, mwovu hamtafuti Mungu,","poem":1},{"text":"katika mawazo yake yote","poem":2},{"lineBreak":true},{"text":"hakuna nafasi ya Mungu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Njia zake daima hufanikiwa;","poem":1},{"text":"hujivuna na amri zako ziko mbali naye,","poem":2},{"lineBreak":true},{"text":"huwacheka kwa dharau adui zake wote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anajisemea mwenyewe, “Hakuna kitakachonitikisa,","poem":1},{"text":"daima nitakuwa na furaha,","poem":2},{"lineBreak":true},{"text":"kamwe sitakuwa na shida.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kinywa chake kimejaa laana, uongo na vitisho;","poem":1},{"text":"shida na ubaya viko chini ya ulimi wake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Huvizia karibu na vijiji;","poem":1},{"text":"kutoka mafichoni huwanasa wasio na hatia,","poem":2},{"lineBreak":true},{"text":"akivizia wapitaji.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huvizia kama simba aliye mawindoni;","poem":1},{"text":"huvizia kumkamata mnyonge,","poem":2},{"text":"huwakamata wanyonge na kuwaburuza","poem":1},{"text":"katika wavu wake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mateka wake hupondwa, huzimia;","poem":1},{"text":"wanaanguka katika nguvu zake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Anajisemea mwenyewe, “Mungu amesahau,","poem":1},{"text":"huficha uso wake na haoni kabisa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Inuka Mwenyezi Mungu! Inua mkono wako, Ee Mungu.","poem":1},{"text":"Usiwasahau wanyonge.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa nini mtu mwovu anamtukana Mungu?","poem":1},{"text":"Kwa nini anajiambia mwenyewe,","poem":2},{"lineBreak":true},{"text":"“Hataniita nitoe hesabu”?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Lakini wewe, Ee Mungu, unaona shida na huzuni,","poem":1},{"text":"umekubali kuyapokea mkononi mwako.","poem":2},{"text":"Mhanga anajisalimisha kwako,","poem":1},{"text":"wewe ni msaada wa yatima.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Vunja mkono wa mtu mbaya na mwovu;","poem":1},{"text":"mwite mtu mbaya atoe hesabu ya uovu wake","poem":2},{"lineBreak":true},{"text":"ambao usingejulikana vinginevyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mwenyezi Mungu ni Mfalme milele na milele,","poem":1},{"text":"mataifa wataangamia watoke nchini mwake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unasikia, Ee Mwenyezi Mungu, shauku ya wanaoonewa;","poem":1},{"text":"wewe huwatia moyo, na kusikiliza kilio chao,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ukiwatetea yatima na waliodhulumiwa,","poem":1},{"text":"ili mwanadamu ambaye ni udongo asiogopeshe tena.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}