{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"heading","content":["Dunia yote yaitwa kumsifu Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Zaburi ya shukrani."]},{"type":"verse","number":1,"content":[{"text":"Mpigieni Mwenyezi Mungu kelele za shangwe, dunia yote.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Mwabuduni Mwenyezi Mungu kwa furaha;","poem":2},{"lineBreak":true},{"text":"njooni mbele zake kwa nyimbo za shangwe.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Jueni kwamba Mwenyezi Mungu ndiye Mungu.","poem":1},{"text":"Yeye ndiye alituumba, sisi tu mali yake;","poem":2},{"text":"sisi tu watu wake,","poem":1},{"text":"kondoo wa malisho yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ingieni malangoni mwake kwa shukrani","poem":1},{"text":"na katika nyua zake kwa kusifu,","poem":2},{"lineBreak":true},{"text":"mshukuruni yeye na kulisifu jina lake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa maana Mwenyezi Mungu ni mwema","poem":1},{"text":"na fadhili zake zadumu milele;","poem":2},{"lineBreak":true},{"text":"uaminifu wake unadumu kwa vizazi vyote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}