{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"heading","content":["Ahadi ya kuishi kwa uadilifu na kwa haki"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nitaimba kuhusu upendo wako na haki yako;","poem":1},{"text":"kwako wewe, Ee Mwenyezi Mungu, nitaimba sifa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitazingatia kuishi maisha yasiyo na lawama:","poem":1},{"text":"utakuja kwangu lini?","poem":2},{"lineBreak":true},{"text":"Nitatembea nyumbani mwangu","poem":1},{"text":"kwa moyo usio na lawama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sitaweka mbele ya macho yangu","poem":1},{"text":"kitu kiovu.","poem":2},{"lineBreak":true},{"text":"Ninayachukia matendo ya watu wasio na imani;","poem":1},{"text":"hawatashikamana nami.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moyo wa ukaidi utakuwa mbali nami;","poem":1},{"text":"nitajitenga na kila ubaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kila amsingiziaye jirani yake kwa siri,","poem":1},{"text":"huyo nitamnyamazisha;","poem":2},{"text":"mwenye macho ya dharau na moyo wa kiburi","poem":1},{"text":"huyo sitamvumilia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Macho yangu yatawaelekea waaminifu katika nchi,","poem":1},{"text":"ili waweze kuishi pamoja nami;","poem":2},{"text":"yeye ambaye moyo wake hauna lawama","poem":1},{"text":"atanitumikia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mdanganyifu hatakaa","poem":1},{"text":"nyumbani mwangu,","poem":2},{"text":"yeye asemaye kwa uongo","poem":1},{"text":"hatasimama mbele yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kila asubuhi nitawanyamazisha","poem":1},{"text":"waovu wote katika nchi;","poem":2},{"text":"nitamkatilia mbali kila mtenda maovu","poem":1},{"text":"kutoka mji wa Mwenyezi Mungu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}