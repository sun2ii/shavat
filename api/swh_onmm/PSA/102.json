{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"heading","content":["Maombi ya mtu aliyechoka"]},{"type":"hebrew_subtitle","content":["Maombi ya mtu aliyechoka. Anapoteseka na kumimina malalamiko yake kwa Mwenyezi Mungu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, usikie maombi yangu;","poem":1},{"text":"kilio changu cha kuomba msaada kikufikie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Usinifiche uso wako","poem":1},{"text":"ninapokuwa katika shida.","poem":2},{"text":"Unitegee sikio lako;","poem":1},{"text":"ninapoita, unijibu kwa upesi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa siku zangu zinatoweka kama moshi;","poem":1},{"text":"mifupa yangu inaungua kama kaa la moto.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Moyo wangu umefifia na kunyauka kama jani;","poem":1},{"text":"ninasahau kula chakula changu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa sababu ya kusononeka kwangu kwa uchungu,","poem":1},{"text":"nimebakia ngozi na mifupa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimekuwa kama bundi wa jangwani,","poem":1},{"text":"kama bundi kwenye magofu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nilalapo sipati usingizi;","poem":1},{"text":"nimekuwa kama ndege mpweke","poem":2},{"lineBreak":true},{"text":"kwenye paa la nyumba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mchana kutwa adui zangu hunidhihaki;","poem":1},{"text":"wanaonizunguka hutumia jina langu kama laana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ninakula majivu kama chakula changu,","poem":1},{"text":"nimechanganya kinywaji changu na machozi","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kwa sababu ya ghadhabu yako kuu,","poem":1},{"text":"kwa maana umeniinua na kunitupa kando.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siku zangu ni kama kivuli cha jioni,","poem":1},{"text":"ninanyauka kama jani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lakini wewe, Ee Mwenyezi Mungu, umeketi kwenye kiti chako cha enzi milele;","poem":1},{"text":"sifa zako za ukuu zaendelea vizazi vyote.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Utainuka na kuihurumia Sayuni,","poem":1},{"text":"kwa maana ni wakati wa kumwonesha wema;","poem":2},{"lineBreak":true},{"text":"wakati uliokubalika umewadia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa maana mawe yake ni ya thamani kwa watumishi wako,","poem":1},{"text":"vumbi lake lenyewe hulionea huruma.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mataifa wataogopa jina la Mwenyezi Mungu,","poem":1},{"text":"wafalme wote wa dunia watauheshimu utukufu wako.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa maana Mwenyezi Mungu ataijenga tena Sayuni","poem":1},{"text":"na kutokea katika utukufu wake.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ataitikia maombi ya mtu mkiwa,","poem":1},{"text":"wala hatadharau hoja yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hili na liandikwe kwa ajili ya kizazi kijacho,","poem":1},{"text":"ili taifa litakaloumbwa baadaye waweze kumsifu Mwenyezi Mungu:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“Mwenyezi Mungu alitazama chini kutoka patakatifu pake palipo juu,","poem":1},{"text":"alitazama dunia kutoka mbinguni,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"kusikiliza vilio vya uchungu vya wafungwa,","poem":1},{"text":"na kuwaweka huru wale waliohukumiwa kufa.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwa hiyo jina la Mwenyezi Mungu latangazwa huko Sayuni","poem":1},{"text":"na sifa zake katika Yerusalemu,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"wakati mataifa na falme zitakapokusanyika","poem":1},{"text":"ili kumwabudu Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Katika kuishi kwangu alivunja nguvu zangu,","poem":1},{"text":"akafupisha siku zangu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Ndipo niliposema:","poem":1},{"text":"“Ee Mungu wangu, usinichukue katikati ya siku zangu;","poem":2},{"lineBreak":true},{"text":"miaka yako inaendelea vizazi vyote.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Hapo mwanzo uliweka misingi ya dunia,","poem":1},{"text":"nazo mbingu ni kazi ya mikono yako.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Hizi zitatoweka, lakini wewe utadumu,","poem":1},{"text":"zote zitachakaa kama vazi.","poem":2},{"text":"Utazibadilisha kama nguo","poem":1},{"text":"nazo zitaondoshwa.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Lakini wewe, U yeye yule,","poem":1},{"text":"nayo miaka yako haikomi kamwe.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Watoto wa watumishi wako wataishi mbele zako;","poem":1},{"text":"wazao wao wataimarishwa mbele zako.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}