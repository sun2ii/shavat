{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"heading","content":["Uaminifu wa Mwenyezi Mungu kwa Israeli"]},{"type":"verse","number":1,"content":[{"text":"Mshukuruni Mwenyezi Mungu, liitieni jina lake;","poem":1},{"text":"wajulisheni mataifa aliyoyatenda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwimbieni yeye, mwimbieni yeye sifa,","poem":1},{"text":"waambieni matendo yake yote ya ajabu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lishangilieni jina lake takatifu,","poem":1},{"text":"mioyo ya wale wanaomtafuta Mwenyezi Mungu na ifurahi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mtafuteni Mwenyezi Mungu na nguvu zake,","poem":1},{"text":"utafuteni uso wake siku zote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kumbuka matendo ya ajabu aliyoyafanya,","poem":1},{"text":"miujiza yake na hukumu alizozitamka,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"enyi wazao wa Ibrahimu mtumishi wake,","poem":1},{"text":"enyi wana wa Yakobo, wateule wake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeye ndiye Mwenyezi Mungu, Mungu wetu,","poem":1},{"text":"hukumu zake ziko duniani kote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Hulikumbuka agano lake milele,","poem":1},{"text":"neno ambalo aliamuru, kwa vizazi elfu,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"agano alilolifanya na Ibrahimu,","poem":1},{"text":"kiapo alichomwapia Isaka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Alilithibitisha kwa Yakobo kuwa amri,","poem":1},{"text":"kwa Israeli liwe agano la milele:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“Nitakupa wewe nchi ya Kanaani","poem":1},{"text":"kuwa sehemu utakayoirithi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Walipokuwa wachache kwa idadi,","poem":1},{"text":"wachache sana na wageni ndani yake,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"walitangatanga kutoka taifa moja hadi jingine,","poem":1},{"text":"kutoka ufalme mmoja hadi mwingine.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Hakuruhusu mtu yeyote awadhulumu;","poem":1},{"text":"kwa ajili yao aliwakemea wafalme, akisema:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“Msiwaguse niliowapaka mafuta;","poem":1},{"text":"msiwadhuru manabii wangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Akaiita njaa juu ya nchi","poem":1},{"text":"na kuharibu chakula chao chote,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"naye akatuma mtu mbele yao,","poem":1},{"text":"Yusufu, aliyeuzwa kama mtumwa.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Walichubua miguu yake kwa minyororo,","poem":1},{"text":"shingo yake ilifungwa kwa chuma,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"hadi yale aliyotangulia kusema yalipotimia,","poem":1},{"text":"hadi neno la Mwenyezi Mungu lilipomthibitisha.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mfalme alituma watu wakamfungua,","poem":1},{"text":"mtawala wa watu alimwachia huru.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Alimfanya mkuu wa nyumba yake,","poem":1},{"text":"mtawala wa vyote alivyokuwa navyo,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kuwaelekeza wakuu wa mfalme apendavyo,","poem":1},{"text":"na kuwafundisha wazee wake hekima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kisha Israeli akaingia Misri,","poem":1},{"text":"Yakobo akaishi kama mgeni katika nchi ya Hamu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mwenyezi Mungu aliwafanya watu wake kuzaana sana;","poem":1},{"text":"aliwafanya kuwa wengi sana kuliko adui zao.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Aliigeuza mioyo yao iwachukie watu wake,","poem":1},{"text":"wakatenda hila dhidi ya watumishi wake.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Akamtuma Musa mtumishi wake,","poem":1},{"text":"pamoja na Haruni, aliyemchagua.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Walifanya ishara zake za ajabu miongoni mwao,","poem":1},{"text":"miujiza yake katika nchi ya Hamu.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Alituma giza na nchi ikajaa giza,","poem":1},{"text":"kwani si walikuwa wameyaasi maneno yake?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Aligeuza maji yao kuwa damu,","poem":1},{"text":"ikasababisha samaki wao kufa.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Nchi yao ilijaa vyura tele, ambao waliingia","poem":1},{"text":"hadi kwenye vyumba vya kulala vya watawala wao.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Alisema, yakaja makundi ya inzi,","poem":1},{"text":"na viroboto katika nchi yao yote.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Alibadilisha mvua yao ikawa mvua ya mawe,","poem":1},{"text":"yenye miali ya radi nchini yao yote,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"akaharibu mizabibu yao na miti ya tini,","poem":1},{"text":"na akaangamiza miti ya nchi yao.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Alisema, nzige wakaja,","poem":1},{"text":"tunutu wasio na idadi,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"wakala kila jani katika nchi yao,","poem":1},{"text":"wakala mazao ya ardhi yao.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Kisha akawaua wazaliwa wote wa kwanza katika nchi yao,","poem":1},{"text":"matunda ya kwanza ya ujana wao wote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Akawatoa Israeli katika nchi","poem":1},{"text":"wakiwa na fedha na dhahabu nyingi,","poem":2},{"text":"wala hakuna hata mmoja","poem":1},{"text":"kutoka makabila yao aliyejikwaa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Misri ilifurahi walipoondoka,","poem":1},{"text":"kwa sababu hofu ya Israeli ilikuwa imewaangukia.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Alitandaza wingu kama kifuniko,","poem":1},{"text":"na moto kuwamulikia usiku.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Waliomba, naye akawaletea kware,","poem":1},{"text":"akawashibisha kwa mkate wa mbinguni.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Alipasua mwamba, maji yakabubujika,","poem":1},{"text":"yakatiririka jangwani kama mto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"Kwa maana alikumbuka ahadi yake takatifu,","poem":1},{"text":"aliyompa Ibrahimu mtumishi wake.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Aliwatoa watu wake kwa furaha,","poem":1},{"text":"wateule wake kwa kelele za shangwe,","poem":2}]},{"type":"verse","number":44,"content":[{"text":"akawapa nchi za mataifa, wakawa warithi wa mali","poem":1},{"text":"ambayo wengine walikuwa wameitaabikia:","poem":2}]},{"type":"verse","number":45,"content":[{"text":"alifanya haya ili wayashike mausia yake","poem":1},{"text":"na kuzitii sheria zake.","poem":2},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu.","poem":1},{"noteId":41}]}],"footnotes":[{"noteId":41,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah.","reference":{"chapter":105,"verse":45}}]},"thisChapterLink":"/api/swh_onmm/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}