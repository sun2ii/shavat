{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"heading","content":["Wema wa Mwenyezi Mungu kwa watu wake"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Mwenyezi Mungu.","poem":1},{"noteId":42},{"lineBreak":true},{"text":"Mshukuruni Mwenyezi Mungu, kwa kuwa ni mwema;","poem":1},{"text":"fadhili zake zadumu milele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ni nani awezaye kusimulia matendo makuu ya Mwenyezi Mungu","poem":1},{"text":"au kutangaza kikamilifu sifa zake?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Heri wale wanaodumisha haki,","poem":1},{"text":"ambao daima wanafanya yaliyo mema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ee Mwenyezi Mungu, unikumbuke unapowatendea mema watu wako,","poem":1},{"text":"uwe msaada wangu unapowaokoa,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ili niweze kufurahia mafanikio ya wateule wako,","poem":1},{"text":"niweze kushiriki katika furaha ya taifa lako,","poem":2},{"lineBreak":true},{"text":"na kuungana na urithi wako katika kukusifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tumetenda dhambi, kama vile baba zetu walivyotenda,","poem":1},{"text":"tumekosa na tumetenda uovu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Baba zetu walipokuwa Misri,","poem":1},{"text":"hawakuzingatia maajabu yako,","poem":2},{"text":"wala hawakukumbuka wingi wa fadhili zako,","poem":1},{"text":"bali waliasi kando ya bahari,","poem":2},{"lineBreak":true},{"text":"ile Bahari ya Shamu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hata hivyo aliwaokoa kwa ajili ya jina lake,","poem":1},{"text":"ili apate kudhihirisha uweza wake mkuu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alikemea Bahari ya Shamu, nayo ikakauka,","poem":1},{"text":"akawaongoza katika vilindi vyake kama vile jangwani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Aliwaokoa mikononi mwa adui;","poem":1},{"text":"kutoka mikononi mwa adui aliwakomboa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Maji yaliwafunika adui zao,","poem":1},{"text":"hakunusurika hata mmoja.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ndipo walipoamini ahadi zake,","poem":1},{"text":"nao wakaimba sifa zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Lakini walisahau upesi aliyowatendea,","poem":1},{"text":"wala hawakungojea ushauri wake.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Jangwani walitawaliwa na tamaa zao,","poem":1},{"text":"walimjaribu Mungu nyikani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa hiyo aliwapa kile walichoomba,","poem":1},{"text":"lakini akatuma juu yao ugonjwa wa kudhoofisha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kambini walimwonea wivu Musa,","poem":1},{"text":"na pia Haruni aliyekuwa amewekwa wakfu kwa Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ardhi ilifunguka ikawameza Dathani,","poem":1},{"text":"ikawazika Abiramu na kundi lake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Moto uliwaka katikati ya wafuasi wao,","poem":1},{"text":"mwali wa moto uliwateketeza waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Huko Horebu walitengeneza ndama,","poem":1},{"text":"na kuabudu sanamu ya kusubu kwa chuma.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Waliubadilisha Utukufu wao","poem":1},{"text":"kwa sanamu ya fahali, ambaye hula majani.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Walimsahau Mungu aliyewaokoa,","poem":1},{"text":"aliyetenda mambo makuu huko Misri,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"miujiza katika nchi ya Hamu","poem":1},{"text":"na mambo ya kutisha huko Bahari ya Shamu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Kwa hiyo alisema kwamba angewaangamiza:","poem":1},{"text":"kama Musa mteule wake,","poem":2},{"text":"asingesimama kati yao na Mungu","poem":1},{"text":"kuizuia ghadhabu yake kuwaangamiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Kisha waliidharau ile nchi nzuri,","poem":1},{"text":"hawakuiamini ahadi yake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Walinung’unika ndani ya mahema yao,","poem":1},{"text":"wala hawakumtii Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kwa hiyo akaapa kwa mkono ulioinuliwa","poem":1},{"text":"kwamba atawafanya waanguke jangwani,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"kuwatawanya wazao wao waanguke miongoni mwa mataifa,","poem":1},{"text":"na kuwatawanya katika nchi zote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Walijifunga nira na Baali wa Peori,","poem":1},{"text":"wakala dhabihu zilizotolewa kwa miungu isiyo na uhai.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Waliichochea hasira ya Mwenyezi Mungu,","poem":1},{"text":"wakamkasirisha kwa matendo yao maovu,","poem":2},{"lineBreak":true},{"text":"nayo tauni ikazuka katikati yao.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Lakini Finehasi alisimama na kuingilia kati,","poem":1},{"text":"nayo tauni ikazuiliwa.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Hili likahesabiwa kwake haki,","poem":1},{"text":"kwa vizazi visivyo na mwisho vijavyo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Kwenye maji ya Meriba, walimkasirisha Mwenyezi Mungu,","poem":1},{"text":"janga likampata Musa kwa sababu yao;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"kwa maana walimwasi Roho wa Mungu,","poem":1},{"text":"na maneno yasiyofaa yakatoka mdomoni kwa Musa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Hawakuyaangamiza yale mataifa","poem":1},{"text":"kama Mwenyezi Mungu alivyowaagiza,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"bali walijichanganya na mataifa","poem":1},{"text":"na wakazikubali desturi zao.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Waliabudu sanamu zao,","poem":1},{"text":"zikawa mtego kwao.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"Wakawatoa wana wao","poem":1},{"text":"na binti zao dhabihu kwa mashetani.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Walimwaga damu isiyo na hatia,","poem":1},{"text":"damu za wana wao wa kiume na wa kike,","poem":2},{"text":"ambao waliwatoa dhabihu kwa sanamu za Kanaani,","poem":1},{"text":"nayo nchi ikanajisika kwa damu zao.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Wakajinajisi wenyewe kwa yale waliyotenda;","poem":1},{"text":"kwa matendo yao wenyewe wakajifanyia ukahaba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Kwa hiyo Mwenyezi Mungu akawakasirikia watu wake","poem":1},{"text":"na akauchukia sana urithi wake.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Akawakabidhi kwa mataifa","poem":1},{"text":"na adui zao wakawatawala.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Adui zao wakawadhulumu","poem":1},{"text":"na kuwatia chini ya mkono wao.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Mara nyingi aliwaokoa","poem":1},{"text":"lakini walizama kwenye uasi,","poem":2},{"lineBreak":true},{"text":"na wakajiharibu katika dhambi zao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"Lakini akaangalia mateso yao","poem":1},{"text":"aliposikia kilio chao;","poem":2}]},{"type":"verse","number":45,"content":[{"text":"kwa ajili yao akakumbuka agano lake,","poem":1},{"text":"na kutokana na upendo wake mkuu akapooza hasira yake.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Akawafanya wahurumiwe","poem":1},{"text":"na wote waliowashikilia mateka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wetu, tuokoe.","poem":1},{"text":"Tukusanye tena kutoka kwa mataifa,","poem":2},{"text":"ili tuweze kulishukuru jina lako takatifu,","poem":1},{"text":"na kushangilia katika sifa zako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"Atukuzwe Mwenyezi Mungu, Mungu wa Israeli,","poem":1},{"text":"tangu milele na hata milele.","poem":2},{"text":"Watu wote na waseme, “Amen!”","poem":1},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu.","poem":1}]}],"footnotes":[{"noteId":42,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah; pia 106:48.","reference":{"chapter":106,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}