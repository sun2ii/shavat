{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"heading","content":["Lalamiko la mtu aliye kwenye shida"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, ninayekusifu,","poem":1},{"text":"usiwe kimya,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kwa maana watu waovu na wadanganyifu","poem":1},{"text":"wamefungua vinywa vyao dhidi yangu;","poem":2},{"text":"wasema dhidi yangu","poem":1},{"text":"kwa ndimi za udanganyifu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wamenizunguka kwa maneno ya chuki,","poem":1},{"text":"wananishambulia bila sababu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wanachonilipa badala ya urafiki wangu ni kunishtaki,","poem":1},{"text":"lakini mimi ninawaombea.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wananilipiza mabaya kwa mema,","poem":1},{"text":"chuki badala ya urafiki wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Agiza mtu mwovu ampinge,","poem":1},{"text":"mshtaki","poem":2},{"noteId":43},{"text":"asimame mkono wake wa kuume.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Anapohukumiwa, apatikane na hatia,","poem":1},{"text":"nayo maombi yake yamhukumu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Siku zake za kuishi na ziwe chache,","poem":1},{"text":"nafasi yake ya uongozi ichukuliwe na mtu mwingine.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Watoto wake na waachwe yatima,","poem":1},{"text":"mke wake na awe mjane.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watoto wake na watangetange wakiomba,","poem":1},{"text":"na wafukuzwe kwenye magofu ya nyumba zao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mtu anayemdai na ateke vyote alivyo navyo,","poem":1},{"text":"matunda ya kazi yake yatekwe nyara na wageni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Asiwepo mtu yeyote wa kumtendea mema","poem":1},{"text":"wala wa kuwahurumia yatima wake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Uzao wake na ukatiliwe mbali,","poem":1},{"text":"majina yao yafutike katika kizazi kifuatacho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Maovu ya baba zake na yakumbukwe","poem":1},{"text":"mbele za Mwenyezi Mungu,","poem":2},{"text":"dhambi ya mama yake","poem":1},{"text":"isifutwe kamwe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Dhambi zao na zibaki daima mbele za Mwenyezi Mungu,","poem":1},{"text":"ili apate kukatilia mbali kumbukumbu lao duniani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kwa maana kamwe hakuweza kutenda wema,","poem":1},{"text":"bali alimfukuza mnyonge na mhitaji,","poem":2},{"lineBreak":true},{"text":"aliwafanyia jeuri wahitaji na waliovunjika moyo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Alipenda kulaani,","poem":1},{"text":"nayo laana ikampata;","poem":2},{"text":"hakupenda kubariki,","poem":1},{"text":"kwa hiyo baraka na ikae mbali naye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Alivaa kulaani kama vazi lake,","poem":1},{"text":"nayo laana ikamwingia mwilini mwake kama maji,","poem":2},{"lineBreak":true},{"text":"kwenye mifupa yake kama mafuta.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Na iwe kama joho alilozungushiwa,","poem":1},{"text":"kama mshipi aliofungiwa daima.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Haya na yawe malipo ya Mwenyezi Mungu kwa washtaki wangu,","poem":1},{"text":"kwa wale wanaoninenea mabaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Lakini wewe, Ee Bwana Mungu Mwenyezi,","poem":1},{"text":"unitendee wema kwa ajili ya jina lako,","poem":2},{"lineBreak":true},{"text":"uniokoe kwa wema wa pendo lako.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Maana mimi ni maskini na mhitaji,","poem":1},{"text":"moyo wangu umejeruhiwa ndani yangu.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ninafifia kama kivuli cha jioni,","poem":1},{"text":"nimerushwa-rushwa kama nzige.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Magoti yangu yamelegea kwa kufunga,","poem":1},{"text":"mwili wangu umedhoofika na kukonda.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nimekuwa kitu cha kudharauliwa kwa washtaki wangu,","poem":1},{"text":"wanionapo, hutikisa vichwa vyao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wangu, nisaidie,","poem":1},{"text":"niokoe sawasawa na upendo wako.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Watu na wafahamu kuwa ni mkono wako,","poem":1},{"text":"kwamba wewe, Ee Mwenyezi Mungu, umetenda hili.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wanaweza kulaani, lakini wewe utabariki,","poem":1},{"text":"watakaposhambulia wataaibishwa,","poem":2},{"lineBreak":true},{"text":"lakini mtumishi wako atashangilia.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Washtaki wangu watavikwa fedheha,","poem":1},{"text":"na kufunikwa na aibu kama joho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kwa kinywa changu nitamtukuza sana Mwenyezi Mungu,","poem":1},{"text":"katika umati mkubwa nitamsifu.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kwa maana husimama mkono wa kuume wa mhitaji,","poem":1},{"text":"kuokoa maisha yake kutoka kwa wale wanaomhukumu.","poem":2}]}],"footnotes":[{"noteId":43,"caller":"+","text":"maana yake Shetani","reference":{"chapter":109,"verse":6}}]},"thisChapterLink":"/api/swh_onmm/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}