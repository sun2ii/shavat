{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"heading","content":["Kumtumaini Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Kwa Mwenyezi Mungu ninakimbilia.","poem":1},{"text":"Unawezaje basi kuniambia:","poem":2},{"lineBreak":true},{"text":"“Ruka kama ndege utorokee kwenye mlima wako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hebu tazama, waovu wanapinda nyuta zao;","poem":1},{"text":"wanaweka mishale kwenye nyuzi zake","poem":2},{"text":"ili wakiwa gizani, wawapige","poem":1},{"text":"walio wanyofu wa moyo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wakati misingi imeharibiwa,","poem":1},{"text":"mwenye haki anaweza kufanya nini?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwenyezi Mungu yuko ndani ya Hekalu lake takatifu;","poem":1},{"text":"Mwenyezi Mungu yuko kwenye kiti chake cha enzi mbinguni.","poem":2},{"text":"Huwaangalia wana wa watu,","poem":1},{"text":"macho yake yanawachunguza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwenyezi Mungu huwachunguza wenye haki,","poem":1},{"text":"lakini nafsi yake inachukia waovu","poem":2},{"lineBreak":true},{"text":"na wale wanaopenda mapigano.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atawanyeshea waovu makaa ya moto mkali","poem":1},{"text":"na kiberiti kinachowaka;","poem":2},{"lineBreak":true},{"text":"upepo wenye joto kali ndio fungu lao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwa kuwa Mwenyezi Mungu ni mwenye haki,","poem":1},{"text":"yeye hupenda haki.","poem":2},{"lineBreak":true},{"text":"Wanyofu watauona uso wake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}