rse","number":4,"content":[{"text":"Mwenyezi Mungu ameapa,","poem":1},{"text":"naye hatabadilisha mawazo yake:","poem":2},{"lineBreak":true},{"text":"“Wewe ni kuhani milele,","poem":2},{"lineBreak":true},{"text":"kwa mfano wa Melkizedeki.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bwana yuko mkono wako wa kuume,","poem":1},{"text":"atawaponda wafalme siku ya ghadhabu yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Atawahukumu mataifa, akilundika mizoga","poem":1},{"text":"na kuwaponda watawala wa dunia nzima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Atakunywa maji katika kijito kando ya njia","poem":1},{"noteId":45},{"text":";","poem":1},{"text":"kwa hiyo atainua kichwa chake juu.","poem":2}]}],"footnotes":[{"noteId":44,"caller":"+","text":"au vijana wako watakujia kama umande","reference":{"chapter":110,"verse":3}},{"noteId":45,"caller":"+","text":"au Yeye atoaye mtu wa kurithi mwingine atamweka kwenye mamlaka;","reference":{"chapter":110,"verse":7}}]},"thisChapterLink":"/api/swh_onmm/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}