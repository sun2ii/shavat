{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"heading","content":["Sifa za Mwenyezi Mungu kwa matendo ya ajabu"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Mwenyezi Mungu.","poem":1},{"noteId":46},{"lineBreak":true},{"text":"Nitamtukuza Mwenyezi Mungu kwa moyo wangu wote,","poem":1},{"text":"katika baraza la wanyofu na katika kusanyiko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kazi za Mwenyezi Mungu ni kuu,","poem":1},{"text":"wote wanaopendezwa nazo huzitafakari.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kazi zake zimejaa fahari na utukufu,","poem":1},{"text":"haki yake hudumu daima.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Amefanya maajabu yake yakumbukwe,","poem":1},{"text":"Mwenyezi Mungu ni mwenye neema na huruma.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Huwapa chakula wale wanaomcha,","poem":1},{"text":"hulikumbuka agano lake milele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Amewaonesha watu wake uwezo wa kazi zake,","poem":1},{"text":"akiwapa nchi za mataifa mengine.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kazi za mikono yake ni za uaminifu na haki,","poem":1},{"text":"mausia yake yote ni ya kuaminika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Zinadumu milele na milele,","poem":1},{"text":"zikifanyika kwa uaminifu na unyofu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aliwapa watu wake ukombozi,","poem":1},{"text":"aliamuru agano lake milele:","poem":2},{"lineBreak":true},{"text":"jina lake ni takatifu na la kuogopwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kumcha Mwenyezi Mungu ndicho chanzo cha hekima,","poem":1},{"text":"wote wanaozifuata amri zake wana busara.","poem":2},{"lineBreak":true},{"text":"Sifa zake zadumu milele.","poem":2}]}],"footnotes":[{"noteId":46,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah.","reference":{"chapter":111,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}