{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"heading","content":["Baraka za mwenye haki"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Mwenyezi Mungu.","poem":1},{"noteId":47},{"lineBreak":true},{"text":"Heri mtu yule amchaye Mwenyezi Mungu,","poem":1},{"text":"mtu yule apendezwaye sana na amri zake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Watoto wake watakuwa wenye uwezo katika nchi,","poem":1},{"text":"kizazi cha watu waadilifu kitabarikiwa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nyumbani mwake kuna mali na utajiri,","poem":1},{"text":"haki yake hudumu milele.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hata gizani nuru humzukia mtu mwadilifu,","poem":1},{"text":"yule mwenye rehema, huruma na haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mema yatamjia mtu yule aliye mkarimu na mwenye kukopesha bila riba,","poem":1},{"text":"anayefanya mambo yake kwa haki.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hakika hatatikisika kamwe,","poem":1},{"text":"mtu mwenye haki atakumbukwa milele.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hataogopa habari mbaya,","poem":1},{"text":"moyo wake ni thabiti, ukimtegemea Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moyo wake ni salama, hatakuwa na hofu,","poem":1},{"text":"mwishoni ataona ushindi dhidi ya adui zake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ametawanya vipawa vyake kwa ukarimu akawapa maskini;","poem":1},{"text":"haki yake hudumu milele;","poem":2},{"lineBreak":true},{"text":"pembe yake itatukuzwa kwa heshima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mtu mwovu ataona na kuchukizwa,","poem":1},{"text":"atasaga meno yake na kutoweka,","poem":2},{"lineBreak":true},{"text":"kutamani kwa mtu mwovu kutaishia patupu.","poem":2}]}],"footnotes":[{"noteId":47,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah.","reference":{"chapter":112,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}