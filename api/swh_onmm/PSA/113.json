{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"heading","content":["Kumsifu Mwenyezi Mungu kwa wema wake"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Mwenyezi Mungu.","poem":1},{"noteId":48},{"lineBreak":true},{"text":"Enyi watumishi wa Mwenyezi Mungu msifuni,","poem":1},{"text":"lisifuni jina la Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jina la Mwenyezi Mungu na lisifiwe,","poem":1},{"text":"sasa na hata milele.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuanzia mawio ya jua hadi machweo yake,","poem":1},{"text":"jina la Mwenyezi Mungu linapaswa kusifiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwenyezi Mungu ametukuka juu ya mataifa yote,","poem":1},{"text":"utukufu wake juu ya mbingu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ni nani aliye kama Mwenyezi Mungu, Mungu wetu,","poem":1},{"text":"Yule aliyeketi kwenye kiti cha enzi huko juu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ambaye huinama atazame chini","poem":1},{"text":"aone mbingu na nchi?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Huwainua maskini kutoka mavumbini,","poem":1},{"text":"na kuwanyanyua wahitaji","poem":2},{"lineBreak":true},{"text":"kutoka lundo la majivu,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"huwaketisha pamoja na wakuu,","poem":1},{"text":"pamoja na wakuu wa watu wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Humjalia mwanamke tasa kutulia nyumbani mwake,","poem":1},{"text":"akiwa mama watoto mwenye furaha.","poem":2},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu.","poem":1}]}],"footnotes":[{"noteId":48,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah; pia 113:9.","reference":{"chapter":113,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}