,{"text":"enyi vilima, kama wana-kondoo?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee dunia, tetemeka mbele za Bwana,","poem":1},{"text":"mbele za Mungu wa Yakobo,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"aliyegeuza mwamba kuwa dimbwi la maji,","poem":1},{"text":"mwamba mgumu kuwa chemchemi za maji.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}