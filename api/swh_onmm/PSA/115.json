{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"heading","content":["Mwenyezi Mungu Mmoja wa kweli"]},{"type":"verse","number":1,"content":[{"text":"Sio kwetu sisi, Ee Mwenyezi Mungu, sio kwetu sisi,","poem":1},{"text":"bali utukufu ni kwa jina lako,","poem":2},{"text":"kwa sababu ya upendo","poem":1},{"text":"na uaminifu wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kwa nini mataifa waseme,","poem":1},{"text":"“Yuko wapi Mungu wao?”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mungu wetu yuko mbinguni,","poem":1},{"text":"naye hufanya lolote limpendezalo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini sanamu zao ni za fedha na dhahabu,","poem":1},{"text":"zilizotengenezwa kwa mikono ya wanadamu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zina vinywa, lakini haziwezi kusema,","poem":1},{"text":"zina macho, lakini haziwezi kuona;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"zina masikio, lakini haziwezi kusikia,","poem":1},{"text":"zina pua, lakini haziwezi kunusa;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"zina mikono, lakini haziwezi kupapasa,","poem":1},{"text":"zina miguu, lakini haziwezi kutembea;","poem":2},{"lineBreak":true},{"text":"wala koo zao haziwezi kutoa sauti.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wale wanaozitengeneza watafanana nazo,","poem":1},{"text":"vivyo hivyo wale wote wanaozitumainia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee nyumba ya Israeli, mtumainini Mwenyezi Mungu,","poem":1},{"text":"yeye ni msaada na ngao yao.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee nyumba ya Haruni, mtumainini Mwenyezi Mungu,","poem":1},{"text":"yeye ni msaada na ngao yao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ninyi mnaomcha, mtumainini Mwenyezi Mungu,","poem":1},{"text":"yeye ni msaada na ngao yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mwenyezi Mungu anatukumbuka na atatubariki:","poem":1},{"text":"ataibariki nyumba ya Israeli,","poem":2},{"lineBreak":true},{"text":"ataibariki nyumba ya Haruni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"atawabariki wale wanaomcha Mwenyezi Mungu,","poem":1},{"text":"wadogo kwa wakubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mwenyezi Mungu na awawezeshe kuongezeka,","poem":1},{"text":"ninyi na watoto wenu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mbarikiwe na Mwenyezi Mungu","poem":1},{"text":"Muumba wa mbingu na dunia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mbingu zilizo juu sana ni mali ya Mwenyezi Mungu,","poem":1},{"text":"lakini dunia amempa mwanadamu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Sio wafu wanaomsifu Mwenyezi Mungu,","poem":1},{"text":"wale wanaoshuka mahali pa kimya","poem":2},{"noteId":49},{"text":",","poem":2}]},{"type":"verse","number":18,"content":[{"text":"bali ni sisi tunaomtukuza Mwenyezi Mungu,","poem":1},{"text":"sasa na hata milele.","poem":2},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu.","poem":1},{"noteId":50}]}],"footnotes":[{"noteId":49,"caller":"+","text":"mahali pa kimya maana yake Kuzimu; kwa Kiebrania ni Sheol.","reference":{"chapter":115,"verse":17}},{"noteId":50,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah.","reference":{"chapter":115,"verse":18}}]},"thisChapterLink":"/api/swh_onmm/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}