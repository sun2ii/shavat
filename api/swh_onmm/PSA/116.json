{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"heading","content":["Shukrani kwa kuokolewa kutoka mauti"]},{"type":"verse","number":1,"content":[{"text":"Nampenda Mwenyezi Mungu kwa maana amesikia sauti yangu;","poem":1},{"text":"amesikia kilio changu ili anihurumie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa sababu amenitegea sikio lake,","poem":1},{"text":"nitamwita siku zote za maisha yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kamba za mauti zilinizunguka,","poem":1},{"text":"vitisho vya Kuzimu","poem":2},{"noteId":51},{"text":"vilinipata,","poem":2},{"lineBreak":true},{"text":"nikalemewa na taabu na huzuni.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo nikaliitia jina la Mwenyezi Mungu:","poem":1},{"text":"“Ee Mwenyezi Mungu, niokoe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwenyezi Mungu ni mwenye neema na haki,","poem":1},{"text":"Mungu wetu ni mwingi wa huruma.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwenyezi Mungu huwalinda wanyenyekevu,","poem":1},{"text":"nilipokuwa katika shida kubwa, aliniokoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee nafsi yangu, tulia tena,","poem":1},{"text":"kwa kuwa Mwenyezi Mungu amekuwa mwema kwako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa kuwa wewe, Ee Mwenyezi Mungu,","poem":1},{"text":"umeniokoa nafsi yangu na mauti,","poem":2},{"text":"macho yangu kutokana na machozi,","poem":1},{"text":"miguu yangu kutokana na kujikwaa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ili niweze kutembea mbele za Mwenyezi Mungu,","poem":1},{"text":"katika nchi ya walio hai.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nilimwamini Mwenyezi Mungu, niliposema,","poem":1},{"text":"“Mimi nimeteseka sana.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Katika taabu yangu nilisema,","poem":1},{"text":"“Wanadamu wote ni waongo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Nimrudishie Mwenyezi Mungu nini","poem":1},{"text":"kwa wema wake wote alionitendea?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nitakiinua kikombe cha wokovu","poem":1},{"text":"na kulitangaza jina la Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nitazitimiza nadhiri zangu kwa Mwenyezi Mungu","poem":1},{"text":"mbele za watu wake wote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kifo cha watakatifu kina thamani","poem":1},{"text":"machoni pa Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ee Mwenyezi Mungu, hakika mimi ni mtumishi wako,","poem":1},{"text":"mimi ni mtumishi wako,","poem":2},{"lineBreak":true},{"text":"mwana wa mjakazi wako","poem":2},{"noteId":52},{"text":";","poem":2},{"text":"umeniweka huru","poem":1},{"text":"toka katika minyororo yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nitakutolea dhabihu ya kukushukuru","poem":1},{"text":"na kuliita jina la Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Nitazitimiza nadhiri zangu kwa Mwenyezi Mungu","poem":1},{"text":"mbele za watu wake wote,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"katika nyua za nyumba ya Mwenyezi Mungu,","poem":1},{"text":"katikati yako, ee Yerusalemu.","poem":2},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu.","poem":1},{"noteId":53}]}],"footnotes":[{"noteId":51,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":116,"verse":3}},{"noteId":52,"caller":"+","text":"au mwanao mwaminifu","reference":{"chapter":116,"verse":16}},{"noteId":53,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah.","reference":{"chapter":116,"verse":19}}]},"thisChapterLink":"/api/swh_onmm/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}