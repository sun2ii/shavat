,{"text":"Mwanadamu anaweza kunitenda nini?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwenyezi Mungu yuko pamoja nami,","poem":1},{"text":"yeye ni msaidizi wangu.","poem":2},{"text":"Nitawatazama adui zangu","poem":1},{"text":"wakiwa wameshindwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ni bora kumkimbilia Mwenyezi Mungu","poem":1},{"text":"kuliko kumtumainia mwanadamu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ni bora kumkimbilia Mwenyezi Mungu","poem":1},{"text":"kuliko kuwatumainia wakuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mataifa yote yalinizunguka,","poem":1},{"text":"lakini kwa jina la Mwenyezi Mungu naliwakatilia mbali.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Walinizunguka pande zote,","poem":1},{"text":"lakini kwa jina la Mwenyezi Mungu naliwakatilia mbali.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Walinizunguka kama kundi la nyuki,","poem":1},{"text":"lakini walikufa haraka kama miiba iteketeayo;","poem":2},{"lineBreak":true},{"text":"kwa jina la Mwenyezi Mungu naliwakatilia mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nilisukumwa nyuma karibu kuanguka,","poem":1},{"text":"lakini Mwenyezi Mungu alinisaidia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mwenyezi Mungu ni nguvu yangu na wimbo wangu,","poem":1},{"text":"yeye amefanyika wokovu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Sauti za shangwe na ushindi","poem":1},{"text":"zinavuma kwenye hema za wenye haki:","poem":2},{"text":"“Mkono wa kuume wa Mwenyezi Mungu","poem":1},{"text":"umetenda mambo makuu!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mkono wa kuume wa Mwenyezi Mungu","poem":1},{"text":"umeinuliwa juu,","poem":2},{"text":"mkono wa kuume wa Mwenyezi Mungu","poem":1},{"text":"umetenda mambo makuu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Sitakufa, bali nitaishi,","poem":1},{"text":"nami nitayatangaza matendo ya Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mwenyezi Mungu ameniadhibu vikali,","poem":1},{"text":"lakini hakuniacha nife.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Nifungulie malango ya haki,","poem":1},{"text":"nami nitaingia na kumshukuru Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hili ni lango la Mwenyezi Mungu","poem":1},{"text":"ambalo wenye haki wanaweza kuliingia.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Nitakushukuru, kwa kuwa ulinijibu,","poem":1},{"text":"umekuwa wokovu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Jiwe walilolikataa waashi,","poem":1},{"text":"limekuwa jiwe kuu la pembeni.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Mwenyezi Mungu ametenda hili,","poem":1},{"text":"nalo ni la kushangaza machoni petu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Hii ndiyo siku Mwenyezi Mungu aliyoifanya,","poem":1},{"text":"tushangilie na kufurahi ndani yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Ee Mwenyezi Mungu, tuokoe,","poem":1},{"text":"Ee Mwenyezi Mungu, utujalie mafanikio.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Heri yule ajaye kwa jina la Mwenyezi Mungu.","poem":1},{"text":"Kutoka nyumba ya Mwenyezi Mungu tunakubariki.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Mwenyezi Mungu ndiye Mungu,","poem":1},{"text":"naye ametuangazia nuru yake.","poem":2},{"text":"Mkiwa na matawi mkononi,","poem":1},{"text":"unganeni kwenye maandamano ya sikukuu","poem":2},{"lineBreak":true},{"text":"hadi kwenye pembe za madhabahu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Wewe ni Mungu wangu, nitakushukuru,","poem":1},{"text":"wewe ni Mungu wangu, nitakutukuza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Mshukuruni Mwenyezi Mungu kwa kuwa ni mwema;","poem":1},{"text":"fadhili zake zadumu milele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}