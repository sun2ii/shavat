{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"heading","content":["Kuomba msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa sheminithi. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mwenyezi Mungu tusaidie, kwa kuwa wacha Mungu wametoweka;","poem":1},{"text":"waaminifu wametoweka miongoni mwa wanadamu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kila mmoja humwambia jirani yake uongo;","poem":1},{"text":"midomo yao ya hila huzungumza kwa udanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mwenyezi Mungu na akatilie mbali midomo yote ya hila","poem":1},{"text":"na kila ulimi uliojaa majivuno,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ule unaosema, “Kwa ndimi zetu tutashinda;","poem":1},{"text":"midomo ni mali yetu, bwana wetu ni nani?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Kwa sababu wanyonge wanaonewa,","poem":1},{"text":"na wahitaji wanalia kwa uchungu,","poem":2},{"text":"nitainuka sasa,” asema Mwenyezi Mungu.","poem":1},{"text":"“Nitawalinda kutokana na wale","poem":2},{"lineBreak":true},{"text":"wenye nia mbaya juu yao.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maneno ya Mwenyezi Mungu ni safi,","poem":1},{"text":"kama fedha iliyosafishwa katika tanuru,","poem":2},{"lineBreak":true},{"text":"iliyosafishwa mara saba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mwenyezi Mungu, utatuweka salama","poem":1},{"text":"na kutulinda na kizazi hiki milele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Watu waovu huenda wakiringa kila mahali","poem":1},{"text":"wakati yule aliye mbaya sana","poem":2},{"lineBreak":true},{"text":"ndiye anayeheshimiwa miongoni mwa watu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}