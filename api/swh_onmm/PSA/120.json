{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"heading","content":["Kuomba msaada dhidi ya wadanganyifu"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu."]},{"type":"verse","number":1,"content":[{"text":"Katika dhiki yangu namwita Mwenyezi Mungu,","poem":1},{"text":"naye hunijibu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Mwenyezi Mungu, uniokoe kutoka midomo ya uongo","poem":1},{"text":"na ndimi za udanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Atakufanyia nini,","poem":1},{"text":"au akufanyie nini zaidi, ewe ulimi mdanganyifu?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atakuadhibu kwa mishale mikali ya shujaa,","poem":1},{"text":"kwa makaa yanayowaka ya mti wa mretemu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ole wangu kwa kuwa naishi Mesheki,","poem":1},{"text":"kwamba naishi katikati ya mahema ya Kedari!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nimeishi muda mrefu mno","poem":1},{"text":"miongoni mwa wale wanaochukia amani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mimi ni mtu wa amani;","poem":1},{"text":"lakini ninaposema, wao wanataka vita.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}