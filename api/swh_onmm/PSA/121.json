":"wala mwezi wakati wa usiku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwenyezi Mungu atakukinga na madhara yote,","poem":1},{"text":"atayalinda maisha yako,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu atakulinda unapoingia na unapotoka,","poem":1},{"text":"tangu sasa na hata milele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}