{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"heading","content":["Sifa kwa Yerusalemu"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu. Wa Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nilishangilia pamoja na wale walioniambia,","poem":1},{"text":"“Twende nyumbani mwa Mwenyezi Mungu.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Yerusalemu, miguu yetu imesimama","poem":1},{"text":"malangoni mwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Yerusalemu imejengwa vyema kama mji","poem":1},{"text":"ulioshikamana pamoja.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Huko ndiko makabila hukwea,","poem":1},{"text":"makabila ya Mwenyezi Mungu,","poem":2},{"text":"kulisifu jina la Mwenyezi Mungu kulingana na maagizo","poem":1},{"text":"waliopewa Israeli.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Huko viti vya hukumu hukaa,","poem":1},{"text":"viti vya ufalme vya nyumba ya Daudi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Omba kwa ajili ya amani ya Yerusalemu:","poem":1},{"text":"“Wote wanaokupenda na wawe salama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Amani na iwe ndani ya kuta zako,","poem":1},{"text":"na usalama ndani ya ngome zako.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kwa ajili ya ndugu na rafiki zangu,","poem":1},{"text":"nitasema, “Amani iwe ndani yako.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa ajili ya nyumba ya Mwenyezi Mungu, Mungu wetu,","poem":1},{"text":"nitatafuta mafanikio yako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}