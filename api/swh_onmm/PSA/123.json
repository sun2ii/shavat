e majivuno.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}