o yao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tumeponyoka kama ndege","poem":1},{"text":"kutoka mtego wa mwindaji;","poem":2},{"text":"mtego umevunjika,","poem":1},{"text":"nasi tumeokoka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Msaada wetu ni katika jina la Mwenyezi Mungu,","poem":1},{"text":"Muumba wa mbingu na dunia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}