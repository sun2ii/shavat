{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"heading","content":["Usalama wa watu wa Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu."]},{"type":"verse","number":1,"content":[{"text":"Wale wamtumainio Mwenyezi Mungu ni kama Mlima Sayuni,","poem":1},{"text":"ambao hauwezi kutikisika, bali wadumu milele.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama milima inavyozunguka Yerusalemu,","poem":1},{"text":"ndivyo Mwenyezi Mungu anavyowazunguka watu wake","poem":2},{"lineBreak":true},{"text":"sasa na hata milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Fimbo ya waovu haitadumu juu ya nchi","poem":1},{"text":"waliyopewa wenye haki,","poem":2},{"text":"ili wenye haki wasije wakatumia","poem":1},{"text":"mikono yao kutenda ubaya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Mwenyezi Mungu, watendee mema walio wema,","poem":1},{"text":"wale walio wanyofu wa moyo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bali wale wanaogeukia njia zilizopotoka,","poem":1},{"text":"Mwenyezi Mungu atawafukuza pamoja na watenda maovu.","poem":2},{"lineBreak":true},{"text":"Amani iwe juu ya Israeli.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}