vuna kwa nyimbo za shangwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeye azichukuaye mbegu zake","poem":1},{"text":"kwenda kupanda, huku akilia,","poem":2},{"text":"atarudi kwa nyimbo za shangwe,","poem":1},{"text":"akichukua miganda ya mavuno yake.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}