:2}]},{"type":"verse","number":5,"content":[{"text":"Heri mtu ambaye podo lake","poem":1},{"text":"limejazwa nao.","poem":2},{"text":"Hawataaibishwa wanaposhindana","poem":1},{"text":"na adui zao langoni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}