{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"heading","content":["Maombi dhidi ya adui za Israeli"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu."]},{"type":"verse","number":1,"content":[{"text":"Wamenitesa sana tangu ujana wangu;","poem":1},{"text":"Israeli na aseme sasa:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"wamenitesa sana tangu ujana wangu,","poem":1},{"text":"lakini bado hawajanishinda.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wakulima wamelima mgongo wangu,","poem":1},{"text":"na kufanya mifereji yao mirefu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini Mwenyezi Mungu ni mwenye haki;","poem":1},{"text":"amenifungua toka kamba za waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wale wote wanaoichukia Sayuni","poem":1},{"text":"na warudishwe nyuma kwa aibu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wawe kama majani juu ya paa,","poem":1},{"text":"ambayo hunyauka kabla hayajakua;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kwa hayo mvunaji hawezi kujaza vitanga vyake,","poem":1},{"text":"wala akusanyaye kujaza mikono yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wale wapitao karibu na wasiseme,","poem":1},{"text":"“Baraka ya Mwenyezi Mungu iwe juu yako;","poem":2},{"lineBreak":true},{"text":"tunakubariki katika jina la Mwenyezi Mungu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}