{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"heading","content":["Sala ya kuomba msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Hadi lini, Ee Mwenyezi Mungu? Je, utanisahau milele?","poem":1},{"text":"Utanificha uso wako hadi lini?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitapambana na mawazo yangu hadi lini,","poem":1},{"text":"na kila siku kuwa na majonzi moyoni mwangu?","poem":2},{"lineBreak":true},{"text":"Adui zangu watanishinda hadi lini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nitazame, unijibu, Ee Mwenyezi Mungu, Mungu wangu.","poem":1},{"text":"Yatie nuru macho yangu,","poem":2},{"lineBreak":true},{"text":"ama sivyo nitalala usingizi wa mauti.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Adui yangu atasema, “Nimemshinda,”","poem":1},{"text":"nao adui zangu watashangilia nitakapoanguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lakini ninategemea upendo wako usiokoma;","poem":1},{"text":"moyo wangu unashangilia katika wokovu wako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nitamwimbia Mwenyezi Mungu,","poem":1},{"text":"kwa kuwa amekuwa mwema kwangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}