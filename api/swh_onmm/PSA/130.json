{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"heading","content":["Kumngojea Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu."]},{"type":"verse","number":1,"content":[{"text":"Kutoka vilindini ninakulilia, Ee Mwenyezi Mungu.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Ee Bwana, sikia sauti yangu.","poem":2},{"text":"Masikio yako na yawe masikivu","poem":1},{"text":"kwa kilio changu unihurumie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kama wewe, Ee Mwenyezi Mungu, ungeweka kumbukumbu ya dhambi,","poem":1},{"text":"Ee Bwana, ni nani angeweza kusimama?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini kwako kuna msamaha,","poem":1},{"text":"kwa hiyo wewe unaogopwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Namngojea Mwenyezi Mungu, nafsi yangu inangojea,","poem":1},{"text":"katika neno lake naweka tumaini langu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nafsi yangu inamngojea Bwana","poem":1},{"text":"kuliko walinzi waingojeavyo asubuhi,","poem":2},{"text":"naam, kuliko walinzi","poem":1},{"text":"waingojeavyo asubuhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Israeli, mtumaini Mwenyezi Mungu,","poem":1},{"text":"maana kwa Mwenyezi Mungu kuna upendo usiokoma,","poem":2},{"lineBreak":true},{"text":"na kwake kuna ukombozi kamili.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeye mwenyewe ataikomboa Israeli","poem":1},{"text":"kutoka dhambi zao zote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}