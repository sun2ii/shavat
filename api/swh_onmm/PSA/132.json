{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"heading","content":["Maskani ya Mungu ya milele huko Sayuni"]},{"type":"hebrew_subtitle","content":["Wimbo wa kwenda juu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, mkumbuke Daudi","poem":1},{"text":"na taabu zote alizozistahimili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Aliapa kiapo kwa Mwenyezi Mungu","poem":1},{"text":"na akaweka nadhiri kwa Yule Mwenye Nguvu wa Yakobo:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“Sitaingia nyumbani mwangu","poem":1},{"text":"au kwenda kitandani mwangu:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"sitaruhusu usingizi katika macho yangu,","poem":1},{"text":"wala kope zangu kusinzia,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"hadi nitakapompatia Mwenyezi Mungu mahali,","poem":1},{"text":"makao kwa ajili ya Yule Mwenye Nguvu wa Yakobo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Tulisikia habari hii huko Efrata,","poem":1},{"text":"tulikutana nayo katika mashamba ya Yaara","poem":2},{"noteId":55},{"text":":","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Twendeni kwenye makao yake,","poem":1},{"text":"na tuabudu kwenye kiti cha kuwekea miguu yake;","poem":2}]},{"type":"verse","number":8,"content":[{"text":"inuka, Ee Mwenyezi Mungu, uje mahali pako pa kupumzikia,","poem":1},{"text":"wewe na Sanduku la nguvu zako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makuhani wako na wavikwe haki,","poem":1},{"text":"watakatifu wako na waimbe kwa furaha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kwa ajili ya Daudi mtumishi wako,","poem":1},{"text":"usimkatae mpakwa mafuta wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu alimwapia Daudi kiapo,","poem":1},{"text":"kiapo cha uhakika ambacho hatakitangua:","poem":2},{"text":"“Nitamweka mmoja wa wazao wako mwenyewe","poem":1},{"text":"kwenye kiti chako cha ufalme,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kama wanao watashika agano langu","poem":1},{"text":"na sheria ninazowafundisha,","poem":2},{"text":"ndipo wana wao watakalia kiti chako cha ufalme","poem":1},{"text":"milele na milele.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kwa maana Mwenyezi Mungu ameichagua Sayuni,","poem":1},{"text":"amepaonea shauku pawe maskani yake:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“Hapa ni mahali pangu pa kupumzika milele na milele;","poem":1},{"text":"hapa ndipo nitakapoketi nikitawala,","poem":2},{"lineBreak":true},{"text":"kwa sababu nimepaonea shauku:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitambariki kwa kumpa mahitaji tele:","poem":1},{"text":"nitashibisha maskini wake kwa chakula.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nitawavika makuhani wake wokovu,","poem":1},{"text":"nao watakatifu wake watadumu wakiimba kwa furaha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“Hapa nitamchipushia Daudi pembe","poem":1},{"noteId":56},{"text":",","poem":1},{"text":"na kuweka taa kwa ajili ya masiya","poem":2},{"noteId":57},{"text":"wangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Adui zake nitawavika aibu,","poem":1},{"text":"bali taji kichwani pake litang’aa sana.”","poem":2}]}],"footnotes":[{"noteId":55,"caller":"+","text":"yaani Kiriath-Yearimu","reference":{"chapter":132,"verse":6}},{"noteId":56,"caller":"+","text":"pembe inawakilisha nguvu","reference":{"chapter":132,"verse":17}},{"noteId":57,"caller":"+","text":"yaani mpakwa mafuta","reference":{"chapter":132,"verse":17}}]},"thisChapterLink":"/api/swh_onmm/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}