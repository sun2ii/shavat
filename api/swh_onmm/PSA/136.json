{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"heading","content":["Wimbo wa kumshukuru Mwenyezi Mungu"]},{"type":"verse","number":1,"content":[{"text":"Mshukuruni Mwenyezi Mungu, kwa kuwa ni mwema.","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":2,"content":[{"text":"Mshukuruni Mungu wa miungu.","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":3,"content":[{"text":"Mshukuruni Bwana wa mabwana:","poem":1},"Fadhili zake zadumu milele."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kwake yeye pekee atendaye maajabu makuu,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":5,"content":[{"text":"Ambaye kwa ufahamu wake aliziumba mbingu,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":6,"content":[{"text":"Ambaye aliitandaza dunia juu ya maji,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":7,"content":[{"text":"Ambaye aliumba mianga mikubwa,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":8,"content":[{"text":"Jua litawale mchana,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":9,"content":[{"text":"Mwezi na nyota vitawale usiku,","poem":1},"Fadhili zake zadumu milele."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kwake yeye aliyemuua mzaliwa wa kwanza wa Misri,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":11,"content":[{"text":"Na kuwatoa Israeli katikati yao,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":12,"content":[{"text":"Kwa mkono wenye nguvu ulionyooshwa,","poem":1},"Fadhili zake zadumu milele."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kwake yeye aliyeigawa Bahari ya Shamu,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":14,"content":[{"text":"Na kuwapitisha Israeli katikati yake,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":15,"content":[{"text":"Lakini alimfagia Farao na jeshi lake katika Bahari ya Shamu,","poem":1},"Fadhili zake zadumu milele."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Kwake yeye aliyewaongoza watu wake katika jangwa,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":17,"content":[{"text":"Ambaye aliwapiga wafalme wenye nguvu,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":18,"content":[{"text":"Naye aliwaua wafalme wenye nguvu,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":19,"content":[{"text":"Sihoni mfalme wa Waamori,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":20,"content":[{"text":"Ogu mfalme wa Bashani,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":21,"content":[{"text":"Akatoa nchi yao kuwa urithi,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":22,"content":[{"text":"Urithi kwa Israeli mtumishi wake,","poem":1},"Fadhili zake zadumu milele."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Aliyetukumbuka katika unyonge wetu,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":24,"content":[{"text":"Alituweka huru toka adui zetu,","poem":1},"Fadhili zake zadumu milele."]},{"type":"verse","number":25,"content":[{"text":"Ambaye humpa chakula kila kiumbe.","poem":1},"Fadhili zake zadumu milele."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"Mshukuruni Mungu wa mbinguni,","poem":1},"Fadhili zake zadumu milele."]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}