{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"heading","content":["Maombolezo ya Israeli uhamishoni"]},{"type":"verse","number":1,"content":[{"text":"Kando ya mito ya Babeli tuliketi, tukaomboleza","poem":1},{"text":"tulipokumbuka Sayuni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwenye miti ya huko","poem":1},{"text":"tulitundika vinubi vyetu,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwa maana huko hao waliotuteka","poem":1},{"text":"walitaka tuwaimbie nyimbo;","poem":2},{"text":"watesi wetu walidai nyimbo za furaha;","poem":1},{"text":"walisema, “Tuimbieni wimbo mmoja","poem":2},{"lineBreak":true},{"text":"kati ya nyimbo za Sayuni!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Tutaimbaje nyimbo za Mwenyezi Mungu,","poem":1},{"text":"tukiwa nchi ya kigeni?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nikikusahau wewe, ee Yerusalemu,","poem":1},{"text":"basi mkono wangu wa kuume na usahau ujuzi wake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ulimi wangu ushikamane na kaakaa la kinywa changu","poem":1},{"text":"kama sitakukumbuka wewe,","poem":2},{"text":"kama nisipokufikiri Yerusalemu","poem":1},{"text":"kuwa furaha yangu kubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kumbuka, Ee Mwenyezi Mungu, walichokifanya Waedomu,","poem":1},{"text":"siku ile Yerusalemu ilipoanguka.","poem":2},{"text":"Walisema, “Bomoa, bomoa","poem":1},{"text":"hata misingi yake!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee binti Babeli, uliyehukumiwa kuangamizwa,","poem":1},{"text":"heri yeye atakayekulipiza wewe","poem":2},{"lineBreak":true},{"text":"kwa yale uliyotutenda sisi:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"yeye ambaye atawakamata watoto wako wachanga","poem":1},{"text":"na kuwaponda juu ya miamba.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}