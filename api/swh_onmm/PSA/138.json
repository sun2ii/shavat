{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"heading","content":["Maombi ya shukrani"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nitakusifu wewe, Ee Mwenyezi Mungu, kwa moyo wangu wote,","poem":1},{"text":"mbele ya “miungu” nitaimba sifa zako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitasujudu nikielekea Hekalu lako takatifu,","poem":1},{"text":"nami nitalisifu jina lako","poem":2},{"text":"kwa ajili ya upendo wako","poem":1},{"text":"na uaminifu,","poem":2},{"text":"kwa maana umeitukuza ahadi yako","poem":1},{"text":"zaidi ya jina lako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nilipoita, ulinijibu;","poem":1},{"text":"ulinifanya jasiri na mwenye moyo hodari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wafalme wote wa dunia wakusifu wewe Ee Mwenyezi Mungu,","poem":1},{"text":"wakati wanaposikia maneno ya kinywa chako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wao na waimbe kuhusu njia za Mwenyezi Mungu,","poem":1},{"text":"kwa maana utukufu wa Mwenyezi Mungu ni mkuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ingawa Mwenyezi Mungu yuko juu,","poem":1},{"text":"humwangalia mnyonge,","poem":2},{"text":"bali mwenye kiburi","poem":1},{"text":"yeye anamjua kutokea mbali.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nijapopita katikati ya shida,","poem":1},{"text":"wewe unayahifadhi maisha yangu,","poem":2},{"text":"unanyoosha mkono wako dhidi ya hasira ya adui zangu,","poem":1},{"text":"kwa mkono wako wa kuume unaniokoa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu atatimiza kusudi lake kwangu,","poem":1},{"text":"Ee Mwenyezi Mungu, upendo wako wadumu milele:","poem":2},{"lineBreak":true},{"text":"usiziache kazi za mikono yako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}