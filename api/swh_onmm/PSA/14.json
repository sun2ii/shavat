{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"heading","content":["Uovu wa wanadamu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mpumbavu anasema moyoni mwake,","poem":1},{"text":"“Hakuna Mungu.”","poem":2},{"text":"Wamepotoka, matendo yao ni maovu kabisa;","poem":1},{"text":"hakuna hata mmoja atendaye mema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu anawachungulia wanadamu","poem":1},{"text":"kutoka mbinguni","poem":2},{"text":"aone kama kuna mwenye hekima,","poem":1},{"text":"yeyote anayemtafuta Mungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wote wamepotoka,","poem":1},{"text":"wote wameoza pamoja;","poem":2},{"text":"hakuna atendaye mema,","poem":1},{"text":"naam, hakuna hata mmoja!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Je, watendao maovu kamwe hawatajifunza:","poem":1},{"text":"wale ambao huwala watu wangu","poem":2},{"text":"kama watu walavyo mkate,","poem":1},{"text":"hao ambao hawamwiti Mwenyezi Mungu?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wako hapo, wameingiwa na hofu kuu,","poem":1},{"text":"maana Mungu yupo pamoja na wenye haki.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ninyi watenda maovu mnakwamisha mipango ya maskini,","poem":1},{"text":"bali Mwenyezi Mungu ndiye kimbilio lao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Laiti wokovu wa Israeli","poem":1},{"text":"ungekuja kutoka Sayuni!","poem":2},{"text":"Mwenyezi Mungu anaporejesha","poem":1},{"text":"wafungwa wa watu wake,","poem":2},{"text":"Yakobo na ashangilie,","poem":1},{"text":"Israeli na afurahi!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}