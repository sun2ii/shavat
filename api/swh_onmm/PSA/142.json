{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"heading","content":["Maombi ya kuokolewa dhidi ya watesi"]},{"type":"hebrew_subtitle","content":["Utenzi wa Daudi. Alipokuwa pangoni. Maombi."]},{"type":"verse","number":1,"content":[{"text":"Namlilia Mwenyezi Mungu kwa sauti,","poem":1},{"text":"napaza sauti yangu kwa Mwenyezi Mungu anihurumie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Namimina malalamiko yangu mbele zake,","poem":1},{"text":"mbele zake naeleza shida zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Roho yangu inapozimia ndani yangu,","poem":1},{"text":"wewe ndiwe unajua njia zangu.","poem":2},{"text":"Katika njia ninayopita,","poem":1},{"text":"watu wameniwekea mtego.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tazama kuume kwangu na uone,","poem":1},{"text":"hakuna hata mmoja anayejihusisha nami.","poem":2},{"text":"Sina kimbilio,","poem":1},{"text":"hakuna anayejali maisha yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mwenyezi Mungu, nakulilia wewe,","poem":1},{"text":"nasema, “Wewe ni kimbilio langu,","poem":2},{"lineBreak":true},{"text":"fungu langu katika nchi ya walio hai.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sikiliza kilio changu,","poem":1},{"text":"kwa sababu mimi ni mhitaji sana;","poem":2},{"text":"niokoe na wale wanaonifuatilia,","poem":1},{"text":"kwa kuwa wamenizidi nguvu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nifungue kutoka kifungo changu,","poem":1},{"text":"ili niweze kulisifu jina lako.","poem":2},{"lineBreak":true},{"text":"Ndipo wenye haki watanizunguka,","poem":1},{"text":"kwa sababu ya wema wako kwangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}