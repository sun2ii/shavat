{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"heading","content":["Maombi ya kuokolewa dhidi ya adui"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, sikia sala yangu,","poem":1},{"text":"sikiliza kilio changu unihurumie;","poem":2},{"text":"katika uaminifu na haki yako","poem":1},{"text":"njoo unisaidie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Usimhukumu mtumishi wako,","poem":1},{"text":"kwa kuwa hakuna mtu aliye hai","poem":2},{"lineBreak":true},{"text":"mwenye haki mbele zako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Adui hunifuatilia,","poem":1},{"text":"hunipondaponda chini;","poem":2},{"text":"hunifanya niishi gizani","poem":1},{"text":"kama wale waliokufa zamani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa hiyo roho yangu inazimia ndani yangu,","poem":1},{"text":"moyo wangu ndani yangu unakata tamaa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Nakumbuka siku za zamani;","poem":1},{"text":"natafakari juu ya kazi zako zote,","poem":2},{"text":"naangalia juu ya kazi","poem":1},{"text":"ambazo mikono yako imezifanya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nanyoosha mikono yangu kwako,","poem":1},{"text":"nafsi yangu inakuonea kiu kama ardhi kame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mwenyezi Mungu, unijibu haraka,","poem":1},{"text":"roho yangu inazimia.","poem":2},{"text":"Usinifiche uso wako,","poem":1},{"text":"ama sivyo nitafanana na wale wanaoshuka shimoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asubuhi uniletee neno la upendo wako usiokoma,","poem":1},{"text":"kwa kuwa nimeweka tumaini langu kwako.","poem":2},{"text":"Nioneshe njia nitakayoiendea,","poem":1},{"text":"kwa kuwa kwako nainua nafsi yangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mwenyezi Mungu, uniokoe na adui zangu,","poem":1},{"text":"kwa kuwa nimejificha kwako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nifundishe kufanya mapenzi yako,","poem":1},{"text":"kwa maana wewe ndiwe Mungu wangu,","poem":2},{"text":"Roho wako mwema na aniongoze","poem":1},{"text":"katika nchi tambarare.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Mwenyezi Mungu, kwa ajili ya jina lako, hifadhi maisha yangu,","poem":1},{"text":"kwa haki yako nitoe katika taabu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa upendo wako usiokoma,","poem":1},{"text":"nyamazisha adui zangu;","poem":2},{"text":"waangamize watesi wangu wote,","poem":1},{"text":"kwa kuwa mimi ni mtumishi wako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}