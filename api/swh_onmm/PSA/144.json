{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"heading","content":["Mfalme amshukuru Mwenyezi Mungu kwa ushindi"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ahimidiwe Mwenyezi Mungu Mwamba wangu,","poem":1},{"text":"aifundishaye mikono yangu vita,","poem":2},{"lineBreak":true},{"text":"na vidole vyangu kupigana.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yeye ni Mungu wangu wa upendo na ulinzi wangu,","poem":1},{"text":"ngome yangu na mwokozi wangu,","poem":2},{"text":"ngao yangu, ninayemkimbilia,","poem":1},{"text":"ambaye huwatiisha mataifa chini yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Mwenyezi Mungu, mwanadamu ni nini hata umjali,","poem":1},{"text":"Binadamu ni nini hata umfikirie?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwanadamu ni kama pumzi,","poem":1},{"text":"siku zake ni kama kivuli kinachopita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mwenyezi Mungu, pasua mbingu zako, ushuke,","poem":1},{"text":"gusa milima ili itoe moshi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Peleka umeme uwatawanye adui,","poem":1},{"text":"lenga mishale yako uwashinde.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyoosha mkono wako kutoka juu,","poem":1},{"text":"nikomboe na kuniokoa","poem":2},{"text":"kutoka maji makuu,","poem":1},{"text":"kutoka mikononi mwa wageni","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ambao vinywa vyao vimejaa uongo,","poem":1},{"text":"na mikono yao ya kuume ni midanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mungu, nitakuimbia wimbo mpya,","poem":1},{"text":"kwa zeze yenye nyuzi kumi nitakuimbia,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kwa Yule awapaye wafalme ushindi,","poem":1},{"text":"ambaye humwokoa Daudi, mtumishi wake,","poem":2},{"lineBreak":true},{"text":"kutokana na upanga hatari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Nikomboe na uniokoe","poem":1},{"text":"kutoka mikononi mwa wageni","poem":2},{"text":"ambao vinywa vyao vimejaa uongo,","poem":1},{"text":"na mikono yao ya kuume ni midanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kisha wana wetu wakati wa ujana wao","poem":1},{"text":"watakuwa kama mimea iliyotunzwa vizuri,","poem":2},{"text":"binti zetu watakuwa kama nguzo zilizoviringwa","poem":1},{"text":"kurembesha jumba la kifalme.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ghala zetu zitajazwa","poem":1},{"text":"aina zote za mahitaji.","poem":2},{"text":"Kondoo wetu watazaa kwa maelfu,","poem":1},{"text":"kwa makumi ya maelfu katika mashamba yetu;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"maksai wetu watakokota","poem":1},{"text":"mizigo mizito.","poem":2},{"text":"Hakutakuwa na kubomoka kuta,","poem":1},{"text":"hakuna kuchukuliwa mateka,","poem":2},{"text":"wala kilio cha taabu","poem":1},{"text":"katika barabara zetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Heri watu ambao hili ni kweli;","poem":1},{"text":"heri wale ambao Mwenyezi Mungu ni Mungu wao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}