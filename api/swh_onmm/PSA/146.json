{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"heading","content":["Kumsifu Mwenyezi Mungu mwokozi"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Mwenyezi Mungu!","poem":1},{"noteId":60},{"lineBreak":true},{"text":"Ee nafsi yangu, umsifu Mwenyezi Mungu,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Nitamsifu Mwenyezi Mungu maisha yangu yote;","poem":2},{"text":"nitamwimbia Mungu wangu sifa","poem":1},{"text":"wakati wote ningali hai.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Usiweke tumaini lako kwa wakuu,","poem":1},{"text":"kwa wanadamu ambao hufa,","poem":2},{"lineBreak":true},{"text":"ambao hawawezi kuokoa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Roho yao itokapo hurudi mavumbini,","poem":1},{"text":"siku hiyo hiyo mipango yao yote hukoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Heri yeye ambaye Mungu wa Yakobo ni msaada wake,","poem":1},{"text":"ambaye tumaini lake ni katika Mwenyezi Mungu, Mungu wake,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Muumba wa mbingu na nchi,","poem":1},{"text":"na bahari na vyote vilivyomo:","poem":2},{"text":"Mwenyezi Mungu anayedumu kuwa mwaminifu","poem":1},{"text":"milele na milele.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Naye huwapatia haki waliodhulumiwa,","poem":1},{"text":"na kuwapa wenye njaa chakula.","poem":2},{"text":"Mwenyezi Mungu huwaweka wafungwa huru,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu huwafumbua vipofu macho,","poem":2},{"text":"Mwenyezi Mungu huwainua waliolemewa na mizigo yao,","poem":1},{"text":"Mwenyezi Mungu huwapenda wenye haki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwenyezi Mungu huwalinda wageni","poem":1},{"text":"na kuwategemeza yatima na wajane,","poem":2},{"lineBreak":true},{"text":"lakini hupinga njia za waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwenyezi Mungu atamiliki milele,","poem":1},{"text":"Mungu wako, ee Sayuni,","poem":2},{"lineBreak":true},{"text":"kwa vizazi vyote.","poem":2},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu.","poem":1}]}],"footnotes":[{"noteId":60,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah; pia 146:10.","reference":{"chapter":146,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}