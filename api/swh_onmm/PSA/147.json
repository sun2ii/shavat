ext":"Mwenyezi Mungu huwahifadhi wanyenyekevu","poem":1},{"text":"lakini huwashusha waovu hadi mavumbini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwimbieni Mwenyezi Mungu kwa shukrani,","poem":1},{"text":"mpigieni Mungu wetu kinubi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Yeye huzifunika anga kwa mawingu,","poem":1},{"text":"huinyeshea ardhi mvua,","poem":2},{"lineBreak":true},{"text":"na kuzifanya nyasi kuota juu ya vilima.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huwapa chakula mifugo","poem":1},{"text":"na pia makinda ya kunguru yanapolia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Furaha yake haipo katika nguvu za farasi,","poem":1},{"text":"wala furaha yake kwenye miguu ya shujaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu hupendezwa na wale wamchao,","poem":1},{"text":"wale wanaoweka tumaini lao katika upendo wake usiokoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mtukuze Mwenyezi Mungu, ee Yerusalemu,","poem":1},{"text":"msifu Mungu wako, ee Sayuni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"kwa maana huimarisha makomeo ya malango yako","poem":1},{"text":"na huwabariki watu wako walio ndani yako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Huwapa amani mipakani mwenu","poem":1},{"text":"na kukushibisha kwa ngano safi kabisa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Hutuma amri yake duniani,","poem":1},{"text":"neno lake hukimbia kasi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Anatandaza theluji kama sufu","poem":1},{"text":"na kutawanya umande kama majivu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Huvurumisha mvua yake ya mawe kama changarawe.","poem":1},{"text":"Ni nani awezaye kustahimili ukali wa baridi yake?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hutuma neno lake na kuviyeyusha,","poem":1},{"text":"huvumisha upepo wake, nayo maji hutiririka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Amemfunulia Yakobo neno lake,","poem":1},{"text":"sheria zake na maagizo yake kwa Israeli.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Hajafanya hivyo kwa taifa lingine lolote,","poem":1},{"text":"hawazijui sheria zake.","poem":2},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu.","poem":1}]}],"footnotes":[{"noteId":61,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah; pia 147:20.","reference":{"chapter":147,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}