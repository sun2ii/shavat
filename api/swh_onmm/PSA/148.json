{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"heading","content":["Mwito kwa ulimwengu kumsifu Mwenyezi Mungu"]},{"type":"verse","number":1,"content":[{"text":"Msifuni Mwenyezi Mungu.","poem":1},{"noteId":62},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu kutoka mbinguni,","poem":1},{"text":"msifuni juu vileleni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Msifuni, enyi malaika wake wote,","poem":1},{"text":"msifuni yeye, enyi jeshi lake lote la mbinguni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Msifuni yeye, enyi jua na mwezi,","poem":1},{"text":"msifuni yeye, enyi nyota zote zinazong’aa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Msifuni yeye, enyi mbingu zilizo juu sana,","poem":1},{"text":"na ninyi maji juu ya anga.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Vilisifu jina la Mwenyezi Mungu","poem":1},{"text":"kwa maana aliamuru navyo vikaumbwa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Aliviweka mahali pake milele na milele,","poem":1},{"text":"alitoa amri ambayo haibadiliki milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Msifuni Mwenyezi Mungu kutoka duniani,","poem":1},{"text":"ninyi wanyama wakubwa wa baharini,","poem":2},{"lineBreak":true},{"text":"na vilindi vyote vya bahari,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"miali ya radi na mvua ya mawe, theluji na mawingu,","poem":1},{"text":"pepo za dhoruba zinazotimiza amri zake,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ninyi milima na vilima vyote,","poem":1},{"text":"miti ya matunda na mierezi yote,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"wanyama pori na mifugo yote,","poem":1},{"text":"viumbe vidogo na ndege warukao,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"wafalme wa dunia na mataifa yote,","poem":1},{"text":"ninyi wakuu na watawala wote wa dunia,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"vijana wa kiume na wanawali,","poem":1},{"text":"wazee na watoto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Wote na walisifu jina la Mwenyezi Mungu,","poem":1},{"text":"kwa maana jina lake pekee limetukuka,","poem":2},{"lineBreak":true},{"text":"utukufu wake uko juu ya nchi na mbingu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Amewainulia watu wake pembe","poem":1},{"noteId":63},{"text":",","poem":1},{"text":"sifa ya watakatifu wake wote,","poem":2},{"lineBreak":true},{"text":"ya Israeli, watu walio karibu na moyo wake.","poem":2},{"lineBreak":true},{"text":"Msifuni Mwenyezi Mungu.","poem":1}]}],"footnotes":[{"noteId":62,"caller":"+","text":"kwa Kiebrania ni Hallelu Yah; pia 148:7, 14.","reference":{"chapter":148,"verse":1}},{"noteId":63,"caller":"+","text":"pembe inawakilisha mwenye nguvu, yaani mfalme","reference":{"chapter":148,"verse":14}}]},"thisChapterLink":"/api/swh_onmm/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}