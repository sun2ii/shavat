{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"heading","content":["Kitu Mwenyezi Mungu anachotaka"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mwenyezi Mungu, ni nani awezaye kukaa","poem":1},{"text":"katika Hekalu lako?","poem":2},{"text":"Nani awezaye kuishi","poem":1},{"text":"katika mlima wako mtakatifu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ni yule aendaye pasipo mawaa,","poem":1},{"text":"atendaye yaliyo haki,","poem":2},{"text":"asemaye kweli toka moyoni mwake,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"na hana masingizio ulimini mwake,","poem":2},{"text":"asiyemtenda jirani yake vibaya,","poem":1},{"text":"na asiyemsingizia mwenzake,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ambaye humdharau mtu mbaya,","poem":1},{"text":"lakini huwaheshimu wale wamwogopao Mwenyezi Mungu,","poem":2},{"text":"yule atunzaye kiapo chake","poem":1},{"text":"hata kama anaumia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yeye akopeshaye fedha yake bila riba,","poem":1},{"text":"na hapokei rushwa dhidi ya mtu asiye na hatia.","poem":2},{"lineBreak":true},{"text":"Mtu afanyaye haya","poem":1},{"text":"kamwe hatatikisika.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}