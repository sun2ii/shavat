{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"heading","content":["Sala ya matumaini"]},{"type":"hebrew_subtitle","content":["Utenzi wa Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, uniweke salama,","poem":1},{"text":"kwa maana kwako nimekimbilia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nilimwambia Mwenyezi Mungu, “Wewe ndiwe Bwana wangu;","poem":1},{"text":"pasipo wewe sina jambo jema.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kuhusu watakatifu walio duniani,","poem":1},{"text":"hao ndio wenye fahari,","poem":2},{"lineBreak":true},{"text":"na ninapendezwa nao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Huzuni itaongezeka kwa wale","poem":1},{"text":"wanaokimbilia miungu mingine.","poem":2},{"text":"Sitazimimina sadaka za damu kwa miungu kama hiyo,","poem":1},{"text":"au kutaja majina yao mdomoni mwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwenyezi Mungu umeniwekea fungu langu na kikombe changu;","poem":1},{"text":"umeyafanya mambo yangu yote yawe salama.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alama za mipaka zimeniangukia mahali pazuri,","poem":1},{"text":"hakika nimepata urithi mzuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Nitamsifu Mwenyezi Mungu ambaye hunishauri,","poem":1},{"text":"hata wakati wa usiku moyo wangu hunifundisha.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nimemweka Mwenyezi Mungu mbele yangu daima.","poem":1},{"text":"Kwa sababu yuko mkono wangu wa kuume,","poem":2},{"lineBreak":true},{"text":"sitatikisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kwa hiyo moyo wangu unafurahia,","poem":1},{"text":"na ulimi wangu unashangilia;","poem":2},{"text":"mwili wangu nao","poem":1},{"text":"utapumzika salama,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"kwa maana hutaniacha Kuzimu","poem":1},{"noteId":4},{"text":",","poem":1},{"text":"wala hutamwacha Mtakatifu Wako","poem":2},{"lineBreak":true},{"text":"kuona uharibifu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Umenijulisha njia ya uzima;","poem":1},{"text":"utanijaza na furaha mbele zako,","poem":2},{"text":"pamoja na furaha ya milele","poem":1},{"text":"katika mkono wako wa kuume.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":16,"verse":10}}]},"thisChapterLink":"/api/swh_onmm/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}