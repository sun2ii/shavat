{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"heading","content":["Wimbo wa Daudi wa ushindi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi mtumishi wa Mwenyezi Mungu aliyomwimbia Mwenyezi Mungu alipomwokoa mikononi mwa adui zake wote, na pia mkononi mwa Sauli. Alisema hivi:"]},{"type":"verse","number":1,"content":[{"text":"Nakupenda wewe, Ee Mwenyezi Mungu,","poem":1},{"text":"nguvu yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu ni mwamba wangu,","poem":1},{"text":"ngome yangu na mwokozi wangu;","poem":2},{"text":"Mungu wangu ni mwamba wangu,","poem":1},{"text":"ninayemkimbilia.","poem":2},{"text":"Yeye ni ngao yangu na pembe","poem":1},{"noteId":5},{"text":"ya wokovu wangu,","poem":1},{"text":"ngome yangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ninamwita Mwenyezi Mungu anayestahili kusifiwa,","poem":1},{"text":"nami ninaokolewa kutoka kwa adui zangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kamba za mauti zilinizunguka,","poem":1},{"text":"mafuriko ya maangamizi yalinilemea.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kamba za Kuzimu zilinizunguka,","poem":1},{"text":"mitego ya mauti ilinikabili.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Katika shida yangu nalimwita Mwenyezi Mungu,","poem":1},{"text":"nilimlilia Mungu wangu anisaidie.","poem":2},{"text":"Kutoka hekaluni mwake alisikia sauti yangu,","poem":1},{"text":"kilio changu kikafika mbele zake,","poem":2},{"lineBreak":true},{"text":"masikioni mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Dunia ilitetemeka na kutikisika,","poem":1},{"text":"misingi ya milima ikatikisika;","poem":2},{"lineBreak":true},{"text":"vilitetemeka kwa sababu alikuwa amekasirika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moshi ukapanda kutoka puani mwake,","poem":1},{"text":"moto uteketezao ukatoka kinywani mwake,","poem":2},{"text":"makaa ya moto yanayowaka","poem":1},{"text":"yakatoka ndani yake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Akazipasua mbingu akashuka chini,","poem":1},{"text":"mawingu meusi yalikuwa chini ya miguu yake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Alipanda juu ya kerubi akaruka,","poem":1},{"text":"akapaa juu kwa mabawa ya upepo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Alifanya giza kuwa kitu chake cha kujifunika,","poem":1},{"text":"hema lake kumzunguka:","poem":2},{"lineBreak":true},{"text":"mawingu meusi ya mvua ya angani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kutokana na mwanga wa uwepo wake","poem":1},{"text":"mawingu yalisogea,","poem":2},{"text":"ikashuka mvua ya mawe","poem":1},{"text":"na miali ya radi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mwenyezi Mungu alinguruma kutoka mbinguni,","poem":1},{"text":"sauti ya Aliye Juu Sana ilisikika.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aliipiga mishale yake na kutawanya adui,","poem":1},{"text":"naam, umeme mwingi wa radi na kuwafukuza.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mabonde ya bahari yalifunuliwa,","poem":1},{"text":"na misingi ya dunia ikawa wazi","poem":2},{"text":"kwa kukaripia kwako, Ee Mwenyezi Mungu,","poem":1},{"text":"kwa uvumi wa pumzi kutoka puani mwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Alinyoosha mkono kutoka juu na kunishika;","poem":1},{"text":"alinitoa kilindini cha maji makuu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Aliniokoa kutoka adui yangu mwenye nguvu nyingi,","poem":1},{"text":"kutoka adui zangu waliokuwa na nguvu nyingi kuliko mimi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Walinikabili siku ya msiba wangu,","poem":1},{"text":"lakini Mwenyezi Mungu alikuwa msaada wangu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Alinileta nje mahali penye nafasi tele,","poem":1},{"text":"akaniokoa kwa kuwa alipendezwa nami.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mwenyezi Mungu alinitendea sawasawa na uadilifu wangu;","poem":1},{"text":"amenilipa sawasawa na usafi wa mikono yangu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kwa maana nimezishika njia za Mwenyezi Mungu;","poem":1},{"text":"sijatenda ubaya nikamwacha Mungu wangu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Sheria zake zote zi mbele yangu,","poem":1},{"text":"wala sijayaacha maagizo yake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nimekuwa sina hatia mbele zake,","poem":1},{"text":"nami nimejilinda nisitende dhambi.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Mwenyezi Mungu amenilipa sawasawa na uadilifu wangu;","poem":1},{"text":"sawasawa na usafi wa mikono yangu machoni pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kwa yeye aliye mwaminifu, unajionesha kuwa mwaminifu,","poem":1},{"text":"kwa asiye na hatia, unajionesha kutokuwa na hatia.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Kwa aliye mtakatifu, unajionesha kuwa mtakatifu,","poem":1},{"text":"lakini kwa aliyepotoka, unajionesha kuwa mkaidi.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Wewe huwaokoa wanyenyekevu,","poem":1},{"text":"lakini huwashusha wenye kiburi.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Wewe, Ee Mwenyezi Mungu, unaifanya taa yangu iendelee kuwaka;","poem":1},{"text":"Mungu wangu hulifanya giza langu kuwa mwanga.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kwa msaada wako naweza kushinda jeshi,","poem":1},{"text":"nikiwa pamoja na Mungu wangu","poem":2},{"lineBreak":true},{"text":"nitaweza kuruka ukuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kuhusu Mungu, njia yake ni kamilifu,","poem":1},{"text":"neno la Mwenyezi Mungu halina dosari.","poem":2},{"text":"Yeye ni ngao kwa wote","poem":1},{"text":"wanaokimbilia kwake.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Kwa maana ni nani aliye Mungu","poem":1},{"text":"zaidi ya Mwenyezi Mungu?","poem":2},{"text":"Ni nani aliye Mwamba","poem":1},{"text":"isipokuwa Mungu wetu?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Mungu ndiye anivikaye nguvu","poem":1},{"text":"na kufanya njia yangu kuwa kamilifu.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Huifanya miguu yangu kama miguu ya kulungu,","poem":1},{"text":"huniwezesha kusimama mahali palipo juu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Huifundisha mikono yangu kupigana vita;","poem":1},{"text":"mikono yangu inaweza kupinda upinde wa shaba.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Hufanya msaada wa wokovu wako kuwa ngao yangu,","poem":1},{"text":"nao mkono wako wa kuume hunitegemeza;","poem":2},{"lineBreak":true},{"text":"msaada wako umeniinua niwe mkuu.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Huyapanua mapito yangu,","poem":1},{"text":"ili miguu yangu isiteleze.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Niliwafuatia adui zangu na nikawapata,","poem":1},{"text":"sikurudi nyuma hadi walipoangamizwa.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Niliwaseta hata hawakuweza kuinuka tena;","poem":1},{"text":"walianguka chini ya miguu yangu.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Ulinivika nguvu kwa ajili ya kupigana vita;","poem":1},{"text":"uliwafanya adui zangu wasujudu miguuni pangu.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Uliwafanya adui zangu wageuke na kukimbia,","poem":1},{"text":"nami nikawaangamiza adui zangu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Walipiga yowe, lakini hapakuwa na mtu wa kuwaokoa;","poem":1},{"text":"walimlilia Mwenyezi Mungu, lakini hakuwajibu.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Niliwaponda kama mavumbi yanayopeperushwa na upepo;","poem":1},{"text":"niliwamwaga nje kama tope barabarani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"Umeniokoa kutokana na mashambulizi ya watu;","poem":1},{"text":"umenifanya kiongozi wa mataifa;","poem":2},{"lineBreak":true},{"text":"watu ambao sikuwajua wananitumikia.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Mara wanisikiapo hunitii,","poem":1},{"text":"wageni hunyenyekea mbele yangu.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Wote wanalegea,","poem":1},{"text":"wanatoka katika ngome zao wakitetemeka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Mwenyezi Mungu yu hai! Sifa ni kwa Mwamba wangu!","poem":1},{"text":"Atukuzwe Mungu Mwokozi wangu!","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Yeye ndiye Mungu anilipiziaye kisasi,","poem":1},{"text":"awatiishaye mataifa chini yangu,","poem":2}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"aniokoaye na adui zangu.","poem":2},{"text":"Uliniinua juu ya adui zangu;","poem":1},{"text":"uliniokoa toka kwa watu wajeuri.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Kwa hiyo nitakusifu katika mataifa, Ee Mwenyezi Mungu;","poem":1},{"text":"nitaliimbia sifa jina lako.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Humpa mfalme wake ushindi mkuu,","poem":1},{"text":"huonesha fadhili zake kwa mpakwa mafuta wake,","poem":2},{"lineBreak":true},{"text":"kwa Daudi na wazao wake milele.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"pembe inamaanisha nguvu","reference":{"chapter":18,"verse":2}}]},"thisChapterLink":"/api/swh_onmm/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}