{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"heading","content":["Utukufu wa Mwenyezi Mungu katika uumbaji"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mbingu zinatangaza utukufu wa Mungu,","poem":1},{"text":"anga zahubiri kazi ya mikono yake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Siku baada ya siku zinatoa habari,","poem":1},{"text":"usiku baada ya usiku zinatangaza maarifa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hakuna msemo wala lugha,","poem":1},{"text":"ambapo sauti zao hazisikiki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Sauti yao imeenea duniani pote,","poem":1},{"text":"nayo maneno yao yameenea","poem":2},{"lineBreak":true},{"text":"hadi miisho ya ulimwengu.","poem":2},{"lineBreak":true},{"text":"Katika mbingu amepiga hema kwa ajili ya jua,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"linafanana na bwana arusi","poem":2},{"lineBreak":true},{"text":"akitoka chumbani mwake,","poem":2},{"text":"kama shujaa anavyofurahia","poem":1},{"text":"kukamilisha kushindana kwake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Huchomoza upande mmoja wa mbingu,","poem":1},{"text":"na kufanya mzunguko wake","poem":2},{"lineBreak":true},{"text":"hadi upande mwingine.","poem":2},{"lineBreak":true},{"text":"Hakuna kilichojificha joto lake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Torati ya Mwenyezi Mungu ni kamilifu,","poem":1},{"text":"ikihuisha nafsi.","poem":2},{"text":"Shuhuda za Mwenyezi Mungu ni za kuaminika,","poem":1},{"text":"zikimpa mjinga hekima.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Maagizo ya Mwenyezi Mungu ni kamili,","poem":1},{"text":"nayo hufurahisha moyo.","poem":2},{"text":"Amri za Mwenyezi Mungu huangaza,","poem":1},{"text":"zatia nuru machoni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kumcha Mwenyezi Mungu ni utakatifu,","poem":1},{"text":"nako kwadumu milele.","poem":2},{"text":"Amri za Mwenyezi Mungu ni za hakika,","poem":1},{"text":"nazo zina haki.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ni za thamani kuliko dhahabu,","poem":1},{"text":"kuliko dhahabu iliyo safi sana,","poem":2},{"text":"ni tamu kuliko asali,","poem":1},{"text":"kuliko asali kutoka sega.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa hizo mtumishi wako anaonywa,","poem":1},{"text":"katika kuzishika kuna thawabu kubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ni nani awezaye kutambua makosa yake?","poem":1},{"text":"Nisamehe makosa yangu nisiyoyajua.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mlinde mtumishi wako na dhambi za makusudi,","poem":1},{"text":"nazo zisinitawale.","poem":2},{"text":"Ndipo nitakapokuwa sina lawama,","poem":1},{"text":"niwe huru na hatia kubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Maneno ya kinywa changu","poem":1},{"text":"na mawazo ya moyo wangu,","poem":2},{"text":"yapate kibali mbele zako, Ee Mwenyezi Mungu,","poem":1},{"text":"Mwamba wangu na Mkombozi wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}