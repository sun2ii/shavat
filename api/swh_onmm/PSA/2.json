{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"heading","content":["Mfalme aliyechaguliwa na Mwenyezi Mungu"]},{"type":"verse","number":1,"content":[{"text":"Kwa nini mataifa wanashauriana kufanya mabaya,","poem":1},{"text":"na makabila ya watu kula njama bure?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wafalme wa dunia wanajipanga","poem":1},{"text":"na watawala wanajikusanya","poem":2},{"text":"dhidi ya Mwenyezi Mungu","poem":1},{"text":"na dhidi ya Mpakwa Mafuta wake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wanasema, “Tuvunje minyororo yao","poem":1},{"text":"na kuvitupilia mbali vifungo vyao.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Yeye anayetawala mbinguni hucheka,","poem":1},{"text":"Bwana huwadharau.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kisha huwakemea katika hasira yake","poem":1},{"text":"na kuwaogopesha katika ghadhabu yake, akisema,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“Nimemtawaza Mfalme wangu","poem":1},{"text":"juu ya Sayuni,","poem":2},{"lineBreak":true},{"text":"mlima wangu mtakatifu.”","poem":2}]},{"type":"heading","content":["Ushindi wa mfalme"]},{"type":"verse","number":7,"content":["Nitatangaza amri ya Mwenyezi Mungu:",{"lineBreak":true},{"text":"Yeye aliniambia, “Wewe ni Mwanangu;","poem":1},{"text":"leo mimi nimekuwa Baba yako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niombe, nami nitayafanya mataifa","poem":1},{"text":"kuwa urithi wako,","poem":2},{"lineBreak":true},{"text":"na miisho ya dunia kuwa milki yako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Utawapondaponda kwa fimbo ya chuma,","poem":1},{"text":"na kuwavunjavunja kama chombo cha mfinyanzi.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kwa hiyo, ninyi wafalme, kuweni na hekima;","poem":1},{"text":"mwonyeke, enyi watawala wa dunia.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mtumikieni Mwenyezi Mungu kwa hofu","poem":1},{"text":"na mshangilie kwa kutetemeka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mbusu Mwana, asije akakasirika","poem":1},{"text":"nawe ukaangamizwa katika njia yako,","poem":2},{"text":"kwa maana hasira yake inaweza kuwaka ghafula.","poem":1},{"text":"Heri wote wanaomkimbilia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}