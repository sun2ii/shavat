{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"heading","content":["Maombi kwa ajili ya ushindi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mwenyezi Mungu na akujibu unapokuwa katika dhiki,","poem":1},{"text":"jina la Mungu wa Yakobo na liwe kinga yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Na akutumie msaada kutoka patakatifu","poem":1},{"text":"na akupatie msaada kutoka Sayuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Na azikumbuke dhabihu zako zote,","poem":1},{"text":"na azikubali sadaka zako za kuteketezwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na akujalie haja ya moyo wako,","poem":1},{"text":"na aifanikishe mipango yako yote.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tutashangilia kwa furaha utakaposhinda,","poem":1},{"text":"tutainua bendera zetu kwa jina la Mungu wetu.","poem":2},{"text":"Mwenyezi Mungu na akupe haja zako zote.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Sasa nafahamu kuwa Mwenyezi Mungu","poem":1},{"text":"humwokoa mpakwa mafuta wake,","poem":2},{"text":"humjibu kutoka mbingu yake takatifu","poem":1},{"text":"kwa nguvu za wokovu wa mkono wake wa kuume.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wengine wanatumaini magari ya vita, na wengine farasi,","poem":1},{"text":"bali sisi tutalitumainia jina la Mwenyezi Mungu, Mungu wetu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wao wameshushwa chini na kuanguka,","poem":1},{"text":"bali sisi tunainuka na kusimama imara.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mwenyezi Mungu, mwokoe mfalme!","poem":1},{"text":"Tujibu tunapokuita!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}