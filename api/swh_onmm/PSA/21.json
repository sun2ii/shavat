{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"heading","content":["Shukrani kwa Mwenyezi Mungu kwa ajili ya ushindi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, mfalme huzifurahia nguvu zako.","poem":1},{"text":"Tazama jinsi furaha yake ilivyo kuu","poem":2},{"lineBreak":true},{"text":"kwa ushindi unaompa!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Umempa haja ya moyo wake","poem":1},{"text":"na hukumzuilia maombi ya midomo yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ulimkaribisha kwa baraka tele","poem":1},{"text":"na kumvika taji la dhahabu safi kichwani pake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alikuomba maisha, nawe ukampa,","poem":1},{"text":"wingi wa siku milele na milele.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kutokana na ushindi uliompa, utukufu wake ni mkubwa,","poem":1},{"text":"umeweka juu yake fahari na utukufu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hakika umempa baraka za milele,","poem":1},{"text":"umemfanya awe na furaha","poem":2},{"lineBreak":true},{"text":"kwa shangwe ya uwepo wako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa kuwa mfalme anamtumaini Mwenyezi Mungu;","poem":1},{"text":"kwa upendo usiokoma wa Aliye Juu Sana hatatikiswa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mkono wako utawashika adui zako wote,","poem":1},{"text":"mkono wako wa kuume utawakamata adui zako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wakati utajitokeza,","poem":1},{"text":"utawafanya kama tanuru la moto.","poem":2},{"text":"Katika ghadhabu yake Mwenyezi Mungu atawameza,","poem":1},{"text":"moto wake utawateketeza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Utawaangamiza wazao wao kutoka duniani,","poem":1},{"text":"uzao wao kutoka wanadamu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ingawa watapanga mabaya dhidi yako","poem":1},{"text":"na kutunga hila, hawawezi kufanikiwa,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"kwa kuwa utawafanya wakimbie","poem":1},{"text":"utakapowalenga usoni pao","poem":2},{"lineBreak":true},{"text":"kwa mshale kutoka upinde wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mwenyezi Mungu, utukuzwe katika nguvu zako,","poem":1},{"text":"tutaimba na kusifu nguvu zako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}