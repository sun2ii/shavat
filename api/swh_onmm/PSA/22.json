{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"heading","content":["Kilio cha uchungu na wimbo wa sifa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa utenzi wa “Kulungu wa Alfajiri”. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mungu wangu, Mungu wangu, mbona umeniacha?","poem":1},{"text":"Kwa nini uko mbali hivyo kuniokoa?","poem":2},{"lineBreak":true},{"text":"Mbali hivyo na maneno ya kuugua kwangu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Mungu wangu, ninalia mchana, lakini hunijibu,","poem":1},{"text":"hata usiku, sinyamazi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hata hivyo umesimikwa kwenye kiti cha enzi,","poem":1},{"text":"Wewe Uliye Mtakatifu;","poem":2},{"lineBreak":true},{"text":"wewe ni sifa ya Israeli.","poem":2},{"noteId":6}]},{"type":"verse","number":4,"content":[{"text":"Kwako wewe baba zetu waliweka tumaini lao,","poem":1},{"text":"walikutumaini nawe ukawaokoa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Walikulilia wewe na ukawaokoa,","poem":1},{"text":"walikutegemea wewe nao hawakuaibika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mimi ni mnyoo wala si mwanadamu,","poem":1},{"text":"wanaume wamenibeza, na watu wamenidharau.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wote wanaoniona wananidhihaki;","poem":1},{"text":"wananivurumishia matusi, wakitikisa vichwa vyao:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wanasema, “Amtegemea Mwenyezi Mungu,","poem":1},{"text":"basi Mwenyezi Mungu na amwokoe.","poem":2},{"text":"Amkomboe basi, kwa maana","poem":1},{"text":"anapendezwa naye.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hata hivyo ulinitoa tumboni,","poem":1},{"text":"ukanifanya nikutegemee,","poem":2},{"text":"hata nilipokuwa ninanyonya","poem":1},{"text":"matiti ya mama yangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nimekabidhiwa kwako tangu kuzaliwa,","poem":1},{"text":"toka tumboni mwa mama yangu","poem":2},{"lineBreak":true},{"text":"umekuwa Mungu wangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Usiwe mbali nami,","poem":1},{"text":"kwa maana shida iko karibu","poem":2},{"lineBreak":true},{"text":"na hakuna wa kunisaidia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mafahali wengi wamenizunguka,","poem":1},{"text":"mafahali wa Bashani wenye nguvu","poem":2},{"lineBreak":true},{"text":"wamenizingira.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Simba wanaonguruma na kurarua mawindo","poem":1},{"text":"wanapanua vinywa vyao dhidi yangu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nimemiminwa kama maji,","poem":1},{"text":"mifupa yangu yote imeteguka viungoni.","poem":2},{"text":"Moyo wangu umegeuka kuwa nta,","poem":1},{"text":"umeyeyuka ndani yangu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nguvu zangu zimekauka kama kigae,","poem":1},{"text":"ulimi wangu umegandamana","poem":2},{"lineBreak":true},{"text":"na kaakaa la kinywa changu,","poem":2},{"text":"kwa sababu umenilaza","poem":1},{"text":"katika mavumbi ya kifo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mbwa wamenizunguka,","poem":1},{"text":"kundi la watu waovu limenizingira;","poem":2},{"lineBreak":true},{"text":"wamenidunga mikono na miguu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naweza kuhesabu mifupa yangu yote,","poem":1},{"text":"watu wananikodolea macho na kunisimanga.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Wanagawana nguo zangu,","poem":1},{"text":"na vazi langu wanalipigia kura.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Lakini wewe, Ee Mwenyezi Mungu,","poem":1},{"text":"usiwe mbali.","poem":2},{"text":"Ee Nguvu yangu,","poem":1},{"text":"uje haraka unisaidie.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Okoa maisha yangu na upanga,","poem":1},{"text":"uhai wangu wa thamani kutoka nguvu za mbwa.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Niokoe kutoka kinywani mwa simba,","poem":1},{"text":"niokoe kutoka pembe za nyati.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Nitalitangaza jina lako kwa ndugu zangu,","poem":1},{"text":"katika kusanyiko nitakusifu wewe.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Ninyi ambao mnamcha Mwenyezi Mungu, msifuni!","poem":1},{"text":"Ninyi nyote wazao wa Yakobo, mheshimuni yeye!","poem":2},{"lineBreak":true},{"text":"Mcheni yeye, ninyi wazao wa Israeli!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kwa maana hakupuuza wala kudharau","poem":1},{"text":"mateso ya aliyeteswa;","poem":2},{"text":"hakumficha uso wake","poem":1},{"text":"bali alisikiliza kilio chake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Kwako wewe hutoka kiini cha sifa zangu katika kusanyiko kubwa,","poem":1},{"text":"nitatimiza nadhiri zangu mbele ya wale wanaokucha wewe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Maskini watakula na kushiba,","poem":1},{"text":"wale wanaomtafuta Mwenyezi Mungu watamsifu:","poem":2},{"lineBreak":true},{"text":"mioyo yenu na iishi milele!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Miisho yote ya dunia itakumbuka","poem":1},{"text":"na kumgeukia Mwenyezi Mungu,","poem":2},{"text":"nazo jamaa zote za mataifa","poem":1},{"text":"zitasujudu mbele zake,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"kwa maana ufalme ni wa Mwenyezi Mungu","poem":1},{"text":"naye huyatawala mataifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"Matajiri wote wa dunia watasherehekea na kuabudu.","poem":1},{"text":"Wote wanaoshuka mavumbini","poem":2},{"lineBreak":true},{"text":"watapiga magoti mbele yake,","poem":2},{"text":"wote ambao hawawezi","poem":1},{"text":"kudumisha uhai wao.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Wazao wa baadaye watamtumikia yeye;","poem":1},{"text":"vizazi vijavyo vitajulishwa habari za Bwana.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Watatangaza haki yake kwa watu","poem":1},{"text":"ambao hawajazaliwa bado,","poem":2},{"lineBreak":true},{"text":"kwa maana yeye ametenda hili.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"Tafsiri zingine zinasema uketiye juu ya sifa za Israeli.","reference":{"chapter":22,"verse":3}}]},"thisChapterLink":"/api/swh_onmm/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}