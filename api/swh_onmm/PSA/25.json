{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"heading","content":["Kumwomba Mwenyezi Mungu uongozi na ulinzi"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Kwako wewe, Ee Mwenyezi Mungu,","poem":1},{"text":"naweka tumaini yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ni wewe ninayekutumainia,","poem":1},{"text":"Usiniache niaibike,","poem":2},{"lineBreak":true},{"text":"wala adui zangu wanishinde.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kamwe hakuna hata mmoja anayekutegemea","poem":1},{"text":"atakayeaibishwa,","poem":2},{"text":"bali wataaibishwa","poem":1},{"text":"wafanyao hila bila sababu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nioneshe njia zako, Ee Mwenyezi Mungu,","poem":1},{"text":"nifundishe mapito yako,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"niongoze katika kweli yako na kunifundisha,","poem":1},{"text":"kwa maana wewe ni Mungu Mwokozi wangu,","poem":2},{"lineBreak":true},{"text":"nalo tumaini langu liko kwako wakati wote.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kumbuka, Ee Mwenyezi Mungu, rehema zako kuu na upendo,","poem":1},{"text":"kwa maana zimekuwepo tangu zamani.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Usizikumbuke dhambi za ujana wangu","poem":1},{"text":"wala njia zangu za uasi,","poem":2},{"text":"sawasawa na upendo wako unikumbuke,","poem":1},{"text":"kwa maana wewe ni mwema, Ee Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu ni mwema na mwenye adili,","poem":1},{"text":"kwa hiyo huwafundisha wenye dhambi njia zake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Huwaongoza wanyenyekevu katika haki,","poem":1},{"text":"naye huwafundisha njia yake.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Njia zote za Mwenyezi Mungu ni za upendo na uaminifu","poem":1},{"text":"kwa wale wanaoshika shuhuda za agano lake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ee Mwenyezi Mungu, kwa ajili ya jina lako,","poem":1},{"text":"unisamehe uovu wangu, ijapokuwa ni mwingi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ni nani basi, mtu yule anayemcha Mwenyezi Mungu?","poem":1},{"text":"Atamfundisha katika njia","poem":2},{"lineBreak":true},{"text":"atakayoichagua kwa ajili yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mtu huyo atafanikiwa maishani mwake,","poem":1},{"text":"nao wazao wake watairithi nchi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Siri ya Mwenyezi Mungu iko kwa wale wamchao,","poem":1},{"text":"yeye huwajulisha agano lake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Macho yangu humwelekea Mwenyezi Mungu daima,","poem":1},{"text":"kwa kuwa yeye peke yake ndiye ataitoa","poem":2},{"lineBreak":true},{"text":"miguu yangu kutoka mtego.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Nigeukie na unihurumie,","poem":1},{"text":"kwa maana mimi ni mpweke na mwenye kuteseka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Shida za moyo wangu zimeongezeka,","poem":1},{"text":"niokoe katika dhiki yangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Uangalie mateso na shida zangu","poem":1},{"text":"na uniondolee dhambi zangu zote.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tazama adui zangu walivyo wengi,","poem":1},{"text":"pia uone jinsi wanavyonichukia vikali!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Uyalinde maisha yangu na uniokoe,","poem":1},{"text":"usiniache niaibike,","poem":2},{"lineBreak":true},{"text":"kwa maana nimekukimbilia wewe.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Uadilifu na uaminifu vinilinde,","poem":1},{"text":"kwa sababu tumaini langu ni kwako, Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Ee Mungu, wakomboe Israeli,","poem":1},{"text":"katika shida zao zote!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}