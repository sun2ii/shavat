{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"heading","content":["Sala ya kusifu"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Mwenyezi Mungu ni nuru yangu na wokovu wangu,","poem":1},{"text":"nimwogope nani?","poem":2},{"text":"Mwenyezi Mungu ni ngome ya uzima wangu,","poem":1},{"text":"nimhofu nani?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Waovu watakaposogea dhidi yangu","poem":1},{"text":"ili wale nyama yangu,","poem":2},{"text":"adui zangu na watesi wangu watakaponishambulia,","poem":1},{"text":"watajikwaa na kuanguka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hata jeshi linizingire pande zote,","poem":1},{"text":"moyo wangu hautaogopa;","poem":2},{"text":"hata vita vitokee dhidi yangu,","poem":1},{"text":"hata hapo nitakuwa na ujasiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Jambo moja ninamwomba Mwenyezi Mungu,","poem":1},{"text":"hili ndilo ninalolitafuta:","poem":2},{"text":"niweze kukaa nyumbani mwa Mwenyezi Mungu","poem":1},{"text":"siku zote za maisha yangu,","poem":2},{"text":"niutazame uzuri wa Mwenyezi Mungu","poem":1},{"text":"na kumtafuta hekaluni mwake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa kuwa siku ya shida,","poem":1},{"text":"atanihifadhi salama katika maskani yake,","poem":2},{"text":"atanificha uvulini mwa hema lake,","poem":1},{"text":"na kuniweka juu kwenye mwamba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kisha kichwa changu kitainuliwa","poem":1},{"text":"juu ya adui zangu wanaonizunguka.","poem":2},{"text":"Katika maskani yake nitatoa dhabihu kwa kelele za shangwe;","poem":1},{"text":"nitamwimbia Mwenyezi Mungu na kumsifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isikie sauti yangu nikuitapo, Ee Mwenyezi Mungu,","poem":1},{"text":"unihurumie na unijibu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Moyo wangu unasema kuhusu wewe,","poem":1},{"text":"“Utafute uso wake!”","poem":2},{"lineBreak":true},{"text":"Uso wako, Mwenyezi Mungu “Nitautafuta.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Usinifiche uso wako,","poem":1},{"text":"usimkatae mtumishi wako kwa hasira;","poem":2},{"lineBreak":true},{"text":"wewe umekuwa msaada wangu.","poem":2},{"text":"Usinikatae wala usiniache,","poem":1},{"text":"Ee Mungu Mwokozi wangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hata baba yangu na mama yangu wakiniacha,","poem":1},{"text":"Mwenyezi Mungu atanipokea.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nifundishe njia yako, Ee Mwenyezi Mungu,","poem":1},{"text":"niongoze katika njia iliyo nyoofu,","poem":2},{"lineBreak":true},{"text":"kwa sababu ya watesi wangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Usiniachilie kwa nia za adui zangu,","poem":1},{"text":"kwa maana mashahidi wa uongo","poem":2},{"lineBreak":true},{"text":"wameinuka dhidi yangu,","poem":2},{"lineBreak":true},{"text":"wakipumua ujeuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nami bado nina tumaini hili:","poem":1},{"text":"nitauona wema wa Mwenyezi Mungu","poem":2},{"lineBreak":true},{"text":"katika nchi ya walio hai.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mngojee Mwenyezi Mungu;","poem":1},{"text":"uwe hodari na mwenye moyo mkuu,","poem":2},{"lineBreak":true},{"text":"na umngojee Mwenyezi Mungu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}