{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":28,"content":[{"type":"heading","content":["Kuomba msaada"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ninakuita wewe, Ee Mwenyezi Mungu, Mwamba wangu;","poem":1},{"text":"usikatae kunisikiliza.","poem":2},{"text":"Kwa sababu ukinyamaza","poem":1},{"text":"nitafanana na walioshuka shimoni.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sikia kilio changu nikikuomba unihurumie,","poem":1},{"text":"ninapokuita ili unisaidie,","poem":2},{"text":"ninapoinua mikono yangu kuelekea","poem":1},{"text":"Patakatifu pa Patakatifu pako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Usiniburute pamoja na waovu,","poem":1},{"text":"pamoja na hao watendao mabaya,","poem":2},{"text":"ambao huzungumza na majirani zao maneno mazuri,","poem":1},{"text":"lakini mioyoni mwao wameficha chuki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Walipe sawasawa na matendo yao,","poem":1},{"text":"sawasawa na matendo yao maovu;","poem":2},{"text":"walipe sawasawa na kazi za mikono yao,","poem":1},{"text":"uwalipe wanavyostahili.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa kuwa hawaheshimu kazi za Mwenyezi Mungu,","poem":1},{"text":"na yale ambayo mikono yake imetenda,","poem":2},{"text":"atawabomoa na kamwe","poem":1},{"text":"hatawajenga tena.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ahimidiwe Mwenyezi Mungu,","poem":1},{"text":"kwa maana amesikia kilio changu","poem":2},{"lineBreak":true},{"text":"nikimwomba anihurumie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mwenyezi Mungu ni nguvu zangu na ngao yangu,","poem":1},{"text":"moyo wangu umemtumaini yeye,","poem":2},{"lineBreak":true},{"text":"nami nimesaidiwa.","poem":2},{"text":"Moyo wangu unarukaruka kwa furaha","poem":1},{"text":"nami nitamshukuru kwa wimbo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu ni nguvu ya watu wake,","poem":1},{"text":"ngome ya wokovu kwa mpakwa mafuta wake.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Waokoe watu wako na uubariki urithi wako;","poem":1},{"text":"uwe mchungaji wao na uwabebe milele.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}