{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":3,"content":[{"type":"heading","content":["Sala ya asubuhi ya kuomba msaada"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi. Alipomkimbia mwanawe Absalomu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, tazama adui zangu walivyo wengi!","poem":1},{"text":"Ni wengi kiasi gani wanaoinuka dhidi yangu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wengi wanasema juu yangu,","poem":1},{"text":"“Mungu hatamwokoa.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Lakini wewe, Ee Mwenyezi Mungu, ni ngao yangu pande zote;","poem":1},{"text":"umeniwekea utukufu na kuinua kichwa changu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ninamlilia Mwenyezi Mungu kwa sauti kuu,","poem":1},{"text":"naye ananijibu kutoka mlima wake mtakatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ninajilaza na kupata usingizi;","poem":1},{"text":"naamka tena, kwa maana Mwenyezi Mungu hunitegemeza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Sitaogopa makumi elfu ya adui,","poem":1},{"text":"wanaojipanga dhidi yangu kila upande.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mwenyezi Mungu, amka!","poem":1},{"text":"Niokoe, Ee Mungu wangu!","poem":2},{"text":"Wapige adui zangu wote kwenye taya,","poem":1},{"text":"vunja meno ya waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwa maana wokovu watoka kwa Mwenyezi Mungu.","poem":1},{"lineBreak":true},{"text":"Baraka yako na iwe juu ya watu wako.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}