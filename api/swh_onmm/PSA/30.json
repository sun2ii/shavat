{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"heading","content":["Maombi ya shukrani"]},{"type":"hebrew_subtitle","content":["Utenzi wa kuweka wakfu hekalu. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nitakutukuza wewe, Ee Mwenyezi Mungu,","poem":1},{"text":"kwa kuwa umeniinua kutoka vilindi,","poem":2},{"text":"na hukuacha adui zangu","poem":1},{"text":"washangilie juu yangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wangu, nilikuita unisaidie","poem":1},{"text":"na wewe umeniponya.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee Mwenyezi Mungu, umenitoa Kuzimu","poem":1},{"noteId":8},{"text":",","poem":1},{"text":"umeniokoa nisishuke kwenye shimo la mauti.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwimbieni Mwenyezi Mungu, enyi watakatifu wake;","poem":1},{"text":"lisifuni jina lake takatifu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa maana hasira yake ni ya muda mfupi,","poem":1},{"text":"bali upendo wake hudumu siku zote.","poem":2},{"text":"Inawezekana kilio kiwepo usiku kucha,","poem":1},{"text":"lakini furaha huja asubuhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nilipofanikiwa nilisema,","poem":1},{"text":"“Sitatikiswa kamwe.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ee Mwenyezi Mungu, uliponijalia,","poem":1},{"text":"uliuimarisha mlima wangu,","poem":2},{"text":"lakini ulipouficha uso wako","poem":1},{"text":"nilifadhaika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kwako wewe, Ee Mwenyezi Mungu, niliita,","poem":1},{"text":"niliomba rehema kwa Bwana:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Kuna faida gani katika kuangamia kwangu,","poem":1},{"text":"katika kushuka kwangu shimoni?","poem":2},{"text":"Je, mavumbi yatakusifu?","poem":1},{"text":"Je, yatatangaza uaminifu wako?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Mwenyezi Mungu, unisikie na kunihurumia;","poem":1},{"text":"Ee Mwenyezi Mungu, uwe msaada wangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Uligeuza maombolezo yangu kuwa kucheza,","poem":1},{"text":"ulinivua gunia ukanivika shangwe,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ili moyo wangu uweze kukusifu na usikae kimya.","poem":1},{"text":"Ee Mwenyezi Mungu, Mungu wangu, nitakushukuru milele.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":30,"verse":3}}]},"thisChapterLink":"/api/swh_onmm/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}