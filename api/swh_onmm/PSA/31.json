{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"heading","content":["Maombi na sifa kwa kuokolewa kutoka kwa adui"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, nimekukimbilia wewe,","poem":1},{"text":"usiache nikaaibika kamwe,","poem":2},{"lineBreak":true},{"text":"kwa haki yako uniokoe.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitegee sikio lako,","poem":1},{"text":"uje uniokoe haraka;","poem":2},{"text":"uwe kwangu mwamba wa kimbilio,","poem":1},{"text":"ngome imara ya kuniokoa.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa wewe ni mwamba wangu na ngome yangu,","poem":1},{"text":"uniongoze na kunilinda kwa ajili ya jina lako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Uniepushe na mtego niliotegewa,","poem":1},{"text":"maana wewe ndiwe kimbilio langu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ninaikabidhi roho yangu mikononi mwako,","poem":1},{"text":"unikomboe Ee Mwenyezi Mungu, uliye Mungu wa kweli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ninawachukia wale wanaoshikilia sanamu batili;","poem":1},{"text":"bali mimi ninamtumaini Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nitafurahia na kushangilia upendo wako,","poem":1},{"text":"kwa kuwa uliona mateso yangu","poem":2},{"lineBreak":true},{"text":"na ulijua maumivu ya nafsi yangu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hukunikabidhi kwa adui yangu","poem":1},{"text":"bali umeiweka miguu yangu mahali penye nafasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mwenyezi Mungu unihurumie, kwa kuwa niko kwenye shida;","poem":1},{"text":"macho yangu yanafifia kwa huzuni,","poem":2},{"lineBreak":true},{"text":"nafsi yangu na mwili wangu kwa sikitiko.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Maisha yangu yamedhoofika kwa majonzi,","poem":1},{"text":"naam, miaka yangu kwa kulia kwa maumivu makali;","poem":2},{"text":"nguvu zangu zinaisha kwa ajili ya mateso,","poem":1},{"text":"na mifupa yangu inachakaa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa sababu ya adui zangu wote,","poem":1},{"text":"nimedharauliwa kabisa na majirani zangu,","poem":2},{"text":"hata kwa rafiki zangu nimekuwa tisho,","poem":1},{"text":"wale wanaoniona barabarani wananikimbia.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nimesahaulika miongoni mwao kama mtu aliyekufa,","poem":1},{"text":"nimekuwa kama chombo cha mfinyanzi kilichovunjika.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa maana nimesikia maneno niliyosingiziwa na wengi;","poem":1},{"text":"vitisho viko pande zote;","poem":2},{"text":"kwa kuwa wamefanya mashauri dhidi yangu,","poem":1},{"text":"na kula njama kuniua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Lakini mimi ninakutumaini wewe peke yako, Ee Mwenyezi Mungu;","poem":1},{"text":"nimesema, “Wewe ndiwe Mungu wangu.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Siku za maisha yangu ziko mikononi mwako,","poem":1},{"text":"uniokoe mikononi mwa adui zangu","poem":2},{"lineBreak":true},{"text":"na wale wanifuatiao.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwangazie mtumishi wako uso wako,","poem":1},{"text":"uniokoe kwa ajili ya upendo wako usiokoma.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Usiniache niaibike, Ee Mwenyezi Mungu,","poem":1},{"text":"kwa maana nimekulilia wewe,","poem":2},{"text":"bali waovu waaibishwe","poem":1},{"text":"na kunyamazishwa Kuzimu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Midomo yao isemayo uongo na inyamazishwe,","poem":1},{"text":"kwa maana kwa kiburi na dharau","poem":2},{"text":"wao husema kwa majivuno","poem":1},{"text":"dhidi ya wenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Tazama jinsi wema wako ulivyo mkuu,","poem":1},{"text":"uliowawekea akiba wanaokucha,","poem":2},{"text":"unaowapa wale wanaokukimbilia","poem":1},{"text":"machoni pa watu wote.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unawahifadhi katika uvuli wa uwepo wako","poem":1},{"text":"kutokana na hila za wanadamu;","poem":2},{"text":"katika makao yako huwaweka salama","poem":1},{"text":"kutokana na ndimi za mashtaka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Atukuzwe Mwenyezi Mungu,","poem":1},{"text":"kwa kuwa amenionesha upendo wake wa ajabu","poem":2},{"lineBreak":true},{"text":"nilipokuwa katika mji uliozingirwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Katika hofu yangu nilisema,","poem":1},{"text":"“Nimekatiliwa mbali na macho yako!”","poem":2},{"text":"Hata hivyo ulisikia kilio changu","poem":1},{"text":"ukanihurumia nilipokuita unisaidie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Mpendeni Mwenyezi Mungu ninyi watakatifu wake wote!","poem":1},{"text":"Mwenyezi Mungu huwahifadhi waaminifu,","poem":2},{"lineBreak":true},{"text":"lakini wenye kiburi huwalipiza kikamilifu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kuweni hodari na mjipe moyo,","poem":1},{"text":"ninyi nyote mnaomtumaini Mwenyezi Mungu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}