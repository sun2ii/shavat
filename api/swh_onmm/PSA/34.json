{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"heading","content":["Sifa na wema wa Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi, alipojifanya mwendawazimu mbele ya Abimeleki, ambaye alimfukuza, naye akaondoka."]},{"type":"verse","number":1,"content":[{"text":"Nitamtukuza Mwenyezi Mungu nyakati zote,","poem":1},{"text":"sifa zake zitakuwa mdomoni mwangu siku zote.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nafsi yangu itajisifu katika Mwenyezi Mungu,","poem":1},{"text":"walioonewa watasikia na wafurahi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mtukuzeni Mwenyezi Mungu pamoja nami,","poem":1},{"text":"naam, na tulitukuze jina lake pamoja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nilimtafuta Mwenyezi Mungu naye akanijibu,","poem":1},{"text":"akaniokoa kwenye hofu zangu zote.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wale wamtazamao hutiwa nuru,","poem":1},{"text":"nyuso zao hazifunikwi na aibu kamwe.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Maskini huyu alimwita Mwenyezi Mungu, naye akamsikia,","poem":1},{"text":"akamwokoa katika taabu zake zote.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Malaika wa Mwenyezi Mungu hufanya kituo","poem":1},{"text":"akiwazunguka wale wamchao,","poem":2},{"lineBreak":true},{"text":"naye huwaokoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Onjeni mwone kwamba Mwenyezi Mungu ni mwema;","poem":1},{"text":"heri mtu yule anayemkimbilia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mcheni Mwenyezi Mungu enyi watakatifu wake,","poem":1},{"text":"kwa maana wale wamchao","poem":2},{"lineBreak":true},{"text":"hawapungukiwi na chochote.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wana simba wenye nguvu","poem":1},{"text":"hutindikiwa na kuona njaa,","poem":2},{"text":"bali wale wanaomtafuta Mwenyezi Mungu","poem":1},{"text":"hawatakosa kitu chochote kilicho chema.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Njooni, watoto wangu, mnisikilize,","poem":1},{"text":"nitawafundisha kumcha Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yeyote kati yenu anayependa uzima","poem":1},{"text":"na kutamani kuziona siku nyingi njema,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"basi auzuie ulimi wake na mabaya,","poem":1},{"text":"na midomo yake kutokana na kusema uongo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aache uovu, atende mema,","poem":1},{"text":"aitafute amani na kuifuatilia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Macho ya Mwenyezi Mungu huwaelekea wenye haki,","poem":1},{"text":"na masikio yake yako makini kusikiliza kilio chao.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Uso wa Mwenyezi Mungu uko kinyume na watendao maovu,","poem":1},{"text":"ili kufuta kumbukumbu lao duniani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wenye haki hulia, naye Mwenyezi Mungu huwasikia,","poem":1},{"text":"huwaokoa katika taabu zao zote.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mwenyezi Mungu yu karibu na waliovunjika moyo,","poem":1},{"text":"na huwaokoa waliopondeka roho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Mwenye haki ana mateso mengi,","poem":1},{"text":"lakini Mwenyezi Mungu humwokoa nayo yote,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"huhifadhi mifupa yake yote,","poem":1},{"text":"hata mmoja hautavunjika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Ubaya utamuua mtu mwovu,","poem":1},{"text":"nao adui za mwenye haki watahukumiwa.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mwenyezi Mungu huwakomboa watumishi wake,","poem":1},{"text":"yeyote anayemkimbilia yeye","poem":2},{"lineBreak":true},{"text":"hatahukumiwa kamwe.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}