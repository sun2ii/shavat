{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"heading","content":["Uovu wa mwanadamu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi mtumishi wa Mwenyezi Mungu."]},{"type":"verse","number":1,"content":[{"text":"Kuna neno moyoni mwangu","poem":1},{"text":"kutoka kwa Mungu","poem":2},{"lineBreak":true},{"text":"kuhusu hali ya dhambi ya mwovu.","poem":2},{"text":"Hakuna hofu ya Mungu","poem":1},{"text":"mbele ya macho yake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa kuwa machoni pake mwenyewe hujisifu mno","poem":1},{"text":"hata hawezi kugundua au kuichukia dhambi yake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Maneno ya kinywa chake ni maovu na ya udanganyifu,","poem":1},{"text":"ameacha kuwa mwenye hekima au kutenda mema.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hata kitandani mwake hupanga hila mbaya,","poem":1},{"text":"hujitia katika njia ya dhambi","poem":2},{"lineBreak":true},{"text":"na hakatai lililo baya.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Upendo wako, Ee Mwenyezi Mungu, unafika hadi mbinguni,","poem":1},{"text":"uaminifu wako hadi kwenye anga.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Haki yako ni kama milima mikubwa,","poem":1},{"text":"hukumu zako ni kama kilindi kikuu.","poem":2},{"text":"Ee Mwenyezi Mungu, wewe huwahifadhi","poem":1},{"text":"mwanadamu na mnyama.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Upendo wako usiokoma","poem":1},{"text":"ni wa thamani mno!","poem":2},{"text":"Watu wakuu na wadogo","poem":1},{"text":"hujificha uvulini wa mabawa yako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Wanajifurahisha katika wingi ulio nyumbani mwako,","poem":1},{"text":"nawe utawanywesha katika mto wa furaha zako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kuwa pamoja nawe ni kijito cha uzima,","poem":1},{"text":"katika nuru yako twaona nuru.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dumisha upendo wako kwa wale wanaokujua wewe,","poem":1},{"text":"haki yako kwa wale walio wanyofu wa moyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mguu wa mwenye kiburi usije dhidi yangu,","poem":1},{"text":"wala mkono wa mwovu usinifukuze.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tazama jinsi watenda maovu walivyoanguka:","poem":1},{"text":"wametupwa chini, hawawezi kuinuka!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}