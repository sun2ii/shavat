{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"heading","content":["Mwisho wa mwovu na urithi wa mwenye haki"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Usisumbuke kwa ajili ya watendao maovu,","poem":1},{"text":"wala usiwaonee wivu watendao mabaya,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kwa maana watanyauka upesi kama majani,","poem":1},{"text":"watakufa upesi kama mimea ya kijani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mtumaini Mwenyezi Mungu na utende yaliyo mema.","poem":1},{"text":"Kaa katika nchi ukafurahie malisho salama.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Jifurahishe katika Mwenyezi Mungu","poem":1},{"text":"naye atakupa haja za moyo wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mkabidhi Mwenyezi Mungu njia yako,","poem":1},{"text":"mtumaini yeye, naye atatenda hili:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeye atafanya haki yako ing’ae kama mapambazuko,","poem":1},{"text":"na hukumu ya shauri lako kama jua la adhuhuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tulia mbele za Mwenyezi Mungu","poem":1},{"text":"na umngojee kwa uvumilivu;","poem":2},{"text":"usisumbuke watu wanapofanikiwa katika njia zao,","poem":1},{"text":"wanapotekeleza mipango yao miovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Epuka hasira na uache ghadhabu;","poem":1},{"text":"usihangaike: itakuongoza tu kutenda uovu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kwa maana waovu watakatiliwa mbali,","poem":1},{"text":"bali wale wanaomtumaini Mwenyezi Mungu watairithi nchi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bado kitambo kidogo, nao waovu hawataonekana,","poem":1},{"text":"ingawa utawatafuta, hawataonekana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bali wanyenyekevu watairithi nchi","poem":1},{"text":"na wafurahie amani tele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Waovu hula njama dhidi ya wenye haki","poem":1},{"text":"na kuwasagia meno,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"bali Bwana huwacheka waovu,","poem":1},{"text":"kwa sababu anajua siku yao inakuja.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Waovu hufuta upanga","poem":1},{"text":"na kupinda upinde,","poem":2},{"text":"ili wawaangushe maskini na wahitaji,","poem":1},{"text":"kuwaua wale ambao njia zao ni nyofu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lakini panga zao zitachoma mioyo yao wenyewe,","poem":1},{"text":"na pinde zao zitavunjwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Bora kidogo walicho nacho wenye haki","poem":1},{"text":"kuliko wingi wa mali ya waovu wengi;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kwa maana nguvu za waovu zitavunjwa,","poem":1},{"text":"lakini Mwenyezi Mungu humtegemeza mwenye haki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Mwenyezi Mungu anazifahamu siku za wanyofu,","poem":1},{"text":"na urithi wao utadumu milele.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Siku za maafa hawatanyauka,","poem":1},{"text":"siku za njaa watafurahia wingi wa vitu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Lakini waovu wataangamia:","poem":1},{"text":"Adui za Mwenyezi Mungu watakuwa","poem":2},{"lineBreak":true},{"text":"kama uzuri wa mashamba,","poem":2},{"text":"watatoweka,","poem":1},{"text":"watatoweka kama moshi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Waovu hukopa na hawalipi,","poem":1},{"text":"bali wenye haki hutoa kwa ukarimu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Wale wanaobarikiwa na Mwenyezi Mungu watairithi nchi,","poem":1},{"text":"bali wale anaowalaani watakatiliwa mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Kama Mwenyezi Mungu akipendezwa na njia ya mtu,","poem":1},{"text":"yeye huimarisha hatua zake,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ajapojikwaa, hataanguka,","poem":1},{"text":"kwa maana Mwenyezi Mungu","poem":2},{"lineBreak":true},{"text":"humtegemeza kwa mkono wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Nilikuwa kijana na sasa ni mzee,","poem":1},{"text":"lakini sijaona kamwe wenye haki wameachwa","poem":2},{"lineBreak":true},{"text":"au watoto wao wakiombaomba chakula.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Wakati wote ni wakarimu na hukopesha bila masharti.","poem":1},{"text":"Watoto wao watabarikiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Acha ubaya na utende wema,","poem":1},{"text":"nawe utaishi katika nchi milele.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Kwa kuwa Mwenyezi Mungu huwapenda wenye haki","poem":1},{"text":"naye hatawaacha waaminifu wake.","poem":2},{"lineBreak":true},{"text":"Watalindwa milele,","poem":1},{"text":"lakini uzao wa waovu utakatiliwa mbali.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Wenye haki watairithi nchi,","poem":1},{"text":"na kuishi humo milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"Kinywa cha mwenye haki hutamka hekima,","poem":1},{"text":"nao ulimi wake huzungumza lililo haki.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Torati ya Mungu wake imo moyoni mwake;","poem":1},{"text":"nyayo zake hazitelezi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Watu waovu huvizia wenye haki,","poem":1},{"text":"wakitafuta kuwaua;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"lakini Mwenyezi Mungu hatawaacha mikononi mwao","poem":1},{"text":"wala hatawaacha wahukumiwe","poem":2},{"lineBreak":true},{"text":"kuwa wakosa wanaposhtakiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"Mngojee Mwenyezi Mungu,","poem":1},{"text":"na uishike njia yake.","poem":2},{"text":"Naye atakutukuza uirithi nchi,","poem":1},{"text":"waovu watakapokatiliwa mbali,","poem":2},{"lineBreak":true},{"text":"utaliona hilo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"Nimemwona mtu mwovu na mkatili akistawi","poem":1},{"text":"kama mwerezi wa Lebanoni,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"lakini alitoweka upesi na hakuonekana,","poem":1},{"text":"ingawa nilimtafuta, hakupatikana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"Watafakari watu wasio na hatia,","poem":1},{"text":"wachunguze watu wakamilifu,","poem":2},{"lineBreak":true},{"text":"kuna mafanikio kwa mtu apendaye amani.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Lakini watenda dhambi wote wataangamizwa,","poem":1},{"text":"mafanikio yao yatakatiliwa mbali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"Wokovu wa wenye haki hutoka kwa Mwenyezi Mungu,","poem":1},{"text":"yeye ni ngome yao wakati wa shida.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Mwenyezi Mungu huwasaidia na kuwaokoa,","poem":1},{"text":"huwaokoa kutoka kwa waovu na kuwahifadhi,","poem":2},{"lineBreak":true},{"text":"kwa maana wanamkimbilia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}