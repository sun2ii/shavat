{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"heading","content":["Maombi ya mtu mwenye uchungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa Yeduthuni. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nilisema, “Nitaziangalia njia zangu","poem":1},{"text":"na kuuzuia ulimi wangu usije ukatenda dhambi;","poem":2},{"text":"nitaweka lijamu kinywani mwangu","poem":1},{"text":"wakati wote waovu wanapokuwa karibu nami.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Lakini niliponyamaza na kutulia,","poem":1},{"text":"hata pasipo kusema lolote jema,","poem":2},{"lineBreak":true},{"text":"uchungu wangu uliongezeka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Moyo wangu ulipata moto ndani yangu,","poem":1},{"text":"nilipotafakari, moto uliwaka,","poem":2},{"lineBreak":true},{"text":"ndipo nikasema kwa ulimi wangu:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Ee Mwenyezi Mungu, nijulishe mwisho wa maisha yangu","poem":1},{"text":"na hesabu ya siku zangu;","poem":2},{"text":"nijalie kujua jinsi maisha yangu","poem":1},{"text":"yanavyopita upesi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umefanya maisha yangu mafupi kama nyanda;","poem":1},{"text":"muda wangu wa kuishi ni kama","poem":2},{"lineBreak":true},{"text":"hauna thamani kwako.","poem":2},{"text":"Maisha ya kila mwanadamu","poem":1},{"text":"ni kama pumzi.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hakika kila binadamu ni kama njozi","poem":1},{"text":"aendapo huku na huko:","poem":2},{"text":"hujishughulisha na mengi, lakini ni ubatili;","poem":1},{"text":"anakusanya mali nyingi,","poem":2},{"lineBreak":true},{"text":"wala hajui ni nani atakayejifaidi nayo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Lakini sasa Bwana, nitafute nini?","poem":1},{"text":"Tumaini langu ni kwako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niokoe kutoka makosa yangu yote,","poem":1},{"text":"usinifanye kuwa dhihaka ya wapumbavu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nilinyamaza, sikufumbua kinywa changu,","poem":1},{"text":"kwa sababu wewe ndiwe uliyetenda hili.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Niondolee mjeledi wako,","poem":1},{"text":"nimeshindwa kwa mapigo ya mkono wako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Unakemea na kuadhibu wanadamu","poem":1},{"text":"kwa ajili ya dhambi zao;","poem":2},{"text":"unaharibu utajiri wao kama nondo aharibuvyo:","poem":1},{"text":"kila mwanadamu ni kama pumzi tu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ee Mwenyezi Mungu, usikie maombi yangu,","poem":1},{"text":"usikie kilio changu unisaidie,","poem":2},{"lineBreak":true},{"text":"usiwe kiziwi kwa kulia kwangu.","poem":2},{"text":"Kwani mimi ninaishi na wewe kama mgeni,","poem":1},{"text":"mhamiaji, kama walivyokuwa baba zangu wote,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Tazama mbali nami, ili niweze kufurahi tena","poem":1},{"text":"kabla sijaondoka na nisiwepo tena.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}