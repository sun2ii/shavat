{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"heading","content":["Sala ya jioni ya kuomba msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa ala za nyuzi za muziki. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nijibu nikuitapo,","poem":1},{"text":"Ee Mungu wangu mwenye haki!","poem":2},{"text":"Nipumzishe katika shida zangu;","poem":1},{"text":"nirehemu, usikie ombi langu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Enyi watu, mtabadilisha utukufu wangu","poem":1},{"text":"kuwa aibu hadi lini?","poem":2},{"text":"Mtapenda udanganyifu","poem":1},{"text":"na kufuata miungu ya uongo hadi lini?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Fahamuni hakika kwamba Mwenyezi Mungu amewatenga","poem":1},{"text":"wale wamchao kwa ajili yake;","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu atanisikia nimwitapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Katika hasira yako, usitende dhambi.","poem":1},{"text":"Tulieni kimya mkiwa vitandani mwenu,","poem":2},{"lineBreak":true},{"text":"mkiichunguza mioyo yenu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Toeni dhabihu zilizo haki;","poem":1},{"text":"mtegemeeni Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Wengi wanauliza, “Ni nani awezaye","poem":1},{"text":"kutuonesha jema lolote?”","poem":2},{"lineBreak":true},{"text":"Ee Mwenyezi Mungu, tuangazie nuru ya uso wako.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wewe umejaza moyo wangu kwa furaha kubwa","poem":1},{"text":"kuliko watu waliopata nafaka na divai kwa wingi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nitajilaza chini na kulala kwa amani,","poem":1},{"text":"kwa kuwa wewe peke yako, Ee Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"waniwezesha kukaa kwa salama.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}