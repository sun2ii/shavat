{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"heading","content":["Wimbo wa sifa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nilimngoja Mwenyezi Mungu kwa saburi,","poem":1},{"text":"naye akanijia na kusikia kilio changu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Akanipandisha kutoka shimo la uharibifu,","poem":1},{"text":"kutoka matope na utelezi;","poem":2},{"text":"akaiweka miguu yangu juu ya mwamba","poem":1},{"text":"na kunipa mahali imara pa kusimama.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Akaweka wimbo mpya kinywani mwangu,","poem":1},{"text":"wimbo wa sifa kwa Mungu wetu.","poem":2},{"text":"Wengi wataona na kuogopa","poem":1},{"text":"na kuweka tumaini lao kwa Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Heri mtu yule amfanyaye Mwenyezi Mungu kuwa tumaini lake,","poem":1},{"text":"asiyewategemea wenye kiburi,","poem":2},{"lineBreak":true},{"text":"wale wenye kugeukia miungu ya uongo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wangu,","poem":1},{"text":"umefanya mambo mengi ya ajabu.","poem":2},{"text":"Mambo uliyopanga kwa ajili yetu","poem":1},{"text":"hakuna awezaye kukuhesabia;","poem":2},{"text":"kama ningesema na kuyaelezea,","poem":1},{"text":"yangekuwa mengi mno kuyatangaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dhabihu na sadaka hukuvitaka,","poem":1},{"text":"lakini umefungua masikio yangu","poem":2},{"noteId":10},{"text":";","poem":2},{"text":"sadaka za kuteketezwa na sadaka za dhambi","poem":1},{"text":"hukuzihitaji.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndipo niliposema, “Mimi hapa, nimekuja:","poem":1},{"text":"imeandikwa kunihusu katika kitabu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Mungu wangu,","poem":1},{"text":"natamani kuyafanya mapenzi yako;","poem":2},{"lineBreak":true},{"text":"sheria yako iko ndani ya moyo wangu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nimehubiri haki katika kusanyiko kubwa,","poem":1},{"text":"sikufunga mdomo wangu,","poem":2},{"lineBreak":true},{"text":"Ee Mwenyezi Mungu, kama ujuavyo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Sikuficha haki yako moyoni mwangu;","poem":1},{"text":"ninasema juu ya uaminifu wako na wokovu wako.","poem":2},{"text":"Sikuficha upendo wako na kweli yako","poem":1},{"text":"mbele ya kusanyiko kubwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Mwenyezi Mungu, usinizuilie huruma zako,","poem":1},{"text":"upendo wako na kweli yako daima vinilinde.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa maana taabu zisizohesabika zimenizunguka,","poem":1},{"text":"dhambi zangu zimenikamata, hata nisiweze kuona.","poem":2},{"text":"Zimekuwa nyingi kuliko nywele za kichwa changu,","poem":1},{"text":"nao moyo unazimia ndani yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mwenyezi Mungu, uwe radhi kuniokoa;","poem":1},{"text":"Ee Mwenyezi Mungu, njoo hima unisaidie.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wote wanaotafuta kuniua,","poem":1},{"text":"waaibishwe na kufadhaishwa;","poem":2},{"text":"wote wanaotamani kuangamizwa kwangu,","poem":1},{"text":"wafukuzwe mbali kwa aibu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wale wanaoniambia, “Aha! Aha!”","poem":1},{"text":"wafadhaishwe na iwe aibu yao.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Lakini wote wanaokutafuta","poem":1},{"text":"washangilie na kukufurahia,","poem":2},{"text":"wale wanaoupenda wokovu wako siku zote waseme,","poem":1},{"text":"“Mwenyezi Mungu atukuzwe!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lakini mimi bado ni maskini na mhitaji;","poem":1},{"text":"Bwana na anifikirie.","poem":2},{"text":"Wewe ndiwe msaada wangu na Mwokozi wangu;","poem":1},{"text":"Ee Mungu wangu, usikawie.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"au bali mwili uliniandalia","reference":{"chapter":40,"verse":6}}]},"thisChapterLink":"/api/swh_onmm/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}