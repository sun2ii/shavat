{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"heading","content":["Maombi ya mtu mgonjwa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Heri mtu yule anayemjali mnyonge,","poem":1},{"text":"Mwenyezi Mungu atamwokoa wakati wa shida.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu atamlinda na kuyahifadhi maisha yake,","poem":1},{"text":"atambariki katika nchi","poem":2},{"lineBreak":true},{"text":"na hatamwacha katika tamaa ya adui zake.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwenyezi Mungu atamtegemeza akiwa mgonjwa kitandani,","poem":1},{"text":"na atamwinua kutoka kitandani mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Nilisema, “Ee Mwenyezi Mungu nihurumie,","poem":1},{"text":"niponye, maana nimekutenda dhambi wewe.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Adui zangu wanasema kwa hila,","poem":1},{"text":"“Lini atakufa, na jina lake litokomee kabisa.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kila anapokuja mtu kunitazama,","poem":1},{"text":"huzungumza uongo,","poem":2},{"text":"huku moyo wake ukikusanya masingizio;","poem":1},{"text":"kisha huondoka na kuyasambaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Adui zangu wote hunong’onezana dhidi yangu,","poem":1},{"text":"hao huniwazia mabaya sana, wakisema,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“Ugonjwa mbaya sana umempata,","poem":1},{"text":"kamwe hatainuka tena kitandani mwake.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hata rafiki yangu wa karibu niliyemwamini,","poem":1},{"text":"yule aliyekula chakula changu","poem":2},{"lineBreak":true},{"text":"ameniinulia kisigino chake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Lakini wewe, Ee Mwenyezi Mungu, nihurumie,","poem":1},{"text":"ukaniinue tena, ili niweze kuwalipiza kisasi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Najua kwamba wapendezwa nami,","poem":1},{"text":"kwa kuwa adui yangu hanishindi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Katika uadilifu wangu unanitegemeza","poem":1},{"text":"na kuniweka kwenye uwepo wako milele.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Mtukuzeni Mwenyezi Mungu, Mungu wa Israeli,","poem":1},{"text":"tangu milele na hata milele.","poem":2},"Amen na Amen."]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}