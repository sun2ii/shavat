{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":42,"content":[{"type":"heading","content":["Maombi ya mtu aliye uhamishoni"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Utenzi wa wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Kama ayala anavyoonea shauku vijito vya maji,","poem":1},{"text":"ndivyo nafsi yangu inavyokuonea shauku, Ee Mungu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nafsi yangu inamwonea Mungu kiu, Mungu aliye hai.","poem":1},{"text":"Ni lini nitaweza kwenda kukutana na Mungu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Machozi yangu yamekuwa chakula changu","poem":1},{"text":"usiku na mchana,","poem":2},{"text":"huku watu wakiniambia mchana kutwa,","poem":1},{"text":"“Yuko wapi Mungu wako?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mambo haya nayakumbuka","poem":1},{"text":"ninapoimimina nafsi yangu:","poem":2},{"text":"Jinsi nilivyokuwa nikienda na umati wa watu,","poem":1},{"text":"nikiongoza maandamano kuelekea kwenye nyumba ya Mungu,","poem":2},{"text":"kwa kelele za shangwe na za shukrani","poem":1},{"text":"katikati ya umati wa watu waliosherehekea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee nafsi yangu, kwa nini unasononeka?","poem":1},{"text":"Kwa nini unafadhaika hivyo ndani yangu?","poem":2},{"text":"Weka tumaini lako kwa Mungu,","poem":1},{"text":"kwa kuwa bado nitamsifu,","poem":2},{"lineBreak":true},{"text":"Mwokozi wangu na Mungu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nafsi yangu inasononeka ndani yangu;","poem":1},{"text":"kwa hiyo nitakukumbuka","poem":2},{"text":"kutoka nchi ya Yordani,","poem":1},{"text":"katika vilele vya Hermoni,","poem":2},{"lineBreak":true},{"text":"kutoka Mlima Mizari.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kilindi huita kilindi,","poem":1},{"text":"katika ngurumo za maporomoko ya maji yako;","poem":2},{"text":"mawimbi yako yote pamoja na viwimbi","poem":1},{"text":"vimepita juu yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu huelekeza upendo wake mchana,","poem":1},{"text":"wimbo wake uko nami usiku:","poem":2},{"lineBreak":true},{"text":"maombi kwa Mungu wa uzima wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ninamwambia Mungu Mwamba wangu,","poem":1},{"text":"“Kwa nini umenisahau?","poem":2},{"text":"Kwa nini niendelee kuomboleza,","poem":1},{"text":"nikiteswa na adui?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mifupa yangu inateseka kwa maumivu makali","poem":1},{"text":"adui zangu wanaponidhihaki,","poem":2},{"text":"wakiniambia mchana kutwa,","poem":1},{"text":"“Yuko wapi Mungu wako?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee nafsi yangu, kwa nini unasononeka?","poem":1},{"text":"Kwa nini unafadhaika hivyo ndani yangu?","poem":2},{"text":"Weka tumaini lako kwa Mungu,","poem":1},{"text":"kwa kuwa bado nitamsifu,","poem":2},{"lineBreak":true},{"text":"Mwokozi wangu na Mungu wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}