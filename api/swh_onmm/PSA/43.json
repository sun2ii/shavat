{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"heading","content":["Maombi ya mtu aliye uhamishoni yanaendelea"]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu unihukumu,","poem":1},{"text":"nitetee dhidi ya taifa lisilomcha Mungu,","poem":2},{"lineBreak":true},{"text":"niokoe na watu wadanganyifu na waovu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wewe ni Mungu ngome yangu.","poem":1},{"text":"Kwa nini umenikataa?","poem":2},{"text":"Kwa nini niendelee kuomboleza,","poem":1},{"text":"nikidhulumiwa na adui?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tuma hima nuru yako na kweli yako viniongoze;","poem":1},{"text":"na vinilete hadi mlima wako mtakatifu,","poem":2},{"lineBreak":true},{"text":"mahali unapoishi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ndipo nitaenda madhabahuni pa Mungu,","poem":1},{"text":"kwa Mungu, furaha yangu na shangwe yangu.","poem":2},{"text":"Nitakusifu kwa kinubi,","poem":1},{"text":"Ee Mungu, Mungu wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee nafsi yangu, kwa nini unasononeka?","poem":1},{"text":"Kwa nini unafadhaika hivyo ndani yangu?","poem":2},{"text":"Weka tumaini lako kwa Mungu,","poem":1},{"text":"kwa sababu bado nitamsifu","poem":2},{"lineBreak":true},{"text":"Mwokozi wangu na Mungu wangu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}