{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"heading","content":["Kuomba ulinzi wa Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Utenzi wa wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, tumesikia kwa masikio yetu,","poem":1},{"text":"baba zetu wametueleza","poem":2},{"text":"yale uliyotenda katika siku zao,","poem":1},{"text":"siku za kale.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kwa mkono wako uliwafukuza mataifa","poem":1},{"text":"na ukawapanda baba zetu,","poem":2},{"text":"uliangamiza mataifa","poem":1},{"text":"na kuwastawisha baba zetu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Sio kwa upanga wao waliipata nchi,","poem":1},{"text":"wala si mkono wao uliwapatia ushindi;","poem":2},{"text":"ilikuwa ni kitanga cha mkono wako wa kuume,","poem":1},{"text":"na nuru ya uso wako,","poem":2},{"lineBreak":true},{"text":"kwa kuwa uliwapenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wewe ni mfalme wangu na Mungu wangu,","poem":1},{"text":"unayeamuru ushindi kwa Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa uwezo wako tunawasukuma nyuma watesi wetu;","poem":1},{"text":"kwa jina lako tunawakanyaga adui zetu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Siutumaini upinde wangu,","poem":1},{"text":"upanga wangu hauniletei ushindi;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"bali wewe unatupatia ushindi juu ya adui zetu,","poem":1},{"text":"unawaaibisha watesi wetu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Katika Mungu wetu tunajivuna mchana kutwa,","poem":1},{"text":"nasi tutalisifu jina lako milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Lakini sasa umetukataa na kutudhili,","poem":1},{"text":"wala huendi tena na jeshi letu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Umetufanya tukimbie mbele ya adui,","poem":1},{"text":"nao watesi wetu wametuteka nyara.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Umetuacha tutafunwe kama kondoo","poem":1},{"text":"na umetutawanya katika mataifa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Umewauza watu wako kwa fedha kidogo,","poem":1},{"text":"wala hukupata faida yoyote kwa mauzo yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Umetufanya lawama kwa majirani zetu,","poem":1},{"text":"dharau na dhihaka kwa wale wanaotuzunguka.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Umetufanya kuwa mithali miongoni mwa mataifa;","poem":1},{"text":"mataifa hututikisia vichwa vyao.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Fedheha yangu iko mbele yangu mchana kutwa,","poem":1},{"text":"na uso wangu umejaa aibu tele,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"kwa ajili ya dhihaka ya wale wanaonilaumu na kunitukana,","poem":1},{"text":"kwa sababu ya adui, ambaye anatamani kulipiza kisasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Hayo yote yametutokea,","poem":1},{"text":"ingawa tulikuwa hatujakusahau","poem":2},{"lineBreak":true},{"text":"wala hatujaenda kinyume na agano lako.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mioyo yetu ilikuwa haijarudi nyuma;","poem":1},{"text":"nyayo zetu zilikuwa hazijaiacha njia yako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Lakini ulituponda na kutufanya makao ya mbweha,","poem":1},{"text":"na ukatufunika kwa giza nene.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Kama tungekuwa tumelisahau jina la Mungu wetu","poem":1},{"text":"au kunyooshea mikono yetu kwa mungu mgeni,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"je, si Mungu angegundua hili,","poem":1},{"text":"kwa kuwa anazijua siri za moyo?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hata hivyo kwa ajili yako tunauawa mchana kutwa;","poem":1},{"text":"tumehesabiwa kama kondoo wa kuchinjwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Amka, Ee Bwana! Kwa nini unalala?","poem":1},{"text":"Zinduka! Usitukatae milele.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Kwa nini unauficha uso wako","poem":1},{"text":"na kusahau taabu na mateso yetu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"Tumeshushwa hadi mavumbini,","poem":1},{"text":"miili yetu imegandamana na ardhi.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Inuka na utusaidie,","poem":1},{"text":"utukomboe kwa sababu ya upendo wako usio na mwisho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}