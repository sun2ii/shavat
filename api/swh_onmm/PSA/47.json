{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"heading","content":["Mtawala mwenye enzi yote"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Pigeni makofi, enyi mataifa yote,","poem":1},{"text":"mpigieni Mungu kelele za shangwe!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Jinsi gani alivyo wa kutisha, Mwenyezi Mungu Aliye Juu Sana,","poem":1},{"text":"Mfalme mkuu juu ya dunia yote!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ametiisha mataifa chini yetu,","poem":1},{"text":"watu wengi chini ya miguu yetu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Alituchagulia urithi wetu,","poem":1},{"text":"fahari ya Yakobo, aliyempenda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mungu amepaa kwa kelele za shangwe,","poem":1},{"text":"Mwenyezi Mungu kwa sauti za tarumbeta.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwimbieni Mungu sifa, imbeni sifa,","poem":1},{"text":"mwimbieni sifa Mfalme wetu, imbeni sifa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kwa kuwa Mungu ni mfalme wa dunia yote,","poem":1},{"text":"mwimbieni zaburi za sifa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mungu anayatawala mataifa,","poem":1},{"text":"Mungu ameketi kwenye kiti chake cha enzi kitakatifu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Wakuu wa mataifa wanakusanyika","poem":1},{"text":"kama watu wa Mungu wa Ibrahimu,","poem":2},{"text":"kwa kuwa wafalme wa dunia ni mali ya Mungu;","poem":1},{"text":"yeye ametukuka sana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}