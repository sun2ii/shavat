{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"heading","content":["Sayuni, mji wa Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Wimbo. Zaburi ya wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Mwenyezi Mungu ni mkuu, anayestahili kusifiwa sana,","poem":1},{"text":"katika mji wa Mungu wetu,","poem":2},{"lineBreak":true},{"text":"mlima wake mtakatifu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ni mzuri katika kuinuka juu kwake,","poem":1},{"text":"furaha ya dunia yote.","poem":2},{"text":"Kama vilele vya juu vya Safoni","poem":1},{"noteId":11},{"text":"ni Mlima Sayuni,","poem":1},{"text":"mji wa Mfalme Mkuu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mungu yuko katika ngome zake;","poem":1},{"text":"amejionesha mwenyewe kuwa ngome yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wafalme walipounganisha nguvu,","poem":1},{"text":"waliposonga mbele pamoja,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"walimwona, wakashangaa,","poem":1},{"text":"wakakimbia kwa hofu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kutetemeka kuliwashika huko,","poem":1},{"text":"maumivu kama ya mwanamke","poem":2},{"lineBreak":true},{"text":"mwenye uchungu wa kuzaa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uliwaangamiza kama meli za Tarshishi","poem":1},{"text":"zilizovunjwa na upepo wa mashariki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kama tulivyokuwa tumesikia,","poem":1},{"text":"ndivyo tulivyoona","poem":2},{"text":"katika mji wa Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni,","poem":2},{"text":"katika mji wa Mungu wetu:","poem":1},{"text":"Mungu ataufanya uwe salama milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mungu, hekaluni mwako","poem":1},{"text":"tunatafakari upendo wako usiokoma.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Mungu, kama jina lako lilivyo,","poem":1},{"text":"sifa zako zinafika hadi miisho ya dunia,","poem":2},{"lineBreak":true},{"text":"mkono wako wa kuume umejazwa na haki.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mlima Sayuni unashangilia,","poem":1},{"text":"vijiji vya Yuda vinafurahi","poem":2},{"lineBreak":true},{"text":"kwa sababu ya hukumu zako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Tembeeni katika Sayuni,","poem":1},{"text":"uzungukeni mji,","poem":2},{"lineBreak":true},{"text":"hesabuni minara yake;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"yatafakarini vyema maboma yake,","poem":1},{"text":"angalieni ngome zake,","poem":2},{"text":"ili mpate kusimulia habari zake","poem":1},{"text":"kwa kizazi kijacho.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa kuwa huyu Mungu ni Mungu wetu milele na milele;","poem":1},{"text":"atakuwa kiongozi wetu hata mwisho.","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"au mlima mtakatifu au upande wa kaskazini","reference":{"chapter":48,"verse":2}}]},"thisChapterLink":"/api/swh_onmm/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}