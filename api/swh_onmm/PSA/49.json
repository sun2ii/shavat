{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"heading","content":["Upumbavu wa kutegemea mali"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Sikieni haya, enyi mataifa yote,","poem":1},{"text":"sikilizeni, ninyi wote mnaoishi dunia hii.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wakubwa kwa wadogo,","poem":1},{"text":"matajiri na maskini pamoja:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kinywa changu kitasema maneno ya hekima,","poem":1},{"text":"usemi wa moyo wangu utatoa ufahamu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nitatega sikio langu nisikilize mithali,","poem":1},{"text":"nitafafanua kitendawili kwa zeze:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa nini niogope siku mbaya zinapokuja,","poem":1},{"text":"wakati wadanganyifu waovu wanaponizunguka,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wale wanaotegemea mali yao","poem":1},{"text":"na kujivunia utajiri wao mwingi?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Hakuna mwanadamu yeyote","poem":1},{"text":"awezaye kuukomboa uhai wa mwingine,","poem":2},{"lineBreak":true},{"text":"au kumpa Mungu fidia kwa ajili yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Fidia ya uhai ni gharama kubwa,","poem":1},{"text":"hakuna malipo yoyote yanayotosha,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ili aishi milele","poem":1},{"text":"na asione uharibifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Wote wanaona kwamba watu wenye hekima hufa;","poem":1},{"text":"wajinga na wapumbavu vivyo hivyo huangamia","poem":2},{"lineBreak":true},{"text":"na kuwaachia wengine mali yao.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Makaburi yao yatabaki kuwa nyumba zao za milele,","poem":1},{"text":"makao yao vizazi vyote;","poem":2},{"text":"ingawa walikuwa na mashamba","poem":1},{"text":"na kuyaita kwa majina yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lakini mwanadamu, licha ya utajiri wake, hadumu;","poem":1},{"text":"anafanana na mnyama aangamiaye.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hii ndiyo hatima ya wale wanaojitumainia wenyewe,","poem":1},{"text":"pia ya wafuasi wao, waliothibitisha misemo yao.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kama kondoo, wamewekewa kwenda kaburini","poem":1},{"noteId":12},{"text":",","poem":1},{"text":"nacho kifo kitawala.","poem":2},{"text":"Wanyofu watawatawala asubuhi,","poem":1},{"text":"maumbile yao yataozea kaburini,","poem":2},{"lineBreak":true},{"text":"mbali na majumba yao makubwa ya fahari.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lakini Mungu atakomboa uhai","poem":1},{"noteId":13},{"text":"wangu dhidi ya kaburi;","poem":1},{"text":"hakika atanichukua kwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Usitishwe mtu anapotajirika,","poem":1},{"text":"fahari ya nyumba yake inapoongezeka,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"kwa maana hatachukua chochote atakapokufa,","poem":1},{"text":"fahari yake haitashuka pamoja naye.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ingawa alipokuwa akiishi alijihesabu kuwa heri,","poem":1},{"text":"na wanadamu wanakusifu unapofanikiwa,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"atajiunga na kizazi cha baba zake,","poem":1},{"text":"ambao hawataona kamwe nuru ya uzima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Wanadamu wenye utajiri bila ufahamu","poem":1},{"text":"ni kama wanyama wanaoangamia.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"Kaburini hapa ina maana ya Sheol kwa Kiebrania, yaani Kuzimu.","reference":{"chapter":49,"verse":14}},{"noteId":13,"caller":"+","text":"au nafsi","reference":{"chapter":49,"verse":15}}]},"thisChapterLink":"/api/swh_onmm/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}