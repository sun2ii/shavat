{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"heading","content":["Sala kwa ajili ya ulinzi wakati wa hatari"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa filimbi. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, tegea sikio maneno yangu,","poem":1},{"text":"uangalie kupiga kite kwangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sikiliza kilio changu ili unisaidie,","poem":1},{"text":"Mfalme wangu na Mungu wangu,","poem":2},{"lineBreak":true},{"text":"kwa maana kwako ninaomba.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asubuhi, unasikia sauti yangu, Ee Mwenyezi Mungu;","poem":1},{"text":"asubuhi naleta haja zangu mbele zako,","poem":2},{"lineBreak":true},{"text":"na kusubiri kwa matumaini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wewe si Mungu unayefurahia uovu,","poem":1},{"text":"kwako mtu mwovu hataishi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wenye kiburi hawawezi kusimama mbele yako,","poem":1},{"text":"unawachukia wote watendao mabaya.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Unawaangamiza wasemao uongo.","poem":1},{"text":"Mwenyezi Mungu huwachukia","poem":2},{"lineBreak":true},{"text":"wanaomwaga damu na wadanganyifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lakini mimi, kwa rehema zako kuu,","poem":1},{"text":"nitakuja katika nyumba yako,","poem":2},{"text":"kwa unyenyekevu, nitasujudu","poem":1},{"text":"kulielekea Hekalu lako takatifu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Niongoze katika haki yako, Ee Mwenyezi Mungu,","poem":1},{"text":"kwa sababu ya adui zangu,","poem":2},{"lineBreak":true},{"text":"nyoosha njia yako mbele yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Hakuna neno kinywani mwao linaloweza kuaminika,","poem":1},{"text":"mioyo yao imejaa maangamizi.","poem":2},{"text":"Koo lao ni kaburi lililo wazi,","poem":1},{"text":"kwa ndimi zao, wao hunena udanganyifu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Uwatangaze kuwa wenye hatia, Ee Mungu!","poem":1},{"text":"Hila zao ziwe anguko lao wenyewe.","poem":2},{"text":"Wafukuzie mbali kwa sababu ya dhambi zao nyingi,","poem":1},{"text":"kwa kuwa wamekuasi wewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Lakini wote wanaokimbilia kwako na wafurahi,","poem":1},{"text":"waimbe kwa shangwe daima.","poem":2},{"text":"Ueneze ulinzi wako juu yao,","poem":1},{"text":"ili wale wanaolipenda jina lako","poem":2},{"lineBreak":true},{"text":"wapate kukushangilia.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa hakika, Ee Mwenyezi Mungu, unawabariki wenye haki,","poem":1},{"text":"unawazunguka kwa wema wako kama ngao.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}