{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"heading","content":["Ibada ya kweli"]},{"type":"hebrew_subtitle","content":["Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mwenye Nguvu, Mungu, Mwenyezi Mungu,","poem":1},{"text":"asema na kuiita dunia,","poem":2},{"text":"tangu mawio ya jua","poem":1},{"text":"hadi mahali pake liendapo kutua.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kutoka Sayuni, penye uzuri mkamilifu,","poem":1},{"text":"Mungu anaangaza.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mungu wetu anakuja na hatakaa kimya,","poem":1},{"text":"moto uteketezao unamtangulia,","poem":2},{"lineBreak":true},{"text":"akiwa amezungukwa na tufani kali.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anaziita mbingu zilizo juu,","poem":1},{"text":"na nchi, ili aweze kuwahukumu watu wake:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“Nikusanyieni watu wangu waliowekwa wakfu,","poem":1},{"text":"waliofanya agano nami kwa dhabihu.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nazo mbingu zinatangaza haki yake,","poem":1},{"text":"kwa maana Mungu mwenyewe ni hakimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Sikieni, enyi watu wangu, nami nitasema,","poem":1},{"text":"ee Israeli, nami nitashuhudia dhidi yenu:","poem":2},{"lineBreak":true},{"text":"Mimi ndimi Mungu, Mungu wenu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Sikukemei kwa sababu ya dhabihu zako,","poem":1},{"text":"au sadaka zako za kuteketezwa,","poem":2},{"lineBreak":true},{"text":"ambazo daima ziko mbele zangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Sina haja na fahali wa banda lako,","poem":1},{"text":"au mbuzi wa zizi lako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa maana kila mnyama wa msituni ni wangu,","poem":1},{"text":"na pia makundi ya mifugo juu ya vilima elfu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ninamjua kila ndege mlimani,","poem":1},{"text":"nao viumbe wa kondeni ni wangu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kama ningekuwa na njaa, nisingewaambia ninyi,","poem":1},{"text":"kwa maana ulimwengu ni wangu,","poem":2},{"lineBreak":true},{"text":"na vyote vilivyomo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Je, mimi hula nyama ya mafahali","poem":1},{"text":"au kunywa damu ya mbuzi?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Toa sadaka za shukrani kwa Mungu,","poem":1},{"text":"timiza nadhiri zako kwake Yeye Aliye Juu Sana,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"na uniite siku ya taabu;","poem":1},{"text":"nami nitakuokoa, nawe utanitukuza.”","poem":2}]},{"type":"verse","number":16,"content":["Lakini kwake mtu mwovu, Mungu asema:",{"text":"“Una haki gani kunena sheria zangu","poem":1},{"text":"au kuchukua agano langu mdomoni mwako?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Unachukia mafundisho yangu","poem":1},{"text":"na kuyatupilia mbali maneno yangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Unapomwona mwizi, unaungana naye,","poem":1},{"text":"unapiga kura yako pamoja na wazinzi.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Unakitumia kinywa chako kunena maovu,","poem":1},{"text":"na kuuongoza ulimi wako kwa hila.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Unamsengenya ndugu yako bila kukoma,","poem":1},{"text":"na kumsingizia mwana wa mama yako.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mambo haya unayafanya, nami nimekaa kimya,","poem":1},{"text":"ukadhani Mimi ni kama wewe kabisa.","poem":2},{"text":"Lakini nitakukemea","poem":1},{"text":"na kuweka mashtaka mbele yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Yatafakarini haya, ninyi mnaomsahau Mungu,","poem":1},{"text":"ama sivyo nitawararua vipande vipande,","poem":2},{"lineBreak":true},{"text":"wala hapatakuwa na yeyote wa kuwaokoa:","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Atoaye dhabihu za shukrani ananiheshimu mimi,","poem":1},{"text":"naye aiandaa njia yake","poem":2},{"lineBreak":true},{"text":"ili nimwoneshe wokovu wa Mungu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}