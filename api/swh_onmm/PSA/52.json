{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"heading","content":["Hukumu ya Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Utenzi wa Daudi. Baada ya Doegi, Mwedomu kumwendea Sauli na kumjulisha kuwa: “Daudi ameenda nyumbani mwa Ahimeleki.”"]},{"type":"verse","number":1,"content":[{"text":"Ewe jitu, mbona unajivunia ubaya?","poem":1},{"text":"Kwa nini unajivuna mchana kutwa,","poem":2},{"lineBreak":true},{"text":"wewe ambaye ni fedheha mbele za Mungu?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ulimi wako hupanga mashauri mabaya ya maangamizi.","poem":1},{"text":"Ni kama wembe mkali, ninyi mnaofanya hila.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Unapenda mabaya kuliko mema,","poem":1},{"text":"uongo kuliko kusema kweli.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Unapenda kila neno lenye kudhuru,","poem":1},{"text":"ewe ulimi wenye hila!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hakika Mungu atakushusha chini","poem":1},{"text":"kwa maangamizi ya milele:","poem":2},{"text":"atakunyakua na kukuondoa kwa nguvu","poem":1},{"text":"kutoka hema lako,","poem":2},{"lineBreak":true},{"text":"atakung’oa kutoka nchi ya walio hai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wenye haki wataona na kuogopa;","poem":1},{"text":"watamcheka, wakisema,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“Huyu ni yule mtu ambaye","poem":1},{"text":"hakumfanya Mungu kuwa ngome yake,","poem":2},{"text":"bali alitumainia wingi wa utajiri wake,","poem":1},{"text":"na akawa hodari kwa kuwaangamiza wengine!”","poem":2}]},{"type":"heading","content":["Neema ya Mwenyezi Mungu"]},{"type":"verse","number":8,"content":[{"text":"Lakini mimi ni kama mti wa mzeituni","poem":1},{"text":"unaostawi katika nyumba ya Mungu,","poem":2},{"text":"nautegemea upendo wa Mungu usiokoma","poem":1},{"text":"milele na milele.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nitakusifu milele kwa yale uliyoyatenda,","poem":1},{"text":"nitatumaini jina lako, kwa kuwa jina lako ni jema.","poem":2},{"lineBreak":true},{"text":"Nitakusifu mbele ya watakatifu wako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}