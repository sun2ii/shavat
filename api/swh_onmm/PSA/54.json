{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"heading","content":["Kuomba ulinzi wa Mwenyezi Mungu kutokana na adui"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Na ala za nyuzi za uimbaji. Utenzi wa Daudi. Wakati Wazifu walimwendea Sauli na kumjulisha, “Je, Daudi hajifichi miongoni mwetu?”"]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu uniokoe kwa jina lako,","poem":1},{"text":"unifanyie hukumu kwa uwezo wako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Mungu, sikia maombi yangu,","poem":1},{"text":"usikilize maneno ya kinywa changu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wageni wananishambulia,","poem":1},{"text":"watu wakatili wanayatafuta maisha yangu,","poem":2},{"lineBreak":true},{"text":"watu wasiomjali Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Hakika Mungu ni msaada wangu,","poem":1},{"text":"Bwana ndiye anayenitegemeza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mabaya na yawarudie wale wanaonisingizia,","poem":1},{"text":"kwa uaminifu wako uwaangamize.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nitakutolea dhabihu za hiari;","poem":1},{"text":"Ee Mwenyezi Mungu, nitalisifu jina lako","poem":2},{"lineBreak":true},{"text":"kwa kuwa ni vyema.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa maana ameniokoa katika shida zangu zote,","poem":1},{"text":"na macho yangu yamewatazama adui zangu kwa ushindi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}