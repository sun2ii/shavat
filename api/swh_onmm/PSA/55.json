{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"heading","content":["Maombi ya mtu aliyesalitiwa na rafiki"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Na ala za uimbaji. Utenzi wa Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, sikiliza maombi yangu,","poem":1},{"text":"wala usidharau hoja yangu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nisikie na unijibu.","poem":1},{"lineBreak":true},{"text":"Mawazo yangu yananisumbua na nimehangaishwa","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"kwa sauti ya adui,","poem":1},{"text":"kwa kukaziwa macho na waovu,","poem":2},{"text":"kwa sababu wananiletea mateso juu yangu","poem":1},{"text":"na kunitukana kwa hasira zao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Moyo wangu umejaa uchungu,","poem":1},{"text":"hofu za mauti zimenishambulia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Woga na kutetemeka vimenizunguka,","poem":1},{"text":"hofu kuu imenigharikisha.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nilisema, “Laiti ningekuwa na mabawa ya njiwa!","poem":1},{"text":"Ningeruka niende mbali kupumzika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ningetorokea mbali sana","poem":1},{"text":"na kukaa jangwani,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ningeharakisha kwenda mahali pa salama,","poem":1},{"text":"mbali na tufani kali na dhoruba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Bwana, uwatahayarishe waovu","poem":1},{"text":"na uwachanganyishie semi zao,","poem":2},{"lineBreak":true},{"text":"maana nimeona jeuri na ugomvi mjini.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Usiku na mchana wanazunguka juu ya kuta zake,","poem":1},{"text":"uovu na dhuluma vimo ndani yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nguvu za uharibifu zinatenda kazi mjini,","poem":1},{"text":"vitisho na uongo haviondoki mitaani mwake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kama aliyenitukana ni adui yangu, ningevumilia,","poem":1},{"text":"kama mtu mwovu angejiinua dhidi yangu,","poem":2},{"lineBreak":true},{"text":"ningejificha asinione.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kumbe ni wewe, mwenzangu,","poem":1},{"text":"mshiriki na rafiki yangu wa karibu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ambaye awali tulifurahia ushirika mzuri,","poem":1},{"text":"tulipokuwa tukienda na umati hekaluni mwa Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kifo na kiwajie adui zangu ghafula,","poem":1},{"text":"na washuke Kuzimu","poem":2},{"noteId":14},{"text":"wangali hai,","poem":2},{"lineBreak":true},{"text":"kwa maana uovu uko ndani yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Lakini ninamwita Mungu,","poem":1},{"text":"naye Mwenyezi Mungu huniokoa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jioni, asubuhi na adhuhuri","poem":1},{"text":"ninalia kwa huzuni,","poem":2},{"lineBreak":true},{"text":"naye husikia sauti yangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Huniokoa nikawa salama katika vita","poem":1},{"text":"vilivyopangwa dhidi yangu,","poem":2},{"lineBreak":true},{"text":"ingawa watu wengi hunipinga.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mungu anayemiliki milele,","poem":1},{"text":"atawasikia na kuwaadhibu,","poem":2},{"text":"watu ambao hawabadilishi njia zao,","poem":1},{"text":"wala hawana hofu ya Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Mwenzangu hushambulia rafiki zake,","poem":1},{"text":"naye huvunja agano lake.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mazungumzo yake ni laini kama siagi,","poem":1},{"text":"hata hivyo vita vimo moyoni mwake.","poem":2},{"text":"Maneno yake ni mororo kuliko mafuta,","poem":1},{"text":"hata hivyo ni upanga mkali uliofutwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Mtwike Mwenyezi Mungu fadhaa zako,","poem":1},{"text":"naye atakutegemeza,","poem":2},{"lineBreak":true},{"text":"hatamwacha kamwe mwenye haki wake aanguke.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lakini wewe, Ee Mungu,","poem":1},{"text":"utawashusha waovu katika shimo la uharibifu.","poem":2},{"text":"Wenye kiu ya kumwaga damu na wenye hila,","poem":1},{"text":"hawataishi nusu ya siku zao.","poem":2},{"lineBreak":true},{"text":"Lakini mimi ninakutumaini wewe.","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":55,"verse":15}}]},"thisChapterLink":"/api/swh_onmm/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}