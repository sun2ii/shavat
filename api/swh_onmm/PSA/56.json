{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"heading","content":["Kumtumaini Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa “Njiwa mkimya wa mbali”. Utenzi wa Daudi. Baada ya kukamatwa na Wafilisti huko Gathi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu unihurumie, maana watu wananifuatia vikali;","poem":1},{"text":"mchana kutwa wanazidisha mashambulizi yao.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wasingiziaji wangu wananifuatia mchana kutwa,","poem":1},{"text":"wengi wananishambulia kwa kiburi chao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wakati ninaogopa,","poem":1},{"text":"nitakutumaini wewe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Katika Mungu, ambaye neno lake ninalisifu,","poem":1},{"text":"katika Mungu ninatumaini, sitaogopa.","poem":2},{"text":"Mwanadamu mwenye kufa","poem":1},{"text":"atanitenda nini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mchana kutwa wanayageuza maneno yangu,","poem":1},{"text":"siku zote wanapanga njama za kunidhuru.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wananifanyia hila, wanajificha,","poem":1},{"text":"wanatazama hatua zangu,","poem":2},{"lineBreak":true},{"text":"wakiwa na shauku ya kuutoa uhai wangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wasiepuke kwa vyovyote,","poem":1},{"text":"Ee Mungu, katika hasira yako yaangushe mataifa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Andika maombolezo yangu;","poem":1},{"text":"andika machozi yangu katika kitabu chako:","poem":2},{"lineBreak":true},{"text":"je, haya hayapo katika kumbukumbu zako?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndipo adui zangu watarudi nyuma","poem":1},{"text":"ninapoita msaada.","poem":2},{"text":"Kwa hili nitajua kwamba Mungu","poem":1},{"text":"yuko upande wangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Katika Mungu, ambaye neno lake ninalisifu,","poem":1},{"text":"katika Mwenyezi Mungu, ambaye neno lake ninalisifu,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"katika Mungu ninatumaini, sitaogopa.","poem":1},{"text":"Mwanadamu anaweza kunitenda nini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Mungu, nina nadhiri kwako,","poem":1},{"text":"nitakutolea wewe sadaka zangu za shukrani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa kuwa umeniokoa toka kwenye mauti","poem":1},{"text":"na miguu yangu kwenye kujikwaa,","poem":2},{"text":"ili niweze kuenenda mbele za Mungu","poem":1},{"text":"katika nuru ya uzima.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}