{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"heading","content":["Kuomba msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa “Usiharibu”. Utenzi wa Daudi. Baada ya kumponyoka Sauli pangoni."]},{"type":"verse","number":1,"content":[{"text":"Unihurumie, Ee Mungu, unihurumie,","poem":1},{"text":"kwa maana nafsi yangu inakukimbilia.","poem":2},{"text":"Chini ya uvuli wa mabawa yako nitakimbilia","poem":1},{"text":"hadi maafa yapite.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Namlilia Mungu Aliye Juu Sana,","poem":1},{"text":"Mungu anayetimiza makusudi yake kwangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Hutumana msaada kutoka mbinguni na kuniokoa,","poem":1},{"text":"akiwakemea wale wanaonifuatilia vikali;","poem":2},{"lineBreak":true},{"text":"Mungu huutuma upendo wake na uaminifu wake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Niko katikati ya simba;","poem":1},{"text":"nimelala katikati ya wanyama wenye njaa kali,","poem":2},{"lineBreak":true},{"text":"watu ambao meno yao ni mikuki na mishale,","poem":2},{"lineBreak":true},{"text":"ambao ndimi zao ni panga kali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mungu, utukuzwe juu ya mbingu,","poem":1},{"text":"utukufu wako na uenee duniani kote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Waliitegea miguu yangu nyavu,","poem":1},{"text":"nikachoshwa na dhiki.","poem":2},{"text":"Wamechimba shimo katika njia yangu,","poem":1},{"text":"lakini wametumbukia humo wao wenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mungu, moyo wangu ni thabiti,","poem":1},{"text":"moyo wangu ni thabiti;","poem":2},{"lineBreak":true},{"text":"nitaimba na kusifu kwa nyimbo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Amka, nafsi yangu!","poem":1},{"text":"Amka, kinubi na zeze!","poem":2},{"lineBreak":true},{"text":"Nitayaamsha mapambazuko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nitakusifu wewe, Ee Bwana, kati ya mataifa;","poem":1},{"text":"nitaimba habari zako, kati ya jamaa za watu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa maana upendo wako ni mkuu, waenea hadi mbinguni,","poem":1},{"text":"uaminifu wako unazifikia anga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Mungu, utukuzwe juu mbinguni,","poem":1},{"text":"utukufu wako na uwe duniani pote.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}