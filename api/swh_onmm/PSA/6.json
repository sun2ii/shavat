{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"heading","content":["Sala ya kuomba msaada wakati wa taabu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa ala za nyuzi za muziki. Mtindo wa sheminithi.",{"noteId":0},"Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, usinikemee katika hasira yako,","poem":1},{"text":"wala usiniadhibu katika ghadhabu yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unirehemu Mwenyezi Mungu,","poem":1},{"text":"kwa maana nimedhoofika;","poem":2},{"text":"Ee Mwenyezi Mungu, uniponye,","poem":1},{"text":"kwa maana mifupa yangu","poem":2},{"lineBreak":true},{"text":"ina maumivu makali.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nafsi yangu ina uchungu mwingi.","poem":1},{"text":"Hadi lini, Ee Mwenyezi Mungu, hadi lini?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Geuka, Ee Mwenyezi Mungu, unikomboe,","poem":1},{"text":"uniokoe kwa sababu ya fadhili zako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hakuna mtu anayekukumbuka","poem":1},{"text":"akiwa amekufa.","poem":2},{"text":"Ni nani awezaye kukusifu","poem":1},{"text":"akiwa Kuzimu","poem":2},{"noteId":1},{"text":"?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Nimechakaa kwa kulia kwa huzuni;","poem":1},{"text":"usiku kucha natiririsha","poem":2},{"lineBreak":true},{"text":"kitanda changu kwa machozi;","poem":2},{"text":"nimelowesha kiti changu","poem":1},{"text":"kwa machozi yangu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Macho yangu yamedhoofika kwa kuhuzunika,","poem":1},{"text":"yamedhoofika kwa sababu ya adui zangu wote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kaeni mbali nami, ninyi nyote mtendao mabaya,","poem":1},{"text":"kwa maana Mwenyezi Mungu amesikia kulia kwangu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwenyezi Mungu amesikia kilio changu kwa huruma,","poem":1},{"text":"Mwenyezi Mungu amekubali sala yangu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Adui zangu wote wataaibika na kufadhaika,","poem":1},{"text":"watarudi nyuma na waaibishwe kwa ghafula.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"Sheminithi ni mtajo mmojawapo katika lugha ya uimbaji.","reference":{"chapter":6,"verse":0}},{"noteId":1,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":6,"verse":5}}]},"thisChapterLink":"/api/swh_onmm/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}