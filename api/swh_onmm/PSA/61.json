{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"heading","content":["Kuomba ulinzi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa ala za nyuzi za uimbaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, sikia kilio changu,","poem":1},{"text":"usikilize maombi yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kutoka miisho ya dunia ninakuita,","poem":1},{"text":"ninakuita huku moyo wangu unadhoofika;","poem":2},{"text":"uniongoze kwenye mwamba","poem":1},{"text":"ulio juu kuniliko.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa kuwa umekuwa kimbilio langu,","poem":1},{"text":"ngome imara dhidi ya adui.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Natamani kukaa kwenye hema lako milele,","poem":1},{"text":"na kukimbilia chini ya uvuli wa mabawa yako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mungu, kwa kuwa umesikia nadhiri zangu,","poem":1},{"text":"umenipa urithi wa wale wanaoliogopa jina lako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mwongezee mfalme siku za maisha yake,","poem":1},{"text":"miaka yake kwa vizazi vingi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mtawaze mbele za Mungu milele;","poem":1},{"text":"amuru upendo wako na uaminifu wako vimlinde.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ndipo daima nitaliimbia sifa jina lako","poem":1},{"text":"na kuzitimiza nadhiri zangu siku baada ya siku.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}