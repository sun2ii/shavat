{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"heading","content":["Mwenyezi Mungu kimbilio la pekee"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa Yeduthuni. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Nafsi yangu inapata pumziko kwa Mungu peke yake;","poem":1},{"text":"wokovu wangu watoka kwake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yeye peke yake ndiye mwamba wangu na wokovu wangu;","poem":1},{"lineBreak":true},{"text":"yeye ni ngome yangu, sitatikisika kamwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Mtanishambulia hadi lini?","poem":1},{"text":"Je, ninyi nyote mtanitupa chini:","poem":2},{"text":"Mimi niliye kama ukuta ulioinama,","poem":1},{"text":"kama uzio unaotikisika?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Walikusudia kikamilifu kumwangusha","poem":1},{"text":"toka mahali pake pa fahari;","poem":2},{"lineBreak":true},{"text":"wanafurahia uongo.","poem":2},{"text":"Kwa vinywa vyao hubariki,","poem":1},{"text":"lakini ndani ya mioyo yao hulaani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee nafsi yangu, upumzike, kwa Mungu peke yake,","poem":1},{"text":"tumaini langu latoka kwake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Yeye peke yake ndiye mwamba wangu na wokovu wangu;","poem":1},{"text":"ndiye ngome yangu, sitatikisika.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wokovu wangu na heshima yangu viko kwa Mungu,","poem":1},{"text":"ndiye mwamba wangu wenye nguvu","poem":2},{"lineBreak":true},{"text":"na kimbilio langu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enyi watu, mtumainini yeye wakati wote,","poem":1},{"text":"miminieni mioyo yenu kwake,","poem":2},{"lineBreak":true},{"text":"kwa kuwa Mungu ni kimbilio letu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Binadamu wa ngazi ya chini ni pumzi tu,","poem":1},{"text":"nao wa ngazi ya juu ni uongo tu;","poem":2},{"text":"wakipimwa kwenye mizani, si chochote;","poem":1},{"text":"wote kwa pamoja ni pumzi tu.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Usitumainie udhalimu,","poem":1},{"text":"wala ujivune kwa vitu vya wizi;","poem":2},{"text":"ingawa utajiri wako utaongezeka,","poem":1},{"text":"usiuweke moyoni mwako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Jambo moja Mungu amelisema,","poem":1},{"text":"mambo mawili nimeyasikia:","poem":2},{"text":"kwamba, Ee Mungu,","poem":1},{"text":"wewe una nguvu,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"na kwamba, Ee Bwana,","poem":1},{"text":"wewe ni mwenye upendo.","poem":2},{"text":"Hakika utampa kila mtu thawabu","poem":1},{"text":"kwa kadiri ya alivyotenda.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}