{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"heading","content":["Shauku kwa ajili ya uwepo wa Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Zaburi ya Daudi. Alipokuwa katika Jangwa la Yuda."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, wewe ni Mungu wangu,","poem":1},{"text":"nakutafuta kwa moyo wote;","poem":2},{"text":"nafsi yangu inakuonea kiu,","poem":1},{"text":"mwili wangu unakuonea wewe shauku,","poem":2},{"text":"katika nchi kame na iliyochoka,","poem":1},{"text":"mahali pasipo maji.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nimekuona katika mahali patakatifu","poem":1},{"text":"na kuuona uwezo wako na utukufu wako.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa sababu upendo wako ni bora kuliko uhai,","poem":1},{"text":"midomo yangu itakuadhimisha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nitakusifu siku zote za maisha yangu,","poem":1},{"text":"na kwa jina lako nitainua mikono yangu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nafsi yangu itatoshelezwa,","poem":1},{"text":"kama kushiba vyakula vizuri;","poem":2},{"text":"kwa midomo iimbayo","poem":1},{"text":"kinywa changu kitakusifu wewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kitandani mwangu ninakukumbuka wewe;","poem":1},{"text":"ninakuwaza makesha yote ya usiku.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kwa sababu wewe ndiwe msaada wangu,","poem":1},{"text":"chini ya uvuli wa mabawa yako naimba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nafsi yangu inaambatana nawe,","poem":1},{"text":"mkono wako wa kuume hunishika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wale wanaotafuta uhai wangu wataangamizwa;","poem":1},{"text":"wataenda chini kwenye vilindi vya dunia.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Watatolewa wafe kwa upanga,","poem":1},{"text":"nao watakuwa chakula cha mbweha.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bali mfalme atafurahi katika Mungu,","poem":1},{"text":"wale wote waapao kwa jina la Mungu watamsifu,","poem":2},{"lineBreak":true},{"text":"bali vinywa vya waongo vitanyamazishwa.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}