{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"heading","content":["Kuomba ulinzi dhidi ya adui"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, unisikie ninapoeleza lalamiko langu,","poem":1},{"text":"uyahifadhi maisha yangu kutokana na vitisho vya adui.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Unifiche kutokana na njama za waovu,","poem":1},{"text":"kutokana na fitina za kundi la watenda maovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Wananoa ndimi zao kama panga","poem":1},{"text":"na kuelekeza maneno yao kama mishale ya kufisha.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hurusha mishale kutoka mavizio kwa mtu asiye na hatia,","poem":1},{"text":"humrushia ghafula bila woga.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kila mmoja humtia moyo mwenzake","poem":1},{"text":"katika mipango mibaya;","poem":2},{"text":"huzungumza kuhusu kuficha mitego yao,","poem":1},{"text":"nao husema, “Ni nani ataiona?”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Hupanga njama la dhuluma na kusema,","poem":1},{"text":"“Tumebuni mpango mkamilifu!”","poem":2},{"lineBreak":true},{"text":"Hakika nia na moyo wa mwanadamu vina hila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bali Mungu atawapiga kwa mishale,","poem":1},{"text":"nao ghafula wataangushwa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Atageuza ndimi zao wenyewe dhidi yao","poem":1},{"text":"na kuwaleta kwenye maangamizi;","poem":2},{"text":"wote wawaonao watatikisa vichwa vyao","poem":1},{"text":"kwa dharau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wanadamu wote wataogopa,","poem":1},{"text":"watatangaza kazi za Mungu","poem":2},{"lineBreak":true},{"text":"na kutafakari yale aliyoyatenda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wenye haki na wafurahi katika Mwenyezi Mungu,","poem":1},{"text":"na wakimbilie kwake;","poem":2},{"lineBreak":true},{"text":"wanyofu wote wa moyo na wamsifu yeye!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}