{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"heading","content":["Kusifu Mwenyezi Mungu kwa ajili ya wema wake"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Wimbo. Zaburi."]},{"type":"verse","number":1,"content":[{"text":"Mpigieni Mungu kelele za shangwe, dunia yote!","poem":1}]},{"type":"verse","number":2,"content":[{"text":"Imbeni utukufu wa jina lake;","poem":2},{"lineBreak":true},{"text":"mpeni sifa zake kwa utukufu!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwambieni Mungu, “Jinsi gani","poem":1},{"text":"yalivyo ya kutisha matendo yako!","poem":2},{"text":"Uwezo wako ni mkuu mno kiasi kwamba","poem":1},{"text":"adui wanajikunyata mbele zako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Dunia yote yakusujudia,","poem":1},{"text":"wanakuimbia wewe sifa,","poem":2},{"lineBreak":true},{"text":"wanaliimbia sifa jina lako.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Njooni mwone yale Mungu aliyoyatenda,","poem":1},{"text":"mambo ya kutisha aliyoyatenda","poem":2},{"lineBreak":true},{"text":"miongoni mwa wanadamu!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Alifanya bahari kuwa nchi kavu,","poem":1},{"text":"wakapita kati ya maji kwa miguu,","poem":2},{"lineBreak":true},{"text":"njooni, tumshangilie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Yeye hutawala kwa uwezo wake milele,","poem":1},{"text":"macho yake huangalia mataifa yote:","poem":2},{"lineBreak":true},{"text":"waasi wasithubutu kujiinua dhidi yake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Enyi mataifa, msifuni Mungu wetu,","poem":1},{"text":"sauti ya sifa yake isikike,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ameyahifadhi maisha yetu","poem":1},{"text":"na kuizuia miguu yetu kuteleza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Mungu, wewe ulitujaribu,","poem":1},{"text":"ukatusafisha kama fedha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Umetuingiza kwenye nyavu","poem":1},{"text":"na umetubebesha mizigo mizito","poem":2},{"lineBreak":true},{"text":"migongoni mwetu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uliwaruhusu watu watukalie vichwani,","poem":1},{"text":"tulipita kwenye moto na kwenye maji,","poem":2},{"text":"lakini ulituleta kwenye nchi","poem":1},{"text":"iliyojaa utajiri tele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Nitakuja hekaluni mwako na sadaka za kuteketezwa","poem":1},{"text":"na kukutimizia nadhiri zangu:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"nadhiri ambazo midomo yangu iliahidi","poem":1},{"text":"na nilizotamka kwa kinywa changu","poem":2},{"lineBreak":true},{"text":"nilipokuwa katika shida.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Nitakutolea dhabihu za wanyama wanono","poem":1},{"text":"na sadaka za kondoo dume,","poem":2},{"lineBreak":true},{"text":"nitakutolea mafahali na mbuzi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Njooni msikilize ninyi nyote mnaomcha Mungu,","poem":1},{"text":"nami niwaambie aliyonitendea.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nilimlilia kwa kinywa changu,","poem":1},{"text":"sifa zake zilikuwa katika ulimi wangu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kama ningekuwa nimeyaficha maovu moyoni mwangu,","poem":1},{"text":"Bwana asingekuwa amenisikiliza;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"lakini hakika Mungu amenisikiliza","poem":1},{"text":"na amesikia sauti yangu katika maombi.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ahimidiwe Mungu,","poem":1},{"text":"ambaye hakulikataa ombi langu,","poem":2},{"lineBreak":true},{"text":"wala kunizuilia upendo wake!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}