{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"heading","content":["Mataifa wahimizwa kumsifu Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Na ala za nyuzi za muziki. Zaburi. Wimbo."]},{"type":"verse","number":1,"content":[{"text":"Mungu aturehemu na kutubariki,","poem":1},{"text":"na kutuangazia nuru za uso wake,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ili njia zako zijulikane duniani,","poem":1},{"text":"wokovu wako katikati ya mataifa yote.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Mungu, mataifa na wakusifu,","poem":1},{"text":"mataifa yote na wakusifu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mataifa yote wafurahi na kuimba kwa shangwe,","poem":1},{"text":"kwa kuwa unatawala watu kwa haki","poem":2},{"lineBreak":true},{"text":"na kuongoza mataifa ya dunia.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mungu, mataifa na wakusifu,","poem":1},{"text":"mataifa yote na wakusifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ndipo nchi itatoa mazao yake,","poem":1},{"text":"naye Mungu, Mungu wetu, atatubariki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mungu atatubariki","poem":1},{"text":"na miisho yote ya dunia itamcha yeye.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}