{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"heading","content":["Wimbo wa taifa wa shangwe kwa ushindi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi. Wimbo."]},{"type":"verse","number":1,"content":[{"text":"Mungu na ainuke, watesi wake watawanyike,","poem":1},{"text":"adui zake na wakimbie mbele zake.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kama moshi unavyopeperushwa na upepo,","poem":1},{"text":"vivyo hivyo uwapeperushe mbali,","poem":2},{"text":"kama nta inavyoyeyuka kwenye moto,","poem":1},{"text":"vivyo hivyo waovu na waangamie mbele za Mungu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Bali wenye haki na wafurahi,","poem":1},{"text":"washangilie mbele za Mungu,","poem":2},{"lineBreak":true},{"text":"wafurahi na kushangilia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mwimbieni Mungu, liimbieni sifa jina lake,","poem":1},{"text":"mtukuzeni yeye anayepita juu ya mawingu:","poem":2},{"text":"jina lake ni Mwenyezi Mungu,","poem":1},{"text":"furahini mbele zake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Baba wa yatima, mtetezi wa wajane,","poem":1},{"text":"ni Mungu katika makao yake matakatifu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mungu huwaweka wapweke katika jamaa,","poem":1},{"text":"huwaongoza wafungwa wakiimba,","poem":2},{"lineBreak":true},{"text":"bali waasi huishi katika nchi kame.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mungu, ulipowatangulia watu wako,","poem":1},{"text":"ulipopita nyikani,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"dunia ilitikisika,","poem":1},{"text":"mbingu zikanyesha mvua,","poem":2},{"text":"mbele za Mungu, Yule wa Sinai,","poem":1},{"text":"mbele za Mungu, Mungu wa Israeli.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mungu, ulinyesha mvua nyingi","poem":1},{"text":"na kuiburudisha ardhi iliyokuwa imechoka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ee Mungu, watu wako waliishi huko,","poem":1},{"text":"nawe kwa wingi wa utajiri wako","poem":2},{"lineBreak":true},{"text":"uliwapa maskini mahitaji yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Bwana analitoa neno,","poem":1},{"text":"wanawake wanaolitangaza","poem":2},{"lineBreak":true},{"text":"neno hilo ni kundi kubwa:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“Wafalme na majeshi walikimbia upesi,","poem":1},{"text":"wanawake waliobaki nyumbani waligawana nyara.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Hata unapolala kati ya mioto ya kambini,","poem":1},{"text":"mabawa ya njiwa wangu yamefunikwa kwa fedha,","poem":2},{"lineBreak":true},{"text":"manyoya yake kwa dhahabu inayong’aa.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mwenyezi","poem":1},{"noteId":15},{"text":"alipowatawanya wafalme katika nchi,","poem":1},{"text":"ilikuwa kama theluji iliyoanguka juu ya Mlima Salmoni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Milima ya Bashani ni milima iliyotukuka,","poem":1},{"text":"milima ya Bashani ina vilele vilivyochongoka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Enyi milima yenye vilele vilivyochongoka,","poem":1},{"text":"kwa nini mnakazia macho kwa wivu,","poem":2},{"text":"katika mlima Mungu anaochagua kutawala,","poem":1},{"text":"ambako Mwenyezi Mungu mwenyewe ataishi milele?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Magari ya vita ya Mungu ni makumi ya maelfu,","poem":1},{"text":"na maelfu ya maelfu;","poem":2},{"text":"Bwana amekuja kutoka Sinai","poem":1},{"text":"hadi katika patakatifu pake.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ulipopanda juu, uliteka mateka,","poem":1},{"text":"ukapokea vipawa kutoka kwa wanadamu,","poem":2},{"text":"hata kutoka kwa wale walioasi,","poem":1},{"text":"ili wewe, Ee Bwana Mwenyezi Mungu, upate kuishi huko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ahimidiwe Bwana, Mungu Mwokozi wetu,","poem":1},{"text":"ambaye siku kwa siku hutuchukulia mizigo yetu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Mungu wetu ni Mungu anayeokoa,","poem":1},{"text":"Bwana Mungu Mwenyezi hutuokoa na kifo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Hakika Mungu ataponda vichwa vya adui zake,","poem":1},{"text":"vichwa vya hao wanaoenda katika njia za dhambi.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Bwana alisema, “Nitawarudisha kutoka Bashani;","poem":1},{"text":"nitawarudisha kutoka vilindi vya bahari,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ili uweze kuchovya miguu yako katika damu ya adui zako,","poem":1},{"text":"huku ndimi za mbwa wako zikiwa na fungu lake.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"Ee Mungu, maandamano yako yameonekana,","poem":1},{"text":"maandamano ya Mungu wangu, Mfalme wangu,","poem":2},{"lineBreak":true},{"text":"yakielekea patakatifu pake.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mbele wako waimbaji, baada yao wapiga vinanda,","poem":1},{"text":"pamoja nao wako wanawali wakipiga matari.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Msifuni Mungu katika kusanyiko kubwa,","poem":1},{"text":"msifuni Mwenyezi Mungu katika kusanyiko la Israeli.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Liko kabila dogo la Benyamini likiwaongoza,","poem":1},{"text":"wakifuatwa na kundi kubwa la watawala wa Yuda,","poem":2},{"lineBreak":true},{"text":"hatimaye watawala wa Zabuloni na Naftali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"Ee Mungu, amuru uwezo wako,","poem":1},{"text":"Ee Mungu tuoneshe nguvu zako,","poem":2},{"lineBreak":true},{"text":"kama ulivyofanya hapo awali.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Kwa sababu ya Hekalu lako Yerusalemu","poem":1},{"text":"wafalme watakuletea zawadi.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Mkemee mnyama aliye kwenye matete,","poem":1},{"text":"kundi la mafahali kati ya ndama za mataifa.","poem":2},{"text":"Na walete minara ya madini ya fedha wakinyenyekea.","poem":1},{"text":"Tawanya mataifa yapendayo vita.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Wajumbe watakuja kutoka Misri;","poem":1},{"text":"Kushi atajisalimisha kwa Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Mwimbieni Mungu, enyi falme za dunia,","poem":1},{"text":"mwimbieni Bwana sifa,","poem":2}]},{"type":"verse","number":33,"content":[{"text":"mwimbieni sifa yeye apandaye mbingu za kale zilizo juu,","poem":1},{"text":"yeye angurumaye kwa sauti kuu.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Tangazeni uwezo wa Mungu,","poem":1},{"text":"ambaye fahari yake iko juu ya Israeli,","poem":2},{"lineBreak":true},{"text":"ambaye uwezo wake uko katika anga.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Ee Mungu, wewe unatisha katika mahali patakatifu pako,","poem":1},{"text":"Mungu wa Israeli huwapa watu wake uwezo na nguvu.","poem":2},{"lineBreak":true},{"text":"Ahimidiwe Mungu!","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"Mwenyezi hapa ina maana ya Shaddai kwa Kiebrania.","reference":{"chapter":68,"verse":14}}]},"thisChapterLink":"/api/swh_onmm/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}