{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"heading","content":["Sala ya mtu anayedhulumiwa"]},{"type":"hebrew_subtitle","content":["Ombolezo la Daudi kwa Mwenyezi Mungu kwa sababu ya Kushi, Mbenyamini."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wangu, ninakukimbilia wewe,","poem":1},{"text":"uniokoe na kunikomboa na wote wanaonifuatia,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"la sivyo watanirarua kama simba","poem":1},{"text":"na kunichana vipande vipande, asiwepo wa kuniokoa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wangu, kama nimetenda haya","poem":1},{"text":"na kuna hatia mikononi mwangu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"au ikiwa nimemtenda uovu aliye na amani nami,","poem":1},{"text":"au nimemnyang’anya adui yangu pasipo sababu,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"basi adui anifuatie na kunipata,","poem":1},{"text":"auponde uhai wangu ardhini","poem":2},{"lineBreak":true},{"text":"na kunilaza mavumbini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Amka kwa hasira yako, Ee Mwenyezi Mungu,","poem":1},{"text":"inuka dhidi ya ghadhabu ya adui zangu.","poem":2},{"lineBreak":true},{"text":"Amka, Mungu wangu, uamue haki.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kusanyiko la watu na likuzunguke.","poem":1},{"text":"Watawale kutoka juu.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mwenyezi Mungu na awahukumu makabila ya watu.","poem":2},{"text":"Nihukumu Ee Mwenyezi Mungu,","poem":1},{"text":"kwa kadiri ya haki yangu,","poem":2},{"text":"kwa kadiri ya uadilifu wangu,","poem":1},{"text":"Ewe Uliye Juu Sana.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mungu mwenye haki,","poem":1},{"text":"uchunguzaye mawazo na mioyo,","poem":2},{"text":"komesha ghasia za waovu","poem":1},{"text":"na ufanye wenye haki waishi kwa amani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ngao yangu ni Mungu Aliye Juu Sana,","poem":1},{"text":"anayewaokoa wanyofu wa moyo.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mungu ni mwamuzi mwenye haki,","poem":1},{"text":"Mungu anayeghadhibika kila siku.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mtu asipotubu,","poem":1},{"text":"Mungu ataunoa upanga wake,","poem":2},{"lineBreak":true},{"text":"ataupinda na kuufunga uzi upinde wake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ameandaa silaha zake kali,","poem":1},{"text":"ameweka tayari mishale yake ya moto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Yeye aliye na mimba ya uovu","poem":1},{"text":"na anayechukua mimba ya ghasia huzaa uongo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Yeye anayechimba shimo na kulifukua","poem":1},{"text":"hutumbukia katika shimo alilochimba mwenyewe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Ghasia anazozianzisha humrudia mwenyewe,","poem":1},{"text":"ukatili wake humrudia kichwani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Nitamshukuru Mwenyezi Mungu kwa ajili ya haki yake,","poem":1},{"text":"na nitaliimbia sifa jina la Mwenyezi Mungu Aliye Juu Sana.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}