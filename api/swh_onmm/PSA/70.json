{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"heading","content":["Kuomba msaada"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya Daudi. Maombi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, ufanye haraka kuniokoa;","poem":1},{"text":"Ee Mwenyezi Mungu, njoo hima unisaidie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wale wanaotafuta kuniua,","poem":1},{"text":"waaibishwe na kufadhaishwa;","poem":2},{"text":"wote wanaotamani kuangamizwa kwangu,","poem":1},{"text":"warudishwe nyuma kwa aibu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wale wanaoniambia, “Aha! Aha!”","poem":1},{"text":"na warudi nyuma kwa sababu ya aibu yao.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini wote wanaokutafuta","poem":1},{"text":"washangilie na kukufurahia,","poem":2},{"text":"wale wanaoupenda wokovu wako siku zote waseme,","poem":1},{"text":"“Mwenyezi Mungu ni mkuu!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Lakini mimi bado ni maskini na mhitaji;","poem":1},{"text":"Ee Mungu, unijie haraka.","poem":2},{"text":"Wewe ndiwe msaada wangu na mwokozi wangu;","poem":1},{"text":"Ee Mwenyezi Mungu, usikawie.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}