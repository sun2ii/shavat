{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"heading","content":["Maombi kwa ajili ya mfalme"]},{"type":"hebrew_subtitle","content":["Zaburi ya Sulemani."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, mjalie mfalme aamue kwa haki yako,","poem":1},{"text":"mwana wa mfalme kwa haki yako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Atawaamua watu wako kwa haki,","poem":1},{"text":"watu wako walioonewa kwa haki.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Milima italeta mafanikio kwa watu,","poem":1},{"text":"vilima tunda la haki.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atawatetea walioonewa miongoni mwa watu","poem":1},{"text":"na atawaokoa watoto wa wahitaji,","poem":2},{"lineBreak":true},{"text":"ataponda mdhalimu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Atadumu kama jua linavyodumu, kama mwezi, vizazi vyote.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Atakuwa kama mvua inavyonyesha juu ya shamba lililofyekwa,","poem":1},{"text":"kama manyunyu yanavyonyeshea ardhi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katika siku zake wenye haki watastawi;","poem":1},{"text":"mafanikio yatakuwepo hadi mwezi utakapokoma.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Atatawala kutoka bahari hadi bahari","poem":1},{"text":"na kutoka Mto","poem":2},{"noteId":16},{"text":"hadi miisho ya dunia.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Makabila ya jangwani watamsujudia,","poem":1},{"text":"na adui zake wataramba mavumbi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wafalme wa Tarshishi na wa pwani za mbali","poem":1},{"text":"watamletea ushuru;","poem":2},{"text":"wafalme wa Sheba na Seba","poem":1},{"text":"watampa zawadi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wafalme wote watamsujudia","poem":1},{"text":"na mataifa yote yatamtumikia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kwa maana atamwokoa mhitaji anayemlilia,","poem":1},{"text":"aliyeonewa asiye na wa kumsaidia.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Atawahurumia wanyonge na wahitaji","poem":1},{"text":"na kuwaokoa wahitaji kutoka mauti.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Atawaokoa kutoka uonevu na ukatili,","poem":1},{"text":"kwani damu yao ni ya thamani machoni pake.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Aishi maisha marefu!","poem":1},{"text":"Na apewe dhahabu ya Sheba.","poem":2},{"text":"Watu wamwombee daima","poem":1},{"text":"na kumbariki mchana kutwa.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nafaka ijae tele katika nchi yote,","poem":1},{"text":"juu ya vilele vya vilima na istawi.","poem":2},{"text":"Tunda lake na listawi kama Lebanoni,","poem":1},{"text":"listawi kama majani ya kondeni.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jina lake na lidumu milele,","poem":1},{"text":"na lidumu kama jua.","poem":2},{"lineBreak":true},{"text":"Mataifa yote yatabarikiwa kupitia kwake,","poem":1},{"text":"nao watamwita aliyebarikiwa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ahimidiwe Bwana Mwenyezi Mungu, Mungu wa Israeli,","poem":1},{"text":"ambaye peke yake hutenda mambo ya ajabu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Jina lake tukufu lihimidiwe milele,","poem":1},{"text":"ulimwengu wote ujae utukufu wake.","poem":2},"Amen na Amen."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Huu ndio mwisho wa maombi ya Daudi mwana wa Yese.","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"yaani Mto Frati","reference":{"chapter":72,"verse":8}}]},"thisChapterLink":"/api/swh_onmm/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}