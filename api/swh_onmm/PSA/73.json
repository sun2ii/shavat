{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"heading","content":["Haki ya Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Hakika Mungu ni mwema kwa Israeli,","poem":1},{"text":"kwa wale ambao mioyo yao ni safi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bali mimi, miguu yangu ilikuwa karibu kuteleza;","poem":1},{"text":"nilikuwa karibu kuanguka.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa maana niliwaonea wivu wenye kujivuna","poem":1},{"text":"nilipoona kufanikiwa kwa waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wao hawana taabu;","poem":1},{"text":"miili yao ina afya na nguvu","poem":2},{"noteId":17},{"text":".","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hawapati shida zinazowataabisha watu wengine,","poem":1},{"text":"wala hawapati mapigo kama wanadamu wengine.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa hiyo kiburi ni mkufu wao,","poem":1},{"text":"wamejivika jeuri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Uovu hutoka katika mioyo yao iliyokufa ganzi,","poem":1},{"text":"majivuno maovu kutoka mioyoni mwao hayana kikomo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hudhihaki na kusema kwa ukorofi,","poem":1},{"text":"katika majivuno yao wanatishia kutesa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Vinywa vyao huweka madai hata kwa mbingu,","poem":1},{"text":"nazo ndimi zao humiliki duniani.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa hiyo watu wao huwageukia","poem":1},{"text":"na kunywa maji tele","poem":2},{"noteId":18},{"text":".","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wanasema, “Mungu awezaje kujua?","poem":1},{"text":"Je, Yeye Aliye Juu Sana anayo maarifa?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Hivi ndivyo walivyo waovu:","poem":1},{"text":"siku zote hawajali,","poem":2},{"lineBreak":true},{"text":"wanaongezeka katika utajiri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Hakika nimeuweka moyo wangu safi bure,","poem":1},{"text":"ni bure nimenawa mikono yangu nisiwe na hatia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mchana kutwa nimetaabika,","poem":1},{"text":"nimeadhibiwa kila asubuhi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Kama ningesema, “Nitasema hivi,”","poem":1},{"text":"ningekuwa nimewasaliti watoto wako.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nilipojaribu kuelewa haya yote,","poem":1},{"text":"yalikuwa magumu kwangu kuelewa.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Hadi nilipoingia patakatifu pa Mungu,","poem":1},{"text":"ndipo nilitambua mwisho wao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Hakika unawaweka mahali pa utelezi,","poem":1},{"text":"unawaangusha chini kwa uharibifu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Tazama jinsi wanavyoangamizwa ghafula,","poem":1},{"text":"wanatoweshwa kabisa na vitisho!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kama ndoto mtu aamkapo,","poem":1},{"text":"hivyo wakati uinukapo, Ee Bwana,","poem":2},{"lineBreak":true},{"text":"utawatowesha kama ndoto.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Moyo wangu ulipohuzunishwa,","poem":1},{"text":"na roho yangu ilipotiwa uchungu,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"nilikuwa mpumbavu na mjinga,","poem":1},{"text":"nilikuwa mnyama mkatili mbele yako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Hata hivyo niko pamoja nawe siku zote,","poem":1},{"text":"umenishika mkono wangu wa kuume.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Unaniongoza kwa ushauri wako,","poem":1},{"text":"hatimaye utaniingiza katika utukufu.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nani niliye naye mbinguni ila wewe?","poem":1},{"text":"Dunia haina chochote ninachokitamani ila wewe.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mwili na moyo wangu vyaweza kushindwa,","poem":1},{"text":"bali Mungu ni nguvu ya moyo wangu","poem":2},{"lineBreak":true},{"text":"na fungu langu milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"Wale walio mbali nawe wataangamia,","poem":1},{"text":"unawaangamiza wote wasio waaminifu kwako.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Lakini kwangu mimi,","poem":1},{"text":"ni vyema kuwa karibu na Mungu.","poem":2},{"text":"Nimemfanya Bwana Mungu Mwenyezi kimbilio langu;","poem":1},{"text":"nami nitayasimulia matendo yako yote.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"au hawana maumivu katika kufa kwao","reference":{"chapter":73,"verse":4}},{"noteId":18,"caller":"+","text":"au na kupokea yote wasemayo","reference":{"chapter":73,"verse":10}}]},"thisChapterLink":"/api/swh_onmm/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}