{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"heading","content":["Maombi kwa ajili ya taifa"]},{"type":"hebrew_subtitle","content":["Utenzi wa Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, mbona umetukataa milele?","poem":1},{"text":"Mbona hasira yako inatoka moshi","poem":2},{"lineBreak":true},{"text":"juu ya kondoo wa malisho yako?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kumbuka watu uliowanunua zamani,","poem":1},{"text":"kabila la urithi wako, ambao uliwakomboa:","poem":2},{"lineBreak":true},{"text":"Mlima Sayuni, ambamo uliishi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Geuza hatua zako kuelekea magofu haya ya kudumu,","poem":1},{"text":"uharibifu wote huu ambao adui ameuleta pale patakatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Adui zako wamenguruma pale ulipokutana nasi,","poem":1},{"text":"wanaweka bendera zao kama alama.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Walifanya kama watu wanaotumia mashoka","poem":1},{"text":"kukata kichaka cha miti.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Walivunjavunja milango yote iliyonakshiwa","poem":1},{"text":"kwa mashoka na vishoka vyao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waliteketeza kabisa mahali pako patakatifu,","poem":1},{"text":"wakayanajisi makao ya Jina lako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Walisema mioyoni mwao,","poem":1},{"text":"“Tutawaponda kabisa!”","poem":2},{"text":"Walichoma kila mahali Mungu","poem":1},{"text":"alipoabudiwa katika nchi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hatukupewa ishara za miujiza;","poem":1},{"text":"hakuna manabii waliobaki,","poem":2},{"text":"hakuna yeyote kati yetu ajuaye","poem":1},{"text":"hali hii itachukua muda gani.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ee Mungu, mtesi atakudhihaki hadi lini?","poem":1},{"text":"Je, adui watalitukana jina lako milele?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa nini unazuia mkono wako,","poem":1},{"text":"mkono wako wa kuume?","poem":2},{"text":"Uutoe kutoka makunjo ya vazi lako","poem":1},{"text":"na uwaangamize!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Lakini wewe, Ee Mungu, ni mfalme wangu tangu zamani,","poem":1},{"text":"unaleta wokovu duniani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ni wewe uliyeigawanya bahari kwa uweza wako;","poem":1},{"text":"ulivunja vichwa vya mnyama mkubwa wa baharini.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ni wewe uliyeponda vichwa vya Lewiathani","poem":1},{"noteId":19},{"text":",","poem":1},{"text":"nawe ukamtoa kama chakula kwa viumbe vya jangwani.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ni wewe uliyefungua chemchemi na vijito,","poem":1},{"text":"ulikausha mito iliyokuwa ikitiririka daima.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mchana ni wako, na usiku ni wako pia;","poem":1},{"text":"uliziweka jua na mwezi.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ni wewe uliyeiweka mipaka yote ya dunia,","poem":1},{"text":"ulifanya kiangazi na masika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Ee Mwenyezi Mungu, kumbuka jinsi mtesi alivyokudhihaki,","poem":1},{"text":"jinsi watu wapumbavu walivyolitukana jina lako.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Usiukabidhi uhai wa njiwa wako kwa wanyama mwitu;","poem":1},{"text":"usisahau kabisa uhai wa watu wako wanaoteseka milele.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Likumbuke agano lako,","poem":1},{"text":"maana mara kwa mara mambo ya jeuri","poem":2},{"lineBreak":true},{"text":"yamejaa katika sehemu za giza nchini.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Usiruhusu waliodhulumiwa warudi nyuma kwa aibu;","poem":1},{"text":"maskini na wahitaji hebu walisifu jina lako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"Inuka, Ee Mungu, ujitetee;","poem":1},{"text":"kumbuka jinsi wapumbavu","poem":2},{"lineBreak":true},{"text":"wanavyokudhihaki mchana kutwa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Usipuuze makelele ya watesi wako,","poem":1},{"text":"ghasia za adui zako, zinazoinuka mfululizo.","poem":2}]}],"footnotes":[{"noteId":19,"caller":"+","text":"Lewiathani ni mnyama mkubwa wa baharini mwenye magamba anayefanana na joka kubwa, mwenye umbo la kutisha, asiyeweza kuvuliwa.","reference":{"chapter":74,"verse":14}}]},"thisChapterLink":"/api/swh_onmm/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}