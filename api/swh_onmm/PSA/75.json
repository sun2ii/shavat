{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"heading","content":["Mwenyezi Mungu ni mwamuzi"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa “Usiharibu”. Zaburi ya Asafu. Wimbo."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, tunakushukuru,","poem":1},{"text":"tunakushukuru wewe,","poem":2},{"text":"kwa kuwa jina lako li karibu;","poem":1},{"text":"watu husimulia matendo yako ya ajabu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Unasema, “Ninachagua wakati maalum;","poem":1},{"text":"ni mimi nihukumuye kwa haki.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Dunia inapotetemeka na watu wake wote,","poem":1},{"text":"ni mimi ninayezishikilia nguzo zake imara.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa wale wenye majivuno ninasema,","poem":1},{"text":"‘Msijisifu tena,’","poem":2},{"lineBreak":true},{"text":"kwa wale waovu, ‘Msiinue pembe zenu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Msiinue pembe zenu dhidi ya mbingu;","poem":1},{"text":"msiseme kwa kiburi.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Hakuna yeyote atokaye mashariki wala magharibi","poem":1},{"text":"au kutoka jangwani awezaye kumkweza mwanadamu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bali Mungu ndiye ahukumuye:","poem":1},{"text":"Humshusha huyu na kumkweza mwingine.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mkononi mwa Mwenyezi Mungu kuna kikombe","poem":1},{"text":"kilichojaa mvinyo unaotoka povu","poem":2},{"lineBreak":true},{"text":"uliochanganywa na vikolezo;","poem":2},{"text":"huumimina, nao waovu wote wa dunia","poem":1},{"text":"hunywa hata tone la mwisho.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bali mimi, nitatangaza hili milele;","poem":1},{"text":"nitaimba sifa kwa Mungu wa Yakobo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nitazikatilia mbali pembe za waovu wote,","poem":1},{"text":"bali pembe za wenye haki zitainuliwa juu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}