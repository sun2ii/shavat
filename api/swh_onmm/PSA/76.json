{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"heading","content":["Mungu wa Israeli ni mhukumu wa dunia yote"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Kwa ala za nyuzi za muziki. Zaburi ya Asafu. Wimbo."]},{"type":"verse","number":1,"content":[{"text":"Katika Yuda, Mungu anajulikana,","poem":1},{"text":"jina lake ni kuu katika Israeli.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Hema lake liko Salemu,","poem":1},{"text":"makao yake katika Sayuni.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Huko alivunja mishale iliyowaka,","poem":1},{"text":"ngao na panga, silaha za vita.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wewe unang’aa kwa mwanga,","poem":1},{"text":"mwenye fahari zaidi ya milima yenye utajiri wa wanyama pori.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mashujaa hulala wametekwa nyara,","poem":1},{"text":"hulala usingizi wao wa mwisho;","poem":2},{"text":"hakuna hata mmoja wa watu wa vita","poem":1},{"text":"anayeweza kuinua mikono yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa kukemea kwako, Ee Mungu wa Yakobo,","poem":1},{"text":"farasi na gari la vita vilikaa kimya.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Wewe peke yako ndiye wa kuogopwa.","poem":1},{"text":"Ni nani awezaye kusimama mbele yako unapokasirika?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ulitamka hukumu kutoka mbinguni,","poem":1},{"text":"nayo nchi ikaogopa, ikawa kimya:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"wakati wewe, Ee Mungu, ulipoinuka kuhukumu,","poem":1},{"text":"kuwaokoa wote walioonewa katika nchi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hakika ghadhabu yako dhidi ya wanadamu inakuletea sifa,","poem":1},{"text":"na masalia ya ghadhabu yako unajifunga mshipi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Wekeni nadhiri kwa Mwenyezi Mungu, Mungu wenu, na kuzitimiza;","poem":1},{"text":"nchi zote za jirani na walete zawadi","poem":2},{"lineBreak":true},{"text":"kwa Yule astahiliye kuogopwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Huvunja roho za watawala;","poem":1},{"text":"anaogopwa na wafalme wa dunia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}