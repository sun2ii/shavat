{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"heading","content":["Matendo makuu ya Mwenyezi Mungu yanakumbukwa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa Yeduthuni. Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Nilimlilia Mungu ili anisaidie,","poem":1},{"text":"nilimlilia Mungu ili anisikie.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nilipokuwa katika taabu, nilimtafuta Bwana,","poem":1},{"text":"usiku nilinyoosha mikono bila kuchoka","poem":2},{"lineBreak":true},{"text":"na nafsi yangu ilikataa kufarijika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Mungu, nilikukumbuka wewe, nikalia kwa huzuni;","poem":1},{"text":"nikatafakari, roho yangu ikadhoofika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Ulizuia macho yangu kufumba;","poem":1},{"text":"nilikuwa nasumbuka, nikashindwa kusema.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nilitafakari kuhusu siku zilizopita,","poem":1},{"text":"miaka mingi iliyopita,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"nilikumbuka nilivyoimba nyimbo usiku.","poem":1},{"text":"Moyo wangu ulitafakari","poem":2},{"lineBreak":true},{"text":"na roho yangu ikauliza:","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Je, Bwana atakataa milele?","poem":1},{"text":"Je, hatatenda mema tena?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Je, upendo wake usio na mwisho umetoweka milele?","poem":1},{"text":"Je, ahadi yake imekoma nyakati zote?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, Mungu amesahau kuwa na huruma?","poem":1},{"text":"Je, katika hasira amezuia fadhili zake?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ndipo nikawaza, “Huu ndio udhaifu wangu:","poem":1},{"text":"lakini nitakumbuka","poem":2},{"text":"miaka ya mkono wa kuume","poem":1},{"text":"wa Aliye Juu Sana.”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nitayakumbuka matendo ya Mwenyezi Mungu;","poem":1},{"text":"naam, nitaikumbuka miujiza yako ya zamani.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitazitafakari kazi zako zote","poem":1},{"text":"na kuyawaza matendo yako makuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mungu, njia zako ni takatifu.","poem":1},{"lineBreak":true},{"text":"Ni mungu yupi aliye mkuu kama Mungu wetu?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Wewe ndiwe Mungu utendaye miujiza,","poem":1},{"text":"umeonesha uwezo wako kati ya mataifa.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Kwa mkono wako wenye nguvu umewakomboa watu wako,","poem":1},{"text":"uzao wa Yakobo na Yusufu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Maji yalikuona, Ee Mungu,","poem":1},{"text":"maji yalikuona yakakimbia,","poem":2},{"lineBreak":true},{"text":"vilindi vilitetemeka.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mawingu yalimwaga maji,","poem":1},{"text":"mbingu zikatoa ngurumo kwa radi;","poem":2},{"lineBreak":true},{"text":"mishale yako ilimetameta huku na huko.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ngurumo yako ilisikika katika upepo wa kisulisuli,","poem":1},{"text":"umeme wako wa radi ukaangaza dunia,","poem":2},{"lineBreak":true},{"text":"nchi ikatetemeka na kutikisika.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Njia yako ilipita baharini,","poem":1},{"text":"mapito yako kwenye maji makuu,","poem":2},{"lineBreak":true},{"text":"ingawa nyayo zako hazikuonekana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Uliongoza watu wako kama kundi","poem":1},{"text":"kwa mkono wa Musa na Haruni.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}