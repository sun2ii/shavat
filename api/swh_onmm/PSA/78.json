{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"heading","content":["Mwenyezi Mungu na watu wake"]},{"type":"hebrew_subtitle","content":["Utenzi wa Asafu."]},{"type":"verse","number":1,"content":[{"text":"Enyi watu wangu, sikieni mafundisho yangu,","poem":1},{"text":"sikilizeni maneno ya kinywa changu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitafungua kinywa changu kwa mafumbo,","poem":1},{"text":"nitazungumza mambo yaliyofichika, mambo ya kale:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"yale ambayo tuliyasikia na kuyajua,","poem":1},{"text":"yale ambayo baba zetu walituambia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Hatutayaficha kwa watoto wao;","poem":1},{"text":"tutakiambia kizazi kijacho","poem":2},{"text":"matendo yastahiliyo sifa ya Mwenyezi Mungu,","poem":1},{"text":"uweza wake, na maajabu aliyoyafanya.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aliagiza amri kwa Yakobo","poem":1},{"text":"na akaweka sheria katika Israeli,","poem":2},{"text":"ambazo aliwaamuru baba zetu","poem":1},{"text":"wawafundishe watoto wao,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ili kizazi kijacho kizijue,","poem":1},{"text":"pamoja na watoto ambao watazaliwa,","poem":2},{"lineBreak":true},{"text":"nao pia wapate kuwaeleza watoto wao.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ndipo wangeweka tumaini lao kwa Mungu,","poem":1},{"text":"nao hawangesahau matendo yake,","poem":2},{"lineBreak":true},{"text":"bali wangezishika amri zake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hawangefanana na baba zao,","poem":1},{"text":"waliokuwa kizazi cha ukaidi na uasi,","poem":2},{"text":"ambao roho zao hazikuwa na uaminifu kwa Mungu,","poem":1},{"text":"ambao roho zao hazikumwamini.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Watu wa Efraimu, ingawa walijifunga pinde,","poem":1},{"text":"walikimbia siku ya vita.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Hawakulishika agano la Mungu,","poem":1},{"text":"na walikataa kuishi kwa sheria yake.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Walisahau aliyokuwa ameyatenda,","poem":1},{"text":"maajabu aliyokuwa amewaonesha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Alitenda miujiza machoni mwa baba zao,","poem":1},{"text":"huko Soani, katika nchi ya Misri.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Aliigawanya bahari akawapitisha,","poem":1},{"text":"alifanya maji yasimame imara kama ukuta.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Aliwaongoza kwa wingu mchana,","poem":1},{"text":"na kwa nuru ya moto usiku kucha.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Alipasua miamba jangwani","poem":1},{"text":"na akawapa maji tele kama bahari,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"alitoa vijito kutoka jabali lililochongoka,","poem":1},{"text":"akayafanya maji yatiririke kama mito.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Lakini waliendelea kutenda dhambi dhidi yake,","poem":1},{"text":"wakiasi jangwani dhidi ya Aliye Juu Sana.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kwa makusudi walimjaribu Mungu,","poem":1},{"text":"wakidai vyakula walivyovitamani.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Walinena dhidi ya Mungu, wakisema,","poem":1},{"text":"“Je, Mungu aweza kuandaa meza jangwani?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Alipopiga mwamba, maji yalitoka kwa nguvu,","poem":1},{"text":"vijito vikatiririka maji mengi.","poem":2},{"text":"Lakini je, aweza kutupatia chakula pia?","poem":1},{"text":"Je, anaweza kuwapatia watu wake nyama?”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Mwenyezi Mungu alipowasikia, alikasirika sana,","poem":1},{"text":"moto wake ukawa dhidi ya Yakobo,","poem":2},{"lineBreak":true},{"text":"na ghadhabu yake ikawaka dhidi ya Israeli,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"kwa kuwa hawakumwamini Mungu,","poem":1},{"text":"wala kuutumainia ukombozi wake.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Hata hivyo alitoa amri kwa anga zilizo juu","poem":1},{"text":"na kufungua milango ya mbingu,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"akawanyeshea mana ili watu wale;","poem":1},{"text":"aliwapa nafaka ya mbinguni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Watu walikula mkate wa malaika,","poem":1},{"text":"akawatumia chakula chote ambacho wangeweza kula.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Aliachia upepo wa mashariki kutoka mbingu","poem":1},{"text":"na kuuongoza upepo wa kusini kwa uwezo wake.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Aliwanyeshea nyama kama mavumbi,","poem":1},{"text":"ndege warukao kama mchanga wa pwani.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Aliwafanya washuke ndani ya kambi yao,","poem":1},{"text":"kuzunguka mahema yao yote.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Walikula na kusaza,","poem":1},{"text":"kwa maana alikuwa amewapa kile walichotamani.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Kabla hawajamaliza kula walichokitamani,","poem":1},{"text":"hata kilipokuwa kingali bado vinywani mwao,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"hasira ya Mungu ikawaka juu yao,","poem":1},{"text":"akawaua wale waliokuwa na nguvu zaidi miongoni mwao,","poem":2},{"lineBreak":true},{"text":"akiwaangusha vijana wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"Licha ya haya yote, waliendelea kutenda dhambi,","poem":1},{"text":"licha ya maajabu yake, hawakuamini.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Kwa hiyo akamaliza siku zao katika ubatili","poem":1},{"text":"na miaka yao katika vitisho.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Kila mara Mungu alipowaua baadhi yao,","poem":1},{"text":"waliosalia walimtafuta,","poem":2},{"lineBreak":true},{"text":"walimgeukia tena kwa shauku.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Walikumbuka kwamba Mungu alikuwa Mwamba wao,","poem":1},{"text":"kwamba Mungu Aliye Juu Sana alikuwa Mkombozi wao.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Lakini walimdanganya kwa vinywa vyao,","poem":1},{"text":"wakisema uongo kwa ndimi zao,","poem":2}]},{"type":"verse","number":37,"content":[{"text":"mioyo yao haikuwa thabiti kwake,","poem":1},{"text":"wala hawakuwa waaminifu katika agano lake.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"Hata hivyo alikuwa na huruma,","poem":1},{"text":"alisamehe maovu yao","poem":2},{"lineBreak":true},{"text":"na hakuwaangamiza.","poem":2},{"text":"Mara kwa mara alizuia hasira yake,","poem":1},{"text":"wala hakuchochea ghadhabu yake yote.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Alikumbuka kwamba wao walikuwa nyama tu,","poem":1},{"text":"upepo upitao ambao haurudi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"Mara ngapi walimwasi jangwani","poem":1},{"text":"na kumhuzunisha nyikani!","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Walimjaribu Mungu mara kwa mara,","poem":1},{"text":"wakamkasirisha yeye Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Hawakukumbuka uwezo wake,","poem":1},{"text":"siku aliyowakomboa kutoka kwa mtesi,","poem":2}]},{"type":"verse","number":43,"content":[{"text":"siku aliyoonesha ishara zake za ajabu huko Misri,","poem":1},{"text":"maajabu yake huko Soani.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Aligeuza mito yao kuwa damu,","poem":1},{"text":"hawakuweza kunywa maji kutoka vijito vyao.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Aliwapelekea makundi ya inzi wakawala,","poem":1},{"text":"na vyura wakawaharibu.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"Aliruhusu tunutu kuharibu mimea yao,","poem":1},{"text":"mazao yao kwa nzige.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Aliharibu mizabibu yao kwa mvua ya mawe","poem":1},{"text":"na mikuyu yao kwa mvua iliyochangamana na theluji.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Aliwaachia mifugo yao mvua ya mawe,","poem":1},{"text":"akayapiga makundi ya wanyama wao kwa radi.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"Aliwafungulia hasira yake kali,","poem":1},{"text":"ghadhabu yake, hasira na uadui,","poem":2},{"lineBreak":true},{"text":"na kundi la malaika wa kuharibu.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Aliitengenezea njia hasira yake,","poem":1},{"text":"hakuwaepusha na kifo,","poem":2},{"lineBreak":true},{"text":"bali aliwaachia tauni.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"Aliwapiga wazaliwa wote wa kwanza wa Misri,","poem":1},{"text":"matunda ya kwanza ya ujana katika mahema ya Hamu.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"Lakini aliwatoa watu wake kama kundi,","poem":1},{"text":"akawaongoza kama kondoo kupitia jangwani.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"Aliwaongoza salama, wala hawakuogopa,","poem":1},{"text":"bali bahari iliwameza adui zao.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"Hivyo akawaleta hadi kwenye mpaka wa nchi yake takatifu,","poem":1},{"text":"hadi nchi ya vilima ambayo mkono wake wa kuume ulikuwa umeitwaa.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"Aliyafukuza mataifa mbele yao,","poem":1},{"text":"na kuwagawia nchi zao kama urithi,","poem":2},{"lineBreak":true},{"text":"aliwakalisha makabila ya Israeli katika makao yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"Lakini wao walimjaribu Mungu,","poem":1},{"text":"na kuasi dhidi ya Yeye Aliye Juu Sana,","poem":2},{"lineBreak":true},{"text":"wala hawakuzishika sheria zake.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"Kama baba zao, hawakuwa thabiti wala waaminifu,","poem":1},{"text":"wakawa wasioweza kutegemewa","poem":2},{"lineBreak":true},{"text":"kama upinde wenye kasoro.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"Wakamkasirisha Mungu kwa mahali pao pa juu pa kuabudia,","poem":1},{"text":"wakachochea wivu wake kwa sanamu zao.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"Mungu alipowasikia, alikasirika sana,","poem":1},{"text":"akamkataa Israeli kabisa.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"Akaiacha maskani ya Shilo,","poem":1},{"text":"hema alilokuwa ameliweka katikati ya wanadamu.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"Akalipeleka Sanduku la nguvu zake utumwani,","poem":1},{"text":"utukufu wake mikononi mwa adui.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"Aliachia watu wake wauawe kwa upanga,","poem":1},{"text":"akaukasirikia sana urithi wake.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"Moto uliwaangamiza vijana wao,","poem":1},{"text":"na wanawali wao hawakuimbiwa nyimbo za arusi,","poem":2}]},{"type":"verse","number":64,"content":[{"text":"makuhani wao waliuawa kwa upanga,","poem":1},{"text":"wala wajane wao hawakuweza kulia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"Ndipo Bwana alipoamka kama kuamka usingizini,","poem":1},{"text":"kama shujaa anavyoamka","poem":2},{"lineBreak":true},{"text":"kutoka bumbuazi la mvinyo.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"Aliwapiga na kuwashinda adui zake,","poem":1},{"text":"akawatia katika aibu ya milele.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"Ndipo alipoyakataa mahema ya Yusufu,","poem":1},{"text":"hakulichagua kabila la Efraimu,","poem":2}]},{"type":"verse","number":68,"content":[{"text":"lakini alilichagua kabila la Yuda,","poem":1},{"text":"Mlima Sayuni, ambao aliupenda.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"Alijenga patakatifu pake kama vilele,","poem":1},{"text":"kama dunia ambayo aliimarisha milele.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"Akamchagua Daudi mtumishi wake","poem":1},{"text":"na kumtoa kwenye mazizi ya kondoo.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"Kutoka kuchunga kondoo alimleta","poem":1},{"text":"kuwa mchungaji wa watu wake Yakobo,","poem":2},{"lineBreak":true},{"text":"wa Israeli urithi wake.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"Naye Daudi aliwachunga kwa uadilifu wa moyo,","poem":1},{"text":"kwa mikono ya ustadi aliwaongoza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}