{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"heading","content":["Maombi kwa ajili ya wokovu wa taifa"]},{"type":"hebrew_subtitle","content":["Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, mataifa yameuvamia urithi wako,","poem":1},{"text":"wamelinajisi Hekalu lako takatifu,","poem":2},{"lineBreak":true},{"text":"wameifanya Yerusalemu kuwa magofu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Wametoa maiti za watumishi","poem":1},{"text":"kuwa chakula cha ndege wa angani","poem":2},{"text":"na nyama ya watakatifu wako","poem":1},{"text":"kwa wanyama wa nchi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wamemwaga damu kama maji","poem":1},{"text":"kuzunguka Yerusalemu yote,","poem":2},{"lineBreak":true},{"text":"wala hakuna yeyote wa kuwazika.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tumekuwa kitu cha aibu kwa majirani zetu,","poem":1},{"text":"cha dharau na mzaha kwa wale wanaotuzunguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Hata lini, Ee Mwenyezi Mungu? Je, wewe utakasirika milele?","poem":1},{"text":"Wivu wako utawaka kama moto hadi lini?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mwaga ghadhabu yako kwa mataifa yasiyokukubali,","poem":1},{"text":"juu ya falme za hao wasioliitia jina lako,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"kwa maana wamemrarua Yakobo","poem":1},{"text":"na kuharibu nchi ya makao yake.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Usituhesabie dhambi za baba zetu,","poem":1},{"text":"huruma yako na itujie hima,","poem":2},{"lineBreak":true},{"text":"kwa maana tu wahitaji mno.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mungu Mwokozi wetu, utusaidie,","poem":1},{"text":"kwa ajili ya utukufu wa jina lako;","poem":2},{"text":"tuokoe na kutusamehe dhambi zetu","poem":1},{"text":"kwa ajili ya jina lako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa nini mataifa waseme,","poem":1},{"text":"“Yuko wapi Mungu wenu?”","poem":2},{"text":"Mbele ya macho yetu,","poem":1},{"text":"dhihirisha kati ya mataifa","poem":2},{"text":"kwamba unalipiza kisasi damu iliyomwagwa","poem":1},{"text":"ya watumishi wako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kilio cha huzuni cha wafungwa kifike mbele zako;","poem":1},{"text":"kwa nguvu za mkono wako","poem":2},{"lineBreak":true},{"text":"hifadhi wale waliohukumiwa kufa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Walipize majirani zetu mara saba","poem":1},{"text":"aibu walizovurumisha kwako, Ee Bwana.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ndipo sisi watu wako, kondoo wa malisho yako,","poem":1},{"text":"tutakusifu milele;","poem":2},{"text":"tutasimulia sifa zako","poem":1},{"text":"kizazi hadi kizazi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}