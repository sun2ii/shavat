{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"heading","content":["Utukufu wa Mwenyezi Mungu na heshima ya mwanadamu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa gitithi. Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, Bwana wetu,","poem":1},{"text":"tazama jinsi lilivyo tukufu jina lako duniani kote!","poem":2},{"lineBreak":true},{"text":"Umeuweka utukufu wako","poem":1},{"text":"juu ya mbingu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Midomoni mwa watoto wachanga na wanaonyonya","poem":1},{"text":"umeamuru sifa,","poem":2},{"text":"kwa sababu ya watesi wako,","poem":1},{"text":"kumnyamazisha adui na mlipiza kisasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Nikiziangalia mbingu zako,","poem":1},{"text":"kazi ya vidole vyako,","poem":2},{"text":"mwezi na nyota,","poem":1},{"text":"ulizoziratibisha,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"mwanadamu ni kitu gani hata unamfikiria,","poem":1},{"text":"binadamu ni nani hata unamjali?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umemfanya chini kidogo kuliko viumbe wa mbinguni,","poem":1},{"text":"ukamvika taji la utukufu na heshima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Umemfanya mtawala juu ya kazi za mikono yako;","poem":1},{"text":"umeweka vitu vyote chini ya miguu yake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mifugo na makundi yote pia,","poem":1},{"text":"naam, na wanyama wa kondeni,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ndege wa angani na samaki wa baharini,","poem":1},{"text":"naam, kila kinachoogelea katika njia za bahari.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mwenyezi Mungu, Bwana wetu,","poem":1},{"text":"tazama jinsi lilivyo tukufu jina lako duniani kote!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}