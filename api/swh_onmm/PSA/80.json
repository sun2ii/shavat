{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"heading","content":["Maombi kwa ajili ya kuponywa kwa taifa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa “Yungiyungi za Agano”. Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mchungaji wa Israeli tusikie,","poem":1},{"text":"wewe umwongozaye Yusufu kama kundi;","poem":2},{"text":"wewe uketiye kwenye kiti cha enzi","poem":1},{"text":"katikati ya makerubi, angaza","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"mbele ya Efraimu, Benyamini na Manase.","poem":2},{"text":"Uamshe nguvu zako,","poem":1},{"text":"uje utuokoe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ee Mungu, uturejeshe,","poem":1},{"text":"utuangazie uso wako,","poem":2},{"lineBreak":true},{"text":"ili tuweze kuokolewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Bwana Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni,","poem":2},{"text":"hata lini hasira yako itawaka","poem":1},{"text":"dhidi ya maombi ya watu wako?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umewalisha kwa mkate wa machozi,","poem":1},{"text":"umewafanya wanywe machozi bakuli tele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tumekuwa chanzo cha ugomvi kwa majirani zetu,","poem":1},{"text":"na adui zetu wanatudhihaki.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ee Mungu wa majeshi ya mbinguni, uturejeshe;","poem":1},{"text":"utuangazie uso wako,","poem":2},{"lineBreak":true},{"text":"nasi tuweze kuokolewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ulileta mzabibu kutoka Misri,","poem":1},{"text":"ukawafukuza mataifa, ukaupanda.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Uliandaa shamba kwa ajili yake,","poem":1},{"text":"mizizi ikawa imara, ukajaza nchi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Milima ilifunikwa kwa kivuli chake,","poem":1},{"text":"matawi yake yakafunika mierezi mikubwa.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Matawi yake yalienea hadi Baharini","poem":1},{"noteId":20},{"text":",","poem":1},{"text":"machipukizi yake hadi kwenye Mto","poem":2},{"noteId":21},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mbona umebomoa kuta zake","poem":1},{"text":"ili wote wapitao karibu","poem":2},{"lineBreak":true},{"text":"wazichume zabibu zake?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nguruwe mwitu wanauharibu,","poem":1},{"text":"na viumbe wa kondeni hujilisha humo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Turudie, Ee Mungu wa majeshi ya mbinguni!","poem":1},{"text":"Tazama chini kutoka mbinguni na uone!","poem":2},{"text":"Linda mzabibu huu,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"mche ulioupanda kwa mkono wako wa kuume,","poem":2},{"text":"mwana uliyemlea","poem":1},{"text":"kwa ajili yako mwenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mzabibu wako umekatwa, umechomwa moto,","poem":1},{"text":"unapowakemea, watu wako huangamia.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mkono wako na utulie juu ya mtu aliye katika mkono wako wa kuume,","poem":1},{"text":"mwana wa mtu uliyemlea kwa ajili yako mwenyewe.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Ndipo hatutakuacha tena,","poem":1},{"text":"utuhuishe, nasi tutaliitia jina lako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Bwana Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni, uturejeshe;","poem":2},{"text":"utuangazie uso wako,","poem":1},{"text":"ili tuweze kuokolewa.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"pengine ni Bahari ya Mediterania","reference":{"chapter":80,"verse":11}},{"noteId":21,"caller":"+","text":"yaani Mto Frati","reference":{"chapter":80,"verse":11}}]},"thisChapterLink":"/api/swh_onmm/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}