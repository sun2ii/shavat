{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"heading","content":["Wimbo wa sikukuu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa gitithi. Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mwimbieni kwa furaha, Mungu aliye nguvu yetu;","poem":1},{"text":"mpigieni kelele za shangwe Mungu wa Yakobo!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anzeni wimbo, pigeni matari,","poem":1},{"text":"pigeni kinubi na zeze kwa sauti nzuri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Pigeni baragumu za pembe za kondoo dume","poem":1},{"text":"wakati wa Mwandamo wa Mwezi,","poem":2},{"text":"na wakati wa mwezi mpevu,","poem":1},{"text":"katika siku ya Sikukuu yetu;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"hii ni amri kwa Israeli,","poem":1},{"text":"agizo la Mungu wa Yakobo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Aliiweka iwe kama sheria kwa Yusufu","poem":1},{"text":"alipotoka dhidi ya Misri,","poem":2},{"lineBreak":true},{"text":"huko tulikosikia lugha ambayo hatukuielewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Asema, “Nimeondoa mzigo mabegani mwao;","poem":1},{"text":"mikono yao iliwekwa huru kutoka kwa kikapu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katika shida yako uliniita nami nikakuokoa,","poem":1},{"text":"nilikujibu katika mawingu yenye ngurumo;","poem":2},{"lineBreak":true},{"text":"nilikujaribu katika maji ya Meriba.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Enyi watu wangu, sikieni, nami nitawaonya:","poem":1},{"text":"laiti kama mngenisikiliza, ee Israeli!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hamtakuwa na mungu mgeni miongoni mwenu;","poem":1},{"text":"msimsujudie mungu wa kigeni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mimi ni Mwenyezi Mungu, Mungu wako,","poem":1},{"text":"niliyekutoa nchi ya Misri.","poem":2},{"text":"Panua sana kinywa chako","poem":1},{"text":"nami nitakijaza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Lakini watu wangu hawakunisikiliza;","poem":1},{"text":"Israeli hakunitii.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Basi niliwaacha katika ukaidi wa mioyo yao","poem":1},{"text":"wafuate mashauri yao wenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Laiti watu wangu wangenisikiliza,","poem":1},{"text":"laiti Israeli wangefuata njia zangu,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ningewatiisha adui zao kwa haraka,","poem":1},{"text":"na kuugeuza mkono wangu dhidi ya watesi wao!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Wale wanaomchukia Mwenyezi Mungu wangejikunyata mbele zake,","poem":1},{"text":"na adhabu yao ingedumu milele.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bali ninyi mngelishwa ngano iliyo bora,","poem":1},{"text":"na kuwatosheleza kwa asali inayotoka kwenye mwamba.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}