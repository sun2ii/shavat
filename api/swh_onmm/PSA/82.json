{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"heading","content":["Maombi kwa ajili ya kutaka haki"]},{"type":"hebrew_subtitle","content":["Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Mungu anaongoza kusanyiko kuu,","poem":1},{"text":"anatoa hukumu miongoni mwa “miungu”:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“Hata lini utaendelea kuwatetea wasio haki","poem":1},{"text":"na kuonesha upendeleo kwa waovu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Teteeni wanyonge na yatima,","poem":1},{"text":"tunzeni haki za maskini na waliodhulumiwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mwokoeni mnyonge na mhitaji,","poem":1},{"text":"wakomboeni kutoka mkononi mwa mwovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Hawajui lolote, hawaelewi lolote.","poem":1},{"text":"Wanatembea gizani;","poem":2},{"lineBreak":true},{"text":"misingi yote ya dunia imetikisika.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nilisema, ‘Ninyi ni “miungu”;","poem":1},{"text":"ninyi nyote ni wana wa Aliye Juu Sana.’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lakini mtakufa kama wanadamu wa kawaida;","poem":1},{"text":"mtaanguka kama mtawala mwingine yeyote.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mungu, inuka uihukumu nchi,","poem":1},{"text":"kwa kuwa mataifa yote ni urithi wako.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}