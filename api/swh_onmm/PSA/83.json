{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"heading","content":["Maombi kwa ajili ya kushindwa kwa adui za Israeli"]},{"type":"hebrew_subtitle","content":["Wimbo. Zaburi ya Asafu."]},{"type":"verse","number":1,"content":[{"text":"Ee Mungu, usikae kimya,","poem":1},{"text":"usinyamaze, Ee Mungu, usikae mbali.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Tazama watesi wako wanafanya fujo,","poem":1},{"text":"jinsi adui zako wanavyoinua vichwa vyao.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kwa ujanja, wanapanga njama dhidi ya watu wako;","poem":1},{"text":"wanapanga hila dhidi ya wale unaowapenda.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Wanasema, “Njooni, tuwaangamize kama taifa,","poem":1},{"text":"ili jina la Israeli lisikumbukwe tena.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kwa nia moja wanapanga njama pamoja,","poem":1},{"text":"wanafanya muungano dhidi yako,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"mahema ya Edomu na Waishmaeli,","poem":1},{"text":"ya Wamoabu na Wahagari,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gebali","poem":1},{"noteId":22},{"text":", Amoni na Amaleki,","poem":1},{"text":"Ufilisti, pamoja na watu wa Tiro.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Hata Ashuru wameungana nao","poem":1},{"text":"kuwapa nguvu wazao wa Lutu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Uwatendee kama vile ulivyowatendea Midiani,","poem":1},{"text":"na kama vile ulivyowatendea Sisera na Yabini","poem":2},{"lineBreak":true},{"text":"hapo kijito cha Kishoni,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ambao waliangamia huko Endori","poem":1},{"text":"na wakawa kama kinyesi juu ya ardhi.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Wafanye wakuu wao kama Orebu na Zeebu,","poem":1},{"text":"watawala wao kama Zeba na Salmuna,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ambao walisema, “Na tumiliki maeneo","poem":1},{"text":"ya malisho ya Mungu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mungu wangu, wapeperushe kama mavumbi ya kisulisuli,","poem":1},{"text":"kama makapi yapeperushwayo na upepo.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kama vile moto unavyoteketeza msitu","poem":1},{"text":"au mwali wa moto unavyounguza milima,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"wafuatilie kwa tufani yako","poem":1},{"text":"na kuwafadhaisha kwa dhoruba yako.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Funika nyuso zao kwa aibu","poem":1},{"text":"ili watu walitafute jina lako, Ee Mwenyezi Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wao na waaibishwe na kufadhaishwa milele,","poem":1},{"text":"na waangamie kwa aibu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Hebu wajue kuwa wewe, ambaye jina lako ni Mwenyezi Mungu,","poem":1},{"text":"kwamba wewe peke yako ndiwe Uliye Juu Sana ya dunia yote.","poem":2}]}],"footnotes":[{"noteId":22,"caller":"+","text":"yaani Bubilo","reference":{"chapter":83,"verse":7}}]},"thisChapterLink":"/api/swh_onmm/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}