{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"heading","content":["Kuionea shauku nyumba ya Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa gitithi. Zaburi ya wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":1},{"text":"makao yako yapendeza kama nini!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nafsi yangu inatamani sana,","poem":1},{"text":"naam, hata kuona shauku,","poem":2},{"lineBreak":true},{"text":"kwa ajili ya nyua za Mwenyezi Mungu;","poem":2},{"text":"moyo wangu na mwili wangu","poem":1},{"text":"vinamlilia Mungu Aliye Hai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hata shomoro amejipatia makao,","poem":1},{"text":"mbayuwayu amejipatia kiota","poem":2},{"lineBreak":true},{"text":"mahali awezapo kuweka makinda yake:","poem":2},{"text":"mahali karibu na madhabahu yako,","poem":1},{"text":"Ee Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":2},{"lineBreak":true},{"text":"Mfalme wangu na Mungu wangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Heri wale wanaokaa nyumbani mwako,","poem":1},{"text":"wanaokusifu wewe daima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Heri wale ambao nguvu zao ziko kwako,","poem":1},{"text":"na njia ziendazo Sayuni zimo mioyoni mwao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wanapopita katika Bonde la Baka","poem":1},{"noteId":23},{"text":",","poem":1},{"text":"hulifanya mahali pa chemchemi,","poem":2},{"lineBreak":true},{"text":"pia mvua za vuli hulijaza kwa madimbwi","poem":2},{"noteId":24},{"text":".","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Huendelea toka nguvu hadi nguvu,","poem":1},{"text":"hadi kila mmoja afikapo","poem":2},{"lineBreak":true},{"text":"mbele za Mungu huko Sayuni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Bwana Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni,","poem":2},{"lineBreak":true},{"text":"sikia maombi yangu;","poem":2},{"lineBreak":true},{"text":"nisikilize, Ee Mungu wa Yakobo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Mungu, uitazame ngao yetu,","poem":1},{"text":"mtazame kwa wema mpakwa mafuta wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Siku moja katika nyua zako ni bora","poem":1},{"text":"kuliko siku elfu mahali pengine;","poem":2},{"text":"afadhali ningekuwa bawabu katika nyumba ya Mungu wangu","poem":1},{"text":"kuliko kukaa katika mahema ya waovu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa kuwa Bwana Mwenyezi Mungu ni jua na ngao;","poem":1},{"text":"Mwenyezi Mungu hutoa wema na heshima;","poem":2},{"text":"hakuna kitu chema anachowanyima","poem":1},{"text":"wale ambao hawana hatia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":1},{"text":"heri mtu anayekutumaini wewe.","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"maana yake Bonde la Vilio","reference":{"chapter":84,"verse":6}},{"noteId":24,"caller":"+","text":"au baraka","reference":{"chapter":84,"verse":6}}]},"thisChapterLink":"/api/swh_onmm/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}