{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"heading","content":["Maombi kwa ajili ya ustawi wa taifa"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Zaburi ya wana wa Kora."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, ulionesha wema kwa nchi yako.","poem":1},{"text":"Ulimrejeshea Yakobo baraka zake.","poem":2},{"noteId":25}]},{"type":"verse","number":2,"content":[{"text":"Ulisamehe uovu wa watu wako,","poem":1},{"text":"na kufunika dhambi zao zote.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Uliweka kando ghadhabu yako yote","poem":1},{"text":"na umegeuka na kuiacha hasira yako kali.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Mungu Mwokozi wetu, uturejeshe tena,","poem":1},{"text":"nawe uiondoe chuki yako juu yetu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Je, utatukasirikia milele?","poem":1},{"text":"Utaendeleza hasira yako kwa vizazi vyote?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Je, hutatuhuisha tena,","poem":1},{"text":"ili watu wako wakufurahie?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Utuoneshe upendo wako usiokoma, Ee Mwenyezi Mungu,","poem":1},{"text":"utupe wokovu wako.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Nitasikiliza lile atakalosema Mungu aliye Mwenyezi Mungu;","poem":1},{"text":"anaahidi amani kwa watu wake, watakatifu wake:","poem":2},{"lineBreak":true},{"text":"lakini nao wasirudie upumbavu.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hakika wokovu wake uko karibu na wale wamchao,","poem":1},{"text":"ili utukufu wake udumu katika nchi yetu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Upendo na uaminifu hukutana pamoja,","poem":1},{"text":"haki na amani hubusiana.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Uaminifu huchipua kutoka nchi,","poem":1},{"text":"haki hutazama chini kutoka mbinguni.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naam, hakika Mwenyezi Mungu atatoa kilicho chema,","poem":1},{"text":"nayo nchi yetu itazaa mavuno yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Haki itatangulia mbele yake","poem":1},{"text":"na kutengeneza njia kwa ajili ya hatua zake.","poem":2}]}],"footnotes":[{"noteId":25,"caller":"+","text":"au Uliwarudisha mateka wa Yakobo.","reference":{"chapter":85,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}