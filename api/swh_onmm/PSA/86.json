{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"heading","content":["Kuomba msaada"]},{"type":"hebrew_subtitle","content":["Maombi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, sikia na unijibu,","poem":1},{"text":"kwa maana mimi ni maskini na mhitaji.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Linda maisha yangu, kwa maana nimejiweka kwako,","poem":1},{"text":"wewe ni Mungu wangu,","poem":2},{"lineBreak":true},{"text":"mwokoe mtumishi wako anayekutumaini.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee Bwana, nihurumie mimi,","poem":1},{"text":"kwa maana ninakuita mchana kutwa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mpe mtumishi wako furaha,","poem":1},{"text":"kwa kuwa kwako wewe, Ee Bwana,","poem":2},{"lineBreak":true},{"text":"ninainua nafsi yangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Bwana, wewe ni mwema na mwenye kusamehe,","poem":1},{"text":"umejaa upendo kwa wote wakuitao.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ee Mwenyezi Mungu, sikia maombi yangu,","poem":1},{"text":"sikiliza kilio changu unihurumie.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katika siku ya shida yangu nitakuita,","poem":1},{"text":"kwa maana wewe utanijibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Bwana, katikati ya miungu hakuna kama wewe,","poem":1},{"text":"hakuna matendo ya kulinganishwa na yako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ee Bwana, mataifa yote uliyoyafanya","poem":1},{"text":"yatakuja na kuabudu mbele zako;","poem":2},{"lineBreak":true},{"text":"wataliletea utukufu jina lako.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kwa maana wewe ni mkuu, na unafanya mambo ya ajabu;","poem":1},{"text":"wewe peke yako ndiwe Mungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ee Mwenyezi Mungu, nifundishe njia yako,","poem":1},{"text":"nami nitaenda katika kweli yako;","poem":2},{"text":"nipe moyo usiositasita,","poem":1},{"text":"ili niweze kulicha jina lako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wangu, nitakusifu kwa moyo wote;","poem":1},{"text":"nitaliadhimisha jina lako milele.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwa maana upendo wako ni mkuu kwangu;","poem":1},{"text":"umeniokoa kutoka vilindi vya kaburi","poem":2},{"noteId":26},{"text":".","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ee Mungu, wenye majivuno wananishambulia;","poem":1},{"text":"kundi la watu wakatili linatafuta uhai wangu:","poem":2},{"lineBreak":true},{"text":"watu wasiokuheshimu wewe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lakini wewe, Ee Bwana, ni Mungu wa huruma na neema,","poem":1},{"text":"si mwepesi wa hasira,","poem":2},{"lineBreak":true},{"text":"bali ni mwingi wa upendo na uaminifu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Nigeukie na unihurumie;","poem":1},{"text":"mpe mtumishi wako nguvu zako,","poem":2},{"lineBreak":true},{"text":"mwokoe mwana wa mjakazi wako","poem":2},{"noteId":27},{"text":".","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nipe ishara ya wema wako,","poem":1},{"text":"ili adui zangu waione nao waaibishwe,","poem":2},{"text":"kwa kuwa wewe, Ee Mwenyezi Mungu,","poem":1},{"text":"umenisaidia na kunifariji.","poem":2}]}],"footnotes":[{"noteId":26,"caller":"+","text":"Kaburi hapa ina maana ya Sheol kwa Kiebrania, yaani Kuzimu.","reference":{"chapter":86,"verse":13}},{"noteId":27,"caller":"+","text":"au mwokoe mwanao mwaminifu","reference":{"chapter":86,"verse":16}}]},"thisChapterLink":"/api/swh_onmm/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}