{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"heading","content":["Wimbo wakati wa taabu ya kitaifa"]},{"type":"hebrew_subtitle","content":["Utenzi wa Ethani Mwezrahi."]},{"type":"verse","number":1,"content":[{"text":"Nitaimba kuhusu upendo mkuu wa Mwenyezi Mungu milele;","poem":1},{"text":"kwa kinywa changu nitavijulisha","poem":2},{"lineBreak":true},{"text":"vizazi vyote uaminifu wako.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitatangaza kuwa upendo wako unasimama imara milele","poem":1},{"text":"na uaminifu wako umeuthibitisha mbinguni.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ulisema, “Nimefanya agano na mteule wangu,","poem":1},{"text":"nimemwapia mtumishi wangu Daudi,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘Nitaimarisha uzao wako milele","poem":1},{"text":"na kudumisha ufalme wako kwa vizazi vyote.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mwenyezi Mungu, mbingu zinayasifu maajabu yako,","poem":1},{"text":"uaminifu wako pia katika kusanyiko la watakatifu.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kwa kuwa ni nani katika mbingu","poem":1},{"text":"anayeweza kulinganishwa na Mwenyezi Mungu?","poem":2},{"text":"Ni nani miongoni mwa viumbe vya mbinguni","poem":1},{"text":"aliye kama Mwenyezi Mungu?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Katika kusanyiko la watakatifu, Mungu huogopwa sana,","poem":1},{"text":"anahofiwa kuliko wote wanaomzunguka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ee Bwana Mwenyezi Mungu,","poem":1},{"text":"Mungu wa majeshi ya mbinguni,","poem":2},{"lineBreak":true},{"text":"ni nani aliye kama wewe?","poem":2},{"text":"Ee Mwenyezi Mungu, wewe ni mwenye nguvu,","poem":1},{"text":"na uaminifu wako unakuzunguka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Wewe unatawala bahari yenye msukosuko;","poem":1},{"text":"mawimbi yake yanapoinuka, wewe unayatuliza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wewe ulimponda Rahabu","poem":1},{"noteId":31},{"text":"kama mmoja wa waliochinjwa;","poem":2},{"text":"kwa mkono wako wenye nguvu,","poem":1},{"text":"uliwatawanya adui zako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mbingu ni zako, nayo nchi pia ni yako,","poem":1},{"text":"uliuwekea ulimwengu msingi","poem":2},{"lineBreak":true},{"text":"pamoja na vyote vilivyomo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Uliumba kaskazini na kusini;","poem":1},{"text":"Tabori na Hermoni wanaliimbia jina lako kwa furaha.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mkono wako umejaa uwezo;","poem":1},{"text":"mkono wako una nguvu,","poem":2},{"lineBreak":true},{"text":"mkono wako wa kuume umetukuka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Haki na hukumu ndio msingi wa kiti chako cha enzi;","poem":1},{"text":"upendo na uaminifu vinakutangulia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Heri ni wale ambao wamejifunza kukusifu kwa shangwe,","poem":1},{"text":"wanaotembea katika mwanga","poem":2},{"lineBreak":true},{"text":"wa uwepo wako, Ee Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Wanashangilia katika jina lako mchana kutwa,","poem":1},{"text":"wanafurahi katika haki yako.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kwa kuwa wewe ni utukufu na nguvu yao,","poem":1},{"text":"kwa wema wako unatukuza pembe","poem":2},{"noteId":32},{"text":"yetu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Naam, ngao yetu ni mali ya Mwenyezi Mungu,","poem":1},{"text":"na mfalme wetu mali ya Aliye Mtakatifu wa Israeli.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ulizungumza wakati fulani katika maono,","poem":1},{"text":"kwa watu wako waaminifu, ukasema:","poem":2},{"text":"“Nimeweka nguvu kwa shujaa,","poem":1},{"text":"nimemwinua kijana miongoni mwa watu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nimemwona Daudi, mtumishi wangu,","poem":1},{"text":"na nimempaka mafuta yangu matakatifu.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Kitanga changu kitamtegemeza,","poem":1},{"text":"hakika mkono wangu utamtia nguvu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Hakuna adui atakayemtoza ushuru,","poem":1},{"text":"hakuna mtu mwovu atakayemtesa.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nitawaponda adui zake mbele zake","poem":1},{"text":"na kuwaangamiza watesi wake.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Upendo wangu mkamilifu utakuwa pamoja naye,","poem":1},{"text":"kwa Jina langu pembe yake itatukuzwa.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Nitauweka mkono wake juu ya bahari,","poem":1},{"text":"mkono wake wa kuume juu ya mito.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Naye ataniita kwa sauti, ‘Wewe ni Baba yangu,","poem":1},{"text":"Mungu wangu, Mwamba na Mwokozi wangu.’","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Nitamteua pia awe mzaliwa wangu wa kwanza,","poem":1},{"text":"aliyetukuka kuliko wafalme wote wa dunia.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Nitadumisha upendo wangu kwake milele,","poem":1},{"text":"na agano langu naye litakuwa imara.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Nitaudumisha uzao wake milele,","poem":1},{"text":"kiti chake cha utawala kama mbingu zinavyodumu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Kama wanawe wataacha amri yangu","poem":1},{"text":"na wasifuate sheria zangu,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"wakihalifu maagizo yangu","poem":1},{"text":"na kutoshika amri zangu,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"nitaadhibu dhambi yao kwa fimbo,","poem":1},{"text":"uovu wao kwa kuwapiga;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"lakini sitauondoa upendo wangu kwake,","poem":1},{"text":"wala sitausaliti uaminifu wangu kamwe.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Mimi sitavunja agano langu","poem":1},{"text":"wala sitabadili lile ambalo midomo yangu imelitamka.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Mara moja na kwa milele, nimeapa kwa utakatifu wangu,","poem":1},{"text":"nami sitamdanganya Daudi:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"kwamba uzao wake utaendelea milele,","poem":1},{"text":"na kiti chake cha enzi kitadumu mbele zangu kama jua;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"kitaimarishwa milele kama mwezi,","poem":1},{"text":"shahidi mwaminifu angani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"Lakini wewe umemkataa, umemdharau,","poem":1},{"text":"umemkasirikia sana mpakwa mafuta wako.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"Umelikana agano lako na mtumishi wako,","poem":1},{"text":"na umelinajisi taji lake mavumbini.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"Umebomoa kuta zake zote,","poem":1},{"text":"na ngome zake zote umezifanya kuwa magofu.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"Wote wapitao karibu wamemnyang’anya mali yake;","poem":1},{"text":"amekuwa dharau kwa majirani zake.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"Umeutukuza mkono wa kuume wa adui zake,","poem":1},{"text":"umewafanya watesi wake wote washangilie.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"Umegeuza makali ya upanga wake,","poem":1},{"text":"na hukumpa msaada katika vita.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"Umeikomesha fahari yake,","poem":1},{"text":"na kukiangusha kiti chake cha enzi.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"Umezifupisha siku za ujana wake,","poem":1},{"text":"umemfunika kwa vazi la aibu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"Hata lini, Ee Mwenyezi Mungu? Utajificha milele?","poem":1},{"text":"Ghadhabu yako itawaka kama moto hata lini?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"Kumbuka jinsi maisha yangu yanavyopita haraka.","poem":1},{"text":"Ni kwa ubatili kiasi gani umemuumba mwanadamu!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"Ni mtu gani awezaye kuishi na asione kifo,","poem":1},{"text":"au kujiokoa mwenyewe kutoka nguvu za kaburi","poem":2},{"noteId":33},{"text":"?","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"Ee Bwana, uko wapi upendo wako mkuu wa mwanzoni,","poem":1},{"text":"ambao katika uaminifu wako ulimwapia Daudi?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"Bwana kumbuka jinsi mtumishi wako amesimangwa,","poem":1},{"text":"jinsi ninavyovumilia moyoni mwangu dhihaka za mataifa yote,","poem":2}]},{"type":"verse","number":51,"content":[{"text":"dhihaka ambazo kwazo adui zako","poem":1},{"text":"wamenisimanga, Ee Mwenyezi Mungu,","poem":2},{"text":"ambazo kwazo wamesimanga","poem":1},{"text":"kila hatua ya mpakwa mafuta wako.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"Ahimidiwe Mwenyezi Mungu milele!","poem":1},"Amen na Amen."]}],"footnotes":[{"noteId":31,"caller":"+","text":"jina la Misri kwa fumbo","reference":{"chapter":89,"verse":10}},{"noteId":32,"caller":"+","text":"pembe inawakilisha nguvu","reference":{"chapter":89,"verse":17}},{"noteId":33,"caller":"+","text":"Kaburi hapa maana yake ni Kuzimu; kwa Kiebrania ni Sheol.","reference":{"chapter":89,"verse":48}}]},"thisChapterLink":"/api/swh_onmm/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}