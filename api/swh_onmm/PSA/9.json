{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"heading","content":["Shukrani kwa Mwenyezi Mungu kwa ajili ya haki yake"]},{"type":"hebrew_subtitle","content":["Kwa mwimbishaji. Mtindo wa muth-labeni.",{"noteId":2},"Zaburi ya Daudi."]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, nitakutukuza kwa moyo wangu wote,","poem":1},{"text":"nitayasimulia matendo yako yote ya ajabu.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Nitafurahi na kushangilia ndani yako.","poem":1},{"text":"Nitaliimbia sifa jina lako, Ewe Uliye Juu Sana.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Adui zangu wamerudi nyuma,","poem":1},{"text":"wamejikwaa na kuangamia mbele zako.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa maana umetetea haki yangu na msimamo wangu;","poem":1},{"text":"umeketi kwenye kiti chako cha enzi,","poem":2},{"lineBreak":true},{"text":"ukihukumu kwa haki.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Umekemea mataifa na kuwaangamiza waovu;","poem":1},{"text":"umeyafuta majina yao milele na milele.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Uharibifu usiokoma umempata adui,","poem":1},{"text":"umeing’oa miji yao;","poem":2},{"lineBreak":true},{"text":"hata kumbukumbu lao limetoweka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mwenyezi Mungu anatawala milele,","poem":1},{"text":"ameweka kiti chake cha enzi apate kuhukumu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mungu atahukumu ulimwengu kwa haki,","poem":1},{"text":"atatawala mataifa kwa haki.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mwenyezi Mungu ni kimbilio la wanaodhulumiwa,","poem":1},{"text":"ni ngome imara wakati wa shida.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Wote wanaolijua jina lako watakutumaini wewe,","poem":1},{"text":"kwa maana wewe Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"hujawaacha kamwe wanaokutafuta.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwimbieni Mwenyezi Mungu sifa, amefanywa mtawala Sayuni,","poem":1},{"text":"tangazeni miongoni mwa mataifa, yale aliyoyatenda.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Kwa maana yeye anayelipiza kisasi cha damu hukumbuka,","poem":1},{"text":"hapuuzi kilio cha wanaoonewa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mwenyezi Mungu, tazama jinsi walivyo wengi","poem":1},{"text":"adui zangu wanaonitesa!","poem":2},{"lineBreak":true},{"text":"Nihurumie, uniinue kutoka malango ya mauti,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ili niweze kutangaza sifa zako","poem":1},{"text":"katika malango ya Binti Sayuni,","poem":2},{"lineBreak":true},{"text":"na huko niushangilie wokovu wako.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mataifa wameanguka kwenye shimo walilolichimba,","poem":1},{"text":"miguu yao imenaswa kwenye wavu waliouficha.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwenyezi Mungu anajulikana kwa haki yake,","poem":1},{"text":"waovu wamenaswa katika kazi za mikono yao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Waovu wataishia Kuzimu","poem":1},{"noteId":3},{"text":",","poem":1},{"text":"naam, mataifa yote wanaomsahau Mungu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Lakini mhitaji hatasahaulika siku zote,","poem":1},{"text":"wala matumaini ya walioonewa hayatapotea.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Ee Mwenyezi Mungu, inuka, usimwache binadamu ashinde.","poem":1},{"text":"Mataifa na yahukumiwe mbele zako.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ee Mwenyezi Mungu, wapige kwa hofu,","poem":1},{"text":"mataifa na yajue kuwa wao ni watu tu.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"Muth-labeni ni mtajo mmojawapo katika lugha za muziki.","reference":{"chapter":9,"verse":0}},{"noteId":3,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":9,"verse":17}}]},"thisChapterLink":"/api/swh_onmm/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}