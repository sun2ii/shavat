{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"heading","content":["Umilele wa Mwenyezi Mungu na udhaifu wa mwanadamu"]},{"type":"hebrew_subtitle","content":["Maombi ya Musa, mtu wa Mungu."]},{"type":"verse","number":1,"content":[{"text":"Bwana, wewe umekuwa makao yetu","poem":1},{"text":"katika vizazi vyote.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kabla ya kuzaliwa milima","poem":1},{"text":"au hujaumba dunia na ulimwengu,","poem":2},{"lineBreak":true},{"text":"wewe ni Mungu tangu milele hata milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Huwarudisha watu mavumbini,","poem":1},{"text":"ukisema, “Rudini mavumbini, enyi wanadamu.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kwa maana kwako miaka elfu","poem":1},{"text":"ni kama siku moja iliyokwisha pita,","poem":2},{"lineBreak":true},{"text":"au kama kesha la usiku.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Unawatowesha wanadamu katika usingizi wa kifo,","poem":1},{"text":"nao ni kama majani machanga ya asubuhi:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ingawa asubuhi yanachipua,","poem":1},{"text":"ifikapo jioni huwa yamenyauka na kukauka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Tumeangamizwa kwa hasira yako","poem":1},{"text":"na tumetishwa kwa ghadhabu yako.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Umeyaweka maovu yetu mbele yako,","poem":1},{"text":"dhambi zetu za siri katika nuru ya uwepo wako.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tumeishi siku zetu zote chini ya ghadhabu yako,","poem":1},{"text":"tunamaliza miaka yetu kwa kuomboleza.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Siku zetu za kuishi ni miaka sabini,","poem":1},{"text":"au miaka themanini ikiwa tuna nguvu,","poem":2},{"lineBreak":true},{"text":"lakini yote ni ya shida na taabu,","poem":2},{"lineBreak":true},{"text":"nazo zapita haraka, nasi twatoweka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ni nani ajuaye nguvu za hasira yako?","poem":1},{"text":"Kwa maana ghadhabu yako ni kubwa","poem":2},{"lineBreak":true},{"text":"kama hofu tunayopaswa kuwa nayo kwako.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Tufundishe kuzihesabu siku zetu vizuri,","poem":1},{"text":"ili tujipatie moyo wa hekima.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ee Mwenyezi Mungu, uwe na huruma! Utakawia hata lini?","poem":1},{"text":"Wahurumie watumishi wako.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tushibishe asubuhi kwa upendo wako usiokoma,","poem":1},{"text":"ili tuweze kuimba kwa shangwe na kufurahi siku zetu zote.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Utufurahishe kulingana na siku ulizotuadhibu,","poem":1},{"text":"kulingana na miaka tuliyotaabika.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Matendo yako na yaonekane kwa watumishi wako,","poem":1},{"text":"utukufu wako kwa watoto wao.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Wema wa Bwana Mungu wetu uwe juu yetu;","poem":1},{"text":"uzithibitishe kazi za mikono yetu:","poem":2},{"lineBreak":true},{"text":"naam, uzithibitishe kazi za mikono yetu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}