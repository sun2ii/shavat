{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"heading","content":["Mwenyezi Mungu mlinzi wetu"]},{"type":"verse","number":1,"content":[{"text":"Yeye akaaye mahali pa salama pake Yeye Aliye Juu Sana,","poem":1},{"text":"atadumu katika uvuli wake Mwenyezi.","poem":2},{"noteId":34}]},{"type":"verse","number":2,"content":[{"text":"Nitasema kumhusu Mwenyezi Mungu, “Yeye ndiye kimbilio langu na ngome yangu,","poem":1},{"text":"Mungu wangu, ninayemtumaini.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Hakika yeye ataniokoa na mtego wa mwindaji,","poem":1},{"text":"na maradhi ya kuambukiza ya kuua.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Atakufunika kwa manyoya yake,","poem":1},{"text":"chini ya mabawa yake utapata kimbilio,","poem":2},{"lineBreak":true},{"text":"uaminifu wake utakuwa ngao na kinga yako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Hutaogopa vitisho vya usiku,","poem":1},{"text":"wala mshale urukao mchana,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wala maradhi ya kuambukiza","poem":1},{"text":"yanayonyemelea gizani,","poem":2},{"lineBreak":true},{"text":"wala tauni iharibuyo adhuhuri.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ijapo watu elfu wataangukia kando yako,","poem":1},{"text":"kumi elfu mkono wako wa kuume,","poem":2},{"lineBreak":true},{"text":"lakini haitakukaribia wewe.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Utatazama tu kwa macho yako","poem":1},{"text":"na kuona adhabu ya waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ukimfanya Aliye Juu Sana kuwa makao yako;","poem":1},{"text":"naam, Mwenyezi Mungu ambaye ni kimbilio langu;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"basi hakuna madhara yatakayokupata wewe,","poem":1},{"text":"hakuna maafa yatalikaribia hema lako.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwa kuwa atawaagiza malaika wake kwa ajili yako,","poem":1},{"text":"wakulinde katika njia zako zote.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Watakuchukua mikononi mwao,","poem":1},{"text":"ili usijikwae mguu wako kwenye jiwe.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Utawakanyaga simba na nyoka wakali,","poem":1},{"text":"simba mkubwa na nyoka utawaponda kwa miguu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Mwenyezi Mungu asema, “Kwa kuwa ananipenda, nitamwokoa;","poem":1},{"text":"nitamlinda, kwa kuwa analikiri Jina langu.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ataniita, nami nitamjibu;","poem":1},{"text":"nitakuwa pamoja naye katika taabu,","poem":2},{"lineBreak":true},{"text":"nitamwokoa na kumheshimu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kwa siku nyingi nitamshibisha","poem":1},{"text":"na kumwonesha wokovu wangu.”","poem":2}]}],"footnotes":[{"noteId":34,"caller":"+","text":"Mwenyezi hapa ina maana ya Shaddai kwa Kiebrania.","reference":{"chapter":91,"verse":1}}]},"thisChapterLink":"/api/swh_onmm/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}