{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"heading","content":["Wimbo wa kumsifu Mwenyezi Mungu"]},{"type":"hebrew_subtitle","content":["Zaburi. Wimbo wa siku ya Sabato."]},{"type":"verse","number":1,"content":[{"text":"Ni vyema kumshukuru Mwenyezi Mungu","poem":1},{"text":"na kuliimbia jina lako, Ee Uliye Juu Sana,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kuutangaza upendo wako asubuhi,","poem":1},{"text":"na uaminifu wako wakati wa usiku,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"kwa zeze yenye nyuzi kumi","poem":1},{"text":"na kwa sauti ya kinubi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ee Mwenyezi Mungu, kwa kuwa matendo yako yamenifurahisha,","poem":1},{"text":"nitaziimba kwa shangwe kazi za mikono yako.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mwenyezi Mungu, tazama jinsi yalivyo makuu matendo yako,","poem":1},{"text":"tazama jinsi yalivyo ya kina mawazo yako!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mjinga hafahamu,","poem":1},{"text":"mpumbavu haelewi,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ingawa waovu huchipua kama majani","poem":1},{"text":"na wote watendao maovu wanastawi,","poem":2},{"lineBreak":true},{"text":"wataangamizwa milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bali wewe, Ee Mwenyezi Mungu,","poem":1},{"text":"utatukuzwa milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ee Mwenyezi Mungu, hakika adui zako,","poem":1},{"text":"hakika adui zako wataangamia.","poem":2},{"lineBreak":true},{"text":"Wote watendao maovu watatawanyika.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Umeitukuza pembe","poem":1},{"noteId":35},{"text":"yangu kama ile ya nyati dume,","poem":1},{"text":"mafuta mazuri yamemiminwa juu yangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Macho yangu yamewaona adui zangu wakishindwa,","poem":1},{"text":"masikio yangu yamesikia maangamizi ya adui zangu waovu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Wenye haki watastawi kama mtende,","poem":1},{"text":"watakuwa kama mwerezi wa Lebanoni,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"waliopandwa katika nyumba ya Mwenyezi Mungu,","poem":1},{"text":"watastawi katika nyua za Mungu wetu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Wakati wa uzee watakuwa bado wanazaa matunda,","poem":1},{"text":"watakuwa wabichi tena wamejaa nguvu,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"wakitangaza, “Mwenyezi Mungu ni mkamilifu;","poem":1},{"text":"yeye ni Mwamba wangu,","poem":2},{"lineBreak":true},{"text":"na ndani yake hamna uovu.”","poem":2}]}],"footnotes":[{"noteId":35,"caller":"+","text":"pembe inawakilisha nguvu","reference":{"chapter":92,"verse":10}}]},"thisChapterLink":"/api/swh_onmm/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}