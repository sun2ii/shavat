{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"heading","content":["Mwenyezi Mungu ni mkuu"]},{"type":"verse","number":1,"content":[{"text":"Mwenyezi Mungu anatawala, amejivika utukufu;","poem":1},{"text":"Mwenyezi Mungu amejivika utukufu","poem":2},{"lineBreak":true},{"text":"tena amejivika nguvu.","poem":2},{"text":"Dunia imewekwa imara,","poem":1},{"text":"haitaondoshwa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kiti chako cha enzi kimekuwa thabiti tangu zamani;","poem":1},{"text":"wewe umekuwa tangu milele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bahari zimepaza, Ee Mwenyezi Mungu,","poem":1},{"text":"bahari zimepaza sauti zake;","poem":2},{"lineBreak":true},{"text":"bahari zimepaza sauti za mawimbi yake.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Yeye ni mkuu kuliko ngurumo ya maji makuu,","poem":1},{"text":"ni mkuu kuliko mawimbi ya bahari:","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu aishiye juu sana ni mkuu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ee Mwenyezi Mungu, sheria zako ni imara;","poem":1},{"text":"utakatifu umepamba nyumba yako","poem":2},{"lineBreak":true},{"text":"pasipo mwisho.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}