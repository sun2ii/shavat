{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"heading","content":["Mwenyezi Mungu, Mlipiza kisasi kwa ajili ya wenye haki"]},{"type":"verse","number":1,"content":[{"text":"Ee Mwenyezi Mungu, ulipizaye kisasi,","poem":1},{"text":"Ee Mungu ulipizaye kisasi, uangaze sasa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ee Mhukumu wa dunia, inuka,","poem":1},{"text":"uwalipize wenye kiburi kama wanavyostahili.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ee Mwenyezi Mungu, hadi lini waovu,","poem":1},{"text":"hadi lini waovu watashangilia?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wanamimina maneno ya kiburi,","poem":1},{"text":"watenda maovu wote wamejaa majivuno.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ee Mwenyezi Mungu, wanawaponda watu wako;","poem":1},{"text":"wanawatesa walio urithi wako.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wanamchinja mjane na mgeni,","poem":1},{"text":"na kuwaua yatima.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nao husema, “Mwenyezi Mungu haoni,","poem":1},{"text":"Mungu wa Yakobo hafahamu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Sikizeni, enyi wajinga miongoni mwa watu;","poem":1},{"text":"enyi wapumbavu, lini mtakuwa na hekima?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, aliyeweka sikio asisikie?","poem":1},{"text":"Aliyeumba jicho asione?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Je, anayeadhibisha mataifa asiadhibu?","poem":1},{"text":"Je, awafundishaye wanadamu asiwe na maarifa?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu anajua mawazo ya mwanadamu;","poem":1},{"text":"anajua kwamba ni ubatili.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ee Mwenyezi Mungu, heri mtu anayeadhibishwa na wewe,","poem":1},{"text":"mtu unayemfundisha kwa sheria yako,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"unampa utulivu siku za shida,","poem":1},{"text":"hadi shimo litakapokuwa limechimbwa","poem":2},{"lineBreak":true},{"text":"kwa ajili ya mwovu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Kwa kuwa Mwenyezi Mungu hatawakataa watu wake,","poem":1},{"text":"hatauacha urithi wake.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Hukumu itasimamishwa tena kwenye haki,","poem":1},{"text":"wote walio na mioyo minyofu wataifuata.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Ni nani atakayeinuka dhidi ya mwovu kwa ajili yangu?","poem":1},{"text":"Ni nani atakayenikinga dhidi ya watenda maovu?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Kama Mwenyezi Mungu hangenisaidia upesi,","poem":1},{"text":"ningeishi katika kimya cha kifo.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Niliposema, “Mguu wangu unateleza,”","poem":1},{"text":"Ee Mwenyezi Mungu, upendo wako ulinishikilia.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wasiwasi ulipokuwa mwingi ndani yangu,","poem":1},{"text":"faraja yako ilinipa furaha nafsini mwangu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Je, kiti cha utawala wa udhalimu kitajiunga nawe,","poem":1},{"text":"ule utawala uletao taabu kutokana na sheria zake?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Huungana kuwashambulia wenye haki,","poem":1},{"text":"kuwahukumu kufa wasio na hatia.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Lakini Mwenyezi Mungu amekuwa ngome yangu,","poem":1},{"text":"na Mungu wangu amekuwa mwamba ninaoukimbilia.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Yeye atawalipa kwa ajili ya dhambi zao","poem":1},{"text":"na atawaangamiza kwa ajili ya maovu yao;","poem":2},{"lineBreak":true},{"text":"Mwenyezi Mungu, Mungu wetu, atawaangamiza.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}