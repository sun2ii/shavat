{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"PSA","translationId":"swh_onmm","name":"Zaburi","commonName":"Zaburi","title":"Zaburi","order":19,"numberOfChapters":150,"sha256":"d606dfd84ee98e1d924a309e3fcb9ced39394888e0cba2b6211e83d33775b7d7","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swh_onmm/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"heading","content":["Mwenyezi Mungu Mfalme mtakatifu"]},{"type":"verse","number":1,"content":[{"text":"Mwenyezi Mungu anatawala,","poem":1},{"text":"mataifa na yatetemeke;","poem":2},{"text":"anakalia kiti cha enzi katikati ya makerubi,","poem":1},{"text":"dunia na itikisike.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu ni mkuu katika Sayuni;","poem":1},{"text":"ametukuzwa juu ya mataifa yote.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Wanalisifu jina lako ambalo ni kuu na la kuogopwa:","poem":1},{"text":"yeye ni mtakatifu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Mfalme ni mwenye nguvu na hupenda haki,","poem":1},{"text":"wewe umethibitisha adili;","poem":2},{"text":"katika Yakobo umefanya","poem":1},{"text":"yaliyo haki na sawa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mtukuzeni Mwenyezi Mungu, Mungu wetu,","poem":1},{"text":"na mkaabudu katika mahali pa kuwekea miguu yake;","poem":2},{"lineBreak":true},{"text":"yeye ni mtakatifu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Musa na Haruni walikuwa miongoni mwa makuhani wake,","poem":1},{"text":"Samweli alikuwa miongoni mwa walioliitia jina lake;","poem":2},{"text":"walimwita Mwenyezi Mungu,","poem":1},{"text":"naye aliwajibu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Alizungumza nao kutoka nguzo ya wingu;","poem":1},{"text":"walizishika sheria zake na amri alizowapa.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ee Mwenyezi Mungu, Mungu wetu,","poem":1},{"text":"ndiwe uliyewajibu,","poem":2},{"text":"kwa Israeli ulikuwa Mungu mwenye kusamehe,","poem":1},{"text":"ingawa uliadhibu matendo yao mabaya.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mtukuzeni Mwenyezi Mungu, Mungu wetu,","poem":1},{"text":"mwabuduni kwenye mlima wake mtakatifu,","poem":2},{"lineBreak":true},{"text":"kwa maana Mwenyezi Mungu, Mungu wetu, ni mtakatifu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}