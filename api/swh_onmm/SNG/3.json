{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"SNG","translationId":"swh_onmm","name":"Wimbo Ulio Bora","commonName":"Wimbo Ulio Bora","title":"Wimbo Ulio Bora","order":22,"numberOfChapters":8,"sha256":"143039481eaaeeffbfe2069031782c7a42e6113c9bfc173fd7b443fc78ea158e","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swh_onmm/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"Usiku kucha kwenye kitanda changu","poem":1},{"text":"nilimtafuta yule moyo wangu umpendaye;","poem":2},{"lineBreak":true},{"text":"nilimtafuta, lakini sikumpata.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Sasa nitaondoka na kuzunguka mjini,","poem":1},{"text":"katika barabara zake na viwanja;","poem":2},{"text":"nitamtafuta yule moyo wangu umpendaye.","poem":1},{"text":"Kwa hiyo nilimtafuta lakini sikumpata.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Walinzi walinikuta","poem":1},{"text":"walipokuwa wakizunguka mji.","poem":2},{"text":"Nikawauliza, “Je, mmemwona","poem":1},{"text":"yule moyo wangu umpendaye?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kitambo kidogo tu baada ya kuwapita","poem":1},{"text":"nilimpata yule moyo wangu umpendaye.","poem":2},{"text":"Nilimshika na sikumwachia aende","poem":1},{"text":"hadi nilipomleta katika nyumba ya mama yangu,","poem":2},{"lineBreak":true},{"text":"katika chumba cha yule aliyenichukua mimba.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Binti za Yerusalemu, ninawaagiza","poem":1},{"text":"kwa paa na kwa ayala wa shambani:","poem":2},{"text":"Msichochee wala kuamsha mapenzi","poem":1},{"text":"hata yatakapotaka yenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ni nani huyu anayekuja kutoka jangwani","poem":1},{"text":"kama nguzo ya moshi,","poem":2},{"text":"anayenukia manemane na uvumba","poem":1},{"text":"iliyotengenezwa kwa vikolezo vyote","poem":2},{"lineBreak":true},{"text":"vya mfanyabiashara?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tazama! Ni gari la Sulemani","poem":1},{"text":"likisindikizwa na mashujaa sitini,","poem":2},{"lineBreak":true},{"text":"walio wakuu sana wa Israeli,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"wote wamevaa panga,","poem":1},{"text":"wote wazoefu katika vita,","poem":2},{"text":"kila mmoja na upanga wake pajani,","poem":1},{"text":"wamejiandaa kwa ajili ya vitisho vya usiku.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Mfalme Sulemani alijitengenezea gari;","poem":1},{"text":"alilitengeneza kwa mbao kutoka Lebanoni.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nguzo zake alizitengeneza kwa fedha,","poem":1},{"text":"kitako chake kwa dhahabu.","poem":2},{"text":"Kiti chake kilipambwa kwa zambarau,","poem":1},{"text":"gari lake likanakshiwa njumu kwa upendo","poem":2},{"lineBreak":true},{"text":"na binti za Yerusalemu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Tokeni nje, ninyi binti za Sayuni,","poem":1},{"text":"mkamtazame Mfalme Sulemani akiwa amevaa taji,","poem":2},{"text":"taji ambalo mama yake alimvika","poem":1},{"text":"siku ya arusi yake,","poem":2},{"lineBreak":true},{"text":"siku ambayo moyo wake ulishangilia.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}