{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"SNG","translationId":"swh_onmm","name":"Wimbo Ulio Bora","commonName":"Wimbo Ulio Bora","title":"Wimbo Ulio Bora","order":22,"numberOfChapters":8,"sha256":"143039481eaaeeffbfe2069031782c7a42e6113c9bfc173fd7b443fc78ea158e","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swh_onmm/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"Nimekuja kwenye bustani yangu, dada yangu,","poem":1},{"text":"bibi arusi wangu;","poem":2},{"text":"nimekusanya manemane yangu pamoja","poem":1},{"text":"na manukato yangu.","poem":2},{"text":"Nimekula sega langu la asali na asali yangu;","poem":1},{"text":"nimekunywa divai yangu na maziwa yangu.","poem":2},"Rafiki",{"text":"Kuleni, enyi rafiki, mnywe;","poem":1},{"lineBreak":true},{"text":"kunyweni ya kutosha, ee wapenzi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Nililala lakini moyo wangu ulikuwa macho.","poem":1},{"lineBreak":true},{"text":"Sikiliza! Mpenzi wangu anabisha:","poem":1},{"text":"“Nifungulie, dada yangu, mpendwa wangu,","poem":2},{"lineBreak":true},{"text":"hua wangu, usiye na hitilafu.","poem":2},{"text":"Kichwa changu kimeloa umande,","poem":1},{"text":"na nywele zangu manyunyu ya usiku.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nimevua joho langu:","poem":1},{"text":"je, ni lazima nivae tena?","poem":2},{"text":"Nimenawa miguu yangu:","poem":1},{"text":"je, ni lazima niichafue tena?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Mpenzi wangu aliweka mkono wake kwenye tundu la komeo;","poem":1},{"text":"moyo wangu ulianza kugonga kwa ajili yake.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Niliinuka kumfungulia mpenzi wangu,","poem":1},{"text":"mikono yangu ikidondosha manemane,","poem":2},{"text":"vidole vyangu vikitiririka manemane,","poem":1},{"text":"penye vipini vya komeo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nilimfungulia mpenzi wangu,","poem":1},{"text":"lakini mpenzi wangu alishaondoka;","poem":2},{"lineBreak":true},{"text":"alikuwa ameenda zake.","poem":2},{"text":"Moyo wangu ulishuka kwa kuondoka kwake.","poem":1},{"text":"Nilimtafuta lakini sikumpata.","poem":2},{"lineBreak":true},{"text":"Nilimwita lakini hakunijibu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Walinzi walinikuta","poem":1},{"text":"walipokuwa wakifanya zamu za ulinzi mjini.","poem":2},{"text":"Walinipiga, wakanijeruhi,","poem":1},{"text":"wakaninyang’anya joho langu,","poem":2},{"lineBreak":true},{"text":"hao walinzi wa kuta!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Enyi binti za Yerusalemu, ninawaagiza:","poem":1},{"text":"mkimpata mpenzi wangu,","poem":2},{"text":"mtamwambia nini?","poem":1},{"text":"Mwambieni ninazimia kwa mapenzi.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Je, mpenzi wako ni bora kuliko wengine namna gani,","poem":1},{"text":"wewe uliye mzuri kupita wanawake wote?","poem":2},{"text":"Je, mpenzi wako ni mzuri kuliko wengine, namna gani,","poem":1},{"text":"hata unatuagiza hivyo?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mpenzi wangu anang’aa, tena ni mwekundu,","poem":1},{"text":"wa kuvutia miongoni mwa wanaume kumi elfu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kichwa chake ni dhahabu safi kuliko zote,","poem":1},{"text":"nywele zake ni za mawimbi","poem":2},{"lineBreak":true},{"text":"na ni nyeusi kama kunguru.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Macho yake ni kama ya hua","poem":1},{"text":"kandokando ya vijito vya maji,","poem":2},{"text":"aliyeogeshwa kwenye maziwa,","poem":1},{"text":"yaliyopangwa kama vito vya thamani.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mashavu yake ni kama matuta","poem":1},{"text":"ya mimea ya manukato.","poem":2},{"text":"Midomo yake ni kama yungiyungi","poem":1},{"text":"inayodondosha manemane.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Mikono yake ni fimbo za dhahabu","poem":1},{"text":"iliyopambwa kwa krisolitho.","poem":2},{"text":"Mwili wake ni kama pembe ya ndovu iliyong’arishwa","poem":1},{"text":"iliyopambwa na yakuti samawi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Miguu yake ni nguzo za marumaru","poem":1},{"text":"zilizosimikwa katika vitako vya dhahabu safi.","poem":2},{"text":"Sura yake ni kama Lebanoni,","poem":1},{"text":"bora kama miti yake ya mierezi.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kinywa chake chenyewe ni utamu,","poem":1},{"text":"kwa ujumla yeye ni wa kupendeza.","poem":2},{"text":"Huyu ndiye mpenzi wangu, huyu ndiye rafiki yangu,","poem":1},{"text":"ee binti za Yerusalemu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}