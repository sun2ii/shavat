{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"SNG","translationId":"swh_onmm","name":"Wimbo Ulio Bora","commonName":"Wimbo Ulio Bora","title":"Wimbo Ulio Bora","order":22,"numberOfChapters":8,"sha256":"143039481eaaeeffbfe2069031782c7a42e6113c9bfc173fd7b443fc78ea158e","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swh_onmm/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"Ee binti ya mwana wa mfalme,","poem":1},{"text":"tazama jinsi inavyopendeza miguu yako katika viatu!","poem":2},{"text":"Miguu yako yenye madaha ni kama vito vya thamani,","poem":1},{"text":"kazi ya mikono ya fundi stadi.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Kitovu chako ni kama bilauri ya mviringo","poem":1},{"text":"ambayo kamwe haikosi divai iliyochanganywa.","poem":2},{"text":"Kiuno chako ni kichuguu cha ngano","poem":1},{"text":"kilichozungukwa kwa yungiyungi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Matiti yako ni kama wana-paa wawili,","poem":1},{"text":"mapacha wa paa.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Shingo yako ni kama mnara wa pembe ya ndovu.","poem":1},{"text":"Macho yako ni vidimbwi vya Heshboni","poem":2},{"lineBreak":true},{"text":"karibu na lango la Beth-Rabi.","poem":2},{"text":"Pua yako ni kama mnara wa Lebanoni","poem":1},{"text":"ukitazama kuelekea Dameski.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kichwa chako kinakuvika taji kama Mlima Karmeli.","poem":1},{"text":"Nywele zako ni kama zulia la urujuani;","poem":2},{"lineBreak":true},{"text":"mfalme ametekwa na mashungi yake.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tazama jinsi ulivyo mzuri na unavyopendeza,","poem":1},{"text":"ee pendo, kwa uzuri wako!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Umbo lako ni kama la mtende,","poem":1},{"text":"nayo matiti yako kama vishada vya matunda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nilisema, “Nitakwea mtende,","poem":1},{"text":"nami nitayashika matunda yake.”","poem":2},{"text":"Matiti yako na yawe kama vishada vya mzabibu,","poem":1},{"text":"harufu nzuri ya pumzi yako kama matofaa,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"na kinywa chako kama divai","poem":1},{"text":"bora kuliko zote.","poem":2},"Mpendwa",{"text":"Divai na iende moja kwa moja hadi kwa mpenzi wangu,","poem":1},{"text":"ikitiririka polepole juu ya midomo na meno.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mimi ni mali ya mpenzi wangu,","poem":1},{"text":"nayo shauku yake ni juu yangu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Njoo, mpenzi wangu, twende mashambani,","poem":1},{"text":"twende tukalale huko vijijini.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Hebu na twende mapema","poem":1},{"text":"katika mashamba ya mizabibu","poem":2},{"lineBreak":true},{"text":"tuone kama mizabibu imechipua,","poem":2},{"text":"kama maua yake yamefunguka,","poem":1},{"text":"na kama mikomamanga imetoa maua:","poem":2},{"lineBreak":true},{"text":"huko nitakupa penzi langu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mitunguja hutoa harufu zake nzuri,","poem":1},{"text":"kwenye milango yetu kuna matunda mazuri,","poem":2},{"text":"mapya na ya zamani,","poem":1},{"text":"ambayo nimekuhifadhia wewe,","poem":2},{"lineBreak":true},{"text":"mpenzi wangu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}