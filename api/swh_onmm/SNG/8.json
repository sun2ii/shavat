{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"SNG","translationId":"swh_onmm","name":"Wimbo Ulio Bora","commonName":"Wimbo Ulio Bora","title":"Wimbo Ulio Bora","order":22,"numberOfChapters":8,"sha256":"143039481eaaeeffbfe2069031782c7a42e6113c9bfc173fd7b443fc78ea158e","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/swh_onmm/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"Laiti ungekuwa kwangu kama ndugu wa kiume,","poem":1},{"text":"ambaye aliyanyonya matiti ya mama yangu!","poem":2},{"text":"Kisha, kama ningekukuta huko nje,","poem":1},{"text":"ningekubusu,","poem":2},{"lineBreak":true},{"text":"wala hakuna mtu yeyote angenidharau.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Ningekuongoza na kukuleta","poem":1},{"text":"katika nyumba ya mama yangu,","poem":2},{"lineBreak":true},{"text":"yeye ambaye amenifundisha.","poem":2},{"text":"Ningekupa divai iliyokolezwa unywe,","poem":1},{"text":"asali ya maua ya mikomamanga yangu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mkono wake wa kushoto uko chini ya kichwa changu,","poem":1},{"text":"na mkono wake wa kuume unanikumbatia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Binti za Yerusalemu, ninawaagiza:","poem":1},{"text":"msichochee wala kuamsha mapenzi","poem":2},{"lineBreak":true},{"text":"hata yatakapotaka yenyewe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ni nani huyu anayekuja kutoka nyikani","poem":1},{"text":"akimwegemea mpenzi wake?","poem":2},"Mpendwa",{"text":"Nilikuamsha chini ya mtofaa,","poem":1},{"text":"huko mama yako alipotunga mimba yako,","poem":2},{"lineBreak":true},{"text":"huko yeye alipata uchungu akakuzaa.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nitie kama muhuri moyoni mwako,","poem":1},{"text":"kama muhuri kwenye mkono wako;","poem":2},{"text":"kwa maana upendo una nguvu kama mauti,","poem":1},{"text":"wivu wake ni mkatili kama Kuzimu","poem":2},{"noteId":1},{"text":".","poem":2},{"text":"Unachoma kama mwali wa moto,","poem":1},{"text":"kama mwali mkubwa wa moto wa Mwenyezi Mungu hasa.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Maji mengi hayawezi kuuzimisha upendo,","poem":1},{"text":"mito haiwezi kuugharikisha.","poem":2},{"text":"Kama mtu angetoa mali yote ya nyumbani mwake","poem":1},{"text":"kwa ajili ya upendo,","poem":2},{"lineBreak":true},{"text":"angedharauliwa kabisa.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Tunaye dada mdogo,","poem":1},{"text":"matiti yake hayajakua bado.","poem":2},{"text":"Tutafanya nini kwa ajili ya dada yetu","poem":1},{"text":"wakati atakapokuja kuposwa?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Kama yeye ni ukuta,","poem":1},{"text":"tutajenga minara ya fedha juu yake.","poem":2},{"text":"Na kama yeye ni mlango,","poem":1},{"text":"tutamzungushia mbao za mwerezi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Mimi ni ukuta,","poem":1},{"text":"nayo matiti yangu ni kama minara.","poem":2},{"text":"Ndivyo ambavyo nimekuwa machoni pake","poem":1},{"text":"kama yule anayeleta utoshelevu.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Sulemani alikuwa na shamba la mizabibu huko Baal-Hamoni;","poem":1},{"text":"alikodisha shamba lake la mizabibu kwa wapangaji.","poem":2},{"text":"Kila mmoja angeleta kwa ajili ya matunda yake","poem":1},{"text":"shekeli elfu moja","poem":2},{"noteId":2},{"text":"za fedha.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini shamba langu la mizabibu","poem":1},{"text":"ambalo ni langu mwenyewe","poem":2},{"lineBreak":true},{"text":"ni langu kutoa;","poem":2},{"text":"hizo shekeli elfu moja ni kwa ajili yako, ee Sulemani,","poem":1},{"text":"na shekeli mia mbili","poem":2},{"noteId":3},{"text":"ni kwa ajili","poem":2},{"lineBreak":true},{"text":"ya wale wanaotunza matunda yake.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wewe ukaaye bustanini","poem":1},{"text":"pamoja na rafiki mliohudhuria,","poem":2},{"lineBreak":true},{"text":"hebu nisikie sauti yako!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Njoo, mpenzi wangu,","poem":1},{"text":"uwe kama paa","poem":2},{"text":"au kama ayala mchanga","poem":1},{"text":"juu ya milima iliyojaa manukato.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"Kuzimu kwa Kiebrania ni Sheol, yaani Shimo lisilo na mwisho.","reference":{"chapter":8,"verse":6}},{"noteId":2,"caller":"+","text":"Shekeli 1,000 ni kama kilo 11.5.","reference":{"chapter":8,"verse":11}},{"noteId":3,"caller":"+","text":"Shekeli 200 ni kama kilo 2.3.","reference":{"chapter":8,"verse":12}}]},"thisChapterLink":"/api/swh_onmm/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}