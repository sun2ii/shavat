poem":2},{"lineBreak":true},{"text":"atalichunga kundi lake,","poem":2},{"lineBreak":true},{"text":"nyumba ya Yuda,","poem":2},{"text":"naye atawafanya kama farasi","poem":1},{"text":"mwenye kiburi akiwa vitani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kutoka Yuda litatokea Jiwe la pembeni,","poem":1},{"text":"kutoka kwake vitatoka vigingi vya hema,","poem":2},{"lineBreak":true},{"text":"kutoka kwake utatoka upinde wa vita,","poem":2},{"lineBreak":true},{"text":"kutoka kwake atatoka kila mtawala.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Kwa pamoja watakuwa kama mashujaa","poem":1},{"text":"wanaokanyaga barabara za matope","poem":2},{"lineBreak":true},{"text":"wakati wa vita.","poem":2},{"text":"Kwa sababu Mwenyezi Mungu yu pamoja nao,","poem":1},{"text":"watapigana na kuwashinda wapanda farasi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Nitaiimarisha nyumba ya Yuda","poem":1},{"text":"na kuiokoa nyumba ya Yusufu.","poem":2},{"text":"Nitawarejesha kwa sababu","poem":1},{"text":"nina huruma juu yao.","poem":2},{"text":"Watakuwa kama watu ambao","poem":1},{"text":"sijawahi kuwakataa","poem":2},{"text":"kwa sababu mimi ndimi Mwenyezi Mungu, Mungu wao,","poem":1},{"text":"nami nitawajibu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Waefraimu watakuwa kama mashujaa,","poem":1},{"text":"mioyo yao itafurahi kana kwamba ni kwa divai.","poem":2},{"text":"Watoto wao wataona na kufurahi,","poem":1},{"text":"mioyo yao itashangilia katika Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nitawaashiria na kuwakusanya ndani.","poem":1},{"text":"Hakika nitawakomboa,","poem":2},{"text":"nao watakuwa wengi","poem":1},{"text":"kama walivyokuwa mwanzoni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ijapokuwa niliwatawanya miongoni mwa mataifa,","poem":1},{"text":"hata hivyo wakiwa katika nchi za mbali","poem":2},{"lineBreak":true},{"text":"watanikumbuka mimi.","poem":2},{"text":"Wao na watoto wao watanusurika katika hatari","poem":1},{"text":"nao watarudi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nitawarudisha kutoka Misri","poem":1},{"text":"na kuwakusanya toka Ashuru.","poem":2},{"text":"Nitawaleta katika nchi ya Gileadi na Lebanoni,","poem":1},{"text":"na hapo hapatakuwa na nafasi ya kuwatosha.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Watapita katika bahari ya mateso;","poem":1},{"text":"bahari iliyochafuka itatulizwa","poem":2},{"lineBreak":true},{"text":"na vilindi vyote vya Mto Naili vitakauka.","poem":2},{"text":"Kiburi cha Ashuru kitashushwa,","poem":1},{"text":"nayo fimbo ya utawala ya Misri itatoweka.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nitawaimarisha katika Mwenyezi Mungu,","poem":1},{"text":"na katika jina lake watatembea,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}