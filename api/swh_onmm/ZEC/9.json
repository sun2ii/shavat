{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ZEC","translationId":"swh_onmm","name":"Zekaria","commonName":"Zekaria","title":"Zekaria","order":38,"numberOfChapters":14,"sha256":"4319575b0cb2d06b616d84ae08fafe86611bc5f0ef1245df1d338eace66bc6b8","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/swh_onmm/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["Hukumu juu ya adui za Israeli"]},{"type":"verse","number":1,"content":["Neno la unabii:",{"text":"Neno la Mwenyezi Mungu liko kinyume na nchi ya Hadraki","poem":1},{"text":"na Dameski itakuwa mahali pa kupumzika,","poem":2},{"text":"kwa kuwa macho ya watu na ya makabila yote ya Israeli","poem":1},{"text":"yako kwa Mwenyezi Mungu;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"pia juu ya Hamathi inayopakana nayo,","poem":1},{"text":"juu ya Tiro na Sidoni,","poem":2},{"lineBreak":true},{"text":"ingawa wana ujuzi mwingi sana.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tiro amejijengea ngome imara,","poem":1},{"text":"amelundika fedha kama mavumbi,","poem":2},{"lineBreak":true},{"text":"na dhahabu kama taka za mitaani.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Lakini Bwana atamwondolea mali yake","poem":1},{"text":"na kuuangamiza uwezo wake wa baharini,","poem":2},{"lineBreak":true},{"text":"naye atateketezwa kwa moto.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ashkeloni ataona hili na kuogopa;","poem":1},{"text":"Gaza atagaagaa kwa maumivu makali,","poem":2},{"text":"pia Ekroni, kwa sababu","poem":1},{"text":"matumaini yake yatanyauka.","poem":2},{"text":"Gaza atampoteza mfalme wake","poem":1},{"text":"na Ashkeloni ataachwa pweke.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Wageni watakalia mji wa Ashdodi,","poem":1},{"text":"nami nitakatilia mbali kiburi cha Wafilisti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nitaondoa damu vinywani mwao,","poem":1},{"text":"chakula kile walichokatazwa kati ya meno yao.","poem":2},{"text":"Mabaki yao yatakuwa mali ya Mungu wetu,","poem":1},{"text":"nao watakuwa viongozi katika Yuda,","poem":2},{"lineBreak":true},{"text":"naye Ekroni atakuwa kama Wayebusi.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lakini nitailinda nyumba yangu","poem":1},{"text":"dhidi ya majeshi ya wanyang’anyi.","poem":2},{"text":"Kamwe mdhalimu hatashambulia watu wangu tena,","poem":1},{"text":"kwa maana sasa ninawachunga.","poem":2}]},{"type":"heading","content":["Kuja kwa Mfalme wa Sayuni"]},{"type":"verse","number":9,"content":[{"text":"Shangilia sana, ee Binti Sayuni!","poem":1},{"text":"Piga kelele, Binti Yerusalemu!","poem":2},{"text":"Tazama, Mfalme wako anakuja kwako,","poem":1},{"text":"ni mwenye haki, naye ana wokovu,","poem":2},{"lineBreak":true},{"text":"ni mpole, naye amepanda punda,","poem":2},{"lineBreak":true},{"text":"mwana-punda, mtoto wa punda.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nitaondoa magari ya vita kutoka Efraimu","poem":1},{"text":"na farasi wa vita kutoka Yerusalemu,","poem":2},{"lineBreak":true},{"text":"nao upinde wa vita utavunjwa.","poem":2},{"text":"Atatangaza amani kwa mataifa.","poem":1},{"text":"Utawala wake utaenea kutoka bahari hadi bahari,","poem":2},{"lineBreak":true},{"text":"na kutoka Mto","poem":2},{"noteId":4},{"text":"hadi mwisho wa dunia.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwako wewe, kwa sababu ya damu ya agano langu nawe,","poem":1},{"text":"nitawaacha huru wafungwa wako","poem":2},{"lineBreak":true},{"text":"watoke kwenye shimo lisilo na maji.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Rudieni ngome yenu, enyi wafungwa wa tumaini;","poem":1},{"text":"hata sasa ninatangaza kwamba","poem":2},{"lineBreak":true},{"text":"nitawarejesheeni maradufu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Nitampinda Yuda kama nipindavyo upinde wangu,","poem":1},{"text":"nitamfanya Efraimu mshale wangu.","poem":2},{"text":"Nitawainua wana wako, ee Sayuni,","poem":1},{"text":"dhidi ya wana wako, ee Uyunani,","poem":2},{"lineBreak":true},{"text":"na kukufanya kama upanga wa shujaa wa vita.","poem":2}]},{"type":"heading","content":["Mwenyezi Mungu atatokea"]},{"type":"verse","number":14,"content":[{"text":"Kisha Mwenyezi Mungu atawatokea;","poem":1},{"text":"mshale wake utamulika kama radi.","poem":2},{"text":"Bwana Mungu Mwenyezi atapiga tarumbeta,","poem":1},{"text":"naye atatembea katika tufani za kusini,","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"na Mwenyezi Mungu, Mungu wa majeshi ya mbinguni atawalinda.","poem":2},{"text":"Wataangamiza na kushinda","poem":1},{"text":"kwa mawe ya kutupa kwa kombeo.","poem":2},{"text":"Watakunywa na kunguruma kama waliolewa mvinyo;","poem":1},{"text":"watajaa kama bakuli linalotumika kunyunyizia","poem":2},{"lineBreak":true},{"text":"kwenye pembe za madhabahu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mwenyezi Mungu, Mungu wao, atawaokoa siku hiyo","poem":1},{"text":"kama kundi la watu wake.","poem":2},{"text":"Watang’ara katika nchi yake","poem":1},{"text":"kama vito vya thamani kwenye taji.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Jinsi gani watavutia na kuwa wazuri!","poem":1},{"text":"Nafaka itawastawisha vijana wanaume,","poem":2},{"lineBreak":true},{"text":"nayo divai mpya vijana wanawake.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"yaani Mto Frati","reference":{"chapter":9,"verse":10}}]},"thisChapterLink":"/api/swh_onmm/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}