{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ZEP","translationId":"swh_onmm","name":"Sefania","commonName":"Sefania","title":"Sefania","order":36,"numberOfChapters":3,"sha256":"635ac1923228b7b9d79aca2fbcf812e597a1d5ff557333f785633ab3c5ff5525","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_onmm/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Neno la Mwenyezi Mungu lililomjia Sefania mwana wa Kushi, mwana wa Gedalia, mwana wa Amaria, mwana wa Hezekia, wakati wa utawala wa Yosia mwana wa Amoni mfalme wa Yuda:"]},{"type":"line_break"},{"type":"heading","content":["Onyo la maangamizi yanayokuja"]},{"type":"verse","number":2,"content":[{"text":"Mwenyezi Mungu asema,","poem":1},{"text":"“Nitafagia kila kitu","poem":2},{"lineBreak":true},{"text":"kutoka uso wa dunia.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nitafagilia mbali watu na wanyama;","poem":1},{"text":"nitafagilia mbali ndege wa angani","poem":2},{"lineBreak":true},{"text":"na samaki wa baharini.","poem":2},{"text":"Wafanyao maovu watapata tu kokoto,","poem":1},{"text":"nami nitamkatilia mbali mwanadamu atoke katika dunia,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]},{"type":"heading","content":["Dhidi ya Yuda"]},{"type":"verse","number":4,"content":[{"text":"“Nitaiadhibu Yuda","poem":1},{"text":"na wote wanaoishi Yerusalemu.","poem":2},{"text":"Kutoka mahali hapa nitakatilia mbali","poem":1},{"text":"kila mabaki ya Baali,","poem":2},{"text":"majina ya wapagani na makuhani","poem":1},{"text":"waabuduo sanamu:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"wale ambao husujudu juu ya mapaa","poem":1},{"text":"kuabudu jeshi la vitu vya angani,","poem":2},{"text":"wale ambao husujudu na kuapa kwa Mwenyezi Mungu","poem":1},{"text":"na ambao pia huapa kwa Malkamu,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"wale wanaoacha kumfuata Mwenyezi Mungu,","poem":1},{"text":"wala hawamtafuti Mwenyezi Mungu","poem":2},{"lineBreak":true},{"text":"wala kutaka shauri lake.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nyamazeni mbele za Bwana Mungu Mwenyezi,","poem":1},{"text":"kwa maana siku ya Mwenyezi Mungu iko karibu.","poem":2},{"text":"Mwenyezi Mungu ameandaa dhabihu,","poem":1},{"text":"amewaweka wakfu wale aliowaalika.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Katika siku ya dhabihu ya Mwenyezi Mungu","poem":1},{"text":"nitawaadhibu wakuu","poem":2},{"lineBreak":true},{"text":"na wana wa mfalme","poem":2},{"text":"na wale wote wanaovaa","poem":1},{"text":"nguo za kigeni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Katika siku hiyo nitaadhibu wote ambao","poem":1},{"text":"hukwepa kukanyaga kizingiti,","poem":2},{"text":"ambao hujaza hekalu la miungu yao","poem":1},{"text":"kwa dhuluma na udanganyifu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mwenyezi Mungu asema, “Katika siku hiyo","poem":1},{"text":"kilio kitapanda juu kutoka lango la Samaki,","poem":2},{"lineBreak":true},{"text":"maombolezo kutoka mtaa wa pili,","poem":2},{"lineBreak":true},{"text":"na mshindo mkubwa kutoka vilimani.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Ombolezeni, ninyi mnaoishi katika eneo la sokoni;","poem":1},{"text":"wafanyabiashara wenu wote wameangamizwa,","poem":2},{"text":"wote ambao wanafanya biashara ya fedha","poem":1},{"text":"wataangamizwa.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Wakati huo nitaupekua mji wa Yerusalemu kwa taa,","poem":1},{"text":"na kuwaadhibu wale ambao","poem":2},{"lineBreak":true},{"text":"wanakaa katika hali ya kuridhika,","poem":2},{"text":"ambao ni kama divai","poem":1},{"text":"iliyobaki kwenye machicha,","poem":2},{"text":"ambao hudhani, ‘Mwenyezi Mungu hatafanya lolote,","poem":1},{"text":"jema au baya.’","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Utajiri wao utatekwa nyara,","poem":1},{"text":"nyumba zao zitabomolewa.","poem":2},{"text":"Watajenga nyumba,","poem":1},{"text":"lakini hawataishi ndani yake;","poem":2},{"text":"watapanda mizabibu","poem":1},{"text":"lakini hawatakunywa divai yake.","poem":2}]},{"type":"heading","content":["Siku kubwa ya Mwenyezi Mungu"]},{"type":"verse","number":14,"content":[{"text":"“Siku kubwa ya Mwenyezi Mungu iko karibu:","poem":1},{"text":"iko karibu na inakuja haraka.","poem":2},{"text":"Sikilizeni! Kilio katika siku ya Mwenyezi Mungu","poem":1},{"text":"kitakuwa chungu.","poem":2},{"lineBreak":true},{"text":"Shujaa atapiga ukelele wa vita huko.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Siku ile ni siku ya ghadhabu,","poem":1},{"text":"siku ya fadhaa na dhiki,","poem":2},{"lineBreak":true},{"text":"siku ya uharibifu na ukiwa,","poem":2},{"lineBreak":true},{"text":"siku ya giza na utusitusi,","poem":2},{"lineBreak":true},{"text":"siku ya mawingu na giza nene,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"siku ya tarumbeta na kelele za vita","poem":1},{"text":"dhidi ya miji yenye ngome,","poem":2},{"lineBreak":true},{"text":"na dhidi ya minara mirefu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Nitawaletea watu dhiki,","poem":1},{"text":"nao watatembea kama vipofu,","poem":2},{"text":"kwa sababu wametenda dhambi","poem":1},{"text":"dhidi ya Mwenyezi Mungu.","poem":2},{"text":"Damu yao itamwagwa kama vumbi","poem":1},{"text":"na matumbo yao kama kinyesi.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Fedha yao wala dhahabu yao","poem":1},{"text":"hazitaweza kuwaokoa","poem":2},{"lineBreak":true},{"text":"katika siku hiyo ya ghadhabu ya Mwenyezi Mungu.","poem":2},{"text":"Katika moto wa wivu wake","poem":1},{"text":"dunia yote itateketezwa,","poem":2},{"text":"kwa maana ghafula ataleta mwisho","poem":1},{"text":"wa wote wanaoishi duniani.”","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}