{"translation":{"id":"swh_onmm","name":"Biblica® Toleo Wazi Neno: Maandiko Matakatifu","website":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swhonmm","licenseNotes":null,"shortName":"ONMM","englishName":"Swahili ONMM","language":"swh","textDirection":"ltr","sha256":"79b98cd12abf5b9807f0cee8748a0627b1ac785dd300fbfe4f336647c65fada8","availableFormats":["json"],"listOfBooksApiLink":"/api/swh_onmm/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"Kiswahili","languageEnglishName":"Swahili"},"book":{"id":"ZEP","translationId":"swh_onmm","name":"Sefania","commonName":"Sefania","title":"Sefania","order":36,"numberOfChapters":3,"sha256":"635ac1923228b7b9d79aca2fbcf812e597a1d5ff557333f785633ab3c5ff5525","firstChapterNumber":1,"firstChapterApiLink":"/api/swh_onmm/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/swh_onmm/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["Hukumu dhidi ya mataifa"]},{"type":"heading","content":["Dhidi ya Yuda"]},{"type":"verse","number":1,"content":[{"text":"Kusanyikeni pamoja, kusanyikeni pamoja,","poem":1},{"text":"enyi taifa lisilo na aibu,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"kabla wakati ulioamriwa haujafika","poem":1},{"text":"na siku ile inayopeperusha kama makapi,","poem":2},{"text":"kabla hasira kali ya Mwenyezi Mungu haijaja juu yenu,","poem":1},{"text":"kabla siku ya ghadhabu ya Mwenyezi Mungu","poem":2},{"lineBreak":true},{"text":"haijaja juu yenu.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mtafuteni Mwenyezi Mungu, enyi nyote wanyenyekevu wa nchi,","poem":1},{"text":"ninyi ambao hufanya lile analoamuru.","poem":2},{"text":"Tafuteni haki, tafuteni unyenyekevu;","poem":1},{"text":"labda mtahifadhiwa","poem":2},{"lineBreak":true},{"text":"siku ya hasira ya Mwenyezi Mungu.","poem":2}]},{"type":"heading","content":["Dhidi ya Ufilisti"]},{"type":"verse","number":4,"content":[{"text":"Gaza utaachwa","poem":1},{"text":"na Ashkeloni utaachwa magofu.","poem":2},{"text":"Wakati wa adhuhuri Ashdodi utaachwa mtupu,","poem":1},{"text":"na Ekroni utang’olewa.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ole wenu ninyi ambao mnaishi kando ya bahari,","poem":1},{"text":"enyi Wakerethi;","poem":2},{"text":"neno la Mwenyezi Mungu liko dhidi yenu,","poem":1},{"text":"ee Kanaani, nchi ya Wafilisti.","poem":2},{"text":"“Mimi nitawaangamiza,","poem":1},{"text":"na hakuna atakayebaki.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Nchi iliyo karibu na bahari itakuwa malisho","poem":1},{"text":"yenye visima vya wachungaji,","poem":2},{"lineBreak":true},{"text":"na mazizi ya kondoo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Itakuwa mali ya mabaki ya nyumba ya Yuda,","poem":1},{"text":"hapo watapata malisho.","poem":2},{"text":"Wakati wa jioni watajilaza chini","poem":1},{"text":"katika nyumba za Ashkeloni.","poem":2},{"text":"Mwenyezi Mungu, Mungu wao, atawatunza,","poem":1},{"text":"naye atawarudishia wafungwa wao.","poem":2}]},{"type":"heading","content":["Dhidi ya Moabu na Amoni"]},{"type":"verse","number":8,"content":[{"text":"“Nimeyasikia matukano ya Moabu","poem":1},{"text":"nazo dhihaka za Waamoni,","poem":2},{"text":"ambao waliwatukana watu wangu","poem":1},{"text":"na kutoa vitisho dhidi ya nchi yao.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Hakika, kama niishivyo,”","poem":1},{"text":"asema Mwenyezi Mungu, Mungu wa majeshi ya mbinguni,","poem":2},{"lineBreak":true},{"text":"Mungu wa Israeli,","poem":2},{"text":"“hakika Moabu itakuwa kama Sodoma,","poem":1},{"text":"Waamoni kama Gomora:","poem":2},{"text":"mahali pa magugu na mashimo ya chumvi,","poem":1},{"text":"nchi ya ukiwa milele.","poem":2},{"text":"Mabaki ya watu wangu watawateka nyara;","poem":1},{"text":"mabaki ya taifa langu watarithi nchi yao.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Hiki ndicho watarudishiwa kwa ajili ya kiburi chao,","poem":1},{"text":"kwa kutukana na kudhihaki","poem":2},{"lineBreak":true},{"text":"watu wa Mwenyezi Mungu,","poem":2},{"lineBreak":true},{"text":"Mungu wa majeshi ya mbinguni.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mwenyezi Mungu atakuwa wa kuhofisha kwao","poem":1},{"text":"atakapoangamiza miungu yote ya nchi.","poem":2},{"text":"Mataifa katika kila pwani yatamwabudu,","poem":1},{"text":"kila moja katika nchi yake.","poem":2}]},{"type":"heading","content":["Dhidi ya Kushi"]},{"type":"verse","number":12,"content":[{"text":"“Ninyi pia, ee Wakushi,","poem":1},{"text":"mtauawa kwa upanga wangu.”","poem":2}]},{"type":"heading","content":["Dhidi ya Ashuru"]},{"type":"verse","number":13,"content":[{"text":"Mungu atanyoosha mkono wake dhidi ya kaskazini","poem":1},{"text":"na kuangamiza Waashuru,","poem":2},{"text":"akiiacha Ninawi ukiwa","poem":1},{"text":"na pakame kama jangwa.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Makundi ya kondoo na ng’ombe yatajilaza pale,","poem":1},{"text":"viumbe vya kila aina.","poem":2},{"text":"Bundi wa jangwani na bundi waliao kwa sauti nyembamba","poem":1},{"text":"wataishi juu ya nguzo zake.","poem":2},{"text":"Mwangwi wa kuita kwao utapita madirishani,","poem":1},{"text":"kifusi kitakuwa milangoni,","poem":2},{"lineBreak":true},{"text":"boriti za mwerezi zitaachwa wazi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Huu ndio mji uliotukuka na kuishi kwa furaha","poem":1},{"text":"wakijisikia salama.","poem":2},{"text":"Ulisema moyoni mwako,","poem":1},{"text":"“Mimi ndimi, na wala hapana mwingine ila mimi.”","poem":2},{"text":"Jinsi gani umekuwa gofu,","poem":1},{"text":"mahali pa kulala wanyama pori!","poem":2},{"text":"Wote wanaopita kando yake wanauzomea","poem":1},{"text":"na kutikisa mkono kwa dharau.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}