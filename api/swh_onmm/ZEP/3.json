ext":"Mwenyezi Mungu aliye ndani yake ni mwenye haki,","poem":1},{"text":"hafanyi kosa.","poem":2},{"text":"Asubuhi kwa asubuhi hutoa haki yake,","poem":1},{"text":"kila kukipambazuka huitimiza,","poem":2},{"lineBreak":true},{"text":"bali mtu dhalimu hana aibu.","poem":2}]},{"type":"heading","content":["Yerusalemu yakataa kutubu"]},{"type":"verse","number":6,"content":[{"text":"“Nimeyaangamiza mataifa,","poem":1},{"text":"ngome zao zimebomolewa.","poem":2},{"text":"Nimeziacha barabara ukiwa,","poem":1},{"text":"hakuna anayepita humo.","poem":2},{"text":"Miji yao imeharibiwa;","poem":1},{"text":"hakuna mmoja atakayeachwa:","poem":2},{"lineBreak":true},{"text":"hakuna hata mmoja.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Niliuambia huo mji,","poem":1},{"text":"‘Hakika utaniogopa na kukubali maonyo!’","poem":2},{"text":"Ndipo makao yake hayatafutiliwa mbali,","poem":1},{"text":"wala adhabu zangu zote hazitakuja juu yake.","poem":2},{"text":"Lakini walikuwa bado na shauku","poem":1},{"text":"kutenda kwa upotovu katika yote waliyofanya.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mwenyezi Mungu anasema,","poem":1},{"text":"“Kwa hiyo ningojee mimi,","poem":2},{"lineBreak":true},{"text":"siku nitakayosimama kuteka nyara.","poem":2},{"text":"Nimeamua kukusanya mataifa,","poem":1},{"text":"kukusanya falme","poem":2},{"text":"na kumimina ghadhabu yangu juu yao,","poem":1},{"text":"hasira yangu kali yote.","poem":2},{"text":"Dunia yote itateketezwa","poem":1},{"text":"kwa moto wa hasira yangu yenye wivu.","poem":2}]},{"type":"heading","content":["Mabaki ya Israeli kurejeshwa"]},{"type":"verse","number":9,"content":[{"text":"“Ndipo nitatakasa midomo ya mataifa,","poem":1},{"text":"kwamba wote waweze kuliitia jina la Mwenyezi Mungu","poem":2},{"lineBreak":true},{"text":"na kumtumikia kwa pamoja.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kutoka ng’ambo ya mito ya Kushi","poem":1},{"text":"watu wangu wanaoniabudu,","poem":2},{"text":"watu wangu waliotawanyika,","poem":1},{"text":"wataniletea sadaka.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Siku hiyo hutaaibishwa","poem":1},{"text":"kwa ajili ya makosa yote uliyonitendea,","poem":2},{"text":"kwa sababu nitawaondoa kutoka mji huu","poem":1},{"text":"wale wote wanaoshangilia","poem":2},{"lineBreak":true},{"text":"katika kiburi chao.","poem":2},{"text":"Kamwe hutajivuna tena","poem":1},{"text":"katika kilima changu kitakatifu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Lakini nitakuachia ndani yako","poem":1},{"text":"wapole na wanyenyekevu,","poem":2},{"lineBreak":true},{"text":"ambao wanatumaini jina la Mwenyezi Mungu.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Mabaki ya Israeli hayatafanya kosa;","poem":1},{"text":"hawatasema uongo,","poem":2},{"text":"wala udanganyifu hautakuwa","poem":1},{"text":"katika vinywa vyao.","poem":2},{"text":"Watakula na kulala","poem":1},{"text":"wala hakuna yeyote","poem":2},{"lineBreak":true},{"text":"atakayewaogopesha.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Imba, ee Binti Sayuni;","poem":1},{"text":"paza sauti, ee Israeli!","poem":2},{"text":"Furahi na kushangilia kwa moyo wako wote,","poem":1},{"text":"ee Binti Yerusalemu!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mwenyezi Mungu amekuondolea adhabu yako,","poem":1},{"text":"amewarudisha nyuma adui zako.","poem":2},{"text":"Mwenyezi Mungu, Mfalme wa Israeli, yu pamoja nawe;","poem":1},{"text":"kamwe hutaogopa tena madhara yoyote.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Katika siku hiyo watauambia Yerusalemu,","poem":1},{"text":"“Usiogope, ee Sayuni;","poem":2},{"lineBreak":true},{"text":"usiiache mikono yako ilegee.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mwenyezi Mungu, Mungu wako, yu pamoja nawe,","poem":1},{"text":"yeye ni Shujaa mwenye nguvu anayeokoa.","poem":2},{"text":"Atakufurahia kwa furaha kubwa,","poem":1},{"text":"atakutuliza kwa pendo lake,","poem":2},{"lineBreak":true},{"text":"atakufurahia kwa kuimba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“Huzuni katika sikukuu zilizoamriwa","poem":1},{"text":"nitaziondoa kwenu;","poem":2},{"lineBreak":true},{"text":"hizo ni mzigo na fedheha kwenu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Wakati huo nitawaadhibu","poem":1},{"text":"wote waliokudhulumu;","poem":2},{"text":"nitaokoa vilema na kukusanya","poem":1},{"text":"wale waliotawanywa.","poem":2},{"text":"Nitawapa sifa na heshima","poem":1},{"text":"katika kila nchi ambayo waliaibishwa.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Wakati huo nitawakusanya;","poem":1},{"text":"wakati huo nitawaleta nyumbani.","poem":2},{"text":"Nitawapa sifa na heshima","poem":1},{"text":"miongoni mwa mataifa yote ya dunia","poem":2},{"text":"wakati nitakapowarudishia mateka yenu","poem":1},{"text":"mbele ya macho yenu hasa,”","poem":2},{"lineBreak":true},{"text":"asema Mwenyezi Mungu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swh_onmm/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_onmm/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_onmm/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}