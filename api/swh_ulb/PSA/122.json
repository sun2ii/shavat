 wetu, nitatafuta mema kwa ajili yako."]}],"footnotes":[]},"thisChapterLink":"/api/swh_ulb/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swh_ulb/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swh_ulb/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}