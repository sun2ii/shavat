{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":1,"content":[{"type":"heading","content":["Laulau dudurai tauna eo laulau baaea tauna"]},{"type":"verse","number":1,"content":[{"text":"Tau wa ie kode","poem":1},{"text":"ia laulau gewagewa tataodi edi ribahesanapu nige i laulauedi,","poem":2},{"text":"baaea tataodi edi dobila eai nige i totoro,","poem":1},{"text":"eo Eaubada tau‐alaliuliuwaena edi oigogo eai nige i patulau;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"na GUIAU ena laugagaeo i kodei mo,","poem":1},{"text":"eo i hasihasiri asubena to maiona.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ia doha oeagi esau","poem":1},{"text":"saga gegesina eai se umai,","poem":2},{"lineBreak":true},{"text":"ena huia ua eai aiaina abo ie tore,","poem":2},{"lineBreak":true},{"text":"eo luguna taba nige se wowoea.","poem":2},{"text":"Ginauri gamagaridi i ginauridi abo se lau lolo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Laulau gewagewa tataodi isi nige meta doha,","poem":1},{"text":"isi doha sitona wenudi mana i eoho’eohoedi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Arinai ede laulau gewagewa tataodi hedudurai asubenana eai taba nige se toro,","poem":1},{"text":"eo baaea tataodi taulaulau dudurai edi oigogo eai taba nige se toro.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Paana GUIAU laulau dudurai tataodi i abi komakomanidi,","poem":1},{"text":"na laulau gewagewa tataodi abo se tauyamui.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/JOS/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}