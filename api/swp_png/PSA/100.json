{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":100,"content":[{"type":"heading","content":["Tabu lautoi ta nuahuiei"]},{"type":"verse","number":1,"content":[{"text":"Tanoubu tataomiu gamagarimiu e, kode daguguna au ginauri GUIAU arinai!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"GUIAU au heayaiyei ma kodekodemiu,","poem":1},{"text":"au laoma ia matana eai ma wanamiu!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Omi abo au nuatui, GUIAU ia Eaubada.","poem":1},{"text":"Ia i ginaurida, ita ia enana;","poem":2},{"lineBreak":true},{"text":"ita ia ena tataoyao, eo ita ia ena heaheai mamoena.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Au lulau ena dobila eai ma lautoimiu,","poem":1},{"text":"au lulau ena dubu alona eai ma hedebasaemiu!","poem":2},{"lineBreak":true},{"text":"Ia au lautoiei, ia esana au ribatausaei!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Paana GUIAU i lolo,","poem":1},{"text":"ena gadosisi miatahitahina i ota esegai i lau e nige nosina,","poem":2},{"lineBreak":true},{"text":"eo ena riba hemamohoiena i lau e hari isi to hari isi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":5}