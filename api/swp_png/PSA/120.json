{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":120,"content":[{"type":"heading","content":["Tatao edi laulau borabora eai bena se saguhaidi uurana"]},{"type":"verse","number":1,"content":[{"text":"Egu nuadobidobi boeana eai ea eogalau GUIAU arinai,","poem":1},{"text":"bena i heuioegu:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“Sopa borabora aridi eai eo memena borabora aridi eai,","poem":1},{"text":"GUIAU e, bena oa u saguhaigu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Oa memena borabora e,","poem":1},{"text":"saha abo se moseleawa arim eai,","poem":2},{"lineBreak":true},{"text":"eo saha abo se ginauri enam?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tauiala ena pidu matamatana,","poem":1},{"text":"ma oeagi alaalasina!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ahani eau, paana Meseka eai ea miamia,","poem":1},{"text":"Kedara ena numa lulu hinage boeadi eai ea miamia!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ea abimatemate paana ea mia ariri","poem":1},{"text":"isi boeadi eai labini se hewaiunuei.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Eau labini mo ea henua;","poem":1},{"text":"na ena ea ribariba,","poem":2},{"lineBreak":true},{"text":"isi iala mo se henua.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}