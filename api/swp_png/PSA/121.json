{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":121,"content":[{"type":"heading","content":["GUIAU ia Tauitawataim"]},{"type":"verse","number":1,"content":[{"text":"Eau matugu abo ea tusaei oea tupidi eai.","poem":1},{"text":"Aba saguigu haedi eai abo i laoma?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aba saguigu GUIAU arinai i laoma,","poem":1},{"text":"ia ede galewa eo tanoubu tauginauridi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ia abo aem i itawatai, taba nige i moiu,","poem":1},{"text":"ia tauitawataim wa, taba nige i eno.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"U ita, Isaraela tauitawataina","poem":1},{"text":"ia matana taba nige se enoeno, eo taba nige i enomate.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"GUIAU ia tauitawataim ede;","poem":1},{"text":"GUIAU ia ede em abaailogulogu","poem":2},{"lineBreak":true},{"text":"oa nimatutum eai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mahana gigiborina taba nige i talaim asubena eai,","poem":1},{"text":"eo nawarai hinage maiona eai taba nige’e.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"GUIAU abo i itawataim piripiri gamagaridi boeadi eai;","poem":1},{"text":"em mauri abo i itawatai.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Em pesa eo em awaseuio GUIAU abo i itawataidi,","poem":1},{"text":"ina huia ta ie lau e nige nosina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}