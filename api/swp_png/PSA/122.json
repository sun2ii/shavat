{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":122,"content":[{"type":"heading","content":["Ierusalema ena labini uurana"]},{"type":"verse","number":1,"content":[{"text":"Ea kode ariri huiana eai wa se heribagu, si ene,","poem":1},{"text":"“Ta awasaei GUIAU ena numa eai!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Aemai wa se totoro","poem":1},{"text":"oa em dobila abalusoradi eai, Ierusalema e!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ierusalema se hetoro doha eanua wasawasana","poem":1},{"text":"numana se adidiri eo se toro patupatu,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"boga gamagaridi se saesaewa,","poem":1},{"text":"isi ede GUIAU ana bogaoyao,","poem":2},{"lineBreak":true},{"text":"doha Isaraela se lauhesom wa, lautoi se mosei GUIAU esana eai.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Nei eai aba hedudurai aba bawadi saesaedi se toredi,","poem":1},{"text":"aba bawadi saesaedi wa Davida numana enana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ierusalema enana au aiboda bena loni abina i ata!","poem":1},{"text":"“Isi taugadosisiem bena se laulolo!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Em gana alodi eai bena loni nei eai,","poem":1},{"text":"em numa lailaidi alodi eai bena nuataru!”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Egu tataoyao eo egu dodogayao debadi eai","poem":1},{"text":"abo ea ribaei, ea ene, “Loni enamiu!”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"GUIAU ema Eaubada ena numa debana eai,","poem":1},{"text":"oa em lolo abo ea eo’o eo’oi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}