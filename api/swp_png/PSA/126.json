{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":126,"content":[{"type":"heading","content":["Hetorouio lautoina"]},{"type":"verse","number":1,"content":[{"text":"Huiana eai wa GUIAU Siona ena lolo i heharihariu,","poem":1},{"text":"ita ada ao doha tau enosuai.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Abo maruhi awada i hemonaudi,","poem":1},{"text":"eo memenada eai ta wowo ma kodeda.","poem":2},{"text":"Abo eanua headi taumiaidi si ene,","poem":1},{"text":"“GUIAU ginauri lailaidi enadi i ginauridi.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"GUIAU ginauri lailaidi enada i ginauridi;","poem":1},{"text":"arinai ta kode ariri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ema dobila bena u heharihariudi, GUIAU e,","poem":1},{"text":"doha goila se dididi Negeb barabarana eai!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Tatao wa tuma se lauhesuru ma matasurudi","poem":1},{"text":"abotai abo se tanogogo eo se wowo ma kodedi!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ia ma douna i torohai,","poem":1},{"text":"tuma i bahei bena i hesuru,","poem":2},{"text":"abo i uioma ena numa eai ie wowo ma kodena,","poem":1},{"text":"nimana eai sitona augogodi i baheidima.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":6}