{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":13,"content":[{"type":"heading","content":["Amamna boeana eai bena se saguhai uurana"]},{"type":"verse","number":1,"content":[{"text":"GUIAU e, abo i lau e aitea huia? Abo u nuahuiegu i lau e ana huia ana tasi?","poem":1},{"text":"I lau e aitea huia matam abo u buburi taba nige ea itam?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"I lau e aitea huia abo nuagu eai amamna lailai,","poem":1},{"text":"eo asubena to maiona abo nuadubu nuagu eai?","poem":2},{"lineBreak":true},{"text":"I lau e aitea huia agu waiunu abo i saepoigu?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"U italaoma eo u heuioegu, GUIAU e, egu Eaubada;","poem":1},{"text":"matagu u hemaradi ata mate mamohoi enona ea enoei;","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ata agu waiunu i ene, “Ea saepoiyao”;","poem":2},{"text":"ata agu waiunu se kode paana egu tabutabubu debana eai.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Na oa em gadosisi miatahitahina ea sunumaei,","poem":1},{"text":"nuagu abo i kodelamposi em abihemauri debana eai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"GUIAU arinai abo ea wana,","poem":1},{"text":"paana ia i ainauia aririegu.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":6}