{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":130,"content":[{"type":"heading","content":["GUIAU ena abihemauri sunumana"]},{"type":"verse","number":1,"content":[{"text":"GUIAU e, eau duha alona eai ea doulaowa arim eai!","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Guiau e, arinagu u ataiei!","poem":1},{"text":"Beam bena i tasoe egu aiboda","poem":2},{"lineBreak":true},{"text":"daguguna arinai!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"GUIAU e, ena oa laulau gewagewadi u nuatudidinidi,","poem":1},{"text":"Guiau e, eai gonoana abo i toro?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Na baaea ribagigirina ede oa arim eai i laoma,","poem":1},{"text":"arinai oa mo matausim abo se matausi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Eau GUIAU ea bagibagiei, earuagu hinage ia i bagibagiei,","poem":1},{"text":"eo ia ena riba arinai ea sunusunuma;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Eau earuagu Guiau i bagibagiei","poem":1},{"text":"doha isi tausilasilawa maratomtom taubagibagiena, eau mo ea hemuridi,","poem":2},{"lineBreak":true},{"text":"doha isi tausilasilawa maratomtom taubagibagiena eau mo ea hemuridi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isaraela e, u sunumalau GUIAU arinai!","poem":1},{"text":"Paana GUIAU arinai ede gadosisi miatahitahina,","poem":2},{"lineBreak":true},{"text":"eo ena abihemauri i lai ariariri.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Ia hinage abo Isaraela i unehemauri ena laulau gewagewadi","poem":1},{"text":"gamagaridi aridi eai.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":8}