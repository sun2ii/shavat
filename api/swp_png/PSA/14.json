{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":14,"content":[{"type":"heading","content":["Tatao edi eauyaule eo edi baaea"]},{"type":"verse","number":1,"content":[{"text":"Taueauyaure ia i ribariba nuana eai i ene,","poem":1},{"text":"“Eaubada nige’e.”","poem":2},{"text":"Isi tatao bi’ibi’idi, edi laulau se manamanabara ariri,","poem":1},{"text":"nige esau ena laulau i dudurai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"GUIAU ia galewa eai i itadobi","poem":1},{"text":"tatao nanatudiyao aridi eai,","poem":2},{"text":"bena i itadi eai to eai se mia dudurai,","poem":1},{"text":"eai to eai Eaubada se eo’oi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Isi gamagaridi se gegege, isi gamagaridi edi miamia doha ie boha,","poem":1},{"text":"nige esau i mia dudurai,","poem":2},{"lineBreak":true},{"text":"nige’e, nige ariariri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Edi sonoga nige’e, tatao baabaaeadi ta,","poem":1},{"text":"agu bogaoyao se aidi doha falawa se aiaini,","poem":2},{"lineBreak":true},{"text":"eo nige se eogalau GUIAU arinai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Matausi lailai didiga abo se hearo","poem":1},{"text":"paana Eaubada ia laulau dudurai tataodi edi tupo eai.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Gogo gesagesa tauna ena nuatu isi bena se gudugudui,","poem":1},{"text":"na ena abadago ede GUIAU.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Taba Isaraela ena abihemauri Siona eai i pesama!","poem":1},{"text":"Huiana wa GUIAU ena tataoyao edi gogo i hemaisauioidi","poem":2},{"lineBreak":true},{"text":"Iakobo abo i kodelamposi, Isaraela abo nuana i lolo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}