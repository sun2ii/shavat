{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":15,"content":[{"type":"heading","content":["Eaubada ena oea tupina tabuna taumiaina"]},{"type":"verse","number":1,"content":[{"text":"GUIAU e, eai gonoana i bawa oa em numalulu arinai?","poem":1},{"text":"Eai abo i mia em oea tupi tabuna eai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Tau wa nige abahegiruna,","poem":1},{"text":"eo laulau dudurai i laulauedi,","poem":2},{"lineBreak":true},{"text":"ia hinage nuana eai riba mamohoi mo i ribaribaei;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ia wa memenana eai nige monumonunu,","poem":1},{"text":"ena dodogayao nige i heamamna,","poem":2},{"lineBreak":true},{"text":"eo helena‐taumia‐tauna nige i ribasagasagariei;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"laulau gewagewa tauna i isuewaei,","poem":1},{"text":"na GUIAU taumatausi tataodi ia abo i hedebasaedi;","poem":2},{"lineBreak":true},{"text":"ena riba aigora i hemamohoiei piripiri boeana eai;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ia moni ena i mosehagahagaidi, taba nige hagahagana bena i abiuioi,","poem":1},{"text":"hinage taba nige moni se mosei bena laulau dudurai tauna i hegirugaibui.","poem":2},{"lineBreak":true},{"text":"Ia wa ena laulau doha ina, ia taba nige se hemoiu, nige ariariri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}