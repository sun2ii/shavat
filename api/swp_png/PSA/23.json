{"text":"agu waiunuyao matadi eai;","poem":2},{"text":"urugu u heyausi,","poem":1},{"text":"egu bia i monau boriboriri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mamohoi, abilolo eo nuatoatoa abo se hemuriwataigu","poem":1},{"text":"egu mauri asubenadi gamagaridi eai;","poem":2},{"text":"eo GUIAU ena numa eai eau abo ea miahai","poem":1},{"text":"i lau e huia nige nosina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}