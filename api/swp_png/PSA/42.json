{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":42,"content":[{"type":"heading","content":["GUIAU gadomaguna"]},{"type":"verse","number":1,"content":[{"text":"Doha suisui nuura","poem":1},{"text":"goila dididi i gadohiedi,","poem":2},{"lineBreak":true},{"text":"eau hinage, Eaubada e,","poem":2},{"text":"earuagu i gadohiem.","poem":3}]},{"type":"verse","number":2,"content":[{"text":"Earuagu i gadomagu Eaubada arinai,","poem":1},{"text":"Eaubada maumaurina arinai.","poem":2},{"text":"Aitea huia abo ea laoma","poem":1},{"text":"Eaubada ana ao abo ea ita?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Agu aiai esega ede matasulugu","poem":1},{"text":"asubena to maiona,","poem":2},{"lineBreak":true},{"text":"eo tatao huia gamagari se hesiolaoma, “Em Eaubada ia haedi‐eai?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ina ginauri ta ea henuaisini","poem":1},{"text":"huiana wa nuagu ea soeauri;","poem":2},{"text":"tatao bodadi maeguyao","poem":1},{"text":"ea woeaidi, se hemuriwataigu Eaubada ena numa eai,","poem":2},{"text":"aie wowo ma kodemai, eo aie wana ma lautoimai,","poem":1},{"text":"moutuana lailai ai mataasi gogo.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Earuagu e, paana saha u nuadobidobi,","poem":1},{"text":"eo paana saha nuaboeagu eai u heunaboisaha?","poem":2},{"text":"Eaubada u sunumaei; paana ia abo ea hedebasaeuioi,","poem":1},{"text":"ia agu sagu ede","poem":2}]},{"type":"verse","number":6,"content":[{"text":"eo egu Eaubada.","poem":2},{"lineBreak":true},{"text":"Earuagu i porohe ariri nuaboeagu eai","poem":1},{"text":"arinai abo oa ea nuanuatuim,","poem":2},{"text":"Ioridana eo Heremona eanuadi eai,","poem":1},{"text":"Misara oea tupina eai hinage.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gabotum i eogalau gabotum esau arinai,","poem":1},{"text":"em goila edi abadidi lailaidi dagugudi eai;","poem":2},{"text":"em bagodu eo em butubutu gamagaridi","poem":1},{"text":"se heputuhaigu.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Asubena huiana eai GUIAU ena gadosisi miatahitahina i leama;","poem":1},{"text":"eo maiona eai enana ea wawana,","poem":2},{"lineBreak":true},{"text":"ea lauuura egu mauri Eaubadana arinai.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ea ribalau Eaubada arinai ia egu we’utau,","poem":1},{"text":"“Paana saha u nuahuiegu ta?","poem":2},{"text":"Paana saha ea nuanuadubu,","poem":1},{"text":"waiunu ena hebahebaaea debana eai?”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Agu waiunuyao edi hesom","poem":1},{"text":"i hemala doha bonu lailai taugu eai,","poem":2},{"text":"huia gamagamagari se ribalaoma si ene,","poem":1},{"text":"“Em Eaubada haedi?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Earuagu e, paana saha u nuadobidobi,","poem":1},{"text":"eo paana saha nuaboeagu eai u heunaboisaha?","poem":2},{"text":"Eaubada u sunumaei; paana ia abo ea hedebasaeuioi,","poem":1},{"text":"ia agu sagu ede, eo egu Eaubada.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":11}