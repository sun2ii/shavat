{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":43,"content":[{"type":"heading","content":["Hedudurai eo Saguhai Urana"]},{"type":"verse","number":1,"content":[{"text":"Egu laulau dudurai u hemasaraha, Eaubada e, eo enagu u toro","poem":1},{"lineBreak":true},{"text":"ganamuri tataodi matadi eai;","poem":1},{"lineBreak":true},{"text":"ao borabora eo laulau gewagewa tataodi nimadi eai","poem":1},{"text":"u lebohaigu!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Paana oa Eaubada egu aba ailogulogu ede;","poem":1},{"text":"paana saha u gabahesuaragu?","poem":2},{"text":"Paana saha ea nuadubu","poem":1},{"text":"waiunu ena hebahebaaea debana eai?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Em mara eo em riba mamohoina bena u hetamaridima bena abo se woeaigu,","poem":1},{"text":"abo se woeaigu em oea tupi tabuna eo em abamia arinai!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Murina eai abo ea lau Eaubada ena aitalasam hatahatana arinai,","poem":1},{"text":"Eaubada egu abanuawoiwoina;","poem":2},{"text":"eo abo ea aihelahuim huelele arinai,","poem":1},{"text":"Eaubada e, egu Eaubada.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Earuagu e, paana saha u nuadobidobi","poem":1},{"text":"paana saha nuaboeagu eai u heunaboisaha?","poem":2},{"text":"Eaubada u sunumaei, paana ia abo ea hedebasaeuioi,","poem":1},{"text":"ia agu sagu ede eo egu Eaubada.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}