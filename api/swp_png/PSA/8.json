{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":8,"content":[{"type":"heading","content":["Eaubada Namanamarina eo Tau heasisina"]},{"type":"verse","number":1,"content":[{"text":"GUIAU, tanuagamai e,","poem":1},{"text":"tanoubu maudoina eai oa esam i sae ariariri!","poem":2},{"lineBreak":true},{"text":"Galewa ewana eai oa namanamarim se wanai","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kaimou gagiridi, taumadomado awadi eai,","poem":1},{"text":"iala numana adiadidirina u hetoro em waiunu debadi eai,","poem":2},{"lineBreak":true},{"text":"waiunu eo tauabigum em abahemonoudi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ena ea itasae em galewa eai, oa nimagigim paisoadi,","poem":1},{"text":"nawarai eo ipora hinage oa tautoredi;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"tau ede saha bena oa u nuanuatui,","poem":1},{"text":"eo tau natuna eai bena oa u abiloloei?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Taiede oa u ginauri Eaubada ia begana mo i hemuri,","poem":1},{"text":"eo namanamari eai eo heasisina eai ia u hekorona.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Oa nimam eai ginauri gamagaridi u ginauridi wa u mosedio ia","poem":1},{"text":"tanuagadi eai ie lau;","poem":2},{"text":"ginauri gamagaridi ia aena ubudi eai ue toredi,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"mamoe eo bulumakau gamagamagaridi,","poem":1},{"text":"eo nuura suisuidi hinage,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ewa manudi eo gabogabo eamadi,","poem":1},{"text":"eo ginauri gamagaridi gabogabo dobiladi eai se laulau.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"GUIAU, tanuagamai e,","poem":1},{"text":"tanoubu maudoina eai oa esam i sae ariariri!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":9}