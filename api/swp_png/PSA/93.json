{"translation":{"id":"swp_png","name":"RIBA HARIHARIUNA","website":"https://ebible.org/Scriptures/details.php?id=swp","licenseUrl":"https://ebible.org/Scriptures/details.php?id=swp","licenseNotes":null,"shortName":"PNG","englishName":"Suau Bible","language":"swp","textDirection":"ltr","sha256":"383dba90a648bc2f922d19bd90fe99f30501ac2b5177c85201e0a486caa5e202","availableFormats":["json"],"listOfBooksApiLink":"/api/swp_png/books.json","numberOfBooks":31,"totalNumberOfChapters":418,"totalNumberOfVerses":11476,"languageName":"Suau","languageEnglishName":"Suau"},"book":{"id":"PSA","translationId":"swp_png","name":"SALAMO","commonName":"SALAMO","title":"SALAMO HEADI BUKANA","order":19,"numberOfChapters":60,"sha256":"ce23503853794e674fb4272f038dc14726c128a6edf31592a01289c574ad6208","firstChapterNumber":1,"firstChapterApiLink":"/api/swp_png/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/swp_png/PSA/150.json","totalNumberOfVerses":927},"chapter":{"number":93,"content":[{"type":"heading","content":["Wasawasa GUIAUNA"]},{"type":"verse","number":1,"content":[{"text":"GUIAU ia wasawasa ede; ia ana tepo wasawasana eai se helui;","poem":1},{"text":"GUIAU se helui, adidirina ie lio.","poem":2},{"text":"Mamohoi tanoubu i totoro adidiri; taba nige se hemoimoiu.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Em terona mumuga eai se hetoro;","poem":1},{"text":"oa mumuga ariri eai u mia nige nosina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"GUIAU e, dibori utu’utu se dagudagugu,","poem":1},{"text":"dibori utu’utu arinadi se lauisinidi,","poem":2},{"lineBreak":true},{"text":"dibori utu’utu balamumudi se helaidi.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"GUIAU ini puripurina eai i gigibori ariri, ena gigibori","poem":1},{"text":"dibori utu’utudi gamagaridi dagugudi i saetawatawaidi,","poem":2},{"lineBreak":true},{"text":"gabogabo bagodudi edi gigibori i saetawatawaidi!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ena lauhesom ribadi isi ede mamohoi ariri;","poem":1},{"text":"hetabuena i patulau em numa tabuna arinai,","poem":2},{"lineBreak":true},{"text":"GUIAU e, i lau e nige nosina.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/swp_png/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/swp_png/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/swp_png/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":5}