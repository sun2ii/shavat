{"translation":{"id":"sxb_wbt","name":"Endagano Empia","website":"https://ebible.org/Scriptures/details.php?id=sxbNT","licenseUrl":"https://ebible.org/Scriptures/details.php?id=sxbNT","licenseNotes":null,"shortName":"WBT","englishName":"Suba NT","language":"sxb","textDirection":"ltr","sha256":"14b6fb75b3231baba25f57ff51538db359c0a4d25f07f7a94854c4f8d3fc5993","availableFormats":["json"],"listOfBooksApiLink":"/api/sxb_wbt/books.json","numberOfBooks":27,"totalNumberOfChapters":260,"totalNumberOfVerses":7942,"languageName":"Suba","languageEnglishName":"Suba"},"book":{"id":"LUK","translationId":"sxb_wbt","name":"LUUKA","commonName":"LUUKA","title":"Injiili eya LUUKA","order":42,"numberOfChapters":24,"sha256":"95ad06c022e8187b6f9eb2760683438f170f621bdd9c27a3066be32e2b2ab0bb","firstChapterNumber":1,"firstChapterApiLink":"/api/sxb_wbt/LUK/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/sxb_wbt/LUK/24.json","totalNumberOfVerses":1150},"chapter":{"number":3,"content":[{"type":"heading","content":["Yowaana Omubatiisi alonga engira"]},{"type":"verse","number":1,"content":["Gwawanga omwaka ogwa ikumi ni itaanu mu owukangasi owua *Kaisaari Tiberiasi. Pontias Pilaato yawanga omukangasi owa ekitemo ekia Yudeea, ne *Eroode yawanga omukangasi owa ekitemo ekia Galiili. Wamwawu waae Piliipo nio owawanga omukangasi owa Iturea ni Trakonitiisi, ni Lisaania yawanga omukangasi owa Abileene."]},{"type":"verse","number":2,"content":["Anaasi ni Kaifa niwo awaawanga awakangasi awa *awoozia. Amiire ago amangʼana aga Katonda gaazra Yowaana omuzia owa Zakaria na ari mu ekeewa."]},{"type":"verse","number":3,"content":["Yagia mu ewialo wiona ewiri ampi no oluuzi olwa Yordaani, na alanzizia awantu mbwe wagaluke wareke amawi, wabatiiswe kugere Katonda awarekere owuoni wuawu."]},{"type":"verse","number":4,"content":["Kiomo Katonda yawoola mu amangʼana agari mu ebuuki eya *Omugambi Isaaya otino:",{"text":"“Omwoyo ogwa omuntu oetana mu ekeewa otino,","poem":1},{"lineBreak":true},{"text":"‘Mulongre Omwami engira,","poem":1},{"text":"mumugololre engira ewe enyigolovu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Amiina goona gawugrwe,","poem":1},{"text":"ewigiri wiona wirimwe wiike ansi.","poem":2},{"text":"Engira eziigodre zigololwe,","poem":1},{"text":"kandi anyenyeevu aterereziwue.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kandi awantu woona waaza okuwona owuinunuzi owua Katonda.’ ”","poem":1}]},{"type":"verse","number":7,"content":["Yowaana yalaga omuganda ogwa awantu awamuuzako kugere awabatiise otino, “Inywe awaana awa enzoka wano! Owasiagiizie mbwe mumizule okuswawukwa no okusu okungi okuuza naanu?"]},{"type":"verse","number":8,"content":["Muamie ensaafu ezia mu enkola, ezilagana geeza mbwe omuntu agaluuke arekere amawi. Ni mutaaza mwaingirizia mbwe muuza mwamizuka ku okuwoola-uwoola mbwe, ‘Turi geeza aeniki turi awaana awa Abraamu.’ Mbalaga mbwe Katonda aesa okugalusia amawaale gano gawe awaana awa Abraamu!"]},{"type":"verse","number":9,"content":["Namba nyingeeno, embasa emiire okuteewua ku isina eria omuti; kandi omuti ki omuti oguta-amia ensaafu endootu guuza okutemwao nikwo gurigizwe mu omurro.”"]},{"type":"verse","number":10,"content":["Omurima ogwo gwamuwuuzia otino, “Katio tusugaane tukoleki?”"]},{"type":"verse","number":11,"content":["Yowaana yawairania otino, “Omuntu ori ne enguwo iwiri asugaane agawire omwina waae owula nayo, kandi ori no okuria oona asugaane akole otio.”"]},{"type":"verse","number":12,"content":["Awasolozi awa *omusolo awaaza okubatiiswa woona waamuwuuzia watino, “Omugerezi, ifwe tusugaane tukoleki?”"]},{"type":"verse","number":13,"content":["Yawalaga otino, “Mutasolozia amangi okukira kiomo kuagalana.”"]},{"type":"verse","number":14,"content":["Nikuemao awa-iiye wandi woona waamuwuuzia watino, “Ni ifwe, tusugaane tukoleki?” Yowaana yawairania otino, “Mutatoola amasendi ku awantu na amaani kandi mutata amangʼana aga owuweeyi ku omuntu. Mureke emisaara giinyu giwasuge!”"]},{"type":"verse","number":15,"content":["Awantu awaarindranga okuuza okwa Omununuzi waaingirizianga mu emioyo giawu mbwe Yowaana oyo nio owawanga *Meesia."]},{"type":"verse","number":16,"content":["Yowaana yawairania woona otino, “Inze mbabatiisa na amanzi. Na ario amuntu omukaate okunkira ooza, omuntu owa ngʼasugre namba okusiwula engoe ezia ewiraato wiae. Iye aaza okuwabatiisa no *Omwoyo Omweru ogwa Katonda kandi no omurro."]},{"type":"verse","number":17,"content":["Ari ne ekiseeso kiae mu amakono, ekia aaza okuseesra amaemba mu olwanyi lwae. Emere aaza okuta mu ekiagi, na amakunzo aaza okusamba no omurro ogutazima.”"]},{"type":"verse","number":18,"content":["Na amangʼana gandi amangi, Yowaana yaiyemba awantu na awalanzizia amangʼana amalootu."]},{"type":"verse","number":19,"content":["No olwa Yowaana yagaania Omwami Eroode ku amangʼana aga Erodiasi muka wamwawu owa yatoola okuwa omukazi waae, kandi ku amawi gandi amangi aga Eroode yakolanga,"]},{"type":"verse","number":20,"content":["Eroode yasonga owuwi ku amawi goona aga yakola ago olwa yaingizia Yowaana mu owusiwe."]},{"type":"heading","content":["Yesu abatiisrwe na amanzi kandi no Omwoyo Omweru"]},{"type":"verse","number":21,"content":["Kwawa mbwe, na awantu woona waamala okubatiiswa kandi Yesu oona yaaza abatiiswa, kandi ni yasawanga igulu riaigukao."]},{"type":"verse","number":22,"content":["Omwoyo Omweru yaika ku iye mu embonekano eya iemba-emba kandi omwoyo gwaemera ku igulu ogwawoola gutino, “Iwue ni iwue omuzia wange owa ngonziizie, kandi owa nsangaarre nae.”"]},{"type":"verse","number":23,"content":["Yesu yawanga ne emiaka egiera amakumi asatu na atanika emirimo giae. Owuiwulane owua Yesu (Math 1:1–17) Awantu waingirizianga mbwe yawanga omuzia owa Yoseefu,",{"text":"ni kuwuene yasimuka mu owuiwulane owua Eeli.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Eeli yawanga omuzia owa Mataat,","poem":1},{"lineBreak":true},{"text":"Mataat yawanga omuzia owa Laawi,","poem":1},{"lineBreak":true},{"text":"Laawi yawanga omuzia owa Melki,","poem":1},{"lineBreak":true},{"text":"Melki yawanga omuzia owa Janaai,","poem":1},{"lineBreak":true},{"text":"Janaai yawanga omuzia owa Yoseefu.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Yoseefu yawanga omuzia owa Matathiasi,","poem":1},{"lineBreak":true},{"text":"Matathiasi yawanga omuzia owa Amoos,","poem":1},{"lineBreak":true},{"text":"Amoos yawanga omuzia owa Naumi,","poem":1},{"lineBreak":true},{"text":"Naumi yawanga omuzia owa Esli,","poem":1},{"lineBreak":true},{"text":"Esli yawanga omuzia owa Nagaai.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nagaai yawanga omuzia owa Maathi,","poem":1},{"lineBreak":true},{"text":"Maathi yawanga omuzia owa Matathiasi,","poem":1},{"lineBreak":true},{"text":"Matathiasi yawanga omuzia owa Semeeni,","poem":1},{"lineBreak":true},{"text":"Semeeni yawanga omuzia owa Yoseeki,","poem":1},{"lineBreak":true},{"text":"Yoseeki yawanga omuzia owa Yooda.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Yooda yawanga omuzia owa Yoanan,","poem":1},{"lineBreak":true},{"text":"Yoanan yawanga omuzia owa Reesa,","poem":1},{"lineBreak":true},{"text":"Reesa yawanga omuzia owa Zerubabeeli,","poem":1},{"lineBreak":true},{"text":"Zerubabeeli yawanga omuzia owa Seltieli,","poem":1},{"lineBreak":true},{"text":"Seltieli yawanga omuzia owa Neeri.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Neeri yawanga omuzia owa Melki,","poem":1},{"lineBreak":true},{"text":"Melki yawanga omuzia owa Aadi,","poem":1},{"lineBreak":true},{"text":"Aadi yawanga omuzia owa Kosaam,","poem":1},{"lineBreak":true},{"text":"Kosaam yawanga omuzia owa Elmadaam,","poem":1},{"lineBreak":true},{"text":"Elamdaam yawanga omuzia owa Eeri.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Eeri yawanga omuzia owa Yoswa,","poem":1},{"lineBreak":true},{"text":"Yoswa yawanga omuzia owa Eliazaari,","poem":1},{"lineBreak":true},{"text":"Eliazaari yawanga omuzia owa Yoriimu,","poem":1},{"lineBreak":true},{"text":"Yoriimu yawanga omuzia owa Mattaat,","poem":1},{"lineBreak":true},{"text":"Mattaat yawanga omuzia owa Laawi.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Laawi yawanga omuzia owa Simoni,","poem":1},{"lineBreak":true},{"text":"Simoni yawanga omuzia owa Yuuda,","poem":1},{"lineBreak":true},{"text":"Yuuda yawanga omuzia owa Yoseefu,","poem":1},{"lineBreak":true},{"text":"Yoseefu yawanga omuzia owa Yoanaamu,","poem":1},{"lineBreak":true},{"text":"Yoanaamu yawanga omuzia owa Eliakiimu.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Eliakiimu yawanga omuzia owa Melea,","poem":1},{"lineBreak":true},{"text":"Melea yawanga omuzia owa Meena,","poem":1},{"lineBreak":true},{"text":"Meena yawanga omuzia owa Mataatha,","poem":1},{"lineBreak":true},{"text":"Mataatha yawanga omuzia owa Nathaani,","poem":1},{"lineBreak":true},{"text":"Nathaani yawanga omuzia owa Daudi.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Daudi yawanga omuzia owa Yeese,","poem":1},{"lineBreak":true},{"text":"Yeese yawanga omuzia owa Obeedi,","poem":1},{"lineBreak":true},{"text":"Obeedi yawanga omuzia owa Boazi,","poem":1},{"lineBreak":true},{"text":"Boazi yawanga omuzia owa Salmooni,","poem":1},{"lineBreak":true},{"text":"Salmooni yawanga omuzia owa Nasooni.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Nasooni yawanga omuzia owa Aminadaabu,","poem":1},{"lineBreak":true},{"text":"Aminadaabu yawanga omuzia owa Raamu,","poem":1},{"lineBreak":true},{"text":"Raamu yawanga omuzia owa Ezrooni,","poem":1},{"lineBreak":true},{"text":"Ezrooni yawanga omuzia owa Pereezi,","poem":1},{"lineBreak":true},{"text":"Pereezi yawanga omuzia owa Yuuda.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Yuuda yawanga omuzia owa Yakoobo,","poem":1},{"lineBreak":true},{"text":"Yakoobo yawanga omuzia owa Isaaka,","poem":1},{"lineBreak":true},{"text":"Isaaka yawanga omuzia owa Abraamu,","poem":1},{"lineBreak":true},{"text":"Abraamu yawanga omuzia owa Teera,","poem":1},{"lineBreak":true},{"text":"Teera yawanga omuzia owa Naori.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Naori yawanga omuzia owa Seruugi,","poem":1},{"lineBreak":true},{"text":"Seruugi yawanga omuzia owa Reeu,","poem":1},{"lineBreak":true},{"text":"Reeu yawanga omuzia owa Peleegi,","poem":1},{"lineBreak":true},{"text":"Peleegi yawanga omuzia owa Ebeer,","poem":1},{"lineBreak":true},{"text":"Ebeer yawanga omuzia owa Seela.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Seela yawanga omuzia owa Kainaani,","poem":1},{"lineBreak":true},{"text":"Kainaani yawanga omuzia owa Alfaksaadi,","poem":1},{"lineBreak":true},{"text":"Alfaksaadi yawanga omuzia owa Seem,","poem":1},{"lineBreak":true},{"text":"Seem yawanga omuzia owa Noowa,","poem":1},{"lineBreak":true},{"text":"Noowa yawanga omuzia owa Lameeki.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"Lameeki yawanga omuzia owa Methuseela,","poem":1},{"lineBreak":true},{"text":"Methuseela yawanga omuzia owa Enooka,","poem":1},{"lineBreak":true},{"text":"Enooka yawanga omuzia owa Yareedi,","poem":1},{"lineBreak":true},{"text":"Yareedi yawanga omuzia owa Maalaleeli,","poem":1},{"lineBreak":true},{"text":"Maalaleeli yawanga omuzia owa Kainaani.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"Kainaani yawanga omuzia owa Enoosi,","poem":1},{"lineBreak":true},{"text":"Enoosi yawanga omuzia owa Seeth,","poem":1},{"lineBreak":true},{"text":"Seeth yawanga omuzia owa Adaamu,","poem":1},{"lineBreak":true},{"text":"ni Adaamu yawanga omuzia owa Katonda.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/sxb_wbt/LUK/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/sxb_wbt/LUK/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/sxb_wbt/LUK/2.json","previousChapterAudioLinks":{},"numberOfVerses":38}