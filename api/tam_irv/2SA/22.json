{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"2SA","translationId":"tam_irv","name":"2 சாமுவேல்","commonName":"2 சாமுவேல்","title":"2 சாமுவேல்","order":10,"numberOfChapters":24,"sha256":"131118014fd5e51e1555b21ce7d0514d9fefcc08f0f827485e18b9c9061b5ae4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/tam_irv/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["தாவீதின் துதிப் பாடல்"]},{"type":"verse","number":1,"content":["யெகோவா தாவீதை அவனுடைய எல்லா எதிரிகளின் கைக்கும், சவுலின் கைக்கும், விலக்கி விடுவித்தபோது, அவன் யெகோவாவுக்கு முன்பாகப் பாடின பாட்டு:"]},{"type":"verse","number":2,"content":[{"text":"“யெகோவா என்னுடைய கன்மலையும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கோட்டையும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இரட்சகருமானவர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேவன் நான் நம்பியிருக்கிற கன்மலையும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கேடகமும், என்னுடைய பாதுகாப்பின் கொம்பும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உயர்ந்த அடைக்கலமும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருப்பிடமும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இரட்சகருமானவர்;","poem":1},{"lineBreak":true},{"text":"என்னைத் துன்பத்திற்கு விலக்கி இரட்சிக்கிறவர் அவரே.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"துதிக்குக் காரணரான யெகோவாவை நோக்கிக் கூப்பிடுவேன்;","poem":1},{"lineBreak":true},{"text":"அதனால் என்னுடைய எதிரிகளுக்கு விலக்கி இரட்சிக்கப்படுவேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மரண அலைகள் என்னைச் சூழ்ந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"பயனற்ற வெள்ளப்பெருக்கு என்னைப் பயப்படுத்தினது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பாதாளக் கட்டுகள் என்னைச் சூழ்ந்து கொண்டது;","poem":1},{"lineBreak":true},{"text":"மரணக்கண்ணிகள் என்மேல் விழுந்தது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"எனக்கு உண்டான நெருக்கத்திலே யெகோவாவை நோக்கிக் கூப்பிட்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய தேவனை நோக்கிக் கூப்பிட்டேன்;","poem":1},{"lineBreak":true},{"text":"தமது ஆலயத்திலிருந்து என்னுடைய சத்தத்தைக் கேட்டார்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கூப்பிடுதல் அவர் செவிகளில் விழுந்தது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அப்பொழுது பூமி அசைந்து அதிர்ந்தது;","poem":1},{"lineBreak":true},{"text":"அவர் கோபங்கொண்டதால் வானத்தின் அஸ்திபாரங்கள் குலுங்கி அசைந்தது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் நாசியிலிருந்து புகை வந்தது,","poem":1},{"lineBreak":true},{"text":"அவர் வாயிலிருந்து ஒளிவீசும் அக்கினி புறப்பட்டது,","poem":1},{"lineBreak":true},{"text":"அதனால் தீப்பற்றிக்கொண்டது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"வானங்களைத் தாழ்த்தி இறங்கினார்; அவர் பாதங்களின்கீழ் காரிருள் இருந்தது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"கேருபீனின்மேல் ஏறி வேகமாகப் பறந்து சென்றார்.","poem":1},{"lineBreak":true},{"text":"காற்றின் இறக்கைகளின்மேல் காட்சியளித்தார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"வானத்து மேகங்களில் கூடிய தண்ணீர்களின் இருளைத் தம்மைச் சுற்றிலும் இருக்கும் கூடாரமாக்கினார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவருக்கு முன்பாக இருந்த மின்னலினால் நெருப்புத்தழலும் எரிந்தது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவா வானத்திலிருந்து இடியைப்போல முழங்கி,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவன் தமது சத்தத்தைத் தொனிக்கச் செய்தார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவர் அம்புகளை எய்து,","poem":1},{"lineBreak":true},{"text":"அவர்களைச் சிதறடித்து,","poem":1},{"lineBreak":true},{"text":"மின்னல்களை உபயோகித்து,","poem":1},{"lineBreak":true},{"text":"அவர்களைச் சிதறடித்தார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய கடிந்துகொள்ளுதலினாலும், அவருடைய நாசியின் சுவாசக் காற்றினாலும் சமுத்திரத்தின் மதகுகள் திறக்கப்பட்டு,","poem":1},{"lineBreak":true},{"text":"பூமியின் அஸ்திபாரங்கள் காணப்பட்டது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உயரத்திலிருந்து அவர் கை நீட்டி,","poem":1},{"lineBreak":true},{"text":"என்னைப் பிடித்து, வெள்ளப்பெருக்கில் இருக்கிற என்னைத் தூக்கிவிட்டார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என்னைவிட பெலவானாக இருந்த","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிக்கும் என்னுடைய விரோதிகளுக்கும் என்னை விடுவித்தார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆபத்து நாளிலே எனக்கு எதிராக வந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவோ எனக்கு ஆதரவாக இருந்தார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என்மேல் அவர் பிரியமாக இருந்தபடியால்,","poem":1},{"lineBreak":true},{"text":"என்னைத் தப்புவித்தார்.","poem":1},{"noteId":12}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"யெகோவா என்னுடைய நீதிக்குத்தகுந்தபடி எனக்கு பதில் அளித்தார்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கைகளின் சுத்தத்திற்குத்தகுந்தபடி","poem":1},{"lineBreak":true},{"text":"எனக்குச் சரிக்கட்டினார்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய வழிகளைக் காத்துக்கொண்டுவந்தேன்;","poem":1},{"lineBreak":true},{"text":"நான் என்னுடைய தேவனுக்குத் துரோகம் செய்ததில்லை.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவருடைய நியாயங்களையெல்லாம் எனக்கு முன்பாக நிறுத்தினேன்;","poem":1},{"lineBreak":true},{"text":"நான் அவருடைய கட்டளைகளைவிட்டு விலகாமல்,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அவருக்கு முன்பாக மன உண்மையாக இருந்து,","poem":1},{"lineBreak":true},{"text":"பாவத்திற்கு என்னை விலக்கிக் காத்துக்கொண்டேன்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"ஆகையால் யெகோவா என்னுடைய நீதிக்குத் தகுந்தபடியும்,","poem":1},{"lineBreak":true},{"text":"தம்முடைய கண்களுக்கு முன்பாக இருக்கிற என்னுடைய சுத்தத்திற்குத்தகுந்தபடியும் எனக்கு பலனளித்தார்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தயவுள்ளவனுக்கு நீர் தயவுள்ளவராகவும்,","poem":1},{"lineBreak":true},{"text":"உத்தமனுக்கு நீர் உத்தமராகவும்,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"புனிதனுக்கு நீர் புனிதராகவும்,","poem":1},{"lineBreak":true},{"text":"மாறுபாடு உள்ளவர்களுக்கு நீர் மாறுபடுகிறவராகவும் தோன்றுவீர்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"சிறுமைப்பட்ட மக்களை இரட்சிப்பீர்;","poem":1},{"lineBreak":true},{"text":"பெருமையுள்ளவர்களைத் தாழ்த்த,","poem":1},{"lineBreak":true},{"text":"உம்முடைய கண்கள் அவர்களுக்கு விரோதமாகத் திருப்பப்பட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"கர்த்தராகிய தேவரீர் என்னுடைய விளக்காக இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"யெகோவா என்னுடைய இருளை வெளிச்சமாக்குகிறவர்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"உம்மாலே நான் ஒரு சேனைக்குள் பாய்ந்துபோவேன்","poem":1},{"noteId":13},{"text":";","poem":1},{"lineBreak":true},{"text":"என்னுடைய தேவனாலே ஒரு மதிலைத் தாண்டுவேன்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"தேவனுடைய வழி உத்தமமானது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய வசனம் சுத்தமானது;","poem":1},{"lineBreak":true},{"text":"தம்மை நம்புகிற அனைவருக்கும் அவர் கேடகமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"யெகோவாவைத் தவிர தேவன் யார்?","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேவனையன்றி கன்மலையும் யார்?","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"தேவன் எனக்குப் பெலத்த அரணானவர்;","poem":1},{"lineBreak":true},{"text":"அவர் என்னுடைய வழியைச் செவ்வைப்படுத்துகிறவர்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"அவர் என்னுடைய கால்களை மான்களுடைய கால்களைப்போல மாற்றி,","poem":1},{"lineBreak":true},{"text":"உயர்ந்த மலைகளில் என்னை நிறுத்துகிறார்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"வெண்கல வில்லும் என்னுடைய கரங்களால் வளையும்படி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கைகளை யுத்தத்திற்குப்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"உம்முடைய இரட்சிப்பின் கேடகத்தையும் எனக்குத் தந்தீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய தயவு என்னைப் பெரியவனாக்கும்.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"என்னுடைய கால்கள் வழுக்காதபடி நான் நடக்கிற வழியை அகலமாக்கினீர்.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகளைப் பின்தொடர்ந்து அவர்களை அழிப்பேன்;","poem":1},{"lineBreak":true},{"text":"அவர்களை அழிக்கும்வரைக்கும் திரும்பமாட்டேன்.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"அவர்கள் எழுந்திருக்கமுடியாதபடி என்னுடைய பாதங்களின்கீழ் விழுந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களை முறியடித்து வெட்டினேன்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"யுத்தத்திற்கு நீர் என்னை பெலத்தால் இடைகட்டி,","poem":1},{"lineBreak":true},{"text":"என்மேல் எழும்பினவர்களை என்கீழ் விழும்படிச் செய்தீர்.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"நான் என்னுடைய விரோதியை அழிக்கும்படி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகளின் பிடரியை எனக்கு ஒப்புக்கொடுத்தீர்.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"அவர்கள் நோக்கிப் பார்க்கிறார்கள்,","poem":1},{"lineBreak":true},{"text":"அவர்களை இரட்சிப்பவர்கள் ஒருவருமில்லை;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நோக்கிப் பார்க்கிறார்கள்,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு அவர் பதில் கொடுக்கிறதில்லை.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"அவர்களை பூமியின் தூளாக இடித்து,","poem":1},{"lineBreak":true},{"text":"தெருக்களின் சேற்றைப்போல அவர்களை மிதித்து சிதறச்செய்கிறேன்.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"என்னுடைய மக்களின் சண்டைகளுக்கு நீர் என்னை விலக்கிவிட்டு,","poem":1},{"lineBreak":true},{"text":"தேசங்களுக்கு என்னைத் தலைவனாக வைக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"நான் அறியாத மக்கள் என்னைப் பணிகிறார்கள்.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"அந்நியர்கள் எனக்கு எதிராகப் பேசி அடங்கி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய சத்தத்தைக் கேட்டவுடனே எனக்குக் கீழ்ப்படிகிறார்கள்.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"அந்நியர்கள் பயந்துபோய்,","poem":1},{"lineBreak":true},{"text":"தங்கள் கோட்டைகளிலிருந்து பயத்தோடு புறப்படுகிறார்கள்.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"யெகோவா ஜீவனுள்ளவர்; என்னுடைய கன்மலையானவர் ஸ்தோத்தரிக்கப்படுவாராக;","poem":1},{"lineBreak":true},{"text":"என்னுடைய இரட்சிப்பின் கன்மலையான தேவன் உயர்ந்திருப்பாராக.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"அவர் எனக்காகப் பழிக்குப் பழி வாங்கி,","poem":1},{"lineBreak":true},{"text":"மக்களை எனக்குக்","poem":1},{"lineBreak":true},{"text":"கீழ்ப்படுத்துகிற தேவனானவர்.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"அவரே என்னுடைய எதிரிகளுக்கு என்னை விலக்கி விடுவிக்கிறவர்;","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாக எழும்புகிறவர்கள்மேல்","poem":1},{"lineBreak":true},{"text":"என்னை உயர்த்திக் கொடுமையான மனிதனுக்கு என்னைத் தப்புவிக்கிறீர்.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"இதனால் யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"தேசங்களுக்குள் உம்மைத் துதித்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய நாமத்திற்கு துதிப் பாடல்கள் பாடுவேன்.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"தாம் ஏற்படுத்தின ராஜாவுக்கு","poem":1},{"lineBreak":true},{"text":"மகத்தான இரட்சிப்பை அளித்து,","poem":1},{"lineBreak":true},{"text":"தாம் அபிஷேகம்செய்த தாவீதுக்கும்","poem":1},{"lineBreak":true},{"text":"அவனுடைய சந்ததிக்கும் என்றென்றும் கிருபை செய்கிறார்.”","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"விசாலமான இடத்திலே என்னைக் கொண்டுவந்து","reference":{"chapter":22,"verse":20}},{"noteId":13,"caller":"+","text":"மிதிப்பேன்","reference":{"chapter":22,"verse":30}}]},"thisChapterLink":"/api/tam_irv/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}