{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"DEU","translationId":"tam_irv","name":"உபாகமம்","commonName":"உபாகமம்","title":"உபாகமம்","order":5,"numberOfChapters":34,"sha256":"8971ae35e443147fbd27208692e3e5bb8500aca67766e44543e1ae1e4343a62e","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/tam_irv/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["மோசே இஸ்ரவேல் கோத்திரங்களை ஆசீர்வதித்தல்"]},{"type":"verse","number":1,"content":["தேவனுடைய மனிதனாகிய மோசே தான் மரணமடைவதற்கு முன்னே இஸ்ரவேல் மக்களை ஆசீர்வதித்த ஆசீர்வாதமாவது:"]},{"type":"verse","number":2,"content":[{"text":"“யெகோவா சீனாயிலிருந்து எழுந்தருளி,","poem":1},{"lineBreak":true},{"text":"சேயீரிலிருந்து அவர்களுக்கு உதயமானார்;","poem":1},{"lineBreak":true},{"text":"பாரான் மலையிலிருந்து பிரகாசித்து,","poem":1},{"lineBreak":true},{"text":"பத்தாயிரங்களான பரிசுத்தவான்களுடன் வெளிப்பட்டார்;","poem":1},{"lineBreak":true},{"text":"அவர்களுக்காக அக்கினிமயமான பிரமாணம் அவருடைய வலதுகரத்திலிருந்து புறப்பட்டது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உண்மையாகவே அவர் மக்களை நேசிக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய பரிசுத்தவான்கள் எல்லோரும் உம்முடைய கையில் இருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் உம்முடைய பாதத்தில் விழுந்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வார்த்தைகளினால் போதிக்கப்படுவார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மோசே நமக்கு ஒரு நியாயப்பிரமாணத்தைக் கற்பித்தான்;","poem":1},{"lineBreak":true},{"text":"அது யாக்கோபின் சபைக்குச் சொந்தமானது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மக்களின் தலைவர்களும் இஸ்ரவேலின் கோத்திரங்களும் ஒன்றாகக்கூடினபோது","poem":1},{"lineBreak":true},{"text":"அவர் யெஷூரனுக்கு ராஜாவாயிருந்தார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"“ரூபன் மரணமடையாமல் பிழைப்பானாக;","poem":1},{"lineBreak":true},{"text":"அவன் மக்கள் குறைவாக இருக்கமாட்டார்கள்” என்றான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவன் யூதாவைக்குறித்து: “யெகோவாவே, யூதாவின் சத்தத்தைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"அவன் தன்னுடைய மக்களிடத்திற்கு திரும்பிவரச் செய்யும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய கை பலப்படுவதாக;","poem":1},{"lineBreak":true},{"text":"அவனுடைய எதிரிகளுக்கு அவனைப் பாதுகாத்து விடுவிக்கிற உதவி செய்கிறவராக இருப்பீராக” என்றான்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"லேவியர்களைக்குறித்து: “நீ மாசாவிலே பரீட்சைபார்த்து,","poem":1},{"lineBreak":true},{"text":"மேரிபாவின் தண்ணீரின் அருகில் வாக்குவாதம்செய்த உன் பரிசுத்த மனிதனிடம்","poem":1},{"lineBreak":true},{"text":"உன்னுடைய தும்மீம் ஊரீம் என்பவைகள் இருப்பதாக.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தன்னுடைய தகப்பனையும்,","poem":1},{"lineBreak":true},{"text":"தாயையும் குறித்து நான் அவர்களுக்கு முக்கியத்துவம் கொடுக்கமாட்டேன் என்று சொல்லி,","poem":1},{"lineBreak":true},{"text":"தன் சகோதரர்களையும், பிள்ளைகளையும்","poem":1},{"lineBreak":true},{"text":"ஏற்றுக்கொள்ளாமல் இருக்கிறவனிடத்தில் அவைகள் இருப்பதாக;","poem":1},{"lineBreak":true},{"text":"அவர்கள் உம்முடைய வார்த்தைகளைக் கைக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"உம்முடைய உடன்படிக்கையைக் காக்கிறவர்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்கள் யாக்கோபுக்கு உம்முடைய நியாயங்களையும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலுக்கு உம்முடைய பிரமாணத்தையும் கற்பித்து,","poem":1},{"lineBreak":true},{"text":"உமது சந்நிதானத்திலே தூபவர்க்கத்தையும்,","poem":1},{"lineBreak":true},{"text":"உமது பலிபீடத்தின்மேல் சர்வாங்க தகனபலிகளையும் செலுத்துவார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவே, அவனுடைய ஆஸ்தியை ஆசீர்வதித்து,","poem":1},{"lineBreak":true},{"text":"அவன் கையின் செயல்களின்மேல் பிரியமாயிரும்;","poem":1},{"lineBreak":true},{"text":"அவனைப் பகைத்து அவனுக்கு விரோதமாக எழும்புகிறவர்கள்","poem":1},{"lineBreak":true},{"text":"திரும்ப எழுந்திருக்காதபடி அவர்களுடைய இடுப்புகளை நொறுக்கிவிடும்” என்றான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பென்யமீனைக்குறித்து:","poem":1},{"lineBreak":true},{"text":"“யெகோவாவுக்குப் பிரியமானவன்,","poem":1},{"lineBreak":true},{"text":"அவருடன் சுகமாகத் தங்கியிருப்பான்;","poem":1},{"lineBreak":true},{"text":"அவனை எந்நாளும் அவர் காப்பாற்றி,","poem":1},{"lineBreak":true},{"text":"அவனுடைய எல்லைக்குள்ளே தங்கியிருப்பார்” என்றான்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யோசேப்பைக்குறித்து: “யெகோவாவால் அவனுடைய தேசம் ஆசீர்வதிக்கப்படுவதாக;","poem":1},{"lineBreak":true},{"text":"அது வானத்தின் செல்வத்தினாலும், பனியினாலும், ஆழத்திலுள்ள நீரூற்றுகளினாலும்,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"சூரியன் பக்குவப்படுத்தும் அருமையான பழங்களினாலும்,","poem":1},{"noteId":16},{"lineBreak":true},{"text":"சந்திரன் பக்குவப்படுத்தும் அருமையான பலன்களினாலும்,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"பழமையான மலைகளில் உண்டாகும் விலையுயர்ந்த பொருட்களினாலும்,","poem":1},{"lineBreak":true},{"text":"நித்திய மலைகளில் கிடைக்கும் அரிதான பொருட்களினாலும்,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நாடும் அதின் நிறைவும் கொடுக்கும் அருமையான தானியங்களினாலும் ஆசீர்வதிக்கப்படுவதாக.","poem":1},{"lineBreak":true},{"text":"முட்செடியில் காட்சியளித்தவரின் தயவு யோசேப்புடைய தலையின்மேலும்,","poem":1},{"lineBreak":true},{"text":"தன் சகோதரர்களில் விசேஷித்தவனுடைய உச்சந்தலையின்மேலும் வருவதாக.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவனுடைய அலங்காரம் அவன் முதற்பிறந்த காளையினுடைய அலங்காரத்தைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"அவன் கொம்புகள் காண்டாமிருகத்தின் கொம்புகளைப்போலவும் இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவைகளாலே மக்கள் அனைவரையும் தேசத்தின் கடைசிவரை முட்டித் துரத்துவான்;","poem":1},{"lineBreak":true},{"text":"அவைகள் எப்பிராயீமின் பத்தாயிரங்களும் மனாசேயின் ஆயிரங்களுமானவைகள்” என்றான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"“செபுலோனைக்குறித்து: செபுலோனே,","poem":1},{"lineBreak":true},{"text":"நீ வெளியே புறப்பட்டுப்போகும்போதும், இசக்காரே,","poem":1},{"lineBreak":true},{"text":"நீ உன் கூடாரங்களில் தங்கும்போதும் சந்தோஷமாயிரு.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவர்கள், மக்களை மலையின்மேல் வரவழைத்து,","poem":1},{"lineBreak":true},{"text":"அங்கே நீதியின் பலிகளைச் செலுத்துவார்கள்;","poem":1},{"lineBreak":true},{"text":"கடல்களிலுள்ள சம்பூரணத்தையும் மணலுக்குள்ளே மறைந்திருக்கும் பொருட்களையும் அநுபவிப்பார்கள்” என்றான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"“காத்தைக்குறித்து:","poem":1},{"lineBreak":true},{"text":"காத்திற்கு விசாலமான இடத்தைக் கொடுக்கிறவர் ஸ்தோத்திரிக்கப்பட்டவர்;","poem":1},{"lineBreak":true},{"text":"அவன் சிங்கத்தைப்போல் தங்கியிருந்து,","poem":1},{"lineBreak":true},{"text":"புயத்தையும் உச்சந்தலையையும் பீறிப்போடுவான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவன் தனக்காக முதல் இடத்தைப் பார்த்துக்கொண்டான்;","poem":1},{"lineBreak":true},{"text":"அங்கே தனக்கு நியாயப்பிரமாணிகன் கொடுத்த பங்கு பத்திரமாயிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் அவன் மக்களுக்கு முன்பாக வந்து,","poem":1},{"lineBreak":true},{"text":"மற்ற இஸ்ரவேலுடனே யெகோவாவின் நீதியையும் அவருடைய நியாயங்களையும் செய்வான்” என்றான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"“தாணைக்குறித்து: தாண் ஒரு பாலசிங்கம்,","poem":1},{"lineBreak":true},{"text":"அவன் பாசானிலிருந்து பாய்வான்” என்றான்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"“நப்தலியைக்குறித்து: நப்தலி யெகோவாவுடைய தயவினாலே திருப்தியடைந்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய ஆசீர்வாதத்தினாலே நிறைந்திருப்பான்.","poem":1},{"lineBreak":true},{"text":"நீ மேற்குத் திசையையும் தெற்குத் திசையையும் சொந்தமாக்கிக்கொள்” என்றான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஆசேரைக்குறித்து: “ஆசேர் குழந்தை பாக்கியமுடையவனாக, தன் சகோதரர்களுக்குப் பிரியமாயிருந்து,","poem":1},{"lineBreak":true},{"text":"தன் காலை எண்ணெயிலே தோய்ப்பான்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"இரும்பும் வெண்கலமும் உன் காலணியின் கீழிருக்கும்;","poem":1},{"lineBreak":true},{"text":"உன் நாட்களுக்குத்தக்கதாக உன் பெலனும் இருக்கும் என்றான்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"“யெஷூரனுடைய தேவனைப்போல் ஒருவரும் இல்லை;","poem":1},{"lineBreak":true},{"text":"அவர் உனக்கு உதவியாக வானங்களின்மேலும்","poem":1},{"lineBreak":true},{"text":"தமது மாட்சிமையோடு ஆகாய மண்டலங்களின் மேலும் ஏறிவருகிறார்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அநாதி தேவனே உனக்கு அடைக்கலம்;","poem":1},{"lineBreak":true},{"text":"அவருடைய நித்திய புயங்கள் உனக்கு ஆதாரம்;","poem":1},{"lineBreak":true},{"text":"அவர் உனக்கு முன்னின்று எதிரிகளைத் துரத்தி,","poem":1},{"lineBreak":true},{"text":"அவர்களை அழித்துப்போடு என்று கட்டளையிடுவார்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"இஸ்ரவேல் சுகமாகத் தனித்து குடியிருப்பான்;","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் ஊற்றானது","poem":1},{"noteId":17},{"text":"தானியமும் திராட்சைரசமும் உள்ள தேசத்திலே இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவருடைய வானமும் பனியைப் பெய்யும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"இஸ்ரவேலே, நீ பாக்கியவான்; யெகோவாவால் இரட்சிக்கப்பட்ட மக்களே,","poem":1},{"lineBreak":true},{"text":"உனக்கு ஒப்பானவன் யார்?","poem":1},{"lineBreak":true},{"text":"உனக்கு உதவிசெய்யும் கேடகமும் உனக்கு மகிமை பொருந்திய பட்டயமும் அவரே;","poem":1},{"lineBreak":true},{"text":"உன் எதிரிகள் உன்னை நிந்தித்துப் பேசி அடங்குவார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய மேடுகளை","poem":1},{"noteId":18},{"text":"மிதிப்பாய்” என்று சொன்னான்.","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"மோந்த்லி","reference":{"chapter":33,"verse":14}},{"noteId":17,"caller":"+","text":"வாசஸ்தலம்","reference":{"chapter":33,"verse":28}},{"noteId":18,"caller":"+","text":"முதுகுகளை.","reference":{"chapter":33,"verse":29}}]},"thisChapterLink":"/api/tam_irv/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}