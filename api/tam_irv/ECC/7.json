{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ECC","translationId":"tam_irv","name":"பிரசங்கி","commonName":"பிரசங்கி","title":"பிரசங்கி","order":21,"numberOfChapters":12,"sha256":"5c50d11615961280426572f63af790469fa0b8c2e17d80343e8e2a831cd5d411","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tam_irv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["ஞானம்"]},{"type":"verse","number":1,"content":[{"text":"விலையுயர்ந்த நறுமண தைலத்தைவிட நற்புகழும்,","poem":1},{"lineBreak":true},{"text":"ஒருவனுடைய பிறந்தநாளைவிட இறந்த நாளும் நல்லது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"விருந்து வீட்டிற்குப் போவதைவிட துக்கவீட்டிற்குப் போவது நலம்;","poem":1},{"lineBreak":true},{"text":"இதிலே எல்லா மனிதர்களின் முடிவும் காணப்படும்;","poem":1},{"lineBreak":true},{"text":"உயிரோடு இருக்கிறவன் இதைத் தன்னுடைய மனதிலே சிந்திப்பான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"சிரிப்பைவிட துக்கிப்பு நலம்; முகதுக்கத்தினாலே இருதயம் சீர்ப்படும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ஞானிகளின் இருதயம் துக்கவீட்டிலே இருக்கும்;","poem":1},{"lineBreak":true},{"text":"மூடரின் இருதயம் விருந்து வீட்டிலே இருக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஒருவன் மூடர்களின் பாடலை கேட்பதிலும்,","poem":1},{"lineBreak":true},{"text":"ஞானியின் கடிந்துகொள்ளுதலைக் கேட்பது நலம்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மூடனின் சிரிப்பு பானையின்கீழ் எரிகிற முட்களின் படபடப்பைப்போல இருக்கும்;","poem":1},{"lineBreak":true},{"text":"இதுவும் மாயையே.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இடுக்கண் ஞானியையும் பைத்தியக்காரனாக்கும்;","poem":1},{"lineBreak":true},{"text":"லஞ்சம் இருதயத்தைக் கெடுக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஒரு காரியத்தின் ஆரம்பத்தைவிட அதின் முடிவு நல்லது;","poem":1},{"lineBreak":true},{"text":"பெருமையுள்ளவனைவிட பொறுமையுள்ளவன் உத்தமன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உன்னுடைய மனதில் சீக்கிரமாகக் கோபம் கொள்ளாதே;","poem":1},{"lineBreak":true},{"text":"மூடர்களின் இருதயத்திலே கோபம் குடிகொள்ளும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இந்த நாட்களைவிட முன்னான நாட்கள் நலமாக இருந்தது என்று சொல்லாதே;","poem":1},{"lineBreak":true},{"text":"நீ இதைக்குறித்துக் கேட்பது ஞானமல்ல.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பூமியில் வசிப்பவர்களுக்கு சுதந்தரத்தோடு ஞானம் நல்லது;","poem":1},{"lineBreak":true},{"noteId":8},{"text":"இதினாலே பலனுமுண்டு.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ஞானம் கேடகம், செல்வமும் கேடகம்;","poem":1},{"lineBreak":true},{"text":"ஞானம் தன்னை உடையவர்களுக்கு வாழ்வு தரும்;","poem":1},{"lineBreak":true},{"text":"இதுவே அறிவின் மேன்மை.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவனுடைய செயலைக் கவனித்துப்பார்;","poem":1},{"lineBreak":true},{"text":"அவர் கோணலாக்கினதை நேராக்கக்கூடியவன் யார்?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"வாழ்வுகாலத்தில் நன்மையை அனுபவித்திரு,","poem":1},{"lineBreak":true},{"text":"தாழ்ந்து இருக்கும் காலத்தில் சிந்தனைசெய்;","poem":1},{"lineBreak":true},{"text":"மனிதன் தனக்குப்பின்பு வருவது ஒன்றையும் கண்டுபிடிக்கமுடியாதபடி","poem":1},{"lineBreak":true},{"text":"தேவன் இந்த இரண்டையும் ஒன்றுக்கொன்று எதிராக வைத்திருக்கிறார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இவை எல்லாவற்றையும் என்னுடைய மாயையின் நாட்களில் கண்டேன்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய நீதியிலே கெட்டுப்போகிற நீதிமானும் உண்டு,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய பாவத்திலே நீடித்திருக்கிற பாவியும் உண்டு.","poem":1}]},{"type":"verse","number":16,"content":["மிஞ்சின நீதிமானாக இருக்காதே, உன்னை அதிக ஞானியுமாகவும் ஆக்காதே; உன்னை நீ ஏன் கெடுத்துக்கொள்ளவேண்டும்?"]},{"type":"verse","number":17,"content":["மிஞ்சின துன்மார்க்கனாக இருக்காதே, அதிக பேதையுமாக இருக்காதே; உன்னுடைய காலத்திற்கு முன்பே நீ ஏன் சாகவேண்டும்?"]},{"type":"verse","number":18,"content":["நீ இதைப் பற்றிக்கொள்வதும் அதைக் கைவிடாமல் இருப்பதும் நலம்; தேவனுக்குப் பயப்படுகிறவன் இவைகள் எல்லாவற்றிலிருந்தும் காக்கப்படுவான்."]},{"type":"verse","number":19,"content":["நகரத்திலுள்ள பத்து அதிபதிகளைவிட, ஞானம் ஞானியை அதிக பெலவானாக்கும்."]},{"type":"verse","number":20,"content":["ஒரு பாவமும் செய்யாமல், நன்மையே செய்யக்கூடிய நீதிமான் பூமியில் இல்லை."]},{"type":"verse","number":21,"content":["சொல்லப்படும் எல்லா வார்த்தைகளையும் கவனிக்காதே; கவனித்தால் உன்னுடைய வேலைக்காரன் உன்னை சபிப்பதைக் கேள்விப்படவேண்டியதாகும்."]},{"type":"verse","number":22,"content":["அநேகமுறை நீயும் பிறரைச் சபித்தாயென்று, உன்னுடைய மனதிற்குத் தெரியுமே."]},{"type":"verse","number":23,"content":["இவை எல்லாவற்றையும் ஞானத்தினால் சோதித்துப்பார்த்தேன்; நான் ஞானவானாவேன் என்றேன், அது எனக்குத் தூரமானது."]},{"type":"verse","number":24,"content":["தூரமும் மகா ஆழமுமாக இருக்கிறதைக் கண்டடைகிறவன் யார்?"]},{"type":"verse","number":25,"content":["ஞானத்தையும், காரணகாரியத்தையும் விசாரித்து ஆராய்ந்து அறியவும், மதிகேட்டின் தீமையையும் புத்திமயக்கத்தின் பைத்தியத்தையும் அறியவும் என்னுடைய மனதைச் செலுத்தினேன்."]},{"type":"verse","number":26,"content":["கண்ணிகளும் வலைகளுமாகிய நெஞ்சமும், கயிறுகளுமாகிய கைகளுமுடைய பெண்ணானவள், சாவிலும் அதிக கசப்புள்ளவளென்று கண்டேன்; தேவனுக்கு முன்பாக நீதிமானாக இருக்கிறவன் அவளுக்குத் தப்புவான்; பாவியோ அவளால் பிடிபடுவான்."]},{"type":"verse","number":27,"content":["காரியத்தை அறியும்படி ஒவ்வொன்றாக விசாரணைசெய்து, இதோ, இதைக் கண்டுபிடித்தேன் என்று பிரசங்கி சொல்லுகிறான்:"]},{"type":"verse","number":28,"content":["என்னுடைய மனம் இன்னும் ஒன்றைத் தேடுகிறது, அதை நான் கண்டுபிடிக்கவில்லை; ஆயிரம் பேருக்குள்ளே ஒரு மனிதனைக் கண்டேன்; இவர்கள் எல்லோருக்குள்ளும் ஒரு பெண்ணை நான் காணவில்லை."]},{"type":"verse","number":29,"content":["இதோ, தேவன் மனிதனை நேர்மை உள்ளவனாக உண்டாக்கினார்; அவர்களோ அநேக காரியங்களைத் தேடிக்கொண்டார்கள்; இதைமட்டும் கண்டேன்."]}],"footnotes":[{"noteId":8,"caller":"+","text":"சூரியனைக் காண்கிறவர்களுக்கு","reference":{"chapter":7,"verse":11}}]},"thisChapterLink":"/api/tam_irv/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}