{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"EST","translationId":"tam_irv","name":"எஸ்தர்","commonName":"எஸ்தர்","title":"எஸ்தர்","order":17,"numberOfChapters":10,"sha256":"15457ba7b169d0d153fec442d80b8245439febf3be99abe967481bdb8ac9897e","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/tam_irv/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["மொர்தெகாயின் மேன்மை"]},{"type":"verse","number":1,"content":["ராஜாவாகிய அகாஸ்வேரு தேசத்தின்மேலும், மத்திய தரைக் கடலிலுள்ள தீவுகளின்மேலும், வரியை ஏற்படுத்தினான்."]},{"type":"verse","number":2,"content":["பலமும் வல்லமையுமான அவனுடைய எல்லா செயல்களும், ராஜா பெரியவனாக்கின மொர்தெகாயினுடைய மேன்மையின் மகத்துவமும், மேதியா பெர்சியா ராஜாக்களின் நாளாகம புத்தகத்தில் எழுதியிருக்கிறது."]},{"type":"verse","number":3,"content":["யூதனாகிய மொர்தெகாய் ராஜாவாகிய அகாஸ்வேருவுக்கு இரண்டாவதாக இருந்தவனும், யூதர்களுக்குள் பெரியவனும், தன்னுடைய திரளான சகோதரர்களுக்குப் பிரியமானவனுமாக இருந்ததும் அன்றி தன்னுடைய மக்களுடைய நன்மையைத்தேடி, தன்னுடைய மக்களுக்கெல்லாம் சமாதானமுண்டாகப் பேசுகிறவனுமாக இருந்தான்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/EST/9.json","previousChapterAudioLinks":{},"numberOfVerses":3}