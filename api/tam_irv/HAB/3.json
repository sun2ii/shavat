{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HAB","translationId":"tam_irv","name":"ஆபகூக்","commonName":"ஆபகூக்","title":"ஆபகூக்","order":35,"numberOfChapters":3,"sha256":"d6b2813a6dfe3227e69c11c4e19c16317b305e473b2cfc3971e7b56655406717","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_irv/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["தீர்க்கதரிசியின் விண்ணப்பம்"]},{"type":"verse","number":1,"content":["ஆபகூக் தீர்க்கதரிசி சிகாயோனில் பாடின விண்ணப்பம்."]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே, நீர் வெளிப்படுத்தினதை நான் கேட்டேன்,","poem":1},{"lineBreak":true},{"text":"எனக்குப் பயமுண்டானது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, வருடங்களின் நடுவிலே உம்முடைய செயலை உயிர்ப்பியும்,","poem":1},{"lineBreak":true},{"text":"வருடங்களின் நடுவிலே அதை விளங்கச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"கோபித்தாலும் இரக்கத்தை நினைத்தருளும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேவன் தேமானிலிருந்தும்,","poem":1},{"lineBreak":true},{"text":"பரிசுத்தர் பாரான் மலையிலிருந்தும் வந்தார்; (சேலா.)","poem":1},{"lineBreak":true},{"text":"அவருடைய மகிமை வானங்களை மூடிக்கொண்டது;","poem":1},{"lineBreak":true},{"text":"அவர் துதியினால் பூமி நிறைந்தது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவருடைய பிரகாசம் சூரியனைப்போலிருந்தது;","poem":1},{"lineBreak":true},{"text":"அவருடைய கரத்திலிருந்து கிரணங்கள் வீசின;","poem":1},{"lineBreak":true},{"text":"அங்கே அவருடைய பராக்கிரமம் மறைந்திருந்தது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவருக்கு முன்பாகக் கொள்ளைநோய் சென்றது;","poem":1},{"lineBreak":true},{"text":"அவர் அடிகளிலிருந்து எரிபந்தமான காய்ச்சல் புறப்பட்டது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் நின்று பூமியை அளந்தார்","poem":1},{"noteId":1},{"text":";","poem":1},{"lineBreak":true},{"text":"அவர் பார்த்து அந்நிய மக்களைக் கரையச்செய்தார்;","poem":1},{"lineBreak":true},{"text":"முந்தின மலைகள் சிதறடிக்கப்பட்டது,","poem":1},{"lineBreak":true},{"text":"என்றுமுள்ள மலைகள் தாழ்ந்தது;","poem":1},{"lineBreak":true},{"text":"அவருடைய நடைகள் நித்திய நடைகளாயிருந்தது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"கூஷானின் கூடாரங்கள் வருத்தத்தில் அகப்பட்டிருக்கக்கண்டேன்;","poem":1},{"lineBreak":true},{"text":"மீதியான் தேசத்தின் கூடாரங்கள் நடுங்கின.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா நதிகளின்மேல் கோபமாயிருந்தாரோ?","poem":1},{"lineBreak":true},{"text":"தேவரீர் உம்முடைய குதிரைகளின்மேலும் காப்பாற்றுகிற உம்முடைய இரதங்களின்மேலும் ஏறிவருகிறபோது,","poem":1},{"lineBreak":true},{"text":"உமது கோபம் நதிகளுக்கும் உமது சினம் சமுத்திரத்திற்கும் விரோதமாயிருந்ததோ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"கோத்திரங்களுக்கு ஆணையிட்டுக்கொடுத்த வாக்கின்படியே உம்முடைய வில் நாணேற்றப்பட்டதாக விளங்கினது; (சேலா.)","poem":1},{"lineBreak":true},{"text":"நீரே பூமியைப் பிளந்து ஆறுகளை உண்டாக்கினீர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"மலைகள் உம்மைக்கண்டு நடுங்கின;","poem":1},{"lineBreak":true},{"text":"தண்ணீர் திரண்டு கடந்துபோனது;","poem":1},{"lineBreak":true},{"text":"கடல் இரைந்தது, அதின் அலைகளை","poem":1},{"noteId":2},{"text":"உயர எழுந்தது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சந்திரனும் சூரியனும் தன்தன் மண்டலத்தில் நின்றன;","poem":1},{"lineBreak":true},{"text":"உமது அம்புகளின் வெளிச்சத்திலும்,","poem":1},{"lineBreak":true},{"text":"உமது ஈட்டியினுடைய மின்னல் பிரகாசத்திலும் நடந்தன.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீர் கோபத்துடன் பூமியில் நடந்தீர்,","poem":1},{"lineBreak":true},{"text":"உக்கிரத்துடன் மக்களைப் போரடித்தீர்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"உமது மக்களின் பாதுகாப்பிற்காகவும்","poem":1},{"lineBreak":true},{"text":"நீர் அபிஷேகம்செய்தவனின் பாதுகாப்பிற்காகவுமே நீர் புறப்பட்டீர்;","poem":1},{"lineBreak":true},{"text":"கழுத்தளவாக அஸ்திபாரத்தைத் திறப்பாக்கி,","poem":1},{"lineBreak":true},{"text":"தீயவனுடைய வீட்டிலிருந்த தலைவனை வெட்டினீர்; (சேலா)","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"என்னைச் சிதறடிப்பதற்குப் பெருங்காற்றைப்போல் வந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"சிறுமையானவனை மறைவிடத்திலே அழிப்பது அவர்களுக்குச் சந்தோஷமாயிருந்தது;","poem":1},{"lineBreak":true},{"text":"நீர் அவனுடைய ஈட்டிகளினாலேயே அவனுடைய சேனைகளின் அதிபதிகளை","poem":1},{"noteId":3},{"text":"உருவக் குத்தினீர்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"திரளான தண்ணீர் குவியலாகிய சமுத்திரத்திற்குள் உமது குதிரைகளுடன் நடந்துபோனீர்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நான் கேட்டபோது என் குடல் குழம்பியது;","poem":1},{"lineBreak":true},{"text":"அந்தச் சத்தத்திற்கு என் உதடுகள் துடித்தது; என் எலும்புகளில் பெலவீனம் உண்டானது;","poem":1},{"lineBreak":true},{"text":"என் நிலையிலே நடுங்கினேன்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் எங்களோடு எதிர்க்கும் மக்கள் வரும்போது,","poem":1},{"lineBreak":true},{"text":"இக்கட்டுநாளிலே நான் இளைப்பாறுதல் அடைவேன்.","poem":1}]},{"type":"heading","content":["விசுவாசப் பாடல்"]},{"type":"verse","number":17,"content":[{"text":"அத்திமரம் துளிர்விடாமற்போனாலும்,","poem":1},{"lineBreak":true},{"text":"திராட்சைச்செடிகளில் பழம் உண்டாகாமற்போனாலும்,","poem":1},{"lineBreak":true},{"text":"ஒலிவமரத்தின் பலன் இல்லாமல் போனாலும்,","poem":1},{"lineBreak":true},{"text":"வயல்கள் தானியத்தை விளைவிக்காமற்போனாலும்,","poem":1},{"lineBreak":true},{"text":"கிடையில் ஆட்டுமந்தைகள் முதலற்றுப்போனாலும்,","poem":1},{"lineBreak":true},{"text":"தொழுவத்திலே மாடுகள் இல்லாமற்போனாலும்,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நான் யெகோவாவுக்குள் மகிழ்ச்சியாயிருப்பேன்,","poem":1},{"lineBreak":true},{"text":"என் இரட்சிப்பின் தேவனுக்குள் களிகூருவேன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ஆண்டவராகிய யெகோவா என் பெலன்;","poem":1},{"lineBreak":true},{"text":"அவர் என் கால்களை மான்கால்களைப்போலாக்கி,","poem":1},{"lineBreak":true},{"text":"உயரமான இடங்களில் என்னை நடக்கச்செய்வார். இது நெகிநோத் என்னும் வாத்தியத்தில் வாசிக்க இராகத்தலைவனுக்கு ஒப்புவிக்கப்பட்டப் பாடல்.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"அசைத்தார்","reference":{"chapter":3,"verse":6}},{"noteId":2,"caller":"+","text":"கைகளை","reference":{"chapter":3,"verse":10}},{"noteId":3,"caller":"+","text":"அவனுடைய தலையை","reference":{"chapter":3,"verse":14}}]},"thisChapterLink":"/api/tam_irv/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}