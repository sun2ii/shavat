{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_irv","name":"ஏசாயா","commonName":"ஏசாயா","title":"ஏசாயா","order":23,"numberOfChapters":66,"sha256":"13da787b042146b93ba2227f2d19d8f9ed5a26b0acf0c4ed3adef2346258e4f9","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_irv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["துதியின் பாடல்கள்"]},{"type":"verse","number":1,"content":["அக்காலத்திலே நீ சொல்வது:",{"text":"“யெகோவாவே, நான் உம்மைத் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"நீர் என்மேல் கோபமாயிருந்தீர்; ஆனாலும் உம்முடைய கோபம் நீங்கியது;","poem":1},{"lineBreak":true},{"text":"நீர் என்னைத் தேற்றுகிறீர்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"இதோ, தேவனே என் இரட்சிப்பு;","poem":1},{"lineBreak":true},{"text":"நான் பயப்படாமல் நம்பிக்கையாயிருப்பேன்;","poem":1},{"lineBreak":true},{"text":"கர்த்தராகிய யேகோவா என் பெலனும், என் கீதமுமானவர்;","poem":1},{"lineBreak":true},{"text":"அவரே எனக்கு இரட்சிப்புமானவர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீங்கள் இரட்சிப்பின் ஊற்றுகளிலிருந்து","poem":1},{"lineBreak":true},{"text":"மகிழ்ச்சியுடன் தண்ணீர் மொண்டுகொள்வீர்கள்.","poem":1}]},{"type":"verse","number":4,"content":["அக்காலத்திலே நீங்கள் சொல்வது:",{"text":"யெகோவாவை துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் நாமத்தைத் தொழுதுகொள்ளுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய செய்கைகளை மக்களுக்குள்ளே அறிவியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய நாமம் உயர்ந்ததென்று பிரஸ்தாபம் செய்யுங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவைக் கீர்த்தனம்செய்யுங்கள்,","poem":1},{"lineBreak":true},{"text":"அவர் மகத்துவமான செயல்களைச் செய்தார்;","poem":1},{"lineBreak":true},{"text":"இது பூமியெங்கும் அறியப்படக்கடவது என்பீர்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"சீயோனில் குடியிருக்கிறவளே,","poem":1},{"lineBreak":true},{"text":"நீ சத்தமிட்டுக் கெம்பீரி;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் பரிசுத்தர் உன் நடுவில் பெரியவராயிருக்கிறார்.”","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}