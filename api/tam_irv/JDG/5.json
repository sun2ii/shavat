{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JDG","translationId":"tam_irv","name":"நியாயாதிபதிகள்","commonName":"நியாயாதிபதிகள்","title":"நியாயாதிபதிகள்","order":7,"numberOfChapters":21,"sha256":"a942f4d46f801356f5033ac32327a13056ec47e9a3e32853e66847aa5694b359","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/tam_irv/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["தெபொராளின் பாடல்"]},{"type":"verse","number":1,"content":["அந்த நாட்களிலே தெபொராளும் அபினோகாமின் மகன் பாராக்கும் பாடினது:"]},{"type":"verse","number":2,"content":[{"text":"“","poem":1},{"noteId":5},{"text":"யுத்தத்தை இஸ்ரவேலின் அதிபதிகள் நடத்தினதற்காகவும்,","poem":1},{"lineBreak":true},{"text":"மக்கள் மனப்பூர்வமாகத் தங்களை ஒப்புக்கொடுத்ததற்காகவும் அவரை ஸ்தோத்திரியுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ராஜாக்களே, கேளுங்கள்;","poem":1},{"lineBreak":true},{"text":"அதிபதிகளே, செவிகொடுங்கள்;","poem":1},{"lineBreak":true},{"text":"நான் யெகோவாவைப் பாடி, இஸ்ரவேலின் தேவனாகிய யெகோவாவைக் கீர்த்தனம்செய்வேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் சேயீரிலிருந்து புறப்பட்டு,","poem":1},{"lineBreak":true},{"text":"ஏதோமின் வெளியிலிருந்து நடந்து வரும்போது,","poem":1},{"lineBreak":true},{"text":"பூமி அதிர்ந்தது, வானம் பொழிந்தது,","poem":1},{"lineBreak":true},{"text":"மேகங்களும் தண்ணீராகப் பொழிந்தது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்கு முன்பாக மலைகள் அதிர்ந்தது;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் தேவனாகிய யெகோவாவுக்கு முன்பாக சீனாய் மலையும் அதிர்ந்தது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ஆனாத்தின் மகனான சம்காரின் நாட்களிலும்,","poem":1},{"lineBreak":true},{"text":"யாகேலின் நாட்களிலும், பெரும்பாதைகள்","poem":1},{"lineBreak":true},{"text":"பாழாய்ப் போனது; வழியில் நடக்கிறவர்கள் பக்கவழியாக நடந்தார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தெபொராளாகிய நான் எழும்பும்வரைக்கும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலிலே நான் தாயாக எழும்பும்வரைக்கும்,","poem":1},{"lineBreak":true},{"text":"கிராமங்கள் பாழாய்ப்போயின, இஸ்ரவேலின் கிராமங்கள் பாழாய்ப்போனது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"புதிய தெய்வங்களைத் தெரிந்துகொண்டார்கள்; அப்பொழுது யுத்தம் வாசல்வரையும் வந்தது; இஸ்ரவேலிலே 40,000 பேருக்குள்ளே கேடகமும் ஈட்டியும் காணப்பட்டதுண்டோ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மக்களுக்குள்ளே தங்களை மனப்பூர்வமாக ஒப்புக்கொடுத்த","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் அதிபதிகளை என்னுடைய இருதயம் நாடுகிறது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை ஸ்தோத்திரியுங்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"வெள்ளைக் கழுதைகளின் சேணத்தின் விரிப்புகளில் வீற்றிருக்கிறவர்களே,","poem":1},{"lineBreak":true},{"text":"வழியில் நடக்கிறவர்களே,","poem":1},{"lineBreak":true},{"text":"இதைப் பற்றி யோசியுங்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தண்ணீர் மொண்டுகொள்ளும் இடங்களில் வில்வீரர்களின்","poem":1},{"noteId":6},{"text":"இரைச்சலுக்கு நீங்கினவர்கள்","poem":1},{"lineBreak":true},{"text":"அங்கே யெகோவாவின் நீதிநியாயங்களையும்,","poem":1},{"lineBreak":true},{"text":"அவர் இஸ்ரவேலிலுள்ள தமது கிராமங்களுக்குச் செய்த","poem":1},{"lineBreak":true},{"text":"நீதிநியாயங்களையும் அறிவிப்பார்கள்;","poem":1},{"lineBreak":true},{"text":"அதுமுதல் யெகோவாவின் மக்கள்","poem":1},{"lineBreak":true},{"text":"நகரத்தின் வாசல்களில் போய் இறங்குவார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"விழி, விழி, தெபொராளே, விழி, விழி, பாட்டுப்பாடு;","poem":1},{"lineBreak":true},{"text":"பாராக்கே, எழும்பு; அபினோகாமின் குமாரனே,","poem":1},{"lineBreak":true},{"text":"உன்னைச் சிறையாக்கினவர்களைச் சிறையாக்கிக்கொண்டுபோ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"மீதியாக இருந்தவர்கள் மக்களின் தலைவர்களை ஆளும்படி செய்தார்;","poem":1},{"lineBreak":true},{"text":"யெகோவா எனக்குப் பெலசாலிகளின்மேல் ஆளுகை தந்தார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அமலேக்குக்கு விரோதமாக இவர்களுடைய வேர் எப்பிராயீமிலிருந்து துளிர்த்தது;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய மக்களுக்குள்ளே பென்யமீன் மனிதர்கள் உனக்குப் பின்சென்றார்கள்;","poem":1},{"lineBreak":true},{"text":"மாகீரிலிருந்து அதிபதிகளும்,","poem":1},{"lineBreak":true},{"text":"செபுலோனிலிருந்து எழுதுகோலைப் பிடிக்கிறவர்களும் இறங்கிவந்தார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இசக்காரின் பிரபுக்களும் தெபொராளோடு இருந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"பாராக்கைப்போல இசக்கார் மனிதர்களும்","poem":1},{"lineBreak":true},{"text":"பள்ளத்தாக்கில் கால்நடையாக அனுப்பப்பட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"ரூபனின் பிரிவினைகளால் உண்டான இருதயத்தின் நினைவுகள் மிகுதி.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"மந்தைகளின் சத்தத்தைக் கேட்க,","poem":1},{"lineBreak":true},{"text":"நீ தொழுவங்களின் நடுவே இருந்துவிட்டது என்ன?","poem":1},{"lineBreak":true},{"text":"ரூபனின் பிரிவினைகளால் மனதின் வேதனைகள் மிகுதி.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"கீலேயாத் மனிதர்கள் யோர்தானுக்கு அக்கரையிலே இருந்துவிட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"தாண் மனிதர்கள் கப்பல்களில் தங்கியிருந்தது என்ன?","poem":1},{"lineBreak":true},{"text":"ஆசேர் மனிதர்கள் கடற்கரையிலே தங்கி,","poem":1},{"lineBreak":true},{"text":"மூன்று பக்கமும் தரைசூழ்ந்தகடல் பகுதிகளில் வாழ்ந்தார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"செபுலோனும் நப்தலியும் போர்க்களத்து முனையிலே தங்கள் உயிரை எண்ணாமல்","poem":1},{"lineBreak":true},{"text":"மரணத்திற்குத் துணிந்து நின்றார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ராஜாக்கள் வந்து யுத்தம்செய்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது கானானியர்களின் ராஜாக்கள் மெகிதோவின் தண்ணீர் அருகான தானாக்கிலே யுத்தம்செய்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு வெள்ளி கொள்ளைப் பொருளாக கிடைக்கவில்லை.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"வானத்திலிருந்து யுத்தம் உண்டாயிற்று;","poem":1},{"lineBreak":true},{"text":"நட்சத்திரங்கள் தங்கள் வானமண்டலங்களிலிருந்து சிசெராவோடு யுத்தம் செய்தன.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"கீசோன் நதி, பூர்வ நதியாகிய கீசோன் நதியே,","poem":1},{"lineBreak":true},{"text":"அவர்களை அடித்துக்கொண்டு போனது; என்னுடைய ஆத்துமாவே,","poem":1},{"lineBreak":true},{"text":"நீ பெலவான்களை மிதித்தாய்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அப்பொழுது குதிரைகளின் குளம்புகள் பாய்ச்சலினாலே,","poem":1},{"lineBreak":true},{"text":"பெலவான்களின் பாய்ச்சலினாலேயே, பிளந்துபோயின.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"மேரோசைச் சபியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அதின் குடிகளை நிச்சயமாகவே சபியுங்கள் என்று","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய தூதனானவர் சொல்லுகிறார்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் யெகோவாவோடு துணை நிற்க வரவில்லை;","poem":1},{"lineBreak":true},{"text":"பலசாலிகளுக்கு எதிராக அவர்கள் யெகோவாவோடு துணைநிற்க வரவில்லையே.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"பெண்களுக்குள்ளே கேனியனான ஏபேரின் மனைவியாகிய யாகேல் ஆசீர்வதிக்கப்பட்டவள்;","poem":1},{"lineBreak":true},{"text":"கூடாரத்தில் தங்கியிருக்கிற பெண்களுக்குள்ளே அவள் ஆசீர்வதிக்கப்பட்டவளே.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"தண்ணீரைக் கேட்டான்,","poem":1},{"lineBreak":true},{"text":"பாலைக் கொடுத்தாள்;","poem":1},{"lineBreak":true},{"text":"ராஜாக்களின் கிண்ணத்திலே வெண்ணெயைக் கொண்டுவந்து கொடுத்தாள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தன்னுடைய கையால் ஆணியையும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வலது கையால் தொழிலாளரின் சுத்தியையும் பிடித்து,","poem":1},{"lineBreak":true},{"text":"சிசெராவை அடித்தாள்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய தலையில் உருவக்குத்தி,","poem":1},{"lineBreak":true},{"text":"அவனுடைய தலையை உடைத்துப்போட்டாள்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அவன் அவளுடைய காலின் அருகே மடங்கி விழுந்தான்;","poem":1},{"lineBreak":true},{"text":"அவன் எங்கே மடங்கி விழுந்தானோ அங்கே இறந்துகிடந்தான்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"“சிசெராவின் தாய் ஜன்னலில் நின்று ஜன்னல் வழியாகப் பார்த்துக்கொண்டிருந்து:","poem":1},{"lineBreak":true},{"text":"அவனுடைய இரதம் வராமல் தாமதமானது என்ன?","poem":1},{"lineBreak":true},{"text":"அவனுடைய இரதங்களின் ஓட்டம் தாமதிக்கிறது என்ன’ என்று புலம்பினாள்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அவளுடைய பெண்களில் புத்திசாலிகள் அவளுக்கு பதில் சொன்னதுமின்றி, அவள் தனக்குத் தானே மறுமொழியாக:","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அவர்கள் கொள்ளையைக் கண்டுபிடிக்கவில்லையோ, அதைப் பங்கிடவேண்டாமோ,","poem":1},{"lineBreak":true},{"text":"ஆளுக்கு ஒன்று அல்லது இரண்டு பெண்களையும்,","poem":1},{"lineBreak":true},{"text":"சிசெராவுக்குக் கொள்ளையிட்ட பலவர்ணமான ஆடைகளையும்,","poem":1},{"lineBreak":true},{"text":"கொள்ளையிட்ட பலவர்ணமான சித்திரத் தையலாடைகளையும்,","poem":1},{"noteId":7},{"text":"என்","poem":1},{"lineBreak":true},{"text":"கழுத்திற்கு இருபுறமும் பொருந்தும் சித்திர வேலை செய்யப்பட்டுள்ள பலநிறமான ஆடையையும் கொடுக்கவேண்டாமோ என்றாள்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்மைப் பகைக்கிற அனைவரும் இப்படியே அழியட்டும்;","poem":1},{"lineBreak":true},{"text":"அவரிடம் அன்புகூருகிறவர்களோ, வல்லமையோடு உதிக்கிற சூரியனைப்போல இருக்கட்டும்” என்று பாடினார்கள். பின்பு தேசம் 40 வருடங்கள் அமைதலாக இருந்தது.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"யெகோவா இஸ்ரவேலுக்காக நீதியைச் சரிக்கட்டியதற்காகவும்","reference":{"chapter":5,"verse":2}},{"noteId":6,"caller":"+","text":"சங்கீத பாடகர்கள்","reference":{"chapter":5,"verse":11}},{"noteId":7,"caller":"+","text":"கொள்ளையிட்டவர்களின்","reference":{"chapter":5,"verse":30}}]},"thisChapterLink":"/api/tam_irv/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}