{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["சோப்பாரின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அப்பொழுது நாகமாத்தியனாகிய சோப்பார் மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“ஏராளமான வார்த்தைகளுக்கு பதில் சொல்லவேண்டாமோ?","poem":1},{"lineBreak":true},{"text":"வாயடிக்கிறவன் நீதிமானாக விளங்குவானோ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உம்முடைய வீம்புவார்த்தைகளுக்கு மனிதர் மவுனமாயிருப்பார்களோ?","poem":1},{"lineBreak":true},{"text":"நீர் கேலிசெய்யும்போது, ஒருவரும் உம்மை வெட்கப்படுத்தவேண்டாமோ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என் சொல் சுத்தம் என்றும்,","poem":1},{"lineBreak":true},{"text":"நான் தேவனாகிய உம்முடைய பார்வைக்கு சுத்தமானவன் என்றும் நீர் சொல்லுகிறீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஆனாலும் தேவன் பேசி,","poem":1},{"lineBreak":true},{"text":"உமக்கு விரோதமாகத் தம்முடைய உதடுகளைத் திறந்து,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உமக்கு ஞானத்தின் இரகசியங்களை வெளிப்படுத்தினால் நலமாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"உள்ளபடி பார்த்தால், அது இரண்டுமடங்காக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"ஆகையால் உம்முடைய அக்கிரமத்திற்கேற்றபடி தேவன் உம்மைத் தண்டிக்கவில்லையென்று அறிந்துகொள்ளும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவனுடைய மறைவான ஞானத்தை நீர் ஆராய்ந்து,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லவருடைய சம்பூரணத்தை நீர் அறியமுடியுமோ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அது வானம்வரை உயர்ந்தது;","poem":1},{"lineBreak":true},{"text":"உம்மால் என்ன ஆகும்? அது பாதாளத்திலும் ஆழமானது,","poem":1},{"lineBreak":true},{"text":"நீர் அறிந்து கொள்வது என்ன?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அதின் அளவு பூமியைவிட நீளமும்,","poem":1},{"lineBreak":true},{"text":"சமுத்திரத்தைவிட அகலமுமாயிருக்கிறது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர் பிடித்தாலும், அவர் அடைத்தாலும்,","poem":1},{"lineBreak":true},{"text":"அவர் நியாயத்தில் கொண்டுவந்து நிறுத்தினாலும்,","poem":1},{"lineBreak":true},{"text":"அவரைத் தடை செய்கிறவன் யார்?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மனிதருடைய மாயத்தை அவர் அறிவார்;","poem":1},{"lineBreak":true},{"text":"அக்கிரமத்தை அவர் கண்டும்,","poem":1},{"lineBreak":true},{"text":"அதைக் கவனிக்காமல் இருப்பாரோ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"புத்தியில்லாத மனிதன் காட்டுக்கழுதைக்குட்டிக்கு ஒப்பாகப் பிறந்திருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"அறிவுள்ளவனாக இருக்கிறான்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீர் உம்முடைய இருதயத்தை ஆயத்தப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"உம்முடைய கைகளை அவருக்கு நேராக விரித்தால் நலமாயிருக்கும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"உம்முடைய கையிலே அநீதி இருந்தால்,","poem":1},{"lineBreak":true},{"text":"அதைத் தூரத்தில் அகற்றிவிட்டு, அநியாயம் உம்முடைய கூடாரங்களில் தங்கவிடாதிரும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அப்பொழுது உம்முடைய முகத்தை வெட்கமில்லாமல் தலைநிமிர்ந்து,","poem":1},{"lineBreak":true},{"text":"பயப்படாமல் பலன்கொண்டிருப்பீர்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அப்பொழுது நீர் வருத்தத்தை மறந்து,","poem":1},{"lineBreak":true},{"text":"கடந்துபோன தண்ணீரைப்போல அதை நினைப்பீர்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அப்பொழுது உம்முடைய ஆயுள்காலம் நடுப்பகலைவிட பிரகாசமாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"இருள் அடைந்த நீர் விடியற்காலத்தைப்போலிருப்பீர்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நம்பிக்கை உண்டாயிருக்கிறதினால் பெலனாயிருப்பீர்;","poem":1},{"lineBreak":true},{"text":"தோண்டி ஆராய்ந்து சுகமாகப் படுத்துக்கொள்வீர்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பயமுறுத்துவாரில்லாமல் தூங்குவீர்;","poem":1},{"lineBreak":true},{"text":"அநேகர் உமது முகத்தை நோக்கி விண்ணப்பம் செய்வார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"துன்மார்க்கருடைய கண்கள் பூத்துப்போய்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் அடைக்கலம் அவர்களை விட்டு அகன்று,","poem":1},{"lineBreak":true},{"text":"அவர்கள் நம்பிக்கை மரணமடைகிறவன் சுவாசம்போல் அழிந்துபோகும்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}