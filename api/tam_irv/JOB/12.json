{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["யோபுவின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["யோபு மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“ஆம், நீங்களே ஞானமுள்ள மக்கள்;","poem":1},{"lineBreak":true},{"text":"உங்களுடனே ஞானம் சாகும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உங்களைப்போல எனக்கும் புத்தியுண்டு;","poem":1},{"lineBreak":true},{"text":"உங்களைவிட நான் தாழ்ந்தவன் அல்ல;","poem":1},{"lineBreak":true},{"text":"இப்படிப்பட்டவைகளை அறியாதவன் யார்?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என் நண்பர்களால் நான் நிந்திக்கப்பட்டு,","poem":1},{"lineBreak":true},{"text":"தேவனை நோக்கிக் கூப்பிடுவேன்; அவர் எனக்குத் திரும்ப பதில் அருளுவார்;","poem":1},{"lineBreak":true},{"text":"உத்தமனாகிய நீதிமான் கேலிசெய்யப்படுகிறான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஆபத்திற்குள்ளானவன் சுகமாயிருக்கிறவனுடைய நினைவில் இகழ்ச்சியடைகிறான்;","poem":1},{"lineBreak":true},{"text":"கால் தடுமாறினவர்களுக்கு இது சம்பவிக்கும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"திருடர்களுடைய கூடாரங்களில் செல்வமுண்டு;","poem":1},{"lineBreak":true},{"text":"தேவனைக் கோபப்படுத்துகிறவர்களுக்கு பாதுகாப்புண்டு;","poem":1},{"lineBreak":true},{"text":"அவர்கள் கையிலே தேவன் கொண்டுவந்து கொடுக்கிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இப்போதும் நீ மிருகங்களைக் கேட்டுப்பார்,","poem":1},{"lineBreak":true},{"text":"அவைகள் உனக்குப் போதிக்கும் ஆகாயத்துப் பறவைகளைக் கேள்,","poem":1},{"lineBreak":true},{"text":"அவைகள் உனக்கு அறிவிக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அல்லது பூமியை விசாரித்துக் கேள்,","poem":1},{"lineBreak":true},{"text":"அது உனக்குப் போதிக்கும்;","poem":1},{"lineBreak":true},{"text":"சமுத்திரத்தின் மீன்களைக் கேள், அவைகள் உனக்கு விவரிக்கும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய கரம் இதைச் செய்ததென்று இவைகள் எல்லாவற்றினாலும் அறியாதவன் யார்?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எல்லா உயிரினங்களின் உயிரும்,","poem":1},{"lineBreak":true},{"text":"மாம்சமான எல்லா மனிதரின் ஆவியும் அவர் கையிலிருக்கிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"வாயானது ஆகாரத்தை ருசிபார்க்கிறதுபோல,","poem":1},{"lineBreak":true},{"text":"காதானது வார்த்தைகளைச் சோதித்துப்பார்க்கிறதல்லவா?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"முதியோரிடத்தில் ஞானமும் வயது சென்றவர்களிடத்தில் புத்தியும் இருக்குமே.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவரிடத்தில் ஞானமும் வல்லமையும் எத்தனை அதிகமாக இருக்கும்?","poem":1},{"lineBreak":true},{"text":"அவருக்குத்தான் ஆலோசனையும் புத்தியும் உண்டு.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"இதோ, அவர் இடித்தால் கட்டமுடியாது;","poem":1},{"lineBreak":true},{"text":"அவர் மனிதனை அடைத்தால் விடுவிக்கமுடியாது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இதோ, அவர் தண்ணீர்களை அடக்கினால் எல்லாம் உலர்ந்துபோகும்;","poem":1},{"lineBreak":true},{"text":"அவர் அவைகளை வரவிட்டால், பூமியைத் தலைகீழாக மாற்றும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவரிடத்தில் பெலனும் ஞானமுமுண்டு;","poem":1},{"lineBreak":true},{"text":"மோசம் போகிறவனும் மோசம் போக்குகிறவனும்,","poem":1},{"lineBreak":true},{"text":"அவர் கையின் கீழிருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவர் ஆலோசனைக்காரரைச் சிறைபிடித்து,","poem":1},{"lineBreak":true},{"text":"நியாயாதிபதிகளின் புத்தியை மயக்குகிறார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவர் ராஜாக்களுடைய கட்டுகளை அவிழ்த்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் இடுப்புகளில் துணியைக்கட்டுகிறார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவர் மந்திரிகளைச் சிறைபிடித்துக் கொண்டுபோய்,","poem":1},{"lineBreak":true},{"text":"பெலவான்களைக் கவிழ்த்துப்போடுகிறார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவர் நம்பிக்கையுள்ளவர்களுடைய வார்த்தையை அகற்றி,","poem":1},{"lineBreak":true},{"text":"முதிர்வயதுள்ளவர்களின் ஆலோசனையைத் தள்ளிப்போடுகிறார்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவர் பிரபுக்களின்மேல் இகழ்ச்சி வரச்செய்கிறார்;","poem":1},{"lineBreak":true},{"text":"பலவான்களின் வார்க்கச்சையைத் தளர்ந்துபோகச் செய்கிறார்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவர் மறைவிடத்திலிருக்கிற ஆழங்களை வெளியரங்கமாக்கி,","poem":1},{"lineBreak":true},{"text":"மரண இருளை வெளிச்சத்தில் கொண்டுவருகிறார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவர் தேசங்களைப் பெருகவும் அழியவும் செய்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவர் தேசங்களைப் பரவவும் குறுகவும் செய்கிறார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அவர் பூமியிலுள்ள தேசத்தின் அதிபதிகளின் நெஞ்சை அகற்றிப்போட்டு,","poem":1},{"lineBreak":true},{"text":"அவர்களை வழியில்லாத வனாந்திரத்திலே அலையச்செய்கிறார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவர்கள் வெளிச்சமில்லாத இருளிலே தடவித்திரிகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"வெறித்தவர்களைப்போல அவர்களைத் தடுமாறி அலையவைக்கிறார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}