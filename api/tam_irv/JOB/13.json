{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"இதோ, இவைகள் எல்லாவற்றையும் என் கண் கண்டு,","poem":1},{"lineBreak":true},{"text":"என் காது கேட்டு அறிந்திருக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நீங்கள் அறிந்திருக்கிறதை நானும் அறிந்திருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"நான் உங்களுக்குத் தாழ்ந்தவன் அல்ல.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவனுடன் நான் பேசினால் நல்லது;","poem":1},{"lineBreak":true},{"text":"தேவனுடன் நியாயத்திற்காக வழக்காட விரும்புவேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நீங்கள் உண்மையில் பொய்யை இணைக்கிறவர்கள்;","poem":1},{"lineBreak":true},{"text":"நீங்கள் எல்லோரும் காரியத்திற்கு உதவாத வைத்தியர்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீங்கள் பேசாமலிருந்தால் நலமாகும்;","poem":1},{"lineBreak":true},{"text":"அது உங்களுக்கு ஞானமாயிருக்கும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீங்கள் என் நியாயத்தைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"என் உதடுகள் சொல்லும் விசேஷங்களைக் கவனியுங்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீங்கள் தேவனுக்காக நியாயமில்லாமல் பேசி,","poem":1},{"lineBreak":true},{"text":"அவருக்காக வஞ்சகமாகப் பேசவேண்டுமோ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவருக்கு முகதாட்சிணியம் செய்வீர்களோ?","poem":1},{"lineBreak":true},{"text":"தேவனுக்காக வழக்காடுவீர்களோ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் உங்களை ஆராய்ந்துபார்த்தால் அது உங்களுக்கு நலமாயிருக்குமோ?","poem":1},{"lineBreak":true},{"text":"மனிதனைக் கேலி செய்கிறதுபோல அவரைக் கேலி செய்வீர்களோ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நீங்கள் மறைமுகமாக முகதாட்சிணியம் செய்தால்,","poem":1},{"lineBreak":true},{"text":"அவர் உங்களை எவ்விதத்திலும் கண்டிப்பார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவருடைய மகத்துவம் உங்களை அதிர்ச்சியடையச் செய்யாதோ?","poem":1},{"lineBreak":true},{"text":"அவருடைய பயங்கரம் உங்களைப் பிடிக்கமாட்டாதோ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உங்கள் பெயரை நினைக்கச்செய்யும் அடையாளங்கள் சாம்பலுக்கு இணையானது;","poem":1},{"lineBreak":true},{"text":"உங்கள் மேட்டிமைகள் சேற்றுக்குவியல்களுக்குச் சமானம்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீங்கள் மவுனமாயிருங்கள்,","poem":1},{"lineBreak":true},{"text":"நான் பேசுகிறேன்,","poem":1},{"lineBreak":true},{"text":"எனக்கு வருகிறது வரட்டும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நான் என் பற்களினால் என் சதையைப் பிடுங்கி,","poem":1},{"lineBreak":true},{"text":"என் உயிரை என் கையிலே ஏன் வைக்கவேண்டும்?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவர் என்னைக் கொன்றுபோட்டாலும்,","poem":1},{"lineBreak":true},{"text":"அவர்மேல் நம்பிக்கையாயிருப்பேன்; ஆனாலும் என் வழிகளை அவருக்கு முன்பாக நிரூபிப்பேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவரே என் பாதுகாப்பு;","poem":1},{"lineBreak":true},{"text":"மாயக்காரனோ அவர் முன்னிலையில் சேரமாட்டான்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என் வசனத்தையும், நான் சொல்லிக் காண்பிக்கிறதையும்,","poem":1},{"lineBreak":true},{"text":"உங்கள் காதுகளால் கவனமாகக் கேளுங்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"இதோ, என் நியாயங்களை வரிசையாக வைத்தேன்;","poem":1},{"lineBreak":true},{"text":"என் நீதி விளங்கும் என்று அறிவேன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"என்னுடன் வழக்காடவேண்டுமென்று இருக்கிறவன் யார்?","poem":1},{"lineBreak":true},{"text":"நான் மவுனமாயிருந்தால் இறந்துபோவேனே.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"இரண்டு காரியங்களை மாத்திரம் எனக்குச் செய்யாதிருப்பீராக;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது உமது முகத்திற்கு முன்பாக ஒளித்துக்கொள்ளாதிருப்பேன்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"உம்முடைய கையை என்னைவிட்டுத் தூரப்படுத்தும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பயங்கரம் என்னை பயமுறுத்தாதிருப்பதாக.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நீர் கூப்பிடும், நான் பதில் கொடுப்பேன்;","poem":1},{"lineBreak":true},{"text":"அல்லது நான் பேசுவேன்;","poem":1},{"lineBreak":true},{"text":"நீர் எனக்கு மறுமொழி சொல்லும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"என் அக்கிரமங்களும் பாவங்களும் எத்தனை?","poem":1},{"lineBreak":true},{"text":"என் மீறுதலையும் என் பாவத்தையும் எனக்கு உணர்த்தும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"நீர் உமது முகத்தை மறைத்து,","poem":1},{"lineBreak":true},{"text":"என்னை உமக்குப் பகைவனாக நினைப்பானேன்?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"காற்றடித்த சருகை நொறுக்குவீரோ?","poem":1},{"lineBreak":true},{"text":"காய்ந்துபோன துரும்பைப் பின்தொடருவீரோ?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"மகா கசப்பான முடிவுகளை என்பேரில் எழுதுகிறீர்;","poem":1},{"lineBreak":true},{"text":"என் சிறுவயதின் அக்கிரமங்களை எனக்குப் பலிக்கச்செய்கிறீர்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"என் கால்களைத் தொழுவத்தில் கட்டிப்போட்டு,","poem":1},{"lineBreak":true},{"text":"என் வழிகளையெல்லாம் காவல்செய்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என் கால் தடங்களில் அடையாளத்தைப் போடுகிறீர்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"இப்படிப்பட்டவன் அழுகிப்போகிற பொருளைப் போலவும்,","poem":1},{"lineBreak":true},{"text":"பூச்சி அரித்த ஆடையைப் போலவும் அழிந்து போவான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}