{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“பெண்ணிடத்தில் பிறந்த மனிதன் வாழ்நாள் குறுகினவனும்","poem":1},{"lineBreak":true},{"text":"வருத்தம் நிறைந்தவனுமாயிருக்கிறான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவன் பூவைப்போலப் பூத்துமறைந்து போகிறான்;","poem":1},{"lineBreak":true},{"text":"நிழலைப்போல நிலைநிற்காமல் ஓடிப்போகிறான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ஆகிலும் இப்படிப்பட்டவன்மேல் நீர் உம்முடைய கண்களைத் திறந்துவைத்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய நியாயத்திற்கு என்னைக் கொண்டுபோவீரோ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அசுத்தமானதிலிருந்து சுத்தமானதைப் பிறக்கவைப்பவன் உண்டோ?","poem":1},{"lineBreak":true},{"text":"ஒருவனுமில்லை.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவனுடைய நாட்கள் இவ்வளவுதான் என்று குறிக்கப்பட்டிருப்பதால்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய மாதங்களின் எண்ணிக்கை உம்மிடத்தில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவன் கடந்துபோகமுடியாத எல்லையை அவனுக்கு ஏற்படுத்தினீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவன் ஒரு கூலிக்காரனைப்போல தன் நாளின் வேலை முடிந்தது என்று நிம்மதியடையும்வரை அவன் ஓய்ந்திருக்க உமது பார்வையை அவனைவிட்டு விலக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஒரு மரத்தைக்குறித்தாவது நம்பிக்கையுண்டு;","poem":1},{"lineBreak":true},{"text":"அது வெட்டிப்போடப்பட்டாலும் திரும்பத் தழைக்கும்,","poem":1},{"lineBreak":true},{"text":"அதின் இளங்கிளைகள் துளிர்க்கும்;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அதின் வேர் தரையிலே பழையதாகி,","poem":1},{"lineBreak":true},{"text":"அதின் அடிக்கட்டை மண்ணிலே செத்தாலும்,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தண்ணீரின் வாசனையினால் அது துளிர்த்து,","poem":1},{"lineBreak":true},{"text":"இளமரம்போலக் கிளைவிடும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"மனிதனோவென்றால் இறந்தபின் ஒழிந்துபோகிறான்,","poem":1},{"lineBreak":true},{"text":"மனிதன் இறந்துபோனபின் அவன் எங்கே?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தண்ணீர் ஏரியிலிருந்து வடிந்து,","poem":1},{"lineBreak":true},{"text":"வெள்ளம் வற்றிக் காய்ந்துபோகிறதுபோல,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"மனிதன் படுத்துக்கிடக்கிறான்,","poem":1},{"lineBreak":true},{"text":"வானங்கள் ஒழிந்துபோகும்வரை எழுந்திருக்கிறதும் இல்லை,","poem":1},{"lineBreak":true},{"text":"தூக்கம் தெளிந்து விழிக்கிறதும் இல்லை.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீர் என்னைப் பாதாளத்தில் ஒளித்து,","poem":1},{"lineBreak":true},{"text":"உமது கோபம் தணியும்வரை என்னை மறைத்து,","poem":1},{"lineBreak":true},{"text":"என்னைத் திரும்ப நினைப்பதற்கு எனக்கு ஒரு காலத்தைக் குறித்தால் நலமாயிருக்கும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"மனிதன் இறந்தபின் பிழைப்பானோ?","poem":1},{"lineBreak":true},{"text":"எனக்கு மாறுதல் எப்போது வருமென்று","poem":1},{"lineBreak":true},{"text":"எனக்குக் குறிக்கப்பட்ட போராட்டத்தின் நாளெல்லாம் நான் காத்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என்னைக் கூப்பிடும், அப்பொழுது நான் உமக்கு பதில் சொல்லுவேன்;","poem":1},{"lineBreak":true},{"text":"உமது கைகளின் செயல்களின்மேல் விருப்பம் வைப்பீராக.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"இப்பொழுது என் நடைகளை எண்ணுகிறீர்;","poem":1},{"lineBreak":true},{"text":"என் பாவத்தின்மேலல்லவோ கவனமாயிருக்கிறீர்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என் மீறுதல் ஒரே கட்டாகக் கட்டப்பட்டு","poem":1},{"lineBreak":true},{"text":"முத்திரைபோடப்பட்டிருக்கிறது, என் அக்கிரமத்தை ஒன்று சேர்த்தீர்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"மலைகளெல்லாம் விழுந்து கரைந்துபோகும்;","poem":1},{"lineBreak":true},{"text":"கன்மலை தன் இடத்தைவிட்டுப் பெயர்ந்துபோகும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தண்ணீர் கற்களைக் குடையும்;","poem":1},{"lineBreak":true},{"text":"பெருவெள்ளம் பூமியின் தூளில் முளைத்ததை மூடும்;","poem":1},{"lineBreak":true},{"text":"அப்படியே மனிதன் கொண்டிருக்கும் நம்பிக்கையை அழிக்கிறீர்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நீர் என்றைக்கும் அவனைப் பலமாக நெருக்குகிறதினால் அவன் போய்விடுகிறான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய முகரூபத்தை மாற்றி அவனை அனுப்பிவிடுகிறீர்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவனுடைய பிள்ளைகள் கனமடைந்தாலும் அவன் உணரமாட்டான்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் சிறுமைப்பட்டாலும் அவர்களைக் கவனிக்கமாட்டான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவனுடைய உடல் அவனிலிருக்கும்வரை அதற்கு வியாதியிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய ஆத்துமா அவனுக்குள்ளிருக்கும்வரை அதற்குத் துக்கமுண்டு” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}