{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["எலிப்பாஸின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அப்பொழுது தேமானியனாகிய எலிப்பாஸ் மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"ஞானவான் காற்றைப்போன்ற நியாயங்களைச் சொல்லி,","poem":1},{"lineBreak":true},{"text":"தன் வயிற்றைக் கொண்டல்காற்றினால் நிரப்பி,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பயனில்லாத வார்த்தைகளாலும், உபயோகமில்லாத வசனங்களாலும் தர்க்கம் செய்யலாமோ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நீர் பயபக்தியை வீணென்று சொல்லி,","poem":1},{"lineBreak":true},{"text":"தேவனுக்கு முன்பாக ஜெபத்தியானத்தைக் குறைத்துக்கொண்டீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்முடைய வாய் உம்முடைய அக்கிரமத்தைச் சொல்லிக்காட்டுகிறது;","poem":1},{"lineBreak":true},{"text":"நீர் தந்திரமுள்ளவர்களின் சொல்லைத் தெரிந்துகொண்டீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் அல்ல, உம்முடைய வாயே உம்மைக் குற்றவாளி என்று முடிவு செய்கிறது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய உதடுகளே உமக்கு விரோதமாகச் சாட்சியிடுகிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மனிதரில் முந்திப் பிறந்தவர் நீர் தானோ?","poem":1},{"lineBreak":true},{"text":"மலைகளுக்குமுன்னே உருவாக்கப்பட்டீரோ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நீர் தேவனுடைய இரகசிய ஆலோசனையைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"ஞானத்தை உம்மிடமாகச் சேர்த்துக்கொண்டீரோ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நாங்கள் அறியாத எந்தக் காரியத்தை நீர் அறிந்திருக்கிறீர்?","poem":1},{"lineBreak":true},{"text":"எங்களுக்கு விளங்காத எந்தக் காரியமாவது உமக்கு விளங்கியிருக்கிறதோ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உம்முடைய தகப்பனைவிட அதிக வயதுள்ள நரைத்தோரும் மிகுந்த வயதானோரும் எங்களுக்குள் இருக்கிறார்களே.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவன் அருளிய ஆறுதல்களும்,","poem":1},{"lineBreak":true},{"text":"உம்முடன் சொல்லப்படுகிற மென்மையான பேச்சும் உமக்கு இழிவான காரியமாயிருக்கிறதோ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உம்முடைய இருதயம் உம்மை எங்கே கொண்டுபோகிறது?","poem":1},{"lineBreak":true},{"text":"உம்முடைய கண்கள் கோபத்துடன் பார்க்கிறது என்ன?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவனுக்கு விரோதமாக உம்முடைய ஆவியை எழுப்பி உம்முடைய வாயிலிருந்து வசனங்களைப் புறப்படச்செய்கிறீர்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"மனிதனானவன் பரிசுத்தமாயிருக்கிறதற்கும்,","poem":1},{"lineBreak":true},{"text":"பெண்ணிடத்தில் பிறந்தவன் நீதிமானாயிருக்கிறதற்கும், அவன் எம்மாத்திரம்?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இதோ, தம்முடைய பரிசுத்தவான்களையும் அவர் நம்புகிறதில்லை;","poem":1},{"lineBreak":true},{"text":"வானங்களும் அவர் பார்வைக்குச் சுத்தமானவைகள் அல்ல.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அநியாயத்தைத் தண்ணீரைப்போலக் குடிக்கிற மனிதன் எத்தனை அதிகமாக அருவருப்பும் அசுத்தமுமாயிருக்கிறான்?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உமக்குக் காரியத்தைத் தெரியவைப்பேன் என்னைக் கேளும்;","poem":1},{"lineBreak":true},{"text":"நான் கண்டதை உமக்கு விவரித்துச் சொல்லுவேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ஞானிகள் தங்கள் பிதாக்கள் சொல்லக் கேட்டு மறைக்காமல் அறிவித்ததையே நான் சொல்லுவேன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவர்களுக்குமாத்திரம் பூமி அளிக்கப்பட்டது;","poem":1},{"lineBreak":true},{"text":"அந்நியர் அவர்கள் நடுவே கடந்துபோக இடமில்லை.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் உயிரோடிருக்கிற நாளெல்லாம் துன்பத்தால் வாதிக்கப்படுகிறான்;","poem":1},{"lineBreak":true},{"text":"பலவந்தம் செய்கிறவனுக்கு அவனுடைய வருடங்களின் எண்ணிக்கை மறைக்கப்பட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"பயங்கரமான சத்தம் அவனுடைய காதுகளில் தொனிக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவன் சமாதானமாயிருக்கும்போது பாழாக்குகிறவன் அவன்மேல் வருவான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"இருளிலிருந்து திரும்பிவர அவனுக்கு நம்பிக்கையில்லாமல்,","poem":1},{"lineBreak":true},{"text":"ஒளிந்திருக்கிறவர்களின் பட்டயத்திற்கு அவன் பயப்படுகிறான்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அப்பம் எங்கே கிடைக்கும் என்று அவன் அலைந்து திரிகிறான்;","poem":1},{"lineBreak":true},{"text":"இருளானநாள் தனக்குச் சமீபித்திருக்கிறதை அறிவான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"இக்கட்டும் நெருக்கமும் அவனைக் கலங்கச்செய்து,","poem":1},{"lineBreak":true},{"text":"போர்வீரனான ராஜாவைப்போல அவனை மேற்கொள்ளும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவன் தேவனுக்கு விரோதமாகக் கைநீட்டி,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லவருக்கு விரோதமாகப் பராக்கிரமம் பாராட்டுகிறான்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"கடினக்கழுத்துடனும், பருத்த குமிழுள்ள தன் கேடயங்களுடனும் அவருக்கு எதிராக ஓடுகிறான்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அவனுடைய முகத்தைக் கொழுப்பு மூடியிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அடிவயிறு தொந்திவிட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ஆனாலும் பாழான பட்டணங்களிலும்,","poem":1},{"lineBreak":true},{"text":"குடிபோன கற்குவியலான வீடுகளிலும் குடியிருப்பான்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அவன் செல்வந்தனாவதுமில்லை,","poem":1},{"lineBreak":true},{"text":"அவனுடைய செல்வம் நிலைப்பதுமில்லை;","poem":1},{"lineBreak":true},{"text":"அப்படிப்பட்டவர்களின் செல்வம் பூமியில் நீடித்திருப்பதில்லை.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"இருளுக்கு அவன் தப்புவதில்லை;","poem":1},{"lineBreak":true},{"text":"நெருப்புத்தணல் அவனுடைய கிளையைக் காய்ந்துபோகச் செய்யும்;","poem":1},{"lineBreak":true},{"text":"அவருடைய வாயின் சுவாசத்தால் அற்றுப்போவான்;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"வழிதப்பினவன் மாயையை நம்பக்கூடாது;","poem":1},{"lineBreak":true},{"text":"நம்பினால் மாயையே அவனுடைய பலனாயிருக்கும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"அது அவனுடைய நாள் வருமுன்னே அவனுக்குப் பூரணமாகப் பலிக்கும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய செடிகள் பச்சையாக இருப்பதில்லை.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"பிஞ்சுகள் உதிர்ந்துபோகிற திராட்சைச்செடியைப்போலவும், பூக்கள் உதிர்ந்து போகிற ஒலிவமரத்தைப் போலவும் அவன் இருப்பான்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"மாயக்காரரின் கூட்டம் வெறுமையாகப்போகும்;","poem":1},{"lineBreak":true},{"text":"லஞ்சம் வாங்கினவர்களின் கூடாரங்களை நெருப்பு எரிக்கும்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"அப்படிப்பட்டவன் அநியாயத்தைக் கர்ப்பந்தரித்து அக்கிரமத்தைப் பெறுகிறான்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் கர்ப்பம் மாயையைப் பிறப்பிக்கும்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}