{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["யோபுவின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அதற்கு யோபு மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“இப்படிப்பட்ட அநேக காரியங்களை நான் கேட்டிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"நீங்கள் எல்லோரும் வேதனையுண்டாக்குகிற தேற்றரவாளர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"காற்றைப்போன்ற வார்த்தைகளுக்கு முடிவிராதோ?","poem":1},{"lineBreak":true},{"text":"இப்படி நீ பதில்சொல்ல உனக்குத் துணிவு உண்டானதென்ன?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உங்களைப்போல நானும் பேசமுடியும்;","poem":1},{"lineBreak":true},{"text":"நான் இருக்கும் நிலைமையில் நீங்கள் இருந்தால்,","poem":1},{"lineBreak":true},{"text":"நான் உங்களுக்கு விரோதமாக வார்த்தைகளைக் கோர்த்து,","poem":1},{"lineBreak":true},{"text":"உங்களுக்கு எதிரே என் தலையை ஆட்டவும் முடியும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஆனாலும் நான் என் வாயினால் உங்களுக்கு தைரியம் சொல்லுவேன்,","poem":1},{"lineBreak":true},{"text":"என் உதடுகளின் அசைவு உங்கள் துக்கத்தை ஆற்றும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் பேசினாலும் என் துக்கம் ஆறாது;","poem":1},{"lineBreak":true},{"text":"நான் பேசாமலிருந்தாலும் எனக்கு என்ன ஆறுதல்?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இப்போது அவர் என்னை சோர்வடையச் செய்தார்;","poem":1},{"lineBreak":true},{"text":"என் குடும்பத்தையெல்லாம் அழித்தீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நீர் என்னைச் குறுகிப்போகச் செய்தது அதற்குச் சாட்சி;","poem":1},{"lineBreak":true},{"text":"என் மெலிவு என்னில் அத்தாட்சியாக நின்று,","poem":1},{"lineBreak":true},{"text":"என் முகத்திற்கு முன்பாக பதில் சொல்லும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என்னைப் பகைக்கிறவனுடைய கோபம் என்னைக் காயப்படுத்துகிறது,","poem":1},{"lineBreak":true},{"text":"என் மேல் கோபப்படுகிறான்;","poem":1},{"lineBreak":true},{"text":"என் எதிரி தீய எண்ணத்தோடு என்னைப் பார்க்கிறான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எனக்கு விரோதமாகத் தங்கள் வாயை விரிவாகத் திறந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"இழிவாக என்னைக் கன்னத்தில் அடித்தார்கள்;","poem":1},{"lineBreak":true},{"text":"என்னைச் சுற்றிலும் கூட்டங்கூடினார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவன் என்னை அநியாயக்காரரிடத்தில் ஒப்படைத்து,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கரின் கையில் என்னை பிடிபடச் செய்தார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நான் சுகமாக வாழ்ந்திருந்தேன்;","poem":1},{"lineBreak":true},{"text":"அவர் என்னை நெருக்கி, என் கழுத்தைப் பிடித்து, என்னை நொறுக்கி,","poem":1},{"lineBreak":true},{"text":"என்னைத் தமக்கு குறியாக நிறுத்தினார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவருடைய வில்லாளர் என்னைச் சூழ்ந்துகொண்டார்கள்;","poem":1},{"lineBreak":true},{"text":"என் சிறுநீரகத்தை விட்டுவிடாமல் பிளந்தார்;","poem":1},{"lineBreak":true},{"text":"என் ஈரலைத் தரையில் ஊற்றிவிட்டார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நொறுக்குதலின்மேல் நொறுக்குதலை என்மேல் வரவைத்தார்;","poem":1},{"lineBreak":true},{"text":"பராக்கிரமசாலியைப்போல என்மேல் பாய்ந்தார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நான் சணல்சேலையைத் தைத்து, என் தோளின்மேல் போர்த்துக்கொண்டேன்;","poem":1},{"lineBreak":true},{"text":"என் மகிமையைப் புழுதியிலே போட்டுவிட்டேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அழுகிறதினால் என் முகம் அழுக்கடைந்தது;","poem":1},{"lineBreak":true},{"text":"மரண இருள் என் கண் இமைகளின்மேல் உண்டாயிருக்கிறது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என் கைகளிலே கொடுமை இல்லாதிருக்கும்போதும்,","poem":1},{"lineBreak":true},{"text":"என் ஜெபம் சுத்தமாயிருக்கும்போதும், அப்படியானது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பூமியே, என் இரத்தத்தை மூடிப்போடாதே;","poem":1},{"lineBreak":true},{"text":"என் அலறுதலுக்கு மறைவிடம் உண்டாகாதிருப்பதாக.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"இப்போதும் இதோ, என் சாட்சி பரலோகத்திலிருக்கிறது.","poem":1},{"lineBreak":true},{"text":"எனக்குச் சாட்சி சொல்லுகிறவர் உன்னதங்களில் இருக்கிறார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என் நண்பர்கள் என்னை கேலி செய்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"என் கண் தேவனை நோக்கிக் கண்ணீர் சொரிகிறது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ஒரு மனிதன் தன் நண்பனுக்காக வழக்காடுகிறதுபோல,","poem":1},{"lineBreak":true},{"text":"தேவனுடன் மனிதனுக்காக வழக்காடுகிறவர் ஒருவர் இருந்தால் நலமாயிருக்கும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"குறுகின வருடங்களுக்கு முடிவு வருகிறது;","poem":1},{"lineBreak":true},{"text":"நான் திரும்பிவராதவழியே போவேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}