{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"என் ஆவி உடைகிறது","poem":1},{"noteId":1},{"text":", என் ஆயுசு நாட்கள் முடிகிறது;","poem":1},{"lineBreak":true},{"text":"கல்லறை எனக்கு ஆயத்தமாயிருக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"கேலி செய்கிறவர்கள் என்னிடத்தில் இல்லையோ?","poem":1},{"lineBreak":true},{"text":"அவர்கள் செய்யும் அநியாயங்களை என் கண் பார்த்துக்கொண்டிருக்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேவரீர் என் காரியத்தை உம்மேல் போட்டுக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"எனக்காகப் பிணைக்கப்படுவீராக;","poem":1},{"lineBreak":true},{"text":"வேறே யார் எனக்குக் கைகொடுக்கத்தக்கவர்?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நீர் அவர்கள் இருதயத்திற்கு ஞானத்தை மறைத்தீர்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் அவர்களை உயர்த்தாதிருப்பீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"எவன் தன் நண்பனுக்குக் கேடாகத் துரோகம் பேசுகிறானோ,","poem":1},{"lineBreak":true},{"text":"அவனுடைய பிள்ளைகளின் கண்களும் பூத்துப்போகும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மக்களுக்குள்ளே அவர் என்னைப் பழமொழியாக வைத்தார்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் முகத்திற்குமுன் நான் விரும்பத்தகாதவனானேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இதற்காக என் கண்கள் வருத்தத்தினால் இருளடைந்தது;","poem":1},{"lineBreak":true},{"text":"என் உறுப்புகளெல்லாம் நிழலைப்போலிருக்கிறது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"சன்மார்க்கர் இதற்காக அதிர்ச்சியடைவார்கள்;","poem":1},{"lineBreak":true},{"text":"குற்றமில்லாதவன் மாயக்காரனுக்கு விரோதமாக எழும்புவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நீதிமான் தன் வழியை உறுதியாகப் பிடிப்பான்;","poem":1},{"lineBreak":true},{"text":"சுத்தமான கைகள் உள்ளவன் மேன்மேலும் பலத்துப்போவான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இப்போதும் நீங்கள் எல்லோரும் போய்வாருங்கள்;","poem":1},{"lineBreak":true},{"text":"உங்களில் ஞானமுள்ள ஒருவனையும் காணவில்லை.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என் நாட்கள் முடிந்தது;","poem":1},{"lineBreak":true},{"text":"என் இருதயத்தில் எனக்கு உண்டாயிருந்த சிந்தனைகள் இல்லாமல் போனது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவைகள் இரவைப் பகலாக்கியது;","poem":1},{"lineBreak":true},{"text":"இருளை வெளிச்சம் தொடர்ந்துவரும் என்று நினைக்கத்தோன்றியது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அப்படி நான் காத்துக்கொண்டிருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"பாதாளம் எனக்கு வீடாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"இருளில் என் படுக்கையைப் போடுவேன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அழிவைப்பார்த்து, நீ எனக்குத் தகப்பன் என்கிறேன்;","poem":1},{"lineBreak":true},{"text":"புழுக்களைப் பார்த்து, நீங்கள் எனக்குத் தாயும் எனக்குச் சகோதரியும் என்கிறேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என் நம்பிக்கை இப்போது எங்கே?","poem":1},{"lineBreak":true},{"text":"நான் நம்பியிருந்ததைக் காண்பவன் யார்?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அது பாதாளத்தின் காவலுக்குள் இறங்கும்;","poem":1},{"lineBreak":true},{"text":"அப்போது தூளில் எங்கும் இளைப்பாறுவோம்” என்றான்.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"என் ஆவி நொறுங்கி விட்டது.","reference":{"chapter":17,"verse":1}}]},"thisChapterLink":"/api/tam_irv/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}