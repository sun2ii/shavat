{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["பில்தாதின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அப்பொழுது சூகியனான பில்தாத் மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“நீங்கள் எதுவரைக்கும் பேச்சுகளை முடிக்காதிருப்பீர்கள்?","poem":1},{"lineBreak":true},{"text":"புத்திமான்களாயிருங்கள்; நாங்களும் பேசட்டும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நாங்கள் மிருகங்களைப்போல எண்ணப்பட்டு,","poem":1},{"lineBreak":true},{"text":"உங்கள் பார்வைக்குக் கீழானவர்களாக ஏன் இருக்கவேண்டும்?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"கோபத்தினால் உன்னை நீயே காயப்படுத்துகிற உனக்காக பூமி அழிந்துபோகுமோ?","poem":1},{"lineBreak":true},{"text":"கன்மலை தன்னிடத்தைவிட்டுப் பெயருமோ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுடைய விளக்கு அணைந்துபோகும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய அடுப்பின் நெருப்பும் அவிந்துபோகும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவனுடைய கூடாரத்தில் வெளிச்சம் இருளாக்கப்படும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய விளக்கு அவனுடனே அணைந்துபோகும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவன் பெலனாய் நடந்த நடைகள் குறைந்துபோகும் அவனுடைய ஆலோசனை அவனை விழவைக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவன் தன் கால்களினால் வலையில் பிடிபட்டு,","poem":1},{"lineBreak":true},{"text":"வலையின் சிக்கலிலே நடக்கிறான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"கண்ணி அவனுடைய குதிகாலைப் பிடிக்கும்;","poem":1},{"lineBreak":true},{"text":"பறிகாரர் அவனை மேற்கொள்வார்கள்.","poem":1},{"noteId":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவனுக்காகச் சுருக்கு தரையிலும்,","poem":1},{"lineBreak":true},{"text":"அவனுக்காகக் கண்ணி வழியிலும் வைக்கப்பட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சுற்றிலுமிருந்து உண்டாகும் பயங்கரங்கள் அவனை அதிர்ச்சியடையச்செய்து,","poem":1},{"lineBreak":true},{"text":"அவனுடைய கால்களைத் திசைதெரியாமல் அலையவைக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவன் பசியினால் பெலனற்றுப்போவான்;","poem":1},{"lineBreak":true},{"text":"அவன் பக்கத்தில் ஆபத்து ஆயத்தமாக நிற்கும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அது அவனுடைய அங்கத்தின் பலத்தை எரிக்கும்;","poem":1},{"lineBreak":true},{"text":"பயங்கரமான மரணமே அவனுடைய உறுப்புகளை எரிக்கும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவனுடைய நம்பிக்கை அவனுடைய கூடாரத்திலிருந்து வேருடன் பிடுங்கப்படும்;","poem":1},{"lineBreak":true},{"text":"அது அவனைப் பயங்கரமான ராஜாவினிடத்தில் துரத்தும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவனுக்கு ஒன்றுமில்லாமற் போனதினால்,","poem":1},{"lineBreak":true},{"text":"பயங்கரம் அவனுடைய கூடாரத்தில் குடியிருக்கும்;","poem":1},{"lineBreak":true},{"text":"கந்தகம் அவனுடைய குடியிருப்பின்மேல் தெளிக்கப்படும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"கீழே இருக்கிற அவனுடைய வேர்கள் அழிந்துபோகும்;","poem":1},{"lineBreak":true},{"text":"மேலே இருக்கிற அவனுடைய கிளைகள் பட்டுப்போகும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவனை நினைக்கும் நினைவு பூமியிலிருந்து அழியும்,","poem":1},{"lineBreak":true},{"text":"வீதிகளில் அவன் பெயரில்லாமற்போகும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவன் வெளிச்சத்திலிருந்து இருளில் துரத்திவிடப்பட்டு,","poem":1},{"lineBreak":true},{"text":"பூலோகத்திலிருந்து தள்ளுண்டுபோவான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவனுடைய மக்களுக்குள்ளே அவனுக்கு மகனும் இல்லை மகளும் இல்லை;","poem":1},{"lineBreak":true},{"text":"அவனுடைய வீட்டில் மீதியாயிருக்க வேண்டியவன் ஒருவனும் இல்லை.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவனுடைய அழிவின் காலத்தில் மேற்கில் இருந்தவர்கள் அதிர்ச்சியடைந்ததுபோல,","poem":1},{"lineBreak":true},{"text":"கிழக்கில் உள்ள மக்களும் அதிர்ச்சியடைவார்கள்.","poem":1},{"noteId":3}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரன் குடியிருந்த இடங்கள் இவைகள்தான்;","poem":1},{"lineBreak":true},{"text":"தேவனை அறியாமற்போனவனுடைய இடம் இதுவே என்பார்கள்” என்றான்.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"அவர்கள் அவர்களை ஜெயித்தார்கள்","reference":{"chapter":18,"verse":9}},{"noteId":3,"caller":"+","text":"மேற்கிலிருந்த மக்கள்","reference":{"chapter":18,"verse":20}}]},"thisChapterLink":"/api/tam_irv/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}