{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["சோப்பாரின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அப்பொழுது நாகமாத்தியனான சோப்பார் மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“இதற்காக பதில் கொடுக்க என் சிந்தனைகள் என்னை ஏவுகிறதினால்","poem":1},{"lineBreak":true},{"text":"நான் விரைவாகச் சொல்லுகிறேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நிந்தித்தேன் என்று நான் கடிந்து கொள்ளப்பட்டதைக் கேட்டேன்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் உணர்வினால் என் ஆவி மறுமொழி சொல்ல என்னை ஏவுகிறது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனின் கெம்பீரம் குறுகினது என்பதையும்,","poem":1},{"lineBreak":true},{"text":"மாயக்காரனின் சந்தோஷம் ஒரு நிமிடம்மாத்திரம் நிற்கும் என்பதையும்,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர் மனிதனைப் பூமியில் வைத்த ஆதிகாலமுதல்","poem":1},{"lineBreak":true},{"text":"இப்படியிருக்கிறது என்பதையும் நீர் அறியீரோ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவனுடைய மேன்மை வானபரியந்தம் உயர்ந்தாலும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய தலை மேகங்கள்வரை எட்டினாலும்,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவன் தன் மலத்தைப்போல என்றைக்கும் அழிந்துபோவான்;","poem":1},{"lineBreak":true},{"text":"அவனைக் கண்டவர்கள்,","poem":1},{"lineBreak":true},{"text":"அவன் எங்கே? என்பார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவன் ஒரு கனவைப்போல் பறந்துபோய்க் காணப்படாதவனாவான்;","poem":1},{"lineBreak":true},{"text":"இரவில் தோன்றும் தரிசனத்தைப்போல் பறக்கடிக்கப்படுவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவனைப் பார்த்த கண் இனி அவனைப் பார்ப்பதில்லை;","poem":1},{"lineBreak":true},{"text":"அவன் இருந்த இடம் இனி அவனைக் காண்பதில்லை.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவனுடைய பிள்ளைகள் எளிமையானவர்களின் சகாயத்தைத் தேடுவார்கள்;","poem":1},{"lineBreak":true},{"text":"அவன் பறித்ததை அவன்","poem":1},{"noteId":5},{"text":"கைகள் திரும்பக் கொடுக்கவேண்டியதாகும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவனுடைய எலும்புகள் அவனுடைய இளவயதின் பாவங்களினால் நிறைந்திருந்து,","poem":1},{"lineBreak":true},{"text":"அவனுடன் மண்ணிலே படுத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பொல்லாப்பு அவனுடைய வாயிலே இனிமையாயிருப்பதால்,","poem":1},{"lineBreak":true},{"text":"அவன் அதைத் தன் நாவின்கீழ் அடக்கி,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அதை விடாமல் அடக்கி,","poem":1},{"lineBreak":true},{"text":"தன் வாய்க்குள்ளே வைத்துக்கொண்டிருந்தாலும்,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவனுடைய ஆகாரம் அவன் குடல்களில் மாறி,","poem":1},{"lineBreak":true},{"text":"அவனுக்குள் விரியன்பாம்புகளின் விஷமாகப்போகும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவன் விழுங்கின செல்வத்தைக் கக்குவான்;","poem":1},{"lineBreak":true},{"text":"தேவன் அதை அவனுடைய வயிற்றிலிருந்து வெளியே தள்ளிவிடுவார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவன் விரியன்பாம்புகளின் விஷத்தை உறிஞ்சுவான்;","poem":1},{"lineBreak":true},{"text":"விரியனின் நாக்கு அவனைக் கொல்லும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தேனும் நெய்யும் ஓடும் வாய்க்கால்களையும் ஆறுகளையும் அவன் காண்பதில்லை.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"தான் பிரயாசப்பட்டுத் தேடினதை அவன் விழுங்காமல் திரும்பக் கொடுப்பான்;","poem":1},{"lineBreak":true},{"text":"அவன் திரும்பக் கொடுக்கிறது அவன் செல்வத்திற்குச் சரியாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவன் மகிழ்ச்சியில்லாதிருப்பான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவன் ஒடுக்கி, ஏழைகளைக் கைவிட்டு,","poem":1},{"lineBreak":true},{"text":"தான் கட்டாத வீட்டை அபகரித்தபடியினாலும்,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தன் வயிறு திருப்தி அடையாமல் இருந்ததினாலும்,","poem":1},{"lineBreak":true},{"text":"அவன் விரும்பின காரியங்களில் அவனுக்கு ஒன்றும் இருப்பதில்லை.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவனுடைய ஆகாரத்தில் ஒன்றும் மீதியாவதில்லை;","poem":1},{"lineBreak":true},{"text":"ஆகையால் அவனுடைய செல்வம் நிலைநிற்பதில்லை.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவன் வேண்டுமென்கிற பரிபூரணம் அவனுக்கு வந்தபின்,","poem":1},{"lineBreak":true},{"text":"அவனுக்கு வேதனை உண்டாகும்;","poem":1},{"lineBreak":true},{"text":"சிறுமைப்படுகிற ஒவ்வொருவருடைய கையும் அவன்மேல் வரும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தன் வயிற்றை நிரப்பத்தக்கது இன்னும் அவனுக்கு இருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"அவர் அவன்மேல் தமது கோபத்தின் கடுமையை வரவழைத்து, அவன் சாப்பிடும்போது,","poem":1},{"lineBreak":true},{"text":"அதை அவன்மேல் வரச்செய்வார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"இரும்பு ஆயுதத்திற்கு அவன் தப்பியோடினாலும் வெண்கல அம்பு அவனை உருவ எய்யும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உருவின பட்டயம் அவன் சரீரத்தையும்,","poem":1},{"lineBreak":true},{"text":"மின்னுகிற அம்பு அவன் ஈரலையும் உருவிப்போகும்;","poem":1},{"lineBreak":true},{"text":"பயங்கரங்கள் அவன்மேல் வரும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவன் ஒளிக்கும் இடங்களில் காரிருள் அடங்கியிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அணையாத நெருப்பு அவனை எரிக்கும்;","poem":1},{"lineBreak":true},{"text":"அவன் கூடாரத்தில் மீதியாயிருக்கிறவன் பாடு அநுபவிப்பான்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"வானங்கள் அவனுடைய குற்றத்தை வெளிப்படுத்தி, பூமி அவனுக்கு விரோதமாக எழும்பும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"வெள்ளத்தினால் அவனுடைய வீட்டின் சம்பத்துப் கரைந்து போய்விடும்;","poem":1},{"lineBreak":true},{"text":"தேவனுடைய கோபம் வெள்ளம் போல் அவைகள் மேல் ஊற்றப்படும் கரைந்து போகும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"இதுவே தேவனால் துன்மார்க்கனுக்குக் கிடைக்கும் பங்கும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய செய்கைக்கு தேவனால் அவனுக்கு வரும் பங்காகும்” என்றான்.","poem":1}]}],"footnotes":[{"noteId":5,"caller":"+","text":"அவனுடைய பலத்த கை","reference":{"chapter":20,"verse":10}}]},"thisChapterLink":"/api/tam_irv/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}