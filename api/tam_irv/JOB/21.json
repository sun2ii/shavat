{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["யோபுவின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["யோபு மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“என் வசனத்தைக் கவனமாகக் கேளுங்கள்;","poem":1},{"lineBreak":true},{"text":"இது நீங்கள் என்னை ஆறுதல் செய்வதுபோல இருக்கும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் பேசப்போகிறேன், சகித்திருங்கள்;","poem":1},{"lineBreak":true},{"text":"நான் பேசினபின்பு கேலிசெய்யுங்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நான் மனிதனைப்பார்த்தா அங்கலாய்க்கிறேன்?","poem":1},{"lineBreak":true},{"text":"அப்படியானாலும் என் ஆவி வேதனைப்படாதிருக்குமா?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என்னைக் கவனித்துப்பாருங்கள்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நீங்கள் ஆச்சரியப்பட்டு,","poem":1},{"lineBreak":true},{"text":"உங்கள் வாயைக் கையால் பொத்திக்கொள்வீர்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இதை நான் நினைக்கும்போது கலங்குகிறேன்;","poem":1},{"lineBreak":true},{"text":"நடுக்கம் என் சரீரத்தைப் பிடிக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர் முதிர்வயதுவரை உயிருடனிருந்து,","poem":1},{"lineBreak":true},{"text":"ஏன் வல்லவராகவேண்டும்?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர்களுடன் அவர்கள் சந்ததியார் அவர்களுக்கு முன்பாகவும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் பிள்ளைகள் அவர்கள் கண்களுக்கு முன்பாகவும் திடப்படுகிறார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர்கள் வீடுகள் பயமில்லாமல் பத்திரமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"தேவனுடைய தண்டனை அவர்கள்மேல் வருகிறதில்லை.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்களுடைய எருது பொலிந்தால், வீணாய்ப்போகாது;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய பசு சினை அழியாமல் ஈனுகிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்கள் குழந்தைகளை ஒரு மந்தையைப்போல வெளியே போகவிடுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் பிள்ளைகள் குதித்து விளையாடுகிறார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவர்கள் தம்புரையும் சுரமண்டலத்தையும் எடுத்துப் பாடி,","poem":1},{"lineBreak":true},{"text":"கின்னரத்தின் ஓசைக்குச் சந்தோஷப்படுகிறார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவர்கள் சமாதானமாய் தங்கள் நாட்களைப் போக்கி,","poem":1},{"lineBreak":true},{"noteId":6},{"text":"ஒரு நொடிப்பொழுதிலே பாதாளத்தில் இறங்குகிறார்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர்கள் தேவனை நோக்கி: எங்களைவிட்டு விலகியிரும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வழிகளை அறிய விரும்பவில்லை;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவனை நாம் ஆராதிக்க அவர் யார்?","poem":1},{"lineBreak":true},{"text":"அவரை நோக்கி ஜெபம் செய்வதினால் நமக்கு பலன் என்ன என்கிறார்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஆனாலும் அவர்கள் வாழ்வு அவர்கள் கையிலிருக்காது;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கரின் ஆலோசனை எனக்குத் தூரமாயிருப்பதாக.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"எத்தனை வேகமாக துன்மார்க்கரின் விளக்கு அணைந்துபோகும்;","poem":1},{"lineBreak":true},{"text":"அவர் தமது கோபத்தினால் வேதனைகளைப் பகிர்ந்துகொடுக்கும்போது,","poem":1},{"lineBreak":true},{"text":"அவர்கள் ஆபத்து அவர்கள்மேல் வரும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவர்கள் காற்றின் திசையிலிருக்கிற துரும்பைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"பெருங்காற்று பறக்கடிக்கிற பதரைப்போலவும் இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தேவன் அவனுடைய அக்கிரமத்தை அவனுடைய பிள்ளைகளுக்கு வைத்து வைக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவன் உணர்வடையும்விதத்தில் அதை அவனுக்குப் பலிக்கச் செய்கிறார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவனுடைய அழிவை அவனுடைய கண்கள் காணும்,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவனை கடுங்கோபத்தை குடிப்பான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவனுடைய மாதங்களின் தொகை குறைக்கப்படும்போது,","poem":1},{"lineBreak":true},{"text":"அவனுக்குப் பிறகு அவனுடைய வீட்டைப்பற்றி அவனுக்கு இருக்கும் விருப்பமென்ன?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"உயர்ந்தோரை நியாயந்தீர்க்கிற தேவனுக்கு அறிவை உணர்த்த யாராலாகும்?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ஒருவன் நிர்வாகத்துடனும் சுகத்துடனும் வாழ்ந்து குறையற்ற பெலனுள்ளவனாய் இறக்கிறான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அவனுடைய உடல் கொழுப்பால் நிறைந்திருக்கிறது,","poem":1},{"lineBreak":true},{"text":"அவனுடைய எலும்புகளில் ஊன் உறுதியாயிருக்கிறது.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"வேறொருவன் ஒரு நாளாவது சந்தோஷத்துடன் சாப்பிடாமல்,","poem":1},{"lineBreak":true},{"text":"மனவேதனையுடன் இறக்கிறான்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"இருவரும் சமமாக மண்ணிலே படுத்துக்கொள்ளுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"புழுக்கள் அவர்களை மூடும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"இதோ, நான் உங்கள் நினைவுகளையும்,","poem":1},{"lineBreak":true},{"text":"நீங்கள் என்னைப்பற்றி அநியாயமாகக் கொண்டிருக்கும் ஆலோசனைகளையும் அறிவேன்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"பிரபுவின் வீடு எங்கே? துன்மார்க்கருடைய கூடாரம் எங்கே?","poem":1},{"lineBreak":true},{"text":"என்று சொல்லுகிறீர்கள்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"வழியிலே நடந்து போகிறவர்களை நீங்கள் கேட்கவில்லையா,","poem":1},{"lineBreak":true},{"text":"அவர்கள் சொல்லும் குறிப்புகளை நீங்கள் அறியவில்லையா?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் ஆபத்து நாளுக்காக வைக்கப்படுகிறான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய கோபாக்கினையின் நாளுக்காக கொண்டுவரப்படுகிறான்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அவனுடைய வழியை அவனுடைய முகத்திற்கு முன்பாக எடுத்துக் காட்டுகிறவன் யார்?","poem":1},{"lineBreak":true},{"text":"அவனுடைய செய்கைக்குத் தக்க பலனை அவனுக்கு ஈடுகட்டுகிறவன் யார்?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"அவன் கல்லறைக்குக் கொண்டுவரப்படுகிறான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய கல்லறை காக்கப்பட்டிருக்கும்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"பள்ளத்தாக்கின் புழுதி மண்கள் அவனுக்கு இன்பமாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவனுக்கு முன்னாக அனேக மக்கள் போனதுபோல,","poem":1},{"lineBreak":true},{"text":"அவனுக்குப் பின்னாக ஒவ்வொருவரும் அவ்விடத்திற்குச் செல்லுவார்கள்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"நீங்கள் வீணாக எனக்கு ஆறுதலை சொல்லுகிறது என்ன?","poem":1},{"lineBreak":true},{"text":"உங்கள் மறுமொழிகளில் முழுவதும் பொய் இருக்கிறது” என்றான்.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"சமாதானம்","reference":{"chapter":21,"verse":13}}]},"thisChapterLink":"/api/tam_irv/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}