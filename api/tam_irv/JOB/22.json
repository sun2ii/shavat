{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["எலிப்பாஸின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அப்பொழுது தேமானியனான எலிப்பாஸ் மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“ஒரு மனிதன் விவேகியாயிருந்து,","poem":1},{"lineBreak":true},{"text":"தனக்குத்தான் நன்மையாக இருக்கிறதினால் தேவனுக்கு நன்மையாக இருப்பானோ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீர் நீதிமானாயிருப்பதினால் சர்வவல்லவருக்கு நன்மையுண்டாகுமோ?","poem":1},{"lineBreak":true},{"text":"நீர் உம்முடைய வழிகளை உத்தமமாக்குகிறது","poem":1},{"lineBreak":true},{"text":"அவருக்கு ஆதாயமாயிருக்குமோ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் உமக்குப் பயந்து உம்முடன் வழக்காடி,","poem":1},{"lineBreak":true},{"text":"உம்முடன் நியாயத்திற்கு வருவாரோ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்முடைய பொல்லாப்பு பெரியதும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய அக்கிரமங்கள் முடிவில்லாதவைகளுமாக இருக்கிறதல்லவோ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"காரணமில்லாமல் உம்முடைய சகோதரர் கையில் அடகு வாங்கி,","poem":1},{"lineBreak":true},{"text":"ஏழைகளின் ஆடைகளைப் பறித்துக்கொண்டீர்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மிகுந்த தாகமுள்ளவனுக்கு தண்ணீர் கொடுக்காமலும்,","poem":1},{"lineBreak":true},{"text":"பசித்தவனுக்கு ஆகாரம் கொடுக்காமலும் போனீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பலவானுக்கே தேசத்தில் இடமுண்டாயிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"கனவான் அதில் குடியேறினான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"விதவைகளை வெறுமையாக அனுப்பிவிட்டீர்;","poem":1},{"lineBreak":true},{"text":"தாய்தகப்பன் இல்லாதவர்களின் கைகள் முறிக்கப்பட்டது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆகையால் கண்ணிகள் உம்மைச் சூழ்ந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"திடீரென்று உமக்கு வந்த பயங்கரம் உம்மைக் கலங்கச் செய்கிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நீர் பார்க்க முடியாமலிருக்க இருள் வந்தது,","poem":1},{"lineBreak":true},{"text":"பெருவெள்ளம் உம்மை மூடுகிறது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தேவன் பரலோகத்தின் உன்னதங்களிலிருக்கிறார் அல்லவோ?","poem":1},{"lineBreak":true},{"text":"நட்சத்திரங்களின் உயரத்தைப் பாரும், அவைகள் எத்தனை உயரமாயிருக்கிறது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீர்: தேவன் எப்படி அறிவார்,","poem":1},{"lineBreak":true},{"text":"இருளுக்கு அப்புறத்திலிருக்கிறவர் நியாயம் விசாரிக்கக்கூடுமோ?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர் பார்க்காமலிருக்க மேகங்கள் அவருக்கு மறைவாயிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"வானமண்டலங்களின் சக்கரத்திலே அவர் உலாவுகிறார் என்று சொல்லுகிறீர்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அக்கிரம மனிதர்கள் ஆரம்பகாலத்தில் நடந்த பாதையை கவனித்துப் பார்த்தீரோ?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"காலம் வருமுன்னே அவர்கள் இறந்துபோனார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய அஸ்திபாரத்தின்மேல் வெள்ளம் புரண்டது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தேவன் அவர்கள் வீடுகளை நன்மையால் நிரப்பியிருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் அவரை நோக்கி: எங்களைவிட்டு விலகும்,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லவராலே எங்களுக்கு என்ன ஆகும் என்றார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ஆகையால் துன்மார்க்கரின் ஆலோசனை எனக்குத் தூரமாயிருப்பதாக.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"எங்கள் நிலைமை அழியாமல்,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு மீதியானதையோ நெருப்பு எரித்ததென்பதை நீதிமான்கள் கண்டு சந்தோஷப்படுகிறார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"குற்றமில்லாதவன் அவர்களைப் பார்த்து சிரிக்கிறான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"நீர் அவருடன் பழகி சமாதானமாயிரும்;","poem":1},{"lineBreak":true},{"text":"அதினால் உமக்கு நன்மைவரும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவர் வாயிலிருந்து பிறந்த வேதப்பிரமாணத்தை ஏற்றுக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"அவர் வார்த்தைகளை உம்முடைய இருதயத்தில் வைத்துக்கொள்ள வேண்டுகிறேன்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"நீர் சர்வவல்லமையுள்ள தேவனிடத்தில் மனந்திரும்பினால்,","poem":1},{"lineBreak":true},{"text":"திரும்பக் கட்டப்படுவீர்; அநீதியை உமது கூடாரத்திற்குத் தூரமாக்குவீர்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அப்பொழுது தூளைப்போல் பொன்னையும்,","poem":1},{"lineBreak":true},{"text":"ஆற்றுக் கற்களைப்போல் ஓப்பீரின் தங்கத்தையும் சேர்த்துவைப்பீர்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அப்பொழுது சர்வவல்லவர் தாமே உமக்குப் பசும்பொன்னும், உமக்குச் சுத்தவெள்ளியுமாயிருப்பார்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அப்பொழுது சர்வவல்லமையுள்ள தேவன் மேல் மனமகிழ்ச்சியாயிருந்து, தேவனுக்கு நேராக உம்முடைய முகத்தை ஏறெடுப்பீர்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"நீர் அவரை நோக்கி விண்ணப்பம்செய்ய, அவர் உமக்குச் செவிகொடுப்பார்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நீர் உம்முடைய பொருத்தனைகளைச் செலுத்துவீர்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"நீர் ஒரு காரியத்தை தீர்மானித்தால், அது உமக்கு நிலைவரப்படும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பாதைகளில் வெளிச்சம் பிரகாசிக்கும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"மனிதர் ஒடுக்கப்படும்போது திடப்படக்கடவர்கள் என்று நீர் சொல்ல,","poem":1},{"lineBreak":true},{"text":"தாழ்ந்தோர் காப்பாற்றப்படுவார்கள்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"குற்றமில்லாதவனையுங்கூட விடுவிப்பார்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கைகளின் சுத்தத்தினால் அவன் விடுவிக்கப்படுவான்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}