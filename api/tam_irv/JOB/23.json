{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":23,"content":[{"type":"heading","content":["யோபுவின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["யோபு மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“இன்றையதினமும் என் அங்கலாய்ப்பு முரட்டுத்தனமாக எண்ணப்படுகிறது;","poem":1},{"lineBreak":true},{"text":"என் தவிப்பைவிட என் வாதை கடினமானது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் அவரை எங்கே கண்டு சந்திக்கலாம் என்பதை அறிந்தால் நலமாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் அவர் இருக்கைக்கு முன்பாக வந்து சேர்ந்து,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என் நியாயத்தை அவருக்கு முன்பாக வரிசையாக வைத்து,","poem":1},{"lineBreak":true},{"text":"காரியத்தை நிரூபிக்கும் வார்த்தைகளால் என் வாயை நிரப்புவேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவருடைய மறுமொழிகளை நான் அறிந்து,","poem":1},{"lineBreak":true},{"text":"அவர் எனக்குச் சொல்வதை உணர்ந்துகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய மகா வல்லமையினால் என்னுடன் வழக்காடுவாரோ?","poem":1},{"lineBreak":true},{"text":"அவர் அப்படிச் செய்யாமல் என்மேல் தயை வைப்பார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அங்கே சன்மார்க்கன் அவருடன் வழக்காடலாம்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது என்னை நியாயந்தீர்க்கிறவரின் கைக்கு என்றைக்கும் விலக்கிக் காப்பாற்றிக்கொள்வேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"இதோ, நான் முன்னேபோனாலும் அவர் இல்லை;","poem":1},{"lineBreak":true},{"text":"பின்னேபோனாலும் அவரைக் காணவில்லை.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"இடதுபுறத்தில் அவர் செயல்பட்டும் அவரைப் பார்க்கவில்லை;","poem":1},{"lineBreak":true},{"text":"வலது புறத்திலும் நான் அவரைக் பார்க்காமலிருக்க மறைந்திருக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆனாலும் நான் போகும் வழியை அவர் அறிவார்;","poem":1},{"lineBreak":true},{"text":"அவர் என்னைச் சோதித்தபின் நான் பொன்னாக விளங்குவேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என் கால்கள் அவர் அடிகளைப் பற்றிப்பிடித்தது;","poem":1},{"lineBreak":true},{"text":"அவருடைய கட்டளையை விட்டு நான் விலகாமல் அதைக் கைக்கொண்டேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவர் உதடுகளின் கற்பனைகளை விட்டு நான் பின்வாங்குவதில்லை;","poem":1},{"lineBreak":true},{"text":"அவருடைய வாயின் வார்த்தைகளை","poem":1},{"lineBreak":true},{"text":"எனக்கு வேண்டிய ஆகாரத்தைப் பார்க்கிலும் அதிகமாகக் காத்துக்கொண்டேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவரோவென்றால் ஒரே மனமாயிருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவரைத் திருப்பத்தக்கவர் யார்?","poem":1},{"lineBreak":true},{"text":"அவருடைய விருப்பத்தின்படியெல்லாம் செய்வார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"எனக்கு திட்டமிட்டிருக்கிறதை அவர் நிறைவேற்றுவார்;","poem":1},{"lineBreak":true},{"text":"இப்படிப்பட்டவைகள் இன்னும் அநேகம் அவரிடத்தில் உண்டு.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆகையால் அவருக்கு முன்பாகக் கலங்குகிறேன்;","poem":1},{"lineBreak":true},{"text":"நான் சிந்திக்கிறபோது, அவருக்குப் பயப்படுகிறேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தேவன் என் இருதயத்தை சோர்வடையச் செய்தார்;","poem":1},{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவன் என்னைக் கலங்கச் செய்தார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"இருள் வராததற்கு முன்னே நான் அழிக்கப்படாமலும்,","poem":1},{"lineBreak":true},{"text":"இருளை அவர் எனக்கு மறைக்காமலும் போனதினால் இப்படியிருக்கிறேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/22.json","previousChapterAudioLinks":{},"numberOfVerses":17}