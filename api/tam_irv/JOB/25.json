{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["பில்தாதின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அப்பொழுது சூகியனான பில்தாத் மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“அதிகாரமும் பயங்கரமும் அவரிடத்தில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவர் தமது உன்னதமான இடங்களில் சமாதானத்தை உண்டாக்குகிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவருடைய படைகளுக்குத் தொகையுண்டோ?","poem":1},{"lineBreak":true},{"text":"அவருடைய வெளிச்சம் யார்மேல் உதிக்காமலிருக்கிறது?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இப்படியிருக்க, மனிதன் தேவனுக்கு முன்பாக நீதிமானாயிருப்பது எப்படி?","poem":1},{"lineBreak":true},{"text":"பெண்ணிடத்தில் பிறந்தவன் சுத்தமாயிருப்பது எப்படி?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"சந்திரனை அண்ணாந்துபாரும், அதுவும் பிரகாசிக்காமலிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"நட்சத்திரங்களும் அவர் பார்வைக்குச் சுத்தமானவைகள் அல்ல.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"புழுவாயிருக்கிற மனிதனும், பூச்சியாயிருக்கிற மனுமக்களும் எம்மாத்திரம்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}