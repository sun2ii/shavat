{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["யோபுவின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["யோபு மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“பெலனில்லாதவனுக்கு நீ எப்படி உதவிசெய்தாய்?","poem":1},{"lineBreak":true},{"text":"பெலனற்ற கையை நீ எப்படி ஆதரித்தாய்?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீ ஞானமில்லாதவனுக்கு எப்படி உறுதுணையாயிருந்து,","poem":1},{"lineBreak":true},{"text":"மெய்ப்பொருளைக் குறித்து அறிவித்தாய்?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யாருக்கு அறிவைப் போதித்தாய்?","poem":1},{"lineBreak":true},{"text":"உன்னிடத்திலிருந்து புறப்பட்ட ஆவி யாருடையது?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தண்ணீரின் கீழ் இறந்தவர்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடன் தங்குகிறவர்களுக்கும் தத்தளிப்பு உண்டு.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவருக்கு முன்பாகப் பாதாளம் தெரியும்விதத்தில் திறந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"நரகம் மூடப்படாதிருக்கிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் வடக்குமண்டலத்தை வெட்டவெளியிலே விரித்து,","poem":1},{"lineBreak":true},{"text":"பூமியை அந்தரத்திலே தொங்கவைக்கிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் தண்ணீர்களைத் தம்முடைய கார்மேகங்களில் கட்டிவைக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அதின் பாரத்தினால் மேகம் கிழிகிறதில்லை.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் தமது சிங்காசனம் நிற்கும் ஆகாயத்தை பலப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"அதின்மேல் தமது மேகத்தை விரிக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர் தண்ணீர்கள்மேல் சுழற்சி வட்டம் அமைத்தார்;","poem":1},{"lineBreak":true},{"text":"வெளிச்சமும் இருளும் முடியும்வரை அப்படியே இருக்கும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவருடைய கண்டிப்பினால் வானத்தின் தூண்கள் அதிர்ந்து தத்தளிக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவர் தமது வல்லமையினால் சமுத்திரக் கொந்தளிப்பை அமரச்செய்து,","poem":1},{"lineBreak":true},{"text":"தமது ஞானத்தினால் அதின் மூர்க்கத்தை அடக்குகிறார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தமது ஆவியினால் வானத்தை அலங்கரித்தார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய கை நெளிவான சர்ப்ப நட்சத்திரத்தை உண்டாக்கியது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"இதோ, இவைகள் அவருடைய படைப்பில் கடைசியானவைகள்,","poem":1},{"lineBreak":true},{"text":"அவரைக்குறித்து நாங்கள் கேட்டது எவ்வளவு கொஞ்சம்;","poem":1},{"lineBreak":true},{"text":"அவருடைய வல்லமையின் இடிமுழக்கத்தை அறிந்தவன் யார்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}