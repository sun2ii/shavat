{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"வெள்ளிக்கு விளையும் இடம் உண்டு,","poem":1},{"lineBreak":true},{"text":"பொன்னுக்குப் புடமிடும் இடமுமுண்டு.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"இரும்பு மண்ணிலிருந்து எடுக்கப்படும்;","poem":1},{"lineBreak":true},{"text":"செம்பு கற்களில் உருக்கி எடுக்கப்படும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மனிதன் அந்தகாரத்திலும் மரண இருளிலும் இருக்கிற கற்களைக்","poem":1},{"lineBreak":true},{"text":"கடைசிவரை ஆராய்ந்து தேடி,","poem":1},{"lineBreak":true},{"text":"இருளுக்கும் அங்கே முடிவுண்டாக்குகிறான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"கடக்கமுடியாததும் நிலையாததுமான ஆறு எழும்பினாலும்,","poem":1},{"lineBreak":true},{"text":"உழைப்பாளியானவன் அதை மனிதரால் வற்றிப்போகவைத்துச் செல்லுகிறான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பூமியின்மேல் ஆகாரம் விளையும்;","poem":1},{"lineBreak":true},{"text":"அதின் கீழிடங்களிலிருக்கிறவைகளோ,","poem":1},{"lineBreak":true},{"text":"நெருப்பால் மாறினது போலிருக்கும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அதின் கற்களில் இந்திரநீலம் விளையும்;","poem":1},{"lineBreak":true},{"text":"அதின் பொடியில் பொன்பொடிகளும் உண்டாயிருக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஒரு வழியுண்டு, அது ஒரு பறவைக்கும் தெரியாது;","poem":1},{"lineBreak":true},{"text":"கழுகின் கண்ணும் அதைக் கண்டதில்லை;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"கொடிய மிருகங்களின் கால்கள் அதில் படவில்லை;","poem":1},{"lineBreak":true},{"text":"சிங்கம் அதைக் கடந்ததில்லை.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவன் தன் கைகளைக் கற்பாறையின்மேல் நீட்டி,","poem":1},{"lineBreak":true},{"text":"மலைகளை வேருடன் புரட்டுகிறான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"கன்மலைகளுக்குள்ளும் நீர்க்கால்களை வெட்டுகிறான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய கண் விலையுயர்ந்த எல்லாவற்றையும் காணும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ஒரு துளியும் கசியாதபடி ஆறுகளை அடைக்கிறான்;","poem":1},{"lineBreak":true},{"text":"மறைவிடத்திலிருக்கிறதை வெளிச்சத்திலே கொண்டுவருகிறான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ஆனாலும் ஞானம் கண்டெடுக்கப்படுவது எங்கே?","poem":1},{"lineBreak":true},{"text":"புத்தி விளைகிற இடம் எது?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அதின் விலை மனிதனுக்குத் தெரியாது;","poem":1},{"lineBreak":true},{"text":"அது மக்கள் வாழ்கிற தேசத்திலே கிடைக்கிறதில்லை.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஆழமானது: அது என்னிடத்தில் இல்லையென்கிறது;","poem":1},{"lineBreak":true},{"text":"சமுத்திரமானதும், அது என்னிடத்தில் இல்லையென்கிறது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அதற்கு ஈடாகத் தங்கத்தைக் கொடுக்கவும்,","poem":1},{"lineBreak":true},{"text":"அதற்குக் கிரயமாக வெள்ளியை நிறுக்கவும் முடியாது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஓப்பீரின் தங்கமும், விலையேறப்பெற்ற கோமேதகமும்,","poem":1},{"lineBreak":true},{"text":"இந்திரநீலக்கல்லும் அதற்கு ஈடல்ல.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"பொன்னும் பளிங்கும் அதற்கு ஒப்பல்ல;","poem":1},{"lineBreak":true},{"text":"பசும்பொன் ஆபரணங்களுக்கு அதை மாற்றமுடியாது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பவளத்தையும் ஸ்படிகத்தையும் அத்துடன் ஒப்பிட்டுப் பேசக்கூடாது;","poem":1},{"lineBreak":true},{"text":"முத்துகளைவிட ஞானத்தின் விலை உயர்ந்தது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"எத்தியோப்பியாவின் புஷ்பராகம் அதற்கு நிகரல்ல;","poem":1},{"lineBreak":true},{"text":"பசும்பொன்னும் அதற்குச் சரியல்ல.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"இப்படியிருக்க, ஞானம் எங்கேயிருந்து வரும்;","poem":1},{"lineBreak":true},{"text":"புத்தி தங்கும் இடம் எங்கே?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அது உயிருள்ள அனைவருடைய கண்களுக்கும் ஒளித்தும்,","poem":1},{"lineBreak":true},{"text":"ஆகாயத்துப் பறவைகளுக்கு மறைந்தும் இருக்கிறது.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நாசமும்","poem":1},{"noteId":9},{"text":", மரணமும், நாங்கள் எங்கள் காதுகளினாலேமாத்திரம் அதின் கீர்த்தியைக் கேட்டோம் என்கிறது.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தேவனோ அதின் வழியை அறிவார்,","poem":1},{"lineBreak":true},{"text":"அது இருக்கும் இடம் அவருக்கே தெரியும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அவர் பூமியின் கடைசிமுனைகளைப் பார்த்து,","poem":1},{"lineBreak":true},{"text":"வானங்களின்கீழ் இருக்கிறதையெல்லாம் காண்கிறார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவர் காற்றுக்கு அதின் எடையை நியமித்து,","poem":1},{"lineBreak":true},{"text":"தண்ணீருக்கு அதின் அளவைக் கணக்கிட்டு,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"மழைக்குத் திட்டத்தையும், இடிமுழக்கத்துடன் கூடிய மின்னலுக்கு வழியையும் ஏற்படுத்துகிறார்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அவர் அதைப் பார்த்துக் கணக்கிட்டார்;","poem":1},{"lineBreak":true},{"text":"அதை ஆராய்ந்து ஆயத்தப்படுத்தி,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"மனிதனை நோக்கி: இதோ, ஆண்டவருக்குப் பயப்படுவதே ஞானம்;","poem":1},{"lineBreak":true},{"text":"பொல்லாப்பை விட்டு விலகுவதே புத்தி என்றார்” என்று சொன்னான்.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"அப்பொல்லியோன்","reference":{"chapter":28,"verse":22}}]},"thisChapterLink":"/api/tam_irv/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}