{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":["பின்னும் யோபு தன் பிரசங்க வாக்கியத்தைத் தொடர்ந்து சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“கடந்துபோன வருடங்களிலும், தேவன் என்னைக் காப்பாற்றிவந்த நாட்களிலும்","poem":1},{"lineBreak":true},{"text":"எனக்கு உண்டாயிருந்த ஒழுங்கு இப்பொழுது இருந்தால் நலமாயிருக்கும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அப்பொழுது அவர் தீபம் என் தலையின்மேல் பிரகாசித்தது;","poem":1},{"lineBreak":true},{"text":"அவர் அருளின வெளிச்சத்தினால் இருளைக் கடந்துபோனேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தேவனுடைய இரகசியச்செயல் என் வீட்டின்மேல் இருந்தது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அப்பொழுது சர்வவல்லமையுள்ள தேவன் என்னுடன் இருந்தார்;","poem":1},{"lineBreak":true},{"text":"என் பிள்ளைகள் என்னைச் சூழ்ந்திருந்தார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என் பாதங்களை நான் நெய்யினால் கழுவினேன்;","poem":1},{"lineBreak":true},{"text":"கன்மலைகளிலிருந்து எனக்காக எண்ணெய் நதிபோல ஓடிவந்தது;","poem":1},{"lineBreak":true},{"text":"அந்தச் செல்வநாட்களின் ஒழுங்கு இப்போதிருந்தால் நலமாயிருக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நான் பட்டணவீதியின் வாசலுக்குள் புறப்பட்டுப்போய்,","poem":1},{"lineBreak":true},{"text":"வீதியில் என் இருக்கையைப் போடும்போது,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"வாலிபர் என்னைக் கண்டு ஒளித்துக்கொள்வார்கள்;","poem":1},{"lineBreak":true},{"text":"முதியோர் எழுந்து நிற்பார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"பிரபுக்கள் பேசுகிறதை நிறுத்தி,","poem":1},{"lineBreak":true},{"text":"கையால் தங்கள் வாயைப் பொத்திக்கொள்வார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"பெரியோரின் சத்தம் அடங்கி,","poem":1},{"lineBreak":true},{"text":"அவர்கள் நாக்கு அவர்கள் மேல்வாயோடு ஒட்டிக்கொள்ளும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னைக் கேட்ட காது என்னைப் பாக்கியவான் என்றது;","poem":1},{"lineBreak":true},{"text":"என்னைக் கண்ட கண் எனக்குச் சாட்சியிட்டது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"முறையிடுகிற ஏழையையும், திக்கற்ற பிள்ளையையும்,","poem":1},{"lineBreak":true},{"text":"உதவியற்றவனையும் காப்பாற்றினேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அழிந்துபோக இருந்தவனுடைய ஆசீர்வாதம் என்மேல் வந்தது; விதவையின் இருதயத்தைக் கெம்பீரிக்கச் செய்தேன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நீதியை அணிந்துகொண்டேன்;","poem":1},{"lineBreak":true},{"text":"அது என் ஆடையாயிருந்தது;","poem":1},{"lineBreak":true},{"text":"என் நியாயம் எனக்குச் சால்வையும் தலைப்பாகையுமாக இருந்தது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நான் குருடனுக்குக் கண்ணும்,","poem":1},{"lineBreak":true},{"text":"சப்பாணிக்குக் காலாகவும் இருந்தேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நான் எளியவர்களுக்குத் தகப்பனாக இருந்து,","poem":1},{"lineBreak":true},{"text":"நான் அறியாத வழக்கை ஆராய்ந்துபார்த்தேன்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நான் அநியாயக்காரருடைய கடைவாய்ப் பற்களை உடைத்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் பறித்ததை அவர்கள் பற்களிலிருந்து பிடுங்கினேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என் கூட்டிலே நான் வாழ்ந்திருப்பேன்;","poem":1},{"lineBreak":true},{"text":"என் நாட்களை மணலைப்போலப் பெருகச் செய்வேன் என்றேன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"என் வேர் தண்ணீர்களின் ஓரமாகப் படர்ந்தது;","poem":1},{"lineBreak":true},{"text":"என் கிளையின்மேல் பனி இரவுமுழுவதும் தங்கியிருந்தது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என் மகிமை என்னில் செழித்தோங்கி,","poem":1},{"lineBreak":true},{"text":"என் கையிலுள்ள என் வில் புதுப்பெலன் கொண்டது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"எனக்குச் செவிகொடுத்துக் காத்திருந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"என் ஆலோசனையைக் கேட்டு மவுனமாயிருந்தார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"என் பேச்சுக்குப் பேசாமலிருந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"என் வசனம் அவர்கள்மேல் மழைத்துளியாக விழுந்தது.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"மழைக்குக் காத்திருக்கிறதுபோல் எனக்குக் காத்திருந்து,","poem":1},{"lineBreak":true},{"text":"பின் மாரிக்கு ஆசையுள்ளவர்கள்போல தங்கள் வாயை ஆவென்று திறந்திருந்தார்கள்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"நான் அவர்களைப் பார்த்து சிரிக்கும்போது,","poem":1},{"lineBreak":true},{"text":"அவர்கள் துணிகரங்கொள்ளவில்லை; என் முகக்களையை மாறவைக்கவும் இல்லை.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவர்கள் வழியில்போக எனக்கு விருப்பமாகும்போது,","poem":1},{"lineBreak":true},{"text":"நான் தலைவனாய் அமர்ந்து,","poem":1},{"lineBreak":true},{"text":"படைக்குள் ராஜாவைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"துக்கித்தவர்களைத் தேற்றுகிறவனாகவும் இருந்தேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}