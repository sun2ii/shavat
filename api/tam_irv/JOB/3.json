{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["யோபுவின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அதற்குப் பின்பு யோபு தன் வாயைத்திறந்து, தான் பிறந்த நாளைச் சபித்து,"]},{"type":"verse","number":2,"content":["வசனித்துச் சொன்னது என்னவென்றால்:"]},{"type":"verse","number":3,"content":[{"text":"நான் பிறந்தநாளும் ஒரு ஆண்பிள்ளை உற்பத்தியானது என்று சொல்லப்பட்ட இரவும் அழிவதாக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அந்த நாள் இருளாக்கப்படுவதாக;","poem":1},{"lineBreak":true},{"text":"தேவன் உயரத்திலிருந்து அதை விசாரிக்காமலும்,","poem":1},{"lineBreak":true},{"text":"வெளிச்சம் அதின்மேல் பிரகாசிக்காமலும்,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"கடுமையான இருளும்","poem":1},{"lineBreak":true},{"text":"மரண இருளும் அதைக் கறைப்படுத்தி, கருமேகம் அதை மூடி,","poem":1},{"lineBreak":true},{"text":"மந்தாரநாளின் பயங்கரங்கள் அதை பயமுறுத்துவதாக.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அந்த இரவை இருள் பிடிப்பதாக;","poem":1},{"lineBreak":true},{"text":"வருடத்தின் நாட்களில் அது சந்தோஷப்படுகிற நாளாக இராமலும் மாதக்கணக்கிலே அது வராமலும் போவதாக.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அந்த இரவு தனிமையாயிருப்பதாக; அதிலே கெம்பீரசத்தம் இல்லாமற்போவதாக.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நாளைச் சபிக்கிறவர்களும், லிவியாதானை எழும்பச் செய்கிறவர்களும்,","poem":1},{"lineBreak":true},{"text":"அதைச் சபிப்பார்களாக.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அதின் மறையும் காலத்தில் தோன்றிய நட்சத்திரங்கள் இருண்டு,","poem":1},{"lineBreak":true},{"text":"அது எதிர்பார்த்திருந்த வெளிச்சம் தோன்றாமலும், விடியற்காலத்து வெளுப்பை அது பார்க்காமலும் இருப்பதாக.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நான் இருந்த கர்ப்பத்தின் வாசலை அது அடைக்காமலும்,","poem":1},{"lineBreak":true},{"text":"என் கண்கள் காண்கிற வருத்தத்தை மறைத்துவிடாமலும் இருந்ததே.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நான் கர்ப்பத்தில் அழியாமலும்,","poem":1},{"lineBreak":true},{"text":"கர்ப்பத்திலிருந்து புறப்படுகிறபோதே இறக்காமலும் போனதென்ன?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என்னை ஏந்திக்கொள்ள மடியும்,","poem":1},{"lineBreak":true},{"text":"நான் பாலுண்ண மார்பகங்களும் இருந்ததென்ன?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அப்படியில்லாதிருந்தால்,","poem":1},{"lineBreak":true},{"text":"அசையாமல்கிடந்து அமர்ந்திருந்து,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"பாழ்நிலங்களில் தங்களுக்கு மாளிகையைக் கட்டின பூமியின் ராஜாக்களுடனும் மந்திரிமார்களுடனும்,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அல்லது, பொன்னை உடையவர்களும்,","poem":1},{"lineBreak":true},{"text":"தங்கள் வீடுகளை வெள்ளியினால் நிரப்பினவர்களுமான பிரபுக்களுடன் நான் இப்பொழுது தூங்கி இளைப்பாறுவேனே.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அல்லது, வெளிப்படாத வளர்ச்சியடையாத கருவைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"வெளிச்சத்தைப் பார்க்காத குழந்தைகளைப்போலவும் இருப்பேனே.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"துன்மார்க்கருடைய தொந்தரவு அங்கே ஓய்ந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"பெலனற்று சோர்ந்து போனவர்கள் அங்கே இளைப்பாறுகிறார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"சிறைப்பட்டிருந்தவர்கள் அங்கே ஏகமாக அமர்ந்திருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"ஒடுக்குகிறவனுடைய சத்தம் அங்கே கேட்கப்படுகிறதில்லை.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"சிறியவனும் பெரியவனும் அங்கே சமமாக இருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அடிமை தன் எஜமானுக்கு நீங்கலாயிருக்கிறான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"மரணத்திற்கு ஆசையாகக் காத்திருந்து,","poem":1},{"lineBreak":true},{"text":"புதையலைத் தேடுகிறதுபோல அதைத் தேடியும் அடையாமற்போகிறவர்களும்,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"கல்லறையைக் கண்டுபிடித்ததினால் மிகவும் மகிழ்ந்து,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அதற்காகச் சந்தோஷப்படுகிற பாக்கியம் இல்லாதவராகிய இவர்களுக்கு வெளிச்சமும்,","poem":1},{"lineBreak":true},{"text":"மனவருத்தமும் உள்ள இவர்களுக்கு உயிர் கொடுக்கப்படுகிறதினால் பலன் என்ன?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தன் வழியைக் காணமுடியாதபடிக்கு,","poem":1},{"lineBreak":true},{"text":"தேவனால் வளைந்துகொள்ளப்பட்டவனுக்கு வெளிச்சத்தினால் பலன் என்ன?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"என் சாப்பாட்டுக்கு முன்னே எனக்குப் பெருமூச்சு உண்டாகிறது;","poem":1},{"lineBreak":true},{"text":"என் கதறுதல் வெள்ளம்போல் புரண்டுபோகிறது.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"நான் பயந்த காரியம் எனக்குச் சம்பவித்தது;","poem":1},{"lineBreak":true},{"text":"நான் பயப்பட்டது எனக்கு வந்தது.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"எனக்குச் சுகமுமில்லை,","poem":1},{"lineBreak":true},{"text":"நிம்மதியுமில்லை, அமைதலுமில்லை;","poem":1},{"lineBreak":true},{"text":"எனக்குத் துன்பமே வந்தது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}