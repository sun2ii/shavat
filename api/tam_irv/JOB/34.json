{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["பின்னும் எலிகூ மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“ஞானிகளே, என் வார்த்தைகளைக் கேளுங்கள்;","poem":1},{"lineBreak":true},{"text":"அறிவாளிகளே, எனக்குச் செவிகொடுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"வாயானது ஆகாரத்தை ருசிபார்க்கிறதுபோல,","poem":1},{"lineBreak":true},{"text":"காதானது வார்த்தைகளைச் சோதித்துப்பார்க்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நமக்காக நியாயமானதைத் தெரிந்துகொள்வோமாக;","poem":1},{"lineBreak":true},{"text":"நன்மை இன்னதென்று நமக்குள்ளே அறிந்துகொள்வோமாக.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யோபு: நான் நீதிமான்;","poem":1},{"lineBreak":true},{"text":"தேவன் என் நியாயத்தைத் தள்ளிவிட்டார் என்றும்,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நியாயம் என்னிடத்தில் இருந்தும் நான் பொய்யனென்று எண்ணப்படுகிறேன்;","poem":1},{"lineBreak":true},{"text":"மீறுதல் இல்லாதிருந்தும்,","poem":1},{"lineBreak":true},{"text":"அம்பினால் எனக்கு இருந்த காயம் ஆறாததாயிருக்கிறதென்றும் சொன்னாரே.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யோபைப் போலவே, கேலிசெய்வதை தண்ணீரைப்போல் குடித்து,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரருடன் சேர்ந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கருடன் சுற்றுகிறவன் யார்?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எப்படியென்றால், தேவன்மேல் அன்பு வைக்கிறது","poem":1},{"lineBreak":true},{"text":"மனிதனுக்குப் பயன் அல்ல என்றாரே.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆகையால் புத்திமான்களே, எனக்குச் செவிகொடுங்கள்;","poem":1},{"lineBreak":true},{"text":"அநீதி தேவனுக்கும்,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவனுக்கும் தூரமாயிருக்கிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மனிதனுடைய செயல்களுக்கு ஏற்ப அவனுக்குச் சரிக்கட்டி,","poem":1},{"lineBreak":true},{"text":"அவனவன் நடக்கைகளுக்கு ஏற்ப அவனவனுக்குப் பலனளிக்கிறார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தேவன் அநியாயம் செய்யாமலும்,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவன் நீதியைப் புரட்டாமலும் இருக்கிறது உண்மையே.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"பூமியின்மேல் மனிதனுக்கு அதிகாரம் கொடுத்தவர் யார்?","poem":1},{"lineBreak":true},{"text":"உலகம் முழுவதையும் ஒழுங்குபடுத்தினவர் யார்?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய இருதயத்தை அவனுக்கு விரோதமாகத் திருப்பினாரென்றால்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய ஆவியையும் அவனுடைய சுவாசத்தையும் தம்மிடத்தில் இழுத்துக்கொள்வார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அப்படியே உயிரினங்கள் அனைத்தும் இறந்துபோகும்,","poem":1},{"lineBreak":true},{"text":"மனிதன் மண்ணுக்குத் திரும்புவான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உமக்கு உணர்விருந்தால் இதைக் கேளும்,","poem":1},{"lineBreak":true},{"text":"என் வார்த்தைகளின் சத்தத்தைக் கேளும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நீதியைப் பகைக்கிற ஒருவன் ஆள முடியுமோ?","poem":1},{"lineBreak":true},{"text":"மகா நீதிபரரைக் குற்றப்படுத்துவீரோ?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ஒரு ராஜாவைப் பார்த்து,","poem":1},{"lineBreak":true},{"text":"நீ பொல்லாதவன் என்றும், அதிபதிகளைப் பார்த்து,","poem":1},{"lineBreak":true},{"text":"நீங்கள் அக்கிரமக்காரர் என்றும் சொல்ல முடியுமோ?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"இப்படியிருக்க, பிரபுக்களின் முகத்தைப்பார்க்காமலும்,","poem":1},{"lineBreak":true},{"text":"ஏழையைவிட செல்வந்தனை அதிகமாக நினைக்காமலும் இருக்கிறவரை நோக்கி","poem":1},{"lineBreak":true},{"text":"இப்படிச் சொல்லலாமா?","poem":1},{"lineBreak":true},{"text":"இவர்கள் எல்லோரும் அவர் கரங்களின் செயல்களே.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"இப்படிப்பட்டவர்கள் உடனே இறப்பார்கள்;","poem":1},{"lineBreak":true},{"text":"மக்கள் நடுஇரவில் கலங்கி இறந்துபோவார்கள்;","poem":1},{"lineBreak":true},{"text":"பார்க்காத கையினால் பலவந்தர் அழிந்துபோவார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவருடைய கண்கள் மனிதருடைய வழிகளை நோக்கியிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய நடைகளையெல்லாம் அவர் பார்க்கிறார்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரர் ஒளிந்துகொள்ளக்கூடிய இருளுமில்லை,","poem":1},{"lineBreak":true},{"text":"மரணஇருளுமில்லை.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"மனிதன் தேவனுடன் வழக்காடுவதற்கு","poem":1},{"lineBreak":true},{"text":"அவர் அவன்மேல் அதிகமானதொன்றையும் சுமத்தமாட்டார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஆராய்ந்து முடியாதவிதத்தில்,","poem":1},{"lineBreak":true},{"text":"நியாயமாக அவர் வல்லமையுள்ளவர்களை நொறுக்கி,","poem":1},{"lineBreak":true},{"text":"வேறு மனிதரை அவர்கள் இடத்திலே நிறுத்துகிறார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவர்களின் செயல்களை அவர் அறிந்தவர் என்பதினால்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் நசுங்கிப்போகும் அளவுக்கு இரவுநேரத்தில் அவர்களை அழித்துப்போடுகிறார்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவர்கள் அவரைவிட்டுப் பின்வாங்கி","poem":1},{"lineBreak":true},{"text":"அவருடைய எல்லா வழிகளையும் உணர்ந்துகொள்ளாமல் போனதினாலும்,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"எளியவர்களின் வேண்டுதல் அவரிடத்தில் சேரவைத்ததினாலும்,","poem":1},{"lineBreak":true},{"text":"சிறுமையானவனுடைய வேண்டுதலை கேட்கிற அவர்,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"எல்லோரும் பார்க்கும்படி அவர்களைத் துன்மார்க்கரென்று அடிக்கிறார்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"மாயக்காரன் ஆளுகை செய்யாமலும்,","poem":1},{"lineBreak":true},{"text":"மக்கள் சிக்கிக்கொள்ளாமலும்,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ஒரு மக்களுக்காவது ஒரு மனிதனுக்காவது,","poem":1},{"lineBreak":true},{"text":"அவர் சமாதானத்தை அருளினால் யார் கலங்கவைப்பான்?","poem":1},{"lineBreak":true},{"text":"அவர் தமது முகத்தை மறைத்தால் அவரைப் பார்ப்பவன் யார்?","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"நான் தண்டிக்கப்பட்டேன்;","poem":1},{"lineBreak":true},{"text":"நான் இனிப் பாவம் செய்யமாட்டேன்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"நான் பார்க்காத காரியத்தை நீர் எனக்குப் போதியும்,","poem":1},{"lineBreak":true},{"text":"நான் அநியாயம் செய்தேனென்றால்,","poem":1},{"lineBreak":true},{"text":"நான் இனி அப்படிச் செய்வதில்லை என்று தேவனை நோக்கிச் சொல்லமுடியுமே.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"நீர் அப்படிச் செய்யமாட்டேன் என்கிறதினால்,","poem":1},{"lineBreak":true},{"text":"உம்முடன் இருக்கிறவர்களில் ஒருவனை உமக்குப் பதிலாக அதைச் செய்யச்சொல்வீரோ?","poem":1},{"lineBreak":true},{"text":"நான் அல்ல, நீரே தெரிந்துகொள்ளவேண்டும்;","poem":1},{"lineBreak":true},{"text":"அல்லவென்றால், நீர் அறிந்திருக்கிறதைச் சொல்லும்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"யோபு அறிவில்லாமல் பேசினார்;","poem":1},{"lineBreak":true},{"text":"அவர் வார்த்தைகள் ஞானமுள்ளவைகள் அல்லவென்று,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"புத்தியுள்ள மனிதர் என் சார்பாகப் பேசுவார்கள்;","poem":1},{"lineBreak":true},{"text":"ஞானமுள்ள மனிதனும் எனக்குச் செவிகொடுப்பான்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரர் சொன்ன மறுமொழிகளினால்","poem":1},{"lineBreak":true},{"text":"யோபு முற்றும்முடிய சோதிக்கப்படவேண்டியதே என் ஆசை.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"தம்முடைய பாவத்துடன் மீறுதலைச் சேர்த்தார்;","poem":1},{"lineBreak":true},{"text":"அவர் எங்களுக்குள்ளே கைகொட்டி,","poem":1},{"lineBreak":true},{"text":"தேவனுக்கு விரோதமாகத் தம்முடைய வார்த்தைகளை அதிகமாகப் பேசினார்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}