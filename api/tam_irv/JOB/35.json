{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["பின்னும் எலிகூ மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“என் நீதி தேவனுடைய நீதியைவிட உயர்ந்ததென்று","poem":1},{"lineBreak":true},{"text":"நீர் சொன்னது நியாயம் என்று நினைக்கிறீரோ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் பாவியாக இல்லாததினால்","poem":1},{"lineBreak":true},{"text":"எனக்கு நன்மை என்ன? பலன் என்ன? என்று சொன்னீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உமக்கும் உம்முடன் இருக்கிற உம்முடைய நண்பனுக்கும் நான் பதில் சொல்லுகிறேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீர் வானத்தை அண்ணாந்து பார்த்து,","poem":1},{"lineBreak":true},{"text":"உம்மைவிட உயரமாயிருக்கிற ஆகாயமண்டலங்களைக் கண்ணோக்கும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீர் பாவம் செய்தால் அதினாலே அவருக்கு என்ன நஷ்டம்?","poem":1},{"lineBreak":true},{"text":"உம்முடைய மீறுதல்கள் அதிகமானாலும், அதினாலே அவருக்கு என்ன பாதிப்பு?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீர் நீதிமானாயிருந்தால், அதினாலே அவருக்கு என்ன கிடைக்கும்?","poem":1},{"lineBreak":true},{"text":"அல்லது அவர் உம்முடைய கையில் என்ன லாபத்தைப் பெறுவார்?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"உம்முடைய பாவத்தினால் உம்மைப்போன்ற மனிதனுக்கு நஷ்டமும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய நீதியினால் மனுமக்களுக்கு லாபமும் உண்டாகும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அநேகரால் பலவந்தமாக ஒடுக்கப்பட்டவர்கள் முறையிட்டு,","poem":1},{"lineBreak":true},{"text":"வல்லவர்களுடைய புயத்தினிமித்தம் அலறுகிறார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"பூமியின் மிருகங்களைவிட எங்களைப் புத்திமான்களும்,","poem":1},{"lineBreak":true},{"text":"ஆகாயத்துப் பறவைகளைவிட எங்களை ஞானவான்களுமாக்கி,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னை உண்டாக்கினவரும்,","poem":1},{"lineBreak":true},{"text":"இரவிலும் பாடல்பாட அருள்செய்கிறவருமாகிய என்னை உருவாக்கின கர்த்தராகிய தேவன் எங்கே என்று கேட்பவன் ஒருவனுமில்லை.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அங்கே அவர்கள் பொல்லாதவர்களின் பெருமையினாலே கூப்பிடுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவரோ திரும்ப பதில் கொடுக்கிறதில்லை.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவன் வீண்வார்த்தைகளைக் கேட்கமாட்டார்,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவன் அதைக் கவனிக்கமாட்டார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவருடைய தரிசனம் உமக்குக் கிடைக்கிறதில்லை என்று நீர் சொல்லுகிறீரே;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் நியாயத்தீர்ப்பு அவரிடத்தில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"ஆகையால் அவருக்குக் காத்துக்கொண்டிரும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இப்போது அவருடைய கோபமானது நியாயத்தை முற்றிலும் விசாரிக்காது;","poem":1},{"lineBreak":true},{"text":"அவர் இன்னும் ஒன்றையும் குறையில்லாத முறையில் தண்டிக்கவில்லை.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஆகையால் யோபு வீணாய்த் தம்முடைய வாயைத் திறந்து,","poem":1},{"lineBreak":true},{"text":"அறிவில்லாத வார்த்தைகளை அதிகமாகப் பேசுகிறார்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}