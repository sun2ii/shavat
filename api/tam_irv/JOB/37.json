{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“இதினால் என் இருதயம் தத்தளித்து,","poem":1},{"lineBreak":true},{"text":"தன்னிடத்தைவிட்டுத் தெறிக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தேவனுடைய சத்தத்தினால் உண்டாகிற அதிர்ச்சியையும்,","poem":1},{"lineBreak":true},{"text":"அவர் வாயிலிருந்து புறப்படுகிற முழக்கத்தையும் கவனமாகக் கேளுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் வானத்தின் கீழெங்கும் அந்தத் தொனியையும்,","poem":1},{"lineBreak":true},{"text":"பூமியின் கடையாந்தரங்கள்மேல் அதின் மின்னலையும் செல்லவிடுகிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அதற்குப்பின்பு அவர் சத்தமாக முழங்கி,","poem":1},{"lineBreak":true},{"text":"தம்முடைய மகத்துவத்தின் சத்தத்தைக் குமுறச்செய்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய சத்தம் கேட்கப்படும்போது அதைத் தவிர்க்கமுடியாது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவன் தம்முடைய சத்தத்தை ஆச்சரியவிதமாகக் குமுறச் செய்கிறார்;","poem":1},{"lineBreak":true},{"text":"நாம் விளங்கமுடியாத பெரிய காரியங்களை அவர் செய்கிறார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் உறைந்த மழையையும், கல்மழையையும்,","poem":1},{"lineBreak":true},{"text":"தம்முடைய வல்லமையின் பெருமழையையும் பார்த்து:","poem":1},{"lineBreak":true},{"text":"பூமியின்மேல் பெய்யுங்கள் என்று கட்டளையிடுகிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தாம் உண்டாக்கின எல்லா மனிதரும் தம்மை அறியவேண்டுமென்று,","poem":1},{"lineBreak":true},{"text":"அவர் எல்லா மனிதருடைய கைகளையும் முடக்கிப்போடுகிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அப்பொழுது காட்டுமிருகங்கள் தங்கள் குகைகளில் புகுந்து,","poem":1},{"lineBreak":true},{"text":"தங்கள் கெபிகளில் தங்கும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தெற்கேயிருந்து சூறாவளியும்,","poem":1},{"lineBreak":true},{"text":"வடகாற்றினால் குளிரும் வரும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தம்முடைய சுவாசத்தினால் தேவன் குளிரைக் கொடுக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது தண்ணீரின் மேற்பரப்பு உறைந்துபோகும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர் நீர்த்துளிகளை மேகத்தில் ஏற்றி,","poem":1},{"lineBreak":true},{"text":"மின்னலினால் மேகத்தைச் சிதறவைக்கிறார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவர் அவைகளுக்குக் கட்டளையிடுகிற யாவையும்,","poem":1},{"lineBreak":true},{"text":"அவைகள் பூச்சக்கரத்தில் நடப்பிக்கும்படி,","poem":1},{"lineBreak":true},{"text":"அவர் அவைகளைத் தம்முடைய ஞான ஆலோசனைகளின்படியே சுற்றித் திரியவைக்கிறார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ஒன்றில் தண்டனையாகவும், ஒன்றில் தம்முடைய பூமிக்கு உபயோகமாகவும்,","poem":1},{"lineBreak":true},{"text":"ஒன்றில் கிருபையாகவும், அவைகளை வரச்செய்கிறார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யோபே, இதற்குச் செவிகொடும்;","poem":1},{"lineBreak":true},{"text":"தரித்துநின்று தேவனுடைய ஆச்சரியமான கிரியைகளைத் தியானித்துப்பாரும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"தேவன் அவைகளைத் திட்டமிட்டு,","poem":1},{"lineBreak":true},{"text":"தம்முடைய மேகத்தின் மின்னலை மின்னச்செய்யும் விதத்தை அறிவீரோ?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"மேகங்கள் தொங்கும்படி வைக்கும் எடையையும்,","poem":1},{"lineBreak":true},{"text":"பூரண ஞானமுள்ளவரின் அற்புதமான செய்கைகளையும்,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தென்றலினால் அவர் பூமியை அமைக்கும்போது,","poem":1},{"lineBreak":true},{"text":"உம்முடைய ஆடைகள் வெப்பமாயிருக்கும் முறையையும் அறிவீரோ?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"செய்யப்பட்ட கண்ணாடியைப்போல் கெட்டியான ஆகாயமண்டலங்களை நீர் அவருடன் இருந்து விரித்தீரோ?","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவருக்கு நாம் சொல்லக்கூடியதை எங்களுக்குப் போதியும்;","poem":1},{"lineBreak":true},{"text":"இருளின் காரணமாக முறைதவறிப் பேசுகிறோம்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நான் பேசத்துணிந்தேன் என்று யாராவது ஒருவன் அவருக்கு முன்பாகச் சொல்லமுடியுமோ?","poem":1},{"lineBreak":true},{"text":"ஒருவன் பேசத்துணிந்தால் அவன் அழிக்கப்பட்டுப்போவானே.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"இப்போதும் காற்று வீசி ஆகாய மண்டலங்களிலுள்ள மப்பு நீங்கச் செய்திருக்கிற சமயத்தில் வடக்கேயிருந்து பொன்மயமான கதிர்கள் வருகிறபோது,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ஆகாயமண்டலத்திலே பிரகாசிக்கிற சூரியனை முதலாய் ஒருவரும் நோக்கிப் பார்க்கமுடியாதே;","poem":1},{"lineBreak":true},{"text":"தேவனிடத்திலோ பயங்கரமான மகத்துவமுண்டு.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவனை நாம் கண்டுபிடிக்கமுடியாது;","poem":1},{"lineBreak":true},{"text":"அவர் வல்லமையிலும் நியாயத்திலும் பெருத்தவர்;","poem":1},{"lineBreak":true},{"text":"அவர் மகா நீதிபரர்;","poem":1},{"lineBreak":true},{"text":"அவர் ஒடுக்கமாட்டார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஆகையால் மனிதர் அவருக்குப் பயப்படவேண்டும்;","poem":1},{"lineBreak":true},{"text":"தங்கள் மனதில் ஞானிகளாயிருக்கிற எவர்களையும் அவர் மதிக்கமாட்டார்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}