{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“வரையாடுகள் பிறக்கும் காலத்தை அறிவாயோ?","poem":1},{"lineBreak":true},{"text":"மான்கள் குட்டிபோடுகிறதைக் கவனித்தாயோ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவைகள் சினைப்பட்டிருந்து வருகிற மாதங்களை நீ எண்ணி,","poem":1},{"lineBreak":true},{"text":"அவைகள் பிறக்கும் காலத்தை அறிவாயோ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவைகள் வேதனையுடன் குனிந்து தங்கள் குட்டிகளைப் பெற்று,","poem":1},{"lineBreak":true},{"text":"தங்கள் வேதனைகளை நீக்கிவிடும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவைகளின் குட்டிகள் பலத்து, வனத்திலே வளர்ந்து,","poem":1},{"lineBreak":true},{"text":"அவைகளிடத்தில் திரும்ப வராமல் போய்விடும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"காட்டுக்கழுதையைத் தன் விருப்பத்திற்கு சுற்றித்திரிய வைத்தவர் யார்?","poem":1},{"lineBreak":true},{"text":"அந்தக் காட்டுக்கழுதையின் கட்டுகளை அவிழ்த்தவர் யார்?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அதற்கு நான் வனாந்திரத்தை வீடாகவும்,","poem":1},{"lineBreak":true},{"text":"உவர்நிலத்தை தங்கும் இடமாகவும் கொடுத்தேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அது பட்டணத்தின் இரைச்சலை அலட்சியம்செய்து,","poem":1},{"lineBreak":true},{"text":"ஓட்டுகிறவனுடைய சத்தத்தை மதிக்கிறதில்லை.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அது மலைகளிலே தன் மேய்ச்சலைக் கண்டுபிடித்து,","poem":1},{"lineBreak":true},{"text":"எல்லாவிதப் பச்சைத் தாவரங்களையும் தேடித்திரியும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"காண்டாமிருகம் உன்னிடத்தில் வேலை செய்ய சம்மதிக்குமோ?","poem":1},{"lineBreak":true},{"text":"அது உன் பண்ணையில் இரவு தங்குமோ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"வயலில் உழ நீ காண்டாமிருகத்தைக் கயிறுபோட்டு ஏரில் பூட்டுவாயோ?","poem":1},{"lineBreak":true},{"text":"அது உனக்கு இசைந்து போரடிக்குமோ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அது அதிக பெலமுள்ளதென்று நீ நம்பி அதினிடத்தில் வேலை வாங்குவாயோ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உன் தானியத்தை அது உன்வீட்டில் கொண்டுவந்து,","poem":1},{"lineBreak":true},{"text":"உன் களஞ்சியத்தில் சேர்க்கும் என்று நீ அதை நம்புவாயோ?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தீக்குருவிகள் தங்கள் இறக்கைகளை அடித்து ஓடுகிற ஓட்டம்,","poem":1},{"lineBreak":true},{"text":"நாரை தன் இறக்கைகளாலும் இறகுகளாலும் பறக்கிறதற்குச் சமானமல்லவோ?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அது தன் முட்டைகளைத் தரையிலே இட்டு, அவைகளை மணலிலே அனலுறைக்க வைத்துவிட்டுப்போய்,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"காலால் மிதிபட்டு உடைந்துபோகும் என்பதையும்,","poem":1},{"lineBreak":true},{"text":"காட்டுமிருகங்கள் அவைகளை மிதித்துவிடும் என்பதையும் நினைக்கிறதில்லை.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அது தன் குஞ்சுகள் தன்னுடையது அல்ல என்பதுபோல","poem":1},{"lineBreak":true},{"text":"அவைகளைப் பாதுகாக்காத கடினகுணமுள்ளதாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவைகளுக்காக அதற்குக் கவலையில்லாததினால் அது பட்ட வருத்தம் வீணாகும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தேவன் அதற்குப் புத்தியைக் கொடுக்காமல்,","poem":1},{"lineBreak":true},{"text":"ஞானத்தை விலக்கிவைத்தார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அது இறக்கை விரித்து எழும்பும்போது,","poem":1},{"lineBreak":true},{"text":"குதிரையையும் அதின்மேல் ஏறியிருக்கிறவனையும் அலட்சியம் செய்யும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"குதிரைக்கு நீ வீரியத்தைக் கொடுத்தாயோ?","poem":1},{"lineBreak":true},{"text":"அதின் தொண்டையில் குமுறலை வைத்தாயோ?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ஒரு வெட்டுக்கிளியை மிரட்டுகிறதுபோல அதை மிரட்டுவாயோ?","poem":1},{"lineBreak":true},{"text":"அதினுடைய மூக்கின் கனைப்பு பயங்கரமாயிருக்கிறது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அது தரையிலே உதைத்து,","poem":1},{"lineBreak":true},{"text":"தன் பலத்தில் மகிழ்ந்து, ஆயுதங்களை அணிந்தவருக்கு எதிராகப் புறப்படும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அது கலங்காமலும், பட்டயத்திற்குப் பின்வாங்காமலுமிருந்து,","poem":1},{"lineBreak":true},{"text":"பயப்படுதலை புறக்கணிக்கும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அம்புகள் வைக்கும் பையும், மின்னுகிற ஈட்டியும், கேடகமும் அதின்மேல் கலகலக்கும்போது,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"கர்வமும் மூர்க்கமும்கொண்டு தரையை விழுங்கிவிடுகிறதுபோல நினைத்து,","poem":1},{"lineBreak":true},{"text":"எக்காளத்தின் சத்தத்திற்கு பயப்படாமல் பாயும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"எக்காளம் தொனிக்கும்போது அது நிகியென்று கனைக்கும்;","poem":1},{"lineBreak":true},{"text":"யுத்தத்தையும், படைத்தலைவரின் ஆர்ப்பரிப்பையும்,","poem":1},{"lineBreak":true},{"text":"சேனைகளின் ஆரவாரத்தையும் தூரத்திலிருந்து மோப்பம்பிடிக்கும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"உன் புத்தியினாலே ராஜாளி பறந்து,","poem":1},{"lineBreak":true},{"text":"தெற்கு திசைக்கு நேராகத் தன் இறக்கைகளை விரிக்கிறதோ?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"உன் கற்பனையினாலே கழுகு உயரப் பறந்து,","poem":1},{"lineBreak":true},{"text":"உயரத்திலே தன் கூட்டைக் கட்டுமோ?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அது கன்மலையிலும், கன்மலையின் உச்சியிலும்,","poem":1},{"lineBreak":true},{"text":"பாதுகாப்பான இடத்திலும் தங்கியிருக்கும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அங்கேயிருந்து இரையை நோக்கும்;","poem":1},{"lineBreak":true},{"text":"அதின் கண்கள் தூரத்திலிருந்து அதைப் பார்க்கும்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அதின் குஞ்சுகள் இரத்தத்தை உறிஞ்சும்;","poem":1},{"lineBreak":true},{"text":"பிணம் எங்கேயோ அங்கே கழுகு சேரும்” என்றார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}