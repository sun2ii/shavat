{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["எலிப்பாஸின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அப்பொழுது தேமானியனாகிய எலிப்பாஸ் மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"நாங்கள் உம்முடன் பேசத்துணிந்தால், அனுமதிப்பீரோ?","poem":1},{"lineBreak":true},{"text":"ஆனாலும் பேசாமல் அடக்கிக்கொள்ளத்தக்கவன் யார்?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"இதோ, நீர் அநேகருக்குப் புத்திசொல்லி,","poem":1},{"lineBreak":true},{"text":"சோர்ந்த கைகளைத் திடப்படுத்தினீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"விழுகிறவனை உம்முடைய வார்த்தைகளால் நிற்கச்செய்தீர்,","poem":1},{"lineBreak":true},{"text":"தள்ளாடுகிற முழங்கால்களைப் பலப்படுத்தினீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"இப்பொழுதோ துன்பம் உமக்கு சம்பவித்ததினால் சோர்ந்துபோகிறீர்;","poem":1},{"lineBreak":true},{"text":"அது உம்மைத் தொட்டதினால் கலங்குகிறீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உம்முடைய தேவபக்தி உம்முடைய உறுதியாயும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வழிகளின் உத்தமம் உம்முடைய நம்பிக்கையாகவும் இருக்கவேண்டியதல்லவோ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"குற்றமில்லாமல் அழிந்தவன் உண்டோ?","poem":1},{"lineBreak":true},{"text":"சன்மார்க்கர் அழிக்கப்பட்டது எப்போது?","poem":1},{"lineBreak":true},{"text":"இதை நினைத்துப்பாரும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நான் கண்டிருக்கிறபடி,","poem":1},{"lineBreak":true},{"text":"அநியாயத்தை உழுது, தீமையை விதைத்தவர்கள்,","poem":1},{"lineBreak":true},{"text":"அதையே அறுக்கிறார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தேவனுடைய சுவாசத்தினாலே அவர்கள் அழிந்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய மூக்கின் காற்றினாலே அழிகிறார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"சிங்கத்தின் கெர்ச்சிப்பும், கொடிய சிங்கத்தின் முழக்கமும் அடங்கும்;","poem":1},{"lineBreak":true},{"text":"பாலசிங்கங்களின் பற்களும் உடைந்துபோகும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"கிழச்சிங்கம் இரையில்லாமையால் இறந்துபோகும்,","poem":1},{"lineBreak":true},{"text":"பாலசிங்கங்கள் சிதறிப்போகும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"இப்போதும் ஒரு வார்த்தை என்னிடத்தில் இரகசியமாக அறிவிக்கப்பட்டது,","poem":1},{"lineBreak":true},{"text":"அதன் மெல்லிய ஓசை என் காதில் விழுந்தது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"மனிதர்மேல் அயர்ந்த தூக்கம் வரும்போது,","poem":1},{"lineBreak":true},{"text":"இரவு தரிசனங்களில் பலவித தோற்றங்கள் உண்டாகும்போது,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"பயமும் நடுக்கமும் என்னைப் பிடித்தது,","poem":1},{"lineBreak":true},{"text":"என் எலும்புகளெல்லாம் நடுங்கியது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அப்பொழுது ஒரு ஆவி என் முகத்திற்கு முன்பாகக் கடந்தது,","poem":1},{"lineBreak":true},{"text":"என் உடலின் முடிகள் சிலிர்த்தது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அது ஒரு உருவம் போல என் கண்களுக்குமுன் நின்றது,","poem":1},{"lineBreak":true},{"text":"ஆனாலும் அதின் உருவம் இன்னதென்று விளங்கவில்லை;","poem":1},{"lineBreak":true},{"text":"அமைதலுண்டானது, அப்பொழுது நான் கேட்ட சத்தமாவது:","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"மனிதன் தேவனைவிட நீதிமானாயிருப்பானோ?","poem":1},{"lineBreak":true},{"text":"மனிதன் தன்னை உண்டாக்கினவரைவிட சுத்தமாயிருப்பானோ?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"கேளும், அவர் தம்முடைய வேலைக்காரரிடத்தில் நம்பிக்கை வைப்பதில்லை;","poem":1},{"lineBreak":true},{"text":"தம்முடைய தூதரின்மேலும் புத்தியீனத்தைச் சுமத்துகிறாரே,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"புழுதியில் அஸ்திபாரம் போட்டு,","poem":1},{"lineBreak":true},{"text":"மண் வீடுகளில் குடியிருந்து, செல்லுப்பூச்சியால்","poem":1},{"lineBreak":true},{"text":"அரிக்கப்படுகிறவர்கள்மேல் அவர் நம்பிக்கை வைப்பது எப்படி?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"காலைமுதல் மாலைவரைக்கும் அழிந்து,","poem":1},{"lineBreak":true},{"text":"கவனிப்பார் ஒருவருமில்லாமல்,","poem":1},{"lineBreak":true},{"text":"நிலையான அழிவை அடைகிறார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவர்களிலிருக்கிற அவர்களுடைய மேன்மை போய்விடுமல்லவோ?","poem":1},{"lineBreak":true},{"text":"ஞானமடையாமல் இறக்கிறார்களே என்று சொன்னான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}