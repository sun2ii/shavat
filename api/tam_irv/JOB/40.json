{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["பின்னும் யெகோவா யோபுக்கு பதிலாக:"]},{"type":"verse","number":2,"content":[{"text":"“சர்வவல்லமையுள்ள தேவனுடன் வழக்காடி அவருக்குப் புத்தி சொல்லுகிறவன் யார்?","poem":1},{"lineBreak":true},{"text":"தேவன் பேரில் குற்றம் கண்டுபிடிக்கிறவன் இவைகளுக்குப் பதில் சொல்லட்டும் என்றார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அப்பொழுது யோபு யெகோவாவுக்கு மறுமொழியாக:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இதோ, நான் எளியவன்;","poem":1},{"lineBreak":true},{"text":"நான் உமக்கு என்ன பதில் சொல்லுவேன்;","poem":1},{"lineBreak":true},{"text":"என் கையால் என் வாயைப் பொத்திக்கொள்ளுகிறேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நான் இரண்டொருமுறை பேசினேன்; இனி நான் மறுமொழி கொடுக்காமலும் பேசாமலும் இருப்பேன் என்றான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அப்பொழுது யெகோவா பெருங்காற்றில் இருந்து யோபுக்கு பதில் சொன்னார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இப்போதும் மனிதனைப்போல நீ ஆடையைக்கட்டிக்கொள்;","poem":1},{"lineBreak":true},{"text":"நான் உன்னைக் கேட்பேன்;","poem":1},{"lineBreak":true},{"text":"நீ எனக்கு பதில் சொல்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நீ என் நியாயத்தை அவமாக்குவாயோ?","poem":1},{"lineBreak":true},{"text":"நீ உன்னை நீதிமானாக்கிக்கொள்வதற்காக என்மேல் குற்றஞ்சுமத்துவாயோ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தேவனுடைய பலத்த கைகளைப்போல உனக்கு கைகளுண்டோ?","poem":1},{"lineBreak":true},{"text":"அவரைப்போல இடிமுழக்கமாகச் சத்தமிடமுடியுமோ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இப்போதும் நீ முக்கியத்துவத்தாலும் மகத்துவத்தாலும் உன்னை அலங்கரித்து,","poem":1},{"lineBreak":true},{"text":"மகிமையையும் கனத்தையும் அணிந்துகொண்டு,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நீ உன் கோபத்தின் கடுமையை வீசி,","poem":1},{"lineBreak":true},{"text":"அகந்தையுள்ளவனையெல்லாம் தேடிப்பார்த்து தாழ்த்திவிட்டு,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பெருமையுள்ளவனையெல்லாம் கவனித்து,","poem":1},{"lineBreak":true},{"text":"அவனைப் பணியவைத்து,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கரை அவர்கள் இருக்கிற இடத்திலே மிதித்துவிடு.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீ அவர்களை ஏகமாகப் புழுதியிலே புதைத்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் முகங்களை மறைவான இடத்திலே கட்டிப்போடு.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அப்பொழுது உன் வலதுகை உனக்கு பாதுகாப்பைக் கொடுக்கும் என்று சொல்லி","poem":1},{"lineBreak":true},{"text":"நான் உன்னைப் புகழுவேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இப்போதும் பிகெமோத்தை","poem":1},{"noteId":12},{"text":"நீ கவனித்துப்பார்;","poem":1},{"lineBreak":true},{"text":"உன்னை உண்டாக்கினதுபோல அதையும் உண்டாக்கினேன்;","poem":1},{"lineBreak":true},{"text":"அது மாட்டைப்போல் புல்லைத் தின்னும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"இதோ, அதினுடைய பெலன் அதின் இடுப்பிலும்,","poem":1},{"lineBreak":true},{"text":"அதின் வீரியம் அதின் வயிற்றின் நரம்புகளிலும் இருக்கிறது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அது தன் வாலைக் கேதுரு மரத்தைப்போல் நீட்டுகிறது;","poem":1},{"lineBreak":true},{"text":"அதின் இடுப்பு நரம்புகள் பின்னிக்கொண்டிருக்கிறது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அதின் எலும்புகள் கெட்டியான வெண்கலத்தைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"அதின் கால்கள் இரும்புக் கம்பிகளைப்போலவும் இருக்கிறது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அது தேவனுடைய படைப்புகளில் முதன்மையான ஒரு படைப்பு,","poem":1},{"lineBreak":true},{"text":"அதை உண்டாக்கினவர் அதற்கு ஒரு பட்டயத்தையும் கொடுத்தார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"காட்டுமிருகங்கள் அனைத்தும் விளையாடுகிற மலைகள் அதற்கு மேய்ச்சலை விளைவிக்கும்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அது நிழலுள்ள செடிகளின் கீழும், நாணலின் மறைவிலும்,","poem":1},{"lineBreak":true},{"text":"சேற்றிலும் படுத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"தழைகளின் நிழல் அதை மூடி, நதியின் தண்ணீர்கள் அதைச் சூழ்ந்துகொள்ளும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"இதோ, நதி புரண்டு வந்தாலும் அது பயந்தோடாது;","poem":1},{"lineBreak":true},{"text":"யோர்தான் நதியளவு தண்ணீர் அதின் முகத்தில் மோதினாலும் அது அசையாமலிருக்கும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அதின் கண்கள் பார்த்திருக்க அதை யார் பிடிக்கமுடியும்?","poem":1},{"lineBreak":true},{"text":"மூக்கணாங்கயிறுபோட அதின் மூக்கை யார் குத்தமுடியும்?","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"யானையை போன்ற பெரிய மிருகம்","reference":{"chapter":40,"verse":15}}]},"thisChapterLink":"/api/tam_irv/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}