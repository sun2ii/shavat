{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“இப்போது கூப்பிடும், உமக்கு பதில் கொடுப்பவர் உண்டோ என்று பார்ப்போம்?","poem":1},{"lineBreak":true},{"text":"பரிசுத்தவான்களில் யாரை நோக்கிப் பார்ப்பீர்?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"கோபம் மூடனைக் கொல்லும்;","poem":1},{"lineBreak":true},{"text":"பொறாமை புத்தியில்லாதவனை அழிக்கும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மூடன் ஒருவன் வேரூன்றுகிறதை நான் கண்டு","poem":1},{"lineBreak":true},{"text":"உடனே அவனுடைய குடியிருக்கும் இடத்தைச் சபித்தேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவனுடைய பிள்ளைகள் காப்பாற்றுவதற்குத் தூரமாகி,","poem":1},{"lineBreak":true},{"text":"காப்பாற்றுவாரில்லாமல், வாசலிலே நொறுக்கப்பட்டார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பசித்தவன் அவனுடைய விளைச்சலை முட்செடிகளுக்குள் இருந்து பறித்துச் சாப்பிட்டான்;","poem":1},{"lineBreak":true},{"text":"பேராசைக்காரன் அவனுடைய செல்வத்தை விழுங்கினான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தீமை புழுதியிலிருந்து உண்டாகிறதுமில்லை;","poem":1},{"lineBreak":true},{"text":"வருத்தம் மண்ணிலிருந்து முளைக்கிறதுமில்லை.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தீப்பொறிகள் மேலே பறக்கிறதுபோல,","poem":1},{"lineBreak":true},{"text":"மனிதன் வருத்தம் அநுபவிக்கப் பிறந்திருக்கிறான்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆனாலும் நான் தேவனை நாடி,","poem":1},{"lineBreak":true},{"text":"என் நியாயத்தை தேவனிடத்தில் ஒப்படைப்பேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஆராய்ந்து முடியாத பெரிய காரியங்களையும், எண்ணமுடியாத","poem":1},{"lineBreak":true},{"text":"அதிசயங்களையும் அவர் செய்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தாழ்ந்தவர்களை உயரத்தில் வைத்து,","poem":1},{"lineBreak":true},{"text":"துக்கிக்கிறவர்களை காப்பாற்றி உயர்த்துகிறார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர் பூமியின்மேல் மழையை பெய்யவைத்து,","poem":1},{"lineBreak":true},{"text":"வெளிநிலங்களின்மேல் தண்ணீர்களை வருவிக்கிறார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தந்திரக்காரரின் கைகள் காரியத்தை முழுவதும் செய்துமுடிக்காமல் இருக்க,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய திட்டங்களை அவர் பொய்யாக்குகிறார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவர் ஞானிகளை அவர்களுடைய தந்திரத்திலே பிடிக்கிறார்;","poem":1},{"lineBreak":true},{"text":"தந்திரக்காரரின் ஆலோசனை கட்டப்படும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர்கள் பகற்காலத்திலே இருளுக்குள்ளாகி,","poem":1},{"lineBreak":true},{"text":"மத்தியான வேளையிலே இரவில் தடவுகிறதுபோல தடவி அலைகிறார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆனாலும் எளியவனை அவர்கள் வாயிலிருக்கிற பட்டயத்திற்கும்,","poem":1},{"lineBreak":true},{"text":"பெலவானின் கைக்கும் தடுத்து காப்பாற்றுகிறார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அதினால் தரித்திரனுக்கு நம்பிக்கை உண்டு;","poem":1},{"lineBreak":true},{"text":"தீமையானது தன் வாயை மூடும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"இதோ, தேவன் தண்டிக்கிற மனிதன் பாக்கியவான்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் சர்வவல்லவருடைய சிட்சையை அற்பமாக எண்ணாதிரும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவர் காயப்படுத்திக் காயம் கட்டுகிறார்;","poem":1},{"lineBreak":true},{"text":"அவர் அடிக்கிறார், அவருடைய கை ஆற்றுகிறது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ஆறு இக்கட்டுகளுக்கு உம்மை விலக்கிக்காப்பார்;","poem":1},{"lineBreak":true},{"text":"ஏழாவதிலும் பொல்லாப்பு உம்மைத் தொடாது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"பஞ்சகாலத்திலே அவர் உம்மை மரணத்திற்கும்,","poem":1},{"lineBreak":true},{"text":"போரிலே பட்டயத்தின் வெட்டுக்கும் விலக்கிக்காப்பார்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"நாவின் சவுக்குக்கும் மறைக்கப்படுவீர்;","poem":1},{"lineBreak":true},{"text":"அழிவு வரும்போதும் பயப்படாமலிருப்பீர்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அழிவையும் பஞ்சத்தையும் பார்த்து சிரிப்பீர்கள்;","poem":1},{"lineBreak":true},{"text":"காட்டுமிருகங்களுக்கும் பயப்படாமலிருப்பீர்கள்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"வெளியின் கற்களுடனும் உமக்கு உடன்படிக்கையிருக்கும்;","poem":1},{"lineBreak":true},{"text":"வெளியின் மிருகங்களும் உம்முடன் சமாதானமாயிருக்கும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"உம்முடைய குடியிருப்பு சமாதானத்துடன் இருக்கக் காண்பீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய குடியிருக்கும் இடத்தை விசாரிக்கும்போது","poem":1},{"lineBreak":true},{"text":"குறைவைக் காணமாட்டீர்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உம்முடைய சந்ததி பெருகி,","poem":1},{"lineBreak":true},{"text":"உம்முடைய சந்ததியார் பூமியின் தாவரங்களைப்போல இருப்பார்கள் என்பதை அறிந்துகொள்வீர்கள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தானியம் ஏற்றகாலத்திலே களஞ்சியத்தில் சேருகிறதுபோல,","poem":1},{"lineBreak":true},{"text":"முதிர்வயதிலே கல்லறையில் சேருவீர்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"இதோ, நாங்கள் ஆராய்ந்து அறிந்தது இதுதான்;","poem":1},{"lineBreak":true},{"text":"காரியம் இப்படியிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"இதை நீர் கேட்டு உமக்கு நன்மையுண்டாக அறிந்துகொள்ளும்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}