{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["யோபுவின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["யோபு மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“என் பிரச்சனைகளும்,","poem":1},{"lineBreak":true},{"text":"துன்பங்களும் தராசிலே வைக்கப்பட்டு நிறுக்கப்பட்டால், நலமாயிருக்கும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அப்பொழுது அது கடற்கரை மணலைவிட பாரமாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் என் துக்கம் சொல்லிமுடியாது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவனின் அம்புகள் எனக்குள் தைத்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவைகளின் விஷம் என் உயிரைக் குடிக்கிறது;","poem":1},{"lineBreak":true},{"text":"தேவனால் உண்டாகும் பயங்கரங்கள்","poem":1},{"lineBreak":true},{"text":"எனக்கு முன்பாக அணியணியாக நிற்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"புல் இருக்கிற இடத்திலே காட்டுக்கழுதை கத்துமோ?","poem":1},{"lineBreak":true},{"text":"தனக்குத் தீவனமிருக்கிற இடத்திலே எருது கதறுமோ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ருசியில்லாத பதார்த்தத்தை உப்பில்லாமல் சாப்பிடமுடியுமோ?","poem":1},{"lineBreak":true},{"text":"முட்டையின் வெள்ளைக்கருவில் சுவை உண்டோ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உங்கள் வார்த்தைகளை என் ஆத்துமா தொடமாட்டேன் என்கிறது;","poem":1},{"lineBreak":true},{"text":"அவைகள் வெறுப்பான உணவுபோல இருக்கிறது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆ, என் மன்றாட்டு எனக்கு அருளப்பட்டு,","poem":1},{"lineBreak":true},{"text":"நான் விரும்புவதை தேவன் எனக்குத் தந்து,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தேவன் என்னை நொறுக்க விரும்பி,","poem":1},{"lineBreak":true},{"text":"தம்முடைய கையை நீட்டி என்னை கொன்றுபோட்டால் நலமாயிருக்கும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அப்பொழுதாவது எனக்கு ஆறுதல் இருக்குமே;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது என்னை விட்டு நீங்காத வியாதியினால்","poem":1},{"lineBreak":true},{"text":"உணர்வில்லாமல் இருப்பேன்;","poem":1},{"lineBreak":true},{"text":"பரிசுத்தருடைய வார்த்தைகளை நான் மறைத்துவைக்கவில்லை,","poem":1},{"lineBreak":true},{"text":"அவர் என்னைக் கைவிடமாட்டார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நான் காத்துக்கொண்டிருக்க என் பெலன் எம்மாத்திரம்?","poem":1},{"lineBreak":true},{"text":"என் வாழ்நாள் நீடித்திருக்கச் செய்ய என் முடிவு எப்படிப்பட்டது?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என் பெலன் கற்களின் பெலனோ? என் உடல் வெண்கலமோ?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"எனக்கு உதவியானது ஒன்றும் இல்லையல்லவோ?","poem":1},{"lineBreak":true},{"text":"உதவி என்னைவிட்டு நீங்கிவிட்டதே.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"உபத்திரவப்படுகிறவனுக்கு அவனுடைய நண்பரால் தயவு கிடைக்கவேண்டும்;","poem":1},{"lineBreak":true},{"text":"அவனோ சர்வவல்லமையுள்ள தேவனுக்குப் பயப்படாமல் போகிறான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என் சகோதரர் காட்டாறுபோல மோசம்செய்கிறார்கள்; ஆறுகளின் வெள்ளத்தைப்போலக் கடந்துபோகிறார்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவைகள் குளிர்காலப் பனிக்கட்டியினாலும்,","poem":1},{"lineBreak":true},{"text":"அதில் விழுந்திருக்கிற உறைந்த மழையினாலும் கலங்கலாகி,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"வெப்பம் கண்டவுடனே உருகி வற்றி,","poem":1},{"lineBreak":true},{"text":"சூடு பட்டவுடனே தங்கள் இடத்தில் உருகிப்போகின்றன.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவைகளுடைய வழிகளின் போக்குகள் இங்குமங்கும் பிரியும்;","poem":1},{"lineBreak":true},{"text":"அவைகள் வீணாக பரவி ஒன்றுமில்லாமற்போகும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தேமாவின் பயணக்காரர் தேடி,","poem":1},{"lineBreak":true},{"text":"சேபாவின் பயணக்கூட்டங்கள்","poem":1},{"lineBreak":true},{"text":"அவைகள்மேல் நம்பிக்கை வைத்து,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தாங்கள் இப்படி நம்பினதினாலே வெட்கப்படுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவ்விடம்வரை வந்து கலங்கிப்போகிறார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அப்படியே நீங்களும் இப்பொழுது ஒன்றுக்கும் உதவாமற்போனீர்கள்;","poem":1},{"lineBreak":true},{"text":"என் ஆபத்தைக் கண்டு பயப்படுகிறீர்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"எனக்கு ஏதாகிலும் கொண்டு வாருங்கள் என்றும்,","poem":1},{"lineBreak":true},{"text":"உங்கள் செல்வத்திலிருந்து எனக்கு ஏதாவது பணம் கொடுங்கள் என்றும்;","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அல்லது சத்துருவின் கைக்கு என்னை காப்பாற்றுங்கள்,","poem":1},{"lineBreak":true},{"text":"கொடியவரின் கைக்கு என்னை தப்புவித்து காப்பாற்றிவிடுங்கள் என்றும் நான் சொன்னதுண்டோ?","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"எனக்கு பதில் சொல்லுங்கள், நான் மவுனமாயிருப்பேன்;","poem":1},{"lineBreak":true},{"text":"நான் எதிலே தவறுசெய்தேனோ அதை எனக்குத் தெரியப்படுத்துங்கள்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உண்மையான வார்த்தைகளில் எவ்வளவு வல்லமை உண்டு?","poem":1},{"lineBreak":true},{"text":"உங்கள் கடிந்துகொள்ளுதலினால் காரியம் என்ன?","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"கடிந்துகொள்ள நீங்கள் வார்த்தைகளை யோசித்து,","poem":1},{"lineBreak":true},{"text":"நம்பிக்கையற்றவனுடைய வார்த்தைகளைக் காற்றிலே விட்டுவிடுகிறீர்களோ?","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"இப்படிச் செய்து திக்கற்றவன்மேல் நீங்கள் விழுந்து,","poem":1},{"lineBreak":true},{"text":"உங்கள் நண்பனுக்குப் படுகுழியை வெட்டுகிறீர்கள்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"இப்போதும் உங்களுக்கு விருப்பமானால் என்னை நோக்கிப் பாருங்கள்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் பொய்சொல்லுகிறேனோ என்று உங்களுக்கு வெளிப்படையாகத் தெரியும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"நீங்கள் திரும்ப யோசித்து பாருங்கள்;","poem":1},{"lineBreak":true},{"text":"அநீதி காணப்படாதிருக்கும்;","poem":1},{"lineBreak":true},{"text":"திரும்ப சிந்தியுங்கள் என் நீதி அதிலே வெளிப்படும்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"என் நாவிலே அநீதி உண்டோ?","poem":1},{"lineBreak":true},{"text":"என் வாய் ஆகாதவைகளைப் பகுத்தறியாதோ?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}