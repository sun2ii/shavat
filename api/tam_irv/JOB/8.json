{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["பில்தாதின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அப்பொழுது சூகியனான பில்தாத் மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“நீர் எதுவரைக்கும் இப்படிப்பட்டவைகளைப் பேசுவீர்?","poem":1},{"lineBreak":true},{"text":"எதுவரைக்கும் உம்முடைய வாயின் வார்த்தைகள் பலமான காற்றைப்போலிருக்கும்?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேவன் நியாயத்தைப் புரட்டுவாரோ?","poem":1},{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவன் நீதியைப் புரட்டுவாரோ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உம்முடைய பிள்ளைகள் அவருக்கு விரோதமாகப் பாவம் செய்திருந்தாலும்","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய பாவத்தின் தண்டனைக்கு அவர்களை அவர் ஒப்புக்கொடுத்திருந்தாலும்,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீர் தேவனை ஏற்கனவே தேடி,","poem":1},{"lineBreak":true},{"text":"சர்வவல்லமையுள்ள தேவனை நோக்கி விண்ணப்பம்செய்து,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"சுத்தமும் செம்மையுமாய் இருந்தீர் என்றால்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது அவர் உமக்காக விழித்து நீதியுள்ள உம்முடைய குடியிருக்கும் இடத்தை செழிப்புள்ளதாக்குவார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உம்முடைய ஆரம்பம் சாதாரணமாயிருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய முடிவு சம்பூரணமாயிருக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆகையால், நீர் முந்தின தலைமுறையாரிடத்தில் விசாரித்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் முன்னோர்களின் செய்தியை ஆராய்ந்துபாரும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நாம் நேற்று உண்டானவர்கள், ஒன்றும் அறியோம்;","poem":1},{"lineBreak":true},{"text":"பூமியின்மேல் நம்முடைய நாட்கள் நிழலைப்போலிருக்கிறது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்கள் உமக்கு போதித்து, உமக்குத் தெரிவித்து,","poem":1},{"lineBreak":true},{"text":"தங்கள் இருதயத்திலிருக்கும் நியாயங்களை வெளிப்படுத்துவார்கள் அல்லவோ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சேறில்லாமல் நாணல் ஓங்கி வளருமோ?","poem":1},{"lineBreak":true},{"text":"தண்ணீரில்லாமல் கோரைப்புல் முளைக்குமோ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அது இன்னும் பச்சையாயிருக்கும்போதே,","poem":1},{"lineBreak":true},{"text":"அறுக்கப்படாதிருந்தும் மற்ற எந்தப் புல்லைவிட சீக்கிரமாக வாடிப்போகும் அல்லவோ?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவனை மறக்கிற எல்லோருடைய வழிகளும் அப்படியே இருக்கும்;","poem":1},{"lineBreak":true},{"text":"மாயக்காரரின் நம்பிக்கை அழிந்துபோகும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவனுடைய வீண் எண்ணம் வீணாகப்போய்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய நம்பிக்கை சிலந்திப்பூச்சியின் வீடுபோலிருக்கும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஒருவன் அதின் வீட்டின்மேல் விழுந்தால்,","poem":1},{"lineBreak":true},{"text":"அது நிலைக்காது, அதைப் பிடித்தால், அது நிற்காது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"வெயில் எரிக்காததற்கு முன்னே அவன் பச்சைச்செடி,","poem":1},{"lineBreak":true},{"text":"அதின் கொடிகள் அவனுடைய தோட்டத்தின்மேலே படரும்;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அதின் வேர்கள் கற்குவியலில் சிக்கி,","poem":1},{"lineBreak":true},{"text":"கற்பாறையை நாடும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அது அதினிடத்தில் இல்லாமல் அழிந்தபின்,","poem":1},{"lineBreak":true},{"text":"அது இருந்த இடம் உன்னை நான் பார்த்ததில்லையென்று மறுதலிக்கும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"இதோ, அவனுடைய வழியின் மகிழ்ச்சி இப்படியே போகிறது;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் வேறே ஆட்கள் அந்த இடத்திலிருந்து எழும்புவார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"இதோ, தேவன் உத்தமனை வெறுக்கிறதுமில்லை,","poem":1},{"lineBreak":true},{"text":"பொல்லாதவர்களுக்குக் கைகொடுக்கிறதுமில்லை.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"இனி அவர் உம்முடைய வாயைச் சிரிப்பினாலும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய உதடுகளைக் கெம்பீரத்தினாலும் நிரப்புவார்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"உம்மைப் பகைக்கிறவர்கள் வெட்கத்தால் மூடப்படுவார்கள்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கருடைய கூடாரம் அழிந்துபோகும்” என்றான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}