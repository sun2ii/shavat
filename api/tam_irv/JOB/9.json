{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_irv","name":"யோபு","commonName":"யோபு","title":"யோபு","order":18,"numberOfChapters":42,"sha256":"364fc0a9a67e459838b7980b81caa87e58f3e31b975719f54037b72aa175ac40","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_irv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["யோபுவின் வார்த்தைகள்"]},{"type":"verse","number":1,"content":["அதற்கு யோபு மறுமொழியாக:"]},{"type":"verse","number":2,"content":[{"text":"“ஆம், காரியம் இப்படியிருக்கிறது என்று அறிவேன்;","poem":1},{"lineBreak":true},{"text":"தேவனுக்கு முன்பாக மனிதன் நீதிமானாயிருப்பதெப்படி?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் அவனுடன் வழக்காட விருப்பமாயிருந்தால்,","poem":1},{"lineBreak":true},{"text":"ஆயிரத்தில் ஒன்றுக்காகிலும் அவருக்கு பதில் சொல்லமாட்டானே.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் இருதயத்தில் ஞானமுள்ளவர், பெலத்தில் பராக்கிரமமுள்ளவர்;","poem":1},{"lineBreak":true},{"text":"அவருக்கு விரோதமாகத் தன்னைக் கடினப்படுத்தி வாழ்ந்தவன் யார்?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர் மலைகளை திடீரென்று பெயர்க்கிறார்;","poem":1},{"lineBreak":true},{"text":"தம்முடைய கோபத்தில் அவைகளைப் புரட்டிப்போடுகிறார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பூமியின் தூண்கள் அதிரத்தக்கதாய் அதை அதின் இடத்திலிருந்து அசையவைக்கிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் சூரியனுக்குக் கட்டளையிட அது உதிக்காதிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவர் நட்சத்திரங்களை மறைத்துப்போடுகிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் ஒருவரே வானங்களை விரித்து,","poem":1},{"lineBreak":true},{"text":"சமுத்திர அலைகளின்மேல் நடக்கிறவர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் துருவச்சக்கர நட்சத்திரங்களையும், மிருகசீரிஷத்தையும்,","poem":1},{"lineBreak":true},{"text":"அறுமீனையும், தெற்கு மண்டலங்களையும் உண்டாக்கினவர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆராய்ந்து முடியாத பெரிய காரியங்களையும்,","poem":1},{"lineBreak":true},{"text":"எண்ணமுடியாத அதிசயங்களையும் அவர் செய்கிறார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"இதோ, அவர் என் அருகில் போகிறார்,","poem":1},{"lineBreak":true},{"text":"நான் அவரைப் பார்க்கமுடியவில்லை; அவர் கடந்துபோகிறார்,","poem":1},{"lineBreak":true},{"text":"நான் அவரை அறியவில்லை.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"இதோ, அவர் பறித்துக்கொண்டுபோகிறார், அவரை தடுப்பவன் யார்?","poem":1},{"lineBreak":true},{"text":"நீர் என்ன செய்கிறீர் என்று அவரைக் கேட்பவன் யார்?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவன் தம்முடைய கோபத்தை நிறுத்தமாட்டார்;","poem":1},{"lineBreak":true},{"text":"ஒருவருக்கொருவர் துணைநிற்கிற அகங்காரிகள் அவருக்கு அடங்கவேண்டும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"இப்படியிருக்க, அவருக்கு மறுமொழி கொடுக்கவும்,","poem":1},{"lineBreak":true},{"text":"அவருடன் வழக்காடும் வார்த்தைகளைத் தெரிந்து கொள்ளவும் நான் எம்மாத்திரம்?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நான் நீதிமானாயிருந்தாலும் அவருடன் வழக்காடாமல்,","poem":1},{"lineBreak":true},{"text":"என் நியாயாதிபதியினிடத்தில் இரக்கத்துக்காகக் கெஞ்சுவேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நான் கெஞ்சுவதினாலும், அவர் எனக்கு பதில் கொடுத்தாலும்,","poem":1},{"lineBreak":true},{"text":"அவர் என் விண்ணப்பத்தைக் கேட்டார் என்று நம்பமாட்டேன்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவர் புயலினால் என்னை முறிக்கிறார்;","poem":1},{"lineBreak":true},{"text":"காரணமில்லாமல் அநேக காயங்களை எனக்கு உண்டாக்குகிறார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நான் மூச்சுவிட எனக்கு இடங்கொடாமல்,","poem":1},{"lineBreak":true},{"text":"கசப்பினால் என்னை நிரப்புகிறார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பெலத்தைப் பார்த்தால், அவரே பெலத்தவர்;","poem":1},{"lineBreak":true},{"text":"நியாயத்தைப் பார்த்தால் என் பக்கத்தில் சாட்சி சொல்லுகிறவன் யார்?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நான் என்னை நீதிமானாக்கினாலும் என் வாயே என்னைக் குற்றவாளியாக்கும்;","poem":1},{"lineBreak":true},{"text":"நான் உத்தமன் என்று சொன்னாலும், நான் மாறுபாடானவன் என்று அது சாட்சிகொடுக்கும்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"நான் உத்தமனென்றாலும் என் உள்ளத்தை நான் அறியேன்;","poem":1},{"lineBreak":true},{"text":"என் வாழ்க்கையை வெறுப்பேன்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ஒரு காரியம் உண்டு, அதைச் சொல்லுகிறேன்;","poem":1},{"lineBreak":true},{"text":"சன்மார்க்கனையும் துன்மார்க்கனையும் அவர் அழிக்கிறார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"வாதையானது உடனே வாதித்துக் கொல்லும்போது,","poem":1},{"lineBreak":true},{"text":"அவர் குற்றமில்லாதவர்களின் சோதனையைப் பார்த்து சிரிக்கிறார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"உலகம் துன்மார்க்கர் கையில் விடப்பட்டிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அதிலிருக்கிற நியாயாதிபதிகளின் முகத்தை மூடிப்போடுகிறார்;","poem":1},{"lineBreak":true},{"text":"அவர் இதைச் செய்கிறதில்லையென்றால், வேறு யார் இதைச் செய்கிறார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"என் நாட்கள் தபால்காரர் ஓட்டத்திலும் வேகமாயிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவைகள் நன்மையைப் பார்க்காமல் பறந்துபோகும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவைகள் வேகமாக ஓடுகிற கப்பல்களைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"இரையின்மேல் பாய்கிற கழுகைப்போலவும் கடந்துபோகிறது.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"என் அங்கலாய்ப்பை நான் மறந்து, என் முகத்தின் துக்கத்தை மாற்றி,","poem":1},{"lineBreak":true},{"text":"திடன்கொள்வேன் என்று சொன்னால்,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"என் வருத்தங்களைப்பற்றிப் பயமாயிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னைக் குற்றமில்லாதவனாக நினைக்கமாட்டீர் என்று அறிவேன்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"நான் பொல்லாதவனாயிருந்தால்,","poem":1},{"lineBreak":true},{"text":"வீணாகப் போராடவேண்டியது என்ன?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"நான் உறைந்த மழைத் தண்ணீரில் முழுகி,","poem":1},{"lineBreak":true},{"text":"என் கைகளை சோப்பினால் சுத்தம்செய்தாலும்,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"நீர் என்னைச் சேற்றுப்பள்ளத்திலே அமிழ்த்துவீர்.","poem":1},{"lineBreak":true},{"text":"அப்பொழுது என் உடையே என்னை அருவருக்கும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"நான் அவருக்கு மறுமொழி சொல்லுகிறதற்கும்,","poem":1},{"lineBreak":true},{"text":"நாங்கள் ஒன்றுகூடி நியாயத்திற்கு வருகிறதற்கும்,","poem":1},{"lineBreak":true},{"text":"அவர் என்னைப்போல மனிதன் அல்லவே.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"எங்கள் இருவர்மேலும் தன் கையை வைக்கத்தக்க நடுவர் எங்களுக்குள் இல்லையே.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"அவர் தமது கோலை என்னைவிட்டு அகற்றுவாராக;","poem":1},{"lineBreak":true},{"text":"அவருடைய பயங்கரம் என்னைக் கலங்கவைக்காதிருப்பதாக.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"அப்பொழுது நான் அவருக்குப் பயப்படாமல் பேசுவேன்;","poem":1},{"lineBreak":true},{"text":"இப்பொழுதோ அப்படிச் செய்ய இடமில்லை.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}