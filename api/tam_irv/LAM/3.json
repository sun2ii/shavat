{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"LAM","translationId":"tam_irv","name":"புலம்பல்கள்","commonName":"புலம்பல்கள்","title":"புலம்பல்","order":25,"numberOfChapters":5,"sha256":"d877519ca08ac38097a22a9285ff22ed8325141d4d683d0d3895cdeb2c8c18a8","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tam_irv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"heading","content":["தீர்க்கதரிசியின் மனவேதனையும் நம்பிக்கையும்"]},{"type":"verse","number":1,"content":[{"text":"ஆண்டவருடைய கோபத்தின் பிரம்பினால் ஏற்பட்ட சிறுமையைக் கண்ட மனிதன் நான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர் என்னை வெளிச்சத்திலே அல்ல,","poem":1},{"lineBreak":true},{"text":"இருளிலே அழைத்து நடத்திவந்தார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் தமது கையை எனக்கு விரோதமாகவே தினமும் திருப்பினார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என் சதையையும், என் தோலையும் கடினமாக்கினார்;","poem":1},{"lineBreak":true},{"text":"என் எலும்புகளை நொறுக்கினார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர் எனக்கு விரோதமாக மதிலைக்கட்டி,","poem":1},{"lineBreak":true},{"text":"கசப்பினாலும் வருத்தத்தினாலும் என்னைச் சூழ்ந்துகொண்டார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ஆரம்பகாலத்தில் இறந்தவர்களைப்போல என்னை இருளான இடங்களில் கிடக்கச்செய்தார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நான் தப்பிப்போகாமலிருக்க என்னைச்சூழ வேலியடைத்தார்;","poem":1},{"lineBreak":true},{"text":"என் விலங்கை கடினமாக்கினார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நான் சத்தமிட்டுக் கூப்பிட்டாலும்,","poem":1},{"lineBreak":true},{"text":"என் ஜெபத்திற்கு வழியை அடைத்துப்போட்டார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வெட்டின கற்களின் சுவரால் என் வழிகளை அடைத்துப்போட்டார்,","poem":1},{"lineBreak":true},{"text":"என் பாதைகளைத் தாறுமாறாக்கினார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர் எனக்காகப் பதுங்கியிருக்கிற கரடியும்,","poem":1},{"lineBreak":true},{"text":"மறைவிடங்களில் தங்குகிற சிங்கமுமாயிருக்கிறார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னுடைய வழிகளை அகற்றி, என்னைத் துண்டித்துப்போட்டார்;","poem":1},{"lineBreak":true},{"text":"என்னைப் பயனற்றவனாக்கிவிட்டார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தமது வில்லை நாணேற்றி, என்னை அம்புக்கு இலக்காக வைத்தார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தம்முடைய அம்புகளை வைக்கும் பையின் அம்புகளை என் உள்ளத்தின் ஆழத்தில் படச்செய்தார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நான் என் மக்கள் அனைவருக்கும் பரியாசமும்,","poem":1},{"lineBreak":true},{"text":"தினமும் அவர்களுடைய கின்னரப் பாடலுமானேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"கசப்பினால் என்னை நிரப்பி,","poem":1},{"lineBreak":true},{"text":"எட்டியினால் என்னை வெறுப்படையச்செய்தார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவர் உணவிலுள்ள சிறுகற்களால் என் பற்களை நொறுக்கி,","poem":1},{"lineBreak":true},{"text":"என்னைச் சாம்பலில் புரளச்செய்தார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என் ஆத்துமாவைச் சமாதானத்திற்குத் தூரமாக்கினார்;","poem":1},{"lineBreak":true},{"text":"சுகத்தை மறந்தேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என் பெலனும், நான் யெகோவாவுக்குக் காத்திருந்த நம்பிக்கையும் அழிந்துபோனது என்றேன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"எட்டியும் பிச்சுமாகிய என் சிறுமையையும் என் தவிப்பையும் நினைத்தருளும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என் ஆத்துமா அவைகளை நினைத்து நினைத்து எனக்குள் உடைந்துபோகிறது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"இதை என் மனதிலே வைத்து நம்பிக்கை கொண்டிருப்பேன்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நாம் அழிந்துபோகாமலிருக்கிறது யெகோவாவுடைய கிருபையே, அவருடைய இரக்கங்களுக்கு முடிவில்லை.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவைகள் காலைதோறும் புதியவைகள்;","poem":1},{"lineBreak":true},{"text":"உமது உண்மை பெரிதாயிருக்கிறது.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"யெகோவா என் பங்கு என்று என் ஆத்துமா சொல்லும்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் அவரிடத்தில் நம்பிக்கை கொண்டிருப்பேன்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"தமக்குக் காத்திருக்கிறவர்களுக்கும், தம்மைத் தேடுகிற ஆத்துமாவுக்கும் யெகோவா நல்லவர்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய இரட்சிப்புக்கு நம்பிக்கையோடு காத்திருக்கிறது நல்லது.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"தன் இளவயதில் நுகத்தைச் சுமக்கிறது மனிதனுக்கு நல்லது.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அவரே அதைத் தன்மேல் வைத்தாரென்று அவன் தனிமையாயிருந்து மெளனமாயிருப்பானாக.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"நம்பிக்கைக்கு இடமுண்டோ என்று தன் வாய் மண்ணில்படும்படி குப்புறவிழுவானாக.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"தன்னை அடிக்கிறவனுக்குத் தன் கன்னத்தைக் காட்டி, அவமானத்தால் நிறைந்திருப்பானாக.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ஆண்டவர் என்றென்றைக்கும் கைவிடமாட்டார்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"அவர் வருத்தப்படுத்தினாலும் தமது மிகுந்த கிருபையின்படி மனமிரங்குவார்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"அவர் மனப்பூர்வமாக மனுமக்களைச் சிறுமையாக்கி வருத்தப்படுத்துகிறதில்லை.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"ஒருவன் பூமியில் சிறைப்பட்டவர்கள் அனைவரையும் தன் கால்களின்கீழ் நசுக்குகிறதையும்,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"உன்னதமான தேவனின் சமுகத்தில் மனிதர்களுடைய நியாயத்தைப் புரட்டுகிறதையும்,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"மனிதனை அவனுடைய வழக்கிலே மாறுபாடாக்குகிறதையும், ஆண்டவர் காணாதிருப்பாரோ?","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"ஆண்டவர் கட்டளையிடாமல் இருக்கும்போது,","poem":1},{"lineBreak":true},{"text":"காரியம் சம்பவிக்கும் என்று சொல்லுகிறவன் யார்?","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"உன்னதமான தேவனுடைய வாயிலிருந்து தீமையும் நன்மையும் புறப்படுகிறதில்லையோ?","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"உயிருள்ள மனிதன் முறையிடுவானேன்? அவன் தன்னுடைய பாவத்திற்கு வரும் தண்டனையைக்குறித்து முறையிடுகிறதென்ன?","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"நாம் நம்முடைய வழிகளைச் சோதித்து ஆராய்ந்து, யெகோவாவிடத்தில் திரும்பக்கடவோம்.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"நாம் நம்முடைய கைகளோடுங்கூட நம்முடைய இருதயத்தையும் பரலோகத்திலிருக்கிற தேவனிடத்திற்கு ஏறெடுப்போமாக.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"நாங்கள் துரோகம்செய்து, கலகம்செய்தோம்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் தேவரீர் மன்னிக்காமல் இருந்தீர்.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"தேவரீர் கோபத்தால் மூடிக்கொண்டு, எங்களைத் தப்பவிடாமல் பின்தொடர்ந்து கொன்றீர்.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"ஜெபம் உள்ளே நுழையமுடியாதபடி உம்மை மேகத்தால் மூடிக்கொண்டீர்.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"மக்களுக்குள்ளே எங்களைக் குப்பையும் அருவருப்புமாக்கினீர்.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"எங்கள் பகைவர்கள் எல்லோரும் எங்களுக்கு விரோதமாகத் தங்கள் வாயைத் திறந்தார்கள்.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"பயமும், படுகுழியும், பயனற்றநிலையும், அழிவும் எங்களுக்கு நேரிட்டது.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"மகளாகிய என் மக்கள் அடைந்த கேட்டினால் என் கண்களிலிருந்து கண்ணீர் வடிகிறது.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"யெகோவா பரலோகத்திலிருந்து நோக்கிப்பார்க்கும்வரை,","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"என் கண் இடைவிடாமல் ஓய்வின்றி வழிகிறது.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"என் பட்டணத்தின் பெண்கள் அனைவரினிமித்தம்,","poem":1},{"lineBreak":true},{"text":"என் கண் என் ஆத்துமாவுக்கு வேதனையுண்டாக்குகிறது.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"காரணமே இல்லாமல் என்னைப் பகைக்கிறவர்கள் என்னை ஒரு பறவையைப்போல வேட்டையாடினார்கள்.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"படுகுழியிலே என் உயிரை ஒடுக்கி, என்மேல் கல்லைவைத்தார்கள்.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"தண்ணீர் என் தலைக்குமேல் வந்தது; அழிந்தேன் என்றேன்.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"மகா ஆழமான குழியிலிருந்து, யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பெயரைச் சொல்லிக் கூப்பிட்டேன்.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"என் சத்தத்தைக் கேட்டீர்; என் பெருமூச்சுக்கும் என் கூப்பிடுதலுக்கும் உமது செவியை அடைத்துக்கொள்ளாதேயும்.","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"நான் உம்மை நோக்கிக் கூப்பிட்டநாளிலே நீர் கேட்டு: பயப்படாதே என்றீர்.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, என் ஆத்துமாவின் வழக்கை நடத்தினீர்;","poem":1},{"lineBreak":true},{"text":"என் உயிரை மீட்டுக்கொண்டீர்.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"யெகோவாவே, எனக்கு உண்டான அநியாயத்தைக் கண்டீர்; எனக்கு நியாயம் செய்யும்.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"அவர்களுடைய எல்லா விரோதத்தையும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் எனக்கு விரோதமாக நினைத்த எல்லா நினைவுகளையும் கண்டீர்.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"யெகோவாவே, அவர்கள் அவமதித்த அவமானங்களையும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் எனக்கு விரோதமாக நினைத்த எல்லா நினைவுகளையும்,","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"எனக்கு விரோதமாக எழும்பினவர்களின் வாய்ச்சொற்களையும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் நாள்முழுவதும் எனக்கு விரோதமாக யோசிக்கும் யோசனைகளையும் கேட்டீர்.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"அவர்கள் உட்கார்ந்திருப்பதையும் அவர்கள் எழுந்திருப்பதையும் நோக்கிப் பாரும்;","poem":1},{"lineBreak":true},{"text":"நான் அவர்களுடைய பாடலாயிருக்கிறேன்.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"யெகோவாவே, அவர்களுடைய கைகள் செய்த செயல்களுக்குத்தக்கதாக அவர்களுக்குப் பலன் கொடுப்பீர்.","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"அவர்களுக்கு மனவேதனையைக் கொடுப்பீர்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய சாபம் அவர்கள்மேல் இருக்கும்.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"கோபமாக அவர்களைப் பின்தொடர்ந்து,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய வானங்களின் கீழே அவர்கள் இல்லாதபடி அவர்களை அழித்துவிடுவீர்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}