{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"LAM","translationId":"tam_irv","name":"புலம்பல்கள்","commonName":"புலம்பல்கள்","title":"புலம்பல்","order":25,"numberOfChapters":5,"sha256":"d877519ca08ac38097a22a9285ff22ed8325141d4d683d0d3895cdeb2c8c18a8","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tam_irv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"heading","content":["மீண்டும் செழிப்படைவதற்கான ஜெபம்"]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, எங்களுக்குச் சம்பவித்ததை நினைத்தருளும்;","poem":1},{"lineBreak":true},{"text":"எங்கள் அவமானத்தை நோக்கிப்பாரும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எங்களுடைய சொத்து அந்நியரின் வசமாகவும், எங்களுடைய வீடுகள் வெளித்தேசத்தாரின் வசமாகவும் மாறியது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"திக்கற்றவர்களானோம், தகப்பன் இல்லை;","poem":1},{"lineBreak":true},{"text":"எங்கள் தாய்கள் விதவைகளைப்போல இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"எங்கள் தண்ணீரைப் பணத்திற்கு வாங்கிக்குடிக்கிறோம்;","poem":1},{"lineBreak":true},{"text":"எங்களுக்கு விறகு விலைக்கிரயமாக வருகிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பாரம்சுமந்து எங்கள் கழுத்து வலிக்கிறது;","poem":1},{"lineBreak":true},{"text":"நாங்கள் உழைக்கிறோம், எங்களுக்கு ஓய்வு இல்லை.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உணவினால் திருப்தியடைய எகிப்தியர்களுக்கும் அசீரியர்களுக்கும் எங்களை ஒப்படைத்தோம்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"எங்கள் முற்பிதாக்கள் பாவம்செய்து இறந்துபோனார்கள்;","poem":1},{"lineBreak":true},{"text":"நாங்கள் அவர்களுடைய அக்கிரமங்களைச் சுமக்கிறோம்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அடிமைகள் எங்களை ஆளுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"எங்களை அவர்கள் கையிலிருந்து விடுவிப்பவர்கள் இல்லை.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வனாந்திரத்தில் இருக்கிறவர்களின் பட்டயத்தினால்,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய உயிரைப் பணயம்வைத்து ஆகாரத்தைத் தேடுகிறோம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"பஞ்சத்தின் கொடுமையினால் எங்கள் தோல் அடுப்படியைப்போல் கறுத்துப்போனது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சீயோனில் இருந்த பெண்களையும் யூதா பட்டணங்களில் இருந்த இளம்பெண்களையும் அவமானப்படுத்தினார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தலைவர்களுடைய கைகளை அவர்கள் கட்டி, அவர்களை தொங்கவிட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"முதியோர்கள் மதிக்கப்படவில்லை.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"வாலிபர்களை இயந்திரம் அரைக்கக் கொண்டுபோனார்கள்;","poem":1},{"lineBreak":true},{"text":"இளைஞர்கள் விறகு சுமந்து தடுமாறி விழுகிறார்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"முதியோர்கள் வாசல்களில் உட்காருகிறதும்,","poem":1},{"lineBreak":true},{"text":"வாலிபர்கள் கின்னரங்களை வாசிக்கிறதும் நின்றுபோனது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"எங்கள் இருதயத்தின் மகிழ்ச்சி ஒழிந்துபோனது;","poem":1},{"lineBreak":true},{"text":"எங்கள் சந்தோஷம் துக்கமாக மாறினது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"எங்கள் தலையிலிருந்து கிரீடம் விழுந்தது; ஐயோ, நாங்கள் பாவம்செய்தோமே.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அதினால் எங்கள் இருதயம் பலவீனமானது;","poem":1},{"lineBreak":true},{"text":"அதினால் எங்களுடைய கண்கள் இருண்டுபோயின.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பயனற்றுக்கிடக்கிற சீயோன் மலையின்மேல் நரிகள் ஓடித்திரிகிறது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் என்றென்றைக்கும் இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய சிங்காசனம் தலைமுறை தலைமுறையாக நிலைநிற்கும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தேவரீர் என்றைக்கும் எங்களை மறந்து, நீண்ட நாட்களாக எங்களைக் கைவிட்டிருப்பது என்ன?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"யெகோவாவே, எங்களை உம்மிடத்தில் திருப்பிக்கொள்ளும், அப்பொழுது திரும்புவோம்;","poem":1},{"lineBreak":true},{"text":"ஆரம்பநாட்களிலிருந்ததுபோல எங்கள் நாட்களைப் புதியவைகளாக்கும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"எங்களை முற்றிலும் வெறுத்துவிடுவீரோ?","poem":1},{"lineBreak":true},{"text":"எங்கள்மேல் கடுங்கோபமாக இருக்கிறீரே!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}