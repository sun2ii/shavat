{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"heading","content":["மையக் கருத்து"]},{"type":"verse","number":1,"content":["தாவீதின் மகனும் இஸ்ரவேலின் ராஜாவுமாகிய சாலொமோனின் நீதிமொழிகள்:"]},{"type":"verse","number":2,"content":[{"text":"இவைகளால் ஞானத்தையும் போதகத்தையும் அறிந்து,","poem":1},{"lineBreak":true},{"text":"புத்திமதிகளை உணர்ந்து,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"விவேகம், நீதி, நியாயம், நிதானம் என்பவைகளைப்பற்றிய உபதேசத்தை அடையலாம்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இவைகள் பேதைகளுக்கு புத்தியையும், வாலிபர்களுக்கு அறிவையும் விவேகத்தையும் கொடுக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"புத்திமான் இவைகளைக் கேட்டு அறிவில் வளருவான்;","poem":1},{"lineBreak":true},{"text":"விவேகி நல்ல ஆலோசனைகளை அடைந்து;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீதிமொழியையும், அதின் அர்த்தத்தையும்,","poem":1},{"lineBreak":true},{"text":"ஞானிகளின் வாக்கியங்களையும், அவர்கள் சொன்ன மறைபொருட்களையும் அறிந்துகொள்வான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதலே ஞானத்தின் ஆரம்பம்;","poem":1},{"lineBreak":true},{"text":"மூடர் ஞானத்தையும் அறிவுரைகளையும் அசட்டை செய்கிறார்கள்.","poem":1}]},{"type":"heading","content":["ஞானம் தழுவுவதற்கான அறிவுரைகள்"]},{"type":"verse","number":8,"content":[{"text":"என் மகனே, உன்னுடைய தகப்பன் புத்தியைக் கேள்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய தாயின் போதனையைத் தள்ளாதே.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவைகள் உன்னுடைய தலைக்கு அலங்காரமான கிரீடமாகவும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய கழுத்துக்கு பொன் சங்கிலியாகவும் இருக்கும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என் மகனே, பாவிகள் உனக்கு ஆசைகாட்டினாலும்","poem":1},{"lineBreak":true},{"text":"நீ சம்மதிக்காதே.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"எங்களோடு வா, இரத்தம்சிந்தும்படி நாம் மறைந்திருந்து,","poem":1},{"lineBreak":true},{"text":"குற்றமில்லாமல் இருக்கிறவர்களை","poem":1},{"lineBreak":true},{"text":"காரணமில்லாமல் பிடிக்கும்படி ஒளிந்திருப்போம்;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பாதாளம் விழுங்குவதுபோல் நாம் அவர்களை உயிரோடு விழுங்குவோம்;","poem":1},{"lineBreak":true},{"text":"குழியில் இறங்குகிறவர்கள் விழுங்கப்படுவதுபோல்","poem":1},{"lineBreak":true},{"text":"அவர்களை முழுமையாக விழுங்குவோம்;","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"விலையுயர்ந்த எல்லாவிதப் பொருள்களையும் கண்டடைவோம்;","poem":1},{"lineBreak":true},{"text":"கொள்ளைப்பொருளினால் நம்முடைய வீடுகளை நிரப்புவோம்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"எங்களோடு பங்காளியாக இரு;","poem":1},{"lineBreak":true},{"text":"நம்மெல்லோருக்கும் ஒரே பை இருக்கும் என்று அவர்கள் சொன்னால்;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என் மகனே, நீ அவர்களோடு வழிநடவாமல்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய காலை அவர்களுடைய பாதைக்கு விலக்குவாயாக.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவர்கள் கால்கள் தீங்குசெய்ய ஓடி,","poem":1},{"lineBreak":true},{"text":"இரத்தம் சிந்த விரைகிறது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"எவ்வகையான பறவையானாலும் சரி,","poem":1},{"lineBreak":true},{"text":"அதின் கண்களுக்கு முன்பாக வலையை விரிப்பது வீணானது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"இவர்களோ தங்களுடைய இரத்தத்திற்கே மறைந்திருக்கிறார்கள்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய உயிருக்கே கண்ணிவைத்திருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பொருளாசையுள்ள எல்லோருடைய வழியும் இதுவே;","poem":1},{"lineBreak":true},{"text":"இது தன்னை உடையவர்களின் உயிரை வாங்கும்.","poem":1}]},{"type":"heading","content":["ஞானத்தைத் தள்ளுதலுக்கு எதிரான எச்சரிக்கை"]},{"type":"verse","number":20,"content":[{"text":"ஞானமானது வெளியே நின்று கூப்பிடுகிறது,","poem":1},{"lineBreak":true},{"text":"வீதிகளில் சத்தமிடுகிறது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அது ஆள் நடமாட்டமுள்ள தெருக்களின் சந்திப்பிலும்,","poem":1},{"lineBreak":true},{"text":"நகரத்தின் நுழைவு வாசலிலும் நின்று கூப்பிட்டு,","poem":1},{"lineBreak":true},{"text":"பட்டணத்தில் தன்னுடைய வார்த்தைகளைச் சொல்லுகிறது:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"பேதைகளே, நீங்கள் பேதைமையை விரும்புவதும், ஏளனம் செய்பவர்களே,","poem":1},{"lineBreak":true},{"text":"நீங்கள் ஏளனத்தில் பிரியப்படுவதும், அறிவில்லாதவர்களே,","poem":1},{"lineBreak":true},{"text":"நீங்கள் ஞானத்தை வெறுப்பதும், எதுவரைக்கும் இருக்கும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"என்னுடைய கடிந்துகொள்ளுதலுக்குத் திரும்புங்கள்;","poem":1},{"lineBreak":true},{"text":"இதோ, என்னுடைய ஆவியை உங்களுக்கு அருளுவேன்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வார்த்தைகளை உங்களுக்குத் தெரிவிப்பேன்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"நான் கூப்பிட்டும், நீங்கள் கேட்கமாட்டோம் என்கிறீர்கள்;","poem":1},{"lineBreak":true},{"text":"நான் என்னுடைய கையை நீட்டியும் கவனிக்கிறவன் ஒருவனும் இல்லை.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆலோசனையையெல்லாம் நீங்கள் தள்ளி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கடிந்துகொள்ளுதலை வெறுத்தீர்கள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ஆகையால், நானும் உங்களுடைய ஆபத்துக்காலத்தில் சிரித்து,","poem":1},{"lineBreak":true},{"text":"நீங்கள் பயப்படும் காரியம் வரும்போது ஏளனம்செய்வேன்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"நீங்கள் பயப்படும் காரியம் புயல்போல் வரும்போதும்,","poem":1},{"lineBreak":true},{"text":"ஆபத்து சூறாவளிபோல் உங்களுக்கு நேரிடும்போதும்,","poem":1},{"lineBreak":true},{"text":"நெருக்கமும் இடுக்கணும் உங்கள்மேல் வரும்போதும், ஏளனம்செய்வேன்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அப்பொழுது அவர்கள் என்னை நோக்கிக் கூப்பிடுவார்கள்;","poem":1},{"lineBreak":true},{"text":"நான் மறுஉத்திரவு கொடுக்கமாட்டேன்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் அதிகாலையிலே என்னைத் தேடுவார்கள், என்னைக் காணமாட்டார்கள்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அவர்கள் அறிவை வெறுத்தார்கள்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதலைத் தெரிந்துகொள்ளாமற்போனார்கள்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆலோசனையை அவர்கள் விரும்பவில்லை;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கடிந்துகொள்ளுதலையெல்லாம் அசட்டை செய்தார்கள்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"ஆகையால் அவர்கள் தங்களுடைய வழியின் பலனைச் சாப்பிடுவார்கள்;","poem":1},{"lineBreak":true},{"text":"தங்களுடைய யோசனைகளினால் திருப்தியடைவார்கள்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"அறிவீனர்களின் மாறுபாடு அவர்களைக் கொல்லும்,","poem":1},{"lineBreak":true},{"text":"மூடரின் பொறுப்பின்மை அவர்களை அழிக்கும்;","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"எனக்குச் செவிகொடுக்கிறவன் எவனோ,","poem":1},{"lineBreak":true},{"text":"அவன் பயமின்றி தங்கி, ஆபத்திற்குப் பயப்படாமல் அமைதியாக இருப்பான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}