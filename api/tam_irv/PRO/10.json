{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"heading","content":["சாலொமோனின் நீதிமொழிகள்"]},{"type":"verse","number":1,"content":[{"text":"சாலொமோனின் நீதிமொழிகள்:","poem":1},{"lineBreak":true},{"text":"ஞானமுள்ள மகன் தகப்பனைச் சந்தோஷப்படுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"மூடத்தனமுள்ளவனோ தாய்க்குச் சஞ்சலமாக இருக்கிறான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அநியாயத்தின் பொருட்கள் ஒன்றுக்கும் உதவாது;","poem":1},{"lineBreak":true},{"text":"நீதியோ மரணத்திற்குத் தப்புவிக்கும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவா நீதிமான்களைப் பசியினால் வருந்தவிடமாட்டார்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய பொருளையோ அகற்றிவிடுகிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"சோம்பற்கையால் வேலைசெய்கிறவன் ஏழையாவான்;","poem":1},{"lineBreak":true},{"text":"சுறுசுறுப்புள்ளவன் கையோ செல்வத்தை உண்டாக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"கோடைக்காலத்தில் சேர்க்கிறவன் புத்தியுள்ள மகன்;","poem":1},{"lineBreak":true},{"text":"அறுப்புக்காலத்தில் தூங்குகிறவனோ அவமானத்தை உண்டாக்குகிற மகன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய தலையின்மேல் ஆசீர்வாதங்கள் தங்கும்;","poem":1},{"lineBreak":true},{"text":"கொடுமையோ துன்மார்க்கனுடைய வாயை அடைக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய பெயர் புகழ்பெற்று விளங்கும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனுடைய பெயரோ அழிந்துபோகும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"இருதயத்தில் ஞானமுள்ளவன் கட்டளைகளை ஏற்றுக்கொள்ளுகிறான்;","poem":1},{"lineBreak":true},{"text":"அலப்புகிற மூடனோ விழுவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உத்தமமாக நடக்கிறவன் பத்திரமாக நடக்கிறான்;","poem":1},{"lineBreak":true},{"text":"கோணலான வழிகளில் நடக்கிறவனோ கண்டுபிடிக்கப்படுவான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"கண்சாடை காட்டுகிறவன் தவறு செய்கிறான்;","poem":1},{"lineBreak":true},{"text":"அலப்புகிற மூடன் விழுவான்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய வாய் ஜீவஊற்று;","poem":1},{"lineBreak":true},{"text":"கொடுமையோ துன்மார்க்கனுடைய வாயை அடைக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பகை விரோதங்களை எழுப்பும்;","poem":1},{"lineBreak":true},{"text":"அன்போ எல்லாப் பாவங்களையும் மூடும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"புத்திமானுடைய உதடுகளில் விளங்குவது ஞானம்;","poem":1},{"lineBreak":true},{"text":"மதிகேடனுடைய முதுகுக்கு ஏற்றது பிரம்பு.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஞானவான்கள் அறிவைச் சேர்த்துவைக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"மூடனுடைய வாய்க்குக் கேடு சமீபித்திருக்கிறது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"செல்வந்தனுடைய பொருள் அவனுக்குப் பாதுகாப்பான பட்டணம்;","poem":1},{"lineBreak":true},{"text":"ஏழைகளின் வறுமையோ அவர்களைக் கலங்கச்செய்யும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய உழைப்பு வாழ்வையும்,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனுடைய விளைவோ பாவத்தையும் பிறப்பிக்கும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"புத்திமதிகளைக் காத்துக்கொள்ளுகிறவன் ஜீவவழியில் இருக்கிறான்;","poem":1},{"lineBreak":true},{"text":"திருத்துதலை வெறுக்கிறவனோ மோசம்போகிறான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பகையை மறைக்கிறவன் பொய் உதடன்;","poem":1},{"lineBreak":true},{"text":"புறங்கூறுகிறவன் மதிகேடன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"சொற்களின் மிகுதியால் பாவமில்லாமற்போகாது;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உதடுகளை அடக்குகிறவனோ புத்திமான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய நாவு சுத்தவெள்ளி;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனுடைய மனம் அற்பவிலையும் பெறாது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய உதடுகள் அநேகருக்கு உணவளிக்கும்;","poem":1},{"lineBreak":true},{"text":"மூடரோ மதியீனத்தினால் சாவார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவாவின் ஆசீர்வாதமே செல்வத்தைத் தரும்;","poem":1},{"lineBreak":true},{"text":"அதனோடு அவர் வேதனையைக் கூட்டமாட்டார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தீவினைசெய்வது மூடனுக்கு விளையாட்டு;","poem":1},{"lineBreak":true},{"text":"புத்திமானுக்கோ ஞானம் உண்டு.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் பயப்படும் காரியம் அவனுக்கு வந்து சம்பவிக்கும்;","poem":1},{"lineBreak":true},{"text":"நீதிமான் விரும்புகிற காரியம் அவனுக்குக் கொடுக்கப்படும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"சுழல்காற்று கடந்துபோவதுபோல் துன்மார்க்கன் கடந்துபோவான்;","poem":1},{"lineBreak":true},{"text":"நீதிமானோ நிரந்தர அஸ்திபாரமுள்ளவன்;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"பற்களுக்கு புளிப்பும், கண்களுக்குப் புகையும் எப்படி இருக்கிறதோ,","poem":1},{"lineBreak":true},{"text":"அப்படியே சோம்பேறியும் தன்னை அனுப்புகிறவர்களுக்கு இருக்கிறான்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதல் ஆயுள்நாட்களைப் பெருகச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய வருடங்களோ குறுகிப்போகும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"நீதிமான்களின் நம்பிக்கை மகிழ்ச்சியாகும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கருடைய வாழ்க்கையோ அழியும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"யெகோவாவின் வழி உத்தமர்களுக்குப் பாதுகாப்பு,","poem":1},{"lineBreak":true},{"text":"அக்கிரமக்காரர்களுக்கோ கலக்கம்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"நீதிமான் என்றும் அசைக்கப்படுவதில்லை;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் பூமியில் வசிப்பதில்லை.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய வாய் ஞானத்தை வெளிப்படுத்தும்;","poem":1},{"lineBreak":true},{"text":"மாறுபாடுள்ள நாவோ அறுப்புண்டுபோகும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"நீதிமான்களுடைய உதடுகள் பிரியமானவைகளைப்பேச அறியும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய வாயோ மாறுபாடுள்ளது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}