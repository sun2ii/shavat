{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"heading","content":["நீதியின் பயன்கள்"]},{"type":"verse","number":1,"content":[{"text":"கள்ளத்தராசு யெகோவாவுக்கு அருவருப்பானது;","poem":1},{"lineBreak":true},{"text":"சரியான நிறைகல்லோ அவருக்குப் பிரியம்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அகந்தை வந்தால் அவமானமும் வரும்;","poem":1},{"lineBreak":true},{"text":"தாழ்ந்த சிந்தை உள்ளவர்களிடத்தில் ஞானம் உண்டு.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"செம்மையானவர்களுடைய உத்தமம் அவர்களை நடத்தும்;","poem":1},{"lineBreak":true},{"text":"துரோகிகளின் மாறுபாடோ அவர்களைப் பாழாக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"கோபாக்கினை நாளில் செல்வம் உதவாது;","poem":1},{"lineBreak":true},{"text":"நீதியோ மரணத்திற்குத் தப்புவிக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உத்தமனுடைய நீதி அவன் வழியைச் செம்மைப்படுத்தும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனோ தன்னுடைய துன்மார்க்கத்தினால் விழுவான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"செம்மையானவர்களுடைய நீதி அவர்களைத் தப்புவிக்கும்;","poem":1},{"lineBreak":true},{"text":"துரோகிகளோ தங்களுடைய தீவினையிலே பிடிபடுவார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் மரணமடையும்போது அவனுடைய நம்பிக்கை அழியும்;","poem":1},{"lineBreak":true},{"text":"அக்கிரமக்காரர்களின் எதிர்பார்ப்பு கெட்டுப்போகும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நீதிமான் இக்கட்டிலிருந்து விடுவிக்கப்படுவான்;","poem":1},{"lineBreak":true},{"text":"அவன் இருந்த இடத்திலே துன்மார்க்கன் வருவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மாயக்காரன் தனக்கு அடுத்தவனை வாயினால் கெடுக்கிறான்;","poem":1},{"lineBreak":true},{"text":"நீதிமானோ அறிவினால் தப்புகிறான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நீதிமான்கள் நன்றாக இருந்தால் பட்டணம் சந்தோஷமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் அழிந்தால் கெம்பீரம் உண்டாகும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"செம்மையானவர்களுடைய ஆசீர்வாதத்தினால் பட்டணம் நிலைபெற்று ஓங்கும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய வாயினால் அது இடிந்துவிழும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"மதிகெட்டவன் பிறனை அவமதிக்கிறான்;","poem":1},{"lineBreak":true},{"text":"புத்திமானோ தன்னுடைய வாயை அடக்கிக்கொண்டிருக்கிறான்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"புறங்கூறித் திரிகிறவன் இரகசியத்தை வெளிப்படுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"ஆவியில் உண்மையுள்ளவனோ காரியத்தை அடக்குகிறான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஆலோசனையில்லாத இடத்தில் மக்கள் விழுந்துபோவார்கள்;","poem":1},{"lineBreak":true},{"text":"அநேக ஆலோசனைக்காரர்கள் உண்டானால் சுகம் உண்டாகும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அந்நியனுக்காகப் பிணைப்படுகிறவன் மிகுந்த பாடுபடுவான்;","poem":1},{"lineBreak":true},{"text":"பிணைப்படுவதை வெறுப்பவன் சுகமாக இருப்பான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நல்லொழுக்கமுள்ள பெண் மானத்தைக் காப்பாள்;","poem":1},{"lineBreak":true},{"text":"பலசாலிகள் செல்வத்தைக் காப்பார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தயவுள்ள மனிதன் தன்னுடைய ஆத்துமாவுக்கு நன்மை செய்துகொள்ளுகிறான்;","poem":1},{"lineBreak":true},{"text":"கொடூரனோ தன்னுடைய உடலை அலைக்கழிக்கிறான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் வீண்வேலையைச் செய்கிறான்;","poem":1},{"lineBreak":true},{"text":"நீதியை விதைக்கிறவனோ மெய்ப்பலனைப் பெறுவான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"நீதி வாழ்வுக்கு ஏதுவாகிறதுபோல,","poem":1},{"lineBreak":true},{"text":"தீமையைப் பின்தொடருகிறவன் மரணத்திற்கு ஏதுவாகிறான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"மாறுபாடுள்ள இருதயமுடையவர்கள் யெகோவாவுக்கு அருவருப்பானவர்கள்;","poem":1},{"lineBreak":true},{"text":"உத்தம வழியில் நடக்கிறவர்களோ அவருக்குப் பிரியமானவர்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"கையோடு கைகோர்த்தாலும், கெட்டவன் தண்டனைக்குத் தப்பான்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களுடைய சந்ததியோ விடுவிக்கப்படும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"மதிகேடாக நடக்கிற அழகுள்ள பெண்,","poem":1},{"lineBreak":true},{"text":"பன்றியின் மூக்கிலுள்ள பொன் மூக்குத்திக்குச் சமம்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"நீதிமான்களுடைய ஆசை நன்மையே;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய நம்பிக்கையோ கோபத்தின் தண்டனையாக முடியும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"வாரி இறைத்தும் விருத்தியடைந்தவர்களும் உண்டு;","poem":1},{"lineBreak":true},{"text":"அதிகமாக தனக்கென்று மட்டும் வைத்துக்கொண்டும்","poem":1},{"lineBreak":true},{"text":"வறுமையடைபவர்களும் உண்டு.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உதாரகுணமுள்ள ஆத்துமா செழிக்கும்;","poem":1},{"lineBreak":true},{"text":"எவன் தண்ணீர் பாய்ச்சுகிறானோ அவனுக்குத் தண்ணீர் பாய்ச்சப்படும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தானியத்தைக் கட்டிவைக்கிறவனை மக்கள் சபிப்பார்கள்;","poem":1},{"lineBreak":true},{"text":"விற்கிறவனுடைய தலையின்மேல் ஆசீர்வாதம் தங்கும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"நன்மையை ஜாக்கிரதையுடன் தேடுகிறவன் தயையைப் பெறுவான்;","poem":1},{"lineBreak":true},{"text":"தீமையைத் தேடுகிறவனுக்கோ தீமையே வரும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"தன்னுடைய செல்வத்தை நம்புகிறவன் விழுவான்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களோ துளிரைப்போல தழைப்பார்கள்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"தன்னுடைய வீட்டைக் கலைக்கிறவன் காற்றைச் சுதந்தரிப்பான்;","poem":1},{"lineBreak":true},{"text":"மூடன் ஞானமுள்ளவனுக்கு அடிமையாவான்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய பலன் ஜீவமரம்;","poem":1},{"lineBreak":true},{"text":"ஆத்துமாக்களை ஆதாயப்படுத்திக்கொள்ளுகிறவன் ஞானமுள்ளவன்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"இதோ, நீதிமானுக்கு பூமியில் சரிக்கட்டப்படுமே; துன்மார்க்கனுக்கும்","poem":1},{"lineBreak":true},{"text":"பாவிக்கும் எத்தனை அதிகம்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}