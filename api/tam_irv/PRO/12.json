{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"heading","content":["ஞானியின் செயல்கள்"]},{"type":"verse","number":1,"content":[{"text":"புத்திமதிகளை விரும்புகிறவன் அறிவை விரும்புகிறான்;","poem":1},{"lineBreak":true},{"text":"கடிந்துகொள்ளுதலை வெறுக்கிறவனோ மிருககுணமுள்ளவன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நல்லவன் யெகோவாவிடத்தில் தயவு பெறுவான்;","poem":1},{"lineBreak":true},{"text":"கெட்டசிந்தனைகளுள்ள மனிதனை அவர் தண்டனைக்கு உட்படுத்துவார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"துன்மார்க்கத்தினால் மனிதன் நிலைவரப்படமாட்டான்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களுடைய வேரோ அசையாது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"குணசாலியான பெண் தன்னுடைய கணவனுக்கு கிரீடமாக இருக்கிறாள்;","poem":1},{"lineBreak":true},{"text":"அவமானத்தை உண்டாக்குகிறவளோ அவனுக்கு எலும்புருக்கியாக இருக்கிறாள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீதிமான்களுடைய நினைவுகள் நியாயமானவைகள்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய ஆலோசனைகளோ வஞ்சனையுள்ளவைகள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களின் வார்த்தைகள் இரத்தம் சிந்த மறைந்திருப்பதைப்பற்றியது;","poem":1},{"lineBreak":true},{"text":"உத்தமர்களுடைய வாயோ அவர்களைத் தப்புவிக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் கவிழ்க்கப்பட்டு ஒழிந்துபோவார்கள்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களுடைய வீடோ நிலைநிற்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தன்னுடைய புத்திக்குத் தகுந்தபடி மனிதன் புகழப்படுவான்;","poem":1},{"lineBreak":true},{"text":"மாறுபாடான இருதயமுள்ளவனோ இகழப்படுவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உணவில்லாதவனாக இருந்தும்,","poem":1},{"lineBreak":true},{"text":"தன்னைத்தான் மேன்மைப்படுத்துகிறவனைவிட,","poem":1},{"lineBreak":true},{"text":"மேன்மை இல்லாதவனாக இருந்தும் பணிவிடைக்காரனுள்ளவன் உத்தமன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நீதிமான் தன்னுடைய மிருகஜீவன்களைக் காப்பாற்றுகிறான்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய இரக்கமும் கொடுமையே.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தன்னுடைய நிலத்தைப் பயிரிடுகிறவன் உணவினால் திருப்தியடைவான்;","poem":1},{"lineBreak":true},{"text":"வீணர்களைப் பின்பற்றுகிறவனோ மதியற்றவன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் கெட்டவர்களுடைய வலையை விரும்புகிறான்;","poem":1},{"lineBreak":true},{"text":"நீதிமானுடைய வேர் கனி கொடுக்கும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுக்கு அவனுடைய உதடுகளின் துரோகமே கண்ணி;","poem":1},{"lineBreak":true},{"text":"நீதிமானோ நெருக்கத்திலிருந்து நீங்குவான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவனவன் தன் தன் வாயின் பலனால் திருப்தியடைவான்;","poem":1},{"lineBreak":true},{"text":"அவனவன் கைக்கிரியையின் பலனுக்குத்தக்கதாக அவனவனுக்குக் கிடைக்கும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"மதியீனனுடைய வழி அவனுடைய பார்வைக்குச் செம்மையாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"ஆலோசனைக்குச் செவிகொடுக்கிறவனோ ஞானமுள்ளவன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"மூடனுடைய கோபம் சீக்கிரத்தில் வெளிப்படும்;","poem":1},{"lineBreak":true},{"text":"அவமானத்தை மூடுகிறவனோ விவேகி.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"சத்தியவாசகன் நீதியை வெளிப்படுத்துவான்;","poem":1},{"lineBreak":true},{"text":"பொய்சாட்சிக்காரனோ வஞ்சகத்தை வெளிப்படுத்துவான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பட்டயக்குத்துகள்போல் பேசுகிறவர்களும் உண்டு;","poem":1},{"lineBreak":true},{"text":"ஞானமுள்ளவர்களுடைய நாவோ மருந்து.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"சத்திய உதடு என்றும் நிலைத்திருக்கும்;","poem":1},{"lineBreak":true},{"text":"பொய்நாவோ ஒரு நிமிடம்மாத்திரம் இருக்கும்;","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தீங்கை திட்டமிடுகிறவர்களின் இருதயத்தில் கபடம் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"சமாதானம்செய்கிற ஆலோசனைக்காரர்களுக்கு உள்ளது சந்தோஷம்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"நீதிமானுக்கு ஒரு கேடும் வராது;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களோ தீமையினால் நிறையப்படுவார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"பொய் உதடுகள் யெகோவாவுக்கு அருவருப்பானவைகள்;","poem":1},{"lineBreak":true},{"text":"உண்மையாக நடக்கிறவர்களோ அவருக்குப் பிரியம்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"விவேகமுள்ள மனிதன் அறிவை அடக்கிவைக்கிறான்;","poem":1},{"lineBreak":true},{"text":"மூடர்களுடைய இருதயமோ மதியீனத்தைப் பிரபலப்படுத்தும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஜாக்கிரதையுள்ளவர்களுடைய கை ஆளுகை செய்யும்;","poem":1},{"lineBreak":true},{"text":"சோம்பேறியோ கட்டாயமாக வேலை வாங்கப்படுவான்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"மனிதனுடைய இருதயத்திலுள்ள கவலை அதை ஒடுக்கும்;","poem":1},{"lineBreak":true},{"text":"நல்வார்த்தையோ அதை மகிழ்ச்சியாக்கும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"நீதிமான் தன்னுடைய அயலானைவிட மேன்மையுள்ளவன்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய வழியோ அவர்களை மோசப்படுத்தும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"சோம்பேறி தான் வேட்டையாடிப் பிடித்ததைச் சமைப்பதில்லை;","poem":1},{"lineBreak":true},{"text":"ஜாக்கிரதையுள்ளவனுடைய பொருளோ அருமையானது.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"நீதியின் பாதையில் வாழ்வு உண்டு;","poem":1},{"lineBreak":true},{"text":"அந்தப் பாதையில் மரணம் இல்லை.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}