{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"heading","content":["ஞானியின் நடவடிக்கை"]},{"type":"verse","number":1,"content":[{"text":"ஞானமுள்ள மகன் தகப்பனுடைய போதகத்தைக் கேட்கிறான்;","poem":1},{"lineBreak":true},{"text":"பரியாசக்காரனோ கடிந்துகொள்ளுதலை கேட்கமாட்டான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மனிதன் தன்னுடைய வாயின் பலனால் நன்மையைச் சாப்பிடுவான்;","poem":1},{"lineBreak":true},{"text":"துரோகிகளின் ஆத்துமாவோ கொடுமையை சாப்பிடும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தன்னுடைய வாயைக் காக்கிறவன் தன்னுடைய உயிரைக் காக்கிறான்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உதடுகளை விரிவாகத் திறக்கிறவனோ கலக்கமடைவான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"சோம்பேறியுடைய ஆத்துமா விரும்பியும் ஒன்றும் பெற்றுக்கொள்ளாது;","poem":1},{"lineBreak":true},{"text":"ஜாக்கிரதையுள்ளவர்களுடைய ஆத்துமாவோ செழிக்கும்;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீதிமான் பொய்ப்பேச்சை வெறுக்கிறான்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனோ வெட்கமும் அவமானமும் உண்டாக்குகிறான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீதி உத்தமவழியில் உள்ளவனைத் தற்காக்கும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கமோ பாவியைக் கவிழ்த்துப்போடும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஒன்றுமில்லாமல் இருக்கத் தன்னைச் செல்வந்தனாக நினைக்கிறவனும் உண்டு;","poem":1},{"lineBreak":true},{"text":"மிகுந்த செல்வம் இருக்கத் தன்னைத் தரித்திரனாக நினைக்கிறவனும் உண்டு.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மனிதனுடைய செல்வம் அவனுடைய உயிரை மீட்கும்;","poem":1},{"lineBreak":true},{"text":"தரித்திரனோ மிரட்டுதலைக் கேட்காமல் இருக்கிறான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நீதிமான்களின் வெளிச்சம் சந்தோஷப்படுத்தும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களின் தீபமோ அணைந்துபோகும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அகந்தையினால் மட்டும் விவாதம் பிறக்கும்;","poem":1},{"lineBreak":true},{"text":"ஆலோசனையைக் கேட்கிறவர்களிடத்திலோ ஞானம் உண்டு.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"வஞ்சனையால் தேடின பொருள் குறைந்துபோகும்;","poem":1},{"lineBreak":true},{"text":"கஷ்டப்பட்டு சேர்க்கிறவனோ விருத்தியடைவான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நெடுங்காலமாகக் காத்திருக்குதல் இருதயத்தை இளைக்கச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"விரும்பினது வரும்போதோ ஜீவமரம்போல இருக்கும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"திருவசனத்தை அவமதிக்கிறவன் நாசமடைவான்;","poem":1},{"lineBreak":true},{"text":"கற்பனைக்குப் பயப்படுகிறவனோ பலனடைவான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஞானவான்களுடைய போதகம் வாழ்வுதரும் ஊற்று;","poem":1},{"lineBreak":true},{"text":"அதினால் மரணக்கண்ணிகளுக்குத் தப்பலாம்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நற்புத்தி தயவை உண்டாக்கும்;","poem":1},{"lineBreak":true},{"text":"துரோகிகளுடைய வழியோ கரடுமுரடானது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"விவேகியானவன் அறிவோடு நடந்துகொள்ளுகிறான்;","poem":1},{"lineBreak":true},{"text":"மூடனோ தன்னுடைய மூடத்தனத்தை வெளிப்படுத்துகிறான்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"துரோகமுள்ள தூதன் தீமையிலே விழுவான்;","poem":1},{"lineBreak":true},{"text":"உண்மையுள்ள தூதுவர்களோ நல்மருந்து.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"புத்திமதிகளைத் தள்ளுகிறவன் தரித்திரத்தையும் அவமானத்தையும் அடைவான்;","poem":1},{"lineBreak":true},{"text":"கடிந்து கொள்ளுதலைக் கவனித்து நடக்கிறவனோ மேன்மையடைவான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"வாஞ்சை நிறைவேறுவது ஆத்துமாவுக்கு இனிது;","poem":1},{"lineBreak":true},{"text":"தீமையைவிட்டு விலகுவது மூடர்களுக்கு அருவருப்பு.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ஞானிகளோடு வாழ்கிறவன் ஞானமடைவான்;","poem":1},{"lineBreak":true},{"text":"மூடர்களுக்குத் தோழனோ நாசமடைவான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"பாவிகளைத் தீவினை தொடரும்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களுக்கோ நன்மை பலனாக வரும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நல்லவன் தன்னுடைய பிள்ளைகளின் பிள்ளைகளுக்கு சொத்தை வைத்துப்போகிறான்;","poem":1},{"lineBreak":true},{"text":"பாவியின் செல்வமோ நீதிமானுக்காகச் சேர்த்துவைக்கப்படும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ஏழைகளின் வயல் மிகுதியான உணவை விளைவிக்கும்;","poem":1},{"lineBreak":true},{"text":"நியாயம் கிடைக்காமல் கெட்டுப்போகிறவர்களும் உண்டு.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"பிரம்பைப் பயன்படுத்தாதவன் தன்னுடைய மகனைப் பகைக்கிறான்;","poem":1},{"lineBreak":true},{"text":"அவன்மேல் அன்பாக இருக்கிறவனோ அவனை ஏற்கனவே தண்டிக்கிறான்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"நீதிமான் தனக்குத் திருப்தியாகச் சாப்பிடுகிறான்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய வயிறோ பசியாக இருக்கும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}