{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"heading","content":["விவேகமும் அலட்சியமும்"]},{"type":"verse","number":1,"content":[{"text":"புத்தியுள்ள பெண் தன்னுடைய வீட்டைக் கட்டுகிறாள்;","poem":1},{"lineBreak":true},{"text":"புத்தியில்லாத பெண்ணோ தன்னுடைய கைகளினால் அதை இடித்துப்போடுகிறாள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நிதானமாக நடக்கிறவன் யெகோவாவுக்குப் பயப்படுகிறான்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வழிகளில் தாறுமாறானவனோ அவரை அலட்சியம்செய்கிறான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மூடன் வாயிலே அவனுடைய அகந்தைக்கு ஏற்ற கோல் உண்டு;","poem":1},{"lineBreak":true},{"text":"ஞானவான்களின் உதடுகளோ அவர்களைக் காப்பாற்றும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"எருதுகள் இல்லாத இடத்தில் களஞ்சியம் வெறுமையாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"காளைகளின் பெலத்தினாலோ மிகுந்த வரத்துண்டு.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மெய்ச்சாட்சிக்காரன் பொய்சொல்லமாட்டான்;","poem":1},{"lineBreak":true},{"text":"பொய்ச்சாட்சிக்காரனோ பொய்களை ஊதுகிறான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பரியாசக்காரன் ஞானத்தைத் தேடியும் கண்டுபிடிக்கமாட்டான்;","poem":1},{"lineBreak":true},{"text":"புத்தியுள்ளவனுக்கோ அறிவு லேசாகவரும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மூடனுடைய முகத்தைவிட்டு விலகிப்போ;","poem":1},{"lineBreak":true},{"text":"அறிவுள்ள உதடுகளை அங்கே காணமாட்டாய்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தன்னுடைய வழியைச் சிந்தித்துக்கொள்வது விவேகியின் ஞானம்;","poem":1},{"lineBreak":true},{"text":"மூடர்களுடைய வஞ்சனையோ மூடத்தனம்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மூடர்கள் பாவத்தைக்குறித்துப் பரியாசம்செய்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களுக்குள்ளே தயவு உண்டு.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இருதயத்தின் கசப்பு இருதயத்திற்கே தெரியும்;","poem":1},{"lineBreak":true},{"text":"அதின் மகிழ்ச்சிக்கு அந்நியன் உடந்தை ஆகமாட்டான்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுடைய வீடு அழியும்;","poem":1},{"lineBreak":true},{"text":"செம்மையானவனுடைய கூடாரமோ செழிக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"மனிதனுக்குச் செம்மையாகத் தோன்றுகிற வழி உண்டு;","poem":1},{"lineBreak":true},{"text":"அதின் முடிவோ மரணவழிகள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"சிரிப்பிலும் மனதிற்குத் துக்கமுண்டு;","poem":1},{"lineBreak":true},{"text":"அந்த மகிழ்ச்சியின் முடிவு சஞ்சலம்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"பின்வாங்கும் இருதயமுள்ளவன் தன்னுடைய வழிகளிலேயும்,","poem":1},{"lineBreak":true},{"text":"நல்ல மனிதனோ தன்னிலே தானும் திருப்தியடைவான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"பேதையானவன் எந்த வார்த்தையையும் நம்புவான்;","poem":1},{"lineBreak":true},{"text":"விவேகியோ தன்னுடைய நடையின்மேல் கவனமாக இருக்கிறான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஞானமுள்ளவன் பயந்து தீமைக்கு விலகுகிறான்;","poem":1},{"lineBreak":true},{"text":"மதியீனனோ கடுங்கோபம்கொண்டு துணிகரமாக இருக்கிறான்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"முன்கோபி மதிகேட்டைச் செய்வான்;","poem":1},{"lineBreak":true},{"text":"கெட்டச்சிந்தனைக்காரன் வெறுக்கப்படுவான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பேதையர்கள் புத்தியீனத்தைச் சுதந்தரிக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"விவேகிகளோ அறிவினால் முடிசூட்டப்படுகிறார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தீயோர்கள் நல்லவர்களுக்கு முன்பாகவும், துன்மார்க்கர்கள் நீதிமான்களுடைய வாசற்படிகளிலும் குனிவதுண்டு.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தரித்திரன் தன்னைச் சேர்ந்தவனாலும் பகைக்கப்படுகிறான்;","poem":1},{"lineBreak":true},{"text":"செல்வந்தனுக்கோ அநேக நண்பர்கள் உண்டு.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"பிறனை அவமதிக்கிறவன் பாவம்செய்கிறான்;","poem":1},{"lineBreak":true},{"text":"தரித்திரனுக்கு இரங்குகிறவனோ பாக்கியமடைவான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"தீமையை யோசிக்கிறவர்கள் தவறுகிறார்களல்லவோ?","poem":1},{"lineBreak":true},{"text":"நன்மையை யோசிக்கிறவர்களுக்கோ கிருபையும் சத்தியமும் உண்டு.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"எல்லா உழைப்பினாலும் பயனுண்டு;","poem":1},{"lineBreak":true},{"text":"உதடுகளின் பேச்சோ வறுமையை மட்டும் தரும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஞானிகளுக்கு முடி அவர்களுடைய செல்வம்;","poem":1},{"lineBreak":true},{"text":"மூடர்களின் மதியீனம் மூடத்தனமே.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"மெய்ச்சாட்சி சொல்லுகிறவன் உயிர்களைக் காப்பாற்றுகிறான்;","poem":1},{"lineBreak":true},{"text":"வஞ்சனைக்காரனோ பொய்களை ஊதுகிறான்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிறவனுக்குத் திடநம்பிக்கை உண்டு;","poem":1},{"lineBreak":true},{"text":"அவனுடைய பிள்ளைகளுக்கும் அடைக்கலம் கிடைக்கும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதல் வாழ்வு தரும் ஊற்று;","poem":1},{"lineBreak":true},{"text":"அதினால் மரணக்கண்ணிகளுக்குத் தப்பலாம்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"மக்கள் கூட்டம் ராஜாவின் மகிமை;","poem":1},{"lineBreak":true},{"text":"மக்கள்குறைவு தலைவனின் முறிவு.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"நீடிய சாந்தமுள்ளவன் மகாபுத்திமான்;","poem":1},{"lineBreak":true},{"text":"முன்கோபியோ புத்தியீனத்தை விளங்கச்செய்கிறான்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"சமாதானத்துடன் இருப்பது உடலுக்கு வாழ்வு;","poem":1},{"lineBreak":true},{"text":"பொறாமையோ எலும்புருக்கி.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"தரித்திரனை ஒடுக்குகிறவன் அவனை உண்டாக்கினவரை நிந்திக்கிறான்;","poem":1},{"lineBreak":true},{"text":"தரித்திரனுக்குத் தயவு செய்கிறவனோ அவரை மேன்மைப்படுத்துகிறான்;","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் தன்னுடைய தீமையிலே வாரிக்கொள்ளப்படுவான்;","poem":1},{"lineBreak":true},{"text":"நீதிமானோ தன்னுடைய மரணத்திலே நம்பிக்கையுள்ளவன்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"புத்திமானுடைய இருதயத்தில் ஞானம் தங்கும்; மதியீனர்களிடத்தில் உள்ளதோ வெளிப்படும்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"நீதி மக்களை உயர்த்தும்; பாவமோ எந்த மக்களுக்கும் இகழ்ச்சி.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ராஜாவின் தயவு விவேகமுள்ள பணிவிடைக்காரன்மேல் இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய கோபமோ அவமானத்தை உண்டாக்குகிறவன்மேல் இருக்கும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}