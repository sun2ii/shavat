{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"heading","content":["வாழ்வின் ஒழுங்குமுறைகள்"]},{"type":"verse","number":1,"content":[{"text":"சாந்தமான பதில் கடுங்கோபத்தை அடக்கும்;","poem":1},{"lineBreak":true},{"text":"கடுஞ்சொற்களோ கோபத்தை எழுப்பும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஞானிகளின் நாவு அறிவை உபயோகப்படுத்தும்;","poem":1},{"lineBreak":true},{"text":"மூடர்களின் வாயோ புத்தியீனத்தைக் கக்கும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவின் கண்கள் எந்த இடத்திலுமிருந்து,","poem":1},{"lineBreak":true},{"text":"நல்லவர்களையும், தீயவர்களையும் நோக்கிப்பார்க்கிறது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ஆரோக்கியமுள்ள நாவு ஜீவமரம்; நாவின் மாறுபாடோ ஆவியை நொறுக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மூடன் தன்னுடைய தகப்பனுடைய புத்தியை அலட்சியப்படுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"கடிந்துகொள்ளுதலைக் கவனித்து நடக்கிறவனோ விவேகி.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய வீட்டில் அதிக பொக்கிஷம் உண்டு;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனுடைய வருமானத்திலோ துன்பம் உண்டு.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஞானிகளின் உதடுகள் அறிவை விதைக்கும்;","poem":1},{"lineBreak":true},{"text":"மூடர்களின் இருதயமோ அப்படியல்ல.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய பலி யெகோவாவுக்கு அருவருப்பானது;","poem":1},{"lineBreak":true},{"text":"செம்மையானவர்களின் ஜெபமோ அவருக்குப் பிரியம்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய வழி யெகோவாவுக்கு அருவருப்பானது;","poem":1},{"lineBreak":true},{"text":"நீதியைப் பின்பற்றுகிறவனையோ அவர் நேசிக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"வழியைவிட்டு விலகுகிறவனுக்குப் புத்திமதி எரிச்சலாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"கடிந்துகொள்ளுதலை வெறுக்கிறவன் சாவான்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பாதாளமும் அழிவும் யெகோவாவின் பார்வைக்கு முன்பாக இருக்க,","poem":1},{"lineBreak":true},{"text":"மனுமக்களுடைய இருதயம் அதிகமாக அவர் முன்பாக இருக்குமல்லவோ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பரியாசக்காரன் தன்னைக் கடிந்துகொள்ளுகிறவனை நேசிக்கமாட்டான்;","poem":1},{"lineBreak":true},{"text":"ஞானவான்களிடத்தில் போகவுமாட்டான்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"மனமகிழ்ச்சி முகமலர்ச்சியைத் தரும்;","poem":1},{"lineBreak":true},{"text":"மனதுக்கத்தினாலே ஆவி முறிந்துபோகும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"புத்திமானுடைய மனம் அறிவைத்தேடும்;","poem":1},{"lineBreak":true},{"text":"மூடர்களின் வாயோ மதியீனத்தை மேயும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"சிறுமைப்பட்டவனுடைய நாட்களெல்லாம் தீங்குள்ளவைகள்;","poem":1},{"lineBreak":true},{"text":"மனரம்மியமோ நிரந்தர விருந்து.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"சஞ்சலத்தோடு கூடிய அதிகப் பொருட்களைவிட,","poem":1},{"lineBreak":true},{"text":"யெகோவாவைப் பற்றும் பயத்தோடு கூடிய கொஞ்சப்பொருளே உத்தமம்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"பகையோடு இருக்கும் கொழுத்த எருதின் கறியைவிட,","poem":1},{"lineBreak":true},{"text":"சிநேகத்தோடு இருக்கும் இலைக்கறியே நல்லது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"கோபக்காரன் சண்டையை எழுப்புகிறான்;","poem":1},{"lineBreak":true},{"text":"நீடியசாந்தமுள்ளவனோ சண்டையை அமர்த்துகிறான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"சோம்பேறியின் வழி முள்வேலிக்குச் சமம்;","poem":1},{"lineBreak":true},{"text":"நீதிமானுடைய வழியோ ராஜபாதை.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ஞானமுள்ள மகன் தகப்பனைச் சந்தோஷப்படுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"மதியற்ற மனிதனோ தன்னுடைய தாயை அலட்சியப்படுத்துகிறான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"மூடத்தனம் புத்தியீனனுக்குச் சந்தோஷம்;","poem":1},{"lineBreak":true},{"text":"புத்திமானோ தன்னுடைய செயல்களைச் செம்மைப்படுத்துகிறான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ஆலோசனை இல்லாததால் எண்ணங்கள் சிதைந்துபோகும்;","poem":1},{"lineBreak":true},{"text":"ஆலோசனைக்காரர்கள் அநேகர் இருந்தால் அவைகள் உறுதிப்படும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"மனிதனுக்குத் தன்னுடைய வாய்மொழியினால் மகிழ்ச்சியுண்டாகும்;","poem":1},{"lineBreak":true},{"text":"ஏற்றகாலத்தில் சொன்ன வார்த்தை எவ்வளவு நல்லது!","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"கீழான பாதாளத்தைவிட்டு விலகும்படி,","poem":1},{"lineBreak":true},{"text":"விவேகிக்கு வாழ்வின் வழியானது உன்னதத்தை நோக்கும் வழியாகும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அகங்காரியின் வீட்டைக் யெகோவா பிடுங்கிப்போடுவார்;","poem":1},{"lineBreak":true},{"text":"விதவையின் எல்லையையோ நிலைப்படுத்துவார்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய நினைவுகள்","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்கு அருவருப்பானவைகள்;","poem":1},{"lineBreak":true},{"text":"சுத்தமானவர்களுடைய வார்த்தைகளோ இன்பமானவைகள்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"பொருளாசைக்காரன் தன்னுடைய வீட்டைக் கலைக்கிறான்;","poem":1},{"lineBreak":true},{"text":"லஞ்சங்களை வெறுக்கிறவனோ பிழைப்பான்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய மனம் பதில் சொல்ல யோசிக்கும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனுடைய வாயோ தீமைகளைக் கொப்பளிக்கும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுக்குக் யெகோவா தூரமாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களின் ஜெபத்தையோ கேட்கிறார்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"கண்களின் ஒளி இருதயத்தைப் பூரிப்பாக்கும்;","poem":1},{"lineBreak":true},{"text":"நற்செய்தி எலும்புகளை ஆரோக்கியமாக்கும்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"வாழ்வுக்கேதுவான கடிந்துகொள்ளுதலை ஏற்றுக்கொள்ளும் காது","poem":1},{"lineBreak":true},{"text":"ஞானிகளிடத்திலே தங்கும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"புத்திமதியைத் தள்ளிவிடுகிறவன் தன்னுடைய ஆத்துமாவை வெறுக்கிறான்;","poem":1},{"lineBreak":true},{"text":"கடிந்துகொள்ளுதலைக் கேட்கிறவனோ ஞானமடைவான்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதல் ஞானத்தைப் போதிக்கும்;","poem":1},{"lineBreak":true},{"text":"மேன்மைக்கு முன்னானது தாழ்மை.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}