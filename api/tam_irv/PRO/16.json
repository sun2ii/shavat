{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"heading","content":["தேவ ஞானமும் நீதியும்"]},{"type":"verse","number":1,"content":[{"text":"மனதின் யோசனைகள் மனிதனுடையது;","poem":1},{"lineBreak":true},{"text":"நாவின் பதில் யெகோவாவால் வரும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மனிதனுடைய வழிகளெல்லாம் அவனுடைய பார்வைக்குச் சுத்தமானவைகள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவோ ஆவிகளை நிறுத்துப்பார்க்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உன்னுடைய செயல்களைக் யெகோவாவுக்கு ஒப்புவி;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது உன்னுடைய யோசனைகள் உறுதிப்படும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவா எல்லாவற்றையும் தமக்கென்று படைத்தார்;","poem":1},{"lineBreak":true},{"text":"தீங்குநாளுக்காகத் துன்மார்க்கனையும் உண்டாக்கினார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மனமேட்டிமையுள்ளவன் எவனும் யெகோவாவுக்கு அருவருப்பானவன்;","poem":1},{"lineBreak":true},{"text":"கையோடு கைகோர்த்தாலும் அவன் தண்டனைக்குத் தப்பமாட்டான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"கிருபையினாலும், சத்தியத்தினாலும் பாவம் நிவிர்த்தியாகும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிறதினால் மனிதர்கள் தீமையைவிட்டு விலகுவார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஒருவனுடைய வழிகள் யெகோவாவுக்குப் பிரியமாக இருந்தால்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய எதிரிகளும் சமாதானமாகும்படிச் செய்வார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அநியாயமாக வந்த அதிக வருமானத்தைவிட,","poem":1},{"lineBreak":true},{"text":"நியாயமாக வந்த கொஞ்ச வருமானமே நல்லது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மனிதனுடைய இருதயம் அவனுடைய வழியை யோசிக்கும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய நடைகளை உறுதிப்படுத்துகிறவரோ யெகோவா.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ராஜாவின் உதடுகளில் இனிய வார்த்தை பிறக்கும்;","poem":1},{"lineBreak":true},{"text":"நியாயத்தில் அவனுடைய வாய் தவறாது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நியாயமான நிறைகோலும் தராசும் யெகோவாவுடையது;","poem":1},{"lineBreak":true},{"text":"பையிலிருக்கும் நிறைகல்லெல்லாம் அவருடைய செயல்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அநியாயம்செய்வது ராஜாக்களுக்கு அருவருப்பு;","poem":1},{"lineBreak":true},{"text":"நீதியினால் சிங்காசனம் உறுதிப்படும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீதியுள்ள உதடுகள் ராஜாக்களுக்குப் பிரியம்;","poem":1},{"lineBreak":true},{"text":"நிதானமாகப் பேசுகிறவன்மேல் ராஜாக்கள் பிரியப்படுவார்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ராஜாவின் கோபம் மரணதூதர்களுக்குச் சமம்;","poem":1},{"lineBreak":true},{"text":"ஞானமுள்ளவனோ அதை ஆற்றுவான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ராஜாவின் முகக்களையில் வாழ்வு உண்டு;","poem":1},{"lineBreak":true},{"text":"அவனுடைய தயவு பின்மாரிபெய்யும் மேகத்தைப்போல் இருக்கும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"பொன்னைச் சம்பாதிப்பதைவிட ஞானத்தைச் சம்பாதிப்பது எவ்வளவு நல்லது!","poem":1},{"lineBreak":true},{"text":"வெள்ளியை சம்பாதிப்பதைவிட புத்தியைச் சம்பாதிப்பது எவ்வளவு மேன்மை","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தீமையை விட்டு விலகுவதே செம்மையானவர்களுக்குச் சமனான பாதை;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய நடையைக் கவனித்திருக்கிறவன் தன்னுடைய ஆத்துமாவைக் காக்கிறான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அழிவுக்கு முன்னானது அகந்தை;","poem":1},{"lineBreak":true},{"text":"விழுதலுக்கு முன்னானது மனமேட்டிமை.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அகங்காரிகளோடு கொள்ளைப்பொருளைப் பங்கிடுவதைவிட,","poem":1},{"lineBreak":true},{"text":"சிறுமையானவர்களோடு மனத்தாழ்மையாக இருப்பது நலம்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"விவேகத்துடன் காரியத்தை நடப்பிக்கிறவன் நன்மை பெறுவான்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நம்புகிறவன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"இருதயத்தில் ஞானமுள்ளவன் விவேகி எனப்படுவான்;","poem":1},{"lineBreak":true},{"text":"உதடுகளின் இனிமை கல்வியைப் பெருகச்செய்யும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"புத்தி தன்னை உடையவர்களுக்கு ஜீவஊற்று; மதியீனர்களின் போதனை மதியீனமே.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ஞானியின் இருதயம் அவனுடைய வாய்க்கு அறிவை ஊட்டும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய உதடுகளுக்கு அது மேன்மேலும் கல்வியைக் கொடுக்கும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"இனிய சொற்கள் தேன்கூடுபோல் ஆத்துமாவுக்கு இன்பமும்,","poem":1},{"lineBreak":true},{"text":"எலும்புகளுக்கு மருந்தாகும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"மனிதனுக்குச் செம்மையாகத் தோன்றுகிற வழியுண்டு;","poem":1},{"lineBreak":true},{"text":"அதின் முடிவோ மரண வழிகள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"உழைக்கிறவன் தனக்காகவே உழைக்கிறான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய வாய் அதை அவனிடத்தில் வருந்திக் கேட்கும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"வீணான மகன் கிண்டிவிடுகிறான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய உதடுகளில் இருப்பது எரிகிற அக்கினிபோன்றது.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"மாறுபாடுள்ளவன் சண்டையைக் கிளப்பிவிடுகிறான்;","poem":1},{"lineBreak":true},{"text":"கோள் சொல்லுகிறவன் உயிர் நண்பனையும் பிரித்துவிடுகிறான்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"கொடுமையானவன் தன்னுடைய அயலானுக்கு நயங்காட்டி,","poem":1},{"lineBreak":true},{"text":"அவனை நலமல்லாத வழியிலே நடக்கச்செய்கிறான்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அவனுடைய மாறுபாடானவைகளை யோசிக்கும்படி தன்னுடைய கண்களை மூடி,","poem":1},{"lineBreak":true},{"text":"தீமையைச் செய்யும்படி தன்னுடைய உதடுகளைக் கடிக்கிறான்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"நீதியின் வழியில் உண்டாகும் நரை முடியானது","poem":1},{"lineBreak":true},{"text":"மகிமையான கிரீடம்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"பலவானைவிட நீடிய சாந்தமுள்ளவன் உத்தமன்;","poem":1},{"lineBreak":true},{"text":"பட்டணத்தைப் பிடிக்கிறவனைவிட தன்னுடைய மனதை அடக்குகிறவன் உத்தமன்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"சீட்டு மடியிலே போடப்படும்;","poem":1},{"lineBreak":true},{"text":"காரியத்தின் முடிவோ யெகோவாவால் வரும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}