{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"heading","content":["விவேகத்தினால் வரும் நன்மை"]},{"type":"verse","number":1,"content":[{"text":"சண்டையோடுகூடிய வீடுநிறைந்த சுவையான உணவைவிட,","poem":1},{"lineBreak":true},{"text":"சமாதானத்தோடு சாப்பிடும் வெறும் அப்பமே நலம்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"புத்தியுள்ள வேலைக்காரன் அவமானத்தை உண்டாக்குகிற மகனை ஆண்டு,","poem":1},{"lineBreak":true},{"text":"சகோதரர்களுடைய சுதந்தரத்தில் பங்கை அடைவான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"வெள்ளியைக் குகையும், பொன்னைப் புடமும் சோதிக்கும்;","poem":1},{"lineBreak":true},{"text":"இருதயங்களைச் சோதிக்கிறவரோ யெகோவா.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தீயவன் அக்கிரம உதடுகள் சொல்வதை உற்றுக்கேட்கிறான்;","poem":1},{"lineBreak":true},{"text":"பொய்யன் கேடுள்ள நாவுக்குச் செவிகொடுக்கிறான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஏழையைப் புறக்கணிக்கிறவன் அவனை உண்டாக்கினவரை சபிக்கிறான்;","poem":1},{"lineBreak":true},{"text":"ஆபத்தைக் குறித்துக் மகிழ்கிறவன் தண்டனைக்குத் தப்பமாட்டான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பிள்ளைகளின் பிள்ளைகள் முதியோர்களுக்குக் கிரீடம்;","poem":1},{"lineBreak":true},{"text":"பிள்ளைகளின் மேன்மை அவர்களுடைய தகப்பன்மார்களே.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மேன்மையானவைகளைப் பேசும் உதடு மூடனுக்குத் தகாது;","poem":1},{"lineBreak":true},{"text":"பொய் பேசும் உதடு பிரபுவுக்கு கொஞ்சம்கூட தகாது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"லஞ்சம் வாங்குகிறவர்களின் பார்வைக்கு அது இரத்தினம்போல இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அது பார்க்கும் திசையெல்லாம் காரியம் வாய்க்கும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"குற்றத்தை மூடுகிறவன் நட்பை நாடுகிறான்;","poem":1},{"lineBreak":true},{"text":"கேட்டதைச் சொல்லுகிறவன் உயிர் நண்பனையும் பிரித்துவிடுகிறான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"மூடனை நூறடி அடிப்பதைவிட,","poem":1},{"lineBreak":true},{"text":"புத்திமானை வாயினால் கண்டிப்பதே அதிகமாக உறைக்கும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தீயவன் கலகத்தையே தேடுகிறான்;","poem":1},{"lineBreak":true},{"text":"கொடிய தூதன் அவனுக்கு விரோதமாக அனுப்பப்படுவான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தன்னுடைய மதிகேட்டில் திரியும் மதியீனனுக்கு எதிர்ப்படுவதைவிட,","poem":1},{"lineBreak":true},{"text":"குட்டிகளைப் பறிகொடுத்த கரடிக்கு எதிர்ப்படுவது மேல்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நன்மைக்குத் தீமைசெய்கிறவன் எவனோ,","poem":1},{"lineBreak":true},{"text":"அவனுடைய வீட்டைவிட்டுத் தீமை நீங்காது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"சண்டையின் ஆரம்பம் மதகைத் திறந்துவிடுகிறதுபோல இருக்கும்;","poem":1},{"lineBreak":true},{"text":"ஆதலால் விவாதம் எழும்புமுன்பு அதை விட்டுவிடு.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனை நீதிமானாக்குகிறவனும்,","poem":1},{"lineBreak":true},{"text":"நீதிமானைக் குற்றவாளியாக்குகிறவனுமாகிய இந்த இருவரும் யெகோவாவுக்கு அருவருப்பானவர்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஞானத்தை வாங்கும்படி மூடன் கையிலே பணம் என்னத்திற்கு?","poem":1},{"lineBreak":true},{"text":"அதின்மேல் அவனுக்கு மனமில்லையே.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நண்பன் எல்லாக் காலத்திலும் நேசிப்பான்;","poem":1},{"lineBreak":true},{"text":"இடுக்கணில் உதவவே சகோதரன் பிறந்திருக்கிறான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"புத்தியீனன் தன்னுடைய நண்பனுக்காக உறுதியளித்துப் பிணைப்படுகிறான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"விவாதப்பிரியன் பாவப்பிரியன்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வாசலை உயர்த்திக் கட்டுகிறவன் அழிவை நாடுகிறான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"மாறுபாடான இருதயமுள்ளவன் நன்மையைக் கண்டடைவதில்லை;","poem":1},{"lineBreak":true},{"text":"பொய் நாவுள்ளவன் தீமையில் விழுவான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"மதிகெட்ட மகனைப் பெறுகிறவன் தனக்குச் சஞ்சலம் உண்டாக அவனைப் பெறுகிறான்;","poem":1},{"lineBreak":true},{"text":"மதியீனனுடைய தகப்பனுக்கு மகிழ்ச்சியில்லை.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"மனமகிழ்ச்சி நல்ல மருந்து;","poem":1},{"lineBreak":true},{"text":"முறிந்த ஆவியோ எலும்புகளை உலரச்செய்யும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன், நீதியின் வழியைப்புரட்ட மடியிலுள்ள லஞ்சத்தை வாங்குகிறான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஞானம் புத்திமானுக்கு முன்பாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"மூடனுடைய கண்களோ பூமியின் கடைசி எல்லைகள்வரை செல்லும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"மதிகெட்ட மகன் தன்னுடைய தகப்பனுக்குச் சலிப்பும்,","poem":1},{"lineBreak":true},{"text":"தன்னைப் பெற்றவர்களுக்குக் கசப்புமானவன்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"நீதிமானைத் தண்டிப்பதும், நியாயம்செய்கிறவனைப் பிரபுக்கள் அடிக்கிறதும் தகுதியல்ல.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அறிவாளி தன்னுடைய வார்த்தைகளை அடக்குகிறான்;","poem":1},{"lineBreak":true},{"text":"விவேகி குளிர்ந்த மனமுள்ளவன்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"பேசாமலிருந்தால் மூடனும் ஞானவான் என்று எண்ணப்படுவான்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உதடுகளை மூடுகிறவன் புத்திமான் என்று எண்ணப்படுவான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}