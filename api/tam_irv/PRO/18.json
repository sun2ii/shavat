{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"heading","content":["ஞானம் வாழ்வின் வழிகாட்டி"]},{"type":"verse","number":1,"content":[{"text":"பிரிந்து போகிறவன் தன்னுடைய ஆசையின்படி செய்யப்பார்க்கிறான்,","poem":1},{"lineBreak":true},{"text":"எல்லா ஞானத்திலும் தலையிட்டுக் கொள்ளுகிறான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மூடன் ஞானத்தில் பிரியம்கொள்ளாமல்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய மனதிலுள்ளவைகளை வெளிப்படுத்தப் பிரியப்படுகிறான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் வர அவமானம் வரும்; அவமானத்தோடு இகழ்ச்சியும் வரும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மனிதனுடைய வாய்மொழிகள் ஆழமான தண்ணீர்போல இருக்கும்;","poem":1},{"lineBreak":true},{"text":"ஞானத்தின் ஊற்று பாய்கிற ஆற்றைப்போல இருக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"வழக்கிலே நீதிமானைத் தோற்கடிக்கிறதற்கு,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனுக்கு பாரபட்சம் செய்வது நல்லதல்ல.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மூடனுடைய உதடுகள் விவாதத்தில் நுழையும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய வாய் அடிகளை வரவழைக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மூடனுடைய வாய் அவனுக்குக் கேடு,","poem":1},{"lineBreak":true},{"text":"அவனுடைய உதடுகள் அவனுடைய ஆத்துமாவுக்குக் கண்ணி.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"கோள்சொல்கிறவனுடைய வார்த்தைகள் விளையாட்டுப்போல இருக்கும்,","poem":1},{"lineBreak":true},{"text":"ஆனாலும் அவைகள் உள்ளத்திற்குள் குத்தும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தன்னுடைய வேலையில் அசதியாக இருப்பவன் அனைத்தையும் அழிப்பவனுக்குச் சகோதரன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவின் நாமம் மிகவும் பலத்த கோட்டை;","poem":1},{"lineBreak":true},{"text":"நீதிமான் அதற்குள் ஓடி சுகமாக இருப்பான்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"செல்வந்தனுடைய பொருள் அவனுக்கு பாதுகாப்பான பட்டணம்;","poem":1},{"lineBreak":true},{"text":"அது அவனுடைய எண்ணத்தில் உயர்ந்த மதில்போல இருக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அழிவு வருமுன்பு மனிதனுடைய இருதயம் இறுமாப்பாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"மேன்மைக்கு முன்னானது தாழ்மை.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"காரியத்தைக் கேட்பதற்குமுன் பதில் சொல்லுகிறவனுக்கு,","poem":1},{"lineBreak":true},{"text":"அது புத்தியீனமும் வெட்கமுமாக இருக்கும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"மனிதனுடைய ஆவி அவனுடைய பலவீனத்தைத் தாங்கும்;","poem":1},{"lineBreak":true},{"text":"முறிந்த ஆவி யாரால் தாங்கக்கூடும்?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"புத்திமானுடைய மனம் அறிவைச் சம்பாதிக்கும்;","poem":1},{"lineBreak":true},{"text":"ஞானியின் செவி அறிவை நாடும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஒருவன் கொடுக்கும் வெகுமதி அவனுக்கு வழி உண்டாக்கி,","poem":1},{"lineBreak":true},{"text":"பெரியோர்களுக்கு முன்பாக அவனைக் கொண்டுபோய்விடும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தன்னுடைய வழக்கிலே முதலில் பேசுகிறவன் நீதிமான்போல் காணப்படுவான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய அயலானோ வந்து அவனை பரிசோதிக்கிறான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"சீட்டுப்போடுதல் விரோதங்களை ஒழித்து,","poem":1},{"lineBreak":true},{"text":"பலவான்கள் நடுவே நியாயம்தீர்க்கும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பாதுகாப்பான பட்டணத்தை வசப்படுத்துவதைவிட","poem":1},{"lineBreak":true},{"text":"கோபம்கொண்ட சகோதரனை வசப்படுத்துவது கடினம்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய விரோதங்கள் கோட்டைத் தாழ்ப்பாள்கள்போல இருக்கும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவனவன் வாயின் பலனால் அவனவன் வயிறு நிரம்பும்;","poem":1},{"lineBreak":true},{"text":"அவனவன் உதடுகளின் விளைவினால் அவனவன் திருப்தியாவான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"மரணமும், ஜீவனும் நாவின் அதிகாரத்தில் இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அதில் பிரியப்படுகிறவர்கள் அதின் கனியைச் சாப்பிடுவார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"மனைவியைக் கண்டடைகிறவன் நன்மையானதைக் கண்டடைகிறான்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவால் தயவையும் பெற்றுக்கொள்ளுகிறான்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தரித்திரன் கெஞ்சிக்கேட்கிறான்;","poem":1},{"lineBreak":true},{"text":"செல்வந்தன் கடினமாக உத்திரவுகொடுக்கிறான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"நண்பர்கள் உள்ளவன் நேசிக்கவேண்டும்;","poem":1},{"lineBreak":true},{"text":"சகோதரனைவிட அதிக சொந்தமாக நேசிக்கப்படுபவனும் உண்டு.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}