{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"heading","content":["ஞானம் நன்மைகளின் ஊற்று"]},{"type":"verse","number":1,"content":[{"text":"மாறுபாடான உதடுகளுள்ள மூடனைவிட,","poem":1},{"lineBreak":true},{"text":"உத்தமனாக நடக்கிற தரித்திரனே சிறப்பானவன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஆத்துமா அறிவில்லாமல் இருப்பது நல்லதல்ல;","poem":1},{"lineBreak":true},{"text":"கால் துரிதமானவன் தப்பி நடக்கிறான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மனிதனுடைய மதியீனம் அவனுடைய வழியைத் தாறுமாறாக்கும்;","poem":1},{"lineBreak":true},{"text":"என்றாலும் அவனுடைய மனம் யெகோவாவுக்கு விரோதமாக எரிச்சலடையும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"செல்வம் அநேக நண்பர்களைச் சேர்க்கும்;","poem":1},{"lineBreak":true},{"text":"தரித்திரனோ தன்னுடைய நண்பனாலும் பிரிந்துபோவான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பொய்ச்சாட்சிக்காரன் தண்டனைக்குத் தப்பான்;","poem":1},{"lineBreak":true},{"text":"பொய்களைப் பேசுகிறவனும் தப்புவதில்லை.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பிரபுவின் தயவை அநேகர் வருந்திக் கேட்பார்கள்;","poem":1},{"lineBreak":true},{"text":"கொடைகொடுக்கிறவனுக்கு எவனும் நண்பன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தரித்திரனை அவனுடைய சகோதரர்கள் எல்லோரும் பகைக்கிறார்களே,","poem":1},{"lineBreak":true},{"text":"எத்தனை அதிகமாக அவனுடைய நண்பர்கள் அவனுக்குத் தூரமாவார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய வார்த்தைகளை அவன் நாடுகிறான்,","poem":1},{"lineBreak":true},{"text":"அவைகளோ வெறும் வார்த்தைகளே.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஞானத்தைப் பெற்றுக்கொள்ளுகிறவன் தன்னுடைய ஆத்துமாவை நேசிக்கிறான்;","poem":1},{"lineBreak":true},{"text":"புத்தியைக் காக்கிறவன் நன்மையடைவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"பொய்சாட்சிக்காரன் தண்டனைக்குத் தப்பமாட்டான்;","poem":1},{"lineBreak":true},{"text":"பொய்களைப் பேசுகிறவன் நாசமடைவான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"மூடனுக்குச் செல்வம் தகாது;","poem":1},{"lineBreak":true},{"text":"பிரபுக்களை ஆண்டுகொள்வது அடிமையானவனுக்கு எவ்வளவும் தகாது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மனிதனுடைய விவேகம் அவனுடைய கோபத்தை அடக்கும்;","poem":1},{"lineBreak":true},{"text":"குற்றத்தை மன்னிப்பது அவனுக்கு மகிமை.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ராஜாவின் கோபம் சிங்கத்தின் கெர்ச்சிப்புக்குச் சமானம்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய தயவு புல்லின்மேல் பெய்யும் பனிபோல இருக்கும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"மூடனாகிய மகன் தன்னுடைய தகப்பனுக்கு மிகுந்த துக்கம்;","poem":1},{"lineBreak":true},{"text":"மனைவியின் சண்டைகள் ஓயாமல் ஒழுகும் நீர்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"வீடும் செல்வமும் பெற்றோர்கள் வைக்கும் சொத்து;","poem":1},{"lineBreak":true},{"text":"புத்தியுள்ள மனைவியோ யெகோவா அருளும் ஈவு.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"சோம்பல் தூங்கிவிழச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"அசதியானவன் பட்டினியாக இருப்பான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"கட்டளையைக் காத்துக்கொள்ளுகிறவன் தன்னுடைய ஆத்துமாவைக் காக்கிறான்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வழிகளை அவமதிக்கிறவன் சாவான்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ஏழைக்கு இரங்குகிறவன் யெகோவாவுக்குக் கடன்கொடுக்கிறான்;","poem":1},{"lineBreak":true},{"text":"அவன் கொடுத்ததை அவர் திரும்பக் கொடுப்பார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நம்பிக்கையிருக்கும்வரை உன்னுடைய மகனைத் தண்டி;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் அவனைக் கொல்ல உன்னுடைய ஆத்துமாவில் தீர்மானிக்காதே.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"கடுங்கோபி தண்டனைக்குள்ளாவான்;","poem":1},{"lineBreak":true},{"text":"நீ அவனைத் தப்புவித்தால் திரும்பவும் தப்புவிக்கவேண்டியதாக வரும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"உன்னுடைய முடிவுகாலத்தில் நீ ஞானமுள்ளவனாக இருக்கும்படி,","poem":1},{"lineBreak":true},{"text":"ஆலோசனையைக்கேட்டு, புத்திமதியை ஏற்றுக்கொள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"மனிதனுடைய இருதயத்தின் எண்ணங்கள் அநேகம்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் யெகோவாவுடைய யோசனையே நிலைநிற்கும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நன்மைசெய்ய மனிதன் கொண்டிருக்கும் ஆசையே தயவு;","poem":1},{"lineBreak":true},{"text":"பொய்யனைவிட தரித்திரன் சிறப்பானவன்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதல் வாழ்க்கைக்கு ஏதுவானது;","poem":1},{"lineBreak":true},{"text":"அதை அடைந்தவன் திருப்தியடைந்து நிலைத்திருப்பான்;","poem":1},{"lineBreak":true},{"text":"தீமை அவனை அணுகாது.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"சோம்பேறி தன்னுடைய கையை பாத்திரத்திலே வைத்து,","poem":1},{"lineBreak":true},{"text":"அதைத் திரும்பத் தன்னுடைய வாய்க்குகூட கொண்டுபோகாமல் இருக்கிறான்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"பரியாசக்காரனை அடி, அப்பொழுது பேதை எச்சரிக்கப்படுவான்;","poem":1},{"lineBreak":true},{"text":"புத்திமானைக் கடிந்துகொள், அவன் அறிவுள்ளவனாவான்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தன்னுடைய தகப்பனைக் கொள்ளையடித்து, தன்னுடைய தாயைத் துரத்திவிடுகிறவன்,","poem":1},{"lineBreak":true},{"text":"வெட்கத்தையும், அவமானத்தையும் உண்டாக்குகிற மகன்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"என் மகனே, அறிவைத் தரும் வார்த்தைகளைவிட்டு விலகச்செய்யும்","poem":1},{"lineBreak":true},{"text":"போதகங்களை நீ கேட்காதே.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அநியாய சாட்சிக்காரன் நியாயத்தை சபிக்கிறான்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய வாய் அக்கிரமத்தை விழுங்கும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"பரியாசக்காரர்களுக்குத் தண்டனைகளும்,","poem":1},{"lineBreak":true},{"text":"மூடர்களுடைய முதுகுக்கு அடிகளும் ஆயத்தமாக இருக்கிறது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}