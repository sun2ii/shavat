{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["ஞானத்தின் நற்பலன்கள்"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, நீ உன்னுடைய செவியை ஞானத்திற்குச் சாய்த்து,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய இருதயத்தைப் புத்திக்கு அமையச்செய்வதற்காக,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நீ என்னுடைய வார்த்தைகளை ஏற்றுக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கட்டளைகளை உன்னிடத்தில் பத்திரப்படுத்தி,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ஞானத்தை வா என்று கூப்பிட்டு, புத்தியைச் சத்தமிட்டு அழைத்து,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அதை வெள்ளியைப்போல் நாடி,","poem":1},{"lineBreak":true},{"text":"புதையல்களைத் தேடுகிறதுபோல் தேடினால்,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அப்பொழுது யெகோவாவுக்குப் பயப்படுதல் இன்னதென்று நீ உணர்ந்து,","poem":1},{"lineBreak":true},{"text":"தேவனை அறியும் அறிவைக் கண்டடைவாய்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா ஞானத்தைத் தருகிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய வாயிலிருந்து அறிவும் புத்தியும் வரும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் நீதிமான்களுக்கென்று மெய்ஞானத்தை வைத்திருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"உத்தமமாக நடக்கிறவர்களுக்கு அவர் கேடகமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் நியாயத்தின் வழிகளைத் தற்காத்து,","poem":1},{"lineBreak":true},{"text":"தம்முடைய பரிசுத்தவான்களின் பாதையைக் காப்பாற்றுகிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அப்பொழுது நீதியையும், நியாயத்தையும், நிதானத்தையும்,","poem":1},{"lineBreak":true},{"text":"எல்லா நல்வழிகளையும் அறிந்துகொள்வாய்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஞானம் உன்னுடைய இருதயத்தில் நுழைந்து,","poem":1},{"lineBreak":true},{"text":"அறிவு உன்னுடைய ஆத்துமாவுக்கு இன்பமாக இருக்கும்போது,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நல்யோசனை உன்னைக் காப்பாற்றும்,","poem":1},{"lineBreak":true},{"text":"புத்தி உன்னைப் பாதுகாக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அதினால் நீ துன்மார்க்கர்களுடைய வழிக்கும்,","poem":1},{"lineBreak":true},{"text":"மாறுபாடு பேசுகிற மனிதனுக்கும்,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"இருளான வழிகளில் நடக்க நீதிநெறிகளைவிட்டு,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தீமைசெய்ய மகிழ்ந்து, துன்மார்க்கர்களுடைய மாறுபாடுகளில் களிகூருகிறவர்களுக்கும்,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"மாறுபாடான பாதைகளிலும் கோணலான வழிகளிலும் நடக்கிறவர்களுக்கும்","poem":1},{"lineBreak":true},{"text":"நீ தப்புவிக்கப்படுவாய்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தன்னுடைய இளவயதின் நாயகனை விட்டு,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய தேவனுடைய உடன்படிக்கையை மறந்து,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ஆசை வார்த்தைகளைப் பேசும் அந்நிய பெண்ணாகிய ஒழுங்கீனமானவளுக்கும் தப்புவிக்கப்படுவாய்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவளுடைய வீடு மரணத்திற்கும்,","poem":1},{"lineBreak":true},{"text":"அவளுடைய பாதைகள் மரித்தவர்களிடத்திற்கும் சாய்கிறது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவளிடத்தில் போகிறவர்களில் ஒருவரும் திரும்புகிறதில்லை,","poem":1},{"lineBreak":true},{"text":"வாழ்வின்பாதைகளில் வந்து சேருகிறதுமில்லை.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ஆதலால் நீ நல்லவர்களின் வழியிலே நடந்து,","poem":1},{"lineBreak":true},{"text":"நீதிமான்களின் பாதைகளைக் காத்துக்கொள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"நன்மை செய்கிறவர்கள் பூமியிலே தங்குவார்கள்;","poem":1},{"lineBreak":true},{"text":"உத்தமர்கள் அதிலே தங்கியிருப்பார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களோ பூமியிலிருந்து துண்டிக்கப்பட்டுபோவார்கள்;","poem":1},{"lineBreak":true},{"text":"துரோகிகள் அதில் இல்லாதபடி அழிவார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}