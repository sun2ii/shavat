{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"heading","content":["தீமையைத் தவிர்த்தல்"]},{"type":"verse","number":1,"content":[{"text":"திராட்சைரசம் பரியாசம்செய்யும்; மதுபானம் கூச்சலிடும்;","poem":1},{"lineBreak":true},{"text":"அதினால் மயங்குகிற ஒருவனும் ஞானவானல்ல.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ராஜாவின் கோபம் சிங்கத்தின் கெர்ச்சிப்புக்குச் சமம்;","poem":1},{"lineBreak":true},{"text":"அவனைக் கோபப்படுத்துகிறவன் தன்னுடைய உயிருக்கே துரோகம்செய்கிறான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"வழக்குக்கு விலகுவது மனிதனுக்கு மேன்மை;","poem":1},{"lineBreak":true},{"text":"மூடனானவன் எவனும் அதிலே தலையிட்டுக்கொள்வான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"சோம்பேறி குளிருகிறது என்று உழமாட்டான்;","poem":1},{"lineBreak":true},{"text":"அறுப்பிலே பிச்சைகேட்டாலும் அவனுக்கு ஒன்றும் கிடைக்காது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மனிதனுடைய இருதயத்திலுள்ள யோசனை ஆழமான தண்ணீர்போல இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"புத்திமானோ அதை மொண்டெடுப்பான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மனிதர்கள் பெரும்பாலும் தங்களுடைய தாராள குணத்தை பிரபலப்படுத்துவார்கள்;","poem":1},{"lineBreak":true},{"text":"உண்மையான மனிதனைக் கண்டுபிடிப்பவன் யார்?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீதிமான் தன்னுடைய உத்தமத்திலே நடக்கிறான்;","poem":1},{"lineBreak":true},{"text":"அவனுக்குப்பிறகு அவனுடைய பிள்ளைகளும் பாக்கியவான்களாக இருப்பார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நியாயாசனத்தில் வீற்றிருக்கும் ராஜா","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கண்களினால் எல்லாத் தீங்கையும் சிதறச்செய்கிறான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயத்தைச் சுத்தமாக்கினேன்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாவம் நீங்க சுத்தமானேன் என்று சொல்லக்கூடியவன் யார்?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"வெவ்வேறான நிறைகல்லும்,","poem":1},{"lineBreak":true},{"text":"வெவ்வேறான மரக்காலும் ஆகிய இவ்விரண்டும் யெகோவாவுக்கு அருவருப்பானவைகள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பிள்ளையானாலும், அதின் செயல்கள் சுத்தமோ செம்மையோ என்பது,","poem":1},{"lineBreak":true},{"text":"அதின் செயலினால் வெளிப்படும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"கேட்கிற காதும், காண்கிற கண்ணும்","poem":1},{"lineBreak":true},{"text":"ஆகிய இந்த இரண்டையும் யெகோவா உண்டாக்கினார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தூக்கத்தை விரும்பாதே, விரும்பினால் தரித்திரனாவாய்;","poem":1},{"lineBreak":true},{"text":"கண்விழித்திரு, அப்பொழுது உணவினால் திருப்தியாவாய்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"வாங்குகிறவன்: நல்லதல்ல, நல்லதல்ல என்பான்;","poem":1},{"lineBreak":true},{"text":"போய்விட்டபின்போ மெச்சிக்கொள்வான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"பொன்னும் மிகுதியான முத்துக்களும் உண்டு;","poem":1},{"lineBreak":true},{"text":"அறிவுள்ள உதடுகளோ விலை உயர்ந்த இரத்தினம்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அந்நியனுக்காகப் பிணைப்பட்டவனுடைய ஆடையை எடுத்துக்கொள்;","poem":1},{"lineBreak":true},{"text":"அந்நிய பெண்ணுக்காக அவனுடைய கையில் ஈடுவாங்கிக்கொள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"வஞ்சனையினால் வந்த உணவு மனிதனுக்கு இன்பமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"பின்போ அவனுடைய வாய் உணவுப்பருக்கைக் கற்களால் நிரப்பப்படும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"ஆலோசனையினால் எண்ணங்கள் உறுதிப்படும்;","poem":1},{"lineBreak":true},{"text":"நல்யோசனை செய்து யுத்தம்செய்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தூற்றிக்கொண்டு திரிகிறவன் இரகசியங்களை வெளிப்படுத்துவான்;","poem":1},{"lineBreak":true},{"text":"ஆதலால் தன்னுடைய உதடுகளினால் அதிகம் பேசுகிறவனோடு சேராதே.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தன்னுடைய தகப்பனையும் தன்னுடைய தாயையும் தூஷிக்கிறவனுடைய","poem":1},{"lineBreak":true},{"text":"தீபம் காரிருளில் அணைந்துபோகும்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ஆரம்பத்திலே விரைவாகக் கிடைத்த சுதந்தரம் முடிவிலே ஆசீர்வாதம் பெறாது.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"தீமைக்குச் சரிக்கட்டுவேன் என்று சொல்லாதே;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குக் காத்திரு, அவர் உன்னை இரட்சிப்பார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"வெவ்வேறான நிறைகற்கள்","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்கு அருவருப்பானவைகள்;","poem":1},{"lineBreak":true},{"text":"கள்ளத்தராசு நல்லதல்ல.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"யெகோவாவாலே மனிதர்களுடைய நடைகள் வாய்க்கும்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் மனிதன் தன்னுடைய வழியை அறிந்துகொள்வது எப்படி?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"பரிசுத்தமானதை விழுங்குகிறதும், பொருத்தனை செய்தபின்பு யோசிக்கிறதும்,","poem":1},{"lineBreak":true},{"text":"மனிதனுக்குக் கண்ணியாக இருக்கும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ஞானமுள்ள ராஜா துன்மார்க்கர்களை சிதறடித்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள்மேல் உருளையை உருட்டுவான்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"மனிதனுடைய ஆவி யெகோவா தந்த தீபமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அது உள்ளத்தில் உள்ளவைகளையெல்லாம் ஆராய்ந்துபார்க்கும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"தயையும் சத்தியமும் ராஜாவைக் காக்கும்;","poem":1},{"lineBreak":true},{"text":"தயையினாலே தன்னுடைய சிங்காசனத்தை நிற்கச்செய்வான்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"வாலிபர்களின் அலங்காரம் அவர்களுடைய பலம்;","poem":1},{"lineBreak":true},{"text":"முதிர்வயதானவர்களின் மகிமை அவர்கள் நரை.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"காயத்தின் தழும்புகளும்,","poem":1},{"lineBreak":true},{"text":"உள்ளத்தில் உறைக்கும் அடிகளும்,","poem":1},{"lineBreak":true},{"text":"பொல்லாதவனை அழுக்கு நீங்கத் துடைக்கும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}