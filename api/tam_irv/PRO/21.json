{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"heading","content":["யெகோவாவின் ஆளுகை"]},{"type":"verse","number":1,"content":[{"text":"ராஜாவின் இருதயம் யெகோவாவின் கையில் நீரூற்றைப்போல இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அதைத் தமது சித்தத்தின்படி அவர் திருப்புகிறார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மனிதனுடைய வழியெல்லாம் அவனுடைய பார்வைக்குச் செம்மையாகத் தோன்றும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவோ இருதயங்களை நிறுத்திப்பார்க்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பலியிடுவதைவிட, நீதியும் நியாயமும் செய்வதே யெகோவாவுக்குப் பிரியம்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மேட்டிமையான பார்வையும்,","poem":1},{"lineBreak":true},{"text":"அகந்தையான மனமுமுள்ள துன்மார்க்கர்கள் போடும் வெளிச்சம் பாவமே.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஜாக்கிரதையுள்ளவனுடைய நினைவுகள் செல்வத்திற்கும்,","poem":1},{"lineBreak":true},{"text":"பதறுகிறவனுடைய நினைவுகள் தரித்திரத்திற்கும் ஏதுவாகும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பொய்நாவினால் பொருளைச் சம்பாதிப்பது","poem":1},{"lineBreak":true},{"text":"சாவைத் தேடுகிறவர்கள் விடுகிற சுவாசம்போல இருக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் நியாயம்செய்ய மனமில்லாமல் இருக்கிறபடியால்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் அழிக்கப்பட்டுபோவார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"குற்றமுள்ளவன் தன்னுடைய வழிகளில் மாறுபாடுள்ளவன்;","poem":1},{"lineBreak":true},{"text":"சுத்தமுள்ளவனோ தன்னுடைய செயலில் செம்மையானவன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"சண்டைக்காரியோடு ஒரு பெரிய வீட்டில் குடியிருப்பதைவிட,","poem":1},{"lineBreak":true},{"text":"வீட்டின்மேல் ஒரு மூலையில் தங்கியிருப்பதே நலம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுடைய மனம் தீங்கைச் செய்ய விரும்பும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய கண்களில் அவனுடைய அயலானுக்கு இரக்கம் கிடையாது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பரியாசக்காரனைத் தண்டிக்கும்போது பேதை ஞானமடைவான்;","poem":1},{"lineBreak":true},{"text":"ஞானவான் போதிக்கப்படும்போது அறிவடைவான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீதிபரர் துன்மார்க்கர்களுடைய வீட்டைக் கவனித்துப்பார்க்கிறார்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களைத் தீங்கில் கவிழ்த்துப்போடுவார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ஏழையின் கூக்குரலுக்குத் தன்னுடைய செவியை அடைத்துக்கொள்ளுகிறவன்,","poem":1},{"lineBreak":true},{"text":"தானும் சத்தமிட்டுக் கூப்பிடும்போது கேட்கப்படமாட்டான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"இரகசியமாக கொடுக்கப்பட்ட வெகுமதி கோபத்தைத் தணிக்கும்;","poem":1},{"lineBreak":true},{"text":"மடியிலுள்ள லஞ்சம் கோபத்தை ஆற்றும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நியாயம்தீர்ப்பது நீதிமானுக்கு சந்தோஷமும்,","poem":1},{"lineBreak":true},{"text":"அக்கிரமக்காரர்களுக்கோ அழிவுமாகும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"விவேகத்தின் வழியைவிட்டுத் தப்பி நடக்கிற மனிதன் செத்தவர்களின் கூட்டத்தில் தங்குவான்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"சிற்றின்பப்பிரியன் தரித்திரனாவான்;","poem":1},{"lineBreak":true},{"text":"மதுபானத்தையும் எண்ணெயையும் விரும்புகிறவன் செல்வந்தனாவதில்லை.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நீதிமானுக்கு பதிலாக துன்மார்க்கனும்,","poem":1},{"lineBreak":true},{"text":"செம்மையானவனுக்கு பதிலாக துரோகியும் மீட்கும் பொருளாவார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"சண்டைக்காரியும் கோபக்காரியுமான பெண்ணுடன் குடியிருப்பதைவிட","poem":1},{"lineBreak":true},{"text":"வனாந்தரத்தில் குடியிருப்பது நலம்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"வேண்டிய செல்வமும் எண்ணெயும் ஞானவானுடைய வீட்டில் உண்டு;","poem":1},{"lineBreak":true},{"text":"மூடனோ அதைச் செலவழித்துப்போடுகிறான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"நீதியையும் தயவையும் பின்பற்றுகிறவன்","poem":1},{"lineBreak":true},{"text":"நல்வாழ்வையும் நீதியையும் மகிமையையும் கண்டடைவான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"பலவான்களுடைய பட்டணத்தின் மதிலை ஞானமுள்ளவன் ஏறிப்பிடித்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் நம்பின மதில்சுவரை இடித்துப்போடுவான்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தன்னுடைய வாயையும் தன்னுடைய நாவையும் காக்கிறவன்","poem":1},{"lineBreak":true},{"text":"தன்னுடைய ஆத்துமாவை இடுக்கண்களுக்கு விலக்கிக் காக்கிறான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அகங்காரமும் அகந்தையும் உள்ளவனுக்குப் பரியாசக்காரன் என்று பெயர்,","poem":1},{"lineBreak":true},{"text":"அவன் அகந்தையான கோபத்தோடு நடக்கிறான்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"சோம்பேறியின் கைகள் வேலைசெய்யச் சம்மதிக்காததால்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய ஆசை அவனைக் கொல்லும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவன் நாள்தோறும் ஆவலுடன் விரும்புகிறான்;","poem":1},{"lineBreak":true},{"text":"நீதிமானோ தனக்கென்று வைத்துக்கொள்ளாமல் கொடுப்பான்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"துன்மார்க்கருடைய பலி அருவருப்பானது;","poem":1},{"lineBreak":true},{"text":"அதைத் தீயசிந்தையோடு செலுத்தினாலோ எத்தனை அதிகமாக அருவருக்கப்படும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"பொய்ச்சாட்சிக்காரன் கெட்டுப்போவான்;","poem":1},{"lineBreak":true},{"text":"செவிகொடுக்கிறவனோ எப்பொழுதும் பேசக்கூடியவனாவான்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் தன்னுடைய முகத்தைக் கடினப்படுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"செம்மையானவனோ தன்னுடைய வழியை நேர்ப்படுத்துகிறான்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்கு விரோதமான","poem":1},{"lineBreak":true},{"text":"ஞானமும், புத்தியும், ஆலோசனையும் இல்லை.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"குதிரை யுத்தநாளுக்கு ஆயத்தமாக்கப்படும்;","poem":1},{"lineBreak":true},{"text":"வெற்றியோ யெகோவாவால் வரும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}