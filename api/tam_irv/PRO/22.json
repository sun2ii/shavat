{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"heading","content":["சமுதாய வாழ்வின் விதிகள்"]},{"type":"verse","number":1,"content":[{"text":"திரளான செல்வத்தைவிட நற்புகழே தெரிந்துகொள்ளப்படக்கூடியது;","poem":1},{"lineBreak":true},{"text":"பொன் வெள்ளியைவிட தயையே நலம்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"செல்வந்தனும், தரித்திரனும் ஒருவரையொருவர் சந்திக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் அனைவரையும் உண்டாக்கினவர் யெகோவா.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"விவேகி ஆபத்தைக் கண்டு மறைந்து கொள்ளுகிறான்;","poem":1},{"lineBreak":true},{"text":"பேதைகள் நேராகப்போய் தண்டிக்கப்படுகிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தாழ்மைக்கும் யெகோவாவுக்குப் பயப்படுதலுக்கும் வரும் பலன் செல்வமும்,","poem":1},{"lineBreak":true},{"text":"மகிமையும் ஜீவனும் ஆகும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மாறுபாடுள்ளவனுடைய வழியிலே முட்களும் கண்ணிகளும் உண்டு;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய ஆத்துமாவைக் காக்கிறவன்","poem":1},{"lineBreak":true},{"text":"அவைகளைவிட்டுத் தூரமாக விலகிப்போவான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பிள்ளையை நடக்கவேண்டிய வழியிலே அவனை நடத்து;","poem":1},{"lineBreak":true},{"text":"அவனுடைய முதிர்வயதிலும் அதை விடாமல் இருப்பான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"செல்வந்தன் தரித்திரனை ஆளுகிறான்;","poem":1},{"lineBreak":true},{"text":"கடன் வாங்கினவன் கடன் கொடுத்தவனுக்கு அடிமை.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அநியாயத்தை விதைக்கிறவன் வருத்தத்தை அறுப்பான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய கடுங்கோபத்தின் கோல் ஒழியும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"கருணைக்கண்ணன் ஆசீர்வதிக்கப்படுவான்;","poem":1},{"lineBreak":true},{"text":"அவன் தன்னுடைய உணவில் தரித்திரனுக்குக் கொடுக்கிறான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"பரியாசக்காரனைத் துரத்திவிடு;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது சண்டை நீங்கும், விரோதமும் அவமானமும் ஒழியும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சுத்த இருதயத்தை விரும்புகிறவனுடைய உதடுகள் இனிமையானவைகள்;","poem":1},{"lineBreak":true},{"text":"ராஜா அவனுக்கு நண்பனாவான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய கண்கள் ஞானத்தைக் காக்கும்;","poem":1},{"lineBreak":true},{"text":"துரோகிகளின் வார்த்தைகளையோ அவர் தாறுமாறாக்குகிறார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"வெளியிலே சிங்கம்,","poem":1},{"lineBreak":true},{"text":"வீதியிலே கொல்லப்படுவேன் என்று சோம்பேறி சொல்லுவான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஒழுங்கீனமான பெண்களின் வாய் ஆழமான படுகுழி;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய கோபத்திற்கு ஏதுவானவன் அதிலே விழுவான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"பிள்ளையின் இருதயத்தில் மதியீனம் ஒட்டியிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அதைத் தண்டனையின் பிரம்பு அவனைவிட்டு அகற்றும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தனக்கு அதிகம் உண்டாகத் தரித்திரனை ஒடுக்குகிறவன்,","poem":1},{"lineBreak":true},{"text":"தனக்குக் குறைச்சல் உண்டாகவே செல்வந்தனுக்குக் கொடுப்பான்.","poem":1}]},{"type":"heading","content":["ஞானிகளுடைய சொல்"]},{"type":"verse","number":17,"content":[{"text":"உன் செவியைச் சாய்த்து, ஞானிகளுடைய வார்த்தைகளைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"என் போதகத்தை உன் இருதயத்தில் வை.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவைகளை உன் உள்ளத்தில் காத்து,","poem":1},{"lineBreak":true},{"text":"அவைகளை உன்னுடைய உதடுகளில் நிலைத்திருக்கச்செய்யும்போது,","poem":1},{"lineBreak":true},{"text":"அது இன்பமாக இருக்கும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"உன் நம்பிக்கை யெகோவாமேல் இருக்கும்படி,","poem":1},{"lineBreak":true},{"text":"இன்றையதினம் அவைகளை உனக்குத் தெரியப்படுத்துகிறேன்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"சத்திய வார்த்தைகளின் யதார்த்தத்தை நான் உனக்குத் தெரிவிக்கும்படிக்கும்,","poem":1},{"lineBreak":true},{"text":"நீ உன்னை அனுப்பினவர்களுக்குச் சத்திய வார்த்தைகளை பதிலாக சொல்லும்படிக்கும்,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ஆலோசனையையும்,","poem":1},{"lineBreak":true},{"text":"ஞானத்தையும் பற்றி நான் உனக்கு முக்கியமானவைகளை எழுதவில்லையா?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"ஏழையாக இருக்கிறான் என்று ஏழையைக் கொள்ளையிடாதே;","poem":1},{"lineBreak":true},{"text":"சிறுமையானவனை நீதிமன்றத்தில் உபத்திரவப்படுத்தாதே.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"யெகோவா அவர்களுக்காக வழக்காடி,","poem":1},{"lineBreak":true},{"text":"அவர்களைக் கொள்ளையிடுகிறவர்களுடைய உயிரைக் கொள்ளையிடுவார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"கோபக்காரனுக்குத் தோழனாகாதே;","poem":1},{"lineBreak":true},{"text":"கோபமுள்ள மனிதனோடு நடக்காதே.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அப்படிச் செய்தால். நீ அவனுடைய வழிகளைக் கற்றுக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய ஆத்துமாவுக்குக் கண்ணியை கொண்டுவருவாய்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"உறுதியளித்து உடன்பட்டு,","poem":1},{"lineBreak":true},{"text":"கடனுக்காகப் பிணைப்படுகிறவர்களில் ஒருவனாகாதே.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"செலுத்த உனக்கு ஒன்றும் இல்லாமல் இருந்தால்,","poem":1},{"lineBreak":true},{"text":"நீ படுத்திருக்கும் படுக்கையையும் அவன் எடுத்துக்கொள்ளவேண்டியதாகுமே.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"உன்னுடைய முன்னோர்கள் நாட்டின ஆரம்ப எல்லைக்குறியை மாற்றாதே.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"தன்னுடைய வேலையில் ஜாக்கிரதையாக இருக்கிறவனை நீ கண்டால்,","poem":1},{"lineBreak":true},{"text":"அவன் சாதாரணமானவர்களுக்கு முன்பாக நிற்காமல்,","poem":1},{"lineBreak":true},{"text":"ராஜாக்களுக்கு முன்பாக நிற்பான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}