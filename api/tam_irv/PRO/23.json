{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"heading","content":["உணவைக்குறித்த எச்சரிக்கை"]},{"type":"verse","number":1,"content":[{"text":"நீ ஒரு அதிபதியோடு சாப்பிடுவதற்கு உட்கார்ந்தால்,","poem":1},{"lineBreak":true},{"text":"உனக்கு முன்பாக இருக்கிறதை நன்றாகக் கவனித்துப்பார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நீ சாப்பாட்டு பிரியனாக இருந்தால், உன்னுடைய தொண்டையிலே கத்தியை வை.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவனுடைய ருசியுள்ள உணவுகள்மீது ஆசைப்படாதே;","poem":1},{"lineBreak":true},{"text":"அவைகள் வஞ்சக உணவாக இருக்கலாம்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"செல்வந்தனாகவேண்டுமென்று முயற்சிக்காதே;","poem":1},{"lineBreak":true},{"text":"சுயபுத்தியைச் சாராதே.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"இல்லாமற்போகும் பொருள்மேல் உன்னுடைய கண்களை ஏன் பறக்கவிடவேண்டும்?","poem":1},{"lineBreak":true},{"text":"அது கழுகைப்போல சிறகுகளைத் தனக்கு உண்டாக்கிக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"வானில் பறந்துபோகும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பொறாமைக்காரனுடைய உணவை சாப்பிடாதே;","poem":1},{"lineBreak":true},{"text":"அவனுடைய ருசியுள்ள உணவுகளில் ஆசைப்படாதே.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவனுடைய இருதயத்தின் நினைவு எப்படியோ,","poem":1},{"lineBreak":true},{"text":"அப்படியே அவனும் இருக்கிறான்;","poem":1},{"lineBreak":true},{"text":"சாப்பிடும், குடியும் என்று அவன் உன்னோடு சொன்னாலும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய இருதயம் உன்னோடு இருக்காது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நீ சாப்பிட்ட உணவை வாந்தியெடுத்து,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய இனிய சொற்களை இழந்துபோவாய்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மூடனுடைய காதுகள் கேட்கப் பேசாதே;","poem":1},{"lineBreak":true},{"text":"அவன் உன்னுடைய வார்த்தைகளின் ஞானத்தை அசட்டை செய்வான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"பழைய எல்லைக்கல்லை மாற்றாதே;","poem":1},{"lineBreak":true},{"text":"திக்கற்ற பிள்ளைகளுடைய நிலங்களை அபகரித்துக்கொள்ளாதே.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர்களுடைய மீட்பர் வல்லவர்;","poem":1},{"lineBreak":true},{"text":"அவர் உன்னுடனே அவர்களுக்காக வழக்காடுவார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உன் இருதயத்தைப் புத்திமதிக்கும்,","poem":1},{"lineBreak":true},{"text":"உன் காதுகளை அறிவின் வார்த்தைகளுக்கும் சாய்ப்பாயாக.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"பிள்ளையை தண்டிக்காமல் விடாதே;","poem":1},{"lineBreak":true},{"text":"அவனைப் பிரம்பினால் அடித்தால் அவன் சாகமாட்டான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நீ பிரம்பினால் அவனை அடிக்கிறதினால்","poem":1},{"lineBreak":true},{"text":"பாதாளத்திற்கு அவனுடைய ஆத்துமாவைத் தப்புவிப்பாயே.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என் மகனே, உன்னுடைய இருதயம் ஞானமுள்ளதாக இருந்தால்,","poem":1},{"lineBreak":true},{"text":"என்னிலே என்னுடைய இருதயம் மகிழும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உன் உதடுகள் செம்மையானவைகளைப் பேசினால்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உள்மனம் மகிழும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உன் மனதைப் பாவிகள்மேல் பொறாமைகொள்ள விடாதே;","poem":1},{"lineBreak":true},{"text":"நீ நாள்தோறும் யெகோவாவைப் பற்றும் பயத்தோடு இரு.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நிச்சயமாகவே முடிவு உண்டு;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய நம்பிக்கை வீண்போகாது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"என் மகனே, நீ கேட்டு ஞானமடைந்து,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய இருதயத்தை நல்வழியிலே நடத்து.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"மதுபானப்பிரியர்களோடும்,","poem":1},{"lineBreak":true},{"text":"இறைச்சி அதிகமாக சாப்பிடுகிறவர்களோடும் சேராதே.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"குடியனும், சாப்பாட்டுப்பிரியனும் தரித்திரராவார்கள்;","poem":1},{"lineBreak":true},{"text":"தூக்கம் கிழிந்த துணிகளை அணிவிக்கும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"உன்னைப் பெற்ற தகப்பனுக்குச் செவிகொடு;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய தாய் வயதானவளாகும்போது அவளை புறக்கணிக்காதே.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"சத்தியத்தை வாங்கு, அதை விற்காதே;","poem":1},{"lineBreak":true},{"text":"அப்படியே ஞானத்தையும் உபதேசத்தையும் புத்தியையும் வாங்கு.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய தகப்பன் மிகவும் களிகூருவான்;","poem":1},{"lineBreak":true},{"text":"ஞானமுள்ள பிள்ளையைப் பெற்றவன் அவனால் மகிழுவான்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உன் தகப்பனும் உன் தாயும் சந்தோஷப்படுவார்கள்;","poem":1},{"lineBreak":true},{"text":"உன்னைப் பெற்றவள் மகிழுவாள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"என் மகனே, உன்னுடைய இருதயத்தை எனக்குக் கொடு;","poem":1},{"lineBreak":true},{"text":"உன் கண்கள் என்னுடைய வழிகளைப் பார்ப்பதாக.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ஒழுங்கீனமானவள் ஆழமான படுகுழி;","poem":1},{"lineBreak":true},{"text":"அந்நியனுடைய மனைவி இடுக்கமான கிணறு.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அவள் கொள்ளைக்காரனைப்போல் ஒளிந்திருந்து,","poem":1},{"lineBreak":true},{"text":"மனிதர்களுக்குள்ளே பாவிகளைப் பெருகச்செய்கிறாள்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"ஐயோ, யாருக்கு வேதனை?","poem":1},{"lineBreak":true},{"text":"யாருக்குத் துக்கம்?","poem":1},{"lineBreak":true},{"text":"யாருக்குச் சண்டைகள்? யாருக்குப் புலம்பல்?","poem":1},{"lineBreak":true},{"text":"யாருக்குக் காரணமில்லாத காயங்கள்? யாருக்கு இரத்தம்கலங்கின கண்கள்?","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"மதுபானம் இருக்கும் இடத்திலே தங்கி வாழ்பவர்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"கலப்புள்ள சாராயத்தை நாடுகிறவர்களுக்கும்தானே.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"மதுபானம் இரத்த நிறமாக இருந்து,","poem":1},{"lineBreak":true},{"text":"பாத்திரத்தில் பளபளப்பாகத் தோன்றும்போது,","poem":1},{"lineBreak":true},{"text":"நீ அதைப் பார்க்காதே; அது மெதுவாக இறங்கும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"முடிவிலே அது பாம்பைப்போல் கடிக்கும்,","poem":1},{"lineBreak":true},{"text":"விரியனைப்போல் தீண்டும்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"உன் கண்கள் ஒழுங்கீனமான பெண்களை நோக்கும்;","poem":1},{"lineBreak":true},{"text":"உன் உள்ளம் தாறுமாறானவைகளைப் பேசும்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"நீ நடுக்கடலிலே தூங்குகிறவனைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"பாய்மரத்தட்டிலே படுத்திருக்கிறவனைப்போலவும் இருப்பாய்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"என்னை அடித்தார்கள், எனக்கு நோகவில்லை;","poem":1},{"lineBreak":true},{"text":"என்னை அறைந்தார்கள், எனக்குச் சுரணையில்லை;","poem":1},{"lineBreak":true},{"text":"நான் அதைப் பின்னும் தொடர்ந்து தேட எப்பொழுது விழிப்பேன் என்பாய்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}