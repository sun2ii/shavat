{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["ஞானத்திற்கான அறிவுரைகள்"]},{"type":"verse","number":1,"content":[{"text":"பொல்லாத மனிதர்கள்மேல் பொறாமைகொள்ளாதே;","poem":1},{"lineBreak":true},{"text":"அவர்களோடு இருக்கவும் விரும்பாதே.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர்களுடைய இருதயம் கொடுமையை யோசிக்கும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய உதடுகள் தீவினையைப் பேசும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"வீடு ஞானத்தினாலே கட்டப்பட்டு, விவேகத்தினாலே நிலைநிறுத்தப்படும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அறிவினாலே அறைகளில் அருமையும் இனிமையுமான எல்லாவிதப் பொருள்களும் நிறைந்திருக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஞானமுள்ளவன் பெலமுள்ளவன்;","poem":1},{"lineBreak":true},{"text":"அறிவுள்ளவன் தன்னுடைய வல்லமையை அதிகரிக்கச்செய்கிறான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நல்யோசனைசெய்து யுத்தம்செய்;","poem":1},{"lineBreak":true},{"text":"ஆலோசனைக்காரர்கள் அநேகரால் வெற்றி கிடைக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மூடனுக்கு ஞானம் எட்டாத உயரமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவன் நீதிமன்றத்தில் தன்னுடைய வாயைத் திறக்கமாட்டான்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தீவினைசெய்ய நினைக்கிறவன் மதிகெட்டவன் என்னப்படுவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தீயநோக்கம் பாவமாகும்; பரியாசக்காரன் மனிதர்களுக்கு அருவருப்பானவன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆபத்துக்காலத்தில் நீ சோர்ந்துபோனால்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய பெலன் குறுகினது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மரணத்திற்கு ஒப்புவிக்கப்பட்டவர்களையும், கொலைசெய்வதற்கு கொண்டுபோகிறவர்களையும்","poem":1},{"lineBreak":true},{"text":"விடுவிக்க முடிந்தால் விடுவி.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அதை நாங்கள் அறியோம் என்று சொன்னால்,","poem":1},{"lineBreak":true},{"text":"இருதயங்களைச் சோதிக்கிறவர் அறியமாட்டாரோ?","poem":1},{"lineBreak":true},{"text":"உன்னுடைய ஆத்துமாவைக் காக்கிறவர் கவனிக்கமாட்டாரோ?","poem":1},{"lineBreak":true},{"text":"அவர் மனிதர்களுக்கு அவனவன் செயல்களுக்கு தக்கதாகப் பலனளிக்கமாட்டாரோ?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"என் மகனே, தேனைச் சாப்பிடு, அது நல்லது;","poem":1},{"lineBreak":true},{"text":"கூட்டிலிருந்து ஒழுகும் தேன் உன் வாய்க்கு இன்பமாக இருக்கும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அப்படியே ஞானத்தை அறிந்துகொள்வது உன்னுடைய ஆத்துமாவுக்கு இன்பமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அதைப் பெற்றுக்கொண்டால், அது முடிவில் உதவும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய நம்பிக்கை வீண்போகாது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனே, நீ நீதிமானுடைய வீட்டிற்கு விரோதமாக மறைந்திருக்காதே;","poem":1},{"lineBreak":true},{"text":"அவன் தங்கும் இடத்தைப் பாழாக்கிப்போடாதே.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நீதிமான் ஏழுமுறை விழுந்தாலும் திரும்பவும் எழுந்திருப்பான்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களோ தீங்கிலே இடறுண்டு கிடப்பார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உன் எதிரி விழும்போது சந்தோஷப்படாதே;","poem":1},{"lineBreak":true},{"text":"அவன் இடறும்போது உன்னுடைய இருதயம் சந்தோஷப்படாமல் இருப்பதாக.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"யெகோவா அதைக் காண்பார், அது அவருடைய பார்வைக்கு தீங்காக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது அவனிடத்திலிருந்து அவர் தமது கோபத்தை நீக்கிவிடுவார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பொல்லாதவர்களைக்குறித்து எரிச்சலாகாதே;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்மேல் பொறாமை கொள்ளாதே.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுக்கு நல்ல முடிவு இல்லை;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய விளக்கு அணைந்துபோகும்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"என் மகனே, நீ யெகோவாவுக்கும் ராஜாவுக்கும் பயந்து நட,","poem":1},{"lineBreak":true},{"text":"கலகக்காரர்களோடு சேராதே.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"திடீரென அவர்களுடைய ஆபத்து எழும்பும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் இருவரின் அழிவையும் அறிந்தவன் யார்?","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"பின்னும் ஞானமுள்ளவர்களின் புத்திமதிகள் என்னவெனில்:","poem":1},{"lineBreak":true},{"text":"நியாயத்திலே பாரபட்சம் நல்லதல்ல.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனைப் பார்த்து:","poem":1},{"lineBreak":true},{"text":"நீதிமானாக இருக்கிறாய் என்று சொல்லுகிறவனை மக்கள் சபிப்பார்கள்,","poem":1},{"lineBreak":true},{"text":"குடிமக்கள் அவனை வெறுப்பார்கள்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவனைக் கடிந்துகொள்ளுகிறவர்கள்மேல் பிரியம் உண்டாகும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு உத்தம ஆசீர்வாதம் கிடைக்கும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"செம்மையான மறுமொழி சொல்லுகிறவன்","poem":1},{"lineBreak":true},{"text":"உதடுகளை முத்தமிடுகிறவனுக்குச் சமம்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"வெளியில் உன்னுடைய வேலையைத் தயாராக்கி,","poem":1},{"lineBreak":true},{"text":"வயலில் அதை ஒழுங்காக்கி,","poem":1},{"lineBreak":true},{"text":"பின்பு உன்னுடைய வீட்டைக் கட்டு.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"நியாயமில்லாமல் பிறனுக்கு விரோதமாகச் சாட்சியாக ஏற்படாதே;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய உதடுகளினால் வஞ்சகம் பேசாதே.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அவன் எனக்குச் செய்தபடி நானும் அவனுக்குச் செய்வேன்,","poem":1},{"lineBreak":true},{"text":"அவன் செய்த செயல்களுக்குத் தகுந்தபடி நானும் அவனுக்குச் சரிக்கட்டுவேன் என்று நீ சொல்லாதே.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"சோம்பேறியின் வயலையும், மதியீனனுடைய திராட்சைத்தோட்டத்தையும் கடந்துபோனேன்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"இதோ, அதெல்லாம் முள்ளுக்காடாக இருந்தது;","poem":1},{"lineBreak":true},{"text":"நிலத்தின் முகத்தை முட்கள் மூடினது,","poem":1},{"lineBreak":true},{"text":"அதின் கற்சுவர் இடிந்துகிடந்தது.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"அதைக் கண்டு சிந்தனை செய்தேன்;","poem":1},{"lineBreak":true},{"text":"அதை நோக்கிப் புத்தியடைந்தேன்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"இன்னும் கொஞ்சம் உறங்கட்டும்,","poem":1},{"lineBreak":true},{"text":"இன்னும் கொஞ்சம் கைமுடக்கிக்கொண்டு தூங்கட்டும் என்பாயோ?","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"உன் தரித்திரம் வழிப்போக்கனைப்போலவும்","poem":1},{"lineBreak":true},{"text":"உன் வறுமை ஆயுதம் அணிந்தவனைப்போலவும் வரும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}