{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"heading","content":["மேலும் சாலொமோனின் நீதிமொழிகள்"]},{"type":"verse","number":1,"content":[{"text":"யூதாவின் ராஜாவாகிய எசேக்கியாவின் மனிதர்கள்","poem":1},{"lineBreak":true},{"text":"பெயர்த்து எழுதின சாலொமோனுடைய நீதிமொழிகள்:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"காரியத்தை மறைப்பது தேவனுக்கு மேன்மை;","poem":1},{"lineBreak":true},{"text":"காரியத்தை ஆராய்வதோ ராஜாக்களுக்கு மேன்மை.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"வானத்தின் உயரமும், பூமியின் ஆழமும்,","poem":1},{"lineBreak":true},{"text":"ராஜாக்களின் இருதயங்களும் ஆராய்ந்துமுடியாது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"வெள்ளியிலிருந்து கழிவை நீக்கிவிடு,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது கொல்லனால் நல்ல பாத்திரம் வெளிப்படும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ராஜாவின் முன்னின்று துன்மார்க்கர்களை நீக்கிவிடு,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது அவனுடைய சிங்காசனம் நீதியினால் நிலைநிற்கும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ராஜாவின் சமுகத்தில் மேன்மைபாராட்டாதே;","poem":1},{"lineBreak":true},{"text":"பெரியோர்களுடைய இடத்தில் நிற்காதே.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உன் கண்கள் கண்ட பிரபுவின் சமுகத்தில் நீ தாழ்த்தப்படுவது நல்லதல்ல;","poem":1},{"lineBreak":true},{"text":"அவன் உன்னைப் பார்த்து:","poem":1},{"lineBreak":true},{"text":"மேலே வா என்று சொல்வதே உனக்கு மேன்மை.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"வழக்காடப் வேகமாகமாகப் போகாதே;","poem":1},{"lineBreak":true},{"text":"முடிவிலே உன்னுடைய அயலான் உன்னை வெட்கப்படுத்தும்போது,","poem":1},{"lineBreak":true},{"text":"நீ என்ன செய்யலாம் என்று திகைப்பாயே.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நீ உன்னுடைய அயலானுடனேமட்டும் உன்னுடைய வழக்கைக்குறித்து வழக்காடு,","poem":1},{"lineBreak":true},{"text":"மற்றவனிடத்தில் இரகசியத்தை வெளிப்படுத்தாதே.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"மற்றப்படி அதைக் கேட்கிறவன்","poem":1},{"lineBreak":true},{"text":"உன்னை நிந்திப்பான்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய அவமானம் உன்னைவிட்டு நீங்காது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ஏற்ற நேரத்தில் சொன்ன வார்த்தை","poem":1},{"lineBreak":true},{"text":"வெள்ளித்தட்டில் வைக்கப்பட்ட பொற்பழங்களுக்குச் சமம்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"கேட்கிற காதுக்கு, ஞானமாகக் கடிந்துகொண்டு புத்திசொல்லுகிறவன்,","poem":1},{"lineBreak":true},{"text":"பொற்கடுக்கனுக்கும் தங்க மோதிரத்திற்கும் சமம்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அறுவடைக்காலத்தில் உறைந்தமழையின் குளிர்ச்சி எப்படியிருக்கிறதோ,","poem":1},{"lineBreak":true},{"text":"அப்படியே உண்மையான தூதுவனும் தன்னை அனுப்பினவனுக்கு இருப்பான்;","poem":1},{"lineBreak":true},{"text":"அவன் தன்னுடைய எஜமான்களுடைய ஆத்துமாவைக் குளிரச்செய்வான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"கொடுப்பேன் என்று சொல்லியும் கொடுக்காமல் இருக்கிற வஞ்சகன்","poem":1},{"lineBreak":true},{"text":"மழையில்லாத மேகங்களுக்கும் காற்றுக்கும் சமம்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நீண்ட பொறுமையினால்","poem":1},{"lineBreak":true},{"text":"பிரபுவையும் சம்மதிக்கச்செய்யலாம்;","poem":1},{"lineBreak":true},{"text":"இனிய நாவு எலும்பையும் நொறுக்கும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தேனைக் கண்டுபிடித்தால் அளவாகச் சாப்பிடு;","poem":1},{"lineBreak":true},{"text":"அதிகமாக சாப்பிட்டால் வாந்திபண்ணுவாய்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உன்னுடைய அயலான் சலித்து உன்னை வெறுக்காதபடி,","poem":1},{"lineBreak":true},{"text":"அடிக்கடி அவனுடைய வீட்டில் கால்வைக்காதே.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பிறனுக்கு விரோதமாகப் பொய்சாட்சி சொல்லுகிற மனிதன்","poem":1},{"lineBreak":true},{"text":"தண்டாயுதத்திற்கும் வாளிற்கும் கூர்மையான அம்பிற்கும் ஒப்பானவன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ஆபத்துக்காலத்தில் துரோகியை நம்புவது","poem":1},{"lineBreak":true},{"text":"உடைந்த பல்லுக்கும் மூட்டு விலகிய காலுக்கும் சமம்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"மனதுக்கமுள்ளவனுக்குப் பாடல்களைப் பாடுகிறவன்,","poem":1},{"lineBreak":true},{"text":"குளிர்காலத்தில் ஆடையை களைகிறவனைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"வெடியுப்பின்","poem":1},{"noteId":0},{"text":"மேல் ஊற்றிய காடியைப்போலவும் இருப்பான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"உன்னுடைய எதிரிகள் பசியாக இருந்தால்,","poem":1},{"lineBreak":true},{"text":"அவனுக்கு சாப்பிட உணவு கொடு;","poem":1},{"lineBreak":true},{"text":"அவன் தாகமாக இருந்தால், குடிக்கத் தண்ணீர் கொடு.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அதினால் அவனை வெட்கப்படுத்துவாய்;","poem":1},{"noteId":1},{"lineBreak":true},{"text":"யெகோவா உனக்குப் பலனளிப்பார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"வடகாற்று மழையையும்,","poem":1},{"lineBreak":true},{"text":"புறங்கூறுகிற நாவு கோபமுகத்தையும் பிறப்பிக்கும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"சண்டைக்காரியோடு ஒரு பெரிய வீட்டில் குடியிருப்பதைவிட,","poem":1},{"lineBreak":true},{"text":"வீட்டின்மேல் ஒரு மூலையில் தங்குவதே நலம்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"தூரதேசத்திலிருந்து வரும் நற்செய்தி","poem":1},{"lineBreak":true},{"text":"தாகம் மிகுந்த ஆத்துமாவுக்குக் கிடைக்கும் குளிர்ந்த தண்ணீருக்குச் சமம்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுக்கு முன்பாக","poem":1},{"lineBreak":true},{"text":"நீதிமான் தள்ளாடுவது கலங்கின கிணற்றுக்கும் கெட்டுப்போன நீரூற்றுக்கும் ஒப்பாகும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"தேனை அதிகமாக சாப்பிடுவது நல்லதல்ல,","poem":1},{"lineBreak":true},{"text":"தற்புகழை நாடுவதும் புகழல்ல.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"தன்னுடைய ஆவியை அடக்காத மனிதன்","poem":1},{"lineBreak":true},{"text":"மதில் இடிந்த பாழான பட்டணம்போல இருக்கிறான்.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"காயத்தின் மேல் உப்பு. காரத்தை/ வலியை அதிகமாக்கும்","reference":{"chapter":25,"verse":20}},{"noteId":1,"caller":"+","text":"நீ அவனுடைய தலையின்மேல் எரிகிற தழல்களைக் குவிப்பாய்","reference":{"chapter":25,"verse":22}}]},"thisChapterLink":"/api/tam_irv/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}