{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"heading","content":["மதியீனன்"]},{"type":"verse","number":1,"content":[{"text":"கோடைக்காலத்திலே உறைந்த பனியும்,","poem":1},{"lineBreak":true},{"text":"அறுப்புக்காலத்திலே மழையும் தகாததுபோல,","poem":1},{"lineBreak":true},{"text":"மூடனுக்கு மகிமை தகாது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அடைக்கலான் குருவி அலைந்துபோவதுபோலவும்,","poem":1},{"lineBreak":true},{"text":"தகைவிலான் குருவி பறந்து போவதுபோலவும்,","poem":1},{"lineBreak":true},{"text":"காரணம் இல்லாமல் சொன்னசாபம் தங்காது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"குதிரைக்குச் சவுக்கும், கழுதைக்குக் கடிவாளமும்,","poem":1},{"lineBreak":true},{"text":"மூடனுடைய முதுகுக்குப் பிரம்பும் ஏற்றது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மூடனுக்கு அவனுடைய மதியீனத்தின்படி மறுஉத்திரவு கொடுக்காதே;","poem":1},{"lineBreak":true},{"text":"கொடுத்தால் நீயும் அவனைப்போல ஆவாய்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மூடனுக்கு அவனுடைய மதியீனத்தின்படி மறுஉத்திரவு கொடு;","poem":1},{"lineBreak":true},{"text":"கொடுக்காவிட்டால் அவன் தன்னுடைய பார்வைக்கு ஞானியாக இருப்பான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மூடன் கையிலே செய்தி அனுப்புகிறவன்","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கால்களையே வெட்டிக்கொண்டு நஷ்டத்தை அடைகிறான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நொண்டியின் கால்கள் குந்திக்குந்தி நடக்கும்,","poem":1},{"lineBreak":true},{"text":"அப்படியே மூடர்களின் வாயிலுள்ள உவமைச்சொல்லும் குந்தும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மூடனுக்கு மரியாதை கொடுக்கிறவன் கவணிலே கல்லைக்கட்டுகிறவன்போல் இருப்பான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மூடன் வாயில் அகப்பட்ட பழமொழி","poem":1},{"lineBreak":true},{"text":"வெறியன் கையில் அகப்பட்ட முள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"பலத்தவன் அனைவரையும் நோகச்செய்து,","poem":1},{"lineBreak":true},{"text":"மூடனையும் வேலைவாங்குகிறான்,","poem":1},{"lineBreak":true},{"text":"மீறி நடக்கிறவர்களையும் வேலைவாங்குகிறான்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நாயானது தான் கக்கினதை சாப்பிடும்படித் திரும்புவதுபோல,","poem":1},{"lineBreak":true},{"text":"மூடனும் தன்னுடைய மூடத்தனத்திற்குத் திரும்புகிறான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தன்னுடைய பார்வைக்கு ஞானியாக இருப்பவனைக் கண்டால்,","poem":1},{"lineBreak":true},{"text":"அவனைவிட மூடனைக்குறித்து அதிக நம்பிக்கையாக இருக்கலாம்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"வழியிலே சிங்கம் இருக்கும், நடுவீதியிலே சிங்கம் இருக்கும் என்று சோம்பேறி சொல்லுவான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"கதவு கீல்முளையில் ஆடுகிறதுபோல,","poem":1},{"lineBreak":true},{"text":"சோம்பேறியும் படுக்கையில் ஆடிக்கொண்டிருக்கிறான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"சோம்பேறி தன்னுடைய கையைக் கலத்திலே வைத்து","poem":1},{"lineBreak":true},{"text":"அதைத் தன்னுடைய வாய்க்குத் திரும்ப எடுக்க வருத்தப்படுகிறான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"புத்தியுள்ள மறுஉத்திரவு சொல்லத்தகும் ஏழுபேரைவிட","poem":1},{"lineBreak":true},{"text":"சோம்பேறி தன் பார்வைக்கு அதிக ஞானமுள்ளவன்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"வழியிலே போகும்போது தனக்கு சம்மந்தமில்லாத வழக்கில் தலையிடுகிறவன்","poem":1},{"lineBreak":true},{"text":"நாயைக் காதைப் பிடித்து இழுக்கிறவனைப்போல இருக்கிறான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"கொள்ளிகளையும் அம்புகளையும் சாவுக்கேதுவானவைகளையும் எறிகிற பைத்தியக்காரன் எப்படியிருக்கிறானோ,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அப்படியே, தன்னோடு இருந்தவனை வஞ்சித்து:","poem":1},{"lineBreak":true},{"text":"நான் விளையாட்டுக்கல்லவோ செய்தேன்","poem":1},{"lineBreak":true},{"text":"என்று சொல்லுகிற மனிதனும் இருக்கிறான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"விறகில்லாமல் நெருப்பு அணையும்;","poem":1},{"lineBreak":true},{"text":"கோள்சொல்லுகிறவன் இல்லாமல் சண்டை அடங்கும்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"கரிகள் தழலுக்கும், விறகு நெருப்புக்கும் ஏதுவானதுபோல,","poem":1},{"lineBreak":true},{"text":"கோபக்காரன் சண்டைகளை மூட்டுகிறதற்கு ஏதுவானவன்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"கோள்காரனுடைய வார்த்தைகள் விளையாட்டுப்போல இருக்கும்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் அவைகள் உள்ளத்திற்குள் குத்தும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"நேச அனலைக் காண்பிக்கிற உதடுகளோடு கூடிய தீயநெஞ்சம்","poem":1},{"lineBreak":true},{"text":"வெள்ளிப்பூச்சு பூசிய ஓட்டைப்போல இருக்கும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"பகைஞன் தன்னுடைய உள்ளத்தில் கபடத்தை மறைத்து,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உதடுகளினால் சூதுபேசுகிறான்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவன் தாழ்மையாக பேசினாலும் அவனை நம்பாதே;","poem":1},{"lineBreak":true},{"text":"அவனுடைய இருதயத்தில் ஏழு அருவருப்புகள் உண்டு.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"பகையை வஞ்சகமாக மறைத்து வைக்கிறவன் எவனோ,","poem":1},{"lineBreak":true},{"text":"அவனுடைய பொல்லாங்கு மகா சபையிலே வெளிப்படுத்தப்படும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"படுகுழியை வெட்டுகிறவன் தானே அதில் விழுவான்;","poem":1},{"lineBreak":true},{"text":"கல்லைப் புரட்டுகிறவன்மேல் அந்தக் கல் திரும்ப விழும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"பொய்நாவு தன்னால் பாதிக்கப்பட்டவர்களைப் பகைக்கும்;","poem":1},{"lineBreak":true},{"text":"முகஸ்துதி பேசும் வாய் அழிவை உண்டாக்கும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}