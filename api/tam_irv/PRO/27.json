{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"heading","content":["குடும்ப வாழ்வு"]},{"type":"verse","number":1,"content":[{"text":"நாளையத்தினத்தைக்குறித்துப் பெருமைபேசாதே;","poem":1},{"lineBreak":true},{"text":"ஒரு நாள் பிறப்பிப்பதை அறியமாட்டாயே.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உன்னுடைய வாய் அல்ல, மற்றவனே உன்னைப் புகழட்டும்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய உதடு அல்ல, அந்நியனே உன்னைப் புகழட்டும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"கல் கனமும், மணல் பாரமுமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"மூடனுடைய கோபமோ இந்த இரண்டைவிட பாரமாம்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"கடுங்கோபம் கொடுமையுள்ளது, கோபம் பயங்கரமானது;","poem":1},{"lineBreak":true},{"text":"பொறாமையோவென்றால், அதற்கு முன்னே நிற்கக்கூடியவன் யார்?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மறைவான நேசத்தைவிட வெளிப்படையான கடிந்துகொள்ளுதல் நல்லது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நண்பன் அடிக்கும் அடிகள் உண்மையானவைகள்;","poem":1},{"lineBreak":true},{"text":"சத்துரு இடும் முத்தங்களோ வஞ்சனையுள்ளவைகள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"திருப்தியடைந்தவன் தேன்கூட்டையும் மிதிப்பான்;","poem":1},{"lineBreak":true},{"text":"பசியுள்ளவனுக்கோ கசப்பான ஆகாரங்களும் தித்திப்பாக இருக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தன்னுடைய கூட்டைவிட்டு அலைகிற குருவி எப்படியிருக்கிறதோ,","poem":1},{"lineBreak":true},{"text":"அப்படியே தன்னுடைய இடத்தைவிட்டு அலைகிற மனிதனும் இருக்கிறான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வாசனைத் தைலமும் சுகந்ததூபமும் இருதயத்தைக் களிப்பாக்குவதுபோல,","poem":1},{"lineBreak":true},{"text":"ஒருவனுடைய நண்பன் உட்கருத்தான ஆலோசனையினால் பாராட்டும் இன்பமானது களிப்பாக்கும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உன்னுடைய நண்பனையும், உன்னுடைய தகப்பனுடைய நண்பனையும் விட்டுவிடாதே;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய ஆபத்துக்காலத்தில் உன்னுடைய சகோதரனுடைய வீட்டிற்குப் போகாதே;","poem":1},{"lineBreak":true},{"text":"தூரத்திலுள்ள சகோதரனைவிட சமீபத்திலுள்ள அயலானே சிறப்பானவன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என் மகனே, என்னை சபிக்கிறவனுக்கு நான் உத்திரவு கொடுக்கும்படியாக,","poem":1},{"lineBreak":true},{"text":"நீ ஞானவானாகி, என்னுடைய இருதயத்தைச் சந்தோஷப்படுத்து.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"விவேகி ஆபத்தைக் கண்டு மறைந்துகொள்ளுகிறான்;","poem":1},{"lineBreak":true},{"text":"பேதைகளோ நேராகப்போய் தண்டிக்கப்படுகிறார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அந்நியனுக்காகப் பிணைப்படுகிறவனுடைய ஆடையை எடுத்துக்கொள்,","poem":1},{"lineBreak":true},{"text":"அந்நிய பெண்ணுக்காக ஈடுவாங்கிக்கொள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஒருவன் அதிகாலையிலே எழுந்து உரத்த சத்தத்தோடு","poem":1},{"lineBreak":true},{"text":"தன்னுடைய நண்பனுக்குச் சொல்லும் ஆசீர்வாதம் சாபமாக எண்ணப்படும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அடைமழைநாளில் ஓயாத ஒழுக்கும்","poem":1},{"lineBreak":true},{"text":"சண்டைக்காரியான பெண்ணும் சரி.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவளை அடக்கப்பார்க்கிறவன்","poem":1},{"lineBreak":true},{"text":"காற்றை அடக்கித் தன்னுடைய வலதுகையினால் எண்ணெயைப் பிடிக்கப்பார்க்கிறான்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"இரும்பை இரும்பு கூர்மையாக்கிடும்;","poem":1},{"lineBreak":true},{"text":"அப்படியே மனிதனும் தன்னுடைய நண்பனைக் கூர்மையாக்குகிறான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அத்திமரத்தைக் காக்கிறவன் அதின் கனியை சாப்பிடுவான்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய எஜமானைக் காக்கிறவன் கனமடைவான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தண்ணீரில் முகத்திற்கு முகம் ஒத்திருப்பதைப்போல,","poem":1},{"lineBreak":true},{"text":"மனிதர்களில் இருதயத்திற்கு இருதயம் ஒத்திருக்கும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"பாதாளமும் அழிவும் திருப்தியாகிறதில்லை;","poem":1},{"lineBreak":true},{"text":"அதுபோல மனிதனுடைய ஆசைகளும் திருப்தியாகிறதில்லை.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"வெள்ளிக்குக் குகையும், பொன்னுக்குப் புடமும் சோதனை;","poem":1},{"lineBreak":true},{"text":"மனிதனுக்கு அவனுக்கு உண்டாகும் புகழ்ச்சியே சோதனை.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"மூடனை உரலில் போட்டு உலக்கையினால் நொய்யோடு நொய்யாகக் குத்தினாலும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய மூடத்தனம் அவனை விட்டு நீங்காது.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"உன்னுடைய ஆடுகளின் நிலைமையை நன்றாக அறிந்துகொள்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய மந்தைகளின்மேல் கவனமாக இரு.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"செல்வம் என்றைக்கும் நிலைக்காது;","poem":1},{"lineBreak":true},{"text":"கிரீடம் தலைமுறை தலைமுறைதோறும் நிலைநிற்குமோ?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"புல் முளைக்கும், பச்சிலைகள் தோன்றும்,","poem":1},{"lineBreak":true},{"text":"மலைப்பூண்டுகள் சேர்க்கப்படும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ஆட்டுக்குட்டிகள் உனக்கு ஆடையையும்,","poem":1},{"lineBreak":true},{"text":"கடாக்கள் வயல் வாங்கத்தக்க கிரயத்தையும் கொடுக்கும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"வெள்ளாட்டுப்பால் உன்னுடைய உணவுக்கும்,","poem":1},{"lineBreak":true},{"text":"உன் வீட்டாரின் உணவுக்கும்","poem":1},{"lineBreak":true},{"text":"உன் வேலைக்காரிகளின் பிழைப்புக்கும் போதுமானதாக இருக்கும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}