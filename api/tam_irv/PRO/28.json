{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"heading","content":["நீதிமான்களின் வாழ்க்கை"]},{"type":"verse","number":1,"content":[{"text":"ஒருவனும் பின்தொடராமல் இருந்தும் துன்மார்க்கர்கள் ஓடிப்போகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களோ சிங்கத்தைப்போல தைரியமாக இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தேசத்தின் பாவத்தினால் அதின் அதிகாரிகள் அநேகராக இருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"புத்தியும் அறிவுமுள்ள மனிதனாலோ அதின் நற்சீர் நீடித்திருக்கும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ஏழைகளை ஒடுக்குகிற தரித்திரன்","poem":1},{"lineBreak":true},{"text":"உணவு விளையாதபடி வெள்ளமாக அடித்துக்கொண்டுபோகிற மழையைப்போல இருக்கிறான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"வேதப்பிரமாணத்தைவிட்டு விலகுகிறவர்கள்","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களைப் புகழுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"வேதப்பிரமாணத்தைக் கைக்கொள்ளுகிறவர்களோ அவர்களோடு போராடுகிறார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் நியாயத்தை அறியார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை தேடுகிறவர்களோ அனைத்தையும் அறிவார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இருவழிகளில் நடக்கிறவன் செல்வந்தனாக இருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"நேர்மையாக நடக்கிற தரித்திரன் அவனைவிட சிறப்பானவன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"வேதப்பிரமாணத்தைக் கைக்கொள்ளுகிறவன் விவேகமுள்ள மகன்;","poem":1},{"lineBreak":true},{"text":"உணவுப்பிரியர்களுக்குத் தோழனாக இருக்கிறவனோ","poem":1},{"lineBreak":true},{"text":"தன்னுடைய தகப்பனை அவமானப்படுத்துகிறான்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அநியாய வட்டியினாலும் ஆதாயத்தினாலும் தன்னுடைய சொத்தைப் பெருகச்செய்கிறவன்,","poem":1},{"lineBreak":true},{"text":"தரித்திரர்கள்மேல் இரங்குகிறவனுக்காக அதைச் சேகரிக்கிறான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வேதத்தைக் கேட்காதபடி தன்னுடைய செவியை விலக்குகிறவனுடைய","poem":1},{"lineBreak":true},{"text":"ஜெபமும் அருவருப்பானது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உத்தமர்களை மோசப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"பொல்லாத வழியிலே நடத்துகிறவன் தான் வெட்டின குழியில் தானே விழுவான்;","poem":1},{"lineBreak":true},{"text":"உத்தமர்களோ நன்மையைச் சுதந்தரிப்பார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"செல்வந்தன் தன்னுடைய பார்வைக்கு ஞானவான்;","poem":1},{"lineBreak":true},{"text":"புத்தியுள்ள தரித்திரனோ அவனைப் பரிசோதிக்கிறான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீதிமான்கள் களிகூரும்போது மகா கொண்டாட்டம் உண்டாகும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் எழும்பும்போதோ மனிதர்கள் மறைந்துகொள்கிறார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தன்னுடைய பாவங்களை மறைக்கிறவன் வாழ்வடையமாட்டான்;","poem":1},{"lineBreak":true},{"text":"அவைகளை அறிக்கை செய்து விட்டுவிடுகிறவனோ இரக்கம்பெறுவான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"எப்பொழுதும் பயந்திருக்கிறவன் பாக்கியவான்;","poem":1},{"lineBreak":true},{"text":"தன் இருதயத்தைக் கடினப்படுத்துகிறவனோ தீங்கில் விழுவான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஏழை மக்களை ஆளும் துன்மார்க்க அதிகாரி","poem":1},{"lineBreak":true},{"text":"கெர்ச்சிக்கும் சிங்கத்திற்கும் அலைந்து திரிகிற கரடிக்கும் ஒப்பாக இருக்கிறான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தலைவன் புத்தியீனனாக இருந்தால் அவன் செய்யும் இடுக்கண் மிகுதி;","poem":1},{"lineBreak":true},{"text":"பொருளாசையை வெறுக்கிறவன் தீர்க்காயுசைப் பெறுவான்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"இரத்தப்பழிக்காக ஒடுக்கப்பட்டவன் குழியில் ஒளிய ஓடிவந்தால்,","poem":1},{"lineBreak":true},{"text":"அவனை ஆதரிக்கவேண்டாம்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"உத்தமனாக நடக்கிறவன் இரட்சிக்கப்படுவான்;","poem":1},{"lineBreak":true},{"text":"மாறுபாடான இருவழியில் நடக்கிறவனோ அவற்றில் ஒன்றிலே விழுவான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தன்னுடைய நிலத்தைப் பயிரிடுகிறவன் உணவால் திருப்தியாவான்;","poem":1},{"lineBreak":true},{"text":"வீணர்களைப் பின்பற்றுகிறவனோ வறுமையால் நிறைந்திருப்பான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"உண்மையுள்ள மனிதன் பரிபூரண ஆசீர்வாதங்களைப் பெறுவான்;","poem":1},{"lineBreak":true},{"text":"செல்வந்தனாகிறதற்கு அவசரப்படுகிறவனோ ஆக்கினைக்குத் தப்பமாட்டான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"பாரபட்சம் நல்லதல்ல,","poem":1},{"lineBreak":true},{"text":"பாரபட்சமுள்ளவன் ஒரு துண்டு அப்பத்திற்காக அநியாயம் செய்வான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"பொறாமைக்காரன் செல்வனாகிறதற்குப் பதறுகிறான்,","poem":1},{"lineBreak":true},{"text":"வறுமை தனக்கு வருமென்று அறியாமல் இருக்கிறான்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தன்னுடைய நாவினால் முகஸ்துதி பேசுகிறவனைவிட,","poem":1},{"lineBreak":true},{"text":"கடிந்துகொள்ளுகிறவன் முடிவில் அங்கீகாரம் பெறுவான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"தன்னுடைய தகப்பனையும் தன்னுடைய தாயையும் கொள்ளையிட்டு,","poem":1},{"lineBreak":true},{"text":"அது துரோகமல்ல என்பவன் பாழாக்குகிற மனிதனுக்குத் தோழன்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"பெருநெஞ்சன் வழக்கை உண்டாக்குகிறான்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நம்புகிறவனோ செழிப்பான்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தன்னுடைய இருதயத்தை நம்புகிறவன் மூடன்;","poem":1},{"lineBreak":true},{"text":"ஞானமாக நடக்கிறவனோ இரட்சிக்கப்படுவான்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"தரித்திரர்களுக்குக் கொடுப்பவன் தாழ்ச்சியடையமாட்டான்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கண்களை ஏழைகளுக்கு விலக்குகிறவனுக்கோ அநேக சாபங்கள் வரும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் எழும்பும்போது மனிதர்கள் மறைந்துகொள்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் அழியும்போதோ நீதிமான்கள் பெருகுகிறார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}