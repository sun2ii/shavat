{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"heading","content":["ஞானத்தின் போதனை"]},{"type":"verse","number":1,"content":[{"text":"அடிக்கடி கடிந்துகொள்ளப்பட்டும் தன்னுடைய பிடரியைக் கடினப்படுத்துகிறவன்","poem":1},{"lineBreak":true},{"text":"உதவியின்றி திடீரென்று நாசமடைவான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நீதிமான்கள் பெருகினால் மக்கள் மகிழுவார்கள்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் ஆளும்போதோ மக்கள் தவிப்பார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ஞானத்தில் பிரியப்படுகிறவன் தன்னுடைய தகப்பனை","poem":1},{"lineBreak":true},{"text":"சந்தோஷப்படுத்துகிறான்; வேசிகளோடு தொடர்புள்ளவனோ சொத்தை அழிக்கிறான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நியாயத்தினால் ராஜா தேசத்தை நிலைநிறுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"லஞ்சப்பிரியனோ அதைக் தலைகீழாக்குகிறான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பிறனை முகஸ்துதி செய்கிறவன்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய கால்களுக்கு வலையை விரிக்கிறான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுடைய துரோகத்திலே கண்ணி இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"நீதிமானோ பாடி மகிழுகிறான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீதிமான் ஏழைகளின் நியாயத்தைக் கவனித்து அறிகிறான்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனோ அதை அறிய விரும்பமாட்டான்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பரியாசக்காரர்கள் பட்டணத்தில் தீக்கொளுத்திவிடுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"ஞானிகளோ கோபத்தை விலக்குகிறார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஞானி மூடனுடன் வழக்காடும்போது,","poem":1},{"lineBreak":true},{"text":"கோபப்பட்டாலும் சிரித்தாலும் அமைதியில்லை.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இரத்தப்பிரியர்கள் உத்தமனைப் பகைக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"செம்மையானவர்களோ அவனுடைய உயிரைக் காப்பாற்றுகிறார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மூடன் தன்னுடைய உள்ளத்தையெல்லாம் வெளிப்படுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"ஞானியோ அதைப் பின்னுக்கு அடக்கிவைக்கிறான்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அதிபதியானவன் பொய்களுக்குச் செவிகொடுத்தால்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய அலுவலர்கள் எல்லோரும் துன்மார்க்கர்களாவார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தரித்திரனும் கொடுமைக்காரனும் ஒருவரையொருவர் சந்திக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அந்த இருவருடைய கண்களுக்கும் யெகோவா வெளிச்சம் கொடுக்கிறார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஏழைகளுடைய நியாயத்தை உண்மையாக விசாரிக்கிற ராஜாவின் சிங்காசனம்","poem":1},{"lineBreak":true},{"text":"என்றும் நிலைபெற்றிருக்கும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"பிரம்பும் கடிந்துகொள்ளுதலும் ஞானத்தைக் கொடுக்கும்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய இஷ்டத்திற்கு விடப்பட்ட பிள்ளையோ","poem":1},{"lineBreak":true},{"text":"தன்னுடைய தாய்க்கு வெட்கத்தை உண்டாக்குகிறான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் பெருகினால் பாவமும் பெருகும்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களோ அவர்கள் விழுவதைக் காண்பார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உன்னுடைய மகனை தண்டி, அவன் உனக்கு ஆறுதல் செய்வான்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய ஆத்துமாவிற்கு ஆனந்தத்தையும் உண்டாக்குவான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"தீர்க்கதரிசனமில்லாத இடத்தில் மக்கள் சீர்கெட்டுப்போவார்கள்;","poem":1},{"lineBreak":true},{"text":"வேதத்தைக் காக்கிறவனோ பாக்கியவான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அடிமையானவன் வார்த்தைகளினாலே அடங்கமாட்டான்;","poem":1},{"lineBreak":true},{"text":"அவைகளை அவன் அறிந்தாலும் உத்திரவு கொடுக்கமாட்டான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தன்னுடைய வார்த்தைகளில் பதறுகிற மனிதனைக் கண்டால்,","poem":1},{"lineBreak":true},{"text":"அவனை நம்புவதைவிட மூடனை நம்பலாம்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ஒருவன் தன்னுடைய அடிமையைச் சிறு வயதுமுதல் அவனது இஷ்டப்படி வளர்த்தால்,","poem":1},{"lineBreak":true},{"text":"முடிவிலே அவன் தன்னை மகனாக உரிமைபாராட்டுவான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"கோபக்காரன் வழக்கை உண்டாக்குகிறான்;","poem":1},{"lineBreak":true},{"text":"கடுங்கோபி பெரும்பாதகன்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"மனிதனுடைய அகந்தை அவனைத் தாழ்த்தும்;","poem":1},{"lineBreak":true},{"text":"மனத்தாழ்மையுள்ளவனோ மதிப்படைவான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"திருடனோடு பங்கிட்டுக்கொள்ளுகிறவன் தன்னுடைய ஆத்துமாவைப் பகைக்கிறான்;","poem":1},{"lineBreak":true},{"text":"சாபத்தை அவன் கேட்டாலும் காரியத்தை வெளிப்படுத்தமாட்டான்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"மனிதனுக்குப் பயப்படும் பயம் கண்ணியை வருவிக்கும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நம்புகிறவனோ","poem":1},{"lineBreak":true},{"text":"உயர்ந்த அடைக்கலத்திலே வைக்கப்படுவான்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ஆளுகை செய்கிறவனுடைய முகதரிசனத்தைத் தேடுகிறவர்கள் அநேகர்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் அவனவனுடைய நியாயம் யெகோவாவாலே தீரும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"நீதிமானுக்கு அநியாயக்காரன் அருவருப்பானவன்;","poem":1},{"lineBreak":true},{"text":"சன்மார்க்கனும் துன்மார்க்கனுக்கு அருவருப்பானவன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}