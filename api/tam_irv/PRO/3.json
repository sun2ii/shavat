{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["ஞானத்தினால் தொடர்ந்துவரும் பலன்கள்"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, என்னுடைய போதகத்தை மறவாதே;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய இருதயம் என்னுடைய கட்டளைகளைக் காக்கட்டும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவைகள் உனக்கு நீடித்த நாட்களையும்,","poem":1},{"lineBreak":true},{"text":"நீண்ட ஆயுளையும், சமாதானத்தையும் பெருகச்செய்யும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"கிருபையும் சத்தியமும் உன்னைவிட்டு விலகாமல் இருப்பதாக;","poem":1},{"lineBreak":true},{"text":"நீ அவைகளை உன்னுடைய கழுத்திலே கட்டி,","poem":1},{"lineBreak":true},{"text":"அவைகளை உன்னுடைய இருதயமாகிய பலகையில் எழுதிக்கொள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அதினால் தேவனுடைய பார்வையிலும் மனிதர்களுடைய பார்வையிலும் தயவையும் நற்புத்தியும் பெறுவாய்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உன்னுடைய சுயபுத்தியின்மேல் சாயாமல்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய முழு இருதயத்தோடும் கர்த்தரில் நம்பிக்கையாக இருந்து,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உன்னுடைய வழிகளிலெல்லாம் அவரை நினைத்துக்கொள்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது அவர் உன்னுடைய பாதைகளைச் செவ்வைப்படுத்துவார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீ உன்னை ஞானியென்று எண்ணாதே;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயந்து,","poem":1},{"lineBreak":true},{"text":"தீமையை விட்டு விலகு.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அது உன்னுடைய சரீரத்திற்கு ஆரோக்கியமும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய எலும்புகளுக்கு ஊனுமாகும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உன்னுடைய பொருளாலும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய எல்லா விளைச்சலின் முதற்பலனாலும் யெகோவாவுக்கு மரியாதை செலுத்து.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அப்பொழுது உன்னுடைய களஞ்சியங்கள் பூரணமாக நிரம்பும்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய ஆலைகளில் திராட்சைரசம் புரண்டோடும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என் மகனே, நீ யெகோவாவுடைய தண்டனையை அற்பமாக எண்ணாதே,","poem":1},{"lineBreak":true},{"text":"அவர் கடிந்துகொள்ளும்போது சோர்ந்துபோகாதே.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தகப்பன் தான் நேசிக்கிற மகனைத் தண்டிக்கிறதுபோல,","poem":1},{"lineBreak":true},{"text":"யெகோவாவும் எவனிடத்தில் அன்பாக இருக்கிறாரோ அவனை தண்டிக்கிறார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ஞானத்தைக் கண்டடைகிற மனிதனும்,","poem":1},{"lineBreak":true},{"text":"புத்தியைச் சம்பாதிக்கிற மனிதனும் பாக்கியவான்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அதின் வியாபாரம் வெள்ளி வியாபாரத்திலும்,","poem":1},{"lineBreak":true},{"text":"அதின் ஆதாயம் சுத்தப்பொன்னிலும் உத்தமமானது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"முத்துக்களைவிட அது விலையேறப்பெற்றது;","poem":1},{"lineBreak":true},{"text":"நீ ஆசைப்படுவது ஒன்றும் அதற்கு சமமல்ல.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அதின் வலதுகையில் நீடித்த ஆயுளும்,","poem":1},{"lineBreak":true},{"text":"அதின் இடதுகையில் செல்வமும் கனமும் இருக்கிறது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அதின் வழிகள் இனிதான வழிகள்,","poem":1},{"lineBreak":true},{"text":"அதின் பாதைகளெல்லாம் சமாதானம்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அது தன்னை அடைந்தவர்களுக்கு ஜீவமரம்,","poem":1},{"lineBreak":true},{"text":"அதைப் பற்றிக்கொள்ளுகிற எவனும் பாக்கியவான்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"யெகோவா ஞானத்தினாலே பூமியை அஸ்திபாரப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"புத்தியினாலே வானங்களை நிலைநிறுத்தினார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவருடைய ஞானத்தினாலே ஆழங்கள் பிரிந்தது,","poem":1},{"lineBreak":true},{"text":"ஆகாயமும் பனியைப் பெய்கிறது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"என் மகனே, இவைகள் உன்னுடைய கண்களைவிட்டுப் பிரியாமல் இருப்பதாக;","poem":1},{"lineBreak":true},{"text":"மெய்ஞானத்தையும் நல்ல ஆலோசனையையும் காத்துக்கொள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவைகள் உன்னுடைய ஆத்துமாவுக்கு உயிரும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய கழுத்துக்கு அலங்காரமுமாகவும் இருக்கும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அப்பொழுது நீ பயமின்றி உன்னுடைய வழியில் நடப்பாய்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய கால் இடறாது.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"நீ படுக்கும்போது பயப்படாமல் இருப்பாய்;","poem":1},{"lineBreak":true},{"text":"நீ படுத்துக்கொள்ளும்போது உன்னுடைய தூக்கம் இன்பமாக இருக்கும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"திடீரென வரும் திகிலும்,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களின் பேரழிவும் வரும்போது நீ பயப்படவேண்டாம்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"யெகோவா உன்னுடைய நம்பிக்கையாக இருந்து,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய கால் சிக்கிக்கொள்ளாதபடிக் காப்பார்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"நன்மைசெய்யும்படி உனக்குத் திராணியிருக்கும்போது, அதை செய்யக்கூடியவர்களுக்குச் செய்யாமல் இருக்காதே.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"உன்னிடத்தில் பொருள் இருக்கும்போது உன்னுடைய அயலானை நோக்கி:","poem":1},{"lineBreak":true},{"text":"நீ போய்த் திரும்பவா, நாளைக்குத் தருவேன் என்று சொல்லாதே.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"பயமின்றி உன்னிடத்தில் தங்குகிற","poem":1},{"lineBreak":true},{"text":"உன்னுடைய அயலானுக்கு விரோதமாகத் தீங்கு நினைக்காதே.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ஒருவன் உனக்குத் தீங்குசெய்யாமல் இருக்க,","poem":1},{"lineBreak":true},{"text":"காரணமின்றி அவனோடு வழக்காடாதே.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"கொடுமைக்காரன்மேல் பொறாமைகொள்ளாதே;","poem":1},{"lineBreak":true},{"text":"அவனுடைய வழிகளில் ஒன்றையும் தெரிந்துகொள்ளாதே.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"மாறுபாடுள்ளவன் யெகோவாவுக்கு அருவருப்பானவன்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களோடு அவருடைய இரகசியம் இருக்கிறது.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுடைய வீட்டில் யெகோவாவின் சாபம் இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"நீதிமான்களுடைய வீட்டையோ அவர் ஆசீர்வதிக்கிறார்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"இகழ்வோரை அவர் இகழுகிறார்;","poem":1},{"lineBreak":true},{"text":"தாழ்மையுள்ளவர்களுக்கோ கிருபையளிக்கிறார்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ஞானவான்கள் மரியாதையைப் பெற்றுக்கொள்வார்கள்;","poem":1},{"lineBreak":true},{"text":"மதிகேடரோ கனவீனத்தை அடைவார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}