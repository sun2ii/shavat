{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"heading","content":["ஆகூரின் நீதிமொழிகள்"]},{"type":"verse","number":1,"content":[{"text":"யாக்கேயின் மகனாகிய ஆகூர் என்னும் ஆண்மகன் ஈத்தியேலுக்கு வசனித்து,","poem":1},{"lineBreak":true},{"text":"ஈத்தியேலுக்கும் ஊகாலுக்கும் சொன்ன உபதேச வாக்கியங்கள்:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மனிதர்கள் எல்லோரையும்விட நான் மூடன்;","poem":1},{"lineBreak":true},{"text":"மனிதர்களுக்கேற்ற புத்தி எனக்கு இல்லை.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் ஞானத்தைக் கற்கவும் இல்லை,","poem":1},{"lineBreak":true},{"text":"பரிசுத்தரின் அறிவை அறிந்துகொள்ளவும் இல்லை.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"வானத்திற்கு ஏறி இறங்கினவர் யார்?","poem":1},{"lineBreak":true},{"text":"காற்றைத் தமது கைப்பிடிகளில் அடக்கினவர் யார்?","poem":1},{"lineBreak":true},{"text":"தண்ணீர்களை துணியிலே கட்டினவர் யார்?","poem":1},{"lineBreak":true},{"text":"பூமியின் எல்லைகளையெல்லாம் நிறுவியவர் யார்?","poem":1},{"lineBreak":true},{"text":"அவருடைய பெயர் என்ன?","poem":1},{"lineBreak":true},{"text":"அவருடைய மகனுடைய பெயர்","poem":1},{"lineBreak":true},{"text":"என்ன? அதை அறிவாயோ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவனுடைய வசனமெல்லாம் புடமிடப்பட்டவைகள்;","poem":1},{"lineBreak":true},{"text":"தம்மை அண்டிக்கொள்கிறவர்களுக்கு அவர் கேடகமானவர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவருடைய வசனங்களோடு ஒன்றையும் கூட்டாதே,","poem":1},{"lineBreak":true},{"text":"கூட்டினால் அவர் உன்னைக் கடிந்துகொள்வார்,","poem":1},{"lineBreak":true},{"text":"நீ பொய்யனாவாய்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இரண்டு மனு உம்மிடத்தில் கேட்கிறேன்;","poem":1},{"lineBreak":true},{"text":"நான் மரணமடையும்வரைக்கும் அவைகளை எனக்கு மறுக்காமல் தாரும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மாயையையும் பொய்வசனிப்பையும் எனக்குத் தூரப்படுத்தும்;","poem":1},{"lineBreak":true},{"text":"தரித்திரத்தையும் செல்வத்தையும் எனக்குக் கொடுக்காமல் இருப்பீராக.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நான் பரிபூரணம் அடைகிறதினால் மறுதலித்து, யெகோவா யார் என்று சொல்லாதபடிக்கும்;","poem":1},{"lineBreak":true},{"text":"தரித்திரமடைகிறதினால் திருடி, என்னுடைய தேவனுடைய நாமத்தை வீணாக கெடுக்காதபடிக்கும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய படியை எனக்கு அளந்து எனக்கு உணவளியும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எஜமானிடத்தில் அவனுடைய வேலைக்காரன்மேல் குற்றம் சுமத்தாதே;","poem":1},{"lineBreak":true},{"text":"அவன் உன்னைச் சபிப்பான்,","poem":1},{"lineBreak":true},{"text":"நீ குற்றவாளியாகக் காணப்படுவாய்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தங்களுடைய தகப்பனைச் சபித்தும்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய தாயை ஆசீர்வதிக்காமலும் இருக்கிற சந்ததியாரும் உண்டு.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தாங்கள் அழுக்கு நீங்க கழுவப்படாமல் இருந்தும்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய பார்வைக்குச் சுத்தமாகத் தோன்றுகிற சந்ததியாரும் உண்டு.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"வேறொரு சந்ததியாரும் உண்டு; அவர்களுடைய கண்கள் எத்தனை மேட்டிமையும் அவர்களுடைய இமைகள் எத்தனை பெருமையுமானவைகள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தேசத்தில் சிறுமையானவர்களையும் மனிதர்களில் எளிமையானவர்களையும்","poem":1},{"lineBreak":true},{"text":"சாப்பிடுவதற்கு வாளுக்கு ஒப்பான பற்களையும் கத்திகளுக்கு ஒப்பான கடைவாய்ப்பற்களையும் உடைய சந்ததியாரும் உண்டு.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"கொடு, கொடு, என்கிற இரண்டு மகள்கள் அட்டைக்கு உண்டு.","poem":1},{"lineBreak":true},{"text":"திருப்தி அடையாத மூன்று உண்டு, போதும் என்று சொல்லாத நான்கும் உண்டு.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவையாவன: பாதாளமும், மலட்டுக் கர்ப்பமும்,","poem":1},{"lineBreak":true},{"text":"தண்ணீரால் திருப்தியடையாத நிலமும், போதுமென்று சொல்லாத நெருப்புமே.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தகப்பனைப் பரியாசம்செய்து,","poem":1},{"lineBreak":true},{"text":"தாயின் கட்டளையை அசட்டைசெய்கிற கண்ணை நதியின் காகங்கள் பிடுங்கும்,","poem":1},{"lineBreak":true},{"text":"கழுகின் குஞ்சுகள் சாப்பிடும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"எனக்கு மிகவும் ஆச்சரியமானவைகள் மூன்று உண்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய புத்திக்கு எட்டாதவைகள் நான்கும் உண்டு.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவையாவன: ஆகாயத்தில் கழுகினுடைய வழியும்,","poem":1},{"lineBreak":true},{"text":"கன்மலையின்மேல் பாம்பினுடைய வழியும், நடுக்கடலில் கப்பலினுடைய வழியும்,","poem":1},{"lineBreak":true},{"text":"ஒரு கன்னிகையை நாடிய மனிதனுடைய வழியுமே.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அப்படியே விபசார பெண்ணுடைய வழியும் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவள் சாப்பிட்டு, தன்னுடைய வாயைத் துடைத்து;","poem":1},{"lineBreak":true},{"text":"நான் ஒரு பாவமும் செய்யவில்லை என்பாள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"மூன்றினால் பூமி சஞ்சலப்படுகிறது,","poem":1},{"lineBreak":true},{"text":"நான்கையும் அது தாங்கமுடியாது.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அரசாளுகிற அடிமைக்காகவும்,","poem":1},{"lineBreak":true},{"text":"உணவால் திருப்தியான மூடனுக்காகவும்,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"பகைக்கப்படக்கூடியவளாக இருந்தும், கணவனுக்கு வாழ்க்கைப்பட்ட பெண்ணுக்காகவும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய எஜமானிக்குப் பதிலாக மனைவியாகும் அடிமைப் பெண்ணுக்காகவுமே.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"பூமியில் சிறியவைகளாக இருந்தும்,","poem":1},{"lineBreak":true},{"text":"மகா ஞானமுள்ளவைகள் நான்கு உண்டு.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவையாவன: சிறிய உயிரினமாக இருந்தும்,","poem":1},{"lineBreak":true},{"text":"கோடைக்காலத்திலே தங்களுடைய உணவைச் சம்பாதிக்கிற எறும்பும்,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"பெலமில்லாத உயிரினமாக இருந்தும்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய வீட்டைக் கன்மலையிலே தோண்டிவைக்கும் குழிமுயல்களும்,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ராஜா இல்லாமல் இருந்தும்,","poem":1},{"lineBreak":true},{"text":"கூட்டம் கூட்டமாகப் புறப்படுகிற வெட்டுக்கிளிகளும்,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"தன்னுடைய கைகளினால் வலையைப்பின்னி,","poem":1},{"lineBreak":true},{"text":"அரசர்கள் அரண்மனைகளில் இருக்கிற சிலந்திப் பூச்சியுமே.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"விநோதமாக அடிவைத்து நடக்கிறவைகள் மூன்று உண்டு;","poem":1},{"lineBreak":true},{"text":"விநோத நடையுள்ளவைகள் நான்கும் உண்டு.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அவையாவன: மிருகங்களில் பெலமுள்ளதும் ஒன்றுக்கும் பின்வாங்காததுமாகிய சிங்கமும்,","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"பெருமையாய் நடக்கிற சேவலும்","poem":1},{"noteId":2},{"text":", வெள்ளாட்டுக் கடாவும்,","poem":1},{"lineBreak":true},{"text":"ஒருவரும் எதிர்க்க முடியாத ராஜாவுமே.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"நீ மேட்டிமையானதினால் பைத்திமாக நடந்து,","poem":1},{"lineBreak":true},{"text":"துர்ச்சிந்தனையுள்ளவனாக இருந்தால், கையினால் வாயை மூடு.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"பாலைக் கடைதல் வெண்ணையைப் பிறப்பிக்கும்;","poem":1},{"lineBreak":true},{"text":"மூக்கைப் பிசைதல் இரத்தத்தைப் பிறப்பிக்கும்;","poem":1},{"lineBreak":true},{"text":"அப்படியே கோபத்தைக் கிண்டிவிடுதல் சண்டையைப் பிறப்பிக்கும்.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"போர்க்குதிரை","reference":{"chapter":30,"verse":31}}]},"thisChapterLink":"/api/tam_irv/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}