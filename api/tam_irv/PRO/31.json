{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"heading","content":["லேமுவேலிற்கு சொல்லப்பட்ட வசனங்கள்"]},{"type":"verse","number":1,"content":[{"text":"ராஜாவாகிய லேமுவேலின் வசனங்கள்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய தாய் அவனுக்குப் போதித்த உபதேசம்:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என் மகனே, என்னுடைய கர்ப்பத்தின் மகனே,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பொருத்தனைகளின் மகனே,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பெண்களுக்கு உன்னுடைய பெலனையும்","poem":1},{"lineBreak":true},{"text":"ராஜாக்களைக் கெடுக்கும் காரியங்களுக்கு உன்னுடைய வழிகளையும் கொடுக்காதே.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"திராட்சைரசம் குடிப்பது ராஜாக்களுக்குத் தகுதியல்ல;","poem":1},{"lineBreak":true},{"text":"லேமுவேலே, அது ராஜாக்களுக்குத் தகுதியல்ல;","poem":1},{"lineBreak":true},{"text":"மதுபானம் பிரபுக்களுக்குத் தகுதியல்ல.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மதுபானம் குடித்தால் அவர்களுடைய நியாயப்பிரமாணத்தை மறந்து,","poem":1},{"lineBreak":true},{"text":"சிறுமைப்படுகிறவர்களுடைய நியாயத்தையும் புரட்டுவார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மடிந்துபோகிறவனுக்கு மதுபானத்தையும், மனங்கசந்தவர்களுக்குத் திராட்சைரசத்தையும் கொடுங்கள்;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவன் குடித்துத் தன்னுடைய குறைவை மறந்து,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வருத்தத்தை அப்புறம் நினைக்காமல் இருக்கட்டும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஊமையனுக்காகவும் திக்கற்றவர்கள் எல்லோருடைய நியாயத்திற்காகவும்","poem":1},{"lineBreak":true},{"text":"உன்னுடைய வாயைத் திற.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உன்னுடைய வாயைத் திறந்து, நீதியாக நியாயம் தீர்த்து,","poem":1},{"lineBreak":true},{"text":"சிறுமையும் எளிமையுமானவனுக்கு நியாயம் செய்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"குணசாலியான பெண்ணைக் கண்டுபிடிப்பவன் யார்?","poem":1},{"lineBreak":true},{"text":"அவளுடைய விலை முத்துக்களைவிட உயர்ந்தது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவளுடைய கணவனுடைய இருதயம் அவளை நம்பும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய செல்வம் குறையாது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவள் உயிரோடிருக்கிற நாட்களெல்லாம் அவனுக்குத் தீமையை அல்ல,","poem":1},{"lineBreak":true},{"text":"நன்மையையே செய்கிறாள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ஆட்டு ரோமத்தையும் சணலையும் தேடி,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கைகளினால் உற்சாகத்தோடு வேலைசெய்கிறாள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவள் வியாபாரக் கப்பல்களைப்போல இருக்கிறாள்;","poem":1},{"lineBreak":true},{"text":"தூரத்திலிருந்து தன்னுடைய உணவைக் கொண்டுவருகிறாள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இருட்டோடு எழுந்து தன்னுடைய வீட்டாருக்கு உணவுகொடுத்து,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வேலைக்காரிகளுக்குப் படியளக்கிறாள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஒரு வயலை விசாரித்து அதை வாங்குகிறாள்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கைகளின் சம்பாத்தியத்தினால் திராட்சைத்தோட்டத்தை நாட்டுகிறாள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தன்னை பெலத்தால் இடைக்கட்டிக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கைகளைப் பலப்படுத்துகிறாள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"தன்னுடைய வியாபாரம் பயனுள்ளதென்று அறிந்திருக்கிறாள்;","poem":1},{"lineBreak":true},{"text":"இரவிலே அவளுடைய விளக்கு அணையாமல் இருக்கும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தன்னுடைய கைகளை இராட்டினத்தில் வைக்கிறாள்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய விரல்கள் கதிரைப் பிடிக்கும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"சிறுமையானவர்களுக்குத் தன்னுடைய கையைத் திறந்து,","poem":1},{"lineBreak":true},{"text":"ஏழைகளுக்குத் தன்னுடைய கரங்களை நீட்டுகிறாள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"தன்னுடைய வீட்டார் அனைவருக்கும் கம்பளி ஆடை இருக்கிறபடியால்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வீட்டாரினிமித்தம் குளிருக்குப் பயப்படமாட்டாள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"இரத்தினக் கம்பளங்களைத் தனக்கு உண்டாக்குகிறாள்;","poem":1},{"lineBreak":true},{"text":"மெல்லிய புடவையும் இரத்தாம்பரமும் அவளுடைய ஆடை.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவளுடைய கணவன் தேசத்தின் மூப்பர்களோடு நீதிமன்றங்களில் உட்கார்ந்திருக்கும்போது","poem":1},{"lineBreak":true},{"text":"பெயர் பெற்றவனாக இருக்கிறான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"மெல்லிய புடவைகளை உண்டாக்கி விற்கிறாள்;","poem":1},{"lineBreak":true},{"text":"கச்சைகளை வர்த்தகரிடத்தில் ஒப்புவிக்கிறாள்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவளுடைய உடை பலமும் அலங்காரமுமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"வருங்காலத்தைப் பற்றியும் மகிழுகிறாள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தன்னுடைய வாயை ஞானம் விளங்கத் திறக்கிறாள்;","poem":1},{"lineBreak":true},{"text":"தயையுள்ள போதகம் அவளுடைய நாவின்மேல் இருக்கிறது.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அவள் சோம்பலின் அப்பத்தை சாப்பிடாமல்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வீட்டுக்காரியம் எப்படி நடக்கிறது என்று கண்ணோக்கமாக இருக்கிறாள்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அவளுடைய பிள்ளைகள் எழும்பி,","poem":1},{"lineBreak":true},{"text":"அவளை பாக்கியவதி என்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய கணவன் அவளைப்பார்த்து:","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அநேகம் பெண்கள் குணசாலிகளாக இருந்தது உண்டு;","poem":1},{"lineBreak":true},{"text":"நீயோ அவர்கள் எல்லோரையும்விட மேலானவள் என்று அவளைப் புகழுகிறான்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"செளந்தரியம் வஞ்சனையுள்ளது, அழகும் வீண்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிற பெண்ணே புகழப்படுவாள்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அவளுடைய கைகளின் பலனை அவளுக்குக் கொடுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய செயல்கள் வாசல்களில் அவளைப் புகழ்வதாக.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}