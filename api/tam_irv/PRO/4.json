{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["ஞானமே பிரதானம்"]},{"type":"verse","number":1,"content":[{"text":"பிள்ளைகளே, நீங்கள் தகப்பன் போதகத்தைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"புத்தியை அடையும்படி கவனியுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நான் உங்களுக்கு நற்போதகத்தைத் தருகிறேன்;","poem":1},{"lineBreak":true},{"text":"என் உபதேசத்தை விடாதிருங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் என்னுடைய தகப்பனுக்குப் பிரியமான மகனும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய தாய்க்கு மிகவும் அருமையான ஒரே பிள்ளையுமானவன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் எனக்குப் போதித்துச் சொன்னது:","poem":1},{"lineBreak":true},{"text":"உன்னுடைய இருதயம் என்னுடைய வார்த்தைகளைக் காத்துக்கொள்வதாக;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கட்டளைகளைக் கைக்கொள், அப்பொழுது பிழைப்பாய்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஞானத்தைச் சம்பாதி, புத்தியையும் சம்பாதி;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாயின் வார்த்தைகளை மறக்காமலும் விட்டு விலகாமலும் இரு.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அதை விடாதே, அது உன்னைத் தற்காக்கும்;","poem":1},{"lineBreak":true},{"text":"அதின்மேல் பிரியமாக இரு,","poem":1},{"lineBreak":true},{"text":"அது உன்னைக் காத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஞானமே முக்கியம், ஞானத்தைச் சம்பாதி;","poem":1},{"lineBreak":true},{"text":"என்னத்தைச் சம்பாதித்தாலும் புத்தியைச் சம்பாதித்துக்கொள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நீ அதை மேன்மைப்படுத்து, அது உன்னை மேன்மைப்படுத்தும்;","poem":1},{"lineBreak":true},{"text":"நீ அதைத் தழுவிக்கொண்டால், அது உனக்கு மரியாதை செலுத்தும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அது உன்னுடைய தலைக்கு அலங்காரமான கிரீடத்தைக் கொடுக்கும்;","poem":1},{"lineBreak":true},{"text":"அது மகிமையான கிரீடத்தை உனக்குச் சூட்டும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என் மகனே, கேள், என்னுடைய வார்த்தைகளை ஏற்றுக்கொள்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது உன்னுடைய ஆயுளின் வருடங்கள் அதிகமாகும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ஞானவழியை நான் உனக்குப் போதித்தேன்;","poem":1},{"lineBreak":true},{"text":"செவ்வையான பாதைகளிலே உன்னை நடத்தினேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீ அவைகளில் நடக்கும்போது உன்னுடைய நடைகளுக்கு இடுக்கண் உண்டாவதில்லை;","poem":1},{"lineBreak":true},{"text":"நீ அவைகளில் ஓடினாலும் இடறமாட்டாய்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"புத்திமதியை உறுதியாகப் பற்றிக்கொள்,","poem":1},{"lineBreak":true},{"text":"அதை விட்டுவிடாதே; அதைக் காத்துக்கொள், அதுவே உனக்கு உயிர்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய பாதையில் நுழையாதே;","poem":1},{"lineBreak":true},{"text":"தீயோர்களுடைய வழியில் நடக்காதே.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அதை வெறுத்துவிடு, அதின் வழியாகப் போகாதே;","poem":1},{"lineBreak":true},{"text":"அதைவிட்டு விலகிக் கடந்துபோ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தீங்கு செய்யாமல் அவர்களுக்கு தூக்கம் வராது;","poem":1},{"lineBreak":true},{"text":"அவர்கள் யாரையாவது விழச்செய்யாமல் இருந்தால் அவர்களுடைய தூக்கம் கலைந்துபோகும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவர்கள் துன்மார்க்கத்தின் அப்பத்தைச் சாப்பிட்டு,","poem":1},{"lineBreak":true},{"text":"கொடுமையின் இரசத்தைக் குடிக்கிறார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நீதிமான்களுடைய பாதை நடுப்பகல்வரைக்கும்","poem":1},{"lineBreak":true},{"text":"அதிகமதிகமாகப் பிரகாசிக்கிற சூரியப்பிரகாசம்போல இருக்கும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய பாதையோ காரிருளைப்போல இருக்கும்;","poem":1},{"lineBreak":true},{"text":"தாங்கள் எதினால் இடறுகிறோம் என்பதை அறியமாட்டார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என் மகனே, என்னுடைய வார்த்தைகளைக் கவனி;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வசனங்களுக்கு உன்னுடைய செவியைச் சாய்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவைகள் உன்னுடைய கண்களைவிட்டுப் பிரியாமல் இருப்பதாக;","poem":1},{"lineBreak":true},{"text":"அவைகளை உன்னுடைய இருதயத்திற்குள்ளே காத்துக்கொள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவைகளைக் கண்டுபிடிக்கிறவர்களுக்கு அவைகள் உயிரும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய உடலுக்கெல்லாம் ஆரோக்கியமுமாம்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"எல்லாக் காவலோடும் உன்னுடைய இருதயத்தைக் காத்துக்கொள்,","poem":1},{"lineBreak":true},{"text":"அதிலிருந்து ஜீவஊற்று புறப்படும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"வாயின் தாறுமாறுகளை உன்னைவிட்டு அகற்றி,","poem":1},{"lineBreak":true},{"text":"உதடுகளின் மாறுபாட்டை உனக்குத் தூரப்படுத்து.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உன்னுடைய கண்கள் நேராக நோக்குவதாக;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய கண்ணின் இமைகள் உனக்கு முன்னே செவ்வையாகப் பார்க்கட்டும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"உன்னுடைய நடைகளைச் சீர்தூக்கிப்பார்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய வழிகளெல்லாம் பத்திரப்பட்டிருக்கட்டும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"வலதுபுறமோ இடதுபுறமோ சாயாதே;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய காலைத் தீமைக்கு விலக்கு.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}