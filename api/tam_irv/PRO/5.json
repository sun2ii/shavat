{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["விபசாரத்திற்கு எதிரான எச்சரிக்கை"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, என்னுடைய ஞானத்தைக் கவனித்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய புத்திக்கு உன்னுடைய செவியைச் சாய்;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அப்பொழுது நீ விவேகத்தைப் பேணிக்கொள்வாய்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய உதடுகள் அறிவைக் காத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ஒழுங்கீனமானவளின் உதடுகள் தேன்கூடுபோல் ஒழுகும்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய வாய் எண்ணெயைவிட மிருதுவாக இருக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவளுடைய செயல்களின் முடிவோ எட்டியைப்போலக் கசப்பும்,","poem":1},{"lineBreak":true},{"text":"இருபுறமும் கூர்மையுள்ள பட்டயம்போல் கூர்மையுமாக இருக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவளுடைய காலடிகள் மரணத்திற்கு இறங்கும்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய நடைகள் பாதாளத்தைப் பற்றிப்போகும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீ வாழ்வின் வழியைச் சிந்தித்துக்கொள்ளாதபடி,","poem":1},{"lineBreak":true},{"text":"அவளுடைய நடைகள் மாறிமாறி அலையும்; அவைகளை அறியமுடியாது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஆதலால் பிள்ளைகளே; இப்பொழுது எனக்குச் செவிகொடுங்கள்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாயின் வசனங்களைவிட்டு நீங்காமல் இருங்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"உன்னுடைய வழியை அவளுக்குத் தூரப்படுத்து;","poem":1},{"lineBreak":true},{"text":"அவளுடைய வீட்டின் வாசலுக்கு அருகில் சேராதே.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"சேர்ந்தால் உன்னுடைய மேன்மையை அந்நியர்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய ஆயுளின் காலத்தைக் கொடூரமானவர்களுக்கும் கொடுத்துவிடுவாய்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அந்நியர்கள் உன்னுடைய செல்வத்தினால் திருப்தியடைவார்கள்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய உழைப்பின் பலன் மற்றவர்களுடைய வீட்டில் சேரும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"முடிவிலே உன்னுடைய மாம்சமும் உன்னுடைய சரீரமும் உருவழியும்போது நீ துக்கித்து:","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ஐயோ, போதகத்தை நான் வெறுத்தேனே,","poem":1},{"lineBreak":true},{"text":"கடிந்துகொள்ளுதலை என் மனம் அலட்சியம் செய்ததே!","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"என்னுடைய போதகரின் சொல்லை நான் கேட்காலும்,","poem":1},{"lineBreak":true},{"text":"எனக்கு உபதேசம்செய்தவர்களுக்கு செவிகொடுக்காமலும் போனேனே!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"சபைக்குள்ளும் சங்கத்திற்குள்ளும் கொஞ்சம்குறைய","poem":1},{"lineBreak":true},{"text":"எல்லாத் தீமைக்கும் உள்ளானேனே! என்று முறையிடுவாய்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"உன்னுடைய கிணற்றிலுள்ள தண்ணீரையும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய ஊற்றில் ஊறுகிற நீரையும் குடி.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உன்னுடைய ஊற்றுகள் வெளியிலும்","poem":1},{"lineBreak":true},{"text":"உன்னுடைய வாய்க்கால்கள் வீதிகளிலும் பாய்வதாக.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவைகள் அந்நியருக்கும் உரியவைகளாக இல்லாமல்,","poem":1},{"lineBreak":true},{"text":"உனக்கே உரியவைகளாக இருப்பதாக.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"உன்னுடைய ஊற்றுக்கண் ஆசீர்வதிக்கப்படுவதாக;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய இளவயதின் மனைவியோடு மகிழ்ந்திரு.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவளே நேசிக்கப்படக்கூடிய பெண்மானும்,","poem":1},{"lineBreak":true},{"text":"அழகான வரையாடும்போல இருப்பாளாக;","poem":1},{"lineBreak":true},{"text":"அவளுடைய மார்புகளே எப்பொழுதும் உன்னைத் திருப்தியாக்கும்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய நேசத்தால் நீ எப்பொழுதும் மயங்கியிரு.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என் மகனே, நீ ஒழுங்கீனமானவளின்மேல் மயங்கித் திரிந்து,","poem":1},{"lineBreak":true},{"text":"அந்நிய பெண்ணின் மார்பைத் தழுவவேண்டியது என்ன?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"மனிதனுடைய வழிகள் யெகோவாவின் கண்களுக்கு முன்பாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவனுடைய வழிகள் எல்லாவற்றையும் அவர் சீர்தூக்கிப்பார்க்கிறார்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனை அவனுடைய அக்கிரமங்களே பிடித்துக்கொள்ளும்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய பாவக்கயிறுகளால் கட்டப்படுவான்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவனுடைய புத்தியைக் கேட்காததினால் இறந்து,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய மதிகேட்டின் மிகுதியினால் மயங்கிப்போவான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}