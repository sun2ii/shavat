{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["அறிவீனத்திற்கு எதிரான எச்சரிக்கை"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, நீ உன்னுடைய நண்பனுக்காகப் பொறுப்பேற்று,","poem":1},{"lineBreak":true},{"text":"அந்நியனுக்கு உறுதியளித்தால்,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நீ உன்னுடைய வாய்மொழிகளால் சிக்கிக்கொண்டாய்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய வாயின் வார்த்தைகளால் பிடிபட்டாய்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"இப்பொழுது என் மகனே, உன்னுடைய நண்பனுடைய கையில் நீ அகப்பட்டுக்கொண்டதால்,","poem":1},{"lineBreak":true},{"text":"நீ உன்னைத் தப்புவித்துக்கொள்ள ஒன்று செய்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உன்னுடைய கண்ணுக்கு தூக்கத்தையும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய கண்ணிமைக்குத் தூக்கமும் வரவிடாமல்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய நண்பனிடத்தில் போய், உன்னைத் தாழ்த்தி,","poem":1},{"lineBreak":true},{"text":"அவனை வருந்திக் கேட்டுக்கொள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"வெளிமான் வேட்டைக்காரனுடைய கைக்கும், குருவி வேடனுடைய கைக்கும் தப்புவதுபோல,","poem":1},{"lineBreak":true},{"text":"நீ உன்னைத் தப்புவித்துக்கொள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"சோம்பேறியே, நீ எறும்பினிடம் போய்,","poem":1},{"lineBreak":true},{"text":"அதனுடைய வழிகளைப் பார்த்து, ஞானத்தைக் கற்றுக்கொள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அதற்குப் பிரபுவும், தலைவனும், அதிகாரியும் இல்லாமல் இருந்தும்,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"கோடைக்காலத்தில் தனக்கு ஆகாரத்தைச் சம்பாதித்து,","poem":1},{"lineBreak":true},{"text":"அறுப்புக்காலத்தில் தனக்குத் தானியத்தைச் சேர்த்துவைக்கும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"சோம்பேறியே, நீ எவ்வளவு நேரம் படுத்திருப்பாய்?","poem":1},{"lineBreak":true},{"text":"எப்பொழுது உன்னுடைய தூக்கத்தைவிட்டு எழுந்திருப்பாய்?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இன்னும் கொஞ்சம் தூங்கட்டும், இன்னும் கொஞ்சம் உறங்கட்டும்,","poem":1},{"lineBreak":true},{"text":"இன்னும் கொஞ்சம் கைமுடக்கிக்கொண்டு தூங்கட்டும் என்பாயோ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"உன்னுடைய தரித்திரம் வழிப்போக்கனைப் போலவும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய வறுமை ஆயுதம் அணிந்தவனைப்போலவும் வரும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"வீணான மனிதனாகிய ஒரு துன்மார்க்கன் ஏளனம் பேசித்திரிகிறான்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவன் தன்னுடைய கண்களால் சைகைகாட்டி,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கால்களால் பேசி,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய விரல்களால் போதனை செய்கிறான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவனுடைய இருதயத்திலே பொய்யுண்டு;","poem":1},{"lineBreak":true},{"text":"இடைவிடாமல் தீங்கைப் பிணைத்து,","poem":1},{"lineBreak":true},{"text":"வழக்குகளை உண்டாக்குகிறான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆகையால் திடீரென அவனுக்கு ஆபத்து வரும்;","poem":1},{"lineBreak":true},{"text":"உதவியில்லாமல் திடீரென நாசமடைவான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஆறு காரியங்களைக் யெகோவா வெறுக்கிறார்,","poem":1},{"lineBreak":true},{"text":"ஏழும் அவருக்கு அருவருப்பானவைகள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவையாவன: மேட்டிமையான கண், பொய்நாவு,","poem":1},{"lineBreak":true},{"text":"குற்றமற்றவர்களுடைய இரத்தம் சிந்தும் கை,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"மிகக்கொடிய சிந்தனைகளைத் தூண்டுகின்ற இருதயம்,","poem":1},{"lineBreak":true},{"text":"தீங்கு செய்வதற்கு விரைந்து ஓடும் கால்,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பொய்யானதைப் பேசும் பொய்ச்சாட்சி,","poem":1},{"lineBreak":true},{"text":"சகோதரர்களுக்குள்ளே விரோதத்தை உண்டாக்குதல் ஆகிய இவைகளே.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என் மகனே, உன்னுடைய தகப்பன் கற்பனையைக் காத்துக்கொள்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய தாயின் போதகத்தைத் தள்ளாதே.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவைகளை எப்பொழுதும் உன்னுடைய இருதயத்திலே அணிந்து, அவைகளை உன்னுடைய கழுத்திலே கட்டிக்கொள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நீ நடக்கும்போது அது உனக்கு வழிகாட்டும்;","poem":1},{"lineBreak":true},{"text":"நீ படுக்கும்போது அது உன்னைக் காப்பாற்றும்;","poem":1},{"lineBreak":true},{"text":"நீ விழிக்கும்போது அது உனக்கு போதிக்கும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"கட்டளையே விளக்கு,","poem":1},{"lineBreak":true},{"text":"வேதமே வெளிச்சம், போதகதண்டனையே வாழ்வின் வழி.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அது உன்னைத் துன்மார்க்கப் பெண்ணுக்கும்,","poem":1},{"lineBreak":true},{"text":"ஆசை வார்த்தைகளைப் பேசும் நாக்கை உடைய ஒழுங்கீனமானவளுக்கும் விலக்கிக் காக்கும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உன்னுடைய இருதயத்திலே அவளுடைய அழகை ரசிக்காதே;","poem":1},{"lineBreak":true},{"text":"அவள் தன்னுடைய கண்ணின் இமைகளினால் உன்னைப் பிடிக்கவிடாதே.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"விபசாரியினால் ஒரு அப்பத்துண்டையும் இழக்கவேண்டியதாகும்;","poem":1},{"lineBreak":true},{"text":"விபசாரியானவள் அருமையான உயிரை வேட்டையாடுகிறாள்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"தன்னுடைய உடை வேகாமல் மடியிலே எவனாவது நெருப்பை வைத்துக்கொள்ளமுடியுமா?","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"தன்னுடைய கால் சுடாமல் எவனாவது தழலின்மேல் நடக்கமுடியுமா?","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"பிறனுடைய மனைவியிடம் தவறான உறவுகொள்பவனும்,","poem":1},{"lineBreak":true},{"text":"அப்படியே அவளைத் தொடுகிற எவனும், தண்டனைக்குத் தப்பமாட்டான்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"திருடன் தன்னுடைய பசியை ஆற்றத் திருடினால் மக்கள் அவனை இகழமாட்டார்கள்;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அவன் கண்டுபிடிக்கப்பட்டால் ஏழு மடங்கு கொடுத்துத் தீர்க்கவேண்டும்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வீட்டிலுள்ள பொருள்களையெல்லாம் கொடுக்கவேண்டியதாகும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"பெண்ணுடனே விபசாரம்செய்கிறவன் மதிகெட்டவன்;","poem":1},{"lineBreak":true},{"text":"அப்படிச் செய்கிறவன் தன்னுடைய ஆத்துமாவைக் கெடுத்துப்போடுகிறான்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"வாதையையும் வெட்கத்தையும் அடைவான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய நிந்தை ஒழியாது.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"பெண்ணைப்பற்றிய எரிச்சல் ஆணுக்கு கடுங்கோபத்தை உண்டாக்கும்;","poem":1},{"lineBreak":true},{"text":"அவன் பழிவாங்கும் நாளில் தப்பவிடமாட்டான்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"அவன் எந்த நஷ்டத்தையும் பார்க்கமாட்டான்;","poem":1},{"lineBreak":true},{"text":"அநேகம் வெகுமதிகளைக் கொடுத்தாலும் அமர்ந்திருக்கமாட்டான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}