{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["விபசாரிக்கு எதிரான எச்சரிக்கை"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, நீ என்னுடைய வார்த்தைகளைக்காத்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கட்டளைகளை உன்னிடத்தில் பத்திரப்படுத்து.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய கட்டளைகளையும் என்னுடைய போதகத்தையும் உன்னுடைய கண்மணியைப்போல் காத்துக்கொள்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது பிழைப்பாய்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவைகளை உன்னுடைய விரல்களில் கட்டி,","poem":1},{"lineBreak":true},{"text":"அவைகளை உன்னுடைய இருதயப்பலகையில் எழுதிக்கொள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ஆசைவார்த்தைகளைப் பேசும் அந்நியப் பெண்ணாகிய ஒழுங்கீனமானவளுக்கு உன்னை விலக்கிக் காப்பதற்காக,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஞானத்தை நோக்கி, நீ என்னுடைய சகோதரி என்றும்,","poem":1},{"lineBreak":true},{"text":"புத்தியைப்பார்த்து, நீ என்னுடைய இனத்தைச் சேர்ந்தவள் என்றும் சொல்லு.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் என்னுடைய வீட்டின் ஜன்னல் அருகே நின்று,","poem":1},{"lineBreak":true},{"text":"அதின் வழியாகப் பார்த்தபோது,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"பேதையர்களாகிய வாலிபர்களுக்குள்ளே","poem":1},{"lineBreak":true},{"text":"ஒரு புத்தியற்ற வாலிபனைக்கண்டு அவனை கவனித்தேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவன் மாலைமயங்கும் சூரியன் மறையும் நேரத்திலும்,","poem":1},{"lineBreak":true},{"text":"இரவின் இருளிலும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவள் இருக்கும் தெருவிற்கு அடுத்த தெருவில் சென்று,","poem":1},{"lineBreak":true},{"text":"அவளுடைய வீட்டுவழியாக நடந்துபோனான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அப்பொழுது இதோ, விபசாரியின் ஆடை ஆபரணம் தரித்த","poem":1},{"lineBreak":true},{"text":"தந்திரமனமுள்ள ஒரு பெண் அவனுக்கு எதிர்ப்பட்டாள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவள் வாயாடியும் அடங்காதவளுமானவள்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய கால்கள் வீட்டிலே தங்குகிறதில்லை.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"சிலவேளை வெளியிலே இருப்பாள், சிலவேளை வீதியில் இருப்பாள்,","poem":1},{"lineBreak":true},{"text":"சந்துகள்தோறும் மறைந்திருப்பாள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவள் அவனைப் பிடித்து முத்தமிட்டு,","poem":1},{"lineBreak":true},{"text":"முகம் நாணாமல் அவனைப் பார்த்து:","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"சமாதான பலிகள் என்மேல் சுமந்திருந்தது,","poem":1},{"lineBreak":true},{"text":"இன்றைக்குத்தான் என்னுடைய பொருத்தனைகளை நிறைவேற்றினேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆதலால், நான் உன்னைச் சந்திக்கப் புறப்பட்டு,","poem":1},{"lineBreak":true},{"text":"உன் முகத்தை ஆவலோடு தேடினேன்;","poem":1},{"lineBreak":true},{"text":"இப்பொழுது உன்னைக் கண்டுபிடித்தேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"என்னுடைய மெத்தையை இரத்தினக் கம்பளங்களாலும்,","poem":1},{"lineBreak":true},{"text":"எகிப்து தேசத்தின் விசித்திரமான மெல்லிய துணிகளாலும் அலங்கரித்தேன்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என்னுடைய படுக்கையை வெள்ளைப்போளத்தாலும்","poem":1},{"lineBreak":true},{"text":"சந்தனத்தாலும் இலவங்கப்பட்டையாலும் வாசனையாக்கினேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"வா, விடியற்காலைவரைக்கும் சந்தோஷமாக இருப்போம்,","poem":1},{"lineBreak":true},{"text":"இன்பங்களினால் பூரிப்போம்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"கணவன் வீட்டிலே இல்லை, தூரப்பயணம் போனான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"பணப்பையைத் தன்னுடைய கையிலே கொண்டுபோனான்,","poem":1},{"lineBreak":true},{"text":"குறிக்கப்பட்ட நாளிலே வீட்டுக்கு வருவான் என்று சொல்லி,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"தன்னுடைய மிகுதியான இனிய சொற்களால் அவனை வசப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உதடுகளின் இனிமையான பேச்சால் அவனை இணங்கச்செய்தாள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"உடனே அவன் அவள் பின்னே சென்றான்;","poem":1},{"lineBreak":true},{"text":"ஒரு மாடு அடிக்கப்படும்படி செல்வதுபோலவும்,","poem":1},{"lineBreak":true},{"text":"ஒரு மூடன் விலங்கிடப்பட்டு தண்டனைக்குப் போவதுபோலவும்,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ஒரு குருவி தன்னுடைய உயிரை வாங்கும் கண்ணியை அறியாமல்","poem":1},{"lineBreak":true},{"text":"அதில் விழுவதற்கு விரைந்து போகிறதுபோலவும்,","poem":1},{"lineBreak":true},{"text":"அவளுக்குப் பின்னே போனான்;","poem":1},{"lineBreak":true},{"text":"அம்பு அவனுடைய இருதயத்தைப் பிளந்தது.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஆதலால் பிள்ளைகளே, எனக்குச் செவிகொடுங்கள்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாயின் வார்த்தைகளைக் கவனியுங்கள்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உன்னுடைய இருதயம் அவளுடைய வழியிலே சாயவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய பாதையிலே மயங்கித் திரியாதே.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவள் அநேகரைக் காயப்படுத்தி, விழச்செய்தாள்;","poem":1},{"lineBreak":true},{"text":"பலவான்கள் அநேகரைக் கொலைசெய்தாள்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அவளுடைய வீடு பாதாளத்திற்குப்போகும் வழி;","poem":1},{"lineBreak":true},{"text":"அது மரண அறைகளுக்குக் கொண்டுபோய்விடும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}