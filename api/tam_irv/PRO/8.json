{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["ஞானம் அழைக்கிறது"]},{"type":"verse","number":1,"content":[{"text":"ஞானம் கூப்பிடுகிறதில்லையோ?","poem":1},{"lineBreak":true},{"text":"புத்தி சத்தமிடுகிறதில்லையோ?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அது வழியருகே உள்ள மேடைகளிலும்,","poem":1},{"lineBreak":true},{"text":"நான்கு சந்திப்புகளிலும் நிற்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அது ஊர்வாசல்களின் ஓரத்திலும், பட்டணத்தின் வாசலிலும், நடை கூடங்களிலும் நின்று சத்தமிட்டு:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மனிதர்களே, உங்களை நோக்கிக் கூப்பிடுகிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய சத்தம் மனுமக்களுக்குத் தொனிக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பேதைகளே, விவேகம் அடையுங்கள்;","poem":1},{"lineBreak":true},{"text":"மூடர்களே, புத்தியுள்ள சிந்தையாக இருங்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"கேளுங்கள், மேன்மையான காரியங்களைப் பேசுவேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உதடுகள் உத்தம காரியங்களை வசனிக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என்னுடைய வாய் சத்தியத்தைச் சொல்லும்,","poem":1},{"lineBreak":true},{"text":"ஏளனம் என்னுடைய உதடுகளுக்கு அருவருப்பானது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய வாயின் வாக்குகளெல்லாம் நீதியானவைகள்;","poem":1},{"lineBreak":true},{"text":"அவைகளில் புரட்டும் விபரீதமும் இல்லை.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவைகளெல்லாம் புத்தியுள்ளவனுக்குத் தெளிவும்,","poem":1},{"lineBreak":true},{"text":"ஞானத்தைப் பெற்றவர்களுக்கு எதார்த்தமாகவும் இருக்கும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"வெள்ளியைவிட என்னுடைய புத்திமதியையும்,","poem":1},{"lineBreak":true},{"text":"சுத்தபொன்னைவிட ஞானத்தையும் அங்கீகரித்துக்கொள்ளுங்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"முத்துக்களைவிட ஞானமே நல்லது;","poem":1},{"lineBreak":true},{"text":"ஆசைப்படத்தக்கவைகள் எல்லாம் அதற்கு நிகரல்ல.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ஞானமாகிய நான் விவேகத்தோடு தங்கி,","poem":1},{"lineBreak":true},{"text":"நல்யுக்தியான அறிவுகளைக் கண்டடைகிறேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தீமையை வெறுப்பதே யெகோவாவுக்குப் பயப்படும் பயம்;","poem":1},{"lineBreak":true},{"text":"பெருமையையும், அகந்தையையும், தீய வழியையும்,","poem":1},{"lineBreak":true},{"text":"மாறுபாடுள்ள வாயையும் நான் வெறுக்கிறேன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஆலோசனையும் மெய்ஞானமும் என்னுடையவைகள்;","poem":1},{"lineBreak":true},{"text":"நானே புத்தி, வல்லமை என்னுடையது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என்னாலே ராஜாக்கள் அரசாளுகிறார்கள்,","poem":1},{"lineBreak":true},{"text":"பிரபுக்கள் நீதிசெலுத்துகிறார்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"என்னாலே அதிகாரிகளும், பிரபுக்களும்,","poem":1},{"lineBreak":true},{"text":"பூமியிலுள்ள எல்லா நியாயாதிபதிகளும் ஆளுகை செய்துவருகிறார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என்னை நேசிக்கிறவர்களை நான் நேசிக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"அதிகாலையில் என்னைத் தேடுகிறவர்கள் என்னைக் கண்டடைவார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"செல்வமும், கனமும், நிலையான பொருளும்,","poem":1},{"lineBreak":true},{"text":"நீதியும் என்னிடத்தில் உண்டு.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பொன்னையும் தங்கத்தையும்விட என்னுடைய பலன் நல்லது;","poem":1},{"lineBreak":true},{"text":"சுத்த வெள்ளியைவிட என்னுடைய வருமானம் நல்லது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என்னை நேசிக்கிறவர்கள் மெய்ப்பொருளை பெற்றுக்கொள்ளும்படிக்கும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய களஞ்சியங்களை நான் நிரப்பும்படிக்கும்,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவர்களை நீதியின் வழியிலும்,","poem":1},{"lineBreak":true},{"text":"நியாயபாதைகளுக்குள்ளும் நடத்துகிறேன்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவா தமது செயல்களுக்குமுன்","poem":1},{"lineBreak":true},{"text":"ஆரம்பமுதல் என்னைத் தமது வழியின் துவக்கமாகக்கொண்டிருந்தார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"பூமி உண்டாவதற்குமுன்னும்,","poem":1},{"lineBreak":true},{"text":"ஆரம்பம்முதற்கொண்டும் அநாதியாய் நான் அபிஷேகம்செய்யப்பட்டேன்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஆழங்களும், தண்ணீர் புரண்டுவரும் ஊற்றுகளும் உண்டாகுமுன்பே நான் உருவாக்கப்பட்டேன்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"மலைகள் நிலைபெறுவதற்கு முன்னும்,","poem":1},{"lineBreak":true},{"text":"குன்றுகள் உண்டாவதற்கு முன்னும்,","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவர் பூமியையும் அதின் வெளிகளையும், பூமியிலுள்ள மண்ணின் திரள்களையும் உண்டாக்குமுன்னும்","poem":1},{"lineBreak":true},{"text":"நான் உருவாக்கப்பட்டேன்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அவர் வானங்களைப் படைக்கும்போது நான் அங்கே இருந்தேன்;","poem":1},{"lineBreak":true},{"text":"அவர் சமுத்திர விலாசத்தை குறிக்கும்போதும்,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"உயரத்தில் மேகங்களை அமைத்து,","poem":1},{"lineBreak":true},{"text":"சமுத்திரத்தின் ஊற்றுகளை அடைத்துவைக்கும்போதும்,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"சமுத்திரத் தண்ணீர் தன்னுடைய கரையைவிட்டு மீறாதபடி","poem":1},{"lineBreak":true},{"text":"அதற்கு எல்லையைக் கட்டளையிட்டு, பூமியின் அஸ்திபாரங்களை நிலைப்படுத்தும்போதும்,","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"நான் அவர் அருகே செல்லப்பிள்ளையாக இருந்தேன்;","poem":1},{"lineBreak":true},{"text":"எப்பொழுதும் அவருடைய மனமகிழ்ச்சியாக இருந்து,","poem":1},{"lineBreak":true},{"text":"எப்பொழுதும் அவருடைய சமுகத்தில் களிகூர்ந்தேன்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அவருடைய பூவுலகத்தில் சந்தோஷப்பட்டு,","poem":1},{"lineBreak":true},{"text":"மனுமக்களுடனே மகிழ்ந்து கொண்டிருந்தேன்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"ஆதலால் பிள்ளைகளே, எனக்குச் செவிகொடுங்கள்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வழிகளைக் காத்து நடக்கிறவர்கள் பாக்கியவான்கள்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"நீங்கள் புத்தியைக் கேட்டு, ஞானமடையுங்கள்;","poem":1},{"lineBreak":true},{"text":"அதைவிட்டு விலகாமல் இருங்கள்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"என்னுடைய வாசற்படியில் எப்பொழுதும் விழித்திருந்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கதவு நிலை அருகே காத்திருந்து,","poem":1},{"lineBreak":true},{"text":"எனக்குச் செவிகொடுக்கிற மனிதன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"என்னைக் கண்டடைகிறவன் வாழ்வைக் கண்டடைகிறான்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவிடத்தில் தயவையும் பெறுவான்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"எனக்கு விரோதமாகப் பாவம் செய்கிறவனோ,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய ஆத்துமாவைச் சேதப்படுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"என்னை வெறுக்கிறவர்கள் எல்லோரும் மரணத்தை விரும்புகிறவர்கள் என்று சொல்லுகிறது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}