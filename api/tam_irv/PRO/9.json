{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_irv","name":"நீதிமொழிகள்","commonName":"நீதிமொழிகள்","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"7f08369de6e8e6bff68c6f3a82cdb521d15b3034cfe6bf33e7b4d0087b9aa095","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_irv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["ஞானி மற்றும் பேதையர்களுக்கான அழைப்பு"]},{"type":"verse","number":1,"content":[{"text":"ஞானம் தன்னுடைய வீட்டைக் கட்டி,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய செதுக்கப்பட்ட ஏழு தூண்களையும் அமைத்து,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தன்னுடைய கொழுத்த மிருகங்களை அடித்து,","poem":1},{"lineBreak":true},{"text":"திராட்சைரசத்தை ஊற்றிவைத்து,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உணவுப்பந்தியை ஆயத்தப்படுத்தி,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தன்னுடைய பணிவிடைக்காரிகளை அனுப்பி,","poem":1},{"lineBreak":true},{"text":"பட்டணத்தின் உயர்ந்த மேடைகளின்மேல் நின்று கூப்பிட்டு,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"புத்தியீனனை நோக்கி:","poem":1},{"lineBreak":true},{"text":"எவன் பேதையோ அவன் இந்த இடத்திற்கு வரட்டும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீங்கள் வந்து என்னுடைய அப்பத்தைச் சாப்பிட்டு,","poem":1},{"lineBreak":true},{"text":"நான் ஊற்றிய திராட்சைரசத்தைக் குடியுங்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பேதமையைவிட்டு விலகுங்கள்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது பிழைத்திருப்பீர்கள்;","poem":1},{"lineBreak":true},{"text":"புத்தியின் வழியிலே நடவுங்கள் என்று சொல்லுகிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"பரியாசக்காரனைக் கண்டிக்கிறவன் அவமானமடைகிறான்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனைக் கண்டிக்கிறவன் தன்னைக் கறைப்படுத்திக்கொள்ளுகிறான்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பரியாசக்காரனைக் கடிந்துகொள்ளாதே,","poem":1},{"lineBreak":true},{"text":"அவன் உன்னைப் பகைப்பான்;","poem":1},{"lineBreak":true},{"text":"ஞானமுள்ளவனைக் கடிந்துகொள்,","poem":1},{"lineBreak":true},{"text":"அவன் உன்னை நேசிப்பான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஞானமுள்ளவனுக்குப் போதி, அவன் ஞானத்தில் தேறுவான்;","poem":1},{"lineBreak":true},{"text":"நீதிமானுக்கு உபதேசம் செய்,","poem":1},{"lineBreak":true},{"text":"அவன் அறிவில் விருத்தியடைவான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதலே ஞானத்தின் ஆரம்பம்;","poem":1},{"lineBreak":true},{"text":"பரிசுத்த தேவனின் அறிவே அறிவு.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னாலே உன்னுடைய ஆயுசு நாட்கள் பெருகும்;","poem":1},{"lineBreak":true},{"text":"ஆயுளின் வருடங்கள் விருத்தியாகும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீ ஞானியானால் உனக்கென்று ஞானியாவாய்;","poem":1},{"lineBreak":true},{"text":"நீ பரியாசக்காரனானால் நீயே அதின் பயனை அநுபவிப்பாய் என்று சொல்லுகிறது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"மதியற்ற பெண் வாயாடியும் ஒன்றுமறியாத மூடத்தனம் உள்ளவளுமாக இருக்கிறாள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவள் தன்னுடைய வீட்டுவாசற்படியிலும் பட்டணத்தின் மேடைகளிலும் இருக்கைபோட்டு உட்கார்ந்து,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"தங்களுடைய வழிகளை நோக்கி நேரே போகும் வழிப்போக்கர்களைப் பார்த்து:","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"எவன் பேதையோ அவன் இந்த இடத்திற்கு வரட்டும் என்றும்,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"மதியீனனை நோக்கி:","poem":1},{"lineBreak":true},{"text":"திருட்டுத்தண்ணீர் தித்திக்கும்,","poem":1},{"lineBreak":true},{"text":"மறைவான இடத்தில் சாப்பிடும் அப்பம் இன்பமாக இருக்கும் என்றும் சொல்லிக் கூப்பிடுகிறாள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"இருப்பினும் இறந்தவர்கள் அந்த இடத்தில் உண்டென்றும்,","poem":1},{"lineBreak":true},{"text":"அவளுடைய விருந்தாளிகள் நரக பாதாளங்களில் கிடக்கிறார்களென்றும் அவன் அறியமாட்டான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}