{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"துன்மார்க்கர்களுடைய ஆலோசனையின்படி நடக்காமலும்,","poem":1},{"lineBreak":true},{"text":"பாவிகளுடைய வழியில் நிற்காமலும்,","poem":1},{"lineBreak":true},{"text":"பரியாசக்காரர்கள் உட்காரும் இடத்தில் உட்காராமலும்,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய வேதத்தில் பிரியமாக இருந்து,","poem":1},{"lineBreak":true},{"text":"இரவும் பகலும் அவருடைய வேதத்தில் தியானமாக இருக்கிற மனிதன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவன் நீரோடை ஓரமாக நடப்பட்டு,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய காலத்தில் தன்னுடைய கனியைத் தந்து,","poem":1},{"lineBreak":true},{"text":"இலை உதிராமல் இருக்கிற மரத்தைப்போல இருப்பான்.","poem":1},{"lineBreak":true},{"text":"அவன் செய்வதெல்லாம் வாய்க்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களோ அப்படியில்லாமல்,","poem":1},{"lineBreak":true},{"text":"காற்றுப் பறக்கடிக்கும் பதரைப்போல் இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஆகையால் துன்மார்க்கர்கள் நியாயத்தீர்ப்பிலும்,","poem":1},{"lineBreak":true},{"text":"பாவிகள் நீதிமான்களின் சபையிலும் நிலைநிற்பதில்லை.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா நீதிமான்களின் வழியை அறிந்திருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களின் வழியோ அழியும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}