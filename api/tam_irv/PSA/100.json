{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["நன்றிப்பாடல்."]},{"type":"verse","number":1,"content":[{"text":"பூமியில் உள்ளவர்களே, எல்லோரும் யெகோவாவைக் கெம்பீரமாகப் பாடுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மகிழ்ச்சியோடு யெகோவாவுக்கு ஆராதனைசெய்து,","poem":1},{"lineBreak":true},{"text":"ஆனந்தசத்தத்தோடு அவர் முன்பாக வாருங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே தேவனென்று அறியுங்கள்;","poem":1},{"lineBreak":true},{"text":"நாம் அல்ல, அவரே நம்மை உண்டாக்கினார்;","poem":1},{"lineBreak":true},{"text":"நாம் அவர் மக்களும், அவர் மேய்ச்சலின் ஆடுகளுமாக இருக்கிறோம்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் வாசல்களில் துதியோடும், அவர் முற்றங்களில் புகழ்ச்சியோடும் நுழைந்து, அவரைத் துதித்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய பெயருக்கு நன்றிசெலுத்துங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவா நல்லவர், அவருடைய கிருபை என்றென்றைக்கும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய உண்மை தலைமுறை தலைமுறைக்கும் உள்ளது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}