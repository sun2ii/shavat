{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"இரக்கத்தையும், நியாயத்தையும் குறித்துப் பாடுவேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உம்மை புகழ்ந்துபாடுவேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உத்தமமான வழியிலே நேர்மையாக நடப்பேன்;","poem":1},{"lineBreak":true},{"text":"எப்பொழுது என்னிடத்தில் வருவீர்!","poem":1},{"lineBreak":true},{"text":"என்னுடைய வீட்டிலே உத்தம இருதயத்தோடு நடந்துகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தீங்கான காரியத்தை என்னுடைய கண்முன் வைக்கமாட்டேன்;","poem":1},{"lineBreak":true},{"text":"வழி விலகுகிறவர்களின் செயல்களை வெறுக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"அது என்னைப் பற்றாது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மாறுபாடான மக்கள் என்னைவிட்டு விலகவேண்டும்;","poem":1},{"lineBreak":true},{"text":"பொல்லாதவனை ஏற்கமாட்டேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பிறனை இரகசியமாக அவதூறுசெய்கிறவனை அழிப்பேன்;","poem":1},{"lineBreak":true},{"text":"பெருமைக் கண்ணனையும் திமிர்பிடித்த மனப்பான்மை உள்ளவனையும் பொறுக்கமாட்டேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தேசத்தில் உண்மையானவர்கள் என்னோடு குடியிருக்கும்படி என்னுடைய கண்கள் அவர்கள்மேல் நோக்கமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"உத்தமமான வழியில் நடக்கிறவன் எனக்கு ஊழியம்செய்வான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"கபடுசெய்கிறவன் என்னுடைய வீட்டுக்குள் இருப்பதில்லை;","poem":1},{"lineBreak":true},{"text":"பொய்சொல்லுகிறவன் என்னுடைய கண்முன் நிலைப்பதில்லை.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரர்கள் ஒருவரும் யெகோவாவுடைய நகரத்தில் இல்லாதபடி வேர் அறுக்கப்பட்டுபோக,","poem":1},{"lineBreak":true},{"text":"தேசத்திலுள்ள அக்கிரமக்காரர்கள் அனைவரையும் அதிகாலமே அழிப்பேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}