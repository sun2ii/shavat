{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["துயரப்படுகிறவன் துக்கத்தில் மூழ்கி யெகோவாவிடத்தில் தன் மனவேதனையை தெரியப்படுத்தும் விண்ணப்பம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என்னுடைய விண்ணப்பத்தைக் கேளும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஜெபம் உம்மிடத்தில் சேர்வதாக.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆபத்துநாளிலே உமது முகத்தை எனக்கு மறைக்காமல் இரும்;","poem":1},{"lineBreak":true},{"text":"உமது செவியை என்னிடத்தில் சாயும்;","poem":1},{"lineBreak":true},{"text":"நான் கூப்பிடுகிற நாளிலே எனக்கு விரைவாக பதில் சொல்லும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னுடைய நாட்கள் புகையைப்போல் ஒழிந்தது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய எலும்புகள் ஒரு கொள்ளியைப்போல் எரிந்தது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயம் புல்லைப்போல் வெட்டப்பட்டு உலர்ந்தது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆகாரத்தைச் சாப்பிட மறந்தேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என்னுடைய பெருமூச்சின் சத்தத்தினால், என்னுடைய எலும்புகள் என்னுடைய சரீரத்தோடு ஒட்டிக்கொள்ளுகிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"வனாந்தர நாரைக்கு ஒப்பானேன்;","poem":1},{"lineBreak":true},{"text":"பாழான இடங்களில் தங்கும் ஆந்தையைப் போலானேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நான் தூக்கம் இல்லாமல் வீட்டின்மேல் தனித்திருக்கும் குருவியைப்போல இருக்கிறேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நாள்தோறும் என்னுடைய எதிரிகள் என்னை நிந்திக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"என்மேல் மூர்க்கவெறிகொண்டவர்கள் எனக்கு விரோதமாகச் சாபம் இடுகிறார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நீர் என்னை உயரத்தூக்கி, கீழேத் தள்ளினீர்,","poem":1},{"lineBreak":true},{"text":"உமது கோபத்திற்கும், கடுங்கோபத்திற்கும் உள்ளானேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆதலால், நான் சாம்பலை அப்பமாகச் சாப்பிட்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பானங்களைக் கண்ணீரோடு கலக்கிறேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆயுசு நாட்கள் சாய்ந்துபோகிற நிழலைப்போலிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"புல்லைப்போல் உலர்ந்துபோகிறேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவாவாகிய நீரோ என்றென்றைக்கும் இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பெயரின் புகழ் தலைமுறை தலைமுறையாக நிற்கும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவனே நீர் எழுந்தருளி சீயோனுக்கு இரங்குவீர்;","poem":1},{"lineBreak":true},{"text":"அதற்கு தயவு செய்யும் காலமும், அதற்காகக் குறித்த நேரமும் வந்தது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"உம்முடைய ஊழியக்காரர்கள் அதின் கல்லுகள்மேல் வாஞ்சைவைத்து,","poem":1},{"lineBreak":true},{"text":"அதின் மண்ணுக்குப் பரிதபிக்கிறார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"யெகோவா சீயோனைக் கட்டி, தமது மகிமையில் வெளிப்படுவார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"திக்கற்றவர்களுடைய ஜெபத்தை அலட்சியம்செய்யாமல்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் விண்ணப்பத்தை அங்கீகரிப்பார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அப்பொழுது தேசங்கள் யெகோவாவுடைய பெயருக்கும்,","poem":1},{"lineBreak":true},{"text":"பூமியிலுள்ள ராஜாக்களெல்லோரும் உம்முடைய மகிமைக்கும் பயப்படுவார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பின்சந்ததிக்காக இது எழுதப்படும்;","poem":1},{"lineBreak":true},{"text":"உருவாக்கப்படும் மக்கள் யெகோவாவை துதிப்பார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"யெகோவா கட்டுண்டவர்களின் பெருமூச்சைக் கேட்கவும்,","poem":1},{"lineBreak":true},{"text":"கொலைக்கு நியமிக்கப்பட்டவர்களை விடுதலையாக்கவும்,","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தம்முடைய உயர்ந்த பரிசுத்த ஸ்தலத்திலிருந்து பார்த்து,","poem":1},{"lineBreak":true},{"text":"வானங்களிலிருந்து பூமியின்மேல் கண்ணோக்கமானார்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்கு ஆராதனைசெய்ய, மக்களும் ராஜ்ஜியங்களும் ஒன்றாகக் கூடிக்கொள்ளும்போது,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"சீயோனில் யெகோவாவுடைய பெயரையும்,","poem":1},{"lineBreak":true},{"text":"எருசலேமில் அவருடைய துதியையும் பறைசாற்றுவார்கள்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"பாதி வயதில் என்னுடைய பெலனை அவர் ஒடுக்கி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய நாட்களைக் குறுகச்செய்தார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அப்பொழுது நான்: என் தேவனே, பாதி வயதில் என்னை எடுத்துக்கொள்ளாமல் இரும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வருடங்கள் தலைமுறை தலைமுறையாக இருக்கும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"நீர் ஆரம்பத்திலே பூமியை அஸ்திபாரப்படுத்தினீர்;","poem":1},{"lineBreak":true},{"text":"வானங்கள் உம்முடைய கரத்தின் செயல்களாக இருக்கிறது.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவைகள் அழிந்துபோகும், நீரோ நிலைத்திருப்பீர்; அவைகளெல்லாம் ஆடையைப்போல் பழமையாகப்போகும்;","poem":1},{"lineBreak":true},{"text":"அவைகளை ஒரு சால்வையைப்போல் மாற்றுவீர், அப்பொழுது மாறிப்போகும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"நீரோ மாறாதவராக இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"உமது ஆண்டுகள் முடிந்துபோவதில்லை.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"உமது அடியாரின் பிள்ளைகள் வாழ்ந்திருப்பார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய சந்ததி உமக்கு முன்பாக நிலைபெற்றிருக்கும் என்று சொன்னேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}