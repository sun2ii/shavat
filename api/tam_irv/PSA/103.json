{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என் ஆத்துமாவே, யெகோவாவைப் போற்று;","poem":1},{"lineBreak":true},{"text":"என் முழு உள்ளமே, அவருடைய பரிசுத்த பெயரைப் போற்று.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என் ஆத்துமாவே, யெகோவாவுக்கு நன்றிசொல்;","poem":1},{"lineBreak":true},{"text":"அவர் செய்த எல்லா நன்மைகளையும் மறவாதே.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் உன்னுடைய அக்கிரமங்களையெல்லாம் மன்னித்து,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய நோய்களையெல்லாம் குணமாக்கி,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உன்னுடைய உயிரை அழிவுக்கு விலக்கி மீட்டு,","poem":1},{"lineBreak":true},{"text":"உன்னைக் கிருபையினாலும் இரக்கங்களினாலும் முடிசூட்டி,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நன்மையினால் உன்னுடைய வாயைத் திருப்தியாக்குகிறார்;","poem":1},{"lineBreak":true},{"text":"கழுகுக்குச் சமமாக உன்னுடைய வயது திரும்ப இளவயது போலாகிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ஒடுக்கப்படுகிற அனைவருக்கும், யெகோவா நீதியையும் நியாயத்தையும் செய்கிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் தமது வழிகளை மோசேக்கும், தமது செயல்களை இஸ்ரவேல் சந்ததிக்கும் தெரியப்படுத்தினார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா உருக்கமும், இரக்கமும்,","poem":1},{"lineBreak":true},{"text":"நீடிய சாந்தமும், மிகுந்த கிருபையுமுள்ளவர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் எப்பொழுதும் கடிந்துகொள்வதில்லை;","poem":1},{"lineBreak":true},{"text":"என்றைக்கும் கோபமாக இருப்பதில்லை.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர் நம்முடைய பாவங்களுக்குத் தகுந்தபடி நமக்குச் செய்யாமலும்,","poem":1},{"lineBreak":true},{"text":"நம்முடைய அக்கிரமங்களுக்குத் தகுந்தபடி நமக்குச் சரிக்கட்டாமலும் இருக்கிறார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பூமிக்கு வானம் எவ்வளவு உயரமாக இருக்கிறதோ,","poem":1},{"lineBreak":true},{"text":"அவருக்குப் பயப்படுகிறவர்கள்மேல் அவருடைய கிருபையும் அவ்வளவு பெரிதாக இருக்கிறது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"மேற்கிற்கும் கிழக்கிற்கும் எவ்வளவு தூரமோ,","poem":1},{"lineBreak":true},{"text":"அவ்வளவு தூரமாக அவர் நம்முடைய பாவங்களை நம்மைவிட்டு விலக்கினார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தகப்பன் தன்னுடைய பிள்ளைகளுக்கு இரங்குகிறதுபோல,","poem":1},{"lineBreak":true},{"text":"யெகோவா தமக்குப் பயந்தவர்களுக்கு இரங்குகிறார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நம்முடைய உருவம் இன்னதென்று அவர் அறிவார்;","poem":1},{"lineBreak":true},{"text":"நாம் மண்ணென்று நினைவுகூருகிறார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"மனிதனுடைய நாட்கள் புல்லுக்கு ஒப்பாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"வெளியின் பூவைப்போல் பூக்கிறான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"காற்று அதின்மேல் வீசினவுடனே அது இல்லாமற்போனது;","poem":1},{"lineBreak":true},{"text":"அது இருந்த இடமும் இனி அதை அறியாது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய கிருபையோ அவருக்குப் பயந்தவர்கள்மேலும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய நீதி அவர்கள் பிள்ளைகளுடைய பிள்ளைகள்மேலும் ஆதிகாலம் முதற்கொண்டு என்றென்றைக்கும் உள்ளது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவருடைய உடன்படிக்கையைக் கைக்கொண்டு, அவருடைய கட்டளைகளின்படி செய்ய நினைக்கிறவர்கள் மேலேயே உள்ளது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"யெகோவா வானங்களில் தமது சிங்காசனத்தை நிறுவியிருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய ராஜரிகம் எல்லாவற்றையும் ஆளுகிறது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய வார்த்தையைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"அவருடைய வசனத்தின்படி செய்கிற","poem":1},{"lineBreak":true},{"text":"பலத்த வல்லமையுள்ளவர்களாகிய அவருடைய தூதர்களே,","poem":1},{"lineBreak":true},{"text":"அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பிரியமானதைச் செய்து,","poem":1},{"lineBreak":true},{"text":"அவர் பணிவிடைக்காரர்களாக இருக்கிற அவருடைய எல்லா சேனைகளே,","poem":1},{"lineBreak":true},{"text":"அவரைப் போற்றுங்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவா ஆளுகிற எல்லா இடங்களிலுமுள்ள அவருடைய எல்லா படைப்புகளே,","poem":1},{"lineBreak":true},{"text":"அவரைப் போற்றுங்கள்;","poem":1},{"lineBreak":true},{"text":"என் ஆத்துமாவே, யெகோவாவைப் போற்று.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}