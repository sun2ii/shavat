{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"என் ஆத்துமாவே, யெகோவாவைப் போற்று;","poem":1},{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவாவே, நீர் மிகவும் பெரியவராக இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"மகிமையையும் மகத்துவத்தையும் அணிந்துகொண்டிருக்கிறீர்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஒளியை ஆடையாக அணிந்து, வானங்களைத் திரையைப்போல் விரித்திருக்கிறீர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தமது மேல்வீடுகளைத் தண்ணீர்களால் மேல்தளமாக்கி,","poem":1},{"lineBreak":true},{"text":"மேகங்களைத் தமது இரதமாக்கி, காற்றினுடைய இறக்கைகளின்மேல் செல்லுகிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தம்முடைய தூதர்களைக் காற்றுகளாகவும்,","poem":1},{"lineBreak":true},{"text":"தம்முடைய ஊழியக்காரர்களை நெருப்பு ஜூவாலைகளாகவும் செய்கிறார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பூமி ஒருபோதும் நகர்த்த முடியாதபடி அதின் அஸ்திபாரங்கள்மேல் அதை நிறுவினார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அதை ஆடையினால் மூடுவதுபோல ஆழத்தினால் மூடினீர்;","poem":1},{"lineBreak":true},{"text":"மலைகளின்மேல் தண்ணீர்கள் நின்றது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவைகள் உமது கண்டிதத்தால் விலகியோடி,","poem":1},{"lineBreak":true},{"text":"உமது குமுறலின் சத்தத்தால் விரைந்துசென்றது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவைகள் மலைகளில் ஏறி, பள்ளத்தாக்குகளில் இறங்கி,","poem":1},{"lineBreak":true},{"text":"நீர் அவைகளுக்கு ஏற்படுத்தின இடத்தில் சென்றது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவைகள் திரும்பவும் வந்து பூமியை மூடிக்கொள்ளாதபடி","poem":1},{"lineBreak":true},{"text":"கடக்காமல் இருக்கும் எல்லையை அவைகளுக்கு ஏற்படுத்தினீர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர் பள்ளத்தாக்குகளில் நீரூற்றுகளை வரவிடுகிறார்;","poem":1},{"lineBreak":true},{"text":"அவைகள் மலைகள் நடுவே ஓடுகிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவைகள் வெளியின் உயிர்களுக்கெல்லாம் தண்ணீர் கொடுக்கும்;","poem":1},{"lineBreak":true},{"text":"அங்கே காட்டுக்கழுதைகள் தங்களுடைய தாகத்தைத் தீர்த்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவைகளின் ஓரமாக வானத்துப் பறவைகள் குடியிருந்து,","poem":1},{"lineBreak":true},{"text":"கிளைகள் மேலிருந்து பாடும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தம்முடைய மேல்வீடுகளிலிருந்து மலைகளுக்குத் தண்ணீர் இறைக்கிறார்;","poem":1},{"lineBreak":true},{"text":"உமது செயல்களின் பயனால் பூமி திருப்தியாக இருக்கிறது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"பூமியிலிருந்து ஆகாரம் உண்டாகும்படி, அவர் மிருகங்களுக்குப் புல்லையும்,","poem":1},{"lineBreak":true},{"text":"மனிதருக்கு உபயோகமான பயிர்வகைகளையும் முளைப்பிக்கிறார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"மனிதனுடைய இருதயத்தை மகிழ்ச்சியாக்கும் திராட்சைரசத்தையும்,","poem":1},{"lineBreak":true},{"text":"அவனுக்கு முகக்களையை உண்டாக்கும் எண்ணெயையும்,","poem":1},{"lineBreak":true},{"text":"மனிதனுடைய இருதயத்தை ஆதரிக்கும் உணவையும் விளைவிக்கிறார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய மரங்களும்,","poem":1},{"lineBreak":true},{"text":"அவரால் நடப்பட்ட லீபனோனின் கேதுருக்களும் செழித்து நிறைந்திருக்கும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அங்கே குருவிகள் கூடுகட்டும்; தேவதாருமரங்கள் கொக்குகளின் குடியிருப்பு.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"உயர்ந்த மலைகள் வரையாடுகளுக்கும், கன்மலைகள் குழிமுயல்களுக்கும் அடைக்கலம்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"சந்திரனைக் காலக்குறிப்புகளுக்காகப் படைத்தார்;","poem":1},{"lineBreak":true},{"text":"சூரியன் தன்னுடைய மறையும் நேரத்தை அறியும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நீர் இருளைக் கட்டளையிடுகிறீர், இரவுநேரமாகும்;","poem":1},{"lineBreak":true},{"text":"அதிலே எல்லா காட்டு உயிர்களும் நடமாடும்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"இளசிங்கங்கள் இரைக்காக கெர்ச்சித்து, தேவனால் தங்களுக்கு உணவு கிடைக்கும்படித்தேடும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"சூரியன் உதிக்கும்போது அவைகள் ஒதுங்கி,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய மறைவிடங்களில் படுத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அப்பொழுது மனிதன் மாலைவரை தன்னுடைய வேலைக்கும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உழைப்புக்கும் புறப்படுகிறான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது செயல்கள் எவ்வளவு திரளாக இருக்கிறது!","poem":1},{"lineBreak":true},{"text":"அவைகளையெல்லாம் ஞானமாகப் படைத்தீர்;","poem":1},{"lineBreak":true},{"text":"பூமி உம்முடைய பொருட்களினால் நிறைந்திருக்கிறது.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"பெரிதும் அகலமுமான இந்த கடலும் அப்படியே நிறைந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அதிலே வாழும் சிறியவைகளும் பெரியவைகளுமான கணக்கில்லாத உயிர்கள் உண்டு.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அதிலே கப்பல்கள் ஓடும்;","poem":1},{"lineBreak":true},{"text":"அதிலே விளையாடும்படி நீர் உண்டாக்கின திமிங்கிலங்களும் உண்டு.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"ஏற்றவேளையில் உணவைத் தருவீர் என்று அவைகளெல்லாம்","poem":1},{"lineBreak":true},{"text":"உம்மை நோக்கிக் காத்திருக்கும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"நீர்கொடுக்க, அவைகள் வாங்கிக்கொள்ளும்;","poem":1},{"lineBreak":true},{"text":"நீர் உம்முடைய கையைத் திறக்க, அவைகள் நன்மையால் திருப்தியாகும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"நீர் உமது முகத்தை மறைக்க, திகைக்கும்;","poem":1},{"lineBreak":true},{"text":"நீர் அவைகளின் சுவாசத்தை வாங்கிக்கொள்ள, அவைகள் இறந்து,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய மண்ணுக்குத் திரும்பும்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"நீர் உம்முடைய ஆவியை அனுப்பும்போது, அவைகள் உருவாக்கப்படும்;","poem":1},{"lineBreak":true},{"text":"நீர் பூமி அனைத்தையும் புதிதாக்குகிறீர்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய மகிமை என்றென்றைக்கும் விளங்கும்;","poem":1},{"lineBreak":true},{"text":"யெகோவா தம்முடைய செயல்களிலே மகிழுவார்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"அவர் பூமியை நோக்கிப்பார்க்க, அது அதிரும்;","poem":1},{"lineBreak":true},{"text":"அவர் மலைகளைத் தொட, அவைகள் புகையும்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"நான் உயிரோடிருக்கும்வரை என்னுடைய யெகோவாவைப் பாடுவேன்;","poem":1},{"lineBreak":true},{"text":"நான் உயிரோடிருக்கும்வரையும் என் தேவனைப் புகழ்ந்து பாடுவேன்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"நான் அவரைத் தியானிக்கும் தியானம் இனிதாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"நான் யெகோவாவுக்குள் மகிழுவேன்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"பாவிகள் பூமியிலிருந்து மறைந்து,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் இனி இல்லாமற்போவார்கள்.","poem":1},{"lineBreak":true},{"text":"என் ஆத்துமாவே, யெகோவாவைப் போற்று,","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}