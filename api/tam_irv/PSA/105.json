{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவை துதித்து, அவருடைய பெயரை பிரபலமாக்குங்கள்,","poem":1},{"lineBreak":true},{"text":"அவருடைய செய்கைகளை தேசங்களுக்குள்ளே பிரசித்தப்படுத்துங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவரைப் பாடி, அவரைப் புகழுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய அதிசயங்களையெல்லாம் தியானித்துப் பேசுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவருடைய பரிசுத்த பெயரைக் குறித்து மேன்மைபாராட்டுங்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை தேடுகிறவர்களின் இருதயம் மகிழ்வதாக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவையும் அவர் வல்லமையையும் நாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் சமுகத்தைத் தொடர்ந்து தேடுங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவருடைய ஊழியனாகிய ஆபிரகாமின் சந்ததியே!","poem":1},{"lineBreak":true},{"text":"அவரால் தெரிந்து கொள்ளப்பட்டவர்களாகிய யாக்கோபின் மக்களே!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் செய்த அதிசயங்களையும், அவருடைய அற்புதங்களையும்,","poem":1},{"lineBreak":true},{"text":"அவர் வாயிலிருந்து புறப்படும் நியாயத்தீர்ப்புகளையும் நினைவுகூருங்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவரே நம்முடைய தேவனாகிய யெகோவா,","poem":1},{"lineBreak":true},{"text":"அவருடைய நியாயத்தீர்ப்புகள் பூமியெங்கும் விளங்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆயிரம் தலைமுறைக்கென்று அவர் கட்டளையிட்ட வார்த்தையும்,","poem":1},{"lineBreak":true},{"text":"ஆபிரகாமோடு அவர் செய்த உடன்படிக்கையையும்,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் ஈசாக்குக்கு இட்ட ஆணையையும் என்றென்றைக்கும் நினைத்திருக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அதை யாக்கோபுக்குப் பிரமாணமாகவும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலுக்கு நிரந்தர உடன்படிக்கையாகவும் உறுதிப்படுத்தி:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"உங்களுடைய சுதந்தரபாகமான கானான் தேசத்தை உனக்குத் தருவேன் என்றார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அக்காலத்தில் அவர்கள் கொஞ்சத் தொகைக்குட்பட்ட சில மக்களுமாக இருந்தார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவர்கள் ஒரு தேசத்தைவிட்டு மறு தேசத்திற்கும்,","poem":1},{"lineBreak":true},{"text":"ஒரு ராஜ்ஜியத்தைவிட்டு மறுதேசத்திற்கும் போனார்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர்களை ஒடுக்கும்படி ஒருவருக்கும் இடங்கொடுக்காமல்,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்காக ராஜாக்களைக் கடிந்துகொண்டு:","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நான் அபிஷேகம்செய்தவர்களை நீங்கள் தொடாமலும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய தீர்க்கதரிசிகளுக்குத் தீங்கு செய்யாமலும் இருங்கள் என்றார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவர் தேசத்திலே பஞ்சத்தை வரவழைத்து, உணவு என்னும் ஆதரவுகோலை முற்றிலும் முறித்தார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவர்களுக்கு முன்னாலே ஒரு மனிதனை அனுப்பினார்;","poem":1},{"lineBreak":true},{"text":"யோசேப்பு சிறையாக விற்கப்பட்டான்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவனுடைய கால்களை விலங்குபோட்டு ஒடுக்கினார்கள்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய உயிர் இரும்பில் அடைபட்டிருந்தது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"யெகோவா சொன்ன வார்த்தை நிறைவேறும்வரை","poem":1},{"lineBreak":true},{"text":"அவருடைய வசனம் அவனைப் புடமிட்டது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ராஜா ஆள் அனுப்பி, அவனைக் கட்டவிழ்க்கச் சொன்னான்;","poem":1},{"lineBreak":true},{"text":"மக்களின் அதிபதி அவனை விடுதலை செய்தான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"தன்னுடைய பிரபுக்களை அவனுடைய மனதின்படி கட்டவும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய மூப்பர்களை ஞானிகளாக்கவும்,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவனைத் தன்னுடைய வீட்டுக்கு அதிகாரியும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய செல்வங்களுக்கெல்லாம் ஆளுனராகவும் ஏற்படுத்தினார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அப்பொழுது இஸ்ரவேல் எகிப்திற்கு வந்தான்;","poem":1},{"lineBreak":true},{"text":"யாக்கோபு காமின் தேசத்திலே அந்நியனாக இருந்தான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய மக்களை மிகவும் பலுகச்செய்து,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய எதிரிகளைவிட அவர்களைப் பலவான்களாக்கினார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"தம்முடைய மக்களைப் பகைக்கவும்,","poem":1},{"lineBreak":true},{"text":"தம்முடைய ஊழியக்காரர்களை வஞ்சனையாக நடத்தவும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய இருதயத்தை மாற்றினார்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தம்முடைய ஊழியனாகிய மோசேயையும் தாம் தெரிந்துகொண்ட ஆரோனையும் அனுப்பினார்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"இவர்கள் அவர்களுக்குள் அவருடைய அடையாளங்களையும்,","poem":1},{"lineBreak":true},{"text":"காமின் தேசத்திலே அற்புதங்களையும் செய்தார்கள்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அவர் இருளை அனுப்பி, காரிருளை உண்டாக்கினார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய வார்த்தைகளை எதிர்ப்பவர்கள் இல்லை.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அவர்களுடைய தண்ணீர்களை இரத்தமாக மாற்றி,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய மீன்களை சாகடித்தார்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அவர்களுடைய தேசம் தவளைகளை அதிகமாகப் பிறக்கவைத்தது;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய ராஜாக்களின் அறைவீடுகளிலும் அவைகள் வந்தது.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அவர் கட்டளையிட, அவர்களுடைய எல்லைகளிலெங்கும் வண்டுகளும் பேன்களும் வந்தது.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"அவர்களுடைய மழைகளைக் கல்மழையாக்கி,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய தேசத்திலே ஜூவாலிக்கிற நெருப்பை வரச்செய்தார்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"அவர்களுடைய திராட்சைச்செடிகளையும் அத்திமரங்களையும் அழித்து,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய எல்லைகளிலுள்ள மரங்களையும் முறித்தார்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"அவர் கட்டளையிட, எண்ணிமுடியாத வெட்டுக்கிளிகளும் பச்சைப்புழுக்களும் வந்து,","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"அவர்களுடைய தேசத்திலுள்ள எல்லா தாவரங்களையும் அரித்து,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய நிலத்தின் கனியைத் தின்றுபோட்டது.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"அவர்களுடைய தேசத்திலே முதற்பிறப்புகள் அனைத்தையும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய பெலனில் முதற்பெலனான எல்லோரையும் அழித்தார்.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"அப்பொழுது அவர்களை வெள்ளியோடும் பொன்னோடும் புறப்படச்செய்தார்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் கோத்திரங்களில் பலவீனப்பட்டவன் ஒருவனும் இருந்ததில்லை.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"எகிப்தியர்கள் அவர்களுக்குப் பயந்ததினால், அவர்கள் புறப்பட்டபோது மகிழ்ந்தார்கள்.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"அவர் மேகத்தை மறைவுக்காக விரித்து,","poem":1},{"lineBreak":true},{"text":"இரவை வெளிச்சமாக்குகிறதற்காக நெருப்பையும் தந்தார்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"இஸ்ரவேலர்கள் உணவு கேட்டார்கள், அவர் காடைகளை வரச்செய்தார்;","poem":1},{"lineBreak":true},{"text":"வான அப்பத்தினாலும் அவர்களைத் திருப்தியாக்கினார்.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"கன்மலையைத் திறந்தார், தண்ணீர்கள் புறப்பட்டு, வனாந்திரத்தில் ஆறாக ஓடினது.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய பரிசுத்த வாக்குத்தத்தத்தையும்,","poem":1},{"lineBreak":true},{"text":"தம்முடைய ஊழியனாகிய ஆபிரகாமையும் நினைத்து,","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"தம்முடைய மக்களை மகிழ்ச்சியோடும்,","poem":1},{"lineBreak":true},{"text":"தாம் தெரிந்துகொண்டவர்களைக் கெம்பீர சத்தத்தோடும் புறப்படச்செய்து,","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"தமது கட்டளைகளைக் காத்து நடக்கும்படிக்கும்,","poem":1},{"lineBreak":true},{"text":"தமது நியாயப்பிரமாணங்களைக் கைக்கொள்ளும்படிக்கும்,","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"அவர்களுக்கு அந்நியர்களுடைய தேசங்களைக் கொடுத்தார்;","poem":1},{"lineBreak":true},{"text":"அந்நிய மக்களுடைய உழைப்பின் பலனைச் சுதந்தரித்துக்கொண்டார்கள்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}