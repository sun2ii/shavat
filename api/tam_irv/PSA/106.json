{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா, யெகோவாவை துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் நல்லவர், அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய வல்லமையான செயல்களைச் சொல்லி,","poem":1},{"lineBreak":true},{"text":"அவருடைய துதியையெல்லாம் சொல்லக்கூடியவன் யார்?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நியாயத்தைக் கைக்கொள்ளுகிறவர்களும்,","poem":1},{"lineBreak":true},{"text":"எக்காலத்திலும் நீதியைச் செய்கிறவர்களும் பாக்கியவான்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் தெரிந்துகொண்டவர்களின் நன்மையை நான் கண்டு,","poem":1},{"lineBreak":true},{"text":"உம்முடைய மக்களின் மகிழ்ச்சியால் மகிழ்ந்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய சுதந்தரத்தோடு மேன்மைபாராட்டும்படிக்கு,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்முடைய மக்களுக்கு நீர் பாராட்டும் கிருபையின்படி என்னை நினைத்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய இரட்சிப்பினால் என்னைச் சந்தித்தருளும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"எங்களுடைய முன்னோர்களோடு நாங்களும் பாவஞ்செய்து,","poem":1},{"lineBreak":true},{"text":"அக்கிரமம் நடப்பித்து, தீமைகளைச் செய்தோம்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"எங்களுடைய முன்னோர்கள் எகிப்திலே உம்முடைய அதிசயங்களை உணராமலும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய கிருபைகளின் பெருக்கத்தை நினைக்காமலும் போய்,","poem":1},{"lineBreak":true},{"text":"சிவந்த கடலின் ஓரத்திலே கலகம்செய்தார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆனாலும் அவர் தமது வல்லமையை வெளிப்படுத்தும்படி,","poem":1},{"lineBreak":true},{"text":"தம்முடைய பெயரினிமித்தம் அவர்களைக் காப்பாற்றினார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் சிவந்த கடலை அதட்டினார், அது வற்றிப்போனது;","poem":1},{"lineBreak":true},{"text":"காய்ந்த தரையில் நடக்கிறதுபோல அவர்களை ஆழங்களில் நடந்துபோகச்செய்தார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"பகைவரின் கைக்கு அவர்களை விலக்கிக் காப்பாற்றி, எதிரியின் கைக்கு அவர்களை விலக்கி மீட்டார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர்களுடைய எதிரிகளைத் தண்ணீர்கள் மூடிக்கொண்டது;","poem":1},{"lineBreak":true},{"text":"அவர்களில் ஒருவனும் மீதியாக இருக்கவில்லை.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அப்பொழுது அவர்கள் அவருடைய வார்த்தைகளை விசுவாசித்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய துதியைப் பாடினார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ஆனாலும் சீக்கிரமாக அவருடைய செயல்களை மறந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய ஆலோசனைக்கு அவர்கள் காத்திருக்காமல்,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"வனாந்திரத்திலே ஆசையுள்ளவர்களாகி,","poem":1},{"lineBreak":true},{"text":"பாலைவனத்திலே தேவனைப் பரீட்சைபார்த்தார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அப்பொழுது அவர்கள் கேட்டதை அவர்களுக்குக் கொடுத்தார்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் சரீரத்திலோ வியாதியை அனுப்பினார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"முகாமில் அவர்கள் மோசேயின்மேலும்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய பரிசுத்தனாகிய ஆரோனின்மேலும் பொறாமைகொண்டார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"பூமி பிளந்து தாத்தானை விழுங்கி,","poem":1},{"lineBreak":true},{"text":"அபிராமின் கூட்டத்தை மூடிப்போட்டது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவர்கள் கூட்டத்தில் நெருப்பு பற்றியெரிந்தது;","poem":1},{"lineBreak":true},{"text":"நெருப்பு ஜூவாலை துன்மார்க்கர்களை எரித்துப்போட்டது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவர்கள் ஓரேபிலே ஒரு கன்றுக்குட்டியையுண்டாக்கி,","poem":1},{"lineBreak":true},{"text":"வார்க்கப்பட்ட சிலையை வழிபட்டார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தங்களுடைய மகிமையைப்","poem":1},{"lineBreak":true},{"text":"புல்லைத் தின்கிற மாட்டின் சாயலாக மாற்றினார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"எகிப்திலே பெரிய செயல்களையும்,","poem":1},{"lineBreak":true},{"text":"காமின் தேசத்திலே அதிசயங்களையும்,","poem":1},{"lineBreak":true},{"text":"சிவந்த கடலினருகில் பயங்கரமானவைகளையும் செய்தவராகிய,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"தங்களுடைய இரட்சகரான தேவனை மறந்தார்கள்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ஆகையால், அவர்களை நாசம்செய்வேன் என்றார்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது அவரால் தெரிந்துகொள்ளப்பட்ட மோசே,","poem":1},{"lineBreak":true},{"text":"அவர்களை அவர் அழிக்காதபடி,","poem":1},{"lineBreak":true},{"text":"அவருடைய கடுங்கோபத்தை ஆற்றுவதற்கு,","poem":1},{"lineBreak":true},{"text":"அவருக்கு முன்பாகத் திறப்பின் வாசலிலே நின்றான்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அவருடைய வார்த்தையை விசுவாசிக்காமல்,","poem":1},{"lineBreak":true},{"text":"விரும்பத்தக்க தேசத்தை அசட்டைச்செய்தார்கள்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய சத்தத்திற்குச் செவிகொடுக்காமல்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய கூடாரங்களில் முறுமுறுத்தார்கள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அப்பொழுது அவர்கள் வனாந்தரத்திலே இறக்கவும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் சந்ததி தேசங்களுக்குள்ளே அழியவும்,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அவர்கள் பற்பல தேசங்களிலே சிதறடிக்கப்படவும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு விரோதமாகத் தம்முடைய கையை எடுத்தார்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அவர்கள் பாகால்பேயோரைப் பற்றிக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"உயிரில்லாதவைகளுக்கு செலுத்தின பலிகளை சாப்பிட்டு,","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"தங்களுடைய செயல்களினால் அவருக்குக் கோபம் மூட்டினார்கள்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் வாதை அவர்களுக்குள் புகுந்தது.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அப்பொழுது பினெகாஸ் எழுந்து நின்று நியாயஞ்செய்தான்;","poem":1},{"lineBreak":true},{"text":"அதினால் வாதை நிறுத்தப்பட்டது.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அது தலைமுறை தலைமுறையாக என்றைக்கும் அவனுக்கு நீதியாக எண்ணப்பட்டது.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"மேரிபாவின் தண்ணீர்களிடத்திலும் அவருக்குக் கடுங்கோபம் மூட்டினார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களினால் மோசேக்கும் பொல்லாப்பு வந்தது.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"அவர்கள் அவன் ஆவியைத் துக்கப்படுத்தினதினாலே,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உதடுகளினால் பதறிப்பேசினான்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"யெகோவா தங்களுக்குச் சொன்னபடி,","poem":1},{"lineBreak":true},{"text":"அவர்கள் அந்த மக்களை அழிக்கவில்லை.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"அந்நிய ஜாதிகளோடு கலந்து, அவர்களுடைய செயல்களைக் கற்று;","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"அவர்களுடைய சிலைகளை வழிபட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"அவைகள் அவர்களுக்குக் கண்ணியானது.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய மகன்களையும்","poem":1},{"lineBreak":true},{"text":"தங்களுடைய மகள்களையும் பிசாசுகளுக்குப் பலியிட்டார்கள்.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"அவர்கள் கானான் தேசத்து சிலைகளுக்கு பலியிட்டு,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய மகன்கள் மகள்களுடைய குற்றமில்லாத இரத்தத்தைச் சிந்தினார்கள்;","poem":1},{"lineBreak":true},{"text":"தேசம் இரத்தத்தால் தீட்டுப்பட்டது.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய செயல்களினால் அசுத்தமாகி,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய செயல்களினால் வேசித்தனம் செய்தார்கள்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"அதினால் யெகோவாவுடைய கோபம் தமது மக்களின்மேல் எழும்பினது;","poem":1},{"lineBreak":true},{"text":"அவர் தமது சுதந்தரத்தை அருவருத்தார்.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"அவர்களைத் தேசங்களுடைய கையில் ஒப்புக்கொடுத்தார்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய பகைவர்கள் அவர்களை ஆண்டார்கள்.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"அவர்களுடைய எதிரிகள் அவர்களை ஒடுக்கினார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய கையின்கீழ்த் தாழ்த்தப்பட்டார்கள்.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"அநேகமுறை அவர்களை விடுவித்தார்;","poem":1},{"lineBreak":true},{"text":"அவர்களோ தங்களுடைய யோசனையினால் அவருக்கு விரோதமாகக் கலகம்செய்து,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய அக்கிரமத்தினால் சிறுமைப்படுத்தப்பட்டார்கள்.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"அவர்கள் கூப்பிடுதலை அவர் கேட்கும்போதோ,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு உண்டான இடுக்கத்தை அவர் பார்த்து,","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"அவர்களுக்காகத் தமது உடன்படிக்கையை நினைத்து,","poem":1},{"lineBreak":true},{"text":"தமது மிகுந்த கிருபையின்படி மனவேதனை அடைந்து,","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"அவர்களைச் சிறைபிடித்த அனைவரும் அவர்களுக்கு இரங்கும்படி செய்தார்.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"எங்கள் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நாங்கள் உமது பரிசுத்தப் பெயரைப் போற்றி,","poem":1},{"lineBreak":true},{"text":"உம்மைத் துதிக்கிறதில் மேன்மைபாராட்டும்படி எங்களைக் காப்பாற்றி,","poem":1},{"lineBreak":true},{"text":"எங்களைத் தேசங்களிலிருந்து சேர்த்தருளும்.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"இஸ்ரவேலின் தேவனாகிய யெகோவா","poem":1},{"lineBreak":true},{"text":"அநாதியாக என்றென்றைக்கும் ஸ்தோத்திரிக்கப்படத்தக்கவர்.","poem":1},{"lineBreak":true},{"text":"மக்களெல்லோரும் ஆமென், என்பார்களாக,","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}