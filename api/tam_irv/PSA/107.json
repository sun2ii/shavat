{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":107,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவை துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் நல்லவர், அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவால் எதிரியின் கைக்கு நீங்கலாக்கி மீட்கப்பட்டு,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"கிழக்கிலும் மேற்கிலும் வடக்கிலும் தெற்கிலுமுள்ள","poem":1},{"lineBreak":true},{"text":"பல தேசங்களிலுமிருந்து சேர்க்கப்பட்டவர்கள்,","poem":1},{"lineBreak":true},{"text":"அப்படிச் சொல்வார்களாக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர்கள் வாழும் ஊரைக்காணாமல்,","poem":1},{"lineBreak":true},{"text":"வனாந்திரத்திலே பாலைவனவழியாக,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பசியாகவும், தாகமாகவும், ஆத்துமா சோர்ந்துபோனதாகவும்","poem":1},{"lineBreak":true},{"text":"அலைந்து திரிந்தார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தங்களுடைய ஆபத்திலே யெகோவாவை நோக்கிக் கூப்பிட்டார்கள்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் இக்கட்டுகளிலிருந்து அவர்களை மீட்டெடுத்தார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"வாழும் ஊருக்குப்போய்ச்சேர,","poem":1},{"lineBreak":true},{"text":"அவர்களைச் செவ்வையான வழியிலே நடத்தினார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தாகமுள்ள ஆத்துமாவைக் யெகோவா திருப்தியாக்கி,","poem":1},{"lineBreak":true},{"text":"பசியுள்ள ஆத்துமாவை நன்மையினால் நிரப்புகிறாரென்று,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவருடைய கிருபையினிமித்தமும்,","poem":1},{"lineBreak":true},{"text":"மனிதர்களுக்கு அவர் செய்கிற அதிசயங்களினிமித்தமும் அவரைத் துதிப்பார்களாக.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தேவனுடைய வார்த்தைகளுக்கு விரோதமாகக் கலகம்செய்து,","poem":1},{"lineBreak":true},{"text":"உன்னதமான தேவனுடைய ஆலோசனையை அசட்டைசெய்தவர்கள்,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"காரிருளிலும் மரண இருளிலும் வைக்கப்பட்டிருந்து,","poem":1},{"lineBreak":true},{"text":"ஒடுக்கத்திலும் இரும்பிலும் கட்டப்பட்டு கிடந்தார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவர்களுடைய இருதயத்தை அவர் வருத்தத்தால் தாழ்த்தினார்;","poem":1},{"lineBreak":true},{"text":"உதவிசெய்ய ஒருவரும் இல்லாமல் விழுந்து போனார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தங்களுடைய ஆபத்திலே யெகோவாவை நோக்கிக் கூப்பிட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் இக்கட்டுகளிலிருந்து அவர்களை நீங்கலாக்கிக் காப்பாற்றினார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"காரிருளிலும் மரண இருளிலுமிருந்து அவர்களை வெளிப்படச்செய்து,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய கட்டுகளை அறுத்தார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"யெகோவா வெண்கலக் கதவுகளை உடைத்து,","poem":1},{"lineBreak":true},{"text":"இரும்புத் தாழ்ப்பாள்களை முறித்தாரென்று,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவருடைய கிருபையினிமித்தமும்,","poem":1},{"lineBreak":true},{"text":"மனிதர்களுக்கு அவர் செய்கிற அதிசயங்களினிமித்தமும் அவரைத் துதிப்பார்களாக.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"புத்தியீனரும் தங்களுடைய கலக வழிகளாலும்","poem":1},{"lineBreak":true},{"text":"தங்களுடைய அக்கிரமங்களாலும் நோய்கொண்டு ஒடுங்கிப்போகிறார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவர்களுடைய ஆத்துமா எல்லா உணவையும் வெறுக்கிறது,","poem":1},{"lineBreak":true},{"text":"அவர்கள் மரணவாசல்கள் வரையிலும் நெருங்குகிறார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தங்களுடைய ஆபத்திலே யெகோவாவை நோக்கிக் கூப்பிடுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் இக்கட்டுகளுக்கு அவர்களை நீங்கலாக்கிக் காப்பாற்றுகிறார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவர் தமது வசனத்தை அனுப்பி அவர்களைக் குணமாக்கி,","poem":1},{"lineBreak":true},{"text":"அவர்களை அழிவுக்குத் தப்புவிக்கிறார்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவர்கள் யெகோவாவை அவருடைய கிருபையினிமித்தமும்,","poem":1},{"lineBreak":true},{"text":"மனிதர்களுக்கு அவர் செய்கிற அதிசயங்களினிமித்தமும் துதித்து,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நன்றிபலிகளைச் செலுத்தி, அவருடைய செயல்களை ஆனந்த சத்தத்தோடு விவரிப்பார்களாக.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"கப்பலேறி, கடற்பயணம்செய்து, திரளான தண்ணீர்களிலே தொழில் செய்கிறார்களே,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அவர்கள் யெகோவாவுடைய செயல்களையும்,","poem":1},{"lineBreak":true},{"text":"ஆழத்திலே அவருடைய அதிசயங்களையும் காண்கிறார்கள்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவர் கட்டளையிட பெருங்காற்று எழும்பி,","poem":1},{"lineBreak":true},{"text":"அதின் அலைகளைக் கொந்தளிக்கச்செய்யும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவர்கள் வானத்தில் ஏறி,","poem":1},{"lineBreak":true},{"text":"ஆழங்களில் இறங்குகிறார்கள்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய ஆத்துமா துன்பத்தினால் கரைந்துபோகிறது.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"குடித்துவெறித்தவனைப்போல் அலைந்து தடுமாறுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய ஞானமெல்லாம் முழுகிப்போகிறது.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அப்பொழுது தங்களுடைய ஆபத்திலே அவர்கள் யெகோவாவை நோக்கிக் கூப்பிடுகிறார்கள்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய இக்கட்டுகளுக்கு அவர்களை நீங்கலாக்கி விடுவிக்கிறார்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"கொந்தளிப்பை அமர்த்துகிறார், அதின் அலைகள் அடங்குகின்றது.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அமைதி உண்டானதிற்காக அவர்கள் சந்தோஷப்படுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"தாங்கள் விரும்பிய துறைமுகத்தில் அவர்களைக் கொண்டுவந்து சேர்க்கிறார்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அவர்கள் யெகோவாவை அவருடைய கிருபையினிமித்தமும்,","poem":1},{"lineBreak":true},{"text":"மனிதர்களுக்கு அவர் செய்கிற அதிசயங்களினிமித்தமும் துதித்து,","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"மக்களின் சபையிலே அவரை உயர்த்தி,","poem":1},{"lineBreak":true},{"text":"மூப்பர்களின் சங்கத்திலே அவரைப் போற்றுவார்களாக.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"அவர் ஆறுகளை வனாந்திரமாகவும், நீரூற்றுகளை வறண்ட இடமாகவும்,","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"குடிகளுடைய பொல்லாப்புக்காக செழிப்பான தேசத்தைத் தரிசு நிலமாகவும் மாற்றுகிறார்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"அவர் வனாந்திரவெளியைத் தண்ணீர் குளமாகவும்,","poem":1},{"lineBreak":true},{"text":"வறண்ட நிலத்தை நீரூற்றுகளாகவும் மாற்றி,","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"பசித்தவர்களை அங்கே குடியேற்றுகிறார்;","poem":1},{"lineBreak":true},{"text":"அங்கே அவர்கள் குடியிருக்கும் நகரத்தைக் கட்டி,","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"வயல்களை உண்டாக்கி விதைத்து, திராட்சைத்தோட்டங்களை நாட்டுகிறார்கள்,","poem":1},{"lineBreak":true},{"text":"அவைகள் வரத்துள்ள பலனைத் தரும்.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"அவர்களை ஆசீர்வதிக்கிறார்,","poem":1},{"lineBreak":true},{"text":"மிகுதியும் பெருகுகிறார்கள்; அவர்களுடைய மிருகங்கள் குறையாமலிருக்கச்செய்கிறார்.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"பின்பு அவர்கள் இடுக்கத்தினாலும், ஆபத்தினாலும்,","poem":1},{"lineBreak":true},{"text":"துயரத்தினாலும் குறைவுபட்டுத் தாழ்வடைகிறார்கள்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"அவர் எதிரிகளின் தலைவர்கள்மேல் இகழ்ச்சிவரச்செய்து,","poem":1},{"lineBreak":true},{"text":"வழியில்லாத வனாந்திர வெளியிலே அவர்களைத் திரியச்செய்து,","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"எளியவனையோ சிறுமையிலிருந்து எடுத்து,","poem":1},{"lineBreak":true},{"text":"உயர்ந்த அடைக்கலத்திலே வைத்து,","poem":1},{"lineBreak":true},{"text":"அவனுடைய வம்சங்களை மந்தையைப்போலாக்குகிறார்.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"உத்தமர்கள் அதைக்கண்டு மகிழுவார்கள்;","poem":1},{"lineBreak":true},{"text":"நியாயக்கேடெல்லாம் தன்னுடைய வாயை மூடும்.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"எவன் ஞானமுள்ளவனோ அவன் இவைகளைக் கவனிக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"ஞானவான்கள் யெகோவாவுடைய கிருபைகளை உணர்ந்துகொள்வார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}