{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["தாவீது பாடிய பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, என்னுடைய இருதயம் ஆயத்தமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"நான் இன்னிசையால் புகழ்ந்து பாடுவேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய மகிமையும் பாடும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"வீணையே, சுரமண்டலமே, விழியுங்கள்,","poem":1},{"lineBreak":true},{"text":"நான் அதிகாலையில் விழிப்பேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே, மக்களுக்குள்ளே உம்மைத் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"தேசங்களுக்குள்ளே உம்மைப் புகழ்ந்து பாடுவேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உமது கிருபை வானங்களுக்கு மேலாகவும்,","poem":1},{"lineBreak":true},{"text":"உமது சத்தியம் மேகமண்டலங்கள் வரையிலும் எட்டுகிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவனே, வானங்களுக்கு மேலாக உயர்ந்திரும்;","poem":1},{"lineBreak":true},{"text":"உமது மகிமை பூமியனைத்தின்மேலும் உயர்ந்திருப்பதாக.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உமது பிரியர்கள் விடுவிக்கப்படுவதற்காக,","poem":1},{"lineBreak":true},{"text":"உமது வலதுகரத்தினால் இரட்சித்து,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய ஜெபத்தைக் கேட்டருளும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவன் தமது பரிசுத்தத்தைக்கொண்டு சொன்னார்,","poem":1},{"lineBreak":true},{"text":"ஆகையால் சந்தோஷப்படுவேன்;","poem":1},{"lineBreak":true},{"text":"சீகேமைப் பங்கிட்டு, சுக்கோத்தின் பள்ளத்தாக்கை அளந்துகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"கீலேயாத் என்னுடையது, மனாசேயும் என்னுடையது;","poem":1},{"lineBreak":true},{"text":"எப்பிராயீம் என்னுடைய தலையின் பெலன்,","poem":1},{"lineBreak":true},{"text":"யூதா என்னுடைய செங்கோல்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மோவாப் என்னுடைய பாதம் கழுவும் பாத்திரம்;","poem":1},{"lineBreak":true},{"text":"ஏதோமின்மேல் என்னுடைய காலணியை எறிவேன்;","poem":1},{"lineBreak":true},{"text":"பெலிஸ்தியாவின்மேல் ஆர்ப்பரிப்பேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"வலுவான நகரத்திற்குள் என்னை நடத்திக்கொண்டு போகிறவன் யார்?","poem":1},{"lineBreak":true},{"text":"ஏதோம்வரை எனக்கு வழிகாட்டுகிறவன் யார்?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"எங்களுடைய சேனைகளோடு புறப்படாமலிருந்த தேவனே நீரல்லவோ?","poem":1},{"lineBreak":true},{"text":"எங்களைத் தள்ளிவிட்டிருந்த தேவனே நீரல்லவோ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"இக்கட்டில் எங்களுக்கு உதவிசெய்யும்;","poem":1},{"lineBreak":true},{"text":"மனிதனுடைய உதவி வீண்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவனாலே வெற்றி பெறுவோம்;","poem":1},{"lineBreak":true},{"text":"அவரே எங்களுடைய எதிரிகளை மிதித்துப்போடுவார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}