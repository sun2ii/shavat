{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["இராகத்தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"நான் துதிக்கும் தேவனே,","poem":1},{"lineBreak":true},{"text":"மவுனமாக இருக்கவேண்டாம்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுடைய வாயும், வஞ்சகவாயும்,","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாகத் திறந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"பொய் நாவினால் என்னோடு பேசுகிறார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பகையுண்டாக்கும் வார்த்தைகளால் என்னைச் சூழ்ந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"காரணமில்லாமல் என்னோடு போர்செய்கிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய அன்புக்கு பதிலாக என்னை விரோதிக்கிறார்கள்,","poem":1},{"lineBreak":true},{"text":"நானோ ஜெபம் செய்து கொண்டிருக்கிறேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நன்மைக்குப் பதிலாக எனக்குத் தீமைசெய்கிறார்கள்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய அன்புக்குப் பதிலாக என்னைப் பகைக்கிறார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவனுக்கு மேலாகத் தீயவனை ஏற்படுத்தி வையும்,","poem":1},{"lineBreak":true},{"text":"சாத்தான் அவனுடைய வலதுபக்கத்தில் நிற்கட்டும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவனுடைய நியாயம் விசாரிக்கப்படும்போது குற்றவாளியாகட்டும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய ஜெபம் பாவமாகட்டும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவனுடைய நாட்கள் கொஞ்சமாகட்டும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய வேலையை வேறொருவன் பெறட்டும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவனுடைய பிள்ளைகள் திக்கற்றவர்களும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய மனைவி விதவையுமாகட்டும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவனுடைய பிள்ளைகள் அலைந்து திரிந்து பிச்சையெடுத்து,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய பாழான வீடுகளிலிருந்து பிச்சை எடுக்கட்டும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"கடன் கொடுத்தவன் அவனுக்கு உள்ளதெல்லாவற்றையும் அபகரித்துக்கொள்ளட்டும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய உழைப்பின் பலனை அந்நியர்கள் பறித்துக்கொள்ளட்டும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவனுக்கு ஒருவரும் இரக்கங்காட்டாமலும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய திக்கற்ற பிள்ளைகளுக்குத் தயவு செய்யாமல் போகட்டும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவனுடைய சந்ததியார் அழிக்கப்படட்டும்;","poem":1},{"lineBreak":true},{"text":"இரண்டாம் தலைமுறையில் அவர்களுடைய பெயர் இல்லாமல் போகட்டும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவனுடைய முன்னோர்களின் அக்கிரமம் யெகோவாவுக்கு முன்பாக நினைக்கப்படட்டும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய தாயின் பாவம் நீங்காமலிருக்கட்டும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவைகள் எப்பொழுதும் யெகோவாவுக்கு முன்பாக இருக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய பெயர் பூமியில் இல்லாமல் அழிக்கப்படட்டும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவன் தயவுசெய்ய நினைக்காமல்,","poem":1},{"lineBreak":true},{"text":"ஏழையும், தேவையுள்ளவனுமாகிய மனிதனைத் துன்பப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"மனமுறிவுள்ளவனைக் கொலைசெய்யும்படி தேடினானே.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"சாபத்தை விரும்பினான், அது அவனுக்கு வரும்;","poem":1},{"lineBreak":true},{"text":"அவன் ஆசீர்வாதத்தை விரும்பாமற்போனான்,","poem":1},{"lineBreak":true},{"text":"அது அவனுக்குத் தூரமாக விலகிப்போகும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"சாபத்தை அவன் தனக்கு ஆடையாக உடுத்திக்கொண்டான்;","poem":1},{"lineBreak":true},{"text":"அது அவனுடைய உள்ளத்தில் தண்ணீரைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய எலும்புகளில் எண்ணெயைப்போலவும் பாயும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அது அவன் போர்த்துக்கொள்ளுகிற ஆடையாகவும்,","poem":1},{"lineBreak":true},{"text":"எப்பொழுதும் கட்டிக்கொள்ளுகிற வார்க்கச்சையாகவும் இருக்கட்டும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"இதுதான் என்னை விரோதிக்கிறவர்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவுக்கு விரோதமாகத் தீங்கு பேசுகிறவர்களுக்கும் யெகோவாவால் வரும் பிரதிபலன்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ஆண்டவராகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நீர் உமது பெயரினிமித்தம் என்னை ஆதரித்து,","poem":1},{"lineBreak":true},{"text":"உமது கிருபை நலமானதினால்,","poem":1},{"lineBreak":true},{"text":"என்னை விடுவித்தருளும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நான் ஏழையும் தேவையுள்ளவனுமாக இருக்கிறேன்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயம் எனக்குள் புண்பட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"சாயும் நிழலைப்போல் அகன்றுபோனேன்;","poem":1},{"lineBreak":true},{"text":"வெட்டுக்கிளியைப்போல் பறக்கடிக்கப்படுகிறேன்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"உபவாசத்தினால் என்னுடைய முழங்கால்கள் பலவீனமடைகிறது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய சரீரமும் பலமற்று உலர்ந்து போகிறது.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"நான் அவர்களுக்கு நிந்தையானேன்; அவர்கள் என்னைப் பார்த்து,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய தலையை அசைக்கிறார்கள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவாவே எனக்கு உதவிசெய்யும்;","poem":1},{"lineBreak":true},{"text":"உமது கிருபையின்படி என்னைக் காப்பாற்றும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"இது உமது கரம் என்றும், யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"தேவனே நீர் இதைச் செய்தீர் என்றும், அவர்கள் அறிவார்களாக.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அவர்கள் சபித்தாலும், நீர் ஆசீர்வதியும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் எழும்பினாலும் வெட்கப்பட்டுப்போகட்டும்;","poem":1},{"lineBreak":true},{"text":"உமது அடியானோ மகிழ்சியாக இருப்பேன்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"என்னுடைய விரோதிகள் அவமானத்தால் மூடப்பட்டு,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய வெட்கத்தைச் சால்வையைப்போல் அணிந்துக்கொள்வார்களாக.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"யெகோவாவை நான் என்னுடைய வாயினால் மிகவும் துதித்து,","poem":1},{"lineBreak":true},{"text":"அநேகர் நடுவிலே அவரைப் புகழுவேன்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"தண்டனைக்குள்ளாகத் தீர்க்கிறவர்களிடம் ஒடுக்கப்பட்டவனுடைய ஆத்துமாவை காப்பாற்றும்படி","poem":1},{"lineBreak":true},{"text":"அவர் அவனுடைய வலதுபக்கத்தில் நிற்பார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}