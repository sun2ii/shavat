{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"நான் யெகோவாவிடம் அடைக்கலமாக வந்திருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"பின்னை ஏன் நீங்கள் என்னுடைய ஆத்துமாவை நோக்கி,","poem":1},{"lineBreak":true},{"text":"பறவையைப்போல உன்னுடைய மலைக்குப் பறந்துபோ என்று சொல்லுகிறீர்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"இதோ, துன்மார்க்கர்கள் வில்லை வளைத்து,","poem":1},{"lineBreak":true},{"text":"செம்மையான இருதயத்தார்கள்மேல் இருளில் எய்யும்படி தங்களுடைய அம்புகளை நாணிலே தொடுக்கிறார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அஸ்திபாரங்களும் அழிந்துபோகின்றதே,","poem":1},{"lineBreak":true},{"text":"நீதிமான் என்ன செய்வான்?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவா தம்முடைய பரிசுத்த ஆலயத்தில் இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய சிங்காசனம் பரலோகத்தில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவருடைய கண்கள் தேவப்பிள்ளைகளைப் பார்க்கின்றன அவருடைய இமைகள் அவர்களைச் சோதித்தறிகின்றன.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவா நீதிமானைச் சோதித்தறிகிறார்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கனையும் கொடுமையில் பிரியமுள்ளவனையும் அவருடைய உள்ளம் வெறுக்கிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள்மேல் கண்ணிகளை பொழியச்செய்வார்;","poem":1},{"lineBreak":true},{"text":"நெருப்பும், கந்தகமும்,","poem":1},{"lineBreak":true},{"text":"அனல் காற்றும் அவர்கள் குடிக்கும் பாத்திரத்தின் பங்கு.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவா நீதியுள்ளவர், நீதியின்மேல் பிரியப்படுவார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய முகம் செம்மையானவனை நோக்கியிருக்கிறது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}