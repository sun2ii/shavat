{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா என் ஆண்டவரை நோக்கி:","poem":1},{"lineBreak":true},{"text":"நான் உம்முடைய எதிரிகளை உம்முடைய பாதத்தின்கீழ் போடும்வரைக்கும்,","poem":1},{"lineBreak":true},{"text":"நீர் என்னுடைய வலதுபக்கத்தில் உட்காரும் என்றார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா சீயோனிலிருந்து உமது வல்லமையின் செங்கோலை அனுப்புவார்;","poem":1},{"lineBreak":true},{"text":"நீர் உம்முடைய எதிரிகளின் நடுவே ஆளுகைசெய்யும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உமது மகத்துவத்தின் நாளிலே","poem":1},{"lineBreak":true},{"text":"உம்முடைய மக்கள் மனப்பூர்வமும் பரிசுத்த அலங்காரம் உள்ளவர்களாக இருப்பார்கள்;","poem":1},{"lineBreak":true},{"text":"அதிகாலையின் கர்ப்பத்தில் பிறக்கும் பனிக்குச் சமமாக உம்முடைய மக்கள் உமக்குப் பிறப்பார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நீர் மெல்கிசேதேக்கின் முறைமையின்படி","poem":1},{"lineBreak":true},{"text":"என்றென்றைக்கும் ஆசாரியராக இருக்கிறீர் என்று யெகோவா ஆணையிட்டார்;","poem":1},{"lineBreak":true},{"text":"மனம் மாறாமலுமிருப்பார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்முடைய வலதுபக்கத்திலிருக்கிற ஆண்டவர்,","poem":1},{"lineBreak":true},{"text":"தமது கோபத்தின் நாளிலே ராஜாக்களை வெட்டுவார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் தேசங்களுக்குள் நியாயந்தீர்ப்பார்;","poem":1},{"lineBreak":true},{"text":"எல்லா இடங்களையும் பிரேதங்களால் நிரப்புவார்;","poem":1},{"lineBreak":true},{"text":"அநேக தேசங்களின்மேல் தலைவர்களாக இருக்கிறவர்களை நொறுக்கிப்போடுவார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"வழியிலே அவர் நதியில் குடிப்பார்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் அவர் தமது தலையை எடுப்பார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}