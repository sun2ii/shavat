{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா,","poem":1},{"lineBreak":true},{"text":"செம்மையானவர்களுடைய கூட்டத்திலும் சபையிலும் யெகோவாவை முழு இருதயத்தோடும் துதிப்பேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவின் செய்கைகள் பெரியவைகளும்,","poem":1},{"lineBreak":true},{"text":"அவைகளில் பிரியப்படுகிற எல்லோராலும் ஆராயப்படுகிறவைகளுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவருடைய செயல் மகிமையும் மகத்துவமுமுள்ளது,","poem":1},{"lineBreak":true},{"text":"அவருடைய நீதி என்றென்றைக்கும் நிற்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய அதிசயமான செயல்களை நினைவுகூரும்படி செய்தார்,","poem":1},{"lineBreak":true},{"text":"யெகோவா இரக்கமும் மனவுருக்கமுமுள்ளவர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தமக்குப் பயந்தவர்களுக்கு உணவு கொடுத்தார்;","poem":1},{"lineBreak":true},{"text":"தமது உடன்படிக்கையை என்றென்றைக்கும் நினைப்பார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தேசங்களின் சுதந்தரத்தைத் தமது மக்களுக்குக் கொடுத்ததினால்,","poem":1},{"lineBreak":true},{"text":"தமது செயல்களின் பெலத்தை அவர்களுக்குத் தெரியப்படுத்தினார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவருடைய கரத்தின் செயல்கள் சத்தியமும் நியாயமுமானவைகள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய கட்டளைகளெல்லாம் உண்மையானவைகள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவைகள் என்றென்றைக்குமுள்ள எல்லாகாலங்களுக்கும் உறுதியானவைகள்,","poem":1},{"lineBreak":true},{"text":"அவைகள் உண்மையும் செம்மையுமாகச் செய்யப்பட்டவைகள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் தமது மக்களுக்கு மீட்பை அனுப்பி,","poem":1},{"lineBreak":true},{"text":"தமது உடன்படிக்கையை நிரந்தர உடன்படிக்கையாகக் கட்டளையிட்டார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய பெயர் பரிசுத்தமும் பயங்கரமுமானது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதலே ஞானத்தின் ஆரம்பம்;","poem":1},{"lineBreak":true},{"text":"அவருடைய கற்பனைகளின்படி செய்கிற அனைவருக்கும் நற்புத்தியுண்டு;","poem":1},{"lineBreak":true},{"text":"அவருடைய புகழ்ச்சி என்றைக்கும் நிற்கும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}