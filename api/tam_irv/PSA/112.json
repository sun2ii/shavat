{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா, யெகோவாவுக்குப் பயந்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய கட்டளைகளில் மிகவும் பிரியமாயிருக்கிற மனிதன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவன் சந்ததிகள் பூமியில் பலத்திருக்கும்,","poem":1},{"lineBreak":true},{"text":"செம்மையானவர்களின் வம்சம் ஆசீர்வதிக்கப்படும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"செழிப்பும் செல்வமும் அவனுடைய வீட்டிலிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய நீதி என்றைக்கும் நிற்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"செம்மையானவர்களுக்கு இருளிலே வெளிச்சம் உதிக்கும்;","poem":1},{"lineBreak":true},{"text":"அவன் இரக்கமும் மனவுருக்கமும் நீதியுமுள்ளவன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"இரங்கிக் கடன்கொடுத்து, தன்னுடைய காரியங்களை நியாயமானபடி நடத்துகிற மனிதன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவன் என்றென்றைக்கும் அசைக்கப்படாதிருப்பான்;","poem":1},{"lineBreak":true},{"text":"நீதிமான் என்றென்றும் புகழுள்ளவன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"துர்ச்செய்தியைக் கேட்கிறதினால் பயப்படமாட்டான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய இருதயம் யெகோவாவை நம்பித் திடனாயிருக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவனுடைய இருதயம் உறுதியாயிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவன் தன்னுடைய எதிரிகளில் சரிக்கட்டுதலைக் காணும்வரை பயப்படாமலிருப்பான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வாரியிறைத்தான், ஏழைகளுக்குக் கொடுத்தான், அவனுடைய நீதி என்றென்றைக்கும் நிற்கும்;","poem":1},{"lineBreak":true},{"text":"அவன் கொம்பு மகிமையாக உயர்த்தப்படும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் அதைக் கண்டு மனச்சோர்வாகி,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய பற்களைக் கடித்துக் கரைந்துபோவான்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய ஆசை அழியும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}