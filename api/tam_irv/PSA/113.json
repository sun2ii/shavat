{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா, யெகோவாவுடைய ஊழியக்காரர்களே, துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய பெயரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"இதுமுதல் என்றென்றைக்கும் யெகோவாவுடைய பெயர் ஸ்தோத்திரிக்கப்படுவதாக.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"சூரியன் உதிக்கும் திசைதொடங்கி","poem":1},{"lineBreak":true},{"text":"அது மறையும் திசைவரை யெகோவாவுடைய பெயர் துதிக்கப்படட்டும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவா எல்லா தேசங்கள்மேலும் உயர்ந்தவர்;","poem":1},{"lineBreak":true},{"text":"அவருடைய மகிமை வானங்களுக்கு மேலானது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உன்னதங்களில் வாழ்கிற நம்முடைய தேவனாகிய யெகோவாவுக்குச் சமமானமானவர் யார்?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் வானத்திலிருந்து பூமியிலுமுள்ளவைகளைப் பார்க்கும்படி தம்மைத் தாழ்த்துகிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் சிறியவனைப் புழுதியிலிருந்து தூக்கிவிடுகிறார்;","poem":1},{"lineBreak":true},{"text":"ஏழ்மையானவனைக் குப்பையிலிருந்து உயர்த்துகிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவனைப் பிரபுக்களோடும்,","poem":1},{"lineBreak":true},{"text":"தமது மக்களின் அதிபதிகளோடும் உட்காரச்செய்கிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மலடியைச் சந்தோஷமான பிள்ளைத்தாய்ச்சியாக்கி,","poem":1},{"lineBreak":true},{"text":"வீட்டிலே குடியிருக்கச்செய்கிறார்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}