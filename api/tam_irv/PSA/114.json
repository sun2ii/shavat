{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"இஸ்ரவேல் எகிப்திலும், யாக்கோபின் வீட்டார் அந்நிய மக்களிடமிருந்து புறப்பட்டபோது,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யூதா அவருக்குப் பரிசுத்த இடமும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேல் அவருக்கு இராஜ்ஜியமுமானது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"கடல் கண்டு விலகி ஓடினது;","poem":1},{"lineBreak":true},{"text":"யோர்தான் பின்னிட்டுத் திரும்பினது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மலைகள் ஆட்டுக்கடாக்களைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"குன்றுகள் ஆட்டுக்குட்டிகளைப்போலவும் துள்ளினது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"கடலே, நீ விலகியோடுகிறதற்கும்;","poem":1},{"lineBreak":true},{"text":"யோர்தானே, நீ பின்னாக திரும்புகிறதற்கும்;","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மலைகளே, நீங்கள் ஆட்டுக்கடாக்களைப்போலவும்; குன்றுகளே,","poem":1},{"lineBreak":true},{"text":"நீங்கள் ஆட்டுக்குட்டிகளைப்போலவும் துள்ளுகிறதற்கும்,","poem":1},{"lineBreak":true},{"text":"உங்களுக்கு என்ன வந்தது?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"பூமியே, நீ ஆண்டவருக்கு முன்பாகவும்,","poem":1},{"lineBreak":true},{"text":"யாக்கோபுடைய தேவனுக்கு முன்பாகவும் அதிரு.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் கன்மலையைத் தண்ணீர் குளமாகவும்,","poem":1},{"lineBreak":true},{"text":"கற்பாறையை நீரூற்றுகளாகவும் மாற்றுகிறார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}