{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":115,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"எங்களுக்கு அல்ல, யெகோவாவே, எங்களுக்கு அல்ல,","poem":1},{"lineBreak":true},{"text":"உமது கிருபையினிமித்தமும் உமது சத்தியத்தினிமித்தமும், உம்முடைய பெயருக்கே மகிமை வரச்செய்யும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர்களுடைய தேவன் இப்பொழுது எங்கே","poem":1},{"lineBreak":true},{"text":"என்று தேசங்கள் ஏன் சொல்லவேண்டும்?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நம்முடைய தேவன் பரலோகத்தில் இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"தமக்குச் சித்தமான அனைத்தையும் செய்கிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர்களுடைய சிலைகள் வெள்ளியும் பொன்னும்,","poem":1},{"lineBreak":true},{"text":"மனிதர்களுடைய கைவேலையுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவைகளுக்கு வாயிருந்தும் பேசாது;","poem":1},{"lineBreak":true},{"text":"அவைகளுக்குக் கண்களிருந்தும் காணாது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவைகளுக்குக் காதுகளிருந்தும் கேட்காது;","poem":1},{"lineBreak":true},{"text":"அவைகளுக்கு மூக்கிருந்தும் முகராது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவைகளுக்குக் கைகளிருந்தும் தொடாது;","poem":1},{"lineBreak":true},{"text":"அவைகளுக்குக் கால்களிருந்தும் நடக்காது;","poem":1},{"lineBreak":true},{"text":"தங்களுடைய தொண்டையால் சத்தமிடவும் மாட்டாது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவைகளைச் செய்கிறவர்களும், அவைகளை நம்புகிறவர்கள் அனைவரும்,","poem":1},{"lineBreak":true},{"text":"அவைகளைப்போலவே இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"இஸ்ரவேலே, யெகோவாவை நம்பு;","poem":1},{"lineBreak":true},{"text":"அவரே அவர்களுக்குத் துணையும் அவர்களுக்குக் கேடகமுமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆரோன் குடும்பத்தாரே, யெகோவாவை நம்புங்கள்;","poem":1},{"lineBreak":true},{"text":"அவரே அவர்களுக்குத் துணையும் அவர்களுக்குக் கேடகமுமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிறவர்களே,","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நம்புங்கள்; அவரே அவர்களுக்குத் துணையும் அவர்களுக்குக் கேடகமுமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவா நம்மை நினைத்திருக்கிறார்,","poem":1},{"lineBreak":true},{"text":"அவர் ஆசீர்வதிப்பார்; இஸ்ரவேல் குடும்பத்தார்களை ஆசீர்வதிப்பார்,","poem":1},{"lineBreak":true},{"text":"அவர் ஆரோன் குடும்பத்தார்களை ஆசீர்வதிப்பார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிற பெரியோர்களையும்,","poem":1},{"lineBreak":true},{"text":"சிறியோர்களையும் ஆசீர்வதிப்பார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவா உங்களையும் உங்களுடைய பிள்ளைகளையும் பெருகச்செய்வார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"வானத்தையும் பூமியையும் படைத்த யெகோவாவாலே நீங்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"வானங்கள் யெகோவாவுடையவைகள்;","poem":1},{"lineBreak":true},{"text":"பூமியையோ மனிதர்களுக்குக் கொடுத்தார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"இறந்தவர்களும் மவுனத்தில் இறங்குகிற அனைவரும்","poem":1},{"lineBreak":true},{"text":"யெகோவாவை துதிக்கமாட்டார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நாமோ, இதுமுதல் என்றென்றைக்கும்","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்கு நன்றிசொல்லுவோம்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}