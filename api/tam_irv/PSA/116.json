{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா என்னுடைய சத்தத்தையும் என்னுடைய விண்ணப்பத்தையும் கேட்டதினால்,","poem":1},{"lineBreak":true},{"text":"அவரில் அன்புகூருகிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர் தமது செவியை எனக்குச் சாய்த்தபடியால்,","poem":1},{"lineBreak":true},{"text":"நான் உயிரோடிருக்கும்வரை அவரைத் தொழுதுகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மரணக்கட்டுகள் என்னைச் சுற்றிக்கொண்டது,","poem":1},{"lineBreak":true},{"text":"பாதாளக் கண்ணிகள் என்னைப் பிடித்தது; கவலையும் துன்பமும் அடைந்தேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அப்பொழுது நான் யெகோவாவுடைய பெயரைத் தொழுதுகொண்டு:","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய ஆத்துமாவை விடுவியும் என்று கெஞ்சினேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவா கிருபையும் நீதியுமுள்ளவர்,","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேவன் மனவுருக்கம் உள்ளவர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா கபடற்றவர்களைக் காக்கிறார்;","poem":1},{"lineBreak":true},{"text":"நான் மெலிந்துபோனேன்,","poem":1},{"lineBreak":true},{"text":"அவர் என்னைப் பாதுகாத்தார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என் ஆத்துமாவே, யெகோவா உனக்கு நன்மை செய்தபடியால்,","poem":1},{"lineBreak":true},{"text":"நீ உன்னுடைய இளைப்பாறுதலுக்குத் திரும்பு.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என் ஆத்துமாவை மரணத்திற்கும், என் கண்ணைக் கண்ணீருக்கும்,","poem":1},{"lineBreak":true},{"text":"என் காலை இடறுதலுக்கும் தப்புவித்தீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நான் யெகோவாவுக்கு முன்பாக உயிருள்ளவர்கள் தேசத்திலே நடப்பேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"விசுவாசித்தேன், ஆகையால் பேசுகிறேன்;","poem":1},{"lineBreak":true},{"text":"நான் மிகவும் வருத்தப்பட்டேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"எந்த மனிதனும் பொய்யன் என்று என்னுடைய மனக்கலக்கத்திலே சொன்னேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவா எனக்குச் செய்த எல்லா உதவிகளுக்காகவும், அவருக்கு என்னத்தைச் செலுத்துவேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"இரட்சிப்பின் பாத்திரத்தை எடுத்துக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய பெயரைத் தொழுதுகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நான் யெகோவாவுக்குச் செய்த பொருத்தனைகளை","poem":1},{"lineBreak":true},{"text":"அவருடைய மக்களெல்லோருக்கும் முன்பாகவும் செலுத்துவேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய பரிசுத்தவான்களின் மரணம் அவருடைய பார்வைக்கு அருமையானது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நான் உமது அடியேன்;","poem":1},{"lineBreak":true},{"text":"நான் உமது அடியாளின் மகனும், உமது ஊழியக்காரனுமாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கட்டுகளை அவிழ்த்துவிட்டீர்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நான் உமக்கு நன்றிபலியைச் செலுத்தி,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய பெயரைத் தொழுதுகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நான் யெகோவாவுக்குச் செய்த பொருத்தனைகளை","poem":1},{"lineBreak":true},{"text":"அவருடைய மக்களெல்லோருக்கும் முன்பாகவும்,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய ஆலயத்தின் முற்றங்களிலும்,","poem":1},{"lineBreak":true},{"text":"எருசலேமே உன்னுடைய நடுவிலும் நிறைவேற்றுவேன்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}