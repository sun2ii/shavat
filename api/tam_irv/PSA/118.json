{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவை துதியுங்கள், அவர் நல்லவர்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளதென்று இஸ்ரவேல் சொல்வார்களாக.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளதென்று, ஆரோனின் குடும்பத்தார் சொல்வார்களாக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளதென்று,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிறவர்கள் சொல்வார்களாக.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நெருக்கத்திலிருந்து யெகோவாவை நோக்கிக் கூப்பிட்டேன்,","poem":1},{"lineBreak":true},{"text":"யெகோவா என்னைக் கேட்டருளி விசாலத்திலே வைத்தார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா என்னோடு இருக்கிறார், நான் பயப்படமாட்டேன்;","poem":1},{"lineBreak":true},{"text":"மனிதன் எனக்கு என்ன செய்வான்?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"எனக்கு உதவி செய்கிறவர்கள் நடுவில் யெகோவா என்னோடு இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகளில் சரிக்கட்டுதலைக் காண்பேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மனிதனை நம்புவதைவிட,","poem":1},{"lineBreak":true},{"text":"யெகோவா மேல் பற்றுதலாயிருப்பதே நலம்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"பிரபுக்களை நம்புவதைவிட யெகோவா மேல் பற்றுதலாயிருப்பதே நலம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எல்லா தேசத்தாரும் என்னை வளைந்துகொள்ளுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய பெயரினால் அவர்களை அழிப்பேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னைச் சுற்றிலும் வளைந்து கொள்ளுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய பெயரினால் அவர்களை அழிப்பேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தேனீக்களைப்போல என்னை வளைந்துகொள்ளுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"முள்ளில் பற்றின நெருப்பைப்போல அணைந்து போவார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய பெயரினால் அவர்களை அழிப்பேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நான் விழும்படி நீ என்னைத் தள்ளினாய்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவோ எனக்கு உதவி செய்தார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவா என்னுடைய பெலனும், என்னுடைய பாடலுமானவர்;","poem":1},{"lineBreak":true},{"text":"அவர் எனக்கு இரட்சிப்புமானார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நீதிமான்களுடைய கூடாரங்களில் இரட்சிப்பின் கெம்பீர சத்தம் உண்டு;","poem":1},{"lineBreak":true},{"text":"யெகோவாவின் வலதுகரம் பராக்கிரமஞ்செய்யும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"யெகோவாவின் வலதுகரம் உயர்ந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவின் வலதுகரம் பராக்கிரமஞ்செய்யும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நான் சாகாமல், பிழைத்திருந்து,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய செய்கைகளை விவரிப்பேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"யெகோவா என்னைக் கடினமாகத் தண்டித்தும்,","poem":1},{"lineBreak":true},{"text":"என்னைச் சாவுக்கு ஒப்புக்கொடுக்கவில்லை.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"நீதியின் வாசல்களைத் திறவுங்கள்;","poem":1},{"lineBreak":true},{"text":"நான் அவைகளுக்குள் நுழைந்து யெகோவாவை துதிப்பேன்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"யெகோவாவின் வாசல் இதுவே;","poem":1},{"lineBreak":true},{"text":"நீதிமான்கள் இதற்குள் நுழைவார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"நீர் எனக்குச் செவிகொடுத்து, எனக்கு இரட்சிப்பாக இருந்தபடியால்,","poem":1},{"lineBreak":true},{"text":"நான் உம்மைத் துதிப்பேன்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"வீடுகட்டுகிறவர்கள் ஆகாதென்று தள்ளின கல்லே,","poem":1},{"lineBreak":true},{"text":"மூலைக்குத் தலைக்கல்லானது.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அது யெகோவாவாலே ஆனது,","poem":1},{"lineBreak":true},{"text":"அது நம்முடைய கண்களுக்கு ஆச்சரியமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"இது யெகோவா உண்டாக்கின நாள்;","poem":1},{"lineBreak":true},{"text":"இதிலே சந்தோஷப்பட்டு மகிழ்வோம்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"யெகோவாவே, இரட்சியும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, காரியத்தை வாய்க்கச்செய்யும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய பெயராலே வருகிறவர் ஸ்தோத்திரிக்கப்பட்டவர்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய ஆலயத்திலிருந்து","poem":1},{"lineBreak":true},{"text":"உங்களை ஆசீர்வதிக்கிறோம்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"யெகோவா நம்மைப் பிரகாசிக்கச்செய்கிற தேவனாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"பண்டிகைப் பலியைக் கொண்டுபோய் பலிபீடத்தின் கொம்புகளில் கயிறுகளால் கட்டுங்கள்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"நீர் என் தேவன், நான் உம்மைத் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"நீர் என் தேவன், நான் உம்மை உயர்த்துவேன்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"யெகோவாவை துதியுங்கள், அவர் நல்லவர்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}