{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":119,"content":[{"type":"hebrew_subtitle","content":["ஆலெப்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவுடைய வேதத்தின்படி","poem":1},{"lineBreak":true},{"text":"நடக்கிற உத்தம வழியில் நடப்பவர்கள் பாக்கியவான்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவருடைய சாட்சிகளைக் கைக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"அவரை முழு இருதயத்தோடும் தேடுகிறவர்கள் பாக்கியவான்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர்கள் அநியாயம் செய்வதில்லை;","poem":1},{"lineBreak":true},{"text":"அவருடைய வழிகளில் நடக்கிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உமது கட்டளைகளை நாங்கள் கருத்தாகக் கைக்கொள்ளும்படி","poem":1},{"lineBreak":true},{"text":"நீர் கற்றுக்கொடுத்தீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உமது பிரமாணங்களைக் கைக்கொள்ளும்படி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய நடைகள் நிலைத்திருந்தால் நலமாக இருக்கும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் உம்முடைய கற்பனைகளையெல்லாம் நினைக்கும்போது,","poem":1},{"lineBreak":true},{"text":"வெட்கப்பட்டுப்போவதில்லை.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உம்முடைய நீதிநியாயங்களை நான் கற்றுக்கொள்ளும்போது,","poem":1},{"lineBreak":true},{"text":"செம்மையான இருதயத்தால் உம்மைத் துதிப்பேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"உமது பிரமாணங்களைக் கைக்கொள்ளுவேன்;","poem":1},{"lineBreak":true},{"text":"முற்றிலும் என்னைக் கைவிடாமலிரும்.","poem":1},{"text":"பேத்.","descriptive":true}]},{"type":"verse","number":9,"content":[{"text":"வாலிபன் தன்னுடைய வழியை எதினால் சுத்தம்செய்வான்?","poem":1},{"lineBreak":true},{"text":"உமது வசனத்திற்குக் கீழ்படிகிறதினால்தானே.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என்னுடைய முழு இருதயத்தோடும் உம்மைத் தேடுகிறேன்,","poem":1},{"lineBreak":true},{"text":"என்னை உமது கற்பனைகளைவிட்டு வழிதவறிச் செல்ல விடாமலிரும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நான் உமக்கு விரோதமாகப் பாவஞ்செய்யாதபடிக்கு,","poem":1},{"lineBreak":true},{"text":"உமது வசனத்தை என் இருதயத்தில் வைத்து வைத்தேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் வாழ்த்திற்குரியவர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பிரமாணங்களை எனக்குப் போதியும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"உம்முடைய வசனத்தின் நியாயத்தீர்ப்புகளையெல்லாம் என்னுடைய உதடுகளால் விவரித்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"திரளான செல்வத்தில் சந்தோஷப்படுவதுபோல,","poem":1},{"lineBreak":true},{"text":"நான் உமது சாட்சிகளின் வழியில் சந்தோஷப்படுகிறேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"உமது கட்டளைகளைத் தியானித்து, உமது வழிகளை மனதில் வைக்கிறேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உமது பிரமாணங்களில் மனமகிழ்ச்சியாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"உமது வசனத்தை மறவேன்.","poem":1},{"text":"கிமெல்.","descriptive":true}]},{"type":"verse","number":17,"content":[{"text":"உமது அடியேனுக்கு அனுகூலமாக இரும்; அப்பொழுது நான் பிழைத்து,","poem":1},{"lineBreak":true},{"text":"உமது வசனத்தைக் கைக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"உமது வேதத்திலுள்ள அதிசயங்களை நான் பார்க்கும்படிக்கு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கண்களைத் திறந்தருளும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பூமியிலே நான் அந்நியன்;","poem":1},{"lineBreak":true},{"text":"உமது கற்பனைகளை எனக்கு மறையாமலிரும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"உமது நியாயங்கள்மேல் என் ஆத்துமா எந்தநேரமும் வைத்திருக்கிற வாஞ்சையினால் சோர்ந்துபோகிறது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"உமது கற்பனைகளை விட்டு வழிவிலகின சபிக்கப்பட்ட","poem":1},{"lineBreak":true},{"text":"பெருமையுள்ளவர்களை நீர் கடிந்துகொள்ளுகிறீர்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நிந்தையையும் அவமானத்தையும் என்னை விட்டு அகற்றும்;","poem":1},{"lineBreak":true},{"text":"நான் உம்முடைய சாட்சிகளுக்குக் கீழ்படிகிறேன்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அதிகாரிகளும் உட்கார்ந்து எனக்கு விரோதமாகப் பேசிக்கொள்ளுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"உமது ஊழியனோ, உமது பிரமாணங்களைத் தியானிக்கிறேன்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"உம்முடைய சாட்சிகள் எனக்கு இன்பமும்,","poem":1},{"lineBreak":true},{"text":"எனக்கு ஆலோசனை தருபவையாக இருக்கிறது.","poem":1},{"text":"டாலெத்.","descriptive":true}]},{"type":"verse","number":25,"content":[{"text":"என் ஆத்துமா மண்ணோடு ஒட்டிக்கொண்டிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உமது வசனத்தின்படி என்னை உயிர்ப்பியும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"என்னுடைய வழிகளை நான் உமக்கு விவரித்துக் காட்டினபோது","poem":1},{"lineBreak":true},{"text":"எனக்குச் செவிகொடுத்தீர்; உமது பிரமாணங்களை எனக்குப் போதியும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"உமது கட்டளைகளின் வழியை எனக்கு உணர்த்தியருளும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது உமது அதிசயங்களைத் தியானிப்பேன்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"துயரத்தால் என்னுடைய ஆத்துமா கரைந்து போகிறது;","poem":1},{"lineBreak":true},{"text":"உமது வசனத்தின்படி என்னை எடுத்து நிறுத்தும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"பொய்வழியை என்னைவிட்டு விலக்கி,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வேதத்தை எனக்கு அருள்செய்யும்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"மெய்வழியை நான் தெரிந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"உம்முடைய நியாயங்களை எனக்கு முன்பாக நிறுத்தினேன்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"உமது சாட்சிகள்மேல் பற்றுதலாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, என்னை வெட்கமடைய விடாமலிரும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"நீர் என்னுடைய இருதயத்தை விரிவாக்கும்போது,","poem":1},{"lineBreak":true},{"text":"நான் உமது கற்பனைகளின் வழியாக ஓடுவேன்.","poem":1},{"text":"எ.","descriptive":true}]},{"type":"verse","number":33,"content":[{"text":"யெகோவாவே, உமது பிரமாணங்களின் வழியை எனக்குப் போதியும்;","poem":1},{"lineBreak":true},{"text":"முடிவுவரை நான் அதைக் காத்துக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"எனக்கு உணர்வைத் தாரும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் உமது வேதத்தைப் பற்றிக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய முழு இருதயத்தோடும் அதைக் கைக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"உமது கற்பனைகளின் பாதையில் என்னை நடத்தும்;","poem":1},{"lineBreak":true},{"text":"நான் அதில் பிரியமாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயம் பொருளாசையைச் சார்ந்து இருக்காமல்,","poem":1},{"lineBreak":true},{"text":"உமது சாட்சிகளைச் சார்ந்து இருக்கும்படி செய்யும்.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"மாயையைப் பார்க்காதபடி நீர் என்னுடைய கண்களை விலக்கி,","poem":1},{"lineBreak":true},{"text":"உமது வழிகளில் என்னை உயிர்ப்பியும்.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"உமக்குப் பயப்படுகிறதற்கு ஏற்ற உமது வாக்குத்தத்தத்தை உமது அடியேனுக்கு உறுதிப்படுத்தும்.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"நான் பயப்படுகிற அவமானத்தை விலக்கியருளும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய நியாயத்தீர்ப்புகள் நல்லவைகள்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"இதோ, உம்முடைய கட்டளைகள்மேல் வாஞ்சையாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"உமது நீதியால் என்னை உயிர்ப்பியும்.","poem":1},{"text":"வௌ.","descriptive":true}]},{"type":"verse","number":41,"content":[{"text":"யெகோவாவே, உம்முடைய வாக்குத்தத்ததின்படி,","poem":1},{"lineBreak":true},{"text":"உமது தயவும் உமது இரட்சிப்பும் எனக்கு வருவதாக.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"அப்பொழுது என்னை நிந்திக்கிறவனுக்கு பதில் சொல்லுவேன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வசனத்தை நம்பியிருக்கிறேன்.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"சத்திய வசனம் முற்றிலும் என்னுடைய வாயிலிருந்து நீங்கவிடாமலிரும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய நியாயத்தீர்ப்புகளுக்குக் காத்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"நான் எப்பொழுதும் என்றைக்கும் உமது வேதத்தைக் காத்துக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"நான் உம்முடைய கட்டளைகளை ஆராய்கிறபடியால்,","poem":1},{"lineBreak":true},{"text":"அகலமான பாதையில் நடப்பேன்.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"நான் உம்முடைய சாட்சிகளைக் குறித்து,","poem":1},{"lineBreak":true},{"text":"ராஜாக்களுக்கு முன்பாகவும் வெட்கப்படாமல் பேசுவேன்.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"நான் பிரியப்படுகிற உமது கற்பனைகளில் மனமகிழ்ச்சியாக இருப்பேன்.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"நான் பிரியப்படுகிற உமது கற்பனைகளுக்குக் கையை உயர்த்துவேன்,","poem":1},{"lineBreak":true},{"text":"உமது பிரமாணங்களைத் தியானிப்பேன்.","poem":1},{"text":"சாயீன்.","descriptive":true}]},{"type":"verse","number":49,"content":[{"text":"நீர் என்னை நம்பச்செய்த வசனத்தை","poem":1},{"lineBreak":true},{"text":"உமது அடியேனுக்காக நினைத்தருளும்.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"அதுவே என்னுடைய துன்பத்தில் எனக்கு ஆறுதல்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வாக்குத்தத்தம் என்னை உயிர்ப்பித்தது.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"பெருமைக்காரர்கள் என்னை மிகவும் பரியாசம்செய்தும்,","poem":1},{"lineBreak":true},{"text":"நான் உமது வேதத்தைவிட்டு விலகினதில்லை.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"யெகோவாவே, ஆரம்பமுதலான உமது நியாயத்தீர்ப்புகளை","poem":1},{"lineBreak":true},{"text":"நான் நினைத்து என்னைத் தேற்றுகிறேன்.","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"உமது வேதத்தை விட்டு விலகுகிற துன்மார்க்கர்களின் நடுக்கம் என்னைப் பிடித்தது.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"நான் நிலையில்லாத குடியிருக்கும் வீட்டிலே","poem":1},{"lineBreak":true},{"text":"உமது பிரமாணங்கள் எனக்கு பாடல்களானது.","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"யெகோவாவே, இரவுநேரத்தில் உமது பெயரை நினைத்து,","poem":1},{"lineBreak":true},{"text":"உமது வேதத்தைக் கைக்கொள்ளுகிறேன்.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"நான் உமது கட்டளைகளைக் கைக்கொண்டதால்,","poem":1},{"lineBreak":true},{"text":"இது எனக்குக் கிடைத்தது.","poem":1},{"text":"ஹெத்.","descriptive":true}]},{"type":"verse","number":57,"content":[{"text":"யெகோவாவே, நீரே என்னுடைய பங்கு;","poem":1},{"lineBreak":true},{"text":"நான் உமது வசனங்களைக் கைக்கொள்ளுவேன் என்றேன்.","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"முழு இருதயத்தோடும் உம்முடைய தயவுக்காகக் கெஞ்சுகிறேன்;","poem":1},{"lineBreak":true},{"text":"உமது வாக்குத்தத்தத்தின்படி எனக்கு இரங்கும்.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"என்னுடைய வழிகளைச் சிந்தித்துக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கால்களை உம்முடைய சாட்சிகளுக்கு நேராகத் திருப்பினேன்.","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"உமது கற்பனைகளைக் கைக்கொள்ளும்படி,","poem":1},{"lineBreak":true},{"text":"நான் தாமதிக்காமல் விரைந்தேன்.","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களின் கூட்டங்கள் என்னைக் கொள்ளையிட்டும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வேதத்தை நான் மறக்கவில்லை.","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"உமது நீதியான நியாயத்தீர்ப்புகளுக்காக,","poem":1},{"lineBreak":true},{"text":"உம்மைத் துதிக்கும்படி பாதி இரவில் எழுந்திருப்பேன்.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"உமக்குப் பயந்து, உமது கட்டளைகளைக் கைக்கொள்ளுகிற அனைவருக்கும் நான் நண்பன்.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"யெகோவாவே, பூமி உமது கிருபையினால் நிறைந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உமது பிரமாணங்களை எனக்குப் போதியும்.","poem":1},{"text":"தேத்.","descriptive":true}]},{"type":"verse","number":65,"content":[{"text":"யெகோவாவே, உமது வசனத்தின்படி","poem":1},{"lineBreak":true},{"text":"உமது அடியேனை நன்றாக நடத்தினீர்.","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"உத்தம நிதானிப்பையும் அறிவையும் எனக்குப் போதித்தருளும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய கற்பனைகளில் நம்பிக்கையாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"நான் உபத்திரவப்படுவதற்கு முன்பு வழிதப்பி நடந்தேன்;","poem":1},{"lineBreak":true},{"text":"இப்பொழுதோ உம்முடைய வார்த்தையைக் காத்து நடக்கிறேன்.","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"தேவனே நீர் நல்லவரும், நன்மை செய்கிறவருமாக இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"உமது பிரமாணங்களை எனக்குப் போதியும்.","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"பெருமைக்காரர்கள் எனக்கு விரோதமாகப் பொய்களைப் பிணைக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நானோ, முழு இருதயத்தோடும் உம்முடைய கட்டளைகளைக் கைக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"அவர்களுடைய இருதயம் கொழுத்திருக்கிறது; நானோ,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வேதத்தில் மனமகிழ்ச்சியாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"நான் உபத்திரவப்பட்டது எனக்கு நல்லது;","poem":1},{"lineBreak":true},{"text":"அதினால் உமது பிரமாணங்களைக் கற்றுக்கொள்ளுகிறேன்.","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"அநேக ஆயிரம் பொன் வெள்ளியைவிட,","poem":1},{"lineBreak":true},{"text":"நீர் கொடுத்த வேதமே எனக்கு நலம்.","poem":1},{"text":"யோட்.","descriptive":true}]},{"type":"verse","number":73,"content":[{"text":"உம்முடைய கரங்கள் என்னை உண்டாக்கி,","poem":1},{"lineBreak":true},{"text":"என்னை உருவாக்கினது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கற்பனைகளைக் கற்றுக்கொள்ள என்னை உணர்வுள்ளவனாக்கும்.","poem":1}]},{"type":"verse","number":74,"content":[{"lineBreak":true},{"text":"நான் உம்முடைய வசனத்திற்குக் காத்திருக்கிறபடியால், உமக்குப் பயந்தவர்கள் என்னைக் கண்டு சந்தோஷப்படுவார்கள்.","poem":1}]},{"type":"verse","number":75,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது நியாயத்தீர்ப்புகள் நீதியுள்ளதென்றும்,","poem":1},{"lineBreak":true},{"text":"உண்மையின்படி என்னை உபத்திரவப்படுத்தினீரென்றும் அறிவேன்.","poem":1}]},{"type":"verse","number":76,"content":[{"lineBreak":true},{"text":"நீர் உமது அடியேனுக்குக் கொடுத்த உமது வாக்குத்தத்தத்தின்படி,","poem":1},{"lineBreak":true},{"text":"உமது கிருபை என்னைத் தேற்றட்டும்.","poem":1}]},{"type":"verse","number":77,"content":[{"lineBreak":true},{"text":"நான் பிழைத்திருக்கும்படிக்கு உமது இரக்கங்கள் எனக்குக் கிடைக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வேதம் என்னுடைய மனமகிழ்ச்சி.","poem":1}]},{"type":"verse","number":78,"content":[{"lineBreak":true},{"text":"பெருமைக்காரர்கள் என்னைப் பொய்களினால் கெடுக்கப் பார்த்தபடியால் வெட்கப்பட்டுப்போகட்டும்;","poem":1},{"lineBreak":true},{"text":"நானோ உமது கட்டளைகளைத் தியானிப்பேன்.","poem":1}]},{"type":"verse","number":79,"content":[{"lineBreak":true},{"text":"உமக்குப் பயந்து, உமது சாட்சிகளை அறிந்திருக்கிறவர்கள் என்னிடம் திரும்பட்டும்.","poem":1}]},{"type":"verse","number":80,"content":[{"lineBreak":true},{"text":"நான் வெட்கப்பட்டுப் போகாதபடிக்கு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயம் உமது பிரமாணங்களில் உத்தமமாக இருக்கட்டும்.","poem":1},{"text":"கப்.","descriptive":true}]},{"type":"verse","number":81,"content":[{"text":"உம்முடைய இரட்சிப்புக்கு என்னுடைய ஆத்துமா தவிக்கிறது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வசனத்திற்குக் காத்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":82,"content":[{"lineBreak":true},{"text":"எப்பொழுது என்னைத் தேற்றுவீர் என்று,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வாக்குத்தத்தத்தின்மேல் நோக்கமாக என்னுடைய கண்கள் பூத்துப்போகிறது.","poem":1}]},{"type":"verse","number":83,"content":[{"lineBreak":true},{"text":"புகையிலுள்ள தோல்பை போலானேன்;","poem":1},{"lineBreak":true},{"text":"உமது பிரமாணங்களையோ மறவேன்.","poem":1}]},{"type":"verse","number":84,"content":[{"lineBreak":true},{"text":"உமது அடியேனுடைய நாட்கள் எவ்வளவு?","poem":1},{"lineBreak":true},{"text":"என்னைத் துன்பப்படுத்துகிறவர்களுக்கு நீர் எப்பொழுது நியாயத்தீர்ப்பு செய்வீர்?","poem":1}]},{"type":"verse","number":85,"content":[{"lineBreak":true},{"text":"உம்முடைய வேதத்திற்கு விரோதமாக பெருமைக்காரர்கள் எனக்குக் குழிகளை வெட்டினார்கள்.","poem":1}]},{"type":"verse","number":86,"content":[{"lineBreak":true},{"text":"உம்முடைய கற்பனைகளெல்லாம் உண்மையாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அநியாயமாக என்னைத் துன்பப்படுத்துகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நீர் எனக்கு உதவி செய்யும்.","poem":1}]},{"type":"verse","number":87,"content":[{"lineBreak":true},{"text":"அவர்கள் என்னைப் பூமியில் இல்லாமல் நீக்கிவிடச் சற்றே தப்பினது;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் நான் உமது கட்டளைகளை விட்டுவிடவில்லை.","poem":1}]},{"type":"verse","number":88,"content":[{"lineBreak":true},{"text":"உமது கிருபையின்படியே என்னை உயிர்ப்பியும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் உம்முடைய வாக்குத்தத்தத்தின் சாட்சியைக் காத்து நடப்பேன்.","poem":1},{"text":"லாமேட்.","descriptive":true}]},{"type":"verse","number":89,"content":[{"text":"யெகோவாவே, உமது வசனம் என்றென்றைக்கும்","poem":1},{"lineBreak":true},{"text":"வானங்களில் நிலைத்திருக்கிறது.","poem":1}]},{"type":"verse","number":90,"content":[{"lineBreak":true},{"text":"உம்முடைய உண்மை தலைமுறை தலைமுறையாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"பூமியை உறுதிப்படுத்தினீர், அது நிலைத்திருக்கிறது.","poem":1}]},{"type":"verse","number":91,"content":[{"lineBreak":true},{"text":"உம்முடைய பிரமாணங்களை நிறைவேற்றும்படி அவைகள் இந்த நாள்வரைக்கும் நிற்கிறது;","poem":1},{"lineBreak":true},{"text":"அனைத்தும் உம்மைச் சேவிக்கும்.","poem":1}]},{"type":"verse","number":92,"content":[{"lineBreak":true},{"text":"உமது வேதம் என்னுடைய மனமகிழ்ச்சியாக இல்லாமலிருந்தால்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய துக்கத்திலே அழிந்துபோயிருப்பேன்.","poem":1}]},{"type":"verse","number":93,"content":[{"lineBreak":true},{"text":"நான் ஒருபோதும் உம்முடைய கட்டளைகளை மறக்கமாட்டேன்;","poem":1},{"lineBreak":true},{"text":"அவைகளால் நீர் என்னை உயிர்ப்பித்தீர்.","poem":1}]},{"type":"verse","number":94,"content":[{"lineBreak":true},{"text":"நான் உம்முடையவன், என்னை இரட்சியும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கட்டளைகளை ஆராய்கிறேன்.","poem":1}]},{"type":"verse","number":95,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் என்னை அழிக்கக் காத்திருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நான் உமது சாட்சிகளைச் சிந்தித்துக்கொண்டிருக்கிறேன்.","poem":1}]},{"type":"verse","number":96,"content":[{"lineBreak":true},{"text":"நிறைவான அனைத்திற்கும் எல்லையைக் கண்டேன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கற்பனையோ மகா பெரிது.","poem":1},{"text":"மேம்.","descriptive":true}]},{"type":"verse","number":97,"content":[{"text":"உமது வேதத்தில் நான் எவ்வளவு பிரியமாக இருக்கிறேன்!","poem":1},{"lineBreak":true},{"text":"நாள் முழுவதும் அது என்னுடைய தியானம்.","poem":1}]},{"type":"verse","number":98,"content":[{"lineBreak":true},{"text":"நீர் உம்முடைய கற்பனைகளைக் கொண்டு என்னை என்னுடைய எதிரிகளிலும் அதிக ஞானமுள்ளவனாக்குகிறீர்;","poem":1},{"lineBreak":true},{"text":"அவைகள் என்றைக்கும் என்னுடனே இருக்கிறது.","poem":1}]},{"type":"verse","number":99,"content":[{"lineBreak":true},{"text":"உம்முடைய சாட்சிகள் என்னுடைய தியானமாக இருக்கிறபடியால்,","poem":1},{"lineBreak":true},{"text":"எனக்குப் போதித்தவர்கள் எல்லோரிலும் அறிவுள்ளவனாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":100,"content":[{"lineBreak":true},{"text":"உம்முடைய கட்டளைகளை நான் கைக்கொண்டிருக்கிறபடியால்,","poem":1},{"lineBreak":true},{"text":"முதியோர்களைவிட ஞானமுள்ளவனாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":101,"content":[{"lineBreak":true},{"text":"உம்முடைய வசனத்தை நான் காத்து நடக்கும்படிக்கு,","poem":1},{"lineBreak":true},{"text":"எல்லா பொல்லாத வழிகளுக்கும் என்னுடைய கால்களை விலக்குகிறேன்.","poem":1}]},{"type":"verse","number":102,"content":[{"lineBreak":true},{"text":"நீர் எனக்குப் போதித்திருக்கிறபடியால்,","poem":1},{"lineBreak":true},{"text":"நான் உம்முடைய நியாயங்களை விட்டு விலகமாட்டேன்.","poem":1}]},{"type":"verse","number":103,"content":[{"lineBreak":true},{"text":"உம்முடைய வார்த்தைகள் என்னுடைய நாவுக்கு எவ்வளவு இனிமையானவைகள்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாய்க்கு அவைகள் தேனிலும்","poem":1},{"lineBreak":true},{"text":"இனிமையானதாக இருக்கும்.","poem":1}]},{"type":"verse","number":104,"content":[{"lineBreak":true},{"text":"உமது கட்டளைகளால் உணர்வடைந்தேன்,","poem":1},{"lineBreak":true},{"text":"ஆதலால் எல்லாப் பொய்வழிகளையும் வெறுக்கிறேன்.","poem":1},{"text":"நூன்.","descriptive":true}]},{"type":"verse","number":105,"content":[{"text":"உம்முடைய வசனம் என்னுடைய கால்களுக்குத் தீபமும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாதைக்கு வெளிச்சமுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":106,"content":[{"lineBreak":true},{"text":"உம்முடைய நீதி நியாயங்களைக் காத்து நடப்பேன் என்று ஆணையிட்டேன்;","poem":1},{"lineBreak":true},{"text":"அதை நிறைவேற்றுவேன்.","poem":1}]},{"type":"verse","number":107,"content":[{"lineBreak":true},{"text":"நான் மிகவும் உபத்திரவப்படுகிறேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய வசனத்தின்படியே என்னை உயிர்ப்பியும்.","poem":1}]},{"type":"verse","number":108,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய வாயின் உற்சாகபலிகளை நீர் ஏற்றுக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"உமது நியாயங்களை எனக்குப் போதித்தருளும்.","poem":1}]},{"type":"verse","number":109,"content":[{"lineBreak":true},{"text":"என்னுடைய உயிர் எப்பொழுதும் என்னுடைய கையில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் உம்முடைய வேதத்தை மறக்கமாட்டேன்.","poem":1}]},{"type":"verse","number":110,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் எனக்குக் கண்ணிவைக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் நான் உம்முடைய கட்டளைகளை விட்டு வழிதவறிப் போகமாட்டேன்.","poem":1}]},{"type":"verse","number":111,"content":[{"lineBreak":true},{"text":"உம்முடைய சாட்சிகளை நிரந்தர சுதந்தரமாக்கிக்கொண்டிருக்கிறேன்,","poem":1},{"lineBreak":true},{"text":"அவைகளே என்னுடைய இருதயத்தின் மகிழ்ச்சி.","poem":1}]},{"type":"verse","number":112,"content":[{"lineBreak":true},{"text":"முடிவுவரை இடைவிடாமல் உம்முடைய பிரமாணங்களின்படி செய்ய என்னுடைய இருதயத்தைச் சாய்த்தேன்.","poem":1},{"text":"சாமெக்.","descriptive":true}]},{"type":"verse","number":113,"content":[{"text":"வீண் சிந்தனைகளை நான் வெறுத்து, உமது வேதத்தில் பிரியப்படுகிறேன்.","poem":1}]},{"type":"verse","number":114,"content":[{"lineBreak":true},{"text":"என்னுடைய மறைவிடமும் என்னுடைய கேடகமும் நீரே;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வசனத்திற்குக் காத்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":115,"content":[{"lineBreak":true},{"text":"பொல்லாதவர்களே, என்னைவிட்டு அகன்றுபோங்கள்;","poem":1},{"lineBreak":true},{"text":"என் தேவனுடைய கற்பனைகளை நான் கைக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":116,"content":[{"lineBreak":true},{"text":"நான் பிழைத்திருப்பதற்கு உமது வார்த்தையின்படி என்னை ஆதரித்தருளும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய நம்பிக்கை வீணாகிப்போக என்னை வெட்கத்திற்கு உட்படுத்தாமல் இரும்.","poem":1}]},{"type":"verse","number":117,"content":[{"lineBreak":true},{"text":"என்னை ஆதரித்தருளும்; அப்பொழுது நான் இரட்சிக்கப்பட்டு,","poem":1},{"lineBreak":true},{"text":"எந்தநாளும் உம்முடைய பிரமாணங்களில் தியானமாக இருப்பேன்.","poem":1}]},{"type":"verse","number":118,"content":[{"lineBreak":true},{"text":"உமது பிரமாணங்களைவிட்டு வழிவிலகுகிற அனைவரையும் மிதித்துப் போடுகிறீர்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய சிந்தனை வஞ்சனையானது.","poem":1}]},{"type":"verse","number":119,"content":[{"lineBreak":true},{"text":"பூமியிலுள்ள துன்மார்க்கர்கள் அனைவரையும் துருவைப்போல அகற்றிவிடுகிறீர்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் உமது சாட்சிகளில் பிரியப்படுகிறேன்.","poem":1}]},{"type":"verse","number":120,"content":[{"lineBreak":true},{"text":"உமக்குப் பயப்படும் பயத்தால் என்னுடைய உடல் சிலிர்க்கிறது;","poem":1},{"lineBreak":true},{"text":"உமது நியாயத்தீர்ப்புகளுக்குப் பயப்படுகிறேன்.","poem":1},{"text":"ஆயின்.","descriptive":true}]},{"type":"verse","number":121,"content":[{"text":"நியாயமும் நீதியும் செய்கிறேன்; என்னை ஒடுக்குகிறவர்களுக்கு என்னை ஒப்புக்கொடாமல் இரும்.","poem":1}]},{"type":"verse","number":122,"content":[{"lineBreak":true},{"text":"உமது அடியேனுக்கு நன்மையாகத் துணைநில்லும்;","poem":1},{"lineBreak":true},{"text":"பெருமைக்காரர்கள் என்னை ஒடுக்கச்செய்யாதிரும்.","poem":1}]},{"type":"verse","number":123,"content":[{"lineBreak":true},{"text":"உமது இரட்சிப்புக்கும் உமது நீதியின் வார்த்தைகளுக்கும்","poem":1},{"lineBreak":true},{"text":"காத்திருக்கிறதினால் என்னுடைய கண்கள் பூத்துப்போகிறது.","poem":1}]},{"type":"verse","number":124,"content":[{"lineBreak":true},{"text":"உமது ஊழியனை உமது கிருபையின்படியே நடத்தி,","poem":1},{"lineBreak":true},{"text":"உமது பிரமாணங்களை எனக்குப் போதியும்.","poem":1}]},{"type":"verse","number":125,"content":[{"lineBreak":true},{"text":"நான் உமது ஊழியன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய சாட்சிகளை நான் அறியும்படி என்னை உணர்வுள்ளவனாக்கும்.","poem":1}]},{"type":"verse","number":126,"content":[{"lineBreak":true},{"text":"நீதியைச்செய்யக் யெகோவாவுக்கு வேளை வந்தது;","poem":1},{"lineBreak":true},{"text":"அவர்கள் உம்முடைய நியாயப்பிராணத்தை மீறினார்கள்.","poem":1}]},{"type":"verse","number":127,"content":[{"lineBreak":true},{"text":"ஆதலால் நான் பொன்னிலும் பசும்பொன்னிலும் அதிகமாக உமது கற்பனைகளில் பிரியப்படுகிறேன்.","poem":1}]},{"type":"verse","number":128,"content":[{"lineBreak":true},{"text":"எல்லாவற்றைப்பற்றியும் நீர் அருளின எல்லாக் கட்டளைகளும் செம்மையென்று எண்ணி,","poem":1},{"lineBreak":true},{"text":"அனைத்து பொய்வழிகளையும் வெறுக்கிறேன்.","poem":1},{"text":"பே.","descriptive":true}]},{"type":"verse","number":129,"content":[{"text":"உம்முடைய சாட்சிகள் அதிசயமானவைகள்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் என்னுடைய ஆத்துமா அவைகளைக் கைக்கொள்ளும்.","poem":1}]},{"type":"verse","number":130,"content":[{"lineBreak":true},{"text":"உம்முடைய வசனத்தின் விளக்கம் வெளிச்சம் தந்து,","poem":1},{"lineBreak":true},{"text":"பேதைகளை உணர்வுள்ளவர்களாக்கும்.","poem":1}]},{"type":"verse","number":131,"content":[{"lineBreak":true},{"text":"உம்முடைய கற்பனைகளை நான் விரும்புகிறபடியால்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாயை ஆவென்று திறந்து அவைகளுக்கு ஏங்குகிறேன்.","poem":1}]},{"type":"verse","number":132,"content":[{"lineBreak":true},{"text":"உம்முடைய பெயரை நேசிக்கிறவர்களுக்கு வழங்கும் நியாயத்தின்படியே என்னை நோக்கிப்பார்த்து, எனக்கு இரங்கும்.","poem":1}]},{"type":"verse","number":133,"content":[{"lineBreak":true},{"text":"உம்முடைய வார்த்தையிலே என்னுடைய காலடிகளை நிலைப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"ஒரு அநியாயமும் என்னை ஆட்கொள்ளச்செய்யாமல் இரும்.","poem":1}]},{"type":"verse","number":134,"content":[{"lineBreak":true},{"text":"மனிதர்கள் செய்யும் அநீதிகளுக்கு என்னை விலக்கி விடுவித்தருளும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் உம்முடைய கட்டளைகளைக் காத்துக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":135,"content":[{"lineBreak":true},{"text":"உமது ஊழியன்மேல் உமது முகத்தைப் பிரகாசிக்கச்செய்து,","poem":1},{"lineBreak":true},{"text":"உமது பிரமாணங்களை எனக்குப் போதியும்.","poem":1}]},{"type":"verse","number":136,"content":[{"lineBreak":true},{"text":"உம்முடைய வேதத்தை மனிதர்கள் காத்து நடக்காதபடியால்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கண்களிலிருந்து நீர்த்தாரைகள் ஓடுகிறது.","poem":1},{"text":"த்சாடே.","descriptive":true}]},{"type":"verse","number":137,"content":[{"text":"யெகோவாவே, நீர் நீதிபரர், உமது நியாயத்தீர்ப்புகள் செம்மையானவைகள்.","poem":1}]},{"type":"verse","number":138,"content":[{"lineBreak":true},{"text":"நீர் கட்டளையிட்ட சாட்சிகள் நீதியும், மகா உண்மையுமானவைகள்.","poem":1}]},{"type":"verse","number":139,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் உம்முடைய வசனங்களை மறந்தபடியால்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பக்திவைராக்கியம் என்னை அழிக்கிறது.","poem":1}]},{"type":"verse","number":140,"content":[{"lineBreak":true},{"text":"உமது வார்த்தை மிகவும் புடமிடப்பட்டது,","poem":1},{"lineBreak":true},{"text":"உமது அடியேன் அதில் பிரியப்படுகிறேன்.","poem":1}]},{"type":"verse","number":141,"content":[{"lineBreak":true},{"text":"நான் சிறியவனும் அசட்டை செய்யப்பட்டவனுமாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் உமது கட்டளைகளை மறவேன்.","poem":1}]},{"type":"verse","number":142,"content":[{"lineBreak":true},{"text":"உம்முடைய நீதி நிரந்தர நீதி, உம்முடைய வேதம் சத்தியம்.","poem":1}]},{"type":"verse","number":143,"content":[{"lineBreak":true},{"text":"துயரமும் வேதனையும் என்னைப் பிடித்தது;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் உம்முடைய கற்பனைகள் என்னுடைய மனமகிழ்ச்சி.","poem":1}]},{"type":"verse","number":144,"content":[{"lineBreak":true},{"text":"உம்முடைய சாட்சிகளின் நீதி என்றைக்கும் நிற்கும்; என்னை உணர்வுள்ளவனாக்கும்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் பிழைத்திருப்பேன்.","poem":1},{"text":"கோப்.","descriptive":true}]},{"type":"verse","number":145,"content":[{"text":"முழு இருதயத்தோடும் கூப்பிட்டேன், யெகோவாவே, என்னுடைய ஜெபத்தைக் கேளும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பிரமாணங்களைக் கைக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":146,"content":[{"lineBreak":true},{"text":"உம்மை நோக்கிக் கூப்பிட்டேன், என்னைக் காப்பாற்றும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் உம்முடைய சாட்சிகளைக் காத்துக்கொள்ளுவேன்.","poem":1}]},{"type":"verse","number":147,"content":[{"lineBreak":true},{"text":"அதிகாலையில் நான் எழுந்து சத்தமிட்டேன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வசனத்திற்குக் காத்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":148,"content":[{"lineBreak":true},{"text":"உமது வசனத்தைத் தியானிக்கும்படி,","poem":1},{"lineBreak":true},{"text":"குறித்த இரவு நேரங்களுக்கு முன்னே என்னுடைய கண்கள் விழித்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":149,"content":[{"lineBreak":true},{"text":"உம்முடைய கிருபையின்படி என்னுடைய சத்தத்தைக் கேளும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய நியாயத்தீர்ப்பின்படி என்னை உயிர்ப்பியும்.","poem":1}]},{"type":"verse","number":150,"content":[{"lineBreak":true},{"text":"தீமையைப் பின்பற்றுகிறவர்கள் நெருங்கி இருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் உம்முடைய வேதத்திற்குத் தூரமாக இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":151,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் அருகில் இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"உமது கற்பனைகளெல்லாம் உண்மை.","poem":1}]},{"type":"verse","number":152,"content":[{"lineBreak":true},{"text":"நீர் உம்முடைய சாட்சிகளை என்றென்றைக்கும் நிற்க நிறுவினீர் என்பதை,","poem":1},{"lineBreak":true},{"text":"அவைகளால் நான் நெடுநாளாக அறிந்திருக்கிறேன்.","poem":1},{"text":"ரேஷ்.","descriptive":true}]},{"type":"verse","number":153,"content":[{"text":"என்னுடைய உபத்திரவத்தைப் பார்த்து, என்னை விடுவியும்;","poem":1},{"lineBreak":true},{"text":"உமது வேதத்தை மறக்கமாட்டேன்.","poem":1}]},{"type":"verse","number":154,"content":[{"lineBreak":true},{"text":"எனக்காக நீர் வழக்காடி என்னை மீட்டுக்கொள்ளும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வார்த்தையின்படியே என்னை உயிர்ப்பியும்.","poem":1}]},{"type":"verse","number":155,"content":[{"lineBreak":true},{"text":"இரட்சிப்பு துன்மார்க்கர்களுக்குத் தூரமாக இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"அவர்கள் உமது பிரமாணங்களைத் தேடமாட்டார்கள்.","poem":1}]},{"type":"verse","number":156,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய இரக்கங்கள் பெரியவைகளாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உமது நியாயங்களின்படி என்னை உயிர்ப்பியும்.","poem":1}]},{"type":"verse","number":157,"content":[{"lineBreak":true},{"text":"என்னைத் துன்பப்படுத்துகிறவர்களும் என்னை விரோதிக்கிறவர்களும் அநேகர்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் உம்முடைய சாட்சிகளை விட்டுவிலகமாட்டேன்.","poem":1}]},{"type":"verse","number":158,"content":[{"lineBreak":true},{"text":"உமது வசனத்தைக் கைக்கொள்ளாத துரோகிகளை நான் கண்டபோது,","poem":1},{"lineBreak":true},{"text":"எனக்கு அருவருப்பாக இருந்தது.","poem":1}]},{"type":"verse","number":159,"content":[{"lineBreak":true},{"text":"இதோ, உம்முடைய கட்டளைகளை நேசிக்கிறேன்; யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உமது கிருபையின்படி என்னை உயிர்ப்பியும்.","poem":1}]},{"type":"verse","number":160,"content":[{"lineBreak":true},{"text":"உம்முடைய வசனம் முழுவதும் சத்தியம்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய நீதி நியாயமெல்லாம் நித்தியம்.","poem":1},{"text":"ஷீன்.","descriptive":true}]},{"type":"verse","number":161,"content":[{"text":"அதிகாரிகளும் காரணமில்லாமல் என்னைத் துன்பப்படுத்தினார்கள்,","poem":1},{"lineBreak":true},{"text":"ஆனாலும் என்னுடைய இருதயம் உமது வசனத்திற்கே பயப்படுகிறது.","poem":1}]},{"type":"verse","number":162,"content":[{"lineBreak":true},{"text":"மிகுந்த கொள்ளைப்பொருட்களைக் கண்டுபிடிக்கிறவன் மகிழுகிறதுபோல,","poem":1},{"lineBreak":true},{"text":"நான் உமது வார்த்தையின் பெயரில் மகிழுகிறேன்.","poem":1}]},{"type":"verse","number":163,"content":[{"lineBreak":true},{"text":"பொய்யைப் பகைத்து அருவருக்கிறேன்; உம்முடைய வேதத்தையோ நேசிக்கிறேன்.","poem":1}]},{"type":"verse","number":164,"content":[{"lineBreak":true},{"text":"உமது நீதிநியாயங்களுக்காக, ஒருநாளில் ஏழுமுறை உம்மைத் துதிக்கிறேன்.","poem":1}]},{"type":"verse","number":165,"content":[{"lineBreak":true},{"text":"உம்முடைய வேதத்தை நேசிக்கிறவர்களுக்கு மிகுந்த சமாதானமுண்டு;","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு தடைகள் இல்லை.","poem":1}]},{"type":"verse","number":166,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய இரட்சிப்புக்கு நான் காத்திருந்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய கற்பனைகளின்படி செய்கிறேன்.","poem":1}]},{"type":"verse","number":167,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா உமது சாட்சிகளைக் காக்கும்;","poem":1},{"lineBreak":true},{"text":"அவைகளை நான் மிகவும் நேசிக்கிறேன்.","poem":1}]},{"type":"verse","number":168,"content":[{"lineBreak":true},{"text":"உமது கட்டளைகளையும் உமது சாட்சிகளையும் காத்து நடக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வழிகளெல்லாம் உமக்கு முன்பாக இருக்கிறது.","poem":1},{"text":"தெள.","descriptive":true}]},{"type":"verse","number":169,"content":[{"text":"யெகோவாவே, என்னுடைய கூப்பிடுதல் உமது சந்நிதியில் வருவதாக;","poem":1},{"lineBreak":true},{"text":"உமது வசனத்தின்படியே என்னை உணர்வுள்ளவனாக்கும்.","poem":1}]},{"type":"verse","number":170,"content":[{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பம் உமது சந்நிதியில் வரட்டும்;","poem":1},{"lineBreak":true},{"text":"உமது வார்த்தையின்படி என்னை விடுவித்தருளும்.","poem":1}]},{"type":"verse","number":171,"content":[{"lineBreak":true},{"text":"உம்முடைய பிரமாணங்களை நீர் எனக்குப் போதிக்கும்போது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உதடுகள் உமது துதியைப் பிரபலப்படுத்தும்.","poem":1}]},{"type":"verse","number":172,"content":[{"lineBreak":true},{"text":"உமது கற்பனைகளெல்லாம் நீதியுள்ளவைகள்; ஆதலால்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய நாவு உம்முடைய வசனத்தை விவரித்துச் சொல்லும்.","poem":1}]},{"type":"verse","number":173,"content":[{"lineBreak":true},{"text":"நான் உம்முடைய கட்டளைகளைத் தெரிந்துகொண்டபடியால்,","poem":1},{"lineBreak":true},{"text":"உமது கரம் எனக்குத் துணையாக இருக்கட்டும்.","poem":1}]},{"type":"verse","number":174,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய இரட்சிப்பின்மேல் ஆவலாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வேதம் என்னுடைய மனமகிழ்ச்சி.","poem":1}]},{"type":"verse","number":175,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா பிழைத்திருந்து உம்மைத் துதிக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"உமது நியாயத்தீர்ப்புகள் எனக்கு உதவியாக இருக்கட்டும்.","poem":1}]},{"type":"verse","number":176,"content":[{"lineBreak":true},{"text":"காணாமற்போன ஆட்டைப்போல வழிதப்பிப்போனேன்;","poem":1},{"lineBreak":true},{"text":"உமது அடியேனைத் தேடும்; உமது கற்பனைகளை நான் மறக்கமாட்டேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}