{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["செமினீத் என்னும் இசைக் கருவியில் வாசிக்க இராகத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"காப்பாற்றும் யெகோவாவே, பக்தியுள்ளவன் அழிந்துபோகிறான்;","poem":1},{"lineBreak":true},{"text":"உண்மையுள்ளவர்கள் மனிதர்களில் இல்லை.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவரவர் தங்களுடைய நண்பர்களோடு பொய் பேசுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"கவர்ச்சியான உதடுகளால் இருமனதாகப் பேசுகிறார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"வஞ்சகம் பேசுகிற எல்லா உதடுகளையும்,","poem":1},{"lineBreak":true},{"text":"பெருமைகளைப் பேசுகிற நாவையும் யெகோவா அறுத்துப்போடுவாராக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர்கள், எங்களுடைய நாவுகளால் மேற்கொள்ளுவோம், எங்கள் உதடுகள் எங்களுடையவை;","poem":1},{"lineBreak":true},{"text":"யார் எங்களுக்கு ஆண்டவன் என்று சொல்லுகிறார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஏழைகள் பாழாக்கப்பட்டதினிமித்தமும், எளியவர்கள் விடும் பெருமூச்சினிமித்தமும், நான் இப்பொழுது எழுந்து,","poem":1},{"lineBreak":true},{"text":"அவன் ஏங்குகிற பாதுகாப்பிலே அவனை வைப்பேன் என்று யெகோவா சொல்லுகிறார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய சொற்கள் மண் உலையிலே ஏழுதரம் உருக்கி,","poem":1},{"lineBreak":true},{"text":"புடமிடப்பட்ட வெள்ளிக்கு இணையான","poem":1},{"lineBreak":true},{"text":"சுத்தசொற்களாக இருக்கின்றன.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் எங்களைக் காப்பாற்றி,","poem":1},{"lineBreak":true},{"text":"எங்களை","poem":1},{"noteId":0},{"text":"என்றைக்கும் இந்த தலைமுறையாரிடமிருந்து விலக்கிக் காத்துக்கொள்ளுவீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மனிதர்களில் தீயவர்கள் உயர்ந்திருக்கும்போது,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் எங்கும் சுற்றித்திரிவார்கள்.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"அவர்களை","reference":{"chapter":12,"verse":7}}]},"thisChapterLink":"/api/tam_irv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}