{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என்னுடைய நெருக்கத்திலே யெகோவாவை நோக்கிக் கூப்பிட்டேன்;","poem":1},{"lineBreak":true},{"text":"அவர் எனக்குச் செவிகொடுத்தார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவே, பொய் உதடுகளுக்கும் வஞ்சகமாக பேசும் நாவுக்கும் என்னுடைய ஆத்துமாவைத் தப்புவியும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"வஞ்சக நாவே, உனக்கு என்ன கிடைக்கும்?","poem":1},{"lineBreak":true},{"text":"உனக்கு என்ன செய்யப்படும்?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"பலவானுடைய கூர்மையான அம்புகளும்,","poem":1},{"lineBreak":true},{"text":"சூரைச்செடிகளை எரிக்கும் தழலுமே கிடைக்கும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஐயோ, நான் மேசேக்கிலே","poem":1},{"noteId":26},{"text":"வாழ்ந்தது போதும்,","poem":1},{"lineBreak":true},{"text":"கேதாரின் கூடாரங்கள் அருகில் குடியிருந்ததும் போதும்!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"சமாதானத்தைப் பகைக்கிறவர்களிடம் என்னுடைய ஆத்துமா குடியிருந்ததும் போதும்!","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நான் சமாதானத்தை நாடுகிறேன்;","poem":1},{"lineBreak":true},{"text":"அவர்களோ, நான் பேசும்போது போர்செய்ய முயற்சி செய்கிறார்கள்.","poem":1}]}],"footnotes":[{"noteId":26,"caller":"+","text":"மேசேக்கு கருங்கடலுக்கும் காசுப்பியன் கடலுக்கும் மத்தியில் உள்ள பகுதியாகும். கேதார் சீரியவின் தமஸ்குக்கு தென்பகுதியில் உள்ள பகுதியாகும் இங்கு நாடோடிகள் வாழ்ந்து வந்தார்கள் இவர்கள் மிகவும் வெறித்தனமானவர்களாய் இருந்தார்கள்","reference":{"chapter":120,"verse":5}}]},"thisChapterLink":"/api/tam_irv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}