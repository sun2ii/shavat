{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"எனக்கு உதவி வரும் மலைகளுக்கு நேராக","poem":1},{"lineBreak":true},{"text":"என்னுடைய கண்களை உயர்த்துகிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"வானத்தையும் பூமியையும் உண்டாக்கின","poem":1},{"lineBreak":true},{"text":"யெகோவாவிடத்திலிருந்து எனக்கு உதவி வரும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உன்னுடைய காலைத் தள்ளாடவிடமாட்டார்;","poem":1},{"lineBreak":true},{"text":"உன்னைக் காக்கிறவர் உறங்கமாட்டார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இதோ, இஸ்ரவேலைக் காக்கிறவர் உறங்குகிறதுமில்லை தூங்குகிறதுமில்லை.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவா உன்னைக் காக்கிறவர்;","poem":1},{"lineBreak":true},{"text":"யெகோவா உன்னுடைய வலது பக்கத்திலே உனக்கு நிழலாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பகலிலே வெயிலோ, இரவிலே நிலவோ","poem":1},{"lineBreak":true},{"text":"உன்னைச் சேதப்படுத்துவதில்லை.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவா உன்னை எல்லாத் தீங்குக்கும் விலக்கிக் காப்பார்;","poem":1},{"lineBreak":true},{"text":"அவர் உன்னுடைய ஆத்துமாவைக் காப்பார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா உன்னுடைய போக்கையும் உன்னுடைய வரத்தையும்","poem":1},{"lineBreak":true},{"text":"இதுமுதற்கொண்டு என்றென்றும் காப்பார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}