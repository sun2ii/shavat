{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவுடைய ஆலயத்திற்குப் போவோம் வாருங்கள்","poem":1},{"lineBreak":true},{"text":"என்று என் நண்பர்கள் எனக்கு அவர்கள் சொன்னபோது மகிழ்ச்சியாக இருந்தேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எருசலேமே, உன்னுடைய வாசல்களில் எங்களுடைய கால்கள் நிற்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"எருசலேம் கச்சிதமான நகரமாகக் கட்டப்பட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அங்கே இஸ்ரவேலுக்குச் சாட்சியாகக்","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய மக்களாகிய கோத்திரங்கள் யெகோவாவின் பெயரைப் போற்றுவதற்குப் போகும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அங்கே தாவீதின் வீட்டாருடைய சிங்காசனங்களாகிய","poem":1},{"lineBreak":true},{"text":"நியாயாசனங்கள் வைக்கப்பட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"எருசலேமின் சமாதானத்திற்காக வேண்டிக்கொள்ளுங்கள்;","poem":1},{"lineBreak":true},{"text":"உன்னை நேசிக்கிறவர்கள் செழித்திருக்கட்டும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உன்னுடைய மதில்களுக்குள்ளே சமாதானமும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய அரண்மனைகளுக்குள்ளே செழிப்பும் இருக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய சகோதரர்களுக்காகவும் என்னுடைய நண்பர்களுக்காகவும்,","poem":1},{"lineBreak":true},{"text":"உன்னில் சமாதானம் இருக்கட்டும் என்பேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எங்களுடைய தேவனாகிய யெகோவாவின் ஆலயத்திற்காக","poem":1},{"lineBreak":true},{"text":"உனக்கு நன்மையுண்டாகத் தேடுவேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}