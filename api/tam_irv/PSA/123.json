ue},{"text":"சுகமாக வாழ்கிறவர்களுடைய அவமானத்தினாலும்,","poem":1},{"lineBreak":true},{"text":"அகங்காரிகளுடைய இகழ்ச்சியினாலும்,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய ஆத்துமா மிகவும் நிறைந்திருக்கிறது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}