{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"மனிதர்கள் நமக்கு விரோதமாக எழும்பினபோது,","poem":1},{"lineBreak":true},{"text":"யெகோவா நமது பக்கத்தில் இல்லாவிட்டால்,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா தாமே நமது பக்கத்தில் இல்லாவிட்டால்,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர்களுடைய கோபம் நம்மேல் எரியும்போது,","poem":1},{"lineBreak":true},{"text":"நம்மை உயிரோடு விழுங்கியிருப்பார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அப்பொழுது தண்ணீர்கள் நம்மேல் பாய்ந்து,","poem":1},{"lineBreak":true},{"text":"வெள்ளங்கள் நமது ஆத்துமாவின்மேல் பெருகி,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"கொந்தளிக்கும் தண்ணீர்கள் நமது ஆத்துமாவின்மேல் புரண்டுபோயிருக்கும்","poem":1},{"lineBreak":true},{"text":"என்று இஸ்ரவேல் இப்பொழுது சொல்வதாக.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நம்மை அவர்களுடைய பற்களுக்கு இரையாக ஒப்புக்கொடுக்காமல்","poem":1},{"lineBreak":true},{"text":"இருக்கிற யெகோவாவுக்கு நன்றி.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"வேடருடைய கண்ணிக்குத் தப்பின குருவியைப்போல","poem":1},{"lineBreak":true},{"text":"நம்முடைய ஆத்துமா தப்பினது,","poem":1},{"lineBreak":true},{"text":"கண்ணி தெறித்தது, நாம் தப்பினோம்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நம்முடைய உதவி வானத்தையும் பூமியையும் உண்டாக்கின","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய பெயரில் உள்ளது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}