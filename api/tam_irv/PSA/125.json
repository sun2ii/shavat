{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":125,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவை நம்புகிறவர்கள் என்றென்றைக்கும் அசையாமல் நிலைத்திருக்கும்","poem":1},{"lineBreak":true},{"text":"சீயோன் மலையைப்போல் இருப்பார்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மலைகள் எருசலேமைச் சுற்றிலும் இருக்கிறதுபோல்,","poem":1},{"lineBreak":true},{"text":"யெகோவா இதுமுதல் என்றென்றைக்கும்","poem":1},{"lineBreak":true},{"text":"தம்முடைய மக்களைச் சுற்றிலும் இருக்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீதிமான்கள் அநியாயத்திற்குத் தங்களுடைய கைகளை நீட்டாதபடிக்கு,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கத்தின் கொடுங்கோல் நீதிமான்களுடைய சொத்தின்மேல் நிலைத்திருக்காது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நல்லவர்களுக்கும் இருதயத்தில் செம்மையானவர்களுக்கும் நன்மை செய்யும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தங்களுடைய கோணலான வழிகளுக்குச் சாய்கிறவர்களைக்","poem":1},{"lineBreak":true},{"text":"யெகோவா அக்கிரமக்காரர்களோடு போகச்செய்வார்.","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலுக்கோ சமாதானம் உண்டு.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}