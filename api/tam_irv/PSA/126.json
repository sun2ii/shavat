rue},{"text":"தெற்கத்திய வெள்ளங்களைத் திருப்புவதுபோல,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய சிறையிருப்பைத் திருப்பும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"கண்ணீரோடு விதைக்கிறவர்கள்","poem":1},{"lineBreak":true},{"text":"கெம்பீரத்தோடு அறுப்பார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அள்ளித்தூவும் விதையைச் சுமக்கிறவன் அழுதுகொண்டு போகிறான்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் தான் அறுத்த அரிகளைச் சுமந்துகொண்டு","poem":1},{"lineBreak":true},{"text":"கெம்பீரத்தோடு திரும்பிவருவான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}