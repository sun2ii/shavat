{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["சாலொமோனின் ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா வீட்டைக் கட்டாவிட்டால்,","poem":1},{"lineBreak":true},{"text":"அதைக் கட்டுகிறவர்களின் உழைப்பு வீண்;","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா நகரத்தைக் காக்காமல் இருந்தால்","poem":1},{"lineBreak":true},{"text":"காவலாளர்கள் விழித்திருக்கிறது வீண்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீங்கள் அதிகாலையில் எழுந்து,","poem":1},{"lineBreak":true},{"text":"நேரத்துடன் வேலைகளைச் செய்து,","poem":1},{"lineBreak":true},{"text":"வருத்தத்தின் அப்பத்தைச் சாப்பிடுகிறதும் வீண்;","poem":1},{"lineBreak":true},{"text":"அவரே தமக்குப் பிரியமானவனுக்குத் தூக்கத்தைக் கொடுக்கிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இதோ, பிள்ளைகள் கர்த்தரால் வரும் சுதந்திரம்,","poem":1},{"lineBreak":true},{"text":"கர்ப்பத்தின் கனி அவரால் கிடைக்கும் பலன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"இளவயதின் மகன்கள் பலவான் கையிலுள்ள அம்புகளுக்கு ஒப்பாக இருக்கிறார்கள்.","poem":1},{"lineBreak":true},{"text":"அவைகளால் தன்னுடைய அம்பறாத்தூணியை நிரப்பின மனிதன் பாக்கியவான்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் வெட்கமடையாமல் ஒலிமுகவாசலில் எதிரிகளோடு பேசுவார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}