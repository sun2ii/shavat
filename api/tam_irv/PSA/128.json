{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்குப் பயந்து,","poem":1},{"lineBreak":true},{"text":"அவர் வழிகளில் நடக்கிறவன் எவனோ, அவன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உன்னுடைய கைகளின் உழைப்பை நீ சாப்பிடுவாய்;","poem":1},{"lineBreak":true},{"text":"உனக்குப் பாக்கியமும் நன்மையும் உண்டாயிருக்கும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உன்னுடைய மனைவி உன் வீட்டோரங்களில் கனிதரும்","poem":1},{"lineBreak":true},{"text":"திராட்சைக்கொடியைப்போல் இருப்பாள்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய பிள்ளைகள் உன்னுடைய பந்தியைச் சுற்றிலும் ஒலிவமரக் கன்றுகளைப்போல் இருப்பார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இதோ, யெகோவாவுக்குப் பயப்படுகிற மனிதன்","poem":1},{"lineBreak":true},{"text":"இவ்விதமாக ஆசீர்வதிக்கப்படுவான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவா சீயோனிலிருந்து உன்னை ஆசீர்வதிப்பார்;","poem":1},{"lineBreak":true},{"text":"நீ உயிருள்ள நாட்களெல்லாம் எருசலேமின் வாழ்வைக் காண்பாய்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீ உன்னுடைய பிள்ளைகளின் பிள்ளைகளையும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலுக்கு உண்டாகும் சமாதானத்தையும் காண்பாய்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}