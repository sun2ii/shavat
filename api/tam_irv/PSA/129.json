{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என்னுடைய சிறுவயது முதற்கொண்டு","poem":1},{"lineBreak":true},{"text":"அநேகமுறை என்னை நெருக்கினார்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய சிறுவயது முதற்கொண்டு அநேகமுறை என்னை நெருக்கியும்,","poem":1},{"lineBreak":true},{"text":"என்னை மேற்கொள்ளாமற் போனார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உழுகிறவர்கள் என்னுடைய முதுகின்மேல் உழுது,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய வரப்புகளை நீளமாக்கினார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவோ நீதியுள்ளவர்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய கயிறுகளை அவர் அறுத்தார் என்று,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேல் இப்பொழுது சொல்வதாக.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"சீயோனைப் பகைக்கிற அனைவரும் வெட்கப்பட்டு பின்னிட்டுத் திரும்புவார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"வீட்டின்மேல் முளைக்கும் புல்லுக்கு அவர்கள் ஒப்பாவார்கள்;","poem":1},{"lineBreak":true},{"text":"அது வளரும்முன்பு உலர்ந்துபோகும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அறுக்கிறவன் அதினால் தன்னுடைய கையையும்,","poem":1},{"lineBreak":true},{"text":"அரிகளைக் கட்டுகிறவன் தன்னுடைய மடியையும் நிரப்புவதில்லை.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய ஆசீர்வாதம் உங்களுக்கு உண்டாகட்டும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவின் பெயரினால் உங்களை ஆசீர்வதிக்கிறோம்","poem":1},{"lineBreak":true},{"text":"என்று வழிப்போக்கர்கள் சொல்வதுமில்லை.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}