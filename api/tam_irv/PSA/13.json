{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["சங்கீத தலைவரிடம் கொடுக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, எதுவரைக்கும் என்னை மறந்திருப்பீர்,","poem":1},{"lineBreak":true},{"text":"எதுவரைக்கும் உம்முடைய முகத்தை எனக்கு மறைப்பீர்?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயத்திலே சஞ்சலத்தை எல்லா நாளும் வைத்து,","poem":1},{"lineBreak":true},{"text":"எதுவரைக்கும் என்னுடைய ஆத்துமாவிலே ஆலோசனை செய்துகொண்டிருப்பேன்?","poem":1},{"lineBreak":true},{"text":"எதுவரைக்கும் என்னுடைய எதிரி என்மேல் தன்னை உயர்த்துவான்?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவாவே, நீர் நோக்கிப்பார்த்து,","poem":1},{"lineBreak":true},{"text":"எனக்குப் பதில் தாரும்; நான் மரணமாகிய தூக்கம்","poem":1},{"lineBreak":true},{"text":"அடையாதபடி என்னுடைய கண்களைத் தெளிவாக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவனை மேற்கொண்டேன் என்று என்னுடைய எதிரி சொல்லாதபடி,","poem":1},{"lineBreak":true},{"text":"நான் தள்ளாடுகிறதினால் என்னுடைய எதிரி சந்தோஷப்படாதபடி இப்படிச் செய்தருளும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நான் உம்முடைய கிருபையின்மேல் நம்பிக்கையாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய இரட்சிப்பினால் என்னுடைய இருதயம் சந்தோஷப்படும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா எனக்கு நன்மைசெய்தபடியால் அவரைப் பாடுவேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}