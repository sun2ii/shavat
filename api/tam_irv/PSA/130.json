{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உபத்திரவத்தின் ஆழங்களிலிருந்து உம்மை நோக்கிக் கூப்பிடுகிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, என்னுடைய சத்தத்தைக் கேளும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பங்களின் சத்தத்திற்கு","poem":1},{"lineBreak":true},{"text":"உமது செவிகள் கவனித்திருக்கட்டும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் அக்கிரமங்களைக் கவனித்திருப்பீரானால்,","poem":1},{"lineBreak":true},{"text":"யார் நிலைநிற்பான், ஆண்டவரே.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உமக்குப் பயப்படும்படிக்கு உம்மிடத்தில் மன்னிப்பு உண்டு.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குக் காத்திருக்கிறேன்; என்னுடைய ஆத்துமா காத்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவருடைய வார்த்தையை நம்பியிருக்கிறேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"எப்பொழுது விடியும் என்று விடியற்காலத்திற்குக் காத்திருக்கிற காவலர்களைவிட","poem":1},{"lineBreak":true},{"text":"அதிகமாக என்னுடைய ஆத்துமா ஆண்டவருக்குக் காத்திருக்கிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இஸ்ரவேல் யெகோவாவை நம்பியிருப்பதாக;","poem":1},{"lineBreak":true},{"text":"கர்த்தரிடத்தில் கிருபையும், அவரிடத்தில் திரளான மீட்பும் உண்டு.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் இஸ்ரவேலை அதின் எல்லா அக்கிரமங்களிலிருந்தும் மீட்டுக்கொள்வார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}