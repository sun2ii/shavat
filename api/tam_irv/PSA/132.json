{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["ஆரோகண பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, தாவீதையும் அவனுடைய எல்லா உபத்திரவத்தையும் நினைத்தருளும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவன்: நான் யெகோவாவுக்கு ஒரு இடத்தையும்,","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் வல்லவருக்கு ஒரு குடியிருக்கும் இடத்தையும் பார்க்கும்வரை,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னுடைய வீடாகிய கூடாரத்தில் நுழைவதில்லை, என்னுடைய படுக்கையாகிய கட்டிலின்மேல் ஏறுவதுமில்லை,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய கண்களுக்குத் தூக்கத்தையும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இமைகளுக்கு உறக்கத்தையும் வரவிடுவதுமில்லை என்று,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்கு ஆணையிட்டு,","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் வல்லமையுள்ள தேவனுக்குப் பொருத்தனை செய்தான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இதோ, நாம் எப்பிராத்தாவிலே அதின் செய்தியைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"வயல்வெளிகளில் அதைக் கண்டோம்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவருடைய ஆலயத்தின் குடியிருப்புகளுக்குள் நுழைந்து,","poem":1},{"lineBreak":true},{"text":"அவர் பாதத்தில் பணிவோம்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது வல்லமை வெளிப்படும் பெட்டியுடன் நீர் உமது தங்கும் இடத்திற்குள் எழுந்தருளும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உம்முடைய ஆசாரியர்கள் நீதியை அணிந்து, உம்முடைய பரிசுத்தவான்கள் கெம்பீரிக்கட்டும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நீர் அபிஷேகம்செய்தவனின் முகத்தை உமது ஊழியனாகிய தாவீதினிமித்தம் தள்ளிவிடாதிரும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"உன்னுடைய கர்ப்பத்தின் பிள்ளையை உன்னுடைய சிங்காசனத்தின்மேல் வைப்பேன் என்றும்,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உன்னுடைய மகன்கள் என்னுடைய உடன்படிக்கையையும்,","poem":1},{"lineBreak":true},{"text":"நான் போதிக்கும் என்னுடைய சாட்சிகளையும் காத்து நடந்தால்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் மகன்களும் என்றென்றைக்கும் உன்னுடைய சிங்காசனத்தில் அமர்ந்திருப்பார்கள் என்றும்,","poem":1},{"lineBreak":true},{"text":"யெகோவா தாவீதிற்கு உண்மையாக ஆணையிட்டார்; அவர் தவறமாட்டார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவா சீயோனைத் தெரிந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"அது தமக்குக் குடியிருக்கும் இடமாகும்படி விரும்பினார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"இது என்றென்றைக்கும் நான் தங்கும் இடம்;","poem":1},{"lineBreak":true},{"text":"இதை நான் விரும்பினதால், இங்கே தங்குவேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அதின் ஆகாரத்தை நான் ஆசீர்வதித்து வருவேன்;","poem":1},{"lineBreak":true},{"text":"அதின் ஏழைகளை நான் அப்பத்தினால் திருப்தியாக்குவேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அதின் ஆசாரியர்களுக்கு இரட்சிப்பை அணிவிப்பேன்;","poem":1},{"lineBreak":true},{"text":"அதிலுள்ள பரிசுத்தவான்கள் மிகவும் கெம்பீரிப்பார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அங்கே தாவீதுக்காக ஒரு கொம்பை முளைக்கச்செய்வேன்;","poem":1},{"lineBreak":true},{"text":"நான் அபிஷேகம் செய்தவவனுக்காக ஒரு விளக்கை ஆயத்தம்செய்தேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவனுடைய எதிரிகளுக்கு வெட்கத்தை அணிவிப்பேன்;","poem":1},{"lineBreak":true},{"text":"அவன் மீதோ அவன் கிரீடம் பூக்கும் என்றார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}