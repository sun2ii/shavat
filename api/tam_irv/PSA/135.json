{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா, யெகோவாவுடைய பெயரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவின் ஊழியக்காரர்களே, துதியுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய வீட்டிலும்,","poem":1},{"lineBreak":true},{"text":"நமது தேவனுடைய ஆலயமுற்றங்களிலும் நிற்கிறவர்களே,","poem":1},{"lineBreak":true},{"text":"யெகோவாவை துதியுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவா நல்லவர்; அவருடைய பெயரைப் புகழ்ந்து பாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"அது இன்பமானது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவா யாக்கோபைத் தமக்காகவும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலைத் தமக்குச் சொந்தமாகவும் தெரிந்துகொண்டார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவா பெரியவர் என்றும்,","poem":1},{"lineBreak":true},{"text":"நம்முடைய ஆண்டவர் எல்லா தெய்வங்களுக்கும் மேலானவர் என்றும் நான் அறிவேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"வானத்திலும் பூமியிலும், கடல்களிலும், எல்லா ஆழங்களிலும்,","poem":1},{"lineBreak":true},{"text":"யெகோவா தமக்கு விருப்பமானதையெல்லாம் செய்கிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் பூமியின் கடைசியிலிருந்து மேகங்களை எழும்பச்செய்து,","poem":1},{"lineBreak":true},{"text":"மழையுடன் மின்னலையும் உண்டாக்கி,","poem":1},{"lineBreak":true},{"text":"காற்றைத் தமது சேமிப்புக்கிடங்கிலிருந்து புறப்படச்செய்கிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் எகிப்திலே மனிதருடைய தலைப்பிள்ளைகளையும் மிருகத்தின் தலையீற்றுகளையும் அடித்தார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எகிப்துதேசமே, உன் நடுவில் பார்வோன்மேலும் அவனுடைய எல்லா ஊழியக்காரர்கள் மேலும்","poem":1},{"lineBreak":true},{"text":"அடையாளங்களையும் அற்புதங்களையும் அனுப்பினார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர் அநேகம் தேசங்களை அடித்து, வலிமைமிக்க ராஜாக்களைக் கொன்று;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"எமோரியர்களின் ராஜாவாகிய சீகோனையும், பாசானின் ராஜாவாகிய ஓகையும்,","poem":1},{"lineBreak":true},{"text":"கானானின் எல்லா ராஜ்ஜியங்களையும் அழித்து,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவர்கள் தேசத்தைத் தம்முடைய மக்களுமாகிய இஸ்ரவேலுக்குச் சுதந்தரமாகக் கொடுத்தார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய பெயர் என்றைக்குமுள்ளது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய புகழ் தலைமுறை தலைமுறைக்கும் இருக்கும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவா தம்முடைய மக்களின் நியாயத்தை விசாரித்து,","poem":1},{"lineBreak":true},{"text":"தம்முடைய ஊழியக்காரர்கள்மேல் பரிதாபப்படுவார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அஞ்ஞானிகளுடைய சிலைகள் வெள்ளியும் பொன்னும்,","poem":1},{"lineBreak":true},{"text":"மனிதர்களுடைய கைவேலையுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவைகளுக்கு வாயிருந்தும் பேசாது,","poem":1},{"lineBreak":true},{"text":"அவைகளுக்குக் கண்களிருந்தும் காணாது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவைகளுக்குக் காதுகளிருந்தும் கேளாது,","poem":1},{"lineBreak":true},{"text":"அவைகளுடைய வாயிலே சுவாசமுமில்லை.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவைகளைச் செய்கிறவர்களும், அவைகளை நம்புகிறவர்கள் அனைவரும்,","poem":1},{"lineBreak":true},{"text":"அவைகளைப்போல் இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"இஸ்ரவேல் குடும்பத்தாரே,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்கு நன்றிசொல்லுங்கள்; ஆரோன் குடும்பத்தாரே, யெகோவாவுக்கு நன்றிசொல்லுங்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"லேவி குடும்பத்தாரே, யெகோவாவுக்கு நன்றிசொல்லுங்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயந்தவர்களே, யெகோவாவுக்கு நன்றிசொல்லுங்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"எருசலேமில் குடியிருக்கிற யெகோவாவுக்கு","poem":1},{"lineBreak":true},{"text":"சீயோனிலிருந்து நன்றிஉண்டாகட்டும்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}