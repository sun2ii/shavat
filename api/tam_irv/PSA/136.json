{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவை துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் நல்லவர், அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தேவாதி தேவனைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"கர்த்தாதி யெகோவாவை துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ஒருவராக பெரிய அதிசயங்களைச் செய்கிறவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"வானங்களை ஞானமாக உண்டாக்கினவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தண்ணீர்களுக்கு மேலே பூமியைப் பரப்பினவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"பெரிய சுடர்களை உண்டாக்கினவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பகலில் ஆளச் சூரியனைப் படைத்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"இரவில் ஆளச் சந்திரனையும் நட்சத்திரங்களையும் படைத்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எகிப்தியர்களுடைய தலைப்பிள்ளைகளை அழித்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர்கள் நடுவிலிருந்து இஸ்ரவேலைப் புறப்படச்செய்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"வலிமையான கையினாலும் தோளின் பலத்தினாலும் அதைச் செய்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"சிவந்த கடலை இரண்டாகப் பிரித்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அதின் நடுவே இஸ்ரவேலைக் கடந்துபோகச் செய்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"பார்வோனையும் அவன் சேனைகளையும்","poem":1},{"lineBreak":true},{"text":"செங்கடலில் கவிழ்த்துப்போட்டவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தம்முடைய மக்களை வனாந்தரத்தில் நடத்தினவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"பெரிய ராஜாக்களை அழித்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"பிரபலமான ராஜாக்களை அழித்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"எமோரியரின் ராஜாவாகிய சீகோனை அழித்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"பாசானின் ராஜாவாகிய ஓகை அழித்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவர்களுடைய தேசத்தைச் சுதந்தரமாகத் தந்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அதைத் தம்முடைய ஊழியனாகிய இஸ்ரவேலுக்குச் சுதந்திரமாகவே தந்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"நம்முடைய தாழ்வில் நம்மை நினைத்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"நம்முடைய எதிரிகளின் கையிலிருந்து நம்மை விடுதலை செய்தவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"உயிரினம் அனைத்திற்கும் ஆகாரம் கொடுக்கிறவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"பரலோகத்தின் தேவனைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் கிருபை என்றுமுள்ளது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}