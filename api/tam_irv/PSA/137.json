{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"பாபிலோன் ஆறுகள் அருகே நாங்கள் உட்கார்ந்து,","poem":1},{"lineBreak":true},{"text":"அங்கே சீயோனை நினைத்து அழுதோம்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அதின் நடுவிலிருக்கும் அலரிச்செடிகளின்மேல் எங்களுடைய கின்னரங்களைத் தூக்கிவைத்தோம்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"எங்களைச் சிறைபிடித்தவர்கள் அங்கே எங்களுடைய பாடல்களையும்,","poem":1},{"lineBreak":true},{"text":"எங்களையும் பாழாக்கினவர்கள் மகிழ்ச்சி பாடல்களை விரும்பி:","poem":1},{"lineBreak":true},{"text":"சீயோனின் பாட்டுகளில் சிலவற்றை எங்களுக்குப் பாடுங்கள் என்று சொன்னார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவின் பாட்டை அந்நிய தேசத்தில் நாங்கள் பாடுவதெப்படி?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"எருசலேமே, நான் உன்னை மறந்தால் என்னுடைய வலதுகை தன்னுடைய தொழிலை மறப்பதாக.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் உன்னை நினைக்காமலும்,","poem":1},{"lineBreak":true},{"text":"எருசலேமை என்னுடைய முக்கியமான மகிழ்ச்சியிலும் அதிகமாகக் கருதாமலும்போனால்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய நாவு என் மேல் வாயோடு ஒட்டிக்கொள்வதாக.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவே, எருசலேமின் நாளில் ஏதோமியர்களை நினையும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள்: அதை இடித்துப்போடுங்கள், அஸ்திபாரம்வரை இடித்துப்போடுங்கள் என்று சொன்னார்களே.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பாபிலோன் மகளே, பாழாகப்போகிறவளே,","poem":1},{"lineBreak":true},{"text":"நீ எங்களுக்குச் செய்தபடி உனக்குப் பதில் செய்கிறவன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உன்னுடைய குழந்தைகளைப் பிடித்து,","poem":1},{"lineBreak":true},{"text":"கல்லின்மேல் மோதியடிக்கிறவன் பாக்கியவான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}