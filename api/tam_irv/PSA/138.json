{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"உம்மை என் முழு இருதயத்தோடும் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"தெய்வங்களுக்கு முன்பாக உம்மைப் புகழ்ந்து பாடுவேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உமது பரிசுத்த ஆலயத்திற்கு நேராக நான் பணிந்து,","poem":1},{"lineBreak":true},{"text":"உமது கிருபையினிமித்தமும் உமது உண்மையினிமித்தமும் உமது பெயரைத் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"உமது எல்லாப் புகழைவிட உமது வார்த்தையை நீர் மகிமைப்படுத்தியிருக்கிறீர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் கூப்பிட்ட நாளிலே எனக்கு மறுஉத்திரவு அருளினீர்;","poem":1},{"lineBreak":true},{"text":"என் ஆத்துமாவிலே பெலன்தந்து என்னைத் தைரியப்படுத்தினீர்;","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, பூமியின் ராஜாக்களெல்லோரும்","poem":1},{"lineBreak":true},{"text":"உமது வாயின் வார்த்தைகளைக் கேட்கும்போது உம்மைத் துதிப்பார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவின் மகிமை பெரிதாக இருப்பதினால்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் யெகோவாவின் வழிகளைப் பாடுவார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா உயர்ந்தவராக இருந்தும்,","poem":1},{"lineBreak":true},{"text":"தாழ்மையுள்ளவனை நோக்கிப் பார்க்கிறார்;","poem":1},{"lineBreak":true},{"text":"மேட்டிமையானவனையோ தூரத்திலிருந்து அறிகிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நான் துன்பத்தின் நடுவில் நடந்தாலும் நீர் என்னை உயிர்ப்பிப்பீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகளின் கோபத்திற்கு விரோதமாக உமது கையை நீட்டுவீர்;","poem":1},{"lineBreak":true},{"text":"உமது வலதுகரம் என்னை இரட்சிக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா எனக்காக யாவையும் செய்து முடிப்பார்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உமது கிருபை என்றுமுள்ளது;","poem":1},{"lineBreak":true},{"text":"உமது கரத்தின் செயல்களைத் தள்ளிவிடாமலிரும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}