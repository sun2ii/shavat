{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["இராகத்தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நீர் என்னை ஆராய்ந்து,","poem":1},{"lineBreak":true},{"text":"அறிந்திருக்கிறீர்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய உட்காருதலையும்","poem":1},{"lineBreak":true},{"text":"என்னுடைய எழுந்திருக்குதலையும் நீர் அறிந்திருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய நினைவுகளைத் தூரத்திலிருந்து அறிகிறீர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் நடந்தாலும் படுத்திருந்தாலும் என்னைச் சூழ்ந்திருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வழிகளெல்லாம் உமக்குத் தெரியும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய நாவில் சொல் உருவாகுமுன்னே,","poem":1},{"lineBreak":true},{"text":"இதோ, யெகோவாவே, அதையெல்லாம் நீர் அறிந்திருக்கிறீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"முற்புறத்திலும் பிற்புறத்திலும் நீர் என்னை நெருக்கி,","poem":1},{"lineBreak":true},{"text":"உமது கரத்தை என்மேல் வைக்கிறீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இந்த அறிவு எனக்கு மிகுந்த ஆச்சரியமும்,","poem":1},{"lineBreak":true},{"text":"எனக்கு எட்டாத உயரமுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உம்முடைய ஆவிக்கு மறைவாக எங்கே போவேன்?","poem":1},{"lineBreak":true},{"text":"உம்முடைய சமுகத்தைவிட்டு எங்கே ஓடுவேன்?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நான் வானத்திற்கு ஏறினாலும், நீர் அங்கே இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"நான் பாதாளத்தில் படுக்கை போட்டாலும், நீர் அங்கேயும் இருக்கிறீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நான் விடியற்காலத்துச் இறக்கைகளை எடுத்து,","poem":1},{"lineBreak":true},{"text":"கடலின் கடைசி எல்லைகளிலே போய்த் தங்கினாலும்,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அங்கேயும் உமது கை என்னை நடத்தும்,","poem":1},{"lineBreak":true},{"text":"உமது வலதுகரம் என்னைப் பிடிக்கும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"இருள் என்னை மூடிக்கொள்ளுமென்றாலும், இரவும் என்னைச் சுற்றி வெளிச்சமாக இருக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உமக்கு மறைவாக இருளும் இருளாக இருக்காது;","poem":1},{"lineBreak":true},{"text":"இரவும் பகலைப்போல வெளிச்சமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"உமக்கு இருளும் வெளிச்சமும் ஒன்றானது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீர் என்னுடைய சிந்தையைக் கைக்கொண்டிருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய தாயின் கர்ப்பத்தில் என்னைக் காப்பாற்றினீர்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நான் பிரமிக்கத்தக்க அதிசயமாக உண்டாக்கப்பட்டதால், உம்மைத் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"உமது செயல்கள் அதிசயமானவைகள்;","poem":1},{"lineBreak":true},{"text":"அது என்னுடைய ஆத்துமாவுக்கு நன்றாகத் தெரியும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நான் ஒளிப்பிடத்திலே உண்டாக்கப்பட்டு,","poem":1},{"lineBreak":true},{"text":"பூமியின் தாழ்விடங்களிலே விசித்திர விநோதமாக உருவாக்கப்பட்டபோது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எலும்புகள் உமக்கு மறைவாக இருக்கவில்லை.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"என்னுடைய கருவை உம்முடைய கண்கள் கண்டது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உறுப்புகளில் ஒன்றாகிலும் இல்லாதபோதே அவைகள் அனைத்தும்,","poem":1},{"lineBreak":true},{"text":"அவைகள் உருவேற்படும் நாட்களும்,","poem":1},{"lineBreak":true},{"text":"உமது புத்தகத்தில் எழுதியிருந்தது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தேவனே, உமது ஆலோசனைகள் எனக்கு எத்தனை அருமையானவைகள்;","poem":1},{"lineBreak":true},{"text":"அவைகளின் அளவு எவ்வளவு அதிகம்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவைகளை நான் எண்ணப்போனால்,","poem":1},{"lineBreak":true},{"text":"மணலைவிட அதிகமாம்; நான் விழிக்கும்போது இன்னும் உம்மருகில் இருக்கிறேன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தேவனே, நீர் துன்மார்க்கனை அழித்தீரானால் நலமாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"இரத்தப்பிரியர்களே, நீங்கள் என்னை விட்டு அகன்றுபோங்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவர்கள் உம்மைக் குறித்துத் துன்மார்க்கமாகப் பேசுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய எதிரிகள் உமது பெயரை வீணாக வழங்குகிறார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்மைப் பகைக்கிறவர்களை நான் பகைக்காமலும்,","poem":1},{"lineBreak":true},{"text":"உமக்கு விரோதமாக எழும்புகிறவர்களை","poem":1},{"lineBreak":true},{"text":"அருவருக்காமலும் இருப்பேனோ?","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"முழுப்பகையாக அவர்களைப் பகைக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"அவர்களை எனக்குப் பகைவர்களாக நினைக்கிறேன்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தேவனே, என்னை ஆராய்ந்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயத்தை அறிந்துகொள்ளும்;","poem":1},{"lineBreak":true},{"text":"என்னைச் சோதித்து, என்னுடைய சிந்தனைகளை அறிந்துகொள்ளும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"வேதனை உண்டாக்கும் வழி என்னிடத்தில் உண்டோ என்று பார்த்து,","poem":1},{"lineBreak":true},{"text":"நித்திய வழியிலே என்னை நடத்தும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}