{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":14,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவன் இல்லை என்று மதிகேடன் தன்னுடைய இருதயத்தில் சொல்லிக்கொள்ளுகிறான்.","poem":1},{"lineBreak":true},{"text":"அவர்கள் தங்களைக்கெடுத்து, அருவருப்பான செயல்களைச் செய்துவருகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நன்மைசெய்கிறவன் ஒருவனும் இல்லை.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தேவனைத் தேடுகிற உணர்வுள்ளவன் உண்டோ என்று பார்க்க,","poem":1},{"lineBreak":true},{"text":"யெகோவா பரலோகத்திலிருந்து மனிதர்களை கண்ணோக்கினார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"எல்லோரும் வழிவிலகி, ஒன்றாகக் கெட்டுப்போனார்கள்;","poem":1},{"lineBreak":true},{"text":"நன்மை செய்கிறவன் இல்லை, ஒருவன்கூட இல்லை.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரர்களில் ஒருவனுக்கும் அறிவு இல்லையோ?","poem":1},{"lineBreak":true},{"text":"அப்பத்தை விழுங்குகிறதுபோல, என்னுடைய மக்களை விழுங்குகிறார்களே;","poem":1},{"lineBreak":true},{"text":"அவர்கள் யெகோவாவை தொழுதுகொள்ளுகிறதில்லை.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அங்கே அவர்கள் மிகவும் பயந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"தேவன் நீதிமானுடைய சந்ததியோடு இருக்கிறாரே.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ஏழ்மையானவனுக்குக் யெகோவா அடைக்கலமாக இருக்கிறார் என்பதால்,","poem":1},{"lineBreak":true},{"text":"நீங்கள் அவனுடைய ஆலோசனையை அலட்சியம்செய்தீர்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"சீயோனிலிருந்து இஸ்ரவேலுக்கு இரட்சிப்பு வருவதாக;","poem":1},{"lineBreak":true},{"text":"யெகோவா தம்முடைய மக்களின் சிறையிருப்பைத் திருப்பும்போது,","poem":1},{"lineBreak":true},{"text":"யாக்கோபுக்குச் சந்தோஷமும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலுக்கு மகிழ்ச்சியும் உண்டாகும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}