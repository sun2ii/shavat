{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["இராகத்தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, பொல்லாத மனிதனுக்கு என்னைத் தப்புவியும்;","poem":1},{"lineBreak":true},{"text":"கொடுமையுள்ளவனுக்கு என்னை விலக்கி காப்பாற்றும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய இருதயத்தில் பொல்லாப்புகளைச் சிந்தித்து,","poem":1},{"lineBreak":true},{"text":"யுத்தஞ்செய்ய நாள்தோறும் கூட்டங்கூடுகிறார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பாம்பைப்போல் தங்களுடைய நாவை கூர்மையாக்குகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் உதடுகளின்கீழ் விரியன் பாம்பின் விஷம் இருக்கிறது. (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, துன்மார்க்கனுடைய கைகளுக்கு என்னை நீங்கலாக்கி","poem":1},{"lineBreak":true},{"text":"கொடியவனுக்கு என்னை விலக்கி காப்பாற்றும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் என்னுடைய நடைகளைக் கவிழ்க்கப்பார்க்கிறார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பெருமைக்காரர்கள் எனக்குக் கண்ணியையும்","poem":1},{"lineBreak":true},{"text":"கயிறுகளையும் மறைவாக வைக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"வழியோரத்திலே வலையை விரித்து, எனக்குச் சுருக்குகளை வைக்கிறார்கள். (சேலா)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் யெகோவாவை நோக்கி: நீர் என் தேவன் என்றேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய விண்ணப்பங்களின் சத்தத்திற்குச் செவிகொடும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஆண்டவராகிய யெகோவாவே, என்னுடைய இரட்சிப்பின் பெலனே,","poem":1},{"lineBreak":true},{"text":"யுத்தநாளில் என்னுடைய தலையை மூடினீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவே, துன்மார்க்கனுடைய ஆசைகள் நிறைவேறாதபடிசெய்யும்;","poem":1},{"lineBreak":true},{"text":"அவன் தன்னை உயர்த்தாதபடி அவனுடைய யோசனையை நடந்தேற விடாமலிரும். (சேலா)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என்னை வளைந்துகொள்ளுகிறவர்களுடைய உதடுகளின் தீவினைகள் அவர்கள் தலைகளையே மூடுவதாக.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நெருப்புத்தழல் அவர்கள்மேல் விழுவதாக;","poem":1},{"lineBreak":true},{"text":"நெருப்பிலும், அவர்கள் எழுந்திருக்கமுடியாத படுகுழிகளிலும் தள்ளப்படுவார்களாக.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பொல்லாத நாக்குள்ளவன் பூமியிலே நிலைப்பதில்லை;","poem":1},{"lineBreak":true},{"text":"கொடுமையான மனிதனை பறக்கடிக்கப் பொல்லாப்பு அவனை வேட்டையாடும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"சிறுமையானவனின் வழக்கையும்,","poem":1},{"lineBreak":true},{"text":"எளியவர்களின் நியாயத்தையும் யெகோவா விசாரிப்பாரென்று அறிவேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீதிமான்கள் உமது பெயரைத் துதிப்பார்கள்;","poem":1},{"lineBreak":true},{"text":"செம்மையானவர்கள் உமது சமுகத்தில் வாசம் செய்வார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}