{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உம்மை நோக்கிக் கூப்பிடுகிறேன்,","poem":1},{"lineBreak":true},{"text":"என்னிடத்திற்கு விரைந்துவாரும்;","poem":1},{"lineBreak":true},{"text":"நான் உம்மை நோக்கிக் கூப்பிடும்போது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய சத்தத்திற்குச் செவிகொடும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பம் உமக்கு முன்பாகத் தூபமாகவும்,","poem":1},{"lineBreak":true},{"text":"என் கையுயர்த்துதல் மாலைநேரப் பலியாகவும் இருக்கட்டும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய வாய்க்குக் காவல்வையும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உதடுகளின் வாசலைக் காத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அக்கிரமஞ்செய்கிற மனிதரோடு துன்மார்க்கச் செயல்களை நடப்பிக்கும்படி","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயத்தைத்","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கத்திற்கு இசைந்துப்போகச் செய்யாமல் இரும்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய ருசியுள்ள உணவுகளில் ஒன்றையும் நான் சாப்பிடாமல் இருப்பேனாக.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீதிமான் என்னைத் தயவாய்க்குட்டி,","poem":1},{"lineBreak":true},{"text":"என்னைக் கடிந்துகொள்ளட்டும்;","poem":1},{"lineBreak":true},{"text":"அது என்னுடைய தலைக்கு எண்ணெயைப்போலிருக்கும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய தலை அதை நிராகரிப்பதில்லை;","poem":1},{"lineBreak":true},{"text":"அவர்கள் இக்கட்டுகளில் நான் இன்னும் ஜெபம்செய்வேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர்களுடைய நியாயாதிபதிகள் கன்மலை மேலிருந்து","poem":1},{"lineBreak":true},{"text":"தள்ளப்பட்டுபோகிறபோது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வார்த்தைகள் இன்பமானவைகளென்று கேட்பார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"பூமியின்மேல் ஒருவன் மரத்தை வெட்டிப் பிளக்கிறதுபோல,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய எலும்புகள் பாதாள வாய்க்கு நேராகச் சிதறடிக்கப்பட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆனாலும் ஆண்டவராகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கண்கள் உம்மை நோக்கி இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உம்மை நம்பியிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவை வெறுமையாக விடாதிரும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர்கள் எனக்கு வைத்த கண்ணியின் சிக்குகளுக்கும்,","poem":1},{"lineBreak":true},{"text":"அக்கிரமக்காரர்களின் சுருக்குகளுக்கும் என்னை விலக்கி பாதுகாத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் தங்களுடைய வலைகளில் அகப்படுவார்களாக;","poem":1},{"lineBreak":true},{"text":"நானோ அதற்குத் தப்பிக் கடந்துபோவேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}