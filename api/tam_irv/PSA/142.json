{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["குகையிலிருந்த போது தாவீதின் பாடல், ஜெபம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவை நோக்கிச் சத்தமிட்டுக் கூப்பிடுகிறேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நோக்கிச் சத்தமிட்டுக் கெஞ்சுகிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவருக்கு முன்பாக என்னுடைய சஞ்சலத்தை ஊற்றுகிறேன்;","poem":1},{"lineBreak":true},{"text":"அவருக்கு முன்பாக என்னுடைய நெருக்கத்தை அறிக்கையிடுகிறேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆவி என்னில் தியங்கும்போது,","poem":1},{"lineBreak":true},{"text":"நீர் என்னுடைய பாதையை அறிந்திருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"நான் நடக்கிற வழியில் மறைவாக எனக்குக் கண்ணிவைத்தார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"வலதுபக்கமாகக் கண்ணோக்கிப் பாரும்,","poem":1},{"lineBreak":true},{"text":"என்னை அறிவார் ஒருவரும் இல்லை;","poem":1},{"lineBreak":true},{"text":"எனக்கு அடைக்கலமில்லாமற் போனது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவை விசாரிப்பார் ஒருவரும் இல்லை.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்மை நோக்கிக் கூப்பிடுகிறேன்;","poem":1},{"lineBreak":true},{"text":"நீரே என் அடைக்கலமும்,","poem":1},{"lineBreak":true},{"text":"உயிருள்ளோர் தேசத்திலே என்னுடைய பங்குமாக இருக்கிறீர் என்றேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என்னுடைய கூக்குரலுக்குச் செவிகொடும்,","poem":1},{"lineBreak":true},{"text":"நான் மிகவும் தாழ்த்தப்பட்டேன்;","poem":1},{"lineBreak":true},{"text":"என்னைப் பின்தொடருகிறவர்களுக்கு என்னைத் தப்புவியும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் என்னிலும் பலவான்களாக இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உமது பெயரை நான் துதிக்கும்படி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவைக் காவலுக்கு நீங்கலாக்கிவிடும்;","poem":1},{"lineBreak":true},{"text":"எனக்கு நீர் தயவு செய்யும்போது","poem":1},{"lineBreak":true},{"text":"நீதிமான்கள் என்னைச் சூழ்ந்துகொள்ளுவார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}