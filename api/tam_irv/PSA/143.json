{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என்னுடைய ஜெபத்தைக் கேளும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பங்களுக்குச் செவிகொடும்;","poem":1},{"lineBreak":true},{"text":"உமது உண்மையின்படியும் உமது நீதியின்படியும் எனக்கு உத்திரவு அருளிச்செய்யும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உயிருள்ள ஒருவனும் உமக்கு முன்பாக நீதிமானாக இல்லாததினாலே,","poem":1},{"lineBreak":true},{"text":"அடியேனை நியாயத்தீர்ப்புச் செய்யாமல் இரும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"எதிரி என்னுடைய ஆத்துமாவைத் தொடர்ந்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உயிரைத் தரையோடு நசுக்கி,","poem":1},{"lineBreak":true},{"text":"வெகுகாலத்திற்கு முன்பு இறந்தவர்கள்போல் என்னை இருளில் இருக்கச்செய்கிறான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆவி என்னில் தியங்குகிறது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயம் எனக்குள் சோர்ந்துபோகிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஆரம்பநாட்களை நினைக்கிறேன், உமது செய்கைகளையெல்லாம் தியானிக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"உமது கரத்தின் செயல்களை யோசிக்கிறேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என்னுடைய கைகளை உமக்கு நேராக விரிக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"வறண்ட நிலத்தைப்போல் என்னுடைய ஆத்துமா உம்மேல் தாகமாக இருக்கிறது. (சேலா)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவே, சீக்கிரமாக எனக்குச் செவிகொடும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆவி சோர்ந்து போகிறது;","poem":1},{"lineBreak":true},{"text":"நான் குழியில் இறங்குகிறவர்களுக்கு ஒப்பாகாதபடிக்கு,","poem":1},{"lineBreak":true},{"text":"உமது முகத்தை எனக்கு மறைக்காமல் இரும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அதிகாலையில் உமது கிருபையைக் கேட்கச்செய்யும்,","poem":1},{"lineBreak":true},{"text":"உம்மை நம்பியிருக்கிறேன்,","poem":1},{"lineBreak":true},{"text":"நான் நடக்கவேண்டிய வழியை எனக்குக் காண்பியும்;","poem":1},{"lineBreak":true},{"text":"உம்மிடத்தில் என்னுடைய ஆத்துமாவை உயர்த்துகிறேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய எதிரிகளுக்கு என்னைத் தப்புவியும்;","poem":1},{"lineBreak":true},{"text":"உம்மைப் புகலிடமாகக் கொள்ளுகிறேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உமக்குப் பிரியமானதைச் செய்ய எனக்குப் போதித்தருளும்,","poem":1},{"lineBreak":true},{"text":"நீரே என் தேவன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய நல்ல ஆவி என்னைச் செம்மையான வழியிலே நடத்தட்டும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய பெயரினிமித்தம் என்னை உயிர்ப்பியும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய நீதியின்படி என்னுடைய ஆத்துமாவை","poem":1},{"lineBreak":true},{"text":"பிரச்சனைகளுக்கு நீங்கலாக்கிவிடும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உம்முடைய கிருபையின்படி என்னுடைய எதிரிகளை அழித்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவை ஒடுக்குகிற யாவரையும் அழியும்;","poem":1},{"lineBreak":true},{"text":"நான் உமது அடியேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}