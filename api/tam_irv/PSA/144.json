{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என்னுடைய கைகளைப் போருக்கும்","poem":1},{"lineBreak":true},{"text":"என்னுடைய விரல்களை யுத்தத்திற்கும் படிப்பிக்கிற என்னுடைய கன்மலையாகிய யெகோவாவுக்கு நன்றி.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர் என்னுடைய தயாபரரும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கோட்டையும், என்னுடைய உயர்ந்த அடைக்கலமும்,","poem":1},{"lineBreak":true},{"text":"என்னை விடுவிக்கிறவரும், என்னுடைய கேடகமும்,","poem":1},{"lineBreak":true},{"text":"நான் நம்பினவரும், என்னுடைய மக்களை எனக்குக் கீழ்ப்படுத்துகிறவருமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே, மனிதனை நீர் கவனிக்கிறதற்கும்,","poem":1},{"lineBreak":true},{"text":"மனுபுத்திரனை நீர் எண்ணுகிறதற்கும், அவன் எம்மாத்திரம்?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மனிதன் மாயைக்கு ஒப்பாக இருக்கிறான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய நாட்கள் கடந்துபோகிற நிழலுக்குச் சமானம்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் உமது வானங்களைத் தாழ்த்தி இறங்கி,","poem":1},{"lineBreak":true},{"text":"மலைகள் புகையும்படி அவைகளைத் தொடும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மின்னல்களை வரவிட்டு எதிரிகளைச் சிதறடியும்,","poem":1},{"lineBreak":true},{"text":"உமது அம்புகளை எய்து அவர்களைக் கலங்கச்செய்யும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உயரத்திலிருந்து உமது கரத்தை நீட்டி,","poem":1},{"lineBreak":true},{"text":"பெருவெள்ளத்திற்கு என்னை விலக்கி இரட்சியும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மாயையைப் பேசும் வாயும்,","poem":1},{"lineBreak":true},{"text":"கள்ளத்தனமான வலதுகையும் உடைய அந்நியர்களின் கைக்கு","poem":1},{"lineBreak":true},{"text":"என்னை விலக்கித் தப்புவியும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நான் உமக்குப் புதுப்பாட்டைப் பாடுவேன்;","poem":1},{"lineBreak":true},{"text":"தம்புரினாலும் பத்து நரம்பு வீணையினாலும் உம்மைப் புகழ்ந்து பாடுவேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நீரே ராஜாக்களுக்கு ஜெயத்தைத் தந்து,","poem":1},{"lineBreak":true},{"text":"ஊழியனாகிய தாவீதைப் பொல்லாத வாளுக்குத் தப்புவிக்கிறவர்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மாயையைப் பேசும் வாயும், கள்ளத்தனமான வலதுகையும் உடைய அந்நியர்களின் கைக்கு என்னை விலக்கித் தப்புவியும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அப்பொழுது எங்களுடைய மகன்கள் இளமையில் ஓங்கி வளருகிற மரக்கன்றுகளைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய மகள்கள் சித்திரந்தீர்ந்த அரண்மனை மூலைக்கற்களைப்போலவும் இருப்பார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"எங்களுடைய களஞ்சியங்கள் எல்லாவித பொருட்களையும் கொடுக்கத்தக்கதாக நிரம்பியிருக்கும்;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய கிராமங்களில் எங்களுடைய ஆடுகள் ஆயிரமும் பத்தாயிரமாகப் பலுகும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"எங்களுடைய எருதுகள் பலத்தவைகளாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"எதிரி உட்புகுதலும் குடியோடிப்போகுதலும் இருக்காது;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய வீதிகளில் கூக்குரலும் உண்டாகாது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இந்த வித ஆசீர்வாதத்தைப்பெற்ற மக்கள் பாக்கியமுள்ளவர்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை தெய்வமாகக் கொண்டிருக்கிற மக்கள் பாக்கியமுள்ளது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}