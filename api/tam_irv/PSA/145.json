{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் நன்றிப்பாடல்."]},{"type":"verse","number":1,"content":[{"text":"ராஜாவாகிய என் தேவனே, உம்மை உயர்த்தி,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பெயரை எப்பொழுதும் என்றென்றைக்கும் நன்றிசொல்லுவேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நாள்தோறும் உமக்கு நன்றிசெலுத்தி,","poem":1},{"lineBreak":true},{"text":"எப்பொழுதும் என்றென்றைக்கும் உம்முடைய பெயரைத் துதிப்பேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவா பெரியவரும் மிகவும் புகழப்படத்தக்கவருமாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய மகத்துவம் ஆராய்ந்து முடியாது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தலைமுறை தலைமுறையாக உம்முடைய செயல்களின் புகழ்ச்சியைச் சொல்லி,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வல்லமையுள்ள செய்கைகளை அறிவிப்பார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்முடைய சிறந்த மகிமைப் பிரதாபத்தையும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய அதிசயமான செயல்களையுங்குறித்துப் பேசுவேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மக்கள் உம்முடைய பயங்கரமான செயல்களின் வல்லமையைச் சொல்லுவார்கள்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய மகத்துவத்தை நான் விவரிப்பேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர்கள் உமது மிகுந்த தயவை நினைத்து வெளிப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"உமது நீதியைக் கெம்பீரித்துப் பாடுவார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா இரக்கமும் மன உருக்கமும்,","poem":1},{"lineBreak":true},{"text":"நீடிய சாந்தமும் மிகுந்த கிருபையும் உள்ளவர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவா எல்லோர்மேலும் தயவுள்ளவர்;","poem":1},{"lineBreak":true},{"text":"அவர் இரக்கங்கள் அவருடைய எல்லாச் செயல்களின்மேலுமுள்ளது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய செயல்களெல்லாம் உம்மைத் துதிக்கும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பரிசுத்தவான்கள் உமக்கு நன்றி சொல்வார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மனிதர்களுக்கு உமது வல்லமையுள்ள செய்கைகளையும்,","poem":1},{"lineBreak":true},{"text":"உமது ராஜ்ஜியத்தின் சிறந்த மகிமைப்பிரதாபத்தையும் தெரிவிக்கும்படிக்கு;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உமது ராஜ்ஜியத்தின் மகிமையை அறிவித்து,","poem":1},{"lineBreak":true},{"text":"உமது வல்லமையைக் குறித்துப் பேசுவார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"உம்முடைய ராஜ்ஜியம் எல்லாக் காலங்களிலுமுள்ள ராஜ்ஜியம்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய ஆளுகை தலைமுறை தலைமுறையாகவும் உள்ளது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவா விழுகிற அனைவரையும் தாங்கி,","poem":1},{"lineBreak":true},{"text":"மடங்கடிக்கப்பட்ட அனைவரையும் தூக்கிவிடுகிறார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"எல்லா உயிர்களின் கண்களும் உம்மை நோக்கிக்கொண்டிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"ஏற்ற வேளையிலே நீர் அவைகளுக்கு உணவுகொடுக்கிறீர்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நீர் உமது கையைத் திறந்து,","poem":1},{"lineBreak":true},{"text":"எல்லா உயிர்களின் வாஞ்சையையும் திருப்தியாக்குகிறீர்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"யெகோவா தமது வழிகளிலெல்லாம் நீதியுள்ளவரும்,","poem":1},{"lineBreak":true},{"text":"தமது செயல்களிலெல்லாம் கிருபையுள்ளவருமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"தம்மை நோக்கிக் கூப்பிடுகிற அனைவருக்கும்,","poem":1},{"lineBreak":true},{"text":"உண்மையாகத் தம்மை நோக்கிக் கூப்பிடுகிற அனைவருக்கும்,","poem":1},{"lineBreak":true},{"text":"யெகோவா அருகில் இருக்கிறார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவர் தமக்குப் பயந்தவர்களுடைய விருப்பத்தின்படி செய்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் கூப்பிடுதலைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"அவர்களைப் பாதுகாக்கிறார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"யெகோவா தம்மில் அன்புகூருகிற அனைவரையும் காப்பாற்றி,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் அனைவரையும் அழிப்பார்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"என்னுடைய வாய் யெகோவாவின் துதியைச் சொல்வதாக;","poem":1},{"lineBreak":true},{"text":"மாம்ச சரீரமுள்ள யாவும் அவருடைய பரிசுத்த பெயரை","poem":1},{"lineBreak":true},{"text":"எப்பொழுதும் என்றென்றைக்கும் போற்றட்டும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}