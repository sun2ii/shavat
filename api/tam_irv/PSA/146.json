{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா, என்னுடைய ஆத்துமாவே,","poem":1},{"lineBreak":true},{"text":"யெகோவாவை துதி.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நான் உயிரோடிருக்கும்வரை யெகோவாவை துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"நான் உள்ளளவும் என் தேவனைப் புகழ்ந்து பாடுவேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பிரபுக்களையும், இரட்சிக்கப் பெலனில்லாத மனிதர்களையும் நம்பவேண்டாம்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவனுடைய ஆவி பிரியும், அவன் தன்னுடைய மண்ணுக்குத் திரும்புவான்;","poem":1},{"lineBreak":true},{"text":"அந்த நாளிலே அவனுடைய யோசனைகள் அழிந்துபோகும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யாக்கோபின் தேவனைத் தன் துணையாகக் கொண்டிருந்து,","poem":1},{"lineBreak":true},{"text":"தன் தேவனாகிய யெகோவாமேல் நம்பிக்கையை வைக்கிறவன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் வானத்தையும் பூமியையும் கடல்களையும் அவைகளிலுள்ள அனைத்தையும் உண்டாக்கினவர்;","poem":1},{"lineBreak":true},{"text":"அவர் என்றென்றைக்கும் உண்மையைக் காக்கிறவர்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் ஒடுக்கப்பட்டவர்களுக்கு நியாயஞ்செய்கிறார்;","poem":1},{"lineBreak":true},{"text":"பசியாக இருக்கிறவர்களுக்கு உணவுகொடுக்கிறார்;","poem":1},{"lineBreak":true},{"text":"கட்டப்பட்டவர்களைக் யெகோவா விடுதலையாக்குகிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"குருடர்களின் கண்களைக் யெகோவா திறக்கிறார்;","poem":1},{"lineBreak":true},{"text":"விழுந்தவர்களைக் யெகோவா தூக்கிவிடுகிறார்.","poem":1},{"lineBreak":true},{"text":"நீதிமான்களைக் யெகோவா நேசிக்கிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அந்நியர்களைக் யெகோவா காப்பாற்றுகிறார்;","poem":1},{"lineBreak":true},{"text":"அவர் திக்கற்ற பிள்ளையையும் விதவையையும் ஆதரிக்கிறார்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களின் வழியையோ கவிழ்த்துப் போடுகிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவா எல்லாக் காலங்களிலும் அரசாளுகிறார்;","poem":1},{"lineBreak":true},{"text":"சீயோனே, உன்னுடைய தேவன் தலைமுறை தலைமுறையாகவும் ராஜரிகம்செய்கிறார்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}