{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவை துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேவனைப் புகழ்ந்து பாடுகிறது நல்லது,","poem":1},{"lineBreak":true},{"text":"துதித்தலே இன்பமும் ஏற்றதுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா எருசலேமைக் கட்டுகிறார்;","poem":1},{"lineBreak":true},{"text":"துரத்தப்பட்ட இஸ்ரவேலர்களைக் கூட்டிச் சேர்க்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"இருதயம் நொறுங்குண்டவர்களைக் குணமாக்குகிறார்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய காயங்களைக் கட்டுகிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் நட்சத்திரங்களின் தொகையை எண்ணி,","poem":1},{"lineBreak":true},{"text":"அவைகளுக்கெல்லாம் பெயரிட்டு அழைக்கிறார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நம்முடைய ஆண்டவர் பெரியவரும் மகா பெலமுள்ளவருமாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய அறிவு அளவில்லாதது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா சாந்தகுணமுள்ளவர்களை உயர்த்துகிறார்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களைத் தரைவரை தாழ்த்துகிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவை துதியுடன் பாடிக்கொண்டாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேவனைச் சுரமண்டலத்தால் புகழ்ந்து பாடுங்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் வானத்தை மேகங்களால் மூடி,","poem":1},{"lineBreak":true},{"text":"பூமிக்கு மழையை ஆயத்தப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"மலைகளில் புல்லை முளைக்கச்செய்கிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் மிருகங்களுக்கும் கூப்பிடுகிற காக்கைக் குஞ்சுகளுக்கும் ஆகாரங்கொடுக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர் குதிரையின் பலத்தில் விருப்பமாக இருக்கமாட்டார்;","poem":1},{"lineBreak":true},{"text":"வீரனுடைய கால்களில் பிரியப்படமாட்டார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தமக்குப் பயந்து, தமது கிருபைக்குக் காத்திருக்கிறவர்கள்மேல்","poem":1},{"lineBreak":true},{"text":"யெகோவா பிரியமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"எருசலேமே, யெகோவாவுக்கு நன்றி சொல்;","poem":1},{"lineBreak":true},{"text":"சீயோனே, உன்னுடைய தேவனைத் துதி.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவர் உன்னுடைய வாசல்களின் தாழ்ப்பாள்களைப் பலப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"உன்னிடத்திலுள்ள உன்னுடைய பிள்ளைகளை ஆசீர்வதிக்கிறார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர் உன்னுடைய எல்லைகளைச் சமாதானமுள்ளவைகளாக மாற்றி,","poem":1},{"lineBreak":true},{"text":"செழிப்பான கோதுமையினால் உன்னைத் திருப்தியாக்குகிறார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவர் தமது வார்த்தையைப் பூமியிலே அனுப்புகிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய சொல் மகா விரைவாக செல்லுகிறது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"பஞ்சைப்போல் உறைந்த மழையைத் தருகிறார்;","poem":1},{"lineBreak":true},{"text":"சாம்பலைப்போல உறைந்த பனியைத் தூவுகிறார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவர் தமது கல்மழையைத் துணிக்கைகளாக அனுப்புகிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய குளிருக்கு முன்பாக நிற்பவன் யார்?","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவர் தமது வார்த்தையை அனுப்பி, அவைகளை உருகச்செய்கிறார்;","poem":1},{"lineBreak":true},{"text":"தமது காற்றை வீசும்படி செய்ய, தண்ணீர்கள் ஓடும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"யாக்கோபுக்குத் தம்முடைய வசனங்களையும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலுக்குத் தமது பிரமாணங்களையும் தமது நியாயங்களையும் அறிவிக்கிறார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவர் வேறே எந்த தேசத்திற்கும் இப்படிச் செய்ததில்லை;","poem":1},{"lineBreak":true},{"text":"அவருடைய கட்டளைகளை அறியாமற் போகிறார்கள்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}