{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா, வானங்களில் உள்ளவைகளே,","poem":1},{"lineBreak":true},{"text":"யெகோவாவை துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"உன்னதங்களில் அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவருடைய தூதர்களே,","poem":1},{"lineBreak":true},{"text":"நீங்கள் அனைவரும் அவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய சேனைகளே, நீங்கள் அனைவரும் அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"சூரிய சந்திரரே, அவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"பிரகாசமுள்ள எல்லா நட்சத்திரங்களே, அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"வானாதி வானங்களே, அவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"வானத்தின் மேலுள்ள தண்ணீர்களே,","poem":1},{"lineBreak":true},{"text":"அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவைகள் யெகோவாவின் பெயரைத் துதிக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"அவர் கட்டளையிட அவைகள் சிருஷ்டிக்கப்பட்டது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் அவைகளை என்றைக்குமுள்ள எல்லாகாலங்களிலும் நிலைக்கும்படி செய்தார்;","poem":1},{"lineBreak":true},{"text":"மாறாத கட்டளையை அவைகளுக்கு நியமித்தார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"பூமியிலுள்ளவைகளே, யெகோவாவை துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"பெரிய மீன்களே, எல்லா ஆழங்களே,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அக்கினியே, கல்மழையே, உறைந்த மழையே, மூடுபனியே,","poem":1},{"lineBreak":true},{"text":"அவர் சொற்படி செய்யும் பெருங்காற்றே,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மலைகளே, எல்லா மேடுகளே, கனிமரங்களே,","poem":1},{"lineBreak":true},{"text":"எல்லா கேதுருக்களே,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"காட்டுமிருகங்களே, எல்லா நாட்டு மிருகங்களே,","poem":1},{"lineBreak":true},{"text":"ஊரும் பிராணிகளே, இறகுள்ள பறவைகளே,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பூமியின் ராஜாக்களே, எல்லா மக்களே, பிரபுக்களே,","poem":1},{"lineBreak":true},{"text":"பூமியிலுள்ள எல்லா நியாயாதிபதிகளே,","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"வாலிபரே, கன்னிகைகளே, முதிர் வயதுள்ளவர்களே, பிள்ளைகளே,","poem":1},{"lineBreak":true},{"text":"யெகோவாவை துதியுங்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவர்கள் யெகோவாவின் பெயரைத் துதிக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"அவருடைய பெயர் மட்டும் உயர்ந்தது;","poem":1},{"lineBreak":true},{"text":"அவருடைய மகிமை பூமிக்கும் வானத்திற்கும் மேலானது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய பரிசுத்தவான்கள் அனைவருக்கும்,","poem":1},{"lineBreak":true},{"text":"தம்மைச் சேர்ந்த மக்களாகிய இஸ்ரவேல் மக்களுக்கும் கொண்டாட்டமாக,","poem":1},{"lineBreak":true},{"text":"தம்முடைய மக்களுக்கு ஒரு கொம்பை உயர்த்தினார்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}