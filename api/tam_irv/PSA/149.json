{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா, யெகோவாவுக்குப் புதுப்பாட்டைப் பாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"பரிசுத்தவான்களின் சபையிலே அவருடைய துதி வெளிப்படட்டும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"இஸ்ரவேல் தன்னை உண்டாக்கினவரில் மகிழவும்,","poem":1},{"lineBreak":true},{"text":"மகன்களாகிய சீயோன் தங்களுடைய ராஜாவில் சந்தோஷப்படட்டும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவருடைய பெயரை நடனத்தோடு துதித்து,","poem":1},{"lineBreak":true},{"text":"தம்புரினாலும் கின்னரத்தினாலும் அவரை புகழ்ந்துபாட வேண்டும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவா தம்முடைய மக்களின்மேல் பிரியம் வைக்கிறார்;","poem":1},{"lineBreak":true},{"text":"சாந்தகுணமுள்ளவர்களை இரட்சிப்பினால் அலங்கரிப்பார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பரிசுத்தவான்கள் மகிமையோடு சந்தோஷப்பட்டு,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய படுக்கைகளின்மேல் கெம்பீரிப்பார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தேசங்களிடத்தில் பழிவாங்கவும், மக்களைத் தண்டிக்கவும்,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர்களுடைய ராஜாக்களைச் சங்கிலிகளாலும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய மேன்மக்களை இரும்பு விலங்குகளாலும் கட்டவும்,","poem":1},{"lineBreak":true},{"text":"எழுதப்பட்ட நியாயத்தீர்ப்பை அவர்கள்மேல் செலுத்தவும்,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர்களுடைய வாயில் யெகோவாவை உயர்த்தும் துதியும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய கையில் இருபுறமும் கூர்மையுள்ள வாளும் இருக்கும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"இந்த மரியாதை அவருடைய பரிசுத்தவான்கள் அனைவருக்கும் உண்டாகும்.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}