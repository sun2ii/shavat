{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, யார் உம்முடைய கூடாரத்தில் தங்குவான்?","poem":1},{"lineBreak":true},{"text":"யார் உம்முடைய பரிசுத்த மலையில் குடியிருப்பான்?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உத்தமனாக நடந்து, நீதியை நடத்தி,","poem":1},{"lineBreak":true},{"text":"மனதாரச் சத்தியத்தைப் பேசுகிறவன்தானே.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவன் தன்னுடைய நாவினால் புறங்கூறாமலும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய நண்பனுக்குத் தீங்குசெய்யாமலும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய அயலான்மேல் சொல்லப்படும் அவமானமான பேச்சை எடுக்காமலும் இருக்கிறான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ஆகாதவன் அவன் பார்வைக்கு அற்பமானவன்; யெகோவாவுக்குப் பயந்தவர்களையோ மதிக்கிறான்; ஆணையிட்டதில் தனக்கு நஷ்டம் வந்தாலும் தவறாமலிருக்கிறான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தன்னுடைய பணத்தை வட்டிக்குக் கொடுக்காமலும், குற்றமில்லாதவனுக்கு விரோதமாக லஞ்சம் வாங்காமலும் இருக்கிறான். இப்படிச் செய்கிறவன் என்றென்றைக்கும் அசைக்கப்படுவதில்லை.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}