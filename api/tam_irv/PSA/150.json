{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா, தேவனை அவருடைய பரிசுத்தஸ்தலத்தில் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய வல்லமை வெளிப்படும் வானத்தைப்பார்த்து அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவருடைய வல்லமையுள்ள செயல்களுக்காக அவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"மாட்சிமை பொருந்திய அவருடைய மகத்துவத்திற்காக அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"எக்காளச் சத்தத்தோடு அவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"வீணையோடும் சுரமண்டலத்தோடும் அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தம்புரோடும் நடனத்தோடும் அவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"யாழோடும் தீங்குழலோடும் அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஓசையுள்ள கைத்தாளங்களோடும் அவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"பேரோசையுள்ள கைத்தாளங்களோடும் அவரைத் துதியுங்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"சுவாசமுள்ள அனைத்தும் யெகோவாவை துதிப்பதாக.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}