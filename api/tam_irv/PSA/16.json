{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் மிக்தாம் என்னும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, என்னைக் காப்பாற்றும், உம்மை நம்பியிருக்கிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என் நெஞ்சமே, நீ யெகோவாவை நோக்கி:","poem":1},{"lineBreak":true},{"text":"தேவனே நீர், என் ஆண்டவராக இருக்கிறீர்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய செல்வம் உமக்கு வேண்டியதாக இல்லாமல்;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பூமியிலுள்ள பரிசுத்தவான்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"நான் என்னுடைய முழுப் பிரியத்தையும் வைத்திருக்கிற மகாத்துமாக்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"அது வேண்டியதாக இருக்கிறது என்று சொன்னாய்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அந்நியதேவனை நாடிப் பின்பற்றுகிறவர்களுக்கு வேதனைகள் பெருகும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் செலுத்துகிற இரத்த பானபலிகளை நான் செலுத்தமாட்டேன்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய பெயர்களை என் உதடுகளினால் உச்சரிக்கவுமாட்டேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவா என்னுடைய சுதந்தரமும் என்னுடைய பாத்திரத்தின் பங்குமானவர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய சுதந்தரத்தை தேவனே நீர் காப்பாற்றுகிறீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நேர்த்தியான இடங்களில் எனக்குப் பங்கு கிடைத்தது;","poem":1},{"lineBreak":true},{"text":"ஆம், சிறப்பான பங்கு எனக்கு உண்டு.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"எனக்கு ஆலோசனை தந்த யெகோவாவை துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"இரவுநேரங்களிலும் என்னுடைய உள்மனம் என்னை உணர்த்தும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவை எப்பொழுதும் எனக்கு முன்பாக வைத்திருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"அவர் என்னுடைய வலதுபக்கத்தில் இருக்கிறபடியால்","poem":1},{"lineBreak":true},{"text":"நான் அசைக்கப்படுவதில்லை.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஆகையால் என்னுடைய இருதயம் பூரித்தது, என்னுடைய மகிமை சந்தோஷித்து;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உடலும் நம்பிக்கையோடு தங்கியிருக்கும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவைப் பாதாளத்தில் விடமாட்டீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பரிசுத்தவான் அழிவைக் காண்பதில்லை.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"வாழ்வின்வழியை எனக்குத் தெரியப்படுத்துவீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய சமுகத்தில் பரிபூரண ஆனந்தமும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வலதுபக்கத்தில் நித்திய பேரின்பமும் உண்டு.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}