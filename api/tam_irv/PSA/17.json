{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் ஜெபம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நியாயத்தைக் கேட்டருளும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கூப்பிடுதலைக் கவனியும்;","poem":1},{"lineBreak":true},{"text":"பொய்களில்லாத உதடுகளிலிருந்து பிறக்கும்","poem":1},{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பத்திற்குச் செவிகொடும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உம்முடைய சந்நிதியிலிருந்து என்னுடைய நியாயம் வெளிப்படுவதாக;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கண்கள் நியாயமானவைகளைப் பார்ப்பதாக.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீர் என்னுடைய இருதயத்தைப் பரிசோதித்து,","poem":1},{"lineBreak":true},{"text":"இரவுநேரத்தில் அதை விசாரித்து, என்னைப் புடமிட்டுப்பார்த்தும்","poem":1},{"lineBreak":true},{"text":"ஒன்றும் காணாமலிருக்கிறீர்;","poem":1},{"noteId":1},{"text":"என்னுடைய வாய் மீறாதபடி தீர்மானம் செய்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மனிதரின் செய்கைகளைக்குறித்து, நான் உம்முடைய உதடுகளின் வாக்கினாலே","poem":1},{"lineBreak":true},{"text":"தீயவர்களுடைய பாதைகளுக்கு விலக்கி என்னைக் காத்துக்கொள்ளுகிறேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என்னுடைய நடைகள் உமது வழிகளில் உறுதிப்பட்டன.","poem":1},{"lineBreak":true},{"text":"என்னுடைய காலடிகள் வழுகிப்போகவில்லை.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தேவனே, நான் உம்மை நோக்கிக் கெஞ்சுகிறேன்,","poem":1},{"lineBreak":true},{"text":"ஏனெனில் நீர் எனக்குப் பதில்கொடுப்பீர். என்னிடத்தில் உம்முடைய செவியைச் சாய்த்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வார்த்தையைக் கேட்டருளும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உம்மிடம் அடைக்கலமாக வருபவர்களை அவர்களுக்கு விரோதமாக எழும்புகிறவர்களிடத்திலிருந்து","poem":1},{"lineBreak":true},{"text":"உமது வலதுகையினால் தப்புவித்து காப்பாற்றுகிறவரே!","poem":1},{"lineBreak":true},{"text":"உம்முடைய அதிசயமான கிருபையை விளங்கச்செய்யும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"கண்மணியைப்போல் என்னைக் காத்து.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என்னை ஒடுக்குகிற துன்மார்க்கர்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"என்னைச் சூழ்ந்துகொள்ளுகிற என்னை தாக்கும் எதிரிகளுக்கு மறைவாக,","poem":1},{"lineBreak":true},{"text":"உம்முடைய இறக்கைகளின் நிழலிலே என்னைக் காப்பாற்றும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்கள் கொழுத்துப்போய்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய வாயினால் கர்வமாக பேசுகிறார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நாங்கள் செல்லும் பாதைகளில் இப்பொழுது எங்களை வளைந்துகொண்டார்கள்;","poem":1},{"lineBreak":true},{"text":"எங்களைத் தரையிலே தள்ளும்படி அவர்கள் கண்கள் எங்களை பார்த்துக்கொண்டிருக்கின்றன.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பீறுகிறதற்கு ஆவலுள்ள சிங்கத்திற்கும்,","poem":1},{"lineBreak":true},{"text":"மறைவிடங்களில் ஒளிந்திருக்கிற பாலசிங்கத்திற்கும் ஒப்பாக இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய பட்டயத்தினால்","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவைத் துன்மார்க்கனுடைய கைக்கு தப்புவியும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவாவே, மனிதருடைய கைக்கும்,","poem":1},{"lineBreak":true},{"text":"இம்மையில் தங்களுடைய பங்கைப் பெற்றிருக்கிற இவ்வுலக மக்களின் கைக்கும்","poem":1},{"lineBreak":true},{"text":"உம்முடைய கையினால் என்னைத் தப்புவியும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் வயிற்றை உமது செழிப்பினால் நிரப்புகிறீர்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் குழந்தைச்செல்வத்தினால் திருப்தியடைந்து,","poem":1},{"lineBreak":true},{"text":"தங்களுக்கு மீதியான பொருளைத் தங்களுடைய பிள்ளைகளுக்கு விட்டுச்செல்கிறார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நானோ நீதியில் உம்முடைய முகத்தைத் பார்ப்பேன்;","poem":1},{"lineBreak":true},{"text":"நான் விழிக்கும்போது உமது சாயலால் திருப்தியாவேன்.","poem":1}]}],"footnotes":[{"noteId":1,"caller":"+","text":"மற்றவர்களைப் போல தீமை பேசுகிறதில்லை.","reference":{"chapter":17,"verse":3}}]},"thisChapterLink":"/api/tam_irv/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}