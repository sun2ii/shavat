{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":18,"content":[{"type":"hebrew_subtitle","content":["இசைத் தலைவனுக்கு யெகோவாவுடைய ஊழியனாகிய தாவீது எழுதிய பாடல். சவுலிடமிருந்தும் பிற பகைவர்களிடமிருந்தும் யெகோவா அவனைத் தப்புவித்தபோது எழுதப்பட்ட பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என் பெலனாகிய யெகோவாவே, உம்மில் அன்புகூருவேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா என் கன்மலையும், என் கோட்டையும்,","poem":1},{"lineBreak":true},{"text":"என் இரட்சகரும், என் தேவனும், நான் அடைக்கலம் புகும் என் கோபுரமும்,","poem":1},{"lineBreak":true},{"text":"என் கேடகமும், என் இரட்சிப்பின் கொம்பும்,","poem":1},{"lineBreak":true},{"text":"என் உயர்ந்த அடைக்கலமுமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"துதிக்குப் பாத்திரராகிய யெகோவாவை நோக்கிக் கூப்பிடுவேன்;","poem":1},{"lineBreak":true},{"text":"அதனால் என்னுடைய எதிரிகளுக்கு நீங்கலாகிப் பாதுகாக்கப்படுவேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மரணக்கட்டுகள் என்னைச் சுற்றிக்கொண்டன; மாபெரும் அலைகள் என்னைப் பயப்படுத்தினது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பாதாளக்கட்டுகள் என்னைச் சூழ்ந்துகொண்டன;","poem":1},{"lineBreak":true},{"text":"மரணக் கண்ணிகள் என்மேல் விழுந்தன.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"எனக்கு உண்டான நெருக்கத்திலே யெகோவாவை நோக்கிக் கூப்பிட்டேன்,","poem":1},{"lineBreak":true},{"text":"என் தேவனை நோக்கி சத்தமிட்டேன்; தமது ஆலயத்திலிருந்து என்னுடைய சத்தத்தைக் கேட்டார்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கூப்பிடுதல் அவர் சந்நிதியில் போய்,","poem":1},{"lineBreak":true},{"text":"அவர் காதுகளில் விழுந்தது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் கோபங்கொண்டபடியால் பூமி அசைந்து அதிர்ந்தது,","poem":1},{"lineBreak":true},{"text":"மலைகளின் அஸ்திபாரங்கள் குலுங்கி அசைந்தன.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் மூக்கிலிருந்து புகை எழும்பிற்று,","poem":1},{"lineBreak":true},{"text":"அவர் வாயிலிருந்து எரியும் நெருப்பு புறப்பட்டது;","poem":1},{"lineBreak":true},{"text":"அதனால் தழல் மூண்டது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வானங்களைத் தாழ்த்தி இறங்கினார்;","poem":1},{"lineBreak":true},{"text":"அவர் பாதங்களின்கீழ் காரிருள் இருந்தது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"கேருபீன்மேல்","poem":1},{"noteId":2},{"text":"ஏறி வேகமாகச் சென்றார்;","poem":1},{"lineBreak":true},{"text":"காற்றின் இறக்கைகளைக் கொண்டு பறந்தார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"இருளைத் தமக்கு மறைவிடமாக்கினார்;","poem":1},{"lineBreak":true},{"text":"தண்ணீர் நிறைந்த கறுத்த மழைமேகங்களையும் தம்மை சூழ்ந்திருக்கும் கூடாரமாக்கினார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவருடைய சந்நிதிப் பிரகாசத்தினால் அவருடைய மேகங்கள்,","poem":1},{"lineBreak":true},{"text":"கல்மழையும் நெருப்புத்தழலையும் பொழிந்தன.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவா வானங்களிலே குமுறினார்,","poem":1},{"lineBreak":true},{"text":"உன்னதமான தேவனானவர் தமது சத்தத்தைத் தொனிக்கச்செய்தார்;","poem":1},{"lineBreak":true},{"noteId":3},{"text":"கல்மழையும் நெருப்புத்தழலும் பொழிந்தன.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தம்முடைய அம்புகளை எய்து,","poem":1},{"lineBreak":true},{"text":"அவர்களைச் சிதறடித்தார்;","poem":1},{"lineBreak":true},{"text":"மின்னல்களைப் பயன்படுத்தி, அவர்களைக் கலங்கச்செய்தார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அப்பொழுது யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்முடைய கண்டிப்பினாலும்","poem":1},{"lineBreak":true},{"text":"உம்முடைய மூக்கின் சுவாசக்காற்றினாலும் தண்ணீர்களின் ஆழங்கள் தென்பட்டன,","poem":1},{"lineBreak":true},{"text":"உலகின் அஸ்திபாரங்கள் வெளிப்பட்டன.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உயரத்திலிருந்து அவர் கைநீட்டி, என்னைப் பிடித்து,","poem":1},{"lineBreak":true},{"text":"பெருக்கெடுத்து ஓடும் தண்ணீரிலிருந்து என்னைத் தூக்கிவிட்டார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என்னிலும் பலவான்களாக இருந்த என்னுடைய பலத்த எதிரிகளுக்கும்","poem":1},{"lineBreak":true},{"text":"என்னைப் பகைக்கிறவர்களுக்கும் என்னை விடுவித்தார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆபத்துநாளில் எனக்கு எதிரிட்டு வந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவோ எனக்கு ஆதரவாக இருந்தார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"என்மேல் அவர் பிரியமாக இருந்தபடியால்,","poem":1},{"lineBreak":true},{"text":"விசாலமான இடத்திலே என்னைக் கொண்டுவந்து,","poem":1},{"lineBreak":true},{"text":"என்னைத் தப்புவித்தார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"யெகோவா என்னுடைய நீதிக்குத்தகுந்தபடி எனக்குப் பதிலளித்தார்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கைகளின் சுத்தத்திற்குத்தகுந்தபடி எனக்குச் சரிக்கட்டினார்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ஏனெனில் யெகோவாவுடைய வழிகளைக் கைக்கொண்டுவந்தேன்;","poem":1},{"lineBreak":true},{"text":"நான் என் தேவனைவிட்டுத் துன்மார்க்கமாக விலகினதில்லை.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவருடைய நியாயங்களையெல்லாம் எனக்கு முன்பாக இருக்கின்றன;","poem":1},{"lineBreak":true},{"text":"அவருடைய பிரமாணங்களை நான் தள்ளிப்போடவில்லை.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"உன்னத தேவனுக்கு முன்பாக நான் உத்தமனாக இருந்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாவத்திற்கு என்னை விலக்கிக் காத்துக்கொண்டேன்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஆகையால் யெகோவா என்னுடைய நீதிக்குத் தகுந்ததாகவும்,","poem":1},{"lineBreak":true},{"text":"தம்முடைய கண்களுக்கு முன்னிருக்கிற","poem":1},{"lineBreak":true},{"text":"என்னுடைய கைகளின் சுத்தத்திற்கும் தக்கதாகவும் எனக்குப் பலனளித்தார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"தயவுள்ளவனுக்கு நீர் தயவுள்ளவராகவும்,","poem":1},{"lineBreak":true},{"text":"உத்தமனுக்கு நீர் உத்தமராகவும்;","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"புனிதனுக்கு நீர் புனிதராகவும்,","poem":1},{"lineBreak":true},{"text":"மாறுபாடுள்ளவனுக்கு நீர் மாறுபடுகிறவராகவும் தோன்றுவீர்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"தேவனே நீர் பாதிக்கப்பட்ட மக்களை காப்பாற்றுவீர்;","poem":1},{"lineBreak":true},{"text":"மேட்டிமையான கண்களைத் தாழ்த்துவீர்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"தேவனே நீர் என்னுடைய விளக்கை ஏற்றுவீர்;","poem":1},{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவா என்னுடைய இருளை வெளிச்சமாக்குவார்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"உம்மாலே ஒரு சேனையை என் கால்களால் மிதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"என் தேவனாலே ஒரு மதிலைத் தாண்டுவேன்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"தேவனுடைய வழி உத்தமமானது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய வசனம் புடமிடப்பட்டது;","poem":1},{"lineBreak":true},{"text":"தம்மை நம்புகிற அனைவருக்கும் அவர் கேடகமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"யெகோவாவை தவிர தேவன் யார்?","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேவன் இல்லாமல் கன்மலையும் யார்?","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"என்னைப் பலத்தால் இடைகட்டி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வழியைச் செவ்வைப்படுத்துகிறவர் தேவனே.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"அவர் என் கால்களை மான்களுடைய கால்களைப்போலாக்கி,","poem":1},{"lineBreak":true},{"text":"உயர்வான இடங்களில் என்னை நிறுத்துகிறார்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"வெண்கல வில்லும் என்னுடைய கைகளால் வளையும்படி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கைகளை யுத்தத்திற்குப் பழக்குவிக்கிறார்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"உம்முடைய இரட்சிப்பின் கேடகத்தையும் எனக்குத் தந்தீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வலதுகை என்னைத் தாங்குகிறது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கருணை என்னைப் பெரியவனாக்கும்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"என்னுடைய கால்கள் வழுக்காதபடி, நான் நடக்கிற வழியை அகலமாக்கினீர்.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகளைப் பின்தொடர்ந்து,","poem":1},{"lineBreak":true},{"text":"அவர்களைப் பிடித்தேன்;","poem":1},{"lineBreak":true},{"text":"அவர்களை அழிக்கும் வரைக்கும் நான் திரும்பவில்லை.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"அவர்கள் எழுந்திருக்க முடியாதபடி அவர்களை வெட்டினேன்.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"போருக்கு நீர் என்னைப் பலத்தால் இடைகட்டி,","poem":1},{"lineBreak":true},{"text":"என்மேல் எழும்பினவர்களை என் கீழ் மடங்கச்செய்தீர்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"நான் என்னுடைய எதிரியை அழிக்கும்படி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகளின் கழுத்தை எனக்கு ஒப்புக்கொடுத்தீர்.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"அவர்கள் கூப்பிடுகிறார்கள்,","poem":1},{"lineBreak":true},{"text":"அவர்களைக் காப்பாற்றுகிறவர்கள் ஒருவருமில்லை;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நோக்கிக் கூப்பிடுகிறார்கள்,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு அவர் பதிலளிக்கிறதில்லை.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"நான் அவர்களைக் காற்றின்திசையிலே பறக்கிற தூசியாக இடித்து,","poem":1},{"lineBreak":true},{"text":"தெருக்களிலுள்ள சேற்றைப்போல் அவர்களை எறிந்துபோடுகிறேன்.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"மக்களின் கலகங்களுக்கு நீர் என்னைத் தப்புவித்தீர்,","poem":1},{"lineBreak":true},{"text":"தேசங்களுக்கு என்னைத் தலைவனாக்குகிறீர்;","poem":1},{"lineBreak":true},{"text":"நான் அறியாத மக்கள் எனக்கு சேவைசெய்கிறார்கள்.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"அவர்கள் என்னுடைய சத்தத்தைக் கேட்டவுடனே எனக்குக் கீழ்ப்படிகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அந்நியரும் என்னிடம் கூனிக்குறுகுகிறார்கள்.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"அந்நியர் மனமடிந்து, தங்களுடைய அரண்களிலிருந்து தத்தளிப்பாகப் புறப்படுகிறார்கள்.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"யெகோவா உயிருள்ளவர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கன்மலையானவர் துதிக்கப்படுவாராக;","poem":1},{"lineBreak":true},{"text":"என்னுடைய இரட்சிப்பின் தேவன் உயர்ந்திருப்பாராக.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"அவர் எனக்காகப் பழிக்குப் பழிவாங்குகிற தேவன்.","poem":1},{"lineBreak":true},{"text":"அவர் மக்களை எனக்குக் கீழ்ப்படுத்துகிறவர்.","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"அவரே என்னுடைய எதிரிகளுக்கு என்னை விலக்கி விடுவிக்கிறவர்;","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாக எழும்புகிறவர்களைவிட என்னை நீர் உயர்த்தி,","poem":1},{"lineBreak":true},{"text":"கொடுமையான மனிதனுக்கு என்னைத் தப்புவிக்கிறீர்.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"இதற்காக யெகோவாவே, தேசங்களுக்குள்ளே உம்மைத் துதித்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பெயருக்கு பாட்டு பாடுவேன்.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"தாம் ஏற்படுத்தின இராஜாவுக்கு மகத்தான இரட்சிப்பை அளித்து,","poem":1},{"lineBreak":true},{"text":"தாம் அபிஷேகம்செய்த தாவீதிற்கும்","poem":1},{"lineBreak":true},{"text":"அவனுடைய சந்ததிக்கும் என்றென்றும் கிருபை செய்கிறார்.","poem":1}]}],"footnotes":[{"noteId":2,"caller":"+","text":"கேருபீன்கள், யெகோவாவின் சிங்காசனத்தை சுற்றி பாதுக்காக்கும் பரலோக இறக்கைகளுடைய சிருஷ்டிகள்","reference":{"chapter":18,"verse":10}},{"noteId":3,"caller":"+","text":"சில கையெழுத்துப்பிரதிகளில் காணப்படவில்லை","reference":{"chapter":18,"verse":13}}]},"thisChapterLink":"/api/tam_irv/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}