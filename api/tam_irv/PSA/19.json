{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["இசைத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"வானங்கள் தேவனுடைய மகிமையை வெளிப்படுத்துகின்றன,","poem":1},{"lineBreak":true},{"text":"ஆகாய விரிவு அவருடைய கைகளின் செயல்களை அறிவிக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"பகலுக்குப் பகல் வார்த்தைகளைப் பொழிகிறது,","poem":1},{"lineBreak":true},{"text":"இரவுக்கு இரவு அறிவைத் தெரிவிக்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவைகளுக்குப் பேச்சுமில்லை, வார்த்தையுமில்லை,","poem":1},{"lineBreak":true},{"text":"அவைகளின் சத்தம் கேட்கப்படுவதுமில்லை.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ஆகிலும் அவைகளின் சத்தம் பூமியெங்கும்,","poem":1},{"lineBreak":true},{"text":"அவைகளின் வசனங்கள் உலகின் கடைசிவரைக்கும் செல்லுகின்றன;","poem":1},{"lineBreak":true},{"text":"அவைகளில் சூரியனுக்கு ஒரு கூடாரத்தை உண்டாக்கினார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அது தன்னுடைய மணவறையிலிருந்து புறப்படுகிற மணவாளனைப்போல் இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"பெலசாலியைப்போல் தன்னுடைய பாதையில் ஓட மகிழ்ச்சியாக இருக்கிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அது வானங்களின் ஒரு முனையிலிருந்து புறப்பட்டு,","poem":1},{"lineBreak":true},{"text":"அவைகளின் மறுமுனைவரைக்கும் சுற்றியோடுகிறது;","poem":1},{"lineBreak":true},{"text":"அதின் வெப்பத்திற்கு மறைவானது ஒன்றுமில்லை.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய வேதம் குறைவற்றதும்,","poem":1},{"lineBreak":true},{"text":"ஆத்துமாவை உயிர்ப்பிக்கிறதுமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய சாட்சி முழுமையானதும்,","poem":1},{"lineBreak":true},{"text":"பேதையை ஞானியாக்குகிறதுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய நியாயங்கள் செம்மையும்,","poem":1},{"lineBreak":true},{"text":"இருதயத்தைச் சந்தோஷப்படுத்துகிறவைகளுமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய கற்பனை தூய்மையும், கண்களைத் தெளிவிக்கிறதுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிற பயம் சுத்தமும்,","poem":1},{"lineBreak":true},{"text":"என்றைக்கும் நிலைக்கிறதுமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய நியாயங்கள் உண்மையும்,","poem":1},{"lineBreak":true},{"text":"அவைகள் அனைத்தும் நீதியுமாக இருக்கின்றன.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவை பொன்னிலும், மிகுந்த பசும்பொன்னிலும் விரும்பப்படத்தக்கவையும்,","poem":1},{"lineBreak":true},{"text":"தேனிலும் தேன்கூட்டிலிருந்து ஒழுகும் தூய்மையான தேனிலும் மதுரமுள்ளவையுமாக இருக்கின்றன.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அன்றியும் அவைகளால் உமது அடியேன் எச்சரிக்கப்படுகிறேன்;","poem":1},{"lineBreak":true},{"text":"அவைகளைக் கைக்கொள்ளுகிறதினால் மிகுந்த பலன் உண்டு.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தன்னுடைய பிழைகளை உணருகிறவன் யார்?","poem":1},{"lineBreak":true},{"text":"மறைந்து கிடக்கும் பிழைகளிலிருந்து என்னைச் சுத்திகரியும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"துணிகரமான பாவங்களுக்கும் உமது அடியேனை விலக்கிக் காத்துகொள்ளும்;","poem":1},{"lineBreak":true},{"text":"அவைகள் என்னை ஆண்டுகொள்ள விடாமலிரும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நான் உத்தமனாகி,","poem":1},{"lineBreak":true},{"text":"பெரும்பாவத்திற்கு நீங்கலாக இருப்பேன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"என் கன்மலையும் என் மீட்பருமாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"என் வாயின் வார்த்தைகளும்,","poem":1},{"lineBreak":true},{"text":"என் இருதயத்தின் தியானமும்,","poem":1},{"lineBreak":true},{"text":"உமது சமுகத்திற்குப் பிரியமாக இருப்பதாக.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}