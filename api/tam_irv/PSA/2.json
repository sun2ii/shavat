{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"தேசங்கள் ஏன் கொந்தளிக்க வேண்டும்?","poem":1},{"lineBreak":true},{"text":"மக்கள் வீணான காரியத்தை ஏன் சிந்திக்கவேண்டும்?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்கு விரோதமாகவும்,","poem":1},{"lineBreak":true},{"text":"அவர் அபிஷேகம்செய்தவருக்கு விரோதமாகவும்,","poem":1},{"lineBreak":true},{"text":"பூமியின் இராஜாக்கள் எழும்பி நின்று,","poem":1},{"lineBreak":true},{"text":"அதிகாரிகள் ஒன்றாக ஆலோசனைசெய்து:","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர்களுடைய கட்டுகளை அறுத்து,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய கயிறுகளை நம்மைவிட்டு எறிந்துபோடுவோம்; என்கிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"பரலோகத்தில் அமர்ந்திருக்கிறவர் சிரிப்பார்;","poem":1},{"lineBreak":true},{"text":"ஆண்டவர் அவர்களை இகழுவார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அப்பொழுது அவர் தமது கோபத்திலே அவர்களுடன் பேசுவார்.","poem":1},{"lineBreak":true},{"text":"தமது கடுங்கோபத்திலே அவர்களைக் கலங்கச்செய்வார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் என்னுடைய பரிசுத்தமலையாகிய சீயோனில் என்னுடைய இராஜாவை அபிஷேகம்செய்து வைத்தேன் என்றார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தீர்மானத்தின் விவரம் சொல்லுவேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவா என்னை நோக்கி, நீர் என்னுடைய மகன்,","poem":1},{"lineBreak":true},{"text":"இன்று நான் உம்மை பிறக்கச்செய்தேன்;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னைக் கேளும், அப்பொழுது தேசங்களை உமக்குச் சொத்தாகவும்,","poem":1},{"lineBreak":true},{"text":"பூமியின் எல்லைகளை உமக்குச் சொந்தமாகவும் கொடுப்பேன்;","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"இரும்புக் கோலால் அவர்களை நொறுக்கி,","poem":1},{"lineBreak":true},{"text":"குயவனின் மண்பாண்டத்தைப்போல் அவர்களை உடைத்துப்போடுவீர் என்று சொன்னார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இப்போதும் இராஜாக்களே, உணர்வடையுங்கள்,","poem":1},{"lineBreak":true},{"text":"பூமியின் நியாயாதிபதிகளே, எச்சரிக்கையாக இருங்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பயத்துடனே யெகோவாவுக்கு ஆராதனை செய்யுங்கள்,","poem":1},{"lineBreak":true},{"text":"நடுக்கத்துடனே மகிழ்ந்திருங்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தேவமகன் கோபங்கொள்ளாமலும், நீங்கள் வழியிலே அழியாமலும் இருப்பதற்கு,","poem":1},{"lineBreak":true},{"text":"தேவனை முத்தம்செய்யுங்கள்;","poem":1},{"lineBreak":true},{"text":"கொஞ்சக்காலத்திலே தேவனுடைய கோபம் பற்றியெரியும்;","poem":1},{"lineBreak":true},{"text":"அவரிடம் அடைக்கலமாக இருக்கிற அனைவரும் பாக்கியவான்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}