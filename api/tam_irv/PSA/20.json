{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["இசைத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"ஆபத்துநாளிலே யெகோவா உமது விண்ணப்பத்திற்குப் பதில்கொடுப்பாராக;","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் தேவனுடைய பெயர் உமக்கு உயர்ந்த அடைக்கலமாவதாக.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர் பரிசுத்த ஸ்தலத்திலிருந்து உமக்கு ஒத்தாசையனுப்பி,","poem":1},{"lineBreak":true},{"text":"சீயோனிலிருந்து உம்மை ஆதரிப்பாராக.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீர் செலுத்தும் காணிக்கைகளையெல்லாம் அவர் நினைத்து,","poem":1},{"lineBreak":true},{"text":"உமது சர்வாங்க தகனபலியைப் பிரியமாக ஏற்றுக்கொள்வாராக. (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் உமது மனவிருப்பத்தின்படி உமக்குத் தந்தருளி,","poem":1},{"lineBreak":true},{"text":"உமது ஆலோசனைகளையெல்லாம் நிறைவேற்றுவாராக.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நாங்கள் உமது இரட்சிப்பினால் மகிழ்ந்து, எங்கள் தேவனுடைய பெயரிலே கொடியேற்றுவோம்;","poem":1},{"lineBreak":true},{"text":"உமது வேண்டுதல்களையெல்லாம் யெகோவா நிறைவேற்றுவாராக.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா தாம் அபிஷேகம்செய்தவரைக் காப்பாற்றுகிறார்","poem":1},{"lineBreak":true},{"text":"என்பதை இப்பொழுது அறிந்திருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"தமது வலதுகை செய்யும் இரட்சிப்பின் வல்லமைகளைக் காண்பித்து,","poem":1},{"lineBreak":true},{"text":"தமது பரிசுத்த வானத்திலிருந்து","poem":1},{"lineBreak":true},{"text":"அவருடைய விண்ணப்பத்திற்கு பதில்கொடுப்பார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"சிலர் இரதங்களைக்குறித்தும்,","poem":1},{"lineBreak":true},{"text":"சிலர் குதிரைகளைக்குறித்தும் மேன்மை பாராட்டுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நாங்களோ எங்கள் தேவனாகிய யெகோவாவுடைய பெயரைக்குறித்தே மேன்மைபாராட்டுவோம்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர்கள் முறிந்து விழுந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"நாங்களோ எழுந்து நிமிர்ந்து நிற்கிறோம்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவே, இரட்சியும்;","poem":1},{"lineBreak":true},{"text":"நாங்கள் கூப்பிடுகிற நாளிலே ராஜா எங்களுக்குச் செவிகொடுப்பாராக.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}