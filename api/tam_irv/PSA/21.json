{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["இசைத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உம்முடைய வல்லமையிலே இராஜா மகிழ்ச்சியாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய இரட்சிப்பிலே எவ்வளவாகச் சந்தோஷப்படுகிறார்!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவருடைய மனவிருப்பத்தின்படி நீர் அவருக்குத் தந்தருளி,","poem":1},{"lineBreak":true},{"text":"அவருடைய உதடுகளின் விண்ணப்பத்தைத் தள்ளாமலிருக்கிறீர். (சேலா)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உத்தம ஆசீர்வாதங்களோடு நீர் அவருக்கு எதிர்கொண்டுவந்து,","poem":1},{"lineBreak":true},{"text":"அவர் தலையில் பொற்கிரீடம் அணிவிக்கிறீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் உம்மிடத்தில் ஆயுளைக்கேட்டார்;","poem":1},{"lineBreak":true},{"text":"நீர் அவருக்கு என்றென்றைக்குமுள்ள நீடித்த ஆயுளை அளித்தீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உமது இரட்சிப்பினால் அவர் மகிமை பெரிதாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"மேன்மையையும் மகத்துவத்தையும் அவருக்கு கொடுத்தீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர் நீடித்த ஆசீர்வாதங்களை அவர்களுக்கு கொடுக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவரை உம்முடைய சமுகத்தின் மகிழ்ச்சியினால் பூரிப்பாக்குகிறீர்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஏனெனில் இராஜா யெகோவாமேல் நம்பிக்கையாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"உன்னதமான தேவனுடைய தயவினால் அசைக்கப்படாமல் இருப்பார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"உமது கை உமது எதிரிகள் எல்லோரையும் எட்டிப்பிடிக்கும்;","poem":1},{"lineBreak":true},{"text":"உமது வலதுகரம் உம்மைப் பகைக்கிறவர்களைக் கண்டுபிடிக்கும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உமது கோபத்தின் காலத்திலே","poem":1},{"lineBreak":true},{"text":"அவர்களை நெருப்புச் சூளையாக்கிப்போடுவீர்;","poem":1},{"lineBreak":true},{"text":"யெகோவா தமது கோபத்திலே அவர்களை அழிப்பார்;","poem":1},{"lineBreak":true},{"text":"நெருப்பு அவர்களை அழிக்கும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்கள் பிள்ளைகளை பூமியிலிருந்தும்","poem":1},{"lineBreak":true},{"text":"அவர்கள் சந்ததியை மனுமக்களிலிருந்தும் அழிப்பீர்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர்கள் உமக்கு விரோதமாக தீங்கு நினைத்தார்கள்;","poem":1},{"lineBreak":true},{"text":"தீவினை செய்ய முயன்றார்கள்;","poem":1},{"lineBreak":true},{"text":"ஒன்றும் வாய்க்காமல்போனது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உம்முடைய அம்புகளை நாணேற்றி அவர்கள் முகத்திற்கு நேரே எய்து அவர்களைத் திரும்பி ஓடச்செய்கிறீர்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய பலத்திலே நீர் எழுந்தருளும்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது உம்முடைய வல்லமையைப் பாடித் துதிப்போம்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}