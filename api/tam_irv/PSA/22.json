{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["(இசைத் தலைவனுக்கு தாவீது தந்த பாடல்.)"]},{"type":"verse","number":1,"content":[{"text":"என் தேவனே, என் தேவனே, ஏன் என்னைக் கைவிட்டீர்?","poem":1},{"lineBreak":true},{"text":"எனக்கு உதவி செய்யாமலும்,","poem":1},{"lineBreak":true},{"text":"நான் கதறிச் சொல்லும் வார்த்தைகளைக் கேட்காமலும் ஏன் தூரமாக இருக்கிறீர்?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என் தேவனே, நான் பகலிலே கூப்பிடுகிறேன்,","poem":1},{"lineBreak":true},{"text":"பதில் கொடுக்கவில்லை;","poem":1},{"lineBreak":true},{"text":"இரவிலே கூப்பிடுகிறேன், எனக்கு அமைதி இல்லை.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"இஸ்ரவேலின் துதிகளுக்குள் தங்கியிருக்கிற தேவனே நீரே பரிசுத்தர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"எங்களுடைய முன்னோர்கள் உம்மிடத்தில் நம்பிக்கை வைத்தார்கள்;","poem":1},{"lineBreak":true},{"text":"நம்பின அவர்களை நீர் விடுவித்தீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்மை நோக்கிக் கூப்பிட்டுத் தப்பினார்கள்;","poem":1},{"lineBreak":true},{"text":"உம்மை நம்பி வெட்கப்பட்டுப்போகாமல் இருந்தார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நானோ ஒரு புழு, மனிதன் அல்ல;","poem":1},{"lineBreak":true},{"text":"மனிதர்களால் நிந்திக்கப்பட்டும்,","poem":1},{"lineBreak":true},{"text":"மக்களால் அவமதிக்கப்பட்டும் இருக்கிறேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என்னைப் பார்க்கிறவர்களெல்லோரும் என்னைப் பரியாசம்செய்து,","poem":1},{"lineBreak":true},{"text":"உதட்டைப் பிதுக்கி, தலையை அசைத்து:","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாமேல் நம்பிக்கையாக இருந்தானே,","poem":1},{"lineBreak":true},{"text":"அவர் இவனை விடுவிக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"இவன்மேல் பிரியமாக இருக்கிறாரே,","poem":1},{"lineBreak":true},{"text":"இப்பொழுது இவனை இரட்சிக்கட்டும் என்கிறார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நீரே என்னைக் கர்ப்பத்திலிருந்து எடுத்தவர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய தாயின் மார்பில் இருக்கும் போதே என்னை உம்மேல் நம்பிக்கையாக இருக்கச்செய்தீர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"கர்ப்பத்திலிருந்து வெளிப்பட்டபோதே உமது சார்பில் விழுந்தேன்;","poem":1},{"lineBreak":true},{"text":"நான் என்னுடைய தாயின் வயிற்றில் இருந்தது முதல் நீர் என் தேவனாக இருக்கிறீர்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னைவிட்டுத் தூரமாக இருக்கவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"ஆபத்து நெருங்கியிருக்கிறது,","poem":1},{"lineBreak":true},{"text":"உதவி செய்ய யாரும் இல்லை.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அநேகம் காளைகள் என்னைச் சூழ்ந்திருக்கின்றன;","poem":1},{"lineBreak":true},{"text":"பாசான் தேசத்தின் பலத்த எருதுகள் என்னை வளைந்து கொண்டன.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"பீறி கெர்ச்சிக்கிற சிங்கத்தைப்போல்,","poem":1},{"lineBreak":true},{"text":"என்மேல் தங்களுடைய வாயைத் திறக்கிறார்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தண்ணீரைப்போல ஊற்றப்பட்டேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய எலும்புகளெல்லாம் விலகிவிட்டன,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயம் மெழுகுபோலாகி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய குடல்களின் நடுவே உருகினது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என் பெலன்","poem":1},{"noteId":4},{"text":"ஓட்டைப்போல் காய்ந்தது;","poem":1},{"lineBreak":true},{"text":"என் நாவு மேல்வாயோடு ஒட்டிக்கொண்டது;","poem":1},{"lineBreak":true},{"text":"என்னை மரணத்தூசியிலே போடுகிறீர்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நாய்கள் என்னைச் சூழ்ந்திருக்கின்றன;","poem":1},{"lineBreak":true},{"text":"பொல்லாதவர்களின் கூட்டம் என்னை வளைந்துகொண்டது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கைகளையும் கால்களையும் உருவக் குத்தினார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என்னுடைய எலும்புகளையெல்லாம் நான் எண்ணலாம்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் என்னை நோக்கிப் பார்த்துக்கொண்டிருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என் ஆடைகளைத் தங்களுக்குள்ளே பங்கிட்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உடையின்மேல் சீட்டுப்போடுகிறார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ஆனாலும் யெகோவாவே, நீர் எனக்குத் தூரமாக இருக்கவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய பெலனே, எனக்கு உதவிசெய்ய சீக்கிரமாக வாரும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவை வாளிற்கும்,","poem":1},{"lineBreak":true},{"text":"எனக்கு அருமையானதை நாய்களின் கொடூரத்திற்கும் தப்புவியும்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"என்னைச் சிங்கத்தின் வாயிலிருந்து காப்பாற்றும்;","poem":1},{"lineBreak":true},{"text":"நான் காண்டாமிருகத்தின் கொம்புகளில் இருக்கும்போது என்னைக் காப்பாற்றும்","poem":1},{"noteId":5},{"text":".","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"உம்முடைய பெயரை என் சகோதரர்களுக்கு அறிவித்து,","poem":1},{"lineBreak":true},{"text":"சபைநடுவில் உம்மைத் துதிப்பேன்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிறவர்களே,","poem":1},{"lineBreak":true},{"text":"அவரைத் துதியுங்கள்;","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் சந்ததியாரே, நீங்கள் எல்லோரும் அவருக்கு மரியாதைசெய்யுங்கள்;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் வம்சத்தாரே, நீங்கள் எல்லோரும் அவர்மேல் பயபக்தியாக இருங்கள்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"உபத்திரவப்பட்டவனுடைய உபத்திரவத்தை அவர் அற்பமாக நினைக்காமலும்,","poem":1},{"lineBreak":true},{"text":"அருவருக்காமலும், தம்முடைய முகத்தை அவனுக்கு மறைக்காமலுமிருந்து,","poem":1},{"lineBreak":true},{"text":"தம்மை நோக்கி அவன் கூப்பிடும்போது அவனைக் கேட்டருளினார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"மகா சபையிலே நான் செலுத்தும் துதி உம்மாலே உண்டாகும்;","poem":1},{"lineBreak":true},{"text":"அவருக்குப் பயப்படுகிறவர்களுக்கு முன்பாக என்னுடைய பொருத்தனைகளைச் செலுத்துவேன்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"ஒடுக்கப்பட்டவர்கள் சாப்பிட்டு திருப்தியடைவார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை தேடுகிறவர்கள் அவரைத் துதிப்பார்கள்;","poem":1},{"lineBreak":true},{"text":"உங்களுடைய இருதயம் என்றென்றைக்கும் வாழும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"பூமியின் எல்லைகளெல்லாம் நினைவுகூர்ந்து யெகோவாவிடத்தில் திரும்பும்;","poem":1},{"lineBreak":true},{"text":"தேசங்களுடைய வம்சங்களெல்லாம் அவர்","poem":1},{"noteId":6},{"text":"சமுகத்தில் தொழுதுகொள்ளும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ராஜ்ஜியம் யெகோவாவுடையது; அவர் தேசங்களை ஆளுகிறவர்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"பூமியின் செல்வந்தர் அனைவரும்","poem":1},{"noteId":7},{"text":"பணிந்துகொள்வார்கள்;","poem":1},{"lineBreak":true},{"text":"புழுதியில் இறங்குகிறவர்கள் அனைவரும் அவருக்கு முன்பாக வணங்குவார்கள்.","poem":1},{"lineBreak":true},{"text":"ஒருவனும் தன்னுடைய ஆத்துமா அழியாதபடி அதைக் காக்க முடியாதே.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"ஒரு சந்ததி அவரைச் சேவிக்கும்;","poem":1},{"lineBreak":true},{"text":"தலைமுறை தலைமுறையாக அது ஆண்டவருடைய சந்ததி என்னப்படும்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அவர்கள் வந்து: அவரே இவைகளைச் செய்தார் என்று","poem":1},{"lineBreak":true},{"text":"பிறக்கப்போகிற மக்களுக்கு அவருடைய நீதியை அறிவிப்பார்கள்.","poem":1}]}],"footnotes":[{"noteId":4,"caller":"+","text":"தொண்டை","reference":{"chapter":22,"verse":15}},{"noteId":5,"caller":"+","text":"பதில் தரும்","reference":{"chapter":22,"verse":21}},{"noteId":6,"caller":"+","text":"உமது","reference":{"chapter":22,"verse":27}},{"noteId":7,"caller":"+","text":"சாப்பிட்டு","reference":{"chapter":22,"verse":29}}]},"thisChapterLink":"/api/tam_irv/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}