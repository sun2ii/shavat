{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா என் மேய்ப்பராக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"நான் தாழ்ச்சி அடையமாட்டேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர் என்னைப் புல்லுள்ள இடங்களில் மேய்த்து,","poem":1},{"lineBreak":true},{"text":"அமர்ந்த தண்ணீர்கள் அருகில் என்னைக் கொண்டுபோய்விடுகிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் என் ஆத்துமாவைத் தேற்றி, தம்முடைய பெயரினிமித்தம் என்னை நீதியின் பாதைகளில் நடத்துகிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நான் மரண இருளின் பள்ளத்தாக்கிலே நடந்தாலும்","poem":1},{"lineBreak":true},{"text":"பொல்லாப்புக்குப் பயப்படமாட்டேன்;","poem":1},{"lineBreak":true},{"text":"ஏனெனில் தேவனே நீர் என்னோடு இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"உமது கோலும் உமது தடியும் என்னைத் தேற்றும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகளுக்கு முன்பாக நீர் எனக்கு ஒரு பந்தியை ஆயத்தப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய தலையை எண்ணெயால் அபிஷேகம்செய்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாத்திரம் நிரம்பி வழிகிறது","poem":1},{"noteId":8},{"text":".","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என் உயிருள்ள நாளெல்லாம் நன்மையும் கிருபையும் என்னைத் தொடரும்;","poem":1},{"lineBreak":true},{"text":"நான் யெகோவாவுடைய வீட்டிலே நீடித்த நாட்களாக நிலைத்திருப்பேன்.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"லூக்கா 7:46.","reference":{"chapter":23,"verse":5}}]},"thisChapterLink":"/api/tam_irv/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}