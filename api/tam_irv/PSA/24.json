{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"பூமியும் அதின் நிறைவும்,","poem":1},{"lineBreak":true},{"text":"உலகமும் அதிலுள்ள குடிமக்கள் யாவும் யெகோவாவுடையவை.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஏனெனில் அவரே அதைக் கடல்களுக்கு மேலாக அஸ்திபாரப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"அதை நதிகளுக்கு மேலாக நிறுவினார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யார் யெகோவாவுடைய மலையில்","poem":1},{"noteId":9},{"text":"ஏறுவான்?","poem":1},{"lineBreak":true},{"text":"யார் அவருடைய பரிசுத்த இடத்தில் பிரவேசிப்பான்?","poem":1},{"noteId":10}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"கைகளில் சுத்தமுள்ளவனும் இருதயத்தில் தூய்மை உள்ளவனுமாக இருந்து,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய ஆத்துமாவை மாயைக்கு ஒப்புக்கொடுக்காமலும்,","poem":1},{"lineBreak":true},{"text":"பொய்யாக ஆணையிடாமலும் இருக்கிறவனே.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவன் கர்த்தரால் ஆசீர்வாதத்தையும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய இரட்சிப்பின் தேவனால் நீதியையும் பெறுவான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இதுவே அவரைத் தேடி விசாரித்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய சமுகத்தை நாடுகிற யாக்கோபு என்னும் சந்ததி. (சேலா)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"வாசல்களே, உங்களுடைய தலைகளை உயர்த்துங்கள்;","poem":1},{"lineBreak":true},{"text":"நித்திய கதவுகளே, உயருங்கள்; மகிமையின் இராஜா உள்ளே நுழைவார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யார் இந்த மகிமையின் இராஜா?","poem":1},{"lineBreak":true},{"text":"அவர் வல்லமையும் பராக்கிரமமும் உள்ள யெகோவா;","poem":1},{"lineBreak":true},{"text":"அவர் யுத்தத்தில் பராக்கிரமமும் உள்ள கர்த்தராமே.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வாசல்களே, உங்களுடைய தலைகளை உயர்த்துங்கள்;","poem":1},{"lineBreak":true},{"text":"நித்திய கதவுகளே, உயருங்கள், மகிமையின் இராஜா உள்ளே நுழைவார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யார் இந்த மகிமையின் இராஜா?","poem":1},{"lineBreak":true},{"text":"அவர் சேனைகளின் யெகோவா;","poem":1},{"lineBreak":true},{"text":"அவரே மகிமையின் இராஜா (சேலா).","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"இந்த மலையின் மேல் தான் தேவாலயம் கட்டப்பட்டிருந்தது. சீயோன் மலையில் ஏறி ஆலயத்தில் பிரவேசித்தது ஆண்டவரை ஆராதிப்பதாகும்","reference":{"chapter":24,"verse":3}},{"noteId":10,"caller":"+","text":"நிலைநிற்பான்","reference":{"chapter":24,"verse":3}}]},"thisChapterLink":"/api/tam_irv/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}