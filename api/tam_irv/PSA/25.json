{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உம்மிடத்தில் என்னுடைய ஆத்துமாவை உயர்த்துகிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என் தேவனே, உம்மை நம்பி இருக்கிறேன்,","poem":1},{"lineBreak":true},{"text":"நான் வெட்கப்பட்டுப்போகாதபடி செய்யும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் என்னை மேற்கொண்டு மகிழவிடாமலிரும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உம்மை நோக்கிக் காத்திருக்கிற ஒருவரும் வெட்கப்பட்டுப் போகாதபடி செய்யும்;","poem":1},{"lineBreak":true},{"text":"காரணமில்லாமல் துரோகம்செய்கிறவர்களே வெட்கப்பட்டுப் போவார்களாக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய வழிகளை எனக்குத் தெரிவியும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பாதைகளை எனக்குப் போதித்தருளும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்முடைய சத்தியத்திலே என்னை நடத்தி, என்னைப் போதித்தருளும்;","poem":1},{"lineBreak":true},{"text":"நீரே என்னுடைய இரட்சிப்பின் தேவன்,","poem":1},{"lineBreak":true},{"text":"உம்மை நோக்கி நாள்முழுதும் காத்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய இரக்கங்களையும் உம்முடைய கருணையையும் நினைத்தருளும்,","poem":1},{"lineBreak":true},{"text":"அவை தொடக்கமில்லா காலம் முதல் இருக்கின்றது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என்னுடைய இளவயதின் பாவங்களையும் என்னுடைய மீறுதல்களையும் நினைக்காமலிரும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய தயவிற்காக என்னை உமது கிருபையின்படியே நினைத்தருளும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா நல்லவரும் உத்தமருமாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"ஆகையால் பாவிகளுக்கு வழியைத் தெரிவிக்கிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"சாந்த குணமுள்ளவர்களை நியாயத்திலே நடத்தி,","poem":1},{"lineBreak":true},{"text":"சாந்த குணமுள்ளவர்களுக்குத் தமது வழியைப் போதிக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய உடன்படிக்கையையும் அவருடைய சாட்சிகளையும் கைக்கொள்ளுகிறவர்களுக்கு,","poem":1},{"lineBreak":true},{"text":"அவருடைய பாதைகளெல்லாம் கிருபையும் சத்தியமுமானவை.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய அக்கிரமம் பெரிது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பெயரினால் அதை மன்னித்தருளும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுகிற மனிதன் எவனோ","poem":1},{"lineBreak":true},{"text":"அவனுக்குத் தாம் தெரிந்துகொள்ளும் வழியைப் போதிப்பார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவனுடைய ஆத்துமா நன்மையில் தங்கும்;","poem":1},{"lineBreak":true},{"text":"அவன் சந்ததி பூமியைச் சொந்தமாக்கிக்கொள்ளும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய இரகசியம் அவருக்குப் பயந்தவர்களிடத்தில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவர்களுக்குத் தம்முடைய உடன்படிக்கையைத் தெரியப்படுத்துவார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என்னுடைய கண்கள் எப்போதும் யெகோவாவை நோக்கிக்கொண்டிருக்கின்றன;","poem":1},{"lineBreak":true},{"text":"அவரே என்னுடைய கால்களை வலைக்கு நீங்கலாக்கிவிடுவார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"என்மேல் நோக்கமாகி, எனக்கு இரங்கும்;","poem":1},{"lineBreak":true},{"text":"நான் தனித்தவனும், பாதிக்கப்பட்டவனுமாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயத்தின் வியாகுலங்கள் பெருகியிருக்கின்றன;","poem":1},{"lineBreak":true},{"text":"என்னுடைய பிரச்சனைகளிலிருந்து என்னை நீங்கலாக்கிவிடும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என்னுடைய பாதிப்பையையும் என்னுடைய துன்பத்தையும் பார்த்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாவங்களையெல்லாம் மன்னித்தருளும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகளைப் பாரும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் பெருகியிருந்து, கொடூர வெறுப்பாய் என்னை வெறுக்கிறார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என் ஆத்துமாவைக் காப்பாற்றி என்னை விடுவியும்;","poem":1},{"lineBreak":true},{"text":"நான் வெட்கப்பட்டுப்போகாதபடி செய்யும்; உம்மிடம் அடைக்கலம் வந்துள்ளேன்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"உத்தமமும், நேர்மையும் என்னைக் காக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"நான் உமக்குக் காத்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"தேவனே, இஸ்ரவேலை அவனுடைய எல்லாப் பிரச்சனைகளுக்கும் விடுவித்து மீட்டுவிடும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}