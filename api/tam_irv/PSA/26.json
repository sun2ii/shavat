{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என்னை நியாயம் விசாரியும், நான் என் உத்தமத்திலே நடக்கிறேன்; நான் யெகோவாவை நம்பியிருக்கிறேன், ஆகையால் நான் தள்ளாடுவதில்லை.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே, என்னைப் பரீட்சித்து, என்னைச் சோதித்துப்பாரும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய சிந்தைகளையும் என்னுடைய இருதயத்தையும் புடமிட்டுப்பாரும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உம்முடைய கிருபை என்னுடைய கண்களுக்கு முன்பாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய சத்தியத்திலே நடக்கிறேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ஏமாற்றுக்காரர்களோடு நான் உட்காரவில்லை,","poem":1},{"lineBreak":true},{"text":"வஞ்சகரிடத்தில் நான் சேருவதில்லை.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பொல்லாதவர்களின் கூட்டத்தைப் பகைக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களோடு உட்காரமாட்டேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நான் துதியின் சத்தத்தைக் கேட்கும்படிச் செய்து, உம்முடைய அதிசயங்களையெல்லாம் விவரிப்பதற்காக,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"எனது குற்றமில்லாமை தெரியும்படி என் கைகளைக் கழுவி, உம்முடைய பீடத்தைச் சுற்றிவருகிறேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது ஆலயமாகிய வாசஸ்தலத்தையும்,","poem":1},{"lineBreak":true},{"text":"உமது மகிமை தங்கியிருக்கும் இடத்தையும் நேசிக்கிறேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என் ஆத்துமாவைப் பாவிகளோடும்,","poem":1},{"lineBreak":true},{"text":"என் உயிரை இரத்தப்பிரியர்களோடும் வாரிக்கொள்ளாமலிரும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்கள் கைகளிலே தீவினை இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவர்கள் வலதுகை லஞ்சத்தினால் நிறைந்திருக்கிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நானோ என்னுடைய உத்தமத்திலே நடப்பேன்;","poem":1},{"lineBreak":true},{"text":"என்னை மீட்டுக்கொண்டு என்மேல் இரக்கமாக இரும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என்னுடைய கால் செம்மையான இடத்திலே நிற்கிறது;","poem":1},{"lineBreak":true},{"text":"சபைகளிலே நான் யெகோவாவை துதிப்பேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}