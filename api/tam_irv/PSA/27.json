{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா என் வெளிச்சமும் என் இரட்சிப்புமானவர்,","poem":1},{"lineBreak":true},{"text":"யாருக்குப் பயப்படுவேன்?","poem":1},{"lineBreak":true},{"text":"யெகோவா என் வாழ்வின் அடைக்கலமானவர்,","poem":1},{"lineBreak":true},{"text":"யாருக்கு பயப்படுவேன்?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகளும் என்னுடைய பகைவர்களுமாகிய பொல்லாதவர்கள் என் சரீரத்தை விழுங்க,","poem":1},{"lineBreak":true},{"text":"என்னை நெருங்கும்போது அவர்களே இடறிவிழுந்தார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"எனக்கு விரோதமாக ஒரு இராணுவம் முகாமிட்டாலும், என் இருதயம் பயப்படாது;","poem":1},{"lineBreak":true},{"text":"என்மேல் போர் எழும்பினாலும், இதிலே நான் நம்பிக்கையாக இருப்பேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"கர்த்தரிடத்தில் ஒன்றை நான் கேட்டேன், அதையே நாடுவேன்;","poem":1},{"lineBreak":true},{"text":"நான் யெகோவாவுடைய மகிமையைப் பார்க்கும்படியாகவும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய ஆலயத்தில் ஆராய்ச்சி செய்யும்படியாகவும்,","poem":1},{"lineBreak":true},{"text":"நான் என்னுடைய உயிருள்ள நாட்களெல்லாம் யெகோவாவுடைய ஆலயத்தில் தங்கியிருப்பதையே நாடுவேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தீங்குநாளில் அவர் என்னைத் தம்முடைய கூடாரத்தில் மறைத்து, என்னைத் தமது கூடார மறைவிலே ஒளித்துவைத்து,","poem":1},{"lineBreak":true},{"text":"என்னைக் கன்மலையின்மேல் உயர்த்துவார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இப்பொழுது என் தலை என்னைச் சுற்றிலும் இருக்கிற என் எதிரிகளுக்கு மேலாக உயர்த்தப்படும்;","poem":1},{"lineBreak":true},{"text":"அதற்காக அவருடைய கூடாரத்திலே நான் ஆனந்தபலிகளையிட்டு,","poem":1},{"lineBreak":true},{"text":"யெகோவாவைப் பாடுவேன், அவரைப் புகழ்ந்துபாடுவேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நான் கூப்பிடுகிற சத்தத்தை நீர் கேட்டு,","poem":1},{"lineBreak":true},{"text":"எனக்கு இரங்கி, எனக்கு பதில் தாரும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய முகத்தைத் தேடுங்கள் என்று சொன்னீரே,","poem":1},{"lineBreak":true},{"text":"உம்முடைய முகத்தையே தேடுவேன் யெகோவாவே என்று என்னுடைய இருதயம் உம்மிடத்தில் சொன்னது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உமது முகத்தை எனக்கு மறைக்கவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"நீர் கோபத்துடன் உமது அடியேனை விலக்கிப்போடவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"நீரே எனக்கு உதவி செய்பவர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய இரட்சிப்பின் தேவனே,","poem":1},{"lineBreak":true},{"text":"என்னைத் தள்ளிவிடாமலிரும் என்னைக் கைவிடாமலிரும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என் தகப்பனும் என் தாயும் என்னைக் கைவிட்டாலும்,","poem":1},{"lineBreak":true},{"text":"யெகோவா என்னைச் சேர்த்துக்கொள்ளுவார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது வழியை எனக்குப் போதியும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிராளிகளினிமித்தம் சரியான பாதையில் என்னை நடத்தும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என் எதிரிகளின் விருப்பத்திற்கு என்னை ஒப்புக் கொடுக்கவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"பொய்ச்சாட்சிகளும் ஆக்கிரமித்துச் சீறுகிறவர்களும்","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாக எழும்பியிருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நானோ, உயிருள்ளவர்களின் தேசத்திலே","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய நன்மையைக் காண்பேன் என்று விசுவாசித்தேன்","poem":1},{"noteId":11},{"text":".","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குக் காத்திரு, தைரியமாக இரு,","poem":1},{"lineBreak":true},{"text":"அவர் உன்னுடைய இருதயத்தை நிலையாக நிறுத்துவார்,","poem":1},{"lineBreak":true},{"text":"கர்த்தருக்கே காத்திரு.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"விசுவாசிக்காமல் இருந்தால் கெட்டுப்போயிருப்பேன்","reference":{"chapter":27,"verse":13}}]},"thisChapterLink":"/api/tam_irv/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}