{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவ பிள்ளைகளே, யெகோவாவுக்கு மகிமையையும் வல்லமையையும் செலுத்துங்கள்;","poem":1},{"lineBreak":true},{"text":"கர்த்தருக்கே அதைச் செலுத்துங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய பெயருக்கேற்ற மகிமையை அவருக்குச் செலுத்துங்கள்;","poem":1},{"lineBreak":true},{"text":"பரிசுத்த அலங்காரத்துடனே யெகோவாவை தொழுதுகொள்ளுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய சத்தம் சமுத்திரங்கள் மேல் தொனிக்கிறது;","poem":1},{"lineBreak":true},{"text":"மகிமையுள்ள தேவன் முழங்குகிறார்;","poem":1},{"lineBreak":true},{"text":"யெகோவா திரளான தண்ணீர்களின்மேல் இருக்கிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய சத்தம் வல்லமையுள்ளது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய சத்தம் மகத்துவமுள்ளது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய சத்தம் கேதுருமரங்களை முறிக்கிறது;","poem":1},{"lineBreak":true},{"text":"யெகோவா லீபனோனின் கேதுருமரங்களை முறிக்கிறார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவைகளைக் கன்றுக்குட்டிகளைப்போலவும், லீபனோனையும்,","poem":1},{"lineBreak":true},{"text":"சீரியோனையும் காண்டாமிருகக் குட்டிகளைப்போலவும் துள்ளச்செய்கிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய சத்தம் தீப்பிழம்புகளைப் பிளக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய சத்தம் வனாந்தரத்தை அதிரச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"யெகோவா காதேஸ் வனாந்தரத்தை அதிரச்செய்கிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய சத்தம் பெண்மான்களை ஈனும்படி செய்து,","poem":1},{"lineBreak":true},{"text":"காடுகளை வெளியாக்கும்;","poem":1},{"lineBreak":true},{"text":"அவருடைய ஆலயத்திலுள்ள அனைவரும்","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்கு மகிமை என்று ஆர்ப்பரிக்கிறார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவா பெருவெள்ளத்தின்மேல் அமர்ந்திருந்தார்;","poem":1},{"lineBreak":true},{"text":"யெகோவா என்றென்றைக்கும் ராஜாவாக அமர்ந்திருக்கிறார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவா தமது மக்களுக்குப் பெலன் கொடுப்பார்;","poem":1},{"lineBreak":true},{"text":"யெகோவா தமது மக்களுக்குச் சமாதானம் அருளி,","poem":1},{"lineBreak":true},{"text":"அவர்களை ஆசீர்வதிப்பார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}