{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["ஆலயத்தின் அர்ப்பணிப்பின் பாடல். தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகள்","poem":1},{"lineBreak":true},{"text":"என்னை மேற்கொண்டு அவர்களை மகிழவிடாமல்,","poem":1},{"lineBreak":true},{"text":"நீர் என்னைக் கைதூக்கி எடுத்தபடியினால்,","poem":1},{"lineBreak":true},{"text":"நான் உம்மைப் போற்றுவேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்மை நோக்கிக் கூப்பிட்டேன்,","poem":1},{"lineBreak":true},{"text":"என்னை நீர் குணமாக்கினீர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் என் ஆத்துமாவைப் பாதாளத்திலிருந்து ஏறச்செய்து,","poem":1},{"lineBreak":true},{"text":"நான் குழியில் இறங்காதபடி என்னை உயிரோடு காத்தீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய பரிசுத்தவான்களே,","poem":1},{"lineBreak":true},{"text":"அவரைப் புகழ்ந்துபாடி,","poem":1},{"lineBreak":true},{"text":"அவருடைய பரிசுத்தத்தின் நினைவு கூருதலைக் கொண்டாடுங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஏனெனில் அவருடைய கோபம் ஒர் இமைப்பொழுதே,","poem":1},{"lineBreak":true},{"text":"அவருடைய தயவோ வாழ்நாள் முழுவதும்;","poem":1},{"lineBreak":true},{"text":"மாலையில் அழுகை வரும்,","poem":1},{"lineBreak":true},{"text":"அதிகாலையிலே மகிழ்ச்சி உண்டாகும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் எப்போதும் அசைக்கப்படுவதில்லையென்று,","poem":1},{"lineBreak":true},{"text":"நான் வளமுடன் இருக்கும்போது சொன்னேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய தயவினால்","poem":1},{"lineBreak":true},{"text":"நீர் என்னுடைய மலையை வலிமையாக நிற்கச்செய்திருந்தீர்;","poem":1},{"lineBreak":true},{"text":"உமது முகத்தை நீர் மறைத்துக்கொண்டபோதோ நான் கலங்கினவனானேன்;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நான் கல்லறையில் இறங்கும்போது என்னுடைய இரத்தத்தால் என்ன லாபமுண்டு?","poem":1},{"lineBreak":true},{"text":"புழுதி உம்மைத் துதிக்குமோ?","poem":1},{"lineBreak":true},{"text":"அது உமது சத்தியத்தை அறிவிக்குமோ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் எனக்குச் செவிகொடுத்து","poem":1},{"lineBreak":true},{"text":"என்மேல் இரக்கமாக இரும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, நீர் எனக்குச் சகாயராக இரும் என்று சொல்லி;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்மை நோக்கிக் கூப்பிட்டேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நோக்கிக் கெஞ்சினேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னுடைய புலம்பலை ஆனந்த சந்தோஷமாக மாறச்செய்தீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய மகிமை அமைதியாக இல்லாமல்","poem":1},{"lineBreak":true},{"text":"உம்மைப் புகழ்ந்து பாடும்படியாக","poem":1},{"lineBreak":true},{"text":"நீர் என்னுடைய சணலாடையை களைந்துபோட்டு,","poem":1},{"lineBreak":true},{"text":"மகிழ்ச்சியினால் என்னை உடுத்தினீர்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்மை என்றென்றைக்கும் துதிப்பேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}