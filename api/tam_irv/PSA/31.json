{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["இசைத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":["யெகோவாவே, உம்மை நம்பியிருக்கிறேன்;",{"text":"நான் ஒருபோதும் வெட்கமடையாதபடி செய்யும்;","poem":1},{"lineBreak":true},{"text":"உமது நீதியினிமித்தம் என்னை விடுவியும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உமது செவியை எனக்குச் சாய்த்து,","poem":1},{"lineBreak":true},{"text":"சீக்கிரமாக என்னைத் தப்புவியும்;","poem":1},{"lineBreak":true},{"text":"நீர் எனக்குப் பலத்த கோபுரமும்,","poem":1},{"lineBreak":true},{"text":"எனக்கு அடைக்கலமான கன்மலையுமாக இரும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என் கன்மலையும் என் கோட்டையும் நீரே;","poem":1},{"lineBreak":true},{"text":"உமது நாமத்தினிமித்தம் எனக்கு வழிகாட்டி,","poem":1},{"lineBreak":true},{"text":"என்னை நடத்தியருளும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர்கள் எனக்கு மறைவாய் வைத்த வலைக்கு என்னை நீங்கலாக்கிவிடும்;","poem":1},{"lineBreak":true},{"text":"தேவனே நீரே எனக்கு அடைக்கலம்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உமது கையில் என் ஆவியை ஒப்புவிக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"சத்தியபரனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நீர் என்னை மீட்டுக்கொண்டீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பொய் தெய்வங்ககளைப் பற்றிக்கொள்ளுகிறவர்களை நான் வெறுத்து,","poem":1},{"lineBreak":true},{"text":"யெகோவாவையே நம்பியிருக்கிறேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உமது, கிருபையிலே களிகூர்ந்து மகிழுவேன்;","poem":1},{"lineBreak":true},{"text":"நீர் என் உபத்திரவத்தைப் பார்த்து,","poem":1},{"lineBreak":true},{"text":"என் ஆத்தும துயரங்களை அறிந்திருக்கிறீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"எதிரியின் கையில் என்னை ஒப்புக்கொடுக்காமல்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாதங்களை விசாலத்திலே நிறுத்தினீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எனக்கு இரங்கும் யெகோவாவே, நான் நெருக்கப்படுகிறேன்;","poem":1},{"lineBreak":true},{"text":"துக்கத்தினால் என் கண்ணும்","poem":1},{"lineBreak":true},{"text":"என் ஆத்துமாவும் என்னுடைய வயிறுங்கூடக் கருகிப்போனது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என்னுடைய வாழ்க்கை துக்கத்தினாலும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வருடங்கள் தவிப்பினாலும் கழிந்துபோனது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய பாடுகளினாலே என்னுடைய பெலன் குறைந்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எலும்புகள் உலர்ந்துபோனது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகளாகிய அனைவர் நிமித்தமும்,","poem":1},{"lineBreak":true},{"text":"நான் என் அயலாருக்கு நிந்தையும்,","poem":1},{"lineBreak":true},{"text":"எனக்கு அறிமுகமானவர்களுக்கு அலட்சியமுமானேன்;","poem":1},{"lineBreak":true},{"text":"வீதியிலே என்னைக் கண்டவர்கள்","poem":1},{"lineBreak":true},{"text":"எனக்கு விலகி ஓடிப்போனார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"செத்தவனைப்போல எல்லோராலும் முழுவதும் மறக்கப்பட்டேன்;","poem":1},{"lineBreak":true},{"text":"உடைந்த பாத்திரத்தைப்போல ஆனேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அநேகர் சொல்லும் அவதூறைக் கேட்டேன்;","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாக அவர்கள் ஒன்றாக ஆலோசனை செய்கிறதினால்","poem":1},{"lineBreak":true},{"text":"திகில் என்னைச் சூழ்ந்துகொண்டது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உயிரை வாங்கத்தேடுகிறார்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நானோ, யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்மை நம்பியிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"நீரே என் தேவன் என்று சொன்னேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என்னுடைய காலங்கள் உமது கரத்திலிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"என் எதிரிகளின் கைக்கும் என்னைத் துன்பப்படுத்துகிறவர்களின் கைக்கும்","poem":1},{"lineBreak":true},{"text":"என்னைத் தப்புவியும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நீர் உமது முகத்தை உமது ஊழியக்காரன்மேல் பிரகாசிக்கச்செய்து,","poem":1},{"lineBreak":true},{"text":"உமது கிருபையினாலே என்னை இரட்சியும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்மை நோக்கிக் கூப்பிட்டேன்;","poem":1},{"lineBreak":true},{"text":"நான் வெட்கப்பட்டுப்போகாதபடி செய்யும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் வெட்கப்பட்டுப் பாதாளத்தில் மவுனமாக இருக்கட்டும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நீதிமானுக்கு விரோதமாகப்","poem":1},{"lineBreak":true},{"text":"பெருமையோடும் இகழ்ச்சியோடும் கடினமாகப் பேசுகிற பொய் உதடுகள் கட்டப்பட்டுப்போவதாக.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"உமக்குப் பயந்தவர்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"மனிதர்களுக்கு முன்பாக உம்மை நம்புகிறவர்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"நீர் உண்டாக்கி வைத்திருக்கிற உம்முடைய நன்மை எவ்வளவு பெரிதாக இருக்கிறது!","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"மனிதர்களுடைய அகங்காரத்திற்கு அவர்களை உமது சமுகத்தின் மறைவிலே மறைத்து,","poem":1},{"lineBreak":true},{"text":"நாவுகளின் சண்டைக்கு அவர்களை விலக்கி,","poem":1},{"lineBreak":true},{"text":"உமது கூடாரத்திலே ஒளித்துவைத்துக் காப்பாற்றுகிறீர்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"யெகோவா பாதுகாப்பான நகரத்தில் எனக்குத் தமது கிருபையை அதிசயமாக தெரியப்படுத்தினபடியால்,","poem":1},{"lineBreak":true},{"text":"அவருக்கு ஸ்தோத்திரம்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"உம்முடைய கண்களுக்கு முன்பாக இல்லாதபடிக்கு வெட்டுண்டேன் என்று","poem":1},{"lineBreak":true},{"text":"நான் என்னுடைய மனக்கலக்கத்திலே சொன்னேன்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் நான் உம்மை நோக்கிக் கூப்பிட்டபோது,","poem":1},{"lineBreak":true},{"text":"என் விண்ணப்பங்களின் சத்தத்தைக் கேட்டீர்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய பரிசுத்தவான்களே,","poem":1},{"lineBreak":true},{"text":"நீங்களெல்லாரும் அவரில் அன்பு கூருங்கள்;","poem":1},{"lineBreak":true},{"text":"உண்மையானவனைக் யெகோவா தற்காத்து,","poem":1},{"lineBreak":true},{"text":"வீம்பு செய்கிறவனுக்குப் பூரணமாகப் பதிலளிப்பார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குக் காத்திருக்கிறவர்களே,","poem":1},{"lineBreak":true},{"text":"நீங்களெல்லாரும் திடமனதாக இருங்கள்,","poem":1},{"lineBreak":true},{"text":"அவர் உங்களுடைய இருதயத்தை உறுதிப்படுத்துவார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}