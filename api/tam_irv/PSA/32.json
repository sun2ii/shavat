{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["மஸ்கீல் என்னும் தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"எவனுடைய மீறுதல் மன்னிக்கப்பட்டதோ,","poem":1},{"lineBreak":true},{"text":"எவனுடைய பாவம் மூடப்பட்டதோ,","poem":1},{"lineBreak":true},{"text":"அவன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எவனுடைய அக்கிரமத்தைக் யெகோவா எண்ணாமலிருக்கிறாரோ,","poem":1},{"lineBreak":true},{"text":"எவனுடைய ஆவியில் கபடமில்லாதிருக்கிறதோ, அவன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் அடக்கிவைத்தவரையில்,","poem":1},{"lineBreak":true},{"text":"எப்பொழுதும் என் கதறுதலினாலே என் எலும்புகள் உலர்ந்துபோயிற்று.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இரவும் பகலும் என்மேல் உம்முடைய கை பாரமாக இருந்ததினால்,","poem":1},{"lineBreak":true},{"text":"என் பெலன் கோடைக்கால வறட்சிபோல வறண்டுபோயிற்று. (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நான் என் அக்கிரமத்தை மறைக்காமல், என் பாவத்தை உமக்கு அறிவித்தேன்;","poem":1},{"lineBreak":true},{"text":"என் மீறுதல்களைக் யெகோவாவுக்கு அறிக்கையிடுவேன் என்றேன்;","poem":1},{"lineBreak":true},{"text":"தேவனே நீர் என் பாவத்தின் தோஷத்தை மன்னித்தீர். (சேலா)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இதற்காக உம்மைக் காணும் காலத்தில் பக்தியுள்ளவனெவனும் உம்மை நோக்கி விண்ணப்பம் செய்வான்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது மிகுந்த வெள்ளம் வந்தாலும் அது அவனை அணுகாது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீர் எனக்கு மறைவிடமாயிருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என்னை நீர் இக்கட்டுக்கு விலக்கிக்காத்து,","poem":1},{"lineBreak":true},{"text":"இரட்சிப்பின் பாடல்கள் என்னைச் சூழ்ந்துகொள்ளும்படி செய்வீர். (சேலா)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நான் உனக்குப் போதித்து, நீ நடக்கவேண்டிய வழியை உனக்குக் காட்டுவேன்;","poem":1},{"lineBreak":true},{"text":"உன்மேல் என் கண்ணை வைத்து, உனக்கு ஆலோசனை சொல்லுவேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வாரினாலும் கடிவாளத்தினாலும் வாய் கட்டப்பட்டாலொழிய,","poem":1},{"lineBreak":true},{"text":"உன் அருகில் சேராத புத்தியில்லாத குதிரையைப்போலவும்","poem":1},{"lineBreak":true},{"text":"கோவேறு கழுதையைப்போலவும் இருக்கவேண்டாம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுக்கு அநேக வேதனைகளுண்டு;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நம்பியிருக்கிறவனையோ கிருபை சூழ்ந்து கொள்ளும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நீதிமான்களே, யெகோவாவுக்குள் மகிழ்ந்து களிகூருங்கள்;","poem":1},{"lineBreak":true},{"text":"செம்மையான இருதயமுள்ளவர்களே,","poem":1},{"lineBreak":true},{"text":"நீங்கள் எல்லாரும் ஆனந்தமுழக்கமிடுங்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}