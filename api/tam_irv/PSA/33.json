{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"நீதிமான்களே, யெகோவாவுக்குள் சந்தோஷமாக இருங்கள்;","poem":1},{"lineBreak":true},{"text":"துதிசெய்வது நேர்மையானவர்களுக்குத் தகும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"சுரமண்டலத்தினால் யெகோவாவை துதித்து,","poem":1},{"lineBreak":true},{"text":"பத்து நரம்பு வீணையினாலும் அவரை புகழ்ந்து பாடுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவருக்குப் புதுப்பாட்டைப் பாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"ஆனந்த சத்தத்தோடு வாத்தியங்களை நேர்த்தியாக வாசியுங்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய வார்த்தை உத்தமமும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய செய்கையெல்லாம் சத்தியமுமாயிருக்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர் நீதியிலும் நியாயத்திலும் பிரியப்படுகிறார்;","poem":1},{"lineBreak":true},{"text":"பூமி யெகோவாவுடைய கருணையினால் நிறைந்திருக்கிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய வார்த்தையினால் வானங்களும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய வாயின் சுவாசத்தினால் அவைகளின் அனைத்தும் உண்டாக்கப்பட்டது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் கடலின் தண்ணீர்களைக் குவியலாகச் சேர்த்து,","poem":1},{"lineBreak":true},{"text":"ஆழமான தண்ணீர்களைப் பொக்கிஷவைப்பாக வைக்கிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பூமியெல்லாம் யெகோவாவுக்குப் பயப்படுவதாக;","poem":1},{"lineBreak":true},{"text":"உலகத்திலுள்ள குடிமக்களெல்லாம் அவருக்கு பயந்திருப்பதாக.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் சொல்ல ஆகும், அவர் கட்டளையிட நிற்கும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவா தேசங்களின் ஆலோசனையை வீணடித்து,","poem":1},{"lineBreak":true},{"text":"மக்களுடைய நினைவுகளை பயனற்றதாக ஆக்குகிறார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய ஆலோசனை நிரந்தரகாலமாகவும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய இருதயத்தின் நினைவுகள் தலைமுறை தலைமுறையாகவும் நிற்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவாவை தங்களுக்குத் தெய்வமாகக்கொண்ட தேசமும்,","poem":1},{"lineBreak":true},{"text":"அவர் தமக்குச் சொந்தமாகத் தெரிந்துகொண்ட மக்களும் பாக்கியமுள்ளது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவா வானத்திலிருந்து நோக்கிப்பார்த்து, எல்லா மனிதர்களையும் காண்கிறார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தாம் தங்கியிருக்கிற இடத்திலிருந்து பூமியின் குடிமக்கள் எல்லோர்மேலும் கண்ணோக்கமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவர்களுடைய இருதயங்களையெல்லாம் அவர் உருவாக்கி, அவர்கள் செய்கைகளையெல்லாம் கவனித்திருக்கிறார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"எந்த ராஜாவும் தன்னுடைய ராணுவத்தின் மிகுதியால் காப்பாற்றப்படமாட்டான்;","poem":1},{"lineBreak":true},{"text":"போர்வீரனும் தன்னுடைய பலத்தின் மிகுதியால் தப்பமாட்டான்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"காப்பாற்றுவதற்கு குதிரை வீண்;","poem":1},{"lineBreak":true},{"text":"அது தன்னுடைய மிகுந்த பலத்தால் காப்பாற்றாது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"தமக்குப் பயந்து, தமது கிருபைக்குக் காத்திருக்கிறவர்களின் ஆத்துமாக்களை மரணத்திற்கு விலக்கி விடுவிக்கவும்;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"பஞ்சத்தில் அவர்களை உயிரோடு காக்கவும்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய கண் அவர்கள்மேல் நோக்கமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நம்முடைய ஆத்துமா யெகோவாவுக்குக் காத்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவரே நமக்குத் துணையும் நமக்குக் கேடகமுமானவர்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவருடைய பரிசுத்த பெயரை நாம் நம்பியிருக்கிறபடியால்,","poem":1},{"lineBreak":true},{"text":"நம்முடைய இருதயம் அவருக்குள் சந்தோசமாக இருக்கும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நாங்கள் உம்மை நம்பியிருக்கிறபடியே உமது கிருபை எங்கள்மேல் இருப்பதாக.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}