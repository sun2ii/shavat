{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் வேஷத்தைக் கண்டு அபிமெலேக்கு அவனைத் துரத்தியபோது தாவீது பாடிய பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்கு நான் எப்போதும் நன்றி செலுத்துவேன்;","poem":1},{"lineBreak":true},{"text":"அவர் துதி எப்போதும் என்னுடைய வாயில் இருக்கும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்குள் என்னுடைய ஆத்துமா மேன்மைபாராட்டும்;","poem":1},{"lineBreak":true},{"text":"ஒடுக்கப்பட்டவர்கள் அதைக்கேட்டு மகிழுவார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னோடே கூடக் யெகோவாவை மகிமைப்படுத்துங்கள்;","poem":1},{"lineBreak":true},{"text":"நாம் ஒருமித்து அவர் நாமத்தை உயர்த்துவோமாக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நான் யெகோவாவை தேடினேன்,","poem":1},{"lineBreak":true},{"text":"அவர் எனக்குச் செவிகொடுத்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எல்லாப் பயத்திற்கும் என்னை நீங்கலாக்கிவிட்டார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர்கள் அவரை நோக்கிப்பார்த்துப் பிரகாசமடைந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் முகங்கள் வெட்கப்படவில்லை.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இந்த ஏழை கூப்பிட்டான், யெகோவா கேட்டு,","poem":1},{"lineBreak":true},{"text":"அவனை அவன் பிரச்சனைகளுக்கெல்லாம் நீங்கலாக்கி காப்பாற்றினார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய தூதன் அவருக்குப் பயந்தவர்களைச் சுற்றி","poem":1},{"lineBreak":true},{"text":"முகாமிட்டு அவர்களை விடுவிக்கிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா நல்லவர் என்பதை ருசித்துப்பாருங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்மேல் நம்பிக்கையாக இருக்கிற மனிதன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய பரிசுத்தவான்களே, அவருக்குப் பயந்திருங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருக்குப் பயந்தவர்களுக்குக் குறைவில்லை.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"சிங்கக்குட்டிகள் தாழ்ச்சியடைந்து பட்டினியாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை தேடுகிறவர்களுக்கோ ஒரு நன்மையும் குறையாது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பிள்ளைகளே, வந்து எனக்குச் செவிகொடுங்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயப்படுதலை உங்களுக்குப் போதிப்பேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நன்மையைக் காணும்படி, வாழ்க்கையை விரும்பி,","poem":1},{"lineBreak":true},{"text":"நீடித்த நாட்களை நேசிக்கிற மனிதன் யார்?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"உன் நாவை தீங்கிற்கும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய உதடுகளை பொய் வார்த்தைகளுக்கும் விலக்கிக் காத்துக்கொள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தீமையை விட்டு விலகி, நன்மை செய்;","poem":1},{"lineBreak":true},{"text":"சமாதானத்தைத் தேடி, அதைத் பின்தொடர்ந்துகொள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய கண்கள் நீதிமான்கள்மேல் நோக்கமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவருடைய காதுகள் அவர்கள் கூப்பிடுதலுக்குத் திறந்திருக்கிறது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தீமைசெய்கிறவர்களுடைய பெயரைப் பூமியில் இல்லாமல் போகச்செய்ய,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய முகம் அவர்களுக்கு விரோதமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நீதிமான்கள் கூப்பிடும்போது யெகோவா கேட்டு,","poem":1},{"lineBreak":true},{"text":"அவர்களை அவர்களுடைய எல்லா உபத்திரவங்களுக்கும் நீங்கலாக்கிவிடுகிறார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"உடைந்த இருதயமுள்ளவர்களுக்குக் யெகோவா அருகில் இருந்து,","poem":1},{"lineBreak":true},{"text":"நொறுக்கப்பட்ட ஆவியுள்ளவர்களை காப்பாற்றுகிறார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"நீதிமானுக்கு வரும் துன்பங்கள் அநேகமாக இருக்கும்,","poem":1},{"lineBreak":true},{"text":"யெகோவா அவைகள் எல்லாவற்றிலும் இருந்து அவனை விடுவிப்பார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவனுடைய எலும்புகளையெல்லாம் காப்பாற்றுகிறார்;","poem":1},{"lineBreak":true},{"text":"அவைகளில் ஒன்றும் முறிக்கப்படுவதில்லை.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"தீமை துன்மார்க்கனைக் கொல்லும்;","poem":1},{"lineBreak":true},{"text":"நீதிமானைப் பகைக்கிறவர்கள் குற்றவாளிகளாவார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவா தம்முடைய ஊழியக்காரர்களின் ஆத்துமாவை மீட்டுக்கொள்ளுகிறார்;","poem":1},{"lineBreak":true},{"text":"அவரை நம்புகிற ஒருவன்மேலும் குற்றஞ்சுமராது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}