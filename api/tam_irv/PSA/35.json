{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நீர் என்னுடைய எதிராளிகளோடு வழக்காடி,","poem":1},{"lineBreak":true},{"text":"என்னோடு சண்டையிடுகிறவர்களோடு போரிடும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நீர் கேடகத்தையும் பெரிய கேடகத்தையும் பிடித்து,","poem":1},{"lineBreak":true},{"text":"எனக்கு ஒத்தாசையாக எழுந்து நில்லும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னைத் துன்பப்படுத்துகிறவர்களோடு எதிர்த்து நின்று, ஈட்டியை ஓங்கி அவர்களை வழிமறித்து:","poem":1},{"lineBreak":true},{"text":"நான் உன்னுடைய இரட்சிப்பு என்று என்னுடைய ஆத்துமாவுக்குச் சொல்லும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய உயிரை வாங்கத்தேடுகிறவர்கள் வெட்கப்பட்டுக் கலங்குவார்களாக;","poem":1},{"lineBreak":true},{"text":"எனக்குத் தீங்குசெய்ய நினைக்கிறவர்கள் அவமானமடைவார்களாக.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர்கள் காற்றடிக்கும் திசையில் பறக்கும் பதரைப்போல ஆவார்களாக;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய தூதன் அவர்களைத் துரத்துவானாக.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர்களுடைய வழி இருளும் சறுக்கலுமாக இருப்பதாக;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய தூதன் அவர்களைப் பின்தொடருவானாக.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"காரணமில்லாமல் எனக்காகத் தங்களுடைய வலையைக் குழியில் ஒளித்துவைத்தார்கள்;","poem":1},{"lineBreak":true},{"text":"காரணமில்லாமல் என்னுடைய ஆத்துமாவுக்குப் படுகுழி வெட்டினார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவன் நினைக்காத அழிவு அவனுக்கு வந்து, அவன் மறைவாக வைத்த வலை அவனையே பிடிக்கட்டும்;","poem":1},{"lineBreak":true},{"text":"அவனே அந்தக் குழியில் விழுந்து அழிவானாக.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா யெகோவாவில் சந்தோஷித்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய இரட்சிப்பில் மகிழ்ந்திருக்கும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஒடுக்கப்பட்டவனை, அவனிலும் பலவானுடைய கைக்கும்,","poem":1},{"lineBreak":true},{"text":"ஏழையும் எளிமையுமானவனைக் கொள்ளையிடுகிறவனுடைய கைக்கும் தப்புவிக்கிற உமக்கு ஒப்பானவர் யார் யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"என்று என்னுடைய எலும்புகளெல்லாம் சொல்லும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"கொடுமையான சாட்சிகள் எழும்பி, நான் அறியாததை என்னிடத்தில் கேட்கிறார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நான் செய்த நன்மைக்குப் பதிலாகத் தீமைசெய்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா சோர்ந்து போகச்செய்யப்பார்க்கிறார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவர்கள் வியாதியாக இருந்தபோது சணல் என்னுடைய உடையாக இருந்தது;","poem":1},{"lineBreak":true},{"text":"நான் உபவாசத்தால் என்னுடைய ஆத்துமாவை உபத்திரவப்படுத்தினேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஜெபமும் கேட்கப்படவில்லை.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நான் அவனை என்னுடைய நண்பனாகவும்","poem":1},{"lineBreak":true},{"text":"சகோதரனாகவும் நினைத்து நடந்துகொண்டேன்;","poem":1},{"lineBreak":true},{"text":"தாய்க்காகத் துக்கப்படுகிறவனைப்போல்","poem":1},{"lineBreak":true},{"text":"துக்கஉடை அணிந்து தலைகவிழ்த்து நடந்தேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆனாலும் எனக்கு ஆபத்து உண்டானபோது","poem":1},{"lineBreak":true},{"text":"அவர்கள் சந்தோஷப்பட்டுக் கூட்டங்கூடினார்கள்;","poem":1},{"lineBreak":true},{"text":"அற்பமானவர்களும் நான் அறியாதவர்களும் எனக்கு விரோதமாகக் கூட்டம் கூடி,","poem":1},{"lineBreak":true},{"text":"ஓயாமல் என்னை இகழ்ந்தார்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அப்பத்திற்காக வஞ்சகம் பேசுகிற பரியாசக்காரர்களோடு","poem":1},{"lineBreak":true},{"text":"சேர்ந்துகொண்டு என்மேல் பற்கடிக்கிறார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, எதுவரைக்கும் இதைப் பார்த்துக்கொண்டிருப்பீர்?","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவை அழிவுக்கும், எனக்கு அருமையானதைச் சிங்கக்குட்டிகளுக்கும் தப்புவியும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"மகா சபையிலே உம்மைத் துதிப்பேன்,","poem":1},{"lineBreak":true},{"text":"திரளான மக்களுக்குள்ளே உம்மைப் புகழுவேன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"வீணாக எனக்கு எதிரிகளானவர்கள் என்னால் சந்தோஷப்படாமலும்,","poem":1},{"lineBreak":true},{"text":"காரணமில்லாமல் என்னைப் பகைக்கிறவர்கள்","poem":1},{"lineBreak":true},{"text":"கண் சிமிட்டாமலும் இருப்பார்களாக.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவர்கள் சமாதானமாகப் பேசாமல்,","poem":1},{"lineBreak":true},{"text":"தேசத்திலே அமைதலாக இருக்கிறவர்களுக்கு விரோதமாக வஞ்சகமான காரியங்களைக் கருதுகிறார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"எனக்கு விரோதமாகத் தங்கள் வாயை விரிவாகத் திறந்து,","poem":1},{"lineBreak":true},{"text":"ஆ ஆ, ஆ ஆ, எங்கள் கண் கண்டது என்கிறார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் இதைக் கண்டீர், மவுனமாக இருக்கவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"ஆண்டவரே, எனக்குத் தூரமாகாமலிரும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"என் தேவனே, என் ஆண்டவரே,","poem":1},{"lineBreak":true},{"text":"எனக்கு நியாயஞ்செய்யவும் என்னுடைய வழக்கைத் தீர்க்கவும் விழித்துக்கொண்டு எழுந்தருளும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவாவே, உம்முடைய நீதியின்படி என்னை நியாயம் விசாரியும்,","poem":1},{"lineBreak":true},{"text":"என்னைக்குறித்து அவர்களை மகிழவிடாமலிரும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய இருதயத்திலே:","poem":1},{"lineBreak":true},{"text":"ஆ ஆ, இதுவே நாங்கள் விரும்பினது என்று சொல்லாதபடிக்கும்,","poem":1},{"lineBreak":true},{"text":"அவனை","poem":1},{"noteId":12},{"text":"என்று பேசாதபடிக்கும் செய்யும்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"எனக்கு நேரிட்ட ஆபத்துக்காகச் சந்தோஷப்படுகிறவர்கள் ஒன்றாக வெட்கி அவமானப்பட்டு,","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாகப் பெருமைபாராட்டுகிறவர்கள் வெட்கத்தாலும்","poem":1},{"lineBreak":true},{"text":"அவமானத்தாலும் மூடப்படவேண்டும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"என்னுடைய நீதி தெரியவேண்டுமென்று விரும்புகிறவர்கள்","poem":1},{"lineBreak":true},{"text":"கெம்பீரித்து மகிழ்ந்து,","poem":1},{"lineBreak":true},{"text":"தமது ஊழியக்காரனுடைய சுகத்தை விரும்புகிற யெகோவாவுக்கு மகிமை","poem":1},{"lineBreak":true},{"text":"உண்டாவதாக என்று எப்போதும் சொல்லட்டும்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"என் நாவு உமது நீதியையும்,","poem":1},{"lineBreak":true},{"text":"நாள்முழுவதும் உமது துதியையும் சொல்லிக்கொண்டிருக்கும்.","poem":1}]}],"footnotes":[{"noteId":12,"caller":"+","text":"விழுங்கிவிட்டோம்","reference":{"chapter":35,"verse":25}}]},"thisChapterLink":"/api/tam_irv/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}