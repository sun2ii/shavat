{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு, யெகோவாவுடைய ஊழியனாகிய தாவீது கொடுத்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"துன்மார்க்கனுடைய துரோகப்பேச்சு என் உள்ளத்திற்குத் தெரியும்;","poem":1},{"lineBreak":true},{"text":"அவன் கண்களுக்குமுன்பு தெய்வபயம் இல்லை.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவன், தன்னுடைய அக்கிரமம் அருவருப்பானதென்று காணப்படும்வரை,","poem":1},{"lineBreak":true},{"text":"தன் பார்வைக்கேற்றபடி தனக்குத்தானே வஞ்சகம் பேசுகிறான்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவன் வாயின் வார்த்தைகள் அக்கிரமமும் வஞ்சகமுமுள்ளது;","poem":1},{"lineBreak":true},{"text":"புத்தியாக நடந்துகொள்வதையும் நன்மை செய்வதையும் விட்டுவிட்டான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவன் தன்னுடைய படுக்கையின்மேல் அக்கிரமத்தை யோசித்து,","poem":1},{"lineBreak":true},{"text":"நல்லது இல்லாத வழியிலே நிலைத்து,","poem":1},{"lineBreak":true},{"text":"பொல்லாப்பை வெறுக்காமலிருக்கிறான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது கிருபை வானங்களில் தெரிகிறது;","poem":1},{"lineBreak":true},{"text":"உமது சத்தியம் மேகமண்டலங்கள்வரை எட்டுகிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உமது நீதி மகத்தான மலைகள் போலவும்,","poem":1},{"lineBreak":true},{"text":"உமது நியாயங்கள் மகா ஆழமாகவும் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, மனிதர்களையும் மிருகங்களையும் காப்பாற்றுகிறீர்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவனே, உம்முடைய கிருபை எவ்வளவு அருமையானது!","poem":1},{"lineBreak":true},{"text":"அதினால் மனிதர்கள் உமது இறக்கைகளின் நிழலிலே வந்தடைகிறார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"உமது ஆலயத்திலுள்ள சம்பூரணத்தினால் திருப்தியடைவார்கள்;","poem":1},{"lineBreak":true},{"text":"உமது பேரின்ப நதியினால் அவர்கள் தாகத்தைத் தீர்க்கிறீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வாழ்வின் ஊற்று உம்மிடத்தில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வெளிச்சத்திலே வெளிச்சம் காண்கிறோம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உம்மை அறிந்தவர்கள்மேல் உமது கிருபையையும்,","poem":1},{"lineBreak":true},{"text":"செம்மையான இருதயமுள்ளவர்கள்மேல்","poem":1},{"lineBreak":true},{"text":"உமது நீதியையும் பாராட்டியருளும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பெருமைக்காரர்களின் கால் என்மேல் வராமலும்,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய கை என்னைப் பறக்கடிக்காமலும் இருப்பதாக.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அதோ அக்கிரமக்காரர்கள் விழுந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"எழுந்திருக்கமுடியாமல் தள்ளப்பட்டுபோனார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}