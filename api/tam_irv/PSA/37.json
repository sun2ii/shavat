{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"பொல்லாதவர்களைக்குறித்து எரிச்சலடையாதே;","poem":1},{"lineBreak":true},{"text":"நியாயக்கேடு செய்கிறவர்கள்மேல் பொறாமை கொள்ளாதே.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர்கள் புல்லைப்போல் சீக்கிரமாய் அறுக்கப்பட்டு,","poem":1},{"lineBreak":true},{"text":"பச்சைத்தாவரத்தைப்போல் வாடிப்போவார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவை நம்பி நன்மைசெய்;","poem":1},{"lineBreak":true},{"text":"தேசத்தில் குடியிருந்து சத்தியத்தை மேய்ந்துகொள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவிடத்தில் மனமகிழ்ச்சியாயிரு;","poem":1},{"lineBreak":true},{"text":"அவர் உன் இருதயத்தின் வேண்டுதல்களை உனக்கு அருள்செய்வார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உன் வழியைக் யெகோவாவுக்கு ஒப்புவித்து,","poem":1},{"lineBreak":true},{"text":"அவர்மேல் நம்பிக்கையாயிரு;","poem":1},{"lineBreak":true},{"text":"அவரே காரியத்தை வாய்க்கச்செய்வார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உன் நீதியை வெளிச்சத்தைப் போலவும்,","poem":1},{"lineBreak":true},{"text":"உன் நியாயத்தைப் பட்டப்பகலைப்போலவும் விளங்கச்செய்வார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவை நோக்கி அமர்ந்து, அவருக்குக் காத்திரு;","poem":1},{"lineBreak":true},{"text":"காரியசித்தியுள்ளவன் மேலும்","poem":1},{"lineBreak":true},{"text":"தீவினைகளைச் செய்கிற மனிதன் மேலும் எரிச்சலாகாதே.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"கோபத்தை தள்ளி, கடுங்கோபத்தை விட்டுவிடு;","poem":1},{"lineBreak":true},{"text":"பொல்லாப்புச் செய்ய ஏதுவான எரிச்சல் உனக்கு வேண்டாம்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"பொல்லாதவர்கள் அறுக்கப்பட்டுபோவார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குக் காத்திருக்கிறவர்களோ","poem":1},{"lineBreak":true},{"text":"பூமியைச் சுதந்தரித்துக் கொள்வார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இன்னும் கொஞ்சநேரந்தான், அப்போது துன்மார்க்கன் இருக்கமாட்டான்;","poem":1},{"lineBreak":true},{"text":"அவன் நிலையை உற்று விசாரித்தாயானால் அவன் இல்லை.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சாந்தகுணமுள்ளவர்கள் பூமியைச் சுதந்தரித்து,","poem":1},{"lineBreak":true},{"text":"மிகுந்த சமாதானத்தினால் மனமகிழ்ச்சியாயிருப்பார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் நீதிமானுக்கு விரோதமாகத் தீங்கு நினைத்து,","poem":1},{"lineBreak":true},{"text":"அவன்மேல் பல்லைக் கடிக்கிறான்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ஆண்டவர் அவனைப் பார்த்து நகைக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய நாள் வருகிறதென்று காண்கிறார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"சிறுமையும் எளிமையுமானவனை வீழ்த்தவும்,","poem":1},{"lineBreak":true},{"text":"செம்மை மார்க்கத்தாரை விழசெய்யவும்,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் வாளை உருவி, தங்கள் வில்லை நாணேற்றுகிறார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆனாலும் அவர்கள் வாள் அவர்களுடைய இருதயத்திற்குள் உருவிப்போகும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் வில்லுகள் முறியும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அநேக துன்மார்க்கர்களுக்கு இருக்கிற திரளான செல்வத்தைவிட,","poem":1},{"lineBreak":true},{"text":"நீதிமானுக்குள்ள கொஞ்சமே நல்லது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"துன்மார்க்கருடைய கரங்கள் முறியும்;","poem":1},{"lineBreak":true},{"text":"நீதிமான்களையோ யெகோவா தாங்குகிறார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"உத்தமர்களின் நாட்களைக் யெகோவா அறிந்திருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் சுதந்தரம் என்றென்றைக்கும் இருக்கும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவர்கள் ஆபத்துக்காலத்திலே வெட்கப்பட்டுப்போகாதிருந்து,","poem":1},{"lineBreak":true},{"text":"பஞ்சகாலத்திலே திருப்தியடைவார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களோ அழிந்துபோவார்கள்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுடைய எதிரிகள் ஆட்டுக்குட்டிகளின் கொழுப்பைப்போல","poem":1},{"lineBreak":true},{"text":"புகைந்து போவார்கள், அவர்கள் புகையாய்ப் புகைந்து போவார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் கடன் வாங்கிச் செலுத்தாமற் போகிறான்;","poem":1},{"lineBreak":true},{"text":"நீதிமானோ இரங்கிக்கொடுக்கிறான்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவரால் ஆசீர்வதிக்கப்பட்டவர்கள் பூமியைச் சுதந்தரித்துக்கொள்ளுவார்கள்;","poem":1},{"lineBreak":true},{"text":"அவரால் சபிக்கப்பட்டவர்களோ அறுக்கப்பட்டுபோவார்கள்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"நல்ல மனிதனுடைய நடைகள் யெகோவாவால் உறுதிப்படும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய வழியின்மேல் அவர் பிரியமாயிருக்கிறார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"அவன் விழுந்தாலும் தள்ளப்பட்டு போவதில்லை;","poem":1},{"lineBreak":true},{"text":"யெகோவா தமது கையினால் அவனைத் தாங்குகிறார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"நான் இளைஞனாயிருந்தேன்,","poem":1},{"lineBreak":true},{"text":"முதிர்வயதுள்ளவனுமானேன்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் நீதிமான் கைவிடப்பட்டதையும்,","poem":1},{"lineBreak":true},{"text":"அவன் சந்ததி அப்பத்திற்கு பிச்சை எடுக்கிறதையும் நான் காணவில்லை.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவன் எப்பொழுதும் இரங்கிக் கடன் கொடுக்கிறான்,","poem":1},{"lineBreak":true},{"text":"அவன் சந்ததி ஆசீர்வதிக்கப்படும்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"தீமையை விட்டு விலகி, நன்மை செய்;","poem":1},{"lineBreak":true},{"text":"என்றென்றைக்கும் நிலைத்திருப்பாய்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"யெகோவா நியாயத்தை விரும்புகிறவர்;","poem":1},{"lineBreak":true},{"text":"அவர் தமது பரிசுத்தவான்களைக் கைவிடுவதில்லை;","poem":1},{"lineBreak":true},{"text":"அவர்கள் என்றைக்கும் காக்கப்படுவார்கள்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய சந்ததியோ அறுக்கப்பட்டுபோகும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"நீதிமான்கள் பூமியைச் சுதந்தரித்துக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"என்றைக்கும் அதிலே குடியிருப்பார்கள்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"நீதிமானுடைய வாய் ஞானத்தை சொல்லி,","poem":1},{"lineBreak":true},{"text":"அவனுடைய நாவு நியாயத்தைப் பேசும்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"அவனுடைய தேவன் அருளிய வேதம் அவன் இருதயத்தில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவன் நடைகளில் ஒன்றும் பிசகுவதில்லை.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"துன்மார்க்கன் நீதிமான்மேல் கண்வைத்து,","poem":1},{"lineBreak":true},{"text":"அவனைக் கொல்ல வகைதேடுகிறான்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"யெகோவாவோ அவனை இவன் கையில் விடுவதில்லை;","poem":1},{"lineBreak":true},{"text":"அவன் நியாயம் விசாரிக்கப்படும்போது, அவனை தண்டனைக்குள்ளாகத் தீர்ப்பதுமில்லை.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"நீ யெகோவாவுக்குக் காத்திருந்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய வழியைக் கைக்கொள்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது நீ பூமியைச் சுதந்தரித்துக்கொள்வதற்கு அவர் உன்னை உயர்த்துவார்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் அறுக்கப்பட்டுபோவதை நீ காண்பாய்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"கொடிய பலவந்தனான ஒரு துன்மார்க்கனைக் கண்டேன்","poem":1},{"lineBreak":true},{"text":"அவன் தனக்கேற்ற நிலத்தில் முளைத்திருக்கிற பச்சைமரத்தைப்போல் தழைத்தவனாயிருந்தான்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ஆனாலும் அவன் ஒழிந்துபோனான்; பாருங்கள்,","poem":1},{"lineBreak":true},{"text":"அவன் இல்லை; நான் மறுபடியும் போனேன்,","poem":1},{"lineBreak":true},{"text":"அவன் காணப்படவில்லை.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"நீ உத்தமனை நோக்கி,","poem":1},{"lineBreak":true},{"text":"செம்மையானவனைப் பார்த்திரு;","poem":1},{"lineBreak":true},{"text":"அந்த மனிதனுடைய முடிவு சமாதானம்.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரர் ஒன்றாக அழிக்கப்படுவார்கள்;","poem":1},{"lineBreak":true},{"text":"அறுக்கப்பட்டுபோவதே துன்மார்க்கர்களின் முடிவு.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"நீதிமான்களுடைய இரட்சிப்பு யெகோவாவால் வரும்;","poem":1},{"lineBreak":true},{"text":"இக்கட்டுக்காலத்தில் அவரே அவர்கள் அடைக்கலம்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"யெகோவா அவர்களுக்கு உதவிசெய்து,","poem":1},{"lineBreak":true},{"text":"அவர்களை விடுவிப்பார்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் அவரை நம்பியிருக்கிறபடியால்,","poem":1},{"lineBreak":true},{"text":"அவர்களைத் துன்மார்க்கர்களுடைய கைக்குத் தப்புவித்து காப்பாற்றுவார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}