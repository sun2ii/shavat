{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["நினைவுகூருதலுக்கான தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உம்முடைய கோபத்தில் என்னைக் கடிந்துகொள்ள வேண்டாம்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கடுங்கோபத்தில் என்னைத் தண்டிக்க வேண்டாம்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உம்முடைய அம்புகள் எனக்குள்ளே துளைத்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உமது கை என்னைத் தாங்குகிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உமது கோபத்தினால் என் உடலில் ஆரோக்கியமில்லை;","poem":1},{"lineBreak":true},{"text":"என் பாவத்தினால் என் எலும்புகளில் சுகமில்லை.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என் அக்கிரமங்கள் என் தலைக்கு மேலாகப் பெருகினது,","poem":1},{"lineBreak":true},{"text":"அவைகள் பாரச்சுமையைப்போல என்னால் தாங்கமுடியாத பாரமானது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என் மதியீனத்தினால் என் புண்கள் அழுகி நாற்றமெடுத்தது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் வேதனைப்பட்டு ஒடுங்கினேன்; நாள் முழுவதும் துக்கப்பட்டுத் திரிகிறேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என் குடல்கள் எரிபந்தமாக எரிகிறது;","poem":1},{"lineBreak":true},{"text":"என் உடலில் ஆரோக்கியம் இல்லை.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நான் பெலன் இழந்து, மிகவும் நொறுக்கப்பட்டேன்;","poem":1},{"lineBreak":true},{"text":"என் இருதயத்தின் கொந்தளிப்பினால் கதறுகிறேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, என் ஏக்கமெல்லாம் உமக்கு முன்பாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"என் தவிப்பு உமக்கு மறைவாக இருக்கவில்லை.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என் உள்ளம் குழம்பி அலைகிறது;","poem":1},{"lineBreak":true},{"text":"என் பெலன் என்னைவிட்டு விலகி, என் கண்களின் ஒளி கூட இல்லாமல்போனது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என் நண்பர்களும் என் தோழர்களும் என் வாதையைக் கண்டு விலகுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"என் இனத்தாரும் தூரத்திலே நிற்கிறார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என் உயிரை வாங்கத்தேடுகிறவர்கள் எனக்குக் கண்ணிகளை வைக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"எனக்குத் தீங்கை தேடுகிறவர்கள் கேடானவைகளைப் பேசி,","poem":1},{"lineBreak":true},{"text":"நாள்முழுவதும் வஞ்சனைகளை யோசிக்கிறார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நானோ செவிடனைப்போலக் கேட்காதவனாகவும்,","poem":1},{"lineBreak":true},{"text":"ஊமையனைப்போல வாய் திறக்காதவனாகவும் இருக்கிறேன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"காதுகேட்காதவனும், தன்னுடைய வாயில் பதில் இல்லாதவனுமாக இருக்கிற மனிதனைப் போலானேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமக்குக் காத்திருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என் தேவனாகிய ஆண்டவரே, நீர் பதில் கொடுப்பீர்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவர்கள் எனக்காக சந்தோஷப்படாதபடிக்கு இப்படிச் சொன்னேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கால் தவறும்போது என்மேல் பெருமை பாராட்டுவார்களே.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நான் தடுமாறி விழ ஏதுவாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய துக்கம் எப்பொழுதும் எனக்கு முன்பாக இருக்கிறது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என் அக்கிரமத்தை நான் அறிக்கையிட்டு,","poem":1},{"lineBreak":true},{"text":"என் பாவத்திற்காக கவலைப்படுகிறேன்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"என் எதிரிகள் வாழ்ந்து பலத்திருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"காரணமில்லாமல் என்னைப் பகைக்கிறவர்கள் பெருகியிருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நான் நன்மையைப் பின்பற்றுகிறபடியால்,","poem":1},{"lineBreak":true},{"text":"நன்மைக்குத் தீமை செய்கிறவர்கள் என்னை விரோதிக்கிறார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னைக் கைவிடாமலிரும்;","poem":1},{"lineBreak":true},{"text":"என் தேவனே, எனக்குத் தூரமாக இருக்கவேண்டாம்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"என்னுடைய இரட்சிப்பாகிய ஆண்டவரே,","poem":1},{"lineBreak":true},{"text":"எனக்குச் உதவிசெய்ய விரைவாகவாரும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}