{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["எதுதூன் என்னும் தலைவனுக்கு தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என்னுடைய நாவினால் பாவம்செய்யாதபடிக்கு நான் என்னுடைய","poem":1},{"lineBreak":true},{"text":"வழிகளைக் காத்து, துன்மார்க்கன் எனக்கு முன்பாக இருக்கும்வரை என்னுடைய வாயைக் கடிவாளத்தால் அடக்கிவைப்பேன் என்றேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நான் மவுனமாகி, ஊமையனாக இருந்தேன்,","poem":1},{"lineBreak":true},{"text":"நலமானதையும் பேசாமல் அமர்ந்திருந்தேன்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் என்னுடைய துக்கம் அதிகரித்தது;","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயம் எனக்குள்ளே அனல்கொண்டது;","poem":1},{"lineBreak":true},{"text":"நான் தியானிக்கும்போது நெருப்பு எரிந்தது;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது என்னுடைய நாவினால் விண்ணப்பம் செய்தேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நான் எவ்வளவாக நிலையற்றவன் என்று உணரும்படி என்னுடைய முடிவையும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய நாட்களின் அளவு இவ்வளவு என்பதையும் எனக்குத் தெரிவியும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"இதோ, என்னுடைய நாட்களை நான்கு விரல் அளவாக்கினீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆயுள் உமது பார்வைக்கு ஒன்றும் இல்லாதது போலிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"எந்த மனிதனும் மாயையே என்பது நிச்சயம். (சேலா)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நிழலைப்போலவே மனிதன் நடந்து திரிகிறான்;","poem":1},{"lineBreak":true},{"text":"வீணாகவே சஞ்சலப்படுகிறான்; சொத்தைச் சேர்க்கிறான்.","poem":1},{"lineBreak":true},{"text":"யார் அதை எடுத்துக்கொள்ளுவான் என்று அறியான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இப்போதும் ஆண்டவரே, நான் எதற்கு எதிர்பார்த்திருக்கிறேன்? நீரே என்னுடைய நம்பிக்கை.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய மீறுதல்கள் எல்லாவற்றிலுமிருந்து என்னை விடுதலையாக்கும்,","poem":1},{"lineBreak":true},{"text":"மூடனின் அவமானப்படுத்துதலுக்கு என்னை ஒப்புக்கொடுக்க வேண்டாம்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நீரே இதைச் செய்தீர் என்று நான்","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாயைத் திறக்காமல் மவுனமாக இருந்தேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என்னிலிருந்து உம்முடைய வாதையை எடுத்துப்போடும்;","poem":1},{"lineBreak":true},{"text":"உமது கையின் அடிகளால் நான் சோர்ந்து போனேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அக்கிரமத்திற்காக நீர் மனிதனைக் கடிந்துகொண்டு தண்டிக்கிறபோது,","poem":1},{"lineBreak":true},{"text":"அவன் வடிவத்தைப் பூச்சி அரிப்பதுபோல அழியச்செய்கிறீர்;","poem":1},{"lineBreak":true},{"text":"நிச்சயமாக எந்த மனிதனும் மாயையே. (சேலா)","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய ஜெபத்தைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கூப்பிடுதலை காதுகொடுத்து கேளும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கண்ணீருக்கு மவுனமாக இருக்கவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய முன்னோர்கள் எல்லோரையும்போல","poem":1},{"lineBreak":true},{"text":"நானும் உமக்குமுன்பாக அந்நியனும் நிலையற்றவனுமாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நான் இனி இல்லாமல்போவதற்குமுன்னே,","poem":1},{"lineBreak":true},{"text":"தேறுதலடையும்படி என்னிடத்தில் பொறுமையாக இரும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}