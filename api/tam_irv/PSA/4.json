{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம். இசைக்குழுவின் தலைவனுக்கு நரம்புக் கருவிகளால் இசைக்கப்பட்டது."]},{"type":"verse","number":1,"content":[{"text":"என் நீதியின் தேவனே, நான் கூப்பிடும்போது எனக்கு பதில்தாரும்;","poem":1},{"lineBreak":true},{"text":"நெருக்கத்தில் இருந்த எனக்கு விசாலமுண்டாக்கினீர்;","poem":1},{"lineBreak":true},{"text":"எனக்கு இரங்கி, என்னுடைய விண்ணப்பதைக் கேட்டருளும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மனுமக்களே, எதுவரைக்கும் என்னுடைய மகிமையை அவமானப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"வீணானதை விரும்பி, பொய்யை நாடுவீர்கள். (சேலா)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பக்தியுள்ளவனைக் யெகோவா தமக்காகத் தெரிந்துகொண்டார் என்று அறியுங்கள்;","poem":1},{"lineBreak":true},{"text":"நான் யெகோவாவை நோக்கிக் கூப்பிடும்போது அவர் கேட்பார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நீங்கள் கோபங்கொண்டாலும், பாவம் செய்யாமலிருங்கள்;","poem":1},{"lineBreak":true},{"text":"உங்கள் படுக்கையிலே உங்கள் இருதயத்தில் பேசிக்கொண்டு அமர்ந்திருங்கள். (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீதியின் பலிகளைச் செலுத்தி, யெகோவாமேல் நம்பிக்கையாக இருங்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"எங்களுக்கு நன்மை காண்பிப்பவன் யார் என்று சொல்லுகிறவர்கள் அநேகர்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உம்முடைய முகத்தின் ஒளியை எங்கள்மேல் பிரகாசிக்கச்செய்யும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர்களுக்குத் தானியமும் திராட்சைரசமும் பெருகியிருக்கிற காலத்தின் சந்தோஷத்தைவிட,","poem":1},{"lineBreak":true},{"text":"அதிக சந்தோஷத்தை என்னுடைய இருதயத்தில் கொடுத்தீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"சமாதானத்தோடு படுத்துக்கொண்டு தூங்குவேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, நீர் ஒருவரே என்னைச் சுகமாகத் தங்கச்செய்கிறீர்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}