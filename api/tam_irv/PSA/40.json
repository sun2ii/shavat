{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்காகப் பொறுமையுடன் காத்திருந்தேன்;","poem":1},{"lineBreak":true},{"text":"அவர் என்னிடமாகச் சாய்ந்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கூப்பிடுதலைக் கேட்டார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"பயங்கரமான குழியிலும் உளையான சேற்றிலுமிருந்து என்னைத் தூக்கியெடுத்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கால்களைக் கன்மலையின்மேல் நிறுத்தி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கால் அடிகளை உறுதிப்படுத்தி,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நமது தேவனைத் துதிக்கும் புதுப்பாட்டை அவர் என் வாயிலே கொடுத்தார்;","poem":1},{"lineBreak":true},{"text":"அநேகர் அதைக் கண்டு, பயந்து, யெகோவாவை நம்புவார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"பெருமைக்காரர்களையும் பொய்யைச்","poem":1},{"noteId":13},{"text":"சார்ந்திருக்கிறவர்களையும் பார்க்காமல்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவையே தன்னுடைய நம்பிக்கையாக வைக்கிற மனிதன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நீர் எங்களுக்காக செய்த உம்முடைய அதிசயங்களும் உம்முடைய யோசனைகளும் அநேகமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"ஒருவரும் அவைகளை உமக்கு விவரித்துச் சொல்லி முடியாது.","poem":1},{"lineBreak":true},{"text":"நான் அவைகளைச் சொல்லி அறிவிக்கவேண்டுமானால் அவைகள் எண்ணிக்கைக்கு மேலானவைகள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பலியையும் காணிக்கையையும் நீர் விரும்பாமல்,","poem":1},{"lineBreak":true},{"text":"என் காதுகளைத் திறந்தீர்;","poem":1},{"lineBreak":true},{"text":"சர்வாங்க தகனபலியையும் பாவநிவாரணபலியையும் நீர் கேட்கவில்லை.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அப்பொழுது நான்: இதோ, வருகிறேன், புத்தகச்சுருளில் என்னைக் குறித்து எழுதியிருக்கிறது;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என் தேவனே, உமக்குப் பிரியமானதைச் செய்ய விரும்புகிறேன்;","poem":1},{"lineBreak":true},{"text":"உமது நியாயப்பிரமாணம் என்னுடைய உள்ளத்திற்குள் இருக்கிறது என்று சொன்னேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மகா சபையிலே நீதியைப் பிரசங்கித்தேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உதடுகளை மூடமாட்டேன்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, நீர் அதை அறிவீர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உம்முடைய நீதியை நான் என்னுடைய இருதயத்திற்குள் மறைத்து வைக்கவில்லை;","poem":1},{"lineBreak":true},{"text":"உமது சத்தியத்தையும் உமது இரட்சிப்பையும் சொல்லியிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"உமது கிருபையையும் உமது உண்மையையும் மகா சபைக்கு அறிவிக்காதபடிக்கு நான் ஒளித்துவைக்கவில்லை.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவே நீர் உம்முடைய இரக்கங்களை எனக்குக் கிடைக்காமல் போகச்செய்யவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"உமது கிருபையும் உமது உண்மையும் எப்பொழுதும் என்னைக் காக்கட்டும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"எண்ணிக்கைக்கு அடங்காத தீமைகள் என்னைச் சூழ்ந்துகொண்டது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய அக்கிரமங்கள் என்னைத் தொடர்ந்து பிடித்தது, நான் நிமிர்ந்து பார்க்கமுடியாமல் இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"அவைகள் என்னுடைய தலைமுடியிலும் அதிகமாக இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயம் சோர்ந்துபோகிறது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னை விடுவித்தருளும்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, எனக்கு உதவிசெய்ய விரைந்துவாரும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"என்னுடைய உயிரை அழிக்கத் தேடுகிறவர்கள் ஒன்றாக வெட்கி நாணி,","poem":1},{"lineBreak":true},{"text":"எனக்குத் தீங்குசெய்ய விரும்புகிறவர்கள் பின்னிட்டு அவமானமடைவார்களாக.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என்னுடைய பெயரில் ஆ ஆ! ஆ ஆ! என்று சொல்லுகிறவர்கள்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய வெட்கத்தின் பலனையடைந்து கைவிடப்படுவார்களாக.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உம்மைத் தேடுகிற அனைவரும் உமக்குள் மகிழ்ந்து சந்தோஷப்படுவார்களாக;","poem":1},{"lineBreak":true},{"text":"உம்முடைய இரட்சிப்பை விரும்புகிறவர்கள் யெகோவாவுக்கு மகிமை உண்டாவதாக என்று","poem":1},{"lineBreak":true},{"text":"எப்பொழுதும் சொல்வார்களாக.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நான் ஏழ்மையும் தேவையுமுள்ளவன்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவோ என்மேல் நினைவாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"தேவனே நீர் என்னுடைய துணையும் என்னை விடுவிக்கிறவருமாக இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என் தேவனே, தாமதிக்க வேண்டாம்.","poem":1}]}],"footnotes":[{"noteId":13,"caller":"+","text":"தேவர்களையும்","reference":{"chapter":40,"verse":4}}]},"thisChapterLink":"/api/tam_irv/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}