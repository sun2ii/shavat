{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["இராகத்தலைவனுக்கு தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"பெலவீனமானவன்மேல் கவலையுள்ளவன் பாக்கியவான்;","poem":1},{"lineBreak":true},{"text":"தீங்குநாளில் யெகோவா அவனை விடுவிப்பார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா அவனைப் பாதுகாத்து அவனை உயிரோடு வைப்பார்;","poem":1},{"lineBreak":true},{"text":"பூமியில் அவன் பாக்கியவானாக இருப்பான்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய எதிரிகளின் விருப்பத்திற்கு நீர் அவனை ஒப்புக்கொடுப்பதில்லை.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"படுக்கையின்மேல் வியாதியாகக் கிடக்கிற அவனைக் யெகோவா தாங்குவார்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய வியாதியிலே அவனுடைய படுக்கை முழுவதையும் மாற்றிப்போடுவார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்மேல் இரக்கமாயிரும்;","poem":1},{"lineBreak":true},{"text":"உமக்கு விரோதமாகப் பாவம்செய்தேன்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவைக் குணமாக்கும் என்று நான் சொன்னேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவன் எப்பொழுது சாவான்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய பெயர் எப்பொழுது அழியும் என்று என்னுடைய எதிரிகள் எனக்கு விரோதமாகச் சொல்லுகிறார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ஒருவன் என்னைப் பார்க்கவந்தால் வஞ்சனையாகப் பேசுகிறான்;","poem":1},{"lineBreak":true},{"text":"அவன் தன்னுடைய இருதயத்தில் அக்கிரமத்தைச் சேகரித்துக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"தெருவிலே போய், அதைத் தூற்றுகிறான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் எல்லோரும் என்மேல் ஒன்றாக முணுமுணுத்து,","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாக இருந்து, எனக்குத் தீங்கு நினைத்து,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தீராத வியாதி அவனைப் பிடித்துக் கொண்டது;","poem":1},{"lineBreak":true},{"text":"படுக்கையில் கிடக்கிற அவன் இனி எழுந்திருப்பதில்லை என்கிறார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என்னுடைய உயிர்நண்பனும், நான் நம்பினவனும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய அப்பம் சாப்பிட்டவனுமாகிய மனிதனும், என்மேல் தன்னுடைய குதிகாலைத் தூக்கினான்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் எனக்கு இரங்கி,","poem":1},{"lineBreak":true},{"text":"நான் அவர்களுக்குச் சரிக்கட்ட என்னை எழுந்திருக்கச்செய்யும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரி என்மேல் வெற்றி பெறாததினால்,","poem":1},{"lineBreak":true},{"text":"நீர் என்மேல் பிரியமாக இருக்கிறீரென்று அறிவேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீர் என்னுடைய உத்தமத்திலே என்னைத் தாங்கி,","poem":1},{"lineBreak":true},{"text":"என்றென்றைக்கும் உம்முடைய சமுகத்தில் என்னை நிலைநிறுத்துவீர்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"இஸ்ரவேலின் தேவனாகிய யெகோவா எப்பொழுதும் என்றென்றைக்குமுள்ள","poem":1},{"lineBreak":true},{"text":"எல்லாக் காலங்களிலும் நன்றிசெலுத்தப்படக்கூடியவர்.","poem":1},{"lineBreak":true},{"text":"ஆமென், ஆமென்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}