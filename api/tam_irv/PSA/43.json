{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"தேவனே, நீர் என்னுடைய நியாயத்தை விசாரித்து,","poem":1},{"lineBreak":true},{"text":"பக்தியில்லாத தேசத்தாரோடு எனக்காக வழக்காடி, தீயவனும்,","poem":1},{"lineBreak":true},{"text":"அநியாயமுமான மனிதனுக்கு என்னைத் தப்புவியும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என் பெலனாகிய தேவன் நீர்;","poem":1},{"lineBreak":true},{"text":"ஏன் என்னைத் தள்ளிவிடுகிறீர்? எதிரியால் ஒடுக்கப்பட்டு நான் ஏன் துக்கத்துடனே திரியவேண்டும்?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உமது வெளிச்சத்தையும் உமது சத்தியத்தையும் அனுப்பியருளும்;","poem":1},{"lineBreak":true},{"text":"அவைகள் என்னை நடத்தி,","poem":1},{"lineBreak":true},{"text":"உமது பரிசுத்த மலைக்கும் உம்முடைய தங்கும் இடங்களுக்கும் என்னைக் கொண்டுபோகட்டும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அப்பொழுது நான் தேவனுடைய பீடத்தின் அருகிலும்,","poem":1},{"lineBreak":true},{"text":"எனக்கு ஆனந்த மகிழ்ச்சியாக இருக்கிற தேவனிடத்திற்கும் நுழைவேன். தேவனே,","poem":1},{"lineBreak":true},{"text":"என் தேவனே, உம்மைச் சுரமண்டலத்தால் துதிப்பேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என் ஆத்துமாவே, நீ ஏன் கலங்குகிறாய்?","poem":1},{"lineBreak":true},{"text":"ஏன் எனக்குள் கவலைப்படுகிறாய்? தேவனை நோக்கிக் காத்திரு;","poem":1},{"lineBreak":true},{"text":"என் முகத்திற்கு இரட்சிப்பும் என் தேவனுமாக இருக்கிறவரை நான் இன்னும் துதிப்பேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}