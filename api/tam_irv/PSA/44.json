{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["கோராகின் குடும்பத்தின் மஸ்கீல் என்னும் இராகத் தலைவனிடம் கொடுக்கப்பட்ட தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, எங்கள் முன்னோர்களுடைய நாட்களாகிய முற்காலத்தில்","poem":1},{"lineBreak":true},{"text":"நீர் நடப்பித்த செயல்களை அவர்கள் எங்களுக்கு அறிவித்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அவைகளை எங்களுடைய காதுகளால் கேட்டோம்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தேவனே நீர் உம்முடைய கையினாலே தேசங்களைத் துரத்தி, இவர்களை நாட்டி;","poem":1},{"lineBreak":true},{"text":"மக்களைத் துன்பப்படுத்தி, இவர்களைப் பரவச்செய்தீர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய வாளினால் தேசத்தைக் கட்டிக்கொள்ளவில்லை;","poem":1},{"lineBreak":true},{"text":"அவர்கள் கைகளும் அவர்களைப் பாதுகாக்கவில்லை;","poem":1},{"lineBreak":true},{"text":"நீர் அவர்கள்மேல் பிரியமாக இருந்தபடியால்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய வலதுகையும், உம்முடைய கையும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய முகத்தின் பிரகாசமும் அவர்களுக்குச் சாதகமாக இருந்தது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தேவனே, நீர் என்னுடைய ராஜா;","poem":1},{"lineBreak":true},{"text":"யாக்கோபுக்கு ஜெயத்தை கட்டளையிடுவீராக","poem":1},{"noteId":14},{"text":".","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்மாலே எங்களுடைய எதிரிகளைக் கீழே விழத்தாக்கி,","poem":1},{"lineBreak":true},{"text":"எங்களுக்கு விரோதமாக எழும்புகிறவர்களை உம்முடைய பெயரினால் மிதிப்போம்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என்னுடைய வில்லை நான் நம்பமாட்டேன்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாள் என்னை பாதுகாப்பதில்லை.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீரே எங்களுடைய எதிரிகளிடமிருந்து எங்களை பாதுகாத்து,","poem":1},{"lineBreak":true},{"text":"எங்களைப் பகைக்கிறவர்களை வெட்கப்படுத்துகிறீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தேவனுக்குள் எப்போதும் மேன்மைபாராட்டுவோம்;","poem":1},{"lineBreak":true},{"text":"உமது பெயரை என்றென்றைக்கும் துதிப்போம். (சேலா)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நீர் எங்களைத் தள்ளிவிட்டு,","poem":1},{"lineBreak":true},{"text":"வெட்கமடையச்செய்கிறீர்;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய படைகளுடனே செல்லாமலிருக்கிறீர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எதிரிக்கு நாங்கள் பின்னிட்டுத் திரும்பிப்போகச்செய்கிறீர்;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய பகைவர் தங்களுக்கென்று எங்களைக் கொள்ளையிடுகிறார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நீர் எங்களை ஆடுகளைப்போல இரையாக ஒப்புக்கொடுத்து,","poem":1},{"lineBreak":true},{"text":"தேசங்களுக்குள்ளே எங்களைச் சிதறடிக்கிறீர்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீர் உம்முடைய மக்களை இலவசமாக விற்கிறீர்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் கிரயத்தினால் உமக்கு லாபமில்லையே.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"எங்களுடைய அயலாருக்கு எங்களை நிந்தையாகவும்,","poem":1},{"lineBreak":true},{"text":"எங்கள் சுற்றுப்புறத்தாருக்கு ஏளனத்திற்கும்,","poem":1},{"lineBreak":true},{"text":"பழிப்புகளுக்கும் வைக்கிறீர்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நாங்கள் தேசங்களுக்குள்ளே பழமொழியாக இருக்கவும்,","poem":1},{"lineBreak":true},{"text":"மக்கள் எங்களைக்குறித்துத் தலைதூக்கவும் செய்கிறீர்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நிந்தித்துத் தூஷிக்கிறவனுடைய சத்தத்தினிமித்தமும், எதிரிகளினிமித்தமும்,","poem":1},{"lineBreak":true},{"text":"பழிவாங்குகிறவர்னிமித்தமும்,","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"என்னுடைய அவமானம் எப்போதும் எனக்கு முன்பாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய முகத்தின் வெட்கம் என்னை மூடுகிறது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"இவையெல்லாம் எங்கள்மேல் வந்திருந்தும்,","poem":1},{"lineBreak":true},{"text":"உம்மை நாங்கள் மறக்கவும் இல்லை,","poem":1},{"lineBreak":true},{"text":"உம்முடைய உடன்படிக்கைக்குத் துரோகம்செய்யவும் இல்லை.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நீர் எங்களை வலுசர்ப்பங்களுள்ள இடத்திலே நொறுக்கி,","poem":1},{"lineBreak":true},{"text":"மரண இருளினாலே எங்களை மூடியிருந்தும்,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"எங்களுடைய இருதயம் பின்வாங்கவும் இல்லை, எங்களுடைய காலடி உம்முடைய பாதையைவிட்டு விலகவும் இல்லை.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நாங்கள் எங்கள் தேவனுடைய பெயரை மறந்து,","poem":1},{"lineBreak":true},{"text":"அந்நியதேவனை நோக்கிக் கையெடுத்திருந்தோமானால்,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"தேவன் அதை ஆராய்ந்து, விசாரிக்காமல் இருப்பாரோ?","poem":1},{"lineBreak":true},{"text":"இருதயத்தின் ரகசியங்களை அவர் அறிந்திருக்கிறாரே.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"உமக்காக எந்நேரமும் கொல்லப்படுகிறோம்;","poem":1},{"lineBreak":true},{"text":"அடிக்கப்படும் ஆடுகளைப்போல எண்ணப்படுகிறோம்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, விழித்துக்கொள்ளும்; ஏன் தூங்குகிறீர்?","poem":1},{"lineBreak":true},{"text":"எழுந்தருளும், எங்களை என்றைக்கும் தள்ளிவிடாமலிரும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"ஏன் உம்முடைய முகத்தை மறைத்து,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய துன்பத்தையும் எங்களுடைய நெருக்கத்தையும் மறந்துவிடுகிறீர்?","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"எங்களுடைய ஆத்துமா புழுதிவரை தாழ்ந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய வயிறு தரையோடு ஒட்டியிருக்கிறது.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"எங்களுக்கு ஒத்தாசையாக எழுந்தருளும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கிருபையினிமித்தம் எங்களை மீட்டுவிடும்.","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"தேவனே ஜெயத்தை யாக்கோபுக்கு கட்டளையிடும்","reference":{"chapter":44,"verse":4}}]},"thisChapterLink":"/api/tam_irv/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}