{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["கோராகு குமாரர்கள் எழுதின சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என்னுடைய இருதயம் நல்ல விசேஷத்தினால் பொங்குகிறது;","poem":1},{"lineBreak":true},{"text":"நான் ராஜாவைக் குறித்துப் பாடின கவியைச் சொல்லுகிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய நாவு விரைவாக எழுதுகிறவனுடைய எழுத்தாணி.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எல்லா மனிதர்களிலும் நீர் மிக அழகுள்ளவர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய உதடுகளில் அருள் பொழிகிறது;","poem":1},{"lineBreak":true},{"text":"ஆகையால் தேவன் உம்மை என்றென்றைக்கும் ஆசீர்வதிக்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"சவுரியவானே, உமது மகிமையும் உமது மகத்துவமுமாகிய","poem":1},{"lineBreak":true},{"text":"உம்முடைய வாளை நீர் உம்முடைய இடுப்பிலே கட்டிக்கொண்டு,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"சத்தியத்தினிமித்தமும், நீதியுடன் கூடிய சாந்தத்தினிமித்தமும்,","poem":1},{"lineBreak":true},{"text":"உமது மகத்துவத்திலே ஜெயமாக ஏறிவாரும்;","poem":1},{"lineBreak":true},{"text":"உமது வலதுகரம் பயங்கரமானவைகளை உமக்கு விளங்கச்செய்யும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்முடைய அம்புகள் கூர்மையானவைகள்,","poem":1},{"lineBreak":true},{"text":"அவைகள் ராஜாவுடைய எதிரிகளின் இருதயத்திற்குள் பாயும்;","poem":1},{"lineBreak":true},{"text":"மக்கள்கூட்டங்கள் உமக்குக் கீழே விழும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உமக்கு தேவன் கொடுத்த சிங்காசனம் என்றென்றைக்குமுள்ளது,","poem":1},{"noteId":15},{"lineBreak":true},{"text":"உமது ராஜ்ஜியத்தின் செங்கோல் நீதியுள்ள செங்கோலாக இருக்கிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீர் நீதியை விரும்பி, அக்கிரமத்தை வெறுக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"ஆதலால் தேவனே, உம்முடைய தேவன்","poem":1},{"lineBreak":true},{"text":"உமது தோழர்களைவிட உம்மை ஆனந்ததைலத்தினால் அபிஷேகம்செய்தார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தந்தத்தினால் செய்த அரண்மனைகளிலிருந்து புறப்படும்போது,","poem":1},{"lineBreak":true},{"text":"நீர் மகிழும்படி உமது ஆடைகளை எல்லாம்","poem":1},{"lineBreak":true},{"text":"வெள்ளைப்போளம் சந்தனம் லவங்கம் இவைகளின் வாசனை பொருந்தியதாக இருக்கிறது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உமது நாயகிகளுக்குள்ளே அரசரின் மகள்களும் உண்டு,","poem":1},{"lineBreak":true},{"text":"இளவரசி ஓப்பீரின் தங்கம் அணிந்தவளாக உமது வலதுபக்கத்தில் நிற்கிறாள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"மகளே கேள், நீ உன்னுடைய செவியைச் சாய்த்து சிந்தித்துக்கொள்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய மக்களையும் உன்னுடைய தகப்பன் வீட்டையும் மறந்துவிடு.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அப்பொழுது ராஜா உன்னுடைய அழகில் பிரியப்படுவார்;","poem":1},{"lineBreak":true},{"text":"அவர் உன்னுடைய ஆண்டவர், ஆகையால் அவரைப் பணிந்துகொள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தீரு மகள் காணிக்கை கொண்டுவருவாள்;","poem":1},{"lineBreak":true},{"text":"மக்களில் ஜசுவரியவான்களும் உன்னுடைய தயவை நாடி வணங்குவார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"இளவரசி உள்ளாகப் பூரண மகிமையுள்ளவள்;","poem":1},{"lineBreak":true},{"text":"அவளுடைய உடை பொற்சரிகையாக இருக்கிறது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"வேலைப்பாடு நிறைந்த உடை அணிந்தவளாக,","poem":1},{"lineBreak":true},{"text":"ராஜாவினிடத்தில் அழைத்துக்கொண்டு வரப்படுவாள்;","poem":1},{"lineBreak":true},{"text":"அவள் பின்னாலே செல்லும் அவளுடைய தோழிகளாகிய கன்னிகைகள்","poem":1},{"lineBreak":true},{"text":"உம்மிடத்தில் கூட்டிக்கொண்டு வரப்படுவார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவர்கள் மகிழ்ச்சியோடும், சந்தோஷத்தோடும் வந்து,","poem":1},{"lineBreak":true},{"text":"ராஜ அரண்மனைக்குள் நுழைவார்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உமது தகப்பன்மார்களுக்குப் பதிலாக உமது மகன்கள் இருப்பார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களைப் பூமியெங்கும் பிரபுக்களாக வைப்பீர்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உமது பெயரை எல்லாத் தலைமுறைகளிலும் நினைவுபடுத்துவேன்;","poem":1},{"lineBreak":true},{"text":"இதற்காக மக்கள் உம்மை என்றென்றைக்குமுள்ள எல்லாக் காலங்களிலும் துதிப்பார்கள்.","poem":1}]}],"footnotes":[{"noteId":15,"caller":"+","text":"தேவனே, உமது சிங்காசனம் என்றென்றைக்குமுள்ளது","reference":{"chapter":45,"verse":6}}]},"thisChapterLink":"/api/tam_irv/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}