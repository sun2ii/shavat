{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["அலமோத் என்னும் கருவியில் வாசிக்கும்படி கொடுக்கப்பட்ட கோராகின் குடும்பத்தின் இராகத் தலைவனுக்கு, ஒரு பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவன் நமக்கு அடைக்கலமும் பெலனும்,","poem":1},{"lineBreak":true},{"text":"ஆபத்துக்காலத்தில் அனுகூலமான துணையுமானவர்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஆகையால் பூமி நிலைமாறினாலும், மலைகள் நடுக்கடலில் சாய்ந்துபோனாலும்,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அதின் தண்ணீர்கள் கொந்தளித்துப் பொங்கி, அதின் பெருக்கினால் மலைகள் அதிர்ந்தாலும்,","poem":1},{"lineBreak":true},{"text":"நாம் பயப்படமாட்டோம். (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ஒரு நதியுண்டு, அதின் நீரோடைகள் தேவனுடைய நகரத்தையும்,","poem":1},{"lineBreak":true},{"text":"உன்னதமான தேவன் தங்கும் பரிசுத்தஸ்தலத்தையும் சந்தோஷப்படுத்தும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவன் அதின் நடுவில் இருக்கிறார், அது அசையாது;","poem":1},{"lineBreak":true},{"text":"அதிகாலையிலே தேவன் அதற்கு உதவி செய்வார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தேசங்கள் கொந்தளித்தது, ராஜ்ஜியங்கள் தத்தளித்தது;","poem":1},{"lineBreak":true},{"text":"அவர் தமது சத்தத்தை முழங்கச்செய்தார், பூமி உருகிப்போனது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"சேனைகளின் யெகோவா நம்மோடிருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் தேவன் நமக்கு உயர்ந்த அடைக்கலமானவர். (சேலா)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பூமியிலே அழிவுகளை நடப்பிக்கிற யெகோவாவுடைய செய்கைகளை வந்துபாருங்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் பூமியின் கடைசிவரை யுத்தங்களை ஓயச்செய்கிறார்;","poem":1},{"lineBreak":true},{"text":"வில்லை ஒடித்து, ஈட்டியை முறிக்கிறார்;","poem":1},{"lineBreak":true},{"text":"இரதங்களை","poem":1},{"noteId":16},{"text":"நெருப்பினால் சுட்டெரிக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நீங்கள் யுத்தம் செய்யாமலிருந்து,","poem":1},{"lineBreak":true},{"text":"நானே தேவனென்று அறிந்துகொள்ளுங்கள் என்று தேவன் சொல்லுகிறார்;","poem":1},{"lineBreak":true},{"text":"தேசங்களுக்குள்ளே உயர்ந்திருப்பேன், பூமியிலே உயர்ந்திருப்பேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சேனைகளின் யெகோவா நம்மோடிருக்கிறார்,","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் தேவன் நமக்கு உயர்ந்த அடைக்கலமானவர் (சேலா).","poem":1}]}],"footnotes":[{"noteId":16,"caller":"+","text":"கேடகங்களை மரத்தினாலும் தோலினாலும் செய்யப்பட்டதாயிருந்தது எரிந்து போக கூடியதாய் இருந்தது.","reference":{"chapter":46,"verse":9}}]},"thisChapterLink":"/api/tam_irv/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}