{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["கோராகின் குடும்பத்தின் இராகத் தலைவனுக்கு அளிக்கப்பட்ட ஒரு பாடல்."]},{"type":"verse","number":1,"content":[{"text":"எல்லா மக்களே, கைகொட்டி,","poem":1},{"lineBreak":true},{"text":"தேவனுக்கு முன்பாகக் கெம்பீரசத்தமாக ஆர்ப்பரியுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உன்னதமான தேவனாகிய யெகோவா பயங்கரமானவரும்,","poem":1},{"lineBreak":true},{"text":"பூமியின் மீதெங்கும் மகத்துவமான ராஜாவுமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மக்களை நமக்கு கீழ்படுத்தி,","poem":1},{"lineBreak":true},{"text":"தேசங்களை நம்முடைய பாதங்களுக்குக் கீழ்ப்படுத்துவார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தமக்குப் பிரியமான யாக்கோபின் சிறப்பான தேசத்தை நமக்குச் உரிமைச்சொத்தாக தெரிந்தளிப்பார். (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவன் ஆர்ப்பரிப்போடும், யெகோவா எக்காள சத்தத்தோடும் உயர எழுந்தருளினார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தேவனைப் போற்றிப் பாடுங்கள், பாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"நம்முடைய ராஜாவைப் போற்றிப் பாடுங்கள், பாடுங்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவன் பூமியனைத்திற்கும் ராஜா; கருத்துடனே அவரைப் போற்றிப் பாடுங்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தேவன் தேசங்களின்மேல் அரசாளுகிறார்;","poem":1},{"lineBreak":true},{"text":"தேவன் தமது பரிசுத்த சிங்காசனத்தின்மேல் அமர்ந்திருக்கிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மக்களின் பிரபுக்கள் ஆபிரகாமின் தேவனுடைய மக்களாகச் சேர்க்கப்படுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"பூமியின் கேடகங்கள் தேவனுடையவைகள்;","poem":1},{"lineBreak":true},{"text":"அவர் மகா உன்னதமான தேவன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}