{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["கோராகின் மகன்களுக்கு அளிக்கப்பட்ட ஒரு துதியின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா பெரியவர், அவர் நமது தேவனுடைய நகரத்திலும்,","poem":1},{"lineBreak":true},{"text":"தமது பரிசுத்த மலையிலும் மிகவும் துதிக்கப்படத்தக்கவர்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"வடதிசையிலுள்ள சீயோன் மலை அழகான உயரமும் முழு பூமியின் மகிழ்ச்சியுமாக இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"அதுவே மகாராஜாவின் நகரம்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அதின் அரண்மனைகளில் தேவன் உயர்ந்த அடைக்கலமாக அறியப்பட்டிருக்கிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இதோ, ராஜாக்கள் கூடிக்கொண்டு, ஒன்றாகக் கடந்துவந்தார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர்கள் அதைக் கண்டபோது பிரமித்துக் கலங்கி விரைந்தோடினார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அங்கே நடுக்கங்கொண்டு,","poem":1},{"lineBreak":true},{"text":"பிரசவ வேதனைப்படுகிற பெண்ணைப்போல வேதனைப்பட்டார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"கிழக்கு காற்றினால் தர்ஷீசின் கப்பல்களை நீர் உடைக்கிறீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நாம் கேள்விப்பட்டபடியே நமது தேவனுடைய நகரமாகிய சேனைகளுடைய யெகோவாவின் நகரத்திலே கண்டோம்;","poem":1},{"lineBreak":true},{"text":"தேவன் அதை என்றென்றைக்கும் பாதுகாப்பார். (சேலா)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தேவனே, உமது ஆலயத்தின் நடுவிலே,","poem":1},{"lineBreak":true},{"text":"உமது கிருபையைச் சிந்தித்துக் கொண்டிருக்கிறோம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தேவனே, உமது பெயர் வெளிப்படுகிறதுபோல","poem":1},{"lineBreak":true},{"text":"உமது புகழ்ச்சியும் பூமியின் கடைசிவரையிலும் வெளிப்படுகிறது;","poem":1},{"lineBreak":true},{"text":"உமது வலதுகை நீதியால் நிறைந்திருக்கிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"உம்முடைய நியாயத்தீர்ப்புகளுக்காக சீயோன் மலை மகிழ்வதாக,","poem":1},{"lineBreak":true},{"text":"யூதாவின் மக்கள் சந்தோஷப்படுவார்களாக.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"சீயோனைச் சுற்றி உலாவி, அதின் கோபுரங்களை எண்ணுங்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"பின்வரும் சந்ததிக்கு நீங்கள் விவரிப்பதற்காக,","poem":1},{"lineBreak":true},{"text":"அதின் சுவரை கவனித்து,","poem":1},{"lineBreak":true},{"text":"அதின் அரண்மனைகளை உற்றுப்பாருங்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"இந்த தேவன் என்றென்றைக்குமுள்ள எல்லா காலங்களிலும் நம்முடைய தேவன்;","poem":1},{"lineBreak":true},{"text":"மரணம்வரை நம்மை நடத்துவார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}