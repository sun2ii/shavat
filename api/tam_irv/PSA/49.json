{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["கோராகின் புத்திரருக்கு அளிக்கப்பட்ட ஒரு துதியின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"மக்களே, நீங்கள் எல்லோரும் இதைக் கேளுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"பூமியின் குடிமக்களே, சிறியோரும் பெரியோரும்","poem":1},{"lineBreak":true},{"text":"ஐசுவரியவான்களும் ஏழ்மையானவர்களுமாகிய நீங்கள் எல்லோரும் ஒன்றாக கேளுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என் வாய் ஞானத்தைப் பேசும்; என் இருதயம் உணர்வைத் தியானிக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என் கவனத்தை உவமைக்குச் சாய்த்து,","poem":1},{"lineBreak":true},{"text":"என் மறைபொருளைச் சுரமண்டலத்தின்மேல் வெளிப்படுத்துவேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என்னைத் தொடருகிறவர்களுடைய அக்கிரமம்","poem":1},{"lineBreak":true},{"text":"என்னைச் சூழ்ந்துகொள்ளும் தீங்குநாட்களில்,","poem":1},{"lineBreak":true},{"text":"நான் பயப்படவேண்டியதென்ன?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தங்களுடைய செல்வத்தை நம்பி தங்களுடைய அதிக செல்வத்தினால் பெருமைபாராட்டுகிற,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஒருவனாவது, தன்னுடைய சகோதரன்","poem":1},{"noteId":17},{"text":"அழிவைக் காணாமல்","poem":1},{"lineBreak":true},{"text":"இனி என்றைக்கும் உயிரோடிருக்கும்படி,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவனை மீட்டுக்கொள்ளவும்,","poem":1},{"lineBreak":true},{"text":"அவனுக்காக மீட்கும்பொருளை தேவனுக்குக் கொடுக்கவும்முடியாதே.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர்கள் ஆத்துமமீட்பு மிகவும் அருமையாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அது ஒருபோதும் முடியாது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஞானிகளும் இறந்து, அஞ்ஞானிகளும் மூடர்களும் ஒன்றாக அழிந்து,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய சொத்தை மற்றவர்களுக்கு வைத்துப்போகிறதைக் காண்கிறான்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தங்களுடைய கல்லறைகள் நிரந்தரகாலமாகவும்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய குடியிருப்புகள் தலைமுறை தலைமுறையாகவும்","poem":1},{"lineBreak":true},{"text":"இருக்குமென்பது அவர்களுடைய உள்ளத்தின் அபிப்பிராயம்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய பெயர்களைத் தங்களுடைய நிலங்களுக்குச் சூட்டுகிறார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ஆகிலும் மரியாதைக்குரியவனாக இருக்கிற மனிதன் நிலைத்திருக்கிறதில்லை;","poem":1},{"lineBreak":true},{"text":"அழிந்துபோகும் மிருகங்களுக்கு ஒப்பாக இருக்கிறான்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"இதுதான் அவர்களுடைய வழி, இதுதான் அவர்களுடைய பைத்தியம்;","poem":1},{"lineBreak":true},{"text":"ஆகிலும் அவர்கள் சந்ததியார் அவர்கள் சொல்லை மெச்சிக்கொள்ளுகிறார்கள். (சேலா)","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"ஆட்டுமந்தையைப்போல பாதாளத்திலே கிடத்தப்படுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"மரணம் அவர்களுடைய மேய்ப்பனாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"செம்மையானவர்கள் அதிகாலையில் அவர்களை ஆண்டுகொள்வார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய குடியிருக்கும் இடத்தில் நிலைத்திருக்கமுடியாதபடி அவர்களுடைய உருவத்தை பாதாளம் அழிக்கும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆனாலும் தேவன் என்னுடைய ஆத்துமாவைப் பாதாளத்தின் வல்லமைக்குத் தப்புவித்து மீட்பார்,","poem":1},{"lineBreak":true},{"text":"அவர் என்னை ஏற்றுக்கொள்வார். (சேலா)","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"ஒருவன் செல்வந்தனாகி,","poem":1},{"lineBreak":true},{"text":"அவனுடைய வீட்டின் மகிமை பெருகும்போது, நீ பயப்படாதே.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவன் இறக்கும்போது ஒன்றும் கொண்டுபோவதில்லை;","poem":1},{"lineBreak":true},{"text":"அவனுடைய மகிமை அவனைப் பின்பற்றிச் செல்வதுமில்லை.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவன் உயிரோடிருக்கும்போது தன்னுடைய ஆத்துமாவை வாழ்த்தினாலும்:","poem":1},{"lineBreak":true},{"text":"நீ உனக்கு நன்மையை நாடினாய் என்று மனிதர்கள் அவனைப் புகழ்ந்தாலும்,","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவன் என்றென்றைக்கும் வெளிச்சத்தைக் காணாத","poem":1},{"lineBreak":true},{"text":"தன்னுடைய தகப்பன்மார்களின் சந்ததியைச் சேருவான்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"மரியாதைக்குரியவனாக இருந்தும் அறிவில்லாத மனிதன்","poem":1},{"lineBreak":true},{"text":"அழிந்துபோகும் மிருகங்களுக்கு ஒப்பாக இருக்கிறான்.","poem":1}]}],"footnotes":[{"noteId":17,"caller":"+","text":"தன்னையே","reference":{"chapter":49,"verse":7}}]},"thisChapterLink":"/api/tam_irv/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}