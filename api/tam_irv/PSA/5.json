{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["புல்லாங்குழலில் வாசிக்க இசைக்குழுவின் தலைவனிடம் அளிக்கப்பட்ட தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என்னுடைய வார்த்தைகளுக்குச் செவிகொடும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய தியானத்தைக் கவனியும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நான் உம்மையே நோக்கி விண்ணப்பம் செய்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என் இராஜாவே, என் தேவனே, என் வேண்டுதலின் சத்தத்தைக் கேட்டருளும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே, காலையிலே என்னுடைய சத்தத்தைக் கேட்டருளுவீர்;","poem":1},{"lineBreak":true},{"text":"காலையிலே உமக்கு நேராக வந்து ஆயத்தமாகி, காத்திருப்பேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நீர் துன்மார்க்கத்தில் பிரியப்படுகிற தேவன் அல்ல;","poem":1},{"lineBreak":true},{"text":"தீமை உம்மிடத்தில் சேர்வதில்லை.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"வீம்புக்காரர்கள் உம்முடைய கண்களுக்கு முன்பாக நிலைநிற்கமாட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"அக்கிரமக்காரர்கள் யாவரையும் வெறுக்கிறீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பொய் பேசுகிறவர்களை அழிப்பீர்;","poem":1},{"lineBreak":true},{"text":"கொலை வெறியர்களையும்","poem":1},{"lineBreak":true},{"text":"வஞ்சகமான மனிதனையும் யெகோவா அருவருக்கிறார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நானோ உமது மிகுந்த கிருபையினாலே உமது ஆலயத்திற்குள் நுழைந்து,","poem":1},{"lineBreak":true},{"text":"உமது பரிசுத்த சந்நிதிக்கு நேரே பயபக்தியுடன் பணிந்துகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய எதிரிகளுக்காக என்னை உம்முடைய நீதியிலே நடத்தி,","poem":1},{"lineBreak":true},{"text":"எனக்கு முன்பாக உம்முடைய வழியைச் செவ்வைப்படுத்தும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர்கள் வாயில் உண்மை இல்லை,","poem":1},{"lineBreak":true},{"text":"அவர்கள் உள்ளம் கேடுபாடுள்ளது;","poem":1},{"lineBreak":true},{"text":"அவர்கள் தொண்டை திறக்கப்பட்ட கல்லறையாகும்;","poem":1},{"lineBreak":true},{"text":"தங்களுடைய நாவினால் வஞ்சகம் பேசுகிறார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தேவனே, அவர்களைக் குற்றவாளிகளாகத் தீர்த்திடும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய ஆலோசனைகளாலேயே விழும்படி செய்திடும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் துரோகங்களினுடைய தீவினைக்காக அவர்களைத் தள்ளிவிடும்;","poem":1},{"lineBreak":true},{"text":"உமக்கு விரோதமாகக் கலகம்செய்தார்களே.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"உம்மில் அடைக்கலம் நாடிவருவோர்கள் அனைவரும் மகிழ்ந்து,","poem":1},{"lineBreak":true},{"text":"எந்நாளும் கெம்பீரிப்பார்களாக;","poem":1},{"lineBreak":true},{"text":"நீர் அவர்களைக் காப்பாற்றுவீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பெயரை நேசிக்கிறவர்கள் உம்மில் சந்தோஷப்படுவார்களாக.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் நீதிமானை ஆசீர்வதித்து,","poem":1},{"lineBreak":true},{"text":"கருணை என்னும் கேடகத்தினால் அவனைச் சூழ்ந்து கொள்ளுவீர்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}