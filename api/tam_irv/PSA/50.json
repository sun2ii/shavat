{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"வல்லமையுள்ள தேவனாகிய யெகோவா பேசினது,","poem":1},{"lineBreak":true},{"text":"சூரியன் உதிக்கும்திசை தொடங்கி","poem":1},{"lineBreak":true},{"text":"அது மறையும் திசைவரைக்குமுள்ள பூமியைக் கூப்பிடுகிறார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அழகுள்ள சீயோனிலிருந்து தேவன் பிரகாசிக்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நம்முடைய தேவன் வருவார், மவுனமாக இருக்கமாட்டார்;","poem":1},{"lineBreak":true},{"text":"அவருக்கு முன்பு அக்கினி அழியும்;","poem":1},{"lineBreak":true},{"text":"அவரைச் சுற்றிலும் மகா புயல் கொந்தளிப்பாக இருக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய மக்களை நியாயந்தீர்க்க","poem":1},{"lineBreak":true},{"text":"உயர இருக்கும் வானங்களையும் பூமியையும் கூப்பிடுவார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பலியினாலே என்னோடு உடன்படிக்கை செய்த","poem":1},{"lineBreak":true},{"text":"என்னுடைய பரிசுத்தவான்களை என்னிடத்தில் கூட்டுங்கள் என்பார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"வானங்கள் அவருடைய நீதியை அறிவிக்கும்;","poem":1},{"lineBreak":true},{"text":"தேவனே நியாயாதிபதி. (சேலா)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என்னுடைய மக்களே, கேள், நான் பேசுவேன்; இஸ்ரவேலே,","poem":1},{"lineBreak":true},{"text":"உனக்கு விரோதமாகச் சாட்சி சொல்லுவேன்;","poem":1},{"lineBreak":true},{"text":"நானே தேவன், உன்னுடைய தேவனாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"உன்னுடைய பலிகளுக்காக உன்னைக் கடிந்துக்கொள்ளமாட்டேன்;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய தகனபலிகள் எப்போதும் எனக்கு முன்பாக இருக்கிறது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உன்னுடைய வீட்டிலிருந்து காளைகளையும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய தொழுவங்களிலிருந்து ஆட்டுக்கடாக்களையும் நான் வாங்கிக்கொள்வதில்லை.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எல்லா காட்டு உயிரினங்களும், மலைகளில் ஆயிரமாயிரமாகத் திரிகிற மிருகங்களும் என்னுடையவைகள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மலைகளிலுள்ள","poem":1},{"noteId":18},{"text":"பறவைகளையெல்லாம் அறிவேன்;","poem":1},{"lineBreak":true},{"text":"வெளியில் நடமாடுகிறவைகளெல்லாம் என்னுடையவைகள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நான் பசியாக இருந்தால் உனக்குச் சொல்லமாட்டேன்;","poem":1},{"lineBreak":true},{"text":"பூமியும் அதின் நிறைவும் என்னுடையவைகளே.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நான் எருதுகளின் இறைச்சியை சாப்பிட்டு,","poem":1},{"lineBreak":true},{"text":"ஆட்டுக்கடாக்களின் இரத்தம் குடிப்பேனோ?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நீ தேவனுக்கு நன்றிபலியிட்டு, உன்னதமான தேவனுக்கு உன்னுடைய பொருத்தனைகளைச் செலுத்தி;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆபத்துக்காலத்தில் என்னை நோக்கிக் கூப்பிடு;","poem":1},{"lineBreak":true},{"text":"நான் உன்னை விடுவிப்பேன், நீ என்னை மகிமைப்படுத்துவாய்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தேவன் துன்மார்க்கனை நோக்கி: நீ என்னுடைய பிரமாணங்களை எடுத்துச்சொல்லவும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உடன்படிக்கையை உன்னுடைய வாயினால் சொல்லவும், உனக்கு என்ன நியாயமுண்டு.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அறிவுறுத்துதலை நீ பகைத்து, என்னுடைய வார்த்தைகளை உனக்குப் பின்னாக எறிந்துபோடுகிறாய்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நீ திருடனைப் பார்க்கும்போது அவனோடு ஒருமித்துப்போகிறாய்;","poem":1},{"lineBreak":true},{"text":"விபசாரரோடும் உனக்குப் பங்குண்டு.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"உன்னுடைய வாயைப் பொல்லாப்புக்குத் திறக்கிறாய்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய நாவு வஞ்சகத்தை வெளிப்படுத்துகிறது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நீ உட்கார்ந்து உன்னுடைய சகோதரனுக்கு விரோதமாகப் பேசி,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய சொந்த சகோதரனுக்கு அவதூறு உண்டாக்குகிறாய்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"இவைகளை நீ செய்யும்போது நான் மவுனமாக இருந்தேன்,","poem":1},{"lineBreak":true},{"text":"உன்னைப்போல நானும் இருப்பேன் என்று நினைவு கொண்டாய்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் நான் உன்னைக் கடிந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"அவைகளை உன்னுடைய கண்களுக்கு முன்பாக ஒவ்வொன்றாக நிறுத்துவேன்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"தேவனை மறக்கிறவர்களே, இதைச் சிந்தித்துக்கொள்ளுங்கள்;","poem":1},{"lineBreak":true},{"text":"இல்லாவிட்டால் நான் உங்களைப் பீறிப்போடுவேன்,","poem":1},{"lineBreak":true},{"text":"ஒருவரும் உங்களை விடுவிப்பதில்லை.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"நன்றிபலி செலுத்துகிறவன் என்னை மகிமைப்படுத்துகிறான்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய வழியைச் சரிசெய்கிறவனுக்கு","poem":1},{"lineBreak":true},{"text":"தேவனுடைய இரட்சிப்பை வெளிப்படுத்துவேன் என்று சொல்லுகிறார்.","poem":1}]}],"footnotes":[{"noteId":18,"caller":"+","text":"ஆகாயத்தின்","reference":{"chapter":50,"verse":11}}]},"thisChapterLink":"/api/tam_irv/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}