{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீது அளித்த மஸ்கீல் என்னும் பாடல், “தாவீது அகிமெலேக்கின் வீட்டில் இருக்கிறான்” என்று ஏதோமியனாகிய தோவேக் சவுலிடம் போய் கூறியபோது பாடப்பட்ட பாடல்."]},{"type":"verse","number":1,"content":[{"text":"பலவானே, பொல்லாப்பில் ஏன் பெருமைபாராட்டுகிறாய்?","poem":1},{"lineBreak":true},{"text":"தேவனுடைய கிருபை எந்நாளும் உள்ளது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நீ கேடுகளைச் செய்ய திட்டமிடுகிறாய்,","poem":1},{"lineBreak":true},{"text":"கபடுசெய்யும் உன்னுடைய நாவு தீட்டப்பட்ட சவரகன் கத்தியைப்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நன்மையைவிட தீமையையும்,","poem":1},{"lineBreak":true},{"text":"யாதார்த்தம் பேசுகிறதைவிட பொய்யையும் விரும்புகிறாய். (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"கபடமுள்ள நாவே, அழிக்கும் எல்லா வார்த்தைகளையும் நீ விரும்புகிறாய்;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவன் உன்னை என்றென்றைக்கும் இல்லாதபடி அழித்துப்போடுவார்;","poem":1},{"lineBreak":true},{"text":"அவர் உன்னைப் பிடித்து, உன் குடியிருப்பிலிருந்து பிடுங்கி,","poem":1},{"lineBreak":true},{"text":"நீ உயிருள்ளோர் தேசத்தில் இல்லாதபடி உன்னை அழித்துப்போடுவார். (சேலா)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீதிமான்கள் அதைக்கண்டு பயந்து, அவனைப் பார்த்து சிரித்து:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இதோ, தேவனைத் தன்னுடைய பெலனாக கருதாமல்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய செல்வப்பெருக்கத்தை நம்பி,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய தீமையில் பலத்துக்கொண்ட மனிதன் இவன்தான் என்பார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நானோ தேவனுடைய ஆலயத்தில்","poem":1},{"lineBreak":true},{"text":"பச்சையான ஒலிவமரத்தைப் போலிருக்கிறேன்,","poem":1},{"lineBreak":true},{"text":"தேவனுடைய கிருபையை என்றென்றைக்கும் நம்பியிருக்கிறேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நீரே இதைச் செய்தீர் என்று உம்மை என்றென்றைக்கும் துதித்து,","poem":1},{"lineBreak":true},{"text":"உமது பெயருக்குக் காத்திருப்பேன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பரிசுத்தவான்களுக்கு முன்பாக அது நலமாக இருக்கிறது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}