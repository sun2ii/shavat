{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["தாவீது அளித்த பாடல்களில் ஒன்று."]},{"type":"verse","number":1,"content":[{"text":"தேவன் இல்லை என்று அறிவில்லாதவன் தன்னுடைய இருதயத்தில் சொல்லிக்கொள்ளுகிறான்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் தங்களைக் கெடுத்து,","poem":1},{"lineBreak":true},{"text":"அருவருப்பான அக்கிரமங்களைச் செய்து வருகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நன்மைசெய்கிறவன் ஒருவனும் இல்லை.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தேவனைத் தேடுகிற உணர்வுள்ளவன் உண்டோ என்று பார்க்க,","poem":1},{"lineBreak":true},{"text":"தேவன் பரலோகத்திலிருந்து மனிதர்களைக் கண்ணோக்கினார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர்கள் எல்லோரும் வழிவிலகி, ஒன்றாகக் கெட்டுப்போனார்கள்;","poem":1},{"lineBreak":true},{"text":"நன்மைசெய்கிறவன் இல்லை, ஒருவன்கூட இல்லை.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரர்களுக்கு அறிவு இல்லையா?","poem":1},{"lineBreak":true},{"text":"அப்பத்தை சாப்பிடுகிறதுபோல் என்னுடைய மக்களைச் சாப்பிடுகிறார்களே;","poem":1},{"lineBreak":true},{"text":"அவர்கள் தேவனைக் கூப்பிடுகிறதில்லை.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உனக்கு விரோதமாக முகாமிடுகிறவனுடைய எலும்புகளைத் தேவன் சிதறடித்ததால்,","poem":1},{"lineBreak":true},{"text":"பயமில்லாத இடத்தில் மிகவும் பயந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"தேவன் அவர்களை வெறுத்தபடியினால் நீ அவர்களை வெட்கப்படுத்தினாய்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"சீயோனிலிருந்து இஸ்ரவேலுக்கு இரட்சிப்பு வருவதாக;","poem":1},{"lineBreak":true},{"text":"தேவன் தம்முடைய மக்களின் சிறையிருப்பைத் திருப்பும்போது,","poem":1},{"lineBreak":true},{"text":"யாக்கோபுக்குச் சந்தோஷமும் இஸ்ரவேலுக்கு மகிழ்ச்சியும் உண்டாகும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}