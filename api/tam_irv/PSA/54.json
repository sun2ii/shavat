{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["தாவீது அளித்த பாடல்களில் ஒன்று."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, உமது பெயரினிமித்தம் என்னைப் பாதுகாத்து,","poem":1},{"lineBreak":true},{"text":"உமது வல்லமையினால் எனக்கு நியாயம் செய்யும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தேவனே, என்னுடைய விண்ணப்பத்தைக் கேட்டு, என்னுடைய வாயின் வார்த்தைகளைக் கேளும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அந்நியர் எனக்கு விரோதமாக எழும்புகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"கொடியவர்கள் என்னுடைய உயிரை வாங்கத் தேடுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"தேவனைத் தங்களுக்கு முன்பாக நிறுத்தி வைப்பதில்லை. (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இதோ, தேவன் எனக்கு உதவி செய்பவர்;","poem":1},{"lineBreak":true},{"text":"ஆண்டவர் என்னுடைய ஆத்துமாவை ஆதரிக்கிறவர்களோடு இருக்கிறார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர் என்னுடைய எதிரிகளுக்குத் தீமைக்குத் தீமையைச் சரிக்கட்டுவார்,","poem":1},{"lineBreak":true},{"text":"உமது சத்தியத்திற்காக அவர்களை அழியும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உற்சாகத்துடன் நான் உமக்குப் பலியிடுவேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உமது பெயரைத் துதிப்பேன், அது நலமானது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் எல்லா நெருக்கத்தையும் நீக்கி, என்னை விடுவித்தார்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கண் என்னுடைய எதிரிகளில் நீதி சரிக்கட்டுதலைக் கண்டது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}