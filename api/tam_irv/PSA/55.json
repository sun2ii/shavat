{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["தாவீது அளித்த பாடல்களில் ஒன்று."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, என்னுடைய ஜெபத்தைக் கேட்டருளும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பத்திற்கு மறைந்துகொள்ளாதிரும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எனக்குச் செவிகொடுத்து, பதில் அருளிச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"எதிரியினுடைய கூக்குரலினிமித்தமும்,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்கள் செய்யும் பிரச்சனைகளினிமித்தமும் என்னுடைய தியானத்தில் முறையிடுகிறேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர்கள் என்மேல் பழிசுமத்தி, கோபங்கொண்டு,","poem":1},{"lineBreak":true},{"text":"என்னைப் பகைக்கிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயம் எனக்குள் வேதனைப்படுகிறது;","poem":1},{"lineBreak":true},{"text":"மரணபயம் என்மேல் விழுந்தது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பயமும் நடுக்கமும் என்னைப் பிடித்தது; திகில் என்னை மூடியது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அப்பொழுது நான்: ஆ, எனக்குப் புறாவைப்போல் இறக்கைகள் இருந்தால்,","poem":1},{"lineBreak":true},{"text":"நான் பறந்துபோய் இளைப்பாறுவேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நான் தூரத்தில் அலைந்து திரிந்து வனாந்திரத்தில் தங்கியிருப்பேன். (சேலா)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பெருங்காற்றுக்கும் புயலுக்கும் தப்ப விரைந்து செல்வேன் என்றேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, அவர்களை அழித்து, அவர்கள் மொழியை பிரிந்துபோகச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"கொடுமையையும் சண்டையையும் நகரத்திலே கண்டேன்;","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவைகள் இரவும்பகலும் அதின் மதில்கள்மேல் சுற்றித்திரிகிறது;","poem":1},{"lineBreak":true},{"text":"அக்கிரமமும் வாதையும் அதின் நடுவில் இருக்கிறது;","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"கேடுபாடுகள் அதின் நடுவில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"கொடுமையும் கபடும் அதின் வீதியைவிட்டு விலகிப்போகிறதில்லை.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என்னைக் கடிந்துகொண்டவன் எதிரி அல்ல, அப்படியிருந்தால் சகிப்பேன்;","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாகப் பெருமை பாராட்டினவன் என்னுடைய பகைஞன் அல்ல,","poem":1},{"lineBreak":true},{"text":"அப்படியிருந்தால் அவனுக்கு மறைந்திருப்பேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"எனக்குச் சமமான மனிதனும், என்னுடைய வழிகாட்டியும், என்னுடைய தோழனுமாகிய நீயே அவன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நாம் ஒன்றாக, இன்பமான ஆலோசனைசெய்து,","poem":1},{"lineBreak":true},{"text":"கூட்டத்தோடு தேவாலயத்திற்குப் போனோம்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"மரணம் அவர்களைத் தொடர்ந்து பிடிப்பதாக;","poem":1},{"lineBreak":true},{"text":"அவர்கள் உயிரோடு பாதாளத்தில் இறங்குவார்களாக;","poem":1},{"lineBreak":true},{"text":"அவர்கள் தங்குமிடங்களிலும் அவர்கள் உள்ளத்திலும் தீங்கு இருக்கிறது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நானோ தேவனை நோக்கிக் கூப்பிடுவேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவா என்னை காப்பாற்றுவார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"காலை மாலை மத்தியான வேளைகளிலும் நான் தியானம்செய்து முறையிடுவேன்;","poem":1},{"lineBreak":true},{"text":"அவர் என்னுடைய சத்தத்தைக் கேட்பார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"திரள் கூட்டமாகக் கூடி என்னோடு எதிர்த்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அவரோ எனக்கு ஏற்பட்ட போரை நீக்கி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவைச் சமாதானத்துடன் மீட்டுவிட்டார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ஆரம்பம்முதலாக இருக்கிற தேவன் கேட்டு, அவர்களுக்குப் பதிலளிப்பார்;","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு மாறுதல்கள் ஏற்படாததினால், அவர்கள் தேவனுக்குப் பயப்படாமற்போகிறார்கள். (சேலா)","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அவன் தன்னோடு சமாதானமாக இருந்தவர்களுக்கு விரோதமாகத்","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கையை நீட்டி","poem":1},{"lineBreak":true},{"text":"தன்னுடைய உடன்படிக்கையை மீறி நடந்தான்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவன் வாயின் சொற்கள் வெண்ணெயைப்போல மெதுவானவைகள்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய இருதயமோ யுத்தம்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய வார்த்தைகள் எண்ணெயிலும் மிருதுவானவைகள்.","poem":1},{"lineBreak":true},{"text":"ஆனாலும் அவைகள் உருவின பட்டயங்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவாமேல் உன் பாரத்தை வைத்துவிடு, அவர் உன்னை ஆதரிப்பார்;","poem":1},{"lineBreak":true},{"text":"நீதிமானை ஒருபோதும் தள்ளாடவிடமாட்டார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"தேவனே, நீர் அவர்களை அழிவின் குழியில் இறங்கச்செய்வீர்;","poem":1},{"lineBreak":true},{"text":"இரத்தப்பிரியர்களும் சூதுள்ள மனிதர்களும் தங்களுடைய ஆயுளின் நாட்களில் பாதிவரைகூட பிழைத்திருக்கமாட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"நானோ உம்மை நம்பியிருக்கிறேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}