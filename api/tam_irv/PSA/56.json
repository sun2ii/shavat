{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["தாவீது அளித்த பாடல்களில் ஒன்று."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, எனக்கு இரங்கும்; மனிதன் என்னை விழுங்கப்பார்க்கிறான்,","poem":1},{"lineBreak":true},{"text":"நாள்தோறும் போர்செய்து, என்னை ஒடுக்குகிறான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் நாள்தோறும் என்னை விழுங்கப்பார்க்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"உன்னதமானவரே, எனக்கு விரோதமாக அகங்கரித்துப் போர்செய்கிறவர்கள் அநேகர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் பயப்படுகிற நாளில் உம்மை நம்புவேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தேவனை முன்னிட்டு அவருடைய வார்த்தையைப் புகழுவேன்; தேவனை நம்பியிருக்கிறேன்,","poem":1},{"lineBreak":true},{"text":"நான் பயப்பட மாட்டேன்; மாம்சமாக இருக்கிறவன் எனக்கு என்ன செய்வான்?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"எப்பொழுதும் என்னுடைய வார்த்தைகளைப் புரட்டுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"எனக்குத் தீங்குசெய்வதே அவர்கள் முழு எண்ணமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர்கள் ஒன்றாகக் கூடி, மறைந்திருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உயிரை வாங்க விரும்பி, என்னுடைய காலடிகளைப் பின்தொடர்ந்து வருகிறார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய அக்கிரமத்தினால் தப்புவார்களோ?","poem":1},{"lineBreak":true},{"text":"தேவனே, கோபங்கொண்டு மக்களைக் கீழே தள்ளும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய அலைச்சல்களை தேவனே நீர் எண்ணியிருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கண்ணீரை உம்முடைய தோல்பையில் வையும்;","poem":1},{"lineBreak":true},{"text":"அவைகள் உம்முடைய கணக்கில் அல்லவோ இருக்கிறது?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நான் உம்மை நோக்கிக் கூப்பிடும் நாளில் என்னுடைய எதிரிகள் பின்னாக திரும்புவார்கள்;","poem":1},{"lineBreak":true},{"text":"தேவன் என்னுடைய பக்கத்தில் இருக்கிறார் என்பதை அறிவேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தேவனை முன்னிட்டு அவருடைய வார்த்தையைப் புகழுவேன்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவை முன்னிட்டு அவருடைய வார்த்தையைப் புகழுவேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவனை நம்பியிருக்கிறேன், நான் பயப்படமாட்டேன்;","poem":1},{"lineBreak":true},{"text":"மனிதன் எனக்கு என்ன செய்வான்?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தேவனே, நான் உமக்குச்செய்த பொருத்தனைகள் என்மேல் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உமக்கு நன்றிகளைச் செலுத்துவேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நான் தேவனுக்கு முன்பாக உயிருள்ளவர்களுடைய வெளிச்சத்திலே நடக்கும்படி,","poem":1},{"lineBreak":true},{"text":"நீர் என்னுடைய ஆத்துமாவை மரணத்திற்கும் என்னுடைய கால்களை இடறலுக்கும் தப்புவியாமல் இருப்பீரோ?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}