{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["தாவீது அளித்த பாடல்களில் ஒன்று."]},{"type":"verse","number":1,"content":[{"text":"எனக்கு இரங்கும், தேவனே, எனக்கு இரங்கும்;","poem":1},{"lineBreak":true},{"text":"உம்மை என்னுடைய ஆத்துமா சார்ந்துகொள்கிறது;","poem":1},{"lineBreak":true},{"text":"பிரச்சனைகள் கடந்துபோகும்வரை உமது சிறகுகளின் நிழலிலே வந்து அடைவேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எனக்காக யாவையும் செய்து முடிக்கப்போகிற தேவனாகிய உன்னதமான தேவனை நோக்கிக் கூப்பிடுவேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னை விழுங்கப்பார்க்கிறவன் என்னை சபிக்கும்போது,","poem":1},{"lineBreak":true},{"text":"அவர் பரலோகத்திலிருந்து ஒத்தாசை அனுப்பி, என்னைக் காப்பாற்றுவார்: (சேலா).","poem":1},{"lineBreak":true},{"text":"தேவன் தமது கிருபையையும் தமது சத்தியத்தையும் அனுப்புவார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா சிங்கங்களின் நடுவில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"தீயை இறைக்கிற மனிதர்களுக்குள்ளே கிடக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் பற்கள் ஈட்டிகளும் அம்புகளும், அவர்கள் நாவு கூர்மையான வாளாக இருக்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவனே, வானங்களுக்கு மேலாக உயர்ந்தருளும்;","poem":1},{"lineBreak":true},{"text":"உமது மகிமை பூமியனைத்தின்மேலும் உயர்ந்திருப்பதாக.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என்னுடைய கால்களுக்குக் கண்ணியை வைத்திருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா தவிக்கிறது; எனக்கு முன்பாகக் குழியை வெட்டி, அதின் நடுவிலே விழுந்தார்கள் (சேலா)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயம் ஆயத்தமாக இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"தேவனே, என்னுடைய இருதயம் ஆயத்தமாக இருக்கிறது; நான் பாடிப் புகழுவேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய மனமே, விழி; வீணையே, சுரமண்டலமே, விழியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அதிகாலையில் விழித்துக்கொள்வேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, மக்களுக்குள்ளே உம்மைத் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"தேசங்களுக்குள்ளே உம்மைப் புகழ்ந்து பாடுவேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உமது கிருபை வானம்வரையும்,","poem":1},{"lineBreak":true},{"text":"உமது சத்தியம் மேகமண்டலங்கள்வரையும் எட்டுகிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவனே, வானங்களுக்கு மேலாக உயர்ந்தருளும்;","poem":1},{"lineBreak":true},{"text":"உமது மகிமை பூமியனைத்தின்மேலும் உயர்ந்திருப்பதாக.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}