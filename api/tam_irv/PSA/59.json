{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["இசைத்தலைவனுக்கு தாவீது அளித்த மிக்தாம் என்னும் ஒரு பாடல். தாவீதைக் கொல்வதற்காக சவுல் தாவீதின் வீட்டைக் கண்காணிப்பதற்காக ஆட்களை அனுப்பியபோது பாடியது."]},{"type":"verse","number":1,"content":[{"text":"என் தேவனே, என்னுடைய எதிரிகளுக்கு என்னைத் தப்புவியும்;","poem":1},{"lineBreak":true},{"text":"என்மேல் எழும்புகிறவர்களுக்கு என்னை விலக்கி உயர்ந்த அடைக்கலத்திலே வையும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரர்களுக்கு என்னைத் தப்புவித்து,","poem":1},{"lineBreak":true},{"text":"இரத்தப்பிரியர்களான மனிதர்களுக்கு என்னை விலக்கிக் காப்பாற்றும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"இதோ, என்னுடைய உயிருக்காக மறைந்திருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, என்னிடத்தில் மீறுதலும் பாவமும் இல்லாமலிருந்தும்,","poem":1},{"lineBreak":true},{"text":"பலவான்கள் எனக்கு விரோதமாகக் கூட்டங்கூடுகிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னிடத்தில் அக்கிரமம் இல்லாமலிருந்தும்,","poem":1},{"lineBreak":true},{"text":"ஓடித்திரிந்து போருக்கு ஆயத்தமாகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"எனக்குத் துணைசெய்ய விழித்து என்னை நோக்கிப்பாரும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"சேனைகளின் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் தேவனே, நீர் எல்லா தேசங்களையும் தண்டிக்க விழித்தெழும்பும்;","poem":1},{"lineBreak":true},{"text":"வஞ்சகமாகத் துரோகஞ்செய்கிற ஒருவருக்கும் தயை செய்யாமலிரும். (சேலா)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர்கள் மாலையில் திரும்பிவந்து, நாய்களைப்போல ஊளையிட்டு, ஊரைச்சுற்றித் திரிகிறார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இதோ, தங்களுடைய வார்த்தைகளைக் கக்குகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் உதடுகளில் வாள்கள் இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"கேட்கிறவன் யார் என்கிறார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆனாலும் யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நீர் அவர்களைப் பார்த்து சிரிப்பீர்;","poem":1},{"lineBreak":true},{"text":"அந்நியமக்கள் அனைவரையும் இகழுவீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவன் வல்லமையை நான் கண்டு, உமக்குக் காத்திருப்பேன்;","poem":1},{"lineBreak":true},{"text":"தேவனே எனக்கு உயர்ந்த அடைக்கலம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என் தேவன் தம்முடைய கிருபையினால் என்னைச் சந்திப்பார்;","poem":1},{"lineBreak":true},{"text":"தேவன் என்னுடைய எதிரிகளுக்கு வரும் நீதிசரிக்கட்டுதலை நான் காணும்படி செய்வார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர்களைக் கொன்றுபோடாமலிரும், என்னுடைய மக்கள் மறந்துபோவார்களே;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய கேடகமாகிய ஆண்டவரே, உமது வல்லமையினால் அவர்களைச் சிதறடித்து,","poem":1},{"lineBreak":true},{"text":"அவர்களைத் தாழ்த்திப்போடும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவர்களுடைய உதடுகளின் பேச்சு அவர்கள் வாயின் பாவமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவர்கள் இட்ட சாபமும் சொல்லிய பொய்யும் ஆகிய இவைகளினால்","poem":1},{"lineBreak":true},{"text":"தங்களுடைய பெருமையில் அகப்படுவார்களாக.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவன் பூமியின் எல்லைவரைக்கும் யாக்கோபிலே அரசாளுகிறவர் என்று அவர்கள் அறியும்படி,","poem":1},{"lineBreak":true},{"text":"அவர்களை உம்முடைய கடுங்கோபத்திலே அழித்துப்போடும்;","poem":1},{"lineBreak":true},{"text":"இனி இல்லாதபடிக்கு அவர்களை அழித்துப்போடும். (சேலா)","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர்கள் மாலையில் திரும்பிவந்து, நாய்களைப்போல ஊளையிட்டு,","poem":1},{"lineBreak":true},{"text":"ஊரைச்சுற்றித் திரிகிறார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவர்கள் உணவுக்காக அலைந்து திரிந்து திருப்தியடையாமல்,","poem":1},{"lineBreak":true},{"text":"முறுமுறுத்துக்கொண்டிருப்பார்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நானோ உம்முடைய வல்லமையைப் பாடி,","poem":1},{"lineBreak":true},{"text":"காலையிலே உம்முடைய கிருபையை மகிழ்ச்சியோடு புகழுவேன்;","poem":1},{"lineBreak":true},{"text":"எனக்கு நெருக்கமுண்டான நாளிலே","poem":1},{"lineBreak":true},{"text":"நீர் எனக்குத் தஞ்சமும் உயர்ந்த அடைக்கலமுமானீர்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என்னுடைய பெலனே, உம்மை பாடிப் புகழுவேன்;","poem":1},{"lineBreak":true},{"text":"தேவன் எனக்கு உயர்ந்த அடைக்கலமும்,","poem":1},{"lineBreak":true},{"text":"கிருபையுள்ள என் தேவனுமாக இருக்கிறார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}