{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["செமினீத்தால் நரம்புக் கருவிகளை இசைப்பவர்களின் இராகத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உம்முடைய கோபத்திலே என்னைக் கடிந்துகொள்ளாமல் இரும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய கடுங்கோபத்திலே என்னைத் தண்டியாமல் இரும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்மேல் இரக்கமாக இரும் யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நான் பெலனில்லாமல் போனேன்;","poem":1},{"lineBreak":true},{"text":"என்னைக் குணமாக்கும் யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எலும்புகள் நடுங்குகின்றன.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா மிகவும் வியாகுலப்படுகிறது; யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"எதுவரைக்கும் இரங்காமலிருப்பீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"திரும்பும் யெகோவாவே, என்னுடைய ஆத்துமாவை விடுவியும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கிருபையினால் என்னை இரட்சியும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மரணத்தில் உம்மை யாரும் நினைவுகூர்வதில்லை,","poem":1},{"lineBreak":true},{"text":"பாதாளத்தில் உம்மைத் துதிப்பவன் யார்?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என்னுடைய பெருமூச்சினால் இளைத்துப்போனேன்;","poem":1},{"lineBreak":true},{"text":"இரவுமுழுவதும் என்னுடைய கண்ணீரால் என்னுடைய படுக்கையை மிகவும் ஈரமாக்கி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கட்டிலை நனைக்கிறேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"துயரத்தினால் என்னுடைய கண் குழி விழுந்துபோனது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் அனைவர் நிமித்தமும் மங்கிப்போனது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அக்கிரமக்காரர்களே, நீங்கள் எல்லோரும் என்னைவிட்டு அகன்றுபோங்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவா என்னுடைய அழுகையின் சத்தத்தைக் கேட்டார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவா என்னுடைய விண்ணப்பத்தைக் கேட்டார்;","poem":1},{"lineBreak":true},{"text":"யெகோவா என்னுடைய ஜெபத்தை ஏற்றுக்கொள்ளுவார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் எல்லோரும் வெட்கி மிகவும் கலங்கிப்போவார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் பின்னாகத் திரும்பி உடனே வெட்கப்படுவார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}