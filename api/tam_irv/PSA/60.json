{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":60,"content":[{"type":"hebrew_subtitle","content":["தாவீது மெசொபத்தாமியா தேசத்து சீரியர்களோடும், சோபா தேசத்து சீரியர்களோடும் யுத்தம் செய்தபோது யோவாப் திரும்பி உப்புப்பள்ளத்தாக்கிலே ஏதோமியரில் பன்னிரெண்டாயிரம் பேரை வெட்டினபோது அவன் சாட்சியை விளக்கும் ஆறு நரம்பு கின்னரத்திலே போதிப்பதற்காக பாடினதும் இராகத்தலைவனுக்கு ஒப்புவித்ததுமான மிக்தாம் என்னும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, நீர் எங்களைக் கைவிட்டீர், எங்களைச் சிதறடித்தீர்,","poem":1},{"lineBreak":true},{"text":"எங்கள்மேல் கோபமாக இருந்தீர்; மறுபடியும் எங்களிடமாகத் திரும்பியருளும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"பூமியை அதிரச்செய்து, அதை வெடிப்பாக்கினீர்;","poem":1},{"lineBreak":true},{"text":"அதின் வெடிப்புகளைப் பொருந்தச்செய்யும்; அது அசைகிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உம்முடைய மக்களுக்குக் கடினமான காரியத்தைக் காண்பித்தீர்;","poem":1},{"lineBreak":true},{"text":"தத்தளிப்பின் மதுபானத்தை எங்களுக்குக் குடிக்கக் கொடுத்தீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"சத்தியத்தினால் ஏற்றும்படியாக, உமக்குப் பயந்து நடக்கிறவர்களுக்கு","poem":1},{"lineBreak":true},{"text":"ஒரு கொடியைக் கொடுத்தீர். (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உமது பிரியர்கள் விடுவிக்கப்படும்படி,","poem":1},{"lineBreak":true},{"text":"உமது வலதுகரத்தினால் காப்பாற்றி, எனக்குச் செவிகொடுத்தருளும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தேவன் தமது பரிசுத்தத்தைக் கொண்டு சொன்னார்,","poem":1},{"lineBreak":true},{"text":"ஆகையால் சந்தோஷப்படுவேன்; சீகேமைப் பங்கிட்டு,","poem":1},{"lineBreak":true},{"text":"சுக்கோத்தின் பள்ளத்தாக்கை அளந்துகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"கீலேயாத் என்னுடையது, மனாசேயும் என்னுடையது,","poem":1},{"lineBreak":true},{"text":"எப்பிராயீம் என்னுடைய தலையின் பெலன், யூதா என்னுடைய செங்கோல்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மோவாப் என் பாதங்களைக் கழுவும் பாத்திரம்,","poem":1},{"lineBreak":true},{"text":"ஏதோமின்மேல் என்னுடைய காலணியை எறிந்துபோடுவேன்;","poem":1},{"lineBreak":true},{"text":"பெலிஸ்தியாவே, என்னிமித்தம் ஆர்ப்பரித்துக்கொள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"பாதுகாப்பான பட்டணத்திற்குள் என்னை நடத்திக்கொண்டுபோகிறவர் யார்?","poem":1},{"lineBreak":true},{"text":"ஏதோம்வரை எனக்கு வழி காட்டுகிறவர் யார்?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எங்கள் படைகளோடு புறப்படாமலிருந்த தேவனே நீர் அல்லவோ?","poem":1},{"lineBreak":true},{"text":"எங்களைத் தள்ளிவிட்டிருந்த தேவனே நீர் அல்லவோ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ஆபத்தில் எங்களுக்கு உதவிசெய்யும்;","poem":1},{"lineBreak":true},{"text":"மனிதனுடைய உதவி வீண்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தேவனாலே பலத்தோடு போராடுவோம்;","poem":1},{"lineBreak":true},{"text":"அவரே எங்களுடைய எதிரிகளை மிதித்துப்போடுவார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}