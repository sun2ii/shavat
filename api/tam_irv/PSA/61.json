{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["நரம்புக் கருவிகளை இசைக்கும் இசைத் தலைவனுக்கு தாவீது அளித்த பாடல்களில் ஒன்று."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, நான் கூப்பிடுகிறதைக் கேட்டு,","poem":1},{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பத்தைக் கவனியும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயம் தளர்ந்துபோகும்போது","poem":1},{"lineBreak":true},{"text":"பூமியின் கடைசியிலிருந்து உம்மை நோக்கிக் கூப்பிடுவேன்;","poem":1},{"lineBreak":true},{"text":"எனக்கு எட்டாத உயரமான கன்மலையில் என்னைக் கொண்டுபோய்விடும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீர் எனக்கு அடைக்கலமும்,","poem":1},{"lineBreak":true},{"text":"எதிரிகளுக்கு எதிரே பெலத்த துருகமுமாக இருந்தீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நான் உம்முடைய கூடாரத்தில் என்றென்றும் தங்குவேன்;","poem":1},{"lineBreak":true},{"text":"உமது இறக்கைகளின் மறைவிலே வந்து அடைவேன். (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவனே, நீர் என்னுடைய பொருத்தனைகளைக் கேட்டீர்;","poem":1},{"lineBreak":true},{"text":"உமது பெயருக்குப் பயப்படுகிறவர்களின் சுதந்தரத்தை எனக்குத் தந்தீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ராஜாவின் ஆயுசு நாட்களோடு நாட்களைக் கூட்டுவீர்;","poem":1},{"lineBreak":true},{"text":"அவர் வருடங்கள் தலைமுறை தலைமுறையாக இருக்கும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் தேவனுக்கு முன்பாக என்றென்றைக்கும் நிலைத்திருப்பார்;","poem":1},{"lineBreak":true},{"text":"தயையும் உண்மையும் அவரைக் காக்கக் கட்டளையிடும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"இப்படியே தினமும் என்னுடைய பொருத்தனைகளை நான் செலுத்தும்படியாக,","poem":1},{"lineBreak":true},{"text":"உமது பெயரை என்றைக்கும் புகழ்ந்து பாடுவேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}