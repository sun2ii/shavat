{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["எதுதூன் என்னும் இராகத் தலைவனுக்கு தாவீது அளித்த பாடல்களில் ஒன்று."]},{"type":"verse","number":1,"content":[{"text":"தேவனையே நோக்கி என்னுடைய ஆத்துமா அமர்ந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவரால் என் இரட்சிப்பு வரும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவரே என் கன்மலையும், என் இரட்சிப்பும்,","poem":1},{"lineBreak":true},{"text":"என் உயர்ந்த அடைக்கலமுமானவர்;","poem":1},{"lineBreak":true},{"text":"நான் அதிகமாக அசைக்கப்படுவதில்லை.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீங்கள் எதுவரைக்கும் ஒரு மனிதனுக்குத் தீங்குசெய்ய நினைப்பீர்கள்,","poem":1},{"lineBreak":true},{"text":"நீங்கள் அனைவரும் அழிக்கப்படுவீர்கள்,","poem":1},{"lineBreak":true},{"text":"சாய்ந்த மதிலுக்கும் இடிந்த சுவருக்கும் ஒப்பாவீர்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவனுடைய மேன்மையிலிருந்து அவனைத் தள்ளும்படிக்கே","poem":1},{"lineBreak":true},{"text":"அவர்கள் ஆலோசனைசெய்து,","poem":1},{"lineBreak":true},{"text":"பொய்பேச விரும்புகிறார்கள்; தங்களுடைய வாயினால் ஆசீர்வதித்து,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய உள்ளத்தில் சபிக்கிறார்கள்.","poem":1},{"lineBreak":true},{"text":"(சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவே, தேவனையே நோக்கி அமர்ந்திரு;","poem":1},{"lineBreak":true},{"text":"நான் நம்புகிறது அவராலே வரும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவரே என்னுடைய கன்மலையும், என்னுடைய இரட்சிப்பும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உயர்ந்த அடைக்கலமுமானவர்;","poem":1},{"lineBreak":true},{"text":"நான் அசைக்கப்படுவதில்லை.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என்னுடைய இரட்சிப்பும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய மகிமையும் தேவனிடத்தில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"பெலனான என்னுடைய கன்மலையும் என்னுடைய அடைக்கலமும் தேவனுக்குள் இருக்கிறது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மக்களே, எக்காலத்திலும் அவரை நம்புங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் சமுகத்தில் உங்களுடைய இருதயத்தை ஊற்றிவிடுங்கள்;","poem":1},{"lineBreak":true},{"text":"தேவன் நமக்கு அடைக்கலமாக இருக்கிறார். (சேலா)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"கீழ்மக்கள் மாயையும், மேன்மக்கள் பொய்யுமாமே;","poem":1},{"lineBreak":true},{"text":"தராசிலே வைக்கப்பட்டால் அவர்களெல்லோரும்","poem":1},{"lineBreak":true},{"text":"மாயையிலும் லேசானவர்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"கொடுமையை நம்பாதிருங்கள்; கொள்ளையினால் பெருமைபாராட்டாதிருங்கள்;","poem":1},{"lineBreak":true},{"text":"செல்வம் அதிகமானால் இருதயத்தை அதின்மேல் வைக்காமலிருங்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவன் ஒருமுறை பேசினார், இரண்டுமுறை கேட்டிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"வல்லமை தேவனுடையது என்பதே.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"கிருபையும் உம்முடையது, ஆண்டவரே!","poem":1},{"lineBreak":true},{"text":"தேவனே நீர் அவனவன் செய்கைக்குத் தகுந்தபடி பலனளிக்கிறீர்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}