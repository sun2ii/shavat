{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["யூதாவின் பாலைவனத்தில் இருந்தபோது தாவீது பாடிய பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, நீர் என் தேவன்; அதிகாலமே உம்மைத் தேடுகிறேன்;","poem":1},{"lineBreak":true},{"text":"வறண்டதும் சோர்வுற்றதும் தண்ணீரற்றதுமான நிலத்திலே என்னுடைய ஆத்துமா உம்மேல் தாகமாக இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உடலானது உம்மை வாஞ்சிக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"இப்படியே பரிசுத்த இடத்தில் உம்மைப்பார்க்க ஆசையாக இருந்து,","poem":1},{"lineBreak":true},{"text":"உமது வல்லமையையும் உமது மகிமையையும் கண்டேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உயிரைவிட உமது கிருபை நல்லது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உதடுகள் உம்மைத் துதிக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னுடைய உயிர் உள்ளவரை நான் உம்மைத் துதித்து,","poem":1},{"lineBreak":true},{"text":"உமது பெயரை சொல்லிக் கையை உயர்த்துவேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நிணத்தையும் கொழுப்பையும் உண்டதுபோல என்னுடைய ஆத்துமா திருப்தியாகும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாய் ஆனந்த சந்தோஷமுள்ள உதடுகளால் உம்மைப் போற்றும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என்னுடைய படுக்கையின்மேல் நான் உம்மை நினைக்கும்போது,","poem":1},{"lineBreak":true},{"text":"இரவுநேரங்களில் உம்மைத் தியானிக்கிறேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீர் எனக்குத் துணையாக இருந்ததினால்,","poem":1},{"lineBreak":true},{"text":"உமது இறக்கைகளின் நிழலிலே சந்தோஷப்படுகிறேன்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா உம்மைத் தொடர்ந்து பற்றிக்கொண்டிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உமது வலதுகரம் என்னைத் தாங்குகிறது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என் உயிரை அழிக்கத் தேடுகிறவர்களோ,","poem":1},{"lineBreak":true},{"text":"பூமியின் தாழ்விடங்களில் இறங்குவார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்கள் வாளால் விழுவார்கள்;","poem":1},{"lineBreak":true},{"text":"நரிகளுக்கு இரையாவார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ராஜாவோ தேவனில் சந்தோஷப்படுவார்;","poem":1},{"lineBreak":true},{"text":"தேவன் பேரில் சத்தியம்செய்கிறவர்கள்","poem":1},{"lineBreak":true},{"text":"அனைவரும் மேன்மைபாராட்டுவார்கள்;","poem":1},{"lineBreak":true},{"text":"பொய் பேசுகிறவர்களின் வாய் அடைக்கப்படும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}