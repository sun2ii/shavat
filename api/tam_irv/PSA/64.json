{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, என்னுடைய விண்ணப்பத்தில் என்னுடைய சத்தத்தைக் கேட்டருளும்;","poem":1},{"lineBreak":true},{"text":"எதிரியால் வரும் பயத்தை நீக்கி, என்னுடைய உயிரை காத்தருளும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர் செய்யும் இரகசிய ஆலோசனைக்கும்,","poem":1},{"lineBreak":true},{"text":"அக்கிரமக்காரர்களுடைய கலகத்திற்கும் என்னை விலக்கி மறைத்தருளும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய நாவை வாளைப்போல் கூர்மையாக்கி,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மறைவுகளில் உத்தமன்மேல் எய்வதற்காக கசப்பான வார்த்தைகளாகிய தங்களுடைய அம்புகளை நாணேற்றுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"சற்றும் பயமின்றி திடீரென்று அவன்மேல் எய்கிறார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர்கள் பொல்லாத காரியத்தில் தங்களை உறுதிப்படுத்திக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"மறைவான கண்ணிகளை வைக்க ஆலோசனைசெய்து,","poem":1},{"lineBreak":true},{"text":"அவைகளைக் காண்பவன் யார் என்கிறார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவர்களுடைய நியாயக்கேடுகளை ஆராய்ந்துதேடி,","poem":1},{"lineBreak":true},{"text":"தந்திரமான யோசனை நிறைவேறும்படி முயற்சி செய்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களில் ஒவ்வொருவனுடைய உட்கருத்தும் இருதயமும் ஆழமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஆனாலும் தேவன் அவர்கள்மேல் அம்புகளை எய்வார்,","poem":1},{"lineBreak":true},{"text":"திடீரென்று அவர்கள் காயப்படுவார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர்கள் தள்ளப்பட்டு, கீழே விழும்படி","poem":1},{"lineBreak":true},{"text":"அவர்கள் நாவுகளே அவர்களைக் கெடுக்கும்;","poem":1},{"lineBreak":true},{"text":"அவர்களைக் காண்கிற அனைவரும் ஓடிப்போவார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எல்லா மனிதரும் பயந்து, தேவனுடைய செயலை அறிவித்து,","poem":1},{"lineBreak":true},{"text":"அவர் செய்கையை உணர்ந்துகொள்வார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நீதிமான் யெகோவாவுக்குள் மகிழ்ந்து, அவரை நம்புவான்;","poem":1},{"lineBreak":true},{"text":"செம்மையான இருதயமுள்ளவர்கள் அனைவரும் மேன்மைபாராட்டுவார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}