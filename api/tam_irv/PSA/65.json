{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீது அளித்த துதிப் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, சீயோனில் உமக்காகத் துதியானது அமைந்து காத்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"பொருத்தனை உமக்குச் செலுத்தப்படும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஜெபத்தைக் கேட்கிறவரே, மனிதர்கள் அனைவரும் உம்மிடத்தில் வருவார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அக்கிரம விஷயங்கள் என்மேல் மிஞ்சி வல்லமைகொண்டது;","poem":1},{"lineBreak":true},{"text":"தேவனே நீரோ எங்களுடைய மீறுதல்களை மன்னிக்கிறீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உம்முடைய ஆலயமுற்றங்களில் குடியிருக்கும்படி நீர் தெரிந்துகொண்டு சேர்த்துக்கொள்ளுகிறவன் பாக்கியவான்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பரிசுத்த ஆலயமாகிய உமது வீட்டின் நன்மையால் திருப்தியாவோம்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"பூமியின் கடைசி எல்லைகளிலும்","poem":1},{"lineBreak":true},{"text":"தூரமான கடல்களிலும் உள்ளவர்கள் எல்லோரும் நம்பும் நம்பிக்கையாக இருக்கிற","poem":1},{"lineBreak":true},{"text":"எங்களுடைய இரட்சிப்பின் தேவனே,","poem":1},{"lineBreak":true},{"text":"நீர் பயங்கரமான காரியங்களைச் செய்கிறதினால் எங்களுக்கு நீதியுள்ள உத்திரவு அருளுகிறீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"வல்லமையைக் கட்டிக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பலத்தினால் மலைகளை உறுதிப்படுத்தி,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"கடல்களின் மும்முரத்தையும் அவைகளுடைய அலைகளின் இரைச்சலையும்,","poem":1},{"lineBreak":true},{"text":"மக்களின் குழப்பத்தையும் அமர்த்துகிறீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பூமியின் கடைசி இடங்களில் குடியிருக்கிறவர்களும் உம்முடைய அடையாளங்களுக்காக பயப்படுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"காலையையும், மாலையையும் சந்தோஷப்படச்செய்கிறீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தேவனே நீர் பூமியை விசாரித்து அதற்கு நீர்ப்பாய்ச்சுகிறீர்;","poem":1},{"lineBreak":true},{"text":"தண்ணீர் நிறைந்த தேவநதியினால் அதை மிகவும் செழிப்பாக்குகிறீர்;","poem":1},{"lineBreak":true},{"text":"இப்படி நீர் அதைத் திருத்தி,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்குத் தானியத்தை விளைவிக்கிறீர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அதின் வரப்புகள் தணியும்படி அதின் வயல்களுக்குத் தண்ணீர் இறைத்து,","poem":1},{"lineBreak":true},{"text":"அதை மழைகளால் கரையச்செய்து, அதின் பயிரை ஆசீர்வதிக்கிறீர்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"வருடத்தை உம்முடைய நன்மையால் முடிசூட்டுகிறீர்;","poem":1},{"lineBreak":true},{"text":"உமது பாதைகள் நெய்யாகப் பொழிகிறது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"வனாந்திர பசும்புல்களிலும் பொழிகிறது;","poem":1},{"lineBreak":true},{"text":"மேடுகள் சுற்றிலும் பூரிப்பாக இருக்கிறது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"மேய்ச்சலுள்ள வெளிகளில் ஆடுகள் நிறைந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"பள்ளத்தாக்குகள் தானியத்தால் மூடியிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவைகள் கெம்பீரித்துப் பாடுகிறது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}