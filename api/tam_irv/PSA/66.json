{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீது அளித்த ஒரு துதிப் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"பூமியின் குடிகளே, நீங்கள் எல்லோரும் தேவனுக்கு முன்பாகக்","poem":1},{"lineBreak":true},{"text":"கெம்பீரமாகப் பாடுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர் பெயரின் மகத்துவத்தைக் புகழ்ந்துபாடி,","poem":1},{"lineBreak":true},{"text":"அவருடைய துதியின் மகிமையைக் கொண்டாடுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேவனை நோக்கி: உமது செயல்களில் எவ்வளவு பயங்கரமாக இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"உமது மகத்துவமான வல்லமைக்காக உம்முடைய எதிரிகள்","poem":1},{"lineBreak":true},{"text":"உமக்கு வஞ்சகம் பேசி அடங்குவார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"பூமியின் மீதெங்கும் உம்மைப் பணிந்துகொண்டு உம்மைத் துதித்துப் பாடுவார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் உம்முடைய பெயரைத் துதித்துப் பாடுவார்கள் என்று சொல்லுங்கள். (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவனுடைய செய்கைகளை வந்து பாருங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் மனிதர்களிடத்தில் நடப்பிக்கும் செயல்களில் பயங்கரமானவர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"கடலை உலர்ந்த தரையாக மாற்றினார்;","poem":1},{"lineBreak":true},{"text":"ஆற்றைக் கால்நடையாகக் கடந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அங்கே அவரில் சந்தோஷமடைந்தோம்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய வல்லமையினால் என்றென்றைக்கும் அரசாளுகிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய கண்கள் தேசத்தின்மேல் நோக்கமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"துரோகிகள் தங்களை உயர்த்தாமல் இருப்பார்களாக. (சேலா)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மக்களே, நம்முடைய தேவனைத் துதித்து, அவரைத் துதிக்கும் சத்தத்தைக் கேட்கச்செய்யுங்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் நம்முடைய கால்களைத் தள்ளாடவிடாமல்,","poem":1},{"lineBreak":true},{"text":"நம்முடைய ஆத்துமாவை உயிரோடு வைக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தேவனே, எங்களைச் சோதித்தீர்;","poem":1},{"lineBreak":true},{"text":"வெள்ளியைப் புடமிடுகிறதுபோல எங்களைப் புடமிட்டீர்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"எங்களை வலையில் அகப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய இடுப்புகளின்மேல் வருத்தமான பாரத்தை ஏற்றினீர்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"மனிதர்களை எங்களுடைய தலையின்மேல் ஏறிப்போகச்செய்தீர்;","poem":1},{"lineBreak":true},{"text":"தீயையும் தண்ணீரையும் கடந்து வந்தோம்;","poem":1},{"lineBreak":true},{"text":"செழிப்பான இடத்தில் எங்களைக் கொண்டுவந்து விட்டீர்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"சர்வாங்க தகனபலிகளோடு உமது ஆலயத்திற்குள் நுழைவேன்;","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"என்னுடைய இக்கட்டில் நான் என்னுடைய உதடுகளைத் திறந்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வாயினால் சொல்லிய என்னுடைய பொருத்தனைகளை","poem":1},{"lineBreak":true},{"text":"உமக்குச் செலுத்துவேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆட்டுக்கடாக்களின் சுகந்தவாசனையுடனே கொழுமையானவைகளை உமக்குத் தகனபலியாக செலுத்துவேன்;","poem":1},{"lineBreak":true},{"text":"காளைகளையும் செம்மறியாட்டுக் கடாக்களையும் உமக்குப் பலியிடுவேன். (சேலா)","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தேவனுக்குப் பயந்தவர்களே, நீங்கள் எல்லோரும் வந்து கேளுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் என்னுடைய ஆத்துமாவுக்குச் செய்ததைச் சொல்லுவேன்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவரை நோக்கி என்னுடைய வாயினால் கூப்பிட்டேன்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய நாவினால் அவர் புகழப்பட்டார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என்னுடைய இருதயத்தில் அக்கிரமசிந்தை கொண்டிருந்தேனானால்,","poem":1},{"lineBreak":true},{"text":"ஆண்டவர் எனக்குச் செவிகொடுக்கமாட்டார்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"மெய்யாக தேவன் எனக்குச் செவிகொடுத்தார்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஜெபத்தின் சத்தத்தைக் கேட்டார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என்னுடைய ஜெபத்தைத் தள்ளாமலும்,","poem":1},{"lineBreak":true},{"text":"தமது கிருபையை என்னைவிட்டு விலக்காமலும்","poem":1},{"lineBreak":true},{"text":"இருந்த தேவனுக்கு நன்றி உண்டாகட்டும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}