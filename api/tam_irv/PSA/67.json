{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["இசைக்கருவிகளை இசைக்கும் இராகத் தலைவனுக்கு ஒரு துதிப் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, பூமியில் உம்முடைய வழியும்,","poem":1},{"lineBreak":true},{"text":"எல்லா தேசங்களுக்குள்ளும் உம்முடைய இரட்சிப்பும் விளங்கும்படியாக,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தேவனே நீர் எங்களுக்கு இரங்கி, எங்களை ஆசீர்வதித்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய முகத்தை எங்கள்மேல் பிரகாசிக்கச்செய்யும். (சேலா)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேவனே, மக்கள் உம்மைத் துதிப்பார்களாக;","poem":1},{"lineBreak":true},{"text":"எல்லா மக்களும் உம்மைத் துதிப்பார்களாக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தேவனே நீர் மக்களை நிதானமாக நியாயந்தீர்த்து, பூமியிலுள்ள மக்களை நடத்துவீர்;","poem":1},{"lineBreak":true},{"text":"ஆதலால் தேசங்கள் சந்தோஷித்து,","poem":1},{"lineBreak":true},{"text":"கெம்பீரத்தோடு மகிழக்கடவர்கள். (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவனே, மக்கள் உம்மைத் துதிப்பார்களாக;","poem":1},{"lineBreak":true},{"text":"எல்லா மக்களும் உம்மைத் துதிப்பார்களாக.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பூமி தன்னுடைய பலனைத் தரும், தேவனாகிய எங்களுடைய தேவனே எங்களை ஆசீர்வதிப்பார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவன் எங்களை ஆசீர்வதிப்பார்;","poem":1},{"lineBreak":true},{"text":"பூமியின் எல்லைகளெல்லாம் அவருக்குப் பயந்திருக்கும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}