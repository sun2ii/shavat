{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["இராகத் தலைவனுக்கு தாவீது அளித்த துதிப்பாடல்களுள் ஒன்று."]},{"type":"verse","number":1,"content":[{"text":"தேவன் எழுந்தருளுவார், அவருடைய எதிரிகள் சிதறி,","poem":1},{"lineBreak":true},{"text":"அவரைப் பகைக்கிறவர்கள் அவருக்கு முன்பாக ஓடிப்போவார்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"புகை பறக்கடிக்கப்படுவதுபோல அவர்களைப் பறக்கடிப்பீர்;","poem":1},{"lineBreak":true},{"text":"மெழுகு நெருப்புக்கு முன்பு உருகுவதுபோல துன்மார்க்கர்கள் தேவனுக்குமுன்பாக அழிவார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீதிமான்களோ தேவனுக்கு முன்பாக மகிழ்ந்து களிகூர்ந்து,","poem":1},{"lineBreak":true},{"text":"ஆனந்த சந்தோஷமடைவார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"தேவனைப் பாடி, அவருடைய பெயரைப் புகழ்ந்து பாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"வனாந்திரங்களில் ஏறிவருகிறவருக்கு வழியை ஆயத்தப்படுத்துங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய பெயர் யெகோவா, அவருக்கு முன்பாகக் களிகூருங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தம்முடைய பரிசுத்த வாசஸ்தலத்திலிருக்கிற தேவன்,","poem":1},{"lineBreak":true},{"text":"திக்கற்ற பிள்ளைகளுக்குத் தகப்பனும், விதவைகளுக்கு நியாயம் விசாரிக்கிறவருமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"தேவன் தனிமையானவர்களுக்கு வீடுவாசல் ஏற்படுத்தி,","poem":1},{"lineBreak":true},{"text":"கட்டப்பட்டவர்களை விடுதலையாக்குகிறார்;","poem":1},{"lineBreak":true},{"text":"துரோகிகளோ வறண்ட பூமியில் தங்குவார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவனே, நீர் உம்முடைய மக்களுக்கு முன்னே சென்று, பாலைவனத்தில் நடந்து வரும்போது, (சேலா)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"பூமி அதிர்ந்தது; தேவனாகிய உமக்கு முன்பாக வானமும் பொழிந்தது;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் தேவனாக இருக்கிற தேவனுக்கு முன்பாகவே இந்தச் சீனாய்மலையும் அசைந்தது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தேவனே, சம்பூரண மழையைப் பெய்யச்செய்தீர்;","poem":1},{"lineBreak":true},{"text":"இளைத்துப்போன உமது சுதந்தரத்தைத் திடப்படுத்தினீர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உம்முடைய மந்தை அதிலே தங்கியிருந்தது;","poem":1},{"lineBreak":true},{"text":"தேவனே, உம்முடைய தயையினாலே ஏழைகளைப் பராமரிக்கிறீர்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"ஆண்டவர் வசனம் தந்தார்; அதைப் பிரபலப்படுத்துகிறவர்களின் கூட்டம் மிகுதி.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"சேனைகளின் ராஜாக்கள் தத்தளித்து ஓடினார்கள்;","poem":1},{"lineBreak":true},{"text":"வீட்டிலிருந்த பெண் கொள்ளைப்பொருளைப் பங்கிட்டாள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீங்கள் அடுப்பினடியில் கிடந்தவர்களாக இருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"வெள்ளியால் அலங்கரிக்கப்பட்ட புறாவின் இறக்கைகள்","poem":1},{"noteId":19},{"text":"போலவும், பசும்பொன் நிறமாகிய அதின் இறகுகளின் சாயலாகவும் இருப்பீர்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"சர்வவல்லவர் அதில் ராஜாக்களைச் சிதறடித்தபோது,","poem":1},{"lineBreak":true},{"text":"அது சல்மோன் மலையின் உறைந்த மழைபோல் வெண்மையானது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"தேவ மலை பாசான் மலை போல இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"பாசான் மலை உயர்ந்த சிகரங்களுள்ளது.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உயர்ந்த சிகரமுள்ள மலைகளே, ஏன் துள்ளுகிறீர்கள்; இந்த மலையில் தங்கியிருக்க தேவன் விரும்பினார்;","poem":1},{"lineBreak":true},{"text":"ஆம், யெகோவா இதிலே என்றென்றைக்கும் தங்கியிருப்பார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தேவனுடைய இரதங்கள் பத்தாயிரங்களும்,","poem":1},{"lineBreak":true},{"text":"ஆயிரமாயிரங்களுமாக இருக்கிறது; ஆண்டவர் பரிசுத்த ஸ்தலமான சீனாயிலிருந்ததைபோல அவைகளுக்குள் இருக்கிறார்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"தேவனே நீர் உன்னதத்திற்கு ஏறி,","poem":1},{"lineBreak":true},{"text":"சிறைப்பட்டவர்களைச் சிறையாக்கிக் கொண்டுபோனீர்;","poem":1},{"lineBreak":true},{"text":"தேவனாகிய யெகோவா மனிதர்களுக்குள் தங்கும்படியாக,","poem":1},{"lineBreak":true},{"text":"துரோகிகளாகிய மனிதர்களுக்காகவும் வரங்களைப் பெற்றுக்கொண்டீர்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"எந்த நாளும் ஆண்டவருக்கு ஸ்தோத்திரமுண்டாவதாக;","poem":1},{"lineBreak":true},{"text":"நம்மேல் பாரஞ்சுமத்தினாலும் நம்மை இரட்சிக்கிற தேவன் அவரே. (சேலா)","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நம்முடைய தேவன் இரட்சிப்பை அருளும் தேவனாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"ஆண்டவராகிய கர்த்தரால் மரணத்திற்கு நீங்கும் வழிகளுண்டு.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"மெய்யாகவே தேவன் தம்முடைய எதிரிகளின் தலையையும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய அக்கிரமங்களில் துணிந்து நடக்கிறவனுடைய முடியுள்ள உச்சந்தலையையும் உடைப்பார்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"உன்னுடைய கால்கள் எதிரிகளின் இரத்தத்தில் பதியும்படியாகவும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய நாய்களின் நாக்கு அதை நக்கும்படியாகவும்,","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"என்னுடைய மக்களைப் பாசானிலிருந்து திரும்ப அழைத்து வருவேன்;","poem":1},{"lineBreak":true},{"text":"அதை கடலின் ஆழங்களிலிருந்தும் திரும்ப அழைத்து வருவேன் என்று ஆண்டவர் சொன்னார்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"தேவனே, உம்முடைய நடைகளைக் கண்டார்கள்;","poem":1},{"lineBreak":true},{"text":"என் தேவனும் என்னுடைய ராஜாவும் பரிசுத்த ஸ்தலத்திலே நடந்து வருகிற நடைகளையே கண்டார்கள்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"முன்னாகப் பாடுகிறவர்களும், பின்னாக வீணைகளை வாசிக்கிறவர்களும்,","poem":1},{"lineBreak":true},{"text":"சுற்றிலும் தம்புரு வாசிக்கிற கன்னிகைகளும் நடந்தார்கள்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"இஸ்ரவேலின் ஊற்றிலிருந்து தோன்றினவர்களே,","poem":1},{"lineBreak":true},{"text":"சபைகளின் நடுவே ஆண்டவராகிய தேவனை ஸ்தோத்திரியுங்கள்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அங்கே அவர்களை ஆளுகிற சின்ன பென்யமீனும், யூதாவின் பிரபுக்களும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய கூட்டமும், செபுலோனின் பிரபுக்களும்,","poem":1},{"lineBreak":true},{"text":"நப்தலியின் பிரபுக்களும் உண்டு.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"உன்னுடைய தேவன் உனக்குப் பலத்தைக் கட்டளையிட்டார்;","poem":1},{"lineBreak":true},{"text":"தேவனே, நீர் எங்களுக்காக உண்டாக்கியதை பலப்படுத்தும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"எருசலேமிலுள்ள உம்முடைய ஆலயத்திற்காக,","poem":1},{"lineBreak":true},{"text":"ராஜாக்கள் உமக்குக் காணிக்கைகளைக் கொண்டு வருவார்கள்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"நாணலிலுள்ள மிருககூட்டத்தையும், மக்களாகிய கன்றுகளோடுகூட கன்றுகளின் கூட்டத்தையும் அதட்டும்;","poem":1},{"lineBreak":true},{"text":"ஒவ்வொருவனும் வெள்ளிப்பணங்களைக் கொண்டுவந்து பணிந்துகொள்ளுவான்;","poem":1},{"lineBreak":true},{"text":"யுத்தங்களில் பிரியப்படுகிற மக்களைச் சிதறடிப்பார்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"பிரபுக்கள் எகிப்திலிருந்து வருவார்கள்;","poem":1},{"lineBreak":true},{"text":"எத்தியோப்பியா தேவனை நோக்கி கையை உயர்த்த துரிதப்படும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"பூமியின் ராஜ்ஜியங்களே, தேவனைப் பாடி, ஆண்டவரைப் புகழ்ந்துபாடுங்கள். (சேலா)","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ஆரம்பமுதலாயிருக்கிற வானாதி வானங்களின்மேல் எழுந்தருளியிருக்கிறவரைப் பாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"இதோ, தமது சத்தத்தைப் பலத்த சத்தமாக முழங்கச்செய்கிறார்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"தேவனுடைய வல்லமையைப் பிரபலப்படுத்துங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய மகிமை இஸ்ரவேலின்மேலும், அவருடைய வல்லமை மேகமண்டலங்களிலும் உள்ளது.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"தேவனே, உமது பரிசுத்த ஸ்தலங்களிலிருந்து பயங்கரமாக விளங்குகிறீர்;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் தேவன் தம்முடைய மக்களுக்குப் பெலனையும் சத்துவத்தையும் அருளுகிறவர்;","poem":1},{"lineBreak":true},{"text":"தேவனுக்கு ஸ்தோத்திரமுண்டாவதாக.","poem":1}]}],"footnotes":[{"noteId":19,"caller":"+","text":"புறாக்கள் இஸ்ரவேல் பெண்களுக்கு அடையாளமாக சொல்லப்பட்டுள்ளது","reference":{"chapter":68,"verse":13}}]},"thisChapterLink":"/api/tam_irv/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}