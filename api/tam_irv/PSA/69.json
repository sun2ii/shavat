{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["சோஷனீம் வாத்தியத்தில் வாசிக்க இராகத்தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, என்னைக் காப்பாற்றும்;","poem":1},{"lineBreak":true},{"text":"வெள்ளங்கள் என்னுடைய ஆத்துமாவரை பெருகிவருகிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஆழமான உளையில் அமிழ்ந்திருக்கிறேன், நிற்க நிலையில்லை,","poem":1},{"lineBreak":true},{"text":"ஆழமான தண்ணீரில் இருக்கிறேன்; வெள்ளங்கள் என்மேல் புரண்டுபோகிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் கூப்பிடுகிறதினால் இளைத்தேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய தொண்டை வறண்டுபோனது;","poem":1},{"lineBreak":true},{"text":"என் தேவனுக்கு நான் காத்திருக்கும்போது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கண்கள் பூத்துப்போனது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"காரணமில்லாமல் என்னைப் பகைக்கிறவர்கள் என்னுடைய தலைமுடியிலும் அதிகமாக இருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"வீணாக எனக்கு எதிரிகளாகி என்னை அழிக்கவேண்டும் என்றிருக்கிறவர்கள் பலத்திருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நான் எடுத்துக்கொள்ளாததை நான் கொடுக்கவேண்டியதானது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேவனே, நீர் என்னுடைய புத்தியீனத்தை அறிந்திருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய குற்றங்கள் உமக்கு மறைந்திருக்கவில்லை.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"சேனைகளின் கர்த்தராகிய ஆண்டவரே,","poem":1},{"lineBreak":true},{"text":"உமக்காகக் காத்திருக்கிறவர்கள் என்னால் வெட்கப்பட்டுப் போகாமலிருப்பார்களாக;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் தேவனே, உம்மைத் தேடுகிறவர்கள் என்னிமித்தம் வெட்கமடையாதிருப்பார்களாக.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உமக்காக நிந்தையைச் சகித்தேன்;","poem":1},{"lineBreak":true},{"text":"அவமானம் என்னுடைய முகத்தை மூடினது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய சகோதரர்களுக்கு வேற்று மனிதனும், என்னுடைய தாயின் பிள்ளைகளுக்கு அந்நியனுமானேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உம்முடைய வீட்டைக்குறித்து உண்டான பக்திவைராக்கியம் எனக்குள் பற்றியெரிந்தது;","poem":1},{"lineBreak":true},{"text":"உம்மை நிந்திக்கிறவர்களுடைய நிந்தனைகள் என்மேல் விழுந்தது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா வாடும்படி உபவாசித்து அழுதேன்;","poem":1},{"lineBreak":true},{"text":"அதுவும் எனக்கு நிந்தையாக முடிந்தது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சணலாடையை என்னுடைய உடையாக்கினேன்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுதும் அவர்களுக்குப் பழமொழியானேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"வாசலில் உட்கார்ந்திருக்கிறவர்கள் எனக்கு விரோதமாகப் பேசுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"மதுபானம் குடிக்கிறவர்களின் பாடலானேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ஆனாலும் யெகோவாவே, உதவிக்காலத்திலே உம்மை நோக்கி விண்ணப்பம்செய்கிறேன்;","poem":1},{"lineBreak":true},{"text":"தேவனே, உமது மிகுந்த கிருபையினாலும் உமது இரட்சிப்பின் சத்தியத்தினாலும் எனக்குச் செவிகொடுத்தருளும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நான் அமிழ்ந்து போகாதபடிக்குச் சேற்றிலிருந்து என்னைத் தூக்கிவிடும்;","poem":1},{"lineBreak":true},{"text":"என்னைப் பகைக்கிறவர்களிடத்திலிருந்தும் ஆழமான தண்ணீர்களில் இருந்தும் நான் நீங்கும்படி செய்யும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"வெள்ளங்கள் என்மேல் புரளாமலும், ஆழம் என்னை விழுங்காமலும்,","poem":1},{"lineBreak":true},{"text":"பாதாளம் என்மேல் தன்னுடைய வாயை அடைத்துக்கொள்ளாமலும் இருப்பதாக.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய விண்ணப்பத்தைக் கேட்டருளும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய தயை நலமாயிருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உமது உருக்கமான இரக்கங்களின்படி என்னைக் கண்ணோக்கியருளும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உமது முகத்தை உமது அடியேனுக்கு மறையாதேயும்;","poem":1},{"lineBreak":true},{"text":"நான் வியாகுலப்படுகிறேன், எனக்குத் தீவிரமாகச் செவிகொடுத்தருளும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நீர் என் ஆத்துமாவினிடத்தில் வந்து அதை விடுதலைசெய்யும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகளுக்காக என்னை மீட்டுவிடும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தேவனே நீர் என்னுடைய நிந்தையையும்","poem":1},{"lineBreak":true},{"text":"என்னுடைய வெட்கத்தையும் என்னுடைய அவமானத்தையும் அறிந்திருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் எல்லோரும் உமக்கு முன்பாக இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"நிந்தை என்னுடைய இருதயத்தைப் பிளந்தது;","poem":1},{"lineBreak":true},{"text":"நான் மிகவும் வேதனைப்படுகிறேன்;","poem":1},{"lineBreak":true},{"text":"எனக்காக பரிதபிக்கிறவனுண்டோ என்று காத்திருந்தேன்,","poem":1},{"lineBreak":true},{"text":"ஒருவனும் இல்லை; தேற்றுகிறவர்களுக்குக் காத்திருந்தேன்,","poem":1},{"lineBreak":true},{"text":"ஒருவனும் இல்லை.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆகாரத்தில் கசப்பு கலந்து கொடுத்தார்கள்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய தாகத்திற்குக் காடியைக் குடிக்கக் கொடுத்தார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"அவர்களுடைய பந்தி அவர்களுக்குக் கண்ணியும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய செல்வம் அவர்களுக்கு வலையுமாக இருக்கட்டும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவர்களுடைய கண்கள் காணாதபடி இருளாகட்டும்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் இடுப்புகளை எப்போதும் தள்ளாடச்செய்யும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"உம்முடைய கடுங்கோபத்தை அவர்கள்மேல் ஊற்றும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கோபாக்கினி அவர்களைத் தொடர்ந்து பிடிப்பதாக.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவர்கள் குடியிருப்பு பாழாகட்டும்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய கூடாரங்களில் குடியில்லாமற்போவதாக.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"தேவனே நீர் அடித்தவனை அவர்கள் துன்பப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"நீர் காயப்படுத்தினவர்களை நோகப் பேசுகிறார்களே.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அக்கிரமத்தின்மேல் அக்கிரமத்தை அவர்கள்மேல் சுமத்தும், அவர்கள் உமது நீதிக்கு வந்தெட்டாதிருப்பார்களாக.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"ஜீவபுத்தகத்திலிருந்து அவர்கள் பெயர் கிறுக்கப்பட்டுப்போவதாக;","poem":1},{"lineBreak":true},{"text":"நீதிமான்கள் பெயரோடே அவர்கள் பெயர் எழுதப்படாதிருப்பதாக.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"நானோ சிறுமையும் துயரமுமுள்ளவன்;","poem":1},{"lineBreak":true},{"text":"தேவனே, உம்முடைய இரட்சிப்பு எனக்கு உயர்ந்த அடைக்கலமாவதாக.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"தேவனுடைய பெயரைப் பாட்டினால் துதித்து,","poem":1},{"lineBreak":true},{"text":"அவரை நன்றி சொல்லி மகிமைப்படுத்துவேன்.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"கொம்பும் விரிகுளம்புமுள்ள காளை எருதைவிட,","poem":1},{"lineBreak":true},{"text":"இதுவே யெகோவாவுக்குப் பிரியமாக இருக்கும்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"சாந்தகுணமுள்ளவர்கள் இதைக் கண்டு சந்தோஷப்படுவார்கள்;","poem":1},{"lineBreak":true},{"text":"தேவனைத் தேடுகிறவர்களே, உங்களுடைய இருதயம் வாழும்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"யெகோவா எளியவர்களின் விண்ணப்பத்தைக் கேட்கிறார்,","poem":1},{"lineBreak":true},{"text":"கட்டுண்ட தம்முடையவர்களை அவர் புறக்கணிக்கமாட்டார்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"வானமும் பூமியும் கடல்களும் அவைகளில் வாழ்கிற அனைத்தும் அவரைத் துதிக்கட்டும்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"தேவன் சீயோனைக் காப்பாற்றி, யூதாவின் பட்டணங்களைக் கட்டுவார்;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது அங்கே குடியிருந்து அதை உரிமையாக்கிக்கொள்வார்கள்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"அவருடைய ஊழியக்காரரின் சந்ததியார் அதை உரிமையாக்கிக் கொள்வார்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய பெயரை நேசிக்கிறவர்கள் அதில் குடியிருப்பார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}