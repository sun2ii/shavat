{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["பென்யமீனியனாகிய கூஷ் என்பவனுடைய வார்த்தையினிமித்தம் யெகோவாவை நோக்கி தாவீது பாடிய பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என் தேவனாகிய யெகோவாவே, உம்மிடம் அடைக்கலம் தேடுகிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னைத் துன்பப்படுத்துகிறவர்கள் எல்லோருக்கும் என்னை விலக்கி காப்பாற்றும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எதிரி சிங்கம்போல் என்னுடைய ஆத்துமாவைப் பிடித்துக்கொண்டுபோய்,","poem":1},{"lineBreak":true},{"text":"விடுவிக்கிறவன் இல்லாததால்,","poem":1},{"lineBreak":true},{"text":"அதைப் பீறாதபடிக்கு என்னைத் தப்புவியும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என் தேவனாகிய யெகோவாவே, நான் இதைச் செய்ததும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கைகளில் நியாயக்கேடு இருக்கிறதும்,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னோடு சமாதானமாக இருந்தவனுக்கு நான் தீமைசெய்ததும்,","poem":1},{"lineBreak":true},{"text":"காரணமில்லாமல் எனக்கு எதிரியானவனை நான் கொள்ளையிட்டதும் உண்டானால்,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"எதிரி என்னுடைய ஆத்துமாவைத் தொடர்ந்துபிடித்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உயிரைத் தரையிலே தள்ளி மிதித்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய மகிமையைப் புழுதியிலே தாழ்த்தட்டும். (சேலா)","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் உம்முடைய கோபத்தில் எழுந்திருந்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய எதிரிகளுடைய கடுங்கோபங்களுக்காக உம்மை உயர்த்தி,","poem":1},{"lineBreak":true},{"text":"எனக்காக விழித்துக்கொள்ளும்; நியாயத்தீர்ப்பை நியமித்திருக்கிறீரே.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மக்கள்கூட்டம் உம்மைச் சூழ்ந்துகொள்ளட்டும்;","poem":1},{"lineBreak":true},{"text":"அவர்களுக்காகத் திரும்பவும் உன்னதத்திற்கு எழுந்தருளும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா மக்களுக்கு நியாயம் செய்வார்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய நீதியினாலும் என்னிலுள்ள உண்மையினாலும்","poem":1},{"lineBreak":true},{"text":"எனக்கு நியாயம்செய்யும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"துன்மார்க்கனுடைய தீய செயல்கள் ஒழிவதாக;","poem":1},{"lineBreak":true},{"text":"நீதிமானை நிலைநிறுத்தும்;","poem":1},{"lineBreak":true},{"text":"நீதியுள்ளவராக இருக்கிற தேவனே நீர் இருதயங்களையும்,","poem":1},{"lineBreak":true},{"text":"சிந்தைகளையும் சோதித்தறிகிறவர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"செம்மையான இருதயமுள்ளவர்களை இரட்சிக்கிற தேவனிடத்தில் என்னுடைய கேடகம் இருக்கிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவன் நீதியுள்ள நியாயாதிபதி;","poem":1},{"lineBreak":true},{"text":"அவர் நாள்தோறும் பாவியின்மேல் கோபம்கொள்ளுகிற தேவன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவன் மனந்திரும்பாவிட்டால் அவர் தம்முடைய பட்டயத்தைக் கூர்மையாக்குவார்;","poem":1},{"lineBreak":true},{"text":"அவர் தம்முடைய வில்லை நாணேற்றி, அதை ஆயத்தப்படுத்தியிருக்கிறார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவனுக்கு மரண ஆயுதங்களை ஆயத்தம் செய்தார்;","poem":1},{"lineBreak":true},{"text":"தம்முடைய அம்புகளை நெருப்பு அம்புகளாக்கினார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"இதோ, அவனுடைய அக்கிரமத்தைப் பெறக் கர்ப்பவேதனைப்படுகிறான்;","poem":1},{"lineBreak":true},{"text":"தீவினையைக் கர்ப்பந்தரித்து, பொய்யைப் பெறுகிறான்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"குழியை வெட்டி, அதை ஆழமாக்கினான்;","poem":1},{"lineBreak":true},{"text":"தான் வெட்டின குழியில் தானே விழுந்தான்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவனுடைய தீவினை அவனுடைய தலையின்மேல் திரும்பும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய கொடுமை அவனுடைய உச்சந்தலையின்மேல் இறங்கும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நான் யெகோவாவை அவருடைய நீதியின்படி துதிப்பேன்.","poem":1},{"lineBreak":true},{"text":"நான் உன்னதமான உன்னதமான தேவனாகிய யெகோவாடைய பெயரைப் புகழ்ந்து பாடுவேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}