{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["நினைப்பூட்டுதலாகப் பாடி இராகத்தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, என்னை விடுவியும், யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"எனக்கு உதவிசெய்ய விரைந்துவாரும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய உயிரை வாங்கத்தேடுகிறவர்கள் வெட்கி குழப்பம் அடைவார்களாக;","poem":1},{"lineBreak":true},{"text":"எனக்குத் தீங்குவரும்படி விரும்புகிறவர்கள் பின்னிட்டுத் திரும்பி வெட்கம் அடைவார்களாக.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ஆ ஆ, ஆ ஆ, என்பவர்கள் தாங்கள் அடையும் வெட்கத்தினால் பின்னாகப்போவார்களாக.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உம்மைத் தேடுகிற அனைவரும் உம்மில் மகிழ்ந்து சந்தோஷப்படுவார்களாக;","poem":1},{"lineBreak":true},{"text":"உமது இரட்சிப்பில் பிரியப்படுகிறவர்கள் தேவனுக்கு மகிமையுண்டாவதாக என்று","poem":1},{"lineBreak":true},{"text":"எப்பொழுதும் சொல்வார்களாக.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நானோ எளிமையும், தேவையுள்ளவனுமாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"தேவனே, என்னிடத்தில் விரைவாக வாரும்:","poem":1},{"lineBreak":true},{"text":"நீரே என்னுடைய துணையும் என்னை விடுவிக்கிறவருமானவர், யெகோவாவே, தாமதிக்காமலிரும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}