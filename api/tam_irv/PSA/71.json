{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உம்மை நம்பியிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"நான் ஒருபோதும் வெட்கம் அடையாதபடி செய்யும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உமது நீதியினிமித்தம் என்னை விடுவித்து,","poem":1},{"lineBreak":true},{"text":"என்னைக் காத்தருளும்;","poem":1},{"lineBreak":true},{"text":"உமது செவியை எனக்குச் சாய்த்து,","poem":1},{"lineBreak":true},{"text":"என்னைக் காப்பாற்றும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் எப்பொழுதும் வந்தடையக்கூடிய கன்மலையாக இரும்;","poem":1},{"lineBreak":true},{"text":"என்னை இரட்சிப்பதற்குக் கட்டளையிட்டீரே;","poem":1},{"lineBreak":true},{"text":"நீரே என்னுடைய கன்மலையும் என்னுடைய கோட்டையுமாக இருக்கிறீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என் தேவனே, துன்மார்க்கனுடைய கைக்கும்,","poem":1},{"lineBreak":true},{"text":"நியாயக்கேடும் கொடுமையுமுள்ளவனுடைய கைக்கும் என்னைத் தப்புவியும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவா ஆண்டவரே, நீரே என்னுடைய நோக்கமும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய சிறுவயது தொடங்கி என்னுடைய நம்பிக்கையுமாக இருக்கிறீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் கர்ப்பத்தில் உருவானதுமுதல் உம்மால் ஆதரிக்கப்பட்டேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய தாயின் வயிற்றிலிருந்து என்னை எடுத்தவர் நீரே;","poem":1},{"lineBreak":true},{"text":"உம்மையே நான் எப்பொழுதும் துதிப்பேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அநேகருக்கு நான் ஒரு புதுமைபோலானேன்;","poem":1},{"lineBreak":true},{"text":"நீரோ எனக்குப் பலத்த அடைக்கலமாக இருக்கிறீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய வாய் உமது துதியினாலும்,","poem":1},{"lineBreak":true},{"text":"நாள்தோறும் உமது மகத்துவத்தினாலும் நிறைந்திருப்பதாக.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"முதிர்ந்த வயதில் என்னைத் தள்ளிவிடாமலும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய பெலன் ஒடுங்கும்போது என்னைக் கைவிடாமலும் இரும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் எனக்கு விரோதமாகப் பேசி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவுக்குக் காத்திருக்கிறவர்கள் ஒன்றாக ஆலோசனைசெய்து:","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவன் அவனைக் கைவிட்டார், அவனைத் தொடர்ந்து பிடியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவனை விடுவிப்பவர்கள் இல்லை என்கிறார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தேவனே, எனக்குத் தூரமாக இருக்க வேண்டாம்;","poem":1},{"lineBreak":true},{"text":"என் தேவனே, எனக்கு உதவிசெய்ய விரைந்து வாரும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவை விரோதிக்கிறவர்கள் வெட்கி அழியவும்,","poem":1},{"lineBreak":true},{"text":"எனக்குப் பொல்லாப்புத் தேடுகிறவர்கள் நிந்தையாலும் வெட்கத்தாலும் மூடப்படவும் வேண்டும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நானோ எப்பொழுதும் நம்பிக்கைகொண்டிருந்து,","poem":1},{"lineBreak":true},{"text":"மேன்மேலும் உம்மைத் துதிப்பேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"என்னுடைய வாய் நாள்தோறும் உமது நீதியையும் உமது இரட்சிப்பையும் சொல்லும்;","poem":1},{"lineBreak":true},{"text":"அவைகளின் தொகையை நான் அறியவில்லை.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"யெகோவா ஆண்டவருடைய வல்லமையை முன்னிட்டு நடப்பேன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய நீதியைப்பற்றியே மேன்மைபாராட்டுவேன்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"தேவனே, என்னுடைய சிறுவயதுமுதல் எனக்குப் போதித்து வந்தீர்;","poem":1},{"lineBreak":true},{"text":"இதுவரைக்கும் உம்முடைய அதிசயங்களை அறிவித்துவந்தேன்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"இப்பொழுதும் தேவனே, இந்தச் சந்ததிக்கு உமது பெலனையும்,","poem":1},{"lineBreak":true},{"text":"வரப்போகிற எல்லோருக்கும் உமது வல்லமையையும் நான் அறிவிக்கும்வரை,","poem":1},{"lineBreak":true},{"text":"முதிர்வயதும் நரைமுடியும் உள்ளவனாகும்வரை என்னைக் கைவிடாமல் இருப்பீராக.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"தேவனே, உம்முடைய நீதி உன்னதமானது,","poem":1},{"lineBreak":true},{"text":"பெரிதானவைகளை நீர் செய்தீர்; தேவனே, உமக்கு நிகரானவர் யார்?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"அநேக இக்கட்டுகளையும் ஆபத்துகளையும் காணும்படி செய்த என்னை நீர் திரும்பவும் உயிர்ப்பித்து,","poem":1},{"lineBreak":true},{"text":"திரும்பவும் என்னைப் பூமியின் பாதாளங்களிலிருந்து ஏறச்செய்வீர்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"என்னுடைய மேன்மையைப் பெருகச்செய்து,","poem":1},{"lineBreak":true},{"text":"என்னை மறுபடியும் தேற்றுவீர்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"என் தேவனே, நான் வீணையைக் கொண்டு உம்மையும் உம்முடைய சத்தியத்தையும் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் பரிசுத்தரே, சுரமண்டலத்தைக் கொண்டு உம்மைப் பாடுவேன்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"நான் பாடும்போது என்னுடைய உதடுகளும்,","poem":1},{"lineBreak":true},{"text":"நீர் மீட்டுக்கொண்ட என் ஆத்துமாவும் கெம்பீரித்து மகிழும்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"எனக்குப் பொல்லாப்பைத் தேடுகிறவர்கள் வெட்கி குழம்பினபடியால்,","poem":1},{"lineBreak":true},{"text":"நாள்தோறும் என்னுடைய நாவு உமது நீதியைக் கொண்டாடும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}