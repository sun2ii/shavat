{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":72,"content":[{"type":"verse","number":1,"content":[{"text":"தேவனே, ராஜாவுக்கு உம்முடைய நியாயத்தீர்ப்புகளையும்,","poem":1},{"lineBreak":true},{"text":"ராஜாவின் மகனுக்கு உம்முடைய நீதியையும் கொடுத்தருளும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"அவர் உம்முடைய மக்களை நீதியோடும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய ஏழைகளை நியாயத்தோடும் விசாரிப்பார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மலைகள் மக்களுக்குச் சமாதானத்தைத் தரும்,","poem":1},{"lineBreak":true},{"text":"மேடுகள் நீதியின் விளைவோடு இருக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மக்களில் சிறுமைப்படுகிறவர்களை அவர் நியாயம் விசாரித்து,","poem":1},{"lineBreak":true},{"text":"ஏழையின் பிள்ளைகளை இரட்சித்து, இடுக்கண் செய்கிறவனை நொறுக்குவார்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"சூரியனும் சந்திரனும் உள்ளவரை, அவர்கள் உமக்குத் தலைமுறை தலைமுறையாகப் பயந்திருப்பார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"புல் அறுக்கப்பட வெளியின்மேல் பெய்யும் மழையைப்போலவும், பூமியை நனைக்கும் தூறலைப்போலவும் இறங்குவார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவருடைய நாட்களில் நீதிமான் செழிப்பான்;","poem":1},{"lineBreak":true},{"text":"சந்திரனுள்ளவரைக்கும் மிகுந்த சமாதானம் இருக்கும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஒரு சமுத்திரந்தொடங்கி மறுசமுத்திரம்வரைக்கும்,","poem":1},{"lineBreak":true},{"text":"நதி துவங்கி பூமியின் எல்லைகள்வரைக்கும் அவர் அரசாளுவார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வனாந்திரத்தார்கள் அவருக்கு முன்பாகக் குனிந்து வணங்குவார்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய எதிரிகள் மண்ணை நக்குவார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தர்ஷீசின் ராஜாக்களும் மத்திய தரைக் கடல் தீவுகளின் ராஜாக்களும் காணிக்கைகளைக் கொண்டுவருவார்கள்;","poem":1},{"lineBreak":true},{"text":"ஷேபாவிலும் சேபாவிலுமுள்ள ராஜாக்கள் வெகுமானங்களைக் கொண்டுவருவார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"எல்லா ராஜாக்களும் அவரைப் பணிந்துகொள்வார்கள்;","poem":1},{"lineBreak":true},{"text":"எல்லா தேசங்களும் அவரைச் சேவிப்பார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"கூப்பிடுகிற எளியவனையும், உதவியற்ற சிறுமையானவனையும் அவர் விடுவிப்பார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"எளியவனுக்கும், தேவையுள்ளவனுக்கும் அவர் இரங்கி,","poem":1},{"lineBreak":true},{"text":"எளியவர்களின் ஆத்துமாக்களை விடுவிப்பார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவர்கள் ஆத்துமாக்களை வஞ்சகத்திற்கும் கொடுமைக்கும் தப்புவிப்பார்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய இரத்தம் அவருடைய பார்வைக்கு அருமையாக இருக்கும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவர் பிழைத்திருப்பார், ஷேபாவின் பொன் அவருக்குக் கொடுக்கப்படும்;","poem":1},{"lineBreak":true},{"text":"அவர்நிமித்தம் இடைவிடாமல் ஜெபம்செய்யப்படும்,","poem":1},{"lineBreak":true},{"text":"எந்நாளும் ஸ்தோத்திரிக்கப்படுவார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"பூமியிலே மலைகளின் உச்சிகளில் ஒரு பிடி தானியம் விதைக்கப்பட்டிருக்கும்;","poem":1},{"lineBreak":true},{"text":"அதின் விளைவு லீபனோனைப்போல அசையும்;","poem":1},{"lineBreak":true},{"text":"பூமியின் புல்லைப்போல நகரத்தார்கள் செழித்தோங்குவார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவருடைய பெயர் என்றென்றைக்கும் இருக்கும்;","poem":1},{"lineBreak":true},{"text":"சூரியன் இருக்கும்வரை அவருடைய பெயரும் புகழும் தொடர்ந்து நிலைக்கும்;","poem":1},{"lineBreak":true},{"text":"மனிதர்கள் அவருக்குள் ஆசீர்வதிக்கப்படுவார்கள்,","poem":1},{"lineBreak":true},{"text":"எல்லா தேசங்களும் அவரைப் பாக்கியமுடையவர்கள் என்று வாழ்த்துவார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"இஸ்ரவேலின் தேவனாக இருக்கிற கர்த்தராகிய தேவனுக்கு ஸ்தோத்திரமுண்டாவதாக;","poem":1},{"lineBreak":true},{"text":"அவரே அதிசயங்களைச் செய்கிறவர்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவருடைய மகிமைபொருந்திய நாமத்திற்கு என்றென்றைக்கும் துதி உண்டாவதாக;","poem":1},{"lineBreak":true},{"text":"பூமிமுழுவதும் அவருடைய மகிமையால் நிறைந்திருப்பதாக.","poem":1},{"lineBreak":true},{"text":"ஆமென், ஆமென்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ஈசாயின் மகனாகிய தாவீதின் விண்ணப்பங்கள் முடிந்தது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}