{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"சுத்த இருதயமுள்ளவர்களாகிய இஸ்ரவேலர்களுக்கு","poem":1},{"lineBreak":true},{"text":"தேவன் நல்லவராகவே இருக்கிறார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"ஆனாலும் என்னுடைய கால்கள் தள்ளாடுதலுக்கும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய அடிகள் சறுக்குதலுக்கும் சற்றே தப்பியது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களின் வாழ்வை நான் காணும்போது,","poem":1},{"lineBreak":true},{"text":"வீம்புக்காரர்களாகிய அவர்கள்மேல் பொறாமை கொண்டேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மரணம்வரை அவர்களுக்கு வேதனை இல்லை;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய பெலன் உறுதியாக இருக்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மனிதர்கள்படும் வருத்தத்தில் அகப்படமாட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"மனிதர்கள் அடையும் உபத்திரவத்தை அடையமாட்டார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"ஆகையால் பெருமை கழுத்து அணிகலன்போல அவர்களைச் சுற்றிக்கொள்ளும்,","poem":1},{"lineBreak":true},{"text":"கொடுமை ஆடையைப்போல் அவர்களை மூடிக்கொள்ளும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர்களுடைய கண்கள் கொழுப்பினால் எடுப்பாகப் பார்க்கிறது;","poem":1},{"lineBreak":true},{"text":"அவர்கள் இருதயம் விரும்புவதிலும் அதிகமாக நடக்கிறது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர்கள் சீர்கெட்டுப்போய், அகந்தையாகக் கொடுமை பேசுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"பெருமையாகப் பேசுகிறார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தங்களுடைய வாய் வானம்வரை எட்டப் பேசுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய நாவு பூமியெங்கும் உலாவுகிறது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆகையால் அவருடைய மக்கள் இந்த வழியாகவே திரும்புகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"தண்ணீர்கள் அவர்களுக்குப் பரிபூரணமாகச் சுரந்துவரும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவனுக்கு அது எப்படித் தெரியும்?","poem":1},{"lineBreak":true},{"text":"உன்னதமானவருக்கு அதைப்பற்றி அறிவு உண்டோ?","poem":1},{"lineBreak":true},{"text":"என்று சொல்லுகிறார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"இதோ, இவர்கள் துன்மார்க்கர்கள்;","poem":1},{"lineBreak":true},{"text":"இவர்கள் என்றும் சுகமாக வாழ்கிறவர்களாயிருந்து,","poem":1},{"lineBreak":true},{"text":"சொத்தைப் பெருகச்செய்கிறார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நான் வீணாகவே என்னுடைய இருதயத்தைச் சுத்தம்செய்து,","poem":1},{"lineBreak":true},{"text":"குற்றமில்லாமையிலே என்னுடைய கைகளைக் கழுவினேன்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நாள்தோறும் நான் வாதிக்கப்பட்டும்,","poem":1},{"lineBreak":true},{"text":"காலைதோறும் தண்டிக்கப்பட்டும் இருக்கிறேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"இந்த விதமாகப் பேசுவேன் என்று நான் சொன்னால்,","poem":1},{"lineBreak":true},{"text":"இதோ, உம்முடைய பிள்ளைகளின் சந்ததிக்குத் துரோகியாவேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"இதை அறியும்படிக்கு யோசித்துப்பார்த்தேன்;","poem":1},{"lineBreak":true},{"text":"நான் தேவனுடைய பரிசுத்த ஸ்தலத்திற்குள் நுழைந்து,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவர்கள் முடிவைக் கவனித்து உணரும்வரை,","poem":1},{"lineBreak":true},{"text":"அது என்னுடைய பார்வைக்கு கடினமாக இருந்தது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நிச்சயமாகவே நீர் அவர்களைச் சறுக்கலான இடங்களில் நிறுத்தி,","poem":1},{"lineBreak":true},{"text":"பாழான இடங்களில் விழச்செய்கிறீர்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவர்கள் ஒரு நிமிடத்தில் எவ்வளவு பாழாகிப்போகிறார்கள்!","poem":1},{"lineBreak":true},{"text":"பயங்கரங்களால் அழிந்து ஒன்றுமில்லாமல் போகிறார்கள்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தூக்கம் தெளிந்தவுடனே சொப்பனம் ஒழிவதுபோல், ஆண்டவரே,","poem":1},{"lineBreak":true},{"text":"நீர் விழிக்கும்போது, அவர்கள் வேஷத்தை கலைத்துவிடுவீர்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"இப்படியாக என்னுடைய மனம் கசந்தது,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உள்மனதிலே குத்தப்பட்டேன்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"நான் காரியம் அறியாத மூடனானேன்;","poem":1},{"lineBreak":true},{"text":"உமக்கு முன்பாக மிருகம் போலிருந்தேன்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"ஆனாலும் நான் எப்பொழுதும் உம்மோடிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய வலதுகையைப் பிடித்துத் தாங்குகிறீர்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"உம்முடைய ஆலோசனையின்படி நீர் என்னை நடத்தி,","poem":1},{"lineBreak":true},{"text":"முடிவிலே என்னை மகிமையில் ஏற்றுக்கொள்வீர்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"பரலோகத்தில் உம்மையல்லாமல் எனக்கு யார் உண்டு?","poem":1},{"lineBreak":true},{"text":"பூலோகத்தில் உம்மைத் தவிர எனக்கு வேறே விருப்பமில்லை.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"என்னுடைய சரீரமும் என்னுடைய இருதயமும் வளர்ச்சியில்லாமல் போகிறது;","poem":1},{"lineBreak":true},{"text":"தேவன் என்றென்றைக்கும் என்னுடைய இருதயத்தின் கன்மலையும்","poem":1},{"lineBreak":true},{"text":"என்னுடைய பங்குமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"இதோ, உம்மைவிட்டுத் தூரமாகப்போகிறவர்கள் நாசமடைவார்கள்;","poem":1},{"lineBreak":true},{"text":"உம்மைவிட்டு உண்மையில்லாமல் போகிற அனைவரையும் அழிப்பீர்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"எனக்கோ, தேவனை அண்டிக்கொண்டிருப்பதே நலம்;","poem":1},{"lineBreak":true},{"text":"நான் உமது செயல்களையெல்லாம் சொல்லிவரும்படி","poem":1},{"lineBreak":true},{"text":"கர்த்தராகிய ஆண்டவர்மேல் என்னுடைய நம்பிக்கையை வைத்திருக்கிறேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}