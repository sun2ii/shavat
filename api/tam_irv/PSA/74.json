{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":74,"content":[{"type":"hebrew_subtitle","content":["ஆசாப் பாடின மஸ்கீல் என்னும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, நீர் எங்களை என்றென்றைக்கும் ஏன் தள்ளிவிடுகிறீர்?","poem":1},{"lineBreak":true},{"text":"உமது மேய்ச்சலின் ஆடுகள்மேல் உமது கோபம் ஏன் புகைகிறது?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நீர் பூர்வகாலத்தில் சம்பாதித்த உமது சபையையும்,","poem":1},{"lineBreak":true},{"text":"நீர் மீட்டுக்கொண்ட உமது சுதந்தரமான கோத்திரத்தையும்,","poem":1},{"lineBreak":true},{"text":"நீர் தங்கியிருந்த சீயோன் மலையையும் நினைத்தருளும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நெடுங்காலமாகப் பாழாகக்கிடக்கிற இடங்களில் உம்முடைய பாதங்களை எழுந்தருளச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"பரிசுத்தஸ்தலத்திலே எதிரி அனைத்தையும் கெடுத்துப்போட்டான்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உம்முடைய எதிரிகள் உம்முடைய ஆலயங்களுக்குள்ளே கெர்ச்சித்து,","poem":1},{"lineBreak":true},{"text":"தங்கள் கொடிகளை அடையாளங்களாக நாட்டுகிறார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"கோடரிகளை ஓங்கிச் சோலையிலே மரங்களை வெட்டுகிறவன் பெயர்பெற்றவனானான்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இப்பொழுதோ அவர்கள் அதின் சித்திரவேலைகள் முழுவதையும் கோடரிகளாலும்,","poem":1},{"lineBreak":true},{"text":"சம்மட்டிகளாலும் தகர்த்துப்போடுகிறார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உமது பரிசுத்த ஸ்தலத்தை அக்கினிக்கு இரையாக்கி,","poem":1},{"lineBreak":true},{"text":"உமது பெயரின் வாசஸ்தலத்தைத் தரைவரை இடித்து,","poem":1},{"lineBreak":true},{"text":"அசுத்தப்படுத்தினார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர்களை ஒன்றாக அழித்துப்போடுவோம் என்று தங்கள் இருதயத்தில் சொல்லி,","poem":1},{"lineBreak":true},{"text":"தேசத்திலுள்ள ஆலயங்களையெல்லாம் சுட்டெரித்துப்போட்டார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எங்களுக்கு இருந்த அடையாளங்களைக் காணோம்;","poem":1},{"lineBreak":true},{"text":"தீர்க்கதரிசியும் இல்லை;","poem":1},{"lineBreak":true},{"text":"இது எதுவரைக்கும் என்று அறிகிறவனும் எங்களிடத்தில் இல்லை.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தேவனே, எதுவரைக்கும் எதிரி நிந்திப்பான்?","poem":1},{"lineBreak":true},{"text":"பகைவன் உமது நாமத்தை எப்பொழுதும் தூஷிப்பானோ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"உமது வலதுகரத்தை ஏன் முடக்கிக்கொள்ளுகிறீர்;","poem":1},{"lineBreak":true},{"text":"அதை உமது மடியிலிருந்து எடுத்து ஓங்கி நிர்மூலமாக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பூமியின் நடுவில் இரட்சிப்புகளைச் செய்துவருகிற","poem":1},{"lineBreak":true},{"text":"தேவன் பூர்வகாலமுதல் என்னுடைய ராஜா.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவனே நீர் உமது வல்லமையினால் சமுத்திரத்தை இரண்டாகப் பிளந்து,","poem":1},{"lineBreak":true},{"text":"தண்ணீரிலுள்ள வலுசர்ப்பங்களின்","poem":1},{"noteId":20},{"text":"தலைகளை உடைத்தீர்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தேவனே நீர் முதலைகளின் தலைகளை நருக்கிப்போட்டு,","poem":1},{"lineBreak":true},{"text":"அதை வனாந்திரத்து மக்களுக்கு உணவாகக் கொடுத்தீர்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஊற்றையும் ஆற்றையும் பிளந்துவிட்டீர்;","poem":1},{"lineBreak":true},{"text":"மகா நதிகளையும் வற்றிப்போகச்செய்தீர்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"பகலும் உம்முடையது, இரவும் உம்முடையது;","poem":1},{"lineBreak":true},{"text":"தேவனே நீர் ஒளியையும் சூரியனையும் படைத்தீர்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"பூமியின் எல்லைகளையெல்லாம் திட்டமிட்டீர்;","poem":1},{"lineBreak":true},{"text":"கோடைக்காலத்தையும் மழைகாலத்தையும் உண்டாக்கினீர்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"யெகோவாவே, எதிரி உம்மை நிந்தித்ததையும்,","poem":1},{"lineBreak":true},{"text":"மதியீன மக்கள் உமது நாமத்தைத் தூஷித்ததையும் நினைத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"உமது காட்டுப்புறாவின் ஆத்துமாவை கொடூர மிருகங்களுடைய கூட்டத்திற்கு ஒப்புக்கொடுக்காமலிரும்;","poem":1},{"lineBreak":true},{"text":"உமது ஏழைகளின் கூட்டத்தை என்றைக்கும் மறக்காமலிரும்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"உம்முடைய உடன்படிக்கையை நினைத்தருளும்;","poem":1},{"lineBreak":true},{"text":"பூமியின் இருளான இடங்கள்","poem":1},{"lineBreak":true},{"text":"கொடுமையுள்ள குடியிருப்புகளால் நிறைந்திருக்கிறதே.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"துன்பப்பட்டவன் வெட்கத்தோடு திரும்பவிடாமலிரும்;","poem":1},{"lineBreak":true},{"text":"சிறுமையும் எளிமையுமானவன் உமது பெயரைத் துதிக்கும்படி செய்யும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"தேவனே, எழுந்தருளும், உமக்காக நீரே வழக்காடும்;","poem":1},{"lineBreak":true},{"text":"மதியீனனாலே தினந்தோறும் உமக்கு வரும் நிந்தையை நினைத்துக்கொள்ளும்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"உம்முடைய எதிரிகளின் ஆரவாரத்தை மறக்காமலிரும்;","poem":1},{"lineBreak":true},{"text":"உமக்கு விரோதமாக எழும்புகிறவர்களின் கூச்சல் எப்பொழுதும் அதிகரிக்கிறது.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"இந்த கடல் பிராணி அனேக தலைகள் கொண்டதாக கருதப்படுகிறது. பார்க்க-சங்கீதம் 104:26, ஏசாயா 27:1","reference":{"chapter":74,"verse":13}}]},"thisChapterLink":"/api/tam_irv/PSA/74.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/75.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/73.json","previousChapterAudioLinks":{},"numberOfVerses":23}