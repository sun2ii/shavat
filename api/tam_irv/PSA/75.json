{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["அல்தஷ்கேத் என்னும் வாத்தியத்தில் வாசிக்கும்படி பாடலின் இசைத்தலைவனுக்கு ஆசாப் அளித்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"உம்மைத் துதிக்கிறோம்,","poem":1},{"lineBreak":true},{"text":"தேவனே, உம்மைத் துதிக்கிறோம்;","poem":1},{"lineBreak":true},{"text":"உமது பெயர் அருகில் இருக்கிறதென்று உமது அதிசயமான செயல்கள் அறிவிக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நியமிக்கப்பட்ட காலத்திலே, யதார்த்தமாக நியாயந்தீர்ப்பேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"பூமியானது அதின் எல்லாக் குடிமக்களோடும் கரைந்துபோகிறது;","poem":1},{"lineBreak":true},{"text":"அதின் தூண்களை நான் நிலைநிறுத்துகிறேன். (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"வீம்புக்காரர்களை நோக்கி, வீம்பு பேசாமலிருங்கள் என்றும்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களை நோக்கி, கொம்பை உயர்த்தாமலிருங்கள் என்றும் சொன்னேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உங்கள் கொம்பை உயரமாக உயர்த்தாமலிருங்கள்;","poem":1},{"lineBreak":true},{"text":"உயர்ந்த கழுத்துடையவர்களாகப் பேசாமலிருங்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"கிழக்கிலும் மேற்கிலும் வனாந்திரதிசையிலுமிருந்து ஜெயம் வராது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவனே நியாயாதிபதி;","poem":1},{"lineBreak":true},{"text":"ஒருவனைத் தாழ்த்தி, ஒருவனை உயர்த்துகிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"கலங்கிப் பொங்குகிற மதுபானத்தினால் நிறைந்த பாத்திரம் யெகோவாவுடைய கையிலிருக்கிறது,","poem":1},{"lineBreak":true},{"text":"அதிலிருந்து ஊற்றுகிறார்;","poem":1},{"lineBreak":true},{"text":"பூமியிலுள்ள துன்மார்க்கர்கள் அனைவரும் அதின் வண்டல்களை உறிஞ்சிக் குடிப்பார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நானோ என்றென்றைக்கும் இதை அறிவித்து,","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் தேவனைக் புகழ்ந்து பாடுவேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுடைய கொம்புகளையெல்லாம் வெட்டிப்போடுவேன்;","poem":1},{"lineBreak":true},{"text":"நீதிமானுடைய கொம்புகளோ உயர்த்தப்படும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}