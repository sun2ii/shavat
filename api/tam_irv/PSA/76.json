{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["அல்தஷ்கேத் என்னும் வாத்தியத்தில் வாசிக்கும்படி பாடலின் இசைத்தலைவனுக்கு ஆசாப் அளித்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யூதாவில் தேவன் அறியப்பட்டவர்;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலில் அவருடைய பெயர் பெரியது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"சாலேமில் அவருடைய கூடாரமும்,","poem":1},{"lineBreak":true},{"text":"சீயோனில் அவருடைய தங்குமிடமும் இருக்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அங்கேயிருந்து வில்லின் அம்புகளையும்,","poem":1},{"lineBreak":true},{"text":"கேடகத்தையும், வாளையும், யுத்தத்தையும் முறித்தார். (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மகத்துவமுள்ளவரே, கொள்ளையுள்ள மலைளைவிட நீர் பிரகாசமுள்ளவர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தைரிய நெஞ்சுள்ளவர்கள் கொள்ளையிடப்பட்டு,","poem":1},{"lineBreak":true},{"text":"உறங்கி அசந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"வல்லமையுள்ள எல்லா மனிதர்களுடைய கைகளும் அவர்களுக்கு உதவாமல்போனது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யாக்கோபின் தேவனே, உம்முடைய அதட்டலின் சத்தத்தினால்","poem":1},{"lineBreak":true},{"text":"இரதங்களும் குதிரைகளும் உறங்கி விழுந்தது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நீர், நீரே, பயங்கரமானவர்;","poem":1},{"lineBreak":true},{"text":"உமது கோபம் எழும்பும்போது உமக்கு முன்பாக நிற்பவன் யார்?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நியாயம் விசாரிக்கவும் பூமியில் சிறுமைப்பட்டவர்கள் யாவரையும் இரட்சிக்கவும்,","poem":1},{"lineBreak":true},{"text":"தேவனே நீர் எழுந்தருளினபோது,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"வானத்திலிருந்து நியாயத்தீர்ப்புக் கேட்கச்செய்தீர்;","poem":1},{"lineBreak":true},{"text":"பூமி பயந்து அமர்ந்தது. (சேலா)","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"மனிதனுடைய கோபம் உமது மகிமையை விளங்கச்செய்யும்;","poem":1},{"lineBreak":true},{"text":"மிஞ்சுங்கோபத்தை நீர் அடக்குவீர்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பொருத்தனைசெய்து அதை உங்கள் தேவனாகிய யெகோவாவுக்கு நிறைவேற்றுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவரைச் சூழ்ந்திருக்கிற அனைவரும் பயங்கரமானவருக்குக் காணிக்கைகளைக் கொண்டுவரவேண்டும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பிரபுக்களின் ஆவியை அடக்குவார்;","poem":1},{"lineBreak":true},{"text":"பூமியின் ராஜாக்களுக்கு அவர் பயங்கரமானவர்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}