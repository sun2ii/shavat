{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["எதுதூன் என்னும் இராகத்தலைவனுக்கு அளிக்கப்பட்ட ஆசாபின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"நான் தேவனை நோக்கி என்னுடைய சத்தத்தை உயர்த்திக் கெஞ்சினேன்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய சத்தத்தை தேவனிடத்தில் உயர்த்தினேன்,","poem":1},{"lineBreak":true},{"text":"அவர் எனக்குச் செவிகொடுத்தார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆபத்துநாளில் ஆண்டவரைத் தேடினேன்;","poem":1},{"lineBreak":true},{"text":"இரவிலும் என்னுடைய கை தளராமல் விரிக்கப்பட்டிருந்தது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா ஆறுதலடையாமல்போனது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் தேவனை நினைத்தபோது அலறினேன்;","poem":1},{"lineBreak":true},{"text":"நான் தியானிக்கும்போது என்னுடைய ஆவி சோர்ந்துபோனது. (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நான் தூங்காதபடி என்னுடைய கண்ணிமைகளைப் பிடித்திருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"நான் பேசமுடியாதபடி கலக்கமடைகிறேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஆரம்பநாட்களையும், ஆரம்பகாலத்து வருடங்களையும் சிந்திக்கிறேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இரவுநேரத்தில் என்னுடைய பாடலை நான் நினைத்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயத்தோடு பேசிக்கொள்ளுகிறேன்;","poem":1},{"lineBreak":true},{"text":"என் ஆவி ஆராய்ச்சிசெய்தது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஆண்டவர் நித்தியகாலமாகத் தள்ளிவிடுவாரோ?","poem":1},{"lineBreak":true},{"text":"இனி ஒருபோதும் தயை செய்யாமலிருப்பாரோ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவருடைய கிருபை முற்றிலும் அற்றுப்போனதோ?","poem":1},{"lineBreak":true},{"text":"வாக்குத்தத்தமானது தலைமுறை தலைமுறைக்கும் ஒழிந்துபோனதோ?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தேவன் இரக்கஞ்செய்ய மறந்தாரோ?","poem":1},{"lineBreak":true},{"text":"கோபத்தினாலே தமது உருக்கமான இரக்கங்களை அடைத்துக்கொண்டாரோ? என்றேன். (சேலா)","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அப்பொழுது நான்: இது என்னுடைய பலவீனம்;","poem":1},{"lineBreak":true},{"text":"ஆனாலும் உன்னதமானவருடைய வலதுகரத்திலுள்ள வருடங்களை நினைவுகூருவேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய செயல்களை நினைவுகூருவேன்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய ஆரம்பகாலத்து அதிசயங்களையே நினைவுகூருவேன்;","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உம்முடைய கிரியைகளையெல்லாம் தியானித்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய செயல்களை யோசிப்பேன் என்றேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தேவனே, உமது வழி பரிசுத்த ஸ்தலத்திலுள்ளது;","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேவனைப்போலப் பெரிய தேவன் யார்?","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அதிசயங்களைச் செய்கிற தேவன் நீரே;","poem":1},{"lineBreak":true},{"text":"மக்களுக்குள்ளே உம்முடைய வல்லமையை விளங்கச்செய்தீர்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"யாக்கோபு யோசேப்பு என்பவர்களின் சந்ததியாகிய உம்முடைய மக்களை,","poem":1},{"lineBreak":true},{"text":"உமது வல்லமையினாலே மீட்டுக்கொண்டீர். (சேலா)","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"தண்ணீர்கள் உம்மைக் கண்டது; தேவனே,","poem":1},{"lineBreak":true},{"text":"தண்ணீர்கள் உம்மைக் கண்டு தத்தளித்தது;","poem":1},{"lineBreak":true},{"text":"ஆழங்களும் கலங்கினது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"மேகங்கள் தண்ணீர்களைப் பொழிந்தது;","poem":1},{"lineBreak":true},{"text":"ஆகாயமண்டலங்கள் முழக்கமிட்டது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய அம்புகளும் தெறிப்புண்டு பறந்தது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"உம்முடைய குமுறலின் சத்தம் சுழல்காற்றில் முழங்கினது;","poem":1},{"lineBreak":true},{"text":"மின்னல்கள் உலகை பிரகாசிக்கச் செய்தது; பூமி குலுங்கி அதிர்ந்தது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"உமது வழி கடலிலும், உமது பாதைகள் திரண்ட தண்ணீர்களிலும் இருந்தது;","poem":1},{"lineBreak":true},{"text":"உமது காலடிகள் தெரியப்படாமல்போனது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"மோசே ஆரோன் என்பவர்களின் கையால்,","poem":1},{"lineBreak":true},{"text":"உமது மக்களை ஒரு ஆட்டு மந்தையைப்போல வழிநடத்தினீர்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}