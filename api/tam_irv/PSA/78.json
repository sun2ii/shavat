{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் மஸ்கீல் என்னும் போதகப் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என் மக்களே, என்னுடைய உபதேசத்தைக் கேளுங்கள்;","poem":1},{"lineBreak":true},{"text":"என் வாயின் வார்த்தைகளுக்கு உங்களுடைய செவிகளைச் சாயுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய வாயை உவமைகளால் திறப்பேன்;","poem":1},{"lineBreak":true},{"text":"ஆரம்ப காலத்தின் மறைபொருட்களை வெளிப்படுத்துவேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவைகளை நாங்கள் கேள்விப்பட்டு அறிந்தோம்;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய முன்னோர்கள் அவைகளை எங்களுக்குத் தெரிவித்தார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"பின்வரும் சந்ததியான பிள்ளைகளுக்கு நாங்கள் அவைகளை மறைக்காமல்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவின் துதிகளையும் அவருடைய பலத்தையும்,","poem":1},{"lineBreak":true},{"text":"அவர் செய்த அவருடைய அதிசயங்களையும் விவரிப்போம்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர் யாக்கோபிலே சாட்சியை ஏற்படுத்தி,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலிலே வேதத்தை நிறுவி,","poem":1},{"lineBreak":true},{"text":"அவைகளைத் தங்களுடைய பிள்ளைகளுக்கு அறிவிக்கும்படி","poem":1},{"lineBreak":true},{"text":"நம்முடைய முற்பிதாக்களுக்குக் கட்டளையிட்டார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இனிப் பிறக்கும் பிள்ளைகளாகிய பின்சந்ததியார் அதை அறிந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"அவர்கள் எழும்பித் தங்களுடைய பிள்ளைகளுக்கு அவைகளைச் சொல்லும்படிக்கும்;","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவன்மேல் அவர்கள் தங்களுடைய நம்பிக்கையை வைத்து,","poem":1},{"lineBreak":true},{"text":"தேவனுடைய செயல்களை மறக்காமல், அவர் கற்பனைகளைக் கைக்கொள்ளும்படிக்கும்;","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"இருதயத்தைச் செவ்வைப்படுத்தாமலும்,","poem":1},{"lineBreak":true},{"text":"தேவனை உறுதியாகப் பற்றிக்கொள்ளாமலும் இருந்த முரட்டாட்டமும் கலகமுமுள்ள சந்ததியாகிய","poem":1},{"lineBreak":true},{"text":"தங்களுடைய பிதாக்களுக்கு அவர்கள் ஒப்பாகாதபடிக்கும், இவைகளைக் கட்டளையிட்டார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஆயுதமணிந்த வில்வீரர்களான எப்பிராயீமீர்கள்","poem":1},{"lineBreak":true},{"text":"யுத்தநாளிலே முதுகு காட்டினார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்கள் தேவனுடைய உடன்படிக்கையைக் கைக்கொள்ளாமலும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய கட்டளைகளின்படி நடக்கச் சம்மதிக்காமலும்,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவருடைய செயல்களையும்,","poem":1},{"lineBreak":true},{"text":"அவர் தங்களுக்குக் காண்பித்த அதிசயங்களையும் மறந்தார்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அவர்களுடைய முன்னோர்களுக்கு முன்பாக, எகிப்து தேசத்துச் சோவான் வெளியிலே,","poem":1},{"lineBreak":true},{"text":"அவர் அதிசயமானவைகளைச் செய்தார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"கடலைப் பிளந்து, அவர்களைக் கடக்கச்செய்து,","poem":1},{"lineBreak":true},{"text":"தண்ணீரைக் குவியலாக நிற்கும்படிச் செய்தார்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"பகலிலே மேகத்தினாலும்,","poem":1},{"lineBreak":true},{"text":"இரவுமுழுவதும் அக்கினி வெளிச்சத்தினாலும் அவர்களை வழிநடத்தினார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"பாலைவனத்திலே கன்மலைகளைப் பிளந்து,","poem":1},{"lineBreak":true},{"text":"மகா ஆழங்களிலிருந்து தண்ணீரை அவர்களுக்குக் குடிக்கக் கொடுத்தார்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"கன்மலையிலிருந்து நீரோட்டங்களைப் புறப்படச்செய்து,","poem":1},{"lineBreak":true},{"text":"தண்ணீரை நதிபோல ஓடிவரும்படி செய்தார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என்றாலும், அவர்கள் பின்னும் அவருக்கு விரோதமாகப் பாவஞ்செய்து,","poem":1},{"lineBreak":true},{"text":"பாலைவனத்திலே உன்னதமான தேவனுக்குக் கோபம் மூட்டினார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"தங்களுடைய ஆசைக்கேற்ற உணவைக்கேட்டு,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய இருதயத்தில் தேவனைப் பரீட்சைபார்த்தார்கள்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அவர்கள் தேவனுக்கு விரோதமாகப் பேசி:","poem":1},{"lineBreak":true},{"text":"தேவன் பாலைவனத்திலே உணவுப்பந்தியை ஆயத்தப்படுத்தக்கூடுமோ?","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"இதோ அவர் கன்மலையை அடித்ததினால் தண்ணீர் புறப்பட்டு, நதிகளாகப் புரண்டுவந்தது;","poem":1},{"lineBreak":true},{"text":"அவர் அப்பத்தையும் கொடுக்கமுடியுமோ?","poem":1},{"lineBreak":true},{"text":"தம்முடைய மக்களுக்கு இறைச்சியையும் ஆயத்தப்படுத்துவாரோ என்றார்கள்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"ஆகையால் யெகோவா அதைக் கேட்டுக் கோபங்கொண்டார்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் தேவனை விசுவாசிக்காமலும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய இரட்சிப்பை நம்பாமலும் போனதினால்,","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யாக்கோபுக்கு விரோதமாக நெருப்பு பற்றியெரிந்தது;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலுக்கு விரோதமாகக் கோபம் மூண்டது.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவர் உயரத்திலுள்ள மேகங்களுக்குக் கட்டளையிட்டு,","poem":1},{"lineBreak":true},{"text":"வானத்தின் கதவுகளைத் திறந்து,","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"மன்னாவை அவர்களுக்கு ஆகாரமாகப் பெய்யச்செய்து,","poem":1},{"lineBreak":true},{"text":"வானத்தின் தானியத்தை அவர்களுக்குக் கொடுத்தார்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"தூதர்களின் அப்பத்தை மனிதன் சாப்பிட்டான்;","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு ஆகாரத்தைப் பூரணமாக அனுப்பினார்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"வானத்திலே கிழக்கு காற்றை வீசச்செய்து,","poem":1},{"lineBreak":true},{"text":"தம்முடைய வல்லமையினால் தென்றலையும் வீசச்செய்து,","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"இறைச்சியை தூளைப்போலவும், சிறகுள்ள பறவைகளைக் கடற்கரை மணலளவாகவும் பெய்யச்செய்து,","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"அவைகளை அவர்கள் முகாமின் நடுவிலும், அவர்கள் கூடாரங்களைச் சுற்றிலும் இறங்கச்செய்தார்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அவர்கள் சாப்பிட்டு திருப்தியடைந்தார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் ஆசைப்பட்டதை அவர்களுக்குக் கொடுத்தார்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அவர்கள் தங்களுடைய ஆசையை வெறுக்கவில்லை;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய உணவு அவர்களுடைய வாயில் இருக்கும்போதே.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"தேவகோபம் அவர்கள்மேல் எழும்பி,","poem":1},{"lineBreak":true},{"text":"அவர்களில் கொழுத்தவர்களை அழித்து, இஸ்ரவேலில் வாலிபர்களை விழச்செய்தார்.","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"இவையெல்லாம் நடந்தும், அவர் செய்த அதிசயங்களை அவர்கள் நம்பாமல்,","poem":1},{"lineBreak":true},{"text":"பின்னும் பாவஞ்செய்தார்கள்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ஆதலால் அவர்கள் நாட்களை வீணாகவும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் வருடங்களைப் பயங்கரத்திலும் கழியச்செய்தார்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"அவர்களை அவர் கொல்லும்போது அவரைக்குறித்து விசாரித்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் திரும்பிவந்து தேவனை அதிகாலமே தேடி;","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"தேவன் தங்களுடைய கன்மலையென்றும்,","poem":1},{"lineBreak":true},{"text":"உன்னதமான தேவன் தங்களுடைய மீட்பர் என்றும், நினைவுகூர்ந்தார்கள்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"ஆனாலும் அவர்கள் தங்களுடைய வாயினால் அவருக்கு வஞ்சகம் பேசி,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய நாவினால் அவரிடத்தில் பொய்சொன்னார்கள்.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"அவர்களுடைய இருதயம் அவரிடத்தில் நிலைவரப்படவில்லை;","poem":1},{"lineBreak":true},{"text":"அவருடைய உடன்படிக்கையில் அவர்கள் உண்மையாக இருக்கவில்லை.","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"அவரோ அவர்களை அழிக்காமல், இரக்கமுள்ளவராக அவர்கள் அக்கிரமத்தை மன்னித்தார்;","poem":1},{"lineBreak":true},{"text":"அவர் தமது கடுங்கோபம் முழுவதையும் எழுப்பாமல்,","poem":1},{"lineBreak":true},{"text":"அநேகமுறை தமது கோபத்தை விலக்கிவிட்டார்.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"அவர்கள் மாம்சமென்றும், திரும்பிவராமல் அகலுகிற காற்றென்றும் நினைவுகூர்ந்தார்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"எத்தனைமுறையோ பாலைவனத்திலே அவருக்குக் கோபமூட்டி,","poem":1},{"lineBreak":true},{"text":"பாலைவனத்திலே அவரை வேதனைப்படுத்தினார்கள்.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"அவர்கள் திரும்பி தேவனைப் பரீட்சை பார்த்து,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் பரிசுத்த தேவனை எரிச்சலூட்டினார்கள்.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"அவருடைய கரத்தையும், அவர் தங்களை எதிரிகளுக்கு விலக்கி மீட்ட நாளையும் நினைக்காமல் போனார்கள்.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"அவர் எகிப்திலே தம்முடைய அடையாளங்களையும்,","poem":1},{"lineBreak":true},{"text":"சோவான் வெளியிலே தம்முடைய அற்புதங்களையும் செய்தார்.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"அவர்களுடைய நதிகளை இரத்தமாக மாற்றி, அவர்களுடைய","poem":1},{"lineBreak":true},{"text":"ஆறுகளிலுள்ள தண்ணீரைக் குடிக்கமுடியாதபடி செய்தார்.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"அவர்களை அழிக்கும்படி வண்டு வகைகளையும்,","poem":1},{"lineBreak":true},{"text":"அவர்களைக் கெடுக்கும்படி தவளைகளையும் அவர்களுக்குள்ளே அனுப்பினார்.","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"அவர்களுடைய விளைச்சலைப் புழுக்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய உழைப்பின் பலனை வெட்டுக்கிளிகளுக்கும் கொடுத்தார்.","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"கல்மழையினால் அவர்களுடைய திராட்சைச்செடிகளையும்,","poem":1},{"lineBreak":true},{"text":"ஆலாங்கட்டியினால் அவர்களுடைய அத்திமரங்களையும் அழித்து,","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"அவர்களுடைய மிருகங்களைக் கல்மழைக்கும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய ஆடுமாடுகளை இடிகளுக்கும் ஒப்புக்கொடுத்தார்.","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"தமது கடுமையான கோபத்தையும், மூர்க்கத்தையும்,","poem":1},{"lineBreak":true},{"text":"பிரச்சனையையும், உபத்திரவத்தையும், தீங்குசெய்யும் தூதர்களையும் அவர்களுக்குள்ளே அனுப்பினார்.","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"அவர் தம்முடைய கோபத்திற்கு வழிதிறந்து, அவர்களுடைய ஆத்துமாவை மரணத்திற்கு விலக்கிக் காக்காமல்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் உயிரைக் கொள்ளைநோய்க்கு ஒப்புக்கொடுத்தார்.","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"எகிப்திலே முதற்பிறந்த பிள்ளைகள் அனைத்தையும்,","poem":1},{"lineBreak":true},{"text":"காமின்","poem":1},{"noteId":21},{"text":"கூடாரங்களிலே அவர்களுடைய பெலனில் முதற்பிறந்த எல்லோரையும் அழித்து;","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"தம்முடைய மக்களை ஆடுகளைப்போல் புறப்படச்செய்து,","poem":1},{"lineBreak":true},{"text":"அவர்களை வனாந்திரத்திலே மந்தையைப்போல் கூட்டிக்கொண்டுபோய்;","poem":1}]},{"type":"verse","number":53,"content":[{"lineBreak":true},{"text":"அவர்கள் பயப்படாதபடிக்கு அவர்களைப் பத்திரமாக வழிநடத்தினார்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் எதிரிகளைக் கடல் மூடிப்போட்டது.","poem":1}]},{"type":"verse","number":54,"content":[{"lineBreak":true},{"text":"அவர்களைத் தமது பரிசுத்த ஸ்தலத்தின் எல்லைவரைக்கும்,","poem":1},{"lineBreak":true},{"text":"தமது வலதுகரம் சம்பாதித்த இந்த மலைவரைக்கும் அழைத்துக்கொண்டுவந்து,","poem":1}]},{"type":"verse","number":55,"content":[{"lineBreak":true},{"text":"அவர்கள் முகத்திற்கு முன்பாக தேசங்களைத் துரத்திவிட்டு,","poem":1},{"lineBreak":true},{"text":"தேசத்தை நூல்போட்டுப் பங்கிட்டு,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய கூடாரங்களில் இஸ்ரவேலின் கோத்திரங்களைக் குடியேற்றினார்.","poem":1}]},{"type":"verse","number":56,"content":[{"lineBreak":true},{"text":"ஆனாலும் அவர்கள் உன்னதமான தேவனைப் பரீட்சை பார்த்து,","poem":1},{"lineBreak":true},{"text":"அவருக்குக் கோபம் மூட்டி, அவருடைய சாட்சிகளைக் கைக்கொள்ளாமல்போய்,","poem":1}]},{"type":"verse","number":57,"content":[{"lineBreak":true},{"text":"தங்களுடைய முன்னோர்களைப்போல வழிவிலகி,","poem":1},{"lineBreak":true},{"text":"துரோகம்செய்து, மோசம்போக்கும் வில்லைப்போல் துவண்டு,","poem":1}]},{"type":"verse","number":58,"content":[{"lineBreak":true},{"text":"தங்களுடைய மேடைகளினால் அவருக்குக் கோபம் மூட்டி,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய விக்கிரகங்களினால் எரிச்சல் உண்டாக்கினார்கள்.","poem":1}]},{"type":"verse","number":59,"content":[{"lineBreak":true},{"text":"தேவன் அதைக் கேட்டு கடுங்கோபமடைந்து,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலை மிகவும் வெறுத்து,","poem":1}]},{"type":"verse","number":60,"content":[{"lineBreak":true},{"text":"தாம் மனிதர்களுக்குள்ளே போட்ட கூடாரமாகிய சீலோவிலுள்ள","poem":1},{"noteId":22},{"text":"வாசஸ்தலத்தை விட்டுவிலகி,","poem":1}]},{"type":"verse","number":61,"content":[{"lineBreak":true},{"text":"தமது பலமாகிய இஸ்ரவேலர்களை சிறையிருப்புக்கும், தமது மகிமையான தம் ஜனத்தை எதிரியின் கைக்கும் ஒப்புக்கொடுத்து,","poem":1}]},{"type":"verse","number":62,"content":[{"lineBreak":true},{"text":"தமது மக்களை வாளுக்கு இரையாக்கி, தமது சுதந்தரத்தின்மேல் கோபங்கொண்டார்.","poem":1}]},{"type":"verse","number":63,"content":[{"lineBreak":true},{"text":"அவர்கள் வாலிபர்களை நெருப்பு எரித்தது,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய கன்னிப்பெண்கள் வாழ்க்கைப்படாமலிருந்தார்கள்.","poem":1}]},{"type":"verse","number":64,"content":[{"lineBreak":true},{"text":"அவர்களுடைய ஆசாரியர்கள் வாளால் விழுந்தார்கள்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய விதவைகள் அழவில்லை.","poem":1}]},{"type":"verse","number":65,"content":[{"lineBreak":true},{"text":"அப்பொழுது ஆண்டவர் தூக்கம் தெளிந்தவனைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"திராட்சைரசத்தால் கெம்பீரிக்கிற பலசாலியைப்போலவும் விழித்து,","poem":1}]},{"type":"verse","number":66,"content":[{"lineBreak":true},{"text":"தம்முடைய எதிரிகளைப் பின்புறமாக அடித்து,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு நித்திய நிந்தையை வரச்செய்தார்.","poem":1}]},{"type":"verse","number":67,"content":[{"lineBreak":true},{"text":"அவர் யோசேப்பின் கூடாரத்தைப் புறக்கணித்தார்;","poem":1},{"lineBreak":true},{"text":"எப்பிராயீம் கோத்திரத்தை அவர் தெரிந்துகொள்ளாமல்,","poem":1}]},{"type":"verse","number":68,"content":[{"lineBreak":true},{"text":"யூதா கோத்திரத்தையும் தமக்குப் பிரியமான சீயோன் மலையையும் தெரிந்துகொண்டார்.","poem":1}]},{"type":"verse","number":69,"content":[{"lineBreak":true},{"text":"தம்முடைய பரிசுத்த ஸ்தலத்தை மலைகளைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"என்றைக்கும் நிற்கும்படி தாம் அஸ்திபாரப்படுத்தின பூமியைப்போலவும் கட்டினார்.","poem":1}]},{"type":"verse","number":70,"content":[{"lineBreak":true},{"text":"தம்முடைய ஊழியனாகிய தாவீதைத் தெரிந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"ஆட்டுத்தொழுவங்களிலிருந்து அவனை எடுத்தார்.","poem":1}]},{"type":"verse","number":71,"content":[{"lineBreak":true},{"text":"கறவலாடுகளின் பின்னாகத் திரிந்த அவனை,","poem":1},{"lineBreak":true},{"text":"தம்முடைய மக்களாகிய யாக்கோபையும்","poem":1},{"lineBreak":true},{"text":"தம்முடைய சுதந்தரமாகிய இஸ்ரவேலையும் மேய்ப்பதற்காக,","poem":1},{"lineBreak":true},{"text":"அழைத்துக்கொண்டுவந்தார்.","poem":1}]},{"type":"verse","number":72,"content":[{"lineBreak":true},{"text":"இவன் அவர்களைத் தன்னுடைய இருதயத்தின் உண்மையின்படியே மேய்த்து,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கைகளின் திறமையினால் அவர்களை நடத்தினான்.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"காமின் எகிப்து தேசத்தை குறிக்கிறது. காம் நோவாவின் குமாரன், எகிப்தின் மூதாதையர் என்று ஆதியாகமம் 10:6 ல் சொல்லியிருக்கிறது","reference":{"chapter":78,"verse":51}},{"noteId":22,"caller":"+","text":"சீலொவோம் எருசலேமின் வடக்கே 32 கிமீ தூரத்தில் இருக்கிறது. இஸ்ரவேலின் ஆரம்ப நாட்களில் தேவனுடைய உடன்பட்டிக்கைபெட்டி சீலோவோமில் வைக்கப்பட்டிருந்தது.","reference":{"chapter":78,"verse":60}}]},"thisChapterLink":"/api/tam_irv/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}