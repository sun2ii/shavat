{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் துதிப் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, அன்னிய தேசத்தார்கள் உமது சுதந்தரத்தில் வந்து,","poem":1},{"lineBreak":true},{"text":"உமது பரிசுத்த ஆலயத்தைத் தீட்டுப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"எருசலேமை மண்மேடுகளாக்கினார்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உமது ஊழியக்காரர்களின் பிரேதங்களை வானத்துப் பறவைகளுக்கும்,","poem":1},{"lineBreak":true},{"text":"உமது பரிசுத்தவான்களின் சரீரத்தைப் பூமியின் மிருகங்களுக்கும் இரையாகக் கொடுத்தார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"எருசலேமைச் சுற்றிலும் அவர்களுடைய இரத்தத்தை தண்ணீரைப்போலச் சிந்தினார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களை அடக்கம்செய்பவருமில்லை.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"எங்களுடைய அயலாருக்கு நிந்தையும்,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய சுற்றுப்புறத்தாருக்கு இகழ்ச்சியும், நகைப்புமானோம்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"எதுவரைக்கும் யெகோவாவே! நீர் என்றைக்கும் கோபமாக இருப்பீரோ?","poem":1},{"lineBreak":true},{"text":"உம்முடைய எரிச்சல் நெருப்பைப்போல் எரியுமோ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உம்மை அறியாத தேசங்கள் மேலும்,","poem":1},{"lineBreak":true},{"text":"உமது பெயரை தொழுதுகொள்ளாத ராஜ்ஜியங்கள் மேலும்,","poem":1},{"lineBreak":true},{"text":"உம்முடைய கடுங்கோபத்தை ஊற்றிவிடும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர்கள் யாக்கோபை அழித்து,","poem":1},{"lineBreak":true},{"text":"அவன் குடியிருப்பைப் பாழாக்கினார்களே.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"முன்னோர்களுடைய அக்கிரமங்களை எங்களுக்கு விரோதமாக நினையாமலிரும்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய இரக்கங்கள் சீக்கிரமாக எங்களுக்கு நேரிடுவதாக;","poem":1},{"lineBreak":true},{"text":"நாங்கள் மிகவும் தாழ்த்தப்பட்டுப்போனோம்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எங்களை இரட்சிக்கும் தேவனே, நீர் உமது பெயரின் மகிமைக்காக எங்களுக்கு உதவிசெய்து,","poem":1},{"lineBreak":true},{"text":"உமது பெயருக்காக எங்களை விடுவித்து,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய பாவங்களை மன்னியும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அவர்களுடைய தேவன் எங்கே என்று அன்னியதேசத்தார் சொல்வானேன்?","poem":1},{"lineBreak":true},{"text":"உமது ஊழியக்காரர்களுடைய சிந்தப்பட்ட இரத்தத்தின் பழிவாங்குதல்","poem":1},{"lineBreak":true},{"text":"தேசங்களுக்குள்ளே எங்களுடைய கண்களுக்கு முன்பாக விளங்கும்படி செய்யும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"கட்டுண்டவனுடைய பெருமூச்சு உமக்கு முன்பாக வரட்டும்;","poem":1},{"lineBreak":true},{"text":"கொலைக்கு நியமிக்கப்பட்டவர்களை உமது கரத்தினால் உயிரோடு காத்தருளும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, எங்களுடைய அயலார் உம்மை நிந்தித்த நிந்தையை,","poem":1},{"lineBreak":true},{"text":"ஏழு மடங்காக அவர்களுடைய மடியிலே திரும்பச்செய்யும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அப்பொழுது, உம்முடைய மக்களும் உம்முடைய மேய்ச்சலின் ஆடுகளுமாகிய நாங்கள் உம்மை என்றென்றைக்கும் புகழுவோம்;","poem":1},{"lineBreak":true},{"text":"தலைமுறை தலைமுறையாக உமது துதியைச் சொல்லிவருவோம்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}