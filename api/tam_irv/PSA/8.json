{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["கித்தீத் என்ற இசைக் கருவியில் வாசிக்க இராகத் தலைவனுக்குத் தந்த தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"எங்கள் ஆண்டவராகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பெயர் பூமியெங்கும் எவ்வளவு மேன்மையுள்ளதாக இருக்கிறது!","poem":1},{"lineBreak":true},{"text":"உம்முடைய மகத்துவத்தை வானங்களுக்கு மேலாக வைத்தீர்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"விரோதியையும், பழிகாரனையும் அடக்கிப்போட,","poem":1},{"lineBreak":true},{"text":"தேவனே நீர் உம்முடைய எதிரிகளுக்காக குழந்தைகள் பாலகர்கள் வாயினால் பெலன் உண்டாக்கினீர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உமது விரல்களின் செயல்களாகிய உம்முடைய வானங்களையும்,","poem":1},{"lineBreak":true},{"text":"நீர் அமைத்த சந்திரனையும் நட்சத்திரங்களையும் நான் பார்க்கும்போது,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"மனிதனை நீர் நினைக்கிறதற்கும்,","poem":1},{"lineBreak":true},{"text":"மனுக்குலத்தை நீர் விசாரிக்கிறதற்கும் அவன் எம்மாத்திரம் என்கிறேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நீர் அவனைத் தேவதூதரிலும் சற்றுச் சிறியவனாக்கினீர்;","poem":1},{"lineBreak":true},{"text":"மகிமையினாலும், மரியாதையினாலும் அவனை முடிசூட்டினீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உம்முடைய கைகளின் செயல்களின்மேல் நீர் அவனுக்கு ஆளுகை தந்து.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஆடுமாடுகள் எல்லாவற்றையும், காட்டுமிருகங்களையும்,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆகாயத்துப் பறவைகளையும்,","poem":1},{"lineBreak":true},{"text":"கடலின் மீன்களையும், கடல்களில் வாழ்கிறவைகளையும் அவனுடைய பாதங்களுக்குக் கீழ்ப்படுத்தினீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எங்கள் ஆண்டவராகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பெயர் பூமியெங்கும் எவ்வளவு மேன்மையுள்ளதாக இருக்கிறது!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}