{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["எடூத் என்னும் வாத்தியத்தில் வாசிக்க இராகத்தலைவனுக்கு ஒப்புவிக்கப்பட்ட ஆசாபின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"இஸ்ரவேலின் மேய்ப்பரே,","poem":1},{"lineBreak":true},{"text":"யோசேப்பை ஆட்டுமந்தையைப்போல் நடத்துகிறவரே,","poem":1},{"lineBreak":true},{"text":"செவிகொடும்; கேருபீன்கள் மத்தியில் தங்குகிறவரே, பிரகாசியும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எப்பிராயீம் பென்யமீன் மனாசே என்பவர்களுக்கு முன்பாக, நீர் உமது வல்லமையை எழுப்பி,","poem":1},{"lineBreak":true},{"text":"எங்களைக் காப்பாற்ற வந்தருளும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேவனே, எங்களைத் திருப்பிக் கொண்டுவாரும்,","poem":1},{"lineBreak":true},{"text":"உமது முகத்தைப் பிரகாசிக்கச்செய்யும்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது இரட்சிக்கப்படுவோம்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"சேனைகளின் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உமது மக்களின் விண்ணப்பத்திற்கு விரோதமாக நீர்","poem":1},{"lineBreak":true},{"text":"எதுவரைக்கும் கோபங்கொள்வீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"கண்ணீராகிய அப்பத்தை அவர்களுக்கு உணவாகவும்,","poem":1},{"lineBreak":true},{"text":"மிகுதியான கண்ணீரையே அவர்களுக்குப் பானமாகவும் கொடுத்தீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"எங்களுடைய அயலாருக்கு எங்களை வழக்காக வைக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய எதிரிகள் எங்களைக் கேலிசெய்கிறார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"சேனைகளின் தேவனே, எங்களைத் திருப்பிக்கொண்டுவாரும்,","poem":1},{"lineBreak":true},{"text":"உமது முகத்தைப் பிரகாசிக்கச்செய்யும்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது இரட்சிக்கப்படுவோம்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நீர் எகிப்திலிருந்து ஒரு திராட்சைக்கொடியைக் கொண்டுவந்து,","poem":1},{"lineBreak":true},{"text":"தேசங்களைத் துரத்திவிட்டு, அதை நாட்டினீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அதற்கு இடத்தை ஆயத்தப்படுத்தினீர்;","poem":1},{"lineBreak":true},{"text":"அது வேரூன்றி, தேசமெங்கும் படர்ந்தது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அதின் நிழலால் மலைகளும் அதின் கிளைகளால் உயர்ந்து வளர்ந்த கேதுருக்களும் மூடப்பட்டது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அது தன்னுடைய கொடிகளைக் மத்திய தரைக் கடல்வரைக்கும்,","poem":1},{"lineBreak":true},{"text":"தன்னுடைய கிளைகளை ஆறுவரைக்கும் படரவிட்டது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"இப்பொழுதோ வழிநடக்கிற அனைவரும் அதைப் பறிக்கும்படியாக,","poem":1},{"lineBreak":true},{"text":"அதின் அடைப்புகளை ஏன் தகர்த்துப்போட்டீர்?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"காட்டுப்பன்றி அதை உழுதுபோடுகிறது,","poem":1},{"lineBreak":true},{"text":"வெளியின் மிருகங்கள் அதை மேய்ந்துபோடுகிறது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"சேனைகளின் தேவனே, திரும்பி வாரும், வானத்திலிருந்து கண்ணோக்கிப்பார்த்து,","poem":1},{"lineBreak":true},{"text":"இந்தத் திராட்சைச்செடியை விசாரித்தருளும்;","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"உம்முடைய வலதுகரம் ஊன்றிய கொடியையும்,","poem":1},{"lineBreak":true},{"text":"உமக்கு நீர் திடப்படுத்தின கிளையையும் பாதுகாத்தருளும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அது நெருப்பால் சுடப்பட்டும் வெட்டப்பட்டும் போனது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய முகத்தின் பயமுறுத்தலால் அழிந்துபோகிறார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"உமது கரம் உமது வலதுபக்கத்து மனிதன்மீதிலும்,","poem":1},{"lineBreak":true},{"text":"உமக்கு நீர் திடப்படுத்தின மனிதகுமாரன் மீதிலும் இருப்பதாக.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அப்பொழுது உம்மைவிட்டுப் பின்வாங்கமாட்டோம்;","poem":1},{"lineBreak":true},{"text":"எங்களை உயிர்ப்பியும், அப்பொழுது உமது பெயரைத் தொழுதுகொள்ளுவோம்.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"சேனைகளின் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"எங்களைத் திருப்பிக்கொண்டு வாரும்;","poem":1},{"lineBreak":true},{"text":"உமது முகத்தைப் பிரகாசிக்கச்செய்யும்,","poem":1},{"lineBreak":true},{"text":"அப்பொழுது இரட்சிக்கப்படுவோம்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}