{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["கித்தீத் என்னும் இசைக்கருவியை வாசிக்கும் இராகத் தலைவனுக்கு ஆசாப் அளித்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"நம்முடைய பெலனாகிய தேவனைக் கெம்பீரமாகப் பாடி,","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் தேவனைக்குறித்து ஆர்ப்பரியுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"தம்புரு வாசித்து, வீணையையும் இனிய ஓசையான சுரமண்டலத்தையும் எடுத்து,","poem":1},{"lineBreak":true},{"text":"பாட்டு பாடுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மாதப்பிறப்பிலும், நியமித்தகாலத்திலும்,","poem":1},{"lineBreak":true},{"text":"நம்முடைய பண்டிகைநாட்களிலும், எக்காளம் ஊதுங்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"இது இஸ்ரவேலுக்குப் ஆணையும்,","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் தேவன் விதித்த கட்டளையுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நாம் அறியாத மொழியைக்கேட்ட எகிப்துதேசத்தைவிட்டுப் புறப்படும்போது,","poem":1},{"lineBreak":true},{"text":"இதை யோசேப்பிலே சாட்சியாக ஏற்படுத்தினார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவனுடைய தோளைச் சுமைக்கு விலக்கினேன்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய கைகள் கூடைக்கு விடுவிக்கப்பட்டது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நெருக்கத்திலே நீ கூப்பிட்டாய், நான் உன்னைத் தப்புவித்தேன்;","poem":1},{"lineBreak":true},{"text":"இடிமுழக்கம் உண்டாகும் மறைவிடத்திலிருந்து உனக்கு உத்திரவு அருளினேன்;","poem":1},{"lineBreak":true},{"text":"மேரிபாவின் தண்ணீர்கள் அருகில் உன்னைச் சோதித்து அறிந்தேன். (சேலா)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"என்னுடைய மக்களே கேள், உனக்குச் சாட்சியிட்டுச் சொல்லுவேன்;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலே, நீ எனக்குச் செவிகொடுத்தால் நலமாக இருக்கும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உனக்குள் வேறு தேவன் உண்டாயிருக்கவேண்டாம்;","poem":1},{"lineBreak":true},{"text":"அந்நிய தேவனை நீ வணங்கவும் வேண்டாம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உன்னை எகிப்து தேசத்திலிருந்து புறப்படச்செய்த உன்னுடைய தேவனாகிய யெகோவா நானே;","poem":1},{"lineBreak":true},{"text":"உன்னுடைய வாயை விரிவாகத் திற, நான் அதை நிரப்புவேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னுடைய மக்களோ என்னுடைய சத்தத்திற்குச் செவிகொடுக்கவில்லை;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேல் என்னை விரும்பவில்லை.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ஆகையால் அவர்களை அவர்கள் இருதயத்தின் கடினத்திற்கு விட்டுவிட்டேன்;","poem":1},{"lineBreak":true},{"text":"தங்களுடைய யோசனைகளின்படியே நடந்தார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"ஆ, என்னுடைய மக்கள் எனக்குச் செவிகொடுத்து,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேல் என்னுடைய வழிகளில் நடந்தால் நலமாக இருக்கும்!","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நான் சீக்கிரத்தில் அவர்களுடைய எதிராளிகளைத் தாழ்த்தி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கையை அவர்கள் எதிரிகளுக்கு விரோதமாகத் திருப்புவேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அப்பொழுது யெகோவாவைப் பகைக்கிறவர்கள் அவருக்கு வஞ்சகம் பேசி அடங்குவார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய காலம் என்றென்றைக்கும் இருக்கும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"செழுமையான கோதுமையினால் அவர்களுக்கு உணவளிப்பார்;","poem":1},{"lineBreak":true},{"text":"கன்மலையின் தேனினால் உன்னைத் திருப்தியாக்குவேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}