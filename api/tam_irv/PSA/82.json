{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவசபையிலே தேவன் எழுந்தருளியிருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"தெய்வங்களின் நடுவிலே அவர் நியாயம் விசாரிக்கிறார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எதுவரைக்கும் நீங்கள் அநியாயத் தீர்ப்புச்செய்து,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களுக்கு முகதாட்சிணியம் செய்வீர்கள். (சேலா)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ஏழைக்கும் திக்கற்றபிள்ளைக்கும் நியாயஞ்செய்து,","poem":1},{"lineBreak":true},{"text":"சிறுமைப்பட்டவனுக்கும் திக்கற்றவனுக்கும் நீதி செய்யுங்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"பலவீனனையும் எளியவனையும் விடுவித்து,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களின் கைக்கு அவர்களைத் தப்புவியுங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அறியாமலும் உணராமலும் இருக்கிறார்கள்,","poem":1},{"lineBreak":true},{"text":"இருளிலே நடக்கிறார்கள்; தேசத்தின் அஸ்திபாரங்களெல்லாம் அசைகிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீங்கள் தெய்வங்கள் என்றும்,","poem":1},{"lineBreak":true},{"text":"நீங்களெல்லோரும் உன்னதமான தேவனுடைய மக்கள் என்றும் நான் சொல்லியிருந்தேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஆனாலும் நீங்கள் மனிதர்களைப்போலச் செத்து,","poem":1},{"lineBreak":true},{"text":"உலகப்பிரபுக்களில் ஒருவனைப்போல விழுந்து போவீர்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"தேவனே, எழுந்தருளும், பூமிக்கு நியாயத்தீர்ப்புச் செய்யும்;","poem":1},{"lineBreak":true},{"text":"நீரே எல்லா தேசங்களையும் சுதந்தரமாகக் கொண்டிருப்பவர்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}