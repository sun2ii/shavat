{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"தேவனே, மவுனமாக இருக்கவேண்டாம்,","poem":1},{"lineBreak":true},{"text":"பேசாமல் இருக்கவேண்டாம்; தேவனே, சும்மாயிருக்க வேண்டாம்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"இதோ, உம்முடைய எதிரிகள் கொந்தளித்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பகைஞர் தலையை உயர்த்துகிறார்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உமது மக்களுக்கு விரோதமாக சதி செய்ய யோசித்து,","poem":1},{"lineBreak":true},{"text":"உமது மறைவில் இருக்கிறவர்களுக்கு விரோதமாக ஆலோசனைசெய்கிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர்கள் இனி ஒரு தேசமாக இல்லாமலும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் பெயர் இனி நினைக்கப்படாமலும் போவதற்காக,","poem":1},{"lineBreak":true},{"text":"அவர்களை அழிப்போம் வாருங்கள் என்கிறார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"இப்படி, ஏதோமின் கூடாரத்தார்களும்,","poem":1},{"lineBreak":true},{"text":"இஸ்மவேலர்களும், மோவாபியர்களும், ஆகாரியர்களும்,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"கேபாலர்களும், அம்மோனியர்களும், அமலேக்கியர்களும்,","poem":1},{"lineBreak":true},{"text":"தீருவின் குடிமக்களோடுகூடிய பெலிஸ்தர்களும்,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"ஒரே மனதோடு முடிவெடுத்து ஆலோசனைசெய்து,","poem":1},{"lineBreak":true},{"text":"உமக்கு விரோதமாக ஒப்பந்தம் செய்துகொண்டிருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அசீரியர்களும் அவர்களோடேகூடக் கலந்து,","poem":1},{"lineBreak":true},{"text":"லோத்தின் சந்ததிகளுக்கு பலமானார்கள். (சேலா)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"மீதியானியர்களுக்குச் செய்தது போலவும்,","poem":1},{"lineBreak":true},{"text":"கீசோன் என்னும் ஆற்றின் அருகில் எந்தோரிலே அழிக்கப்பட்டு,","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நிலத்திற்கு எருவாய்ப்போன சிசெரா,","poem":1},{"lineBreak":true},{"text":"யாபீன் என்பவர்களுக்குச் செய்ததுபோலவும், அவர்களுக்குச் செய்யும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"அவர்களையும் அவர்கள் அதிபதிகளையும் ஓரேபுக்கும் சேபுக்கும்,","poem":1},{"lineBreak":true},{"text":"அவர்கள் பிரபுக்களையெல்லாம் சேபாவுக்கும் சல்முனாவுக்கும் சமமாக்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"தேவனுடைய வாசஸ்தலங்களை எங்களுக்குச் சுதந்தரமாக நாங்கள் கட்டிக்கொள்வோம் என்று சொல்லுகிறார்களே.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"என் தேவனே, அவர்களைச் சுழல்காற்றின் புழுதிக்கும்,","poem":1},{"lineBreak":true},{"text":"காற்று முகத்தில் பறக்கும் துரும்புக்கும் சமமாக்கும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நெருப்பு காட்டைக் கொளுத்துவதுபோலவும்,","poem":1},{"lineBreak":true},{"text":"அக்கினி ஜூவாலைகள் மலைகளை எரிப்பது போலவும்,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நீர் உமது புயலினாலே அவர்களைத் தொடர்ந்து,","poem":1},{"lineBreak":true},{"text":"உமது பெருங்காற்றினாலே அவர்களைக் கலங்கச்செய்யும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"யெகோவாவே, அவர்கள் உமது பெயரைத் தேடும்படிக்கு,","poem":1},{"lineBreak":true},{"text":"அவர்கள் முகங்களை அவமானத்தாலே மூடும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"யேகோவா என்னும் பெயரை உடைய தேவனே","poem":1},{"lineBreak":true},{"text":"நீர் ஒருவரே பூமியனைத்தின்மேலும் உன்னதமான தேவன் என்று மனிதர்கள் உணரும்படி,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"அவர்கள் என்றைக்கும் வெட்கிக் கலங்கி,","poem":1},{"lineBreak":true},{"text":"அவமானமடைந்து அழிந்துபோவார்களாக.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}