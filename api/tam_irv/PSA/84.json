{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["கீத்தித் என்னும் வாத்தியத்தில் இசைக்கும் இராகத் தலைவனுக்குக் கோராகின் குடும்பம் அளித்த ஒரு துதிப் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"சேனைகளின் யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உமது வாசஸ்தலங்கள் எவ்வளவு இன்பமானவைகள்!","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா யெகோவாவுடைய ஆலயமுற்றங்களின்மேல் வாஞ்சையும் ஆவலுமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய இருதயமும் என்னுடைய சரீரமும் உயிருள்ள தேவனை நோக்கிக் கெம்பீர சத்தமிடுகிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னுடைய ராஜாவும் என் தேவனுமாகிய சேனைகளின் யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்முடைய பீடங்களின் அருகில் அடைக்கலான் குருவிக்கு வீடும்,","poem":1},{"lineBreak":true},{"text":"தகைவிலான் குருவிக்குத் தன்னுடைய குஞ்சுகளை வைக்கும் கூடும் கிடைத்ததே.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உம்முடைய வீட்டில் தங்கி இருக்கிறவர்கள் பாக்கியவான்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் எப்பொழுதும் உம்மைத் துதித்துக்கொண்டிருப்பார்கள் (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உம்மிலே பெலன்கொள்ளுகிற மனிதனும்,","poem":1},{"lineBreak":true},{"text":"தங்களுடைய இருதயங்களில் செவ்வையான வழிகளைக் கொண்டிருக்கிறவர்களும் பாக்கியவான்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அழுகையின் பள்ளத்தாக்கை உருவ நடந்து அதை நீரூற்றாக்கிக் கொள்ளுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"மழையும் குளங்களை நிரப்பும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர்கள் பலத்தின்மேல் பலம் அடைந்து,","poem":1},{"lineBreak":true},{"text":"சீயோனிலே தேவசந்நிதியில் வந்து காணப்படுவார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"சேனைகளின் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பத்தைக் கேளும்;","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் தேவனே, செவிகொடும். (சேலா)","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எங்கள் கேடகமாகிய தேவனே, கண்ணோக்கமாக இரும்;","poem":1},{"lineBreak":true},{"text":"நீர் அபிஷேகம் செய்தவரின் முகத்தைப் பாரும்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆயிரம் நாளைவிட உமது முற்றங்களில் செல்லும் ஒரே நாள் நல்லது;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களின் கூடாரங்களில் தங்கியிருப்பதைவிட","poem":1},{"lineBreak":true},{"text":"என் தேவனுடைய ஆலயத்தின் வாசற்படியில் காத்திருப்பதையே தெரிந்துகொள்ளுவேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"தேவனாகிய யெகோவா சூரியனும் கேடகமுமானவர்;","poem":1},{"lineBreak":true},{"text":"யெகோவா கிருபையையும் மகிமையையும் அருளுவார்;","poem":1},{"lineBreak":true},{"text":"உத்தமமாக நடக்கிறவர்களுக்கு நன்மையை வழங்காமல் இருக்கமாட்டார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"சேனைகளின் யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்மை நம்பியிருக்கிற மனிதன் பாக்கியவான்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}