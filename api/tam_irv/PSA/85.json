{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["கோராகின் குடும்பம் இராகத் தலைவனுக்கு அளித்த துதிப் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உமது தேசத்தின்மேல் பிரியம் வைத்து,","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் சிறையிருப்பைத் திருப்பினீர்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உமது மக்களின் அக்கிரமத்தை மன்னித்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் பாவத்தையெல்லாம் மூடினீர். (சேலா)","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உமது உக்கிரத்தையெல்லாம் அடக்கிக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"உமது கோபத்தின் எரிச்சலைவிட்டுத் திரும்பினீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"எங்கள் இரட்சிப்பின் தேவனே,","poem":1},{"lineBreak":true},{"text":"நீர் எங்களைத் திருப்பிக் கொண்டுவாரும்,","poem":1},{"lineBreak":true},{"text":"எங்கள்மேலுள்ள உமது கோபத்தை ஆறச்செய்யும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"என்றைக்கும் எங்கள்மேல் கோபமாக இருப்பீரோ?","poem":1},{"lineBreak":true},{"text":"தலைமுறை தலைமுறையாக உமது கோபத்தை நீடித்திருக்கச்செய்வீரோ?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உமது மக்கள் உம்மில் மகிழ்ந்திருக்கும்படி","poem":1},{"lineBreak":true},{"text":"நீர் எங்களைத் திரும்ப உயிர்ப்பிக்கமாட்டீரோ?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது கிருபையை எங்களுக்குக் காண்பித்து,","poem":1},{"lineBreak":true},{"text":"உமது இரட்சிப்பை எங்களுக்கு அருளிச்செய்யும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"கர்த்தராகிய தேவன் சொல்வதைக் கேட்பேன்;","poem":1},{"lineBreak":true},{"text":"அவர் தம்முடைய மக்களுக்கும்","poem":1},{"lineBreak":true},{"text":"தம்முடைய பரிசுத்தவான்களுக்கும் சமாதானம் கூறுவார்;","poem":1},{"lineBreak":true},{"text":"அவர்களோ மதிகேட்டுக்குத் திரும்பாமலிருப்பார்களாக.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நம்முடைய தேசத்தில் மகிமை தங்கியிருக்கும்படி,","poem":1},{"lineBreak":true},{"text":"அவருடைய இரட்சிப்பு அவருக்குப் பயந்தவர்களுக்குச் சமீபமாயிருக்கிறது.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"கிருபையும், சத்தியமும் ஒன்றையொன்று சந்திக்கும்,","poem":1},{"lineBreak":true},{"text":"நீதியும் சமாதானமும் ஒன்றையொன்று முத்தஞ்செய்யும்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சத்தியம் பூமியிலிருந்து முளைக்கும்,","poem":1},{"lineBreak":true},{"text":"நீதி வானத்திலிருந்து கீழே பார்க்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவா நன்மையானதைத் தருவார்;","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேசமும் தன்னுடைய பலனைக் கொடுக்கும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீதி அவருக்கு முன்னாகச் சென்று,","poem":1},{"lineBreak":true},{"text":"அவருடைய அடிச்சுவடுகளின் வழியிலே நம்மை நிறுத்தும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}