{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் ஜெபம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உமது செவியைச் சாய்த்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பத்தைக் கேட்டருளும்;","poem":1},{"lineBreak":true},{"text":"நான் ஏழ்மையும் ஒடுக்கப்பட்டவனுமாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவைக் காத்தருளும்,","poem":1},{"lineBreak":true},{"text":"நான் பக்தியுள்ளவன்;","poem":1},{"lineBreak":true},{"text":"என் தேவனே, உம்மை நம்பியிருக்கிற உமது அடியேனை நீர் இரட்சியும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, எனக்கு இரங்கும், நாள்தோறும் உம்மை நோக்கிக் கூப்பிடுகிறேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உமது அடியேனுடைய ஆத்துமாவை மகிழ்ச்சியாக்கும்;","poem":1},{"lineBreak":true},{"text":"ஆண்டவரே, உம்மிடத்தில் என்னுடைய ஆத்துமாவை உயர்த்துகிறேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, நீர் நல்லவரும், மன்னிக்கிறவரும்,","poem":1},{"lineBreak":true},{"text":"உம்மை நோக்கிக் கூப்பிடுகிற எல்லோர்மேலும் கிருபை மிகுந்தவருமாக இருக்கிறீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவாவே, என்னுடைய ஜெபத்திற்குச் செவிகொடுத்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய விண்ணப்பங்களின் சத்தத்தைத் கவனியும்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"நான் துயரப்படுகிற நாளில் உம்மை நோக்கிக் கூப்பிடுவேன்;","poem":1},{"lineBreak":true},{"text":"நீர் என்னைக் கேட்டருளுவீர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, தெய்வங்களுக்குள்ளே உமக்கு இணையுமில்லை;","poem":1},{"lineBreak":true},{"text":"உம்முடைய செயல்களுக்கு ஒப்புமில்லை.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, நீர் உண்டாக்கின எல்லா தேசங்களும் வந்து,","poem":1},{"lineBreak":true},{"text":"உமக்கு முன்பாகப் பணிந்து, உமது பெயரை மகிமைப்படுத்துவார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தேவனே நீர் மகத்துவமுள்ளவரும் அதிசயங்களைச் செய்கிறவருமாக இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"நீர் ஒருவரே தேவன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது வழியை எனக்குப் போதியும்,","poem":1},{"lineBreak":true},{"text":"நான் உமது சத்தியத்திலே நடப்பேன்;","poem":1},{"lineBreak":true},{"text":"நான் உமது பெயருக்குப் பயந்திருக்கும்படி என்னுடைய இருதயத்தை ஒருமுகப்படுத்தும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என் தேவனாகிய ஆண்டவரே;","poem":1},{"lineBreak":true},{"text":"உம்மை என்னுடைய முழு இருதயத்தோடும் துதித்து,","poem":1},{"lineBreak":true},{"text":"உமது பெயரை என்றென்றைக்கும் மகிமைப்படுத்துவேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நீர் எனக்குப் பாராட்டின உமது கிருபை பெரியது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமாவைத் தாழ்ந்த பாதாளத்திற்குத் தப்புவித்தீர்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தேவனே, அகங்காரிகள் எனக்கு விரோதமாக எழும்புகிறார்கள்,","poem":1},{"lineBreak":true},{"text":"கொடுமைக்காரராகிய கூட்டத்தார்கள் என்னுடைய உயிரை வாங்கத் தேடுகிறார்கள்,","poem":1},{"lineBreak":true},{"text":"உம்மைத் தங்களுக்கு முன்பாக நிறுத்தி பார்க்காமலிருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"ஆனாலும் ஆண்டவரே, நீர் மனவுருக்கமும்,","poem":1},{"lineBreak":true},{"text":"இரக்கமும், நீடிய பொறுமையும், பூரண கிருபையும்,","poem":1},{"lineBreak":true},{"text":"சத்தியமுமுள்ள தேவன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"என்மேல் நோக்கமாகி, எனக்கு இரங்கும்;","poem":1},{"lineBreak":true},{"text":"உமது வல்லமையை உமது அடியானுக்கு அருளி,","poem":1},{"lineBreak":true},{"text":"உமது அடியாளின் மகனைக் காப்பாற்றும்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் எனக்குத் துணைசெய்து","poem":1},{"lineBreak":true},{"text":"என்னைத் தேற்றுகிறதை என்னுடைய பகைஞர் கண்டு வெட்கப்படும்படிக்கு,","poem":1},{"lineBreak":true},{"text":"எனக்கு அநுகூலமாக ஒரு அடையாளத்தைக் காண்பித்தருளும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}