{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["கோராகின் மகன்களுடைய பாடல்."]},{"type":"verse","number":1,"content":[{"text":"அவர் அஸ்திபாரம் பரிசுத்த மலைகளில் இருக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா யாக்கோபின் தங்குமிடங்கள் எல்லாவற்றைவிட","poem":1},{"lineBreak":true},{"text":"சீயோனின் வாசல்களில் பிரியமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேவனுடைய நகரமே! உன்னைக் குறித்து மகிமையான விசேஷங்கள் பேசப்படும். (சேலா)","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னை அறிந்தவர்களுக்குள்ளே ராகாபையும் பாபிலோனையும் குறித்துப் பேசுவேன்;","poem":1},{"lineBreak":true},{"text":"இதோ, பெலிஸ்தியர்களிலும், தீரியர்களிலும்,","poem":1},{"lineBreak":true},{"text":"எத்தியோப்பியர்களிலுங்கூட, இன்னான் அங்கே பிறந்தான் என்றும்;","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"சீயோனைக் குறித்து, இன்னான் இன்னான் அதிலே பிறந்தானென்றும் சொல்லப்படும்;","poem":1},{"lineBreak":true},{"text":"உன்னதமான தேவன் தாமே அதை உறுதிப்படுத்துவார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவா மக்களைப் பெயரெழுதும்போது,","poem":1},{"lineBreak":true},{"text":"இன்னான் அதிலே பிறந்தான் என்று அவர்களைக் கணக்கெடுப்பார். (சேலா)","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"எங்களுடைய ஊற்றுகளெல்லாம் உன்னில் இருக்கிறது என்று","poem":1},{"lineBreak":true},{"text":"பாடுவாரும் ஆடுவாரும் ஒன்றாக சொல்லுவார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}