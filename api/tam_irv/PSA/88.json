{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["கோராகின் குடும்பம் இராகத் தலைவனுக்கு அளித்த துதிப் பாடல். இது வேதனை தரும் ஒரு நோயைப் பற்றியது. இது எஸ்ராகியனாகிய ஏமானின் மஸ்கீல் என்னும் ஒரு பாடல்."]},{"type":"verse","number":1,"content":[{"text":"என்னுடைய இரட்சிப்பின் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"இரவும் பகலும் உம்மை நோக்கிக் கூப்பிடுகிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"என் விண்ணப்பம் உமது சமுகத்தில் வருவதாக;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கூப்பிடுதலுக்கு உமது செவியைச் சாய்த்தருளும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா துக்கத்தால் நிறைந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உயிர் பாதாளத்திற்கு அருகில் வந்திருக்கிறது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நான் குழியில் இறங்குகிறவர்களோடு நினைக்கப்பட்டு,","poem":1},{"lineBreak":true},{"text":"பெலனற்ற மனிதனைப்போல ஆனேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"மரித்தவர்களில் ஒருவனைப்போல் தள்ளப்பட்டிருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"நீர் இனி ஒருபோதும் நினையாதபடி,","poem":1},{"lineBreak":true},{"text":"உமது கையால் அறுக்கப்பட்டுபோய்க் கல்லறைகளிலே கிடக்கிறவர்களைப்போலானேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"என்னைப் பாதாளக்குழியிலும் இருளிலும் ஆழங்களிலும் வைத்தீர்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உம்முடைய கோபம் என்னை அமிழ்த்துகிறது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய அலைகள் எல்லாவற்றினாலும் என்னை வருத்தப்படுத்துகிறீர். (சேலா)","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"எனக்கு அறிமுகமானவர்களை எனக்குத் தூரமாக விலக்கி,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு என்னை அருவருப்பாக்கினீர்;","poem":1},{"lineBreak":true},{"text":"நான் வெளியேற முடியாதபடி அடைபட்டிருக்கிறேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"துக்கத்தினால் என்னுடைய கண் தொய்ந்துபோனது;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, அநுதினமும் நான் உம்மை நோக்கிக் கூப்பிட்டு,","poem":1},{"lineBreak":true},{"text":"உமக்கு நேராக என்னுடைய கைகளை விரிக்கிறேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"இறந்தவர்களுக்கு அதிசயங்களைச் செய்வீரோ?","poem":1},{"lineBreak":true},{"text":"செத்துப்போன வீரர்கள் எழுந்து உம்மைத் துதிப்பார்களோ? (சேலா)","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"கல்லறைக்குழியில் உமது கிருபையும்,","poem":1},{"lineBreak":true},{"text":"அழிவில் உமது உண்மையும் விவரிக்கப்படுமோ?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"இருளில் உமது அதிசயங்களும், மறதியின் பூமியில் உமது","poem":1},{"lineBreak":true},{"text":"நீதியும் அறியப்படுமோ?","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"நானோ யெகோவாவே, உம்மை நோக்கிக் கூப்பிடுகிறேன்;","poem":1},{"lineBreak":true},{"text":"காலையிலே என்னுடைய விண்ணப்பம் உமக்கு முன்பாக வரும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவாவே, ஏன் என்னுடைய ஆத்துமாவைத் தள்ளிவிடுகிறீர்?","poem":1},{"lineBreak":true},{"text":"ஏன் உமது முகத்தை எனக்கு மறைக்கிறீர்?","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"சிறுவயதுமுதல் நான் பாதிக்கப்பட்டவனும் இறந்துபோகிறவனுமாக இருக்கிறேன்;","poem":1},{"lineBreak":true},{"text":"உம்மால் வரும் திகில்கள் என்மேல் சுமந்திருக்கிறது,","poem":1},{"lineBreak":true},{"text":"நான் மனங்கலங்குகிறேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உம்முடைய எரிச்சல்கள் என்மேல் புரண்டுபோகிறது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய பயங்கரங்கள் என்னை அழிக்கிறது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"அவைகள் நாள்தோறும் தண்ணீரைப்போல் என்னைச் சூழ்ந்து,","poem":1},{"lineBreak":true},{"text":"ஒன்றாக என்னை வளைந்துகொள்ளுகிறது.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"நண்பனையும் தோழனையும் எனக்குத் தூரமாக விலக்கினீர்;","poem":1},{"lineBreak":true},{"text":"எனக்கு அறிமுகமானவர்கள் மறைந்து போனார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}