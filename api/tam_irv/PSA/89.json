{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["எஸ்ரானாகிய ஏத்தானின் மஸ்கீல் என்னும் போதக பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவின் கிருபைகளை என்றென்றைக்கும் பாடுவேன்;","poem":1},{"lineBreak":true},{"text":"உமது உண்மையைத் தலைமுறை தலைமுறையாக என்னுடைய வாயினால் அறிவிப்பேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"கிருபை என்றென்றைக்கும் உறுதிப்பட்டிருக்கும்;","poem":1},{"lineBreak":true},{"text":"உமது உண்மையை வானங்களிலே நிறுவுவீர் என்றேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னால் தெரிந்துகொள்ளப்பட்டவனோடு உடன்படிக்கை செய்து,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஊழியனாகிய தாவீதை நோக்கி:","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்றென்றைக்கும் உன்னுடைய சந்ததியை நிலைநிறுத்தி,","poem":1},{"lineBreak":true},{"text":"தலைமுறை தலைமுறையாக உன்னுடைய சிங்காசனத்தை நிறுவுவேன் என்று ஆணையிட்டேன் என்றீர். (சேலா)","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவே, வானங்கள் உம்முடைய அதிசயங்களைத் துதிக்கும்,","poem":1},{"lineBreak":true},{"text":"பரிசுத்தவான்களின் சபையிலே உம்முடைய உண்மையும் விளங்கும்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"வானத்தில் யெகோவாவுக்கு சமமானவர் யார்?","poem":1},{"lineBreak":true},{"text":"பலவான்களின் மகன்களில் யெகோவாவுக்கு ஒப்பானவர் யார்?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"தேவன் பரிசுத்தவான்களுடைய ஆலோசனைச் சபையில் மிகவும் பயப்படத்தக்கவர்,","poem":1},{"lineBreak":true},{"text":"தம்மைச் சூழ்ந்திருக்கிற அனைவராலும் பயப்படத்தக்கவர்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"சேனைகளின் தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்மைப்போல வல்லமையுள்ள யெகோவா யார்?","poem":1},{"lineBreak":true},{"text":"உம்முடைய உண்மை உம்மைச் சூழ்ந்திருக்கிறது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"தேவனே நீர் கடலின் பெருமையை ஆளுகிறவர்;","poem":1},{"lineBreak":true},{"text":"அதின் அலைகள் எழும்பும்போது அவைகளை அடங்கச்செய்கிறீர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நீர் ராகாபை","poem":1},{"noteId":23},{"text":"வெட்டப்பட்ட ஒருவனைப்போல் நொறுக்கினீர்;","poem":1},{"lineBreak":true},{"text":"உமது வல்லமையான கரத்தினால் உம்முடைய எதிரிகளைச் சிதறடித்தீர்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"வானங்கள் உம்முடையது, பூமியும் உம்முடையது,","poem":1},{"lineBreak":true},{"text":"பூலோகத்தையும் அதிலுள்ள எல்லோரையும்","poem":1},{"lineBreak":true},{"text":"நீரே அஸ்திபாரப்படுத்தினீர்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"வடக்கையும் தெற்கையும் நீர் உண்டாக்கினீர்;","poem":1},{"lineBreak":true},{"text":"தாபோரும்","poem":1},{"noteId":24},{"text":"எர்மோனும்","poem":1},{"noteId":25},{"text":"உம்முடைய பெயர் விளங்கக் கெம்பீரிக்கும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"உமக்கு வல்லமையுள்ள கை இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய கை பராக்கிரமமுள்ளது;","poem":1},{"lineBreak":true},{"text":"உம்முடைய வலதுகை உன்னதமானது.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நீதியும் நியாயமும் உம்முடைய சிங்காசனத்தின் ஆதாரம்;","poem":1},{"lineBreak":true},{"text":"கிருபையும் சத்தியமும் உமக்கு முன்பாக நடக்கும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"கெம்பீரசத்தத்தை அறியும் மக்கள் பாக்கியமுள்ளவர்கள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, அவர்கள் உம்முடைய முகத்தின் வெளிச்சத்தில் நடப்பார்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"அவர்கள் உம்முடைய பெயரில் நாள்தோறும் சந்தோஷப்பட்டு,","poem":1},{"lineBreak":true},{"text":"உம்முடைய நீதியால் உயர்ந்திருப்பார்கள்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நீரே அவர்களுடைய பலத்தின் மகிமையாக இருக்கிறீர்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய தயவினால் எங்களுடைய கொம்பு உயரும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"யெகோவாவால் எங்களுடைய கேடகமும்,","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் பரிசுத்தரால் எங்களுடைய ராஜாவும் உண்டு.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"அப்பொழுது நீர் உம்முடைய பக்தனுக்குத் தரிசனமாகி:","poem":1},{"lineBreak":true},{"text":"உதவிசெய்யக்கூடிய சக்தியை ஒரு வல்லமையுள்ளவன்மேல் வைத்து,","poem":1},{"lineBreak":true},{"text":"மக்களில் தெரிந்துகொள்ளப்பட்டவனை உயர்த்தினேன்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"என்னுடைய ஊழியனாகிய தாவீதைக் கண்டுபிடித்தேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய பரிசுத்த தைலத்தினால் அவனை அபிஷேகம் செய்தேன்.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"என்னுடைய கை அவனோடு உறுதியாக இருக்கும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய கை அவனைப் பலப்படுத்தும்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"எதிரி அவனை நெருக்குவதில்லை;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கமான மகன் அவனை ஒடுக்குவதில்லை.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவனுடைய எதிரிகளை அவனுக்கு முன்பாக நொறுக்கி,","poem":1},{"lineBreak":true},{"text":"அவனைப் பகைக்கிறவர்களை வெட்டுவேன்.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"என்னுடைய உண்மையும் என்னுடைய கிருபையும் அவனோடு இருக்கும்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய பெயரினால் அவன் கொம்பு உயரும்.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"அவனுடைய கையை மத்திய தரைக் கடலின்மேலும்,","poem":1},{"lineBreak":true},{"text":"அவனுடைய வலது கையை ஆறுகள்மேலும் ஆளும்படி வைப்பேன்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"அவன் என்னை நோக்கி:","poem":1},{"lineBreak":true},{"text":"நீர் என்னுடைய பிதா, என் தேவன், என்னுடைய இரட்சிப்பின் கன்மலையென்று சொல்லுவான்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"நான் அவனை எனக்கு முதலில் பிறந்தவனும்,","poem":1},{"lineBreak":true},{"text":"பூமியின் ராஜாக்களைவிட மகா உயர்ந்தவனுமாக்குவேன்.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"என்னுடைய கிருபையை என்றென்றைக்கும் அவனுக்காகக் காப்பேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய உடன்படிக்கை அவனுக்காக உறுதிப்படுத்தப்படும்.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"அவன் சந்ததி என்றென்றைக்கும் நிலைத்திருக்கவும்,","poem":1},{"lineBreak":true},{"text":"அவன் ராஜாசனம் வானங்களுள்ளவரை நிலைநிற்கவும் செய்வேன்.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"அவனுடைய பிள்ளைகள் என்னுடைய நியாயங்களின்படி நடக்காமல்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வேதத்தை விட்டு விலகி;","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"என்னுடைய கட்டளைகளைக் கைக்கொள்ளாமல் என்னுடைய நியமங்களை மீறி நடந்தால்;","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"அவர்களுடைய மீறுதலை சாட்டையினாலும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய அக்கிரமத்தை வாதைகளினாலும் தண்டிப்பேன்.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"ஆனாலும் என்னுடைய கிருபையை அவனை விட்டு விலக்காமலும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உண்மையில் மீறாமலும் இருப்பேன்.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"என்னுடைய உடன்படிக்கையை மீறாமலும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய உதடுகள் சொன்னதை மாற்றாமலும் இருப்பேன்.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"ஒருமுறை என்னுடைய பரிசுத்தத்தின்பேரில் ஆணையிட்டேன்,","poem":1},{"lineBreak":true},{"text":"தாவீதிற்கு நான் பொய்சொல்லமாட்டேன்.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"அவனுடைய சந்ததி என்றென்றைக்கும் இருக்கும்;","poem":1},{"lineBreak":true},{"text":"அவனுடைய சிங்காசனம் சூரியனைப்போல எனக்கு முன்பாக நிலைநிற்கும்.","poem":1}]},{"type":"verse","number":37,"content":[{"lineBreak":true},{"text":"சந்திரனைப்போல அது என்றென்றைக்கும் உறுதியாயும்,","poem":1},{"lineBreak":true},{"text":"வானத்துச் சாட்சியைப்போல் உண்மையாயும் இருக்கும் என்று சொன்னீர். (சேலா)","poem":1}]},{"type":"verse","number":38,"content":[{"lineBreak":true},{"text":"ஆனாலும் நீர் எங்களை வெறுத்துத் தள்ளிவிட்டீர்;","poem":1},{"lineBreak":true},{"text":"நீர் அபிஷேகம் செய்துவைத்தவன்மேல் கடுங்கோபமானீர்.","poem":1}]},{"type":"verse","number":39,"content":[{"lineBreak":true},{"text":"உமது அடியானுடன் நீர் செய்த உடன்படிக்கையை ஒழித்துவிட்டு,","poem":1},{"lineBreak":true},{"text":"அவனுடைய கிரீடத்தைத் தரையிலே தள்ளி அவமானப்படுத்தினீர்.","poem":1}]},{"type":"verse","number":40,"content":[{"lineBreak":true},{"text":"அவனுடைய மதில்களையெல்லாம் தகர்த்துப்போட்டு,","poem":1},{"lineBreak":true},{"text":"அவனுடைய பாதுகாப்பான இடங்களைப் பாழாக்கினீர்.","poem":1}]},{"type":"verse","number":41,"content":[{"lineBreak":true},{"text":"வழிநடக்கிற அனைவரும் அவனைக் கொள்ளையிடுகிறார்கள்;","poem":1},{"lineBreak":true},{"text":"தன்னுடைய அயலாருக்கு நிந்தையானான்.","poem":1}]},{"type":"verse","number":42,"content":[{"lineBreak":true},{"text":"அவனுடைய எதிரிகளின் வலது கையை நீர் உயர்த்தி,","poem":1},{"lineBreak":true},{"text":"அவனுடைய விரோதிகள் அனைவரும் சந்தோஷிக்கும்படி செய்தீர்.","poem":1}]},{"type":"verse","number":43,"content":[{"lineBreak":true},{"text":"அவனுடைய வாளின் கூர்மையை மழுங்கச்செய்து,","poem":1},{"lineBreak":true},{"text":"அவனை யுத்தத்தில் நிற்காதபடி செய்தீர்.","poem":1}]},{"type":"verse","number":44,"content":[{"lineBreak":true},{"text":"அவனுடைய மகிமையை இல்லாமல்போகச்செய்து,","poem":1},{"lineBreak":true},{"text":"அவனுடைய சிங்காசனத்தைத் தரையிலே தள்ளினீர்.","poem":1}]},{"type":"verse","number":45,"content":[{"lineBreak":true},{"text":"அவனுடைய வாலிபநாட்களைக் குறுக்கி,","poem":1},{"lineBreak":true},{"text":"அவனை வெட்கத்தால் மூடினீர். (சேலா)","poem":1}]},{"type":"verse","number":46,"content":[{"lineBreak":true},{"text":"எதுவரைக்கும், யெகோவாவே! நீர் என்றைக்கும் மறைந்திருப்பீரோ?","poem":1},{"lineBreak":true},{"text":"உமது கோபம் அக்கினியைப்போல எரியுமோ?","poem":1}]},{"type":"verse","number":47,"content":[{"lineBreak":true},{"text":"என்னுடைய உயிர் எவ்வளவு நிலையற்றது என்பதை நினைத்தருளும்;","poem":1},{"lineBreak":true},{"text":"மனிதர்கள் அனைவரையும் வீணாக படைக்கவேண்டியதென்ன?","poem":1}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"மரணத்தைக் காணாமல் உயிரோடு இருப்பவன் யார்?","poem":1},{"lineBreak":true},{"text":"தன்னுடைய ஆத்துமாவைப் பாதாள வல்லமைக்கு விலக்கிவிடுகிறவன் யார்? (சேலா)","poem":1}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, நீர் தாவீதிற்கு உம்முடைய உண்மையைக்கொண்டு","poem":1},{"lineBreak":true},{"text":"சத்தியம்செய்த உமது ஆரம்பநாட்களின் கிருபைகள் எங்கே?","poem":1}]},{"type":"verse","number":50,"content":[{"lineBreak":true},{"text":"ஆண்டவரே, உம்முடைய எதிரிகள் உம்முடைய ஊழியக்காரர்களையும்,","poem":1},{"lineBreak":true},{"text":"நீர் அபிஷேகம் செய்தவனின் காலடிகளையும் நிந்திக்கிறபடியினால்,","poem":1}]},{"type":"verse","number":51,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது அடியார் சுமக்கும் நிந்தையையும்,","poem":1},{"lineBreak":true},{"text":"வலுமையான மக்கள் எல்லோராலும் நான் என்னுடைய மடியில் சுமக்கும்","poem":1},{"lineBreak":true},{"text":"என்னுடைய நிந்தையையும் நினைத்தருளும்.","poem":1}]},{"type":"verse","number":52,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்கு என்றென்றைக்கும் நன்றி உண்டாகட்டும்.","poem":1},{"lineBreak":true},{"text":"ஆமென். ஆமென்.","poem":1}]}],"footnotes":[{"noteId":23,"caller":"+","text":"ராகாப் ஒரு கற்பனையான கடல் பிராணி. யோபு 9:13, 26:12, ஏசாயா 51:9 87:4. ல் குறிப்பிடப்பட்ட ராகாப் புராணக் கதைகளிகளின் கடல் பாம்பு ஆகும்","reference":{"chapter":89,"verse":10}},{"noteId":24,"caller":"+","text":"தாபோர் ஒரு மலை. கலேலியா ஏரியின் தென்மேற்கு பகுதியில் அமைந்துள்ளது. இதன் உயரம் 555 அடிகளாகும்","reference":{"chapter":89,"verse":12}},{"noteId":25,"caller":"+","text":"எர்மோன் ஒரு மலையின் பெயர். கலேலியா ஏரியின் வடகிழக்கில் 75 கி. மீ. தூரத்தில் இருக்கிறது. இதின் உயரம் 8,940 அடிகளாகும்","reference":{"chapter":89,"verse":12}}]},"thisChapterLink":"/api/tam_irv/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}