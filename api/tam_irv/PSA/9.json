{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["முத்லபேன் என்ற இசைக்கருவியில் வாசிக்க இராகத் தலைவனுக்கு தாவீது தந்த பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என் முழு இருதயத்தோடும் உம்மைத் துதிப்பேன்;","poem":1},{"lineBreak":true},{"text":"உம்முடைய அதிசயங்களையெல்லாம் விவரிப்பேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உம்மில் மகிழ்ந்து சந்தோஷப்படுவேன்;","poem":1},{"lineBreak":true},{"text":"உன்னதமான தேவனே, உமது பெயரைப் புகழ்ந்து பாடுவேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகள் பின்னாகத் திரும்பும்போது,","poem":1},{"lineBreak":true},{"text":"உமது சமுகத்தில் அவர்கள் இடறி அழிந்துபோவார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நீர் என்னுடைய நியாயத்தையும் என்னுடைய வழக்கையும் தீர்த்து,","poem":1},{"lineBreak":true},{"text":"நீதியுள்ள நியாயாதிபதியாக சிங்காசனத்தின்மேல் அமர்ந்திருக்கிறீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"தேசங்களைக் கடிந்துகொண்டு,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களை அழித்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் பெயரை என்றென்றைக்கும் இல்லாமல் குலைத்துப்போட்டீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"எதிரிகள் என்றென்றைக்கும் பாழாக்கப்பட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் பட்டணங்களைத் தரைமட்டமாக்கினீர்;","poem":1},{"lineBreak":true},{"text":"அவர்களைப் பற்றிய நினைவும் அழிந்துபோனது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவாவோ என்றென்றைக்கும் அமர்ந்திருப்பார்;","poem":1},{"lineBreak":true},{"text":"தம்முடைய சிங்காசனத்தை நியாயத்தீர்ப்புக்கென்று ஏற்படுத்தியிருக்கிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"அவர் உலகில் உள்ளவர்களை நீதியாக நியாயந்தீர்த்து,","poem":1},{"lineBreak":true},{"text":"எல்லா மக்களுக்கும் செம்மையாக நீதிசெய்வார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"சிறுமைப்பட்டவனுக்குக் யெகோவா அடைக்கலமானவர்;","poem":1},{"lineBreak":true},{"text":"நெருக்கப்படுகிற காலங்களில் அவரே தஞ்சமானவர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உம்மைத் தேடுகிறவர்களை நீர் கைவிடுகிறதில்லை;","poem":1},{"lineBreak":true},{"text":"ஆதலால், உமது பெயரை அறிந்தவர்கள் உம்மை நம்பி இருப்பார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சீயோனில் அரசாளுகிற யெகோவாவைப் புகழ்ந்து பாடி,","poem":1},{"lineBreak":true},{"text":"அவர் செய்கைகளை மக்களுக்குள்ளே அறிவியுங்கள்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ஏனெனில் இரத்தப்பழிகளைக்குறித்து அவர் விசாரணை செய்யும்போது,","poem":1},{"lineBreak":true},{"text":"அவர்களை நினைக்கிறார்;","poem":1},{"lineBreak":true},{"text":"எளியவர்களுடைய கூக்குரலை மறக்கமாட்டார்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"மரணவாசல்களிலிருந்து என்னைத் தூக்கிவிடுகிற யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நான் உம்முடைய துதிகளையெல்லாம் மகளாகிய சீயோன் வாசல்களில் விவரித்து,","poem":1},{"lineBreak":true},{"text":"உம்முடைய இரட்சிப்பினால் மகிழ்வதற்கு,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தேவனே நீர் எனக்கு இரங்கி,","poem":1},{"lineBreak":true},{"text":"என்னைப் பகைக்கிறவர்களால் எனக்கு வரும் துன்பத்தை நோக்கிப்பாரும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"தேசங்கள் தாங்கள் வெட்டின குழியில் தாங்களே விழுந்தார்கள்:","poem":1},{"lineBreak":true},{"text":"அவர்கள் மறைவாக வைத்த வலையில் அவர்களுடைய கால்களே அகப்பட்டுக்கொண்டன.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"யெகோவா தாம் செய்த நியாயத்தினால் அறியப்படுகிறார்;","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கன் தன்னுடைய கைகளின் செயல்களினால் சிக்கிக்கொண்டான். (இகாயோன், சேலா.)","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களும், தேவனை மறக்கிற எல்லா இனத்தார்களும்,","poem":1},{"lineBreak":true},{"text":"நரகத்திலே தள்ளப்படுவார்கள்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"எளியவன் என்றைக்கும் மறக்கப்படுவதில்லை;","poem":1},{"lineBreak":true},{"text":"ஏழைகளுடைய நம்பிக்கை ஒருபோதும் கெட்டுப்போவதில்லை.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"எழுந்தருளும் யெகோவாவே, மனிதன் பெலன்கொள்ளாதபடி செய்யும்;","poem":1},{"lineBreak":true},{"text":"தேசத்தார்கள் உம்முடைய சமுகத்தில் நியாயந்தீர்க்கப்பட வேண்டும்","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தேசங்கள் தாங்கள் மனிதர்கள்தான் என்று அறிவதற்கு,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்குப் பயமுண்டாக்கும், யெகோவாவே (சேலா).","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}