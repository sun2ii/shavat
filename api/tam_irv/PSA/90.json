{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["தேவனுடைய மனிதனாகிய மோசேயின் ஜெபம்."]},{"type":"verse","number":1,"content":[{"text":"ஆண்டவரே, தேவனே நீர் தலைமுறை தலைமுறையாக","poem":1},{"lineBreak":true},{"text":"எங்களுக்கு அடைக்கலமானவர்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மலைகள் தோன்றுமுன்பும்,","poem":1},{"lineBreak":true},{"text":"நீர் பூமியையும், உலகத்தையும் உருவாக்குமுன்னும்,","poem":1},{"lineBreak":true},{"text":"நீரே அநாதியாய் என்றென்றைக்கும் தேவனாக இருக்கிறீர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நீர் மனிதர்களைத் தூளாக்கி,","poem":1},{"lineBreak":true},{"text":"மனித சந்ததிகளை, திரும்புங்கள் என்கிறீர்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உமது பார்வைக்கு ஆயிரம் வருடங்கள்","poem":1},{"lineBreak":true},{"text":"நேற்றுக்கழிந்த நாள்போலவும் இரவுவேளைபோலவும் இருக்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அவர்களை வெள்ளம்போல் அடித்துக்கொண்டு போகிறீர்;","poem":1},{"lineBreak":true},{"text":"தூக்கத்திற்கு ஒப்பாக இருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"காலையிலே முளைக்கிற புல்லுக்கு ஒப்பாக இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அது காலையிலே முளைத்துப் பூத்து,","poem":1},{"lineBreak":true},{"text":"மாலையிலே அறுக்கப்பட்டு உலர்ந்துபோகும்.","poem":1}]},{"type":"verse","number":7,"content":["நாங்கள் உமது கோபத்தினால் அழிந்து",{"text":"உமது கடுங்கோபத்தினால் கலங்கிப்போகிறோம்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"எங்களுடைய அக்கிரமங்களை உமக்கு முன்பாகவும்,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய மறைவான பாவங்களை உமது முகத்தின் வெளிச்சத்திலும் நிறுத்தினீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எங்களுடைய நாட்களெல்லாம் உமது கோபத்தால் போய்விட்டது;","poem":1},{"lineBreak":true},{"text":"ஒரு கதையைப்போல் எங்கள் வருடங்களைக் கழித்துப்போட்டோம்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"எங்களுடைய ஆயுள் நாட்கள் எழுபது வருடங்கள்,","poem":1},{"lineBreak":true},{"text":"பெலத்தின் மிகுதியால் எண்பது வருடங்களாக இருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"அதின் மேன்மையானது வருத்தமும் சஞ்சலமுமே;","poem":1},{"lineBreak":true},{"text":"அது சீக்கரமாகக் கடந்து போகிறது. நாங்களும் பறந்துபோகிறோம்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"உமது கோபத்தின் வல்லமையையும்,","poem":1},{"lineBreak":true},{"text":"உமக்குப் பயப்படக்கூடிய விதமாக உமது கடுங்கோபத்தையும் அறிந்துகொள்கிறவன் யார்?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நாங்கள் ஞான இருதயமுள்ளவர்களாகும்படி,","poem":1},{"lineBreak":true},{"text":"எங்களுடைய நாட்களை எண்ணும் அறிவை எங்களுக்குப் போதித்தருளும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவாவே, திரும்பிவாரும், எதுவரைக்கும் கோபமாக இருப்பீர்?","poem":1},{"lineBreak":true},{"text":"உமது அடியார்களுக்காகப் பரிதபியும்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நாங்கள் எங்களுடைய வாழ்நாட்களெல்லாம் சந்தோஷித்து மகிழும்படி,","poem":1},{"lineBreak":true},{"text":"காலையிலே எங்களை உமது கிருபையால் திருப்தியாக்கும்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"தேவனே நீர் எங்களை சிறுமைப்படுத்திய நாட்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"நாங்கள் துன்பத்தைக் கண்ட வருடங்களுக்கும் இணையாக எங்களை மகிழ்ச்சியாக்கும்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"உமது செயல்கள் உமது ஊழியக்காரர்களுக்கும்,","poem":1},{"lineBreak":true},{"text":"உமது மகிமை அவர்களுடைய பிள்ளைகளுக்கும் விளங்குவதாக.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"எங்களுடைய தேவனாகிய ஆண்டவரின் பிரியம் எங்கள்மேல் இருப்பதாக;","poem":1},{"lineBreak":true},{"text":"எங்களுடைய கைகளின் செயல்களை எங்களிடத்தில் உறுதிப்படுத்தும்;","poem":1},{"lineBreak":true},{"text":"ஆம், எங்களுடைய கைகளின் செயல்களை எங்களிடத்தில் உறுதிப்படுத்தியருளும்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}