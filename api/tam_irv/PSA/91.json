{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"உன்னதமான தேவனுடைய மறைவில் இருக்கிறவன்","poem":1},{"lineBreak":true},{"text":"சர்வவல்லவருடைய நிழலில் தங்குவான்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நான் யெகோவாவை நோக்கி:","poem":1},{"lineBreak":true},{"text":"நீர் என்னுடைய அடைக்கலம்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கோட்டை, என் தேவன்,","poem":1},{"lineBreak":true},{"text":"நான் நம்பியிருக்கிறவர் என்று சொல்லுவேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் உன்னை வேடனுடைய கண்ணிக்கும்,","poem":1},{"lineBreak":true},{"text":"பாழாக்கும் கொள்ளை நோய்க்கும் தப்புவிப்பார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவர் தமது சிறகுகளாலே உன்னை மூடுவார்;","poem":1},{"lineBreak":true},{"text":"அவர் இறக்கைகளின் கீழே அடைக்கலம் புகுவாய்;","poem":1},{"lineBreak":true},{"text":"அவருடைய சத்தியம் உனக்கு பெரிய கவசமும், கேடகமுமாகும்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"இரவில் உண்டாகும் பயங்கரத்திற்கும், பகலில் பறக்கும் அம்பிற்கும்,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"இருளில் நடமாடும் கொள்ளை நோய்க்கும்,","poem":1},{"lineBreak":true},{"text":"மத்தியானத்தில் பாழாக்கும் வியாதிகளுக்கும் பயப்படாமல் இருப்பாய்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உன்னுடைய பக்கத்தில் ஆயிரம்பேரும்,","poem":1},{"lineBreak":true},{"text":"உன்னுடைய வலதுபுறத்தில் பத்தாயிரம்பேரும் விழுந்தாலும்,","poem":1},{"lineBreak":true},{"text":"அது உன்னை அணுகாது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"உன் கண்களால்மட்டும் நீ அதைப் பார்த்து, துன்மார்க்கர்களுக்கு வரும் பலனைக் காண்பாய்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"எனக்கு அடைக்கலமாக இருக்கிற உன்னதமான தேவனாகிய யெகோவாவை","poem":1},{"lineBreak":true},{"text":"உனக்கு அடைக்கலமாகக் கொண்டாய்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"ஆகையால் பொல்லாப்பு உனக்கு நேரிடாது,","poem":1},{"lineBreak":true},{"text":"வாதை உன்னுடைய கூடாரத்தை அணுகாது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"உன்னுடைய வழிகளிலெல்லாம் உன்னைக் காக்கும்படி,","poem":1},{"lineBreak":true},{"text":"உனக்காகத் தம்முடைய தூதர்களுக்குக் கட்டளையிடுவார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"உன்னுடைய பாதம் கல்லில் இடறாதபடிக்கு","poem":1},{"lineBreak":true},{"text":"அவர்கள் உன்னைத் தங்களுடைய கைகளில் ஏந்திக்கொண்டு போவார்கள்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"சிங்கத்தின்மேலும் விரியன் பாம்பின்மேலும் நீ நடந்து,","poem":1},{"lineBreak":true},{"text":"பாலசிங்கத்தையும் வலுசர்ப்பத்தையும் மிதித்துப்போடுவாய்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவன் என்னிடத்தில் வாஞ்சையாக இருக்கிறபடியால் அவனை விடுவிப்பேன்;","poem":1},{"lineBreak":true},{"text":"என்னுடைய பெயரை அவன் அறிந்திருக்கிறபடியால்","poem":1},{"lineBreak":true},{"text":"அவனை உயர்ந்த அடைக்கலத்திலே வைப்பேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவன் என்னை நோக்கிக் கூப்பிடுவான்,","poem":1},{"lineBreak":true},{"text":"நான் அவனுக்கு மறுஉத்திரவு அருளிச்செய்வேன்;","poem":1},{"lineBreak":true},{"text":"ஆபத்தில் நானே அவனோடு இருந்து, அவனைத் தப்புவித்து,","poem":1},{"lineBreak":true},{"text":"அவனைக் கனப்படுத்துவேன்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"நீடித்த நாட்களால் அவனைத் திருப்தியாக்கி,","poem":1},{"lineBreak":true},{"text":"என்னுடைய இரட்சிப்பை அவனுக்குக் காண்பிப்பேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}