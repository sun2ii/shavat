{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["ஓய்வுநாளின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவை துதிப்பதும், உன்னதமான தேவனே,","poem":1},{"lineBreak":true},{"text":"உமது நாமத்தைப் புகழ்ந்து பாடுவதும்,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"பத்துநரம்பு வீணையினாலும், தம்புருவினாலும்,","poem":1},{"lineBreak":true},{"text":"தியானத்தோடு வாசிக்கும் சுரமண்டலத்தினாலும்,","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"காலையிலே உமது கிருபையையும்,","poem":1},{"lineBreak":true},{"text":"இரவிலே உமது சத்தியத்தையும் அறிவிப்பதும் நலமாக இருக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது செயல்களால் என்னை மகிழ்ச்சியாக்கினீர்,","poem":1},{"lineBreak":true},{"text":"உமது கரத்தின் செயல்களுக்காக ஆனந்த சத்தமிடுவேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது செயல்கள் எவ்வளவு மகத்துவமானவைகள்!","poem":1},{"lineBreak":true},{"text":"உமது யோசனைகள் மகா ஆழமானவைகள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மிருககுணமுள்ள மனிதன் அதை அறியமாட்டான்;","poem":1},{"lineBreak":true},{"text":"மூடன் அதை உணரமாட்டான்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்கள் புல்லைப்போலே தழைத்து,","poem":1},{"lineBreak":true},{"text":"அக்கிரமக்காரர்கள் அனைவரும் செழிக்கும்போது,","poem":1},{"lineBreak":true},{"text":"அது அவர்கள் என்றென்றைக்கும் அழிந்துபோவதற்கே ஏதுவாகும்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நீர் என்றென்றைக்கும் உன்னதமானவராக இருக்கிறீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவே, உமது எதிரிகள் அழிவார்கள்;","poem":1},{"lineBreak":true},{"text":"உமது எதிரிகள் அழிந்தேபோவார்கள்; எல்லா அக்கிரமக்காரர்களும் சிதறப்பட்டுபோவார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என்னுடைய கொம்பைக் காண்டாமிருகத்தின் கொம்பைப்போல உயர்த்துவீர்;","poem":1},{"lineBreak":true},{"text":"புது எண்ணெயால் அபிஷேகம் செய்யப்படுகிறேன்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னுடைய எதிரிகளுக்கு நேரிடுவதை என்னுடைய கண் காணும்;","poem":1},{"lineBreak":true},{"text":"எனக்கு விரோதமாக எழும்புகிற துன்மார்க்கர்களுக்கு","poem":1},{"lineBreak":true},{"text":"நேரிடுவதை என்னுடைய காது கேட்கும்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீதிமான் பனையைப்போல் செழித்து,","poem":1},{"lineBreak":true},{"text":"லீபனோனிலுள்ள கேதுருவைப்போல் வளருவான்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"யெகோவாவுடைய ஆலயத்திலே நடப்பட்டவர்கள்","poem":1},{"lineBreak":true},{"text":"எங்களுடைய தேவனுடைய முற்றங்களில் செழித்திருப்பார்கள்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவா உத்தமரென்றும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கன்மலையாகிய அவரிடத்தில்","poem":1},{"lineBreak":true},{"text":"அநீதியில்லையென்றும், விளங்கச்செய்யும்படி,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"அவர்கள் முதிர்வயதிலும் கனிதந்து,","poem":1},{"lineBreak":true},{"text":"புஷ்டியும் பசுமையுமாக இருப்பார்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}