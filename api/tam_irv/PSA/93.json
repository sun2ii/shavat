{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா ஆளுகை செய்கிறார்,","poem":1},{"lineBreak":true},{"text":"மாட்சிமையை அணிந்துகொண்டிருக்கிறார்; யெகோவா வல்லமையை அணிந்து,","poem":1},{"lineBreak":true},{"text":"அவர் அதை வார்க்கச்சையாகக் கட்டிக்கொண்டிருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"ஆதலால் உலகம் அசையாதபடி நிலைபெற்றிருக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உமது சிங்காசனம் ஆரம்பம்முதல் உறுதியானது;","poem":1},{"lineBreak":true},{"text":"நீர் என்றென்றும் இருக்கிறீர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே, நதிகள் எழும்பின;","poem":1},{"lineBreak":true},{"text":"நதிகள் இரைச்சலிட்டு எழும்பின;","poem":1},{"lineBreak":true},{"text":"நதிகள் அலைதிரண்டு எழும்பின.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"திரளான தண்ணீர்களின் இரைச்சலைவிட,","poem":1},{"lineBreak":true},{"text":"கடலின் வலிமையான அலைகளைவிட, யெகோவா உன்னதத்திலே வல்லமையுள்ளவர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உமது சாட்சிகள் மிகவும் உண்மையுள்ளவைகள்;","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, பரிசுத்தமானது நிரந்தர நாளாக","poem":1},{"lineBreak":true},{"text":"உமது ஆலயத்தின் அலங்காரமாக இருக்கிறது.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}