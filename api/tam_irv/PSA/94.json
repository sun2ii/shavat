{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"நீதியைச் சரிக்கட்டுகிற தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நீதியைச் சரிக்கட்டுகிற தேவனே, பிரகாசியும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"பூமியின் நியாயாதிபதியே,","poem":1},{"lineBreak":true},{"text":"நீர் எழுந்து, பெருமைக்காரர்களுக்குப் பதிலளியும்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே, துன்மார்க்கர்கள் எதுவரைக்கும் மகிழ்ந்து,","poem":1},{"lineBreak":true},{"text":"எதுவரைக்கும் சந்தோஷமாக இருப்பார்கள்?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"எதுவரைக்கும் அக்கிரமக்காரர்கள் அனைவரும் வாயாடி,","poem":1},{"lineBreak":true},{"text":"கடினமாகப் பேசி, பெருமைபாராட்டுவார்கள்?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவே, அவர்கள் உமது மக்களை நொறுக்கி,","poem":1},{"lineBreak":true},{"text":"உமது சுதந்தரத்தை ஒடுக்குகிறார்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"விதவையையும் அந்நியனையும் கொன்று,","poem":1},{"lineBreak":true},{"text":"திக்கற்ற பிள்ளைகளைக் கொலைசெய்து:","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"யெகோவா பார்க்கமாட்டார்,","poem":1},{"lineBreak":true},{"text":"யாக்கோபின் தேவன் கவனிக்கமாட்டார் என்று சொல்லுகிறார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"மக்களில் மிருககுணமுள்ளவர்களே, உணர்வடையுங்கள்;","poem":1},{"lineBreak":true},{"text":"மூடர்களே, எப்பொழுது புத்திமான்களாவீர்கள்?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"காதை உண்டாக்கினவர் கேட்கமாட்டாரோ?","poem":1},{"lineBreak":true},{"text":"கண்ணை உருவாக்கினவர் காணமாட்டாரோ?","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"தேசங்களைத் தண்டிக்கிறவர் கடிந்துகொள்ளமாட்டாரோ?","poem":1},{"lineBreak":true},{"text":"மனிதனுக்கு அறிவைப் போதிக்கிறவர் அறியமாட்டாரோ?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"மனிதனுடைய யோசனைகள் வீணென்று யெகோவா அறிந்திருக்கிறார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"யெகோவாவே, துன்மார்க்கனுக்குக் குழிவெட்டப்படும்வரைக்கும்,","poem":1},{"lineBreak":true},{"text":"நீர் தீங்கு நாட்களில் அமர்ந்திருக்கச்செய்து,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தண்டித்து, உம்முடைய வேதத்தைக்கொண்டு","poem":1},{"lineBreak":true},{"text":"போதிக்கிற மனிதன் பாக்கியவான்.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"யெகோவா தம்முடைய மக்களைத் தள்ளிவிடாமலும்,","poem":1},{"lineBreak":true},{"text":"தம்முடைய சுதந்தரத்தைக் கைவிடாமலும் இருப்பார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"நியாயம் நீதியினிடமாகத் திரும்பும்;","poem":1},{"lineBreak":true},{"text":"செம்மையான இருதயத்தார்கள் அனைவரும் அதைப் பின்பற்றுவார்கள்.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"துன்மார்க்கர்களுக்கு விரோதமாக","poem":1},{"lineBreak":true},{"text":"எனது சார்பாக எழும்புகிறவன் யார்?","poem":1},{"lineBreak":true},{"text":"அக்கிரமக்காரர்களுக்கு விரோதமாக எனது சார்பாக நிற்பவன் யார்?","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"யெகோவா எனக்குத் துணையாக இல்லாவிட்டால்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய ஆத்துமா சீக்கிரமாக மவுனத்தில் தங்கியிருக்கும்.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"என்னுடைய கால் சறுக்குகிறது என்று நான் சொல்லும்போது,","poem":1},{"lineBreak":true},{"text":"யெகோவாவே, உமது கிருபை என்னைத் தாங்குகிறது.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"என்னுடைய உள்ளத்தில் கவலைகள் பெருகும்போது,","poem":1},{"lineBreak":true},{"text":"உம்முடைய ஆறுதல்கள் என் ஆத்துமாவைத் தேற்றுகிறது.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"தீமையைக் கட்டளையினால் பிறப்பிக்கிற துன்மார்க்கனுடைய ஆட்சி உம்மோடு இசைந்திருக்குமோ?","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"அவர்கள் நீதிமானுடைய ஆத்துமாவுக்கு விரோதமாகக் கூட்டங்கூடி,","poem":1},{"lineBreak":true},{"text":"குற்றமில்லாத இரத்தத்தைக் குற்றப்படுத்துகிறார்கள்.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"யெகோவாவோ எனக்கு அடைக்கலமும்,","poem":1},{"lineBreak":true},{"text":"என் தேவன் நான் நம்பியிருக்கிற கன்மலையுமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"அவர்களுடைய அக்கிரமத்தை அவர்கள்மேல் திருப்பி,","poem":1},{"lineBreak":true},{"text":"அவர்களுடைய பொல்லாப்பினால் அவர்களை அழிப்பார்;","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேவனாகிய யெகோவாவே அவர்களை அழிப்பார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}