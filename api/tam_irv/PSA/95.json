{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவைக் கெம்பீரமாகப் பாடி,","poem":1},{"lineBreak":true},{"text":"நம்முடைய இரட்சணியக் கன்மலையைப் புகழ்ந்து பாடக்கடவோம் வாருங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"துதித்தலுடனே அவர் சந்நிதிக்கு முன்பாக வந்து,","poem":1},{"lineBreak":true},{"text":"பாடல்களால் அவரை ஆர்ப்பரித்துப் பாடுவோம்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"யெகோவாவே மகா தேவனும், எல்லா தெய்வங்களுக்கும் மகாராஜனுமாக இருக்கிறார்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"பூமியின் ஆழங்கள் அவருடைய கையில் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"மலைகளின் உயரங்களும் அவருடையவைகள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"கடல் அவருடையது, அவரே அதை உண்டாக்கினார்;","poem":1},{"lineBreak":true},{"text":"காய்ந்த தரையையும் அவருடைய கரம் உருவாக்கினது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நம்மை உண்டாக்கின யெகோவாவுக்கு முன்பாக","poem":1},{"lineBreak":true},{"text":"நாம் பணிந்து குனிந்து முழங்காற்படியிடுவோம் வாருங்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"அவர் நம்முடைய தேவன்;","poem":1},{"lineBreak":true},{"text":"நாம் அவர் மேய்ச்சலின் மக்களும்,","poem":1},{"lineBreak":true},{"text":"அவர் கைக்குள்ளான ஆடுகளுமாமே.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"இன்று அவருடைய சத்தத்தைக் கேட்பீர்களென்றால்,","poem":1},{"lineBreak":true},{"text":"வனாந்திரத்தில் கோபம் மூட்டினபோதும் சோதனை நாளிலும் நடந்ததுபோல,","poem":1},{"lineBreak":true},{"text":"உங்களுடைய இருதயத்தைக் கடினப்படுத்தாமலிருங்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அங்கே உங்களுடைய முற்பிதாக்கள் என்னைச் சோதித்து,","poem":1},{"lineBreak":true},{"text":"என்னைப் பரீட்சை பார்த்து, என்னுடைய செயல்களையும் கண்டார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நாற்பது வருடங்களாக நான் அந்தச் சந்ததியின்மேல் கோபமாக இருந்து,","poem":1},{"lineBreak":true},{"text":"அவர்கள் வழுவிப்போகிற இருதயமுள்ள மக்களென்றும்,","poem":1},{"lineBreak":true},{"text":"என்னுடைய வழிகளை அறியாதவர்களென்றும் சொல்லி,","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என்னுடைய இளைப்பாறுதலில் அவர்கள் நுழைவதில்லையென்று,","poem":1},{"lineBreak":true},{"text":"என்னுடைய கோபத்திலே ஆணையிட்டேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}