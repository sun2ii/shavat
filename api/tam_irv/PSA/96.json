{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்குப் புதுப்பாட்டைப் பாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"பூமியின் குடிகளே, எல்லோரும் யெகோவாவைப் பாடுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவாவைப் பாடி, அவருடைய பெயருக்கு நன்றி சொல்லி,","poem":1},{"lineBreak":true},{"text":"நாளுக்குநாள் அவருடைய இரட்சிப்பைச் சுவிசேஷமாக அறிவியுங்கள்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"தேசங்களுக்குள் அவருடைய மகிமையையும்,","poem":1},{"lineBreak":true},{"text":"எல்லா மக்களுக்குள்ளும் அவருடைய அதிசயங்களையும் விவரித்துச் சொல்லுங்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"யெகோவா பெரியவரும், மிகவும் துதிக்கப்படத்தக்கவருமாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"எல்லா தெய்வங்களிலும் பயப்படத்தக்கவர் அவரே.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"எல்லா மக்களுடைய தெய்வங்களும் விக்கிரகங்கள்தானே;","poem":1},{"lineBreak":true},{"text":"யெகோவாவோவானங்களை உண்டாக்கினவர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மகிமையும், மேன்மையும் அவர் சமுகத்தில் இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"வல்லமையும் மகத்துவமும் அவர் பரிசுத்த ஸ்தலத்திலுள்ளது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மக்களின் வம்சங்களே,","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்கு மகிமையையும் வல்லமையையும் செலுத்துங்கள்,","poem":1},{"lineBreak":true},{"text":"கர்த்தருக்கே அதைச் செலுத்துங்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்கு அவருடைய பெயருக்குரிய மகிமையைச் செலுத்தி,","poem":1},{"lineBreak":true},{"text":"காணிக்கைகளைக் கொண்டுவந்து, அவருடைய முற்றங்களில் நுழையுங்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"பரிசுத்த அலங்காரத்துடனே யெகோவாவை தொழுதுகொள்ளுங்கள்;","poem":1},{"lineBreak":true},{"text":"பூமியில் உள்ளவர்களே,","poem":1},{"lineBreak":true},{"text":"நீங்கள் அனைவரும் அவருக்கு முன்பாக நடுங்குங்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவா ராஜரிகம்செய்கிறார்,","poem":1},{"lineBreak":true},{"text":"ஆகையால் உலகம் அசையாதபடி உறுதிப்பட்டிருக்கும்.","poem":1},{"lineBreak":true},{"text":"அவர் மக்களை நிதானமாக நியாயந்தீர்ப்பார் என்று தேசங்களுக்குள்ளே சொல்லுங்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"வானங்கள் மகிழ்ந்து, பூமி பூரிப்பாகி,","poem":1},{"lineBreak":true},{"text":"கடலும் அதின் நிறைவும் முழங்குவதாக.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நாடும் அதிலுள்ள அனைத்தும் மகிழ்வதாக;","poem":1},{"lineBreak":true},{"text":"அப்பொழுது யெகோவாவுக்கு முன்பாக காட்டுமரங்களெல்லாம் கெம்பீரிக்கும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவர் வருகிறார், அவர் பூமியை நியாயந்தீர்க்க வருகிறார்;","poem":1},{"lineBreak":true},{"text":"அவர் உலகத்தை நீதியோடும்,","poem":1},{"lineBreak":true},{"text":"மக்களைச் சத்தியத்தோடும் நியாயந்தீர்ப்பார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}