{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா ராஜரிகம்செய்கிறார்; பூமி பூரிப்பாகி,","poem":1},{"lineBreak":true},{"text":"திரளான தீவுகள் மகிழட்டும்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"மேகமும் மந்தாரமும் அவரைச் சூழ்ந்திருக்கிறது;","poem":1},{"lineBreak":true},{"text":"நீதியும் நியாயமும் அவருடைய சிங்காசனத்தின் ஆதாரம்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நெருப்பு அவருக்கு முன்சென்று,","poem":1},{"lineBreak":true},{"text":"சுற்றிலும் இருக்கிற அவருடைய எதிரிகளைச் சுட்டெரிக்கிறது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"அவருடைய மின்னல்கள் பூமியைப் பிரகாசிப்பித்தது;","poem":1},{"lineBreak":true},{"text":"பூமி அதைக்கண்டு அதிர்ந்தது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"யெகோவாவின் பிரசன்னத்தினால் மலைகள் மெழுகுபோல உருகினது,","poem":1},{"lineBreak":true},{"text":"சர்வ பூமியினுடைய ஆண்டவரின் பிரசன்னத்தினாலேயே உருகிப்போனது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"வானங்கள் அவருடைய நீதியை வெளிப்படுத்துகிறது;","poem":1},{"lineBreak":true},{"text":"எல்லா மக்களும் அவருடைய மகிமையைக் காண்கிறார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"சிலைகளை வணங்கி,","poem":1},{"lineBreak":true},{"text":"விக்கிரகங்களைப்பற்றிப் பெருமைபாராட்டுகிற அனைவரும் வெட்கப்பட்டுப் போவார்களாக;","poem":1},{"lineBreak":true},{"text":"தெய்வங்களே, நீங்களெல்லோரும் அவரைத் தொழுதுகொள்ளுங்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"சீயோன் கேட்டு மகிழ்ந்தது; யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"உம்முடைய நியாயத்தீர்ப்புகளினால் யூதாவின் மகள்கள் சந்தோஷப்பட்டார்கள்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"யெகோவாவே, பூமி அனைத்திற்கும்","poem":1},{"lineBreak":true},{"text":"நீர் உன்னதமான தேவன்; எல்லா தெய்வங்களிலும் நீரே மிகவும் உயர்ந்தவர்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"யெகோவாவில் அன்புகூருகிறவர்களே, தீமையை வெறுத்துவிடுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் தம்முடைய பரிசுத்தவான்களின் ஆத்துமாக்களைக் காப்பாற்றி,","poem":1},{"lineBreak":true},{"text":"துன்மார்க்கர்களின் கைக்கு அவர்களைத் தப்புவிக்கிறார்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நீதிமானுக்காக வெளிச்சமும்,","poem":1},{"lineBreak":true},{"text":"செம்மையான இருதயமுள்ளவர்களுக்காக மகிழ்ச்சியும் விதைக்கப்பட்டிருக்கிறது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நீதிமான்களே, யெகோவாவுக்குள் மகிழ்ந்து,","poem":1},{"lineBreak":true},{"text":"அவருடைய பரிசுத்தத்தின் நினைவுகூருதலைக் கொண்டாடுங்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}