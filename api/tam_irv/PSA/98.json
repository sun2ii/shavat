{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்குப் புதுப்பாட்டைப் பாடுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் அதிசயங்களைச் செய்திருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அவருடைய வலது கரமும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய பரிசுத்த கரமும், வெற்றியை உண்டாக்கினது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா தமது இரட்சிப்பை வெளிப்படுத்தி,","poem":1},{"lineBreak":true},{"text":"தமது நீதியை தேசங்களுடைய கண்களுக்கு முன்பாக விளங்கச்செய்தார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் இஸ்ரவேல் குடும்பத்துக்காகத் தமது கிருபையையும் உண்மையையும் நினைவுகூர்ந்தார்;","poem":1},{"lineBreak":true},{"text":"பூமியின் எல்லைகளெல்லாம் நமது தேவனுடைய வெற்றியைக் கண்டது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"பூமியில் உள்ளவர்களே, நீங்களெல்லோரும்","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நோக்கி ஆனந்தமாக ஆர்ப்பரியுங்கள்; முழக்கமிட்டுக் கெம்பீரமாகப் பாடுங்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"சுரமண்டலத்தால் யெகோவாவைப் புகழ்ந்துபாடுங்கள்,","poem":1},{"lineBreak":true},{"text":"சுரமண்டலத்தாலும் பாடலின் சத்தத்தாலும் அவரைப் புகழ்ந்துபாடுங்கள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"யெகோவாவாகிய ராஜாவின் சமுகத்தில் பூரிகைகளாலும்","poem":1},{"lineBreak":true},{"text":"எக்காள சத்தத்தாலும் ஆனந்தமாக ஆர்ப்பரியுங்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"கடலும் அதின் நிறைவும், பூமியும் அதில் உள்ளவர்களும் முழங்குவதாக.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவாவுக்கு முன்பாக ஆறுகள் கைதட்டி,","poem":1},{"lineBreak":true},{"text":"மலைகள் ஒன்றாக கெம்பீரித்துப் பாடட்டும்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் பூமியை நியாயந்தீர்க்க வருகிறார்;","poem":1},{"lineBreak":true},{"text":"உலகத்தை நீதியோடும்","poem":1},{"lineBreak":true},{"text":"மக்களை நிதானத்தோடும் நியாயந்தீர்ப்பார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}