{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_irv","name":"சங்கீதங்கள்","commonName":"சங்கீதங்கள்","title":"சங்கீதங்கள்","order":19,"numberOfChapters":150,"sha256":"e47bf81c3364b29feb5ab94d526444ac96b059930bd9b4e8c74d526749aee843","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_irv/PSA/150.json","totalNumberOfVerses":2461},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா ராஜரிகம்செய்கிறார்,","poem":1},{"lineBreak":true},{"text":"மக்கள் தத்தளிப்பார்களாக;","poem":1},{"lineBreak":true},{"text":"அவர் கேருபீன்களின் மத்தியில் அமர்ந்திருக்கிறார்,","poem":1},{"lineBreak":true},{"text":"பூமி அசைவதாக.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா சீயோனில் பெரியவர்,","poem":1},{"lineBreak":true},{"text":"அவர் எல்லா மக்கள்மேலும் உயர்ந்தவர்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"மகத்துவமும் பயங்கரமுமான உமது பெயரை அவர்கள் துதிப்பார்களாக;","poem":1},{"lineBreak":true},{"text":"அது பரிசுத்தமுள்ளது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"ராஜாவின் வல்லமை நீதியில் பிரியப்படுகிறது,","poem":1},{"lineBreak":true},{"text":"தேவனே நீர் நியாயத்தை நிலைநிறுத்துகிறீர்;","poem":1},{"lineBreak":true},{"text":"நீர் யாக்கோபில் நியாயமும் நீதியும் செய்கிறீர்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"நம்முடைய தேவனாகிய யெகோவாவை உயர்த்தி,","poem":1},{"lineBreak":true},{"text":"அவர் பாதத்தைப் பணியுங்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் பரிசுத்தமுள்ளவர்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவருடைய ஆசாரியர்களில் மோசேயும் ஆரோனும்,","poem":1},{"lineBreak":true},{"text":"அவர் பெயரைப்பற்றிக் கூப்பிடுகிறவர்களில் சாமுவேலும்,","poem":1},{"lineBreak":true},{"text":"யெகோவாவை நோக்கிக் கூப்பிட்டார்கள்;","poem":1},{"lineBreak":true},{"text":"அவர் அவர்களுக்கு மறுஉத்திரவு அருளினார்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"மேகத்தூணிலிருந்து அவர்களோடு பேசினார்;","poem":1},{"lineBreak":true},{"text":"அவர்கள் அவருடைய சாட்சிப்பிரமாணங்களையும்","poem":1},{"lineBreak":true},{"text":"அவர் தங்களுக்குக் கொடுத்த கட்டளையையும் கைக்கொண்டார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"எங்களுடைய தேவனாகிய யெகோவாவே,","poem":1},{"lineBreak":true},{"text":"நீர் அவர்களுக்கு உத்திரவு கொடுத்தீர்;","poem":1},{"lineBreak":true},{"text":"நீர் அவர்கள் செயல்களுக்காக நீதி சரிக்கட்டினபோதிலும்,","poem":1},{"lineBreak":true},{"text":"அவர்களுக்கு மன்னிக்கிற தேவனாக இருந்தீர்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"நம்முடைய தேவனாகிய யெகோவாவை உயர்த்தி,","poem":1},{"lineBreak":true},{"text":"அவருடைய பரிசுத்த மலைக்கு நேராகப் பணியுங்கள்;","poem":1},{"lineBreak":true},{"text":"நம்முடைய தேவனாகிய யெகோவா பரிசுத்தமுள்ளவர்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}