{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_irv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"1d53a5be14b3492113cda9b0fb4d762241a13857473aa9eacf79091da8b611bb","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"heading","content":["விருந்து"]},{"type":"verse","number":1,"content":[{"text":"சாலொமோன் பாடின உன்னதப்பாட்டு.","poem":1},"மணவாளி"]},{"type":"verse","number":2,"content":[{"text":"நீர் உமது வாயின் முத்தங்களால் என்னை முத்தமிடுவீராக","poem":1},{"noteId":0},{"text":":","poem":1},{"lineBreak":true},{"text":"உமது நேசம் திராட்சைரசத்தைவிட இன்பமானது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உமது நறுமணமுள்ள தைலங்கள் இன்பமான வாசனையுள்ளவைகள்;","poem":1},{"lineBreak":true},{"text":"உமது நாமம் ஊற்றப்பட்ட நறுமணமுள்ள தைலமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"ஆகையால் இளம்பெண்கள் உம்மை நேசிக்கிறார்கள்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னை இழுத்துக்கொள்ளும், உமக்குப் பின்னே ஓடிவருவோம்;","poem":1},{"lineBreak":true},{"text":"ராஜா என்னைத் தமது அறைகளில் அழைத்துக்கொண்டு வந்தார்;","poem":1},{"lineBreak":true},{"text":"நாங்கள் உமக்குள் களிகூர்ந்து மகிழுவோம்;","poem":1},{"lineBreak":true},{"text":"திராட்சைரசத்தைவிட உமது நேசத்தை நினைப்போம்;","poem":1},{"lineBreak":true},{"text":"உத்தமர்கள் உம்மை நேசிக்கிறார்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"எருசலேமின் பெண்களே! கேதாரின்","poem":1},{"noteId":1},{"text":"கூடாரங்களைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"சாலொமோனின் திரைகளைப்போலவும் நான் கறுப்பாக இருந்தாலும்,","poem":1},{"lineBreak":true},{"text":"அழகாக இருக்கிறேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நான் கறுப்பாக இருக்கிறேன் என்று பார்க்காதீர்கள்;","poem":1},{"lineBreak":true},{"text":"வெயில் என்மேல் பட்டது;","poem":1},{"lineBreak":true},{"text":"என் சகோதரர்கள் என்மேல் கோபமாயிருந்து,","poem":1},{"lineBreak":true},{"text":"என்னைத் திராட்சைத் தோட்டங்களுக்குக்","poem":1},{"noteId":2},{"text":"காவற்காரியாக வைத்தார்கள்;","poem":1},{"lineBreak":true},{"text":"என் சொந்தத் திராட்சைத்தோட்டத்தையோ நான் காக்கவில்லை.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என் ஆத்தும நேசரே! உமது மந்தையை எங்கே மேய்த்து,","poem":1},{"lineBreak":true},{"text":"அதை மத்தியானத்தில் எங்கே சேர்க்கிறீர்?","poem":1},{"lineBreak":true},{"text":"எனக்குச் சொல்லும்;","poem":1},{"lineBreak":true},{"text":"உமது தோழர்களின் மந்தைகளின் அருகே அலைந்து திரிகிறவளைப்போல","poem":1},{"noteId":3},{"text":"நான் இருக்கவேண்டியதென்ன?","poem":1},"மணவாளன்"]},{"type":"verse","number":8,"content":[{"text":"பெண்களில் அழகு மிகுந்தவளே!","poem":1},{"lineBreak":true},{"text":"அதை நீ அறியவில்லையென்றால், மந்தையின் காலடிகளைத் தொடர்ந்துபோய்,","poem":1},{"lineBreak":true},{"text":"மேய்ப்பர்களுடைய கூடாரங்களுக்கு அருகில் உன் ஆட்டுக்குட்டிகளை மேயவிடு.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என் பிரியமே!","poem":1},{"lineBreak":true},{"text":"பார்வோனுடைய இரதங்களில் பூட்டப்பட்டிருக்கிற பெண்குதிரைக் கூட்டத்திற்கு உன்னை ஒப்பிடுகிறேன்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அணிகலன்கள் அணிந்த உன் கன்னங்களும்,","poem":1},{"lineBreak":true},{"text":"ஆரங்கள் அணிந்த உன் கழுத்தும் அழகாக இருக்கிறது.","poem":1},"மணவாளி"]},{"type":"verse","number":11,"content":[{"text":"வெள்ளிப் பொட்டுகளுள்ள பொன் ஆபரணங்களை உனக்குச் செய்விப்போம்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"ராஜா தமது பந்தியிலிருக்கும்","poem":1},{"noteId":4},{"text":"வரை","poem":1},{"lineBreak":true},{"text":"என்னுடைய நறுமணமுள்ள தைலம் தன் வாசனையை வீசும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"என் நேசர் எனக்கு என் மார்பகங்களின் நடுவில் தங்கும் வெள்ளைப்போளச் செண்டு.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"என் நேசர் எனக்கு எங்கேதி","poem":1},{"noteId":5},{"text":"ஊர் திராட்சைத்தோட்டங்களில்","poem":1},{"lineBreak":true},{"text":"முளைக்கும் மருதாணிப் பூங்கொத்து.","poem":1},"மணவாளன்"]},{"type":"verse","number":15,"content":[{"text":"என் பிரியமே! நீ அழகு மிகுந்தவள்;","poem":1},{"lineBreak":true},{"text":"நீ மிக அழகுள்ளவள்;","poem":1},{"lineBreak":true},{"text":"உன் கண்கள் புறாக்கண்கள்.","poem":1},"மணவாளி"]},{"type":"verse","number":16,"content":["நீர் ரூபமுள்ளவர்;",{"text":"என் நேசரே! நீர் இன்பமானவர்;","poem":1},{"lineBreak":true},{"text":"நம்முடைய படுக்கை பசுமையானது.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"நம்முடைய வீட்டின் உத்திரங்கள் கேதுரு மரம்,","poem":1},{"lineBreak":true},{"text":"நம்முடைய வீட்டின் மேல்தளம் தேவதாரு மரம்.","poem":1}]}],"footnotes":[{"noteId":0,"caller":"+","text":"அவர் தமது வாயின் முத்தங்களால் என்னை முத்தமிடுவாராக","reference":{"chapter":1,"verse":2}},{"noteId":1,"caller":"+","text":"கேதார் அராபியர்களில் ஒரு இஸ்மவேல் கோத்திரம். பார்க்க, ஆதி. 25:13, ஏசாயா. 21:16-17, சங்கீதம், 120:5 ஒரு வாலிப பெண்ணின் கறுப்பு நிறத் தோல்","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"அதிக பால் உணர்வுள்ள ஒரு வாலிப பெண்ணை குறிக்கலாம்","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"முக்காடுயிட்ட பெண்ணைப் போல்","reference":{"chapter":1,"verse":7}},{"noteId":4,"caller":"+","text":"மஞ்சத்தில் படுத்திருக்கும் வரை","reference":{"chapter":1,"verse":12}},{"noteId":5,"caller":"+","text":"சவக் கடலின் தென்மேற்கு பகுதியில் உள்ள சோலைவனம், இது நீர் ஊற்றுகளால் செழிப்பாக இருந்தது, மனதை குளிர செய்தது.","reference":{"chapter":1,"verse":14}}]},"thisChapterLink":"/api/tam_irv/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}