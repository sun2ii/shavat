{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_irv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"1d53a5be14b3492113cda9b0fb4d762241a13857473aa9eacf79091da8b611bb","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"நான் சாரோனின்","poem":1},{"noteId":6},{"text":"ரோஜாவும், பள்ளத்தாக்குகளின் லீலிமலராக இருக்கிறேன்.","poem":1},"மணவாளன்"]},{"type":"verse","number":2,"content":[{"text":"முட்களுக்குள்ளே லீலிமலர் எப்படியிருக்கிறதோ,","poem":1},{"lineBreak":true},{"text":"அப்படியே இளம்பெண்களுக்குள்ளே எனக்குப் பிரியமானவளும் இருக்கிறாள்.","poem":1},"மணவாளி"]},{"type":"verse","number":3,"content":[{"text":"காட்டுமரங்களுக்குள்ளே கிச்சிலி மரம் எப்படியிருக்கிறதோ,","poem":1},{"lineBreak":true},{"text":"அப்படியே இளம் ஆண்களுக்குள்ளே என் நேசர் இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"அதின் நிழலிலே ஆர்வமுடன் உட்காருகிறேன்,","poem":1},{"lineBreak":true},{"text":"அதின் பழம் என் வாய்க்கு இனிப்பாக இருக்கிறது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"என்னை விருந்துசாலைக்கு அழைத்துக்கொண்டுபோனார்;","poem":1},{"lineBreak":true},{"text":"என்மேல் பறந்த அவருடைய கொடி நேசமே.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"திராட்சைரசத்தால் என்னைத் தேற்றுங்கள்,","poem":1},{"lineBreak":true},{"text":"கிச்சிலிப்பழங்களால் என்னை ஆற்றுங்கள்;","poem":1},{"lineBreak":true},{"text":"நேசத்தால் சோகமடைந்திருக்கிறேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவருடைய இடதுகை என் தலையின்கீழ் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அவருடைய வலதுகை என்னை அணைத்துக்கொள்கிறது.","poem":1},"மணவாளன்"]},{"type":"verse","number":7,"content":[{"text":"எருசலேமின் இளம்பெண்களே!","poem":1},{"lineBreak":true},{"text":"எனக்குப் பிரியமானவளுக்கு மனதிருப்தி உண்டாகும்வரை","poem":1},{"lineBreak":true},{"text":"நீங்கள் அவளை விழிக்கச் செய்யாமலும்,","poem":1},{"lineBreak":true},{"text":"எழுப்பாமலும் இருக்கும்படி வெளிமான்கள்மேலும் வெளியின் மரைகள்மேலும் உங்களுக்கு ஆணையிடுகிறேன்.","poem":1},"நேசரின் வேண்டுகோள் மணவாளி"]},{"type":"verse","number":8,"content":[{"text":"இது என் நேசருடைய சத்தம்!","poem":1},{"lineBreak":true},{"text":"இதோ, அவர் மலைகளின்மேல் குதித்தும் மேடுகளின்மேல் துள்ளியும் வருகிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என் நேசர் வெளிமானுக்கும் மரைக்குட்டிக்கும் ஒப்பாக இருக்கிறார்;","poem":1},{"lineBreak":true},{"text":"இதோ, அவர் எங்கள் மதிலுக்கு வெளியே நின்று","poem":1},{"lineBreak":true},{"text":"சன்னல் வழியாகப் பார்த்து,","poem":1},{"lineBreak":true},{"text":"தட்டியின் வழியாகத் தமது மலர்ந்த முகத்தைக் காண்பிக்கிறார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"என் நேசர் என்னோடே பேசி:","poem":1},"மணவாளன்",{"text":"என் பிரியமே!","poem":1},{"lineBreak":true},{"text":"என் அழகு மிகுந்தவளே! எழுந்துவா.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"இதோ, மழைக்காலம் சென்றது,","poem":1},{"lineBreak":true},{"text":"மழைபெய்து ஓய்ந்தது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"பூமியிலே மலர்கள் காணப்படுகிறது;","poem":1},{"lineBreak":true},{"text":"குருவிகள் பாடும் காலம் வந்தது,","poem":1},{"lineBreak":true},{"text":"காட்டுப்புறாவின் சத்தம் நமது தேசத்தில் கேட்கப்படுகிறது.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அத்திமரம் காய்காய்த்தது;","poem":1},{"lineBreak":true},{"text":"திராட்சைக்கொடிகள் பூப்பூத்து","poem":1},{"lineBreak":true},{"text":"வாசனையும் நறுமணத்தையும் கொடுக்கிறது;","poem":1},{"lineBreak":true},{"text":"என் பிரியமே! என் அழகு மிகுந்தவளே!","poem":1},{"lineBreak":true},{"text":"நீ எழுந்து வா.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"கன்மலையின் வெடிப்புகளிலும்,","poem":1},{"lineBreak":true},{"text":"மலையுச்சிகளின் மறைவிடங்களிலும் தங்குகிற என் புறாவே!","poem":1},{"lineBreak":true},{"text":"உன் முகத்தோற்றத்தை எனக்குக் காட்டு,","poem":1},{"lineBreak":true},{"text":"உன் சத்தத்தை நான் கேட்கட்டும்;","poem":1},{"lineBreak":true},{"text":"உன் சத்தம் இன்பமும்,","poem":1},{"lineBreak":true},{"text":"உன் முகத்தோற்றம் அழகுமாக இருக்கிறது என்றார்.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"திராட்சைத் தோட்டங்களைக் கெடுக்கிற குழிநரிகளையும்","poem":1},{"lineBreak":true},{"text":"சிறுநரிகளையும்","poem":1},{"noteId":7},{"text":"நமக்குப் பிடியுங்கள்;","poem":1},{"lineBreak":true},{"text":"நம்முடைய திராட்சைத்தோட்டங்கள்","poem":1},{"lineBreak":true},{"text":"பூவும் பிஞ்சுமாக இருக்கிறதே.","poem":1},"மணவாளி"]},{"type":"verse","number":16,"content":[{"text":"என் நேசர் என்னுடையவர்,","poem":1},{"lineBreak":true},{"text":"நான் அவருடையவள்.","poem":1},{"lineBreak":true},{"text":"அவர் லீலிமலர்களுக்குள்ளே மேய்கிறார்.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"என் நேசரே! பகல் குளிர்ச்சியாகி,","poem":1},{"lineBreak":true},{"text":"நிழல் சாய்ந்துபோகும்வரைக்கும்,","poem":1},{"lineBreak":true},{"text":"நீர் திரும்பி, குன்றும் பிளப்புமான கன்மலைகளில்","poem":1},{"lineBreak":true},{"text":"குதித்துவரும் கலைமானுக்கும்","poem":1},{"lineBreak":true},{"text":"மரைகளின் குட்டிக்கும் சமானமாக இரும்.","poem":1}]}],"footnotes":[{"noteId":6,"caller":"+","text":"சாரோன் ஒரு இடத்தின் பெயர். இஸ்ரவேல் தேசத்தின் மத்திய தரைக்கடல் (ஏசாயா. 35:2, 65:10). இது சமபூமி. இங்கே கிச்சிலி மரங்கள் அடர்த்தியாக இருந்தன.","reference":{"chapter":2,"verse":1}},{"noteId":7,"caller":"+","text":"இந்த வாலிப பெண்ணை தங்கள் காதலால் இழுக்க பார்க்கும் வாலிப ஆண்களை குறிக்கலாம்.","reference":{"chapter":2,"verse":15}}]},"thisChapterLink":"/api/tam_irv/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}