{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_irv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"1d53a5be14b3492113cda9b0fb4d762241a13857473aa9eacf79091da8b611bb","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"heading","content":["துன்பம் நிறைந்த இரவு"]},{"type":"verse","number":1,"content":[{"text":"இரவுநேரங்களில் என் படுக்கையிலே என் ஆத்தும நேசரைத் தேடினேன்;","poem":1},{"lineBreak":true},{"text":"தேடியும் நான் அவரைக் காணவில்லை.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நான் எழுந்து, நகரத்தின் வீதிகளிலும் தெருக்களிலும் சுற்றி,","poem":1},{"lineBreak":true},{"text":"என் ஆத்தும நேசரைத் தேடுவேன் என்றேன்;","poem":1},{"lineBreak":true},{"text":"தேடியும் நான் அவரைக் காணவில்லை.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நகரத்திலே உலாவுகிற காவலாளர்கள் என்னைக் கண்டார்கள்:","poem":1},{"lineBreak":true},{"text":"என் ஆத்தும நேசரைக் கண்டீர்களா என்று அவர்களைக் கேட்டேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நான் அவர்களைவிட்டுக் கொஞ்சதூரம் சென்றவுடனே,","poem":1},{"lineBreak":true},{"text":"என் ஆத்தும நேசரைக் கண்டேன்;","poem":1},{"lineBreak":true},{"text":"நான் அவரை என் தாயின் வீட்டிலும்,","poem":1},{"lineBreak":true},{"text":"என்னைப் பெற்றவளின் அறையிலும் கொண்டுவந்து விடும்வரைக்கும் அவரை உறுதியாகப் பற்றிக்கொண்டேன்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"எருசலேமின் இளம்பெண்களே!","poem":1},{"lineBreak":true},{"text":"எனக்குப் பிரியமானவர்களுக்கு மனதிருப்தி உண்டாகும்வரை","poem":1},{"lineBreak":true},{"text":"நீங்கள் அவளை விழிக்கச் செய்யாமலும் எழுப்பாமலும் இருக்கும்படி,","poem":1},{"lineBreak":true},{"text":"வெளிமான்கள்மேலும் வெளியின் மரைகள்மேலும்","poem":1},{"lineBreak":true},{"text":"உங்களுக்கு ஆணையிடுகிறேன்.","poem":1},"சாலோமொனின் வருகை மணவாளி"]},{"type":"verse","number":6,"content":[{"text":"வெள்ளைப்போளத்தினாலும் சாம்பிராணியினாலும்","poem":1},{"lineBreak":true},{"text":"வியாபாரிகளுடைய சகலவித கந்தப்பொடியினாலும் உண்டாகிய வாசனையை வீசி,","poem":1},{"lineBreak":true},{"text":"தூபமேகத்தைப்போல் வனாந்திரத்திலிருந்து வருகிற இவர் யார்?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"இதோ, சாலொமோனுடைய படுக்கை;","poem":1},{"lineBreak":true},{"text":"இஸ்ரவேலின் பலசாலிகளில் அறுபது பலசாலிகள் அதைச் சுற்றிலும் நிற்கிறார்கள்.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"இவர்களெல்லோரும் பட்டயம் பிடித்து,","poem":1},{"lineBreak":true},{"text":"போருக்குப் பயிற்சிபெற்றவர்களாக இருக்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"இரவுநேர பயத்தினாலே அவனவனுடைய பட்டயம் அவனவன் இடுப்பிலிருக்கிறது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"சாலொமோன் ராஜா தனக்கு லீபனோனின் மரத்தினால் ஒரு இரதத்தைச் செய்வித்தார்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"அதின் தூண்களை வெள்ளியினாலும்,","poem":1},{"lineBreak":true},{"text":"அதின் தளத்தைப் பொன்னினாலும்,","poem":1},{"lineBreak":true},{"text":"அதின் இருக்கையை இரத்தாம்பரத்தினாலும் செய்வித்தார்;","poem":1},{"lineBreak":true},{"text":"அதின் உட்புறத்திலே எருசலேமின் இளம்பெண்களினிமித்தம்","poem":1},{"lineBreak":true},{"text":"நேசம் என்னும் சமுக்காளம் விரிக்கப்பட்டிருந்தது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"சீயோனின் இளம்பெண்களே! நீங்கள் புறப்பட்டுப்போய்,","poem":1},{"lineBreak":true},{"text":"ராஜாவாகிய சாலொமோனின் திருமணநாளிலும்,","poem":1},{"lineBreak":true},{"text":"மனமகிழ்ச்சியின் நாளிலும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய தாயார் அவருக்கு","poem":1},{"lineBreak":true},{"text":"அணிவித்த கிரீடத்துடன் இருக்கிற அவரைப் பாருங்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}