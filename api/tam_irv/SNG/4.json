{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_irv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"1d53a5be14b3492113cda9b0fb4d762241a13857473aa9eacf79091da8b611bb","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"நீ அழகு மிகுந்தவள், என் பிரியமே! நீ அழகு மிகுந்தவள்;","poem":1},{"lineBreak":true},{"text":"உன் முக்காட்டின் நடுவே உன் கண்கள் புறாக்கண்களைப்போல் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உன் கூந்தல் கீலேயாத் மலையில் இலைகளை மேயும் வெள்ளாட்டு மந்தையைப்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உன்னுடைய பற்கள்,","poem":1},{"lineBreak":true},{"text":"ரோமம் கத்தரிக்கப்பட்டபின் குளிப்பாட்டப்பட்டுக் கரையேறுகிறவைகளும்,","poem":1},{"lineBreak":true},{"text":"ஒன்றாகிலும் மலடாக இல்லாமல் அனைத்தும் இரட்டைக்குட்டி ஈன்றவைகளுமான","poem":1},{"lineBreak":true},{"text":"ஆட்டுமந்தையைப்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உன் உதடுகள் சிவப்பு நூலுக்குச் சமானமும்,","poem":1},{"lineBreak":true},{"text":"உன் வாய் இன்பமுமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உன் முக்காட்டின் நடுவே உன் கன்னங்கள் வெடித்த மாதுளம்பழம்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உன்னுடைய கழுத்து,","poem":1},{"lineBreak":true},{"text":"பராக்கிரமசாலிகளின் ஆயிரம் கேடகங்கள் தூக்கியிருக்கிற ஆயுதசாலையாக்கப்பட்ட","poem":1},{"lineBreak":true},{"text":"தாவீதின் கோபுரம்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உன் இரண்டு மார்பகங்களும்","poem":1},{"lineBreak":true},{"text":"லீலிமலர்களுக்கு இடையில் மேயும்","poem":1},{"lineBreak":true},{"text":"வெளிமானின் இரட்டைக்குட்டிகளுக்குச் சமானம்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"பகல் குளிர்ச்சியாகி நிழல் சாய்ந்துபோகும்வரைக்கும்,","poem":1},{"lineBreak":true},{"text":"நான் வெள்ளைப்போளமலைக்கும் சாம்பிராணிமலைக்கும் போயிருப்பேன்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"என் பிரியமே! நீ பூரண அழகுமிகுந்தவள்;","poem":1},{"lineBreak":true},{"text":"உன்னில் குறையொன்றும் இல்லை.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"லீபனோனிலிருந்து என்னோடே வா,","poem":1},{"lineBreak":true},{"text":"என் மணவாளியே! லீபனோனிலிருந்து என்னோடே வா.","poem":1},{"lineBreak":true},{"text":"அமனாவின் உச்சியிலிருந்தும்,","poem":1},{"lineBreak":true},{"text":"சேனீர் எர்மோனின் உச்சியிலிருந்தும்,","poem":1},{"lineBreak":true},{"text":"சிங்கங்களின் குகைகளிலிருந்தும்,","poem":1},{"lineBreak":true},{"text":"சிறுத்தைகளின் மலைகளிலிருந்தும் கீழே","poem":1},{"noteId":8},{"text":"இறங்கி வா.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என் இருதயத்தைக் கவர்ந்து கொண்டாய்;","poem":1},{"lineBreak":true},{"text":"என் சகோதரியே! என் மணவாளியே!","poem":1},{"lineBreak":true},{"text":"உன் கண்களில் ஒன்றிலும்","poem":1},{"lineBreak":true},{"text":"உன் கழுத்திலுள்ள ஒரு நகையிலும்","poem":1},{"lineBreak":true},{"text":"என் இருதயத்தைக் கவர்ந்துகொண்டாய்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"உன் நேசம் எவ்வளவு இன்பமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"என் சகோதரியே! என் மணவாளியே!","poem":1},{"lineBreak":true},{"text":"திராட்சைரசத்தைவிட","poem":1},{"lineBreak":true},{"text":"உன் நேசம் எவ்வளவு இனிமையாக இருக்கிறது!","poem":1},{"lineBreak":true},{"text":"சகல கந்தவர்க்கங்களைவிட","poem":1},{"lineBreak":true},{"text":"உன் நறுமண தைலங்கள் எவ்வளவு வாசனையாயிருக்கிறது!","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"என் மணவாளியே! உன் உதடுகளிலிருந்து தேன் ஒழுகுகிறது,","poem":1},{"lineBreak":true},{"text":"உன் நாவின்கீழ் தேனும் பாலும் இருக்கிறது,","poem":1},{"lineBreak":true},{"text":"உன் உடைகளின் வாசனை லீபனோனின் வாசனைக்கு ஒப்பாக இருக்கிறது.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என் சகோதரியே! என் மணவாளியே!","poem":1},{"lineBreak":true},{"text":"நீ அடைக்கப்பட்ட தோட்டமும்,","poem":1},{"lineBreak":true},{"text":"மறைவு கட்டப்பட்ட நீரூற்றும்,","poem":1},{"lineBreak":true},{"text":"பாதுகாக்கப்பட்ட கிணறுமாக இருக்கிறாய்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"உன் தோட்டம் மாதுளம்செடிகளும்,","poem":1},{"lineBreak":true},{"text":"அருமையான பழமரங்களும்,","poem":1},{"lineBreak":true},{"text":"மருதாணிச் செடிகளும், நளதச்செடிகளும்,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நளதமும், குங்குமமும், வசம்பும், லவங்கமும்,","poem":1},{"lineBreak":true},{"text":"சகலவித தூபவர்க்க மரங்களும், வெள்ளைப்போளச்செடிகளும்,","poem":1},{"lineBreak":true},{"text":"சந்தன மரங்களும், சகலவித கந்தவர்க்கச் செடிகளுமுள்ள சிங்கார வனமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"தோட்டங்களுக்கு நீரூற்றும், ஜீவதண்ணீரின் கிணறும்,","poem":1},{"lineBreak":true},{"text":"லீபனோனிலிருந்து ஓடிவரும் வாய்க்கால்களும் உண்டாயிருக்கிறது.","poem":1},"மணவாளி"]},{"type":"verse","number":16,"content":[{"text":"வாடைக்காற்றே! எழும்பு;","poem":1},{"lineBreak":true},{"text":"தென்றலே! வா; கந்தப்பிசின்கள் வடிய என் தோட்டத்தில் வீசு;","poem":1},{"lineBreak":true},{"text":"என் நேசர் தம்முடைய தோட்டத்திற்கு வந்து,","poem":1},{"lineBreak":true},{"text":"தமது அருமையான பழங்களைச் சாப்பிடுவாராக.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"கீழே பார்","reference":{"chapter":4,"verse":8}}]},"thisChapterLink":"/api/tam_irv/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}