{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_irv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"1d53a5be14b3492113cda9b0fb4d762241a13857473aa9eacf79091da8b611bb","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"உன் நேசர் எங்கே போனார்?","poem":1},{"lineBreak":true},{"text":"பெண்களில் அழகுமிகுந்தவளே!","poem":1},{"lineBreak":true},{"text":"உன் நேசர் எவ்விடம் போய்விட்டார்?","poem":1},{"lineBreak":true},{"text":"உன்னோடேகூட நாங்களும் அவரைத் தேடுவோம்.","poem":1},"மணவாளி"]},{"type":"verse","number":2,"content":["தோட்டங்களில் மேயவும், லீலிமலர்களைப் பறிக்கவும்,",{"text":"என் நேசர் தமது தோட்டத்திற்கும் கந்தவர்க்கப் பாத்திகளுக்கும் போனார்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"நான் என் நேசருடையவள், என் நேசர் என்னுடையவர்;","poem":1},{"lineBreak":true},{"text":"அவர் லீலிமலர்களுக்குள்ளே மேய்கிறார்.","poem":1},"சூலமித்தியாளின் அழகு மணவாளன்"]},{"type":"verse","number":4,"content":[{"text":"என் பிரியமே! நீ திர்சாவைப்போல் அழகும்,","poem":1},{"lineBreak":true},{"text":"எருசலேமைப்போல் வடிவமும்,","poem":1},{"lineBreak":true},{"text":"கொடிகள் பறக்கும் படையைப்போல் பயங்கரமானவள்.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உன் கண்களை என்னைவிட்டுத் திருப்பு,","poem":1},{"lineBreak":true},{"text":"அவைகள் என்னை வென்றது;","poem":1},{"lineBreak":true},{"text":"உன் கருமையான கூந்தல்","poem":1},{"lineBreak":true},{"text":"கீலேயாத் மலையிலே இலைகள்மேயும் வெள்ளாட்டு மந்தையைப்போலிருக்கிறது.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"உன் பற்கள் குளிப்பாட்டப்பட்டுக் கரையேறுகிறவைகளும்,","poem":1},{"lineBreak":true},{"text":"ஒன்றாகிலும் மலடாக இல்லாமல்","poem":1},{"lineBreak":true},{"text":"இரட்டைக்குட்டிகளை ஈன்றவைகளுமான ஆட்டுமந்தையைப்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உன் முக்காட்டின் நடுவே உன் கன்னங்கள் வெடித்த மாதுளம்பழம்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"ராணிகள் அறுபதுபேரும்,","poem":1},{"lineBreak":true},{"text":"மறுமனையாட்டிகள் எண்பதுபேருமுண்டு;","poem":1},{"lineBreak":true},{"text":"கன்னியர்களுக்குத் தொகையில்லை.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"என் புறாவோ, என் உத்தமியோ ஒருத்தியே;","poem":1},{"lineBreak":true},{"text":"அவள் தன் தாய்க்கு ஒரே பிள்ளை;","poem":1},{"lineBreak":true},{"text":"அவள் தன்னைப் பெற்றவளுக்கு அருமையானவள்;","poem":1},{"lineBreak":true},{"text":"இளம்பெண்கள் அவளைக் கண்டு, அவளை வாழ்த்தினார்கள்;","poem":1},{"lineBreak":true},{"text":"ராணிகளும் மறுமனையாட்டிகளும் அவளைப் போற்றினார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"சந்திரனைப்போல் அழகும், சூரியனைப்போல் பிரகாசமும்,","poem":1},{"lineBreak":true},{"text":"கொடிகள் பறக்கும் படையைப்போல் பயங்கரமானவளாக,","poem":1},{"lineBreak":true},{"text":"சூரிய உதயம்போல் உதிக்கிற இவள் யார்?","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"பள்ளத்தாக்கிலே பழுத்த பழங்களைப் பார்க்கவும்,","poem":1},{"lineBreak":true},{"text":"திராட்சைச்செடிகள் துளிர்விட்டு, மாதுளம்செடிகள் பூத்ததா என்று அறியவும்,","poem":1},{"lineBreak":true},{"text":"வாதுமைத் தோட்டத்திற்குப் போனேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"நினைக்காததற்குமுன்னே","poem":1},{"lineBreak":true},{"text":"என் ஆத்துமா என்னை அம்மினதாபின் இரதங்களுக்கு ஒப்பாக்கினது.","poem":1},"மணவாளியின் தோழிகள்"]},{"type":"verse","number":13,"content":[{"text":"திரும்பிவா, திரும்பிவா,","poem":1},{"lineBreak":true},{"text":"சூலமித்தியே! நாங்கள் உன்னைப் பார்க்கும்படிக்கு,","poem":1},{"lineBreak":true},{"text":"திரும்பிவா, திரும்பிவா.","poem":1},"மணவாளி",{"text":"சூலமித்தியில் நீங்கள் என்னத்தைப் பார்க்கிறீர்கள்?","poem":1},{"lineBreak":true},{"text":"அவள் இரண்டு படையின் கூட்டத்திற்குச் சமானமானவள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_irv/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}