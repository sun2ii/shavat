{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_irv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"1d53a5be14b3492113cda9b0fb4d762241a13857473aa9eacf79091da8b611bb","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"heading","content":["சூலமித்தியாள் புகழப்படுதல்"]},{"type":"verse","number":1,"content":[{"text":"இளவரசியே! காலணிகள் அணிந்த உன் பாதங்கள்","poem":1},{"lineBreak":true},{"text":"மிகவும் அழகாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உன் இடுப்பின் வடிவு திறமைமிக்க","poem":1},{"lineBreak":true},{"text":"தொழிற்காரர்களின் வேலையாகிய அணிகலன்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"உன் தொப்புள் திராட்சைரசம் நிறைந்த வட்டவடிவக் கிண்ணம்போல் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உன் வயிறு லீலிமலர்கள் சூழ்ந்த கோதுமைக் குவியல்போல் இருக்கிறது.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"உன் இரண்டு மார்பகங்களும்","poem":1},{"lineBreak":true},{"text":"வெளிமானின் இரட்டைக்குட்டிகளுக்குச் சமானமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"உன் கழுத்து யானைத்தந்தத்தினால் செய்த கோபுரத்தைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"உன் கண்கள் எஸ்போனிலே பத்ரபீம்","poem":1},{"lineBreak":true},{"text":"வாசலின் அருகிலிருக்கும் குளங்களைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"உன் மூக்கு தமஸ்குவின் திசையை நோக்கும்","poem":1},{"lineBreak":true},{"text":"லீபனோனின் கோபுரத்தைப்போலவும் இருக்கிறது.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"உன் தலை கர்மேல் மலையைப்போல் இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"உன் தலைமுடி இரத்தாம்பரமயமாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"ராஜா உன் கூந்தலின் அழகில் மயங்கி நிற்கிறார்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"மனமகிழ்ச்சியை உண்டாக்கும் என் பிரியமே!","poem":1},{"lineBreak":true},{"text":"நீ எவ்வளவு அழகுமிகுந்தவள்,","poem":1},{"lineBreak":true},{"text":"நீ எவ்வளவு இன்பமுள்ளவள்.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"உன் உயரம் பனைமரத்தைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"உன் மார்பகங்கள் திராட்சைக்குலைகள்போலவும் இருக்கிறது.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"நான் பனைமரத்தில் ஏறி,","poem":1},{"lineBreak":true},{"text":"அதின் மடல்களைப் பிடிப்பேன் என்றேன்;","poem":1},{"lineBreak":true},{"text":"இப்பொழுதும் உன் மார்பகங்கள் திராட்சைக்குலைகள்போலவும்,","poem":1},{"lineBreak":true},{"text":"உன் மூக்கின் சுவாசத்தின் வாசனை கிச்சிலிப்பழங்கள்போலவும் இருக்கிறது.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"13 உன் முத்தங்கள், என் நேசர் குடிக்கும்போது மெதுவாக இறங்குகிறதும்,","poem":1},{"lineBreak":true},{"text":"உறங்குகிறவர்களின் உதடுகளைப் பேசச்செய்கிறதுமான,","poem":1},{"lineBreak":true},{"text":"நல்ல திராட்சைரசத்தைப்போல் இருக்கிறது.","poem":1},"மணவாளி"]},{"type":"verse","number":10,"content":[{"text":"நான் என் நேசருடையவள்,","poem":1},{"lineBreak":true},{"text":"அவருடைய பிரியம் என்மேல் இருக்கிறது.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"வாரும் என் நேசரே! வயல்வெளிக்குப் போய்,","poem":1},{"lineBreak":true},{"text":"கிராமங்களில் தங்குவோம்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"அதிகாலையிலே திராட்சைத்தோட்டங்களுக்குப் போவோம்;","poem":1},{"lineBreak":true},{"text":"திராட்சைக்கொடி துளிர்த்து அதின் பூ மலர்ந்ததோ என்றும்,","poem":1},{"lineBreak":true},{"text":"மாதுளம்செடிகள் பூ பூத்ததோ என்றும் பார்ப்போம்;","poem":1},{"lineBreak":true},{"text":"அங்கே என் நேசத்தின் உச்சிதங்களை உமக்குத் தருவேன்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தூதாயீம் பழம்","poem":1},{"noteId":9},{"text":"வாசனை வீசும்;","poem":1},{"lineBreak":true},{"text":"நமது வாசல்களின் அருகில் புதியவைகளும் பழையவைகளுமான சகலவித அருமையான பழங்களும் உண்டு;","poem":1},{"lineBreak":true},{"text":"என் நேசரே! அவைகளை உமக்கு வைத்திருக்கிறேன்.","poem":1}]}],"footnotes":[{"noteId":9,"caller":"+","text":"மாதுளம்செடிகள், இனிமையும் வாசனையுமான ஒரு செடி, இதின் பழம் பால் உணர்வை, தூண்டி மலட்டுத்தன்மை நீக்க கூடியது என்று கருதப்படுகிறது. ஆதி 30: 14-16.","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/tam_irv/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}