{"translation":{"id":"tam_irv","name":"இண்டியன் ரிவைஸ்டு வெர்ஸன் (IRV) - தமிழ்","website":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tam2017","licenseNotes":null,"shortName":"IRV","englishName":"Tamil Indian Revised Version Bible","language":"tam","textDirection":"ltr","sha256":"32fbfbedbc5995e48a79b95efcc931eb07155af1d6a8246d02036bc9e7c81914","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_irv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31103,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_irv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"1d53a5be14b3492113cda9b0fb4d762241a13857473aa9eacf79091da8b611bb","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_irv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_irv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"ஆ, நீர் என் தாயின் பால்குடித்த என் சகோதரனைப்போல் இருந்தீரானால்,","poem":1},{"lineBreak":true},{"text":"நான் உம்மை வெளியிலே சந்தித்து முத்தமிடுவேன்;","poem":1},{"lineBreak":true},{"text":"என்னை நிந்திக்கவுமாட்டார்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"நான் உம்மைக் கூட்டிக்கொண்டு,","poem":1},{"lineBreak":true},{"text":"என் தாயின் வீட்டுக்கு அழைத்துக்கொண்டுபோவேன்;","poem":1},{"lineBreak":true},{"text":"நீர் எனக்குப் போதிப்பீர், கந்தவர்க்கமிட்ட திராட்சைரசத்தையும்,","poem":1},{"lineBreak":true},{"text":"என் மாதுளம்பழரசத்தையும் உமக்குக் குடிக்கக்கொடுப்பேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவருடைய இடதுகை என் தலையின்கீழ் இருக்கும்,","poem":1},{"lineBreak":true},{"text":"அவருடைய வலதுகை என்னை அணைக்கும்.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"எருசலேமின் இளம்பெண்களே!","poem":1},{"lineBreak":true},{"text":"எனக்குப் பிரியமானவளுக்கு மனதிருப்தி உண்டாகும்வரை","poem":1},{"lineBreak":true},{"text":"நீங்கள் அவளை விழிக்கச் செய்யாமலும் எழுப்பாமலும் இருக்க","poem":1},{"lineBreak":true},{"text":"உங்களுக்கு ஆணையிடுகிறேன்.","poem":1},"அன்பு புதுப்பிக்கப்படுதல் மணவாளியின் தோழிகள்"]},{"type":"verse","number":5,"content":[{"text":"தன் நேசர்மேல் சார்ந்துகொண்டு","poem":1},{"lineBreak":true},{"text":"வனாந்திரத்திலிருந்து வருகிற இவள் யார்?","poem":1},"மணவாளி",{"text":"கிச்சிலிமரத்தின்கீழ் உம்மை எழுப்பினேன்;","poem":1},{"lineBreak":true},{"text":"அங்கே உமது தாய் உம்மைப் பெற்றாள்;","poem":1},{"lineBreak":true},{"text":"அங்கே உம்மைப் பெற்றவள் வேதனைப்பட்டு உம்மைப் பெற்றாள்.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"நீர் என்னை உமது இருதயத்தின்மேல் முத்திரையைப்போலவும்,","poem":1},{"lineBreak":true},{"text":"உமது புயத்தின்மேல் முத்திரையைப்போலவும் வைத்துக்கொள்ளும்;","poem":1},{"lineBreak":true},{"text":"நேசம் மரணத்தைப்போல் வலிமையானது;","poem":1},{"lineBreak":true},{"text":"நேசவைராக்கியம் பாதாளத்தைப்போல் கொடியதாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"அதின் தழல் அக்கினித்தழலும் அதின் சுடர் கடும் சுடரொளியுமாக இருக்கிறது.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"திரளான தண்ணீர்கள் நேசத்தை அணைத்துவிட முடியாது,","poem":1},{"lineBreak":true},{"text":"வெள்ளங்களும் அதைத் தணிக்கமுடியாது;","poem":1},{"lineBreak":true},{"text":"ஒருவன் தன் வீட்டிலுள்ள சொத்துக்களையெல்லாம் நேசத்திற்காகக் கொடுத்தாலும்,","poem":1},{"lineBreak":true},{"text":"அது முற்றிலும் அசட்டைசெய்யப்படும்","poem":1},{"noteId":10},{"text":".","poem":1},"மணவாளியின் சகோதரன்"]},{"type":"verse","number":8,"content":[{"text":"நமக்கு ஒரு சிறிய சகோதரி உண்டு,","poem":1},{"lineBreak":true},{"text":"அவளுக்கு மார்பகங்கள் இல்லை;","poem":1},{"lineBreak":true},{"text":"நம்முடைய சகோதரியைக் கேட்கும் நாளில் அவளுக்காக நாம் என்ன செய்வோம்?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவள் ஒரு மதிலானால்,","poem":1},{"lineBreak":true},{"text":"அதின்மேல் வெள்ளிக்கோட்டையைக் கட்டுவோம்;","poem":1},{"lineBreak":true},{"text":"அவள் கதவானால், கேதுருப்பலகைகளை அதற்கு இணைப்போம்.","poem":1},"மணவாளி"]},{"type":"verse","number":10,"content":[{"text":"நான் மதில்தான்,","poem":1},{"lineBreak":true},{"text":"என் மார்பகங்கள் கோபுரங்கள்;","poem":1},{"lineBreak":true},{"text":"அவருடைய கண்களில் இரக்கம் பெறலானேன்.","poem":1},"மணவாளன்"]},{"type":"verse","number":11,"content":[{"text":"பாகால் ஆமோனிலே சாலொமோனுக்கு ஒரு திராட்சைத்தோட்டம் உண்டாயிருந்தது,","poem":1},{"lineBreak":true},{"text":"அந்தத் தோட்டத்தைக் காவலாளிகள் வசத்திலே அதின் பலனுக்காக,","poem":1},{"lineBreak":true},{"text":"ஒவ்வொருவன் ஆயிரம் வெள்ளிக்காசுகளைக்","poem":1},{"noteId":11},{"text":"கொண்டுவரும்படி விட்டார்.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"என் திராட்சைத்தோட்டம் எனக்கு முன்பாக இருக்கிறது;","poem":1},{"lineBreak":true},{"text":"சாலொமோனே! உமக்கு அந்த ஆயிரமும்,","poem":1},{"lineBreak":true},{"text":"அதின் பழத்தைக் காக்கிறவர்களுக்கு இருநூறும் சேரும்.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"தோட்டங்களில் குடியிருக்கிறவளே!","poem":1},{"lineBreak":true},{"text":"தோழர்கள் உன் சத்தத்தைக் கேட்கிறார்கள்;","poem":1},{"lineBreak":true},{"text":"நானும் அதைக் கேட்கட்டும்.","poem":1},"மணவாளி"]},{"type":"verse","number":14,"content":[{"text":"என் நேசரே! விரைவாக வாரும்,","poem":1},{"lineBreak":true},{"text":"கந்தவர்க்கங்களின் மலைகள்மேல் உள்ள","poem":1},{"lineBreak":true},{"text":"வெளிமானுக்கும் மான் குட்டிக்கும் சமானமாக இரும்.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"அவன் முற்றிலும் அசட்டைசெய்யப்படும்","reference":{"chapter":8,"verse":7}},{"noteId":11,"caller":"+","text":"கிராம வேலைக்காரனின் ஒரு நாள் கூலி","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/tam_irv/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_irv/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_irv/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}