{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"2SA","translationId":"tam_tcv","name":"2 சாமுயேல்","commonName":"2 சாமுயேல்","title":"சாமுயேலின் இரண்டாம் புத்தகம்","order":10,"numberOfChapters":24,"sha256":"f7895abf0f750725fc3381fe22b093d58d7555034afe98f970e437726231620c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/2SA/1.json","lastChapterNumber":24,"lastChapterApiLink":"/api/tam_tcv/2SA/24.json","totalNumberOfVerses":695},"chapter":{"number":22,"content":[{"type":"heading","content":["தாவீதின் நன்றிப்பாடல்"]},{"type":"verse","number":1,"content":["யெகோவா அவனை எல்லாப் பகைவரின் கைகளிலிருந்தும் சவுலின் கையிலிருந்தும் விடுவித்தபோது இப்பாடலின் வார்த்தைகளை தாவீது யெகோவாவுக்குப் பாடினான்."]},{"type":"verse","number":2,"content":["அவன் சொன்னது:",{"text":"“யெகோவா என் கன்மலை, என் கோட்டை, என்னை விடுவிக்கிறவர்;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"என் இறைவன் நான் தஞ்சம் அடையும் என் கன்மலை,","poem":2},{"lineBreak":true},{"text":"என் கேடயம், என் மீட்பின் கொம்பு.","poem":2},{"text":"என் அரண், என் அடைக்கலம்,","poem":1},{"text":"நீர் என்னை வன்முறையாளர்களிடமிருந்து காப்பாற்றுகிற என் இரட்சகர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“துதிக்கப்படத்தக்கவரான யெகோவாவை நோக்கி நான் கூப்பிடுகிறேன்;","poem":1},{"text":"என் பகைவரிடமிருந்து நான் காப்பாற்றப்படுகிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"மரண அலைகள் என்னைச் சூழ்ந்துகொண்டன,","poem":1},{"text":"அழிவின் அலைகள் என்னை அமிழ்த்திவிட்டன.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"பிரேதக் குழியின் கயிறுகள் என்னைச் சூழ்ந்துகொண்டன;","poem":1},{"text":"மரணத்தின் கண்ணிகள் என்னை எதிர்த்து வந்தன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“என் துயரத்தில் நான் யெகோவாவை நோக்கிக் கூப்பிட்டேன்.","poem":1},{"text":"என் இறைவனை நோக்கிக் கூப்பிட்டேன்.","poem":2},{"text":"அவர் தமது ஆலயத்திலிருந்து என் குரலைக் கேட்டார்.","poem":1},{"text":"என் அழுகுரல் அவர் செவிகளில் எட்டியது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பூமி நடுங்கி அதிர்ந்து,","poem":1},{"text":"வானத்தின் அஸ்திபாரங்கள் அசைந்தன;","poem":2},{"lineBreak":true},{"text":"அவர் கோபமடைந்ததால் அவை நடுங்கின.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவருடைய நாசியிலிருந்து புகை எழும்பிற்று;","poem":1},{"text":"அவருடைய வாயிலிருந்து சுட்டெரிக்கும் நெருப்புப் புறப்பட்டது;","poem":2},{"lineBreak":true},{"text":"நெருப்புத் தழல் அதிலிருந்து தெறித்தன.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் வானங்களைப் பிரித்து, கீழே இறங்கினார்;","poem":1},{"text":"கார்மேகங்கள் அவருடைய பாதங்களின்கீழ் இருந்தன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர் கேருபீனின்மேல் ஏறிப் பறந்தார்;","poem":1},{"text":"அவர் காற்றின் சிறகுகளைக்கொண்டு பறந்தார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் இருளைத் தன்னைச் சுற்றி ஒரு கூடாரமாக்கினார்.","poem":1},{"text":"வானத்தின் இருண்ட மழைமேகங்கள் அவரைச் சுற்றியிருந்தது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவரின் சமுகத்தின் பிரகாசத்திலிருந்து","poem":1},{"text":"மின்னலின் தாக்குதல் வீசுண்டன.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவா வானத்திலிருந்து இடியை முழக்கினார்;","poem":1},{"text":"மகா உன்னதமானவரின் குரல் எதிரொலித்தது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர் தமது அம்புகளை எய்து பகைவரைச் சிதறடித்தார்;","poem":1},{"text":"மின்னல் கீற்றுக்களை அனுப்பி, அவர்களை முறியடித்தார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யெகோவாவினுடைய நாசியிலிருந்து வந்த மூச்சின் தாக்கத்தாலும்","poem":1},{"text":"அவரின் கண்டிப்பினாலும்","poem":2},{"text":"கடல்களின் அடிப்பரப்பு வெளிப்பட்டன;","poem":1},{"text":"பூமியின் அஸ்திபாரங்கள் வெளியே தெரிந்தன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“அவர் என்னை உயரத்திலிருந்து எட்டிப் பிடித்தார்;","poem":1},{"text":"ஆழமான தண்ணீரிலிருந்து என்னை வெளியே தூக்கினார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர் சக்திவாய்ந்த என் பகைவனிடமிருந்தும்","poem":1},{"text":"என்னிலும் அதிகம் பலமான எதிரிகளிடமிருந்தும் என்னைத் தப்புவித்தார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர்கள் என்னுடைய பேராபத்தின் நாளிலே, எனக்கெதிராய் எழுந்தார்கள்;","poem":1},{"text":"ஆனால் யெகோவா என் ஆதரவாயிருந்தார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர் என்னை விசாலமான ஒரு இடத்திற்கு வெளியே கொண்டுவந்தார்;","poem":1},{"text":"அவர் என்னில் பிரியமாய் இருந்தபடியால் என்னைத் தப்புவித்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“யெகோவா என் நீதிக்கு ஏற்றபடி என்னை நடத்தியிருக்கிறார்;","poem":1},{"text":"என் கைகளின் சுத்தத்திற்கு தக்கதாய், அவர் எனக்குப் பலனளித்திருக்கிறார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஏனெனில் நான் யெகோவாவினுடைய வழிகளை கைக்கொண்டிருக்கிறேன்;","poem":1},{"text":"என் இறைவனைவிட்டு விலகி நான் குற்றம் செய்யவில்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவருடைய நீதிநெறிகள் அனைத்தும் எனக்கு முன்பாக இருக்கின்றன;","poem":1},{"text":"அவருடைய விதிமுறைகளிலிருந்து நான் விலகவேயில்லை.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நான் அவருக்கு முன்பாக குற்றமற்றவனாக இருந்து,","poem":1},{"text":"பாவத்திலிருந்து என்னை விலக்கிக் காத்துக்கொண்டேன்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"யெகோவா என் நீதிக்கு ஏற்றவாறு பலனளித்திருக்கிறார்;","poem":1},{"text":"அவருடைய பார்வையில் நான் குற்றமற்றவனாயிருந்தேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“உண்மையுள்ளவர்களுக்கு நீர் உம்மை உண்மையுள்ளவராகவே காண்பிக்கிறீர்;","poem":1},{"text":"உத்தமர்களுக்கு நீர் உம்மை உத்தமராகவே காண்பிக்கிறீர்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"தூய்மையுள்ளவர்களுக்கு நீர் உம்மைத் தூய்மையுள்ளவராகவேக் காண்பிக்கிறீர்;","poem":1},{"text":"ஆனால் கபடமுள்ளவர்களுக்கோ நீர் உம்மை விவேகமுள்ளவராய்க் காண்பிக்கிறீர்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நீர் தாழ்மையுள்ளோரைக் காப்பாற்றுகிறீர்;","poem":1},{"text":"ஆனால் உம்முடைய கண்கள் பெருமையுள்ளவர்களைச் சிறுமைப்படுத்தும்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"யெகோவாவே, நீர் என் விளக்கு;","poem":1},{"text":"யெகோவா என் இருளை வெளிச்சமாக்குகிறார்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"உமது உதவியுடன் என்னால் ஒரு படையை எதிர்த்து முன்னேற முடியும்;","poem":1},{"text":"என் இறைவனுடன் ஒரு மதிலைத் தாண்டுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“இறைவனுடைய வழி முழு நிறைவானது:","poem":1},{"text":"யெகோவாவின் வார்த்தையோ குறைபாடற்றது;","poem":2},{"lineBreak":true},{"text":"அவரிடத்தில் தஞ்சமடைவோர் அனைவருக்கும் அவர் கேடயமாயிருக்கிறார்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"யெகோவாவைத்தவிர இறைவன் யார்?","poem":1},{"text":"நமது இறைவனேயல்லாமல் வேறு கன்மலை யார்?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"இறைவன் எனக்கு பெலமுள்ள கோட்டையாய் இருந்து,","poem":1},{"text":"என் வழியை குறைவற்றதாய் ஆக்குகிறார்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"அவர் என் கால்களை மானின் கால்களைப் போல துரிதப்படுத்தி,","poem":1},{"text":"உயர்ந்த இடங்களில் என்னை நிற்கப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"யுத்தம் செய்ய என் கைகளைப் பயிற்றுவிக்கிறார்;","poem":1},{"text":"என் கரங்களால் ஒரு வெண்கல வில்லையும் வளைக்க முடியும்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"நீர் உமது இரட்சிப்பை எனக்கு கேடயமாகத் தந்தீர்,","poem":1},{"text":"உமது உதவி என்னைப் பெரியவனாக்குகிறது.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"என் கணுக்கால்கள் புரளாதபடி,","poem":1},{"text":"நான் நடக்கும் பாதையை நீர் அகலமாக்குகிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"“நான் என் பகைவரை துரத்திச்சென்று, அவர்களை அழித்துப்போட்டேன்;","poem":1},{"text":"அவர்கள் முற்றிலும் அழியும்வரை, நான் திரும்பி வரவில்லை.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"அவர்கள் எழுந்திருக்காதபடி நான் அவர்களை முழுவதும் நசுக்கினேன்;","poem":1},{"text":"அவர்கள் என் காலடியில் விழுந்தார்கள்.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"யுத்தம் செய்வதற்கான வல்லமையை நீர் எனக்குத் தரிப்பித்தீர்;","poem":1},{"text":"என் எதிரிகளை எனக்கு முன்பாகத் தாழ்த்தினீர்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"நீர் என் பகைவரை புறமுதுகிட்டு ஓடச்செய்தீர்;","poem":1},{"text":"நான் அவர்களை அழித்தேன்.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"அவர்கள் உதவிகேட்டு கூப்பிட்டார்கள்,","poem":1},{"text":"ஆனால் அவர்களைக் காப்பாற்ற ஒருவருமே இருக்கவில்லை;","poem":2},{"lineBreak":true},{"text":"யெகோவாவை நோக்கிக் கூப்பிட்டார்கள், அவரோ பதில் கொடுக்கவில்லை.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"நான் அவர்களை அடித்துப் பூமியின் புழுதியைப்போலாக்கினேன்;","poem":1},{"text":"நான் அவர்களை மிதித்து வீதியிலுள்ள சேற்றைப்போல் வெளியே வாரியெறிந்தேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":44,"content":[{"text":"“நீர் மக்களின் தாக்குதல்களிலிருந்து என்னை விடுவித்திருக்கிறீர்;","poem":1},{"text":"நாடுகளுக்கு என்னைத் தலைவனாக வைத்திருக்கிறீர்.","poem":2},{"text":"நான் அறியாத மக்கள் எனக்கு கீழ்ப்பட்டிருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":45,"content":[{"text":"வேறுநாட்டைச் சேர்ந்தவரும் எனக்கு முன்பாக அடங்கி ஒடுங்குகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் என்னைக் குறித்துக் கேள்விப்பட்டவுடனே எனக்குக் கீழ்ப்படிகிறார்கள்.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"அவர்கள் அனைவரும் மனந்தளர்ந்து,","poem":1},{"text":"தங்கள் அரண்களிலிருந்து நடுக்கத்துடன் வருகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“யெகோவா வாழ்கிறார்! என் கன்மலையானவருக்குத் துதி உண்டாவதாக!","poem":1},{"text":"என் கன்மலையும் இரட்சகருமாகிய இறைவன் உயர்த்தப்படுவாராக!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"எனக்காகப் பழிவாங்கும் இறைவன் அவரே,","poem":1},{"text":"நாடுகளை எனக்குக்கீழ் வைக்கிறவர் அவரே.","poem":2}]},{"type":"verse","number":49,"content":[{"lineBreak":true},{"text":"அவர் என்னை என் பகைவரிடமிருந்து விடுவித்தார்.","poem":2},{"text":"யெகோவாவே நீர் என்னை என் எதிரிகளுக்கு மேலாக உயர்த்தியிருக்கிறீர்.","poem":1},{"text":"என்னை வன்முறையாளர்களிடமிருந்து பாதுகாத்தீர்.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"ஆகையால் யெகோவாவே, நாடுகளுக்கு மத்தியில் நான் உம்மைத் துதிப்பேன்;","poem":1},{"text":"உமது பெயருக்குத் துதிகள் பாடுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“அவர் தாம் ஏற்படுத்திய அரசனுக்கு மாபெரும் வெற்றிகளைக் கொடுக்கிறார்;","poem":1},{"text":"அவர் தாம் அபிஷேகம் பண்ணின தாவீதுக்கும் அவனுடைய சந்ததிகளுக்கும்","poem":2},{"lineBreak":true},{"text":"தமது உடன்படிக்கையின் அன்பை என்றைக்கும் காண்பிக்கிறார்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/2SA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/2SA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/2SA/21.json","previousChapterAudioLinks":{},"numberOfVerses":51}