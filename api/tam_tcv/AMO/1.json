{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"AMO","translationId":"tam_tcv","name":"ஆமோஸ்","commonName":"ஆமோஸ்","title":"ஆமோஸ்","order":30,"numberOfChapters":9,"sha256":"0f3ab8673f8f4eaf8990560b2bdd0a84821d6570e5be52ee68b317788ed44866","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tam_tcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["தெக்கோவா ஊர் மேய்ப்பருக்குள் இருந்த ஆமோஸ், பூமியதிர்ச்சி உண்டாவதற்கு இரண்டு வருடங்களுக்கு முன்னர், இஸ்ரயேலரைக் குறித்து அவன் தரிசனங்கண்டு சொன்ன வார்த்தைகள்: அக்காலத்தில் உசியா, யூதாவுக்கு அரசனாகவும், யோவாசின் மகன் யெரொபெயாம் இஸ்ரயேலுக்கு அரசனாகவுமிருந்தார்கள்."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":["அவன் சொன்னதாவது:",{"text":"“யெகோவா சீயோனிலிருந்து கர்ஜிக்கிறார்;","poem":1},{"text":"எருசலேமிலிருந்து முழங்குகிறார்.","poem":2},{"text":"மேய்ப்பர்களின் மேய்ச்சல் நிலங்கள் உலர்ந்து போகின்றன.","poem":1},{"text":"கர்மேல் மலையுச்சியும் காய்ந்து போகிறது.”","poem":2}]},{"type":"heading","content":["இஸ்ரயேலரின் அயலவர்மேல் நியாயத்தீர்ப்பு"]},{"type":"verse","number":3,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“தமஸ்குவினுடைய மூன்று பாவங்களுக்காகவும் நான்கு பாவங்களுக்காகவும்,","poem":1},{"lineBreak":true},{"text":"என் கோபத்தை நான் விலக்கமாட்டேன்.","poem":1},{"text":"ஏனென்றால் அவர்கள் கீலேயாத்தை இரும்பு பற்களுள்ள கருவிகளால் போரடித்தார்களே.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆசகேலின் வீட்டின்மேல் நெருப்பை அனுப்புவேன்.","poem":1},{"text":"அது அவனுடைய மகன் பெனாதாதின் அரண்களையும் எரித்துப்போடும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தமஸ்குவின் வாசலை நான் உடைப்பேன்.","poem":1},{"text":"ஆவேன் பள்ளத்தாக்கிலுள்ள அரசனை அழித்து,","poem":2},{"text":"பெத் ஏதேனில் செங்கோல் பிடிப்பவனையும் அழிப்பேன்;","poem":1},{"text":"ஆராமின் மக்களை கீருக்கு நாடுகடத்துவேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“காசா பட்டணம் திரும்பதிரும்ப செய்த","poem":1},{"text":"அநேக பாவங்களின் நிமித்தம்,","poem":2},{"text":"என் கோபத்தை நான் விலக்கமாட்டேன்.","poem":1},{"text":"ஏனெனில் அவர்கள் முழுச்சமுதாயத்தையும் சிறைப்பிடித்து ஏதோமியரிடம் விற்றார்களே.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"காசாவின் மதில்களின்மேல் நெருப்பை அனுப்புவேன்;","poem":1},{"text":"அது அதன் அரண்களை சுட்டெரிக்கும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அஸ்தோத்தின் அரசனை நான் அழிப்பேன்.","poem":1},{"text":"அஸ்கலோனில் செங்கோல் பிடிப்பவனையும் ஒழிப்பேன்.","poem":2},{"text":"பெலிஸ்தியரில் கடைசியாய் இருப்பவன் சாகும்வரைக்கும்,","poem":1},{"text":"எக்ரோனுக்கெதிராக என் கரத்தை நீட்டுவேன்”","poem":2},{"lineBreak":true},{"text":"என்று ஆண்டவராகிய யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“தீருவினுடைய மூன்று பாவங்களுக்காகவும், நான்கு பாவங்களுக்காகவும்,","poem":1},{"text":"என் கோபத்தை நான் விலக்கமாட்டேன்.","poem":2},{"text":"ஏனென்றால் சகோதர உடன்படிக்கையை உதாசீனம் செய்து,","poem":1},{"text":"சிறைப்பிடிக்கப்பட்ட முழுச்சமுதாயத்தையும் ஏதோமுக்கு விற்றார்களே.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"தீருவின் மதில்கள்மேல் நெருப்பை அனுப்புவேன்.","poem":1},{"text":"அது அதன் அரண்களையெல்லாம் சுட்டெரிக்கும்.”","poem":2}]},{"type":"verse","number":11,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“ஏதோமுடைய மூன்று பாவங்களுக்காகவும், நான்கு பாவங்களுக்காகவும்,","poem":1},{"text":"என் கோபத்தை நான் விலக்கமாட்டேன்.","poem":2},{"text":"இரக்க உணர்வின்றி தன் சகோதரனான","poem":1},{"text":"இஸ்ரயேலை வாளுடன் துரத்திச் சென்றானே.","poem":2},{"text":"அத்துடன் அவன் கோபம் அடங்காமல்,","poem":1},{"text":"அவனுடைய மூர்க்கத்தை நித்திய காலமாக வைத்திருக்கிறானே.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"தேமானின் மதில்கள்மேல் நெருப்பை அனுப்புவேன்.","poem":1},{"text":"அது போஸ்றாவின் அரண்களையெல்லாம் சுட்டெரிக்கும்.”","poem":2}]},{"type":"verse","number":13,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“அம்மோன் மக்களின் மூன்று பாவங்களுக்காகவும்,","poem":1},{"text":"நான்கு பாவங்களுக்காகவும்,","poem":2},{"text":"என் கோபத்தை நான் விலக்கமாட்டேன்.","poem":1},{"text":"தன் எல்லைகளை விரிவாக்கும்படி கீலேயாத்தின் கர்ப்பவதிகளைக் கீறிப்போட்டார்களே.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ரப்பாவின் மதிலுக்கு நெருப்பு மூட்டுவேன்.","poem":1},{"text":"அது அதன் அரண்களையெல்லாம் சுட்டெரிக்கும்.","poem":2},{"text":"அது யுத்தநாளின் முழக்கத்தின் மத்தியிலும்,","poem":1},{"text":"புயல் நாளின் சூறாவளியின் மத்தியிலும் நடக்கும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அதன் அரசனும் நாடுகடத்தப்படுவான்.","poem":1},{"text":"அவனும் அவனுடைய அதிகாரிகளும் ஒன்றாக சிறைப்படுவார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/AMO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/AMO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOL/3.json","previousChapterAudioLinks":{},"numberOfVerses":15}