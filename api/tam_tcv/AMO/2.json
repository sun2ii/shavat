{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"AMO","translationId":"tam_tcv","name":"ஆமோஸ்","commonName":"ஆமோஸ்","title":"ஆமோஸ்","order":30,"numberOfChapters":9,"sha256":"0f3ab8673f8f4eaf8990560b2bdd0a84821d6570e5be52ee68b317788ed44866","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tam_tcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“மோவாபின் மூன்று பாவங்களுக்காகவும், நான்கு பாவங்களுக்காகவும்,","poem":1},{"text":"என் கோபத்தை நான் விலக்கமாட்டேன்.","poem":2},{"text":"ஏனெனில் ஏதோமுடைய அரசனின் எலும்புகளைச்","poem":1},{"text":"சுட்டு சாம்பலாக்கிப் போட்டானே.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மோவாபின்மேல் நெருப்பை அனுப்புவேன்.","poem":1},{"text":"அது கீரியோத்தின் அரண்களையெல்லாம் சுட்டெரிக்கும்.","poem":2},{"text":"யுத்த சத்தத்தின் மத்தியிலும், எக்காள முழக்கத்தின் மத்தியிலும்","poem":1},{"text":"மோவாப் பெரும் சத்தத்துடன் வீழ்ந்து போகும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் அவளுடைய ஆளுநனை அழிப்பேன்.","poem":1},{"text":"அவளுடைய அதிகாரிகளை அவனுடன் கொல்லுவேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்லுகிறார்.","poem":2}]},{"type":"verse","number":4,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“யூதாவின் மூன்று பாவங்களுக்காகவும், நான்கு பாவங்களுக்காகவும்,","poem":1},{"text":"என் கோபத்தை நான் விலக்கமாட்டேன்.","poem":2},{"text":"அவர்கள் யெகோவாவின் சட்டத்தைப் புறக்கணித்து,","poem":1},{"text":"அவரின் விதிமுறைகளைக் கைக்கொள்ளாமல் போனார்கள்.","poem":2},{"text":"ஏனெனில் அவர்களின் முன்னோர்கள் பின்பற்றிய","poem":1},{"text":"போலித் தெய்வங்கள் அவர்களை வழிவிலகப்பண்ணின.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆகையால் யூதாவின்மேல் நெருப்பை அனுப்புவேன்.","poem":1},{"text":"அது எருசலேமின் அரண்களையெல்லாம் சுட்டெரிக்கும்.”","poem":2}]},{"type":"heading","content":["இஸ்ரயேலின் நியாயத்தீர்ப்பு"]},{"type":"verse","number":6,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“இஸ்ரயேலின் மூன்று பாவங்களுக்காகவும், நான்கு பாவங்களுக்காகவும்,","poem":1},{"text":"என் கோபத்தை நான் விலக்கமாட்டேன்.","poem":2},{"text":"அவர்கள் நீதியானவர்களை வெள்ளிக்காகவும்,","poem":1},{"text":"சிறுமைப்பட்டவர்களை ஒரு ஜோடி செருப்புக்காகவும் விற்றார்களே.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"தரையின் புழுதியை மிதிப்பதுபோல்","poem":1},{"text":"ஏழைகளின் தலைகளை அவர்கள் மிதிக்கிறார்களே.","poem":2},{"lineBreak":true},{"text":"ஒடுக்கப்பட்டவர்களுக்கு நீதிவழங்க மறுக்கிறார்கள்.","poem":2},{"text":"தகப்பனும் மகனும் ஒரே பெண்ணிடம் உறவுகொண்டு,","poem":1},{"text":"என் பரிசுத்த பெயரைத் தூய்மைக் கேடாக்குகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்கள் ஒவ்வொரு தெய்வத்தின் பலிபீடங்களின் அருகேயும்","poem":1},{"text":"தாங்கள் அடைமானமாய் வாங்கிய உடைகளை விரித்துப் படுக்கிறார்கள்.","poem":2},{"text":"அபராதமாய்ப் பெற்ற திராட்சை இரசத்தைத் தங்கள்","poem":1},{"text":"தெய்வத்தின் கோயில்களில் வைத்துக் குடிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“எமோரியர் கேதுருமரங்களைப்போல் உயரமாயும்,","poem":1},{"text":"கர்வாலி மரங்களைப்போல் வைரமாயும் இருப்பினும்,","poem":2},{"text":"நான் என் மக்களுக்கு நாட்டைப் பெற்றுக் கொடுக்க","poem":1},{"text":"அவர்களை இவர்களுக்கு முன்பாக அழித்தேன்.","poem":2},{"text":"மேலே அவர்களுடைய பழங்களையும்,","poem":1},{"text":"கீழே அவர்களுடைய வேர்களையும் நானே அழித்தேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எமோரியர்களின் நாட்டை உங்களுக்குக் கொடுப்பதற்காக,","poem":1},{"text":"எகிப்திலிருந்து உங்களை வெளியே கொண்டுவந்து,","poem":2},{"lineBreak":true},{"text":"நாற்பது வருடங்களாக பாலைவனத்தில் உங்களை வழிநடத்தினேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“நான் உங்கள் மகன்களிலிருந்து இறைவாக்கினரையும்,","poem":1},{"text":"உங்கள் வாலிபரிலிருந்து நசரேயர்களையும் எழுப்பினேன்.","poem":2},{"text":"இஸ்ரயேல் மக்களே, இது உண்மையல்லவா?”","poem":1},{"text":"என யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“ஆனால் நீங்கள், நசரேயர்களை திராட்சை இரசம் குடிக்கப்பண்ணினீர்கள்.","poem":1},{"text":"இறைவாக்குச் சொல்லக்கூடாது என இறைவாக்கினருக்குக் கட்டளையிட்டீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“தானியத்தினால் நிறைந்த வண்டியில் நசுக்குவதுபோல,","poem":1},{"text":"நான் உங்களை நசுக்குவேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அப்பொழுது உங்களில் வேகமாய் ஓடக்கூடியவர்கள் தப்பமாட்டார்கள்,","poem":1},{"text":"பலமுள்ளவர்கள் தங்கள் பலத்தை ஒன்றுதிரட்டமாட்டார்கள்,","poem":2},{"lineBreak":true},{"text":"இராணுவவீரனுங்கூட தன் உயிரைத் தப்புவிக்கமாட்டான்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"வில்வீரனும் தனது இடத்தில் நிற்கமாட்டான்,","poem":1},{"text":"வேகமாய் ஓடும் இராணுவவீரனும் ஓடித்தப்பமாட்டான்,","poem":2},{"lineBreak":true},{"text":"குதிரைவீரனும் தன் உயிரைக் காப்பாற்றமாட்டான்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அந்நாளில் துணிவுமிக்க வீரர்களும்","poem":1},{"text":"நிர்வாணமாய் ஓடித்தப்புவார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/AMO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/AMO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/AMO/1.json","previousChapterAudioLinks":{},"numberOfVerses":16}