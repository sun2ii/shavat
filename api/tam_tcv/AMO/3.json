{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"AMO","translationId":"tam_tcv","name":"ஆமோஸ்","commonName":"ஆமோஸ்","title":"ஆமோஸ்","order":30,"numberOfChapters":9,"sha256":"0f3ab8673f8f4eaf8990560b2bdd0a84821d6570e5be52ee68b317788ed44866","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tam_tcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":3,"content":[{"type":"heading","content":["இஸ்ரயேலுக்கு எதிரான சாட்சியங்கள்"]},{"type":"verse","number":1,"content":["இஸ்ரயேல் மக்களே, யெகோவா உங்களுக்கெதிராகக் கூறிய இந்த வார்த்தையைக் கேளுங்கள். எகிப்திலிருந்து நான் கொண்டுவந்த முழுக் குடும்பத்தினருக்கும் எதிராக நான் பேசியதைக் கேளுங்கள்."]},{"type":"verse","number":2,"content":[{"text":"“பூமியின் குடும்பங்கள் எல்லாவற்றிலிருந்தும்","poem":1},{"text":"உங்களையே நான் தெரிந்தெடுத்தேன்.","poem":2},{"text":"உங்கள் அநேக பாவங்களுக்காகவும்","poem":1},{"text":"நான் உங்களைத் தண்டிப்பேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ஒன்றுசேர்ந்து நடப்பதற்கு இருவர் ஒருமனப்படாமலிருந்தால்,","poem":1},{"text":"அவர்கள் ஒன்றுசேர்ந்து நடப்பது எப்படி?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இரை அகப்படாமல் இருக்கும்போது,","poem":1},{"text":"புதருக்குள் இருந்து சிங்கம் கர்ஜிக்குமோ?","poem":2},{"text":"தான் ஒன்றும் பிடிக்காமல் இருக்கும்போது,","poem":1},{"text":"அது தன் குகையில் இருந்து உறுமுமோ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கண்ணி விரிக்கப்படாத தரையில் பறவை சிக்குமோ?","poem":1},{"text":"பொறியில் ஒன்றும்","poem":2},{"text":"சிக்காதிருக்கையிலே,","poem":1},{"text":"பொறி நிலத்திலிருந்து துள்ளுமோ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"பட்டணத்தில் எக்காளம் முழங்குகையில்","poem":1},{"text":"மக்கள் நடுங்காதிருப்பார்களோ?","poem":2},{"text":"பட்டணத்தில் பேராபத்து வரும்போது,","poem":1},{"text":"யெகோவா அல்லவா அதை ஏற்படுத்தினார்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"தமது ஊழியர்களான இறைவாக்கினருக்கு","poem":1},{"text":"தமது திட்டத்தை வெளிப்படுத்தாமல்","poem":2},{"lineBreak":true},{"text":"ஆண்டவராகிய யெகோவா ஒன்றும் செய்வதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"சிங்கம் கர்ஜித்தது,","poem":1},{"text":"யார் பயப்படாதிருப்பான்?","poem":2},{"text":"ஆண்டவராகிய யெகோவா பேசியிருக்கிறார்,","poem":1},{"text":"யாரால் இறைவாக்கு சொல்லாமல் இருக்கமுடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"அஸ்தோத்தின் கோட்டைகளுக்கும்,","poem":1},{"text":"எகிப்தின் கோட்டைகளுக்கும் பிரசித்தப்படுத்துங்கள்.","poem":2},{"text":"“சமாரியாவின் மலைகளின்மேல் ஒன்றுகூடுங்கள்,","poem":1},{"text":"இஸ்ரயேலில் நடக்கும் பெரும் கலவரத்தையும்,","poem":2},{"lineBreak":true},{"text":"அங்குள்ள மக்களிடையே நடக்கும் ஒடுக்குதலையும் பாருங்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“சரியானதை எப்படிச் செய்வது என்று அவர்களுக்குத் தெரியாது.","poem":1},{"text":"அவர்கள் கொள்ளைப்பொருட்களையும்,","poem":2},{"text":"சூறைப்பொருட்களையும் தங்கள் கோட்டைகளில் குவித்து வைக்கிறார்கள்”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":["ஆகவே ஆண்டவராகிய யெகோவா சொல்வது இதுவே:",{"text":"“பகைவன் ஒருவன் நாட்டை ஆக்கிரமிப்பான்.","poem":1},{"text":"அவன் அரண்களை இடித்து,","poem":2},{"lineBreak":true},{"text":"உங்கள் கோட்டைகளைக் கொள்ளையிடுவான்.”","poem":2}]},{"type":"verse","number":12,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“அப்பொழுது சிங்கத்தின் வாயிலிருந்து ஒரு மேய்ப்பன்","poem":1},{"text":"தன் ஆட்டின் இரு கால் எலும்புகளையோ,","poem":2},{"lineBreak":true},{"text":"காதின் துண்டொன்றையோ மீட்டெடுப்பதுபோல்","poem":2},{"text":"இஸ்ரயேலர் தப்புவிக்கப்படுவார்கள்.","poem":1},{"text":"சமாரியாவில் படுக்கையின் ஓரங்களுடனும்,","poem":2},{"text":"தமஸ்குவிலுள்ள இருக்கைகளின் மூலைகளுடனும் மட்டுமே","poem":1},{"text":"அவர்கள் தப்புவிக்கப்படுவார்கள்.”","poem":2}]},{"type":"verse","number":13,"content":["“இதைக் கேட்டு யாக்கோபின் குடும்பத்திற்கெதிராக நாடு முழுவதும் சாட்சி சொல்லுங்கள்” என்று யெகோவா, சேனைகளின் இறைவனாகிய யெகோவா அறிவிக்கிறார்."]},{"type":"verse","number":14,"content":[{"text":"“இஸ்ரயேலின் பாவங்களுக்காக அவர்களைத் தண்டிக்கும் நாளிலே","poem":1},{"text":"பெத்தேலிலுள்ள தெய்வத்தின் மேடைகளை அழிப்பேன்.","poem":2},{"text":"மேடைகளின் கொம்புகள் வெட்டுண்டு","poem":1},{"text":"தரையில் விழும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"செல்வந்தர்களின் அழகான வீடுகளை அழிப்பேன்.","poem":1},{"text":"குளிர்க்கால வீடுகளை இடிப்பேன்.","poem":2},{"text":"அவற்றுடன் கோடைகால வீடுகளையும் இடிப்பேன்.","poem":1},{"text":"தந்தத்தால் அலங்கரிக்கப்பட்ட வீடுகள் அழிக்கப்படும். அரண்மனைகள் பாழாகிவிடும்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/AMO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/AMO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/AMO/2.json","previousChapterAudioLinks":{},"numberOfVerses":15}