{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"AMO","translationId":"tam_tcv","name":"ஆமோஸ்","commonName":"ஆமோஸ்","title":"ஆமோஸ்","order":30,"numberOfChapters":9,"sha256":"0f3ab8673f8f4eaf8990560b2bdd0a84821d6570e5be52ee68b317788ed44866","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tam_tcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"heading","content":["இஸ்ரயேல் இறைவனிடம் திரும்பவில்லை"]},{"type":"verse","number":1,"content":[{"text":"ஏழைகளை ஒடுக்கி, வறியவரை நசுக்கும் பெண்களே,","poem":1},{"text":"“எங்களுக்குக் குடிவகைகளைக் கொண்டுவாருங்கள்”","poem":2},{"text":"என உங்கள் கணவர்களிடம் சொல்லுகிறவர்களே,","poem":1},{"text":"இந்த வார்த்தையைக் கேளுங்கள்;","poem":2},{"text":"நீங்கள் சமாரியா மலையிலுள்ள பாசானின்","poem":1},{"text":"கொழுத்த பசுக்களைப்போல் இருக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"எல்லாம் வல்ல ஆண்டவராகிய யெகோவா தமது பரிசுத்த பெயரினால் ஆணையிட்டார்:","poem":1},{"text":"“நிச்சயமாய் ஒரு காலம் வரும்.","poem":2},{"text":"அப்பொழுது நீங்கள் கொக்கிகளினாலும்,","poem":1},{"text":"உங்களில் எஞ்சியிருப்போரில் கடைசியானவர் வரைக்கும்","poem":2},{"lineBreak":true},{"text":"தூண்டில்களினாலும் இழுத்துக்கொண்டு செல்லப்படுவீர்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீங்கள் ஒவ்வொருவரும்","poem":1},{"text":"சுவர் வெடிப்புகளின் வழியாக ஓடிப்போவீர்கள்.","poem":2},{"text":"அர்மோன் மலைப் பக்கமாக நீங்கள் இழுத்தெறியப்படுவீர்கள்”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“சமாரியா மக்களே போங்கள்; பெத்தேலுக்குப் போய் பாவம் செய்யுங்கள்.","poem":1},{"text":"கில்காலுக்குப் போய் இன்னும் அதிக பாவம் செய்யுங்கள்.","poem":2},{"text":"காலைதோறும் உங்கள் பலிகளையும்,","poem":1},{"text":"மூன்று வருடத்திற்கொரு முறை உங்கள் பத்தில் ஒரு பாகத்தையும் கொண்டுவாருங்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"புளிப்பூட்டப்பட்ட அப்பத்தை நன்றிக் காணிக்கையாக எரியுங்கள்.","poem":1},{"text":"உங்கள் சுயவிருப்புக் காணிக்கையைப் பற்றி பெருமையாய் பேசி","poem":2},{"text":"அவற்றைக்குறித்துப் புகழுங்கள்,","poem":1},{"text":"இஸ்ரயேலரே, இவற்றைத் செய்வதற்குத்தானே நீங்கள் விரும்புகிறீர்கள்”","poem":2},{"lineBreak":true},{"text":"என ஆண்டவராகிய யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ஆனால் நான் உங்கள் நகரங்கள் ஒவ்வொன்றிலும் பட்டினியையும்,","poem":1},{"text":"பட்டணங்கள் ஒவ்வொன்றிலும் உணவுப் பற்றாக்குறையையும் கொண்டுவந்தேன்.","poem":2},{"text":"அப்படியிருந்தும், நீங்கள் என்னிடமாய்த் திரும்பவில்லை”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“அறுவடைக்கு இன்னும் மூன்று மாதம் இருக்கையில்","poem":1},{"text":"நான் வேண்டிய மழையை அனுப்பாமல் விட்டேன்.","poem":2},{"text":"நான் ஒரு நகரத்துக்கு மழையை அனுப்பி,","poem":1},{"text":"இன்னொரு நகரத்திற்கு அதை அனுப்பாமல் விட்டேன்.","poem":2},{"text":"ஒரு வயலுக்கு மழை பெய்தது.","poem":1},{"text":"இன்னொன்றோ மழையின்றிக் காய்ந்தது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மக்கள் ஊரூராகத் தண்ணீர் தேடி அலைந்து திரிந்தும்,","poem":1},{"text":"குடிப்பதற்குப் போதிய தண்ணீர் கிடைக்கவில்லை.","poem":2},{"text":"அப்படியிருந்தும் நீங்கள் என்னிடமாய்த் திரும்பவில்லை”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“பலமுறை உங்கள் தோட்டங்களையும், திராட்சைத் தோட்டங்களையும் தாக்கினேன்.","poem":1},{"text":"நான் அவற்றைக் கருகல் நோயினாலும், பூஞ்சணத்தினாலும் தாக்கினேன்.","poem":2},{"text":"உங்கள் அத்திமரங்களையும், ஒலிவ மரங்களையும் வெட்டுக்கிளிகள் தின்று முடித்தன.","poem":1},{"text":"அப்படியிருந்தும் நீங்கள் என்னிடமாய்த் திரும்பவில்லை”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“நான் எகிப்தில் செய்ததுபோல,","poem":1},{"text":"உங்கள் மத்தியில் கொள்ளைநோயை அனுப்பினேன்.","poem":2},{"text":"உங்கள் வாலிபரை வாளினால் கொன்றேன்.","poem":1},{"text":"அவர்களுடன் கைப்பற்றப்பட்ட உங்கள் குதிரைகளையும் கொன்றேன்;","poem":2},{"text":"கூடாரங்களின் துர்நாற்றத்தினால் உங்கள் நாசிகளை நிரப்பினேன்.","poem":1},{"text":"அப்படியிருந்தும் நீங்கள் என்னிடமாய்த் திரும்பவில்லை”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“நான் சோதோம், கொமோராவை கவிழ்த்துப் போட்டதுபோல்,","poem":1},{"text":"உங்களில் சிலரையும் கவிழ்த்துப் போட்டேன்.","poem":2},{"text":"நீங்கள் நெருப்பினின்று இழுத்தெடுக்கப்பட்ட கொள்ளியைப்போல் இருந்தீர்கள்.","poem":1},{"text":"அப்படியிருந்தும் நீங்கள் என்னிடமாய்த் திரும்பவில்லை”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ஆகவே இஸ்ரயேலே, நான் உனக்குச் செய்யப்போவது இதுவே;","poem":1},{"text":"இதை நான் செய்யப்போவதால், இஸ்ரயேலே,","poem":2},{"lineBreak":true},{"text":"உன் இறைவனை நீ சந்திக்க ஆயத்தப்படு.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"மலைகளை உருவாக்குகிறவரும்,","poem":1},{"text":"காற்றை உண்டாக்குகிறவரும் அவரே,","poem":2},{"lineBreak":true},{"text":"மனிதனுக்குத் தன் எண்ணங்களை வெளிப்படுத்துகிறவரும்,","poem":2},{"text":"அதிகாலையில் வெளிச்சத்தை இருளாக மாற்றுகிறவரும் அவரே,","poem":1},{"text":"பூமியின் உயர்ந்த மேடுகளில் நடக்கிறவரும் அவரே,","poem":2},{"lineBreak":true},{"text":"சேனைகளின் இறைவனாகிய யெகோவா என்பது அவர் பெயர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}