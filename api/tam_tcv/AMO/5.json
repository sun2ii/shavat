{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"AMO","translationId":"tam_tcv","name":"ஆமோஸ்","commonName":"ஆமோஸ்","title":"ஆமோஸ்","order":30,"numberOfChapters":9,"sha256":"0f3ab8673f8f4eaf8990560b2bdd0a84821d6570e5be52ee68b317788ed44866","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tam_tcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["மனமாறுதலுக்கு அழைப்பு"]},{"type":"verse","number":1,"content":["இஸ்ரயேல் குடும்பமே, இந்த வார்த்தையைக் கேளுங்கள். உங்களைக்குறித்து நான் புலம்புவதைக் கேளுங்கள்:"]},{"type":"verse","number":2,"content":[{"text":"“இஸ்ரயேல் என்ற கன்னிப்பெண் விழுந்து விட்டாள்,","poem":1},{"text":"இவள் இனி ஒருபோதும் எழும்பமாட்டாள்.","poem":2},{"text":"தன் நாட்டிலேயே கைவிடப்பட்டாள்.","poem":1},{"text":"அவளைத் தூக்கிவிட யாருமேயில்லை.”","poem":2}]},{"type":"verse","number":3,"content":["ஆண்டவராகிய யெகோவா சொல்வது இதுவே:",{"text":"“இஸ்ரயேலில் ஆயிரம் வீரர்களை அணிவகுத்து அனுப்பிய பட்டணத்திற்கு,","poem":1},{"text":"நூறுபேர் மட்டும் எஞ்சி வருவார்கள்.","poem":2},{"text":"நூறு வீரர்களை அணிவகுத்து அனுப்பிய பட்டணத்திற்கு,","poem":1},{"text":"பத்துபேர் மட்டுமே எஞ்சி வருவார்கள்.”","poem":2}]},{"type":"verse","number":4,"content":["இஸ்ரயேல் குடும்பத்திற்கு யெகோவா சொல்வது இதுவே:",{"text":"என்னைத் தேடுங்கள், நீங்கள் வாழ்வீர்கள்.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"பெத்தேலைத் தேடாதீர்கள்,","poem":2},{"text":"கில்காலுக்குப் போகாதீர்கள்,","poem":1},{"text":"பெயெர்செபாவிற்குப் பயணப்படாதீர்கள்.","poem":2},{"text":"கில்கால் நிச்சயமாக நாடுகடத்தப்படும்,","poem":1},{"text":"பெத்தேலும் ஒன்றுமில்லாது போகும்,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இஸ்ரயேலின் யெகோவாவையே தேடுங்கள்,","poem":1},{"text":"அப்பொழுது நீங்கள் வாழ்வீர்கள்.","poem":2},{"text":"இல்லையெனில் அவர் யோசேப்பின் குடும்பத்தின் வழியாக","poem":1},{"text":"நெருப்புபோல் அள்ளிக்கொண்டுபோவார்.","poem":2},{"text":"அந்த நெருப்பு எல்லாவற்றையும் சுட்டெரிக்கும்.","poem":1},{"text":"அதை அணைக்க பெத்தேலில் ஒருவரும் இருக்கமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நீதியைக் கசப்பாக மாற்றுகிறவர்களே,","poem":1},{"text":"நியாயத்தைத் தரையில் தள்ளுகிறவர்களே, அவரையே தேடி வாழுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அவரே அறுமீன், மிருகசீரிடம் ஆகிய நட்சத்திரக் கூட்டங்களை உண்டாக்கியவர்.","poem":1},{"text":"இருளை அதிகாலை வெளிச்சமாக மாற்றுகிறவரும்,","poem":2},{"lineBreak":true},{"text":"பகலை இரவாக மாற்றுகிறவரும் அவரே;","poem":2},{"text":"கடலின் தண்ணீரை அழைத்து,","poem":1},{"text":"பூமியின் மேற்பரப்பில் அதைப் பொழிகிறவரும் அவரே,","poem":2},{"lineBreak":true},{"text":"“யெகோவா” என்பது அவர் பெயர்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் கோட்டைகளை மின்னல் வேகத்தில் தாக்கி அழித்து,","poem":1},{"text":"அரணான பட்டணங்களைப் பாழாக்குகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"இஸ்ரயேலின் நீங்கள் நீதிமன்றத்திற்கு","poem":1},{"text":"குற்றவாளியைக் கொண்டுவருகிறவனை வெறுக்கிறீர்கள்,","poem":2},{"lineBreak":true},{"text":"உண்மை சொல்கிறவனை உதாசீனம் செய்கிறீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ஏழையை மிதித்து, உங்களுக்குத் தானியத்தைக் கொடுக்கும்படி","poem":1},{"text":"அவனைப் பலவந்தப்படுத்துகிறீர்கள்.","poem":2},{"text":"ஆகையால் கல்லினால் மாளிகைகளைக் கட்டியும்,","poem":1},{"text":"அதில் வாழமாட்டீர்கள்,","poem":2},{"text":"செழிப்பான திராட்சைத் தோட்டங்களை உண்டாக்கினாலும்","poem":1},{"text":"அவற்றின் இரசத்தை நீங்கள் குடிக்கமாட்டீர்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உங்கள் மீறுதல்கள் எவ்வளவு மிகுதியென்றும்,","poem":1},{"text":"உங்கள் பாவங்கள் எவ்வளவு கொடியதென்றும் நான் அறிவேன்.","poem":2},{"lineBreak":true},{"text":"நீங்கள் நீதிமான்களை ஒடுக்கி, அவர்களிடமிருந்து இலஞ்சம் வாங்குகிறீர்கள்.","poem":1},{"text":"நீதிமன்றத்தில் ஏழைக்கு நீதிவழங்க மறுக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆகையால் அப்படிப்பட்ட காலங்களில் விவேகமுள்ளவன் மவுனமாய் இருக்கவேண்டும்.","poem":1},{"text":"ஏனெனில் காலம் மிகக் கொடியதாய் இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"தீமையை அல்ல, நன்மையைத் தேடுங்கள்,","poem":1},{"text":"அப்பொழுது நீங்கள் வாழ்வீர்கள்.","poem":2},{"text":"சேனைகளின் இறைவனாகிய யெகோவா உங்களோடிருக்கிறார் என்று நீங்கள் சொல்வதுபோலவே,","poem":1},{"text":"அவர் உங்களோடிருப்பார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"தீமையை வெறுத்து நன்மையை விரும்புங்கள்.","poem":1},{"text":"நீதிமன்றங்களில் நீதியை நிலைநிறுத்துங்கள்.","poem":2},{"text":"ஒருவேளை சேனைகளின் இறைவனாகிய யெகோவா,","poem":1},{"text":"யோசேப்பின் மீதியானவர்மேல் இரக்கம் காட்டுவார்.","poem":2}]},{"type":"verse","number":16,"content":["ஆகையால் யெகோவா, சேனைகளின் இறைவனாகிய யெகோவா சொல்வது இதுவே:",{"text":"“எல்லா வீதிகளிலும் புலம்பல் உண்டாயிருக்கும்.","poem":1},{"text":"பொது இடங்களிலெல்லாம் வேதனையின் அழுகுரல் உண்டாயிருக்கும்.","poem":2},{"text":"அழுவதற்காக விவசாயிகளும்,","poem":1},{"text":"புலம்புவதற்காக புலம்பல் வைப்பவர்களும் அழைப்பிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"திராட்சைத் தோட்டங்களிலும் புலம்பல் உண்டாயிருக்கும்.","poem":1},{"text":"ஏனெனில் நான் உங்களைத் தண்டித்துக்கொண்டு கடந்துபோவேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"heading","content":["யெகோவாவின் நாள்"]},{"type":"verse","number":18,"content":[{"text":"யெகோவாவின் நாளை விரும்புகிற","poem":1},{"text":"உங்களுக்கு ஐயோ கேடு,","poem":2},{"text":"யெகோவாவின் நாளை ஏன் விரும்புகிறீர்கள்?","poem":1},{"text":"அந்த நாள் வெளிச்சமாயிராமல் இருளாயிருக்கும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ஒரு சிங்கத்திடமிருந்து தப்பிய மனிதன்,","poem":1},{"text":"கரடியைச் சந்தித்ததுபோல் அது இருக்கும்.","poem":2},{"text":"அவன் தன் வீட்டிற்குள் வந்து","poem":1},{"text":"சுவரில் கையை ஊன்றியபோது,","poem":2},{"lineBreak":true},{"text":"அவனைப் பாம்பு கடித்ததுபோல் இருக்கும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"யெகோவாவின் நாள் வெளிச்சமாயிராமல், இருள் நிறைந்ததாய் இருக்குமல்லவோ?","poem":1},{"text":"ஒளிக்கீற்று எதுவுமின்றி காரிருளாயிருக்குமல்லவோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"உங்கள் பண்டிகைகளை நான் வெறுத்து, உதாசீனம் செய்கிறேன்;","poem":1},{"text":"உங்கள் சபைக் கூட்டங்களை என்னால் சகிக்க முடியவில்லை.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"தகன காணிக்கைகளையும், தானிய காணிக்கைகளையும்","poem":1},{"text":"நீங்கள் எனக்குக் கொண்டுவந்தாலும்,","poem":2},{"lineBreak":true},{"text":"அவற்றை நான் ஏற்றுக்கொள்ளமாட்டேன்.","poem":2},{"text":"சிறப்பான சமாதான காணிக்கையை நீங்கள் கொண்டுவந்தாலும்,","poem":1},{"text":"அவற்றைப் பார்க்கவும் மாட்டேன்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"உங்கள் பாடல்களின் சத்தத்தோடு அகன்றுபோங்கள்.","poem":1},{"text":"உங்கள் பாடல்களின் இசையை நான் கேட்கமாட்டேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவற்றிற்குப் பதிலாக நீதி ஆற்றைப்போல் புரண்டோடட்டும்.","poem":1},{"text":"நீதி என்றும் வற்றாத நீரோடையைப்போல் ஓடட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"இஸ்ரயேல் குடும்பத்தாரே, பாலைவனத்தில் நாற்பது வருடங்களாய்","poem":1},{"text":"நீங்கள் எனக்கு பலிகளையும்,","poem":2},{"lineBreak":true},{"text":"காணிக்கைகளையும் கொண்டுவந்தீர்களோ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ஆனால் நீங்களோ, உங்கள் அரசனின் விக்கிரகத் தேரைத் தூக்கிச் சுமந்தீர்கள்.","poem":1},{"text":"உங்களுக்கென செய்த","poem":2},{"lineBreak":true},{"text":"விக்கிரகங்களின் கூடாரத்தையும்,","poem":2},{"lineBreak":true},{"text":"நட்சத்திரத் தெய்வங்களையும் சுமந்துகொண்டு போனீர்கள்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ஆதலால் நான் உங்களைத் தமஸ்குவுக்கு அப்பால் நாடுகடத்துவேன் என்று,","poem":1},{"text":"சேனைகளின் இறைவன் என்னும் பெயருடைய யெகோவா சொல்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}