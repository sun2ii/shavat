{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"AMO","translationId":"tam_tcv","name":"ஆமோஸ்","commonName":"ஆமோஸ்","title":"ஆமோஸ்","order":30,"numberOfChapters":9,"sha256":"0f3ab8673f8f4eaf8990560b2bdd0a84821d6570e5be52ee68b317788ed44866","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tam_tcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":6,"content":[{"type":"heading","content":["சிற்றின்பத்தின் கேடு"]},{"type":"verse","number":1,"content":[{"text":"சீயோனில் உல்லாசமாய் இருக்கிறவர்களே,","poem":1},{"text":"சமாரியா மலையில் பாதுகாப்பாய் இருக்கிறதாக எண்ணுகிறவர்களே,","poem":2},{"text":"இஸ்ரயேல் மக்கள் தேடிவரும் முதன்மையான நாட்டின் உயர்குடி மனிதரே","poem":1},{"text":"உங்களுக்கு ஐயோ கேடு,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"கல்னே பட்டணத்துக்குப் போய் அதைப் பாருங்கள்,","poem":1},{"text":"அங்கிருந்து ஆமாத் எனும் பெருநகரத்திற்குப் போங்கள்.","poem":2},{"lineBreak":true},{"text":"அதன்பின் பெலிஸ்தியாவிலுள்ள காத்திற்குச் செல்லுங்கள்.","poem":2},{"text":"உங்கள் இரு அரசுகளைவிட அவை சிறந்தவையோ?","poem":1},{"text":"அவர்களுடைய நாடு உங்கள் நாட்டைவிடப் பெரியதோ?","poem":2},{"lineBreak":true},{"text":"அவை எப்படி அழிக்கப்பட்டிருக்கின்றன.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீங்கள் தீமையின் நாளைப் பற்றி எண்ணாதிருக்கிறீர்கள்.","poem":1},{"text":"அதனால் வன்முறை ஆட்சியை அருகில் கொண்டுவருகிறீர்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீங்களோ தந்தம் பதித்த கட்டில்களில் படுக்கிறீர்கள்.","poem":1},{"text":"பஞ்சணை இருக்கைகளில் சொகுசாய் சாய்ந்திருக்கிறீர்கள்.","poem":2},{"text":"மந்தையில் சிறந்த ஆட்டுக்குட்டிகளையும்,","poem":1},{"text":"கொழுத்த கன்றுகளையும் அடித்து விருந்து கொண்டாடுகிறீர்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தாவீதைப்போல் உங்கள் யாழ்களை மீட்டுகிறீர்கள்.","poem":1},{"text":"புதிய இசைக்கருவிகளை உண்டாக்கிக் கொள்கிறீர்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"பெரிய கிண்ணங்களில் நிறைய திராட்சை இரசம் குடிக்கிறீர்கள்,","poem":1},{"text":"சிறந்த நறுமண தைலங்களைப் பூசிக்கொள்கிறீர்கள்;","poem":2},{"text":"ஆயினும் யோசேப்பின் மக்களுக்கு வரப்போகும்","poem":1},{"text":"அழிவிற்காக நீங்கள் துக்கப்படுகிறதில்லை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆதலால் நாடுகடத்தப்படும்போது, நீங்களே முதலாவதாகக் கொண்டுபோகப்படுவீர்கள்.","poem":1},{"text":"உங்கள் விருந்தும், களியாட்டமும் முடிவுக்கு வரும்.","poem":2}]},{"type":"heading","content":["இஸ்ரயேலின் தற்பெருமை"]},{"type":"verse","number":8,"content":["ஆண்டவராகிய யெகோவா தமது பெயரில் ஆணையிட்டிருக்கிறார்; சேனைகளின் இறைவனாகிய யெகோவா அறிவிக்கிறார்.",{"text":"யாக்கோபின் அகந்தையை நான் அருவருக்கிறேன்.","poem":1},{"text":"அவனுடைய கோட்டைகளையும் வெறுக்கிறேன்.","poem":2},{"text":"ஆதலால் அவர்களுடைய சமாரியா நகரத்தையும்,","poem":1},{"text":"அதிலுள்ள அனைத்தையும் பகைவனிடம் ஒப்புக்கொடுப்பேன்.","poem":2}]},{"type":"verse","number":9,"content":["அப்பொழுது ஒரு குடும்பத்தில் பத்துபேர் எஞ்சியிருந்தால், அவர்களும் சாவார்கள்."]},{"type":"verse","number":10,"content":["உடல்களை எரிக்கவேண்டிய உறவினன் ஒருவன் அவற்றை எடுத்துச் செல்வதற்கு வந்து, அங்கு மறைந்திருக்கிற எவனையாவது பார்த்து, “இன்னும் உன்னுடன் வேறு யாராவது இருக்கிறார்களா?” எனக் கேட்கும்போது அவன், “இல்லை” என்பான். மேலும் அவன், “சத்தமிடாதே! நாம் யெகோவாவின் பெயரை வாயால் உச்சரிக்கக் கூடாது” என்பான்."]},{"type":"verse","number":11,"content":[{"text":"ஏனென்றால், யெகோவா கட்டளையிட்டிருக்கிறார்.","poem":1},{"text":"அவர் பெரிய வீட்டைத் துண்டுகளாகவும்","poem":2},{"lineBreak":true},{"text":"சிறிய வீட்டைத் துகள்களாவும் நொறுக்குவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"செங்குத்தான பாறைகளில் குதிரைகள் ஓடுமோ?","poem":1},{"text":"அங்கே எருதுகளால் ஒருவன் உழுவானோ?","poem":2},{"text":"ஆயினும் நீங்களோ நீதியை நஞ்சாகவும்,","poem":1},{"text":"நீதியின் பலனைக் கசப்பாகவும் மாற்றினீர்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"லோதேபார் என்ற இடத்தைக் கைப்பற்றி மகிழ்கிறவர்களே,","poem":1},{"text":"“எங்கள் சொந்த வலிமையினாலே கர்னாயீமை பிடித்தோம்”","poem":2},{"lineBreak":true},{"text":"என்று சொல்கிறவர்களே, நீங்களே இப்படிச் செய்தீர்கள்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஆனால் சேனைகளின் இறைவனாகிய யெகோவா அறிவிக்கிறதாவது,","poem":1},{"text":"“இஸ்ரயேல் குடும்பத்தாரே, உங்களை எதிர்க்க ஒரு நாட்டைத் தூண்டிவிடுவேன்.","poem":2},{"text":"அவர்கள் ஆமாத்தின் நுழைவாசல்முதல்,","poem":1},{"text":"அரபா பள்ளத்தாக்குவரை உங்களை ஒடுக்குவார்கள்” என்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/AMO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/AMO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/AMO/5.json","previousChapterAudioLinks":{},"numberOfVerses":14}