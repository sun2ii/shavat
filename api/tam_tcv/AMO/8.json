{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"AMO","translationId":"tam_tcv","name":"ஆமோஸ்","commonName":"ஆமோஸ்","title":"ஆமோஸ்","order":30,"numberOfChapters":9,"sha256":"0f3ab8673f8f4eaf8990560b2bdd0a84821d6570e5be52ee68b317788ed44866","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tam_tcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":8,"content":[{"type":"heading","content":["பழுத்த பழங்களுடைய கூடை"]},{"type":"verse","number":1,"content":["ஆண்டவராகிய யெகோவா எனக்குக் காண்பித்தது இதுவே: பழுத்த பழங்களை உடைய ஒரு கூடையைக் கண்டேன்."]},{"type":"verse","number":2,"content":["“ஆமோஸ், நீ என்னத்தைக் காண்கிறாய்?” என்று கேட்டார். அதற்கு நான், “பழுத்த பழங்களுடைய கூடையைக் காண்கிறேன்” என்றேன். அப்பொழுது யெகோவா என்னிடம், “இஸ்ரயேலரான என் மக்களுக்கு முடிவுகாலம் வந்துவிட்டது. நான் இனிமேலும் அவர்களைத் தப்பவிடமாட்டேன்."]},{"type":"verse","number":3,"content":["“அந்த நாளில், ஆலயப் பாடல்கள் புலம்பலாக மாறும். ஏராளமான உடல்கள், எங்கும் எறியப்பட்டுக் கிடக்கும்! எங்கும் நிசப்தம் உண்டாகும்!” என்று ஆண்டவராகிய யெகோவா அறிவிக்கிறார்."]},{"type":"verse","number":4,"content":[{"text":"சிறுமைப்பட்டவர்களை மிதித்து,","poem":1},{"text":"நாட்டின் ஏழைகளை அகற்றுகிறவர்களே, இதைக் கேளுங்கள்.","poem":2}]},{"type":"verse","number":5,"content":["நீங்கள் தானியம் விற்பதற்கு",{"text":"அமாவாசை எப்போது முடியும் என்றும்,","poem":1},{"text":"கோதுமை விற்பதற்கு","poem":2},{"text":"ஓய்வுநாள் எப்போது முடிவடையும் என்றும் சொல்லி,","poem":1},{"text":"அளவைக் குறைத்து,","poem":2},{"text":"விலையை அதிகரித்து,","poem":1},{"text":"கள்ளத்தராசினால்","poem":2},{"lineBreak":true},{"text":"ஏமாற்றுவதற்குக் காத்திருக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஏழையை வெள்ளி கொடுத்து வாங்குவதற்கும்,","poem":1},{"text":"சிறுமைப்பட்டவர்களை ஒரு ஜோடி செருப்பு கொடுத்து வாங்குவதற்கும்,","poem":2},{"lineBreak":true},{"text":"பதரைக் கோதுமையுடன் விற்பதற்கும் அல்லவோ காத்திருக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":7,"content":["யாக்கோபின் அகந்தையின்மீது யெகோவா ஆணையிட்டார்: “அவர்கள் செய்த செயல்கள் எதையும் நான் ஒருபோதும் மறக்கமாட்டேன்."]},{"type":"verse","number":8,"content":[{"text":"“இதனால் நாடு நடுங்காதோ,","poem":1},{"text":"அதில் வாழும் அனைவரும் துக்கப்பட மாட்டார்களோ?","poem":2},{"text":"நாடு முழுவதும் நைல் நதிபோல பொங்கும்.","poem":1},{"text":"அது குமுறிப் பொங்கி,","poem":2},{"lineBreak":true},{"text":"பின் அது எகிப்து நதியைப்போல் தணிந்துபோகும்.”","poem":2}]},{"type":"verse","number":9,"content":["ஆண்டவராகிய யெகோவா அறிவிக்கிறதாவது:",{"text":"“அந்நாளில் நான் நண்பகலில் சூரியனை மறையச் செய்வேன்,","poem":1},{"text":"பட்டப்பகலில் பூமியை இருளடையச் செய்வேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உங்கள் மதக்கொண்டாட்டங்களை துக்கக்கொண்டாட்டமாகவும்,","poem":1},{"text":"உங்கள் பாடல்களை அழுகையாகவும் மாற்றுவேன்.","poem":2},{"text":"உங்கள் அனைவரையும் துக்கவுடை உடுத்தச் செய்வேன்.","poem":1},{"text":"உங்களை மொட்டையடிக்கப் பண்ணுவேன்.","poem":2},{"text":"நான் அந்த காலத்தை ஒரே மகனுக்காக துக்கங்கொண்டாடும் காலத்தைப்போல் மாற்றுவேன்.","poem":1},{"text":"அதன் முடிவை ஒரு கசப்பான நாளைப்போல் ஆக்குவேன் என்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“மேலும் ஆண்டவராகிய யெகோவா அறிவிக்கிறதாவது: நாட்கள் வருகின்றன,","poem":1},{"text":"நாடெங்கும் பஞ்சத்தை அனுப்புவேன்.","poem":2},{"text":"அது உணவு கிடைக்காத பஞ்சமோ, தாகத்திற்கு தண்ணீர் கிடைக்காத பஞ்சமோ அல்ல.","poem":1},{"text":"மாறாக யெகோவாவினுடைய வார்த்தைகளைக் கேட்க முடியாத பஞ்சமே அது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அப்போது மனிதர், ஒரு கடல் தொடங்கி மறுகடல் வரையும் அலைந்து சென்று,","poem":1},{"text":"வடதிசை தொடங்கி, கீழ்த்திசை வரையும் அலைந்து திரிந்து,","poem":2},{"text":"யெகோவாவின் வார்த்தையைத் தேடுவார்கள்.","poem":1},{"text":"ஆனால் அதைப் பெற்றுக்கொள்ளமாட்டார்கள்.","poem":2}]},{"type":"verse","number":13,"content":["“அந்த நாளில்",{"text":"“அழகிய இளம்பெண்களும்,","poem":1},{"text":"வலிமையுள்ள வாலிபர் எல்லோருமே தாகத்தால் சோர்ந்துபோவார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அக்காலத்தில் சமாரியாவின் வெட்கக்கேடான","poem":1},{"text":"விக்கிரகங்களின்மேல் ஆணையிடுகிறவர்களோ,","poem":2},{"text":"அல்லது ‘தாணே, உனது தெய்வம் வாழ்வது நிச்சயம்போல்’","poem":1},{"text":"என்று சொல்லுகிறவர்களோ,","poem":2},{"text":"அல்லது ‘பெயெர்செபாவின் தெய்வம் வாழ்வது நிச்சயம்போல்’","poem":1},{"text":"என்று சொல்லுகிறவர்களோ எல்லோரும் விழுந்துபோவார்கள்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் ஒருபோதும் எழுந்திருக்கமாட்டார்கள்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/AMO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/AMO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/AMO/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}