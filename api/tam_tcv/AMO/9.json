{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"AMO","translationId":"tam_tcv","name":"ஆமோஸ்","commonName":"ஆமோஸ்","title":"ஆமோஸ்","order":30,"numberOfChapters":9,"sha256":"0f3ab8673f8f4eaf8990560b2bdd0a84821d6570e5be52ee68b317788ed44866","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tam_tcv/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["இஸ்ரயேல் அழிக்கப்படுதல்"]},{"type":"verse","number":1,"content":["யெகோவா பலிபீடத்தின் அருகே நிற்பதைக் கண்டேன்:",{"text":"அவர் சொன்னதாவது: தூண்களின் உச்சியை இடித்துப்போடுங்கள்.","poem":1},{"text":"தூண்களின் வாசல் நிலைகள் அசையட்டும்.","poem":2},{"text":"அவற்றை மக்கள் எல்லோரின் தலைகள்மேலும் விழப்பண்ணுங்கள்.","poem":1},{"text":"மீந்திருப்போரை நான் வாளினால் கொல்லுவேன்.","poem":2},{"text":"ஒருவனும் தப்பி ஓடமாட்டான்,","poem":1},{"text":"ஒருவனுமே தப்பமாட்டான்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பாதாளத்தின் ஆழங்கள்வரை அவர்கள் தோண்டிக்கொண்டு போனாலும்,","poem":1},{"text":"அங்கிருந்தும் என் கை அவர்களைப் பிடித்தெடுக்கும்.","poem":2},{"text":"அவர்கள் வானங்கள்வரை ஏறினாலும்,","poem":1},{"text":"அங்கிருந்தும் அவர்களை கீழே கொண்டுவருவேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"கர்மேல் மலையுச்சியில் அவர்கள் ஒளிந்துகொண்டாலும்,","poem":1},{"text":"நான் அங்கேயும் அவர்களைத் தேடிப் பிடித்துக்கொள்வேன்.","poem":2},{"text":"என் பார்வைக்குத் தப்பி கடலின் அடியில் மறைந்துகொண்டாலும்","poem":1},{"text":"அவர்களைக் கடிக்க பாம்பிற்குக் கட்டளையிடுவேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"தங்கள் பகைவரால் நாடுகடத்தப்பட்டுத் துரத்தப்பட்டாலும்,","poem":1},{"text":"அங்கே அவர்களைக் கொல்லும்படி வாளுக்குக் கட்டளையிடுவேன்.","poem":2},{"lineBreak":true},{"text":"“நன்மைக்காக அல்ல,","poem":1},{"text":"தீமைக்காகவே அவர்கள்மேல் என் கண்களை வைப்பேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவா, சேனைகளின் யெகோவா பூமியைத் தொடுகிறார்,","poem":1},{"lineBreak":true},{"text":"அது உருகுகிறது,","poem":1},{"text":"அதில் வாழும் அனைவரும் புலம்புகிறார்கள்;","poem":2},{"text":"முழு நாடும் நைல் நதியைப்போல் பொங்கி எழுகிறது,","poem":1},{"text":"பின்னர் எகிப்தின் நதியைப்போல் வற்றிப்போகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவா வானங்களின் உயர்வில் தமது அரண்மனைகளைக் கட்டுகிறார்,","poem":1},{"text":"பூமியின்மேல் அஸ்திபாரத்தை அமைக்கிறார்;","poem":2},{"text":"கடல்நீரை அழைத்து","poem":1},{"text":"பூமியின் மேற்பரப்பில் அதைப் பொழிகிறார்.","poem":2},{"lineBreak":true},{"text":"யெகோவா என்பது அவர் பெயர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"இஸ்ரயேலின் மக்களே,","poem":1},{"text":"நீங்களும் எனக்கு எத்தியோப்பியரைப்போல் அல்லவோ இருக்கிறீர்கள்","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"நான் இஸ்ரயேலரை எகிப்திலிருந்து கொண்டுவந்தேன்.","poem":1},{"text":"பெலிஸ்தியரை கப்தோரிலிருந்தும்,","poem":2},{"lineBreak":true},{"text":"சீரியரை கீரிலிருந்தும் கொண்டுவரவில்லையோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“நிச்சயமாக ஆண்டவராகிய","poem":1},{"text":"யெகோவாவின் கண்கள் பாவமுள்ள அரசின்மேல் இருக்கின்றன.","poem":2},{"text":"பூமியின்மேல் இராதபடி அந்த அரசை அழிப்பேன்.","poem":1},{"text":"எனினும் யாக்கோபின் குடும்பத்தை","poem":2},{"text":"நான் முற்றிலும்","poem":1},{"text":"அழிக்கமாட்டேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“நானே கட்டளையிட்டு,","poem":1},{"text":"தானியத்தை அரிதட்டில் போட்டு அரித்தெடுப்பதுபோல,","poem":2},{"lineBreak":true},{"text":"எல்லா நாடுகளுக்குள்ளேயும்","poem":2},{"text":"இஸ்ரயேல் குடும்பத்தை அரித்தெடுப்பேன்.","poem":1},{"text":"ஒரு கூழாங்கல்லும் தரையில் விழாது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என் மக்களுள் வாழும் எல்லா பாவிகளும்,","poem":1},{"text":"பேராபத்து எங்களை","poem":2},{"text":"மேற்கொள்ளவோ சந்திக்கவோ மாட்டாது என்று","poem":1},{"text":"சொல்கின்ற எல்லோரும் வாளினால் சாவார்கள்.","poem":2}]},{"type":"heading","content":["இஸ்ரேலின் மறுசீரமைப்பு"]},{"type":"verse","number":11,"content":["“அந்த நாளில்",{"text":"“நான் விழுந்து கிடக்கும் தாவீதின் கூடாரத்தைத் திரும்பவும் அமைப்பேன்.","poem":1},{"text":"நான் அதன் உடைந்த இடங்களை பழுதுபார்த்து,","poem":2},{"lineBreak":true},{"text":"அதன் பாழிடங்களை சீரமைப்பேன்.","poem":2},{"lineBreak":true},{"text":"முன் இருந்ததுபோல அதைக் கட்டுவேன்,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அப்பொழுது என் மக்கள் ஏதோமில் மீதியாக இருப்போரையும்,","poem":1},{"text":"என் பெயரைத் தரித்திருக்கும் எல்லா நாடுகளையும்","poem":2},{"text":"உரிமையாக்கிக்கொள்வார்கள் என்று","poem":1},{"text":"இவற்றைச் செயற்படுத்தப்போகிற யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":13,"content":["“நாட்கள் வருகின்றன” என்று யெகோவா அறிவிக்கிறார்.",{"text":"“அப்பொழுது அறுவடை செய்கிறவனை உழுகிறவன் முந்திக்கொள்வான்;","poem":1},{"text":"நடுகிறவனை திராட்சைப் பழத்தைப் பிழிகிறவன் முந்திக்கொள்வான்.","poem":2},{"text":"மலைகளிலிருந்து புது திராட்சை இரசம்","poem":1},{"text":"வடிந்து எல்லாக் குன்றுகளின்மேலும் ஓடும்,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"நாடுகடத்தப்பட்ட என் மக்களாகிய இஸ்ரயேலரை முன்நிலைக்குக் கொண்டுவருவேன்.","poem":2},{"lineBreak":true},{"text":"“அவர்கள் பாழடைந்த பட்டணங்களை திரும்பக் கட்டி, அவற்றில் குடியிருந்து,","poem":1},{"text":"திராட்சைத் தோட்டங்களை நாட்டி, அதன் இரசத்தைக் குடித்து,","poem":2},{"lineBreak":true},{"text":"தோட்டங்களை உண்டாக்கி, அதன் பழங்களைச் சாப்பிடுவார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் இஸ்ரயேலை அவர்கள் சொந்த நாட்டிலே நாட்டுவேன்.","poem":1},{"text":"நான் அவர்களுக்குக் கொடுத்திருக்கும் நாட்டிலிருந்து,","poem":2},{"lineBreak":true},{"text":"இனியொருபோதும் வேரோடு பிடுங்கப்படமாட்டார்கள் என்று”","poem":2},"உங்கள் இறைவனாகிய யெகோவா சொல்கிறார்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}