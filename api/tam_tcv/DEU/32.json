{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"DEU","translationId":"tam_tcv","name":"உபாகமம்","commonName":"உபாகமம்","title":"உபாகமம்","order":5,"numberOfChapters":34,"sha256":"f1dc81b275dd233dacb5d55a7ad1b36976f1ba0c030e8808360322326c3d8391","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/tam_tcv/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":32,"content":[{"type":"verse","number":1,"content":[{"text":"வானங்களே, செவிகொடுங்கள், நான் பேசுவேன்.","poem":1},{"text":"பூமியே என் வாயின் வார்த்தைகளைக் கேள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் போதனை மழைபோலப் பெய்யட்டும்.","poem":1},{"text":"என் வார்த்தைகள் பனிபோல் இறங்கட்டும்,","poem":2},{"text":"அவை பசும்புல்மேல் மழைத்தூறல் போலவும்,","poem":1},{"text":"இளஞ்செடிகளின் மேல் பெருமழைபோலவும் பெய்யட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நான் யெகோவாவின் பெயரை அறிவிப்பேன்.","poem":1},{"text":"எங்கள் இறைவனின் மகத்துவத்தைத் துதியுங்கள்!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவரே கற்பாறை, அவருடைய செயல்கள் முழு நிறைவானவை.","poem":1},{"text":"அவரது வழிகளெல்லாம் நீதியானவை.","poem":2},{"text":"அவர் உண்மையுள்ள இறைவன். அவர் அநியாயம் செய்வதில்லை.","poem":1},{"text":"அவர் நேர்மையும், நீதியுமானவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இஸ்ரயேலரோ அவர்முன் இழிவானவற்றைச் செய்தார்கள்.","poem":1},{"text":"அதனால் அவருடைய பிள்ளைகளாய் இராமல்,","poem":2},{"lineBreak":true},{"text":"கபடமும் வஞ்சகமும் உள்ள சந்ததியாய் மாறி வெட்கத்திற்குள்ளானார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மூடரும், ஞானம் அற்றவர்களுமான மக்களே!","poem":1},{"text":"நீங்கள் யெகோவாவுக்கு நன்றிக்கடன் செய்வது இவ்விதம் தானோ?","poem":2},{"text":"உங்களைப் படைத்த தகப்பன் அவரல்லவா?","poem":1},{"text":"உங்களைப் படைத்து உருவாக்கியவர் அவரல்லவா?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"பழைய நாட்களை நினைவுகூருங்கள்;","poem":1},{"text":"கடந்துபோன தலைமுறைகளைப் பற்றிச் சிந்தித்துப் பாருங்கள்.","poem":2},{"text":"உங்கள் தகப்பனிடம் கேளுங்கள் அவர் உங்களுக்குச் சொல்வார்,","poem":1},{"text":"உங்கள் சபைத்தலைவர்களிடம் கேளுங்கள், அவர்கள் உங்களுக்கு விளங்கப்படுத்துவார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மகா உன்னதமானவர் நாடுகளுக்கு உரிமைச்சொத்தைப் பங்கிட்டபோது,","poem":1},{"text":"எல்லா மனுக்குலத்தையும் பிரித்தபோது,","poem":2},{"text":"இஸ்ரயேல் மக்களின் எண்ணிக்கையின்படியே,","poem":1},{"text":"மக்கள் கூட்டங்களின் எல்லைகளைத் திட்டமிட்டார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவின் மக்களே அவரின் பங்கு,","poem":1},{"text":"யாக்கோபே அவருடைய உரிமைச்சொத்து.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அவர் அவர்களைப் பாலைவன நாட்டிலே கண்டெடுத்தார்;","poem":1},{"text":"அதுவோ வறண்டதும், நரி ஊளையிடும் பாழ்நிலமுமாய் இருந்தது.","poem":2},{"text":"அவர் அவர்களைப் பாதுகாத்துப் பராமரித்தார்.","poem":1},{"text":"அவர் அவர்களைத் தமது கண்மணிபோல் காத்தருளினார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"கழுகு தன் கூட்டைக் கலைத்து,","poem":1},{"text":"தன் குஞ்சுகளுக்கு மேலாக அசைவாடி,","poem":2},{"text":"தன் சிறகுகளை விரித்து அவைகளை ஏந்திக்கொண்டு,","poem":1},{"text":"தன் செட்டைகளின்மேல் சுமந்து செல்வதுபோல,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"யெகோவா ஒருவரே அவர்களை வழிநடத்தினர்,","poem":1},{"text":"அவர்களுடன் வேறு அந்நிய தெய்வம் இருக்கவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"அவர் அவர்களை நிலத்தின் மேடுகளில் ஏறி நடக்கச் செய்தார்.","poem":1},{"text":"வயலின் பலன்களினால் அவர்களுக்கு உணவு கொடுத்தார்.","poem":2},{"text":"கற்பாறையில் இருந்து எடுத்த தேனினாலும்,","poem":1},{"text":"வைரப்பாறையிலிருந்து வழியும் எண்ணெயினாலும் அவர்களுக்கு ஊட்டமளித்தார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பசுக்களின் தயிர், ஆடுகளின் பால்,","poem":1},{"text":"கொழுத்த செம்மறியாட்டுக் குட்டிகள்,","poem":2},{"text":"வெள்ளாடுகள், பாசானில் தெரிந்தெடுத்த செம்மறியாட்டுக் கடாக்கள்,","poem":1},{"text":"சிறந்த கோதுமைத்தானியம் ஆகியவற்றாலும் ஊட்டமளித்தார்.","poem":2},{"text":"நுரைக்கும் இரத்தம் போன்ற திராட்சைப்பழத்தின் ரசத்தையும் குடித்தார்கள்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"யெஷூரன்","poem":1},{"noteId":17},{"text":"கொழுப்பு மிகுந்து அடங்காதவன் ஆனான்.","poem":1},{"text":"அவர்கள் வயிறாரத்தின்று, கொழுத்து, பருத்து, கொழுப்பு அதிகமுடையவர்களானார்கள்.","poem":2},{"text":"அப்பொழுது அவர்கள் தங்களைப் படைத்த இறைவனையே கைவிட்டு,","poem":1},{"text":"தங்கள் இரட்சிப்பின் கற்பாறையையும் புறக்கணித்தார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"இஸ்ரயேலர் அந்நிய தெய்வங்களைப் பின்பற்றி யெகோவாவுக்கு எரிச்சல்மூட்டி,","poem":1},{"text":"தங்கள் அருவருப்பான விக்கிரகங்களால் அவருக்குக் கோபம் உண்டாக்கினார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர்கள் பேய்களுக்குப் பலி செலுத்தினார்கள். அவை இறைவன் அல்ல.","poem":1},{"text":"அவர்கள் முன்பு அறிந்திராத தெய்வங்களே அவை.","poem":2},{"lineBreak":true},{"text":"சமீபத்தில் தோன்றியதும்,","poem":2},{"lineBreak":true},{"text":"உங்கள் முற்பிதாக்கள் பயப்படாததுமான தெய்வங்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உங்களை உருவாக்கிய கற்பாறையைக் கைவிட்டு விட்டீர்கள்.","poem":1},{"text":"உங்களைப் பெற்றெடுத்த இறைவனையும் மறந்துபோனீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யெகோவா இதைக்கண்டு தனது மகன்களும்,","poem":1},{"text":"மகள்களுமான அவர்களோடு கோபம் கொண்டதனால் அவர்களைப் புறக்கணித்து சொன்னதாவது:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"“அவர்களுக்கு என் முகத்தை மறைப்பேன்;","poem":1},{"text":"அவர்களின் முடிவு எப்படியாகும் என பார்ப்பேன்.","poem":2},{"text":"மேலும் அவர், அவர்கள் கொடுமையில் ஊறிய தலைமுறையினர்,","poem":1},{"text":"நம்பிக்கை துரோகம் செய்யும் பிள்ளைகள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"தெய்வம் அல்லாதவற்றால் எனக்கு எரிச்சல்மூட்டி,","poem":1},{"text":"பயனற்ற விக்கிரகங்களினால் கோபத்தை மூட்டினார்கள்.","poem":2},{"text":"நான் மக்களென மதிக்கப்படாதவர்களால் அவர்களுக்கு எரிச்சல் மூட்டுவேன்,","poem":1},{"text":"பகுத்தறிவு இல்லாத தேசத்தால், நான் அவர்களுக்குக் கோபமூட்டுவேன்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"எனது கோபத்தினால் நெருப்பு மூட்டப்பட்டிருக்கிறது,","poem":1},{"text":"அது பாதாளத்தின்கீழ் முனைவரையும் எரிகிறது.","poem":2},{"text":"அது பூமியையும், அதன் விளைச்சலையும் எரிக்கும்,","poem":1},{"text":"மலைகளின் அஸ்திபாரங்களையும் கொலித்திவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“நான் அவர்கள்மேல் பேரழிவுகளைக் குவிப்பேன்;","poem":1},{"text":"அவர்கள்மேல் என் அம்புகளை கணக்கின்றி எய்வேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நான் அவர்களுக்கு எதிராக வாட்டும் பஞ்சத்தை அனுப்புவேன்;","poem":1},{"text":"விழுங்கும் கொள்ளைநோய்களையும், சாகடிக்கும் வாதைகளையும் அனுப்புவேன்.","poem":2},{"text":"கூரிய பற்களையுடைய காட்டு மிருகங்களையும்,","poem":1},{"text":"புழுதியில் ஊரும் விஷப்பாம்புகளையும் அனுப்புவேன்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"வீதிகளிலே, வாளானது அவர்களைப் பிள்ளைகள் அற்றவர்களாக்கும்;","poem":1},{"text":"அவர்களுடைய வீடுகளில் பயங்கரம் ஆளுகை செய்யும்.","poem":2},{"text":"இளைஞரும், இளம்பெண்களும் அழிவார்கள்;","poem":1},{"text":"குழந்தைகளும் நரைத்துப்போன கிழவர்களும் அழிவார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நான் அவர்களைச் சிதறடிப்பேன்;","poem":1},{"text":"மனுக்குலத்தில் இருந்து அவர்களைப்பற்றிய ஞாபகத்தையும் அற்றுப்போகப்பண்ணுவேன்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"‘எங்கள் கைகளே வெற்றிகொண்டன,","poem":1},{"text":"யெகோவா இவற்றைச் செய்யவில்லை’ என்று,","poem":2},{"text":"தப்பான எண்ணங்கொண்டு அவர்களுடைய பகைவன்,","poem":1},{"text":"ஏளனம் செய்வான் என்றே தயங்கினேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"இஸ்ரயேல் ஒரு உணர்வற்ற நாடு,","poem":1},{"text":"நிதானிக்கும் ஆற்றல் அவர்களிடமில்லை.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர்கள் ஞானமுள்ளவர்களாயிருந்து, இதை விளங்கிக்கொண்டு,","poem":1},{"text":"தங்களது முடிவை நிதானித்தறிந்தால் நலமாயிருக்கும்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவர்களில் ஆயிரம்பேரை ஒருவன் துரத்துவதெப்படி?","poem":1},{"text":"பத்தாயிரம்பேரை இருவர் ஒடவைப்பது எப்படி?","poem":2},{"text":"அவர்களுடைய கற்பாறையான யெகோவா அவர்களை விற்றுப்போடாவிட்டால்,","poem":1},{"text":"அல்லது யெகோவா அவர்களைக் கைவிடாவிட்டால் இது எப்படி நடக்கும்?","poem":2}]},{"type":"verse","number":31,"content":[{"text":"நமது பகைவர் ஒத்துக்கொள்வதுபோல்,","poem":1},{"text":"அவர்களுடைய கல் நம்முடைய கற்பாறையானவரைப் போன்றது அல்ல.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"பகைவர்களின் திராட்சைக்கொடி சோதோமின் திராட்சைக் கொடியிலிருந்து உண்டானது.","poem":1},{"text":"கொமோராவின் வயல்களிலிருந்து வந்தது.","poem":2},{"text":"அவர்களின் திராட்சைப் பழங்கள் நஞ்சு நிறைந்தவை.","poem":1},{"text":"அவர்களுடைய திராட்சைக் குலைகள் கசப்பு நிறைந்தவை.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அவர்களின் திராட்சை இரசம் பாம்புகளின் விஷமாயிருக்கிறது.","poem":1},{"text":"அது நாகபாம்பின் கொடிய நஞ்சாயிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“யெகோவா சொல்கிறதாவது: இதை நான் சேர்த்துவைத்து,","poem":1},{"text":"என் களஞ்சியங்களில் முத்திரையிடவில்லையோ?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"பழிவாங்குதல் எனக்குரியது; நானே பதில் செய்வேன்.","poem":1},{"text":"ஏற்றகாலத்தில் அவர்களின் கால்கள் சறுக்கும்.","poem":2},{"text":"அவர்களுடைய பேரழிவின் நாள் நெருங்கிற்று.","poem":1},{"text":"அவர்களின் பேரழிவு அவர்கள்மேல் விரைந்துவருகிறது” என்றார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":36,"content":[{"text":"யெகோவா தமது மக்களை நியாயந்தீர்ப்பார்.","poem":1},{"text":"அவர் தன் பணியாட்கள்மேல் கருணைகாட்டுவார்.","poem":2},{"text":"அவர்களின் பெலன் அற்றுப்போவதையும் அவர்களில் அடிமையோ,","poem":1},{"text":"சுயாதீனரோ ஒருவனும் தப்பாமல் இருப்பதையும் காணும்போது அவர் இரக்கம் காட்டுவார்.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"ஆனாலும் அவர், “இப்பொழுது அவர்களுடைய தெய்வங்கள் எங்கே?","poem":1},{"text":"அவர்கள் அடைக்கலம் புகுந்த கல் எங்கே?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"அவர்களுடைய பலிகளின் கொழுபைத்தின்ற தெய்வங்கள் எங்கே?","poem":1},{"text":"பானகாணிக்கைகளின் திராட்சை இரசத்தைக் குடித்த தெய்வங்கள் எங்கே?","poem":2},{"text":"அவை உங்களுக்கு உதவிசெய்ய எழுந்திருக்கட்டும்.","poem":1},{"text":"அவை உங்களுக்கு அடைக்கலம் கொடுக்கட்டும்” என்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“இப்பொழுது பாருங்கள், நான், நானே அவர்!","poem":1},{"text":"என்னைவிட வேறு தெய்வமில்லை.","poem":2},{"text":"நானே கொல்கிறேன்; நானே உயிர்ப்பிக்கிறேன்.","poem":1},{"text":"நானே காயப்படுத்தினேன், நானே குணப்படுத்துவேன்.","poem":2},{"lineBreak":true},{"text":"என் கையிலிருந்து விடுவிக்க ஒருவராலும் முடியாது.”","poem":2}]},{"type":"verse","number":40,"content":[{"text":"நான் என் கைகளை வானத்திற்கு உயர்த்தி அறிவிக்கிறதாவது:","poem":1},{"text":"“நான் என்றென்றும் வாழ்வது நிச்சயம்போல,","poem":2}]},{"type":"verse","number":41,"content":[{"text":"பளபளக்கும் என் வாளை நான் கூராக்கி,","poem":1},{"text":"நீதி வழங்கும்படி என் கை அதைப் பற்றிக்கொள்ளும்போது,","poem":2},{"text":"என் எதிரிகளிடம் பழிவாங்குவேன்;","poem":1},{"text":"என்னை வெறுத்தவர்களுக்குப் பதில் செய்வேன்.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"செத்தும், சிறைப்பட்டும் போனவர்களின் இரத்தத்தினால்","poem":1},{"text":"நான் என் அம்புகளை வெறிகொள்ளச் செய்வேன்.","poem":2},{"text":"எனது வாளோ அவர்களின் சதையைத் தின்னும்;","poem":1},{"text":"அது பகைவரின் தலைவர்களின் தலைகளை வெட்டி வீழ்த்தும் என்பதும் நிச்சயம்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"நாடுகளே, அவருடைய மக்களோடு சேர்ந்து களிகூருங்கள்.","poem":1},{"text":"அவர் தன் பணியாட்களின் இரத்தத்துக்காகப் பழிவாங்குவார்.","poem":2},{"text":"அவர் தமது பகைவரைப் பழிவாங்கி, தமது நாட்டுக்காகவும்,","poem":1},{"text":"மக்களுக்காகவும் பாவநிவிர்த்திசெய்வார்.","poem":2}]},{"type":"verse","number":44,"content":["பின்பு மோசே நூனின் மகனான யோசுவாவுடன் வந்து, இந்தப் பாட்டின் சொற்களையெல்லாம் மக்கள் கேட்கும்படி பேசினான்."]},{"type":"verse","number":45,"content":["மோசே இந்த வார்த்தைகளையெல்லாம் இஸ்ரயேலர் எல்லாருக்கும் சொல்லி முடித்தபின்பு,"]},{"type":"verse","number":46,"content":["அவன் அவர்களிடம், “நான் இன்று பயபக்தியுடன் உங்களுக்கு அறிவித்த இந்த வார்த்தைகளை உங்கள் இருதயத்தில் பதித்துக்கொள்ளுங்கள். இந்த சட்டத்தின் வார்த்தைகளுக்கெல்லாம் கவனமாய் கீழ்ப்படியும்படி உங்கள் பிள்ளைகளுக்கும் கட்டளையிடுங்கள்."]},{"type":"verse","number":47,"content":["அவை உங்களுக்குக் கொடுக்கப்படும் வீண் வார்த்தைகள் அல்ல. அவையே உங்களுக்கு உயிர்கொடுக்கும். நீங்கள் யோர்தானைக் கடந்து உரிமையாக்கிக்கொள்ளும் நாட்டில் இந்த வார்த்தைகளினால் நீடித்து வாழ்வீர்கள்” என்றான்."]},{"type":"heading","content":["மோசேயின் மரணம் முன்னறிவிக்கப்படுதல்"]},{"type":"verse","number":48,"content":["அதே நாளில் யெகோவா மோசேயிடம் சொன்னதாவது,"]},{"type":"verse","number":49,"content":["“நீ எரிகோவுக்கு எதிரேயுள்ள மோவாப் நாட்டிலே இருக்கும் அபாரீம் மலைத்தொடரில் ஏறி நேபோ மலைக்குப்போ. அங்கிருந்து இஸ்ரயேலருக்கு நான் உரிமைச்சொத்தாகக் கொடுக்கும் கானான் நாட்டைப் பார்."]},{"type":"verse","number":50,"content":["நீ ஏறும் அந்த மலையிலேயே இறப்பாய். உன் சகோதரன் ஆரோன் ஓர் என்னும் மலையில் இறந்து தன் முன்னோருடன் சேர்த்துக்கொள்ளப்பட்டது போல், நீயும் உன் முன்னோருடன் சேர்த்துக்கொள்ளப்படுவாய்."]},{"type":"verse","number":51,"content":["சீன் பாலைவனத்தில் மேரிபா காதேஷ் தண்ணீர் அருகே இஸ்ரயேலர் முன்னிலையில் நீங்கள் இருவரும் எனக்கு நம்பிக்கையற்றவர்களாய் இருந்தீர்கள். இஸ்ரயேலர் மத்தியிலே நீ எனது பரிசுத்தத்தையும் பேணிக்காத்துக்கொள்ளவில்லை. இதனாலேயே உனக்கு இப்படி நடக்கும்."]},{"type":"verse","number":52,"content":["ஆகையால் நீ தூரத்திலிருந்து மட்டுமே அந்த நாட்டைப் பார்ப்பாய். இஸ்ரயேல் மக்களுக்கு நான் கொடுக்கும் நாட்டிற்குள் நீ போகமாட்டாய்” என்றார்."]}],"footnotes":[{"noteId":17,"caller":"+","text":"யெஷூரன் என்றால் நேர்மையானவன் என்று பொருள், இஸ்ரயேலின் மறுபெயர். ஏசா. 44:2.","reference":{"chapter":32,"verse":15}}]},"thisChapterLink":"/api/tam_tcv/DEU/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/DEU/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/DEU/31.json","previousChapterAudioLinks":{},"numberOfVerses":52}