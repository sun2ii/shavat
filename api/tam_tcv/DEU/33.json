{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"DEU","translationId":"tam_tcv","name":"உபாகமம்","commonName":"உபாகமம்","title":"உபாகமம்","order":5,"numberOfChapters":34,"sha256":"f1dc81b275dd233dacb5d55a7ad1b36976f1ba0c030e8808360322326c3d8391","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/DEU/1.json","lastChapterNumber":34,"lastChapterApiLink":"/api/tam_tcv/DEU/34.json","totalNumberOfVerses":959},"chapter":{"number":33,"content":[{"type":"heading","content":["மோசே கோத்திரங்களை ஆசீர்வதித்தல்"]},{"type":"verse","number":1,"content":["இறைவனின் மனிதனாகிய மோசே தான் இறப்பதற்குமுன் இஸ்ரயேல் மக்கள்மேல் கூறிய ஆசீர்வாதம் இதுவே."]},{"type":"verse","number":2,"content":["அவன் சொல்லியதாவது:",{"text":"“யெகோவா சீனாயிலிருந்து வந்து,","poem":1},{"text":"சேயீரிலிருந்து அவர்கள்மேல் உதித்தார்.","poem":2},{"lineBreak":true},{"text":"பாரான் மலையிலிருந்து அவர் பிரகாசித்தார்.","poem":2},{"text":"ஆயிரக்கணக்கான பரிசுத்தவான்களுடன் தெற்கிலிருந்தும்,","poem":1},{"text":"மலைச்சரிவுகளிலிருந்தும் வந்தார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நிச்சயமாக நீரே மக்களில் அன்பு செலுத்துகிறீர்.","poem":1},{"text":"எல்லா பரிசுத்தவான்களும் உமது கரத்திலே இருக்கிறார்கள்.","poem":2},{"text":"அவர்கள் உம்முடைய பாதங்களில் விழுந்து வணங்குகிறார்கள்.","poem":1},{"text":"உம்மிடமிருந்து அறிவுறுத்தலை பெற்றுக்கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மோசே எங்களுக்குக் கொடுத்த சட்டமே அந்த அறிவுறுத்தல்.","poem":1},{"text":"அது யாக்கோபின் சபையாருக்கு உடைமையாய் இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இஸ்ரயேலின் கோத்திரங்களுடன்.","poem":1},{"text":"மக்களின் தலைவர்கள் ஒன்றாய் கூடியபோது,","poem":2},{"lineBreak":true},{"text":"யெஷூரன்மேல் யெகோவாவே அரசனாய் இருந்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ரூபன் வாழட்டும்; அவன் சாகக்கூடாது,","poem":1},{"text":"அவனுடைய மனிதர் குறையாமல் இருக்கட்டும்.”","poem":2}]},{"type":"verse","number":7,"content":["அவன் யூதாவைப்பற்றிச் சொன்னதாவது:",{"text":"“யெகோவாவே, யூதாவின் கதறுதலைக் கேளும்;","poem":1},{"text":"அவனை அவனுடைய மக்களிடம் கொண்டுவாரும்.","poem":2},{"text":"அவன் தன் சொந்தக் கரங்களால் அவனுடைய உரிமைகளுக்காகப் போராடுகிறான்.","poem":1},{"text":"அவனுடைய பகைவருக்கு எதிராக அவனுக்குத் துணையாய் இரும்.”","poem":2}]},{"type":"verse","number":8,"content":["லேவியைப்பற்றி அவன் சொன்னதாவது:",{"text":"“நீர் தயவுகாட்டிய மனிதனுக்கே","poem":1},{"text":"உமது தும்மீம், ஊரீம் உரியவை.","poem":2},{"text":"நீர் மாசாவில் அவனைத் சோதித்தீர்.","poem":1},{"text":"மேரிபாவின் தண்ணீர் அருகே அவனுடன் வாக்குவாதம் பண்ணினீர்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவன் தன் தகப்பனையும், தாயையும்பற்றி,","poem":1},{"text":"‘நான் அவர்களைக் கவனத்தில் கொள்ளமாட்டேன்’ என்றான்.","poem":2},{"text":"அவன் தன் சகோதரர்களை அங்கீகரிக்கவில்லை.","poem":1},{"text":"தன் பிள்ளைகளையும் ஏற்றுக்கொள்ளவில்லை.","poem":2},{"text":"ஆனால் அவன் உம்முடைய வார்த்தையைக் கண்காணித்து,","poem":1},{"text":"உம்முடைய உடன்படிக்கையைக் காவல்செய்தான்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவன் உமது ஒழுங்குவிதிகளை யாக்கோபுக்கும்,","poem":1},{"text":"உமது சட்டத்தை இஸ்ரயேலுக்கும் போதிக்கிறான்.","poem":2},{"text":"உமது முன்னிலையில் தூபங்காட்டுகிறான்.","poem":1},{"text":"உமது பலிபீடத்தில் முழுமையான தகன காணிக்கையைச் செலுத்துகிறான்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவாவே, அவனுடைய திறமைகளை ஆசீர்வதியும்.","poem":1},{"text":"அவனுடைய கைகளின் வேலையில் பிரியமாயிரும்.","poem":2},{"text":"அவனுக்கு எதிரே எழும்புவோரின் இடுப்புகளை அடித்து நொறுக்கும்.","poem":1},{"text":"அவனுடைய பகைவர்கள் இனி ஒருபோதும் எழும்பாதபடி அவர்களை அடியும்.”","poem":2}]},{"type":"verse","number":12,"content":["பென்யமீனைப்பற்றி அவன் சொன்னது:",{"text":"“யெகோவாவினால் அன்புகூரப்பட்டவன் அவரில் பாதுகாப்பாய் இளைப்பாறட்டும்.","poem":1},{"text":"ஏனெனில் அவர் அவனை நாள்முழுவதும் பாதுகாக்கிறார்.","poem":2},{"lineBreak":true},{"text":"யெகோவா அன்புகூரும் அவன் அவருடைய தோள்களுக்கிடையில் இளைப்பாறுகிறான்.”","poem":2}]},{"type":"verse","number":13,"content":["யோசேப்பைப்பற்றி அவன் சொன்னது:",{"text":"“யெகோவா அவனுடைய நாட்டை,","poem":1},{"text":"மேலே வானத்திலிருந்து வரும் பனியினாலும்,","poem":2},{"lineBreak":true},{"text":"கீழே பூமியின் ஆழத்திலிருந்துவரும் தண்ணீர்களாலும் ஆசீர்வதிப்பாராக.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"சூரியன் விளைவிக்கும் சிறந்த விளைச்சலினாலும்,","poem":1},{"text":"சந்திரன் விளைவிக்கும் அருமையான பொருட்களாலும் ஆசீர்வதிப்பாராக.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"பூர்வகால மலைகளின் மிகச்சிறந்த கொடைகளாலும்,","poem":1},{"text":"அழியாத குன்றுகளின் செழிப்பினாலும் ஆசீர்வதிப்பாராக.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"பூமியின் மிகச்சிறந்த கொடைகளினாலும், நிறைவினாலும் ஆசீர்வதிப்பாராக.","poem":1},{"text":"எரிகின்ற புதரில் வாழ்ந்தவரின் தயவினாலும் ஆசீர்வதிப்பாராக.","poem":2},{"text":"இவை எல்லாம் யோசேப்பின் தலையின்மேல் தங்கட்டும்.","poem":1},{"text":"தனது சகோதரருள் இளவரசனாயிருந்தவனின் உச்சந்தலையிலும் தங்குவதாக.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"மாட்சிமையில் அவன் தலையீற்று காளைபோல் இருக்கிறான்.","poem":1},{"text":"அவன் கொம்புகளோ காட்டு எருதின் கொம்புகள்போல் இருக்கின்றன.","poem":2},{"text":"அவற்றால் நாடுகளைக் குத்திக் கிழிப்பான்.","poem":1},{"text":"பூமியின் கடையாந்தரங்களில் இருப்பவர்களைக்கூட குத்திக் கிழிப்பான்.","poem":2},{"text":"எப்பிராயீமின் பத்தாயிரம்பேரும் இப்படிப்பட்டவர்களே.","poem":1},{"text":"மனாசேயின் ஆயிரம்பேரும் இப்படிப்பட்டவர்களே.”","poem":2}]},{"type":"verse","number":18,"content":["செபுலோனைப்பற்றி அவன் சொன்னதாவது:",{"text":"“செபுலோனே நீ வெளியே போகையில் களிகூரு.","poem":1},{"text":"இசக்காரே நீ கூடாரங்களிலிருந்து களிகூரு.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர்கள் மக்களை மலைக்கு அழைப்பிப்பார்கள்.","poem":1},{"text":"அங்கே நீதியின் பலிகளைச் செலுத்துவார்கள்.","poem":2},{"text":"அவர்கள் கடல்களின் நிறை வளங்களிலும்,","poem":1},{"text":"மண்ணுள் மறைந்திருக்கும் செல்வங்களிலும் விருந்து உண்பார்கள்.”","poem":2}]},{"type":"verse","number":20,"content":["காத்தியரைப்பற்றி அவன் சொன்னதாவது:",{"text":"“காத்தியரின் ஆளுகைகளை விரிவுபடுத்துபவன் ஆசீர்வதிக்கப்பட்டவன்.","poem":1},{"text":"காத் சிங்கத்தைப்போல் படுத்திருப்பான்.","poem":2},{"lineBreak":true},{"text":"அவன், புயத்தையும் தலையையும் கிழிக்கும் சிங்கத்தைப்போல் படுத்திருப்பான்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவன் சிறந்த நிலத்தை தனக்கென்று தெரிந்துகொண்டான்.","poem":1},{"text":"தலைவருக்கான பங்கு அவனுக்காக ஒதுக்கப்பட்டிருந்தது.","poem":2},{"text":"மக்களின் தலைவர்கள் ஒன்றுகூடியபோது,","poem":1},{"text":"அவன் யெகோவாவின் நீதியையும்,","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலருக்கான யெகோவாவின் நியாயத்தீர்ப்புகளையும் நிறைவேற்றினான்.”","poem":2}]},{"type":"verse","number":22,"content":["தாணைப்பற்றி அவன் சொன்னதாவது:",{"text":"“தாண் பாசானிலிருந்து,","poem":1},{"text":"பாய்கிற சிங்கக்குட்டி.”","poem":2}]},{"type":"verse","number":23,"content":["நப்தலியைப்பற்றி அவன் சொன்னதாவது:",{"text":"“நப்தலி யெகோவாவின் தயவில் பெருகி","poem":1},{"text":"அவரின் ஆசீர்வாதத்தால் நிறைந்திருக்கிறான்.","poem":2},{"lineBreak":true},{"text":"அவன் கலிலேயா கடலின் தெற்குப் பக்கமாக உள்ள பகுதியை உரிமையாக்கிக்கொள்வான்.”","poem":2}]},{"type":"verse","number":24,"content":["ஆசேரைப்பற்றி அவன் சொன்னதாவது:",{"text":"“ஆசேர் மகன்களுக்குள் அதிகமாய் ஆசீர்வதிக்கப்பட்டவன்.","poem":1},{"text":"சகோதரரிடமிருந்து அவனுக்கு ஆதரவு கிடைக்கும்.","poem":2},{"lineBreak":true},{"text":"அவன் தன் பாதங்களை எண்ணெயில் குளிப்பாட்டட்டும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உன் வாயிற்கதவுகளின் தாழ்ப்பாள்கள் இரும்பும் வெண்கலமுமாய் இருக்கும்.","poem":1},{"text":"நீ வாழும் காலமெல்லாம் உன் பெலனும் நீடித்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“யெஷூரனின் இறைவனைப்போல் வேறொருவரும் இல்லை.","poem":1},{"text":"அவர் உனக்கு உதவிசெய்ய வானங்களிலும்,","poem":2},{"lineBreak":true},{"text":"அவருடைய மகத்துவத்துடன் மேகங்களிலும் ஏறிவருவார்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"என்றும் வாழ்கிற இறைவன் உன் அடைக்கலம்.","poem":1},{"text":"அவரின் நித்திய புயங்கள் உன்னைத் தாங்கும்.","poem":2},{"text":"அவர், ‘பகைவனை அழித்துவிடு!’ என்று சொல்லி,","poem":1},{"text":"உன் பகைவனை உனக்கு முன்பாகத் துரத்திவிடுவார்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"இஸ்ரயேல் தனிமையாய் பாதுகாப்புடன் வாழும்.","poem":1},{"text":"தானியமும், புது திராட்சை இரசமும் உள்ள நாட்டில்,","poem":2},{"text":"யாக்கோபின் நீரூற்று","poem":1},{"noteId":18},{"text":"பாதுகாப்பாய் இருக்கிறது.","poem":1},{"text":"அங்கே வானம் பனியைப் பெய்கின்றது.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"இஸ்ரயேலேரே, நீங்கள் ஆசீர்வதிக்கப்பட்டவர்கள்!","poem":1},{"text":"யெகோவாவினால் மீட்கப்பட்ட மக்களான உங்களைப்போல் வேறு யார் இருக்கிறார்கள்?","poem":2},{"lineBreak":true},{"text":"அவரே உங்கள் கேடயமும்,","poem":2},{"text":"உங்களுக்கு உதவி செய்பவருமாயிருக்கிறார்.","poem":1},{"text":"அவரே உங்களது மகிமையான வாளுமாயிருக்கிறார்.","poem":2},{"text":"உங்களது பகைவர் உங்களுக்கு முன்பாக அஞ்சி ஒதுங்குவார்கள்.","poem":1},{"text":"நீங்கள் அவர்களின் தொழுகைமேடுகளை","poem":2},{"noteId":19},{"text":"மிதிப்பீர்கள்.”","poem":2}]}],"footnotes":[{"noteId":18,"caller":"+","text":"எபிரெய கிரேக்க கையெழுத்துப் பிரதியில் நீரூற்று என்றுள்ளது.","reference":{"chapter":33,"verse":28}},{"noteId":19,"caller":"+","text":"அல்லது அவர்களின் பின்புறத்தை.","reference":{"chapter":33,"verse":29}}]},"thisChapterLink":"/api/tam_tcv/DEU/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/DEU/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/DEU/32.json","previousChapterAudioLinks":{},"numberOfVerses":29}