{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ECC","translationId":"tam_tcv","name":"பிரசங்கி","commonName":"பிரசங்கி","title":"பிரசங்கி","order":21,"numberOfChapters":12,"sha256":"a164b9e0cfcc0d897a202be39ba683cf423e43069ddf4b7137961fb40abb6132","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tam_tcv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":1,"content":[{"type":"heading","content":["எல்லாம் அர்த்தமற்றவை"]},{"type":"verse","number":1,"content":["தாவீதின் மகனும், எருசலேமின் அரசனுமான பிரசங்கியின் வார்த்தைகள்:"]},{"type":"verse","number":2,"content":[{"text":"“அர்த்தமற்றவை! அர்த்தமற்றவை!","poem":1},{"text":"முற்றிலும் அர்த்தமற்றவை;","poem":2},{"text":"எல்லாமே அர்த்தமற்றவை” என்று","poem":1},{"text":"பிரசங்கி கூறுகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"மனிதனின் எல்லா உழைப்பினாலும் அவன் பெறும் இலாபம் என்ன?","poem":1},{"text":"சூரியனுக்குக் கீழே","poem":2},{"noteId":0},{"text":"அவன் படும் பிரசாயத்தினால் பலன் என்ன?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"சந்ததிகள் தோன்றி, சந்ததிகள் மறைகின்றன;","poem":1},{"text":"ஆனாலும் பூமி மட்டும் என்றென்றைக்கும் நிலைத்திருக்கின்றது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"சூரியன் உதிக்கிறது, சூரியன் மறைகிறது;","poem":1},{"text":"தான் உதிக்கும் இடத்திற்கே அது விரைந்து திரும்பிச் செல்கிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"காற்று தெற்கு நோக்கி வீசுகிறது,","poem":1},{"text":"வடக்கு நோக்கியும் திரும்புகிறது;","poem":2},{"text":"அது சுழன்று சுழன்று அடித்து,","poem":1},{"text":"எப்போதும் தான் சுற்றிவந்த இடத்திற்கே திரும்பிச் செல்கிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எல்லா ஆறுகளும் கடலில் கலக்கின்றன,","poem":1},{"text":"ஆனாலும் கடல் ஒருபோதும் நிறைவதில்லை.","poem":2},{"text":"ஆறுகள் ஊற்றெடுத்த இடத்திற்கே","poem":1},{"text":"திரும்பிப் போகின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஒருவனாலும் சொல்ல முடியாத அளவுக்கு","poem":1},{"text":"எல்லாக் காரியங்களும் வருத்தத்தையே கொடுக்கின்றன.","poem":2},{"text":"எவ்வளவு பார்த்தாலும் கண்களுக்கு ஆவல் தீருவதில்லை,","poem":1},{"text":"எவ்வளவு கேட்டாலும் காதுகள் திருப்தியடைவதில்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இருந்ததே இனிமேலும் இருக்கும்,","poem":1},{"text":"செய்யப்பட்டதே இனிமேலும் செய்யப்படும்;","poem":2},{"lineBreak":true},{"text":"சூரியனுக்குக் கீழே புதிதாக ஒன்றுமேயில்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“பாருங்கள், இது புதிதானது!”","poem":1},{"text":"என்று யாராவது சொல்லத்தக்கது ஏதாவது ஒன்று உண்டோ?","poem":2},{"text":"அது நெடுங்காலத்திற்கு முன்பே இங்கு இருந்தது;","poem":1},{"text":"நமது காலத்திற்கு முன்பும் இங்கு இருந்தது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"முற்காலத்து மனிதரைக் குறித்து ஒருவருக்கும் ஞாபகம் இருப்பதில்லை;","poem":1},{"text":"அதுபோல இனிமேல் வரப்போகிறவர்களுக்கும்,","poem":2},{"text":"பின்வரும் காரியங்களைக்குறித்து","poem":1},{"text":"ஞாபகம் இருக்காது.","poem":2}]},{"type":"heading","content":["ஞானம் அர்த்தமற்றது"]},{"type":"verse","number":12,"content":["பிரசங்கியாகிய நான் எருசலேமில் இஸ்ரயேலுக்கு அரசனாய் இருந்தேன்."]},{"type":"verse","number":13,"content":["வானத்தின்கீழ் நடைபெறும் எல்லாவற்றையும் ஞானத்தினால் ஆராய்ந்து கண்டுபிடிக்கும்படி என்னை நான் அர்ப்பணித்தேன். மனுக்குலத்தின்மேல் இறைவன் வைத்திருக்கிறது எவ்வளவு பெரிய பாரம்!"]},{"type":"verse","number":14,"content":["சூரியனுக்குக் கீழே செய்யப்படும் எல்லா செயல்களையும் நான் பார்த்திருக்கிறேன்; அவை அனைத்தும் அர்த்தமற்றவை, எல்லாம் காற்றைத் துரத்திப்பிடிக்கும் முயற்சியே."]},{"type":"verse","number":15,"content":[{"text":"வளைந்ததை நேராக்கமுடியாது;","poem":1},{"text":"இல்லாததை எண்ணிக் கணக்கிட முடியாது.","poem":2}]},{"type":"verse","number":16,"content":["“பாருங்கள், எனக்குமுன் எருசலேமில் ஆளுகை செய்த எல்லோரையும்விட, நான் ஞானத்தில் வளர்ந்து பெருகியிருக்கிறேன்; ஞானத்திலும் அறிவிலும் அதிகமானதை நான் என் அனுபவத்தில் கண்டிருக்கிறேன்” என்று நான் எனக்குள் சொல்லிக்கொண்டேன்."]},{"type":"verse","number":17,"content":["பின்பு நான் ஞானத்தை விளங்கிக்கொள்வதற்கும், பைத்தியக்காரத்தனத்தையும் மூடத்தனத்தையும் விளங்கிக்கொள்ளவும் அதில் முழுமையாய் ஈடுபட்டேன். ஆனால் இதுவும் காற்றைத் துரத்திப்பிடிக்கும் முயற்சியே என்று அறிந்துகொண்டேன்."]},{"type":"verse","number":18,"content":[{"text":"ஏனெனில் அதிக ஞானத்தினால் அதிக துக்கம் வருகிறது;","poem":1},{"text":"அதிக அறிவினால் அதிக கவலையும் வருகிறது.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"சூரியனுக்குக் கீழே என்பது உலகத்தில் என்று அர்த்தம்.","reference":{"chapter":1,"verse":3}}]},"thisChapterLink":"/api/tam_tcv/ECC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ECC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/31.json","previousChapterAudioLinks":{},"numberOfVerses":18}