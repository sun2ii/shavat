{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ECC","translationId":"tam_tcv","name":"பிரசங்கி","commonName":"பிரசங்கி","title":"பிரசங்கி","order":21,"numberOfChapters":12,"sha256":"a164b9e0cfcc0d897a202be39ba683cf423e43069ddf4b7137961fb40abb6132","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tam_tcv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"செத்த ஈக்கள் நறுமணத் தைலத்திலும் கெட்ட நாற்றத்தை ஏற்படுத்துகின்றன.","poem":1},{"text":"அதுபோலவே ஒரு சிறு மூடத்தனம் ஞானத்திற்கும், மதிப்பிற்கும் மேலோங்கி நிற்கும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஞானமுள்ளவர்களின் இருதயம் நியாயத்தின் பக்கம் சாய்கிறது,","poem":1},{"text":"மூடர்களின் இருதயமோ வழிவிலகிப் போவதையே தேடுகிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஒரு மூடன் வீதியில் போகும்போதே,","poem":1},{"text":"புத்தியற்றவனாக நடந்து எல்லோருக்கும்","poem":2},{"lineBreak":true},{"text":"தான் எவ்வளவு மதியீனன் என்பதைக் காண்பிக்கிறான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஒரு ஆளுநனின் கோபம் உனக்கெதிராக மூண்டால்,","poem":1},{"text":"நீ உன் பதவியைவிட்டு விலகாதே;","poem":2},{"lineBreak":true},{"text":"நிதானமாயிருந்தால் பெரிய குற்றமும் மன்னிக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"சூரியனுக்குக் கீழே நான் கண்ட வேறொரு தீமையும் உண்டு,","poem":1},{"text":"ஒரு ஆளுநனிடமிருந்து வரும் ஒருவிதத் தவறே அது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மூடர்கள் பல உயர்ந்த பதவிகளில் அமர்த்தப்படுகிறார்கள்;","poem":1},{"text":"செல்வந்தர்களோ தாழ்ந்த பதவிகளையே வகிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அடிமைகள் குதிரையில் ஏறிச் சவாரி செய்கிறதை நான் கண்டிருக்கிறேன்;","poem":1},{"text":"பிரபுக்களோ அடிமைகளைப்போல் நடந்து செல்வதையும் கண்டிருக்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"குழி ஒன்றை வெட்டுகிறவன் அதில் விழக்கூடும்;","poem":1},{"text":"பழைய சுவரை இடிப்பவனையும் பாம்பு கடிக்கக்கூடும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"கற்களைக் குழிகளில் தோண்டி எடுப்பவன் அவற்றால் காயப்படக்கூடும்;","poem":1},{"text":"மரக்கட்டையை பிளக்கிறவனுக்கு அதனாலே ஆபத்து உண்டாகலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ஒரு கோடரி மழுங்கிப் போய்","poem":1},{"text":"அதின் முனை கூர்மையாக்கப்படாமல் இருந்தால்,","poem":2},{"text":"அதிக பலம் வேண்டியிருக்கும்.","poem":1},{"text":"ஆனால் தொழில் திறமையோ வெற்றியைக் கொண்டுவரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ஒரு பாம்பை வசியப்படுத்துமுன் அது கடிக்குமானால்,","poem":1},{"text":"அதை வசியப்படுத்தும் வித்தைத் தெரிந்தும் பயனில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ஞானமுள்ளவர்களின் வாயிலிருந்து வரும் வார்த்தைகள் தயவுள்ளவைகள்;","poem":1},{"text":"மூடனோ தன் உதடுகளாலேயே அழிக்கப்படுகிறான்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவனுடைய வார்த்தைகள் ஆரம்பத்தில் மூடத்தனமானவை;","poem":1},{"text":"முடிவிலோ கொடிய பைத்தியக்காரத்தனமானவை.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"மூடன் வார்த்தைகளை அதிகமாக்குகிறான்.","poem":2},{"lineBreak":true},{"text":"ஒரு மனிதனும் வரப்போவதை அறியான்.","poem":1},{"text":"அவனுக்குப்பின் என்ன நடக்கும் என்பதை யாரால் அவனுக்குச் சொல்லமுடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"மூடனின் வேலை அவனையே களைப்படையச் செய்யும்;","poem":1},{"text":"ஏனெனில், பட்டணத்திற்குப் போகும் வழி அவனுக்குத் தெரியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"அடிமையை","poem":1},{"noteId":4},{"text":"அரசனாகவும்","poem":1},{"text":"விடியற்காலமே விருந்து உண்கிறவர்களை பிரபுக்களாகவும் கொண்ட நாடே, உனக்கு ஐயோ!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"உயர்குடியில் பிறந்தவனை அரசனாகக் கொண்ட நாடே, நீ ஆசீர்வதிக்கப்படுவாய்.","poem":1},{"text":"குடிபோதைக்கு அல்லாமல் தங்கள் பெலத்திற்காக","poem":2},{"lineBreak":true},{"text":"உரிய நேரத்தில் சாப்பிடுகிற இளவரசர்களைக் கொண்ட நாடே, நீ ஆசீர்வதிக்கப்படுவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"சோம்பேறியினுடைய வீட்டுக்கூரை வளைந்து தொங்கும்;","poem":1},{"text":"செயலற்ற கைகளினால் அவனுடைய வீடு ஒழுகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"மகிழ்ச்சிக்காகவே விருந்து செய்யப்படுகிறது,","poem":1},{"text":"திராட்சை இரசம் வாழ்க்கையை களிப்புள்ளதாக்குகிறது,","poem":2},{"lineBreak":true},{"text":"ஆனால் எல்லாவற்றிற்கும் தேவையானது பணமே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"உனது சிந்தனையிலும் அரசனை நிந்திக்காதே,","poem":1},{"text":"உனது படுக்கை அறையிலும் பணக்காரனை சபிக்காதே,","poem":2},{"text":"ஏனெனில் ஆகாயத்துப் பறவை உன் வார்த்தைகளைக் கொண்டு செல்லலாம்,","poem":1},{"text":"சிறகடிக்கும் பறவை நீ சொல்வதைப் போய்ச் சொல்லலாம்.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"அடிமையை அல்லது சிறுபிள்ளை","reference":{"chapter":10,"verse":16}}]},"thisChapterLink":"/api/tam_tcv/ECC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ECC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ECC/9.json","previousChapterAudioLinks":{},"numberOfVerses":20}