{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ECC","translationId":"tam_tcv","name":"பிரசங்கி","commonName":"பிரசங்கி","title":"பிரசங்கி","order":21,"numberOfChapters":12,"sha256":"a164b9e0cfcc0d897a202be39ba683cf423e43069ddf4b7137961fb40abb6132","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tam_tcv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":11,"content":[{"type":"heading","content":["பல முயற்சிகளில் முதலீடு செய்யுங்கள்"]},{"type":"verse","number":1,"content":[{"text":"கடல் வாணிபத்தில் முதலீடு செய்;","poem":1},{"text":"பல நாட்களுக்குப் பிறகு நீ இலாபத்தைத் திரும்பப் பெறுவாய்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உன்னிடம் இருப்பதை ஏழு பேருடனும், எட்டுப் பேருடனும் பங்கிட்டுக்கொள்.","poem":1},{"text":"பூமியின்மேல் என்ன பேராபத்து வரும் என்பதை நீ அறியாதிருக்கிறாயே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"மேகங்களில் தண்ணீர் நிறைந்திருந்தால்,","poem":1},{"text":"அவை பூமியின்மேல் மழையைப் பொழியும்.","poem":2},{"text":"ஒரு மரம் வடக்குப் பக்கம் விழுந்தாலும்,","poem":1},{"text":"தெற்குப் பக்கம் விழுந்தாலும் அது விழுந்த இடத்திலேயே கிடக்கும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"காற்றைப் பார்த்துக் கொண்டிருப்பவன் விதைக்கமாட்டான்;","poem":1},{"text":"மழைமேகங்களை நோக்கிப் பார்த்திருக்கிறவன் அறுவடை செய்யமாட்டான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"காற்றின் வழியையோ,","poem":1},{"text":"தாயின் கருப்பையில் குழந்தை உருவாகும் விதத்தையும் உன்னால் அறிய முடியாது.","poem":2},{"text":"அதுபோலவே எல்லாவற்றையும் படைக்கும்","poem":1},{"text":"இறைவனின் செயல்களையும் விளங்கிக்கொள்ள உன்னால் முடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"உனது தானியத்தைக் காலையில் விதை,","poem":1},{"text":"பிற்பகல் முழுவதும் உனது கைகளை நெகிழவிடாமல் விதை.","poem":2},{"text":"இதுவோ, அதுவோ,","poem":1},{"text":"எது பலன் தரும் என்பது உனக்குத் தெரியாதே;","poem":2},{"lineBreak":true},{"text":"ஒருவேளை இரண்டுமே நல்ல பலனைக் கொடுக்கலாம்.","poem":2}]},{"type":"heading","content":["உன் இளமையில் படைத்தவரை நினைவில்கொள்"]},{"type":"verse","number":7,"content":[{"text":"வெளிச்சம் இன்பமானது,","poem":1},{"text":"சூரியனைக் காண்பது கண்களுக்கு மகிழ்ச்சியைக் கொடுக்கும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஒருவன் எத்தனை வருடங்கள் வாழ்ந்தாலும்,","poem":1},{"text":"அவன் அவற்றை மகிழ்ச்சியுடன் களிக்கட்டும்.","poem":2},{"text":"ஆனால் இருளின் நாட்களையும் நினைவில் கொள்ளட்டும்,","poem":1},{"text":"ஏனெனில் அவை அநேகமாயிருக்கும்.","poem":2},{"lineBreak":true},{"text":"வரப்போகும் யாவும் அர்த்தமற்றதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"வாலிபனே, உன் இளமைக் காலத்தில் மகிழ்ச்சியாயிரு,","poem":1},{"text":"உன் வாலிப நாட்களில் உன் இருதயம் உனக்கு சந்தோஷத்தைக் கொடுக்கட்டும்.","poem":2},{"text":"உன் இருதயத்தின் வழிகளையும்,","poem":1},{"text":"உன் கண்கள் காண்பவற்றையும் பின்பற்று.","poem":2},{"text":"ஆனால் இவை எல்லாவற்றிற்காகவும்","poem":1},{"text":"இறைவன் உன்னை நியாயத்தீர்ப்புக்குக் கொண்டுவருவார் என்பதை அறிந்துகொள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எனவே உனது இருதயத்திலிருந்து கவலைகளை அகற்று,","poem":1},{"text":"உனது உடலின் வேதனையை உன்னைவிட்டு அகற்று.","poem":2},{"lineBreak":true},{"text":"ஏனெனில் இளவயதும் வாலிபமும் அர்த்தமற்றதே.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}