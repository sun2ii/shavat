{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ECC","translationId":"tam_tcv","name":"பிரசங்கி","commonName":"பிரசங்கி","title":"பிரசங்கி","order":21,"numberOfChapters":12,"sha256":"a164b9e0cfcc0d897a202be39ba683cf423e43069ddf4b7137961fb40abb6132","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tam_tcv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"நீ உன் வாலிப காலத்தில்","poem":1},{"text":"உன்னைப் படைத்தவரை நினைவில்கொள்;","poem":2},{"text":"துன்ப நாட்கள் வராததற்குமுன்னும்,","poem":1},{"text":"“வாழ்க்கையில் எனக்கு இன்பம் இல்லை”","poem":2},{"lineBreak":true},{"text":"என்று நீ சொல்லும் வருடங்கள் வரும்முன்னும் அவரை நினைவிற்கொள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அதாவது சூரியனும், வெளிச்சமும்,","poem":1},{"text":"சந்திரனும், நட்சத்திரங்களும் உங்கள் கண்களுக்கு மங்கலாய்த் தோன்றுமுன்னும்,","poem":2},{"lineBreak":true},{"text":"மழைக்குப்பின் மேகங்கள் திரும்பவும் தோன்றுமுன்னும் அவரை நினைவிற்கொள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"வீட்டுக் காவலாளிகள்","poem":1},{"noteId":5},{"text":"தங்கள் முதுமையில் தள்ளாட,","poem":1},{"text":"பெலமுள்ளவர் கூனிப்போய்","poem":2},{"noteId":6},{"text":",","poem":2},{"text":"அரைக்கும் பெண்கள்","poem":1},{"noteId":7},{"text":"வெகுசிலராகி,","poem":1},{"text":"ஜன்னல் வழியாகப் பார்ப்பவர்கள்","poem":2},{"noteId":8},{"text":"ஒளி இழக்குமுன்னும் அவரை நினைவிற்கொள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"வீதிக்குப் போகும் கதவுகள் அடைக்கப்பட்டு","poem":1},{"text":"அரைக்கும் சத்தம் குறைந்துபோக,","poem":2},{"text":"பறவைகளின் சத்தத்திற்கும் உறக்கம் கலைக்க,","poem":1},{"text":"இசைக்கும் மகளிரின் சத்தம் தொய்ந்து போகுமுன்னும் உன்னைப் படைத்தவரை நினை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"மேடான இடங்களுக்கும்,","poem":1},{"text":"வீதியிலுள்ள ஆபத்திற்கும் பயப்படும் முன்னும்,","poem":2},{"text":"வாதுமை மரம் பூக்கும்","poem":1},{"noteId":9},{"text":"முன்னும்,","poem":1},{"text":"வெட்டுக்கிளியைப் போல நடை தளர்ந்து போகுமுன்னும்,","poem":2},{"lineBreak":true},{"text":"ஆசையும் அற்றுப்போகுமுன்னும்,","poem":2},{"text":"மனிதன் தன் நித்திய வீட்டிற்குப் போகிறதினாலே","poem":1},{"text":"துக்கங்கொண்டாடுகிறவர்கள் வீதியில் கடந்து செல்வதற்கு முன்னும்","poem":2},{"lineBreak":true},{"text":"படைத்தவரை நினைவில்கொள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"வெள்ளிக் கயிறு அறுந்து,","poem":1},{"text":"தங்கக் கிண்ணம் உடைவதற்கு முன்னும்,","poem":2},{"text":"ஊற்றின் அருகே குடம் நொறுங்க,","poem":1},{"text":"கிணற்றில் உள்ள கயிற்றுச் சக்கரம் உடைந்து போகுமுன்னும்,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"மண்ணிலிருந்து வந்த உடல் மண்ணுக்குத் திரும்பி,","poem":1},{"text":"ஆவி அதைக் கொடுத்தவரான இறைவனிடம் திரும்பும் முன்","poem":2},{"lineBreak":true},{"text":"உன்னைப் படைத்தவரை நினைவிற்கொள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“அர்த்தமற்றவை! அர்த்தமற்றவை!","poem":1},{"text":"எல்லாமே அர்த்தமற்றவை!” என்று பிரசங்கி சொல்கிறான்.","poem":2}]},{"type":"heading","content":["பொருளின் முடிவு"]},{"type":"verse","number":9,"content":["பிரசங்கி ஞானமுள்ளவனாய் இருந்தது மட்டுமல்ல, அவன் மக்களுக்கு அறிவையும் புகட்டினான். இதனாலேயே அவன் ஆழ்ந்து யோசித்துப் பார்த்து, அநேக நீதிமொழிகளை தொகுத்து எழுதிவைத்தான்."]},{"type":"verse","number":10,"content":["பிரசங்கி சரியான சொற்களையே கண்டுபிடிக்கத் தேடினான். அதினால் அவன் எழுதியவையெல்லாம் நேர்மையும் உண்மையுமானவை."]},{"type":"verse","number":11,"content":["ஞானமுள்ளவர்களின் வார்த்தைகள் நல்வழிக்கு உந்தித் தள்ளும் தாற்றுக்கோல் போன்றது. தொகுக்கப்பட்ட அவர்களின் முதுமொழிகள் உறுதியாய் அடிக்கப்பட்ட ஆணிகளைப் போன்றவை. அவை ஒரே மேய்ப்பனாலேயே கொடுக்கப்பட்டன."]},{"type":"verse","number":12,"content":["என் மகனே, இவைகளினாலே எச்சரிப்பாயிருப்பாயாக. புத்தகங்களை எழுதுவது முடிவற்றது, மேலும் அதிக படிப்பு உடலை இளைக்கப்பண்ணும்."]},{"type":"verse","number":13,"content":[{"text":"எல்லாவற்றையும் கேட்டு,","poem":1},{"text":"நான் இந்த முடிவுக்கு வந்துவிட்டேன்:","poem":2},{"text":"இறைவனுக்குப் பயந்து நட, அவர் கட்டளைகளைக் கைக்கொள்;","poem":1},{"text":"மனிதனின் பிரதான கடமை இதுவே.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஏனெனில் நாம் செய்யும் எல்லா செயல்களுக்கும்,","poem":1},{"text":"அந்தரங்கமான செயல்களுக்கும்,","poem":2},{"lineBreak":true},{"text":"நல்லதோ, தீயதோ இறைவனே நியாயத்தீர்ப்பு வழங்குவார்.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"கால்கள்","reference":{"chapter":12,"verse":3}},{"noteId":6,"caller":"+","text":"தோள்பட்டை","reference":{"chapter":12,"verse":3}},{"noteId":7,"caller":"+","text":"பற்கள்","reference":{"chapter":12,"verse":3}},{"noteId":8,"caller":"+","text":"கண்கள்","reference":{"chapter":12,"verse":3}},{"noteId":9,"caller":"+","text":"தலைமுடி","reference":{"chapter":12,"verse":5}}]},"thisChapterLink":"/api/tam_tcv/ECC/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/SNG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ECC/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}