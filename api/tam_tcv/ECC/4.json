{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ECC","translationId":"tam_tcv","name":"பிரசங்கி","commonName":"பிரசங்கி","title":"பிரசங்கி","order":21,"numberOfChapters":12,"sha256":"a164b9e0cfcc0d897a202be39ba683cf423e43069ddf4b7137961fb40abb6132","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tam_tcv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":4,"content":[{"type":"heading","content":["ஒடுக்குதலும் நட்பின்மையும்"]},{"type":"verse","number":1,"content":["மீண்டும் நான் பார்த்தபோது:",{"text":"சூரியனுக்குக் கீழே அநேக ஒடுக்குதல்களைக் கண்டேன்.","poem":1},{"text":"ஒடுக்கப்படுகிறவர்களின் கண்ணீரையும்,","poem":2},{"text":"அவர்களை ஆறுதல்படுத்த யாரும் இல்லாதிருப்பதையும் கண்டேன்;","poem":1},{"text":"அவர்களை ஒடுக்குவோரின் பக்கத்திலேயே வல்லமை இருந்தது,","poem":2},{"lineBreak":true},{"text":"அவர்களை ஆறுதல்படுத்த யாருமே இல்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஆதலால் இன்னும் உயிரோடிருந்து","poem":1},{"text":"வாழ்கிறவர்களைப் பார்க்கிலும்,","poem":2},{"text":"ஏற்கெனவே செத்து மடிந்துபோனவர்களே","poem":1},{"text":"மகிழ்ச்சிக்குரியவர்கள் என்று அறிவித்தேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இவ்விரு கூட்டத்தினரைவிட,","poem":1},{"text":"இன்னமும் பிறவாதவர்களே மேலானவர்கள்.","poem":2},{"text":"அவர்கள் சூரியனுக்குக் கீழே","poem":1},{"text":"செய்யப்படும் தீமையைக் காணவில்லையே.","poem":2}]},{"type":"verse","number":4,"content":["தனது அயலவனைக் குறித்து மனிதன் கொண்டிருக்கும் பொறாமையிலிருந்தே, எல்லா உழைப்பும் திறமையும் ஏற்படுகிறது என்று நான் கண்டுகொண்டேன். இதுவும் அர்த்தமற்றதே; காற்றைத் துரத்திப்பிடிக்கும் முயற்சியே."]},{"type":"verse","number":5,"content":[{"text":"மூடன் தன் கைகளைக் கட்டிக்கொண்டு","poem":1},{"text":"தன்னையே அழித்துக்கொள்கிறான்","poem":2},{"noteId":2},{"text":".","poem":2}]},{"type":"verse","number":6,"content":[{"text":"காற்றைத் துரத்திப்பிடிப்பது போன்ற பயனற்ற உழைப்பினால்,","poem":1},{"text":"இரு கைகளையும் நிரப்புவதைவிட,","poem":2},{"lineBreak":true},{"text":"மன அமைதியுடன் ஒரு கையை நிரப்பிக்கொள்வது மேலானது.","poem":2}]},{"type":"verse","number":7,"content":["சூரியனுக்குக் கீழே இன்னும் அர்த்தமற்ற ஒன்றை நான் கண்டேன்:"]},{"type":"verse","number":8,"content":[{"text":"தனிமையாய் இருக்கும் ஒரு மனிதன் இருந்தான்.","poem":1},{"text":"அவனுக்கு மகனோ, சகோதரனோ இல்லை.","poem":2},{"text":"அப்படியிருந்தும் அவனுடைய கடும் உழைப்பிற்கோ முடிவே இருக்கவில்லை.","poem":1},{"text":"ஆனாலும் அவன் கண்கள் அவனுடைய செல்வத்தில் திருப்தியடையவுமில்லை.","poem":2},{"text":"அவன், “நான் யாருக்காக கஷ்டப்பட்டு உழைக்கிறேன்;","poem":1},{"text":"ஏன் நான் என் வாழ்வை சந்தோஷமாய் அனுபவியாதிருக்கிறேன்” என்று கேட்டான்.","poem":2},{"text":"இதுவும் அர்த்தமற்றதும்,","poem":1},{"text":"அவலத்துக்குரிய ஒரு நிலையாயும் இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"தனியொருவனாய் இருப்பதைப் பார்க்கிலும், இருவராய் இருப்பது நல்லது.","poem":1},{"text":"ஏனெனில் அவர்கள் தங்கள் வேலையிலிருந்து நல்ல பயனைப் பெறுவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஒருவன் விழுந்தால்,","poem":1},{"text":"அவன் நண்பன் அவன் எழும்ப உதவிசெய்ய முடியும்.","poem":2},{"text":"ஆனால் கீழே விழும்போது எழுந்திருக்க உதவிசெய்ய யாரும் இல்லாத மனிதனோ,","poem":1},{"text":"பரிதாபத்திற்குரியவன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அத்துடன் இருவர் ஒன்றாய்ப் படுத்திருந்தால்,","poem":1},{"text":"தங்களை சூடாக வைத்துக்கொள்வார்கள்.","poem":2},{"lineBreak":true},{"text":"ஆனால் ஒருவன் தனிமையாய் தன்னை எப்படிச் சூடாக வைத்துக்கொள்ள முடியும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஒரு தனி மனிதன் இலகுவில் வீழ்த்தப்படலாம்;","poem":1},{"text":"ஆனால் இருவராய் இருந்தால் அவர்கள் தங்களைக் காத்துக்கொள்வார்கள்.","poem":2},{"text":"முப்புரிக்கயிறு விரைவில் அறாது.","poem":1}]},{"type":"heading","content":["உயர்வும் அர்த்தமற்றது"]},{"type":"verse","number":13,"content":["எச்சரிப்பை ஏற்றுக்கொள்ளத் தெரியாத முதியவனும் மூடனுமான அரசனைவிட, ஞானமுள்ள ஏழை வாலிபனே சிறந்தவன்."]},{"type":"verse","number":14,"content":["அந்த வாலிபன் சிறையில் இருந்து அரச பதவிக்கு உயர்ந்திருக்கலாம். அல்லது தனது ஆட்சிக்குரிய பிரதேசத்தில் ஏழ்மையில் பிறந்திருக்கலாம்."]},{"type":"verse","number":15,"content":["சூரியனுக்குக் கீழே வாழ்ந்து நடந்த யாவரும் அரசனுக்குப்பின், அவனுடைய இடத்தில் வந்த வாலிபனையே பின்பற்றுவதைக் கண்டேன்."]},{"type":"verse","number":16,"content":["அப்படி அவனைப் பின்பற்றுகிற மக்களுக்கு முடிவே இல்லை. ஆனால் அதற்குப் பிறகு வந்த சந்ததியோ புதிதாக ஆட்சிக்கு வந்தவனில் பிரியப்படவில்லை. இதுவும் அர்த்தமற்றதே, காற்றைத் துரத்திப்பிடிக்கும் முயற்சியே."]}],"footnotes":[{"noteId":2,"caller":"+","text":"தன்னையே அழித்துக்கொள்கிறான் அல்லது தன் சதையையே தின்கிறான்.","reference":{"chapter":4,"verse":5}}]},"thisChapterLink":"/api/tam_tcv/ECC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ECC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ECC/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}