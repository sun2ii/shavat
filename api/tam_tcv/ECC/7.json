{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ECC","translationId":"tam_tcv","name":"பிரசங்கி","commonName":"பிரசங்கி","title":"பிரசங்கி","order":21,"numberOfChapters":12,"sha256":"a164b9e0cfcc0d897a202be39ba683cf423e43069ddf4b7137961fb40abb6132","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tam_tcv/ECC/12.json","totalNumberOfVerses":222},"chapter":{"number":7,"content":[{"type":"heading","content":["ஞானம்"]},{"type":"verse","number":1,"content":[{"text":"சிறந்த வாசனைத் தைலத்தைவிட நற்பெயரே நல்லது,","poem":1},{"text":"பிறக்கும் நாளைவிட இறக்கும் நாளே சிறந்தது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"விருந்து வீட்டிற்குப் போவதைப் பார்க்கிலும்,","poem":1},{"text":"துக்க வீட்டிற்குப் போவதே சிறந்தது.","poem":2},{"text":"ஏனெனில் ஒவ்வொரு மனிதனின் நியதியும் மரணமே;","poem":1},{"text":"உயிரோடிருக்கிறவர்கள் இதைக் மனதிற்கொள்ளவேண்டும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"சிரிப்பைப் பார்க்கிலும் துக்கமே நல்லது;","poem":1},{"text":"ஏனெனில் துக்கமுகம் இருதயத்திற்கு நன்மையைக் கொடுக்கும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஞானமுள்ளவர்களின் இருதயம் துக்க வீட்டிலேயே இருக்கிறது;","poem":1},{"text":"ஆனால் மூடர்களின் இருதயமோ களிப்பு வீட்டிலேயே இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"மூடர்களின் பாடலைக் கேட்பதைப் பார்க்கிலும்,","poem":1},{"text":"ஞானமுள்ளவர்களின் கடிந்துகொள்ளுதலைக் கேட்பது நல்லது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"பானைக்குக்கீழ் சடசட என எரியும் முட்களின் சத்தத்தைப்போலவே,","poem":1},{"text":"மூடர்களின் சிரிப்பும் இருக்கும்.","poem":2},{"lineBreak":true},{"text":"இதுவும் அர்த்தமற்றதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"பலவந்தமாய் எடுத்த ஆதாயம், ஒரு ஞானியையும் மூடனாக்கும்.","poem":1},{"text":"இலஞ்சம் வாங்குதல் இருதயத்தைக் கறைப்படுத்தும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஒரு காரியத்தின் தொடக்கத்தைப் பார்க்கிலும், அதின் முடிவு நல்லது;","poem":1},{"text":"பெருமையைப் பார்க்கிலும் பொறுமையே சிறந்தது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"உள்ளத்தில் கோபத்திற்கு இடங்கொடாதே,","poem":1},{"text":"ஏனெனில் கோபம் மூடர்களின் மடியிலே குடியிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“இந்த நாட்களைவிட முந்திய நாட்கள் நலமாய் இருந்தது ஏன்?” என்று கேட்காதே.","poem":1},{"text":"இப்படியான கேள்விகளைக் கேட்பது ஞானமுள்ள செயல் அல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"உரிமைச்சொத்தைப்போல, ஞானம் இருப்பது நல்லது;","poem":1},{"text":"உயிரோடிருக்கும் அனைவருக்கும் அதுவே நன்மை கொடுக்கிறது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பணம் புகலிடமாய் இருப்பதுபோலவே,","poem":1},{"text":"ஞானமும் ஒரு புகலிடம்;","poem":2},{"text":"ஆனால் ஞானம் அதைக் கொண்டிருக்கிறவர்களின் உயிரைப் பாதுகாக்கிறது,","poem":1},{"text":"இதுவே அறிவின் மேன்மை.","poem":2}]},{"type":"verse","number":13,"content":["இறைவன் செய்திருப்பதைக் கவனித்துப் பாருங்கள்:",{"text":"அவர் கோணலாக்கினதை","poem":1},{"text":"யாரால் நேராக்க முடியும்?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"காலங்கள் நலமாயிருக்கும்போது, மகிழ்ச்சியாயிரு;","poem":1},{"text":"காலங்கள் கஷ்டமாய் இருக்கும்போது, சிந்தனை செய்:","poem":2},{"text":"இறைவனே இரண்டையும் ஏற்படுத்தியிருக்கிறார்,","poem":1},{"text":"ஆகையால் ஒரு மனிதனால்","poem":2},{"text":"தனது எதிர்காலத்தைக் குறித்து","poem":1},{"text":"எதையும் கண்டுபிடிக்க முடியாது.","poem":2}]},{"type":"verse","number":15,"content":["நீதியானவன் தன் நீதியில் அழிந்துபோகிறதும்:",{"text":"கொடுமையானவன் தன் கொடுமையிலே நீடித்து வாழ்கிறதுமான","poem":1},{"text":"இரண்டையும் அர்த்தமற்ற என் வாழ்வில் நான் கண்டேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆகையால் மிதமிஞ்சி நீதிமானாகவோ,","poem":1},{"text":"மிதமிஞ்சிய ஞானமுள்ளவனாகவோ காட்டிக்கொள்ளாதே.","poem":2},{"lineBreak":true},{"text":"அதினால் நீ ஏன் உன்னை அழித்துக்கொள்ள வேண்டும்?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அதிக கொடியவனாய் இராதே,","poem":1},{"text":"முட்டாளாயும் இராதே.","poem":2},{"lineBreak":true},{"text":"உன் காலத்திற்கு முன் நீ ஏன் சாகவேண்டும்?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"முதலாவதைப் பற்றிக்கொள்வதும்,","poem":1},{"text":"இரண்டாவதைக் கைவிடாதிருப்பதும் நல்லது.","poem":2},{"lineBreak":true},{"text":"இறைவனுக்குப் பயந்து நடக்கிறவனோ மிதமிஞ்சிய நடத்தைகளைக் கைக்கொள்ளமாட்டான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"பட்டணத்திலுள்ள பத்து ஆளுநர்களைப் பார்க்கிலும்,","poem":1},{"text":"ஒரு ஞானியை, ஞானம் அதிக வலிமையுள்ளவனாக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஒருபோதும் பாவம் செய்யாமல், சரியானதையே செய்கிற,","poem":1},{"text":"நீதியான மனிதன் பூமியில் ஒருவனும் இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"மனிதர் சொல்லும் ஒவ்வொரு வார்த்தையையும் கவனத்தில் எடுக்காதே;","poem":1},{"text":"கவனிப்பாயானால் உன் வேலைக்காரன் உன்னைச் சபிப்பதையும் நீ கேட்க நேரிடலாம்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஏனெனில் பலமுறை,","poem":1},{"text":"நீயும் மற்றவர்களைச் சபிக்கிறதை உன் இருதயத்தில் அறிவாயே.","poem":2}]},{"type":"verse","number":23,"content":["இவை எல்லாவற்றையும் நான் என் ஞானத்தினால் சோதித்துப் பார்த்து,",{"text":"“நான் ஞானமுள்ளவனாய் இருக்க உறுதிகொண்டேன்” என்று சொன்னேன்;","poem":1},{"text":"ஆனால் இதுவும் எனக்கு எட்டாததாய் இருந்தது.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஞானம் எப்படிப்பட்டதாய் இருந்தாலும்,","poem":1},{"text":"அது மிக தூரமாகவும் ஆழமாகவும் இருக்கிறது.","poem":2},{"lineBreak":true},{"text":"அதை யாரால் கண்டறிய முடியும்?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஆகவே, ஞானத்தையும் நிகழ்வுகளுக்கான காரணகாரியத்தையும் அறியவும்,","poem":1},{"text":"விசாரிக்கவும், ஆராயவும் என் மனதைச் செலுத்தினேன்.","poem":2},{"text":"கொடுமையின் மூடத்தனத்தையும்,","poem":1},{"text":"மூடத்தனத்தின் அறிவீனத்தையும் விளங்கிக்கொள்ள என் மனதைத் திருப்பினேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"கண்ணியாய் இருக்கும் பெண்,","poem":1},{"text":"மரணத்திலும் பார்க்க கசப்பானவள் என்று நான் கண்டேன்;","poem":2},{"text":"அவளது இருதயம் பொறியாயும்,","poem":1},{"text":"அவளது கைகள் சங்கிலிகளாயும் இருக்கின்றன.","poem":2},{"text":"இறைவனுக்குப் பிரியமாய் நடக்கும் மனிதனோ அவளிடமிருந்து தப்புவான்.","poem":1},{"text":"பாவியையோ அவள் சிக்க வைப்பாள்.","poem":2}]},{"type":"verse","number":27,"content":["“இதோ, நிகழ்வுகளின் திட்டங்களை விளங்கிக்கொள்வதற்காக ஒன்றுடன் ஒன்றைச்சேர்த்துப் பார்த்தேன்”:",{"text":"அப்பொழுது நான் கண்டது இதுவே என்று பிரசங்கி சொல்கிறான்:","poem":1}]},{"type":"verse","number":28,"content":[{"text":"“நான் ஆயிரம் பேருக்குள்ளே நேர்மையான ஒருவனை கண்டேன்;","poem":2},{"lineBreak":true},{"text":"ஆனால் ஆயிரம் பெண்களுக்குள்ளே நேர்மையான ஒரு பெண்ணை நான் காணவில்லை.","poem":2},{"text":"நான் இன்னும் ஆராய்ந்து கொண்டேயிருக்கிறேன்;","poem":1},{"text":"ஆனால் விளங்கவில்லை.”","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ஆனால் இது ஒன்றையே நான் கண்டுபிடித்தேன்:","poem":1},{"text":"இறைவன் மனுக்குலத்தை நீதியானதாகவே படைத்தார்;","poem":2},{"lineBreak":true},{"text":"மனிதர்களோ தங்கள் மனம்போன போக்கில் நடந்துகொள்கிறார்கள்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ECC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ECC/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ECC/6.json","previousChapterAudioLinks":{},"numberOfVerses":29}