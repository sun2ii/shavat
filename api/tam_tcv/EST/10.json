{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"EST","translationId":"tam_tcv","name":"எஸ்தர்","commonName":"எஸ்தர்","title":"எஸ்தரின் சரித்திரம்","order":17,"numberOfChapters":10,"sha256":"e7817cc2a07190bd7cc2d9d17130af73d954259fa740c027c166e5f794304634","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/EST/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/tam_tcv/EST/10.json","totalNumberOfVerses":167},"chapter":{"number":10,"content":[{"type":"heading","content":["மொர்தெகாயின் மேன்மை"]},{"type":"verse","number":1,"content":["அகாஸ்வேரு அரசன் அவனுடைய பேரரசு எங்கும், அதன் தூரமான எல்லைகள் வரைக்கும் வரி விதித்தான்."]},{"type":"verse","number":2,"content":["மொர்தெகாயின் அதிகாரமும் வல்லமையுள்ள எல்லாச் செயல்களும், அரசன் அவனை மேன்மைப்படுத்தி அவனுக்குக் கொடுத்த அவனுடைய மேன்மையின் முழு விபரமும் பெர்சிய, மேதிய அரசர்களின் வரலாற்றுப் புத்தகத்திலல்லவோ எழுதப்பட்டிருக்கின்றன."]},{"type":"verse","number":3,"content":["யூதனான மொர்தெகாய் மேன்மையில் அரசனுக்கு அடுத்ததாய் இருந்தான். அவன் தனது மக்களின் நலனுக்காக உழைத்ததினாலும், எல்லா யூதர்களுடைய முன்னேற்றத்துக்காகப் பேசியதினாலும் அவன் யூதர்கள் மத்தியிலும் முதன்மை பெற்றவனாயிருந்தான். அவன் தன் சகோதரரான மற்ற யூதர்களினால் உயர்வாய் மதிக்கப்பட்டவனுமாயிருந்தான்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/EST/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":