{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"EXO","translationId":"tam_tcv","name":"யாத்திராகமம்","commonName":"யாத்திராகமம்","title":"யாத்திராகமம்","order":2,"numberOfChapters":40,"sha256":"dfc83652a8a7c41d8b7d899e0fee9294b399a123411928aab3ed28cddc8f5a6f","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/EXO/1.json","lastChapterNumber":40,"lastChapterApiLink":"/api/tam_tcv/EXO/40.json","totalNumberOfVerses":1213},"chapter":{"number":15,"content":[{"type":"heading","content":["மோசே மற்றும் மிரியாமின் பாடல்"]},{"type":"verse","number":1,"content":["அப்பொழுது மோசேயும் இஸ்ரயேலரும் யெகோவாவுக்குப் பாடிய பாடலாவது:",{"text":"“நான் யெகோவாவைப் பாடுவேன்,","poem":1},{"text":"அவர் மிகவும் புகழ்ந்து உயர்த்தப்பட்டிருக்கிறார்.","poem":2},{"text":"குதிரையையும், அதை ஓட்டியவனையும்","poem":1},{"text":"அவர் கடலுக்குள் வீசியெறிந்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“யெகோவா என் பெலனும், என் பாடலுமாயிருக்கிறார்,","poem":1},{"text":"அவரே என் இரட்சிப்புமானார்.","poem":2},{"text":"அவர் என் இறைவன், அவரைத் துதிப்பேன்.","poem":1},{"text":"அவர் என் தந்தையின் இறைவன், அவரை நான் உயர்த்துவேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யெகோவா யுத்தத்தில் வீரர்;","poem":1},{"text":"யெகோவா என்பதே அவரது பெயர்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் பார்வோனின் தேர்களையும், அவனுடைய இராணுவத்தையும்","poem":1},{"text":"கடலுக்குள் தள்ளிவிட்டார்.","poem":2},{"text":"பார்வோனின் அதிகாரிகளில் சிறந்தவர்கள்","poem":1},{"text":"செங்கடலில் அழிந்தார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆழமான தண்ணீர் அவர்களை மூடியது;","poem":1},{"text":"ஒரு கல்லைப்போல் ஆழத்திலே அவர்கள் அமிழ்ந்தார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவே, உமது வலதுகரம்","poem":1},{"text":"வல்லமையில் மாட்சிமையாய் இருந்தது.","poem":2},{"text":"யெகோவாவே, உமது வலதுகரமே","poem":1},{"text":"எதிரியை நொறுக்கியது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“உமது மாட்சிமையின் மகத்துவத்தினால்","poem":1},{"text":"உம்மை எதிர்த்தவர்களை கீழே விழத்தள்ளினீர்.","poem":2},{"text":"உமது எரியும் கோபத்தைக் கட்டவிழ்த்தீர்;","poem":1},{"text":"அது அவர்களை வைக்கோலைப்போல் எரித்தது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"உமது நாசியின் சுவாசத்தினால்","poem":1},{"text":"தண்ணீர் குவிந்தது.","poem":2},{"text":"பொங்கியெழும் வெள்ளங்கள் மதிலைப்போல உறுதியாய் நின்றன;","poem":1},{"text":"ஆழத்தின் தண்ணீர் கடலின் அடியில் உறைந்துபோயிற்று.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"பகைவன் பெருமையாக,","poem":1},{"text":"‘நான் பின்தொடர்வேன், அவர்களைப் பிடிப்பேன்.","poem":2},{"text":"நான் கொள்ளையைப் பங்கிடுவேன்;","poem":1},{"text":"அவர்களில் என் ஆசையைத் தீர்த்துக்கொள்வேன்.","poem":2},{"text":"என் வாளை உருவுவேன்,","poem":1},{"text":"என் கை அவர்களை அழிக்கும்’ என பேசினான்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆனால், நீரோ உமது சுவாசத்தை ஊதினீர்,","poem":1},{"text":"கடல் அவர்களை மூடியது.","poem":2},{"text":"அவர்கள் ஈயத்தைப் போல்","poem":1},{"text":"பெரும் தண்ணீர்களுக்குள் அமிழ்ந்தார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவாவே, தெய்வங்களுக்குள்","poem":1},{"text":"உம்மைப்போல் யார் உண்டு?","poem":2},{"text":"பரிசுத்தத்தில் மாட்சிமையும்,","poem":1},{"text":"மகிமையில் வியக்கத்தக்கவரும்,","poem":2},{"text":"அதிசயங்களையும் செய்கிற","poem":1},{"text":"உம்மைப்போல் யார் உண்டு?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“உமது வலது கரத்தை நீட்டினீர்,","poem":1},{"text":"பூமி அவர்களை விழுங்கிற்று.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீர் மீட்டுக்கொண்ட மக்களை","poem":1},{"text":"உமது நேர்மையான அன்பினால் வழிநடத்துவீர்.","poem":2},{"text":"நீர் வசிக்கும் பரிசுத்த இடத்திற்கு,","poem":1},{"text":"உமது வல்லமையினால் அவர்களுக்கு வழிகாட்டுவீர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"மக்கள் அதைக்கேட்டு நடுங்குவார்கள்;","poem":1},{"text":"பெலிஸ்திய மக்களை வேதனை பற்றிக்கொள்ளும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஏதோமின் தலைவர்கள் திகிலடைவார்கள்,","poem":1},{"text":"மோவாபின் தலைவர்களை நடுக்கம் பிடிக்கும்,","poem":2},{"text":"கானானின் மக்களும் கரைந்து போவார்கள்;","poem":1}]},{"type":"verse","number":16,"content":[{"text":"பயமும் திகிலும் அவர்கள்மேல் வரும்.","poem":2},{"text":"யெகோவாவே, உமது மக்கள் கடந்துபோகும்வரை,","poem":1},{"text":"நீர் கொண்டுவந்த மக்கள் கடந்துபோகும்வரை,","poem":2},{"text":"உமது கரத்தின் வல்லமையால்","poem":1},{"text":"அவர்கள் கல்லைப்போல் அசைவில்லாமல் கிடப்பார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"யெகோவாவே, உமது உரிமைச்சொத்தான மலையில்","poem":1},{"text":"நீர் அவர்களைக் கொண்டுவந்து நிலைநாட்டுவீர்;","poem":2},{"text":"அந்த இடத்தையே நீர் உமது தங்குமிடமாக்கினீர்,","poem":1},{"text":"யெகோவாவே, உமது கைகளே அதைப் பரிசுத்த இடமாக ஏற்படுத்தியது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“யெகோவா என்றென்றைக்கும் அரசாளுவார்.”","poem":1}]},{"type":"verse","number":19,"content":["பார்வோனின் குதிரைகள் தேர்களோடும், குதிரைவீரர்களோடும் கடலுக்குள் சென்றன. அப்பொழுது யெகோவா கடல் தண்ணீரைத் திருப்பி அவர்கள்மேல் கொண்டுவந்தார்; ஆனால் இஸ்ரயேலரோ கடல் வழியாகக் காய்ந்த தரையில் நடந்துபோனார்கள்."]},{"type":"verse","number":20,"content":["அப்பொழுது இறைவாக்கினளான ஆரோனின் சகோதரி மிரியாம், தன் கையில் ஒரு தம்புராவை எடுத்துக்கொண்டாள்; மற்ற எல்லா பெண்களும் தம்புராவோடும் நடனத்தோடும் அவளைப் பின்தொடர்ந்தார்கள்."]},{"type":"verse","number":21,"content":["அப்பொழுது மிரியாம் அவர்களுக்குப் பதிலளித்துப் பாடியது:",{"text":"“யெகோவாவைப் பாடுங்கள்,","poem":1},{"text":"ஏனெனில் அவர் உன்னதத்தில் புகழ்ந்து உயர்த்தப்பட்டிருக்கிறார்.","poem":2},{"text":"குதிரையையும் அதை ஓட்டியவனையும்","poem":1},{"text":"கடலிலே வீசியெறிந்தார்.”","poem":2}]},{"type":"heading","content":["ஏலீம் மற்றும் மாராவின் கசப்பான தண்ணீர்"]},{"type":"verse","number":22,"content":["அதன்பின் மோசே இஸ்ரயேலரைச் செங்கடலிலிருந்து சூர் பாலைவனத்திற்கு நடத்திச் சென்றான். அவர்கள் மூன்று நாட்களாக பாலைவனத்தில் பயணம் செய்தார்கள், அவர்களுக்குத் தண்ணீர் கிடைக்கவில்லை."]},{"type":"verse","number":23,"content":["அவர்கள் மாரா என்னும் இடத்திற்கு வந்தபோது, அவ்விடத்திலுள்ள தண்ணீர் கசப்பாயிருந்தபடியால், அவர்களால் அதைக் குடிக்க முடியவில்லை. அதனால்தான் அந்த இடம் மாரா",{"noteId":12},"என அழைக்கப்பட்டது."]},{"type":"verse","number":24,"content":["எனவே இஸ்ரயேல் மக்கள், “நாங்கள் எதைக் குடிப்போம்?” என்று கேட்டு மோசேக்கு எதிராக முறுமுறுத்தார்கள்."]},{"type":"verse","number":25,"content":["மோசே யெகோவாவிடம் அழுது விண்ணப்பித்தான், அப்பொழுது யெகோவா மோசேக்கு ஒரு மரத்தைக் காட்டினார். அவன் அதைத் தண்ணீருக்குள் எறிந்தபோது, தண்ணீர் இனிமையாக மாறியது. பின்பு யெகோவா ஒரு விதிமுறையையும், ஒரு சட்டத்தையும் ஏற்படுத்தி, அங்கே அவர்களைச் சோதித்தார்."]},{"type":"verse","number":26,"content":["அவர், “நீங்கள் உங்கள் இறைவனாகிய யெகோவாவின் குரலுக்குக் கவனமாய்ச் செவிகொடுத்து, அவருடைய பார்வையில் சரியானதைச் செய்து, அவருடைய கட்டளைகளைக் கவனித்து, அவருடைய எல்லா விதிமுறைகளையும் கைக்கொண்டு நடப்பீர்களானால், நான் எகிப்தியர்மேல் கொண்டுவந்த வியாதிகளில் எதையும் உங்கள்மேல் கொண்டுவரமாட்டேன்; ஏனெனில் நானே உங்களைச் சுகமாக்குகிற யெகோவா” என்றார்."]},{"type":"verse","number":27,"content":["அதன்பின் அவர்கள் ஏலிமுக்கு வந்தார்கள், அங்கே பன்னிரண்டு நீரூற்றுக்களும் எழுபது பேரீச்சமரங்களும் இருந்தன; அவர்கள் அங்கே தண்ணீர் அருகே முகாமிட்டார்கள்."]}],"footnotes":[{"noteId":12,"caller":"+","text":"மாரா என்றால் கசப்பு என்று அர்த்தம்.","reference":{"chapter":15,"verse":23}}]},"thisChapterLink":"/api/tam_tcv/EXO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/EXO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/EXO/14.json","previousChapterAudioLinks":{},"numberOfVerses":27}