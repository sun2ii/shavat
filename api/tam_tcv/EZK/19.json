{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"EZK","translationId":"tam_tcv","name":"எசேக்கியேல்","commonName":"எசேக்கியேல்","title":"இறைவாக்கினன் எசேக்கியேலின் புத்தகம்","order":26,"numberOfChapters":48,"sha256":"f25851a21e0813ea1810ac50ed12a670fb7c281f9d2214acee10e076861da6f2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/tam_tcv/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":19,"content":[{"type":"heading","content":["இஸ்ரயேலரின் இளவரசர்களுக்கான புலம்பல்"]},{"type":"verse","number":1,"content":["“நீ இஸ்ரயேலரின் இளவரசர்களைக் குறித்துப் புலம்பு."]},{"type":"verse","number":2,"content":["நீ சொல்லவேண்டியதாவது:",{"text":"“ ‘சிங்கங்களுக்கு நடுவில் உன் தாய்","poem":1},{"text":"ஒரு பெண்சிங்கமாயிருந்தாள்.","poem":2},{"text":"அவள் இளஞ்சிங்கங்கள் மத்தியில்","poem":1},{"text":"படுத்திருந்து தன் குட்டிகளை வளர்த்தாள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"தன் குட்டிகளில் ஒன்றை அவள் வளர்த்தாள்.","poem":1},{"text":"அக்குட்டி ஒரு பலமுள்ள சிங்கம் ஆனான்.","poem":2},{"text":"அவன் இரையைக் கிழிக்கப்பழகி","poem":1},{"text":"மனிதர்களை விழுங்கினான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நாடுகள் அவனைப்பற்றிக் கேள்விப்பட்டபோது,","poem":1},{"text":"அவன் அவர்களுடைய குழியில் அகப்பட்டான்.","poem":2},{"text":"அவர்கள் அவனை விலங்கிட்டு","poem":1},{"text":"எகிப்திற்கு நடத்திச்சென்றார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ ‘தன் நம்பிக்கை நிறைவேறவில்லையென்றும்,","poem":1},{"text":"தன் எதிர்பார்ப்பு சிதைந்தது","poem":2},{"text":"என்றும் தாய்ச்சிங்கம் கண்டபோது,","poem":1},{"text":"தன் குட்டிகளில் வேறொன்றை எடுத்து பலமுள்ள சிங்கமாக்கியது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அது இப்பொழுது பாலசிங்கமானதால்,","poem":1},{"text":"சிங்கங்கள் மத்தியில் இரைதேடித் திரிந்தது.","poem":2},{"text":"அது இரையைக் கிழிக்கப்பழகி","poem":1},{"text":"மனிதரை விழுங்கியது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்களுடைய அரண்களை நொறுக்கி,","poem":1},{"text":"நகரங்களை அழித்தது.","poem":2},{"text":"நாடும் அதிலுள்ள அனைவரும்","poem":1},{"text":"அதனுடைய கர்ஜனையைக் கேட்டுக் கலங்கினார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அப்பொழுது எல்லாப் பக்கமும் சூழ்ந்திருக்கும் பிறநாடுகள்,","poem":1},{"text":"அதை எதிர்த்து வந்தன.","poem":2},{"text":"அதன்மேல் தங்கள் வலையை வீசியபோது,","poem":1},{"text":"அது அவர்களுடைய குழியில் அகப்பட்டது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்கள் அதனை விலங்கிட்டு கூண்டிலிட்டு,","poem":1},{"text":"பாபிலோன் அரசனிடம் கொண்டுசென்று","poem":2},{"text":"அங்கே சிறையிட்டார்கள்.","poem":1},{"text":"எனவே இஸ்ரயேலின் மலைகளில்","poem":2},{"lineBreak":true},{"text":"அதனுடைய கர்ஜனை அதற்குப்பின் கேட்கவேயில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘உன் தாய் உன் திராட்சைத் தோட்டத்தில்","poem":1},{"text":"தண்ணீரின் அருகே நாட்டப்பட்ட திராட்சைக்கொடியைப் போலிருந்தாள்!","poem":2},{"text":"தண்ணீர் வளம் மிகுந்த காரணத்தால்","poem":1},{"text":"கிளைகள் செழித்து பழங்களும் பெருகின.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அதன் கிளை உறுதியாய் இருந்ததினால்","poem":1},{"text":"அரச செங்கோலுக்குத் தகுதியாயிற்று.","poem":2},{"text":"அடர்ந்து வளர்ந்த மற்ற இலைகளுக்கு மேலாய் அது உயர்ந்து நின்றது.","poem":1},{"text":"தன் உயரத்தாலும்,","poem":2},{"text":"பல கிளைகளாலும்","poem":1},{"text":"அது சிறப்பாய்க் காட்சியளித்தது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆனால், அந்தத் திராட்சைக்கொடி","poem":1},{"text":"கடுங்கோபத்தோடு வேரோடு பிடுங்கப்பட்டுத்","poem":2},{"text":"தரையில் எறியப்பட்டது.","poem":1},{"text":"கீழ்க்காற்று அதனை வாடப்பண்ணி பழங்களும் உதிர்க்கப்பட்டன.","poem":2},{"text":"அதன் பலத்த கிளைகள் வாடிப்போயின.","poem":1},{"text":"நெருப்பு அவைகளை எரித்தது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இப்பொழுது அது வறண்ட வளமற்ற","poem":1},{"text":"பாலைவனத்தில் நாட்டப்பட்டுள்ளது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"முக்கிய கிளை ஒன்றிலிருந்து இருந்து நெருப்பு எழும்பி,","poem":1},{"text":"அதன் பழத்தைச் சுட்டெரித்தது.","poem":2},{"text":"அரச செங்கோலுக்குத் தகுதிபெற","poem":1},{"text":"இனியொரு கிளையும் அதில் விடப்படவில்லை.’","poem":2},"இது ஒரு புலம்பல் புலம்பலாகவே, உபயோகிக்கப்பட வேண்டும்.”"]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/EZK/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/EZK/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/EZK/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}