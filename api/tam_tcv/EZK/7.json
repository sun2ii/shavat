{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"EZK","translationId":"tam_tcv","name":"எசேக்கியேல்","commonName":"எசேக்கியேல்","title":"இறைவாக்கினன் எசேக்கியேலின் புத்தகம்","order":26,"numberOfChapters":48,"sha256":"f25851a21e0813ea1810ac50ed12a670fb7c281f9d2214acee10e076861da6f2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/EZK/1.json","lastChapterNumber":48,"lastChapterApiLink":"/api/tam_tcv/EZK/48.json","totalNumberOfVerses":1273},"chapter":{"number":7,"content":[{"type":"heading","content":["முடிவு வருகிறது"]},{"type":"verse","number":1,"content":["மேலும் யெகோவாவின் வார்த்தை எனக்கு வந்தது:"]},{"type":"verse","number":2,"content":["“மனுபுத்திரனே, ஆண்டவராகிய யெகோவா இஸ்ரயேல் நாட்டைக்குறித்து கூறுவது இதுவே:",{"text":"“ ‘முடிவு வந்துவிட்டது!","poem":1},{"text":"நாட்டின் நான்கு திசைகளுக்குமே முடிவு வந்துவிட்டது!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இப்பொழுது உனக்கு முடிவு வந்துவிட்டது.","poem":1},{"text":"நான் எனது கோபத்தை உனக்கு விரோதமாய் வரச்செய்வேன்.","poem":2},{"text":"உன் நடத்தைக்குத்தக்கதாக உனக்குத் தீர்ப்பு வழங்கி,","poem":1},{"text":"நீ செய்த எல்லா அருவருப்பான செயல்களுக்காகவும் பழிவாங்குவேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் உன்னைத் தயவாய் பார்க்கவோ;","poem":1},{"text":"தப்பவிடவோ மாட்டேன்.","poem":2},{"text":"உன் நடத்தைகளுக்கும் உன் நடுவே இருக்கும் அருவருப்புகளுக்கும் தக்கதாக,","poem":1},{"text":"நிச்சயமாக நான் பழிக்குப்பழி செய்வேன்.","poem":2},"அப்பொழுது நானே யெகோவா என்பதை நீ அறிந்துகொள்வாய்.’"]},{"type":"line_break"},{"type":"verse","number":5,"content":["“ஆண்டவராகிய யெகோவா கூறுவது இதுவே:",{"text":"“ ‘பேராபத்து! கேள்விப்படாத","poem":1},{"text":"ஒரு பேராபத்து வருகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"முடிவு வந்துவிட்டது!","poem":1},{"text":"முடிவு வந்துவிட்டது!","poem":2},{"text":"அது உனக்கு விரோதமாகவே எழும்பிவிட்டது!","poem":1},{"text":"அது வந்தேவிட்டது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நாட்டில் குடியிருப்பவனே,","poem":1},{"text":"அழிவு உன்மீது வந்துவிட்டது! வேளை வந்துவிட்டது!","poem":2},{"text":"நாள் நெருங்கிவிட்டது! மலைகளின்மேல் மகிழ்ச்சியல்ல.","poem":1},{"text":"திகிலே நிறைந்திருக்கிறது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் சீற்றத்தை இப்பொழுதே உன்மீது ஊற்றி;","poem":1},{"text":"எனது கோபத்தை உனக்கெதிராய்த் தீர்க்கப்போகிறேன்,","poem":2},{"text":"உன் நடத்தைக்குத்தக்கதாய் உனக்குத் தீர்ப்பு வழங்கி,","poem":1},{"text":"நீ செய்த எல்லா அருவருப்பான செயல்களுக்கும் உன்னிடம் பழிவாங்குவேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் உனக்குத் தயை செய்யவும் மாட்டேன்.","poem":1},{"text":"உன்னைத் தண்டியாமல் விடவுமாட்டேன்.","poem":2},{"text":"உன் நடத்தைகளுக்கும் உன் நடுவிலுள்ள","poem":1},{"text":"உன் அருவருப்பான பழக்கவழக்கங்களுக்கும் தக்கதாக நான் பழிவாங்குவேன்.","poem":2},"அப்பொழுது உன்னை அடிக்கிறவராகிய நானே யெகோவா என்பதை நீ அறிந்துகொள்வாய்."]},{"type":"verse","number":10,"content":[{"text":"“ ‘இதோ, அந்த நாள்!","poem":1},{"text":"அது வந்துவிட்டது!","poem":2},{"text":"அழிவு கொந்தளித்துக் குமுறுகிறது!","poem":1},{"text":"அநீதியின் கோல் மொட்டுவிட்டு,","poem":2},{"lineBreak":true},{"text":"அகந்தை மலர்ந்துவிட்டது!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"கொடுமையைத் தண்டிக்க","poem":1},{"text":"வன்முறை கோலாக வளர்ந்துவிட்டது!","poem":2},{"text":"அவர்களுடைய மக்களிலோ கூட்டத்திலோ","poem":1},{"text":"ஒருவனாகிலும் மீந்திருக்கமாட்டான்.","poem":2},{"text":"அவர்களுடைய செல்வமும்,","poem":1},{"text":"விலையுயர்ந்த ஒன்றுமே மீந்திருப்பதில்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அந்தக் காலம் வந்துவிட்டது!","poem":1},{"text":"நாளும் நெருங்கிவிட்டது!","poem":2},{"text":"வாங்குகிறவன் மகிழாமலும்,","poem":1},{"text":"விற்கிறவன் கவலைப்படாமலும் இருக்கட்டும்.","poem":2},{"lineBreak":true},{"text":"ஏனெனில், கடுங்கோபம் எல்லோர்மேலும் வந்திருக்கிறது!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் இருவருமே உயிரோடிருக்கும் வரையிலும்,","poem":1},{"text":"விற்றவன் விற்கப்பட்ட நாட்டைத்","poem":2},{"lineBreak":true},{"text":"திரும்பப்பெறமாட்டான்.","poem":2},{"text":"ஏனெனில் யாவரையும் குறித்த தரிசனம்","poem":1},{"text":"மாற்றப்படமாட்டாது.","poem":2},{"text":"அவர்களின் பாவத்தினிமித்தம் ஒருவனாகிலும்","poem":1},{"text":"தன் வாழ்வைப் பாதுகாத்துக்கொள்ளவுமாட்டான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘அவர்கள் எக்காளம் ஊதி,","poem":1},{"text":"எல்லாவற்றையும் ஆயத்தப்படுத்தினாலும்,","poem":2},{"text":"போருக்கு யாருமே போகமாட்டார்கள்,","poem":1},{"text":"ஏனெனில் எல்லோர்மேலும் என் கோபம் இருக்கிறது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"வெளியே வாள் இருக்கிறது.","poem":1},{"text":"உள்ளே கொள்ளைநோயும், பஞ்சமும் இருக்கின்றன.","poem":2},{"text":"நாட்டுப்புறத்தில் இருக்கிறவர்கள்","poem":1},{"text":"வாளினால் சாவார்கள்.","poem":2},{"text":"நகரத்தில் இருக்கிறவர்கள்","poem":1},{"text":"பஞ்சத்தினாலும் கொள்ளைநோயினாலும் கொல்லப்படுவார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"தப்பிப் பிழைக்கும்","poem":1},{"text":"எல்லோரும் தங்கள்","poem":2},{"text":"பாவங்களின் காரணமாகப்","poem":1},{"text":"பள்ளத்தாக்கின் புறாக்களைப்போல் புலம்பி,","poem":2},{"lineBreak":true},{"text":"மலைகளிலே தங்குவார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஒவ்வொரு கையும் பெலனற்றுப்போகும்.","poem":1},{"text":"ஒவ்வொரு முழங்காலும் தண்ணீரைப் போலாகும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அனைவரும் துக்கவுடைகளை உடுத்திக்கொண்டு","poem":1},{"text":"பயத்தினால் நடுங்குவார்கள்.","poem":2},{"text":"அவர்களுடைய தலைகள் சவரம் செய்யப்பட்டு,","poem":1},{"text":"முகங்கள் வெட்கத்தினால் மூடப்பட்டிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“ ‘அவர்கள் தங்கள் வெள்ளியை வீதிகளில் எறிந்துவிடுவார்கள்.","poem":1},{"text":"அவர்களுடைய தங்கம் அவர்களுக்கு அசுத்த பொருளாகும்.","poem":2},{"text":"யெகோவாவினுடைய கோபத்தின் நாளிலே","poem":1},{"text":"அந்த வெள்ளியும் தங்கமும் அவர்களைக் காப்பாற்றமாட்டாது.","poem":2},{"lineBreak":true},{"text":"அவைகளால் அவர்கள் தங்கள் பசியைத் தீர்த்துக்கொள்ளவுமாட்டார்கள்.","poem":2},{"text":"அவை அவர்களின் வயிற்றை நிரப்பவுமாட்டாது.","poem":1},{"text":"ஏனெனில், அவைகளே அவர்களைப் பாவத்திற்குள்","poem":2},{"lineBreak":true},{"text":"இடறிவிழச் செய்தன.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"தங்களது அழகிய நகைகளைக் குறித்து","poem":1},{"text":"அவர்கள் பெருமையுடையவர்களாய் இருந்தார்கள்.","poem":2},{"lineBreak":true},{"text":"அருவருப்பான விக்கிரகங்களையும்,","poem":2},{"text":"இழிவான உருவச்சிலைகளையும் தங்களுக்குச் செய்வதற்காக,","poem":1},{"text":"அந்த நகைகளைப் பயன்படுத்தினார்கள்;","poem":2},{"lineBreak":true},{"text":"ஆதலால் அவர்களுக்கு அவைகளை தீட்டான பொருளாக்குவேன்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அந்நியர் அவைகளைச் சூறையாடவும்,","poem":1},{"text":"உலகின் கொடியவர்கள் அவைகளைக் கொள்ளையிடவும் செய்வேன்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் அவைகளைக் கறைப்படுத்துவார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவர்களிடமிருந்து என் முகத்தைத் திருப்பிக்கொள்வேன்.","poem":1},{"text":"அப்பொழுது அவர்களுடைய பகைவர்கள்","poem":2},{"text":"எனக்கு அருமையாயுள்ள இடத்தைத் தூய்மைக்கேடாக்குவார்கள்.","poem":1},{"text":"கொள்ளையர் அங்கு புகுந்து அதன் தூய்மையைக் கெடுப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ ‘நீ சங்கிலிகளை ஆயத்தப்படுத்திக்கொள்.","poem":1},{"text":"நாடு இரத்தம் சிந்துதலால் நிறைந்திருக்கிறது;","poem":2},{"lineBreak":true},{"text":"நகரம் வன்செயலாலும் நிறைந்துள்ளது.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"இவர்களுடைய வீடுகளை உரிமையாக்கிக்கொள்ளும்படி","poem":1},{"text":"நாடுகளிலே மிகக் கொடூரமானவர்களை நான் கொண்டுவருவேன்.","poem":2},{"text":"வலியவர்களின் பெருமையையும் ஒழியப்பண்ணுவேன்.","poem":1},{"text":"அவர்களுடைய பரிசுத்த இடங்களும் தூய்மைக் கேடாக்கப்படும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"பயங்கரம் வரும்போது, அவர்கள் சமாதானத்தைத் தேடுவார்கள்.","poem":1},{"text":"அது கிடைக்காமற்போகும்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அழிவுக்குமேல் அழிவு வரும்,","poem":1},{"text":"வதந்திக்குமேல் வதந்தி வரும்.","poem":2},{"text":"இறைவாக்கினரிடமிருந்து தரிசனங்களை பெற முயற்சிப்பார்கள்.","poem":1},{"text":"நீதிச்சட்டத்தைப் பற்றிய ஆசாரியர்களின்","poem":2},{"lineBreak":true},{"text":"போதித்தலும் உபதேசமும் முதியோரின் ஆலோசனைகளும் ஒழிந்துபோகும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அரசன் துக்கிப்பான்.","poem":1},{"text":"இளவரசனைத் திகில் மூடிக்கொள்ளும்.","poem":2},{"lineBreak":true},{"text":"நாட்டு மக்களின் கைகள் நடுங்கும்.","poem":2},{"text":"நான் அவர்கள் நடத்தைக்கு ஏற்ப அவர்களை நடத்துவேன்.","poem":1},{"text":"அவர்கள் தீர்ப்பளித்த விதத்தின்படியே அவர்களுக்கும் நான் நியாயந்தீர்ப்பேன்.","poem":2},"அப்பொழுது நானே யெகோவா என்பதை அவர்கள் அறிந்துகொள்வார்கள்’ ” என்றார்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/EZK/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/EZK/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/EZK/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}