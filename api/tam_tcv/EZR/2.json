{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"EZR","translationId":"tam_tcv","name":"எஸ்றா","commonName":"எஸ்றா","title":"எஸ்றாவின் புத்தகம்","order":15,"numberOfChapters":10,"sha256":"0b17c5c882e90c4777c1cff3d6872261b80fe983285cd599a20e9ad8fc36e4e6","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/EZR/1.json","lastChapterNumber":10,"lastChapterApiLink":"/api/tam_tcv/EZR/10.json","totalNumberOfVerses":280},"chapter":{"number":2,"content":[{"type":"heading","content":["திரும்பி வந்தவர்களின் பெயர்ப் பட்டியல்"]},{"type":"verse","number":1,"content":["பாபிலோன் அரசன் நேபுகாத்நேச்சாரால் சிறைபிடிக்கப்பட்டு, பாபிலோனுக்குக் கொண்டுபோகப்பட்டவர்களுள், சிறையிருப்பிலிருந்து அவர்களுடைய பட்டணமான எருசலேமுக்கும் யூதாவுக்கும்"]},{"type":"verse","number":2,"content":["செருபாபேல், யெசுவா, நெகேமியா, செராயா, ரெலாயா, மொர்தெகாய், பில்சான், மிஸ்பார், பிக்வாய், ரேகூம், பானா என்பவர்களுடன் திரும்பி வந்தார்கள்.",{"lineBreak":true},"இவர்களுடன் திரும்பி வந்த இஸ்ரயேல் மனிதரின் பெயர் பட்டியல்:"]},{"type":"verse","number":3,"content":["பாரோஷின் சந்ததி 2,172 பேர்,"]},{"type":"verse","number":4,"content":["செபத்தியாவின் சந்ததி 372 பேர்,"]},{"type":"verse","number":5,"content":["ஆராகின் சந்ததி 775 பேர்,"]},{"type":"verse","number":6,"content":["யெசுவா, யோவாப்பின் வழிவந்த பாகாத் மோவாபின் சந்ததி 2,812 பேர்,"]},{"type":"verse","number":7,"content":["ஏலாமின் சந்ததி 1,254 பேர்,"]},{"type":"verse","number":8,"content":["சத்தூவின் சந்ததி 945 பேர்,"]},{"type":"verse","number":9,"content":["சக்காயின் சந்ததி 760 பேர்,"]},{"type":"verse","number":10,"content":["பானியின் சந்ததி 642 பேர்,"]},{"type":"verse","number":11,"content":["பெபாயின் சந்ததி 623 பேர்,"]},{"type":"verse","number":12,"content":["அஸ்காதின் சந்ததி 1,222 பேர்,"]},{"type":"verse","number":13,"content":["அதோனிகாமின் சந்ததி 666 பேர்,"]},{"type":"verse","number":14,"content":["பிக்வாயின் சந்ததி 2,056 பேர்,"]},{"type":"verse","number":15,"content":["ஆதீனின் சந்ததி 454 பேர்,"]},{"type":"verse","number":16,"content":["எசேக்கியாவின் வழிவந்த ஆதேரின் சந்ததி 98 பேர்,"]},{"type":"verse","number":17,"content":["பேஸாயின் சந்ததி 323 பேர்,"]},{"type":"verse","number":18,"content":["யோராகின் சந்ததி 112 பேர்,"]},{"type":"verse","number":19,"content":["ஆசூமின் சந்ததி 223 பேர்,"]},{"type":"verse","number":20,"content":["கிபாரின் சந்ததி 95 பேர்."]},{"type":"line_break"},{"type":"verse","number":21,"content":["பெத்லெகேமின் மனிதர் 123 பேர்,"]},{"type":"verse","number":22,"content":["நெத்தோபாவின் மனிதர் 56 பேர்,"]},{"type":"verse","number":23,"content":["ஆனதோத்தின் மனிதர் 128 பேர்,"]},{"type":"verse","number":24,"content":["அஸ்மாவேத்தின் மனிதர் 42 பேர்,"]},{"type":"verse","number":25,"content":["கீரியாத்யாரீம், கெபிரா, பேரோத் பட்டணங்களின் மனிதர் 743 பேர்,"]},{"type":"verse","number":26,"content":["ராமா, கேபாவின் மனிதர் 621 பேர்,"]},{"type":"verse","number":27,"content":["மிக்மாசின் மனிதர் 122 பேர்,"]},{"type":"verse","number":28,"content":["பெத்தேல், ஆயியின் மனிதர் 223 பேர்,"]},{"type":"verse","number":29,"content":["நேபோவின் மனிதர் 52 பேர்,"]},{"type":"verse","number":30,"content":["மக்பீசின் மனிதர் 156 பேர்,"]},{"type":"verse","number":31,"content":["மற்ற ஏலாமின் மனிதர் 1,254 பேர்,"]},{"type":"verse","number":32,"content":["ஆரீமின் மனிதர் 320 பேர்,"]},{"type":"verse","number":33,"content":["லோத், ஆதித், ஓனோ பட்டணங்களின் மனிதர் 725 பேர்,"]},{"type":"verse","number":34,"content":["எரிகோவின் மனிதர் 345 பேர்,"]},{"type":"verse","number":35,"content":["செனாகாவின் மனிதர் 3,630 பேர்."]},{"type":"line_break"},{"type":"verse","number":36,"content":["ஆசாரியர்கள்: யெசுவாவின் குடும்பத்தானாகிய யெதாயாவின் சந்ததி 973 பேர்,"]},{"type":"verse","number":37,"content":["இம்மேரின் சந்ததி 1,052 பேர்,"]},{"type":"verse","number":38,"content":["பஸ்கூரின் சந்ததி 1,247 பேர்,"]},{"type":"verse","number":39,"content":["ஆரீமின் சந்ததி 1,017 பேர்."]},{"type":"line_break"},{"type":"verse","number":40,"content":["லேவியர்கள்: ஓதவியாவின் வழிவந்த யெசுவா, கத்மியேல் ஆகியோரின் சந்ததி 74 பேர்."]},{"type":"line_break"},{"type":"verse","number":41,"content":["பாடகர்கள்: ஆசாப்பின் சந்ததி 128 பேர்."]},{"type":"line_break"},{"type":"verse","number":42,"content":["ஆலய வாசல் காவலர்கள்: சல்லூம் அதேர், தல்மோன், அக்கூப், அதிதா, சோபாய் ஆகியோரின் சந்ததிகள் 139 பேர்."]},{"type":"line_break"},{"type":"verse","number":43,"content":["திரும்பி வந்த ஆலய பணியாட்கள்: சீகா, அசுபா, தபாயோத்,"]},{"type":"verse","number":44,"content":["கேரோசு, சீயாகா, பாதோன்,"]},{"type":"verse","number":45,"content":["லெபானா, அகாபா, அக்கூப்,"]},{"type":"verse","number":46,"content":["ஆகாப், சல்மாயி, ஆனான்,"]},{"type":"verse","number":47,"content":["கித்தேல், காகார், ரயாயா,"]},{"type":"verse","number":48,"content":["ரேசீன், நெக்கோதா, காசாம்,"]},{"type":"verse","number":49,"content":["ஊசா, பாசெயா, பேசாய்,"]},{"type":"verse","number":50,"content":["அஸ்னா, மெயூனீம், நெபுசீம்,"]},{"type":"verse","number":51,"content":["பக்பூக், அகுபா, அர்கூர்,"]},{"type":"verse","number":52,"content":["பஸ்லூத், மெகிதாவ், அர்ஷா,"]},{"type":"verse","number":53,"content":["பர்கோஸ், சிசெரா, தேமா,"]},{"type":"verse","number":54,"content":["நெத்சியா, அதிபா ஆகியோரின் சந்ததிகள்."]},{"type":"verse","number":55,"content":["திரும்பி வந்த சாலொமோனின் வேலையாட்களின் சந்ததிகள்: சோதாய், சொபெரேத், பெருதா,"]},{"type":"verse","number":56,"content":["யாலா, தர்கோன், கித்தேல்,"]},{"type":"verse","number":57,"content":["செபத்தியா, அத்தீல், பொகெரேத் செபாயீம், ஆமி ஆகியோரின் சந்ததிகள்."]},{"type":"verse","number":58,"content":["ஆலய பணியாட்களுடன், சாலொமோனின் பணியாட்களின் சந்ததிகளும் சேர்த்து 392 பேர்."]},{"type":"line_break"},{"type":"verse","number":59,"content":["பின்வருவோர் தெல்மெலா, தெல்அர்ஷா, கேரூப், ஆதோன், இம்மேர் ஆகிய நகரங்களிலிருந்து திரும்பி வந்தவர்கள். ஆனால் அவர்களுக்கோ தங்கள் குடும்பங்கள் இஸ்ரயேலின் வழிவந்தவை என நிரூபிக்க முடியவில்லை."]},{"type":"verse","number":60,"content":["அவர்கள், தெலாயா, தொபியா, நெக்கோதா ஆகியோரின் சந்ததிகளான 652 பேர்."]},{"type":"line_break"},{"type":"verse","number":61,"content":["ஆசாரியர்களைச் சேர்ந்தவர்கள்: அபாயா, அக்கோஸ், அக்கோசு, பர்சில்லாய் ஆகியோரின் சந்ததிகள். பர்சில்லாய் என்பவன் கீலேயாத்திய மனிதனான பர்சில்லாயின் மகள்களில் ஒருத்தியைத் திருமணம் செய்ததால் இப்பெயரால் அழைக்கப்பட்டான்."]},{"type":"verse","number":62,"content":["இவர்கள் தங்கள் குடும்ப அட்டவணையைத் தேடினார்கள்; ஆனால் அவர்களால் கண்டுபிடிக்க முடியவில்லை. அதனால் அவர்கள் ஆசாரியப் பணியிலிருந்து அசுத்தமானவர்கள் எனத் தள்ளி வைக்கப்பட்டார்கள்."]},{"type":"verse","number":63,"content":["ஊரீம், தும்மீம் அணிந்த ஒரு ஆசாரியன் எழும்பும் வரைக்கும் அவர்கள் மகா பரிசுத்த உணவிலிருந்து எதையும் சாப்பிடக்கூடாது என ஆளுநன் உத்தரவிட்டான்."]},{"type":"line_break"},{"type":"verse","number":64,"content":["எண்ணப்பட்ட முழுத் தொகை 42,360 பேர்."]},{"type":"verse","number":65,"content":["இவர்களைத் தவிர அவர்களின் ஆண் பெண் வேலைக்காரர் 7,337 பேரும், பாடகர்களும் பாடகிகளும் 200 பேரும் இருந்தனர்."]},{"type":"verse","number":66,"content":["அவர்களிடம் 736 குதிரைகளும், 245 கோவேறு கழுதைகளும்,"]},{"type":"verse","number":67,"content":["435 ஒட்டகங்களும், 6,720 கழுதைகளும் இருந்தன."]},{"type":"line_break"},{"type":"verse","number":68,"content":["அவர்கள் எல்லோரும் எருசலேமிலுள்ள யெகோவாவின் ஆலயத்துக்கு வந்து சேர்ந்தவுடனே, குடும்பத் தலைவர்களில் சிலர் இறைவனுடைய ஆலயத்தை அதனுடைய இடத்தில் திரும்பக் கட்டுவதற்காக சுயவிருப்புக் காணிக்கைகளைக் கொடுத்தார்கள்."]},{"type":"verse","number":69,"content":["அவர்கள் தங்களால் முடியுமானவரை 61,000 தங்கக் காசுகளையும்",{"noteId":1},", 5,000 வெள்ளியையும்",{"noteId":2},", ஆசாரியருக்கான 100 உடைகளையும் அவ்வேலைக்கென ஆலயத் திரவிய களஞ்சியத்துக்குக் கொடுத்தார்கள்."]},{"type":"verse","number":70,"content":["ஆசாரியர்கள், லேவியர்கள், பாடகர்கள், வாசல் காவலர்கள், ஆலய பணியாளர்கள் ஆகியோர் வேறுசில மக்களுடனும், மீதியான இஸ்ரயேலருடனும் தங்கள் சொந்தப் பட்டணங்களில் குடியமர்ந்தார்கள்."]}],"footnotes":[{"noteId":1,"caller":"+","text":"அதாவது, சுமார் 500 கிலோகிராம் தங்கம்","reference":{"chapter":2,"verse":69}},{"noteId":2,"caller":"+","text":"அதாவது, சுமார் 2800 கிலோகிராம் வெள்ளி","reference":{"chapter":2,"verse":69}}]},"thisChapterLink":"/api/tam_tcv/EZR/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/EZR/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/EZR/1.json","previousChapterAudioLinks":{},"numberOfVerses":70}