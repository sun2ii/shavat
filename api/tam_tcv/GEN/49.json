{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"GEN","translationId":"tam_tcv","name":"ஆதியாகமம்","commonName":"ஆதியாகமம்","title":"ஆதியாகமம்","order":1,"numberOfChapters":50,"sha256":"9be935bb25b46f259af688eb5b4f5d8b5733e78398856fecf6f904698f2cc7c6","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/GEN/1.json","lastChapterNumber":50,"lastChapterApiLink":"/api/tam_tcv/GEN/50.json","totalNumberOfVerses":1533},"chapter":{"number":49,"content":[{"type":"heading","content":["யாக்கோபு ஆசீர்வதித்தல்"]},{"type":"verse","number":1,"content":["பின்பு யாக்கோபு தன் மகன்களைக் கூப்பிட்டு அவர்களிடம் சொன்னதாவது: “நீங்கள் எல்லோரும் என்னைச் சுற்றி நில்லுங்கள், இனிவரப்போகும் நாட்களில் நடக்கப்போவதை நான் உங்களுக்குச் சொல்லப்போகிறேன்."]},{"type":"verse","number":2,"content":[{"text":"“யாக்கோபின் மகன்களே, கூடிவந்து கேளுங்கள்;","poem":1},{"text":"உங்கள் தகப்பன் இஸ்ரயேல் சொல்வதைக் கேளுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ரூபன், நீ என் முதற்பேறானவன்,","poem":1},{"text":"நீ வலிமையும் என் பெலனின் முதல் அடையாளமுமானவன்,","poem":2},{"lineBreak":true},{"text":"நீ மதிப்பில் சிறந்தவன், நீ வல்லமையிலும் சிறந்தவன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"தண்ணீரைப்போல் தளம்புகிறவனே, நீ இனிமேல் மேன்மை அடையமாட்டாய்;","poem":1},{"text":"ஏனெனில், நீ உன்னுடைய தகப்பனின் படுக்கைக்குப்போய்,","poem":2},{"lineBreak":true},{"text":"என் கட்டிலைத் தீட்டுப்படுத்தினாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“சிமியோனும், லேவியும் சகோதரர்கள்.","poem":1},{"text":"அவர்களின் வாள்கள் வன்முறையின் ஆயுதங்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் அவர்களுடைய ஆலோசனைக்கு உடன்படாமலும்,","poem":1},{"text":"அவர்களுடைய கூட்டத்தில் சேராமலும் இருப்பேனாக.","poem":2},{"text":"ஏனெனில், அவர்கள் தங்கள் கோபத்தினால் மனிதரைக் கொன்றார்கள்,","poem":1},{"text":"தாங்கள் விரும்பியவாறு எருதுகளை முடமாக்கினார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்களுடைய பயங்கரமான கோபமும்,","poem":1},{"text":"கொடூரமான மூர்க்கமும் சபிக்கப்படுவதாக;","poem":2},{"text":"நான் அவர்களை யாக்கோபிலே பிரியச்செய்து,","poem":1},{"text":"இஸ்ரயேலிலே சிதறப்பண்ணுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“யூதா, உன் சகோதரர் உன்னைப் புகழ்வார்கள்;","poem":1},{"text":"உன் பகைவர்களின் கழுத்தின்மேல் உன்னுடைய கை இருக்கும்;","poem":2},{"lineBreak":true},{"text":"உன் தகப்பனின் மகன்கள் உன்முன் பணிவார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யூதா, நீ ஒரு சிங்கக்குட்டி;","poem":1},{"text":"என் மகனே, நீ இரைதின்று திரும்புகிறாய்.","poem":2},{"text":"அவன் சிங்கத்தைப்போலும் பெண் சிங்கத்தைப்போலும் மடங்கிப் படுக்கிறான்;","poem":1},{"text":"அவனை எழுப்பத் துணிபவன் யார்?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"செங்கோலுக்குரியவர் வரும்வரை","poem":1},{"text":"செங்கோல் யூதாவைவிட்டு நீங்காது,","poem":2},{"text":"ஆளுநரின் கோல் அவனுடைய பாதங்களைவிட்டு விலகாது;","poem":1},{"text":"நாடுகளின் கீழ்ப்படிதல் அவருக்கே உரியது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவன் தன் கழுதையை திராட்சைச் செடியிலும்,","poem":1},{"text":"தன் கழுதைக் குட்டியைச் சிறந்த திராட்சைக் கொடியிலும் கட்டுவான்;","poem":2},{"text":"அவன் தன் உடைகளைத் திராட்சை இரசத்திலும்,","poem":1},{"text":"அங்கிகளைத் திராட்சைப்பழச் சாற்றிலும் கழுவுவான்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவனுடைய கண்கள் திராட்சை இரசத்தைவிட கருமையும்,","poem":1},{"text":"பற்கள் பாலைவிட வெண்மையுமாய் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“செபுலோன் கடற்கரையில் குடியிருந்து,","poem":1},{"text":"கப்பல் துறைமுகமாய் இருப்பான்;","poem":2},{"lineBreak":true},{"text":"அவனுடைய எல்லை சீதோன்வரை பரந்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“இசக்கார் இரண்டு பொதிகளுக்கிடையே படுத்திருக்கும்","poem":1},{"text":"பலமுள்ள கழுதை.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவன் தன் இளைப்பாறும் இடம் எவ்வளவு நல்லதென்றும்,","poem":1},{"text":"தனது நாடு எத்தகைய மகிழ்ச்சிக்குரியது என்றும் கண்டு,","poem":2},{"text":"சுமைக்குத் தன் தோளை சாய்ப்பான்;","poem":1},{"text":"கட்டாய வேலைக்கும் இணங்குவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“தாண் இஸ்ரயேலின் கோத்திரங்களில் ஒரு கோத்திரமாயிருந்து,","poem":1},{"text":"தன் மக்களுக்கு நீதி வழங்குவான்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"தாண், குதிரைமீது போகிறவன்","poem":1},{"text":"இடறிவிழும்படி பாதையோரம் கிடந்து,","poem":2},{"text":"குதிரைகளின் குதிங்காலைக் கடிக்கிற பாம்பைப்போலவும்,","poem":1},{"text":"வழியிலே கிடக்கும் விரியன் பாம்பைப்போலவும் இருப்பான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“யெகோவாவே, நான் உம்முடைய மீட்புக்காகக் காத்திருக்கிறேன்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“காத் கொள்ளைக் கூட்டத்தாரால் தாக்கப்படுவான்,","poem":1},{"text":"ஆனாலும் இறுதியில் அவன் அவர்களைத் தாக்குவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ஆசேருடைய உணவு கொழுமையானதாய் இருக்கும்;","poem":1},{"text":"அரசனுக்குத் தகுந்த சுவையான உணவை அவன் கொடுப்பான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“நப்தலி","poem":1},{"noteId":51},{"text":"அழகான குட்டிகளை ஈனும்","poem":1},{"text":"விடுதலை பெற்ற பெண்மான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“யோசேப்பு கனிதரும் செடி;","poem":1},{"text":"அவன் நீரூற்றருகில் கனிதரும் திராட்சைக்கொடி.","poem":2},{"lineBreak":true},{"text":"அவனுடைய கிளைகள், மதில்களில் ஓங்கி வளரும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"வில்வீரர் அவனைக் கொடூரமாகத் தாக்கினார்கள்;","poem":1},{"text":"பகைமையுடன் அவன்மேல் எய்தார்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஆனால், அவனுடைய வில் உறுதியாய் நின்றது;","poem":1},{"text":"அவனுடைய பெலமுள்ள புயங்கள் சுறுசுறுப்பாயிருந்தன;","poem":2},{"text":"யாக்கோபின் வல்லவரின் கரத்தினாலும்,","poem":1},{"text":"மேய்ப்பராலும், இஸ்ரயேலுடைய கற்பாறையாலும்,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உனக்கு உதவிசெய்யும் உன் தகப்பனின் இறைவனாலும் இப்படியாகும்.","poem":1},{"text":"அவர் மேலேயுள்ள வானங்களின் ஆசீர்வாதங்களினாலும்,","poem":2},{"text":"கீழேயுள்ள ஆழங்களின் ஆசீர்வாதங்களினாலும்,","poem":1},{"text":"மார்பகங்களின், கருப்பையின் ஆசீர்வாதங்களினாலும்","poem":2},{"lineBreak":true},{"text":"உன்னை ஆசீர்வதிக்கும் எல்லாம் வல்லவராய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"உன் தகப்பனின் ஆசீர்வாதங்கள்","poem":1},{"text":"நித்திய மலைகளின் ஆசீர்வாதங்களைப் பார்க்கிலும்,","poem":2},{"lineBreak":true},{"text":"பழைமை வாய்ந்த குன்றுகளின் செழிப்பைப் பார்க்கிலும் பெரிதானவை.","poem":2},{"text":"இவைகளெல்லாம் யோசேப்பின் தலையின்மேலும்,","poem":1},{"text":"தன் சகோதரருக்குள் பிரபுவாய் இருக்கிறவனின் நெற்றியிலும் தங்குவதாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“பென்யமீன் ஒரு பீறுகிற ஓநாய்;","poem":1},{"text":"காலையில் தன் இரையைப் பேராவலுடன் பட்சிப்பான்.","poem":2},{"lineBreak":true},{"text":"மாலையில் தான் கொள்ளையிட்டதைப் பங்கிடுவான்.”","poem":2}]},{"type":"verse","number":28,"content":["இஸ்ரயேலின் பன்னிரு கோத்திரங்களும் இவர்களே, அவர்களுடைய தகப்பன் அவனவனுக்குத் தகுந்த ஆசீர்வாதங்களைச் சொல்லி, அவர்களை ஆசீர்வதிக்கும்போது சொன்னவை இவையே."]},{"type":"heading","content":["யாக்கோபின் மரணம்"]},{"type":"verse","number":29,"content":["பின்பு அவன் அவர்களுக்கு அறிவுறுத்திச் சொன்னதாவது: “நான் என் முன்னோர்களுடன் சேர்த்துக்கொள்ளப்படப் போகிறேன். ஏத்தியனான எப்ரோனிடமிருந்து வாங்கிய நிலத்திலே, என் தந்தையர்களை அடக்கம்பண்ணிய குகையிலேயே என்னையும் அடக்கம்பண்ணுங்கள்."]},{"type":"verse","number":30,"content":["அந்தக் குகை கானானிலுள்ள மம்ரேக்கு அருகில் மக்பேலா என்னும் வயல்வெளியில் இருக்கிறது; ஆபிரகாம் அதை ஏத்தியனான எப்ரோனிடமிருந்து வயலையும் சேர்த்து கல்லறை நிலமாக வாங்கினார்."]},{"type":"verse","number":31,"content":["அங்கேயே ஆபிரகாமும் அவர் மனைவி சாராளும், ஈசாக்கும் அவர் மனைவி ரெபெக்காளும் அடக்கம்பண்ணப்பட்டார்கள்; என் மனைவி லேயாளையும் நான் அங்கேயே அடக்கம்பண்ணினேன்."]},{"type":"verse","number":32,"content":["அந்த நிலமும் குகையும் ஏத்தியரிடமிருந்து வாங்கப்பட்டவை” என்றான்."]},{"type":"verse","number":33,"content":["யாக்கோபு தன் மகன்களுக்கு அறிவுரை கூறிமுடித்ததும், அவன் தன் கால்களைக் கட்டிலின்மேல் தூக்கிவைத்து, இறுதி மூச்சை விட்டான். இவ்வாறு அவன் தனது முன்னோருடன் சேர்க்கப்பட்டான்."]}],"footnotes":[{"noteId":51,"caller":"+","text":"நப்தலி என்றால் மகிழ்ச்சியான வார்த்தைகளைப் பேசுவான் என்று அர்த்தம்.","reference":{"chapter":49,"verse":21}}]},"thisChapterLink":"/api/tam_tcv/GEN/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/GEN/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/GEN/48.json","previousChapterAudioLinks":{},"numberOfVerses":33}