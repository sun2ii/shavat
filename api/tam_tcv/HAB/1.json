{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HAB","translationId":"tam_tcv","name":"ஆபகூக்","commonName":"ஆபகூக்","title":"ஆபகூக்","order":35,"numberOfChapters":3,"sha256":"ef056261566e714af903ae3e7055b251bc4578f2d6ad15bd01b54790f2f6e3c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["இறைவாக்கினன் ஆபகூக் என்பவனுக்கு வெளிப்படுத்தப்பட்ட இறைவாக்கு."]},{"type":"line_break"},{"type":"heading","content":["ஆபகூக்கின் முறைப்பாடு"]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே, நான் எவ்வளவு காலத்திற்கு உதவிகேட்டு உம்மைக் கூப்பிட வேண்டும்?","poem":1},{"text":"நீரோ இன்னும் செவிகொடாமல் இருக்கிறீரே.","poem":2},{"text":"எவ்வளவு காலத்திற்கு உம்மிடம், “வன்முறை” எனக் கதறவேண்டும்?","poem":1},{"text":"இன்னும் காப்பாற்றாமல் இருக்கிறீரே.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீர் ஏன் என்னை அநீதியைப் பார்க்கும்படி செய்கிறீர்?","poem":1},{"text":"ஏன் அநியாயத்தைச் சகித்துக் கொண்டிருக்கிறீர்?","poem":2},{"text":"அழிவும், வன்செயலும் என் முன்னே இருக்கின்றனவே;","poem":1},{"text":"போராட்டமும், வாதையும் பெருகுகின்றன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆதலால் சட்டம் வலுவிழந்துள்ளது,","poem":1},{"text":"நீதி நடைமுறைப் படுத்தப்படுவதில்லை.","poem":2},{"text":"கொடுமையானவர்கள் நேர்மையானவர்களை ஒடுக்குகிறார்கள்.","poem":1},{"text":"அதனால் நீதி புரட்டப்படுகிறதே.","poem":2}]},{"type":"heading","content":["யெகோவாவின் பதில்"]},{"type":"verse","number":5,"content":[{"text":"“பிற நாடுகளைக் கவனித்துப் பாருங்கள்,","poem":1},{"text":"பார்த்து முழுவதுமாய் வியப்படையுங்கள்.","poem":2},{"text":"உங்களுக்குச் சொன்னாலும்,","poem":1},{"text":"உங்களால் நம்பமுடியாத ஒரு செயலை,","poem":2},{"lineBreak":true},{"text":"உங்கள் நாட்களிலேயே நான் செய்யப்போகிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இரக்கமற்றவர்களும்,","poem":1},{"text":"மூர்க்கம் கொண்டவர்களுமான பாபிலோனியரை","poem":2},{"noteId":0},{"text":"நான் எழுப்புகிறேன்.","poem":2},{"text":"அவர்கள் தங்களுக்குச் சொந்தமல்லாத இருப்பிடங்களைக் கைப்பற்றும்படி,","poem":1},{"text":"பூமியெங்கும் அணியணியாய் செல்வார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் பயமும் திகிலும் ஊட்டும் மக்கள்;","poem":1},{"text":"அவர்கள் தாங்கள் செய்வதே சரியானதும் சட்டமும் என்று எண்ணுகிறவர்கள்.","poem":2},{"lineBreak":true},{"text":"தங்கள் சொந்த மேன்மையை மாத்திரமே தேடுகிறவர்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்களுடைய குதிரைகள் சிறுத்தைப் புலிகளைவிட வேகமானவை,","poem":1},{"text":"சாயங்காலத்தில் நடமாடும் ஓநாயிலும் பயங்கரமானவை.","poem":2},{"text":"அவர்களுடைய குதிரைப்படை தலைதெறிக்க ஓடிவரும்;","poem":1},{"text":"அவர்களுடைய குதிரைவீரர்களோ, தொலைவிலிருந்து வருகிறார்கள்.","poem":2},{"text":"இரைமேல் பாயும் கழுகைப்போல, அவர்கள் வருகிறார்கள்;","poem":1}]},{"type":"verse","number":9,"content":[{"text":"அவர்கள் எல்லோரும் வன்முறையை நாடியே வருகிறார்கள்.","poem":2},{"text":"அவர்களுடைய படைகள், பாலைவனக் காற்றுப்போல் முன்னேறிச் சென்று,","poem":1},{"text":"கைதிகளை மணலைப்போல வாரிச் சேர்த்துக்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் அரசர்களை கேலிசெய்து,","poem":1},{"text":"ஆளுநர்களை ஏளனம் செய்கிறார்கள்.","poem":2},{"text":"அரண்செய்த பட்டணங்களையெல்லாம் பார்த்து நகைக்கிறார்கள்;","poem":1},{"text":"முற்றுகை அரண்களை மண்ணினால் கட்டி, அவற்றைக் கைப்பற்றுகிறார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"காற்றைப்போல் கடந்து போகிறார்கள்.","poem":1},{"text":"அவர்கள் தங்கள் சுயபெலத்தையே தெய்வமாகக் கொண்டிருக்கும் குற்றவாளிகள்.”","poem":2}]},{"type":"heading","content":["ஆபகூக்கின் இரண்டாவது முறைப்பாடு"]},{"type":"verse","number":12,"content":[{"text":"யெகோவாவே, என் இறைவனே, என் பரிசுத்தமானவரே,","poem":1},{"text":"நீர் நித்தியத்தில் இருந்தே உள்ளவர் அல்லவோ?","poem":2},{"lineBreak":true},{"text":"நாங்களும் அழிக்கப்பட்டுப் போவோமா?","poem":2},{"text":"யெகோவாவே, எங்கள் நலனுக்காகத்தானே நியாயத்தீர்ப்பை நிறைவேற்ற","poem":1},{"text":"நீர் பாபிலோனியரை நியமித்திருக்கிறீர்;","poem":2},{"lineBreak":true},{"text":"கன்மலையே, எங்களைத் தண்டிக்க நீர் அவர்களை அமர்த்தியிருக்கிறீர்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"உம்முடைய கண்கள் அதிக தூய்மையானதால்,","poem":1},{"text":"அவை தீமையைப் பார்ப்பதில்லை;","poem":2},{"text":"அநியாயத்தை சகிக்க உம்மால் முடியாது.","poem":1},{"text":"அப்படியானால் துரோகிகளை நீர் ஏன் சகிக்கிறீர்?","poem":2},{"text":"கொடியவர்களான பாபிலோனியர் தங்களைவிட நீதியானவர்களை விழுங்கும்போது","poem":1},{"text":"நீர் ஏன் மவுனமாய் இருக்கிறீர்?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நீர் எங்களை கடலில் உள்ள மீன்களைப் போலவும்,","poem":1},{"text":"தலைவனில்லாத கடல் பிராணிகளைப் போலவுமா காண்கிறீர்?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"பாபிலோனியனான கொடிய எதிரிகள் எல்லோரையும் தூண்டிலினால் இழுக்கிறான்.","poem":1},{"text":"தனது வலையினால் அவர்களைப் பிடிக்கிறான்.","poem":2},{"text":"தனது இழுவை வலையினால் அவர்களை ஒன்றாய் அள்ளிச் சேர்க்கிறான்.","poem":1},{"text":"இவ்விதம் அவன் மகிழ்ச்சிகொண்டு களிகூருகிறான்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆதலினால் அவன் தனது வலைகளுக்குப் பலியிட்டு,","poem":1},{"text":"தனது இழுவை வலைக்கு தூபங்காட்டுகிறான்.","poem":2},{"text":"ஏனெனில் தனது வலையினால் அவன் செல்வச் சிறப்புடன் வாழ்ந்து","poem":1},{"text":"சிறந்த உணவைச் சாப்பிட்டு மகிழ்கிறான்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அப்படியாயின் அவன் நாடுகளை இரக்கமின்றி அழிக்க இடங்கொடுப்பீரோ?","poem":1},{"text":"அவன் தனது வலையை தொடர்ந்து நிரப்பிக்கொண்டே இருக்கவேண்டுமோ?","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"பாபிலோனியரை அல்லது கல்தேயர்கள்","reference":{"chapter":1,"verse":6}}]},"thisChapterLink":"/api/tam_tcv/HAB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HAB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/NAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":17}