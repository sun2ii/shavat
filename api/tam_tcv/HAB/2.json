{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HAB","translationId":"tam_tcv","name":"ஆபகூக்","commonName":"ஆபகூக்","title":"ஆபகூக்","order":35,"numberOfChapters":3,"sha256":"ef056261566e714af903ae3e7055b251bc4578f2d6ad15bd01b54790f2f6e3c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"நான் போய் என் காவல் கோபுரத்தில் நிற்பேன்.","poem":1},{"text":"காவல் அரண்கள்மேல் நான் நிலைகொள்வேன்,","poem":2},{"text":"யெகோவா எனக்கு என்ன சொல்வார் என்று அறியும்படி நான் பார்த்திருப்பேன்.","poem":1},{"text":"நான் கண்டிக்கப்பட்டால், என்ன மறுமொழி சொல்வேன்","poem":2},{"lineBreak":true},{"text":"எனவும் சிந்தித்துக் கொண்டிருப்பேன்.","poem":2}]},{"type":"heading","content":["யெகோவாவின் பதில்"]},{"type":"verse","number":2,"content":["அப்பொழுது யெகோவா பதிலளித்துச் சொன்னதாவது:",{"text":"“இந்த வெளிப்படுத்துதலை எழுதிவை,","poem":1},{"text":"அதை கற்பலகையில் தெளிவாய் பொறித்து வை.","poem":2},{"lineBreak":true},{"text":"தூதுவன் அதனுடன் விரைவாய் ஓடி அறிவிக்கக்கூடியதாக இருக்கட்டும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இந்த வெளிப்படுத்தல், அதற்கு நியமிக்கப்பட்ட காலத்தில்","poem":1},{"text":"நிறைவேறக் காத்திருக்கிறது.","poem":2},{"text":"அது முடிவு காலத்தைப்பற்றிச் சொல்கிறது,","poem":1},{"text":"அது பொய்யாய் போகமாட்டாது.","poem":2},{"text":"அது வருவதற்குக் காலம் தாழ்த்தினாலும்,","poem":1},{"text":"அதற்காகக் காத்திரு, அது நிச்சயமாய் வரும்,","poem":2},{"lineBreak":true},{"text":"அது தாமதிக்காது.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“பார், தற்பெருமை கொண்டிருக்கிறானே,","poem":1},{"text":"அவனுடைய ஆசைகள் நேர்மையானவை அல்ல;","poem":2},{"lineBreak":true},{"text":"ஆனால் நீதிமானோ விசுவாசத்தினாலே வாழ்வான்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உண்மையாகவே, மதுபானமும், செல்வமும் அவனுக்கு துரோகம் செய்கிறது;","poem":1},{"text":"அவன் அகந்தையாய் இருப்பதனால், அமைதியற்று இருக்கிறான்.","poem":2},{"text":"ஏனெனில் அவன் பாதாளத்தைப்போல் பேராசை உள்ளவனாயும்,","poem":1},{"text":"சாவைப்போல் திருப்தி அற்றவனாயும் இருக்கிறான்.","poem":2},{"text":"அதனால் அவன் எல்லா நாடுகளையும் தனக்கெனச் சேர்த்துக்கொள்கிறான்.","poem":1},{"text":"எல்லா மக்கள் கூட்டங்களையும் கைதிகளாகக் கொண்டுபோகிறான்.","poem":2}]},{"type":"verse","number":6,"content":["“அவர்கள் எல்லோரும் அவனை நிந்தித்து அவதூறு செய்து,",{"text":"“ ‘இவ்வாறு பழிசொல்லமாட்டார்களோ:","poem":1},{"text":"ஐயோ, களவாடிய பொருட்களைக் குவித்து,","poem":2},{"text":"பலவந்தமாய் பணம் பறித்து செல்வந்தனாகிற உனக்குக் கேடு,","poem":1},{"text":"எவ்வளவு காலத்துக்கு இது நடக்கப்போகிறது?’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உன் கடன்காரர்கள் திடீரென்று எழும்பமாட்டார்களோ?","poem":1},{"text":"அவர்கள் எழுந்து உன்னை நடுங்கவைக்கமாட்டார்களோ?","poem":2},{"lineBreak":true},{"text":"அப்பொழுது நீ அவர்களுடைய தண்டனைக்கு ஆளாவாயே.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பல நாடுகளை நீ கொள்ளையடித்ததினால்,","poem":1},{"text":"மீந்திருக்கும் மக்கள் கூட்டங்கள் உன்னைக் கொள்ளையடிப்பார்கள்.","poem":2},{"text":"ஏனெனில் நீ மனிதர்களின் இரத்தத்தைச் சிந்தினாய்;","poem":1},{"text":"நாடுகளையும், நகரங்களையும் அங்குள்ள அனைவரையும் அழித்தாயே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ஐயோ, அநியாயமான ஆதாயத்தினால் தன் வீட்டைக் கட்டுகிறவனுக்குக் கேடு,","poem":1},{"text":"அவன் அழிவின் பிடியிலிருந்து தப்பும்படி","poem":2},{"lineBreak":true},{"text":"தன் கூட்டை உயரத்தில் கட்டப் பார்க்கிறானே!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீ அநேக மக்கள் கூட்டங்களை அழிக்கும்படி சூழ்ச்சி செய்தாய்.","poem":1},{"text":"அதனால் உன் வீட்டிற்கு வெட்கத்தையும், உன் உயிருக்கு ஆபத்தையும் தேடிக் கொண்டாய்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உன் வீட்டுச் சுவரின் கற்கள் கூக்கூரலிடும்.","poem":1},{"text":"மரவேலைப்பாடுகள் உள்ள உத்திரங்கள் எதிரொலிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ஐயோ, இரத்தம் சிந்துவதினால் ஒரு நகரத்தைக் கட்டியெழுப்பி,","poem":1},{"text":"குற்றச் செயலால் ஒரு பட்டணத்தை நிலைநிறுத்துகிற பாபிலோனுக்குக் கேடு!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"சேனைகளின் யெகோவா,","poem":1},{"text":"மக்களின் உழைப்பு நெருப்புக்கான விறகாகும் என்றும்,","poem":2},{"lineBreak":true},{"text":"நாடுகளின் முடிவில்லாத உழைப்பு பயனற்றதாய் போகும் என்றும் அறிவிக்கிறாரே.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"கடல் தண்ணீரினால் நிறைந்திருப்பதுபோல,","poem":1},{"text":"பூமி யெகோவாவின் மகிமையைப்பற்றிய அறிவினால் நிறைந்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ஐயோ, தன் அயலவர்களுக்கு அவர்கள் வெறிக்கும்வரை","poem":1},{"text":"தோல் குடுவையிலிருந்து மதுவை ஊற்றிக் கொடுக்கிறவனுக்குக் கேடு,","poem":2},{"lineBreak":true},{"text":"அவன் அவர்களுடைய நிர்வாணங்களைப் பார்க்கும்படி இப்படிச் செய்கிறானே!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீ மகிமைக்குப் பதிலாய் வெட்கத்தினால் நிரப்பப்படுவாய்.","poem":1},{"text":"இப்பொழுது உன்னுடைய முறை வந்துவிட்டது!","poem":2},{"lineBreak":true},{"text":"நீயும் குடித்து உன் நிர்வாணத்தை வெளியே காட்டு!","poem":2},{"text":"யெகோவாவின் வலதுகையிலுள்ள தண்டனையின் கிண்ணம் உன்மேல் வருகிறது,","poem":1},{"text":"அப்பொழுது உன் மகிமையை அவமானம் மூடிவிடும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நீ லெபனோனுக்குச் செய்த கொடுமைகள் உன்னை மேற்கொள்ளும்.","poem":1},{"text":"நீ மிருகங்களுக்குச் செய்த பேரழிவு உனக்குத் திகிலூட்டும்.","poem":2},{"text":"ஏனெனில் நீ மனிதனுடைய இரத்தத்தைச் சிந்தினாய்;","poem":1},{"text":"நாடுகளையும், நகரங்களையும் அங்குள்ள அனைவரையும் அழித்தாயே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ஒரு விக்கிரகத்திற்கு என்ன மதிப்பு உண்டு, அதை மனிதன்தானே செதுக்கினான்?","poem":1},{"text":"பொய்களை போதிக்கும் ஒரு உருவச்சிலைக்கு என்ன மதிப்பு உண்டு?","poem":2},{"text":"ஏனென்றால் அதை செய்பவன், தான் உருவாக்கியதிலேயே நம்பிக்கையை வைக்கிறான்;","poem":1},{"text":"அவன் பேசமுடியாத விக்கிரகங்களைச் செய்கிறான்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ஐயோ, மரத்தால் செய்யப்பட்ட விக்கிரகத்தைப்பார்த்து, ‘உயிர் பெறு’ என்றும்,","poem":1},{"text":"உயிரற்ற சிலையைப்பார்த்து, ‘எழுந்திரு’ என்றும் சொல்கிற பாபிலோனுக்குக் கேடு!","poem":2},{"text":"இவற்றினால் வழிகாட்ட முடியுமா?","poem":1},{"text":"இவை தங்கத்தினாலும் வெள்ளியினாலும் மூடப்பட்டிருக்கின்றன;","poem":2},{"lineBreak":true},{"text":"இவற்றிலே சுவாசம் இல்லை.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஆனால் யெகோவாவோ தமது பரிசுத்த ஆலயத்தில் இருக்கிறார்;","poem":1},{"text":"பூமி முழுவதும் அவருக்குமுன் மவுனமாய் இருப்பதாக.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HAB/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HAB/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HAB/1.json","previousChapterAudioLinks":{},"numberOfVerses":20}