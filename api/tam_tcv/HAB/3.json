{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HAB","translationId":"tam_tcv","name":"ஆபகூக்","commonName":"ஆபகூக்","title":"ஆபகூக்","order":35,"numberOfChapters":3,"sha256":"ef056261566e714af903ae3e7055b251bc4578f2d6ad15bd01b54790f2f6e3c5","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HAB/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/HAB/3.json","totalNumberOfVerses":56},"chapter":{"number":3,"content":[{"type":"heading","content":["ஆபகூக்கின் மன்றாட்டு"]},{"type":"verse","number":1,"content":[{"text":"இறைவாக்கினன் ஆபகூக், பாடிய மன்றாட்டு.","descriptive":true}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே, உம்முடைய புகழைப்பற்றி நான் கேள்விப்பட்டிருக்கிறேன்,","poem":1},{"text":"யெகோவாவே, நீர் நடப்பித்த உம்முடைய செயல்களின் நிமித்தம்","poem":2},{"lineBreak":true},{"text":"நான் வியப்படைந்து நிற்கிறேன்.","poem":2},{"text":"எங்கள் நாட்களிலும் அவற்றைப் புதுப்பியும்,","poem":1},{"text":"எங்கள் காலத்திலும் அவற்றை அனைவரும் அறியும்படி செய்யும்;","poem":2},{"lineBreak":true},{"text":"உமது கோபத்திலும், எங்களுக்கு இரக்கத்தை நினைத்தருளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"இறைவன் தேமானிலிருந்தும்","poem":1},{"noteId":1},{"text":",","poem":1},{"text":"பரிசுத்தர் பாரான் மலையிலிருந்தும்","poem":2},{"noteId":2},{"text":"வந்தார்.","poem":2},{"text":"அவரது மகிமை, வானங்களை மூடியது;","poem":1},{"text":"அவரது துதி, பூமியை நிரப்பியது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவரின் மாட்சிமை சூரிய உதயத்தைப்போல் இருந்தது;","poem":1},{"text":"அவரது கையிலிருந்து ஒளிக்கதிர்கள் சுடர் வீசின,","poem":2},{"lineBreak":true},{"text":"அங்கே அவரது மகத்துவ வல்லமை மறைந்திருந்தது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கொள்ளைநோய் அவருக்கு முன்பாகச் சென்றது;","poem":1},{"text":"வாதைநோய் அவரது அடிச்சுவடுகளைப் பின்தொடர்ந்தது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் நின்று பூமியை அளந்தார்;","poem":1},{"text":"அவருடைய பார்வையைக் கண்டு நாடுகள் நடுங்கின.","poem":2},{"text":"பூர்வீக மலைகள் நொறுங்கின,","poem":1},{"text":"என்றுமுள்ள குன்றுகள் வீழ்ந்தன;","poem":2},{"lineBreak":true},{"text":"அவருடைய வழிகளோ நித்தியமானவை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கூசானின் கூடாரங்கள் துன்பத்திற்குள்ளானதையும்,","poem":1},{"text":"மீதியானியரின் குடியிருப்புகள் துயரத்திற்குள்ளானதையும் நான் கண்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவே ஆறுகளின்மேல், கோபங்கொண்டீரோ?","poem":1},{"text":"நீரோடைகளுக்கெதிராகவும் உமது கடுங்கோபமாக இருந்ததோ?","poem":2},{"text":"உமது குதிரைகள்மேலும்,","poem":1},{"text":"உமது வெற்றிகொண்ட தேரின்மேலும் நீர் சென்றபோது,","poem":2},{"lineBreak":true},{"text":"கடலுக்கு எதிராய் நீர் விரோதமாயிருந்தீரோ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீர் உமது வில்லை உறையிலிருந்து எடுத்து,","poem":1},{"text":"அநேக அம்புகளை எய்வதற்காகத் தொடுத்தீர்.","poem":2},{"text":"நீர் ஆறுகளைக் கொண்டு பூமியைப் பிளந்தீர்;","poem":1}]},{"type":"verse","number":10,"content":[{"text":"மலைகள் உம்மைக் கண்டு துடித்தன.","poem":2},{"text":"பெருவெள்ளம் அடித்துக் கொண்டோடியது;","poem":1},{"text":"ஆழம் குமுறியது,","poem":2},{"lineBreak":true},{"text":"அது தன் கைகளை அலைகளுக்கு மேலே உயர்த்தியது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"உமது அம்புகள் பறக்கும் மின்னொளியிலும்,","poem":1},{"text":"உமது ஈட்டிகள் வீசும் வெளிச்சத்திலும்,","poem":2},{"lineBreak":true},{"text":"சூரியனும் சந்திரனும் வானங்களில் அசைவற்று நின்றன.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"கடுங்கோபத்துடன் பூமியில் நீர் விரைந்து சென்றீர்.","poem":1},{"text":"கோபத்தில் பிற நாட்டு மக்களை மிதித்தீர்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"உமது மக்களை விடுதலை செய்யவும்,","poem":1},{"text":"அபிஷேகம் செய்யப்பட்டவரை காப்பாற்றவுமே நீர் வந்தீர்.","poem":2},{"text":"நீர் கொடுமை நிறைந்த நாட்டின் தலைவனை தாக்கினீர்.","poem":1},{"text":"நீர் அவனைத் தலையிலிருந்து கால்வரைக்கும் தண்டித்தீர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"மறைவிடத்தில் பதுங்கியிருக்கும் நிர்கதியானவர்களை விழுங்க வருவதுபோல,","poem":1},{"text":"அவனுடைய இராணுவவீரர் எங்களைச் சிதறடிக்கும்படி புயலைப்போல் வந்தார்கள்.","poem":2},{"text":"அப்பொழுது நீர் அவனுடைய சொந்த ஈட்டியினாலேயே","poem":1},{"text":"அவனுடைய சேனைகளின் அதிபதிகளை உருவக் குத்தினீர்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"கடலை உமது குதிரைகளினால் மிதித்து,","poem":1},{"text":"ஆற்றின் பெருவெள்ளத்தை பொங்கியெழப் பண்ணினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"நான் அந்த சத்தங்களைக் கேட்டபோது என் இருதயம் படபடத்தது.","poem":1},{"text":"அந்தச் சத்தத்தில் என் உதடு துடித்தது;","poem":2},{"text":"என் எலும்புகளில் பெலவீனம் உண்டானது;","poem":1},{"text":"என் கால்கள் நடுங்கின. எனினும் எங்கள்மேல் படையெடுத்த,","poem":2},{"text":"நாட்டின்மேல் வரப்போகும் பேரழிவின் நாளுக்காக,","poem":1},{"text":"நான் பொறுமையுடன் காத்திருப்பேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அத்திமரம் துளிர்விடாமல் போனாலும்,","poem":1},{"text":"திராட்சைக்கொடிகளில் பழங்கள் இல்லாமல் போனாலும்,","poem":2},{"text":"ஒலிவமரம் பலன் அற்றுப்போனாலும்,","poem":1},{"text":"வயல்கள் தானியத்தை விளைவியாமல் போனாலும்,","poem":2},{"text":"ஆட்டுத் தொழுவத்திலே செம்மறியாடுகள் இல்லாமல் போனாலும்,","poem":1},{"text":"மாட்டுத் தொழுவத்திலே மாடுகள் இல்லாமல் போனாலும்,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நானோ என் யெகோவாவிடம் மகிழ்ந்திருப்பேன்,","poem":1},{"text":"என் இரட்சகராகிய இறைவனில் களிகூருவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ஆண்டவராகிய யெகோவாவே என் பெலன்;","poem":1},{"text":"என் கால்களை அவர் மானின் கால்களைப் போலாக்குகிறார்,","poem":2},{"lineBreak":true},{"text":"என்னை உயர்ந்த இடங்களில் நடக்கப் பண்ணுகிறார்.","poem":2},{"text":"எனது கம்பியிசைக் கருவிகளில், இசை இயக்குனருக்காக இசைக்கப்பட்டது.","descriptive":true}]}],"footnotes":[{"noteId":1,"caller":"+","text":"யூதான் தெற்கு திசையில் இருந்த ஏதோம் நாட்டின் ஒரு மாவட்டம் தேமன்","reference":{"chapter":3,"verse":3}},{"noteId":2,"caller":"+","text":"பரான் மலை சீனாயின் பிரதேசத்தில் ஒரு தரிசு இடமாக இருந்தது","reference":{"chapter":3,"verse":3}}]},"thisChapterLink":"/api/tam_tcv/HAB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ZEP/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HAB/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}