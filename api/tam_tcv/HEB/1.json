{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HEB","translationId":"tam_tcv","name":"எபிரெயர்","commonName":"எபிரெயர்","title":"எபிரெயருக்கு எழுதின கடிதம்","order":58,"numberOfChapters":13,"sha256":"0b4a605d818457bd07ef1b80daf98b4b6269cc82ec3ec917bda55dbfa73f85f0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/tam_tcv/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["இறைவனின் கடைசி வார்த்தை: அவருடைய மகன்"]},{"type":"verse","number":1,"content":["முற்காலத்தில் இறைவன் பலமுறை, வெவ்வேறு விதங்களில் இறைவாக்கினர்கள் மூலமாய் நமது முற்பிதாக்களுடன் பேசினார்."]},{"type":"verse","number":2,"content":["ஆனால் இந்தக் கடைசி நாட்களில் அவர் தமது மகன் மூலமாகவே நம்மோடு பேசியுள்ளார். இவரையே இறைவன் எல்லாவற்றிற்கும் உரிமையாளராய் நியமித்திருக்கிறார். இவர் மூலமாகவே இறைவன் அண்ட சராசரங்களையும் படைத்தார்."]},{"type":"verse","number":3,"content":["இறைவனுடைய மகனே அவருடைய மகிமையின் ஒளியாயும், அவருடைய தன்மையின் ரூபமாயும் இருக்கிறார். இந்த கிறிஸ்துவே தம்முடைய வல்லமையான வார்த்தையினாலே எல்லாவற்றையும் தாங்குகிறார். இவர் பாவங்களுக்கான சுத்திகரிப்பை ஏற்படுத்தி முடித்தபின்பு, பரலோகத்தில் உன்னதமான இறைவனுடைய வலதுபக்கத்தில்",{"noteId":0},"உட்கார்ந்திருக்கிறார்."]},{"type":"verse","number":4,"content":["இவ்விதமாய் இறைவனின் மகனாகிய கிறிஸ்து இறைத்தூதர்களிலும் மேன்மையானவர் ஆனார். இவருக்கு இறைவன் கொடுத்த பெயரும் இறைத்தூதர்களின் பெயரிலும் மேன்மையானதே."]},{"type":"heading","content":["மகன் இறைத்தூதர்களிலும் மேன்மையானவர்"]},{"type":"verse","number":5,"content":["ஏனெனில் இறைவன் இறைத்தூதர்களில் யாரையாவது பார்த்து எப்பொழுதாவது இவ்வாறு சொல்லியிருக்கிறாரா?",{"text":"“நீர் என்னுடைய மகன்;","poem":1},{"text":"இன்று நான் உமக்குத் தந்தையானேன்”","poem":2},{"noteId":1},"அல்லது,",{"text":"“நான் இவருடைய தந்தையாயிருப்பேன்;","poem":1},{"text":"அவர் என்னுடைய மகனாயிருப்பார்.”","poem":2},{"noteId":2}]},{"type":"verse","number":6,"content":["மேலும், இறைவன் தம்முடைய முதற்பேறானவரை உலகத்திற்குள் கொண்டுவந்தபோது அவர் கூறியது,",{"text":"“இறைவனுடைய தூதர்கள் எல்லோரும் அவரை வழிபடவேண்டும்.”","poem":1},{"noteId":3}]},{"type":"verse","number":7,"content":["ஆனால் இறைத்தூதர்களைக்குறித்து பேசும்போது இறைவன் சொல்லுகிறதாவது,",{"text":"“அவர் தம்முடைய இறைத்தூதர்களைக் காற்றுகளாகவும்,","poem":1},{"text":"தம்முடைய ஊழியர்களை நெருப்பு ஜுவாலைகளாகவும் ஆக்குகிறார்.”","poem":2},{"noteId":4}]},{"type":"verse","number":8,"content":["ஆனால் தம்முடைய மகனைக் குறித்தோ அவர் சொல்கிறதாவது,",{"text":"“இறைவனே, உம்முடைய அரியணை என்றென்றுமாய் நிலைத்திருக்கும்.","poem":1},{"text":"நீதியே உம்முடைய அரசின் செங்கோலாயிருக்கும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீர் நீதியை விரும்பி, அநீதியை வெறுத்தீர்;","poem":1},{"text":"ஆகையால் இறைவனே, உமது இறைவனே உம்மை மகிழ்ச்சியின் எண்ணெயால் அபிஷேகித்து,","poem":2},{"lineBreak":true},{"text":"உமது தோழர்களுக்கு மேலாக உம்மை உயர்த்திவைத்தார்.”","poem":2},{"noteId":5}]},{"type":"verse","number":10,"content":["இறைவன் மேலும் சொன்னதாவது,",{"text":"“நீர் ஆதியிலே பூமிக்கு அஸ்திபாரங்களை அமைத்தீர்;","poem":1},{"text":"வானங்களும் உமது கரங்களின் வேலைப்பாடாய் இருக்கின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவை அழிந்துபோகும்; நீரோ நிலைத்திருப்பீர்;","poem":1},{"text":"அவையெல்லாம் உடையைப்போல பழமையாய்ப்போகும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவற்றை ஒரு மேலுடையைப்போல் நீர் சுருட்டிவைப்பீர்;","poem":1},{"text":"அவை ஒரு உடையைப்போல் மாற்றப்படும்.","poem":2},{"text":"நீரோ மாறாதவராய் நிலைத்திருக்கிறீர்.","poem":1},{"text":"உம்முடைய வருடங்கள் ஒருபோதும் முடிந்து போவதில்லை.”","poem":2},{"noteId":6}]},{"type":"verse","number":13,"content":["மேலும், இறைவன் இறைத்தூதர்களில் யாரையாவது பார்த்து எப்பொழுதாவது,",{"text":"“நான் உமது பகைவரை","poem":1},{"text":"உமது கால்களுக்குப் பாதபடியாக்கும்வரை","poem":2},{"lineBreak":true},{"text":"நீர் என் வலதுபக்கத்தில் அமர்ந்திரும்”","poem":2},{"noteId":7},"என்று சொல்லியிருக்கிறாரா?"]},{"type":"verse","number":14,"content":["இறைத்தூதர்களெல்லோரும் ஊழியம் செய்யும் ஆவிகள் அல்லவா? இரட்சிப்பை உரிமையாக்கிக்கொள்ளப் போகிறவர்களுக்குப் பணிசெய்யும்படி அனுப்பப்பட்டவர்களல்லவா?"]}],"footnotes":[{"noteId":0,"caller":"+","text":"அதிகாரத்தின் இடம்","reference":{"chapter":1,"verse":3}},{"noteId":1,"caller":"+","text":"சங். 2:7","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"2 சாமு. 7:14; 1 நாளா. 17:13","reference":{"chapter":1,"verse":5}},{"noteId":3,"caller":"+","text":"உபா. 32:43(எபிரெய வேதத்தின் கிரேக்க கையெழுத்துப் பிரதியைப் பார்க்கவும்)","reference":{"chapter":1,"verse":6}},{"noteId":4,"caller":"+","text":"சங். 104:4","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"சங். 45:6,7","reference":{"chapter":1,"verse":9}},{"noteId":6,"caller":"+","text":"சங். 102:25-27","reference":{"chapter":1,"verse":12}},{"noteId":7,"caller":"+","text":"சங். 110:1","reference":{"chapter":1,"verse":13}}]},"thisChapterLink":"/api/tam_tcv/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}