{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"இஸ்ரயேல் ஒரு படரும் திராட்சைக்கொடி,","poem":1},{"text":"அவன் தனக்கென கனிகொடுக்கிறது.","poem":2},{"text":"அவனுடைய கனிகள் பெருகியபோது,","poem":1},{"text":"அதற்கேற்ற மிகுதியான பலிபீடங்களைக் கட்டினான்.","poem":2},{"text":"அவனுடைய நாடு செழித்தபோது,","poem":1},{"text":"தனது புனிதக் கற்களை நன்றாக அலங்கரித்தான்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர்கள் இருதயம் வஞ்சனையுள்ளது.","poem":1},{"text":"இப்பொழுது அவர்கள் தங்கள் குற்றத்தைச் சுமக்கவேண்டும்.","poem":2},{"text":"யெகோவா அவர்களுடைய மேடைகளை இடித்து,","poem":1},{"text":"புனிதக் கற்களை அழித்துப்போடுவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"அப்பொழுது அவர்கள், “நாங்கள் யெகோவாவிடம் பயபக்தியாயிருக்காதபடியால்,","poem":1},{"text":"எங்களுக்கு அரசன் இல்லை;","poem":2},{"text":"அரசன் இருந்தாலுங்கூட,","poem":1},{"text":"அவனால் எங்களுக்காக என்ன செய்யமுடியும்?” எனச் சொல்வார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் அநேக வாக்குத்தத்தங்களைக் கொடுக்கிறார்கள்,","poem":1},{"text":"பொய் சத்தியங்களையும்","poem":2},{"lineBreak":true},{"text":"ஒப்பந்தங்களையும் செய்கிறார்கள்;","poem":2},{"text":"எனவே உழுத வயலில் உள்ள நச்சுப் பயிரைப்போல்","poem":1},{"text":"வழக்குகள் தோன்றுகின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"சமாரியாவில் வாழ்கிற மக்கள்","poem":1},{"text":"பெத்தாவேனில் இருக்கிற கன்றுக்குட்டி விக்கிரகத்திற்குப் பயப்படுகிறார்கள்.","poem":2},{"text":"அது அவர்களிடமிருந்து எடுக்கப்பட்டு,","poem":1},{"text":"நாடுகடத்தப்படும்.","poem":2},{"text":"அதன் மக்கள் அதற்காகத் துக்கங்கொண்டாடுவார்கள்;","poem":1},{"text":"அதன் மகிமையில் மகிழ்ச்சிகொண்ட விக்கிரக பூசாரிகளும் துக்கங்கொண்டாடுவார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அது அசீரியாவின் பேரரசனுக்குக் கப்பமாக","poem":1},{"text":"அங்கு கொண்டுபோகப்படும்.","poem":2},{"text":"அதைக்குறித்து எப்பிராயீம் அவமானமடையும்.","poem":1},{"text":"இஸ்ரயேல் தன் சொந்த ஆலோசனையினால் வெட்கமடையும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"சமாரியாவும் அதன் அரசனும்","poem":1},{"text":"தண்ணீரில் மிதக்கும் குச்சியைப்போல் அள்ளுண்டு போவார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"இஸ்ரயேலின் வேறு தெய்வங்களுக்குப் பலியிட்ட மேடைகள் அழிக்கப்படும்;","poem":1},{"text":"இதுவே இஸ்ரயேலின் பாவம்.","poem":2},{"text":"முட்செடிகளும் நெருஞ்சில்களும் வளர்ந்து","poem":1},{"text":"அதன் மேடைகளை மூடும்.","poem":2},{"text":"அப்பொழுது அவர்கள் மலைகளைப் பார்த்து, “எங்களை மூடுங்கள்!” என்றும்,","poem":1},{"text":"குன்றுகளைப் பார்த்து, “எங்கள்மேல் விழுங்கள்!” என்றும் சொல்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"இஸ்ரயேலே, கிபியாவின் நாட்கள் தொடங்கி நீ பாவம் செய்தாய்;","poem":1},{"text":"அதிலேயே நீ இன்னும் நிலைகொண்டிருக்கிறாய்.","poem":2},{"text":"கிபியாவிலே தீமை செய்தவர்கள்மேல்","poem":1},{"text":"யுத்தம் வரவில்லையோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆகவே நான் விரும்புகின்றபோது உன்னைத் தண்டிப்பேன்;","poem":1},{"text":"உங்கள் இரட்டிப்பான பாவங்களுக்காக உங்களை விலங்கிடுவதற்கென,","poem":2},{"lineBreak":true},{"text":"பிறநாடுகள் உங்களுக்கு விரோதமாய் ஒன்றுகூடும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எப்பிராயீம் சூடு அடிக்க விரும்புகின்ற","poem":1},{"text":"பயிற்றுவிக்கப்பட்ட கன்னிப்பசு.","poem":2},{"text":"நான் அதன் கழுத்தின்மேல் பாரத்தை வைக்கவில்லை.","poem":1},{"text":"ஆனால் இப்பொழுது நான் அதன் அழகான கழுத்தின்மேல் ஒரு நுகத்தை வைப்பேன்.","poem":2},{"text":"நான் எப்பிராயீமை கடுமையான வேலைக்கு நடத்துவேன்;","poem":1},{"text":"யூதாவும் நிலத்தை உழவேண்டும்,","poem":2},{"lineBreak":true},{"text":"யாக்கோபின் எல்லா மக்களும் நிலத்தின் மண் கட்டிகளை உடைக்கவேண்டும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உங்கள் இருதயங்கள் உழப்படாத வயல்போல் கடினமாயிருக்கிறதே;","poem":1},{"text":"ஆகவே உங்களுக்கென நீதியை விதையுங்கள்,","poem":2},{"text":"அன்பின் பலனை அறுவடை செய்யுங்கள்.","poem":1},{"text":"உழப்படாத உங்கள் நிலங்களைக் கொத்துங்கள்,","poem":2},{"text":"ஏனெனில் யெகோவா வந்து உங்கள்மேல் நியாயத்தை பொழியும் வரைக்கும்","poem":1},{"text":"இது யெகோவாவைத் தேடும் காலமாயிருக்கிறது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆனால் நீங்கள் கொடுமையை உழுதீர்கள்,","poem":1},{"text":"தீமையை அறுவடை செய்தீர்கள்,","poem":2},{"lineBreak":true},{"text":"வஞ்சனையின் பலனை சாப்பிட்டீர்கள்.","poem":2},{"text":"ஏனெனில், நீங்கள் உங்கள் சொந்த பெலத்திலும்,","poem":1},{"text":"உங்கள் அநேக போர் வீரர்களிலும் நம்பிக்கையாயிருந்தீர்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அதனால் உங்கள் மக்களுக்கு எதிராக யுத்தம் எழும்பும்,","poem":1},{"text":"உங்கள் கோட்டைகளெல்லாம் அழிக்கப்படும்.","poem":2},{"text":"யுத்தநாளில் பெத்தார்பேலை சல்மான் அழித்தபோது,","poem":1},{"text":"தாய்மார் தங்கள் பிள்ளைகளுடன் தரையில் மோதி அடிக்கப்பட்டதுபோல இதுவும் இருக்கும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"பெத்தேலே, உனது கொடுமை பெரிதாயிருப்பதனால்","poem":1},{"text":"உனக்கு இப்படி நடக்கும்.","poem":2},{"text":"அந்த நாள் வருகிறபோது,","poem":1},{"text":"இஸ்ரயேலின் அரசன் முற்றிலும் அழிக்கப்படுவான்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}