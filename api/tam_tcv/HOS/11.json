{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":11,"content":[{"type":"heading","content":["யெகோவா இஸ்ரயேலில் அன்பாயிருத்தல்"]},{"type":"verse","number":1,"content":[{"text":"“இஸ்ரயேல் சிறுவனாக இருந்தபோதே, நான் அவனை நேசித்தேன்;","poem":1},{"text":"எகிப்திலிருந்து நான் என் மகனை அழைத்தேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஆனால், எவ்வளவு அதிகமாய் நான் அவர்களை அழைத்தேனோ,","poem":1},{"text":"அவ்வளவு அதிகமாய் அவர்கள் என்னைவிட்டுத் தூரமானார்கள்.","poem":2},{"text":"அவர்கள் பாகால் தெய்வங்களுக்குப் பலியிட்டு,","poem":1},{"text":"உருவச் சிலைகளுக்குத் தூபங்காட்டினார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எப்பிராயீமைக் கைபிடித்து","poem":1},{"text":"நடக்கக் கற்றுக்கொடுத்தவர் நானே;","poem":2},{"text":"ஆனாலும், அவர்களைப் பராமரித்தவர் நானே","poem":1},{"text":"என்பதை அவர்கள் உணரவில்லை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் அவர்களை அன்பின் பிணைப்பினாலும்","poem":1},{"text":"மனித தயவின் கயிறுகளினாலும் வழிநடத்தினேன்.","poem":2},{"text":"ஒரு சிறு குழந்தையை கன்னத்தில் தூக்கும் ஒருவரைப்போல இருந்தேன்,","poem":1},{"text":"அவர்களுடைய கழுத்திலிருந்த நுகத்தை அகற்றினேன்,","poem":2},{"lineBreak":true},{"text":"அவர்களுக்குக் குனிந்து உணவூட்டினேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ஆனால் அவர்கள் மனந்திரும்ப மறுக்கிறார்கள்.","poem":1},{"text":"ஆகையால் அவர்கள் எகிப்திற்கு திரும்பிப் போகமாட்டார்களோ?","poem":2},{"lineBreak":true},{"text":"அவர்கள்மேல் அசீரியா ஆளுகை செய்யாதோ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நிச்சயமாக அவர்களுடைய தீமையான திட்டங்களினால்","poem":1},{"text":"வாள் அவர்களுடைய பட்டணங்களுக்குள் பாய்ந்து,","poem":2},{"lineBreak":true},{"text":"வாசல் கதவுகளின் தாழ்ப்பாள்களை முறித்துப்போட்டு, அவர்களை அழிக்கும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் மக்கள் என்னைவிட்டு விலகிப்போகத் தீர்மானித்திருக்கிறார்கள்.","poem":1},{"text":"அவர்கள் என்னை உன்னதமானவர் எனக் கூப்பிட்டாலும்,","poem":2},{"lineBreak":true},{"text":"அவர்களை எவ்விதத்திலும் உயர்த்தமாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ஆனாலும் எப்பிராயீமே, எப்படி நான் உன்னைக் கைவிடுவேன்?","poem":1},{"text":"இஸ்ரயேலே, நான் உன்னை எப்படி ஒப்புக்கொடுப்பேன்?","poem":2},{"text":"நான் எப்படி உன்னை அத்மா பட்டணத்தைப்போல் அழிக்கமுடியும்?","poem":1},{"text":"நான் எப்படி உன்னை செபோயீமைப்போல் ஆக்கமுடியும்?","poem":2},{"text":"என் இருதயமோ எனக்குள் மாற்றமடைந்திருக்கிறது;","poem":1},{"text":"என் கருணை பொங்குகிறது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஆகவே எனது கடுங்கோபத்தை செயல்படுத்தமாட்டேன்;","poem":1},{"text":"நான் திரும்பி எப்பிராயீமை அழிக்கமாட்டேன்.","poem":2},{"text":"ஏனெனில் எப்படியிருந்தும் உங்கள் மத்தியில் வாழ்கின்ற பரிசுத்தரான நான் மனிதனல்ல;","poem":1},{"text":"நான் இறைவன்.","poem":2},{"lineBreak":true},{"text":"எனவே நான் கடுங்கோபத்துடன் வரமாட்டேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஒருகாலத்தில் அவர்கள் யெகோவாவைப் பின்பற்றுவார்கள்;","poem":1},{"text":"அவர் சிங்கத்தைப்போல் கர்ஜிப்பார்.","poem":2},{"text":"அவர் கர்ஜிக்கும்போது,","poem":1},{"text":"அவருடைய பிள்ளைகள் மேற்குத் திசையிலிருந்து நடுக்கத்துடன் வருவார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எகிப்திலிருந்து பறவைகள் வருவதுபோலவும்,","poem":1},{"text":"அசீரியாவிலிருந்து புறாக்கள் வருவதுபோலவும்","poem":2},{"lineBreak":true},{"text":"அவர்கள் நடுக்கத்துடன் வருவார்கள்.","poem":2},{"text":"நான் அவர்களை அவர்களுடைய வீடுகளில் குடியமர்த்துவேன்”","poem":1},{"text":"என யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"heading","content":["இஸ்ரயேலின் பாவம்"]},{"type":"verse","number":12,"content":[{"text":"எப்பிராயீமியர் பொய்களுடனும்,","poem":1},{"text":"இஸ்ரயேல் குடும்பம் வஞ்சனையுடனும் என்னைச் சூழ்ந்துகொண்டிருக்கின்றனர்.","poem":2},{"text":"யூதாவும் உண்மையுள்ள,","poem":1},{"text":"பரிசுத்தரான இறைவனுக்கு எதிராக அடங்காமல் எதிர்த்து நிற்கிறான்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}