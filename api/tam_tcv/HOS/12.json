{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"எப்பிராயீம் காற்றை மேய்கிறான்,","poem":1},{"text":"நாள்முழுவதும் கொண்டற்காற்றைப் பின்தொடர்ந்து செல்கிறான்.","poem":2},{"lineBreak":true},{"text":"பொய்களையும், வன்செயல்களையும் பெருகப்பண்ணுகிறான்.","poem":2},{"text":"அவன் அசீரியாவோடு ஒப்பந்தம் செய்கிறான்;","poem":1},{"text":"எகிப்திற்கு ஒலிவ எண்ணெய் அனுப்புகிறான்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யூதாவுக்கு எதிரான ஒரு குற்றச்சாட்டு யெகோவாவிடம் இருக்கிறது.","poem":1},{"text":"யாக்கோபின் மக்களை அவர்களுடைய வழிகளுக்குத்தக்கதாக அவர் தண்டிப்பார்;","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய செயல்களுக்கேற்றபடி அவர்களுக்குப் பிரதிபலன் செய்வார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யாக்கோபு தாயின் கர்ப்பத்திலேயே,","poem":1},{"text":"தனது சகோதரனின் குதிங்காலைப் பிடித்துக்கொண்டான்;","poem":2},{"lineBreak":true},{"text":"மனிதனானபோது இறைவனோடு போராடினான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவன் தூதனுடனும் போராடி வெற்றிகொண்டான்;","poem":1},{"text":"அவன் அவருடைய தயவுக்காக அழுது மன்றாடினான்.","poem":2},{"text":"இறைவன் அவனைப் பெத்தேலில் கண்டு,","poem":1},{"text":"அங்கே நம்முடன் பேசினார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"சேனைகளின் இறைவனாகிய யெகோவா அவரே;","poem":1},{"text":"யெகோவா என்பது அவரது புகழ்வாய்ந்த பெயர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யாக்கோபின் மக்களே, நீங்கள் எல்லோரும் இறைவனிடம் திரும்பிவாருங்கள்.","poem":1},{"text":"அன்பையும் நீதியையும் கடைபிடியுங்கள்;","poem":2},{"lineBreak":true},{"text":"எப்பொழுதும் உங்கள் இறைவனுக்காகக் காத்திருங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஆனால் இப்பொழுது நீங்கள் கள்ளத்தராசுகளைப் பயன்படுத்துகிற","poem":1},{"text":"வியாபாரிபோல் இருக்கிறீர்கள்;","poem":2},{"lineBreak":true},{"text":"அவன் ஏமாற்றுவதையே விரும்புகிறான்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அத்துடன் எப்பிராயீமோ,","poem":1},{"text":"“நான் மிகவும் பணக்காரன்; நான் செல்வந்தனாகிவிட்டேன்.","poem":2},{"text":"என் செல்வத்தினிமித்தம் அவர்கள் என்னில்","poem":1},{"text":"அநியாயத்தையோ, பாவத்தையோ கண்டுபிடிக்க முடியாது என்று பெருமைப்படுகிறான்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“உங்களை எகிப்திலிருந்து வெளியே கொண்டுவந்த","poem":1},{"text":"உங்கள் இறைவனாகிய யெகோவா நானே.","poem":2},{"text":"நான் உங்களது நியமிக்கப்பட்ட பண்டிகையின் நாட்களில் இருப்பதுபோல,","poem":1},{"text":"நான் திரும்பவும் உங்களைக் கூடாரங்களில் குடியிருக்கப்பண்ணுவேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அத்துடன் நான் இறைவாக்கினருடன் பேசி,","poem":1},{"text":"அவர்களுக்கு அநேக தரிசனங்களைக் கொடுத்தேன்;","poem":2},{"lineBreak":true},{"text":"அவர்களைக்கொண்டு உவமைகளினால் பேசினேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"கீலேயாத் கொடுமையானதா?","poem":1},{"text":"அதன் மக்கள் ஒன்றுக்கும் உதவாதவர்கள்;","poem":2},{"text":"கில்காலில் காளைகளைப் பலியிடுகிறார்களா?","poem":1},{"text":"அவர்களுடைய பலிபீடங்கள் உழுத வயலிலுள்ள","poem":2},{"lineBreak":true},{"text":"கற்குவியலைப்போல் ஆகும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"யாக்கோபு ஆராமுக்கு ஓடிப்போனான்;","poem":1},{"text":"இஸ்ரயேல் தனக்கு மனைவியைப் பெறுவதற்காக வேலைசெய்தான்;","poem":2},{"lineBreak":true},{"text":"அவளுக்கான பணத்தைக் கொடுப்பதற்கு செம்மறியாடுகளை மேய்த்தான்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவா இறைவாக்கினன் ஒருவனை அனுப்பி,","poem":1},{"text":"இஸ்ரயேலரை எகிப்திலிருந்து வெளியே கொண்டுவந்தார்;","poem":2},{"lineBreak":true},{"text":"இறைவாக்கினன் மூலம் இஸ்ரயேலரை பராமரித்தார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஆயினும் எப்பிராயீம் யெகோவாவுக்குக் கசப்பாகக் கோபமூட்டியிருக்கிறான்;","poem":1},{"text":"எனவே அவனுடைய யெகோவா, அவனுடைய இரத்தப்பழியை அவன் மேலேயே சுமத்துவார்.","poem":2},{"lineBreak":true},{"text":"அவன் காட்டிய அவமதிப்புக்குத்தக்கதாய் அவனுக்குப் பதில் செய்வார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}