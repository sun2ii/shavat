{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":13,"content":[{"type":"heading","content":["இஸ்ரயேலுக்கு எதிரான யெகோவாவின் கோபம்"]},{"type":"verse","number":1,"content":[{"text":"முன்பு எப்பிராயீம் பேசியபோது மனிதர் நடுங்கினார்கள்;","poem":1},{"text":"அவன் இஸ்ரயேலில் மேன்மை அடைந்திருந்தான்.","poem":2},{"lineBreak":true},{"text":"ஆனால் பாகாலை வணங்கிய குற்றத்தினால் அழிந்துபோனான்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இப்பொழுதோ அவர்கள் அதிகமதிகமாகப் பாவம் செய்கிறார்கள்,","poem":1},{"text":"அவர்கள் தங்கள் வெள்ளியினாலேயே தங்களுக்கென விக்கிரகங்களைச் செய்கிறார்கள்.","poem":2},{"text":"திறமையாய் வடிவமைக்கப்பட்ட அந்த உருவச்சிலைகள் யாவும்","poem":1},{"text":"கைவினைஞனின் வேலைப்பாடாய் இருக்கின்றன.","poem":2},{"text":"இந்த மக்களைக் குறித்து,","poem":1},{"text":"“அவர்கள் மனித பலிகளைச் செலுத்துகிறார்கள்.","poem":2},{"lineBreak":true},{"text":"கன்றுக்குட்டி விக்கிரகத்தை முத்தமிடுகிறார்கள் எனச் சொல்லப்படுகிறது.”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஆகவே, அவர்கள் காலை நேர மூடுபனிபோலவும்,","poem":1},{"text":"அதிகாலைப் பனிபோலவும் மறைந்துபோவார்கள்,","poem":2},{"lineBreak":true},{"text":"சூடடிக்கும் களத்திலிருந்து பறக்கும் பதரைப்போலவும்","poem":2},{"lineBreak":true},{"text":"புகைபோக்கியினூடாகப் போகும் புகையைப்போலவும் இருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“உங்களை எகிப்திலிருந்து வெளியே கொண்டுவந்த","poem":1},{"text":"உங்கள் இறைவனாகிய யெகோவா நானே;","poem":2},{"text":"என்னைத்தவிர வேறு இறைவனையும்,","poem":1},{"text":"என்னைத்தவிர வேறு இரட்சகரையும் நீங்கள் அறியவேண்டாம்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"மிகவும் வெப்பம் நிறைந்த தேசமான","poem":1},{"text":"பாலைவனத்தில் நான் அவர்களைப் பாதுகாத்தேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் அவர்களுக்கு உணவு கொடுத்தபோது,","poem":1},{"text":"அவர்கள் திருப்தியடைந்தார்கள்; அவர்கள் திருப்தியடைந்ததும் பெருமை கொண்டார்கள்.","poem":2},{"lineBreak":true},{"text":"அதன்பின் அவர்கள் என்னை மறந்துவிட்டார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆகவே நான் அவர்களுக்கு சிங்கத்தைப்போல் இருப்பேன்;","poem":1},{"text":"அவர்களுடைய வழியின் அருகே சிறுத்தையைப்போல் பதுங்கியிருப்பேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"தன் குட்டியை இழந்த கரடியைப்போல்","poem":1},{"text":"நான் அவர்களைத் தாக்கிக் கிழிப்பேன்;","poem":2},{"text":"சிங்கத்தைப்போல் நான் அவர்களை விழுங்குவேன்,","poem":1},{"text":"காட்டுமிருகம் அவர்களைக் கிழித்துப்போடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“இஸ்ரயேலே, உனது உதவியாளரான எனக்கு நீ விரோதமாயிருக்கிறபடியால்,","poem":1},{"text":"நீ அழிவை உண்டாக்கிக்கொண்டாய்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆனால் உன்னைக் காப்பாற்றுவதற்கு உன் அரசன் எங்கே?","poem":1},{"text":"‘எனக்கு அரசர்களையும் இளவரசர்களையும் கொடும்’","poem":2},{"text":"என்று கேட்டாயே.","poem":1},{"text":"உன் பட்டணத்திலுள்ள உன்னுடைய அந்த ஆளுநர்கள் எங்கே?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எனது கோபத்தில் நான் உனக்கு அரசனைக் கொடுத்தேன்;","poem":1},{"text":"பின்பு நான் எனது கோபத்தில் அவனை எடுத்துக்கொண்டேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"எப்பிராயீமின் குற்றங்கள் சேர்த்து வைக்கப்பட்டிருக்கின்றன;","poem":1},{"text":"அவனது பாவங்கள் குறிப்பேட்டில் எழுதப்பட்டுள்ளன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"பிள்ளை பெறுகிற பெண்ணின் வேதனைக்கொத்த வேதனை அவனுக்கு வருகிறது;","poem":1},{"text":"அவன் ஞானமில்லாத பிள்ளை;","poem":2},{"text":"பிறக்கும் நேரம் வந்தும்","poem":1},{"text":"அவன் கருப்பையைவிட்டு வெளியே வராதிருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“நான் அவர்களைப் பாதாளத்தின் வல்லமையினின்றும் விடுவிப்பேன்;","poem":1},{"text":"மரணத்தினின்று மீட்டுக்கொள்வேன்.","poem":2},{"text":"மரணமே, உன் வாதைகள் எங்கே?","poem":1},{"text":"பாதாளமே, உன் அழிவு எங்கே?","poem":2},{"lineBreak":true},{"text":"“இரக்கத்தை என் கண்களில் நான் காண்பிக்கமாட்டேன்.","poem":1}]},{"type":"verse","number":15,"content":[{"text":"இவன் சகோதரரின் மத்தியில் செழித்தோங்கி இருப்பினும்,","poem":2},{"text":"யெகோவாவிடமிருந்து ஒரு கீழ்க்காற்று","poem":1},{"text":"பாலைவனத்திலிருந்து பலமாக வீசும்.","poem":2},{"text":"அப்பொழுது உனது நீரூற்று வறண்டு,","poem":1},{"text":"கிணறுகள் காய்ந்து போகும்.","poem":2},{"text":"உனது களஞ்சியத்திலிருந்து உனது திரவியங்கள்","poem":1},{"text":"எல்லாம் கொள்ளையடிக்கப்படும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"சமாரியர் தமது இறைவனுக்கு எதிராகக் கலகம் செய்தபடியினால்,","poem":1},{"text":"அவர்கள் தங்கள் குற்றத்தைச் சுமக்கவேண்டும்.","poem":2},{"text":"அவர்கள் வாளுக்கு இரையாவார்கள்;","poem":1},{"text":"அவர்களுடைய குழந்தைகள் நிலத்தில் மோதியடிக்கப்படுவார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய கர்ப்பவதிகள் கிழித்தெறியப்படுவார்கள்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}