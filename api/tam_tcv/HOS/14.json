{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":14,"content":[{"type":"heading","content":["மனந்திரும்புதலின் ஆசீர்வாதம்"]},{"type":"verse","number":1,"content":[{"text":"இஸ்ரயேலே, உன் இறைவனாகிய யெகோவாவிடம் திரும்பு;","poem":1},{"text":"உன் பாவங்களே நீ விழுந்துபோவதற்குக் காரணமாய் அமைந்தன.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீங்கள் உங்கள் வேண்டுதல்களுடன்","poem":1},{"text":"யெகோவாவிடம் திரும்புங்கள்;","poem":2},{"text":"நீங்கள் அவரிடம்,","poem":1},{"text":"“எங்கள் பாவங்களையெல்லாம் மன்னியும்,","poem":2},{"text":"எங்களை கிருபையாய் ஏற்றுக்கொள்ளும்;","poem":1},{"text":"அப்பொழுது நாங்கள் எங்கள் உதடுகளின் துதியை","poem":2},{"lineBreak":true},{"text":"காளைகளின் பலியாய் செலுத்துவோம் என்று சொல்லுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அசீரியா நாடு எங்களைக் காப்பாற்றமாட்டாது;","poem":1},{"text":"நாங்கள் போர்க் குதிரைகளில் ஏறமாட்டோம்.","poem":2},{"text":"எங்கள் கைகளினால் நாங்கள் செய்த விக்கிரகங்களை","poem":1},{"text":"‘எங்கள் தெய்வம்’ என இனி ஒருபோதும் சொல்லமாட்டோம்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் உம்மிடமே திக்கற்றவர்கள் கருணை பெறுகிறார்கள் என்று கூறுங்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“நான் அவர்களுடைய பின்மாற்றத்தைக் குணமாக்குவேன்,","poem":1},{"text":"நான் அவர்களில் அதிகமாய் அன்பு செலுத்துவேன்,","poem":2},{"lineBreak":true},{"text":"எனது கோபம் அவர்களைவிட்டு நீங்கிற்று.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நான் இஸ்ரயேலுக்குப் பனிபோல் இருப்பேன்;","poem":1},{"text":"அவன் லில்லியைப்போல் பூப்பான்.","poem":2},{"text":"லெபனோனின் கேதுருபோல்","poem":1},{"text":"வேரூன்றி நிற்பான்.","poem":2}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"அவனுடைய இளந்தளிர்கள் வளரும்.","poem":2},{"text":"அவனுடைய புகழ் ஒலிவமரத்தைப் போலவும்,","poem":1},{"text":"அவனுடைய வாசனை லெபனோனின் கேதுரு போலவும் இருக்கும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"திரும்பவும் மனிதர்கள் அவனுடைய நிழலில் குடியிருப்பார்கள்;","poem":1},{"text":"அவன் தானியத்தைப்போல் செழிப்பான்.","poem":2},{"text":"திராட்சைக் கொடியைப்போல் பூப்பான்;","poem":1},{"text":"அவனுடைய புகழ் லெபனோனின் திராட்சை இரசம்போல் இருக்கும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எப்பிராயீமுக்கு விக்கிரகங்களுடன் இனியும் வேலை இல்லை;","poem":1},{"text":"இனிமேல் நான் அவனுடைய வேண்டுதலுக்குப் பதில் கொடுத்து, அவனைப் பராமரிப்பேன்.","poem":2},{"text":"நான் அவர்களுக்குப் பசுமையான தேவதாரு மரம் போலிருக்கிறேன்.","poem":1},{"text":"அவர்களுடைய பலன்களின் நிறைவுகளெல்லாம் என்னிடமிருந்தே வருகின்றன.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ஞானமுள்ளவன் யார்? அவனே இவற்றை உணர்ந்துகொள்வான்.","poem":1},{"text":"பகுத்தறிவுள்ளவன் யார்? அவனே இவற்றை விளங்கிக்கொள்வான்.","poem":2},{"text":"யெகோவாவின் வழிகள் நீதியானவைகள்;","poem":1},{"text":"நீதிமான்கள் அவற்றில் நடக்கிறார்கள்,","poem":2},{"lineBreak":true},{"text":"ஆனால் கலகக்காரர்கள் அவைகளில் இடறி விழுகிறார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}