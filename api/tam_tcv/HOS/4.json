{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":4,"content":[{"type":"heading","content":["இஸ்ரயேலுக்கு எதிரான குற்றச்சாட்டு"]},{"type":"verse","number":1,"content":[{"text":"இஸ்ரயேலரே, நீங்கள் யெகோவாவின் வார்த்தையைக் கேளுங்கள்;","poem":1},{"text":"நாட்டில் வாழ்கிற உங்களுக்கு எதிராகக் கொண்டுவரும்படி,","poem":2},{"lineBreak":true},{"text":"ஒரு குற்றச்சாட்டு யெகோவாவிடம் இருக்கிறது:","poem":2},{"text":"நாட்டில் உண்மையும் அன்பும் இல்லை,","poem":1},{"text":"இறைவனை அறியும் அறிவு இல்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அங்கே சாபமிடுதலும், பொய்யும், கொலையும்,","poem":1},{"text":"களவும், விபசாரமும் மட்டுமே உண்டு;","poem":2},{"text":"அவர்கள் எல்லைமீறிப் போகின்றனர்,","poem":1},{"text":"இரத்தப்பழிகளோடே இரத்தப்பழிகள் சேருகின்றது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இதனால் நாடு துக்கத்தோடிருக்கிறது,","poem":1},{"text":"அங்கு வாழும் யாவரும் நலிந்துபோகிறார்கள்.","poem":2},{"text":"வெளியின் மிருகங்களும், ஆகாயத்துப் பறவைகளும்,","poem":1},{"text":"கடலில் உள்ள மீன்களும் சாகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ஆசாரியர்களே நீங்கள் ஒரு குற்றச்சாட்டையும் கொண்டுவர வேண்டாம்.","poem":1},{"text":"ஒருவன் இன்னொருவனைச் குற்றஞ்சாட்டவும் வேண்டாம்.","poem":2},{"text":"ஏனெனில் உங்கள் மக்கள் ஆசாரியனுக்கு எதிராகக்","poem":1},{"text":"குற்றச்சாட்டுகளைக் கொண்டுவருகிறவர்கள் போலிருக்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"ஆசாரியர்களே, என் வழக்கு உங்களோடுதான்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீங்கள் இரவிலும் பகலிலும் இடறிவிழுகிறீர்கள்;","poem":1},{"text":"இறைவாக்கினரும் உங்களுடன் விழுகிறார்கள்.","poem":2},{"text":"எனவே நான் உங்கள் தாயை, இஸ்ரயேல் தேசத்தை அழிப்பேன்.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"எனது மக்கள் அறிவில்லாததினால் அழிந்துபோகிறார்கள்.","poem":2},{"lineBreak":true},{"text":"“நீங்கள் அறிவைப் புறக்கணித்திருக்கிறீர்கள்,","poem":1},{"text":"அதனால் நானும் உங்களை என் ஆசாரியர்களாய் இராதபடிக்கு புறக்கணிப்பேன்.","poem":2},{"text":"நீங்கள் உங்கள் இறைவனின் சட்டத்தை மறந்தபடியால்,","poem":1},{"text":"நானும் உங்கள் பிள்ளைகளை ஆசீர்வதிக்க மறந்துவிடுவேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆசாரியர்கள் அநேகராய்ப் பெருகியபோது,","poem":1},{"text":"அவர்கள் எனக்கெதிராக அதிகமாகப் பாவம் செய்கிறார்கள்;","poem":2},{"text":"அவர்கள் தங்களுடைய மகிமையான இறைவனை","poem":1},{"text":"வெட்கக்கேடான பாகால் தெய்வத்திற்கு மாற்றினார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எனது மக்களின் பாவத்தில் ஆசாரியர்கள் தின்று பிழைத்து,","poem":1},{"text":"அவர்களது கொடுமையில் ஆவலாயிருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அக்காலத்தில்: மக்களைப்போலவே ஆசாரியருக்கும் நேரிடும்.","poem":1},{"text":"எனவே அவர்களின் தீயவழிகளுக்காக நான் அவர்கள் இரு சாராரையும் தண்டிப்பேன்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் செயல்களுக்கேற்ப அவர்களுக்கு நான் பதிலளிப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“அவர்கள் எல்லோரும் சாப்பிடுவார்கள், ஆனால் திருப்தியடையமாட்டார்கள்;","poem":1},{"text":"அவர்கள் வேசித்தனத்தில் ஈடுபட்டாலும் பலுகமாட்டார்கள்;","poem":2},{"text":"ஏனெனில் அவர்கள் தங்கள் வேசித்தனத்திற்காக யெகோவாவைக் கைவிட்டார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"புது மற்றும் பழைய திராட்சை இரசம்","poem":2},{"text":"எனது மக்களின்","poem":1},{"text":"விளங்கிக்கொள்ளும் ஆற்றலை பரித்துவிட்டது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"எனது மக்கள் மர விக்கிரகத்திடம் ஆலோசனையைக் கேட்கிறார்கள்;","poem":1},{"text":"அவர்களுடைய கோல் பதில் தருமென்றிருக்கிறார்கள்.","poem":2},{"text":"வேசித்தனத்தின் ஆவி அவர்களை வழிவிலகச் செய்கிறது;","poem":1},{"text":"அவர்கள் தங்கள் இறைவனுக்கு உண்மையற்றவர்களாய் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் மலையுச்சியில் பலியிட்டு,","poem":1},{"text":"குன்றுகளிலே இன்பமான நிழல் தருகின்ற கர்வாலி, புன்னை,","poem":2},{"text":"தேவதாரு ஆகிய மரங்களின் கீழும்","poem":1},{"text":"தகன காணிக்கைகளைப் பலியிடுகிறார்கள்.","poem":2},{"text":"எனவே உங்கள் மகள்கள் வேசித்தனத்திற்கும்,","poem":1},{"text":"மருமகள்கள் விபசாரத்திற்கும் திரும்புகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“உங்கள் மகள்கள் வேசித்தனத்திற்குத் திரும்பும்போதும்,","poem":1},{"text":"மருமகள்கள் விபசாரம் செய்யும்போதும்","poem":2},{"text":"நான் அவர்களைத் தண்டிக்கமாட்டேன்.","poem":1},{"text":"ஏனெனில் ஆண்களும் வேசிகளுடன் பாலுறவுகொண்டு,","poem":2},{"text":"கோவில் வேசிகளுடன் பலியிடுகிறார்கள்,","poem":1},{"text":"அறிவில்லாத அம்மக்கள்","poem":2},{"lineBreak":true},{"text":"சீரழிந்து போவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“இஸ்ரயேலே, நீ விபசாரம் செய்தாலும்,","poem":1},{"text":"யூதா நாடாகிலும் குற்றமற்றதாயிருக்கட்டும்.","poem":2},{"lineBreak":true},{"text":"“நீ கில்காலுக்குப் போகவேண்டாம்;","poem":1},{"text":"பெத்தாவேனுக்கும் போகவேண்டாம்.","poem":2},{"lineBreak":true},{"text":"‘யெகோவா இருப்பது நிச்சயமெனில்’ என்று ஆணையிடவும் வேண்டாம்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"இஸ்ரயேலரோ அடங்காத","poem":1},{"text":"இளம் பசுவைப்போல் பிடிவாதமாயிருக்கிறார்கள்.","poem":2},{"text":"அப்படியிருக்க, யெகோவா எப்படி புல்வெளியில்","poem":1},{"text":"செம்மறியாட்டுக் குட்டிகளை மேய்ப்பதுபோல அவர்களை மேய்க்க முடியும்?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"எப்பிராயீம் விக்கிரகங்களோடு இணைந்துவிட்டான்;","poem":1},{"text":"அவனைத் தனியே விட்டுவிடு!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்களுடைய மதுபானங்கள் முடிந்துபோனாலும்,","poem":1},{"text":"அவர்கள் எப்போதும் தங்கள் வேசித்தனத்தைத் தொடர்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய ஆளுநர்கள் வெட்கக்கேடான வழிகளை ஆவலுடன் விரும்புகிறார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"சுழல் காற்று அவர்களை அடித்துக் கொண்டுபோகும்,","poem":1},{"text":"அவர்கள் விக்கிரகங்களுக்குப் படைக்கும் பலிகள்","poem":2},{"lineBreak":true},{"text":"அவர்களுக்கு வெட்கத்தையே கொண்டுவரும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}