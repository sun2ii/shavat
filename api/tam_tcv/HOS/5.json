{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":5,"content":[{"type":"heading","content":["இஸ்ரயேலுக்கு எதிராக நியாயத்தீர்ப்பு"]},{"type":"verse","number":1,"content":[{"text":"“ஆசாரியர்களே, நீங்கள் இதைக் கேளுங்கள்;","poem":1},{"text":"இஸ்ரயேல் வீட்டாரே கவனியுங்கள்;","poem":2},{"text":"அரச குடும்பத்தாரே, செவிகொடுங்கள்;","poem":1},{"text":"இந்த நியாயத்தீர்ப்பு உங்களுக்கெதிரானதே.","poem":2},{"text":"ஏனெனில் நீங்கள் மிஸ்பாவிலே கண்ணியாகவும்,","poem":1},{"text":"தாபோரிலே விரிக்கப்பட்ட வலையாகவும் இருக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"கலகக்காரர்கள் கொலைசெய்வதில் வேரூன்றி இருக்கிறார்கள்.","poem":1},{"text":"நான் அவர்கள் எல்லோரையும் தண்டித்துத் திருத்துவேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எப்பிராயீமைப்பற்றிய எல்லாவற்றையும் நான் அறிவேன்;","poem":1},{"text":"இஸ்ரயேலும் என்னிடமிருந்து மறைந்திருக்கவில்லை.","poem":2},{"text":"ஏனெனில் எப்பிராயீமே, நீ இப்பொழுது வேசித்தனத்திற்கு திரும்பிவிட்டாய்;","poem":1},{"text":"இஸ்ரயேல் தீட்டுப்பட்டிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“அவர்களுடைய செயல்கள் அவர்களை","poem":1},{"text":"அவர்களுடைய இறைவனிடம் திரும்புவதற்கு விடாதிருக்கிறது.","poem":2},{"text":"வேசித்தன ஆவி அவர்களின் இருதயத்தில் இருக்கிறது;","poem":1},{"text":"யெகோவாவைப்பற்றிய அறிவு அவர்களுக்கில்லை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இஸ்ரயேலின் அகந்தை அவர்களுக்கெதிராக சாட்சி கூறுகிறது;","poem":1},{"text":"இஸ்ரயேலும் எப்பிராயீமும் தங்கள் பாவத்தில் இடறி விழுகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்களுடன் யூதாவுங்கூட இடறி விழுகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் தங்கள் ஆட்டு மந்தைகளுடனும், மாட்டு மந்தைகளுடனும்","poem":1},{"text":"யெகோவாவை தேடிப் பலியிட வருவார்கள்;","poem":2},{"text":"ஆனால் அவர்கள் அவரைக் காணமாட்டார்கள்;","poem":1},{"text":"ஏனெனில் அவர் அவர்களைவிட்டு விலகினார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் யெகோவாவுக்கு உண்மையற்றவர்களாய் இருக்கிறார்கள்;","poem":1},{"text":"அவர்களுடைய பிள்ளைகளும் எனக்குரியவர்களல்ல.","poem":2},{"text":"இப்பொழுதும் அவர்களுடைய அமாவாசைப் போலிக் கொண்டாட்டங்கள்","poem":1},{"text":"அவர்களையும் அவர்களுடைய வயல்களையும் விழுங்கிப்போடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“கிபியாவில் எக்காளத்தையும்,","poem":1},{"text":"ராமாவிலே கொம்பு வாத்தியத்தையும் ஊதுங்கள்.","poem":2},{"text":"பெத் ஆவெனில் போர் முழக்கமிடுங்கள்;","poem":1},{"text":"பென்யமீனே, நீ முன்னேசெல்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தண்டனையின் நாளில்","poem":1},{"text":"எப்பிராயீம் பாழாய் விடப்படும்.","poem":2},{"text":"நிச்சயமாய் நடக்கப் போகிறதையே,","poem":1},{"text":"நான் இஸ்ரயேல் கோத்திரங்கள் மத்தியில் பிரசித்தப்படுத்துகிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"யூதாவின் தலைவர்கள்","poem":1},{"text":"எல்லைக் கற்களை ஒதுக்குகிறவர்களுக்கு ஒப்பாயிருக்கிறார்கள்.","poem":2},{"text":"என் கோபத்தை வெள்ளத்தைப்போல்","poem":1},{"text":"அவர்கள்மேல் ஊற்றுவேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எப்பிராயீம் ஒடுக்கப்பட்டு,","poem":1},{"text":"நியாயத்தீர்ப்பில் நசுக்கப்படுவான்.","poem":2},{"lineBreak":true},{"text":"ஏனெனில் அவன் விக்கிரகங்களைப் பின்பற்றுவதையே நோக்கமாய் கொண்டிருக்கிறான்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அதனால் நான் எப்பிராயீமுக்கு அந்துப் பூச்சியைப்போலவும்,","poem":1},{"text":"யூதாவின் வீட்டாருக்கு அழுகல் நோய்போலவும் இருப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“எப்பிராயீம் தன் வியாதியையும்,","poem":1},{"text":"யூதா தன் புண்களையும் கண்டபோது,","poem":2},{"text":"எப்பிராயீம் அசீரியாவின் பக்கம் திரும்பி,","poem":1},{"text":"அதன் பெரிய அரசனிடம் உதவி கேட்டனுப்பினான்.","poem":2},{"text":"ஆனால் உனக்கு சுகமாக்கவும்,","poem":1},{"text":"உனது புண்களை ஆற்றவும் அவனால் முடியாது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஏனெனில் எப்பிராயீமுக்கு நான் சிங்கம் போலவும்,","poem":1},{"text":"யூதாவுக்கு பெருஞ்சிங்கம் போலவும் இருப்பேன்.","poem":2},{"text":"நான் அவர்களை துண்டுகளாய் கிழித்து தூக்கிக்கொண்டு போவேன்;","poem":1},{"text":"ஒருவரும் அவர்களைத் தப்புவிக்கமாட்டார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"எனவே அவர்கள் தங்கள் குற்றத்தை ஒத்துக்கொண்டு,","poem":1},{"text":"என் முகத்தைத் தேடுமட்டும்","poem":2},{"lineBreak":true},{"text":"நான் என்னுடைய இருப்பிடத்திற்குத் திரும்பிப் போவேன்.","poem":2},{"text":"அவர்கள் தங்கள் அவலத்தில்","poem":1},{"text":"என்னை வாஞ்சையாய்த் தேடுவார்கள்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}