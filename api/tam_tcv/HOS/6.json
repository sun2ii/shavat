{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":6,"content":[{"type":"heading","content":["மனமாறாத இஸ்ரயேல்"]},{"type":"verse","number":1,"content":[{"text":"வாருங்கள், நாம் யெகோவாவிடம் திரும்புவோம்.","poem":1},{"lineBreak":true},{"text":"அவர் நம்மைக் காயப்படுத்தினார்,","poem":1},{"text":"ஆயினும், அவரே நம்மை சுகப்படுத்துவார்.","poem":2},{"text":"அவர் நம்மை நொறுக்கினார்,","poem":1},{"text":"ஆயினும், அவரே நம்முடைய காயங்களைக் கட்டுவார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நாம் அவருடைய சமுகத்தில் பிழைத்திருக்கும்படி","poem":1},{"text":"இரண்டு நாட்களுக்குப்பின்பு அவர் நமக்குப் புத்துயிரூட்டுவார்;","poem":2},{"lineBreak":true},{"text":"மூன்றாம் நாளிலோ நம்மை எழுப்புவார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நாம் யெகோவாவை அறிந்துகொள்வோமாக;","poem":1},{"text":"நாம் தொடர்ந்து அவரைப்பற்றி அறிய முயற்சிப்போமாக.","poem":2},{"text":"சூரியன் உதிப்பது நிச்சயம்போல,","poem":1},{"text":"அவர் தோன்றுவார் என்பதும் நிச்சயம்.","poem":2},{"text":"அவர் மழையைப்போலவும்,","poem":1},{"text":"பூமியை நனைக்கும் வசந்தகால மழையைப்போல் வருவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"எப்பிராயீமே, நான் உன்னை என்ன செய்வேன்?","poem":1},{"text":"யூதாவே, நான் உன்னை என்ன செய்வேன்?","poem":2},{"text":"உங்களது அன்பு காலையில் தோன்றும் மேகம்போலவும்,","poem":1},{"text":"விடியும்போது மறைந்துபோகும் பனிபோலவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அதனால்தான் நான் இறைவாக்கினர்மூலம் உங்களை வெட்டினேன்;","poem":1},{"text":"என் வாயின் வார்த்தையினால் உங்களைக் கொன்றேன்;","poem":2},{"lineBreak":true},{"text":"என் நியாயத்தீர்ப்பு உங்கள்மேல் ஒளிபோல் வெளிப்படும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் பலியை அல்ல, இரக்கத்தையே விரும்புகிறேன்;","poem":1},{"text":"தகன காணிக்கைகளை அல்ல, இறைவனை அறியும் அறிவையே விரும்புகிறேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனால், ஆதாமைப்போல் அவர்கள் என் உடன்படிக்கையை மீறி,","poem":1},{"text":"அங்கே எனக்கு துரோகம் பண்ணினார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"கீலேயாத் கொடுமையானவர்களின் பட்டணம்;","poem":1},{"text":"அது இரத்தம் தோய்ந்த அடிச்சுவடுகளால் கறைப்பட்டிருக்கிறது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"கொள்ளையர் கூட்டம் ஒருவனுக்காகப் பதுங்கிக் காத்திருப்பதுபோல,","poem":1},{"text":"ஆசாரியர்களின் கூட்டமும் இருக்கிறார்கள்.","poem":2},{"text":"அவர்கள் சீகேமுக்குப் போகும் வழியிலே கொலைசெய்து,","poem":1},{"text":"வெட்கக்கேடான குற்றங்களை செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இஸ்ரயேல் குடும்பத்தாரே, உங்கள் நாட்டில் கொடூரமான செயலைக் கண்டேன்;","poem":1},{"text":"எப்பிராயீமோ வேசித்தனத்தில் ஈடுபட்டிருக்கிறது,","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேல் தீட்டுப்பட்டிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"யூதாவே, உனக்கும்","poem":1},{"text":"ஒரு அறுவடை நியமிக்கப்பட்டிருக்கிறது.","poem":2},{"lineBreak":true},{"text":"“என் மக்களின் செல்வங்களை நான் அவர்களுக்குத் திரும்பக் கொடுக்கும்போது,","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}