{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"நான் இஸ்ரயேலைக் குணமாக்கும்போது,","poem":2},{"text":"எப்பிராயீமின் பாவங்களும்,","poem":1},{"text":"சமாரியாவின் குற்றங்களும் வெளிப்படும்.","poem":2},{"text":"அவர்கள் வஞ்சனையைக் கைக்கொள்கிறார்கள்;","poem":1},{"text":"திருடர்கள் வீடுகளை உடைத்து உள்ளே போகிறார்கள்,","poem":2},{"lineBreak":true},{"text":"கொள்ளையர்கள் வீதிகளில் சூறையாடுகிறார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர்களின் தீமைகள் எல்லாவற்றையும் நான் நினைவில் வைத்திருக்கிறேன் என்பதை","poem":1},{"text":"அவர்கள் உணராதிருக்கிறார்கள்.","poem":2},{"text":"அவர்களின் பாவங்கள் அவர்களை மூடிப்போடுகின்றன;","poem":1},{"text":"அவை எப்பொழுதும் என்முன் இருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“தங்கள் கொடுமையினால் அரசனையும்,","poem":1},{"text":"பொய்யினால் இளவரசர்களையும் மகிழ்விக்கின்றார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் எல்லோரும் விபசாரக்காரர்.","poem":1},{"text":"அவர்கள் அப்பம் சுடும் அடுப்பைப்போல் எரிந்துகொண்டே இருக்கிறார்கள்.","poem":2},{"text":"மாவைப் பிசையும் நேரத்திலிருந்து, அது புளித்துப் பொங்கும் நேரம்வரைக்கும்,","poem":1},{"text":"அதன் நெருப்பை ஊதவேண்டிய அவசியம் இல்லை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"எங்கள் அரசனின் கொண்டாட்ட நாளில்,","poem":1},{"text":"இளவரசர்கள் திராட்சை மதுவினால் வெறிகொண்டார்கள்;","poem":2},{"lineBreak":true},{"text":"அரசன் ஏளனக்காரர்களுடன் கைகோத்திருக்கிறான்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்களின் இருதயங்கள் சதித்திட்டங்களினால்","poem":1},{"text":"அடுப்பைப்போல் எரிகின்றன;","poem":2},{"text":"இரவு முழுவதும் அவர்களின் கோபம், நெருப்புத் தணலைப்போல் எரிகிறது;","poem":1},{"text":"காலையில் அது கொழுந்து விட்டெரியும் நெருப்பைப்போல் இருக்கிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் எல்லோரும் சூடேறிய அடுப்பைப்போலாகி,","poem":1},{"text":"அவர்கள் தங்கள் ஆளுநர்களை அழிக்கிறார்கள்.","poem":2},{"text":"அவர்களுடைய அரசர்கள் அனைவரும் விழுகிறார்கள்;","poem":1},{"text":"ஆனால் அவர்களில் ஒருவனும் என்னைக் கூப்பிடுகிறதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“எப்பிராயீம் பிற நாடுகளுடன் கலந்துகொள்கிறான்;","poem":1},{"text":"எப்பிராயீம் புரட்டிப் போடாததினால் ஒரு பக்கம் வேகாத அப்பம் போலிருக்கிறான்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அந்நியர் அவன் பெலத்தை உறிஞ்சுகிறார்கள்;","poem":1},{"text":"ஆனால் அவன் அதை உணர்கிறதில்லை.","poem":2},{"text":"அவன் தலையில் நரைமயிர் தோன்றிவிட்டது,","poem":1},{"text":"ஆயினும் அதையும் அவன் கவனிக்கவில்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இஸ்ரயேலின் அகந்தை அவனுக்கெதிராய்ச் சாட்சி கூறுகிறது.","poem":1},{"text":"இவையெல்லாம் நடந்துங்கூட,","poem":2},{"text":"அவர்கள் தனது இறைவனாகிய யெகோவாவிடம் திரும்பவுமில்லை,","poem":1},{"text":"அவரைத் தேடவுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“எப்பிராயீம் பேதையான புறாவைப் போன்றவன்,","poem":1},{"text":"அவன் புத்தியில்லாதவனாயும் இருக்கிறான்.","poem":2},{"text":"முதலில் அவன் எகிப்தை உதவிக்குக் கூப்பிடுகிறான்;","poem":1},{"text":"பின் அசீரியாவினிடத்திற்கும் திரும்புகிறான்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"எப்பிராயீமியர் உதவிகேட்டுப் போகும்போது,","poem":1},{"text":"நான் எனது வலையை அவர்கள்மேல் வீசுவேன்;","poem":2},{"lineBreak":true},{"text":"ஆகாயத்துப் பறவைகள்போல், அவர்களை நான் இழுத்து வீழ்த்துவேன்;","poem":2},{"text":"அவர்கள் ஒன்றாய்கூடும் சத்தத்தை நான் கேட்கும்போது,","poem":1},{"text":"நான் அவர்களை எச்சரித்ததுபோல் தண்டிப்பேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்களுக்கு ஐயோ கேடு வருகிறது,","poem":1},{"text":"ஏனெனில், அவர்கள் என்னைவிட்டுப் போய்விட்டார்கள்.","poem":2},{"text":"அவர்களுக்கு அழிவு வருகிறது.","poem":1},{"text":"ஏனெனில், அவர்கள் எனக்கெதிராக கலகம் பண்ணியிருக்கிறார்கள்.","poem":2},{"text":"நான் அவர்களை மீட்பதற்கு விரும்புகிறேன்,","poem":1},{"text":"ஆனால், அவர்களோ எனக்கெதிராய் பொய் பேசுகிறார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்கள் தங்கள் படுக்கையிலிருந்து புலம்புகிறார்களே தவிர,","poem":1},{"text":"தங்கள் இருதயத்திலிருந்து என்னை நோக்கி அழுவதில்லை.","poem":2},{"text":"தானியத்திற்காகவும், புதுத் திராட்சை இரசத்திற்காகவும் மட்டுமே","poem":1},{"text":"அவர்கள் பாகால் தெய்வத்திற்குமுன் ஒன்றுகூடுகிறார்கள்.","poem":2},{"lineBreak":true},{"text":"எனவே அவர்கள் என்னைவிட்டு வழிவிலகிப் போகிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் அவர்களைப் பயிற்றுவித்து பெலப்படுத்தினேன்;","poem":1},{"text":"ஆயினும், அவர்கள் எனக்கெதிராகத் தீமையான சூழ்ச்சி செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நானே அவர்களுடைய மகா உன்னதமான இறைவன்;","poem":1},{"text":"ஆனால் அவர்கள் என் பக்கம் திரும்புகிறதில்லை.","poem":2},{"text":"அவர்கள் வலுவிழந்த வில்லைப்போல் இருக்கிறார்கள்;","poem":1},{"text":"அவர்களுடைய தலைவர்கள் தங்களது இறுமாப்பான பேச்சுகளின் நிமித்தம்,","poem":2},{"text":"வாளினால் விழுவார்கள்.","poem":1},{"text":"இதுவே எகிப்து நாட்டினால் அவர்களுக்கு ஏற்படும் நிந்தை.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}