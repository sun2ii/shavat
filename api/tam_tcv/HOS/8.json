{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":8,"content":[{"type":"heading","content":["இஸ்ரயேல் சுழல்காற்றை அறுவடை செய்தல்"]},{"type":"verse","number":1,"content":[{"text":"“உங்கள் உதடுகளில் எக்காளத்தை வையுங்கள்;","poem":1},{"text":"யெகோவாவின் ஆலயத்துக்கு மேலாக ஒரு எதிரி கழுகைப்போல் பறக்கிறான்.","poem":2},{"text":"ஏனெனில் அவர்கள் எனது உடன்படிக்கையை மீறி,","poem":1},{"text":"எனது சட்டத்திற்கு எதிராக கிளர்ச்சி செய்தார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"‘எங்கள் இறைவனே, நாங்கள் உம்மை அறிந்திருக்கிறோம்!’ என்று","poem":1},{"text":"இஸ்ரயேலர் என்னை நோக்கிக் கதறுகிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஆனால் இஸ்ரயேலர் நன்மையானதைப் புறக்கணித்துவிட்டார்கள்;","poem":1},{"text":"அதனால் ஒரு பகைவன் அவர்களைப் பின்தொடர்வான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் மக்கள் எனது சம்மதம் இன்றி அரசர்களை ஏற்படுத்துகிறார்கள்;","poem":1},{"text":"எனது அங்கீகாரம் இல்லாமல், அவர்கள் இளவரசர்களைத் தெரிந்துகொள்கிறார்கள்.","poem":2},{"text":"அவர்கள் தங்கள் வெள்ளியினாலும், தங்கத்தினாலும்","poem":1},{"text":"தங்களுக்கென விக்கிரகங்களைச் செய்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"இது அவர்களின் அழிவுக்கே ஏதுவாகும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவா சொல்வதாவது: சமாரியாவே, உன் கன்றுக்குட்டி விக்கிரகத்தை எறிந்துவிடு;","poem":1},{"text":"எனது கோபம் உனக்கெதிராக பற்றியெரிகிறது.","poem":2},{"text":"எவ்வளவு காலத்திற்கு இவர்கள் தூய்மையடையாது இருப்பார்கள்?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"அந்த விக்கிரகம் இஸ்ரயேலிலிருந்து வந்தது;","poem":2},{"text":"அது இறைவனல்ல,","poem":1},{"text":"அதை ஒரு கைவினைஞன் செய்தான்,","poem":2},{"text":"எனவே சமாரியாவின் கன்றுக்குட்டி","poem":1},{"text":"துண்டுதுண்டாக உடைக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ஏனெனில் அவர்கள் காற்றை விதைத்து,","poem":1},{"text":"சுழல்காற்றை அறுவடை செய்கிறார்கள்.","poem":2},{"text":"பயிரின் தண்டில் கதிர் இல்லை;","poem":1},{"text":"அதிலிருந்து மாவும் கிடைக்காது.","poem":2},{"text":"அது தானியத்தைக் கொடுக்குமானால்","poem":1},{"text":"அவற்றை அந்நியர் விழுங்குவார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"இஸ்ரயேல் விழுங்கப்பட்டது;","poem":1},{"text":"இப்பொழுது அவர்கள் நாடுகளுக்குள்ளே","poem":2},{"lineBreak":true},{"text":"ஒருவருக்கும் பயனற்ற பானையைப்போல் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்கள் தனிமையில் அலைந்து திரியும் காட்டுக் கழுதைபோல்","poem":1},{"text":"அசீரியாவுக்குப் போய்விட்டார்கள்.","poem":2},{"lineBreak":true},{"text":"எப்பிராயீமர் தன்னை தன் காதலர்களுக்கு விற்றுப் போட்டார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அப்படி அவர்கள் தங்களைப் பிற தேசத்தாருக்குள் விற்றிருந்தாலும்,","poem":1},{"text":"இப்பொழுது நான் அவர்களை ஒன்றுசேர்ப்பேன்.","poem":2},{"text":"வலிமைமிக்க அரசனின் கையின் ஒடுக்குதலின்கீழ்,","poem":1},{"text":"அவர்கள் வலிமை குன்றத் தொடங்குவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“எப்பிராயீம் பாவநிவாரண காணிக்கைகளுக்காகப் பலிபீடங்களைக் கட்டினாலும்,","poem":1},{"text":"இவை பாவம் செய்வதற்கான பலிபீடங்களாயின.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நான் அவர்களின் நலத்திற்காக எனது சட்டத்தைப்பற்றிய","poem":1},{"text":"அநேக காரியங்களை அவர்களுக்கு எழுதிக் கொடுத்தேன்;","poem":2},{"lineBreak":true},{"text":"ஆனால் அவர்கள் அவற்றை ஒரு அந்நியமான காரியமாக மதித்தார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் எனக்குப் பலிகளைச் செலுத்தி,","poem":1},{"text":"அதன் இறைச்சியை அவர்கள் சாப்பிடுகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"ஆனாலும் யெகோவா அவர்களின் செயல்களில் பிரியப்படவில்லை.","poem":2},{"text":"இப்பொழுது யெகோவா அவர்களின் கொடுமையை நினைவில்கொண்டு,","poem":1},{"text":"அவர்களுடைய பாவத்திற்காக அவர்களைத் தண்டிப்பார்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் எகிப்திற்கே திரும்பிப் போவார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஏனெனில் இஸ்ரயேல் தன்னை உண்டாக்கியவரை மறந்து,","poem":1},{"text":"அரண்மனைகளைக் கட்டுகிறது;","poem":2},{"lineBreak":true},{"text":"யூதா அநேக பட்டணங்களைச் சுற்றி அரண்களைக் கட்டியிருக்கிறது.","poem":2},{"text":"ஆகவே நான் அவர்களுடைய பட்டணங்கள்மேல் நெருப்பை அனுப்புவேன்;","poem":1},{"text":"அது அவர்களுடைய கோட்டைகளைச் சுட்டெரிக்கும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}