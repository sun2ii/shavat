{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"HOS","translationId":"tam_tcv","name":"ஓசியா","commonName":"ஓசியா","title":"ஓசியா","order":28,"numberOfChapters":14,"sha256":"507f3d0d64880a2a5221eadc283b0415a14c2dae07430c086feffa7c5c1e61d0","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/HOS/14.json","totalNumberOfVerses":197},"chapter":{"number":9,"content":[{"type":"heading","content":["இஸ்ரயேலுக்குத் தண்டனை"]},{"type":"verse","number":1,"content":[{"text":"இஸ்ரயேலே, நீ மகிழாதே;","poem":1},{"text":"மற்ற நாடுகளைப்போல் களிகூராதே;","poem":2},{"text":"ஏனெனில் நீ உனது இறைவனுக்கு உண்மையில்லாமல் இருக்கிறாய்.","poem":1},{"text":"நீ தானியத்தை சூடடிக்கும் எல்லா களங்களிலும்","poem":2},{"lineBreak":true},{"text":"வேசித்தனத்தின் கூலியைப் பெற விரும்புகிறாய்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"சூடடிக்கும் களங்களும் திராட்சை ஆலைகளும் மக்களுக்கு உணவளிக்காது;","poem":1},{"text":"புதுத் திராட்சை இரசம் அவர்களுக்குக் கிடைக்காது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் யெகோவாவின் நாட்டில் குடியிருக்கமாட்டார்கள்;","poem":1},{"text":"ஆனால் எப்பிராயீம் எகிப்திற்குத் திரும்பிப் போகும்,","poem":2},{"lineBreak":true},{"text":"அசீரியாவில் அசுத்தமான உணவைச் சாப்பிடும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் யெகோவாவுக்கு திராட்சை இரசக் காணிக்கைகளைச் செலுத்தமாட்டார்கள்;","poem":1},{"text":"அவர்களுடைய பலிகள் அவரை மகிழ்விக்காது.","poem":2},{"text":"அப்படிப்பட்ட பலிகள், அவர்களுக்கு துக்க வீட்டு உணவைப் போன்றவை;","poem":1},{"text":"அவற்றைச் சாப்பிடுகிறவர்கள் எல்லோரும் அசுத்தமாயிருப்பார்கள்.","poem":2},{"text":"ஏனெனில், இந்த உணவு அவர்களுக்கானதாக மட்டுமே இருக்கும்;","poem":1},{"text":"அது யெகோவாவின் ஆலயத்திற்குள் வருவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவின் பண்டிகை நாட்களிலும்,","poem":1},{"text":"நியமிக்கப்பட்ட உங்கள் கொண்டாட்ட நாட்களிலும் நீங்கள் என்ன செய்யப் போகிறீர்கள்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உங்களில் சிலர் அழிவிலிருந்து தப்பி ஓடினாலுங்கூட,","poem":1},{"text":"எகிப்து அவர்களை அழிவுக்கு ஒன்றுசேர்க்கும்;","poem":2},{"lineBreak":true},{"text":"மெம்பிஸ் அவர்களை அடக்கம்பண்ணும்.","poem":2},{"text":"அவர்களுடைய வெள்ளியினாலான திரவியங்களை நெரிஞ்சில்கள் மூடும்;","poem":1},{"text":"அவர்களுடைய கூடாரத்தையும் முட்செடிகள் மூடும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"தண்டனையின் நாட்கள் சமீபமாயிருக்கின்றன;","poem":1},{"text":"கணக்குக் கேட்கும் நாட்களும் நெருங்கிவிட்டன.","poem":2},{"lineBreak":true},{"text":"இதை இஸ்ரயேல் தெரிந்துகொள்ளட்டும்.","poem":2},{"text":"உனது பாவங்கள் அநேகமாயிருக்கிறதினாலும்,","poem":1},{"text":"உனது பகைமையுணர்வு அதிகமாயிருக்கிறதினாலும்","poem":2},{"text":"இறைவாக்கினன் மூடனாக எண்ணப்படுகிறான்.","poem":1},{"text":"இறைவனால் தூண்டுதல் பெற்றவன் பைத்தியக்காரனாய் எண்ணப்படுகிறான்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் இறைவனோடு இறைவாக்கினனே","poem":1},{"text":"எப்பிராயீமுக்குக் காவலாளியாய் இருக்கிறேன்.","poem":2},{"text":"ஆயினும் அவனுடைய வழிகளிலெல்லாம் கண்ணிகள் காத்திருக்கின்றன;","poem":1},{"text":"அவனுடைய இறைவனின் ஆலயத்தில் பகைமை காத்திருக்கிறது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"கிபியாவின் நாட்களில் இருந்ததுபோல்,","poem":1},{"text":"அவர்கள் சீர்கேட்டில் மூழ்கியிருக்கிறார்கள்.","poem":2},{"text":"யெகோவா அவர்களின் கொடுமையை நினைவிற்கொண்டு,","poem":1},{"text":"அவர்களுடைய பாவங்களுக்காக அவர்களைத் தண்டிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நான் இஸ்ரயேலை முதன்முதல் கண்டபோது,","poem":1},{"text":"அது பாலைவனத்தில் திராட்சைப் பழங்களைக்","poem":2},{"lineBreak":true},{"text":"கண்டுபிடித்ததுபோல் எனக்கு இருந்தது;","poem":2},{"text":"நான் உனது முற்பிதாக்களைக் கண்டபோது,","poem":1},{"text":"அது அத்திமரத்தில் அதன் பருவகாலத்தின்","poem":2},{"lineBreak":true},{"text":"முதல் பழங்களைப் பார்ப்பதுபோல் இருந்தது.","poem":2},{"text":"ஆனால், அவர்கள் பாகால் பேயோரிடத்திற்கு வந்தபோது,","poem":1},{"text":"வெட்கக்கேடான பாகால் விக்கிரகத்திற்கு தங்களை அர்ப்பணித்து,","poem":2},{"lineBreak":true},{"text":"தாங்கள் நேசித்த அந்த விக்கிரகத்தைப் போலவே, கேவலமானவர்களானார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எப்பிராயீமின் மகிமை ஒரு பறவையைப்போல் பறந்தோடிவிடும்;","poem":1},{"text":"அவர்களுக்குள் பிறப்போ, கருவில் சுமப்பதோ","poem":2},{"lineBreak":true},{"text":"அல்லது கருத்தரிப்பதோ இல்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்கள் பிள்ளைகளைப் பெற்று வளர்த்தாலுங்கூட,","poem":1},{"text":"அவர்களுடைய பிள்ளைகள் ஒவ்வொருவரையும் அவர்கள் இழக்கும்படி நான் செய்வேன்.","poem":2},{"text":"நான் அவர்களைவிட்டு விலகும்போது,","poem":1},{"text":"அவர்களுக்கு ஐயோ கேடு!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இன்பமான இடத்தில் அமைந்திருக்கும் தீரு நாட்டைப்போல்,","poem":1},{"text":"நான் எப்பிராயீமை கண்டேன்.","poem":2},{"text":"ஆனால், எப்பிராயீம் தன் பிள்ளைகளைக்","poem":1},{"text":"கொலைக்குக் கொடுக்கும்படி பகைவனைக் கூட்டிவருவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"யெகோவாவே, அவர்களுக்கு எதைக் கொடுப்பீர்?","poem":1},{"text":"கருச்சிதைவு உண்டாகும் கர்ப்பப்பைகளையும்,","poem":2},{"text":"பால் சுரக்க முடியாத மார்பகங்களையும்","poem":1},{"text":"அவர்களுக்குக் கொடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“கில்காலிலே அவர்கள் செய்த கொடுமைக்காக","poem":1},{"text":"அங்கே நான் அவர்களை வெறுத்தேன்.","poem":2},{"text":"அவர்களுடைய பாவச் செயல்களின் நிமித்தம்,","poem":1},{"text":"நான் எனது நாட்டிலிருந்து அவர்களைத் துரத்துவேன்.","poem":2},{"text":"நான் இனிமேலும் அவர்களில் அன்பாயிருக்கமாட்டேன்,","poem":1},{"text":"அவர்களுடைய தலைவர்கள் எல்லோரும் கலகக்காரர்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"எப்பிராயீம் மக்கள் வெட்டுண்டு வீழ்ந்தார்கள்,","poem":1},{"text":"அவர்களின் வேர் உலர்ந்துபோயிற்று;","poem":2},{"lineBreak":true},{"text":"இனிமேல் அவர்கள் கனி கொடுப்பதில்லை.","poem":2},{"text":"அவர்கள் பிள்ளைகளைப் பெற்றாலும்,","poem":1},{"text":"அவர்களுடைய அருமையான சந்ததிகளை நான் நீக்கிப்போடுவேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"என் இறைவன் அவர்களைத் தள்ளிவிடுவார்,","poem":1},{"text":"ஏனெனில் அவர்கள் அவருக்குக் கீழ்ப்படியவில்லை;","poem":2},{"lineBreak":true},{"text":"அவர்கள் பிற நாடுகளுக்குள்ளே அலைந்து திரிகிறவர்களாயிருப்பார்கள்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}