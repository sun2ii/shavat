{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["ஆமோஸின் மகன் ஏசாயா, யூதாவின் அரசர்களாகிய உசியா, யோதாம், ஆகாஸ், எசேக்கியா ஆகியோர் அரசாண்ட காலங்களில் யூதா நாட்டையும், எருசலேம் பட்டணத்தையும் பற்றி கண்ட தரிசனம்."]},{"type":"line_break"},{"type":"heading","content":["யூதாவுக்கு யெகோவாவின் நியாயத்தீர்ப்பு"]},{"type":"verse","number":2,"content":[{"text":"வானங்களே, கேளுங்கள், பூமியே, கவனித்துக் கேள்!","poem":1},{"text":"ஏனெனில் யெகோவா பேசியிருக்கிறார்:","poem":2},{"text":"“நான் என் பிள்ளைகளை பராமரித்துப் பாதுகாத்து வளர்த்தேன்;","poem":1},{"text":"ஆனால் அவர்கள் எனக்கெதிராகக் கலகம் பண்ணினார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எருது தன் எஜமானையும்,","poem":1},{"text":"கழுதை தன் எஜமானின் தொழுவத்தையும் அறியும்.","poem":2},{"text":"ஆனால் இஸ்ரயேலரோ என்னை அறிந்துகொள்ளாமலும்,","poem":1},{"text":"என் மக்கள் என்னைப் புரிந்துகொள்ளாமலும் இருக்கிறார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ஐயோ, இவர்கள் பாவம் நிறைந்த நாடு,","poem":1},{"text":"குற்றம் நிறைந்த மக்கள்,","poem":2},{"text":"தீயவர்களின் கூட்டம்,","poem":1},{"text":"கேடு கெட்டு நடக்கும் பிள்ளைகள்!","poem":2},{"text":"இவர்கள் யெகோவாவை விட்டுவிட்டார்கள்,","poem":1},{"text":"இவர்கள் இஸ்ரயேலின் பரிசுத்தரை அவமதித்து,","poem":2},{"lineBreak":true},{"text":"அவருக்குத் தங்கள் முதுகைக் காட்டினார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இன்னும் நீங்கள் ஏன் அடிக்கப்பட வேண்டும்?","poem":1},{"text":"உங்கள் தலை முழுவதும் காயப்பட்டும்,","poem":2},{"text":"உங்கள் இருதயம் முழுவதும் வேதனையுற்றும் இருக்கிறதே!","poem":1},{"text":"தொடர்ந்து ஏன் நீங்கள் கலகம் செய்கிறீர்கள்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உங்கள் உள்ளங்கால் தொடங்கி உச்சந்தலைவரை,","poem":1},{"text":"நீங்கள் ஆரோக்கியம் அற்றவர்களாய் இருக்கிறீர்கள்.","poem":2},{"text":"ஆறாத புண்களும், அடிகாயங்களும்,","poem":1},{"text":"சீழ்வடியும் புண்களுமே இருக்கின்றன.","poem":2},{"text":"அவை சுத்தமாக்கப்படவோ, கட்டுப்போடப்படவோ,","poem":1},{"text":"எண்ணெய் பூசி குணமாக்கப்படவோ இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"உங்கள் நாடு பாழடைந்திருக்கிறது;","poem":1},{"text":"உங்கள் நகரங்கள் தீயினால் எரிந்துபோய்க் கிடக்கின்றன.","poem":2},{"text":"உங்கள் கண்முன்பதாகவே","poem":1},{"text":"உங்கள் வயல்கள் அந்நியரால் கொள்ளையிடப்படுகின்றன;","poem":2},{"lineBreak":true},{"text":"உங்கள் நாடு பிறநாட்டினரால் தோற்கடிக்கப்பட்டு பாழடைந்ததைப் போல் இருக்கிறதே!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"சீயோனின் மகள்","poem":1},{"noteId":0},{"text":"திராட்சைத் தோட்டத்திலுள்ள கொட்டில் போலவும்,","poem":2},{"text":"வெள்ளரித் தோட்டத்தின் குடில்போலவும்,","poem":1},{"text":"முற்றுகையிட்ட பட்டணம் போலவும் தனித்து விடப்பட்டிருக்கிறாள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எல்லாம் வல்ல யெகோவா","poem":1},{"text":"நம்மில் ஒரு சிலரைத் தப்பிப்பிழைக்க விட்டிராமல் இருந்தால்,","poem":2},{"text":"நாம் சோதோமைப் போலாகியிருப்போம்;","poem":1},{"text":"நாம் கொமோராவுக்கு ஒத்தவர்களாயிருப்போம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"சோதோமின் ஆளுநர்களே,","poem":1},{"text":"யெகோவாவின் வார்த்தையைக் கேளுங்கள்;","poem":2},{"text":"கொமோராவின் மக்களே,","poem":1},{"text":"நமது இறைவனின் கட்டளைக்குச் செவிகொடுங்கள்!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“உங்கள் ஏராளமான பலிகள்","poem":1},{"text":"எனக்கு எதற்கு?”","poem":2},{"lineBreak":true},{"text":"என யெகோவா கேட்கிறார்.","poem":2},{"text":"“செம்மறியாட்டுக் கடாக்களின் தகனபலிகளும்,","poem":1},{"text":"கொழுத்த மந்தைகளின் கொழுப்பும், எனக்குச் சலித்துவிட்டன;","poem":2},{"text":"காளைகள், செம்மறியாட்டுக் குட்டிகள், கடாக்களுடைய இரத்தத்தினால்","poem":1},{"text":"எனக்கு மகிழ்ச்சி இல்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீங்கள் என் முன்னிலையில் வரும்போது,","poem":1},{"text":"இவற்றையெல்லாம் கொண்டுவந்து,","poem":2},{"lineBreak":true},{"text":"இப்படி என் பிராகாரங்களை மிதிக்கவேண்டுமென உங்களிடம் கூறியவர் யார்?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"உங்களது அர்த்தமற்ற காணிக்கைகளைக் கொண்டுவருவதை நிறுத்துங்கள்!","poem":1},{"text":"உங்கள் தூபம் எனக்கு அருவருப்பாயிருக்கிறது.","poem":2},{"text":"அமாவாசை நாட்கள், ஓய்வுநாட்கள், சபைக்கூட்டங்கள் போன்ற","poem":1},{"text":"ஒழுங்கற்ற ஒன்றுகூடுதலை இனி என்னால் சகிக்க முடியாது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"உங்களது அமாவாசை நாட்களையும்,","poem":1},{"text":"உங்கள் பண்டிகைகளையும் என் ஆத்துமா வெறுக்கிறது.","poem":2},{"text":"அவை எனக்கு சுமையாகிவிட்டன;","poem":1},{"text":"நான் அவைகளைச் சுமந்து களைத்துப் போனேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீங்கள் ஜெபிப்பதற்காகக் கைகளை உயர்த்தும்போது,","poem":1},{"text":"நான் உங்களிடமிருந்து என் கண்களை மறைத்துக்கொள்வேன்;","poem":2},{"text":"அநேக ஜெபங்களைச் செய்தாலும்,","poem":1},{"text":"நான் செவிகொடுக்கமாட்டேன்.","poem":2},{"lineBreak":true},{"text":"“ஏனெனில் உங்கள் கைகள் குற்றமற்ற இரத்தக் கறையால் நிறைந்திருக்கின்றது!","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“உங்களைக் கழுவி சுத்திகரியுங்கள்.","poem":1},{"text":"உங்கள் கொடிய செயல்களை எனது பார்வையிலிருந்து நீக்கி,","poem":2},{"lineBreak":true},{"text":"தீமை செய்வதை நிறுத்துங்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"சரியானதைச் செய்யக் கற்றுக்கொள்ளுங்கள்; நீதியைத் தேடுங்கள்.","poem":1},{"text":"ஒடுக்கப்பட்டவர்களுக்கு உதவுங்கள்.","poem":2},{"text":"திக்கற்றவர்களுக்கு நியாயம் செய்யுங்கள்;","poem":1},{"text":"விதவைக்காக வழக்காடுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“வாருங்கள், இப்பொழுது நாம் வழக்காடுவோம்”","poem":1},{"text":"என்று யெகோவா கூறுகிறார்.","poem":2},{"text":"“உங்கள் பாவங்கள் செந்நிறமாய் இருந்தாலும்,","poem":1},{"text":"பனிபோல் வெண்மையாகும்;","poem":2},{"text":"அவை கருஞ்சிவப்பாய் இருந்தாலும்,","poem":1},{"text":"பஞ்சைப்போல் வெண்மையாகும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"நீங்கள் இணங்கிக் கீழ்ப்படிந்தால்,","poem":1},{"text":"நாட்டின் சிறந்த பலனைச் சாப்பிடுவீர்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ஆனால் எதிர்த்துக் கலகம் பண்ணுவீர்களாயின்,","poem":1},{"text":"நீங்கள் பட்டயத்துக்கு இரையாவீர்கள்.”","poem":2},{"text":"யெகோவாவின் வாயே இவற்றை சொல்லியிருக்கிறது.","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"பாருங்கள், எவ்வளவு உண்மையாய் இருந்த பட்டணம்","poem":1},{"text":"இப்படி வேசியாயிற்று!","poem":2},{"text":"முன்பு அது நியாயத்தால் நிரம்பியிருந்தது;","poem":1},{"text":"நீதி அதில் குடியிருந்ததே,","poem":2},{"lineBreak":true},{"text":"இப்பொழுதோ அது கொலைகாரரின் வசிப்பிடமாயிருக்கிறது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"உன் வெள்ளி களிம்பாகிவிட்டது,","poem":1},{"text":"உன் சிறந்த திராட்சை இரசம் தண்ணீர் கலப்பாயிற்று.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"உனது ஆளுநர்கள் கலகக்காரர்,","poem":1},{"text":"திருடரின் தோழர்;","poem":2},{"text":"ஒவ்வொருவரும் இலஞ்சத்தை விரும்பி,","poem":1},{"text":"வெகுமதியை நாடி விரைகிறார்கள்.","poem":2},{"text":"அநாதைகளுக்கு நியாயம் செய்யாதிருக்கிறார்கள்;","poem":1},{"text":"விதவையின் வழக்கை எடுத்துப் பேசாதிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ஆகவே, யெகோவா, எல்லாம் வல்ல யெகோவாவாகிய","poem":1},{"text":"இஸ்ரயேலின் வல்லவர் அறிவிக்கிறார்:","poem":2},{"text":"“ஓ! நான் என் எதிரிகளிடமிருந்து விடுதலையடைந்து","poem":1},{"text":"என் பகைவர்களைப் பழிவாங்குவேன்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நான் என் கரத்தை உனக்கு எதிராகத் திருப்புவேன்;","poem":1},{"text":"நான் உனது களிம்பு முற்றிலும் நீங்க உன்னை உருக்கி,","poem":2},{"lineBreak":true},{"text":"உன் அசுத்தங்கள் அனைத்தையும் அப்புறப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"முந்தைய நாட்களில் இருந்ததுபோல்,","poem":1},{"text":"நான் உன்னுடைய நியாயதிபதிகளைத் திரும்பவும் அமர்த்துவேன்.","poem":2},{"text":"ஆரம்பத்தில் இருந்ததுபோலவே உன் ஆலோசகர்களையும் மீண்டும் தருவேன்.","poem":1},{"text":"அதன்பின் நீ நீதியின் நகரம் என்றும்,","poem":2},{"lineBreak":true},{"text":"உண்மையுள்ள நகரம் என்றும் அழைக்கப்படுவாய்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"சீயோன் நியாயத்தினாலும்,","poem":1},{"text":"அங்கு மனந்திரும்புவோர் நீதியினாலும் மீட்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ஆனால் கலகக்காரரும் பாவிகளும் ஒருமித்து நொறுக்கப்படுவார்கள்;","poem":1},{"text":"யெகோவாவைவிட்டு விலகுகிறவர்களோ அழிந்துபோவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“நீங்கள் விருப்பத்துடன் வணங்கிய","poem":1},{"text":"புனித கர்வாலி மரங்களின் நிமித்தம் வெட்கப்படுவீர்கள்;","poem":2},{"text":"நீங்கள் வழிபாட்டுக்கெனத் தெரிந்துகொண்ட","poem":1},{"text":"தோட்டங்களினிமித்தம் அவமானப்படுவீர்கள்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"நீங்கள் இலையுதிர்ந்த கர்வாலி மரம் போலவும்,","poem":1},{"text":"தண்ணீரில்லாத தோட்டம்போலவும் இருப்பீர்கள்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"வலிமையுள்ளவன் காய்ந்த கூளம் போலவும்","poem":1},{"text":"அவனுடைய செயல் ஒரு நெருப்புப்பொறியும் போலாகி,","poem":2},{"text":"இரண்டும் அணைப்பாரின்றி","poem":1},{"text":"ஏகமாய் எரிந்துபோகும்.”","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"சீயோனின் மகள் அல்லது எருசலேம் பட்டணம்.","reference":{"chapter":1,"verse":8}}]},"thisChapterLink":"/api/tam_tcv/ISA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/SNG/8.json","previousChapterAudioLinks":{},"numberOfVerses":31}