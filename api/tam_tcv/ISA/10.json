{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"அநீதியான சட்டங்களை இயற்றி,","poem":1},{"text":"ஒடுக்குகிற கட்டளைகளைப் பிறப்பிக்கிறவர்களுக்கு ஐயோ கேடு!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர்கள் ஏழைகளின் உரிமைகளைப் பறிப்பதற்கும்,","poem":1},{"text":"என் மக்களில் ஒடுக்கப்பட்டோருக்கு நீதி வழங்காதிருப்பதற்கும்,","poem":2},{"text":"விதவைகளைத் தங்களுக்கு இரையாக்குவதற்கும்,","poem":1},{"text":"அநாதைகளின் சொத்தை அபகரிப்பதற்குமே இந்தக் கட்டளைகளைப் பிறப்பிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உங்களுக்குத் தண்டனை வரும் நாளிலும்,","poem":1},{"text":"தூரத்திலிருந்து அழிவு வரும்போதும் என்ன செய்வீர்கள்?","poem":2},{"text":"யாரிடம் உதவிக்கு ஓடுவீர்கள்?","poem":1},{"text":"உங்கள் செல்வங்களை எங்கு வைப்பீர்கள்?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"கைதிகளுக்கிடையில் பதுங்குவதையும்,","poem":1},{"text":"கொலையுண்டவர்களுக்கிடையில் விழுவதையும்விட, உங்களுக்கு வேறு கதி இராது.","poem":2},{"lineBreak":true},{"text":"இவையெல்லாம் நடந்தும் அவரது கோபம் தீராமல்,","poem":1},{"text":"அவரது கரம் இன்னும் ஓங்கியபடியே இருக்கிறது.","poem":2}]},{"type":"heading","content":["அசீரியாவின்மேல் நியாயத்தீர்ப்பு"]},{"type":"verse","number":5,"content":[{"text":"“எனது கோபத்தின் கோலாய் இருக்கிற அசீரியனுக்கு ஐயோ கேடு!","poem":1},{"text":"அவனுடைய கையில் எனது கடுங்கோபத்தின் தண்டாயுதம் இருக்கிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் அவனை இறைவனை மறுதலிக்கிற ஒரு நாட்டுக்கு விரோதமாக அனுப்பி,","poem":1},{"text":"எனக்குக் கோபமூட்டும் மக்களைக்","poem":2},{"text":"கொள்ளையிட்டு சூறையாடி, பறித்து,","poem":1},{"text":"தெருவிலுள்ள சேற்றை மிதிப்பதுபோல் அவர்களை மிதித்துப் போடவும்","poem":2},{"lineBreak":true},{"text":"நான் அவனுக்கு கட்டளை கொடுக்கிறேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனால் அசீரிய அரசன் எண்ணுவது இதுவல்ல;","poem":1},{"text":"அவனுடைய மனதில் இருப்பதும் இதுவல்ல,","poem":2},{"text":"பல நாடுகளை அழித்து","poem":1},{"text":"அவர்களுக்கு ஒரு முடிவைக் கொண்டுவருவதே அவனுடைய நோக்கம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவன் சொல்கிறதாவது, ‘எனது தளபதிகள் எல்லோருமே அரசர்கள் அல்லவா?","poem":1}]},{"type":"verse","number":9,"content":[{"text":"கல்னோ பட்டணம் கர்கேமிஷைப்போல் ஆகவில்லையா?","poem":2},{"text":"ஆமாத் அர்பாத்தைப்போல் ஆகவில்லையா?","poem":1},{"text":"சமாரியா தமஸ்குவைப்போல் ஆகவில்லையா?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எருசலேமிலும், சமாரியாவிலும் உள்ள உருவச்சிலைகளைவிட","poem":1},{"text":"சிறந்த உருவச்சிலைகளின் அரசுகளை நான் கைப்பற்றினேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"சமாரியாவுக்கும் அதன் விக்கிரகங்களுக்கும் செய்ததுபோல,","poem":1},{"text":"எருசலேமுக்கும், அதன் விக்கிரகங்களுக்கும் செய்யமாட்டேனோ?’ ”","poem":2}]},{"type":"verse","number":12,"content":["யெகோவா சீயோன் மலைக்கும் எருசலேமுக்கும் விரோதமாக தனது செயல்கள் அனைத்தையும் செய்துமுடித்ததும், “நான் அசீரிய அரசனின் இருதய மேட்டிமைக்கும், அவனுடைய கண்களின் அகங்காரத்துக்கும் அவனைத் தண்டிப்பேன்” என்பார்."]},{"type":"verse","number":13,"content":["ஏனெனில் அவன் சொல்கிறதாவது:",{"text":"“ ‘எனது கரத்தின் வல்லமையாலும்,","poem":1},{"text":"எனது ஞானத்தினாலும் அறிவினாலும்","poem":2},{"text":"நான் இதைச் செய்தேன்,","poem":1},{"text":"நான் பல நாடுகளின் எல்லைகளை அகற்றினேன், அவர்களுடைய செல்வங்களைச் சூறையாடினேன்,","poem":2},{"lineBreak":true},{"text":"பெரும் வல்லவனைப்போல் அவர்களின் அரசர்களை அடக்கிக் கீழ்ப்படுத்தினேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஒருவன் பறவைகளின் கூட்டிற்குள் எட்டிக் கைவிடுவதுபோல்,","poem":1},{"text":"நாடுகளின் செல்வத்தை எடுப்பதற்கு என் கை நீட்டப்பட்டது.","poem":2},{"text":"கைவிடப்பட்ட முட்டைகளை மனிதர் சேர்ப்பதுபோல்,","poem":1},{"text":"எல்லா நாடுகளையும் நான் ஒன்றாகச் சேர்த்தேன்.","poem":2},{"text":"ஒன்றாவது சிறகை அடிக்கவுமில்லை,","poem":1},{"text":"கூச்சலிடுவதற்காக வாயைத் திறக்கவுமில்லை.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"கோடரி தன்னைத் தூக்குபவனைவிட மேலானதோ?","poem":1},{"text":"வாள் தன்னை உபயோகிக்கிறவனுக்கு மேலாகத் தற்பெருமை கொள்ளுமோ?","poem":2},{"lineBreak":true},{"text":"அப்படியானால், வீசி அடிப்பதற்காக ஒருவன் ஒரு தடியை எடுக்க,","poem":2},{"text":"அந்தத் தடியோ தன்னை எடுத்தவனையே தூக்கி சுழற்றுவதுபோல் இருக்குமே.","poem":1},{"text":"மரத்தாலான தண்டாயுதம், தானாகவே எழுந்து நின்று,","poem":2},{"lineBreak":true},{"text":"மரமல்லாத மனிதனைத் தூக்கி சுழற்றுவதுபோல் இருக்குமே.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆகையால் யெகோவா, சேனைகளின் யெகோவா","poem":1},{"text":"அவனுடைய பலமுள்ள இராணுவவீரர்களுக்குள் உருக்கும் நோயை அனுப்புவார்.","poem":2},{"text":"அவனுடைய பகட்டான ஆடம்பரத்தின்கீழ்","poem":1},{"text":"எரியும் சுவாலை போன்ற தீயை மூட்டுவார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இஸ்ரயேலின் ஒளியானவர், நெருப்பாகவும்,","poem":1},{"text":"அவர்களுடைய பரிசுத்தர் கொழுந்துவிட்டு எரியும் நெருப்பாகவும் வருவார்.","poem":2},{"text":"அவர் அவனுடைய முட்செடிகளையும்,","poem":1},{"text":"அவனுடைய நெருஞ்சில் செடிகளையும் ஒரே நாளில் எரித்துப்போடுவார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நோயுற்ற ஒருவன் நலிந்துபோவது போல,","poem":1},{"text":"அவனுடைய காடுகளிலும் வளமுள்ள வயல்களிலும் உள்ள","poem":2},{"lineBreak":true},{"text":"செழிப்பு முற்றிலும் அழிந்துவிடும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவனுடைய காடுகளில் மீதமிருக்கும் மரங்களின் தொகை,","poem":1},{"text":"ஒரு சிறுபிள்ளைகூட எண்ணக்கூடியதாய் குறைந்திருக்கும்.","poem":2}]},{"type":"heading","content":["இஸ்ரயேலின் மிகுதியானோர்"]},{"type":"verse","number":20,"content":[{"text":"அந்த நாளில் இஸ்ரயேலில் மீதியிருப்போரும்,","poem":1},{"text":"யாக்கோபின் குடும்பத்தில் தப்பியிருப்போரும்","poem":2},{"noteId":10},{"text":"தங்களை முறியடித்தவன்மேல்","poem":1},{"text":"இனியொருபோதும் நம்பிக்கை வைக்கமாட்டார்கள்.","poem":2},{"text":"ஆனால் இஸ்ரயேலின் பரிசுத்தராகிய யெகோவாவிலேயே","poem":1},{"text":"உண்மையான நம்பிக்கையை வைப்பார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"மீதியிருப்பவர்கள் திரும்புவார்கள்,","poem":1},{"text":"யாக்கோபின் குடும்பத்தில் மீதியிருப்பவர்கள் வல்ல இறைவனிடம் திரும்புவார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"இஸ்ரயேலே, உன் மக்கள் இப்பொழுது கடற்கரை மணல்போல் இருந்தபோதிலும்,","poem":1},{"text":"மீதமிருக்கும் சிலர் மட்டுமே திரும்புவார்கள்.","poem":2},{"text":"மூழ்கடிக்கும் அழிவு ஒன்று கட்டளையிடப்பட்டிருக்கிறது;","poem":1},{"text":"அது நீதியானது.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நாடு முழுவதற்கும் கட்டளையிடப்பட்ட அழிவை யெகோவா,","poem":1},{"text":"சேனைகளின் யெகோவா நிறைவேற்றுவார்.","poem":2}]},{"type":"verse","number":24,"content":["ஆகையால் யெகோவா, சேனைகளின் யெகோவா சொல்வது இதுவே:",{"text":"“சீயோனில் வாழும் என் மக்களே,","poem":1},{"text":"எகிப்தியர் செய்ததுபோல, உங்களைப் பிரம்பால் அடித்து,","poem":2},{"text":"தண்டாயுதத்தை உயர்த்துகிற","poem":1},{"text":"அசீரியருக்குப் பயப்படவேண்டாம்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உங்களுக்கு விரோதமாக இருக்கும் என் கோபம், வெகுவிரைவில் முடிந்துவிடும்.","poem":1},{"text":"எனது கோபமோ, சீரியர்களுடைய அழிவை நோக்கித் திருப்பப்படும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ஓரேப் மலையில் மீதியானியரை அடித்து வீழ்த்தியதுபோல,","poem":1},{"text":"சேனைகளின் யெகோவா அவர்களைச் சவுக்கால் அடிப்பார்.","poem":2},{"text":"எகிப்தில் செய்ததுபோல,","poem":1},{"text":"தம் கோலை கடலின்மேல் உயர்த்துவார்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அந்த நாளில் அசீரியனால் உங்களுக்கு உண்டான சுமையோ,","poem":1},{"text":"உங்கள் தோள்களில் இருந்து நீக்கப்படும்;","poem":2},{"text":"அவர்களுடைய நுகம் உங்கள் கழுத்திலிருந்து அகற்றப்படும்,","poem":1},{"text":"நீங்கள் கொழுத்திருக்கிறபடியால் நுகம் முறிந்துவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"அசீரியர் ஆயாத் பட்டணத்திற்குள் செல்கிறார்கள்.","poem":1},{"text":"மிக்ரோனு வழியாகப் போகிறார்கள்","poem":2},{"lineBreak":true},{"text":"மிக்மாஷாவிலே தமது பொருட்களை வைக்கிறார்கள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர்கள் கணவாயைத் தாண்டிச் சென்று சொல்கிறதாவது:","poem":1},{"text":"“நாம் கேபாவில் இரவு தங்குவோம்.”","poem":2},{"text":"ராமா நடுங்குகிறது;","poem":1},{"text":"சவுலின் பட்டணமாகிய கிபியாவின் மக்கள் பயந்து ஓடுகிறார்கள்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"காலீம் மகளே, ஓலமிடு!","poem":1},{"text":"லாயிஷாவே, கேள்!","poem":2},{"lineBreak":true},{"text":"பரிதாபத்திற்குரிய ஆனதோத்தே!","poem":2}]},{"type":"verse","number":31,"content":[{"text":"மத்மேனாவில் உள்ளவர்கள் தப்பி ஓடுகிறார்கள்;","poem":1},{"text":"கேபீம் மக்கள் ஓடி ஒளிந்துகொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"இந்த நாளிலே, அவர்கள் நோபிலே தங்குவார்கள்;","poem":1},{"text":"எருசலேம் மலையிலுள்ள சீயோன் மகளின்","poem":2},{"text":"மேட்டுக்கு விரோதமாய்,","poem":1},{"text":"கைநீட்டி மிரட்டுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"பாருங்கள், யெகோவா, சேனைகளின் யெகோவா,","poem":1},{"text":"மிக்க வல்லமையோடு பெரிய கிளைகளை வெட்டிவிடுவார்.","poem":2},{"text":"பெரு மரங்கள் வீழ்த்தப்படும்,","poem":1},{"text":"ஓங்கி வளர்ந்த மரங்கள் தாழ்த்தப்படும்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"அவர் காட்டுப் புதர்களை கோடரியால் வெட்டி வீழ்த்துவார்;","poem":1},{"text":"எல்லாம் வல்ல இறைவனின் முன்னே லெபனோன் வீழ்ந்துவிடும்.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"அசீரியாவின் அரசன்","reference":{"chapter":10,"verse":20}}]},"thisChapterLink":"/api/tam_tcv/ISA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/9.json","previousChapterAudioLinks":{},"numberOfVerses":34}