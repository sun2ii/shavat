{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":11,"content":[{"type":"heading","content":["ஈசாயின் கிளை"]},{"type":"verse","number":1,"content":[{"text":"ஈசாயின் அடிமரத்திலிருந்து ஒரு துளிர் வரும்;","poem":1},{"text":"அவனுடைய வேர்களிலிருந்து வரும் ஒரு கிளை கனிகொடுக்கும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவின் ஆவியானவர் அவரில் தங்குவார்.","poem":1},{"text":"ஞானத்தையும், விளங்கும் ஆற்றலையும், ஆலோசனையையும்,","poem":2},{"lineBreak":true},{"text":"பெலனையும், அறிவையும், யெகோவாவுக்குப் பயப்படுகிற பயத்தையும்","poem":2},{"lineBreak":true},{"text":"அருளும் ஆவியானவரே அவரில் தங்குவார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவரும் யெகோவாவுக்குப் பயந்து நடப்பதில் மகிழ்ச்சிகொள்வார்.","poem":1},{"lineBreak":true},{"text":"அவர் தம் கண்களால் காண்பதைக்கொண்டு மட்டும் நியாயந்தீர்க்கமாட்டார்;","poem":1},{"text":"காதுகள் கேட்பதால் தீர்மானம் எடுக்கவுமாட்டார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால் அவர் எளியவர்களை நீதியுடன் நியாயந்தீர்த்து,","poem":1},{"text":"பூமியிலுள்ள ஏழைகளுக்காக நியாயத்துடன் தீர்ப்பளிப்பார்.","poem":2},{"text":"அவர் தன் வார்த்தை என்னும் கோலினால் பூமியை அடிப்பார்,","poem":1},{"text":"தனது உதடுகளின் மூச்சால் கொடியவர்களைக் கொல்வார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீதி அவரது அரைக்கச்சையாகவும்,","poem":1},{"text":"உண்மை அவரின் இடைக்கச்சையாகவும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ஆட்டுக்குட்டியுடன் ஓநாய் வசிக்கும்,","poem":1},{"text":"சிறுத்தை வெள்ளாட்டுடன் படுத்துக்கிடக்கும்.","poem":2},{"text":"பசுங்கன்றும், சிங்கமும், கொழுத்த காளையும் ஒன்றாய் வாழும்;","poem":1},{"text":"ஒரு சிறுபிள்ளை அவைகளை வழிநடத்தும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"பசு கரடியுடன் மேயும்,","poem":1},{"text":"அவைகளின் குட்டிகளும் சேர்ந்து படுத்திருக்கும்;","poem":2},{"lineBreak":true},{"text":"மாட்டைப்போல் சிங்கமும் வைக்கோல் தின்னும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பால் குடிக்கும் குழந்தை நாகப்பாம்பின் புற்றினருகே விளையாடும்;","poem":1},{"text":"சிறுபிள்ளை விரியன் பாம்பின் புற்றுக்குள் தன் கையை வைக்கும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எனது பரிசுத்த மலையெங்கும்","poem":1},{"text":"தீங்கு செய்பவரோ அழிப்பவரோ எவருமில்லை.","poem":2},{"text":"ஏனென்றால் கடல் தண்ணீரினால் நிறைந்திருப்பதுபோல,","poem":1},{"text":"பூமி யெகோவாவைப்பற்றிய அறிவினால் நிறைந்திருக்கும்.","poem":2}]},{"type":"verse","number":10,"content":["அந்த நாளிலே ஈசாயின் வேர் மக்களுக்கு ஒரு கொடியாக நிற்பார்; பிறநாடுகள் அவரிடம் கூடிவரும். அவர் இருக்கும் இடம் மகிமையுள்ளதாயிருக்கும்."]},{"type":"verse","number":11,"content":["அந்த நாளில் யெகோவா அசீரியா, எகிப்து, பத்ரோஸ் எத்தியோப்பியா, ஏலாம், சிநெயார், ஆமாத், தொலைதூர கடற்தீவுகள் ஆகிய இடங்களிலிருந்து தம் மக்களில் மீதமிருப்பவர்களை மீட்க இரண்டாம் முறையும் தமது கரத்தை நீட்டுவார்."]},{"type":"verse","number":12,"content":[{"text":"அவர் எல்லா தேசத்தாருக்கும் ஒரு கொடியை ஏற்றி,","poem":1},{"text":"நாடுகடத்தப்பட்ட இஸ்ரயேல் மக்களை ஒன்றுசேர்ப்பார்.","poem":2},{"text":"சிதறடிக்கப்பட்டிருந்த யூதா மக்களை,","poem":1},{"text":"பூமியின் நான்கு திசைகளிலுமிருந்து ஒன்றுகூட்டுவார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அப்பொழுது எப்பிராயீமின் பொறாமை ஒழிந்துபோகும்,","poem":1},{"text":"யூதாவின் பகைவர் அகற்றப்படுவார்கள்;","poem":2},{"text":"எப்பிராயீம் யூதாவின்மேல் பொறாமைகொள்ளவோ,","poem":1},{"text":"யூதா எப்பிராயீமைப் பகைக்கவோ மாட்டாது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்கள் மேற்குத் திசையில் உள்ள பெலிஸ்திய மலைச்சாரலின்மேல்","poem":1},{"text":"திடீரெனப் பாய்வார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் ஒன்றிணைந்து கிழக்கிலே இருப்பவர்களையும் சூறையாடுவார்கள்.","poem":2},{"text":"அவர்கள் ஏதோமையும், மோவாபையும் கைப்பற்றுவார்கள்;","poem":1},{"text":"அம்மோனிய மக்கள் அவர்களுக்கு அடிமைகளாவார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"யெகோவா எகிப்தின் வளைகுடா கடலை","poem":1},{"text":"முழுவதும் வற்றப்பண்ணுவார்;","poem":2},{"text":"யூப்ரட்டீஸ் நதியின்மேல்","poem":1},{"text":"ஒரு வெப்பக் காற்றுடன் தமது கரத்தை வீசி அடிப்பார்.","poem":2},{"text":"மக்கள் உலர்ந்த நிலத்தில் நடக்கக் கூடியதாக","poem":1},{"text":"அவர் அதை ஏழு நீரோடைகளாகப் பிரிப்பார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"இஸ்ரயேலர் எகிப்திலிருந்து வரும்போது,","poem":1},{"text":"அவர்களுக்குப் பாதை இருந்ததுபோல,","poem":2},{"text":"அசீரிய நாட்டில் மீதமிருக்கும் அவரது மக்கள் திரும்பி வருவதற்கும்,","poem":1},{"text":"பெரும்பாதை ஒன்று இருக்கும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/10.json","previousChapterAudioLinks":{},"numberOfVerses":16}