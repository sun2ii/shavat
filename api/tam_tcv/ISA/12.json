{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":12,"content":[{"type":"heading","content":["துதியின் கீதங்கள்"]},{"type":"verse","number":1,"content":["அந்த நாளிலே நீ:",{"text":"“யெகோவாவே உம்மைத் துதிப்பேன்.","poem":1},{"text":"என்னில் கோபமாயிருந்தபோதிலும்,","poem":2},{"text":"உமது கோபம் தணிந்து","poem":1},{"text":"என்னைத் தேற்றியிருக்கிறீர்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நிச்சயமாய் இறைவனே என் இரட்சிப்பு;","poem":1},{"text":"நான் பயப்படாமல் நம்பிக்கையாயிருப்பேன்.","poem":2},{"text":"யெகோவா, யெகோவாவே என் பெலன், என் பாடல்;","poem":1},{"text":"அவரே எனது இரட்சிப்பும் ஆகினார்” என்று சொல்வாய்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீ இரட்சிப்பின் கிணறுகளிலிருந்து","poem":1},{"text":"மகிழ்வுடன் தண்ணீரை மொண்டுகொள்ளுவாய்.","poem":2}]},{"type":"verse","number":4,"content":["அந்த நாளிலே நீங்கள் சொல்வதாவது:",{"text":"“யெகோவாவுக்கு நன்றி செலுத்துங்கள், அவருடைய பெயரைப் போற்றுங்கள்;","poem":1},{"text":"அவருடைய செயல்களை நாடுகள் மத்தியில் தெரியப்படுத்துங்கள்,","poem":2},{"lineBreak":true},{"text":"அவருடைய பெயர் உயர்ந்ததென்று பிரசித்தப்படுத்துங்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவா மகிமையான காரியங்களைச் செய்தபடியால் அவரைப் போற்றிப்பாடுங்கள்;","poem":1},{"text":"உலகம் முழுவதற்கும் இது அறிவிக்கப்படட்டும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"சீயோனின் மக்களே, ஆனந்த சத்தமிட்டு ஆர்ப்பரித்துப் பாடுங்கள்;","poem":1},{"text":"ஏனெனில் உங்கள் மத்தியில் இஸ்ரயேலின் பரிசுத்தர்","poem":2},{"lineBreak":true},{"text":"மேன்மையுள்ளவராய் விளங்குகிறார்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}