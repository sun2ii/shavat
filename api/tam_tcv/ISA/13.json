{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":13,"content":[{"type":"heading","content":["பாபிலோனுக்கு எதிரான இறைவாக்கு"]},{"type":"verse","number":1,"content":["ஆமோஸின் மகன் ஏசாயா பாபிலோனைப்பற்றிக் கண்ட தரிசனத்தில் கூறப்பட்ட இறைவாக்கு:"]},{"type":"verse","number":2,"content":[{"text":"வறண்ட மலையுச்சியில் கொடியேற்றுங்கள்,","poem":1},{"text":"போர்வீரர்களை கூப்பிடுங்கள்;","poem":2},{"text":"உயர்குடி மக்களின் வாசல்களுக்குள் போகும்படி","poem":1},{"text":"அவர்களை அழையுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எனது பரிசுத்தவான்களுக்கு கட்டளையிட்டிருக்கிறேன்;","poem":1},{"text":"எனது கோபத்தை நிறைவேற்ற என் போர்வீரர்களை அழைத்திருக்கிறேன்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் என் வெற்றியில் களிகூறுகிறவர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"கேளுங்கள், மலைகளின்மேல் ஒரு சத்தம் கேட்கிறது!","poem":1},{"text":"அது பெருந்திரளான மக்களின் இரைச்சல் போலிருக்கிறது.","poem":2},{"text":"கேளுங்கள், ராஜ்யங்களின் மத்தியில் பெருமுழக்கம் கேட்கிறது!","poem":1},{"text":"அது பல நாடுகள் ஒன்றுசேர்வது போன்ற ஆரவாரமாயிருக்கிறது.","poem":2},{"text":"சேனைகளின் யெகோவா","poem":1},{"text":"போருக்கு ஒரு படையைத் திரட்டுகிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தூர நாடுகளிலிருந்து அவர்கள் வருகிறார்கள்;","poem":1},{"text":"தொடுவானங்களின் எல்லைகளிலிருந்து வருகிறார்கள்.","poem":2},{"text":"முழு நாட்டையும் அழித்தொழிக்க","poem":1},{"text":"யெகோவா தமது கோபத்தின் ஆயுதங்களுடன் வருகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அழுது புலம்புங்கள், யெகோவாவினுடைய நியாயத்தீர்ப்பின் நாள் சமீபமாகிவிட்டது;","poem":1},{"text":"அந்த நாள் எல்லாம் வல்லவரிடமிருந்து பேரழிவைப்போல் வரும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இதனால் கைகளெல்லாம் தளர்ந்து போகும்;","poem":1},{"text":"எல்லா மனிதரின் இருதயமும் உருகிப்போகும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்களைத் திகில் பற்றிக்கொள்ளும்,","poem":1},{"text":"வலியும் வேதனையும் அவர்களைப் பிடித்துக்கொள்ளும்;","poem":2},{"lineBreak":true},{"text":"பிரசவ வேதனைப்படும் பெண்ணைப்போல் அவர்கள் துடிப்பார்கள்.","poem":2},{"text":"அவர்கள் வெட்கத்தினால் முகம் சிவக்க","poem":1},{"text":"ஒருவரையொருவர் வியப்புடன் பார்ப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"பாருங்கள், யெகோவாவினுடைய நியாயத்தீர்ப்பின் நாள் வருகிறது;","poem":1},{"text":"அது கொடுமையின் நாள், நாட்டைப் பாழாக்குவதற்கும்,","poem":2},{"text":"அங்குள்ள பாவிகளை தண்டிப்பதற்கும்,","poem":1},{"text":"கோபத்துடனும் கடுங்கோபத்துடனும் அது வருகிறது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"வானத்து நட்சத்திரங்களும்,","poem":1},{"text":"நட்சத்திரக் கூட்டங்களும் தங்கள் ஒளியைக் கொடாதிருக்கும்.","poem":2},{"text":"சூரியன் உதிக்கும்போது இருண்டுபோகும்;","poem":1},{"text":"சந்திரனும் தன் ஒளியைக் கொடாதிருக்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான் உலகத்தை அதன் தீமைக்காகவும்,","poem":1},{"text":"கொடியவரை அவர்களுடைய பாவங்களுக்காகவும் தண்டிப்பேன்.","poem":2},{"text":"துன்மார்க்கரின் அகந்தைக்கும் நான் முடிவு செய்வேன்;","poem":1},{"text":"இரக்கமற்றவர்களின் பெருமையைத் தாழ்த்துவேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"சிறந்த தங்கத்தைப் பார்க்கிலும்,","poem":1},{"text":"ஓப்பீர் நாட்டின் தங்கத்தைப் பார்க்கிலும் நான் மனிதரை அபூர்வமாக்குவேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆகையால் நான் வானங்களை நடுங்கப்பண்ணுவேன்;","poem":1},{"text":"பூமி தன் நிலையிலிருந்து அசையும்.","poem":2},{"text":"எல்லாம் வல்ல யெகோவாவின் கோபம் பற்றியெரியும் நாளில்,","poem":1},{"text":"அவருடைய கோபத்தில் இது நடக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"அப்பொழுது வேட்டையாடப்படும் மானைப்போலவும்,","poem":1},{"text":"மேய்ப்பனில்லாத செம்மறியாட்டைப் போலவும்,","poem":2},{"text":"ஒவ்வொருவனும் தன் சொந்த மக்களிடம் திரும்புவான்;","poem":1},{"text":"ஒவ்வொருவனும் தன் சொந்த நாட்டுக்குத் தப்பியோடுவான்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"கைதியாக்கப்பட்டவன் குத்தப்படுவான்;","poem":1},{"text":"அகப்பட்டவன் வாளினால் சாவான்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர்களுடைய குழந்தைகள் அவர்கள் கண்களின்முன்","poem":1},{"text":"மோதியடிக்கப்பட்டு, துண்டுகளாக்கப்படுவார்கள்;","poem":2},{"text":"அவர்களுடைய வீடுகள் கொள்ளையிடப்படும்,","poem":1},{"text":"அவர்களுடைய மனைவிகள் அவமானப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"பாருங்கள், மேதியரை நான் அவர்களுக்கு எதிராக எழுப்புவேன்;","poem":1},{"text":"அவர்கள் வெள்ளியை மதியாதவர்கள்,","poem":2},{"lineBreak":true},{"text":"தங்கத்தில் மகிழ்ச்சி கொள்ளாதவர்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்களின் வில்லுகள் வாலிபரைத் தாக்கி வீழ்த்தும்;","poem":1},{"text":"அவர்கள் குழந்தைகளுக்கு இரக்கம் காட்டமாட்டார்கள்,","poem":2},{"lineBreak":true},{"text":"சிறுபிள்ளைகள்மேல் கருணை காட்டவுமாட்டார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"பாபிலோன், சோதோம் கொமோராவைப்போல்","poem":1},{"text":"இறைவனால் கவிழ்க்கப்படும்.","poem":2},{"text":"இதுவே அரசுகளின் மேன்மையாகவும்,","poem":1},{"text":"கல்தேயரின் பெருமையின் சிறப்பாகவும் இருந்தது.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"வரும் தலைமுறைகளில் ஒருவரும் இனியொருபோதும் அங்கு குடியேறவோ,","poem":1},{"text":"வசிக்கவோ மாட்டார்கள்.","poem":2},{"text":"அரேபியன் எவனும் அங்கு தனது கூடாரத்தைப் போடமாட்டான்.","poem":1},{"text":"மேய்ப்பன் தன் மந்தைகளை அங்கு இளைப்பாற விடவுமாட்டான்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஆனால் அங்கு பாலைவன மிருகங்கள் தங்கும்;","poem":1},{"text":"அவர்களுடைய வீடுகள் நரிகளால் நிரம்பும்.","poem":2},{"text":"ஆந்தைகள் அங்கே குடியிருக்கும்;","poem":1},{"text":"காட்டாடுகளும் அங்கே துள்ளி விளையாடும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அரண்செய்யப்பட்ட இடங்களில் ஓநாய்களும்,","poem":1},{"text":"அதன் அலங்காரமான அரண்மனைகளில் நரிகளும் ஊளையிடும்.","poem":2},{"text":"பாபிலோனுக்குரிய வேளை வந்துவிட்டது.","poem":1},{"text":"அதன் நாட்கள் நீடிக்காது.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/12.json","previousChapterAudioLinks":{},"numberOfVerses":22}