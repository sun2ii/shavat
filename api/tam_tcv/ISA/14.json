{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா யாக்கோபின்மேல் இரக்கம்கொள்வார்.","poem":1},{"text":"இஸ்ரயேலை மீண்டும் ஒருமுறை தெரிந்துகொண்டு,","poem":2},{"lineBreak":true},{"text":"அவர்களைத் தங்கள் சொந்த நாட்டில் குடியேற்றுவார்;","poem":2},{"text":"பிறநாட்டினரும் அவர்களோடு சேர்ந்து,","poem":1},{"text":"யாக்கோபின் குடும்பத்தாருடன் இணைந்துகொள்வார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பிறநாடுகள் இஸ்ரயேலுக்கு உதவிசெய்து,","poem":1},{"text":"அவர்களைத் தங்களுடைய சொந்த நாட்டுக்குக் கொண்டுவருவார்கள்.","poem":2},{"text":"இஸ்ரயேல் குடும்பத்தார் பல நாடுகளையும் தமக்குச் சொந்தமாக்கி,","poem":1},{"text":"யெகோவாவினுடைய நாட்டில் வேலைக்காரர்களாகவும்,","poem":2},{"text":"வேலைக்காரிகளாகவும் கையாளுவார்கள்.","poem":1},{"text":"தங்களைச் சிறைப்படுத்தியவர்களைச் சிறையாக்கி, தங்களை ஒடுக்கியவர்களை ஆளுவார்கள்.","poem":2}]},{"type":"verse","number":3,"content":["யெகோவா உங்கள் வேதனையிலும், துன்பத்திலும் கொடூரமான அடிமைத்தனத்திலுமிருந்து உங்களை மீட்டு, உங்களுக்கு ஆறுதல் தந்த நாளிலே,"]},{"type":"verse","number":4,"content":["நீங்கள் பாபிலோனிய அரசனுக்கு விரோதமாக இவ்வாறு கேலி செய்வீர்கள்:",{"text":"ஒடுக்கினவன் எவ்வாறு ஒழிந்துபோனான்;","poem":1},{"text":"அவன் கோபம் என்ன ஆனது?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆளுநரின் கொடுங்கோலை,","poem":1},{"text":"கொடியவரின் கோலை யெகோவா முறித்துவிட்டார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அந்தக் கொடுங்கோல் மக்கள் கூட்டங்களைத் தன்","poem":1},{"text":"கோபத்தில் ஓயாமல் அடித்து வீழ்த்தியது.","poem":2},{"text":"அது நாடுகளைத் தன் கடுங்கோபத்தில் ஓயாது துன்புறுத்தி,","poem":1},{"text":"அவர்களை அடக்கியது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நாடுகளெல்லாம் ஆறுதலடைந்து, சமாதானமாய் இருக்கின்றன;","poem":1},{"text":"அவர்கள் அகமகிழ்ந்து பாடுகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"தேவதாரு மரங்களும், லெபனோனின் கேதுரு மரங்களும்,","poem":1},{"text":"உன் வீழ்ச்சியில் மகிழ்ந்து சொல்கிறதாவது:","poem":2},{"text":"“பாபிலோனே, நீ கீழே வீழ்த்தித் தள்ளப்பட்டிருக்கிறாய்.","poem":1},{"text":"அதனால் இப்பொழுது எங்களை ஒரு மரவெட்டியும் அணுகவில்லை.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"கீழேயுள்ள பாதாளம் நீ வரும்போது,","poem":1},{"text":"உன்னைச் சந்திக்க பரபரப்படைகிறது.","poem":2},{"text":"அது உன்னை வரவேற்க மரித்தோரின் ஆவிகளை எழுப்புகிறது;","poem":1},{"text":"அவர்கள் உலகத்தின் தலைவர்களாய் இருந்தவர்கள்.","poem":2},{"text":"அது அவர்களைத் தங்கள் அரியணைகளிலிருந்து எழும்பச் செய்கிறது;","poem":1},{"text":"அவர்கள் மக்களுடைய அரசர்களாயிருந்தார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் எல்லோரும் உன்னிடம்,","poem":1},{"text":"“நீயும் எங்களைப்போல் பெலவீனமாகிவிட்டாய்;","poem":2},{"text":"நீயும் எங்களைப் போலாகிவிட்டாய்”","poem":1},{"text":"என்று சொல்வார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உனது பகட்டான ஆடம்பரமெல்லாம்,","poem":1},{"text":"உனது யாழோசையுடன் பாதாளத்திற்குக் கீழே கொண்டுவரப்பட்டிருக்கின்றன.","poem":2},{"text":"கூட்டுப் புழுக்கள் உனக்குக் கீழே பரவி,","poem":1},{"text":"புழுக்கள் உன்னை மூடுகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அதிகாலையின் மகனாகிய விடிவெள்ளியே,","poem":1},{"text":"நீ வானத்திலிருந்து விழுந்தாயே!","poem":2},{"text":"ஒருகாலத்தில் நாடுகளை வீழ்த்திய நீ,","poem":1},{"text":"பூமிக்குத் தள்ளப்பட்டு விட்டாயே!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீ உன் இருதயத்தில்,","poem":1},{"text":"“நான் வானத்திற்கு ஏறுவேன்;","poem":2},{"text":"இறைவனின் நட்சத்திரங்களுக்கு மேலாக","poem":1},{"text":"என் அரியணையை உயர்த்துவேன்.","poem":2},{"text":"பரிசுத்த மலையின் மிக உயரத்தில்,","poem":1},{"text":"சபைக்கூடும் மலையில் நான் அரியணையில் அமர்ந்திருப்பேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"மேகங்களின் மேலாக உயரத்தில் ஏறுவேன்;","poem":1},{"text":"மகா உன்னதமானவருக்கு ஒப்பாவேன்” என்று சொன்னாயே.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆனாலும் நீ பாதாளமட்டும் தாழ்த்தப்பட்டு,","poem":1},{"text":"படுகுழிக்குள் தள்ளப்பட்டாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"உன்னைக் காண்போர் உற்றுப்பார்ப்பார்கள்.","poem":1},{"text":"அவர்கள் உன் நிலையைச் சிந்தித்து,","poem":2},{"text":"“பூமியை நிலைகுலையச் செய்து","poem":1},{"text":"அரசுகளை நடுங்கப் பண்ணியவன் இவன்தானா?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"உலகத்தைப் பாலைவனமாக்கி,","poem":1},{"text":"பட்டணங்களைக் கவிழ்த்து,","poem":2},{"lineBreak":true},{"text":"கைதிகளை வீட்டிற்குத் திரும்பவிடாதவன் இவன்தானா?” என்று சொல்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"நாடுகளின் அரசர் அனைவரும்","poem":1},{"text":"அவரவர் தங்கள் கல்லறையில் சிறப்புடன் படுத்திருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ஆனால் நீயோ ஒதுக்கப்பட்ட கிளையைப்போல்","poem":1},{"text":"கல்லறைக்கு வெளியே எறியப்பட்டிருக்கிறாய்.","poem":2},{"text":"வாளால் வெட்டிக் கொல்லப்பட்ட","poem":1},{"text":"பிரேதங்களால் நீ மூடப்பட்டிருக்கிறாய்.","poem":2},{"lineBreak":true},{"text":"நீயும் அவர்களுடன் கற்குழிக்குள் எறியப்பட்டிருக்கிறாய்.","poem":2},{"text":"நீ காலின்கீழ் மிதிபடும் பிணத்தைப் போலானாய்.","poem":1}]},{"type":"verse","number":20,"content":[{"text":"அந்த அரசர்களுடன் நீ அடக்கம் செய்யப்படமாட்டாய்.","poem":2},{"text":"ஏனெனில் உனது நாட்டையே நீ அழித்து","poem":1},{"text":"உன் மக்களைக் கொன்றாய்.","poem":2},{"lineBreak":true},{"lineBreak":true},{"text":"கொடியவரின் சந்ததியினரைக் குறித்து","poem":1},{"text":"இனியொருபோதும் சொல்லப்பட மாட்டாது.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர்களுடைய முற்பிதாக்களின் பாவங்களுக்காக","poem":1},{"text":"அவர்களுடைய பிள்ளைகளைக் கொலைசெய்வதற்கு ஒரு இடத்தை ஆயத்தப்படுத்துங்கள்;","poem":2},{"text":"அவர்கள் எழுந்து நாட்டை உரிமையாக்கவோ,","poem":1},{"text":"பூமியைத் தங்கள் பட்டணங்களால் நிரப்பவோ கூடாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“நான் அவர்களுக்கு விரோதமாக எழும்புவேன்”","poem":1},{"text":"என்று சேனைகளின் யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“பாபிலோனின் பெயரையும், அங்கு தப்பியிருப்பவர்களையும்,","poem":1},{"text":"அவளுடைய சந்ததிகளையும் அகற்றிவிடுவேன்”","poem":2},{"lineBreak":true},{"text":"என யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"“மேலும், அவ்விடத்தை சதுப்பு நிலமாகவும்,","poem":1},{"text":"ஆந்தைகளின் வசிப்பிடமாகவும் ஆக்குவேன்;","poem":2},{"text":"அழிவின் துடைப்பத்தால் அவனைக் கூட்டித்தள்ளுவேன்”","poem":1},{"text":"என்று சேனைகளின் யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":24,"content":["சேனைகளின் யெகோவா ஆணையிட்டிருக்கிறார்:",{"text":"“நிச்சயமாக நான் திட்டமிட்டபடியே அது நடக்கும்,","poem":1},{"text":"என் நோக்கத்தின்படியே அது நிலைநிற்கும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நான் அசீரியனை என் நாட்டிலேயே முறியடிப்பேன்;","poem":1},{"text":"என் மலைகளிலேயே அவனை மிதித்துவிடுவேன்.","poem":2},{"text":"அவனுடைய நுகம் என் மக்களிடமிருந்து எடுக்கப்படும்;","poem":1},{"text":"அவனுடைய சுமை அவர்களின் தோள்களிலிருந்து நீக்கப்படும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"முழு உலகத்துக்கும் தீர்மானிக்கப்பட்ட திட்டம் இதுவே;","poem":1},{"text":"எல்லா நாடுகளுக்கும் மேலாக நீட்டப்பட்ட கரம் இதுவே.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"சேனைகளின் யெகோவா அதைத் தீர்மானித்திருக்கிறார்,","poem":1},{"text":"அவரைத் தடுக்க யாரால் முடியும்?","poem":2},{"text":"அவருடைய கை நீட்டப்பட்டிருக்கிறது,","poem":1},{"text":"அதை எவரால் திருப்ப முடியும்?","poem":2}]},{"type":"heading","content":["பெலிஸ்தியருக்கு எதிரான இறைவாக்கு"]},{"type":"verse","number":28,"content":["ஆகாஸ் அரசன் இறந்த வருடத்தில் இந்த இறைவாக்கு வந்தது:"]},{"type":"verse","number":29,"content":[{"text":"பெலிஸ்தியரே, நீங்கள் எல்லோரும்,","poem":1},{"text":"உங்களை அடித்த கோல் முறிந்தது என்று மகிழவேண்டாம்.","poem":2},{"text":"அந்த பாம்பின் வேரிலிருந்து விரியன் பாம்பு தோன்றும்.","poem":1},{"text":"அதன் கனியோ பறக்கும் விஷப் பாம்பாய் இருக்கும்.","poem":2}]},{"type":"verse","number":30,"content":[{"noteId":11},{"text":"ஏழைகளிலும் ஏழைகளாய் இருப்பவர்கள் உணவைப் பெற்றுக்கொள்வார்கள்;","poem":1},{"text":"தரித்திரர் பாதுகாப்பாக இளைப்பாறுவார்கள்.","poem":2},{"text":"ஆனால் உன் வேரையோ பஞ்சத்தால் அழிப்பேன்;","poem":1},{"text":"அது உன்னில் மீதமிருப்போரைக் கொன்றுவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"வாசலே, புலம்பு! பட்டணமே, கதறியழு!","poem":1},{"text":"பெலிஸ்தியரே, நீங்கள் அனைவரும் உருகிப்போங்கள்!","poem":2},{"text":"வடக்கிலிருந்து ஒரு புகைமேகம் வருகிறது;","poem":1},{"text":"அதன் அணிவகுப்பிலிருந்து விலகுவோர் அங்கு ஒருவரும் இல்லை.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அந்த நாட்டின் தூதுவருக்கு என்ன பதில் சொல்லலாம்?","poem":1},{"text":"“யெகோவா சீயோனை நிலைநாட்டியிருக்கிறார்.","poem":2},{"text":"துன்புறுத்தப்பட்ட அவரது மக்கள்","poem":1},{"text":"அங்கு அடைக்கலம் புகுவார்கள்.”","poem":2}]}],"footnotes":[{"noteId":11,"caller":"+","text":"ஏழைகளின் தலைப்பிள்ளைகள்","reference":{"chapter":14,"verse":30}}]},"thisChapterLink":"/api/tam_tcv/ISA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/13.json","previousChapterAudioLinks":{},"numberOfVerses":32}