{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":15,"content":[{"type":"heading","content":["மோவாபைப் பற்றிய இறைவாக்கு"]},{"type":"verse","number":1,"content":["மோவாபைப் பற்றி கூறப்பட்ட இறைவாக்கு:",{"text":"ஒரே இரவில் மோவாபிலுள்ள ஆர் என்னும் பட்டணம்","poem":1},{"text":"அழிக்கப்பட்டுப் பாழாயிற்று.","poem":2},{"text":"மோவாபிலுள்ள கீர் பட்டணமும் ஒரே இரவில்","poem":1},{"text":"அழிக்கப்பட்டுப் பாழாயிற்று.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"தீபோன் மக்கள், அதன் மேடுகளிலுள்ள கோவில்களுக்கு","poem":1},{"text":"அழுவதற்கென்று போயிருக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"மோவாப் மக்கள் நேபோவைக் குறித்தும், மேதேபாவைக் குறித்தும் புலம்புகிறார்கள்.","poem":2},{"text":"ஒவ்வொருவருடைய தலையும் மொட்டையடிக்கப்பட்டு,","poem":1},{"text":"ஒவ்வொருவருடைய தாடியும் சிரைக்கப்பட்டிருக்கிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் துக்கவுடையை உடுத்தியபடி வீதிகளில் நிற்கிறார்கள்;","poem":1},{"text":"வீட்டுக் கூரைகள் மேலும்,","poem":2},{"text":"பொதுமக்கள் கூடும் சதுக்கங்களிலும் புலம்புகிறார்கள்.","poem":1},{"text":"அவர்கள் தேம்பித் தேம்பி அழுகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"எஸ்போனியரும், எலெயாலேயரும் கூக்குரலிட்டு அழுகிறார்கள்,","poem":1},{"text":"அவர்களுடைய குரல் யாகாசுவரை கேட்கிறது.","poem":2},{"text":"ஆகவே மோவாபியரில் ஆயுதமணிந்தவர்களும் கதறி அழுகிறார்கள்;","poem":1},{"text":"அவர்கள் இருதயங்கள் சோர்ந்திருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"எனது உள்ளம் மோவாபியருக்காக அழுகிறது;","poem":1},{"text":"அவர்களுடைய அகதிகள் சோவார் வரைக்கும்,","poem":2},{"lineBreak":true},{"text":"எக்லத் ஷெலிஷியாவரைக்கும் தப்பி ஓடுகிறார்கள்.","poem":2},{"text":"அவர்கள் லூகித் மலைச்சரிவுகளில்","poem":1},{"text":"அழுதுகொண்டே ஏறுகிறார்கள்.","poem":2},{"text":"ஒரொனாயீமின் வழியில் தங்கி","poem":1},{"text":"பட்டணத்தின் அழிவைப்பற்றிப் புலம்புகிறார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நிம்ரீமின் நீர்நிலைகள் வற்றிப்போயின;","poem":1},{"text":"புல்லும் வாடிப்போயிற்று,","poem":2},{"text":"பசுமையும் இல்லாமல் போயிற்று.","poem":1},{"text":"பசுமையான எதுவுமே மீதியாய் விடப்படவில்லை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆகவே அவர்கள் தேடிச் சேர்த்த செல்வத்தை,","poem":1},{"text":"அலறிகளின் ஆற்றுக்கு அப்பால் தூக்கிச் செல்கிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்களுடைய வேதனைக் குரல் மோவாப் எல்லையெங்கும் கேட்கிறது;","poem":1},{"text":"அவர்களுடைய அலறும் சத்தம் எக்லாயீம்வரை எட்டுகிறது.","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய புலம்பல் பீர் ஏலீம் வரையும் கேட்கிறது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தீமோன் பட்டணத்தின் நீர்நிலைகள் இரத்தத்தால் நிரம்பியிருக்கின்றன.","poem":1},{"text":"ஆனால் நான் தீமோனின்மேல் இன்னும் அதிக வேதனையைக் கொண்டுவருவேன்.","poem":2},{"text":"மோவாபிலுள்ள அகதிகள்மீதும்,","poem":1},{"text":"நாட்டில் மீதியாய் இருப்பவர்கள்மீதும் சிங்கத்தை ஏவிவிடுவேன்.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/14.json","previousChapterAudioLinks":{},"numberOfVerses":9}