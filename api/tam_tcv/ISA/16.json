{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"நாட்டின் ஆளுநனுக்குச்","poem":1},{"text":"செலுத்தும் ஆட்டுக்குட்டிகளை,","poem":2},{"text":"நீங்கள் சேலா நாட்டிலிருந்து பாலைவனம் வழியாக","poem":1},{"text":"சீயோன் மகளின் மலைக்கு அனுப்புங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"கூட்டிலிருந்து கலைக்கப்பட்டு,","poem":1},{"text":"செட்டையடிக்கும் பறவைகளைப்போல்","poem":2},{"text":"மோவாபிய பெண்கள்,","poem":1},{"text":"அர்னோன் ஆற்றின் துறைகளில் இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“நீங்கள் ஆலோசனைபண்ணி,","poem":1},{"text":"ஒரு தீர்மானம் எடுங்கள்.","poem":2},{"text":"நடுப்பகலில் உங்கள் நிழலை இரவு போலாக்குங்கள்.","poem":1},{"text":"தப்பியோடி வருபவருக்கு","poem":2},{"text":"மறைவிடம் கொடுங்கள்.","poem":1},{"text":"ஜனங்களைக் காட்டிக் கொடாதிருங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மோவாபிலிருந்து துரத்திவிடப்பட்ட என் மக்கள் உங்களுடன் இருக்கட்டும்.","poem":1},{"text":"அவர்களை அழிப்பவர்களிடமிருந்து தப்பும்படி அவர்களுக்குப் புகலிடமாயிருங்கள்.”","poem":2},{"lineBreak":true},{"text":"ஒடுக்குகிறவர்களுக்கு ஒரு முடிவுவரும்,","poem":1},{"text":"அழிவும் ஓய்ந்துவிடும்;","poem":2},{"lineBreak":true},{"text":"துன்புறுத்துபவன் நாட்டிலிருந்து இல்லாமல் போவான்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அன்பில் ஒரு அரியணை நிலைநாட்டப்படும்.","poem":1},{"text":"தாவீதின் குடும்பத்தைச் சேர்ந்த","poem":2},{"lineBreak":true},{"text":"உண்மையுள்ள ஒருவர் அதில் அமர்ந்திருப்பார்.","poem":2},{"text":"அவர் நியாயத்தீர்ப்புச் செய்ய நீதியை நாடுவார்;","poem":1},{"text":"தாமதியாமல் நியாயம் செய்வார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"மோவாபியரின் மேட்டிமையைக் குறித்து கேள்விப்பட்டோம்.","poem":1},{"text":"அவர்கள் ஆணவம் பெரிதே!","poem":2},{"text":"அகந்தையும், பெருமையும், இறுமாப்பும் உடையவர்கள்;","poem":1},{"text":"அவர்களுடைய தற்புகழ்ச்சிகள் எல்லாம் வெறுமையானவையே.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆகவே மோவாபியர் புலம்புகிறார்கள்,","poem":1},{"text":"அவர்கள் மோவாபுக்காக ஒன்றுசேர்ந்து புலம்புகிறார்கள்.","poem":2},{"text":"கீர்ஹேரேஸேத்தின் திராட்சை அடைகளுக்காகத்","poem":1},{"text":"துக்கத்துடன் அழுது புலம்புகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எஸ்போன் வயல்களும் சிப்மாவின்","poem":1},{"text":"திராட்சைக் கொடிகளும் வாடுகின்றன.","poem":2},{"text":"நாடுகளின் ஆளுநர்கள் தெரிந்தெடுக்கப்பட்ட","poem":1},{"text":"திராட்சைக் கொடிகளை மிதித்துப் போட்டார்கள்.","poem":2},{"text":"இவை ஒருகாலத்தில் யாசேர்வரை நீண்டு","poem":1},{"text":"பாலைவனத்தை நோக்கிப் பரந்திருந்தன.","poem":2},{"text":"அவைகளின் துளிர்கள் வெளியே படர்ந்து","poem":1},{"text":"கடல்வரை சென்றிருந்தன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"சிப்மாவின் திராட்சைக் கொடிகளுக்காக யாசேர் அழுவதுபோல்","poem":1},{"text":"நானும் அழுகிறேன்.","poem":2},{"text":"எஸ்போனே, எலெயாலேயே,","poem":1},{"text":"நான் உன்னை என் கண்ணீரால் நனைக்கிறேன்!","poem":2},{"text":"உனது பழங்கள் விளைந்து முதிரும் காலத்திலும்,","poem":1},{"text":"உனது அறுவடையின் காலத்திலும் இருக்கும் மகிழ்ச்சியின் சத்தம் அடங்கிற்று.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"பழத்தோட்டங்களிலிருந்த சந்தோஷமும் மகிழ்ச்சியும் நீக்கப்பட்டு விட்டன;","poem":1},{"text":"திராட்சைத் தோட்டங்களில் ஒருவரும் பாடுவதுமில்லை, சத்தமிடுவதுமில்லை;","poem":2},{"text":"ஆலைகளில் இரசத்துக்காக பழங்களை மிதிப்பவர்களுமில்லை,","poem":1},{"text":"ஏனெனில் நானே பழம் பிழிவோரின் பூரிப்பை ஓயப்பண்ணினேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"மோவாபுக்காக என் இருதயமும்,","poem":1},{"text":"கிர் ஹெரெஸிற்காக என் உள்ளமும் யாழின் தொனியைப்போல் புலம்புகின்றன.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மோவாப் தனது மேடையிலுள்ள தெய்வங்களிடம் சென்று","poem":1},{"text":"களைப்புற்றும்,","poem":2},{"text":"கோயிலுக்குப்போய் மன்றாடியும்","poem":1},{"text":"அவளுக்கு ஒரு பயனும் இல்லை.","poem":2}]},{"type":"verse","number":13,"content":["மோவாபைப் பற்றி யெகோவா முன்பே சொல்லியிருந்த வார்த்தை இதுவே."]},{"type":"verse","number":14,"content":["இப்பொழுதோ யெகோவா சொல்கிறதாவது: “வேலைசெய்ய ஒப்பந்தம் செய்த கூலியாள் தன் நாட்களைக் கணக்கிடுவது போல, மூன்று வருடங்களுக்குள் மோவாபியரின் சிறப்பும், அங்குள்ள பெருந்தொகையான மக்களும் அவமதிக்கப்படுவார்கள். அதில் தப்பியிருப்போர் மிகச் சிலராயும் பெலவீனராயும் இருப்பார்கள்.”"]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/15.json","previousChapterAudioLinks":{},"numberOfVerses":14}