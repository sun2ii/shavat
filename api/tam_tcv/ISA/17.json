{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":17,"content":[{"type":"heading","content":["தமஸ்குவுக்கு எதிரான இறைவாக்கு"]},{"type":"verse","number":1,"content":["தமஸ்கு பட்டணத்தைப் பற்றிய இறைவாக்கு:",{"text":"“பாருங்கள், தமஸ்கு இனிமேல் ஒரு பட்டணமாய் இராது;","poem":1},{"text":"அது ஒரு இடிபாடுகளின் குவியலாகும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அரோவேரிலுள்ள பட்டணங்கள் கைவிடப்பட்டு,","poem":1},{"text":"மந்தைகளுக்கு இளைப்பாறும் இடங்களாய் இருக்கும்;","poem":2},{"lineBreak":true},{"text":"அவைகளைப் பயமுறுத்துவதற்கு ஒருவரும் இருக்கமாட்டார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எப்பிராயீமிலுள்ள அரண்செய்யப்பட்ட பட்டணம் இல்லாது ஒழிந்துபோகும்;","poem":1},{"text":"தமஸ்குவின் அரசாட்சியும் ஒழிந்துபோகும்.","poem":2},{"text":"இஸ்ரயேலின் மேன்மைக்கு நடந்ததுபோலவே,","poem":1},{"text":"சீரியாவில் மீதியாய் இருப்பவர்களுக்கும் நடக்கும்”","poem":2},{"lineBreak":true},{"text":"என்று சேனைகளின் யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“அந்த நாளில் யாக்கோபின் மகிமை குறைந்துபோகும்;","poem":1},{"text":"அவளது உடலின் கொழுப்பு உருகிப்போகும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அறுவடை செய்பவன் ஓங்கி வளர்ந்த கதிர்களைச் சேர்த்து,","poem":1},{"text":"தன் கையால் அறுவடை செய்வதுபோலவும்,","poem":2},{"text":"ஒரு மனிதன் ரெப்பாயீம் பள்ளத்தாக்கில்","poem":1},{"text":"சிந்திய கதிர்களைப் பொறுக்குவது போலவும் அது இருக்கும்.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஆயினும், இஸ்ரயேலின் இறைவனாகிய யெகோவா அறிவிக்கிறதாவது:","poem":1},{"text":"“ஒலிவ மரத்தை உலுக்கி பழம் பறித்தபின்,","poem":2},{"text":"அதன் உச்சிக் கொப்புகளில் இரண்டு மூன்று பழங்கள் விழாமல் மீதமிருப்பதுபோலவும்,","poem":1},{"text":"பழம் நிறைந்த கொப்புகளில் நாலைந்து பழங்கள்","poem":2},{"lineBreak":true},{"text":"விழாமல் மீந்திருப்பது போலவும் ஒரு சிலர் மீதமிருப்பார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"அந்த நாளில் மக்கள் தங்களைப் படைத்தவரை நோக்கிப் பார்ப்பார்கள்;","poem":1},{"text":"அவர்கள் தங்கள் கண்களை இஸ்ரயேலின் பரிசுத்தரின் பக்கமாய்த் திருப்புவார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"தமது கைகளால் செய்த பலிபீடங்களை நோக்கமாட்டார்கள்;","poem":1},{"text":"அசேரா தேவதைகளின் தூண்களுக்கும்,","poem":2},{"text":"தங்கள் விரல்களினால் செய்யப்பட்ட தூப பீடங்களுக்கும்","poem":1},{"text":"மதிப்புக் கொடுக்கவுமாட்டார்கள்.","poem":2}]},{"type":"verse","number":9,"content":["இஸ்ரயேலர் நிமித்தம் அவர்கள் கைவிட்டுப்போன வலிமையுள்ள பட்டணங்கள் இந்த நாளில் புதர்களுக்கும், புற்தரைகளுக்கும் கைவிடப்பட்ட இடங்களைப் போலாகி, எல்லாம் பாழாய்க்கிடக்கும்."]},{"type":"verse","number":10,"content":[{"text":"நீங்கள் உங்கள் இரட்சகராகிய இறைவனை மறந்து,","poem":1},{"text":"உங்கள் கோட்டையான கற்பாறையை நினையாமல் போனீர்கள்.","poem":2},{"text":"ஆதலால் சிறந்த தாவரங்களையும்,","poem":1},{"text":"வேறு நாடுகளிலிருந்து கொண்டுவரப்பட்ட திராட்சைக் கொடிகளையும்","poem":2},{"lineBreak":true},{"text":"ஒழுங்காய் நாட்டினாலும்,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நட்ட நாளிலேயே நீ அவைகளை வளரப் பண்ணினாலும்,","poem":1},{"text":"விடியற்காலையிலேயே நீ அவைகளை மொட்டு வரப்பண்ணினாலும்","poem":2},{"text":"அறுவடையில் ஒன்றும் இராது;","poem":1},{"text":"வியாதியும் தீராத வேதனைகளுமே அந்த நாளில் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அநேக நாடுகள் கொதித்தெழுகிறார்கள்;","poem":1},{"text":"அவர்கள் கொந்தளிக்கும் கடல்போல் எழுகிறார்கள்.","poem":2},{"text":"மக்கள் கூட்டங்கள் கிளர்ந்தெழுகிறார்கள்;","poem":1},{"text":"பெருவெள்ளத்தின் இரைச்சலைப்போல் கர்ஜிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"பெருவெள்ளம் இரைவதுபோல் மக்கள் கூட்டங்கள் இரைந்தாலும்,","poem":1},{"text":"அவர் அவர்களைக் கடிந்துகொள்ளும்போது, அவர்கள் தூரமாய் ஓடிப்போகிறார்கள்.","poem":2},{"text":"அவர்கள் குன்றுகளின்மேல் காற்றினால் பறக்கடிக்கிறப் பதரைப்போலவும்,","poem":1},{"text":"புயல்காற்றில் சிக்குண்ட சருகு போலவும் அவர்கள் அடித்துச்செல்லப் படுகிறார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"மாலைவேளையில் திடீர்ப் பயங்கரம்;","poem":1},{"text":"விடியுமுன் அழிவு;","poem":2},{"text":"நம்மைக் கொள்ளையடிப்பவர்களின் நிலைமை இதுவே;","poem":1},{"text":"நம்மைச் சூறையாடுவோரின் கதியும் இதுவே.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}