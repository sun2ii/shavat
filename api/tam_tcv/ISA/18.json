{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":18,"content":[{"type":"heading","content":["எத்தியோப்பியாவுக்கு எதிரான இறைவாக்கு"]},{"type":"verse","number":1,"content":[{"text":"எத்தியோப்பிய நதிகளுக்கு அப்பால்,","poem":1},{"text":"இரைச்சலையுடைய செட்டைகளின் நாடே, ஐயோ உனக்குக் கேடு!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இந்த நாடு நாணல் படகுகளில் தண்ணீரின்மேல்","poem":1},{"text":"கடல் வழியாகத் தூதுவரை அனுப்புகிறது.","poem":2},{"lineBreak":true},{"text":"விரைந்து செல்லும் தூதுவர்களே,","poem":1},{"lineBreak":true},{"text":"உயரமானவர்களும் மிருதுவான மேனியை உடையவர்களும்,","poem":1},{"text":"தூரத்திலும் அருகிலும் உள்ளோரை பயமுறுத்திய மக்களிடம் போங்கள்.","poem":2},{"text":"இவர்கள் வலிமைமிக்கவர்கள், பகைவரை மிதித்து வெற்றிபெறுபவர்கள்;","poem":1},{"text":"இவர்களுடைய நாடு ஆறுகளால் பிரிக்கப்பட்டுள்ளது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"உலகத்தில் வாழ்பவர்களும்,","poem":1},{"text":"பூமியின் குடிமக்களே, நீங்கள் யாவரும்","poem":2},{"text":"மலைமேல் கொடியேற்றப்படும்போது,","poem":1},{"text":"அதைக் காண்பீர்கள்.","poem":2},{"text":"எக்காளம் முழங்கும்போது","poem":1},{"text":"அதைக் கேட்பீர்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவா என்னிடம் கூறுவது இதுவே:","poem":1},{"text":"“சூரிய ஒளியின் இளஞ்சூட்டைப் போலவும்,","poem":2},{"text":"அறுவடைகால வெப்பத்தின்போது வரும் மூடுபனிபோலவும்","poem":1},{"text":"நான் என்னுடைய உறைவிடத்தில் அமைதியாய் இருந்து பார்ப்பேன்.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஏனெனில் அறுவடைக்குமுன்,","poem":1},{"text":"திராட்சை பூத்து, காய்த்து, பழங்களாகும்போது,","poem":2},{"text":"யெகோவா எத்தியோப்பியரை தளிர்களாகவும்,","poem":1},{"text":"படரும் கிளைகளாகவும் அரிவாள்களால் வெட்டி அப்புறப்படுத்தி விடுவார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவையெல்லாம் இரைபிடிக்கும் மலைகளின் பிணந்தின்னும் பறவைகளுக்கும்,","poem":1},{"text":"காட்டு மிருகங்களுக்கும் விடப்படும்;","poem":2},{"text":"பிணந்தின்னும் பறவைகள் கோடைகாலத்திலும்,","poem":1},{"text":"காட்டு மிருகங்கள் மாரிகாலத்திலும் அவைகளைத் தின்னும்.","poem":2}]},{"type":"verse","number":7,"content":["உயரமானவர்களும் மிருதுவான மேனியை உடையவர்களும்,",{"text":"தூரத்திலும் அருகிலும் உள்ளோரை பயமுறுத்திய மக்களிடமிருந்து","poem":1},{"text":"சேனைகளின் யெகோவாவுக்கு அந்நேரத்தில் கொடைகள் கொண்டுவரப்படும்.","poem":2},{"text":"இவர்கள் வலிமைமிக்கவர்கள், பகைவரை மிதித்து வெற்றிபெறுபவர்கள்;","poem":1},{"text":"இவர்களுடைய நாடு ஆறுகளால் பிரிக்கப்பட்டுள்ளது.","poem":2},"இந்தக் கொடைகள் சேனைகளின் யெகோவாவினுடைய பெயருக்குரிய இடமாகிய சீயோன் மலைக்குக் கொண்டுவரப்படும்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/17.json","previousChapterAudioLinks":{},"numberOfVerses":7}