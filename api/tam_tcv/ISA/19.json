{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":19,"content":[{"type":"heading","content":["எகிப்தைப் பற்றிய இறைவாக்கு"]},{"type":"verse","number":1,"content":["இது எகிப்தைப் பற்றிய ஒரு இறைவாக்கு:",{"text":"இதோ, யெகோவா விரைந்து செல்லும் மேகமொன்றில் ஏறி","poem":1},{"text":"எகிப்திற்கு வருகிறார்.","poem":2},{"text":"எகிப்திய விக்கிரகங்கள் அவர்முன் நடுங்குகின்றன;","poem":1},{"text":"எகிப்தியரின் இருதயங்கள் அவர்களுக்குள்ளேயே உருகுகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“எகிப்தியனை எகிப்தியனுக்கு விரோதமாக நான் எழுப்பிவிடுவேன்;","poem":1},{"text":"சகோதரன் சகோதரனுக்கு விரோதமாகச் சண்டையிடுவான்.","poem":2},{"lineBreak":true},{"text":"அயலான் அயலானை எதிர்ப்பான்,","poem":2},{"lineBreak":true},{"text":"பட்டணம் பட்டணத்தை எதிர்க்கும்,","poem":2},{"lineBreak":true},{"text":"அரசு அரசை எதிர்க்கும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அதனால் எகிப்தியர் இருதயத்தில் சோர்ந்துபோவார்கள்;","poem":1},{"text":"நான் அவர்களுடைய திட்டங்களை நிறைவேறாதபடி செய்வேன்.","poem":2},{"text":"அவர்கள் விக்கிரகங்களிடமும், இறந்தோரின் ஆவிகளிடமும், குறிசொல்வோரிடமும்,","poem":1},{"text":"ஆவியுலகத் தொடர்புடையோரிடமும் ஆலோசனை கேட்பார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் எகிப்தியரை கொடிய தலைவன்","poem":1},{"text":"ஒருவனது வல்லமைக்கு ஒப்புக்கொடுப்பேன்.","poem":2},{"text":"அவர்களை கொடூரமான அரசன் ஒருவன் ஆளுவான்”","poem":1},{"text":"என்று யெகோவா, சேனைகளின் யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஆற்றின் வெள்ளம் வற்றிவிடும்,","poem":1},{"text":"ஆற்றின் அடித்தரை காய்ந்து வறண்டுவிடும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வாய்க்கால்கள் நாறும்;","poem":1},{"text":"எகிப்தின் நீரோடைகள் வற்றி வறண்டுபோகும்.","poem":2},{"text":"கோரையும் நாணலும் வாடிவிடும்.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"ஆற்றின் முகத்துவாரத்தில்,","poem":2},{"lineBreak":true},{"text":"நைல் நதியின் ஓரத்தில் வளரும் தாவரங்களும் வாடிவிடும்.","poem":2},{"text":"நதியோரம் விதைக்கப்பட்ட உலர்ந்து,","poem":1},{"text":"பறந்து இல்லாமல் போகும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மீனவர்கள் புலம்புவார்கள்,","poem":1},{"text":"நைல் நதியில் தூண்டில்போடும் யாவரும் அழுவார்கள்;","poem":2},{"text":"தண்ணீருள் வலை வீசுகிறவர்களும்","poem":1},{"text":"கவலையால் வாடிப்போவார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"சணற்பட்டுத் தொழில் செய்வோரும்","poem":1},{"text":"வெண்பருத்தி நூலினால் நெசவு செய்வோரும் வெட்கமடைவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"துணி நெசவு செய்வோர் அனைவருமே சோர்வடைவார்கள்;","poem":1},{"text":"கூலிக்கு வேலைசெய்யும் யாவரும் மனமுடைந்து போவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"சோவானின் அதிகாரிகள் புத்தியீனரேயன்றி வேறு யாருமல்லர்;","poem":1},{"text":"பார்வோனின் ஞானமுள்ள ஆலோசகர் அர்த்தமற்ற ஆலோசனை வழங்குகிறார்கள்.","poem":2},{"text":"“நான் ஞானிகளில் ஒருவன்;","poem":1},{"text":"பூர்வகால அரசர்களின் வழிவந்தவன்”","poem":2},{"lineBreak":true},{"text":"என்று நீங்கள் ஒவ்வொருவரும் எப்படி பார்வோனுக்குச் சொல்வீர்கள்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"இப்பொழுது உன் ஞானிகள் எங்கே?","poem":1},{"text":"சேனைகளின் யெகோவா","poem":2},{"text":"எகிப்திற்கு விரோதமாகத் திட்டமிட்டிருப்பதை,","poem":1},{"text":"அவர்கள் உனக்கு வெளிப்படுத்திக் காட்டட்டும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"சோவானின் அதிகாரிகள் புத்தியீனரானார்கள்;","poem":1},{"text":"மெம்பிஸ்","poem":2},{"noteId":12},{"text":"பட்டணத்தின் தலைவர்கள் ஏமாந்துபோனார்கள்.","poem":2},{"text":"மக்கள் கூட்டங்களின் மூலைக் கற்களாய் இருந்த அவர்கள்","poem":1},{"text":"எகிப்தை வழிதவறிப் போகச் செய்தார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவா அவர்களுக்குள் மயக்கத்தின் ஆவியை ஊற்றியிருக்கிறார்.","poem":1},{"text":"மதுபோதையில் தனது வாந்தியைச் சுற்றி தள்ளாடுபவனைப் போல்,","poem":2},{"text":"அவர்கள் எகிப்தை அதன் செயல்கள் அனைத்திலும்","poem":1},{"text":"தள்ளாடப் பண்ணுகிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அப்பொழுது எகிப்தின் தலையினாலோ,","poem":1},{"text":"வாலினாலோ, ஓலையினாலோ, நாணலினாலோ செய்யக்கூடியது எதுவுமேயில்லை.","poem":2}]},{"type":"verse","number":16,"content":["அந்த நாளில் எகிப்தியர் பெண்களைப் போலாவார்கள். சேனைகளின் யெகோவா, தமது உயர்த்திய கரத்தை அவர்களுக்கு விரோதமாக ஓங்கும்போது, அவர்கள் பயத்தால் நடுங்குவார்கள்."]},{"type":"verse","number":17,"content":["யூதா நாடும் எகிப்தியரைத் திகிலடையச் செய்யும். சேனைகளின் யெகோவா அவர்களுக்கு விரோதமாகத் திட்டமிட்டிருப்பதின் நிமித்தம், யூதாவைக் குறித்துக் கேள்விப்படும் ஒவ்வொருவரும் திகிலடைவார்கள்."]},{"type":"verse","number":18,"content":["அந்த நாளிலே, எகிப்திலுள்ள ஐந்து பட்டணங்கள் கானான் மொழியைப் பேசி, “சேனைகளின் யெகோவாவுக்கே உண்மையாயிருப்போம்” என ஆணையிடுவார்கள். அவைகளில் ஒன்று அழிவின் நகரம் என அழைக்கப்படும்."]},{"type":"verse","number":19,"content":["அந்த நாளிலே எகிப்தின் மத்தியில் யெகோவாவுக்கு ஒரு பலிபீடமும், அதன் எல்லையில் அவருக்கு ஒரு நினைவுச் சின்னமும் இருக்கும்."]},{"type":"verse","number":20,"content":["இது எகிப்து தேசத்திலே சேனைகளின் யெகோவாவுக்கு ஒரு அடையாளமாகவும், சாட்சியாகவும் இருக்கும். அவர்கள் தங்களை ஒடுக்குவோரினிமித்தம் யெகோவாவிடம் கதறியழும்போது, மீட்பரும் பாதுகாப்பவருமான ஒருவரை அவர்களிடம் அனுப்புவார்; அவர் அவர்களை விடுவிப்பார்."]},{"type":"verse","number":21,"content":["இப்படியாக யெகோவா எகிப்தியருக்குத் தன்னை வெளிப்படுத்துவார்; அந்நாளில் அவர்கள் யெகோவாவை ஏற்றுக்கொள்வார்கள். அவர்கள் பலிகளாலும், தானிய பலிகளாலும் வழிபடுவார்கள்; அவர்கள் யெகோவாவுக்குப் பொருத்தனைகளைச் செய்து, அவைகளை நிறைவேற்றுவார்கள்."]},{"type":"verse","number":22,"content":["யெகோவா எகிப்தைக் கொள்ளைநோயால் வாதிப்பார்; அவர் அவர்களை வாதித்துக் குணமாக்குவார். அவர்கள் யெகோவாவிடத்தில் மனந்திரும்புவார்கள். அவரும் அவர்களுடைய வேண்டுதலைக் கேட்டு, அவர்களைச் சுகமாக்குவார்."]},{"type":"verse","number":23,"content":["அந்த நாளில், எகிப்திலிருந்து அசீரியாவரை ஒரு பெரும்பாதை இருக்கும். எகிப்தியர் அசீரியாவுக்கும், அசீரியர் எகிப்திற்கும் போவார்கள். எகிப்தியரும், அசீரியரும் ஒன்றுகூடி வழிபடுவார்கள்."]},{"type":"verse","number":24,"content":["அந்த நாளில் இஸ்ரயேல், எகிப்தியருடனும், அசீரியருடனும் மூன்றாவது அரசாய், பூமியிலே ஒரு ஆசீர்வாதமாக இருக்கும்."]},{"type":"verse","number":25,"content":["சேனைகளின் யெகோவா, “என் மக்களாகிய எகிப்தியரும், என் கைவேலையாகிய அசீரியரும், எனது உரிமைச்சொத்தான இஸ்ரயேலரும் ஆசீர்வதிக்கப்படட்டும்” என்று சொல்லி அவர்களை ஆசீர்வதிப்பார்."]}],"footnotes":[{"noteId":12,"caller":"+","text":"மெம்பிஸ் அல்லது நோப்","reference":{"chapter":19,"verse":13}}]},"thisChapterLink":"/api/tam_tcv/ISA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/18.json","previousChapterAudioLinks":{},"numberOfVerses":25}