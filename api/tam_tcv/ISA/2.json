{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":2,"content":[{"type":"heading","content":["யெகோவாவின் மலை"]},{"type":"verse","number":1,"content":["ஆமோஸின் மகன் ஏசாயா, யூதா நாட்டையும், எருசலேம் பட்டணத்தையும் பற்றிக் கண்ட தரிசனம்."]},{"type":"line_break"},{"type":"verse","number":2,"content":["கடைசி நாட்களிலே,",{"text":"யெகோவாவினுடைய ஆலயத்தின் மலை,","poem":1},{"text":"எல்லா மலைகளுக்குள்ளும் உயர்ந்ததாக நிலைநிறுத்தப்படும்;","poem":2},{"text":"எல்லா குன்றுகளுக்கு மேலாக உயர்த்தப்படும்,","poem":1},{"text":"எல்லா தேசத்தார்களும் அதை நாடி ஓடி வருவார்கள்.","poem":2}]},{"type":"verse","number":3,"content":["அநேக மக்கள் கூட்டங்கள் வந்து,",{"text":"“வாருங்கள், நாம் யெகோவாவின் மலைக்கு ஏறிப்போவோம்,","poem":1},{"text":"யாக்கோபின் இறைவனுடைய ஆலயத்திற்குப் போவோம்.","poem":2},{"text":"நாம் அவர் பாதைகளில் நடப்பதற்கு","poem":1},{"text":"அவர் தம் வழிகளை நமக்கு போதிப்பார்” என்பார்கள்.","poem":2},{"text":"சீயோனிலிருந்து அவரது சட்டமும்,","poem":1},{"text":"எருசலேமிலிருந்து யெகோவாவின் வார்த்தையும் வெளிவரும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் நாடுளுக்கிடையில் நியாயம் விசாரித்து,","poem":1},{"text":"அநேக மக்கள் கூட்டங்களின் வழக்குகளைத் தீர்த்துவைப்பார்.","poem":2},{"text":"அப்பொழுது அவர்கள் தங்கள் பட்டயங்களை மண்வெட்டிகளாகவும்,","poem":1},{"text":"ஈட்டிகளை அரிவாள்களாகவும் அடித்துச் செய்துகொள்வார்கள்.","poem":2},{"text":"அதன்பின் ஒரு நாடு வேறு நாட்டை எதிர்த்து பட்டயத்தை எடுப்பதுமில்லை,","poem":1},{"text":"போருக்கான பயிற்சியையும் அவர்கள் கற்பதுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யாக்கோபின் குடும்பமே, வாருங்கள்,","poem":1},{"text":"யெகோவாவின் வெளிச்சத்தில் நடப்போம்.","poem":2}]},{"type":"heading","content":["யெகோவாவின் நாள்"]},{"type":"verse","number":6,"content":[{"text":"யாக்கோபின் குடும்பமான","poem":1},{"text":"உமது மக்களை நீர் கைவிட்டுவிட்டீர்.","poem":2},{"text":"அவர்கள் கிழக்குத் தேசத்தவர்களின் போதனைகளால் நிறைந்து,","poem":1},{"text":"பெலிஸ்தியரைப்போல் குறிபார்க்கிறவர்களாய் இருக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"வேற்று நாட்டு மக்களுடன் கைகோர்த்துத் திரிகிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்களுடைய நாடு வெள்ளியாலும், தங்கத்தாலும், நிறைந்திருக்கிறது;","poem":1},{"text":"அவர்களுடைய பொக்கிஷங்களுக்கு அளவேயில்லை.","poem":2},{"text":"அவர்களுடைய நாடு குதிரைகளால் நிறைந்திருக்கிறது;","poem":1},{"text":"அவர்களிடத்தில் தேர்களும் ஏராளமாயிருக்கின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்களின் நாடு விக்கிரகங்களால் நிறைந்திருக்கிறது;","poem":1},{"text":"அவர்கள் தங்களுடைய கைகளினாலும்,","poem":2},{"lineBreak":true},{"text":"விரல்களினாலும் செய்தவைகளையே விழுந்து வணங்குகிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இவற்றால் மனிதன் தாழ்நிலைக்குக் கொண்டுவரப்படுவான்,","poem":1},{"text":"மனுக்குலமும் தாழ்த்தப்படும்;","poem":2},{"lineBreak":true},{"text":"நீர் அவர்களை மன்னியாதிரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவாவின் பயங்கரத்திற்கும்,","poem":1},{"text":"அவரின் மாட்சிமையின் சிறப்புக்கும் ஒதுங்கி,","poem":2},{"lineBreak":true},{"text":"கன்மலைக்குள் புகுந்து, மண்ணில் ஒளிந்துகொள்ளுங்கள்!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"கர்வமுள்ள மனிதரின் பார்வை தாழ்த்தப்படும்,","poem":1},{"text":"மனிதரின் பெருமையும் தாழ்நிலைக்குக் கொண்டுவரப்படும்;","poem":2},{"text":"அந்த நியாயத்தீர்ப்பின் நாளில் யெகோவா மட்டுமே உயர்த்தப்படுவார்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அகந்தையும் இறுமாப்பும் உள்ள யாவருக்கும்,","poem":1},{"text":"உயர்த்தப்பட்ட அனைத்திற்கும்","poem":2},{"text":"சேனைகளின் யெகோவா நாளொன்றை வைத்திருக்கிறார்;","poem":1},{"text":"அவர்கள் எல்லோரும் தாழ்த்தப்படுவார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அந்த நாளில் லெபனோனிலே ஓங்கி வளர்ந்த எல்லா கேதுரு மரங்களும்,","poem":1},{"text":"பாசானின் எல்லா கர்வாலி மரங்களும்,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"உயர்ந்த எல்லா மலைகளும்,","poem":1},{"text":"உயரமான எல்லாக் குன்றுகளும்,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"உயர்வான ஒவ்வொரு கோபுரமும்,","poem":1},{"text":"அரண்செய்யப்பட்ட ஒவ்வொரு மதிலும்,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"தர்ஷீஸின் கப்பல்","poem":1},{"noteId":1},{"text":"ஒவ்வொன்றும்,","poem":1},{"text":"கம்பீரமான ஒவ்வொரு மரக்கலமும் தாழ்த்தப்படும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"மனிதரின் கர்வம் அடக்கப்படும்,","poem":1},{"text":"மனிதரின் பெருமையும் தாழ்த்தப்படும்.","poem":2},{"text":"அந்த நாளில் யெகோவா மட்டுமே உயர்ந்திருப்பார்;","poem":1}]},{"type":"verse","number":18,"content":[{"text":"விக்கிரகங்களோ, முழுவதும் இல்லாதொழிந்து போகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யெகோவா பூமியை அதிரப்பண்ணுவதற்காக எழும்பும்போது,","poem":1},{"text":"மக்கள் அவருடைய மாட்சிமையின் சிறப்புக்கும்,","poem":2},{"text":"யெகோவாவின் பயங்கரத்திற்கும் தப்புவதற்காக","poem":1},{"text":"கன்மலைகளின் குகைகளுக்குள்ளும்,","poem":2},{"lineBreak":true},{"text":"மண்ணிலுள்ள குழிகளுக்குள்ளும் புகுந்துகொள்வார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அந்த நாளிலே, மனிதர் தாம் வணங்குவதற்காகச் செய்த","poem":1},{"text":"வெள்ளி விக்கிரகங்களையும், தங்க விக்கிரகங்களையும்","poem":2},{"text":"பெருச்சாளிகளுக்கும் வவ்வால்களுக்கும்","poem":1},{"text":"எறிந்துவிடுவார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"பூமியை அதிரப்பண்ணுவதற்காக யெகோவா எழும்பும்போது,","poem":1},{"text":"மனிதர்கள் அவருடைய மாட்சிமையின் சிறப்புக்கும்,","poem":2},{"text":"யெகோவாவின் பயங்கரத்திற்கும் தப்புவதற்காக,","poem":1},{"text":"கன்மலைகளின் வெடிப்புகளுக்குள்ளும்,","poem":2},{"lineBreak":true},{"text":"பாறைச் சரிவுகளின் கீழும் புகுந்துகொள்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"மனிதனில் நம்பிக்கை வைப்பதை நிறுத்துங்கள்,","poem":1},{"text":"அவனுடைய உயிர் அவனுடைய நாசியின் மூச்சில்தானே இருக்கிறது.","poem":2},{"lineBreak":true},{"text":"மதிக்கப்படுவதற்கு அவனில் என்ன ஆற்றல் இருக்கிறது?","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"எபிரெயத்தில் தர்ஷீஸின் கப்பல் அல்லது வியாபாரக் கப்பல். இவை பயணிப்பதற்கும் சரக்குகளை எடுத்துச் செல்வதற்கும் பயன்படுத்தப்பட்ட பெரிய படகுகளைக் குறிக்கின்றன","reference":{"chapter":2,"verse":16}}]},"thisChapterLink":"/api/tam_tcv/ISA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}