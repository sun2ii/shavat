{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":21,"content":[{"type":"heading","content":["பாபிலோனுக்கு எதிரான இறைவாக்கு"]},{"type":"verse","number":1,"content":["கடல் அருகேயுள்ள பாலைவனத்தைக் குறித்த ஒரு இறைவாக்கு:",{"text":"புயல்காற்று நெகேவ் பிரதேசமான தென்திசையிலிருந்து வீசுவதுபோல,","poem":1},{"text":"பயங்கர நாடான பாலைவனத்திலிருந்து","poem":2},{"lineBreak":true},{"text":"ஒருவன் படையெடுத்து வருகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"கொடிய தரிசனம் ஒன்று எனக்குக் காண்பிக்கப்பட்டது:","poem":1},{"text":"துரோகி காட்டிக்கொடுக்கிறான், கொள்ளைக்காரன் கொள்ளையிடுகிறான்.","poem":2},{"text":"ஏலாமே, தாக்கு! மேதியாவே, முற்றுகையிடு!","poem":1},{"text":"அவள் உண்டுபண்ணிய புலம்பலுக்கு ஒரு முடிவைக் கொண்டுவருவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"இதனால் என் உடல் நோவினால் வாதிக்கப்படுகிறது;","poem":1},{"text":"பெண்ணின் பிரசவ வேதனையைப்போல் கடும் வேதனை என்னைப் பிடித்துக்கொண்டது.","poem":2},{"text":"நான் கேட்பது என்னைத் தள்ளாடப் பண்ணுகிறது;","poem":1},{"text":"நான் காண்பது என்னைக் குழப்பமடையச் செய்கிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"எனது இருதயம் தயங்குகிறது,","poem":1},{"text":"பயம் என்னை நடுங்கப் பண்ணுகிறது;","poem":2},{"text":"நான் எதிர்பார்த்திருந்த மாலைப்பொழுது","poem":1},{"text":"எனக்கு பயங்கரமாயிற்று.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவர்கள் பந்தியை ஆயத்தப்படுத்துகிறார்கள்,","poem":1},{"text":"அவர்கள் கம்பளம் விரிக்கிறார்கள்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் உண்டு குடிக்கிறார்கள்.","poem":2},{"text":"அதிகாரிகளே, எழும்புங்கள்,","poem":1},{"text":"கேடயங்களுக்கு எண்ணெய் பூசுங்கள்!","poem":2}]},{"type":"verse","number":6,"content":["யெகோவா எனக்குக் கூறுவது இதுவே:",{"text":"“நீ போய் காவலாளியை அவனுக்குரிய இடத்தில் அமர்த்து;","poem":1},{"text":"அவன் காண்பதை உனக்குத் தெரிவிக்கும்படி சொல்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"குதிரைக் கூட்டங்களுடன்","poem":1},{"text":"வரும் தேர்களையோ,","poem":2},{"text":"கழுதைகளின் மேலோ","poem":1},{"text":"ஒட்டகங்களின் மேலோ ஏறிச்செல்பவர்களையோ காணும்போது,","poem":2},{"text":"அவன் முழு எச்சரிக்கையுடன்","poem":1},{"text":"விழிப்பாயிருக்கட்டும்.”","poem":2}]},{"type":"verse","number":8,"content":["காவலாளி சிங்கத்தைப்போல் சத்தமிட்டு,",{"text":"“ஆண்டவனே, நான் பகல்தோறும், காவல் கோபுரத்தில் நிற்கிறேன்;","poem":1},{"text":"ஒவ்வொரு இரவும் எனக்குரிய இடத்திலேயே இருக்கிறேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இதோ குதிரைகள் பூட்டப்பட்ட ஒரு தேரில் ஒருவன் வருகிறான்.","poem":1},{"text":"‘பாபிலோன் வீழ்ந்தது, பாபிலோன் வீழ்ந்தது!","poem":2},{"text":"அதன் தெய்வங்களின் உருவச்சிலைகள் எல்லாம்","poem":1},{"text":"நிலத்தில் சிதறிக் கிடக்கின்றன!’","poem":2},{"text":"என அவன் பதிலளிக்கிறான்”","poem":1},{"text":"என்று சொன்னான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"என் மக்களே, சூடடிக்கும் களத்தில் நசுக்கப்பட்டிருப்பவர்களே,","poem":1},{"text":"இஸ்ரயேலின் இறைவனாகிய","poem":2},{"text":"சேனைகளின் யெகோவாவிடமிருந்து","poem":1},{"text":"நான் கேட்டதை உங்களுக்குச் சொல்கிறேன்.","poem":2}]},{"type":"heading","content":["ஏதோமுக்கு எதிரான இறைவாக்கு"]},{"type":"verse","number":11,"content":["தூமாவைப்",{"noteId":13},"பற்றிய ஒரு இறைவாக்கு:",{"text":"சேயீரிலிருந்து ஒருவன் என்னைக் கூப்பிட்டு,","poem":1},{"text":"“காவலாளியே, இரவு முடிய எவ்வளவு நேரமாகும்?","poem":2},{"lineBreak":true},{"text":"காவலாளியே, இரவு முடிய எவ்வளவு நேரமாகும்?” என்று கேட்டான்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"காவலாளி பதிலளித்து,","poem":1},{"text":"“காலை வருகிறது, ஆனால் இரவும் வருகிறது.","poem":2},{"text":"நீ கேட்க விரும்பினால் திரும்பவும் வந்து கேள்”","poem":1},{"text":"என்று கூறினான்.","poem":2}]},{"type":"heading","content":["அரேபியாவுக்கு எதிரான இறைவாக்கு"]},{"type":"verse","number":13,"content":["அரேபியாவைப் பற்றிய இறைவாக்கு:",{"text":"தெதானியரின் வணிகப் பயணிகள் கூட்டமே,","poem":1},{"text":"அரேபியாவின் காடுகளில் முகாமிடுகிறவர்களே,","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"தாகமுள்ளோருக்கு தண்ணீர் கொண்டுவாருங்கள்;","poem":2},{"text":"தேமாவில் வசிப்பவர்களே,","poem":1},{"text":"நீங்கள் அகதிகளுக்கு உணவு கொண்டுவாருங்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர்கள் பட்டயங்களுக்கும்,","poem":1},{"text":"உருவிய பட்டயத்துக்கும்,","poem":2},{"text":"நாணேற்றிய வில்லுக்கும்,","poem":1},{"text":"போரின் உக்கிரத்துக்கும் பயந்தோடி வருகிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":["யெகோவா எனக்கு கூறுவது இதுவே: “ஒப்பந்தத்தில் கூலி வேலைக்கு அமர்த்தப்பட்டவன் தனது வேலை நாட்களைக் கணக்கெடுக்கிறானே; அதுபோல ஒரு வருடத்திற்குள் கேதாரின் எல்லா மகிமையும் முடிவடையும்."]},{"type":"verse","number":17,"content":["வில்வீரரில் தப்பிப் பிழைப்போரும், கேதாரின்",{"noteId":14},"போர்வீரரும், மிகச் சிலராய் இருப்பார்கள்” என்பதாக இஸ்ரயேலின் இறைவனாகிய யெகோவா பேசியிருக்கிறார்."]}],"footnotes":[{"noteId":13,"caller":"+","text":"தூமாவை மற்றொரு பெயர் ஏதோம் அதற்கு அமைதி என்று அர்த்தம்.","reference":{"chapter":21,"verse":11}},{"noteId":14,"caller":"+","text":"கேதாரின் என்பது அரேபியாவின் வனப்பகுதி.","reference":{"chapter":21,"verse":17}}]},"thisChapterLink":"/api/tam_tcv/ISA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/20.json","previousChapterAudioLinks":{},"numberOfVerses":17}