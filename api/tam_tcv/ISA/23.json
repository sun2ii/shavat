{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":23,"content":[{"type":"heading","content":["தீருவைப் பற்றிய இறைவாக்கு"]},{"type":"verse","number":1,"content":["தீருவைப் பற்றிய ஒரு இறைவாக்கு:",{"text":"தர்ஷீசின் கப்பல்களே, புலம்புங்கள்!","poem":1},{"text":"தீரு அழிந்துபோனது;","poem":2},{"lineBreak":true},{"text":"அது வீடோ, துறைமுகமோ இல்லாமல் கிடக்கின்றது.","poem":2},{"text":"சைப்பிரஸ் நாட்டிலிருந்து அவர்களுக்கு","poem":1},{"text":"ஒரு செய்தி வந்திருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"தீவின் மக்களே,","poem":1},{"text":"கப்பலோட்டிகளில் செல்வந்தரான சீதோனின் வணிகர்களே,","poem":2},{"lineBreak":true},{"text":"மவுனமாயிருங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"சீகோரின் பெருவெள்ளத்தினால்","poem":1},{"text":"விளையும் தானியமும்,","poem":2},{"text":"நைல் நதியின் அறுவடையுமே தீருவுக்கு வருமானமாயிருந்தது.","poem":1},{"text":"தீரு நாடுகளின் சந்தைகூடும் இடமாகியது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ஆகையால் சீதோனே, வெட்கப்படு;","poem":1},{"text":"“நான் பிரசவ வேதனைப்படவுமில்லை, பிள்ளை பெறவுமில்லை;","poem":2},{"text":"நான் இளைஞர்களைப் பராமரிக்கவோ, கன்னிகைகளை வளர்க்கவோ இல்லை”","poem":1},{"text":"என்று கடல் சொல்கின்றது;","poem":2},{"lineBreak":true},{"text":"கடற்கோட்டை பேசுகின்றது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"செய்தி எகிப்திற்கு எட்டியதும்,","poem":1},{"text":"அங்குள்ளவர்கள் தீருவிலிருந்து வந்த","poem":2},{"lineBreak":true},{"text":"அந்தச் செய்தியின் நிமித்தம் வேதனைப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"தீவுகளின் மக்களே,","poem":1},{"text":"தர்ஷீசுக்குக் கடந்துசென்று அழுது புலம்புங்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அந்தப் பழைய பட்டணம் இதுதானா?","poem":1},{"text":"களியாட்டத்தில் ஈடுபட்ட உங்கள் பட்டணம் இதுவா?","poem":2},{"text":"தூர நாடுகளில் குடியிருக்கும்படி,","poem":1},{"text":"தன் மக்களை அனுப்பிய பட்டணம் இதுவா?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"தீருவுக்கு விரோதமாக இவ்வாறு திட்டமிட்டது யார்?","poem":1},{"text":"அது மகுடங்களை வழங்கியதே,","poem":2},{"text":"தீருவின் வர்த்தகர்கள் இளவரசர்களாயும்,","poem":1},{"text":"அதன் வியாபாரிகள் பூமியில் பெயர் பெற்றவர்களாயும் இருந்தனரே!","poem":2}]},{"type":"verse","number":9,"content":[{"text":"சேனைகளின் யெகோவாவே இதைத் திட்டமிட்டார்;","poem":1},{"text":"எல்லாச் சிறப்பின் பெருமையையும் சிறுமைப்படுத்துவதற்கும்,","poem":2},{"lineBreak":true},{"text":"பூமியில் புகழ்ப்பெற்ற அனைவரையும் தாழ்த்துவதற்குமே இவ்வாறு செய்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"தர்ஷீசின் மகளே,","poem":1},{"text":"நைல் நதியைப்போல் உன் நாட்டின் வழியாகப் போ;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் இனி ஒருபோதும் உனக்குத் துறைமுகம் இருக்காது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவா தனது கரத்தைக் கடலின் மேலாக நீட்டி,","poem":1},{"text":"அதன் அரசுகளை நடுங்கச் செய்துள்ளார்.","poem":2},{"text":"கானானின் கோட்டைகளை அழிக்கும்படி","poem":1},{"text":"அவர் கட்டளையிட்டிருக்கிறார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மேலும் அவர், “கன்னியாகிய சீதோனின் மகளே,","poem":1},{"text":"இப்போது நசுக்கப்பட்டுக் கிடக்கிறாயே!","poem":2},{"lineBreak":true},{"text":"இனி உனக்கு ஒருபோதும் களியாட்டம் இல்லை.","poem":2},{"lineBreak":true},{"text":"“நீ எழுந்து சைப்பிரஸுக்குப் போ,","poem":1},{"text":"அங்கேயும் நீ ஆறுதலைக் காணமாட்டாய்” என்றார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"கல்தேயரின் நாட்டைப் பார்,","poem":1},{"text":"அதன் மக்கள் இப்பொழுது ஒரு பொருட்டாய் எண்ணப்படாதிருக்கிறார்களே!","poem":2},{"text":"இப்பொழுது அசீரியர் அந்நாட்டைப்","poem":1},{"text":"பாலைவனப் பிராணிகளின் இருப்பிடமாக்கி விட்டார்கள்.","poem":2},{"text":"முற்றுகைக் கோபுரங்களை எழுப்பி,","poem":1},{"text":"அதன் கோட்டைகளை வெறுமையாக்கிப்","poem":2},{"lineBreak":true},{"text":"பாழிடமாக்கி விட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"தர்ஷீசின் கப்பல்களே, அலறுங்கள்;","poem":1},{"text":"உங்கள் கோட்டை அழிக்கப்பட்டது!","poem":2}]},{"type":"verse","number":15,"content":["அந்த நாளிலே, தீரு எழுபது வருடங்களுக்கு மறக்கப்பட்டுவிடும்; இதுவே ஒரு அரசனின் ஆயுட்காலம். ஆனாலும் அந்த எழுபது வருடங்களின் முடிவில், தீருவின் நிலைமை வேசியின் பாடலில் உள்ளபடியே இருக்கும்:"]},{"type":"verse","number":16,"content":[{"text":"“மறக்கப்பட்ட வேசியே,","poem":1},{"text":"வீணையை எடு, பட்டணத்தைச்சுற்றி நட;","poem":2},{"text":"உன்னை நினைவுகூரும்படியாக","poem":1},{"text":"வீணையை நன்றாக வாசித்து, அநேக பாடல்களைப் பாடு.”","poem":2}]},{"type":"verse","number":17,"content":["யெகோவா தீருவுக்கு எழுபது வருட முடிவில் தண்டனை கொடுப்பார். அவள் மறுபடியும் தனது வேசித்தன வாழ்வுக்கே திரும்புவாள். பூமியிலுள்ள எல்லா அரசுகளுடனும் தன் வேசித்தொழிலைச் செய்வாள்."]},{"type":"verse","number":18,"content":["ஆயினும் அவளது இலாபமும், வருமானமும் யெகோவாவுக்கென்று ஒதுக்கி வைக்கப்படும். அவை சேமித்து வைக்கப்படவோ, பதுக்கி வைக்கப்படவோ மாட்டாது. அவளுடைய அந்த இலாபம் யெகோவாவுக்கு முன்பாக இருப்போருக்கான போதிய அளவு உணவுக்கும், சிறந்த உடைகளுக்குமே செலவிடப்படும்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/22.json","previousChapterAudioLinks":{},"numberOfVerses":18}