{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":24,"content":[{"type":"heading","content":["பூமியின் அழிவு"]},{"type":"verse","number":1,"content":[{"text":"இதோ, யெகோவா பூமியை அழித்து","poem":1},{"text":"சீர்குலைக்கப்போகிறார்.","poem":2},{"text":"அதன் மேற்பரப்பைப் பாழாக்கி,","poem":1},{"text":"குடிகளைச் சிதறடிப்பார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மக்களைப்போலவே ஆசாரியனுக்கும்,","poem":1},{"text":"வேலைக்காரனைப் போலவே தலைவனுக்கும்,","poem":2},{"lineBreak":true},{"text":"வேலைக்காரியைப் போலவே தலைவிக்கும்,","poem":2},{"lineBreak":true},{"text":"வாங்குபவனைப் போலவே விற்பவனுக்கும்,","poem":2},{"lineBreak":true},{"text":"இரவல் வாங்குபவனைப் போலவே இரவல் கொடுப்பவனுக்கும்,","poem":2},{"lineBreak":true},{"text":"கடனாளியைப்போலவே கடன் கொடுப்பவனுக்குமாக","poem":2},{"lineBreak":true},{"text":"எல்லோருக்கும் ஒரேவிதமாகவே நடக்கும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பூமி முழுவதும் அழிக்கப்பட்டு","poem":1},{"text":"முழுமையாகக் கொள்ளையடிக்கப்படும்.","poem":2},{"text":"யெகோவாவே இந்த வார்த்தையைப் பேசியிருக்கிறார்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"பூமி வறண்டு வாடுகிறது,","poem":1},{"text":"உலகம் நலிந்து வாடுகிறது;","poem":2},{"lineBreak":true},{"text":"பூமியில் உயர்த்தப்பட்டவர்கள் தளர்ந்து போகிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பூமி அதன் மக்களால் கறைப்படுத்தப்பட்டிருக்கிறது;","poem":1},{"text":"அவர்கள் சட்டங்களுக்குக் கீழ்ப்படியவில்லை.","poem":2},{"text":"அவர்கள் அதன் ஒழுங்குவிதிகளைச் சீர்குலைத்து,","poem":1},{"text":"நித்திய உடன்படிக்கையையும் மீறினார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஆகவே சாபம் பூமியைச் சூழ்ந்து பற்றிப் பிடித்திருக்கிறது.","poem":1},{"text":"பூமியின் மக்களே தங்கள் குற்றத்தைச் சுமக்கவேண்டும்.","poem":2},{"text":"ஆதலால் பூமியின் குடிகள் எரிக்கப்பட்டுப் போனார்கள்.","poem":1},{"text":"மிகச் சிலரே மீந்திருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"புதுத் திராட்சை இரசம் வற்றுகிறது, திராட்சைக்கொடி தளர்கிறது;","poem":1},{"text":"மகிழ்ச்சியாயிருக்கும் இதயங்களெல்லாம் பெருமூச்சு விடுகின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மேளத்தின் ஆனந்த ஒலி ஓய்ந்தது,","poem":1},{"text":"களிகூர்ந்தவர்களின் சத்தமும் நின்றுவிட்டது;","poem":2},{"lineBreak":true},{"text":"யாழின் இன்னிசை அடங்கிற்று.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இனிமேல் அவர்கள் திராட்சை இரசத்தைப் பாட்டுடன் குடிப்பதில்லை,","poem":1},{"text":"மதுபானம் அதைக் குடிப்பவருக்குக் கசப்பாய் இருக்கும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அழிக்கப்பட்ட பட்டணம் பாழாய்க் கிடக்கிறது;","poem":1},{"text":"வீடுகளின் நுழைவாசல்கள் ஒவ்வொன்றும் அடைபட்டுக் கிடக்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் வீதிகளில் திராட்சை இரசத்திற்காக அழுகிறார்கள்;","poem":1},{"text":"இன்பமெல்லாம் துன்பமாக மாறுகின்றன;","poem":2},{"lineBreak":true},{"text":"சந்தோஷம் அனைத்தும் பூமியினின்று அகற்றப்படுகின்றன.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பட்டணம் பாழாக விடப்பட்டிருக்கிறது,","poem":1},{"text":"அதன் வாசல் கதவுகள் துண்டுகளாக நொறுக்கப்பட்டிருக்கின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அப்பொழுது ஒலிவமரம் உலுக்கப்பட்டு,","poem":1},{"text":"பழம் பறித்தபின் சில பழங்கள் மீந்திருப்பது போலவும்,","poem":2},{"text":"திராட்சை அறுவடையின்பின் கிளைகளில்","poem":1},{"text":"சில பழங்கள் மீந்திருப்பது போலுமே","poem":2},{"text":"பூமியின்மேலும், நாடுகளின் இடையேயும்","poem":1},{"text":"மீந்திருப்போர் மட்டுமே விடப்பட்டிருப்பர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"அவர்கள் தங்கள் குரல்களை உயர்த்தி, மகிழ்ச்சியுடன் சத்தமிடுகிறார்கள்;","poem":1},{"text":"அவர்கள் மேற்கிலிருந்து யெகோவாவின் மாட்சிமையைப் பாராட்டுகிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆகவே கிழக்கிலே யெகோவாவை மகிமைப்படுத்துங்கள்;","poem":1},{"text":"கடலின் தீவுகளில் இஸ்ரயேலின்","poem":2},{"lineBreak":true},{"text":"இறைவனாகிய யெகோவாவின் பெயரைப் புகழ்ந்து உயர்த்துங்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“நீதியுள்ளவருக்கே மகிமை”","poem":1},{"text":"என்று பாடுவதை பூமியின் கடைசிகளிலிருந்து நாம் கேட்கிறோம்.","poem":2},{"lineBreak":true},{"text":"ஆனால் நானோ, “நான் அழிகிறேன், நான் அழிகிறேன்","poem":1},{"text":"ஐயோ எனக்குக் கேடு!","poem":2},{"text":"துரோகிகள் துரோகம் பண்ணுகிறார்கள்!","poem":1},{"text":"துரோகிகள் நம்பிக்கைத் துரோகம் செய்கிறார்கள்” என்றேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"பூமியின் குடிகளே,","poem":1},{"text":"பயங்கரமும், படுகுழியும், கண்ணியுமே உங்களுக்காகக் காத்திருக்கின்றன.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"பயங்கரத்தின் சத்தம் கேட்டு ஓடுபவன்","poem":1},{"text":"படுகுழிக்குள் விழுவான்.","poem":2},{"text":"குழியிலிருந்து வெளியேறுபவன்","poem":1},{"text":"கண்ணியில் அகப்படுவான்.","poem":2},{"lineBreak":true},{"text":"வானத்தின் மதகுகள் திறக்கப்பட்டிருக்கின்றன,","poem":1},{"text":"பூமியின் அஸ்திபாரங்கள் அசைகின்றன.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"பூமி உடைந்து போயிருக்கிறது,","poem":1},{"text":"பூமி பிளக்கப்பட்டுப் போயிருக்கிறது,","poem":2},{"lineBreak":true},{"text":"பூமி அதிர்ந்து நடுங்குகிறது.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"பூமி போதை கொண்டவன்போல் தள்ளாடுகிறது,","poem":1},{"text":"அது காற்றில் அடிபடும் கூடாரத்தைப்போல் அசைகிறது;","poem":2},{"text":"மீறுதலின் பாவம் அதன்மேல் அவ்வளவாய் இருப்பதால்,","poem":1},{"text":"ஒருபோதும் திரும்ப எழும்பாது விழுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"அந்த நாளிலே, மேலே வானத்தில் இருக்கும் வல்லமைகளையும்,","poem":1},{"text":"கீழே பூமியில் இருக்கும்","poem":2},{"lineBreak":true},{"text":"அரசர்களையும் யெகோவா தண்டிப்பார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"இருண்ட அறைக்குள் கட்டப்பட்டுள்ள கைதிகளைப்போல்,","poem":1},{"text":"அவர்கள் ஒன்றுசேர்க்கப்படுவார்கள்.","poem":2},{"text":"அவர்கள் சிறையில் அடைக்கப்பட்டு","poem":1},{"text":"அநேக நாட்களுக்குப்பின் தண்டிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"சந்திரன் நாணமடையும்,","poem":1},{"text":"சூரியன் வெட்கமடையும்;","poem":2},{"text":"ஏனெனில், சேனைகளின் யெகோவா","poem":1},{"text":"சீயோன் மலையிலும் எருசலேமிலும்","poem":2},{"lineBreak":true},{"text":"அதன் முதியோர் முன்னிலையில் மகிமையோடு ஆளுகை செய்வார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}