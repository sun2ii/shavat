{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":25,"content":[{"type":"heading","content":["யெகோவாவுக்குத் துதி"]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நீரே என் இறைவன்;","poem":1},{"text":"நான் உம்மைப் புகழ்ந்துயர்த்தி, உமது பெயரைத் துதிப்பேன்.","poem":2},{"text":"அற்புதமான செயல்களைச் செய்திருக்கிறீர்;","poem":1},{"text":"நீர் பூர்வகாலத்தில் அவைகளை திட்டமிட்டபடி,","poem":2},{"lineBreak":true},{"text":"பரிபூரண உண்மையுடன் நிறைவேற்றியுள்ளீர்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீர் அந்நியரின் பட்டணத்தை இடிபாடுகளின் குவியலாக்கினீர்;","poem":1},{"text":"அரணான பட்டணத்தைப் பாழாக்கினீர்.","poem":2},{"text":"அந்நியரின் அரண் இனிமேலும் ஒரு பட்டணமாயிராது;","poem":1},{"text":"அது இனியொருபோதும் திரும்பக் கட்டப்படுவதுமில்லை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஆகவே வலிமையுள்ள மக்கள் கூட்டங்கள் உம்மை மகிமைப்படுத்துவார்கள்;","poem":1},{"text":"இரக்கமற்ற நாடுகளின் பட்டணங்கள் உம்மைக் கனம்பண்ணும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீர் ஏழைகளுக்கு அடைக்கலமாயிருந்தீர்;","poem":1},{"text":"வறுமையுற்றோரின் துயரில் அவர்களுக்கு அடைக்கலமாயிருந்தீர்.","poem":2},{"text":"புயலிலிருந்து காக்கும் புகலிடமாகவும்,","poem":1},{"text":"வெயிலிலிருந்து காக்கும் நிழலாகவும் இருந்தீர்.","poem":2},{"text":"முரடர்களின் மூச்சு,","poem":1},{"text":"ஒரு மதிலுக்கு எதிராக வீசும் புயலைப்போல் இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"அது பாலைவன வெப்பத்தைப் போலவும் இருக்கிறது.","poem":2},{"text":"அந்நியரின் ஆர்ப்பாட்டத்தை நீர் அடக்குகிறீர்;","poem":1},{"text":"மேகத்தின் நிழலால் வெப்பம் தணிவதுபோல,","poem":2},{"lineBreak":true},{"text":"இரக்கமற்றோரின் பாடலும் அடங்கிப் போகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"சேனைகளின் யெகோவா இந்த மலைமேல் எல்லா மக்கள்கூட்டங்களுக்கும்","poem":1},{"text":"சிறப்பான விருந்தொன்றை ஆயத்தம் பண்ணுவார்.","poem":2},{"lineBreak":true},{"text":"நன்றாகப் பதப்படுத்தப்பட்ட பழைய திராட்சை இரசமும்,","poem":2},{"text":"சிறந்த இறைச்சிகளும்,","poem":1},{"text":"உயர்வகை திராட்சை இரசமும் நிறைந்த விருந்தாக அது இருக்கும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இந்த எல்லா மக்கள் கூட்டங்களையும்","poem":1},{"text":"மூடியிருந்த மூடுதிரையை அவர் இந்த மலையில் அழிப்பார்;","poem":2},{"text":"இதுவே எல்லா நாடுகளையும் மூடியிருந்த திரைச்சீலையாகும்.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"மரணம் என்றென்றும் இல்லாதபடி அவர் அதை விழுங்கிவிடுவார்.","poem":2},{"text":"ஆண்டவராகிய யெகோவா எல்லா முகங்களிலுமுள்ள","poem":1},{"text":"கண்ணீரைத் துடைத்துவிடுவார்.","poem":2},{"text":"அவர் பூமியெங்குமுள்ள தன் மக்களின்","poem":1},{"text":"அவமானத்தை நீக்கிவிடுவார்.","poem":2},{"text":"யெகோவாவே இதைப் பேசியிருக்கிறார்.","poem":1}]},{"type":"verse","number":9,"content":["அந்த நாளிலே மக்கள் கூட்டங்கள்,",{"text":"“நிச்சயமாக இவரே நம் இறைவன்; நாம் இவரில் நம்பிக்கை வைத்தோம்,","poem":1},{"text":"இவர் எங்களை மீட்டார்.","poem":2},{"text":"இவரே யெகோவா, இவரில் நாம் நம்பிக்கை வைத்தோம்;","poem":1},{"text":"இவர் கொடுக்கும் இரட்சிப்பில் நாம் மகிழ்ந்து களிகூருவோம்” என்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவாவின் கரம் இந்த சீயோன் மலையில் தங்கும்;","poem":1},{"text":"வைக்கோல் எருக்களத்தில் மிதிக்கப்படுவதுபோல்,","poem":2},{"lineBreak":true},{"text":"மோவாபியர் அவரின்கீழ் மிதிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நீந்துபவன் நீந்துவதற்காகத் தன் கைகளை விரிப்பதுபோல்,","poem":1},{"text":"மோவாபியர் தங்கள் கைகளை விரிப்பார்கள்;","poem":2},{"text":"அவர்களுடைய கைகளில் திறமை இருந்தபோதிலும்,","poem":1},{"text":"இறைவன் அவர்களுடைய பெருமையைச் சிறுமைப்படுத்துவார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மோவாபின் உயரமான அரண்செய்யப்பட்ட மதில்களை","poem":1},{"text":"அவர் கீழே தள்ளி விழ்த்துவார்.","poem":2},{"text":"அவைகளை அவர் நிலத்தின் புழுதியில் கீழே","poem":1},{"text":"தள்ளிப் போடுவார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/24.json","previousChapterAudioLinks":{},"numberOfVerses":12}