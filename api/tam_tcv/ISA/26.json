{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":26,"content":[{"type":"heading","content":["துதிப்பாடல்"]},{"type":"verse","number":1,"content":["அந்த நாளிலே யூதா நாட்டில் இந்தப் பாடல் பாடப்படும்:",{"text":"நமக்கொரு பலமுள்ள பட்டணம் உண்டு;","poem":1},{"text":"இறைவன் இரட்சிப்பை,","poem":2},{"lineBreak":true},{"text":"அதன் மதில்களாகவும் பாதுகாப்பாகவும் ஆக்குகிறார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"வாசல்களைத் திறவுங்கள்,","poem":1},{"text":"நீதியுள்ள நாடு உள்ளே வரட்டும்,","poem":2},{"lineBreak":true},{"text":"நேர்மையான நாடு உள்ளே வரட்டும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"மனவுறுதியுடன் இருப்பவனை","poem":1},{"text":"நீர் முழுநிறைவான சமாதானத்துடன் வைத்திருப்பீர்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் அவன் உம்மிலேயே நம்பிக்கை வைத்திருக்கிறான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவாவிடம் என்றென்றும் நம்பிக்கையை வையுங்கள்;","poem":1},{"text":"ஏனெனில், யெகோவா, யெகோவாவே நித்திய கற்பாறை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உயர்வாக வாழ்வோரை அவர் தாழ்த்துகிறார்;","poem":1},{"text":"உயர்த்தப்பட்ட பட்டணத்தை","poem":2},{"text":"கீழே தள்ளி வீழ்த்துகிறார்,","poem":1},{"text":"அதைத் தரைமட்டமாக்கிப் புழுதியாக்குகிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"கால்கள் அதை மிதிக்கின்றன.","poem":1},{"text":"ஒடுக்கப்பட்டவர்களின் பாதங்களும்,","poem":2},{"lineBreak":true},{"text":"ஏழைகளின் காலடிகளுமே அதை மிதிக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நீதியானவர்களின் பாதை நேர்சீரானது;","poem":1},{"text":"நீதியாளரே, நீரே நீதியானவர்களின் வழியைச் சீர்படுத்துகிறீர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆம், யெகோவாவே, உமது சட்டங்களின் வழியில் நடந்து,","poem":1},{"text":"உமக்குக் காத்திருக்கிறோம்;","poem":2},{"text":"உமது பெயரும் உமது புகழுமே","poem":1},{"text":"எங்கள் இருதயங்களின் வாஞ்சையாய் இருக்கின்றன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இரவிலே என் ஆத்துமா உம்மை ஆர்வத்தோடு தேடுகிறது,","poem":1},{"text":"காலையிலே என் ஆவி உம்மை வாஞ்சையுடன் தேடுகிறது.","poem":2},{"text":"உமது நியாயத்தீர்ப்புகள் பூமியிலே வரும்போது","poem":1},{"text":"உலக மக்கள் நியாயத்தைக் கற்றுக்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"கொடியவருக்கு கிருபை காண்பிக்கப்படுகிறபொழுதும்,","poem":1},{"text":"அவர்கள் நியாயத்தைக் கற்றுக்கொள்வதில்லை.","poem":2},{"text":"நீதியுள்ள நாட்டிலும் அவர்கள் தொடர்ந்து தீமையையே செய்கிறார்கள்;","poem":1},{"text":"யெகோவாவின் மாட்சிமையையும் அவர்கள் மதிப்பதில்லை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவாவே, உமது கரம் மேலே உயர்த்தப்பட்டிருக்கிறது,","poem":1},{"text":"ஆயினும் அதை அவர்கள் காணாதிருக்கிறார்கள்.","poem":2},{"text":"உமது மக்களுக்காக நீர் கொண்டிருக்கும் வைராக்கியத்தைக் கண்டு","poem":1},{"text":"அவர்கள் வெட்கமடையட்டும்;","poem":2},{"text":"உமது பகைவருக்காக ஆயத்தப்படுத்தப்பட்டிருக்கும் நெருப்பு","poem":1},{"text":"அவர்களைச் சுட்டெரிக்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவாவே, நீரே எங்களுக்குச் சமாதானத்தை நிலைநாட்டுகிறீர்;","poem":1},{"text":"நாங்கள் நிறைவேற்றியவற்றை நீரே எங்களுக்காக செய்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவாவே, எங்கள் இறைவனே,","poem":1},{"text":"உம்மைத்தவிர வேறு ஆளுநர்களும் நம்மை ஆண்டிருக்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"ஆனால் உமது பெயரை மட்டுமே நாங்கள் கனப்படுத்துகிறோம்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"இப்பொழுது அவர்கள் இறந்துவிட்டார்கள்;","poem":1},{"text":"இனி அவர்கள் வாழ்வதில்லை, பிரிந்துபோன அந்த ஆவிகள் எழும்புவதில்லை.","poem":2},{"text":"நீர் அவர்களைத் தண்டித்து அழிவுக்கு உட்படுத்தினீர்;","poem":1},{"text":"அவர்களைப்பற்றிய நினைவையே அழித்துப்போட்டீர்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீர் நாட்டைப் பெருகப்பண்ணியிருக்கிறீர்;","poem":1},{"text":"யெகோவாவே, நீர் நாட்டைப் பெருகப்பண்ணியிருக்கிறீர்.","poem":2},{"text":"நீர் உமக்கென்று மகிமையை வென்றெடுத்திருக்கிறீர்;","poem":1},{"text":"நாட்டின் எல்லைகள் அனைத்தையும் நீர் விரிவாக்கியிருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"யெகோவாவே, அவர்கள் தமது துன்பத்தில் உம்மிடம் வந்தார்கள்;","poem":1},{"text":"நீர் அவர்களைச் சீர்ப்படுத்துவதற்காகத் தண்டித்தபோது,","poem":2},{"lineBreak":true},{"text":"அவர்கள் மன்றாடுவதற்குக்கூட பெலனற்று இருந்தார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"பிரசவிக்க இருக்கின்ற கர்ப்பவதி","poem":1},{"text":"தனது வேதனையில் துடித்து அழுவதுபோல,","poem":2},{"lineBreak":true},{"text":"யெகோவாவே, நாங்களும் உமது முன்னிலையில் வருந்தி நின்றோம்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நாங்களும் கர்ப்பந்தரித்து வேதனையில் துடித்தோம்;","poem":1},{"text":"ஆனால் நாங்கள் காற்றையே பெற்றெடுத்தோம்.","poem":2},{"text":"பூமிக்கு இரட்சிப்பை நாங்கள் கொண்டுவரவில்லை,","poem":1},{"text":"நாங்கள் உலக மக்களைப் பெற்றெடுக்கவுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ஆனாலும் மரித்த உமது மக்கள் உயிர்வாழ்வார்கள்;","poem":1},{"text":"அவர்களின் உடல்கள் உயிர்த்தெழும்பும்.","poem":2},{"text":"புழுதியில் வாழ்பவர்களே,","poem":1},{"text":"எழுந்து மகிழ்ந்து சத்தமிடுங்கள்.","poem":2},{"text":"உமது பனி காலைப் பனிபோல் இருக்கிறது;","poem":1},{"text":"பூமி தனது மரித்தோரைப் பெற்றெடுக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"என் மக்களே, நீங்கள் உங்கள் அறைகளுக்குள் போய்,","poem":1},{"text":"கதவுகளை மூடுங்கள்.","poem":2},{"text":"அவருடைய கோபம் கடந்துபோகும்வரை,","poem":1},{"text":"சற்று நேரம் உங்களை மறைத்துக்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"இதோ, பூமியின் குடிகளை அவர்களுடைய பாவங்களுக்காகத் தண்டிப்பதற்கு,","poem":1},{"text":"யெகோவா தனது உறைவிடத்தில் இருந்து வருகிறார்.","poem":2},{"text":"பூமி தன்மேல் சிந்தப்பட்ட இரத்தத்தை வெளிப்படுத்தும்;","poem":1},{"text":"அது தன்மேல் கொலைசெய்யப்பட்டவர்களை இனிமேல் மறைக்கப் போவதில்லை.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/25.json","previousChapterAudioLinks":{},"numberOfVerses":21}