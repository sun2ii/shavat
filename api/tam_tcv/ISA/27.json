{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":27,"content":[{"type":"heading","content":["இஸ்ரயேலின் மீட்பு"]},{"type":"verse","number":1,"content":["அந்த நாளிலே,",{"text":"யெகோவா விரைந்தோடும் பாம்பை,","poem":1},{"text":"லிவியாதான் என்னும் அந்த நெளிந்து செல்லும் பாம்பை","poem":2},{"text":"கர்த்தர் தமது பயங்கரமான பெரிய வலிமையுள்ள","poem":1},{"text":"வாளினால் தண்டிப்பார்.","poem":2},{"text":"அவர் அந்த கடலில் இருக்கும் வலுசர்ப்பத்தை வெட்டி வீழ்த்துவார்.","poem":1}]},{"type":"verse","number":2,"content":["அந்த நாளிலே,",{"text":"“பழம் நிறைந்த திராட்சைத் தோட்டத்தைப் பற்றிப் பாடுங்கள்:","poem":1}]},{"type":"verse","number":3,"content":[{"text":"யெகோவாவாகிய நானே அதைக் காவல் செய்கிறேன்;","poem":2},{"lineBreak":true},{"text":"இடைவிடாமல் அதற்குத் தண்ணீர் பாய்ச்சுகிறேன்.","poem":2},{"text":"ஒருவரும் அதற்குத் தீங்கு செய்யாதபடி,","poem":1},{"text":"நான் இரவும் பகலும் அதைக் காவல் செய்கிறேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"நான் இஸ்ரயேலருடன் கோபிக்கவில்லை.","poem":2},{"text":"அவர்கள் முள்ளுகளும், நெருஞ்சில்களுமாய் இருப்பார்களானால்,","poem":1},{"text":"நான் அவற்றிற்கு விரோதமாகப் போரிட அணிவகுப்பேன்;","poem":2},{"lineBreak":true},{"text":"அவை அனைத்திற்கும் நெருப்பு மூட்டுவேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அல்லது அவர்கள் என்னிடம் அடைக்கலம்புக வரட்டும்;","poem":1},{"text":"என்னுடன் சமாதானம் செய்யட்டும்,","poem":2},{"lineBreak":true},{"text":"ஆம், என்னுடன் சமாதானம் செய்யட்டும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"வரப்போகும் நாட்களிலே யாக்கோபு வேர்பற்றி,","poem":1},{"text":"இஸ்ரயேல் துளிர்த்து, பூத்து,","poem":2},{"lineBreak":true},{"text":"முழு உலகத்தையும் பலனால் நிரப்பும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"இஸ்ரயேலர்களைத் தாக்கியவர்களை யெகோவா அடித்ததுபோல,","poem":1},{"text":"இஸ்ரயேலரையும் அவர் அடித்தாரோ?","poem":2},{"text":"இஸ்ரயேலர்களைக் கொன்றவர்கள் கொல்லப்பட்டதுபோல்,","poem":1},{"text":"இஸ்ரயேலரும் கொல்லப்பட்டார்களோ? இல்லையே!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர் போரினாலும், நாடு கடத்துதலினாலும் இஸ்ரயேலருடன் வழக்காடுகிறீர்;","poem":1},{"text":"கிழக்குக் காற்று வீசும் அந்த நாளில் நடப்பதுபோல்,","poem":2},{"lineBreak":true},{"text":"அவர் தனது கோபத்தின் வேகத்தால் அவர்களைச் சிறிது காலத்திற்குத் துரத்துகிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யாக்கோபின் குற்றம் இவ்விதமாகவே நிவிர்த்தியாக்கப்படும்.","poem":1},{"text":"அவனுடைய பாவம் நீக்கப்படுவதன் முழுவிலையும் இதுவே:","poem":2},{"text":"அவர் பலிபீடக் கற்களை எல்லாம்","poem":1},{"text":"சுண்ணாம்புக் கற்கள்போல் துண்டுகளாக நொறுக்கும்போது,","poem":2},{"text":"அசேரா தேவதைத் தூண்களோ,","poem":1},{"text":"தூபங்காட்டும் பீடங்களோ அங்கு விட்டுவைக்கப்படமாட்டாது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அரணாக்கப்பட்ட பட்டணம்,","poem":1},{"text":"குடியிருப்பாரின்றி பாலைவனம்போல் கைவிடப்பட்டு, பாழாகிக் கிடக்கிறது;","poem":2},{"text":"அங்கே கன்றுகள் மேயும்,","poem":1},{"text":"அங்கேயே அவை படுத்துக்கொள்ளும்;","poem":2},{"lineBreak":true},{"text":"அவை அதன் கொப்புகளை வெறுமையாக்கிவிடும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அதன் மெல்லிய கொப்புகள் காயும்போது அவை முறிக்கப்படுகின்றன;","poem":1},{"text":"பெண்கள் வந்து அவைகளை எரிப்பதற்கு விறகாகப் பயன்படுத்துகிறார்கள்.","poem":2},{"text":"ஏனெனில், அவர்கள் உணர்வில்லாத மக்கள்;","poem":1},{"text":"எனவே அவர்களை உண்டாக்கியவர் அவர்கள்மேல் இரக்கம் கொள்ளவில்லை,","poem":2},{"lineBreak":true},{"text":"அவர்களைப் படைத்தவர் அவர்கள்மேல் தயவுகாட்டவில்லை.","poem":2}]},{"type":"verse","number":12,"content":["அந்நாளிலே யெகோவா, ஓடும் நதிதொடங்கி, எகிப்தின் சிற்றாறுவரை தன் கதிரடிப்பைத் தொடங்குவார். இஸ்ரயேலே, நீங்களோ ஒவ்வொருவராகச் சேர்த்தெடுக்கப்படுவீர்கள்."]},{"type":"verse","number":13,"content":["அந்நாளிலே பெரிய எக்காளம் ஊதப்படும்; அசீரிய நாட்டில் அழிந்துபோகிறவர்களும், எகிப்தில் நாடுகடத்தப்பட்டவர்களும் வந்து, எருசலேமின் பரிசுத்த மலையில் யெகோவாவை வழிபடுவார்கள்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/26.json","previousChapterAudioLinks":{},"numberOfVerses":13}