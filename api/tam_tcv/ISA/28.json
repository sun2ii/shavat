{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":28,"content":[{"type":"heading","content":["எப்பிராயீம் மற்றும் யூதாவின் தலைவர்களுக்கு எச்சரிக்கை"]},{"type":"verse","number":1,"content":[{"text":"எப்பிராயீமிலுள்ள குடிவெறியரின் பெருமையான கிரீடத்திற்கு ஐயோ கேடு!","poem":1},{"text":"அதன் மகிமையின் அழகான வாடும் மலருக்கு ஐயோ கேடு!","poem":2},{"text":"செழிப்பான பள்ளத்தாக்கின் முகப்பில் இருக்கின்ற பட்டணத்திற்கு ஐயோ கேடு!","poem":1},{"text":"மதுவால் வெறியுண்டு வீழ்ச்சியடைந்தவர்களின்","poem":2},{"lineBreak":true},{"text":"பெருமையாகிய அந்த பட்டணத்திற்கும் ஐயோ கேடு!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பாருங்கள், யெகோவா பலமும் வல்லமையுமுள்ள ஒருவனை வைத்திருக்கிறார்.","poem":1},{"text":"அவன் கல்மழை போலவும் அழிக்கும் புயலைப் போலவும்,","poem":2},{"text":"பெருமழைபோலவும், வெள்ளப்பெருக்கு போலவும்","poem":1},{"text":"அதைப் பலத்துடன் நிலத்தில் வீழ்த்துவான்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எப்பிராயீமிலுள்ள குடிவெறியரின் பெருமையாகிய","poem":1},{"text":"அந்த மலர் மகுடம் காலின்கீழ் மிதிக்கப்படும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"செழிப்பான பள்ளத்தாக்கின் மேலுள்ள,","poem":1},{"text":"அவளது மகிமையின் அழகாகிய அந்த வாடும் மலர்,","poem":2},{"text":"அறுவடை காலத்திற்கு முன் பழுக்கும் அத்திப்பழத்தைப் போலாகும்.","poem":1},{"text":"அதைக் காண்பவன் தன் கையில் கிடைத்ததும்","poem":2},{"lineBreak":true},{"text":"விழுங்கி விடுகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அந்த நாளிலே, சேனைகளின் யெகோவா","poem":1},{"text":"தம் மக்களுள் மீதியாய் இருப்பவர்களுக்கு","poem":2},{"text":"ஒரு அழகிய மலர் மகுடமும்","poem":1},{"text":"மகிமையுள்ள ஒரு கிரீடமுமாய் இருப்பார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் நியாயத்தீர்ப்பு வழங்க உட்காருபவனுக்கு","poem":1},{"text":"நீதியின் ஆவியாய் இருப்பார்;","poem":2},{"text":"பகைவரை வாசலிலேயே திருப்பி அனுப்புகிறவர்களுக்கு","poem":1},{"text":"பலத்தின் ஆதாரமாய் இருப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஆனால் இப்பொழுதோ இஸ்ரயேலின் தலைவர்கள்","poem":1},{"text":"திராட்சை இரசத்தினால் தடுமாறி,","poem":2},{"text":"மதுபோதையினால் தள்ளாடுகிறார்கள்.","poem":1},{"text":"ஆசாரியரும் இறைவாக்கு உரைப்போரும் மதுவெறியால் தடுமாறுகிறார்கள்.","poem":2},{"text":"திராட்சை இரசத்தால் மயங்கி, மதுவெறியினால் தள்ளாடுகிறார்கள்.","poem":1},{"text":"அவர்கள் தரிசனம் காணும்போது தடுமாறி,","poem":2},{"lineBreak":true},{"text":"தீர்மானம் எடுக்கும்போது இடறுகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மேஜைகள் யாவும் வாந்தியால் நிறைந்திருக்கின்றன.","poem":1},{"text":"அழுக்குப்படியாத இடமே அங்கு இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“யாருக்கு அவர் போதிக்க முயற்சிக்கிறார்?","poem":1},{"text":"யாருக்கு அவர் செய்தியை விளங்கப்படுத்துகிறார்?","poem":2},{"text":"பால் மறந்த பிள்ளைகளுக்கோ?","poem":1},{"text":"அல்லது பால் குடிக்கையில் தாயின் மார்பின் அணைப்பிலிருந்து","poem":2},{"lineBreak":true},{"text":"எடுக்கப்பட்ட குழந்தைகளுக்கோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் படிப்பிக்கும் விதமோ:","poem":1},{"text":"இதைச் செய், அதைச் செய்;","poem":2},{"lineBreak":true},{"text":"கட்டளைக்குமேல் கட்டளை, கட்டளைக்குமேல் கட்டளை;","poem":2},{"lineBreak":true},{"text":"இங்கு கொஞ்சம், அங்கு கொஞ்சம்” என இருக்கும் என்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"அப்படியானால், அந்நிய உதடுகளாலும் விளங்காத மொழியினாலும்","poem":1},{"text":"இறைவன் இந்த மக்களுடன் பேசுவார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் அவர்களிடம்,","poem":1},{"text":"“இளைப்பாறும் இடம் இதுவே; களைப்புற்றோர் இளைப்பாறட்டும்.","poem":2},{"text":"ஓய்வு பெறுவதற்கான இடம் இதுவே” என்று சொல்லியிருந்தார்.","poem":1},{"text":"ஆனால் அவர்களோ அதைக் கேட்க மறுக்கிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"எனவே, அப்பொழுது யெகோவாவினுடைய வார்த்தை அவர்களுக்கு,","poem":1},{"text":"“இதைச் செய், அதைச் செய்;","poem":2},{"lineBreak":true},{"text":"கட்டளைமேல் கட்டளை, கட்டளைமேல் கட்டளை;","poem":2},{"lineBreak":true},{"text":"இங்கு கொஞ்சம், அங்கு கொஞ்சம்” என்றாகிவிடும்.","poem":2},{"text":"ஆயினும் அவர்கள் போய் பின்புறமாய்த் தடுமாறி விழுந்து,","poem":1},{"text":"காயப்பட்டு, கண்ணியில் அகப்பட்டு கைதுசெய்யப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஆதலால் எருசலேமில் இந்த மக்களை ஆளுகை செய்வோரே! இகழ்வோரே!","poem":1},{"text":"நீங்கள் யெகோவாவின் வார்த்தையைக் கேளுங்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“நாம் மரணத்துடன் ஒரு உடன்படிக்கை செய்திருக்கிறோம்;","poem":1},{"text":"பாதாளத்துடனும் ஒப்பந்தம் செய்திருக்கிறோம்.","poem":2},{"text":"ஆகையால், நம்மை மேற்கொள்ளக்கூடிய துன்புறுத்தல் இங்கு வரும்போது","poem":1},{"text":"அது தாக்காது;","poem":2},{"text":"பொய் நமக்கு அடைக்கலமாயும்,","poem":1},{"text":"வஞ்சகம் நமக்கு மறைவிடமாயும் இருக்கும்” என்று சொல்லுகிறீர்கள்.","poem":2}]},{"type":"verse","number":16,"content":["ஆதலால், ஆண்டவராகிய யெகோவா சொல்வது இதுவே:",{"text":"“இதோ, நான் சீயோனில் ஒரு கல்லை வைக்கிறேன்;","poem":1},{"text":"அது சோதித்துப் பார்க்கப்பட்ட கல்,","poem":2},{"text":"அது உறுதியான அஸ்திபாரத்துக்கான விலையேறப்பெற்ற மூலைக்கல்;","poem":1},{"text":"அதில் நம்பிக்கை வைக்கும் எவரும் ஒருபோதும் பதறமாட்டார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நான் நீதியை அளவு நூலாக்குவேன்;","poem":1},{"text":"நியாயத்தைத் தூக்கு நூலாக்குவேன்.","poem":2},{"text":"உங்கள் பொய்யான அடைக்கலத்தை, கல்மழை அழிக்கும்;","poem":1},{"text":"வெள்ளம் உங்கள் மறைவிடத்திற்கு மேலாகப் பெருக்கெடுக்கும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"மரணத்துடன் நீங்கள் செய்த உடன்படிக்கை ரத்துச் செய்யப்படும்;","poem":1},{"text":"பாதாளத்துடன் செய்த ஒப்பந்தம் நிலைக்காது.","poem":2},{"text":"தண்டனை பெருவெள்ளம்போல் வாரிக்கொண்டு போகும்போது,","poem":1},{"text":"நீங்கள் அதனால் அடிபட்டு விழுவீர்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அது வரும்போதெல்லாம் உங்களை அடித்துச்செல்லும்;","poem":1},{"text":"அது காலைதோறும், இரவும் பகலும்","poem":2},{"lineBreak":true},{"text":"தண்டிப்பதற்காக வந்து வாரிக்கொண்டு போகும்.”","poem":2},{"lineBreak":true},{"text":"இச்செய்தியை நீங்கள் விளங்கிக்கொள்வது","poem":1},{"text":"உங்களுக்குப் பேரச்சத்தை விளைவிக்கும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"கால் நீட்டிப் படுக்கக் கட்டிலின் நீளம் போதாது;","poem":1},{"text":"மூடிக்கொள்ள போர்வையின் அகலமும் போதாது.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"யெகோவா பேராசீம் மலையில் எழுந்ததுபோல் எழும்புவார்,","poem":1},{"text":"கிபியோன் பள்ளத்தாக்கில் கோபங்கொண்டதுபோல் எழும்புவார்.","poem":2},{"text":"அவர் தமது வேலையை, எதிர்பாராத வேலையைச் செய்வதற்கும்,","poem":1},{"text":"தமது கடமையை, தாம் விரும்பாத கடமையை நிறைவேற்றுவதற்கும் எழும்புவார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"உங்கள் ஏளனத்தை இப்பொழுது நிறுத்துங்கள்,","poem":1},{"text":"இல்லையெனில் உங்களைப் பிணைத்திருக்கும் சங்கிலிகள் இன்னும் பாரமாகும்.","poem":2},{"text":"யெகோவா, சேனைகளின் யெகோவா முழு நாட்டுக்கும்","poem":1},{"text":"விரோதமாகத் திட்டமிட்டிருக்கும் அழிவை எனக்குச் சொல்லியிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"கேளுங்கள், என் குரலுக்குச் செவிகொடுங்கள்;","poem":1},{"text":"நான் சொல்வதைக் கவனித்துக் கேளுங்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஒரு விவசாயி பயிரிடுவதற்காக உழும்போது தொடர்ந்து உழுதுகொண்டே இருப்பானோ?","poem":1},{"text":"நிலத்தைத் தொடர்ந்து கொத்தி மண்ணைப் புரட்டிக் கொண்டேயிருப்பானோ?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நிலத்தை மட்டமாக்கியபின் வெந்தயத்தை விதைத்து,","poem":1},{"text":"சீரகத்தையும் தூவமாட்டானோ?","poem":2},{"text":"கோதுமையை அதற்குரிய இடத்திலும்,","poem":1},{"text":"வாற்கோதுமையை அதற்குரிய பாத்தியிலும்,","poem":2},{"lineBreak":true},{"text":"கம்பை அதற்குரிய வயலிலும் விதைக்கமாட்டானோ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவனுடைய இறைவன் அவனுக்கு போதித்து,","poem":1},{"text":"சரியான வழியை அவனுக்குக் கற்ப்பிக்கிறார் அல்லவோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"வெந்தயம் சம்மட்டியால் அடிக்கப்படுவதுமில்லை,","poem":1},{"text":"சீரகம் வண்டிச் சில்லால் மிதிக்கப்படுவதுமில்லை.","poem":2},{"text":"வெந்தயம் கோலினாலும்,","poem":1},{"text":"சீரகம் தடியினாலுமே அடித்தெடுக்கப்படுகின்றன.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அப்பம் செய்வதற்குத் தானியம் அரைக்கப்படவேண்டும்;","poem":1},{"text":"அதற்காகத் தொடர்ந்து ஒருவன் அதை அரைத்துக்கொண்டே இருப்பதில்லை.","poem":2},{"text":"அவன் தனது சூடடிக்கும் வண்டிச் சில்லுகளை அதற்குமேல் செலுத்தியபோதிலும்,","poem":1},{"text":"அவனுடைய குதிரைகள் அதை அரைப்பதில்லை.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"இந்த எல்லா அறிவும் சேனைகளின் இறைவனாகிய யெகோவாவிடமிருந்தே வருகின்றன;","poem":1},{"text":"அவர் ஆலோசனையில் ஆச்சரியமானவர்,","poem":2},{"lineBreak":true},{"text":"ஞானத்தில் சிறந்தவர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/27.json","previousChapterAudioLinks":{},"numberOfVerses":29}