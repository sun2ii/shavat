{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":29,"content":[{"type":"heading","content":["எருசலேமுக்கு ஐயோ!"]},{"type":"verse","number":1,"content":[{"text":"அரியேலே,","poem":1},{"noteId":15},{"text":"அரியேலே,","poem":1},{"text":"தாவீது குடியிருந்த பட்டணமே, ஐயோ, உனக்குக் கேடு!","poem":2},{"text":"வருடத்துடன் வருடத்தைக் கூட்டு,","poem":1},{"text":"உங்கள் பண்டிகைகளும் ஒன்றன்பின் ஒன்றாக நடக்கட்டும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஆனாலும் நான் அரியேலை முற்றுகையிடுவேன்;","poem":1},{"text":"அது துக்கித்துப் புலம்பும்,","poem":2},{"lineBreak":true},{"text":"அது எனக்கு பலிபீடத்தின் அடுப்பைப் போலிருக்கும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் உனக்கு விரோதமாக உன்னைச் சுற்றி முகாமிடுவேன்;","poem":1},{"text":"நான் கோபுரங்களால் உன்னைச் சூழ்ந்துகொள்வேன்,","poem":2},{"lineBreak":true},{"text":"எனது முற்றுகை வேலைகளை உனக்கு விரோதமாய் அமைப்பேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீ தாழ்த்தப்பட்டு நிலத்திலிருந்து பேசுவாய்,","poem":1},{"text":"உனது பேச்சு புழுதியிலிருந்து முணுமுணுக்கும்.","poem":2},{"text":"உனது குரல் செத்தவனின் ஆவியைப்போல் பூமியிலிருந்து வரும்;","poem":1},{"text":"உனது பேச்சு புழுதியிலிருந்து தாழ் குரலாய் வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஆனாலும் யெகோவாவின் நிமித்தம் உனது அநேக பகைவர்கள்","poem":1},{"text":"திடீரென புழுதியைப்போல் ஆவார்கள்;","poem":2},{"lineBreak":true},{"text":"இரக்கமில்லாதவரின் கூட்டங்கள் பறக்கும் பதரைப்போல் ஆகும்.","poem":2},{"text":"சடுதியாய், ஒரு நொடிப்பொழுதில்,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"இடி முழக்கத்துடனும் பூமியதிர்ச்சியுடனும், பெருஞ்சத்தத்துடனும்","poem":2},{"text":"சேனைகளின் யெகோவா அவர்களுக்கெதிராக வருவார்.","poem":1},{"text":"அவர் புயல்காற்றுடனும், சூறாவளியுடனும்,","poem":2},{"lineBreak":true},{"text":"எரிக்கும் நெருப்புச் சுவாலையுடனும் வருவார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அப்பொழுது அரியேலுக்கு விரோதமாய்ப் போரிடும்","poem":1},{"text":"எல்லா நாடுகளின் கூட்டத்தாரும்","poem":2},{"text":"அதன் அரண்களையும் தாக்கி, முற்றுகையிடுகிறவர்கள் ஒரு கனவுபோலவும்,","poem":1},{"text":"இரவின் தரிசனம் போலவும் மறைந்துபோவார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்கள் நினைத்திருந்த வெற்றியோ,","poem":1},{"text":"பசியுள்ளவன் தான் சாப்பிடுவதாகக் கனவு கண்டும்","poem":2},{"text":"அவன் விழித்தவுடன் பசியுடனே இருப்பதுபோலவும்,","poem":1},{"text":"தாகமுள்ளவன் தான் குடிப்பதாகக் கனவு கண்டும்","poem":2},{"text":"அவன் விழித்தவுடன் தீராத தாகத்துடன் மயங்குவதுபோலவும்,","poem":1},{"text":"சீயோன் மலையை எதிர்த்துப் போரிடும் எல்லா நாடுகளின் கூட்டத்திற்கும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"திகைத்து வியப்படையுங்கள்!","poem":1},{"text":"நீங்களே உங்களைக் குருடர்களாக்கி பார்வையற்றவர்களாய் இருங்கள்.","poem":2},{"text":"வெறிகொள்ளுங்கள், ஆனால் திராட்சை இரசத்தினால் அல்ல;","poem":1},{"text":"தள்ளாடுங்கள், ஆனால் மதுவினால் அல்ல.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"யெகோவா உங்கள்மேல் ஆழ்ந்த நித்திரையை வருவித்துள்ளார்:","poem":1},{"text":"அவர் உங்கள் இறைவாக்கினரினதும்","poem":2},{"lineBreak":true},{"text":"தரிசனம் காண்போரினதும் கண்களை மூடியிருக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":["அவர்களுக்கோ இந்த தரிசனம் முழுவதும் முத்திரை இடப்பட்ட சுருளிலிருக்கும் வார்த்தைகளைப்போல் மட்டுமே இருக்கும். நீ அதை வாசிக்கக்கூடிய ஒருவனிடம் கொடுத்து, “தயவுசெய்து இதை வாசி” எனச் சொன்னால் அவன், “எனக்கு வாசிக்க முடியாது. அது முத்திரையிடப்பட்டிருக்கிறது” என்பான்."]},{"type":"verse","number":12,"content":["அல்லது அந்தச் சுருளை வாசிக்கமுடியாத ஒருவனிடம் கொடுத்து, “தயவுசெய்து இதை வாசி” என்று சொன்னால், அவன், “எப்படி வாசிப்பது என எனக்குத் தெரியாது” என்பான்."]},{"type":"verse","number":13,"content":["எனவே யெகோவா சொல்கிறார்:",{"text":"“இந்த மக்கள் தங்கள் வாயின் வார்த்தைகளினால் என்னைக் கிட்டிச் சேருகிறார்கள்;","poem":1},{"text":"தங்கள் உதடுகளினால் என்னைக் கனம்பண்ணுகிறார்கள்.","poem":2},{"lineBreak":true},{"text":"ஆனால் அவர்களுடைய இருதயங்களோ எனக்கு வெகுதூரமாய் இருக்கின்றன.","poem":2},{"text":"அவர்கள் எனக்குச் செய்யும் வழிபாடு","poem":1},{"text":"மனிதர்களால் போதிக்கப்பட்ட சட்டங்களாகவே இருக்கின்றன.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஆகையால், இன்னும் ஒருமுறை அதிசயங்கள்மேல் அதிசயங்களால்","poem":1},{"text":"இம்மக்களை வியப்படையச் செய்வேன்.","poem":2},{"text":"ஞானிகளுடைய ஞானம் அழிந்துபோகும்,","poem":1},{"text":"அறிவாளிகளின் அறிவு ஒழிந்துபோகும்.”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"தங்களுடைய திட்டங்களை யெகோவாவிடமிருந்து மறைப்பதற்காக","poem":1},{"text":"மிக்க முயற்சி செய்கிறவர்களுக்கு ஐயோ கேடு!","poem":2},{"text":"இருண்ட இடங்களில் தமது செயல்களைச் செய்து, “நம்மைக் காண்பவன் யார்?","poem":1},{"text":"நம்மை அறிகிறவன் யார்?” என நினைக்கிறவர்களுக்கும் ஐயோ கேடு!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீங்கள் காரியங்களைத் தலைகீழாக்கி,","poem":1},{"text":"குயவனைக் களிமண்ணாக எண்ணுகிறீர்களே!","poem":2},{"text":"உருவாக்கப்பட்ட பொருள் உருவாக்கியவனைப் பார்த்து,","poem":1},{"text":"“இவர் என்னை உண்டாக்கவில்லை” என்றும்","poem":2},{"text":"பாத்திரமானது குயவனைப் பார்த்து,","poem":1},{"text":"“இவருக்கு ஒன்றுமே தெரியாது” என்றும் கூறலாமோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"இன்னும் சொற்ப காலத்தில் லெபனோன் ஒரு செழிப்பான வயலாக மாறாதோ?","poem":1},{"text":"செழிப்பான வயலும் வனமாகக் காணப்படாதோ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அந்த நாளில் புத்தகச்சுருளிலுள்ள வார்த்தைகளைச் செவிடர் கேட்பார்கள்;","poem":1},{"text":"குருடரின் கண்கள் அந்தகாரத்திலும்,","poem":2},{"lineBreak":true},{"text":"இருட்டிலும் இருந்து அதைக் காணும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"தாழ்த்தப்பட்டவர்கள் இன்னும் ஒருமுறை யெகோவாவுக்குள் மகிழ்ச்சியடைவார்கள்;","poem":1},{"text":"எளியோர் இஸ்ரயேலரின் பரிசுத்தரில் களிகூருவார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"இரக்கமற்றோர் ஒழிந்துபோவார்கள்,","poem":1},{"text":"ஏளனம் செய்வோர் மறைந்துபோவார்கள்;","poem":2},{"lineBreak":true},{"text":"தீமையை நோக்கும் அனைவரும் இல்லாதொழிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"இவர்கள் தங்கள் பேச்சினால் ஒருவனைக் குற்றவாளியாக்கி,","poem":1},{"text":"நீதிமன்றத்தில் தீர்ப்பு வழங்குவோரை இடறப் பண்ணுகிறார்கள்.","poem":2},{"text":"இவ்வாறு பொய்ச் சாட்சியத்தினால் குற்றமற்றவனுக்கு நீதிவழங்க மறுக்கிறார்கள்;","poem":1},{"text":"அதனாலேயே இல்லாதொழிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":22,"content":["ஆகையால், ஆபிரகாமை மீட்ட யெகோவா, யாக்கோபின் குடும்பத்திற்கு சொல்வது இதுவே:",{"text":"“இனிமேலும் யாக்கோபு வெட்கமடைவதில்லை;","poem":1},{"text":"அவர்களுடைய முகங்களும் வெளிறிப் போவதில்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவர்கள் எனது கரங்களின் வேலையாகிய,","poem":1},{"text":"தங்கள் பிள்ளைகளை தங்கள் மத்தியில் காணும்போது,","poem":2},{"text":"எனது பெயரைப் பரிசுத்தமாய் வைத்திருப்பார்கள்.","poem":1},{"text":"அவர்கள் யாக்கோபின் பரிசுத்தரின் பரிசுத்தத்தை உண்மையென்று ஒப்புக்கொண்டு,","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலின் இறைவனிடம் பயபக்தி உள்ளவர்களாய் இருப்பார்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"சிந்தனையில் தவறு செய்கிறவர்கள் விளக்கம் பெறுவார்கள்;","poem":1},{"text":"முறையிடுகிறவர்களும் அறிவுறுத்துதலை ஏற்றுக்கொள்வார்கள்.”","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"அரியேலே என்றால் இறைவனின் பெண் சிங்கம் எனவும், இறைவனின் பீடம் எனவும் பொருள்படும்.","reference":{"chapter":29,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/ISA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/28.json","previousChapterAudioLinks":{},"numberOfVerses":24}