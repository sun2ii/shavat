{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":3,"content":[{"type":"heading","content":["யூதா, எருசலேம் நியாயத்தீர்ப்பு"]},{"type":"verse","number":1,"content":[{"text":"இப்பொழுது பாருங்கள், யெகோவா,","poem":1},{"text":"சேனைகளின் யெகோவா","poem":2},{"text":"எருசலேமிலிருந்தும், யூதாவிலிருந்தும்","poem":1},{"text":"எல்லா ஆதரவையும் உதவியையும் நிறுத்தப் போகிறார்:","poem":2},{"text":"உணவு வழங்குவதையும், தண்ணீர் வழங்குவதையும் நிறுத்தப் போகிறார்.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"மாவீரனையும், போர்வீரனையும்,","poem":2},{"text":"நீதிபதியையும், இறைவாக்கினனையும்,","poem":1},{"text":"குறிசொல்பவனையும், சபைத்தலைவனையும்,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஐம்பது பேருக்குத் தலைவனையும், மதிப்புள்ளவனையும், ஆலோசகனையும்,","poem":1},{"text":"தொழிலில் சாமர்த்தியமுள்ளவனையும்,","poem":2},{"lineBreak":true},{"text":"மாயவித்தையில் கெட்டிக்காரனையும் அகற்றப்போகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“நான் வாலிபர்களை அவர்களுடைய அதிகாரிகளாக்குவேன்;","poem":1},{"text":"விளையாட்டுப் பிள்ளைகள் அவர்களை ஆட்சிசெய்வார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"மக்கள் ஒருவரையொருவர் ஒடுக்குவார்கள்:","poem":1},{"text":"ஒருவருக்கொருவரும், அயலானுக்கு விரோதமாக அயலானும்,","poem":2},{"text":"இளையோர் முதியோருக்கு விரோதமாகவும்,","poem":1},{"text":"கீழோர் மேலோருக்கு விரோதமாகவும் எழும்புவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ஒருவன் தன் தகப்பன் வீட்டிலுள்ள தன் சகோதரன் ஒருவனைப் பிடித்து,","poem":1},{"text":"“உன்னிடம் மேலுடை இருக்கிறது;","poem":2},{"text":"நீயே எங்களுக்குத் தலைவனாயிரு.","poem":1},{"text":"பாழடைந்த இவ்விடத்திற்கு நீயே பொறுப்பாயிருக்க வேண்டும்” என்று சொல்வான்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனால் அவனோ அந்நாளில்,","poem":1},{"text":"“என் வீட்டில் உணவோ, உடையோ கிடையாது;","poem":2},{"text":"இதற்கு எந்தவிதத் தீர்வும் என்னிடம் இல்லை.","poem":1},{"text":"என்னை மக்களுக்குத் தலைவனாக்காதே” என்று மறுத்துவிடுவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"எருசலேம் நகரம் தள்ளாடுகிறது,","poem":1},{"text":"யூதா நாடு வீழ்ச்சியடைகிறது;","poem":2},{"text":"அவர்களின் சொல்லும் செயலும் யெகோவாவுக்கு விரோதமாக இருக்கிறது,","poem":1},{"text":"அவர்கள் அவரின் மகிமையான சமுகத்தை துணிவுடன் எதிர்க்கிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களுடைய முகங்களின் தோற்றம் அவர்களுக்கெதிராக சாட்சி பகர்கிறது;","poem":1},{"text":"சோதோம் நகரத்தைப்போல தங்கள் பாவங்களைப் பறைசாற்றுகிறார்கள்.","poem":2},{"lineBreak":true},{"text":"அவைகளை மறைத்து வைக்கவில்லை.","poem":2},{"text":"ஐயோ! அவர்களுக்குக் கேடு;","poem":1},{"text":"அவர்கள் தங்களுக்குத் தாங்களே பேராபத்தை வருவித்துக் கொண்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நீதியானவர்களுக்கு எல்லாம் நலமாய் நடைபெறும்","poem":1},{"text":"என்று அவர்களுக்குச் சொல்லுங்கள்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் அவர்கள், தமது செயல்களின் பலனை அனுபவிப்பார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"கொடியவர்களுக்கு ஐயோ கேடு!","poem":1},{"text":"அவர்கள்மேல் பேராபத்து வரும்.","poem":2},{"text":"அவர்களின் கைகளின் செயல்களுக்கு ஏற்றவாறு","poem":1},{"text":"அவர்களுக்குச் செய்யப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"வாலிபர் என் மக்களை ஒடுக்குகிறார்கள்,","poem":1},{"text":"பெண்கள் அவர்களை ஆளுகிறார்கள்.","poem":2},{"text":"எனது மக்களே, உங்கள் வழிகாட்டிகள் உங்களைத் தவறான வழியில் நடத்துகிறார்கள்;","poem":1},{"text":"அவர்கள் உங்களை வழிவிலகிப்போகச் செய்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"யெகோவா வழக்காட ஆயத்தமாகி,","poem":1},{"text":"மக்களை நியாயந்தீர்க்க எழுந்து நிற்கிறார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவா தமது மக்களின் முதியோருக்கும், தலைவருக்கும்","poem":1},{"text":"விரோதமாய் நியாயத்தீர்ப்பு செய்கிறார்.","poem":2},{"text":"“என் திராட்சைத் தோட்டத்தைப் பாழாக்கியவர்கள் நீங்களே;","poem":1},{"text":"எளியவர்களிடமிருந்து கொள்ளையிட்ட பொருட்கள் உங்கள் வீடுகளில் இருக்கிறது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீங்கள் என் மக்களை நொறுக்குவதன் அர்த்தமென்ன?","poem":1},{"text":"ஏழைகளின் முகத்தை உருக்குலைப்பதின் பொருள் என்ன?”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா, சேனைகளின் யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"மேலும் யெகோவா சொன்னதாவது:","poem":1},{"text":"“சீயோனின் பெண்களோ கர்வம் கொண்டிருக்கிறார்கள்;","poem":2},{"text":"தங்கள் கழுத்தை வளைக்காது அகங்காரமாய் நடக்கிறார்கள்,","poem":1},{"text":"அவர்கள் தங்கள் கண்களினால் மருட்டுகிறார்கள்.","poem":2},{"text":"அவர்கள் தங்கள் கால்களில் சிலம்பு ஒலிக்க","poem":1},{"text":"ஒய்யாரமாய் நடந்து திரிகிறார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆகையால் யெகோவா சீயோனின் பெண்களின் தலையைப் புண்களால் வாதிப்பார்;","poem":1},{"text":"அவர்களின் தலைகளை யெகோவா வழுக்கையாக்குவார்.”","poem":2}]},{"type":"verse","number":18,"content":["அந்த நாளிலே யெகோவா அவர்களின் பகட்டான அணிகலன்களாகிய வளையல்கள், தலைப்பட்டிகள், பிறை வடிவமான கழுத்துச் சங்கிலிகள்,"]},{"type":"verse","number":19,"content":["காதணிகள், கைச்சங்கிலிகள், முகத்திரைகள்"]},{"type":"verse","number":20,"content":["தலை அணிகலன்கள், கால் சிலம்புகள், ஒட்டியாணங்கள், வாசனைத் தைலக்குப்பிகள், தாயித்துகள்,"]},{"type":"verse","number":21,"content":["மோதிரங்கள், மூக்குத்திகள்;"]},{"type":"verse","number":22,"content":["உயர்தர அங்கிகள், மேலுடைகள், போர்வைகள், கைப்பைகள்,"]},{"type":"verse","number":23,"content":["கண்ணாடிகள், நல்லரக உடைகள், மணிமுடிகள், சால்வைகள் ஆகியவற்றைப் பறித்துப் போடுவார்."]},{"type":"verse","number":24,"content":[{"text":"அப்பொழுது நறுமணத்திற்குப் பதிலாகத் துர்நாற்றம் உண்டாகும்;","poem":1},{"text":"ஒட்டியாணம் இருக்கும் இடத்தில் கயிறு கட்டப்படும்.","poem":2},{"text":"அழகாய் முடிக்கப்பட்ட கூந்தல் இல்லாதுபோய், அது வழுக்கைத் தலையாய் இருக்கும்;","poem":1},{"text":"அலங்கார உடைக்குப் பதிலாக அவர்கள் துக்கவுடையை உடுத்திக்கொள்வார்கள்;","poem":2},{"lineBreak":true},{"text":"அழகுக்குப் பதிலாக அடிமைகளின் நெருப்புச்சூட்டுத் தழும்பு அவர்களுக்கு இருக்கும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உங்கள் மனிதர்கள் வாளுக்கு இரையாவார்கள்;","poem":1},{"text":"உங்களின் இராணுவவீரர் போர்க்களத்தில் சாவார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"சீயோனின் வாசல்கள் ஒப்பாரி வைத்துப் புலம்பும்;","poem":1},{"text":"அவள் ஆதரவற்றவளாகத் தரையில் உட்காருவாள் என்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}