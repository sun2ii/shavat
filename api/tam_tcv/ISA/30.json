{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":30,"content":[{"type":"heading","content":["எகிப்துடன் பயனற்ற ஒப்பந்தம்"]},{"type":"verse","number":1,"content":[{"text":"“பிடிவாதமுள்ள என் பிள்ளைகளுக்கு ஐயோ கேடு!”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“ஏனெனில் அவர்கள் என்னுடையதல்லாத திட்டங்களைச் செயல்படுத்துகிறார்கள்.","poem":1},{"text":"என் ஆவியானவரினாலன்றி உடன்படிக்கை செய்து,","poem":2},{"lineBreak":true},{"text":"பாவத்திற்குமேல் பாவத்தைக் குவிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என்னிடம் அறிவுரை கேளாமல்","poem":1},{"text":"எகிப்திற்குப் போகிறார்கள்.","poem":2},{"text":"அவர்கள் பார்வோனின் பாதுகாப்பின்கீழ் உதவிகோரி,","poem":1},{"text":"எகிப்தின் நிழலில் அடைக்கலம் தேடுகிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஆனால் பார்வோனின் பாதுகாவல் உங்களுக்கு வெட்கமாகும்;","poem":1},{"text":"எகிப்தின் நிழல் உங்களுக்கு அவமானத்தைக் கொண்டுவரும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"சோவானில் அவர்களுக்கு தலைவர்கள் இருந்தாலும்,","poem":1},{"text":"அவர்களுடைய பிரதிநிதிகள் ஆனேஸ்மட்டும் வந்து சேர்ந்தாலும்,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர்களுக்குப் பயனற்ற நாடான எகிப்தின் நிமித்தம்","poem":1},{"text":"ஒவ்வொருவரும் வெட்கத்திற்குட்படுவார்கள்.","poem":2},{"text":"அவர்களால் யாதொரு உதவியோ, நன்மையோ கிடைப்பதில்லை;","poem":1},{"text":"வெட்கமும் அவமானமுமே கிடைக்கும்.”","poem":2}]},{"type":"verse","number":6,"content":[{"noteId":16},"நெகேவ் பாலைவனத்தின் மிருகங்களைப் பற்றிய இறைவாக்கு:",{"text":"பெண் சிங்கங்களும், ஆண்சிங்கங்களும்,","poem":1},{"text":"விரியன் பாம்பும், பறக்கும் பாம்பும் இருக்கின்ற,","poem":2},{"lineBreak":true},{"text":"துன்பமும் வேதனையுமுள்ள நாட்டின் வழியாகத் தூதுவர் போகிறார்கள்.","poem":2},{"text":"அவர்கள் தமது செல்வங்களைக் கழுதைகள்மேலும்,","poem":1},{"text":"திரவியங்களை ஒட்டகங்கள்மேலும் ஏற்றிக்கொண்டு,","poem":2},{"text":"பயனற்ற நாட்டவரிடம் போகிறார்கள்.","poem":1}]},{"type":"verse","number":7,"content":[{"text":"எகிப்தியர் செய்யும் உதவி பயனற்றது.","poem":2},{"text":"ஆதலால் நான் எகிப்தை,","poem":1},{"text":"ஆற்றலிழந்த ராகாப் என்று அழைக்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"இப்பொழுது நீ போய், அவர்களுக்காக அதை ஒரு பலகையில் எழுதி,","poem":1},{"text":"ஒரு சுருளில் குறித்துவை;","poem":2},{"text":"எதிர்காலத்தில்","poem":1},{"text":"அது ஒரு நித்திய சாட்சியாய் இருக்கும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இவர்கள் கலகம் செய்யும் மக்கள், வஞ்சகம் நிறைந்த பிள்ளைகள்;","poem":1},{"text":"யெகோவாவின் வேதத்தைக் கேட்க விருப்பமற்ற பிள்ளைகள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இவர்கள் தரிசனம் காண்போரிடம்,","poem":1},{"text":"“இனி தரிசனம் காணாதீர்கள்!” என்கிறார்கள்.","poem":2},{"text":"இறைவாக்கு உரைப்போரிடம்,","poem":1},{"text":"“எங்களுக்கு இனிமேல் யதார்த்தமாய் தரிசனங்களைச் சொல்லவேண்டாம்!","poem":2},{"text":"இன்பமானவற்றை எங்களுக்குக் கூறி,","poem":1},{"text":"போலியானவற்றை இறைவாக்காய் உரையுங்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எங்கள் வழியை விட்டுவிடுங்கள்;","poem":1},{"text":"எங்கள் பாதையைவிட்டு விலகுங்கள்;","poem":2},{"text":"இஸ்ரயேலின் பரிசுத்தரைப் பற்றி எங்கள் முன்பாக பேசுவதை நிறுத்துங்கள்!”","poem":1},{"text":"என்றும் சொல்கிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":["ஆகையால் இஸ்ரயேலின் பரிசுத்தர் சொல்வது இதுவே:",{"text":"“நீங்கள் இந்தச் செய்தியை நிராகரித்தீர்கள்;","poem":1},{"text":"ஒடுக்குகிறதில் நம்பிக்கை வைத்து,","poem":2},{"lineBreak":true},{"text":"வஞ்சகத்தை சார்ந்திருக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆனால் உயர்ந்த மதிலில் இருக்கும் வெடிப்பு கொஞ்சம் கொஞ்சமாக பெரிதாகி,","poem":1},{"text":"திடீரென ஒரு நொடியில் சரிந்து விழுவதுபோல,","poem":2},{"lineBreak":true},{"text":"இந்தப் பாவம் உங்களையும் வீழ்த்தும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நீங்கள் மண்பாத்திரம்போல் துண்டுகளாக உடைந்து போவீர்கள்.","poem":1},{"text":"அடுப்பிலிருந்து நெருப்புத்தணல் எடுக்கவோ,","poem":2},{"text":"அல்லது தொட்டியிலிருந்து தண்ணீர் எடுக்கவோ,","poem":1},{"text":"அந்தப் பாத்திரத்தின் ஒரு துண்டுகூட மீதியாய் இல்லாதிருப்பதுபோல,","poem":2},{"lineBreak":true},{"text":"நீங்களும் இரக்கமில்லாத முறையில் நொறுக்கப்பட்டுப் போவீர்கள்.”","poem":2}]},{"type":"verse","number":15,"content":["இஸ்ரயேலின் பரிசுத்தரும் ஆண்டவருமாகிய யெகோவா சொல்வது இதுவே:",{"text":"“மனந்திரும்பி, என்னில் அமர்ந்திருந்தால் உங்களுக்கு இரட்சிப்பு உண்டாகும்;","poem":1},{"text":"அமைதியிலும் நம்பிக்கையிலுமே உங்களுக்கு பெலன் உண்டாகும்,","poem":2},{"lineBreak":true},{"text":"ஆனால் நீங்கள் அதில் ஒன்றையுமே ஏற்க விரும்பவில்லை.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீங்களோ, ‘இல்லை, நாங்கள் குதிரைகளில் தப்பி ஓடுவோம்’ என்றீர்கள்.","poem":1},{"text":"ஆகையால் நீங்கள் தப்பி ஒடவே நேரிடும்.","poem":2},{"text":"‘வேகமான குதிரைகளில் ஏறிச்செல்வோம்’ என்றீர்கள்;","poem":1},{"text":"ஆகையால், உங்களைத் துரத்திப் பிடிப்பவர்களும் வேகமாகவே வருவார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஒருவனது பயமுறுத்தலுக்கு","poem":1},{"text":"ஆயிரம்பேர் பயந்து ஓடுவார்கள்;","poem":2},{"text":"ஐந்துபேர் பயமுறுத்த","poem":1},{"text":"நீங்கள் எல்லோரும் பயந்து ஓடுவீர்கள்.","poem":2},{"text":"மலை உச்சியில் தனித்து விடப்பட்டிருக்கும் கொடிக்கம்பம் போலவும்,","poem":1},{"text":"குன்றில் தனித்து விடப்பட்டிருக்கும் கொடிபோலவும்","poem":2},{"lineBreak":true},{"text":"சிலர் மட்டுமே மிஞ்சியிருப்பீர்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"அப்படியிருந்தும், யெகோவா உங்கள்மேல் கிருபை காட்ட ஆவலாய் இருக்கிறார்;","poem":1},{"text":"உங்களுக்கு இரக்கங்காட்டுவதற்கு எழும்புகிறார்.","poem":2},{"text":"ஏனெனில், யெகோவா நீதியுள்ள இறைவன்.","poem":1},{"text":"அவருக்காக காத்திருப்பவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்!","poem":2}]},{"type":"verse","number":19,"content":["எருசலேமில் வாழும் சீயோன் மக்களே, இனிமேல் நீங்கள் அழமாட்டீர்கள்; நீங்கள் உதவிக்காகக் கூப்பிடும்போது, அவர் எவ்வளவு கிருபையுள்ளவராயிருப்பார்! அவர் அதைக் கேட்டவுடனேயே உங்களுக்குப் பதிலளிப்பார்."]},{"type":"verse","number":20,"content":["யெகோவா உங்களுக்கு துன்பத்தின் அப்பத்தையும், இடுக்கணின் தண்ணீரையும் கொடுத்தாலும், உங்கள் போதகர்கள் இனி ஒருபோதும் மறைவாயிருக்கமாட்டார்கள். உங்கள் சொந்தக் கண்ணாலேயே நீங்கள் அவர்களைக் காண்பீர்கள்."]},{"type":"verse","number":21,"content":["நீங்கள் வழிதவறி இடதுபுறமோ, வலதுபுறமோ திரும்பினாலும், “இதுதான் வழி, இதிலே நடவுங்கள்” என்று உங்கள் பின்னால் சொல்லும் ஒரு குரலை உங்கள் காதுகள் கேட்கும்."]},{"type":"verse","number":22,"content":["அப்போது நீங்கள் வெள்ளித் தகட்டால் மூடிய சிலைகளையும், தங்கத்தகட்டால் மூடிய உருவச்சிலைகளையும் புறக்கணித்து விடுவீர்கள். அவைகளை தீட்டுத் துணிபோல எறிந்துவிட்டு, “தொலைந்து போங்கள்!” என்பீர்கள்."]},{"type":"verse","number":23,"content":["யெகோவா, நீங்கள் நிலத்தில் விதைக்கும் விதைகளுக்காக உங்களுக்கு மழையையும் பெய்யப்பண்ணுவார். விளைச்சலில் வரும் உணவு, சிறந்ததாயும் அதிகமாயும் இருக்கும்; அந்த நாளிலே உங்கள் மந்தைகள் பரந்த புற்தரையில் மேயும்."]},{"type":"verse","number":24,"content":["நிலத்தை உழுகிற எருதும் கழுதையும் முறத்தினாலும், தூற்றுக்கூடையினாலும் தூற்றப்பட்ட சுவையுள்ள தீனியைத் தின்னும்."]},{"type":"verse","number":25,"content":["பெருங்கொலை நடக்கும் அந்த நாளிலே கோபுரங்கள் இடிந்துவிழும்; ஒவ்வொரு உயர்ந்த மலையிலும், ஒவ்வொரு உயரமான குன்றிலும் இருந்து நீரோடைகள் ஓடும்."]},{"type":"verse","number":26,"content":["யெகோவா தமது மக்களுக்கு தாம் ஏற்படுத்திய காயங்களைக் கட்டும்போதும், அவர்களைக் குணமாக்கும்போதும், சந்திரன் சூரியனைப்போல் பிரகாசிக்கும். சூரிய வெளிச்சம் ஏழு மடங்காகப் பிரகாசிக்கும். அது ஏழு முழு நாட்களின் வெளிச்சம் ஒன்றுதிரண்டாற்போல் இருக்கும்."]},{"type":"verse","number":27,"content":[{"text":"இதோ, யெகோவாவின் பெயர் வெகுதூரத்திலிருந்து வருகிறது;","poem":1},{"text":"அது எரியும் கோபத்துடனும், அடர்ந்த புகை மேகங்களுடனும் வருகிறது;","poem":2},{"text":"அவருடைய உதடுகள் கடுங்கோபத்தால் நிறைந்திருக்கின்றன,","poem":1},{"text":"அவருடைய நாவு எரிக்கும் நெருப்பு.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"கழுத்துவரை உயர்ந்து,","poem":1},{"text":"புரண்டோடும் வெள்ளம்போல அவருடைய மூச்சு இருக்கிறது.","poem":2},{"text":"அவர் நாடுகளை அழிவென்னும் சல்லடையில் சலித்தெடுக்கிறார்;","poem":1},{"text":"மக்கள் கூட்டங்களின் தாடைகளில் கடிவாளத்தை வைக்கிறார்.","poem":2},{"lineBreak":true},{"text":"அது அவர்களை வழிதவறப்பண்ணும்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"இரவில் ஒரு பரிசுத்த விழாவைக் கொண்டாடுவதுபோல,","poem":1},{"text":"நீங்கள் பாடுவீர்கள்.","poem":2},{"text":"இஸ்ரயேலின் கற்பாறையாகிய","poem":1},{"text":"யெகோவாவின் மலைக்கு","poem":2},{"text":"மக்கள் புல்லாங்குழலுடன் போவதுபோல,","poem":1},{"text":"உங்கள் உள்ளமும் மகிழும்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"யெகோவா தமது மாட்சிமையான குரலை மனிதர் கேட்கும்படி செய்வார்;","poem":1},{"text":"அத்துடன் அவர் தம்முடைய கரம் கீழ்நோக்கி வருவதை அவர்கள் காணும்படி செய்வார்.","poem":2},{"text":"அது கடுங்கோபத்துடனும், சுட்டெரிக்கும் நெருப்புடனும், திடீர் மழையுடனும்,","poem":1},{"text":"இடி முழக்கத்துடனும், கல்மழையுடனும் வரும்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"யெகோவாவின் குரல் அசீரியாவைச் சிதறப்பண்ணும்;","poem":1},{"text":"அவர் தமது செங்கோலால் அவர்களை அடித்து வீழ்த்துவார்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"யெகோவா யுத்த களத்திலே,","poem":1},{"text":"தம் கரத்தால் அவர்களை அடித்து யுத்தம் செய்யும்போது,","poem":2},{"text":"அவர்கள்மேல் தனது தண்டனைக் கோலால் அடிக்கும் ஒவ்வொரு அடியும்,","poem":1},{"text":"தம்புராவினதும் யாழினதும் இசைக்கேற்ப இருக்கும்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"தோபேத் வெகுகாலமாகவே ஆயத்தம் செய்யப்பட்டிருக்கிறது;","poem":1},{"text":"அது அரசனுக்காகத் தயாராயிருக்கிறது.","poem":2},{"text":"அதன் நெருப்புக்குழி ஆழமாகவும்,","poem":1},{"text":"அகலமாகவும் செய்யப்பட்டு,","poem":2},{"text":"அதிலே ஏராளமான விறகும் நெருப்பும் இருக்கின்றன.","poem":1},{"text":"யெகோவாவின் மூச்சு கந்தகச் சுவாலைப்போல் வந்து","poem":2},{"lineBreak":true},{"text":"அதைப் பற்றியெரியச் செய்யும்.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"நெகேவ் என்பது இஸ்ரயேலின் தெற்கு பகுதி","reference":{"chapter":30,"verse":6}}]},"thisChapterLink":"/api/tam_tcv/ISA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}