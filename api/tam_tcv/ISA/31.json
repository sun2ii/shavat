{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":31,"content":[{"type":"heading","content":["எகிப்தை நம்பியிருப்போருக்கு ஐயோ!"]},{"type":"verse","number":1,"content":[{"text":"உதவி நாடி எகிப்திற்குப் போகிறவர்களுக்கு ஐயோ கேடு!","poem":1},{"text":"அவர்கள் குதிரைகளை நம்பி,","poem":2},{"text":"தங்கள் திரளான தேர்களிலும்,","poem":1},{"text":"தங்கள் குதிரைவீரரின் பெரும் பலத்திலும் நம்பிக்கை வைக்கிறார்கள்.","poem":2},{"text":"ஆனால், இஸ்ரயேலின் பரிசுத்தரை நோக்காமலும்,","poem":1},{"text":"யெகோவாவின் உதவியைத் தேடாமலும் இருக்கின்றார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவோ ஞானமுள்ளவர், அவரால்தான் அழிவைக் கொண்டுவர முடியும்;","poem":1},{"text":"அவர் சொன்ன வார்த்தையை மாற்றுவதில்லை,","poem":2},{"text":"அவர் கொடுமையானவரின் குடும்பத்திற்கு விரோதமாகவும்,","poem":1},{"text":"தீயவர்களுக்கு உதவுவோருக்கு எதிராகவும் எழும்புவார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஆனால் எகிப்தியர் மனிதர்களேயன்றி இறைவன் அல்ல;","poem":1},{"text":"அவர்களின் குதிரைகள் மாமிசமேயன்றி ஆவியல்ல.","poem":2},{"text":"யெகோவா தமது கரத்தை நீட்டும்போது,","poem":1},{"text":"உதவிசெய்கிறவன் இடறுவான்.","poem":2},{"lineBreak":true},{"text":"உதவி பெறுவோனும் விழுவான்;","poem":2},{"lineBreak":true},{"text":"இருவரும் ஒன்றாய் அழிவார்கள்.","poem":2}]},{"type":"verse","number":4,"content":["யெகோவா எனக்கு சொல்வது இதுவே:",{"text":"“சிங்கமோ, இளஞ்சிங்கமோ,","poem":1},{"text":"தன் இரையைப் பிடித்துக்கொண்டு கர்ஜிக்கும்போது,","poem":2},{"text":"அதை எதிர்ப்பதற்கு முழு மேய்ப்பர் கூட்டத்தை அழைத்தாலும்,","poem":1},{"text":"அது அவர்களின் கூக்குரலுக்கு அஞ்சவோ,","poem":2},{"text":"இரைச்சலைப் பொருட்படுத்தவோ மாட்டாது.","poem":1},{"text":"அதுபோலவே, சேனைகளின் யெகோவா,","poem":2},{"text":"சீயோன் மலையிலும் அதன் உயரிடங்களிலும்","poem":1},{"text":"யுத்தம் செய்வதற்கு இறங்குவார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பறவைகள் தமது கூடுகளின் மேலே வட்டமிட்டுப் பறப்பதுபோல,","poem":1},{"text":"சேனைகளின் யெகோவா எருசலேமைப் பாதுகாப்பார்.","poem":2},{"text":"அவர் அதைப் பாதுகாத்து மீட்பார்,","poem":1},{"text":"அவர் அதற்கு மேலாகக் கடந்து அதை விடுவிப்பார்.”","poem":2}]},{"type":"verse","number":6,"content":["இஸ்ரயேலரே, அவரை எதிர்த்து அதிகமாய் கலகம் செய்த நீங்கள் அவரிடம் திரும்புங்கள்."]},{"type":"verse","number":7,"content":["ஏனென்றால், அந்த நாளிலே நீங்கள் ஒவ்வொருவரும் உங்கள் பாவக் கைகளினால் செய்த வெள்ளி விக்கிரகங்களையும், தங்க விக்கிரகங்களையும் ஒதுக்கி எறிந்து விடுவீர்கள்."]},{"type":"verse","number":8,"content":[{"text":"“அசீரியா வீழ்ச்சியடைவது மனிதனின் வாளினால் அல்ல.","poem":1},{"text":"மனிதனால் ஆக்கப்படாத ஒரு வாள் அவர்களை விழுங்கும்;","poem":2},{"text":"வாளுக்கு முன்னால் அவர்கள் பயந்து ஓடுவார்கள்;","poem":1},{"text":"அவர்களின் வாலிபர் கட்டாய வேலைக்கு அமர்த்தப்படுவார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களின் அரண் பயங்கரத்தால் வீழ்ச்சியடையும்;","poem":1},{"text":"அவர்களின் தளபதிகள் போர்க் கொடிகளைக் கண்டதும் திகிலடைவார்கள்”","poem":2},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":1},{"text":"சீயோனில் அவருடைய நெருப்பும்,","poem":2},{"lineBreak":true},{"text":"எருசலேமில் அவருடைய சூளையும் இருக்கிறது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/30.json","previousChapterAudioLinks":{},"numberOfVerses":9}