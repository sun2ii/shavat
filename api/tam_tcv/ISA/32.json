{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":32,"content":[{"type":"heading","content":["நீதியின் பேரரசு"]},{"type":"verse","number":1,"content":[{"text":"இதோ, நீதியுள்ள ஒரு அரசர் வரப்போகிறார்.","poem":1},{"text":"அவரின்கீழ் ஆளுநர்கள் நீதியோடு ஆளுகை செய்வார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஒவ்வொரு மனிதனும் காற்றுக்கு ஒதுங்கும் ஒதுக்கிடம் போலவும்,","poem":1},{"text":"புயலுக்கு ஒதுங்கும் புகலிடம்போலவும்,","poem":2},{"text":"பாலைவனத்தில் நீரோடைகள் போலவும், தாகமுள்ள நிலத்துக்கு,","poem":1},{"text":"பெருங்கன்மலையின் நிழல் போலவும் இருப்பான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"அப்பொழுது, பார்க்கிறவர்களின் கண்கள்","poem":1},{"text":"இனியொருபோதும் மூடப்பட்டிருக்க மாட்டாது;","poem":2},{"lineBreak":true},{"text":"கேட்கிறவர்களின் காதுகள் கவனித்துக் கேட்கும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவசரக்காரரின் மனம், அறிவை விளங்கிக்கொள்ளும்;","poem":1},{"text":"திக்குகின்ற நாவு தங்கு தடையின்றித் தெளிவாய்ப் பேசும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"மூடர் இனி உயர்குடி மக்கள் என அழைக்கப்படமாட்டார்கள்;","poem":1},{"text":"கயவரும் இனி கனப்படுத்தப்படமாட்டார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஏனெனில் மூடர் மூடத்தனமாகவே பேசுகிறார்கள்,","poem":1},{"text":"அவர்களின் மனம் தீமையில் தீவிரமாய் ஈடுபடுகிறது:","poem":2},{"text":"அவர்கள் இறை பக்தியற்றவர்களாய் நடந்து,","poem":1},{"text":"யெகோவாவைப் பற்றித் தவறானவற்றைப் பரப்புகிறார்கள்.","poem":2},{"text":"பசியுள்ளோரைப் பட்டினியாக விட்டு,","poem":1},{"text":"தாகமுள்ளோருக்குத் தண்ணீர் கொடுக்க மறுக்கிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"துரோகியின் செயல்முறைகள் கொடுமையானவை,","poem":1},{"text":"ஏழைகளின் முறையீடுகள் நியாயமாயிருந்தும்","poem":2},{"text":"வஞ்சக வார்த்தைகளால் எளியவர்களை அழிப்பதற்கு","poem":1},{"text":"தீய திட்டங்களைத் தீட்டுகிறான்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆனால் உயர்குடி மக்கள் சிறப்பான திட்டங்களை வகுக்கிறார்கள்;","poem":1},{"text":"அவர்களுடைய சிறந்த செயல்களினால் நிலைத்தும் இருக்கிறார்கள்.","poem":2}]},{"type":"heading","content":["எருசலேமின் பெண்கள்"]},{"type":"verse","number":9,"content":[{"text":"சுகபோக வாழ்வை விரும்பும் பெண்களே,","poem":1},{"text":"நீங்கள் எழுந்து எனக்குச் செவிகொடுங்கள்.","poem":2},{"text":"கவலையற்ற மகள்களே,","poem":1},{"text":"நான் சொல்வதைக் கேளுங்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"கவலையற்ற மகள்களே,","poem":1},{"text":"ஒரு வருடமும் சில நாட்களும் ஆனபின்பு நீங்கள் நடுங்குவீர்கள்.","poem":2},{"text":"திராட்சை அறுவடை பலனற்றுப் போகும்;","poem":1},{"text":"கனிகொடுக்கும் அறுப்புக் காலமும் வருவதில்லை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பகட்டாக வாழும் பெண்களே, பயந்து நடுங்குங்கள்;","poem":1},{"text":"கவலையற்ற மகள்களே, கலங்குங்கள்;","poem":2},{"text":"உங்கள் உடைகளைக் களைந்து,","poem":1},{"text":"உங்கள் இடைகளில் துக்கவுடைகளை உடுத்திக்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உங்கள் செழிப்பான வயல்களுக்காகவும்,","poem":1},{"text":"கனி நிறைந்த திராட்சைக் கொடிகளுக்காகவும் உங்கள் மார்பில் அடித்துக் கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"முட்செடிகளும் முட்புதர்களும் வளர்ந்து நிறைந்த","poem":1},{"text":"எனது மக்களின் நாட்டிற்காகவும்,","poem":2},{"text":"மகிழ்ந்து களிகூர்ந்த வீடுகளுக்காகவும்,","poem":1},{"text":"கொண்டாட்டமுடைய நகரத்திற்காகவும் புலம்புங்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"கோட்டை கைவிடப்படும்,","poem":1},{"text":"இரைச்சல்மிக்க நகரம் வெறுமையாய் விடப்படும்.","poem":2},{"text":"அரண்செய்யப்பட்ட நகரமும் காவற்கோபுரமும் என்றென்றும் குகைகளாகும்;","poem":1},{"text":"அங்கே காட்டுக் கழுதைகள் மகிழ்ச்சியடையும், மந்தைகள் மேயும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"உன்னதத்திலிருந்து நம்மேல் இறைவனுடைய ஆவியானவர் ஊற்றப்படும்வரையும்,","poem":1},{"text":"பாலைவனம் செழிப்பான வயலாகும்வரையும்,","poem":2},{"lineBreak":true},{"text":"செழிப்பான வயல்கள் வனம்போல் காணப்படும்வரையும் இப்படியே இருக்கும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அப்பொழுது நீதி பாலைவனத்தில் குடியிருக்கும்;","poem":1},{"text":"நியாயம் செழிப்பான வளமான வயல்களில் வாழும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நீதியினால் வரும் பலன் சமாதானமாயிருக்கும்;","poem":1},{"text":"நீதியின் விளைவு என்றென்றைக்கும் அமைதியும் மன நம்பிக்கையுமாயிருக்கும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"என் மக்கள் சமாதானம் நிறைந்த குடியிருப்புகளிலும்,","poem":1},{"text":"பாதுகாப்பான வீடுகளிலும்,","poem":2},{"lineBreak":true},{"text":"தொல்லையில்லாத இளைப்பாறுதலின் இடங்களில் வாழ்வார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"கல்மழை வனத்தைக் கீழே வீழ்த்தினாலும்,","poem":1},{"text":"பட்டணம் முழுவதும் தரைமட்டமாக்கப்பட்டாலும்,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நீர்வளமுள்ள இடங்களில் விதை விதைத்து,","poem":1},{"text":"சுதந்திரமாய் உங்கள் மந்தைகளையும் கழுதைகளையும் மேய்வதற்கு விடுகிற","poem":2},{"lineBreak":true},{"text":"நீங்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/31.json","previousChapterAudioLinks":{},"numberOfVerses":20}