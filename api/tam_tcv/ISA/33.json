{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":33,"content":[{"type":"heading","content":["அசீரியாவைப் பற்றிய செய்தி"]},{"type":"verse","number":1,"content":[{"text":"அழிக்கப்படாதிருக்கும் அழிவுகாரனே,","poem":1},{"text":"ஐயோ உனக்குக் கேடு!","poem":2},{"text":"காட்டிக்கொடுக்கப்படாதிருந்த துரோகியே,","poem":1},{"text":"ஐயோ உனக்குக் கேடு!","poem":2},{"text":"நீ அழிப்பதை நிறுத்தும்போது,","poem":1},{"text":"நீ அழிக்கப்படுவாய்;","poem":2},{"text":"நீ காட்டிக்கொடுப்பதை நிறுத்தும்போது,","poem":1},{"text":"நீ காட்டிக்கொடுக்கப்படுவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே, எங்கள்மேல் கிருபையாயிரும்;","poem":1},{"text":"நாங்கள் உமக்குக் காத்திருக்கிறோம்.","poem":2},{"text":"காலைதோறும் எங்கள் பெலனாயும்,","poem":1},{"text":"துயரப்படும் வேளையில் எங்கள் மீட்பருமாயிரும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உமது குரலின் முழக்கத்தின்போது மக்கள் பயந்து ஓடுகிறார்கள்;","poem":1},{"text":"நீர் எழும்பும்போது நாடுகள் சிதறுண்டு போகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நாடுகளே, இளம் வெட்டுக்கிளிகள் வெட்டுவதுபோல,","poem":1},{"text":"உங்கள் கொள்ளைப்பொருள் அழிக்கப்படுகிறது;","poem":2},{"lineBreak":true},{"text":"வெட்டுக்கிளிக் கூட்டம்போல மனிதர் அவைகளின்மேல் பாய்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவா புகழ்ந்து உயர்த்தப்பட்டிருக்கிறார்,","poem":1},{"text":"ஏனென்றால் அவர் உன்னதத்தில் வாழ்கிறார்.","poem":2},{"lineBreak":true},{"text":"அவர் சீயோனை நீதியாலும் நியாயத்தாலும் நிரப்புவார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவரே உங்கள் வாழ்நாட்களுக்கு உறுதியான அஸ்திபாரமாயிருப்பார்;","poem":1},{"text":"அவர் இரட்சிப்பும், ஞானமும், அறிவும் நிறைந்த ஒரு செல்வக் களஞ்சியமுமாயிருப்பார்.","poem":2},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயந்து நடத்தலே இந்தத் திரவியத்தை அடைவதற்கான திறவுகோல்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"இதோ, அவர்களுடைய தைரியமுள்ள மனிதர் தெருக்களில் சத்தமிட்டு அழுகிறார்கள்;","poem":1},{"text":"சமாதானத் தூதுவர்கள் மனங்கசந்து அழுகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பிரதான வீதிகள் வெறிச்சோடிக் கிடக்கின்றன;","poem":1},{"text":"தெருக்களிலே பிரயாணிகளைக் காணவில்லை.","poem":2},{"text":"உடன்படிக்கை மீறப்பட்டிருக்கிறது,","poem":1},{"text":"அதன் சாட்சிகள்","poem":2},{"noteId":17},{"text":"அவமதிக்கப்பட்டார்கள்,","poem":2},{"lineBreak":true},{"text":"மதிக்கப்படுவார் ஒருவரும் இல்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நாடு துக்கப்பட்டு சோர்ந்துபோகிறது,","poem":1},{"text":"லெபனோன் வெட்கப்பட்டு வாடுகிறது.","poem":2},{"text":"சாரோன் சமவெளி வனாந்திரத்தைப் போலிருக்கிறது,","poem":1},{"text":"பாசானும், கர்மேலும் தங்கள் இலைகளை உதிர்க்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“இப்பொழுது நான் எழும்புவேன்,","poem":1},{"text":"இப்பொழுது நான் உயர்த்தப்படுவேன்.","poem":2},{"lineBreak":true},{"text":"இப்பொழுது நான் மேன்மைப்படுத்தப்படுவேன்” என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“நீங்கள் பதரைக் கருப்பந்தரித்து,","poem":1},{"text":"வைக்கோலைப் பெற்றெடுப்பீர்கள்;","poem":2},{"lineBreak":true},{"text":"உங்களது சுவாசம் உங்களைச் சுட்டெரிக்கும் நெருப்பாய் இருக்கும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மக்கள் கூட்டங்கள் சுண்ணாம்பைப்போல் எரித்து நீறாக்கப்படுவார்கள்;","poem":1},{"text":"அவர்கள் வெட்டப்பட்ட முட்செடிகள்போல் நெருப்புச் சுவாலையில் எரிக்கப்படுவார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"தொலைவில் இருப்போரே, நான் செய்தவற்றைக் கேளுங்கள்;","poem":1},{"text":"அருகில் உள்ளோரே, எனது வல்லமையை ஏற்றுக்கொள்ளுங்கள்!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"சீயோனின் பாவிகள் திகில் அடைகிறார்கள்;","poem":1},{"text":"இறைவனை மறுதலிக்கிறவர்களை நடுக்கம் பற்றிக்கொள்கிறது:","poem":2},{"text":"“சுட்டெரிக்கும் நெருப்புடன் நம்மில் எவர் வாழமுடியும்?","poem":1},{"text":"நித்தியமாய் எரியும் நெருப்புடன் நம்மில் எவர் குடியிருக்க முடியும்?”","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீதியுடன் நடப்பவரும்,","poem":1},{"text":"சரியானதைப் பேசுபவரும்,","poem":2},{"text":"தட்டிப் பறித்த இலாபத்தை வெறுப்பவரும்,","poem":1},{"text":"இலஞ்சம் வாங்க தன் கைகளை நீட்டாதவரும்,","poem":2},{"text":"கொலைசெய்வதற்கான சதித்திட்டங்களைக் கேட்காமல் தன் காதை அடைத்துக்கொள்பவரும்,","poem":1},{"text":"தீயவற்றைப் பாராமல் தன் கண்களை மூடுகிறவரும்,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர்கள் உயர்ந்த இடங்களில் வசிப்பார்கள்;","poem":1},{"text":"கன்மலைகளின் கோட்டையே அவர்களுடைய புகலிடமாய் இருக்கும்.","poem":2},{"text":"அவர்களுக்கு உணவு கொடுக்கப்படும்,","poem":1},{"text":"அவர்களுக்குத் தண்ணீரும் குறைவில்லாமல் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"உன் கண்கள் அரசனை அவர் அழகில் காணும்;","poem":1},{"text":"வெகுதூரத்தில் விசாலமாகப் பரந்திருக்கும் நாட்டையும் காணும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நீங்கள் உங்கள் சிந்தைனையில் பழைய பயங்கரத்தை நினைவுகூர்ந்து:","poem":1},{"text":"“அந்த பிரதான அதிகாரி எங்கே?","poem":2},{"text":"வருமானத்தை எடுத்தவன் எங்கே?","poem":1},{"text":"கோபுரங்களுக்குப் பொறுப்பான அதிகாரி எங்கே?” என்று கேட்பீர்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"விளங்காத பேச்சும்,","poem":1},{"text":"புரிந்துகொள்ள முடியாத அந்நிய மொழியும் உள்ள","poem":2},{"lineBreak":true},{"text":"அந்த கொடூரமான மக்களை நீங்கள் இனி காணமாட்டீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"நமது பண்டிகைகளின் பட்டணமான சீயோனைப் பாருங்கள்;","poem":1},{"text":"உங்கள் கண்கள் அமைதி நிறைந்த இருப்பிடமும்,","poem":2},{"lineBreak":true},{"text":"அசைக்கப்படாத கூடாரமுமாகிய எருசலேமைக் காணும்.","poem":2},{"text":"அதன் முளைகள் ஒருபோதும் பிடுங்கப்படமாட்டாது,","poem":1},{"text":"அதன் கயிறுகள் ஒன்றாவது அறுக்கப்படவுமாட்டாது.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"யெகோவாவே அங்கு நமது வல்லவராயிருப்பார்.","poem":1},{"text":"அது அகன்ற ஆறுகளும், நீரோடைகளும் உள்ள இடத்தைப் போலிருக்கும்.","poem":2},{"text":"துடுப்புகளால் வலித்து ஒட்டப்படும் மரக்கலங்களோ,","poem":1},{"text":"பெரிய கப்பல்களோ அதில் செல்வதில்லை.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"யெகோவாவே நமது நீதிபதி,","poem":1},{"text":"யெகோவாவே நமக்கு சட்டம் வழங்குபவர்.","poem":2},{"text":"யெகோவாவே நமது அரசர்;","poem":1},{"text":"நம்மைக் காப்பாற்றுபவரும் அவரே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"உங்கள் பாய்மரக் கட்டுகள் தளர்ந்து தொங்குகின்றன,","poem":1},{"text":"பாய்மரங்கள் இறுக்கமாகக் கட்டப்படவில்லை,","poem":2},{"lineBreak":true},{"text":"பாய்களும் விரிக்கப்படவில்லை.","poem":2},{"text":"அப்பொழுது ஏராளமான கொள்ளைப்பொருட்கள் பங்கிடப்படும்;","poem":1},{"text":"முடவர்கள்கூட கொள்ளைப்பொருட்களைத் தூக்கிக்கொண்டு போவார்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"சீயோனில் வாழும் ஒருவராவது, “நான் நோயாளி” என்று சொல்லமாட்டார்கள்;","poem":1},{"text":"அங்கு வாழ்பவர்களின் பாவங்கள் மன்னிக்கப்படும்.","poem":2}]}],"footnotes":[{"noteId":17,"caller":"+","text":"சாட்சிகள் அல்லது பட்டணங்கள் எனப்படும்","reference":{"chapter":33,"verse":8}}]},"thisChapterLink":"/api/tam_tcv/ISA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/32.json","previousChapterAudioLinks":{},"numberOfVerses":24}