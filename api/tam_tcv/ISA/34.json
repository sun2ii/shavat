{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":34,"content":[{"type":"heading","content":["நாடுகளுக்கு விரோதமான நியாயத்தீர்ப்பு"]},{"type":"verse","number":1,"content":[{"text":"நாடுகளே, நீங்கள் அருகில் வந்து கேளுங்கள்;","poem":1},{"text":"மக்கள் கூட்டங்களே, நீங்கள் கவனியுங்கள்.","poem":2},{"text":"பூமியும் அதிலுள்ள யாவும் கேட்கட்டும்,","poem":1},{"text":"உலகமும் அதிலிருந்து வரும் அனைத்தும் கேட்கட்டும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவா எல்லா நாடுகளோடும் கோபமாயிருக்கிறார்;","poem":1},{"text":"அவருடைய கோபம் அவர்களுடைய எல்லா இராணுவத்தின்மேலும் இருக்கிறது.","poem":2},{"text":"அவர் அவர்களை முற்றிலும் அழிப்பார்;","poem":1},{"text":"அவர் அவர்களைக் கொலைக்கு ஒப்புக்கொடுப்பார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்களில் கொலைசெய்யப்பட்டவர்கள் வெளியே எறியப்படுவார்கள்,","poem":1},{"text":"இறந்தவர்களின் உடல்கள் துர்நாற்றம் வீசும்;","poem":2},{"lineBreak":true},{"text":"மலைகள் அவர்களுடைய இரத்தத்தினால் ஊறியிருக்கும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"வானத்து நட்சத்திரங்கள் அனைத்தும் இல்லாமற்போகும்;","poem":1},{"text":"ஆகாயம் ஒரு சுருளைப்போல் சுருட்டப்படும்.","poem":2},{"text":"வானசேனை அனைத்தும்","poem":1},{"text":"திராட்சைக் கொடியிலிருந்து வாடிய இலைகள் உதிர்வதுபோலவும்,","poem":2},{"lineBreak":true},{"text":"சூம்பிப்போன காய்கள் அத்திமரத்திலிருந்து விழுவதுபோலவும் விழும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"எனது வாள் தன் நிறைவை வானங்களில் குடித்திருக்கிறது;","poem":1},{"text":"இதோ, நான் முழுவதும் அழித்துப்போட்ட ஏதோம் மக்களை","poem":2},{"lineBreak":true},{"text":"நியாயந்தீர்ப்பதற்காக அது கீழே வருகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவின் வாள் இரத்தத்தில் தோய்ந்திருக்கிறது,","poem":1},{"text":"அது கொழுப்பினால் மூடப்பட்டிருக்கிறது.","poem":2},{"text":"அது செம்மறியாட்டுக் குட்டிகள், கடாக்களுடைய இரத்தத்தாலும்,","poem":1},{"text":"செம்மறியாட்டுக் கடாக்களின் சிறுநீரகக் கொழுப்பினாலும் மூடப்பட்டிருக்கிறது.","poem":2},{"text":"ஏனெனில் யெகோவா போஸ்றா பட்டணத்தில் ஒரு பலியையும்,","poem":1},{"text":"ஏதோமில் ஒரு வதையையும் நியமித்திருக்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"காளைக் கன்றுகளும்,","poem":1},{"text":"பெரும் எருதுகளுமாக காட்டெருதுகள் அவைகளுடன் விழும்.","poem":2},{"text":"அவர்களுடைய நாடு இரத்தத்தில் தோய்ந்திருக்கும்,","poem":1},{"text":"புழுதியும் கொழுப்பில் ஊறியிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஏனெனில் யெகோவா பழிவாங்கும் நாளொன்றை வைத்திருக்கிறார்;","poem":1},{"text":"சீயோனின் வழக்கில் நீதி வழங்குவதற்காக ஒரு வருடத்தை வைத்திருக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏதோமின் நீரோடைகள் நிலக்கீலாக மாறும்,","poem":1},{"text":"நிலத்தின் புழுதி எரியும் கந்தகமாகவும்,","poem":2},{"lineBreak":true},{"text":"அதன் நிலம் எரியும் கீலாகவும் மாறும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அது இரவிலும் பகலிலும் தணிக்க முடியாதபடி இருக்கும்;","poem":1},{"text":"அதன் புகை என்றென்றும் புகைந்துகொண்டே இருக்கும்.","poem":2},{"text":"தலைமுறை தலைமுறையாக அது பாழடைந்து கிடக்கும்,","poem":1},{"text":"மீண்டும் அதன் ஊடாக யாரும் போகமாட்டார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பாலைவன ஆந்தையும் அலறும் ஆந்தையும்","poem":1},{"text":"அதைத் தங்கள் உடைமை ஆக்கிக்கொள்ளும்;","poem":2},{"text":"பெரிய ஆந்தையும், காகமும் தமது கூடுகளை அங்கு அமைக்கும்.","poem":1},{"text":"இறைவன் ஏதோமுக்கு மேலாக குழப்பத்தின் அளவுகோலையும்,","poem":2},{"lineBreak":true},{"text":"அழிவின் தூக்கு நூலையும் நீட்டிப் பிடிப்பார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உயர்குடி மக்களுக்கு அரசு எனச் சொல்லிக்கொள்ள அங்கு ஒன்றுமே இராது;","poem":1},{"text":"இளவரசர்கள் அனைவரும் இல்லாமல் போவார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அதனுடைய அரண்செய்யப்பட்ட பட்டணங்களின்மேல் முட்செடிகள் படரும்;","poem":1},{"text":"காஞ்சொறிகளும் கள்ளிச்செடிகளும் அதன் கோட்டைகளில் படரும்.","poem":2},{"text":"அது நரிகளுக்குத் தங்குமிடமும்","poem":1},{"text":"ஆந்தைகளுக்கு குடியிருப்புமாகும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பாலைவன பிராணிகளும், கழுதைப்புலிகளுடன் ஒன்றுசேரும்;","poem":1},{"text":"காட்டாடுகளும் ஒன்றையொன்று பார்த்துக் கத்தும்.","poem":2},{"text":"இரவுப் பிராணிகளும் அங்கு இளைப்பாறி","poem":1},{"text":"தங்களுக்குத் தங்கும் இடங்களைத் தேடும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆந்தைகள் அங்கே கூடுகட்டி,","poem":1},{"text":"முட்டையிட்டுக் குஞ்சு பொரித்து,","poem":2},{"lineBreak":true},{"text":"அவைகளைத் தமது சிறகுகளின் நிழலில் பாதுகாக்கும்;","poem":2},{"text":"வல்லூறுகளும் தத்தம் துணையுடன்","poem":1},{"text":"அங்கே வந்துசேரும்.","poem":2}]},{"type":"verse","number":16,"content":["யெகோவாவின் புத்தகச்சுருளை தேடி வாசியுங்கள்:",{"text":"இவற்றில் ஒன்றாவது தவறிப்போகாது,","poem":1},{"text":"ஒன்றாவது தனக்குத் துணையில்லாமல் இராது;","poem":2},{"text":"யெகோவாவின் வாயே இந்தக் கட்டளையைக் கொடுத்தது,","poem":1},{"text":"அவரின் ஆவியானவர் இவற்றை ஒன்றுசேர்ப்பார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவற்றிற்குரிய பாகங்களை அவரே பங்கிடுகிறார்;","poem":1},{"text":"அவருடைய கரமே அவற்றை அளவுகளின்படி பகிர்ந்து கொடுக்கின்றன.","poem":2},{"text":"அவை என்றென்றைக்கும் அதைத் தங்கள் சொந்தமாக்கி,","poem":1},{"text":"தலைமுறை தலைமுறையாக அங்கே குடியிருக்கும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/33.json","previousChapterAudioLinks":{},"numberOfVerses":17}