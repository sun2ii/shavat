{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":35,"content":[{"type":"heading","content":["மீட்கப்பட்டோரின் மகிழ்ச்சி"]},{"type":"verse","number":1,"content":[{"text":"பாலைவனமும் வறண்ட நிலமும் மகிழும்.","poem":1},{"text":"வனாந்திரம் மகிழ்ந்து பூக்கும்.","poem":2},{"text":"அது லீலி பூப்பதுபோல் பூக்கும்.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"அது வளமாய் வளர்ந்து","poem":1},{"text":"மகிழ்ச்சியுடன் ஆனந்த சத்தமிடும்.","poem":2},{"text":"லெபனோனின் மகிமையும்,","poem":1},{"text":"கர்மேல், சாரோனின் சிறப்பும் அதற்குக் கொடுக்கப்படும்.","poem":2},{"text":"யெகோவாவின் மகிமையையும்,","poem":1},{"text":"நமது இறைவனின் மகத்துவத்தையும் காண்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"தளர்ந்த கைகளைப் பலப்படுத்துங்கள்,","poem":1},{"text":"தள்ளாடும் முழங்கால்களைத் திடப்படுத்துங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இருதயத்தில் பதற்றமுள்ளோருக்கு,","poem":1},{"text":"“திடன்கொள்ளுங்கள், பயப்படாதிருங்கள்;","poem":2},{"text":"இதோ, உங்கள் இறைவன்","poem":1},{"text":"உங்கள் பகைவரை பழிதீர்க்கவும்,","poem":2},{"text":"பதிலளிக்கவும் வருவார்,","poem":1},{"text":"அவர் வந்து உங்களை விடுவிப்பார்” என்று சொல்லுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அப்பொழுது குருடரின் கண்கள் பார்வை பெறும்,","poem":1},{"text":"செவிடரின் காதுகளும் திறக்கப்படும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"முடவன் மானைப்போல் துள்ளுவான்,","poem":1},{"text":"ஊமையின் நாவும் ஆனந்த சத்தமிடும்;","poem":2},{"text":"வனாந்திரத்திலிருந்து தண்ணீரும்,","poem":1},{"text":"பாலைவனத்திலிருந்து நீரோடைகளும் பாயும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"சுடுமணல் நீர்த் தடாகமாகும்,","poem":1},{"text":"வறண்ட நிலம் நீரூற்றுகளுமாய் பொங்கிவரும்.","poem":2},{"text":"நரிகள் தங்கும் இடங்களில்","poem":1},{"text":"புல்லும், கோரையும், நாணலும் வளர்ந்து நிற்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அங்கே பிரதான வீதி ஒன்றிருக்கும்,","poem":1},{"text":"அது பரிசுத்த வழி எனப்படும்.","poem":2},{"lineBreak":true},{"text":"அசுத்தர் அதன் வழியே கடந்து செல்லமாட்டார்கள்.","poem":2},{"text":"இறைவனுடைய வழியில் நடப்பவர்களுக்கென்றே அது இருக்கும்.","poem":1},{"text":"கொடிய மூடர் அதில் திரியமாட்டார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அங்கு சிங்கம் இருப்பதில்லை;","poem":1},{"text":"எந்தவொரு கொடிய மிருகமாவது அங்கே செல்வதில்லை,","poem":2},{"lineBreak":true},{"text":"அங்கே காணப்படுவதுமில்லை.","poem":2},{"text":"மீட்கப்பட்டவர்களே அதில் நடப்பார்கள்.","poem":1}]},{"type":"verse","number":10,"content":[{"text":"யெகோவாவினால் மீட்கப்பட்டவர்கள் திரும்பி வருவார்கள்.","poem":2},{"text":"அவர்கள் பாடலுடன் சீயோனுக்குள் செல்வார்கள்;","poem":1},{"text":"நித்திய மகிழ்ச்சி அவர்களுடைய தலையின்மேலிருக்கும்.","poem":2},{"text":"மகிழ்ச்சியும், ஆனந்தமும் அடைவார்கள்,","poem":1},{"text":"துக்கமும் பெருமூச்சும் பறந்தோடிவிடும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/34.json","previousChapterAudioLinks":{},"numberOfVerses":10}