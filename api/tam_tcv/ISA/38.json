{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":38,"content":[{"type":"heading","content":["எசேக்கியாவின் வியாதி"]},{"type":"verse","number":1,"content":["அந்நாட்களில் எசேக்கியா வியாதிப்பட்டு சாகும் தருவாயில் இருந்தான். ஆமோஸின் மகனான இறைவாக்கினன் ஏசாயா அவனிடம் போய், “யெகோவா கூறுவது இதுவே: நீர் சாகப்போகிறீர்; பிழைக்கமாட்டீர். ஆகையால் உன் வீட்டுக் காரியங்களை ஒழுங்குபடுத்தும் என்கிறார்” என்றான்."]},{"type":"verse","number":2,"content":["எசேக்கியா தன் முகத்தை சுவரின் பக்கமாகத் திருப்பி யெகோவாவிடம் மன்றாடினான்."]},{"type":"verse","number":3,"content":["அவன், “யெகோவாவே, நான் உமக்குமுன் உண்மையுள்ளவனாய் நடந்து, பயபக்தியாய் முழுமனதுடன் உமது பார்வையில் நலமானதையே செய்தேன் என்பதை நினைவுகூரும்” என்று எசேக்கியா மனங்கசந்து அழுதான்."]},{"type":"verse","number":4,"content":["அப்பொழுது யெகோவாவின் வார்த்தை ஏசாயாவுக்கு வந்தது."]},{"type":"verse","number":5,"content":["“நீ எசேக்கியாவிடம் போய் சொல்லவேண்டியதாவது: ‘உன் தகப்பனாகிய தாவீதின் இறைவனாகிய யெகோவா சொல்வது இதுவே, நான் உனது வேண்டுதலைக் கேட்டேன்; உன் கண்ணீரையும் கண்டேன். உன் வாழ்நாட்களோடு இன்னும் பதினைந்து வருடங்களைக் கூட்டுவேன்."]},{"type":"verse","number":6,"content":["அசீரிய அரசனின் கையிலிருந்து உன்னையும், இந்தப் பட்டணத்தையும் விடுவிப்பேன். இந்தப் பட்டணத்துக்கு ஆதரவாக இருப்பேன்."]},{"type":"verse","number":7,"content":["“ ‘யெகோவா தான் வாக்களித்ததை நிறைவேற்றுவார் என்பதற்கு யெகோவா உனக்குத் தரும் அடையாளம் இதுவே:"]},{"type":"verse","number":8,"content":["ஆகாஸின் நேரம்பார்க்கும் படிவரிசையில் சூரியனின் நிழலைப் பத்துப்படி பின்னடையச் செய்வேன்’ என்றார்.” அப்படியே சூரிய ஒளியும் பத்துப்படி பின்னடைந்தது."]},{"type":"verse","number":9,"content":["யூதாவின் அரசன் எசேக்கியா நோயுற்றுக் குணமடைந்ததும் பின்வரும் கவிதையை எழுதினான்:"]},{"type":"verse","number":10,"content":[{"text":"“நான் என் வாழ்வின் சிறந்த பருவத்தில்","poem":1},{"text":"மரண வாசலுக்குப் போகவேண்டுமோ?","poem":2},{"lineBreak":true},{"text":"எனது மிகுதி வருடங்களைப் பறிகொடுக்க வேண்டுமோ?”","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“வாழ்வோரின் நாட்டில்","poem":1},{"text":"நான் மீண்டும் யெகோவாவை காண்பதில்லை.","poem":2},{"text":"மனிதகுலத்தை இனியொருபோதும் பார்ப்பதில்லை,","poem":1},{"text":"அல்லது இவ்வுலகில் வாழ்வோருடன் இருப்பதில்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மேய்ப்பனின் கூடாரத்தைப்போல என் வீடு","poem":1},{"noteId":18},{"text":"என்னிடமிருந்து பிடுங்கி எடுக்கப்பட்டிருக்கிறது.","poem":2},{"text":"நெசவாளனைப்போல என் வாழ்வை நான் சுருட்டி விட்டேன்,","poem":1},{"text":"அவரும் என்னைத் தறியிலிருந்து வெட்டிவிட்டார்;","poem":2},{"lineBreak":true},{"text":"காலையிலிருந்து இரவுக்குள் எனக்கு முடிவுகட்டுவீர்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் விடியும்வரை பொறுமையாய்க் காத்திருந்தேன்;","poem":1},{"text":"ஆனால் என் எலும்புகளையெல்லாம் சிங்கத்தைப்போல் நொறுக்கி விட்டார்;","poem":2},{"lineBreak":true},{"text":"காலையிலிருந்து இரவுக்குள் எனக்கு முடிவுகட்டுவீர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் சிட்டுக்குருவியைப் போலவும் நாரைப் போலவும் கூவினேன்,","poem":1},{"text":"துயரப்படும் புறாவைப்போல் விம்முகிறேன்.","poem":2},{"text":"உதவிவேண்டி நான் வானங்களை நோக்கியபோது, என் கண்கள் பெலவீனமாயின.","poem":1},{"text":"யெகோவாவே, நான் ஒடுக்கப்படுகிறேன், எனக்கு உதவிசெய்ய வாரும்” என்று சொன்னேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ஆனால் என்னால் என்ன சொல்லமுடியும்?","poem":1},{"text":"அவர் என்னிடம் பேசினார்; அவரே இதைச் செய்திருக்கிறார்.","poem":2},{"text":"என் ஆத்தும துயரத்தின் நிமித்தம்","poem":1},{"text":"நான் எனது காலமெல்லாம் தாழ்மையாய் நடப்பேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யெகோவாவே, மனிதர் இவைகளாலேயே வாழ்கிறார்கள்;","poem":1},{"text":"எனது ஆவியும் இவற்றிலே வாழ்வைக் காண்கிறது.","poem":2},{"text":"நீரே என்னை சுகப்படுத்தி","poem":1},{"text":"வாழச் செய்தீர்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நிச்சயமாக, என் நன்மைக்காகவே","poem":1},{"text":"இப்படியான வேதனையை நான் அனுபவித்தேன்.","poem":2},{"text":"உமது அன்பினால்தான்","poem":1},{"text":"நான் அழிவின் குழிக்குள் போகாதபடி நீர் என்னை வைத்திருக்கிறீர்.","poem":2},{"text":"என் பாவங்களையெல்லாம்","poem":1},{"text":"உமது முதுகிற்குப் பின்னாலே போட்டுவிட்டீர்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"பாதாளம் உம்மைத் துதிக்காது,","poem":1},{"text":"மரணம் உமக்குத் துதிபாடாது;","poem":2},{"text":"குழியில் இறங்குவோர்","poem":1},{"text":"உமது உண்மையை எதிர்பார்க்க முடியாது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இன்று நான் உம்மைத் துதிப்பதுபோல,","poem":1},{"text":"வாழ்பவர்கள், வாழ்பவர்களே உம்மைத் துதிப்பார்கள்.","poem":2},{"text":"பெற்றோர் தம் பிள்ளைகளுக்கு","poem":1},{"text":"உமது உண்மையைப் பற்றிச் சொல்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"யெகோவா என்னை இரட்சிப்பார்;","poem":1},{"text":"நாம் நம் வாழ்நாள் எல்லாம்","poem":2},{"text":"யெகோவாவினுடைய ஆலயத்தில்","poem":1},{"text":"இசைக்கருவிகளுடன் துதிபாடுவோம்.","poem":2}]},{"type":"verse","number":21,"content":["ஏற்கெனவே ஏசாயா நோயுற்றிருந்த எசேக்கியாவுக்கு, “அத்திப்பழ அடையொன்றைத் தயாரித்து, அதைக் கட்டியின்மீது பற்றுப்போடுங்கள்; அப்பொழுது அவர் சுகமடைவார்” என சொல்லியிருந்தான்."]},{"type":"verse","number":22,"content":["அப்பொழுது எசேக்கியா, “நான் யெகோவாவின் ஆலயத்திற்குப் போவேன் என்பதற்கு அடையாளம் என்ன?” என்று கேட்டிருந்தான்."]}],"footnotes":[{"noteId":18,"caller":"+","text":"வீடு அல்லது வாழ்க்கை","reference":{"chapter":38,"verse":12}}]},"thisChapterLink":"/api/tam_tcv/ISA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}