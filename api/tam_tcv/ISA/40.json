{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":40,"content":[{"type":"heading","content":["இறைவனின் மக்களுக்கு ஆறுதல்"]},{"type":"verse","number":1,"content":[{"text":"என் மக்களை ஆற்றுங்கள், தேற்றுங்கள்,","poem":1},{"text":"என உங்கள் இறைவன் சொல்கிறார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"எருசலேமுடன் தயவாகப் பேசுங்கள்,","poem":1},{"text":"அவளிடம், “அவளது கடும் உழைப்பு முடிவடைந்தது;","poem":2},{"text":"அவளுடைய பாவத்திற்கு நிவாரணம் கொடுத்து முடிந்துவிட்டது;","poem":1},{"text":"அவள் தனது எல்லா பாவங்களுக்காகவும்","poem":2},{"text":"இரட்டிப்பான தண்டனையை யெகோவாவின் கரங்களிலிருந்து","poem":1},{"text":"அனுபவித்து விட்டாள்” என்று அவளுக்குப் பிரசித்தப்படுத்துங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ஒருவரின் குரல் கூப்பிடுகிறது:","poem":1},{"lineBreak":true},{"text":"“பாலைவனத்தில் யெகோவாவுக்கு","poem":1},{"text":"வழியை ஆயத்தப்படுத்துங்கள்;","poem":2},{"text":"வனாந்திரத்திலே நமது இறைவனுக்கு","poem":1},{"text":"பிரதான வீதியொன்றை நேராய் அமையுங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஒவ்வொரு பள்ளத்தாக்கும் உயர்த்தப்படும்,","poem":1},{"text":"ஒவ்வொரு மலையும் குன்றும் தாழ்த்தப்படும்,","poem":2},{"text":"மேடுபள்ளம் நிறைந்த நிலம் சமமாக்கப்படும்,","poem":1},{"text":"கரடுமுரடான இடங்கள் சீராக்கப்படும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவாவின் மகிமை வெளிப்படுத்தப்படும்;","poem":1},{"text":"மனுக்குலம் யாவும் ஒன்றாய் அதைக் காணும்.","poem":2},{"text":"யெகோவாவின் வாயே இதைப் பேசியிருக்கிறது.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“உரத்துச் சொல்” என்கிறது ஒரு குரல்.","poem":1},{"text":"அதற்கு, “நான் எதைச் சொல்லுவேன்?” என்றேன்.","poem":2},{"lineBreak":true},{"text":"“எல்லா மனிதரும் புல்லைப் போன்றவர்கள்,","poem":1},{"text":"அவர்களின் மகிமை எல்லாம் வயல்வெளியின் பூக்களைப் போன்றன.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவின் சுவாசம் அவைகளின்மேல் வீசுகிறபோது புல் வாடுகிறது,","poem":1},{"text":"பூக்களும் உதிர்கின்றன;","poem":2},{"lineBreak":true},{"text":"நிச்சயமாக மக்களும் புல்லாகவே இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"புல் வாடுகிறது, பூக்கள் உதிர்கின்றன,","poem":1},{"text":"ஆனால், நமது இறைவனின் வார்த்தையோ என்றென்றும் நிலைத்து நிற்கிறது.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"சீயோனுக்கு நற்செய்தி கொண்டுவருபவனே,","poem":1},{"text":"நீ உயர்ந்த மலையொன்றில் ஏறு.","poem":2},{"text":"எருசலேமுக்கு நற்செய்தி கொண்டுவருபவனே,","poem":1},{"text":"நீ குரலை எழுப்பிக் கூக்குரலிடு.","poem":2},{"text":"பயப்படாதே, குரலை எழுப்பு;","poem":1},{"text":"“இதோ உங்கள் இறைவன்!”","poem":2},{"lineBreak":true},{"text":"என்று யூதாவின் பட்டணங்களுக்குச் சொல்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இதோ, ஆண்டவராகிய யெகோவா வல்லமையோடு வருகிறார்;","poem":1},{"text":"அவருடைய புயமே அவருக்காக ஆளுகை செய்யும்.","poem":2},{"text":"அவர் அளிக்கும் வெகுமதியும் அவருடன் இருக்கிறது,","poem":1},{"text":"அவர் தரும் பிரதிபலனும் அவருடனே வருகிறது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர் மேய்ப்பனைப்போல் தன் மந்தையை மேய்க்கிறார்:","poem":1},{"text":"அவர் செம்மறியாட்டுக் குட்டிகளை ஒன்றுசேர்த்து கைகளில் ஏந்தி,","poem":2},{"text":"மார்போடு அணைத்துக்கொண்டு செல்கிறார்;","poem":1},{"text":"அவர் குட்டிகளுடன் இருக்கும் செம்மறியாடுகளைக் கனிவாக நடத்துகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"கடல் நீரைத் தமது உள்ளங்கையால் அளந்து,","poem":1},{"text":"வானங்களை சாண் அளவாய்க் கணித்தவர் யார்?","poem":2},{"text":"பூமியின் புழுதியை மரக்காலால் அளந்தவன் யார்?","poem":1},{"text":"அல்லது மலைகளை நிறைகோலாலும்,","poem":2},{"lineBreak":true},{"text":"குன்றுகளையும் தராசாலும் நிறுத்தவர் யார்?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவாவின் மனதை புரிந்துகொண்டு,","poem":1},{"text":"அவரது ஆலோசகனாக இருந்து அவருக்கு அறிவுறுத்தியவன் யார்?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவா தமது அறிவு தெளிவுபெற யாரிடம் ஆலோசனை கேட்டார்?","poem":1},{"text":"சரியான வழியை அவருக்குக் போதித்தவன் யார்?","poem":2},{"text":"அவருக்கு அறிவைக் போதித்து,","poem":1},{"text":"விளக்கத்தின் பாதையைக் காட்டியவன் யார்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"உண்மையாகவே நாடுகள் வாளியிலிருந்து விழும்","poem":1},{"text":"தண்ணீர்த் துளியைப் போலிருக்கின்றன;","poem":2},{"text":"அவர்கள் தராசில் படிந்துள்ள தூசியைப்போல் கருதப்படுகிறார்கள்;","poem":1},{"text":"அவர் தீவுகளை தூசியைப்போல நிறுக்கிறார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"லெபனோன் பலிபீட நெருப்புக்குப் போதாது.","poem":1},{"text":"அங்குள்ள மிருகங்கள் தகன பலிக்கும் போதாது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"எல்லா நாடுகளும் அவர் முன்னிலையில் ஒன்றுமில்லாதவர்கள்போல் இருக்கின்றனர்.","poem":1},{"text":"அவர்கள் அவரால் வெறுமையிலும் வெறுமையானவர்களாகவும்,","poem":2},{"lineBreak":true},{"text":"பெருமதியற்றவர்களாகவும் கருதப்படுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"இப்படியிருக்க, நீங்கள் இறைவனை யாருக்கு ஒப்பிடுவீர்கள்?","poem":1},{"text":"எந்த சாயலுக்கு அவரை ஒப்பிடுவீர்கள்?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"விக்கிரகத்தை ஒரு கைவினைஞன் வார்க்கிறான்,","poem":1},{"text":"கொல்லன் அதைத் தங்கத்தால் மூடி,","poem":2},{"lineBreak":true},{"text":"அதற்காக வெள்ளி மாலைகளைச் செய்கிறான்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அத்தகைய காணிக்கையைச் செலுத்தமுடியாத ஏழையோ,","poem":1},{"text":"உழுத்துப்போகாத மரத்தைத் தெரிவு செய்கிறான்.","poem":2},{"text":"அதைச் செதுக்கி, சரிந்து வீழ்ந்து போகாத விக்கிரகத்தைச் செய்யும்படி","poem":1},{"text":"திறமைவாய்ந்த ஒரு சிற்பியைத் தேடுகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"நீங்கள் அறியவில்லையோ?","poem":1},{"text":"நீங்கள் கேள்விப்படவில்லையோ?","poem":2},{"text":"ஆதியில் இருந்து உங்களுக்குச் சொல்லப்படவில்லையோ?","poem":1},{"text":"பூமி படைக்கப்பட்ட காலத்திலிருந்தே நீங்கள் விளங்கிக்கொள்ளவில்லையோ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவர் பூமியின் வட்டத்தின்மேல் தன் அரியணையில் வீற்றிருக்கிறார்,","poem":1},{"text":"அதன் மக்கள் வெட்டுக்கிளிகளைப்போல் இருக்கிறார்கள்.","poem":2},{"text":"அவர் வானங்களை மூடுதிரையைப்போல் விரித்து,","poem":1},{"text":"அவைகளை ஒரு குடியிருக்கும் கூடாரத்தைப்போல் அமைத்திருக்கிறார்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவர் இளவரசர்களைத் தாழ்வு நிலைக்குத் தள்ளுகிறார்;","poem":1},{"text":"உலக ஆளுநர்களையும் பெறுமதியற்றவர்களாக்குகிறார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவர்கள் நாட்டப்பட்ட உடனேயே,","poem":1},{"text":"அவர்கள் விதைக்கப்பட்ட உடனேயே,","poem":2},{"lineBreak":true},{"text":"அவர்கள் நிலத்தில் வேரூன்றிய உடனேயே இறைவன் அவர்கள்மேல் ஊத,","poem":2},{"text":"அவர்கள் வாடிப்போகிறார்கள்.","poem":1},{"text":"சுழல் காற்றும் பதர்களைப்போல் அவர்களை வாரிக்கொண்டுபோகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“நீங்கள் என்னை யாருக்கு ஒப்பிடுவீர்கள்?","poem":1},{"text":"அல்லது எனக்கு நிகரானவர் யார்?” என்று பரிசுத்தர் கேட்கிறார்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"கண்களை உயர்த்தி மேலே நோக்குங்கள்:","poem":1},{"text":"இவைகளையெல்லாம் படைத்தவர் யார்?","poem":2},{"text":"நட்சத்திர சேனையை ஒவ்வொன்றாக வெளிக்கொணர்ந்து,","poem":1},{"text":"அவை ஒவ்வொன்றையும் பேரிட்டு அழைக்கும் அவரே.","poem":2},{"text":"அவருடைய மிக வல்லமையாலும்,","poem":1},{"text":"மகா பலத்தினாலும் அவைகளில் ஒன்றுகூட தவறுவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“என் நிலைமை யெகோவாவுக்கு மறைவாயிருக்கிறது;","poem":1},{"text":"இறைவன் எனக்குரிய நீதியைக் கண்டும் காணாதிருக்கிறார்”","poem":2},{"text":"என்று யாக்கோபே நீ ஏன் சொல்கிறாய்?","poem":1},{"text":"இஸ்ரயேலே, ஏன் முறையிடுகிறாய்?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நீங்கள் அறியவில்லையோ?","poem":1},{"text":"நீங்கள் கேள்விப்படவில்லையோ?","poem":2},{"text":"யெகோவாவே நித்திய இறைவன்,","poem":1},{"text":"பூமியின் எல்லைகளைப் படைத்தவரும் அவரே.","poem":2},{"text":"அவர் களைத்துப் போவதுமில்லை, சோர்ந்துபோவதுமில்லை.","poem":1},{"text":"அவரின் ஞானத்தை யாராலும் அளவிடமுடியாது.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர் களைப்புற்றோருக்கு பெலன் கொடுக்கிறார்;","poem":1},{"text":"பெலவீனருக்கு வலிமையைக் கூட்டுகிறார்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"இளைஞர் களைத்து சோர்ந்துபோவார்கள்,","poem":1},{"text":"வாலிபர் இடறி விழுவார்கள்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ஆனால், யெகோவாவிடம் நம்பிக்கையோடேக் காத்திருப்போர்","poem":1},{"text":"தங்கள் பெலனைப் புதுப்பித்துக்கொள்வார்கள்.","poem":2},{"text":"அவர்கள் கழுகுகளைப்போல் சிறகுகளை விரித்து உயரே பறப்பார்கள்;","poem":1},{"text":"அவர்கள் ஓடுவார்கள், சோர்வடையமாட்டார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் நடப்பார்கள், களைப்படையமாட்டார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/39.json","previousChapterAudioLinks":{},"numberOfVerses":31}