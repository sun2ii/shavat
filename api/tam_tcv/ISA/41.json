{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":41,"content":[{"type":"heading","content":["இஸ்ரயேலரின் துணைவர்"]},{"type":"verse","number":1,"content":[{"text":"“தீவுகளே, நீங்கள் எனக்குமுன் மவுனமாயிருங்கள்!","poem":1},{"text":"நாடுகள் தமது பெலனைப் புதுப்பிக்கட்டும்!","poem":2},{"text":"அவர்கள் முன்வந்து பேசட்டும்;","poem":1},{"text":"நாம் எல்லோரும் நியாயந்தீர்க்கும் இடத்தில் ஒன்று கூடுவோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“கிழக்கிலிருந்து ஒருவனை எழுப்பி,","poem":1},{"text":"நேர்மையுடன் தனக்குப் பணிசெய்ய அவனை அழைத்தவர் யார்?","poem":2},{"noteId":19},{"text":"அவர் நாடுகளை அவனிடம் ஒப்படைத்து,","poem":1},{"text":"அரசர்களை அவன் முன்னே அடக்குகிறார்.","poem":2},{"text":"அவனோ அவர்களைத் தன் வாளினால் தூசியாக்கி,","poem":1},{"text":"தன் வில்லினால் காற்றில் பறக்கும் பதராக்குகிறான்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவன் தனக்குத் தீங்கு நேராமல்,","poem":1},{"text":"தான் முன்னர் போகாத வழியாக அவர்களைத் துரத்திச் செல்கிறான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இதைச் செய்தது யார்? ஆதியிலிருந்து தலைமுறைகளை அழைத்து,","poem":1},{"text":"இதை நிறைவேற்றியது யார்?","poem":2},{"text":"முந்தினவராய் இருப்பவர் யெகோவாவாகிய நானே,","poem":1},{"text":"பிந்தினவராய் இருப்பதும் நானே.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"தீவுகள் அதைக்கண்டு பயப்படுகின்றன;","poem":1},{"text":"பூமியின் எல்லைகள் நடுங்குகின்றன.","poem":2},{"text":"அவர்கள் நெருங்கி முன்னேறி வந்து,","poem":1}]},{"type":"verse","number":6,"content":[{"text":"ஒருவருக்கு ஒருவர் உதவிசெய்து,","poem":2},{"lineBreak":true},{"text":"“திடன்கொள்!” என்று தம் அடுத்தவருக்கு சொல்கிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கைவினைஞன் கொல்லனை ஊக்குவிக்கிறான்,","poem":1},{"text":"சுத்தியலால் தட்டி மிருதுவாக்குகிறவன்","poem":2},{"lineBreak":true},{"text":"பட்டறையில் இரும்பை வைத்து அடிப்பவனை உற்சாகப்படுத்தி,","poem":2},{"text":"“அது நன்றாய் இணைக்கப்பட்டிருக்கிறது” என்று சொல்லி,","poem":1},{"text":"அது அசையாதபடி ஆணிகளால் அடித்து இறுக்குகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ஆனால் நீயோ, இஸ்ரயேலே, என் அடியவனே,","poem":1},{"text":"நான் தெரிந்தெடுத்த யாக்கோபே,","poem":2},{"lineBreak":true},{"text":"என் நண்பன் ஆபிரகாமின் வழித்தோன்றலே,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் பூமியின் எல்லைகளிலிருந்து உன்னை எடுத்து,","poem":1},{"text":"அதன் தொலைதூரத்திலிருந்து உன்னை அழைத்தேன்.","poem":2},{"text":"நான், ‘நீ என் ஊழியக்காரன்’;","poem":1},{"text":"நான் உன்னைத் தெரிந்துகொண்டேன், நான் உன்னைப் புறக்கணிக்கவில்லை என்றேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆகையால் பயப்படாதே, நான் உன்னுடனே இருக்கிறேன்;","poem":1},{"text":"கலங்காதே, நானே உன் இறைவன்.","poem":2},{"text":"நான் உன்னைப் பெலப்படுத்தி, உனக்கு உதவி செய்வேன்;","poem":1},{"text":"எனது நீதியின் வலது கரத்தால் நான் உன்னைத் தாங்கிக்கொள்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“கடுங்கோபத்தோடு உன்னை எதிர்ப்பவர்கள் யாவரும்","poem":1},{"text":"நிச்சயமாக வெட்கப்படுத்தப்பட்டு, அவமானப்படுத்தப்படுவார்கள்.","poem":2},{"text":"உன்னை எதிர்ப்பவர்கள் இருந்த இடம்","poem":1},{"text":"தெரியாமலேயே அழிந்துபோவார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உனது பகைவரைத் தேடினாலும்","poem":1},{"text":"நீ காணமாட்டாய்,","poem":2},{"text":"உன்னை எதிர்த்துப் போரிடும் யாவரும்","poem":1},{"text":"இருந்த இடம் தெரியாமலே போய்விடுவார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஏனெனில், யெகோவாவாகிய நானே உன் இறைவன்.","poem":1},{"text":"நானே உனது வலதுகையைப் பிடித்து,","poem":2},{"text":"பயப்படாதே,","poem":1},{"text":"உனக்கு நான் உதவி செய்வேன் என்று சொல்கிறவர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பயப்படாதே, யாக்கோபு என்னும் புழுவே,","poem":1},{"text":"இஸ்ரயேல் என்னும் சிறுகூட்டமே,","poem":2},{"text":"நான், நானே உனக்கு உதவி செய்வேன்” என்று,","poem":1},{"text":"உனது மீட்பரும் இஸ்ரயேலின் பரிசுத்தருமாகிய யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“இதோ, நான் உன்னை ஒரு சூடடிக்கும் கருவியாக்குவேன்,","poem":1},{"text":"அது புதியதும், கூர்மையானதும், அநேக பற்களை உடையதுமான கருவி.","poem":2},{"text":"நீ மலைகளை போரடித்து, அவைகளை நொறுக்குவாய்;","poem":1},{"text":"நீ குன்றுகளைப் பதராக்குவாய்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீ அவைகளைத் தூற்றுவாய், காற்று அவைகளை அள்ளிக்கொண்டுபோய்,","poem":1},{"text":"புயல்காற்று அவைகளை வாரிக்கொண்டு போகும்.","poem":2},{"text":"ஆனால் நீயோ, யெகோவாவில் அகமகிழ்ந்து,","poem":1},{"text":"இஸ்ரயேலின் பரிசுத்தரில் மேன்மை அடைவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ஏழைகளும், எளியவர்களும் தண்ணீரைத் தேடுவார்கள்;","poem":1},{"text":"ஆனால் அங்கு ஒன்றுமிராது.","poem":2},{"lineBreak":true},{"text":"அவர்களின் நாவுகள் தாகத்தினால் வறண்டுபோகும்.","poem":2},{"text":"ஆனால் யெகோவாவாகிய நான் அவர்களுக்குப் பதிலளிப்பேன்;","poem":1},{"text":"இஸ்ரயேலின் இறைவனாகிய நான் அவர்களைக் கைவிடமாட்டேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நான் வறண்ட மேடுகளில் ஆறுகளையும்,","poem":1},{"text":"பள்ளத்தாக்குகளில் நீரூற்றுக்களையும் உண்டாக்குவேன்.","poem":2},{"text":"பாலைவனத்தை நீர்த்தடாகமாகவும்,","poem":1},{"text":"வறண்ட நிலத்தை நீரூற்றுகளாகவும் மாற்றுவேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"நான் பாலைவனத்திலே கேதுருக்களையும்,","poem":1},{"text":"சித்தீம் மரங்களையும், மிருதுச் செடிகளையும், ஒலிவ மரங்களையும் நாட்டுவேன்.","poem":2},{"text":"பாழ்நிலங்களில் தேவதாரு மரங்களையும், சவுக்கு மரங்களையும்,","poem":1},{"text":"புன்னை மரங்களையும் நான் சேர்த்து நாட்டுவேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"யெகோவாவின் கரம்தான் இப்படிச் செய்தது,","poem":1},{"text":"இஸ்ரயேலின் பரிசுத்தரே இவற்றை உண்டாக்கினார் என்று,","poem":2},{"text":"மக்கள் பார்த்து அறிந்துகொள்ளவும்,","poem":1},{"text":"சிந்தித்து விளங்கிக்கொள்ளவுமே இப்படிச் செய்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“உங்கள் வழக்கைச் சொல்லுங்கள்”","poem":1},{"text":"என்று யெகோவா சொல்லுகிறார்.","poem":2},{"text":"“உங்களுடைய நியாயங்களை எடுத்துக் கூறுங்கள்”","poem":1},{"text":"என்று யாக்கோபின் அரசர் சொல்கிறார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“உங்களுடைய விக்கிரகங்களைக் கொண்டுவாருங்கள்,","poem":1},{"text":"இனி நடக்கப் போகிறதை அவை தெரிவிக்கட்டும்.","poem":2},{"text":"முன்பு நடந்தவற்றை அவை எங்களுக்குச் சொல்லட்டும்,","poem":1},{"text":"அப்பொழுது நாம் அவைகளைச் சிந்தித்து,","poem":2},{"lineBreak":true},{"text":"அவைகளின் முடிவுகளை அறிவோம்,","poem":2},{"text":"அல்லது இனி நடக்கப்போவதை அவை தெரிவிக்கட்டும்.","poem":1}]},{"type":"verse","number":23,"content":[{"text":"நீங்கள்தான் தெய்வங்கள் என்று நாம் அறியும்படி,","poem":2},{"lineBreak":true},{"text":"இனி நடக்கப்போவதை எங்களுக்குத் தெரிவியுங்கள்;","poem":2},{"text":"நல்லதோ, கெட்டதோ எதையேனும் செய்யுங்கள்.","poem":1},{"text":"அப்பொழுது நாங்கள் கலங்கி, பயத்தால் நிரப்பப்படுவோம்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஆனால் நீங்களோ, வெறுமையிலும் வெறுமையானவர்கள்.","poem":1},{"text":"உங்கள் செயல்களெல்லாம் முற்றிலும் பயனற்றவை,","poem":2},{"lineBreak":true},{"text":"உங்களைத் தெரிந்தெடுப்பவன் அருவருப்பானவன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“நான் வடக்கிலிருந்து ஒருவனை எழும்பப் பண்ணியிருக்கிறேன்; அவன் வருகிறான்.","poem":1},{"text":"அவன் சூரிய உதயத்தில் இருந்து என் பெயரைச்சொல்லிக் கூப்பிடுகிறான்.","poem":2},{"text":"அவன் ஆளுநர்களை சுண்ணாம்புக் கலவையைப்போல் மிதிக்கிறான்;","poem":1},{"text":"குயவன் களிமண்ணை மிதித்துத் துவைப்பதுபோல் அவர்களை மிதிக்கிறான்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"இதை நாம் அறியும்படியாக ஆதியில் சொன்னது யார்?","poem":1},{"text":"அல்லது, ‘அவர் சொன்னது சரி’ என்று நாம் சொல்லும்படியாக இதை முன்பே கூறியது யார்?","poem":2},{"text":"இதைக்குறித்து ஒருவருமே சொல்லவில்லை;","poem":1},{"text":"ஒருவருமே முன்னறிவிக்கவுமில்லை,","poem":2},{"lineBreak":true},{"text":"உங்களிடமிருந்து ஒரு வார்த்தையையும் கேட்டவர்களும் இல்லை.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"‘இதோ, அவர்கள் வருகிறார்கள்’ என்று","poem":1},{"text":"நானே சீயோனிடம் முதன் முதலாகச் சொன்னேன்.","poem":2},{"lineBreak":true},{"text":"நானே நற்செய்தியின் தூதுவனை எருசலேமுக்குக் கொடுத்தேன்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"தெய்வங்களுக்குள்ளே நான் பார்த்தேன், ஆனால் அங்கு ஒருவருமில்லை.","poem":1},{"text":"ஆலோசனை கூற அவர்களில் ஒருவரும் இல்லை,","poem":2},{"lineBreak":true},{"text":"நான் கேட்கும்போது எனக்கு விடையளிக்கவும் ஒருவரும் இல்லை.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"இதோ, இவர்கள் எல்லோருமே மாயை!","poem":1},{"text":"அவர்களின் செயல்கள் வீணானவை;","poem":2},{"lineBreak":true},{"text":"அவர்களின் உருவச்சிலைகள் காற்றும் வெறுமையுமே.","poem":2}]}],"footnotes":[{"noteId":19,"caller":"+","text":"பெர்சியாவின் அரசன் கோரேசு 45:1.","reference":{"chapter":41,"verse":2}}]},"thisChapterLink":"/api/tam_tcv/ISA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/40.json","previousChapterAudioLinks":{},"numberOfVerses":29}