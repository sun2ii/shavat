{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":42,"content":[{"type":"heading","content":["யெகோவாவின் ஊழியர்"]},{"type":"verse","number":1,"content":[{"text":"“இதோ, நான் ஆதரிக்கிற என் ஊழியர்,","poem":1},{"text":"என்னால் தெரிந்துகொள்ளப்பட்ட இவரில் நான் மகிழ்ச்சியாயிருக்கிறேன்;","poem":2},{"text":"இவர்மேல் என் ஆவியானவரை அமரப்பண்ணுவேன்,","poem":1},{"text":"அவர் நாடுகளுக்கு நீதியை வழங்குவார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர் சத்தமிடவோ, சத்தமிட்டுக் கூப்பிடவோமாட்டார்.","poem":1},{"text":"அவர் வீதிகளில் உரத்த குரலில் பேசவுமாட்டார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர் நெரிந்த நாணலை முறிக்கமாட்டார்,","poem":1},{"text":"மங்கி எரிகின்ற திரியை அணைத்துவிடவுமாட்டார்;","poem":2},{"text":"அவர் உண்மையில் நீதியை வெளிப்படுத்தி, அதை நிலைநாட்டுவார்.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"பூமியிலே அவர் நீதியை நிலைநாட்டும்வரை","poem":2},{"text":"தயங்கவுமாட்டார் தளரவுமாட்டார்.","poem":1},{"text":"தீவுகள்","poem":2},{"noteId":20},{"text":"அவரது வேதத்தில் தங்கள் நம்பிக்கையை வைக்கும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவாகிய இறைவன் சொல்வதாவது:","poem":1},{"lineBreak":true},{"text":"அவரே வானங்களைப் படைத்து அவைகளை விரித்து வைத்தார்,","poem":1},{"text":"அவரே பூமியையும், அதிலிருந்து வரும் அனைத்தையும் பரப்பினார்.","poem":2},{"lineBreak":true},{"text":"அவரே அதில் உள்ள மக்களுக்கு சுவாசத்தைக் கொடுத்தார்.","poem":2},{"lineBreak":true},{"text":"அதில் நடமாடுபவர்களுக்கு உயிரைக் கொடுத்தார். அவர் சொல்வது இதுவே:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“யெகோவாவாகிய நான் நீதியிலேயே உன்னை அழைத்து,","poem":1},{"text":"நான் உனது கையைப் பிடித்து,","poem":2},{"text":"நான் உன்னைக் காத்து,","poem":1},{"text":"நீர் மக்களுக்கு ஒரு உடன்படிக்கையாகவும்,","poem":2},{"lineBreak":true},{"text":"பிற நாட்டவர்களுக்கு ஒரு ஒளியாகவும் இருக்கும்படி உம்மை ஏற்படுத்துவேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"குருடரின் கண்களைத் திறக்கவும்,","poem":1},{"text":"சிறையிலுள்ளவர்களை விடுதலையாக்கவும்,","poem":2},{"lineBreak":true},{"text":"இருட்டறையிலிருந்து விடுவிக்கவுமே இவ்வாறு செய்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“நான் யெகோவா; இதுவே எனது பெயர்!","poem":1},{"text":"எனது மகிமையை வேறொருவருக்கும் கொடுக்கமாட்டேன்;","poem":2},{"lineBreak":true},{"text":"எனக்குரிய துதியை விக்கிரகங்களுக்குக் கொடுக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இதோ, முற்காலத்தில் சொல்லப்பட்டவை நடந்தேறிவிட்டன,","poem":1},{"text":"இப்பொழுது நான் புதியவற்றை அறிவிக்கின்றேன்.","poem":2},{"text":"அவை தோன்றி உருவாகுமுன்பே அவைகளை","poem":1},{"text":"நான் உங்களுக்கு அறிவிக்கிறேன்.”","poem":2}]},{"type":"heading","content":["யெகோவாவுக்குத் துதிப்பாடல்"]},{"type":"verse","number":10,"content":[{"text":"கடலில் பயணம் செய்கிறவர்களே, கடலில் வாழ்பவைகளே,","poem":1},{"text":"தீவுகளே, அங்கு வாழும் குடிகளே,","poem":2},{"text":"யெகோவாவுக்கு புதுப்பாட்டைப் பாடுங்கள்,","poem":1},{"text":"பூமியின் கடைசிகளில் இருந்து அவருக்குத் துதி பாடுங்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பாலைவனமும் அதன் பட்டணங்களும் தங்கள் குரல்களை எழுப்பட்டும்;","poem":1},{"text":"கேதாரியர் வாழும் குடியிருப்புகள் மகிழட்டும்.","poem":2},{"text":"சேலாவின் மக்கள் மகிழ்ந்து பாடட்டும்;","poem":1},{"text":"அவர்கள் மலை உச்சிகளில் இருந்து ஆர்ப்பரிக்கட்டும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்கள் யெகோவாவுக்கு மகிமையைக் கொடுக்கட்டும்,","poem":1},{"text":"அவரின் துதியைத் தீவுகளில் பிரசித்தப்படுத்தட்டும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவா வலிய மனிதனைப்போல் முன்சென்று,","poem":1},{"text":"போர்வீரனைப்போல் தன் வைராக்கியங்கொண்டு எழும்புவார்.","poem":2},{"text":"அவர் உரத்த சத்தமாய் போர்க்குரல் எழுப்பி,","poem":1},{"text":"பகைவரை வெற்றிகொள்வார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“நான் வெகுகாலம் மவுனமாய் இருந்தேன்,","poem":1},{"text":"நான் அமைதியாய் இருந்து என்னையே அடக்கிக்கொண்டிருந்தேன்.","poem":2},{"text":"ஆனால் இப்பொழுது, பிரசவிக்கும் பெண்ணைப்போல் கதறி அழுது,","poem":1},{"text":"மூச்சுத் திணறுகிறேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் மலைகளையும், குன்றுகளையும் பாழாக்குவேன்,","poem":1},{"text":"அவைகளிலுள்ள தாவரங்களையும் வாடிப்போகப் பண்ணுவேன்.","poem":2},{"text":"ஆறுகளைத் தீவுகளாக மாற்றி,","poem":1},{"text":"குளங்களையும் வற்றப்பண்ணுவேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நான் குருடரை அவர்கள் அறிந்திராத வழிகளில் வழிநடத்தி,","poem":1},{"text":"அவர்களுக்குப் பழக்கமில்லாத பாதைகளில் அழைத்துச்செல்வேன்;","poem":2},{"text":"நான் இருளை அவர்களுக்கு முன்பாக வெளிச்சமாக்கி,","poem":1},{"text":"கரடுமுரடான இடங்களைச் செப்பனிடுவேன்.","poem":2},{"text":"நான் செய்யப்போகும் காரியங்கள் இவையே;","poem":1},{"text":"நான் அவர்களை நான் கைவிடமாட்டேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆனால் விக்கிரகங்களில் நம்பிக்கை வைத்து,","poem":1},{"text":"உருவச் சிலைகளைப் பார்த்து, ‘நீங்களே எங்கள் தெய்வங்கள்’ என்று சொல்பவர்கள்","poem":2},{"lineBreak":true},{"text":"பின்னடைந்து முற்றுமாய் வெட்கப்படுவார்கள்.","poem":2}]},{"type":"heading","content":["குருடும் செவிடுமான இஸ்ரயேல்"]},{"type":"verse","number":18,"content":[{"text":"“செவிடரே, கேளுங்கள்;","poem":1},{"text":"குருடரே, கவனித்துப் பாருங்கள்!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"எனது ஊழியனைவிடக் குருடன் யார்?","poem":1},{"text":"நான் அனுப்பும் தூதுவனைவிடச் செவிடன் யார்?","poem":2},{"text":"எனக்குத் தன்னை அர்ப்பணித்தவனைப்போல் குருடன் யார்?","poem":1},{"text":"யெகோவாவின் ஊழியனைப்போல் குருடன் யார்?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நீ பல காரியங்களைக் கண்டும் அதைக் கவனத்தில் எடுத்துக்கொள்ளவில்லை.","poem":1},{"text":"உன் காதுகள் திறந்திருந்தும் நீ ஒன்றையும் கேளாதிருக்கிறாய்.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"யெகோவா தன் நீதியின் நிமித்தம்","poem":1},{"text":"தனது சட்டத்தைச் சிறப்பாகவும்,","poem":2},{"lineBreak":true},{"text":"மகிமையாகவும் செய்வதில் மகிழ்ச்சியடைந்தார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஆனால் இந்த மக்களோ கொள்ளையடிக்கப்பட்டு, சூறையாடப்பட்டும் இருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் எல்லோருமே குழிகளில் அகப்பட்டும்,","poem":2},{"lineBreak":true},{"text":"சிறைச்சாலைகளில் மறைக்கப்பட்டும் இருக்கிறார்கள்.","poem":2},{"text":"அவர்கள் தம்மை விடுவிப்பாரின்றி","poem":1},{"text":"கொள்ளைப் பொருளாகி,","poem":2},{"text":"“அவர்களைத் திருப்பி அனுப்புங்கள்” என்று சொல்வாரின்றி","poem":1},{"text":"அவர்கள் சூறையாவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"உங்களில் எவன் இதற்குச் செவிகொடுப்பான்?","poem":1},{"text":"எவன் வருங்காலத்தை கவனித்துக் கேட்பான்?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"யாக்கோபை சூறைப்பொருளாகக் கொடுத்தது யார்?","poem":1},{"text":"இஸ்ரயேலை கொள்ளைக்காரருக்கு ஒப்படைத்தது யார்?","poem":2},{"text":"யெகோவா அல்லவா இதைச் செய்தார்,","poem":1},{"text":"நாமோ அவருக்கு எதிராகப் பாவம் செய்தோமே.","poem":2},{"text":"ஏனென்றால் அவர்கள் அவரின் வழிகளைப் பின்பற்றவில்லை,","poem":1},{"text":"அவரது சட்டத்திற்குக் கீழ்ப்படியவுமில்லை.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஆகையால் அவர் தனது பற்றியெரியும் கோபத்தையும்,","poem":1},{"text":"போரின் வன்செயலையும் அவர்கள்மேல் ஊற்றினார்.","poem":2},{"text":"அது அவர்களை நெருப்புச் சுவாலைகளினால் சூழ்ந்துகொண்டும்,","poem":1},{"text":"அதை அவர்கள் விளங்கிக்கொள்ளவில்லை.","poem":2},{"text":"அது அவர்களைச் சுட்டெரித்தது,","poem":1},{"text":"ஆனால் அதை அவர்கள் மனதில் கொள்ளவில்லை.","poem":2}]}],"footnotes":[{"noteId":20,"caller":"+","text":"பண்டைய உலகில் மக்கள் தொலைவில் இருந்த நாடுகளை தீவுகள் என்று அழைப்பார்கள்.","reference":{"chapter":42,"verse":4}}]},"thisChapterLink":"/api/tam_tcv/ISA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/41.json","previousChapterAudioLinks":{},"numberOfVerses":25}