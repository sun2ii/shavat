{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":43,"content":[{"type":"heading","content":["இஸ்ரயேலின் ஒரே மீட்பர்"]},{"type":"verse","number":1,"content":[{"text":"இப்போது யெகோவா சொல்வது இதுவே:","poem":1},{"text":"யாக்கோபே, உன்னைப் படைத்தவரும்,","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலே, உன்னை உருவாக்கியவரும் சொல்வதாவது,","poem":2},{"text":"“பயப்படாதே, நான் உன்னை மீட்டிருக்கிறேன்;","poem":1},{"text":"நான் உன்னைப் பெயர்சொல்லி அழைத்திருக்கிறேன்; நீ என்னுடையவன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீ தண்ணீரைக் கடக்கும்போது,","poem":1},{"text":"நான் உன்னுடன் இருப்பேன்;","poem":2},{"text":"நீ ஆறுகளைக் கடக்கும்போது,","poem":1},{"text":"அவை உன்னை அள்ளிக்கொண்டு போகாது;","poem":2},{"text":"நீ நெருப்பில் நடக்கும்போதும்","poem":1},{"text":"எரிந்து போகமாட்டாய்.","poem":2},{"lineBreak":true},{"text":"நெருப்பு சுவாலை உன்னை எரித்துப்போடாது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஏனெனில், நானே உங்கள் இறைவனாகிய யெகோவா,","poem":1},{"text":"இஸ்ரயேலின் பரிசுத்தராகிய நானே உன் இரட்சகர்;","poem":2},{"text":"நான் உன்னை மீட்கும் பொருளாக எகிப்தையும்,","poem":1},{"text":"உனக்குப் பதிலாக எத்தியோப்பியாவையும், சேபாவையும் கொடுக்கிறேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீ என் பார்வையில் அருமையானவன், மதிப்பிற்குரியவன்;","poem":1},{"text":"நான் உன்னில் அன்பாயிருக்கிறபடியினால்,","poem":2},{"text":"உனக்குப் பதிலாக மனிதரையும்,","poem":1},{"text":"உன் உயிருக்கு மாற்றீடாக நாடுகளையும் கொடுப்பேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பயப்படாதே, நான் உன்னுடன் இருக்கிறேன்;","poem":1},{"text":"நான் கிழக்கிலிருந்து உன் பிள்ளைகளைக் கொண்டுவருவேன்,","poem":2},{"lineBreak":true},{"text":"மேற்கிலிருந்து உங்களை ஒன்றுசேர்ப்பேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் வடக்கைப் பார்த்து, ‘அவர்களை விட்டுவிடு!’ என்றும்,","poem":1},{"text":"தெற்கைப் பார்த்து, ‘அவர்களை பிடித்து வைத்துக்கொள்ளாதே’ என்றும் சொல்வேன்.","poem":2},{"text":"எனது மகன்களைத் தூரத்திலிருந்தும்,","poem":1},{"text":"எனது மகள்களைப் பூமியின் கடைசிகளிலிருந்தும் கொண்டுவாருங்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் பெயரால் அழைக்கப்பட்ட ஒவ்வொருவரையும் கொண்டுவாருங்கள்.","poem":1},{"text":"இவர்களை நானே என் மகிமைக்காகப் படைத்தேன்.","poem":2},{"lineBreak":true},{"text":"இவர்களை நானே உருவாக்கி உண்டாக்கினேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"கண்களிருந்தும் குருடராயும்,","poem":1},{"text":"காதுகளிருந்தும் செவிடராயும் இருப்போரை வெளியே கொண்டுவாருங்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எல்லா நாடுகளும் ஒன்றுகூடுகிறார்கள்,","poem":1},{"text":"சகல மக்களும் சபையாய் கூடுகிறார்கள்;","poem":2},{"text":"அவர்களுடைய தேவர்களில் இதை முன்னறிவித்தவர் யார்?","poem":1},{"text":"இந்த பூர்வகாரியங்களை தெரிவித்தவர் யார்?","poem":2},{"text":"அவர்கள் தாங்கள் சரியென நிரூபிப்பதற்குத் தங்கள் சாட்சிகளைக் கொண்டுவரட்டும்;","poem":1},{"text":"அப்பொழுது மற்றவர்கள் அதைக்கேட்டு, “அது உண்மை” என்று சொல்லட்டும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“நீங்களே என் சாட்சிகளாயிருக்கிறீர்கள்” என்று யெகோவா அறிவிக்கிறார்.","poem":1},{"text":"“நீங்கள், நான் தெரிந்துகொண்ட என் ஊழியராய் இருக்கிறீர்கள்.","poem":2},{"text":"அதனால், நீங்கள் என்னை அறிந்து விசுவாசித்து,","poem":1},{"text":"நானே அவரென்று விளங்கிக்கொள்ளுவீர்கள்.","poem":2},{"text":"எனக்குமுன் ஒரு தெய்வம் உருவாக்கப்படவும் இல்லை,","poem":1},{"text":"எனக்குப்பின் எதுவும் இருக்கப்போவதுமில்லை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான், நானே யெகோவா,","poem":1},{"text":"என்னைத்தவிர வேறு இரட்சகர் இல்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நானே வெளிப்படுத்தினேன், இரட்சித்தேன், பிரசித்தப்படுத்தினேன்;","poem":1},{"text":"உங்கள் மத்தியிலிருக்கும் எந்த அந்நிய தெய்வமுமல்ல.","poem":2},{"text":"நானே இறைவன் என்பதற்கு நீங்களே எனது சாட்சிகள்” என்று யெகோவா அறிவிக்கிறார்.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"“ஆம், ஆதிநாட்களிலிருந்து நானே அவர்.","poem":2},{"text":"எனது கரத்திலிருந்து மக்களை விடுவித்துக்கொள்ள யாராலும் முடியாது.","poem":1},{"text":"நான் செயலாற்றும்போது அதை மாற்ற யாரால் முடியும்?”","poem":2}]},{"type":"heading","content":["இறைவனின் இரக்கம்"]},{"type":"verse","number":14,"content":[{"text":"உங்கள் மீட்பரும், இஸ்ரயேலின் பரிசுத்தருமாகிய","poem":1},{"text":"யெகோவா கூறுவது இதுவே:","poem":2},{"text":"“உங்கள் நிமித்தம் பாபிலோனுக்கு நான் இராணுவத்தை அனுப்பி,","poem":1},{"text":"பாபிலோனியர் அனைவரையும் அகதிகளாகக் கொண்டுவருவேன்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் பெருமைகொள்ளும் அவர்களுடைய கப்பல்களிலேயே அவர்களைக் கொண்டுவருவேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நானே யெகோவா, உங்கள் பரிசுத்தர்;","poem":1},{"text":"இஸ்ரயேலைப் படைத்தவரும், உங்கள் அரசனும் நானே.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"கடலிலே ஒரு வழியையும்,","poem":1},{"text":"பெரு வெள்ளத்திலே","poem":2},{"lineBreak":true},{"text":"ஒரு பாதையையும் உண்டாக்கியவர் அவரே;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"தேர்களையும் குதிரைகளையும்,","poem":1},{"text":"இராணுவத்தையும் படைவீரர்களையும் ஒன்றுகூட்டி வந்தவரும்,","poem":2},{"text":"அவர்கள் ஒருபோதும் திரும்பவும் எழுந்திருக்க முடியாமல் விழச்செய்து,","poem":1},{"text":"திரியை அணைப்பதுபோல் அவர்களை அழித்தவருமாகிய யெகோவா சொல்வது இதுவே:","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“முன்பு நடந்த காரியங்களை மறந்துவிடுங்கள்;","poem":1},{"text":"கடந்தகால நிகழ்வுகளைப் பற்றிச் சிந்திக்காதிருங்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இதோ, நான் ஒரு புதிய காரியத்தைச் செய்கிறேன்!","poem":1},{"text":"அது இப்போதே உண்டாகிறது; அது உங்களுக்குத் தெரியவில்லையா?","poem":2},{"text":"நான் பாலைவனத்தில் பாதையையும்,","poem":1},{"text":"பாழ்நிலத்தில் நீரூற்றுக்களையும் உண்டாக்குகிறேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நான் தெரிந்துகொண்ட என் மக்களுக்குக் குடிக்கக் கொடுப்பதற்கு","poem":1},{"text":"பாலைவனத்தில் தண்ணீரையும்,","poem":2},{"text":"பாழ்நிலத்தில் நீரோடைகளையும் நானே வழங்குகிறேன்.","poem":1},{"text":"அதனால், காட்டு மிருகங்களான குள்ளநரிகளும், நெருப்புக் கோழிகளும்","poem":2},{"text":"என்னை கனம்பண்ணும்.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"இந்த மக்களை எனது துதியைப் பிரசித்தப்படுத்தும்படி,","poem":2},{"lineBreak":true},{"text":"எனக்காக நானே உருவாக்கினேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“அப்படியிருந்தும், யாக்கோபே, நீ என்னை நோக்கிக் கூப்பிடவில்லை.","poem":1},{"text":"இஸ்ரயேலே, நீ எனக்காகப் பணிசெய்து களைக்கவுமில்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நீங்கள் தகனகாணிக்கைக்கு செம்மறியாடுகளை எனக்கென கொண்டுவரவுமில்லை;","poem":1},{"text":"உங்கள் பலிகளால் என்னைக் கனம்பண்ணவும் இல்லை.","poem":2},{"text":"நானோ எனக்குத் தானிய காணிக்கைகளைக் கொடுக்கும்படி","poem":1},{"text":"உங்களைக் கஷ்டப்படுத்தவும் இல்லை;","poem":2},{"lineBreak":true},{"text":"தூபங்காட்டும்படி நான் உங்களை வற்புறுத்தி சலிப்படையச் செய்யவுமில்லை.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நீங்கள் நறுமணப்பட்டை எதையும் எனக்கென வாங்கவுமில்லை;","poem":1},{"text":"உங்கள் பலிகளின் கொழுப்புகளை எனக்குத் தாராளமாய் தரவுமில்லை.","poem":2},{"text":"ஆனால், உங்கள் பாவங்களினால் என்னைப் பாரமடையச் செய்திருக்கிறீர்கள்;","poem":1},{"text":"உங்கள் குற்றங்களினால் என்னைச் சலிப்படையச் செய்திருக்கிறீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“நான், நானே உங்கள் மீறுதல்களை உங்களைவிட்டு நீக்குகிறேன்;","poem":1},{"text":"நான் உங்கள் பாவங்களை இனியொருபோதும் நினைவில் வைப்பதில்லை,","poem":2},{"lineBreak":true},{"text":"இதை நான் எனக்காகவே செய்கிறேன்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"கடந்த காலத்தை எனக்காக நினைத்துப் பாருங்கள்,","poem":1},{"text":"நாம் இந்த காரியத்தைப்பற்றி ஒன்றுகூடி வாதாடுவோம்;","poem":2},{"lineBreak":true},{"text":"நீங்கள் குற்றமற்றவர்கள் என்பதற்கு ஆதாரங்களைச் சொல்லுங்கள்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"உங்கள்","poem":1},{"noteId":21},{"text":"ஆதிமுற்பிதா பாவம் செய்தான்;","poem":1},{"text":"உங்களுக்காகப் பேசுகிறவர்களும் எனக்கு விரோதமாகக் கலகம் செய்தார்கள்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ஆகையால் நான் உங்கள் ஆலயத்தின் தலைவர்களை அவமானப்படுத்துவேன்;","poem":1},{"text":"யாக்கோபை அழிவுக்கும்,","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலை இகழ்ச்சிக்கும் ஒப்புக்கொடுப்பேன்.","poem":2}]}],"footnotes":[{"noteId":21,"caller":"+","text":"அல்லது யாக்கோபு; உபா. 26:5; ஓசி. 12:2-4.","reference":{"chapter":43,"verse":27}}]},"thisChapterLink":"/api/tam_tcv/ISA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/42.json","previousChapterAudioLinks":{},"numberOfVerses":28}