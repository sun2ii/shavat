{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":44,"content":[{"type":"heading","content":["தெரிந்துகொள்ளப்பட்ட இஸ்ரயேல்"]},{"type":"verse","number":1,"content":[{"text":"“ஆனால் இப்பொழுதோ என் அடியவனாகிய யாக்கோபே,","poem":1},{"text":"நான் தெரிந்துகொண்ட இஸ்ரயேலே, கேள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவா சொல்வது இதுவே:","poem":1},{"text":"உன்னை உண்டாக்கியவரும், உன்னைக் கருப்பையில் உருவாக்கியவரும்,","poem":2},{"lineBreak":true},{"text":"உனக்கு உதவிசெய்யப் போகிறவருமாகிய அவர் சொல்வதாவது:","poem":2},{"text":"என் அடியவனாகிய யாக்கோபே,","poem":1},{"text":"நான் தெரிந்துகொண்ட யெஷூரனே","poem":2},{"noteId":22},{"text":", பயப்படாதே.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் தாகமுள்ள நிலத்தில் தண்ணீரை ஊற்றுவேன்;","poem":1},{"text":"வறண்ட நிலத்தில் நீரோடைகளை உண்டாக்குவேன்.","poem":2},{"text":"உன் சந்ததியின்மேல் எனது ஆவியானவரையும்,","poem":1},{"text":"உன் பிள்ளைகள்மேல் என் ஆசீர்வாதத்தையும் ஊற்றுவேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் வெளிநிலத்திலுள்ள புல்லைப்போலவும்,","poem":1},{"text":"நீரோடைகளுக்கு அருகில் அலறிச்செடிகளைப் போலவும் விரைவாய் வளருவார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஒருவன், ‘நான் யெகோவாவுக்கு உரியவன்’ என்பான்;","poem":1},{"text":"வேறொருவன், தன்னை யாக்கோபின் பெயரால் அழைத்துக்கொள்வான்;","poem":2},{"text":"இன்னொருவன், தன் கையில், ‘கர்த்தருடையவன்’ என்று எழுதி,","poem":1},{"text":"இஸ்ரயேல் என்று பெயரிட்டுக்கொள்வான்.","poem":2}]},{"type":"heading","content":["யெகோவாவே, விக்கிரகங்கள் அல்ல"]},{"type":"verse","number":6,"content":[{"text":"“யெகோவா சொல்வது இதுவே:","poem":1},{"text":"இஸ்ரயேலின் அரசரும், மீட்பருமாகிய சேனைகளின் யெகோவா கூறுவதாவது,","poem":2},{"text":"ஆரம்பமும் நானே, முடிவும் நானே;","poem":1},{"text":"என்னையன்றி வேறு இறைவன் இல்லை","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என்னைப்போல் யாரும் உண்டோ?","poem":1},{"text":"அப்படியிருந்தால் அவன் அதைப் பிரசித்தம்பண்ணட்டும்.","poem":2},{"lineBreak":true},{"text":"அதை அறிவித்து எனக்குமுன் சொல்லட்டும்,","poem":2},{"text":"முற்காலத்திலிருந்த என் மக்களை நான் நிலைநிறுத்திய காலத்திலிருந்து","poem":1},{"text":"நடந்தவற்றையும் இனி என்ன நடக்கப்போகிறதையும் சொல்லட்டும்.","poem":2},{"lineBreak":true},{"text":"ஆம், நிகழப்போவதை அவன் முன்னறிவிக்கட்டும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நடுங்காதீர்கள், பயப்படாதீர்கள்.","poem":1},{"text":"இதை நான் வெகுகாலத்துக்கு முன்பே பிரசித்தப்படுத்தி, அறிவிக்கவில்லையா?","poem":2},{"text":"நீங்கள் எனது சாட்சிகள். என்னைத்தவிர வேறு இறைவன் உண்டோ?","poem":1},{"text":"இல்லை, வேறு கன்மலையும் இல்லை; அப்படி ஒருவரையும் நான் அறியேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"விக்கிரங்களை உருவாக்குகிறவர்கள் எல்லோரும் வீணர்;","poem":1},{"text":"அவர்கள் அருமையாகக் கருதுபவை பயனற்றவை.","poem":2},{"text":"அவைகளுக்காகப் பேசுபவர்களும் குருடர்;","poem":1},{"text":"அவர்கள் தங்களை வெட்கமாக்கிக்கொள்ளும் அறிவீனர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"தனக்கு ஒருவித பயனையும் தராத தெய்வத்தின் சிலைகளைச் செதுக்கி,","poem":1},{"text":"ஒரு விக்கிரகத்தை வார்ப்பிப்பவன் யார்?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவனும் அவனைப் போன்றவர்களும் வெட்கம் அடைவார்கள்;","poem":1},{"text":"அதைச் செய்யும் கைவினைஞர் மனிதரே.","poem":2},{"text":"அவர்கள் எல்லோரும் கூடிவந்து என்முன் நிற்கட்டும்;","poem":1},{"text":"அவர்கள் எல்லோரும் பயங்கரத்திற்கும், அவமானத்துக்கும் உள்ளாவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"கொல்லன் இரும்பைக் குறட்டால் எடுத்து,","poem":1},{"text":"கரி நெருப்பிலிட்டு உருக்கி,","poem":2},{"text":"சுத்தியலால் அடித்து விக்கிரகத்தை வடிவமைக்கிறான்;","poem":1},{"text":"தன் கையின் பெலத்தினால் அதற்கு உருவத்தைக் கொடுக்கிறான்.","poem":2},{"text":"பட்டினியினால் அவன் தன் பெலனை இழக்கிறான்,","poem":1},{"text":"தண்ணீரைக் குடிக்காமல் சோர்ந்துபோவான்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"தச்சன் கோலினால் மரத்தை அளந்து,","poem":1},{"text":"வெண்கட்டியால் குறியிடுகிறான்.","poem":2},{"text":"அவன் அதை உளிகளினால் உருப்படுத்தி,","poem":1},{"text":"கவராயத்தால் குறிக்கிறான்.","poem":2},{"text":"அவன் மனிதனின் எல்லாச் சிறப்பையும்","poem":1},{"text":"அதற்குக் கொடுத்து அதை மனித உருவில் வடிவமைக்கிறான்;","poem":2},{"lineBreak":true},{"text":"அது ஒரு கோவிலில் இருக்கும்படியே இப்படிச் செய்கிறான்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவன் கேதுரு மரங்களை வெட்டி வீழ்த்துகிறான்,","poem":1},{"text":"தேவதாரு மரங்களையும், கர்வாலி மரங்களையும் அவன் தனக்கென்று வைத்துக்கொள்கிறான்.","poem":2},{"text":"அதை அவன் காட்டு மரங்களின் மத்தியில் வளர விடுகிறான்;","poem":1},{"text":"அவன் சவுக்கு மரத்தை நாட்டுவான், மழை அதை வளரச் செய்கின்றது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அது மனிதனுக்கு எரிபொருளாக இருக்கிறது;","poem":1},{"text":"அவன் அவைகளில் ஒரு பகுதியை எடுத்து எரித்து குளிர்காய்கிறான்,","poem":2},{"lineBreak":true},{"text":"ஒரு பகுதியால் நெருப்புமூட்டி அப்பத்தை வேகவைக்கிறான்.","poem":2},{"text":"ஆனால் இன்னொரு பகுதியால் ஒரு தெய்வத்தையும் செய்து அதை வழிபடுகிறான்;","poem":1},{"text":"அவன் ஒரு விக்கிரகத்தையும் செய்து, அதற்குமுன் விழுந்து வணங்குகிறான்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"மரத்தின் ஒரு துண்டை அவன் நெருப்பில் எரிக்கிறான்;","poem":1},{"text":"அதின்மேல் தன் உணவைத் தயாரிக்கிறான்,","poem":2},{"lineBreak":true},{"text":"தன் இறைச்சியையும் வாட்டி, தான் திருப்தியாகச் சாப்பிடுகிறான்.","poem":2},{"text":"அவன் அதில் குளிர்காய்ந்துகொண்டும், “ஆகா! இந்தச் சூடு இதமானது!","poem":1},{"text":"அருமையான நெருப்பைக் காண்கின்றேன்” என்கிறான்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"எஞ்சிய மரத்தின் பகுதியில் விக்கிரகமொன்றைத் தனது தெய்வமாகச் செய்கிறான்;","poem":1},{"text":"அதற்குமுன் விழுந்து வழிபடுகிறான்.","poem":2},{"text":"அதை வணங்கி,","poem":1},{"text":"“நீயே என் தெய்வம், என்னைக் காப்பாற்று!” என்கிறான்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவற்றிற்கு ஒன்றுமே தெரியாது, அவற்றிற்கு ஒன்றும் விளங்குவதில்லை;","poem":1},{"text":"பார்க்க முடியாதபடி அவைகளின் கண்கள் மூடப்பட்டிருக்கின்றன;","poem":2},{"lineBreak":true},{"text":"விளங்கிக்கொள்ளாதபடி அவைகளின் இருதயமும் அடைக்கப்பட்டு இருக்கின்றன.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“இம்மரத்தின் பாதியை நான் எரிபொருளாய் உபயோகித்தேன்;","poem":1},{"text":"அதன் தணலின்மேல் ரொட்டியை வேகவைத்து, இறைச்சியையும் வாட்டிச் சாப்பிட்டேன்.","poem":2},{"text":"அப்படியிருக்க, எஞ்சிய பகுதியினால்","poem":1},{"text":"நான் அருவருக்கத்தக்க விக்கிரகத்தைச் செய்யலாமா?","poem":2},{"text":"ஒரு மரக்கட்டையின் முன்னால் நான் விழுந்து வணங்கலாமா?”","poem":1},{"text":"என்று சொல்லுவதற்கு எவனுமே சிந்திப்பதில்லை.","poem":2},{"text":"அதற்கான அறிவோ,","poem":1},{"text":"விளக்கமோ எவனிடத்திலும் இல்லை.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவன் சாம்பலைத் தின்கிறான், அவனுடைய வஞ்சிக்கப்பட்ட இருதயம்","poem":1},{"text":"அவனைத் தவறான வழியில் நடத்துகிறது.","poem":2},{"text":"அவன் தன்னைக் காப்பாற்றிக்கொள்ள இயலாது,","poem":1},{"text":"“எனது வலதுகையில் இருக்கிற இந்த விக்கிரகம் பொய்”","poem":2},{"lineBreak":true},{"text":"என்று சொல்லாமலும் இருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“யாக்கோபே, இவற்றை நீ நினைவில் வைத்துக்கொள்;","poem":1},{"text":"ஏனெனில் இஸ்ரயேலே, நீ என் அடியவன்.","poem":2},{"text":"நான் உன்னைப் படைத்தேன், நீ என் அடியவன்;","poem":1},{"text":"இஸ்ரயேலே, நான் உன்னை மறக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நான் உன் குற்றங்களை ஒரு மேகத்தைப் போலவும்","poem":1},{"text":"உன் பாவங்களை காலை நேரத்து மூடுபனியைப் போலவும் அகற்றியிருக்கிறேன்.","poem":2},{"text":"நீ என்னிடம் திரும்பி வா,","poem":1},{"text":"ஏனெனில் நான் உன்னை மீட்டிருக்கிறேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"வானங்களே, மகிழ்ந்து பாடுங்கள்; யெகோவாவே இதைச் செய்திருக்கிறார்.","poem":1},{"text":"கீழிருக்கும் பூமியே, உரத்த சத்தமிடு.","poem":2},{"text":"மலைகளே, காடுகளே, மரங்களே,","poem":1},{"text":"குதூகலித்துப் பாடுங்கள்.","poem":2},{"text":"ஏனெனில், யெகோவா யாக்கோபை மீட்டு,","poem":1},{"text":"இஸ்ரயேலில் தனது மகிமையை வெளிப்படுத்துகிறார்.","poem":2}]},{"type":"heading","content":["எருசலேம் குடியிருக்க வேண்டும்"]},{"type":"verse","number":24,"content":[{"text":"“உங்கள் மீட்பரும், உங்களை கருப்பையில் உருவாக்கியவருமான,","poem":1},{"text":"யெகோவா சொல்வது இதுவே:","poem":2},{"lineBreak":true},{"text":"“நானே யெகோவா,","poem":1},{"text":"நான் எல்லாவற்றையும் படைத்தேன்,","poem":2},{"lineBreak":true},{"text":"நான் தனியாகவே வானங்களை விரித்து,","poem":2},{"lineBreak":true},{"text":"பூமியையும் பரப்பினேன்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நானே கட்டுக்கதை சொல்பவர்கள் கூறும் அடையாளங்களை நிறைவேறாமல் செய்து,","poem":1},{"text":"குறிசொல்வோரை மூடர்களாக்கி,","poem":2},{"text":"ஞானிகளின் அறிவை வீழ்த்தி,","poem":1},{"text":"அவைகளை மூடத்தனமாக்குபவரும் நானே.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நானே எனது ஊழியர்களின் வார்த்தைகளை உறுதிபடுத்துகிறேன்;","poem":1},{"text":"எனது தூதுவர்களின் ஆலோசனைகளை நிறைவேற்றுகிறேன்.","poem":2},{"lineBreak":true},{"text":"“எருசலேமைப்பற்றி,","poem":1},{"text":"‘அது குடியிருப்பாக்கப்படும்’ என்றும்","poem":2},{"text":"யூதாவின் பட்டணங்களைப் பற்றி,","poem":1},{"text":"‘அவை கட்டப்படும்’ என்றும்,","poem":2},{"text":"அவர்களின் பாழிடங்களைப்பற்றி,","poem":1},{"text":"‘நான் மீண்டும் அவைகளைக் கட்டுவேன்,’ என்றும் கூறுகிறேன்,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நானே ஆழமான நீர்நிலைகளைப் பார்த்து, ‘வறண்டு போ,","poem":1},{"text":"உனது நீரூற்றுகளை நான் வற்றப்பண்ணுவேன்’ என்று சொல்கிறேன்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நானே கோரேசைப்பற்றி, ‘அவன் எனது மேய்ப்பன்;","poem":1},{"text":"எனது விருப்பம் எல்லாவற்றையும் நிறைவேற்றுவான்,","poem":2},{"text":"அவன் எருசலேமைப்பற்றி, “அது திரும்பவும் கட்டப்படட்டும்” என்றும்,","poem":1},{"text":"ஆலயத்தைப்பற்றி, “அதன் அஸ்திபாரங்கள் போடப்படட்டும்” என்றும் சொல்லுவான்’","poem":2},{"text":"என்று சொல்கிறேன்.”","poem":1}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":22,"caller":"+","text":"யெஷூரனே என்பது இஸ்ரயேல் எனப்படும்.","reference":{"chapter":44,"verse":2}}]},"thisChapterLink":"/api/tam_tcv/ISA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/43.json","previousChapterAudioLinks":{},"numberOfVerses":28}