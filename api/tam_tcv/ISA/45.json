{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":45,"content":[{"type":"verse","number":1,"content":[{"text":"“அபிஷேகம் செய்யப்பட்ட கோரேசைப்பற்றி யெகோவா சொல்கிறதாவது,","poem":1},{"text":"அவனுக்கு முன்பாக நாடுகளை அடக்கும்படியும்,","poem":2},{"text":"அரசர்களின் போர் ஆயுதங்களை களையப்பண்ணும்படியும்,","poem":1},{"text":"அவனுக்கு முன்பாக வாசல்கள் மூடாதபடி கதவுகள் திறக்கப் பண்ணும்படியும்","poem":2},{"text":"நான் அவனுடைய வலதுகையை தாங்கிப் பிடித்துக்கொண்டு,","poem":1},{"text":"அவனுக்குச் சொல்வதாவது:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் உனக்கு முன்சென்று,","poem":1},{"text":"மலைகளைத் தரைமட்டமாக்குவேன்;","poem":2},{"text":"நான் வெண்கலக் கதவுகளை உடைத்து,","poem":1},{"text":"இரும்புத் தாழ்ப்பாள்களையும் தகர்ப்பேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் இருளில் மறைத்து வைக்கப்பட்ட பொக்கிஷங்களையும்,","poem":1},{"text":"மறைவிடங்களில் சேகரிக்கப்பட்ட புதையல்களையும் உனக்குக் கொடுப்பேன்;","poem":2},{"text":"அப்பொழுது உன்னைப் பெயர்சொல்லி அழைத்த இஸ்ரயேலின் இறைவனாகிய யெகோவா நானே","poem":1},{"text":"என்பதை நீ அறிந்துகொள்வாய்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் அடியவன் யாக்கோபின் நிமித்தமும்,","poem":1},{"text":"நான் தெரிந்துகொண்ட இஸ்ரயேலின் நிமித்தமும்","poem":2},{"text":"நான் உன்னைப் பெயர்சொல்லி அழைத்து,","poem":1},{"text":"நீ என்னை ஏற்றுக்கொள்ளாத போதிலும்,","poem":2},{"lineBreak":true},{"text":"நான் உனக்குப் பெயரையும் புகழையும் வழங்கினேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நானே யெகோவா, வேறு எவருமில்லை;","poem":1},{"text":"என்னைத்தவிர இறைவனும் இல்லை.","poem":2},{"text":"நீ என்னை ஏற்றுக்கொள்ளாத போதிலும்,","poem":1},{"text":"நான் உன்னைப் பெலப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அப்பொழுது சூரியன் உதிக்கும் இடத்திலிருந்து,","poem":1},{"text":"அது மறையுமிடம் வரையுமுள்ள மனிதர் எல்லோரும்,","poem":2},{"text":"எனக்கிணையானவர் யாரும் இல்லை என்பதை அறிந்துகொள்வார்கள்.","poem":1},{"text":"நானே யெகோவா, வேறு யாரும் இல்லை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஒளியையும் இருளையும் படைக்கிறவர் நானே,","poem":1},{"text":"சமாதானத்தையும் கஷ்டங்களையும் ஏற்படுத்துகிறவரும் நானே;","poem":2},{"lineBreak":true},{"text":"நான் யெகோவா, நானே இவை எல்லாவற்றையும் செய்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“மேலேயுள்ள வானங்களே, நீதியைப் பொழியுங்கள்;","poem":1},{"text":"மேகங்கள் அதைப் பொழியட்டும்.","poem":2},{"text":"பூமி அகலமாய்த் திறந்து,","poem":1},{"text":"இரட்சிப்பின் கனியைத் தந்து,","poem":2},{"text":"நீதி அதனுடன் துளிர்க்கட்டும்;","poem":1},{"text":"யெகோவாவாகிய நானே அதைப் படைத்தேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“தன்னைப் படைத்தவருடன் வாதாடுபவனுக்கு ஐயோ, கேடு!","poem":1},{"text":"அவன் அவருக்கு முன்பாகத் தரையில் கிடக்கும் மண்ணோடுகளில் ஒரு ஓடுதானே.","poem":2},{"lineBreak":true},{"text":"களிமண் குயவனைப் பார்த்து, ‘நீ என்னத்தை உருவாக்குகிறாய்?’","poem":2},{"text":"எனக் கேட்கலாமோ?","poem":1},{"text":"நீ செய்யும் பொருள் உன்னிடம்,","poem":2},{"text":"‘உனக்குக் கைத்திறன் இல்லை’","poem":1},{"text":"என்று சொல்லலாமோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"தன் தகப்பனிடம், ‘நீ ஏன் என்னைப் பிறப்பித்தாய்?’ என்றும்,","poem":1},{"text":"தன் தாயிடம்,","poem":2},{"text":"‘நீ ஏன் என்னைப் பெற்றெடுத்தாய்?’","poem":1},{"text":"என்றும் கேட்பவனுக்கு ஐயோ, கேடு!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“இஸ்ரயேலின் பரிசுத்தரும், அதைப் படைத்தவருமாகிய","poem":1},{"text":"யெகோவா சொல்வது இதுவே;","poem":2},{"text":"இனி நடக்கப்போவதைக் குறித்து,","poem":1},{"text":"எனது பிள்ளைகளைப்பற்றி என்னிடம் கேள்வி கேட்கிறீர்களா?","poem":2},{"lineBreak":true},{"text":"எனது கைகளின் வேலையைப்பற்றி எனக்குக் கட்டளையிடுகிறீர்களா?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நானே பூமியை உருவாக்கி,","poem":1},{"text":"அதன்மேல் மனுமக்களையும் படைத்தேன்.","poem":2},{"text":"எனது சொந்தக் கரங்களே வானங்களை விரித்தன;","poem":1},{"text":"நட்சத்திர சேனைகளையும் நானே அதினதின் இடத்தில் நிலைநிறுத்தினேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் எனது நியாயத்தின்படி கோரேசை எழுப்புவேன்;","poem":1},{"text":"அவனுடைய வழிகளையெல்லாம் நேராக்குவேன்.","poem":2},{"text":"அவன் திரும்பவும் என் நகரத்தைக் கட்டுவான்,","poem":1},{"text":"நாடுகடத்தப்பட்ட எனது மக்களை விலையோ,","poem":2},{"text":"வெகுமானமோ பெறாமல் விடுதலையாக்குவான்”","poem":1},{"text":"என்று சேனைகளின் யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":14,"content":["யெகோவா இஸ்ரயேலுக்கு கூறுவதாவது:",{"text":"“எகிப்தின் உற்பத்திப் பொருட்களும்,","poem":1},{"text":"எத்தியோப்பியாவின் வியாபாரப் பொருட்களும் வரும்;","poem":2},{"lineBreak":true},{"text":"இவற்றுடன் வளர்த்தியில் உயரமான சபேயரும் உன்னிடம் வந்து,","poem":2},{"text":"உன்னுடையவர்கள் ஆவார்கள்.","poem":1},{"text":"அவர்கள் சங்கிலிகளால் கட்டப்பட்டு,","poem":2},{"text":"உன் பின்னால் வருவார்கள்.","poem":1},{"text":"அவர்கள் உன் முன்னால் விழுந்து வணங்கி,","poem":2},{"text":"‘இறைவன் நிச்சயமாகவே உன்னுடன் இருக்கிறார்;","poem":1},{"text":"அவரைத்தவிர வேறு எவருமில்லை.","poem":2},{"text":"வேறெந்த தெய்வமும் இல்லை’","poem":1},{"text":"என்று சொல்லி தங்களுக்கு இரங்கும்படி கேட்பார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"இஸ்ரயேலின் இரட்சகரும் இறைவனுமானவரே,","poem":1},{"text":"உண்மையாகவே உம்மை நீர் மறைத்துக்கொள்கிற இறைவன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"விக்கிரகங்களை உருவாக்கும் அனைவரும்","poem":1},{"text":"வெட்கமடைந்து அவமானத்திற்கு உள்ளாவார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் அனைவரும் ஒன்றாய் கலங்கிப் போவார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆனாலும் யெகோவாவினால்","poem":1},{"text":"இஸ்ரயேல் நித்திய இரட்சிப்புடன் பாதுகாக்கப்படும்.","poem":2},{"text":"நீங்கள் நித்திய காலங்களுக்கு வெட்கப்படாமலும்,","poem":1},{"text":"அவமானத்திற்கு உட்படாமலும் இருப்பீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"யெகோவா கூறுவதாவது:","poem":1},{"lineBreak":true},{"text":"அவர் வானங்களை உருவாக்கினார்,","poem":1},{"text":"அவரே இறைவன்;","poem":2},{"text":"அவர் பூமியை உருவமைத்துப் படைத்தார்;","poem":1},{"text":"அவரே அதை அமைத்தார்.","poem":2},{"text":"அது வெறுமையாயிருக்க அவர் படைக்கவில்லை,","poem":1},{"text":"குடியிருப்புக்காகவே அதை உருவாக்கினார்.","poem":2},{"text":"அவர் கூறுவதாவது:","poem":1},{"lineBreak":true},{"text":"“நானே யெகோவா,","poem":1},{"text":"என்னையன்றி வேறொருவருமில்லை.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இருளின் நாட்டில் எங்கேயாகிலும் இருந்து","poem":1},{"text":"நான் இரகசியமாய்ப் பேசவில்லை,","poem":2},{"text":"‘வீணாக என்னைத் தேடுங்கள்’","poem":1},{"text":"என்று நான் யாக்கோபின் வழித்தோன்றல்களுக்குச் சொல்லவுமில்லை;","poem":2},{"text":"நான் யெகோவா, உண்மையையே பேசுகிறவர்;","poem":1},{"text":"சரியானதையே நான் அறிவிக்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ஒன்றுசேர்ந்து வாருங்கள்;","poem":1},{"text":"பிற நாடுகளிலிருந்து வந்த அகதிகளே, ஒன்றுகூடுங்கள்.","poem":2},{"text":"மரச்சிலைகளைச் சுமந்து செல்வோரும்,","poem":1},{"text":"இரட்சிக்க முடியாத தெய்வங்களிடம் மன்றாடுகிறவர்களும் அறிவீனர்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"நடக்கப்போவது என்ன? சொல்லுங்கள்;","poem":1},{"text":"ஒன்றுகூடி ஆலோசித்து அதை அறிவியுங்கள்.","poem":2},{"text":"வெகுகாலத்திற்குமுன் இதை முன்னறிவித்தவர் யார்?","poem":1},{"text":"ஆதியிலிருந்தே அதை அறிவித்தவர் யார்?","poem":2},{"text":"அது யெகோவாவாகிய நான் அல்லவோ!","poem":1},{"text":"என்னையன்றி வேறே இறைவன் இல்லை.","poem":2},{"text":"நீதியான ஒரு இறைவன், ஒரு இரட்சகர்;","poem":1},{"text":"என்னையன்றி வேறொருவரில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“பூமியின் எல்லைகளிலுள்ளவர்களே,","poem":1},{"text":"நீங்கள் எல்லோரும் என்னிடமாகத் திரும்பி இரட்சிப்படையுங்கள்.","poem":2},{"lineBreak":true},{"text":"ஏனெனில், நானே இறைவன், வேறு ஒருவரும் இல்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"என்னைக்கொண்டே நான் ஆணையிட்டேன்,","poem":1},{"text":"இதை உத்தமத்தோடு எனது வாய் பேசியிருக்கிறது.","poem":2},{"lineBreak":true},{"text":"அந்த வார்த்தை ஒருபோதும் மாறாது:","poem":2},{"text":"ஒவ்வொரு முழங்காலும் எனக்கு முன்பாக முடங்கும்;","poem":1},{"text":"ஒவ்வொரு நாவும் என் பெயரிலேயே ஆணையிடும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"‘யெகோவாவிடம் மட்டுமே நீதியும் வல்லமையும் இருக்கிறது’","poem":1},{"text":"என்று என்னைப்பற்றி அவர்கள் சொல்வார்கள்.”","poem":2},{"text":"அவருக்கு எதிராக எழுந்த அனைவரும்","poem":1},{"text":"அவரிடம் வந்து வெட்கத்திற்கு உட்படுத்தப்படுவார்கள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஆனால் இஸ்ரயேலின் வழித்தோன்றல்கள் யாவரும்","poem":1},{"text":"யெகோவாவிடம் நீதியானவர்களாகக் காணப்பட்டு","poem":2},{"lineBreak":true},{"text":"மேன்மையடைவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/44.json","previousChapterAudioLinks":{},"numberOfVerses":25}