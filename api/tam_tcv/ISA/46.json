{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":46,"content":[{"type":"heading","content":["பாபிலோனின் தெய்வங்கள்"]},{"type":"verse","number":1,"content":[{"text":"பேல்","poem":1},{"noteId":23},{"text":"தெய்வம் தலை கவிழ்கிறது;","poem":1},{"text":"நேபோ தெய்வம் குப்புற விழுகிறது.","poem":2},{"text":"அவர்களுடைய விக்கிரகங்கள் சுமை சுமக்கும் மிருகங்களால் கொண்டு செல்லப்படுகின்றன;","poem":1},{"text":"ஊர்வலத்தில் சுமக்கப்பட்ட அந்த விக்கிரகங்கள்","poem":2},{"lineBreak":true},{"text":"இப்பொழுது களைத்துப்போன மிருகங்களுக்கு மிகவும் பாரமாயிருக்கின்றன.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவை ஒன்றாய் குப்புற விழுகின்றன.","poem":1},{"text":"அந்த உருவச்சிலைகள் தங்களைச் சுமக்கும் மிருகங்களைத் தப்புவிக்கும் ஆற்றலின்றி","poem":2},{"lineBreak":true},{"text":"தாங்களும் சிறைப்பட்டுப் போகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“யாக்கோபின் குடும்பமே, இஸ்ரயேல் குடும்பத்தில் எஞ்சியிருப்பவர்களே,","poem":1},{"text":"நீங்கள் அனைவரும் எனக்குச் செவிகொடுங்கள்;","poem":2},{"text":"நீங்கள் கருவில் உருவானதுமுதல் நான் உங்களைத் தாங்கினேன்,","poem":1},{"text":"நீங்கள் பிறந்ததுமுதல் நான் உங்களைச் சுமந்தேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீங்கள் முதிர்வயது அடைந்து, உங்களுக்கு நரைமயிர் உண்டாகும் காலத்திலும்,","poem":1},{"text":"உங்களைத் தாங்கப்போகிறவர் நானே.","poem":2},{"text":"உங்களைப் படைத்த நானே உங்களைச் சுமப்பேன்.","poem":1},{"text":"நானே உங்களைத் தாங்குவேன், நானே உங்களைக் காப்பாற்றுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“என்னை யாருக்கு ஒப்பிடுவீர்கள்? யாருக்கு சமமாக எண்ணுவீர்கள்?","poem":1},{"text":"என்னை ஒப்பிடுவதற்கு யாரை எனக்கு ஒப்பிடுவீர்கள்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"சிலர் தங்கள் பைகளிலிருந்து தங்கத்தை அள்ளிக்கொட்டி,","poem":1},{"text":"தராசுகளில் வெள்ளியை நிறுக்கிறார்கள்;","poem":2},{"text":"அதை ஒரு தெய்வமாகச் செய்யும்படி அவர்கள் ஒரு கொல்லனை கூலிக்கு அமர்த்துகிறார்கள்;","poem":1},{"text":"பின் அவர்கள் தாழ்ந்து வீழ்ந்து அதை வணங்குகிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அதைத் தமது தோள்களில் தூக்கிச் சுமக்கிறார்கள்.","poem":1},{"text":"அவர்கள் அதை அதற்குரிய இடத்தில் வைக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"அது அங்கேயே நிற்கிறது, அந்த இடத்திலிருந்து அதனால் நகரமுடியாது.","poem":2},{"text":"ஒருவன் அதை நோக்கி அழுதாலும் அது பதிலளிப்பதில்லை;","poem":1},{"text":"ஒருவனை அவனுடைய துன்பங்களிலிருந்து காப்பாற்ற அதனால் இயலாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“கலகக்காரரே, இதை நினைவில்கொள்ளுங்கள்.","poem":1},{"text":"இதை மனதில் பதித்து வையுங்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"முந்தி நிகழ்ந்த பூர்வீகக் காரியங்களை நினைத்துப் பாருங்கள்;","poem":1},{"text":"நானே இறைவன், வேறொருவர் இல்லை;","poem":2},{"lineBreak":true},{"text":"நானே இறைவன், என்னைப்போல் ஒருவரும் இல்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் ஆரம்பத்திலிருந்தே முடிவை அறிவிக்கிறவர்,","poem":1},{"text":"முற்காலங்களிலேயே வரப்போகிறதை அறிவிக்கின்றவர்.","poem":2},{"text":"‘என் நோக்கம் நிலைநிற்கும்;","poem":1},{"text":"நான் விரும்பிய எல்லாவற்றையும் நிறைவேற்றுவேன்’ என்று நான் சொல்கிறேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான் கிழக்கிலிருந்து இரைதேடும் பறவையை அழைப்பிக்கின்றேன்.","poem":1},{"text":"தூரதேசத்திலிருந்து என் நோக்கத்தை நிறைவேற்றும் ஒரு மனிதனை அழைப்பிக்கின்றேன்.","poem":2},{"text":"நான் என்ன சொன்னேனோ அதை நிறைவேற்றுவேன்;","poem":1},{"text":"நான் எதைத் திட்டமிட்டேனோ அதைச் செய்வேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பிடிவாத இருதயமுள்ள நீதிக்குத் தூரமானவர்களே!","poem":1},{"text":"எனக்குச் செவிகொடுங்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நானே எனது நீதியை அருகில் கொண்டுவருகிறேன்,","poem":1},{"text":"அது வெகுதூரத்தில் இல்லை;","poem":2},{"lineBreak":true},{"text":"எனது இரட்சிப்பு தாமதம் அடையாது.","poem":2},{"text":"நான் சீயோனுக்கு இரட்சிப்பையும்,","poem":1},{"text":"இஸ்ரயேலுக்கு எனது சிறப்பையும் கொடுப்பேன்.","poem":2}]}],"footnotes":[{"noteId":23,"caller":"+","text":"பேல் பாபிலோனின் பிரதான கடவுள்களில் ஒன்று. அது மர்துக் என்றும் அழைக்கப்படும். நேபோ மற்றொன்று; அது மர்துக்கின் மகன்.","reference":{"chapter":46,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/ISA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/45.json","previousChapterAudioLinks":{},"numberOfVerses":13}