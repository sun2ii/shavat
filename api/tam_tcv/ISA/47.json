{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":47,"content":[{"type":"heading","content":["பாபிலோனின் வீழ்ச்சி"]},{"type":"verse","number":1,"content":[{"text":"“பாபிலோனின் கன்னிப்பெண்ணே, நீ கீழேபோய் புழுதியில் உட்கார்ந்துகொள்.","poem":1},{"text":"கல்தேயரின் மகளே,","poem":2},{"text":"அரியணை அற்றவளாய்","poem":1},{"text":"தரையில் உட்கார்ந்துகொள்.","poem":2},{"text":"நீ இனி மிருதுவானவள் என்றோ மென்மையானவள்","poem":1},{"text":"என்றோ அழைக்கப்படுவதில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"திரிகைக் கற்களை எடுத்து மாவரை;","poem":1},{"text":"உனது முக்காட்டை எடுத்துவிடு.","poem":2},{"text":"உனது பாவாடைகளை உயர்த்தி, கால்களை வெறுமையாக்கி,","poem":1},{"text":"நீரோடைகளைக் கடந்துபோ.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உனது நிர்வாணம் வெளிப்படுத்தப்படும்;","poem":1},{"text":"உன்னுடைய வெட்கம் திறந்து காட்டப்படும்.","poem":2},{"text":"நான் பழிவாங்குவேன்;","poem":1},{"text":"நான் ஒருவரையும் தப்பவிடமாட்டேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"இஸ்ரயேலின் பரிசுத்தரே நமது மீட்பர்;","poem":1},{"text":"சேனைகளின் யெகோவா என்பதே அவரது பெயர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“பாபிலோனியர்களின் மகளே,","poem":1},{"text":"இருளுக்குள் போய் மவுனமாய் அமர்ந்திரு;","poem":2},{"text":"நீ இனி ஒருபோதும்","poem":1},{"text":"அரசுகளுக்கு அரசி என அழைக்கப்படமாட்டாய்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் எனது மக்களுடன் கோபங்கொண்டு","poem":1},{"text":"எனது உரிமைச்சொத்தாய் இருக்கிறவர்களை","poem":2},{"text":"தூய்மைக்கேடு அடையச் செய்தேன்.","poem":1},{"text":"அவர்களை உனது கையில் ஒப்படைத்தேன்;","poem":2},{"text":"நீயோ அவர்களுக்கு இரக்கம் காட்டவில்லை,","poem":1},{"text":"முதியோர்மேலும் மிகவும் பாரமான நுகத்தை வைத்தாய்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‘தொடர்ந்து நான் என்றென்றும்","poem":1},{"text":"அரசியாக நிலைத்திருப்பேன்!’ என்று நீ சொன்னாய்.","poem":2},{"text":"ஆனால் நீ இந்தக் காரியங்களைப் பற்றி சிந்திக்கவுமில்லை;","poem":1},{"text":"என்ன நடக்குமென நீ எண்ணிப்பார்க்கவுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“இப்பொழுதோ ஒழுக்கங்கெட்டவளே,","poem":1},{"text":"நீ பாதுகாப்பாக சொகுசாக இருந்து,","poem":2},{"text":"‘நானே பெரும் அரசி, எனக்கு நிகர் யாரும் இல்லை.","poem":1},{"text":"நான் விதவையாகவோ,","poem":2},{"text":"அல்லது பிள்ளைகளை இழந்து துன்பப்படுகிறவளாகவோ ஆகமாட்டேன்’","poem":1},{"text":"என்று உன் உள்ளத்தில் சொல்லிக்கொள்கிறாய்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இவை இரண்டும் ஒரே நாளில்,","poem":1},{"text":"ஒரே நேரத்தில் உன்னை மேற்கொள்ளும்:","poem":2},{"lineBreak":true},{"text":"நீ பிள்ளைகளை இழந்து, விதவையாவாய்.","poem":2},{"text":"உனக்கு எண்ணற்ற மந்திர வித்தைகள் தெரிந்தும்,","poem":1},{"text":"வசீகர சக்திகள் இருந்தும்","poem":2},{"lineBreak":true},{"text":"அவை முழுமையாக உன்மேல் வரும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீ உனது கொடுமையில் நம்பிக்கையாயிருந்து,","poem":1},{"text":"‘ஒருவரும் என்னைக் காண்பதில்லை’ என்று சொல்லிக்கொள்கிறாய்.","poem":2},{"text":"நீ உன் உள்ளத்தில்","poem":1},{"text":"‘நான்தான், எனக்கு நிகர் யாருமே இல்லை’ என்று சொல்லும்போது,","poem":2},{"lineBreak":true},{"text":"உன் ஞானமும் உன் அறிவும் உன்னைத் தவறான வழியில் நடத்துகின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பேராபத்து உன்மேல் வரும்,","poem":1},{"text":"அதை மந்திர வித்தையால் எப்படி அகற்றுவது என நீ அறியமாட்டாய்;","poem":2},{"text":"உன்மேல் பெரும் துன்பம் வரும்,","poem":1},{"text":"எதை ஈடாகக் கொடுத்தும் அதை உன்னால் தவிர்த்துக் கொள்ளமுடியாது.","poem":2},{"text":"நீ முன்னதாகவே அறிந்துகொள்ள முடியாத","poem":1},{"text":"ஒரு பேரழிவு உன்மேல் திடீரென வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“நீ தொடர்ந்து உன் மந்திரங்களைச் சொல்லு,","poem":1},{"text":"பலவிதமான உன் மாந்திரீக வேலைகளில் ஈடுபடு;","poem":2},{"lineBreak":true},{"text":"இதைத்தான் உன் சிறுவயதிலிருந்தே நீ செய்கிறாய்.","poem":2},{"text":"அதனால் ஒருவேளை நீ வெற்றி பெறலாம்,","poem":1},{"text":"ஒருவேளை நீ பயங்கரத்தைக் கொண்டுவரலாம்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீ பெற்றுக்கொண்ட ஆலோசனை எல்லாம் உனக்குச் சோர்வையே உண்டாக்கியது;","poem":1},{"text":"உன்னுடைய சோதிடர்களும்","poem":2},{"text":"நட்சத்திரங்களைப் பார்த்து, மாதந்தோறும் இராசிபலன் கூறுகிறவர்களும் எழும்பி,","poem":1},{"text":"உனக்கு நேரிடப் போவதிலிருந்து உன்னைக் காப்பாற்றட்டும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"உண்மையாகவே அவர்கள் அறுவடை செய்த பயிரின் தாளடியைப்போல் இருக்கிறார்கள்;","poem":1},{"text":"நெருப்பு அவர்களைச் சுட்டெரிக்கும்.","poem":2},{"text":"நெருப்புச் சுவாலையிலிருந்து","poem":1},{"text":"தங்களையே விடுவித்துக்கொள்ள அவர்களால் முடியாது.","poem":2},{"text":"அது குளிர்காயக்கூடிய தணலாகவோ,","poem":1},{"text":"அருகில் உட்காரத்தக்க நெருப்பாகவோ இருக்காது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"உன் சிறுவயதுமுதல் நீ ஈடுபட்டுத் தொடர்புகொண்டிருந்த,","poem":1},{"text":"மந்திரவாதிகளினால் இவற்றை மட்டுமே","poem":2},{"lineBreak":true},{"text":"உனக்குச் செய்யமுடியும்.","poem":2},{"text":"அவர்களில் ஒவ்வொருவனும் தனது தவறான வழியிலேயே போகிறான்;","poem":1},{"text":"உன்னைக் காப்பாற்றக் கூடியவன் எவனுமே இல்லை.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/46.json","previousChapterAudioLinks":{},"numberOfVerses":15}