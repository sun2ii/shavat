{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":48,"content":[{"type":"heading","content":["பிடிவாதமுள்ள இஸ்ரயேல்"]},{"type":"verse","number":1,"content":[{"text":"“யாக்கோபின் குடும்பத்தாரே, இதைக் கேளுங்கள்.","poem":1},{"text":"இஸ்ரயேலின் பெயரால் அழைக்கப்படுகிறவர்களே,","poem":2},{"lineBreak":true},{"text":"யூதாவின் வம்சத்திலிருந்து வந்தவர்களே,","poem":2},{"text":"யெகோவாவின் பெயரினால் ஆணையிடுகிறவர்களே, கேளுங்கள்;","poem":1},{"text":"நீங்கள் இஸ்ரயேலின் இறைவனை வழிபடுகிறவர்கள்;","poem":2},{"lineBreak":true},{"text":"ஆயினும், நீங்கள் உண்மையுடனும், நீதியுடனும் அப்படிச் செய்யவில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீங்கள் உங்களைப் பரிசுத்த நகரத்தின் குடிமக்களென்று சொல்லி,","poem":1},{"text":"இஸ்ரயேலின் இறைவனைச் சார்ந்திருக்கிறீர்கள்;","poem":2},{"lineBreak":true},{"text":"சேனைகளின் யெகோவா என்பது அவரது பெயர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"முற்காலத்துக் காரியங்களை முன்கூட்டியே நான் உங்களுக்கு முன்னறிவித்தேன்;","poem":1},{"text":"எனது வாய் அவைகளை அறிவித்தது, நானே அவைகளைத் தெரியப்படுத்தினேன்.","poem":2},{"lineBreak":true},{"text":"பின்பு திடீரென நான் செயலாற்ற அவை நிறைவேறிற்று.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீ எவ்வளவு பிடிவாதமுள்ளவனாயிருந்தாய் என்றும்,","poem":1},{"text":"உன் கழுத்தின் தசைநார் இரும்பு என்றும்,","poem":2},{"lineBreak":true},{"text":"உன் நெற்றி வெண்கலமென்றும் நான் அறிந்திருந்தேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆகையால் அவைகளை வெகுகாலத்திற்கு முன்னமே உனக்கு அறிவித்தேன்;","poem":1},{"text":"அவை நடைபெறும் முன்பே அவைகளை உனக்குக் கூறினேன்.","poem":2},{"text":"ஆதலால், ‘எனது விக்கிரகங்களே இவற்றைச் செய்தன;","poem":1},{"text":"எனது மரச்சிலையும், உலோகச் சிலையுமே இவற்றைத் திட்டமிட்டன’","poem":2},{"lineBreak":true},{"text":"என்று நீ சொல்லமுடியாது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இவற்றை நீ கேட்டிருக்கிறாய்; இவை எல்லாவற்றையும் கவனி.","poem":1},{"text":"இவற்றை நீ அறிவிக்கமாட்டாயோ?","poem":2},{"lineBreak":true},{"text":"“இதுமுதல் புதிய காரியங்களை நான் உனக்குச் சொல்வேன்,","poem":1},{"text":"இவைகளோ நீ அறியாத மறைவான காரியங்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவை வெகுகாலத்திற்கு முன்பு அல்ல, இப்பொழுதுதான் உருவாக்கப்படுகின்றன;","poem":1},{"text":"நீ இதற்குமுன் அவைகளைப்பற்றிக் கேள்விப்பட்டிருக்கவில்லை.","poem":2},{"text":"ஆகவே, ‘ஆம், நான் அவைகளை அறிந்திருந்தேன்’","poem":1},{"text":"என்று உன்னால் சொல்லமுடியாது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீ கேள்விப்படவுமில்லை, அறியவுமில்லை;","poem":1},{"text":"முந்திய காலத்திலிருந்தே உன் செவிகள் திறக்கப்பட்டிருக்கவில்லை.","poem":2},{"text":"நீ எவ்வளவு துரோகி,","poem":1},{"text":"பிறப்பிலிருந்தே நீ கலகக்காரன்; இதை நான் நன்கு அறிவேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் என் பெயரின் நிமித்தமாகவே எனது கடுங்கோபத்தைத் தாமதமாக்குகிறேன்;","poem":1},{"text":"எனது புகழ்ச்சியின் நிமித்தமாகவே உன்னில் பொறுமையாயிருக்கிறேன்;","poem":2},{"lineBreak":true},{"text":"நீ அழிந்துபோகாதபடிக்கு எனது கோபத்தை உன்மேல் வரவிடாதிருக்கிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இதோ, நான் உன்னைப் புடமிட்டுச் சுத்திகரித்தேன், ஆயினும் வெள்ளியைப்போலல்ல;","poem":1},{"text":"உபத்திரவத்தின் சூளையிலே உன்னைச் சோதித்துப்பார்த்தேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் நிமித்தமாக, என் நிமித்தமாகவே இதை நான் செய்கிறேன்.","poem":1},{"text":"என் பெயர் களங்கப்பட நான் எப்படி இடமளிப்பேன்?","poem":2},{"lineBreak":true},{"text":"என் மகிமையை நான் வேறொருவருக்கும் கொடுக்கமாட்டேன்.","poem":2}]},{"type":"heading","content":["இஸ்ரயேலுக்கு சுதந்திரம்"]},{"type":"verse","number":12,"content":[{"text":"“யாக்கோபே, நான் அழைத்த இஸ்ரயேலே,","poem":1},{"text":"எனக்குச் செவிகொடு,","poem":2},{"text":"நானே அவர்;","poem":1},{"text":"ஆரம்பமும் முடிவும் நானே.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"என் சொந்தக் கரமே பூமியின் அஸ்திபாரங்களை அமைத்தது;","poem":1},{"text":"என் வலதுகரம் வானங்களை விரித்தது;","poem":2},{"text":"நான் அவைகளை அழைப்பிக்கின்றபோது,","poem":1},{"text":"அவை ஒன்றாய் எழுந்து நிற்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“நீங்கள் எல்லோரும் ஒன்றாய் கூடிவந்து, நான் சொல்வதைக் கேளுங்கள்:","poem":1},{"text":"உங்கள் விக்கிரகங்களில் எது இந்தக் காரியங்களை முன்னறிவித்தது?","poem":2},{"text":"யெகோவாவுக்குப் பிரியமானவன்","poem":1},{"text":"அவருடைய நோக்கத்தை, பாபிலோனுக்கு விரோதமாக நிறைவேற்றுவான்;","poem":2},{"lineBreak":true},{"text":"அவனுடைய கை பாபிலோனியர்களுக்கு விரோதமானதாகவே இருக்கும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான், நானே பேசினேன்;","poem":1},{"text":"மெய்யாகவே நான் அவனை அழைத்தேன்.","poem":2},{"text":"நான் அவனைக் கொண்டுவருவேன்,","poem":1},{"text":"அவன் தன்னுடைய பணியில் வெற்றிபெறுவான்.","poem":2}]},{"type":"verse","number":16,"content":["“நீங்கள் என் அருகே வந்து இதைக் கேளுங்கள்:",{"text":"“முதல் அறிவிப்பிலிருந்தே நான் இரகசியமாய்ப் பேசவில்லை;","poem":1},{"text":"அது நடைபெற்ற காலத்தில் நான் அங்கு இருக்கிறேன்.”","poem":2},{"lineBreak":true},{"text":"இப்பொழுது ஆண்டவராகிய யெகோவா தமது","poem":1},{"text":"ஆவியானவருடன் என்னை அனுப்பியிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"யெகோவா சொல்வது இதுவே,","poem":1},{"text":"இஸ்ரயேலரின் பரிசுத்தராகிய உங்கள் மீட்பர் சொல்கிறதாவது:","poem":2},{"text":"“உங்கள் இறைவனாகிய யெகோவா நானே,","poem":1},{"text":"மிக நன்மையானவற்றை உங்களுக்குக் போதிக்கிறவர் நானல்லவா?","poem":2},{"lineBreak":true},{"text":"நீங்கள் போகவேண்டிய பாதையில் உங்களை வழிநடத்துகிறவர் நானல்லவா?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"என்னுடைய கட்டளைகளுக்கு நீங்கள் கவனம் செலுத்தியிருந்தால்,","poem":1},{"text":"உங்களுடைய சமாதானம் நதியைப்போல் இருந்திருக்கும்;","poem":2},{"lineBreak":true},{"text":"உங்களுடைய நீதி கடலின் அலைகளைப்போல இருந்திருக்கும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"உங்கள் சந்ததிகள் மணலைப்போல் இருந்திருப்பார்கள்;","poem":1},{"text":"உங்களுடைய பிள்ளைகள் அந்த மணலின் எண்ணற்ற துகள்களைப்போல இருந்திருப்பார்கள்;","poem":2},{"text":"அவர்களுடைய பெயர்கள் என் முன்னிலையில் இருந்து நீங்காமலும்,","poem":1},{"text":"அழிக்கப்படாமலும் இருந்திருக்கும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"பாபிலோனைவிட்டு வெளியேறுங்கள்,","poem":1},{"text":"பாபிலோனியர்களை விட்டுத் தப்பியோடுங்கள்!","poem":2},{"text":"ஆனந்த சத்தமிட்டு அதை அறிவித்துப்","poem":1},{"text":"பிரசித்தப்படுத்துங்கள்!","poem":2},{"text":"யெகோவா தனது பணியாளன் யாக்கோபை மீட்டிருக்கிறார் என்று சொல்லி,","poem":1},{"text":"அந்தச் செய்தியைப் பூமியின் கடைசி எல்லைவரை அனுப்புங்கள்;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர் அவர்களை பாலைவனத்தின் வழியாக வழிநடத்தியபோது, அவர்கள் தாகமடையவில்லை;","poem":1},{"text":"அவர் அவர்களுக்காக கற்பாறையிலிருந்து தண்ணீரைப் பாயச்செய்தார்.","poem":2},{"text":"அவர் பாறையைப் பிளந்தார்,","poem":1},{"text":"தண்ணீர் பொங்கி வழிந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“கொடுமையானவர்களுக்கு சமாதானம் இல்லை” என்று யெகோவா சொல்கிறார்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/47.json","previousChapterAudioLinks":{},"numberOfVerses":22}