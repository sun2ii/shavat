{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":49,"content":[{"type":"heading","content":["யெகோவாவின் ஊழியன்"]},{"type":"verse","number":1,"content":[{"text":"தீவுகளே, நீங்கள் எனக்குச் செவிகொடுங்கள்;","poem":1},{"text":"தூரத்திலுள்ள நாடுகளே, நீங்கள் இதைக் கேளுங்கள்:","poem":2},{"text":"நான் கர்ப்பத்திலிருந்தபோதே யெகோவா என்னை அழைத்தார்;","poem":1},{"text":"என் தாயின் வயிற்றில் இருக்கும்போதே என் பெயரைச் சொல்லி கூப்பிட்டார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர் எனது வாயை ஒரு கூரிய வாளைப்போல் ஆக்கினார்,","poem":1},{"text":"தமது கரத்தின் நிழலிலே என்னை மறைத்தார்;","poem":2},{"text":"என்னைக் கூர்மையான அம்பாக்கி,","poem":1},{"text":"தமது அம்பாறத் துணியில் மறைத்து வைத்தார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“இஸ்ரயேலே, நீ என் ஊழியக்காரன்,","poem":1},{"text":"எனது சிறப்பை உன்னிலே வெளிப்படுத்துவேன்” என்று அவர் என்னிடம் சொன்னார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால் நானோ, “வீணாக உழைக்கிறேன்;","poem":1},{"text":"எனது பெலனை பயனற்றவற்றிற்கும் வீணானவற்றிற்கும் செலவழிக்கிறேன்.","poem":2},{"text":"அப்படியிருந்தும், எனக்குரியது யெகோவாவின் கையிலே இருக்கிறது;","poem":1},{"text":"என்னுடைய வெகுமதியும் எனது இறைவனிடமே இருக்கிறது” என்றேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இப்பொழுது யெகோவா சொல்வதாவது:","poem":1},{"text":"யாக்கோபைத் தன்னிடம் திரும்பக் கொண்டுவரும்படியாகவும்,","poem":2},{"text":"இஸ்ரயேலர்களைத் தன்னிடம் கூட்டிச் சேர்க்கும்படியாகவும்","poem":1},{"text":"அவருடைய பணியாளனாய் இருக்கும்படி என்னைக் கருப்பையில் உருவாக்கியவர் அவரே.","poem":2},{"text":"யெகோவாவினுடைய பார்வையில் நான் கனம் பெற்றேன்;","poem":1},{"text":"என் இறைவனே என் பெலனாயிருக்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் சொல்வதாவது:","poem":1},{"lineBreak":true},{"text":"“யாக்கோபின் கோத்திரங்களைப் பழைய நிலைக்குக் கொண்டுவருவதற்காகவும்,","poem":1},{"text":"இஸ்ரயேலில் நான் மீதியாக வைத்திருப்பவர்களைத் திரும்பக் கொண்டுவருவதற்காகவும்,","poem":2},{"lineBreak":true},{"text":"நீர் மட்டும் பணியாளனாய் இருப்பது போதுமானதல்லவே.","poem":2},{"text":"ஆகவே நான் உம்மைப் பிற நாட்டு மக்களுக்கும் ஒரு வெளிச்சமாக ஏற்படுத்துவேன்;","poem":1},{"text":"எனவே நீர் பூமியின் கடைசியில் இருக்கிறவர்களுக்கெல்லாம்","poem":2},{"lineBreak":true},{"text":"என் இரட்சிப்பைக் கொண்டுவருவீர்” என்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"இஸ்ரயேலரின் பரிசுத்தரும், மீட்பருமான யெகோவா சொல்வது இதுவே:","poem":1},{"text":"அவமதிக்கப்பட்டு, நாடுகளால் அருவருக்கப்பட்டு,","poem":2},{"text":"ஆட்சியாளர்களுக்கு அடிமையாய் இருந்த உனக்குச் சொல்வதாவது,","poem":1},{"text":"“அரசர்கள் உன்னைக் காணும்போது அவர்கள் எழுந்து நிற்பார்கள்,","poem":2},{"text":"பிரபுக்கள் உன்னைக் கண்டு வணங்குவார்கள்;","poem":1},{"text":"யெகோவா உண்மையுள்ளவராய் இருப்பதாலும்,","poem":2},{"text":"இஸ்ரயேலின் பரிசுத்தர் உன்னைத் தெரிந்துகொண்டதினாலும்","poem":1},{"text":"அவர்கள் இப்படிச் செய்வார்கள்.”","poem":2}]},{"type":"heading","content":["இஸ்ரயேல் புதுப்பிக்கப்படுதல்"]},{"type":"verse","number":8,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“என் தயவின் காலத்திலே நான் உங்களுக்குப் பதிலளிப்பேன்,","poem":1},{"text":"இரட்சிப்பின் நாளில் நான் உங்களுக்கு உதவி செய்வேன்;","poem":2},{"text":"நான் உங்களைப் பாதுகாத்து,","poem":1},{"text":"மக்களிடையே நீங்கள் ஒரு உடன்படிக்கையாக இருக்கும்படி நான் உங்களை ஏற்படுத்துவேன்.","poem":2},{"text":"நாட்டைப் புதுப்பித்து பழைய நிலைக்குக் கொண்டுவரவும்,","poem":1},{"text":"பாழடைந்த உரிமைச் சொத்துக்களைத் திரும்ப ஒப்படைக்கவும்,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"சிறைப்பட்டிருக்கிறவர்களைப் பார்த்து,","poem":1},{"text":"‘புறப்பட்டுப் போங்கள்’ என்று சொல்லவும்,","poem":2},{"text":"இருளில் உள்ளவர்களைப் பார்த்து, ‘வெளிப்படுங்கள்!’","poem":1},{"text":"என்றும் சொல்லவும் இப்படிச் செய்வேன்.","poem":2},{"lineBreak":true},{"text":"“வீதிகளின் ஓரங்களில் அவர்கள் மேய்வார்கள்;","poem":1},{"text":"வறண்ட குன்றுகள் ஒவ்வொன்றிலும் அவர்கள் மேய்ச்சல் நிலத்தைக் காண்பார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் பசியடைவதுமில்லை, தாகங்கொள்வதுமில்லை;","poem":1},{"text":"பாலைவன வெப்பமோ, வெயிலோ அவர்களைத் தாக்காது.","poem":2},{"text":"அவர்கள்மேல் இரக்கமாயிருக்கிறவரே அவர்களுக்கு வழிகாட்டி,","poem":1},{"text":"அவர்களைத் தண்ணீர் ஊற்றுகளின் அருகே வழிநடத்திச் செல்வார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எனது எல்லா மலைகளையும் நான் வழிகளாக மாற்றுவேன்;","poem":1},{"text":"எனது பெரும் பாதைகள் உயர்த்தப்படும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இதோ, அவர்கள் தூரத்திலிருந்து வருவார்கள்,","poem":1},{"text":"சிலர் வடக்கிலிருந்தும், சிலர் மேற்கிலிருந்தும்,","poem":2},{"lineBreak":true},{"text":"சிலர் சீனீம்","poem":2},{"noteId":24},{"text":"பிரதேசத்திலிருந்தும் வருவார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"வானங்களே, ஆனந்த சத்தமிடுங்கள்;","poem":1},{"text":"பூமியே, சந்தோஷப்படு;","poem":2},{"lineBreak":true},{"text":"மலைகளே, கெம்பீரமாய்ப் பாடுங்கள்!","poem":2},{"text":"யெகோவா தமது மக்களைத் தேற்றுகிறார்,","poem":1},{"text":"துன்புற்ற தம்முடையவர்கள்மேல் இரக்கம் காட்டுவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஆனால் சீயோனோ, “யெகோவா என்னைக் கைவிட்டுவிட்டார்;","poem":1},{"text":"யெகோவா என்னை மறந்துவிட்டார்” என்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“தான் பாலூட்டும் தன்னுடைய குழந்தையை எந்தத் தாயும் மறந்துபோவாளோ?","poem":1},{"text":"கருவில் உருவான தனது பிள்ளைக்கு அவள் கருணை காட்டாதிருப்பாளோ?","poem":2},{"text":"அப்படி அவள் மறந்தாலுங்கூட,","poem":1},{"text":"நான் உன்னை மறப்பதில்லை.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"இதோ, நான் என் உள்ளங்கைகளில் உன்னை வரைந்திருக்கிறேன்;","poem":1},{"text":"உன் மதில்கள் எப்பொழுதும் என் கண்முன் இருக்கின்றன.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"உனது பிள்ளைகள் விரைந்து திரும்புவார்கள்","poem":1},{"noteId":25},{"text":",","poem":1},{"text":"உன்னை அழித்தவர்கள் உன்னைவிட்டு விலகிப் போவார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உன் கண்களை உயர்த்திச் சுற்றிலும் பார்;","poem":1},{"text":"உனது பிள்ளைகள் யாவரும் ஒன்றுகூடி உன்னிடம் வருகிறார்கள்.","poem":2},{"text":"நான் வாழ்வது நிச்சயமாய் இருப்பதுபோலவே,","poem":1},{"text":"நீ அவர்களையெல்லாம் நகைகளாய் அணிந்துகொள்வாய்;","poem":2},{"lineBreak":true},{"text":"மணமகளைப்போல் அவர்களை அணிந்துகொள்வாய்” என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“நீ அழிக்கப்பட்டு பாழாக்கப்பட்டாய்,","poem":1},{"text":"உனது நாடு பாழாய் விடப்பட்டது.","poem":2},{"text":"ஆயினும் இப்பொழுதோ உன்னில் குடியிருக்கிறவர்கள்","poem":1},{"text":"வாழ்வதற்கு இடம் போதாதபடி நீ சிறிதாய் இருப்பாய்.","poem":2},{"lineBreak":true},{"text":"உன்னை விழுங்கியவர்களும் உன்னைவிட்டுத் தூரமாய் போவார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"உன் இழப்பில் துயருற்ற நாட்களில்","poem":1},{"text":"உனக்குப் பிறந்த பிள்ளைகள் உன்னைப் பார்த்து,","poem":2},{"lineBreak":true},{"text":"‘இந்த இடம் எங்களுக்கு மிகச் சிறிதாக இருக்கிறது;","poem":2},{"text":"நாங்கள் வசிப்பதற்கு போதிய இடம் தாரும்’","poem":1},{"text":"என உன் செவிகள் கேட்கும்படி சொல்லுவார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அப்பொழுது நீ உனது உள்ளத்தில்","poem":1},{"text":"‘எனக்கு இந்தப் பிள்ளைகளைக் கொடுத்தது யார்?","poem":2},{"text":"நான் துயருற்றவளாகவும் மலடியாகவும் இருந்தேன்;","poem":1},{"text":"நான் நாடுகடத்தப்பட்டவளாகவும், புறக்கணிக்கப்பட்டவளாகவும் இருந்தேன்.","poem":2},{"lineBreak":true},{"text":"யார் இந்தப் பிள்ளைகளை வளர்த்தெடுத்தார்கள்?","poem":2},{"text":"இதோ நான் தனித்தவளாயிருந்தேனே!","poem":1},{"text":"ஆனால் இவர்கள் எங்கிருந்து வந்தார்கள்?’ என்று சொல்லிக்கொள்வாய்.”","poem":2}]},{"type":"verse","number":22,"content":["ஆண்டவராகிய யெகோவா சொல்வது இதுவே:",{"text":"“இதோ, நான் பிற நாட்டவர்களை கைகாட்டி அழைப்பேன்,","poem":1},{"text":"மக்கள் கூட்டங்களுக்கு எனது கொடியை ஏற்றுவேன்.","poem":2},{"text":"அவர்கள் உங்கள் மகன்களைத் தங்கள் கைகளில் கொண்டுவருவார்கள்;","poem":1},{"text":"மகள்களையும் தங்கள் தோள்களில் சுமந்து கொண்டுவருவார்கள்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அரசர்கள் உங்களுக்கு வளர்ப்புத் தந்தைகளாய் இருப்பார்கள்;","poem":1},{"text":"அரசிகள் உங்களுக்கு வளர்ப்புத் தாய்களாய் இருப்பார்கள்.","poem":2},{"text":"அவர்கள் உங்களுக்கு முன்பாகத் தரையில் முகங்குப்புற விழுந்து வணங்குவார்கள்;","poem":1},{"text":"அவர்கள் உங்கள் பாதங்களிலுள்ள புழுதியை நக்குவார்கள்.","poem":2},{"text":"அப்பொழுது நீங்கள், நானே யெகோவா என்பதை அறிந்துகொள்வீர்கள்;","poem":1},{"text":"என்னை நம்பியிருப்பவர்கள் வெட்கப்பட்டு போகமாட்டார்கள்” என்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"போர்வீரர்களிடமிருந்து கொள்ளைப்பொருட்களைப் பறித்தெடுக்க முடியுமோ?","poem":1},{"text":"வெற்றி வீரனிடமிருந்து கைதிகளைக் காப்பாற்ற முடியுமோ?","poem":2}]},{"type":"verse","number":25,"content":["ஆனால், யெகோவா சொல்வது இதுவே:",{"text":"“ஆம், கைதிகள் போர்வீரரிடமிருந்து விடுவிக்கப்படுவார்கள்;","poem":1},{"text":"வலியவனிடமிருந்து கொள்ளைப்பொருளும் மீட்கப்படும்.","poem":2},{"text":"உங்களுடன் சண்டையிடுகிறவர்களோடு நான் சண்டையிடுவேன்.","poem":1},{"text":"உங்கள் பிள்ளைகளை நான் காப்பாற்றுவேன்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"உங்களை ஒடுக்குகிறவர்களைத் தங்கள் சொந்த மாமிசத்தையே தின்னச் செய்வேன்;","poem":1},{"text":"திராட்சை மதுவினால் வெறிகொள்வதுபோல்,","poem":2},{"text":"அவர்கள் தங்கள் சொந்த இரத்தத்தினாலேயே வெறிகொள்வார்கள்.","poem":1},{"text":"அப்பொழுது யெகோவாவாகிய நானே உங்கள் இரட்சகர்;","poem":2},{"text":"யாக்கோபின் வல்லவராகிய நானே உங்கள் மீட்பர் என்பதை","poem":1},{"text":"மனுக்குலம் அனைத்தும் அறிந்துகொள்ளும்.”","poem":2}]}],"footnotes":[{"noteId":24,"caller":"+","text":"சீனீம் அல்லது அஸ்வான்","reference":{"chapter":49,"verse":12}},{"noteId":25,"caller":"+","text":"விரைந்து திரும்புவார்கள் அல்லது திரும்பக் கட்டுகிறவர்கள்","reference":{"chapter":49,"verse":17}}]},"thisChapterLink":"/api/tam_tcv/ISA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/48.json","previousChapterAudioLinks":{},"numberOfVerses":26}