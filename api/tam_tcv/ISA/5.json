{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":5,"content":[{"type":"heading","content":["திராட்சைத் தோட்டத்திற்கு பாடல்"]},{"type":"verse","number":1,"content":[{"text":"என் அன்புக்குரியவருக்காக","poem":1},{"text":"அவருடைய திராட்சைத் தோட்டத்தைப்பற்றி ஒரு பாட்டுப் பாடுவேன்:","poem":2},{"text":"என் அன்புக்குரியவருக்கு செழிப்பான குன்றின்மேல்","poem":1},{"text":"திராட்சைத் தோட்டம் ஒன்றிருந்தது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர் அதைக் கொத்தி கற்களை நீக்கிப் பண்படுத்தினார்;","poem":1},{"text":"உயர்ந்தரக திராட்சைக் கொடிகளை அங்கு நட்டார்.","poem":2},{"text":"அவர் அதற்கு நடுவிலே காவற்கோபுரம் ஒன்றைக் கட்டி,","poem":1},{"text":"திராட்சை இரசம் பிழியும் ஆலையொன்றையும் அமைத்தார்.","poem":2},{"text":"அது நல்ல திராட்சைப் பழங்களைத் தருமென்று எதிர்பார்த்தார்,","poem":1},{"text":"ஆனால் அதுவோ புளிப்பான பழங்களையே கொடுத்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“எருசலேம் நகரில் வசிப்போரே, யூதா மனிதர்களே,","poem":1},{"text":"இப்போது நீங்களே எனக்கும் என் திராட்சைத் தோட்டத்திற்கும்","poem":2},{"lineBreak":true},{"text":"இடையில் நியாயந்தீருங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் திராட்சைத் தோட்டத்திற்கு நான் செய்ததைவிடக்","poem":1},{"text":"கூடுதலாக என்ன செய்திருக்கலாம்?","poem":2},{"text":"நல்ல திராட்சைப் பழங்களைத் தருமென்று நான் காத்திருக்க,","poem":1},{"text":"அது ஏன் புளிப்பான பழங்களைக் கொடுத்தது?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆகவே நான் என் திராட்சைத் தோட்டத்திற்கு","poem":1},{"text":"இப்போது செய்யப்போவதைச் சொல்வேன்:","poem":2},{"text":"அதன் வேலியை நீக்கிவிடுவேன்,","poem":1},{"text":"அது அழிந்துவிடும்.","poem":2},{"text":"அதன் மதில்களை உடைத்துவிடுவேன்,","poem":1},{"text":"அது மிதிக்கப்படும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அதன் கிளைகளை நறுக்காமலும், களையைக் கொத்தி எடுக்கப்படாமலும்","poem":1},{"text":"அதைப் பாழ்நிலமாக விட்டுவிடுவேன்.","poem":2},{"lineBreak":true},{"text":"முட்செடிகளும் நெருஞ்சில் செடிகளும் அங்கு வளரும்.","poem":2},{"text":"அங்கு மழை பெய்யாதபடி","poem":1},{"text":"நான் மேகங்களுக்குக் கட்டளையிடுவேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"எல்லாம் வல்ல யெகோவாவின் திராட்சைத் தோட்டம்","poem":1},{"text":"இஸ்ரயேல் குடும்பமே.","poem":2},{"text":"யூதாவின் மனிதர்தான்","poem":1},{"text":"அவரின் மகிழ்ச்சியின் தோட்டம்.","poem":2},{"text":"அவர் நீதியை எதிர்பார்த்தார், ஆனால் இரத்தம் சிந்துதலையே கண்டார்;","poem":1},{"text":"நியாயத்தை எதிர்பார்த்தார், ஆனால் முறைப்பாட்டையே கேட்டார்.","poem":2}]},{"type":"heading","content":["சாபங்களும் நியாயத்தீர்ப்பும்"]},{"type":"verse","number":8,"content":[{"text":"நாட்டில் பிறருக்கு இடம் இல்லாமல் தாங்கள்மட்டும்,","poem":1},{"text":"வீட்டுடன் வீட்டைச் சேர்த்து,","poem":2},{"text":"வயலுடன் வயலை இணைத்து வாழ்கிறவர்களே,","poem":1},{"text":"உங்களுக்கு ஐயோ!","poem":2}]},{"type":"verse","number":9,"content":["எல்லாம் வல்ல யெகோவா என் காது கேட்க அறிவித்ததாவது:",{"text":"“நிச்சயமாகவே அந்த பெரும் வீடுகள் பாழாகும்,","poem":1},{"text":"அழகிய மாளிகைகள் குடியிருப்பாரின்றி விடப்படும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"பத்து ஏக்கர்","poem":1},{"noteId":2},{"text":"திராட்சைத் தோட்டம் ஒரு குடம்","poem":1},{"noteId":3},{"text":"திராட்சை இரசத்தையே உற்பத்தி செய்யும்.","poem":1},{"text":"பத்து கலம்","poem":2},{"noteId":4},{"text":"விதை விதைத்தால் ஒரு கலம்","poem":2},{"noteId":5},{"text":"அளவு தானியத்தை மட்டுமே கொடுக்கும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"அதிகாலையில் எழுந்து","poem":1},{"text":"மதுபானத்தை நாடி அலைந்து,","poem":2},{"text":"இரவுவரை தரித்திருந்து வெறிக்கும்வரை","poem":1},{"text":"குடித்துக் கொண்டிருப்பவர்களுக்கு ஐயோ, கேடு!","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்கள் யாழோடும், வீணையோடும், தம்புராக்களோடும், குழலோடும்,","poem":1},{"text":"மதுவோடும் விருந்து கொண்டாடுகிறார்கள்.","poem":2},{"text":"ஆனால் அவர்கள் யெகோவாவின் செயல்களை நினைப்பதோ,","poem":1},{"text":"அவரின் கரம் செய்தவற்றை நோக்கிப் பார்ப்பதோ இல்லை.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"எனவே எனது மக்கள் அறிவின்மையால்","poem":1},{"text":"நாடுகடத்தப்படுவார்கள்;","poem":2},{"text":"அவர்களின் பெருமதிப்பிற்குரியவர்கள் பட்டினியால் சாவார்கள்,","poem":1},{"text":"பொதுமக்கள் தாகத்தால் நாவறண்டு போவார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"எனவே பாதாளம் தன் தொண்டையை விரிவாக்கி,","poem":1},{"text":"தன் வாயை அளவின்றித் திறக்கிறது.","poem":2},{"text":"உயர்குடி மக்களும், பொதுமக்களும் அவர்களோடுகூட சண்டைக்காரரும்,","poem":1},{"text":"வெறியரும் அதற்குள் இறங்குவார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"இப்படியாக மனிதன் தாழ்நிலைக்குக் கொண்டுவரப்படுவான்.","poem":1},{"text":"மனுக்குலமும் தாழ்த்தப்படும்.","poem":2},{"lineBreak":true},{"text":"அகங்காரரின் கண்களும் தாழ்த்தப்படும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆனால் எல்லாம் வல்ல யெகோவா தமது நியாயத்தீர்ப்பினால் உயர்ந்து,","poem":1},{"text":"பரிசுத்த இறைவனும் தமது நீதியினால் தம்மைப் பரிசுத்தராக வெளிப்படுத்துவார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அப்பொழுது செம்மறியாடுகள் தங்கள் மேய்ச்சல் இடங்களில் மேயும்.","poem":1},{"text":"செல்வந்தரின் பாழடைந்த இடங்களை அந்நியர்கள் அனுபவிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"வஞ்சகத்தின் கயிறுகளால் பாவத்தையும்,","poem":1},{"text":"வண்டியின் கயிறுகளால் கொடுமையையும் இழுத்து, ஐயோ கேடு!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“நாம் காணத்தக்கதாக,","poem":1},{"text":"இறைவன் துரிதமாய் வந்து","poem":2},{"lineBreak":true},{"text":"தமது வேலையை விரைவாகச் செய்யட்டும்.","poem":2},{"text":"நாம் அறியத்தக்கதாக,","poem":1},{"text":"இஸ்ரயேலரின் பரிசுத்தர் தமது திட்டத்தை வெளிப்படுத்தி,","poem":2},{"lineBreak":true},{"text":"அதை நிறைவேற்றட்டும்” என்று சொல்கிறவர்களுக்கு ஐயோ, கேடு!","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"தீமையை நன்மையென்றும்,","poem":1},{"text":"நன்மையைத் தீமையென்றும் சொல்லி,","poem":2},{"text":"இருளை ஒளியாக்கி,","poem":1},{"text":"ஒளியை இருளாக்கி,","poem":2},{"text":"கசப்பை இனிப்பாக்கி,","poem":1},{"text":"இனிப்பை கசப்பாக்குகிறவர்களுக்கு ஐயோ, கேடு!","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"தங்கள் கண்களுக்கு ஞானியாக இருப்பவர்களுக்கும்,","poem":1},{"text":"தங்கள் கணிப்பில் புத்திசாலியாக இருப்பவர்களுக்கும் ஐயோ, கேடு!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"திராட்சைமது குடிப்பதில் வீரரும்,","poem":1},{"text":"மதுபானம் கலக்குவதில் வல்லவர்களுமாயிருந்து,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"இலஞ்சத்துக்காகக் குற்றவாளியை விடுவித்து,","poem":1},{"text":"குற்றமற்றவனுக்கு நீதியை வழங்க மறுக்கிறவர்களுக்கு ஐயோ, கேடு!","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஆகவே அக்கினி ஜூவாலை வைக்கோலைச் சுட்டெரிப்பதுபோலவும்,","poem":1},{"text":"காய்ந்த புல் நெருப்பில் எரிந்து மடிவதுபோலவும்,","poem":2},{"text":"அவர்களின் வேர்கள் அழுகி,","poem":1},{"text":"பூக்கள் புழுதிபோல் பறந்துவிடும்.","poem":2},{"text":"ஏனெனில் அவர்கள் எல்லாம் வல்ல யெகோவாவின் சட்டத்தைப் புறக்கணித்து,","poem":1},{"text":"இஸ்ரயேலின் பரிசுத்தருடைய வார்த்தையை இழிவுபடுத்தினார்கள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அதனால் யெகோவாவின் கோபம் தம்முடைய மக்களுக்கு விரோதமாய் பற்றியெரிகிறது:","poem":1},{"text":"அவர் தமது கரத்தை உயர்த்தி, அவர்களை அடித்து வீழ்த்துகிறார்.","poem":2},{"text":"மலைகள் நடுநடுங்கின,","poem":1},{"text":"அவர்களுடைய பிரேதங்கள் தெருக்களில் குப்பைபோல் கிடக்கின்றன.","poem":2},{"lineBreak":true},{"text":"இவையெல்லாம் நடந்தும் அவரது கோபம் தீராமல்,","poem":1},{"text":"அவரது கரம் இன்னும் ஓங்கியபடியே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"அவர் தூரத்திலுள்ள நாடுகளுக்கு ஒரு கொடியை ஏற்றி,","poem":1},{"text":"பூமியின் கடைசியிலுள்ளவர்களைக் கூவி அழைக்கிறார்.","poem":2},{"text":"இதோ, அவர்கள் வருகிறார்கள்,","poem":1},{"text":"விரைந்து வேகமாய் வருகிறார்கள்!","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவர்களில் ஒருவரேனும் களைப்புறுவதுமில்லை, இடறிவிழுவதுமில்லை;","poem":1},{"text":"ஒருவரும் தூங்குவதுமில்லை, உறங்குவதுமில்லை;","poem":2},{"text":"அவர்களின் இடைப்பட்டி தளர்த்தப்படுவதுமில்லை,","poem":1},{"text":"அவர்களின் செருப்புகளின் தோல்வார் ஒன்றும் அறுந்துபோவதும் இல்லை.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவர்களுடைய அம்புகள் கூரானவை;","poem":1},{"text":"வில்லுகள் நாணேற்றப்பட்டவை.","poem":2},{"text":"அவர்களுடைய குதிரைகளின் குளம்புகள் கருங்கற்கள் போலவும்,","poem":1},{"text":"தேர்ச் சக்கரங்கள் சுழற்காற்றைப் போலவும் காணப்படுகின்றன.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர்களின் கெர்ச்சிப்பு சிங்கத்தின் கெர்ச்சிப்பைப் போன்றது,","poem":1},{"text":"அவர்கள் இளஞ்சிங்கத்தைப்போல் கெர்ச்சிக்கிறார்கள்;","poem":2},{"text":"அவர்கள் தங்கள் இரையைப் பற்றிக்கொள்ளும்போது உறுமுகிறார்கள்;","poem":1},{"text":"அதை விடுவிக்கிறவன் இல்லாமல், அவர்கள் தாங்கள் பிடித்ததைக் கொண்டுபோகிறார்கள்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அந்நாளிலே அவர்கள், கடலின் இரைச்சல்போல்","poem":1},{"text":"அவர்களுக்கு விரோதமாக இரைவார்கள்.","poem":2},{"text":"ஒருவன் அந்த நாட்டைப் பார்க்கும்போது","poem":1},{"text":"இருளையும் துன்பத்தையுமே காண்பான்;","poem":2},{"lineBreak":true},{"text":"வெளிச்சமும் மேகங்களால் இருளாக்கப்படும்.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"ஏக்கர் என்பது பத்து ஏர் அதாவது ஒரே நாளில் பத்து அணிகள் எருதுகளால் உழப்படும் நிலத்தின் பரப்பளவு","reference":{"chapter":5,"verse":10}},{"noteId":3,"caller":"+","text":"எபிரெயத்தில், பாத் இது 22 லிட்டர்","reference":{"chapter":5,"verse":10}},{"noteId":4,"caller":"+","text":"எபிரெயத்தில், ஓமர் 160 கிலோகிராம்","reference":{"chapter":5,"verse":10}},{"noteId":5,"caller":"+","text":"எபிரெயத்தில், எப்பா 16 கிலோகிராம்","reference":{"chapter":5,"verse":10}}]},"thisChapterLink":"/api/tam_tcv/ISA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/4.json","previousChapterAudioLinks":{},"numberOfVerses":30}