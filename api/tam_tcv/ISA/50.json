{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":50,"content":[{"type":"heading","content":["இஸ்ரயேலின் பாவம்"]},{"type":"verse","number":1,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“உங்கள் தாயை நான் விவாகரத்துச் செய்து அனுப்பியபோது,","poem":1},{"text":"அவளுக்குக் கொடுத்த விவாகரத்துச் சீட்டு எங்கே?","poem":2},{"text":"அல்லது எனக்குக் கடன் கொடுத்தவர்களில் யாருக்காவது நான் உங்களை விற்றேனா?","poem":1},{"text":"உங்கள் பாவங்களின் காரணமாகவே நீங்கள் விற்கப்பட்டீர்கள்.","poem":2},{"text":"உங்கள் மீறுதல்களின் காரணமாகவே","poem":1},{"text":"உங்களுடைய தாயும் துரத்திவிடப்பட்டாள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் வந்தபோது ஒருவரும் இருக்கவில்லையே;","poem":1},{"text":"அது ஏன்? நான் கூப்பிட்டபோது, ஒருவரும் பதில் கூறவில்லையே; அது ஏன்?","poem":2},{"text":"உங்களை மீட்க முடியாதபடி என் கை மிகக் குறுகியதாயிருந்ததோ?","poem":1},{"text":"அல்லது உங்களை விடுவிக்க எனக்கு வலிமையில்லையோ?","poem":2},{"text":"நான் சிறு அதட்டலினால் கடலை வற்றப்பண்ணுகிறேன்;","poem":1},{"text":"நான் ஆறுகளைப் பாலைவனமாக மாற்றுகிறேன்.","poem":2},{"text":"தண்ணீர் இல்லாததால், அவர்களுடைய மீன்கள் நாறுகின்றன;","poem":1},{"text":"தாகத்தால் அவை சாகின்றன.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் ஆகாயத்தை இருளால் உடுத்தி,","poem":1},{"text":"துக்கவுடையை அதன் போர்வையாக்குகிறேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"இளைத்துப்போனவனை உற்சாகப்படுத்தும்படி, என்ன வார்த்தையை சொல்ல","poem":1},{"text":"நான் அறிந்திட ஆண்டவராகிய யெகோவா போதிக்கும் நாவை எனக்குக் கொடுத்திருக்கிறார்;","poem":2},{"text":"காலைதோறும் அவர் என்னை எழுப்புகிறார்,","poem":1},{"text":"ஒரு சீடனைப்போல் நான் கவனமாய் கேட்கும்படி","poem":2},{"lineBreak":true},{"text":"அவர் எனது செவிப் புலனைத் தட்டி எழுப்புகிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆண்டவராகிய யெகோவா எனது செவியைத் திறந்திருக்கிறார்;","poem":1},{"text":"நான் கீழ்ப்படியாமல் இருக்கவில்லை,","poem":2},{"lineBreak":true},{"text":"அவரைவிட்டு நான் விலகவுமில்லை.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"என்னை அடிக்கிறவர்களுக்கு எனது முதுகைக் கொடுத்தேன்,","poem":1},{"text":"எனது தாடியைப் பிடுங்குகிறவர்களுக்கு என்னுடைய தாடைகளைக் கொடுத்தேன்;","poem":2},{"text":"அவர்கள் ஏளனம் செய்தபோதும்,","poem":1},{"text":"உமிழ்நீரைத் துப்பியபோதும் அதற்கு என் முகத்தை நான் மறைக்கவில்லை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவாகிய ஆண்டவர் எனக்கு உதவி செய்கிறபடியால்,","poem":1},{"text":"நான் அவமானம் அடையமாட்டேன்.","poem":2},{"text":"ஆகையால் என் முகத்தைக் கற்பாறையைப்போல் வைத்துக்கொள்கிறேன்;","poem":1},{"text":"நான் வெட்கப்பட்டுப் போவதில்லை என்பதும் எனக்குத் தெரியும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எனக்கு நீதி அளிக்கும் இறைவன் என் அருகில் இருக்கிறார்.","poem":1},{"text":"அப்படியிருக்க, எனக்கெதிராகக் குற்றச்சாட்டுகள் கொண்டுவருபவன் யார்?","poem":2},{"lineBreak":true},{"text":"நேருக்குநேர் சந்திப்போம்!","poem":2},{"text":"என்னைக் குற்றம் சாட்டுபவன் யார்?","poem":1},{"text":"அவன் எனக்கு முன்னே வரட்டும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஆண்டவராகிய யெகோவாவே எனக்கு உதவி செய்கிறார்.","poem":1},{"text":"என்னைக் குற்றவாளியாகத் தீர்க்கிறவர்கள் யார்?","poem":2},{"text":"அவர்கள் எல்லோரும் பொலிவிழந்து","poem":1},{"text":"பூச்சிகள் அரித்த உடையைப்போல் இத்துப்போவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"உங்களுக்குள் யெகோவாவுக்குப் பயந்து நடந்து,","poem":1},{"text":"அவரது பணியாளனின் வார்த்தைக்குக் கீழ்ப்படிகிறவன் யார்?","poem":2},{"text":"வெளிச்சம் இல்லாதவனாய்","poem":1},{"text":"இருளில் நடக்கிறவன்,","poem":2},{"text":"யெகோவாவின் பெயரில் நம்பிக்கை வைத்து,","poem":1},{"text":"தன் இறைவனில் சார்ந்திருக்கட்டும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஆனால் இப்பொழுதோ, நெருப்பை மூட்டி உங்களுக்கென்று","poem":1},{"text":"எரிகின்ற பந்தங்களை உண்டாக்கிக்கொள்கிற பாவிகளே!","poem":2},{"text":"நீங்கள் எல்லோரும் போய், உங்கள் நெருப்பின் வெளிச்சத்திலே நடவுங்கள்.","poem":1},{"text":"நீங்கள் பற்றவைத்த பந்தங்களின் வெளிச்சத்திலே நடவுங்கள்.","poem":2},{"text":"அப்பொழுது என்னுடைய கரத்திலிருந்து பெற்றுக்கொள்வது இதுவே,","poem":1},{"text":"நீங்கள் வேதனையிலே கிடப்பீர்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/49.json","previousChapterAudioLinks":{},"numberOfVerses":11}