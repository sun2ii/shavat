{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":51,"content":[{"type":"heading","content":["சீயோனுக்கு நித்திய இரட்சிப்பு"]},{"type":"verse","number":1,"content":[{"text":"“நீதியைப் பின்பற்றுகிறவர்களே, யெகோவாவைத் தேடுகிறவர்களே,","poem":1},{"text":"நீங்கள் எனக்குச் செவிகொடுங்கள்.","poem":2},{"text":"நீங்கள் எந்தக் கற்பாறையிலிருந்து வெட்டி எடுக்கப்பட்டீர்களோ,","poem":1},{"text":"எந்தக் கற்குழியிலிருந்து தோண்டி எடுக்கப்பட்டீர்களோ,","poem":2},{"lineBreak":true},{"text":"அந்தக் கற்பாறையானவரை நோக்கிப்பாருங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உங்கள் முற்பிதாவாகிய ஆபிரகாமையும்","poem":1},{"text":"உங்களைப் பெற்றெடுத்த சாராளையும் நோக்கிப்பாருங்கள்.","poem":2},{"text":"நான் அவனை அழைத்தபோது, அவன் ஒருவனாய் மாத்திரமே இருந்தான்;","poem":1},{"text":"நான் அவனை ஆசீர்வதித்து அவனை அநேகராகப் பெருகச் செய்தேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"மெய்யாகவே யெகோவா சீயோனைத் தேற்றுவார்,","poem":1},{"text":"அவளுடைய பாழான இடங்களையெல்லாம் ஆறுதல் செய்வார்;","poem":2},{"text":"அவர் அவளுடைய பாலைவனங்களை ஏதேனைப் போலவும்,","poem":1},{"text":"அவளுடைய பாழிடங்களை யெகோவாவின் தோட்டத்தைப் போலவும் ஆக்குவார்.","poem":2},{"text":"சந்தோஷமும் மகிழ்ச்சியும் அங்கு காணப்படும்,","poem":1},{"text":"நன்றி செலுத்துதலும் பாடலின் சத்தமும் அங்கு இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“என் மக்களே, எனக்குச் செவிகொடுங்கள்;","poem":1},{"text":"என் நாடே, கேளுங்கள்:","poem":2},{"text":"சட்டம் என்னிலிருந்து வெளிப்படும்:","poem":1},{"text":"என் நீதி நாடுகளுக்கு ஒரு வெளிச்சமாக இருக்கும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என் நீதி சமீபமாயிருக்கிறது;","poem":1},{"text":"என் இரட்சிப்பு வெளிப்படுகிறது,","poem":2},{"lineBreak":true},{"text":"என் புயம் நாடுகளுக்கு நீதியைக் கொண்டுவரும்.","poem":2},{"text":"தீவுகள் என்னை நோக்கி,","poem":1},{"text":"என் கரத்திற்காக எதிர்பார்ப்புடன் காத்திருக்கும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உங்கள் கண்களை வானங்களை நோக்கி உயர்த்துங்கள்,","poem":1},{"text":"கீழிருக்கும் பூமியையும் பாருங்கள்;","poem":2},{"text":"வானங்கள் புகையைப்போல் மறையும்,","poem":1},{"text":"பூமியும் பழைய உடையைப்போல் கந்தையாகும்;","poem":2},{"lineBreak":true},{"text":"அங்கு குடியிருப்போரும் ஈக்களைப்போல் சாவார்கள்.","poem":2},{"text":"ஆனால் எனது இரட்சிப்போ என்றென்றைக்கும் நிலைநிற்கும்,","poem":1},{"text":"எனது நீதி ஒருபோதும் தவறுவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“நியாயத்தை அறிந்தவர்களே,","poem":1},{"text":"எனது சட்டத்தை மனதில் வைத்திருக்கும் மக்களே, எனக்குச் செவிகொடுங்கள்.","poem":2},{"text":"மனிதரின் நிந்தனைக்குப் பயப்படாதீர்கள்;","poem":1},{"text":"அவர்களின் ஏளனப் பேச்சுக்களால் திகிலடையாதீர்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பொட்டுப்பூச்சி உடையை அரித்து,","poem":1},{"text":"ஆட்டு மயிரைத் தின்பதுபோல் அவர்களைத் தின்னும்.","poem":2},{"text":"ஆனால் என் நீதியோ என்றென்றைக்கும் நிலைக்கும்,","poem":1},{"text":"எனது இரட்சிப்பும் எல்லா தலைமுறைகளுக்கும் நிலைத்திருக்கும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"யெகோவாவின் புயமே, விழித்தெழு, விழித்தெழு,","poem":1},{"text":"பெலத்தால் உன்னை உடுத்திக்கொள்!","poem":2},{"text":"கடந்த நாட்களிலும் பழைய தலைமுறைகளிலும்","poem":1},{"text":"எழுந்ததுபோல் விழித்தெழு.","poem":2},{"text":"ராகாப்","poem":1},{"noteId":26},{"text":"என்னும் வலுசர்ப்பத்தைத் துண்டுதுண்டாக வெட்டியது நீரல்லவா?","poem":1},{"text":"அந்த மிருகத்தை ஊடுருவக் குத்தியதும் நீரல்லவா?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"கடலையும் ஆழங்களின் தண்ணீரையும்","poem":1},{"text":"வற்றவைத்தது நீரல்லவா?","poem":2},{"text":"மீட்கப்பட்டவர்கள் கடந்துசெல்லும்படி கடலின்","poem":1},{"text":"பெரிய ஆழங்களில் பாதை அமைத்ததும் நீரல்லவா?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவாவினால் மீட்கப்பட்டவர்கள் திரும்பி வருவார்கள்.","poem":1},{"text":"அவர்கள் பாடலுடன் சீயோனுக்குள் செல்வார்கள்;","poem":2},{"lineBreak":true},{"text":"நித்திய மகிழ்ச்சி அவர்களுடைய தலையின்மேலிருக்கும்.","poem":2},{"text":"மகிழ்ச்சியும் ஆனந்தமும் அடைவார்கள்,","poem":1},{"text":"துக்கமும் பெருமூச்சும் பறந்தோடிவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“நான், நானே உன்னைத் தேற்றுகிறவர்.","poem":1},{"text":"இறக்கும் மனிதனுக்கும்,","poem":2},{"lineBreak":true},{"text":"புல்லாயிருக்கும் மானிடருக்கும் பயப்படுவதற்கு நீ யார்?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"வானங்களை விரித்து,","poem":1},{"text":"பூமியின் அஸ்திபாரங்களை அமைத்த,","poem":2},{"lineBreak":true},{"text":"உன் படைப்பாளரான யெகோவாவை நீ மறந்திருக்கிறாயே!","poem":2},{"text":"அதனால் அழிக்கக் காத்திருக்கும்","poem":1},{"text":"ஒடுக்குகிறவனுடைய கோபத்திற்கு தினமும்","poem":2},{"lineBreak":true},{"text":"இடைவிடாமல் நீ அஞ்சுகிறாயே!","poem":2},{"text":"ஒடுக்குபவனின் கடுங்கோபம் எங்கே?","poem":1}]},{"type":"verse","number":14,"content":[{"text":"பயந்து அடங்கியிருக்கும் கைதிகள் விரைவில் விடுதலையாக்கப்படுவார்கள்;","poem":2},{"text":"தங்கள் இருட்டறையில் அவர்கள் சாகமாட்டார்கள்,","poem":1},{"text":"அவர்களின் உணவும் குறைவுபடாது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஏனெனில் உன் இறைவனாகிய யெகோவா நானே,","poem":1},{"text":"நான் கடலைக் கலக்க அதன் அலைகள் இரைகின்றன,","poem":2},{"lineBreak":true},{"text":"சேனைகளின் யெகோவா என்பது என் பெயர்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"வானங்களை அதினதின் இடத்தில் நிலைப்படுத்தி,","poem":1},{"text":"பூமியின் அஸ்திபாரங்களையும் அமைத்தேன்.","poem":2},{"text":"சீயோனிடம், ‘நீங்களே எனது மக்கள்’ என்று சொன்னேன்”","poem":1},{"text":"நான் என் வார்த்தைகளை உன் வாயில் அருளி,","poem":2},{"lineBreak":true},{"text":"என் கரத்தின் நிழலால் உன்னை மூடிக்கொண்டேன்.","poem":2}]},{"type":"heading","content":["யெகோவாவின் கோபம்"]},{"type":"verse","number":17,"content":[{"text":"விழித்தெழு, விழித்தெழு!","poem":1},{"text":"எருசலேமே, விழித்தெழு,","poem":2},{"text":"யெகோவாவின் கரத்திலிருக்கும்","poem":1},{"text":"அவரது கோபத்தின் பாத்திரத்தில் குடித்தவளே!","poem":2},{"text":"மனிதரைத் தள்ளாடவைக்கும் பாத்திரத்தை","poem":1},{"text":"மண்டிவரை குடித்தவளே! நீ எழுந்திரு.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவள் பெற்றெடுத்த எல்லா மக்களிலும்","poem":1},{"text":"அவளுக்கு வழிகாட்ட பிள்ளைகள் ஒருவரும் இருக்கவில்லை;","poem":2},{"text":"அவள் வளர்த்த எல்லா பிள்ளைகளிலும்","poem":1},{"text":"அவளைக் கையில் பிடித்துச் செல்லக்கூட ஒருவரும் இல்லை.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இந்த இரண்டு பெரும் துன்பங்களும் உன்மேல் வந்திருக்கின்றன;","poem":1},{"text":"உன்னைத் தேற்றுபவர் யார்?","poem":2},{"text":"அழிவும், பாழும், பஞ்சமும், வாளும் உன்மேல் வந்திருக்கின்றன.","poem":1},{"text":"உன்னை ஆறுதல்படுத்துபவர் யார்?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"உனது பிள்ளைகள் சோர்ந்துவிட்டார்கள்;","poem":1},{"text":"ஒவ்வொரு தெருவின் முகப்பிலும்,","poem":2},{"lineBreak":true},{"text":"வலையில் அகப்பட்ட கலைமானைப்போல் கிடக்கிறார்கள்.","poem":2},{"text":"அவர்கள் யெகோவாவின் கோபத்தாலும்,","poem":1},{"text":"உங்கள் இறைவனின் கண்டனத்தாலும் நிரப்பப்பட்டிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ஆகவே, துன்புறுத்தப்பட்டவளே,","poem":1},{"text":"மதுபானம் குடிக்காமலே வெறிகொண்டிருக்கிறவளே, இதைக் கேள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"உன் ஆண்டவராகிய யெகோவா சொல்வது இதுவே,","poem":1},{"text":"தமது மக்களுக்காக வாதாடும் உன் இறைவன் கூறுகிறார்:","poem":2},{"text":"“உன்னை மதிமயக்கும் பாத்திரத்தை","poem":1},{"text":"உன் கைகளிலிருந்து எடுத்துக்கொண்டேன்;","poem":2},{"text":"எனது கோபத்தின் பாத்திரத்தில்","poem":1},{"text":"நீ இனி ஒருபோதும் குடிக்கமாட்டாய்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"உன்னை வேதனைப்படுத்தியவர்களின் கைகளில் அப்பாத்திரத்தை நான் வைப்பேன்.","poem":1},{"text":"அவர்கள் உன்னிடம், ‘நாங்கள் உன்மீது நடக்கும்படி நிலத்தில் வீழ்ந்துகிட’","poem":2},{"lineBreak":true},{"text":"என்று சொல்லியிருந்தார்கள்.","poem":2},{"text":"நீயும் உன் முதுகை நிலத்தைப் போலாக்கினாய்,","poem":1},{"text":"மிதித்து நடக்கும்படி அதை ஒரு வீதியைப்போலவும் ஆக்கினாயே.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":26,"caller":"+","text":"ராகாப் பண்டைய இலக்கியங்களில் ஒழிங்கீனத்தைக் குறிக்கும் புராண கடல் அசுரனின் பெயராகும். இங்கே எகிப்தைக் குறிக்கும் கவிதைப் பெயராக ராகாப் பயன்படுத்தப்பட்டுள்ளது.","reference":{"chapter":51,"verse":9}}]},"thisChapterLink":"/api/tam_tcv/ISA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/50.json","previousChapterAudioLinks":{},"numberOfVerses":23}