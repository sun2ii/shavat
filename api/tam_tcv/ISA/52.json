{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":52,"content":[{"type":"verse","number":1,"content":[{"text":"விழித்தெழு சீயோனே, விழித்தெழு,","poem":1},{"text":"உன்னைப் பெலத்தினால் உடுத்திக்கொள்!","poem":2},{"text":"எருசலேமே, பரிசுத்த நகரமே,","poem":1},{"text":"உன்னுடைய மகத்துவத்தின் உடைகளை உடுத்திக்கொள்.","poem":2},{"text":"விருத்தசேதனம் செய்யாதவர்களும்,","poem":1},{"text":"அசுத்தரும் இனி உனக்குள் வரமாட்டார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"எருசலேமே, உன்னிலிருக்கும் தூசியை உதறிப் போடு;","poem":1},{"text":"நீ எழுந்து அரியணையில் அமர்ந்திரு.","poem":2},{"text":"சிறைபட்ட சீயோன் மகளே,","poem":1},{"text":"உன் கழுத்தில் இருக்கும் கட்டுகளைக் கழற்றி, உன்னை விடுவித்துக்கொள்.","poem":2}]},{"type":"verse","number":3,"content":["யெகோவா கூறுவது இதுவே:",{"text":"நீ பணம் எதுவும் பெறாமல் விற்கப்பட்டாயே,","poem":1},{"text":"“நீ பணமின்றி மீட்கப்படுவாய்.”","poem":2}]},{"type":"verse","number":4,"content":["ஆண்டவராகிய யெகோவா கூறுவது இதுவே:",{"text":"“ஆரம்பத்தில் எனது மக்கள் எகிப்திலே வாழ்வதற்காகப் போனார்கள்;","poem":1},{"text":"பின்னர் அசீரியர் அவர்களை ஒடுக்கினார்கள்.","poem":2}]},{"type":"verse","number":5,"content":["“இப்பொழுதோ இங்கு எனக்கு என்ன இருக்கிறது?” என்று யெகோவா கேட்கிறார்.",{"text":"“எனது மக்கள் காரணமில்லாமல் கொண்டுசெல்லப்பட்டார்கள்;","poem":1},{"text":"அவர்களை ஆளுகிறவர்கள் அலறச் செய்கிறார்கள்,","poem":2},{"lineBreak":true},{"text":"எனது பெயரும் நாளெல்லாம்","poem":2},{"text":"தொடர்ந்து தூஷிக்கப்படுகிறது”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“ஆகையால், எனது மக்கள் எனது பெயரை அறிந்துகொள்வார்கள்;","poem":1},{"text":"அந்த நாளிலே,","poem":2},{"text":"அதை முன்னறிவித்தவர் நானே என்று அவர்கள் அறிந்துகொள்வார்கள்.","poem":1},{"text":"ஆம், அவர் நானே.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நற்செய்தியைக் கொண்டுவருவோரின் பாதங்கள்","poem":1},{"text":"மலைகளின்மீது எவ்வளவு அழகாக இருக்கின்றன!","poem":2},{"text":"அவர்கள் சமாதானத்தைப் பிரசித்தப்படுத்தி,","poem":1},{"text":"நல்ல செய்திகளைக் கொண்டுவருவார்கள்.","poem":2},{"lineBreak":true},{"text":"இரட்சிப்பைப் பிரசித்தப்படுத்தி,","poem":2},{"text":"சீயோனிடம்,","poem":1},{"text":"“உங்கள் இறைவனே ஆளுகை செய்கிறார்” என்று சொல்வார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"கேளுங்கள், உங்களுடைய காவலர் தங்கள் குரல்களை எழுப்புகிறார்கள்;","poem":1},{"text":"அவர்கள் ஒன்றுசேர்ந்து ஆனந்த சத்தமிடுகிறார்கள்.","poem":2},{"text":"யெகோவா சீயோனுக்குத் திரும்பும்போது,","poem":1},{"text":"அதை அவர்கள் தங்கள் சொந்தக் கண்களால் காண்பார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எருசலேமின் பாழிடங்களே,","poem":1},{"text":"நீங்கள் ஒன்றுசேர்ந்து மகிழ்ச்சியின் கீதம் பாடுங்கள்.","poem":2},{"text":"ஏனெனில் யெகோவா தனது மக்களைத் தேற்றி,","poem":1},{"text":"எருசலேமை மீட்டுக்கொண்டார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"யெகோவா எல்லா ஜனங்களின் பார்வையிலும்","poem":1},{"text":"தம் பரிசுத்த கரத்தை நீட்டுவார்.","poem":2},{"text":"அப்பொழுது பூமியின் எல்லைகளில் உள்ளவர்களெல்லாம்","poem":1},{"text":"நமது இறைவனின் இரட்சிப்பைக் காணுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"புறப்படுங்கள், புறப்படுங்கள், அங்கிருந்து வெளியேறுங்கள்!","poem":1},{"text":"அசுத்தமான எதையும் தொடாதேயுங்கள்!","poem":2},{"text":"யெகோவாவின் பாத்திரங்களைச் சுமக்கும் நீங்கள்","poem":1},{"text":"அங்கிருந்து வெளியேறி சுத்தமாயிருங்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆனால், நீங்கள் அவசரமாய் வெளியேறப்போவதில்லை,","poem":1},{"text":"தப்பியோடிப்போகிறவர்கள் போல ஓடிப்போவதில்லை.","poem":2},{"text":"ஏனெனில், யெகோவா உங்கள்முன் செல்வார்,","poem":1},{"text":"இஸ்ரயேலின் இறைவனே உங்களுக்குப் பின்னால் காவலாகவும் இருப்பார்.","poem":2}]},{"type":"heading","content":["அடியவரின் பாடுகள்"]},{"type":"verse","number":13,"content":[{"text":"பாருங்கள், என் ஊழியன் ஞானமாய் செயலாற்றுவார்;","poem":1},{"text":"அவர் எழுப்பப்பட்டு, உயர்த்தப்பட்டு, அதிக மேன்மைப்படுத்தப்படுவார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவரைக்கண்டு பிரமிப்படைந்தவர்கள் அநேகர்;","poem":1},{"text":"அவரது தோற்றம் மனிதர் போலன்றி உருக்குலைந்ததாய் இருந்தது;","poem":2},{"lineBreak":true},{"text":"அவரது சாயலும் மனிதர் போலன்றி சிதைக்கப்பட்டிருந்தது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அநேக நாடுகள் அவரைக்கண்டு திகைப்பார்கள்;","poem":1},{"text":"அவரின் நிமித்தம் அரசர்களும் தங்கள் வாய்களை மூடிக்கொள்வார்கள்.","poem":2},{"text":"அவர்களுக்குச் சொல்லப்படாததை அவர்கள் காண்பார்கள்,","poem":1},{"text":"அவர்கள் கேள்விப்படாததை அவர்கள் விளங்கிக்கொள்வார்கள்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/51.json","previousChapterAudioLinks":{},"numberOfVerses":15}