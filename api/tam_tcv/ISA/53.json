{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":53,"content":[{"type":"verse","number":1,"content":[{"text":"எங்களுடைய செய்தியை விசுவாசித்தவன் யார்?","poem":1},{"text":"யெகோவாவின் கரம் யாருக்கு வெளிப்படுத்தப்பட்டது?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவுக்கு முன்பாக அவர் ஒரு இளந்தளிரைப் போலவும்,","poem":1},{"text":"வறண்ட நிலத்தில் வளரும் வேரைப் போலவும் வளர்ந்தார்.","poem":2},{"text":"நம்மைக் கவரக்கூடிய அழகோ, மாட்சிமையோ அவரிடம் இருக்கவில்லை;","poem":1},{"text":"அவருடைய தோற்றத்தில் நாம் விரும்பத்தக்க எதுவும் அவரில் காணப்படவில்லை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர் மனிதரால் இகழப்பட்டும், புறக்கணிக்கப்பட்டும் இருந்தார்;","poem":1},{"text":"அவர் துன்பத்தின் மனிதனாய்","poem":2},{"noteId":27},{"text":"வேதனையில் பங்குகொண்டவராய் இருந்தார்.","poem":2},{"text":"அருவருப்புள்ள ஒருவனைக் கண்டு மனிதர் தம் முகத்தை மறைத்துக்கொள்வதுபோல்,","poem":1},{"text":"அவர் இகழப்பட்டார், நாமும் அவரை மதிக்கவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"உண்மையாகவே அவர் நமது வேதனைகளை ஏற்றுக்கொண்டு,","poem":1},{"text":"நமது நோய்களையும் குறைகளையும் சுமந்தார்.","poem":2},{"text":"அப்படியிருக்க, நாமோ அவர் தமக்காகவே இறைவனால் அடிக்கப்பட்டு,","poem":1},{"text":"அவரால் தாக்கப்பட்டு, துன்புறுத்தப்பட்டார் என எண்ணினோம்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆனால், அவரோ எங்கள் மீறுதல்களினிமித்தம் ஊடுருவக் குத்தப்பட்டார்,","poem":1},{"text":"எங்கள் அக்கிரமங்களுக்காகவே அவர் நொறுக்கப்பட்டார்;","poem":2},{"text":"நமக்கு சமாதானத்தைக் கொண்டுவந்த தண்டனை அவர்மேல் வந்தது,","poem":1},{"text":"அவருடைய காயங்களினால் நாம் குணமாகிறோம்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நாமெல்லோரும் ஆடுகளைப்போல, வழிதவறி அலைந்தோம்;","poem":1},{"text":"நம்முடைய சொந்த வழிக்கே திரும்பினோம்.","poem":2},{"text":"யெகோவாவோ நம் எல்லோருடைய அநியாயத்தையும்","poem":1},{"text":"அவர்மேல் சுமத்தினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"அவர் ஒடுக்கப்பட்டுத் துன்புறுத்தப்பட்டார்,","poem":1},{"text":"அப்படியிருந்தும் அவர் தனது வாயைத் திறக்கவில்லை;","poem":2},{"text":"அவர் கொல்லப்படுவதற்குக் கொண்டுபோகப்படும் ஆட்டுக்குட்டியைப் போலவும்,","poem":1},{"text":"மயிர்க்கத்தரிப்பவனுக்கு முன்பாக மவுனமாயிருக்கும் ஆட்டைப்போலவும்","poem":2},{"lineBreak":true},{"text":"அவர் தமது வாயைத் திறவாதிருந்தார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஒடுக்கப்பட்டு நியாயமான தீர்ப்பின்றி அவர் கொண்டுசெல்லப்பட்டார்.","poem":1},{"text":"அவரது தலைமுறையினரைக் குறித்து யாரால் என்ன சொல்லமுடியும்?","poem":2},{"text":"ஏனெனில் ஜீவனுள்ளோரின் நாட்டிலிருந்து அவர் வெளியேற்றப்பட்டார்;","poem":1},{"text":"எனது மக்களின் மீறுதல்களுக்காக அவர் வாதிக்கப்பட்டார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவரிடம் வன்முறை எதுவும் இருந்ததில்லை,","poem":1},{"text":"அவருடைய வாயில் வஞ்சனை எதுவும் காணப்பட்டதுமில்லை.","poem":2},{"text":"ஆனாலும் கொடியவர்களோடு அவருக்கு ஒரு கல்லறை நியமிக்கப்பட்டது;","poem":1},{"text":"தம் மரணத்தில் செல்வந்தரோடு அவர் இருந்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ஆயினும் அவரை நொறுக்கி, வேதனைக்கு உள்ளாக்குவதே","poem":1},{"text":"யெகோவாவின் திட்டமாய் இருந்தது,","poem":2},{"lineBreak":true},{"text":"அவர் தமது உயிரைக் குற்றநிவாரண பலியாக ஆக்கியிருக்கிற போதிலும்,","poem":2},{"text":"அவர் நீடித்த நாட்களாய் இருந்து, தம் சந்ததியைக் காண்பார்.","poem":1},{"text":"யெகோவாவினுடைய திட்டம் அவரது கரத்தால் நிறைவேறும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவரின் ஆத்துமா வேதனையடைந்தபின்","poem":1},{"text":"அவர் வாழ்வின் ஒளியைக் கண்டு திருப்தியடைவார்;","poem":2},{"lineBreak":true},{"text":"நீதியுள்ள எனது ஊழியன் தமது அறிவினால்","poem":2},{"text":"அநேகரை நீதியானவர்களாக்குவார்,","poem":1},{"text":"அவர்களுடைய அநியாயச் செயல்களை அவரே சுமப்பார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆகையால், நான் உயர்ந்தோர் மத்தியில் அவருக்கு ஒரு பங்கைக் கொடுப்பேன்;","poem":1},{"text":"அவர் பலவான்களுடன் கொள்ளைப்பொருளைப் பங்கிடுவார்.","poem":2},{"text":"ஏனெனில், அவர் தம் வாழ்வை மரணம்வரை ஊற்றி,","poem":1},{"text":"குற்றவாளிகளில் ஒருவராக எண்ணப்பட்டார்.","poem":2},{"text":"ஏனெனில் அவர் அநேகருடைய பாவங்களைச் சுமந்து,","poem":1},{"text":"மீறுதல் உள்ளோருக்காக பரிந்துவேண்டுதல் செய்தார்.","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"துன்பத்தின் மனிதனாய் அல்லது வியாதியில்","reference":{"chapter":53,"verse":3}}]},"thisChapterLink":"/api/tam_tcv/ISA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/52.json","previousChapterAudioLinks":{},"numberOfVerses":12}