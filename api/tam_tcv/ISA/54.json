{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":54,"content":[{"type":"heading","content":["சீயோனின் எதிர்கால மகிமை"]},{"type":"verse","number":1,"content":[{"text":"“பிள்ளைபெறாத மலடியே, மகிழ்ந்து பாடு;","poem":1},{"text":"பிரசவ வேதனைப்படாதவளே,","poem":2},{"text":"ஆர்ப்பரித்துப் பாடி ஆனந்த சத்தமிடு,","poem":1},{"text":"ஏனெனில் கைவிடப்பட்டவளின் பிள்ளைகள்","poem":2},{"text":"கணவனுடன் வாழ்கிறவளுடைய","poem":1},{"text":"பிள்ளைகளைவிட அதிகமாயிருப்பார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“உனது கூடாரத்தின் இடத்தை விரிவாக்கு,","poem":1},{"text":"உனது குடியிருப்புகளின் திரையை நன்கு அகலமாக விரி;","poem":2},{"lineBreak":true},{"text":"இவற்றைச் செய்ய பின்வாங்காதே.","poem":2},{"text":"கயிறுகளை தாராளமாக நீட்டி,","poem":1},{"text":"முளைகளை உறுதிப்படுத்து.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஏனெனில் நீ வலது புறமாகவும், இடது புறமாகவும் பரவியிருப்பாய்;","poem":1},{"text":"உன்னுடைய சந்ததிகள் நாடுகளை வெளியேற்றி,","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய பாழடைந்த பட்டணங்களில் குடியேறுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“பயப்படாதே, நீ வெட்கப்படமாட்டாய்;","poem":1},{"text":"அவமானத்திற்குப் பயப்படாதே, நீ தாழ்த்தப்படமாட்டாய்.","poem":2},{"text":"நீ உன் வாலிப காலத்தின் வெட்கத்தை மறந்துபோவாய்,","poem":1},{"text":"விதவைக்கால நிந்தனையையும் இனி ஒருபோதும் நினைக்கமாட்டாய்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஏனெனில், உன்னைப் படைத்தவரே உன் நாயகர்;","poem":1},{"text":"சேனைகளின் யெகோவா என்பது அவருடைய பெயர்,","poem":2},{"text":"இஸ்ரயேலின் பரிசுத்தரே உனது மீட்பர்;","poem":1},{"text":"அவர் பூமி முழுவதற்கும் இறைவன் என்னப்படுவார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"கைவிடப்பட்டு உள்ளத்தில் துக்கங்கொண்ட ஒரு மனைவியை அழைப்பதுபோலவும்,","poem":1},{"text":"இளமையில் திருமணம் செய்தும் விலக்கப்பட்ட மனைவியைத் திரும்பவும் அழைப்பதுபோலவும்","poem":2},{"text":"யெகோவா உன்னைத் திரும்பவும் அழைப்பார்”","poem":1},{"text":"என்று உனது இறைவன் சொல்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“நான் ஒரு நொடிப்பொழுது உன்னைக் கைவிட்டேன்,","poem":1},{"text":"ஆனால் ஆழ்ந்த இரக்கத்துடன் நான் உன்னைத் திரும்பவும் ஏற்றுக்கொள்வேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் கோபம் பொங்கி எழுந்ததால்,","poem":1},{"text":"உன்னிடமிருந்து என் முகத்தை ஒரு நொடிப்பொழுதே மறைத்தேன்;","poem":2},{"text":"ஆனால், நித்திய தயவுடன்","poem":1},{"text":"நான் உன்னில் இரக்கங்கொள்வேன்” என்று,","poem":2},{"lineBreak":true},{"text":"உன் மீட்பராகிய யெகோவா சொல்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“இது எனக்கு நோவாவின் நாட்களில் நடந்ததுபோல் இருக்கின்றது;","poem":1},{"text":"நோவாவின் நாட்களில் வந்த பெருவெள்ளம் இனி ஒருபோதும் பூமியை மூடமாட்டாது","poem":2},{"lineBreak":true},{"text":"என்று நான் ஆணையிட்டேன்.","poem":2},{"text":"ஆகவே இப்பொழுதோ உங்களுடன் கோபங்கொள்ளவோ,","poem":1},{"text":"அல்லது இனி ஒருபோதும் உங்களைக் கண்டிக்கவோ மாட்டேன்","poem":2},{"lineBreak":true},{"text":"என்று நான் ஆணையிட்டிருக்கிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"மலைகள் அசைக்கப்பட்டாலும்,","poem":1},{"text":"குன்றுகள் அகற்றப்பட்டாலும்","poem":2},{"text":"உன்மீதுள்ள என் நேர்மையான அன்பு அசைக்கப்படமாட்டாது;","poem":1},{"text":"என் சமாதானத்தின் உடன்படிக்கை அகற்றப்படமாட்டாது”","poem":2},{"lineBreak":true},{"text":"என்று உன்னில் இரக்கமுள்ள யெகோவா சொல்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“துன்புறுத்தப்பட்டிருக்கும் பட்டணமே, புயல்காற்றினால் அடிக்கப்பட்டு,","poem":1},{"text":"தேற்றப்படாமல் இருக்கும் பட்டணமே,","poem":2},{"text":"நான் உன்னை நீல இரத்தினக் கற்களாலும்,","poem":1},{"text":"உன் அஸ்திபாரங்களை இரத்தினக் கற்களாலும் கட்டுவேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உனது கொத்தளங்களை சிவப்புக் கற்களாலும்,","poem":1},{"text":"உனது வாசல்களை மினுமினுக்கும் கற்களாலும்,","poem":2},{"lineBreak":true},{"text":"உனது மதில்கள் எல்லாவற்றையும் மாணிக்கக் கற்களாலும் கட்டுவேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"உன் பிள்ளைகள் யாவரும் யெகோவாவினால் போதிக்கப்பட்டிருப்பார்கள்;","poem":1},{"text":"அவர்களுடைய சமாதானமும் பெரிதாயிருக்கும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நீ நீதியில் நிலைநாட்டப்படுவாய்:","poem":1},{"lineBreak":true},{"text":"கொடுமை உன்னைவிட்டுத் தூரமாகும்;","poem":1},{"text":"நீ பயப்படுவதற்கு எதுவுமிராது.","poem":2},{"text":"பயங்கரம் உன்னைவிட்டுத் தூரமாய் அகற்றப்படும்;","poem":1},{"text":"அது உனக்குக் கிட்டவராது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"உன்னை யாராவது தாக்கினால் அது எனது செயல் அல்ல;","poem":1},{"text":"உன்னைத் தாக்குகிறவன் எவனும் உன்னிடம் சரணடைவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“இதோ நானே நெருப்புத் தணலை","poem":1},{"text":"ஊதி வேலைக்கேற்ற","poem":2},{"lineBreak":true},{"text":"ஆயுதங்களைச் செய்யும் கொல்லனை படைத்தேன்.","poem":2},{"text":"பாழாக்கும் அழிவுகாரனையும் நானே படைத்தேன்.","poem":1}]},{"type":"verse","number":17,"content":[{"text":"ஆகவே உனக்கு எதிராகச் செய்யப்படும் ஆயுதம் எதுவும் வெற்றிகொள்ளாது,","poem":2},{"lineBreak":true},{"text":"உன்னைக் குற்றம் சாட்டும் ஒவ்வொரு நாவிற்கும் நீ அதன் பிழையைக் காட்டுவாய்.","poem":2},{"text":"யெகோவாவின் ஊழியருக்கு என்னிடமிருந்து கிடைக்கும்","poem":1},{"text":"அவர்களுக்குரிய நியாயப்படுத்துதல் இதுவே,","poem":2},{"text":"என்னிடமிருந்து கிடைக்கும் சொத்துரிமையும் இதுவே”","poem":1},{"text":"என்று யெகோவா சொல்லுகிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/53.json","previousChapterAudioLinks":{},"numberOfVerses":17}