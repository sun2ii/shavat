{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":55,"content":[{"type":"heading","content":["தாகமுள்ளோருக்கு அழைப்பு"]},{"type":"verse","number":1,"content":[{"text":"“ஓ! தாகமாய் இருக்கிறவர்களே, நீங்கள் எல்லோரும்","poem":1},{"text":"நீங்கள் நீர்நிலைகளுக்கு வாருங்கள்;","poem":2},{"text":"பணமில்லாதவர்களே, நீங்களும் வாருங்கள்,","poem":1},{"text":"வாங்கி உட்கொள்ளுங்கள்.","poem":2},{"text":"வாருங்கள், பணமுமின்றி விலையுமின்றி","poem":1},{"text":"திராட்சரசமும் பாலும் வாங்குங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உணவுக்கு உதவாதவற்றின்மேல் பணத்தை ஏன் செலவிடுகிறீர்கள்?","poem":1},{"text":"திருப்தி அளிக்காதவற்றின்மேல் ஏன் பிரயாசப்படுகிறீர்கள்?","poem":2},{"text":"கேளுங்கள், நான் சொல்வதைக் கேளுங்கள், நல்லதையே சாப்பிடுங்கள்.","poem":1},{"text":"அப்பொழுது உங்கள் ஆத்துமா கொழுமையான உணவின் நிறைவுகளினால் மகிழும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"காது கொடுத்துக் கேளுங்கள், என்னிடம் வாருங்கள்;","poem":1},{"text":"உங்கள் ஆத்துமா வாழ்வதற்காக நான் சொல்வதைக் கேளுங்கள்.","poem":2},{"text":"நான் உங்களுடன் ஒரு நித்திய உடன்படிக்கையைச் செய்வேன்;","poem":1},{"text":"நான் தாவீதுக்கு வாக்களித்த எனது உண்மையான அன்பை உங்களுக்குக் கொடுப்பேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இதோ, நான் அவனை மக்கள் கூட்டங்களுக்கு ஒரு சாட்சியாகவும்,","poem":1},{"text":"மக்கள் கூட்டங்களுக்குத் தலைவனாகவும், தளபதியாகவும் அவனை வைத்தேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆகையால் நிச்சயமாகவே நீங்கள் அறியாத நாடுகளுக்கு அழைப்பாய்,","poem":1},{"text":"உங்களை அறியாத பிறநாடுகள் உங்களிடம் விரைந்து வருவார்கள்.","poem":2},{"text":"ஏனெனில் இஸ்ரயேலின் பரிசுத்தரும்","poem":1},{"text":"இறைவனுமான உங்கள் யெகோவா","poem":2},{"lineBreak":true},{"text":"உங்களைச் சிறப்பினால் அலங்கரித்துள்ளார்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவரைக் கண்டுகொள்ள வாய்ப்புள்ள வேளையில் யெகோவாவைத் தேடுங்கள்;","poem":1},{"text":"அவர் அருகிலிருக்கையில் அவரைக் கூப்பிடுங்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கொடியவன் தன் வழிகளையும்,","poem":1},{"text":"தீயவன் தன் எண்ணங்களையும் கைவிடட்டும்;","poem":2},{"text":"அவன் யெகோவாவிடம் திரும்பட்டும், அவர் அவனுக்கு இரக்கம் காட்டுவார்,","poem":1},{"text":"எங்கள் இறைவனிடம் திரும்பட்டும், அவர் அவனை தாராளமாக மன்னிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“என் எண்ணங்கள் உங்கள் எண்ணங்களல்ல;","poem":1},{"text":"உங்கள் வழிகள் என் வழிகளுமல்ல”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்லுகிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“பூமியைப் பார்க்கிலும் வானங்கள் உயர்ந்தனவாய் இருக்கின்றது போலவே,","poem":1},{"text":"என் வழிகளும் உங்கள் வழிகளைப் பார்க்கிலும் உயர்ந்தவையாய் இருக்கின்றன.","poem":2},{"lineBreak":true},{"text":"என் எண்ணங்களும் உங்கள் எண்ணங்களிலும் மேலானவை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"மழையும் உறைபனியும் வானத்திலிருந்து கீழே இறங்குகின்றன;","poem":1},{"text":"அவை பூமிக்கு நீர்ப்பாய்ச்சி,","poem":2},{"text":"அதில் முளையை எழும்பப்பண்ணி வளரச் செய்யாமல்","poem":1},{"text":"அவை திரும்பிச் செல்வதில்லை.","poem":2},{"text":"எனவே அவை விதைப்பவனுக்கு விதையையும்,","poem":1},{"text":"உண்பவனுக்கு உணவையும் கொடுக்கின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் வாயிலிருந்து வெளிவரும் வார்த்தையும் அப்படியே இருக்கிறது:","poem":1},{"text":"நான் விரும்பியவற்றைச் செய்து,","poem":2},{"text":"நான் அதை அனுப்பிய நோக்கத்தை நிறைவேற்றாமல்","poem":1},{"text":"அது வெறுமையாய் என்னிடம் திரும்பி வராது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீங்கள் பாபிலோனிலிருந்து மகிழ்ச்சியுடன் வெளியேறி","poem":1},{"text":"சமாதானத்துடன் வழிநடத்தப்படுவீர்கள்;","poem":2},{"text":"மலைகளும் குன்றுகளும்","poem":1},{"text":"உங்கள் முன்பாக ஆர்ப்பரித்துப் பாடும்;","poem":2},{"text":"வெளியின் மரங்கள் யாவும்","poem":1},{"text":"கைகொட்டும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"முட்செடிகளுக்குப் பதிலாக தேவதாரு மரங்களும்,","poem":1},{"text":"காஞ்சொறிக்குப் பதிலாக மிருதுச் செடிகளும் முளைக்கும்.","poem":2},{"text":"இது யெகோவாவுக்கு புகழ்ச்சியாகவும்,","poem":1},{"text":"அழியாத நித்திய","poem":2},{"lineBreak":true},{"text":"அடையாளமாகவும் இருக்கும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/54.json","previousChapterAudioLinks":{},"numberOfVerses":13}