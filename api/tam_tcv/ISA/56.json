{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":56,"content":[{"type":"heading","content":["அந்நியருக்கும் இரட்சிப்பு"]},{"type":"verse","number":1,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“நியாயத்தைக் கைக்கொண்டு","poem":1},{"text":"நீதியைச் செய்யுங்கள்.","poem":2},{"text":"ஏனெனில், எனது இரட்சிப்பு சமீபமாய் இருக்கிறது;","poem":1},{"text":"எனது நீதி விரைவில் வெளிப்படுத்தப்படும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இதை செய்கிறவர்களும், இவற்றை உறுதியாய் பற்றிக்கொண்டு கைக்கொண்டு,","poem":1},{"text":"ஓய்வுநாளை தூய்மைக்கேடாக்காமல் கடைபிடித்து,","poem":2},{"text":"தீமைசெய்யாதபடி தன் கையை விலக்கிக் காத்துக்கொள்கிற மனிதர்கள்","poem":1},{"text":"ஆசீர்வதிக்கப்பட்டவர்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவோடு தன்னை இணைத்துக்கொண்டிருக்கும் அந்நியர்,","poem":1},{"text":"“யெகோவா என்னைத் தமது மக்களிடமிருந்து நிச்சயமாகப் பிரித்துவிடுவார்”","poem":2},{"lineBreak":true},{"text":"என்று சொல்லாமல் இருக்கட்டும்.","poem":2},{"text":"அவ்வாறே அண்ணகன் எவனும், “நான் பட்டுப்போன மரந்தானே”","poem":1},{"text":"என்று முறைப்பாடு சொல்லாமலும் இருக்கட்டும்.","poem":2}]},{"type":"verse","number":4,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“எனது ஓய்வுநாளை கடைப்பிடித்து,","poem":1},{"text":"எனக்கு விருப்பமானவற்றைத் தெரிந்துகொண்டு","poem":2},{"lineBreak":true},{"text":"என் உடன்படிக்கையை உறுதியாய்க் கைக்கொள்கிறவர்களான அண்ணகர்களுக்கு,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என் ஆலயத்திற்குள்ளும், அதின் சுவர்களிலும் ஒரு நினைவுச் சின்னத்தையும்,","poem":1},{"text":"மகன்கள் மற்றும் மகள்களுக்குமுரிய பெயர்களைவிடச் சிறந்த","poem":2},{"lineBreak":true},{"text":"ஒரு பெயரையும் கொடுப்பேன்.","poem":2},{"text":"ஒருபோதும் அழிந்துபோகாதிருக்கிற","poem":1},{"text":"நித்திய பெயரையும் அவர்களுக்குக் கொடுப்பேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவை அண்டியிருந்து,","poem":1},{"text":"அவருக்கு ஊழியம் செய்து,","poem":2},{"text":"யெகோவாவினுடைய பெயரை நேசித்து அவரை வழிபடும் பிறதேசத்தார் அனைவருக்கும்,","poem":1},{"text":"ஓய்வுநாட்களை தூய்மைக்கேடாக்காமல்","poem":2},{"text":"அதைக் கைக்கொண்டு எனது உடன்படிக்கையை","poem":1},{"text":"உறுதியாய் பற்றிக்கொள்ளும் அனைவருக்கும் சொல்வதாவது:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் அவர்களை என் பரிசுத்த மலைக்குக் கொண்டுவந்து,","poem":1},{"text":"என் ஜெபவீட்டில் அவர்களுக்கு மகிழ்ச்சியைக் கொடுப்பேன்.","poem":2},{"text":"அவர்களின் தகனபலிகளும்,","poem":1},{"text":"மற்ற பலிகளும் எனது பலிபீடத்தில் ஏற்றுக்கொள்ளப்படும்.","poem":2},{"text":"ஏனெனில், எனது வீடு எல்லா நாடுகளுக்கும்","poem":1},{"text":"ஜெபவீடு என்று அழைக்கப்படும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நாடுகடத்தப்பட்ட இஸ்ரயேலரைச் சேர்க்கும்","poem":1},{"text":"ஆண்டவராகிய யெகோவா அறிவிக்கிறார்:","poem":2},{"text":"ஏற்கெனவே சேர்க்கப்பட்டவர்களோடுகூட","poem":1},{"text":"இன்னும் மற்றவர்களையும் நான் கூட்டிச்சேர்ப்பேன்.”","poem":2}]},{"type":"heading","content":["கொடியோருக்கு விரோதமான இறைவன்"]},{"type":"verse","number":9,"content":[{"text":"வயலின் மிருகங்களே, எல்லோரும் வாருங்கள்.","poem":1},{"text":"காட்டு மிருகங்களே, எல்லோரும் வந்து இரையை விழுங்குங்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இஸ்ரயேலின் காவலாளிகள் அனைவரும்","poem":1},{"text":"அறிவில்லாத குருடர்;","poem":2},{"text":"அவர்கள் எல்லோரும் குரைக்கமாட்டாத","poem":1},{"text":"ஊமையான நாய்கள்;","poem":2},{"text":"அவர்கள் படுத்துக் கிடந்து கனவு காண்கிறார்கள்,","poem":1},{"text":"நித்திரை செய்யவே விரும்புகிறவர்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் பெரும் பசிகொண்ட நாய்கள்;","poem":1},{"text":"அவர்கள் ஒருபோதும் திருப்தியடைவதில்லை.","poem":2},{"text":"பகுத்தறிவு இல்லாத மேய்ப்பர்கள்,","poem":1},{"text":"அவர்கள் எல்லாரும் தங்கள் சொந்த வழிக்குத் திரும்பி,","poem":2},{"lineBreak":true},{"text":"ஒவ்வொருவனும் தன் சுய இலாபத்தையே தேடுகிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஒவ்வொருவரும் சத்தமிட்டு, “வாருங்கள்;","poem":1},{"text":"நாம் போய் திராட்சைமது கொண்டுவருவோம்;","poem":2},{"lineBreak":true},{"text":"நாம் மதுவை நிறையக் குடிப்போம்,","poem":2},{"text":"நாளைய தினமும் இன்றுபோல் இருக்கும்,","poem":1},{"text":"அல்லது இதைவிடச் சிறப்பாகவும் இருக்கும்” என்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/55.json","previousChapterAudioLinks":{},"numberOfVerses":12}