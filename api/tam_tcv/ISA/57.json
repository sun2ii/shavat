{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":57,"content":[{"type":"verse","number":1,"content":[{"text":"நீதியானவர்கள் அழிகின்றார்கள்,","poem":1},{"text":"இதைப்பற்றி ஒருவருமே தங்கள் இருதயத்தில் சிந்திப்பதில்லை;","poem":2},{"text":"பக்தியுள்ளவர்களும் எடுத்துக்கொள்ளப்படுகிறார்கள்;","poem":1},{"text":"தீமையிலிருந்து தப்பித்துக்கொள்ளும்படியாகவே,","poem":2},{"text":"நீதியுள்ளவர்கள் எடுத்துக்கொள்ளப்படுகிறார்கள்","poem":1},{"text":"என்பதை ஒருவரும் விளங்கிக்கொள்வதில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீதியாய் நடக்கிறவர்கள் சமாதானத்திற்குள் சென்றடைந்து,","poem":1},{"text":"தங்கள் மரணத்தில் படுத்திருக்கும்போது,","poem":2},{"lineBreak":true},{"text":"இளைப்பாறுதல் பெறுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“ஆனால், மந்திரவாதிகளின் பிள்ளைகளே,","poem":1},{"text":"விபசாரிகளுக்கும் வேசிகளுக்கும் பிறந்த பிள்ளைகளே, நீங்கள் இங்கே வாருங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யாரை நீங்கள் ஏளனம்பண்ணுகிறீர்கள்?","poem":1},{"text":"யாரைப் பழிக்க உங்கள் வாயைத்","poem":2},{"lineBreak":true},{"text":"உங்கள் நாவை நீட்டுகிறீர்கள்?","poem":2},{"text":"நீங்கள் கலகக்காரரின் பிள்ளைகள் அல்லவா?","poem":1},{"text":"பொய்யரின் சந்ததியல்லவா?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீங்கள் தேவதாரு மரங்களுக்கிடையிலும்,","poem":1},{"text":"ஒவ்வொரு படர்ந்த மரத்தினடியிலும் காமவெறி கொள்கிறீர்கள்;","poem":2},{"text":"பாறைகளின் வெடிப்புகளிலும், தொங்கும் பாறைகளின் கீழும்","poem":1},{"text":"உங்கள் பிள்ளைகளைப் பலியிடுகிறீர்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வெடிப்புகளின் வழுவழுப்பான கற்களின் இடையில் இருக்கும்","poem":1},{"text":"விக்கிரங்களே உங்கள் பங்கு;","poem":2},{"lineBreak":true},{"text":"அவை, அவைதான் உங்கள் பாகம்.","poem":2},{"text":"ஆம், அவைகளுக்கே நீங்கள் பானபலியை வார்த்து,","poem":1},{"text":"தானியபலியையும் செலுத்தியிருக்கிறீர்கள்.","poem":2},{"lineBreak":true},{"text":"இவை வெளிப்படையாயிருக்க நான் உங்களுக்குக் கருணைகாட்ட வேண்டுமோ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நீ உயரமும், உன்னதமுமான குன்றின்மேல் உன் படுக்கையை விரித்தாய்;","poem":1},{"text":"பலிகளைச் செலுத்துவதற்காக நீ மேலே போனாய்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"உனது கதவுகளுக்கும், உனது கதவு நிலைகளுக்கும் பின்னால்","poem":1},{"text":"நீ உனது தெய்வச் சின்னங்களை வைத்தாய்.","poem":2},{"text":"என்னைக் கைவிட்டு உன் படுக்கையை விரித்தாய்,","poem":1},{"text":"அதிலேறி அதை அகலமாக்கினாய்;","poem":2},{"text":"நீ எவர்களுடைய படுக்கையை விரும்பினாயோ அவர்களோடு ஒப்பந்தம் செய்தாய்,","poem":1},{"text":"நீ அவர்களுடைய நிர்வாணத்தைப் பார்த்தாய்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீ ஒலிவ எண்ணெயுடன் மோளேக்","poem":1},{"noteId":28},{"text":"தெய்வத்திடம் போனாய்;","poem":1},{"text":"நீ வாசனைத் தைலங்களை அதிகமாய்ப் பூசிக்கொண்டாய்.","poem":2},{"text":"நீ உனது தூதுவரை வெகுதூரத்திற்கு அனுப்பினாய்;","poem":1},{"text":"அவர்களைப் பாதாளத்துக்குள்ளுங்கூட இறங்கப்பண்ணினாய்!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உங்கள் எல்லா முயற்சிகளாலும் நீங்கள் களைத்துப்போனீர்கள்,","poem":1},{"text":"ஆயினும் நீங்கள், ‘அது பயனற்றது’ என்று சொல்லவில்லை.","poem":2},{"text":"நீங்கள் கையில் புதிய பெலனை பெற்றபடியால்","poem":1},{"text":"சோர்ந்துபோகவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“நீ யாருக்குப் பயந்து, நடுங்கி","poem":1},{"text":"எனக்குப் பொய்யாய் நடந்தாய்?","poem":2},{"text":"என்னை நினையாமலும்","poem":1},{"text":"இதைப்பற்றி உன் இருதயத்தில் சிந்திக்காமலும் இருந்தாய்?","poem":2},{"text":"நான் நெடுங்காலமாக அமைதியாய் இருந்தபடியினாலன்றோ","poem":1},{"text":"நீ எனக்குப் பயப்படாது போனாய்?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நான் உனது நீதியையும் உனது வேலைகளையும்","poem":1},{"text":"உனது செயல்களையும் வெளிப்படுத்துவேன்;","poem":2},{"lineBreak":true},{"text":"அவை உனக்கு உதவாது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீ உதவிகேட்டு அழுகிறபோது,","poem":1},{"text":"நீ சேகரித்த விக்கிரகங்கள் உன்னைக் காப்பாற்றட்டும்!","poem":2},{"text":"காற்று அவைகளை அள்ளிக்கொண்டு போகுமே!","poem":1},{"text":"வெறும் மூச்சே அவைகளை அடித்துக்கொண்டும்.","poem":2},{"text":"ஆனால் என்னை நம்பியிருக்கிறவர்களோ,","poem":1},{"text":"நாட்டைத் தன் சொத்துரிமையாக்கி,","poem":2},{"lineBreak":true},{"text":"எனது பரிசுத்த மலையையும் சொந்தமாக்கிக்கொள்வார்கள்.”","poem":2}]},{"type":"heading","content":["மனமுடைந்தோருக்கு ஆறுதல்"]},{"type":"verse","number":14,"content":["அப்பொழுது:",{"text":"“கட்டுங்கள், கட்டுங்கள், வீதியை ஆயத்தம் பண்ணுங்கள்!","poem":1},{"text":"எனது மக்களின் வழியிலுள்ள தடைகளை நீக்கிவிடுங்கள்” என்று சொல்லப்படும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"உயர்ந்திருப்பவரும், உன்னதமானவரும், என்றென்றும் வாழ்பவருமான","poem":1},{"text":"பரிசுத்தர் என்னும் பெயரையுடையவர் சொல்வதாவது:","poem":2},{"text":"“இறைவனாகிய நான் உயரமான பரிசுத்த இடத்தில் வாழ்கிறேன்.","poem":1},{"text":"ஆனாலும் மனமுடைந்தவர்களுடனும், தாழ்மையான ஆவியுடையவர்களுடனும் இருக்கிறேன்.","poem":2},{"text":"ஆவியில் தாழ்மையுடையவர்களுக்குப் புத்துயிர் கொடுக்கவும்,","poem":1},{"text":"மனமுடைந்தவர்களின் இருதயத்தைத் திடப்படுத்தவும் நான் அவர்களுடன் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நான் என்றென்றும் குற்றஞ்சாட்டமாட்டேன், எப்பொழுதும் கோபமாயிருக்கமாட்டேன்.","poem":1},{"text":"ஏனெனில் அப்பொழுது மனிதனின் ஆவி,","poem":2},{"text":"என்னால் படைக்கப்பட்ட மனித சுவாசம்,","poem":1},{"text":"எனக்குமுன் சோர்வடைந்துவிடும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவனுடைய பாவ பேராசையின் காரணமாக நான் அவன்மீது கடுங்கோபம் கொண்டேன்,","poem":1},{"text":"அவனைத் தண்டித்து கோபத்தில் என் முகத்தை மறைத்தேன்,","poem":2},{"lineBreak":true},{"text":"ஆனாலும் அவன் தன் மனம்போன போக்கிலேயே தொடர்ந்து போய்க்கொண்டிருந்தான்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவனுடைய வழிகளை நான் கண்டிருக்கிறேன்;","poem":1},{"text":"ஆயினும் நான் அவனைச் சுகப்படுத்துவேன்;","poem":2},{"text":"அவனை வழிநடத்தி, மீண்டும் அவனுக்கு ஆறுதல் அளிப்பேன்;","poem":1}]},{"type":"verse","number":19,"content":[{"text":"நான் துயரப்படுகிறவர்களின் உதடுகளில் துதியைக் கொண்டுவருவேன்.","poem":2},{"text":"தொலைவிலும் அருகிலும் உள்ளவர்களுக்குச் சமாதானம், சமாதானம் என்றும்,","poem":1},{"text":"அவர்களை நான் சுகப்படுத்துவேன்”","poem":2},{"text":"என்றும் யெகோவா சொல்கிறார்.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"ஆனால் கொடியவர்களோ, கொந்தளிக்கும் கடலைப்போல் இருக்கிறார்கள்;","poem":1},{"text":"அதற்கு அமைதியாய் இருக்கமுடியாது,","poem":2},{"lineBreak":true},{"text":"அதன் அலைகள் சேற்றையும் சகதியையும் அள்ளிக்கொண்டுவரும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"“கொடியவருக்கோ, மன அமைதி இல்லை” என்று என் இறைவன் சொல்கிறார்.","poem":1}]}],"footnotes":[{"noteId":28,"caller":"+","text":"மோளேக் அல்லது அரசனிடம்","reference":{"chapter":57,"verse":9}}]},"thisChapterLink":"/api/tam_tcv/ISA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/56.json","previousChapterAudioLinks":{},"numberOfVerses":21}