{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":58,"content":[{"type":"heading","content":["உண்மை உபவாசம்"]},{"type":"verse","number":1,"content":[{"text":"“உரத்த சத்தமிடு; அடக்கிக்கொள்ளாதே!","poem":1},{"text":"எக்காளத்தைப்போல் உனது குரலை உயர்த்து.","poem":2},{"text":"என் மக்களுக்கு அவர்களுடைய மீறுதல்களையும்,","poem":1},{"text":"யாக்கோபின் குடும்பத்துக்கு அவர்களுடைய பாவங்களையும் அறிவி.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர்கள் நாள்தோறும் என்னைத் தேடுகிறார்கள்,","poem":1},{"text":"அவர்கள் என் வழிகளை அறிவதில் ஆவலுள்ளவர்கள்போல் காட்டுகிறார்கள்.","poem":2},{"text":"இறைவனின் கட்டளைகளைக் கைவிடாமல்,","poem":1},{"text":"சரியானவற்றையே செய்யும் ஒரு நாட்டைப்போல், அவர்கள் தங்களைக் காண்பிக்கிறார்கள்.","poem":2},{"text":"அவர்கள் நேர்மையான தீர்மானங்களை என்னிடம் கேட்கிறார்கள்;","poem":1},{"text":"இறைவனை நெருங்கிவர விரும்புகிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"‘நாங்கள் உபவாசித்தோம், என்று அவர்கள் கேட்கிறார்கள்.","poem":1},{"text":"நீர் அதைக் காணவில்லையா?","poem":2},{"text":"நாங்கள் ஏன் எங்களைத் தாழ்த்தினோம்;","poem":1},{"text":"நீர் அதைக் கவனிக்கவில்லையா?’","poem":2},{"lineBreak":true},{"text":"“நீங்கள் உபவாசிக்கும் நாளில் நீங்கள் விரும்பியதையே செய்து,","poem":1},{"text":"உங்கள் வேலைக்காரரையும் கடுமையாய் நடத்துகிறீர்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உங்கள் உபவாசம் வாக்குவாதத்திலும், சண்டையிலும்,","poem":1},{"text":"கொடுமையான கைகளினால் ஒருவரையொருவர் அடித்துக்கொள்வதிலுமே முடிகிறது.","poem":2},{"text":"நீங்கள் இன்று உபவாசம் செய்வதுபோல் உபவாசித்தால்,","poem":1},{"text":"உங்கள் குரல் பரலோகத்திற்கு எட்டுமென எதிர்பார்க்க முடியாதே.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இப்படியான உபவாசத்தையா நான் தெரிந்துகொண்டேன்?","poem":1},{"text":"அது ஒருவன் தன்னைத் தாழ்த்திக்கொள்ளுவதற்கான நாள் மட்டுமோ?","poem":2},{"text":"உபவாசம் என்பது துக்கவுடையில்,","poem":1},{"text":"சாம்பலில் கிடந்து நாணல் புல்லைப்போல் தலைகுனிவது மட்டுமா?","poem":2},{"text":"இதையா யெகோவா ஏற்றுக்கொள்ளும் உபவாசம் என்றும்","poem":1},{"text":"அவருக்கு ஏற்ற நாள் என்றும் சொல்கிறீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“நான் தெரிந்துகொண்ட உபவாசம் என்பது:","poem":1},{"lineBreak":true},{"text":"அநீதியின் சங்கிலிகளைத் தளர்த்துவதும்,","poem":1},{"text":"நுகத்தின் கயிறுகளை அவிழ்ப்பதும்,","poem":2},{"text":"ஒடுக்கப்பட்டோரை விடுதலையாக்குவதும்,","poem":1},{"text":"ஒவ்வொரு நுகத்தையும் உடைத்துப் போடுவதும் அல்லவோ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"பசியுற்றோருடன் உங்கள் உணவைப் பகிர்ந்துகொள்வதும்,","poem":1},{"text":"வீடற்ற ஏழைகளுக்கு இருப்பிடம் கொடுப்பதும்,","poem":2},{"text":"உடையில்லாதவனைக் கண்டால் அவனுக்கு உடை கொடுப்பதும்,","poem":1},{"text":"உன் சொந்த உறவினர்களிடமிருந்து","poem":2},{"lineBreak":true},{"text":"உன் முகத்தைத் திருப்பிக்கொள்ளாதிருப்பதும் அல்லவோ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அப்பொழுது உனது வெளிச்சம் விடியற்காலை வெளிச்சத்தைப்போல் பிரகாசிக்கும்;","poem":1},{"text":"நீ விரைவில் சுகவாழ்வு துளிர்க்கும்.","poem":2},{"text":"உங்கள் நீதி உங்கள்முன் செல்லும்,","poem":1},{"text":"யெகோவாவின் மகிமை உங்களைப் பின்னாலே காக்கும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அப்பொழுது நீ கூப்பிடுவாய், யெகோவா பதிலளிப்பார்;","poem":1},{"text":"நீ உதவிகேட்டு அழுவாய், ‘நான் இங்கே இருக்கிறேன்’ என்று அவர் சொல்வார்.","poem":2},{"lineBreak":true},{"text":"“ஒடுக்கும் நுகத்தையும், பிழையைச் சுட்டிக்காட்டும் விரலையும்,","poem":1},{"text":"தீமையின் பேச்சையும் நீக்கிவிடு.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"பசியுற்றோருக்கு உன்னையே கொடுத்து,","poem":1},{"text":"ஒடுக்கப்பட்டோரின் தேவையைத் திருப்தியாக்கு.","poem":2},{"text":"அப்பொழுது இருளில் உன்னுடைய வெளிச்சம் உதிக்கும்,","poem":1},{"text":"உன்னுடைய இரவும் மத்தியானத்தைப்போல் இருக்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவா உன்னை எப்பொழுதும் வழிநடத்துவார்;","poem":1},{"text":"வெயிலால் பாதிக்கப்பட்ட இடங்களிலும் அவர் உன் தேவைகளைத் திருப்தி செய்து,","poem":2},{"lineBreak":true},{"text":"உன் எலும்புகளை பெலனுள்ளதாக்குவார்.","poem":2},{"text":"நீ நன்றாக நீர்ப்பாய்ச்சிய தோட்டத்தைப் போலவும்,","poem":1},{"text":"வற்றாத நீரூற்றைப் போலவும் இருப்பாய்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உன் மக்கள் பாழடைந்த இடிபாடுகளைத் திருப்பிக் கட்டுவார்கள்;","poem":1},{"text":"பழங்கால அஸ்திபாரங்களையும் கட்டி எழுப்புவார்கள்.","poem":2},{"text":"நீ உடைந்த மதில்களைத் திருத்திக் கட்டுகிறவன் என்றும்,","poem":1},{"text":"குடியிருப்பதற்கு வீதிகளைப் புதுப்பிக்கிறவன் என்றும் அழைக்கப்படுவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ஓய்வுநாளின் சட்டங்களை மீறுவதிலிருந்து உன் கால்களை விலக்கு;","poem":1},{"text":"என் பரிசுத்த நாளில் நீ உனக்கு விரும்பிய விதமாய் நடவாதே.","poem":2},{"text":"ஓய்வுநாளான யெகோவாவினுடைய பரிசுத்த நாளை,","poem":1},{"text":"மகிழ்ச்சியின் நாளென்றும் மேன்மையின் நாளென்றும் அழை.","poem":2},{"text":"உன் சொந்த வழியில் போகாமலும், நீ விரும்பியவாறு செய்யாமலும்,","poem":1},{"text":"வீண் வார்த்தைகளைப் பேசாமலும் அந்நாளை மேன்மைப்படுத்து.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அப்பொழுது நீ யெகோவாவிடம் மகிழ்ச்சிகொள்வாய்,","poem":1},{"text":"நாட்டின் உயர்ந்த இடங்களில் நான் உன்னை ஏறியிருக்கும்படி செய்வேன்.","poem":2},{"lineBreak":true},{"text":"உன் தகப்பன் யாக்கோபின் சுதந்திரத்தில் நீ களிப்படையும்படி செய்வேன்.”","poem":2},{"text":"யெகோவாவின் வாயே இதைச் சொல்லிற்று.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/57.json","previousChapterAudioLinks":{},"numberOfVerses":14}