{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":59,"content":[{"type":"heading","content":["பாவ அறிக்கையும் மீட்பும்"]},{"type":"verse","number":1,"content":[{"text":"நிச்சயமாகவே, காப்பாற்ற முடியாதபடி யெகோவாவின் கரம் குறுகிப்போகவில்லை;","poem":1},{"text":"கேட்க முடியாதபடி அவருடைய காது மந்தமாகவுமில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஆனால், உங்களுடைய பாவங்களே,","poem":1},{"text":"உங்கள் இறைவனிடமிருந்து உங்களைப் பிரித்திருக்கின்றன.","poem":2},{"text":"உங்கள் பாவங்களே அவர் செவிசாய்க்காதபடி,","poem":1},{"text":"அவருடைய முகத்தை உங்களிடமிருந்து மறைத்திருக்கின்றன.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஏனெனில் உங்கள் கைகள் இரத்தத்தினாலும்,","poem":1},{"text":"உங்கள் விரல்கள் குற்றத்தினாலும் கறைபட்டிருக்கின்றன;","poem":2},{"text":"உங்கள் உதடுகள் பொய்களைப் பேசி,","poem":1},{"text":"உங்கள் நாவுகள் கொடுமையானவற்றை முணுமுணுத்திருக்கின்றன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஒருவனும் நீதிக்காக வாதாடுவதில்லை;","poem":1},{"text":"ஒருவனும் உத்தமமாய் தன் வழக்கைப் பேசுவதில்லை.","poem":2},{"text":"அவர்கள் அர்த்தமற்ற விவாதத்தில் நம்பிக்கை வைத்து, பொய் பேசி,","poem":1},{"text":"தீங்கைக் கருத்தரித்து பாவத்தைப் பெற்றெடுக்கிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர்கள் விரியன் பாம்பின் முட்டைகளை அடைகாத்து,","poem":1},{"text":"சிலந்தி வலையைப் பின்னுகிறார்கள்.","poem":2},{"text":"அவைகளின் முட்டையை உண்பவன் எவனும் சாவான்;","poem":1},{"text":"அவைகளில் ஒன்று உடைந்தால் விரியன் பாம்பு வெளிவரும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்களின் சிலந்தி வலைப் பின்னல்கள், உடைக்கு உபயோகமற்றவை;","poem":1},{"text":"அவர்கள் செய்தவற்றால் தங்களை மூடிக்கொள்ளவும் இயலாது.","poem":2},{"text":"அவர்களுடைய செயல்களெல்லாம் தீமையானவையே;","poem":1},{"text":"அவர்களின் கைகளில் வன்செயல்களே இருக்கின்றன.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்களுடைய கால்கள் தீமைசெய்ய விரைகின்றன;","poem":1},{"text":"குற்றமற்றவர்களின் இரத்தத்தைச் சிந்துவதற்கு அவர்கள் விரைகிறார்கள்.","poem":2},{"text":"அவர்கள் சிந்தனைகளும் தீமையான சிந்தனையே;","poem":1},{"text":"பாழாக்குதலும் அழிவும் அவர்களின் வழித்தடங்களில் இருக்கின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"சாமாதானத்தின் வழியை அவர்கள் அறியமாட்டார்கள்;","poem":1},{"text":"அவர்களின் பாதைகளில் நீதி இல்லை.","poem":2},{"text":"அவர்கள் தங்கள் பாதைகளைக் கோணலாக்கிக் கொண்டார்கள்;","poem":1},{"text":"அதில் நடப்பவர் எவருக்கும் சமாதானம் இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ஆகையால் நியாயம் எங்களுக்குத் தூரத்திலே இருக்கிறது,","poem":1},{"text":"நீதி எங்களை நெருங்குவதில்லை;","poem":2},{"text":"வெளிச்சத்தை எதிர்பார்த்திருந்தோம், ஆனால் எல்லாமே இருளாயிருக்கின்றன.","poem":1},{"text":"பிரகாசத்தை எதிர்பார்த்திருந்தோம், ஆனாலும் காரிருளிலேயே நடக்கிறோம்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நாங்கள் குருடர்களைப்போல் சுவரைப் பிடித்து, தடவித் திரிகிறோம்;","poem":1},{"text":"கண்கள் இல்லாதவர்களைப்போல் எங்கள் வழியில் தடுமாறுகிறோம்.","poem":2},{"text":"மங்கிய மாலைப் பொழுதில் இடறுகிறதுபோல நடுப்பகலில் இடறுகிறோம்;","poem":1},{"text":"பெலனுள்ளவர்கள் மத்தியில்","poem":2},{"noteId":29},{"text":"மரித்தவரைப்போல் இருக்கிறோம்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நாங்கள் யாவரும் கரடிகளைப்போல் உறுமுகிறோம்;","poem":1},{"text":"புறாக்களைப்போல் கவலையுடன் விம்முகிறோம்.","poem":2},{"text":"நியாயத்திற்குக் காத்திருந்தோம், ஆனால் அதைக் காணவில்லை;","poem":1},{"text":"விடுதலையை எதிர்பார்த்திருந்தோம், அதுவும் தூரத்திலேயே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"எங்கள் மீறுதல்கள் உமது பார்வையில் அநேகமாய் இருக்கின்றன,","poem":1},{"text":"எங்கள் பாவங்கள் எங்களுக்கு எதிராகச் சாட்சி பகிருகின்றன.","poem":2},{"text":"எங்கள் மீறுதல்கள் எப்போதும் எங்களுடனேயே இருக்கின்றன;","poem":1},{"text":"எங்கள் அநியாயங்களை நாங்கள் ஏற்றுக்கொள்கிறோம்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவாவுக்கு விரோதமாகக் கலகமும் நம்பிக்கைத் துரோகமும் செய்தோம்;","poem":1},{"text":"எங்கள் இறைவனுக்கு முதுகைக் காட்டினோம்.","poem":2},{"text":"ஒடுக்குதலையும் கிளர்ச்சியையும் குறித்துப்பேசி,","poem":1},{"text":"எங்கள் இருதயங்களில் கருத்தரித்த பெரும் பொய்களை வெளிப்படுத்தினோம்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அதனால், நியாயம் பின்னே தள்ளப்பட்டிருக்கிறது;","poem":1},{"text":"நீதி தூரத்திலே நிற்கிறது;","poem":2},{"text":"உண்மை தெருக்களில் இடறி,","poem":1},{"text":"உத்தமம் உள்ளே வரமுடியாமல் இருக்கிறது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஒரு இடத்திலும் உண்மை காணப்படவில்லை;","poem":1},{"text":"தீமையைவிட்டு விலகுகிறவர்கள் இரையாவார்கள்.","poem":2},{"lineBreak":true},{"text":"யெகோவா அதைக்கண்டு, அங்கு நியாயமில்லாதபடியால்,","poem":1},{"text":"கோபங்கொண்டார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அங்கே ஒருவனும் இல்லாததை அவர் கண்டார்,","poem":1},{"text":"பரிந்து பேசுவதற்கு அங்கு ஒருவரும் இல்லையென அவர் கண்டு திகைப்படைந்தார்.","poem":2},{"text":"எனவே அவரின் சொந்தக் கரமே அவருக்கு இரட்சிப்பைக் கொண்டுவந்தது;","poem":1},{"text":"அவருடைய சொந்த நீதியே அவரைத் தாங்கியது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர் நீதியைத் தனது மார்புக்கவசமாய் அணிந்து,","poem":1},{"text":"இரட்சிப்பின் தலைச்சீராவைத் தலையில் வைத்துக்கொண்டார்;","poem":2},{"text":"அநீதிக்குப் பழிவாங்குதலின் உடையை அவர் உடுத்தி,","poem":1},{"text":"வைராக்கியத்தைத் தன் மேலங்கியாகப் போர்த்துக்கொண்டார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்கள் செய்தவற்றுக்கேற்ப","poem":1},{"text":"அவர் பதிலளிப்பார்.","poem":2},{"text":"கடுங்கோபத்தைத் தனது எதிரிகளுக்கும்,","poem":1},{"text":"தண்டனையைப் பகைவர்களுக்கும் கொடுப்பார்;","poem":2},{"lineBreak":true},{"text":"தீவுகளுக்கும் அவைகளின் செய்கைக்கேற்ப பதிலளிப்பார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"மேற்கிலுள்ள மனிதர் யெகோவாவின் பெயருக்குப் பயப்படுவார்கள்;","poem":1},{"text":"சூரியன் உதிக்கும் திசையிலுள்ளவர்கள் அவருடைய மகிமை நடுங்குவார்கள்.","poem":2},{"text":"ஏனெனில், யெகோவாவின் சுவாசத்தினால் அடித்துச் செல்லப்படும்","poem":1},{"text":"காட்டாற்று வெள்ளம்போல் அவர் வருவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“தங்கள் பாவங்களிலிருந்து மனந்திரும்பிய யாக்கோபின் வழித்தோன்றல்களிடம்,","poem":1},{"text":"சீயோனுக்கு மீட்பர் வருவார்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":21,"content":["“என்னைப் பொறுத்தவரை அவர்களுடன் எனது உடன்படிக்கை இதுவே” என்று யெகோவா சொல்கிறார். “உன் மேலிருக்கும் எனது ஆவியானவரும், உன் வாயில் நான் வைத்த என் வார்த்தைகளும் உன் வாயைவிட்டு நீங்கமாட்டாது, அவை உன் பிள்ளைகளின் வாய்களிலிருந்தும், அவர்களின் சந்ததிகளின் வாய்களிலிருந்தும் இப்பொழுதிலிருந்து என்றென்றைக்கும் நீங்கமாட்டாது” என்று யெகோவா சொல்கிறார்."]}],"footnotes":[{"noteId":29,"caller":"+","text":"மத்தியில் அல்லது பாழடைந்த இடத்தில்","reference":{"chapter":59,"verse":10}}]},"thisChapterLink":"/api/tam_tcv/ISA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/58.json","previousChapterAudioLinks":{},"numberOfVerses":21}