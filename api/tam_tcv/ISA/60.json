{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":60,"content":[{"type":"heading","content":["சீயோனின் மகிமை"]},{"type":"verse","number":1,"content":[{"text":"“எழும்பிப் பிரகாசி, ஏனெனில் உன் ஒளி வந்துவிட்டது,","poem":1},{"text":"யெகோவாவின் மகிமை உன்மேல் உதிக்கிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இதோ, பூமியை இருள் மூடியிருக்கிறது,","poem":1},{"text":"காரிருள் மக்கள் கூட்டங்களைச் சூழ்ந்திருக்கிறது.","poem":2},{"text":"ஆனால் யெகோவா உன்மேல் உதிக்கிறார்,","poem":1},{"text":"அவரின் மகிமை உன்மேல் தோன்றுகிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பிறநாடுகள் உன் வெளிச்சத்திற்கும்,","poem":1},{"text":"அரசர்கள் உன்மேல் வரும் விடியற்காலையின் பிரகாசத்திற்கும் வருவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“உன் கண்களை உயர்த்தி சுற்றிலும் பார்;","poem":1},{"text":"யாவரும் ஒன்றுகூடி உன்னிடம் வருகிறார்கள்;","poem":2},{"text":"உன் மகன்கள் தொலைவிலிருந்து வருகிறார்கள்,","poem":1},{"text":"உன் மகள்கள் தோளில் சுமந்துகொண்டு வரப்படுகிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அப்பொழுது நீ பார்த்து முகமலர்ச்சி அடைவாய்;","poem":1},{"text":"உன் இருதயம் மகிழ்ந்து பூரிப்படையும்;","poem":2},{"text":"கடல்களின் திரவியம் உனக்குக் கொண்டுவரப்படும்;","poem":1},{"text":"நாடுகளின் செல்வமும் உன்னிடம் சேரும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஒட்டகக் கூட்டம் நாட்டை நிரப்பும்,","poem":1},{"text":"மீதியா, ஏப்பாத் நாடுகளின் இளம் ஒட்டகங்கள் உன்னிடம் வரும்.","poem":2},{"text":"சேபாவிலிருந்து வரும் அனைவரும்","poem":1},{"text":"தங்கமும் நறுமண தூபமும் கொண்டுவந்து,","poem":2},{"lineBreak":true},{"text":"யெகோவாவின் புகழை அறிவிக்க வருவார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கேதாரின் மந்தைகள் எல்லாம் உன்னிடம் சேர்க்கப்படும்,","poem":1},{"text":"நெபாயோத்தின் கடாக்கள் உனக்குப் பணிபுரியும்;","poem":2},{"text":"அவை என் பலிபீடத்தில் பலிகளாக ஏற்றுக்கொள்ளப்படும்,","poem":1},{"text":"நான் என் மகிமையான ஆலயத்தை அலங்கரிப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“மேகங்களைப் போலவும்,","poem":1},{"text":"தம் கூட்டுக்குப் பறந்தோடும் புறாக்களைப்போலவும் பறக்கும் இவர்கள் யார்?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தீவுகள் எனக்குக் காத்திருக்கின்றன;","poem":1},{"text":"தர்ஷீசின் கப்பல்கள் முன்னணியில் வருகின்றன.","poem":2},{"text":"தொலைவிலுள்ள உங்கள் மகன்களை","poem":1},{"text":"அவர்களுடைய வெள்ளியோடும் தங்கத்தோடும் கொண்டுவருகின்றன.","poem":2},{"text":"இஸ்ரயேலின் பரிசுத்தரும் உன் இறைவனுமாகிய யெகோவாவை","poem":1},{"text":"கனம் பண்ணுவதற்காக இவை வருகின்றன.","poem":2},{"lineBreak":true},{"text":"ஏனெனில் அவர் உன்னைச் சிறப்பால் அலங்கரித்திருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“அந்நியர் உன் மதில்களை மீண்டும் கட்டியெழுப்புவார்கள்,","poem":1},{"text":"அவர்களுடைய அரசர்கள் உனக்குப் பணிசெய்வார்கள்.","poem":2},{"text":"என் கோபத்தினால் நான் உன்னை அடித்தபோதிலும்,","poem":1},{"text":"தயவுடன் நான் உனக்குக் கருணை காட்டுவேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உங்கள் வாசல்கள் எப்பொழுதும் திறந்தே இருக்கும்,","poem":1},{"text":"பகலோ இரவோ, அவை ஒருபோதும் மூடப்படுவதில்லை;","poem":2},{"text":"நாடுகளின் செல்வத்தை மனிதர் கொண்டுவருகையில்,","poem":1},{"text":"அவைகளோடு அரசர்களை வெற்றிப் பவனியுடன் நடத்தி வருவதற்காகவே","poem":2},{"lineBreak":true},{"text":"இவ்வாறு திறந்திருக்கும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உனக்குப் பணி செய்யாத நாடோ அல்லது அரசோ அழிந்துபோகும்;","poem":1},{"text":"அது முற்றிலும் பாழாகிவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“எனது பரிசுத்த இடத்தை அலங்கரிப்பதற்கு","poem":1},{"text":"லெபனோனின் மகிமையாகிய தேவதாரு,","poem":2},{"text":"சவுக்கு, புன்னை மரங்கள் ஒன்றுசேர்ந்து உன்னிடம் வந்துசேரும்;","poem":1},{"text":"நான் எனது பாதபடியை மகிமைப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"உன்னை ஒடுக்கியோரின் பிள்ளைகள் தலைகுனிந்தபடி உனக்குமுன் வருவார்கள்;","poem":1},{"text":"உன்னை இகழ்ந்த யாவரும் உன் பாதத்தண்டையில் தலைகுனிந்து நிற்பார்கள்.","poem":2},{"text":"அவர்கள் உன்னை யெகோவாவின் பட்டணம் என்றும்,","poem":1},{"text":"இஸ்ரயேலின் பரிசுத்தரின் சீயோன் என்றும் அழைப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“ஒருவரும் உன் வழியே நடவாமல்","poem":1},{"text":"நீ வெறுக்கப்பட்டு கைவிடப்பட்டிருந்தபோதும்,","poem":2},{"text":"எல்லாத் தலைமுறைக்கும் நான் உன்னை","poem":1},{"text":"நித்திய பெருமையாயும் மகிழ்ச்சியாயும் ஆக்குவேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீ நாடுகளின் பாலைக் குடித்து,","poem":1},{"text":"அரச குடும்பத்தவர்களின் மார்பகங்களில் பாலைக் குடிப்பாய்.","poem":2},{"text":"அப்பொழுது நீ யெகோவாவாகிய நானே உன் இரட்சகர், உன் மீட்பர்,","poem":1},{"text":"யாக்கோபின் வல்லவர் என்பதை அறிந்துகொள்வாய்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"வெண்கலத்திற்குப் பதிலாக தங்கத்தையும்,","poem":1},{"text":"இரும்புக்குப் பதிலாக வெள்ளியையும் நான் உன்னிடம் கொண்டுவருவேன்.","poem":2},{"text":"மரத்துக்குப் பதிலாக வெண்கலத்தையும்,","poem":1},{"text":"கற்களுக்குப் பதிலாக இரும்பையும் உன்னிடம் கொண்டுவருவேன்.","poem":2},{"text":"சமாதானத்தை உங்கள் ஆட்சித் தலைவனாகவும்","poem":1},{"text":"நீதியை உங்கள் ஆளுநனாகவும் நான் ஆக்குவேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உன் நாட்டில் இனியொருபோதும் வன்முறைகளின் சத்தம் கேட்கப்படமாட்டாது;","poem":1},{"text":"உன் எல்லைகளுக்குள் அழிவும் பாழாக்குதலும் ஏற்படமாட்டாது.","poem":2},{"text":"ஆனால் நீ உன் மதில்களை இரட்சிப்பு என்றும்,","poem":1},{"text":"உன் வாசல்களைத் துதி என்றும் அழைப்பாய்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இனிமேல் பகலில் சூரியன் உனக்கு வெளிச்சமாய் இருக்கமாட்டாது;","poem":1},{"text":"அல்லது சந்திரனின் வெளிச்சம் உன்மேல் பிரகாசிக்கமாட்டாது.","poem":2},{"text":"ஏனெனில் யெகோவாவே உன்னுடைய நித்திய ஒளியாக இருப்பார்;","poem":1},{"text":"உன் இறைவனே உன் மகிமையாயிருப்பார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"உன் சூரியன் ஒருபோதும் மறைவதுமில்லை,","poem":1},{"text":"உன் சந்திரன் இனிமேல் தேய்வதுமில்லை.","poem":2},{"text":"யெகோவாவே உன் நித்திய ஒளியாய் இருப்பார்,","poem":1},{"text":"உன் துக்க நாட்களும் முடிவடையும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அப்பொழுது உன் மக்கள் யாவரும் நீதியானவர்களாய் இருந்து,","poem":1},{"text":"நாட்டை என்றென்றைக்கும் உரிமையாக்கிக்கொள்வார்கள்;","poem":2},{"text":"அவர்களே எனது மகிமை வெளிப்படும்படியாக","poem":1},{"text":"என் கரங்களின் வேலையாகவும்","poem":2},{"lineBreak":true},{"text":"நான் நட்ட முளையாகவும் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"உங்களில் சிறியவர் ஆயிரம் பேர்களாவர்,","poem":1},{"text":"அற்பரும் வலிய நாடாவர்.","poem":2},{"text":"நானே யெகோவா;","poem":1},{"text":"அதன் காலத்தில் அதை நானே தீவிரமாகச் செய்வேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/59.json","previousChapterAudioLinks":{},"numberOfVerses":22}