{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":61,"content":[{"type":"heading","content":["யெகோவாவினுடைய தயவின் வருடம்"]},{"type":"verse","number":1,"content":[{"text":"ஆண்டவராகிய யெகோவாவின் ஆவியானவர் என் மேலிருக்கிறார்;","poem":1},{"text":"ஏழைகளுக்கு நற்செய்தியை அறிவிக்கும்படி,","poem":2},{"lineBreak":true},{"text":"யெகோவா என்னை அபிஷேகம் பண்ணினார்.","poem":2},{"text":"உள்ளமுடைந்தவர்களுக்குக் காயங்கட்டவும்,","poem":1},{"text":"சிறைப்பட்டவர்களுக்கு விடுதலையை அறிவிக்கவும்,","poem":2},{"lineBreak":true},{"text":"கட்டுண்டோரை இருளிலிருந்து விடுவிக்கவும்,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவின் தயவின் வருடத்தையும்,","poem":1},{"text":"நமது இறைவன் அநீதிக்குப் பழிவாங்கப்போகும் நாளையும் அறிவிக்கவும்,","poem":2},{"text":"துக்கப்படும் அனைவரையும் ஆறுதல்படுத்தவும்,","poem":1}]},{"type":"verse","number":3,"content":[{"text":"சீயோனில் துக்கப்படுகிறவர்களுக்கு","poem":2},{"text":"சாம்பலுக்குப் பதிலாக அழகின் மகுடத்தையும்,","poem":1},{"text":"துயரத்திற்குப் பதிலாக","poem":2},{"text":"ஆனந்த தைலத்தையும்,","poem":1},{"text":"மனச்சோர்வுக்குப் பதிலாக","poem":2},{"text":"துதியின் உடையையும் கொடுப்பதற்காகவும்","poem":1},{"text":"அவர் என்னை அனுப்பியிருக்கிறார்.","poem":2},{"text":"அவர்கள் யெகோவா தமது சிறப்பை வெளிப்படுத்துவதற்காக,","poem":1},{"text":"அவரால் நாட்டப்பட்ட","poem":2},{"lineBreak":true},{"text":"நீதியின் விருட்சங்கள் என அழைக்கப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அவர்கள் ஆதிகாலத்தின் இடிபாடுகளை திரும்பக் கட்டி,","poem":1},{"text":"நெடுங்காலமாய்ப் பாழாய் கிடந்த இடங்களைப் பழைய நிலைக்குக் கொண்டுவருவார்கள்.","poem":2},{"text":"தலைமுறை தலைமுறைகளாய் பாழடைந்து","poem":1},{"text":"சூறையாடப்பட்டுக் கிடந்த பட்டணங்களைப் புதுப்பிப்பார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பிறநாட்டார் உங்கள் மந்தைகளை மேய்ப்பார்கள்;","poem":1},{"text":"அந்நியர் உங்கள் வயல்களிலும் திராட்சைத் தோட்டங்களிலும் வேலை செய்வார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீங்கள் யெகோவாவின் ஆசாரியர்கள் என்று அழைக்கப்படுவீர்கள்;","poem":1},{"text":"நமது இறைவனின் ஊழியர்கள் என்று பெயரிடப்படுவீர்கள்.","poem":2},{"text":"நீங்கள் நாடுகளின் செல்வத்தை சாப்பிடுவீர்கள்,","poem":1},{"text":"அவர்களின் செல்வத்தில் பெருமையும் பாராட்டுவீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"என் மக்கள் தங்கள் வெட்கத்திற்குப் பதிலாக","poem":1},{"text":"நாட்டில் இரட்டிப்பான பங்கைப் பெறுவார்கள்.","poem":2},{"text":"அவமானத்திற்குப் பதிலாக","poem":1},{"text":"அவர்கள் தங்கள் உரிமையில் மகிழ்ச்சியடைவார்கள்.","poem":2},{"text":"ஆகவே அவர்கள் தங்கள் நாட்டில் இரட்டிப்பான பங்கை உரிமையாக்கிக்கொள்வார்கள்.","poem":1},{"text":"நித்திய மகிழ்ச்சி அவர்களுக்கு உரியதாயிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ஏனெனில் யெகோவாவாகிய நான், கொள்ளையையும்","poem":1},{"noteId":30},{"text":"மீறுதல்களையும் வெறுக்கிறேன்.","poem":1},{"text":"நான் நீதியை நேசிக்கிறேன்.","poem":2},{"text":"என் உண்மையின் நிமித்தம் அவர்களுக்கு வெகுமதி கொடுத்து,","poem":1},{"text":"அவர்களுடன் ஒரு நித்திய உடன்படிக்கையையும் செய்வேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களுடைய சந்ததிகள் பல நாடுகளின் மத்தியிலும்,","poem":1},{"text":"அவர்களுடைய சந்ததியினர் பல மக்கள் கூட்டங்களின் மத்தியிலும்","poem":2},{"lineBreak":true},{"text":"நன்கு அறியப்படுவார்கள்.","poem":2},{"text":"அவர்களைக் காண்போர் அனைவரும்,","poem":1},{"text":"அவர்கள் யெகோவாவினால் ஆசீர்வதிக்கப்பட்ட மக்கள்","poem":2},{"lineBreak":true},{"text":"என்பதை ஏற்றுக்கொள்வார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நான் யெகோவாவிடம் பெரிதாய் களிகூருகிறேன்.","poem":1},{"text":"என் ஆத்துமா என் இறைவனில் மகிழுகிறது.","poem":2},{"text":"ஏனெனில் மணவாளன் தன் தலையை ஒரு ஆசாரியன் அழகுபடுத்துவது போலவும்,","poem":1},{"text":"ஒரு மணவாட்டி தன் நகைகளால் தன்னை அலங்கரிப்பது போலவும்,","poem":2},{"text":"யெகோவா இரட்சிப்பின் உடைகளை எனக்கு உடுத்தி,","poem":1},{"text":"நேர்மையின் ஆடையால் என்னை அலங்கரித்து இருக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"மண் தன் தாவரங்களை விளைவிப்பது போலவும்,","poem":1},{"text":"ஒரு தோட்டம் தன்னில் விதைக்கப்பட்ட விதைகளை வளரச்செய்வது போலவும்,","poem":2},{"text":"ஆண்டவராகிய யெகோவா நீதியையும்,","poem":1},{"text":"துதியையும் எல்லா நாடுகளுக்கு முன்பாகவும் வளரப்பண்ணுவார்.","poem":2}]}],"footnotes":[{"noteId":30,"caller":"+","text":"கொள்ளையையும் அல்லது கொள்ளைப் பொருட்களினால் இடப்பட்ட தகனபலி எனப்படும்.","reference":{"chapter":61,"verse":8}}]},"thisChapterLink":"/api/tam_tcv/ISA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/60.json","previousChapterAudioLinks":{},"numberOfVerses":11}