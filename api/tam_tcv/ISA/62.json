{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":62,"content":[{"type":"heading","content":["சீயோனின் புதுப்பெயர்"]},{"type":"verse","number":1,"content":[{"text":"சீயோனின் நிமித்தம் நான் மவுனமாயிராமலும்,","poem":1},{"text":"எருசலேமின் நிமித்தம் நான் செயலற்று இராமலும்,","poem":2},{"text":"அதன் நீதி விடியற்கால வெளிச்சத்தைப் போலவும்,","poem":1},{"text":"அதன் இரட்சிப்பு பற்றியெரியும் ஒரு தீவட்டியைப் போலவும்","poem":2},{"lineBreak":true},{"text":"வெளிப்படும்வரை அமராமலும் இருப்பேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பிறநாடுகள் உன் நீதியைக் காண்பார்கள்,","poem":1},{"text":"அரசர்கள் யாவரும் உன் மகிமையைக் காண்பார்கள்;","poem":2},{"text":"யெகோவாவின் வாய் வழங்கும்","poem":1},{"text":"ஒரு புதிய பெயரால் நீ அழைக்கப்படுவாய்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீ யெகோவாவின் கரத்தில் சிறப்பான மகுடமாகவும்,","poem":1},{"text":"உன் இறைவனின் கரத்தில் அரச மகுடமாகவும் இருப்பாய்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் இனி ஒருபோதும் உன்னைக் கைவிடப்பட்ட நாடு என அழைப்பதில்லை.","poem":1},{"text":"உன்னைப் பாழடைந்த நாடு என்று சொல்வதுமில்லை.","poem":2},{"text":"நீ எப்சிபா என்று அழைக்கப்படுவாய்,","poem":1},{"text":"உனது நாடு பியூலா என்று பெயர்பெறும்;","poem":2},{"text":"ஏனெனில் யெகோவா உன்னில் பிரியப்படுவார்,","poem":1},{"text":"உன் நாடு வாழ்க்கைப்படும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஒரு வாலிபன் ஒரு கன்னிப் பெண்ணைத் திருமணம் செய்வதுபோல,","poem":1},{"text":"உன்னைக் கட்டியெழுப்பியவர் உன்னைத் திருமணம் செய்வார்.","poem":2},{"text":"மணமகன் மணமகளில் மகிழ்ச்சிகொள்ளுவதுபோல,","poem":1},{"text":"உன் இறைவன் உன்னில் மகிழ்ச்சிகொள்வார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"எருசலேமே, நான் உனது மதில்களின்மேல் காவலாளரை நியமித்திருக்கிறேன்;","poem":1},{"text":"பகலிலோ இரவிலோ ஒருபோதும் அவர்கள் மவுனமாய் இருக்கமாட்டார்கள்.","poem":2},{"text":"யெகோவாவை நோக்கி மன்றாடுவோரே,","poem":1},{"text":"நீங்கள் ஓய்ந்திருக்க வேண்டாம்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் எருசலேமை நிலைக்கப்பண்ணி, அவளைப் பூமியின் புகழ்ச்சியாக்கும்வரை,","poem":1},{"text":"அவருக்கு ஓய்வுகொடாதீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவா தனது வலது கரத்தினாலும்","poem":1},{"text":"வலிய புயத்தினாலும் ஆணையிட்டுக் கூறியது:","poem":2},{"text":"“நான் உங்கள் தானியத்தை,","poem":1},{"text":"இனி ஒருபோதும் உங்கள் பகைவர்களுக்கு உணவாகக் கொடுக்கமாட்டேன்;","poem":2},{"text":"உங்கள் உழைப்பினால் உண்டான புதிய திராட்சரசத்தை","poem":1},{"text":"பிறர் இனி ஒருபோதும் குடிக்கமாட்டார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அதை அறுவடை செய்பவர்களே அதைச் சாப்பிட்டு,","poem":1},{"text":"யெகோவாவைத் துதிப்பார்கள்.","poem":2},{"text":"திராட்சைப் பழங்களை சேகரிப்பவர்களே எனது பரிசுத்த இடத்தின் முற்றத்தில்","poem":1},{"text":"திராட்சை இரசத்தைக் குடிப்பார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"கடந்துசெல்லுங்கள், வாசல்களைக் கடந்துசெல்லுங்கள்!","poem":1},{"text":"மக்களுக்கு வழியை ஆயத்தப்படுத்துங்கள்.","poem":2},{"text":"கட்டுங்கள், பெரும் பாதையைக் கட்டுங்கள்!","poem":1},{"text":"கற்களை அகற்றுங்கள்.","poem":2},{"text":"நாடுகளுக்காக கொடியை ஏற்றுங்கள்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"யெகோவா பூமியின் கடைசிவரை","poem":1},{"text":"பிரசித்தப்படுத்தியிருப்பது:","poem":2},{"text":"“பாருங்கள், ‘உங்கள் இரட்சகர் வருகிறார்!","poem":1},{"text":"இதோ, அவர் கொடுக்கும் வெகுமதி அவருடன் இருக்கிறது;","poem":2},{"text":"அவர் கொடுக்கும் பிரதிபலனும் அவரோடு வருகிறது’","poem":1},{"text":"என்று சீயோன் மகளுக்குச் சொல்லுங்கள்.”","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்கள் பரிசுத்த மக்கள் என்றும்,","poem":1},{"text":"யெகோவாவினால் மீட்கப்பட்டவர்கள் என்றும் அழைக்கப்படுவார்கள்;","poem":2},{"text":"நீ தேடிக் கண்டுபிடிக்கப்பட்டதென்றும்","poem":1},{"text":"இனி ஒருபோதும் கைவிடப்படாத பட்டணம் என்றும் அழைக்கப்படுவாய்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}