{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":63,"content":[{"type":"heading","content":["இறைவனுடைய பழிவாங்கும் மற்றும் மீட்கும் நாள்"]},{"type":"verse","number":1,"content":[{"text":"ஏதோமிலிருந்து வருகிற இவர் யார்?","poem":1},{"text":"கருஞ்சிவப்பு கறைபடிந்த உடையுடன் போஸ்றா பட்டணத்திலிருந்து வருகிற இவர் யார்?","poem":2},{"text":"தனது சிறப்பான அங்கியுடன்","poem":1},{"text":"தமது வல்லமையின் மகத்துவத்தில் எழுந்தருளி வருகிற இவர் யார்?","poem":2},{"lineBreak":true},{"text":"“நான்தான் அவர்!","poem":1},{"text":"நியாயமாய் பேசி, இரட்சிக்க வல்லவர்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"உமது உடைகள் சிவப்பாய்,","poem":1},{"text":"திராட்சையைப் பிழியும் ஆலையில் மிதிக்கிறவனுடைய உடையைப்போல் இருப்பது ஏன்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“நான் தனியாய் திராட்சைப் பிழியும் ஆலையை மிதித்தேன்;","poem":1},{"text":"மக்கள் கூட்டங்களில் ஒருவனும் என்னுடன் இருந்ததில்லை.","poem":2},{"text":"அவர்களை என் கோபத்தில் மிதித்து,","poem":1},{"text":"என் கடுங்கோபத்தில் அவர்களை நசுக்கினேன்;","poem":2},{"text":"அவர்களுடைய இரத்தம் என் ஆடைகளின்மேல் தெறித்தது,","poem":1},{"text":"என் உடைகளெல்லாம் கறைப்பட்டன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பழிவாங்கும் நாள் என் உள்ளத்தில் இருந்தது;","poem":1},{"text":"நான் மீட்டுக்கொள்ளும் வருடம் வந்துவிட்டது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நான் பார்த்தேன், அங்கே என் மக்களுக்கு உதவி செய்வார் யாரும் இல்லை;","poem":1},{"text":"ஆதரவு வழங்க ஒருவரும் இல்லாததைக் கண்டு அதிர்ச்சியடைந்தேன்.","poem":2},{"text":"எனவே என் சொந்த புயமே வெற்றியைக் கொண்டுவர செயலாற்றியது;","poem":1},{"text":"என் கடுங்கோபமே என்னைத் தாங்கிற்று.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் என் கோபத்தில் மக்களைக் கீழே மிதித்தேன்;","poem":1},{"text":"எனது கடுங்கோபத்தில் அவர்களை வெறிக்கச்செய்து,","poem":2},{"lineBreak":true},{"text":"அவர்களின் இரத்தத்தை நிலத்தில் ஊற்றினேன்.”","poem":2}]},{"type":"heading","content":["துதியும் மன்றாட்டும்"]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவினுடைய இரக்கத்தையும்,","poem":1},{"text":"அவர் புகழப்பட வேண்டிய செயல்களையும் நான் எடுத்துரைப்பேன்.","poem":2},{"lineBreak":true},{"text":"யெகோவா எங்களுக்குச் செய்த எல்லா நன்மைகளுக்குத் தக்கதாகவும்,","poem":2},{"text":"அவருடைய இரக்கத்தின்படியும், அவருடைய தயவுகளின் படியும்,","poem":1},{"text":"அவர் இஸ்ரயேல் குடும்பத்திற்குச் செய்த அநேக நற்செயல்களையும்","poem":2},{"lineBreak":true},{"text":"நான் பறைசாற்றுவேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர், “இவர்கள் நிச்சயமாய் எனது மக்கள்,","poem":1},{"text":"எனக்கு வஞ்சனை செய்யாத பிள்ளைகள்” என்றார்;","poem":2},{"lineBreak":true},{"text":"மேலும், அவர் அவர்களின் இரட்சகரானார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களின் வேதனைகளிலெல்லாம் அவரும் வேதனைப்பட்டார்;","poem":1},{"text":"அவருடைய சமுகத்தின் தூதன் அவர்களை இரட்சித்தான்.","poem":2},{"text":"தமது அன்பினாலும் கருணையினாலும் அவர்களை மீட்டார்;","poem":1},{"text":"அவர் பூர்வ நாட்களிலெல்லாம்","poem":2},{"lineBreak":true},{"text":"அவர்களைத் தூக்கிச் சுமந்தார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அப்படியிருந்தும், அவர்கள் கலகம்செய்து,","poem":1},{"text":"அவருடைய பரிசுத்த ஆவியானவரைத் துக்கப்படுத்தினார்கள்.","poem":2},{"text":"ஆகவே அவர் அவர்களுடைய பகைவராக மாறி,","poem":1},{"text":"தாமே அவர்களை எதிர்த்துப் போராடினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"அப்பொழுது அவருடைய மக்கள்","poem":1},{"noteId":31},{"text":"பூர்வ நாட்களையும்,","poem":1},{"text":"மோசேயையும், அவருடைய மக்களையும் நினைவுகூர்ந்தார்கள்;","poem":2},{"text":"அவர்களை தனது மந்தையின் மேய்ப்பனுடன்","poem":1},{"text":"தம் மக்களை கடல் வழியே கொண்டுவந்தவர் எங்கே?","poem":2},{"text":"அவர்கள் மத்தியில் தமது பரிசுத்த ஆவியானவரை","poem":1},{"text":"அனுப்பியவர் எங்கே?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"தமது மகிமையான வல்லமையின் புயத்தால்","poem":1},{"text":"மோசேயின் வலதுகையைக் கொண்டு,","poem":2},{"text":"தமக்கு நித்திய புகழ் உண்டாக்கும்படியாக","poem":1},{"text":"அவர்களுக்கு முன்பாக தண்ணீர்களைப் பிரித்தவர் எங்கே?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆழங்களில் அவர்களை வழிநடத்தியவர் எங்கே?","poem":1},{"lineBreak":true},{"text":"பாலைவன வெளியில் செல்லும் குதிரையைப்போல","poem":1},{"text":"அவர்கள் இடறவில்லை;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவாவின் ஆவியானவர் அவர்களை","poem":1},{"text":"பள்ளத்தாக்கில் இறங்கிச் செல்லும் மந்தையைப்போல்,","poem":2},{"lineBreak":true},{"text":"இளைப்பாறப் பண்ணினார்.","poem":2},{"text":"நீர் உமக்கு மகிமையான பெயரை உண்டுபண்ணும்படி,","poem":1},{"text":"உமது மக்களை இவ்வாறு வழிநடத்தினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"பரலோகத்திலிருந்து கீழே நோக்கும்,","poem":1},{"text":"பரிசுத்தமும் மகிமையுமான உமது உயர்ந்த அரியணையிலிருந்து பாரும்.","poem":2},{"text":"உமது வைராக்கியமும் உமது வல்லமையும் எங்கே?","poem":1},{"text":"உமது கனிவும் இரக்கமும் எங்களிடமிருந்து தடுக்கப்பட்டிருக்கின்றன.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆபிரகாம் எங்களை அறியான்,","poem":1},{"text":"இஸ்ரயேலும் எங்களை ஏற்றுக்கொள்ளவில்லை.","poem":2},{"lineBreak":true},{"text":"ஆனாலும், நீரே எங்கள் தந்தை;","poem":2},{"text":"யெகோவாவே, நீர் நீரே எங்கள் தந்தை.","poem":1},{"text":"பூர்வகாலம் முதல் எங்கள் மீட்பர் என்பதே உமது பெயர்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"யெகோவாவே, நீர் ஏன் எங்களை உமது வழிகளிலிருந்து விலகச் செய்கிறீர்?","poem":1},{"text":"உமக்குப் பயபக்தியாயிராதபடி ஏன் எங்கள் இருதயங்களைக் கடினப்படுத்துகிறீர்?","poem":2},{"text":"உமது உரிமையாயிருக்கும் கோத்திரங்களான","poem":1},{"text":"உமது ஊழியரின் நிமித்தம் திரும்பி வாரும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உமது மக்கள் உமது பரிசுத்த இடத்தைச் சிறிது காலமே சுதந்தரித்திருந்தார்கள்;","poem":1},{"text":"ஆனால் இப்பொழுதோ எங்கள் பகைவர்கள்","poem":2},{"lineBreak":true},{"text":"உமது பரிசுத்த இடத்தை மிதித்து அழித்துவிட்டார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"பூர்வகாலமுதல் நாங்கள் உம்முடையவர்களே;","poem":1},{"text":"ஆனால் நாங்களோ ஒருபோதும் உம்மால் ஆட்சி செய்யப்படாதவர்கள் போலவும்,","poem":2},{"lineBreak":true},{"text":"உமது பெயரால் ஒருபோதும் அழைக்கப்படாதவர்கள் போலவும் இருக்கிறோம்.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":31,"caller":"+","text":"அல்லது அவர் நினைவுகூர்ந்தார்","reference":{"chapter":63,"verse":11}}]},"thisChapterLink":"/api/tam_tcv/ISA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/62.json","previousChapterAudioLinks":{},"numberOfVerses":19}