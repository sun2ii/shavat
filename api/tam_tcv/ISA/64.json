{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":64,"content":[{"type":"verse","number":1,"content":[{"text":"நீர் வானங்களைப் பிரித்துக் கீழே வாரும்,","poem":1},{"text":"அப்பொழுது நாடுகள் உமக்கு முன்பாக நடுங்கும்!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"விறகுகளை நெருப்பு எரிக்கும்போது","poem":1},{"text":"அது தண்ணீரைக் கொதிக்கச் செய்யும்.","poem":2},{"text":"அதுபோல் நீர் இறங்கி உமது பகைவர் உமது பெயரை அறிந்துகொள்ளச் செய்யும்.","poem":1},{"text":"நாடுகளை உமக்கு முன்பாக அதிரச்செய்யும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஏனெனில் பண்டைய நாட்களில் நாங்கள் எதிர்பாராத","poem":1},{"text":"அச்சுறுத்தும் செயல்களை நீர் செய்தீர்,","poem":2},{"lineBreak":true},{"text":"நீர் வந்தபோது மலைகள் உமக்கு முன்பாக நடுங்கின.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உமக்குக் காத்திருப்போருக்காகச் செயலாற்றும் இறைவனைப்போன்ற,","poem":1},{"text":"வேறு ஒருவரை ஆதிமுதல் ஒருவரும் கேள்விப்பட்டதுமில்லை,","poem":2},{"text":"எந்த ஒரு கண்ணும் கண்டதுமில்லை,","poem":1},{"text":"எந்த ஒரு செவியும் கேட்டதுமில்லை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உமது வழிகளை நினைவுகூர்ந்து மகிழ்ச்சியுடன் சரியானதைச் செய்வோருக்கு","poem":1},{"text":"நீர் உதவிசெய்ய வருகிறவர்.","poem":2},{"text":"ஆனால் நாங்கள் தொடர்ந்து உமக்கெதிராகப் பாவம் செய்தபோது,","poem":1},{"text":"நீர் கோபங்கொண்டீர்.","poem":2},{"lineBreak":true},{"text":"அப்படியானால் எப்படி நாம் காப்பாற்றப்படுவோம்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நாம் அனைவரும் அசுத்தரைப் போலானோம்,","poem":1},{"text":"எங்களுடைய நீதியான செயல்களெல்லாம் கறைபட்ட கந்தலைப்போல் இருக்கின்றன,","poem":2},{"text":"நாம் எல்லோரும் இலையைப்போல் வாடிப்போகிறோம்;","poem":1},{"text":"காற்றைப்போல எங்கள் பாவங்கள் எங்களை அள்ளிக்கொண்டுபோகிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உமது பெயரைச்சொல்லிக் கூப்பிடுவோரோ,","poem":1},{"text":"உம்மைப் பற்றிப்பிடிக்க முயற்சிக்கிறவரோ ஒருவருமில்லை;","poem":2},{"text":"ஏனெனில், நீர் உம்முடைய முகத்தை எங்களிடமிருந்து மறைத்து,","poem":1},{"text":"எங்கள் பாவங்களினிமித்தம் எங்களை அழிந்துபோகவிட்டீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஆயினும் யெகோவாவே, நீரே எங்கள் தகப்பன்.","poem":1},{"text":"நாங்கள் களிமண், நீர் குயவன்;","poem":2},{"lineBreak":true},{"text":"நாங்களெல்லோரும் உமது கரத்தின் வேலைப்பாடு.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, எங்களுடன் அளவுக்கதிகமாக கோபங்கொள்ள வேண்டாம்;","poem":1},{"text":"எங்கள் பாவங்களை என்றென்றும் நினைவுகூரவும் வேண்டாம்.","poem":2},{"text":"உமது மக்களாகிய எங்கள் அனைவரையும்","poem":1},{"text":"நோக்கிப்பாரும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உமது பரிசுத்த பட்டணங்கள் பாலைவனமாகிவிட்டன;","poem":1},{"text":"சீயோன் பாழ் நிலமானது, எருசலேமும் பாழாய்ப் போயிற்று.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எங்கள் முற்பிதாக்கள் உம்மைத் துதித்த","poem":1},{"text":"பரிசுத்தமும் மகிமையுமான எங்கள் ஆலயம் நெருப்புக்கு இரையாகி,","poem":2},{"lineBreak":true},{"text":"எங்களுக்கு இன்பமாய் இருந்தவையெல்லாம் பாழாய் கிடக்கின்றன.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"யெகோவாவே, இவற்றுக்குப் பின்னும் நீர் ஒன்றுமே செய்யாதிருப்பீரோ?","poem":1},{"text":"நீர் மவுனமாயிருந்து அளவுக்கதிகமாக எங்களைத் தண்டிக்கப் போகிறீரோ?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/63.json","previousChapterAudioLinks":{},"numberOfVerses":12}