{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":65,"content":[{"type":"heading","content":["நியாயத்தீர்ப்பும் இரட்சிப்பும்"]},{"type":"verse","number":1,"content":[{"text":"“என்னைப்பற்றி விசாரிக்காதவர்களுக்கு என்னை நான் வெளிப்படுத்தினேன்.","poem":1},{"text":"என்னைத் தேடாதவர்கள் என்னைக் கண்டுகொண்டார்கள்.","poem":2},{"text":"என் பெயரைச் சொல்லி மன்றாடாத மக்களிடம்,","poem":1},{"text":"‘இதோ நான், இதோ நான்’ என்று சொன்னேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் பிடிவாதமான மக்களுக்கு","poem":1},{"text":"நாள்முழுவதும் என் கைகளை நீட்டினேன்.","poem":2},{"text":"அவர்கள் தமது கற்பனைகளையே பின்பற்றி,","poem":1},{"text":"நலமற்ற வழியில் நடக்கிறவர்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் தோட்டங்களில் பலிசெலுத்தி,","poem":1},{"text":"தங்கள் செங்கல் பீடங்களில் தூபம் எரித்து,","poem":2},{"text":"தொடர்ந்து என்னை என் முகத்துக்கு","poem":1},{"text":"முன்பாகவே கோபமூட்டுகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் கல்லறைகள் மத்தியில் உட்கார்ந்து,","poem":1},{"text":"இரகசியமாய் விழித்திருந்து ஆவிகளை வணங்கி, இரவைக் கழிக்கிறார்கள்.","poem":2},{"text":"பன்றியின் இறைச்சியைச் சாப்பிடுகிறார்கள்.","poem":1},{"text":"அவர்களுடைய பானைகளில் அசுத்த இறைச்சியின் குழம்பு இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர்கள் ஒருவருக்கொருவர், ‘தள்ளி நில்லுங்கள்; எனக்கு அருகே வராதீர்கள்;","poem":1},{"text":"ஏனெனில் நான் உங்களிலும் மிகத் தூய்மையானவன்’ என்கிறார்கள்.","poem":2},{"text":"இப்படிப்பட்ட மக்கள் எனது நாசியின் துவாரங்களில் புகையாயும்","poem":1},{"text":"நாள்முழுவதும் எரிந்துகொண்டிருக்கும் நெருப்பாயும் இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“பாருங்கள், அது என்முன் எழுதப்பட்டிருக்கிறது:","poem":1},{"text":"நான் மவுனமாய் இருக்கமாட்டேன், முழுவதுமாக பதில் செய்வேன்;","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய மடியில் அதைத் திருப்பிக் கொட்டுவேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உங்களுடைய பாவங்களுக்கும், உங்கள் முற்பிதாக்களின் பாவங்களுக்கும்","poem":1},{"text":"பதில் செய்வேன்” என்று யெகோவா சொல்கிறார்.","poem":2},{"text":"“அவர்கள் மலைகளின்மேல் பலிகளை எரித்து,","poem":1},{"text":"குன்றுகளின்மேல் என்னை எதிர்த்து நின்றார்கள்.","poem":2},{"text":"அவர்களின் முந்திய செயல்களுக்கான பலனை முழுமையாக","poem":1},{"text":"அவர்களின் மடியில் அளந்துகொடுப்பேன்.”","poem":2}]},{"type":"verse","number":8,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“திராட்சைக் குலையில் சாறு இருக்கையில்,","poem":1},{"text":"‘அதை அழிக்காதே,","poem":2},{"lineBreak":true},{"text":"அதில் இன்னும் பலன் உண்டு’ என்று மனிதர் சொல்வார்களல்லவா?","poem":2},{"text":"அதுபோல, என் ஊழியரின் நிமித்தம் நான் இப்படிச் செய்வேன்.","poem":1},{"text":"அவர்கள் எல்லோரையும் அழிக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யாக்கோபிலிருந்து சந்ததிகளையும்,","poem":1},{"text":"யூதாவிலிருந்து என் மலையை சுதந்தரிப்பவர்களையும் கொண்டுவருவேன்;","poem":2},{"text":"நான் தெரிந்துகொண்ட மக்கள் அதை உரிமையாக்கிக்கொள்வார்கள்,","poem":1},{"text":"எனது ஊழியர்கள் அங்கே வசிப்பார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என்னைத் தேடும் என் மக்களுக்கு","poem":1},{"text":"சாரோன் ஆட்டு மந்தைகளின் மேய்ச்சலிடமாகவும்,","poem":2},{"lineBreak":true},{"text":"ஆகோர் பள்ளத்தாக்கும் மாட்டு மந்தைகளின் தொழுவமாகவும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“நீங்களோ யெகோவாவைவிட்டு,","poem":1},{"text":"என் பரிசுத்த மலையை மறந்து,","poem":2},{"text":"காத்","poem":1},{"noteId":32},{"text":"என்னும் தெய்வத்துக்குப் பந்தியை ஆயத்தம் செய்து,","poem":1},{"text":"மேனி தெய்வத்துக்கு திராட்சை இரசத்தைக் கிண்ணங்களில் நிறைக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உங்களை நான் வாளுக்கு இரையாக்குவேன்,","poem":1},{"text":"நீங்கள் எல்லோரும் கொல்லப்படுவதற்கு குனிவீர்கள்.","poem":2},{"text":"ஏனெனில் நான் கூப்பிட்டேன், நீங்கள் பதிலளிக்கவில்லை;","poem":1},{"text":"நான் பேசினேன், நீங்கள் கேட்கவில்லை.","poem":2},{"text":"எனது பார்வையில் தீமையைச் செய்து","poem":1},{"text":"நான் விரும்பாதவற்றைத் தெரிந்துகொண்டீர்கள்.”","poem":2}]},{"type":"verse","number":13,"content":["ஆகையால் ஆண்டவராகிய யெகோவா சொல்வது இதுவே:",{"text":"“எனது ஊழியர்கள் சாப்பிடுவார்கள்,","poem":1},{"text":"நீங்களோ பசியோடிருப்பீர்கள்;","poem":2},{"text":"எனது ஊழியர்கள் குடிப்பார்கள்,","poem":1},{"text":"நீங்களோ தாகமாயிருப்பீர்கள்;","poem":2},{"text":"எனது ஊழியர்கள் மகிழ்ச்சியாயிருப்பார்கள்,","poem":1},{"text":"நீங்களோ வெட்கத்திற்குள்ளாவீர்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"எனது ஊழியர்கள் உள்ளத்தின்","poem":1},{"text":"மகிழ்ச்சியுடன் பாடுவார்கள்;","poem":2},{"text":"நீங்களோ இதய வேதனையால்","poem":1},{"text":"கதறி அழுவீர்கள்;","poem":2},{"lineBreak":true},{"text":"உள்ளமுடைந்தவர்களாய் புலம்புவீர்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் தெரிந்துகொண்டவர்களுக்கு","poem":1},{"text":"உங்களுடைய பெயரை ஒரு சாபமாய் விட்டுப்போவீர்கள்;","poem":2},{"text":"ஆண்டவராகிய யெகோவா உங்களைக் கொன்றுபோட்டு,","poem":1},{"text":"ஆனால் தம்முடைய ஊழியருக்கோ அவர் வேறு பெயரைக் கொடுப்பார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நாட்டில் ஆசீர்வாதத்தை வேண்டிக்கொள்ளுகிறவன் எவனும்,","poem":1},{"text":"உண்மையின் இறைவனாலேயே ஆசி பெறுவான்.","poem":2},{"text":"பூமியில் ஆணையிடுகிறவனும்,","poem":1},{"text":"உண்மையின் இறைவனைக்கொண்டே ஆணையிடுவான்.","poem":2},{"text":"ஏனெனில் முந்திய தொல்லைகள் மறக்கப்பட்டு,","poem":1},{"text":"எனது கண்களிலிருந்து அவை மறைக்கப்படும்.","poem":2}]},{"type":"heading","content":["புதிய வானமும் புதிய பூமியும்"]},{"type":"verse","number":17,"content":[{"text":"“இதோ நான் புதிய வானத்தையும் புதிய பூமியையும்","poem":1},{"text":"உண்டாக்குவேன்.","poem":2},{"text":"முந்தியவைகள் நினைக்கப்படுவதுமில்லை,","poem":1},{"text":"மனதில் தோன்றுவதுமில்லை.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நான் உண்டாக்கப்போகிறதில்","poem":1},{"text":"நீங்கள் என்றென்றைக்கும் மகிழ்ந்து களிகூருங்கள்.","poem":2},{"text":"ஏனெனில், எருசலேமை அது மகிழ்ச்சிக்குரியதாகவும்,","poem":1},{"text":"அதன் மக்களை சந்தோஷமாகவும் படைப்பேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"நானும் எருசலேமில் மகிழ்ந்து,","poem":1},{"text":"எனது மக்களில் பெருமகிழ்ச்சியடைவேன்;","poem":2},{"text":"அங்கு புலம்பலின் குரலும்,","poem":1},{"text":"அழுகையின் சத்தமும் இனி ஒருபோதும் கேட்பதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ஒருசில நாட்கள் மட்டும் வாழும் குழந்தையோ,","poem":1},{"text":"தனக்குரிய காலம்வரை வாழாத முதியவனோ","poem":2},{"lineBreak":true},{"text":"ஒருபோதும் அங்கு இருக்கமாட்டார்கள்.","poem":2},{"text":"நூறு வயதில் இறக்கிறவன்","poem":1},{"text":"வாலிபன் என்று எண்ணப்படுவான்;","poem":2},{"text":"பாவியோ நூறு ஆண்டுகள் வாழ்ந்தும்","poem":1},{"text":"சபிக்கப்பட்டவன் என்று கருதப்படுவான்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர்கள் வீடுகள் கட்டி அவைகளில் குடியிருப்பார்கள்;","poem":1},{"text":"அவர்கள் திராட்சைத் தோட்டங்களையும் உண்டாக்கி,","poem":2},{"lineBreak":true},{"text":"அவைகளின் பழங்களைச் சாப்பிடுவார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவர்கள் கட்டும் வீடுகளில் இனிமேல் வேறெவரும் வாழமாட்டார்கள்,","poem":1},{"text":"அவர்கள் நடுகிறவைகளில் வேறொருவரும் சாப்பிடவுமாட்டார்கள்.","poem":2},{"text":"ஏனெனில் ஒரு மரத்தின் காலத்தைப்போலவே","poem":1},{"text":"எனது மக்களின் வாழ்நாட்களும் இருக்கும்.","poem":2},{"text":"நான் தெரிந்துகொண்ட மக்களும் தங்கள் கைகளின் பலனில்","poem":1},{"text":"நெடுநாளாய் மகிழ்ச்சிகொள்வார்கள்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவர்கள் வீணாக முயற்சி செய்யமாட்டார்கள்,","poem":1},{"text":"அவர்கள் அவலத்துக்குரிய பிள்ளைகளைப் பெறவுமாட்டார்கள்.","poem":2},{"text":"ஏனெனில், அவர்கள் யெகோவாவினால் ஆசீர்வதிக்கப்பட்ட மக்களாயிருப்பார்கள்;","poem":1},{"text":"அவர்களுடன் அவர்களின் சந்ததிகளும் ஆசீர்வதிக்கப்பட்டிருப்பார்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவர்கள் கூப்பிடுமுன்னே நான் பதிலளிப்பேன்;","poem":1},{"text":"அவர்கள் பேசிக்கொண்டிருக்கும்போதே நான் கேட்பேன்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஓநாயும் ஆட்டுக்குட்டியும் ஒன்றுகூடி மேயும்,","poem":1},{"text":"சிங்கமும் எருதைப்போல் வைக்கோல் தின்னும்,","poem":2},{"lineBreak":true},{"text":"பாம்போ புழுதியைத் தின்னும்.","poem":2},{"text":"எனது பரிசுத்த மலையெங்கும்","poem":1},{"text":"அவை ஒரு தீங்கையோ, அழிவையோ செய்யமாட்டாது”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்கிறார்.","poem":2}]}],"footnotes":[{"noteId":32,"caller":"+","text":"காத் என்றால் அதிர்ஷ்ட தேவதை என்று பொருள்","reference":{"chapter":65,"verse":11}}]},"thisChapterLink":"/api/tam_tcv/ISA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/64.json","previousChapterAudioLinks":{},"numberOfVerses":25}