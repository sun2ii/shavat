{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ISA","translationId":"tam_tcv","name":"ஏசாயா","commonName":"ஏசாயா","title":"இறைவாக்கினன் ஏசாயாவின் புத்தகம்","order":23,"numberOfChapters":66,"sha256":"aeba1e8083f585ded060b551549e80e7074e44d492be9f5493fea6d5bcd066a2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tam_tcv/ISA/66.json","totalNumberOfVerses":1292},"chapter":{"number":9,"content":[{"type":"verse","number":1,"content":["ஆயினும் முன்பு துயரப்பட்டவர்களுக்கு இனிமேல் பயங்கரம் இராது. முந்தின நாட்களில் செபுலோன் நாட்டையும், நப்தலி நாட்டையும் அவர் தாழ்த்தினார். ஆனால், வருங்காலத்திலே மத்திய தரைக்கடலிலிருந்து, யோர்தான் அருகேயுள்ள, பிறநாட்டினர் வாழும் கலிலேயாவை மேன்மைப்படுத்துவார்."]},{"type":"verse","number":2,"content":[{"text":"இருளில் நடக்கும் மக்கள்","poem":1},{"text":"ஒரு பேரொளியைக் கண்டார்கள்;","poem":2},{"text":"மரண இருள்சூழ்ந்த நாட்டில் வாழ்வோர்மேல்","poem":1},{"text":"வெளிச்சம் பிரகாசித்தது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீர் நாட்டைப் பெருகச்செய்து","poem":1},{"text":"அவர்களுக்கு மகிழ்ச்சியையும் அதிகமாய் கொடுத்திருக்கிறீர்.","poem":2},{"text":"அறுவடையின்போது மக்கள் மகிழ்வதைப்போல,","poem":1},{"text":"அவர்கள் உமது முன்னிலையில் மகிழ்கிறார்கள்.","poem":2},{"text":"கொள்ளையைப் பங்கிடும்போதும் மனிதர் மகிழ்வதுபோல,","poem":1},{"text":"அவர்கள் மகிழ்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மீதியானியர் தோற்கடிக்கப்பட்ட நாளில் செய்ததுபோல,","poem":1},{"text":"நீர் அவர்களுக்குப் பாரமாயிருந்த","poem":2},{"text":"நுகத்தை உடைத்துப்போட்டீர்.","poem":1},{"text":"அவர்களுடைய தோள்களின் அழுத்திய பாரத்தையும்,","poem":2},{"lineBreak":true},{"text":"அவர்களை ஒடுக்குவோரின் கொடுங்கோலையும் அகற்றிப்போட்டீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஒவ்வொரு வீரரும் போரில் பயன்படுத்திய காலணியும்,","poem":1},{"text":"இரத்தத்தில் தோய்ந்த உடைகள் அனைத்தும்","poem":2},{"text":"நெருப்புக்கு இரையாக","poem":1},{"text":"சுட்டெரிக்கப்படும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஏனெனில், “நமக்காக ஒரு குழந்தை பிறந்துள்ளார்,","poem":1},{"text":"நமக்கு ஒரு மகன் கொடுக்கப்பட்டார்,","poem":2},{"lineBreak":true},{"text":"அரசாட்சி அவர் தோளின்மேல் இருக்கும்.","poem":2},{"text":"அவர் அதிசயமான ஆலோசகர், வல்லமையுள்ள இறைவன்,","poem":1},{"text":"நித்திய தகப்பன், சமாதானப்பிரபு”","poem":2},{"lineBreak":true},{"text":"என அழைக்கப்படுவார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவருடைய ஆட்சியின் பெருக்கத்திற்கும் சமாதானத்திற்கும்","poem":1},{"text":"முடிவே இராது.","poem":2},{"text":"அவர் தாவீதின் சிங்காசனத்தையும்","poem":1},{"text":"அவனது அரசையும் நிலைநாட்டுவார்.","poem":2},{"text":"இதுமுதற்கொண்டு அதை என்றென்றைக்கும்","poem":1},{"text":"நீதியோடும் நேர்மையோடும்","poem":2},{"lineBreak":true},{"text":"நிலைநிறுத்தி உறுதிப்படுத்துவார்.","poem":2},{"text":"எல்லாம் வல்ல யெகோவாவினுடைய வைராக்கியம்","poem":1},{"text":"இதை நிறைவேற்றும்.","poem":2}]},{"type":"heading","content":["இஸ்ரயேலின் அழிவு"]},{"type":"verse","number":8,"content":[{"text":"யெகோவா யாக்கோபுக்கு விரோதமாக ஒரு செய்தியை அனுப்பியிருக்கிறார்;","poem":1},{"text":"அது இஸ்ரயேல்மேல் வரும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எப்பிராயீமியரும், சமாரியாவில் குடியிருப்பவர்களுமான","poem":1},{"text":"எல்லா மக்களும்,","poem":2},{"text":"அதை அறிவார்கள்.","poem":1},{"text":"அவர்கள் இருதய இறுமாப்புடனும் பெருமையுடனும்,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“செங்கற்கட்டிடங்கள் இடிந்து விழுந்தன,","poem":1},{"text":"ஆனாலும் திரும்பவும் நாம் நமது கட்டிடங்களை செதுக்கிய கற்களால் கட்டுவோம்.","poem":2},{"text":"அத்திமரங்கள் வீழ்த்தப்பட்டன,","poem":1},{"text":"ஆனால் நாங்கள் அவைகளுக்குப் பதிலாக, கேதுரு மரங்களை நடுவோம்”","poem":2},{"lineBreak":true},{"text":"என்று சொல்கிறார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஆனால் யெகோவா ரேத்சீனின் பகைவர்களை அவர்களுக்கு விரோதமாகப் பலப்படுத்தி,","poem":1},{"text":"அவர்களுடைய எதிரிகளைத் தூண்டிவிடுவார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"கிழக்கிலிருந்து சீரியரும் மேற்கிலிருந்து பெலிஸ்தியரும்,","poem":1},{"text":"இஸ்ரயேலரை திறந்த வாயால் விழுங்கியிருக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"இவையெல்லாம் நடந்தும், அவரது கோபம் தீராமல்,","poem":1},{"text":"அவரது கரம் இன்னும் ஓங்கியபடியே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"எனினும் அந்த மக்கள் தங்களைத் தண்டித்த","poem":1},{"text":"இறைவனாகிய யெகோவாவிடம் திரும்பவில்லை.","poem":2},{"lineBreak":true},{"text":"எல்லாம் வல்ல யெகோவாவைத் தேடவுமில்லை.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஆகையால் யெகோவா இஸ்ரயேலின் தலையையும், வாலையும்","poem":1},{"text":"ஓலையையும், நாணலையும் ஒரே நாளில் வெட்டிப்போடுவார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"முதியோரும் பிரபலமானோருமே தலை,","poem":1},{"text":"பொய்யைப் போதிக்கும் இறைவாக்கினரே வால்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"இந்த மக்களை வழிநடத்துகிறவர்கள் அவர்களை நெறிதவறச் செய்தார்கள்;","poem":1},{"text":"வழிநடத்தப்பட்டவர்கள் அழிந்துபோனார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆகையால் யெகோவா வாலிபர்களில் மகிழ்வதில்லை,","poem":1},{"text":"அநாதைகள் மேலும், விதவைகள்மேலும் இரக்கம்கொள்ளவும் இல்லை.","poem":2},{"text":"ஏனெனில் அவர்கள் எல்லோரும் இறைப்பற்று இல்லாதவர்களும்","poem":1},{"text":"பொல்லாதவர்களுமாய் இருக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"எல்லோருடைய வாயும் மதிகேட்டைப் பேசுகின்றது.","poem":2},{"lineBreak":true},{"text":"இவையெல்லாம் நடந்தும், அவரது கோபம் தீராமல்,","poem":1},{"text":"அவரது கரம் இன்னும் ஓங்கியபடியே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"மெய்யாகவே, கொடுமை நெருப்பைப்போல் எரிகிறது;","poem":1},{"text":"அது முட்செடியையும், நெருஞ்சில் செடியையும் தீய்த்து விடுகிறது.","poem":2},{"text":"அது அடர்த்தியான புதர்களையும் கொழுத்தி விடுகிறது,","poem":1},{"text":"அதன் புகை சுருள் சுருளாக மேலே எழும்புகிறது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"எல்லாம் வல்ல யெகோவாவின் கோபத்தினால்","poem":1},{"text":"நாடு நெருப்புக்கு இறையாகும்;","poem":2},{"text":"மக்களும் நெருப்புக்கான எரிபொருளாவார்கள்,","poem":1},{"text":"ஒருவனுமே தன் சகோதரனைத் தப்பவிடமாட்டான்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்கள் வலப்புறத்தில் பறித்துத் தின்றும்,","poem":1},{"text":"பசியோடு இருப்பார்கள்.","poem":2},{"text":"இடது புறத்தில் சாப்பிட்டும்,","poem":1},{"text":"திருப்தி அடையாதிருப்பார்கள்.","poem":2},{"text":"ஒவ்வொருவனும் தன் சொந்த கரத்தின் மாமிசத்தையுங்கூடத் தின்பான்:","poem":1}]},{"type":"verse","number":21,"content":[{"text":"மனாசே எப்பிராயீமையும், எப்பிராயீம் மனாசேயையும் தின்பார்கள்;","poem":2},{"lineBreak":true},{"text":"இருவரும் ஒன்றுசேர்ந்து யூதாவை எதிர்ப்பார்கள்.","poem":2},{"lineBreak":true},{"text":"இவையெல்லாம் நடந்தும் அவரது கோபம் தீராமல்,","poem":1},{"text":"அவரது கரம் இன்னும் ஓங்கியபடியே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ISA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ISA/8.json","previousChapterAudioLinks":{},"numberOfVerses":21}