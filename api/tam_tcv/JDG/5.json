{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JDG","translationId":"tam_tcv","name":"நியாயாதிபதிகள்","commonName":"நியாயாதிபதிகள்","title":"நியாயாதிபதிகள்","order":7,"numberOfChapters":21,"sha256":"eea1ba17a2051d5fc56dcc162143c86363aad114ad0614b9c358a32a98f6a1cb","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JDG/1.json","lastChapterNumber":21,"lastChapterApiLink":"/api/tam_tcv/JDG/21.json","totalNumberOfVerses":618},"chapter":{"number":5,"content":[{"type":"heading","content":["தெபோராளின் பாடல்"]},{"type":"verse","number":1,"content":["அந்த நாளில் தெபோராளும், அபினோமின் மகன் பாராக்கும் பாடிய பாடல்:"]},{"type":"verse","number":2,"content":[{"text":"“யெகோவா இஸ்ரயேலுக்காக நீதியை நிலைநாட்டியதற்காகவும்,","poem":1},{"text":"மக்கள் தங்களை மனமுவர்ந்து ஒப்படைத்ததற்காகவும்","poem":2},{"lineBreak":true},{"text":"யெகோவாவைத் துதியுங்கள்!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“அரசர்களே கேளுங்கள்! ஆளுநர்களே செவிகொடுங்கள்!","poem":1},{"text":"யெகோவாவை பாடுவேன், நான் பாடுவேன்.","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலின், இறைவனாகிய யெகோவாவுக்கு, இசை மீட்டுவேன்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“யெகோவாவே! நீர் சேயீரை விட்டு போனபோதும்,","poem":1},{"text":"ஏதோம் நாட்டைவிட்டு அணிவகுத்துச் சென்றபோதும் பூமி அதிர்ந்தது.","poem":2},{"text":"வானங்கள் பொழிந்தன.","poem":1},{"text":"மேகங்கள் தண்ணீரை கீழே பொழிந்தன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"சீனாயின் யெகோவாவான யெகோவாவுக்குமுன், மலைகளும் அதிர்ந்தன.","poem":1},{"text":"இஸ்ரயேலின் இறைவனான யெகோவாவுக்கு முன்பாக அவை அதிர்ந்தன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ஆனாத்தின் மகன் சம்காரின் நாட்களிலும்,","poem":1},{"text":"யாகேலின் நாட்களிலும் வீதிகள் கைவிடப்பட்டிருந்தன.","poem":2},{"lineBreak":true},{"text":"பயணிகள் சுற்றுப்பாதையில் சென்றார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இஸ்ரயேலின் கிராம வாழ்க்கை நின்றுபோயிற்று.","poem":1},{"text":"தெபோராளாகிய நான் இஸ்ரயேலில் தாயாக எழும்பும்வரை","poem":2},{"lineBreak":true},{"text":"அது நின்றுபோயிற்று.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எப்போது அவர்கள் புது தெய்வங்களைத் தெரிந்துகொண்டார்களோ,","poem":1},{"text":"அப்போதே யுத்தமும் பட்டண வாசலில் வந்தது.","poem":2},{"text":"இஸ்ரயேலில் உள்ள நாற்பதாயிரம் பேரிடம்","poem":1},{"text":"கேடயமோ ஈட்டியோ காணப்படவில்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எனது இருதயமோ இஸ்ரயேலின் தலைவர்களோடே இருக்கிறது.","poem":1},{"text":"மக்களுக்குள்ளே விரும்பிவந்த தொண்டர்களுடனும் இருக்கிறது.","poem":2},{"lineBreak":true},{"text":"யெகோவாவைத் துதியுங்கள்!","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“வெள்ளைக் கழுதைமேல் சவாரி செய்கிறவர்களே,","poem":1},{"text":"சேணத்தின் கம்பளத்தில் உட்கார்ந்திருக்கிறவர்களே,","poem":2},{"lineBreak":true},{"text":"வீதி வழியாய் நடப்பவர்களே,","poem":2},{"text":"யோசித்துப் பாருங்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"தண்ணீர் குடிக்கும் இடங்களில் பாடகரின்","poem":1},{"noteId":2},{"text":"குரலையும்.","poem":1},{"text":"அவர்கள் யெகோவாவின் நேர்மையான செயல்களைச் சொல்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலின் வீரர்களின் நேர்மையான செயல்களைச் சொல்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"“அப்பொழுது யெகோவாவிடம் மக்கள்","poem":1},{"text":"பட்டண வாசலுக்கு சென்றார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"விழித்தெழு, விழித்தெழு தெபோராளே!","poem":1},{"text":"விழித்தெழுந்து பாட்டுப்பாடு.","poem":2},{"text":"பாராக்கே எழுந்திரு!","poem":1},{"text":"அபினோமின் மகனே உன்னை சிறைப்பிடித்தவர்களைச் சிறைபிடி.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“தப்பியிருந்த மனிதர் உயர்குடிமக்களிடம் வந்தார்கள்.","poem":1},{"text":"யெகோவாவின் மக்கள் வல்லவர்களுடன் என்னிடம் வந்தார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அமலேக்கியர் வாழும் இடமான எப்பிராயீமிலிருந்து சிலர் வந்தார்கள்.","poem":1},{"text":"பென்யமீனியர் உன்னைப் பின்தொடர்ந்தவர்களுடன் சேர்ந்தார்கள்.","poem":2},{"text":"மாகீரில் இருந்து தலைவர்களும் வந்தார்கள்.","poem":1},{"text":"செபுலோனிலிருந்து அதிகாரிகளும் வந்தார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"இசக்காரின் தலைவர்கள் தெபோராளோடு இருந்தார்கள்.","poem":1},{"text":"ஆம்! இசக்கார் கோத்திரத்தார் பாராக்கின்","poem":2},{"lineBreak":true},{"text":"பின்னே பள்ளத்தாக்கில் விரைந்து சென்றார்கள்.","poem":2},{"text":"ரூபனின் பிரிவைச் சார்ந்தவர்கள்","poem":1},{"text":"தங்கள் இருதயத்தை ஆராய்ந்தார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஏன் நீ தொழுவங்களுக்குள் இருக்கிறாய்?","poem":1},{"text":"மந்தைகளைக் கூப்பிடும் சத்தத்தைக் கேட்பதற்காகவா?","poem":2},{"text":"ரூபனின் பிரிவைச் சார்ந்தவர்கள்","poem":1},{"text":"தங்கள் இருதயத்தை அதிகமாய் ஆராய்ந்தார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"கீலேயாத் யோர்தானின் மறுகரையில் தங்கியிருந்தது.","poem":1},{"text":"தாண், ஏன் கப்பல்களின் அருகே தயங்கி நின்றான்?","poem":2},{"text":"ஆசேர் கடற்கரையில் தரித்து,","poem":1},{"text":"சிறுவளைகுடா பகுதிகளில் தங்கியிருந்தான்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"செபுலோன் மக்களோ தங்கள் உயிரைப் பொருட்படுத்தவில்லை","poem":1},{"text":"அப்படியே நப்தலி மனிதரும் வயலின் மேடுகளில் நின்றனர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“அரசர்கள் வந்தார்கள். அவர்கள் சண்டையிட்டார்கள்.","poem":1},{"text":"கானானின் அரசர்கள் மெகிதோவின் தண்ணீர் அருகே தானாக்கில் யுத்தம் செய்தார்கள்.","poem":2},{"text":"ஆனால் அவர்கள் வெள்ளியையோ,","poem":1},{"text":"கொள்ளையையோ சுமந்து செல்லவில்லை.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"வானங்களில் இருந்து நட்சத்திரங்கள் சண்டையிட்டன.","poem":1},{"text":"அவை தங்கள் வழிகளிலிருந்து சிசெராவுக்கு எதிராகச் சண்டையிட்டன.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"கீசோன் நதி அவர்களை அள்ளிக்கொண்டு போயிற்று.","poem":1},{"text":"பூர்வகாலத்து கீசோன் நதி, அவர்களை அள்ளிக்கொண்டு போயிற்று.","poem":2},{"lineBreak":true},{"text":"ஆகவே என் ஆத்துமாவே நீ வலிமைபெற்று முன்னேறிப் போ;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"குதிரைகளின் குளம்புகள் மூழ்கின.","poem":1},{"text":"அவனுடைய வலிமையான குதிரைகள் பாய்ந்து செல்கின்றன.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"‘மேரோசைச் சபியுங்கள், அதன் மக்களைக் கடுமையாகச் சபியுங்கள்’","poem":1},{"text":"என்று யெகோவாவின் தூதனானவர் சொல்கிறார்.","poem":2},{"text":"‘ஏனெனில் அவர்கள் யெகோவாவுக்கு உதவிசெய்ய வரவில்லை;","poem":1},{"text":"வலியவர்களுக்கு எதிராக யெகோவாவுக்கு உதவிசெய்ய வரவில்லை.’","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“பெண்களுக்குள்ளே யாகேல் அதிகமாய் ஆசீர்வதிக்கப்பட்டவள்,","poem":1},{"text":"கூடாரங்களில் வாழும் பெண்களுக்குள்","poem":2},{"lineBreak":true},{"text":"கேனியனான ஏபேரின் மனைவி அதிகம் ஆசீர்வதிக்கப்பட்டவள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவன் அவளிடம் தண்ணீர் கேட்டான், அவளோ அவனுக்கு பால் கொடுத்தாள்;","poem":1},{"text":"அவள் உயர்குடியினருக்குரிய கிண்ணத்திலே தயிர் கொண்டுவந்தாள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவளது கை கூடாரத்தின் முளையையும்,","poem":1},{"text":"வலதுகை தொழிலாளியின் சுத்தியலையும் எட்டி எடுத்தது.","poem":2},{"text":"அவள் சிசெராவை அடித்தாள், அவனுடைய தலையை நொறுக்கினாள்;","poem":1},{"text":"அவள் அவனுடைய நெற்றியைக் குத்திச் சிதறடித்தாள்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவள் காலடியில் அவன் சரிந்து விழுந்தான்;","poem":1},{"text":"அவன் விழுந்து அங்கேயே கிடந்தான்.","poem":2},{"text":"அவளது காலடியில் சரிந்தான், விழுந்தான்;","poem":1},{"text":"அவன் சரிந்த இடத்திலே விழுந்து செத்தான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ஜன்னல் வழியே சிசெராவின் தாய் எட்டிப்பார்த்தாள்;","poem":1},{"text":"‘ஏன் அவனுடைய இரதம் அங்கே இன்னும் வரவில்லை?","poem":2},{"text":"அவனுடைய இரதங்களின் ஓட்டம் ஏன் இன்னும் தாமதிக்கிறது?’","poem":1},{"text":"என பலகணியின் பின்நின்று புலம்பினாள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவளுடைய தோழிகளில் ஞானமுள்ளவள் பதிலளித்தாள்;","poem":1},{"text":"அவளும் தன் மனதுக்குள் சொல்லிக்கொண்டாள்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"‘அவர்கள் கொள்ளையைக் கண்டுபிடித்து பங்கிடுகிறார்களோ,","poem":1},{"text":"ஆளுக்கு ஒன்றோ, இரண்டோ பெண்கள்,","poem":2},{"text":"சிசெராவுக்கு கொள்ளையிட்ட பலவர்ண உடைகள்,","poem":1},{"text":"கொள்ளையிட்ட சித்திர வேலைப்பாடுள்ள பலவர்ண உடைகள்,","poem":2},{"text":"கொள்ளையிட்டவர்களின் கழுத்துக்கு","poem":1},{"text":"மிக நுட்பமான சித்திர வேலைப்பாடுள்ள உடைகளையும் கொடுக்க வேண்டாமோ?’","poem":2},{"lineBreak":true},{"text":"என்று தனக்குள் சொல்லிக்கொண்டாள்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“எனவே யெகோவாவே, உம்மைப் பகைக்கிறவர்கள் இப்படியே அழியட்டும்!","poem":1},{"text":"உம்மில் அன்புகூருகிறவர்களோ தன் கெம்பீரத்தில் உதிக்கும்","poem":2},{"lineBreak":true},{"text":"சூரியனைப்போல் இருக்கட்டும்.”","poem":2},"இதன்பின்பு நாற்பது வருடங்கள் நாடு சமாதானமாய் இருந்தது."]}],"footnotes":[{"noteId":2,"caller":"+","text":"பாடகரின் அல்லது வில்வீரரின்.","reference":{"chapter":5,"verse":11}}]},"thisChapterLink":"/api/tam_tcv/JDG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JDG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JDG/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}