{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":10,"content":[{"type":"heading","content":["இறைவனும் விக்கிரகங்களும்"]},{"type":"verse","number":1,"content":["இஸ்ரயேல் குடும்பத்தாரே, யெகோவா உங்களுக்குச் சொல்வதைக் கேளுங்கள்."]},{"type":"verse","number":2,"content":["யெகோவா சொல்வது இதுவே:",{"text":"பிறதேசத்தாரின் வழிகளைக் கற்றுக்கொள்ள வேண்டாம்.","poem":1},{"text":"ஆகாயத்தின் அடையாளங்களைக் கண்டு அவர்கள் பயப்படுகிறார்கள்,","poem":2},{"lineBreak":true},{"text":"நீங்களோ அவற்றிற்கு பயப்படாமல் இருங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஏனெனில் அந்த மக்கள் கூட்டங்களின் வழக்கங்கள் பயனற்றவை.","poem":1},{"text":"அவர்கள் காட்டிலிருக்கிற ஒரு மரத்தை வெட்டுகிறார்கள்,","poem":2},{"lineBreak":true},{"text":"தச்சன் அதைத் தன் உளியினால் வடிவமைக்கிறான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் அதை வெள்ளியாலும், தங்கத்தாலும் அலங்கரித்து,","poem":1},{"text":"சுத்தியலாலும், ஆணிகளாலும் அடித்து","poem":2},{"lineBreak":true},{"text":"அது சாய்ந்து விழாதபடி இறுக்குகிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவை வெள்ளரித் தோட்டத்தின் பொம்மையைப்போல காணப்படுகின்றன.","poem":1},{"text":"அவர்களின் விக்கிரகங்கள் பேசமாட்டாது,","poem":2},{"text":"அவைகளால் நடக்கவும் முடியாது.","poem":1},{"text":"ஆகையால் அவைகளைச் சுமந்து செல்லவேண்டும்.","poem":2},{"text":"அவைகள் நன்மையானதையோ,","poem":1},{"text":"தீமையானதையோ செய்ய முடியாதவை.","poem":2},{"lineBreak":true},{"text":"ஆகையால் அவைகளுக்குப் பயப்படாதிருங்கள் என்றார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"யெகோவாவே, உம்மைப்போல் ஒருவருமில்லை.","poem":1},{"text":"நீர் வலிமை மிக்கவர்.","poem":2},{"lineBreak":true},{"text":"உம்முடைய பெயர் ஆற்றலில் வலிமையுள்ளது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நாடுகளின் அரசரே!","poem":1},{"text":"உம்மிடத்தில் பயபக்தியில்லாமல் யார்தான் இருப்பார்கள்?","poem":2},{"lineBreak":true},{"text":"இது உமக்கு மட்டுமே உரியது.","poem":2},{"text":"நாடுகளிலுள்ள எல்லா ஞானிகள் மத்தியிலும்,","poem":1},{"text":"அவர்களுடைய எல்லா அரசுகளுக்குள்ளும்,","poem":2},{"lineBreak":true},{"text":"உம்மைப் போன்றவர் எவருமே இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அவர்கள் எல்லோரும் உணர்ச்சியற்றவர்களும் மூடருமாய் இருக்கிறார்கள்.","poem":1},{"text":"பயனற்ற மரத்தாலான விக்கிரகங்களால் அவர்கள் போதிக்கப்பட்டிருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"வெள்ளித்தகடு தர்ஷீசிலிருந்தும்,","poem":1},{"text":"தங்கம் ஊப்பாசிலிருந்தும் கொண்டுவரப்படுகின்றன.","poem":2},{"text":"கைவினைஞனாலும், கொல்லனாலும் செய்யப்பட்ட விக்கிரகங்களுக்கு நீலநிற உடைகளும்,","poem":1},{"text":"ஊதாநிற உடைகளும் உடுத்தப்பட்டிருக்கின்றன.","poem":2},{"lineBreak":true},{"text":"இவை எல்லாம் சிறந்த தொழிலாளிகளினால் செய்யப்பட்டவை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆனாலும், யெகோவாவே உண்மையான இறைவன்.","poem":1},{"text":"அவரே வாழும் இறைவன்; நித்திய அரசர்.","poem":2},{"text":"அவர் கோபங்கொள்ளும்போது பூமி நடுங்குகிறது.","poem":1},{"text":"அவருடைய கடுங்கோபத்தை நாடுகள் தாங்கிக்கொள்ள மாட்டாது.","poem":2}]},{"type":"verse","number":11,"content":["வானங்களையும், பூமியையும் படைக்காத இந்த தெய்வங்கள் பூமியிலிருந்தும், வானங்களின் கீழிருந்தும் அழிந்துவிடும் என்பதை அவர்களுக்குச் சொல்.",{"noteId":8}]},{"type":"verse","number":12,"content":[{"text":"ஆனால் இறைவன் தமது வல்லமையினால் பூமியைப் படைத்து,","poem":1},{"text":"தமது ஞானத்தினால் உலகத்தை நிறுவி,","poem":2},{"lineBreak":true},{"text":"தமது அறிவாற்றலினால் வானங்களை விரித்தார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர் முழங்கும்போது, வானங்களிலுள்ள திரளான தண்ணீர் இரைகின்றன.","poem":1},{"text":"அவர் பூமியின் கடைசி எல்லைகளிலிருந்து மேகங்களை எழும்பப்பண்ணுகிறார்.","poem":2},{"text":"அவர் மழையுடன் மின்னலை அனுப்பி,","poem":1},{"text":"தமது களஞ்சியங்களிலிருந்து காற்றை வெளியே கொண்டுவருகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஒவ்வொரு மனிதனும் உணர்வற்றவனும், அறிவற்றவனுமாயிருக்கிறான்.","poem":1},{"text":"ஒவ்வொரு கொல்லனும் தன் விக்கிரகங்களால் வெட்கமடைகிறான்.","poem":2},{"text":"ஏனெனில் அவனுடைய உருவச்சிலைகள் போலியானவை.","poem":1},{"text":"அவைகளில் சுவாசமில்லை.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவைகள் பயனற்றவையாகவும், கேலிக்குரிய பொருட்களாகவும் இருக்கின்றன.","poem":1},{"text":"அவைகளுக்குரிய தண்டனை வரும்போது அவை அழிந்துபோகும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யாக்கோபின் பங்காயிருப்பவர் இவைகளைப் போன்றவர் அல்ல.","poem":1},{"text":"ஏனெனில், அவரே எல்லாவற்றையும் படைத்தவர்.","poem":2},{"text":"அவருடைய உரிமைச்சொத்தான இஸ்ரயேல் கோத்திரத்தையும் அவரே படைத்தார்.","poem":1},{"text":"சேனைகளின் யெகோவா என்பது அவருடைய பெயர்.","poem":2}]},{"type":"heading","content":["வரப்போகும் அழிவு"]},{"type":"verse","number":17,"content":[{"text":"கைதிகளாக வாழும் எருசலேம் மக்களே!","poem":1},{"text":"நாட்டைவிட்டுப் போவதற்கு உங்கள் பொருட்களைச் சேர்த்துக்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஏனெனில் யெகோவா சொல்வது இதுவே:","poem":1},{"text":"“அந்த நாட்டில் குடியிருப்பவர்களை","poem":2},{"lineBreak":true},{"text":"நான் இப்போதே அகற்றிவிடுவேன்.","poem":2},{"text":"நான் அவர்கள்மீது துன்பத்தைக் கொண்டுவருவேன்.","poem":1},{"text":"அவர்கள் சிறைப்பிடிக்கப்படுவார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"என் காயத்தினால் எனக்கு எவ்வளவு வேதனை!","poem":1},{"text":"என் காயம் குணமாக்க முடியாத ஒன்றாய் இருக்கிறது.","poem":2},{"text":"ஆனால் நானோ,","poem":1},{"text":"“இது என் வருத்தம்; நானே அதைத் தாங்கிக்கொள்ள வேண்டும்” என எனக்குள் கூறினேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"என் கூடாரம் அழிந்துவிட்டது.","poem":1},{"text":"அதன் கயிறுகளும் அறுந்துபோயின.","poem":2},{"text":"என் மகன்கள் என்னைவிட்டு போய்விட்டார்கள். அவர்கள் என்னிடம் இல்லை.","poem":1},{"text":"இப்போது என்னுடைய கூடாரத்தைப் போடவோ,","poem":2},{"lineBreak":true},{"text":"என் புகலிடத்தை அமைக்கவோ யாருமில்லை.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"மேய்ப்பர்கள் உணர்வற்றவர்களாய் இருக்கிறார்கள்.","poem":1},{"text":"அவர்கள் யெகோவாவிடம் விசாரிக்கிறதில்லை.","poem":2},{"text":"ஆகையினால் அவர்கள் செழித்தோங்கவில்லை.","poem":1},{"text":"அவர்கள் மந்தைகளும் சிதறிப்போயின.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"கேளுங்கள்! செய்தி ஒன்று வருகிறது.","poem":1},{"text":"வடநாட்டிலிருந்து ஒரு பெரும் அமளியின் சத்தம் கேட்கிறது.","poem":2},{"text":"அது யூதாவின் பட்டணங்களைப் பாழாக்கி,","poem":1},{"text":"அவைகளை நரிகளின் இருப்பிடமாக்கும்.","poem":2}]},{"type":"heading","content":["எரேமியாவின் மன்றாட்டு"]},{"type":"verse","number":23,"content":[{"text":"யெகோவாவே, ஒரு மனிதனின் உயிர் அவன் வசத்தில் இல்லை என்பதையும்,","poem":1},{"text":"தன் வழிகளை அமைத்துக்கொள்வதற்கு மனிதனால் இயலாது என்பதையும் நான் அறிவேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"யெகோவாவே, என்னை நீதியுடன் சீர்திருத்தும்.","poem":1},{"text":"நான் அழிந்துபோகாதபடி","poem":2},{"lineBreak":true},{"text":"உம்முடைய கோபத்தில் தண்டியாதிரும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உமது கடுங்கோபத்தை உம்மை ஏற்றுக்கொள்ளாத நாட்டினர்மேலும்,","poem":1},{"text":"உமது பெயரைச்சொல்லிக் கூப்பிடாத","poem":2},{"lineBreak":true},{"text":"மக்கள்மேலும் ஊற்றும்.","poem":2},{"text":"ஏனெனில் அவர்கள் யாக்கோபை விழுங்கினார்கள்.","poem":1},{"text":"அவனை முற்றிலுமாக விழுங்கி,","poem":2},{"lineBreak":true},{"text":"அவனுடைய தாய் நாட்டையும் அழித்துப்போட்டார்கள்.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"மூலபிரதியில் இவ்வசனம் அராமிய மொழியில் உள்ளது.","reference":{"chapter":10,"verse":11}}]},"thisChapterLink":"/api/tam_tcv/JER/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/9.json","previousChapterAudioLinks":{},"numberOfVerses":25}