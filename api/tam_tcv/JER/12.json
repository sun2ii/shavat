{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":12,"content":[{"type":"heading","content":["எரேமியாவின் குற்றச்சாட்டு"]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உமக்கு முன்பாக நான் வழக்குகளைக் கொண்டுவரும்போதெல்லாம்","poem":1},{"text":"நீர் நீதியுள்ளவராகவே இருக்கிறீர்.","poem":2},{"text":"ஆகையினால் உம்முடைய நீதியைக் குறித்து நான் உம்மிடம் பேசப் போகிறேன்:","poem":1},{"text":"கொடியவர்களின் செயல்கள் செழிப்பது ஏன்?","poem":2},{"lineBreak":true},{"text":"நேர்மையற்றோர் கஷ்டமின்றி வாழ்வது ஏன்?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீர் அவர்களை நாட்டியிருக்கிறீர். அவர்கள் வேரூன்றியிருக்கிறார்கள்.","poem":1},{"text":"வளர்ந்து அவர்கள் கனி கொடுக்கிறார்கள்.","poem":2},{"text":"எப்போதும் நீர் அவர்களின் உதடுகளில் இருக்கிறீர்.","poem":1},{"text":"ஆனாலும் அவர்கள் இருதயங்களுக்கோ நீர் தூரமாய் இருக்கிறீர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஆனாலும் யெகோவாவே, நீர் என்னை அறிவீர்.","poem":1},{"text":"நீர் என்னைக் காண்கிறீர்; உம்மைப் பற்றிய என் சிந்தனைகளைச் சோதிக்கிறீர்.","poem":2},{"text":"வெட்டுவதற்கான செம்மறியாடுகளைப்போல அவர்களை இழுத்துச் செல்லும்.","poem":1},{"text":"அவர்களைக் கொல்லப்படும் நாளுக்கென ஒதுக்கிவையும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"எவ்வளவு காலத்திற்கு நாடு வறண்டும்,","poem":1},{"text":"வயல்களிலுள்ள புல் வாடியும் கிடக்கவேண்டும்?","poem":2},{"text":"அதில் வாழ்கிறவர்கள் கொடியவர்களாகையினால் மிருகங்களும்,","poem":1},{"text":"பறவைகளும் அழிந்துவிட்டன.","poem":2},{"text":"அதுவுமில்லாமல் மக்களோ,","poem":1},{"text":"“எங்களுக்கு என்ன நேரிடுகிறது என்பதை அவர் காணமாட்டார்” என்கிறார்கள்.","poem":2}]},{"type":"heading","content":["இறைவனின் பதில்"]},{"type":"verse","number":5,"content":[{"text":"காலால் ஓடும் மனிதரோடு ஓடும்போதே,","poem":1},{"text":"அவர்கள் உன்னைக் களைப்படையச் செய்வார்களானால்","poem":2},{"lineBreak":true},{"text":"குதிரைகளோடு நீ எப்படிப் போட்டியிடுவாய்?","poem":2},{"text":"பாதுகாப்பான நாட்டிலேயே இடறுவாயானால்,","poem":1},{"text":"யோர்தானின் புதர் காடுகளில் நீ என்ன செய்வாய்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உன் சொந்தக் குடும்பத்தினராகிய உன் சகோதரர்களே,","poem":1},{"text":"உனக்குத் துரோகம் செய்துவிட்டார்கள்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் உனக்கு விரோதமாகக் குரலெழுப்பினார்கள்.","poem":2},{"text":"உன்னைப்பற்றி நன்மையாய்ப் பேசினாலும்,","poem":1},{"text":"அவர்களை நீ நம்பவேண்டாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நான் என் வீட்டைக் கைவிட்டு,","poem":1},{"text":"என் உரிமைச்சொத்தைப் புறக்கணிப்பேன்.","poem":2},{"text":"என் அன்புக்குரியவளை","poem":1},{"text":"அவளுடைய பகைவரின் கையில் கொடுத்துவிடுவேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் உரிமைச்சொத்தோ,","poem":1},{"text":"எனக்குக் காட்டிலிருக்கும் சிங்கத்தைப்போல் ஆயிற்று.","poem":2},{"text":"அவள் என்னைப் பார்த்துக் கர்ஜிக்கிறாள்;","poem":1},{"text":"ஆதலால் நான் அவளை வெறுக்கிறேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"என் உரிமைச்சொத்தாகிய மக்கள்","poem":1},{"text":"இரைதேடும் பலவர்ண பறவைகள்போல் ஆயிற்று;","poem":2},{"lineBreak":true},{"text":"சுற்றிலுமுள்ள மற்ற பறவைகளோ அதற்கு எதிராக எழுந்துள்ளன.","poem":2},{"text":"அதை விழுங்கும்படி","poem":1},{"text":"காட்டு மிருகங்களை ஒன்றுசேர்த்து, அவைகளைக் கொண்டுவா.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அநேக மேய்ப்பர்கள் என் திராட்சைத் தோட்டத்தை அழித்துவிடுவார்கள்.","poem":1},{"text":"என் வயலை மிதித்துப் போடுவார்கள்.","poem":2},{"text":"அவர்கள் எனது அழகான வயலை","poem":1},{"text":"ஒரு வனாந்திரமான பாழ்நிலமாக்கி விடுவார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அது எனக்கு முன்பாக வறண்டு,","poem":1},{"text":"வனாந்திரமான பாழ்நிலமாகும்.","poem":2},{"text":"அது கவனிப்பார் இல்லாதபடியால்","poem":1},{"text":"நாடு முழுவதும் பாழ்நிலமாகும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பாலைவனத்தில் எல்லா வறண்ட மேடுகள்மேலும்","poem":1},{"text":"அழிக்கிறவர்கள் கூடுவார்கள்.","poem":2},{"text":"யெகோவாவின் வாள் நாட்டின்","poem":1},{"text":"ஒரு முனையிலிருந்து மறுமுனைவரை பட்சிப்பதால்,","poem":2},{"lineBreak":true},{"text":"ஒருவருக்குமே பாதுகாப்பு இருக்காது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் கோதுமையை விதைத்தார்கள், முட்களை அறுப்பார்கள்;","poem":1},{"text":"அவர்கள் களைத்து வேலை செய்வார்கள், ஆனால் பலனேதும் பெறமாட்டார்கள்.","poem":2},{"text":"யெகோவாவின் பயங்கர கோபத்தின் நிமித்தம்","poem":1},{"text":"அவர்கள் அறுவடையின்றி ஏமாந்து வெட்கமடைவார்கள்.","poem":2}]},{"type":"verse","number":14,"content":["யெகோவா சொல்வது இதுவே: “என் மக்களாகிய இஸ்ரயேலருக்கு நான் கொடுத்த உரிமைச்சொத்தைப் பறிக்கிற கொடுமையான அயலவரைப் பொறுத்தவரையில், நான் அவர்களுடைய நாடுகளிலிருந்து அவர்களை வேரோடு அறுப்பேன். யூதா குடும்பத்தையோ அவர்கள் மத்தியிலிருந்து பிடுங்கி எடுத்துக்கொள்வேன்."]},{"type":"verse","number":15,"content":["ஆனால் அவர்களைப் பிடுங்கிய பின்பு மீண்டும் அவர்களில் இரக்கங்கொண்டு அவர்கள் ஒவ்வொருவனையும் அவனவனுடைய உரிமைச்சொத்துக்கும் சொந்த நாட்டுக்கும் கொண்டுவருவேன்."]},{"type":"verse","number":16,"content":["அவர்கள் என் மக்களின் வழிகளை நன்றாகக் கற்றுக்கொண்டால், அவர்கள் என் மக்கள் மத்தியில் நிலைபெறுவார்கள். முன்னொரு காலத்தில் பாகாலின்மேல் ஆணையிட என் மக்களுக்கு அவர்கள் போதித்திருந்தார்கள். அதுபோல இப்பொழுது அவர்கள், ‘யெகோவா இருப்பது நிச்சயமெனில்’ என்று என் பெயரினால் ஆணையிடுவதற்கு பழகினால், அவர்கள் நிலைபெறுவார்கள்."]},{"type":"verse","number":17,"content":["ஆனால் எந்த மக்களாவது இதற்குச் செவிகொடாமல் விட்டால், நான் அதை முழுவதும் வேரோடு அறுத்து அழித்துவிடுவேன்” என்று யெகோவா கூறுகிறார்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JER/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/11.json","previousChapterAudioLinks":{},"numberOfVerses":17}