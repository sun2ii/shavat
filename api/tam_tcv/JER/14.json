{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":14,"content":[{"type":"heading","content":["வறட்சி, பஞ்சம், வாள்"]},{"type":"verse","number":1,"content":["வறட்சியைக் குறித்து யெகோவாவிடமிருந்து எரேமியாவுக்கு வந்த வார்த்தை இதுவாகும்:"]},{"type":"verse","number":2,"content":[{"text":"யூதா துக்கப்படுகிறது;","poem":1},{"text":"அதன் பட்டணங்கள் நலிவுறுகின்றன;","poem":2},{"text":"அவர்கள் நாட்டுக்காகப் புலம்புகிறார்கள்.","poem":1},{"text":"எருசலேமிலிருந்து ஒரு அழுகுரல் எழும்புகிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உயர்குடி மக்கள் தங்கள் வேலைக்காரரை தண்ணீர் எடுப்பதற்கு அனுப்புகிறார்கள்.","poem":1},{"text":"அவர்கள் போய் தொட்டிகளில்","poem":2},{"lineBreak":true},{"text":"தண்ணீரைக் காணாமல்,","poem":2},{"text":"தங்கள் ஜாடிகளை வெறுமையாகவே கொண்டுவருகிறார்கள்.","poem":1},{"text":"அவர்கள் மனச்சோர்வுடனும்,","poem":2},{"lineBreak":true},{"text":"ஏமாற்றத்துடனும் தங்கள் தலைகளை மூடிக்கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நாட்டில் மழையில்லாததால்","poem":1},{"text":"நிலம் வெடித்திருக்கிறது.","poem":2},{"text":"விவசாயிகள் மனச்சோர்வுடன் தங்கள்","poem":1},{"text":"தலைகளை மூடிக்கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"புல் இல்லாததினால்","poem":1},{"text":"வயல்வெளியிலுள்ள பெண்மானும்","poem":2},{"lineBreak":true},{"text":"புதிதாய் ஈன்ற தன் குட்டிகளை கைவிடுகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"காட்டுக் கழுதைகள் வறண்ட மேடுகளில் நின்று,","poem":1},{"text":"தாகமுள்ள நரிகளைப்போல் இளைக்கின்றன.","poem":2},{"text":"அவைகளுக்கு மேய்ச்சல் நிலமின்றி","poem":1},{"text":"கண்பார்வை மங்கிவிடுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"எங்கள் பாவங்கள் எங்களுக்கு விரோதமாகச் சாட்சி கூறினாலும்,","poem":1},{"text":"யெகோவாவே, உமது பெயரின் நிமித்தம் நீர் ஏதாவது எங்களுக்கு செய்யும்.","poem":2},{"text":"எங்கள் பின்மாற்றம் பெரிதாயிருக்கிறது.","poem":1},{"text":"நாங்கள் உமக்கு விரோதமாய்ப் பாவம் செய்திருக்கிறோம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"இஸ்ரயேலின் எதிர்ப்பார்ப்பே,","poem":1},{"text":"துயர வேளையின் மீட்பரே,","poem":2},{"text":"நீர் நாட்டில் ஒரு அந்நியனைப்போலவும்,","poem":1},{"text":"ஒரு இரவு மட்டும் தங்கும் பயணியைப்போலவும் ஏன் இருக்கிறீர்?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீர் திகைப்படைந்த மனிதனைப்போலவும்,","poem":1},{"text":"காப்பாற்ற வலுவற்ற போர்வீரனைப்போலவும் ஏன் இருக்கிறீர்?","poem":2},{"text":"யெகோவாவே, நீர் எங்கள் மத்தியில் இருக்கிறீர்;","poem":1},{"text":"நாங்கள் உமது பெயரைத் தரித்திருக்கிறோம்.","poem":2},{"lineBreak":true},{"text":"எங்களைக் கைவிடாதேயும்.","poem":2}]},{"type":"verse","number":10,"content":["மேலும் இந்த மக்களைப் பற்றி யெகோவா சொல்வது இதுவே:",{"text":"இவர்கள் சுற்றித்திரிய பெரிதும் விரும்புகிறார்கள்.","poem":1},{"text":"தங்கள் கால்களைக் கட்டுப்படுத்துகிறதில்லை.","poem":2},{"text":"ஆகையினால் யெகோவா அவர்களை ஏற்றுக்கொள்ளவில்லை.","poem":1},{"text":"அவர் இப்பொழுது அவர்களின் கொடுமைகளை நினைத்து,","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய பாவங்களுக்காக அவர்களைத் தண்டிப்பார்.","poem":2}]},{"type":"verse","number":11,"content":["மேலும் யெகோவா என்னிடம், இந்த மக்களின் நன்மைக்காக நீ என்னிடம் விண்ணப்பம் செய்யவேண்டாம்."]},{"type":"verse","number":12,"content":["அவர்கள் உபவாசித்தாலும் நான் அவர்களுடைய கூப்பிடுதலைக் கேட்கமாட்டேன். அவர்கள் தகனபலியையும், தானியபலியையும் படைத்தாலும், அவைகளை நான் ஏற்றுக்கொள்ளவும் மாட்டேன். அதற்குப் பதிலாக நான் அவர்களை வாளினாலும், பஞ்சத்தினாலும், கொள்ளைநோயினாலும் அழிக்கப்போகிறேன் என்றார்."]},{"type":"verse","number":13,"content":["அப்பொழுது நான், “ஆண்டவராகிய யெகோவாவே! இந்த பொய்யான இறைவாக்கு உரைப்போர் மக்களை நோக்கி, ‘நீங்கள் வாளைக் காணமாட்டீர்கள்; பஞ்சத்தினால் பாதிக்கப்படமாட்டீர்கள்; நான் இந்த இடத்தில் உங்களுக்கு நீடித்த சமாதானத்தை நிச்சயம் தருவேன்’ என்று சொல்லிக் கொண்டிருக்கிறார்கள்” என்றேன்."]},{"type":"verse","number":14,"content":["அப்பொழுது யெகோவா என்னிடம், “பொய் இறைவாக்கு உரைப்போர் என்னுடைய பெயரைக்கொண்டு பொய்யையே இறைவாக்கு என்று சொல்கிறார்கள். நான் அவர்களை அனுப்பவுமில்லை; நியமிக்கவுமில்லை. அவர்களோடு பேசவுமில்லை. அவர்களோ பொய்யான தரிசனத்தையும், குறிசொல்லுதலையும், விக்கிரக வணக்கத்தையும், தங்கள் மனதின் வஞ்சகத்தையுமே இறைவாக்கு என்று உரைக்கிறார்கள்” என்றார்."]},{"type":"verse","number":15,"content":["தன் பெயரினால் இறைவாக்கு உரைக்கிற பொய்யான இறைவாக்கு உரைப்போரைப்பற்றி யெகோவா சொல்வது இதுவே: “நான் அவர்களை அனுப்பவில்லை. ஆகிலும் அவர்கள், ‘இந்த நாட்டை வாளோ, பஞ்சமோ தொடாது’ என்கிறார்கள். அதே இறைவாக்கு உரைப்போர் வாளாலும், பஞ்சத்தாலும் அழிவார்கள்."]},{"type":"verse","number":16,"content":["அவர்களுடைய இறைவாக்கைக் கேட்கும் மக்களும் பஞ்சத்தினாலும், வாளினாலும் எருசலேமின் வீதிகளில் விழுவார்கள். அவர்களையாவது, அவர்களின் மனைவிகளையாவது, மகன்களையாவது, மகள்களையாவது அடக்கம்பண்ண ஒருவரும் இருக்கமாட்டார்கள். ஏனெனில் அவர்களுக்கு ஏற்ற பேராபத்தை அவர்கள்மீது ஊற்றுவேன்” என்றார்."]},{"type":"line_break"},{"type":"verse","number":17,"content":["இந்த வார்த்தைகளை அவர்களிடம் சொல்:",{"text":"“அவர்களை நோக்கி,","poem":1},{"text":"இரவும், பகலும் என் கண்களிலிருந்து கண்ணீர் ஓயாமல் சிந்தட்டும்.","poem":2},{"text":"என் மக்கள், என் கன்னிகை மகள்","poem":1},{"text":"கடும் காயம் அடைந்து","poem":2},{"lineBreak":true},{"text":"நொறுங்குண்டிருக்கிறாள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நான் நாட்டுப்புறத்திற்கு போகையில்","poem":1},{"text":"வாளினால் கொலையுண்டவர்களைக் காண்கிறேன்.","poem":2},{"text":"பட்டணத்துக்குள் போகையில்","poem":1},{"text":"பஞ்சத்தால் ஏற்பட்ட அழிவையும் காண்கிறேன்.","poem":2},{"text":"இறைவாக்கினரும், ஆசாரியரும்","poem":1},{"text":"தாங்கள் அறியாத ஒரு நாட்டிற்குப் போய்விட்டார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யெகோவாவே! நீர் யூதாவை முழுவதாகப் புறக்கணித்துத் தள்ளிவிட்டீரோ?","poem":1},{"text":"நீர் சீயோனை இகழ்கிறீரோ?","poem":2},{"text":"நாங்கள் குணமாக முடியாதபடி","poem":1},{"text":"ஏன் எங்களைத் துன்புறுத்தியிருக்கிறீர்?","poem":2},{"text":"நாங்கள் சமாதானத்தை எதிர்பார்த்தோம்;","poem":1},{"text":"ஆனால் ஒரு நன்மையும் வரவில்லை.","poem":2},{"text":"குணமாகும் வேளையை எதிர்பார்த்தோம்;","poem":1},{"text":"ஆனால் பயங்கரம் மட்டுமே காணப்பட்டது.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"யெகோவாவே, எங்கள் கொடுமையையும்,","poem":1},{"text":"எங்கள் முற்பிதாக்களின் குற்றத்தையும் நாங்கள் ஏற்றுக்கொள்கிறோம்.","poem":2},{"lineBreak":true},{"text":"நாங்கள் மெய்யாகவே உமக்கு எதிராகப் பாவம்செய்தோம்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"உமது நாமத்தினிமித்தம் எங்களை வெறுக்காதேயும்;","poem":1},{"text":"உமது மகிமையான அரியணையைக் கனவீனப்படுத்தாதேயும்.","poem":2},{"text":"நீர் எங்களுடன் செய்த உடன்படிக்கையை நினைவுகூரும்.","poem":1},{"text":"அதை முறித்து விடாதிரும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"பிறநாட்டினரின் பயனற்ற விக்கிரகங்களில் எதுவும் மழையைப் பெய்யப்பண்ணுமோ?","poem":1},{"text":"ஆகாயங்கள் தாமாகவே மழையைப் பொழிகின்றனவோ?","poem":2},{"text":"இல்லை; எங்கள் இறைவனாகிய யெகோவாவே! நீரேதான் அதைச் செய்கிறீர்.","poem":1},{"text":"ஆதலால் எங்கள் எதிர்பார்ப்பு உம்மிலேயே இருக்கிறது.","poem":2},{"lineBreak":true},{"text":"இதையெல்லாம் செய்கிறவர் நீரே.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JER/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}