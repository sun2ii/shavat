{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":20,"content":[{"type":"heading","content":["எரேமியாவும் பஸ்கூரும்"]},{"type":"verse","number":1,"content":["இம்மேரின் மகனாகிய ஆசாரியன் பஸ்கூர் யெகோவாவின் ஆலயத்தின் பிரதான அதிகாரியாயிருந்தான். அப்போது அவன், எரேமியா இறைவாக்காகக் கூறியவற்றைக் கேட்டான்."]},{"type":"verse","number":2,"content":["பஸ்கூர் இறைவாக்கினன் எரேமியாவை அடித்து, யெகோவாவின் ஆலயத்திற்கு அருகேயிருந்த பென்யமீன் மேல்வாசலில் உள்ள காவலறையில் போட்டான்."]},{"type":"verse","number":3,"content":["அடுத்தநாள் பஸ்கூர் எரேமியாவை காவலறையிலிருந்து விடுதலையாக்கியபோது, எரேமியா அவனைப் பார்த்து, “யெகோவா உன்னை பஸ்கூர்",{"noteId":12},"என்றல்ல, மாகோர் மிசாபீப்",{"noteId":13},"என அழைக்கிறார்."]},{"type":"verse","number":4,"content":["ஏனெனில் யெகோவா சொல்வது இதுவே: ‘நான் உன்னையும், உன் எல்லா நண்பர்களையும் பயத்திற்கு ஒப்புக்கொடுக்கிறேன். உன் பகைவர்களின் வாளினால் அவர்கள் வெட்டுண்டு விழுவதை நீ உன் கண்களினாலேயே காண்பாய். நான் யூதாவின் மக்கள் எல்லோரையும், பாபிலோன் அரசனின் கையில் ஒப்புக்கொடுப்பேன். அவன் அவர்களைப் பாபிலோனுக்குச் சிறைப்பிடித்துக் கொண்டுபோவான் அல்லது வாளுக்கு இரையாக்குவான்."]},{"type":"verse","number":5,"content":["நான் இந்தப் பட்டணத்தின் உற்பத்திப் பொருட்களான செல்வம் முழுவதையும், அவர்களுடைய பகைவர்களின் கையில் ஒப்படைப்பேன்; விலைமதிப்புள்ள சகல பொருட்களையும், யூதா அரசர்களது பொக்கிஷங்கள் அனைத்தையும் ஒப்புக்கொடுப்பேன். அவர்கள் அவைகளைக் கொள்ளையிட்டுப், பாபிலோனுக்குக் கொண்டுபோவார்கள்."]},{"type":"verse","number":6,"content":["பஸ்கூரே, நீயும் உன் குடும்பம் முழுவதும் பாபிலோனுக்கு நாடுகடத்தப்படுவீர்கள். அங்கே நீயும், உன் பொய் தீர்க்கதரிசனத்தைக் கேட்ட உன் எல்லாச் சிநேகிதரும் செத்து புதைக்கப்படுவீர்கள் என்கிறார்’ என்றான்.”"]},{"type":"heading","content":["எரேமியாவின் குற்றச்சாட்டு"]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே! நீர் என்னை ஏமாற்றிவிட்டீர், நான் ஏமாந்து போனேன்;","poem":1},{"text":"நீர் உமது பலத்தினால் என்னை அடக்கி என்னை மேற்கொண்டீர்.","poem":2},{"text":"நாள்முழுவதும் நான் கேலி செய்யப்படுகிறேன்.","poem":1},{"text":"எல்லோரும் என்னை ஏளனம் பண்ணுகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் பேசும்போதெல்லாம் வன்முறையையும்,","poem":1},{"text":"அழிவையுமே சத்தமிட்டுக் கூறி அறிவிக்கிறேன்.","poem":2},{"text":"ஆகவே யெகோவாவின் வார்த்தை, காலமெல்லாம் எனக்கு அவமானத்தையும்,","poem":1},{"text":"நிந்தையையுமே கொண்டு வந்திருக்கிறது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஆனால் நான், “அவரைப்பற்றி ஒன்றும் சொல்லமாட்டேன்;","poem":1},{"text":"இல்லையெனில், அவருடைய பெயரில் இனிமேல் பேசமாட்டேன்”","poem":2},{"text":"என்று சொல்வேனாகில், அவருடைய வார்த்தை என் எலும்புகளுக்குள் அடைக்கப்பட்டு,","poem":1},{"text":"என் இருதயத்தில் எரிகிற நெருப்பைப்போல் இருக்கிறதே.","poem":2},{"text":"அதை அடக்கிவைக்க முயன்று இளைத்துவிட்டேன்.","poem":1},{"text":"என்னால் அதை அடக்கிவைக்கவே முடியாது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"சுற்றிலும்","poem":1},{"text":"“பயங்கரமே காணப்படுகிறது.","poem":2},{"lineBreak":true},{"text":"கண்டிக்கிறோம்! அவனை கண்டனம் செய்கிறோம்!”","poem":2},{"text":"என்று அநேகர் தாழ் குரலில் சொல்வதைக் கேட்கிறேன்.","poem":1},{"text":"என்னுடைய நண்பர்கள் எல்லோரும்","poem":2},{"text":"என் விழுகைக்காக காத்துக்கொண்டிருக்கிறார்கள்.","poem":1},{"text":"அவர்கள், “ஒருவேளை அவன் ஏமாந்து போவான்;","poem":2},{"lineBreak":true},{"text":"அப்பொழுது நாம் அவனை மேற்கொண்டு அவனைப் பழிவாங்குவோம்” என்று சொல்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ஆனாலும், யெகோவா வலிமையுள்ள போர்வீரனைப்போல் என்னுடன் இருக்கிறார்.","poem":1},{"text":"ஆகையால் என்னைத் துன்புறுத்துகிறவர்கள் இடறுவார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் என்னை மேற்கொள்ளமாட்டார்கள்.","poem":2},{"text":"அவர்கள் தோற்றுப்போய் மிகவும் அவமானம் அடைவார்கள்;","poem":1},{"text":"அவர்களின் அவமானம் ஒருபோதும் மறக்கப்படமாட்டாது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"சேனைகளின் யெகோவாவே! நீதிமானைச் சோதித்து,","poem":1},{"text":"இருதயத்தையும், மனதையும் ஆராய்கிறவரே!","poem":2},{"text":"நீர் அவர்களைப் பழிவாங்குவதை நான் காணும்படி செய்யும்.","poem":1},{"text":"ஏனெனில் நான் என் வழக்கை உம்மிடத்தில் ஒப்படைத்துவிட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"யெகோவாவைப் புகழ்ந்து பாடுங்கள்;","poem":1},{"text":"யெகோவாவுக்குத் துதி செலுத்துங்கள்;","poem":2},{"text":"அவர் கொடியவர்களின் கையிலிருந்து","poem":1},{"text":"எளியவர்களுடைய உயிரைத் தப்புவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"நான் பிறந்தநாள் சபிக்கப்படுவதாக.","poem":1},{"text":"என் தாய் என்னைப் பெற்ற நாள் ஆசீர்வதிக்கப்படாமல் இருப்பதாக.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“ஒரு மகன் பிறந்திருக்கிறான்”","poem":1},{"text":"என்ற செய்தியைக் கொண்டுவந்து","poem":2},{"lineBreak":true},{"text":"என் தந்தையை மகிழ்வித்த மனிதன் சபிக்கப்படுவானாக.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அந்த மனிதன், யெகோவா தயங்காமல்","poem":1},{"text":"கவிழ்த்துப்போட்ட பட்டணங்களைப் போலிருப்பானாக.","poem":2},{"text":"அவன் காலையில் அழுகுரலையும்,","poem":1},{"text":"நண்பகலில் போர் முழக்கத்தையும் கேட்பானாக.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஏனெனில் அவன் என்னைக் கருப்பையிலேயே கொல்லாமற்போனானே.","poem":1},{"text":"அப்பொழுது என் தாயின் கருப்பை","poem":2},{"lineBreak":true},{"text":"என் கல்லறையாய் இருந்திருக்குமே.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"கஷ்டத்தையும், துன்பத்தையும் கண்டு","poem":1},{"text":"அவமானத்திலே என் வாழ்நாளை முடிக்கும்படி","poem":2},{"lineBreak":true},{"text":"கர்ப்பத்திலிருந்து நான் வெளியே வந்ததேன்?","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"பஸ்கூர் என்றால் விடுதலை என்பதாகும்","reference":{"chapter":20,"verse":3}},{"noteId":13,"caller":"+","text":"மாகோர் மிசாபீப் என்றால் எபிரெயத்தில் சுற்றிலும் பேரச்சத்தில் வாழும் மனிதன் என்பதாகும்","reference":{"chapter":20,"verse":3}}]},"thisChapterLink":"/api/tam_tcv/JER/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/19.json","previousChapterAudioLinks":{},"numberOfVerses":18}