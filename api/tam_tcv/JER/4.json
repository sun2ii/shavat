{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"இஸ்ரயேலே, “நீ திரும்பிவர","poem":1},{"text":"விரும்பினால் என்னிடம் திரும்பி வா” என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“நீ என் பார்வையிலிருந்து உன் அருவருப்பான விக்கிரகங்களை அகற்றி,","poem":1},{"text":"இனி ஒருபோதும் வழிவிலகாதிருந்து,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உண்மையும், நீதியும், நேர்மையுமான வழியில் நடந்து","poem":1},{"text":"‘யெகோவா இருப்பது நிச்சயமெனில்’","poem":2},{"text":"என்று நீ ஆணையிடுவாயானால், எல்லா நாட்டினரும் அவரால் ஆசீர்வதிக்கப்படுவார்கள்.","poem":1},{"text":"அவரில் அவர்கள் மகிழ்ச்சிகொள்வார்கள்” என்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":["யூதாவின் மனிதருக்கும், எருசலேமின் மனிதருக்கும் யெகோவா கூறுவது இதுவே:",{"text":"“உழப்படாத உங்கள் நிலத்தைப் பண்படுத்துங்கள்.","poem":1},{"text":"முட்களுக்குள்ளே விதைக்காதிருங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யூதாவின் மனிதரே, எருசலேமின் மக்களே,","poem":1},{"text":"யெகோவாவுக்கென்று உங்களை விருத்தசேதனம்","poem":2},{"noteId":3},{"text":"பண்ணுங்கள்,","poem":2},{"lineBreak":true},{"text":"உங்கள் இருதயங்களை விருத்தசேதனம் பண்ணுங்கள்.","poem":2},{"text":"இல்லையெனில் நீங்கள் செய்திருக்கிற தீமையினால்,","poem":1},{"text":"என்னுடைய கோபம் வெளிப்பட்டு,","poem":2},{"lineBreak":true},{"text":"அணைப்பாரில்லாத நெருப்பைப்போல் எரியும்.","poem":2}]},{"type":"heading","content":["வடக்கிலிருந்து வரும் பேரழிவு"]},{"type":"verse","number":5,"content":[{"text":"“யூதாவில் அறிவித்து, எருசலேமில் பிரசித்தப்படுத்திச் சொல்லுங்கள்:","poem":1},{"text":"‘நாடு முழுவதும் எக்காளம் ஊதுங்கள்!’","poem":2},{"text":"சத்தமிட்டு:","poem":1},{"text":"‘ஒன்றுகூடுங்கள்!","poem":2},{"lineBreak":true},{"text":"பாதுகாப்பான பட்டணங்களுக்கு ஓடுவோம்!’ என்று சொல்லுங்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"சீயோனுக்குப் போவதற்குக் கொடியேற்றுங்கள்!","poem":1},{"text":"பாதுகாப்புக்காக தாமதியாது ஓடுங்கள்!","poem":2},{"text":"ஏனென்றால் நான் வடக்கிலிருந்து பேராபத்தையும்,","poem":1},{"text":"மிகப்பெரிய அழிவையும் கொண்டுவருகிறேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஒரு சிங்கம் தன் குகையிலிருந்து வெளியே வந்திருக்கிறது.","poem":1},{"text":"நாடுகளை அழிக்கிறவன் புறப்பட்டு விட்டான்.","poem":2},{"text":"உன்னுடைய நாட்டைப் பாழாக்குவதற்காக,","poem":1},{"text":"தனது இருப்பிடத்தைவிட்டுப் புறப்பட்டு விட்டான்.","poem":2},{"text":"உன்னுடைய பட்டணங்கள்","poem":1},{"text":"குடியிருப்பவர்கள் இன்றி பாழாய்க்கிடக்கும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எனவே துக்கவுடை உடுத்துங்கள்.","poem":1},{"text":"அழுது புலம்புங்கள்.","poem":2},{"text":"ஏனெனில் யெகோவாவின் பயங்கர கோபம்","poem":1},{"text":"எங்களைவிட்டு இன்னும் திரும்பாமல் இருக்கிறதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"அந்த நாளில், “அரசனும், அதிகாரிகளும்","poem":1},{"text":"மனம் சோர்ந்துபோவார்கள்.","poem":2},{"text":"ஆசாரியர்கள் திகிலடைவார்கள்.","poem":1},{"text":"இறைவாக்கினர் அதிர்ச்சியடைவார்கள்” என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":["அப்பொழுது நான், “ஆண்டவராகிய யெகோவாவே! வாள் எங்கள் தொண்டையில் வைக்கப்பட்டிருக்கும்போது, ‘உங்களுக்குச் சமாதானம் இருக்கும்’ என்று கூறி, இந்த மக்களையும், எருசலேமையும் நீர் எவ்வளவாய் ஏமாற்றிவிட்டீர்” என்று கூறினேன்."]},{"type":"verse","number":11,"content":["அந்த வேளையில் இந்த மக்களுக்கும், எருசலேமுக்கும் சொல்லப்படுவதாவது, “பாலைவனத்திலுள்ள வறண்ட மேடுகளிலிருந்து ஒரு எரிக்கும் காற்று என் மக்களை நோக்கி வீசுகிறது. ஆனால் அது தூற்றுவதற்கோ அல்லது சுத்தப்படுத்துவதற்கோ ஏற்றதல்ல."]},{"type":"verse","number":12,"content":["அதையும்விட, மிகவும் பலமான ஒரு காற்றாக அது என்னிடமிருந்து வருகிறது. இப்பொழுது நான் அவர்களுக்கு விரோதமாக என் தீர்ப்பை அறிவிக்கிறேன்.”"]},{"type":"verse","number":13,"content":[{"text":"பார்! அவன் மேகங்களைப்போல் முன்னேறி வருகிறான்.","poem":1},{"text":"சுழல் காற்றைப்போன்ற இரதங்களுடனும்,","poem":2},{"text":"கழுகுகளைப் பார்க்கிலும் வேகமான குதிரைகளுடனும் அவன் வருகிறான்.","poem":1},{"text":"எங்களுக்கு ஐயோ கேடு! நாங்கள் அழிந்தோம்!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"எருசலேமே, உன் இருதயத்திலிருந்து தீமையைக் கழுவி இரட்சிப்பை பெற்றுக்கொள்.","poem":1},{"text":"தீமையான சிந்தனைகளை எவ்வளவு காலத்திற்குத் தேக்கி வைப்பாய்?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"தாண் பட்டணத்திலிருந்து ஒரு குரல் அறிவிக்கிறது.","poem":1},{"text":"எப்பிராயீமின் குன்றுகளிலிருந்து அழிவு வரும் என்று அது பிரசித்தப்படுத்துகிறது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“நாடுகளுக்கு அதைச் சொல்லுங்கள்.","poem":1},{"text":"எருசலேமுக்கு அதைப் பிரசித்தப்படுத்துங்கள்.","poem":2},{"text":"‘யூதாவின் பட்டணங்களுக்கு எதிராக போர் முழக்கத்தை எழுப்பிக்கொண்டு,","poem":1},{"text":"முற்றுகையிடும் இராணுவம் ஒன்று தூரமான ஒரு நாட்டிலிருந்து வருகிறது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"எருசலேம் எனக்கெதிராகக் கலகம் உண்டாக்கியபடியினால்,","poem":1},{"text":"ஒரு வயலைக் காவல்காத்து நிற்பதுபோல அந்த இராணுவவீரர்","poem":2},{"lineBreak":true},{"text":"எருசலேமைச் சூழ்ந்துகொள்கிறார்கள்,’ ” என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“உன்னுடைய நடத்தையும் செயல்களுமே","poem":1},{"text":"உன்மீது இவைகளைக் கொண்டுவந்திருக்கின்றன.","poem":2},{"text":"இதுதான் உன்னுடைய தண்டனை.","poem":1},{"text":"அது எவ்வளவு கசப்பானது!","poem":2},{"lineBreak":true},{"text":"அது இருதயத்தை எவ்வளவாய் குத்துகிறது!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ஆ, நான் வேதனைப்படுகிறேன், நான் வேதனைப்படுகிறேன்!","poem":1},{"text":"என் வலியில் துடிக்கிறேன்.","poem":2},{"text":"என் இருதயம் தாங்கமுடியாத துயரமடைகிறது,","poem":1},{"text":"என் இருதயம் எனக்குள் படபடக்கிறது,","poem":2},{"lineBreak":true},{"text":"என்னால் அமைதியாயிருக்க முடியாது.","poem":2},{"text":"ஏனெனில் நான் எக்காள சத்தத்தைக் கேட்டேன்;","poem":1},{"text":"போர் முழக்கத்தையும் கேட்டேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"பேரழிவின் மேல் பேரழிவு தொடர்கிறது;","poem":1},{"text":"நாடு முழுவதுமே அழிந்து கிடக்கிறது.","poem":2},{"text":"நொடிப்பொழுதில் என் கூடாரங்கள் அழிந்தன.","poem":1},{"text":"கணப்பொழுதில் என் புகலிடம் அழிந்தது.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"நான் எவ்வளவு காலத்திற்கு போர்க் கொடியைப் பார்த்துக்கொண்டும்,","poem":1},{"text":"போரின் எக்காள தொனியைக் கேட்டுக்கொண்டும் இருக்கவேண்டும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“என் மக்கள் மூடர்கள்,","poem":1},{"text":"அவர்கள் என்னை அறியவில்லை.","poem":2},{"text":"அவர்கள் உணர்வற்ற பிள்ளைகள்;","poem":1},{"text":"அவர்களுக்கு விளங்கிக்கொள்ளும் ஆற்றல் இல்லை.","poem":2},{"text":"அவர்கள் தீமை செய்வதில் திறமைசாலிகள்;","poem":1},{"text":"எப்படி நன்மை செய்வது என்று அவர்கள் அறியமாட்டார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"நான் உலகத்தை உற்றுப் பார்த்தேன்.","poem":1},{"text":"அது உருவமற்று வெறுமையாயிருந்தது.","poem":2},{"text":"வானங்களைப் பார்த்தேன்.","poem":1},{"text":"அவைகளின் வெளிச்சம் போய்விட்டது.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"மலைகளை உற்றுப் பார்த்தேன்.","poem":1},{"text":"அவை நடுங்கிக் கொண்டிருந்தன;","poem":2},{"lineBreak":true},{"text":"எல்லாக் குன்றுகளும் அசைந்துகொண்டிருந்தன.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நான் உற்றுப் பார்த்தேன். அங்கு மக்கள் இருக்கவில்லை.","poem":1},{"text":"ஆகாயத்துப் பறவைகளெல்லாம் பறந்துவிட்டன.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நான் உற்றுப் பார்த்தேன். செழிப்பான நாடு பாலைவனமாகிக் கிடந்தது.","poem":1},{"text":"யெகோவாவுக்கு முன்பாக அவருடைய கடுங்கோபத்தினால்","poem":2},{"lineBreak":true},{"text":"அதன் பட்டணங்கள் யாவும் பாழாகிக்கிடந்தன.","poem":2}]},{"type":"verse","number":27,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“நாடு முழுவதும் பாழாய்ப்போகும்.","poem":1},{"text":"ஆயினும் நான் அதை முற்றிலும் அழிக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ஆகையால் பூமி துக்கங்கொள்ளும்.","poem":1},{"text":"மேலேயுள்ள வானங்கள் இருளடையும்.","poem":2},{"text":"ஏனெனில் நான் சொல்லிவிட்டேன், நான் மனம் மாறமாட்டேன்;","poem":1},{"text":"நான் தீர்மானித்து விட்டேன், அதைச் செய்யாமல் விடவுமாட்டேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"குதிரைவீரருடைய, வில் வீரருடைய சத்தம் கேட்டு","poem":1},{"text":"ஒவ்வொரு பட்டணத்திலுள்ளவர்களும் தப்பி ஓடுகிறார்கள்.","poem":2},{"text":"சிலர் காடுகளுக்குள் ஓடுகிறார்கள்;","poem":1},{"text":"சிலர் பாறைகளுக்கிடையே ஏறுகிறார்கள்.","poem":2},{"text":"எல்லாப் பட்டணங்களும் கைவிடப்பட்ட நிலையிலுள்ளன;","poem":1},{"text":"ஒருவரும் அங்கு வசிக்கவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"பாழாய்ப் போனவளே! நீ என்ன செய்கிறாய்?","poem":1},{"text":"இரத்தாம்பர உடையை அணிந்து","poem":2},{"lineBreak":true},{"text":"தங்க ஆபரணங்களால் உன்னை அலங்கரிப்பது ஏன்?","poem":2},{"text":"நீ உன் கண்களுக்கு மையிடுவது ஏன்?","poem":1},{"text":"நீ வீணாகவே அலங்கரிக்கிறாய்;","poem":2},{"text":"உன் காதலர் உன்னை வெறுத்து","poem":1},{"text":"உன் உயிரை வாங்கத் தேடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"பிரசவ வேதனைப்படும் ஒரு பெண்ணின் அழுகுரலைப் போலவும்,","poem":1},{"text":"தன் முதற்பிள்ளையைப் பெற்றெடுக்கும் ஒரு பெண்ணின் வேதனைக் குரலைப் போலவும்","poem":2},{"text":"ஒரு அழுகுரலைக் கேட்கிறேன்.","poem":1},{"text":"இளைத்து மூச்சு வாங்குகிற சீயோன் மகளின் அழுகுரலே அது.","poem":2},{"text":"அவள் தன் கைகளை நீட்டி, “ஐயோ நான் மயக்கமடைகிறேன்;","poem":1},{"text":"என் உயிர் கொலைகாரரிடம் கொடுக்கப்பட்டு விட்டது” என்கிறாள்.","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"விருத்தசேதனம் என்றால் அர்ப்பணித்தல் எனப்படும்.","reference":{"chapter":4,"verse":4}}]},"thisChapterLink":"/api/tam_tcv/JER/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/3.json","previousChapterAudioLinks":{},"numberOfVerses":31}