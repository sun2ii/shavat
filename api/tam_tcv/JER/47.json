{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":47,"content":[{"type":"heading","content":["பெலிஸ்தியரைப் பற்றிய செய்தி"]},{"type":"verse","number":1,"content":["பார்வோன், காசாவைத் தாக்குவதற்கு முன் பெலிஸ்தியரைக் குறித்து, இறைவாக்கினன் எரேமியாவுக்கு வந்த யெகோவாவின் வார்த்தை இதுவே:"]},{"type":"line_break"},{"type":"verse","number":2,"content":["யெகோவா கூறுவது இதுவே:",{"text":"“பாருங்கள், வடக்கிலே வெள்ளம் எவ்வளவாய் பொங்கி எழுகிறது.","poem":1},{"text":"அது கரைபுரண்டோடும் வெள்ளமாகும்.","poem":2},{"text":"அது நாட்டின்மேலும், அதிலுள்ள எல்லாவற்றின்மேலும் புரண்டோடும்.","poem":1},{"text":"பட்டணங்கள்மேலும், அதில் வாழும் யாவர்மேலும் புரண்டோடும்.","poem":2},{"text":"மக்கள் அலறி அழுவார்கள்.","poem":1},{"text":"நாட்டில் குடியிருப்போர் எல்லோரும் புலம்புவார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பாய்ந்தோடும் குதிரைகளின் குளம்புகளின் ஒலியையும்,","poem":1},{"text":"பகைவர்களின் தேர்களின் சத்தத்தையும்,","poem":2},{"lineBreak":true},{"text":"தேர்ச்சக்கரங்களின் இரைச்சலையும் கேட்டு ஓலமிடுவார்கள்.","poem":2},{"text":"தந்தையர் தங்கள் பிள்ளைகளுக்கு உதவிசெய்யும்படி திரும்பமாட்டார்கள்.","poem":1},{"text":"அவர்களுடைய கைகள் சோர்ந்துபோகும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஏனெனில் பெலிஸ்தியர் அனைவரையும்","poem":1},{"text":"அழிக்கும் நாள் வந்திருக்கிறது.","poem":2},{"text":"தீருவுக்கும் சீதோனுக்கும் உதவிசெய்யக்கூடிய,","poem":1},{"text":"இன்னும் தப்பியிருப்பவர்களை அழிப்பதற்கான நாள் வந்திருக்கிறது.","poem":2},{"text":"கப்தோரின் கரையோரத்தில் மீதியாயிருக்கும்","poem":1},{"text":"பெலிஸ்தியரை யெகோவா அழிக்கப்போகிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"காசா துக்கங்கொண்டாடுதலுக்காக தன் தலையை மொட்டையடிக்கும்.","poem":1},{"text":"அஸ்கலோன் மவுனமாய் இருக்கும்.","poem":2},{"text":"சமவெளியில் மீதியாயிருப்பவர்களே,","poem":1},{"text":"எவ்வளவு காலத்திற்கு உங்களை நீங்களே வெட்டிக்கொள்வீர்கள்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ ‘ஐயோ! யெகோவாவின் வாளே!","poem":1},{"text":"நீ ஓய்வதற்கு எவ்வளவு காலம் செல்லும்?","poem":2},{"text":"உறைக்குத் திரும்பி அங்கு ஓய்ந்திரு","poem":1},{"text":"என்று நீங்கள் கதறுகிறீர்களே!’","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனால் அஸ்கலோனையும்,","poem":1},{"text":"கரையோரப் பகுதிகளையும் தாக்கும்படி,","poem":2},{"text":"யெகோவா கட்டளையிட்டு உத்தரவு கொடுத்திருக்க","poem":1},{"text":"அது எப்படி ஓய்ந்திருக்கும்?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JER/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/46.json","previousChapterAudioLinks":{},"numberOfVerses":7}