{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":48,"content":[{"type":"heading","content":["மோவாபைப் பற்றிய செய்தி"]},{"type":"verse","number":1,"content":["மோவாபைப் பற்றியது:",{"lineBreak":true},"இஸ்ரயேலின் இறைவனாகிய சேனைகளின் யெகோவா கூறுவது இதுவே:",{"text":"“நேபோ நாட்டுக்கு ஐயோ கேடு! அது பாழாக்கப்படும்.","poem":1},{"text":"கீரியாத்தாயீம் அவமானத்திற்கு உள்ளாக்கப்பட்டு கைப்பற்றப்படும்.","poem":2},{"lineBreak":true},{"text":"அதன் பலத்த அரண் அவமதிக்கப்பட்டு தகர்க்கப்படும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மோவாப் இனி ஒருபோதும் புகழப்படமாட்டாது;","poem":1},{"text":"அதனுடைய அழிவுக்காக, எஸ்போனில் உள்ள மனிதர் சதித்திட்டம் போடுவார்கள்:","poem":2},{"lineBreak":true},{"text":"‘வாருங்கள் நாம் அந்த நாட்டிற்கு ஒரு முடிவை உண்டாக்குவோம்.’","poem":2},{"text":"மத்மேனே பட்டணமே, நீயும் அழிக்கப்படுவாய்;","poem":1},{"text":"வாள் உன்னைப் பின்தொடரும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஒரொனாயீமிலிருந்து உண்டாகும் கதறுதலைக் கேளுங்கள்.","poem":1},{"text":"அது அழிவினாலும், பேரழிவினாலும் உண்டாகும் கதறுதல்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மோவாப் நொறுக்கப்படும்.","poem":1},{"text":"அதிலுள்ள சிறுவர்கள் கூப்பிடும் சத்தம் கேட்கப்படுகிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"லூகித்துக்கு ஏறிப்போகும் வழியில்","poem":1},{"text":"மனங்கசந்து அழுதுகொண்டே போகிறார்கள்.","poem":2},{"text":"ஒரொனாயீமுக்கு இறங்கிப் போகும் வீதியில்","poem":1},{"text":"அழிவின் நிமித்தம் அழுகுரல் கேட்கப்படுகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"தப்பி ஓடுங்கள்; உங்கள் உயிர் தப்ப ஓடுங்கள்.","poem":1},{"text":"வனாந்திரத்திலுள்ள புதரைப்போலாகுங்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"மோவாபே நீ உன் சொந்தத் திறமையிலும்,","poem":1},{"text":"செல்வத்திலும் நம்பிக்கை வைத்திருப்பதினால், நீயும் சிறைப்பிடிக்கப்படுவாய்.","poem":2},{"text":"உன் தெய்வமான கேமோஷ் அதன் பூசாரிகளுடனும்,","poem":1},{"text":"அலுவலர்களுடனும் நாடுகடத்தப்படும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஒவ்வொரு பட்டணத்திற்கும் அழிக்கிறவன் வருவான்.","poem":1},{"text":"ஒரு பட்டணமும் தப்பிப்போகாது.","poem":2},{"text":"பள்ளத்தாக்குப் பாழாக்கப்படும்,","poem":1},{"text":"சமனான பூமியும் அழிக்கப்படும்.","poem":2},{"lineBreak":true},{"text":"ஏனெனில் யெகோவா இதைச் சொல்லியிருக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மோவாபின்மேல் உப்பை தூவுங்கள்.","poem":1},{"text":"அவள் முழுவதுமாக அழிக்கப்படுவாள்.","poem":2},{"text":"அதன் பட்டணங்கள் பாழாக்கப்படும்.","poem":1},{"text":"குடியிருப்பதற்கு யாருமின்றி வெறுமையாய் கைவிடப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“யெகோவாவின் வேலையை மனமில்லாமல் செய்கிறவன்மேல் சாபம் உண்டாகட்டும்.","poem":1},{"text":"இரத்தம் சிந்தாமல் தனது வாளை வைத்திருக்கிறவன்மேல் சாபம் உண்டாகட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“மோவாப் தன் வாலிப காலத்திலிருந்து ஆறுதலாய் இருக்கிறாள்.","poem":1},{"text":"ஒரு பாத்திரத்திலிருந்து மற்றொரு பாத்திரத்திற்கு ஊற்றப்படாமல்,","poem":2},{"text":"மண்டி கலக்காமல் இருக்கும் திராட்சரசத்தைப்போல் இருக்கிறாள்.","poem":1},{"text":"அவள் நாடுகடத்தப்பட்டுப் போகவில்லை.","poem":2},{"text":"ஆகையால் அவளது சுவை அப்படியே இருந்தது.","poem":1},{"text":"அவளுடைய வாசனையும் மாறுபடவில்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆனால், நாட்கள் வருகின்றன” என்று யெகோவா அறிவிக்கிறார்.","poem":1},{"lineBreak":true},{"text":"“அப்பொழுது ஜாடிகளிலிருந்து ஊற்றும் மனிதர்களை அனுப்புவேன்.","poem":1},{"text":"அவர்கள் அவளை வெளியே ஊற்றுவார்கள்.","poem":2},{"text":"அவளது ஜாடிகள் வெறுமையாக்கப்படும்.","poem":1},{"text":"அவளுடைய பாத்திரங்களும் உடைத்துப் போடப்படும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அப்பொழுது இஸ்ரயேல் பெத்தேலில் நம்பிக்கை வைத்து,","poem":1},{"text":"வெட்கப்பட்டதுபோல,","poem":2},{"lineBreak":true},{"text":"மோவாப் நாடும் கேமோஷ் தெய்வத்தைக் குறித்து வெட்கமடையும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“ ‘நாங்கள் போர்வீரர்; போரில் வலிமைமிக்க வீரர்கள்’","poem":1},{"text":"என்று நீங்கள் எப்படி கூறலாம்?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"மோவாப் அழிக்கப்பட்டு, அவளுடைய பட்டணங்கள் தாக்கப்படும்.","poem":1},{"text":"அங்குள்ள திறமைமிக்க வாலிபர் கொலைசெய்யப்படுவார்கள்” என்று,","poem":2},{"lineBreak":true},{"text":"சேனைகளின் யெகோவா என்னும் பெயருடைய அரசர் அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“மோவாபின் வீழ்ச்சி மிக அருகிலுள்ளது.","poem":1},{"text":"அவளுடைய அழிவு விரைவாய் வரும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவளைச்சுற்றி வசிப்பவர்களும்,","poem":1},{"text":"அவளின் புகழை அறிந்தவர்களுமான நீங்கள் அவளுக்காக அழுது புலம்புங்கள்.","poem":2},{"text":"‘வலிமைமிக்க செங்கோல் எப்படி முறிந்தது,","poem":1},{"text":"மகிமையான கோலும் எப்படி முறிந்தது’ என்று சொல்லி அழுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“தீபோன் மகளின் குடிகளே!","poem":1},{"text":"நீங்கள் உங்கள் மேன்மையிலிருந்து கீழிறங்கி","poem":2},{"lineBreak":true},{"text":"வறண்ட நிலத்தில் உட்காருங்கள்.","poem":2},{"text":"ஏனெனில் மோவாபை அழிப்பவன்","poem":1},{"text":"உங்களுக்கெதிராய் வந்து உங்கள் அரணுள்ள","poem":2},{"lineBreak":true},{"text":"பட்டணங்களை அழித்துப் போடுவான்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அரோயேரில் குடியிருப்பவர்களே!","poem":1},{"text":"தெருவோரமாய் நின்று கவனித்துப் பாருங்கள்;","poem":2},{"text":"ஓடுகிற மனிதனிடமும்,","poem":1},{"text":"தப்பி ஓடுகிற பெண்ணிடமும், ‘நடந்தது என்ன?’ என்று கேளுங்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"மோவாப் தகர்க்கப்பட்டபடியால்,","poem":1},{"text":"அது அவமதிக்கப்பட்டிருக்கிறது.","poem":2},{"text":"ஓலமிட்டு அழுங்கள்.","poem":1},{"text":"மோவாப் அழிக்கப்பட்டதென்று அர்னோனில் அறிவியுங்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"சமனான பூமிக்கு நியாயத்தீர்ப்பு வந்திருக்கிறது.","poem":1},{"text":"ஓலோன், யாத்சா, மேபாகாத் பட்டணங்களுக்கும்,","poem":2}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"தீபோன், நேபோ, பெத்திப்லாத்தாயீம் பட்டணங்களுக்கும்,","poem":2}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"கீரியாத்தாயீம், பெத்காமூல், பெத்மெயோன் பட்டணங்களுக்கும்,","poem":2}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"கீரியோத், போஸ்றா, மற்றும் தூரத்திலும் சமீபத்திலும் உள்ள","poem":2},{"lineBreak":true},{"text":"மோவாபின் பட்டணங்கள் எல்லாவற்றுக்கும் நியாயத்தீர்ப்பு வந்துள்ளது.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"மோவாபின் பலம் எடுக்கப்பட்டது.","poem":1},{"text":"அவளுடைய புயம் முறிக்கப்பட்டது”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“மோவாப் யெகோவாவை எதிர்த்தெழும்பினாள்.","poem":1},{"text":"ஆகையால் அவளை வெறிக்கப் பண்ணுங்கள்.","poem":2},{"text":"அவள் தன் வாந்தியிலேயே புரண்டு,","poem":1},{"text":"மற்றவர்களுக்கு அவள் ஒரு கேலிப்பொருளுமாகட்டும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"மோவாபே! இஸ்ரயேல் உனது கேலிப்பொருளாக இருக்கவில்லையோ?","poem":1},{"text":"நீ அவளைப் பற்றிப் பேசும்போதெல்லாம்","poem":2},{"text":"இகழ்ச்சியுடன் உன் தலையை அசைக்கிறாயே;","poem":1},{"text":"அவள் என்ன கள்ளர்களோடுகூட பிடிக்கப்பட்டவளோ!","poem":2}]},{"type":"verse","number":28,"content":[{"text":"மோவாபின் குடிகளே!","poem":1},{"text":"நீங்கள் பட்டணங்களைவிட்டு மலைகளிலுள்ள","poem":2},{"text":"பாறைகளின் மத்தியில் போய் குடியிருங்கள்.","poem":1},{"text":"குகை வாசலில் கூடுகட்டும் புறாவைப் போலிருங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“மோவாபுடைய பெருமையைப் பற்றி நாங்கள் கேள்விப்பட்டோம்.","poem":1},{"text":"அவளுடைய ஆணவத்தையும்,","poem":2},{"text":"இறுமாப்பையும், பெருமையையும், அகங்காரத்தையும்,","poem":1},{"text":"இருதய அகந்தையையும் கேள்விப்பட்டிருக்கிறோம்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவளுடைய திமிரை நான் அறிவேன். இது பயனற்றது” என்று யெகோவா அறிவிக்கிறார்.","poem":1},{"text":"“அவள் அவளுடைய தற்புகழ் பேச்சினால் எதையுமே சாதிக்கப்போவதில்லை.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ஆகவே நான் மோவாபைக் குறித்துப் புலம்புவேன்.","poem":1},{"text":"மோவாப் நாடு முழுவதற்காகவும் நான் கதறுவேன்.","poem":2},{"lineBreak":true},{"text":"கிர் ஹெரெஸ் மனிதருக்காகவும் ஏங்கி அழுவேன்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"சிப்மா நாட்டிலுள்ள திராட்சைக் கொடிகளே!","poem":1},{"text":"யாசேர் அழுவதைப்போல்","poem":2},{"text":"நான் உங்களுக்காக அழுவேன்.","poem":1},{"text":"உங்கள் கிளைகள் கடல்வரை பரவி யாசேர் வரையும் எட்டியுள்ளன.","poem":2},{"text":"உன்னுடைய பழுத்த பழங்கள் மீதும்,","poem":1},{"text":"திராட்சைப்பழ அறுப்பின் மீதும் அழிக்கிறவன் வந்துவிட்டான்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"மோவாப் நாட்டின் வயல்களிலிருந்தும்,","poem":1},{"text":"பழத்தோட்டங்களிலிருந்தும்,","poem":2},{"text":"மகிழ்ச்சியும் களிப்பும் நீங்கிப்போயின.","poem":1},{"text":"ஆலைகளிலிருந்து திராட்சரசம் வழிந்தோடுவதையும், நான் நிறுத்திவிட்டேன்.","poem":2},{"text":"மகிழ்ச்சியின் ஆரவாரத்தோடு அவைகளை மிதிப்பார் யாருமில்லை.","poem":1},{"text":"சத்தங்கள் அங்கு இருந்தாலும், அவை மகிழ்ச்சியின் சத்தங்கள் அல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“அவர்களுடைய அழுகையின் சத்தம் எஸ்போனிலிருந்து எலெயாலே வரைக்கும்,","poem":1},{"text":"யாகாஸ் வரைக்கும் கேட்கிறது. அச்சத்தம் சோவாரிலிருந்து ஒரொனாயீம் வரைக்கும்,","poem":2},{"text":"எக்லத் ஷெலிஷியாவரைக்கும் மேலெழும்புகிறது.","poem":1},{"text":"ஏனெனில் நிம்ரீம் நீரோடைகளும் வற்றிப்போயின.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"மோவாபில் உயர்ந்த இடங்களில் பலிகளைச் செலுத்தி,","poem":1},{"text":"தங்கள் தெய்வங்களுக்குத் தூபங்காட்டுகிறவர்களுக்கு","poem":2},{"lineBreak":true},{"text":"ஒரு முடிவை உண்டாக்குவேன்” என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"“ஆகவே என் இருதயம் மோவாபிற்காக புல்லாங்குழலைப்போல் புலம்புகிறது.","poem":1},{"text":"கிர் ஹெரெஸ் மனிதருக்காக அது ஒரு புல்லாங்குழலைப்போல் புலம்புகிறது.","poem":2},{"lineBreak":true},{"text":"ஏனெனில் அவர்கள் சேமித்த செல்வம் போய்விட்டது.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"தலைகளெல்லாம் மொட்டையடிக்கப்பட்டிருக்கின்றன.","poem":1},{"text":"தாடிகளெல்லாம் வெட்டப்பட்டிருக்கின்றன.","poem":2},{"text":"கைகளெல்லாம் குத்திக் கீறப்பட்டிருக்கின்றன.","poem":1},{"text":"இடுப்புகளெல்லாம் துக்கவுடையால் மூடப்பட்டிருக்கின்றன.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"மோவாபிலுள்ள எல்லா வீட்டுக் கூரைகளின்மேலும்,","poem":1},{"text":"பொதுச் சதுக்கங்களிலும்","poem":2},{"text":"துக்கங்கொண்டாடுதலே அல்லாமல் வேறொன்றுமில்லை.","poem":1},{"text":"ஏனெனில் நான் மோவாபை ஒருவரும் விரும்பாத ஜாடியைப்போல்","poem":2},{"lineBreak":true},{"text":"உடைத்துப் போட்டேன்” என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"“மோவாப் எவ்வளவாய் சிதறடிக்கப்பட்டிருக்கிறாள்!","poem":1},{"text":"மக்கள் எவ்வளவாய் புலம்புகிறார்கள்!","poem":2},{"text":"மோவாப் எவ்வளவாய் வெட்கத்தினால் தலைகுனிந்து நிற்கிறாள்!","poem":1},{"text":"மோவாப் ஒரு கேலிப்பொருளானாள்;","poem":2},{"lineBreak":true},{"text":"அவள் தன்னைச் சுற்றியுள்ள யாவருக்கும் திகிலூட்டும் பொருளானாள்.”","poem":2}]},{"type":"verse","number":40,"content":["யெகோவா கூறுவது இதுவே:",{"text":"“இதோ, நோக்கிப்பாருங்கள். ஒரு கழுகு,","poem":1},{"text":"தன் சிறகுகளை மோவாபின் மேலாக விரித்து அதைத் தாக்கும்படி கீழே வருகிறது.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"கீரியோத் கைப்பற்றப்பட்டு","poem":1},{"text":"அதன் பலத்த அரண்களும் பிடிக்கப்படும்.","poem":2},{"text":"அந்நாளில் மோவாபின் போர் வீரர்களின் இருதயங்கள்","poem":1},{"text":"பிரசவிக்கிற ஒரு பெண்ணின் இருதயத்தைப் போலிருக்கும்.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"மோவாப் யெகோவாவை எதிர்த்தபடியினால்,","poem":1},{"text":"அவள் ஒரு நாடாக இராதபடி அழிக்கப்படுவாள்.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"மோவாபின் மக்களே!","poem":1},{"text":"பயங்கரமும், படுகுழியும், கண்ணியும் உங்களுக்காகக் காத்திருக்கின்றன”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"“பயங்கரத்துக்குத் தப்பி ஓடுகிறவன்,","poem":1},{"text":"படுகுழிக்குள் விழுவான்.","poem":2},{"text":"குழியிலிருந்து வெளியே ஏறிவருகிறவன்,","poem":1},{"text":"கண்ணியில் அகப்படுவான்.","poem":2},{"text":"ஏனெனில் மோவாபுக்குரிய தண்டனையின் வருடத்தை நான்","poem":1},{"text":"அதன்மீது கொண்டுவருவேன்” என்று","poem":2},{"lineBreak":true},{"text":"யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“தப்பியோடுகிறவர்கள் எஸ்போனின் நிழலில்","poem":1},{"text":"செய்வதறியாது தவிக்கிறார்கள்.","poem":2},{"text":"ஏனெனில் எஸ்போனிலிருந்து நெருப்பும்,","poem":1},{"text":"சீகோனின் நடுவிலிருந்து ஒரு ஜுவாலையும் புறப்பட்டிருக்கிறது.","poem":2},{"text":"அது மோவாபின் நெற்றிகளையும்","poem":1},{"text":"பெருமையாய் பேசுகிறவர்களின் மண்டையோடுகளையும் எரிக்கிறது.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"மோவாபே, உனக்கு ஐயோ கேடு!","poem":1},{"text":"கேமோஷ்","poem":2},{"noteId":25},{"text":"தெய்வத்தின் மக்கள் அழிக்கப்பட்டிருக்கிறார்கள்;","poem":2},{"text":"உன் மகன்கள் நாடுகடத்தப்பட்டிருக்கிறார்கள்,","poem":1},{"text":"உன் மகள்கள் சிறைப்பிடிக்கப்பட்டிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"“இருந்தும் பின்வரும் நாட்களில்","poem":1},{"text":"நான் மோவாபின் செல்வங்களைத் திரும்பவும் கொடுப்பேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},"மோவாபின் நியாயத்தீர்ப்பு இத்துடன் முடிகிறது."]},{"type":"line_break"}],"footnotes":[{"noteId":25,"caller":"+","text":"கேமோஷ் என்றால் மோவாபியர் வணங்கும் தெய்வம்","reference":{"chapter":48,"verse":46}}]},"thisChapterLink":"/api/tam_tcv/JER/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/47.json","previousChapterAudioLinks":{},"numberOfVerses":47}