{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":49,"content":[{"type":"heading","content":["அம்மோனைப் பற்றிய செய்தி"]},{"type":"verse","number":1,"content":["அம்மோனியரைப் பற்றியது:",{"lineBreak":true},"யெகோவா கூறுவது இதுவே:",{"text":"“இஸ்ரயேலுக்கு மகன்கள் இல்லையோ?","poem":1},{"text":"அவளுக்கு வாரிசுகள் இல்லையோ?","poem":2},{"text":"அப்படியானால், மோளேக்","poem":1},{"noteId":26},{"text":"தெய்வம் காத் நாட்டை உரிமையாக்கிக் கொண்டது ஏன்?","poem":1},{"text":"அதனை வணங்குகிறவர்கள் ஏன் அதன் பட்டணங்களில் வாழ்கின்றனர்?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஆயினும், நாட்கள் வருகின்றன” என்று யெகோவா அறிவிக்கிறார்.","poem":1},{"lineBreak":true},{"text":"“அம்மோனியரின் ரப்பா பட்டணத்துக்கெதிராக","poem":1},{"text":"நான் போரின் முழக்கத்தை எழுப்புவேன்.","poem":2},{"text":"அந்த இடம் இடிபாடுகளின் குவியலாகும்.","poem":1},{"text":"அதைச் சுற்றியுள்ள கிராமங்களும் நெருப்பினால் எரிக்கப்படும்.","poem":2},{"text":"அப்பொழுது தங்களை வெளியே துரத்திவிட்டவர்களை,","poem":1},{"text":"இஸ்ரயேலர் வெளியே துரத்திவிடுவார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“எஸ்போனே! புலம்பி அழு! ஏனெனில், ஆயி பட்டணம் அழிக்கப்பட்டது.","poem":1},{"text":"ரப்பாவின் குடிகளே! கதறியழுங்கள்.","poem":2},{"text":"துக்கவுடை உடுத்தித் துக்கங்கொண்டாடுங்கள்.","poem":1},{"text":"வேலிகளுக்குள்ளே இங்கும் அங்கும் விரைந்தோடுங்கள்.","poem":2},{"text":"ஏனெனில், மோளேகு தெய்வம் தனது பூசாரிகளுடனும்","poem":1},{"text":"அலுவலர்களுடனும் நாடுகடத்தப்படும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உண்மையற்ற மகளே!","poem":1},{"text":"உன் பள்ளத்தாக்குகளைப் பற்றி ஏன் பெருமையாய்ப் பேசுகிறாய்?","poem":2},{"text":"உன் வளம் நிறைந்த பள்ளத்தாக்குகளைப் பற்றி ஏன் பெருமை பேசுகிறாய்?","poem":1},{"text":"நீ உன் செல்வங்களில் நம்பிக்கை வைத்து,","poem":2},{"lineBreak":true},{"text":"‘என்னைத் தாக்குபவன் யார்’ என்கிறாயே!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உன்னைச் சுற்றியுள்ள எல்லோரிடமிருந்தும்,","poem":1},{"text":"உனக்குப் பயங்கரத்தைக் கொண்டுவருவேன்”","poem":2},{"lineBreak":true},{"text":"என்று சேனைகளின் யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“உங்களில் ஒவ்வொருவரும் வெளியே துரத்தப்படுவீர்கள்.","poem":1},{"text":"தப்பியோடுகிறவர்களை ஒன்றுசேர்ப்பார் ஒருவருமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“இருந்தும் பிற்பாடு அம்மோனியரின் செல்வங்களை நான் திரும்பவும் கொடுப்பேன்”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"heading","content":["ஏதோமைப் பற்றிய செய்தி"]},{"type":"verse","number":7,"content":["ஏதோமைப் பற்றியது:",{"lineBreak":true},"சேனைகளின் யெகோவா கூறுவது இதுவே:",{"text":"“தேமானிலே ஞானம் இல்லையோ?","poem":1},{"text":"விவேகமுள்ளவர்களிடமிருந்து ஆலோசனை இல்லாமல் போயிற்றோ?","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய ஞானம் சிதைந்து போயிற்றோ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"தேதானில் குடியிருப்பவர்களே!","poem":1},{"text":"திரும்பி தப்பியோடுங்கள்.","poem":2},{"text":"பள்ளங்களின் நடுவிலே ஒளிந்துகொள்ளுங்கள்.","poem":1},{"text":"ஏனெனில் ஏசாவை நான் தண்டிக்கும் காலத்தில் அவன்மேல் பேராபத்தைக் கொண்டுவருவேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"திராட்சைப் பழங்களை பறிக்கிறவர்கள் உன்னிடத்தில் வந்தால்,","poem":1},{"text":"சில பழங்களை விட்டுச்செல்லமாட்டார்களோ?","poem":2},{"text":"இரவுவேளையில் திருடர்கள் வந்தால்,","poem":1},{"text":"தங்கள் மனம் விரும்பிய அளவு மட்டும் கொள்ளையடிப்பார்கள் அல்லவா?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆனால் நானோ ஏசாவை வெறுமையாக்குவேன்.","poem":1},{"text":"அவன் தன்னை மறைத்துக் கொள்ளமுடியாத அளவுக்கு","poem":2},{"lineBreak":true},{"text":"அவனுடைய மறைவிடங்களை வெளிப்படுத்துவேன்.","poem":2},{"text":"அவனுடைய பிள்ளைகளும், உறவினர்களும்,","poem":1},{"text":"அயலவர்களும் அழிந்துபோவார்கள்.","poem":2},{"lineBreak":true},{"text":"அவனும் இல்லாமற்போவான்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"‘நீ உன் அநாதைகளை விட்டுவிடு; நான் அவர்களைப் பாதுகாப்பேன்.","poem":1},{"text":"உன்னுடைய விதவைகளும் என்னில் நம்பிக்கையாய் இருக்கலாம்.’ ”","poem":2}]},{"type":"verse","number":12,"content":["யெகோவா கூறுவது இதுவே: “தண்டனையின் பாத்திரத்தில் குடிக்க வேண்டியதல்லாதவர்களும், அதில் கட்டாயமாய் குடிக்க வேண்டியிருக்கும்போது, நீ மட்டும் தண்டனையின்றி தப்பலாமோ? நீ தண்டிக்கப்படாமல் விடப்படமாட்டாய்; நீ கண்டிப்பாக குடிக்கவேண்டும்."]},{"type":"verse","number":13,"content":["போஸ்றா பாழாக்கப்பட்டு, பயங்கரத்திற்கும், நிந்தைக்கும், சாபத்திற்கும் உள்ளாகும். அதன் பட்டணங்கள் யாவும் என்றும் பாழாகவே கிடக்கும் என்று நான் என்னைக்கொண்டு ஆணையிடுகிறேன்” என்று யெகோவா அறிவிக்கிறார்."]},{"type":"verse","number":14,"content":[{"text":"நான் யெகோவாவிடமிருந்து ஒரு செய்தியைக் கேள்விப்பட்டேன்.","poem":1},{"text":"ஜனங்களிடம் ஒரு தூதுவன், “அதைத் தாக்குவதற்கு நீங்கள் ஒன்றுகூடுங்கள்!","poem":2},{"text":"யுத்தம் செய்ய எழும்புங்கள்!”","poem":1},{"text":"என்று சொல்லுவதற்காக அனுப்பப்பட்டான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"இப்பொழுது நான் உன்னை நாடுகளுக்குள்ளே சிறியதும்,","poem":1},{"text":"மனிதரால் அவமதிக்கப்பட்டதுமாக்குவேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"கற்பாறை பிளவுகளில் வாழ்ந்து,","poem":1},{"text":"மேடுகளின் உயரங்களில் இடம்பிடித்துக்கொண்டிருக்கிற உன்னை,","poem":2},{"text":"நீ விளைவிக்கும் பயங்கரமும்,","poem":1},{"text":"உன் இருதயத்தின் அகந்தையும் உன்னை மோசம்போக்கியது.","poem":2},{"text":"நீ கழுகின் கூட்டைப்போல் உன் கூட்டை மிக உயரத்தில் கட்டினாலும்,","poem":1},{"text":"அங்கிருந்தும் நான் உன்னை கீழே விழத்தள்ளுவேன்","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஏதோம் ஒரு பாழான பொருளாகும்.","poem":1},{"text":"அதைக் கடந்துபோகிற யாவரும் பிரமித்து,","poem":2},{"lineBreak":true},{"text":"அதற்கு ஏற்பட்ட எல்லா காயங்களைக் கண்டு ஏளனம் செய்வார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"சோதோமும், கொமோராவும் அவைகளுக்கு அடுத்திருந்த","poem":1},{"text":"பட்டணங்களுடன் கவிழ்க்கப்பட்டதுபோல,","poem":2},{"text":"அங்கு ஒருவனும் வாழ்வதுமில்லை.","poem":1},{"text":"ஒரு மனிதனும் குடியிருப்பதுமில்லை என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யோர்தானின் புதர்களுக்குள்ளிருந்து ஒரு சிங்கம் செழிப்பான","poem":1},{"text":"மேய்ச்சலிடத்திற்கு ஏறிவருவதுபோல நான் வந்து,","poem":2},{"text":"ஏதோமை அதன் நாட்டிலிருந்து ஒரு நொடிப்பொழுதில் துரத்துவேன்.","poem":1},{"text":"அதற்கென நான் நியமிப்பதற்கு என்னால் தெரிந்துகொள்ளப்பட்டவன் யார்?","poem":2},{"text":"என்னைப் போன்றவன் யார்? என்னை எதிர்க்கக் கூடியவன் யார்?","poem":1},{"text":"எந்த மேய்ப்பன் எனக்கெதிராக நிற்பான்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஆகையால், யெகோவா ஏதோமுக்கு விரோதமாக வகுத்த திட்டங்களையும்,","poem":1},{"text":"தேமானில் வாழ்கிறவர்களுக்கு விரோதமான அவரது நோக்கங்களையும் கேளுங்கள்.","poem":2},{"text":"மந்தையில் இளமையானவை இழுத்துச் செல்லப்படும்.","poem":1},{"text":"அவைகளின் நிமித்தம் அவைகளின் மேய்ச்சல் நிலத்தை முற்றுமாய் அழித்துப் போடுவான்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவைகளின் விழுகையின் சத்தத்தால் பூமி நடுங்கும்.","poem":1},{"text":"அவைகளின் அழுகுரல் செங்கடல்வரை எதிரொலிக்கும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"இதோ! ஒருவன் கழுகைப்போல உயரப் பறந்து,","poem":1},{"text":"போஸ்றாவின் மேலாக தனது சிறகுகளை விரித்து, அதை தாக்கும்படி கீழே வருகிறான்.","poem":2},{"text":"அந்த நாளில் ஏதோமின் போர்வீரருடைய இருதயங்கள்","poem":1},{"text":"பிரசவிக்கிற ஒரு பெண்ணின் இருதயத்தைப்போல் இருக்கும்.","poem":2}]},{"type":"heading","content":["தமஸ்குவைப் பற்றிய செய்தி"]},{"type":"verse","number":23,"content":["தமஸ்குவைப் பற்றியது:",{"text":"“ஆமாத்தும், அர்பாத்தும், கெட்ட செய்தியைக்","poem":1},{"text":"கேட்டதினால் மனமுடைந்து போயின. அவர்கள்","poem":2},{"text":"மனந்தளர்ந்து,","poem":1},{"text":"அமைதியற்ற கடலைப்போல் குழப்பமடைந்து இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"தமஸ்கு தளர்ந்துவிட்டது.","poem":1},{"text":"அது தப்பி ஓடுவதற்குத் திரும்பி விட்டது.","poem":2},{"lineBreak":true},{"text":"திகில் அதைப்பற்றிப் பிடித்துக்கொண்டது.","poem":2},{"text":"பிரசவிக்கும் பெண்ணின் வேதனையைப்போன்ற வேதனையும்,","poem":1},{"text":"துக்கமும் அதை ஆட்கொண்டன.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"புகழ்ப்பெற்ற பட்டணம் கைவிடப்படாமல் இருப்பதேன்?","poem":1},{"text":"நான் மகிழ்ச்சிகொள்ளும் நகரம் ஏன் கைவிடப்படாமல் இருக்கிறது.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நிச்சயமாக அதன் வாலிபர்கள் தெருக்களில் விழுவார்கள்.","poem":1},{"text":"அந்நாளில் எல்லாப் போர்வீரர்களும் அழிக்கப்படுவார்கள்","poem":2},{"lineBreak":true},{"text":"என்று சேனைகளின் யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நான் தமஸ்குவின் மதில்களுக்கு நெருப்பு வைப்பேன்.","poem":1},{"text":"அது பெனாதாத்தின் கோட்டைகளை எரிக்கும்.”","poem":2}]},{"type":"heading","content":["கேதாரையும், காத்சோரையும் பற்றிய செய்தி"]},{"type":"verse","number":28,"content":["பாபிலோன் அரசன் நேபுகாத்நேச்சார் தாக்கிய கேதாரையும், காத்சோர் அரசுகளையும் பற்றியது:",{"lineBreak":true},"யெகோவா கூறுவது இதுவே:",{"text":"“நீ எழுந்து கேதாரைத் தாக்கி","poem":1},{"text":"கிழக்கிலுள்ள மக்களை அழித்துவிடு.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர்களுடைய கூடாரங்களும், அவர்களுடைய மந்தைகளும் எடுத்துச் செல்லப்படும்;","poem":1},{"text":"அவர்களுடைய எல்லா பொருட்களுடனும் ஒட்டகங்களுடனும்","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய குடிமனைகள் எடுத்துச் செல்லப்படும்.","poem":2},{"text":"மனிதர் அவர்களைப் பார்த்து,","poem":1},{"text":"‘எல்லாப் பக்கங்களிலும் பயங்கரம்’ என்று சொல்லிக் கூக்குரலிடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“காத்சோரில் வாழ்பவர்களே நீங்கள் விரைவாகத் தப்பி ஓடுங்கள்;","poem":1},{"text":"ஆழமான குகைகளிலே தங்குங்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"ஏனெனில், “பாபிலோன் அரசன் நேபுகாத்நேச்சார்","poem":1},{"text":"உனக்கெதிராகச் சதித்திட்டமிட்டிருக்கிறான்;","poem":2},{"lineBreak":true},{"text":"அவன் உனக்கெதிராகத் திட்டமிட்டு சூழ்ச்சி செய்திருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“தன்னம்பிக்கையுடன்","poem":1},{"text":"சுகவாழ்வு வாழ்கிற நாட்டை எழுந்து தாக்கு”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“அது கதவோ, தாழ்ப்பாளோ இல்லாத ஒரு இனம்.","poem":1},{"text":"அதன் மக்கள் தனிமையாய் வாழ்கிறார்கள்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அவர்களுடைய ஒட்டகங்கள் கொள்ளைப்பொருளாகும்.","poem":1},{"text":"அவர்களுடைய பெரும் மந்தைகளும் சூறைப்பொருளாகும்.","poem":2},{"text":"தூரமான இடங்களில் இருக்கிறவர்களை நான்கு திசைகளிலும் சிதறடித்து,","poem":1},{"text":"ஒவ்வொரு பக்கத்திலிருந்தும் பேராபத்தைக் கொண்டுவருவேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"“காத்சோர், நரிகளுக்கு உறைவிடமாகி","poem":1},{"text":"என்றைக்கும் பாழடைந்திருக்கும்.","poem":2},{"text":"ஒருவரும் அங்கு வாழமாட்டார்கள்.","poem":1},{"text":"ஒரு மனிதரும் அங்கு குடியிருக்கவுமாட்டார்கள்.”","poem":2}]},{"type":"heading","content":["ஏலாமைப் பற்றிய செய்தி"]},{"type":"verse","number":34,"content":["யூதாவின் அரசன் சிதேக்கியாவின் ஆட்சியின் ஆரம்ப காலத்தில், ஏலாமைக் குறித்து இறைவாக்கினன் எரேமியாவுக்கு வந்த யெகோவாவின் வார்த்தை இதுவே:"]},{"type":"line_break"},{"type":"verse","number":35,"content":["சேனைகளின் யெகோவா கூறுவதாவது:",{"text":"“பாருங்கள், நான் ஏலாமின் வில்லை முறிப்பேன்;","poem":1},{"text":"அவர்களின் பலத்தின் ஆதாரத்தையும் முறிப்பேன்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"நான் வானத்தில் நான்கு திசைகளிலிருந்தும்,","poem":1},{"text":"நான்கு காற்றுகளை ஏலாமுக்கு எதிராகக் கொண்டுவருவேன்.","poem":2},{"text":"நான் அவர்களை நான்கு திசைகளிலும் சிதறடிப்பேன்.","poem":1},{"text":"ஏலாம் மக்கள் நாடுகடத்தப்பட்டு போகாத","poem":2},{"lineBreak":true},{"text":"ஒரு நாடும் இருக்கமாட்டாது.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"தங்கள் உயிரை வாங்கத் தேடுகிற","poem":1},{"text":"எதிரிகளுக்கு முன்பாக நான் ஏலாமை நொறுக்குவேன்.","poem":2},{"text":"என்னுடைய கடுங்கோபத்தினால்","poem":1},{"text":"பேராபத்தை அவர்கள்மேல் கொண்டுவருவேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“அவர்களை ஒரு முடிவுக்குக் கொண்டுவரும்வரை","poem":1},{"text":"வாளுடன் அவர்களைப் பின்தொடர்வேன்.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"நான் ஏலாமில் என்னுடைய அரியணையை அமைப்பேன்;","poem":1},{"text":"அதன் அரசர்களையும், அதிகாரிகளையும் அழிப்பேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“ஆனாலும் வரும் நாட்களில், ஏலாமின்","poem":1},{"text":"செல்வங்களை மீண்டும் கொடுப்பேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]}],"footnotes":[{"noteId":26,"caller":"+","text":"மோளேக் என்றால் அம்மோனிய தெய்வம், இதை வணங்குபவர்கள் மில்க்கோம் என்று அழைக்கப்பட்டனர்","reference":{"chapter":49,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/JER/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/48.json","previousChapterAudioLinks":{},"numberOfVerses":39}