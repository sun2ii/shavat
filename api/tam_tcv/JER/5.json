{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":5,"content":[{"type":"heading","content":["நீதிமான் ஒருவனுமில்லை"]},{"type":"verse","number":1,"content":[{"text":"எருசலேமின் வீதிகளில் அங்கும் இங்கும் போய்,","poem":1},{"text":"சுற்றிப் பார்த்துக் கவனியுங்கள்.","poem":2},{"lineBreak":true},{"text":"அதன் பொது சதுக்கங்களில் தேடிப் பாருங்கள்.","poem":2},{"text":"நேர்மையாய் நடந்து, உண்மையை விரும்புகிற","poem":1},{"text":"ஒரு மனிதனையாவது உங்களால் காணமுடியுமானால்,","poem":2},{"lineBreak":true},{"text":"நான் இந்தப் பட்டணத்தை மன்னிப்பேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“யெகோவா இருப்பது நிச்சயமெனில்” என்று அவர்கள் சொன்னாலும்,","poem":1},{"text":"அவர்கள் இன்னும் பொய் சத்தியம் செய்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே, உம்முடைய கண்கள் உண்மையைத் தேடவில்லையா?","poem":1},{"text":"நீர் அவர்களை அடித்தீர். அவர்கள் அதன் வலியை உணரவில்லை.","poem":2},{"lineBreak":true},{"text":"நீர் அவர்களை நசுக்கினீர். ஆனால் அவர்கள் திருந்துவதற்கு மறுத்துவிட்டார்கள்.","poem":2},{"text":"அவர்கள் தங்கள் முகங்களைக் கல்லைவிட கடினமாக்கி,","poem":1},{"text":"மனந்திரும்ப மறுத்துவிட்டார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“இவர்கள் ஏழைகளும் மூடர்களுமானவர்கள்","poem":1},{"text":"என்று நான் நினைத்தேன்.","poem":2},{"text":"இவர்கள் யெகோவாவின் வழியையோ","poem":1},{"text":"தங்கள் இறைவனுடைய நியமங்களையோ அறியாதவர்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆகவே நான் தலைவர்களிடம்போய் அவர்களோடு பேசுவேன்;","poem":1},{"text":"நிச்சயமாக அவர்கள் யெகோவாவின் வழியையும்,","poem":2},{"text":"தங்கள் இறைவனின் நியமங்களையும்","poem":1},{"text":"அறிந்திருப்பார்கள் என நினைத்தேன்.","poem":2},{"text":"ஆனால் அவர்களுங்கூட ஒருமனதாய் நுகத்தை முறித்து,","poem":1},{"text":"கட்டுகளை அறுத்துப் போட்டார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இதனால் காட்டிலிருந்து வரும் சிங்கம் அவர்களை தாக்கும்,","poem":1},{"text":"பாலைவனத்து ஓநாய் அவர்களைப் பாழ்படுத்தும்.","poem":2},{"text":"அவர்களுடைய பட்டணங்களின் அருகே சிறுத்தைப் பதுங்கிக் காத்திருந்து,","poem":1},{"text":"அது வெளியேவரும் எவனையும் துண்டுதுண்டாய் கிழித்துப்போடும்.","poem":2},{"text":"ஏனெனில் அவர்களின் கலகம் பெரிதாயும்","poem":1},{"text":"அவர்களின் பின்மாற்றங்கள் அதிகமாயும் உள்ளன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“நான் ஏன் உன்னை மன்னிக்க வேண்டும்?","poem":1},{"text":"உன்னுடைய பிள்ளைகள் என்னைக் கைவிட்டு விட்டார்கள்,","poem":2},{"lineBreak":true},{"text":"தெய்வங்கள் அல்லாதவைகளைக் கொண்டு சத்தியம் பண்ணுகிறார்கள்.","poem":2},{"text":"நான் அவர்களுடைய தேவைகளைப் பூரணமாகக் கொடுத்திருந்தேன்,","poem":1},{"text":"ஆயினும் அவர்கள் விபசாரம் செய்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"ஒரு பெரும் கூட்டமாய் வேசிகளின் வீடுகளுக்குப் போனார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்கள் கொழுமையாய் வளர்க்கப்பட்ட ஆண் குதிரைகளைப்போல்,","poem":1},{"text":"ஒவ்வொருவனும் அயலவனின் மனைவியின்மேல் ஆசைகொள்கிறான்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இதற்காக நான் அவர்களைத் தண்டிக்க வேண்டாமோ?”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“இப்படிப்பட்டவர்களை","poem":1},{"text":"நான் பழிவாங்க வேண்டாமோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“திராட்சைத் தோட்ட மதில்கள் மேலேறிப்போய் அவைகளைப் பாழ்படுத்து,","poem":1},{"text":"ஆனாலும் அவைகளை முற்றிலும் அழிக்கவேண்டாம்.","poem":2},{"text":"அவைகளின் கிளைகளை வெட்டிவிடு.","poem":1},{"text":"ஏனெனில் இந்த மக்கள் யெகோவாவுக்கு உரியவர்களல்ல.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"இஸ்ரயேல் குடும்பமும், யூதா குடும்பமும் முழுவதும்","poem":1},{"text":"எனக்கு உண்மையற்றவர்களாய் இருந்தார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அவர்கள் யெகோவாவைப் பற்றிப் பொய் உரைத்தார்கள்;","poem":1},{"text":"அவர்கள், “அவர் எங்களுக்கு ஒன்றும் செய்யமாட்டார்.","poem":2},{"text":"எங்களுக்கு ஒரு தீங்கும் வராது;","poem":1},{"text":"நாங்கள் வாளையோ பஞ்சத்தையோ ஒருபோதும் காணமாட்டோம்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இறைவாக்கினர் வெறும் காற்றுதானே,","poem":1},{"text":"அவர்களிடத்தில் இறைவனின் வார்த்தை இல்லை;","poem":2},{"lineBreak":true},{"text":"ஆகவே அவர்கள் சொல்வதெதுவோ அது அவர்களுக்கே செய்யப்படட்டும்” என்று சொன்னார்கள்.","poem":2}]},{"type":"verse","number":14,"content":["ஆகையால் சேனைகளின் இறைவனாகிய யெகோவா சொல்வதாவது:",{"text":"“இவர்கள் இந்த வார்த்தைகளைப் பேசியபடியால்,","poem":1},{"text":"உன் வாயில் உள்ள என் வார்த்தைகளை நெருப்பாக்குவேன்.","poem":2},{"lineBreak":true},{"text":"இந்த மக்களை அந்த நெருப்பு எரித்துப்போடும் விறகாக்குவேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"இஸ்ரயேல் குடும்பமே,","poem":1},{"text":"உங்களுக்கெதிராக தூரத்திலிருந்து ஒரு தேசத்தாரைக் கொண்டுவருகிறேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"அவர்கள் முற்காலத்திலிருந்து அழியாது நிலைத்து வாழுகின்ற ஒரு நாடு.","poem":1},{"text":"அவர்கள் நீங்கள் அறியாத மொழியையும்,","poem":2},{"lineBreak":true},{"text":"நீங்கள் விளங்கிக்கொள்ளாத பேச்சையும் பேசுகிறவர்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர்களுடைய அம்புக்கூடுகள் திறந்த சவக்குழியைப் போன்றவை.","poem":1},{"text":"அவர்கள் யாவரும் வலிமைமிக்க போர்வீரர்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர்கள் உங்களுடைய அறுவடைகளையும், உணவையும் விழுங்குவார்கள்.","poem":1},{"text":"உங்கள் மகன்களையும், மகள்களையும் விழுங்குவார்கள்.","poem":2},{"text":"அவர்கள் உங்கள் ஆட்டு மந்தைகளையும், மாட்டு மந்தைகளையும் விழுங்குவார்கள்.","poem":1},{"text":"உங்கள் திராட்சைக் கொடிகளையும்,","poem":2},{"text":"அத்திமரங்களையும் விழுங்குவார்கள்.","poem":1},{"text":"நீங்கள் நம்பிக்கை வைத்திருக்கிற அரணான பட்டணங்களையும் வாளினால் அழிப்பார்கள்.","poem":2}]},{"type":"verse","number":18,"content":["ஆயினும் அந்த நாட்களில் உங்களை முற்றிலும் அழிக்கமாட்டேன் என்று யெகோவா அறிவிக்கிறார்."]},{"type":"verse","number":19,"content":["மேலும், “எங்கள் இறைவனாகிய யெகோவா எங்களுக்கு ஏன் இவைகளை எல்லாம் செய்தார்” என்று, நீங்கள் கேட்கும்போது, “நீங்கள் என்னைக் கைவிட்டு உங்கள் சொந்த நாட்டிலே அந்நிய தெய்வங்களுக்குப் பணிசெய்தீர்கள். ஆகவே நீங்கள் இப்பொழுது உங்களுக்குரியதல்லாத நாட்டில் அந்நியருக்குப் பணிசெய்வீர்கள் என்று அவர்களுக்குச் சொல்."]},{"type":"verse","number":20,"content":[{"text":"“இதை நீ யாக்கோபின் குடும்பத்திற்கு அறிவித்து","poem":1},{"text":"யூதா நாட்டில் பிரசித்தப்படுத்து:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"மூடரே, உணர்ச்சியற்ற மக்களே,","poem":1},{"text":"கண்கள் இருந்தும் காணாதவர்களே,","poem":2},{"lineBreak":true},{"text":"காதுகள் இருந்தும் கேளாதவர்களே, நீங்கள் இதைக் கேளுங்கள்:","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நீங்கள் எனக்குப் பயப்பட வேண்டியதில்லையோ?”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"lineBreak":true},{"text":"“என் முன்னிலையிலே நீங்கள் நடுங்க வேண்டியதில்லையோ?","poem":2},{"text":"நானே மணலைக் கடலின் எல்லையாக்கினேன்.","poem":1},{"text":"கடல் கடந்து வரமுடியாத ஒரு நித்திய தடையாக அதை வைத்தேன்.","poem":2},{"text":"அதின் அலைகள் புரண்டு வந்தாலும், அத்தடையை மேற்கொள்ளமாட்டாது.","poem":1},{"text":"அலைகள் இரைந்தாலுங்கூட அதைக் கடந்து செல்லமாட்டாது.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஆனால் இந்த மக்களோ பிடிவாதமும், கலகமும் உள்ள","poem":1},{"text":"இருதயமுடையவர்களாய் இருக்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் என் வழியைவிட்டு விலகிப் போய்விட்டார்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"‘எங்கள் இறைவனாகிய யெகோவாவுக்கே நாங்கள் பயப்படுவோம்.","poem":1},{"text":"அவரே கோடை மழையையும் வசந்த மழையையும் அந்தந்த பருவகாலங்களில் தருகிறவர்.","poem":2},{"text":"ஒழுங்கான அறுவடைக் காலங்களையும் எங்களுக்குத் தவறாது தருகிறவர்’","poem":1},{"text":"என்று அவர்கள் தங்களுக்குள் சொல்லிக்கொள்வதில்லை.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உங்கள் கொடுமையான செயல்களே,","poem":1},{"text":"உங்களுக்கு இவைகள் கிடைக்காதபடி செய்திருக்கின்றன.","poem":2},{"lineBreak":true},{"text":"உங்கள் பாவங்களே, உங்களுக்கு நன்மை வராதபடி தடுத்திருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“என்னுடைய மக்களிடையே கொடுமையான மனிதர் இருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் பறவைகளைப் பிடிக்கக் கண்ணியை வைத்திருக்கும்","poem":2},{"lineBreak":true},{"text":"வேடரைப்போல் இருக்கிறார்கள்.","poem":2},{"text":"மனிதரைப் பிடிப்பதற்காகப் பொறி வைத்திருப்பவர்களைப் போலவும்","poem":1},{"text":"பதுங்கியிருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"பறவைகள் நிறைந்த கூடுகளைப்போல,","poem":1},{"text":"அவர்கள் வீடுகள் வஞ்சனைகளால் நிறைந்திருக்கின்றன.","poem":2},{"text":"அவர்கள் செல்வந்தர்களும் செல்வாக்குடையவர்களுமாய் இருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":28,"content":[{"text":"அவர்கள் கொழுமையும் செழுமையுமாயிருக்கிறார்கள்.","poem":2},{"text":"அவர்களுடைய தீய செயல்கள் அளவற்றதாயிருக்கின்றன;","poem":1},{"text":"தந்தையற்ற பிள்ளைகளின் வழக்கை","poem":2},{"text":"வெல்லும்படியாக பரிந்து பேசமாட்டார்கள்.","poem":1},{"text":"ஏழைகளின் உரிமைகளுக்காக வாதாடவும் மாட்டார்கள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"இதற்காக நான் அவர்களை தண்டிக்க வேண்டாமோ?”","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“நான் இப்படிப்பட்டவர்களைப்","poem":1},{"text":"பழிவாங்க வேண்டாமோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“நாட்டில் பயங்கரமும்,","poem":1},{"text":"அதிர்ச்சியுமான காரியம் நடந்துள்ளது:","poem":2}]},{"type":"verse","number":31,"content":[{"text":"இறைவாக்கினர் பொய்யையே இறைவாக்காகச் சொல்கிறார்கள்.","poem":1},{"text":"ஆசாரியரும் தங்கள் சொந்த அதிகாரத்தின்படியே ஆளுகைசெய்கிறார்கள்.","poem":2},{"text":"என் மக்களும் அதையே விரும்புகிறார்கள்.","poem":1},{"text":"ஆயினும் முடிவில் நீங்கள் என்ன செய்வீர்கள்?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JER/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/4.json","previousChapterAudioLinks":{},"numberOfVerses":31}