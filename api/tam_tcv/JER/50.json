{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":50,"content":[{"type":"heading","content":["பாபிலோனைப் பற்றிய செய்தி"]},{"type":"verse","number":1,"content":[{"noteId":27},"பாபிலோனியரைக் குறித்தும், பாபிலோன் நாட்டைக் குறித்தும் இறைவாக்கினன் எரேமியா மூலம் யெகோவா கூறிய வார்த்தை இதுவே:"]},{"type":"verse","number":2,"content":[{"text":"“அறிவியுங்கள், நாடுகளின் மத்தியில் பிரசித்தப்படுத்துங்கள்.","poem":1},{"text":"கொடியை உயர்த்தி பிரசித்தப்படுத்துங்கள்.","poem":2},{"lineBreak":true},{"text":"ஒன்றையும் மறைக்காமல் நீங்கள் சொல்லவேண்டியதாவது:","poem":2},{"text":"‘பாபிலோன் கைப்பற்றப்படும்.","poem":1},{"text":"பேல் தெய்வம் வெட்கத்திற்குள்ளாக்கப்படும்,","poem":2},{"lineBreak":true},{"text":"மெரொதாக் தெய்வம் பயங்கரத்தினால் நிரப்பப்படும்.","poem":2},{"text":"பாபிலோனின் உருவச்சிலைகள் வெட்கத்துக்குள்ளாகும்.","poem":1},{"text":"அவளுடைய விக்கிரகங்களும் பயங்கரத்தினால் நிரப்பப்படும்.’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"வடக்கிலிருந்து ஓர் தேசம் வந்து,","poem":1},{"text":"அதைத் தாக்கி அதன் நாட்டைப் பாழாக்கும்.","poem":2},{"text":"ஒருவனும் அதில் வாழமாட்டான்.","poem":1},{"text":"மனிதரும் மிருகங்களும் தப்பி ஓடிவிடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“அந்த நாட்களிலும், அந்தக் காலத்திலும் இஸ்ரயேல் மக்களும்,","poem":1},{"lineBreak":true},{"text":"யூதா மக்களும் ஒன்றுசேர்ந்து, தங்கள் இறைவனாகிய யெகோவாவைத் தேடுவதற்குக்","poem":1},{"text":"கண்ணீருடன் போவார்கள்” என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“சீயோனுக்குப் போகும் வழியைக் கேட்டு","poem":1},{"text":"அதை நோக்கி தங்கள் முகங்களைத் திருப்புவார்கள்.","poem":2},{"text":"அவர்கள் அங்கே வந்து மறக்கப்படாத","poem":1},{"text":"ஒரு நித்திய உடன்படிக்கையினால்","poem":2},{"lineBreak":true},{"text":"தங்களை யெகோவாவுடன் இணைத்துக்கொள்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“என் மக்கள் காணாமற்போன செம்மறியாடுகளாய் இருக்கிறார்கள்.","poem":1},{"text":"அவர்களுடைய மேய்ப்பர்கள் அவர்களைத் தவறாய் வழிநடத்தி,","poem":2},{"lineBreak":true},{"text":"மலைகளில் அலைந்து திரியப் பண்ணினார்கள்.","poem":2},{"text":"அவர்கள் மலையின்மேலும் குன்றின்மேலும் அலைந்து திரிந்து,","poem":1},{"text":"தங்கள் இளைப்பாறும் சொந்த இடத்தை மறந்துவிட்டார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்களைக் கண்டுபிடித்தவர்கள் அவர்களை விழுங்கிப் போட்டார்கள்.","poem":1},{"text":"அவர்களுடைய பகைவர்களோ, ‘நாங்கள் குற்றமற்றவர்கள்;","poem":2},{"text":"ஏனெனில் அவர்கள் தங்கள் உண்மையான மேய்ச்சலிடமான","poem":1},{"text":"யெகோவாவுக்கு விரோதமாக பாவம் செய்தார்கள்.","poem":2},{"text":"தங்கள் முற்பிதாக்கள் நம்பியிருந்த யெகோவாவுக்கு","poem":1},{"text":"விரோதமாகவே பாவம் செய்தார்கள்’ என்றார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“பாபிலோனைவிட்டுத் தப்பி ஓடுங்கள்,","poem":1},{"text":"பாபிலோனியரின் நாட்டைவிட்டு வெளியேறுங்கள்;","poem":2},{"lineBreak":true},{"text":"மந்தைக்கு முன்செல்லும் வெள்ளாடுகளைப்போல் இருங்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏனெனில் நான் வடதிசை நாட்டிலிருந்து பெரிய தேசத்தாரின்","poem":1},{"text":"ஒரு கூட்டத்தைப் பாபிலோனுக்கு விரோதமாகத் தூண்டி, எழுப்பிக் கொண்டுவருவேன்.","poem":2},{"text":"அவர்கள் அதற்கு விரோதமாக அணிவகுத்து வருவார்கள்.","poem":1},{"text":"வடக்கிலிருந்து அது சிறைப்பிடிக்கப்படும்.","poem":2},{"text":"அவர்களுடைய அம்புகள் வெறுங்கையுடன்","poem":1},{"text":"திரும்பிவராத திறமைவாய்ந்த போர் வீரரைப்போல் இருக்கும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"பாபிலோன் சூறையாடப்படும்.","poem":1},{"text":"அதைச் சூறையாடுபவர்கள் யாவரும் நிறைவாகப் பெற்றுக்கொள்வார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"என் உரிமைச்சொத்தாகிய என் மக்களை கொள்ளையிடுகிற பாபிலோனியரே!","poem":1},{"text":"நீங்கள் மகிழ்ந்து சந்தோஷப்படுகிறீர்கள்.","poem":2},{"text":"சூடுமிதிக்கும் இளம் பசுவைப்போல் துள்ளிக் குதிக்கிறீர்கள்;","poem":1},{"text":"ஆண் குதிரைகளைப்போல் கனைக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆனால், உங்கள் தாய் அதிக வெட்கத்துக்குள்ளாவாள்.","poem":1},{"text":"உங்களைப் பெற்றவள் அவமானப்படுவாள்.","poem":2},{"text":"அவள் நாடுகளுக்குள் மிகச் சிறியவளாயும்,","poem":1},{"text":"வனாந்திரமாயும், வறண்ட நிலமாயும், பாலைவனமாயும் இருப்பாள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அந்த நாடு, யெகோவாவின் கோபத்தினால்,","poem":1},{"text":"இனி குடியேற்றப்படாமல், முற்றிலும் கைவிடப்பட்டிருக்கும்.","poem":2},{"text":"பாபிலோனைக் கடந்து போகிறவர்கள் அதிர்ச்சியடைந்து","poem":1},{"text":"அதற்கு நேரிட்டவைகளைப் பார்த்துக் கேலி செய்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"வில் பிடிக்கிறவர்களே! நீங்கள் யாவரும் பாபிலோனைச் சுற்றி நிலைகொள்ளுங்கள்.","poem":1},{"text":"ஒரு அம்பையேனும் விட்டுவைக்காமல்","poem":2},{"text":"எல்லாவற்றையும் அவள்மேல் எய்திடுங்கள்.","poem":1},{"text":"ஏனெனில் அவள் யெகோவாவுக்கு எதிராகப் பாவம் செய்திருக்கிறாள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"எல்லாப் பக்கங்களிலுமிருந்து அவளுக்கு விரோதமாகச் சத்தமிடுங்கள்.","poem":1},{"text":"அவள் சரணடைகிறாள். அவளது கோபுரங்கள் விழுகின்றன.","poem":2},{"lineBreak":true},{"text":"மதில்கள் இடித்து வீழ்த்தப்படுகின்றன.","poem":2},{"text":"இது யெகோவாவின் பழிவாங்குதல்.","poem":1},{"text":"ஆதலால் அவளிடத்தில் பழிவாங்குங்கள்.","poem":2},{"lineBreak":true},{"text":"அவள் மற்றவர்களுக்குச் செய்ததுபோலவே, அவளுக்கும் செய்யுங்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"விதைப்பவனை பாபிலோனிலிருந்து வெட்டிப்போடுங்கள்.","poem":1},{"text":"அறுப்புக் காலத்தில் அறுப்பவனை அவனுடைய அரிவாளுடன் வெட்டிப்போடுங்கள்.","poem":2},{"text":"ஒடுக்குகிறவனுடைய வாளின் நிமித்தம் ஒவ்வொருவனும்","poem":1},{"text":"தன் சொந்த மக்களிடம் திரும்பிப் போகட்டும்,","poem":2},{"lineBreak":true},{"text":"ஒவ்வொருவனும் தன் சொந்த நாட்டிற்குத் தப்பியோடட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"இஸ்ரயேல் சிங்கங்களால் துரத்துண்டு","poem":1},{"text":"சிதறுகிற ஆட்டைப்போல் இருக்கிறது.","poem":2},{"text":"முதலில் அசீரிய அரசனே","poem":1},{"text":"அதை விழுங்கியவன்.","poem":2},{"text":"கடைசியாக பாபிலோன் அரசனான நேபுகாத்நேச்சாரே","poem":1},{"text":"அவனுடைய எலும்புகளை நொறுக்கியவன்.","poem":2}]},{"type":"verse","number":18,"content":["ஆகவே இஸ்ரயேலின் இறைவனாகிய சேனைகளின் யெகோவா கூறுவது இதுவே:",{"text":"அசீரிய அரசனைத் தண்டித்ததுபோல,","poem":1},{"text":"நான் பாபிலோன் அரசனையும் அவனுடைய நாட்டையும் தண்டிப்பேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இஸ்ரயேலையோ நான் திரும்பவும்","poem":1},{"text":"அவனுடைய சொந்த மேய்ச்சலிடத்துக்குக் கொண்டுவருவேன்;","poem":2},{"lineBreak":true},{"text":"அவன் கர்மேலிலும், பாசானிலும் மேய்வான்.","poem":2},{"text":"எப்பிராயீம் மலைநாட்டிலும்,","poem":1},{"text":"கீலேயாத்திலும் தன் பசியைத் தீர்ப்பான்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அந்தக் காலத்தில், அந்த நாட்களிலே இஸ்ரயேலின் குற்றம் தேடப்படும்.","poem":1},{"lineBreak":true},{"text":"அங்கு ஒன்றும் இராது.","poem":1},{"text":"யூதாவின் பாவங்களும் தேடிப்பார்க்கப்படும்.","poem":2},{"text":"ஒன்றும் காணப்படமாட்டாது.","poem":1},{"text":"ஏனெனில் நான் தப்பவைத்து மீந்திருப்பவர்களை","poem":2},{"lineBreak":true},{"text":"மன்னிப்பேன் என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"மெரதாயீம் நாட்டையும் பேகோதில் வாழ்கிறவர்களையும் தாக்குங்கள்.","poem":1},{"text":"அவர்களை தொடர்ந்து சென்று,","poem":2},{"text":"கொன்று முற்றிலும் அழித்துவிடுங்கள்","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"lineBreak":true},{"text":"நான் உங்களுக்குக் கட்டளையிட்டதையெல்லாம் செய்யுங்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நாட்டில் யுத்த சத்தம் உண்டாயிருக்கிறது.","poem":1},{"text":"அது ஒரு பேரழிவின் சத்தம்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"முழு பூமியையும் அடித்த சம்மட்டி","poem":1},{"text":"இப்பொழுது எவ்வளவாய் உடைந்து நொறுங்கிப் போயிற்று.","poem":2},{"text":"நாடுகளுக்குள் எவ்வளவாய்","poem":1},{"text":"பாபிலோன் கைவிடப்பட்டிருக்கிறது?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"பாபிலோனே! நான் உனக்கு ஒரு பொறி வைத்தேன்.","poem":1},{"text":"நீ அதை அறியும் முன்னே அகப்பட்டாய்.","poem":2},{"text":"நீ யெகோவாவுக்கு எதிர்த்து நின்றபடியினால்","poem":1},{"text":"கண்டுபிடிக்கப்பட்டுக் கைதியாக்கப்பட்டாய்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"யெகோவா தம்முடைய ஆயுதசாலையைத் திறந்து,","poem":1},{"text":"தமது கோபத்தின் ஆயுதங்களை வெளியே கொண்டுவந்துள்ளார்.","poem":2},{"text":"ஏனெனில் பாபிலோன் நாட்டில்","poem":1},{"text":"ஆண்டவராகிய சேனைகளின் யெகோவாவுக்கு செய்வதற்கு ஒரு வேலை உண்டு.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"வெகுதூரத்திலிருந்து அதற்கு விரோதமாய் வாருங்கள்.","poem":1},{"text":"அவளது தானிய களஞ்சியங்களை உடைத்துத் திறவுங்கள்.","poem":2},{"lineBreak":true},{"text":"அவளைத் தானியக் குவியலைப்போல் குவித்துவிடுங்கள்.","poem":2},{"text":"ஒன்றும் மீந்திராதபடி அவளை","poem":1},{"text":"முழுவதுமாக அழித்துவிடுங்கள்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவளுடைய இளங்காளைகள் எல்லாவற்றையும் கொன்றுவிடுங்கள்.","poem":1},{"text":"அவை வெட்டப்படுவதற்குக் கொண்டுபோகப்படட்டும்.","poem":2},{"text":"அவற்றிற்கு ஐயோ கேடு! ஏனெனில் அவைகளின் நாள் வந்துவிட்டது.","poem":1},{"text":"அவைகளைத் தண்டிக்கும் வேளை வந்துவிட்டது.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"பாபிலோனிலிருந்து தப்பி வந்தவர்களும்,","poem":1},{"text":"அகதிகளும் சீயோனில் அறிவிக்கிறதைக் கேளுங்கள்.","poem":2},{"text":"“எங்களுடைய இறைவனாகிய யெகோவா தம்முடைய ஆலயத்திற்காகப்","poem":1},{"text":"பழிவாங்க எப்படிப் பழி தீர்த்துள்ளார்?” என்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"வில்வீரர்களை அழைப்பியுங்கள்.","poem":1},{"text":"வில் வளைக்கும் யாவரையும்","poem":2},{"text":"பாபிலோனுக்கு விரோதமாக அழைப்பியுங்கள்.","poem":1},{"text":"அவளைச்சுற்றி முகாமிட்டு","poem":2},{"text":"ஒருவரையும் தப்பவிடாதிருங்கள்.","poem":1},{"text":"அவள் செய்த செய்கைகளுக்குத்தக்க பலனைக் கொடுங்கள்;","poem":2},{"text":"அவள் செய்தவாறே அவளுக்கும் செய்யுங்கள்.","poem":1},{"text":"ஏனெனில் இஸ்ரயேலின் பரிசுத்தரான யெகோவாவுக்கு விரோதமாய் அவள் எதிர்த்து நின்றாள்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ஆதலால் அவளுடைய வாலிபர் வீதிகளில் விழுவார்கள்.","poem":1},{"text":"அப்பட்டணத்தின் எல்லா இராணுவவீரரும் அந்த நாளில் அழிந்துபோவார்கள்","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"“பார்! அகங்காரம் கொண்டவளே! நான் உனக்கு விரோதமாயிருக்கிறேன்!”","poem":1},{"text":"என்று யெகோவா, சேனைகளின் யெகோவா கூறுகிறார்.","poem":2},{"text":"“உன் நாள் வந்துவிட்டது;","poem":1},{"text":"நீ தண்டிக்கப்படும் வேளை வந்துவிட்டது.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அகங்காரி இடறி விழுவாள்;","poem":1},{"text":"அவள் எழுந்திருக்க ஒருவரும் உதவமாட்டார்கள்.","poem":2},{"text":"நான் அவளுடைய பட்டணங்களில் நெருப்பு வைப்பேன்.","poem":1},{"text":"அது அவளைச் சுற்றியுள்ள யாவரையும் எரித்துப்போடும்.”","poem":2}]},{"type":"verse","number":33,"content":["மேலும் சேனைகளின் யெகோவா கூறுவதாவது:",{"text":"இஸ்ரயேல் மக்களோடு யூதா மக்களும்","poem":1},{"text":"ஒடுக்கப்பட்டிருக்கிறார்கள்.","poem":2},{"text":"அவர்களைச் சிறைப்படுத்தினோர் யாவரும் அவர்களைப் போகவிட மறுத்து,","poem":1},{"text":"இறுகப் பிடித்துக்கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"ஆயினும் அவர்களுடைய மீட்பர் பலம் மிக்கவர்.","poem":1},{"text":"சேனைகளின் வல்லமையுள்ள யெகோவா என்பது அவருடைய பெயர்.","poem":2},{"text":"அவர்களுடைய நிலத்திற்கு ஆறுதலையும்,","poem":1},{"text":"பாபிலோனில் வாழ்பவர்களுக்கோ ஓய்வின்மையையும் கொண்டுவரும்படி,","poem":2},{"lineBreak":true},{"text":"அவர்கள் சார்பாக உறுதியாய் வழக்காடுவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"பாபிலோனியருக்கு விரோதமாக ஒரு வாள் வரும்","poem":1},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"பாபிலோனில் வாழ்பவர்களுக்கும், அவளுடைய அதிகாரிகளுக்கும்,","poem":1},{"text":"அவளுடைய ஞானிகளுக்கும் விரோதமாக ஒரு வாள் வரும்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"அவளுடைய பொய்யான இறைவாக்கினருக்கு விரோதமாகவும் வாள் வரும்.","poem":1},{"text":"அவர்கள் மூடர்களாவார்கள்.","poem":2},{"text":"அவளுடைய போர்வீரருக்கு விரோதமாகவும் வாள் வரும்.","poem":1},{"text":"அவர்கள் பயங்கரத்தால் நிரப்பப்படுவார்கள்.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"அவளுடைய குதிரைகளுக்கும் தேர்களுக்கும் விரோதமாகவும்,","poem":1},{"text":"அவளுடைய படைப் பிரிவில் இருக்கும் பிறநாட்டினருக்கு விரோதமாகவும் வாள் வரும்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் பெண்களைப் போலாவார்கள்.","poem":2},{"text":"அவளுடைய செல்வங்களுக்கு விரோதமாகவும் வாள் வரும்.","poem":1},{"text":"அவை சூறையாடப்படும்.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"அவளுடைய நீர்நிலைகளின்மேல் வறட்சி வரும்.","poem":1},{"text":"அவை வறண்டுபோகும்.","poem":2},{"text":"ஏனெனில் அது விக்கிரகங்கள் நிறைந்த ஒரு நாடு.","poem":1},{"text":"அந்த விக்கிரகங்கள் பயங்கரத்தினால் பைத்தியம் பிடித்தவையாகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"ஆகவே பாலைவனப் பிராணிகளும், கழுதைப்புலிகளுமே அங்கு குடிகொள்ளும்;","poem":1},{"text":"ஆந்தையும் அங்கு வசிக்கும்.","poem":2},{"text":"அது மீண்டும் ஒருபோதும் குடியேற்றப்படவுமாட்டாது.","poem":1},{"text":"மக்கள் அங்கு சந்ததி சந்ததியாய் வாழவுமாட்டார்கள்.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"இறைவன் சோதோமையும், கொமோராவையும்","poem":1},{"text":"அதனை அடுத்திருந்த பட்டணங்களுடன்","poem":2},{"lineBreak":true},{"text":"கவிழ்த்ததைப்போலவே,","poem":2},{"text":"அங்கு ஒருவனும் வாழ்வதுமில்லை.","poem":1},{"text":"ஒரு மனிதனும் குடியிருப்பதுமில்லை என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“இதோ! வடதிசையிலிருந்து ஒரு படை வருகிறது;","poem":1},{"text":"ஒரு பெரிய நாடும், அநேக அரசர்களும்,","poem":2},{"lineBreak":true},{"text":"பூமியின் கடைசி எல்லைகளிலிருந்து எழும்புகிறது.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"அவர்கள் வில்லையும், ஈட்டியையும் ஆயுதமாய் ஏந்தியிருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் இரக்கமற்ற கொடியவர்கள்.","poem":2},{"text":"அவர்கள் தங்கள் குதிரைகளில் சவாரி செய்யும்போது அவர்களின் சத்தம்,","poem":1},{"text":"இரைகிற கடலைப் போலிருக்கிறது.","poem":2},{"text":"பாபிலோன் மகளே!","poem":1},{"text":"அவர்கள் போருக்கு அணிவகுத்த மனிதரைப்போல் உன்னைத் தாக்க வருகிறார்கள்.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"அவர்களைப்பற்றிய செய்தியை பாபிலோன் அரசன் கேள்விப்பட்டான்.","poem":1},{"text":"அவனுடைய கைகள் தளர்ந்து செயலிழந்தன.","poem":2},{"text":"பிரசவ வேதனைப்படும் ஒரு பெண்ணைப்போல,","poem":1},{"text":"பயமும் வேதனையும் அவனைப் பற்றிக்கொண்டது.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"யோர்தானின் புதர்களுக்குள்ளிருந்து ஒரு சிங்கம்","poem":1},{"text":"செழிப்பான மேய்ச்சலிடத்திற்கு ஏறிவருவதுபோல நான் வந்து,","poem":2},{"text":"பாபிலோனை அதன் நாட்டிலிருந்து ஒரு நொடிப்பொழுதில் துரத்துவேன்.","poem":1},{"text":"அதற்கென நியமிப்பதற்கு என்னால் தெரிந்துகொள்ளப்பட்டவன் யார்?","poem":2},{"text":"என்னைப் போன்றவன் யார்? எனக்கு அறைகூவல் விடுப்பவன் யார்?","poem":1},{"text":"எனக்கெதிராக எந்த மேய்ப்பன் நிற்பான்?” என்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“ஆகையால், யெகோவா பாபிலோனுக்கு விரோதமாக வகுத்த திட்டங்களையும்,","poem":1},{"text":"பாபிலோனியரின் நாட்டுக்கு விரோதமான அவரது நோக்கங்களையும் கேளுங்கள்.","poem":2},{"text":"மந்தையில் இளமையானவை இழுத்துச் செல்லப்படும்.","poem":1},{"text":"அவைகளின் நிமித்தம் அவைகளின் மேய்ச்சல் நிலத்தை முற்றுமாய் அழித்துப் போடுவான்.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"பாபிலோன் கைப்பற்றப்படும் சத்தத்தால் பூமி நடுங்கும்;","poem":1},{"text":"அதன் அழுகுரல் நாடுகளின் மத்தியிலே எதிரொலிக்கும்.”","poem":2}]}],"footnotes":[{"noteId":27,"caller":"+","text":"பாபிலோனியர்கள் கல்தேயர்கள் என்றும் அழைக்கப்படுவார்கள்","reference":{"chapter":50,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/JER/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/49.json","previousChapterAudioLinks":{},"numberOfVerses":46}