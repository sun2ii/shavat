{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":51,"content":[{"type":"verse","number":1,"content":["யெகோவா கூறுவது இதுவே:",{"text":"“பாருங்கள், நான் பாபிலோனுக்கும்,","poem":1},{"text":"லேப் காமாய்","poem":2},{"noteId":28},{"text":"மக்களுக்கும் எதிராக அழிக்கும் காற்றை","poem":2},{"noteId":29},{"text":"அனுப்புவேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பாபிலோனியரைப் புடைத்து அவர்களின் நாட்டை பாழாக்குவதற்காக,","poem":1},{"text":"நான் அந்நியரை பாபிலோனுக்கு அனுப்புவேன்.","poem":2},{"text":"அவர்கள் அவளுடைய பேரழிவின் நாளிலே,","poem":1},{"text":"எல்லாப் பக்கங்களிலும் அவளை எதிர்ப்பார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"வில்வீரன் வில்லை நாணேற்றாமலும்,","poem":1},{"text":"தன் போர்க்கவசத்தை அணிந்துகொள்ளாமலும் இருக்கட்டும்.","poem":2},{"text":"அவளுடைய வாலிபரைத் தப்பவிடவேண்டாம்.","poem":1},{"text":"அவளின் படைவீரரை முழுவதுமாக அழித்துவிடுங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் பாபிலோன் வீதிகளில் படுகாயமடைந்து,","poem":1},{"text":"கொல்லப்பட்டு விழுவார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஏனெனில் இஸ்ரயேலும்,","poem":1},{"text":"யூதாவும் இஸ்ரயேலின் இறைவனாகிய சேனைகளின் யெகோவாவினால் கைவிடப்படவில்லை.","poem":2},{"text":"அவர்களுடைய நாடு இஸ்ரயேலின் பரிசுத்தருக்கு முன்பாகக்","poem":1},{"text":"குற்றங்களால் நிறைந்திருந்தபோதிலும்,","poem":2},{"lineBreak":true},{"text":"அவர் அவர்களைக் கைவிடவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“பாபிலோனிலிருந்து தப்பி ஓடுங்கள்;","poem":1},{"text":"உயிர் தப்பி ஓடுங்கள்.","poem":2},{"lineBreak":true},{"text":"அவளுடைய பாவத்தின் நிமித்தம் நீங்களும் அழிக்கப்படாதிருங்கள்.","poem":2},{"text":"யெகோவா பழிவாங்கும் வேளை வந்துவிட்டது.","poem":1},{"text":"அவளுக்குத் தகுந்த தண்டனையை அவர் கொடுப்பார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"பாபிலோன் யெகோவாவினுடைய கையில் ஒரு தங்கக் கிண்ணமாயிருந்தாள்.","poem":1},{"text":"அவள் பூமி முழுவதையும் வெறிக்கப் பண்ணினாள்.","poem":2},{"text":"நாடுகள் அவளின் திராட்சை மதுவைக் குடித்து,","poem":1},{"text":"அதனால் இப்பொழுது மதிமயங்கிப் போனார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பாபிலோன் திடீரென விழுந்து உடைந்து போவாள்.","poem":1},{"text":"அவளுக்காகப் புலம்புங்கள்.","poem":2},{"text":"அவளுடைய நோவை ஆற்ற தைலம் கொண்டுவாருங்கள்.","poem":1},{"text":"ஒருவேளை அவள் குணமாகக்கூடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ ‘நாங்கள் பாபிலோனைக் குணமாக்கியிருக்கலாம்.","poem":1},{"text":"ஆனால் அவள் குணமடையமாட்டாள்;","poem":2},{"text":"அவளைவிட்டு நாங்கள் ஒவ்வொருவரும் அவரவர் சொந்த நாட்டுக்குப் போவோம்,","poem":1},{"text":"அவளின் நியாயத்தீர்ப்பு ஆகாயம்வரை எட்டி,","poem":2},{"lineBreak":true},{"text":"மேகங்களைப்போல் உயர எழும்புகிறது.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ ‘யெகோவா எங்கள் நியாயத்தை மெய்ப்பித்துக் காட்டியுள்ளார்.","poem":1},{"text":"வாருங்கள், எங்கள் இறைவனாகிய யெகோவா செய்ததை","poem":2},{"lineBreak":true},{"text":"சீயோனில் அறிவிப்போம்.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“அம்புகளைக் கூர்மையாக்குங்கள்.","poem":1},{"text":"கேடயங்களை எடுத்துக்கொள்ளுங்கள்.","poem":2},{"text":"யெகோவா மேதிய அரசர்களைத் தூண்டி எழுப்பியிருக்கிறார்.","poem":1},{"text":"பாபிலோனை அழிப்பதே அவருடைய நோக்கம்.","poem":2},{"text":"யெகோவா பழிவாங்குவார்.","poem":1},{"text":"அவர் தமது ஆலயத்தைத் தூய்மைக்கேடாக்கினபடியால் பழிவாங்குவார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பார்வோனின் மதில்களுக்கெதிராகப் போர்க்கொடி உயர்த்துங்கள்.","poem":1},{"text":"காவலை மேலும் பலப்படுத்துங்கள்.","poem":2},{"text":"காவலரை நிறுத்துங்கள்.","poem":1},{"text":"மறைந்திருந்து தாக்குபவர்களை ஆயத்தப்படுத்துங்கள்.","poem":2},{"text":"யெகோவா தமது நோக்கத்தையும்,","poem":1},{"text":"பாபிலோன் மக்களுக்கு எதிரான தமது தீர்ப்பையும் நிறைவேற்றுவார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"திரளான தண்ணீர்களின்மேல் வாசம்செய்கிறவளே!","poem":1},{"text":"திரவியச் செல்வங்களை உடையவளே!","poem":2},{"text":"உனது முடிவும்,","poem":1},{"text":"நீ அழிக்கப்படும் வேளையும் வந்துவிட்டன.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"சேனைகளின் யெகோவா தம்மேல் ஆணையிட்டுக் கூறியிருப்பதாவது:","poem":1},{"text":"நிச்சயமாக வெட்டுக்கிளிகளின் கூட்டத்தைப்போல் மனிதர்களால் உன்னை நிரப்புவேன்.","poem":2},{"lineBreak":true},{"text":"உன்னை அவர்கள் வென்று, ஆர்ப்பரிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“அவர் தமது வல்லமையினால் பூமியைப் படைத்து,","poem":1},{"text":"தமது ஞானத்தினால் உலகத்தை படைத்து,","poem":2},{"lineBreak":true},{"text":"தமது அறிவாற்றலினால் வானங்களை விரித்தார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர் முழங்கும்போது திரளான தண்ணீர் வானத்தில் உண்டாகிறது.","poem":1},{"text":"அவர் பூமியின் கடைசி எல்லைகளிலிருந்து மேகங்களை எழும்பச் செய்கிறார்.","poem":2},{"text":"அவர் மழையுடன் மின்னலை அனுப்பி தமது களஞ்சியங்களிலிருந்து","poem":1},{"text":"காற்றை வெளியே கொண்டுவருகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“ஒவ்வொரு மனிதனும் உணர்வற்றவனும், அறிவற்றவனுமாயிருக்கிறான்.","poem":1},{"text":"ஒவ்வொரு கொல்லனும் தன் விக்கிரகங்களால் வெட்கமடைகிறான்.","poem":2},{"text":"ஏனெனில் அவனுடைய உருவச்சிலைகள் போலியானவை.","poem":1},{"text":"அவைகளில் சுவாசமில்லை.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவைகள் பயனற்றவையாகவும், கேலிக்குரிய பொருட்களாகவும் இருக்கின்றன.","poem":1},{"text":"அவைகளுக்குரிய தண்டனை வரும்போது அவை அழிந்துபோகும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"யாக்கோபின் பங்காயிருப்பவர் இவைகளைப் போன்றவர் அல்ல;","poem":1},{"text":"ஏனெனில், அவரே எல்லாவற்றையும் படைத்தவர்.","poem":2},{"text":"தமது உரிமைச்சொத்தான கோத்திரத்தையும் அவரே படைத்தார்.","poem":1},{"text":"சேனைகளின் யெகோவா என்பது அவருடைய பெயர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“பாபிலோனே! நீயே எனக்குத் தண்டாயுதமும்,","poem":1},{"text":"போர் ஆயுதமுமாயிருக்கிறாய்.","poem":2},{"text":"நான் உன்னைக்கொண்டு நாடுகளை அழிக்கிறேன்.","poem":1},{"text":"உன்னைக்கொண்டே அரசுகளையும் அழிப்பேன்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"நான் உன்னைக்கொண்டு குதிரையையும், குதிரைவீரனையும் அழிக்கிறேன்.","poem":1},{"text":"உன்னைக்கொண்டே தேரையும், அதன் தேரோட்டியையும் அழிக்கிறேன்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நான் உன்னைக்கொண்டே ஆணையும், பெண்ணையும் அழிக்கிறேன்.","poem":1},{"text":"உன்னைக்கொண்டே முதியவனையும், இளைஞனையும் அழிக்கிறேன்.","poem":2},{"lineBreak":true},{"text":"உன்னைக்கொண்டே வாலிபனையும், இளம்பெண்ணையும் அழிக்கிறேன்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நான் உன்னைக்கொண்டே மேய்ப்பனையும், மந்தையையும் அழிக்கிறேன்.","poem":1},{"text":"உன்னைக்கொண்டே உழவனையும், எருதுகளையும் அழிக்கிறேன்.","poem":2},{"lineBreak":true},{"text":"உன்னைக்கொண்டே ஆளுநர்களையும், அலுவலர்களையும் அழிக்கிறேன்.","poem":2}]},{"type":"verse","number":24,"content":["“பாபிலோனையும் பாபிலோனில் வாழும் எல்லோரையும், சீயோனில் அவர்கள் செய்த எல்லாக் குற்றங்களுக்காக, நான் உங்கள் கண்களுக்கு முன்பாகவே அவர்களுக்குப் பதில் செய்வேன்” என்று யெகோவா அறிவிக்கிறார்."]},{"type":"verse","number":25,"content":[{"text":"அழிக்கும் மலையே! முழு பூமியையும் அழிக்கும் மலையே!","poem":1},{"text":"நான் உனக்கு விரோதமாகவே இருக்கிறேன்","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"என் கரத்தை உனக்கு விரோதமாய் நீட்டி,","poem":1},{"text":"கற்பாறை வெடிப்புகளிலிருந்து உன்னை உருட்டிவிடுவேன்;","poem":2},{"lineBreak":true},{"text":"நான் உன்னை ஒரு எரிந்து முடிந்த மலையாக ஆக்குவேன்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"மூலைக் கல்லுக்காக பாறாங்கல்லோ,","poem":1},{"text":"அஸ்திபாரத்துக்காக வேறெந்தக் கல்லோ உன்னிலிருந்து எடுக்கப்படமாட்டாது.","poem":2},{"lineBreak":true},{"text":"நீ என்றென்றைக்கும் பாழாகவே கிடப்பாய் என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"போர்க் கொடியை உயர்த்துங்கள்.","poem":1},{"text":"நாடுகளின் நடுவே எக்காளங்களை ஊதுங்கள்.","poem":2},{"text":"நாடுகளை பாபிலோனுக்கு விரோதமாகப் போருக்கு ஆயத்தப்படுத்துங்கள்.","poem":1},{"text":"அரராத், மின்னி, அஸ்கெனாஸ் ஆகிய","poem":2},{"lineBreak":true},{"text":"அரசுகளை அவளுக்கு விரோதமாய் அழைப்பியுங்கள்.","poem":2},{"text":"அவளுக்கு விரோதமாக ஒரு தளபதியையும் நியமியுங்கள்.","poem":1},{"text":"வெட்டுக்கிளிகளின் கூட்டம்போல் குதிரைகளை அனுப்புங்கள்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நாடுகளை அவளுக்கு விரோதமாகப் போருக்கு ஆயத்தப்படுத்துங்கள்.","poem":1},{"text":"மேதியா நாட்டின் அரசர்களையும்,","poem":2},{"text":"ஆளுநர்களையும், அதிகாரிகளையும்,","poem":1},{"text":"அவர்களுடைய ஆட்சியின் கீழிருக்கும் எல்லா நாடுகளையும்","poem":2},{"lineBreak":true},{"text":"அவளுக்கு விரோதமாக ஆயத்தப்படுத்துங்கள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"நாடானது நடுங்கித் துடிக்கிறது.","poem":1},{"text":"ஏனெனில் யெகோவாவின் நோக்கங்கள் பாபிலோனுக்கெதிராய் நிலைநிற்கின்றன.","poem":2},{"text":"ஒருவரும் அங்கு குடியிருக்க முடியாதபடி,","poem":1},{"text":"பாபிலோன் பாழாக்கப்படும்","poem":2}]},{"type":"verse","number":30,"content":[{"text":"பாபிலோனின் இராணுவவீரர் போரிடுவதை நிறுத்திவிட்டு,","poem":1},{"text":"அரண்களுக்குள்ளேயே தங்கியிருக்கிறார்கள்.","poem":2},{"text":"அவர்களின் பெலன் குன்றிப் போயிற்று.","poem":1},{"text":"அவர்கள் பெண்களைப் போலாகிவிட்டார்கள்.","poem":2},{"text":"அவளின் குடியிருப்புகள் எரிக்கப்பட்டன.","poem":1},{"text":"கதவுகளின் தாழ்ப்பாள்களும் உடைக்கப்பட்டன.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"பட்டணம் முழுவதும் கைப்பற்றப்பட்டுவிட்டதை,","poem":1},{"text":"பாபிலோன் அரசனுக்கு அறிவிப்பதற்காக,","poem":2},{"text":"தூதுவனுக்குப் பின் தூதுவனும்,","poem":1},{"text":"அஞ்சற்காரனுக்குப் பின் அஞ்சற்காரனும் தொடர்ந்து செல்கிறார்கள்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ஆற்றின் துறைமுகங்களும் பிடிக்கப்பட்டன.","poem":1},{"text":"புதர்களுக்கும் நெருப்பு வைக்கப்பட்டன.","poem":2},{"lineBreak":true},{"text":"போர்வீரரும் திகிலடைந்தார்கள்.","poem":2}]},{"type":"verse","number":33,"content":["இஸ்ரயேலின் இறைவனாகிய சேனைகளின் யெகோவா கூறுவது இதுவே:",{"text":"பாபிலோன் மகள் சூடடிக்கும் காலத்தில்","poem":1},{"text":"மிதிக்கப்படும் களத்துக்கு ஒப்பாயிருக்கிறாள்.","poem":2},{"lineBreak":true},{"text":"அவளை அறுவடை செய்யும் காலம் விரைவில் வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"பாபிலோன் அரசனான நேபுகாத்நேச்சார் எங்களை விழுங்கிப்போட்டான்.","poem":1},{"text":"எங்களை அவன் குழப்பத்திற்குள்ளாக்கி,","poem":2},{"lineBreak":true},{"text":"எங்களை வெறுமையான ஜாடியாக்கி விட்டான்.","poem":2},{"text":"இராட்சத பாம்பைப்போல எங்களை விழுங்கி,","poem":1},{"text":"எங்கள் சுவையான உணவுகளால் தன் வயிற்றை","poem":2},{"lineBreak":true},{"text":"நிரப்பிக்கொண்டு எங்களை வெளியே துரத்திவிட்டான்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"“எங்களுக்கும் எங்கள் பிள்ளைகளுக்கும் செய்யப்பட்ட கொடுமை","poem":1},{"text":"பாபிலோன்மீது சுமரட்டும்”","poem":2},{"lineBreak":true},{"text":"என்று சீயோனில் குடியிருப்பவர்கள் கூறுகிறார்கள்.","poem":2},{"text":"“எங்கள் இரத்தப்பழி பாபிலோனில் குடியிருப்பவர்கள்மேல் சுமரட்டும்”","poem":1},{"text":"என்று எருசலேம் கூறுகிறாள்.","poem":2}]},{"type":"verse","number":36,"content":["ஆகையால் யெகோவா கூறுவது இதுவே:",{"text":"“பார், நான் உனக்காக வழக்காடிப்","poem":1},{"text":"பழிவாங்குவேன்.","poem":2},{"text":"அவளின் கடலை வற்றச்செய்து,","poem":1},{"text":"ஊற்றுகளையும் வறண்டு போகப்பண்ணுவேன்.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"பாபிலோன் இடிபாடுகளின் குவியலாகி,","poem":1},{"text":"நரிகளின் உறைவிடமாகும்.","poem":2},{"text":"அது பயங்கரத்திற்கும், நிந்தைக்கும் உரிய பொருளும்,","poem":1},{"text":"ஒருவரும் குடியிராத இடமுமாகும்.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"அவளுடைய குடிமக்கள் யாவரும் இளம் சிங்கங்களைப்போல் கர்ஜிக்கிறார்கள்;","poem":1},{"text":"சிங்கக் குட்டிகளைப்போலச் சத்தமிடுவார்கள்.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"ஆயினும் அவர்கள் கொதித்தெழுந்தவர்களாய் இருக்கும்வேளையில்,","poem":1},{"text":"நான் அவர்களுக்கு வித்தியாசமான ஒரு விருந்தை ஆயத்தம்பண்ணி,","poem":2},{"lineBreak":true},{"text":"அவர்களை வெறிக்கப் பண்ணுவேன்.","poem":2},{"text":"அதனால் அவர்கள் உரத்த சத்தமிட்டுச் சிரிப்பார்கள்.","poem":1},{"text":"அதன்பின் அவர்கள் என்றுமே எழும்பாதபடி நித்திரையடைவார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"“வெட்டுவதற்குக் கொண்டுபோகப்படும் ஆட்டுக்குட்டிகளைப்போலவும்,","poem":1},{"text":"செம்மறியாட்டுக் கடாக்களைப்போலவும்,","poem":2},{"lineBreak":true},{"text":"வெள்ளாடுகளைப்போலவும் அவர்களைக் கொண்டுபோவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":41,"content":[{"text":"“சேசாக்கு","poem":1},{"noteId":30},{"text":"எப்படிக் கைப்பற்றப்பட்டது?","poem":1},{"text":"முழு பூமியினுடைய பெருமை எப்படிப் பிடிபட்டது?","poem":2},{"text":"நாடுகளுக்குள் பாபிலோன்","poem":1},{"text":"எவ்வளவு பயங்கரமாயிருக்கப் போகிறது.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"பாபிலோனுக்கு மேலாக கடல் புரண்டு எழும்பும்.","poem":1},{"text":"அதன் கொந்தளிக்கும் அலைகள் அதை மூடும்.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"அதன் பட்டணங்கள் பாழாகி,","poem":1},{"text":"வறண்டு பாலைவனமாகும்.","poem":2},{"text":"அங்கு ஒருவரும் குடியிருக்கமாட்டார்கள்.","poem":1},{"text":"அதின் வழியாக ஒருவனும் பயணம் செய்யவுமாட்டான்.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"நான் பாபிலோனில் இருக்கிற பேல் தெய்வத்தைத் தண்டிப்பேன்.","poem":1},{"text":"அவன் விழுங்கியதைத் துப்பும்படி செய்வேன்.","poem":2},{"text":"பிறநாடுகள் இனிமேல் அவன் பின்னால் அணி அணியாகப் போகமாட்டார்கள்.","poem":1},{"text":"பாபிலோனின் மதிலும் விழுந்துவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":45,"content":[{"text":"“என் மக்களே! அவளிடத்திலிருந்து வெளியேறுங்கள்.","poem":1},{"text":"உங்கள் உயிர் தப்ப ஓடுங்கள்.","poem":2},{"lineBreak":true},{"text":"யெகோவாவின் கடுங்கோபத்திலிருந்து விலகி ஓடுங்கள்.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"நாட்டில் வதந்திகள் பரவும்போது நீங்கள் கலங்கவோ, பயப்படவோ வேண்டாம்.","poem":1},{"text":"இந்த வருடத்தில் ஒரு வதந்தியும்,","poem":2},{"text":"மற்ற வருடத்தில் இன்னொரு வதந்தியும் வரும்.","poem":1},{"text":"நாட்டில் வன்செயல் பற்றிய வதந்திகளும்,","poem":2},{"lineBreak":true},{"text":"ஆள்பவனுக்கு விரோதமாக ஆள்பவன் எழும்புகிறான் என்ற வதந்திகளும் வரும்.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ஆகையால் நான் பாபிலோனின் விக்கிரங்களை தண்டிக்கும்","poem":1},{"text":"காலம் நிச்சயமாய் வரும்.","poem":2},{"text":"அவளுடைய முழு நாடும் அவமானப்படும்.","poem":1},{"text":"அங்கு கொலைசெய்யப்படும் யாவரும் அவளின் நடுவிலேயே விழுந்து கிடப்பார்கள்.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"அப்பொழுது வானமும், பூமியும் அவைகளிலுள்ள யாவும்","poem":1},{"text":"பாபிலோனைப் பார்த்து மகிழ்வுடன் ஆர்ப்பரிக்கும்.","poem":2},{"text":"ஏனெனில், அழிக்கிறவர்கள் வடக்கிலிருந்து வந்து,","poem":1},{"text":"அவளைத் தாக்குவார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"“பாபிலோனின் நிமித்தம் பூமியெங்கும்","poem":1},{"text":"வெட்டப்பட்டவர்கள் விழுந்ததுபோல்,","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலில் வெட்டப்பட்டவர்களின் நிமித்தம் பாபிலோனும் விழவேண்டும்.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"வாளுக்குத் தப்பியவர்களே!","poem":1},{"text":"நீங்கள் தாமதியாதீர்கள்;","poem":2},{"text":"புறப்படுங்கள்; நீங்கள் தூரதேசத்திலிருந்து யெகோவாவை நினைவுகூருங்கள்.","poem":1},{"text":"எருசலேமையும் நினைத்துக்கொள்ளுங்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":51,"content":[{"text":"“நிந்திக்கப்பட்டதால் நாங்கள்","poem":1},{"text":"அவமானத்துக்குள்ளானோம்.","poem":2},{"lineBreak":true},{"text":"வெட்கம் எங்கள் முகங்களை மூடுகிறது.","poem":2},{"text":"ஏனெனில், அந்நியர்கள்","poem":1},{"text":"யெகோவாவின் ஆலயத்தின் பரிசுத்த இடத்திற்குள் புகுந்து விட்டார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"“ஆனாலும் நாட்கள் வருகின்றன” என்று யெகோவா அறிவிக்கிறார்.","poem":1},{"text":"“அப்பொழுது நான் பாபிலோனுடைய விக்கிரகங்களை தண்டிப்பேன்.","poem":2},{"text":"பாபிலோன் நாடு முழுவதிலும்","poem":1},{"text":"காயப்பட்டோர் கதறுவார்கள்.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"பாபிலோன், ஆகாயம்வரை எட்டினாலும்,","poem":1},{"text":"உயர்ந்த தன் கோட்டைகளைப் பலப்படுத்தினாலும்,","poem":2},{"lineBreak":true},{"text":"நான் அவளுக்கு விரோதமாக அழிக்கிறவர்களை அனுப்புவேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":54,"content":[{"text":"“பாபிலோனிலிருந்து ஒரு அழுகையின் சத்தம் வருகிறது.","poem":1},{"text":"அது பாபிலோனியரின் நாட்டிலிருந்து","poem":2},{"lineBreak":true},{"text":"வரும் பேரழிவின் கூக்குரல்.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"யெகோவா பாபிலோனை அழிப்பார்;","poem":1},{"text":"அதன் பலத்த அமளியை அடக்குவார்.","poem":2},{"text":"எதிரிகள் அலையலையாய் வெள்ளம்போல கொந்தளித்து எழும்புவார்கள்.","poem":1},{"text":"அவர்களின் குரல்களின் இரைச்சல் எதிரொலிக்கும்.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"பாபிலோனுக்கு விரோதமாக அழிக்கிறவன் ஒருவன் வருவான்;","poem":1},{"text":"அவளுடைய போர்வீரர் பிடிக்கப்படுவார்கள்.","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய வில்லுகளும் முறிக்கப்படும்.","poem":2},{"text":"ஏனெனில் யெகோவா பழிவாங்கும் இறைவன்;","poem":1},{"text":"அவர் முழுமையாகப் பதில் செய்வார்.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"நான் அவளுடைய அலுவலர்களையும், ஞானிகளையும், ஆளுநர்களையும்,","poem":1},{"text":"அதிகாரிகளையும், போர்வீரர்களையும் வெறிக்கப் பண்ணுவேன்.","poem":2},{"text":"அவர்கள் விழித்தெழாமல் என்றென்றைக்கும் நித்திரையாயிருப்பார்கள்”","poem":1},{"text":"என்று சேனைகளின் யெகோவா என்ற பெயருடைய அரசர் கூறுகிறார்.","poem":2}]},{"type":"verse","number":58,"content":["சேனைகளின் யெகோவா கூறுவது இதுவே:",{"text":"“பாபிலோனின் அகன்ற மதில் தரைமட்டமாக்கப்படும்.","poem":1},{"text":"அவளது உயர்ந்த வாசல்கள் தீக்கிரையாகும்.","poem":2},{"text":"மக்கள் வீணாகவே பிரயாசப்படுகிறார்கள்.","poem":1},{"text":"நாடுகளின் உழைப்பும் நெருப்புக்கு எரிபொருளாகிறது.”","poem":2}]},{"type":"verse","number":59,"content":["மாசெயாவின் பேரனும் நேரியாவின் மகனுமான உயர் அதிகாரி செராயாவுக்கு இறைவாக்கினன் எரேமியா கொடுத்த செய்தி இதுவே: இது யூதாவின் அரசன் சிதேக்கியாவின் ஆட்சியின் நான்காம் வருடத்தில் செராயா, சிதேக்கியாவிடம் பாபிலோனுக்குப் போனபோது கொடுக்கப்பட்டது."]},{"type":"verse","number":60,"content":["எரேமியா பாபிலோனுக்கு வரவிருக்கும் எல்லாப் பேரழிவுகளைக் குறித்தும் ஒரு புத்தக சுருளில் எழுதினான். இவை எல்லாம் பாபிலோனைக் குறித்து ஏற்கெனவே எழுதி வைக்கப்பட்டவை."]},{"type":"verse","number":61,"content":["எரேமியா செராயாவிடம், “நீ பாபிலோனுக்குப் போய்ச் சேரும்போது, இதிலுள்ள எல்லா வார்த்தைகளையும் பலத்த சத்தமாக வாசிக்கக் கவனமாயிரு என்று சொன்னான்."]},{"type":"verse","number":62,"content":["அதன்பின், ‘ஆ! யெகோவாவே, மனிதனோ மிருகமோ இந்த இடத்தில் வாழாதபடி இதை அழிப்பேன் என்றும், இது என்றென்றும் பாழாய்க்கிடக்கும் என்றும் சொல்லியிருக்கிறீரே!’ என்று சொல்."]},{"type":"verse","number":63,"content":["நீ இந்தப் புத்தகத்தை வாசித்து முடிந்தவுடனே, இதில் ஒரு கல்லைக் கட்டி யூப்ரட்டீஸ் ஆற்றுக்குள் எறிந்துவிடு."]},{"type":"verse","number":64,"content":["அதன்பின், ‘நான் பாபிலோன்மேல் கொண்டுவர இருக்கும் பேரழிவினால் பாபிலோன் மீண்டும் மேலெழாதவாறு அமிழ்ந்துபோகும்; அவளுடைய மக்களும் மடிந்துபோவார்கள்’ என்று கூறு” என்றான்.",{"lineBreak":true},{"lineBreak":true},"எரேமியாவின் வார்த்தைகள் இத்துடன் முடிவடைகின்றன."]},{"type":"line_break"}],"footnotes":[{"noteId":28,"caller":"+","text":"லேப் காமாய் கல்தேயா நாட்டின் இரகசியப் பெயர். இது பாபிலோன் என்றும் அழைக்கப்படுகிறது.","reference":{"chapter":51,"verse":1}},{"noteId":29,"caller":"+","text":"இது பிற நாட்டு மக்கள் பாபிலோனை வென்று அனைத்து மக்களையும் விரட்டுபவர்கள்.","reference":{"chapter":51,"verse":1}},{"noteId":30,"caller":"+","text":"சேசாக்கு என்பது பாபிலோனின் இரகசிய பெயர் ஆகும்.","reference":{"chapter":51,"verse":41}}]},"thisChapterLink":"/api/tam_tcv/JER/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/50.json","previousChapterAudioLinks":{},"numberOfVerses":64}