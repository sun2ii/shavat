{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JER","translationId":"tam_tcv","name":"எரேமியா","commonName":"எரேமியா","title":"இறைவாக்கினன் எரேமியாவின் புத்தகம்","order":24,"numberOfChapters":52,"sha256":"cff4c1069174f12389e8e05fc1e85c8d774b16664578ab5e36633f3809b8a0f4","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tam_tcv/JER/52.json","totalNumberOfVerses":1364},"chapter":{"number":6,"content":[{"type":"heading","content":["எருசலேமின் முற்றுகை"]},{"type":"verse","number":1,"content":[{"text":"“பென்யமீன் மக்களே, பாதுகாப்புக்காக தப்பி ஓடுங்கள்.","poem":1},{"text":"எருசலேமைவிட்டுத் தப்பி ஓடுங்கள்!","poem":2},{"text":"தெக்கோவாவில் எக்காளத்தை ஊதுங்கள்!","poem":1},{"text":"பெத்கேரேமில் சைகை காட்டுங்கள்!","poem":2},{"text":"ஏனெனில் ஒரு பேராபத்து வடக்கிலிருந்து வருகிறது.","poem":1},{"text":"அது பயங்கர பேரழிவாய் வருகிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அழகும் மென்மையுமுள்ள","poem":1},{"text":"சீயோன் மகளை நான் அழிப்பேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"மேய்ப்பர்கள் தங்கள் மந்தைகளோடு அவளுக்கெதிராக வருவார்கள்.","poem":1},{"text":"அவளைச் சுற்றித் தங்கள் கூடாரங்களை அடித்து,","poem":2},{"lineBreak":true},{"text":"அவனவன் தான் தெரிந்துகொண்ட பகுதியில் தன் மந்தைகளை மேய்ப்பான்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“அவளுக்கெதிராக ஒரு யுத்தத்தை ஆயத்தப்படுத்துங்கள்,","poem":1},{"text":"எழுந்திருங்கள், நண்பகலில் தாக்குவோம்.","poem":2},{"text":"ஆனால் ஐயோ! பகல் வெளிச்சம் மங்குகிறது.","poem":1},{"text":"அந்திப்பொழுதும் சாய்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆகவே எழும்புங்கள்.","poem":1},{"text":"நாம் இரவில் தாக்கி அவளுடைய கோட்டைகளை அழிப்போம்.”","poem":2}]},{"type":"verse","number":6,"content":["சேனைகளின் யெகோவா சொல்வது இதுவே:",{"text":"“மரங்களை வெட்டி வீழ்த்தி","poem":1},{"text":"எருசலேமிற்கு எதிராக முற்றுகைக் கொத்தளங்களைக் கட்டுங்கள்.","poem":2},{"text":"இந்தப் பட்டணம் தண்டிக்கப்பட வேண்டும்;","poem":1},{"text":"அது அடக்கு முறையால் நிறைந்திருக்கிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஊற்றிலிருந்து தண்ணீர் சுரப்பதுபோல,","poem":1},{"text":"அவளிலிருந்து கொடுமை சுரந்துகொண்டே இருக்கிறது.","poem":2},{"text":"வன்செயலும், அழிவுமே அப்பட்டணத்தின் வீதிகளில் எதிரொலிக்கின்றன;","poem":1},{"text":"அவளுடைய நோய்களும், காயங்களும் எப்போதும் எனக்கு முன்பாக இருக்கின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எருசலேமே, இந்த எச்சரிப்பைக் கவனி.","poem":1},{"text":"இல்லாவிட்டால் நான் உன்னைவிட்டுப் போய்விடுவேன்,","poem":2},{"text":"ஒருவரும் அதில் குடியிருக்கமாட்டார்கள்.","poem":1},{"text":"அப்பொழுது உன் நாடு பாழாகும்.”","poem":2}]},{"type":"verse","number":9,"content":["சேனைகளின் யெகோவா சொல்வது இதுவே:",{"text":"“திராட்சைக்கொடிகளில் பறிக்காமல் விடப்பட்ட பழங்களை திரும்ப சேர்த்தெடுப்பதுபோல்,","poem":1},{"text":"இஸ்ரயேலில் மீதியாயிருப்பவர்களை சேர்த்தெடுங்கள்.","poem":2},{"text":"திராட்சைப் பழங்களைச் சேர்க்கிறவனைப்போல,","poem":1},{"text":"திரும்பவும் கிளைகளுக்கு இடையில் உனது கையைப் போடு.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நான் யாரோடு பேசி எச்சரிக்கை கொடுப்பேன்?","poem":1},{"text":"யார் எனக்குச் செவிகொடுப்பான்?","poem":2},{"text":"கேட்க முடியாதபடி அவர்களின்","poem":1},{"text":"காதுகள் மூடப்பட்டிருக்கின்றன","poem":2},{"noteId":4},{"text":".","poem":2},{"text":"யெகோவாவின் வார்த்தை அவர்களுக்கு வெறுப்பாயிருக்கிறது.","poem":1},{"text":"அதில் அவர்கள் மகிழ்ச்சி கொள்ளவில்லை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான் யெகோவாவினுடைய கடுங்கோபத்தினால் நிறைந்திருக்கிறேன்,","poem":1},{"text":"என்னால் அதை அடக்கிக்கொண்டிருக்க முடியாது.","poem":2},{"lineBreak":true},{"text":"“அதை வீதிகளில் இருக்கும் பிள்ளைகள் மேலும்,","poem":1},{"text":"ஒன்று கூடியிருக்கும் இளைஞர் மேலும் ஊற்றிவிடு;","poem":2},{"text":"கணவனும் மனைவியும் முதியவர்களும் வயது சென்றவர்களுங்கூட","poem":1},{"text":"அதில் அகப்படுவார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்களுடைய வீடுகளும் வயல்களும் மற்றவர்களுக்குச் சொந்தமாகும்.","poem":1},{"text":"மனைவிகளுங்கூட மற்றவர்களுக்குச் சொந்தமாவார்கள்.","poem":2},{"text":"நாட்டில் குடியிருப்பவர்களுக்கு எதிராக","poem":1},{"text":"நான் என்னுடைய கையை நீட்டும்போது, இது நிகழும்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஏனெனில், “தாழ்ந்தோர்முதல் உயர்ந்தோர்வரை,","poem":1},{"text":"எல்லோரும் அநியாய இலாபம் பெற பேராசைப்படுகிறார்கள்.","poem":2},{"text":"இறைவாக்கினர்முதல் ஆசாரியர்வரை அனைவரும்","poem":1},{"text":"ஒருமித்து வஞ்சனையே செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"என் மக்களின் கடுமையான காயத்தை,","poem":1},{"text":"கடுமையற்றதைப்போல் மருந்திட்டுக் கட்டுகிறார்கள்.","poem":2},{"text":"சமாதானம், சமாதானம் என்று சொல்கிறார்கள்,","poem":1},{"text":"ஆனால் சமாதானமோ அங்கே இல்லை.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர்கள் தங்களுடைய அருவருக்கத்தக்க நடத்தையைக் குறித்து","poem":1},{"text":"வெட்கப்படுகிறார்களா?","poem":2},{"text":"இல்லை, அவர்களுக்குச் சிறிதளவும் வெட்கம் இல்லை;","poem":1},{"text":"நாணங்கொள்ளவும் அவர்கள் அறியார்கள்.","poem":2},{"text":"ஆதலால் அவர்கள் விழுந்தவர்கள் மத்தியில் விழுவார்கள்;","poem":1},{"text":"நான் அவர்களைத் தண்டிக்கும்போது, தள்ளுண்டு போவார்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":16,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“வழியின் நாற்சந்திகளில் நின்று பாருங்கள்.","poem":1},{"text":"முன்னோர்களின் வழிகளைக் கேட்டு விசாரியுங்கள்.","poem":2},{"text":"நன்மையான வழி எங்கே என்று கேட்டு அதிலே நடவுங்கள்.","poem":1},{"text":"அப்பொழுது உங்கள் ஆத்துமாவுக்கு ஆறுதல் கிடைக்கும்.","poem":2},{"lineBreak":true},{"text":"ஆனால் நீங்களோ, ‘நாங்கள் அதில் நடக்கமாட்டோம்’ என்றீர்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நான் உங்கள்மேல் காவற்காரரை நியமித்து,","poem":1},{"text":"‘எக்காள சத்தத்தைக் கவனித்துக் கேளுங்கள்!’ என்று சொன்னேன்.","poem":2},{"lineBreak":true},{"text":"ஆனால் நீங்களோ, ‘நாங்கள் அதைக் கேட்க மாட்டோம்’ என்றீர்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஆகையால் நாடுகளே! கேளுங்கள்;","poem":1},{"text":"கூடியிருப்போரே! அவர்களுக்கு","poem":2},{"lineBreak":true},{"text":"என்ன நடக்கப்போகிறது என்பதைக் கவனியுங்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"பூமியே கேள்:","poem":1},{"text":"இந்த மக்கள்மேல் பேராபத்தைக் கொண்டுவரப் போகிறேன்.","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய சதித்திட்டங்களின் பலனே இது.","poem":2},{"text":"அவர்கள் என் வார்த்தைகளைக் கவனித்துக் கேட்கவில்லை.","poem":1},{"text":"என் சட்டத்தையும் புறக்கணித்துவிட்டார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"சேபாவிலிருந்து வரும் தூபவர்க்கமும்,","poem":1},{"text":"தூரதேசத்திலிருந்து வரும் நறுமணப் பொருட்களும் எனக்கு எதற்கு?","poem":2},{"text":"உங்கள் தகனபலிகள் எனக்கு ஏற்றுக்கொள்ளத்தக்கவை அல்ல;","poem":1},{"text":"உங்கள் பலிகளும் என்னை மகிழ்விப்பதில்லை.”","poem":2}]},{"type":"verse","number":21,"content":["ஆகையால் யெகோவா சொல்வது இதுவே:",{"text":"“நான் இந்த மக்களுக்கு முன்பாக தடைகளை வைப்பேன்.","poem":1},{"text":"தந்தையரும், மகன்களும் அவைகளின்மேல் இடறி விழுவார்கள்;","poem":2},{"lineBreak":true},{"text":"அயலவரும், சிநேகிதரும் அழிந்துபோவார்கள்.”","poem":2}]},{"type":"verse","number":22,"content":["யெகோவா சொல்வது இதுவே:",{"text":"“பாருங்கள்! வடதிசை நாட்டிலிருந்து","poem":1},{"text":"ஒரு படை வருகிறது.","poem":2},{"text":"ஒரு பெரிய நாடு","poem":1},{"text":"பூமியின் கடைசி எல்லைகளிலிருந்து எழும்புகிறது.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவர்கள் வில்லையும், ஈட்டியையும் ஆயுதமாய் ஏந்தியிருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் இரக்கமற்ற கொடியவர்கள்.","poem":2},{"text":"அவர்கள் தங்கள் குதிரைகளில் சவாரி செய்யும்போது அவர்களின் சத்தம்,","poem":1},{"lineBreak":true},{"text":"இரைகிற கடலைப் போலிருக்கிறது;","poem":1},{"text":"சீயோன் மகளே! அவர்கள் போருக்கு அணிவகுத்த மனிதரைப்போல்","poem":2},{"lineBreak":true},{"text":"உன்னைத் தாக்க வருகிறார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"அவர்களைப்பற்றிய செய்தியை நாங்கள் கேள்விப்பட்டோம்;","poem":1},{"text":"எங்கள் கைகள் தளர்ந்து செயலிழந்தன.","poem":2},{"text":"பிரசவ வேதனைப்படும் ஒரு பெண்ணைப்போல","poem":1},{"text":"பயமும் வேதனையும் எங்களைப் பற்றிக்கொண்டது.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"வயல்வெளி இடங்களுக்குப் போகவோ","poem":1},{"text":"வீதிகளில் நடக்கவோ வேண்டாம்.","poem":2},{"text":"ஏனெனில் பகைவன் வாளை வைத்திருக்கிறான்.","poem":1},{"text":"நாற்புறமும் பயங்கரம் இருக்கிறது.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"என் மக்களே, நீங்கள் துக்கவுடை உடுத்தி,","poem":1},{"text":"சாம்பலில் புரளுங்கள்;","poem":2},{"text":"ஒரே மகனுக்காக மனங்கசந்து","poem":1},{"text":"அழுவதைப்போல் துக்கப்படுங்கள்.","poem":2},{"text":"ஏனெனில் அழிக்கிறவன்","poem":1},{"text":"நம்மேல் திடீரென வருவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“எரேமியாவே! உன்னை உலோகங்களைப் பரிசோதிப்பவனாகவும்,","poem":1},{"text":"என் மக்களை உலோகத் துகள்களாகவும் ஆக்கினேன்.","poem":2},{"text":"நீயே என் மக்களுடைய வழிகளைக் கவனித்து,","poem":1},{"text":"பரிசோதித்துப் பார்க்கவேண்டும்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவர்கள் யாவரும் மனக்கடினமுள்ள கலகக்காரர்.","poem":1},{"text":"தூற்றுவதற்காக சுற்றித் திரிகிறார்கள்.","poem":2},{"text":"அவர்கள் வெண்கலமும் இரும்புமே;","poem":1},{"text":"அவர்கள் எல்லோரும் சீர்கேடாய் நடக்கிறார்கள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"நெருப்பினால் ஈயத்தை எரித்துப்போடுவதற்கு","poem":1},{"text":"உலைத்துருத்தி பயங்கரமான காற்றை ஊதுகிறது;","poem":2},{"text":"ஆனால் புடமிடுதல் பலனின்றி வீணாய்ப் போகிறது.","poem":1},{"text":"கொடுமை அவர்களிடமிருந்து அகற்றப்படவில்லை.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவர்கள் புறக்கணித்து விடப்பட்ட வெள்ளி என அழைக்கப்படுகிறார்கள்.","poem":1},{"text":"ஏனெனில் யெகோவா அவர்களைப் புறக்கணித்துவிட்டார்.”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"மூடப்பட்டிருக்கின்றன மூல மொழியில் விருத்தசேதனமில்லாமல் என உள்ளது.","reference":{"chapter":6,"verse":10}}]},"thisChapterLink":"/api/tam_tcv/JER/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JER/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}