{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"“நான் என் வாழ்வை வெறுக்கிறேன்;","poem":1},{"text":"அதினால் எனது குற்றச்சாட்டைத் தாராளமாகச் சொல்வேன்,","poem":2},{"lineBreak":true},{"text":"எனது ஆத்துமக் கசப்பைப் பேசுவேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் இறைவனிடம், நீர் என்னைக் குற்றவாளியாகத் தீர்க்காதிரும்,","poem":1},{"text":"எனக்கெதிராக என்ன குற்றச்சாட்டு உண்டு என எனக்குச் சொல்லும் எனக் கேட்பேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"கொடியவர்களின் சூழ்ச்சிகளைப் புன்முறுவலுடன் பார்த்துக்கொண்டு,","poem":1},{"text":"உமது கைகளினால் நீர் படைத்த","poem":2},{"lineBreak":true},{"text":"என்னை ஒடுக்குவது உமக்குப் பிரியமாயிருக்கிறதோ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உமக்கு மானிடக் கண்கள் உண்டோ?","poem":1},{"text":"நீர் மனிதன் பார்ப்பதுபோல் பார்க்கிறீரோ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உமது நாட்கள் மனிதனின் நாட்களைப்போலவும்,","poem":1},{"text":"உமது வருடங்கள் பலவானுடைய வருடங்களைப்போலவும் இருக்கிறதோ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அதினால்தானோ நீர் எனது தவறுதல்களைத் தேடுகிறீர்?","poem":1},{"text":"எனது பாவங்களைத் துருவி ஆராய்கிறீர்?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் குற்றமற்றவன் என்பது உமக்குத் தெரியும்,","poem":1},{"text":"உமது கையினின்று என்னை விடுவிக்க ஒருவராலும் முடியாது என்றும் தெரியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“உமது கரங்களே என்னை உருவாக்கிப் படைத்தன.","poem":1},{"text":"இப்பொழுது திரும்பி என்னை நீர் அழிப்பீரோ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"களிமண்ணைப்போல நீர் என்னை உருவாக்கியதை நினைத்துக்கொள்ளும்.","poem":1},{"text":"இப்பொழுது திரும்பவும் என்னைத் தூசிக்கே போகப்பண்ணுவீரோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீர் என்னைப் பால்போல வார்த்து","poem":1},{"text":"வெண்ணெய்க் கட்டிபோல உறையச் செய்தீரல்லவோ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"தோலையும் சதையையும் எனக்கு உடுத்தி,","poem":1},{"text":"எலும்புகளாலும் நரம்புகளாலும் என்னை பின்னினீர் அல்லவோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீரே எனக்கு வாழ்வு கொடுத்து, எனக்கு இரக்கம் காட்டினீர்,","poem":1},{"text":"உமது தயவினால் என் ஆவியைக் காத்திருந்தீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ஆனாலும் நீர் உமது இருதயத்தில் மறைத்து வைத்தது இதுவே,","poem":1},{"text":"இது உமது மனதில் இருந்தது என்பதை நான் அறிவேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் பாவம்செய்தால், நீர் என்னைக் கவனித்து,","poem":1},{"text":"என் குற்றங்களைத் தண்டிக்காமல் விடமாட்டீர் என நான் அறிந்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் குற்றவாளியாய் இருந்தால் எனக்கு ஐயோ கேடு!","poem":1},{"text":"நான் குற்றமற்றவனாய் இருந்தாலும் என்னால் தலைதூக்க முடியாது.","poem":2},{"text":"ஏனெனில், நான் அவமானத்தால் நிறைந்து,","poem":1},{"text":"வேதனையில் அமிழ்ந்து போயிருக்கிறேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நான் தலைநிமிர்ந்து நின்றால், சிங்கத்தைப்போல் என்னைப் பிடித்து,","poem":1},{"text":"திகிலூட்டும் வல்லமையைக் காண்பிக்கிறீர்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நீர் எனக்கெதிராக புதிய சாட்சிகளைக் கொண்டுவந்து,","poem":1},{"text":"என்மேலுள்ள உமது கோபத்தை அதிகரிக்கிறீர்,","poem":2},{"lineBreak":true},{"text":"அலைமேல் அலையாக உமது படைகள் எனக்கு விரோதமாய் வருகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“அப்படியானால் ஏன் என்னைக் கர்ப்பத்தில் இருந்து வெளியே கொண்டுவந்தீர்?","poem":1},{"text":"யாரும் என்னைப் பார்க்குமுன் நான் இறந்திருக்கலாமே.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"நான் உருவாகாமலேயே இருந்திருக்கலாம்;","poem":1},{"text":"கருவறையிலிருந்து கல்லறைக்கே போயிருக்கலாம்!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"என் வாழ்நாட்கள் முடிகிறது,","poem":1},{"text":"நான் மகிழ்ந்திருக்கும்படி சில மணித்துளிகள் நீர் விலகியிரும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"பின்னர், மந்தாரமும் மரண இருளும் சூழ்ந்த,","poem":1},{"text":"போனால் திரும்பி வரமுடியாத நாட்டிற்குப் போவேன்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"மரண இருள்சூழ்ந்த அந்நாட்டில் ஒழுங்கில்லை,","poem":1},{"text":"ஒளியும் இருளாய்த் தோன்றும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/9.json","previousChapterAudioLinks":{},"numberOfVerses":22}