{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":11,"content":[{"type":"heading","content":["சோப்பார்"]},{"type":"verse","number":1,"content":["அப்பொழுது நாகமாத்தியனான சோப்பார் மறுமொழியாக சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“இந்த வார்த்தைகளுக்கு யாராவது பதில்சொல்ல வேண்டாமா?","poem":1},{"text":"அதிகப் பேச்சினால் ஒருவன் நீதிமானாக முடியுமா?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உன் வீண்பேச்சு மனிதர்களின் வாயை அடக்குமோ?","poem":1},{"text":"நீ கேலி செய்யும்போது யாரும் உன்னைக் கண்டிக்கமாட்டார்களோ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீ இறைவனிடம், ‘என்னுடைய நம்பிக்கைகள் மாசற்றவை;","poem":1},{"text":"நான் உமது பார்வையில் தூய்மையானவன்’ என்று சொல்கிறாய்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறைவன் உன்னோடு பேசினால் நலமாயிருக்கும்,","poem":1},{"text":"அவர் உனக்கு விரோதமாக,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஞானத்தின் மறைபொருட்களை உனக்கு வெளிப்படுத்தினால் நல்லது;","poem":1},{"text":"ஏனெனில் மெய்ஞானம் இருபக்கங்களைக் கொண்டது.","poem":2},{"lineBreak":true},{"text":"இறைவன் உனது பாவங்களில் சிலவற்றைக்கூட மறந்துவிட்டார் என்பதை அறிந்துகொள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“இறைவனின் மறைபொருட்களின் ஆழத்தை உன்னால் அறியமுடியுமோ?","poem":1},{"text":"எல்லாம் வல்லவரின் எல்லைகளை ஆராய உன்னால் முடியுமோ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவை வானங்களைவிட உயரமானவை, உன்னால் என்ன செய்யமுடியும்?","poem":1},{"text":"அவை பாதாளத்தின் ஆழங்களிலும் ஆழமானவை, உன்னால் எதை அறியமுடியும்?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவைகளின் அளவு பூமியைவிட நீளமானவை;","poem":1},{"text":"கடலைவிட அகலமானவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“அவரே வந்து உன்னைச் சிறையிலடைத்து, நீதிமன்றத்தைக் கூட்டினால்,","poem":1},{"text":"யாரால் அவரை எதிர்த்து நிற்கமுடியும்?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஏமாற்றுகிற மனிதரை நிச்சயமாய் அவர் அறிவார்;","poem":1},{"text":"தீமையைக் காணும்போது அவர் கவனியாமல் இருப்பாரோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஒரு காட்டுக் கழுதைக்குட்டி எப்படி மனிதனாகப் பிறக்க முடியாதோ,","poem":1},{"text":"அப்படியே பகுத்தறிவில்லாத ஒருவனும் ஞானமுள்ளவனாகமாட்டான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“அப்படியிருந்தும் உன் உள்ளத்தில் அவரிடம்","poem":1},{"text":"பயபக்தியாயிருந்து உன் கைகளை அவரிடத்திற்கு நீட்டி,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"உன் கையிலுள்ள பாவத்தை விலக்கிவிட்டு,","poem":1},{"text":"உன் வீட்டில் தீமை குடிகொள்ளாமல் தடைசெய்தால்,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீ உன் முகத்தை வெட்கமின்றி உயர்த்தி,","poem":1},{"text":"பயமின்றி உறுதியாய் நிற்பாய்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீ உன் தொல்லையை மறந்துவிடுவாய்,","poem":1},{"text":"கடந்துபோன தண்ணீரைப்போல அது உன் ஞாபகத்தில் இருக்கும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அப்பொழுது வாழ்க்கை நண்பகலைவிட வெளிச்சமாயிருக்கும்,","poem":1},{"text":"இருள் காலையைப்போல மாறும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நம்பிக்கை இருப்பதினால் உறுதிகொள்வீர்,","poem":1},{"text":"சுற்றிலும் பார்த்து, பாதுகாப்பாக இளைப்பாறுவாய்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"யாரும் உன்னைப் பயமுறுத்தாமல் நீ படுத்திருப்பாய்;","poem":1},{"text":"அநேகர் உன் தயவை தேடிவருவார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ஆனால் கொடியவர்களின் கண்கள் மங்கிப்போகும்,","poem":1},{"text":"அவர்கள் தப்பித்துக்கொள்ளமாட்டார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்களின் நம்பிக்கை மரணமே.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/10.json","previousChapterAudioLinks":{},"numberOfVerses":20}