{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":12,"content":[{"type":"heading","content":["யோபு"]},{"type":"verse","number":1,"content":["பின்பு யோபு மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“நீங்கள் பெரியவர்கள், சந்தேகம் இல்லை.","poem":1},{"text":"ஞானமும் உங்களுடனே செத்துவிடும்!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எனக்கும் உங்களைப்போல் ஒரு மனம் உண்டு;","poem":1},{"text":"நான் உங்களுக்குக் குறைந்தவனல்ல;","poem":2},{"lineBreak":true},{"text":"இவற்றையெல்லாம் அறியாதவன் யார்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“நான் இறைவனை நோக்கிக் கூப்பிடுவேன், அவர் பதிலளிப்பார்;","poem":1},{"text":"நான் நீதிமானும், குற்றமற்றவனுமாய் இருந்தபோதிலும்,","poem":2},{"lineBreak":true},{"text":"என் நண்பர்களின் சிரிப்பிற்கு ஆளாகிவிட்டேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"சுகவாழ்வுள்ள மனிதர்கள் அவலத்தை வெறுக்கிறார்கள்;","poem":1},{"text":"அவர்கள் அது, கால் இடறுகிறவர்களின் விதி என்று எண்ணுகிறார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"திருடர்களுடைய கூடாரங்கள் குழப்பமின்றி இருக்கின்றன;","poem":1},{"text":"தெய்வத்தைத் தங்கள் கைகளிலேந்திச் செல்கிறவர்களும்,","poem":2},{"lineBreak":true},{"text":"இறைவனைக் கோபமூட்டுகிறவர்களும் பாதுகாப்பாயிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ஆனால் மிருகங்களைக் கேளுங்கள்; அவை உங்களுக்குப் போதிக்கும்,","poem":1},{"text":"ஆகாயத்துப் பறவைகளைக் கேளுங்கள்; அவை உங்களுக்குச் சொல்லித் தரும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பூமியுடன் பேசுங்கள், அது உங்களுக்குப் போதிக்கும்.","poem":1},{"text":"அல்லது கடல் மீன்களே உங்களுக்கு அறிவிக்கட்டும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவின் கரமே இதைச் செய்தது","poem":1},{"text":"என்பதை இவற்றுள் எது அறியாதிருக்கிறது?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஒவ்வொரு உயிரினங்களின் உயிரும்,","poem":1},{"text":"எல்லா மனிதரின் சுவாசமும் அவரின் கையிலேயே இருக்கின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நாவு உணவை ருசிப்பதுபோல,","poem":1},{"text":"காது சொற்களைச் சோதிக்கிறது அல்லவோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"முதியோரிடத்தில் ஞானம் இருக்கும்.","poem":1},{"text":"வயது சென்றவர்களிடத்தில் புத்தியும் இருக்குமே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“ஞானமும் வல்லமையும் இறைவனுக்கு உரியன;","poem":1},{"text":"ஆலோசனையும், விளங்கும் ஆற்றலும் அவருடையனவே.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர் இடித்தால் கட்டமுடியாது;","poem":1},{"text":"அவர் சிறைப்படுத்தும் மனிதனை விடுவிக்கவும் முடியாது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"தண்ணீரை அவர் தடுத்தால், அங்கு வறட்சி உண்டாகிறது;","poem":1},{"text":"அவர் தண்ணீரைத் திறந்துவிடும்போது அது நாட்டை அழிக்கிறது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"பெலமும் வெற்றியும் அவருக்குரியன;","poem":1},{"text":"ஏமாற்றுகிறவனும், ஏமாறுகிறவனுமான இருவருமே அவருடையவர்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர் ஆலோசகர்களின் ஞானத்தை அகற்றி அனுப்பி விடுகிறார்;","poem":1},{"text":"நீதிபதிகளையும் மூடராக்குகிறார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அரசர்களுடைய கட்டுகளை அவர் அவிழ்த்து,","poem":1},{"text":"அவர்கள் இடுப்புகளில் துணியைக் கட்டுகிறார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர் ஆசாரியர்களை நீக்கி,","poem":1},{"text":"நீண்டகால அதிகாரிகளைக் கவிழ்க்கிறார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர் நம்பிக்கைக்குரிய ஆலோசகர்களின் உதடுகளை மவுனமாக்குகிறார்;","poem":1},{"text":"முதியோரின் நிதானத்தையும் எடுத்துப் போடுகிறார்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர் உயர்குடி மக்கள்மேல் இகழ்ச்சியை ஊற்றி","poem":1},{"text":"பலவானைப் பலமிழக்கச் செய்கிறார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவர் இருளின் ஆழ்ந்த செயல்களை வெளிப்படுத்துகிறார்;","poem":1},{"text":"இருளின் ஆழத்தை வெளிச்சத்திற்குக் கொண்டுவருகிறார்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவர் மக்களைப் பெரிதாக்கி, அவர்களை அழிக்கிறார்;","poem":1},{"text":"மக்களை விரிவாக்கி அவர்களைச் சிதறப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"பூமியின் தலைவர்களின் சிந்திக்கும் ஆற்றலை இழக்கப்பண்ணுகிறார்;","poem":1},{"text":"பாதையில்லாத பாழிடங்களில் அவர்களை அலையப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவர்கள் வெளிச்சமில்லாமல் இருளில் தடவித் திரிகிறார்கள்;","poem":1},{"text":"வெறியரைப்போல் அவர்களைத் தள்ளாட வைக்கிறார்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/11.json","previousChapterAudioLinks":{},"numberOfVerses":25}