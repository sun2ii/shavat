{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"“இவை எல்லாவற்றையும் என் கண் கண்டிருக்கின்றது,","poem":1},{"text":"என் காது கேட்டு அறிந்திருக்கிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உங்களுக்குத் தெரிந்தவையெல்லாம் எனக்கும் தெரியும்;","poem":1},{"text":"நான் உங்களைவிட தாழ்ந்தவனல்ல.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஆனால் நான் எல்லாம் வல்லவரோடு பேசவும்,","poem":1},{"text":"இறைவனோடு என் வழக்கை வாதாடவும் விரும்புகிறேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"எப்படியும் நீங்கள் என்னைப் பொய்களால் மழுப்புகிறீர்கள்;","poem":1},{"text":"நீங்கள் எல்லோரும் ஒன்றுக்கும் உதவாத மருத்துவர்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீங்கள் பேசாமல் மட்டும் இருப்பீர்களானால்,","poem":1},{"text":"அது உங்களுக்கு ஞானமாயிருக்கும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இப்பொழுது என் விவாதத்தைக் கேளுங்கள்;","poem":1},{"text":"என் உதடுகளின் முறையிடுதலுக்குச் செவிகொடுங்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இறைவனின் சார்பாக கொடுமையாய்ப் பேசுவீர்களோ?","poem":1},{"text":"அவருக்காக நீங்கள் வஞ்சகமாய்ப் பேசுவீர்களோ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவருக்கு நீங்கள் பட்சபாதம் காட்டுவீர்களோ?","poem":1},{"text":"இறைவனுக்காக வழக்கை வாதாடுவீர்களோ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் உங்களைச் சோதித்தால், உங்களுக்கு நலமாகுமோ?","poem":1},{"text":"மனிதரை ஏமாற்றுவதுபோல் அவரை ஏமாற்ற முடியமோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீங்கள் இரகசியமாய் பட்சபாதம் காட்டினாலும்,","poem":1},{"text":"அவர் நிச்சயமாக உங்களைக் கண்டிப்பார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவருடைய மகத்துவம் உங்களுக்குத் திகிலூட்டாதோ?","poem":1},{"text":"அவருடைய பயங்கரம் உங்கள்மேல் வராதோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உங்கள் கொள்கைகள் சாம்பலை ஒத்த பழமொழிகள்;","poem":1},{"text":"உங்கள் எதிர்வாதங்களும் களிமண்ணுக்கு ஒப்பானது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“பேசாமல் இருங்கள், என்னைப் பேசவிடுங்கள்;","poem":1},{"text":"அதின்பின் எனக்கு வருவது வரட்டும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஏன் நான் என்னையே இடரில் மாட்டி,","poem":1},{"text":"உயிரைக் கையில் பிடித்துக்கொள்ள வேண்டும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர் என்னைக் கொன்றாலும், நான் இன்னும் அவரிலேயே நம்பிக்கையாயிருப்பேன்;","poem":1},{"text":"ஆனாலும் என் வழிகளை அவர்முன் குற்றமற்றவை என வாதாடுவேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"இது என் விடுதலைக்குக் காரணமாகும்,","poem":1},{"text":"இறைவனற்றவன் அவர்முன் சேரமாட்டான்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நான் பேசப்போவதைக் கவனமாய்க் கேளுங்கள்;","poem":1},{"text":"நான் சொல்வதை உங்கள் செவி ஏற்றுக்கொள்ளட்டும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"எனது வழக்கு ஆயத்தம்,","poem":1},{"text":"நான் குற்றமற்றவனென நிரூபிக்கப்படுவேன் என்பது எனக்குத் தெரியும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"எனக்கெதிராகக் குற்றச்சாட்டுகளைக் கொண்டுவர யாரால் முடியும்?","poem":1},{"text":"அப்படியானால், நான் மவுனமாயிருந்தே சாவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“இறைவனே, இந்த இரண்டு காரியங்களை மட்டும் கொடுத்தருளும்,","poem":1},{"text":"அப்பொழுது நான் உம்மிடமிருந்து மறைந்து கொள்ளமாட்டேன்:","poem":2}]},{"type":"verse","number":21,"content":[{"text":"உம்முடைய கையை என்னைவிட்டுத் தூரப்படுத்தும்,","poem":1},{"text":"உமது பயங்கரங்களால் என்னைத் திகிலடையச் செய்யாதீர்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அதின்பின் என்னைக் கூப்பிடும்; நான் பதில் சொல்வேன்,","poem":1},{"text":"அல்லது என்னைப் பேசவிட்டு நீர் பதில் கொடும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அநேக பிழைகளையும் பாவங்களையும் நான் செய்திருக்கிறேன்?","poem":1},{"text":"என் குற்றத்தையும், என் பாவத்தையும் எனக்குக் காட்டும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நீர் ஏன் உமது முகத்தை மறைத்து,","poem":1},{"text":"என்னை உமது பகைவனாகக் கருதுகிறீர்?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"காற்றில் பறக்கும் சருகை வேதனைப்படுத்துவீரோ?","poem":1},{"text":"பதரைப் பின்னால் துரத்திச்செல்வீரோ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ஏனெனில் எனக்கெதிராகக் கசப்பானவற்றை நீர் எழுதுகிறீர்;","poem":1},{"text":"என் வாலிப காலத்தின் பாவங்களை எனக்குப் அறுக்கச்செய்கிறீர்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நீர் எனது கால்களில் விலங்குகளை மாட்டுகிறீர்,","poem":1},{"text":"அடிச்சுவடுகளில் அடையாளமிட்டு","poem":2},{"lineBreak":true},{"text":"என் வழிகளையெல்லாம் கூர்ந்து கவனிக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ஆகவே அழுகிப்போன ஒன்றைப் போலவும்,","poem":1},{"text":"பூச்சி அரித்த உடையைப்போலவும் மனிதன் உருக்குலைந்து போகிறான்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/12.json","previousChapterAudioLinks":{},"numberOfVerses":28}