{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"“பெண்ணினால் பெற்றெடுக்கப்பட்ட மனிதன் சில நாட்களே வாழ்கிறான்,","poem":1},{"text":"அவையும் கஷ்டம் நிறைந்தவையே.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவன் ஒரு பூவைப்போல் பூத்து வாடிப்போகிறான்;","poem":1},{"text":"அவன் நிழலைப்போல் நிலையற்று மறைந்துபோகிறான்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அப்படிப்பட்டவனை நீர் கூர்ந்து கவனிப்பீரோ?","poem":1},{"text":"அவனை நியாயந்தீர்ப்பதற்காக உமக்கு முன்பாகக் கொண்டுவருவீரோ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அசுத்தத்தில் இருந்து சுத்தத்தை உருவாக்க யாரால் முடியும்?","poem":1},{"text":"யாராலுமே முடியாது!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"மனிதனுடைய நாட்கள் குறிக்கப்பட்டிருக்கின்றன;","poem":1},{"text":"அவனுடைய மாதங்களையும் நீரே நிர்ணயித்திருக்கிறீர்,","poem":2},{"lineBreak":true},{"text":"அவன் கடக்கமுடியாத எல்லைகளைக் குறித்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஒரு கூலியாள் தன் அன்றாட வேலை முடிந்தது என்று நிம்மதியாய் இருக்கிறானே.","poem":1},{"text":"அதுபோல் நீரும் மனிதன் ஓய்ந்திருக்க உமது பார்வையை அவனைவிட்டு விலக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“மரத்திற்குக்கூட ஒரு எதிர்பார்ப்பு உண்டு:","poem":1},{"text":"அது வெட்டிப்போடப்பட்டாலும் மீண்டும் தழைக்கும்;","poem":2},{"lineBreak":true},{"text":"அதின் புதிய தளிர்கள் தவறாது முளைக்கும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அதின் வேர் நிலத்தினடியில் பழையதாகி,","poem":1},{"text":"அதின் அடிக்கட்டை மண்ணிலே செத்தாலும்,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தண்ணீர் பட்டவுடனே அது துளிர்விட்டு","poem":1},{"text":"ஒரு செடியைப்போல் கிளைவிட்டு வளரும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"மனிதனோ இறந்தபின்,","poem":1},{"text":"தன் இறுதி மூச்சைவிட்டு இல்லாதொழிந்து போகிறான்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"கடல் தண்ணீர் வற்றி,","poem":1},{"text":"வெள்ளம் வறண்டு கிடப்பதுபோலவும்","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மனிதன் படுத்துக்கிடக்கிறான்,","poem":1},{"text":"அவன் வானங்கள் ஒழிந்துபோகும்வரை எழுந்திருக்கிறதும் இல்லை;","poem":2},{"lineBreak":true},{"text":"தூக்கம் தெளிந்து விழிக்கிறதும் இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“நீர் என்னைப் பாதாளத்தில் ஒளித்து,","poem":1},{"text":"உமது கோபம் தீருமட்டும் மறைத்துவைத்து,","poem":2},{"text":"நீர் எனக்கு ஒரு காலத்தைக் குறித்து,","poem":1},{"text":"அதின்பின் என்னை நினைவுகூர்ந்திருந்தாலோ எனக்கு நன்றாயிருந்திருக்குமே!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஒரு மனிதன் இறந்துபோனால் திரும்பவும் அவன் வாழ்வானோ?","poem":1},{"text":"ஆனாலும் என் கடின உழைப்பின் நாட்களிலெல்லாம்","poem":2},{"lineBreak":true},{"text":"நான் எனது விடுதலைக்காகக் காத்திருப்பேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அப்பொழுது நீர் கூப்பிடுவீர், நான் பதில் கொடுப்பேன்,","poem":1},{"text":"நீர் உமது கரங்களின் படைப்பாகிய என்மேல் வாஞ்சையாயிருப்பீர்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நிச்சயமாக நீர் என் காலடிகளைக் கணக்கிடுவீர்;","poem":1},{"text":"என் பாவத்தையோ கவனத்தில் கொள்ளமாட்டீர்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"எனது குற்றங்கள் பையில் இடப்பட்டு முத்திரையிடப்படும்;","poem":1},{"text":"நீர் எனது பாவங்களை மூடி மறைப்பீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“ஆனால் மலை இடிந்து விழுந்து கரைவதுபோலவும்,","poem":1},{"text":"பாறை தன் இடத்தைவிட்டு நகருவதுபோலவும்,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"தண்ணீர் கற்களை அரிப்பதுபோலவும்,","poem":1},{"text":"வெள்ளம் மணலை அடித்துச்செல்வது போலவும்","poem":2},{"lineBreak":true},{"text":"மனிதனின் எதிர்பார்ப்பை நீர் அழித்துப் போடுகிறீர்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நீர் அவனை ஒரேயடியாக மேற்கொள்கிறீர், அவன் இல்லாமல் போகிறான்;","poem":1},{"text":"நீர் அவன் முகத்தோற்றத்தை வேறுபடுத்தி, அவனை விரட்டிவிடுகிறீர்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவனுடைய மகன்கள் மேன்மையடைந்தாலும், அவன் அதை அறியான்;","poem":1},{"text":"அவர்கள் தாழ்த்தப்பட்டாலும், அதையும் அவன் காணமாட்டான்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஆனால் தன் சொந்த உடலின் நோவை மட்டுமே அறிவான்,","poem":1},{"text":"அவன் தனக்காக மாத்திரமே துக்கப்படுகிறான்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/13.json","previousChapterAudioLinks":{},"numberOfVerses":22}