{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":15,"content":[{"type":"heading","content":["எலிப்பாஸ் பேசுதல்"]},{"type":"verse","number":1,"content":["பின்பு தேமானியனான எலிப்பாஸ் மறுமொழியாக சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“ஞானவான் அர்த்தமற்ற நியாயங்களைச் சொல்லி,","poem":1},{"text":"கொண்டல் காற்றினால் தன் வயிற்றை நிரப்புவானோ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பயனற்ற வார்த்தைகளினாலும்,","poem":1},{"text":"மதிப்பற்றப் பேச்சுக்களினாலும் அவன் வாதாடுவானோ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால் நீயோ பயபக்தியை வேரறுக்கிறாய்;","poem":1},{"text":"இறைவனுக்கு முன்பாக தியானத்தையும் தடைசெய்கிறாய்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உன் பாவமே உன் வாயைப் பேசப்பண்ணுகிறது;","poem":1},{"text":"தந்திரக்காரரின் நாவை நீ பயன்படுத்துகிறாய்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"என் வாயல்ல, உன் வாயே உன்னைக் குற்றவாளியாக்குகிறது;","poem":1},{"text":"உன் உதடுகளே உனக்கு விரோதமாய்ச் சாட்சி கூறுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“மனிதருக்குள் முதன்முதல் பிறந்தவன் நீயோ?","poem":1},{"text":"மலைகளுக்கு முன்பே நீ உருவாக்கப்பட்டாயோ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீ இறைவனுடைய ஆலோசனையைக் கேட்கிறாயோ?","poem":1},{"text":"ஞானத்தை உனக்கு மட்டுமே உரிமையானதாக்கிக் கொள்கிறாயோ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நாங்கள் அறியாத எதை நீ அறிந்திருக்கிறாய்?","poem":1},{"text":"நாங்கள் பெற்றிராத எந்த நுண்ணறிவை நீ பெற்றிருக்கிறாய்?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"தலைமுடி நரைத்தோரும், முதியோரும் எங்கள் சார்பில் இருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் உன் தகப்பனைவிட வயதானவர்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"இறைவனது ஆறுதல்களும்,","poem":1},{"text":"அவர் தயவாக உன்னிடம் பேசிய வார்த்தைகளும் உனக்குப் போதாதோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீ உன் உள்ளத்து உணர்வுகளால் இழுபட்டுப் போனது ஏன்?","poem":1},{"text":"உன் கண்களில் ஏன் அனல் தெறிக்கிறது?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இறைவனுக்கு விரோதமாகச் சீற்றங்கொண்டு","poem":1},{"text":"இவ்வாறான வார்த்தைகளை நீ பேசுவானேன்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“தூய்மையானவனாய் இருப்பதற்கு மனிதன் யார்?","poem":1},{"text":"பெண்ணிடத்தில் பிறந்தவன் நேர்மையுள்ளவனாயிருப்பது எப்படி?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"இறைவன் தமது பரிசுத்தவான்களையும் நம்புகிறதில்லை;","poem":1},{"text":"வானங்களே அவருடைய பார்வைக்குத் தூய்மையற்றதாய் இருக்கிறதென்றால்,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"தீமையைத் தண்ணீரைப்போல் குடிக்கும்,","poem":1},{"text":"இழிவானவனும் சீர்கெட்டவனுமாகிய மனிதனில் இறைவன் குற்றம் காணாதிருப்பாரா?","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“நான் சொல்வதைக் கேள்; நான் உனக்கு விவரித்துச் சொல்வேன்;","poem":1},{"text":"நான் கண்டதைச் சொல்லவிடு.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஞானிகள் தங்கள் முற்பிதாக்களிடமிருந்து பெற்று,","poem":1},{"text":"ஒன்றையும் மறைக்காமல் அறிவித்ததைச் சொல்வேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அந்த முற்பிதாக்கள் மத்தியில் வேறுநாட்டினர் நடமாடாதபோது,","poem":1},{"text":"அவர்களுக்கு நாடு கொடுக்கப்பட்டது:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"கொடியவர் தன் வாழ்நாள் முழுவதும் வேதனையை அனுபவிப்பார்கள்;","poem":1},{"text":"துன்பத்தின் வருடங்கள் இரக்கமற்றோர்க்குக் கூட்டப்பட்டுள்ளன.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"திகிலூட்டும் சத்தங்கள் அவன் காதுகளை நிரப்புகின்றன;","poem":1},{"text":"எல்லாம் நலமாய்க் காணப்படும்போது கொள்ளைக்காரர் அவனைத் தாக்குகிறார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவன் இருளிலிருந்து தப்ப நம்பிக்கையில்லாமல் மனமுறிவடைகிறான்;","poem":1},{"text":"வாளுக்கு இரையாவதற்கென்றே அவன் குறிக்கப்பட்டிருக்கிறான்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவன் கழுகைப்போல உணவு தேடி அலைகிறான்;","poem":1},{"text":"இருளின் நாள் தனக்குச் சமீபித்திருக்கிறது என்பதையும் அவன் அறிவான்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"வேதனையும் கடுந்துயரமும் அவனைக் கலங்கச்செய்து,","poem":1},{"text":"யுத்தத்திற்கு ஆயத்தமான அரசனைப்போல் அவனை மேற்கொள்கின்றன.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஏனெனில், அவன் தனது கையை இறைவனுக்கு விரோதமாக நீட்டி,","poem":1},{"text":"எல்லாம் வல்லவருக்கு எதிராக இறுமாப்புடன் நடக்கிறான்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவன் தடித்த வலிமையான கேடயத்துடன்,","poem":1},{"text":"பணிவின்றி அவரை எதிர்த்துத் தாக்குகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“அவனுடைய முகத்தைக் கொழுப்பு மூடியிருக்கிறது,","poem":1},{"text":"அடிவயிறு தொந்திவிட்டிருக்கிறது.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவன் பாழடைந்த பட்டணங்களிலும்,","poem":1},{"text":"கற்குவியலாக நொறுங்கி","poem":2},{"lineBreak":true},{"text":"ஒருவரும் குடியிராத வீடுகளிலும் வாழ்வான்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவன் இனி ஒருபோதும் செல்வந்தனாவதுமில்லை; அவனுடைய செல்வமும் நிலைத்திராது,","poem":1},{"text":"அவனுடைய உடைமைகளும் பூமியில் பெருகாது.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவன் இருளுக்குத் தப்புவதில்லை;","poem":1},{"text":"அக்கினி ஜூவாலை அவன் தளிர்களை வாட்டும்,","poem":2},{"lineBreak":true},{"text":"இறைவனுடைய வாயின் சுவாசம் அவனை இல்லாதொழியப் பண்ணும்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"வீணானதை நம்பி, அவன் தன்னையே ஏமாற்றாதிருக்கட்டும்;","poem":1},{"text":"அவன் பிரதிபலனைப் பெறமாட்டான்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அவனுடைய வாழ்நாள் முடிவதற்கு முன்பே அவனுக்கேற்ற பலன் கொடுக்கப்படும்;","poem":1},{"text":"அவனுடைய கிளைகளும் பசுமையாக இருக்காது.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அவன் பழுக்கும் முன்னமே பழம் உதிர்ந்துபோன திராட்சைக் கொடியைப்போலவும்,","poem":1},{"text":"பூக்கள் உதிர்கின்ற ஒலிவமரத்தைப் போலவும் இருப்பான்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"இறைவனை மறுதலிக்கிற கூட்டத்தவர்கள் மலடாய்ப் போவார்கள்;","poem":1},{"text":"இலஞ்சத்தை நாடுவோரின் கூடாரங்களை நெருப்பு பட்சிக்கும்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"அவர்கள் கஷ்டத்தைக் கர்ப்பந்தரித்து, தீமையைப் பெற்றெடுக்கிறார்கள்,","poem":1},{"text":"அவர்களுடைய கருப்பை வஞ்சனையை உருவாக்குகிறது.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/14.json","previousChapterAudioLinks":{},"numberOfVerses":35}