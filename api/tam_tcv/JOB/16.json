{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":16,"content":[{"type":"heading","content":["யோபு பேசுதல்"]},{"type":"verse","number":1,"content":["அதற்கு யோபு மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“நான் இதுபோன்ற அநேக காரியங்களைக் கேள்விப்பட்டிருக்கிறேன்;","poem":1},{"text":"நீங்கள் எல்லோரும் துன்பத்துக்குள்ளாக்கும் தேற்றரவாளர்கள்!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"காற்றைப்போன்ற உங்கள் வீண் வார்த்தைகளுக்கு முடிவே இல்லையா?","poem":1},{"text":"உங்களை இப்படித் தொடர்ந்து பேசவைப்பது என்ன?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீங்கள் என் நிலையில் இருந்தால்,","poem":1},{"text":"என்னாலும் உங்களைப்போல் பேசமுடியும்;","poem":2},{"text":"நான் உங்களுக்கு விரோதமாய்ச் சிறந்த சொற்பொழிவாற்றி,","poem":1},{"text":"உங்களுக்கு எதிரே என் தலையை ஏளனமாய் அசைக்கவும் முடியும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆனால் என் வாயினால் உங்களைத் தைரியப்படுத்துவேன்,","poem":1},{"text":"என் உதடுகளிலிருந்து வரும் ஆறுதல் உங்கள் துன்பத்தை ஆற்றும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“நான் பேசினாலும் என் துயரம் என்னைவிட்டு நீங்காது;","poem":1},{"text":"பேசாவிட்டால் அது அகன்று போவதுமில்லை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இறைவனே, நீர் என்னை இளைக்கப் பண்ணிவிட்டீர்;","poem":1},{"text":"என் குடும்பத்தையும் நீர் பாழாக்கிவிட்டீர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீர் என்னை ஒடுங்கப்பண்ணினீர், அதுவே சாட்சியாகிவிட்டது;","poem":1},{"text":"என் மெலிவு எனக்கு விரோதமாக எழுந்து சாட்சி கூறுகிறது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இறைவன் என்னைத் தாக்கி, தமது கோபத்தில் என்னைக் கிழித்து,","poem":1},{"text":"என்னைப் பார்த்து தமது பற்களை கடிக்கிறார்;","poem":2},{"lineBreak":true},{"text":"என் எதிரி தமது கண்களால் என்னை கூர்ந்து பார்க்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"மனிதர் என்னைக் கேலிசெய்யத் தங்கள் வாய்களைத் திறக்கிறார்கள்;","poem":1},{"text":"ஏளனத்துடன் என்னைக் கன்னத்தில் அறைந்து","poem":2},{"lineBreak":true},{"text":"எனக்கு விரோதமாய் ஒன்றுகூடுகிறார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"இறைவன் என்னைத் தீய மனிதரிடம் ஒப்புக்கொடுத்து,","poem":1},{"text":"கொடியவர்களின் பிடிக்குள் என்னை சிக்கவைத்தார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நான் நலமாய் இருந்தேன், அவர் என்னைச் சிதறடித்தார்;","poem":1},{"text":"அவர் என் பிடரியைப் பிடித்து, என்னை நொறுக்கினார்.","poem":2},{"text":"அவர் என்னைத் தமது இலக்காக ஆக்கினார்;","poem":1}]},{"type":"verse","number":13,"content":[{"text":"அவருடைய வில்வீரர்கள் என்னைச் சூழ்ந்துகொள்கிறார்கள்.","poem":2},{"text":"இரக்கமின்றி, அவர் என் ஈரலைக் குத்தி","poem":1},{"text":"எனது பித்தத்தை நிலத்தில் சிந்தப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"திரும்பத்திரும்ப அவர் என்னை நொறுக்கி,","poem":1},{"text":"ஒரு போர்வீரனைப்போல் என்னைத் தாக்குகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“நான் துக்கவுடையைத் தைத்து என் உடலுக்குப் போர்த்தினேன்;","poem":1},{"text":"என் மேன்மையைப் தூசியில் புதைத்தேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"என் முகம் அழுகையால் சிவந்து,","poem":1},{"text":"என் கண்கள் இருளடைந்தது;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இருப்பினும், என் கைகள் வன்செயலுக்கு உட்படாதவை;","poem":1},{"text":"என் ஜெபம் தூய்மையானது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“பூமியே என் இரத்தத்தை மூடி மறைக்காதே","poem":1},{"noteId":0},{"text":";","poem":1},{"text":"என் கதறல் ஒருபோதும் ஓய்ந்து போகாதிருக்கட்டும்!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இப்போதும் என் சாட்சி பரலோகத்திலிருக்கிறது;","poem":1},{"text":"எனக்காக வழக்காடுபவர் உன்னதத்தில் இருக்கிறார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"என் கண்கள் இறைவனை நோக்கிக் கண்ணீர் வடிக்கிறபோது,","poem":1},{"text":"எனக்காகப் பரிந்துபேசுகிறவர் என் சிநேகிதர்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஒருவன் தன் சிநேகிதனுக்காகப் பரிந்துபேசுகிறதுபோல,","poem":1},{"text":"அவரும் மனிதனுக்காக இறைவனுடன் பேசுகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“நான் திரும்பி வரமுடியாத பயணத்திற்குப் போவதற்கு,","poem":1},{"text":"இன்னும் சில வருடங்களே இருக்கின்றன.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"மூடி மறைக்காதே அல்லது எனக்கு செய்த தவறுகளை மறைக்காதே.","reference":{"chapter":16,"verse":18}}]},"thisChapterLink":"/api/tam_tcv/JOB/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/15.json","previousChapterAudioLinks":{},"numberOfVerses":22}