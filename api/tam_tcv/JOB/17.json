{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"என் மூச்சு நின்றுபோகிறது,","poem":1},{"text":"என் வாழ்நாட்கள் முடிகின்றன,","poem":2},{"lineBreak":true},{"text":"கல்லறை எனக்குக் காத்திருக்கிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"கேலி செய்கிறவர்கள் என்னைச் சூழ்ந்திருக்கின்றனர்;","poem":1},{"text":"அவர்களுடைய பகைமையே என் கண்முன் இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“இறைவனே, நீர் கேட்கும் பிணையை நீரே எனக்குத் தாரும்.","poem":1},{"text":"வேறு யார் எனக்கு அதைக் கொடுப்பார்கள்?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"விளங்கிக்கொள்ளாதபடி அவர்களுடைய மனதை நீர் அடைத்தீர்.","poem":1},{"text":"ஆகையால் அவர்களை வெற்றிகொள்ள விடமாட்டீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தன் சொந்த நலன் கருதி சிநேகிதர்களுக்குத் துரோகம் செய்தால்,","poem":1},{"text":"அவருடைய பிள்ளைகளின் கண்கள் மங்கிப்போகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“இறைவன் என்னை எல்லோருக்கும் ஒரு பழமொழியாக்கினார்;","poem":1},{"text":"என்னைக் காண்போர் என் முகத்தில் துப்புகின்றனர்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"துயரத்தினால் என் கண்கள் மங்கிப்போயின;","poem":1},{"text":"என் உடலமைப்பு ஒரு நிழலைப்போல் ஆயிற்று.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நேர்மையான மனிதர் இதைக்கண்டு திகைக்கிறார்கள்;","poem":1},{"text":"குற்றமற்றவர்கள் இறைவனற்றவர்களுக்கு விரோதமாக எழும்புவார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஆனாலும் நேர்மையானவர்கள் தங்கள் வழிகளில் உறுதியாய் நிற்பார்கள்;","poem":1},{"text":"சுத்தமான கைகளை உடையவர்கள் வலிமை அடைவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“நீங்கள் எல்லோரும் வாருங்கள், முயன்று பாருங்கள்!","poem":1},{"text":"நான் உங்களில் ஞானமுள்ள ஒருவரையும் காணவில்லை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் நாட்கள் கடந்துபோயின; என் திட்டங்கள் சிதைந்துவிட்டன.","poem":1},{"text":"என் இருதயத்தின் ஆசைகளும் அவ்வாறே சிதறிப்போயின.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இந்த மனிதர் இரவைப் பகலாக மாற்றுகிறார்கள்;","poem":1},{"text":"வெளிச்சம் இருளுக்கு சமீபமாயிருக்கிறது என்கிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் எதிர்பார்த்திருக்கும் ஒரே வீடு பாதாளமாய் இருந்திருந்தால்,","poem":1},{"text":"நான் என் படுக்கையை இருளில் விரித்திருந்தால்,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் அழிவைப் பார்த்து, ‘நீ என் தகப்பன்’ என்றும்,","poem":1},{"text":"புழுவைப் பார்த்து, ‘நீ என் தாய்’ அல்லது ‘என் சகோதரி’ என்றும் சொல்லியிருந்தால்,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என் நம்பிக்கை எங்கே?","poem":1},{"text":"யாராவது அதைக் கண்டுபிடிக்க முடியுமா?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"என் நம்பிக்கை என்னுடன் பாதாளத்திற்கு வருமோ?","poem":1},{"text":"அதனுடன் நானும் ஒன்றாக தூசிக்குள் இறங்குவேனோ?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}