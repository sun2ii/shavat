{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":18,"content":[{"type":"heading","content":["பில்தாத் பேசுதல்"]},{"type":"verse","number":1,"content":["அப்பொழுது சூகியனான பில்தாத் மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“நீ எப்பொழுது இந்தப் பேச்சுக்களை நிறுத்துவாய்?","poem":1},{"text":"நிதானமாயிரு, அப்பொழுது நாங்கள் பேசுவோம்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உன் பார்வையில் நாங்கள் மிருகங்களைப்போல கருதப்பட்டு","poem":1},{"text":"மதியீனர்களாய் எண்ணப்படுவது ஏன்?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உன் கோபத்தில் உன்னையே காயப்படுத்துகிறவனே,","poem":1},{"text":"உனக்காக பூமி கைவிடப்படுமோ?","poem":2},{"lineBreak":true},{"text":"பாறை தன் இடத்தைவிட்டு நகருமோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“கொடியவனின் விளக்கு அணைக்கப்படுகிறது;","poem":1},{"text":"அவனுடைய நெருப்புச் சுவாலையும் எரியாமல் போகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவனுடைய கூடார வெளிச்சம் இருளாகிறது;","poem":1},{"text":"அவனுடைய விளக்கும் அணைந்து போகிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவனுடைய நடையின் கம்பீரம் பலவீனமடைகிறது;","poem":1},{"text":"அவனுடைய சுயதிட்டங்கள் அவனைக் கீழே வீழ்த்துகின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவன் தன் கால்களினால் வலையில் பிடிபட்டு,","poem":1},{"text":"அந்த வலையின் சிக்கலிலே நடக்கிறான்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"பொறி அவன் குதிகாலைப் பிடிக்கிறது;","poem":1},{"text":"கண்ணி","poem":2},{"noteId":1},{"text":"அவனை இறுக்கிப் பிடிக்கிறது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"சுருக்கு அவனுக்காகத் தரையிலும்,","poem":1},{"text":"பொறி அவன் பாதையிலும் மறைத்து வைக்கப்பட்டிருக்கிறது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எப்பக்கத்திலும் பயங்கரங்கள் அவனைத் திடுக்கிடப்பண்ணி,","poem":1},{"text":"அவன் கால்களை அலையவைக்கும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பேரழிவு அவனுக்காக காத்திருக்கிறது;","poem":1},{"text":"பெருங்கேடு அவன் விழும்போது ஆயத்தமாக இருக்கிறது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"வியாதி அவன் தோலைத் தின்கிறது;","poem":1},{"text":"சாவின் முதற்பேறு அவன் அங்கங்களை விழுங்குகிறது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவன் தன் கூடாரத்தின் பாதுகாப்பிலிருந்து பிடுங்கப்பட்டு,","poem":1},{"text":"பயங்கரங்களின் அரசனிடம் கொண்டுபோகப்படுகிறான்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவனுடைய கூடாரத்தில் நெருப்பு குடியிருக்கும்;","poem":1},{"text":"அவனுடைய உறைவிடங்களில் கந்தகம் வாரி இறைக்கப்படும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"கீழே அவனுடைய வேர்கள் காய்ந்து போகின்றன;","poem":1},{"text":"மேலே அவனுடைய கிளைகள் வாடிப்போகின்றன.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவனைப் பற்றிய நினைவு பூமியிலிருந்து அற்றுப்போகிறது;","poem":1},{"text":"மண்ணில் அவனுக்குப் பெயர் இல்லாதிருக்கிறது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவன் வெளிச்சத்திலிருந்து இருளுக்குள் தள்ளப்படுகிறான்;","poem":1},{"text":"உலகத்திலிருந்தும் துரத்தப்படுகிறான்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவனுடைய மக்கள் மத்தியில் அவனுக்கு சந்ததிகளே இல்லை,","poem":1},{"text":"அவன் வாழ்ந்த இடத்தில் மீதியாயிருப்பவன் ஒருவனும் இல்லை.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவன் முடிவைக்கண்டு மேற்கிலுள்ளோர் நடுங்கினர்;","poem":1},{"text":"அவன் காலத்திற்கு பின்பு வாழ்ந்த கிழக்கிலுள்ளோர் திகிலுற்றனர்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"தீயவனின் குடியிருப்பு இத்தகையதே;","poem":1},{"text":"இறைவனை அறியாதவனின் இருப்பிடமும் இத்தகையதே.”","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"கண்ணி அல்லது கொள்ளையர்கள் அவனை மேற்கொள்வார்கள்.","reference":{"chapter":18,"verse":9}}]},"thisChapterLink":"/api/tam_tcv/JOB/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/17.json","previousChapterAudioLinks":{},"numberOfVerses":21}