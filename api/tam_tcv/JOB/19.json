{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":19,"content":[{"type":"heading","content":["யோபு பேசுதல்"]},{"type":"verse","number":1,"content":["அதற்கு யோபு மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“எவ்வளவு காலத்திற்கு என்னை வேதனைப்படுத்தி,","poem":1},{"text":"வார்த்தைகளினால் என்னை நொறுக்குவீர்கள்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இப்பொழுது பத்துமுறை நீங்கள் என்னை நிந்தித்திருக்கிறீர்கள்;","poem":1},{"text":"வெட்கமின்றி என்னைத் தாக்கிப் பேசுகிறீர்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் வழி தவறியது உண்மையானால்,","poem":1},{"text":"என் தவறு என்னை மட்டுமே சாரும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீங்கள் உண்மையிலேயே உங்களை எனக்கு மேலாக உயர்த்தி,","poem":1},{"text":"நான் சிறுமையாக்கப்பட்டதை எனக்கு விரோதமாக உபயோகித்தாலும்,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இறைவனே எனக்குத் தவறிழைத்து,","poem":1},{"text":"என்னைச் சுற்றி வலை வீசியிருக்கிறார் என்பதை அறிந்துகொள்ளுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“இதோ, ‘கொடுமை!’ என நான் அழுதபோதிலும் எனக்குப் பதில் கிடைக்கவில்லை;","poem":1},{"text":"நான் கூக்குரலிட்டாலும் நீதி கிடைக்கவில்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் கடந்துசெல்லாதபடி அவர் என் வழியைத் தடைசெய்து,","poem":1},{"text":"என் பாதைகளை இருளாக்கினார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் என் மேன்மையை என்னைவிட்டு அகற்றி,","poem":1},{"text":"மகுடத்தை என் தலையிலிருந்து எடுத்துப்போட்டார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் என்னை எல்லாப் பக்கத்திலும் உடைத்து, அற்றுப்போகச் செய்கிறார்;","poem":1},{"text":"அவர் என் நம்பிக்கையை ஒரு மரத்தைப்போல பிடுங்குகிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவருடைய கோபம் எனக்கெதிராக எரிகிறது;","poem":1},{"text":"என்னைத் தம் பகைவரில் ஒருவனாக எண்ணுகிறார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவருடைய படைகள் எனக்கெதிராக அணிவகுத்து,","poem":1},{"text":"அவர்கள் எனக்கு விரோதமாய் வழியை உண்டாக்கி,","poem":2},{"lineBreak":true},{"text":"என் கூடாரத்தைச் சுற்றி முற்றுகையிடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“அவர் என் சகோதரரை என்னிடமிருந்து தூரமாக்கினார்;","poem":1},{"text":"எனக்கு அறிமுகமானவர்களும் முழுவதுமாக என்னைவிட்டுப் பிரிந்துவிட்டார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"என் உறவினர்கள் என்னைவிட்டுப் போய்விட்டார்கள்;","poem":1},{"text":"என் சிநேகிதர்கள் என்னை மறந்துவிட்டார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என் விருந்தினரும், பணிப்பெண்களும் என்னை அந்நியராக எண்ணுகிறார்கள்;","poem":1},{"text":"அவர்கள் என்னை அயலாராகப் பார்க்கிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நான் என் வேலைக்காரனைக் கூப்பிட்டு, என் வாயினால் கெஞ்சினாலும்,","poem":1},{"text":"அவன் எனக்குப் பதிலளிப்பதில்லை.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"என் மூச்சு என் மனைவிக்கே அருவருப்பாயிருக்கிறது;","poem":1},{"text":"நான் என் சொந்தக் குடும்பத்தினருக்கும்","poem":2},{"noteId":2},{"text":", வெறுப்பானேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"சிறுவர்களும் என்னை இகழ்கிறார்கள்;","poem":1},{"text":"நான் பேச எழும்போது அவர்கள் ஏளனம் செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"என் நெருங்கிய சிநேகிதர்கள் எல்லாரும் என்னை வெறுக்கிறார்கள்;","poem":1},{"text":"நான் நேசித்தவர்களும் எனக்கெதிரானார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நான் வெறும் எலும்பும் தோலுமாயிருக்கிறேன்;","poem":1},{"text":"நான் பற்களின் ஈறோடு தப்பியிருக்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“என் சிநேகிதர்களே, இரங்குங்கள், என்மீது இரக்கம் கொள்ளுங்கள்;","poem":1},{"text":"இறைவனின் கரமே என்னை அடித்திருக்கிறது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"இறைவனைப் போலவே நீங்களும் ஏன் என்னைத் தொடர்ந்து துன்புறுத்துகிறீர்கள்?","poem":1},{"text":"என்னை வேதனைப்படுத்தியது போதாதோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“ஆ, எனது வார்த்தைகள் எழுதப்பட்டு,","poem":1},{"text":"ஒரு புத்தகச்சுருளிலே பதிவுசெய்யப்பட்டால்,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவை இரும்பு ஆணியினால் ஈயத்தகட்டில் எழுதப்பட்டால்,","poem":1},{"text":"அல்லது என்றும் நிலைக்கும்படி, கற்பாறையில் செதுக்கப்பட்டால் நலமாயிருக்கும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"என் மீட்பர் உயிரோடிருக்கிறார் என்றும்,","poem":1},{"text":"கடைசி நாளில் அவர் பூமியின்மேல் நிற்பார் என்றும் அறிவேன்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"என் தோல் அழிந்துபோன பின்னும்,","poem":1},{"text":"நான் என் உடலில் இறைவனைக் காண்பேன்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நானே அவரை என் சொந்தக் கண்களால் காண்பேன்;","poem":1},{"text":"வேறொருவன் அல்ல, நானே காண்பேன்.","poem":2},{"lineBreak":true},{"text":"என் உள்ளம் அதற்காக எனக்குள்ளே எவ்வளவாய் ஏங்குகிறது!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ ‘இவன் கஷ்டத்திற்கான காரணம் இவனிலே இருக்கிறபடியால்,","poem":1},{"text":"நாம் இவனை எப்படி குற்றப்படுத்தலாம்?’ என்று நீங்கள் சொல்வீர்களானால்,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"நீங்களே வாளுக்குப் பயப்படவேண்டும்;","poem":1},{"text":"ஏனெனில், கடுங்கோபம் தண்டனையை வாளினாலேயே கொண்டுவரும்.","poem":2},{"lineBreak":true},{"text":"அப்பொழுது, நியாயத்தீர்ப்பு உண்டு என்பதை நீங்கள் அறிந்துகொள்வீர்கள்.”","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"குடும்பத்தினருக்கும் அல்லது என் பிள்ளைகளுக்கும்.","reference":{"chapter":19,"verse":17}}]},"thisChapterLink":"/api/tam_tcv/JOB/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}