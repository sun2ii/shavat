{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":20,"content":[{"type":"heading","content":["சோப்பார் பேசுதல்"]},{"type":"verse","number":1,"content":["அதற்கு நாகமாத்தியனான சோப்பார் மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“நான் மிகவும் கலக்கம் அடைந்திருக்கிறபடியால்,","poem":1},{"text":"என் சிந்தனை மறுமொழிக்கூற என்னைத் தூண்டுகிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என்னை அவமதிக்கும் கண்டனத்தை நான் கேட்கிறேன்;","poem":1},{"text":"என் உள்ளுணர்வு என்னைப் பதிலளிக்கும்படி ஏவுகின்றது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“மனிதன் பூமியில் தோன்றிய பூர்வகாலத்திலிருந்து,","poem":1},{"text":"எவ்வாறு இருந்தது என்பது உனக்கு நிச்சயமாய்த் தெரியும்:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கொடியவர்களின் சந்தோஷம் குறுகியகாலம்,","poem":1},{"text":"இறைவனை மறுதலிக்கிறவனின் மகிழ்ச்சி நொடிப்பொழுது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இறைவனற்றவனின் பெருமை வானங்களை எட்டினாலும்,","poem":1},{"text":"அவனுடைய தலை மேகங்களைத் தொட்டாலும்,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவன் உரம் போல அழிந்தே போவான்;","poem":1},{"text":"அவனை முன்பு கண்டவர்கள், ‘அவன் எங்கே?’ என்று கேட்பார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஒரு கனவைப்போல் அவன் பறந்துபோய், இனி ஒருபோதும் காணப்படமாட்டான்;","poem":1},{"text":"இரவில் தோன்றும் தரிசனத்தைப்போல் மறைந்துபோகிறான்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவனைப் பார்த்த கண் மீண்டும் அவனைப் பார்க்காது;","poem":1},{"text":"அவனுடைய இருப்பிடமும் இனி அவனைக் காணாது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவனுடைய பிள்ளைகள் ஏழைகளின் தயவை நாடுவார்கள்;","poem":1},{"text":"அவனுடைய","poem":2},{"noteId":3},{"text":"கைகள் அவனுடைய செல்வத்தைத் திருப்பிக் கொடுக்கவேண்டும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவனுடைய எலும்புகளில் நிரம்பியிருக்கிற இளமையின் வலிமை,","poem":1},{"text":"அவனுடன் தூசியில் கிடக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“தீமை இறைவனற்றவனின் வாயில் இனிமையாயிருந்தாலும்,","poem":1},{"text":"அவன் அதைத் தன் நாவின்கீழ் மறைத்து வைக்கிறான்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அதை விட்டுவிட மனமில்லாமல்","poem":1},{"text":"தன் வாயில் வைத்திருக்கிறான்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஆனாலும் அவனுடைய உணவு அவன் வயிற்றுக்குள் புளிப்பாக மாறி,","poem":1},{"text":"அவனுக்குள் பாம்பின் விஷம் போலாகிவிடும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவன் தான் விழுங்கிய செல்வத்தை வெளியே துப்பிவிடுவான்;","poem":1},{"text":"இறைவன் அவனுடைய வயிற்றிலிருந்து அதை வெளியேறும்படி செய்வார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவன் பாம்புகளிலிருந்து நஞ்சை உறிஞ்சுவான்;","poem":1},{"text":"விரியன் பாம்பின் நச்சு அவனைக் கொன்றுவிடும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"தேனும் வெண்ணெயும் ஓடும் ஆறுகளிலும்,","poem":1},{"text":"நீரோடைகளிலும் அவன் இன்பம் காணமாட்டான்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவன் தான் கஷ்டப்பட்டு உழைத்ததை உண்ணாமலே திருப்பிக் கொடுக்கவேண்டும்;","poem":1},{"text":"அவன் தன் வியாபாரத்தின் இலாபத்தையும் அனுபவிப்பதில்லை.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவன் ஏழைகளை ஒடுக்கி, அநாதைகளாக்கினான்;","poem":1},{"text":"தான் கட்டாத வீடுகளைக் கைப்பற்றிக்கொண்டான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“நிச்சயமாகவே இறைவனற்றவனுடைய ஆசைக்கு அளவேயில்லை;","poem":1},{"text":"ஆதலால், தான் இச்சித்த பொக்கிஷங்களில் எதுவும் மீந்துவதில்லை.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவன் விழுங்குவதற்கும் ஒன்றும் மீதமில்லை;","poem":1},{"text":"அவனுடைய செழிப்பும் நிலைக்காது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவனுடைய நிறைவின் மத்தியில் துயரம் அவனை மேற்கொள்ளும்;","poem":1},{"text":"அவலத்தின் கொடுமை முழுமையாய் அவன்மேல் வரும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவன் வயிறு நிரம்பும்போது,","poem":1},{"text":"இறைவன் தமது கடுங்கோபத்தை அவன்மேல் வரப்பண்ணி,","poem":2},{"lineBreak":true},{"text":"அடிமேல் அடியாக அவனை வாதிப்பார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவன் இரும்பு ஆயுதத்திற்குத் தப்பி ஓடினாலும்,","poem":1},{"text":"வெண்கல முனையுள்ள அம்பு அவனைக் குத்துகிறது.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவன் அதைத் தன் முதுகிலிருந்தும்,","poem":1},{"text":"அதின் மினுங்கும் நுனியைத் தன் ஈரலிலிருந்தும் இழுத்தெடுக்கிறான்.","poem":2},{"text":"பயங்கரங்கள் அவனை ஆட்கொள்கின்றன;","poem":1}]},{"type":"verse","number":26,"content":[{"text":"அவனுடைய பொக்கிஷங்கள் காரிருளில் கிடக்கும்.","poem":2},{"text":"அணையாத நெருப்பு அவனைச் சுட்டெரித்து,","poem":1},{"text":"அவனுடைய கூடாரத்தில் மீதியாயிருப்பதையும் விழுங்கிப்போடும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"வானங்கள் அவன் குற்றங்களை வெளிப்படுத்தும்;","poem":1},{"text":"பூமி அவனுக்கெதிராக எழும்பும்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவனுடைய வீட்டின் செல்வம் போய்விடும்;","poem":1},{"text":"இறைவனுடைய கோபத்தின் நாளிலே, அதை வெள்ளம் அள்ளிக்கொண்டுபோகும்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"கொடியவர்களுக்கு இறைவன் நியமித்த பலன் இதுவே;","poem":1},{"text":"இறைவனால் அவர்களுக்கு நியமிக்கப்பட்ட பங்கும் இதுவே.”","poem":2}]}],"footnotes":[{"noteId":3,"caller":"+","text":"அவனுடைய பிள்ளைகளின் கைகள்.","reference":{"chapter":20,"verse":10}}]},"thisChapterLink":"/api/tam_tcv/JOB/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/19.json","previousChapterAudioLinks":{},"numberOfVerses":29}