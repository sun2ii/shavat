{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":21,"content":[{"type":"heading","content":["யோபு பேசுதல்"]},{"type":"verse","number":1,"content":["அப்பொழுது யோபு மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“என்னுடைய வார்த்தைகளைக் கவனமாய்க் கேளுங்கள்;","poem":1},{"text":"இது நீங்கள் எனக்குக் கொடுக்கும் ஆறுதலாயிருக்கட்டும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் பேசும்வரை பொறுத்திருங்கள்,","poem":1},{"text":"நான் பேசினபின்பு நீங்கள் என்னைக் கேலி செய்யலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“நான் முறையிடுவது மனிதனிடமோ?","poem":1},{"text":"நான் ஏன் பொறுமையற்றவனாய் இருக்கக்கூடாது?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என்னைப் பார்த்து வியப்படையுங்கள்;","poem":1},{"text":"கையினால் உங்கள் வாயைப் பொத்திக்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் இவற்றை நினைக்கும்போது பயப்படுகிறேன்;","poem":1},{"text":"என் உடல் நடுங்குகிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கொடியவர்கள் முதுமையடைந்தும்,","poem":1},{"text":"வலியோராய் வாழ்ந்து கொண்டிருப்பது ஏன்?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்களோடே அவர்களின் பிள்ளைகள் அவர்களுக்கு முன்பாகவே,","poem":1},{"text":"அவர்கள் சந்ததி அவர்கள் கண்முன்னே நிலைத்திருப்பதைக் காண்கிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களுடைய வீடுகள் பயமின்றிப் பாதுகாப்பாய் இருக்கின்றன;","poem":1},{"text":"இறைவனின் தண்டனைக்கோல் அவர்கள்மேல் இல்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்களுடைய காளைகள் இனப்பெருக்கத்தில் தவறுவதில்லை;","poem":1},{"text":"பசுக்கள் சினையழியாமல் கன்றுகளை ஈனும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் தங்கள் பிள்ளைகளை மந்தையைப்போல் வெளியே அனுப்புகிறார்கள்;","poem":1},{"text":"அவர்களுடைய சிறுபிள்ளைகள் குதித்து ஆடுகிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்கள் தம்புரா, யாழ் ஆகியவற்றின் இசைக்கேற்ப பாடுகிறார்கள்;","poem":1},{"text":"புல்லாங்குழல் இசையில் அவர்கள் களிப்படைகிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் தங்கள் வாழ்நாட்களை மிகச் செழிப்பாகக் கழிப்பதோடு","poem":1},{"text":"கல்லறைக்கும் சமாதானத்தோடே","poem":2},{"noteId":4},{"text":"செல்கிறார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"இருந்தும் அவர்கள் இறைவனிடம், ‘எங்களை விட்டுவிடும்!","poem":1},{"text":"உமது வழிகளை அறிய நாங்கள் விரும்பவில்லை.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"எல்லாம் வல்லவருக்கு நாம் பணிசெய்ய அவர் யார்?","poem":1},{"text":"அவருக்கு ஜெபம் செய்வதினால் நமக்கு பலன் என்ன?’ என்கிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆனால் அவர்களுடைய செல்வம் அவர்கள் கைகளில் இல்லை;","poem":1},{"text":"நான் கொடியவர்களின் ஆலோசனையிலிருந்து விலகி நிற்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“எத்தனை முறை கொடியவர்களுடைய விளக்கு அணைக்கப்படுகிறது?","poem":1},{"text":"எத்தனை முறை பொல்லாப்பு அவர்கள்மேல் வருகிறது?","poem":2},{"lineBreak":true},{"text":"இறைவன் தமது கோபத்தில் அவர்களுக்கு தண்டனையை ஒதுக்கி வைத்திருக்கிறார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்கள் காற்றுக்குமுன் வைக்கோலைப்போலவும்,","poem":1},{"text":"புயலுக்கு முன்னே பதரைப்போலவும் அள்ளிக்கொண்டு போகப்படுகிறார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"‘இறைவன் அவர்களுக்குரிய தண்டனைகளை","poem":1},{"text":"அவர்கள் பிள்ளைகளுக்கு சேர்த்துவைக்கிறார்’ என்று சொல்லப்படுகிறதே;","poem":2},{"lineBreak":true},{"text":"அவர் அவர்களையே தண்டித்து உணர்த்துவார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்களின் அழிவை அவர்களின் கண்கள் காணும்,","poem":1},{"text":"எல்லாம் வல்லவரின் கடுங்கோபத்தை அனுபவிப்பார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஏனெனில், அவர்களுடைய மாதங்களின் எண்ணிக்கை குறையும்போது,","poem":1},{"text":"அவர்கள் விட்டுச்செல்லும் குடும்பத்தைப்பற்றி அவர்களுக்கு அக்கறை என்ன?","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“உயர்ந்தவர்களையும் நியாயந்தீர்க்கிற இறைவனுக்கு","poem":1},{"text":"அறிவைப் போதிக்க முடியுமா?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஒரு மனிதன் பூரண பாதுகாப்புடனும், சுகத்துடனும்,","poem":1},{"text":"முழு வலிமையுடனும் இருக்கையிலேயே சாகிறான்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவனுடைய உடல் ஊட்டம் பெற்று,","poem":1},{"text":"எலும்புகள் மச்சைகளால் நிறைந்திருக்கின்றன.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"இன்னொருவன் ஒருபோதுமே நன்மை ஒன்றையும்","poem":1},{"text":"அனுபவிக்காமல் ஆத்துமக் கசப்புடன் சாகிறான்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"இருவருமே தூசியில் ஒன்றாய்க் கிடக்கிறார்கள்;","poem":1},{"text":"புழுக்கள் அவர்கள் இருவரையுமே மூடுகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“நீங்கள் என்ன யோசிக்கிறீர்கள் என்பதை நான் நன்கு அறிவேன்;","poem":1},{"text":"என்னைக் குற்றஞ்சாட்டுவதற்கு நீங்கள் போடும் திட்டங்களையும் நான் அறிவேன்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"‘பெரிய மனிதனின் வீடு எங்கே? கொடியவர்களின் கூடாரங்கள் எங்கே?’","poem":1},{"text":"என்று கேட்கிறீர்கள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"பயணம் செய்தவர்களிடம் நீங்கள் ஒருபோதும் கேட்கவில்லையோ?","poem":1},{"text":"அவர்கள் கண்டுரைத்த விவரங்களை நீங்கள் கவனிக்கவில்லையோ?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"தீயவன் பொல்லாப்பின் நாளிலிருந்து விடுவிக்கப்படுகிறான்;","poem":1},{"text":"கடுங்கோபத்தின் நாளிலிருந்து அவன் விடுதலையாக்கப்படுகிறான்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"அவன் நடத்தையை அவன் முகத்துக்கு முன்பாகக் கண்டிப்பவன் யார்?","poem":1},{"text":"அவன் செய்தவற்றிற்கேற்ப அவனுக்கு எதிர்ப்பழி செய்பவன் யார்?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அவன் குழிக்குள் கொண்டுசெல்லப்படுகிறான்.","poem":1},{"text":"அவனுடைய கல்லறைக்குக் காவலும் வைக்கப்படுகிறது.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"பள்ளத்தாக்கின் மண் அவனுக்கு இன்பமாயிருக்கிறது;","poem":1},{"text":"எல்லா மனிதரும் அவனுக்குப்பின் செல்கிறார்கள்,","poem":2},{"lineBreak":true},{"text":"எண்ணில்லா திரள்கூட்டம் அவன்முன் செல்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“வீண் பேச்சினால் நீங்கள் எப்படி என்னை ஆறுதல்படுத்துவீர்கள்?","poem":1},{"text":"உங்கள் பதில்களில் வஞ்சனையைத் தவிர வேறொன்றுமில்லை!”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"சமாதானத்தோடே அல்லது நொடிப்பொழுதில்","reference":{"chapter":21,"verse":13}}]},"thisChapterLink":"/api/tam_tcv/JOB/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/20.json","previousChapterAudioLinks":{},"numberOfVerses":34}