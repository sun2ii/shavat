{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":22,"content":[{"type":"heading","content":["எலிப்பாஸ் பேசுதல்"]},{"type":"verse","number":1,"content":["அதற்கு தேமானியனான எலிப்பாஸ் மறுமொழியாக சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“மனிதனால் இறைவனுக்குப் பயன் ஏதும் உண்டோ?","poem":1},{"text":"ஞானவானாலும் அவருக்கு பயன் உண்டோ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீ நீதிமானாய் இருந்திருந்தாலும்,","poem":1},{"text":"எல்லாம் வல்லவருக்கு அது மகிழ்ச்சி அளிக்குமோ?","poem":2},{"lineBreak":true},{"text":"உன் வழிகள் குற்றமற்றவையாய் இருந்தாலும் அதினால் அவருக்கு இலாபம் என்ன?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“அவர் உன்னைக் கடிந்துகொண்டு,","poem":1},{"text":"உனக்கு எதிராகக் குற்றம் சாட்டுவது உன் பக்தியின் காரணமாகவோ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உன் கொடுமை பெரிதானதல்லவோ?","poem":1},{"text":"உன் பாவங்கள் முடிவில்லாதவை அல்லவோ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீ காரணமின்றி உனது சகோதரரின் அடகுப்பொருளை வற்புறுத்திக் கேட்டு,","poem":1},{"text":"ஏழைகளின் உடைகளைப் பறித்துக்கொண்டாய்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நீ களைத்தவனுக்குத் தண்ணீர் கொடுக்கவில்லை;","poem":1},{"text":"பசித்தவனுக்கும் உணவு கொடுக்காமல் போனாய்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீ நிலத்திற்கு உரிமையாளன்.","poem":1},{"text":"மதிப்புக்குரியவனாய் வாழ்ந்திருந்தபோதும் இப்படி செய்தாய்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீ விதவைகளை வெறுங்கையுடன் அனுப்பினாய்;","poem":1},{"text":"அனாதைப் பிள்ளைகளின் பெலனை ஒடித்தாய்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அதினால்தான் கண்ணிகள் உன்னைச் சுற்றிலுமிருக்கின்றன;","poem":1},{"text":"திடீரென வரும் துன்பம் உன்னைத் திகிலூட்டுகிறது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அதினால்தான் நீ பார்க்க முடியாத அளவு இருளாகவும் இருக்கிறது;","poem":1},{"text":"வெள்ளமும் உன்னை மூடுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“வானத்தின் உன்னதங்களில் அல்லவோ இறைவன் இருக்கிறார்?","poem":1},{"text":"மேலேயுள்ள நட்சத்திரங்களைப் பார்; அவை எவ்வளவு உயரத்தில் இருக்கின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அப்படியிருந்தும் நீ, ‘இறைவனுக்கு என்ன தெரியும்?","poem":1},{"text":"இப்படிப்பட்ட இருளின்வழியே அவர் நியாயந்தீர்க்கிறாரோ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"வானமண்டலங்களில் அவர் உலாவுகையில் அடர்ந்த மேகங்கள் அவரை மூடுகின்றன;","poem":1},{"text":"அதினால் அவர் எங்களைக் காண்கிறதில்லை’ என்கிறாய்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"தீய மனிதர் சென்ற","poem":1},{"text":"பழைய பாதையில் நீயும் நடப்பாயோ?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர்கள் தங்கள் காலம் வருமுன்பே இறந்துபோனார்கள்;","poem":1},{"text":"அவர்களுடைய அஸ்திபாரத்தின்மேல் வெள்ளம் புரண்டது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர்கள் இறைவனிடம், ‘நீர் எங்களை விட்டுவிடும்!","poem":1},{"text":"எல்லாம் வல்லவரால் எங்களுக்கு என்ன ஆகும்?’ என்றார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"இருப்பினும், அவர் அவர்களை நன்மைகளால் நிரப்பினார்;","poem":1},{"text":"நான் கொடியவரின் ஆலோசனைக்கு விலகி நிற்கிறேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர்களின் அழிவைக் கண்டு நேர்மையானவர்கள் மகிழ்கிறார்கள்;","poem":1},{"text":"குற்றமற்றவர்கள் அவர்களைக் கேலிபண்ணி,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘பகைவர்கள் அழிய,","poem":1},{"text":"நெருப்பு செல்வத்தைச் சுட்டது’ என்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“இறைவனுக்குப் பணிந்து அவருடன் சமாதானமாயிரு;","poem":1},{"text":"உனக்குச் செழிப்பு உண்டாகும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவர் வாயிலிருந்து வரும் அறிவுறுத்தல்களை ஏற்றுக்கொள்.","poem":1},{"text":"அவருடைய வார்த்தைகளை உன் இருதயத்தில் பதித்துக்கொள்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நீ கொடுமையை உன் கூடாரத்தைவிட்டு அகற்றி,","poem":1},{"text":"எல்லாம் வல்லவரிடத்தில் திரும்பினால்,","poem":2},{"lineBreak":true},{"text":"உன் பழைய நிலைமையை அடைவாய்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நீ தூளைப்போல் பொன்னையும்,","poem":1},{"text":"ஆற்றுக் கற்களைப்போல் ஓப்பீரின் தங்கத்தையும் எண்ணிக்கொள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அப்பொழுது எல்லாம் வல்லவரே உனது தங்கமாகவும்,","poem":1},{"text":"உனக்குரிய சிறந்த வெள்ளியாகவும் இருப்பார்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அப்பொழுது, நீ நிச்சயமாய் எல்லாம் வல்லவரில் மகிழ்ச்சிகொண்டு,","poem":1},{"text":"இறைவனை நோக்கி உன் முகத்தை உயர்த்துவாய்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நீ அவரிடம் வேண்டுதல் செய்யும்போது, அவர் உனக்குச் செவிகொடுப்பார்;","poem":1},{"text":"நீ பொருத்தனைகளையும் நிறைவேற்றுவாய்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நீ தீர்மானிப்பது செய்யப்படும்,","poem":1},{"text":"உன் வழிகளிலும் ஒளி பிரகாசிக்கும்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"மனிதர் தாழ்த்தப்படும்போது நீ அவரிடம், ‘அவர்களை உயர்த்தும்’","poem":1},{"text":"என்று சொன்னால், அவர் தாழ்ந்தோரைக் காப்பாற்றுவார்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவர் குற்றமுள்ளவனையும்கூட விடுவிப்பார்;","poem":1},{"text":"உன் கைகளின் தூய்மையின் நிமித்தம் அவன் விடுவிக்கப்படுவான்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/21.json","previousChapterAudioLinks":{},"numberOfVerses":30}