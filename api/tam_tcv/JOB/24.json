{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":24,"content":[{"type":"verse","number":1,"content":[{"text":"“எல்லாம் வல்லவர் நியாயந்தீர்க்கும் காலத்தை மறைத்திருப்பது ஏன்?","poem":1},{"text":"அவரை அறிந்தவர்கள் அந்நாட்களுக்காக வீணாய்க் காத்திருப்பதும் ஏன்?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மனிதர் எல்லைக் கற்களைத் தள்ளிவைக்கிறார்கள்;","poem":1},{"text":"அவர்கள் திருடிய மந்தைகளையே அவர்கள் மேய்க்கிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அநாதைகளின் கழுதைகளை அவர்கள் துரத்திவிடுகிறார்கள்;","poem":1},{"text":"விதவைகளின் எருதை ஈட்டுப் பொருளாக வாங்குகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் தேவையுள்ளவர்களை வழியிலிருந்து தள்ளிவிடுகிறார்கள்;","poem":1},{"text":"அவர்களுடைய வன்முறையால் நாட்டிலுள்ள ஏழைகளை ஒழியப்பண்ணுகிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"காட்டுக் கழுதை பாலைவனத்தில் அலைவதுபோல்,","poem":1},{"text":"ஏழைகள் உணவு தேடி அலைகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் பிள்ளைகளுக்குப் பாழ்நிலம் உணவளிக்கின்றது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வயல்வெளிகளில் அவர்கள் தங்கள் உணவைச் சேர்க்கிறார்கள்;","poem":1},{"text":"கொடியவர்களின் திராட்சைத் தோட்டத்தில் விடப்பட்டதை பொறுக்குகிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் போர்த்துக்கொள்ள உடையில்லாமல் இரவை கழிக்கிறார்கள்;","poem":1},{"text":"குளிரில் மூடிக்கொள்வதற்கு அவர்களிடம் ஒன்றுமே இல்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மலைகளிலிருந்து வரும் மழையினால் அவர்கள் நனைகிறார்கள்;","poem":1},{"text":"தங்குவதற்கு இடமின்றி பாறைகளில் மறைகிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தந்தையற்ற பிள்ளை தாயின் மார்பிலிருந்து பிடுங்கப்படுகிறது;","poem":1},{"text":"ஏழையின் குழந்தை கடனுக்காகக் கைப்பற்றப்படுகிறது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஏழைகள் உடையின்றி நடந்து,","poem":1},{"text":"அரிக்கட்டுகளைச் சுமந்து, பசியாகவே இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் தாகத்தால் செக்கு ஆட்டி, ஒலிவ எண்ணெயை எடுக்கிறார்கள்;","poem":1},{"text":"ஆலைகளில் திராட்சை இரசம் பிழிகிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"சாகிறவர்களின் அழுகை பட்டணத்திலிருந்து எழும்புகிறது,","poem":1},{"text":"காயப்பட்டவர்கள் உதவிவேண்டி கதறி அழுகிறார்கள்,","poem":2},{"lineBreak":true},{"text":"ஆனாலும் இறைவன் அவர்கள் மன்றாட்டைக் கேட்கவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“கொடியவர்கள் ஒளியை எதிர்த்துக் கலகம் செய்கிறார்கள்;","poem":1},{"text":"அவர்கள் ஒளியின் வழிகளை அறியாமலும்,","poem":2},{"lineBreak":true},{"text":"அதின் பாதைகளில் நிலைத்திராமலும் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பொழுது விடிகிறபோது கொலையாளி எழுந்து,","poem":1},{"text":"ஏழையையும் தேவை மிகுந்தவர்களையும் கொன்று,","poem":2},{"lineBreak":true},{"text":"இரவில் திருடனைப்போல் திரிகிறான்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"விபசாரம் செய்கிறவனின் கண்கள் மாலை மங்கும்வரை காத்திருக்கின்றன;","poem":1},{"text":"அவன், ‘என்னை ஒருவரும் பார்க்கமாட்டார்கள்’ என எண்ணி,","poem":2},{"lineBreak":true},{"text":"தன் முகத்தையும் மறைத்துக்கொள்கிறான்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"பகலில் அடையாளம் பார்த்த வீடுகளை","poem":1},{"text":"இரவில் கன்னமிடுகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"வெளிச்சத்தில் எதையும் செய்ய அவர்கள் விரும்புவதில்லை.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர்கள் எல்லோருக்கும் கடும் இருளே காலை நேரமாயிருக்கிறது;","poem":1},{"text":"இருளின் பயங்கரங்களுடன் அவர்கள் நட்பு வைக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“அவர்கள் தண்ணீரின் மேலுள்ள நுரையாயிருக்கிறார்கள்;","poem":1},{"text":"நாட்டில் அவர்களின் பங்கு சபிக்கப்பட்டிருப்பதினால்,","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய திராட்சைத் தோட்டத்திற்கு ஒருவரும் போவதில்லை.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"வெப்பமும் வறட்சியும் உருகிய உறைபனியை பறித்துக்கொள்வதுபோல,","poem":1},{"text":"பாதாளமும் பாவிகளை பறித்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்களைப் பெற்றெடுத்த கர்ப்பம் அவர்களை மறந்துவிடும்,","poem":1},{"text":"புழுக்கள் அவர்களை விருந்தாக உண்ணும்.","poem":2},{"text":"தீய மனிதர் இனி ஒருபோதும் நினைக்கப்படுவதில்லை,","poem":1},{"text":"மரத்தைப்போல் அவர்கள் முறிக்கப்படுகிறார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர்கள் பிள்ளையில்லாத மலடியின் சொத்தைப் பட்சிக்கிறார்கள்,","poem":1},{"text":"விதவைக்கும் இரக்கம் காட்டுவதில்லை.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"இறைவன் தன் வல்லமையினால் வலிமையானோரை வீழ்த்துகிறார்;","poem":1},{"text":"அவர்கள் நிலைபெற்றிருந்தாலும், வாழ்வின் நிச்சயம் அவர்களுக்கு இல்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"இறைவன் அவர்களைப் பாதுகாப்புணர்வுடன் இருக்கவிட்ட போதிலும்,","poem":1},{"text":"அவருடைய கண்களோ அவர்களைப் பார்த்துக்கொண்டேயிருக்கின்றன.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"சிறிது காலத்திற்கு உயர்த்தப்படுகிறார்கள், பின்பு இல்லாமல் போகிறார்கள்.","poem":1},{"text":"அவர்கள் தாழ்த்தப்பட்டு, மற்றவர்களைப் போல சேர்க்கப்படுகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"தானியக்கதிர்கள் வெட்டப்படுவதுபோல் வெட்டப்படுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“இது இப்படியில்லாவிட்டால், நான் பொய்யன் என நிரூபித்து,","poem":1},{"text":"என் வார்த்தைகளை வீண் என்று யார் சொல்லமுடியும்?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/23.json","previousChapterAudioLinks":{},"numberOfVerses":25}