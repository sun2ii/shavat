{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":25,"content":[{"type":"heading","content":["பில்தாத் பேசுதல்"]},{"type":"verse","number":1,"content":["அப்பொழுது சூகியனான பில்தாத் மறுமொழியாக சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“ஆளுகையும், பிரமிக்கத்தக்க பயமும் இறைவனுக்கே உரியது;","poem":1},{"text":"அவரே பரலோகத்தின் உயரங்களில் சமாதானத்தை நிலைநாட்டுகிறவர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவருடைய படைவீரர்களை எண்ணமுடியுமோ?","poem":1},{"text":"அவருடைய ஒளி யார்மேல் உதிக்காமல் இருக்கிறது?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அப்படியிருக்க ஒரு மனிதன் இறைவனுக்கு முன்பாக நேர்மையானவனாக நிற்பதெப்படி?","poem":1},{"text":"பெண்ணிடத்தில் பிறந்தவன் தூய்மையாய் இருப்பதெப்படி?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவருடைய பார்வையில் சந்திரன் பிரகாசம் இல்லாமலும்,","poem":1},{"text":"நட்சத்திரங்கள் தூய்மையற்றதாயும் இருக்கும்போது,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"பூச்சியாயிருக்கும் மனிதனும், புழுவாயிருக்கும்","poem":1},{"text":"மனுமகனும் எவ்வளவு அற்பமானவர்கள்!”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/24.json","previousChapterAudioLinks":{},"numberOfVerses":6}