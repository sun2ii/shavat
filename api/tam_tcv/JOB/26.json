{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["யோபு பேசுதல்"]},{"type":"verse","number":1,"content":["அதற்கு யோபு மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“பெலவீனமானவனுக்கு நீ எப்படி உதவினாய்?","poem":1},{"text":"தளர்ந்த கையை நீ எப்படித் தாங்கினாய்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஞானமில்லாத ஒருவனுக்கு நீ எப்படி புத்திமதி கூறி,","poem":1},{"text":"சிறந்த மெய்யறிவைக் காட்டியிருக்கிறாய்?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இந்த வார்த்தைகளைச் சொல்ல உனக்கு உதவியவர் யார்?","poem":1},{"text":"யாருடைய ஆவி உன் வாயிலிருந்து பேசிற்று?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“தண்ணீரின்கீழ் மடிந்தவர்களும் அவர்களோடே இருப்பவர்களும்,","poem":1},{"text":"இறந்தவர்களின் ஆவிகளும் பயந்து நடுங்குகின்றன.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"பாதாளம் இறைவனுக்குமுன் வெளியரங்கமாய் இருக்கிறது;","poem":1},{"text":"நரகம் திறந்திருக்கிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இறைவன் வெறுமையான வெளியில் வடதிசை வானங்களை விரிக்கிறார்,","poem":1},{"text":"அவர் பூமியை அந்தரத்திலே தொங்கவிடுகிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர் தண்ணீரைத் தம்முடைய மேகங்களில் சுற்றி வைக்கிறார்,","poem":1},{"text":"ஆனாலும் அவைகளின் பாரத்தால் மேகங்கள் கிழிந்து போவதில்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் சிங்காசனத்தின் மேற்பரப்பின் மேலாகத் தமது மேகத்தை விரித்து,","poem":1},{"text":"அதை மூடிவைக்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் தண்ணீரின் மேற்பரப்பில் அடிவானத்தை","poem":1},{"text":"ஒளிக்கும் இருளுக்கும் இடையிலுள்ள எல்லையாகக் குறிக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"வானத்தின் தூண்கள்,","poem":1},{"text":"அவருடைய கண்டனத்தால் திகைத்து நடுங்குகின்றன.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் தமது வல்லமையினால் கடலை அமர்த்துகிறார்,","poem":1},{"text":"தமது ஞானத்தினால் ராகாப் கடல் விலங்கைத் துண்டுகளாக வெட்டுகிறார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவருடைய சுவாசத்தினால் ஆகாயங்கள் அழகாயின;","poem":1},{"text":"அவருடைய கரம் நெளியும் பாம்பை ஊடுருவிக் குத்தியது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"இவை அவருடைய செயல்களில் வெளிப்புற விளிம்பு மட்டுமே;","poem":1},{"text":"அவரைப்பற்றி நாம் கேள்விப்பட்டது மிகக் கொஞ்சமே;","poem":2},{"lineBreak":true},{"text":"அப்படியானால் அவருடைய வல்லமையின் இடிமுழக்கத்தை விளங்கிக்கொள்பவன் யார்?”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}