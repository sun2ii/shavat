{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":27,"content":[{"type":"heading","content":["யோபுவின் நண்பர்களுக்கு அவருடைய இறுதி வார்த்தை"]},{"type":"verse","number":1,"content":["யோபு மேலும் தன் பேச்சைத் தொடர்ந்து சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“எனக்கு நீதியை மறுத்து,","poem":1},{"text":"வாழ்வைக் கசப்பாக்கின எல்லாம் வல்ல இறைவன் வாழ்வது நிச்சயம்போலவே,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எனக்குள் என் உயிரும்,","poem":1},{"text":"என் மூக்கில் இறைவனின் சுவாசமும் இருக்கும்வரை,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் உதடுகள் கொடுமையானதைப் பேசாது,","poem":1},{"text":"என் நாவு வஞ்சகமானவற்றைச் சொல்லாது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீங்கள் சொல்வது சரி என நான் ஒருபோதும் ஒத்துக்கொள்ளமாட்டேன்;","poem":1},{"text":"நான் சாகும்வரை என் உத்தமத்தை மறுக்கவுமாட்டேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"என் நேர்மையை நான் காத்துக்கொள்வேன், அதை நான் ஒருபோதும் விடமாட்டேன்;","poem":1},{"text":"நான் உயிரோடிருக்குமட்டும் என் மனசாட்சி என்னைக் கடிந்துகொள்ளாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“என் பகைவர் கொடியவர்களைப்போல் இருக்கட்டும்,","poem":1},{"text":"என் விரோதி அநீதியுள்ளவர்களைப்போல் இருக்கட்டும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"இறைவனை மறுதலிக்கிறவன் வெட்டுண்டுபோய்,","poem":1},{"text":"இறைவன் அவனுடைய உயிரை எடுத்துக்கொள்ளும்போது, அவனுடைய நம்பிக்கை என்ன?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவனுக்குத் துன்பம் வரும்போது","poem":1},{"text":"இறைவன் அவனுடைய கதறலைக் கேட்பாரோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எல்லாம் வல்லவரில் அவன் மகிழ்ச்சியடைவானோ?","poem":1},{"text":"எல்லா நேரங்களிலும் அவன் இறைவனைக் கூப்பிடுவானோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“இறைவனின் வல்லமையைக் குறித்து நான் உங்களுக்குப் போதிப்பேன்;","poem":1},{"text":"எல்லாம் வல்லவரின் வழிகளை நான் மறைக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இவற்றையெல்லாம் நீங்கள் பார்த்திருந்தும்","poem":1},{"text":"ஏன் இந்த வீண்பேச்சு?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“கொடியவனுக்கு இறைவனிடத்திலிருந்து கிடைக்கும் பங்கும்,","poem":1},{"text":"தீயவன் எல்லாம் வல்ல இறைவனிடமிருந்து பெறும் உரிமைச்சொத்தும் இதுவே:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவனுக்கு பிள்ளைகள் அநேகர் இருப்பார்கள்,","poem":1},{"text":"ஆனால் அவர்கள் வாளுக்கு இரையாவார்கள்;","poem":2},{"lineBreak":true},{"text":"அவனுடைய சந்ததியினருக்கு ஒருபோதும் போதியளவு உணவு கிடைக்காது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவனுக்கு மீதியானவர்கள் கொள்ளைநோய்க்குப் பலியாகும்போது,","poem":1},{"text":"அவர்களுடைய விதவைகள் அழமாட்டார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவன் வெள்ளியைப் தூசியைப்போலவும்,","poem":1},{"text":"உடைகளைக் களிமண் குவியலைப் போலவும் குவித்து வைத்தாலும்,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவன் குவித்து வைத்ததை நேர்மையானவர்கள் உடுத்துவார்கள்,","poem":1},{"text":"குற்றமற்றவர்கள் அவனுடைய வெள்ளியைப் பகிர்ந்துகொள்வார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவன் தன்னுடைய வீட்டை சிலந்தி பூச்சியின் கூட்டைப்போலவும்,","poem":1},{"text":"காவற்காரன் கட்டிய சிறுகுடிசையைப்போலவும் கட்டுகிறான்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவன் செல்வந்தனாக படுக்கைக்குப் போகிறான், ஆனால் தொடர்ந்து அப்படியிரான்;","poem":1},{"text":"அவன் தன் கண்களைத் திறக்கும்போது எல்லாமே போய்விடுகின்றன.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"பயங்கரங்கள் வெள்ளம்போல் அவனை மேற்கொள்கின்றன;","poem":1},{"text":"இரவில் பெரும்புயல் அவனை அள்ளிக்கொண்டுபோகிறது.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"கொண்டல் காற்று அவனை அடித்து செல்கிறது, அவன் காணாமல் போகிறான்;","poem":1},{"text":"அவன் இருப்பிடத்திலிருந்து அவனை வாரிக்கொண்டுபோகிறது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அது இரக்கமின்றி அவனை விரட்டும்;","poem":1},{"text":"இறைவனுடைய கைக்குத் தப்பியோட பார்ப்பார்கள்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"மக்கள் அவனைப் பார்த்துக் கைகொட்டி ஏளனம் செய்து,","poem":1},{"text":"அவனை அவனுடைய இடத்தைவிட்டு விரட்டிவிடுவார்கள்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/26.json","previousChapterAudioLinks":{},"numberOfVerses":23}