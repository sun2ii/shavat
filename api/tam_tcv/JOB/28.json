{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":28,"content":[{"type":"heading","content":["இடைவெளி: ஞானம் எங்கே காணப்படுகிறது"]},{"type":"verse","number":1,"content":[{"text":"வெள்ளிக்குச் சுரங்கமும்","poem":1},{"text":"தங்கத்திற்கு சுத்திகரிக்கும் இடமும் உண்டு.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இரும்பு பூமியிலிருந்து எடுக்கப்படுகிறது,","poem":1},{"text":"செம்பு கற்களில் உருக்கி எடுக்கப்படுகிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"மனிதன் இருளுக்கு முடிவுண்டாக்கி,","poem":1},{"text":"உலோக மூலப்பொருட்களைக் காரிருளிலும்","poem":2},{"lineBreak":true},{"text":"ஆழமான குழிகளிலும் தேடுகிறான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவன் மிகத் தொலைவில் சுரங்க வாசலை வெட்டுகிறான்,","poem":1},{"text":"காலடிகளே படாத,","poem":2},{"lineBreak":true},{"text":"மனித நடமாட்டம் இல்லாத ஆழத்தில் ஊசலாடித் தொங்குகிறான்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உணவு கொடுக்கும் பூமி","poem":1},{"text":"அதின் கீழ்ப்பகுதியிலுள்ளவை நெருப்பினால் உருமாறுகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அதின் பாறைகளிலிருந்து நீலக்கற்கள் விளைகின்றன,","poem":1},{"text":"அதின் தூசி தங்கத்துகள்களை உடையதாயிருக்கின்றது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இரைதேடும் ஒரு பறவைகூட அந்த மறைவான பாதையை அறியாது;","poem":1},{"text":"பருந்தின் கண்ணும் அதைக் காண்பதில்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"கொடிய மிருகங்கள் அங்கு அடியெடுத்து வைப்பதுமில்லை;","poem":1},{"text":"சிங்கம் அங்கு திரிவதுமில்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மனிதனின் கையே கடினமான பாறையைத் தாக்கி,","poem":1},{"text":"மலைகளின் அடிவாரங்களை வேரோடே புரட்டுகிறான்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவன் கன்மலையில் வாய்க்கால்களை வெட்டுகிறான்;","poem":1},{"text":"அவனுடைய கண்கள் அதின் பொக்கிஷங்களையெல்லாம் காண்கின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஆறுகளின் உற்பத்தியிடங்களை ஆராய்ந்து,","poem":1},{"text":"மறைந்திருக்கும் பொருட்களை வெளிச்சத்திற்குக் கொண்டுவருகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ஆனால் ஞானம் காணப்படுவது எங்கே?","poem":1},{"text":"விளங்கும் ஆற்றல் குடியிருப்பது எங்கே?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"மனிதன் அதின் மதிப்பைப் புரிந்துகொள்வதில்லை;","poem":1},{"text":"உயிர்வாழ்வோரின் நாட்டில் அதைக் காணமுடியாது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“அது என்னிடம் இல்லை” என ஆழம் சொல்கிறது;","poem":1},{"text":"“அது என்னுடன் இல்லை” என கடலும் கூறுகிறது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"சுத்தத் தங்கத்தைக் கொடுத்து, அதை வாங்கமுடியாது,","poem":1},{"text":"அதின் மதிப்பை வெள்ளியால் நிறுக்கவும் முடியாது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஓப்பீரின் தங்கமும், விலையேறப்பெற்ற கோமேதகமும், இந்திர நீலக்கல்லும்","poem":1},{"text":"அதற்கு ஈடல்ல.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"பொன்னும் பளிங்கும் அதற்கு இணையாகாது,","poem":1},{"text":"தங்க நகைகளைக் கொடுத்தும் அதைப் பெற்றுக்கொள்ள முடியாது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"பவளத்தையும் மரகதத்தையும் ஒரு பொருட்டாக எண்ண முடியாது;","poem":1},{"text":"ஞானத்தின் விலை மாணிக்கக் கற்களைவிட உயர்வானது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"எத்தியோப்பியாவின் புஷ்பராகம் அதற்கு நிகரல்ல;","poem":1},{"text":"சுத்தப் பொன்னால் அதை வாங்கமுடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"அப்படியானால் ஞானம் எங்கிருந்து வருகிறது?","poem":1},{"text":"விளங்கும் ஆற்றல் எங்கே குடியிருக்கிறது?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அது உயிருள்ள அனைவருக்கும்,","poem":1},{"text":"ஆகாயத்துப் பறவைகளுக்குங்கூட மறைக்கப்பட்டும் இருக்கிறது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"“இதைப் பற்றிய வதந்தி மட்டுமே எங்கள் காதுகளுக்கு எட்டின”","poem":1},{"text":"என்று அழிவும் சாவும் சொல்கின்றன.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அதின் வழி இறைவனுக்குத் தெரியும்;","poem":1},{"text":"அதின் குடியிருப்பை அவர் மட்டுமே அறிவார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஏனெனில் பூமியின் கடைமுனைகளை அவர் பார்க்கிறார்,","poem":1},{"text":"வானத்தின் கீழுள்ள ஒவ்வொன்றையும் அவர் காண்கிறார்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவர் காற்றின் பலத்தை நிலைநாட்டி,","poem":1},{"text":"தண்ணீர்களை அளந்தபோதும்,","poem":2}]},{"type":"verse","number":26,"content":[{"text":"மழைக்கு ஒரு நியமத்தை விதித்தபோதும்,","poem":1},{"text":"இடிமுழக்கத்தோடு கூடிய மின்னலுக்கு ஒரு பாதையை வகுத்தபோதும்,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவர் ஞானத்தைப் பார்த்து மதிப்பிட்டார்;","poem":1},{"text":"அதை உறுதிப்படுத்தி சோதித்தறிந்தார்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"இறைவன் மனிதனிடம்,","poem":1},{"text":"“யெகோவாவுக்கு பயந்து நடத்தலே ஞானம்,","poem":2},{"lineBreak":true},{"text":"தீமைக்கு விலகி நடப்பதே விளங்கும் ஆற்றல்” என்று சொன்னார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}