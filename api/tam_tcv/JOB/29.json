{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":29,"content":[{"type":"heading","content":["யோபுவின் முன்னைய நிலை"]},{"type":"verse","number":1,"content":["யோபு மேலும் தன் பேச்சைத் தொடர்ந்து சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“கடந்துபோன மாதங்களை, இறைவன் என்னைக் கண்காணித்த நாட்களை,","poem":1},{"text":"நான் எவ்வளவாய் விரும்புகிறேன்!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அந்நாட்களில் அவருடைய விளக்கு என் தலைமேல் பிரகாசித்தது;","poem":1},{"text":"அவருடைய ஒளியினால் நான் இருளில் நடந்தேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"வாலிப நாட்களில்,","poem":1},{"text":"இறைவனின் நெருங்கிய நட்பு என் வீட்டை ஆசீர்வதித்தது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"எல்லாம் வல்லவர் என்னோடு இருந்தார்,","poem":1},{"text":"என் பிள்ளைகளும் என்னைச் சூழ்ந்திருந்தார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"என் காலடிகள் வெண்ணெயால் கழுவப்பட்டது;","poem":1},{"text":"கற்பாறையிலிருந்து எனக்காக ஒலிவ எண்ணெய் ஊற்றெடுத்துப் பாய்ந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“அந்நாட்களில் நான் பட்டணத்தின் வாசலுக்குச் சென்று,","poem":1},{"text":"பொது இடத்தில் எனது இருக்கையில் அமரும்போது,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"வாலிபர்கள் என்னைக் கண்டு ஒதுங்கி நின்றார்கள்;","poem":1},{"text":"முதியவர்கள் எழுந்து நின்றார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அதிகாரிகள் பேச்சை நிறுத்திவிட்டு","poem":1},{"text":"தங்கள் கைகளால் வாயை மூடிக்கொண்டார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உயர்குடி மக்களின் குரல்களும் அடங்கின,","poem":1},{"text":"அவர்களுடைய நாவுகள் மேல்வாயோடு ஒட்டிக்கொண்டன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என்னைக் கேட்டவர்கள் என்னைப்பற்றி நன்றாக பேசினார்கள்,","poem":1},{"text":"என்னைக் கண்டவர்களும் என்னைப் பாராட்டினார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஏனெனில் உதவிக்காக அழுத ஏழைகளையும்,","poem":1},{"text":"உதவுவாரில்லாத தந்தையற்றவர்களையும் நான் காப்பாற்றினேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"செத்துக்கொண்டிருந்த மனிதன் என்னை ஆசீர்வதித்தான்;","poem":1},{"text":"நான் விதவையைத் தன் உள்ளத்தில் மகிழ்ந்து பாடச்செய்தேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் நேர்மையை என் உடையாக அணிந்திருந்தேன்;","poem":1},{"text":"நியாயம் என் அங்கியாகவும், தலைப்பாகையாகவும் அமைந்திருந்தது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் குருடனுக்குக் கண்களாயும்,","poem":1},{"text":"முடவனுக்குக் கால்களாயும் இருந்தேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நான் தேவையுள்ளோருக்கு தகப்பனாக இருந்து,","poem":1},{"text":"அறியாதவனின் வழக்கில் நான் அவனுக்கு உதவினேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நான் கொடியவர்களின் கூர்மையானப் பற்களை உடைத்து,","poem":1},{"text":"அவர்களின் பற்களில் சிக்குண்டவர்களை விடுவித்தேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“நான், ‘என் வீட்டில் சாவேனென்றும்,","poem":1},{"text":"என் நாட்கள் கடற்கரை மணலைப்போல் பெருகும்’ என்றும் நினைத்தேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"என் வேர் தண்ணீரை எட்டும் என்றும்,","poem":1},{"text":"என் கிளைகளில் இரவு முழுவதும் பனி படர்ந்திருக்கும் என்றும் எண்ணினேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"என் மகிமை மங்காது;","poem":1},{"text":"என் வில் எப்போதும் கையில் புதுப்பெலனுடன் இருக்கும். என எண்ணினேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“அந்நாட்களில் மனிதர் ஆவலுடன் எனக்குச் செவிகொடுத்து,","poem":1},{"text":"என் ஆலோசனைக்கு மவுனமாய்க் காத்திருந்தார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நான் பேசியபின் அவர்கள் தொடர்ந்து பேசவில்லை;","poem":1},{"text":"என் வார்த்தைகள் அவர்கள் செவிகளில் மெதுவாய் விழுந்தன.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"மழைக்குக் காத்திருப்பதுபோல் அவர்கள் எனக்குக் காத்திருந்து,","poem":1},{"text":"கோடை மழையைப்போல் என் வார்த்தைகளைப் பருகினார்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நான் அவர்களைப் பார்த்துப் புன்னகை செய்தபோது,","poem":1},{"text":"அவர்களால் அதை நம்பமுடியவில்லை;","poem":2},{"lineBreak":true},{"text":"என் முகமலர்ச்சியை மாற்றவுமில்லை.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நானே அவர்களுக்கு வழியைத் தெரிந்தெடுத்து, அவர்களின் தலைவனாயிருந்தேன்;","poem":1},{"text":"தன் படைகளின் மத்தியில் உள்ள ஒரு அரசனைப்போலவும்,","poem":2},{"lineBreak":true},{"text":"கவலைப்படுகிறவர்களைத் தேற்றுகிறவன்போலவும் நான் இருந்தேன்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/28.json","previousChapterAudioLinks":{},"numberOfVerses":25}