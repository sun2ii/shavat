{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":3,"content":[{"type":"heading","content":["யோபு பேசுதல்"]},{"type":"verse","number":1,"content":["அதற்குப்பின் யோபு தன் வாயைத் திறந்து தன் பிறந்த நாளைச் சபித்தான்,"]},{"type":"verse","number":2,"content":["யோபு சொன்னதாவது:"]},{"type":"verse","number":3,"content":[{"text":"“நான் பிறந்த நாளும்,","poem":1},{"text":"‘ஒரு ஆண் குழந்தை உற்பத்தியானது!’ என்று சொல்லப்பட்ட இரவும் அழியட்டும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அந்த நாள் இருளடையட்டும்;","poem":1},{"text":"உன்னதத்தின் இறைவன் அதைக் கவனத்தில் கொள்ளாதிருக்கட்டும்;","poem":2},{"lineBreak":true},{"text":"அதில் ஒளி பிரகாசியாதிருக்கட்டும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அந்த நாளை இருளும்,","poem":1},{"text":"நிழலும் ஒருமுறை பற்றிக்கொள்ளட்டும்;","poem":2},{"lineBreak":true},{"text":"மேகம் அதின்மேல் மூடிக்கொள்ளட்டும்;","poem":2},{"lineBreak":true},{"text":"மந்தாரம் அதின் வெளிச்சத்தை மூழ்கடிக்கட்டும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அந்த இரவைக் காரிருள் பிடிப்பதாக;","poem":1},{"text":"வருடத்தின் நாட்களில் அது சேர்க்கப்படாத நாளாகவும்,","poem":2},{"lineBreak":true},{"text":"மாதங்களிலும் குறிக்கப்படாமலும் போவதாக.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அந்த இரவு பாழாவதாக;","poem":1},{"text":"அதில் மகிழ்ச்சியின் சத்தம் எதுவும் கேளாதிருக்கட்டும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நாட்களைச் சபிக்கிறவர்களும், லிவியாதான் என்னும் பெரிய பாம்பை,","poem":1},{"text":"எழுப்புகிறவர்களும் அதைச் சபிக்கட்டும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அந்த நாளின் விடியற்கால நட்சத்திரங்கள் இருளடையட்டும்;","poem":1},{"text":"பகல் வெளிச்சத்திற்காக அது வீணாய்க் காத்திருக்கட்டும்;","poem":2},{"lineBreak":true},{"text":"அது அதிகாலையின் ஒளிக்கீற்றுகளைக் காணாதிருக்கட்டும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஏனெனில், அந்த நாள் என் கண்களில் இருந்து கஷ்டத்தை மறைக்காமலும்,","poem":1},{"text":"என் தாயின் கருப்பையை அடைக்காமலும் போயிற்றே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“பிறக்கும்போதே ஏன் நான் அழிந்துபோகவில்லை?","poem":1},{"text":"நான் கருப்பையில் இருந்து வெளியே வரும்போதே ஏன் சாகவில்லை?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"என்னை ஏற்றுக்கொள்ள மடியும்,","poem":1},{"text":"எனக்குப் பால் கொடுக்க மார்பகங்களும் ஏன் இருந்தன?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவ்வாறு இல்லாதிருந்தால்,","poem":1},{"text":"நான் அமைதியாய், இளைப்பாறுவேனே!","poem":2}]},{"type":"verse","number":14,"content":[{"text":"இப்பொழுது பாழாய்க்கிடக்கும் இடங்களில் தங்களுக்கு அரண்மனைகளைக் கட்டிய","poem":1},{"text":"பூமியின் அரசர்களோடும், ஆலோசகர்களோடும்,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"பொன்னை உடையவர்களும்,","poem":1},{"text":"தங்கள் வீடுகளை வெள்ளியால் நிரப்பினவர்களுமான ஆளுநர்களோடும் நான் இளைப்பாறுவேனே.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அல்லது செத்துப்பிறந்த குழந்தையைப் போலவும்,","poem":1},{"text":"பகல் வெளிச்சத்தைக் காணாத பாலகனைப் போலவும் நான் ஏன் தரையில் புதைக்கப்படவில்லை?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"கொடியவர்கள் அங்கே கலகத்திலிருந்து ஓய்ந்திருப்பார்கள்;","poem":1},{"text":"சோர்வுற்றோர் அங்கே இளைப்பாறுவார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"கைதிகள்கூட அங்கே சுகம் அனுபவிப்பார்கள்;","poem":1},{"text":"அடிமைகளை நடத்துபவர்களின் சத்தத்தை இனி அவர்கள் கேட்பதில்லை.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அங்கே சிறியவர்களும், பெரியவர்களும் இருக்கிறார்கள்;","poem":1},{"text":"அத்துடன் அடிமையும் தனது தலைவனிடமிருந்நு விடுதலையாகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“அவலத்தில் மூழ்கியிருப்பவனுக்கு வெளிச்சம் எதற்கு,","poem":1},{"text":"உள்ளத்தில் கசப்பு உள்ளவனுக்கு வாழ்வு எதற்கு?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"மறைவான புதையல்களைவிட, சாவைத் தேடியும்,","poem":1},{"text":"அடையாதவர்களுக்கு வாழ்வு ஏன்?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவர்கள் கல்லறையைச் சென்றடையும்போது,","poem":1},{"text":"மகிழ்ச்சியும் சந்தோஷமும் நிறைந்திருப்பார்களா?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"இறைவனால் நெருக்கப்பட்டு,","poem":1},{"text":"அவன் போகும் பாதை மறைக்கப்பட்ட,","poem":2},{"lineBreak":true},{"text":"மனிதனுக்கு வாழ்வு ஏன் கொடுக்கப்பட்டிருக்கிறது?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"பெருமூச்சே எனது உணவு;","poem":1},{"text":"என் கதறுதல் தண்ணீராய்ப் புரண்டோடுகிறது.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நான் எதற்கு பயந்தேனோ, அது என்மேல் வந்தது;","poem":1},{"text":"நான் எதற்கு அஞ்சினேனோ, அது எனக்கு நிகழ்ந்தது.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"எனக்கு சமாதானமோ, அமைதியோ,","poem":1},{"text":"இளைப்பாறுதலோ இல்லை. ஆனால் மனக்குழப்பத்தை மட்டும் அனுபவிக்கிறேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/2.json","previousChapterAudioLinks":{},"numberOfVerses":26}