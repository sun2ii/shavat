{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":[{"text":"“ஆனால் இப்பொழுதோ","poem":1},{"text":"என்னைவிட இளவயதுள்ளவர்கள் என்னைக் கேலி செய்கிறார்கள்;","poem":2},{"text":"அவர்களுடைய தந்தையரை, நான் என் மந்தையைக் காக்கும் நாய்களுடன் வைக்ககூடாது","poem":1},{"text":"என எண்ணினேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர்கள் கைகளின் வல்லமையால் எனக்கு என்ன பயன்?","poem":1},{"text":"அவர்கள் வலிமைதான் இல்லாமல் போயிற்றே!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் பசியினாலும், பஞ்சத்தினாலும் நலிந்து,","poem":1},{"text":"இரவிலே வெறுமையான வறண்ட நிலத்தில்","poem":2},{"lineBreak":true},{"text":"அலைந்து திரிந்தார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் புதர்ச்செடிகளில் இருந்து உவர்ப்புப் பூண்டுகளைச் சேர்த்தார்கள்;","poem":1},{"text":"காட்டுச்செடிகளின் கிழங்குகளே அவர்களுக்கு ஆகாரம்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கள்வர்களைச் சத்தமிட்டுத் துரத்துவதுபோல்,","poem":1},{"text":"அவர்கள் தங்கள் மக்களிலிருந்து துரத்தப்பட்டார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் காய்ந்த நீரோடைகளின் தரையிலும், கற்பாறைகளுக்கிடையிலும்,","poem":1},{"text":"நிலத்தின் பொந்துகளிலும் குடியிருக்க வேண்டியதாயிருந்தது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"புதர்களுக்குள்ளிருந்து கதறி,","poem":1},{"text":"முட்செடிகளின் கீழ் ஒதுங்கினார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்கள் இழிவானவர்களும், நற்பெயரற்றவர்களுமாக","poem":1},{"text":"நாட்டைவிட்டுத் துரத்தப்பட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“இளைஞர்கள் பாடல்களினாலும்,","poem":1},{"text":"பழமொழியினாலும், என்னை கேலி செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் என்னை அருவருத்து எனக்குத் தூரமாய் விலகிக்கொள்கிறார்கள்;","poem":1},{"text":"அவர்கள் என் முகத்தில் துப்புவதற்கும் தயங்கவில்லை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஏனெனில் இறைவன் என் வில்லின் நாணை அறுத்து என்னைச் சிறுமைப்படுத்தியதால்,","poem":1},{"text":"அவர்கள் என்முன் அடக்கமற்றவர்களாய் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"வலதுபுறத்தில் வாலிபர் எழும்பி, என்னைத் தாக்குகிறார்கள்;","poem":1},{"text":"என் பாதங்கள் தவறி விழச்செய்கிறார்கள்,","poem":2},{"lineBreak":true},{"text":"எனக்கு விரோதமாக அழிவின் பாதைகளை அமைக்கிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் என் வழியைக் கெடுக்கிறார்கள்;","poem":1},{"text":"ஒருவருடைய உதவியுமின்றி","poem":2},{"lineBreak":true},{"text":"என்னை அழிப்பதில் வெற்றி கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்கள் பெரிய வழியை உண்டாக்கி,","poem":1},{"text":"இடிந்தவைகளுக்கு இடையில் புரண்டு வருகிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"பயங்கரங்கள் என்னை மேற்கொள்கின்றன;","poem":1},{"text":"காற்று அடித்துக்கொண்டு போவதுபோல், என் மேன்மை போய்விட்டது,","poem":2},{"lineBreak":true},{"text":"என் பாதுகாப்பும் மேகத்தைப்போல் இல்லாமல் போகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“இப்பொழுது என் ஆத்துமா தளர்ந்து வற்றிப்போனது;","poem":1},{"text":"துன்ப நாட்கள் என்னைப் பிடித்துக்கொண்டது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இரவு என் எலும்புகளை உருவக் குத்துகிறது;","poem":1},{"text":"என் நரம்புவலி ஒருபோதும் ஓயாது இருக்கிறது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"இறைவன் தமது பெரிதான வல்லமையினால் உடையைப்போல் என்னை மூடுகிறார்;","poem":1},{"text":"உடையின் கழுத்துப் பட்டையைப்போல் என் நோய் என்னைச் சுற்றிக்கொண்டது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர் என்னைச் சேற்றில் தள்ளுகிறார்,","poem":1},{"text":"நான் தூசியாயும் சாம்பலுமானேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“இறைவனே, உம்மை நோக்கி கூப்பிடுகிறேன், நீர் பதில் கொடுக்காமலிருக்கிறீர்;","poem":1},{"text":"நான் உமக்கு முன்பாக நிற்கிறேன், நீரோ ஒன்றும் செய்யாமலிருக்கிறீர்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"கொடூரமாய் என் பக்கம் திரும்புகிறீர்;","poem":1},{"text":"உமது கரத்தின் வல்லமையால் என்னைத் தாக்குகிறீர்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"என்னைப் பிடுங்கி காற்றுக்கு முன்பாகப் பறக்க விடுகிறீர்;","poem":1},{"text":"புயலிலே என்னைச் சுழற்றுகிறீர்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நீர் என்னைச் சாவுக்குள்ளாக்குவீர் என்பது எனக்குத் தெரியும்,","poem":1},{"text":"உயிருள்ளோர் யாவருக்கும் நியமிக்கப்பட்ட இடம் அதுவே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“மனமுடைந்தவன் தன் உதவிக்காக அழும்போது,","poem":1},{"text":"யாரும் உதவிசெய்வதில்லை.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"கஷ்டப்படுகிறவர்களுக்காக நான் அழவில்லையோ?","poem":1},{"text":"ஏழைக்காக என் உள்ளம் வருந்தியதில்லையோ?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அப்படியிருந்தும், நான் நல்லதை எதிர்பார்த்தபோது, தீமையே வந்தது;","poem":1},{"text":"நான் ஒளிக்குக் காத்திருந்தபோது இருளே வந்தது.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"என் உள்ளக் குமுறல்கள் ஒருபோதும் ஒயவில்லை;","poem":1},{"text":"துன்பநாட்களே என்னை எதிர்நோக்குகின்றன.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நான் வெயில் படாதிருந்தும் கறுகறுத்துத் திரிகிறேன்;","poem":1},{"text":"கூட்டத்தில் நான் எழும்பி உதவிக்காகக் கதறுகிறேன்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"நான் நரிகளுக்குச் சகோதரனும்,","poem":1},{"text":"ஆந்தைகளுக்குக் கூட்டாளியுமானேன்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"என் தோல் கறுத்துப்போயிற்று;","poem":1},{"text":"என் உடல் காய்ச்சலால் எரிகிறது.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"என் யாழ் புலம்பலையும்,","poem":1},{"text":"என் புல்லாங்குழல் அழுகையின் ஒசையையே எழுப்புகிறது.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/29.json","previousChapterAudioLinks":{},"numberOfVerses":31}