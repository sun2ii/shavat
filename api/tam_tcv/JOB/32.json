{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":32,"content":[{"type":"heading","content":["எலிகூ பேசுதல்"]},{"type":"verse","number":1,"content":["யோபு தன் பார்வைக்கு நீதிமானாயிருந்ததினால், அந்த மூன்று நண்பர்களும் யோபுவுக்கு பதில் சொல்வதை நிறுத்திக்கொண்டார்கள்."]},{"type":"verse","number":2,"content":["ஆனால் ராமின் குடும்பத்தைச் சேர்ந்த பூசியனான பரகெயேலின் மகன் எலிகூவுக்குக் கோபமூண்டது; ஏனெனில், யோபு இறைவன் நேர்மையானவர் என்று சொல்வதைவிட, தன்னைத்தானே நேர்மையானவன் என்று சொன்னான்."]},{"type":"verse","number":3,"content":["அத்துடன் யோபுவுக்கு அவனுடைய மூன்று நண்பர்கள் மேலும் கோபம் மூண்டது; ஏனெனில், அவர்கள் யோபுவின் தவறை நிரூபிக்க தகுந்த வழியில்லாமல், அவனைக் கண்டனம் செய்தார்கள்."]},{"type":"verse","number":4,"content":["எலிகூ யோபுவுடன் பேசுவதற்கு இதுவரையும் காத்திருந்தான்; ஏனெனில் அவர்கள் எல்லோரும் எலிகூவைவிட வயதில் மூத்தவர்கள்."]},{"type":"verse","number":5,"content":["ஆனாலும் அந்த மூன்று மனிதரும் மேலும் எதையும் சொல்ல முடியாததைக் கண்ட எலிகூவுக்குக் கோபமூண்டது."]},{"type":"verse","number":6,"content":["எனவே பூசியனான பரகெயேலின் மகன் எலிகூ பேசத் தொடங்கினான்:",{"text":"“நான் வயதில் இளையவன்,","poem":1},{"text":"நீங்களோ முதியவர்கள்;","poem":2},{"text":"அதினால் நான் அறிந்ததைத் துணிந்து","poem":1},{"text":"சொல்லப் பயந்திருந்தேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"‘முதியோர் பேசட்டும்,","poem":1},{"text":"வயது சென்றவர்கள் ஞானத்தைப் போதிக்கட்டும்’ என எண்ணியிருந்தேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மனிதரில் இருக்கும் ஆவியாகிய","poem":1},{"text":"எல்லாம் வல்லவரின் சுவாசமே அவனுக்கு அறிவாற்றலைக் கொடுக்கிறது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"முதியோர் மட்டுமே ஞானிகளல்ல;","poem":1},{"text":"வயதானவர்கள் மட்டுமே சரியானதை அறிந்தவர்களுமல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“ஆகவே, நான் சொல்கிறேன்: எனக்குச் செவிகொடுங்கள்;","poem":1},{"text":"எனக்குத் தெரிந்ததை நானும் சொல்வேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நீங்கள் பேசிமுடியுமட்டும் நான் காத்திருந்து,","poem":1},{"text":"உங்கள் காரணத்தை நான் பொறுத்திருந்து,","poem":2},{"text":"உங்களுடைய வாதங்களுக்கு நான் செவிகொடுத்தேன்.","poem":1}]},{"type":"verse","number":12,"content":[{"text":"நான் உங்கள் சொல்லைக் கவனமாய்க் கேட்டேன்.","poem":2},{"text":"ஆனால் உங்களில் ஒருவராகிலும் யோபு பிழையானவன் என நிரூபிக்கவில்லை;","poem":1},{"text":"அவனுடைய வாதங்களுக்குப் பதில் சொல்லவுமில்லை.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"‘ஞானத்தைக் கண்டுகொண்டோம்; அவனுடைய பிழையை மனிதன் அல்ல,","poem":1},{"text":"இறைவனே நிரூபிக்கட்டும்’ என்று நீங்கள் சொல்லவேண்டாம்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யோபு என்னோடு வாதாடவில்லை,","poem":1},{"text":"நானும் உங்களின் வாதங்களைக்கொண்டு அவருக்குப் பதிலளிக்கமாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“அவர்கள் மனங்கலங்கி மேலும் எதுவும் சொல்ல முடியாதிருக்கிறார்கள்;","poem":1},{"text":"அவர்களுக்கு வார்த்தைகள் கிடைக்கவில்லை.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"இப்பொழுது அவர்கள் மவுனமாகி ஒரு பதிலும் அளிக்க முடியாதிருக்கையில்,","poem":1},{"text":"நான் பொறுத்திருக்க வேண்டுமோ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இப்பொழுது நானும் பேசியே தீருவேன்;","poem":1},{"text":"நானும் எனக்குத் தெரிந்ததைச் சொல்வேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"பேசுவதற்கு என்னிடம் அதிக வார்த்தைகள் உண்டு,","poem":1},{"text":"எனக்குள்ளிருக்கும் ஆவி என்னைப் பேசத் தூண்டுகிறது;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"என் உள்ளம், தோல் குடுவையின் திராட்சரசத்தைப்போலவும்,","poem":1},{"text":"வெடிக்கப்போகும் புதுத் தோல் குடுவையைப் போலவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நான் பேசி ஆறுதலடைய வேண்டும்;","poem":1},{"text":"என் உதடுகளைத் திறந்து பதிலளிக்க வேண்டும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"நான் யாருக்கும் பட்சபாதம் காட்டவோ,","poem":1},{"text":"எந்த மனிதனுக்கும் முகஸ்துதி செய்யவோ மாட்டேன்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நான் முகஸ்துதியில் திறமையுள்ளவனாய் இருந்தால்,","poem":1},{"text":"என்னைப் படைத்தவர் விரைவில் என்னை எடுத்துக்கொள்வாராக.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/31.json","previousChapterAudioLinks":{},"numberOfVerses":22}