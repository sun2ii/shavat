{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"“யோபுவே, என் வார்த்தைகளுக்குச் செவிகொடும்;","poem":1},{"text":"நான் சொல்வதைக் கவனியும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இப்பொழுது நான் பேசப் போகிறேன்;","poem":1},{"text":"என் வார்த்தைகள் என் நாவின் நுனியில் இருக்கின்றன.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என் வார்த்தைகள் நேர்மையான இருதயத்திலிருந்து வெளிவருகின்றன;","poem":1},{"text":"நான் அறிந்தவற்றை என் உதடுகள் உண்மையாய்ப் பேசுகின்றன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இறைவனின் ஆவியானவரே என்னைப் படைத்தார்;","poem":1},{"text":"எல்லாம் வல்லவரின் சுவாசமே எனக்கு உயிரைத் தருகிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உம்மால் முடியுமானால் எனக்குப் பதில் கூறும்;","poem":1},{"text":"என்னோடு வாதாட உம்மை ஆயத்தப்படுத்தும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இறைவனுக்கு முன்பாக நானும் உம்மைப் போன்றவன்தான்;","poem":1},{"text":"நானும் மண்ணிலிருந்தே உருவாக்கப்பட்டேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என்னைப்பற்றிய பயத்தினால் நீர் கலங்க வேண்டியதில்லை,","poem":1},{"text":"என் கையும் உம்மேல் பாரமாயிருக்காது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“என் காது கேட்க நீ பேசியிருக்கிறாய்;","poem":1},{"text":"நான் கேட்க, உன் வார்த்தைகளினாலேயே இப்படிக் கூறினாய்:","poem":2}]},{"type":"verse","number":9,"content":[{"text":"‘நான் தூய்மையானவன், குற்றமற்றவன்,","poem":1},{"text":"நான் சுத்தமானவன், பாவமற்றவன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இருந்தும் இறைவன் என்னிடம் குற்றம் கண்டிருக்கிறார்;","poem":1},{"text":"என்னைத் தம் பகைவனாக எண்ணுகிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர் என் கால்களை விலங்குகளில் மாட்டுகிறார்;","poem":1},{"text":"என் வழிகளையெல்லாம் கூர்ந்து கவனித்துக் கொண்டிருக்கிறார்.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ஆனால் நான் உமக்குச் சொல்கிறேன், இதில் நீர் சொன்னது சரியல்ல,","poem":1},{"text":"ஏனெனில் இறைவன் மனிதனைவிட மிகவும் பெரியவர்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர் மனிதனுடைய கேள்விகள் எதற்குமே பதிலளிக்கவில்லை","poem":1},{"text":"என நீர் ஏன் முறையிடுகிறீர்?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"மனிதர்கள் புரிந்துகொள்ளாவிட்டாலும்,","poem":1},{"text":"இறைவன் ஒருவிதமாகவும், இன்னொரு விதமாகவும் பேசுகிறார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"மனிதர் படுத்திருக்கையில்,","poem":1},{"text":"ஆழ்ந்த நித்திரையிலும், கனவிலும்,","poem":2},{"lineBreak":true},{"text":"இரவு தரிசனத்திலும் அவர் பேசுகிறார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர் மனிதர்களின் காதுகளில் பேசி,","poem":1},{"text":"தம்முடைய எச்சரிப்புகளினால் அவர்களைத் திகிலூட்டக்கூடும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"பிழை செய்வதிலிருந்து மனிதரை விலக்கவும்,","poem":1},{"text":"தற்பெருமையை தடுக்கவுமே இவ்வாறு செய்கிறார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"மனிதருடைய ஆத்துமா பிரேதக்குழியில் விழாதபடியும்,","poem":1},{"text":"அவர்களுடைய உயிர் வாளால் அழியாதபடியும் காப்பாற்றுகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“அல்லது மனிதர்கள் தங்கள் எலும்புகளில் உண்டான","poem":1},{"text":"தொடர்ச்சியான நோவுடன் படுக்கையிலேயே தண்டிக்கப்படக் கூடும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அப்பொழுது அவர்களுடைய உள்ளம் உணவையும்,","poem":1},{"text":"சுவையான உணவையும் வெறுக்கிறது.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர்களுடைய சதை முழுவதும் அழிந்து,","poem":1},{"text":"முன்பு மறைந்திருந்த எலும்புகள் வெளியே தெரிகின்றன.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவர்களுடைய ஆத்துமா பிரேதக் குழியையும்,","poem":1},{"text":"அவர்களுடைய உயிர் மரண தூதுவர்களையும் நெருங்குகிறது.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஆனாலும் ஆயிரத்தில் ஒருவனான தூதன் ஒருவன்","poem":1},{"text":"அவர்கள் பக்கத்திலிருந்து, அவர்களுக்காகப் பரிந்துபேசி,","poem":2},{"lineBreak":true},{"text":"அவர்களுக்கு சரியானவற்றைச் சொல்லிக்கொடுத்து,","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவர்களுக்குக் கிருபைகாட்டி,","poem":1},{"text":"‘நான் அவர்களுக்கு மீட்கும் பொருளைக் கண்டுபிடித்தேன்.","poem":2},{"lineBreak":true},{"text":"ஆகவே இவர்களைக் குழிக்குள் போவதிலிருந்து தப்பவிடும்’ என்று சொல்வானாகில்,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவர்களின் உடல் குழந்தையின் உடலைப்போல் புதிதாகும்,","poem":1},{"text":"அவர்கள் வாலிப நாட்களில் இருந்ததுபோல் மாற்றப்படுவார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அப்பொழுது அவர்கள் இறைவனை நோக்கி மன்றாடி,","poem":1},{"text":"அவரிடமிருந்து தயவு பெறுகிறார்கள்;","poem":2},{"text":"அவர்கள் இறைவனுடைய முகத்தைக் கண்டு மகிழ்வார்கள்,","poem":1},{"text":"இறைவன் அவர்களுடைய நீதியின் நிலையிலேயே திரும்பவும் வைக்கிறார்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவர்கள் மற்றவர்களைப் பார்த்து:","poem":1},{"text":"‘நான் பாவம் செய்து, நியாயத்தைப் புரட்டினேன்,","poem":2},{"lineBreak":true},{"text":"செய்ததற்குத் தகுந்த தண்டனையை நான் பெறவில்லை.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"பிரேதக் குழிக்குள் போகாமல் என் ஆத்துமாவை இறைவனே மீட்டுக்கொண்டார்;","poem":1},{"text":"நானும் ஒளியை அனுபவித்து சந்தோஷமாய் வாழ்வேன்.’","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"“இறைவன் இவற்றையெல்லாம் மனிதருக்கு இரண்டு முறைகள், ஏன்,","poem":1},{"text":"மூன்று முறைகள் திரும்பத் திரும்பச் செய்கிறார்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"குழியிலிருந்த அவர்களுடைய ஆத்துமாவை,","poem":1},{"text":"வாழ்வின் ஒளியால் பிரகாசிக்கச் செய்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“யோபுவே, நான் சொல்வதைக் கவனமாய்க் கேளும்;","poem":1},{"text":"மவுனமாய் இரும், நான் பேசுவேன்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அதின்பின் ஏதாவது சொல்ல இருந்தால் எனக்குப் பதில் கூறும்;","poem":1},{"text":"தயங்காமல் பேசும், உம்மை நீதிமானாக நிரூபிக்க நான் விரும்புகிறேன்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அப்படியில்லாவிட்டால், மவுனமாய் இருந்து நான் சொல்வதைக் கேளும்.","poem":1},{"text":"நான் உமக்கு ஞானத்தைப் போதிப்பேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/32.json","previousChapterAudioLinks":{},"numberOfVerses":33}