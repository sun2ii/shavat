{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":34,"content":[{"type":"verse","number":1,"content":["தொடர்ந்து எலிகூ சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“ஞானமுள்ள மனிதர்களே, என் வார்த்தைகளைக் கேளுங்கள்;","poem":1},{"text":"கல்விமான்களே, எனக்குச் செவிகொடுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நாவு உணவைச் சுவைப்பதுபோல்,","poem":1},{"text":"காது வார்த்தைகளை நிதானிக்கிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"வாருங்கள், சரியானது எது என்பதை நாம் நிதானிப்போம்;","poem":1},{"text":"எது நல்லது என்பதை நாம் ஒன்றாய்க் கற்றுக்கொள்வோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“யோபுவோ, ‘நான் குற்றமற்றவன்,","poem":1},{"text":"இறைவன் எனக்கு நீதிவழங்க மறுக்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் சரியானவனாய் இருந்தபோதிலும்,","poem":1},{"text":"பொய்யனாகவே எண்ணப்படுகிறேன்.","poem":2},{"text":"குற்றமற்றவனாய் இருந்தபோதிலும்,","poem":1},{"text":"அவருடைய அம்பு ஆறாதப் புண்ணை உண்டுபண்ணுகிறது’ என்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"தண்ணீர் பருகுவதைப்போல்","poem":1},{"text":"கேலிசெய்யும் யோபுவைப் போன்றவர் உண்டோ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர் தீமை செய்கிறவர்களின் கூட்டத்தில் சேர்ந்து,","poem":1},{"text":"கொடிய மனிதர்களுடன் வாசம்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏனெனில் அவர், ‘இறைவனுக்குப் பிரியமாக நடக்க முயற்சிப்பதினால்","poem":1},{"text":"ஒரு பயனும் இல்லை’ என்கிறாரே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“புத்திமான்களே, நான் சொல்வதைக் கேளுங்கள்.","poem":1},{"text":"தீமை இறைனுக்கும்,","poem":2},{"lineBreak":true},{"text":"அநீதி எல்லாம் வல்லவருக்கும் தூரமாயிருக்கிறது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"மனிதருடைய செய்கைக்குத் தக்கதாக அவர் பலனளிக்கிறார்.","poem":1},{"text":"அவர்களுடைய நடக்கைக்குத் தகுந்ததை அவர் அவர்களுக்கு வரப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இறைவன் அநியாயம் செய்யாமலும்,","poem":1},{"text":"எல்லாம் வல்லவர் நீதியைப் புரட்டாமலும் இருக்கிறது உண்மையே.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"பூமியின் மேலாக மனிதரை நியமித்தவர் யார்?","poem":1},{"text":"முழு உலகத்தையும் அவர்களுடைய பொறுப்பில் கொடுத்தவர் யார்?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர் தமது ஆவியையும் தமது சுவாசத்தையும்","poem":1},{"text":"திரும்ப எடுத்துக்கொள்ள நோக்கங்கொண்டால்,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"எல்லா மனுக்குலமும் ஒன்றாய் அழிந்துபோகும்;","poem":1},{"text":"மனிதர்களும் மண்ணுக்குத் திரும்புவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“உமக்கு விளங்கும் ஆற்றல் இருந்தால் இதைக் கேளும்,","poem":1},{"text":"நான் சொல்வதற்குச் செவிகொடும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நீதியை வெறுப்பவன் ஆள முடியுமோ?","poem":1},{"text":"நீர் நீதியும் வல்லமையுமுள்ளவரை குற்றப்படுத்துவீரோ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அரசர்களைப் பார்த்து, ‘ஒன்றுக்கும் உதவாதவர்கள்,’ என்றும்,","poem":1},{"text":"உயர்குடி மக்களைப் பார்த்து, ‘நீங்கள் கொடியவர்கள்’ என்றும் சொல்வார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர் இளவரசர்களுக்குப் பாரபட்சம் காட்டுவதில்லை,","poem":1},{"text":"ஏழையைவிட செல்வந்தனுக்குத் தயவு காட்டுவதுமில்லை;","poem":2},{"lineBreak":true},{"text":"ஏனெனில், அவர்கள் எல்லோருமே அவருடைய கரங்களின் படைப்பல்லவா?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்கள் நள்ளிரவில் ஒரு நொடியில் சாகிறார்கள்;","poem":1},{"text":"அசைக்கப்பட்டு இல்லாமல் போகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"பலவான்களும் மனித கரமல்லாத ஒரு கரத்தினால் அகற்றப்படுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“இறைவனுடைய கண்கள் மனிதருடைய வழிகளை நோக்கியிருக்கிறது;","poem":1},{"text":"அவர்களுடைய நடைகளையெல்லாம் அவர் பார்க்கிறார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"தீமை செய்கிறவர்கள் தங்களை ஒளித்துக்கொள்வதற்கு","poem":1},{"text":"இருளான இடமோ, காரிருளோ இல்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"இறைவன் மனிதரை மேலும் சோதிக்கமாட்டார்;","poem":1},{"text":"அவர்கள் அவர்முன் வழக்காடவேண்டிய அவசியமும் இல்லை.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"இறைவன் விசாரணையின்றியே வல்லமையுள்ளவர்களைச் சிதறடித்து,","poem":1},{"text":"அவர்களுக்குரிய இடத்தில் வேறு மனிதரை அமர்த்துகிறார்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஏனெனில், அவர் அவர்களுடைய செயல்களைக் குறித்துக்கொள்கிறார்;","poem":1},{"text":"இரவில் அவர்களைக் கவிழ்க்கிறார், அவர்கள் நசுங்கிப் போகிறார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவர் அவர்களின் கொடுமையின் நிமித்தம்,","poem":1},{"text":"எல்லோரும் காணும்படியாக அவர்களைத் தண்டிக்கிறார்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ஏனெனில் அவர்கள் இறைவனைப் பின்பற்றுவதிலிருந்து விலகி,","poem":1},{"text":"அவருடைய வழிகளை மதியாமல் போகிறார்கள்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவர்கள் ஏழைகளின் அழுகுரலை இறைவனுக்கு சேரவைத்தனர்;","poem":1},{"text":"அவர் அவர்களின் அழுகையைக் கேட்டார்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"மவுனமாய் இருக்கிறவரைக் குற்றப்படுத்தாதே;","poem":1},{"text":"நாட்டிற்கும், மனிதனுக்கும்,","poem":2},{"text":"அவர் தமது முகத்தை மறைத்தால் அவரைப் பார்ப்பவன் யார்?","poem":1}]},{"type":"verse","number":30,"content":[{"text":"அதினால் இறைவனற்றவர்கள் ஆட்சிசெய்யாமலும்,","poem":2},{"lineBreak":true},{"text":"மக்கள் கண்ணியில் சிக்காமலும் தடுக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“யாராவது இறைவனிடம் இப்படிக் கேட்பதுண்டா:","poem":1},{"text":"‘நான் குற்றவாளி, இனிப் பாவம் செய்யமாட்டேன்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"நான் காணாதவற்றை எனக்குப் போதியும்,","poem":1},{"text":"நான் அக்கிரமம் செய்திருந்தால் இனிமேல் அதைச் செய்யமாட்டேன்.’","poem":2}]},{"type":"verse","number":33,"content":[{"text":"நீர் மனந்திரும்ப மறுக்கும்போது","poem":1},{"text":"உமது மன எண்ணப்படி இறைவன் வெகுமதி கொடுக்கவேண்டுமோ?","poem":2},{"text":"நானல்ல, நீரே தீர்மானித்துக்கொள்ளும்;","poem":1},{"text":"நீர் அறிந்ததை எனக்குச் சொல்லும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“நான் சொல்வதைக் கேட்ட விளங்கும் ஆற்றலுள்ளவர்களும்","poem":1},{"text":"ஞானமுள்ளவர்களும் என்னிடம்,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"‘யோபு அறிவில்லாமல் பேசுகிறார்;","poem":1},{"text":"அவருடைய வார்த்தைகள் ஞானமில்லாதவை என்றும்,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"யோபு கொடியவரைப்போல் பேசியதற்காக","poem":1},{"text":"முற்றிலும் சோதிக்கப்பட வேண்டும்.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"தம்முடைய பாவத்துடன் மீறுதலையும் சேர்த்துக் கொள்கிறார்;","poem":1},{"text":"அவர் எங்கள் மத்தியில் ஏளனமாய்க் கைகொட்டி,","poem":2},{"lineBreak":true},{"text":"இறைவனுக்கு விரோதமான வார்த்தைகளைப் பேசினார்’ என்று என்னிடம் சொல்கிறார்கள்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/33.json","previousChapterAudioLinks":{},"numberOfVerses":37}