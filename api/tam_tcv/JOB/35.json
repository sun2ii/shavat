{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":35,"content":[{"type":"verse","number":1,"content":["தொடர்ந்து எலிகூ சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“ ‘என் நீதி இறைவனுடைய நீதியைப்பார்க்கிலும் பெரியது,’ என்று","poem":1},{"text":"நீர் சொல்வது நியாயம் என்று நினைக்கிறீரோ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீர், ‘நான் பாவம் செய்யாதிருப்பதால் எனக்கு என்ன பலன்?","poem":1},{"text":"என்ன இலாபம்?’ என்று இறைவனிடம் கேட்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“இப்பொழுது நான் உமக்கும் உம்மோடிருக்கும் உமது சிநேகிதருக்கும்","poem":1},{"text":"பதில்சொல்ல விரும்புகிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"வானங்களை மேலே நோக்கிப்பாரும்;","poem":1},{"text":"உமக்கு மேலாக மிக உயரத்தில் இருக்கும் மேகங்களையும் உற்றுப் பாரும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீர் பாவம்செய்தால் அது அவரை எப்படிப் பாதிக்கும்?","poem":1},{"text":"உன் பாவங்கள் அதிகமானாலும் அவை அவரை என்ன செய்யும்?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நீ நேர்மையானவனாக இருந்தால் நீர் அவருக்கு எதைக் கொடுக்கிறீர்?","poem":1},{"text":"அல்லது அவர் உம் கையில் இருந்து எதைப் பெற்றுக்கொள்கிறார்?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"உம்முடைய கொடுமைகள் உம்மைப்போன்ற மனிதருக்குப் பாதிப்பையும்,","poem":1},{"text":"உம்முடைய நீதி மனுமக்களுக்கு நன்மையையும் அளிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“ஒடுக்குதலின் மிகுதியால் மனிதர் கதறுகிறார்கள்;","poem":1},{"text":"பலவானின் கரத்திலிருந்து விடுதலைக்காக கதறுகிறார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆனால், ‘என்னைப் படைத்த இறைவன் எங்கே?","poem":1},{"text":"இரவிலே பாடல்களைத் தருபவர் எங்கே?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பூமியின் மிருகங்களைவிட நமக்கு அதிகமாகப் போதிப்பவர் எங்கே?","poem":1},{"text":"ஆகாயத்துப் பறவைகளைவிட நம்மை ஞானிகள் ஆக்குகிறவர் எங்கே?’","poem":2},{"lineBreak":true},{"text":"என்று கேட்பவர் ஒருவருமில்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"கொடியவர்களின் அகந்தையின் நிமித்தம்,","poem":1},{"text":"மனிதர் அழும்போது இறைவன் அவர்களுக்குப் பதில் கொடுப்பதில்லை.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இறைவன் வீண்வார்த்தைகளைக் கேட்கமாட்டார்;","poem":1},{"text":"எல்லாம் வல்லவர் அதைக் கவனிக்கமாட்டார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அப்படியிருக்கையில், நீர் அவரைக் காணவில்லை என்றும்,","poem":1},{"text":"உமது வழக்கு அவர் முன்னால் இருக்கிறது என்றும்,","poem":2},{"text":"நீர் அவருக்காகக் காத்திருக்கவேண்டும் என்றும் சொல்கிறபோது,","poem":1},{"text":"அவர் உமக்குச் செவிகொடுப்பாரோ?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"மேலும், அவருடைய கோபம் மனிதரைத் தண்டிப்பது இல்லை;","poem":1},{"text":"என்றும் மனிதரின் கொடுமையை அவர் கொஞ்சமும் கவனிப்பதில்லை என்று எண்ணி,","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யோபு தன் வாயைத் திறந்து வீணாய்ப் பேசி,","poem":1},{"text":"அறிவில்லாமல் தன் வார்த்தைகளை வசனிக்கிறார்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/34.json","previousChapterAudioLinks":{},"numberOfVerses":16}