{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":36,"content":[{"type":"verse","number":1,"content":["தொடர்ந்து எலிகூ சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“சற்று என்னிடம் பொறுமையாயிரும்,","poem":1},{"text":"இறைவன் சார்பாய் நான் சொல்ல வேண்டியவற்றை நான் உமக்குக் காண்பிப்பேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் அதிக தூரத்திலிருந்து என் அறிவைப் பெறுகிறேன்;","poem":1},{"text":"என்னைப் படைத்தவருக்கே நீதி உரியது என்றும் நிரூபிப்பேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் வார்த்தைகள் பொய்யானவையல்ல என்று உறுதியாய்க் கூறுகிறேன்;","poem":1},{"text":"பூரண அறிவுள்ள நான் உம்மோடு பேசுகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“இறைவன் வல்லமையுள்ளவர், ஆகிலும் அவர் ஒருவரையும் தள்ளிவிடமாட்டார்;","poem":1},{"text":"வல்லமையுள்ள அவர் தமது நோக்கத்தில் உறுதியுள்ளவர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் கொடியவர்களை உயிர்வாழ விடுவதில்லை;","poem":1},{"text":"துன்பப்படுகிறவர்களுக்கோ அவர்களுடைய உரிமைகளை வழங்குகிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் நேர்மையானவர்கள் மேலிருந்து தன் கண்களை அகற்றுவதில்லை;","poem":1},{"text":"அவர் அவர்களை அரசர்களோடு அரியணையில் அமர்த்தி,","poem":2},{"lineBreak":true},{"text":"அவர்களை என்றைக்கும் மேன்மைப்படுத்துகிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆனால் மனிதர்கள் சங்கிலியால் கட்டப்பட்டு,","poem":1},{"text":"வேதனையின் கயிற்றினால் இறுக்கப்பட்டிருக்கும்போது,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்கள் செய்தவற்றை இறைவன் அவர்களுக்குக் கூறுவார்.","poem":1},{"text":"அதாவது அவர்கள் அகந்தையாய் பாவம் செய்ததை அவர் சொல்வார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் அவர்கள் சீர்திருந்துதலுக்குச் செவிகொடுத்து,","poem":1},{"text":"தங்கள் தீமையிலிருந்து மனந்திரும்ப கட்டளையிடுகிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் கீழ்ப்படிந்து அவருக்குப் பணிசெய்தால்,","poem":1},{"text":"அவர்கள் தங்கள் மீதியான நாட்களைச் செல்வத்திலும்,","poem":2},{"lineBreak":true},{"text":"மீதியான வருஷங்களை மனநிறைவிலும் கழிப்பார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அடங்கி அவருக்குப் பணிசெய்யாவிட்டால்,","poem":1},{"text":"வாளினால் அழிந்து,","poem":2},{"lineBreak":true},{"text":"அறிவில்லாமலே சாவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“உள்ளத்தில் இறைவனற்றவர்கள் கோபத்தை வளர்த்துக்கொள்கிறார்கள்;","poem":1},{"text":"அவர் அவர்களுக்கு விலங்கிடும்போதும் அவர்கள் உதவிக்காக அழுவதில்லை.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்கள் கோவில்களிலிருக்கும் ஆண் விபசாரக்காரர் மத்தியில்","poem":1},{"text":"தங்கள் இளமையிலேயே சாவார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆனாலும் துன்பப்படுகிறவர்களை அவர் துன்பத்திலிருந்து விடுவித்து,","poem":1},{"text":"அவர்களுடைய வேதனையில் அவர் அவர்களோடு பேசுகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“யோபுவே, இறைவன் உன்னைக் கட்டுப்பாடற்ற விசாலமான இடத்திற்கு கொண்டுவரவும்,","poem":1},{"text":"சுவையான உணவுகள் நிறைந்த பந்தியில் அமர்த்தவும்,","poem":2},{"lineBreak":true},{"text":"வேதனையின் பிடியிலிருந்து உன்னை விடுவிக்கவும் முயற்சிக்கிறார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"கொடியவர்கள்மேல் வரும் நியாயத்தீர்ப்பு நிறைவேறக் காத்திருக்கிறீர்;","poem":1},{"text":"நியாயத்தீர்ப்பும் நீதியுமே உம்மை ஆதரிக்கும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"செல்வங்களினால் ஒருவரும் உம்மைக் கவராதபடி எச்சரிக்கையாயிரும்;","poem":1},{"text":"பெரிதான இலஞ்சம் உம்மை வழிவிலகிச் செல்ல இடங்கொடாதே.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"உமது செல்வங்களும் வல்லமையான எல்லா முயற்சிகளும்","poem":1},{"text":"நீர் துன்பத்தில் அகப்படாதபடி உம்மைத் தாங்குமோ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"மக்களைத் தங்கள் வீடுகளிலிருந்து இழுத்துச் செல்வதற்காக","poem":1},{"text":"நீர் இரவை வாஞ்சிக்காதிரும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"தீமைசெய்யத் திரும்பாதபடி எச்சரிக்கையாயிரும்;","poem":1},{"text":"ஏனெனில், நீர் துன்பத்தைவிட தீமையை தெரிந்துகொண்டீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“இறைவன் தமது வல்லமையில் உயர்த்தப்பட்டிருக்கிறார்.","poem":1},{"text":"அவரைப்போல் போதிக்கிறவர் யார்?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"இறைவனுக்கு அவருடைய வழியைக் குறித்துக் கொடுத்தது யார்?","poem":1},{"text":"அல்லது ‘நீர் அக்கிரமம் செய்தீர்’ என்று சொல்லியது யார்?","poem":2}]},{"type":"verse","number":24,"content":[{"text":"மனிதர்கள் புகழ்ந்து பாடும் பாடல்களால்","poem":1},{"text":"அவருடைய செயலை மேன்மைப்படுத்த நினைவுகூரும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவர் செய்வதை எல்லா மனிதரும் காண்கிறார்கள்;","poem":1},{"text":"அதைத் தூரத்திலிருந்து உற்றுப் பார்க்கிறார்கள்;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நமது விளங்கும் ஆற்றலுக்கும் அப்பாற்பட்ட இறைவன்!","poem":1},{"text":"அவருடைய வருடங்களும் எண்ணிட முடியாதவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“அவர் நீர்த்துளிகளை மேலே இழுத்து,","poem":1},{"text":"அவற்றை ஆறுகளில் மழையாகப் பெய்யச் செய்கிறார்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"மேகங்கள் மழையைப் பொழிகின்றன,","poem":1},{"text":"அது மனிதர்மேல் தாரையாய்ப் பொழிகிறது.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர் மேகங்களை எப்படி பரவுகிறார் என்றும்,","poem":1},{"text":"எப்படி முழங்குகிறார் என்றும் யாரால் விளங்கிக்கொள்ள முடியும்?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவர் தமது மின்னலைத் தம்மைச் சுற்றிலும் சிதறப்பண்ணி,","poem":1},{"text":"கடலின் ஆழங்களை எப்படி மூடுகிறார் என்று பாரும்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"இவ்விதமாகவே அவர் மக்களை ஆளுகைசெய்து,","poem":1},{"text":"ஏராளமான உணவையும் கொடுக்கிறார்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அவர் தம் கரங்களை மின்னலினால் நிரப்பி,","poem":1},{"text":"குறிப்பிட்ட இலக்கைத் தாக்கும்படி அதற்குக் கட்டளையிடுகிறார்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அவருடைய இடிமுழக்கம் வரப்போகும் புயலை அறிவிக்கிறது;","poem":1},{"text":"அதின் வருகையை மந்தைகள்கூடத் தெரிவிக்கும்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/35.json","previousChapterAudioLinks":{},"numberOfVerses":33}