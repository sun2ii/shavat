{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":37,"content":[{"type":"verse","number":1,"content":[{"text":"“அந்த முழக்கத்தினால் என் இருதயம் நடுங்கி,","poem":1},{"text":"அதின் இடத்தைவிட்டுத் துடிக்கிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இறைவனுடைய குரலின் கர்ஜனையையும்,","poem":1},{"text":"அவர் வாயிலிருந்து வரும் முழக்கத்தையும் கேளுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"வானத்தின் கீழெங்கும் தமது மின்னலைக் கட்டவிழ்த்து,","poem":1},{"text":"அதைப் பூமியின் கடைமுனைகளுக்கும் அனுப்புகிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பின்பு அவருடைய கர்ஜனையின் சத்தம் வருகிறது,","poem":1},{"text":"அவர் தனது கெம்பீரமான குரலினால் முழங்குகிறார்;","poem":2},{"text":"அவருடைய சத்தம் தொனிக்கும்போது","poem":1},{"text":"அவர் ஒன்றையும் அடக்குவதில்லை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறைவனது குரல் ஆச்சரியமான விதங்களில் முழங்குகிறது;","poem":1},{"text":"அவர் நம்மால் விளங்கிக்கொள்ள முடியாத அளவு பெரிய காரியங்களைச் செய்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அத்துடன் அவர் பனியைப் பார்த்து, ‘பூமியின்மேல் விழு’ என்றும்,","poem":1},{"text":"மழையைப் பார்த்து, ‘கடுமையாய்ப் பெய்’ என்றும் கூறுகிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவ்வேளைகளில் அவர் தாம் படைத்த எல்லா மனிதர்களும் தமது செயலை அறியும்படி,","poem":1},{"text":"ஒவ்வொரு மனிதனையும் அவனுடைய வேலையிலிருந்து நிறுத்துகிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"காட்டு மிருகங்கள் குகைகளுக்குள் சென்று,","poem":1},{"text":"தங்கள் கெபிகளில் தங்குகின்றன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தெற்கிலிருந்து சூறாவளியும்,","poem":1},{"text":"வடதிசை காற்றினால் குளிரும் வருகிறது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இறைவனின் சுவாசத்தால் பனிக்கட்டி உருவாகிறது;","poem":1},{"text":"அப்பொழுது பரந்த நீர்ப்பரப்புகளும் உறைந்துபோகின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர் மேகங்களை ஈரத்தினால் பாரமாக்கி,","poem":1},{"text":"தமது மின்னலை அவற்றினுள் சிதறப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவரின் திசையில் மேகங்கள் சுழல்கின்றன;","poem":1},{"text":"அவை பூமியின் மேற்பரப்பெங்கும்","poem":2},{"lineBreak":true},{"text":"அவர் கட்டளையிடுவதைச் செய்கின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"மனிதரைத் தண்டிப்பதற்கோ,","poem":1},{"text":"அல்லது தனது பூமியை வளமுள்ளதாக்கி தமது அன்பைக் காட்டுவதற்கோ","poem":2},{"lineBreak":true},{"text":"அவர் மேகங்களைக் கொண்டுவருகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“யோபுவே, இதைக் கேளும்;","poem":1},{"text":"சற்று நின்று இறைவனின் அதிசயங்களைக் கவனித்துப் பாரும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"இறைவன் மேகங்களை எவ்வாறு கட்டுப்படுத்தி","poem":1},{"text":"தமது மின்னலை மின்னப் பண்ணுகிறார் என்று உமக்குத் தெரியுமா?","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர் மேகங்களை எப்படி ஆகாயத்தில் தொங்கவிட்டிருக்கிறார் என்பதையும்,","poem":1},{"text":"பூரண அறிவுள்ளவரின் அதிசயங்களையும் நீர் அறிவீரோ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"தென்றலினால் பூமி அடங்கிக் கிடக்கும்போது,","poem":1},{"text":"உமது ஆடைகள் வெப்பமாயிருக்கும் முறையை அறிவீரோ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"வார்க்கப்பட்ட வெண்கல கண்ணாடியைப் போன்ற,","poem":1},{"text":"கடினமான ஆகாயத்தை அவருடன் சேர்ந்து உம்மால் விரிக்க முடியுமோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“அவருக்குச் சொல்லவேண்டியதை நீர் எங்களுக்குச் சொல்லும்;","poem":1},{"text":"இருளின் காரணமாக எங்களால் வழக்காட முடியாதிருக்கிறது.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"‘நான் பேச விரும்புகிறேன்’ என்று அவருக்குச் சொல்லலாகுமோ?","poem":1},{"text":"தான் விழுங்கப்படுவதை எவனும் விரும்பிக் கேட்பானோ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"காற்று ஆகாயத்தைச் சுத்தப்படுத்திய பின்,","poem":1},{"text":"சூரியனை எந்த மனிதனாலும் பார்க்க முடியாதே!","poem":2},{"lineBreak":true},{"text":"ஏனெனில் அதின் ஒளி பிரகாசமாயிருக்கும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"வடக்கிலிருந்து தங்கமயமான மகிமையிலே அவர் வருகிறார்;","poem":1},{"text":"திகைப்பூட்டும் மாட்சிமையுடன் இறைவன் வருகிறார்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"எல்லாம் வல்லவர் நமக்கு எட்டாத தூரத்திலே","poem":1},{"text":"அவர் வல்லமையில் உயர்ந்திருக்கிறார்;","poem":2},{"lineBreak":true},{"text":"அவர் நீதியும் நியாயமும் நிறைந்தவர்; அவர் ஒடுக்குகிறதில்லை.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஆகையால், மனிதர்கள் அவரிடம் பயபக்தியாயிருக்கிறார்கள்;","poem":1},{"text":"ஏனெனில், இருதயத்தில் ஞானமுள்ள ஒருவரையும் அவர் மதிப்பதில்லை.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/36.json","previousChapterAudioLinks":{},"numberOfVerses":24}