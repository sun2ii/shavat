{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":38,"content":[{"type":"heading","content":["யெகோவா யோபுக்கு மறுமொழி கொடுத்தல்"]},{"type":"verse","number":1,"content":["அப்பொழுது யெகோவா பெருங்காற்றிலிருந்து யோபுவுடன் பேசினார்:"]},{"type":"verse","number":2,"content":[{"text":"“அறிவற்ற வார்த்தைகளினால்","poem":1},{"text":"என் ஆலோசனையை தெளிவற்றதாக்குகிற இவன் யார்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இப்பொழுது நீ ஒரு திடமனிதனாய் நில்;","poem":1},{"text":"நான் உன்னிடம் கேள்வி கேட்கப்போகிறேன்,","poem":2},{"lineBreak":true},{"text":"நீ எனக்குப் பதில் சொல்லவேண்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“நான் பூமிக்கு அஸ்திபாரம் போடும்போது நீ எங்கேயிருந்தாய்?","poem":1},{"text":"உனக்கு விளங்கினால் அதை எனக்குச் சொல்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அதின் அளவைக் குறித்தவர் யார்? அதின்மேல் அளவுநூலைப் பிடித்தது யார்?","poem":1},{"text":"நீ சொல், உனக்குத் தெரிந்திருக்குமே!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அதின் தூண்கள் எதன்மேல் அமைக்கப்பட்டிருக்கின்றன?","poem":1},{"text":"அதின் மூலைக்கல்லை வைத்தவர் யார்?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அப்பொழுது விடிவெள்ளிகள் ஒன்றாகக்கூடி பாட்டுப்பாடின;","poem":1},{"text":"இறைத்தூதர்கள் ஒன்றுகூடி மகிழ்ச்சியால் ஆர்ப்பரித்தனரே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“கடல் தன் கருப்பையிலிருந்து வெடித்து வெளிப்பட்டபோது,","poem":1},{"text":"அதைக் கதவுகளுக்குப் பின்வைத்து அடைத்தவர் யார்?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் மேகத்தை அதற்கு உடையாக வைத்தபோதும்,","poem":1},{"text":"காரிருளினால் அதைச் சுற்றியபோதும்,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் அதற்கு எல்லைகளை அமைத்துத்","poem":1},{"text":"தாழ்ப்பாள்களையும் கதவுகளையும் வைத்தபோது நீ எங்கேயிருந்தாய்?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான் அதனிடம், ‘நீ இதுவரை வா, மீறி வராதே;","poem":1},{"text":"உன் அகங்கார அலைகள் அடங்குவதாக’ என்று சொன்னபோது நீ எங்கேயிருந்தாய்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“உன் வாழ்நாளில் காலைநேரத்திற்குக் கட்டளையிட்டு,","poem":1},{"text":"அதிகாலைப்பொழுதுக்கு அதின் இடத்தைக் காட்டினதுண்டோ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இவ்வாறு, பூமியின் ஓரங்களைப் பிடித்து","poem":1},{"text":"அதிலிருந்து கொடியவர்களை உதறித் தள்ளும்படி சொன்னதுண்டோ?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"முத்திரையிடப்பட்ட களிமண்போல் பூமி உருப்பெறுகிறது;","poem":1},{"text":"அதின் இயற்கைத் தோற்றங்களும் உடைகளைப்போல் நிற்கின்றன.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"கொடியவர்களுக்கு வெளிச்சம் மறுக்கப்படுகிறது;","poem":1},{"text":"உயர்த்தப்பட்ட அவர்களின் புயம் முறிக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“கடலின் ஊற்றுக்களுக்கு நீ போனதுண்டோ?","poem":1},{"text":"அல்லது ஆழத்தின் உள்ளிடங்களில் நடந்திருக்கிறாயோ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"மரண வாசல்கள் உனக்குக் காண்பிக்கப்பட்டதுண்டோ?","poem":1},{"text":"மரண இருளின் வாசல்களை நீ கண்டதுண்டோ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"பூமியின் அகன்ற வெளிகளை நீ விளங்கிக்கொண்டாயோ?","poem":1},{"text":"இவைகளெல்லாம் உனக்குத் தெரியுமானால் எனக்குச் சொல்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“வெளிச்சம் வசிக்கும் இடத்திற்குப் போகும் வழி எது?","poem":1},{"text":"இருள் எங்கே குடியிருக்கிறது?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவற்றை அவை இருக்கும் இடத்திற்குக் கூட்டிச்செல்ல உன்னால் முடியுமா?","poem":1},{"text":"அவைகள் தங்குமிடத்திற்கான பாதைகளை நீ அறிவாயோ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"இவை உனக்குத் தெரிந்திருக்குமே;","poem":1},{"text":"இவைகளுக்கு முன்னே நீ பிறந்து பல வருடங்கள் வாழ்ந்துவிட்டாய் அல்லவா!","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“உறைபனியின் களஞ்சியங்களுக்குள் நீ போயிருக்கிறாயோ?","poem":1},{"text":"பனிக்கட்டி மழையின் களஞ்சியங்களைக் கண்டிருக்கிறாயோ?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"கஷ்ட காலத்திலும், கலகமும் யுத்தமும் வரும் நாட்களிலும் பயன்படுத்தும்படி","poem":1},{"text":"நான் அவைகளைச் சேர்த்து வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"மின்னல் புறப்படும் இடத்திற்கு வழி எங்கே?","poem":1},{"text":"கீழ்காற்று பூமியின்மேல் வீசுவதற்கான வழி எங்கே?","poem":2}]},{"type":"verse","number":25,"content":[{"text":"பலத்த மழைக்கு வாய்க்காலை வெட்டுபவர் யார்?","poem":1},{"text":"இடி மின்னலோடு வரும் மழைக்கு வழியை ஏற்படுத்துகிறவர் யார்?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ஒருவரும் குடியிராத நிலத்திற்கும்,","poem":1},{"text":"எவருமே இல்லாத பாலைவனத்திற்கும் பசுமையைக் கொடுப்பதற்காகவும்,","poem":2}]},{"type":"verse","number":27,"content":[{"text":"வனாந்திரமான பாழ்நிலத்தை பசுமையாக்கி,","poem":1},{"text":"அதில் புல் பூண்டுகளை முளைக்கப்பண்ணும்படி செய்கிறவர் யார்?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"மழைக்கு ஒரு தகப்பன் உண்டோ?","poem":1},{"text":"பனித்துளிகளைப் பெற்றெடுத்தவர் யார்?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"யாருடைய கருப்பையிலிருந்து பனிக்கட்டி வருகிறது?","poem":1},{"text":"வானங்களிலிருந்து வரும் உறைபனியைப் பெற்றெடுக்கிறவர் யார்?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"தண்ணீர்கள் கல்லைப்போலவும்,","poem":1},{"text":"ஆழத்தின் மேற்பரப்பு உறைந்துபோகவும் செய்கிறவர் யார்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"“அழகான கார்த்திகை நட்சத்திரத்தை நீ இணைக்கமுடியுமோ?","poem":1},{"text":"மிருகசீரிட நட்சத்திரத்தைக் கட்டவிழ்க்க உன்னால் முடியுமோ?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"விடிவெள்ளிக் கூட்டங்களை அதினதின் காலத்தில் கொண்டுவருவாயோ?","poem":1},{"text":"சிம்மராசி நட்சத்திரத்தையும் அதின் கூட்டத்தையும் வழிநடத்த உன்னால் முடியுமோ?","poem":2}]},{"type":"verse","number":33,"content":[{"text":"வானமண்டலத்தை ஆளும் சட்டங்களை நீ அறிவாயோ?","poem":1},{"text":"பூமியின்மேல் அவைகளின் ஆட்சியை நீ அமைப்பாயோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"“நீ மேகங்களுக்குச் சத்தமிட்டுச் சொல்லி","poem":1},{"text":"வெள்ளம் உன்னை மூடும்படிச் செய்வாயோ?","poem":2}]},{"type":"verse","number":35,"content":[{"text":"மின்னல்களின் தாக்குதல்களை அதின் வழியிலே அனுப்புவது நீயா?","poem":1},{"text":"‘இதோ பார், நாங்கள் இருக்கிறோம்’ என அவை உன்னிடம் அறிவிக்குமோ?","poem":2}]},{"type":"verse","number":36,"content":[{"text":"இருதயத்தை ஞானத்தால் நிரப்பியவரும்,","poem":1},{"text":"மனதுக்கு விளங்கும் ஆற்றலைக் கொடுத்தவரும் யார்?","poem":2}]},{"type":"verse","number":37,"content":[{"text":"யாருக்கு மேகங்களைக் கணக்கிடும் ஞானம்?","poem":1},{"text":"வானத்தின் தண்ணீர்ச் சாடிகளை,","poem":2}]},{"type":"verse","number":38,"content":[{"text":"தூசியானது மண்கட்டிகளாகி ஒன்றோடொன்று ஒட்டிக்கொள்ளவும்,","poem":1},{"text":"மேகங்களிலுள்ள தண்ணீரைப் பொழியச்செய்கிறவர் யார்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"“நீ சிங்கத்திற்கு இரையை தேடி,","poem":1},{"text":"அவைகளின் பசியை தீர்ப்பாயோ?","poem":2}]},{"type":"verse","number":40,"content":[{"text":"சிங்கக்குட்டிகள் குகைகளிலும்","poem":1},{"text":"புதர்களுக்குள்ளும் இருக்கும்போது அவைகளின் பசியை நீ தீர்ப்பாயோ?","poem":2}]},{"type":"verse","number":41,"content":[{"text":"காக்கைக்குஞ்சுகள்","poem":1},{"text":"இறைவனை நோக்கிக் கூப்பிட்டு,","poem":2},{"lineBreak":true},{"text":"உணவின்றி அலையும்போது உணவைக் கொடுப்பது யார்?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/37.json","previousChapterAudioLinks":{},"numberOfVerses":41}