{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":39,"content":[{"type":"verse","number":1,"content":[{"text":"“மலை ஆடுகள் குட்டி ஈனும் காலத்தை நீ அறிவாயோ?","poem":1},{"text":"பெண்மான் குட்டி ஈன்றதை நீ கண்டிருக்கிறாயோ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவை சினைப்பட்டிருக்கும் மாதங்களை நீ கணக்கிடுவாயோ?","poem":1},{"text":"அவை குட்டி ஈனும் நேரத்தை நீ அறிவாயோ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவை முடங்கிக்கிடந்து தங்கள் குட்டிகளை ஈனும்;","poem":1},{"text":"குட்டி ஈன்றதும் அவைகளின் வலி நீங்கிவிடும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவைகளின் குட்டிகள் காடுகளில் பெலனடைந்து வளர்கின்றன,","poem":1},{"text":"அவை திரும்பவும் தாயிடம் திரும்பி வருவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“காட்டுக் கழுதையைச் சுதந்திரமாகத் திரியவிட்டவர் யார்?","poem":1},{"text":"அதின் கட்டுகளை அவிழ்த்தவர் யார்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நானே அதற்குப் பாழ்நிலத்தை வீடாகவும்,","poem":1},{"text":"உவர்நிலத்தைக் குடியிருப்பாகவும் கொடுத்தேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அது பட்டணத்துச் சந்தடியை அலட்சியம் பண்ணுகிறது;","poem":1},{"text":"ஓட்டுகிறவனுடைய சத்தத்தை அது கேட்பதில்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அது மலைகளைத் தனது மேய்ச்சலிடமாக்குகிறது;","poem":1},{"text":"அங்கு பச்சைத் தாவரங்களைத் தேடி அலைகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“காட்டெருது உனக்கு சேவைசெய்ய சம்மதிக்குமோ?","poem":1},{"text":"அது உனது தொழுவத்தில் இரவைக் கழிக்குமோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"காட்டெருதுக்கு மூக்கணாங்கயிறு போட்டு, அதை உன்னால் உழமுடியுமோ?","poem":1},{"text":"அது உனக்குப்பின் உழுதுகொண்டு வருமோ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அதின் மிகுந்த பலத்தை நம்பி,","poem":1},{"text":"உன் கடின வேலைகளை அதனிடம் விட்டுவிடுவாயோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அது கதிர்க்கட்டுகளைச் சேர்த்து,","poem":1},{"text":"சூடடிக்கும் களத்தில் கொண்டுவந்து சேர்க்கும் என்று நீ அதை நம்புவாயோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“தீக்கோழி தன் சிறகுகளைச் சந்தோஷத்தோடு விரித்தாலும்,","poem":1},{"text":"நாரையின் சிறகுகளுடனும்","poem":2},{"lineBreak":true},{"text":"சிறகுகளுடனும் அதை ஒப்பிட முடியாது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"தீக்கோழி தரையில் முட்டைகளை இட்டு,","poem":1},{"text":"மணலிலே அவற்றைச் சூடாகும்படி விட்டுவிடுகிறது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"முட்டைகள் கால்கள்பட்டு நசுங்கிவிடும் என்றோ,","poem":1},{"text":"காட்டு மிருகங்கள் அவற்றை மிதித்துவிடும் என்றோ அது எண்ணுகிறதில்லை.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அது தன் குஞ்சுகளைத் தன்னுடையது அல்லாததுபோல் கடுமையாக நடத்தும்;","poem":1},{"text":"அதின் பிரயாசம் வீணாய் போகிறதென்றும் அது கவலைப்படுவதில்லை.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஏனெனில், இறைவன் அதற்கு ஞானத்தை கொடுக்கவில்லை;","poem":1},{"text":"நல்லுணர்வையும் கொடுக்கவில்லை.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஆனாலும் அது ஓடுவதற்கு தன் செட்டைகளை விரிக்கின்றபோது,","poem":1},{"text":"குதிரையையும் அதில் சவாரி செய்பவனையும் அலட்சியம் பண்ணுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“குதிரைக்கு அதின் பலத்தை நீ கொடுக்கிறாயோ?","poem":1},{"text":"அதின் கழுத்தைப் பிடரிமயிரினால் மூடியது நீயோ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நீ குதிரையை வெட்டுக்கிளியைப்போல் பாயப்பண்ணி,","poem":1},{"text":"அதின் பெருமையான மூச்சுடன் பயங்கரமூட்டப் பண்ணுகிறாயோ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அது தன் பெலத்தில் மகிழ்ச்சியடைந்து,","poem":1},{"text":"தூசியைக் கிளப்பிக்கொண்டு போர்க்களத்திற்குப் பாய்ந்து செல்கிறது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அது பயத்தைக்கண்டு சிரிக்கிறது; ஒன்றுக்கும் கலங்குவதில்லை.","poem":1},{"text":"அது வாளுக்குப் பயந்து பின்வாங்குவதில்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"மினுமினுக்கும் வேலுடனும் ஈட்டியுடனும் அம்புக்கூடு","poem":1},{"text":"அதனுடைய இடுப்பில் கலகலக்கிறது.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அது உணர்ச்சிவசப்பட்டுப் பதற்றத்துடன் தரையில் விரைந்து செல்கிறது;","poem":1},{"text":"எக்காள சத்தம் கேட்கும்போது, அதினால் அமைதியாய் நிற்கமுடியாது.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"எக்காள முழக்கம் கேட்கும்போது, அது கனைத்து ஆரவாரிக்கும்","poem":1},{"text":"அது போர்க்களத்தையும், படைத் தலைவர்களின் கூக்குரலையும்","poem":2},{"lineBreak":true},{"text":"தூரத்திலிருந்தே மோப்பம் பிடித்து அறிகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"“பருந்து உயரப் பறப்பதும்,","poem":1},{"text":"தெற்கு நோக்கித் தன் சிறகுகளை விரிப்பதும் உன் ஞானத்தினாலேயோ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"கழுகு மேலே போய் உயரத்தில்","poem":1},{"text":"தன் கூட்டைக் கட்டுவது உனது கட்டளையினாலேயோ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அது இரவில் கற்பாறைகளின் வெடிப்புகளில் தங்குகிறது;","poem":1},{"text":"செங்குத்தான பாறைகளே அதின் பாதுகாப்பிடம்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அங்கிருந்து அது தனது உணவைப் பார்க்கும்;","poem":1},{"text":"அதின் கண்கள் தொலைவிலிருக்கும் உணவைக் கண்டுகொள்ளும்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அதின் குஞ்சுள் இரத்தத்தை உண்டு மகிழும்;","poem":1},{"text":"இறந்த உடல்கள் எங்கேயோ அங்கேயே கழுகும் இருக்கும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/38.json","previousChapterAudioLinks":{},"numberOfVerses":30}