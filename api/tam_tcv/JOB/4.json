{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":4,"content":[{"type":"heading","content":["எலிப்பாஸ் பேசுதல்"]},{"type":"verse","number":1,"content":["அப்பொழுது தேமானியனாகிய எலிப்பாஸ் மறுமொழியாக சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"யாராவது ஒருவர் உன்னுடன் பேசத் துணிந்தால்,","poem":1},{"text":"நீ பொறுமையாய் இருப்பாயோ?","poem":2},{"lineBreak":true},{"text":"ஆனால் யாரால்தான் பேசாதிருக்க முடியும்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீ அநேகருக்கு புத்தி சொல்லி,","poem":1},{"text":"தளர்ந்த கைகளைத் திடப்படுத்தியிருக்கிறாய்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"தடுக்கி விழுந்தவர்களை உன் வார்த்தைகள் தாங்கியிருக்கின்றன;","poem":1},{"text":"தள்ளாடிய முழங்கால்களை நீ உறுதிபடுத்தியிருக்கிறாய்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இப்பொழுது உனக்கு கஷ்டம் வந்தபோது, கலங்கிவிட்டாய்;","poem":1},{"text":"அது உன்னைத் தாக்கியதும் நீ மனங்கலங்கிப் போனாய்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உனது பக்தி உனக்கு மனவுறுதியாயும்,","poem":1},{"text":"குற்றமற்ற வழிகள் உனக்கு நல் எதிர்பார்ப்பாயும் இருக்கவேண்டும் அல்லவோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"குற்றமற்றவன் அழிக்கப்பட்டதுண்டோ?","poem":1},{"text":"நேர்மையானவர்கள் அழிக்கப்பட்டதுண்டோ?","poem":2},{"lineBreak":true},{"text":"என இப்பொழுது யோசித்துப்பார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"தீமையை உழுது, துன்பத்தை விதைக்கிறவர்கள்,","poem":1},{"text":"அதையே அறுக்கிறார்கள் என்பதை நான் கண்டிருக்கிறேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இறைவனின் சுவாசத்தினால் அவர்கள் அழிந்து,","poem":1},{"text":"அவருடைய மூக்கின் காற்றினாலே அழிகிறார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"சிங்கங்கள் கர்ஜித்து, உறுமலாம்,","poem":1},{"text":"ஆனாலும் அந்த பெருஞ்சிங்கத்தின் பற்கள் உடைக்கப்படுகின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"சிங்கம் இரையில்லாமல் இறந்துபோகும்,","poem":1},{"text":"சிங்கக் குட்டிகளோ சிதறிப்போகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“இப்பொழுது எனக்கு ஒரு வார்த்தை இரகசியமாய்க் கொண்டுவரப்பட்டது,","poem":1},{"text":"அதின் மெல்லிய ஓசை என் காதுகளில் விழுந்தது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"மனிதர் ஆழ்ந்த நித்திரையில் இருக்கும்போது,","poem":1},{"text":"இரவில் அமைதியைக் கெடுக்கும் கனவுகளின் மத்தியில்,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பயமும் நடுக்கமும் என்னைப் பிடித்தது,","poem":1},{"text":"என் எலும்புகளையெல்லாம் நடுங்கச் செய்தன.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அப்பொழுது ஒரு ஆவி என் முகத்திற்கு","poem":1},{"text":"முன்னால் செல்லுகையில் என் உடலின் முடி சிலிர்த்து நின்றது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆவி நின்றது,","poem":1},{"text":"அதின் தோற்றத்தை என்னால் அடையாளம் காண முடியவில்லை.","poem":2},{"text":"ஒரு உருவம் என் கண்கள் முன் நின்றது,","poem":1},{"text":"அப்பொழுது நான் முணுமுணுக்கும் குரலைக் கேட்டேன்:","poem":2}]},{"type":"verse","number":17,"content":[{"text":"‘மனிதன் இறைவனைவிட நீதிமானாய் இருக்க முடியுமோ?","poem":1},{"text":"தன்னைப் படைத்தவரைவிட அதிக தூய்மையாய் இருப்பானோ?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"இறைவன் தமது ஊழியர்களில் நம்பிக்கை வைக்காமல் இருக்கிறார்,","poem":1},{"text":"அவர் தன் தூதர்களிலும் குறைகண்டிருக்கிறார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அப்படியிருக்க தூசியில் அஸ்திபாரமிட்டு,","poem":1},{"text":"களிமண் வீட்டில் வாழ்பவர்களும்,","poem":2},{"lineBreak":true},{"text":"பூச்சிபோல் நசுக்கப்படுகிறவர்களுமாகிய மனிதரின் குறையை அவர் காணாமலிருப்பாரோ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்கள் காலைமுதல் மாலைவரைக்கும்,","poem":1},{"text":"கவனிப்பார் ஒருவருமில்லாமல் நிலையான அழிவை அடைகிறார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர்களுடைய கூடாரத்தின் கயிறுகள் மேலே இழுக்கப்பட்டு,","poem":1},{"text":"அவை ஞானமில்லாமல் சாவதில்லையா?’","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/3.json","previousChapterAudioLinks":{},"numberOfVerses":21}