{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":40,"content":[{"type":"verse","number":1,"content":["மேலும் யெகோவா யோபுவிடம் சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“எல்லாம் வல்லவருடன் வாதாடுகிறவன் அவரைத் திருத்துவானோ?","poem":1},{"text":"இறைவனைக் குற்றம் சாட்டுகிறவன் அவருக்குப் பதிலளிக்கட்டும்.”","poem":2}]},{"type":"verse","number":3,"content":["யோபு யெகோவாவுக்கு மறுமொழியாக சொன்னது:"]},{"type":"verse","number":4,"content":[{"text":"“நான் தகுதியற்றவன்; நான் உமக்கு என்ன பதிலளிக்க முடியும்?","poem":1},{"text":"நான் என் கையினால் வாயைப் பொத்திக்கொள்ளுகிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நான் ஒருமுறை பேசினேன், ஆமாம் இரண்டொருமுறை பேசினேன், ஆனால் என்னிடம் பதில் இல்லை;","poem":1},{"text":"நான் இனிமேல் ஒன்றுமே சொல்லமாட்டேன்.”","poem":2}]},{"type":"verse","number":6,"content":["அப்பொழுது யெகோவா பெருங்காற்றிலிருந்து யோபுவுடன் பேசினார்:"]},{"type":"verse","number":7,"content":[{"text":"“இப்பொழுது நீ மனிதனைப்போல் திடமாய் நில்;","poem":1},{"text":"நான் உன்னிடம் கேள்வி கேட்பேன்,","poem":2},{"lineBreak":true},{"text":"நீ எனக்குப் பதில் சொல்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“நீ என் நீதியை அவமதிப்பாயோ?","poem":1},{"text":"நீ உன்னை நீதியுள்ளவனாக்குவதற்கு, என்னைக் குற்றவாளியென்று தீர்ப்பாயோ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"உன் புயம் இறைவனுடையதைப் போன்றதோ?","poem":1},{"text":"உன் குரல் அவருடைய குரலைப்போல் முழங்குமோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அப்படியானால் உன்னை மகிமையினாலும் மகத்துவத்தினாலும் அழகுபடுத்தி,","poem":1},{"text":"மேன்மையையும் மாட்சிமையையும் உடுத்திக்கொள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உன் கோபத்தின் சீற்றத்தை வீசி,","poem":1},{"text":"பெருமையுள்ளவர்களைச் சிறுமைப்படுத்து.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பெருமையுள்ள ஒவ்வொரு மனிதனையும் பார்த்து அவர்களைத் தாழ்மைப்படுத்து;","poem":1},{"text":"கொடியவர்களை அவர்கள் நிற்கும் இடத்திலேயே நசுக்கிப் போடு.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் எல்லோரையும் ஒன்றாய் தூசிக்குள் புதைத்துவிடு;","poem":1},{"text":"கல்லறையின் உள்ளே அவர்களின் முகங்களை மூடிப்போடு.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அப்பொழுது உன் வலதுகையே உன்னை மீட்கும்","poem":1},{"text":"என்று நானும் ஒத்துக்கொள்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“இப்பொழுது உன்னோடுகூட","poem":1},{"text":"நான் படைத்த நீர்யானையைப் பார்;","poem":2},{"lineBreak":true},{"text":"அது எருதைப் போலவே புல் மேய்கிறது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அதின் இடுப்பிலுள்ள பலம் எவ்வளவு?","poem":1},{"text":"அதின் வயிற்றின் தசைநார்களின் வலிமை எவ்வளவு?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அதின் வால் கேதுரு மரத்தைப்போல் அசைகிறது;","poem":1},{"text":"அதின் இடுப்பு நரம்புகள் நெருக்கமாகப் பிணைந்திருக்கின்றன.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அதின் எலும்புகள் வெண்கலக் குழாய்களாகவும்,","poem":1},{"text":"கால்கள் இரும்புத் தூண்களைப் போலவும் இருக்கின்றன.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இறைவனின் படைப்புகளில் இதுவே முதலிடம் பெறுகிறது;","poem":1},{"text":"இருந்தும் அதைத் தமது வாளுடன் அணுக அதைப் படைத்தவரால் முடியும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"குன்றுகள் விளைச்சலைக் கொடுக்கும்;","poem":1},{"text":"காட்டு விலங்குகளெல்லாம் அதனருகில் விளையாடும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அது தாமரையின் கீழும்,","poem":1},{"text":"நாணலின் மறைவில் சேற்றிலும் படுத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"தாமரைகளின் நிழல் அதை மூடுகின்றன;","poem":1},{"text":"ஆற்றலறிகள் அதைச் சூழ்ந்து நிற்கின்றன.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஆறு பெருக்கெடுக்கும்போது அது திகிலடைவதில்லை;","poem":1},{"text":"யோர்தான் நதி அதின் வாய்க்கெதிராகப் பெருக்கெடுத்து ஓடினாலும்,","poem":2},{"lineBreak":true},{"text":"அது உறுதியாயிருக்கும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அது பார்த்திருக்க அதை யார் பிடிக்கமுடியும்?","poem":1},{"text":"மூக்கணாங்கயிறுபோட அதின் மூக்கை யார் குத்தமுடியும்?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/39.json","previousChapterAudioLinks":{},"numberOfVerses":24}