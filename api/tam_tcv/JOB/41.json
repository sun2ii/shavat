{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":41,"content":[{"type":"verse","number":1,"content":[{"text":"“லிவியாதான் என்னும் பெரிய பாம்பைத் தூண்டிலினால் பிடிக்க முடியுமோ?","poem":1},{"text":"நீ அதின் நாக்கைக் கயிற்றினால் கட்டமுடியுமோ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அதற்கு மூக்கணாங்கயிறு போட்டுக் கட்டமுடியுமோ?","poem":1},{"text":"அல்லது அதின் தாடையைக் கொக்கியினால் ஊடுருவக் குத்த உன்னால் முடியுமோ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அது உன்னிடத்தில் இரக்கம் கேட்டு, மன்றாடிக்கொண்டிருக்குமோ?","poem":1},{"text":"உன்னிடம் மெதுவான வார்த்தையைப் பேசுமோ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"வாழ்நாள் முழுவதும் நீ அதை அடிமையாக்கிக்கொள்ளும்படி,","poem":1},{"text":"அது உன்னுடன் ஒரு உடன்படிக்கை செய்யுமோ?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஒரு பறவையைப்போல் நீ அதை வளர்க்க முடியுமோ?","poem":1},{"text":"உன் பெண் பிள்ளைகள் அதனுடன் விளையாட அதைக் கட்டிவைப்பாயோ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வியாபாரிகள் அதைப் பரிமாறிக்கொள்வார்களோ?","poem":1},{"text":"அதை அவர்கள் வர்த்தகர் நடுவில் பங்கிட்டுக்கொள்வார்களோ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அதின் உடலை ஈட்டிகளினாலும்,","poem":1},{"text":"அதின் தலையைக் கூர்மையான மீன்பிடி ஈட்டியால் குத்துவாயோ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அதின்மேல் உன் கையைப்போட்டால், அது அடிப்பதை நீ மறக்கமாட்டாய்;","poem":1},{"text":"இனி அதின்மேல் கைபோடவுமாட்டாய்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அதை அடக்குவதற்கான எந்த எதிர்பார்ப்பும் வீணானது;","poem":1},{"text":"அதின் தோற்றமே பயமுறுத்தக் கூடியது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அதை எழுப்ப தைரியமுள்ளவன் இல்லை.","poem":1},{"text":"அப்படியிருக்க என்னை எதிர்த்துநிற்க யாரால் முடியும்?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"தனக்கு பதில் கொடுக்கவேண்டுமென்று முந்தி எனக்குக் கொடுத்தவன் யார்?","poem":1},{"text":"வானத்தின் கீழே இருப்பவை ஒவ்வொன்றும் என்னுடையவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“இப்பொழுது நான் லிவியாதானின் கால்களைப்பற்றியும்,","poem":1},{"text":"அதின் பலத்தைப் பற்றியும், வசீகரத் தோற்றத்தைப்பற்றியும் பேசத் தவறமாட்டேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அதின் மேற்தோலை உரிக்கக்கூடியவன் யார்?","poem":1},{"text":"அதை மூக்கணாங்கயிற்றுடன் அணுக யாரால் முடியும்?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பயங்கரப் பற்கள் நிறைந்த","poem":1},{"text":"அதின் வாயின் தாடையைப் பிடித்துத் திறக்கக்கூடியவன் யார்?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அதின் முதுகில் உள்ள செதில்கள் நெருங்கி","poem":1},{"text":"இணைக்கப்பட்ட கேடய வரிசைகள்போல் இருக்கின்றன.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவைகளின் ஒவ்வொரு வரிசையும்","poem":1},{"text":"காற்றுப் புகாதபடி மிக நெருக்கமாய் இருக்கின்றன.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவை ஒன்றோடொன்று நெருக்கமாய் இணைந்து","poem":1},{"text":"பிரிக்க முடியாதவாறு, ஒட்டிக்கொண்டிருக்கின்றன.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அது மூச்சுவிடும்போது அனல் வீசுகிறது;","poem":1},{"text":"அதின் கண்கள் அதிகாலையின் ஒளிக்கீற்றுகளைப்போல் இருக்கின்றன.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அதின் வாயிலிருந்து நெருப்புத் தணல்கள் புறப்பட்டு,","poem":1},{"text":"நெருப்புப் பொறிகளும் பறக்கும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"எரியும் நாணல்மீது கொதிக்கும் சட்டியிலிருந்து எழும்புவதுபோல்,","poem":1},{"text":"அதின் மூக்கிலிருந்து புகை புறப்படும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அதின் மூச்சு கரியைக் கொழுத்தி எரியச்செய்கிறது;","poem":1},{"text":"அதின் வாயிலிருந்து ஜூவாலை பாய்கிறது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அதின் கழுத்திலே வல்லமை இருக்கும்;","poem":1},{"text":"திகில் அதற்கு முன்னே செல்லும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அதின் தசை மடிப்புகள் அசைக்க முடியாதபடி","poem":1},{"text":"ஒன்றோடொன்று இறுக்கமாக இணைக்கப்பட்டிருக்கின்றன.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அதின் நெஞ்சு கற்பாறையைப்போலவும்,","poem":1},{"text":"அம்மிக் கல்லைப்போலவும் கடினமானதாய் இருக்கிறது.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அது எழும்பும்போது பலவான்கள் திகிலடைந்து,","poem":1},{"text":"அதின் தாக்குதலுக்கு பயந்து ஓடுகிறார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அதைத் தாக்குகிறவனுடைய வாள், ஈட்டி, அம்பு,","poem":1},{"text":"கவசம், ஒன்றும் அதற்குமுன் நிற்காது.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அது இரும்பை வைக்கோலாகவும்,","poem":1},{"text":"வெண்கலத்தை உளுத்துப்போன மரமாகவும் மதிப்பிடும்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அம்பு அதனைத் துரத்தாது;","poem":1},{"text":"கவண்கற்கள் அதற்குப் பதரைப் போலிருக்கும்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"பெருந்தடி அதற்கு வைக்கோல் போன்றது;","poem":1},{"text":"அது ஈட்டியின் சத்தத்திற்கு நகைக்கிறது.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அதின் அடிப்பக்கம் கூர்மையான கற்கள் கிடந்தாலும்,","poem":1},{"text":"சூடடிக்கும் இயந்திரம் சேற்றில் ஏற்படுத்தும் அடையாளத்தை ஏற்படுத்தி செல்கிறது.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"அது கொதிக்கும் பானையைப்போல் ஆழ்கடல்களைப் பொங்கச்செய்து,","poem":1},{"text":"தைலம்போலக் கடலைக் கலக்குகிறது.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அது தன் பின்னால் பாதையை மின்னச்செய்யும்;","poem":1},{"text":"அப்பொழுது ஆழமானது வெளுப்பான நரையைப்போல் தோன்றும்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"பூமியின்மேல் உள்ளதொன்றும் அதற்கு நிகரானதல்ல;","poem":1},{"text":"அது பயமற்ற ஒரு விலங்கு.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"அகந்தையான எல்லாவற்றையும் அது அற்பமாய் எண்ணுகிறது;","poem":1},{"text":"பெருமைகொண்ட எல்லாவற்றுக்கும் மேலான அரசன் அதுவே.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/40.json","previousChapterAudioLinks":{},"numberOfVerses":34}