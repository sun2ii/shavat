{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“நீ விரும்பினால் கூப்பிட்டுப் பார், ஆனால் யார் உனக்குப் பதிலளிப்பார்?","poem":1},{"text":"பரிசுத்தர்களில் யாரிடம் நீ திரும்புவாய்?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"கோபம் மூடனைக் கொல்லும்,","poem":1},{"text":"பொறாமை புத்தியில்லாதவனைக் கொல்லும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"மூடன் நிலைகொள்வதை நானே கண்டிருக்கிறேன்,","poem":1},{"text":"ஆனாலும் உடனே அவன் குடும்பத்திற்கு அழிவு வருகிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவனுடைய பிள்ளைகள் பாதுகாப்பின்றி இருக்கிறார்கள்,","poem":1},{"text":"வழக்காடுகிறவர்கள் இல்லாமல் நீதிமன்றத்தில் நசுக்கப்படுகிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பசியுள்ளவர்கள் அவனுடைய அறுவடையை","poem":1},{"text":"முட்செடிகளுக்குள் இருந்துங்கூட எடுத்துச் சாப்பிடுவார்கள்;","poem":2},{"lineBreak":true},{"text":"பேராசைக்காரர் அவனுடைய செல்வத்திற்காகத் துடிப்பர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஏனெனில் கஷ்டம் மண்ணிலிருந்து எழும்புவதில்லை;","poem":1},{"text":"தொல்லை நிலத்திலிருந்து முளைப்பதுமில்லை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"தீப்பொறிகள் மேலே பறக்கிறதுபோல,","poem":1},{"text":"மனிதன் தொல்லைகளை அனுபவிக்கப் பிறந்திருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“ஆனாலும் நான், இறைவனைத் தேடி,","poem":1},{"text":"அவருக்குமுன் எனது வழக்கை வைத்திருப்பேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் ஆராய முடியாத அதிசயங்களையும்,","poem":1},{"text":"கணக்கிடமுடியாத அற்புதங்களையும் செய்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"பூமிக்கு மழையைக் கொடுக்கிறவர் அவரே;","poem":1},{"text":"நாட்டுப்புறங்களுக்குத் தண்ணீரை அனுப்புகிறவரும் அவரே.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவரே தாழ்மையானவர்களை உயர்த்தி,","poem":1},{"text":"துயரத்தில் இருப்பவர்களையும் பாதுகாத்து உயர்த்துகிறார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் தந்திரமானவர்களின் கைகளுக்கு வெற்றி கிடைக்காதபடி,","poem":1},{"text":"அவர்களுடைய திட்டங்களை முறியடிக்கிறார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இறைவன் ஞானிகளை அவர்களுடைய தந்திரத்திலேயே பிடிக்கிறார்,","poem":1},{"text":"தந்திரமுள்ளவர்களின் திட்டங்கள் தள்ளப்படுகின்றன.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பகல் நேரத்தில் காரிருள் அவர்கள்மேல் வரும்;","poem":1},{"text":"இரவில் தடவித்திரிவதுபோல் நண்பகலிலும் தடவித் திரிவார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"இறைவன் ஒடுக்குவோரின் வாளிலிருந்து வறுமையுள்ளோரை விடுவித்து,","poem":1},{"text":"வன்முறையாளரின் கையிலிருந்து அவர்களைக் காப்பாற்றுகிறார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆதலால் ஏழைகளுக்கு எதிர்கால நம்பிக்கை உண்டு,","poem":1},{"text":"அநீதி தன் வாயை மூடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“இறைவனால் திருத்தப்படுகிறவன் ஆசீர்வதிக்கப்பட்டவன்;","poem":1},{"text":"எனவே எல்லாம் வல்லவரின் கண்டிப்பை நீ அசட்டை பண்ணாதே.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர் காயப்படுத்திக் காயத்தைக் கட்டுகிறார்;","poem":1},{"text":"அவர் அடிக்கிறார், அவருடைய கை ஆற்றுகிறது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ஆறு பெரும் துன்பங்களிலும் உன்னைக் கைவிடாமல் காப்பார்;","poem":1},{"text":"அவை ஏழானாலும் ஒரு தீமையும் உன்மேல் வராது.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"பஞ்சத்தில் சாவிலிருந்தும்","poem":1},{"text":"யுத்தத்தின் வாளுக்கு இரையாகாமலும் விலக்கிக் காப்பார்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"தூற்றும் நாவிலிருந்து நீ பாதுகாக்கப்படுவாய்;","poem":1},{"text":"பேராபத்து வரும்போதும் நீ பயப்படாமலிருப்பாய்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அழிவையும் பஞ்சத்தையும் கண்டு நீ சிரிப்பாய்;","poem":1},{"text":"நீ பூமியிலுள்ள காட்டு மிருகங்களுக்கும் பயப்பட வேண்டியதில்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"வயல்வெளியின் கற்களுடன் நீ ஒரு ஒப்பந்தம் செய்துகொள்வாய்,","poem":1},{"text":"காட்டு விலங்குகளும் உன்னுடன் சமாதானமாய் இருக்கும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"உன் கூடாரம் பாதுகாக்கப்பட்டிருப்பதை நீ அறிவாய்;","poem":1},{"text":"உன் உடைமைகளைக் கணக்கெடுக்கும்போது ஒன்றும் குறைவுபடாதிருப்பதையும் நீ காண்பாய்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உன் பிள்ளைகள் அநேகராய் இருப்பார்கள் என்பதை நீ அறிவாய்.","poem":1},{"text":"உன் சந்ததிகள் பூமியின் புற்களைப்போல் இருப்பார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ஏற்றகாலத்தில் தானியக்கதிர்கள் ஒன்று சேர்க்கப்படுவதுபோல்,","poem":1},{"text":"உன் முதிர்வயதிலே நீ கல்லறைக்குப் போவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"“நாங்கள் ஆராய்ந்து பார்த்ததில் இவை உண்மை என்று கண்டோம்.","poem":1},{"text":"நீ இவற்றைக் கேட்டு, உனக்கும் இவை பொருந்தும் என்று எடுத்துக்கொள்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}