{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":6,"content":[{"type":"heading","content":["யோபு பதிலளித்தல்"]},{"type":"verse","number":1,"content":["யோபு மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“என் பிரச்சனைகளும், துன்பங்களும் தராசிலே வைக்கப்பட்டு","poem":1},{"text":"நிறுக்கப்பட்டால் நலமாயிருக்கும்!","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவை கடற்கரை மணலைவிட பாரமாயிருக்கும்;","poem":1},{"text":"ஆகவே எனது வார்த்தைகள் மூர்க்கமாய் இருப்பது ஆச்சரியமல்லவே.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"எல்லாம் வல்லவரின் அம்புகள் என்னில் பாய்ந்திருக்கின்றன,","poem":1},{"text":"என் ஆவி அவைகளின் நஞ்சைக் குடிக்கிறது;","poem":2},{"lineBreak":true},{"text":"இறைவனின் பயங்கரங்கள் எனக்கெதிராய் அணிவகுத்து நிற்கின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தனக்குப் புல் இருக்கும்போது காட்டுக் கழுதை கத்துமோ?","poem":1},{"text":"தீனி இருக்கும்போது எருது கதறுமோ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"சுவையில்லாத உணவு உப்பின்றி சாப்பிடப்படுமோ?","poem":1},{"text":"முட்டையின் வெள்ளைக்கருவில் ஏதேனும் சுவை உண்டோ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இப்படியான உணவு என்னை நோயாளியாக்குகிறது;","poem":1},{"text":"நான் அதைத் தொட மறுக்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“நான் வேண்டிக்கொள்வதையும்,","poem":1},{"text":"நான் நம்பி எதிர்பார்ப்பதையும் இறைவன் எனக்குக் கொடுக்கட்டும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இறைவன் என்னை நசுக்க உடன்படட்டும்,","poem":1},{"text":"தன் கையை நீட்டி என்னை வெட்டிப்போடட்டும்!","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இந்த ஆறுதல் எனக்கு இன்னும் இருக்கும்;","poem":1},{"text":"எனது முடிவில்லாத வேதனையிலும்","poem":2},{"lineBreak":true},{"text":"பரிசுத்தரின் வார்த்தைகளை நான் மறுக்கவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“நான் இன்னும் எதிர்பார்ப்புடன் இருக்க எனக்கு என்ன பெலன் இருக்கிறது?","poem":1},{"text":"நான் இன்னும் பொறுமையாய் இருக்க என் முடிவு என்ன?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஒரு கல்லின் பெலன் எனக்கு உண்டோ?","poem":1},{"text":"எனது சதை வெண்கலமோ?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"எனக்கே நான் உதவிசெய்யத்தக்க வல்லமை என்னில் உண்டோ?","poem":1},{"text":"வெற்றிக்கான ஆதாரம் என்னைவிட்டு நீங்கிற்று.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“எதிர்பார்ப்பில்லாதவன், எல்லாம் வல்லவரைப் பற்றிய","poem":1},{"text":"பயத்தைக் கைவிட்ட போதிலும்,","poem":2},{"lineBreak":true},{"text":"அவனுக்கு அவனுடைய நண்பர்களின் தயவு இருக்கவேண்டும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆனால் என் சகோதரர்களோ, விட்டுவிட்டு பொங்கி ஓடும்","poem":1},{"text":"பருவகால நீரோடைகளைப்போல, நம்பத்தகாதவர்களாய் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவைகள் குளிர்காலப் பனிக்கட்டியினாலும்,","poem":1},{"text":"அதில் விழுந்திருக்கிற உறைந்த மழையினாலும் வழிந்தோடும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆனால் வெப்பக் காலத்தில் வற்றி,","poem":1},{"text":"வெயிலில் கால்வாய்களிலிருந்து மறைந்துபோகின்றன.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"வியாபாரிகளின் கூட்டம் நீரோடையைத் தேடி;","poem":1},{"text":"பாதையைவிட்டு விலகி பாழ்நிலங்களுக்குச் சென்று அழிகின்றன.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"தேமாவின் வியாபாரிகளும், சேபாவின் வியாபாரிகளும்","poem":1},{"text":"தண்ணீரைத் தேடி நம்பிக்கையுடன் எதிர்பார்க்கிறார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்கள் நம்பிக்கையுடன் போனதால் வருத்தப்படுகிறார்கள்;","poem":1},{"text":"அவ்விடத்தைச் சேர்ந்ததும் ஏமாற்றமடைகிறார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"இப்பொழுது நீங்களும் அப்படியே எனக்கு உதவாமல் போனீர்கள்;","poem":1},{"text":"என் ஆபத்தைக் கண்டு பயப்படுகிறீர்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நான், ‘எனக்காக எதையாவது கொடுங்கள் என்றோ,","poem":1},{"text":"உங்கள் செல்வத்தினால் என்னை மீட்டுக்கொள்ளுங்கள் என்றோ,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"என் பகைவரின் கைகளிலிருந்து என்னை விடுவியுங்கள் என்றோ,","poem":1},{"text":"கொடியவர்களின் பிடியிலிருந்து என்னை மீட்டு விடுங்கள்’ என்றோ நான் சொன்னதுண்டா?","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"“எனக்கு போதியுங்கள்; நான் மவுனமாய் இருப்பேன்;","poem":1},{"text":"நான் எதிலே தவறு செய்தேனோ அதை எனக்குக் காட்டுங்கள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நேர்மையான வார்த்தைகள் எவ்வளவு வேதனையாக இருக்கின்றன!","poem":1},{"text":"ஆனால் உங்கள் விவாதங்கள் எதை நிரூபிக்கின்றன?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நான் சொன்னவற்றைத் திருத்த எண்ணுகிறீர்களோ?","poem":1},{"text":"மனச்சோர்வுற்ற மனிதரின் வார்த்தைகளை வெறும் காற்றாக மதிக்கிறீர்களோ?","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அநாதைகளுக்கு எதிராகக்கூட நீங்கள் சீட்டுப்போடுவீர்கள்;","poem":1},{"text":"உங்கள் நண்பர்களை விற்பதற்கும் பேரம் பேசுவீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“ஆனால் இப்பொழுதோ தயவாக என்னைப் பாருங்கள்.","poem":1},{"text":"உங்கள் முகத்துக்கு முன்பாக நான் பொய் சொல்வேனா?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"போதும் விட்டுவிடுங்கள், அநியாயஞ்செய்ய வேண்டாம்;","poem":1},{"text":"பொறுங்கள், நீதி இன்னும் என் பக்கமிருக்கிறது.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"என் உதடுகளில் அநீதி உண்டோ?","poem":1},{"text":"என் வாய் வஞ்சகத்தை நிதானித்து அறியாதோ?","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/5.json","previousChapterAudioLinks":{},"numberOfVerses":30}