{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“பூமியில் வாழ்வது மனிதனுக்கு போராட்டந்தானே?","poem":1},{"text":"அவனுடைய நாட்கள் கூலிக்காரனின் நாட்களைப் போன்றதல்லவா?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஒரு வேலையாள் மாலை நிழலுக்கு ஏங்குவது போலவும்,","poem":1},{"text":"கூலியாள் தன் கூலிக்காக காத்திருப்பது போலவும்,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பயனற்ற மாதங்களும்,","poem":1},{"text":"துன்பமான இரவுகளும் எனக்கு ஒதுக்கப்பட்டன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் படுக்கும்போது, ‘எழும்ப எவ்வளவு நேரமாகும்?’ என எண்ணுகிறேன்;","poem":1},{"text":"இரவு நீண்டுகொண்டே போகிறது, நானோ விடியும்வரை புரண்டு கொண்டிருக்கிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என் உடல் புழுக்களினாலும் புண்களின் பொருக்குகளினாலும் மூடப்பட்டிருக்கிறது,","poem":1},{"text":"எனது தோல் வெடித்துச் சீழ்வடிகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“நெய்கிறவர்களின் நாடாவைவிட என் நாட்கள் வேகமாய் போகின்றன;","poem":1},{"text":"அவை எதிர்பார்ப்பு எதுவும் இல்லாமலேயே முடிவடைகின்றன.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் இறைவனே, என் வாழ்வு ஒரு சுவாசம்தான் என்பதை நினைவுகூரும்;","poem":1},{"text":"என் கண்கள் இனி ஒருபோதும் சந்தோஷத்தைக் காண்பதில்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"இப்பொழுது என்னைக் காணும் கண்கள், இனி ஒருபோதும் என்னைக் காண்பதில்லை;","poem":1},{"text":"நீ என்னைத் தேடுவாய், நான் இருக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மேகம் கலைந்து போவதுபோல்,","poem":1},{"text":"பாதாளத்திற்குப் போகிறவனும் திரும்பி வருகிறதில்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவன் இனி தன் வீட்டிற்குத் திரும்பமாட்டான்,","poem":1},{"text":"அவனுடைய இடம் இனி அவனை அறிவதுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ஆதலால் நான் இனி அமைதியாய் இருக்கமாட்டேன்;","poem":1},{"text":"எனது ஆவியின் வேதனையினால் நான் பேசுவேன்,","poem":2},{"lineBreak":true},{"text":"எனது ஆத்தும கசப்பினால் நான் முறையிடுவேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீர் என்மேல் காவல் வைத்திருப்பதற்கு நான் கடலா?","poem":1},{"text":"அல்லது ஆழங்களில் இருக்கிற பெரிய விலங்கா?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"என் கட்டில் எனக்கு ஆறுதல் கொடுக்கும் என்றும்,","poem":1},{"text":"என் படுக்கையில் எனக்கு அமைதி கிடைக்கும் என்றும் நான் நினைத்தாலும்,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நீர் கனவுகளால் என்னைப் பயமுறுத்தி,","poem":1},{"text":"தரிசனங்களால் என்னைத் திகிலடையச் செய்கிறீர்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"இவ்வாறாக நான் என் உடலில் வேதனைப்படுவதைப் பார்க்கிலும்,","poem":1},{"text":"குரல்வளை நெரிக்கப்பட்டு சாவதை விரும்புகிறேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நான் என் வாழ்க்கையை வெறுக்கிறேன்;","poem":1},{"text":"என்றென்றும் நான் உயிரோடிருக்க விரும்பவில்லை,","poem":2},{"lineBreak":true},{"text":"என்னை விட்டுவிடுங்கள்; என் வாழ்நாட்கள் பயனற்றவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“நீர் மனிதனை முக்கியமானவன் என எண்ணுவதற்கும்,","poem":1},{"text":"அவனில் நீர் கவனம் செலுத்துவதற்கும்,","poem":2}]},{"type":"verse","number":18,"content":[{"text":"காலைதோறும் அவனை விசாரிக்கிறதற்கும்,","poem":1},{"text":"ஒவ்வொரு வினாடியும் அவனைச் சோதித்தறிவதற்கும் அவன் யார்?","poem":2}]},{"type":"verse","number":19,"content":[{"text":"நீர் உமது பார்வையை என்னைவிட்டு ஒருபோதும் அகற்றமாட்டீரோ?","poem":1},{"text":"ஒரு நொடிப்பொழுதேனும் என்னைத் தனிமையில் விடமாட்டீரோ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"மானிடரைக் காப்பவரே,","poem":1},{"text":"நான் பாவம் செய்திருந்தால், உமக்கெதிராய் நான் செய்தது என்ன?","poem":2},{"text":"நீர் என்னை உமது இலக்காக வைத்திருப்பது ஏன்?","poem":1},{"text":"நான் உமக்குச் சுமையாகிவிட்டேனா?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"நீர் ஏன் என் குற்றங்களை அகற்றவில்லை?","poem":1},{"text":"என் பாவங்களை ஏன் மன்னிக்கவில்லை?","poem":2},{"text":"இப்பொழுதே நான் இறந்து தூசியில் போடப்படுவேன்.","poem":1},{"text":"நீர் என்னைத் தேடும்போது, நான் இருக்கமாட்டேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/6.json","previousChapterAudioLinks":{},"numberOfVerses":21}