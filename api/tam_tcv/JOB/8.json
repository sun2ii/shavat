{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":8,"content":[{"type":"heading","content":["பில்தாத் பேசுதல்"]},{"type":"verse","number":1,"content":["அதற்கு சூகியனான பில்தாத் மறுமொழியாக சொன்னதாவது:"]},{"type":"verse","number":2,"content":[{"text":"“நீ எதுவரைக்கும் இவைகளைப் பேசிக்கொண்டிருப்பாய்?","poem":1},{"text":"உன் வார்த்தைகள் சீற்றமாய் வீசும் காற்றைப்போல் இருக்கின்றன.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இறைவன் நீதியைப் புரட்டுவாரோ?","poem":1},{"text":"எல்லாம் வல்லவர் நியாயத்தைப் புரட்டுவாரோ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உன் பிள்ளைகள் அவருக்கு விரோதமாய்ப் பாவம் செய்தபோது,","poem":1},{"text":"அவர்களின் பாவத்தின் தண்டனைக்கு அவர்களை ஒப்புக்கொடுத்திருக்கிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீ இறைவனை நோக்கிப்பார்த்து,","poem":1},{"text":"எல்லாம் வல்லவரிடம் மன்றாடுவாயானால்,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீ தூய்மையும் நேர்மையும் உள்ளவனாயிருந்தால்,","poem":1},{"text":"இப்பொழுதும் அவர் உன் சார்பாக எழுந்து,","poem":2},{"lineBreak":true},{"text":"உன்னை உனக்குரிய இடத்தில் திரும்பவும் வைப்பார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உன் ஆரம்பம் அற்பமானதாயிருந்தாலும்,","poem":1},{"text":"உன் எதிர்காலம் மிகவும் செழிப்பானதாக இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“முந்திய தலைமுறையினரிடம் விசாரித்து,","poem":1},{"text":"அவர்கள் முற்பிதாக்கள் கற்றுக்கொண்டதைக் கேட்டுப்பார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நாமோ நேற்றுப் பிறந்தவர்கள், ஒன்றும் அறியாதவர்கள்;","poem":1},{"text":"பூமியில் நமது நாட்கள் நிழலாய்த்தான் இருக்கின்றன.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் உனக்கு அறிவுறுத்திச் சொல்லமாட்டார்களா?","poem":1},{"text":"அவர்கள் தாங்கள் விளங்கிக்கொண்டதிலிருந்து உனக்கு விளக்கமளிக்கமாட்டார்களா?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"சேறில்லாமல் நாணல் ஓங்கி வளருமோ?","poem":1},{"text":"தண்ணீரில்லாமல் கோரைப்புல் முளைக்குமோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவை வளர்ந்து அறுக்கப்படாமலிருந்தும்,","poem":1},{"text":"மற்றப் புற்களைவிட மிக விரைவாக வாடிப்போகின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இறைவனை மறக்கிற அனைவரின் வழிகளும் இவ்வாறே இருக்கும்;","poem":1},{"text":"இறைவனை மறுதலிப்போரின் நம்பிக்கையும் அப்படியே அழிந்துபோகும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அப்படிப்பட்டவன் நம்பியிருப்பவை வலுவற்றவை;","poem":1},{"text":"அவன் சிலந்தி வலைகளிலேயே நம்பிக்கை வைத்திருக்கிறான்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவன் அறுந்துபோகும் வலையில் சாய்கிறான்;","poem":1},{"text":"அவன் அதைப் பிடித்துத் தொங்கினாலும் அது அவனைத் தாங்காது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவன் வெயிலில் நீர் ஊற்றப்பட்ட செடியைப்போல் இருக்கிறான்;","poem":1},{"text":"அது தன் தளிர்களைத் தோட்டம் முழுவதும் படரச்செய்து,","poem":2}]},{"type":"verse","number":17,"content":[{"text":"தன் வேர்களினால்","poem":1},{"text":"கற்களுக்குள்ளே தனக்கு இடத்தைத் தேடுகிறது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அது அதின் இடத்திலே இருந்து பிடுங்கப்படும்போது","poem":1},{"text":"அது இருந்த இடம், ‘நான் ஒருபோதும் உன்னைக் கண்டதில்லை’ என மறுதலிக்கும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அதின் உயிர் வாடிப்போகிறது,","poem":1},{"text":"அந்த நிலத்திலிருந்து வேறு செடிகள் வளர்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“இறைவன் குற்றமில்லாதவனைத் தள்ளிவிடமாட்டார்;","poem":1},{"text":"தீமை செய்பவர்களின் கைகளைப் பலப்படுத்தவும் மாட்டார்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர் இன்னும் உன் வாயைச் சிரிப்பினாலும்,","poem":1},{"text":"உன் உதடுகளை மகிழ்ச்சியின் சத்தத்தினாலும் நிரப்புவார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"உன் பகைவர்கள் வெட்கத்தால் மூடப்படுவார்கள்,","poem":1},{"text":"கொடியவர்களின் கூடாரங்கள் இல்லாதொழிந்து போகும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/7.json","previousChapterAudioLinks":{},"numberOfVerses":22}