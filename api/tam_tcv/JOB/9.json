{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOB","translationId":"tam_tcv","name":"யோபு","commonName":"யோபு","title":"யோபுவின் சரித்திரம்","order":18,"numberOfChapters":42,"sha256":"b3ae9b761dd6c5b613f609f2f7c1b8c0f51c0baeed7af2b1203261447dc9db3a","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tam_tcv/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":9,"content":[{"type":"heading","content":["யோபு பேசுதல்"]},{"type":"verse","number":1,"content":["அப்பொழுது யோபு மறுமொழியாக சொன்னது:"]},{"type":"verse","number":2,"content":[{"text":"“நீ சொல்வது உண்மையென நான் அறிவேன்.","poem":1},{"text":"மனிதன் எப்படி இறைவனுக்கு முன்பாக நீதிமானாக இருக்கமுடியும்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இறைவனோடு மனிதன் வாதாட விரும்பினால்,","poem":1},{"text":"அவர் கேட்கும் ஆயிரத்தில் ஒரு கேள்விக்குக்கூட அவனால் பதிலளிக்க முடியாது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இறைவன் இருதயத்தில் ஞானமுள்ளவர், வல்லமையில் பலமுள்ளவர்.","poem":1},{"text":"அவரை எதிர்த்து சேதமின்றித் தப்பினவன் யார்?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர் மலைகளை அவைகளுக்குத் தெரியாமலே நகர்த்துகிறார்;","poem":1},{"text":"அவர் தன் கோபத்தில் அவற்றைப் புரட்டிப் போடுகிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் பூமியின் தூண்கள் அதிரும்படி அதை அதின்,","poem":1},{"text":"இடத்திலிருந்து அசையவைக்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் கட்டளையிட்டால், சூரியனும் ஒளி கொடாதிருக்கும்;","poem":1},{"text":"நட்சத்திரங்களின் ஒளியையும் மூடி மறைக்கிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர் தனிமையாகவே வானங்களை விரித்து,","poem":1},{"text":"கடல் அலைகளின்மேல் மிதிக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"சப்தரிஷி, மிருகசீரிடம், கார்த்திகை நட்சத்திரங்களையும்,","poem":1},{"text":"தென்திசை நட்சத்திரக் கூட்டங்களையும் படைத்தவர் அவரே.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் ஆழ்ந்தறிய முடியாத அதிசயங்களையும்","poem":1},{"text":"அவர் கணக்கிடமுடியாத அற்புதங்களையும் செய்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர் என்னைக் கடந்து செல்லும்போது, அவரை என்னால் காணமுடியாது;","poem":1},{"text":"அவர் என் அருகில் வரும்போது, அவரை என்னால் பார்க்க முடியாது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் எதையும் பறித்தெடுத்தால் அதை யாரால் நிறுத்த முடியும்?","poem":1},{"text":"‘நீர் என்ன செய்கிறீர்?’ என யாரால் அவரிடம் கேட்க முடியும்?","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இறைவன் தமது கோபத்தைக் கட்டுப்படுத்தவில்லை;","poem":1},{"text":"ராகாப் என்ற பெரிய விலங்கைச் சேர்ந்தவர்களும்","poem":2},{"lineBreak":true},{"text":"அவருடைய காலடியில் அடங்கிக் கிடந்தனர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“இப்படியிருக்க, நான் அவரோடு எப்படி விவாதம் செய்வேன்?","poem":1},{"text":"அவரோடு வாதாடும் வார்த்தைகளை நான் எங்கே கண்டுபிடிப்பேன்?","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் நீதிமானாயிருந்தாலும் என்னால் அவருடன் வழக்காட முடியாது;","poem":1},{"text":"எனது நீதிபதியிடம் இரக்கத்திற்காக மன்றாடத்தான் என்னால் முடியும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர் என் அழைப்பிற்கு இணங்கினாலும்,","poem":1},{"text":"என் விண்ணப்பத்திற்குச் செவிகொடுப்பார் என நான் நம்பவில்லை.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர் என்னைப் புயலினால் தாக்குவார்;","poem":1},{"text":"காரணமில்லாமல் அவர் என் காயங்களைப் பலுகச்செய்வார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர் என்னைத் திரும்பவும்","poem":1},{"text":"மூச்சுவிட முடியாமல் துன்பத்திற்குள் அமிழ்த்தி விடுவார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"பெலத்தை மட்டும் எடுத்துக்கொண்டால் அவரே வல்லமையுடையவர்.","poem":1},{"text":"நீதியை எடுத்துக்கொண்டால் அவரை விசாரணைக்கு அழைப்பவன் யார்?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நான் மாசற்றவனாய் இருந்தாலும் என் வாயே எனக்குக் குற்றத் தீர்ப்பளிக்கும்;","poem":1},{"text":"நான் குற்றமற்றவனாய் இருந்தாலும், அது என்னைக் குற்றவாளி எனத் தீர்க்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“நான் குற்றமற்றவன்,","poem":1},{"text":"என்னைப்பற்றி எனக்கு அக்கறையில்லை;","poem":2},{"lineBreak":true},{"text":"என் சொந்த வாழ்வையே நான் வெறுக்கிறேன்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"எல்லாம் ஒன்றுதான்; அதினால்தான் நான் சொல்கிறேன்,","poem":1},{"text":"‘குற்றமற்றவர்களையும், கொடியவர்களையும் அவர் அழிக்கிறார்.’","poem":2}]},{"type":"verse","number":23,"content":[{"text":"வாதை திடீர் மரணத்தைக் கொண்டுவரும்போது,","poem":1},{"text":"அவர் குற்றமற்றவனின் தவிப்பைக் கண்டு ஏளனம் செய்கிறார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நாடு கொடியவர்களின் கையில் விழும்போது,","poem":1},{"text":"அவர் அதின் நீதிபதிகளின் கண்களை மூடிக் கட்டுகிறார்.","poem":2},{"lineBreak":true},{"text":"அவர் அதைச் செய்யவில்லையென்றால் அதைச் செய்வது வேறு யார்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“எனது நாட்கள் ஓடுபவனைவிட வேகமாய்ப் போகின்றன;","poem":1},{"text":"அவை ஒருகண நேர மகிழ்ச்சியும் இல்லாமல் பறந்து போகின்றன.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நாணல் படகுகள் வேகமாகச் செல்வது போலவும்,","poem":1},{"text":"தங்கள் இரைமேல் பாய்கிற கழுகுகளைப் போலவும் அவை பறந்து போகின்றன.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"‘நான் என் குற்றச்சாட்டை மறந்து, என் முகபாவனையை மாற்றி சிரிப்பேன்’","poem":1},{"text":"என்று சொன்னாலும்,","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நான் இன்னும் என் பாடுகளைக் குறித்துத் திகிலடைகிறேன்;","poem":1},{"text":"நீர் என்னைக் குற்றமற்றவனாக எண்ணமாட்டீர் என்றும் அறிவேன்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"நான் ஏற்கெனவே குற்றவாளி என்பது தீர்க்கப்பட்டிருக்க,","poem":1},{"text":"ஏன் வீணாய் போராட வேண்டும்?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"நான் என்னை பனிநீரினால் கழுவினாலும்,","poem":1},{"text":"என் கைகளை சோப்பினால் சுத்தப்படுத்தினாலும்,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"நீர் என்னைச் சேற்றின் குழிக்குள் அமிழ்த்துவீர்.","poem":1},{"text":"அப்பொழுது என் சொந்த உடைகளே என்னை அருவருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“நான் அவருக்குப் பதிலளிக்கவும், அவரை நீதிமன்றத்தில் எதிர்க்கவும்","poem":1},{"text":"அவர் என்னைப்போல் ஒரு மனிதனல்ல.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"எங்கள் இருவருக்கும் நடுவராயிருந்து தீர்ப்புக்கூறவும்,","poem":1},{"text":"எங்கள் இருவர்மேலும் தம் கையை வைத்து,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"என்னிடத்திலிருந்து இறைவனது தண்டனையின் கோலை அகற்ற","poem":1},{"text":"ஒருவர் இருந்தால் நலமாயிருக்குமே;","poem":2},{"lineBreak":true},{"text":"அவருடைய பயங்கரம் என்னைப் பயமுறுத்தாது.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"நான் அவருக்குப் பயப்படாமல் பேசுவேன்,","poem":1},{"text":"ஆனால் இப்போதைய நிலையில் அப்படிப் பேச என்னால் முடியாது.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOB/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOB/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/8.json","previousChapterAudioLinks":{},"numberOfVerses":35}