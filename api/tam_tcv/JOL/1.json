{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOL","translationId":"tam_tcv","name":"யோயேல்","commonName":"யோயேல்","title":"யோயேல்","order":29,"numberOfChapters":3,"sha256":"475db2c7bc190c2896ace5ace1042fd12a317b08fdd94d52bb209e47d83f6654","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["பெத்துயேலின் மகன் யோயேலுக்கு வந்த யெகோவாவின் வார்த்தை:"]},{"type":"line_break"},{"type":"heading","content":["வெட்டுக்கிளிகளின் படையெடுப்பு"]},{"type":"verse","number":2,"content":[{"text":"முதியோரே, இதைக் கேளுங்கள்;","poem":1},{"text":"நாட்டில் வாழ்கிறவர்களே, எல்லோரும் செவிகொடுங்கள்.","poem":2},{"text":"உங்கள் நாட்களிலோ அல்லது உங்கள் முற்பிதாக்களின் நாட்களிலோ,","poem":1},{"text":"இதுபோன்று ஒன்று எப்பொழுதாவது நிகழ்ந்ததுண்டோ?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இதை உங்கள் பிள்ளைகளுக்குச் சொல்லுங்கள்;","poem":1},{"text":"உங்கள் பிள்ளைகள் அதைத் தங்கள் பிள்ளைகளுக்கும்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் தங்கள் பிள்ளைகளுக்கும் அடுத்த தலைமுறைக்கும் அதைச் சொல்லட்டும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பச்சைப்புழு விட்டதை,","poem":1},{"text":"இளம் வெட்டுக்கிளிகள் தின்றன;","poem":2},{"text":"இளம் வெட்டுக்கிளிகள் விட்டதை,","poem":1},{"text":"துள்ளும் வெட்டுக்கிளிகள் தின்றன;","poem":2},{"text":"துள்ளும் வெட்டுக்கிளிகள் விட்டதை,","poem":1},{"text":"வளர்ந்த வெட்டுக்கிளிகள் தின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"குடிவெறியர்களே, விழித்து அழுங்கள்;","poem":1},{"text":"திராட்சை இரசம் குடிப்போரே, நீங்கள் எல்லோரும்","poem":2},{"text":"இனிப்பான திராட்சை இரசத்திற்காகப் புலம்புங்கள்;","poem":1},{"text":"ஏனெனில் அது உங்கள் வாயிலிருந்து எடுக்கப்பட்டுவிட்டது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வலிமைமிக்கதும் எண்ணற்றதுமான","poem":1},{"text":"வெட்டுக்கிளிக் கூட்டம் இராணுவம்போல் என் நாட்டின்மேல் படையெடுத்தது.","poem":2},{"text":"அதன் பற்கள் சிங்கத்தின் பற்கள்;","poem":1},{"text":"பெண் சிங்கத்தின் கடைவாய்ப் பற்களும் அதற்கு உண்டு.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அது என் திராட்சைக்கொடியைப் பாழாக்கி,","poem":1},{"text":"என் அத்திமரங்களையும் அழித்துப்போட்டது.","poem":2},{"text":"அது அவற்றின் பட்டைகளை","poem":1},{"text":"உரித்து எறிந்தது,","poem":2},{"lineBreak":true},{"text":"அதன் கிளைகள் வெளிறிப் போய்விட்டது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"தன் வாலிப வயதின் கணவனுக்காக துக்கவுடை உடுத்தி","poem":1},{"text":"அழுது புலம்பும் இளம்பெண்ணைப்போல் கதறி அழுங்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தானிய காணிக்கைகளும் பான காணிக்கைகளும்","poem":1},{"text":"யெகோவாவினுடைய ஆலயத்திலிருந்து அகன்று போயின.","poem":2},{"text":"யெகோவாவுக்குமுன் ஊழியம் செய்கிற ஆசாரியர்கள்","poem":1},{"text":"புலம்பி அழுகிறார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"வயல்வெளிகள் பாழாயின,","poem":1},{"text":"நிலமும் உலர்ந்துபோயிற்று;","poem":2},{"text":"தானியம் அழிந்தது,","poem":1},{"text":"புது திராட்சை இரசம் வற்றிப்போயிற்று;","poem":2},{"lineBreak":true},{"text":"எண்ணெயும் குறைவுபடுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"விவசாயிகளே, கலங்குங்கள்,","poem":1},{"text":"திராட்சைத் தோட்டக்காரரே, புலம்புங்கள்;","poem":2},{"text":"கோதுமையும் வாற்கோதுமையும் இல்லாமற்போயிற்று;","poem":1},{"text":"ஏனெனில் வயலின் விளைச்சல் அழிந்துபோயிற்று.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"திராட்சைக்கொடி உலர்ந்துபோயிற்று,","poem":1},{"text":"அத்திமரம் வாடிப்போயிற்று.","poem":2},{"text":"மாதுளையும், பேரீச்சையும்,","poem":1},{"text":"ஆப்பிள் மரங்களுமான வயல்வெளியின்","poem":2},{"text":"எல்லா மரங்களும் வதங்கிப்போயிற்று;","poem":1},{"text":"மனுமக்களின் மகிழ்ச்சி மறைந்துபோயிற்று.","poem":2}]},{"type":"heading","content":["மனந்திரும்புதலுக்கு அழைப்பு"]},{"type":"verse","number":13,"content":[{"text":"ஆசாரியர்களே, துக்கவுடை உடுத்திப் புலம்புங்கள்;","poem":1},{"text":"பலிபீடத்தின்முன் பணி செய்வோரே, அழுங்கள்;","poem":2},{"text":"என் இறைவனின்முன் ஊழியம் செய்வோரே,","poem":1},{"text":"வாருங்கள், வந்து துக்கவுடை உடுத்தி இரவைக் கழியுங்கள்.","poem":2},{"text":"ஏனெனில் உங்கள் இறைவனது ஆலயத்திலிருந்து","poem":1},{"text":"தானிய காணிக்கைகளும் பான காணிக்கைகளும் நிறுத்தப்பட்டுவிட்டன.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பரிசுத்த உபவாசத்தை நியமியுங்கள்;","poem":1},{"text":"பரிசுத்த திருச்சபையை ஒன்றுகூட்டுங்கள்.","poem":2},{"text":"முதியோரையும்,","poem":1},{"text":"நாட்டில் வாழும் அனைவரையும்","poem":2},{"text":"உங்கள் இறைவனாகிய யெகோவாவின் ஆலயத்திற்கு அழைப்பித்து,","poem":1},{"text":"யெகோவாவை நோக்கிக் கதறுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"அது எவ்வளவு பயங்கரமான நாள்,","poem":1},{"text":"யெகோவாவின் நாள் நெருங்கி வந்திருக்கிறது;","poem":2},{"lineBreak":true},{"text":"அது எல்லாம் வல்லவரிடமிருந்து ஒரு அழிவுபோல் வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"எங்கள் கண்களுக்கு முன்பாகவே","poem":1},{"text":"உணவும்,","poem":2},{"text":"நம் இறைவனின் ஆலயத்திலிருந்து","poem":1},{"text":"மகிழ்ச்சியும் சந்தோஷமும் அகற்றப்படவில்லையோ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"மண்கட்டிகளின் அடியில்","poem":1},{"text":"விதைகள் காய்ந்து போயிருக்கின்றன.","poem":2},{"text":"தானியம் அற்றுப்போனதால்","poem":1},{"text":"பண்டகசாலைகள் பாழாகி,","poem":2},{"lineBreak":true},{"text":"தானிய களஞ்சியங்கள் இடிந்துபோயின.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"வளர்ப்பு மிருகங்கள் எவ்வளவாய்த் தவிக்கின்றன;","poem":1},{"text":"மாட்டு மந்தைகள் மேய்ச்சலின்றி","poem":2},{"text":"கலங்குகின்றன;","poem":1},{"text":"செம்மறியாட்டு மந்தைகளுங்கூட கஷ்டப்படுகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யெகோவாவே, உம்மையே நோக்கி நான் கதறுகிறேன்,","poem":1},{"text":"ஏனெனில் வெளியின் மேய்ச்சல் நிலங்களை நெருப்பு சுட்டுப் பொசுக்கிவிட்டது;","poem":2},{"lineBreak":true},{"text":"வயல்வெளியின் மரங்கள் அனைத்தையும் நெருப்புச் சுவாலைகள் எரித்துப்போட்டன.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"காட்டு விலங்குகளுங்கூட உம்மை நோக்கிக் கதறுகின்றன;","poem":1},{"text":"நீரோடைகள் வற்றிப்போய்விட்டன,","poem":2},{"lineBreak":true},{"text":"வெளியின் மேய்ச்சல் நிலங்களை நெருப்பு சுட்டுப் பொசுக்கிவிட்டது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}