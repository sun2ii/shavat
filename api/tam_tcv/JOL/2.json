{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOL","translationId":"tam_tcv","name":"யோயேல்","commonName":"யோயேல்","title":"யோயேல்","order":29,"numberOfChapters":3,"sha256":"475db2c7bc190c2896ace5ace1042fd12a317b08fdd94d52bb209e47d83f6654","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":2,"content":[{"type":"heading","content":["வெட்டுக்கிளிகளின் படை"]},{"type":"verse","number":1,"content":[{"text":"சீயோனிலே எக்காளம் ஊதுங்கள்,","poem":1},{"text":"என் பரிசுத்த குன்றிலே எச்சரிப்பின் ஒலியை எழுப்புங்கள்.","poem":2},{"lineBreak":true},{"text":"நாட்டில் வாழும் அனைவரும் நடுங்குவார்களாக;","poem":1},{"text":"ஏனெனில், யெகோவாவின் நாள் வருகிறது.","poem":2},{"text":"அது நெருங்கி வந்திருக்கிறது.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"அது இருளும் காரிருளும் கலந்த நாள்,","poem":2},{"lineBreak":true},{"text":"மப்பும் மந்தாரமும் நிறைந்த நாள்.","poem":2},{"text":"விடியற்காலை வெளிச்சம் மலைகளின்மீது பரவுவதுபோல்","poem":1},{"text":"வலிமைமிக்க வெட்டுக்கிளிகளின் பெரும் படையொன்று வருகிறது!","poem":2},{"text":"இதுபோன்ற படை முற்காலத்தில் இருந்ததுமில்லை,","poem":1},{"text":"வரப்போகும் காலங்களில் இருக்கப் போவதுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"அவற்றிற்கு முன்னாக நெருப்பு சுட்டெரிக்கும்,","poem":1},{"text":"அவற்றிற்கு பின்னாக நெருப்புப் பற்றியெரியும்.","poem":2},{"text":"அவற்றிற்கு முன்னாக நாடு ஏதேன் தோட்டத்தைப் போலவும்,","poem":1},{"text":"அவற்றிற்குப் பின்னாக நாடு பாழான பாலைவனம் போலவும் இருக்கிறது;","poem":2},{"lineBreak":true},{"text":"அவற்றிலிருந்து தப்புவது எதுவுமேயில்லை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவை குதிரைகளின் தோற்றமுடையவை;","poem":1},{"text":"அவை குதிரைப் படைபோல் பாய்ந்தோடுகின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தேர்களின் இரைச்சலைப் போன்ற சத்தத்துடனும்,","poem":1},{"text":"காய்ந்த சருகுகளை எரிக்கும்போது எழும்பும் சத்தத்துடனும்,","poem":2},{"text":"யுத்தத்திற்கு அணிவகுக்கும் வலிமைமிக்க படையைப்போல்","poem":1},{"text":"அவை மலைமேல் பாய்ந்து வருகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவைகளைக் கண்டதும் நாடுகள் நடுங்கும்;","poem":1},{"text":"பயத்தால் எல்லாருடைய முகங்களும் வெளிறிப்போகும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"வெட்டுக்கிளிகள் இராணுவவீரரைப்போல் தாவி ஓடுகின்றன;","poem":1},{"text":"அவை போர் வீரரைப்போல் மதில்களில் ஏறுகின்றன.","poem":2},{"text":"அவை தங்கள் பாதையிலிருந்து விலகாமல்","poem":1},{"text":"நேராய் அணிவகுத்துச் செல்கின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவை ஒன்றையொன்று இடித்துக்கொள்ளாமல்","poem":1},{"text":"ஒவ்வொன்றும் தன் வழிதவறாமல் செல்கின்றன.","poem":2},{"text":"அணிவகுப்பைக் குலைக்காமல்","poem":1},{"text":"போராயுதங்களை இடித்து முன்னேறுகின்றன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவை நகரத்தை நோக்கி விரைகின்றன;","poem":1},{"text":"மதில்கள்மேல் ஓடுகின்றன.","poem":2},{"text":"வீடுகளுக்குள் ஏறுகின்றன;","poem":1},{"text":"அவை திருடர்களைப்போல் ஜன்னல் வழியே நுழைகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அவற்றின் முன்பாக பூமி அதிருகிறது,","poem":1},{"text":"வானம் அசைகிறது.","poem":2},{"text":"சூரியனும் சந்திரனும் இருளடைகின்றன,","poem":1},{"text":"நட்சத்திரங்கள் ஒளிகொடாதிருக்கின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவா தமது படையின் முன்னின்று முழக்கமிடுகிறார்;","poem":1},{"text":"அவருடைய பாளையம் மிகப்பெரியது,","poem":2},{"text":"அவருடைய கட்டளைக்குக் கீழ்ப்படிகிறதற்கு","poem":1},{"text":"வலிமைமிக்கது.","poem":2},{"text":"யெகோவாவின் நாள் பெரிதும்","poem":1},{"text":"பயங்கரமுமானது.","poem":2},{"lineBreak":true},{"text":"அதை யாரால் சகிக்கமுடியும்?","poem":2}]},{"type":"heading","content":["மனமாறுங்கள்"]},{"type":"verse","number":12,"content":[{"text":"ஆகையால், “இப்பொழுதேனும் நீங்கள் உபவாசித்து, அழுது புலம்பி,","poem":1},{"text":"உங்கள் முழுமனதுடன் என்னிடம் திரும்புங்கள்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"உங்கள் உடைகளையல்ல,","poem":1},{"text":"உங்கள் உள்ளத்தையே கிழியுங்கள்.","poem":2},{"text":"உங்கள் இறைவனாகிய யெகோவாவிடம் திரும்புங்கள்;","poem":1},{"text":"ஏனெனில் அவர் கிருபையும் கருணையும் உள்ளவர்,","poem":2},{"text":"கோபிக்கத் தாமதிக்கிறவர், அன்பு நிறைந்தவர்;","poem":1},{"text":"பேரழிவை அனுப்பாமல் மனம் மாறுகிறவர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யாருக்குத் தெரியும்? ஒருவேளை அவர் மனமாறி, அனுதாபங்கொண்டு,","poem":1},{"text":"உங்களுக்குத் தனது ஆசீர்வாதத்தையும் தரக்கூடும்.","poem":2},{"text":"அப்பொழுது உங்கள் இறைவனாகிய யெகோவாவுக்காக","poem":1},{"text":"தானிய காணிக்கையையும் பானகாணிக்கையையும் நீங்கள் கொண்டுவரலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ஆசாரியர்களே, சீயோனிலே எக்காளம் ஊதுங்கள்,","poem":1},{"text":"பரிசுத்த உபவாசத்தை அறிவியுங்கள்;","poem":2},{"lineBreak":true},{"text":"பரிசுத்த திருச்சபையை ஒன்றுகூட்டுங்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"மக்களை ஒன்றுசேர்த்து,","poem":1},{"text":"சபையை பரிசுத்தம் செய்யுங்கள்.","poem":2},{"text":"முதியோரை ஒன்றுகூட்டுங்கள்,","poem":1},{"text":"பிள்ளைகளையும் பாலுண்கிற குழந்தைகளையும்","poem":2},{"lineBreak":true},{"text":"சேர்த்துக்கொள்ளுங்கள்.","poem":2},{"text":"மணமகன் தன் அறையையும்,","poem":1},{"text":"மணமகள் தன் படுக்கையையும் விட்டுப் புறப்படட்டும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"யெகோவாவுக்கு முன்பாக ஊழியஞ்செய்யும் ஆசாரியர்கள் புலம்பட்டும்;","poem":1},{"text":"ஆலய மண்டபத்திற்கும் பலிபீடத்திற்கும் இடையே நின்று அழட்டும்.","poem":2},{"text":"அவர்கள், “யெகோவாவே, உமது மக்களைத் தப்புவியும்.","poem":1},{"text":"உமது உரிமைச்சொத்தை பிறநாடுகளின் நடுவே","poem":2},{"lineBreak":true},{"text":"நிந்தைக்கும் பழிச்சொல்லுக்கும் ஆளாக்காதேயும்.","poem":2},{"text":"‘அவர்களுடைய இறைவன் எங்கே?’","poem":1},{"text":"என்று மக்கள் கூட்டங்கள் மத்தியில் அவர்கள் ஏன் சொல்லவேண்டும்?”","poem":2},{"lineBreak":true},{"text":"என்று சொல்வார்களாக.","poem":2}]},{"type":"heading","content":["யெகோவாவின் பதில்"]},{"type":"verse","number":18,"content":[{"text":"அப்பொழுது யெகோவா தமது நாட்டின்மேல் வைராக்கியங்கொண்டு,","poem":1},{"text":"தமது மக்களில் அனுதாபங்கொள்வார்.","poem":2}]},{"type":"verse","number":19,"content":["யெகோவா தம் மக்களுக்கு மறுமொழியாக கூறியது:",{"text":"“இதோ, நான் உங்களுக்குத் தானியத்தையும், புதிய திராட்சை இரசத்தையும், எண்ணெயையும்","poem":1},{"text":"முழுமையாய் திருப்தியளிக்கும் வகையில் அனுப்புகிறேன்;","poem":2},{"text":"நான் இனியும் பிற தேசத்தாருக்கு உங்களை","poem":1},{"text":"நிந்தையாக வைக்கமாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“வடதிசைப் படைகளை உங்களைவிட்டுத் தூரமாய்த் விலக்கிவிடுவேன்;","poem":1},{"text":"பாழடைந்த வறண்ட நாட்டிற்கு அவர்களைத் தள்ளிவிடுவேன்.","poem":2},{"text":"அதன் முன்னணிப் படைகளை கிழக்கே சாக்கடலிலும்,","poem":1},{"text":"அதன் பின்னணிப் படைகளை மேற்கே மத்திய தரைக்கடலிலும் தள்ளுவேன்.","poem":2},{"text":"அங்கே அவற்றின் நாற்றமும்","poem":1},{"text":"தீய வாடையும் நாட்டின் மேலெழும்பும்.”","poem":2},{"lineBreak":true},{"text":"நிச்சயமாகவே யெகோவா பெரிய காரியங்களைச் செய்திருக்கிறார்.","poem":1}]},{"type":"verse","number":21,"content":[{"text":"நாடே நீ பயப்படாதே,","poem":2},{"lineBreak":true},{"text":"மகிழ்ந்து களிகூரு;","poem":2},{"text":"நிச்சயமாகவே யெகோவா பெரிய காரியங்களைச் செய்திருக்கிறார்.","poem":1}]},{"type":"verse","number":22,"content":[{"text":"காட்டு மிருகங்களே, பயப்படாதேயுங்கள்,","poem":2},{"lineBreak":true},{"text":"வனாந்திரத்தின் மேய்ச்சலிடங்கள் பசுமையாகின்றன.","poem":2},{"text":"மரங்கள் கனி கொடுக்கின்றன;","poem":1},{"text":"அத்திமரமும் திராட்சைக்கொடியும் நிறைவாய்ப் பலனளிக்கின்றன.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"சீயோன் மக்களே, மகிழுங்கள்,","poem":1},{"text":"உங்கள் இறைவனாகிய யெகோவாவிடம் களிகூருங்கள்.","poem":2},{"text":"ஏனெனில் அவர் தம் நீதியை நிலைநாட்ட","poem":1},{"text":"உங்களுக்கு முன்மாரியைத் தந்திருக்கிறார்.","poem":2},{"text":"முன்போலவே உங்களுக்கு முன்மாரியையும்","poem":1},{"text":"பின்மாரியையும் நிறைவாய்ப் பொழிகிறார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"சூடடிக்கும் களங்கள் தானியத்தினால் நிரம்பியிருக்கும்;","poem":1},{"text":"ஆலைகள் புதிய திராட்சை இரசத்தினாலும் எண்ணெயினாலும் நிரம்பிவழியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"நான் உங்களுக்கு மத்தியில் அனுப்பின பச்சைப்புழுக்களும்,","poem":1},{"text":"இளம் வெட்டுக்கிளிகளும், துள்ளும் வெட்டுக்கிளிகளும்,","poem":2},{"lineBreak":true},{"text":"வளர்ந்த வெட்டுக்கிளிகளும் தின்று அழித்த வருடங்களுக்குப் பதிலாக,","poem":2},{"text":"உங்களுக்கு ஈடுசெய்வேன்.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"நீங்கள் திருப்தியாகும்வரை சாப்பிடுவதற்கு","poem":1},{"text":"உங்களுக்கு உணவு நிறைவாய் இருக்கும்.","poem":2},{"text":"அப்பொழுது உங்களுக்காக அதிசயங்கள் செய்த","poem":1},{"text":"உங்கள் யெகோவாவாகிய இறைவனின் பெயரைத் துதிப்பீர்கள்;","poem":2},{"text":"என்னுடைய மக்கள் இனி ஒருபோதும் வெட்கப்படமாட்டார்கள்.","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"அப்பொழுது நான் இஸ்ரயேலில் உங்களுடன் இருக்கிறேன் என்றும்,","poem":1},{"text":"உங்கள் இறைவனாகிய யெகோவா நானே என்றும்,","poem":2},{"lineBreak":true},{"text":"வேறொருவரும் இல்லை என்றும் நீங்கள் அறிந்துகொள்வீர்கள்;","poem":2},{"text":"என் மக்கள் இனி ஒருபோதும் வெட்கப்படமாட்டார்கள்.","poem":1}]},{"type":"heading","content":["யெகோவாவின் நாள்"]},{"type":"verse","number":28,"content":[{"text":"“அதன்பின்பு,","poem":1},{"text":"நான் எல்லா மக்கள்மேலும் என் ஆவியானவரைப் பொழிவேன்.","poem":2},{"text":"உங்கள் மகன்களும், மகள்களும் இறைவாக்கு உரைப்பார்கள்;","poem":1},{"text":"உங்கள் முதியவர்கள் கனவுகளையும்","poem":2},{"lineBreak":true},{"text":"உங்கள் இளைஞர் தரிசனங்களையும் காண்பார்கள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"மேலும் அந்நாட்களில் நான், எனது ஊழியக்காரர்கள்மேலும் ஊழியக்காரிகள்மேலும்","poem":1},{"text":"என் ஆவியைப் பொழிவேன்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"வானத்திலும் பூமியிலும்","poem":1},{"text":"இரத்தமும் நெருப்பும் புகை மண்டலமுமாகிய","poem":2},{"lineBreak":true},{"text":"அதிசயங்களை நான் காண்பிப்பேன்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"பெரிதும் பயங்கரமுமான யெகோவாவின் அந்த நாள் வருமுன்பே,","poem":1},{"text":"சூரியன் இருண்டுபோகும்,","poem":2},{"lineBreak":true},{"text":"சந்திரன் இரத்தமாக மாறும்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அப்போது யெகோவாவின் பெயரைச் சொல்லி கூப்பிடுகிற,","poem":1},{"text":"யாவரும் இரட்சிக்கப்படுவார்கள்;","poem":2},{"text":"யெகோவா சொன்னதுபோலவே,","poem":1},{"text":"மீந்திருப்பவர்கள் மத்தியிலிருந்து","poem":2},{"lineBreak":true},{"text":"யெகோவாவினால் அழைக்கப்பட்டவர்களுக்கு,","poem":2},{"text":"சீயோன் மலையிலும் எருசலேமிலும்","poem":1},{"text":"மீட்பு உண்டு.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}