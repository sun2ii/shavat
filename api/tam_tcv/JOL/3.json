{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JOL","translationId":"tam_tcv","name":"யோயேல்","commonName":"யோயேல்","title":"யோயேல்","order":29,"numberOfChapters":3,"sha256":"475db2c7bc190c2896ace5ace1042fd12a317b08fdd94d52bb209e47d83f6654","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/JOL/3.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["பிறநாடுகள் நியாயந்தீர்க்கப்படுதல்"]},{"type":"verse","number":1,"content":[{"text":"“அந்நாட்களிலும் அவ்வேளையிலும்,","poem":1},{"text":"யூதாவையும் எருசலேமையும் முன்னிருந்த நிலைக்கு நான் திரும்பவும் கொண்டுவருவேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் எல்லா நாடுகளையும் ஒன்றுசேர்த்து,","poem":1},{"text":"அவர்களை யோசபாத்தின் பள்ளத்தாக்கிற்குக் கொண்டுவருவேன்.","poem":2},{"text":"அங்கே நான் என் உரிமைச்சொத்தான இஸ்ரயேல் மக்களை முன்னிட்டு","poem":1},{"text":"அவர்களுக்கு விரோதமாய் நியாயந்தீர்பேன்;","poem":2},{"text":"ஏனெனில் அவர்கள் என் மக்களை பிறநாடுகள் மத்தியில் சிதறடித்து,","poem":1},{"text":"என் நாட்டையும் தங்களிடையே பங்கிட்டுக்கொண்டார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என் மக்கள்பேரில் சீட்டுப்போட்டார்கள்,","poem":1},{"text":"வேசிகளுக்கான கூலியாக ஆண்பிள்ளைகளைக் கொடுத்தார்கள்,","poem":2},{"lineBreak":true},{"text":"தாங்கள் திராட்சை இரசம் குடிப்பதற்காக பெண்பிள்ளைகளை விற்றார்கள்.","poem":2}]},{"type":"verse","number":4,"content":["“தீரு, சீதோன் பட்டணங்களே, பெலிஸ்தியரின் எல்லா பிரதேசங்களே, எனக்கு விரோதமாய் உங்களுக்கு என்ன இருக்கிறது? நான் ஏதாவது செய்ததற்காகவா நீங்கள் என்னைப் பழிவாங்குகிறீர்கள்? அப்படி நீங்கள் என்னைப் பழிவாங்கினால், நான் தாமதமின்றி விரைவாக நீங்கள் செய்தவற்றை உங்கள் சொந்த தலைமேலேயே திருப்புவேன்."]},{"type":"verse","number":5,"content":["என் வெள்ளியையும் என் தங்கத்தையும் நீங்கள் எடுத்து, என் சிறந்த திரவியங்களையும் அள்ளிக்கொண்டு, உங்கள் கோயில்களுக்குப் போனீர்கள்."]},{"type":"verse","number":6,"content":["யூதா, எருசலேம் மக்களை அவர்கள் தாய்நாட்டிலிருந்து தூரமாய் அனுப்புவதற்காக அவர்களைக் கிரேக்கருக்கு நீங்கள் விற்றுவிட்டீர்கள்."]},{"type":"verse","number":7,"content":["“இதோ, நீங்கள் விற்ற இடங்களிலிருந்து அவர்களை மீண்டும் எழுப்பப்போகிறேன். நீங்கள் செய்ததை உங்கள் தலைகள் மேலேயே திருப்புவேன்."]},{"type":"verse","number":8,"content":["உங்கள் மகன்களையும் மகள்களையும் யூதா மக்களுக்கு விற்பேன். அவர்கள் அவர்களை தூரதேசத்திலுள்ள நாட்டாரான சபேயருக்கு விற்பார்கள்.” இதை யெகோவாவே சொன்னார்."]},{"type":"verse","number":9,"content":[{"text":"பிற நாடுகளிடையே இதை அறிவியுங்கள்;","poem":1},{"text":"யுத்தத்திற்குத் தயாராகுங்கள்;","poem":2},{"text":"இராணுவவீரரை எழுப்புங்கள்;","poem":1},{"text":"போர்வீரர்கள் அனைவரும் நெருங்கிப்போய் தாக்கட்டும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உங்கள் மண்வெட்டிகளை வாள்களாகவும்,","poem":1},{"text":"உங்கள் வெட்டுக்கத்திகளை ஈட்டிகளாகவும் அடியுங்கள்.","poem":2},{"text":"பெலவீனன்,","poem":1},{"text":"“நான் பெலனுள்ளவன்!” என்று சொல்லட்டும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"சுற்றுப்புறம் எங்குமுள்ள நாடுகளே, நீங்கள் எல்லோரும் விரைந்துவந்து,","poem":1},{"text":"அங்கே ஒன்றுகூடுங்கள்.","poem":2},{"lineBreak":true},{"text":"யெகோவாவே உமது படைவீரர்களைக் கொண்டுவாரும்!","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“பிறநாடுகள் எழும்பட்டும்;","poem":1},{"text":"யோசபாத்தின் பள்ளத்தாக்கை நோக்கி முன்னேறிப் போகட்டும்.","poem":2},{"text":"அங்கே நான், சுற்றுப்புறம் எங்குமுள்ள பிறநாடுகள் அனைத்தையும்","poem":1},{"text":"நியாயந்தீர்ப்பதற்காக உட்காருவேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"விளைச்சல் முதிர்ந்துள்ளது,","poem":1},{"text":"அரிவாளை நீட்டி அறுங்கள்.","poem":2},{"text":"திராட்சைப்பழ ஆலைகள் நிரம்பியுள்ளன,","poem":1},{"text":"வந்து திராட்சைப் பழங்களை மிதியுங்கள்;","poem":2},{"lineBreak":true},{"text":"இரசத் தொட்டிகளும் நிறைந்து பொங்கி வழிகின்றன;","poem":2},{"text":"இவ்வளவாய் அவர்களின் கொடுமை பெரியது!”","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"தீர்ப்பு வழங்கும் பள்ளத்தாக்கில்","poem":1},{"text":"மக்கள் கூட்டங்கூட்டமாய் இருக்கின்றனர்.","poem":2},{"text":"தீர்ப்பு வழங்கும் பள்ளத்தாக்கில்","poem":1},{"text":"யெகோவாவின் நாள் சமீபித்துள்ளது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"சூரியனும் சந்திரனும் இருளடையும்,","poem":1},{"text":"நட்சத்திரங்கள் இனி வெளிச்சம் கொடாதிருக்கும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யெகோவா சீயோனிலிருந்து கெர்ச்சித்து,","poem":1},{"text":"எருசலேமிலிருந்து முழங்குவார்;","poem":2},{"lineBreak":true},{"text":"வானமும் பூமியும் அதிரும்.","poem":2},{"text":"ஆனால் யெகோவா தம் மக்களுக்குப் புகலிடமும்","poem":1},{"text":"இஸ்ரயேல் மக்களுக்கு அரணான கோட்டையுமாய் இருப்பார்.","poem":2}]},{"type":"heading","content":["இறைவனின் மக்களுக்கு ஆசீர்வாதம்"]},{"type":"verse","number":17,"content":[{"text":"“அப்பொழுது என் பரிசுத்த மலையாகிய சீயோனில் வாழ்கிற","poem":1},{"text":"உங்கள் இறைவனாகிய யெகோவா நான் என்று அறிவீர்கள்.","poem":2},{"text":"எருசலேம் பரிசுத்தமாயிருக்கும்;","poem":1},{"text":"பிறநாட்டார் இனி ஒருபோதும் அதைக் கடந்து செல்லமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“அந்நாட்களில் மலைகளில் புதிய திராட்சை இரசம் பொழியும்,","poem":1},{"text":"குன்றுகள் பாலாய் வழிந்தோடும்;","poem":2},{"lineBreak":true},{"text":"யூதாவின் நீரோடைகளிலெல்லாம் தண்ணீர் நிரம்பியோடும்.","poem":2},{"text":"யெகோவாவின் ஆலயத்திலிருந்து நீரூற்று ஒன்று கிளம்பி,","poem":1},{"text":"சித்தீம் பள்ளத்தாக்கிற்கு தண்ணீர் பாய்ச்சும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"யூதா நாட்டில் குற்றமற்ற இரத்தம் சிந்தி,","poem":1},{"text":"அவர்களுக்குச் செய்த கொடுமையின் நிமித்தம்","poem":2},{"text":"எகிப்து பாழாகும்,","poem":1},{"text":"ஏதோம் பாழடைந்து பாலைவனமாகும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"யூதா என்றென்றும், எருசலேம் தலைமுறை தலைமுறையாகவும்","poem":1},{"text":"குடியிருக்கும் இடமாகும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர்களுடைய இரத்தப்பழியை நான் தண்டியாமல் விடுவேனோ?","poem":1},{"text":"நான் தண்டிப்பேன்.”","poem":2},{"lineBreak":true},"யெகோவா சீயோனில் குடியிருக்கிறார்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/AMO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":21}