{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"JON","translationId":"tam_tcv","name":"யோனா","commonName":"யோனா","title":"யோனா","order":32,"numberOfChapters":4,"sha256":"3ed8261d4657c1b07e1595e4e26d508f755628fe95c73ffe5d6c6cd0c06d1256","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tam_tcv/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["யோனா மீனுக்குள்ளே இருந்து தனது இறைவனாகிய யெகோவாவிடம் மன்றாடினான்."]},{"type":"verse","number":2,"content":["அவன் சொன்னதாவது:",{"text":"“என் துன்பத்தில் நான் என் யெகோவாவைக் கூப்பிட்டேன்,","poem":1},{"text":"நீர் எனக்குப் பதிலளித்தீர்;","poem":2},{"text":"பாதாளத்தின் ஆழங்களிலிருந்து உதவிவேண்டி கூப்பிட்டேன்,","poem":1},{"text":"நீர் எனது அழுகையைக் கேட்டீர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீர் என்னை ஆழத்துக்குள் எறிந்தீர்,","poem":1},{"text":"நடுக்கடலின் ஆழத்தில் எறிந்தீர்,","poem":2},{"lineBreak":true},{"text":"நீர்ச்சுழிகள் என்னைச் சுற்றிலும் சுழன்றுபோயின;","poem":2},{"text":"உமது அலைகளும், அலையின் நுரைகளும்","poem":1},{"text":"என்மேல் புரண்டன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘உமது முன்னிலையிலிருந்து","poem":1},{"text":"நான் துரத்தப்பட்டேன்.","poem":2},{"text":"இருந்தாலும், நான் திரும்பவும்","poem":1},{"text":"உமது பரிசுத்த ஆலயத்தை நோக்கிப்பார்ப்பேன்’ என்றேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என்னை விழுங்கிய தண்ணீர் என்னைப் பயமுறுத்தியது,","poem":1},{"text":"ஆழம் என்னை சூழ்ந்துகொண்டது;","poem":2},{"lineBreak":true},{"text":"கடற்பாசிக்கொடிகள் என் கழுத்தைச் சுற்றிக்கொண்டன.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மலைகளின் அடிவாரங்கள்வரை நான் அமிழ்ந்தேன்,","poem":1},{"text":"கீழேயுள்ள பூமி என்னை என்றென்றைக்குமாக அடைத்து வைத்தது.","poem":2},{"text":"ஆனால் என் இறைவனாகிய யெகோவாவே,","poem":1},{"text":"நீர் குழியிலிருந்து என் உயிரை மேலே கொண்டுவந்தீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“யெகோவாவே, என் உயிர் தளர்ந்துபோகையில்","poem":1},{"text":"நான் உம்மையே நினைத்தேன்,","poem":2},{"text":"என் மன்றாட்டு மேலெழுந்து","poem":1},{"text":"உமது பரிசுத்த ஆலயத்தில் உம்மிடம் வந்தடைந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“சிலர் ஒன்றுக்கும் உதவாத விக்கிரகங்களைப் பற்றிக்கொள்கிறார்கள்;","poem":1},{"text":"அவர்கள் தங்களுக்குக் கிடைக்கக்கூடிய கிருபையை இழந்துபோகிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஆனால், நானோ துதியின் சத்தத்தோடே","poem":1},{"text":"உமக்குப் பலியிடுவேன்.","poem":2},{"text":"நான் நேர்ந்துகொண்டதை நிறைவேற்றுவேன்.","poem":1},{"text":"‘இரட்சிப்பு யெகோவாவிடமிருந்தே வருகிறது’ ” என்றான்.","poem":2}]},{"type":"verse","number":10,"content":["யெகோவா மீனுக்குக் கட்டளையிட்டார், அது யோனாவை கரையில் கக்கிவிட்டது."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}