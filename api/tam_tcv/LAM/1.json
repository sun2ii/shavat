{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"LAM","translationId":"tam_tcv","name":"புலம்பல்","commonName":"புலம்பல்","title":"எரேமியாவின் புலம்பல்","order":25,"numberOfChapters":5,"sha256":"6b8626ede62ecce777c3e6dc73fd8cadf67ecec61103f405e66692cf50b70fdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tam_tcv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"ஒருகாலத்தில் மக்களால் நிறைந்திருந்த எருசலேம் பட்டணம்,","poem":1},{"text":"இப்பொழுது எவ்வளவு பாழாய்க் கிடக்கிறது!","poem":2},{"text":"ஒருகாலத்தில் நாடுகளின் மத்தியில் மிகவும் பெரியவளாய் இருந்தவள்,","poem":1},{"text":"இன்று ஒரு விதவையைப் போலானாளே!","poem":2},{"text":"நாடுகளின் மத்தியில் அரசியாய் இருந்தவள்","poem":1},{"text":"இப்பொழுது அடிமையானாளே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"இரவில் அவள் மனங்கசந்து அழுகிறாள்,","poem":1},{"text":"அவளுடைய கன்னங்களில் கண்ணீர் வடிகிறது.","poem":2},{"text":"அவளுக்குப் பிரியமானவர்களில் அவளை","poem":1},{"text":"ஆறுதல் செய்வதற்கு ஒருவரும் இல்லை.","poem":2},{"text":"அவளுடைய நண்பர்கள் அவளுக்கு துரோகம் செய்தார்கள்;","poem":1},{"text":"அவர்கள் அவளின் விரோதிகளானார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"துன்பத்தையும், கொடுமையான அடிமை வேலையையும் அனுபவித்தபின்,","poem":1},{"text":"யூதா நாடுகடத்தப்பட்டுப் போனாள்.","poem":2},{"text":"பிறநாடுகளின் மத்தியில் அவள் குடியிருக்கிறாள்;","poem":1},{"text":"ஆனால் அவளுக்கோ இளைப்பாறும் இடம் இல்லை.","poem":2},{"text":"அவளுடைய துன்பத்தின் மத்தியில்","poem":1},{"text":"அவளைப் பின்தொடர்ந்த யாவரும் அவளைப் பிடித்துக்கொண்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நியமிக்கப்பட்ட பண்டிகைகளுக்கு ஒருவரும் வராததால்,","poem":1},{"text":"சீயோனின் தெருக்கள் துக்கங்கொண்டாடுகின்றன.","poem":2},{"text":"அவளுடைய வாசல்கள் யாவும் பாழாய்க் கிடக்கின்றன.","poem":1},{"text":"அவளுடைய ஆசாரியர்கள் புலம்புகிறார்கள்.","poem":2},{"text":"அவளுடைய இளம்பெண்கள் துயரப்படுகிறார்கள்,","poem":1},{"text":"அவள் கசப்பான வேதனையில் இருக்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவளுடைய பகைவர்கள் அவளுக்கு தலைவர்களாகி விட்டார்கள்;","poem":1},{"text":"அவளுடைய பகைவர்கள் சுகவாழ்வு அடைந்திருக்கிறார்கள்.","poem":2},{"text":"அவளுடைய அநேக பாவங்களின் நிமித்தம்","poem":1},{"text":"யெகோவா அவளுக்கு துக்கத்தைக் கொடுத்தார்.","poem":2},{"text":"அவளுடைய பிள்ளைகள் எதிரிக்கு முன்","poem":1},{"text":"கைது செய்யப்பட்டு நாடுகடத்தப்பட்டனர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"சீயோன் மகளின்","poem":1},{"text":"சீர்சிறப்பெல்லாம் அவளைவிட்டு நீங்கிற்று.","poem":2},{"text":"அவளுடைய இளவரசர்கள் மேய்ச்சலை காணாத","poem":1},{"text":"மான்களைப் போலானார்கள்;","poem":2},{"text":"அவர்கள் தங்களை துரத்துகிறவர்களுக்கு முன்பாக","poem":1},{"text":"பலவீனமுற்று தப்பி ஓடினார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"எருசலேம் துன்பப்பட்டு அலைந்த நாட்களில்,","poem":1},{"text":"முற்காலத்தில் தனக்குச் சொந்தமாயிருந்த","poem":2},{"lineBreak":true},{"text":"செல்வங்களையெல்லாம் நினைவுகூருகிறாள்.","poem":2},{"text":"அவளுடைய மக்கள் பகைவரின் கையில் விழுந்தபோது,","poem":1},{"text":"அவளுக்கு உதவிசெய்ய ஒருவருமே இருந்ததில்லை.","poem":2},{"text":"மக்களுக்கு ஏற்பட்ட அழிவைக் கண்டு,","poem":1},{"text":"அவளுடைய பகைவர் அவளைப் பார்த்து நகைத்தார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"எருசலேம் பெரும் பாவம் செய்து அசுத்தமடைந்தாள்.","poem":1},{"text":"அவளை கனம்பண்ணின யாவரும்","poem":2},{"text":"அவளுடைய நிர்வாணத்தைக் கண்டதினால்,","poem":1},{"text":"அவளை அவமதிக்கிறார்கள்;","poem":2},{"text":"அவள் தனக்குள் அழுது,","poem":1},{"text":"தன் முகத்தை மறைத்துக் கொள்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"அவளுடைய அசுத்தம் அவளுடைய உடைகளில் ஒட்டிக் கொண்டிருக்கிறது;","poem":1},{"text":"அவள் தன்னுடைய எதிர்காலத்தை எண்ணிப்பார்க்கவில்லை.","poem":2},{"text":"ஆகையினால் அவளுடைய வீழ்ச்சி அதிர்ச்சியாயிருந்தது;","poem":1},{"text":"அவளை தேற்றுவார் ஒருவரும் இல்லை.","poem":2},{"text":"“யெகோவாவே, என்னுடைய துன்பத்தைப் பாரும்;","poem":1},{"text":"என்னுடைய பகைவன் என்னை வெற்றி கொண்டானே” என்று அழுகிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"பகைவன் எருசலேமின் இன்பமான","poem":1},{"text":"எல்லாவற்றின்மேலும் தன் கைகளை வைத்தான்.","poem":2},{"text":"அவளுடைய பரிசுத்த இடத்திற்குள்","poem":1},{"text":"பிறநாட்டினர் நுழைவதை அவள் கண்டாள்.","poem":2},{"text":"யெகோவா தடைசெய்தவர்கள்","poem":1},{"text":"அவருடைய சபைக்குள் நுழைவதை அவள் கண்டாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"அவளுடைய மக்கள் யாவரும்","poem":1},{"text":"அப்பத்தைத் தேடித் தவிக்கிறார்கள்.","poem":2},{"text":"அவர்கள் தங்கள் உயிரைக் காப்பாற்றுவதற்காக தங்கள் திரவியங்களை","poem":1},{"text":"உணவுக்காக பண்டம் மாற்றம் செய்கிறார்கள்.","poem":2},{"text":"அவள், “யெகோவாவே கவனித்துப் பாரும்!","poem":1},{"text":"நான் அவமதிக்கப்பட்டிருக்கிறேன்” என்று துக்கிக்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“இந்த வழியாய் கடந்துபோகிறவர்களே,","poem":1},{"text":"உங்களுக்கு இது ஒரு பொருட்டாய் தோன்றவில்லையோ?","poem":2},{"text":"சுற்றிலும் நோக்கிப்பாருங்கள்.","poem":1},{"text":"யெகோவா தமது கடுங்கோபத்தின் நாளில்,","poem":2},{"text":"என்மேல் கொண்டுவந்த வேதனையைப்போன்ற","poem":1},{"text":"வேதனை ஏதும் உண்டோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“யெகோவா உயரத்திலிருந்து நெருப்பை அனுப்பினார்.","poem":1},{"text":"அதை எனது எலும்புகளுக்குள் இறங்கப் பண்ணினார்.","poem":2},{"text":"அவர் என்னுடைய கால்களுக்கு ஒரு வலையை விரித்து,","poem":1},{"text":"என்னைப் பின்னோக்கி திருப்பிவிட்டார்.","poem":2},{"text":"அவர் என்னைப் பாழாக்கி,","poem":1},{"text":"நாள்தோறும் மயக்கமடையச் செய்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“என்னுடைய பாவங்கள் ஒரு நுகமாக கட்டப்பட்டிருக்கின்றன;","poem":1},{"text":"அவை அவருடைய கைகளால் ஒன்றாக்கப்பட்டு,","poem":2},{"text":"என் கழுத்தின்மேல் போடப்பட்டுள்ளன.","poem":1},{"text":"யெகோவா என் பெலனை குன்றப்பண்ணினார்.","poem":2},{"text":"என்னால் எதிர்க்க முடியாதவர்களிடத்தில்","poem":1},{"text":"என்னை ஒப்புக்கொடுத்து விட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“என் மத்தியிலிருந்த இராணுவவீரர்களையெல்லாம்","poem":1},{"text":"யெகோவா புறக்கணித்துவிட்டார்;","poem":2},{"text":"என்னிடமுள்ள என்னுடைய வாலிபரை நசுக்கும்படி,","poem":1},{"text":"எனக்கெதிராக ஒரு படையை அழைத்திருக்கிறார்.","poem":2},{"text":"யூதாவின் கன்னிகையை யெகோவா","poem":1},{"text":"தம் திராட்சை ஆலையில் மிதித்துப்போட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"“இதனால்தான் நான் அழுகிறேன்.","poem":1},{"text":"என் கண்களில் கண்ணீர் நிரம்பி வழிகிறது.","poem":2},{"text":"என்னைத் தேற்ற என் அருகில் யாரும் இல்லை.","poem":1},{"text":"என் ஆவிக்கு புத்துயிர் அழிக்கவும் ஒருவரும் இல்லை.","poem":2},{"text":"பகைவன் வெற்றிகொண்டபடியினால்,","poem":1},{"text":"என்னுடைய பிள்ளைகள் ஆதரவற்றுப் போனார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"சீயோன் தன் கைகளை உதவிக்காக நீட்டுகிறாள்,","poem":1},{"text":"அவளை ஆறுதல்படுத்த ஒருவரும் இல்லை.","poem":2},{"text":"யாக்கோபின் அயலவர் அவனுக்குப்","poem":1},{"text":"பகைவர்களாகும்படி யெகோவா நியமித்திருக்கிறார்;","poem":2},{"text":"அவர்கள் மத்தியில் எருசலேம்","poem":1},{"text":"ஒரு அசுத்தப் பொருளாயிற்று.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“யெகோவா நேர்மையுள்ளவர்,","poem":1},{"text":"இருந்தாலும் நான் அவருடைய கட்டளைக்கு எதிராகக் கலகம் செய்தேன்.","poem":2},{"text":"மக்கள் கூட்டங்களே, நீங்கள் எல்லோரும் கேளுங்கள்;","poem":1},{"text":"என்னுடைய துன்பத்தைப் பாருங்கள்.","poem":2},{"text":"என் இளைஞரும், இளம்பெண்களும்","poem":1},{"text":"நாடுகடத்தப்பட்டுப் போனார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"“நான் என் கூட்டாளிகளை கூப்பிட்டேன்,","poem":1},{"text":"அவர்களோ எனக்கு துரோகம் செய்தார்கள்.","poem":2},{"text":"என்னுடைய ஆசாரியரும்,","poem":1},{"text":"முதியோரும் தங்கள் உயிரைக் காக்க","poem":2},{"text":"உணவு தேடுகையில்,","poem":1},{"text":"பட்டணத்தில் அழிந்துபோனார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“யெகோவாவே பாரும்! நான் எவ்வளவாய் துயரப்பட்டிருக்கிறேன்.","poem":1},{"text":"நான் எனக்குள்ளே கடும் வேதனைப்படுகிறேன்.","poem":2},{"text":"என் இருதயத்தில் கலக்கமுற்றிருக்கிறேன்.","poem":1},{"text":"ஏனெனில் நான் அதிகமாய் கலகம் பண்ணினேன்.","poem":2},{"text":"வெளியே, வாள் அழிக்கிறது;","poem":1},{"text":"உள்ளே, மரணம் மட்டுமே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“என்னுடைய புலம்பலை மக்கள் கேட்டிருக்கிறார்கள்,","poem":1},{"text":"ஆனால் என்னைத் தேற்றுவதற்கோ ஒருவரும் இல்லை.","poem":2},{"text":"என் பகைவர்கள் யாவரும் எனக்கு வந்த துயரத்தைக் கேள்விப்பட்டு,","poem":1},{"text":"நீர் அதை செய்தபடியால் மகிழ்ச்சியடைகிறார்கள்.","poem":2},{"text":"அவர்களும் என்னைப் போலாகும்படி நீர்","poem":1},{"text":"அறிவித்த நாளை வரப்பண்ணும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“அவர்களுடைய கொடுமைகள் எல்லாம் உமக்கு முன்பாக வரட்டும்;","poem":1},{"text":"என்னுடைய எல்லா பாவங்களுக்காக","poem":2},{"text":"நீர் எனக்குச் செய்ததுபோலவே,","poem":1},{"text":"அவர்களுக்கும் செய்யும்.","poem":2},{"text":"என் புலம்பல்கள் அநேகம்,","poem":1},{"text":"என் இருதயமும் சோர்ந்துபோகிறது.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/LAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/LAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JER/52.json","previousChapterAudioLinks":{},"numberOfVerses":22}