{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"LAM","translationId":"tam_tcv","name":"புலம்பல்","commonName":"புலம்பல்","title":"எரேமியாவின் புலம்பல்","order":25,"numberOfChapters":5,"sha256":"6b8626ede62ecce777c3e6dc73fd8cadf67ecec61103f405e66692cf50b70fdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tam_tcv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா தமது கோபத்தின் மேகத்தால்","poem":1},{"text":"சீயோன் மகளை எப்படி மூடிப்போட்டார்;","poem":2},{"text":"இஸ்ரயேலின் சீர்சிறப்பை","poem":1},{"text":"வானத்திலிருந்து பூமிக்குத் தள்ளிவிட்டார்;","poem":2},{"text":"அவர் தமது கோபத்தின் நாளில்","poem":1},{"text":"தமது பாதபீடத்தை நினைவுகூரவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யாக்கோபின் எல்லா குடியிருப்புகளையும்","poem":1},{"text":"யெகோவா இரக்கமின்றி விழுங்கிவிட்டார்;","poem":2},{"text":"யூதா மகளின் கோட்டைகளை","poem":1},{"text":"தமது கோபத்தில் தகர்த்து வீழ்த்திப்போட்டார்.","poem":2},{"text":"அரசுகளையும், அதன் இளவரசர்களையும்","poem":1},{"text":"அவமானப்படுத்தி தரையிலே தள்ளினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"அவருடைய கோபத்தினால்","poem":1},{"text":"இஸ்ரயேலின் முழு பலத்தையும்","poem":2},{"noteId":0},{"text":"இல்லாமல் பண்ணினார்.","poem":2},{"text":"அவர் தமது வலது கரத்தை, பகைவர்கள் நெருங்கி வருகையில், விலக்கிக்கொண்டார்.","poem":1},{"text":"அவர் யாக்கோபின் நாட்டில்,","poem":2},{"text":"தன்னைச் சுற்றியுள்ள எல்லாவற்றையும் எரிக்கிற,","poem":1},{"text":"கொழுந்துவிட்டெரிகிற நெருப்பைப்போல எரிந்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அவர் ஒரு பகைவனைப்போல வில்லை நாணேற்றினார்;","poem":1},{"text":"அவரது வலதுகரம் ஆயத்தமாயிருக்கிறது.","poem":2},{"text":"அவர் பகைவனைப்போல","poem":1},{"text":"கண்ணுக்கு இனியவர்களையெல்லாம் வெட்டிப்போட்டார்;","poem":2},{"text":"சீயோன் மகளின் கூடாரத்தில்","poem":1},{"text":"தமது கடுங்கோபத்தை நெருப்பைப்போல் ஊற்றிவிட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஆண்டவர் ஒரு பகைவனைப் போலிருக்கிறார்;","poem":1},{"text":"அவர் இஸ்ரயேலை விழுங்கிவிட்டார்;","poem":2},{"text":"அவளுடைய எல்லா அரண்மனைகளையும் விழுங்கி,","poem":1},{"text":"அவளுடைய கோட்டைகளை அழித்துவிட்டார்.","poem":2},{"text":"யூதாவின் மகளுக்கு புலம்பலையும்,","poem":1},{"text":"துக்கங்கொண்டாடலையும் அதிகரிக்கச் செய்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவர் தமது ஆலயத்தை ஒரு தோட்டத்தின் குடிசையைப்போல பாழாக்கிவிட்டார்;","poem":1},{"text":"அவர் தமது சபைக்கூடும் இடத்தையும் அழித்துப்போட்டார்.","poem":2},{"text":"யெகோவா, சீயோனுக்கு நியமித்த பண்டிகைகளையும்,","poem":1},{"text":"ஓய்வுநாட்களையும் அவள் நினைவிலிருந்தே எடுத்துப்போட்டார்;","poem":2},{"text":"தமது கடுங்கோபத்தில் அரசனையும்,","poem":1},{"text":"ஆசாரியனையும் புறக்கணித்துப் போட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவா தமது சொந்த பலிபீடத்தை புறக்கணித்து,","poem":1},{"text":"தமது பரிசுத்த இடத்தையும் கைவிட்டார்.","poem":2},{"text":"அவளுடைய அரண்மனைகளின் சுவர்களை","poem":1},{"text":"பகைவரின் கையில் ஒப்புக்கொடுத்தார்;","poem":2},{"text":"அவர்கள் நியமித்த பண்டிகை நாளிலிருப்பதுபோல்","poem":1},{"text":"யெகோவாவின் ஆலயத்தில் ஆரவாரம் செய்தார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவா சீயோன் மகளைச் சுற்றியுள்ள சுவரை","poem":1},{"text":"அழிப்பதற்குத் தீர்மானித்துவிட்டார்.","poem":2},{"text":"அவர் ஒரு அளவு நூலை நீட்டி அளந்தார்.","poem":1},{"text":"அவர் அழிப்பதிலிருந்து தமது கையை விலக்கிக் கொள்ளவில்லை.","poem":2},{"text":"அதனால் அவர் அரண்களையும், மதில்களையும் புலம்பச் செய்தார்;","poem":1},{"text":"அவை ஒன்றாக பாழாய்ப்போயின.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"எருசலேமின் வாசல்கள் நிலத்திற்குள்ளே புதைந்து கிடக்கின்றன;","poem":1},{"text":"அவைகளின் தாழ்ப்பாள்களை அவர் உடைத்து அழித்துவிட்டார்.","poem":2},{"text":"அவளுடைய அரசனும், அவளுடைய இளவரசர்களும்","poem":1},{"text":"நாடுகளுக்கு நடுவே நாடுகடத்தப்பட்டிருக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"சட்டம் இல்லாமற்போயிற்று.","poem":2},{"text":"அவளுடைய இறைவாக்கு உரைப்போருக்கு","poem":1},{"text":"யெகோவாவிடமிருந்து தரிசனங்கள் கிடைப்பதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"சீயோன் மகளின் முதியோர்","poem":1},{"text":"மவுனமாய் தரையில் உட்கார்ந்திருக்கிறார்கள்;","poem":2},{"text":"அவர்கள் தங்கள் தலையில் புழுதியைப் போட்டுக்கொண்டு,","poem":1},{"text":"துக்கவுடையை உடுத்திக்கொண்டார்கள்.","poem":2},{"text":"எருசலேமின் இளம்பெண்கள்","poem":1},{"text":"தங்கள் தலைகளை தரைமட்டும் தாழ்த்தியிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"அழுகிறதினால் என் கண்கள் மங்கிப்போயிற்று.","poem":1},{"text":"நான் எனக்குள் வேதனையடைகிறேன்.","poem":2},{"text":"என் இருதயம் தரையிலே ஊற்றப்படுகிறது.","poem":1},{"text":"ஏனெனில் என் மக்கள் அழிக்கப்படுகிறார்கள்.","poem":2},{"text":"பிள்ளைகளும் குழந்தைகளும்","poem":1},{"text":"பட்டணத்துத் தெருக்களில் மயங்கி விழுந்து கிடக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அப்பிள்ளைகள் காயமுற்ற மனிதரைப்போல்,","poem":1},{"text":"பட்டணத்து வீதிகளில் மயங்கிக் கிடக்கிறார்கள்.","poem":2},{"text":"அவ்வேளையில் அவர்கள் தங்கள் தாயாரிடம்,","poem":1},{"text":"“அப்பமும், பானமும் எங்கே?”","poem":2},{"text":"எனக்கேட்டு தாயாரின் கைகளில்","poem":1},{"text":"உயிரை விடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"எருசலேம் மகளே!","poem":1},{"text":"உனக்கு என்ன சொல்வேன்?","poem":2},{"lineBreak":true},{"text":"உன்னை நான் எதனோடு ஒப்பிடுவேன்?","poem":2},{"text":"சீயோன் கன்னி மகளே,","poem":1},{"text":"நான் உன்னைத் தேற்றும்படி","poem":2},{"lineBreak":true},{"text":"எதனுடன் உன்னை ஒப்பிட முடியும்?","poem":2},{"text":"உன் காயம் கடலைப்போல் ஆழமாயிருக்கிறதே.","poem":1},{"text":"யார் உன்னைக் குணமாக்க முடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"உனது இறைவாக்கு உரைப்போரின்","poem":1},{"text":"தரிசனங்கள் பொய்யும் பயனற்றவையுமே;","poem":2},{"text":"உனது சிறையிருப்பைத் தடுக்கும்படி,","poem":1},{"text":"அவர்கள் உன் பாவங்களை சுட்டிக்காட்டவில்லை.","poem":2},{"text":"அவர்கள் உனக்குக் கொடுத்த இறைவாக்குகள் பொய்யும்,","poem":1},{"text":"வழிதவறச் செய்வதுமே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"உன் வழியாய்க் கடந்து போகிறவர்கள் எல்லோரும்,","poem":1},{"text":"உன்னைப் பார்த்து தங்கள் கைகளைத் தட்டுகிறார்கள்;","poem":2},{"text":"எருசலேம் மகளைப் பார்க்கிறவர்கள்","poem":1},{"text":"கேலிசெய்து தங்கள் தலைகளை அசைத்துச் சொல்கிறதாவது:","poem":2},{"text":"“அழகின் நிறைவு என்றும்,","poem":1},{"text":"பூமி முழுவதற்கும் மகிழ்ச்சி என்றும்","poem":2},{"lineBreak":true},{"text":"அழைக்கப்பட்ட நகரம் இதுதானா?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"உன் பகைவர்கள் எல்லோரும்,","poem":1},{"text":"உனக்கெதிராகத் தங்கள் வாய்களை விரிவாகத் திறந்து வசைமொழி கூறுகிறார்கள்;","poem":2},{"text":"அவர்கள் கேலிசெய்து தங்களுடைய பற்களைக் கடித்துச் சொல்கிறதாவது:","poem":1},{"text":"“நாங்கள் அவளை விழுங்கிவிட்டோம்.","poem":2},{"text":"இந்த நாளுக்காகவே நாங்கள் காத்திருந்தோம்.","poem":1},{"text":"அதைக் காணவே நாங்கள் உயிரோடிருந்தோம்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"யெகோவா தாம் திட்டமிட்டதைச் செய்துவிட்டார்;","poem":1},{"text":"அவர் நீண்ட நாட்களுக்குமுன் நியமனம் செய்த தமது வார்த்தையை,","poem":2},{"lineBreak":true},{"text":"நிறைவேற்றிவிட்டார்.","poem":2},{"text":"எருசலேமை அவர் இரக்கமின்றி கவிழ்த்துப் போட்டார்,","poem":1},{"text":"பகைவன் உன்மேல் இழிவுபடுத்தி மகிழ அவர் இடமளித்தார்.","poem":2},{"lineBreak":true},{"text":"அவர் உன் பகைவரின் பெலத்தை ஓங்கச் செய்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"மக்களின் இருதயங்கள்","poem":1},{"text":"ஆண்டவரை நோக்கிக் கதறுகின்றன.","poem":2},{"text":"சீயோன் மகளின் மதிலே,","poem":1},{"text":"உனது கண்ணீர் இரவும் பகலும்","poem":2},{"lineBreak":true},{"text":"ஒரு நதியைப்போல் ஓடட்டும்;","poem":2},{"text":"உனக்கு ஓய்வு கொடாதே,","poem":1},{"text":"கண்ணீர்விடாமல் இருக்காதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"எழும்பு, இரவிலே","poem":1},{"text":"முதற்சாமத்தில் கதறி அழு,","poem":2},{"text":"யெகோவாவினுடைய சமுகத்தில்","poem":1},{"text":"உன் இருயத்தைத் தண்ணீரைப்போல் ஊற்று.","poem":2},{"text":"ஒவ்வொரு தெருவின் முனையிலும்,","poem":1},{"text":"பசியினால் மயங்கி விழும்","poem":2},{"text":"உனது பிள்ளைகளின் உயிருக்காக","poem":1},{"text":"அவரை நோக்கி உன் கைகளை உயர்த்து.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“யெகோவாவே, கவனித்துப் பாரும்:","poem":1},{"text":"நீர் யாரையாகிலும் இவ்விதமாய் எப்பொழுதாவது நடத்தியிருக்கிறீரோ?","poem":2},{"text":"பெண்கள் தாம் பெற்றெடுத்த பிள்ளைகளை உண்ண வேண்டுமோ?","poem":1},{"text":"தாங்கள் பராமரித்த வழித்தோன்றல்களை உண்ண வேண்டுமோ?","poem":2},{"text":"ஆண்டவரின் பரிசுத்த இடத்தில்","poem":1},{"text":"ஆசாரியரும் இறைவாக்கினரும் கொல்லப்பட வேண்டுமோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“வாலிபரும், முதியோரும் ஒன்றாய் வீதிகளின்","poem":1},{"text":"புழுதியில் விழுந்து கிடக்கிறார்கள்;","poem":2},{"text":"வாலிபரும், கன்னிப்பெண்களும்","poem":1},{"text":"வாளால் வெட்டி வீழ்த்தப்பட்டிருக்கிறார்கள்.","poem":2},{"text":"உமது கோபத்தின் நாளிலே அவர்களை வெட்டிப் போட்டீர்;","poem":1},{"text":"இரக்கமின்றி அவர்களை வெட்டிக் கொன்றீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“ஒரு விருந்து நாளுக்கு அழைப்பதுபோல,","poem":1},{"text":"திகிலுண்டாகும்படி எல்லாப் பக்கங்களிலும் எதிரிகளை வரவழைத்தீர்.","poem":2},{"text":"யெகோவாவின் கோபத்தின் நாளில் ஒருவனாகிலும் தப்பவுமில்லை,","poem":1},{"text":"பிழைக்கவுமில்லை;","poem":2},{"text":"நான் பராமரித்து வளர்த்தவர்களை,","poem":1},{"text":"என் பகைவன் அழித்துவிட்டான்.”","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"மூல மொழியில் கொம்பு என எழுதப்பட்டுள்ளது.","reference":{"chapter":2,"verse":3}}]},"thisChapterLink":"/api/tam_tcv/LAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/LAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/LAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}