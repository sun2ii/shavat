{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"LAM","translationId":"tam_tcv","name":"புலம்பல்","commonName":"புலம்பல்","title":"எரேமியாவின் புலம்பல்","order":25,"numberOfChapters":5,"sha256":"6b8626ede62ecce777c3e6dc73fd8cadf67ecec61103f405e66692cf50b70fdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tam_tcv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"அவருடைய கோபத்தின் பிரம்பினால்","poem":1},{"text":"உண்டான வேதனையைக் கண்ட மனிதன் நானே.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர் என்னை வெளியே துரத்தி,","poem":1},{"text":"வெளிச்சத்தில் அல்ல, இருளிலேயே நடக்கச் செய்தார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உண்மையாக, திரும்பதிரும்ப நாள்முழுவதும்","poem":1},{"text":"அவர் தமது கையை என்மேல் திருப்பினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"எனது தசையையும் தோலையும் முதுமையடையும்படி செய்தார்,","poem":1},{"text":"என் எலும்புகளையும் உடைத்துவிட்டார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர், கசப்பும் கஷ்டமும்","poem":1},{"text":"முற்றுகையிட்டு என்னைச் சூழும்படி செய்தார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வெகுகாலத்திற்குமுன் இறந்தவர்களைப்போல்,","poem":1},{"text":"என்னை இருளில் குடியிருக்கப் பண்ணினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நான் தப்பிவிடாதபடி அவர் என்னைச் சுற்றி வேலியடைத்தார்;","poem":1},{"text":"அவர் பாரமான சங்கிலிகளை என்மேல் சுமத்தினார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் உதவிக்காகக் கூப்பிடும்போதோ,","poem":1},{"text":"கதறி அழுகிறபோதோ அவர் என் மன்றாட்டைக் கேட்க மறுக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"செதுக்கிய கற்களால் அவர் என் வழியைத் தடைசெய்திருக்கிறார்;","poem":1},{"text":"அவர் என் பாதைகளைக் கோணலாக்கியிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"பதுங்கியிருக்கும் கரடியைப்போலவும்,","poem":1},{"text":"மறைந்திருக்கும் சிங்கத்தைப் போலவும்,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர் என்னைப் பாதையிலிருந்து இழுத்து,","poem":1},{"text":"என்னை உருக்குலைத்து உதவியின்றிக் கைவிட்டார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் தம்முடைய வில்லை வளைத்து,","poem":1},{"text":"தமது அம்புகளுக்கு என்னை இலக்காக்கினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"அவர் தன்னுடைய அம்புக் கூட்டிலிருந்த","poem":1},{"text":"அம்புகளினால் என் இருதயத்தைக் குத்தினார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் என்னுடைய எல்லா மக்களுக்கும் ஒரு சிரிப்புக்குரிய பொருளானேன்;","poem":1},{"text":"அவர்கள் நாள்முழுவதும் பாடலினால் என்னை ஏளனம் செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர் என்னை கசப்பினால் நிரப்பி,","poem":1},{"text":"காடியின் கசப்பினால் என்னை வெறுப்படையச் செய்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"அவர் என் பற்களைச் சரளைக் கல்லினால் உடைத்தார்;","poem":1},{"text":"அவர் என்னைப் புழுதியில் மிதித்துவிட்டார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நான் சமாதானத்தை இழந்திருக்கிறேன்;","poem":1},{"text":"சுகவாழ்வு என்ன என்பதையும் மறந்துவிட்டேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஆகையால் நான் கூறினதாவது, “என் சீர்சிறப்பும், யெகோவாவிடம் நான் கொண்டிருந்த","poem":1},{"text":"எல்லா எதிர்பார்ப்பும் இல்லாமல் போயிற்று.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"நான் எனது துன்பத்தையும், அலைச்சலையும்,","poem":1},{"text":"அதன் மனக் கசப்பையும், காடியையும் நினைவுகூருகிறேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நான் அவைகளை நன்கு நினைவுகூருகிறேன்,","poem":1},{"text":"அப்பொழுது என் ஆத்துமா எனக்குள்ளே சோர்ந்துபோயிற்று.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஆயினும் நான் இதை மனதில் கொண்டேன்.","poem":1},{"text":"அதனால் எனக்கு நம்பிக்கை உண்டு:","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"அதாவது யெகோவாவின் பெரிதான அன்பினாலே நாம் அழிக்கப்படாமலிருக்கிறோம்.","poem":1},{"text":"ஏனெனில் அவரது இரக்கத்திற்கு முடிவேயில்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"உமது அன்பும் இரக்கமும் காலைதோறும் புதிதாயிருக்கின்றன;","poem":1},{"text":"உமது உண்மை பெரியது.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நான் எனக்குள் சொல்லிக்கொள்கிறேன், “யெகோவாவே என் உரிமைப் பங்கு;","poem":1},{"text":"ஆகையால் நான் அவருக்காகக் காத்திருப்பேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"யெகோவாவிடம் எதிர்பார்ப்பு வைக்கிறவருக்கும்,","poem":1},{"text":"அவரைத் தேடுகிறவர்களுக்கும் அவர் நல்லவர்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"எனவே யெகோவாவின் இரட்சிப்புக்காக","poem":1},{"text":"அமைதியாய் காத்திருப்பது நல்லது.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"இளைஞனாய் இருக்கும்போதே","poem":1},{"text":"அவரது கண்டனத்தின் நுகத்தைச் சுமப்பது ஒரு மனிதனுக்கு நல்லது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"யெகோவா தாமே அதை அவன்மேல் வைத்தபடியால்,","poem":1},{"text":"அவன் மவுனமாய் தனிமையாய் அனுபவிக்கட்டும்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவன் புழுதியில் தன் முகத்தைப் புதைக்கட்டும்,","poem":1},{"text":"ஒருவேளை இன்னமும் அவனுக்கு எதிர்பார்ப்பு இருக்கலாம்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவன் தன்னை அடிப்பவனுக்குத் தன் மறு கன்னத்தைக் கொடுக்கட்டும்,","poem":1},{"text":"பகைவன் கொடுக்கும் அவமானங்களை ஏற்றுக்கொள்ளட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ஏனென்றால், ஆண்டவரால் ஒருவரும்","poem":1},{"text":"என்றென்றும் கைவிடப்படுவதில்லை.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அவர் துக்கத்தை வருவித்தாலும், அவர் இரக்கம் காண்பிப்பார்.","poem":1},{"text":"அவரது நேர்மையான அன்பு அவ்வளவு பெரியது.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அவர் துன்பத்தையோ துக்கத்தையோ","poem":1},{"text":"மனிதரின் பிள்ளைகள்மேல் விருப்பத்துடன் வருவிப்பதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"நாட்டிலுள்ள சிறைக் கைதிகளையெல்லாம்","poem":1},{"text":"கால்களின்கீழ் மிதிப்பதையும்,","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ஒருவனின் மனித உரிமைகளை","poem":1},{"text":"மகா உன்னதமானவரின் முன்னிலையில் மறுப்பதையும்,","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ஒரு மனிதனுக்கு நீதி வழங்கப்படாதிருப்பதையும்","poem":1},{"text":"யெகோவா காணாதிருப்பாரோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"யெகோவா உத்தரவிடாவிட்டால்,","poem":1},{"text":"எதையாவது பேசி அதை நிகழப்பண்ண யாரால் முடியும்?","poem":2}]},{"type":"verse","number":38,"content":[{"text":"பேரழிவு, நல்ல காரியங்கள் ஆகிய இரண்டும்","poem":1},{"text":"மகா உன்னதமான இறைவனுடைய வாயிலிருந்தல்லவோ வருகின்றன.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"வாழ்கிற எந்த மனிதனும்,","poem":1},{"text":"தன் பாவங்களுக்காகத் தண்டிக்கப்படும்போது, ஏன் முறையிடவேண்டும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"ஆகவே நாங்கள் எங்கள் வழிகளை ஆராய்ந்து சோதிப்போம்,","poem":1},{"text":"யெகோவாவிடம் திரும்புவோம்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"எங்கள் இருதயங்களையும், கைகளையும்","poem":1},{"text":"பரலோகத்திலிருக்கும், இறைவனுக்கு நேராக உயர்த்தி:","poem":2}]},{"type":"verse","number":42,"content":[{"text":"“நாங்கள் பாவம் செய்து கலகம் பண்ணினோம்,","poem":1},{"text":"நீர் எங்களை மன்னிக்கவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"“நீர் கோபத்தினால் உம்மை மூடிக்கொண்டு எங்களைப் பின்தொடர்ந்தீர்;","poem":1},{"text":"இரக்கமின்றி எங்களைக் கொன்றுபோட்டீர்.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"மேகத்தினால் நீர் உம்மை மூடிக்கொண்டிருப்பதால்,","poem":1},{"text":"மன்றாட்டு எதுவும் உம்மிடத்தில் வராது.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"நீர் எங்களை நாடுகளுக்குள்","poem":1},{"text":"குப்பையும் கூழமுமாக ஆக்கியிருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"“எங்கள் பகைவர்கள் யாவரும் தங்கள் வாயை விரிவாகத் திறந்து","poem":1},{"text":"எங்களுக்கு எதிராகப் பேசுகிறார்கள்.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"எங்கள்மேல் பயங்கரமும் கண்ணியும்,","poem":1},{"text":"பாழும் அழிவும் வந்தன.”","poem":2}]},{"type":"verse","number":48,"content":[{"text":"என் மக்கள் அழிக்கப்பட்டதனால்","poem":1},{"text":"என் கண்களிலிருந்து கண்ணீர் அருவியாய் ஓடுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":49,"content":[{"text":"என் கண்கள் ஓய்வின்றி,","poem":1},{"text":"கண்ணீர் சிந்திக்கொண்டிருக்கும்.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"பரலோகத்திலிருந்து யெகோவா","poem":1},{"text":"கண்ணோக்கிப் பார்க்கும் வரைக்கும்.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"என் நகரத்திலுள்ள பெண்களின் நிலைமையை நான் காண்கையில்,","poem":1},{"text":"என் ஆத்துமா துக்கிக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"காரணமின்றி எனக்குப் பகைவர்களாயிருந்தவர்கள்,","poem":1},{"text":"என்னை ஒரு பறவையைப்போல் வேட்டையாடினார்கள்.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"அவர்கள் என் வாழ்வை முடிக்க முயன்று,","poem":1},{"text":"குழியில் தள்ளி என்மேல் கற்களை எறிந்து மூடினார்கள்;","poem":2}]},{"type":"verse","number":54,"content":[{"text":"வெள்ளம் என் தலையை மூடிக்கொண்டது.","poem":1},{"text":"நான் அழிந்து போகப்போகிறேன் என்று நினைத்தேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":55,"content":[{"text":"யெகோவாவே, குழியின் ஆழத்திலிருந்து,","poem":1},{"text":"உமது பெயரைச்சொல்லிக் கூப்பிட்டேன்.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"“ஆறுதலுக்காகக் கதறும் என் சத்தத்திற்கு உமது செவியை மூடிக்கொள்ளாதேயும்”","poem":1},{"text":"என்ற என் விண்ணப்பத்தை நீர் கேட்டீர்.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"நான் உம்மை நோக்கிக் கூப்பிட்டபோது, நீர் என் அருகே வந்து,","poem":1},{"text":"“நீ பயப்படாதே” என்றீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":58,"content":[{"text":"யெகோவாவே, நீரே என் வழக்கை பொறுப்பேற்றீர்;","poem":1},{"text":"என் உயிரை மீட்டுக்கொண்டீர்.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"யெகோவாவே! எனக்குச் செய்யப்பட்ட தீமைகளை நீர் கண்டிருக்கிறீர்.","poem":1},{"text":"நீர் எனக்காக வாதாடும்!","poem":2}]},{"type":"verse","number":60,"content":[{"text":"அவர்களுடைய பழிவாங்குதலின் ஆழத்தையும்,","poem":1},{"text":"அவர்கள் எனக்கெதிராகப் போட்ட சதித்திட்டங்களையும் கண்டிருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":61,"content":[{"text":"யெகோவாவே, அவர்களுடைய எல்லா அவமதிப்புகளையும்,","poem":1},{"text":"எனக்கெதிரான அவர்களுடைய எல்லா சதிகளையும் கேட்டீர்;","poem":2}]},{"type":"verse","number":62,"content":[{"text":"அதை என் பகைவர்கள் நாள்முழுவதும் இரகசியமாய்ப் பேசி,","poem":1},{"text":"எனக்கு எதிராய் முணுமுணுக்கிறார்கள்.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"அவர்களைப் பாரும்! உட்கார்ந்தாலும் நின்றாலும்,","poem":1},{"text":"அவர்கள் தங்கள் பாடல்களால் என்னை கேலி செய்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":64,"content":[{"text":"யெகோவாவே, அவர்களுக்குத் தகுந்த பதில் செய்யும்.","poem":1},{"text":"அவர்களின் கைகள் செய்தவற்றுக்காக பதில் செய்யும்.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"அவர்களுடைய இருதயத்தின்மேல் திரைபோடும்,","poem":1},{"text":"உமது சாபம் அவர்கள்மேல் இருக்கட்டும்.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"கோபத்தோடு அவர்களைப் பின்தொடர்ந்து,","poem":1},{"text":"யெகோவாவின் வானங்களின் கீழ் இருந்து அவர்களை அழித்துப்போடும்.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/LAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/LAM/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/LAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":66}