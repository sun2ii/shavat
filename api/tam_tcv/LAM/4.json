{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"LAM","translationId":"tam_tcv","name":"புலம்பல்","commonName":"புலம்பல்","title":"எரேமியாவின் புலம்பல்","order":25,"numberOfChapters":5,"sha256":"6b8626ede62ecce777c3e6dc73fd8cadf67ecec61103f405e66692cf50b70fdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tam_tcv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"தங்கம் எவ்வளவாய் தன் ஒளியை இழந்து,","poem":1},{"text":"சுத்தத் தங்கமும் எவ்வளவாய் மங்கிப்போயிற்றே!","poem":2},{"text":"பரிசுத்த இடத்தின் இரத்தினக் கற்கள்","poem":1},{"text":"தெருவின் முனைகளிலும் சிதறுண்டு கிடக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ஒருகாலத்தில் சுத்தத் தங்கத்தின் மதிப்பிற்கு ஒப்பாயிருந்த,","poem":1},{"text":"விலைமதிப்புமிக்க சீயோன் மகன்கள்,","poem":2},{"text":"இப்போது மண் பாத்திரங்களாய் எண்ணப்படுகிறார்கள்.","poem":1},{"text":"குயவனின் கைவேலையாக மதிக்கப்படுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நரிகளும் தங்கள் குட்டிகளுக்கு","poem":1},{"text":"பால் கொடுக்கும்.","poem":2},{"text":"ஆனால் என் மக்களோ பாலைவனத்திலுள்ள தீக்கோழிகளைப்போல,","poem":1},{"text":"கொடூர மனமுள்ளவர்களானார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"தாகத்தினால் குழந்தையின் நாவு","poem":1},{"text":"அதன் மேல்வாய் அண்ணத்துடன் ஒட்டிக்கொள்கிறது;","poem":2},{"text":"பிள்ளைகள் உணவுக்காக கெஞ்சுகின்றனர்,","poem":1},{"text":"ஆனால் அதைக் கொடுப்பவர் ஒருவருமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"சுவையான உணவை ஒருகாலத்தில் உண்டவர்கள்","poem":1},{"text":"வீதிகளில் ஆதரவற்றுத் திரிகிறார்கள்.","poem":2},{"text":"மென்பட்டு உடை அணிந்து முன்பு வாழ்ந்தவர்கள்","poem":1},{"text":"இப்போது சாம்பல் மேடுகளில் இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"உதவும் கரம் எதுவுமின்றி","poem":1},{"text":"ஒரு நொடியில் கவிழ்க்கப்பட்ட சோதோமின்","poem":2},{"text":"தண்டனையைவிட, என் மக்களின்","poem":1},{"text":"தண்டனை பெரிதாயிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"அவர்களின் இளவரசர்கள்","poem":1},{"noteId":1},{"text":"உறைபனியைப் பார்க்கிலும் பிரகாசமாயும்,","poem":1},{"text":"பாலைவிட வெண்மையாயும் இருந்தார்கள்.","poem":2},{"text":"அவர்களின் உடல்கள் பவளத்தைவிட சிவப்பாகவும்,","poem":1},{"text":"அவர்களின் தோற்றம் நீல மாணிக்கக் கற்களைப்போலவும் இருந்தன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஆனால் இப்பொழுதோ அவர்கள் அடுப்புக்கரியைவிடக் கறுப்பாயிருக்கிறார்கள்;","poem":1},{"text":"வீதிகளில் அவர்கள் இன்னார் என அறியப்படாதிருக்கிறார்கள்.","poem":2},{"text":"அவர்களுடைய தோல், எலும்புகளின்மேல் சுருங்கி","poem":1},{"text":"காய்ந்த மரத்திற்கு ஒப்பானது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"பஞ்சத்தால் சாகிறவர்களைவிட,","poem":1},{"text":"வாளினால் கொலைசெய்யப்பட்டவர்களின் நிலை மேலானது;","poem":2},{"text":"பஞ்சத்தால் சாகிறவர்களோ வயல்களின் விளைச்சல் குறைவுபட்டதால்","poem":1},{"text":"பசியினால் துன்பப்பட்டு உருக்குலைந்து போகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"இரக்கமுள்ள பெண்களும் தங்கள் சொந்தக் கைகளால்","poem":1},{"text":"தங்கள் சொந்தப் பிள்ளைகளைச் சமைத்தனரே,","poem":2},{"text":"என் மக்கள் அழிக்கப்படுகையில்","poem":1},{"text":"பிள்ளைகள் அவர்களுக்கு உணவானார்களே!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"யெகோவா தமது கோபத்தை முழுமையாய் வெளிப்படுத்தினார்;","poem":1},{"text":"அவர் தமது கடுங்கோபத்தை ஊற்றிவிட்டார்.","poem":2},{"text":"அவர் சீயோனில் நெருப்பை மூட்டினார்.","poem":1},{"text":"அது அவளின் அஸ்திபாரங்களை எரித்துப்போட்டது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"பகைவர்களும் எதிரிகளும்,","poem":1},{"text":"எருசலேமின் வாசல்களுக்குள் புகுவார்கள் என்று,","poem":2},{"text":"பூமியின் அரசர்களோ","poem":1},{"text":"உலகத்தின் எந்த மக்களோ நம்பவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஆனால் அது நடந்தது.","poem":1},{"text":"அவளுடைய இறைவாக்கு உரைப்போரின் பாவங்களினாலும்,","poem":2},{"text":"ஆசாரியர்களின் அக்கிரமங்களினாலும் இது நடந்தது.","poem":1},{"text":"அவர்களால் எருசலேமுக்குள் நேர்மையானவர்களின் இரத்தம் சிந்தப்பட்டது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"இப்பொழுதோ அவர்கள் குருடரான","poem":1},{"text":"மனிதரைப்போல் வீதிகளில் அலைந்து திரிகிறார்கள்.","poem":2},{"text":"அவர்கள் இரத்தத்தினால் கறைப்பட்டிருப்பதால்,","poem":1},{"text":"அவர்களுடைய உடைகளைத் தொடுவதற்குக்கூட ஒருவரும் துணியவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“விலகிப்போங்கள். நீங்கள் அசுத்தமானவர்கள்.","poem":1},{"text":"விலகுங்கள்! விலகுங்கள்! எங்களைத் தொடாதிருங்கள்”","poem":2},{"text":"என்று மனிதர் அவர்களைப் பார்த்து கத்துகிறார்கள்.","poem":1},{"text":"அவர்கள் தப்பியோடி அலையும்போது அங்குள்ள மக்கள்,","poem":2},{"lineBreak":true},{"text":"“இவர்கள் இனிமேலும் இங்கே இருக்கமுடியாது” என்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"யெகோவாவே அவர்களைச் சிதறடித்தார்;","poem":1},{"text":"அவர் அவர்கள்மேல் கண்காணிப்பாய் இருப்பதில்லை.","poem":2},{"text":"ஆசாரியரைக் கனம்பண்ணுவதுமில்லை,","poem":1},{"text":"முதியோருக்கு தயவு காண்பிப்பதுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"அத்துடன் உதவிக்காக வீணாய் பார்த்திருந்தும்","poem":1},{"text":"எங்கள் கண்கள் மங்கிப்போயின;","poem":2},{"text":"எங்கள் காவல் கோபுரங்களிலிருந்து,","poem":1},{"text":"எங்களைக் காப்பாற்ற முடியாத ஒரு நாட்டிற்காக எதிர்பார்த்துக் கொண்டிருந்தோமே!","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"மனிதர் எங்கள் ஒவ்வொரு அடிச்சுவடையும் பதுங்கிப் பின்தொடர்ந்தார்கள்,","poem":1},{"text":"அதனால் வீதிகளில் எங்களால் நடக்க முடியவில்லை.","poem":2},{"text":"எங்கள் முடிவு நெருங்கியிருந்தது,","poem":1},{"text":"ஏனெனில் எங்களுக்கு எண்ணப்பட்ட நாட்கள் முடிந்தன, எங்கள் முடிவும் வந்துவிட்டது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"எங்களைப் பின்தொடர்ந்தவர்கள்,","poem":1},{"text":"ஆகாயத்தில் பறக்கும் கழுகுகளைப் பார்க்கிலும் வேகமாய் இருந்தார்கள்;","poem":2},{"text":"அவர்கள் மலைகளில் எங்களைத் துரத்தி பாலைவனத்தில்","poem":1},{"text":"எங்களுக்காய் பதுங்கியிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"யெகோவாவினால் அபிஷேகம் செய்யப்பட்ட, எங்கள் உயிர்மூச்சான அரசனும்,","poem":1},{"text":"அவர்களுடைய கண்ணிகளில் அகப்பட்டுக்கொண்டான்.","poem":2},{"text":"அவனுடைய நிழலின்கீழ்,","poem":1},{"text":"நாடுகளின் மத்தியில் நாங்கள் வாழ்வோம் என்று நினைத்திருந்தோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ஊத்ஸ் நாட்டில் வாழுகின்ற ஏதோமின் மகளே,","poem":1},{"text":"நீ மகிழ்ந்து சந்தோஷப்படு.","poem":2},{"text":"ஆனால் உனக்குங்கூட இறை கோபத்தின் பாத்திரம் கொடுக்கப்படும்;","poem":1},{"text":"நீ குடித்து வெறிகொண்டு, ஆடையில்லாமல் கிடப்பாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"சீயோன் மகளே, உனது தண்டனை முடிவுறும்;","poem":1},{"text":"உன் சிறையிருப்பை அவர் நீடிக்கமாட்டார்.","poem":2},{"text":"ஆனால் ஏதோமின் மகளே,","poem":1},{"text":"அவர் உன் பாவங்களைத் தண்டித்து உன் கொடுமைகளை வெளிப்படுத்துவார்.","poem":2}]},{"type":"line_break"},{"type":"line_break"}],"footnotes":[{"noteId":1,"caller":"+","text":"இளவரசர்கள் அல்லது நசரேயர்கள். நியா. 13:5.","reference":{"chapter":4,"verse":7}}]},"thisChapterLink":"/api/tam_tcv/LAM/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/LAM/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/LAM/3.json","previousChapterAudioLinks":{},"numberOfVerses":22}