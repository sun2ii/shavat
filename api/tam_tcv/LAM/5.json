{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"LAM","translationId":"tam_tcv","name":"புலம்பல்","commonName":"புலம்பல்","title":"எரேமியாவின் புலம்பல்","order":25,"numberOfChapters":5,"sha256":"6b8626ede62ecce777c3e6dc73fd8cadf67ecec61103f405e66692cf50b70fdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/LAM/1.json","lastChapterNumber":5,"lastChapterApiLink":"/api/tam_tcv/LAM/5.json","totalNumberOfVerses":154},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, எங்களுக்கு நடந்ததை நினைவுகூரும்;","poem":1},{"text":"எங்கள் அவமானத்தை நோக்கிப்பாரும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"எங்கள் உரிமைச்சொத்துக்கள் அந்நியருக்கு கொடுக்கப்பட்டன.","poem":1},{"text":"எங்கள் வீடுகள் பிறநாட்டவருக்குக் கொடுக்கப்பட்டன.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நாங்கள் அநாதைகளானோம், தகப்பன் இல்லை.","poem":1},{"text":"எங்கள் தாய்மார்கள் விதவைகளைப் போலிருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நாங்கள் குடிக்கும் தண்ணீரை விலைகொடுத்து வாங்க வேண்டியிருக்கிறது;","poem":1},{"text":"எங்கள் விறகும் பணத்திற்கே வாங்கப்படுகிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"எங்களைப் பின்தொடர்கிறவர்கள் எங்கள் காலடியில் நிற்கிறார்கள்;","poem":1},{"text":"நாங்கள் களைத்துப்போனோம். ஆனால் எங்களுக்கு ஓய்வு இல்லை.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நாங்கள் உணவு பெறுதவதற்காக எகிப்திற்குக் கீழும்,","poem":1},{"text":"அசீரியாவுக்குக் கீழும் அடங்கிப்போனோம்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எங்கள் முற்பிதாக்கள் பாவம் செய்து, இல்லாமற்போனார்கள்;","poem":1},{"text":"நாங்களோ அவர்களுடைய தண்டனைகளைச் சுமக்கிறோம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அடிமைகள் எங்களுக்கு மேலாக ஆளுகிறார்கள்,","poem":1},{"text":"அவர்களுடைய கையிலிருந்து எங்களை விடுவிக்க யாருமேயில்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"பாலைவனத்தில் இருக்கும் வாளின் நிமித்தம்,","poem":1},{"text":"எங்கள் உயிரைக் கையில் பிடித்துக்கொண்டே, எங்கள் உணவைத் தேடுகிறோம்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"பசியின் கொடுமையினால்,","poem":1},{"text":"காய்ச்சல் வந்து எங்கள் தோல் அடுப்படியைப்போல் கறுத்துப்போயிற்று.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பெண்கள் சீயோனிலும், கன்னிகைகள் யூதா பட்டணத்திலும்","poem":1},{"text":"மானபங்கம் செய்யப்படுகிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இளவரசர்களை அவர்கள் கைகளைக் கட்டி தூக்கிலிட்டார்கள்;","poem":1},{"text":"முதியோருக்கு மரியாதை காட்டப்படுவதுமில்லை.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இளைஞர்கள் ஆலைகளில் செக்கு இழுக்க கொண்டுசெல்லப்படுகிறார்கள்;","poem":1},{"text":"சிறுவர்கள் பாரமான மரங்களைச் சுமந்து தள்ளாடுகிறார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"முதியோர் பட்டணத்தின் வாசலிலிருந்து போய்விட்டார்கள்;","poem":1},{"text":"வாலிபர் தாங்கள் இசை மீட்பதை நிறுத்திவிட்டார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"எங்கள் இருதயத்தின் மகிழ்ச்சி போய்விட்டது;","poem":1},{"text":"எங்கள் நடனம் புலம்பலாக மாறிற்று.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"எங்கள் தலையிலிருந்த மகுடம் விழுந்து விட்டது.","poem":1},{"text":"நாங்கள் பாவம் செய்தோமே; எங்களுக்கு ஐயோ கேடு!","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இதனால் எங்கள் இருதயம் சோர்ந்துபோயிற்று,","poem":1},{"text":"இவைகளினால் எங்கள் கண்கள் மங்கிப்போகின்றன;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஏனெனில், சீயோன் மலை பாழாகிக் கிடக்கிறது;","poem":1},{"text":"அங்கே நரிகள் இரைதேடித் திரிகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யெகோவாவே, நீரோ என்றென்றும் அரசாளுபவர்;","poem":1},{"text":"உமது சிங்காசனம் தலைமுறை தலைமுறையாக நிலைநிற்கும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ஏன் எங்களை நீர் தொடர்ந்து மறந்துவிடுகிறீர்?","poem":1},{"text":"ஏன் எங்களை நெடுங்காலமாய் கைவிடுகிறீர்?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"யெகோவாவே, எங்களைப் புதுப்பித்து எங்களை உம்மிடத்தில் திருப்பிக்கொள்ளும்;","poem":1},{"text":"எங்கள் நாட்களை முந்திய நாட்களைப்போல் புதிதாக்கும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அப்படியில்லாவிட்டால், நீர் எங்களை முற்றிலுமாக புறக்கணித்துவிடுவீரோ?","poem":1},{"text":"எங்கள்மேல் கடுங்கோபம் கொண்டிருக்கிறீரே!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/LAM/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/EZK/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/LAM/4.json","previousChapterAudioLinks":{},"numberOfVerses":22}