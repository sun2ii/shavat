{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"MIC","translationId":"tam_tcv","name":"மீகா","commonName":"மீகா","title":"மீகா","order":33,"numberOfChapters":7,"sha256":"12224b320e32222be511d30e3feac01f0b0c5becadfc9e135c7537bc9d4f5424","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tam_tcv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["யூதாவின் அரசர்களான யோதாம், ஆகாஸ், எசேக்கியா ஆகியோர்களின் ஆட்சிக்காலத்தில், மோரேசேத் ஊரைச்சேர்ந்த மீகா என்பவனுக்கு வந்த யெகோவாவின் வார்த்தை இதுவே. சமாரியாவையும், எருசலேமையும் குறித்து அவன் கண்ட தரிசனம்:"]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"மக்கள் கூட்டங்களே, நீங்கள் எல்லோரும் கேளுங்கள்,","poem":1},{"text":"பூமியே, அதில் உள்ளவர்களே, செவிகொடுங்கள்,","poem":2},{"text":"ஆண்டவராகிய யெகோவா உங்களுக்கு எதிராய் சாட்சி கூறப்போகிறார்,","poem":1},{"text":"யெகோவா பரலோகத்திலுள்ள தமது பரிசுத்த ஆலயத்திலிருந்து பேசப்போகிறார்.","poem":2}]},{"type":"heading","content":["சமாரியா, எருசலேமுக்கு எதிரான நியாயத்தீர்ப்பு,"]},{"type":"verse","number":3,"content":[{"text":"நோக்கிப்பாருங்கள்; யெகோவா தமது உறைவிடத்திலிருந்து வருகிறார்.","poem":1},{"text":"அவர் இறங்கி பூமியின் உயர்ந்த இடங்களில் உலாவுகிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நெருப்பின் முன் மெழுகு போலவும்,","poem":1},{"text":"மலைச்சரிவில் பாய்ந்தோடும் தண்ணீர் போலவும்","poem":2},{"text":"மலைகள் அவருக்குக் கீழ் உருகுகின்றன.","poem":1},{"text":"பள்ளத்தாக்குகள் பிளக்கின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யாக்கோபின் மீறுதல்களினாலும்,","poem":1},{"text":"இஸ்ரயேல் வீட்டாரின் பாவங்களினாலுமே இவை எல்லாம் நடக்கின்றன.","poem":2},{"text":"யாக்கோபின் மீறுதல் என்ன?","poem":1},{"text":"சமாரியா அல்லவா?","poem":2},{"text":"யூதாவின் வழிபாட்டு மேடை எது?","poem":1},{"text":"எருசலேம் அல்லவா?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“எனவே யெகோவா சொல்கிறதாவது:","poem":1},{"text":"நான் சமாரியாவை ஒரு இடிபாட்டுக் குவியலாக்குவேன்.","poem":2},{"text":"திராட்சைத் தோட்ட நிலமாக அதை மாற்றுவேன்.","poem":1},{"text":"அவற்றின் கற்களை பள்ளத்தாக்கில் கொட்டி, அஸ்திபாரங்களை வெறுமையாக்குவேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"சமாரியாவின் விக்கிரகங்கள் யாவும்","poem":1},{"text":"துண்டுகளாய் நொறுக்கப்படும்;","poem":2},{"text":"அவள் ஆலயத்திற்குக் கொடுத்த அன்பளிப்புகள் எல்லாம்","poem":1},{"text":"நெருப்பில் சுட்டெரிக்கப்படும்;","poem":2},{"lineBreak":true},{"text":"அவளுடைய உருவச்சிலைகள் அனைத்தையும் அழிப்பேன்.","poem":2},{"text":"அவள் தன் அன்பளிப்புகளை கோயில் வேசிகளின் கூலியிலிருந்து பெற்றபடியால்,","poem":1},{"text":"பகைவர்கள் அவற்றைத் திரும்பவும் வேசிகளின் கூலியாகவே பயன்படுத்துவார்கள்.”","poem":2}]},{"type":"heading","content":["மீகாவின் அழுகையும் புலம்பலும்"]},{"type":"verse","number":8,"content":[{"text":"சமாரியாவின் அழிவின் நிமித்தம் நான் அழுது புலம்புவேன்;","poem":1},{"text":"வெறுங்காலோடும் நிர்வாணத்துடனும் நடந்து திரிவேன்.","poem":2},{"text":"நரியைப்போல் ஊளையிட்டு,","poem":1},{"text":"ஆந்தையைப்போல் அலறுவேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏனெனில் சமாரியாவின் புண் குணமாக்க முடியாதது;","poem":1},{"text":"அது யூதாவரை வந்துள்ளது.","poem":2},{"text":"என் மக்கள் வாழும்","poem":1},{"text":"எருசலேம் வரையுங்கூட அது வந்துள்ளது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அதை காத் பட்டணத்தில் சொல்லவேண்டாம்;","poem":1},{"text":"கொஞ்சமும் அழவே வேண்டாம்.","poem":2},{"text":"பெத் அப்பிராவிலே","poem":1},{"text":"புழுதியில் புரளுங்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"சாப்பீரில் வாழ்கிறவர்களே, நிர்வாணத்துடனும் வெட்கத்துடனும் கடந்துபோங்கள்.","poem":1},{"text":"சாயனானில் வாழ்கிறவர்கள்","poem":2},{"text":"வெளியே வரமாட்டார்கள்.","poem":1},{"text":"பெத் ஏசேல் துக்கங்கொண்டாடுகிறது.","poem":2},{"text":"அதற்குரிய பாதுகாப்பு","poem":1},{"text":"உன்னிடமிருந்து எடுபட்டுப் போயிற்று.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மாரோத்தில் வாழ்கிறவர்கள் வேதனையில் துடித்து,","poem":1},{"text":"விடுதலைக்காகக் காத்திருக்கின்றனர்.","poem":2},{"text":"ஏனெனில், யெகோவாவிடமிருந்து பேராபத்து வந்திருக்கிறது.","poem":1},{"text":"அது எருசலேமின் வாசலுக்கும் வந்திருக்கிறது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"லாகீசில் வாழ்கிறவர்களே,","poem":1},{"text":"குதிரைகளை தேரில் பூட்டுங்கள்!","poem":2},{"text":"நீங்களே சீயோன் மகளுடைய பாவத்தின் ஆரம்பம்.","poem":1},{"text":"ஏனெனில் இஸ்ரயேலின் மீறுதல்கள் உங்களிடத்திலேயும் காணப்பட்டன.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஆதலால் யூதாவின் மக்களே,","poem":1},{"text":"நீங்கள் மோர்ஷேத் காத்துக்கு பிரியாவிடை சொல்லி அனுப்பிவிடுவீர்கள்.","poem":2},{"text":"அக்சீப் பட்டணம்","poem":1},{"text":"இஸ்ரயேலின் அரசர்களுக்கு ஏமாற்றமாகும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"மரேஷாவில் வாழ்கிறவர்களே,","poem":1},{"text":"உங்களுக்கெதிராக வெற்றி வீரனொருவனை யெகோவா கொண்டுவருவார்.","poem":2},{"text":"இஸ்ரயேலின் மேன்மையான தலைவர்கள்","poem":1},{"text":"அதுல்லாம் குகையில் ஒளிந்துகொள்வார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீங்கள் மகிழ்ச்சிகொள்கிற பிள்ளைகளுக்காகத் துக்கங்கொண்டாடி,","poem":1},{"text":"உங்கள் தலையை மொட்டையடியுங்கள்;","poem":2},{"text":"அவர்கள் உங்களைவிட்டு நாடு கடத்தப்படப் போவதால்,","poem":1},{"text":"கழுகின் தலையைப்போல் உங்கள் தலைகளை மொட்டையடித்துக் கொள்ளுங்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/MIC/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/MIC/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JON/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}