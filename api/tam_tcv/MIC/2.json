{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"MIC","translationId":"tam_tcv","name":"மீகா","commonName":"மீகா","title":"மீகா","order":33,"numberOfChapters":7,"sha256":"12224b320e32222be511d30e3feac01f0b0c5becadfc9e135c7537bc9d4f5424","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tam_tcv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":2,"content":[{"type":"heading","content":["மனிதனின் திட்டம்"]},{"type":"verse","number":1,"content":[{"text":"தங்கள் படுக்கைகளிலிருந்து எழும்புவதற்கு முன்பே தீமையான சூழ்ச்சிசெய்து,","poem":1},{"text":"அநியாயத்தைத் திட்டமிடுகிறவர்களுக்கு ஐயோ கேடு,","poem":2},{"text":"அதைச் செய்யத்தக்க பலம் அவர்களில் இருப்பதனால்","poem":1},{"text":"விடியற்காலமாகிறபோது அதைச் செயல்படுத்துகிறார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"வயல்களை ஆசைப்பட்டு,","poem":1},{"text":"அவற்றைப் பறித்துக்கொள்கிறார்கள்.","poem":2},{"text":"வீடுகளையும் அநீதியாய் எடுத்துக்கொள்கிறார்கள்.","poem":1},{"text":"ஒருவனுடைய வீட்டையும், அவனுடைய சொத்தையும் ஏமாற்றிப் பறிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":["ஆகையால் யெகோவா சொல்கிறதாவது:",{"text":"“இந்த மக்களுக்கு எதிராக ஒரு பேராபத்தைத் திட்டமிட்டிருக்கிறேன்,","poem":1},{"text":"அதிலிருந்து நீங்கள் உங்களைக் காப்பாற்றிக் கொள்ளமுடியாது.","poem":2},{"text":"இனிமேல் நீங்கள் பெருமையாய் நடக்கவும் முடியாது.","poem":1},{"text":"ஏனெனில் அது பேரழிவின் காலமாயிருக்கும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அந்த நாள் வரும்போது மனிதர் உங்களை இழிவாகப் பேசுவார்கள்;","poem":1},{"text":"அவர்கள் உங்கள்மீது புலம்பல் பாடுவார்கள்.","poem":2},{"lineBreak":true},{"text":"இந்த விதமாய் நீங்கள் பாடுவதுபோல் பாடி கேலி செய்வார்கள்:","poem":2},{"text":"‘நாம் முற்றிலும் பாழானோம்;","poem":1},{"text":"நமது மக்களின் உடைமைகள் பிரித்துக்கொடுக்கப்பட்டன.","poem":2},{"text":"யெகோவா நம்மிடமிருந்து அதை எடுத்துக்கொள்கிறார்!","poem":1},{"text":"நம் வயல்வெளிகளையோ அவர் நமது எதிரிகளுக்குக் கொடுக்கிறார்’ ”","poem":2},{"lineBreak":true},{"text":"என்று புலம்புவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஆதலால் நிலத்தைச் சீட்டுப்போட்டு பாகம் பிரித்து","poem":1},{"text":"யெகோவாவின் சபையில் உள்ளவர்களுக்குத் திரும்பக் கொடுக்கும்போது,","poem":2},{"lineBreak":true},{"text":"அதைப் பெற்றுக்கொள்வதற்கு உங்களில் ஒருவனும் இருக்கமாட்டான்.","poem":2}]},{"type":"heading","content":["பொய் தீர்க்கதரிசிகள்"]},{"type":"verse","number":6,"content":[{"text":"மக்களின் தீர்க்கதரிசிகளே, “நீங்கள் தீர்க்கதரிசனம் சொல்லாதீர்கள்,","poem":1},{"text":"இவற்றைக் குறித்துத் தீர்க்கதரிசனம் சொல்லாதீர்கள்.","poem":2},{"lineBreak":true},{"text":"அவமானம் எங்கள்மேல் வரமாட்டாது” என்று எனக்குச் சொல்கிறீர்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"மேலும் நீங்கள், யாக்கோபின் வீட்டாரே,","poem":1},{"text":"“யெகோவாவின் ஆவியானவர் கோபம் கொண்டுள்ளாரோ?","poem":2},{"lineBreak":true},{"text":"அவர் இப்படியானவற்றைச் செய்கிறவரோ?”","poem":2},{"lineBreak":true},{"text":"“நீதியான வழியில் நடக்கிறவனுக்கு","poem":1},{"text":"என் வார்த்தைகள் நன்மையைச் செய்யாதோ?","poem":2},{"lineBreak":true},{"text":"என்று அவர் சொல்கிறார் அல்லவா” என்றும் சொல்கிறீர்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அதற்கு யெகோவா சொல்கிறதாவது,","poem":1},{"text":"அண்மைக்காலமாக நீங்கள் என் மக்களுக்கெதிராக","poem":2},{"lineBreak":true},{"text":"ஒரு பகைவனைப் போல் எழும்பியிருக்கிறீர்கள்.","poem":2},{"text":"நீங்கள் போரிலிருந்து திரும்பி வருகிறவர்களைப்போல் நடந்து,","poem":1},{"text":"கவலையின்றி போகிறவனிடமிருந்து,","poem":2},{"lineBreak":true},{"text":"விலையுயர்ந்த அங்கியை உரிந்து எடுக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"என் மக்களுள் இருக்கும் பெண்களை,","poem":1},{"text":"அவர்கள் மகிழ்ச்சியோடு வாழ்ந்த வீடுகளிலிருந்து நீங்கள் துரத்திவிடுகிறீர்கள்.","poem":2},{"text":"அவர்களுடைய பிள்ளைகளிடமிருந்தும்,","poem":1},{"text":"என் ஆசீர்வாதங்களை என்றென்றுமாய் எடுத்துப் போடுகிறீர்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எழுந்து போய்விடுங்கள்,","poem":1},{"text":"இது உங்கள் இளைப்பாறுதலின் இடமல்ல,","poem":2},{"text":"ஏனெனில் இது உங்கள் பாவங்களால் கறைப்பட்டு","poem":1},{"text":"திருத்த முடியாத அளவு பாழாய்ப் போய்விட்டது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் மக்களே, பொய்யனும் வஞ்சகனுமான ஒருவன் உங்களிடம் வந்து,","poem":1},{"text":"“உங்களுக்கு அதிக திராட்சை இரசமும், மதுபானமும் கிடைக்கும்","poem":2},{"lineBreak":true},{"text":"என்று நான் தீர்க்கதரிசனம் சொல்வேன்”","poem":2},{"text":"என்பானாயின்","poem":1},{"text":"அவனே உங்களுக்கு ஒரு சரியான தீர்க்கதரிசி.","poem":2}]},{"type":"heading","content":["மீட்பிற்கான வாக்குத்தத்தம்"]},{"type":"verse","number":12,"content":[{"text":"யாக்கோபே, ஒரு நாளில் உங்கள் எல்லோரையும்","poem":1},{"text":"நிச்சயமாகவே நான் ஒன்றுசேர்ப்பேன்,","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலில் எஞ்சியோரை நிச்சயமாகவே நான் ஒன்றுகூட்டுவேன்.","poem":2},{"text":"நான் தொழுவத்தின் செம்மறியாடுகளைப் போலவும்,","poem":1},{"text":"மேய்ச்சல் நிலத்தின் மந்தைகளைப் போலவும் அவர்களை ஒன்றாய் கொண்டுவருவேன்.","poem":2},{"lineBreak":true},{"text":"அந்த இடம் மக்களால் நிறைந்திருக்கும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்களுக்கு ஒரு வழியை ஏற்படுத்துகிறவர் அவர்கள் முன்செல்வார்;","poem":1},{"text":"அவர்கள் சிறையிருப்பின் வாசலை உடைத்து வெளியேறுவார்கள்.","poem":2},{"text":"அவர்களின் அரசன் அவர்களுக்கு முன்பாகக் கடந்துபோவான்;","poem":1},{"text":"யெகோவாவே அவர்களை முன்நின்று வழிநடத்திச் செல்வார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/MIC/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/MIC/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/MIC/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}