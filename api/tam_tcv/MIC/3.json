{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"MIC","translationId":"tam_tcv","name":"மீகா","commonName":"மீகா","title":"மீகா","order":33,"numberOfChapters":7,"sha256":"12224b320e32222be511d30e3feac01f0b0c5becadfc9e135c7537bc9d4f5424","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tam_tcv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":3,"content":[{"type":"heading","content":["தலைவர்களும் தீர்க்கதரிசிகளும் கண்டிக்கப்படுதல்"]},{"type":"verse","number":1,"content":["அப்பொழுது நான் சொன்னதாவது:",{"text":"“யாக்கோபின் தலைவர்களே;","poem":1},{"text":"இஸ்ரயேல் குடும்பத்தின் ஆளுநர்களே கேளுங்கள்.","poem":2},{"text":"நீதியை நிலைநாட்டுவது உங்கள் கடமையல்லவா,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"ஆனால் நீங்களோ நன்மையை வெறுத்துத் தீமையையே நேசிக்கிறீர்கள்.","poem":2},{"text":"என் மக்களின் தோலையும்,","poem":1},{"text":"அவர்கள் எலும்புகளிலிருந்து சதையையும் கிழித்து எடுக்கிறீர்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என் மக்களின் சதையைச் சாப்பிட்டு,","poem":1},{"text":"அவர்களின் தோலையெல்லாம் உரித்து,","poem":2},{"lineBreak":true},{"text":"எலும்புகளைத் துண்டுகளாக நொறுக்குகிறீர்கள்.","poem":2},{"text":"சட்டியில் போடும் இறைச்சியைப் போலவும்,","poem":1},{"text":"பானையில் போடும் சதையைப் போலவும் அவர்களை வெட்டுகிறீர்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ஆனாலும், நாட்கள் வருகின்றன.","poem":1},{"text":"அப்பொழுது நீங்கள் யெகோவாவிடம் கூக்குரலிடுவீர்கள்.","poem":2},{"text":"ஆனால் அவர் பதிலளிக்கவே மாட்டார்.","poem":1},{"text":"அக்காலத்தில் நீங்கள் செய்த தீமைக்காக","poem":2},{"lineBreak":true},{"text":"அவர் தமது முகத்தை உங்களுக்கு மறைத்துக்கொள்வார்.","poem":2}]},{"type":"verse","number":5,"content":["யெகோவா சொல்வது இதுவே:",{"text":"எனது மக்களைத் தவறான வழியில் நடத்துகிற","poem":1},{"text":"“பொய்த் தீர்க்கதரிசிகளைக் குறித்துச் சொல்கிறதாவது,","poem":2},{"text":"ஒருவன் அவர்களுக்குச் சாப்பிடக் கொடுத்தால்,","poem":1},{"text":"‘சமாதானம்’ என்று பிரசித்தப் படுத்துகிறார்கள்.","poem":2},{"text":"அப்படிக் கொடுக்காவிட்டால்,","poem":1},{"text":"அவனுக்கு எதிராக யுத்தம் செய்ய ஆயத்தமாகிறார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஆதலால் தரிசனங்கள் அற்ற இரவும்,","poem":1},{"text":"குறிபார்க்க முடியாத இருளும் அவர்கள்மேல் வரும்.","poem":2},{"text":"பொய்த் தீர்க்கதரிசிகளுக்குச் சூரியன் மறைந்து,","poem":1},{"text":"பகலும் அவர்களுக்கு இருண்டுபோகும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"தரிசனங்கள் காண்பவர்கள் வெட்கமடைவார்கள்.","poem":1},{"text":"குறிசொல்பவர்கள் அவமானம் அடைவார்கள்.","poem":2},{"text":"இறைவனிடமிருந்து பதில் கிடைக்காதபடியால்,","poem":1},{"text":"அவர்கள் எல்லோரும் தங்கள் முகங்களை மூடிக்கொள்வார்கள்” என்று யெகோவா சொல்கிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆனால் நானோ யாக்கோபுக்கு அவன் மீறுதலையும்,","poem":1},{"text":"இஸ்ரயேலுக்கு அவன் பாவங்களையும் அறிவிக்கும்படி,","poem":2},{"lineBreak":true},{"text":"யெகோவாவின் ஆவியானவரால் வல்லமையுடன் நிரப்பப்பட்டிருக்கிறேன்.","poem":2},{"text":"அவர் என்னை நீதியினாலும்,","poem":1},{"text":"பெலத்தினாலும் நிறைத்திருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ஆகவே யாக்கோபு குடும்பத்தின் தலைவர்களே,","poem":1},{"text":"இஸ்ரயேல் குடும்பத்தின் ஆளுநர்களே,","poem":2},{"text":"நீதியை உதாசீனம்பண்ணி,","poem":1},{"text":"நியாயமானவற்றையெல்லாம் புரட்டுகிற நீங்கள் இதைக் கேளுங்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இரத்தம் சிந்துதலினால் சீயோனையும்,","poem":1},{"text":"கொடுமையினால் எருசலேமையும் கட்டுகிறவர்களே கேளுங்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உங்கள் தலைவர்கள் இலஞ்சத்திற்காக நியாயந்தீர்க்கின்றார்கள்.","poem":1},{"text":"உங்கள் ஆசாரியர்கள் கூலிக்குக் போதிக்கின்றார்கள்.","poem":2},{"lineBreak":true},{"text":"உங்கள் தீர்க்கதரிசிகள் பணத்திற்குக் குறிசொல்கிறார்கள்.","poem":2},{"text":"ஆயினும் அவர்கள் யெகோவாவிடம் சார்ந்துகொண்டு, “யெகோவா நம் மத்தியில் இல்லையோ?","poem":1},{"text":"பேராபத்து நமக்கு உண்டாகாது”","poem":2},{"lineBreak":true},{"text":"என்றும் சொல்லிக்கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆகையால் இஸ்ரயேல் ஆளுநர்களே,","poem":1},{"text":"உங்கள் செயல்களின் நிமித்தம்,","poem":2},{"text":"சீயோன் வயலைப்போல உழப்படும், எருசலேம் மண்மேடுகளாகும்,","poem":1},{"text":"ஆலயம் அமைந்துள்ள மலை, புல் அடர்ந்த காடாகும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/MIC/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/MIC/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/MIC/2.json","previousChapterAudioLinks":{},"numberOfVerses":12}