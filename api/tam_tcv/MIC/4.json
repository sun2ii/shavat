{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"MIC","translationId":"tam_tcv","name":"மீகா","commonName":"மீகா","title":"மீகா","order":33,"numberOfChapters":7,"sha256":"12224b320e32222be511d30e3feac01f0b0c5becadfc9e135c7537bc9d4f5424","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tam_tcv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":4,"content":[{"type":"heading","content":["யெகோவாவின் மலை புதுப்பிக்கப்படுதல்"]},{"type":"verse","number":1,"content":["கடைசி நாட்களிலே,",{"text":"யெகோவாவினுடைய ஆலயத்தின் மலை,","poem":1},{"text":"எல்லா மலைகளுக்குள்ளும் உயர்ந்ததாக நிலைநிறுத்தப்படும்;","poem":2},{"text":"எல்லா குன்றுகளுக்கு மேலாக உயர்த்தப்படும்,","poem":1},{"text":"எல்லா மக்கள் கூட்டமும் அதை நாடி ஓடி வருவார்கள்.","poem":2}]},{"type":"verse","number":2,"content":["அநேக நாடுகள் வந்து,",{"text":"“வாருங்கள், நாம் யெகோவாவின் மலைக்கு ஏறிப்போவோம்,","poem":1},{"text":"யாக்கோபின் இறைவனுடைய ஆலயத்திற்குப் போவோம்.","poem":2},{"text":"நாம் அவர் பாதைகளில் நடப்பதற்கு","poem":1},{"text":"அவர் தம் வழிகளை நமக்கு போதிப்பார்” என்பார்கள்.","poem":2},{"text":"சீயோனிலிருந்து அவரது சட்டமும்,","poem":1},{"text":"எருசலேமிலிருந்து யெகோவாவின் வார்த்தையும் வெளிவரும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அநேக மக்கள் கூட்டங்களிடையே அவர் நியாயம் விசாரித்து,","poem":1},{"text":"எங்கும் பரந்து தூரமாயுள்ள வலிமைமிக்க","poem":2},{"lineBreak":true},{"text":"நாடுகளின் வழக்குகளை அவர் தீர்த்துவைப்பார்.","poem":2},{"text":"அப்பொழுது அவர்கள் தங்கள் பட்டயங்களை மண்வெட்டிகளாகவும்,","poem":1},{"text":"தங்கள் ஈட்டிகளை அரிவாள்களாகவும் அடித்துச் செய்துகொள்வார்கள்.","poem":2},{"text":"அதன்பின் ஒரு நாடு வேறு நாட்டை எதிர்த்து பட்டயத்தை எடுப்பதுமில்லை,","poem":1},{"text":"போருக்கான பயிற்சியையும் அவர்கள் கற்பதுமில்லை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஒவ்வொருவனும் தன் சொந்த திராட்சைக்கொடியின் கீழேயும்,","poem":1},{"text":"தன் சொந்த அத்திமரத்தின் கீழேயும் சுகமாய் இருப்பான்.","poem":2},{"text":"ஒருவரும் அவர்களைப் பயமுறுத்தமாட்டார்கள்.","poem":1},{"text":"ஏனெனில் சேனைகளின் யெகோவாவே இதைச் சொல்லியிருக்கிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"எல்லா மக்கள் கூட்டங்களும்","poem":1},{"text":"தங்கள் தெய்வங்களின் பெயரில் நடந்தாலும்,","poem":2},{"text":"நாங்களோ எங்கள் இறைவனாகிய யெகோவாவின் பெயரிலேயே","poem":1},{"text":"என்றென்றும் நடப்போம் என்று சொல்வார்கள்.","poem":2}]},{"type":"heading","content":["யெகோவாவின் திட்டம்"]},{"type":"verse","number":6,"content":[{"text":"யெகோவா அறிவிக்கிறதாவது:","poem":1},{"text":"“அந்த நாளில் நான் முடவர்களை ஒன்றுசேர்ப்பேன்,","poem":2},{"text":"நாடுகடத்தப்பட்டோரையும்,","poem":1},{"text":"என்னால் துன்பத்திற்கு உட்பட்டோரையும் கூட்டிச்சேர்ப்பேன்.”","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் எஞ்சியிருக்கும் முடவர்களையும்,","poem":1},{"text":"துரத்தப்பட்டவர்களையும் ஒரு வலிமைமிக்க நாடாக்குவேன்.","poem":2},{"text":"அந்த நாளிலிருந்து என்றென்றைக்குமாக,","poem":1},{"text":"யெகோவாவாகிய நானே சீயோன் மலையிலிருந்து அவர்களை அரசாளுவேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எருசலேமே, மந்தையின் காவற்கோபுரமே,","poem":1},{"text":"சீயோன் மகளின் கோட்டையே, உனக்கோவென்றால்:","poem":2},{"text":"முந்தைய ஆட்சியுரிமை உனக்கே திரும்பக் கொடுக்கப்படும்;","poem":1},{"text":"அரசுரிமை உன் மகளுக்கே வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"இப்பொழுது நீ ஏன் சத்தமிட்டு அழுகிறாய்?","poem":1},{"text":"பிரசவிக்கும் பெண்ணைப்போல் ஏன் வேதனைப்படுகிறாய்?","poem":2},{"text":"உனக்கு அரசன் இல்லையோ?","poem":1},{"text":"உன் ஆலோசகனும் அழிந்து போனானோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"சீயோன் மகளே,","poem":1},{"text":"பிரசவிக்கும் பெண்ணைப்போல் துடித்து வேதனைப்படு.","poem":2},{"text":"ஏனெனில் நீ நகரத்தைவிட்டு","poem":1},{"text":"விரைவில் வெளியே போகவேண்டும்.","poem":2},{"text":"திறந்தவெளியில் முகாமிடவேண்டும்.","poem":1},{"text":"நீ பாபிலோனுக்குப் போவாய்.","poem":2},{"text":"ஆனால் அங்கிருந்து நீ தப்புவிக்கப்படுவாய்.","poem":1},{"text":"உன் பகைவர்களின் கைகளினின்றும் யெகோவாவாகிய நானே உன்னை மீட்டுக்கொள்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ஆனால், இப்பொழுது அநேக நாடுகள்","poem":1},{"text":"உனக்கெதிராய் கூடியிருக்கிறார்கள்.","poem":2},{"text":"அவர்கள், “சீயோன் மாசுபடட்டும்,","poem":1},{"text":"நம் கண்கள் அதைக்கண்டு கேலிசெய்து மகிழட்டும்” என்று சொல்கிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆனால் அவர்களோ, யெகோவாவின் சிந்தனைகளை அறியாதிருக்கிறார்கள்.","poem":1},{"text":"அவரது திட்டத்தையும் அவர்கள் விளங்கிக்கொள்ளவில்லை.","poem":2},{"text":"அவர் அவர்களைக் கதிர்க்கட்டுகளைப்போல் ஒன்றுசேர்த்து","poem":1},{"text":"சூடடிக்கும் களத்திற்கு அடிக்கக்கொண்டு வருவார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவா சொல்கிறதாவது: “சீயோன் மகளே, எழுந்து போரடி.","poem":1},{"text":"நான் உனக்கு இரும்பு கொம்புகளைக் கொடுப்பேன்.","poem":2},{"text":"நான் உனக்கு வெண்கல குளம்புகளைக் கொடுப்பேன்.","poem":1},{"text":"அவற்றால் நீ அநேக மக்கள் நாடுகளை மிதித்துத் துண்டுகளாக நொறுக்குவாய்.","poem":2},{"text":"அவர்கள் நல்லதல்லாத வழியில் சம்பாதித்த ஆதாயத்தையும்,","poem":1},{"text":"அவர்களின் செல்வத்தையும் பூமி முழுவதற்கும் யெகோவாவாகிய எனக்கே ஒப்படைப்பாய்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/MIC/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/MIC/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/MIC/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}