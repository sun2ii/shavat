{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"MIC","translationId":"tam_tcv","name":"மீகா","commonName":"மீகா","title":"மீகா","order":33,"numberOfChapters":7,"sha256":"12224b320e32222be511d30e3feac01f0b0c5becadfc9e135c7537bc9d4f5424","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tam_tcv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":5,"content":[{"type":"heading","content":["வாக்களிக்கப்பட்ட ஆளுநர்"]},{"type":"verse","number":1,"content":[{"text":"இராணுவவீரர்களின் நகரமே, உன் இராணுவவீரர்களைக் கூட்டிச்சேர்;","poem":1},{"text":"ஏனெனில் நமக்கு எதிராக முற்றுகையிடப் பட்டிருக்கிறது.","poem":2},{"text":"அவர்கள் இஸ்ரயேலின் ஆளுநரை,","poem":1},{"text":"கோலினால் கன்னத்தில் அடிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“ஆனால் எப்பிராத்தா எனப்பட்ட பெத்லகேமே,","poem":1},{"text":"நீ யூதாவின் வம்சங்களில் சிறிதாயிருப்பினும்","poem":2},{"text":"இஸ்ரயேலின்மேல் என் சார்பாக ஆளுநராக வரப்போகிறவர்,","poem":1},{"text":"உன்னிலிருந்து தோன்றுவார்.","poem":2},{"text":"அவரது புறப்படுதல் பூர்வீக காலங்களான","poem":1},{"text":"முந்திய காலத்தினுடையது.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"பிரசவ வேதனைப்படுபவள் பிள்ளை பெற்றெடுக்கும் வரைக்கும்","poem":1},{"text":"யெகோவா தம் மக்களை கைவிடுவார்.","poem":2},{"text":"அதன்பின் அவருடைய சகோதரரில் மீதியாயிருப்பவர்கள்","poem":1},{"text":"இஸ்ரயேலருடன் சேரும்படி திரும்பி வருவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அந்த ஆளுநர் வரும்போது,","poem":1},{"text":"அவர் யெகோவாவின் வல்லமையுடனும்,","poem":2},{"lineBreak":true},{"text":"தமது இறைவனாகிய யெகோவாவின் பெயரின் மகிமையுடனும் நின்று தமது மந்தையை மேய்ப்பார்.","poem":2},{"text":"அப்பொழுது அவருடைய மக்கள் பாதுகாப்பாய் வாழ்வார்கள்.","poem":1},{"text":"அவருடைய மேன்மை பூமியின் கடைசிவரை எட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவரே அவர்களுடைய சமாதானமாயிருப்பார்.","poem":1},{"text":"நமது நாட்டின்மேல் அசீரியன் படையெடுத்து,","poem":2},{"lineBreak":true},{"text":"நமது அரண்மனைகளை மிதிக்கும்போது,","poem":2},{"text":"நாங்கள் அவனுக்கு எதிராக ஏழு மேய்ப்பர்களையும்,","poem":1},{"text":"எட்டு தலைவர்களையும் எழுப்புவோம்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் அசீரிய நாட்டை வாளினால் ஆளுகை செய்வார்கள்.","poem":1},{"text":"நிம்ரோத் நாட்டை, உருவிய வாளினால் ஆளுகை செய்வார்கள்.","poem":2},{"text":"அசீரியன் எங்கள் நாட்டின்மேல் படையெடுத்து,","poem":1},{"text":"எங்கள் எல்லைகளில் அணிவகுத்து வரும்போது,","poem":2},{"lineBreak":true},{"text":"அவர் எங்களை விடுவிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"அப்போது யாக்கோபில் எஞ்சியிருப்போர்,","poem":1},{"text":"மக்கள் கூட்டங்களிடையே யெகோவாவிடமிருந்து வரும் பனியைப்போல் இருப்பார்கள்,","poem":2},{"text":"அவர்கள் மனிதனுக்காகக் காத்திராமலும்,","poem":1},{"text":"மனுக்குலத்துக்காகத் தாமதியாமலும்","poem":2},{"text":"புல்லின்மேல் பெய்யும்","poem":1},{"text":"மழையைப்போல் இருப்பார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எனவே, யாக்கோபில் மீதியானோர்,","poem":1},{"text":"நாடுகளின் மத்தியில் திரளான மக்களின் நடுவிலே இருப்பார்கள்.","poem":2},{"text":"அவர்கள் காட்டு மிருகங்களின் நடுவில் இருக்கும் சிங்கம் போலவும்,","poem":1},{"text":"செம்மறியாட்டு மந்தைகளுக்கிடையில் புகுந்து கிழித்துச் சிதைக்கிற,","poem":2},{"text":"சிங்கக் குட்டியைப்போலவும் இருப்பார்கள்.","poem":1},{"text":"ஒருவனாலும் அந்நாடுகளைக் காப்பாற்ற முடியாதிருக்கும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களுடைய கை அவர்கள் பகைவர்களுக்கு மேலாக வெற்றியுடன் உயர்த்தப்படும்.","poem":1},{"text":"அவர்களுடைய எதிரிகள் எல்லோருமே அழிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":["யெகோவா இஸ்ரயேலுக்கு அறிவிக்கிறதாவது:",{"text":"“அந்த நாளில் உன் மத்தியிலிருந்து போர்க் குதிரைகளை அழிப்பேன்.","poem":1},{"text":"உன் தேர்ப் படைகளை அழித்தொழிப்பேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உன் நாட்டிலுள்ள நகரங்களின் அரண்களையும்,","poem":1},{"text":"உன் கோட்டைகளையும் எடுத்துப்போடுவேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உன் மாயவித்தையை அழிப்பேன்.","poem":1},{"text":"மந்திரம் செய்யும் ஆற்றல் இனி உன் மத்தியில் காணப்படமாட்டாது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் உனது செதுக்கப்பட்ட உருவச்சிலைகளையும்,","poem":1},{"text":"புனித கற்களையும் உன் மத்தியிலிருந்து அழிப்பேன்.","poem":2},{"text":"நீ இனிமேலும் உன் கைகளின் வேலையான விக்கிரகங்களை","poem":1},{"text":"விழுந்து வணங்கமாட்டாய்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"உன் மத்தியிலுள்ள வழிபாட்டு அசேரா தேவதைத் தூண்களைப் பிடுங்கி,","poem":1},{"text":"உன் பட்டணங்களை அழித்தொழிப்பேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அத்துடன் எனக்குக் கீழ்ப்படியாத எல்லா மக்களையும் கோபத்தோடும்,","poem":1},{"text":"கடுஞ்சினத்தோடும் பழிவாங்குவேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/MIC/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/MIC/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/MIC/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}