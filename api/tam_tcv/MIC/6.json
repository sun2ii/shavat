{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"MIC","translationId":"tam_tcv","name":"மீகா","commonName":"மீகா","title":"மீகா","order":33,"numberOfChapters":7,"sha256":"12224b320e32222be511d30e3feac01f0b0c5becadfc9e135c7537bc9d4f5424","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tam_tcv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":6,"content":[{"type":"heading","content":["இஸ்ரயேலின்மீது யெகோவாவின் குற்றச்சாட்டு"]},{"type":"verse","number":1,"content":["யெகோவா சொல்கிறதைக் கேளுங்கள்:",{"text":"“எழுந்து, மலைகள் முன் உங்கள் வழக்கை வாதாடுங்கள்;","poem":1},{"text":"குன்றுகள் எல்லாம் நீங்கள் சொல்லப்போவதைக் கேட்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“மலைகளே, யெகோவாவின் குற்றச்சாட்டைக் கேளுங்கள்;","poem":1},{"text":"பூமியின் நிலையான அஸ்திபாரங்களே, செவிகொடுங்கள்.","poem":2},{"text":"தம் மக்களுக்கெதிரான வழக்கொன்று யெகோவாவுக்கு உண்டு.","poem":1},{"text":"இஸ்ரயேலுக்கு எதிராக அவர் ஒரு குற்றச்சாட்டைக் கொண்டுவருகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“யெகோவா சொல்கிறதாவது: என் மக்களே, நான் உங்களுக்கு என்ன செய்தேன்?","poem":1},{"text":"நான் எவ்விதம் உங்கள்மேல் பாரத்தைச் சுமத்தினேன்? எனக்குப் பதில் சொல்லுங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"எகிப்திலிருந்து நான் உங்களை வெளியே கொண்டுவந்தேன்.","poem":1},{"text":"அடிமைத்தன நாட்டிலிருந்து மீட்டு வந்தேன்.","poem":2},{"text":"உங்களை வழிநடத்த மோசேயுடன்,","poem":1},{"text":"ஆரோனையும் மிரியாமையும் அனுப்பினேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என் மக்களே,","poem":1},{"text":"மோவாபிய அரசன் பாலாக் என்ன ஆலோசனை செய்தான் என்பதையும்,","poem":2},{"text":"பேயோரின் மகன் பிலேயாம் என்ன பதிலைக் கொடுத்தான்","poem":1},{"text":"என்பதையும் நினைத்துப் பாருங்கள்.","poem":2},{"text":"யெகோவா உங்களுக்குச் செய்த நீதியான செயல்களை நீங்கள் அறிந்துகொள்ளும்படி,","poem":1},{"text":"சித்தீமிலிருந்து கில்காலுக்குப் போன உங்கள் பயணத்தை நினைத்துப் பாருங்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"இஸ்ரயேல் மக்கள் சொல்கிறதாவது:","poem":1},{"text":"“யெகோவாவிடம் நாங்கள் எதைக் கொண்டுவருவோம்.","poem":2},{"text":"மேன்மையான இறைவனுக்கு முன்பாக எதனுடன் தலைகுனிந்து வழிபடுவோம்?","poem":1},{"text":"அவர் முன்பாக ஒரு வயதுக் கன்றுக்குட்டிகளைத் தகன காணிக்கையாகக் கொண்டுவருவோமா?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆயிரக்கணக்கான செம்மறியாட்டுக் கடாக்களிலும்,","poem":1},{"text":"பதினாயிரக் கணக்கான எண்ணெய் ஆறுகளிலும் யெகோவா விருப்பமாயிருப்பாரோ?","poem":2},{"text":"என் மீறுதலுக்காக என் முதற்பேறான பிள்ளையைக் காணிக்கையாகச் செலுத்தட்டுமா?","poem":1},{"text":"என் ஆத்துமாவின் பாவங்களுக்காக என் கர்ப்பக்கனியை நான் கொடுக்கட்டுமா?”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மனிதனே, நல்லது என்ன என்பதை அவர் உனக்குக் காட்டியிருக்கிறாரே;","poem":1},{"text":"யெகோவா உன்னிடம் எதைக் கேட்கிறார்?","poem":2},{"text":"நீதியாய் நடந்து, இரக்கத்தை நேசித்து,","poem":1},{"text":"உன் இறைவனுடன் தாழ்மையாய் நடக்கும்படி தானே கேட்கிறார்.","poem":2}]},{"type":"heading","content":["இஸ்ரயேலின் குற்றமும் நியாயத்தீர்ப்பும்"]},{"type":"verse","number":9,"content":[{"text":"கேளுங்கள், யெகோவா எருசலேம் நகரத்தை நோக்கிக் கூப்பிடுகிறார்.","poem":1},{"text":"அவருடைய பெயருக்குப் பயந்து நடப்பதே ஞானம்.","poem":2},{"lineBreak":true},{"text":"“வரப்போகும் தண்டனையின் கோலையும், அதை நியமித்தவரையும் கவனத்திற்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"கொடுமையானவர்களின் வீடே,","poem":1},{"text":"நீங்கள் நல்லதல்லாத வழியில் சம்பாதித்த சொத்துக்களையும்,","poem":2},{"text":"நீங்கள் பயன்படுத்துகிறதான மற்றவர்களை ஏமாற்றும் அளவையையும்","poem":1},{"text":"நான் இன்னும் மறக்கவேண்டுமோ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"போலித் தராசையும், போலிப் படிக்கற்கள் இருக்கும்","poem":1},{"text":"பையையும் வைத்திருக்கிறவனையும்","poem":2},{"lineBreak":true},{"text":"நான் குற்றமற்றவனெனத் தீர்க்கவேண்டுமோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உன் செல்வந்தர்கள் வன்முறையாளர்கள்.","poem":1},{"text":"உன் மக்கள் பொய்யர்கள்.","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய நாவுகள் வஞ்சகத்தையே பேசுகின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அதனாலேதான் நான் உன்னை அழிக்கத் தொடங்கிவிட்டேன்.","poem":1},{"text":"உன் பாவங்களுக்காக உன்னைப் பாழாக்கத் தொடங்கிவிட்டேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நீ சாப்பிடுவாய்; ஆனால் திருப்தியடையமாட்டாய்.","poem":1},{"text":"உன் வயிறோ இன்னும் வெறுமையாகவே இருக்கும்.","poem":2},{"text":"நீ சேர்த்து வைப்பாய்; ஆனால் சேமிக்கமாட்டாய்.","poem":1},{"text":"ஏனெனில் உன் சேமிப்புகளை எல்லாம் நான் வாளுக்கு ஒப்புக்கொடுப்பேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீ விதைப்பாய்; ஆனால் அறுவடை செய்யமாட்டாய்.","poem":1},{"text":"நீ ஒலிவ விதைகளைப் பிழிந்தெடுப்பாய்; ஆனால் எண்ணெயையோ பூசிக்கொள்ளமாட்டாய்.","poem":2},{"lineBreak":true},{"text":"திராட்சைப் பழங்களையும் நீ பிழிவாய்; ஆனால் இரசத்தையோ நீ குடிக்கமாட்டாய்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"உம்ரி அரசனின் நியமங்களையும்","poem":1},{"text":"ஆகாப் வீட்டாரின் கேடான நடைமுறைகளையும் கைக்கொண்டு,","poem":2},{"lineBreak":true},{"text":"அவர்களின் தீமையான சம்பிரதாய முறைகளையே நீ பின்பற்றினாய்.","poem":2},{"text":"ஆதலால் நான் உன்னை அழிவுக்கும்,","poem":1},{"text":"உன் மக்களை ஏளனத்துக்கும் ஒப்புக்கொடுப்பேன்.","poem":2},{"lineBreak":true},{"text":"பிறநாடுகளின் ஏளனத்தை நீ சுமப்பாய்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/MIC/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/MIC/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/MIC/5.json","previousChapterAudioLinks":{},"numberOfVerses":16}