{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"MIC","translationId":"tam_tcv","name":"மீகா","commonName":"மீகா","title":"மீகா","order":33,"numberOfChapters":7,"sha256":"12224b320e32222be511d30e3feac01f0b0c5becadfc9e135c7537bc9d4f5424","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/MIC/1.json","lastChapterNumber":7,"lastChapterApiLink":"/api/tam_tcv/MIC/7.json","totalNumberOfVerses":105},"chapter":{"number":7,"content":[{"type":"heading","content":["இஸ்ரயேலின் அவலநிலை குறித்து மீகாவின் கவலை"]},{"type":"verse","number":1,"content":[{"text":"என் அவலநிலைதான் என்ன?","poem":1},{"lineBreak":true},{"text":"கோடைகால அறுப்புக்குப்பின் திராட்சைத் தோட்டத்தில்","poem":1},{"text":"விடப்பட்ட பழங்களைச் சேகரிப்பவன் போலானேன்;","poem":2},{"lineBreak":true},{"text":"சாப்பிடுவதற்கான ஒரு திராட்சைக் குலையும் இல்லை.","poem":2},{"text":"நான் சாப்பிட ஆசைப்படும்,","poem":1},{"text":"முதலில் பழுத்த அத்திப்பழமும் இல்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நாட்டிலிருந்த இறை பக்தியுள்ளோர் அனைவரும் அற்றுப்போனார்கள்.","poem":1},{"text":"நீதிமான் ஒருவனும் இல்லை.","poem":2},{"text":"எல்லா மனிதருமே இரத்தம் சிந்தப் பதுங்கிக் காத்திருக்கின்றார்கள்.","poem":1},{"text":"ஒவ்வொருவனும் தன் சகோதரனை வலையினால் பிடிக்க முயற்சிக்கிறான்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்களின் இரு கைகளுமே தீமை செய்வதில் தேர்ச்சி பெற்றவை.","poem":1},{"text":"ஆளுநர் அன்பளிப்புகளை வற்புறுத்திக் கேட்கிறான்.","poem":2},{"text":"நீதிபதிகள் இலஞ்சத்தை ஏற்றுக்கொள்கிறார்கள்.","poem":1},{"text":"அதிகாரத்தில் உள்ளவர்கள் தாம் விரும்புவதையே கட்டளையிடுகிறார்கள்.","poem":2},{"lineBreak":true},{"text":"இவ்வாறு அவர்கள் ஒன்றிணைந்து சதி செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்களில் சிறந்தவன் எனப்படுபவன் முட்செடி போன்றவன்.","poem":1},{"text":"நீதிமான் முள்வேலியைவிட மிகவும் கூர்மையானவன்.","poem":2},{"text":"இறைவன் உங்களைச் சந்திக்கும் நாள்,","poem":1},{"text":"உங்கள் இறைவாக்கினர் எச்சரித்த அந்த நாள் வந்துவிட்டது.","poem":2},{"lineBreak":true},{"text":"இதுவே அவர்களின் குழப்பத்தின் காலம்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அயலவனை நம்பாதே;","poem":1},{"text":"சிநேகிதனையும் நம்பவேண்டாம்.","poem":2},{"text":"உன் மடியிலே படுத்துக்கொள்ளுகிற மனைவியோடும்","poem":1},{"text":"உன் வார்த்தைகளைக்குறித்து கவனமாயிரு.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஏனெனில், மகன் தகப்பனை அவமதிக்கிறான்;","poem":1},{"text":"மகள் தன் தாய்க்கு எதிராக எழும்புகிறாள்;","poem":2},{"text":"மருமகள் தன் மாமியாரை எதிர்க்கிறாள்;","poem":1},{"text":"மனிதனுடைய பகைவர்கள் அவன் வீட்டார்தானே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நானோ, எதிர்பார்ப்புடன் யெகோவாவுக்காகக் காத்திருக்கிறேன்.","poem":1},{"text":"என் இரட்சகராகிய இறைவனுக்காக காத்திருக்கிறேன்.","poem":2},{"lineBreak":true},{"text":"என் இறைவன் எனக்குச் செவிகொடுப்பார்.","poem":2}]},{"type":"heading","content":["இஸ்ரயேல் உயரும்"]},{"type":"verse","number":8,"content":[{"text":"எருசலேம் மக்கள் சொல்கிறதாவது:","poem":1},{"text":"எங்கள் பகைவனே, எங்களை கேலிசெய்து மகிழாதே;","poem":2},{"text":"நாங்கள் விழுந்தாலும் எழுந்திருப்போம்.","poem":1},{"text":"நாங்கள் இருளில் உட்கார்ந்தாலும் யெகோவா எங்களுக்கு ஒளியாயிருப்பார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நாங்கள் யெகோவாவுக்கு எதிராகப் பாவம் செய்தபடியால்,","poem":1},{"text":"அவரின் கோபத்தைச் சுமப்போம்.","poem":2},{"text":"அவர் எங்களுக்காக வாதாடி,","poem":1},{"text":"எங்கள் நியாயத்தை நிலைநிறுத்துவார்.","poem":2},{"text":"அவர் எங்களை வெளியே வெளிச்சத்தின் முன் கொண்டுவருவார்.","poem":1},{"text":"நாங்கள் அவரது நீதியைக் காண்போம்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அப்பொழுது எங்கள் பகைவன் இதைக்கண்டு","poem":1},{"text":"வெட்கத்திற்குள்ளாவான்.","poem":2},{"text":"“உங்கள் யெகோவாவாகிய இறைவன் எங்கே?”","poem":1},{"text":"என்று எங்களிடம் கேட்டவளின்","poem":2},{"text":"வீழ்ச்சியை எங்கள் கண்கள் காணும்.","poem":1},{"text":"அப்பொழுது அவள் வீதிகளிலுள்ள","poem":2},{"lineBreak":true},{"text":"சேற்றைப்போல் காலின்கீழ் மிதிக்கப்படுவாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"எருசலேம் மக்களே! உங்கள் மதில்களைக் கட்டியெழுப்பும் நாள் வருகிறது,","poem":1},{"text":"உங்கள் எல்லையை விரிவுபடுத்தும் நாளும் வருகிறது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அந்நாளில் அசீரியாவிலிருந்தும், எகிப்தின் பட்டணங்களிலிருந்தும்","poem":1},{"text":"உங்கள் மக்கள் உங்களிடம் வருவார்கள்.","poem":2},{"lineBreak":true},{"text":"எகிப்து முதல், ஐபிராத்து நதிவரையுள்ள தேசங்களிலிருந்தும்,","poem":2},{"text":"ஒரு கடல் முதல் மறுகடல் வரையுள்ள நாடுகளிலிருந்தும்,","poem":1},{"text":"ஒரு மலை முதல், மறு மலைவரையுள்ள இடங்களிலிருந்தும்","poem":2},{"lineBreak":true},{"text":"உங்கள் மக்கள் அனைவரும் உங்களிடம் கூடிவருவார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆயினும் பூமியின் மற்ற பிரதேசங்கள் அங்கு வாழும் மக்களின்","poem":1},{"text":"தீய செயல்களின் நிமித்தம் பாழாய்ப்போம்.","poem":2}]},{"type":"heading","content":["மன்றாட்டும் துதியும்"]},{"type":"verse","number":14,"content":[{"text":"யெகோவாவே, ஒரு செழிப்பான மேய்ச்சல் நிலத்திலே","poem":1},{"text":"வாழ்கிறவர்களான உமது மக்களை,","poem":2},{"text":"உமது உரிமைச்சொத்தான மந்தையை,","poem":1},{"text":"உமது கோலினால் மேய்த்துக்கொள்ளும்.","poem":2},{"text":"இவர்கள் முந்தைய நாட்களைப்போல் பாசானிலும்,","poem":1},{"text":"கீலேயாத்திலும் மேயட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“நீங்கள் எகிப்திலிருந்து வெளியேறிய, அந்நாட்களில் இருந்ததைப்போல,","poem":1},{"text":"நான் உங்களுக்கு என் அதிசயங்களைக் காண்பிப்பேன்” என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"பிறநாடுகள் யாவும் அதைக்கண்டு வெட்கமடைவார்கள்.","poem":1},{"text":"அவர்கள் தங்கள் ஆற்றல்களை","poem":2},{"text":"இழந்து தங்கள் வாயைக் கைகளால் பொத்திக்கொள்வார்கள்.","poem":1},{"text":"அவர்களுடைய காதுகள் செவிடாய்ப்போகும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர்கள் பாம்மைப்போலவும்,","poem":1},{"text":"நிலத்தின் ஊரும் உயிரினங்களைப்போலவும் புழுதியை நக்குவார்கள்.","poem":2},{"text":"அவர்கள் தங்கள் குகைகளை விட்டு நடுக்கத்துடன் வெளியேறுவார்கள்.","poem":1},{"text":"எங்கள் இறைவனாகிய யெகோவாவிடத்தில் அவர்கள் பயத்துடன் திரும்பி வருவார்கள்.","poem":2},{"lineBreak":true},{"text":"அப்போது அவர்கள் உமக்குப் பயந்திருப்பார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உமக்கு நிகரான இறைவன் யார்?","poem":1},{"text":"உமது சொத்தில் எஞ்சியிருப்போரின் பாவங்களைப் பொறுத்துக்கொண்டு,","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய மீறுதல்களையும் மன்னிக்கிற உமக்கு நிகரானவர் யார்?","poem":2},{"text":"நீர் என்றென்றைக்கும் கோபமாயிருப்பவரல்ல.","poem":1},{"text":"ஆனால் இரக்கம் காட்டுவதில் மகிழ்ச்சியாயிருக்கிறீர்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"நீர் மறுபடியும் எங்கள்மேல் கருணை காட்டுவீர்.","poem":1},{"text":"நீர் எங்கள் பாவங்களை காலின்கீழ் மிதித்து,","poem":2},{"lineBreak":true},{"text":"எங்கள் எல்லா அக்கிரமங்களையும் கடலின் ஆழங்களிலே எறிந்து விடுவீர்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"முன்னொரு காலத்தில் எங்கள் முன்னோர்களுக்கு","poem":1},{"text":"ஆணையிட்டு வாக்குக்கொடுத்தபடியே,","poem":2},{"text":"நீர் யாக்கோபுக்கும் உண்மையுள்ளவராயிருப்பீர்,","poem":1},{"text":"ஆபிரகாமுக்கு அன்பைக் காட்டுவீர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/MIC/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/NAM/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/MIC/6.json","previousChapterAudioLinks":{},"numberOfVerses":20}