{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"NAM","translationId":"tam_tcv","name":"நாகூம்","commonName":"நாகூம்","title":"நாகூம்","order":34,"numberOfChapters":3,"sha256":"81796e448f5396217b8c442eac2ff4b4db431e41c70ec30fc9f5265ce4d3321f","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["நினிவே பட்டணத்தைக் குறித்த இறைவாக்கு. எல்கோஷ் ஊரைச்சேர்ந்த நாகூமின் தரிசனப் புத்தகம்."]},{"type":"line_break"},{"type":"heading","content":["நினிவேக்கு எதிரான யெகோவாவின் கோபம்"]},{"type":"verse","number":2,"content":[{"text":"யெகோவா தம் மக்கள் தம்மை மட்டுமே வழிபடவேண்டும் என்ற வைராக்கியமுள்ள இறைவன்;","poem":1},{"text":"யெகோவா தம்மை எதிர்க்கிறவர்களை எதிர்க்கிறவரும்,","poem":2},{"text":"கடுங்கோபத்தில் பதில் செய்கிறவருமாய் இருக்கிறார்.","poem":1},{"text":"யெகோவா தம் எதிரிகளைத் தண்டித்து,","poem":2},{"lineBreak":true},{"text":"தம் பகைவர்களுக்கு தமது கோபத்தை வெளிப்படுத்துகிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யெகோவா கோபங்கொள்வதில் தாமதிக்கிறவர், அவர் மிகுந்த வல்லமையுமுள்ளவர்;","poem":1},{"text":"யெகோவா குற்றவாளிகளை தண்டியாமல் விடமாட்டார்;","poem":2},{"text":"அவருடைய வழி சுழல்காற்றிலும், புயல்காற்றிலும் உள்ளது.","poem":1},{"text":"மேகங்கள் அவருடைய பாதங்களின் கீழிருக்கும் தூசியாயிருக்கின்றன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் கடலை அதட்டி வற்றப்பண்ணுகிறார்;","poem":1},{"text":"ஆறுகள் அனைத்தையும் வற்றிப்போகச்செய்கிறார்.","poem":2},{"text":"பாசானும், கர்மேலும் வறண்டுபோகின்றன.","poem":1},{"text":"லெபனோனின் பூக்கள் வாடுகின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவருக்கு முன்பாக மலைகள் அதிரும்;","poem":1},{"text":"குன்றுகள் உருகிப்போகும்.","poem":2},{"text":"அவருடைய சமுகத்தில் பூமியும் அதிரும்.","poem":1},{"text":"உலகமும், அதன் குடிமக்களும் நடுங்குவார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவருடைய கோபத்தைத் தாங்கி நிற்கக் கூடியவன் யார்?","poem":1},{"text":"அவருடைய கடுங்கோபத்தைச் சகிக்கக் கூடியவன் யார்?","poem":2},{"text":"அவருடைய கோபம் நெருப்பைப்போல் கொட்டப்படுகிறது;","poem":1},{"text":"அவருக்கு முன்பாக கற்பாறைகள் நொறுக்கப்படுகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவா நல்லவர்,","poem":1},{"text":"அவர் ஆபத்து வேளைகளில் புகலிடமானவர்.","poem":2},{"text":"அவரில் நம்பிக்கையுள்ளவர்களில் அவர் கரிசனையாயிருக்கிறார்.","poem":1}]},{"type":"verse","number":8,"content":[{"text":"ஆனாலும் பெருகிவரும் வெள்ளத்தினால்","poem":2},{"text":"நினிவேக்கு ஒரு முடிவைக் கொண்டுவருவார்;","poem":1},{"text":"அவர் தமது எதிரியை இருளுக்குள் துரத்திச் செல்வார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"அவர்கள் யெகோவாவுக்கு விரோதமாக எவ்வித சூழ்ச்சியைச் செய்தாலும்","poem":1},{"text":"அவர் அதற்கு ஒரு முடிவைக் கொண்டுவருவார்;","poem":2},{"lineBreak":true},{"text":"துன்பம் இரண்டாம் முறையும் வராது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் முட்களின் நடுவில் சிக்குண்டு,","poem":1},{"text":"தங்கள் திராட்சை இரசத்தினால் வெறிகொண்டிருப்பார்கள்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் உலர்ந்துபோன பயிரின் அடித்தாள்கள் போல் சுட்டெரிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நினிவே பட்டணமே, யெகோவாவுக்கு எதிராக தீமையான சூழ்ச்சிசெய்து,","poem":1},{"text":"கொடுமையானவற்றிற்கு ஆலோசனை கொடுக்கும் ஒருவன்,","poem":2},{"lineBreak":true},{"text":"உன்னிடமிருந்து புறப்பட்டுள்ளான்.","poem":2}]},{"type":"verse","number":12,"content":["யெகோவா சொல்வது இதுவே:",{"text":"அசீரியருக்கு அநேக நட்புறவுள்ள நாடுகள் இருந்தன.","poem":1},{"text":"“அவர்கள் எண்ணற்றவர்களாக இருந்தாலும் வெட்டப்பட்டு அழிந்துபோவார்கள்.","poem":2},{"text":"யூதாவே! நான் உன்னைத் துன்பத்தில் ஒடுக்கியிருந்தாலும்,","poem":1},{"text":"இனிமேலும் உன்னை நான் துன்புறுத்ததாதிருப்பேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் உன் கழுத்திலிருக்கும், அசீரியர்களுடைய நுகத்தை உடைத்துப்போடுவேன்.","poem":1},{"text":"உன் விலங்குகளையும் உடைப்பேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"நினிவேயே! யெகோவா உன்னைக்குறித்து ஒரு கட்டளை கொடுத்திருக்கிறார்.","poem":1},{"text":"“உன்னுடைய பெயரைத் தாங்கும் வழித்தோன்றல்கள் உனக்கிருக்க மாட்டார்கள்.","poem":2},{"text":"உன் தெய்வங்களின் கோவில்களில் இருக்கிற செதுக்கப்பட்ட உருவச்சிலைகளையும்,","poem":1},{"text":"வார்ப்பிக்கப்பட்ட விக்கிரகங்களையும் அழிப்பேன்.","poem":2},{"text":"நீ வெறுப்புக்குரியவனானபடியால்,","poem":1},{"text":"நானே உனக்குப் பிரேதக்குழியை ஆயத்தப்படுத்துவேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"யூதாவே, இதோ சமாதானத்தை அறிவித்து,","poem":1},{"text":"நற்செய்தி கொண்டு வருகிறவனுடைய கால்கள்,","poem":2},{"lineBreak":true},{"text":"உன் மலைகள்மேல் வருகின்றன.","poem":2},{"text":"உன் பண்டிகைகளைக் கொண்டாடு.","poem":1},{"text":"உன் நேர்த்திக் கடன்களை நிறைவேற்று.","poem":2},{"text":"கொடுமையானவர்கள் இனி உன்மேல் படையெடுத்து வருவதில்லை;","poem":1},{"text":"அவர்கள் முழுவதும் அழிக்கப்படுவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/NAM/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/NAM/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/MIC/7.json","previousChapterAudioLinks":{},"numberOfVerses":15}