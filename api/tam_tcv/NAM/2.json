{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"NAM","translationId":"tam_tcv","name":"நாகூம்","commonName":"நாகூம்","title":"நாகூம்","order":34,"numberOfChapters":3,"sha256":"81796e448f5396217b8c442eac2ff4b4db431e41c70ec30fc9f5265ce4d3321f","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":2,"content":[{"type":"heading","content":["நினிவேயின் வீழ்ச்சி"]},{"type":"verse","number":1,"content":[{"text":"நினிவே பட்டணமே, உன்னைத் தாக்குகிறவன் உனக்கெதிரே முன்னேறி வருகிறான்;","poem":1},{"text":"கோட்டையைக் காவல் செய்,","poem":2},{"lineBreak":true},{"text":"வீதியை கண்காணி,","poem":2},{"lineBreak":true},{"text":"உன்னைத் திடப்படுத்திக்கொள்,","poem":2},{"lineBreak":true},{"text":"உன் முழுப் பெலத்தையும் ஒன்றுதிரட்டு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அசீரியர் இஸ்ரயேலைப் பாழாக்கி,","poem":1},{"text":"அவர்களின் திராட்சைத் தோட்டங்களை அழித்துப்போட்டாலும்,","poem":2},{"text":"யெகோவா இஸ்ரயேலின் மாட்சிமையை,","poem":1},{"text":"யாக்கோபின் மாட்சிமையைப்போல் திரும்பவும் அமைத்துக்கொடுப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நினிவேயைத் தாக்குகிற","poem":1},{"text":"இராணுவவீரர்களின் கேடயங்கள் சிவப்பாய் இருக்கின்றன.","poem":2},{"text":"போர்வீரர்கள் சிவப்பு உடை உடுத்தியிருக்கிறார்கள்.","poem":1},{"text":"தேர்கள் ஆயத்தப்படும் நாளிலே அவற்றிலுள்ள உலோகம் மினுங்குகிறது.","poem":2},{"lineBreak":true},{"text":"தேவதாரு மரத்தினால் செய்யப்பட்ட ஈட்டிகள் ஆயத்தமாக்கப்படுகின்றன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"தேர்கள் நகரத்திற்கு வெளியே வீதிகளின் வழியாக சதுக்கங்களில் ஓடி,","poem":1},{"text":"கடகடவென்றோடி, இங்கும் அங்கும் விரைகின்றன.","poem":2},{"text":"அவை சுடர் விட்டெரியும் தீப்பந்தம்போல் காணப்படுகின்றன,","poem":1},{"text":"அவை மின்னலைப்போல் பறக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நினிவேயின் அரசன் தான் தெரிந்தெடுத்த வீரர்களை அழைப்பிக்கிறான்.","poem":1},{"text":"இருந்தும் அவர்கள் தங்கள் வழியில் இடறுகிறார்கள்.","poem":2},{"text":"அவர்கள் பட்டணத்து சுவரை நோக்கி விரைகிறார்கள்.","poem":1},{"text":"பாதுகாப்புக்கான கேடயம் அதற்குரிய இடத்தில் வைக்கப்பட்டிருக்கின்றன.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஆனாலும் தாக்குகிறவன் உட்புகுந்துவிட்டான்,","poem":1},{"text":"ஆற்றின் மதகுகள் திறந்து விடப்படுகின்றன; அரண்மனை சரிந்து விழுகிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இது நினிவே என்று தீர்மானிக்கப்படுகிறது","poem":1},{"text":"பட்டணத்திலுள்ளவர்களை நாடுகடத்திக் கொண்டுபோக உத்தரவிடப்பட்டது.","poem":2},{"text":"பட்டணத்துப் பணிப்பெண்கள் தங்கள் மார்பில் அடித்து,","poem":1},{"text":"புறாக்களைப்போல் புலம்புகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நினிவே தண்ணீர் நிறைந்த குளம்போல் இருக்கிறது.","poem":1},{"text":"அதன் தண்ணீரோ வடிந்து ஓடுகிறது.","poem":2},{"text":"“நில்லுங்கள், நில்லுங்கள்!” என்று அவர்கள் அழுகிறார்கள்.","poem":1},{"text":"ஆனால் ஒருவனும் திரும்பி வருவதில்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"வெள்ளியைக் கொள்ளையிடுங்கள்,","poem":1},{"text":"தங்கத்தையும் கொள்ளையிடுங்கள்;","poem":2},{"text":"அதன் கருவூலங்களில் இருக்கும் திரவியங்களுக்குக்","poem":1},{"text":"குறைவில்லை, என்று தாக்குகிறவர்கள் சொல்கிறார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நினிவே கொள்ளையடிக்கப்பட்டு, சூறையாடப்பட்டு, வெறுமையாக்கப்பட்டுள்ளது!","poem":1},{"text":"உள்ளங்கள் கலங்குகின்றன, முழங்கால்கள் தள்ளாடுகின்றன, உடல்கள் நடுங்குகின்றன,","poem":2},{"lineBreak":true},{"text":"எல்லா முகங்களும் வெளிறிப்போய் இருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"அசீரியன் ஒரு சிங்கம்போல் இருந்தான்.","poem":1},{"text":"ஆனால் இப்பொழுதோ சிங்கங்களின் குகை எங்கே?","poem":2},{"text":"அவை தமது குட்டிகளுக்கு இரை கொடுத்த இடம் எங்கே?","poem":1},{"text":"சிங்கமும், அதன் பெண் சிங்கமும் குட்டிகளுடன் பயமின்றிபோன இடம் எங்கே?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"சிங்கம் தன் குட்டிகளுக்குப் போதிய அளவு இரையைக் கொன்று.","poem":1},{"text":"தன் துணைச் சிங்கத்திற்குத் தேவையான இரையைத் பிடித்துக் கொன்று.","poem":2},{"text":"தான் கொன்றவைகளினால் தன் இடங்களையும்,","poem":1},{"text":"இரையினால் தன் குகையையும் நிரப்பியது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"நினிவேயே, “நான் உனக்கு விரோதமாக இருக்கிறேன்”","poem":1},{"text":"என்று சேனைகளின் யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"“புகை எழும்பும்படி உன் தேர்களை எரிப்பேன்,","poem":1},{"text":"உன் சிங்கக்குட்டிகள் வாளினால் அழியும்.","poem":2},{"lineBreak":true},{"text":"பூமியில் உங்களுக்கு இரையில்லாமல் போகச்செய்வேன்.","poem":2},{"text":"உங்கள் தூதுவர்களின் குரல்கள்","poem":1},{"text":"இனிமேலும் கேட்கப்படுவதில்லை.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/NAM/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/NAM/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/NAM/1.json","previousChapterAudioLinks":{},"numberOfVerses":13}