{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"NAM","translationId":"tam_tcv","name":"நாகூம்","commonName":"நாகூம்","title":"நாகூம்","order":34,"numberOfChapters":3,"sha256":"81796e448f5396217b8c442eac2ff4b4db431e41c70ec30fc9f5265ce4d3321f","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/NAM/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/NAM/3.json","totalNumberOfVerses":47},"chapter":{"number":3,"content":[{"type":"heading","content":["நினிவேக்கு ஐயோ கேடு"]},{"type":"verse","number":1,"content":[{"text":"இரத்தம் சிந்தின பட்டணமே,","poem":1},{"text":"உனக்கு ஐயோ கேடு,","poem":2},{"text":"நீ பொய்யினாலும் கொள்ளையினாலும் நிறைந்திருக்கிறாய்.","poem":1},{"text":"ஒருபோதும் உன்னிடம் கொலை இல்லாமல் போவதில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"சவுக்கு அடியின் ஒசையும்,","poem":1},{"text":"உருளைகளின் சத்தமும்,","poem":2},{"text":"குதிரைகளின் பாய்ச்சலும்,","poem":1},{"text":"தேர்களின் அதிர்வும் கேட்கிறதே,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"தாக்குகின்ற குதிரைப்படையின் வாள்களும்,","poem":1},{"text":"மின்னும் ஈட்டிகளும் பளிச்சிடுகின்றன,","poem":2},{"lineBreak":true},{"text":"அநேகர் கொல்லப்பட்டுக் கிடக்கிறார்கள்.","poem":2},{"text":"பிரேதங்கள் குவியலாய் கிடக்கின்றன.","poem":1},{"text":"இறந்த உடல்களோ எண்ணற்றவை.","poem":2},{"text":"மக்கள் பிரேதங்கள்மேல்","poem":1},{"text":"இடறி விழுகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இவையெல்லாம் நினிவேயின் வேசித்தனத்தினாலும்,","poem":1},{"text":"கட்டுக்கடங்காத காமத்தினாலும் உண்டாயிற்று.","poem":2},{"lineBreak":true},{"text":"அவள் வசீகரமுள்ளவளும், மந்திரங்களில் தேர்ச்சி பெற்றவளுமாயிருக்கிறாள்.","poem":2},{"text":"அவள் நாடுகளைத் தன் வேசித்தனத்தினாலும்,","poem":1},{"text":"மக்கள் கூட்டங்களைத் தன் மந்திரங்களினாலும் அடிமைப்படுத்தியிருக்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இதோ, சேனைகளின் யெகோவா சொல்கிறார்:","poem":1},{"text":"“நினிவேயே, நான் உனக்கு விரோதமாய் வந்து,","poem":2},{"lineBreak":true},{"text":"உன் ஆடையை உன் முகத்துக்கு மேலாக தூக்குவேன்;","poem":2},{"text":"நாடுகளுக்கு உன் நிர்வாணத்தையும்,","poem":1},{"text":"எல்லா அரசுகளுக்கும் உன் வெட்கத்தையும் காட்டுவேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அசுத்தமானவற்றை உன்மேல் வீசுவேன்.","poem":1},{"text":"உன்னை அவமதிப்பாய் நடத்தி,","poem":2},{"lineBreak":true},{"text":"உன்னை ஒரு இழிவுக் காட்சியாக்குவேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உன்னைக் காண்கிறவர்கள் எல்லோரும் உன்னைவிட்டு விலகி ஓடி,","poem":1},{"text":"‘நினிவே பாழாக்கப்பட்டுப் போனது;","poem":2},{"text":"அதற்காகப் புலம்புகிறவர்கள் யார்?’ என்று சொல்வார்கள்.","poem":1},{"text":"உன்னை ஆறுதல்படுத்துவதற்கு ஒருவனை நான் எங்கே தேடுவேன்?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"நைல் நதிக்கருகில் அமைந்திருக்கிறதும்,","poem":1},{"text":"நீரால் சூழப்பட்டதுமான நோ அம்மோன் பட்டணத்தைப் பார்க்கிலும்,","poem":2},{"lineBreak":true},{"text":"நினிவேயே நீ சிறந்தவளோ?","poem":2},{"text":"நதியானது நோ அம்மோனுக்குப் பாதுகாப்பாகவும்,","poem":1},{"text":"தண்ணீர் அவளுக்கு மதிலாகவும் இருந்தன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவளுக்கு எத்தியோப்பியாவும், எகிப்தும் அளவற்ற வல்லமையாய் இருந்தன.","poem":1},{"text":"பூத்தும் லிபியாவும் அவளுக்கு நட்பு நாடுகளாயிருந்தன.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆயினும் அவள் குடியிருக்கக் கூடாதென்று சிறைபிடிக்கப்பட்டு,","poem":1},{"text":"நாடுகடத்தப்பட்டாள்.","poem":2},{"text":"அவளுடைய பிள்ளைகளோ ஒவ்வொரு வீதிச்சந்தியிலும்,","poem":1},{"text":"அடித்து நொறுக்கப்பட்டார்கள்.","poem":2},{"text":"அவளது உயர் குடிமக்களுக்காக அசீரிய வீரர்களால் சீட்டுகள் போடப்பட்டன.","poem":1},{"text":"அவளின் பெரிய மனிதர் சங்கிலிகளால் கட்டப்பட்டு","poem":2},{"text":"அடிமைகளாகக் கொண்டுபோகப்பட்டார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"நினிவே பட்டணமே! நீயும் வெறிகொள்வாய்.","poem":1},{"text":"நீ ஒரு ஒளிவிடத்திற்குப் போவாய்.","poem":2},{"lineBreak":true},{"text":"பகைவரிடமிருந்து தப்ப புகலிடம் தேடுவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"உன் அரண்களெல்லாம் முதல் பழுத்த","poem":1},{"text":"பழங்களுடைய அத்திமரங்களைப் போலிருக்கும்.","poem":2},{"text":"அவை உலுக்கப்பட்டபோது அவற்றின் பழங்கள்","poem":1},{"text":"அவற்றைத் தின்கிறவனின் வாயிலே விழும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"உன் இராணுவ வீரர்களைப் பார்!","poem":1},{"text":"அவர்கள் பெண்களைப் போலிருக்கிறார்கள்.","poem":2},{"text":"உன் நாட்டின் வாசல்கள் உன் பகைவர்களுக்கு முன்பாக","poem":1},{"text":"விரிவாய்த் திறக்கப்பட்டிருக்கின்றன;","poem":2},{"lineBreak":true},{"text":"வாயில் தாழ்ப்பாள்களை நெருப்பு சுட்டெரித்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"முற்றுகைக் காலத்துக்கென","poem":1},{"text":"தண்ணீரை அள்ளி வைத்துக்கொள்ளுங்கள்,","poem":2},{"text":"உங்கள் அரண்களைப் பலப்படுத்துங்கள்;","poem":1},{"text":"களிமண்ணில் வேலைசெய்து சாந்தைக் குழைத்து","poem":2},{"lineBreak":true},{"text":"செங்கல் சுவரைப் பழுது பாருங்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆயினும் நெருப்பு உங்களைச் சுட்டெரிக்கும்;","poem":1},{"text":"வாள் உங்களை வெட்டி வீழ்த்தும்.","poem":2},{"lineBreak":true},{"text":"அது உங்களை வெட்டுக்கிளிகளைப்போல் தின்னும்.","poem":2},{"text":"பச்சைக்கிளிகளைப்போல் பெருகுங்கள்,","poem":1},{"text":"வெட்டுக்கிளிகளைப்போல் பெருகுங்கள்!","poem":2}]},{"type":"verse","number":16,"content":[{"text":"உன் வர்த்தகர்களின் எண்ணிக்கையை வானத்து நட்சத்திரங்களைவிட அதிகமாக்கினாய்,","poem":1},{"text":"ஆனால் அவர்கள் வெட்டுக்கிளிகளைப்போல்","poem":2},{"text":"நாட்டை வெறுமையாக்கி விட்டு,","poem":1},{"text":"பறந்து போய்விடுகிறார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"உன் காவலர்கள் வெட்டுக்கிளிகளைப்போல் இருக்கிறார்கள்.","poem":1},{"text":"உன் அதிகாரிகள் குளிர்க்காலத்தில் சுவர்களில் ஒட்டிக்கொள்ளும்","poem":2},{"lineBreak":true},{"text":"வெட்டுக்கிளிக் கூட்டத்தைப்போல் இருக்கிறார்கள்.","poem":2},{"text":"சூரியன் வந்ததும் அவை பறந்துபோய் விடுகின்றன.","poem":1},{"text":"ஆனால் அவை எங்கே போயின என்று யாரும் அறியமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"அசீரிய அரசனே, உனது ஆளுநர்கள் உறங்குகிறார்கள்.","poem":1},{"text":"உனது உயர்குடி மக்கள் படுத்து ஓய்வெடுக்கிறார்கள்.","poem":2},{"text":"உனது மக்கள் மலைகளில் சிதறடிக்கப்பட்டிருக்கிறார்கள்.","poem":1},{"text":"அவர்களை ஒன்றுசேர்ப்பார் ஒருவருமில்லை.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"உன் காயத்தை எதனாலும் குணமாக்க முடியாது;","poem":1},{"text":"உனது காயம் மரணத்திற்கு ஏதுவானது.","poem":2},{"text":"உன்னைக் குறித்த செய்தியைக் கேட்கிறவர்கள் எல்லோரும்,","poem":1},{"text":"உன் வீழ்ச்சியைப் பார்த்து கைத்தட்டுகிறார்கள்.","poem":2},{"text":"ஏனெனில் உன் முடிவற்ற","poem":1},{"text":"கொடுமையை அறியாதவன் யார்?","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/NAM/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HAB/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/NAM/2.json","previousChapterAudioLinks":{},"numberOfVerses":19}