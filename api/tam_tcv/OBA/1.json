{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"OBA","translationId":"tam_tcv","name":"ஒபதியா","commonName":"ஒபதியா","title":"ஒபதியா","order":31,"numberOfChapters":1,"sha256":"4172613f4230ac82a760e70d16e4ca13dfccabd88b72b3dfa2dcc6b12e8a3cc2","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/OBA/1.json","lastChapterNumber":1,"lastChapterApiLink":"/api/tam_tcv/OBA/1.json","totalNumberOfVerses":21},"chapter":{"number":1,"content":[{"type":"heading","content":["ஒபதியாவின் தரிசனம்"]},{"type":"verse","number":1,"content":["ஒபதியாவின் தரிசனம்.",{"lineBreak":true},{"lineBreak":true},"யெகோவாவாகிய ஆண்டவர் ஏதோம் நாட்டைக் குறித்துச் சொல்லுகிறது என்னவென்றால்:",{"text":"“எழும்புங்கள், அதற்கு விரோதமாக யுத்தம் செய்ய வாருங்கள்”","poem":1},{"text":"என்று ஜனங்களிடம் சொல்லுவதற்காக","poem":2},{"lineBreak":true},{"text":"ஒரு தூதுவன் அனுப்பப்பட்டான்,","poem":2},{"text":"என்ற செய்தியை யெகோவா சொல்லக்கேட்டோம்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“இதோ, நான் உன்னை நாடுகளுக்குள்ளே சிறியதாக்குவேன்;","poem":1},{"text":"நீ முற்றிலும் அவமதிக்கப்படுவாய்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"கற்பாறை பிளவுகளாகிய உன் உயர்ந்த ஸ்தானத்திலே குடியிருந்து,","poem":1},{"text":"‘என்னைத் தரையிலே விழத்தள்ளுகிறவன் யார்?’ என்று","poem":2},{"lineBreak":true},{"text":"உன் இருதயத்தில் சொல்லுகிறவனே,","poem":2},{"text":"உன் இருதயத்தின் அகந்தை","poem":1},{"text":"உன்னை மோசம்போக்குகிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீ கழுகைப்போல உயரப்போனாலும்,","poem":1},{"text":"நீ நட்சத்திரங்களுக்குள்ளே உன் கூட்டைக் கட்டினாலும்,","poem":2},{"lineBreak":true},{"text":"அங்கிருந்தும் நான் உன்னைக் கீழே விழத்தள்ளுவேன்” என்று","poem":2},{"lineBreak":true},{"text":"யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“நீ எவ்வளவாய்ச் சங்கரிக்கப்பட்டுப்போனாய்!","poem":1},{"text":"திருடராகிலும் இராத்திரியில் கொள்ளையடிக்கிறவர்களாகிலும்","poem":2},{"text":"உன்னிடத்தில் வந்தால்,","poem":1},{"text":"தங்களுக்குப் போதுமானமட்டும் திருடுவார்கள் அல்லவோ?","poem":2},{"text":"திராட்சைப் பழங்களை பறிக்கிறவர்கள் உன்னிடத்தில் வந்தால்,","poem":1},{"text":"சில பழங்களை விட்டுவிடுவார்கள் அல்லவோ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஏசாவினுடையவைகள் எவ்வளவாய்த் ஆராய்ந்தெடுக்கப்பட்டது;","poem":1},{"text":"அவனுடைய அந்தரங்கப் பொக்கிஷங்கள் எவ்வளவாய் சூறையாடப்பட்டது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உன்னோடு உடன்படிக்கை செய்த எல்லா மனுஷரும்","poem":1},{"text":"உன்னை எல்லைமட்டும் துரத்திவிட்டார்கள்;","poem":2},{"text":"உன்னோடு சமாதானமாயிருந்த மனுஷர் உன்னை மோசம்போக்கி,","poem":1},{"text":"உன்னை மேற்கொண்டார்கள்;","poem":2},{"text":"உன் அப்பத்தைச் சாப்பிட்டவர்கள் உனக்குக் கீழே கண்ணிவைத்தார்கள்,","poem":1},{"text":"ஆனால் நீ அதைக் கண்டுகொள்ளமாட்டாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“அந்நாளில் அல்லவோ நான் ஏதோமிலுள்ள ஞானிகளையும்,","poem":1},{"text":"ஏசாவின் மலைமேலுள்ள புத்திமான்களையும் அழிப்பேன்,","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா சொல்லுகிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தேமானே, ஏசாவின் மலைமேலுள்ள மனுஷர் யாவரும்","poem":1},{"text":"கொலையினால் சங்கரிக்கப்படும்படி","poem":2},{"lineBreak":true},{"text":"உன் வலிமைமிக்க வீரர்கள் கலங்குவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீ உன் சகோதரனாகிய யாக்கோபுக்குச் செய்த கொடுமையினிமித்தம்,","poem":1},{"text":"வெட்கம் உன்னை மூடும்;","poem":2},{"lineBreak":true},{"text":"நீ முற்றிலும் அழிக்கப்பட்டுப் போவாய்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நீ எதிர்த்து நின்ற நாளிலும்,","poem":1},{"text":"பிறநாட்டார் அவன் சேனையைச் சிறைப்பிடித்துப்போன நாளிலும்,","poem":2},{"text":"வெளிநாட்டார் அவன் வாசல்களுக்குள் புகுந்து,","poem":1},{"text":"எருசலேமின்பேரில் சீட்டுப்போட்ட காலத்தில்,","poem":2},{"lineBreak":true},{"text":"நீயும் அவர்களில் ஒருவனைப்போல் இருந்தாய்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உன் சகோதரன் அந்நியர்வசமான நாளாகிய அவனுடைய நாளை","poem":1},{"text":"நீ பிரியத்தோடே பாராமலும்,","poem":2},{"text":"யூதா புத்திரருடைய அழிவின் நாளிலே அவர்கள் நிமித்தம் சந்தோஷப்படாமலும்,","poem":1},{"text":"அவர்கள் நெருக்கப்படுகிற நாளிலே","poem":2},{"text":"நீ பெருமையாய்ப் பேசாமலும்","poem":1},{"text":"இருக்கவேண்டியதாயிருந்தது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"என் ஜனத்தின் ஆபத்துநாளிலே","poem":1},{"text":"நீ அவர்கள் வாசல்களுக்குள் பிரவேசியாமலும்,","poem":2},{"text":"அவர்கள் ஆபத்துநாளிலே","poem":1},{"text":"அவர்கள் அநுபவிக்கிற தீங்கை நீ பிரியத்தோடே பாராமலும்,","poem":2},{"text":"அவர்கள் ஆபத்துநாளிலே","poem":1},{"text":"அவர்கள் ஆஸ்தியில் கைபோடாமலும்,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்களில் தப்பினவர்களைச் சங்கரிக்கும்படி","poem":1},{"text":"வழிச்சந்திகளிலே நிற்காமலும்,","poem":2},{"text":"இக்கட்டு நாளில் அவர்களில் மீதியானவர்களைக்","poem":1},{"text":"காட்டிக்கொடாமலும் இருக்கவேண்டியதாயிருந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“எல்லா நாடுகளுக்கும் விரோதமான நாளாகிய","poem":1},{"text":"யெகோவாவினுடைய நாள் சமீபமாய் வந்திருக்கிறது;","poem":2},{"text":"நீ செய்தபடியே உனக்கும் செய்யப்படும்;","poem":1},{"text":"உன் செய்கையின் பலன் உன் தலையின்மேல் திரும்பும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீங்கள் என் பரிசுத்த பர்வதத்தின்மேல் மதுபானம்பண்ணினபடியே","poem":1},{"text":"எல்லா நாடுகளும் எப்பொழுதும் மதுபானம்பண்ணுவார்கள்;","poem":2},{"text":"அவர்கள் குடித்துக்கொண்டே இருப்பார்கள்,","poem":1},{"text":"குடித்து மயங்கியிருப்பார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆனாலும் சீயோன் மலையிலே தப்பியிருப்பார் உண்டு,","poem":1},{"text":"அவர்கள் பரிசுத்தமாயிருப்பார்கள்;","poem":2},{"lineBreak":true},{"text":"யாக்கோபின் வம்சத்தார் தங்களுடைய உரிமைச்சொத்தைச் சுதந்தரித்துக்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"யாக்கோபு வம்சத்தார் அக்கினியும்,","poem":1},{"text":"யோசேப்பு வம்சத்தார் அக்கினிஜூவாலையுமாய் இருப்பார்கள்;","poem":2},{"text":"ஏசா வம்சத்தாரோ வைக்கோல் துரும்பாயிருப்பார்கள்;","poem":1},{"text":"அவர்கள் இவர்களைக் கொளுத்தி,","poem":2},{"text":"ஏசாவின் வம்சத்தில்","poem":1},{"text":"மீதியிராதபடி இவர்களைப் பட்சிப்பார்கள்.”","poem":2},{"text":"யெகோவா இதைச் சொன்னார்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"நெகேவில் இருப்பவர்கள் ஏசாவின் மலையையும்,","poem":1},{"text":"செபேலாவைச் சேர்ந்தவர்கள் பெலிஸ்தரின் நாட்டையும்","poem":2},{"text":"சுதந்தரித்துக்கொள்வார்கள்;","poem":1},{"text":"அவர்கள் எப்பிராயீமிம், சமாரியா நாடுகளையும்","poem":2},{"text":"சுதந்தரித்துக்கொள்வார்கள்;","poem":1},{"text":"பென்யமீன் மனுஷர் கீலேயாத்தையும் சுதந்தரித்துக்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"சாரெபாத்வரை கானானியருக்குள்ளே சிறைப்பட்டுப்போன","poem":1},{"text":"இஸ்ரயேல் புத்திரராகிய இந்தச் சேனையும்,","poem":2},{"text":"சேப்பாராத்தில் சிறைப்பட்டுப்போன எருசலேம் நகரத்தாரும்","poem":1},{"text":"நெகேவின் பட்டணங்களைச் சுதந்தரித்துக்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஏசாவின் மலையை ஆள்வதற்காக","poem":1},{"text":"இரட்சகர்கள் சீயோன் மலையில் வந்தேறுவார்கள்;","poem":2},{"lineBreak":true},{"text":"அப்பொழுது அரசாட்சி யெகோவாவினுடையதாய் இருக்கும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/OBA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/JON/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/AMO/9.json","previousChapterAudioLinks":{},"numberOfVerses":21}