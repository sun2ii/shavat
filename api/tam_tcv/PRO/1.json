{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["இஸ்ரயேலின் அரசனும் தாவீதின் மகனுமான சாலொமோனின் நீதிமொழிகள்:"]},{"type":"verse","number":2,"content":[{"text":"இவைகளால் ஞானத்தையும் அறிவுரையையும் கற்றுக்கொள்ளலாம்;","poem":1},{"text":"நுண்ணறிவுள்ள வார்த்தைகளையும் விளங்கிக்கொள்ளலாம்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இவைகளால் நேர்மை, நீதி, நியாயம் ஆகியவற்றைச் செய்ய,","poem":1},{"text":"அறிவுரையும் விவேகமும் உள்ள வாழ்க்கையை வாழ உதவுகிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இவைகள் அறிவற்றவர்களுக்கு விவேகத்தையும்,","poem":1},{"text":"வாலிபர்களுக்கு அறிவையும் அறிவுடைமையையும் கொடுக்கின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஞானமுள்ளவர்கள் இவைகளைக் கேட்டு, தங்கள் அறிவைக் கூட்டிக்கொள்ளட்டும்;","poem":1},{"text":"பகுத்தறிவு உள்ளவர்கள், இவைகளினால் வழிநடத்துதலைப் பெறட்டும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இவைகளினால் நீதிமொழிகளையும், உவமைகளையும்,","poem":1},{"text":"ஞானிகளின் வார்த்தைகளையும், புதிர்களையும் விளங்கிக்கொள்ளட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவுக்குப் பயப்படுதலே ஞானத்தின் ஆரம்பம்;","poem":1},{"text":"ஆனால் மூடர்கள் ஞானத்தையும் அறிவுரையையும் புறக்கணிக்கிறார்கள்.","poem":2}]},{"type":"heading","content":["பாவிகளின் அழைப்பிதலைக் குறித்த எச்சரிக்கை"]},{"type":"verse","number":8,"content":[{"text":"என் மகனே, உன் தகப்பனின் அறிவுரைகளைக் கேள்;","poem":1},{"text":"உன் தாயின் போதனைகளை விட்டுவிடாதே.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவை உன் தலையைச் சிறப்பிக்கும் மகுடமாகவும்,","poem":1},{"text":"உன் கழுத்தை அலங்கரிக்கும் பொன் மாலையாகவும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"என் மகனே, பாவிகள் உன்னைக் கவர்ச்சியூட்டி இழுக்க முயன்றால்,","poem":1},{"text":"அவர்களுடன் இழுப்புண்டு போகாதே.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் உன்னிடம், “நீ எங்களோடுகூட வா;","poem":1},{"text":"குற்றமற்ற இரத்தத்தைச் சிந்தும்படி பதுங்கிக் காத்திருப்போம்,","poem":2},{"lineBreak":true},{"text":"அப்பாவியான மனிதரை வழிமறித்துப் பறிப்போம்;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பாதாளம் விழுங்குவதுபோல் அவர்களை உயிருடன் விழுங்குவோம்,","poem":1},{"text":"மரணக் குழிக்குள் போகிறவர்களைப்போல் முழுமையாய் விழுங்குவோம்;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"பலவித விலைமதிப்புள்ள பொருட்களையும் எடுத்து,","poem":1},{"text":"நமது வீடுகளைக் கொள்ளைப் பொருட்களால் நிரப்புவோம்;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"எங்களுடன் பங்காளியாயிரு;","poem":1},{"text":"நாம் கொள்ளையிட்டதைப் பகிர்ந்துகொள்வோம்” என்று சொல்லுவார்களானால்,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என் மகனே, நீ அவர்களோடுகூடப் போகாதே;","poem":1},{"text":"அவர்களுடைய வழிகளில் காலடி வைக்காதே.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஏனெனில் அவர்களுடைய கால்கள் தீமைசெய்ய விரைகின்றன,","poem":1},{"text":"இரத்தஞ்சிந்த வேகமாய் செல்கின்றன.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"பறவைகள் பார்த்துக்கொண்டிருக்கையில்,","poem":1},{"text":"அவற்றைப் பிடிக்க வலை விரிப்பது பயனற்றதல்லவா.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஆனாலும் இந்த மனிதர்கள், தங்கள் சொந்த இரத்தத்தைச் சிந்துவதற்கே காத்திருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் தங்களுக்காகவே பதுங்கியிருக்கிறார்களே,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"தகாத முறையில் சம்பாதிக்கத் தேடுகிற அனைவரின் முடிவும் இதுவே;","poem":1},{"text":"அதின் பலன் அதைப் பெறுகிறவர்களின் உயிரை எடுத்துவிடும்.","poem":2}]},{"type":"heading","content":["ஞானத்தைப் புறக்கணிக்காதிருக்க எச்சரிக்கை"]},{"type":"verse","number":20,"content":[{"text":"ஞானம் வீதியிலே சத்தமிட்டு அழைக்கிறது,","poem":1},{"text":"பொது இடங்களில் தனது குரலை எழுப்புகிறது;","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அது இரைச்சலுள்ள வீதிகளின் சந்தியில் சத்தமிடுகிறது,","poem":1},{"text":"பட்டணத்தின் நுழைவாசல்களில் நின்று உரையாற்றுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“அறிவற்றவர்களே, எவ்வளவு காலம் அறியாமையின் வழிகளை விரும்புவீர்கள்?","poem":1},{"text":"ஏளனம் செய்பவர்களே, எவ்வளவு காலம் ஏளனத்தில் மகிழ்ந்திருப்பீர்கள்?","poem":2},{"lineBreak":true},{"text":"மூடர்களே, எவ்வளவு காலத்திற்கு நீங்கள் அறிவை வெறுப்பீர்கள்?","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நீங்கள் எனது கடிந்துகொள்ளுதலை ஏற்றுக்கொள்ளுங்கள்!","poem":1},{"text":"என் சிந்தனைகளை உங்களுக்குத் தெரியப்படுத்துவேன்,","poem":2},{"lineBreak":true},{"text":"என் வார்த்தைகளை உங்களுக்குத் தெரியப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஆனால், நான் கூப்பிட்டபோது நீங்கள் என்னைப் புறக்கணித்து,","poem":1},{"text":"எனது கையை நீட்டியபோது ஒருவரும் அதைக் கவனிக்காதபடியினாலும்,","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நீங்கள் என் புத்திமதிகளையெல்லாம் தள்ளிவிட்டு,","poem":1},{"text":"எனது கடிந்துகொள்ளுதலை ஏற்றுக்கொள்ளாதபடியினாலும்","poem":2}]},{"type":"verse","number":26,"content":[{"text":"உங்களுக்குப் பேராபத்து வரும்போது நான் சிரிப்பேன்,","poem":1},{"text":"பேரழிவு உங்களை மேற்கொள்கையில் ஏளனம் செய்வேன்;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"பேரழிவு உங்கள்மேல் புயலைப்போல் வரும்போதும்,","poem":1},{"text":"பேராபத்து சுழற்காற்றைப் போல் உங்களை அடித்துச் செல்லும்போதும்,","poem":2},{"lineBreak":true},{"text":"துன்பமும் தொல்லையும் உங்களைத் திணறடிக்கும்போதும் நான் உங்களை ஏளனம் செய்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"“அப்பொழுது அவர்கள் என்னை நோக்கிக் கூப்பிடுவார்கள், நான் பதில் கொடுக்கமாட்டேன்;","poem":1},{"text":"அவர்கள் என்னைத் தேடுவார்கள், ஆனால் என்னைக் கண்டடையமாட்டார்கள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"ஏனெனில் அவர்கள் அறிவை வெறுத்து,","poem":1},{"text":"யெகோவாவுக்குப் பயந்து நடப்பதைத் தெரிந்துகொள்ளாமல் போனார்கள்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவர்கள் என் புத்திமதிகளை ஏற்றுக்கொள்ளாமல்,","poem":1},{"text":"எனது கடிந்துகொள்ளுதலை புறக்கணித்தபடியால்,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"அவர்கள் தங்கள் நடத்தையின் பலனை அனுபவிப்பார்கள்,","poem":1},{"text":"அவர்களுடைய சதித்திட்டங்களின் பலனால் நிரப்பப்படுவார்கள்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அறிவீனர்களின் அசட்டுத்தனம் அவர்களைக் கொல்லும்,","poem":1},{"text":"மூடர்களின் மனநிறைவு அவர்களை அழிக்கும்;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ஆனால் எனக்குச் செவிகொடுப்பவர் யாரும் பாதுகாப்பாக வாழ்வார்கள்,","poem":1},{"text":"அவர்கள் தீமைக்குப் பயப்படாமல் அமைதியாயிருப்பார்கள்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/150.json","previousChapterAudioLinks":{},"numberOfVerses":33}