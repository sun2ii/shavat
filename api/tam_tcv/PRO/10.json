{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":["சாலொமோனின் நீதிமொழிகள்:",{"text":"ஞானமுள்ள மகன் தன் தகப்பனுக்கு மகிழ்ச்சியைக் கொண்டுவருகிறான்;","poem":1},{"text":"ஆனால் மூடத்தனமுள்ள மகனோ தன் தாய்க்கு துக்கத்தைக் கொடுக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"நீதியற்ற வழியில் சம்பாதித்த செல்வம் பயனற்றது,","poem":1},{"text":"ஆனால் நீதியோ ஒருவனை மரணத்திலிருந்து விடுவிக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவா நீதிமான்களைப் பசியாயிருக்க விடுவதில்லை,","poem":1},{"text":"ஆனால் கொடியவர்களின் பேராசையை அவர் நிறைவேற்றமாட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"சோம்பேறிகளின் கைகள் வறுமையை உண்டாக்கும்,","poem":1},{"text":"ஆனால் உழைக்கும் கைகளோ செல்வத்தைக் கொண்டுவரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"கோடைகாலத்தில் பயிர்களை சேர்க்கிறவன் விவேகமுள்ள மகன்;","poem":1},{"text":"ஆனால் அறுவடைக்காலத்தில் தூங்குகிறவனோ, அவமானத்தைக் கொண்டுவரும் மகன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நீதிமான்களின் தலையை ஆசீர்வாதங்கள் முடிசூட்டும்;","poem":1},{"text":"ஆனால் கொடியவர்களின் பேச்சோ வன்முறை நிறைந்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நீதிமான்களைப் பற்றிய நினைவு ஆசீர்வாதமாயிருக்கும்;","poem":1},{"text":"ஆனால் கொடியவர்களின் பெயரோ அழிந்துபோகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"இருதயத்தில் ஞானமுள்ளவர்கள் கட்டளைகளை ஏற்றுக்கொள்கிறார்கள்;","poem":1},{"text":"ஆனால் அலட்டுகிற மூடன் அழிந்துபோகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"நேர்மையாய் நடக்கிறவர்கள் பாதுகாப்பாக நடக்கிறார்கள்,","poem":1},{"text":"ஆனால் நேர்மையற்ற வழிகளில் நடக்கிறவர்கள் வீழ்ந்து போவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"தீயநோக்கத்தோடு கண் சிமிட்டுகிறவன் துயரத்தை உண்டாக்குகிறான்;","poem":1},{"text":"அலட்டுகிற மூடன் அழிந்துபோகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"நீதிமான்களின் வாய் வாழ்வின் நீரூற்று,","poem":1},{"text":"ஆனால் கொடியவர்களின் பேச்சோ வன்முறை நிறைந்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"பகைமை பிரிவினையைத் தூண்டிவிடுகிறது;","poem":1},{"text":"அன்போ பிழைகளையெல்லாம் மன்னித்து மறக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"பகுத்தறிகிறவர்களின் உதடுகளில் ஞானம் காணப்படுகிறது,","poem":1},{"text":"ஆனால் மூடரின் முதுகுக்கு ஏற்றது பிரம்பே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஞானமுள்ளவர்கள் அறிவைச் சேர்த்துவைக்கிறார்கள்;","poem":1},{"text":"ஆனால் மூடரின் வாயோ அழிவை அழைக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"பணக்காரர்களின் செல்வம் அவர்களுடைய அரணான பட்டணம்;","poem":1},{"text":"ஆனால் ஏழையின் வறுமை அவர்களின் அழிவு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"நீதிமான்களின் கூலி, அவர்களுக்கு வாழ்வு,","poem":1},{"text":"ஆனால் கொடியவர்கள் தங்கள் பாவத்திற்கேற்ற தண்டனையை அடைவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நற்கட்டுப்பாட்டை ஏற்றுக்கொள்ளுகிறவன் வாழ்வின் வழியைக் காட்டுகிறான்;","poem":1},{"text":"ஆனால் கண்டித்துத் திருத்துவதை அலட்சியம் செய்கிறவனோ, மற்றவர்களையும் வழிதவறப்பண்ணுகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"பகையை மறைப்பவன் பொய்யன்;","poem":1},{"text":"அவதூறு பரப்புகிறவன் மூடன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"அதிக வார்த்தைகள் பேசும் இடத்தில் பாவமில்லாமற்போகாது;","poem":1},{"text":"ஆனால் தன் நாவைக் கட்டுப்படுத்துகிறவனோ விவேகமுள்ளவன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"நீதிமான்களின் நாவு தரமான வெள்ளி,","poem":1},{"text":"ஆனால் கொடியவர்களின் இருதயமோ சொற்பவிலையும் பெறாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"நீதிமான்களின் வார்த்தைகள் அநேகருக்கு ஊட்டம்;","poem":1},{"text":"ஆனால் மூடர்கள் மதிகேட்டினால் சாகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"யெகோவாவின் ஆசீர்வாதம் செல்வத்தைக் கொண்டுவருகிறது;","poem":1},{"text":"அதனுடன் அவர் துன்பத்தைச் சேர்க்கமாட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"தீங்கு செய்வது மூடர்களுக்கு வேடிக்கையானது;","poem":1},{"text":"ஆனால் ஞானம் புரிந்துகொள்ளுதல் உள்ளவர்களுக்கு மகிழ்ச்சியானது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"கொடியவர்கள் எதற்குப் பயப்படுகிறார்களோ, அது அவர்களுக்கு நேரிடும்;","poem":1},{"text":"நீதிமான்கள் விரும்புவது கொடுக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"சுழல் காற்று அடித்துச் செல்லும்போது, கொடியவர்கள் இல்லாமற்போவார்கள்;","poem":1},{"text":"ஆனால் நீதிமான்கள் என்றென்றைக்கும் உறுதியாய் நிலைத்து நிற்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"பற்களுக்குப் புளிப்பும், கண்களுக்கு புகையும் எப்படியோ,","poem":1},{"text":"சோம்பேறியும் தன்னை அனுப்புகிறவர்களுக்கு அப்படி இருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடப்பது வாழ்நாட்களை நீடிக்கும்,","poem":1},{"text":"ஆனால் கொடியவர்களின் வருடங்களோ குறைக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"நீதிமான்களின் நம்பிக்கை மகிழ்ச்சியாயிருக்கும்,","poem":1},{"text":"ஆனால் கொடியவர்களின் எதிர்பார்ப்போ ஒன்றுமில்லாமற்போம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"யெகோவாவின் வழி நீதிமான்களுக்கு புகலிடம்,","poem":1},{"text":"ஆனால் தீமை செய்பவர்களுக்கு அது அழிவு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"நீதிமான்கள் ஒருபோதும் அசைக்கப்படுவதில்லை;","poem":1},{"text":"ஆனால் கொடியவர்கள் நாட்டில் நிலைத்திருக்கமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"நீதிமான்களின் பேச்சு ஞானத்தைக் கொடுக்கும்,","poem":1},{"text":"ஆனால் வஞ்சகநாவு அழிக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"நீதிமான்களின் உதடுகள் தகுதியானவற்றைப் பேசும்;","poem":1},{"text":"ஆனால் கொடியவர்களின் வாயோ வஞ்சகமான வார்த்தைகளைப் பேசும்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/9.json","previousChapterAudioLinks":{},"numberOfVerses":32}