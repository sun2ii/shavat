{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":11,"content":[{"type":"verse","number":1,"content":[{"text":"கள்ளத்தராசுகளை யெகோவா அருவருக்கிறார்,","poem":1},{"text":"ஆனால் சரியான நிறையுள்ள படிக்கற்கள் அவருக்கு விருப்பம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அகந்தை வரும்பொழுது அவமானமும் வரும்;","poem":1},{"text":"ஆனால் தாழ்மையுடனோ ஞானம் வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"உத்தமமானவர்களுக்கு அவர்கள் நேர்மையே வழிகாட்டும்;","poem":1},{"text":"ஆனால் துரோகிகளின் கொடூரம் அவர்களை அழிக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நியாயத்தீர்ப்பின் நாளில் செல்வம் பயனற்றது;","poem":1},{"text":"ஆனால் நீதி மரணத்தினின்று விடுவிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"குற்றமற்றவர்களின் நீதி அவர்களுடைய வழியை நேராக்கும்;","poem":1},{"text":"ஆனால் கொடியவர்களை அவர்களுடைய கொடுமையே அழிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நீதிமான்களின் நீதி அவர்களை விடுவிக்கும்;","poem":1},{"text":"ஆனால் துரோகிகளோ தங்கள் தீய ஆசைகளில் அகப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"கொடியவர்கள் சாகும்போது, அவர்களுடைய நம்பிக்கையும் அழியும்;","poem":1},{"text":"அவர்கள் தங்கள் பலத்தினால் எதிர்பார்த்த யாவும் ஒன்றுமில்லாமல் போகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"நீதிமான்கள் கஷ்டத்திலிருந்து தப்புவிக்கப்படுகிறார்கள்;","poem":1},{"text":"கொடியவர்கள் அதற்குப் பதிலாக கஷ்டப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"இறைவனற்றவர்கள் தம் வார்த்தையினால் தமது அயலாரை அழிக்கிறார்கள்;","poem":1},{"text":"ஆனால் நீதிமான்கள் அறிவினால் தப்பிக்கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நீதிமான்கள் செழிப்படையும்போது, பட்டணம் மகிழ்ச்சியடையும்;","poem":1},{"text":"கொடியவர்கள் அழியும்போது, அங்கே மகிழ்ச்சியின் ஆர்ப்பரிப்பு உண்டாகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"நீதிமான்களின் ஆசீர்வாதத்தால் பட்டணம் உயர்ந்தோங்கும்;","poem":1},{"text":"ஆனால் கொடியவர்களின் வார்த்தையினாலோ அது அழிந்துபோகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"மதியீனர்கள் தங்களுக்கு அயலாரை ஏளனம் செய்கிறார்கள்;","poem":1},{"text":"ஆனால் புரிந்துகொள்ளுதல் உள்ளவர்கள் தங்கள் நாவை அடக்குகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"புறங்கூறித் திரிகிறவர்கள் நம்பிக்கைத் துரோகம் செய்கிறார்கள்;","poem":1},{"text":"ஆனால் நம்பகமானவர்கள் இரகசியத்தைக் காத்துக்கொள்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஞானமுள்ள வழிகாட்டலின்றி ஒரு நாடு வீழ்ச்சியடைகிறது,","poem":1},{"text":"ஆனால் அநேக ஆலோசகர்களால் வெற்றி நிச்சயமாகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"இன்னொருவருடைய கடனுக்கு வாக்குறுதி கொடுப்பவர் துன்பத்தை அனுபவிப்பார்கள்;","poem":1},{"text":"ஆனால் உறுதியளிப்பதில் கைகளை உதறித் தள்ளுகிறவர்கள் பாதுகாப்பாக இருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"இரக்ககுணமுடைய பெண் நன்மதிப்பு பெறுவாள்;","poem":1},{"text":"ஆனால் உழைக்கும் மனிதர்களோ செல்வத்தை மட்டுமே சேர்ப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"இரக்கமுள்ளவர்கள் தங்களுக்கு நன்மையை உண்டாக்குகிறார்கள்;","poem":1},{"text":"ஆனால் கொடூரமானவர்கள் தங்களுக்குக் கேட்டை வருவித்துக் கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"கொடியவர்கள் பெறும் கூலி ஏமாற்றமாய் முடியும்;","poem":1},{"text":"ஆனால் நீதியை விதைப்பவர்கள் உண்மையான பலனை அறுவடை செய்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"உண்மையாகவே நீதிமான்கள் வாழ்வைப் பெறுவார்கள்;","poem":1},{"text":"ஆனால் தீமையைப் பின்பற்றுபவர்கள் மரணத்தைக் காண்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"யெகோவா இருதயத்தில் வஞ்சகமுள்ளோரை அருவருக்கிறார்;","poem":1},{"text":"ஆனால் குற்றமற்ற வழியில் நடப்போரில் அவர் மகிழ்ச்சியடைகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"இது நிச்சயம்: கொடியவர்கள் தண்டனைக்குத் தப்பமாட்டார்கள்,","poem":1},{"text":"ஆனால் நீதிமான்கள் விடுவிக்கப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"புத்தியில்லாத பெண்ணின் அழகு","poem":1},{"text":"பன்றியின் மூக்கிலுள்ள தங்க மூக்குத்தியைப் போன்றது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"நீதிமான்களின் ஆசை நன்மையில் முடியும்,","poem":1},{"text":"ஆனால் கொடியவர்கள் நியாயத்தீர்ப்பை மட்டுமே எதிர்பார்க்க முடியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ஒருவர் தாராளமாய்க் கொடுத்தும், இன்னும் அதிகமாய் பெற்றுக்கொள்கிறார்;","poem":1},{"text":"இன்னொருவர் தேவைக்கதிகமாய் வைத்துக்கொண்டும் வறுமை அடைகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"தாராள குணம் உள்ளவர்கள் செழிப்படைவார்கள்;","poem":1},{"text":"மற்றவர்களுக்கு தண்ணீர் பாய்ச்சுகிறவர்களுக்கு தண்ணீர் பாய்ச்சப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"தானியத்தைத் தனக்கென்று பதுக்கிவைக்கும் மனிதரை மக்கள் சபிப்பார்கள்;","poem":1},{"text":"ஆனால் அவற்றை விற்க மனதுடையவர்களை மக்கள் ஆசீர்வதிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"நன்மையைத் தேடுகிறவர்கள் தயவைப் பெறுவார்கள்;","poem":1},{"text":"தீமையைத் தேடுகிறவர்களுக்கோ தீமையே வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"தனது செல்வத்தை நம்பியிருக்கிறவர்கள் வீழ்ந்து போவார்கள்,","poem":1},{"text":"ஆனால் நீதிமான்கள் பசுந்தளிரைப்போல் செழிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"தனது குடும்பத்திற்கு துன்பத்தைக் கொண்டுவருபவர்கள், வெறும் காற்றையே சுதந்தரிப்பார்கள்;","poem":1},{"text":"மூடர்களோ ஞானிக்கு வேலைக்காரர்களாய் இருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"நீதிமான்களின் பலனோ வாழ்வுதரும் மரம்,","poem":1},{"text":"ஆத்துமாக்களை ஆதாயப்படுத்துகிறவர்கள் ஞானமுள்ளவர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"நீதிமான்கள் தங்கள் வெகுமதியைப் பூமியில் பெறுவார்களானால்,","poem":1},{"text":"இறை பக்தியற்றவர்களும் பாவிகளும் தங்களுக்குரிய தண்டனையைப் பெறுவது எவ்வளவு நிச்சயம்!","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/10.json","previousChapterAudioLinks":{},"numberOfVerses":31}