{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"அறிவுரையை விரும்புகிறவர் அறிவை விரும்புகிறார்கள்,","poem":1},{"text":"ஆனால் கண்டித்துத் திருத்தப்படுவதை வெறுப்பவர்களோ மூடர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"நல்ல மனிதன் யெகோவாவிடமிருந்து தயவு பெறுகிறார்,","poem":1},{"text":"ஆனால் தீயதை திட்டமிடுபவர்களையோ அவர் கண்டிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"தீமையினால் ஒருவரும் நிலைக்கமாட்டார்கள்,","poem":1},{"text":"நீதிமான்களுடைய வேரையோ பிடுங்க முடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நற்குணமுள்ள மனைவி தன் கணவனுக்கு மகுடமாயிருப்பாள்;","poem":1},{"text":"ஆனால் அவமானத்தைக் கொண்டுவரும் மனைவியோ, அவனுக்கு எலும்புருக்கி போலிருக்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நீதிமான்களின் திட்டங்கள் நியாயமானவை,","poem":1},{"text":"ஆனால் கொடியவர்களின் ஆலோசனைகளோ வஞ்சனையானவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"கொடியவர்களின் வார்த்தைகள் இரத்தம் சிந்துவதற்கு பதுங்கிக் காத்திருக்கின்றன,","poem":1},{"text":"ஆனால் நீதிமான்களின் சொற்களோ அவர்களைத் தப்புவிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"கொடியவர்கள் வீழ்த்தப்பட்டு இல்லாமல் போவார்கள்,","poem":1},{"text":"ஆனால் நீதிமான்களின் குடும்பமோ உறுதியாய் நிலைத்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஒரு மனிதர் அவருடைய விவேகத்திற்குத் தக்கதாகப் புகழப்படுவார்,","poem":1},{"text":"ஆனால் சீர்கெட்ட சிந்தையுள்ளவரோ அலட்சியம் செய்யப்படுவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"உணவு இல்லாமல் இருந்தும் வெளியே தன்னைப் பெரிய ஆளாக காட்டுவதைவிட,","poem":1},{"text":"வேலைக்காரனாக உழைத்து சாதாரணமான நபராக இருப்பதே மேல்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நீதிமான்கள் தங்கள் மிருகங்களின் தேவையிலும் கரிசனையாய் இருக்கிறார்கள்;","poem":1},{"text":"ஆனால் கொடியவர்களின் தயவான செயல்களும் கொடூரமானவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"தங்கள் நிலத்தைப் பண்படுத்தி பயிரிடுகிறவர்களுக்கு நிறைவான உணவு கிடைக்கும்,","poem":1},{"text":"ஆனால் பகற்கனவு காண்பதில் நேரத்தை செலவிடுபவர்கள் மதியீனர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"தீயவர்களின் கொள்ளைப்பொருளுக்கு கொடியவர்கள் ஆசைப்படுகிறார்கள்;","poem":1},{"text":"ஆனால் நீதிமான்களின் வேரோ நிலைநிற்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"தீயவர் தங்களுடைய பாவப் பேச்சுக்களினால் அகப்பட்டுக் கொள்கிறார்கள்,","poem":1},{"text":"ஆனால் நீதிமான்கள் துன்பத்திற்குத் தப்புகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஒருவருடைய பேச்சினால் அவருக்கு நன்மையும்,","poem":1},{"text":"அவருடைய கைவேலையினால் பலனும் பெறுகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"மூடருடைய வழி அவர்களுக்கு சரியானதாகவே காணப்படும்,","poem":1},{"text":"ஆனால் ஞானமுள்ளவர்கள் ஆலோசனைக்குச் செவிகொடுக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"மூடர்கள் கோபத்தை உடனடியாக வெளிக்காட்டுவார்கள்,","poem":1},{"text":"ஆனால் விவேகிகள் ஏளனத்தைப் பொருட்படுத்தமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நேர்மையான சாட்சி உண்மையை சொல்கிறார்கள்;","poem":1},{"text":"ஆனால் பொய்ச்சாட்சி பொய்களையே சொல்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"முன்யோசனையற்ற வார்த்தைகள் வாளைப்போல் குத்தும்,","poem":1},{"text":"ஆனால் ஞானமுள்ளவர்களின் நாவு சுகப்படுத்தும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"உண்மைபேசும் உதடுகள் என்றென்றைக்கும் நிலைத்திருக்கும்,","poem":1},{"text":"ஆனால் பொய்பேசும் நாவு சொற்ப நேரமே நிலைக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"தீமையான சூழ்ச்சி செய்வோரின் இருதயங்களில் வஞ்சனை உண்டு,","poem":1},{"text":"ஆனால் சமாதானத்திற்காக முயற்சிப்பவர்களுக்கு மகிழ்ச்சி உண்டு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"நீதிமான்களுக்கு ஒரு தீங்கும் நேரிடாது,","poem":1},{"text":"ஆனால் கொடியவர்கள் தொல்லையினால் நிரப்பப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"பொய்பேசும் உதடுகளை யெகோவா அருவருக்கிறார்,","poem":1},{"text":"ஆனால் உண்மையானவர்களில் அவர் மகிழ்வார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"விவேகமுள்ள மனிதர்கள் தன் அறிவைத் தனக்குள்ளே வைத்திருக்கிறார்கள்;","poem":1},{"text":"ஆனால் மூடர்களின் இருதயமோ மூடத்தனத்தை வெளிப்படுத்தும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"சுறுசுறுப்பான கைகள் ஆட்சிசெய்யும்;","poem":1},{"text":"ஆனால் சோம்பற்தனமோ அடிமை வேலையிலேயே முடியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"கவலை ஒருவருடைய உள்ளத்தை சோர்வடையச் செய்யும்,","poem":1},{"text":"ஆனால் தயவான வார்த்தை உற்சாகப்படுத்தும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"நீதிமான்கள் தங்கள் நட்பில் எச்சரிக்கையாக இருக்கிறார்கள்;","poem":1},{"text":"ஆனால் கொடியவர்களின் வழியோ அவர்களை வழிதவறச் செய்யும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"சோம்பேறிகள் தாங்கள் வேட்டையாடிய இறைச்சியை சமைக்காமல் இருக்கிறார்கள்;","poem":1},{"text":"ஆனால் சுறுசுறுப்பான மனிதர்கள் தங்களுடைய பொருளை அருமையாய் மதிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"நீதியின் பாதையில் வாழ்வு உண்டு;","poem":1},{"text":"அப்பாதையில் மரணம் இல்லை.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/11.json","previousChapterAudioLinks":{},"numberOfVerses":28}