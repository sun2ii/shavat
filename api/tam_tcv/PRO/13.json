{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":13,"content":[{"type":"verse","number":1,"content":[{"text":"ஞானமுள்ள மகன் தன் தகப்பனின் அறிவுரையை ஏற்றுக்கொள்கிறான்;","poem":1},{"text":"ஆனால் ஏளனக்காரர்களோ கண்டிப்புக்கு செவிகொடுப்பதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"மனிதர் தன் வாயின் வார்த்தையினால் நன்மைகளை அனுபவிக்கிறார்கள்,","poem":1},{"text":"ஆனால் உண்மையற்றவர்கள் வன்முறைகளையே விரும்புகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"தங்கள் நாவைக் காத்துக்கொள்பவர்கள் வாழ்வைக் காத்துக்கொள்கிறார்கள்,","poem":1},{"text":"ஆனால் முன்யோசனையின்றி பேசுபவர்கள் அழிவுக்குள்ளாகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"சோம்பேறிகள் ஆசைப்பட்டும் ஒன்றும் பெறாமலிருக்கிறார்கள்;","poem":1},{"text":"ஆனால் சுறுசுறுப்புள்ளவர்களின் ஆசைகளோ முற்றிலும் நிறைவேறுகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நீதிமான்கள் பொய்யானவற்றை வெறுக்கிறார்கள்,","poem":1},{"text":"ஆனால் கொடியவர்கள் வெட்கத்தையும்","poem":2},{"lineBreak":true},{"text":"அவமானத்தையும் கொண்டுவருகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"உத்தமமானவர்களை நீதி காத்துக்கொள்ளும்;","poem":1},{"text":"ஆனால் கொடுமையோ பாவிகளை வீழ்த்திப்போடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"சிலர் ஒன்றுமில்லாமல் பணக்காரர்களைப் போல பாசாங்கு செய்வார்கள்;","poem":1},{"text":"வேறுசிலர் அதிக செல்வமிருந்தும் ஏழையைப்போல் பாசாங்கு செய்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"பயமுறுத்தப்படும்போது பணக்காரர் தம் செல்வத்தைத் தந்து அவருடைய வாழ்வை மீட்கலாம்,","poem":1},{"text":"ஆனால் ஏழையோ பயமுறுத்தல் எதையுமே கேள்விப்படுவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"நீதிமான்களின் வெளிச்சம் ஒளிவிட்டுப் பிரகாசிக்கிறது,","poem":1},{"text":"ஆனால் கொடியவர்களின் விளக்கோ அணைக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அகந்தை வாக்குவாதங்களை பிறப்பிக்கிறது,","poem":1},{"text":"ஆனால் புத்திமதியை ஏற்றுக்கொள்கிறவர்களிடத்தில் ஞானம் காணப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"தவறான வழியில் சம்பாதித்த பணம் அழிந்துபோகும்,","poem":1},{"text":"ஆனால் சிறிது சிறிதாக உழைத்துச் சேகரிக்கிறவர்கள் அதை அதிகரிக்கச் செய்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"எதிர்பார்ப்பு நிறைவேறத் தாமதிக்கும்போது, அது இருதயத்தைச் சோர்வுறப்பண்ணும்;","poem":1},{"text":"ஆனால் நிறைவேறிய வாஞ்சையோ ஒரு வாழ்வுதரும் மரம்போலிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"அறிவுரையை ஏளனம் செய்பவர்கள் அதற்குரிய தண்டனையைப் பெறுவார்கள்;","poem":1},{"text":"ஆனால் கட்டளைகளை மதிக்கிறவர்களோ பலனைப் பெறுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஞானமுள்ளவர்களின் போதனை வாழ்வின் நீரூற்று;","poem":1},{"text":"அது மனிதரை மரணக் கண்ணிகளிலிருந்து காப்பாற்றுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"நல்லறிவுள்ளவர்கள் தயவைப் பெறுவார்கள்,","poem":1},{"text":"ஆனால் உண்மையற்றவர்களின் வழி கேடு விளைவிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"விவேகிகள் அறிவுடன் நடந்துகொள்கிறார்கள்;","poem":1},{"text":"ஆனால் மூடர்களோ தங்கள் மூடத்தனத்தை வெளிப்படுத்துகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"கொடிய தூதுவன் தொல்லையில் விழுகிறான்,","poem":1},{"text":"ஆனால் நம்பகமான தூதுவனோ சுகத்தைக் கொண்டுவருகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"அறிவுரையை அலட்சியம் செய்பவர்கள் வறுமையையும் வெட்கத்தையும் அடைகிறார்கள்;","poem":1},{"text":"ஆனால் கண்டித்துத் திருத்துதலை ஏற்றுக்கொள்கிறவர்கள் புகழப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"வாஞ்சை நிறைவேறுவது உள்ளத்திற்கு இனிது,","poem":1},{"text":"ஆனால் தீமையைவிட்டு விலகுவதையோ மூடர் வெறுக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஞானிகளோடு வாழ்கிறவர்கள் ஞானிகளாவார்கள்;","poem":1},{"text":"ஆனால் மூடர்களுக்குத் தோழர்கள் தீங்கு அனுபவிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"பேரழிவு பாவிகளைப் பின்தொடர்கிறது,","poem":1},{"text":"ஆனால் நன்மை நீதிமான்களின் வெகுமதி.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ஒரு நல்ல மனிதர் தன் பிள்ளைகளின் பிள்ளைகளுக்கு பரம்பரை சொத்துக்களை விட்டுச்செல்கிறார்;","poem":1},{"text":"ஆனால் பாவிகளின் செல்வமோ, நீதிமான்களுக்காக சேர்த்து வைக்கப்படுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ஒரு ஏழையின் தரிசு நிலம் உணவை விளைவிக்கலாம்,","poem":1},{"text":"ஆனால் அநீதி அதை அழித்திடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"பிரம்பைக் கையாளாதவர்கள் தன் பிள்ளைகளை வெறுக்கிறார்கள்;","poem":1},{"text":"ஆனால் தன் பிள்ளைகள்மீது அன்பாயிருக்கிறவர்களோ அவர்களை நற்கட்டுப்பாட்டில் நடத்துவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"நீதிமான்கள் தங்கள் உள்ளம் திருப்தியாகுமட்டும் சாப்பிடுவார்கள்;","poem":1},{"text":"ஆனால் கொடியவர்களின் வயிறோ பசியாயிருக்கும்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/12.json","previousChapterAudioLinks":{},"numberOfVerses":25}