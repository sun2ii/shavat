{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":14,"content":[{"type":"verse","number":1,"content":[{"text":"ஞானமுள்ள பெண் தன் குடும்பத்தைக் கட்டுகிறாள்;","poem":1},{"text":"ஆனால் அறிவில்லாதவளோ தன் கைகளினாலேயே அதை இடித்துப்போடுகிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"நேர்மையான வழியில் செல்கிறவர்கள் யெகோவாவுக்குப் பயந்து நடக்கிறார்கள்,","poem":1},{"text":"அவரை அசட்டை பண்ணுகிறவர்கள் தங்கள் வழிகளில் மாறுபாடுள்ளவர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"மூடரின் பெருமையான பேச்சு அவர்களுடைய முதுகுக்கே பிரம்படி;","poem":1},{"text":"ஆனால் ஞானிகளின் உதடுகளோ அவர்களைப் பாதுகாக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"எருதுகள் இல்லாத இடத்தில் களஞ்சியம் வெறுமையாயிருக்கும்;","poem":1},{"text":"ஆனால் எருதின் பலத்தினால் மிகுந்த அறுவடை உண்டு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"மெய்ச்சாட்சிக்காரர் பொய்ப் பேசமாட்டார்கள்,","poem":1},{"text":"ஆனால் பொய்சாட்சிக்காரர் மூச்சுக்கு மூச்சு பொய்ப் பேசுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ஏளனம் செய்பவர்கள் ஞானத்தைத் தேடியும் அதைக் கண்டுபிடிப்பதில்லை,","poem":1},{"text":"ஆனால் பகுத்தறிவு உள்ளவர்களுக்கோ புத்தி இலகுவாக வருகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"மூடரின் வழியைவிட்டு விலகியிரு,","poem":1},{"text":"ஏனெனில் அவர்களுடைய உதடுகளில் நீ அறிவைக் காணமாட்டாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"தங்கள் வழியைக் குறித்து சிந்தித்துப் பார்ப்பதே விவேகிகளின் ஞானம்,","poem":1},{"text":"ஆனால் மூடர்கள் தங்களையே ஏமாற்றிக்கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"பாவத்திற்கு பரிகாரம் செய்வதை மூடர்கள் ஏளனம் செய்கிறார்கள்,","poem":1},{"text":"ஆனால் நீதிமான்களின் மத்தியில்தான் அதற்கு நல்லெண்ணம் காணப்படுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ஒவ்வொரு இருதயத்தின் கசப்பும் அதற்கு மட்டுமே தெரியும்;","poem":1},{"text":"அதின் மகிழ்ச்சியையும் வேறு யாராலும் பகிர்ந்துகொள்ள முடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"கொடியவர்களின் வீடு அழிக்கப்படும்,","poem":1},{"text":"ஆனால் நீதிமான்களின் கூடாரமோ செழித்தோங்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"மனிதனுக்கு சரியெனத் தோன்றும் வழி ஒன்று உண்டு;","poem":1},{"text":"முடிவில் அது மரணத்திற்கே வழிநடத்தும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"சிரிப்பிலும் மனதிற்குத் துக்கமுண்டு;","poem":1},{"text":"மகிழ்ச்சியும்கூட துயரத்தில் முடிவடையலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"பின்வாங்கிப் போகிற இருதயமுள்ளவர்கள் தங்கள் வழிகளுக்கான தண்டனையை முழுமையாக அனுபவிப்பார்கள்;","poem":1},{"text":"நல்லவர்கள் தங்களுடைய வழிகளுக்கான வெகுமதியைப் பெறுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"அறிவில்லாதவர்கள் எதையும் நம்புகிறார்கள்;","poem":1},{"text":"ஆனால் விவேகமுள்ளவர்கள் தங்கள் நடைகளைக் குறித்துக் கவனமாயிருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ஞானமுள்ளவர்கள் யெகோவாவுக்குப் பயந்து, தீமைக்கு விலகி நடக்கிறார்கள்;","poem":1},{"text":"ஆனால் மூடர்கள் மோசமான மனநிலையிலிருந்தும் பாதுகாப்பாய் உணர்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"முன்கோபக்காரன் முட்டாள்தனமான காரியங்களைச் செய்கிறான்;","poem":1},{"text":"தீயத் தந்திரமுள்ளவன் வெறுக்கப்படுகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"அறிவற்றவர்கள் மூடத்தனத்தை உரிமையாக்கிக் கொள்கிறார்கள்;","poem":1},{"text":"ஆனால் விவேகிகளுக்கு அறிவு மகுடமாயிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"தீயவர்கள் நல்லவர்கள் முன்னும்,","poem":1},{"text":"கொடியவர்கள் நீதிமான்களின் வாசல்களிலும் விழுந்து பணிவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஏழைகள் தங்கள் அயலவர்களாலும் வெறுக்கப்படுகிறார்கள்;","poem":1},{"text":"ஆனால் செல்வந்தர்களுக்கோ அநேக சிநேகிதர்கள் உண்டு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"தன் அயலாரை அலட்சியம் செய்வது பாவம்;","poem":1},{"text":"ஏழைகளுக்கு இரங்குகிறவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"தீமைக்காக சதிசெய்கிறவர்கள் வழிதப்பிப் போவார்கள் அல்லவா?","poem":1},{"text":"ஆனால் நன்மையைத் திட்டமிடுபவர்கள் அன்பையும் உண்மையையும் கண்டுகொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"கடும் உழைப்பெல்லாம் இலாபத்தைக் கொண்டுவரும்;","poem":1},{"text":"ஆனால் வெறும் பேச்சோ ஏழ்மைக்கே வழிநடத்தும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ஞானிகளின் செல்வமே அவர்களுக்கு மகுடம்,","poem":1},{"text":"ஆனால் மூடர்களின் மடமை மூடத்தனத்தையே பிறப்பிக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"மெய்ச்சாட்சி உயிர்களைக் காப்பாற்றுகிறது,","poem":1},{"text":"ஆனால் பொய்ச்சாட்சி ஏமாற்றுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடக்கிறவர்களுக்கு ஒரு உறுதியான நம்பிக்கையுண்டு;","poem":1},{"text":"அது அவர்களுடைய பிள்ளைகளுக்கு அடைக்கலம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடப்பதே வாழ்வின் ஊற்று;","poem":1},{"text":"அது மனிதரை மரணக் கண்ணிகளிலிருந்து காப்பாற்றுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"அதிக மக்கட்தொகை அரசனின் மகிமை,","poem":1},{"text":"ஆனால் குடிமக்கள் குறைய இளவரசன் அழிந்துவிடுவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"பொறுமையுள்ளவர் மிகுந்த புரிந்துகொள்ளுதல் உள்ளவர்;","poem":1},{"text":"ஆனால் முற்கோபக்காரர்கள் மூடத்தனத்தை வெளிப்படுத்துகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"மன அமைதி உடலுக்கு சுகத்தைக் கொடுக்கிறது;","poem":1},{"text":"ஆனால் பொறாமை எலும்புகளில் புற்றுநோய் போன்றது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"ஏழைகளை ஒடுக்குகிறவர்கள் அவர்களைப் படைத்தவரை அவமதிக்கிறார்கள்;","poem":1},{"text":"ஆனால் ஏழைகளுக்குத் தயவு பண்ணுகிறவர்கள் இறைவனைக் கனம்பண்ணுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"பேரழிவு வரும்போது கொடியவர்கள் வீழ்ச்சியடைகிறார்கள்;","poem":1},{"text":"ஆனால் நீதிமான்களோ மரணத்திலும் இறைவனில் புகலிடம் தேடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"பகுத்தறிகிறவர்களின் இருதயத்திலே ஞானம் தங்கியிருக்கிறது;","poem":1},{"text":"மூடர்களிடம் அதற்கு வாய்ப்பில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"நீதி ஒரு நாட்டையே உயர்த்தும்,","poem":1},{"text":"ஆனால் பாவம் எந்த மக்களுக்கும் அவமானம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"ஞானமுள்ள பணியாளனால் அரசன் மகிழ்ச்சி அடைகிறான்,","poem":1},{"text":"ஆனால் வெட்கத்திற்குரிய பணியாளன் அரசனின் கடுங்கோபத்திற்கே உள்ளாகிறான்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/13.json","previousChapterAudioLinks":{},"numberOfVerses":35}