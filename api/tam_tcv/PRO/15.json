{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":15,"content":[{"type":"verse","number":1,"content":[{"text":"சாந்தமான பதில் கடுங்கோபத்தைத் தணிக்கும்;","poem":1},{"text":"ஆனால் கடுஞ்சொல்லோ கோபத்தைத் தூண்டுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ஞானியின் நாவு அறிவை பயன்படுத்தும்;","poem":1},{"text":"ஆனால் மூடரின் வாயோ மூடத்தனத்தை வெளிக்காட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவின் கண்கள் எங்கும் நோக்கமாயிருக்கின்றன,","poem":1},{"text":"அவை கொடியவர்களையும் நல்லவர்களையும் உன்னிப்பாய் கவனிக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"சுகத்தைக் கொடுக்கும் நாவு ஒரு வாழ்வுதரும் மரம் போன்றது,","poem":1},{"text":"ஆனால் வஞ்சனையுள்ள நாவோ உள்ளத்தை நொறுக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"மூடர் தமது பெற்றோர் தம்மை நற்கட்டுப்பாடு செய்யும்போது, அதை உதாசீனம் செய்கிறார்கள்;","poem":1},{"text":"ஆனால் கண்டித்துத் திருத்துதலை ஏற்றுக்கொள்பவர்களோ விவேகிகள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நீதிமான்களின் வீட்டில் மிகுந்த செல்வம் உண்டு,","poem":1},{"text":"ஆனால் கொடியவர்களின் வருமானமோ தொல்லையையே கொண்டுவரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஞானியின் உதடுகள் அறிவைப் பரப்பும்,","poem":1},{"text":"ஆனால் மூடர்களின் இருதயங்களோ நேர்மையானதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவா கொடியவர்களின் பலியை அருவருக்கிறார்,","poem":1},{"text":"ஆனால் நீதிமான்களின் ஜெபம் அவரை மகிழ்ச்சியூட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"யெகோவா கொடியவர்களின் வழியை அருவருக்கிறார்,","poem":1},{"text":"ஆனால் அவர் நீதியைப் பின்பற்றுகிறவர்களை நேசிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"வழியைவிட்டு விலகுகிறவர்களுக்கு கடுமையான தண்டனை காத்திருக்கிறது,","poem":1},{"text":"கண்டித்துத் திருத்துதலை வெறுப்பவர்கள் சாவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"பாதளமும் பிரேதக்குழியும் யெகோவாவுக்கு முன்பாக திறந்தவண்ணமாயிருக்க,","poem":1},{"text":"மனுமக்களின் இருதயம் எவ்வளவு வெளியரங்கமாயிருக்கும்!","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"கேலி செய்பவர்கள் திருத்துவதை வெறுக்கிறார்கள்,","poem":1},{"text":"அவர்கள் ஞானமுள்ளவரிடம் ஆலோசனை கேட்கமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"மகிழ்ச்சியுள்ள இருதயம் முகத்தை மலர்ச்சியுடையதாக்கும்;","poem":1},{"text":"ஆனால் இருதயத்தின் வேதனையோ ஆவியை நொறுங்கச்செய்யும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"பகுத்தறியும் இருதயம் அறிவைத் தேடுகிறது,","poem":1},{"text":"ஆனால் மூடரின் வாயோ மூடத்தனத்திலேயே மேய்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ஒடுக்கப்பட்டவர்களின் வாழ்நாட்கள் எல்லாம் அவலமானவை,","poem":1},{"text":"ஆனால் மகிழ்ச்சியான இருதயத்திற்கு எல்லா நாளும் விருந்து.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"அதிக செல்வமும் அதனோடு கலக்கமும் இருப்பதைவிட,","poem":1},{"text":"சிறிதளவு செல்வமும் அதனோடு யெகோவாவுக்குப் பயந்து நடத்தலும் இருப்பது சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"பகையோடு பரிமாறப்படும் நல்ல இறைச்சி உணவைவிட,","poem":1},{"text":"அன்போடு கிடைக்கும் காய்கறி உணவே சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"முற்கோபிகள் சண்டையைத் தூண்டிவிடுகிறார்கள்;","poem":1},{"text":"ஆனால் பொறுமையுள்ளவர்கள் வாக்குவாதத்தை நிறுத்துகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"சோம்பேறியின் வழி முள்வேலியினால் தடைசெய்யப்பட்டிருக்கிறது;","poem":1},{"text":"ஆனால் நீதிமான்களின் வழி நன்கு கட்டமைக்கப்பட்ட சாலையாயிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஞானமுள்ள பிள்ளைகள் தங்கள் தகப்பனுக்கு மகிழ்ச்சியைக் கொண்டுவருகிறார்கள்,","poem":1},{"text":"மதியற்ற மனிதனோ தன்னுடைய தாயை அலட்சியம்பண்ணுகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"புத்தியற்றவர்களுக்கு மூடத்தனம் மகிழ்ச்சியைக் கொடுக்கிறது,","poem":1},{"text":"ஆனால் புரிந்துகொள்ளுதல் உள்ளவர்கள் நேர்வழியில் செல்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ஆலோசனை குறைவுபடுவதால் திட்டங்கள் தோல்வியடையும்,","poem":1},{"text":"அநேகர் ஆலோசித்து செயல்பட்டால் அவை வெற்றிபெறும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"தகுந்த பதில் சொல்வதில் மகிழ்ச்சி கிடைக்கிறது;","poem":1},{"text":"காலத்திற்கு ஏற்ற வார்த்தை எவ்வளவு நலமானது!","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"வாழ்வின் பாதை ஞானமுள்ளவர்களை உன்னதத்திற்கு வழிநடத்துகிறது,","poem":1},{"text":"அது பாதாளத்திற்குப் போகாதபடி அவர்களைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"பெருமையுள்ளவரின் வீட்டை யெகோவா இடித்துப்போடுகிறார்,","poem":1},{"text":"ஆனால் விதவையின் எல்லைகளையோ அவர் பாதுகாக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"கொடியவர்களின் சிந்தனைகளை யெகோவா அருவருக்கிறார்,","poem":1},{"text":"ஆனால் கருணைமிக்க வார்த்தைகள் அவருடைய பார்வையில் தூய்மையானவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"பேராசைக்காரர் தன் குடும்பத்திற்குத் தொல்லையைக் கொண்டுவருகிறார்கள்,","poem":1},{"text":"ஆனால் இலஞ்சத்தை வெறுப்பவர்கள் நல்வாழ்வடைவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"நீதிமான்களின் இருதயம் பதில் சொல்லுமுன் கவனமாக சிந்திக்கிறது,","poem":1},{"text":"ஆனால் கொடியவர்களின் வாய் தீமையைக் கக்குகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"யெகோவா கொடியவர்களுக்குத் தூரமாய் இருக்கிறார்,","poem":1},{"text":"ஆனால் அவர் நீதிமான்களின் ஜெபத்தைக் கேட்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"மகிழ்ச்சியான பார்வை இருதயத்திற்கு மகிழ்ச்சியைக் கொடுக்கிறது;","poem":1},{"text":"நற்செய்தி எலும்புகளுக்குச் சுகத்தைக் கொடுக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"வாழ்வு கொடுக்கும் திருத்துதலைக் கவனமாகக் கேட்கிறவர்கள்","poem":1},{"text":"ஞானிகளோடு குடியிருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"அறிவுரையை உதாசீனம் செய்கிறவர்கள் தங்களையே வெறுக்கிறார்கள்;","poem":1},{"text":"ஆனால் கண்டித்துத் திருத்துதலை ஏற்றுக்கொள்பவர்கள் புரிந்துகொள்ளுதலைப் பெற்றுக்கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடப்பது ஞானத்தைப் போதிக்கிறது,","poem":1},{"text":"கனத்திற்கு முன்பு தாழ்மை.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/14.json","previousChapterAudioLinks":{},"numberOfVerses":33}