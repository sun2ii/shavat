{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":[{"text":"இருதயத்தின் திட்டங்கள் மனிதனுடையவை,","poem":1},{"text":"ஆனால் யெகோவா அவர்களுடைய நாவுகளில் சரியான பதிலைத் தருகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"மனிதர்களுடைய வழிகளெல்லாம் அவர்கள் பார்வைக்கு சுத்தமானதாய் காணப்படும்,","poem":1},{"text":"ஆனால் யெகோவா உள்நோக்கங்களை ஆராய்ந்து பார்க்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"உன் செயல்களையெல்லாம் யெகோவாவுக்கு ஒப்புக்கொடு,","poem":1},{"text":"அப்பொழுது அவர் உனது திட்டங்களை உறுதிப்படுத்துவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவா தம்முடைய நோக்கத்தை நிறைவேற்றவே எல்லாவற்றையும் செய்கிறார்;","poem":1},{"text":"பேரழிவின் நாட்களுக்காக கொடியவர்களையும் வைத்திருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இருதயத்தில் பெருமையுள்ள எல்லோரையும் யெகோவா அருவருக்கிறார்;","poem":1},{"text":"அவர்கள் தண்டனைக்குத் தப்பமாட்டார்கள் என்பது நிச்சயம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அன்பினாலும் உண்மையினாலும் பாவம் நிவிர்த்தியாகும்;","poem":1},{"text":"யெகோவாவுக்குப் பயந்து நடப்பது தீமையைவிட்டு விலகச் செய்யும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஒருவனுடைய வழி யெகோவாவுக்கு பிரியமானதாயிருந்தால்,","poem":1},{"text":"அவனுடைய எதிரிகளும் அவனோடு சமாதானமாகும்படிச் செய்வார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அநியாயமாய்ப் பெறும் அதிக இலாபத்தைவிட,","poem":1},{"text":"நீதியாய்ப் பெறும் கொஞ்சமே சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"மனிதர் தம் வழியை இருதயத்தில் திட்டமிடுகிறார்கள்;","poem":1},{"text":"ஆனால் அவர்களுடைய காலடிகளை யெகோவாவே தீர்மானிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அரசனின் பேச்சு இறைவாக்குப் போலிருக்கிறது;","poem":1},{"text":"அவனுடைய தீர்ப்புகள் நீதிக்குத் துரோகம் செய்யக்கூடாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"நீதியான அளவுகோலும் தராசும் யெகோவாவினுடையது;","poem":1},{"text":"பையில் இருக்கும் எல்லா படிக்கற்களும் அவரால் உண்டானது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அநியாயம் செய்வதை அரசர்கள் அருவருக்கிறார்கள்,","poem":1},{"text":"ஏனெனில் நீதியினாலேயே சிங்காசனம் நிறுவப்பட்டது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"நீதியான உதடுகளின் வார்த்தைகள் அரசர்களுக்கு மகிழ்ச்சி;","poem":1},{"text":"உண்மை பேசுபவர்களை அவர்கள் விரும்புகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"அரசனின் கடுங்கோபமோ மரண தூதனைப் போன்றது,","poem":1},{"text":"ஆனால் ஞானிகள் அதை சாந்தப்படுத்துவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"அரசனின் முகம் மலர்ச்சியடையும்போது, அது நல்வாழ்வைக் கொடுக்கிறது;","poem":1},{"text":"அவருடைய தயவு வசந்தகால மழை மேகம் போன்றது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"தங்கத்தைவிட ஞானத்தைப் பெறுவதும்","poem":1},{"text":"வெள்ளியைவிட மெய்யறிவைப் பெறுவதும் எவ்வளவு சிறந்தது!","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நீதிமான்களின் பெரும்பாதை தீமைக்கு விலகிப்போகிறது;","poem":1},{"text":"தங்கள் வழியைக் காத்துக்கொள்கிறவர்கள் தங்கள் வாழ்வைக் காத்துக்கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"அழிவுக்கு முன்னால் அகந்தை வருகிறது;","poem":1},{"text":"வீழ்ச்சிக்கு முன்னால் மனமேட்டிமை வருகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"பெருமையுள்ளவர்களுடன் கொள்ளைப்பொருட்களைப் பகிர்ந்து கொள்வதைவிட,","poem":1},{"text":"சிறுமைப்பட்டவர்களுடன் மனத்தாழ்மையுடன் இருப்பதே சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"அறிவுரைகளை ஏற்றுக்கொள்பவர்கள் வாழ்வடைவார்கள்,","poem":1},{"text":"யெகோவாவிடம் நம்பிக்கையாயிருப்பவர்கள் ஆசீர்வதிக்கப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"இருதயத்தில் ஞானமுள்ளவர்கள் பகுத்தறிவுள்ளவர்கள்;","poem":1},{"text":"இனிமையான வார்த்தைகள் மக்களை கற்றுக்கொள்ளத் தூண்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"விவேகத்தை உடையவர்களுக்கு அது வாழ்வின் ஊற்றைப் போலிருக்கிறது,","poem":1},{"text":"ஆனால் மூடத்தனம் மூடர்களுக்குத் தண்டனையைக் கொடுக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ஞானமுள்ள இருதயத்திலிருந்து ஞானமுள்ள வார்த்தைகள் வெளிப்படும்,","poem":1},{"text":"அவர்களுடைய உதட்டின் பேச்சு அறிவுரைகளைக் கேட்கத் தூண்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"கருணையான வார்த்தைகள் தேன்கூட்டைப்போல்","poem":1},{"text":"ஆத்துமாவுக்கு இனிமையாயும், எலும்புகளுக்கு சுகமாயுமிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"மனிதனுக்கு சரியெனத் தோன்றும் வழி ஒன்று உண்டு;","poem":1},{"text":"முடிவில் அது மரணத்திற்கே வழிநடத்தும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"தொழிலாளிகளின் பசியே அவர்கள் வேலைசெய்யக் காரணமாயிருக்கிறது,","poem":1},{"text":"அவர்களைத் தொடர்ந்து வேலைசெய்யத் தூண்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"இழிவானவர்கள் தீமையைச் சூழ்ச்சி செய்கிறார்கள்,","poem":1},{"text":"அவர்களுடைய பேச்சோ சுட்டுப் பொசுக்கும் நெருப்பைப் போலிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"வஞ்சகர்கள் பிரிவினையைத் தூண்டிவிடுகிறார்கள்,","poem":1},{"text":"கோள் சொல்கிறவர்கள் நெருங்கிய நண்பர்களையும் பிரித்துவிடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"வன்முறையாளர்கள் தங்கள் அயலாரை ஏமாற்றி,","poem":1},{"text":"தீயவழியில் அவர்களை நடத்துகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"கண்களை மூடிக்கொண்டு வஞ்சகத்தைத் திட்டமிடுகிறார்கள்;","poem":1},{"text":"தங்கள் உதடுகளைத் திறவாமல் தீமை செய்யவே தேடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"நரைமுடி மேன்மையின் மகுடம்,","poem":1},{"text":"அது நீதியின் வாழ்க்கையினால் பெற்றுக்கொண்டது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"பொறுமையுள்ளவன் ஒரு போர்வீரனைவிட சிறந்தவன்;","poem":1},{"text":"தன் கோபத்தை அடக்குகிறவன் ஒரு பட்டணத்தைக் கைப்பற்றுகிறவனைவிடச் சிறந்தவன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"சீட்டு மடியிலே போடப்படும்,","poem":1},{"text":"ஆனால் அதைத் தீர்மானிப்பது யெகோவா.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/15.json","previousChapterAudioLinks":{},"numberOfVerses":33}