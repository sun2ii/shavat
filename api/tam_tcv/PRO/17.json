{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":17,"content":[{"type":"verse","number":1,"content":[{"text":"சண்டை நடக்கும் ஒரு வீட்டின் நிறைவான விருந்தைவிட,","poem":1},{"text":"சமாதானத்துடன் அமைதியாய் சாப்பிடும் காய்ந்த அப்பத்துண்டே சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"விவேகமுள்ள வேலைக்காரன் அவமானத்தைக் கொண்டுவருகிற மகனை ஆளுவான்,","poem":1},{"text":"பின்பு அந்த வேலைக்காரன் குடும்பத்தில் ஒருவனைப்போல் சகோதரருடைய உரிமைச் சொத்திலும் பங்குபெறுவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"வெள்ளியை உலைக்கலமும் தங்கத்தை சூளையும் சோதிக்கும்,","poem":1},{"text":"ஆனால் இருதயத்தை சோதிக்கிறவர் யெகோவா.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"கொடியவர்கள் தீமையான பேச்சை ஆர்வமாய்க் கேட்கிறார்கள்;","poem":1},{"text":"பொய்ப் பேசுபவர்கள் அவதூறைப் பேசும் நாவைக் கவனித்துக் கேட்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஏழைகளை ஏளனம் செய்பவர்கள் அவர்களை படைத்தவரையே அவமதிக்கிறார்கள்;","poem":1},{"text":"பிறரின் துன்பத்தைக் கண்டு மகிழ்பவர்கள் தண்டனைக்குத் தப்புவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"பிள்ளைகளின் பிள்ளைகள் முதியோருக்கு மகுடம்;","poem":1},{"text":"பிள்ளைகளுக்குப் பெருமை அவர்களின் பெற்றோர்களே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"சொல்திறமைமிக்க உதடுகள் மூடர்களுக்குப் பொருத்தமற்றது;","poem":1},{"text":"அப்படியானால் பொய்பேசும் உதடுகள் ஆளுநருக்கு எவ்வளவு கேவலமானது!","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"இலஞ்சத்தைக் கொடுப்பவனுக்கு அது வசியம் போலிருக்கிறது;","poem":1},{"text":"அவன் செல்லும் இடமெல்லாம் வெற்றி என நினைக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"குற்றத்தை மன்னிக்கிறவர்கள் அன்பை தேடுகிறார்கள்;","poem":1},{"text":"ஆனால் குற்றத்தை மீண்டும் நினைப்பூட்டுகிறவர்கள் நெருங்கிய நண்பர்களையும் பிரித்துவிடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"மூடருக்கு நூறு அடி கொடுப்பதைவிட","poem":1},{"text":"பகுத்தறிகிறவர்களை வார்த்தையினால் கண்டிப்பதே பயனளிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"தீமை செய்பவர்கள் கலகத்தையே தேடுகிறார்கள்;","poem":1},{"text":"அழிவின் தூதனால் அவர்கள் கடுமையாக தண்டிக்கப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"தன் மூடத்தனத்தில் சிக்கிய முட்டாளைச் சந்திப்பதைவிட,","poem":1},{"text":"தன் குட்டியைப் பறிகொடுத்த கரடியைச் சந்திப்பது சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஒருவர் நன்மைக்குப் பதில் தீமை செய்தால்,","poem":1},{"text":"அவருடைய வீட்டைவிட்டு தீமை ஒருபோதும் விலகாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"வாக்குவாதத்தைத் தொடங்குவது அணையை உடைத்துவிடுவது போலாகும்;","poem":1},{"text":"எனவே விவாதம் ஏற்படும் முன்பே அதைவிட்டு விலகு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"குற்றவாளியை விடுதலை செய்கிறதும் குற்றமற்றவரை தண்டனைக்கு உள்ளாக்குகிறதுமான","poem":1},{"text":"இரண்டையும் யெகோவா அருவருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"மூடர் கையில் பணம் இருந்து என்ன பயன்?","poem":1},{"text":"ஞானத்தைப் பெற்றுக்கொள்ள அவர்களுக்கு மனமில்லையே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நண்பன் எக்காலத்திலும் அன்பாயிருக்கிறான்;","poem":1},{"text":"இக்கட்டு காலத்தில் உதவி செய்யவே சகோதரன் பிறந்திருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"மதியீனர் கடனுக்காக உத்திரவாதம் கொடுத்து,","poem":1},{"text":"தன் அயலாரின் கடன்களுக்கான பாதுகாப்பு உறுதியளிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"வாக்குவாதத்தை விரும்புகிறவர்கள் பாவத்தை விரும்புகிறார்கள்;","poem":1},{"text":"வாசலை உயர்த்திக் கட்டுகிறவர்கள் அழிவையே அழைக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"தீமையான இருதயமுள்ளவர்கள் நன்மையைக் காண்பதில்லை;","poem":1},{"text":"பொய் நாவுள்ளவர்கள் துன்பத்தில் வீழ்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"முட்டாளைப் பெற்றவருக்கு வருத்தம்;","poem":1},{"text":"இறைவனற்ற மதியீனரின் பெற்றோருக்கு மகிழ்ச்சியில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"மகிழ்ச்சியான இருதயம் நல்ல மருந்து,","poem":1},{"text":"ஆனால் நொறுங்கிய ஆவி எலும்புகளை உலரப்பண்ணுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"கொடியவர்கள் இரகசியமாக இலஞ்சம் வாங்கி,","poem":1},{"text":"நீதியின் வழியைப் புரட்டுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"பகுத்தறிவு உள்ளவர்கள் ஞானத்தில் கண்ணோக்கமாய் இருப்பார்கள்;","poem":1},{"text":"ஆனால் மூடரின் கண்களோ பூமியின் கடைசிவரை அலைகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"மதிகெட்ட பிள்ளையால் தன் தந்தைக்குத் துன்பமும்,","poem":1},{"text":"தன்னைப் பெற்றவளுக்குக் கசப்பும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"குற்றமற்றவரைத் தண்டிப்பது நல்லதல்ல,","poem":1},{"text":"உத்தமமான அதிகாரிகளை தண்டிப்பதும் நல்லதல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"அறிவுள்ளவர்கள் வார்த்தைகளை அடக்குகிறார்கள்;","poem":1},{"text":"புரிந்துகொள்ளுதல் உள்ளவர்கள் சாந்தமாயிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"அமைதியாக இருந்தால், மூடரும் ஞானமுள்ளவர் என்று எண்ணப்படுவர்;","poem":1},{"text":"தன் நாவை அடக்கினால் புத்திமான்களாகவும் தோன்றுவார்கள்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/16.json","previousChapterAudioLinks":{},"numberOfVerses":28}