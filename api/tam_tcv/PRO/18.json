{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":18,"content":[{"type":"verse","number":1,"content":[{"text":"நட்புணர்வு இல்லாதவர்கள் சுயநலத்தையே தேடுகிறார்கள்,","poem":1},{"text":"அவர்கள் எல்லாவித சரியான நிதானிப்புகளையும் எதிர்த்து விவாதிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"மூடர்கள் விளங்கிக்கொள்வதில் மகிழ்ச்சி கொள்வதில்லை,","poem":1},{"text":"ஆனால் தங்கள் சொந்த அபிப்பிராயங்களை வெளிப்படுத்துவதில் மட்டும் பெருமகிழ்ச்சியடைகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"கொடுமை வரும்போது அவமதிப்பும் வரும்,","poem":1},{"text":"வெட்கத்துடன் அவமானமும் வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"வாயின் வார்த்தைகள் ஆழமான கடல்,","poem":1},{"text":"ஆனால் ஞானத்தின் ஊற்று பாய்ந்தோடும் நீரோடை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"கொடியவர்களுக்கு பாரபட்சம் காட்டுவதும்,","poem":1},{"text":"குற்றமில்லாதவர்களுக்கு நீதியை வழங்க மறுப்பதும் நல்லதல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"மதியீனர்கள் பேச ஆரம்பித்தால் வாக்குவாதம் பிறக்கும்,","poem":1},{"text":"அவர்களுடைய வாயே அடிவாங்க வைக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"மதியீனருடைய வாய் அவர்களுக்கு அழிவு;","poem":1},{"text":"அவர்களுடைய உதடுகளோ அவர்களுடைய வாழ்விற்கு கண்ணி.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"புறங்கூறுகிறவர்களின் வார்த்தைகள் சுவையான உணவைப் போன்றவை;","poem":1},{"text":"அவை மனிதருடைய உள்ளத்தின் ஆழத்தில் பதிந்துவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"தன்னுடைய வேலையில் சோம்பலாய் இருப்பவன்","poem":1},{"text":"அழிப்பவனுக்குச் சகோதரன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவாவினுடைய பெயர் பலமான கோபுரம்;","poem":1},{"text":"நீதிமான்கள் அதற்குள் ஓடி பாதுகாப்பாய் இருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"பணக்காரர்களின் செல்வம் அவர்களுடைய அரணான பட்டணம்;","poem":1},{"text":"அதை அவர்கள் பாதுகாப்பான சுவரென்று எண்ணுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"வீழ்ச்சிக்கு முன்னால் இருதயம் பெருமையடைகிறது,","poem":1},{"text":"ஆனால் மேன்மைக்கு முன்பு மனத்தாழ்மை வருகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"கவனித்துக் கேட்குமுன் பதில் சொல்வது,","poem":1},{"text":"முட்டாள்தனமாகவும் வெட்கமாகவும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"மனவலிமையால் நோயுற்ற உடலைத் தாங்கமுடியும்;","poem":1},{"text":"மனம் உடைந்தால் யாரால் சகிக்கமுடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"பகுத்தறியும் இருதயம் அறிவைச் சம்பாதிக்கிறது;","poem":1},{"text":"ஞானமுள்ளவர்களின் காதுகள் அறிவை நாடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"அன்பளிப்பு அதைக் கொடுப்பவர்களுக்கு வழி திறக்கிறது;","poem":1},{"text":"அது அவர்களை உயர்ந்தோருக்கு முன்பாகக் கொண்டுவருகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"வழக்கில் எதிரி வந்து விசாரணை செய்யும் வரையே","poem":1},{"text":"முதலில் பேசுபவர்கள் நியாயமானவர்கள்போல் காணப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"சீட்டுப்போடுதல் சச்சரவுகளைத் தீர்க்கும்,","poem":1},{"text":"வலுவான எதிரிகளுக்கு இடையில் அது சிக்கலைத் தீர்க்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"அரண்சூழ்ந்த பட்டணத்தைக் கைப்பற்றுவதைப் பார்க்கிலும், மனதைப் புண்படுத்திய சகோதரனை சமாதானப்படுத்துவது கடினம்;","poem":1},{"text":"விவாதங்கள் தாழ்ப்பாள் இடப்பட்ட கோட்டை வாசலைப் போலிருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"அவரவர் வாயின் பலனால் அவர்களுடைய வயிறு நிரம்பும்;","poem":1},{"text":"அவர்களின் உதட்டின் வார்த்தைகளால் அவர்கள் திருப்தியடையலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"வாழ்வும் சாவும் நாவின் சொற்களில் இருக்கிறது;","poem":1},{"text":"நற்சொற்களை நேசிப்பவர்கள் அதின் பலனைச் சாப்பிடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"மனைவியைப் பெறுகிறவன் நன்மையைப் பெற்றுக்கொள்கிறான்;","poem":1},{"text":"அவன் யெகோவாவிடத்தில் தயவையும் பெறுவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ஏழைகள் இரக்கத்திற்காக கெஞ்சுகிறார்கள்;","poem":1},{"text":"ஆனால் பணக்காரர்களோ கடுமையாகப் பதிலளிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"நம்பக்கூடாத நண்பர்கள் விரைவில் அழிவைக் கொண்டுவருவார்கள்;","poem":1},{"text":"ஆனால் சகோதரனைவிட நெருங்கிய நண்பரும் உண்டு.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/17.json","previousChapterAudioLinks":{},"numberOfVerses":24}