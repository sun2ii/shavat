{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":19,"content":[{"type":"verse","number":1,"content":[{"text":"வஞ்சக உதடுகளுள்ள மூடரைப் பார்க்கிலும்,","poem":1},{"text":"குற்றமற்றவராய் நடக்கிற ஏழையே சிறந்தவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அறிவில்லாமல் எதையாவது பற்றி வைராக்கியம் கொள்வது நல்லதல்ல;","poem":1},{"text":"அவசரப்பட்டால் வழிதவறி விடுவது எவ்வளவு நிச்சயம்!","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ஒருவருடைய மூடத்தனமே அவருடைய வாழ்க்கையை பாழாக்குகிறது;","poem":1},{"text":"ஆனாலும் அவர்களுடைய இருதயமோ யெகோவாவுக்கு எதிராகக் கோபம்கொள்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"செல்வம் அநேக நண்பர்களைக் கொண்டுவரும்;","poem":1},{"text":"ஆனால் ஏழைகளை நெருங்கிய நண்பரும் கைவிடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"பொய்ச்சாட்சி சொல்பவர் தண்டனைக்குத் தப்பமாட்டார்கள்;","poem":1},{"text":"பொய்யைத் தாராளமாய்ப் பேசுபவரும் தப்பமுடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ஆளுநரின் தயவைப் பெற அநேகர் நாடுகின்றனர்;","poem":1},{"text":"அன்பளிப்பு கொடுப்பவருக்கு அனைவரும் நண்பர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஏழைகளின் உறவினர்கள் அவர்களை வெறுக்கிறார்கள்,","poem":1},{"text":"அவர்களுடைய சிநேகிதர்கள் எவ்வளவு அதிகமாய் அவர்களைப் புறக்கணிப்பார்கள்!","poem":2},{"text":"ஏழைகளோ அவர்களிடம் கெஞ்சினாலும்,","poem":1},{"text":"அவர்களுடைய நண்பர்கள் போய்விடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஞானத்தைப் பெறுகிறவர் தன் வாழ்வை நேசிக்கிறார்கள்,","poem":1},{"text":"புரிந்துகொள்ளுதலைக் காப்பவர்கள் நன்மையடைவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"பொய்ச்சாட்சி சொல்பவர் தண்டனைக்குத் தப்பமாட்டார்கள்;","poem":1},{"text":"பொய்யைத் தாராளமாய்ப் பேசுபவரும் தப்பமுடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ஆடம்பர வாழ்வு மதியீனருக்குத் தகுந்ததல்ல;","poem":1},{"text":"ஒரு அடிமை இளவரசர்களை ஆட்சி செய்வது எவ்வளவு மோசமானது!","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ஒருவருடைய ஞானம் அவருக்கு பொறுமையைக் கொடுக்கிறது;","poem":1},{"text":"குற்றத்தைப் பொருட்படுத்தாமல் இருப்பது அவர்களுக்கு மகிமை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அரசனின் கடுங்கோபம் ஒரு சிங்கத்தின் கெர்ச்சிப்புக்குச் சமானம்;","poem":1},{"text":"ஆனால் அவனுடைய தயவோ புல்லின்மேலுள்ள பனியைப்போலிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"மதிகெட்ட மகன் தன் தகப்பனுக்கு அழிவு;","poem":1},{"text":"வாக்குவாதம் செய்யும் மனைவி,","poem":2},{"lineBreak":true},{"text":"ஓட்டைக் கூரையிலிருந்து ஓயாமல் ஒழுகும் நீரைப்போல் இருக்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"வீடுகளும் செல்வமும் பெற்றோரிடமிருந்து உரிமைச்சொத்தாய் கிடைக்கின்றன;","poem":1},{"text":"ஆனால் விவேகமுள்ள மனைவியோ யெகோவாவிடமிருந்து கிடைக்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"சோம்பல் ஆழ்ந்த நித்திரையைக் கொண்டுவரும்.","poem":1},{"text":"வேலைசெய்ய மறுப்பவர்கள் பசியாயிருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"கட்டளைகளுக்குக் கீழ்ப்படிகிறவர்கள் தங்கள் வாழ்வைக் காத்துக்கொள்கிறார்கள்;","poem":1},{"text":"ஆனால் தங்கள் வழிகள்மேல் கவனமாயிராதவர்கள் சாவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ஏழைக்கு உதவுகிறவர்கள் யெகோவாவுக்குக் கடன் கொடுக்கிறார்கள்,","poem":1},{"text":"அவர்கள் உதவியதற்கு சரியாக அவர்களுக்கு திரும்பக் கொடுப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"உன் பிள்ளைகள் திருந்துவார்கள் என்ற நம்பிக்கை இருக்கும்போதே கண்டித்துத் திருத்து;","poem":1},{"text":"இல்லாவிட்டால் நீ அவர்களின் வாழ்க்கை அழிய காரணமாகி விடுவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"முற்கோபமுள்ள மனிதர் தனக்குரிய தண்டனையைப் பெறவேண்டும்;","poem":1},{"text":"அவரைத் தப்புவித்தால், திரும்பவும் தப்புவிக்க வேண்டிவரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஆலோசனையைக் கேட்டு ஒழுக்கத்தை ஏற்றுக்கொள்;","poem":1},{"text":"முடிவில் நீ ஞானமுள்ளவராவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"மனிதனின் இருதயத்தின் திட்டங்கள் அநேகம்;","poem":1},{"text":"ஆனாலும் யெகோவாவின் நோக்கமே நிறைவேறுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"எல்லோரும் நேர்மையான அன்பையே விரும்புகிறார்கள்;","poem":1},{"text":"பொய்யராய் இருப்பதைவிட ஏழையாய் இருப்பது சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடப்பது வாழ்விற்கு வழிநடத்தும்;","poem":1},{"text":"அவ்வாறு இருந்தால் பிரச்சனை இல்லாமல், மனநிறைவுடன் இருக்கலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"சோம்பேறிகள் தங்கள் கையில் உணவை எடுத்துக்கொள்வார்கள்;","poem":1},{"text":"ஆனால் அதைத் தங்கள் வாய்க்குக்கூட கொண்டுபோகமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"ஏளனம் செய்பவர்களுக்கு அடி கிடைக்கும், அப்பொழுது அறிவற்றவர்கள் விவேகத்தைக் கற்றுக்கொள்வார்கள்;","poem":1},{"text":"பகுத்தறிவுள்ளவர்களைக் கடிந்துகொள், அவர்கள்மேலும் அறிவைப் பெறுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"தங்கள் தகப்பனின் பொருட்களை அபகரித்து,","poem":1},{"text":"தங்கள் தாயைத் துரத்திவிடுகிறார்கள் வெட்கமும் அவமானமும் கொண்டுவருகிற பிள்ளைகள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"என் பிள்ளையே, நீ அறிவுரைகளைக் கேட்பதை நிறுத்தினால்,","poem":1},{"text":"அறிவுள்ள வார்த்தைகளிலிருந்து விலகிப்போவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"சீர்கெட்ட சாட்சி நீதியைக் கேலி செய்கிறது,","poem":1},{"text":"கொடியவர்களின் வாயோ தீமையை விழுங்குகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"ஏளனம் செய்வோருக்கு தண்டனையும்,","poem":1},{"text":"மூடருடைய முதுகிற்கு அடிகளும் ஆயத்தமாயிருக்கிறது.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/18.json","previousChapterAudioLinks":{},"numberOfVerses":29}