{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["ஞானத்தினால் வரும் நன்மைகள்"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, ஞானத்திற்கு உன் செவிசாய்த்து,","poem":1},{"text":"புரிந்துகொள்ளுதலில் உன் இருதயத்தைச் செலுத்தி,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீ என் ஞானத்தை ஏற்றுக்கொண்டு,","poem":1},{"text":"என் கட்டளைகளை உன் உள்ளத்தில் சேர்த்துவை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உண்மையில், நீ நுண்ணறிவுக்காக வேண்டுதல்செய்து,","poem":1},{"text":"புரிந்துகொள்ளுதலுக்காக மன்றாடி,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"சுத்த வெள்ளியைத் தேடுவதுபோல் தேடி,","poem":1},{"text":"புதையலை ஆராய்வதுபோல அதை ஆராய்ந்தால்,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அப்பொழுது நீ யெகோவாவுக்குப் பயந்து நடப்பதைக் குறித்து விளங்கிக்கொள்வாய்;","poem":1},{"text":"இறைவனைப்பற்றிய அறிவைக் கண்டுகொள்வாய்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஏனெனில் யெகோவாவே ஞானத்தைத் தருபவர்;","poem":1},{"text":"அறிவும் விவேகமும் அவருடைய வாயிலிருந்தே வருகின்றன.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் நீதிமான்களுக்கு வெற்றியைக் கொடுத்து,","poem":1},{"text":"குற்றமற்றவர்களாய் நடப்பவர்களுக்கு அவர் கேடயமாயிருந்து,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர் நியாயத்தின் வழியைக் காத்துக்கொள்கிறார்;","poem":1},{"text":"தமக்கு உண்மையாய் இருப்பவர்களின் வழியைப் பாதுகாக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"அப்பொழுது நீ நேர்மை, நீதி, நியாயம் ஆகியவற்றையும்","poem":1},{"text":"ஒவ்வொரு நல்ல வழியையும் விளங்கிக்கொள்வாய்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஞானம் உன் உள்ளத்திற்குள் வரும்,","poem":1},{"text":"அறிவு உன் ஆத்துமாவிற்கு இன்பமாயிருக்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அறிவுடைமை உன்னைப் பாதுகாக்கும்,","poem":1},{"text":"புரிந்துகொள்ளுதல் உன்னைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ஞானம் கொடிய மனிதர்களின் வழிகளிலிருந்தும்,","poem":1},{"text":"வஞ்சகமான வார்த்தைகளைப் பேசும் மனிதர்களிடமிருந்தும் உன்னைக் காப்பாற்றும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் நேர்மையான வழியைவிட்டு விலகி,","poem":1},{"text":"இருளான வழியில் நடக்கிறார்கள்;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்கள் அநியாயம் செய்வதில் மகிழ்ச்சியடைந்து,","poem":1},{"text":"தீமையின் வஞ்சனையில் சந்தோஷப்படுகிறார்கள்;","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர்களுடைய செயல்களோ நேர்மையற்றவை,","poem":1},{"text":"அவர்களுடைய வழிகளோ தவறானவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ஞானம் உன்னை விபசாரியிடமிருந்தும்","poem":1},{"text":"வசப்படுத்தும் வார்த்தைகள் பேசும் ஒழுக்கங்கெட்ட பெண்ணிடமிருந்தும் காப்பாற்றும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"தன் இளவயதின் கணவனைக் கைவிட்டு,","poem":1},{"text":"இறைவனுக்கு முன்பாக தான் செய்த திருமண உடன்படிக்கையை புறக்கணித்தவள் அவள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவளுடைய வீடு மரணத்திற்கு உன்னை வழிநடத்துகிறது,","poem":1},{"text":"அவளுடைய பாதைகள் மரித்தவர்களிடம் கூட்டிச்செல்கிறது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவளிடம் செல்பவர்கள் யாரும் திரும்புவதில்லை,","poem":1},{"text":"வாழ்வின் பாதைகளை அடைவதுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"இப்படியிருக்க, நீ நல்ல மனிதரின் வழியில் நடப்பாயாக,","poem":1},{"text":"நீதிமான்களின் பாதைகளையும் கைக்கொள்வாயாக.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஏனெனில் நீதிமான்கள் நாட்டில் வாழ்வார்கள்,","poem":1},{"text":"குற்றமற்றோர் அதில் நிலைத்திருப்பார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஆனால் கொடியவர்கள் நாட்டிலிருந்து அகற்றப்படுவார்கள்,","poem":1},{"text":"துரோகிகள் அதிலிருந்து எறியப்படுவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}