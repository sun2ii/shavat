{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":[{"text":"திராட்சைரசம் கேலிசெய்ய வைக்கும், மதுபானம் போதையை உண்டாக்கும்;","poem":1},{"text":"அதினால் வழிதவறுகிறவர்கள் ஞானிகளல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அரசனின் கடுங்கோபம் சிங்கத்தின் கெர்ச்சிப்பைப் போலிருக்கிறது;","poem":1},{"text":"அரசனைக் கோபமூட்டுகிறவர்கள் தங்கள் உயிரை இழப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"சண்டையைத் தவிர்த்துக்கொள்வது மனிதனுக்கு மேன்மை;","poem":1},{"text":"ஒவ்வொரு முட்டாளும் சண்டையிட விரைகின்றனர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"சோம்பேறி ஏற்றகாலத்தில் நிலத்தை உழுவதில்லை;","poem":1},{"text":"அதினால் அறுவடைக்காலத்தில் அவர்கள் கேட்டும் உணவு கிடைப்பதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"மனிதருடைய இருதயத்தின் நோக்கங்கள் ஆழமான நீர்நிலைகள்;","poem":1},{"text":"மெய்யறிவுள்ளவர்களே அதை வெளியே கொண்டுவருவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அநேகர் தங்களை நேர்மையான அன்புள்ளவர் என்று சொல்லிக்கொள்வார்கள்;","poem":1},{"text":"ஆனால் ஒரு உண்மையுள்ள மனிதரை யாரால் கண்டுபிடிக்க முடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நீதிமான்கள் குற்றமற்ற வாழ்க்கையை நடத்துகிறார்கள்;","poem":1},{"text":"அவர்களுக்குப் பிற்பாடு அவர்களுடைய பிள்ளைகள் ஆசீர்வதிக்கப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"நியாயத்தீர்ப்புக்காக அரசன் சிங்காசனத்தில் அமரும்போது,","poem":1},{"text":"அவன் தன் கண்களினாலேயே தீமையான யாவையும் பிரித்துவிடுவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“நான் எனது இருதயத்தைத் தூய்மையாக வைத்திருக்கிறேன்;","poem":1},{"text":"நான் பாவமின்றி சுத்தமாய் இருக்கிறேன்” என யாரால் சொல்லமுடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"பொய்யான எடைக் கற்கள், சமமற்ற அளவைகள்","poem":1},{"text":"ஆகிய இவ்விரண்டையும் யெகோவா அருவருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"சிறுபிள்ளைகளானாலும், அவர்களுடைய நடத்தை","poem":1},{"text":"தூய்மையும் நேர்மையுமானதா என்று அவர்களுடைய செயல்களை வைத்து சொல்லலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"கேட்கும் காதுகள், பார்க்கும் கண்கள்","poem":1},{"text":"ஆகிய இரண்டையும் யெகோவாவே உண்டாக்கியிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"தூக்கத்தை விரும்பாதே, நீ ஏழையாவாய்;","poem":1},{"text":"விழிப்பாயிரு, அப்பொழுது திருப்தியான உணவைப் பெறுவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"பொருட்களை வாங்குபவர்கள், “இது நல்லதல்ல, இது நல்லதல்ல!” எனச் சொல்கிறார்கள்;","poem":1},{"text":"வாங்கிய பின்போ அவர்கள் போய் தான் வாங்கிய திறமையைப் பற்றிப் புகழ்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"தங்கமும் உண்டு, பவளங்களும் நிறைவாய்க் கிடைக்கும்;","poem":1},{"text":"ஆனால் அறிவைப் பேசும் உதடுகளோ அரிதாய்க் கிடைக்கும் மாணிக்கக்கல்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"பிறரின் கடனுக்காக உத்திரவாதம் செய்பவரின் பாதுகாப்புக்காக உடையை எடுத்துக்கொள்;","poem":1},{"text":"வெளியாளுக்காக அதைச் செய்திருந்தால், அதையே அடைமானமாக வைத்துக்கொள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"மோசடியினால் பெறும் உணவு சுவையாக இருக்கும்;","poem":1},{"text":"ஆனால் முடிவில் அது வாயில் இட்ட மண்ணாகவே இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"நல்ல ஆலோசனையினால் திட்டங்கள் உறுதிப்படும்;","poem":1},{"text":"ஆகையால் நீ யுத்தத்திற்குப் போகுமுன் ஞானமுள்ள அறிவுரைகளைப் பெற்றுக்கொள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"புறங்கூறுபவர்கள் இரகசியங்களை வெளிப்படுத்துகிறார்கள்;","poem":1},{"text":"ஆகையால் வாயாடிகளை விட்டு விலகியிரு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஒருவன் தகப்பனையோ தாயையோ அவமதித்தால்,","poem":1},{"text":"கடும் இருட்டில் அவன் விளக்கு அணைந்துவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ஆரம்பத்திலேயே மிகத் துரிதமாகக் கிடைத்த சொத்து,","poem":1},{"text":"முடிவில் ஆசீர்வாதமாயிருக்காது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“பழிக்குப்பழி வாங்குவேன்!” என்று நீ சொல்லாதே;","poem":1},{"text":"யெகோவாவுக்குக் காத்திரு, அவர் உன்னை விடுவிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"போலியான எடைக் கற்களை பயன்படுத்துவோரை யெகோவா அருவருக்கிறார்;","poem":1},{"text":"போலித் தராசுகளை பயன்படுத்துவது முறையானதல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"மனிதரின் காலடிகளை யெகோவாவே நடத்துகிறார்;","poem":1},{"text":"அப்படியிருக்க ஒருவரால் தனது சொந்த வழியை எப்படி விளங்கிக்கொள்ள முடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"முன்யோசனையின்றி ஏதாவது ஒன்றை இறைவனுக்கு பொருத்தனை செய்துவிட்டு,","poem":1},{"text":"பின்பு அதைப்பற்றி யோசிப்பது மனிதனுக்குக் கண்ணியாயிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ஞானமுள்ள அரசன் கொடியவர்களை பிரித்தெடுக்கிறான்;","poem":1},{"text":"பின்பு அரசன் அவர்களை கடுமையாகத் தண்டிக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"மனிதருடைய ஆவி","poem":1},{"noteId":0},{"text":"யெகோவா தந்த விளக்கு;","poem":1},{"text":"அது உள்ளத்தின் ஆழத்தையும் ஆராய்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"அன்பும் உண்மையும் அரசனைக் காப்பாற்றுகிறது;","poem":1},{"text":"அன்பினால் அவனுடைய சிங்காசனம் நிலைக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"வாலிபரின் மகிமை அவர்களின் பெலன்;","poem":1},{"text":"முதியோரின் அனுபவத்தின் நரைமுடி அவர்களின் மேன்மை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"அடிகளும் காயங்களும் தீமையை அகற்றும்;","poem":1},{"text":"பிரம்படிகள் உள்ளத்தின் ஆழத்தைச் சுத்திகரிக்கும்.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":0,"caller":"+","text":"மனிதருடைய ஆவி அல்லது மனிதனின் வார்த்தைகள்","reference":{"chapter":20,"verse":27}}]},"thisChapterLink":"/api/tam_tcv/PRO/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/19.json","previousChapterAudioLinks":{},"numberOfVerses":30}