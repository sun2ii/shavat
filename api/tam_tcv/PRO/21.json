{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":[{"text":"அரசனுடைய இருதயம் யெகோவாவின் கரத்தில் நீரோடைகளைப் போலிருக்கின்றது;","poem":1},{"text":"அவர் அதைத் தாம் விரும்பியவர்களிடம் நடத்துகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"மனிதனுடைய வழியெல்லாம் அவனுக்குச் சரியானதாகவே தோன்றும்,","poem":1},{"text":"ஆனால் யெகோவா இருதயத்தின் சிந்தனைகளை சோதித்து அறிகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"பலி செலுத்துவதைப் பார்க்கிலும்,","poem":1},{"text":"நியாயத்தையும் நீதியையும் செய்வதே யெகோவாவுக்கு விருப்பம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"கொடியவர்களின் உழாத நிலம் என்பது,","poem":1},{"text":"அவர்களின் பாவத்தை உண்டாக்கும் அகந்தையான பார்வையும் பெருமையான இருதயமுமே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவசரச்செயல் வறுமையைக் கொடுப்பது நிச்சயம்,","poem":1},{"text":"அதுபோலவே கடின உழைப்புள்ளவர்களின் திட்டங்கள் இலாபத்தைக் கொடுப்பதும் நிச்சயம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"பொய் சொல்லி சம்பாதிக்கும் செல்வம்,","poem":1},{"text":"பறந்து செல்லும் நீராவியாயும் மரணக் கண்ணியாயும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"கொடியவர்கள் நியாயஞ்செய்ய மறுப்பதால்,","poem":1},{"text":"அவர்களின் வன்முறை அவர்களையே வாரிச்செல்லும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"குற்றவாளிகளின் வழி கோணலானது,","poem":1},{"text":"ஆனால் குற்றமற்றவர்களின் நடத்தையோ நேர்மையானது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"சண்டைக்கார மனைவியுடன் வீட்டில் ஒன்றாய் வாழ்வதைவிட,","poem":1},{"text":"கூரையின் மூலையில் தனித்து வாழ்வது சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"கொடியவர்கள் தீமையை விரும்புகிறார்கள்;","poem":1},{"text":"தமக்கு அடுத்திருப்போரை இரக்கத்தோடு பார்க்கமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ஏளனம் செய்பவர்கள் தண்டிக்கப்படும்போது, அறிவற்றவர்கள் ஞானத்தைப் பெற்றுக்கொள்கிறார்கள்;","poem":1},{"text":"ஞானமுள்ளவர்களுக்குப் போதிக்கும்போது, அவர்கள் அறிவைப் பெற்றுக்கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"நீதிபரரான இறைவன் கொடியவர்களின் வீட்டைக் கவனித்துப் பார்த்து,","poem":1},{"text":"கொடியவர்களை தண்டிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஏழைகளின் அழுகைக்குச் செவிகொடுக்காதவர்களுக்கு","poem":1},{"text":"தாங்கள் அழும்பொழுது பதில் கிடைக்காது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"இரகசியமாய் கொடுக்கும் அன்பளிப்பு கோபத்தைத் தணிக்கும்;","poem":1},{"text":"அங்கியில் மறைத்துக் கொடுக்கும் இலஞ்சம் கடுஞ்சீற்றத்தைக் குறைக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"நீதி செய்யப்படும்போது, அது நீதிமான்களுக்கு மகிழ்ச்சியைக் கொடுக்கிறது,","poem":1},{"text":"ஆனால் தீயவர்களுக்கு பயமுண்டாக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"விவேகத்தின் பாதையைவிட்டு விலகிச்செல்பவர்கள்,","poem":1},{"text":"முடிவில் இறந்தவர்களின் கூட்டத்தில் சேருவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"சிற்றின்பத்தை தேடுகிறவர்கள் ஏழையாவார்கள்;","poem":1},{"text":"திராட்சைரசத்தையும் ஆடம்பரத்தையும் விரும்புகிறவர்கள் ஒருபோதும் செல்வந்தராவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"கொடியவர்கள் நீதிமான்களையும்,","poem":1},{"text":"துரோகிகள் நேர்மையுள்ளவர்களையும் மீட்கும் பணயப் பொருளாவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"சண்டைக்காரியும் கோபக்காரியுமான மனைவியுடன் வாழ்வதைவிட,","poem":1},{"text":"பாலைவனத்தில் வாழ்வது சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"சிறந்த உணவும் எண்ணெயும் ஞானமுள்ளோர் வீட்டில் இருக்கும்;","poem":1},{"text":"மூடர்களோ எல்லாவற்றையும் தின்று குடித்து அழித்துவிடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"நீதியாகவும் அன்பாகவும் இருக்க விரும்புகிறவர்கள்,","poem":1},{"text":"வாழ்வையும் செழிப்பையும், மதிப்பையும் பெறுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"ஞானமுள்ளவர்கள் பலவான்களின் பட்டணத்தைத் தாக்கி,","poem":1},{"text":"அவர்கள் நம்பியிருக்கும் கோட்டையையும் இடித்துப் போடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"தங்கள் வாயையும் நாவையும் காத்துக்கொள்கிறவர்கள்","poem":1},{"text":"பேரழிவிலிருந்து தங்களைக் காத்துக்கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"அகந்தையும் இறுமாப்பும் உள்ளவர்களுக்கு, “ஏளனக்காரர்கள்” என்று பெயர்,","poem":1},{"text":"அவர்கள் எல்லையற்ற ஆணவத்துடன் நடந்துகொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"சோம்பேறியின் கைகள் வேலைசெய்ய மறுப்பதால்,","poem":1},{"text":"அவர்களின் ஆசையினால் அவர்கள் அழிவார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவர்களுடைய பேராசை நாளுக்குநாள் அதிகரித்துக் கொண்டேயிருக்கிறது;","poem":1},{"text":"ஆனால் நீதிமான்களோ, தாராளமாய்க் கொடுத்துக்கொண்டே இருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"கொடியவர்கள் செலுத்தும் பலி அருவருப்பானது;","poem":1},{"text":"அது தீயநோக்கத்துடன் செலுத்தப்படுமானால், அது இன்னும் எவ்வளவு அதிக அருவருப்பாயிருக்கும்!","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"பொய்ச்சாட்சி கூறுபவர்கள் அழிந்துபோவார்கள்;","poem":1},{"text":"ஆனால் கவனமாய்க் கேட்பவர்கள் வெற்றிகரமாக சாட்சியளிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"கொடியவர்கள் தங்களைத் துணிச்சல்காரர்களாய் காண்பிக்கிறார்கள்;","poem":1},{"text":"ஆனால் நேர்மையுள்ளவர்கள் தங்கள் வழிகளைச் சிந்தித்துப் பார்க்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"யெகோவாவுக்கு எதிராக வெற்றியளிக்கக்கூடிய","poem":1},{"text":"ஞானமோ, நுண்ணறிவோ, திட்டமோ எதுவும் இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"போரின் நாளுக்காக குதிரை ஆயத்தமாக்கப்பட்டிருக்கிறது,","poem":1},{"text":"ஆனால் வெற்றியோ யெகோவாவினுடையது.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/20.json","previousChapterAudioLinks":{},"numberOfVerses":31}