{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":22,"content":[{"type":"verse","number":1,"content":[{"text":"அதிக செல்வத்தைவிட நற்பெயரே விரும்பத்தக்கது;","poem":1},{"text":"வெள்ளியையும் தங்கத்தையும்விட நன்மதிப்பைப் பெறுவதே சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"பணக்காரனையும் ஏழையையும் யெகோவாவே படைத்தார்;","poem":1},{"text":"இதுவே அவர்களுக்கிடையில் உள்ள பொதுத்தன்மை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"விவேகிகள் ஆபத்தைக் கண்டு மறைந்துகொள்கிறார்கள்;","poem":1},{"text":"ஆனால் அறிவற்றவர்களோ பார்க்காமல் நேராகப்போய் துன்பத்தை அனுபவிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடப்பதே தாழ்மை,","poem":1},{"text":"செல்வத்துக்கும் கனத்திற்கும் நீண்ட ஆயுளுக்கும் தாழ்மை வழிநடத்துகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"கொடியவர்களின் பாதைகளில் முட்களும் கண்ணிகளும் இருக்கும்;","poem":1},{"text":"ஆனால் தன் ஆத்துமாவைக் காத்துக்கொள்கிறவர்கள் அவற்றிலிருந்து தூரமாய் விலகுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"பிள்ளைகளை அவர்கள் நடக்கவேண்டிய சரியான வழியில் பயிற்றுவி;","poem":1},{"text":"அவர்கள் பெரியவர்களாகும்போது, அதைவிட்டு விலகமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"பணக்காரர்கள் ஏழைகளை ஆளுகிறார்கள்,","poem":1},{"text":"கடன்வாங்கினவர்கள் கடன் கொடுத்தவருக்கு அடிமை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அநீதியை விதைக்கிறவர்கள் தொல்லையை அறுவடை செய்வார்கள்,","poem":1},{"text":"அவர்களுடைய கடுங்கோபமே அவர்களை அழிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"தாராள மனமுள்ளவர்கள் ஆசீர்வதிக்கப்படுவார்கள்;","poem":1},{"text":"ஏனெனில் தங்கள் உணவை ஏழைகளுடன் பகிர்ந்துகொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ஏளனம் செய்பவர்களைத் துரத்திவிடு, அப்பொழுது சண்டை நின்றுவிடும்;","poem":1},{"text":"வாக்குவாதங்களும் நிந்தனைகளும் முடிவடையும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"தூய்மையான இருதயத்தை விரும்புகிறவர்களும் தயவான வார்த்தையைப் பேசுகிறவர்களும்","poem":1},{"text":"அரசனைத் தங்கள் நண்பனாக்கிக் கொள்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவாவின் கண்கள் அறிவுள்ளவர்களைக் காக்கிறது,","poem":1},{"text":"ஆனால் துரோகிகளின் திட்டங்களை அவர் அழிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“வீதியிலே சிங்கம் நிற்கிறது! நான் வெளியே போனால் தெருவிலே கொல்லப்பட்டு விடுவேன்!”","poem":1},{"text":"என்று சோம்பேறி சொல்லிக்கொள்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"விபசாரியின் வாய் ஒரு ஆழமான குழி;","poem":1},{"text":"யெகோவாவின் கோபத்திற்கு உள்ளானவர்கள் அதில் போய் விழுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"பிள்ளையின் இருதயத்தில் மூடத்தனம் இருக்கிறது,","poem":1},{"text":"ஆனால் கண்டித்துத் திருத்துவதால் அதை அகற்றலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"தன் செல்வத்தைப் பெருக்குவதற்கு ஏழைகளை ஒடுக்குகிறவர்களும்,","poem":1},{"text":"செல்வந்தர்களுக்கு அன்பளிப்பு கொடுக்கிறவர்களும் ஏழையாகிறார்கள்.","poem":2}]},{"type":"heading","content":["பழமொழி 1"]},{"type":"verse","number":17,"content":[{"text":"ஞானிகளின் வார்த்தைகளுக்குச் செவிகொடுத்து, அவற்றைக் கவனத்தில்கொள்,","poem":1},{"text":"நான் போதிக்கும் அறிவை உன் இருதயத்தில் பதித்து வை.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஏனெனில் அவைகளை உன் இருதயத்தில் வைத்து,","poem":1},{"text":"அவற்றை உன் உதடுகளில் ஆயத்தமாய் வைத்துக்கொள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"உன் நம்பிக்கை யெகோவாவின்மேல் இருக்கவேண்டும் என்பதற்காகவே","poem":1},{"text":"இன்று இவற்றை நான் உனக்குப் போதிக்கிறேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அறிவையும் ஆலோசனையையும் கொடுக்கும் மேன்மையான","poem":1},{"text":"முப்பது முதுமொழிகளை நான் உனக்கு எழுதவில்லையா?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அது உனக்கு உண்மையும் நம்பகமுமான வார்த்தைகளைப் போதித்திருக்கிறது;","poem":1},{"text":"எனவே நீ உன்னை அனுப்பியவனுக்கு","poem":2},{"lineBreak":true},{"text":"தகுந்த பதிலைக் கொடுக்கலாம்.","poem":2}]},{"type":"heading","content":["பழமொழி 2"]},{"type":"verse","number":22,"content":[{"text":"ஏழைகளாய் இருக்கிறார்கள் என்பதற்காக நீ ஏழைகளைச் சுரண்டாதே;","poem":1},{"text":"அவர்களை நீதிமன்றத்தில் சிறுமைப்படுத்தாதே.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஏனெனில் யெகோவா அவர்களுக்காக வழக்காடி,","poem":1},{"text":"அவர்களின் உயிரை வாங்கப் பார்க்கிறவர்களின் உயிரை அவர் பறித்துக்கொள்வார்.","poem":2}]},{"type":"heading","content":["பழமொழி 3"]},{"type":"verse","number":24,"content":[{"text":"கோபக்காரனுடன் நட்புகொள்ளாதே,","poem":1},{"text":"கடுங்கோபியோடு கூட்டாளியாய் இராதே.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஏனெனில் ஒருவேளை நீயும் அவனுடைய வழிகளைக் கற்றுக்கொண்டு,","poem":1},{"text":"உன்னை கண்ணியில் சிக்க வைத்துக்கொள்ளலாம்.","poem":2}]},{"type":"heading","content":["பழமொழி 4"]},{"type":"verse","number":26,"content":[{"text":"பிறரின் கடனுக்காக ஒருபோதும் பொறுப்பேற்றுக் கொள்ளாதே;","poem":1},{"text":"மற்றவருடைய கடனுக்காக அடைமானம் கொடுப்பவராயும் இராதே.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ஒருவேளை உனக்கு அதைச் செலுத்த வழியில்லாமற்போனால்,","poem":1},{"text":"உன் படுக்கையும்கூட உன்னிடமிருந்து பறித்துக்கொள்ளப்படும்.","poem":2}]},{"type":"heading","content":["பழமொழி 5"]},{"type":"verse","number":28,"content":[{"text":"உன் முற்பிதாக்கள் நாட்டிய","poem":1},{"text":"பூர்வகாலத்து எல்லைக் கல்லை நகர்த்தாதே.","poem":2}]},{"type":"heading","content":["பழமொழி 6"]},{"type":"verse","number":29,"content":[{"text":"தன்னுடைய வேலையில் திறமையுள்ளவர்களை நீ காண்கிறாயா?","poem":1},{"text":"அவர்கள் அரசர்களுக்குமுன் பணிசெய்வார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் பிரபலமற்றவர்களுக்கு முன்பாக பணிசெய்வதில்லை.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/21.json","previousChapterAudioLinks":{},"numberOfVerses":29}