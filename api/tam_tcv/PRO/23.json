{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":23,"content":[{"type":"heading","content":["பழமொழி 7"]},{"type":"verse","number":1,"content":[{"text":"ஒரு ஆளுநருடன் உணவு சாப்பிட உட்காரும்போது,","poem":1},{"text":"உனக்குமுன் இருப்பவற்றை","poem":2},{"noteId":1},{"text":"நன்றாகக் கவனித்துப்பார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீ உணவுப் பிரியனாயிருந்தால்,","poem":1},{"text":"உன் தொண்டையில் கத்தி இருப்பதாக நினைத்துக்கொள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவனுடைய சுவைமிக்க உணவுகளில் ஆசைப்படாதே;","poem":1},{"text":"அது உன்னை ஏமாற்றக்கூடும்.","poem":2}]},{"type":"heading","content":["பழமொழி 8"]},{"type":"verse","number":4,"content":[{"text":"நீ செல்வந்தனாகும்படி உன்னை வருத்தாதே;","poem":1},{"text":"உன் புத்திசாலித்தனத்தை நம்பாதே.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கண் இமைக்கும் நேரத்தில் செல்வம் மறைந்துவிடும்,","poem":1},{"text":"அவை இறக்கைகள் முளைத்து,","poem":2},{"lineBreak":true},{"text":"கழுகுபோல் ஆகாயத்தில் பறந்துவிடும்.","poem":2}]},{"type":"heading","content":["பழமொழி 9"]},{"type":"verse","number":6,"content":[{"text":"கஞ்சத்தனமுள்ளவர்களுடைய உணவைச் சாப்பிடாதே,","poem":1},{"text":"அவர்களுடைய சுவைமிக்க உணவுகளில் ஆசைப்படாதே;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஏனெனில் அவர்கள் எப்பொழுதும் எவ்வளவு செலவு செய்கிறார்களென்று சிந்திக்கிறார்கள்.","poem":1},{"text":"“சாப்பிடுங்கள், குடியுங்கள்”","poem":2},{"text":"என்று அவர்கள் உனக்குச் சொல்வார்கள்;","poem":1},{"text":"ஆனால் அவர்கள் அதை மனதாரச் சொல்லவில்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீ சாப்பிட்ட கொஞ்சத்தையும் வாந்தியெடுக்க நேரிடும்,","poem":1},{"text":"நீ அவர்களைப் பாராட்டிய வார்த்தைகளும் வீணாய்ப் போகும்.","poem":2}]},{"type":"heading","content":["பழமொழி 10"]},{"type":"verse","number":9,"content":[{"text":"நீ மூடர்களுடன் பேசாதே,","poem":1},{"text":"ஏனெனில் அவர்கள் உன் ஞானமான வார்த்தைகளை ஏளனம் செய்வார்கள்.","poem":2}]},{"type":"heading","content":["பழமொழி 11"]},{"type":"verse","number":10,"content":[{"text":"பூர்வகால எல்லைக் கல்லை நகர்த்தாதே;","poem":1},{"text":"தந்தையற்றவர்களின் நிலங்களை கொஞ்சம் கொஞ்சமாக அபகரித்துக்கொள்ளாதே.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஏனெனில் அவர்களை பாதுகாக்கிறவர் வல்லவர்;","poem":1},{"text":"அவர் உனக்கெதிராக அவர்கள் சார்பாக வழக்காடுவார்.","poem":2}]},{"type":"heading","content":["பழமொழி 12"]},{"type":"verse","number":12,"content":[{"text":"நீ அறிவுறுத்தலுக்கு உன் இருதயத்தைச் சாய்;","poem":1},{"text":"அறிவுள்ள வார்த்தைகளுக்கு செவிகொடு.","poem":2}]},{"type":"heading","content":["பழமொழி 13"]},{"type":"verse","number":13,"content":[{"text":"பிள்ளையைத் தண்டித்துத் திருத்தாமல் விடாதே;","poem":1},{"text":"அவர்களைப் பிரம்பினால் தண்டித்தால், அவர்கள் சாகமாட்டார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நீ அவர்களைப் பிரம்பினால் தண்டித்து,","poem":1},{"text":"அவர்களை மரணத்தினின்று காப்பாற்று.","poem":2}]},{"type":"heading","content":["பழமொழி 14"]},{"type":"verse","number":15,"content":[{"text":"என் மகனே, உன் இருதயம் ஞானமுள்ளதாயிருந்தால்,","poem":1},{"text":"உண்மையில் என் இருதயம் மகிழ்ச்சியடையும்;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"உனது உதடுகள் நீதியானவற்றைப் பேசும்போது,","poem":1},{"text":"என் உள்ளம் மகிழும்.","poem":2}]},{"type":"heading","content":["பழமொழி 15"]},{"type":"verse","number":17,"content":[{"text":"நீ உன் இருதயத்தைப் பாவிகள்மேல் பொறாமைகொள்ள விடாதே,","poem":1},{"text":"எப்பொழுதும் யெகோவாவுக்குப் பயந்து நடக்க வைராக்கியமாயிரு.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அப்பொழுது உனக்கு எதிர்கால நம்பிக்கை நிச்சயமாகவே உண்டு,","poem":1},{"text":"உனது எதிர்பார்ப்பும் வீண்போகாது.","poem":2}]},{"type":"heading","content":["பழமொழி 16"]},{"type":"verse","number":19,"content":[{"text":"என் மகனே, சொல்வதைக் கவனமாய்க் கேட்டு ஞானமுள்ளவனாயிரு,","poem":1},{"text":"உன் இருதயத்தைச் சரியான பாதையில் பதித்துக்கொள்:","poem":2}]},{"type":"verse","number":20,"content":[{"text":"திராட்சை மதுவைக் குடிப்பவர்களோடும்,","poem":1},{"text":"மாம்சப் பெருந்தீனிக்காரரோடும் நீ சேராதே.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஏனெனில் குடிகாரர்களும், உணவுப்பிரியர்களும் ஏழைகள் ஆவார்கள்;","poem":1},{"text":"போதை மயக்கம் அவர்களுக்குக் கந்தைத் துணிகளையே உடுத்துவிக்கும்.","poem":2}]},{"type":"heading","content":["பழமொழி 17"]},{"type":"verse","number":22,"content":[{"text":"உனக்கு வாழ்வு கொடுத்த உன் தந்தைக்குச் செவிகொடு;","poem":1},{"text":"உன் தாய் வயது சென்றவளாயிருக்கும்போது அவளை இழிவாகக் கருதாதே.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"சத்தியத்தை வாங்கு, அதை விற்காதே;","poem":1},{"text":"ஞானத்தையும், அறிவுரையையும், மெய்யறிவையும் பெற்றுக்கொள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நீதிமானாகிய பிள்ளையின் தந்தை பெருமகிழ்ச்சியடைகிறான்;","poem":1},{"text":"ஞானமுள்ள பிள்ளையை உடையவன் அதில் சந்தோஷப்படுகிறான்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உன் தந்தையும் தாயும் மகிழ்ந்திருப்பார்களாக;","poem":1},{"text":"உன்னைப் பெற்றவள் பெருமகிழ்ச்சியடைவாளாக!","poem":2}]},{"type":"heading","content":["பழமொழி 18"]},{"type":"verse","number":26,"content":[{"text":"என் மகனே, உன் இருதயத்தை எனக்குக் கொடு;","poem":1},{"text":"உன் கண்கள் என் வழிகளைப் பின்பற்றுவதில் மகிழட்டும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ஏனெனில் விபசாரி ஒரு ஆழமான படுகுழி;","poem":1},{"text":"ஒழுக்கங்கெட்ட மனைவி மிக ஒடுக்கமான கிணறு.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவள் ஒரு கொள்ளைக்காரனைப்போல் பதுங்கிக் காத்திருக்கிறாள்;","poem":1},{"text":"மனிதர்களுக்குள் உண்மையற்றவர்களைப் பெருகப்பண்ணுகிறாள்.","poem":2}]},{"type":"heading","content":["பழமொழி 19"]},{"type":"verse","number":29,"content":[{"text":"யாருக்கு வேதனை? யாருக்குத் துயரம்?","poem":1},{"text":"யாருக்கு சண்டை? யாருக்கு பிதற்றுதல்?","poem":2},{"lineBreak":true},{"text":"யாருக்குத் தேவையற்ற காயங்கள்? யாருக்கு இரத்தச் சிவப்பான கண்கள்?","poem":2}]},{"type":"verse","number":30,"content":[{"text":"திராட்சைமது குடிப்பதிலேயே நேரத்தைக் கழிப்பவர்களுக்கும்,","poem":1},{"text":"எப்பொழுதும் கலப்பு மதுவைத் தேடித் திரிபவர்களுக்குமே.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"மது சிவப்பாய் இருக்கும்போதும்,","poem":1},{"text":"கிண்ணத்தில் பளபளக்கும் போதும் அதைப் பார்த்து மகிழாதே;","poem":2},{"lineBreak":true},{"text":"அது மிருதுவாய் இறங்கும்போதும் மகிழ்ச்சி கொள்ளாதே!","poem":2}]},{"type":"verse","number":32,"content":[{"text":"முடிவில் அது பாம்பைப்போல் கடிக்கும்;","poem":1},{"text":"விரியன் பாம்பைப்போல் நஞ்சைக் கக்கும்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அப்பொழுது உனது கண்கள் விசித்திரமான காட்சிகளைக் காணும்,","poem":1},{"text":"உனது மனம் குழப்பமானவற்றைக் கற்பனை செய்யும்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"நீ நடுக்கடலின்மேல் படுத்திருப்பவனைப் போலவும்,","poem":1},{"text":"கப்பலின் பாய்மரத்தில் படுத்து நித்திரை செய்பவனைப்போலவும் உணருவாய்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"“அவர்கள் என்னை அடித்தார்கள், எனக்கு நோகவில்லை!","poem":1},{"text":"அவர்கள் என்னைத் தாக்கினார்கள்,","poem":2},{"text":"நான் அதை உணரவில்லை!","poem":1},{"text":"இன்னும் ஒருமுறை குடிப்பதற்கு நான் எப்பொழுது எழும்புவேன்?” என்று நீ சொல்வாய்.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"உனக்குமுன் இருப்பவற்றை அல்லது இருப்பவர்களை","reference":{"chapter":23,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/PRO/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/22.json","previousChapterAudioLinks":{},"numberOfVerses":35}