{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":24,"content":[{"type":"heading","content":["பழமொழி 20"]},{"type":"verse","number":1,"content":[{"text":"கொடியவர்கள்மேல் பொறாமை கொள்ளாதே;","poem":1},{"text":"அவர்களுடன் கூட்டுச்சேர விரும்பாதே.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஏனெனில் அவர்கள் இருதயம் மற்றவர்களைக் காயப்படுத்தத் திட்டமிடுகின்றன,","poem":1},{"text":"அவர்களுடைய உதடுகள் கலகம் விளைவிப்பதையே பேசும்.","poem":2}]},{"type":"heading","content":["பழமொழி 21"]},{"type":"verse","number":3,"content":[{"text":"ஞானத்தால் வீடு கட்டப்பட்டு","poem":1},{"text":"புரிந்துகொள்ளுதலினால் அது நிலைநாட்டப்படுகிறது;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அறிவினால் அதின் அறைகள்,","poem":1},{"text":"அபூர்வமான அழகிய பொருட்களால் நிரப்பப்படுகின்றன.","poem":2}]},{"type":"heading","content":["பழமொழி 22"]},{"type":"verse","number":5,"content":[{"text":"ஞானமுள்ளவன் மிகுந்த வல்லமையுடையவன்,","poem":1},{"text":"அறிவுள்ளவன் தன் பெலத்தை பெருக்குகிறான்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"போர் செய்ய வழிநடத்துதல் தேவை,","poem":1},{"text":"வெற்றிபெற அநேக ஆலோசகர்கள் தேவை.","poem":2}]},{"type":"heading","content":["பழமொழி 23"]},{"type":"verse","number":7,"content":[{"text":"ஞானம் மூடனுக்கு எட்டாத உயரத்திலுள்ளது;","poem":1},{"text":"பட்டண வாசலில் கூடும் சபையில் சொல்வதற்கு அவனுக்கு ஒன்றும் இல்லை.","poem":2}]},{"type":"heading","content":["பழமொழி 24"]},{"type":"verse","number":8,"content":[{"text":"தீமையான சூழ்ச்சி செய்பவன்","poem":1},{"text":"சதிகாரன் என அழைக்கப்படுவான்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மூடரின் திட்டங்கள் பாவமாகும்,","poem":1},{"text":"ஏளனம் செய்பவர்களை மனிதர் வெறுக்கிறார்கள்.","poem":2}]},{"type":"heading","content":["பழமொழி 25"]},{"type":"verse","number":10,"content":[{"text":"துன்ப காலத்தில் நீ மனம் சோர்ந்துபோனால்,","poem":1},{"text":"உன் பெலன் எவ்வளவு குறைவானது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"மரணத்திற்கு வழிநடத்தப்படுகிறவர்களைத் தப்புவி;","poem":1},{"text":"கொல்லப்பட களத்துக்குக் கொண்டுசெல்லப்படுகிறவர்களைக் காப்பாற்று.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“எங்களுக்கு அதைப்பற்றி ஒன்றும் தெரியாது” என்று நீங்கள் சொல்வீர்களானால்,","poem":1},{"text":"இருதயங்களை ஆராய்ந்து பார்க்கிற இறைவன் அதைக் காணமாட்டாரோ?","poem":2},{"text":"உங்கள் வாழ்வைக் காக்கிறவர் அதை அறியாமலிருப்பாரோ?","poem":1},{"text":"ஒவ்வொருவருக்கும் அவர்கள் செய்வதற்குத் தக்கதாய் அவர் பதில்செய்யாமல் விடுவாரோ?","poem":2}]},{"type":"heading","content":["பழமொழி 26"]},{"type":"verse","number":13,"content":[{"text":"என் மகனே, நீ தேனைச் சாப்பிடு; அது நல்லது;","poem":1},{"text":"கூட்டிலிருந்து ஒழுகும் தேன் நீ சுவைப்பதற்கு இனிமையாயிருக்கும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அதேபோல் ஞானமும் உன் ஆத்துமாவிற்கு இனிமையானது என்று அறிந்துகொள்:","poem":1},{"text":"அதை நீ தெரிந்துகொண்டால் உனக்கு எதிர்கால நம்பிக்கை உண்டு,","poem":2},{"lineBreak":true},{"text":"உன் எதிர்பார்ப்பு வீண்போகாது.","poem":2}]},{"type":"heading","content":["பழமொழி 27"]},{"type":"verse","number":15,"content":[{"text":"நீ ஒரு திருடனைப்போல் நீதிமானின் வீட்டிற்கு எதிராகப் பதுங்கிக் காத்திருக்காதே;","poem":1},{"text":"அவனுடைய வீட்டைக் கொள்ளையடிக்காதே.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஏனெனில் நீதிமான் ஏழுமுறை விழுந்தாலும், அவன் எழுந்திருப்பான்;","poem":1},{"text":"ஆனால் கொடியவர்களோ பேராபத்தினால் வீழ்த்தப்படுவார்கள்.","poem":2}]},{"type":"heading","content":["பழமொழி 28"]},{"type":"verse","number":17,"content":[{"text":"உன் பகைவன் விழும்போது நீ ஏளனம் செய்து மகிழாதே;","poem":1},{"text":"அவன் தடுமாறும்போது, உன் இருதயத்தில் சந்தோஷமடையாதே.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நீ மகிழ்ந்தால் யெகோவா அதைக்கண்டு","poem":1},{"text":"அவன்மேலிருக்கும் தன் கோபத்தை விலக்கி உன்மேல் மனவருத்தமடைவார்.","poem":2}]},{"type":"heading","content":["பழமொழி 29"]},{"type":"verse","number":19,"content":[{"text":"தீமையானவர்களைக் குறித்து எரிச்சலடையாதே,","poem":1},{"text":"கொடியவர்கள்மேல் பொறாமை கொள்ளாதே.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ஏனெனில் தீய மனிதனுக்கு எதிர்காலத்தைப் பற்றிய நம்பிக்கை இல்லை;","poem":1},{"text":"கொடியவர்களின் விளக்கோ அணைந்துபோகும்.","poem":2}]},{"type":"heading","content":["பழமொழி 30"]},{"type":"verse","number":21,"content":[{"text":"என் மகனே, யெகோவாவுக்கும் அரசனுக்கும் பயந்து நட,","poem":1},{"text":"கலகக்காரர்களுடன் நீ சேராதே.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஏனெனில், திடீரென அவர்களுக்கு அழிவு வரும்,","poem":1},{"text":"யெகோவாவும் அரசனும் எத்தகைய பேரழிவை அனுப்புவார்கள் என்று யாருக்குத் தெரியும்?","poem":2}]},{"type":"verse","number":23,"content":["ஞானிகளின் கூடுதலான பழமொழிகள் என்னவெனில்:",{"text":"நியாயத்தீர்ப்பில் பாரபட்சம் காட்டுவது நல்லதல்ல:","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"குற்றவாளியைப் பார்த்து, “நீ குற்றமில்லாதவன்” எனச் சொல்பவனை மக்கள் சபிப்பார்கள்,","poem":1},{"text":"நாடுகள் அனைத்தும் அவனை வெறுப்பார்கள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஆனால் குற்றவாளியைக் கடிந்துகொள்கிறவனுக்கு நலமுண்டாகும்,","poem":1},{"text":"அவர்கள்மேல் மிகுந்த ஆசீர்வாதம் பெருகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"நேர்மையான பதில்","poem":1},{"text":"உதடுகளில் கொடுக்கும் முத்தத்தைப் போலிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"உன் வெளிவேலைகளை ஒழுங்குபடுத்தி,","poem":1},{"text":"உன் வயல்வெளிகளை ஆயத்தப்படுத்து;","poem":2},{"lineBreak":true},{"text":"அதின்பின், உனது வீட்டைக் கட்டு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"காரணமின்றி உன் அயலானுக்கு விரோதமாக சாட்சி கூறாதே;","poem":1},{"text":"பொய்களை சொல்ல உன் உதடுகளை நீ பயன்படுத்தலாமா?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“அவன் எனக்குச் செய்ததுபோல நானும் அவனுக்குச் செய்வேன்” என்றோ,","poem":1},{"text":"“அவன் செய்ததற்குத் தக்கதாக நானும் அவனைத் தண்டிப்பேன்” என்றோ நீ ஒருபோதும் சொல்லாதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"நான் சோம்பேறியின் வயலைக் கடந்து சென்றேன்;","poem":1},{"text":"புத்தியில்லாதவனின் திராட்சைத் தோட்டத்தையும் கடந்து சென்றேன்;","poem":2}]},{"type":"verse","number":31,"content":[{"text":"அதெல்லாம் முள்ளுக்காடாக இருந்தது;","poem":1},{"text":"தரையெங்கும் களைகள் நிறைந்திருந்தன,","poem":2},{"lineBreak":true},{"text":"தோட்டத்தின் கற்சுவரும் இடிந்து கிடந்தது.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"நான் பார்த்ததை என் இருதயத்தில் சிந்தித்தேன்;","poem":1},{"text":"அப்பொழுது நான் கண்டதிலிருந்து ஒரு பாடத்தைக் கற்றுக்கொண்டேன்:","poem":2}]},{"type":"verse","number":33,"content":[{"text":"கொஞ்சம் நித்திரை செய்வேன், கொஞ்சம் தூங்குவேன்,","poem":1},{"text":"கொஞ்சம் என் கைகளை மடித்து ஓய்வெடுப்பேன் என்பாயானால்,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"வறுமை கொள்ளைக்காரனைப்போல் உன்மேல் வரும்;","poem":1},{"text":"பற்றாக்குறை ஆயுதம் தாங்கிய முரடனைப்போல உன்னைத் தாக்கும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/23.json","previousChapterAudioLinks":{},"numberOfVerses":34}