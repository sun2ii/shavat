{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":25,"content":[{"type":"verse","number":1,"content":["யூதாவின் அரசனான எசேக்கியாவின் மனிதர்கள் தொகுத்த சாலொமோனின் நீதிமொழிகள்:"]},{"type":"verse","number":2,"content":[{"text":"காரியங்களை மறைப்பது இறைவனின் மகிமை;","poem":1},{"text":"ஆராய்ந்து அறிவதோ அரசனுக்கு மகிமை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"வானங்கள் உயரமாயும் பூமி ஆழமாயும் இருப்பதுபோல்,","poem":1},{"text":"அரசர்களின் இருதயங்களும் ஆராய்ந்து அறிய முடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"வெள்ளியிலிருந்து மாசை அகற்று,","poem":1},{"text":"அப்பொழுது ஒரு கொல்லன் அதிலிருந்து ஒரு பாத்திரத்தை உருவாக்க முடியும்;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அரசனின் முன்னிருந்து தீய அதிகாரிகளை அகற்று;","poem":1},{"text":"அப்பொழுது நியாயத்தினால் அவனுடைய சிங்காசனம் நிலைநிறுத்தப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அரசனின் முன்பாக உன்னை நீயே உயர்த்தாதே,","poem":1},{"text":"பெரியோர்கள் மத்தியில் இடம்பிடிக்க முயற்சி செய்யாதே;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அரசன் உன்னை பெரியோர்கள் முன்பாக சிறுமைப்படுத்துவதைவிட,","poem":1},{"text":"“நீ மேலே, இங்கே வா” என்று உனக்கு சொல்வது மேலானது.","poem":2},{"lineBreak":true},{"text":"நீ உன் கண்களாலே கண்டதைப் பற்றிச் சொல்ல,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"அவசரப்பட்டு நீதிமன்றத்திற்கு ஓடாதே;","poem":2},{"text":"முடிவில் உன் அயலான் நீ சொல்வது பிழையென்று காட்டி","poem":1},{"text":"உன்னை வெட்கப்படுத்தினால் நீ என்ன செய்வாய்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"அயலானோடு உன் வழக்கை வாதிடும்போது,","poem":1},{"text":"நீ இன்னொருவனின் இரகசியத்தை வெளிப்படுத்தாதே;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அப்படிச் செய்தால் அதைக் கேட்கிறவன் உன்னை வெட்கப்படுத்துவான்,","poem":1},{"text":"உனக்கு உண்டாகும் கெட்ட பெயரும் உன்னைவிட்டு நீங்காது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ஏற்ற நேரத்தில் பேசப்படும் சரியான வார்த்தை,","poem":1},{"text":"வெள்ளித்தட்டில் வைக்கப்பட்ட தங்கப்பழங்களைப் போன்றது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஞானமுள்ளவனின் கண்டனம் செவிகொடுத்துக் கேட்பவனுக்கு","poem":1},{"text":"அது தங்கக் காதணியும் தரமான தங்க நகையும் போல இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"நம்பகமான தூதுவன் தன்னை அனுப்புகிறவர்களுக்கு","poem":1},{"text":"அறுவடை நாளில் உறைபனிக் குளிர்ச்சிபோல் இருப்பான்;","poem":2},{"lineBreak":true},{"text":"அவன் தன் எஜமானின் மனதைக் குளிரப்பண்ணுவான்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"தான் கொடுக்காத அன்பளிப்புகளைக் குறித்து பெருமையாகப் பேசுகிற மனிதன்,","poem":1},{"text":"மழையைக் கொண்டுவராத மேகத்தையும் காற்றையும் போலிருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"பொறுமையினால் ஆளுநரையும் இணங்கச் செய்யலாம்,","poem":1},{"text":"சாந்தமான நாவு எலும்பையும் நொறுக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"நீ தேனைப் பெற்றால் அதை அளவாய்ச் சாப்பிடு;","poem":1},{"text":"அளவுக்கு மிஞ்சிச் சாப்பிட்டால் வாந்தியெடுப்பாய்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நீ உன் அயலாருடைய வீட்டிற்கு அடிக்கடி போகாதே;","poem":1},{"text":"அளவுக்கு மிஞ்சிப்போனால் அவர்கள் உன்னை வெறுப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"தன் அயலானுக்கு எதிராக பொய்ச்சாட்சி சொல்கிறவன் தண்டாயுதத்தைப் போலவும்,","poem":1},{"text":"வாளைப்போலவும், கூரான அம்பைப்போலவும் இருக்கிறான்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"துன்ப காலத்தில் உண்மையற்ற நபரில் நம்பிக்கை வைப்பது,","poem":1},{"text":"வலிக்கும் பல்லைப்போலவும் சுளுக்கிய காலைப்போலவும் இருக்கும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"இருதயத்தில் துயரமுள்ளவனுக்கு மகிழ்ச்சிப் பாடல்களைப் பாடுவது,","poem":1},{"text":"குளிர்க்காலத்தில் அவனுடைய உடையை எடுத்து விடுவது போலவும்,","poem":2},{"lineBreak":true},{"text":"காயத்தில் புளித்த காடியை வார்ப்பது போலவும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"உனது பகைவன் பசியாயிருந்தால், அவனுக்குச் சாப்பிடுவதற்கு உணவு கொடு;","poem":1},{"text":"அவன் தாகமாயிருந்தால், குடிப்பதற்குத் தண்ணீர் கொடு.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அப்படிச் செய்வதினால் நீ அவனுடைய தலையின்மேல் எரியும் நெருப்புத் தணல்களைக் குவிப்பாய்;","poem":1},{"text":"யெகோவா கட்டாயமாய் உனக்கு வெகுமதி அளிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"வாடைக்காற்று நிச்சயமாகவே மழையைக் கொண்டுவருவதுபோல,","poem":1},{"text":"வஞ்சகநாவு கோபமுகத்தைக் கொண்டுவரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"சண்டைக்கார மனைவியுடன் வீட்டில் ஒன்றாய் வாழ்வதைவிட,","poem":1},{"text":"கூரையின் மூலையில் தனித்து வாழ்வது சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"தூரதேசத்திலிருந்து வருகிற நற்செய்தி,","poem":1},{"text":"களைத்த ஆத்துமாவுக்குக் கிடைத்த குளிர்ந்த தண்ணீர்போல் இருக்கும்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"கொடியவனுக்கு முன்னால் தளர்வடையும் நீதிமான்,","poem":1},{"text":"சேறு நிறைந்த நீரூற்றைப் போலவும் அசுத்தமடைந்த கிணற்றைப் போலவும் இருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"தேனை அளவுக்கதிகமாய் உண்பது நல்லதல்ல,","poem":1},{"text":"தற்புகழைத் தேடுவதும் மதிப்பிற்குரியதல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"தன்னடக்கம் இல்லாத மனிதன்","poem":1},{"text":"மதிலிடிந்த பட்டணத்தைப் போலிருக்கிறான்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/24.json","previousChapterAudioLinks":{},"numberOfVerses":28}