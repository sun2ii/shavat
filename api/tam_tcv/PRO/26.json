{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":26,"content":[{"type":"verse","number":1,"content":[{"text":"கோடைகாலத்தில் உறைபனியும்","poem":1},{"text":"அறுவடை காலத்தில் மழையும் தகாததுபோல், மூடருக்கு மேன்மை பொருத்தமற்றது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"சிறகடித்துப் பறக்கும் அடைக்கலான் குருவியைப்போலவும் விரைந்து பறக்கும் இரட்டைவால் குருவியைப்போலவும்","poem":1},{"text":"காரணமின்றி இடப்பட்ட சாபமும் தங்காது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"குதிரைக்கு சவுக்கும், கழுதைக்கு கடிவாளமும்,","poem":1},{"text":"மூடரின் முதுகிற்கு பிரம்பும் ஏற்றது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மூடர்களுக்கு அவர்களுடைய மூடத்தனத்தின்படி பதில் சொல்லாதே;","poem":1},{"text":"சொன்னால் நீயும் அவர்களைப்போல் இருப்பாய்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"மூடருக்கு அவர்களுடைய மூடத்தனத்திற்கேற்ற பதிலைக் கொடு;","poem":1},{"text":"இல்லாவிட்டால் அவர்கள் தங்களை ஞானமுள்ளவர்கள் என்று எண்ணிக்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மூடருடைய கையில் செய்தி கொடுத்து அனுப்புவது,","poem":1},{"text":"தன் காலைத் தானே வெட்டுவதைப் போலவும் கேடு விளைவிப்பது போலவும் இருக்கும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"மூடரின் வாயிலுள்ள பழமொழி,","poem":1},{"text":"பெலனற்றுத் தொங்கும் முடவரின் கால்கள்போல் இருக்கும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மூடருக்குக் கனத்தைக் கொடுப்பது,","poem":1},{"text":"கவணிலே கல்லைக் கட்டுவதுபோல் இருக்கும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மூடரின் வாயிலுள்ள பழமொழி,","poem":1},{"text":"குடிகாரனின் கையிலுள்ள முட்செடியைப் போலிருக்கும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"மூடரையோ வழிப்போக்கரையோ கூலிக்கு அமர்த்துபவன்,","poem":1},{"text":"கண்டபடி அம்புகளை எய்து காயப்படுத்தும் வில்வீரனைப் போலிருக்கிறான்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நாய் தான் கக்கினதை மீண்டும் தேடிப்போகிறது போல,","poem":1},{"text":"மூடரும் தம் மூடத்தனத்திற்குத் திரும்புகிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"தன்னைத்தானே ஞானமுள்ளவனென்று எண்ணுகிறவனைக் காண்கிறாயா?","poem":1},{"text":"அவனைவிட மூடன் திருந்துவானென்று நம்பலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“வீதியிலே சிங்கம் நிற்கிறது,","poem":1},{"text":"ஒரு பயங்கர சிங்கம் வீதிகளில் நடமாடித் திரிகிறது!” என்று சோம்பேறி சொல்லுகிறான்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஒரு கதவு அதின் கீழ்ப்பட்டையில் முன்னும் பின்னும் திரும்புகிறது போல,","poem":1},{"text":"சோம்பேறியும் தனது படுக்கையில் திரும்பத்திரும்ப புரளுகிறான்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"சோம்பேறிகள் தங்கள் கையில் உணவை எடுத்துக்கொள்வார்கள்;","poem":1},{"text":"அதைத் தங்கள் வாய்க்கு கொண்டுவர முடியாத அளவுக்கு அவர்கள் சோம்பேறியாய் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"விவேகமாய் பதில்சொல்கிற ஏழு மனிதரைவிட,","poem":1},{"text":"சோம்பேறி தன் பார்வையில் தன்னை ஞானமுள்ளவன் என எண்ணுகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"வேறு ஒருவரின் வாக்குவாதத்தில் தலையிடுகிறவன்,","poem":1},{"text":"தெருநாயின் காதைப்பிடித்து இழுக்கிறவனைப் போலிருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"தீப்பந்தங்களையும் கொல்லும் அம்புகளையும்","poem":1},{"text":"எய்கிற பைத்தியக்காரனைப் போலவே,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"தன் அயலானை ஏமாற்றிவிட்டு,","poem":1},{"text":"“நான் விளையாட்டாகத்தான் செய்தேன்!” எனச் சொல்கிறவன் இருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"விறகில்லாமல் நெருப்பு அணைந்து போவதுபோல,","poem":1},{"text":"புறங்கூறுகிறவன் இல்லாவிட்டால் வாக்குவாதங்கள் அடங்கும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"தணலுக்குக் கரியும், நெருப்புக்கு விறகும் தேவைப்படுவதுபோலவே,","poem":1},{"text":"சச்சரவை மூட்டி விடுவதற்குச் சண்டைக்காரன் தேவை.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"புறங்கூறுகிறவர்களின் வார்த்தைகள் சுவையான உணவைப் போன்றவை;","poem":1},{"text":"அவை மனிதருடைய உள்ளத்தின் ஆழத்தில் பதிந்துவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"தீய இருதயத்தை இனிய பேச்சால் மறைப்பது,","poem":1},{"text":"மண் பாத்திரத்தை வெள்ளிப் பூச்சால் பளபளக்கச் செய்வது போலிருக்கிறது.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"தீயநோக்கமுள்ள மனிதன் தன் உதடுகளினால் தன் எண்ணங்களை மறைக்கிறான்;","poem":1},{"text":"ஆனால் தன் இருதயத்திலோ வஞ்சனையை நிறைத்து வைத்திருக்கிறான்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவனுடைய பேச்சு கவர்ச்சியாயிருந்தாலும், நீ அவனை நம்பாதே;","poem":1},{"text":"அவனுடைய இருதயம் ஏழு அருவருப்புகளால் நிறைந்திருக்கின்றது.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவனுடைய பகை ஏமாற்றத்தால் மறைக்கப்பட்டிருந்தாலும்,","poem":1},{"text":"அவனுடைய கொடுமையோ மக்கள் மத்தியில் வெளியரங்கமாகும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ஒருவன் இன்னொருவனுக்குக் குழி தோண்டினால், அவன் தானே அதற்குள் விழுவான்;","poem":1},{"text":"ஒருவன் கல்லை மேல்நோக்கி உருட்டிவிட்டால், அந்தக் கல் திரும்பி அவன் மேலேயே உருண்டு விழும்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"பொய்பேசும் நாவு தான் புண்படுத்தியவர்களையே வெறுக்கிறது;","poem":1},{"text":"முகஸ்துதி பேசும் வாய் அழிவைக் கொண்டுவரும்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/25.json","previousChapterAudioLinks":{},"numberOfVerses":28}