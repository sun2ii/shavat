{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":27,"content":[{"type":"verse","number":1,"content":[{"text":"நீ நாளையைப் பற்றி பெருமைப்பட்டுப் பேசாதே,","poem":1},{"text":"ஒரு நாள் என்னத்தைக் கொண்டுவரும் என்று உனக்குத் தெரியாதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"உன் வாயல்ல, இன்னொருவரே உன்னைப் புகழட்டும்.","poem":1},{"text":"உன் உதடுகளல்ல, வேறொருவரே உன்னைப் புகழட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"கல் கனமும், மணல் பாரமுமாயிருக்கும்;","poem":1},{"text":"ஆனால் மூடரின் கோபமோ இவை இரண்டையும்விட பெரும் சுமையாய் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"கோபம் கொடூரமானது, மூர்க்கம் பெருகிவரும்;","poem":1},{"text":"ஆனால் பொறாமை இன்னும் ஆபத்தானது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"மறைவான அன்பைவிட,","poem":1},{"text":"வெளிப்படையான கண்டிப்பு சிறந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நண்பன் உண்டாக்கும் காயங்கள் நல்நோக்கமுடையவைகள்,","poem":1},{"text":"ஆனால் எதிரியின் ஏராளமான முத்தங்கள் வஞ்சகமானவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"திருப்தியடைந்தவன் தேனையும் வெறுப்பான்;","poem":1},{"text":"பசியால் வாடுபவனுக்கோ கசப்பாயிருப்பதும் சுவையாயிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"தன் கூட்டைவிட்டு அலைந்து திரிகிற பறவையைப் போலவே,","poem":1},{"text":"வீட்டைவிட்டு அலைகிற மனிதரும் இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"வாசனைத் தைலமும் நறுமணத்தூளும் இருதயத்திற்கு மகிழ்ச்சியைக் கொடுப்பதுபோல,","poem":1},{"text":"ஒருவருடைய நண்பரின் அருமை","poem":2},{"lineBreak":true},{"text":"இதயப்பூர்வமான ஆலோசனையிலிருந்து வெளிப்படுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நீ உன் சிநேகிதரையோ, உன் தகப்பனின் சிநேகிதரையோ கைவிட்டு விடாதே,","poem":1},{"text":"உனக்குப் பேராபத்து வரும்போது உன் குடும்பத்தாரின் வீட்டிற்கு உதவி தேடிப்போகதே;","poem":2},{"lineBreak":true},{"text":"தொலைவில் இருக்கும் உன் குடும்பத்தாரைவிட, அருகில் இருக்கும் அயலாரே மேல்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"என் மகனே, நீ ஞானமுள்ளவனாயிருந்து என் இருதயத்தை சந்தோஷப்படுத்து;","poem":1},{"text":"அப்பொழுது என்னை மதிக்காதவர்களுக்கு என்னால் பதிலளிக்க முடியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"விவேகிகள் ஆபத்தைக் கண்டு மறைந்துகொள்கிறார்கள்;","poem":1},{"text":"ஆனால் அறிவற்றவர்களோ பார்க்காமல் நேராகப்போய் துன்பத்தை அனுபவிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"அறியாதவனுடைய கடனுக்காகப் பாதுகாப்புக் கொடுப்பவனுடைய உடைகளை எடுத்துக்கொள்,","poem":1},{"text":"வேறுநாட்டுப் பெண்ணுக்காக அதைச் செய்தால் அடைமானமாகவே அதை வைத்துக்கொள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஒருவன் அதிகாலையில் தன் அயலானை அதிக சத்தமிட்டு ஆசீர்வதித்தால்,","poem":1},{"text":"அது சாபமாகவே எண்ணப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"சண்டைக்கார மனைவி,","poem":1},{"text":"மழைக்காலத்தில் தொடர்ச்சியான ஒழுக்கைப்போல் இருக்கிறாள்;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவளை அடக்க முயல்வது காற்றை அடக்க முயல்வதுபோலவும்,","poem":1},{"text":"கையினால் எண்ணெயைப் பிடிக்க முயல்வதுபோலவும் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"இரும்பு இரும்பைக் கூர்மையாக்குவது போல,","poem":1},{"text":"ஒரு மனிதன் இன்னொரு மனிதனைக் கூர்மையாக்குகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"அத்திமரத்தைப் காத்து வளர்ப்பவன் அதின் பழத்தைச் சாப்பிடுவான்;","poem":1},{"text":"தன் எஜமானின் நலன்களைப் பாதுகாப்பவன் மேன்மை பெறுவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"தண்ணீர் முகத்தைப் பிரதிபலிப்பது போல,","poem":1},{"text":"ஒருவருடைய இருதயமும் உண்மையான நபரைப் பிரதிபலிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"பாதாளமும் அழிவும் ஒருபோதும் திருப்தியடையாது;","poem":1},{"text":"அவ்வாறே மனிதனுடைய கண்களும் திருப்தியடைவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"வெள்ளியை உலைக்கலமும் தங்கத்தை சூளையும் சோதிக்கும்;","poem":1},{"text":"ஆனால் மனிதர்களோ அவர்களுக்கு வரும் புகழினால் சோதிக்கப்படுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"தானியத்தை உலக்கையினால் இடிப்பதுபோல,","poem":1},{"text":"மூடரை உரலில் போட்டு இடித்தாலும்,","poem":2},{"lineBreak":true},{"text":"மூடத்தனத்தை அவர்களிடமிருந்து உன்னால் அகற்றமுடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"உனது ஆட்டு மந்தைகளின் நிலைமையை நீ நன்றாய் அறிந்துகொள்,","poem":1},{"text":"உன் மாட்டு மந்தைகளையும் கவனமாய்ப் பராமரி;","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஏனெனில் செல்வம் என்றென்றும் நிலைப்பதில்லை,","poem":1},{"text":"கிரீடமும் எல்லாத் தலைமுறைகளுக்கும் நிலைப்பதில்லை.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"காய்ந்த புல் அகற்றப்படும்போது புதிதாக புல் முளைக்கிறது,","poem":1},{"text":"குன்றுகளிலிருந்து புல் சேகரிக்கப்படுகின்றது;","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ஆட்டுக்குட்டிகள் உனக்கு உடைகளைக் கொடுக்கும்,","poem":1},{"text":"வெள்ளாடுகள் ஒரு வயல் வாங்கப் பணத்தைக் கொடுக்கும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"உனக்கும் உன் குடும்பத்திற்கும் போதுமான வெள்ளாட்டுப்பால் உன்னிடம் நிறைவாய் இருக்கும்,","poem":1},{"text":"அது பணிப்பெண்களின் பிழைப்பிற்கும் போதுமானதாய் இருக்கும்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/26.json","previousChapterAudioLinks":{},"numberOfVerses":27}