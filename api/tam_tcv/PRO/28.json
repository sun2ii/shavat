{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":28,"content":[{"type":"verse","number":1,"content":[{"text":"கொடியவர்கள் தங்களை ஒருவரும் துரத்தாதிருந்தும் ஓடுகிறார்கள்;","poem":1},{"text":"ஆனால் நீதிமான்கள் சிங்கத்தைப்போல தைரியமாக இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"நாட்டு மக்கள் கிளர்ச்சி செய்யும்போது, ஆட்சியாளர்கள் அநேகர் இருப்பார்கள்;","poem":1},{"text":"ஆனால் விவேகமும் அறிவும் உள்ள ஆட்சியாளர் ஒழுங்கை நிலைநிறுத்துகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ஏழைகளை ஒடுக்குகிற ஆளுநர்,","poem":1},{"text":"விளைச்சல் அனைத்தையும் அழிக்கும் பெருமழையைப் போலிருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"சட்டங்களை புறக்கணிப்பவர்கள், கொடியவர்களைப் புகழ்கிறார்கள்;","poem":1},{"text":"ஆனால் அதைக் கைக்கொள்கிறவர்கள் அவர்களை எதிர்க்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"தீயவர்கள் நீதியை விளங்கிக்கொள்ளமாட்டார்கள்;","poem":1},{"text":"ஆனால் யெகோவாவைத் தேடுகிறவர்கள் அதை முற்றுமாய் விளங்கிக்கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நேர்மையற்ற வழியில் நடக்கும் பணக்காரர்களைவிட,","poem":1},{"text":"குற்றமற்ற வழியில் நடக்கும் ஏழைகளே சிறந்தவர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"விவேகமான மகன் சட்டங்களை கைக்கொள்கிறான்;","poem":1},{"text":"ஆனால் ஊதாரிகளுக்குக் கூட்டாளியாய் இருக்கும் மகனோ தன் பெற்றோரை அவமானப்படுத்துகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"வட்டியினாலும் அநியாய இலாபத்தினாலும் தன் செல்வத்தைப் பெருக்குகிறவர்கள்,","poem":1},{"text":"ஏழைகளுக்கு இரங்கும் மற்றவர்களுக்காக அதைச் சேர்க்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"சட்டத்திற்கு செவிசாய்க்காதவரின் ஜெபமும்","poem":1},{"text":"இறைவனுக்கு அருவருப்பாயிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நீதிமான்களைத் தீயவழியில் நடத்துகிறவர்கள்,","poem":1},{"text":"தாங்கள் வைத்த கண்ணிக்குள் தாங்களே அகப்படுவார்கள்;","poem":2},{"lineBreak":true},{"text":"ஆனால் குற்றமற்றவர்கள் நன்மையைச் சுதந்தரிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"பணக்காரர்கள் தங்கள் பார்வைக்கு தாங்களே ஞானமுள்ளவர்களாய் காணப்படலாம்;","poem":1},{"text":"ஆனால் மெய்யறிவுள்ள ஏழைகளோ, அவர்கள் யார் என்பதை சரியாக அறிந்துகொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"நீதிமான்கள் வெற்றியடையும்போது பெருமகிழ்ச்சி உண்டாகிறது;","poem":1},{"text":"ஆனால் கொடியவர்கள் அதிகாரத்திற்கு வரும்போது மனிதர்கள் மறைந்துகொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"தங்கள் பாவங்களை மறைக்கிறவர்கள் செழிப்படைய மாட்டான்,","poem":1},{"text":"ஆனால் அவைகளை அறிக்கைசெய்து விட்டுவிடுகிறவர்கள் எவர்களோ, அவர்கள் இரக்கம் பெறுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"எப்பொழுதும் யெகோவாவுக்குப் பயந்து நடப்பவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்;","poem":1},{"text":"ஆனால் தங்கள் இருதயத்தைக் கடினப்படுத்துகிறவர்களோ ஆபத்தில் விழுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"ஏழைகளை ஆட்சிசெய்யும் கொடியவன்","poem":1},{"text":"கெர்ச்சிக்கிற சிங்கம் போலவும் பாயும் கரடியைப்போலவும் இருக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ஏழைகளை ஒடுக்குகிற கொடுமையான ஆளுநருக்கு ஞானம் இல்லை,","poem":1},{"text":"ஆனால் அநியாய வழியில் சம்பாதிக்கும் ஆதாயத்தை வெறுக்கிறவர்கள் நீடிய வாழ்வை அனுபவிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"கொலைகாரனின் துன்புறுத்தப்பட்ட குற்றமனசாட்சி,","poem":1},{"text":"அவனை கல்லறைக்கு இழுக்கும்;","poem":2},{"lineBreak":true},{"text":"யாரும் அவனை ஆதரிக்கவேண்டாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"குற்றமற்றவர்களாய் நடக்கிறவர்கள் பாதுகாக்கப்படுவார்கள்,","poem":1},{"text":"ஆனால் தவறான வழியில் நடப்பவர்கள் திடீரென விழுந்துபோவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"தங்கள் நிலத்தைப் பண்படுத்தி பயிரிடுகிறவர்களுக்கு நிறைவான உணவு கிடைக்கும்,","poem":1},{"text":"ஆனால் பகற்கனவு காண்பதில் நேரத்தை வீணடிப்பவர்களோ, அதிக வறுமையில் வாடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"உண்மையுள்ள மனிதர் நிறைவாக ஆசீர்வதிக்கப்படுவார்கள்;","poem":1},{"text":"ஆனால் விரைவாகப் பணக்காரனாக வேண்டுமென்பவர்கள், தண்டனைக்குத் தப்பமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"பாரபட்சம் காட்டுவது நல்லதல்ல,","poem":1},{"text":"ஆனாலும் சிலர் ஒரு சிறு அப்பத்துண்டிற்காகவும் அநியாயம் செய்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"பேராசைக்காரர்கள் பணக்காரனாவதற்கு ஆவலாயிருக்கிறார்கள்,","poem":1},{"text":"ஏழ்மை தங்களுக்கு வருமென்று அறியாதிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"தன் நாவினால் முகஸ்துதி செய்பவரைவிட,","poem":1},{"text":"மற்றவரைக் கண்டிக்கிறவர்கள் முடிவில் அதிக தயவைப் பெறுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"தன் தகப்பனிடத்திலிருந்தோ தாயினிடத்திலிருந்தோ திருடிவிட்டு,","poem":1},{"text":"“அதில் ஒரு பிழையும் இல்லை” எனச் சொல்பவர்கள்","poem":2},{"lineBreak":true},{"text":"அழிவு உண்டாக்குகிறவர்களுக்குக் கூட்டாளியாயிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"பேராசைக்காரர்கள் பிரிவினையைத் தூண்டிவிடுகிறார்கள்;","poem":1},{"text":"ஆனால் யெகோவாவிடம் நம்பிக்கை வைப்பவர்கள் செழிப்படைவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"தங்களில் நம்பிக்கை வைப்பவர்கள் மூடராயிருக்கிறார்கள்;","poem":1},{"text":"ஆனால் ஞானமுள்ளவர்களாய் நடக்கிறவர்கள் பாதுகாக்கப்படுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"ஏழைகளுக்குக் கொடுப்பவர்களுக்கு குறைவில்லை,","poem":1},{"text":"ஆனால் ஏழைகளின் தேவைகளை கவனிக்காதவர்கள் அநேக சாபங்களைப் பெறுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"கொடியவர்கள் அதிகாரத்திற்கு வரும்போது, மக்கள் மறைந்துகொள்கிறார்கள்;","poem":1},{"text":"ஆனால் கொடியவர்கள் அழியும்போது நீதிமான்கள் பெருகுவார்கள்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/27.json","previousChapterAudioLinks":{},"numberOfVerses":28}