{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":29,"content":[{"type":"verse","number":1,"content":[{"text":"அநேகமுறை கண்டிக்கப்பட்டும், பிடிவாதமாகவே இருக்கிறவர்கள்,","poem":1},{"text":"திடீரென தீர்வு இல்லாமல் அழிந்துபோவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"நீதிமான்கள் பெருகும்போது, மக்கள் மகிழ்ச்சியடைவார்கள்;","poem":1},{"text":"கொடியவர்கள் ஆளும்போதோ, மக்கள் வேதனைக் குரல் எழுப்புவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ஞானத்தை விரும்புகிறவன் தன் தகப்பனுக்கு மகிழ்ச்சியைக் கொடுக்கிறான்;","poem":1},{"text":"ஆனால் விபசாரிகளுடன் கூட்டாளியாய் இருப்பவன் தன்னுடைய செல்வத்தைச் சீரழிக்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அரசன் நியாயத்தினால் நாட்டை நிலைநிறுத்துகிறான்;","poem":1},{"text":"ஆனால் இலஞ்சத்தின்மேல் பேராசை கொண்டவர்கள் நாட்டை அழிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"தனக்கு அடுத்திருப்போரை முகஸ்துதி செய்கிறவர்கள்,","poem":1},{"text":"அவருடைய கால்களுக்கு வலையை விரிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"தீயவர் தங்கள் பாவத்திலேயே சிக்கிக்கொள்கிறார்கள்,","poem":1},{"text":"ஆனால் நீதிமான்கள் ஆர்ப்பரித்து மகிழ்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நீதிமான்கள் ஏழைகளுக்கு நியாயம் கிடைக்கவேண்டும் என்பதில் கவனமாயிருக்கிறார்கள்;","poem":1},{"text":"ஆனால் கொடியவர்களுக்கு அந்த அக்கறையில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஏளனம் செய்பவர்கள் பட்டணத்தில் குழப்பத்தை உண்டுபண்ணுகிறார்கள்;","poem":1},{"text":"ஆனால் ஞானமுள்ளவர்கள் கோபத்தை விலக்குகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ஞானமுள்ளவர் மூடரை நீதிமன்றத்திற்குக் கொண்டுபோனால்,","poem":1},{"text":"மூடர் சினங்கொண்டு கேலிசெய்வார், அங்கு அமைதி இருக்காது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"இரத்தவெறியர் உத்தமமானவர்களை வெறுக்கிறார்கள்;","poem":1},{"text":"நீதிமான்களைக் கொல்லும்படி தேடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"மதியீனர்கள் தம் கோபத்தை அடக்காமல் வெளிப்படுத்துகிறார்கள்;","poem":1},{"text":"ஆனால் ஞானமுள்ளவர்கள் அதை அடக்கிக் கொள்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ஒரு ஆளுநர் பொய்களுக்குச் செவிகொடுத்தால்,","poem":1},{"text":"அவருடைய ஊழியர்கள் எல்லோரும் கொடியவராவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஏழைக்கும் அவரை ஒடுக்கிறவருக்கும் பொதுவானது ஒன்று உண்டு:","poem":1},{"text":"யெகோவாவே அந்த இருவரின் கண்களுக்கும் பார்வையைக் கொடுத்திருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"அரசன் ஏழைகளுக்கு நியாயத்துடன் தீர்ப்பளித்தால்,","poem":1},{"text":"அவனுடைய சிங்காசனம் எப்பொழுதும் நிலைத்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"பிரம்பும் கண்டனமும் ஞானத்தைக் கொடுக்கும்,","poem":1},{"text":"ஆனால் தன் விருப்பப்படி வளரவிடப்படுகிற பிள்ளையோ, தன் தாய்க்கு அவமானத்தைக் கொண்டுவரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"கொடியவர்கள் பெருகும்போது பாவமும் பெருகும்,","poem":1},{"text":"ஆனால் நீதிமான்கள் அவர்களுடைய வீழ்ச்சியைக் காண்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"உன் பிள்ளைகளை கண்டித்துத் திருத்து, அவர்கள் உனக்கு மன ஆறுதலைக் கொடுப்பார்கள்;","poem":1},{"text":"அவர்கள் உன் மனதை சந்தோஷப்படுத்துவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"இறைவெளிப்பாடு இல்லாத இடத்தில் மக்கள் கட்டுக்கடங்காதிருப்பார்கள்;","poem":1},{"text":"ஆனால் ஞானத்தின் சட்டத்தைக் கைக்கொள்கிறவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"வேலைக்காரர்களை வெறும் வார்த்தையினால் திருத்தமுடியாது;","poem":1},{"text":"அவர்கள் அதை விளங்கிக்கொண்டாலும் அதை கவனத்தில் கொள்ளமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"பதற்றப்பட்டுப் பேசுபவனை நீ பார்த்திருக்கிறாயா?","poem":1},{"text":"அவரைவிட மூடராவது திருந்துவாரென்று நம்பலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ஒருவர் தன் வேலைக்காரர்களை இளமையில் கட்டுப்பாடில்லாமல் விட்டால்,","poem":1},{"text":"இறுதியில் அவர்கள் ஆணவம் பிடித்தவர்களாவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"கோபக்காரர்கள் பிரிவினையைத் தூண்டிவிடுகிறார்கள்;","poem":1},{"text":"முற்கோபிகள் அநேக பாவங்களைச் செய்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ஒருவருடைய அகந்தை அவரை வீழ்த்தும்,","poem":1},{"text":"ஆனால் மனத்தாழ்மை கனத்தைக் கொண்டுவரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"திருடர்களுக்கு உடந்தையாய் இருப்பவர்கள் தங்களுக்கே பகைவராய் இருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் ஆணைக்குக் கட்டுப்பட்டதினால் சாட்சி சொல்லத் துணியமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"மனிதருக்குப் பயப்படுவது கண்ணியாயிருக்கும்;","poem":1},{"text":"ஆனால் யெகோவாவிடம் நம்பிக்கை வைப்பவர்கள் பாதுகாக்கப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"அநேகர் ஆளுநரின் தயவை தேடுகிறார்கள்;","poem":1},{"text":"ஆனால் யெகோவாவிடமிருந்தே மனிதர் நியாயத்தைப் பெறுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"நீதிமான்கள் நேர்மையற்றவர்களை வெறுக்கிறார்கள்;","poem":1},{"text":"கொடியவர்கள் நீதிமான்களை வெறுக்கிறார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/28.json","previousChapterAudioLinks":{},"numberOfVerses":27}