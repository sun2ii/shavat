{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":3,"content":[{"type":"heading","content":["ஞானம் நல்வாழ்வை அளிக்கிறது"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, என் போதனைகளை மறவாதே,","poem":1},{"text":"என் கட்டளைகளை உன் இருதயத்தில் வைத்துக்கொள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவை உனக்கு நீண்ட ஆயுளையும்,","poem":1},{"text":"சமாதான வாழ்வையும் கொண்டுவரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"அன்பும் உண்மையும் உன்னைவிட்டு ஒருபோதும் விலகாதிருப்பதாக;","poem":1},{"text":"அவற்றை உன் கழுத்திலே அணிந்து,","poem":2},{"lineBreak":true},{"text":"உன் இருதயத்தில் எழுதி வைத்துக்கொள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அப்பொழுது நீ இறைவனின் பார்வையிலும்","poem":1},{"text":"மனிதனின் பார்வையிலும் தயவையும் நற்பெயரையும் பெறுவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"உன் முழு இருதயத்தோடும் யெகோவாவிடம் நம்பிக்கைவை,","poem":1},{"text":"உன் சொந்த அறிவை மட்டுமே சார்ந்திராதே.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீ செய்யும் எல்லாவற்றிலும் யெகோவாவுக்கே அடங்கியிரு,","poem":1},{"text":"அவர் உன்னை சரியான பாதையில் நடத்துவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"உன்னை ஞானியென்று என்று நீயே எண்ணிக்கொள்ளாதே;","poem":1},{"text":"யெகோவாவுக்குப் பயந்து தீமையைவிட்டு விலகு.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அது உன் உடலுக்கு சுகத்தையும்,","poem":1},{"text":"உனது எலும்புகளுக்கு ஊட்டத்தையும் கொடுக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"நீ உன் செல்வத்தினாலும்,","poem":1},{"text":"உனது எல்லா விளைச்சலின் முதற்பலனினாலும் யெகோவாவைக் கனம்பண்ணு.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அப்பொழுது தானியத்தால் உன் களஞ்சியங்கள் நிரம்பியிருக்கும்;","poem":1},{"text":"திராட்சை இரசத்தினால் உன் தொட்டிகள் நிரம்பிவழியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"என் மகனே, யெகோவாவினுடைய கண்டிப்பைத் தள்ளிவிடாதே;","poem":1},{"text":"அவர் கடிந்துகொள்ளும்போது கோபங்கொள்ளாதே.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஏனெனில் ஒரு தகப்பன் தனது அருமை மகனை கண்டித்துத் திருத்துவதுபோல்,","poem":1},{"text":"யெகோவா யாரை நேசிக்கிறாரோ அவர்களைக் கண்டித்துத் திருத்துகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஞானத்தை அடைகிறவர்களும்,","poem":1},{"text":"புரிந்துகொள்ளுதலைப் பெற்றுக்கொள்கிறவர்களும் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஏனெனில் ஞானம் வெள்ளியைவிட மேலானது,","poem":1},{"text":"தங்கத்தைவிடப் பயனுள்ளது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அது பவளங்களைவிட பெருமதிப்புள்ளது;","poem":1},{"text":"நீ விரும்புகிற எதற்கும் அது நிகரல்ல.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அதின் வலதுகையில் நீண்ட ஆயுளும் இருக்கிறது;","poem":1},{"text":"அதின் இடதுகையில் செல்வமும் கனமும் இருக்கின்றன.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அதின் வழிகள் இன்பமானது;","poem":1},{"text":"அதின் பாதைகள் எல்லாம் சமாதானமானவை.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அதை அணைத்துக் கொள்கிறவர்களுக்கு அது வாழ்வு கொடுக்கும் மரம்,","poem":1},{"text":"அதனைப் பற்றிக்கொள்கிறவர்கள் ஆசீர்வதிக்கப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யெகோவா ஞானத்தினால் பூமிக்கு அஸ்திபாரமிட்டார்,","poem":1},{"text":"அவருடைய புரிந்துகொள்ளுதலினால் வானங்களை அமைத்தார்;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவருடைய அறிவினால் ஆழங்கள் பிரிக்கப்பட்டன,","poem":1},{"text":"மேகங்கள் பனித்துளியை விழப்பண்ணின.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"என் மகனே, ஞானத்தையும் புரிந்துகொள்ளுதலையும் உன் பார்வையிலிருந்து விலகவிடாதே,","poem":1},{"text":"சரியான நிதானிப்பையும் அறிவுடைமையையும் காத்துக்கொள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவை உனக்கு வாழ்வாகவும்,","poem":1},{"text":"உன் கழுத்துக்கு அலங்காரமாகவும் இருக்கும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அப்பொழுது நீ உன் வழியில் பாதுகாப்புடன் போவாய்;","poem":1},{"text":"உன் கால்களும் இடறாது.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நீ படுத்திருக்கும்போது பயப்படமாட்டாய்;","poem":1},{"text":"நீ படுக்கும்போது உன் நித்திரை இன்பமாக இருக்கும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"திடீரென வரும் பேராபத்திற்கும்","poem":1},{"text":"கொடியவர்கள்மேல் வரும் அழிவுக்கும் நீ பயப்படவேண்டாம்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"யெகோவா உனது நம்பிக்கையாயிருப்பார்;","poem":1},{"text":"அவர் உன் கால் இடறாமல் காப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"நன்மைசெய்ய உன்னால் இயலும்போது,","poem":1},{"text":"அதை பெறத்தக்கவர்களுக்கு கொடுக்காமல் விடாதே.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"உன்னிடம் இருக்கும்போதே,","poem":1},{"text":"உன் அயலவனிடம்,","poem":2},{"lineBreak":true},{"text":"“போய்வா; நாளைக்கு உனக்குத் தருவேன்” எனச் சொல்லாதே.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"உன் அருகே நம்பிக்கையுடன் வாழும்","poem":1},{"text":"அயலவனுக்கு விரோதமாகச் சூழ்ச்சி செய்யாதே.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ஒருவர் உனக்கு ஒரு தீங்கும் செய்யாதபோது","poem":1},{"text":"காரணம் இல்லாமல் அவர்கள்மேல் குற்றம் சாட்டாதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"வன்முறையாளர்மேல் பொறாமை கொள்ளாதே;","poem":1},{"text":"அவர்களுடைய வழிகளில் எதையும் தெரிந்தெடுக்காதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"ஏனெனில் நேர்மையற்றவர்களை யெகோவா அருவருக்கிறார்;","poem":1},{"text":"ஆனால் நீதிமான்கள்மேல் தனது நம்பிக்கையை வைத்திருக்கிறார்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"கொடியவர்களின் வீட்டின்மேல் யெகோவாவின் சாபம் இருக்கும்,","poem":1},{"text":"ஆனால் நீதிமான்களுடைய வீட்டிலோ, அவருடைய ஆசீர்வாதம் இருக்கும்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"பெருமைகொண்ட பரியாசக்காரர்களை யெகோவா ஏளனம் செய்கிறார்;","poem":1},{"text":"ஆனால் தாழ்மையுள்ளவர்களுக்கோ, கிருபையைக் கொடுக்கிறார்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ஞானிகள் மதிப்பைப் பெறுவார்கள்;","poem":1},{"text":"மூடர்கள் வெட்கப்படுவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/2.json","previousChapterAudioLinks":{},"numberOfVerses":35}