{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":30,"content":[{"type":"verse","number":1,"content":["யாக்கேயின் மகன் ஆகூரினால் கூறப்பட்ட இறைவாக்கு.",{"text":"அவன் ஈத்தியேலுக்கும் ஊகாலுக்கும் சொன்னது:","poem":1},{"lineBreak":true},{"text":"“இறைவனே, நான் சோர்ந்துவிட்டேன்,","poem":1},{"text":"ஆனால் நான் வெற்றிபெற முடியும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் ஒரு முட்டாள், ஒரு மனிதன் அல்ல;","poem":1},{"text":"ஒரு மனிதனுக்குரிய அறிவாற்றல் எனக்கு இல்லை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் ஞானத்தைக் கற்கவில்லை,","poem":1},{"text":"பரிசுத்தரைப் பற்றிய அறிவும் எனக்கில்லை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மேலே வானத்திற்கு போய் கீழே இறங்கி வந்தவர் யார்?","poem":1},{"text":"தனது கைகளின் பிடிக்குள்ளே காற்றைச் சேர்த்துக்கொண்டவர் யார்?","poem":2},{"text":"வெள்ளத்தைத் தனது உடையில் சுற்றிக் கட்டியவர் யார்?","poem":1},{"text":"பூமியின் எல்லைகளை நிலைநாட்டியவர் யார்?","poem":2},{"text":"அவருடைய பெயர் என்ன, அவருடைய மகனின் பெயர் என்ன?","poem":1},{"text":"உங்களுக்குத் தெரிந்தால் சொல்லுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“இறைவனுடைய ஒவ்வொரு வார்த்தையும் குறைபாடற்றது;","poem":1},{"text":"அவரிடத்தில் அடைக்கலம் கொள்பவர்களுக்கு அவர் கேடயமானவர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவருடைய வார்த்தைகளோடு நீ ஒன்றையும் கூட்டாதே,","poem":1},{"text":"கூட்டினால் அவர் உன்னைக் கண்டித்து, பொய்யன் என நிரூபிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“யெகோவாவே, இரண்டு காரியங்களை நான் உம்மிடம் கேட்கிறேன்;","poem":1},{"text":"நான் இறப்பதற்குள் அதை எனக்குத் தாரும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மாயையையும் பொய்களையும் என்னைவிட்டுத் தூரமாக்கும்;","poem":1},{"text":"எனக்கு வறுமையையோ, செல்வத்தையோ கொடுக்கவேண்டாம்,","poem":2},{"lineBreak":true},{"text":"ஆனால் அன்றன்றைக்குரிய உணவை மட்டும் எனக்குத் தாரும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இல்லாவிட்டால், நான் அளவுக்கதிகமாய் வைத்துக்கொண்டு","poem":1},{"text":"‘யெகோவா யார்?’ என்று கேட்டு ஒருவேளை உம்மை மறுதலிக்கக் கூடும்;","poem":2},{"text":"அல்லது நான் ஏழையாகி, திருடி","poem":1},{"text":"என் இறைவனுடைய பெயரை அவமானப்படுத்தக்கூடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“வேலைக்காரர்களைப் பற்றி அவர்களுடைய எஜமானிடம் இழிவாகப் பேசாதே;","poem":1},{"text":"அப்படிப் பேசினால் அவர்கள் உன்னை சபிப்பார்கள், நீ குற்றவாளியாவாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“தங்கள் தந்தையர்களை சபிக்கிறவர்களும்,","poem":1},{"text":"தங்கள் தாய்மாரை ஆசீர்வதியாமல் இருக்கிறவர்களும் உண்டு;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"தங்கள் அழுக்கிலிருந்து கழுவப்படாமலிருந்தும்,","poem":1},{"text":"தங்கள் கண்களுக்குத் தூய்மையாகக் காணப்படுகிறவர்களும் உண்டு;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"எப்பொழுதும் கண்களில் பெருமையும்","poem":1},{"text":"ஆணவப் பார்வையையும் உடையவர்களும் உண்டு;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"கூர்மையான வாள் போன்ற பற்களையும்","poem":1},{"text":"தீட்டிய கத்திகள் போன்ற கீழ்வாய்ப் பற்களையும் உடையவர்களும் உண்டு;","poem":2},{"text":"அவர்கள் பூமியிலிருந்து ஏழைகளையும்,","poem":1},{"text":"மனுக்குலத்திலிருந்து எளியவர்களையும் தின்றுவிடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“இரத்தம் குடிக்கும் அட்டைக்கு இரண்டு மகள்கள் இருக்கிறார்கள்.","poem":1},{"text":"அவர்கள், ‘தா! தா!’ என அழுகின்றனர்.","poem":2},{"lineBreak":true},"“ஒருபோதும் திருப்தியடையாத மூன்று காரியங்கள் உண்டு, இல்லை, ‘போதும்!’ என்று ஒருபோதும் சொல்லாத நான்காவது காரியமும் உண்டு:"]},{"type":"verse","number":16,"content":["பாதாளம், மலட்டுக் கருப்பை, தண்ணீரால் திருப்தியடையாத நிலம், ஒருபோதும், ‘போதும்!’ என்று சொல்லாத நெருப்பு ஆகியவையே."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“தன் தந்தையை ஏளனம் செய்து,","poem":1},{"text":"தாய்க்குக் கீழ்ப்படிவதைக் கேலி செய்கிறவனுடைய கண்களை","poem":2},{"text":"பள்ளத்தாக்கிலுள்ள அண்டங்காக்கைகள் கொத்திப் பிடுங்கும்,","poem":1},{"text":"கழுகுகள் அவற்றைத் தின்னும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":["“எனக்கு மிகவும் ஆச்சரியத்தைக் கொடுக்கும் மூன்று காரியங்கள் உண்டு, இல்லை, நான்காவதையும் என்னால் விளங்கிக்கொள்ள இயலவில்லை:"]},{"type":"verse","number":19,"content":["ஆகாயத்திலே பறக்கும் கழுகின் வழியும், பாறையின்மேல் ஊரும் பாம்பின் வழியும், நடுக்கடலிலே கப்பலின் வழியும், இளம்பெண்ணின் அன்பை தேடிய ஒரு மனிதரின் வழியுமே அவை."]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"“ஒரு விபசாரியின் வழியும் இவ்விதமானதே:","poem":1},{"text":"அவள் சாப்பிட்டுவிட்டு தன் வாயைத் துடைத்துக்கொண்டு,","poem":2},{"lineBreak":true},{"text":"‘நான் பிழையேதும் செய்யவில்லை’ என்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":["“மூன்று காரியங்களால் பூமி நிலைகுலைகிறது, இல்லை, நான்காவது காரியத்தையோ அதினால் தாங்க முடியவில்லை:"]},{"type":"verse","number":22,"content":["அரசனாகிவிடும் வேலைக்காரன், மூடனுக்கு அளவுக்கதிகமாய் உணவு கிடைப்பதும்,"]},{"type":"verse","number":23,"content":["யாராலும் விரும்பப்படாதிருந்தும் கடைசியில் திருமணமாகும் பெண், தன் எஜமானியின் இடத்தை அபகரிக்கும் வேலைக்காரியுமே."]},{"type":"line_break"},{"type":"verse","number":24,"content":["“பூமியில் மிகச்சிறிய உயிரினங்கள் நான்கு உண்டு, ஆனாலும் அவை மிகவும் ஞானமுள்ளவை:"]},{"type":"verse","number":25,"content":["எறும்புகள் மிக வலிமை குறைந்த உயிரினங்கள்; ஆனாலும், அவை கோடைகாலத்தில் தங்கள் உணவைச் சேமித்து வைக்கின்றன;"]},{"type":"verse","number":26,"content":["குறுமுயல்களும் வலுக்குறைந்த பிராணிகளே; ஆனாலும், உயரமான கற்பாறைகளின் வெடிப்பில் தங்களுக்கு வீடுகளை அமைக்கின்றன."]},{"type":"verse","number":27,"content":["வெட்டுக்கிளிகளுக்கோ அரசன் இல்லை, ஆனாலும் அவை ஒன்றாய் அணிவகுத்துச் செல்கின்றன;"]},{"type":"verse","number":28,"content":["பல்லியையோ கையால் பிடித்துக்கொள்ளலாம், ஆனாலும் அது அரச மாளிகைகளிலும் காணப்படுகிறது."]},{"type":"line_break"},{"type":"verse","number":29,"content":["“வீர நடையுடைய மூன்று உண்டு, இல்லை, கம்பீரத் தோற்றமுடைய நான்காவதும் உண்டு:"]},{"type":"verse","number":30,"content":["மிருகங்களில் வலிமைமிக்கது சிங்கம், அது எதைக் கண்டும் பின்வாங்குவதில்லை;"]},{"type":"verse","number":31,"content":["கர்வத்துடன் நடக்கும் சேவல், வெள்ளாட்டுக்கடா ஆகியவையும்; தன் இராணுப்படை சூழ நிற்கும் அரசனுமே."]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“நீ மூடத்தனமாய் நடந்து உன்னை நீயே மேன்மைப்படுத்தினால்,","poem":1},{"text":"அல்லது தீமைசெய்ய திட்டமிட்டிருந்தால்,","poem":2},{"lineBreak":true},{"text":"உன் கையினால் உன் வாயை மூடிக்கொள்!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"பாலைக் கடைந்தால் வெண்ணெய் வருவதுபோலவும்,","poem":1},{"text":"மூக்கைக் கசக்குவதினால் இரத்தம் வருவதுபோலவும்,","poem":2},{"lineBreak":true},{"text":"கோபத்தை மூட்டுவதும் சண்டையை ஏற்படுத்தும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/29.json","previousChapterAudioLinks":{},"numberOfVerses":33}