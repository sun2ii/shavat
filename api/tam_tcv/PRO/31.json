{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":31,"content":[{"type":"verse","number":1,"content":["அரசன் லேமுயேலின் வார்த்தைகள்: இது அவனுடைய தாயினால் அவனுக்குப் போதிக்கப்பட்ட இறைவாக்கு."]},{"type":"verse","number":2,"content":[{"text":"என் மகனே! என் கர்ப்பத்தின் மகனே!","poem":1},{"text":"நேர்த்திக்கடன் மூலம் நான் பெற்ற மகனே! கேள்,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீ பெண்களிடம் உன் பெலனைக் கொடுக்காதே,","poem":1},{"text":"அரசர்களை அழிப்பவர்களிடம் சேராதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"லேமுயேலே, திராட்சைமது அருந்துவது அரசர்களுக்கு உகந்ததல்ல,","poem":1},{"text":"அது அரசர்களுக்குத் தகுந்ததல்ல,","poem":2},{"lineBreak":true},{"text":"ஆளுநர்கள் மதுபானத்தை விரும்புவது நல்லதல்ல.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அரசர்கள் குடிப்பதினால் சட்டத்தை மறந்து போவார்கள்","poem":1},{"text":"ஒடுக்கப்பட்டவர்களின் சட்ட உரிமைகளை வழங்க மறுப்பார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அழிந்து போகிறவர்களுக்கு மதுபானத்தைக் கொடு,","poem":1},{"text":"வேதனையிலுள்ளவர்களுக்கு திராட்சை மதுவைக் கொடு!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் குடித்துத் தங்கள் வறுமையை மறக்கட்டும்,","poem":1},{"text":"தங்கள் துயரத்தை ஒருபோதும் நினையாதிருக்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"தங்களுக்காகப் பேச முடியாதவர்களுக்காகப் பேசு,","poem":1},{"text":"ஆதரவற்றோர்களின் உரிமைகளுக்காகப் பேசு.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களுக்காகப் பேசி, நியாயமாகத் தீர்ப்பு வழங்கு;","poem":1},{"text":"ஏழைகள் மற்றும் தேவையுள்ளவர்களின் உரிமைகளைக் காப்பாற்று.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நற்குணமுடைய மனைவியை யாரால் கண்டடைய முடியும்?","poem":1},{"text":"அவள் மதிப்போ பவளக்கற்களைவிட மிகவும் உயர்ந்தது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவளின் கணவன் அவளில் முழுநம்பிக்கை வைத்திருக்கிறான்;","poem":1},{"text":"அவனுக்கு செல்வாக்கு குறையாது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவள் தன் வாழ்நாட்கள் முழுவதும்","poem":1},{"text":"அவனுக்குத் தீமையை அல்ல, நன்மையையே கொண்டுவருகிறாள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவள் கம்பளியையும் சணலையும் தெரிந்தெடுத்து,","poem":1},{"text":"மிக ஆர்வத்துடன் தன் கைகளினால் வேலை செய்கிறாள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவள் தூர இடத்திலிருந்து உணவுப் பொருட்களை","poem":1},{"text":"ஏற்றிவரும் வியாபாரக் கப்பலைப்போல் இருக்கிறாள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவள் விடியுமுன்னே இருட்டோடே எழும்புகிறாள்;","poem":1},{"text":"அவள் தன் குடும்பத்திற்கு உணவை ஆயத்தப்படுத்தி,","poem":2},{"lineBreak":true},{"text":"தன் வேலைக்காரிகளுக்கு பகிர்ந்து கொடுக்கிறாள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவள் ஒரு வயலைப்பற்றிக் கருத்தாய் விசாரித்து, அதை வாங்குகிறாள்;","poem":1},{"text":"அவள் தன் வருமானத்தினால் திராட்சைத் தோட்டத்தை உண்டாக்குகிறாள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"மிகவும் சுறுசுறுப்புடன் தன் வேலைகளைச் செய்கிறாள்;","poem":1},{"text":"அதைச் செய்ய தனது கைகளை பலப்படுத்துகிறாள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"தன் தொழில் இலாபகரமாய் இருக்கும்படி பார்த்துக்கொள்கிறாள்;","poem":1},{"text":"அவளுடைய விளக்கு இரவிலும் அணைவதில்லை","poem":2},{"noteId":2},{"text":".","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவள் தன் கைகளில் இராட்டினத்தைப் பிடித்துக்கொண்டு,","poem":1},{"text":"தன் விரல்களினால் நூற்பந்தைப் பற்றிக்கொள்கிறாள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவள் ஏழைகளுக்குத் தன் கைகளைத் திறந்து,","poem":1},{"text":"தேவையுள்ளோர்களுக்குத் தன் உதவிக் கரத்தை நீட்டுகிறாள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவளின் வீட்டார் எல்லோருக்கும் குளிர்க்கால உடை இருப்பதால்,","poem":1},{"text":"உறைபனிக்காலம் வரும்போது அவள் பயப்படமாட்டாள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவள் தனது படுக்கைக்குரிய போர்வையைத் தானே நெய்கிறாள்;","poem":1},{"text":"சிறந்த பட்டாடை மற்றும் பலவண்ண உடைகளையும் உடுத்திக்கொள்கிறாள்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவளுடைய கணவன் பட்டண வாசலில்,","poem":1},{"text":"குடிமக்களின் தலைவர்களோடு உட்கார்ந்திருக்கையில் மதிக்கப்படுகிறான்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவள் சிறந்த பட்டாடைகளை நெய்து அவற்றை விற்கிறாள்,","poem":1},{"text":"அவள் இடைக் கச்சைகளையும் செய்து வியாபாரிகளுக்கு விநியோகம் செய்கிறாள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவள் பெலத்தையும் கவுரவத்தையும் உடுத்தியிருக்கிறாள்;","poem":1},{"text":"வருங்காலத்தை மகிழ்வுடன் எதிர்நோக்குகிறாள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவள் ஞானமாய்ப் பேசுகிறாள்,","poem":1},{"text":"அவளுடைய நாவில் தயவான அறிவுரைகள் இருக்கின்றன.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவள் தன் வீட்டுக் காரியங்கள்மேல் எப்போதும் அக்கறையாயிருக்கிறாள்;","poem":1},{"text":"அவள் சோம்பலாயிருந்து உணவுக்காக எதிர்பார்த்து இருப்பதில்லை.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவளுடைய பிள்ளைகள் எழுந்து அவளை, “ஆசீர்வதிக்கப்பட்டவள்” என்கிறார்கள்;","poem":1},{"text":"அவளுடைய கணவனும் அவளை இப்படிப் புகழ்கிறான்:","poem":2}]},{"type":"verse","number":29,"content":[{"text":"“அநேகம் பெண்கள் சிறப்பான செயல்களைச் செய்கிறார்கள்,","poem":1},{"text":"ஆனால் நீயோ அவர்கள் எல்லோரிலும் உயர்வானவள்.”","poem":2}]},{"type":"verse","number":30,"content":[{"text":"கவர்ச்சித் தோற்றம் வஞ்சகமானது, அழகும் அழிந்துபோகும்;","poem":1},{"text":"ஆனால் யெகோவாவுக்குப் பயந்து நடக்கிற பெண்ணே புகழப்படத்தக்கவள்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"அவளுடைய கைகளின் பலனுக்காக அவளைப் பாராட்டுங்கள்,","poem":1},{"text":"அவளுடைய செயல்கள் பட்டண வாசலில் அவளுக்குப் புகழ்ச்சியைக் கொண்டுவரட்டும்.","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"இரவுவரைக் கடினமாக உழைக்கிறாள் என்று அர்த்தம்.","reference":{"chapter":31,"verse":18}}]},"thisChapterLink":"/api/tam_tcv/PRO/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ECC/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/30.json","previousChapterAudioLinks":{},"numberOfVerses":31}