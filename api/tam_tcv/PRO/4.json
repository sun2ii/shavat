{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["ஞானமே மேலானது"]},{"type":"verse","number":1,"content":[{"text":"பிள்ளைகளே, தகப்பனின் அறிவுரைகளைக் கேளுங்கள்;","poem":1},{"text":"கவனமாயிருந்து புரிந்துகொள்ளுதலைப் பெற்றுக்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் உங்களுக்கு நல்ல ஆலோசனையைத் தருகிறேன்,","poem":1},{"text":"எனவே நீங்கள் எனது போதனைகளைக் கைவிடாதிருங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் எனது தகப்பனுக்குச் செல்ல மகனாய்,","poem":1},{"text":"என் தாய்க்கு அருமையான ஒரே பிள்ளையாய் வளர்ந்து வந்தேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அப்பொழுது என் தகப்பன் எனக்குப் போதித்துச் சொன்னதாவது:","poem":1},{"text":"“நான் சொல்லும் வார்த்தைகளை உன் இருதயத்தில் வைத்துக்கொள்;","poem":2},{"lineBreak":true},{"text":"நீ என் கட்டளைகளைக் கைக்கொள், அப்பொழுது நீ வாழ்வாய்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஞானத்தையும் புரிந்துகொள்ளுதலையும் பெற்றுக்கொள்;","poem":1},{"text":"எனது வார்த்தைகளை மறக்காமலும் அவற்றைவிட்டு விலகாமலும் இரு.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீ ஞானத்தை விட்டுவிடாதே, அது உன்னைப் பாதுகாக்கும்;","poem":1},{"text":"அதை நேசி, அது உன்னை காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஞானத்தைப் பெற்றுக்கொள்வதே ஞானத்தின் ஆரம்பம்;","poem":1},{"text":"உன்னிடம் உள்ளதையெல்லாம் செலவழிக்க வேண்டியதானாலும் புரிந்துகொள்ளுதலைப் பெற்றுக்கொள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீ அதை மதித்து நட, அது உன்னை மேன்மைப்படுத்தும்;","poem":1},{"text":"நீ அதை அணைத்துக்கொள், அப்பொழுது அது உன்னைக் கனப்படுத்தும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அது உன் தலையில் அழகான மலர் முடியைச் சூட்டும்,","poem":1},{"text":"அது உனக்கு சிறப்புமிக்க மகுடத்தைக் கொடுக்கும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"என் மகனே, கேள், நான் சொல்வதை ஏற்றுக்கொள்;","poem":1},{"text":"அப்பொழுது உன் வாழ்நாட்கள் நீடித்திருக்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான் ஞானத்தின் வழியை உனக்குக் காட்டி,","poem":1},{"text":"நேரான பாதையில் உன்னை வழிநடத்துகிறேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீ நடக்கும்போது, உன் கால்கள் தடுமாறாது;","poem":1},{"text":"நீ ஓடும்போது இடறி விழமாட்டாய்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அறிவுரைகளைப் பற்றிக்கொள், அவற்றை விட்டுவிடாதே;","poem":1},{"text":"அதை நன்றாகக் காத்துக்கொள், அதுவே உன் வாழ்வு.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"கொடியவர்களின் பாதையில் அடியெடுத்து வைக்காதே;","poem":1},{"text":"தீய மனிதர்களின் வழியில் நீ நடக்காதே.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அதைத் தவிர்த்துவிடு, அதில் பயணம் செய்யாதே;","poem":1},{"text":"அதைவிட்டுத் திரும்பி உன் வழியே செல்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஏனெனில் தீமைசெய்யும்வரை அவர்கள் உறங்கமாட்டார்கள்;","poem":1},{"text":"யாரையாவது விழப்பண்ணும்வரை அவர்கள் நித்திரை செய்யமாட்டார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர்கள் கொடுமையின் உணவைச் சாப்பிட்டு,","poem":1},{"text":"வன்முறையின் மதுவைக் குடிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"நீதிமான்களின் பாதை நடுப்பகல் வரைக்கும்","poem":1},{"text":"மேன்மேலும் பிரகாசிக்கிற சூரியப் பிரகாசத்தைப் போன்றது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ஆனால் கொடியவர்களின் வழியோ காரிருளைப் போன்றது;","poem":1},{"text":"அவர்கள் தங்களை இடறப்பண்ணுவது எது என்பதை அறியார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"என் மகனே, நான் சொல்வதைக் கவனி;","poem":1},{"text":"நான் சொல்லும் வார்த்தைகளுக்குச் செவிகொடு.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவற்றை உன் பார்வையிலிருந்து விலகவிடாதே,","poem":1},{"text":"அவற்றை உன் இருதயத்திற்குள் வைத்துக்கொள்;","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவற்றைக் கண்டுபிடிப்பவர்களுக்கு அவை வாழ்வாக இருக்கும்;","poem":1},{"text":"அவை மனிதரின் முழு உடலுக்கும் நலனளிக்கும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"எல்லாவற்றிற்கும் மேலாக, உன் இருதயத்தைக் காத்துக்கொள்,","poem":1},{"text":"அதிலிருந்து நீ செய்யும் எல்லாமே உனது வாழ்வின் ஊற்றாகப் புறப்பட்டு வரும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"வஞ்சகத்தை உன் வாயிலிருந்து அகற்று,","poem":1},{"text":"சீர்கேடான பேச்சுக்களை உன் உதடுகளிலிருந்து தூரமாய் விலக்கு.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உன் கண்கள் நேராய் பார்க்கட்டும்;","poem":1},{"text":"உனக்கு முன்பாக இருப்பதில் உன் பார்வையை செலுத்து.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"உன் பாதங்களுக்கு ஒழுங்கான பாதைகளை அமைத்துக்கொள்;","poem":1},{"text":"அப்பொழுது உன் வழிகளெல்லாம் உறுதியாயிருக்கும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நீ இடது பக்கமோ, வலதுபக்கமோ விலகாதே;","poem":1},{"text":"உன் கால்களைத் தீமையிலிருந்து விலக்கிக்கொள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}