{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":5,"content":[{"type":"heading","content":["விபசாரத்தைக் குறித்து எச்சரிக்கை"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, என் ஞானத்தைக் கவனத்தில்கொள்,","poem":1},{"text":"எனது புத்திமதிகளை மிகக் கவனமாகக் கேள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அப்பொழுது அறிவுடைமையுடன் நடந்துகொள்வாய்;","poem":1},{"text":"உன் உதடுகள் அறிவைப் பாதுகாக்கும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஏனெனில் விபசாரியின் உதடுகள் தேனைச் சிந்தும்,","poem":1},{"text":"அவளுடைய பேச்சு எண்ணெயைவிட மிருதுவாயிருக்கும்;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால் முடிவோ, அவள் வேம்பைப்போல் கசப்பாயும்,","poem":1},{"text":"இருபக்கமும் கூர்மையுள்ள வாளைப்போலவும் இருப்பாள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவளுடைய பாதங்கள் மரணத்திற்குச் செல்கின்றன;","poem":1},{"text":"அவள் காலடிகளோ நேரே பாதாளத்திற்கு வழிநடத்துகின்றன.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவளோ வாழ்வின் வழியைப் பற்றிச் சிந்திப்பதேயில்லை,","poem":1},{"text":"அவளுடைய பாதைகள் கோணலானவை, அவள் அதை அறியாதிருக்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஆகவே என் பிள்ளைகளே, எனக்குச் செவிகொடுங்கள்;","poem":1},{"text":"நான் சொல்வதைவிட்டு விலகவேண்டாம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவளுக்குத் தூரமான வழியில் நடங்கள்,","poem":1},{"text":"அவளுடைய வீட்டின் வாசலையும் மிதிக்கவேண்டாம்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இல்லையென்றால், உங்களுடைய கனத்தை மற்றவர்களிடமும்","poem":1},{"text":"உங்களுடைய வாழ்நாட்களை கொடூரர்களிடமும் இழந்துவிடுவீர்கள்;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"வேறுநாட்டைச் சேர்ந்தவர் உங்கள் செல்வத்தை அனுபவிப்பார்கள்,","poem":1},{"text":"உங்களுடைய கடும் உழைப்பு இன்னொருவனின் வீட்டைச் செல்வச் சிறப்பாக்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உங்களுடைய வாழ்க்கையின் முடிவில்,","poem":1},{"text":"உங்கள் தசையும் உடலும் நலியும்போது வேதனையால் புலம்புவீர்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அப்பொழுது நீங்கள், “ஐயோ, நான் அறிவுரையை வெறுத்தேனே,","poem":1},{"text":"திருத்தத்தை எனது இருதயம் அலட்சியம் செய்ததே!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் எனக்கு போதித்தவர்களுக்குக் கீழ்ப்படியவில்லையே,","poem":1},{"text":"எனக்கு அறிவுரை சொன்னவர்களுக்கு செவிகொடுக்கவில்லையே.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் இறைவனின் மக்கள் கூட்டத்தில்","poem":1},{"text":"தீராத பிரச்சனைக்குள்ளாகி விட்டேனே” என்று சொல்வீர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"நீ உனது சொந்தக் கிணற்றின் தண்ணீரையே குடி,","poem":1},{"text":"நீ உனது சொந்த நீரூற்றிலிருந்தே தண்ணீரைப் பருகு.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"உனது ஊற்றுகள் வீதிகளில் வழிந்தோட வேண்டுமோ?","poem":1},{"text":"உனது நீரோடைகள் பொது இடங்களில் ஓடவேண்டுமோ?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவை உன்னுடையவைகளாக மட்டுமே இருக்கட்டும்,","poem":1},{"text":"அவற்றை அறியாதவருடன் பகிர்ந்துகொள்ளக் கூடாது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உனது ஊற்று ஆசீர்வதிக்கப்படுவதாக,","poem":1},{"text":"நீ உனது வாலிப காலத்தின் மனைவியுடன் மகிழ்ந்திருப்பாயாக.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவள் உனக்கு அன்பான பெண்மான் போலவும் அழகியமான் போலவும் இருப்பாளாக,","poem":1},{"text":"அவளுடைய மார்பகங்களே எந்நாளும் உன்னைத் திருப்தியாக்கட்டும்;","poem":2},{"lineBreak":true},{"text":"அவளுடைய அன்பினால் நீ எப்பொழுதும் கவரப்படுவாயாக.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"என் மகனே, ஒரு விபசாரியினால் நீ ஏன் கவரப்படவேண்டும்?","poem":1},{"text":"இன்னொருவனின் மனைவியின் மார்பை நீ ஏன் தழுவவேண்டும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"மனிதரின் வழிகள் எல்லாம் யெகோவாவுக்குமுன் வெளியரங்கமாய் இருக்கின்றன,","poem":1},{"text":"அவர்களுடைய பாதைகளை எல்லாம் அவர் ஆராய்ந்து பார்க்கிறார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"கொடியவர்கள் தம்முடைய தீயசெயல்களாலே அகப்படுகிறார்கள்;","poem":1},{"text":"அவர்களுடைய பாவக்கயிறுகள் அவர்களை இறுக்கிக் கட்டுகின்றன.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவர்கள் நற்கட்டுப்பாடு இல்லாததினால் சாவார்கள்,","poem":1},{"text":"அவர்களுடைய மூடத்தனத்தின் மிகுதியினால் வழிவிலகிப் போவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/4.json","previousChapterAudioLinks":{},"numberOfVerses":23}