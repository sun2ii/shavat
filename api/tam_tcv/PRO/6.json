{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":6,"content":[{"type":"heading","content":["மூடத்தனத்தைக் குறித்து எச்சரிக்கை"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, நீ அயலானுடைய கடனுக்காக உத்திரவாதம் கொடுத்திருந்தால்,","poem":1},{"text":"நீ அறியாதவனுக்கு பதிலாக வாக்குக்கொடுத்திருந்தால்,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீ சொன்ன வார்த்தையினால் நீ பிடிபட்டாய்,","poem":1},{"text":"உன் வாயின் வார்த்தையினாலே நீ அகப்பட்டாய்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என் மகனே, நீ உன் அயலாரின் கைகளில் விழுந்துவிட்டபடியினால்,","poem":1},{"text":"நீ உன்னை விடுவித்துக்கொள்ள","poem":2},{"text":"நீ போய் உன்னைத் தாழ்த்தி,","poem":1},{"text":"உன் அயலான் களைப்படையும் வரை வேண்டிக்கொள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அதுவரை உன் கண்களுக்கு நித்திரையையும்,","poem":1},{"text":"உன் கண் இமைகளுக்கு தூக்கத்தையும் வரவிடாதே.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"வேட்டைக்காரனின் கையில் அகப்பட்ட மானைப்போல,","poem":1},{"text":"வேடனின் கையில் அகப்பட்ட பறவையைப்போல முயன்று நீ தப்பியோடு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"சோம்பேறியே, நீ எறும்பிடம் போய்,","poem":1},{"text":"அதின் வழிகளைக் கவனித்து ஞானியாகு!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அதற்குத் தளபதியோ, மேற்பார்வையாளனோ,","poem":1},{"text":"அதிகாரியோ இல்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அப்படியிருந்தும் அது கோடைகாலத்தில் தனக்குத் தேவையான உணவை ஆயத்தப்படுத்துகிறது,","poem":1},{"text":"அறுவடைக்காலத்தில் தன் உணவை அது சேகரிக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"சோம்பேறியே, நீ எவ்வளவு நேரத்திற்கு படுத்திருப்பாய்?","poem":1},{"text":"நீ உன் தூக்கத்தைவிட்டு எப்போது எழுந்திருப்பாய்?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"கொஞ்சம் நித்திரை செய்வேன், கொஞ்சம் தூங்குவேன்,","poem":1},{"text":"கொஞ்சம் என் கைகளை மடித்து ஓய்வெடுப்பேன் என்பாயானால்,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"வறுமை கொள்ளைக்காரனைப்போல் உன்மேல் வரும்;","poem":1},{"text":"பற்றாக்குறை ஆயுதம் தாங்கிய முரடனைப்போல உன்னைத் தாக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"வீணனும் கயவனுமானவன்,","poem":1},{"text":"வஞ்சக வார்த்தைகளைப் பேசித்திரிகிறான்.","poem":2}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"அவன் தன் கண்களை வஞ்சனையில் சிமிட்டி,","poem":2},{"lineBreak":true},{"text":"தன் கால்களால் செய்தியைத் தெரிவித்து,","poem":2},{"lineBreak":true},{"text":"தனது விரல்களால் சைகை காட்டுகிறான்.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அவன் தன் இருதயத்திலுள்ள வஞ்சனையினால் தீமையான சூழ்ச்சி செய்கிறான்;","poem":2},{"lineBreak":true},{"text":"அவன் எப்பொழுதும் பிரிவினையைத் தூண்டிவிடுகிறான்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அதினால் ஒரு கணப்பொழுதில் பேராபத்து அவனைச் சூழ்ந்துகொள்ளும்;","poem":1},{"text":"மீளமுடியாதபடி திடீரென அழிந்துபோவான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":["யெகோவா வெறுக்கிற ஆறு காரியங்கள் உண்டு, இல்லை, ஏழு காரியங்கள் அவருக்கு அருவருப்பானது:"]},{"type":"verse","number":17,"content":["கர்வமுள்ள கண்கள், பொய்பேசும் நாவு, குற்றமற்ற இரத்தத்தைச் சிந்தும் கைகள்,"]},{"type":"verse","number":18,"content":["கொடுமையான சூழ்ச்சிகளைத் திட்டமிடும் இருதயம், தீமைசெய்ய விரையும் கால்கள்,"]},{"type":"verse","number":19,"content":["பொய்ச்சாட்சி, சகோதரர்களுக்குள்ளே பிரிவினையைத் தூண்டிவிடும் நபர்."]},{"type":"heading","content":["விபசாரத்தைக் குறித்து எச்சரிக்கை"]},{"type":"verse","number":20,"content":[{"text":"என் மகனே, உன் தகப்பனின் கட்டளைகளைக் கைக்கொள்,","poem":1},{"text":"உன் தாயின் போதனையை விட்டுவிடாதே.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவற்றை எப்பொழுதும் உன் இருதயத்தில் வைத்துக்கொள்;","poem":1},{"text":"அவற்றை உன் கழுத்தில் கட்டிக்கொள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நீ நடக்கும்போது அவை உனக்கு வழிகாட்டும்;","poem":1},{"text":"நீ தூங்கும்போது, அவை உன்னைக் கண்காணிக்கும்;","poem":2},{"lineBreak":true},{"text":"நீ விழித்தெழும்பும்போது, அவை உன்னோடு பேசும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஏனெனில் இந்த கட்டளைகள் ஒரு விளக்கு,","poem":1},{"text":"இந்த போதனை ஒரு வெளிச்சம்,","poem":2},{"text":"நற்கட்டுப்பாடும் கண்டித்தலும்","poem":1},{"text":"வாழ்வுக்கு வழி.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"இவை ஒழுக்கங்கெட்ட பெண்ணிடமிருந்தும்,","poem":1},{"text":"விபசாரியின் இனிய வார்த்தைகளிலிருந்தும் உன்னை விலக்கிக் காக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"நீ உன் இருதயத்தில் அவளுடைய அழகின்மேல் இச்சை கொள்ளாதே;","poem":1},{"text":"அவள் கண்கள் உன்னைக் கவருவதற்கு இடங்கொடாதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"ஏனெனில் விபசாரி, ஒரு துண்டு அப்பத்தைத் தேடி அலையும் நிலைக்கு உன்னைக்கொண்டு வருவாள்;","poem":1},{"text":"பிறரின் மனைவி உன் உயிரையே சூறையாடுவாள்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"ஒருவன் தன் உடைகள் எரியாமல்","poem":1},{"text":"தன் மடியில் நெருப்பை அள்ளி எடுக்கமுடியுமோ?","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அல்லது தனது பாதங்கள் எரியாதபடி,","poem":1},{"text":"ஒருவனால் நெருப்புத்தழலில் நடக்க முடியுமோ?","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவ்வாறே இன்னொருவனின் மனைவியுடன் உறவுகொள்பவனும் இருக்கிறான்;","poem":1},{"text":"அவளைத் தொடுபவன் எவனும் தண்டனை பெறாமல் தப்பமாட்டான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"ஒரு திருடன் தான் பசியாய் இருக்கும்போது,","poem":1},{"text":"தன் பசியைத் தீர்ப்பதற்குத் திருடுவதை மனிதர் பெரும் குறையாகக் கருதுவதில்லை.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ஆனாலும் அவன் பிடிக்கப்பட்டால், அதை ஏழுமடங்காகக் கொடுத்தேத் தீரவேண்டும்;","poem":1},{"text":"அதற்கு அவன் வீட்டிலுள்ள செல்வங்களையெல்லாம் அவன் கொடுக்க நேரிடும்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"ஆனால் விபசாரம் செய்பவனோ சுத்த முட்டாள்;","poem":1},{"text":"அப்படிச் செய்பவன் தன்னைத்தானே அழித்துக்கொள்கிறான்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அடிபட்ட காயமும் அவமானமும் அவனுடைய பங்கு;","poem":1},{"text":"அவனுடைய வெட்கம் ஒருபோதும் நீங்காது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"ஏனெனில் பொறாமை கணவனின் மூர்க்கத்தைத் தூண்டும்;","poem":1},{"text":"பழிவாங்கும் நாளில் அவன் இரக்கம் காட்டமாட்டான்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"அவன் எவ்வித இழப்பீட்டையும் ஏற்றுக்கொள்ளமாட்டான்;","poem":1},{"text":"எவ்வளவு பெரிய இலஞ்சமானாலும், அவன் அதை வாங்க மறுப்பான்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/5.json","previousChapterAudioLinks":{},"numberOfVerses":35}