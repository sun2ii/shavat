{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":7,"content":[{"type":"heading","content":["விபசாரியைக் குறித்த எச்சரிக்கை"]},{"type":"verse","number":1,"content":[{"text":"என் மகனே, என் வார்த்தைகளைக் கைக்கொள்,","poem":1},{"text":"என் கட்டளைகளை உனக்குள்ளே பெருஞ்செல்வமாக வைத்துக்கொள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் கட்டளைகளுக்குக் கீழ்ப்படி, அப்பொழுது நீ வாழ்வடைவாய்;","poem":1},{"text":"என் போதனைகளை உன் கண்மணியைப்போல் காத்துக்கொள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவற்றை உன் விரல்களில் நினைவூட்டலாகக் கட்டி,","poem":1},{"text":"இருதயத்தில் எழுதி வைத்துக்கொள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஞானத்தை நோக்கி, “நீ என் சகோதரி” என்றும்,","poem":1},{"text":"மெய்யறிவை, “நீ என் நெருங்கிய உறவினர்” என்றும் சொல்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவை உன்னை விபசாரியிடமிருந்தும்,","poem":1},{"text":"மயக்கும் வார்த்தைகளைப் பேசும் ஒழுக்கங்கெட்ட பெண்ணிடமிருந்தும் உன்னைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நான் என் வீட்டின் ஜன்னல் அருகே நின்று","poem":1},{"text":"திரை வழியேப் பார்த்தேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அப்பொழுது அறிவில்லாத","poem":1},{"text":"இளைஞர்கள் மத்தியில் புத்தியற்ற","poem":2},{"lineBreak":true},{"text":"ஒரு வாலிபனைக் கண்டேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவன் அந்த விபசாரி இருக்கும் தெருமுனைக்குச் சென்று,","poem":1},{"text":"அவளுடைய வீட்டின் வழியே நடந்துபோனான்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அது பொழுதுபட்டு மாலைமங்கி","poem":1},{"text":"இருள் சூழ்ந்துகொண்டிருந்த வேளையாயிருந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அப்பொழுது ஒரு பெண் வேசியின் உடை உடுத்தியவளாய்,","poem":1},{"text":"தந்திரமான எண்ணத்தோடு அவனைச் சந்திக்க வெளியே வந்தாள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவள் வாயாடியும் அடக்கமில்லாதவளுமாய் இருந்தாள்;","poem":1},{"text":"அவள் கால்கள் ஒருபோதும் வீட்டில் தங்குவதில்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவள் ஒருமுறை வீதியிலும் பின்பு பொது இடங்களிலும் நிற்பாள்,","poem":1},{"text":"மூலையோரங்களில் பதுங்கிக் காத்திருப்பாள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவள் அவனைக் கட்டிப்பிடித்து முத்தமிட்டு,","poem":1},{"text":"நாணமில்லாத முகத்துடனே அவனிடம்:","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“நான் என் வீட்டில் சமாதான பலிகளைச் செலுத்தி,","poem":1},{"text":"இன்று என் நேர்த்திக் கடன்களை நிறைவேற்றினேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அதினால் நான் உம்மைச் சந்திக்க வெளியே வந்தேன்;","poem":1},{"text":"நான் உம்மைத் தேடினேன், இப்பொழுது கண்டுகொண்டேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நான் எகிப்தின் பலவர்ண மென்பட்டுத் துணியை விரித்து","poem":1},{"text":"எனது கட்டிலை அழகுபடுத்தியிருக்கிறேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நான் வெள்ளைப் போளத்தினாலும், சந்தனத்தினாலும்,","poem":1},{"text":"இலவங்கப் பட்டையாலும் என் படுக்கைக்கு நறுமணமூட்டியிருக்கிறேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"வாரும், நாம் காலைவரை ஆழ்ந்த காதலில் மூழ்கியிருப்போம்;","poem":1},{"text":"நாம் இன்பத்தில் மகிழ்ந்திருப்போம்!","poem":2}]},{"type":"verse","number":19,"content":[{"text":"எனது கணவன் வீட்டில் இல்லை;","poem":1},{"text":"அவன் நீண்டதூரப் பிரயாணமாய் போய்விட்டான்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவன் தனது பையில் பணத்தை நிரப்பிக்கொண்டு போனான்,","poem":1},{"text":"அவன் பெளர்ணமி நாள்வரை வீட்டிற்கு வரமாட்டான்” என்று சொன்னாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"இவ்வாறு அவள் தனது வசப்படுத்தும் வார்த்தையினால் அவனை மயக்கி,","poem":1},{"text":"அவள் தன் மிருதுவான பேச்சினால் அவனை தவறிழைக்கத் தூண்டினாள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"உடனேயே அவன் அவளுக்குப் பின்னே போனான்;","poem":1},{"text":"வெட்டுவதற்காகக் கொண்டுபோகப்படும் மாட்டைப்போலவும்","poem":2},{"text":"வலையில் விழப்போகும் மானைப்போலவும்","poem":1}]},{"type":"verse","number":23,"content":[{"text":"தானாய் கண்ணிக்குள் பிடிபடும் பறவையைப் போலவும் அவன் போனான்;","poem":2},{"text":"அது அம்பினால் தனது நெஞ்சைப் பிளந்து","poem":1},{"text":"உயிரையே வாங்கிவிடும் என அறியாமல் போனான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"ஆகையால் என் பிள்ளைகளே, எனக்குச் செவிகொடுங்கள்;","poem":1},{"text":"நான் சொல்வதைக் கவனித்துக் கேளுங்கள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"உங்கள் இருதயத்தை அவளுடைய வழிகளின் பக்கம் திரும்ப விடவேண்டாம்;","poem":1},{"text":"அவளுடைய பாதைகளின் பக்கம் இழுப்புண்டு போகாதீர்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவளால் வீழ்த்தப்பட்டுப் பலியானவர்கள் அநேகர்;","poem":1},{"text":"அவளால் கொல்லப்பட்டவர்கள் வலிமையான கூட்டம்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவளுடைய வீடு பாதாளத்திற்குப் போகும் பெரும்பாதை;","poem":1},{"text":"அது மரணத்தின் மண்டபங்களுக்கு வழிநடத்துகிறது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/6.json","previousChapterAudioLinks":{},"numberOfVerses":27}