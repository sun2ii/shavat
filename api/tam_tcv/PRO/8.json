{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["ஞானத்தின் அழைப்பு"]},{"type":"verse","number":1,"content":[{"text":"ஞானம் அழைக்கிறதில்லையோ?","poem":1},{"text":"புரிந்துகொள்ளுதல் குரல் எழுப்புகிறதில்லையோ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அது வழியிலுள்ள மேடுகளிலும்","poem":1},{"text":"தெருக்கள் சந்திக்கும் இடங்களிலும் நிற்கிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அது பட்டணத்திற்குப் போகும் வாசல்களின் அருகில்,","poem":1},{"text":"அதின் நுழைவாசலில் நின்று, சத்தமிட்டுக் கூப்பிடுகிறது:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“மனிதர்களே, நான் உங்களைக் கூப்பிடுகிறேன்;","poem":1},{"text":"மனுக்குலம் எல்லாம் கேட்கும்படி என் சத்தத்தை உயர்த்துகிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அறிவில்லாதவர்களே, விவேகத்தை அடையுங்கள்;","poem":1},{"text":"மூடர்களே, விவேகத்தின்மேல் மனதை வைத்துக்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"கேளுங்கள், சொல்லுவதற்கு நம்பகமான காரியங்கள் என்னிடம் இருக்கிறது;","poem":1},{"text":"என் உதடுகள் நேர்மையான காரியங்களைப் பேசும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உண்மையானது எதுவோ, அதையே என் வாய் பேசுகிறது;","poem":1},{"text":"கொடுமையை என் உதடுகள் வெறுக்கிறது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் வாயின் வார்த்தைகள் எல்லாம் நீதியானவை;","poem":1},{"text":"அவற்றில் கபடமோ, வஞ்சனையோ இல்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"பகுத்தறிவு உள்ளவர்களுக்கு அவை தெளிவானவை;","poem":1},{"text":"அறிவுடையோருக்கு அவை நேர்மையானவை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"வெள்ளியைவிட என் அறிவுரைகளையும்","poem":1},{"text":"தங்கத்தைவிட அறிவையும் தெரிந்தெடு.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஏனெனில் ஞானம் பவளத்தைவிட அதிக மதிப்புள்ளது;","poem":1},{"text":"நீ விரும்பும் எதுவும் அதற்கு நிகரானது அல்ல.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“ஞானமாகிய நான், விவேகத்துடன் ஒன்றாக குடியிருக்கிறேன்;","poem":1},{"text":"எனக்கு அறிவும் பகுத்தறிவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"தீமையை வெறுப்பதே யெகோவாவுக்குப் பயந்து நடப்பதாகும்;","poem":1},{"text":"பெருமையையும் அகந்தையையும்","poem":2},{"lineBreak":true},{"text":"தீய நடத்தையையும் வஞ்சகப்பேச்சையும் நான் வெறுக்கிறேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஆலோசனையும் நிதானிக்கும் ஆற்றலும் என்னுடையவை;","poem":1},{"text":"என்னிடம் மெய்யறிவும் வல்லமையும் உண்டு.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என்னால் அரசர்கள் ஆட்சி செய்கிறார்கள்,","poem":1},{"text":"ஆளுநர்களும் நீதியான சட்டங்களை இயற்றுகிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"என்னால் இளவரசர்கள் ஆள்கிறார்கள்,","poem":1},{"text":"நீதிபதிகள் யாவரும் நீதித்தீர்ப்பை வழங்குகிறார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"என்னை நேசிக்கிறவர்களை நானும் நேசிக்கிறேன்;","poem":1},{"text":"என்னைத் தேடுகிறவர்கள் என்னைக் கண்டுகொள்வார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"என்னிடத்தில் செல்வமும் கனமும்","poem":1},{"text":"நிலையான சொத்தும் நீதியும் இருக்கின்றன.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"என்னால் வரும் பலன் தங்கத்திலும் சிறந்தது;","poem":1},{"text":"தரமான வெள்ளியிலும் மேன்மையானது.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நான் நீதியான வழியிலும்","poem":1},{"text":"நியாயமான பாதைகளிலும் நடக்கிறேன்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"என்னை நேசிப்பவர்களுக்கு செல்வத்தை வழங்குகிறேன்,","poem":1},{"text":"அவர்களுடைய களஞ்சியத்தையும் நிரப்புகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“யெகோவா தம் பூர்வீக செயல்களுக்கு முன்பே,","poem":1},{"text":"தமது வேலைப்பாடுகளில் முதன்மையாக என்னைப் படைத்திருந்தார்;","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நீண்ட காலத்திற்கு முன்பு நான் உருவாக்கப்பட்டேன்,","poem":1},{"text":"உலகம் உண்டாவதற்கு முன்பே, ஆரம்பத்திலிருந்தே நான் படைக்கப்பட்டேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"சமுத்திரங்கள் உண்டாவதற்கு முன்பே நான் பிறந்தேன்,","poem":1},{"text":"அப்பொழுது தண்ணீர் நிறைந்த ஊற்றுக்களும் இருக்கவில்லை.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"மலைகளும் குன்றுகளும் அவற்றுக்குரிய இடங்களில் அமையுமுன்பே","poem":1},{"text":"நான் பிறந்திருந்தேன்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவர் பூமியையோ அதின் நிலங்களையோ","poem":1},{"text":"உலகத்தில் மண்ணையோ உண்டாக்குவதற்கு முன்பே நான் இருந்தேன்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவர் வானங்களை அதற்குரிய இடத்தில் அமைத்தபோதும்,","poem":1},{"text":"ஆழத்தின் மேற்பரப்பில் அவர் அடிவானத்தை குறித்தபோதும் நான் அங்கிருந்தேன்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அத்துடன் மேலே மேகத்தை நிலைநிறுத்தும் போதும்,","poem":1},{"text":"ஆழத்தின் ஊற்றுகளை கவனமாய் அமைத்தபோதும் நான் அங்கிருந்தேன்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"கடலுக்கு எல்லையை அமைத்து,","poem":1},{"text":"தண்ணீர் அவருடைய கட்டளையை மீறி வெளியேறாதபடி","poem":2},{"text":"அவர் பூமிக்கு அதின் அஸ்திபாரத்தைக் குறியிட்டபோதும் நான் அங்கேயே இருந்தேன்.","poem":1}]},{"type":"verse","number":30,"content":[{"text":"அப்பொழுது நான் யெகோவாவின் அருகில் ஒரு திறமைவாய்ந்த சிற்பியாக இருந்தேன்.","poem":2},{"text":"நான் நாள்தோறும் அவருக்குப் பிரியமாயிருந்து,","poem":1},{"text":"எப்பொழுதும் அவருக்கு முன்பாகக் களிகூர்ந்தேன்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"அவருடைய உலகம் முழுவதிலும் நான் சந்தோஷமாய் செயலாற்றி,","poem":1},{"text":"மனுமக்களில் நான் மகிழ்ச்சி அடைந்தேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“ஆகையால் என் பிள்ளைகளே, எனக்குச் செவிகொடுங்கள்;","poem":1},{"text":"எனது வழியைக் கைக்கொள்ளுகிறவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"எனது அறிவுறுத்தலைக் கேட்டு ஞானமுள்ளவர்களாயிருங்கள்;","poem":1},{"text":"அதை அலட்சியம் செய்யவேண்டாம்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"நாள்தோறும் என் வாசலில் காவல் செய்து,","poem":1},{"text":"என் கதவருகே காத்திருந்து,","poem":2},{"lineBreak":true},{"text":"எனக்குச் செவிகொடுப்பவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"என்னைத் தேடிக் கண்டடைகிறவர்கள் வாழ்வைக் கண்டடைவார்கள்;","poem":1},{"text":"யெகோவாவிடமிருந்து தயவையும் பெறுவார்கள்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ஆனால் என்னைத் தேடிக் கண்டடையாதவர்கள் தங்களுக்கே தீமை செய்கிறார்கள்;","poem":1},{"text":"என்னை வெறுக்கிறவர்கள் மரணத்தையே விரும்புகிறார்கள்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}