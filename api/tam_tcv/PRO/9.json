{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PRO","translationId":"tam_tcv","name":"நீதிமொழி","commonName":"நீதிமொழி","title":"நீதிமொழிகள்","order":20,"numberOfChapters":31,"sha256":"c8db03c7163ae216ebf1d4e6fd3711a9d2709ac59bca81352348e94caa89d0dd","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tam_tcv/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":9,"content":[{"type":"heading","content":["ஞானம் மற்றும் முட்டாள்தனத்தின் அழைப்பு"]},{"type":"verse","number":1,"content":[{"text":"ஞானம் தனக்கென ஒரு வீட்டைக் கட்டி,","poem":1},{"text":"அதின் ஏழு தூண்களையும் செதுக்கி அமைத்திருக்கிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஞானம் இறைச்சியைத் தயாரித்து திராட்சை இரசத்தையும் கலந்திருக்கிறது;","poem":1},{"text":"அது தனது பந்தியையும் ஆயத்தப்படுத்தியிருக்கிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"தன் பணிப்பெண்களை வெளியே அனுப்பிவிட்டு,","poem":1},{"text":"பட்டணத்தில் உயரமான இடங்களில் நின்று இப்படி அழைத்தது,","poem":2}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"“அறிவற்றவர்களே நீங்கள் எல்லோரும் இங்கே வாருங்கள்!”","poem":2},{"text":"பின்பு மதிகேடர்களுக்கு இப்படிச் சொன்னது,","poem":1}]},{"type":"verse","number":5,"content":[{"text":"“வாருங்கள், எனது உணவைச் சாப்பிட்டு","poem":2},{"lineBreak":true},{"text":"நான் கலந்த திராட்சை இரசத்தையும் குடியுங்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீங்கள் உங்கள் மூடவழிகளை விட்டுவிடுங்கள், அப்பொழுது வாழ்வடைவீர்கள்;","poem":1},{"text":"மெய்யறிவின் வழியில் நடங்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஏளனம் செய்பவர்களைத் திருத்துகிறவர்கள் தங்களுக்கு அவமதிப்பைத் தேடிக்கொள்கிறார்கள்;","poem":1},{"text":"கொடியவர்களைக் கடிந்துகொள்கிறவர்கள் பழிச்சொல்லுக்கு ஆளாகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஏளனம் செய்பவர்களை கடிந்துகொள்ளாதே, அவர்கள் உன்னை வெறுப்பார்கள்;","poem":1},{"text":"ஞானமுள்ளவர்களைக் கடிந்துகொள், அவர்கள் உன்னை நேசிப்பார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஞானமுள்ளவர்களுக்கு அறிவுரை கூறு, அவர்கள் இன்னும் ஞானத்தில் வளருவார்கள்;","poem":1},{"text":"நீதிமான்களுக்குக் கற்றுக்கொடு, அவர்கள் அறிவில் இன்னும் வளருவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவாவுக்குப் பயப்படுதலே ஞானத்தின் ஆரம்பம்,","poem":1},{"text":"பரிசுத்தரைப் பற்றிய அறிவே புரிந்துகொள்ளுதல்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஏனெனில் ஞானத்தினாலே உன் வாழ்நாட்கள் அதிகரிக்கும்,","poem":1},{"text":"உன் ஆயுளுடன் பல வருடங்கள் கூட்டப்படும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீ ஞானியாய் இருந்தால், உன் ஞானம் உனக்கு வெகுமதியைக் கொடுக்கும்;","poem":1},{"text":"நீ ஏளனம் செய்பவனாய் இருந்தால், தனிமையாகவே துன்பத்தை அனுபவிப்பாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"மூடத்தனம் ஒரு முட்டாள் பெண்போல் இருக்கிறது;","poem":1},{"text":"அவள் அறிவற்றவளாயும் ஒன்றும் அறியாதவளுமாய் இருக்கிறாள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவள் தனது வீட்டின் வாசற்படியில் உட்கார்ந்திருக்கிறாள்,","poem":1},{"text":"பட்டணத்தின் உயர்ந்த இடத்திலுள்ள இருக்கையில் உட்கார்ந்திருக்கிறாள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவள் தன்னைக் கடந்து தங்கள் வழியில்","poem":1},{"text":"நேராய் செல்பவர்களைக் கூப்பிட்டு,","poem":2}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"“அறிவற்றவர்களே, நீங்கள் எல்லோரும் இங்கே வாருங்கள்!”","poem":2},{"text":"பின்பு அவள் மதிகேடர்களுக்கு இப்படிச் சொன்னாள்,","poem":1}]},{"type":"verse","number":17,"content":[{"text":"“திருட்டுத்தண்ணீர் இனிமையானது;","poem":2},{"lineBreak":true},{"text":"இரகசியமாகச் சாப்பிடும் உணவு சுவையானது!”","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஆனால் அங்கு செத்தவர்கள் இருக்கிறார்கள் என்றும்,","poem":1},{"text":"அவளின் விருந்தாளிகள் பாதாளத்தின் ஆழங்களில் இருக்கிறார்கள் என்றும் அவர்கள் அறியாதிருக்கிறார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PRO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PRO/8.json","previousChapterAudioLinks":{},"numberOfVerses":18}