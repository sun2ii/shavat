{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":[{"text":"தீயவர்களின் அறிவுரையின்படி நடவாமல்,","poem":1},{"text":"பாவிகளின் வழியில் நில்லாமல்,","poem":2},{"lineBreak":true},{"text":"பரிகாசக்காரருடன் உட்காராமல்,","poem":2},{"text":"யெகோவாவினுடைய சட்டத்திலே மனமகிழ்ச்சியாயிருந்து,","poem":1},{"text":"இரவும் பகலும் அவருடைய வேதத்தை தியானிக்கிறவர் ஆசீர்வதிக்கபட்டவர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அப்படிப்பட்டவர் நீரோடைகளின் அருகே நாட்டப்பட்டு,","poem":1},{"text":"பருவகாலத்தில் தன் பழங்களைக் கொடுத்து,","poem":2},{"text":"இலை உதிராதிருக்கும் மரத்தைப்போல இருக்கிறார்.","poem":1},{"text":"அவர் செய்வதெல்லாம் செழிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"தீயவர்களோ அப்படியல்ல,","poem":1},{"text":"அவர்கள் காற்றினால் அடித்துச் செல்லப்படும்","poem":2},{"lineBreak":true},{"text":"பதரைப்போல் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆகையால் நியாயத்தீர்ப்பின்போது தீயவர் தப்புவதில்லை,","poem":1},{"text":"பாவிகளுக்கு நீதிமான்களின் கூட்டத்தில் இடமுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ஏனெனில் நீதிமான்களின் வழியை யெகோவா கண்காணிக்கிறார்;","poem":1},{"text":"தீயவர்களின் வழியோ அழிவுக்குக் கொண்டுசெல்லும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}