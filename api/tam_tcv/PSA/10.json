{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நீர் ஏன் தூரத்தில் நிற்கிறீர்?","poem":1},{"text":"துன்ப நேரங்களில் நீர் ஏன் மறைந்துகொள்கிறீர்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"கொடுமையானவன் பெருமையினால் பலவீனமானவர்களை வேட்டையாடுகிறான்;","poem":1},{"text":"அவன் தீட்டுகிற சதித்திட்டங்களில் அவர்கள் அகப்பட்டுக் கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவன் தன் இருதயத்தின் பேராசைகளைக் குறித்துப் பெருமைகொள்கிறான்;","poem":1},{"text":"அவன் பேராசைக்காரரை வாழ்த்தி யெகோவாவை நிந்திக்கிறான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"கொடுமையானவன் தன் பெருமையின் நிமித்தம் இறைவனைத் தேடுவதில்லை;","poem":1},{"text":"அவனுடைய சிந்தனைகளிலெல்லாம் அவருக்கு இடமேயில்லை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவனுடைய வழிகள் எப்பொழுதுமே செழிப்பாயிருக்கின்றன;","poem":1},{"text":"உமது நீதிநெறிகளை அவன் ஒதுக்கி வைத்துள்ளான்;","poem":2},{"lineBreak":true},{"text":"தன் பகைவர் அனைவரையும் ஏளனம் செய்கிறான்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவன் தனக்குள்ளே, “என்னை ஒன்றும் அசைக்கப்படுவதில்லை,","poem":1},{"text":"எனக்குத் தலைமுறை தலைமுறைதோறும் கஷ்டம் வராது” என்று சொல்லிக்கொள்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"அவனுடைய வாய் சாபமும் பொய்யும் கொடுமையும் நிறைந்தது;","poem":1},{"text":"அவனுடைய நாவின்கீழே பிரச்சனையும் தீமையும் இருக்கின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவன் கிராமங்களின் அருகே பதுங்கிக் காத்திருக்கிறான்;","poem":1},{"text":"பதுங்கியிருந்து குற்றமற்றவனைக் கொலைசெய்கிறான்.","poem":2},{"text":"திக்கற்றவர்களைப் பிடிப்பதிலேயே கண்ணோக்கமாயிருந்து,","poem":1}]},{"type":"verse","number":9,"content":[{"text":"பதுங்கியிருக்கும் சிங்கத்தைப்போல் காத்திருக்கிறான்.","poem":2},{"text":"அவன் ஆதரவற்றோரைப் பிடிப்பதற்காக காத்திருக்கிறான்;","poem":1},{"text":"அவன் உதவியற்றோரைப் பிடித்து தன் வலையில் இழுத்துக்கொள்கிறான்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவனிடம் அகப்பட்டவர்கள் நசுக்கப்பட்டு நிலைகுலைந்து போகிறார்கள்;","poem":1},{"text":"அவனுடைய பெலத்தினால் அவர்கள் வீழ்ந்துபோகிறார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“இறைவன் கண்டுகொள்ளமாட்டார்;","poem":1},{"text":"அவர் தமது முகத்தை மறைத்து, ஒருபோதும் அதைக் காண்பதில்லை”","poem":2},{"lineBreak":true},{"text":"என்று கொடுமையானவன் தனக்குள் சொல்லிக்கொள்கிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவாவே, எழுந்தருளும்; இறைவனே, உமது கரத்தை உயர்த்தும்;","poem":1},{"text":"ஆதரவற்றோரை மறவாதிரும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"கொடுமையானவன் இறைவனை நிந்திப்பது ஏன்?","poem":1},{"text":"“அவர் என்னிடம் கணக்குக் கேட்பதில்லை” என்று","poem":2},{"lineBreak":true},{"text":"அவன் தனக்குள்ளேயே சொல்லிக்கொள்வது ஏன்?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஆனாலும் இறைவனே, நீரோ பாதிக்கப்பட்டோரின் பிரச்சனையைக் காண்கிறீர்;","poem":1},{"text":"நீர் அவர்களின் துயரங்களைக் கவனித்து,","poem":2},{"lineBreak":true},{"text":"அவர்களுக்கு உதவிசெய்யக் கருத்தாய் இருக்கிறீர்.","poem":2},{"text":"பாதிக்கப்பட்டோர்கள் தம்மை உம்மிடம் ஒப்படைக்கிறார்கள்;","poem":1},{"text":"திக்கற்றவர்களுக்கு நீரே துணையாய் இருக்கிறீர்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"கொடுமையுள்ள மனிதனின் கரங்களை முறியும்.","poem":1},{"text":"தீயவனுடைய கொடுமையைக் குறித்து அவனிடம் கணக்குக் கேளும்.","poem":2},{"lineBreak":true},{"text":"இல்லையெனில் அதைக் கண்டுபிடிக்க முடியாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"யெகோவா என்றென்றைக்கும் அரசராயிருக்கிறார்;","poem":1},{"text":"அவருடைய நாட்டிலிருந்து பிற மக்கள் அழிந்துபோவார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"யெகோவாவே, நீர் துன்பப்பட்டோரின் வாஞ்சையைக் கேட்கிறீர்;","poem":1},{"text":"அவர்களை உற்சாகப்படுத்தி அவர்களுடைய கதறுதலைக் கேட்கிறார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"பூமிக்குரிய மனிதன் இனி ஒருபோதும்","poem":1},{"text":"மற்றவர்களுக்கு திகிலூட்டுபவனாய் இராதபடி,","poem":2},{"lineBreak":true},{"text":"நீர் திக்கற்றவர்களையும் ஒடுக்கப்பட்டவர்களையும் பாதுகாக்கிறீர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}