{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":100,"content":[{"type":"hebrew_subtitle","content":["நன்றியுணர்வை வெளிப்படுத்தும் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"பூமியிலுள்ளவர்களே, எல்லோரும் மகிழ்ச்சியுடன் யெகோவாவை ஆர்ப்பரியுங்கள்.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"மகிழ்ச்சியுடன் யெகோவாவை வழிபடுங்கள்,","poem":2},{"lineBreak":true},{"text":"மகிழ்ச்சிப் பாடல்களோடு அவர்முன் வாருங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே இறைவன் என்று அறியுங்கள்.","poem":1},{"text":"அவரே நம்மை உண்டாக்கினார், நாம் அவருடையவர்கள்;","poem":2},{"lineBreak":true},{"text":"நாம் அவருடைய மக்கள், அவருடைய மேய்ச்சலின் ஆடுகள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அவருடைய வாசல்களில் நன்றியோடும்,","poem":1},{"text":"அவருடைய ஆலய முற்றங்களில் துதியோடும், உட்செல்லுங்கள்","poem":2},{"lineBreak":true},{"text":"அவருக்கு நன்றி செலுத்தி, அவருடைய பெயரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவா நல்லவர், அவருடைய அன்பு என்றென்றைக்கும் நிலைத்திருக்கிறது;","poem":1},{"text":"அவருடைய உண்மை எல்லாத் தலைமுறைகளுக்கும் தொடர்ந்து வருகிறது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}