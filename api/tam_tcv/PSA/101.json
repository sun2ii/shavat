{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":101,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நான் உமது அன்பையும் நீதியையும் குறித்துப் பாடுவேன்;","poem":1},{"text":"உமக்கே நான் துதி பாடுவேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் குற்றமற்ற வாழ்க்கையை வாழ கவனமாயிருப்பேன்;","poem":1},{"text":"நீர் எப்பொழுது என்னிடத்தில் வருவீர்?","poem":2},{"lineBreak":true},{"text":"நான் குற்றமற்ற இருதயத்துடன்","poem":1},{"text":"என் வீட்டின் விவகாரங்களை நடத்துவேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"தீங்கான செயல்களை","poem":1},{"text":"நான் என் கண்முன் வைக்கமாட்டேன்.","poem":2},{"lineBreak":true},{"text":"உண்மையற்ற மனிதரின் செயல்களை நான் வெறுக்கிறேன்;","poem":1},{"text":"அவைகள் என்னைப் பற்றிக்கொள்ளாது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"வஞ்சக இருதயமுடைய மனிதரை என்னைவிட்டுத் தூரமாய் விலக்கிவைப்பேன்;","poem":1},{"text":"நான் தீமையோடு எவ்வித தொடர்பும் வைக்கமாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"தன் அயலாரை இரகசியமாய் அவதூறு செய்கிற மனிதரை","poem":1},{"text":"நான் தண்டிப்பேன்;","poem":2},{"text":"கர்வமான கண்களையும் பெருமையான இருதயத்தையும் கொண்ட மனிதரை","poem":1},{"text":"நான் சகிக்கமாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நாட்டில் உண்மையுள்ளவர்களாய் இருப்போர்மீது என் கண்கள் இருக்கும்,","poem":1},{"text":"அவர்கள் என்னோடு வாழ்வார்கள்;","poem":2},{"text":"குற்றமற்றவனாய் நடப்பவர்களே","poem":1},{"text":"எனக்கு ஊழியம் செய்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"வஞ்சனை செய்யும் யாரும்","poem":1},{"text":"என் வீட்டில் வாழமாட்டார்கள்;","poem":2},{"text":"பொய்ப் பேசுபவர் யாரும்","poem":1},{"text":"என் சமுகத்தில் நிற்கவுமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"நான் நாட்டிலுள்ள கொடியவர்கள் எல்லோரையும்","poem":1},{"text":"காலைதோறும் தண்டிப்பேன்;","poem":2},{"text":"தீங்குசெய்யும் ஒவ்வொருவரையும்","poem":1},{"text":"யெகோவாவினுடைய நகரத்திலிருந்து அகற்றிவிடுவேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}