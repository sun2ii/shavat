{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":102,"content":[{"type":"hebrew_subtitle","content":["பலவீனமடைந்து யெகோவாவுக்கு முன்பாக புலம்பலை ஊற்றும் ஒரு சிறுமைப்பட்டவனின் மன்றாட்டு."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என் மன்றாட்டைக் கேளும்;","poem":1},{"text":"உதவிக்காக என் கதறுதல் உம்மிடம் வந்துசேர்வதாக.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் துன்பத்தில் இருக்கும்போது","poem":1},{"text":"உமது முகத்தை என்னிடமிருந்து மறைத்துக் கொள்ளாதேயும்;","poem":2},{"text":"நான் கூப்பிடும்போது உமது செவியை என் பக்கமாய்த் திருப்பி,","poem":1},{"text":"விரைவாய் எனக்குப் பதிலளியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"என் நாட்கள் புகையைப்போல் மறைந்துபோகின்றன;","poem":1},{"text":"என் எலும்புகள் தகதகக்கும் தணல்கள்போல் எரிகின்றன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் இருதயம் புல்லைப்போல் உலர்ந்து கருகிப்போயிற்று;","poem":1},{"text":"நான் என் உணவைச் சாப்பிடவும் மறக்கிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என் உரத்த பெருமூச்சினால்","poem":1},{"text":"நான் எலும்பும் தோலுமானேன்;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் ஒரு பாலைவன ஆந்தையைப்போல் இருக்கிறேன்;","poem":1},{"text":"பாழிடங்களில் உள்ள ஓர் ஆந்தையைப்போல் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் நித்திரையின்றிப் படுத்திருக்கிறேன்;","poem":1},{"text":"நான் வீட்டுக்கூரைமேல் தனித்திருக்கும் ஒரு பறவைபோல் ஆனேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் பகைவர் நாள்முழுவதும் என்னை நிந்திக்கிறார்கள்;","poem":1},{"text":"எனக்கு விரோதமாக வசை கூறுகிறவர்கள் என் பெயரைச் சாபமாகப் பயன்படுத்துகிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் சாம்பலை உணவாகச் சாப்பிட்டு,","poem":1},{"text":"என் பானத்தைக் கண்ணீரோடு கலக்கிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உமது கடுங்கோபத்திற்கு உள்ளானேன்.","poem":1},{"text":"நீர் என்னை தூக்கி, ஒரு பக்கமாய் வைத்துவிட்டீர்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் வாழ்நாட்கள் மாலைநேர நிழலைப் போன்றது;","poem":1},{"text":"நான் புல்லைப்போல் வாடிப் போகின்றேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ஆனால் நீரோ யெகோவாவே, என்றென்றும் சிங்காசனத்தில் அமர்ந்திருக்கிறீர்;","poem":1},{"text":"உமது கீர்த்தி எல்லாத் தலைமுறைகளுக்கும் நீடித்திருக்கும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீர் எழுந்து சீயோன்மேல் கருணை காட்டும்;","poem":1},{"text":"இதுவே நீர் அதற்கு தயை காட்டும் காலம்,","poem":2},{"lineBreak":true},{"text":"நியமிக்கப்பட்ட காலமும் வந்துவிட்டது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"சீயோனின் கற்கள் உமது பணியாளர்களுக்கு அருமையாய் இருக்கின்றன;","poem":1},{"text":"அதின் தூசியின்மேலும் அவர்கள் அனுதாபம் கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நாடுகள் யெகோவாவினுடைய பெயருக்குப் பயப்படுவார்கள்;","poem":1},{"text":"பூமியின் அரசர்கள் எல்லோரும் உமது மகிமைக்கு மரியாதை செலுத்துவார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யெகோவா திரும்பவும் சீயோனைக் கட்டியெழுப்பி,","poem":1},{"text":"தம் மகிமையில் காட்சியளிப்பார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆதரவற்றவர்களின் மன்றாட்டிற்கு அவர் பதிலளிப்பார்;","poem":1},{"text":"அவர்களுடைய வேண்டுதல்களை அவர் புறக்கணிக்கமாட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"இனிமேல் உருவாக்கப்படும் மக்கள் யெகோவாவை துதிக்கும்படி,","poem":1},{"text":"இனிவரப்போகும் தலைமுறையினருக்காக இது எழுதப்படுவதாக:","poem":2}]},{"type":"verse","number":19,"content":[{"text":"“யெகோவா தமது உயர்ந்த பரிசுத்த இடத்திலிருந்து கீழே பார்த்தார்;","poem":1},{"text":"அவர் பரலோகத்திலிருந்து பூமியை நோக்கி,","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர் சிறையிருப்பவர்களின் வேதனைக் குரலைக் கேட்கவும்,","poem":1},{"text":"மரணத்தீர்ப்பிற்கு உள்ளானவர்களை விடுதலையாக்கவுமே பார்க்கிறார்.”","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஆகையால் மக்களும் அரசுகளும்","poem":1},{"text":"யெகோவாவை வழிபடுவதற்கு கூடிவரும்போது,","poem":2}]},{"type":"verse","number":22,"content":[{"text":"சீயோனில் யெகோவாவினுடைய பெயரும்","poem":1},{"text":"எருசலேமில் அவருடைய துதியும் அறிவிக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"யெகோவா என் வாழ்க்கைப் பாதையிலே என் பெலனை குறையப்பண்ணினார்;","poem":1},{"text":"என் நாட்களையும் குறுகச்செய்தார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அப்பொழுது நான் அவரிடம் உரைத்தது,","poem":1},{"lineBreak":true},{"text":"“இறைவனே, என் வாழ்நாட்களின் இடையிலேயே என்னை எடுத்துக் கொள்ளாதிரும்;","poem":1},{"text":"உமது வருடங்கள் எல்லாத் தலைமுறைகளுக்கும் நீடித்திருக்கின்றனவே.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நீர் ஆதியிலே பூமிக்கு அஸ்திபாரங்களை அமைத்தீர்;","poem":1},{"text":"வானங்களும் உமது கரங்களின் வேலையாய் இருக்கின்றன.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவை அழிந்துபோகும், நீரோ நிலைத்திருப்பீர்;","poem":1},{"text":"அவையெல்லாம் உடையைப்போல பழமையாய்ப்போகும்;","poem":2},{"text":"உடையைப்போல் நீர் அவைகளை மாற்றுவீர்;","poem":1},{"text":"அவைகளெல்லாம் ஒதுக்கித் தள்ளப்படும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நீரோ மாறாதவராய் நிலைத்திருக்கிறீர்,","poem":1},{"text":"உம்முடைய வருடங்கள் ஒருபோதும் முடிந்து போவதில்லை.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"உமது அடியாரின் பிள்ளைகள் உமது சமுதாயத்தில் குடியிருப்பார்கள்;","poem":1},{"text":"அவர்களுடைய சந்ததியும் உமக்கு முன்பாக நிலைகொண்டிருக்கும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/102.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/103.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/101.json","previousChapterAudioLinks":{},"numberOfVerses":28}