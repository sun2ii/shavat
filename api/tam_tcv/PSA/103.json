{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":103,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என் ஆத்துமாவே, யெகோவாவைத் துதி;","poem":1},{"text":"என் முழு உள்ளமே, அவருடைய பரிசுத்த பெயரைத் துதி.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் ஆத்துமாவே, யெகோவாவைத் துதி;","poem":1},{"text":"அவர் செய்த நன்மைகள் யாவற்றையும் மறவாதே.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர் உன் பாவங்களையெல்லாம் மன்னிக்கிறார்;","poem":1},{"text":"உன்னுடைய நோய்களையெல்லாம் சுகமாக்குகிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் உன் உயிரை மரணக் குழியிலிருந்து மீட்கிறார்,","poem":1},{"text":"உடன்படிக்கையின் அன்பினாலும், இரக்கங்களினாலும் உன்னை முடிசூட்டுகிறார்","poem":2},{"noteId":10},{"text":".","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர் உன் வாழ்வை நன்மையான காரியங்களால் திருப்தியாக்குகிறார்;","poem":1},{"text":"அதினால் உன் இளமை கழுகின் இளமையைப்போல் புதுப்பிக்கப்படுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ஒடுக்கப்படுகிற யாவருக்கும் யெகோவா","poem":1},{"text":"நியாயத்தையும் நீதியையும் செய்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"அவர் தமது வழியை மோசேக்கு வெளிப்படுத்தினார்,","poem":1},{"text":"தமது செயல்களை இஸ்ரயேல் மக்கள் காணும்படிச் செய்தார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவா கருணையும் கிருபையும் உள்ளவர்,","poem":1},{"text":"அவர் கோபிக்கிறதில் தாமதிப்பவரும்","poem":2},{"lineBreak":true},{"text":"உடன்படிக்கையின் அன்பு நிறைந்தவருமாய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் எப்பொழுதும் நம்மேல் குற்றம் சுமத்துகிறவரல்ல;","poem":1},{"text":"தமது கோபத்தை என்றென்றும் வைத்திருக்கவுமாட்டார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நமது பாவங்களுக்கு ஏற்றபடி அவர் நமக்கு செய்யவில்லை,","poem":1},{"text":"நமது அநியாயங்களுக்குத் தக்கதாக நம்மைத் தண்டிப்பதும் இல்லை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஏனெனில் பூமிக்கு மேலாய் வானங்கள் எவ்வளவு உயரமாக இருக்கிறதோ,","poem":1},{"text":"அவருக்குப் பயபக்தியாய் இருக்கிறவர்கள்மேல்","poem":2},{"lineBreak":true},{"text":"அவருடைய உடன்படிக்கையின் அன்பும் அவ்வளவு பெரிதாக இருக்கிறது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மேற்கிலிருந்து கிழக்கு எவ்வளவு தூரமோ,","poem":1},{"text":"அவ்வளவு தூரமாய் அவர் நம்முடைய மீறுதல்களை நம்மைவிட்டு விலக்கிவிட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"தகப்பன் தன் பிள்ளைகளுக்குத் தயை காட்டுவதுபோல்,","poem":1},{"text":"யெகோவாவும் தம்மிடத்தில் பயபக்தியாய் இருக்கிறவர்களுக்கு தயை காட்டுகிறார்;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஏனெனில் நாம் எவ்வாறு உருவாக்கப்பட்டிருக்கிறோம் என்பதை அவர் அறிவார்;","poem":1},{"text":"நாம் தூசி என்பதையும் அவர் நினைவுகூருகிறார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"மனிதர்களுடைய வாழ்க்கை புல்லுக்கு ஒப்பாக இருக்கிறது;","poem":1},{"text":"அவர்கள் வயல்வெளியின் பூவைப்போல் பூக்கிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"காற்று அதின்மேல் வீசுகிறது, அது உதிர்ந்து விழுகிறது;","poem":1},{"text":"அது இருந்த இடமும் அதை நினைவில் கொள்ளாது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆனால் யெகோவாவின் உடன்படிக்கையின் அன்பு","poem":1},{"text":"அவர்மேல் பயபக்தியாய் இருக்கிறவர்களோடும்,","poem":2},{"lineBreak":true},{"text":"அவருடைய நீதி அவர்களுடைய பிள்ளைகளின் பிள்ளைகளோடும் என்றைக்கும் இருக்கிறது;","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவருடைய உடன்படிக்கையைக் கைக்கொண்டு,","poem":1},{"text":"அவருடைய ஒழுங்குவிதிகளுக்குக் கீழ்ப்படிய கவனமாயிருப்பவர்கள் மேல்,","poem":2},{"lineBreak":true},{"text":"அவருடைய உடன்படிக்கையின் அன்பு நிலைத்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யெகோவா தமது சிங்காசனத்தை பரலோகத்தில் நிலைப்படுத்தியிருக்கிறார்;","poem":1},{"text":"அவருடைய அரசு அனைத்தையும் ஆளுகை செய்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"யெகோவாவினுடைய தூதர்களே,","poem":1},{"text":"அவருடைய வார்த்தைக்குக் கீழ்ப்படிந்து,","poem":2},{"lineBreak":true},{"text":"அவர் கட்டளையிடுகிறதைச் செய்கிற பலவான்களே, அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"பரலோகத்தில் உள்ள யெகோவாவினுடைய சேனைகளே,","poem":1},{"text":"அவருடைய திட்டத்தைச் செய்கிற அவருடைய பணியாளர்களே, அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"யெகோவா ஆளுகை செய்கிற எல்லா இடங்களிலுமுள்ள அவருடைய படைப்புகளே,","poem":1},{"text":"அவரைத் துதியுங்கள்.","poem":2},{"lineBreak":true},{"text":"என் ஆத்துமாவே, யெகோவாவைத் துதி.","poem":1}]}],"footnotes":[{"noteId":10,"caller":"+","text":"முடிசூட்டுகிறார் அல்லது ஆசீர்வதிக்கிறார்.","reference":{"chapter":103,"verse":4}}]},"thisChapterLink":"/api/tam_tcv/PSA/103.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/104.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/102.json","previousChapterAudioLinks":{},"numberOfVerses":22}