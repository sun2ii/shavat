{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":104,"content":[{"type":"verse","number":1,"content":[{"text":"என் ஆத்துமாவே, யெகோவாவைத் துதி.","poem":1},{"lineBreak":true},{"text":"என் இறைவனாகிய யெகோவாவே, நீர் எவ்வளவு பெரியவர்;","poem":1},{"text":"மேன்மையையும், மகத்துவத்தையும் நீர் அணிந்திருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யெகோவா ஆடையைப்போல ஒளியை அணிந்துள்ளார்;","poem":1},{"text":"அவர் வானங்களை ஒரு கூடாரத்தைப்போல் விரித்துள்ளார்.","poem":2}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"அவர் தமது மேலறைகளை மழைமேகங்களின் மேலாக அமைக்கிறார்;","poem":2},{"text":"அவர் மேகங்களைத் தமது தேராக்கி,","poem":1},{"text":"காற்றின் சிறகுகள்மேல் செல்கிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் காற்றுகளைத் தமது இறைத்தூதுவர்களாவும்,","poem":1},{"text":"நெருப்பு ஜூவாலைகளைத் தம்முடைய ஊழியர்களாகவும் ஆக்குகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவர் பூமியை அதின் அடித்தளங்கள்மீது அமைத்தார்;","poem":1},{"text":"அது ஒருபோதும் அசைக்கப்படாது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உடையினால் மூடுவது போல் நீர் அதை ஆழ்கடலினால் மூடினீர்;","poem":1},{"text":"வெள்ளம் மலைகளுக்கு மேலாய் நின்றது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனாலும் உமது கண்டிப்பின்முன் வெள்ளம் விலகி ஓடியது;","poem":1},{"text":"உமது முழக்கத்தின் சத்தத்தைக் கேட்டு அது விரைந்து ஓடியது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவைகள் மலைகளுக்கு மேலாய் ஓடி,","poem":1},{"text":"பள்ளத்தாக்குகளில் இறங்கி,","poem":2},{"lineBreak":true},{"text":"நீர் அவைகளுக்கு ஏற்படுத்திய இடத்தில் நின்றன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவைகள் கடக்கமுடியாத ஓர் எல்லையை நீர் ஏற்படுத்தினீர்;","poem":1},{"text":"அவை இனி ஒருபோதும் பூமியை மூடிக்கொள்ளாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அவர் நீரூற்றுகளை பள்ளத்தாக்குகளுக்கு தண்ணீர் பாய்ச்சும்படி செய்கிறார்;","poem":1},{"text":"அது மலைகளுக்கிடையே ஓடுகின்றது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவை வெளியின் மிருகங்கள் அனைத்திற்கும் தண்ணீர் கொடுக்கின்றன;","poem":1},{"text":"காட்டுக் கழுதைகளும் அங்கே தங்களுடைய தாகத்தைத் தீர்த்துக்கொள்கின்றன.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆகாயத்துப் பறவைகள் நீர்நிலைகளின் அருகே கூடு கட்டுகின்றன;","poem":1},{"text":"கிளைகளின் மத்தியிலே அவை பாடுகின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர் தமது மேலறைகளிலிருந்து மலைகளுக்குத் தண்ணீர் பாய்ச்சுகிறார்;","poem":1},{"text":"பூமி அவருடைய செய்கையின் பலனால் திருப்தியடைகிறது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர் மந்தைகளுக்காகப் புல்லையும்,","poem":1},{"text":"மனிதன் பயிரிடும் தாவரங்களையும் வளரச்செய்கிறார்,","poem":2},{"lineBreak":true},{"text":"அவர் பூமியிலிருந்து அவர்களுக்கு உணவு கிடைக்கச் செய்கிறார்:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"மனிதனுடைய இருதயத்தை மகிழ்ச்சியாக்கும் திராட்சை இரசத்தையும்,","poem":1},{"text":"அவனுக்கு முகக்களையை உண்டுபண்ணும் எண்ணெயையும்,","poem":2},{"lineBreak":true},{"text":"அவர்களைப் பெலப்படுத்தும் உணவையும் விளைவிக்கிறார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யெகோவாவினுடைய மரங்களுக்கு, அவர் நாட்டிய லெபனோனின் கேதுரு மரங்களுக்கு","poem":1},{"text":"நல்ல நீர்ப்பாய்ச்சலை கொடுக்கிறார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அங்கே பறவைகள் தம் கூடுகளைக் கட்டுகின்றன;","poem":1},{"text":"கொக்குகள் தேவதாரு மரங்களில் குடியிருக்கின்றன.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உயர்ந்த மலைகள் காட்டாடுகளுக்குச் சொந்தமாயும்,","poem":1},{"text":"செங்குத்தான பாறைகள் குழிமுயல்களுக்குப் புகலிடமாயும் இருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"காலங்களைக் குறிக்க அவர் நிலவைப் படைத்தார்;","poem":1},{"text":"சூரியன் தான் எப்போது மறையவேண்டும் என்பதை அறியும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நீர் இருளைக் கொண்டுவருகிறீர், அப்பொழுது இரவாகின்றது;","poem":1},{"text":"காட்டு மிருகங்கள் எல்லாம் பதுங்கித் திரிகின்றன.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"சிங்கங்கள் தங்கள் இரைக்காகக் கர்ஜிக்கின்றன;","poem":1},{"text":"இறைவனிடமிருந்து அவை தங்களுடைய உணவைத் தேடுகின்றன.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"சூரியன் உதித்ததும் அவை ஒளிந்து ஓடுகின்றன;","poem":1},{"text":"அவை திரும்பிப்போய் தங்கள் குகைகளில் படுத்துக் கொள்கின்றன.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அப்பொழுது மனிதன் தன் வேலைக்குப் போகிறான்;","poem":1},{"text":"மாலையாகும்வரை தன் தொழிலில் ஈடுபடுகின்றான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"யெகோவாவே, உமது செயல்கள் எண்ணற்றவை!","poem":1},{"text":"அவை அனைத்தையும் நீர் ஞானத்தில் படைத்திருக்கிறீர்;","poem":2},{"lineBreak":true},{"text":"பூமி நீர் படைத்த உயிரினங்களால் நிறைந்திருக்கின்றது.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அங்கே விரிந்து பரந்த கடல் உண்டு;","poem":1},{"text":"பெரிதும் சிறிதுமான எண்ணிலடங்கா","poem":2},{"lineBreak":true},{"text":"வாழும் உயிரினங்கள் அங்கே உண்டு.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அங்கே கப்பல்கள் இங்குமங்கும் போகின்றன;","poem":1},{"text":"நீர் உருவாக்கிய லிவியாதானும் அங்கே துள்ளி விளையாடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"நீர் அவைகளுக்கு உரிய நேரத்தில் உணவு கொடுப்பீர் என்று","poem":1},{"text":"அவைகளெல்லாம் உம்மையே பார்த்திருக்கின்றன.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நீர் அதை அவர்களுக்கு வழங்கும்போது,","poem":1},{"text":"அவை சேகரித்துக்கொள்கின்றன;","poem":2},{"text":"நீர் உமது கரத்தைத் திறக்கும்போது,","poem":1},{"text":"அவை நன்மைகளால் திருப்தியடைகின்றன.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"நீர் உமது முகத்தை மறைக்கும்போது,","poem":1},{"text":"அவை திகைக்கின்றன;","poem":2},{"text":"நீர் அவைகளின் சுவாசத்தை எடுத்துவிட,","poem":1},{"text":"அவை இறந்து தூசிக்குத் திரும்புகின்றன.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"நீர் உமது ஆவியை அனுப்புகையில்,","poem":1},{"text":"அவை படைக்கப்படுகின்றன;","poem":2},{"lineBreak":true},{"text":"நீர் பூமியின் மேற்பரப்பைப் புதுப்பிக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":31,"content":[{"text":"யெகோவாவின் மகிமை என்றென்றும் நிலைத்திருப்பதாக;","poem":1},{"text":"யெகோவா தமது செயல்களில் மகிழ்வாராக.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அவர் பூமியைப் பார்க்கும்போது அது நடுங்குகின்றது;","poem":1},{"text":"மலைகளைத் தொடும்போது அவை புகைகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"நான் என் வாழ்நாளெல்லாம் யெகோவாவைப் பாடுவேன்;","poem":1},{"text":"நான் உயிரோடிருக்குமட்டும் என் இறைவனுக்குத் துதி பாடுவேன்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"நான் யெகோவாவிடம் களிகூரும்பொழுது,","poem":1},{"text":"என் தியானமும் அவருக்கு மகிழ்ச்சியாய் இருப்பதாக.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ஆனால் பாவிகள் பூமியிலிருந்து இல்லாமல் போவார்களாக;","poem":1},{"text":"கொடியவர்கள் இனி இல்லாமல் போவார்கள்.","poem":2},{"lineBreak":true},{"text":"என் ஆத்துமாவே யெகோவாவைத் துதி.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/104.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/105.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/103.json","previousChapterAudioLinks":{},"numberOfVerses":35}