{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":105,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்கு நன்றி செலுத்தி, அவருடைய பெயரை பறைசாற்றுங்கள்;","poem":1},{"text":"அவர் செய்தவற்றை நாடுகளுக்குள் தெரியப்படுத்துங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவரைப் பாடுங்கள், அவருக்குத் துதி பாடுங்கள்;","poem":1},{"text":"அவருடைய அதிசயமான செயல்களையெல்லாம் எடுத்துச் சொல்லுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவருடைய பரிசுத்த பெயரில் பெருமிதம் கொள்ளுங்கள்;","poem":1},{"text":"யெகோவாவைத் தேடுகிறவர்களின் இருதயம் மகிழ்வதாக.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவாவையும் அவர் வல்லமையையும் நோக்கிப்பாருங்கள்;","poem":1},{"text":"எப்பொழுதும் அவர் முகத்தையே தேடுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவர் செய்த அதிசயங்களையும், அவருடைய அற்புதங்களையும்,","poem":1},{"text":"அவர் கொடுத்த நியாயத்தீர்ப்புகளையும் நினைவிற்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவருடைய ஊழியராம் ஆபிரகாமின் சந்ததிகளே,","poem":1},{"text":"அவர் தெரிந்துகொண்ட யாக்கோபின் பிள்ளைகளே, நீங்கள் இவற்றை நினைவிற்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவரே நமது இறைவனாகிய யெகோவா;","poem":1},{"text":"அவரது நியாயத்தீர்ப்புகள் பூமியெங்கும் உள்ளன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அவர் தமது உடன்படிக்கையை என்றென்றும் நினைவுகூருகிறார்,","poem":1},{"text":"ஆயிரம் தலைமுறைகளுக்கு அவர் செய்த வாக்குறுதியையும்,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஆபிரகாமோடு அவர் செய்த உடன்படிக்கையையும்,","poem":1},{"text":"ஈசாக்கிற்கு அவர் இட்ட ஆணையையும் நினைவுகூருகிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் அதை யாக்கோபுக்கு ஒரு விதிமுறையாகவும்,","poem":1},{"text":"இஸ்ரயேலுக்கு நித்திய உடன்படிக்கையாகவும் உறுதிப்படுத்திச் சொன்னதாவது:","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“உங்களுடைய உரிமைச்சொத்தாக,","poem":1},{"text":"கானான் நாட்டை நான் உனக்குக் கொடுப்பேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அவர்கள் எண்ணிக்கையில் கொஞ்சமாய்,","poem":1},{"text":"உண்மையிலேயே மிகச் சிலராகவும், வேற்று நாட்டினராகவும் இருந்தபோது,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் ஒரு நாட்டிலிருந்து இன்னொரு நாட்டிற்கும்,","poem":1},{"text":"ஒரு அரசிலிருந்து இன்னொரு அரசிற்கும் அலைந்து திரிந்தார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்களை ஒடுக்குவதற்கு அவர் யாரையும் அனுமதிக்கவில்லை;","poem":1},{"text":"அவர்களுக்காக அவர் அரசர்களைக் கண்டித்துச் சொன்னதாவது:","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“நான் அபிஷேகம் செய்தவர்களைத் தொடவேண்டாம்;","poem":1},{"text":"என் இறைவாக்கினருக்குத் தீமை செய்யவேண்டாம்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"எகிப்து நாட்டிலே அவர் பஞ்சத்தை வரும்படிச் செய்து,","poem":1},{"text":"அவர்களுடைய உணவு விநியோகத்தை நிறுத்தினார்;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர் அடிமையாக விற்கப்பட்ட யோசேப்பை என்ற ஒரு மனிதனை,","poem":1},{"text":"அவர்களுக்குமுன் எகிப்திற்கு அனுப்பிவைத்தார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"எகிப்தியர் அவனுடைய கால்களை விலங்கிட்டு காயப்படுத்தினார்கள்;","poem":1},{"text":"அவனுடைய கழுத்து இரும்புகளால் பிணைக்கப்பட்டது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவன் முன்பு சொன்னவை நிறைவேறுமளவும்,","poem":1},{"text":"யெகோவாவினுடைய வார்த்தை அவனை உண்மையானவன் என்று","poem":2},{"lineBreak":true},{"text":"நிரூபிக்கும் வரைக்கும் அவ்வாறு நடந்தது.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"எகிப்திய அரசன் ஆள் அனுப்பி அவனை விடுவித்தான்;","poem":1},{"text":"மக்களின் அதிகாரி அவனை விடுதலை செய்தான்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அரசன் அவனைத் தன் வீட்டிற்குத் தலைவனாக்கி,","poem":1},{"text":"தன் உடைமைகளுக்கு எல்லாம் அதிபதியாக்கினான்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"தான் விரும்பியபடி இளவரசர்களுக்கு அறிவுறுத்தவும்,","poem":1},{"text":"ஆலோசகர்களுக்கு ஞானத்தைப் போதிக்கவும் அரசன் யோசேப்பை நியமித்தான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"அப்பொழுது இஸ்ரயேல் எகிப்திற்கு வந்தான்;","poem":1},{"text":"யாக்கோபு காமின் நாட்டில் வேறுநாட்டைச் சேர்ந்த ஒருவனைப்போல் வாழ்ந்தான்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"யெகோவா தம் மக்களை பலுகிப் பெருகச்செய்தார்;","poem":1},{"text":"அவர்களுடைய பகைவரைப் பார்க்கிலும், அதிக வலிமை உள்ளவர்களாக்கினார்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவர் எகிப்தியர்கள் இஸ்ரயேலரை வெறுக்கவும்,","poem":1},{"text":"அவருடைய ஊழியருக்கு விரோதமாக சூழ்ச்சி செய்யவும்,","poem":2},{"lineBreak":true},{"text":"எகிப்தியரின் இருதயங்களை மாற்றினார்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவர் தமது அடியானாகிய மோசேயையும்,","poem":1},{"text":"தாம் தெரிந்தெடுத்த ஆரோனையும் அனுப்பினார்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"இவர்கள் எகிப்தியர் மத்தியில் அற்புத அடையாளங்களையும்,","poem":1},{"text":"காமின் நாட்டிலே அதிசயங்களையும் செய்தார்கள்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"யெகோவாவினுடைய வார்த்தைகளுக்கு விரோதமாக","poem":1},{"text":"எகிப்தியர் கலகம் செய்தார்கள் அல்லவோ?","poem":2},{"lineBreak":true},{"text":"அதினால் அவர் இருளை அனுப்பி நாட்டை இருளாக்கினார்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர்களுடைய நீர்நிலைகளை அவர் இரத்தமாக மாற்றினார்,","poem":1},{"text":"அவர்களுடைய மீன்கள் மாண்டுபோனது.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அவர்களுடைய நாடு தவளைகளால் நிறைந்தது;","poem":1},{"text":"அவை அவர்களுடைய ஆளுநர்களின் படுக்கை அறைகளுக்குள்ளும் சென்றன.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"இறைவன் கட்டளையிட, ஈக்கள் கூட்டமாக அங்கே திரண்டு வந்தன;","poem":1},{"text":"கொசுக்கள் எகிப்திய நாடெங்கும் நிறைந்தன.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"அவர் அவர்களுக்கு மழைக்குப் பதிலாக கல்மழையை மின்னலுடன்","poem":1},{"text":"அவர்களுடைய நாடெங்கிலும் வரச்செய்தார்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அவர்களுடைய திராட்சைக் கொடிகளையும், அத்திமரங்களையும் வீழ்த்தி,","poem":1},{"text":"அவர்களுடைய நாட்டிலிருந்த மரங்களை முறித்தார்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"அவர் கட்டளையிட, கணக்கற்ற வெட்டுக்கிளிகளும்,","poem":1},{"text":"பச்சைப்புழுக்களும் வந்தன.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"அவை அவர்களுடைய நாட்டிலிருந்த பசுமையான எல்லாவற்றையும்","poem":1},{"text":"அவர்களுடைய நிலத்தின் விளைச்சல்களையும் தின்று போட்டது.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"பின்பு அவர் எகிப்து நாட்டின் முதற்பிறந்த எல்லாவற்றையும்,","poem":1},{"text":"அவர்களுடைய ஆண்மையின் முதற்பேறான மகன்களையும் மரிக்கச் செய்தார்.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"அவர் இஸ்ரயேலரை நிறைய வெள்ளியோடும் தங்கத்தோடும் புறப்படச் செய்தார்,","poem":1},{"text":"அவர்களுடைய கோத்திரங்களில் ஒருவரும் தளர்ந்து போகவில்லை.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"இஸ்ரயேலரைப் பற்றிய பயம் எகிப்தியரைப் பிடித்திருந்ததால்,","poem":1},{"text":"இஸ்ரயேலர் புறப்பட்டபோது எகிப்தியர் அகமகிழ்ந்தார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"யெகோவா ஒரு மேகத்தை தன் மக்களுக்கு நிழலாகப் பரப்பினார்;","poem":1},{"text":"இரவிலே வெளிச்சம் கொடுப்பதற்கு நெருப்பையும் தந்தார்.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"அவர்கள் கேட்டபோது, அவர்களுக்குக் காடைகளை வரச்செய்தார்;","poem":1},{"text":"பரலோகத்தின் அப்பத்தினால் அவர்களைத் திருப்தியாக்கினார்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"அவர் கற்பாறையைத் பிளந்தார், தண்ணீர் பீறிட்டுப் பாய்ந்தது;","poem":1},{"text":"அது ஒரு நதியைப்போல் பாலைவனத்தில் ஓடியது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":42,"content":[{"text":"ஏனெனில் அவர் தமது அடியானாகிய ஆபிரகாமுக்குத் தாம் கொடுத்த,","poem":1},{"text":"தமது பரிசுத்த வாக்குத்தத்தத்தை நினைவிற்கொண்டார்.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"அவர் தமது மக்களைக் களிப்போடு வெளியே கொண்டுவந்தார்;","poem":1},{"text":"தாம் தெரிந்துகொண்டவர்களை மகிழ்ச்சியின் ஆரவாரத்தோடு வெளியே கொண்டுவந்தார்.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"அவர் பிற நாடுகளை அவர்களுக்குக் கொடுத்தார்;","poem":1},{"text":"அவர்கள் மற்றவர்களின் கடின உழைப்பின் பலனுக்கு உரிமையாளர்கள் ஆனார்கள்.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"அவருடைய ஒழுங்குவிதிகளைக் கைக்கொண்டு,","poem":1},{"text":"அவருடைய சட்டங்களைக் கடைப்பிடிக்கும்படியாகவே,","poem":2},{"lineBreak":true},{"text":"யெகோவா இப்படிச் செய்தார்.","poem":2},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/105.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/106.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/104.json","previousChapterAudioLinks":{},"numberOfVerses":45}