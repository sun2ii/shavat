{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":106,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவைத் துதியுங்கள்","poem":1},{"noteId":11},{"text":".","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்கு நன்றி செலுத்துங்கள், ஏனெனில் அவர் நல்லவர்;","poem":1},{"text":"அவருடைய அன்பு என்றென்றும் நிலைத்திருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யெகோவாவின் வல்லமையான செயல்களைப் பிரசித்தப்படுத்தவும்,","poem":1},{"text":"அவருடைய புகழை முழுமையாக அறிவிக்கவும் யாரால் முடியும்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நியாயமாய் செயல்படுகிறவர்கள்,","poem":1},{"text":"எப்பொழுதும் நீதியானதைச் செய்கிறவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே, நீர் உமது மக்களுக்குத் தயவு காண்பிக்கும்பொழுது,","poem":1},{"text":"என்னையும் நினைவில்கொள்ளும்,","poem":2},{"lineBreak":true},{"text":"நீர் அவர்களை மீட்கும்போது, எனக்கும் உதவிசெய்யும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அதினால் நீர் தெரிந்துகொண்ட மக்களின் நல்வாழ்வை","poem":1},{"text":"அவர்களோடு சேர்ந்து நானும் அனுபவிப்பேன்.","poem":2},{"text":"உமது நாட்டுக்குரிய மகிழ்ச்சியில் நான் பங்குகொள்வேன்;","poem":1},{"text":"உமது உரிமைச்சொத்தாய் இருக்கிறவர்களுடன் இணைந்து உமக்குத் துதி செலுத்துவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"எங்கள் முன்னோர்கள் செய்ததுபோலவே, நாங்களும் பாவம்செய்தோம்,","poem":1},{"text":"நாங்கள் அநியாயம் செய்து, கொடுமையாய் நடந்தோம்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எங்கள் முன்னோர்கள் எகிப்தில் இருந்தபோது,","poem":1},{"text":"அவர்கள் உமது அற்புதங்களைக் கொஞ்சமும் நினைத்துப் பார்க்கவில்லை;","poem":2},{"text":"அவர்கள் உம்முடைய உடன்படிக்கையின் அன்பின் கிரியைகளையும் நினைவில்கொள்ளவில்லை;","poem":1},{"text":"கடலின், செங்கடலின் ஓரத்திலே அவர்கள் கலகம் செய்தார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆனாலும் யெகோவா தமது மகத்தான வல்லமையை அறியப்பண்ணும்படி,","poem":1},{"text":"தமது பெயரின் நிமித்தம் அவர்களைக் இரட்சித்தார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் செங்கடலை அதட்டினார், அது வறண்டுபோயிற்று;","poem":1},{"text":"அவர்களை ஒரு காய்ந்த தரையில் நடத்திச் செல்வதுபோல் அதின் வழியே நடத்தினார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் அவர்களை எதிரிகளின் கைகளிலிருந்து காப்பாற்றினார்;","poem":1},{"text":"பகைவரின் கையிலிருந்து அவர்களை மீட்டுக்கொண்டார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்களுடைய எதிரிகளை வெள்ளம் மூடிக்கொண்டது;","poem":1},{"text":"அவர்களில் ஒருவனும் உயிர் தப்பவில்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அப்பொழுது அவருடைய மக்கள் அவருடைய வாக்குத்தத்தங்களை விசுவாசித்து,","poem":1},{"text":"அவருடைய துதியைப் பாடினார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஆனாலும், அவர் செய்தவற்றை அவர்கள் விரைவாய் மறந்தார்கள்;","poem":1},{"text":"அவருடைய ஆலோசனைக்கு அவர்கள் காத்திருக்கவில்லை.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பாலைவனத்தில் இருக்கும்போதே, அவர்கள் தங்கள் இச்சைக்கு இடங்கொடுத்தார்கள்;","poem":1},{"text":"பாழ்நிலத்திலே அவர்கள் இறைவனைச் சோதித்தார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"எனவே அவர்கள் கேட்டதை அவர் அவர்களுக்குக் கொடுத்தார்;","poem":1},{"text":"ஆனாலும் மனச்சோர்வை அவர்கள்மேல் அனுப்பினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"அவர்கள் முகாமில் இருக்கும்போது மோசேயின்மீதும்,","poem":1},{"text":"யெகோவாவுக்கென்று அர்ப்பணிக்கப்பட்ட ஆரோன் மீதும் பொறாமை கொண்டார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"பூமி பிளந்தது, தாத்தானை விழுங்கியது;","poem":1},{"text":"அபிராமோடு சேர்ந்திருந்தவர்களையும் புதைத்துப் போட்டது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்களைப் பின்பற்றியவர்களின் மத்தியில் நெருப்புப் பற்றியெரிந்தது;","poem":1},{"text":"கொடியவர்களை ஒரு சுவாலை எரித்து அழித்துப்போட்டது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர்கள் ஓரேபில் ஒரு கன்றுக்குட்டியை உண்டுபண்ணி,","poem":1},{"text":"உலோகத்தால் வார்ப்பிக்கப்பட்ட விக்கிரகத்தை வழிபட்டார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்கள் தங்கள் மகிமையான இறைவனைவிட்டு,","poem":1},{"text":"புல்லைத் தின்னும் மாட்டின் உருவத்தைப் பற்றிக்கொண்டார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"எகிப்திலே பெரிய காரியங்களைச் செய்து,","poem":1},{"text":"தங்களைக் காப்பாற்றிய இறைவனை அவர்கள் மறந்தார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"காமின் நாட்டிலே அற்புதங்களையும்,","poem":1},{"text":"செங்கடலிலே பிரமிக்கத்தக்க செயல்களையும் செய்தவரை மறந்தார்கள்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஆதலால் அவர் அவர்களை அழிக்கப்போவதாகக் கூறினார்;","poem":1},{"text":"யெகோவாவினால் தெரிந்துகொள்ளப்பட்ட மோசே,","poem":2},{"text":"யெகோவாவுக்கும் மக்களுக்கும் இடையில் நின்று","poem":1},{"text":"அவருடைய கோபம் அவர்களை அழிக்காதபடிக்கு கெஞ்சினான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"அதின்பின் அவர்கள் நலமான அந்நாட்டை அலட்சியம் செய்தார்கள்;","poem":1},{"text":"அவருடைய வாக்குத்தத்தத்தை அவர்கள் விசுவாசிக்கவில்லை.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"தங்கள் கூடாரங்களில் அவர்கள் முறுமுறுத்து,","poem":1},{"text":"யெகோவாவுக்குக் கீழ்ப்படியாதிருந்தார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ஆகையால் அவர் அவர்களைப் பாலைவனத்திலேயே இறந்துபோகும்படி","poem":1},{"text":"தமது கையை உயர்த்தி அவர்களுக்கு ஆணையிட்டார்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவர்களுடைய சந்ததிகளை பிற நாடுகளிலே சிதறடித்து,","poem":1},{"text":"அவர்களை நாடெங்கும் பரவச்செய்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"அப்பொழுது அவர்கள் தங்களைப் பேயோரிலுள்ள பாகாலுடன் இணைத்துக் கொண்டு,","poem":1},{"text":"உயிரற்ற தெய்வங்களுக்குப் படைக்கப்பட்ட பலிகளைச் சாப்பிட்டார்கள்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"இப்படி அவர்கள் தங்கள் கொடுமையான செயல்களினால்","poem":1},{"text":"யெகோவாவுக்குக் கோபமூட்டினார்கள்;","poem":2},{"lineBreak":true},{"text":"அதினால் அவர்களுக்குள்ளே ஒரு கொள்ளைநோய் பரவியது.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ஆனால் பினெகாஸ் எழுந்து தலையிட்டதால்,","poem":1},{"text":"அந்தக் கொள்ளைநோய் நிறுத்தப்பட்டது.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"அந்த செயல் என்றென்றும் தலைமுறை தலைமுறையாக","poem":1},{"text":"அவனுக்கு நீதியாக எண்ணப்பட்டது.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"மேரிபாவின் தண்ணீர் அருகேயும் அவர்கள் யெகோவாவுக்குக் கோபமூட்டினார்கள்;","poem":1},{"text":"மோசேக்கும் அதினால் துன்பம் ஏற்பட்டது.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"இறைவனுடைய ஆவியானவருக்கு எதிராக அவர்கள் கலகம் செய்தபடியால்,","poem":1},{"text":"மோசேயின் உதடுகளிலிருந்து கடுமையான வார்த்தைகள் வெளிவந்தன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"யெகோவா தாம் கட்டளையிட்டபடி","poem":1},{"text":"அந்த மக்களை அவர் அழிக்கவில்லை.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"மாறாக, அந்த பிற மக்களுடன் கலந்து உறவாடி,","poem":1},{"text":"அவர்களுடைய பழக்கவழக்கங்களைத் தாங்களும் கைக்கொண்டார்கள்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"அவர்களுடைய விக்கிரகங்களையே தாங்களும் வழிபட்டார்கள்;","poem":1},{"text":"அது இஸ்ரயேலருக்கு ஒரு கண்ணியாகியது.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"அவர்கள் தங்கள் மகன்களையும்","poem":1},{"text":"மகள்களையும் விக்கிரகங்களுக்குப் பலியிட்டார்கள்.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"இவ்வாறு தங்கள் மகன் மகள்களுடைய,","poem":1},{"text":"குற்றமில்லாத இரத்தத்தைச் சிந்தினார்கள்;","poem":2},{"text":"அவர்கள் கானானிய விக்கிரகங்களுக்குப் பலியிட்டார்கள்;","poem":1},{"text":"அதினால் நாடு அவர்களுடைய இரத்தத்தால் தூய்மைக்கேடு அடைந்தது.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"அவர்கள் தங்கள் செயல்களினாலே தங்களைக் கறைப்படுத்தினார்கள்;","poem":1},{"text":"அவர்கள் தங்களுடைய செயல்களின் மூலம் விபசாரம் செய்தனர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"ஆதலால், யெகோவா தமது மக்கள்மேல் கோபங்கொண்டார்,","poem":1},{"text":"தமது உரிமைச் சொத்தானவர்களை வெறுத்தார்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"அவர்களைப் பிற நாட்டினரிடம் ஒப்புக்கொடுத்தார்;","poem":1},{"text":"அவர்களுடைய எதிரிகள் அவர்களை ஆளுகை செய்தார்கள்.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"அவர்களுடைய பகைவர்கள் அவர்களை ஒடுக்கி,","poem":1},{"text":"தங்கள் அதிகாரத்திற்குக் கீழ்ப்படுத்தினார்கள்.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"ஆனாலும், யெகோவா பலமுறை அவர்களை விடுவித்தார்;","poem":1},{"text":"அவர்களோ அவருக்கு எதிராக தொடர்ந்து கலகத்திலே நாட்டம் கொண்டு,","poem":2},{"lineBreak":true},{"text":"பாவஞ்செய்து விழுந்து போனார்கள்.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"ஆனாலும் அவர்களுடைய கதறுதலை யெகோவா கேட்டபோதோ,","poem":1},{"text":"அவர்களுடைய துன்பத்தைக் கவனத்தில் கொண்டார்.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"அவர்களுக்காக யெகோவா தமது உடன்படிக்கையை நினைத்து,","poem":1},{"text":"தமது உடன்படிக்கையின் அன்பினால் மனமிரங்கினார்.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"அவர்களைச் சிறைப்பிடித்தவர்கள் அனைவரும்,","poem":1},{"text":"அவர்களுக்கு அனுதாபம் காட்டும்படி செய்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":47,"content":[{"text":"எங்கள் இறைவனாகிய யெகோவாவே, எங்களைக் இரட்சியும்,","poem":1},{"text":"பிற நாடுகளிடமிருந்து எங்களைச் சேர்த்துக்கொள்ளும்;","poem":2},{"text":"அப்பொழுது நாங்கள் உமது பரிசுத்த பெயருக்கு நன்றி செலுத்தி,","poem":1},{"text":"உம்மைத் துதிப்பதில் மேன்மைபாராட்டுவோம்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":48,"content":[{"text":"இஸ்ரயேலின் இறைவனாகிய யெகோவாவுக்கு நித்தியத்திலிருந்து","poem":1},{"text":"நித்தியம் வரைக்கும் துதி உண்டாகட்டும்.","poem":2},{"lineBreak":true},{"text":"மக்கள் அனைவரும் சொல்லட்டும்: “ஆமென்!”","poem":1},{"lineBreak":true},{"text":"யெகோவாவைத் துதி.","poem":1}]}],"footnotes":[{"noteId":11,"caller":"+","text":"துதியுங்கள் என்பது எபிரெய மொழியில் அல்லேலூயா எனப்படும்.","reference":{"chapter":106,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/PSA/106.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/107.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/105.json","previousChapterAudioLinks":{},"numberOfVerses":48}