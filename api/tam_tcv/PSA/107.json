{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":107,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்கு நன்றி செலுத்துங்கள், அவர் நல்லவர்;","poem":1},{"text":"அவர் அன்பு என்றென்றும் நிலைத்திருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யெகோவாவினால் மீட்கப்பட்டவர்கள்,","poem":1},{"text":"எதிரிகளின் கையிலிருந்து அவரால் விடுதலையாக்கப்பட்டவர்கள்,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"கிழக்கிலும் மேற்கிலும் வடக்கிலும்","poem":1},{"text":"தெற்கிலுமிருக்கும் பல நாடுகளிலிருந்தும் சேர்க்கப்பட்டவர்கள் இதைச் சொல்லட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"சிலர் தாங்கள் குடியிருக்கத்தக்க பட்டணத்திற்குப் போகும் வழியைக் காணாமல்,","poem":1},{"text":"பாலைவனத்தின் பாழ்நிலங்களிலே அலைந்து திரிந்தார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர்கள் பசியாயும் தாகமாயும் இருந்தார்கள்,","poem":1},{"text":"அவர்களுடைய ஆத்துமா சோர்ந்துபோயிற்று.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அப்பொழுது அவர்கள் தங்கள் கஷ்டத்திலே யெகோவாவை நோக்கிக் கூப்பிட்டார்கள்,","poem":1},{"text":"அவர் அவர்களுடைய துன்பத்திலிருந்து அவர்களை விடுவித்தார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"குடியிருக்கத்தக்க ஒரு பட்டணத்திற்கு","poem":1},{"text":"அவர் அவர்களை பாதுகாப்பாக வழிநடத்தினார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவாவினுடைய உடன்படிக்கையின் அன்பினிமித்தமும்,","poem":1},{"text":"அவர் மனிதருக்குச் செய்யும் அதிசயமான செயல்களின் நிமித்தமும்","poem":2},{"lineBreak":true},{"text":"நன்றி செலுத்துவார்களாக.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏனெனில் தாகமுள்ளவர்களை அவர் திருப்தியாக்குகிறார்;","poem":1},{"text":"பசியாய் இருப்பவர்களை நன்மையினால் நிரப்புகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"சிலர் இருளிலும் காரிருளிலும் உட்கார்ந்தார்கள்,","poem":1},{"text":"சிறைக் கைதிகள் இரும்புச் சங்கிலிகளில் கட்டுண்டு வேதனைப்பட்டார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஏனெனில், அவர்கள் இறைவனுடைய கட்டளைகளுக்கு விரோதமாய்க் கலகம்செய்து,","poem":1},{"text":"மகா உன்னதமான இறைவனின் ஆலோசனையை அசட்டைபண்ணினார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆகவே அவர் அவர்களைக் கடினமான வேலைக்குட்படுத்தினார்;","poem":1},{"text":"அவர்கள் இடறி விழுந்தார்கள்; அவர்களுக்கு உதவிசெய்ய ஒருவருமே இருக்கவில்லை.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அப்பொழுது அவர்கள் தங்கள் கஷ்டத்திலே யெகோவாவை நோக்கிக் கதறினார்கள்;","poem":1},{"text":"அவர் அவர்களுடைய துன்பத்திலிருந்து அவர்களை காப்பாற்றினார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர் அவர்களை, இருட்டிலிருந்தும்","poem":1},{"text":"ஆழ்ந்த இருளிலிருந்தும் வெளியே கொண்டுவந்து,","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய சங்கிலிகளை அறுத்தெறிந்தார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"யெகோவாவினுடைய உடன்படிக்கையின் அன்பினிமித்தமும்,","poem":1},{"text":"அவர் மனிதருக்குச் செய்யும் அதிசயமான செயல்களினிமித்தமும்","poem":2},{"lineBreak":true},{"text":"நன்றி செலுத்துவார்களாக.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஏனெனில் யெகோவா வெண்கல வாசல்களை உடைத்தெறிகிறார்;","poem":1},{"text":"இரும்புத் தாழ்ப்பாள்களை வெட்டிப் பிளக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"சிலர் தங்களுடைய கலக வழிகளின் காரணமாக மூடராகி,","poem":1},{"text":"தங்கள் அநியாயத்தினிமித்தம் உபத்திரவத்தை அனுபவித்தார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்கள் எல்லா உணவையும் அருவருத்து,","poem":1},{"text":"மரண வாசல்களை நெருங்கினார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அப்பொழுது அவர்கள் தங்கள் கஷ்டத்திலே யெகோவாவை நோக்கிக் கதறினார்கள்;","poem":1},{"text":"அவர் அவர்களுடைய துன்பத்திலிருந்து அவர்களை காப்பாற்றினார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர் தமது வார்த்தையை அனுப்பி, அவர்களைச் சுகப்படுத்தினார்;","poem":1},{"text":"அவர் அவர்களை மரணக் குழிகளிலிருந்து தப்புவித்தார்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"யெகோவாவினுடைய உடன்படிக்கையின் அன்பினிமித்தமும்,","poem":1},{"text":"அவர் மனிதருக்குச் செய்யும் அதிசயமான செயல்களினிமித்தமும்","poem":2},{"lineBreak":true},{"text":"நன்றி செலுத்துவார்களாக.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவர்கள் நன்றிக் காணிக்கைகளைப் பலியிட்டு,","poem":1},{"text":"மகிழ்ச்சியின் பாடல்களால் அவருடைய செயல்களை அறிவிக்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"சிலர் கப்பல்களில் ஏறிக் கடல்மேல் போனார்கள்;","poem":1},{"text":"அவர்கள் கடலின் திரளான தண்ணீரின்மேல் தொழில் செய்தார்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவர்கள் யெகோவாவினுடைய செயல்களையும்,","poem":1},{"text":"ஆழத்தில் அவர் செய்த புதுமையான செயல்களையும் கண்டார்கள்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"ஏனெனில் அவர் ஒரு வார்த்தை சொல்ல, புயல்காற்று எழும்பிற்று;","poem":1},{"text":"அது அலைகளை உயர எழச்செய்தது.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவர்கள் வானங்கள்வரை ஏறி, ஆழங்கள்வரை இறங்கிச் சென்றனர்;","poem":1},{"text":"அவர்களுடைய ஆபத்தில் அவர்களுடைய தைரியம் பயனற்றுப்போனது.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவர்கள் வெறியரைப்போல் உருண்டு புரண்டார்கள்;","poem":1},{"text":"அவர்களால் ஒன்றும் செய்யமுடியாமல் போயிற்று.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அப்பொழுது அவர்கள் தங்கள் கஷ்டத்திலே யெகோவாவை நோக்கிக் கதறினார்கள்;","poem":1},{"text":"அவர் அவர்களுடைய துன்பத்திலிருந்து அவர்களை காப்பாற்றினார்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர் புயல்காற்றை தென்றல்போல் அமைதியாக்கினார்;","poem":1},{"text":"கடலின் அலைகள் அடங்கிப்போயின.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"அது அமைதியானபோது அவர்கள் மகிழ்ந்தார்கள்;","poem":1},{"text":"அவர்கள் விரும்பிய துறைமுகத்திற்குப் போக அவர் அவர்களுக்கு வழிகாட்டினார்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"யெகோவாவினுடைய உடன்படிக்கையின் அன்பினிமித்தமும்,","poem":1},{"text":"அவர் மனிதருக்குச் செய்யும் அதிசயமான செயல்களினிமித்தமும்","poem":2},{"lineBreak":true},{"text":"நன்றி செலுத்துவார்களாக.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"மக்களின் சபையில் அவர்கள் அவரை புகழ்ந்துயர்த்தி,","poem":1},{"text":"தலைவர்களின் ஆலோசனை சபையிலே அவரைத் துதிக்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":33,"content":[{"text":"யெகோவா ஆறுகளைப் பாலைவனமாகவும்,","poem":1},{"text":"சுரக்கும் நீரூற்றுகளை வறண்ட தரையாகவும் மாற்றினார்,","poem":2}]},{"type":"verse","number":34,"content":[{"text":"செழிப்பான நாட்டை உவர் நிலமாக மாற்றினார்;","poem":1},{"text":"அங்கே வசித்தவர்களின் கொடுமையின் நிமித்தமே அவ்வாறு செய்தார்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"அவர் பாலைவனத்தை நீர்த்தடாகங்களாகவும்,","poem":1},{"text":"வறண்ட நிலத்தை சுரக்கும் நீரூற்றாகவும் மாற்றினார்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"பசியுள்ளவர்களை அங்கே குடியிருக்கும்படி கொண்டுவந்தார்;","poem":1},{"text":"அங்கே அவர்கள் தாங்கள் குடியிருக்கத்தக்க ஒரு பட்டணத்தைக் கட்டினார்கள்.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"அவர்கள் வயல்வெளிகளில் விதைத்து, திராட்சைத் தோட்டங்களை உண்டாக்கினார்கள்;","poem":1},{"text":"அவை செழிப்பான அறுவடையைக் கொடுத்தன.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"யெகோவா அவர்களை ஆசீர்வதித்தார், அவர்கள் எண்ணிக்கை வெகுவாய்ப் பெருகியது;","poem":1},{"text":"அவர்களுடைய மந்தைகள் குறைந்துபோக அவர் விடவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"பின்பு இறைவனது மக்களின் எண்ணிக்கை குறைந்தது,","poem":1},{"text":"அவர்கள் ஒடுக்குதலினாலும் இடுக்கணினாலும் கவலையினாலும் சிறுமையடைந்தார்கள்;","poem":2}]},{"type":"verse","number":40,"content":[{"text":"பெருமையான அதிகாரிகளின்மேல் இகழ்வை வரப்பண்ணும் அவரே,","poem":1},{"text":"அவர்களைப் பாதையற்ற பாழ்நிலத்தில் அலையப்பண்ணினார்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"ஆனால் எளியவர்களை அவர்களுடைய துன்பத்திலிருந்து தூக்கியெடுத்து,","poem":1},{"text":"அவர்களுடைய குடும்பங்களை மந்தையைப்போல் பெருகப்பண்ணினார்.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"நீதிமான்கள் அதைக்கண்டு மகிழ்கிறார்கள்;","poem":1},{"text":"ஆனால் கொடியவர்கள் அனைவரும் வாயடைத்துப் போய்விடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":43,"content":[{"text":"ஞானமுள்ளவன் எவனோ அவன் இதைக் கவனித்துக் கொள்ளட்டும்;","poem":1},{"text":"யெகோவாவின் உடன்படிக்கையின் அன்பின் செயல்களைப்பற்றி சிந்திக்கட்டும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/107.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/108.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/106.json","previousChapterAudioLinks":{},"numberOfVerses":43}