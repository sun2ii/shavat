{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":108,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதமாகிய பாடல்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, என் இருதயம் உறுதியாயிருக்கிறது;","poem":1},{"text":"நான் என் முழு ஆத்துமாவோடும் இசையமைத்துப் பாடுவேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யாழே, வீணையே, விழித்தெழுங்கள்,","poem":1},{"text":"நான் அதிகாலையை விழித்தெழச் செய்வேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே, நாடுகள் மத்தியில் நான் உம்மைத் துதிப்பேன்;","poem":1},{"text":"மக்கள் மத்தியில் நான் உம்மைப் பாடுவேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஏனெனில் உமது உடன்படிக்கையின் அன்பு பெரியது,","poem":1},{"text":"அது வானங்களைப் பார்க்கிலும் உயர்ந்தது;","poem":2},{"lineBreak":true},{"text":"உமது சத்தியம் ஆகாயங்களை எட்டுகிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறைவனே, வானங்களுக்கு மேலாக புகழ்ந்து உயர்த்தப்படுவீராக;","poem":1},{"text":"உமது மகிமை பூமியெங்கும் இருக்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நீர் நேசிப்பவர்கள் மீட்கப்படும்படி, நீர் எங்களைக் காப்பாற்றி,","poem":1},{"text":"உமது வலதுகரத்தின் வல்லமையினால் எங்களுக்கு உதவிசெய்யும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இறைவன் தமது பரிசுத்த இடத்திலிருந்து பேசியது:","poem":1},{"text":"“நான் வெற்றிகொண்டு சீகேமைப் பிரித்தெடுப்பேன்;","poem":2},{"lineBreak":true},{"text":"சுக்கோத்தின் பள்ளத்தாக்கை அளந்துகொடுப்பேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"கீலேயாத் என்னுடையது, மனாசேயும் என்னுடையது;","poem":1},{"text":"எப்பிராயீம் என் தலைக்கவசம்,","poem":2},{"lineBreak":true},{"text":"யூதா என் செங்கோல்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மோவாப் என் கழுவும் பாத்திரம்,","poem":1},{"text":"நான் ஏதோமின்மீது என் காலணியை எறிவேன்;","poem":2},{"lineBreak":true},{"text":"நான் பெலிஸ்தியாவை வென்று முழக்கமிடுவேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அரண்சூழ்ந்த நகரத்திற்கு யார் என்னைக் கொண்டுவருவார்?","poem":1},{"text":"யார் என்னை ஏதோமுக்கு வழிநடத்துவார்?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"இறைவனே, எங்களைப் புறக்கணித்தவரும்,","poem":1},{"text":"எங்கள் படைகளுடன் போகாதிருந்தவரும் நீரல்லவா?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பகைவரை மேற்கொள்ள எங்களுக்கு உதவும்;","poem":1},{"text":"ஏனெனில் மனிதனின் உதவியோ பயனற்றது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இறைவனாலேயே நாம் வெற்றிபெறுவோம்;","poem":1},{"text":"அவர் நமது பகைவரை மிதித்துப்போடுவார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":13}