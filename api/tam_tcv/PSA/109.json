{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":109,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, நான் துதிக்கும் இறைவனே,","poem":1},{"text":"நீர் மவுனமாய் இருக்கவேண்டாம்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"கொடுமையும், வஞ்சனையும் உள்ளவர்கள்,","poem":1},{"text":"தங்கள் வாய்களை எனக்கு விரோதமாகத் திறந்திருக்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"பொய் நாவுகளால் எனக்கு விரோதமாகப் பேசுகிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் பகைமை நிறைந்த சொற்களுடன் என்னைச் சூழ்ந்துகொள்கிறார்கள்;","poem":1},{"text":"காரணமின்றி என்னைத் தாக்குகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் என் நட்புக்குப் பதிலாக என்னைக் குற்றம் சாட்டுகிறார்கள்,","poem":1},{"text":"நானோ மன்றாடும் மனிதனாகவே இருக்கிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர்கள் நன்மைக்குப் பதிலாக, எனக்குத் தீமை செய்கிறார்கள்;","poem":1},{"text":"என் நட்புக்குப் பதிலாக என்னை வெறுக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"என் பகைவனை எதிர்ப்பதற்கு ஒரு தீயவனை ஏற்படுத்தும்;","poem":1},{"text":"அவன் வலதுபக்கத்தில் நின்று அவனைக் குற்றஞ்சாட்டுவானாக.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவன் நியாயம் விசாரிக்கப்படும்போது குற்றவாளியாய் காணப்படட்டும்;","poem":1},{"text":"அவன் மன்றாட்டுகளும் அவனையே குற்றவாளியாய்த் தீர்ப்பதாக.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவன் வாழ்நாட்கள் கொஞ்சமாவதாக;","poem":1},{"text":"அவனுடைய பதவியை மற்றவர்கள் எடுத்துக்கொள்வார்களாக.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவன் பிள்ளைகள் தந்தையற்றவர் ஆகட்டும்,","poem":1},{"text":"அவன் மனைவி விதவையாகட்டும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவன் பிள்ளைகள் அலைந்து திரிந்து பிச்சையெடுக்கட்டும்;","poem":1},{"text":"அவர்கள் தங்கள் பாழடைந்த வீடுகளிலிருந்தும் துரத்தப்படுவார்களாக.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"கடன் கொடுத்தவன் அவனுக்குரிய எல்லாவற்றையும் பறித்துக் கொள்வானாக;","poem":1},{"text":"அவனுடைய பிரயாசத்தின் பலனை பிறர் கொள்ளையிடுவார்களாக.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஒருவருமே அவனுக்கு தயவுகாட்டாமலும்,","poem":1},{"text":"அவனுடைய திக்கற்ற பிள்ளைகளுக்கு அனுதாபப்படாமலும் இருப்பார்களாக.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவன் சந்ததிகள் மறைந்துபோவார்களாக;","poem":1},{"text":"அவன்","poem":2},{"noteId":12},{"text":"பெயர் அடுத்த தலைமுறையிலிருந்து இல்லாமல் போவதாக.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவன் முற்பிதாக்களின் அநியாயம் யெகோவாவுக்கு முன்பாக நினைக்கப்படுவதாக;","poem":1},{"text":"அவர்களுடைய தாயின் பாவம் ஒருபொழுதும் நீங்காதிருப்பதாக.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஏனெனில் அவர்களுடைய பாவங்கள் எப்பொழுதுமே","poem":1},{"text":"யெகோவாவுக்கு முன்பாக நிலைத்திருக்கட்டும்;","poem":2},{"lineBreak":true},{"text":"அவர் அவர்களுடைய நினைவையும் பூமியிலிருந்து அகற்றட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"ஏனெனில் அவன் ஒருபோதும் நன்மை செய்வதைப்பற்றி நினைத்ததில்லை;","poem":1},{"text":"மாறாக ஏழைகளையும், எளியவர்களையும்,","poem":2},{"lineBreak":true},{"text":"உள்ளம் உடைந்தவர்களையும் கொலைசெய்யத் தேடினான்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"சாபம் இடுவதையே அவன் விரும்பினான்;","poem":1},{"text":"அவன் இட்ட சாபம் அவன் மேலேயே வருவதாக;","poem":2},{"text":"ஆசீர்வதிப்பதை அவன் விரும்பவில்லை,","poem":1},{"text":"ஆசீர்வாதம் அவனுக்குத் தூரமாவதாக.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவன் சாபத்தையே தன் உடையாக அணிந்துகொண்டான்;","poem":1},{"text":"அது அவன் உடலுக்குள் தண்ணீரைப்போலவும்,","poem":2},{"lineBreak":true},{"text":"அவன் எலும்புகளுக்குள் எண்ணெயைப்போலவும் புகுந்தது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"சாபம் அவனைப் போர்த்தும் மேலங்கியைப்போல் இருப்பதாக;","poem":1},{"text":"அது அவனைச்சுற்றி கட்டப்பட்ட இடைக்கச்சையைப் போலவும் எப்போதும் இருப்பதாக.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"என்னைக் குற்றம் சாட்டுகிறவர்களுக்கும்,","poem":1},{"text":"என்னைக்குறித்துத் தீமையாய்ப் பேசுகிறவர்களுக்கும்","poem":2},{"lineBreak":true},{"text":"இதுவே யெகோவாவினால் கொடுக்கப்படும் தண்டனையாய் இருப்பதாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"ஆனால், ஆண்டவராகிய யெகோவாவே,","poem":1},{"text":"நீர் உமது பெயரினிமித்தம் என்னை நன்றாய் நடத்தும்;","poem":2},{"lineBreak":true},{"text":"உமது அன்பின் நன்மையினிமித்தம் என்னை விடுவியும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஏனெனில் நான் ஏழையும் எளியவனுமாய் இருக்கிறேன்,","poem":1},{"text":"என் இருதயம் எனக்குள் காயப்பட்டிருக்கிறது.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நான் ஒரு மாலை நிழல்போல் மங்கிப்போகிறேன்;","poem":1},{"text":"ஒரு வெட்டுக்கிளியைப்போல் உதறிப் போடப்படுகிறேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"உபவாசத்தினால் என் முழங்கால்கள் சோர்ந்துபோகின்றன;","poem":1},{"text":"என் உடல் மெலிந்து போயிருக்கிறது.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"என்னைக் குற்றம் சாட்டுகிறவர்களுக்கு நான் ஓர் இகழ்ச்சிப் பொருளானேன்;","poem":1},{"text":"அவர்கள் என்னைப் பார்க்கும்போது, ஏளனமாய் தங்கள் தலைகளை அசைக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"யெகோவாவே, என் இறைவனே, எனக்கு உதவிசெய்யும்;","poem":1},{"text":"உமது அன்பின்படியே என்னைக் காப்பாற்றும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"யெகோவாவே, உமது கரமே அதைச் செய்தது என்றும்,","poem":1},{"text":"நீரே அதைச் செய்தீர் என்றும் அவர்கள் அறியட்டும்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவர்கள் என்னைச் சபித்தாலும், நீர் என்னை ஆசீர்வதிப்பீர்;","poem":1},{"text":"அவர்கள் என்னைத் தாக்கும் வேளையில் அவர்கள் வெட்கத்திற்குட்படுவார்கள்;","poem":2},{"lineBreak":true},{"text":"ஆனால் உமது அடியானாகிய நான் களிகூருவேன்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"என்னைக் குற்றம் சாட்டுகிறவர்கள் அவமானத்தால் மூடப்படுவார்கள்;","poem":1},{"text":"ஓர் அங்கியினால் போர்த்தப்படுவதுபோல் அவர்கள் வெட்கத்தால் போர்த்தப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"நான் யெகோவாவை என் வாயினால் பெரிதும் புகழ்ந்து உயர்த்துவேன்;","poem":1},{"text":"பெருங்கூட்டத்தில் நான் அவரைத் துதிப்பேன்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"ஏனெனில் அவர் வறுமைப்பட்டவனுடைய வலதுபக்கத்தில் நிற்கிறார்;","poem":1},{"text":"அவனைக் குற்றவாளியாய்த் தீர்ப்பிடுகிறவர்களிடமிருந்து","poem":2},{"lineBreak":true},{"text":"அவனுடைய உயிரைக் காப்பாற்ற நிற்கிறார்.","poem":2}]}],"footnotes":[{"noteId":12,"caller":"+","text":"அவன் அல்லது அவர்களுடைய","reference":{"chapter":109,"verse":13}}]},"thisChapterLink":"/api/tam_tcv/PSA/109.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/110.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/108.json","previousChapterAudioLinks":{},"numberOfVerses":31}