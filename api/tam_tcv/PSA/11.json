{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":11,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நான் யெகோவாவிடத்தில் தஞ்சமடைகிறேன்.","poem":1},{"text":"அப்படியிருக்க நீங்கள் என்னிடம் எப்படி இவ்வாறு சொல்லமுடியும்:","poem":2},{"lineBreak":true},{"text":"“ஒரு பறவையைப்போல உன்னுடைய மலைக்குத் தப்பிப்போ.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பாருங்கள், கொடியவர்கள் தங்கள் வில்லுகளை வளைக்கிறார்கள்;","poem":1},{"text":"நேர்மையான இருதயம் உள்ளவர்மேல்","poem":2},{"text":"இருளிலிருந்து எய்வதற்காக","poem":1},{"text":"தங்கள் அம்புகளை நாணேற்றுகிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அஸ்திபாரங்கள் அழிக்கப்படும்போது,","poem":1},{"text":"நீதிமான்கள் என்ன செய்யமுடியும்?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவா தமது பரிசுத்த ஆலயத்தில் இருக்கிறார்;","poem":1},{"text":"யெகோவா தமது பரலோக சிங்காசனத்தில் அமர்ந்திருக்கிறார்.","poem":2},{"text":"அவர் மனுமக்களை உற்று நோக்குகிறார்;","poem":1},{"text":"அவருடைய கண்கள் அவர்களை ஆராய்ந்து பார்க்கின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவா நீதிமான்களை ஆராய்ந்தறிகிறார்;","poem":1},{"text":"வன்முறைகளை விரும்புகிற கொடியவர்களையோ,","poem":2},{"lineBreak":true},{"text":"அவர் மனதார வெறுக்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் கொடியவர்களின்மேல் நெருப்புத் தணல்களையும்,","poem":1},{"text":"எரியும் கந்தகத்தையும் பெய்யப்பண்ணுவார்;","poem":2},{"lineBreak":true},{"text":"வறட்சியான காற்றே அவர்களின் பங்காயிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவா நீதியுள்ளவர்,","poem":1},{"text":"அவர் நீதியை நேசிக்கிறார்;","poem":2},{"lineBreak":true},{"text":"நேர்மையான மனிதர் அவர் முகத்தைக் காண்பார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}