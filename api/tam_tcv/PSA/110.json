{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":110,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா, என் ஆண்டவரிடம் சொன்னதாவது:","poem":1},{"lineBreak":true},{"text":"“நான் உமது பகைவரை","poem":1},{"text":"உமது கால்களுக்குப் பாதபடி ஆக்கும்வரை","poem":2},{"lineBreak":true},{"text":"நீர் என் வலதுபக்கத்தில் அமர்ந்திரும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யெகோவா உமது வல்லமையான செங்கோலை சீயோனிலிருந்து விரிவுபடுத்துவார்;","poem":1},{"text":"“நீர் உமது பகைவரின் மத்தியில் ஆளுகை செய்வீர்!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உமது மக்கள் உமது யுத்தத்தின் நாளில்,","poem":1},{"text":"தாங்களாகவே முன்வருவார்கள்;","poem":2},{"text":"அதிகாலையின் கருப்பையிலிருந்து வரும் பனியைப்போல்","poem":1},{"text":"உமது வாலிபர்கள்","poem":2},{"lineBreak":true},{"text":"பரிசுத்த அணிவகுப்புடன் வருவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“மெல்கிசேதேக்கின் முறைமையின்படி,","poem":1},{"text":"நீர் என்றென்றைக்கும் ஆசாரியராகவே இருக்கிறீர்”","poem":2},{"noteId":13},{"text":"என்று யெகோவா ஆணையிட்டிருக்கிறார்;","poem":1},{"text":"அவர் தமது மனதை மாற்றமாட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவா உமது வலதுபக்கத்தில் இருக்கிறார்;","poem":1},{"text":"அவர் தமது கோபத்தின் நாளில் அரசர்களை தண்டிப்பார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் பிற நாடுகளை நியாயந்தீர்ப்பார்;","poem":1},{"text":"இறந்தவர்களைக் குவித்துப் பூமி முழுவதிலும் உள்ள ஆளுநர்களை தண்டிப்பார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"வழியில் உள்ள நீரோடையிலிருந்து அவர் தண்ணீர் குடிப்பார்;","poem":1},{"text":"ஆகையால் அவர் தமது தலைநிமிர்ந்து நிற்பார்.","poem":2}]}],"footnotes":[{"noteId":13,"caller":"+","text":"எபி. 5:6","reference":{"chapter":110,"verse":4}}]},"thisChapterLink":"/api/tam_tcv/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}