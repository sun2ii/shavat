{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":111,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா,","poem":1},{"lineBreak":true},{"text":"நீதிமான்களின் கூட்டத்திலும் சபையிலும்","poem":1},{"text":"நான் முழு இருதயத்தோடும் யெகோவாவைப் புகழ்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யெகோவாவின் செயல்கள் மகத்தானவை;","poem":1},{"text":"அவைகளால் மகிழ்ச்சியடையும் எல்லோராலும் அவை சிந்திக்கப்படுகின்றன.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவருடைய செயல்கள் மகிமையும், மகத்துவமுமானவை;","poem":1},{"text":"அவருடைய நீதி என்றென்றைக்கும் நிலைத்திருக்கிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் தமது அதிசய செயல்களை நமது நினைவை விட்டு விலகாதபடிச் செய்திருக்கிறார்;","poem":1},{"text":"யெகோவா கிருபையும், கருணையும் உள்ளவராய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர் தமக்குப் பயந்து நடக்கிறவர்களுக்கு உணவு கொடுக்கிறார்;","poem":1},{"text":"அவர் தமது உடன்படிக்கையை என்றென்றும் நினைவில் வைத்திருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவர் பிற நாடுகளைத் தம் மக்களுக்குக் கொடுத்து,","poem":1},{"text":"தமது வல்லமையை அவர்களுக்குக் காண்பித்திருக்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவருடைய கரங்களின் செயல்கள் உண்மையும் நீதியுமானவை;","poem":1},{"text":"அவருடைய ஒழுங்குவிதிகள் அனைத்தும் நம்பத்தகுந்தவை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவை என்றென்றும் உறுதியானவை;","poem":1},{"text":"உண்மையுடனும், நேர்மையுடனும் கொடுக்கப்பட்டவை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் தமது மக்களுக்கு மீட்பைக் கொடுத்தார்;","poem":1},{"text":"அவர் தம் உடன்படிக்கையை என்றென்றுமாய் நியமித்திருக்கிறார்;","poem":2},{"lineBreak":true},{"text":"பரிசுத்தமும் மற்றும் பயபக்தி என்பது அவருடைய பெயராயிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவாவுக்குப் பயப்படுதலே ஞானத்தின் ஆரம்பம்;","poem":1},{"text":"அவருடைய ஒழுங்குவிதிகளைப் பின்பற்றும் அனைவருக்கும் நற்புத்தியுண்டு.","poem":2},{"lineBreak":true},{"text":"நித்தியமான துதி அவருக்கே உரியது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}