{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":112,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா.","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்குப் பயந்து நடக்கிறவனும்,","poem":1},{"text":"அவருடைய கட்டளைகளில் மகிழ்ச்சியடைகிறவனும் ஆசீர்வதிக்கப்பட்டவன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அவனுடைய பிள்ளைகள் நாட்டில் பலமுள்ளவர்களாய் இருப்பார்கள்;","poem":1},{"text":"நீதிமான்களின் தலைமுறைகள் எல்லாம் ஆசீர்வதிக்கப்பட்டிருக்கும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"செல்வமும் சொத்துக்களும் அவன் வீட்டிலிருக்கும்;","poem":1},{"text":"அவனுடைய நீதி என்றும் நிலைக்கிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீதிமான்களுக்கு இருளிலும் வெளிச்சம் உதிக்கும்;","poem":1},{"text":"ஏனெனில் அவர்கள் இரக்கமும், கருணையும், நீதியுமுள்ளவர்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தாராள மனதுடன் கடன்கொடுத்து,","poem":1},{"text":"தன் காரியங்களை நீதியுடன் நடப்பிக்கிறவனுக்கு நன்மை உண்டாகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நிச்சயமாய் அவன் ஒருபோதும் அசைக்கப்படமாட்டான்;","poem":1},{"text":"நீதிமானை மக்கள் நீடித்த காலத்திற்கு நினைவிற்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"துர்ச்செய்தியின் பயம் அவனுக்கு இருக்காது;","poem":1},{"text":"அவனுடைய இருதயம் யெகோவாவை நம்பி உறுதியாய் இருக்கிறது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவனுடைய இருதயம் பாதுகாப்பாய் இருக்கிறது, அவனுக்குப் பயமே இருக்காது;","poem":1},{"text":"கடைசியில் வெற்றிப் பெருமிதத்தோடு தன் எதிரிகளைப் பார்ப்பான்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவன் ஏழைகளுக்கு அன்பளிப்புகளை அள்ளிக்கொடுப்பான்;","poem":1},{"text":"அவனுடைய நீதி என்றென்றும் நிலைத்திருக்கிறது;","poem":2},{"lineBreak":true},{"text":"அவன் மதிப்பிற்குரியவனாய் தலைநிமிர்ந்து நடப்பான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"கொடுமையானவன் அதைக்கண்டு ஏமாற்றமடைவான்;","poem":1},{"text":"அவன் தன் பற்களை கடித்துக்கொண்டு அழிந்துபோவான்;","poem":2},{"lineBreak":true},{"text":"கொடுமையுள்ளவர்களின் ஆசைகள் நிறைவேறாமற் போகும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}