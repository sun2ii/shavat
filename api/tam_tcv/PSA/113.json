{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":113,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா,","poem":1},{"lineBreak":true},{"text":"யெகோவாவின் பணியாட்களே, துதியுங்கள்;","poem":1},{"text":"யெகோவாவினுடைய பெயரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவின் பெயர் இப்பொழுதும்,","poem":1},{"text":"எப்பொழுதும் துதிக்கப்படட்டும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"சூரியன் உதிக்கும் இடத்திலிருந்து அது மறையும் இடம்வரை","poem":1},{"text":"யெகோவாவினுடைய பெயர் துதிக்கப்படட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவா எல்லா நாடுகளுக்கும் மேலாக புகழ்ந்து உயர்த்தப்பட்டிருக்கிறார்;","poem":1},{"text":"அவருடைய மகிமை வானங்களுக்கு மேலாக இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நம்முடைய இறைவனாகிய யெகோவாவைப்போல் யாருண்டு?","poem":1},{"text":"உன்னதத்தின் சிங்காசனத்தில் அமர்ந்திருக்கிற அவரைப்போல் யார் உண்டு?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வானங்களையும் பூமியையும் பார்க்கும்படி","poem":1},{"text":"தம்மைத் தாழ்த்துகிற அவரைப்போல் யாருண்டு?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"அவர் ஏழைகளைத் தூசியிலிருந்து உயர்த்துகிறார்,","poem":1},{"text":"எளியவர்களைச் சாம்பற் குவியலில் இருந்து தூக்கிவிடுகிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர் தமது மக்களைப் பிரபுக்களோடு அமரப்பண்ணுகிறார்.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"அவர் பிள்ளைப்பேறற்ற பெண்ணை பிள்ளைகளைப் பெறும் மகிழ்ச்சியுள்ள தாயாக்கி,","poem":1},{"text":"அவளுடைய வீட்டிலே குடியிருக்கச்செய்கிறார்.","poem":2},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}