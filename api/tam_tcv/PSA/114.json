{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":114,"content":[{"type":"verse","number":1,"content":[{"text":"இஸ்ரயேலர் எகிப்திலிருந்து வந்தபோது,","poem":1},{"text":"யாக்கோபின் குடும்பத்தார் வேறுநாட்டைச் சேர்ந்த மக்களிடமிருந்து வெளியே வந்தபோது,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யூதா, இறைவனின் பரிசுத்த இடமாயிற்று;","poem":1},{"text":"இஸ்ரயேல் அவருடைய அரசாட்சி ஆயிற்று.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"கடல் அவர்களைக் கண்டு ஓடி ஒதுங்கியது;","poem":1},{"text":"யோர்தான் நதி அதின் வழியை மாற்றியது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மலைகள் செம்மறியாட்டுக் கடாக்களைப்போலவும்,","poem":1},{"text":"குன்றுகள் ஆட்டுக்குட்டிகள்போலவும் துள்ளின.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"கடலே, நீ விலகி ஒதுங்கியது ஏன்?","poem":1},{"text":"யோர்தான் நதியே, நீ ஓடாமல் நின்றது ஏன்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மலைகளே, நீங்கள் செம்மறியாட்டுக் கடாக்களைப்போலவும்,","poem":1},{"text":"குன்றுகளே, நீங்கள் செம்மறியாட்டுக் குட்டிகளைப் போலவும் துள்ளியது ஏன்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"பூமியே, யெகோவாவின் சமுகத்தில் நடுங்கு,","poem":1},{"text":"யாக்கோபின் இறைவனின் சமுகத்தில் நடுங்கு.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர் கற்பாறையைக் குளமாகவும்,","poem":1},{"text":"கடினமான கற்பாறையை நீரூற்றுகளாகவும் மாற்றினாரே.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}