{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":115,"content":[{"type":"verse","number":1,"content":[{"text":"எங்களுக்கு அல்ல, யெகோவாவே, எங்களுக்கு அல்ல,","poem":1},{"text":"உமது அன்பின் நிமித்தமும்,","poem":2},{"lineBreak":true},{"text":"உமது சத்தியத்தின் நிமித்தமும் உமது பெயருக்கே மகிமை உண்டாகட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"பிற நாடுகளோ, “அவர்களுடைய இறைவன் எங்கே?”","poem":1},{"text":"என்று ஏன் கேட்கிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நம்முடைய இறைவன் பரலோகத்தில் இருக்கிறார்;","poem":1},{"text":"அவர் தமக்கு விருப்பமானதையே செய்கிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால் பிற மக்களின் விக்கிரகங்கள் வெள்ளியும் தங்கமும்,","poem":1},{"text":"மனிதருடைய கைகளினால் செய்யப்பட்டதுமாய் இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவைகளுக்கு வாய்கள் உண்டு, ஆனாலும் அவைகளால் பேசமுடியாது;","poem":1},{"text":"கண்கள் உண்டு, அவைகளால் பார்க்க முடியாது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவைகளுக்குக் காதுகள் உண்டு, ஆனால் அவைகளால் கேட்கமுடியாது;","poem":1},{"text":"மூக்கிருந்தும், அவைகளால் முகரமுடியாது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவைகளுக்குக் கைகளிருந்தும் தொட்டுப் பார்க்க முடியாது;","poem":1},{"text":"கால்கள் உண்டு, ஆனால் அவைகளால் நடக்க முடியாது;","poem":2},{"lineBreak":true},{"text":"தங்கள் தொண்டைகளால் சத்தமிடக்கூட அவைகளால் முடியாது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவைகளைச் செய்கிறவர்களும்,","poem":1},{"text":"அவைகளை நம்புகிற எல்லோரும் அவைகளைப்போலவே இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"இஸ்ரயேல் குடும்பத்தாரே, யெகோவாவிடம் நம்பிக்கையாய் இருங்கள்;","poem":1},{"text":"அவரே உங்களுடைய உதவியும் கேடயமுமாய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆரோன் குடும்பத்தாரே, யெகோவாவிடம் நம்பிக்கையாய் இருங்கள்;","poem":1},{"text":"அவரே உங்களுடைய உதவியும் கேடயமுமாய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவருக்குப் பயந்து நடக்கிறவர்களே, யெகோவாவை நம்புங்கள்;","poem":1},{"text":"அவரே உங்களுடைய உதவியும் கேடயமுமாய் இருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவா நம்மை நினைவில் வைத்திருக்கிறார், அவர் நம்மை ஆசீர்வதிப்பார்;","poem":1},{"text":"அவர் இஸ்ரயேலின் குடும்பத்தாரை ஆசீர்வதிப்பார்;","poem":2},{"lineBreak":true},{"text":"அவர் ஆரோன் குடும்பத்தாரை ஆசீர்வதிப்பார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடக்கிற","poem":1},{"text":"பெரியோரையும், சிறியோரையும் அவர் ஆசீர்வதிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"யெகோவா உங்களைப் பெருகப்பண்ணுவாராக,","poem":1},{"text":"உங்களையும் உங்கள் பிள்ளைகளையும் பெருகப்பண்ணுவாராக.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"வானத்தையும் பூமியையும் படைத்தவராகிய","poem":1},{"text":"யெகோவாவினால் நீங்கள் ஆசீர்வதிக்கப்படுவீர்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"மிக உயர்ந்த வானங்கள் யெகோவாவினுடையவை;","poem":1},{"text":"பூமியையோ அவர் மனிதனுக்குக் கொடுத்திருக்கிறார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இறந்தவர்கள் யெகோவாவைத் துதிப்பதில்லை,","poem":1},{"text":"மரணத்தின் மவுனத்தில் இறங்குகிறவர்களும் துதியார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"இன்றுமுதல் என்றைக்கும் யெகோவாவைத் துதிப்போம்.","poem":1},{"text":"யெகோவாவுக்குத் துதி.","poem":2},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/115.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/116.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/114.json","previousChapterAudioLinks":{},"numberOfVerses":18}