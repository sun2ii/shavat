{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":116,"content":[{"type":"verse","number":1,"content":[{"text":"நான் யெகோவாவிடம் அன்பாயிருக்கிறேன், ஏனெனில் அவர் என் குரலைக் கேட்டார்;","poem":1},{"text":"இரக்கத்திற்காக நான் கதறியதை அவர் கேட்டார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர் எனக்குச் செவிகொடுத்தபடியால்,","poem":1},{"text":"நான் என் வாழ்நாளெல்லாம் அவரை வழிபடுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"மரணக் கயிறுகள் என்னைச் சிக்கவைத்தன;","poem":1},{"text":"பாதாளத்தின் வேதனைகள் என்மீது வந்தன;","poem":2},{"lineBreak":true},{"text":"கஷ்டமும் கவலையும் என்னை மேற்கொண்டன.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அப்பொழுது நான் யெகோவாவின் பெயரைச்சொல்லிக் கூப்பிட்டுச் சொன்னதாவது:","poem":1},{"text":"“யெகோவாவே, என்னைக் காப்பாற்றும்!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவா கிருபையும் நீதியுமுள்ளவர்;","poem":1},{"text":"நம்முடைய இறைவன் கருணை நிறைந்தவர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவா கற்றுக்கொள்ளவிருக்கும் இருதயமுள்ளவர்களைப் பாதுகாக்கிறார்;","poem":1},{"text":"நான் தாழ்த்தப்பட்டபோது, அவர் என்னை இரட்சித்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"என் ஆத்துமாவே, மீண்டும் நீ இளைப்பாறு;","poem":1},{"text":"யெகோவா உனக்கு எவ்வளவு நல்லவராய் இருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவே, நீர் என் ஆத்துமாவை மரணத்திலிருந்து விடுவித்தீர்;","poem":1},{"text":"என் கண்களைக் கண்ணீர் சிந்துவதிலிருந்தும்,","poem":2},{"lineBreak":true},{"text":"என் கால்களை இடறுவதிலிருந்தும் விடுவித்தீர்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் உயிருள்ளோரின் நாட்டிலே","poem":1},{"text":"யெகோவாவுக்கு முன்பாக நடப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“நான் மிகவும் துன்பப்பட்டிருக்கிறேன்” என்று நான் சொன்னபோதிலும்,","poem":1},{"text":"நான் விசுவாசித்தேன், ஆகையால் பேசுகிறேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஆனாலும் என் மனச்சோர்வினாலே,","poem":1},{"text":"“எல்லா மனிதரும் பொய்யர்” என்று நான் சொன்னேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவா எனக்குச் செய்த எல்லா நன்மைகளுக்கும் பதிலாக,","poem":1},{"text":"நான் அவருக்கு எதைத்தான் கொடுப்பேன்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"நான் இரட்சிப்பின் பாத்திரத்தை உயர்த்திக்கொண்டு","poem":1},{"noteId":14},{"text":"யெகோவாவினுடைய பெயரைச் சொல்லி வழிபடுவேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் யெகோவாவுக்குச் செய்த நேர்த்திக் கடன்களை","poem":1},{"text":"அவருடைய மக்கள் எல்லாருக்கும் முன்பாக நிறைவேற்றுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"யெகோவாவினுடைய பரிசுத்தவான்களின் மரணம்","poem":1},{"text":"அவருடைய பார்வையில் விலையேறப்பெற்றது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யெகோவாவே, உண்மையாகவே நான் உமது பணியாளனாய் இருக்கிறேன்;","poem":1},{"text":"நான் உமது அடியாளின் மகனும், உமது ஊழியக்காரனுமாய் இருக்கிறேன்;","poem":2},{"lineBreak":true},{"text":"என்னைக் கட்டியிருந்த சங்கிலியிலிருந்து நீர் என்னை விடுதலையாக்கினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நான் உமக்கு ஒரு நன்றிக் காணிக்கையைப் பலியிட்டு,","poem":1},{"text":"யெகோவாவினுடைய பெயரைச் சொல்லி வழிபடுவேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நான் யெகோவாவுக்குச் செய்த நேர்த்திக்கடனை,","poem":1},{"text":"அவருடைய மக்கள் எல்லோருக்கும் சமுகத்தில் நிறைவேற்றுவேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"எருசலேமே உன் நடுவில்","poem":1},{"text":"யெகோவாவினுடைய ஆலய முற்றங்களில், நான் எனது நேர்த்திக்கடனை நிறைவேற்றுவேன்.","poem":2},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[{"noteId":14,"caller":"+","text":"என்னை விடுவித்த யெகோவாவுக்கு பானபலி செலுத்துவேன்.","reference":{"chapter":116,"verse":13}}]},"thisChapterLink":"/api/tam_tcv/PSA/116.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/117.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/115.json","previousChapterAudioLinks":{},"numberOfVerses":19}