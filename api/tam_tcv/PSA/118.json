{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":118,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்கு நன்றி செலுத்துங்கள், அவர் நல்லவர்;","poem":1},{"text":"அவருடைய அன்பு என்றென்றும் நிலைத்திருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“அவருடைய அன்பு என்றென்றும் நிலைத்திருக்கிறது” என்று","poem":1},{"text":"இஸ்ரயேலர் சொல்வார்களாக.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“அவருடைய அன்பு என்றென்றும் நிலைத்திருக்கிறது” என்று","poem":1},{"text":"ஆரோன் குடும்பத்தவரான ஆசாரியர்கள் சொல்வார்களாக.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“அவருடைய அன்பு என்றென்றும் நிலைத்திருக்கிறது” என்று","poem":1},{"text":"யெகோவாவுக்குப் பயந்து நடக்கிறவர்கள் சொல்வார்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நான் நெருக்கத்திலிருந்து யெகோவாவைக் கூப்பிட்டேன் எனக்குப் பதிலளித்து,","poem":1},{"text":"விசாலமான இடத்தில் என்னை நடத்தினார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவா என்னோடு இருக்கிறார், நான் பயப்படமாட்டேன்;","poem":1},{"text":"மனிதன் எனக்கு என்ன செய்யமுடியும்?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"யெகோவா என்னோடு இருக்கிறார், அவரே என் உதவியாளர்;","poem":1},{"text":"என்னைப் பகைக்கிறவர்களுக்கு நேரிடுவதை நான் காண்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"மனிதனில் நம்பிக்கை வைப்பதைப் பார்க்கிலும்,","poem":1},{"text":"யெகோவாவிடத்தில் தஞ்சம் அடைவதே மேலானது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அதிகாரிகள் மீது நம்பிக்கை வைப்பதைப் பார்க்கிலும்,","poem":1},{"text":"யெகோவாவிடத்தில் தஞ்சம் அடைவதே சிறந்தது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எல்லா மக்களும் என்னைச் சூழ்ந்துகொண்டார்கள்;","poem":1},{"text":"ஆனாலும் யெகோவாவின் பெயரில் நான் அவர்களை மேற்கொண்டேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் எல்லாப் பக்கங்களிலும் என்னை வளைத்துக்கொண்டார்கள்;","poem":1},{"text":"ஆனாலும் யெகோவாவின் பெயரிலேயே நான் அவர்களை மேற்கொண்டேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்கள் தேனீக்களைப்போல என்னைச் சூழ்ந்துகொண்டார்கள்;","poem":1},{"text":"ஆனாலும் அவர்கள் எரியும் முட்செடிகளைப்போல் விரைவாக மறைந்துபோனார்கள்;","poem":2},{"lineBreak":true},{"text":"யெகோவாவின் பெயரால் நான் அவர்களை மேற்கொண்டேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் பின்னோக்கித் தள்ளப்பட்டு, விழப்போனேன்;","poem":1},{"text":"ஆனால் யெகோவாவோ எனக்கு உதவி செய்தார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவா என் பெலமும், என் பாடலுமாய் இருக்கிறார்;","poem":1},{"text":"அவரே எனக்கு இரட்சிப்புமானார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"நீதிமான்களின் கூடாரங்களில்,","poem":1},{"text":"வெற்றியின் மகிழ்ச்சிக் குரல் திரும்பத்திரும்ப ஒலிக்கின்றன:","poem":2},{"text":"“யெகோவாவின் வலதுகரம் வல்லமையான செயல்களைச் செய்திருக்கிறது.","poem":1}]},{"type":"verse","number":16,"content":[{"text":"யெகோவாவின் வலதுகரம் உயர்ந்திருக்கிறது;","poem":2},{"lineBreak":true},{"text":"யெகோவாவின் வலதுகரம் வல்லமையான காரியங்களைச் செய்திருக்கிறது.”","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நான் வாழுவேன், சாகமாட்டேன்.","poem":1},{"text":"நான் வாழ்ந்து யெகோவா செய்தவற்றை அறிவிப்பேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"யெகோவா என்னைக் கடுமையாகத் தண்டித்தார்,","poem":1},{"text":"ஆனாலும் அவர் என்னை மரணத்திற்கு ஒப்புக்கொடுக்கவில்லை.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"நீதியின் வாசல்களை","poem":1},{"noteId":15},{"text":"எனக்காகத் திறவுங்கள்;","poem":1},{"text":"நான் உள்ளே சென்று யெகோவாவுக்கு நன்றி செலுத்துவேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"இதுவே யெகோவாவின் வாசல்;","poem":1},{"text":"நீதிமான்கள் அதின் உள்ளே செல்வார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"நீர் எனக்குப் பதிலளித்தபடியால், நான் உமக்கு நன்றி செலுத்துகிறேன்;","poem":1},{"text":"என் இரட்சிப்பு நீரே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"வீடு கட்டுகிறவர்கள் புறக்கணித்த கல்லே","poem":1},{"text":"மூலைக்குத் தலைக்கல்லாயிற்று.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"யெகோவாவே இதைச் செய்தார்,","poem":1},{"text":"இது நமது கண்களுக்கு ஆச்சரியமாக இருக்கிறது.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"யெகோவா உண்டாக்கின நாள் இதுவே;","poem":1},{"text":"இதிலே நாம் மகிழ்ந்து களிகூருவோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"யெகோவாவே, எங்களை இரட்சியும்;","poem":1},{"text":"யெகோவாவே, எங்களுக்கு வெற்றியைத் தாரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"யெகோவாவின் பெயரில் வருகிறவர் ஆசீர்வதிக்கப்பட்டவர்;","poem":1},{"text":"யெகோவாவினுடைய ஆலயத்திலிருந்து உங்களை ஆசீர்வதிக்கிறோம்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"யெகோவாவே இறைவன்,","poem":1},{"text":"அவர் தமது ஒளியை நம்மேல் பிரகாசிக்கச் செய்திருக்கிறார்;","poem":2},{"text":"பண்டிகை பலியைக் கையில் எடுத்துக்கொண்டு,","poem":1},{"text":"பலிபீடத்தின் கொம்புகளில் கயிற்றைக் கட்டி","poem":2},{"lineBreak":true},{"text":"ஊர்வலத்தில் கலந்துகொள்ளுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"நீரே என் இறைவன், நான் உமக்கு நன்றி செலுத்துவேன்;","poem":1},{"text":"நீரே என் இறைவன், நான் உம்மைப் புகழ்ந்து உயர்த்துவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"யெகோவாவுக்கு நன்றி செலுத்துங்கள், அவர் நல்லவர்;","poem":1},{"text":"அவருடைய அன்பு என்றென்றும் நிலைத்திருக்கிறது.","poem":2}]}],"footnotes":[{"noteId":15,"caller":"+","text":"நீதியின் வாசல்களை அல்லது இறைவனுடைய மக்கள் செல்லும் ஆலய வாசல்.","reference":{"chapter":118,"verse":19}}]},"thisChapterLink":"/api/tam_tcv/PSA/118.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/119.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/117.json","previousChapterAudioLinks":{},"numberOfVerses":29}