{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":119,"content":[{"type":"verse","number":1,"content":[{"text":"குற்றமற்றவர்களாய் வாழ்ந்து,","poem":1},{"text":"யெகோவாவினுடைய சட்டத்தின்படி நடப்பவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவருடைய நியமங்களைக் கைக்கொண்டு,","poem":1},{"text":"தங்கள் முழு இருதயத்தோடும் அவரைத் தேடுகிறவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் தவறு செய்யாமல்","poem":1},{"text":"அவருடைய வழிகளில் நடக்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நாங்கள் உமது ஒழுங்குவிதிகளுக்கு முற்றிலும் கீழ்ப்படிய வேண்டுமென்றே","poem":1},{"text":"நீர் அவைகளைக் கொடுத்தீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஐயோ, உமது விதிமுறைகளுக்குக் கீழ்ப்படியும்படி,","poem":1},{"text":"என் வழிகள் உறுதியாய் இருந்திருந்தால் நலமாயிருக்கும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உமது கட்டளைகளையெல்லாம் நான் கவனத்தில் கொள்ளும்போது,","poem":1},{"text":"நான் வெட்கப்பட்டுப் போகமாட்டேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உமது நீதியான சட்டங்களை நான் கற்றுக்கொள்ளும்போது,","poem":1},{"text":"நேர்மையான இருதயத்தோடு உம்மைத் துதிப்பேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் உமது விதிமுறைகளுக்குக் கீழ்ப்படிவேன்;","poem":1},{"text":"என்னை முற்றிலும் கைவிடாதேயும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"வாலிபர் தன் நடத்தையை எப்படி சுத்தமாய்க் காத்துக்கொள்ள முடியும்?","poem":1},{"text":"உமது வார்த்தையின்படி வாழ்வதினால்தானே.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் முழு இருதயத்தோடு உம்மைத் தேடுகிறேன்;","poem":1},{"text":"உமது கட்டளைகளில் இருந்து என்னை வழிவிலகிப் போகவிடாதேயும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான் உமக்கு எதிராய் பாவம் செய்யாதிருக்கும்படி,","poem":1},{"text":"உமது வார்த்தையை என் இருதயத்தில் மறைத்து வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"யெகோவாவே, உமக்கே துதி உண்டாகட்டும்;","poem":1},{"text":"உமது விதிமுறைகளை எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"உமது வாயிலிருந்து வரும் சட்டங்கள் எல்லாவற்றையும்","poem":1},{"text":"என் உதடுகளால் விவரித்துச் சொல்கிறேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஒருவன் பெரும் செல்வத்தில் மகிழ்வதுபோல்,","poem":1},{"text":"நான் உமது நியமங்களைப் பின்பற்றுவதில் மகிழ்கிறேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் உமது ஒழுங்குவிதிகளைத் தியானித்து,","poem":1},{"text":"உமது வழிகளை ஆழ்ந்து சிந்திக்கிறேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நான் உமது விதிமுறைகளில் மகிழ்கிறேன்;","poem":1},{"text":"உமது வார்த்தையை உதாசீனம் செய்யமாட்டேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"உமது அடியேனுக்கு நன்மை செய்யும்;","poem":1},{"text":"அப்பொழுது நான் வாழ்வடைந்து உமது வார்த்தைக்குக் கீழ்ப்படிவேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உமது சட்டத்திலுள்ள அதிசயமான காரியங்களை நான் காணும்படி,","poem":1},{"text":"என் கண்களைத் திறந்தருளும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"பூமியிலே நான் வேறுநாட்டைச் சேர்ந்தவனாய் இருக்கிறேன்;","poem":1},{"text":"உமது கட்டளைகளை எனக்கு மறைக்காதேயும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"உமது சட்டங்களின்மேல் உள்ள வாஞ்சையினால்,","poem":1},{"text":"என் ஆத்துமா எப்பொழுதும் பற்றியெரிகிறது.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அகங்காரமுள்ள சபிக்கப்பட்டவர்களை நீர் கடிந்துகொள்கிறீர்;","poem":1},{"text":"அவர்கள் உமது கட்டளைகளிலிருந்து விலகிப்போகிறவர்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நான் உமது நியமங்களைக் கைக்கொள்வதினால்,","poem":1},{"text":"பிறரின் ஏளனத்தையும், அவமதிப்பையும் என்னிலிருந்து விலக்கும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஆளுநர்கள் ஒன்றாய் அமர்ந்து எனக்கெதிராய் அவதூறு பேசினாலும்,","poem":1},{"text":"உமது அடியேன் உமது விதிமுறைகளையே தியானிப்பேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"உமது நியமங்கள் என் மகிழ்ச்சியாயிருக்கின்றன;","poem":1},{"text":"அவைகளே எனக்கு ஞானமுள்ள ஆலோசனையைத் தருகின்றன.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நான் தூசியில் வீழ்ந்து கிடக்கிறேன்;","poem":1},{"text":"உமது வார்த்தையின்படி என் வாழ்வைப் பாதுகாத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நான் என் வாழ்வின் வழிகளை உமக்கு விவரித்துச் சொன்னேன்,","poem":1},{"text":"நீர் எனக்குப் பதிலளித்தீர்;","poem":2},{"lineBreak":true},{"text":"உமது விதிமுறைகளை எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"உமது ஒழுங்குவிதிகளின் அர்த்தத்தை எனக்கு விளங்கச்செய்யும்;","poem":1},{"text":"அப்பொழுது நான் உம்முடைய அற்புதமான போதனைகளைத்","poem":2},{"noteId":16},{"text":"தியானிப்பேன்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"என் ஆத்துமா துயரத்தால் இளைத்துப் போயிருக்கிறது;","poem":1},{"text":"உமது வார்த்தையின்படி என்னைப் பெலப்படுத்தும்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"என்னை ஏமாற்றும் வழிகளிலிருந்து காத்துக்கொள்ளும்;","poem":1},{"text":"என்னில் கிருபையாயிருந்து, உமது சட்டத்தை எனக்குக் கற்றுத்தாரும்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"மெய்வழியை நான் தேர்ந்தெடுத்தேன்;","poem":1},{"text":"நான் உமது சட்டங்களின்படி வாழத் தீர்மானித்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"யெகோவாவே, உமது நியமங்களை நான் இறுகப் பற்றிக்கொண்டிருக்கிறேன்;","poem":1},{"text":"என்னை வெட்கப்பட விடாதேயும்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"நீர் என் புரிந்துகொள்ளுதலை விரிவாக்கியிருக்கிறதினால்,","poem":1},{"text":"உமது கட்டளைகளின் பாதையிலேயே நான் ஓடுவேன்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"யெகோவாவே, உமது விதிமுறைகளை எனக்குப் போதியும்;","poem":1},{"text":"அப்பொழுது நான் அவைகளைக் கடைசிமட்டும் கைக்கொள்வேன்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"விளங்கிக்கொள்ளும் ஆற்றலை எனக்குத் தாரும்;","poem":1},{"text":"அதினால் நான் உமது சட்டத்தைக் கைக்கொள்வேன்.","poem":2},{"lineBreak":true},{"text":"என் முழு இருதயத்தோடும் அதற்குக் கீழ்ப்படிவேன்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"உமது கட்டளைகளின் பாதையில் என்னை நடத்தும்;","poem":1},{"text":"ஏனெனில் அதில் நான் மகிழ்ச்சியைக் காண்கிறேன்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"என் இருதயத்தைச் சுயலாபத்தின் பக்கம் சாயவிடாமல்,","poem":1},{"text":"உமது நியமங்களின் பக்கமாய்த் திருப்பும்.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"பயனற்ற காரியங்களிலிருந்து என் கண்களைத் திருப்பும்;","poem":1},{"text":"உமது வார்த்தையின்படியே என் வாழ்வைப் பாதுகாத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"உமக்குப் பயந்து நடக்கும்படி நீர் கொடுத்த வாக்குத்தத்தத்தை","poem":1},{"text":"உமது அடியேனாகிய எனக்கு நிறைவேற்றும்.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"நான் பயப்படுகின்ற அவமானத்தை என்னைவிட்டு அகற்றும்;","poem":1},{"text":"ஏனெனில், உமது சட்டங்கள் நல்லவை.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"நான் உமது ஒழுங்குவிதிகளை எவ்வளவாய் விரும்புகிறேன்!","poem":1},{"text":"உமது நியாயத்தின்படி என் வாழ்வைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"யெகோவாவே, உமது உடன்படிக்கையின் அன்பும்,","poem":1},{"text":"உம்முடைய வாக்குத்தத்தத்தின்படி உமது இரட்சிப்பும் எனக்குக் கிடைப்பதாக;","poem":2}]},{"type":"verse","number":42,"content":[{"text":"அப்பொழுது நான் என்னை நிந்திக்கிறவனுக்குப் பதில் சொல்வேன்;","poem":1},{"text":"ஏனெனில் நானோ உமது வார்த்தையிலேயே நம்பிக்கையை வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"சத்திய வார்த்தையை என் வாயிலிருந்து பறித்துக் கொள்ளாதிரும்;","poem":1},{"text":"ஏனெனில், நான் உமது சட்டங்களிலேயே என் நம்பிக்கையை வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"நான் எப்பொழுதும்","poem":1},{"text":"உமது சட்டத்துக்குக் கீழ்ப்படிவேன்.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"உமது ஒழுங்குவிதிகளில் நடப்பதினால்,","poem":1},{"text":"நான் சுதந்திரமாக நடந்துவருவேன்.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"நான் அரசர்களுக்கு முன்பாக உமது நியமங்களைக் குறித்துப்பேசுவேன்;","poem":1},{"text":"நான் வெட்கத்திற்கு உள்ளாகமாட்டேன்.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"ஏனெனில், நான் உமது கட்டளைகளை நேசிக்கிறேன்,","poem":1},{"text":"அவற்றில் மகிழ்ச்சியடைகிறேன்.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"நான் நேசிக்கும் உம்முடைய கட்டளைகளை மதிக்கிறேன்;","poem":1},{"text":"உம்முடைய விதிமுறைகளைத் தியானிப்பேன்.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"உமது அடியேனுக்குக் கொடுத்த உமது வார்த்தையை நினைவிற்கொள்ளும்;","poem":1},{"text":"அதினால் எனக்கு நம்பிக்கையை தந்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"இதுவே என் துன்பத்தில் எனக்கு ஆறுதல்:","poem":1},{"text":"உம்முடைய வாக்குத்தத்தம் என் வாழ்வைக் காத்துக்கொள்வது.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"அகங்காரம் கொண்டவர்கள் தயக்கமின்றி என்னை ஏளனம் செய்கிறார்கள்;","poem":1},{"text":"ஆனாலும் நான் உமது சட்டத்திலிருந்து விலகுவதில்லை.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"யெகோவாவே, உமது பூர்வகாலத்து சட்டங்களை நான் நினைவிற்கொள்கிறேன்;","poem":1},{"text":"நான் அவைகளில் ஆறுதல் பெறுகிறேன்.","poem":2}]},{"type":"verse","number":53,"content":[{"text":"உமது சட்டத்தைக் கைவிட்டுவிட்ட கொடியவர்களின் நிமித்தம்,","poem":1},{"text":"கடுங்கோபம் என்னைப் பற்றிக்கொள்கிறது.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"நான் எங்கு தங்கினாலும்,","poem":1},{"text":"உமது விதிமுறைகளே எனது பாடலின் கருப்பொருளாயிற்று.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"யெகோவாவே, இரவிலே நான் உமது பெயரை நினைவிற்கொண்டு,","poem":1},{"text":"உமது சட்டத்தைக் கைக்கொள்வேன்.","poem":2}]},{"type":"verse","number":56,"content":[{"text":"உமது ஒழுங்குவிதிகளுக்குக் கீழ்ப்படிவதே","poem":1},{"text":"என் வழக்கமாயிற்று.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"யெகோவாவே, நீரே என் பங்கு;","poem":1},{"text":"உமது வார்த்தைகளுக்கு நான் கீழ்ப்படிவதாக வாக்களித்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"நான் என் முழு இருதயத்தோடும் உமது முகத்தைத் தேடியிருக்கிறேன்;","poem":1},{"text":"உமது வாக்குத்தத்தத்தின்படி என்மீது கிருபையாயிரும்.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"நான் என் வாழ்வின் பாதையை சிந்தித்து,","poem":1},{"text":"உம்முடைய நியமங்களைப் பின்பற்ற முடிவு செய்துள்ளேன்.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"உமது கட்டளைகளுக்கு விரைவாய்க் கீழ்ப்படிவேன்,","poem":1},{"text":"தாமதிக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"கொடியவர்கள் என்னைக் கயிறுகளினால் கட்டினாலும்,","poem":1},{"text":"நான் உமது சட்டத்தை மறவேன்.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"உமது நியாயமான சட்டங்களுக்காக உமக்கு நன்றி செலுத்தும்படி,","poem":1},{"text":"நான் நள்ளிரவில் விழித்தெழுகிறேன்.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"உமக்குப் பயந்து நடக்கிற,","poem":1},{"text":"உமது ஒழுங்குவிதிகளைப் பின்பற்றுகிற எல்லோருக்கும் நான் நண்பனாய் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"யெகோவாவே, பூமி உமது அன்பினால் நிறைந்திருக்கிறது;","poem":1},{"text":"உமது விதிமுறைகளை எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":65,"content":[{"text":"யெகோவாவே, உம்முடைய வார்த்தையின்படி","poem":1},{"text":"உமது அடியேனுக்கு நன்மை செய்யும்.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"உம்முடைய கட்டளைகளை நான் நம்புவதால்,","poem":1},{"text":"அறிவையும் நல்ல நிதானிப்பையும் எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"நான் துன்பப்படுவதற்கு முன்பு வழிவிலகிப் போனேன்,","poem":1},{"text":"ஆனால் இப்பொழுதோ உம்முடைய வார்த்தைக்குக் கீழ்ப்படிகிறேன்.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"நீர் நல்லவர், நீர் நன்மையானதையே செய்கிறீர்;","poem":1},{"text":"உம்முடைய விதிமுறைகளை எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"அகங்காரம் கொண்டவர்கள் என்னைப்பற்றிப் பொய்களைப் பரப்பினார்கள்,","poem":1},{"text":"ஆனாலும் நான் முழு இருதயத்தோடும், உம்முடைய ஒழுங்குவிதிகளைக் கைக்கொள்கிறேன்.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"அவர்களுடைய இருதயங்கள் கடினமானவைகளும், உணர்வற்றவைகளுமாய் இருக்கின்றன;","poem":1},{"text":"நானோ உம்முடைய சட்டத்தில் மகிழ்கிறேன்.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"நான் துன்பப்பட்டது எனக்கு நன்மையாகவே இருந்தது;","poem":1},{"text":"அதினால் நான் உம்முடைய விதிமுறைகளைக் கற்றுக்கொள்கிறேன்.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"ஆயிரமாயிரமான பொன் வெள்ளியைப் பார்க்கிலும்,","poem":1},{"text":"உம்முடைய வாயிலிருந்து வருகிற சட்டம் எனக்கு அதிக விலையேறப்பெற்றது.","poem":2}]},{"type":"verse","number":73,"content":[{"text":"உம்முடைய கரங்கள் என்னைப் படைத்து உருவாக்கின;","poem":1},{"text":"உம்முடைய கட்டளைகளைக் கற்று விளங்கிக்கொள்ளும் ஆற்றலை எனக்குத் தாரும்.","poem":2}]},{"type":"verse","number":74,"content":[{"text":"நான் உமது வார்த்தையில் என் எதிர்பார்ப்பை வைத்திருக்கிறபடியால்,","poem":1},{"text":"உமக்குப் பயந்து நடப்பவர்கள் என்னைக் காணும்போது, மகிழ்ச்சியடைவார்களாக.","poem":2}]},{"type":"verse","number":75,"content":[{"text":"யெகோவாவே, உமது சட்டங்கள் நியாயமானவை என்பதை நான் அறிவேன்;","poem":1},{"text":"நீர் என்னைத் துன்பப்படுத்தியது சரிதான்.","poem":2}]},{"type":"verse","number":76,"content":[{"text":"நீர் உம்முடைய அடியேனுக்குக் கொடுத்த உமது வாக்குத்தத்தத்தின்படி,","poem":1},{"text":"உம்முடைய உடன்படிக்கையின் அன்பு என்னைத் தேற்றுவதாக.","poem":2}]},{"type":"verse","number":77,"content":[{"text":"நான் வாழ்வடையும்படி உம்முடைய கருணை எனக்குக் கிடைக்கட்டும்;","poem":1},{"text":"உமது சட்டம் என் மனமகிழ்ச்சி.","poem":2}]},{"type":"verse","number":78,"content":[{"text":"காரணமின்றி எனக்கு அநியாயம் செய்யும்","poem":1},{"text":"அகங்காரம் கொண்டவர்கள் வெட்கம் அடைவார்களாக;","poem":2},{"lineBreak":true},{"text":"நானோ, உம்முடைய ஒழுங்குவிதிகளைத் தியானிப்பேன்.","poem":2}]},{"type":"verse","number":79,"content":[{"text":"உமது நியமங்களை விளங்கிக்கொண்டு,","poem":1},{"text":"உமக்குப் பயந்து நடக்கிறவர்கள் என் பக்கம் திரும்பட்டும்.","poem":2}]},{"type":"verse","number":80,"content":[{"text":"நான் வெட்கப்பட்டுப் போகாதபடி என் இருதயம்","poem":1},{"text":"உம்முடைய விதிமுறைகளைக் குறித்து குற்றமற்றதாய் இருக்கட்டும்.","poem":2}]},{"type":"verse","number":81,"content":[{"text":"உம்முடைய இரட்சிப்பின் மேலுள்ள வாஞ்சையினால் என் ஆத்துமா ஏங்குகிறது;","poem":1},{"text":"நான் உமது வார்த்தையிலேயே என் எதிர்பார்ப்பை வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":82,"content":[{"text":"உம்முடைய வாக்குத்தத்தத்திற்காக காத்திருந்து, என் கண்கள் மங்கிப்போகின்றன;","poem":1},{"text":"“நீர் என்னை எப்பொழுது தேற்றுவீர்?” என்று கேட்க விரும்புகிறேன்.","poem":2}]},{"type":"verse","number":83,"content":[{"text":"நான் புகைக்குள்ளிருந்து சுருங்கிப்போகும்","poem":1},{"text":"திராட்சைக் குடுவையைப்போல் இருந்தாலும்,","poem":2},{"lineBreak":true},{"text":"உமது விதிமுறைகளை மறவாமல் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":84,"content":[{"text":"உமது அடியேன் எவ்வளவு காலத்திற்குக் காத்திருக்கவேண்டும்?","poem":1},{"text":"என்னைத் துன்பப்படுத்துகிறவர்களை நீர் எப்பொழுது தண்டிப்பீர்?","poem":2}]},{"type":"verse","number":85,"content":[{"text":"அகங்காரம் கொண்டவர்கள் நான் விழுவதற்குக் குழி தோண்டுகிறார்கள்;","poem":1},{"text":"அது உமது சட்டத்திற்கு முரணானது.","poem":2}]},{"type":"verse","number":86,"content":[{"text":"உம்முடைய கட்டளைகளெல்லாம் நம்பத்தகுந்தவை;","poem":1},{"text":"காரணமின்றி மனிதர் என்னைத் துன்பப்படுத்துவதால், எனக்கு உதவிசெய்யும்.","poem":2}]},{"type":"verse","number":87,"content":[{"text":"அவர்கள் என்னைப் பூமியிலிருந்து ஏறக்குறைய அழித்துவிட்டார்கள்;","poem":1},{"text":"ஆனாலும் நான் உமது ஒழுங்குவிதிகளைக் கைவிடவில்லை.","poem":2}]},{"type":"verse","number":88,"content":[{"text":"உம்முடைய உடன்படிக்கையின் அன்பின்படியே என் வாழ்வைக் காத்துக்கொள்ளும்","poem":1},{"noteId":17},{"text":",","poem":1},{"text":"அதினால் நான் உமது வாயின் நியமங்களுக்குக் கீழ்ப்படிவேன்.","poem":2}]},{"type":"verse","number":89,"content":[{"text":"யெகோவாவே, உம்முடைய வார்த்தை நித்தியமானது;","poem":1},{"text":"அது வானங்களில் உறுதியாய் நிற்கின்றது.","poem":2}]},{"type":"verse","number":90,"content":[{"text":"உம்முடைய சத்தியம் தலைமுறை தலைமுறைக்கும் தொடர்கிறது;","poem":1},{"text":"நீர் பூமியை நிலைநிறுத்தினீர், அது நிலைத்திருக்கிறது.","poem":2}]},{"type":"verse","number":91,"content":[{"text":"உம்முடைய சட்டங்கள் இன்றுவரை நிலைத்திருக்கின்றன;","poem":1},{"text":"ஏனெனில் எல்லாம் உமக்குப் பணி செய்கின்றன.","poem":2}]},{"type":"verse","number":92,"content":[{"text":"உம்முடைய சட்டம் என் மனமகிழ்ச்சியாய் இராதிருந்தால்,","poem":1},{"text":"நான் என் துன்பத்திலே அழிந்து போயிருப்பேன்.","poem":2}]},{"type":"verse","number":93,"content":[{"text":"நான் உமது ஒழுங்குவிதிகளை ஒருபோதும் மறவேன்;","poem":1},{"text":"ஏனெனில் அவைகளால் நீர் என் வாழ்வைக் காத்துக்கொண்டீர்.","poem":2}]},{"type":"verse","number":94,"content":[{"text":"நான் உம்முடையவனாய் இருப்பதால் என்னைக் காப்பாற்றும்;","poem":1},{"text":"நான் உம்முடைய ஒழுங்குவிதிகளுக்குக் கீழ்ப்படிய முயற்சித்தேன்.","poem":2}]},{"type":"verse","number":95,"content":[{"text":"கொடியவர்கள் என்னை அழிக்கக் காத்துக்கொண்டிருக்கிறார்கள்;","poem":1},{"text":"ஆனாலும் நான் உமது நியமங்களை ஆழ்ந்து சிந்திப்பேன்.","poem":2}]},{"type":"verse","number":96,"content":[{"text":"பரிபூரணத்திற்கும் ஓர் எல்லையை நான் காண்கிறேன்;","poem":1},{"text":"ஆனால் உமது கட்டளைகளோ எல்லையற்றவை.","poem":2}]},{"type":"verse","number":97,"content":[{"text":"ஆ, உமது சட்டத்தை நான் எவ்வளவாய் நேசிக்கிறேன்!","poem":1},{"text":"நாள்முழுவதும் நான் அதை தியானிக்கிறேன்.","poem":2}]},{"type":"verse","number":98,"content":[{"text":"உமது கட்டளைகள் எப்பொழுதும் என்னுடன் இருப்பதால்,","poem":1},{"text":"அவை எனது பகைவரைப் பார்க்கிலும், என்னை ஞானியாக்கியது.","poem":2}]},{"type":"verse","number":99,"content":[{"text":"நான் உமது நியமங்களைத் தியானிப்பதினால்,","poem":1},{"text":"எனது ஆசிரியர்கள் எல்லோரைப் பார்க்கிலும் நான் அதிக அறிவுள்ளவனாக இருக்கிறேன்.","poem":2}]},{"type":"verse","number":100,"content":[{"text":"நான் உமது ஒழுங்குவிதிகளுக்குக் கீழ்ப்படிவதினால்,","poem":1},{"text":"முதியவர்களைவிட அதிக புரிந்துகொள்ளுதல் உள்ளவனாயிருக்கிறேன்.","poem":2}]},{"type":"verse","number":101,"content":[{"text":"உமது வார்த்தைக்குக் கீழ்ப்படியும்படி நான் என் நடைகளை,","poem":1},{"text":"எல்லாத் தீய வழிகளிலுமிருந்து விலக்கிக் காத்துக்கொண்டேன்;","poem":2}]},{"type":"verse","number":102,"content":[{"text":"நான் உமது சட்டங்களைவிட்டு விலகிப் போகாமலிருக்கிறேன்;","poem":1},{"text":"ஏனெனில் நீர் தாமே அவைகளை எனக்கு போதித்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":103,"content":[{"text":"உமது வார்த்தைகள் எனக்கு எவ்வளவு இனிமையானவை!","poem":1},{"text":"என் வாய்க்கு அவை தேனைவிட இனிமையானவை.","poem":2}]},{"type":"verse","number":104,"content":[{"text":"உமது ஒழுங்குவிதிகளால் நான் விளங்கும் ஆற்றலைப் பெறுகிறேன்;","poem":1},{"text":"ஆகவே எல்லாத் தவறான வழிகளையும் நான் வெறுக்கிறேன்.","poem":2}]},{"type":"verse","number":105,"content":[{"text":"உமது வார்த்தை எனது கால்களுக்கு விளக்காகவும்","poem":1},{"text":"என் பாதைக்கு வெளிச்சமாகவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":106,"content":[{"text":"உமது நீதியான சட்டங்களை நான் பின்பற்றுவேன் என்று","poem":1},{"text":"நான் ஒரு சத்தியப் பிரமாணம் எடுத்தேன்;","poem":2},{"lineBreak":true},{"text":"அதை உறுதிப்படுத்தியும் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":107,"content":[{"text":"நான் அதிகமாய் துன்பமடைந்திருக்கிறேன்;","poem":1},{"text":"யெகோவாவே, உமது வார்த்தையின்படியே என் வாழ்வைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":108,"content":[{"text":"யெகோவாவே, நான் மனப்பூர்வமாக செலுத்தும் என் வாயின் துதிகளை ஏற்றுக்கொள்ளும்;","poem":1},{"text":"உமது நீதிநெறிகளை எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":109,"content":[{"text":"என் உயிர் எப்போதும் ஆபத்தில் இருந்தாலும்,","poem":1},{"text":"உமது சட்டத்தையோ மறக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":110,"content":[{"text":"கொடியவர்கள் எனக்குக் கண்ணிவைத்தார்கள்;","poem":1},{"text":"ஆனாலும் நான் உமது ஒழுங்குவிதிகளைவிட்டு விலகவில்லை.","poem":2}]},{"type":"verse","number":111,"content":[{"text":"உமது நியமங்களே என்றென்றுமாய் எனது பரம்பரைச் சொத்து;","poem":1},{"text":"அவைகள் என் இருதயத்தின் மகிழ்ச்சி.","poem":2}]},{"type":"verse","number":112,"content":[{"text":"உமது விதிமுறைகளை கடைசிவரைக்கும் கைக்கொள்ள","poem":1},{"text":"என் இருதயம் ஆயத்தமாய் இருக்கிறது.","poem":2}]},{"type":"verse","number":113,"content":[{"text":"இருமனம் கொண்டவர்களை நான் வெறுக்கிறேன்.","poem":1},{"text":"நானோ உமது சட்டத்தை நேசிக்கிறேன்.","poem":2}]},{"type":"verse","number":114,"content":[{"text":"நீரே என் புகலிடமும் என் கேடயமுமாய் இருக்கிறீர்;","poem":1},{"text":"உமது வார்த்தையில் எனது நம்பிக்கையை வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":115,"content":[{"text":"அக்கிரம செய்கைக்காரே, என்னைவிட்டு அகன்றுபோங்கள்,","poem":1},{"text":"நான் என் இறைவனின் கட்டளைகளைக் கைக்கொள்ளுவேன்!","poem":2}]},{"type":"verse","number":116,"content":[{"text":"உமது வாக்குத்தத்தத்தின்படி என்னைக் காப்பாற்றும்;","poem":1},{"text":"அப்பொழுது நான் வாழ்வடைவேன்;","poem":2},{"lineBreak":true},{"text":"என் நம்பிக்கை வீண்போக விடாதேயும்.","poem":2}]},{"type":"verse","number":117,"content":[{"text":"என்னைத் தாங்கிக்கொள்ளும். அப்பொழுது நான் விடுவிக்கப்படுவேன்;","poem":1},{"text":"நான் எப்பொழுதும் உமது விதிமுறைகளை மதிப்பேன்.","poem":2}]},{"type":"verse","number":118,"content":[{"text":"உமது விதிமுறைகளிலிருந்து விலகிப்போகிற","poem":1},{"text":"எல்லோரையும் நீர் புறக்கணிக்கிறீர்.","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய வஞ்சனை வெறுமையானது.","poem":2}]},{"type":"verse","number":119,"content":[{"text":"பூமியிலுள்ள கொடியவர்கள் அனைவரையும் நீர் களிம்பைப்போல் நீக்கிவிடுகிறீர்;","poem":1},{"text":"ஆகையால் நான் உமது நியமங்களை நேசிக்கிறேன்.","poem":2}]},{"type":"verse","number":120,"content":[{"text":"உம் மீதுள்ள பயபக்தியால் எனது தசை நடுங்குகிறது;","poem":1},{"text":"நான் உமது சட்டங்களுக்குப் பயப்படுகிறேன்.","poem":2}]},{"type":"verse","number":121,"content":[{"text":"நான் நியாயமும், நீதியுமானதைச் செய்திருக்கிறேன்;","poem":1},{"text":"என்னை ஒடுக்குகிறவர்களிடத்தில் என்னை விட்டுவிடாதேயும்.","poem":2}]},{"type":"verse","number":122,"content":[{"text":"உமது பணியாளனின் நல்வாழ்வை உறுதிப்படுத்தும்;","poem":1},{"text":"அகந்தையுள்ளவர்கள் என்னை ஒடுக்குவதற்கு இடமளியாதேயும்.","poem":2}]},{"type":"verse","number":123,"content":[{"text":"உமது இரட்சிப்பைக் காண்பதற்கும்,","poem":1},{"text":"உமது நீதியான வாக்குத்தத்தங்கள் நிறைவேறுவதற்கும் காத்திருந்து,","poem":2},{"lineBreak":true},{"text":"என் கண்கள் மங்கிப்போகின்றன.","poem":2}]},{"type":"verse","number":124,"content":[{"text":"உமது உடன்படிக்கையின் அன்பின்படியே உமது அடியேனுக்கு செய்தருளி,","poem":1},{"text":"உமது விதிமுறைகளை எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":125,"content":[{"text":"நான் உமது பணியாளன்;","poem":1},{"text":"உமது நியமங்களை விளங்கிக்கொள்ளும்படி எனக்கு பகுத்தறிவைத் தாரும்.","poem":2}]},{"type":"verse","number":126,"content":[{"text":"யெகோவாவே, நீர் செயலாற்றும் வேளை வந்தது;","poem":1},{"text":"உமது சட்டம் மீறப்பட்டுவிட்டது.","poem":2}]},{"type":"verse","number":127,"content":[{"text":"உமது கட்டளைகளை தங்கத்தைவிட,","poem":1},{"text":"சுத்தத் தங்கத்தைவிட அதிகமாய் விரும்புகிறதினாலும்,","poem":2}]},{"type":"verse","number":128,"content":[{"text":"உமது ஒழுங்குவிதிகளெல்லாம் நியாயமானவை என்று நான் எண்ணுவதாலும்,","poem":1},{"text":"நான் தவறான வழிகளையெல்லாம் வெறுக்கிறேன்.","poem":2}]},{"type":"verse","number":129,"content":[{"text":"உமது நியமங்கள் ஆச்சரியமானவை,","poem":1},{"text":"ஆகையால் நான் அவைகளுக்குக் கீழ்ப்படிகிறேன்.","poem":2}]},{"type":"verse","number":130,"content":[{"text":"உமது வார்த்தைகளின் வெளிப்படுத்தல் வெளிச்சத்தைக் கொடுக்கின்றன;","poem":1},{"text":"அவை எளியவர்களுக்கு புரிந்துகொள்ளும் ஆற்றலைக் கொடுக்கின்றன.","poem":2}]},{"type":"verse","number":131,"content":[{"text":"நான் உமது கட்டளைகளை விரும்பி,","poem":1},{"text":"என் வாயைத் திறந்தவன்னம் ஏங்குகிறேன்.","poem":2}]},{"type":"verse","number":132,"content":[{"text":"உமது பெயரை நேசிக்கிறவர்களுக்கு நீர் எப்பொழுதும் செய்கிறபடியே,","poem":1},{"text":"என் பக்கம் திரும்பி என்மேல் இரக்கமாயிரும்.","poem":2}]},{"type":"verse","number":133,"content":[{"text":"உமது வார்த்தையின்படியே என் காலடிகளை வழிநடத்தி,","poem":1},{"text":"ஒரு பாவமும் என்னை ஆளுகைசெய்ய விடாதேயும்.","poem":2}]},{"type":"verse","number":134,"content":[{"text":"மனிதரின் அடக்கு முறையிலிருந்து என்னை மீட்டுக்கொள்ளும்;","poem":1},{"text":"அதினால் நான் உமது ஒழுங்குவிதிகளைக் கைக்கொள்வேன்.","poem":2}]},{"type":"verse","number":135,"content":[{"text":"உமது அடியேன்மேல் உமது முகத்தைப் பிரகாசிக்கப்பண்ணும்;","poem":1},{"text":"உமது விதிமுறைகளை எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":136,"content":[{"text":"மனிதர் உமது சட்டத்திற்குக் கீழ்ப்படியாதபடியால்,","poem":1},{"text":"எனது கண்களில் இருந்து கண்ணீர் ஆறாகப் பெருக்கெடுக்கிறது.","poem":2}]},{"type":"verse","number":137,"content":[{"text":"யெகோவாவே, நீர் நீதியுள்ளவர்;","poem":1},{"text":"உமது சட்டங்கள் நியாயமானவை.","poem":2}]},{"type":"verse","number":138,"content":[{"text":"நீர் ஏற்படுத்திய நியமங்கள் நீதியானவை;","poem":1},{"text":"அவை முற்றும் நம்பத்தகுந்தவை.","poem":2}]},{"type":"verse","number":139,"content":[{"text":"என் பகைவர்கள் உமது வார்த்தைகளை உதாசீனம் செய்வதால்,","poem":1},{"text":"எனது தீவிர ஆர்வம் என்னை சுட்டெரிக்கிறது.","poem":2}]},{"type":"verse","number":140,"content":[{"text":"உமது வாக்குத்தத்தங்கள் முற்றிலும் சோதித்து நிரூபிக்கப்பட்டிருக்கின்றன;","poem":1},{"text":"உமது அடியேன் அவற்றை நேசிக்கிறேன்.","poem":2}]},{"type":"verse","number":141,"content":[{"text":"நான் அற்பமானவனும் வெறுக்கப்பட்டவனுமாய் இருந்தாலும்,","poem":1},{"text":"உமது ஒழுங்குவிதிகளை நான் மறக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":142,"content":[{"text":"உமது நீதி நித்தியமானது,","poem":1},{"text":"உமது சட்டம் உண்மையானது.","poem":2}]},{"type":"verse","number":143,"content":[{"text":"கஷ்டமும் துன்பமும் என்மேல் வந்தன;","poem":1},{"text":"ஆனாலும், உமது கட்டளைகள் என் மகிழ்ச்சியாய் இருக்கின்றன.","poem":2}]},{"type":"verse","number":144,"content":[{"text":"உமது நியமங்கள் என்றென்றும் நீதியானவை;","poem":1},{"text":"அவற்றை விளங்கிக்கொள்ளும் ஆற்றலை எனக்குத் தாரும், அதினால் நான் பிழைப்பேன்.","poem":2}]},{"type":"verse","number":145,"content":[{"text":"யெகோவாவே, என் முழு இருதயத்துடனும் கூப்பிடுகிறேன்;","poem":1},{"text":"எனக்குப் பதில் தாரும்,","poem":2},{"lineBreak":true},{"text":"நான் உமது விதிமுறைகளுக்குக் கீழ்ப்படிவேன்.","poem":2}]},{"type":"verse","number":146,"content":[{"text":"நான் உம்மைக் கூப்பிடுகிறேன், என்னைக் காப்பாற்றும்;","poem":1},{"text":"நான் உமது நியமங்களைக் கைக்கொள்வேன்.","poem":2}]},{"type":"verse","number":147,"content":[{"text":"விடிகிறதற்கு முன்னே நான் எழுந்து உதவிக்காகக் கூப்பிடுகிறேன்;","poem":1},{"text":"உமது வார்த்தையில் என் எதிர்பார்ப்பை வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":148,"content":[{"text":"உமது வாக்குத்தத்தங்களை நான் தியானிக்கும்படி,","poem":1},{"text":"இராமுழுவதும் என் கண்கள் விழித்திருக்கின்றன.","poem":2}]},{"type":"verse","number":149,"content":[{"text":"நீர் என்மீது உடன்படிக்கையின் அன்புகூறுகிறபடியால் என் குரலைக் கேளும்;","poem":1},{"text":"யெகோவாவே, உமது சட்டங்களின்படியே என் வாழ்வைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":150,"content":[{"text":"கொடுமையான திட்டங்களைத் தீட்டுகிறவர்கள் எனக்கு அருகே இருக்கிறார்கள்;","poem":1},{"text":"ஆனால், அவர்கள் உமது சட்டத்திற்குத் தூரமாய் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":151,"content":[{"text":"என்றாலும் யெகோவாவே, நீர் அருகே இருக்கிறீர்;","poem":1},{"text":"உமது கட்டளைகள் எல்லாம் உண்மை.","poem":2}]},{"type":"verse","number":152,"content":[{"text":"உமது நியமங்கள் நித்தியமாய் இருக்க நீர் அவைகளை நிலைநாட்டினீர் என்பதை","poem":1},{"text":"வெகுகாலத்திற்கு முன்பே நான் அறிந்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":153,"content":[{"text":"என் வேதனையைப் பார்த்து என்னை விடுவியும்;","poem":1},{"text":"ஏனெனில், நான் உமது சட்டத்தை மறந்துவிடவில்லை.","poem":2}]},{"type":"verse","number":154,"content":[{"text":"எனக்காக வாதாடி என்னை மீட்டுக்கொள்ளும்;","poem":1},{"text":"உமது வாக்குத்தத்தத்தின்படி என் வாழ்வைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":155,"content":[{"text":"இரட்சிப்பு கொடியவர்களுக்குத் தூரமாய் இருக்கிறதினால்,","poem":1},{"text":"அவர்கள் உமது விதிமுறைகளைத் தேடுவதில்லை.","poem":2}]},{"type":"verse","number":156,"content":[{"text":"யெகோவாவே, உமது இரக்கம் பெரிதானது;","poem":1},{"text":"உமது சட்டங்களின்படியே என் வாழ்வைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":157,"content":[{"text":"என்னை உபத்திரவப்படுத்துகிற எதிரிகள் அநேகராயிருக்கிறார்கள்;","poem":1},{"text":"ஆனாலும் நான் உம்முடைய நியமங்களை விட்டு விலகவில்லை.","poem":2}]},{"type":"verse","number":158,"content":[{"text":"துரோகிகளை நான் அருவருப்புடன் பார்க்கிறேன்;","poem":1},{"text":"ஏனெனில் அவர்கள் உமது வார்த்தைக்குக் கீழ்ப்படிகிறதில்லை.","poem":2}]},{"type":"verse","number":159,"content":[{"text":"நான் உமது ஒழுங்குவிதிகளை எவ்வளவாய் நேசிக்கிறேனென்று பாரும்;","poem":1},{"text":"யெகோவாவே, உமது உடன்படிக்கையின் அன்பின்படியே என் வாழ்வைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":160,"content":[{"text":"உமது வார்தைகள் எல்லாம் உண்மையானவை;","poem":1},{"text":"நீதியான உமது சட்டங்கள் எல்லாம் நித்தியமானவை.","poem":2}]},{"type":"verse","number":161,"content":[{"text":"ஆட்சியாளர்கள் காரணமில்லாமல் என்னை உபத்திரவப்படுத்துகிறார்கள்;","poem":1},{"text":"ஆனாலும் என் இருதயம் உமது வார்த்தைக்கு நடுங்குகிறது.","poem":2}]},{"type":"verse","number":162,"content":[{"text":"பெரும் கொள்ளைப்பொருளைக் கண்டுபிடித்து மகிழ்வதுபோல்,","poem":1},{"text":"உமது வாக்குத்தத்தத்தில் நான் மகிழ்ச்சியடைகிறேன்.","poem":2}]},{"type":"verse","number":163,"content":[{"text":"நான் பொய்யை வெறுத்து அருவருக்கிறேன்;","poem":1},{"text":"ஆனால் உமது சட்டத்தையோ நான் நேசிக்கிறேன்.","poem":2}]},{"type":"verse","number":164,"content":[{"text":"நீதியான உமது சட்டங்களுக்காக","poem":1},{"text":"நான் ஒரு நாளில் ஏழுமுறை உம்மைத் துதிக்கிறேன்.","poem":2}]},{"type":"verse","number":165,"content":[{"text":"உமது சட்டத்தை நேசிக்கிறவர்களுக்குப் பெரிதான சமாதானம் உண்டு;","poem":1},{"text":"அவர்களுக்கு இடறலில்லை.","poem":2}]},{"type":"verse","number":166,"content":[{"text":"யெகோவாவே, உமது இரட்சிப்புக்காக நான் காத்திருக்கிறேன்;","poem":1},{"text":"உமது கட்டளைகளை நான் பின்பற்றுகிறேன்.","poem":2}]},{"type":"verse","number":167,"content":[{"text":"நான் உமது நியமங்களுக்குக் கீழ்ப்படிகிறேன்;","poem":1},{"text":"ஏனெனில் நான் அவற்றை அதிகமாய் நேசிக்கிறேன்.","poem":2}]},{"type":"verse","number":168,"content":[{"text":"நான் உமது ஒழுங்குவிதிகளுக்கும் நியமங்களுக்கும் கீழ்ப்படிகிறேன்;","poem":1},{"text":"எனது எல்லா செயல்களும் உமக்குத் தெரிந்திருக்கின்றன.","poem":2}]},{"type":"verse","number":169,"content":[{"text":"யெகோவாவே, எனது வேண்டுதலை நீர் கேட்பீராக;","poem":1},{"text":"உமது வார்த்தையின்படியே எனக்கு விளங்கிக்கொள்ளும் ஆற்றலைத் தாரும்.","poem":2}]},{"type":"verse","number":170,"content":[{"text":"என் விண்ணப்பத்தை நீர் கேட்பீராக;","poem":1},{"text":"உமது வாக்குத்தத்தத்தின்படியே என்னை விடுவியும்.","poem":2}]},{"type":"verse","number":171,"content":[{"text":"எனது உதடுகள் துதிகளினால் நிரம்பி வழிகிறது;","poem":1},{"text":"ஏனெனில், நீர் உமது விதிமுறைகளை எனக்குப் போதிக்கிறீர்.","poem":2}]},{"type":"verse","number":172,"content":[{"text":"எனது நாவு உமது வார்த்தையைக் குறித்துப் பாடட்டும்;","poem":1},{"text":"ஏனெனில், உமது கட்டளைகள் எல்லாம் நியாயமானவை.","poem":2}]},{"type":"verse","number":173,"content":[{"text":"உமது கரம் எனக்கு உதவிசெய்ய ஆயத்தமாய் இருப்பதாக;","poem":1},{"text":"ஏனெனில் நான் உமது ஒழுங்குவிதிகளைத் தேர்ந்தெடுத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":174,"content":[{"text":"யெகோவாவே, நான் உமது இரட்சிப்புக்கு வாஞ்சையாயிருக்கிறேன்;","poem":1},{"text":"உமது சட்டம் எனது மகிழ்ச்சி.","poem":2}]},{"type":"verse","number":175,"content":[{"text":"நான் உம்மைத் துதிக்கும்படி வாழ்ந்திருப்பேனாக;","poem":1},{"text":"உமது சட்டங்கள் என்னைத் தாங்குவதாக.","poem":2}]},{"type":"verse","number":176,"content":[{"text":"காணாமற்போன ஆட்டைப்போல் நான் வழிவிலகிப் போய்விட்டேன்;","poem":1},{"text":"உமது அடியேனைத் தேடுவீராக;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் நான் உமது கட்டளைகளை மறக்கவில்லை.","poem":2}]}],"footnotes":[{"noteId":16,"caller":"+","text":"போதனைகளை அல்லது செயல்களை","reference":{"chapter":119,"verse":27}},{"noteId":17,"caller":"+","text":"காத்துக்கொள்ளும் அல்லது உயிர்வாழச் செய்யும்.","reference":{"chapter":119,"verse":88}}]},"thisChapterLink":"/api/tam_tcv/PSA/119.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/120.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/118.json","previousChapterAudioLinks":{},"numberOfVerses":176}