{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":12,"content":[{"type":"hebrew_subtitle","content":["செமினீத் என்னும் இராகத்தில் வாசிக்க பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உதவிசெய்யும், இறை பக்தியுள்ளவர் ஒருவருமே இல்லை;","poem":1},{"text":"மனிதருள் உண்மையுள்ளவர்கள் குறைந்துவிட்டார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஒவ்வொருவனும் தன் அயலானிடம் பொய்ப் பேசுகிறான்;","poem":1},{"text":"அவர்களுடைய உதடுகளால் முகஸ்துதி பேசி","poem":2},{"lineBreak":true},{"text":"இருதயத்தில் வஞ்சனை வைத்திருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"முகஸ்துதி பேசும் எல்லா உதடுகளையும்","poem":1},{"text":"பெருமை பேசும் ஒவ்வொரு நாவையும் யெகோவா அறுத்துப் போடுவாராக.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“எங்கள் நாவினாலேயே நாங்கள் வெற்றி கொள்வோம்;","poem":1},{"text":"எங்கள் சொற்களே எங்களுக்குத் துணை; எங்களுக்குத் தலைவர் யார்?”","poem":2},{"lineBreak":true},{"text":"என்று அவர்கள் சொல்லுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“ஏழைகள் ஒடுக்கப்படுகிறார்கள்; எளியவர்கள் புலம்பிக் கொண்டிருக்கிறார்கள்.","poem":1},{"text":"இதினால் நான் இப்பொழுது எழுந்து,","poem":2},{"lineBreak":true},{"text":"அவர்களைத் துன்புறுத்துவோரிடமிருந்து காப்பாற்றுவேன்” என்று யெகோவா கூறுகிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவின் வார்த்தைகள் தூய்மையானவை.","poem":1},{"text":"அவை களிமண் உலையில்","poem":2},{"lineBreak":true},{"text":"ஏழு தரம் சுத்திகரிக்கப்பட்ட வெள்ளியைப்போல் இருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே, நீர் ஏழைகளாகிய அவர்களைப் பாதுகாப்பாய் வைத்துக்கொள்வீர்;","poem":1},{"text":"கொடியவர்களிடமிருந்து எங்களை என்றென்றும் காத்துக்கொள்வீர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"இழிவான செயல்கள் மனிதர் மத்தியில் பாராட்டப்படுவதினால்","poem":1},{"text":"கொடியவர்கள் வீம்புடன் சுற்றித் திரிகிறார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/11.json","previousChapterAudioLinks":{},"numberOfVerses":8}