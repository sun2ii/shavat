{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":120,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"நான் என் துன்பத்தில் யெகோவாவை நோக்கிக் கூப்பிடுகிறேன்;","poem":1},{"text":"அவர் எனக்குப் பதிலளிக்கிறார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே,","poem":1},{"text":"பொய்ப் பேசுகிற உதடுகளிலிருந்தும்,","poem":2},{"lineBreak":true},{"text":"வஞ்சக நாவுகளிலிருந்தும் என்னைக் காப்பாற்றும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"வஞ்சக நாவே,","poem":1},{"text":"இறைவன் உனக்குச் செய்யப்போவது என்ன?","poem":2},{"lineBreak":true},{"text":"அதற்கு மேலும் உனக்கு என்னதான் கிடைக்கும்?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"போர்வீரனின் கூர்மையான அம்புகளினாலும்,","poem":1},{"text":"சூரைச்செடிகளை எரிக்கும் நெருப்புத் தழல்களினாலும் அவர் உன்னைத் தண்டிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஐயோ, எனக்குக் கேடு! நான் மேசேக்கிலே","poem":1},{"text":"வேறுநாட்டைச் சேர்ந்தவனாய் குடியிருக்கிறேனே;","poem":2},{"lineBreak":true},{"text":"கேதாரின் கூடாரங்களில் வாழ்கிறேனே!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"சமாதானத்தை வெறுக்கிறவர்கள் மத்தியில்","poem":1},{"text":"நான் நெடுநாள் வாழ வேண்டியதாயிற்று.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் சமாதானத்தை நாடுகிறேன்;","poem":1},{"text":"அவர்களோ, நான் பேசும்போது யுத்தத்தையே தேடுகிறார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}