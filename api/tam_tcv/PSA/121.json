{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":121,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"மலைகளுக்கு நேராக என் கண்களை உயர்த்துகிறேன்.","poem":1},{"text":"எங்கிருந்து எனக்கு உதவி வரும்?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"வானத்தையும் பூமியையும் படைத்தவரான யெகோவாவிடமிருந்தே,","poem":1},{"text":"எனக்கு உதவி வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"அவர் உன் காலைச் சறுக்கவிடமாட்டார்;","poem":1},{"text":"உன்னைக் காக்கும் அவர் உறங்கமாட்டார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இதோ, இஸ்ரயேலைக் காக்கிறவர்,","poem":1},{"text":"உறங்குகிறதுமில்லை தூங்குகிறதுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவா உன்னைக் காக்கிறவர்;","poem":1},{"text":"யெகோவா உன் வலப்பக்கத்திலே உனக்கு நிழலாக இருக்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"பகலில் சூரியனோ,","poem":1},{"text":"இரவில் சந்திரனோ உனக்குத் தீங்கு செய்யாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவா உன்னை எல்லாத் தீங்கிலிருந்தும் காப்பார்;","poem":1},{"text":"அவர் உன் வாழ்வைக் காப்பார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவா உன் போக்கையும் வரத்தையும்","poem":1},{"text":"இப்பொழுதும் எப்பொழுதும் காப்பார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}