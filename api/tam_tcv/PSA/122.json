{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":122,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"“யெகோவாவின் ஆலயத்திற்கு நாம் போவோம்”","poem":1},{"text":"என்று என்னிடம் சொன்னவர்களோடு சேர்ந்து நான் மகிழ்ச்சியடைந்தேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"எருசலேமே, எங்கள் கால்கள்","poem":1},{"text":"உன் வாசல்களில் நிற்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நெருக்கமாய் ஒருங்கிணைக்கப்பட்ட ஒரு பட்டணத்தைப்போல்,","poem":1},{"text":"எருசலேம் கட்டப்பட்டிருக்கிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவாவினுடைய பெயரைத் துதிப்பதற்கு,","poem":1},{"text":"கோத்திரங்கள் அங்கு போவார்கள்;","poem":2},{"text":"இஸ்ரயேலுக்குக் கொடுக்கப்பட்ட நியமத்தின்படி,","poem":1},{"text":"யெகோவாவினுடைய கோத்திரங்கள் அங்கு போவார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தாவீதின் குடும்ப வரிசையின் சிங்காசனங்கள் உள்ளன;","poem":1},{"text":"அங்கே மக்கள் நியாயம் தீர்க்கப்படுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"எருசலேமின் சமாதானத்திற்காக மன்றாடுங்கள்:","poem":1},{"text":"“உன்னை நேசிப்பவர்கள் பாதுகாப்பாய் இருப்பார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உன் மதில்களுக்குள் சமாதானமும்,","poem":1},{"text":"உன் கோட்டைகளுக்குள் பாதுகாப்பும் இருப்பதாக.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் குடும்பத்தின் நிமித்தமும், என் சிநேகிதர்கள் நிமித்தமும்","poem":1},{"text":"“உனக்குள் சமாதானம் இருக்கட்டும்” என்று நான் வாழ்த்துகிறேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எங்கள் இறைவனாகிய யெகோவாவின் ஆலயம் அங்கு இருப்பதால்,","poem":1},{"text":"நான் உன் செழிப்பைத் தேடுவேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/122.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/123.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/121.json","previousChapterAudioLinks":{},"numberOfVerses":9}