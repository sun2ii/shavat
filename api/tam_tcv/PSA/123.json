{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":123,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"பரலோகத்தின் சிங்காசனத்தில் அமர்ந்திருக்கிறவரே,","poem":1},{"text":"நான் உம்மை நோக்கி என் கண்களை உயர்த்தி மன்றாடுகிறேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அடிமைகளின் கண்கள் தங்கள் எஜமானுடைய கரத்தை நோக்கிப் பார்ப்பதுபோலவும்,","poem":1},{"text":"அடிமைப்பெண்ணின் கண்கள் தன் எஜமாட்டியினுடைய கரத்தை நோக்கிப் பார்ப்பதுபோலவும்,","poem":2},{"text":"எங்கள் கண்களும் எங்கள் இறைவனாகிய யெகோவா எங்களுக்கு இரக்கம் காண்பிக்கும்வரை,","poem":1},{"text":"அவரையே நோக்கிப்பார்க்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"எங்கள்மேல் இரக்கமாயிரும், யெகோவாவே, எங்கள்மேல் இரக்கமாயிரும்;","poem":1},{"text":"அதிகமான அவமதிப்பை நாங்கள் சகித்துக்கொண்டோம்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பெருமைக்காரரின் ஏளனத்தையும்,","poem":1},{"text":"அகங்காரம் கொண்டவர்களின் அதிகமான அவமதிப்பையும்","poem":2},{"lineBreak":true},{"text":"நாங்கள் சகித்துக்கொண்டோம்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/123.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/124.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/122.json","previousChapterAudioLinks":{},"numberOfVerses":4}