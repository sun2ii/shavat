{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":124,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா நமது பக்கத்தில் இல்லாவிட்டால்,","poem":1},{"text":"இதை இஸ்ரயேலர் சொல்லட்டும்:","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மனிதர் நம்மை தாக்கும்போது","poem":1},{"text":"யெகோவா தாமே நமது பக்கத்தில் இல்லாவிட்டால்,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் கோபம் நமக்கு எதிராகப் பற்றியெரிந்தபோது,","poem":1},{"text":"அவர்கள் நம்மை உயிருடன் விழுங்கியிருப்பார்களே;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"வெள்ளம் நம்மை மூழ்கடித்திருக்குமே,","poem":1},{"text":"நீரோட்டம் நம்மீது புரண்டு ஓடியிருக்குமே,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பொங்கி வந்த வெள்ளம்","poem":1},{"text":"நம்மீது பாய்ந்தோடியிருக்குமே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவர்கள் நம்மை பற்களால் கிழித்துப்போட இடமளிக்காத","poem":1},{"text":"யெகோவாவுக்குத் துதி உண்டாகட்டும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"வேடனுடைய கண்ணியிலிருந்து","poem":1},{"text":"தப்பின பறவையைப்போல் நாம் தப்பிப் பிழைத்தோம்;","poem":2},{"text":"கண்ணி அறுந்தது,","poem":1},{"text":"நாம் தப்பினோம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"வானத்தையும் பூமியையும் படைத்தவரான","poem":1},{"text":"யெகோவாவினுடைய பெயரிலே நமக்கு உதவி உண்டு.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}