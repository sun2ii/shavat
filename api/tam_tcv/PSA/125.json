{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":125,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவை நம்புகிறவர்கள் சீயோன் மலையைப்போல்","poem":1},{"text":"என்றென்றும் அசையாமல் நிலைத்திருப்பார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மலைகள் எருசலேமைச் சுற்றிலும் இருப்பதைப்போல்,","poem":1},{"text":"யெகோவா இப்பொழுதும் எப்பொழுதும்","poem":2},{"lineBreak":true},{"text":"தமது மக்களைச் சுற்றியிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நீதிமான்களுக்கென ஒதுக்கப்பட்ட நாட்டின்மேல்,","poem":1},{"text":"கொடியவர்களின் ஆட்சி நீடிக்காது;","poem":2},{"text":"இல்லையெனில், நீதியற்றவர்களும் தீமைசெய்யத்","poem":1},{"text":"தங்கள் கைகளை நீட்டலாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே, நல்லவர்களுக்கு,","poem":1},{"text":"இருதயத்தில் நேர்மையாய் இருப்போருக்கு நன்மை செய்யும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"குறுக்கு வழிகளுக்குத் திரும்புகிறவர்களையோ,","poem":1},{"text":"யெகோவா தீயவரோடேகூட தண்டிப்பார்.","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலின்மீது சமாதானம் உண்டாவதாக.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/125.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/126.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/124.json","previousChapterAudioLinks":{},"numberOfVerses":5}