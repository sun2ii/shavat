{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":126,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"நாடு கடத்தப்பட்டவர்களை யெகோவா திரும்பவும் சீயோனுக்குக் கொண்டுவந்தபோது,","poem":1},{"text":"நாங்கள் கனவு காண்கிறவர்கள்போல் இருந்தோம்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"எங்கள் வாய்கள் சிரிப்பினாலும்,","poem":1},{"text":"எங்கள் நாவுகள் மகிழ்ச்சிப் பாடல்களினாலும் நிறைந்திருந்தன.","poem":2},{"text":"அப்பொழுது, “யெகோவா அவர்களுக்காகப் பெரிய காரியங்களைச் செய்தார்”","poem":1},{"text":"என்று நாடுகளுக்கிடையே சொல்லப்பட்டது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யெகோவா நமக்காகப் பெரிய காரியங்களைச் செய்தார்;","poem":1},{"text":"அதினால் நாம் மகிழ்ச்சியினால் நிறைந்திருக்கிறோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே, நீரோடைகள் நெகேவ் பாலைவனத்தை புதுப்பிப்பதுபோல,","poem":1},{"text":"எங்கள் நல்வாழ்வை எங்களுக்குத் திருப்பித்தாரும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கண்ணீருடன் விதைக்கிறவர்கள்,","poem":1},{"text":"மகிழ்ச்சியின் பாடல்களுடன் அறுவடை செய்வார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"விதைப்பதற்கான விதைகளை","poem":1},{"text":"அழுதுகொண்டு சுமந்து போகிறவன்,","poem":2},{"text":"மகிழ்ச்சியின் பாடல்களுடன்","poem":1},{"text":"கதிர்க்கட்டுகளைச் சுமந்துகொண்டு திரும்பிவருவான்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}