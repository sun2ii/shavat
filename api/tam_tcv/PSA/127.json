{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":127,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் சாலொமோனின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா வீட்டைக் கட்டவில்லையென்றால்,","poem":1},{"text":"அதைக் கட்டுகிறவர்களின் உழைப்பு வீண்;","poem":2},{"text":"யெகோவா நகரத்தின்மேல் கண்காணிப்பாய் இருக்கவில்லையென்றால்,","poem":1},{"text":"காவலர் அதைக் காவல் செய்வதும் வீண்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீங்கள் சாப்பிடும் உணவுக்காக அதிகாலையில் எழுந்து,","poem":1},{"text":"நித்திரையின்றி நீண்டநேரம் உழைப்பதும் வீண்;","poem":2},{"text":"ஏனெனில் அவர் தாம் நேசிக்கிறவர்களுக்கு","poem":1},{"text":"அவர்கள் தூங்கும்போதும்கூட தேவையைத் தருகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"பிள்ளைகள் யெகோவாவிடமிருந்து கிடைக்கும் உரிமைச்சொத்து;","poem":1},{"text":"பிள்ளைகள் அவரிடமிருந்து கிடைக்கும் வெகுமதியே.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஒருவன் தன் வாலிபப் பருவத்தில் பெற்றெடுக்கும் பிள்ளைகள்","poem":1},{"text":"போர்வீரனின் கைகளில் இருக்கும் அம்புகளைப்போல் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இவ்வித அம்புகளால் தன் அம்புக்கூட்டை நிரப்பிய","poem":1},{"text":"மனிதன் ஆசீர்வதிக்கப்பட்டவன்;","poem":2},{"text":"நீதிமன்றத்தில் தங்கள் பகைவரோடு வாதாடும்போது,","poem":1},{"text":"அவர்கள் வெட்கப்படமாட்டார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}