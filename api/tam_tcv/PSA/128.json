{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":128,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்கு பயந்து அவருடைய வழிகளில் நடக்கும்","poem":1},{"text":"அனைவரும் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உன் உழைப்பின் பலனை நீ சாப்பிடுவாய்;","poem":1},{"text":"ஆசீர்வாதங்களும் செல்வச் செழிப்பும் உன்னுடையவைகளாகும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உன் மனைவி உன் வீட்டிற்குள்","poem":1},{"text":"கனி நிறைந்த திராட்சைக் கொடியைப்போல் இருப்பாள்;","poem":2},{"text":"ஒலிவமரத்தைச் சுற்றித் தளிர்கள் இருப்பதுபோல்,","poem":1},{"text":"உன் பிள்ளைகள் உன் பந்தியிலே உன்னைச் சுற்றி இருப்பார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆம், யெகோவாவுக்குப் பயந்து நடக்கிற மனிதன்","poem":1},{"text":"இவ்விதமாய் ஆசீர்வதிக்கப்படுகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவா சீயோனிலிருந்து உன்னை ஆசீர்வதிப்பாராக;","poem":1},{"text":"உன் வாழ்நாட்களெல்லாம்","poem":2},{"lineBreak":true},{"text":"எருசலேமின் செழிப்பை நீ காண்பாயாக.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீ உன் பிள்ளைகளின் பிள்ளைகளைக் காணும்வரை வாழ்ந்திருப்பாயாக;","poem":1},{"text":"இஸ்ரயேலின்மீது சமாதானம் இருப்பதாக.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}