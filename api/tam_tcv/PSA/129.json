{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":129,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"“என் வாலிப காலத்திலிருந்து அவர்கள் என்னை மிகவும் ஒடுக்கினார்கள்” என்று","poem":1},{"text":"இஸ்ரயேலர் சொல்லட்டும்;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"“என் வாலிப காலத்திலிருந்து அவர்கள் என்னை மிகவும் ஒடுக்கினார்கள்,","poem":1},{"text":"ஆனாலும் அவர்களால் என்மேல் வெற்றிகொள்ள முடியவில்லை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உழுகிறவர்கள் என்னுடைய முதுகின்மேல் உழுது,","poem":1},{"text":"தங்களுடைய வரப்புகளை நீளமாக்கினார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனாலும் யெகோவா நீதியுள்ளவர்;","poem":1},{"text":"அவர் கொடியவர்களின் கட்டுகளை அறுத்து, என்னை விடுதலையாக்கினார்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"சீயோனை வெறுக்கிற அனைவரும்","poem":1},{"text":"வெட்கப்பட்டுத் திரும்பிப் போகட்டும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் வீட்டுக்கூரையில் முளைக்கும் புல்லைப்போல் ஆகட்டும்;","poem":1},{"text":"அது வளரும் முன்பு வாடிப்போகுமே.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அறுவடை செய்கிறவன் அவற்றால் தன் கைகளை நிரப்பிக்கொள்ள முடியாது;","poem":1},{"text":"அவற்றைச் சேர்க்கிறவனும் தன் கைகளை நிரப்பிக்கொள்ள முடியாது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"வழிப்போக்கர்கள் அவர்களிடம்,","poem":1},{"text":"“யெகோவாவின் ஆசீர்வாதம் உங்கள்மேல் இருக்கட்டும்;","poem":2},{"text":"யெகோவாவின் பெயரினால் நாங்கள் உங்களை ஆசீர்வதிக்கிறோம்”","poem":1},{"text":"என்றும் சொல்லாதிருக்கட்டும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}