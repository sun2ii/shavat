{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":13,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, எவ்வளவு காலத்திற்கு என்னை மறந்துவிடுவீர்?","poem":1},{"text":"எப்பொழுதுமே மறந்துவிடுவீரோ?","poem":2},{"lineBreak":true},{"text":"நீர் எவ்வளவு காலத்திற்கு என்னிடமிருந்து உமது முகத்தை மறைத்துக்கொள்வீர்?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"எவ்வளவு காலத்திற்கு நான் என் எண்ணங்களுடன் போராட வேண்டும்?","poem":1},{"text":"எவ்வளவு காலத்திற்கு அனுதினமும் என் இருதயத்தில் துக்கத்தோடு இருக்கவேண்டும்?","poem":2},{"lineBreak":true},{"text":"என் பகைவன் எவ்வளவு காலத்திற்கு என்னை வெற்றிகொள்வான்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"என் இறைவனாகிய யெகோவாவே, என்னை நோக்கிப்பாரும்; எனக்குப் பதில் கொடும்.","poem":1},{"text":"என் கண்களுக்கு ஒளியைத் தாரும்; அல்லது நான் மரணத்தில் உறங்கி விடுவேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அப்பொழுது என் பகைவன், “நான் அவனை மேற்கொண்டேன்” என்பான்;","poem":1},{"text":"நான் விழும்போது என் எதிரிகளும் மகிழ்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஆனால் நானோ, உமது உடன்படிக்கையின் அன்பில் நம்பிக்கையாய் இருக்கிறேன்;","poem":1},{"text":"என் இருதயம் உமது இரட்சிப்பில் மகிழ்கிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவா எனக்கு நன்மை செய்திருக்கிறார்,","poem":1},{"text":"அதினால் நான் அவருக்குத் துதி பாடுவேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}