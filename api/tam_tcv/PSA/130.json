{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":130,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, துயரத்தின் ஆழங்களிலிருந்து உம்மை நோக்கிக் கூப்பிடுகிறேன்.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே, என் குரலைக் கேளும்;","poem":2},{"text":"இரக்கத்திற்காக கூப்பிடும் எனது குரலை","poem":1},{"text":"உமது காதுகள் கவனமாய்க் கேட்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே, நீர் பாவங்களைப் பதிவுசெய்து வைத்திருப்பீரானால்,","poem":1},{"text":"யெகோவாவே, யார் உம்முன் நிற்கமுடியும்?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால், நாங்கள் பயபக்தியுடன் உங்களுக்கு சேவைசெய்ய","poem":1},{"text":"உம்மிடத்தில் மன்னிப்பு உண்டு.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நான் யெகோவாவுக்காகக் காத்திருக்கிறேன், என் ஆத்துமா காத்திருக்கிறது;","poem":1},{"text":"அவருடைய வார்த்தையிலேயே என் எதிர்பார்ப்பை வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"விடியற்காலைக்காகக் காத்திருக்கும் காவற்காரரைப் பார்க்கிலும்,","poem":1},{"text":"ஆம், விடியற்காலைக்காகக் காத்திருக்கும் காவற்காரரைப் பார்க்கிலும்,","poem":2},{"lineBreak":true},{"text":"என் ஆத்துமா யெகோவாவுக்குக் காத்திருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"இஸ்ரயேலே, உன் நம்பிக்கையை யெகோவாவிலேயே இருப்பதாக;","poem":1},{"text":"ஏனெனில் யெகோவாவிடத்தில் உடன்படிக்கையின் அன்பும்,","poem":2},{"lineBreak":true},{"text":"அவரிடத்தில் முழுமையான மீட்பும் உண்டு.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்தாமே இஸ்ரயேலரை","poem":1},{"text":"அவர்களின் எல்லாப் பாவங்களிலிருந்தும் மீட்பார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}