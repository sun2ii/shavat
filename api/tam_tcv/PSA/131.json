{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":131,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் தாவீதின் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என் இருதயம் பெருமையுள்ளதல்ல,","poem":1},{"text":"என் கண்கள் மேட்டிமையானவைகளுமல்ல;","poem":2},{"text":"பெரிய காரியங்களிலும்,","poem":1},{"text":"எனக்கு மிஞ்சிய செயல்களிலும் நான் ஈடுபடுவதில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பால் மறந்த குழந்தை தன் தாயின் மடியில் இருப்பதுபோல்,","poem":1},{"text":"என் ஆத்துமாவை நான் அடக்கி அமைதியாக்கினேன்;","poem":2},{"lineBreak":true},{"text":"என் ஆத்துமா பால் மறந்த குழந்தையைப்போல் இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"இஸ்ரயேலே, இப்பொழுதும் எப்பொழுதும்","poem":1},{"text":"யெகோவாவிலேயே உன் நம்பிக்கையை வைத்திரு.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/131.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/132.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/130.json","previousChapterAudioLinks":{},"numberOfVerses":3}