{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":132,"content":[{"type":"hebrew_subtitle","content":["சீயோன் மலை ஏறும்போது பாடும் பாடல்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, தாவீதையும்","poem":1},{"text":"அவன் சகித்துக்கொண்ட எல்லாத் துன்பங்களையும் நினைவிற்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அவன் யெகோவாவுக்குச் சத்தியத்தை ஆணையிட்டு,","poem":1},{"text":"யாக்கோபின் வல்லவருக்கு இப்படி ஒரு நேர்த்திக்கடன் செய்தான்:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“நான் என் வீட்டிற்குள் நுழையமாட்டேன்,","poem":1},{"text":"என் படுக்கைக்குப் போகவுமாட்டேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் கண்களுக்கு நித்திரையையும்,","poem":1},{"text":"கண்ணிமைகளுக்கு தூக்கத்தையும் வரவிடமாட்டேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவாவுக்காக ஒரு இடத்தை,","poem":1},{"text":"யாக்கோபின் வல்லவராகிய இறைவனுக்காக ஒரு வாழ்விடத்தைக் கட்டும்வரை","poem":2},{"lineBreak":true},{"text":"இவற்றைச் செய்யமாட்டேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"எப்பிராத்தாவிலே நாம் அதைக் கேள்விப்பட்டு,","poem":1},{"text":"யாரீமின் வயல்வெளிகளில் நாம் அதைக் கண்டோம்:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“நாம் அவருடைய வாழ்விடத்திற்குப் போவோம்,","poem":1},{"text":"அவருடைய பாதபடியில் வழிபடுவோம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"‘யெகோவாவே, எழுந்து உமது வாழ்விடத்திற்கு வாரும்,","poem":1},{"text":"உமது வல்லமை விளங்கும் பெட்டியுடன் வாரும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"உம்முடைய ஆசாரியர்கள் நீதியை உடுத்திக்கொள்ளட்டும்;","poem":1},{"text":"உமது பரிசுத்தவான்கள் மகிழ்ச்சியுடன் பாடட்டும்.’ ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"உமது அடியவனாகிய தாவீதின் நிமித்தம்,","poem":1},{"text":"நீர் அபிஷேகித்தவரை புறக்கணியாதேயும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"யெகோவா தாவீதுக்கு ஒரு சத்தியத்தை ஆணையிட்டார்;","poem":1},{"text":"அது நிச்சயமான வாக்கு; அவர் இதை நிறைவேற்றாமல் விடமாட்டார்:","poem":2},{"text":"“உன்னுடைய சொந்த சந்ததியில் ஒருவனை","poem":1},{"text":"நான் உன் சிங்காசனத்தில் அமர்த்துவேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உன் மகன்கள் என் உடன்படிக்கையையும்,","poem":1},{"text":"நான் அவர்களுக்குப் போதிக்கிற நியமங்களையும் கைக்கொள்வார்களானால்,","poem":2},{"text":"அவர்களுடைய மகன்களும்","poem":1},{"text":"என்றென்றும் உன் சிங்காசனத்தில் அமருவார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"யெகோவா சீயோனைத் தெரிந்துகொண்டார்;","poem":1},{"text":"அவர் அதையே தமது இருப்பிடமாக்க விரும்பியிருக்கிறார்:","poem":2}]},{"type":"verse","number":14,"content":[{"text":"“இது என்றென்றைக்கும் நான் தங்குமிடம்;","poem":1},{"text":"இவ்விடத்தை நான் விரும்பியிருக்கிறபடியால்,","poem":2},{"lineBreak":true},{"text":"இங்கேயே நான் சிங்காசனத்தில் அமர்ந்திருப்பேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் சீயோனை ஏராளமான உணவுப் பொருட்களால் ஆசீர்வதிப்பேன்;","poem":1},{"text":"அங்குள்ள ஏழைகளை உணவினால் திருப்தியாக்குவேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அங்குள்ள ஆசாரியருக்கு நான் இரட்சிப்பை உடுத்துவேன்;","poem":1},{"text":"அங்குள்ள பரிசுத்தவான்கள் எப்பொழுதும் மகிழ்ச்சியுடன் பாடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"“இங்கே தாவீதுக்காக, ஒரு வல்லமையுள்ள அரசனை வளரப்பண்ணுவேன்;","poem":1},{"text":"நான் அபிஷேகம் செய்தவனுக்காக, ஒரு விளக்கையும் ஏற்படுத்துவேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவனுடைய பகைவரை வெட்கத்தால் உடுத்துவேன்;","poem":1},{"text":"ஆனால் அவனுடைய தலையின் கிரீடமோ பிரகாசிக்கும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/132.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/133.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/131.json","previousChapterAudioLinks":{},"numberOfVerses":18}