{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":135,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவைத் துதியுங்கள்.","poem":1},{"noteId":18},{"lineBreak":true},{"text":"யெகோவாவினுடைய பெயரைத் துதியுங்கள்;","poem":1},{"text":"யெகோவாவின் பணியாட்களே, நீங்கள் அவரைத் துதியுங்கள்,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நமது இறைவனுடைய ஆலய முற்றங்களிலும்,","poem":1},{"text":"யெகோவாவினுடைய ஆலயத்திலும் ஊழியம் செய்கிறவர்களே, நீங்கள் அவரைத் துதியுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவைத் துதியுங்கள், யெகோவா நல்லவர்;","poem":1},{"text":"அவருடைய பெயருக்குத் துதி பாடுங்கள், அது இனிமையானது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஏனெனில் யெகோவா யாக்கோபைத் தமக்குச் சொந்தமாயிருக்கும்படி தெரிந்துகொண்டார்;","poem":1},{"text":"இஸ்ரயேலரைத் தமது அருமைச் சொத்தாய் இருக்கும்படி தெரிந்துகொண்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவா பெரியவர் என்றும்,","poem":1},{"text":"நமது யெகோவா எல்லாத் தெய்வங்களைப் பார்க்கிலும்,","poem":2},{"lineBreak":true},{"text":"மேலானவர் என்பதையும் நான் அறிவேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வானத்திலும் பூமியிலும்,","poem":1},{"text":"கடல்களிலும், அவைகளின் எல்லா ஆழங்களிலும்","poem":2},{"lineBreak":true},{"text":"யெகோவா தமக்கு விருப்பமான எதையும் செய்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் பூமியின் கடைசியிலிருந்து மேகங்களை எழும்பச் செய்கிறார்;","poem":1},{"text":"மழையுடன் மின்னலையும் அவர் அனுப்புகிறார்,","poem":2},{"lineBreak":true},{"text":"காற்றை தமது சேமிப்புக்கிடங்கிலிருந்து வெளியே புறப்படச்செய்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அவர் எகிப்தின் முதற்பேறுகளை அழித்தார்,","poem":1},{"text":"மனிதரின் முதற்பேறுகளையும் மிருகங்களின் தலையீற்றுகளையும் அழித்தார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எகிப்தே, பார்வோனுக்கும் அவனுடைய எல்லா பணியாட்களுக்கும் விரோதமாக","poem":1},{"text":"அவர் தம்முடைய அடையாளங்களையும் அதிசயங்களையும் உன் மத்தியில் அனுப்பினாரே.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் அநேக நாடுகளைத் தாக்கினார்,","poem":1},{"text":"வலிமைமிக்க அரசர்களைக் கொன்றார்;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எமோரியரின் அரசன் சீகோனையும்,","poem":1},{"text":"பாசானின் அரசன் ஓகையும்,","poem":2},{"lineBreak":true},{"text":"கானானின் அரசர்கள் எல்லோரையும் அழித்தார்,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் அவர்களுடைய நாட்டை உரிமைச்சொத்தாக,","poem":1},{"text":"தமது மக்களாகிய இஸ்ரயேலருக்கு உரிமைச்சொத்தாகக் கொடுத்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"யெகோவாவே, உமது பெயர் என்றென்றைக்கும் நிலைக்கிறது;","poem":1},{"text":"யெகோவாவே, உமது புகழ் தலைமுறை தலைமுறையாக நிலைக்கும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவா தம் மக்களின் நியாயத்தை விசாரித்து,","poem":1},{"text":"தம் அடியார்கள்மேல் இரக்கங்காட்டுவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"பிறநாடுகளின் விக்கிரகங்கள் வெள்ளியும் தங்கமும்,","poem":1},{"text":"மனிதருடைய கைகளினால் செய்யப்பட்டதுமாய் இருக்கிறது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவைகளுக்கு வாயிருந்தும் பேசாது;","poem":1},{"text":"அவைகளுக்குக் கண்களிருந்தும் காணாது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவைகளுக்குக் காதுகளிருந்தும் கேளாது,","poem":1},{"text":"அவைகளுடைய வாயிலே சுவாசமுமில்லை.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவைகளைச் செய்கிறவர்களும்,","poem":1},{"text":"அவைகளை நம்புகிற எல்லோரும் அவைகளைப்போலவே இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"இஸ்ரயேல் குடும்பத்தாரே, யெகோவாவைத் துதியுங்கள்;","poem":1},{"text":"ஆரோன் குடும்பத்தாரே, யெகோவாவைத் துதியுங்கள்;","poem":2}]},{"type":"verse","number":20,"content":[{"text":"லேவி குடும்பத்தாரே, யெகோவாவைத் துதியுங்கள்;","poem":1},{"text":"அவருக்குப் பயந்து நடக்கிறவர்களே, யெகோவாவைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"எருசலேமில் குடிகொண்டிருக்கும் யெகோவாவுக்கு,","poem":1},{"text":"சீயோனிலிருந்து துதி உண்டாகட்டும்.","poem":2},{"lineBreak":true},{"text":"யெகோவாவைத் துதியுங்கள்.","poem":1}]}],"footnotes":[{"noteId":18,"caller":"+","text":"எபிரெயத்தில் அல்லேலூயா வச 3மற்றும் 21","reference":{"chapter":135,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/PSA/135.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/136.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/134.json","previousChapterAudioLinks":{},"numberOfVerses":21}