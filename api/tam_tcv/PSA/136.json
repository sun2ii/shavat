{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":136,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்கு நன்றி செலுத்துங்கள், அவர் நல்லவர்,","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":2,"content":[{"text":"தெய்வங்களின் இறைவனுக்கு நன்றி செலுத்துங்கள்,","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":3,"content":[{"text":"கர்த்தாதி யெகோவாவுக்கு நன்றி செலுத்துங்கள்,","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அவர் மட்டுமே பெரிய அதிசயங்களைச் செய்கிறவர்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":5,"content":[{"text":"அவர் தமது அறிவாற்றலினால் வானங்களைப் படைத்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":6,"content":[{"text":"அவர் நீர்நிலைகளுக்கு மேலாகப் பூமியைப் பரப்பினார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":7,"content":[{"text":"அவர் பெரிய வெளிச்சங்களை உண்டாக்கினார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":8,"content":[{"text":"அவர் பகலை ஆளச் சூரியனைப் படைத்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":9,"content":[{"text":"இரவை ஆளச் சந்திரனையும் நட்சத்திரங்களையும் படைத்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அவர் எகிப்தியருடைய தலைப்பிள்ளைகளை வீழ்த்தினார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் மத்தியிலிருந்து இஸ்ரயேலரை வெளியே கொண்டுவந்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":12,"content":[{"text":"அவர் வல்லமையுள்ள கரத்தினாலும் நீட்டிய புயத்தினாலும் அதைச் செய்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"செங்கடலை இரண்டாகப் பிரித்தவருக்கு நன்றி செலுத்துங்கள்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":14,"content":[{"text":"அவர் அதின் நடுவில் இஸ்ரயேலரைக் கொண்டுவந்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":15,"content":[{"text":"ஆனால் பார்வோனையும் அவனுடைய படையையும் செங்கடலில் புரட்டித்தள்ளினார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"தம்முடைய மக்களை பாலைவனத்தில் வழிநடத்தினவருக்கு நன்றி செலுத்துங்கள்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"அவர் பெரிய அரசர்களை வீழ்த்தியவருக்கு நன்றி செலுத்துங்கள்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":18,"content":[{"text":"அவர் வலிமைமிக்க அரசர்களை வீழ்த்தினார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":19,"content":[{"text":"அவர் எமோரியரின் அரசனாகிய சீகோனை வீழ்த்தினார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":20,"content":[{"text":"அவர் பாசானின் அரசனாகிய ஓகை வீழ்த்தினார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":21,"content":[{"text":"அவர் அவர்களுடைய நாட்டை உரிமைச்சொத்தாகக் கொடுத்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":22,"content":[{"text":"தமது அடியவனாகிய இஸ்ரயேலுக்கு அதை உரிமைச்சொத்தாகக் கொடுத்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"அவர் நம்முடைய தாழ்ந்த நிலையில் நம்மை நினைத்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":24,"content":[{"text":"நம்முடைய பகைவரிடமிருந்து நம்மை விடுவித்தார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"verse","number":25,"content":[{"text":"அவர் ஒவ்வொரு உயிரினத்திற்கும் உணவு கொடுக்கிறார்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"பரலோகத்தின் இறைவனுக்கு நன்றி செலுத்துங்கள்;","poem":1},"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/136.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/137.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/135.json","previousChapterAudioLinks":{},"numberOfVerses":26}