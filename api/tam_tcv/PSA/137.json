{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":137,"content":[{"type":"verse","number":1,"content":[{"text":"பாபிலோனின் ஆறுகள் அருகே நாங்கள் உட்கார்ந்து,","poem":1},{"text":"சீயோனை நினைத்தபோது அழுதோம்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அங்கே இருந்த ஆற்றலறிச் செடிகளின்மேல்","poem":1},{"text":"எங்கள் கின்னரங்களைத் தொங்கவிட்டோம்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஏனெனில் எங்களைச் சிறைப்பிடித்தவர்கள்,","poem":1},{"text":"அங்கே எங்களைப் பாடும்படி கேட்டார்கள்;","poem":2},{"text":"எங்களைச் சித்திரவதை செய்தவர்கள் மகிழ்ச்சிப் பாடல்களைப் பாடும்படி வற்புறுத்தி,","poem":1},{"text":"“சீயோனின் பாடல்களுள் ஒன்றை எங்களுக்காகப் பாடுங்கள்” என்று சொன்னார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"வேறுநாட்டு மண்ணில் இருக்கையில்","poem":1},{"text":"யெகோவாவின் பாடல்களை எங்களால் எப்படிப் பாடமுடியும்?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"எருசலேமே! நான் உன்னை மறந்தால்,","poem":1},{"text":"என் வலதுகை அதின் திறமையை மறப்பதாக.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் உன்னை நினையாவிட்டால்,","poem":1},{"text":"எருசலேமை எனது மேலான மகிழ்ச்சியாகக்","poem":2},{"text":"நான் கருதாவிட்டால்,","poem":1},{"text":"என் நாவு என் மேல்வாயோடு ஒட்டிக்கொள்வதாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே! எருசலேம் கைப்பற்றபட்ட நாளிலே","poem":1},{"text":"ஏதோமியர் செய்தவற்றை நினைவுகூரும்;","poem":2},{"text":"“அதை இடித்துப்போடுங்கள்,","poem":1},{"text":"அதின் அஸ்திபாரங்கள்வரை அதை இடித்துப்போடுங்கள்!” என்று சொன்னார்களே.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பாபிலோன் மகளே, அழிவுக்கு ஒப்படைக்கப்பட்டவளே,","poem":1},{"text":"நீ எங்களுக்குச் செய்தவற்றுக்காக","poem":2},{"lineBreak":true},{"text":"உனக்குப் பதில் செய்கிறவர்கள் ஆசீர்வதிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"உன் குழந்தைகளைப் பிடித்து,","poem":1},{"text":"அவர்களைப் பாறைகளின்மேல் மோதியடிக்கிறவர்கள் ஆசீர்வதிக்கப்படுவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}