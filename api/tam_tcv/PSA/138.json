{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":138,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நான் என் முழு இருதயத்தோடும் உம்மைத் துதிப்பேன்;","poem":1},{"text":"“தெய்வங்கள்” முன்னிலையில் நான் உமக்குத் துதி பாடுவேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் உமது பரிசுத்த ஆலயத்தை நோக்கிப் பணிந்து,","poem":1},{"text":"உமது உடன்படிக்கையின் அன்புக்காகவும் உம்முடைய சத்தியத்திற்காகவும்,","poem":2},{"lineBreak":true},{"text":"உமது பெயரைத் துதிப்பேன்;","poem":2},{"text":"ஏனெனில் எல்லாக் காரியங்களுக்கும் மேலாக","poem":1},{"text":"உமது பெயரையும், உமது வார்த்தையையும் உயர்த்தியிருக்கிறீர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் கூப்பிட்டபோது நீர் எனக்குப் பதில் கொடுத்தீர்;","poem":1},{"text":"நீர் என் ஆத்துமாவிலே பெலன் தந்து என்னை மிகவும் தைரியப்படுத்தினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே, பூமியின் அரசர்கள் எல்லோரும்","poem":1},{"text":"உமது வாயின் வார்த்தைகளைக் கேட்கும்போது உம்மைத் துதிக்கட்டும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவாவின் மகிமை பெரிதாக இருப்பதினால்,","poem":1},{"text":"அவர்கள் யெகோவாவின் வழிகளைப் பாடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"யெகோவா உயர்ந்தவராக இருந்தும்,","poem":1},{"text":"தாழ்மையுள்ளவர்களை அக்கறையுடன் நோக்கிப் பார்க்கிறார்;","poem":2},{"lineBreak":true},{"text":"ஆனால் பெருமையுள்ளவர்களையோ அவர் தூரத்திலிருந்தே அறிகிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"துன்பத்தின் மத்தியிலே நான் நடக்கின்றபோதிலும்,","poem":1},{"text":"நீர் என் உயிரைப் பாதுகாக்கிறீர்.","poem":2},{"text":"என் பகைவரின் கோபத்திற்கு எதிராக நீர் உமது கையை நீட்டுகிறீர்;","poem":1},{"text":"உமது வலதுகரத்தினால் என்னைக் காப்பாற்றுகிறீர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவா என்னைக் குறித்த தமது நோக்கத்தை நிறைவேற்றுவார்;","poem":1},{"text":"யெகோவாவே, உமது உடன்படிக்கையின் அன்பு என்றென்றும் நிலைத்திருக்கிறது;","poem":2},{"lineBreak":true},{"text":"உமது கரத்தின் செயல்களைக் கைவிடாதேயும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}