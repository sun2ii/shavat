{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":139,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நீர் என்னை ஆராய்ந்திருக்கிறீர்,","poem":1},{"text":"நீர் என்னை அறிந்துமிருக்கிறீர்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் உட்காரும்போதும் நான் எழும்பும்போதும் நீர் அறிகிறீர்;","poem":1},{"text":"நீர் என் எண்ணங்களைத் தூரத்திலிருந்தே அறிகிறீர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் வெளியே போவதையும் நான் படுப்பதையும் நீர் கவனித்துக்கொள்கிறீர்;","poem":1},{"text":"என்னுடைய செயல்கள் எல்லாவற்றையும் நீர் நன்கு அறிவீர்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் நாவில் ஒரு வார்த்தை பிறக்குமுன்பே,","poem":1},{"text":"யெகோவாவே, நீர் அதை முற்றிலும் அறிந்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீர் முன்னும் பின்னுமாய் என்னைச் சூழ்ந்து,","poem":1},{"text":"நீர் உமது ஆசீர்வாதத்தின் கரத்தை என்மேல் வைத்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இந்த அறிவு எனக்கு மிகுந்த ஆச்சரியமும்,","poem":1},{"text":"விளங்கிக்கொள்ள முடியாததுமாயிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"உமது ஆவியானவரைவிட்டு என்னால் எங்கே போகமுடியும்?","poem":1},{"text":"உமது சந்நிதியைவிட்டு என்னால் எங்கு ஓடமுடியும்?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் வானங்கள்வரை மேலே போனாலும், நீர் அங்கே இருக்கிறீர்;","poem":1},{"text":"என் படுக்கையை பாதாளத்தில் போட்டாலும், நீர் அங்கேயும் இருக்கிறீர்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அதிகாலையின் சிறகுகளை எடுத்து நான் பறந்து சென்றாலும்,","poem":1},{"text":"கடல்களின் எல்லைகளுக்கப்பால் போய்த் தங்கினாலும்,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அங்கேயும் உமது கரம் எனக்கு வழிகாட்டும்;","poem":1},{"text":"உமது வலதுகரம் என்னை இறுக்கிப் பிடித்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"“நிச்சயமாகவே இருள் என்னை மறைத்துக்கொள்ளும்,","poem":1},{"text":"ஒளி என்னைச் சுற்றிலும் இரவாகும்” என்று நான் சொன்னாலும்,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இருளும் உமக்கு இருட்டாய் இருக்காது;","poem":1},{"text":"இரவும் பகலைப்போல் பிரகாசிக்கும்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் இருள் உமக்கு ஒளியைப் போலவே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"என் உள்ளுறுப்புகளை நீரே உருவாக்கினீர்;","poem":1},{"text":"என் தாயின் கருப்பையில் என்னை நீரே ஒன்றாய் இணைத்தீர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் மிக ஆச்சரியமாகவும் அதிசயிக்கத்தக்க வகையிலும் படைக்கப்பட்டிருக்கிறபடியால்,","poem":1},{"text":"நான் உம்மைத் துதிக்கிறேன்;","poem":2},{"text":"உமது செயல்கள் ஆச்சரியமானவை,","poem":1},{"text":"நான் அதை நன்றாய் அறிந்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் இரகசியமான இடத்தில் படைக்கப்பட்டபொழுது,","poem":1},{"text":"நான் பூமியின் ஆழங்களில் ஒன்றாய் இணைக்கப்பட்ட போது,","poem":2},{"lineBreak":true},{"text":"என் எலும்புகள் உமக்கு மறைவாய் இருக்கவில்லை.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"உருவம் பெற்றிராத என் உடலை உம்முடைய கண்கள் கண்டன;","poem":1},{"text":"எனக்கு நியமிக்கப்பட்ட எல்லா நாட்களும்,","poem":2},{"lineBreak":true},{"text":"அவை ஒன்றாகிலும் வருமுன்பே உம்முடைய புத்தகத்தில் எழுதப்பட்டிருந்தன.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இறைவனே, என்னைப்பற்றிய உம்முடைய எண்ணங்கள் எவ்வளவு அருமையானவை!","poem":1},{"text":"அவைகளின் தொகை எவ்வளவு பெரியது!","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நான் அவைகளை எண்ணப்போனால்,","poem":1},{"text":"அவை மணலைப் பார்க்கிலும் அதிகமாயிருக்கும்;","poem":2},{"lineBreak":true},{"text":"நான் விழிக்கும்போதோ இன்னும் உம்முடனேயே இருக்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"இறைவனே, கொடியவர்களை நீர் கொன்றுபோட்டால் நலமாயிருக்கும்!","poem":1},{"text":"இரத்தவெறியரே, என்னைவிட்டு அகன்றுபோங்கள்!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்கள் உம்மைக் குறித்துத் தீயநோக்கத்துடன் பேசுகிறார்கள்;","poem":1},{"text":"உம்முடைய விரோதிகள் உமது பெயரைத் தவறாய் பயன்படுத்துகிறார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"யெகோவாவே, உம்மை வெறுக்கிறவர்களை நான் வெறுக்காதிருக்கிறேனோ?","poem":1},{"text":"உமக்கு விரோதமாய் எழும்புகிறவர்களை அருவருக்காமல் இருக்கிறேனோ?","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஆம், நான் அவர்களை முற்றிலும் வெறுக்கிறேன்.","poem":1},{"text":"அவர்களை என் பகைவர்களாகவே நான் எண்ணுகிறேன்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"இறைவனே, என்னை ஆராய்ந்து என் இருதயத்தை அறிந்துகொள்ளும்;","poem":1},{"text":"என்னை சோதித்து என் வருத்தமான சிந்தனைகளை அறிந்துகொள்ளும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"உம்மை வருந்தும்படிச் செய்யும் வழி ஏதாவது என்னில் உண்டோ என்று பார்த்து,","poem":1},{"text":"நித்திய வழியிலே என்னை நடத்தும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/139.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/140.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/138.json","previousChapterAudioLinks":{},"numberOfVerses":24}