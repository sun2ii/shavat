{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":140,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, தீய மனிதரிடமிருந்து என்னைத் தப்புவியும்;","poem":1},{"text":"வன்முறையாளர்களிடமிருந்து என்னைப் பாதுகாத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர்கள் தங்கள் இருதயங்களில் பொல்லாத திட்டங்களைத் தீட்டி,","poem":1},{"text":"நாள்தோறும் போரை மூட்டிவிடுகிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் தங்கள் நாவுகளைப் பாம்பின் நாவுகளைப் போலக் கூர்மையாக்குகிறார்கள்;","poem":1},{"text":"அவர்கள் உதடுகளில் விரியன் பாம்பின் விஷம் இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே, கொடியவர்களுடைய கைகளுக்கு என்னை நீங்கலாக்கி,","poem":1},{"text":"வன்முறையாளர்களுக்கு என்னை விலக்கி இரட்சியும்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் என் நடைகளைக் கவிழ்க்கப்பார்க்கிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பெருமையுள்ள மனிதர்கள் எனக்குக் கண்ணியை மறைத்து வைத்திருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் தங்கள் வலைகளின் கயிறுகளை விரித்து,","poem":2},{"lineBreak":true},{"text":"என் வழியெல்லாம் எனக்காகக் பொறிகளை வைத்திருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"யெகோவாவே, “நீரே என் இறைவன்” என்று நான் உம்மிடம் சொல்கிறேன்;","poem":1},{"text":"யெகோவாவே, இரக்கத்திற்கான என் கதறுதலைக் கேளும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆண்டவராகிய யெகோவாவே, என் இரட்சிப்பின் பெலனே,","poem":1},{"text":"நீர் யுத்தநாளில் என் தலையை மறைத்துகொள்ளும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவாவே, கொடியவர்களின் ஆசைகள் நிறைவேற விடாதேயும்;","poem":1},{"text":"அவர்களுடைய திட்டங்களை வெற்றியடைய விடாதேயும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"என்னைச் சூழ்ந்துள்ளவர்கள் பெருமையுடன் தங்கள் தலையை உயர்த்துகிறார்கள்;","poem":1},{"text":"அவர்கள் உதடுகளின் தீவினைகள் அவர்களை மூடும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எரியும் நெருப்புத் தழல்கள் அவர்கள்மேல் விழட்டும்;","poem":1},{"text":"அவர்கள் ஒருபோதும் எழுந்திருக்க முடியாதபடி நெருப்பிலும்,","poem":2},{"lineBreak":true},{"text":"சேற்றுக் குழிகளிலும் தள்ளப்படட்டும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவதூறு பேசுகிறவர்கள் நாட்டில் நிலைபெறாதிருக்கட்டும்;","poem":1},{"text":"வன்முறையாளர்களை பேராபத்து வேட்டையாடி வீழ்த்தட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவா ஏழைகளுக்கு நீதியைப் பெற்றுக்கொடுக்கிறவர் என்பதையும்,","poem":1},{"text":"எளியவர்களின் சார்பாக வழக்காடுபவர் என்பதையும் நான் அறிவேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நிச்சயமாகவே, நீதிமான்கள் உமது பெயரைத் துதிப்பார்கள்;","poem":1},{"text":"நேர்மையுள்ளவர்கள் உமது சமுகத்தில் வாழ்வடைவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/140.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/141.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/139.json","previousChapterAudioLinks":{},"numberOfVerses":13}