{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":141,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உம்மை நோக்கிக் கூப்பிடுகிறேன், என்னிடம் விரைந்து வாரும்;","poem":1},{"text":"நான் உம்மை நோக்கிக் கூப்பிடும்போது, என் குரலைக் கேளும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் மன்றாட்டு உமக்கு முன்பாகத் தூபத்தைப்போல் ஏற்றுக்கொள்ளப்படட்டும்;","poem":1},{"text":"என் கையுயர்த்துதல் மாலைநேரப் பலியாகவும் இருக்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே, என் வாய்க்குக் காவல் வையும்;","poem":1},{"text":"என் உதடுகளின் வாசலைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"தீமைகளைச் செய்யும் மனிதரோடு சேர்ந்து","poem":1},{"text":"கொடுமையான செயல்களில் பங்குகொள்ளும்படி","poem":2},{"text":"என் இருதயத்தைத் தீமையின் பக்கம் இழுப்புண்டுபோக விடாதேயும்;","poem":1},{"text":"அவர்களுடைய ருசியான பண்டங்களை நான் சாப்பிடவும் விடாதேயும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நீதிமான் என்னை அடிக்கட்டும், அந்த அடி தயவானது;","poem":1},{"text":"நீதிமான் என்னைக் கண்டிக்கட்டும், அது என் தலைக்கு எண்ணெயைப்போல் இருக்கும்.","poem":2},{"text":"என் தலை அதை புறக்கணிக்காது;","poem":1},{"text":"என் மன்றாட்டு எப்பொழுதும் தீயோரின் செய்கைகளுக்கு விரோதமாகவே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவர்களுடைய ஆளுநர்கள் செங்குத்தான பாறைகளிலிருந்து","poem":1},{"text":"கீழே தள்ளிவிடப்படுவார்கள்;","poem":2},{"text":"அப்பொழுது, என் வார்த்தைகள் உண்மையாக இருந்ததை","poem":1},{"text":"கொடியவர்கள் புரிந்துகொள்வார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“ஒரு நபர் நிலத்தை உழுது கிளறுவதுபோல்,","poem":1},{"text":"எங்கள் எலும்புகள் பாதாளத்தின் வாசலில் சிதறடிக்கப்பட்டன”","poem":2},{"lineBreak":true},{"text":"என்று அவர்கள் சொல்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஆனால், ஆண்டவராகிய யெகோவாவே, என் கண்கள் உம்மையே நோக்குகின்றன;","poem":1},{"text":"நான் உம்மிடத்தில் தஞ்சம் அடைகிறேன், என்னை மரணத்திற்கு ஒப்புக்கொடாதேயும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"தீயவர் எனக்கு வைத்த கண்ணிகளிலிருந்தும்,","poem":1},{"text":"அவர்களால் வைக்கப்பட்ட சுருக்குக் கயிறுகளிலிருந்தும் என்னைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் அவற்றைப் பாதுகாப்பாய் கடக்க,","poem":1},{"text":"கொடியவர்கள் தங்கள் வலைகளிலேயே அகப்படட்டும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}