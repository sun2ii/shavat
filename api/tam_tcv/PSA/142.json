{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":142,"content":[{"type":"hebrew_subtitle","content":["தாவீது குகையிலிருந்தபோது செய்த ஜெபமாகிய மஸ்கீல் என்னும் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நான் யெகோவாவை நோக்கிச் சத்தமிட்டுக் கூப்பிடுகிறேன்;","poem":1},{"text":"நான் யெகோவாவிடம் இரக்கம் கேட்டு என் குரலை உயர்த்துகிறேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவருக்கு முன்பாக என் குறைகளைக் கொட்டுகிறேன்;","poem":1},{"text":"என் துன்பத்தையும் அவருக்கு முன்பாக சொல்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"என் ஆவி எனக்குள் சோர்ந்து போகையில்,","poem":1},{"text":"நீரே என் வழியை அறிகிறவர்;","poem":2},{"text":"நான் நடக்கும் பாதையில்","poem":1},{"text":"மனிதர்கள் எனக்குக் கண்ணியை மறைத்து வைத்திருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நோக்கிப்பாரும், உதவிக்காக என் வலதுபக்கத்தில் யாரும் இல்லை;","poem":1},{"text":"என்னில் அக்கறை கொள்பவர்கள் யாருமில்லை.","poem":2},{"text":"எனக்குப் புகலிடம் இல்லை;","poem":1},{"text":"என்னைக் கவனிக்க எவருமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, நான் உம்மை நோக்கிக் கதறுகிறேன்;","poem":1},{"text":"“நீரே என் புகலிடம்,","poem":2},{"lineBreak":true},{"text":"வாழ்வோரின் நாட்டில் நீரே என் பங்கு” என்று நான் சொல்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"என் கதறலுக்குச் செவிகொடும்;","poem":1},{"text":"நான் மிகவும் தாழ்த்தப்பட்டேன்;","poem":2},{"text":"என்னைப் பிடிக்க பின்தொடர்கிறவர்களிடமிருந்து என்னை விடுவியும்;","poem":1},{"text":"ஏனெனில் அவர்கள் என்னைவிட பலமுள்ளவர்களாய் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் உமது பெயரைத் துதிக்கும்படி,","poem":1},{"text":"என் சிறையிலிருந்து என்னை விடுதலையாக்கும்;","poem":2},{"text":"அப்பொழுது நீர் எனக்குச் செய்யும் நன்மையினிமித்தம்,","poem":1},{"text":"நீதிமான்கள் என்னைச் சுற்றிச் சேர்ந்துகொள்வார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":7}