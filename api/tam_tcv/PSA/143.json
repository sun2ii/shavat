{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":143,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என் மன்றாட்டைக் கேளும்,","poem":1},{"text":"இரக்கத்திற்கான என் கதறுதலுக்குச் செவிகொடும்;","poem":2},{"text":"உமது உண்மையின்படியும்","poem":1},{"text":"நீதியின்படியும் எனக்கு பதில் தாரும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உமது அடியானை நியாயந்தீர்க்காதேயும்.","poem":1},{"text":"வாழ்கின்ற ஒருவருமே உமக்கு முன்பாக நீதிமான்கள் இல்லையே.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பகைவன் என்னைப் பின்தொடர்கிறான்,","poem":1},{"text":"அவன் என்னை தரையில் போட்டு தாக்குகிறான்;","poem":2},{"text":"வெகுகாலத்திற்கு முன்பு இறந்தவர்களைப்போல்,","poem":1},{"text":"அவன் என்னை இருளில் குடியிருக்கப்பண்ணுகிறான்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆகவே எல்லா நம்பிக்கையையும் இழந்து என் ஆவி எனக்குள் சோர்ந்துபோகிறது;","poem":1},{"text":"பயத்தால் என் இருதயம் கலங்குகிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நான் முந்தின நாட்களை நினைக்கிறேன்;","poem":1},{"text":"உமது செயல்களையெல்லாம் தியானிக்கிறேன்;","poem":2},{"lineBreak":true},{"text":"உமது கரத்தின் செயல்களை யோசிக்கிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் உம்மை நோக்கி என் கைகளை விரிக்கிறேன்;","poem":1},{"text":"வறண்ட நிலத்தைப்போல் என் ஆத்துமா உம்மேல் தாகம் கொண்டிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே, சீக்கிரமாய் எனக்குப் பதில் தாரும்;","poem":1},{"text":"என் உள்ளம் சோர்ந்துபோகிறது;","poem":2},{"text":"உமது முகத்தை என்னிடமிருந்து மறையாதேயும்; இல்லாவிட்டால்,","poem":1},{"text":"நான் மரணக் குழியில் இறங்குகிறவர்களைப் போலாகிவிடுவேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"காலை வேளையானது உமது உடன்படிக்கையின் அன்பின் செய்தியைக் கொண்டுவரட்டும்,","poem":1},{"text":"ஏனெனில் நான் என் நம்பிக்கையை உம்மிலேயே வைத்திருக்கிறேன்;","poem":2},{"text":"நான் போகவேண்டிய வழியை எனக்குக் காண்பியும்,","poem":1},{"text":"ஏனெனில் என் உயிரை உம்மிடத்தில் ஒப்படைக்கிறேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, என் பகைவரிடமிருந்து என்னைத் தப்புவியும்;","poem":1},{"text":"ஏனெனில் நான் உமக்குள் என்னை மறைத்துக்கொள்கிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீரே என் இறைவன்;","poem":1},{"text":"ஆதலால் உமது சித்தத்தைச் செய்ய எனக்குப் போதியும்;","poem":2},{"text":"உமது நல்ல ஆவியானவர்","poem":1},{"text":"என்னை நல்வழியில் நடத்துவாராக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"யெகோவாவே, உமது பெயரின் மகிமைக்காக என் வாழ்வைக் காத்துக்கொள்ளும்;","poem":1},{"text":"உமது நியாயத்தினிமித்தம் வேதனையிலிருந்து என்னை விடுவியும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உமது உடன்படிக்கையின் அன்பினிமித்தம் என் பகைவரை அழித்துவிடும்;","poem":1},{"text":"என் எதிரிகள் அனைவரையும் ஒழித்துவிடும்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் நான் உமது அடியவன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}