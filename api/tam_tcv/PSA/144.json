{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":144,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என் கன்மலையாகிய யெகோவாவுக்குத் துதி உண்டாவதாக,","poem":1},{"text":"அவர் என் கைகளை யுத்தத்திற்கும்,","poem":2},{"lineBreak":true},{"text":"என் விரல்களை போர்புரிவதற்கும் பயிற்றுவிக்கிறார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர் என் அன்பான இறைவன், என் கோட்டை,","poem":1},{"text":"என் அரண், என் மீட்பர்,","poem":2},{"text":"அவரே நான் தஞ்சம் அடைகிற என் கேடயம்,","poem":1},{"text":"நாடுகளை","poem":2},{"noteId":19},{"text":"அவர் எனக்குக் கீழ்படுத்துகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே, மனிதனைக் குறித்து நீர் அக்கறை கொள்வதற்கும்,","poem":1},{"text":"வெறும் மனிதர்களை நீர் நினைப்பதற்கும் அவர்கள் யார்?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மனிதன் ஒரு சுவாசத்தைப்போல் இருக்கிறான்;","poem":1},{"text":"அவன் நாட்கள் துரிதமாய் மறையும் நிழலைப்போல் இருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, உமது வானங்களைப் பிரித்துக் கீழே வாரும்;","poem":1},{"text":"மலைகள் புகையும்படியாக, அவைகளைத் தொடும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மின்னல்களை அனுப்பி, பகைவர்களைச் சிதறடியும்;","poem":1},{"text":"உமது அம்புகளை எய்து அவர்களை முறியடியும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உமது கரத்தை உயரத்திலிருந்து கீழே நீட்டும்;","poem":1},{"lineBreak":true},{"text":"பெருவெள்ளத்திலிருந்தும், பிறநாட்டினரின் கைகளிலிருந்தும்","poem":1},{"text":"என்னை விடுவித்துத் தப்புவியும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்களின் வாய்கள் பொய்களினால் நிறைந்திருக்கின்றன;","poem":1},{"text":"அவர்களுடைய வலதுகைகள் வஞ்சனை உடையவைகளாய் இருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"இறைவனே, நான் உமக்கு ஒரு புதுப்பாட்டைப் பாடுவேன்;","poem":1},{"text":"பத்து நரம்பு வீணையினால் நான் உமக்கு இசை மீட்டுவேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஏனெனில் அரசர்களுக்கு வெற்றியைக் கொடுப்பவரும்","poem":1},{"text":"உமது அடியவனாகிய தாவீதை விடுவிப்பவரும் நீரே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"கொடிய வாளினின்று என்னை விடுவித்தருளும்;","poem":1},{"text":"பொய்பேசும் வாய்களையும்,","poem":2},{"text":"வஞ்சனையுள்ள வலது கைகளையுமுடைய","poem":1},{"text":"வேறுநாட்டைச் சேர்ந்தவரின் கைகளிலிருந்து என்னை விடுவித்துத் தப்புவியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அப்பொழுது எங்கள் மகன்கள் தங்கள் வாலிபத்தில்","poem":1},{"text":"நன்றாய்ப் பராமரிக்கப்பட்ட செடிகளைப்போல் இருப்பார்கள்;","poem":2},{"text":"எங்கள் மகள்கள் அரண்மனையை அலங்கரிப்பதற்கென","poem":1},{"text":"செதுக்கப்பட்ட தூண்களைப்போல் இருப்பார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"எங்கள் களஞ்சியங்கள்","poem":1},{"text":"சகலவித விளைபொருட்களாலும் நிரப்பப்படும்;","poem":2},{"text":"எங்கள் நிலங்களில் எங்கள் ஆடுகள் ஆயிரக்கணக்கிலும்,","poem":1},{"text":"பதினாயிரக்கணக்கிலும் பெருகும்.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"எங்கள் எருதுகள் பாரமான பொதிகளை இழுக்கும்;","poem":2},{"text":"எங்கள் நகரத்தின் சுவர்களில் ஒன்றும் உடைக்கப்படுவதில்லை,","poem":1},{"text":"கைதிகளாக யாரும் சிறைபிடிக்கப்படுவதில்லை;","poem":2},{"lineBreak":true},{"text":"எங்கள் வீதிகளில் துன்பத்தின் அழுகையும் கேட்கப்படுவதில்லை.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"இவற்றை உண்மையாக அடைந்த மக்கள் ஆசீர்வதிக்கப்பட்டவர்கள்;","poem":1},{"text":"யெகோவாவைத் தங்கள் இறைவனாகக் கொண்ட மக்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]}],"footnotes":[{"noteId":19,"caller":"+","text":"நாடுகளை என பல கையெழுத்துப் பிரதிகளிலும், என் மக்கள் என எபிரெய மொழி பிரதிகளிலும் உள்ளது.","reference":{"chapter":144,"verse":2}}]},"thisChapterLink":"/api/tam_tcv/PSA/144.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/145.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/143.json","previousChapterAudioLinks":{},"numberOfVerses":15}