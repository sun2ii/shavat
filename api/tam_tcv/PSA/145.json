{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":145,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் ஸ்தோத்திர சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என் அரசராகிய இறைவனே, நான் உம்மைப் புகழ்ந்து உயர்த்துவேன்;","poem":1},{"text":"நான் என்றென்றும் உம்முடைய பெயரைத் துதிப்பேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நாள்தோறும் நான் உம்மைத் துதித்து,","poem":1},{"text":"உம்முடைய பெயரை என்றென்றைக்கும் பாராட்டுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவா பெரியவரும் மிகவும் துதிக்கப்படத்தக்கவருமாய் இருக்கிறார்;","poem":1},{"text":"அவருடைய மகத்துவத்தை யாராலும் அளவிடமுடியாது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உம்முடைய செயல்களை ஒரு தலைமுறை இன்னொரு தலைமுறைக்கு எடுத்துச் சொல்லும்;","poem":1},{"text":"அவர்கள் உம்முடைய வல்லமையான செயல்களைச் சொல்வார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நான் உம்முடைய மகத்துவத்தின் மாட்சிமையான சிறப்பையும்,","poem":1},{"text":"உமது அதிசயமான செயல்களையும் பற்றித் தியானிப்பேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் உமது பிரமிக்கத்தக்க செயல்களின் வல்லமையைச் சொல்வார்கள்;","poem":1},{"text":"நான் உம்முடைய மகத்துவமான கிரியைகளைப் பிரசித்தப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் உமது நற்குணத்தின் மகத்துவத்தை நினைத்துக் கொண்டாடுவார்கள்;","poem":1},{"text":"உமது நீதியைக் குறித்துச் சந்தோஷமாய்ப் பாடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவா கிருபையும் கருணையும் உள்ளவர்;","poem":1},{"text":"அவர் கோபிக்கிறதில் தாமதிப்பவரும்","poem":2},{"lineBreak":true},{"text":"உடன்படிக்கையின் அன்பு நிறைந்தவருமாய் இருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"யெகோவா எல்லோருக்கும் நல்லவர்;","poem":1},{"text":"தாம் படைத்த அனைத்தின்மேலும் இரக்கமுள்ளவர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"யெகோவாவே, நீர் படைத்த எல்லாம் உம்மைத் துதிக்கும்;","poem":1},{"text":"உமது உண்மையுள்ள மக்கள் உம்மைப் போற்றுவார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் உமது அரசின் மகிமையைச் சொல்லி,","poem":1},{"text":"உம்முடைய வல்லமையைக் குறித்துப் பேசுவார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அதினால் எல்லா மனிதரும் உம்முடைய வல்லமையான செயல்களையும்,","poem":1},{"text":"உமது அரசின் மகிமையான சிறப்பையும் அறிந்துகொள்வார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"உம்முடைய அரசு ஒரு நித்தியமான அரசு;","poem":1},{"text":"உம்முடைய ஆளுகை எல்லாத் தலைமுறைகளுக்கும் நிலைத்திருக்கிறது.","poem":2},{"lineBreak":true},{"text":"யெகோவா தம்முடைய எல்லா வாக்குத்தத்தங்களிலும் நம்பத்தக்கவர்;","poem":1},{"text":"தம்முடைய செயல்கள் அனைத்திலும் உண்மையுள்ளவர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவா விழுகிற யாவரையும் தாங்கி,","poem":1},{"text":"தாழ்த்தப்பட்ட அனைவரையும் உயர்த்துகிறார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"எல்லாருடைய கண்களும் உம்மை நோக்குகின்றன;","poem":1},{"text":"ஏற்றவேளையில் நீர் அவர்களுக்கு உணவு கொடுக்கிறீர்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீர் உம்முடைய கையைத் திறந்து,","poem":1},{"text":"எல்லா உயிரினங்களின் வாஞ்சைகளைத் திருப்தியாக்குகிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"யெகோவா தமது வழிகள் எல்லாவற்றிலும் நீதியுள்ளவராயும்","poem":1},{"text":"தம்முடைய செயல்களிளெல்லாம் உண்மையுள்ளவராயும் இருக்கிறார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"யெகோவா தம்மை நோக்கிக் கூப்பிடுகிற எல்லோருக்கும்,","poem":1},{"text":"உண்மையாகவே அவரை நோக்கிக் கூப்பிடுகிற யாவருக்கும் அருகே இருக்கிறார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர் தமக்குப் பயந்து நடக்கிறவர்களின் விருப்பங்களை நிறைவேற்றுகிறார்;","poem":1},{"text":"அவர்களுடைய கூப்பிடுதலைக் கேட்டு அவர்களைக் காப்பாற்றுகிறார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"யெகோவா தம்மில் அன்புகூருகிறவர்களைப் பாதுகாக்கிறார்;","poem":1},{"text":"ஆனால் கொடியவர்கள் அனைவரையும் தண்டிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"என் வாய் யெகோவாவைத் துதிக்கும்.","poem":1},{"text":"எல்லா உயிரினங்களும் அவருடைய பரிசுத்த பெயரை","poem":2},{"lineBreak":true},{"text":"என்றென்றும் துதிக்கட்டும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/145.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/146.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/144.json","previousChapterAudioLinks":{},"numberOfVerses":21}