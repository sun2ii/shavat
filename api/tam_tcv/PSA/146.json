{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":146,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவைத் துதி","poem":1},{"noteId":20},{"text":".","poem":1},{"lineBreak":true},{"text":"என் ஆத்துமாவே, யெகோவாவைத் துதி.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"நான் என் வாழ்நாளெல்லாம் யெகோவாவைத் துதிப்பேன்;","poem":1},{"text":"நான் உயிரோடிருக்கும்வரை என் இறைவனுக்குத் துதி பாடுவேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உன் நம்பிக்கையை இளவரசர்களிலும்,","poem":1},{"text":"உன்னை மீட்கமுடியாத மனுமக்களிலும் வைக்காதே.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்களுடைய ஆவி பிரியும்போது அவர்கள் மண்ணுக்கே திரும்பிப் போவார்கள்;","poem":1},{"text":"அந்த நாளிலேயே அவர்களுடைய திட்டங்கள் ஒன்றுமில்லாமல் போகும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யாக்கோபின் இறைவனைத் தங்கள் உதவியாகக் கொண்டிருப்போர்,","poem":1},{"text":"தங்களுடைய இறைவனாகிய யெகோவாவிடம்","poem":2},{"lineBreak":true},{"text":"நம்பிக்கையை வைத்திருப்போர் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவரே வானத்தையும் பூமியையும்","poem":1},{"text":"கடலையும் அவற்றிலுள்ள எல்லாவற்றையும் படைத்தவர்;","poem":2},{"lineBreak":true},{"text":"யெகோவாவாகிய அவர் என்றைக்கும் உண்மையுள்ளவராய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் ஒடுக்கப்பட்டவர்களுக்கு நியாயஞ்செய்கிறார்;","poem":1},{"text":"பசியுள்ளவர்களுக்கு உணவு கொடுக்கிறார்.","poem":2},{"text":"யெகோவா கைதிகளை விடுதலையாக்குகிறார்,","poem":1}]},{"type":"verse","number":8,"content":[{"text":"யெகோவா குருடருக்குப் பார்வை கொடுக்கிறார்,","poem":2},{"text":"யெகோவா தாழ்த்தப்பட்டவர்களை உயர்த்துகிறார்,","poem":1},{"text":"யெகோவா நீதிமான்களில் அன்பாயிருக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவா அயல்நாட்டவர்களைப் பாதுகாக்கிறார்,","poem":1},{"text":"அநாதைகளையும் விதவைகளையும் ஆதரிக்கிறார்,","poem":2},{"lineBreak":true},{"text":"ஆனால் கொடியவர்களின் வழிகளை அவர் முறியடிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவா என்றென்றும் ஆளுகை செய்கிறார்;","poem":1},{"text":"சீயோனே, உன் இறைவன் எல்லாத் தலைமுறைகளுக்கும் அரசாளுகிறார்.","poem":2},{"lineBreak":true},{"text":"யெகோவாவைத் துதி.","poem":1}]}],"footnotes":[{"noteId":20,"caller":"+","text":"எபிரெயத்தில் அல்லேலூயா வச 10","reference":{"chapter":146,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}