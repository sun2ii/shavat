{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":147,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவைத் துதியுங்கள்.","poem":1},{"lineBreak":true},{"text":"நமது இறைவனுக்குத் துதிகளைப் பாடுவது எவ்வளவு நல்லது,","poem":1},{"text":"அவரைத் துதிப்பது எவ்வளவு மகிழ்ச்சியும் தகுதியுமாயிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யெகோவா எருசலேமைக் கட்டியெழுப்புகிறார்;","poem":1},{"text":"அவர் நாடுகடத்தப்பட்ட இஸ்ரயேலரை ஒன்றுசேர்க்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர் உள்ளம் உடைந்தவர்களைச் சுகப்படுத்தி,","poem":1},{"text":"அவர்களுடைய காயங்களைக் கட்டுகிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் நட்சத்திரங்களின் தொகையை எண்ணி,","poem":1},{"text":"அவை ஒவ்வொன்றையும் பெயரிட்டு அழைக்கிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நம்முடைய யெகோவா பெரியவரும், வல்லமை மிகுந்தவருமாய் இருக்கிறார்;","poem":1},{"text":"அவருடைய அறிவுக்கு எல்லையே இல்லை.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவா தாழ்மையுள்ளவர்களை ஆதரிக்கிறார்;","poem":1},{"text":"ஆனால் கொடியவர்களையோ தரையில் வீழ்த்துகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவை நன்றியுடன் துதி பாடுங்கள்;","poem":1},{"text":"யாழினால் நம் இறைவனுக்கு இசை மீட்டுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அவர் ஆகாயத்தை மேகங்களினால் மூடுகிறார்;","poem":1},{"text":"பூமிக்கு மழையைக் கொடுத்து,","poem":2},{"lineBreak":true},{"text":"மலைகளில் புல்லை வளரப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மிருகங்களுக்கும் கூப்பிடுகிற காக்கைக் குஞ்சுகளுக்கும்","poem":1},{"text":"அவர் உணவு கொடுக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"குதிரையின் பலத்தில் அவர் பிரியம் கொள்வதில்லை,","poem":1},{"text":"படைவீரனின் கால் வலிமையில் அவர் மகிழ்ச்சி அடைவதுமில்லை;","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவா தமக்குப் பயந்து,","poem":1},{"text":"தங்கள் நம்பிக்கையை அவருடைய உடன்படிக்கையின் அன்பில்","poem":2},{"lineBreak":true},{"text":"வைத்திருக்கிறவர்களில் மகிழ்ச்சியாயிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"எருசலேமே யெகோவாவைப் பாராட்டு;","poem":1},{"text":"சீயோனே உன் இறைவனைத் துதி.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஏனெனில் அவர் உன் வாசல்களின் தாழ்ப்பாள்களைப் பலப்படுத்தி,","poem":1},{"text":"உன்னிடத்திலுள்ள உன் மக்களை ஆசீர்வதிக்கிறார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர் உன் எல்லைகளுக்குச் சமாதானத்தைக் கொடுத்து,","poem":1},{"text":"சிறந்த கோதுமையினால் உன்னைத் திருப்தியாக்குகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"அவர் பூமிக்குத் தமது கட்டளையை அனுப்புகிறார்;","poem":1},{"text":"அவருடைய வார்த்தை விரைந்து செல்கிறது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர் மூடுபனியை கம்பளியைப்போல் பரப்புகிறார்;","poem":1},{"text":"உறைபனித் துகள்களை சாம்பலைப்போல் தூவுகிறார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர் தமது பனிக்கட்டி மழையை சிறு கற்களைப்போல் வீசியெறிகிறார்;","poem":1},{"text":"அவருடைய பனியின் குளிர்காற்றை யாரால் தாங்கமுடியும்?","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர் தமது வார்த்தையை அனுப்பி, அவைகளை உருகச்செய்கிறார்;","poem":1},{"text":"அவர் தமது தென்றல் காற்றுகளை வீசச்செய்ய, வெள்ளம் ஓடுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"அவர் தமது வார்த்தையை யாக்கோபுக்கும்,","poem":1},{"text":"தமது சட்டங்களையும் விதிமுறைகளையும் இஸ்ரயேலுக்கும் வெளிப்படுத்தியிருக்கிறார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர் இப்படி வேறு எந்த மக்களுக்கும் வெளிப்படுத்தவில்லை;","poem":1},{"text":"அவர்கள் அவருடைய சட்டங்களை அறியாதிருக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"யெகோவாவைத் துதி.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/147.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/148.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/146.json","previousChapterAudioLinks":{},"numberOfVerses":20}