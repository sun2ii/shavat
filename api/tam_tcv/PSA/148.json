{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":148,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவைத் துதியுங்கள்.","poem":1},{"lineBreak":true},{"text":"வானங்களிலிருந்து யெகோவாவைத் துதியுங்கள்;","poem":1},{"text":"மேலே உன்னதங்களில் அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவருடைய தூதர்களே, எல்லோரும் அவரைத் துதியுங்கள்;","poem":1},{"text":"அவருடைய பரலோக சேனைகளே, எல்லோரும் அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"சூரியனே, சந்திரனே, அவரைத் துதியுங்கள்;","poem":1},{"text":"பிரகாசிக்கிற நட்சத்திரங்களே, நீங்கள் எல்லோரும் அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மிக உயர்ந்த வானங்களே, நீங்கள் அவரைத் துதியுங்கள்;","poem":1},{"text":"ஆகாயங்களுக்கு மேலுள்ள தண்ணீர்களே, அவரைத் துதியுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவர் கட்டளையிட அவை படைக்கப்பட்டதால்","poem":1},{"text":"அவைகள் யெகோவாவினுடைய பெயரைத் துதிக்கட்டும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவா அவைகளை எப்பொழுதும் என்றென்றைக்கும் நிலைப்படுத்தினார்;","poem":1},{"text":"அழிந்துபோகாத ஒரு விதிமுறையை ஏற்படுத்தியிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"பூமியிலிருந்து யெகோவாவைத் துதியுங்கள்,","poem":1},{"text":"பெரிய கடல் உயிரினங்களே, கடலின் ஆழங்களே,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நெருப்பே, பனிக்கட்டி மழையே, உறைபனியே, மேகங்களே,","poem":1},{"text":"அவருடைய கட்டளையை நிறைவேற்றும் புயல்காற்றே,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மலைகளே, குன்றுகளே,","poem":1},{"text":"பழமரங்களே, அனைத்து கேதுரு மரங்களே,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உயிரினங்களே, அனைத்து கால்நடைகளே,","poem":1},{"text":"சிறிய உயிரினங்களே, பறக்கும் பறவைகளே,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பூமியின் அரசர்களே, சகல நாடுகளே,","poem":1},{"text":"இளவரசர்களே, பூமியிலுள்ள சகல ஆளுநர்களே,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இளைஞர்களே, இளம்பெண்களே,","poem":1},{"text":"முதியவர்களே, பிள்ளைகளே அவரைத் துதியுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"அவர்கள் யெகோவாவினுடைய பெயரைத் துதிக்கட்டும்;","poem":1},{"text":"ஏனெனில் அவருடைய பெயர் மட்டுமே புகழ்ந்து உயர்த்தப்பட்டிருக்கிறது;","poem":2},{"lineBreak":true},{"text":"அவருடைய சிறப்பு பூமிக்கும், வானங்களுக்கும் மேலாக இருக்கிறது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர் தம் உண்மையுள்ள பணியாளர்களாகிய,","poem":1},{"text":"இருதயத்திற்கு உகந்த இஸ்ரயேல் மக்கள் துதிக்கும்படி,","poem":2},{"text":"அவர் தம்முடைய மக்களுக்கென ஒரு வல்லமையுள்ள அரசனை உயர்த்தியிருக்கிறார்;","poem":1},{"text":"அதற்காக அவரை எல்லா பரிசுத்தவான்களும் இஸ்ரயேலரும் துதிக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"யெகோவாவைத் துதியுங்கள்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/148.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/149.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/147.json","previousChapterAudioLinks":{},"numberOfVerses":14}