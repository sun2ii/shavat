{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":149,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவைத் துதியுங்கள்","poem":1},{"noteId":21},{"text":".","poem":1},{"lineBreak":true},{"text":"யெகோவாவுக்கு ஒரு புதுப்பாட்டைப் பாடுங்கள்,","poem":1},{"text":"பரிசுத்தவான்களின் சபையிலே அவருடைய துதியைப் பாடுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"இஸ்ரயேலர் தங்களைப் படைத்தவரில் மகிழட்டும்;","poem":1},{"text":"சீயோனின் மக்கள் தங்கள் அரசரில் களிகூரட்டும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் யெகோவாவினுடைய பெயரை நடனத்தோடு துதிக்கட்டும்,","poem":1},{"text":"தம்புராவினாலும் யாழினாலும் அவருக்கு இசை மீட்டட்டும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஏனெனில் யெகோவா தம்முடைய மக்களில் மகிழ்ச்சியாயிருக்கிறார்;","poem":1},{"text":"தாழ்மையுள்ளவர்களை அவர் இரட்சிப்பினால் முடிசூட்டுகிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பரிசுத்தவான்கள் இந்த மகிமையில் களிகூர்ந்து","poem":1},{"text":"தங்கள் படுக்கைகளில் மகிழ்ச்சியுடன் பாடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவர்களுடைய வாய்களில் இறைவனின் துதியும்,","poem":1},{"text":"கைகளில் இருபக்கமும் கூர்மையுள்ள வாளும் இருப்பதாக.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவைகளினால் நாடுகளைப் பழிவாங்கவும்,","poem":1},{"text":"மக்கள் கூட்டத்தைத் தண்டிக்கவும்,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்களுடைய அரசர்களைச் சங்கலிகளாலும்,","poem":1},{"text":"அவர்களுடைய அதிகாரிகளை இரும்பு விலங்குகளினாலும் கட்டவும்,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களுக்கு விரோதமாக எழுதப்பட்ட நியாயத்தீர்ப்பை","poem":1},{"text":"நடைமுறைப்படுத்தவும் அவை இருப்பதாக.","poem":2},{"lineBreak":true},{"text":"இதுவே அவருடைய எல்லா பரிசுத்தவான்களுக்கும் உரிய மகிமை.","poem":2},{"lineBreak":true},{"text":"யெகோவாவைத் துதியுங்கள்.","poem":1}]}],"footnotes":[{"noteId":21,"caller":"+","text":"துதியுங்கள் என்பது எபிரெயத்தில் அல்லேலூயா; வசனம் 9லும் உள்ளது.","reference":{"chapter":149,"verse":1}}]},"thisChapterLink":"/api/tam_tcv/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}