{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":15,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உமது பரிசுத்த கூடாரத்தில் யார் வாழ்வான்?","poem":1},{"text":"உமது பரிசுத்த மலையில் யார் குடியிருப்பான்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"குற்றமற்றவர்களாய் நடக்கிறவர்கள்,","poem":1},{"text":"நீதியானதைச் செய்கிறவர்கள்,","poem":2},{"lineBreak":true},{"text":"உள்ளத்திலிருந்து உண்மையைப் பேசுகிறவர்கள்;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"தம் நாவினால் அவதூறு பேசாதவர்கள்,","poem":1},{"text":"தம் தோழருக்கு அநியாயம் செய்யாதவர்கள்,","poem":2},{"lineBreak":true},{"text":"மற்றவர்களை நிந்திக்காதவர்கள்;","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இழிவானவனை அவமதிப்பவர்கள்,","poem":1},{"text":"யெகோவாவுக்குப் பயந்து நடப்பவர்களைக் கனம்பண்ணுகிறவர்கள்;","poem":2},{"text":"ஆணையிட்டதினால் துன்பம் நேரிட்டாலும்","poem":1},{"text":"மனதை மாற்றாதவர்கள்;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஏழைகளுக்குத் தம் பணத்தை வட்டியின்றிக் கடனாகக் கொடுப்பவர்கள்,","poem":1},{"text":"குற்றமற்றவர்களுக்கு விரோதமாக இலஞ்சம் வாங்காதவர்கள்.","poem":2},{"lineBreak":true},{"text":"இவ்வாறு வாழ்கிறவர்கள்","poem":1},{"text":"ஒருபோதும் அசைக்கப்படுவதில்லை.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}