{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":150,"content":[{"type":"verse","number":1,"content":[{"text":"அல்லேலூயா,","poem":1},{"lineBreak":true},{"text":"இறைவனை அவருடைய பரிசுத்த இடத்தில் துதியுங்கள்;","poem":1},{"text":"அவருடைய வல்லமை வெளிப்படும் வானங்களில் அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவருடைய வல்லமையின் செயல்களுக்காக அவரைத் துதியுங்கள்;","poem":1},{"text":"இணையற்ற அவருடைய மகத்துவத்திற்காக அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எக்காள சத்தத்தோடு அவரைத் துதியுங்கள்;","poem":1},{"text":"யாழோடும், வீணையோடும் அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"தம்புராவுடன் நடனமாடி அவரைத் துதியுங்கள்;","poem":1},{"text":"கம்பியிசைக் கருவிகளினாலும், புல்லாங்குழலினாலும் அவரைத் துதியுங்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கைத்தாளங்களின் ஓசையுடன் அவரைத் துதியுங்கள்;","poem":1},{"text":"அதிர்ந்து ஒலிக்கும் கைத்தாளங்களுடன் அவரைத் துதியுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"சுவாசமுள்ள யாவும் யெகோவாவைத் துதிப்பதாக.","poem":1},{"lineBreak":true},{"text":"அல்லேலூயா.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/150.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PRO/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/149.json","previousChapterAudioLinks":{},"numberOfVerses":6}