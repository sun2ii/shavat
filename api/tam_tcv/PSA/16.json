{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":16,"content":[{"type":"hebrew_subtitle","content":["மிக்தாம் என்னும் தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, என்னைப் பாதுகாத்துக்கொள்ளும்,","poem":1},{"text":"ஏனெனில் நான் உம்மில் தஞ்சம் அடைகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"நான் யெகோவாவிடம், “நீரே என் யெகோவா;","poem":1},{"text":"உம்மைத்தவிர என்னிடம் ஒரு நன்மையும் இல்லை” என்று சொன்னேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நாட்டிலுள்ள பரிசுத்தவான்கள், “அவர்கள் சிறந்தவர்கள்","poem":1},{"text":"என் மகிழ்ச்சி எல்லாம் அவர்களிலேயே இருக்கின்றன.”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பிற தெய்வங்களைத் தேடி ஓடுகிறவர்களுக்கு துயரங்கள் அதிகரிக்கும்.","poem":1},{"text":"இரத்தபான காணிக்கைகளை அந்த தெய்வங்களுக்கு நான் ஊற்றமாட்டேன்;","poem":2},{"lineBreak":true},{"text":"அவைகளின் பெயர்களை என் உதடுகளினால் சொல்லவு மாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, நீரே எனது சுதந்திரம், ஆசீர்வாதத்தின் பாத்திரமுமாய் இருக்கிறீர்;","poem":1},{"text":"எனது பங்கை பாதுகாப்பானதாய் ஆக்கியிருக்கிறீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"எனக்கான எல்லைப் பகுதிகள் இன்பமான இடங்களில் அமைந்துள்ளன;","poem":1},{"text":"நிச்சயமாகவே மகிழ்ச்சியான உரிமைச்சொத்து எனக்கு உண்டு.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எனக்கு ஆலோசனை தருகின்ற யெகோவாவை நான் துதிப்பேன்;","poem":1},{"text":"இரவிலும் என் இருதயம் எனக்கு அறிவைப் புகட்டுகிறது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவாவையே எப்பொழுதும் எனக்கு முன்பாக வைத்திருக்கிறேன்.","poem":1},{"text":"அவர் என்னுடைய வலதுபக்கத்தில் இருக்கிறபடியால் நான் அசைக்கப்படமாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ஆகையால், என் இருதயம் மகிழ்ந்து என் நாவு களிகூருகிறது;","poem":1},{"text":"என் உடலும் பாதுகாப்பாய் இளைப்பாறும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஏனென்றால் நீர் என்னை பாதாளத்தில் கைவிட்டுவிடமாட்டீர்;","poem":1},{"text":"உமது பரிசுத்தவான் அழிவைக் காணவும் விடமாட்டீர்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"வாழ்வின் பாதையை நான் அறியப்பண்ணினீர்;","poem":1},{"text":"உமது சமுகத்தில் என்னை ஆனந்தத்தாலும்,","poem":2},{"lineBreak":true},{"text":"உமது வலதுபக்கத்தில் என்னை நித்திய இன்பங்களினாலும் நிரப்புவீர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}