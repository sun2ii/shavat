{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":17,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் மன்றாட்டு"]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என்னுடைய நீதியான விண்ணப்பத்தைக் கேளும்,","poem":1},{"text":"என் கதறுதலுக்குச் செவிகொடும்;","poem":2},{"text":"வஞ்சகமில்லாத உதடுகளிலிருந்து பிறக்கும்","poem":1},{"text":"என் மன்றாட்டைக் கேளும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் குற்றமற்றவனென்ற தீர்ப்பு உம்மிடத்திலிருந்து வரட்டும்;","poem":1},{"text":"உமது கண்கள் நேர்மையானதைக் காணட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நீர் என் உள்ளத்தை ஆராய்ந்து பார்த்தாலும்,","poem":1},{"text":"இரவில் என்னைச் சோதித்தாலும்,","poem":2},{"text":"நீர் எந்தத் தீங்கையும் கண்டுபிடிக்கமாட்டீர்;","poem":1},{"text":"என் வாயினால் நான் பாவம் செய்யமாட்டேனென்று தீர்மானித்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மனிதர்கள் என்னைத் தீமைசெய்ய வற்புறுத்தினாலும்,","poem":1},{"text":"உமது உதடுகளின் கட்டளையினால் வன்முறையாளர்களின் வழிகளிலிருந்து,","poem":2},{"lineBreak":true},{"text":"என்னை விலக்கிக் காத்துக்கொண்டேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உம்முடைய வழிகளை, என் காலடிகள் உறுதியாய்ப் பற்றிக்கொண்டன;","poem":1},{"text":"என்னுடைய பாதங்கள் தடுமாறவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"இறைவனே, நான் உம்மை நோக்கிக் கூப்பிடுகிறேன்;","poem":1},{"text":"ஏனெனில் நீர் எனக்குப் பதில் கொடுக்கிறவர்.","poem":2},{"lineBreak":true},{"text":"எனக்குச் செவிகொடுத்து என் மன்றாட்டைக் கேளும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உம்மிடம் தஞ்சம் அடைந்தோரை,","poem":1},{"text":"அவர்களுடைய எதிரிகளிடமிருந்து உமது வலக்கரத்தினால் காப்பாற்றுகிறவரே,","poem":2},{"lineBreak":true},{"text":"உமது உடன்படிக்கையின் அன்பின் அதிசயத்தைக் காண்பியும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"உமது கண்ணின் மணியைப்போல் என்னைக் காத்துக்கொள்ளும்;","poem":1},{"text":"உமது சிறகுகளின் நிழலின்கீழ்,","poem":2}]},{"type":"verse","number":9,"content":[{"text":"என்னைத் தாக்கும் கொடியவர்களிடமிருந்தும்","poem":1},{"text":"என்னைச் சூழ்ந்துகொள்ளும் என் பகைவரிடமிருந்தும் என்னை மறைத்துக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அவர்கள் தங்கள் உணர்வற்ற இருதயங்களை கடினமாக்குகிறார்கள்,","poem":1},{"text":"அவர்களின் வாய்கள் பெருமையுடன் பேசுகின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் என்னைப் பின்தொடர்ந்திருக்கிறார்கள்,","poem":1},{"text":"இப்பொழுது என்னைச் சூழ்ந்துகொண்டார்கள்.","poem":2},{"text":"என்னைத் தரையில் விழத்தள்ளுவதற்காக","poem":1},{"text":"அவர்களுடைய கண்கள் விழிப்பாயிருக்கின்றன.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்கள் பசியால் துடித்து இரையைத் தேடுகிற சிங்கத்தைப் போலவும்","poem":1},{"text":"மறைவில் பதுங்கியிருக்கிற பெரும் சிங்கத்தைப் போலவும் இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"யெகோவாவே, எழுந்தருளும், நீர் அவர்களை எதிர்த்து வீழ்த்திவிடும்;","poem":1},{"text":"கொடியவர்களிடமிருந்து உமது வாளினால் என்னைத் தப்புவியும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவாவே, இப்படிப்பட்டவர்களிடமிருந்தும்,","poem":1},{"text":"இம்மையிலேயே தங்கள் வெகுமதியைப் பெறுகிற இவ்வுலக மனிதரிடமிருந்தும்,","poem":2},{"lineBreak":true},{"text":"உமது கரத்தினால் என்னைக் காப்பாற்றும்;","poem":2},{"text":"நீர் கொடியவர்களுக்கென்று வைத்திருக்கிறவைகளால் அவர்களுடைய வயிற்றை நிரப்பும்;","poem":1},{"text":"அவர்களுடைய பிள்ளைகள் நிறைவாய்ப் பெற்றுக்கொள்ளட்டும்;","poem":2},{"lineBreak":true},{"text":"மீதியானதை அவர்கள் தங்களுடைய பிள்ளைகளுக்கு விட்டுச் செல்லட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"நானோ, நீதியில் உமது முகத்தைக் காண்பேன்;","poem":1},{"text":"நான் விழித்தெழும்போது உம்மைக் கண்டு திருப்தியடைவேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":15}