{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":18,"content":[{"type":"hebrew_subtitle","content":["யெகோவாவின் பணியாளன் தாவீதின் சங்கீதம். யெகோவா அவனை எல்லாப் பகைவரின் கைகளிலிருந்தும் சவுலின் கையிலிருந்தும் விடுவித்தபோது இப்பாடலின் வார்த்தைகளை அவன் யெகோவாவுக்குப் பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்டது. அவன் சொன்னதாவது:"]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என் பெலனே, நான் உம்மை நேசிக்கிறேன்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"யெகோவா என் கன்மலை, என் கோட்டை, என்னை விடுவிக்கிறவர்;","poem":1},{"text":"என் இறைவன் நான் தஞ்சம் அடையும் என் கன்மலை,","poem":2},{"lineBreak":true},{"text":"என் கேடயம், என் மீட்பின் கொம்பு, என் அரணுமாயிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"துதிக்கப்படத்தக்கவரான யெகோவாவை நோக்கி நான் கூப்பிடுகிறேன்;","poem":1},{"text":"என் பகைவரிடமிருந்து நான் காப்பாற்றப்படுகிறேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மரணக் கயிறுகளால் நான் சிக்குண்டேன்;","poem":1},{"text":"அழிவின் அலைகள் என்னை அமிழ்த்திவிட்டன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பிரேதக் குழியின் கயிறுகள் என்னைச் சூழ்ந்துகொண்டன;","poem":1},{"text":"மரணத்தின் கண்ணிகள் என்னை எதிர்த்து வந்தன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"என் துயரத்தில் நான் யெகோவாவை நோக்கிக் கூப்பிட்டேன்;","poem":1},{"text":"என் இறைவனிடம் உதவிக்காகக் கதறினேன்;","poem":2},{"text":"அவர் தமது ஆலயத்திலிருந்து என் குரலைக் கேட்டார்;","poem":1},{"text":"என் அழுகுரல் அவருடைய செவிக்கு எட்டியது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"பூமி நடுங்கி அதிர்ந்து,","poem":1},{"text":"மலைகளின் அஸ்திபாரங்கள் அசைந்தன;","poem":2},{"lineBreak":true},{"text":"யெகோவா கோபமடைந்ததால் அவை நடுங்கின.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவருடைய நாசியிலிருந்து புகை எழும்பிற்று;","poem":1},{"text":"அவருடைய வாயிலிருந்து சுட்டெரிக்கும் நெருப்புப் புறப்பட்டது;","poem":2},{"lineBreak":true},{"text":"நெருப்புத் தழல் அதிலிருந்து தெறித்தன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் வானங்களைப் பிரித்து, கீழே இறங்கினார்;","poem":1},{"text":"கார்மேகங்கள் அவருடைய பாதங்களின்கீழ் இருந்தன.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர் கேருபீனின்மேல் ஏறிப் பறந்தார்;","poem":1},{"text":"அவர் காற்றின் சிறகுகளைக்கொண்டு பறந்தார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர் இருளைத் தமது போர்வையாகவும்,","poem":1},{"text":"வானத்தின் இருண்ட மழைமேகங்களைத் தம்மைச் சுற்றிலும் கூடாரமாகவும் ஆக்கினார்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவருடைய சமுகத்தின் பிரகாசத்திலிருந்து மேகங்கள் முன்னோக்கிச் சென்றன;","poem":1},{"text":"அவற்றுடன் பனிக்கட்டி மழையும் மின்னல் கீற்றுக்களும் சென்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவா வானத்திலிருந்து இடியை முழக்கினார்;","poem":1},{"text":"மகா உன்னதமானவரின் குரல் எதிரொலித்தது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர் தமது அம்புகளை எய்து பகைவரைச் சிதறடித்தார்;","poem":1},{"text":"மின்னல் கீற்றுக்களை அனுப்பி, அவர்களை முறியடித்தார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"யெகோவாவே, உமது நாசியிலிருந்து வந்த மூச்சின் தாக்கத்தாலும்","poem":1},{"text":"உமது கண்டிப்பினாலும்","poem":2},{"text":"கடல்களின் அடிப்பரப்பு வெளிப்பட்டன;","poem":1},{"text":"பூமியின் அஸ்திபாரங்கள் வெளியே தெரிந்தன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"யெகோவா என்னை உயரத்திலிருந்து எட்டிப் பிடித்தார்;","poem":1},{"text":"ஆழமான தண்ணீரிலிருந்து என்னை வெளியே தூக்கினார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர் சக்திவாய்ந்த என் பகைவனிடமிருந்தும்","poem":1},{"text":"என்னிலும் அதிக பலமான எதிரிகளிடமிருந்தும் என்னைத் தப்புவித்தார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்கள் என்னுடைய பேராபத்தின் நாளிலே, எனக்கெதிராய் எழுந்தார்கள்;","poem":1},{"text":"ஆனால் யெகோவா என் ஆதரவாயிருந்தார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர் என்னை விசாலமான ஒரு இடத்திற்கு வெளியே கொண்டுவந்தார்;","poem":1},{"text":"அவர் என்னில் பிரியமாய் இருந்தபடியால் என்னைத் தப்புவித்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"யெகோவா என் நீதிக்கு ஏற்றபடி என்னை நடத்தியிருக்கிறார்;","poem":1},{"text":"என் கைகளின் சுத்தத்திற்கு தக்கதாய், அவர் எனக்குப் பலனளித்திருக்கிறார்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"ஏனெனில் நான் யெகோவாவினுடைய வழிகளை கைக்கொண்டிருக்கிறேன்;","poem":1},{"text":"என் இறைவனைவிட்டு விலகி நான் குற்றம் செய்யவில்லை.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"அவருடைய நீதிநெறிகள் அனைத்தும் எனக்கு முன்பாக இருக்கின்றன;","poem":1},{"text":"அவருடைய விதிமுறைகளிலிருந்து நான் விலகவேயில்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நான் அவருக்கு முன்பாக குற்றமற்றவனாக இருந்து,","poem":1},{"text":"பாவத்திலிருந்து என்னை விலக்கிக் காத்துக்கொண்டேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"யெகோவா என் நீதிக்கு ஏற்றவாறும்,","poem":1},{"text":"அவருடைய பார்வையில் என் கைகளின் தூய்மைக்கு ஏற்றவாறும்","poem":2},{"lineBreak":true},{"text":"எனக்குப் பலனளித்திருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"உண்மையுள்ளவர்களுக்கு நீர் உம்மை உண்மையுள்ளவராகவே காண்பிக்கிறீர்;","poem":1},{"text":"உத்தமர்களுக்கு நீர் உம்மை உத்தமராகவே காண்பிக்கிறீர்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"தூய்மையுள்ளவர்களுக்கு நீர் உம்மைத் தூய்மையுள்ளவராகவேக் காண்பிக்கிறீர்;","poem":1},{"text":"ஆனால் கபடமுள்ளவர்களுக்கோ நீர் உம்மை விவேகமுள்ளவராய்க் காண்பிக்கிறீர்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நீர் தாழ்மையுள்ளோரைக் காப்பாற்றுகிறீர்;","poem":1},{"text":"ஆனால் பெருமையான பார்வையுள்ளவர்களைத் தாழ்த்துகிறீர்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"யெகோவாவே, நீர் என் விளக்கை எரிந்து கொண்டேயிருக்கச் செய்யும்;","poem":1},{"text":"என் இறைவன் என் இருளை வெளிச்சமாக்குவார்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"உமது உதவியுடன் என்னால் ஒரு படையை எதிர்த்து முன்னேற முடியும்;","poem":1},{"text":"என் இறைவனுடன் ஒரு மதிலைத் தாண்டுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"இறைவனுடைய வழி முழு நிறைவானது:","poem":1},{"text":"யெகோவாவின் வார்த்தையோ குறைபாடற்றது;","poem":2},{"lineBreak":true},{"text":"அவரிடத்தில் தஞ்சமடைவோர் அனைவருக்கும் அவர் கேடயமாயிருக்கிறார்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"யெகோவாவைத்தவிர இறைவன் யார்?","poem":1},{"text":"நமது இறைவனேயல்லாமல் வேறு கன்மலை யார்?","poem":2}]},{"type":"verse","number":32,"content":[{"text":"இறைவன் பெலத்தை எனக்கு அரைக்கச்சையாகக் கட்டி,","poem":1},{"text":"என் வழியை குறைவற்றதாய் ஆக்குகிறார்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"அவர் என் கால்களை மானின் கால்களைப் போல துரிதப்படுத்தி,","poem":1},{"text":"உயர்ந்த இடங்களில் என்னை நிற்கப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"யுத்தம் செய்ய என் கைகளைப் பயிற்றுவிக்கிறார்;","poem":1},{"text":"என் கரங்களால் ஒரு வெண்கல வில்லையும் வளைக்க முடியும்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"நீர் உமது இரட்சிப்பை எனக்கு கேடயமாகத் தந்தீர்,","poem":1},{"text":"உமது வலதுகரம் என்னைத் தாங்குகிறது;","poem":2},{"lineBreak":true},{"text":"உமது உதவி என்னைப் பெரியவனாக்குகிறது.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"என்னுடைய கால்கள் வழுக்காதபடி,","poem":1},{"text":"நான் நடக்கும் பாதையை நீர் அகலமாக்குகிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"நான் என் பகைவரை துரத்திச்சென்று, அவர்களைப் பிடித்தேன்;","poem":1},{"text":"அவர்கள் முற்றிலும் அழியும்வரை, நான் திரும்பி வரவில்லை.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"அவர்கள் எழுந்திருக்காதபடி, நான் அவர்களை முறியடித்தேன்;","poem":1},{"text":"அவர்கள் என் காலடியில் விழுந்தார்கள்.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"யுத்தம் செய்வதற்கான வல்லமையை நீர் எனக்குத் தரிப்பித்தீர்;","poem":1},{"text":"என் எதிரிகளை எனக்கு முன்பாகத் தாழ்த்தினீர்.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"நீர் என் பகைவரை புறமுதுகிட்டு ஓடச்செய்தீர்;","poem":1},{"text":"நான் அவர்களை அழித்தேன்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"அவர்கள் உதவிகேட்டு கூப்பிட்டார்கள்,","poem":1},{"text":"ஆனால் அவர்களைக் காப்பாற்ற ஒருவருமே இருக்கவில்லை;","poem":2},{"lineBreak":true},{"text":"யெகோவாவை நோக்கிக் கூப்பிட்டார்கள், அவரோ பதில் கொடுக்கவில்லை.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"நான் அவர்களை காற்றில் கிளம்பும் தூசியைப்போல் நொறுக்கினேன்;","poem":1},{"text":"நான் அவர்களை மிதித்து வீதியிலுள்ள சேற்றைப்போல் வெளியே வாரி எறிந்தேன்.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"நீர் மக்களின் தாக்குதல்களிலிருந்து என்னை விடுவித்திருக்கிறீர்;","poem":1},{"text":"நாடுகளுக்கு என்னைத் தலைவனாக வைத்திருக்கிறீர்.","poem":2},{"text":"நான் அறியாத மக்கள் எனக்கு கீழ்ப்பட்டிருக்கிறார்கள்.","poem":1}]},{"type":"verse","number":44,"content":[{"text":"வேறுநாட்டைச் சேர்ந்தவரும் எனக்கு முன்பாக அடங்கி ஒடுங்குகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் என்னைக் குறித்துக் கேள்விப்பட்டவுடனே எனக்குக் கீழ்ப்படிகிறார்கள்.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"அவர்கள் அனைவரும் மனந்தளர்ந்து,","poem":1},{"text":"தங்கள் அரண்களிலிருந்து நடுங்கிக்கொண்டு வருகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"யெகோவா வாழ்கிறார்! என் கன்மலையானவருக்குத் துதி உண்டாவதாக!","poem":1},{"text":"என் இரட்சகராகிய இறைவன் உயர்த்தப்படுவாராக!","poem":2}]},{"type":"verse","number":47,"content":[{"text":"எனக்காகப் பழிவாங்கும் இறைவன் அவரே;","poem":1},{"text":"நாடுகளை எனக்குக்கீழ் அடங்கியிருக்கச் செய்பவரும் அவரே.","poem":2}]},{"type":"verse","number":48,"content":[{"lineBreak":true},{"text":"என் எதிரிகளிடமிருந்து என்னைக் காப்பாற்றுகிறவரும் அவரே.","poem":2},{"text":"நீர் என் பகைவர்களுக்கு மேலாக என்னை உயர்த்தினீர்;","poem":1},{"text":"என்னை என் வன்முறையாளர்களிடமிருந்து தப்புவித்தீர்.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"ஆகையால் யெகோவாவே, நாடுகளுக்கு மத்தியில் நான் உம்மைத் துதிப்பேன்;","poem":1},{"text":"உமது பெயருக்குத் துதிகள் பாடுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":50,"content":[{"text":"யெகோவா தாம் ஏற்படுத்திய அரசனுக்கு மாபெரும் வெற்றிகளைக் கொடுக்கிறார்;","poem":1},{"text":"அவர் தாம் அபிஷேகம் பண்ணின தாவீதுக்கும்","poem":2},{"lineBreak":true},{"text":"அவனுடைய சந்ததிகளுக்கும் தமது உடன்படிக்கையின் அன்பை என்றைக்கும் காண்பிக்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/18.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/19.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/17.json","previousChapterAudioLinks":{},"numberOfVerses":50}