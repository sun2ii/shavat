{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":19,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"வானங்கள் இறைவனுடைய மகிமையை அறிவிக்கின்றன,","poem":1},{"text":"ஆகாயங்கள் அவருடைய கரங்களின் செயலைப் பிரசித்தப்படுத்துகின்றன.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவைகள் நாள்தோறும் பேசுகின்றன;","poem":1},{"text":"இரவுதோறும் அறிவை வெளிப்படுத்துகின்றன.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவைகள் சொற்கள் இல்லாமல் பேசுகின்றன;","poem":1},{"text":"அங்கே அவைகளின் சத்தம் கேட்கப்படுவதுமில்லை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனாலும் அவைகளின் குரல் பூமியெங்கும் செல்கிறது;","poem":1},{"text":"அவைகளின் வார்த்தைகள் உலகத்தின் கடைமுனை வரைக்கும் செல்கின்றன.","poem":2},{"text":"யெகோவா வானங்களில் சூரியனுக்கு ஒரு கூடாரத்தை அமைத்திருக்கிறார்.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"சூரியனோ, மணவறையிலிருந்து புறப்படும் ஒரு மணமகனைப் போலவும்,","poem":2},{"lineBreak":true},{"text":"பந்தயத்திற்காக ஓட மகிழ்ச்சியுடனிருக்கும் விளையாட்டு வீரனைப்போலவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அது வானங்களின் ஒரு முனையில் உதித்து,","poem":1},{"text":"மறுமுனைவரை சுற்றிவருகிறது.","poem":2},{"lineBreak":true},{"text":"அதின் வெப்பத்திற்குத் ஒன்றும் தப்புவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவினுடைய சட்டம் முழு நிறைவானது,","poem":1},{"text":"அது ஆத்துமாவுக்குப் புத்துயிரளிக்கிறது.","poem":2},{"text":"யெகோவாவினுடைய நியமங்கள் நம்பகமானவை,","poem":1},{"text":"அவை பேதையை ஞானியாக்குகின்றன.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவாவினுடைய ஒழுங்குவிதிகள் நியாயமானவை,","poem":1},{"text":"அவை இருதயத்திற்கு மகிழ்வைக் கொடுக்கின்றன.","poem":2},{"text":"யெகோவாவினுடைய கட்டளைகள் பிரகாசமானவை,","poem":1},{"text":"அவை கண்களுக்கு வெளிச்சத்தைக் கொடுக்கின்றன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவுக்குரிய பயபக்தி தூய்மையானது,","poem":1},{"text":"அது என்றென்றும் நிலைத்திருக்கிறது.","poem":2},{"text":"யெகோவாவினுடைய விதிமுறைகள் நிலையானவை,","poem":1},{"text":"அவை முற்றிலும் நீதியானவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அவை தங்கத்தைவிட,","poem":1},{"text":"சுத்தத் தங்கத்தைவிட மிகுந்த விலையுயர்ந்தவை.","poem":2},{"text":"அவை தேனைப் பார்க்கிலும்,","poem":1},{"text":"கூட்டிலிருந்து வடியும் தெளித்தேனைப் பார்க்கிலும் இனிமையானவை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவைகளால் உமது அடியேன் எச்சரிப்படைகிறேன்;","poem":1},{"text":"அவைகளைக் கைக்கொள்வதால் மிகுந்த பலனுண்டு.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"தன் தவறுகளை அறிந்துணர யாரால் முடியும்?","poem":1},{"text":"என் மறைவான குற்றங்களை எனக்கு மன்னியும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"விரும்பி செய்யும் பாவங்களிலிருந்து உமது அடியேனைக் காத்துக்கொள்ளும்;","poem":1},{"text":"அவைகள் என்னை ஆளுகை செய்யாதிருப்பதாக.","poem":2},{"text":"அப்பொழுது நான் குற்றமற்றவனாயும்,","poem":1},{"text":"பெரும் மீறுதல்கள் அறியாதவனாயும் இருப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"என் கன்மலையும் என் மீட்பருமாகிய யெகோவாவே,","poem":1},{"text":"என் வாயின் வார்த்தைகளும்","poem":2},{"lineBreak":true},{"text":"என் இருதயத்தின் தியானமும் உமது பார்வையில் பிரியமாய் இருப்பதாக.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/19.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/20.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/18.json","previousChapterAudioLinks":{},"numberOfVerses":14}