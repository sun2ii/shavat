{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"நாடுகள் ஏன் கொதித்து எழும்புகின்றன?","poem":1},{"text":"மக்கள் கூட்டம் ஏன் வீணாய் சூழ்ச்சி செய்கின்றார்கள்?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பூமியின் அரசர்கள் எதிர்த்து நிற்கிறார்கள்,","poem":1},{"text":"ஆளுநர்களும் யெகோவாவுக்கு விரோதமாகவும்,","poem":2},{"lineBreak":true},{"text":"அவரால் அபிஷேகம் செய்யப்பட்டவருக்கு விரோதமாகவும் ஒன்றுகூடி சொன்னதாவது:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“அவர்கள் இட்ட சங்கிலிகளை உடைத்து,","poem":1},{"text":"அவர்கள் கட்டிய கயிறுகளை அறுத்தெறிவோம்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"பரலோக சிங்காசனத்தில் அமர்ந்திருப்பவர் சிரிக்கிறார்;","poem":1},{"text":"யெகோவா அவர்களை இகழ்கிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர் தமது கோபத்தில் அவர்களைக் கடிந்து,","poem":1},{"text":"தமது கடுங்கோபத்தில் அவர்களுக்குத் திகிலுண்டாகச் சொல்வதாவது:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“நான் எனது அரசனை","poem":1},{"text":"என் பரிசுத்த மலையாகிய சீயோனில்","poem":2},{"noteId":0},{"text":"அமர்த்தியிருக்கிறேன்.”","poem":2}]},{"type":"verse","number":7,"content":["நான் யெகோவாவின் விதிமுறையைப் பிரசித்தப்படுத்துவேன்:",{"text":"அவர் என்னிடம் சொன்னதாவது, “நீர் என்னுடைய மகன்;","poem":1},{"text":"இன்று நான் உமக்குத் தந்தையானேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என்னிடம் கேளும்,","poem":1},{"text":"நான் நாடுகளை உம்முடைய உரிமைச் சொத்தாக்குவேன்,","poem":2},{"lineBreak":true},{"text":"பூமியை அதின் கடைசிவரை உமது உடைமையாக்குவேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீர் அவர்களை ஓர் இரும்புச் செங்கோலினால் உடைப்பீர்;","poem":1},{"text":"மண்பாண்டத்தை உடைப்பதுபோல்,","poem":2},{"lineBreak":true},{"text":"நீர் அவர்களை தூள்தூளாக நொறுக்கிப்போடுவீர்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ஆகவே, அரசர்களே, நீங்கள் ஞானமுள்ளவர்களாய் இருங்கள்;","poem":1},{"text":"பூமியின் ஆளுநர்களே, நீங்கள் எச்சரிப்படையுங்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பயத்துடன் யெகோவாவை வணங்குங்கள்,","poem":1},{"text":"நடுக்கத்துடன் அவர் ஆளுகையில் மகிழ்ந்திருங்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இறைமகனை முத்தம் செய்யுங்கள், இல்லையென்றால் அவர் கோபங்கொள்வார்;","poem":1},{"text":"நீங்களும் உங்கள் வழியில் அழிவீர்கள்;","poem":2},{"text":"ஏனெனில் ஒரு நொடியில் அவருடைய கோபம் பற்றியெரியும்.","poem":1},{"text":"அவரிடத்தில் தஞ்சம் புகுந்த அனைவரும் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"அல்லது எருசலேம் பட்டணம்","reference":{"chapter":2,"verse":6}}]},"thisChapterLink":"/api/tam_tcv/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/1.json","previousChapterAudioLinks":{},"numberOfVerses":12}