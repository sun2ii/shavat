{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":20,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நீ துன்பத்தில் இருக்கும்போது யெகோவா உன் ஜெபத்திற்குப் பதில் தருவாராக;","poem":1},{"text":"யாக்கோபின் இறைவனுடைய பெயர் உன்னைப் பாதுகாப்பதாக.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவா தமது பரிசுத்த இடத்திலிருந்து உனக்கு உதவி அனுப்பி,","poem":1},{"text":"சீயோனிலிருந்து உனக்கு ஆதரவு வழங்குவாராக.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யெகோவா உன் பலிகளையெல்லாம் நினைவுகூர்ந்து,","poem":1},{"text":"உனது தகனபலிகளை ஏற்றுக்கொள்வாராக.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவா உனது இருதயத்தின் வாஞ்சையை உனக்குத் தந்து,","poem":1},{"text":"உனது திட்டங்களையெல்லாம் வெற்றிபெறச் செய்வாராக.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவா வெற்றி தரும்போது நாங்கள் மகிழ்ச்சியால் ஆர்ப்பரிப்போம்;","poem":1},{"text":"நமது இறைவனுடைய பெயரில் நாங்கள் வெற்றிக்கொடிகளை உயர்த்துவோம்.","poem":2},{"lineBreak":true},{"text":"யெகோவா உன் வேண்டுதல்கள் அனைத்தையும் உனக்குக் கொடுப்பாராக.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நான் இப்போது இதை அறிந்திருக்கிறேன்:","poem":1},{"text":"யெகோவா தாம் அபிஷேகம் பண்ணியவனை இரட்சிக்கிறார்.","poem":2},{"text":"அவர் தமது பரிசுத்த பரலோகத்திலிருந்து","poem":1},{"text":"தமது வலதுகரத்தின் மீட்கும் வல்லமையைக்கொண்டு, அவனுக்குப் பதில் கொடுக்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"சிலர் தேர்களிலும் சிலர் குதிரைகளிலும் நம்பிக்கை வைக்கிறார்கள்;","poem":1},{"text":"ஆனால் நாங்களோ, நமது இறைவனாகிய யெகோவாவினுடைய பெயரிலேயே நம்பிக்கை வைக்கிறோம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்கள் மண்டியிட்டு விழுந்தார்கள்,","poem":1},{"text":"நாங்களோ எழுந்து உறுதியாய் நிற்கிறோம்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, அரசனுக்கு வெற்றியைக் கொடும்!","poem":1},{"text":"நாங்கள் கூப்பிடும்போது எங்களுக்குப் பதில் தாரும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":9}