{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":21,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, அரசன் உமது பெலத்தில் களிகூருகிறார்.","poem":1},{"text":"நீர் கொடுக்கும் வெற்றிகளில் அவருடைய மகிழ்ச்சி எவ்வளவு பெரிதாயிருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அவருடைய இருதயத்தின் வாஞ்சையை நீர் அவருக்குக் கொடுத்திருக்கிறீர்;","poem":1},{"text":"அவருடைய உதடுகளின் வேண்டுதலை நீர் புறக்கணிக்கவில்லை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நிறைவான ஆசீர்வாதங்களுடன் நீர் அவரை வரவேற்று,","poem":1},{"text":"சுத்தத் தங்கத்தினாலான மகுடத்தை நீர் அவர் தலையின்மேல் வைத்தீர்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் உம்மிடம் ஆயுளைக் கேட்டார், அதை நீர் அவருக்குக் கொடுத்தீர்;","poem":1},{"text":"அவர் என்றென்றும் வாழ, நீடித்த ஆயுளைக் கொடுத்தீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீர் கொடுத்த வெற்றிகளின் மூலம் அவருடைய மகிமை பெரியதாயிருக்கிறது;","poem":1},{"text":"நீர் அவரை மகிமையாலும் மகத்துவத்தாலும் நிரப்பியிருக்கிறீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நிச்சயமாகவே நீர் அவருக்கு நித்திய ஆசீர்வாதங்களைக் கொடுத்திருக்கிறீர்;","poem":1},{"text":"உமது சமுகத்தின் ஆனந்தத்தால், அவரை மகிழ்ச்சியாக்கினீர்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஏனெனில் அரசன் யெகோவாவிலேயே நம்பிக்கை வைக்கிறார்;","poem":1},{"text":"உன்னதமானவரின் உடன்படிக்கையின் அன்பினிமித்தம்","poem":2},{"lineBreak":true},{"text":"அவர் அசைக்கப்படமாட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"உமது கரம் உம்முடைய பகைவர் எல்லோரையும் பிடிக்கும்;","poem":1},{"text":"உமது வலதுகரம் உம்முடைய எதிரிகளைப் பிடித்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீர் வரும் நேரத்தில்","poem":1},{"text":"அவர்களை ஒரு நெருப்புச் சூளையைப்போல் ஆக்கிவிடுவீர்.","poem":2},{"text":"யெகோவா தமது கடுங்கோபத்தில் அவர்களை அழித்துவிடுவார்;","poem":1},{"text":"அவருடைய நெருப்பு அவர்களைச் சுட்டெரிக்கும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீர் அவர்களுடைய சந்ததிகளைப் பூமியிலிருந்து அழிப்பீர்,","poem":1},{"text":"அவர்களுடைய சந்ததிகளை மனுக்குலத்திலிருந்து அழிப்பீர்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உமது பகைவர் உமக்கு எதிராக தீமையான சதி செய்தார்கள்,","poem":1},{"text":"பொல்லாத சதித்திட்டங்களை வகுத்தார்கள்; ஆனாலும் அவர்களால் வெற்றி பெறமுடியாது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீர் வில்லை நாணேற்றி அவர்களை குறிபார்த்து எய்யும்போது,","poem":1},{"text":"அவர்களை புறமுதுகு காட்டப்பண்ணுவீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"யெகோவாவே, உமது பெலத்தில் நீர் உயர்த்தப்பட்டிருப்பீராக;","poem":1},{"text":"நாங்கள் உமது வல்லமையைப் பாடித் துதிப்போம்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":13}