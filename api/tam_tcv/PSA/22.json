{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":22,"content":[{"type":"hebrew_subtitle","content":["“காலைப் பெண்மான்” என்ற இராகத்தில் பாடும்படி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என் இறைவனே, என் இறைவனே, ஏன் என்னைக் கைவிட்டீர்?","poem":1},{"text":"என்னைக் காப்பாற்றாமல்,","poem":2},{"lineBreak":true},{"text":"நான் கதறிச் சொல்லும் வார்த்தைகளை நீர் கேளாமலும் ஏன் தூரமாயிருக்கிறீர்?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் இறைவனே, நான் பகலில் கூப்பிடுகிறேன், ஆனால் நீர் பதில் தருகிறதில்லை;","poem":1},{"text":"இரவிலும் நான் மன்றாடுகிறேன், எனக்கு அமைதியில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ஆனாலும் இஸ்ரயேலின் துதி சிங்காசனத்தில் அமர்ந்திருக்கும்","poem":1},{"text":"நீர் பரிசுத்தர்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உம்மிலேயே எங்கள் முன்னோர்கள் நம்பிக்கை வைத்தார்கள்;","poem":1},{"text":"நம்பிக்கை வைத்த அவர்களை நீர் விடுவித்தீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர்கள் உம்மை நோக்கிக் கூப்பிட்டார்கள், நீர் அவர்களைக் காப்பாற்றினீர்;","poem":1},{"text":"உம்மில் நம்பிக்கை வைத்து அவர்கள் வெட்கப்பட்டுப் போகவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ஆனால் நானோ ஒரு புழு, மனிதனேயல்ல;","poem":1},{"text":"மனிதரால் பழிக்கப்பட்டும், மக்களால் அவமதிக்கப்பட்டும் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என்னைக் காண்பவர்கள் அனைவரும் என்னை ஏளனம் செய்கிறார்கள்;","poem":1},{"text":"அவர்கள் தங்கள் தலைகளை அசைத்து பரியாசம்செய்கிறார்கள்","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“அவன் யெகோவாவை நம்பியிருக்கிறான்,","poem":1},{"text":"யெகோவா அவனை இரட்சிக்கட்டும்.","poem":2},{"text":"அவரிலே அவன் மகிழ்ச்சியாக இருக்கிறபடியால்","poem":1},{"text":"அவர் அவனை விடுவிக்கட்டும்” என்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ஆனாலும், நீரே என்னைத் தாயின் கர்ப்பத்திலிருந்து வெளியே கொண்டுவந்தவர்.","poem":1},{"text":"நான் என் தாயின் மார்பின் அணைப்பில் இருக்கும்போதே","poem":2},{"lineBreak":true},{"text":"என்னை உம்மில் நம்பிக்கையாய் இருக்கப்பண்ணினீர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் பிறப்பிலிருந்தே உமது பாதுகாப்பில் இருந்தேன்;","poem":1},{"text":"நான் என் தாயின் கர்ப்பத்தில் இருந்ததுமுதல் நீரே என் இறைவனாக இருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"நீர் என்னைவிட்டுத் தூரமாயிராதேயும்;","poem":1},{"text":"ஏனென்றால் துன்பம் நெருங்கியுள்ளது,","poem":2},{"lineBreak":true},{"text":"உதவிசெய்ய ஒருவருமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"அநேகம் காளைகள் என்னைச் சூழ்ந்து கொள்கின்றன;","poem":1},{"text":"பாசான் நாட்டு பலத்த காளைகள் என்னை வளைத்து கொள்கின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"தங்கள் இரையை கிழிக்கிற கெர்ச்சிக்கும் சிங்கங்களைப் போல,","poem":1},{"text":"அவர்கள் எனக்கு விரோதமாக தங்கள் வாய்களை விரிவாய்த் திறக்கிறார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"என் பெலன் தரையில் ஊற்றப்பட்ட தண்ணீரைப்போல் இருக்கிறது;","poem":1},{"text":"என் எலும்புகளெல்லாம் மூட்டுகளை விட்டுக் கழன்று போயின;","poem":2},{"text":"என் இருதயம் மெழுகு போலாகி","poem":1},{"text":"எனக்குள்ளே உருகிப் போயிற்று.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என் பெலன் ஓட்டுத்துண்டைப் போல் வறண்டுபோயிற்று;","poem":1},{"text":"என் நாவும் மேல்வாயுடன் ஒட்டிக்கொண்டது;","poem":2},{"lineBreak":true},{"text":"என்னை சவக்குழியின் தூசியில் போடுகிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"நாய்கள் என்னைச் சூழ்ந்துகொண்டன;","poem":1},{"text":"தீயவர்களின் கூட்டம் என்னை வளைத்து கொண்டது;","poem":2},{"lineBreak":true},{"text":"என் கைகளையும் என் கால்களையும் ஊடுருவக் குத்தினார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"என் எலும்புகள் எல்லாவற்றையும் என்னால் எண்ண முடியும்;","poem":1},{"text":"மக்கள் என்னை உற்றுப்பார்த்து ஏளனம் செய்து மகிழுகிறார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்கள் என் அங்கிகளைத் தங்களுக்குள் பங்கிட்டு,","poem":1},{"text":"என் உடைக்காக சீட்டுப் போடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"ஆனால் யெகோவாவே, நீர் எனக்குத் தூரமாகாதிரும்;","poem":1},{"text":"என் பெலனே, எனக்கு உதவிசெய்ய விரைந்து வாரும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"என்னை வாளுக்குத் தப்புவியும்;","poem":1},{"text":"என் விலைமதிப்பற்ற உயிரை நாய்களின் வலிமையிலிருந்து விடுவியும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"சிங்கங்களின் வாயிலிருந்து என்னைத் தப்புவியும்;","poem":1},{"text":"காட்டெருதுகளின் கொம்புகளிலிருந்து என்னைக் காப்பாற்றும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"அப்பொழுது நான் என் ஜனங்களுக்கு உம்முடைய பெயரை அறிவிப்பேன்,","poem":1},{"text":"திருச்சபையில் நான் உம்மைத் துதிப்பேன்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடக்கிறவர்களே, நீங்கள் அவரைத் துதியுங்கள்;","poem":1},{"text":"யாக்கோபின் சந்ததிகளே, நீங்கள் அனைவரும் அவரைக் கனம்பண்ணுங்கள்;","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலின் சந்ததிகளே, நீங்கள் அவரிடத்தில் பயபக்தியாய் இருங்கள்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"ஏனெனில் யெகோவா துன்புறுத்தப்பட்டவனுடைய வேதனையை,","poem":1},{"text":"அலட்சியம் பண்ணவுமில்லை அவமதிக்கவுமில்லை.","poem":2},{"text":"அவனிடத்திலிருந்து தமது முகத்தை மறைத்துக் கொள்ளவுமில்லை;","poem":1},{"text":"ஆனால் அவன் உதவிகேட்டுக் கதறுகையில் அவர் செவிகொடுத்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"நீர் செய்த செயல்களுக்காக மகா சபையில் நான் உம்மைத் துதிப்பேன்;","poem":1},{"text":"உமக்குப் பயப்படுகிறவர்களுக்கு முன்பாக","poem":2},{"lineBreak":true},{"text":"நான் என் நேர்த்திக் கடன்களை நிறைவேற்றுவேன்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ஏழைகள் சாப்பிட்டு திருப்தியடைவார்கள்;","poem":1},{"text":"யெகோவாவைத் தேடுகிறவர்கள் எல்லோரும் அவரைத் துதிப்பார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் இருதயங்கள் என்றும் வாழ்வதாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"பூமியின் கடைசிகளெல்லாம்","poem":1},{"text":"யெகோவாவை நினைத்து அவரிடம் திரும்பும்;","poem":2},{"text":"நாடுகளின் குடும்பங்கள் எல்லாம்","poem":1},{"text":"அவருக்கு முன்பாகத் தாழ்ந்து வணங்கும்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ஏனென்றால், அரசாட்சி யெகோவாவினுடையது;","poem":1},{"text":"அவர் நாடுகளை ஆளுகை செய்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"பூமியிலுள்ள செல்வந்தர் அனைவரும் விருந்துண்டு யெகோவாவை வழிபடுவார்கள்;","poem":1},{"text":"மரித்து மண்ணுக்குத் திரும்புவோரும், தன் உயிரைக் காத்துக்கொள்ளாதோரும்","poem":2},{"lineBreak":true},{"text":"அவருக்கு முன்பாக முழங்காற்படியிடுவார்கள்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"பிள்ளைகள் அவரை சேவிப்பார்கள்;","poem":1},{"text":"வருங்கால சந்ததியினருக்கு, யெகோவாவைப் பற்றிச் சொல்லப்படும்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"அவர்கள் அவருடைய நீதியை,","poem":1},{"text":"இன்னும் பிறவாமல் இருக்கும் மக்களுக்கு பிரசித்தப்படுத்துவார்கள்:","poem":2},{"lineBreak":true},{"text":"அவரே இதையெல்லாம் செய்து முடித்தார்! என்பார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/22.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/23.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/21.json","previousChapterAudioLinks":{},"numberOfVerses":31}