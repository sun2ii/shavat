{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":23,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா என் மேய்ப்பராயிருக்கிறார், எனக்கு ஒரு குறையும் ஏற்படாது.","poem":1}]},{"type":"verse","number":2,"content":[{"text":"அவர் என்னைப் பசுமையான புல்வெளிகளில் இளைப்பாறப் பண்ணுகிறார்,","poem":2},{"text":"அமைதியான நீர்நிலைகளின் அருகே என்னை வழிநடத்துகிறார்.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"அவர் என் ஆத்துமாவுக்கு புத்துயிர் அளிக்கிறார்.","poem":2},{"text":"தமது பெயருக்காக அவர் என்னை,","poem":1},{"text":"நீதியின் பாதைகளில் நடத்துகிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மரண நிழலின் பள்ளத்தாக்கின் வழியே","poem":1},{"text":"நான் நடந்தாலும்","poem":2},{"text":"நான் ஒரு தீமைக்கும் பயப்படமாட்டேன்,","poem":1},{"text":"ஏனென்றால், நீர் என்னுடன்கூட இருக்கிறீர்;","poem":2},{"text":"உமது கோலும் உமது தடியும்,","poem":1},{"text":"எனக்கு ஆறுதல் அளிக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"என் பகைவர்களின் சமுகத்தில்","poem":1},{"text":"நீர் எனக்கென ஒரு விருந்தை ஆயத்தம்பண்ணுகிறீர்.","poem":2},{"text":"நீர் என் தலையை எண்ணெயால் அபிஷேகம் பண்ணுகிறீர்;","poem":1},{"text":"என் பாத்திரம் நிரம்பி வழிகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நிச்சயமாகவே என் வாழ்நாள் முழுவதும்","poem":1},{"text":"நன்மையும் அன்பும் என்னைத் தொடர்ந்து வரும்,","poem":2},{"text":"நான் யெகோவாவினுடைய வீட்டில்","poem":1},{"text":"என்றென்றுமாய் வாழ்வேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/23.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/24.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/22.json","previousChapterAudioLinks":{},"numberOfVerses":6}