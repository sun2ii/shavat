{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":24,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"பூமியும் அதிலிருக்கும் ஒவ்வொன்றும் யெகோவாவினுடையவை,","poem":1},{"text":"உலகமும் அதில் வாழும் அனைவரும் அவருடையவர்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஏனென்றால் அவர் பூமியைக் கடலின்மேல் நிறுவி,","poem":1},{"text":"தண்ணீரின்மேல் நிலைநிறுத்தினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவினுடைய மலையில் ஏறத்தகுந்தவன் யார்?","poem":1},{"text":"அவருடைய பரிசுத்த இடத்தில் நிற்கத் தகுந்தவன் யார்?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"சுத்தமான கைகளுடையவனும் தூய்மையான இருதயமுடையவனும்","poem":1},{"text":"தன் ஆத்துமாவை பொய்யானவைகளுக்கு ஒப்புக்கொடாதவனும்","poem":2},{"lineBreak":true},{"text":"பொய் சத்தியம் செய்யாதவனுமே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவர்கள் யெகோவாவிடமிருந்து ஆசீர்வாதம் பெறுவார்கள்,","poem":1},{"text":"தங்கள் இரட்சகரான இறைவனால் நியாயத்தைப் பெறுவார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவரைத் தேடுகிறவர்களின் சந்ததி இப்படிப்பட்டதே,","poem":1},{"text":"யாக்கோபின் இறைவனே, உமது முகத்தைத் தேடுகிறவர்கள் இவர்களே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"வாசல்களே, உங்கள் தலைகளை உயர்த்துங்கள்;","poem":1},{"text":"பூர்வீகக் கதவுகளே, நீங்கள் உயர்த்தப்படுங்கள்;","poem":2},{"lineBreak":true},{"text":"மகிமையின் அரசன் உட்செல்ல வழிவிடுங்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"இந்த மகிமையின் அரசன் யார்?","poem":1},{"text":"அவர் பலமும் வலிமையும் உள்ள யெகோவா,","poem":2},{"lineBreak":true},{"text":"அவர் போரில் வல்லமையுள்ள யெகோவா.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"வாசல்களே, உங்கள் தலைகளை உயர்த்துங்கள்;","poem":1},{"text":"பூர்வீக கதவுகளே, நீங்கள் உயர்த்தப்படுங்கள்;","poem":2},{"lineBreak":true},{"text":"மகிமையின் அரசன் உட்செல்ல வழிவிடுங்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"மகிமையின் அரசனான இவர் யார்?","poem":1},{"text":"அவர் சேனைகளின் யெகோவா;","poem":2},{"lineBreak":true},{"text":"அவரே மகிமையின் அரசன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}