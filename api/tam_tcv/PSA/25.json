{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":25,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே,","poem":1},{"text":"உம்மிடத்தில் என் ஆத்துமாவை உயர்த்துகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"என் இறைவனே, உம்மில் நான் நம்பிக்கை வைக்கிறேன்;","poem":1},{"text":"என்னை வெட்கப்பட விடாதேயும்;","poem":2},{"lineBreak":true},{"text":"என் பகைவர் என்மேல் வெற்றிகொள்ள விடாதேயும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உம்மில் எதிர்பார்ப்பாய் இருப்பவர்கள் யாரும்,","poem":1},{"text":"ஒருபோதும் வெட்கப்படமாட்டார்கள்;","poem":2},{"lineBreak":true},{"text":"ஆனால் காரணமின்றி துரோகம் செய்பவர்கள் வெட்கமடைவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே, உமது வழிகளை எனக்குக் காண்பியும்;","poem":1},{"text":"உமது பாதைகளை எனக்குப் போதியும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உமது சத்தியத்தில் என்னை நடத்தி எனக்குப் போதியும்.","poem":1},{"text":"நீரே என் இரட்சகராகிய இறைவன்,","poem":2},{"lineBreak":true},{"text":"நாள்முழுதும் நான் உம்மையே எதிர்பார்க்கிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவே, உமது பெரிதான இரக்கத்தையும் அன்பையும் நினைவில்கொள்ளும்,","poem":1},{"text":"ஏனெனில் அவை பூர்வகாலமுதல் இருக்கிறதே.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் வாலிப காலத்தின் பாவங்களையும்","poem":1},{"text":"என் மீறுதல்களையும் நினைக்கவேண்டாம்;","poem":2},{"text":"உமது உடன்படிக்கையின் அன்பின்படி என்னை நினைத்துக்கொள்ளும்,","poem":1},{"text":"யெகோவாவே, நீர் நல்லவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவா நல்லவரும் நேர்மையானவருமாய் இருக்கிறார்;","poem":1},{"text":"ஆகையால் பாவிகளுக்குத் தமது வழிகளை அறிவுறுத்துகிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் தாழ்மையுள்ளோரை நியாயத்தில் வழிநடத்துகிறார்,","poem":1},{"text":"தமது வழியை அவர்களுக்குப் போதிக்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"யெகோவாவினுடைய உடன்படிக்கையின் கட்டளைகளைக் கைக்கொள்ளுகிறவர்களுக்கு","poem":1},{"text":"அவருடைய பாதைகளெல்லாம் உடன்படிக்கையின் அன்பும் நம்பகமுமானவைகள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவாவே, எனது அநியாயம் பெரிதாயிருப்பினும்,","poem":1},{"text":"உமது பெயரின் நிமித்தம் அதை மன்னியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவாவுக்குப் பயந்து நடக்கிற மனிதர் யார்?","poem":1},{"text":"அவர்கள் தெரிந்துகொள்ள வேண்டிய வழியை யெகோவா அவர்களுக்கு அறிவுறுத்துவார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் தமது வாழ்நாளெல்லாம் நன்மையைப் பெறுவார்கள்,","poem":1},{"text":"அவர்களுடைய சந்ததி பூமியை தமக்கு சொந்தமாக்கிக்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவாவின் இரகசியம் அவருக்குப் பயந்து நடக்கிறவர்களுக்குரியது;","poem":1},{"text":"அவர் தமது உடன்படிக்கையையும் அவர்களுக்குத் தெரியப்படுத்துகிறார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என் கண்கள் எப்பொழுதும் யெகோவாவையே நோக்கியிருக்கின்றன;","poem":1},{"text":"ஏனென்றால் என் கால்களை அவரே கண்ணியிலிருந்து விடுவிப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"யெகோவாவே, என் பக்கமாய்த் திரும்பி, எனக்குக் கிருபையாயிரும்;","poem":1},{"text":"நான் தனிமையிலும் துன்பத்திலும் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"என் இருதயத்தின் துயரத்திலிருந்து நீங்கலாக்கும்;","poem":1},{"text":"என் நெருக்கத்திலிருந்து என்னை விடுவியும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"என் துன்பத்தையும் என் துயரத்தையும் பார்த்து,","poem":1},{"text":"என் பாவங்களையெல்லாம் மன்னித்தருளும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"என் பகைவர்கள் எப்படி பெருகியிருக்கிறார்கள் என்று பாரும்;","poem":1},{"text":"அவர்கள் எவ்வளவு கொடூரமாக என்னை வெறுக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"என் உயிரைப் பாதுகாத்து, என்னைத் தப்புவியும்;","poem":1},{"text":"உம்மிடத்தில் தஞ்சமடைந்திருக்கும் என்னை","poem":2},{"lineBreak":true},{"text":"வெட்கப்பட விடாதேயும்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"உத்தமமும் நேர்மையும் என்னைப் பாதுகாக்கட்டும்;","poem":1},{"text":"ஏனெனில் என் எதிர்பார்ப்பு உம்மிலே இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"இறைவனே, இஸ்ரயேலை","poem":1},{"text":"அவர்களுடைய துன்பங்கள் எல்லாவற்றிலுமிருந்து மீட்டுக்கொள்ளும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}