{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":26,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என்னை நியாயப்படுத்திக் காட்டும்,","poem":1},{"text":"ஏனெனில் நான் உத்தமமாய் நடக்கிறேன்;","poem":2},{"text":"நான் யெகோவாவை நம்பியிருக்கிறேன்,","poem":1},{"text":"நான் தடுமாறுவதில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே, என்னைச் சோதியும், என்னைப் பரிசோதித்துப் பாரும்,","poem":1},{"text":"என் இருதயத்தையும் என் மனதையும் ஆராய்ந்து பாரும்;","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஏனெனில் உமது உடன்படிக்கையின் அன்பு","poem":1},{"text":"எப்பொழுதும் என் கண்களுக்கு முன்பாக இருக்கிறது;","poem":2},{"lineBreak":true},{"text":"நான் உமது சத்தியத்தின்படியே வாழ்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ஏமாற்றுகிறவர்களோடு நான் உட்காருவதில்லை,","poem":1},{"text":"வஞ்சகரிடத்தில் நான் சேருகிறதுமில்லை;","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தீமை செய்கிறவர்களின் கூட்டத்தை நான் அருவருக்கிறேன்,","poem":1},{"text":"கொடியவர்களுடன் உட்காரவும் மறுக்கிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவே, நான் குற்றமில்லாமை விளங்கும்படி என் கைகளைக் கழுவி,","poem":1},{"text":"உமது துதியைப் பிரசித்தப்படுத்தி,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உமது அதிசயமான செயல்களையெல்லாம் விவரித்துக்கொண்டு,","poem":1},{"text":"உமது பீடத்தைச் சுற்றிவருகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவே, உமது மகிமை குடியிருக்கும் இடமாகிய,","poem":1},{"text":"நீர் வாழும் ஆலயத்தை நான் நேசிக்கிறேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"பாவிகளோடு என் ஆத்துமாவையும்,","poem":1},{"text":"இரத்தப் பிரியரோடு என் உயிரையும் எடுத்துக் கொள்ளாதேயும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்களுடைய கைகளில் கொடுமையான சதித்திட்டங்களிருக்கின்றன;","poem":1},{"text":"அவர்களின் வலதுகைகள் இலஞ்சங்களால் நிறைந்திருக்கின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஆனால் நான் என் உத்தமத்திலே வாழ்வேன்;","poem":1},{"text":"என்னை மீட்டெடுத்து என்மீது இரக்கமாயிரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"என் பாதங்கள் நேர்மையான இடத்தில் நிற்கின்றன;","poem":1},{"text":"நான் யெகோவாவை மகா சபையில் துதிப்பேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}