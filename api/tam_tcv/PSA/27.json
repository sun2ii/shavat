{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":27,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா என் வெளிச்சமும் இரட்சிப்புமாயிருக்கிறார்,","poem":1},{"text":"நான் யாருக்குப் பயப்படுவேன்?","poem":2},{"text":"யெகோவா என் வாழ்க்கையின் அரணாய் இருக்கிறார்,","poem":1},{"text":"நான் யாருக்குப் பயப்படுவேன்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"தீய மனிதர் என்னை விழுங்கும்படி","poem":1},{"text":"எனக்கு விரோதமாக முன்னேறி வரும்போது,","poem":2},{"text":"எனது பகைவரும் விரோதிகளுமான","poem":1},{"text":"அவர்களே தடுமாறி விழுவார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஒரு இராணுவம் என்னை முற்றுகையிட்டாலும்,","poem":1},{"text":"என் இருதயம் பயப்படாது;","poem":2},{"text":"எனக்கு விரோதமாக யுத்தம் மூண்டாலும்,","poem":1},{"text":"அப்பொழுதுங்கூட நான் நம்பிக்கையோடே இருப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நான் யெகோவாவிடத்தில் ஒன்றைக் கேட்கிறேன்,","poem":1},{"text":"அதையே நான் தேடுகிறேன்:","poem":2},{"text":"நான் யெகோவாவின் அழகைக் காண்பதற்கும்,","poem":1},{"text":"அவருடைய ஆலயத்தில் அவரை தேடுவதற்கும்","poem":2},{"text":"நான் என் வாழ்நாள் முழுவதும்","poem":1},{"text":"யெகோவாவினுடைய வீட்டில் குடியிருப்பதையே வாஞ்சிக்கிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஏனெனில் துன்ப நாளில்,","poem":1},{"text":"அவர் என்னைத் தமது அடைக்கலத்தில் வைத்து காத்துக்கொள்ளுவார்;","poem":2},{"text":"அவர் என்னைத் தமது பரிசுத்த கூடார மறைவில் ஒளித்துவைத்து,","poem":1},{"text":"கற்பாறையின்மேல் என்னை உயர்த்துவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அப்பொழுது என் தலை என்னைச் சுற்றியுள்ள","poem":1},{"text":"பகைவர்களுக்கு மேலாக உயர்த்தப்படும்;","poem":2},{"text":"அவருடைய பரிசுத்த கூடாரத்திலே நான் ஆனந்த சத்தத்தோடு பலிகளையிட்டு,","poem":1},{"text":"யெகோவாவைப் புகழ்ந்து பாடுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே, நான் உம்மைக் கூப்பிடும்போது என் குரலைக் கேளும்;","poem":1},{"text":"என்னில் இரக்கமாயிருந்து, எனக்குப் பதில் தாரும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் இருதயம் உம்மிடத்தில், “அவர் முகத்தையே தேடு!” என்றதால்,","poem":1},{"text":"யெகோவாவே, உமது முகத்தையே நான் தேடுவேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"உமது முகத்தை என்னிடமிருந்து மறைத்துக் கொள்ளாதேயும்;","poem":1},{"text":"கோபங்கொண்டு உமது அடியேனைத் துரத்தி விடாதேயும்;","poem":2},{"lineBreak":true},{"text":"நீரே எனக்கு உதவியாய் இருந்திருக்கிறீர்.","poem":2},{"text":"என் இரட்சிப்பின் இறைவனே,","poem":1},{"text":"என்னைப் புறக்கணிக்கவோ, கைவிடவோ வேண்டாம்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என் தந்தையும் தாயும் என்னைக் கைவிட்டாலும்,","poem":1},{"text":"யெகோவா என்னை ஏற்றுக்கொள்வார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவாவே, உமது வழியை எனக்குப் போதியும்;","poem":1},{"text":"என்னைத் தீயநோக்கத்தோடு பார்த்துக் கொண்டிருப்பவர்களின் நிமித்தம்","poem":2},{"lineBreak":true},{"text":"என்னை நேரான பாதையில் நடத்தும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"என் பகைவரின் ஆசைகளுக்கு என்னை ஒப்புக்கொடாதேயும்;","poem":1},{"text":"ஏனெனில் பொய்ச்சாட்சி கூறுபவர்களும்","poem":2},{"lineBreak":true},{"text":"என்னை குற்றஞ்சாட்டுபவர்களும் எனக்கு விரோதமாய் எழும்புகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"நானோ வாழ்வோரின் நாட்டில்","poem":1},{"text":"யெகோவாவின் நன்மையைக் காண்பேன் என்று","poem":2},{"lineBreak":true},{"text":"இதில் நான் நம்பிக்கையாயிருக்கிறேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவாவுக்குக் காத்திரு;","poem":1},{"text":"பெலன்கொண்டு தைரியமாயிரு,","poem":2},{"lineBreak":true},{"text":"யெகோவாவுக்கே காத்திரு.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/27.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/28.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/26.json","previousChapterAudioLinks":{},"numberOfVerses":14}