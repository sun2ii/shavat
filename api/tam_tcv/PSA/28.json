{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":28,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நான் உம்மை நோக்கிக் கூப்பிடுகிறேன்;","poem":1},{"text":"நீர் என் கன்மலை,","poem":2},{"lineBreak":true},{"text":"எனக்கு செவிகொடாமல் இருக்கவேண்டாம்.","poem":2},{"text":"நீர் மவுனமாகவே இருப்பீரானால்,","poem":1},{"text":"நான் சவக்குழியில் கிடக்கிறவர்களைப் போலாவேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் உதவிக்காக உம்மை நோக்கிக் கூப்பிடும்போது,","poem":1},{"text":"நான் உமது மகா பரிசுத்த இடத்திற்கு நேராக,","poem":2},{"text":"என் கைகளை உயர்த்தி","poem":1},{"text":"இரக்கத்துக்காக நான் கதறுவதைக் கேளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"கொடியவர்களுடனும்","poem":1},{"text":"தீமை செய்பவர்களுடனும் என்னை இழுத்துக்கொள்ளாதேயும்,","poem":2},{"text":"அவர்கள் அயலவருடன் நட்பாகப் பேசுகிறார்கள்;","poem":1},{"text":"ஆனால் அவர்களுடைய இருதயங்களிலோ தீங்கை வைத்திருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்களுடைய செயல்களுக்காகவும்","poem":1},{"text":"அவர்கள் செய்த தீமைகளுக்காகவும் அவர்களுக்குப் பதில் செய்யும்;","poem":2},{"text":"அவர்களுடைய கைகளின் செயலுக்காக அவர்களுக்குப் பதில்செய்து,","poem":1},{"text":"அவர்களுக்குத் தக்க தண்டனையை அவர்கள்மீது கொண்டுவாரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவினுடைய செயல்களுக்கும்,","poem":1},{"text":"அவருடைய கரங்கள் செய்தவற்றுக்கும் அவர்கள் மதிப்புக் கொடாதபடியால்,","poem":2},{"text":"யெகோவா அவர்களை இடித்து வீழ்த்துவார்;","poem":1},{"text":"மீண்டும் அவர்களை ஒருபோதும் கட்டியெழுப்பமாட்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"யெகோவாவுக்குத் துதி உண்டாகட்டும்;","poem":1},{"text":"ஏனெனில் இரக்கத்துக்கான எனது கதறலை அவர் கேட்டிருக்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே என் பெலனும் என் கேடயமுமாயிருக்கிறார்;","poem":1},{"text":"என் இருதயம் அவரில் நம்பியிருக்கிறது, அவர் எனக்கு உதவி செய்கிறார்.","poem":2},{"text":"என் இருதயம் மகிழ்ச்சியினால் துள்ளுகிறது;","poem":1},{"text":"நான் அவருக்குப் பாட்டினால் துதிகளைச் செலுத்துவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவா தமது மக்களின் பெலனானவர்;","poem":1},{"text":"தாம் அபிஷேகித்தவருக்கு இரட்சிப்பின் கோட்டையும் அவரே.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இறைவனே உமது மக்களைக் காப்பாற்றி,","poem":1},{"text":"உமது உரிமைச்சொத்தான அவர்களை ஆசீர்வதியும்;","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய மேய்ப்பராயிருந்து அவர்களை என்றென்றும் தாங்கிக்கொள்ளும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}