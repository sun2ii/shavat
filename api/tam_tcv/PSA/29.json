{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":29,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"பரலோகவாசிகளே, யெகோவாவை கனம்பண்ணுங்கள்;","poem":1},{"text":"அவருடைய மகிமைக்காகவும் வல்லமைக்காகவும் யெகோவாவை கனம்பண்ணுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவினுடைய பெயருக்குரிய மகிமைக்காக கனம்பண்ணுங்கள்;","poem":1},{"text":"பரிசுத்த அலங்காரத்துடன் யெகோவாவை வழிபடுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவினுடைய குரல் வெள்ளத்தின்மேல் ஒலிக்கிறது;","poem":1},{"text":"மகிமையின் இறைவன் முழங்குகிறார்;","poem":2},{"lineBreak":true},{"text":"பெருவெள்ளத்தின்மேல் யெகோவா முழங்குகிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவாவினுடைய குரல் வல்லமையுள்ளது;","poem":1},{"text":"யெகோவாவினுடைய குரல் மாட்சிமை பொருந்தியது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவாவினுடைய குரல் கேதுரு மரங்களை உடைக்கிறது;","poem":1},{"text":"யெகோவா லெபனோனின் கேதுரு மரங்களைத் துண்டுகளாக உடைக்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் லெபனோனை ஒரு கன்றுக்குட்டியைப் போலவும்,","poem":1},{"text":"சிரியோன்","poem":2},{"noteId":4},{"text":"மலையை ஒரு இளம் காட்டெருதைப் போலவும் துள்ளப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவினுடைய குரல்","poem":1},{"text":"மின்னல் கீற்றுகளுடன் பளிச்சிடுகிறது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவாவினுடைய குரல் பாலைவனத்தை நடுங்கச் செய்கிறது;","poem":1},{"text":"காதேஷின் பாலைவனத்தை யெகோவா அதிரப்பண்ணுகிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவினுடைய குரல் கர்வாலி மரங்களை முறிக்கிறது.","poem":1},{"text":"காடுகளை அழித்து வெளியாக்குகிறது;","poem":2},{"text":"அவருடைய ஆலயத்திலோ அனைவரும், “மகிமை!” என அறிவிக்கிறார்கள்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவா வெள்ளத்தின்மேல் சிங்காசனத்தில் அமர்ந்திருக்கிறார்;","poem":1},{"text":"யெகோவா என்றென்றும் அரசனாக சிங்காசனத்தில் அமர்ந்திருக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவா தமது மக்களுக்குப் பெலன் கொடுக்கிறார்;","poem":1},{"text":"யெகோவா தமது மக்களை சமாதானத்தால் ஆசீர்வதிக்கிறார்.","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"அதாவது, எர்மோன் மலை","reference":{"chapter":29,"verse":6}}]},"thisChapterLink":"/api/tam_tcv/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}