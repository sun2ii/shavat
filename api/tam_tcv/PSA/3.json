{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":3,"content":[{"type":"hebrew_subtitle","content":["தாவீது தன் மகன் அப்சலோமிடமிருந்து தப்பி ஓடுகையில் பாடிய சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என் பகைவர்கள் எத்தனை பேராய் இருக்கிறார்கள்!","poem":1},{"text":"எத்தனைபேர் எனக்கு விரோதமாக எழும்புகிறார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அநேகர் என்னைக்குறித்து,","poem":1},{"text":"“இறைவன் அவனை விடுவிக்கமாட்டார்” என்று சொல்கிறார்கள்.","poem":2},{"noteId":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"ஆனால் யெகோவாவே, நீர் என்னைச் சுற்றிலும் கேடயமும்,","poem":1},{"text":"என் மகிமையும் என் தலையை உயர்த்துகிறவருமாய் இருக்கிறீர்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் சத்தமிட்டு யெகோவாவைக் கூப்பிடுகிறேன்;","poem":1},{"text":"அவர் தமது பரிசுத்த மலையிலிருந்து எனக்குப் பதில் கொடுக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நான் படுத்துக்கொண்டு உறங்குகிறேன்;","poem":1},{"text":"யெகோவா என்னைத் தாங்குவதால், நான் திரும்பவும் விழித்தெழுகிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"எல்லாப் பக்கங்களிலும் பதினாயிரம்பேர் எனக்கு விரோதமாய் நின்றாலும்,","poem":1},{"text":"நான் பயப்படமாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே, எழுந்தருளும்;","poem":1},{"text":"என் இறைவனே, என்னை விடுவியும்.","poem":2},{"text":"என் எதிரிகள் எல்லோரையும் கன்னத்தில் அடித்து,","poem":1},{"text":"கொடியவர்களின் பற்களை உடைத்துப்போடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவிடமிருந்தே விடுதலை வருகிறது.","poem":1},{"text":"உம்முடைய ஆசீர்வாதம் உமது மக்களின்மேல் இருப்பதாக.","poem":2}]}],"footnotes":[{"noteId":1,"caller":"+","text":"எபிரெய மொழிப் பிரதிகளில் சேலா என்ற வார்த்தை இங்கும் 4மற்றும் 8ஆவது வசனத்தின் பின் பகுதியிலும் வருகிறது.","reference":{"chapter":3,"verse":2}}]},"thisChapterLink":"/api/tam_tcv/PSA/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/2.json","previousChapterAudioLinks":{},"numberOfVerses":8}