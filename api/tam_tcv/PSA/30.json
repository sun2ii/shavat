{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":30,"content":[{"type":"hebrew_subtitle","content":["ஆலய பிரதிஷ்டையின் பாட்டாகிய தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உம்மை நான் புகழ்ந்து உயர்த்துவேன்,","poem":1},{"text":"ஏனெனில், ஆழங்களிலிருந்து நீர் என்னை வெளியே தூக்கியெடுத்தீர்;","poem":2},{"lineBreak":true},{"text":"என் பகைவர் என்னைப் பழித்து மகிழ நீர் இடமளிக்கவில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் இறைவனாகிய யெகோவாவே, உதவிவேண்டி உம்மை நோக்கிக் கூப்பிட்டேன்;","poem":1},{"text":"நீர் என்னை சுகமாக்கினீர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே, நீர் என்னைப் பாதாளத்திலிருந்து மேலே கொண்டுவந்தீர்;","poem":1},{"text":"குழிக்குள் போய்விடாமல் என்னைத் தப்புவித்தீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவினுடைய பரிசுத்தவான்களே, நீங்கள் அவருக்குத் துதி பாடுங்கள்;","poem":1},{"text":"அவருடைய பரிசுத்தத்தை நினைத்து நன்றி கூறுங்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவருடைய கோபம் ஒரு விநாடி மட்டுமே,","poem":1},{"text":"ஆனால் அவருடைய தயவோ வாழ்நாள் முழுவதும் நிலைத்திருக்கும்;","poem":2},{"text":"இரவிலே அழுகை இருந்தாலும்,","poem":1},{"text":"காலையிலோ மகிழ்ச்சி வரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நான் பாதுகாப்பாய் இருக்கிறேன் என எண்ணியபோது,","poem":1},{"text":"“நான் ஒருபோதும் அசைக்கப்படமாட்டேன்” என்று சொன்னேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே, நீர் எனக்குத் தயை காண்பித்தபோது,","poem":1},{"text":"என்னுடைய மலையை","poem":2},{"noteId":5},{"text":"உறுதியாய் நிற்கப்பண்ணினீர்;","poem":2},{"text":"ஆனால் நீர் உமது முகத்தை மறைத்துக்கொண்ட போது,","poem":1},{"text":"நான் மனம்சோர்ந்து போனேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவே, நான் உம்மையே நோக்கிக் கூப்பிட்டேன்;","poem":1},{"text":"யெகோவாவிடம் நான் இரக்கத்திற்காகக் கதறினேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“நான் அழிந்து","poem":1},{"text":"குழிக்குள் போவதால் என்ன பயன்?","poem":2},{"text":"தூசி உம்மைத் துதிக்குமோ?","poem":1},{"text":"அது உமது உண்மையை பிரசித்தப்படுத்துமோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"யெகோவாவே, எனக்குச் செவிகொடும்; என்மேல் இரக்கமாயிரும்.","poem":1},{"text":"யெகோவாவே, எனக்கு உதவியாயிரும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"என் கதறலை ஆனந்தக் களிப்பாய் மாற்றினீர்;","poem":1},{"text":"நீர் என்னுடைய துக்கவுடையைக் களைந்துவிட்டு,","poem":2},{"lineBreak":true},{"text":"மகிழ்ச்சியினால் என்னை உடுத்துவித்தீர்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆதலால் என் இருதயம் மவுனமாயிராமல், உமது துதியைப் பாடிக்கொண்டே இருக்கும்;","poem":1},{"text":"என் இறைவனாகிய யெகோவாவே, என்றென்றைக்கும் நான் உம்மைத் துதிப்பேன்.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"அதாவது, சீயோன் மலை","reference":{"chapter":30,"verse":7}}]},"thisChapterLink":"/api/tam_tcv/PSA/30.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/31.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/29.json","previousChapterAudioLinks":{},"numberOfVerses":12}