{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":31,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நான் உம்மிடத்தில் தஞ்சமடைந்திருக்கிறேன்;","poem":1},{"text":"என்னை ஒருபோதும் வெட்கமடைய விடாதேயும்;","poem":2},{"lineBreak":true},{"text":"உமது நீதியினிமித்தம் என்னை விடுவியும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உமது செவியை எனக்குச் சாய்த்து,","poem":1},{"text":"என்னைத் தப்புவிக்க விரைவாய் வாரும்;","poem":2},{"text":"என் புகலிடமான கன்மலையாகவும்,","poem":1},{"text":"என்னைக் காப்பாற்றும் பலமான கோட்டையாகவும் இரும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீர் என் கன்மலையும் என் கோட்டையுமாயிருப்பதால்,","poem":1},{"text":"உமது பெயரின் நிமித்தம் எனக்கு வழிகாட்டி என்னை வழிநடத்தும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீரே என் புகலிடம்,","poem":1},{"text":"ஆகையால் எனக்காக வைக்கப்பட்டிருக்கும் கண்ணியிலிருந்து என்னை விடுவியும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உமது கைகளில் என் ஆவியை ஒப்புக்கொடுக்கிறேன்;","poem":1},{"text":"யெகோவாவே, என் உண்மையின் இறைவனே, என்னை மீட்டுக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"இறைவனல்லாதவைகளைப் பற்றிக்கொள்கிறவர்களை நான் வெறுக்கிறேன்;","poem":1},{"text":"நான் யெகோவாவிடம் நம்பிக்கையாய் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் உமது அன்பில் மகிழ்ந்து களிகூருவேன்;","poem":1},{"text":"ஏனெனில், நீர் என் வேதனையைக் கண்டு,","poem":2},{"lineBreak":true},{"text":"என் ஆத்தும துயரத்தை அறிந்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீர் என்னை என் பகைவனிடத்தில் ஒப்புக்கொடாமல்,","poem":1},{"text":"விசாலமான இடத்தில் என் பாதங்களை நிறுத்தினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, நான் துன்பத்தில் இருப்பதால், என்னில் இரக்கமாயிரும்;","poem":1},{"text":"துக்கத்தினால் என் கண்கள் பலவீனமடைகின்றன;","poem":2},{"lineBreak":true},{"text":"துயரத்தினால் என் ஆத்துமாவும் உடலும் பெலனில்லாமல் போகின்றன.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என் வாழ்க்கை வேதனையிலேயே கழிந்துபோயிற்று;","poem":1},{"text":"அழுது புலம்பியே என் வருடங்களும் கடந்துபோயிற்று.","poem":2},{"text":"என் துன்பத்தினால்","poem":1},{"noteId":6},{"text":"என் பெலம் குன்றி,","poem":1},{"text":"என் எலும்புகளும் பெலனற்றுப் போகின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் பகைவர்கள் அனைவரின் நிமித்தம்","poem":1},{"text":"நான் என் அயலாருக்கு நிந்தையாகிறேன்;","poem":2},{"text":"என் நண்பர்களுக்கு நான் பயங்கரமானேன்;","poem":1},{"text":"தெருவில் என்னைக் காண்பவர்கள் என்னைவிட்டு விலகி ஓடிப்போனார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நான் இறந்துவிட்ட ஒருவனைப் போல, அவர்கள் என்னை மறந்துபோனார்கள்;","poem":1},{"text":"நான் ஓர் உடைந்த பாத்திரத்தைப் போலானேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அநேகர் என்னை அவதூறாய்ப் பேசுகிறதைக் கேட்கிறேன்,","poem":1},{"text":"“எல்லாப் பக்கங்களிலும் பயங்கரம் இருக்கிறது!”","poem":2},{"text":"அவர்கள் எனக்கு விரோதமாக சூழ்ச்சிசெய்து,","poem":1},{"text":"என் உயிரை வாங்க சதித்திட்டம் போடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஆனாலும் யெகோவாவே, நான் உம்மிலேயே நம்பிக்கையாய் இருக்கிறேன்;","poem":1},{"text":"“நீரே என் இறைவன்” என்று நான் சொன்னேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என் நாட்கள் உமது கரங்களில் இருக்கிறது;","poem":1},{"text":"என் பகைவரிடமிருந்தும்","poem":2},{"lineBreak":true},{"text":"என்னைத் துரத்துகிறவரிடமிருந்தும் விடுவியும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"உமது அடியேன்மேல் உமது முகத்தைப் பிரகாசிக்கச் செய்யும்;","poem":1},{"text":"உமது உடன்படிக்கையின் அன்பினால் என்னைக் காப்பாற்றும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"யெகோவாவே, என்னை வெட்கப்பட விடாதேயும்;","poem":1},{"text":"நான் உம்மை நோக்கிக் கூப்பிட்டேன்;","poem":2},{"text":"கொடியவர்கள் வெட்கப்பட்டு பாதாளத்தில்","poem":1},{"text":"மவுனமாய்க் கிடக்கட்டும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"பெருமையோடும் அகந்தையோடும்,","poem":1},{"text":"நீதிமான்களுக்கு விரோதமாய்ப் பேசும்","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய பொய் உதடுகள் ஊமையாகட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"உமக்குப் பயப்படுகிறவர்களுக்காக","poem":1},{"text":"நீர் குவித்து வைத்திருக்கும் நன்மைகள் எவ்வளவு பெரிதாயிருக்கின்றன;","poem":2},{"text":"உம்மிடத்தில் தஞ்சம் அடைகிறவர்கள்மேல்,","poem":1},{"text":"மனிதர் காணும்படியாக நீர் பொழிகின்ற நன்மைகள் எவ்வளவு பெரிதாயிருக்கின்றன.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நீர் அவர்களை மனிதரின் சூழ்ச்சிகளிலிருந்து விலக்கி,","poem":1},{"text":"உமது சமுகத்தின் அடைக்கலத்தில் மறைத்துவைக்கிறீர்;","poem":2},{"text":"அவர்களைக் குற்றப்படுத்தும் நாவுகளுக்கு விலக்கி,","poem":1},{"text":"உமது தங்குமிடத்தில் அவர்களை ஒளித்துவைக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"யெகோவாவுக்குத் துதி உண்டாவதாக,","poem":1},{"text":"ஏனெனில் பட்டணம் முற்றுகையிடப்பட்டு நான் சிக்கலில் இருந்தபோது,","poem":2},{"lineBreak":true},{"text":"அவர் தமது உடன்படிக்கை அன்பின் அதிசயத்தை எனக்குக் காண்பித்தார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நான் அதிர்ச்சியடைந்து,","poem":1},{"text":"“உமது பார்வையிலிருந்து அகற்றப்பட்டேன்” என்று சொன்னேன்;","poem":2},{"text":"ஆனாலும் நான் உதவிவேண்டி உம்மை நோக்கிக் கூப்பிட்டபோது,","poem":1},{"text":"இரக்கத்திற்காக நான் கதறி அழுததை நீர் கேட்டீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"யெகோவாவினுடைய பரிசுத்தவான்களே, அவரில் அன்புகூருங்கள்!","poem":1},{"text":"யெகோவா அவருக்கு உண்மையாய் இருப்பவர்களைப் பாதுகாக்கிறார்;","poem":2},{"lineBreak":true},{"text":"ஆனால் பெருமையுள்ளவர்களுக்குப் பூரணமாய்ப் பதிலளிப்பார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"யெகோவாவை நம்பிக் காத்திருப்பவர்களே,","poem":1},{"text":"நீங்கள் எல்லோரும் பெலன்கொண்டு தைரியமாய் இருங்கள்.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"துன்பத்தினால் அல்லது குற்றம்","reference":{"chapter":31,"verse":10}}]},"thisChapterLink":"/api/tam_tcv/PSA/31.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/32.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/30.json","previousChapterAudioLinks":{},"numberOfVerses":24}