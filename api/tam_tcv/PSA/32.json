{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":32,"content":[{"type":"hebrew_subtitle","content":["மஸ்கீல் என்னும் தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யாருடைய மீறுதல்கள் மன்னிக்கப்பட்டதோ,","poem":1},{"text":"யாருடைய பாவங்கள் மூடப்பட்டதோ,","poem":2},{"lineBreak":true},{"text":"அவர்கள் பாக்கியவான்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யாருடைய பாவத்தைக்குறித்து,","poem":1},{"text":"அவர்களுக்கு விரோதமாக யெகோவா கணக்கிடாதிருக்கிறாரோ,","poem":2},{"lineBreak":true},{"text":"யாருடைய ஆவியில் வஞ்சனை இல்லாதிருக்கிறதோ, அவர்கள் பாக்கியவான்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நான் என் பாவத்தைக்குறித்து மவுனமாய் இருந்தபோது,","poem":1},{"text":"தினமும் என் அழுகையினால்,","poem":2},{"lineBreak":true},{"text":"என் எலும்புகள் பலவீனமாயிற்று.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இரவும் பகலும்","poem":1},{"text":"உமது கரம் பாரமாயிருந்தது;","poem":2},{"text":"ஆதலால், கோடைகால வெப்பத்தினால் ஈரம் வறண்டுபோகிறது போல,","poem":1},{"text":"என் பெலன் வறண்டுபோயிற்று.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அதின்பின் நான் என் பாவத்தை","poem":1},{"text":"உம்மிடத்தில் ஒத்துக்கொண்டேன்;","poem":2},{"text":"என் அநியாயத்தையும் நான் மறைக்கவில்லை.","poem":1},{"text":"நான், “யெகோவாவிடம் என் மீறுதல்களை அறிக்கையிடுவேன்”","poem":2},{"text":"என்று சொன்னேன்;","poem":1},{"text":"நீர் என் பாவத்தின் குற்றத்தை மன்னித்தீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"ஆகவே பக்தியுள்ள ஒவ்வொருவரும் உம்மைக் காணத்தக்க காலத்தில்","poem":1},{"text":"உம்மை நோக்கி மன்றாடட்டும்;","poem":2},{"text":"பெருவெள்ளம் எழும்பும்போது","poem":1},{"text":"நிச்சயமாய் அது அவர்களை அணுகாது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நீர் என் மறைவிடமாயிருக்கிறீர்;","poem":1},{"text":"நீர் என்னை இக்கட்டிலிருந்து பாதுகாத்து,","poem":2},{"lineBreak":true},{"text":"மீட்பின் பாடல்களால் என்னைச் சூழ்ந்துகொள்வீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவா சொல்கிறதாவது: “நான் உனக்கு அறிவுறுத்தி,","poem":1},{"text":"நீ போகவேண்டிய வழியை உனக்குப் போதிப்பேன்;","poem":2},{"lineBreak":true},{"text":"நான் உனக்கு கரிசனையோடு ஆலோசனை சொல்லுவேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"புத்தியில்லாத குதிரையைப் போலவோ,","poem":1},{"text":"கோவேறு கழுதையைப் போலவோ நீ இருக்கவேண்டாம்;","poem":2},{"text":"கடிவாளத்தினால் கட்டுப்படுத்தப்பட்டால் ஒழிய,","poem":1},{"text":"அவை உன் கட்டுப்பாட்டின்கீழ் வருவதில்லை.”","poem":2}]},{"type":"verse","number":10,"content":[{"text":"கொடுமையானவனுக்கு வரும் கேடுகள் அநேகமானவை,","poem":1},{"text":"ஆனால் யெகோவாவிடம் நம்பிக்கையாய் இருக்கிறவனையோ,","poem":2},{"lineBreak":true},{"text":"அவருடைய உடன்படிக்கையின் அன்பு சூழ்ந்துகொள்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"நீதிமான்களே, நீங்கள் யெகோவாவிடம் களிகூர்ந்து மகிழுங்கள்;","poem":1},{"text":"உள்ளத்தில் உண்மையுள்ளவர்களே, நீங்கள் அனைவரும் துதி பாடுங்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}