{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":33,"content":[{"type":"verse","number":1,"content":[{"text":"நீதிமான்களே, நீங்கள் மகிழ்ச்சியுடன் யெகோவாவுக்குத் துதி பாடுங்கள்;","poem":1},{"text":"அவரைத் துதிப்பது நேர்மையுள்ளவர்களுக்குத் தகுதியானது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யாழ் இசைத்து யெகோவாவைத் துதியுங்கள்;","poem":1},{"text":"பத்து நரம்பு வீணையினால் அவருக்கு இசை பாடுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவருக்குப் புதுப்பாட்டைப் பாடுங்கள்;","poem":1},{"text":"திறமையாக இசைத்து மகிழ்ச்சியுடன் ஆர்ப்பரியுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவினுடைய வார்த்தை சத்தியமும்,","poem":1},{"text":"அவருடைய செயல்களெல்லாம் உண்மையானதுமாய் இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவா நீதியையும் நியாயத்தையும் விரும்புகிறார்;","poem":1},{"text":"பூமி முழுவதுமே அவருடைய உடன்படிக்கையின் அன்பினால் நிறைந்திருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"யெகோவாவினுடைய வார்த்தையினாலே வானங்கள் படைக்கப்பட்டன,","poem":1},{"text":"அவருடைய வாயின் சுவாசத்தினால் வான்கோள்கள் யாவும் படைக்கப்பட்டன.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் கடல்நீரைச் ஜாடிகளில் சேர்த்துவைக்கிறார்;","poem":1},{"text":"ஆழத்தை களஞ்சியங்களில் வைக்கிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பூமி அனைத்தும் யெகோவாவுக்குப் பயப்படுவதாக;","poem":1},{"text":"உலகின் மக்கள் அனைவரும் அவரிடம் பயபக்தியாய் இருப்பார்களாக.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏனெனில் அவர் சொல்ல, உலகம் உண்டாயிற்று;","poem":1},{"text":"அவர் கட்டளையிட்டார், அது உறுதியாய் நின்றது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவா நாடுகளின் திட்டங்களை முறியடிக்கிறார்;","poem":1},{"text":"அவர் மக்களின் நோக்கங்களைத் தடுக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஆனால் யெகோவாவின் ஆலோசனை என்றென்றும் உறுதியாகவும்,","poem":1},{"text":"அவருடைய இருதயத்தின் நோக்கங்கள் தலைமுறை தலைமுறையாகவும் நிலைநிற்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"எந்த மக்கள் யெகோவாவைத் தங்கள் இறைவனாகக் கொண்டிருக்கிறார்களோ,","poem":1},{"text":"எந்த மக்களை அவர் தமது உரிமைச்சொத்தாகத் தெரிந்துகொண்டாரோ","poem":2},{"lineBreak":true},{"text":"அவர்கள் பாக்கியவான்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவா பரலோகத்திலிருந்து கீழே நோக்கிப்பார்த்து,","poem":1},{"text":"எல்லா மனிதர்களையும் காண்கிறார்;","poem":2}]},{"type":"verse","number":14,"content":[{"text":"தமது சிங்காசனத்திலிருந்து பூமியில் வாழும்","poem":1},{"text":"அனைவரையும் கவனிக்கிறார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அனைவருடைய இருதயங்களையும் உருவாக்கும் யெகோவா,","poem":1},{"text":"அவர்கள் செய்யும் எல்லாவற்றையும் கவனிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"எந்த ஒரு அரசனும் தனது படைபலத்தால் காப்பாற்றப்படுவதில்லை;","poem":1},{"text":"எந்த ஒரு போர்வீரனும் தனது மிகுந்த வலிமையினால் தப்புவதுமில்லை.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"விடுதலை பெறுவதற்கு குதிரையை நம்புவது வீண்;","poem":1},{"text":"அதற்கு மிகுந்த வலிமை இருந்தபோதிலும், அதினால் காப்பாற்ற முடியாது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"யெகோவாவுக்குப் பயந்து,","poem":1},{"text":"அவருடைய உடன்படிக்கையின் அன்பில் நம்பிக்கையாய் இருக்கிறவர்கள்மேல்","poem":2},{"lineBreak":true},{"text":"அவருடைய கண்கள் நோக்கமாயிருந்து,","poem":2}]},{"type":"verse","number":19,"content":[{"text":"மரணத்திலிருந்து அவர்களை விடுவிக்கிறார்,","poem":1},{"text":"பஞ்சத்தில் அவர்களை உயிரோடே காக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"நாங்கள் யெகோவாவுக்காக எதிர்பார்த்துக் காத்திருக்கிறோம்;","poem":1},{"text":"அவரே எங்களுக்கு உதவியும் எங்கள் கேடயமுமாய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"நாங்கள் அவருடைய பரிசுத்த பெயரில் நம்பிக்கையாய் இருப்பதால்","poem":1},{"text":"எங்கள் இருதயங்கள் அவரில் மகிழ்கின்றன.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"யெகோவாவே, நாங்கள் உம்மை நம்பியிருக்கிறபடியே,","poem":1},{"text":"உமது உடன்படிக்கையின் அன்பு எங்கள்மேல் இருப்பதாக.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/33.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/34.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/32.json","previousChapterAudioLinks":{},"numberOfVerses":22}