{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":34,"content":[{"type":"hebrew_subtitle","content":["தாவீது அபிமெலேக்கின் முன்பு பைத்தியம்போல் நடித்து, அவனால் துரத்திவிடப்படும்போது பாடின சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவை நான் எவ்வேளையிலும் புகழ்ந்து உயர்த்துவேன்;","poem":1},{"text":"அவருக்குரிய துதி எப்பொழுதும் என் உதடுகளில் இருக்கும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் யெகோவாவுக்குள் மகிமைப்படுவேன்;","poem":1},{"text":"ஒடுக்கப்பட்டோர் இதைக் கேட்டு மகிழட்டும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என்னோடு சேர்ந்து யெகோவாவை மகிமைப்படுத்துங்கள்;","poem":1},{"text":"நாம் ஒன்றுகூடி அவருடைய பெயரைப் புகழ்ந்து உயர்த்துவோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நான் யெகோவாவிடம் உதவி தேடினேன்; அவர் எனக்குப் பதில் தந்தார்;","poem":1},{"text":"அவர் என்னுடைய எல்லாப் பயத்திலிருந்தும் என்னை விடுவித்தார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவரை நோக்கிப் பார்க்கிறவர்கள் பிரகாசமாய் இருக்கிறார்கள்;","poem":1},{"text":"அவர்களுடைய முகங்கள் ஒருபோதும் வெட்கப்படுவதில்லை.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இந்த ஏழை கூப்பிட்டான், யெகோவா செவிகொடுத்து;","poem":1},{"text":"அவனை அவனுடைய எல்லாப் பிரச்சனைகளிலிருந்தும் காப்பாற்றினார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவருக்குப் பயந்து நடக்கிறவர்களைச் சுற்றிலும்","poem":1},{"text":"யெகோவாவின் தூதன் முகாமிட்டு அவர்களை விடுவிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவா நல்லவர் என்பதை ருசித்துப்பாருங்கள்;","poem":1},{"text":"அவரிடத்தில் தஞ்சமடைகிறவர்கள் ஆசீர்வதிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவினுடைய பரிசுத்தவான்களே, நீங்கள் அவருக்குப் பயந்து நடங்கள்;","poem":1},{"text":"ஏனெனில் அவருக்குப் பயந்து நடப்பவர்களுக்கு எவ்விதக் குறைவும் ஏற்படுவதில்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இளம் சிங்கங்கள் பெலமிழந்து பசியாயிருக்கலாம்;","poem":1},{"text":"ஆனால் யெகோவாவைத் தேடுகிறவர்களுக்கோ ஒரு நன்மையும் குறைவுபடுவதில்லை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் பிள்ளைகளே, வாருங்கள்; வந்து எனக்குச் செவிகொடுங்கள்;","poem":1},{"text":"யெகோவாவுக்குப் பயந்து நடப்பதைக் குறித்து நான் உங்களுக்குப் போதிப்பேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உங்களில் யாராவது வாழ்வை நேசித்து","poem":1},{"text":"அநேக நல்ல நாட்களைக் காண விரும்பினால்,","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீங்கள் உங்கள் நாவை தீமையைப் பேசுவதிலிருந்து விலக்கி,","poem":1},{"text":"உங்கள் உதடுகளைப் பொய்ப் பேசுவதிலிருந்து காத்துக்கொள்ளுங்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"தீமையைவிட்டு விலகி, நன்மையைச் செய்யுங்கள்;","poem":1},{"text":"சமாதானத்தைத் தேடி, அதைப் பின்தொடருங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"யெகோவாவினுடைய கண்கள் நீதிமான்கள்மேல் இருக்கின்றன;","poem":1},{"text":"அவருடைய காதுகள் அவர்களுடைய கதறுதலைக் கவனமாய்க் கேட்கின்றன;","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆனால் தீமை செய்கிறவர்களைப் பற்றிய நினைவை","poem":1},{"text":"பூமியிலிருந்தே அகற்றிப்போடும்படி,","poem":2},{"lineBreak":true},{"text":"யெகோவாவினுடைய முகம் அவர்களுக்கு விரோதமாய் இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நீதிமான்கள் கூப்பிடும்போது, யெகோவா அவர்களுக்குச் செவிகொடுக்கிறார்;","poem":1},{"text":"அவர் அவர்களுடைய எல்லாத் துன்பங்களிலுமிருந்தும் அவர்களை விடுவிக்கிறார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"யெகோவா உள்ளம் உடைந்து போனவர்களுக்கு அருகே இருக்கிறார்;","poem":1},{"text":"ஆவியில் நொந்து இருக்கிறவர்களை யெகோவா காப்பாற்றுகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"நீதிமானுக்கு அநேக துன்பங்கள் வரலாம்,","poem":1},{"text":"ஆனாலும் அவை எல்லாவற்றிலிருந்தும் யெகோவா அவனை விடுவிக்கிறார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர் அவனுடைய எலும்புகளையெல்லாம் பாதுகாக்கிறார்;","poem":1},{"text":"அவற்றில் ஒன்றுகூட முறிக்கப்படாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"தீமை கொடியவர்களைக் கொல்லும்;","poem":1},{"text":"நீதிமான்களின் பகைவர்கள் குற்றவாளிகளாவார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"யெகோவா தமது பணியாட்களைக் காப்பாற்றுகிறார்;","poem":1},{"text":"அவரிடத்தில் தஞ்சம் அடைகிற யாரும் குற்றவாளியாகத் தீர்க்கப்படமாட்டான்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/34.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/35.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/33.json","previousChapterAudioLinks":{},"numberOfVerses":22}