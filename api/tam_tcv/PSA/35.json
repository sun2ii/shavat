{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":35,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என்னோடு வழக்காடுகிறவர்களோடு வழக்காடி,","poem":1},{"text":"என்னோடு போராடுகிறவர்களுடன் நீர் போராடும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"கேடயத்தையும் கவசத்தையும் எடுத்துக்கொள்ளும்;","poem":1},{"text":"எனக்கு உதவிசெய்ய எழுந்து வாரும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என்னைத் துரத்துகிறவர்களுக்கு எதிராக ஈட்டியையும்","poem":1},{"text":"எறிவேலையும் நீட்டி இப்படி சொல்லும்:","poem":2},{"text":"நீர் என் ஆத்துமாவுக்கு,","poem":1},{"text":"“நானே உனது இரட்சிப்பு.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"எனது உயிரை வாங்கத் தேடுகிறவர்கள்","poem":1},{"text":"அவமானம் அடைந்து வெட்கப்படுவார்களாக;","poem":2},{"text":"என்னை அழிக்கச் சதிசெய்கிறவர்கள்","poem":1},{"text":"மனம் தளர்ந்து பின்வாங்கிப் போவார்களாக.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவாவினுடைய தூதன் அவர்களைத் துரத்துவதால்","poem":1},{"text":"காற்றிலே பறந்து போகிற பதரைப்போல் இருப்பார்களாக;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவினுடைய தூதன் அவர்களைப் பின்தொடர்வதால்,","poem":1},{"text":"அவர்களுடைய பாதை இருளாகவும், சறுக்குகிறதாகவும் இருப்பதாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"காரணமின்றி அவர்கள் எனக்காக வலையை மறைத்து வைத்திருப்பதனாலும்,","poem":1},{"text":"காரணமின்றி அவர்கள் எனக்காக குழிதோண்டி இருப்பதனாலும்,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அழிவு திடீரென அவர்கள்மேல் வருவதாக;","poem":1},{"text":"அவர்கள் மறைத்துவைத்த வலை அவர்களையே சிக்கவைப்பதாக;","poem":2},{"lineBreak":true},{"text":"அந்தக் குழிக்குள் அவர்களே விழுந்து அழிந்துபோவார்களாக.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அப்பொழுது என் ஆத்துமா யெகோவாவிடம் சந்தோஷப்பட்டு,","poem":1},{"text":"அவருடைய இரட்சிப்பில் மகிழ்ச்சியடையும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“யெகோவாவே, உம்மைப்போல் யாருண்டு?","poem":1},{"text":"நீர் ஏழைகளை ஒடுக்குகிற வலிமையானவர்களிடம் இருந்தும்,","poem":2},{"text":"ஏழைகளையும் குறைவுள்ளோரையும் கொள்ளையிடுகிறவர்களிடம் இருந்தும் விடுவிக்கிறீர்”","poem":1},{"text":"என்று என் முழு உள்ளமும் வியப்புடன் சொல்லும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"இரக்கமற்ற சாட்சிகள் முன்வருகிறார்கள்;","poem":1},{"text":"எனக்குத் தெரியாதவைகளை அவர்கள் என்னிடத்தில் கேட்கிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நன்மைக்குப் பதிலாய் அவர்கள் எனக்குத் தீமை செய்து,","poem":1},{"text":"என்னை உதவியின்றி விட்டுவிடுகிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆனாலும் அவர்கள் வியாதியாய் இருந்தபோதோ,","poem":1},{"text":"நான் துக்கவுடை உடுத்தி உபவாசத்துடன் என்னைத் தாழ்த்தினேன்.","poem":2},{"text":"எனது மன்றாட்டுகள் பதிலளிக்கப்படாமல் என்னிடமே திரும்பிவந்தபோது,","poem":1}]},{"type":"verse","number":14,"content":[{"text":"எனது நண்பர்களைப்போலவும் சகோதரரைப் போலவும்","poem":2},{"lineBreak":true},{"text":"நான் அவர்களுக்காக துக்கித்தேன்;","poem":2},{"text":"என் தாய்க்காக அழுகிறது போல,","poem":1},{"text":"துக்கத்தில் என் தலையை குனிந்து கொண்டேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆனால் நான் இடறியபோதோ, அவர்கள் ஒன்றுகூடி மகிழ்கிறார்கள்;","poem":1},{"text":"நான் எதிர்பாராத வேளையில் தாக்குகிறவர்கள், எனக்கெதிராய் ஒன்றுகூடி,","poem":2},{"lineBreak":true},{"text":"ஓய்வின்றி என்னை நிந்தித்தார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர்கள் இறை பக்தியற்றவர்களோடு சேர்ந்து பரியாசம் செய்து,","poem":1},{"text":"என்னைப் பார்த்து பற்களைக் கடித்தார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"யெகோவாவே, எதுவரையிலும் இதைப் பார்த்துக் கொண்டிருப்பீர்?","poem":1},{"text":"அவர்கள் செய்யும் அழிவுகளிலிருந்து என்னையும்","poem":2},{"lineBreak":true},{"text":"சிங்கங்களிடமிருந்து விலையுயர்ந்த என் உயிரையும் தப்புவியும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அப்பொழுது மகா சபையிலே நான் உமக்கு நன்றி செலுத்துவேன்;","poem":1},{"text":"மக்கள் கூட்டங்களின் மத்தியில் நான் உம்மைத் துதிப்பேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"காரணமின்றி என்னைப் பகைக்கிறவர்கள்","poem":1},{"text":"என்னைப் பழித்து மகிழாமலும்,","poem":2},{"text":"காரணமின்றி என்னை வெறுக்கிறவர்கள்","poem":1},{"text":"தவறான நோக்கத்தோடு கண் சிமிட்டாமலும் இருக்கட்டும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அவர்கள் சமாதானமாய்ப் பேசுவதில்லை;","poem":1},{"text":"நாட்டில் அமைதியாய் வாழ்கிறவர்களுக்கு எதிராய்","poem":2},{"lineBreak":true},{"text":"வஞ்சகமாய்த் திட்டமிடுகிறார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர்கள் தங்கள் வாயை விரிவாய்த் திறந்து சொல்கிறதாவது:","poem":1},{"text":"“ஆ! ஆ! எங்கள் கண்களாலேயே நாங்கள் இதைக் கண்டிருக்கிறோம்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"யெகோவாவே, நீர் இதைக் கண்டிருக்கிறீர்; மவுனமாயிராதேயும்.","poem":1},{"text":"யெகோவாவே, என்னைவிட்டுத் தூரமாயிராதேயும்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"விழித்தெழும், எழுந்து எனக்காக வழக்காடும்;","poem":1},{"text":"என் இறைவனே, யெகோவாவே, எனக்காகப் போராடும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"என் இறைவனாகிய யெகோவாவே, உமது நீதியின் நிமித்தம்","poem":1},{"text":"என்னை நியாயம் விசாரியும்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் என்னைப் பழித்து மகிழவிடாதேயும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"“ஆ! நாங்கள் விரும்பியதே நடந்துவிட்டது!”","poem":1},{"text":"என்று அவர்கள் சிந்திக்க விடாதேயும் அல்லது","poem":2},{"lineBreak":true},{"text":"“நாங்கள் அவனை விழுங்கிவிட்டோம்” என்று அவர்கள் சொல்லவிடாதேயும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":26,"content":[{"text":"என் துன்பத்தைக் குறித்து என்னைப் பழித்து மகிழ்கிறவர்கள் எல்லோரும்","poem":1},{"text":"வெட்கமடைந்து கலங்குவார்களாக;","poem":2},{"text":"எனக்கு மேலாகத் தங்களை உயர்த்துகிறவர்கள் எல்லோரும் வெட்கத்தாலும்","poem":1},{"text":"அவமானத்தாலும் மூடப்படுவார்களாக.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"என் நீதி நிலைநிறுத்தப்படுவதை விரும்புகிறவர்கள்,","poem":1},{"text":"சந்தோஷத்தினாலும் மகிழ்ச்சியினாலும் ஆர்ப்பரிப்பார்களாக.","poem":2},{"text":"“தனது பணியாளனின் நலனை விரும்புகிற யெகோவா உயர்த்தப்படுவாராக”","poem":1},{"text":"என்று அவர்கள் எப்பொழுதும் சொல்லட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"எனது நாவு உமது நீதியை அறிவிக்கும்,","poem":1},{"text":"நாள்முழுவதும் உம்மைத் துதிக்கும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/35.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/36.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/34.json","previousChapterAudioLinks":{},"numberOfVerses":28}