{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":36,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட யெகோவாவினுடைய ஊழியனாகிய தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனிடமிருந்து என் உள்ளத்திற்கு வந்த செய்தி:","poem":1},{"text":"கொடியவர்களின் பாவம் அவர்களுடைய இருதயங்களில் நிலைத்திருக்கிறது;","poem":2},{"text":"அவர்களுடைய கண்களில்","poem":1},{"text":"இறைவனைப்பற்றிய பயம் இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அவர்கள் பார்வையில் தங்களைப் பெருமையாக காணுவதால்,","poem":1},{"text":"அவர்கள் தங்களுடைய பாவத்தை உணர்வதும் இல்லை; அதை வெறுப்பதுமில்லை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்களுடைய வாயின் வார்த்தைகள் கொடுமையும் வஞ்சகமுமாய் இருக்கின்றன;","poem":1},{"text":"அவர்கள் ஞானமாய் நடந்துகொள்வதையும் நன்மை செய்வதையும் நிறுத்திவிட்டார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் தனது படுக்கையிலும் தீமையைச் சிந்திக்கிறார்கள்;","poem":1},{"text":"பாவவழிக்கு அவர்கள் தங்களை ஒப்புவிக்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"தீமையானதை விடாதிருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, உமது உடன்படிக்கையின் அன்பு வானங்களையும்","poem":1},{"text":"உமது உண்மை மேகங்களையும் எட்டுகிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உமது நீதி விசாலமான மலைகளைப் போன்றது,","poem":1},{"text":"உமது நியாயம் மகா ஆழத்தைப் போன்றது.","poem":2},{"lineBreak":true},{"text":"யெகோவாவே, நீரே மனிதனையும் மிருகங்களையும் காப்பாற்றுகிறீர்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இறைவனே, உமது உடன்படிக்கையின் அன்பு எவ்வளவு அருமையானது!","poem":1},{"text":"மனிதர்கள் உமது சிறகின் நிழலிலே தஞ்சம் அடைகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"உமது வீட்டின் செழிப்பினால் அவர்கள் நிறைவு பெருகிறார்கள்;","poem":1},{"text":"நீர் உமது மகிழ்ச்சியின் நதியிலிருந்து அவர்களுக்குக் குடிக்கக் கொடுக்கிறீர்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏனெனில், வாழ்வின் ஊற்று உம்மிடத்திலேயே இருக்கிறது;","poem":1},{"text":"உமது ஒளியில் நாங்கள் வெளிச்சம் காண்கிறோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"உம்மை அறிந்தவர்களுக்கு உமது உடன்படிக்கையின் அன்பையும்","poem":1},{"text":"இருதயத்தில் நீதிமான்களுக்கு உமது நியாயத்தையும் வழங்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அகந்தை உள்ளவர்களின் கால் எனக்கு விரோதமாய் வராதிருப்பதாக;","poem":1},{"text":"கொடியவர்களின் கை என்னைத் துரத்தி விடாதிருப்பதாக.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"தீமை செய்கிறவர்கள் எப்படி விழுந்து கிடக்கிறார்கள் என்று பாரும்!","poem":1},{"text":"அவர்கள் எழுந்திருக்க முடியாதபடி, வீசி எறியப்பட்டுக் கிடக்கிறார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":12}