{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":37,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"தீயவர்களைக் குறித்து பதற்றமடையாதே;","poem":1},{"text":"அநியாயம் செய்பவர்கள்மேல் பொறாமை கொள்ளாதே.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஏனெனில் அவர்கள் புல்லைப்போல் விரைவாய் உலர்ந்து போவார்கள்;","poem":1},{"text":"பச்சைத் தாவரத்தைப்போல் விரைவில் வாடிப்போவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவிடம் நம்பிக்கையாயிருந்து நன்மைசெய்;","poem":1},{"text":"நாட்டில் குடியிருந்து, பாதுகாப்பாய் மேய்ச்சலில் மகிழ்ந்திரு.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவாவிடம் மனமகிழ்ச்சியாயிரு,","poem":1},{"text":"அப்பொழுது அவர் உன் இருதயத்தின் வாஞ்சைகளை உனக்குத் தருவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவிடம் உன் வழியை ஒப்புவி;","poem":1},{"text":"அவரில் நம்பிக்கையாயிரு, அப்பொழுது அவர் உனக்காக இவைகளைச் செய்வார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் உன் நீதியை காலை வெளிச்சத்தைப் போலவும்,","poem":1},{"text":"உன் நியாயத்தை பட்டப்பகலைப் போலவும் ஒளிரச் செய்வார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவுக்கு முன்பாக அமைதியாய் இருந்து,","poem":1},{"text":"அவருக்காகப் பொறுமையுடன் காத்திரு;","poem":2},{"text":"மனிதர் தங்கள் வழிகளில் வெற்றி காணும்போதும்","poem":1},{"text":"அவர்கள் தங்கள் பொல்லாத திட்டங்களைச் செயல்படுத்தும்போதும் நீ பதற்றமடையாதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"கோபத்தை அடக்கு, கடுங்கோபத்தை விட்டுவிலகு;","poem":1},{"text":"பதற்றமடையாதே; அது உன்னைத் தீமைக்கு மட்டுமே வழிநடத்தும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏனெனில், தீயவர் முற்றிலும் அழிந்துபோவார்கள்;","poem":1},{"text":"ஆனால் யெகோவாவிடம் எதிர்பார்ப்பாய் இருக்கிறவர்கள்","poem":2},{"lineBreak":true},{"text":"நாட்டை உரிமையாக்கிக்கொள்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"இன்னும் சிறிது நேரத்தில் கொடியவர்கள் இல்லாமல் போவார்கள்;","poem":1},{"text":"நீ அவர்களைத் தேடினாலும் அவர்கள் காணப்படமாட்டார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஆனால் சாந்தமுள்ளவர்கள், நாட்டை உரிமையாக்கிக்கொண்டு,","poem":1},{"text":"சமாதானத்தின் செழிப்பை அனுபவிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"கொடியவர்கள் நீதிமான்களுக்கு விரோதமாகச் சதிசெய்து,","poem":1},{"text":"அவர்களைப் பார்த்து பற்கடிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆனால் யெகோவா கொடியவர்களைப் பார்த்து நகைக்கிறார்;","poem":1},{"text":"அவர்களுடைய முடிவுகாலம் வருகிறதென அவர் அறிகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஏழைகளையும் எளியோரையும் வீழ்த்துவதற்கும்,","poem":1},{"text":"நேர்மையான வழியில் நடப்பவர்களை கொலைசெய்வதற்கும்","poem":2},{"text":"கொடியவர்கள் வாளை உருவி","poem":1},{"text":"வில்லை வளைக்கிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆனால் அவர்களுடைய வாள்கள் அவர்களுடைய இருதயங்களையே ஊடுருவக்குத்தும்;","poem":1},{"text":"அவர்களுடைய வில்லுகளும் முறிக்கப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"கொடியவர்களின் மிகுந்த செல்வத்தைப் பார்க்கிலும்,","poem":1},{"text":"நீதிமான்களிடம் இருக்கும் சிறிதளவே சிறந்தது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஏனெனில் கொடியவர்களின் பலம் உடைக்கப்படும்;","poem":1},{"text":"நீதிமான்களையோ யெகோவா தாங்குகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"குற்றமற்றவர்களின் நாட்களை யெகோவா அறிந்திருக்கிறார்;","poem":1},{"text":"அவர்களுடைய உரிமைச்சொத்து என்றும் நிலைத்திருக்கும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அழிவு காலத்தில் அவர்கள் தளர்ந்து போகமாட்டார்கள்;","poem":1},{"text":"பஞ்ச காலங்களிலும் நிறைவை அனுபவிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஆனால் கொடியவர்களோ அழிந்துபோவார்கள்,","poem":1},{"text":"யெகோவாவின் பகைவர்கள் வயலின் பூவைப்போல் இருந்தாலும்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் எரிந்து புகையைப்போல் இல்லாது ஒழிவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"கொடியவர்கள் கடன்வாங்கித் திருப்பிக்கொடுக்காமல் விட்டுவிடுகிறார்கள்;","poem":1},{"text":"ஆனால் நீதிமான்கள் தாராள மனதுடன் கொடுக்கிறார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"யெகோவாவினால் ஆசீர்வதிக்கப்படுகிறவர்கள்","poem":1},{"text":"நாட்டைத் தங்களுக்குச் சொந்தமாக்கிக்கொள்வார்கள்;","poem":2},{"lineBreak":true},{"text":"அவரால் சபிக்கப்படுகிறவர்களோ அழிந்துபோவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ஒரு மனிதனுடைய வழியில் யெகோவா பிரியமாயிருந்தால்,","poem":1},{"text":"அவனுடைய காலடிகளை அவர் உறுதியாக்குகிறார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவன் இடறினாலும் விழமாட்டான்;","poem":1},{"text":"ஏனெனில், யெகோவா தமது கரத்தினால் அவனைத் தாங்கிப் பிடிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"நான் வாலிபனாயிருந்தேன், இப்போது முதியவனாய் இருக்கிறேன்;","poem":1},{"text":"ஆனால் நீதிமான்கள் கைவிடப்பட்டதையோ,","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய பிள்ளைகள் உணவுக்காக பிச்சையெடுத்ததையோ நான் ஒருபோதும் காணவில்லை.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நீதிமான் எப்பொழுதும் தாராளமாய்க் கடன் கொடுக்கிறார்கள்;","poem":1},{"text":"அவர்களுடைய பிள்ளைகள் ஆசீர்வதிக்கப்படுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"தீமையிலிருந்து விலகி நன்மையைச் செய்;","poem":1},{"text":"அப்பொழுது நீ என்றென்றும் நிலைத்திருப்பாய்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ஏனெனில் யெகோவா நியாயத்தில் பிரியப்படுகிறார்;","poem":1},{"text":"தமக்கு உண்மையாய் இருப்பவர்களைக் கைவிடவுமாட்டார்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் என்றென்றும் பாதுகாக்கப்படுவார்கள்.","poem":2},{"lineBreak":true},{"text":"ஆனால் கொடியவர்களின் சந்ததியோ அழிந்துபோம்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"நீதிமான்கள் நாட்டைத் தங்களுக்கு சொந்தமாக்கி,","poem":1},{"text":"அதில் என்றும் குடியிருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"நீதிமான்களின் வாய் ஞானத்தை வெளிப்படுத்தும்;","poem":1},{"text":"அவர்களுடைய நாவு நியாயத்தைப் பேசும்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"இறைவனின் சட்டம் அவர்களுடைய இருதயத்தில் இருக்கிறது;","poem":1},{"text":"அவர்களுடைய கால்கள் சறுக்குவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"நீதிமான்களைக் கொல்லும்படி,","poem":1},{"text":"கொடியவர்கள் அவர்களைப் பிடிக்கப் பதுங்கிக் காத்திருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ஆனால் யெகோவா, நீதிமான்களை கொடியவர்களின் கையில் விடுவதுமில்லை;","poem":1},{"text":"நியாய்ந்தீர்க்கப்பட வரும்போது குற்றவாளிகளாக்க இடமளிப்பதுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"யெகோவாவை எதிர்பார்த்திருந்து,","poem":1},{"text":"அவருடைய வழியைக் கைக்கொள்.","poem":2},{"text":"நீ நாட்டை சொந்தமாக்கிக் கொள்ளும்படி, அவர் உன்னை உயர்த்துவார்;","poem":1},{"text":"கொடியவர்கள் அழிந்துபோவார்கள், நீ அதைக் காண்பாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":35,"content":[{"text":"கொடியவனும் ஈவு இரக்கமற்றவனுமான ஒருவனைக் கண்டேன்;","poem":1},{"text":"அவன் ஒரு பச்சைமரம் தனக்கேற்ற மண்ணில் செழித்திருப்பதைப் போல வளர்ந்தான்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ஆனால் அவன் விரைவாக ஒழிந்துபோனான்;","poem":1},{"text":"நான் அவனைத் தேடியும்கூட அவனைக் காணவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":37,"content":[{"text":"குற்றமற்றவனைக் கவனித்துப்பார், நேர்மையானவனை நோக்கிப்பார்;","poem":1},{"text":"சமாதானமாய் இருக்கிற மனிதனுக்கு நல்ல எதிர்காலம் உண்டு.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ஆனால் குற்றவாளிகள் அனைவரும் அழிக்கப்படுவார்கள்;","poem":1},{"text":"கொடியவர்களுக்கு எதிர்காலம் இல்லாமல் போகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":39,"content":[{"text":"நீதிமான்களின் இரட்சிப்பு யெகோவாவிடமிருந்து வரும்;","poem":1},{"text":"கஷ்டமான காலத்தில் அவரே அவர்களின் அரணாய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"யெகோவா அவர்களுக்கு உதவிசெய்து அவர்களை விடுவிக்கிறார்;","poem":1},{"text":"அவர்கள் யெகோவாவிடத்தில் தஞ்சம் அடைந்திருக்கிறபடியால்,","poem":2},{"lineBreak":true},{"text":"கொடியவர்களிடமிருந்து அவர்களை விடுவித்து இரட்சிக்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/37.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/38.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/36.json","previousChapterAudioLinks":{},"numberOfVerses":40}