{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":38,"content":[{"type":"hebrew_subtitle","content":["நினைவுகூருதலுக்கான விண்ணப்பமாகிய தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே உம்முடைய கோபத்தில் என்னை சிட்சியாதேயும்;","poem":1},{"text":"உமது கடுங்கோபத்தினால் என்னைத் தண்டியாதேயும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உம்முடைய அம்புகள் என்னை ஊடுருவக் குத்தியிருக்கின்றன;","poem":1},{"text":"உமது கரமோ என்மேல் பாரமாயிருக்கிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உமது கடுங்கோபத்தால் என் உடலில் ஆரோக்கியமில்லை;","poem":1},{"text":"என் பாவத்தினால் என் எலும்புகளில் சுகமில்லை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் தாங்கமுடியாத சுமையைப்போல","poem":1},{"text":"என்னுடைய குற்றங்கள் என் தலைக்குமேல் கடந்துபோயிற்று.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"என் மதிகேட்டினால்","poem":1},{"text":"எனக்கு ஏற்பட்ட புண்கள் அழுகி நாற்றமெடுத்தது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் கூனிக்குறுகி மிகவும் தாழ்த்தப்பட்டுப் போனேன்;","poem":1},{"text":"நாளெல்லாம் நான் துக்கத்தோடு திரிகிறேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எனக்குள் வேதனை எரிபந்தமாய் எரிகிறது;","poem":1},{"text":"என் உடலில் சுகமே இல்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் பலவீனமுற்று முற்றுமாய் உருக்குலைந்து போனேன்;","poem":1},{"text":"உள்ளத்தின் வேதனையால் நான் கதறுகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, என் வாஞ்சைகள் எல்லாம் உமக்கு முன்பாக இருக்கிறது;","poem":1},{"text":"என் பெருமூச்சும் உமக்கு மறைவாயில்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என் இருதயம் படபடக்கிறது, என் பெலன் குன்றிப்போகிறது;","poem":1},{"text":"என் கண்களும்கூட ஒளியிழந்து மங்கிப்போயிற்று.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எனது கூட்டாளிகளும் நண்பர்களும் என் புண்களின் நிமித்தம்,","poem":1},{"text":"என்னைச் சந்திப்பதைத் தவிர்க்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"என்னுடைய உறவினர்களும் என்னைவிட்டுத் தூரமாய் நிற்கிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"என்னைக் கொல்லத் தேடுபவர்கள் எனக்குக் கண்ணிகளை வைக்கிறார்கள்;","poem":1},{"text":"எனக்குத் தீமைசெய்யத் தேடுகிறவர்கள் என் அழிவைக் குறித்துப் பேசுகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"நாளெல்லாம் வஞ்சனையாய் சூழ்ச்சி செய்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"நானோ செவிடனைப்போலக் கேட்காதவனாகவும்,","poem":1},{"text":"ஊமையனைப்போல வாய் திறக்காதவனாகவும் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"காது காதுகேட்காதவனும்,","poem":1},{"text":"தன்னுடைய வாயினால் பதிலளிக்க முடியாதிருக்கிற மனிதனைப் போலானேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"யெகோவாவே, நான் உமக்குக் காத்திருக்கிறேன்;","poem":1},{"text":"என் இறைவனாகிய ஆண்டவரே, நீர் எனக்கு பதில் கொடும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"“என் கால் சறுக்கும்போது, அவர்கள் என்னைப் பழித்து மகிழவிடாதேயும்;","poem":1},{"text":"அவர்கள் என்னிமித்தம் ஏளனமாக பெருமைபாராட்ட விடாதேயும்” என்று நான் சொன்னேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நான் தடுமாறிவிழும் தருவாயில் இருக்கிறேன்;","poem":1},{"text":"என் வேதனை எப்பொழுதும் எனக்கு முன்பாக இருக்கிறது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"என் அநியாயத்தை அறிக்கையிடுகிறேன்;","poem":1},{"text":"என் பாவத்தினால் நான் கலங்கியிருக்கிறேன்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"காரணமின்றி பலர் எனக்கு பகைவரானார்கள்;","poem":1},{"text":"எதுவுமின்றி என்னை வெறுக்கிறவர்கள் ஏராளமாயிருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நான் நன்மையானதைச் செய்தபோதும்,","poem":1},{"text":"நான் செய்த நன்மைக்குப் பதிலாக எனக்குத் தீமை செய்பவர்கள்","poem":2},{"lineBreak":true},{"text":"என்னைக் குற்றப்படுத்துகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"யெகோவாவே, என்னைக் கைவிடாதேயும்;","poem":1},{"text":"என் இறைவனே, என்னைவிட்டுத் தூரமாய் இருக்கவேண்டாம்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"என் இரட்சகராகிய யெகோவாவே,","poem":1},{"text":"எனக்கு உதவிசெய்ய விரைவாய் வாரும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":22}