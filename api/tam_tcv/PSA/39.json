{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":39,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனாகிய எதுத்தூனுக்கு ஒப்புவித்த தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நான் சொன்னேன்: “நான் என் வழிகளைக் கவனித்து,","poem":1},{"text":"என் நாவைப் பாவத்துக்கு விலக்கிக் காத்துக்கொள்வேன்.","poem":2},{"text":"கொடியவர்கள் எனக்குமுன் இருக்கும்வரை,","poem":1},{"text":"நான் என் வாயை கடிவாளத்தால் பாதுகாப்பேன்.”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் பேசாமல் ஊமையாயிருந்தேன்,","poem":1},{"text":"நலமானதையும் பேசாமல் இருந்தேன்.","poem":2},{"text":"ஆனால் என் வேதனை அதிகரித்தது;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"என் உள்ளம் எனக்குள்ளே அனல் கொண்டது;","poem":2},{"text":"நான் தியானிக்கையில், அது நெருப்பாய்ப் பற்றிக்கொண்டது;","poem":1},{"text":"அப்பொழுது என் நாவினால் இதைப் பேசினேன்:","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“யெகோவாவே, என் வாழ்க்கையின் முடிவையும்,","poem":1},{"text":"என் வாழ்நாளின் எண்ணிக்கையையும் எனக்குத் தெரிவியும்;","poem":2},{"lineBreak":true},{"text":"என் வாழ்வு இவ்வளவுதான் என்பதை எனக்குத் தெரியப்பண்ணும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என் வாழ்நாட்களை நான்கு விரலளவாக்கினீர்;","poem":1},{"text":"எனது ஆயுட்காலமோ உமக்கு முன்பாக இல்லாததுபோல் தோன்றுகிறது;","poem":2},{"text":"பாதுகாப்பாய் இருப்பதுபோல தோன்றும்","poem":1},{"text":"எல்லா மனிதரின் நிலையும் கானல்நீரைப் போன்றதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“மனிதன் வெறும் மாயையாகவே நடந்து திரிகிறான்;","poem":1},{"text":"அவன் ஓடியோடி உழைத்து வீணாகவே அவன் செல்வத்தைச் சேர்த்துக் குவித்தாலும்,","poem":2},{"lineBreak":true},{"text":"அது யாரைப் போய்ச்சேரும் என அவன் அறியான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“ஆனாலும் யெகோவாவே, நான் எதற்காகக் காத்திருக்கிறேன்?","poem":1},{"text":"என் எதிர்பார்ப்பு உம்மிலேயே இருக்கிறது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் மீறுதல்கள் எல்லாவற்றிலுமிருந்து என்னைக் காப்பாற்றும்;","poem":1},{"text":"என்னை மூடரின் கேலிப் பொருளாக்காதேயும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் மவுனமாயிருந்தேன்;","poem":1},{"text":"நீரே இதைச் செய்தவராதலால், நான் என் வாயைத் திறக்கமாட்டேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உமது வாதையை என்னை விட்டகற்றும்;","poem":1},{"text":"உமது கரத்தின் தாக்குதலால் நான் இளைத்துப் போனேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பாவத்தினிமித்தம் நீர் மனிதர்களைக் கண்டித்துத் தண்டிக்கும்போது,","poem":1},{"text":"நீர் அவர்களுடைய செல்வத்தைப் பூச்சி அரிப்பதுபோல் கரைத்துவிடுகிறீர்;","poem":2},{"lineBreak":true},{"text":"நிச்சயமாகவே எல்லா மனிதரும் கானல்நீரைப் போன்றவர்களே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“யெகோவாவே, என் மன்றாட்டைக் கேளும்;","poem":1},{"text":"உதவிகேட்டு நான் கதறும் கதறுதலுக்குச் செவிகொடும்;","poem":2},{"lineBreak":true},{"text":"என் அழுகையைக் கேளாமல் இருக்கவேண்டாம்.","poem":2},{"text":"என் தந்தையர்கள் எல்லோரையும் போலவே,","poem":1},{"text":"நானும் உம்முடன் வேறுநாட்டைச் சேர்ந்த ஒருவனாகவும்,","poem":2},{"lineBreak":true},{"text":"குடியுரிமை அற்றவனாகவும் குடியிருக்கிறேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் இவ்விடத்தைவிட்டுப் பிரிந்து இல்லாமல் போகுமுன்னே,","poem":1},{"text":"நான் திரும்பவும் மகிழும்படியாய்,","poem":2},{"lineBreak":true},{"text":"உமது கோபத்தின் பார்வையை என்னைவிட்டு அகற்றும்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":13}