{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":4,"content":[{"type":"hebrew_subtitle","content":["கம்பியிசைக் கருவிகளுடன் பாடப்பட்டு பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நீதியுள்ள என் இறைவனே,","poem":1},{"text":"நான் கூப்பிடும்போது எனக்குப் பதில் தாரும்.","poem":2},{"text":"என் துயரத்திலிருந்து எனக்கு ஆறுதலைக் கொடும்;","poem":1},{"text":"என்மேல் இரக்கமாயிருந்து என் ஜெபத்தைக் கேளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"மனிதர்களே, எவ்வளவு காலத்திற்கு என் மகிமையை வெட்கமாக மாற்றுவீர்கள்?","poem":1},{"text":"எவ்வளவு காலத்திற்கு வெறுமையானவைகளை விரும்பி, பொய்யான தெய்வங்களைத் தேடுவீர்கள்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"யெகோவா பக்தியுள்ளவர்களைத் தமக்காகத் தெரிந்துகொண்டார் என்று அறியுங்கள்;","poem":1},{"text":"நான் யெகோவாவைக் கூப்பிடும்போது அவர் செவிகொடுப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நீங்கள் உங்கள் கோபத்தில் பாவம் செய்யவேண்டாம்;","poem":1},{"text":"நீங்கள் உங்கள் படுக்கையில் இருக்கும்போது,","poem":2},{"lineBreak":true},{"text":"உங்கள் இருதயங்களை ஆராய்ந்து அமைதியாயிருங்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீதியான பலிகளைச் செலுத்தி,","poem":1},{"text":"யெகோவாவிடம் நம்பிக்கையாய் இருங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“எங்களுக்கு நன்மையைக் காட்டுகிறவன் யார்?” என்று அநேகர் கேட்கிறார்கள்;","poem":1},{"text":"யெகோவாவே, உம்முடைய முகத்தின் ஒளி எங்கள்மேல் பிரகாசிக்கட்டும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"தானியமும் புதுத் திராட்சை இரசமும்","poem":1},{"text":"நிறைந்திருக்கிற காலத்தின் மகிழ்ச்சியைவிட","poem":2},{"lineBreak":true},{"text":"அதிக மகிழ்ச்சியினால் நீர் என் இருதயத்தை நிரப்பியிருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"நான் படுத்து மன அமைதியுடன் உறங்குவேன்;","poem":1},{"text":"ஏனெனில் யெகோவாவே,","poem":2},{"lineBreak":true},{"text":"நீர் மட்டுமே என்னைப் பாதுகாப்பாகக் குடியிருக்கச் செய்கிறீர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":8}