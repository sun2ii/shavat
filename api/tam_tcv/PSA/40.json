{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":40,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நான் யெகோவாவுக்காகப் பொறுமையுடன் காத்திருந்தேன்;","poem":1},{"text":"அவர் என் பக்கமாய்த் திரும்பி என் கதறுதலைக் கேட்டார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அழிவின் குழியிலிருந்தும்","poem":1},{"text":"மண் சகதியிலிருந்தும் அவர் என்னை வெளியே தூக்கியெடுத்தார்,","poem":2},{"text":"அவர் கற்பாறைமேல் என் கால்களை நிறுத்தி,","poem":1},{"text":"நிற்பதற்கு ஒரு உறுதியான இடத்தையும் எனக்குக் கொடுத்தார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எங்கள் இறைவனைத் துதிக்கும் ஒரு துதியின் கீதமான","poem":1},{"text":"புதுப்பாட்டை அவர் என் வாயிலிருந்து வரச்செய்தார்.","poem":2},{"text":"அநேகர் அதைக்கண்டு பயந்து,","poem":1},{"text":"யெகோவாவிடம் தங்கள் நம்பிக்கையை வைப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"பொய்யான கடவுள்களைப் பற்றிக்கொள்ளாமலும்,","poem":1},{"text":"அகந்தை உள்ளவர்களைச் சாராமலும்,","poem":2},{"lineBreak":true},{"text":"யெகோவாவைத் தனது நம்பிக்கையாகக் கொண்டிருக்கிறவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என் இறைவனாகிய யெகோவாவே,","poem":1},{"text":"நீர் எங்களுக்காக செய்துள்ள அதிசயங்களும்","poem":2},{"lineBreak":true},{"text":"உம்முடைய திட்டங்களும் அநேகம்.","poem":2},{"text":"உமக்கு நிகரானவர் ஒருவரும் இல்லை;","poem":1},{"text":"அவைகளைக் குறித்து நான் விவரிக்கப்போனால்,","poem":2},{"lineBreak":true},{"text":"அவை எடுத்துரைக்க முடியாதளவு ஏராளமானவைகள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"பலியையும் காணிக்கையையும் நீர் விரும்பவில்லை;","poem":1},{"text":"தகன காணிக்கைகளும் பாவநிவாரண காணிக்கைகளும் உமக்குத் தேவையில்லை;","poem":2},{"lineBreak":true},{"text":"ஆனால் நான் கேட்டுக் கீழ்ப்படிவதற்கு என் செவிகளைத் திறந்துவிட்டீர்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அப்பொழுது நான், “இதோ, நான் வருகிறேன்;","poem":1},{"text":"புத்தகச்சுருளில் என்னைக்குறித்து எழுதியிருக்கிறதே.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் இறைவனே, நான் உமது விருப்பத்தைச் செய்ய விரும்புகிறேன்;","poem":1},{"text":"உமது சட்டம் என் உள்ளத்திற்குள் இருக்கிறது” என்று சொன்னேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"மகா சபையில் உமது நீதியை பிரசித்தப்படுத்துகிறேன்;","poem":1},{"text":"யெகோவாவே, நீர் அறிந்திருக்கிறபடி","poem":2},{"lineBreak":true},{"text":"நான் என் உதடுகளை மூடுவதில்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் உமது நீதியை என் உள்ளத்தில் மறைப்பதில்லை;","poem":1},{"text":"உமது உண்மையையும்,","poem":2},{"text":"இரட்சிப்பையும் குறித்து நான் பேசுகிறேன்.","poem":1},{"text":"உமது உடன்படிக்கையின் அன்பையும் உண்மையையும் மகா சபைக்கு நான் மறைக்கவுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"யெகோவாவே, எனக்கு இரக்கத்தைக் காட்டாமல் விடாதேயும்;","poem":1},{"text":"உமது உடன்படிக்கையின் அன்பும் உமது உண்மையும் எப்போதும் என்னைப் பாதுகாப்பதாக.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஏனெனில் எண்ணற்ற இன்னல்கள் என்னைச் சூழ்கின்றன;","poem":1},{"text":"என் பாவங்கள் என்னை மூடிக்கொண்டதால், நான் பார்க்க முடியாதிருக்கிறேன்.","poem":2},{"text":"என் தலையிலுள்ள முடியைப் பார்க்கிலும், அவைகள் அதிகமானவை;","poem":1},{"text":"அதினால் என் இருதயம் எனக்குள் சோர்ந்துபோகிறது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவாவே, தயவுசெய்து என்னைக் காப்பாற்றும்;","poem":1},{"text":"யெகோவாவே, எனக்கு உதவிசெய்ய விரைவாய் வாரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"என் உயிரை அழிக்கத் தேடுகிற யாவரும்","poem":1},{"text":"வெட்கப்பட்டுக் குழப்பமடைவார்களாக;","poem":2},{"text":"எனது அழிவை விரும்புகிற யாவரும்","poem":1},{"text":"அவமானமடைந்து திரும்புவார்களாக.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என்னைப் பார்த்து, “ஆ! ஆ!” என்று ஏளனம் செய்கிறவர்கள்","poem":1},{"text":"அவர்களுடைய வெட்கத்தினால் நிலைகுலைந்து போவார்களாக.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆனால் உம்மைத் தேடுகிற யாவரும்","poem":1},{"text":"உம்மில் மகிழ்ந்து களிகூருவார்களாக;","poem":2},{"text":"உமது இரட்சிப்பை விரும்புவோர், “யெகோவா பெரியவர்!”","poem":1},{"text":"என்று எப்போதும் சொல்வார்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நானோ, ஏழையும் எளியவனுமாயிருக்கிறேன்;","poem":1},{"text":"யெகோவா என்னை நினைப்பாராக.","poem":2},{"text":"நீரே என் துணை, நீரே என் மீட்பர்;","poem":1},{"text":"என் இறைவனே, தாமதியாதேயும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/40.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/41.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/39.json","previousChapterAudioLinks":{},"numberOfVerses":17}