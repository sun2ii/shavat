{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":41,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"ஏழைகள்மீது கவனம் வைப்பவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்;","poem":1},{"text":"துன்ப நாளில் யெகோவா அவர்களை விடுவிப்பார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவா அவர்களைக் காப்பாற்றி அவர்களுடைய உயிரைப் பாதுகாப்பார்;","poem":1},{"text":"அவர்கள் பூமியில் ஆசீர்வாதமாக இருப்பார்கள்;","poem":2},{"lineBreak":true},{"text":"யெகோவா அவர்களுடைய பகைவர்களின் கைக்கு அவர்களை அவனை ஒப்புவிக்கமாட்டார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்களுடைய வியாதிப்படுக்கையில் யெகோவா அவர்களைத் தாங்குவார்;","poem":1},{"text":"படுக்கையில் வியாதியாய் இருக்கும் அவர்களுக்குச் சுகத்தைக் கொடுப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நான், “யெகோவாவே என்மேல் இரக்கமாயிரும்;","poem":1},{"text":"உமக்கு விரோதமாய்ப் பாவம் செய்திருக்கிறேன்,","poem":2},{"lineBreak":true},{"text":"என்னைக் குணமாக்கும்” என்று சொன்னேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"என் பகைவர்கள் என்னைக்குறித்து தீமையானதைப் பேசி,","poem":1},{"text":"“அவன் எப்பொழுது சாவான்? அவன் பெயர் எப்பொழுது அழியும்” என்று சொல்கிறார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்களில் ஒருவன் என்னைப் பார்க்க வருகையில்,","poem":1},{"text":"தன் உள்ளத்தில் அவதூறை சேகரித்து உதட்டில் வஞ்சனையாகப் பேசுகிறான்;","poem":2},{"lineBreak":true},{"text":"பின்பு அவன் வெளியே போய் அதைப் பரப்புகிறான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"என் பகைவர்கள் எல்லோரும் எனக்கு விரோதமாய் ஒன்றுகூடி, முணுமுணுத்து,","poem":1},{"text":"அவர்கள் எனக்குப் பெருங்கேடு நினைத்து சொன்னதாவது:","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“ஒரு கொடியநோய் அவனைப் பிடித்துக்கொண்டது;","poem":1},{"text":"அவன் படுத்திருக்கிற இடத்தைவிட்டு ஒருபோதும் எழுந்திருக்கமாட்டான்.”","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் நம்பியிருந்தவனும்","poem":1},{"text":"அப்பத்தை என்னுடன் பகிர்ந்து சாப்பிட்டவனுமான,","poem":2},{"text":"என் நெருங்கிய நண்பன் தன் குதிகாலை","poem":1},{"text":"எனக்கெதிராகத் தூக்கினான்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"ஆனாலும் யெகோவாவே, நீர் என்மேல் இரக்கமாயிரும்;","poem":1},{"text":"நான் அவர்களுக்குப் பதிற்செய்யும்படி என்னை எழுப்பும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் பகைவன் என்னை மேற்கொள்ளாதபடியால்,","poem":1},{"text":"நீர் என்னில் பிரியமாய் இருக்கிறீரென்று நான் அறிகிறேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீர் என் உத்தமத்தில் என்னை ஆதரித்து,","poem":1},{"text":"உமது சமுகத்தில் எப்போதும் என்னை வைத்துக்கொள்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"இஸ்ரயேலின் இறைவனான யெகோவாவுக்கு","poem":1},{"text":"நித்திய நித்தியமாய் துதி உண்டாகட்டும்.","poem":2},"ஆமென், ஆமென்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":13}