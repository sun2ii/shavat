{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":42,"content":[{"type":"hebrew_subtitle","content":["கோராகின் மகன்களிலுள்ள பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட மஸ்கீல் என்னும் தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"மான் நீரோடைகளைத் தேடி ஏங்குவது போல்,","poem":1},{"text":"இறைவனே என் ஆத்துமா உம்மைத் தேடி ஏங்குகிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் ஆத்துமா இறைவனுக்காக, உயிருள்ள இறைவனுக்காக தாகம் கொள்கிறது;","poem":1},{"text":"நான் எப்பொழுது இறைவனுடைய சமுகத்தில் வந்து நிற்பேன்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"மனிதர்களோ நாள்முழுதும் என்னைப் பார்த்து,","poem":1},{"text":"“உன் இறைவன் எங்கே?” என்று கேட்பதால்,","poem":2},{"text":"இரவும் பகலும்","poem":1},{"text":"என் கண்ணீரே எனக்கு உணவாயிற்று.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் ஆத்துமா எனக்குள் உருகுகையில்","poem":1},{"text":"இவைகள் என் நினைவுக்கு வருகின்றன:","poem":2},{"text":"முந்திய நாட்களில் நான் மக்கள் கூட்டத்துடன் சேர்ந்து,","poem":1},{"text":"இறைவனின் வீட்டிற்கு அவர்களோடு ஊர்வலமாய் நடந்து சென்றேன்;","poem":2},{"text":"பண்டிகை கொண்டாடும் மக்கள் கூட்டத்தின் நடுவே,","poem":1},{"text":"மகிழ்ச்சியின் சத்தத்தோடும் துதியின் சத்தத்தோடும் நடந்து சென்றேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"என் ஆத்துமாவே, நீ ஏன் சோர்ந்து போகிறாய்?","poem":1},{"text":"ஏன் இவ்விதமாய் எனக்குள் கலங்கியிருக்கிறாய்?","poem":2},{"text":"இறைவனில் உன் எதிர்பார்ப்பை வைத்திரு;","poem":1},{"text":"நான் என் இறைவனின் இரட்சிப்பிற்காக","poem":2},{"lineBreak":true},{"text":"இன்னும் அவரைத் துதிப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"என் இறைவனே, என் ஆத்துமா எனக்குள் சோர்ந்துபோகிறது;","poem":1},{"text":"அதினால் நான் எர்மோன் மலைகள் இருக்கும்","poem":2},{"text":"யோர்தான் நதி தொடங்கும் நாட்டிலிருந்தும்,","poem":1},{"text":"மீசார் மலையிலிருந்தும் உம்மை நினைவுகூருவேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உமது அருவிகளின் இரைச்சலினால்","poem":1},{"text":"ஆழம் ஆழத்தைக் கூப்பிடுகிறது;","poem":2},{"text":"உம்முடைய எல்லா அலைகளும்,","poem":1},{"text":"பேரலைகளும் எனக்கு மேலாக மோதிச் செல்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"பகலில் யெகோவா தமது உடன்படிக்கையின் அன்பை எனக்குக் கொடுக்கிறார்;","poem":1},{"text":"இரவிலோ, அவருடைய பாடல் என்னோடு இருக்கிறது;","poem":2},{"lineBreak":true},{"text":"என் வாழ்வின் இறைவனை நோக்கிய மன்றாட்டாகவே அது இருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"நான் என் கன்மலையாகிய இறைவனிடம்,","poem":1},{"text":"“நீர் ஏன் என்னை மறந்து விட்டீர்?","poem":2},{"text":"பகைவனால் ஒடுக்கப்பட்டு","poem":1},{"text":"நான் ஏன் துக்கத்துடன் திரியவேண்டும்?” என்கிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நாளெல்லாம் என் பகைவர்கள் என்னைப் பார்த்து,","poem":1},{"text":"“உன் இறைவன் எங்கே?”","poem":2},{"text":"என்று என்னைப் நிந்திப்பதால்,","poem":1},{"text":"என் எலும்புகள் சாவுக்கேதுவான வேதனையை அடைகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"என் ஆத்துமாவே, நீ ஏன் சோர்ந்து போகிறாய்?","poem":1},{"text":"நீ ஏன் இவ்விதமாய் எனக்குள் கலங்கியிருக்கிறாய்?","poem":2},{"text":"இறைவனில் உன் எதிர்பார்ப்பை வைத்திரு;","poem":1},{"text":"நான் என் இறைவனின் இரட்சிப்பிற்காக","poem":2},{"lineBreak":true},{"text":"இன்னும் அவரைத் துதிப்பேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/42.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/43.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/41.json","previousChapterAudioLinks":{},"numberOfVerses":11}