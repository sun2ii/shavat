{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":43,"content":[{"type":"verse","number":1,"content":[{"text":"இறைவனே, என் நீதியை மெய்ப்பித்துக் காட்டும்;","poem":1},{"text":"இறை பக்தியற்ற நாட்டினருக்கு விரோதமாய்","poem":2},{"lineBreak":true},{"text":"எனக்காக வழக்காடும்,","poem":2},{"text":"வஞ்சகமும் கொடுமையுமான மனிதரிடமிருந்து","poem":1},{"text":"என்னைத் தப்புவியும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஏனெனில் நீரே என் இறைவன், என் கோட்டை.","poem":1},{"text":"நீர் ஏன் என்னைப் புறக்கணித்துவிட்டீர்?","poem":2},{"text":"பகைவனால் ஒடுக்கப்பட்டு,","poem":1},{"text":"நான் ஏன் துக்கத்துடன் திரியவேண்டும்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உமது ஒளியையும் உமது உண்மையையும் அனுப்பும்;","poem":1},{"text":"அவை எனக்கு வழிகாட்டட்டும்.","poem":2},{"text":"நீர் குடியிருக்கும் இடமான","poem":1},{"text":"உமது பரிசுத்த மலைக்கு அவை என்னைக் கொண்டுவரட்டும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அப்பொழுது இறைவனின் பலிபீடத்தண்டைக்குப் போவேன்;","poem":1},{"text":"என் மகிழ்ச்சியும் என் களிப்புமான இறைவனிடத்திற்குப் போவேன்.","poem":2},{"text":"இறைவனே, என் இறைவனே,","poem":1},{"text":"யாழ் இசைத்து உம்மைத் துதிப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"என் ஆத்துமாவே, நீ ஏன் சோர்ந்து போகிறாய்?","poem":1},{"text":"ஏன் இவ்விதமாய் எனக்குள் கலங்கியிருக்கிறாய்?","poem":2},{"text":"இறைவனில் உன் எதிர்பார்ப்பை வைத்திரு;","poem":1},{"text":"நான் என் இறைவனின் இரட்சிப்பிற்காக","poem":2},{"lineBreak":true},{"text":"இன்னும் அவரைத் துதிப்பேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}