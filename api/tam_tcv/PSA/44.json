{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":44,"content":[{"type":"hebrew_subtitle","content":["கோராகின் மகன்களிலுள்ள பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட மஸ்கீல் என்னும் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, வெகுகாலத்திற்குமுன்","poem":1},{"text":"எங்கள் முன்னோர்களின் நாட்களில் நீர் செய்தவற்றை","poem":2},{"text":"அவர்கள் எங்களுக்குச் சொன்னார்கள்;","poem":1},{"text":"அவற்றை நாங்கள் எங்கள் காதுகளால் கேட்டிருக்கிறோம்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீர் உமது கரத்தால் நாடுகளை வெளியே துரத்தி,","poem":1},{"text":"எங்கள் முன்னோர்களைக் குடியமர்த்தினீர்;","poem":2},{"text":"நீர் அந்நாட்டினரை தண்டித்து,","poem":1},{"text":"எங்கள் முன்னோரைச் செழிக்கப் பண்ணினீர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் தங்கள் வாளினால் நாட்டை உடைமையாக்கவும் இல்லை,","poem":1},{"text":"அவர்களுடைய புயத்தால் அவர்கள் வெற்றிகொள்ளவும் இல்லை;","poem":2},{"text":"நீர் அவர்களில் பிரியம் கொள்வதினால் உமது வலதுகரமும் உமது வலிய புயமும்","poem":1},{"text":"உமது முகத்தின் ஒளியுமே வெற்றிகொள்ளச் செய்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"இறைவனே, நீரே என் அரசன்;","poem":1},{"text":"யாக்கோபுக்கு வெற்றியைக் கட்டளையிடுகிறவர் நீரே.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உம்மாலே நாங்கள் எங்கள் பகைவர்களை விழத்தள்ளி,","poem":1},{"text":"உமது பெயராலே எங்கள் எதிரிகளை மிதிப்போம்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"என் வில்லிலே நான் நம்பிக்கை வைக்கிறதில்லை,","poem":1},{"text":"என் வாள் வெற்றியைக் கொடுப்பதில்லை;","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனால் நீரே எங்கள் பகைவர்கள்மீது வெற்றியைக் கொடுத்து,","poem":1},{"text":"எங்கள் விரோதிகளை வெட்கப்படுத்துகிறீர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நாங்களோ நாள்தோறும் இறைவனிலேயே பெருமை பாராட்டுகிறோம்;","poem":1},{"text":"நாங்கள் உமது பெயரை என்றென்றும் துதிப்போம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"இப்பொழுதோ நீர் எங்களைப் புறக்கணித்து, சிறுமைப்படுத்திவிட்டீர்;","poem":1},{"text":"நீர் எங்கள் இராணுவத்துடன் செல்வதுமில்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எங்கள் பகைவருக்கு முன்பாக எங்களைப் பின்வாங்கச் செய்தீர்;","poem":1},{"text":"எங்கள் விரோதிகள் எங்களைச் சூறையாடி விட்டார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"செம்மறியாடுகளைப்போல் நீர் எங்களை இரையாகக் விட்டுக்கொடுத்தீர்;","poem":1},{"text":"நாடுகளுக்கு மத்தியில் எங்களைச் சிதறடித்தீர்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீர் உமது மக்களை மலிவாக விற்றுப் போட்டீர்;","poem":1},{"text":"அவர்களை எவ்வித இலாபமுமின்றி விற்றுப்போட்டீரே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"எங்கள் அயலவருக்கு எங்களை ஒரு நிந்தையாக்கி விட்டீர்;","poem":1},{"text":"எங்களைச் சுற்றி இருக்கிறவர்களுக்கு எங்களை இகழ்ச்சியும் ஏளனமும் ஆக்கினீர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நீர் எங்களைப் நாடுகளுக்கு நடுவில் ஒரு பழமொழியாக ஆக்கினீர்;","poem":1},{"text":"மக்கள் கூட்டம் எங்களைப் பார்த்து ஏளனமாய்த் தங்கள் தலையை அசைக்கிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நாள்தோறும் நான் அவமானத்தில் வாழ்கிறேன்;","poem":1},{"text":"என் முகம் வெட்கத்தினால் மூடப்பட்டிருக்கிறது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"என்னை நிந்தித்துத் தூஷித்து பழிவாங்கத் துடிக்கும்","poem":1},{"text":"பகைவர்களின் நிந்தனைகளினாலேயே வெட்கப்படுகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நாங்கள் உம்மை மறவாமல் இருந்தோம்;","poem":1},{"text":"உமது உடன்படிக்கைக்கு உண்மையுள்ளவர்களாய் இருந்தோம்;","poem":2},{"lineBreak":true},{"text":"ஆனாலும், இவையெல்லாம் எங்களுக்கு நடந்தன.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"எங்கள் இருதயம் பின்வாங்கவுமில்லை,","poem":1},{"text":"எங்கள் பாதங்கள் உமது வழியைவிட்டு விலகவுமில்லை.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ஆனாலும் நீர் எங்களை இடித்து, எங்கள் இடங்களை நரிகளின் உறைவிடமாக்கினீர்;","poem":1},{"text":"காரிருளினால் எங்களை மூடினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"எங்கள் இறைவனின் பெயரை நாங்கள் மறந்திருந்தால்,","poem":1},{"text":"அல்லது வேறுநாட்டின் தெய்வமல்லாததை நோக்கி எங்கள் கைகளை நீட்டியிருந்தால்,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"இறைவன் அதைக் கண்டுபிடியாமல் இருந்திருப்பாரோ?","poem":1},{"text":"அவர் இருதயத்தின் இரகசியங்களை அறிகிறவராய் இருக்கிறாரே.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஆனாலும் உமக்காகவே நாங்கள் நாள்முழுதும் மரணத்தை சந்திக்கிறோம்;","poem":1},{"text":"அடித்துக் கொல்லப்பட இருக்கும் செம்மறியாடுகளைப்போல் எண்ணப்படுகிறோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"யெகோவாவே, எழுந்தருளும்! ஏன் நித்திரை செய்கிறீர்?","poem":1},{"text":"விழித்துக்கொள்ளும்! எங்களை என்றென்றும் புறக்கணியாதேயும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நீர் ஏன் உமது முகத்தை மறைத்து,","poem":1},{"text":"எங்கள் துன்பத்தையும் நாங்கள் ஒடுக்கப்படுவதையும் மறந்துவிடுகிறீர்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"நாங்கள் தூசியில் தள்ளப்பட்டிருக்கிறோம்;","poem":1},{"text":"எங்கள் உடல்கள் தரையோடு ஒட்டியிருக்கிறது.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"நீர் எழுந்து எங்களுக்கு உதவிசெய்யும்;","poem":1},{"text":"உமது உடன்படிக்கையின் அன்பினால் எங்களை மீட்டுக்கொள்ளும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/44.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/45.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/43.json","previousChapterAudioLinks":{},"numberOfVerses":26}