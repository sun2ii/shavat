{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":45,"content":[{"type":"hebrew_subtitle","content":["“லீலிமலர்கள்” என்ற சுருதியிலே வாசிக்கக் கோராகின் மகன்களிலுள்ள பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட திருமணப் பாடலாகிய சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"அரசனைப் புகழ்ந்து, நான் கவிகளைப் பாடும்போது,","poem":1},{"text":"அதின் உயர்வான கருப்பொருளால் என் உள்ளம் பொங்குகிறது;","poem":2},{"lineBreak":true},{"text":"என் நாவு சிறந்த ஓர் எழுத்தாளனின் எழுதுகோல்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"மனுஷரெல்லாரிலும் அழகுமிக்கவர் நீரே,","poem":1},{"text":"இறைவன் என்றென்றுமாய் உம்மை ஆசீர்வதித்திருப்பதால்,","poem":2},{"lineBreak":true},{"text":"உமது உதடுகளில் கிருபை பொழிகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"வலிமை மிகுந்தவரே, உமது வாளை எடுத்து உமது இடையில் கட்டிக்கொள்ளும்;","poem":1},{"text":"மகிமையினாலும் மகத்துவத்தினாலும் உம்மை உடுத்திக்கொள்ளும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உண்மையும் தாழ்மையும் நீதியும் உயர,","poem":1},{"text":"உமது மகத்துவத்தில் வெற்றியுடன் விரைந்து வாரும்;","poem":2},{"lineBreak":true},{"text":"உமது வலதுகரம் பயங்கரமான செயல்களைச் செய்யட்டும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உமது கூர்மையான அம்புகள் அரசனின் பகைவருடைய இருதயத்திற்குள் பாயட்டும்;","poem":1},{"text":"நாடுகள் உமது பாதத்தின்கீழ் வீழ்ச்சியடையட்டும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இறைவனே, உம்முடைய அரியணை என்றென்றுமாய் நிலைத்திருக்கும்;","poem":1},{"text":"நீதியே உம்முடைய அரசின் செங்கோலாயிருக்கும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நீர் நீதியை விரும்பி அநீதியை வெறுக்கிறீர்;","poem":1},{"text":"ஆகையால் இறைவனே, உமது இறைவன் உம்மை மகிழ்ச்சியின் எண்ணெயால் அபிஷேகித்து,","poem":2},{"lineBreak":true},{"text":"உமது தோழர்களுக்கு மேலாக உம்மை உயர்த்திவைத்தார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"உமது ஆடைகளை எல்லாம் வெள்ளைப்போளம், சந்தனம், இலவங்கம்","poem":1},{"text":"ஆகியவற்றின் வாசனை பொருந்தியதாக இருக்கிறது.","poem":2},{"text":"யானைத் தந்தத்தால் அலங்கரிக்கப்பட்ட அரண்மனைகளிலிருந்து வரும்,","poem":1},{"text":"கம்பியிசைக் கருவிகளின் இசை உம்மை மகிழ்விக்கிறது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"உமது கனம்பொருந்திய பெண்கள் நடுவில் அரச குமாரத்திகளும் இருக்கிறார்கள்.","poem":1},{"text":"அரச மணமகளோ, ஓப்பீரின் தங்கம் அணிந்தவளாய் உமது வலதுபக்கத்தில் நிற்கிறாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"மகளே கேள், உன் செவியைச் சாய்த்துக் கவனி:","poem":1},{"text":"உன் மக்களையும் உன் தகப்பன் வீட்டையும் மறந்துவிடு.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அரசர் உன் அழகில் பிரியப்படுவார்;","poem":1},{"text":"அவரே உனது யெகோவா, ஆதலால் அவரை கனம்பண்ணு.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"தீரு நகர மக்கள் ஒரு வெகுமதியுடன் வருவார்கள்;","poem":1},{"text":"செல்வந்தர் உன் தயவை நாடுவார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இளவரசி எல்லா மகிமையோடும் அவளது அறைக்குள் இருக்கிறாள்;","poem":1},{"text":"அவளுடைய உடை தங்கச் சரிகையாயிருக்கிறது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவள் அலங்கார வேலைப்பாடு கொண்ட உடைகளோடு","poem":1},{"text":"அரசனிடம் அழைத்துச் செல்லப்படுகிறாள்;","poem":2},{"text":"அவளுடைய தோழியர்களாகிய கன்னியர்கள்","poem":1},{"text":"அவளைத் தொடர்ந்து உம்மிடம் அழைத்து வருகிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர்கள் மகிழ்ச்சியோடும் களிப்போடும்","poem":1},{"text":"அவர்கள் அரசனின் அரண்மனைக்குள் வருகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"உம்முடைய மகன்கள் உமது முற்பிதாக்களின் இடத்தில் நிலைத்திருப்பார்கள்;","poem":1},{"text":"அவர்களை நீர் நாடு முழுவதிலும் இளவரசர்களாகும்படி செய்வீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"நான் எல்லா தலைமுறைகளின் நடுவிலும்","poem":1},{"text":"உம்மைக் குறித்த நினைவுகளை நிலைபெறச் செய்வேன்;","poem":2},{"lineBreak":true},{"text":"அதினால் மக்கள் கூட்டம் உம்மை என்றென்றைக்கும் துதிப்பார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/44.json","previousChapterAudioLinks":{},"numberOfVerses":17}