{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":46,"content":[{"type":"hebrew_subtitle","content":["அலாமோத்தில் வாசிக்கக் கோராகின் மகன்களிலுள்ள பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட பாடல்."]},{"type":"verse","number":1,"content":[{"text":"இறைவன் நமக்கு புகலிடமும் பெலனுமாய் இருக்கிறார்,","poem":1},{"text":"ஆபத்துக் காலத்தில் நம்மோடிருந்து உதவுகிறவர் அவரே.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"ஆகையால் பூமி பிளவுண்டு போனாலும்","poem":1},{"text":"மலைகள் கடலின் நடுவில் விழுந்தாலும்","poem":2}]},{"type":"verse","number":3,"content":[{"text":"கடலின் தண்ணீர் கொந்தளித்துப் பொங்கினாலும்","poem":1},{"text":"அதின் எழுச்சியால் மலைகள் அதிர்ந்தாலும் நாம் பயப்படமாட்டோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ஒரு நதி உண்டு, அதின் நீரோடைகள் மகா உன்னதமானவர் வாசம்பண்ணும்","poem":1},{"text":"பரிசுத்த இடமான இறைவனின் நகரத்தை மகிழ்ச்சியாக்குகின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறைவன் அதற்குள் இருக்கிறார், அது விழுந்து போகாது;","poem":1},{"text":"அதிகாலையில் இறைவன் அதற்கு உதவி செய்வார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நாடுகள் குமுறி எழுகின்றார்கள், அரசுகள் விழுகின்றன;","poem":1},{"text":"யெகோவா தன் குரலை எழுப்புகிறார், பூமி உருகுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"சேனைகளின் யெகோவா நம்மோடிருக்கிறார்;","poem":1},{"text":"யாக்கோபின் இறைவன் நமக்கு கோட்டையாய் இருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவினுடைய செயல்களையும்","poem":1},{"text":"அவர் பூமியின்மேல் கொண்டுவந்த அழிவுகளையும் வந்து பாருங்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவா பூமியின் கடைசிவரை","poem":1},{"text":"யுத்தங்களை நிறுத்துகிறார்;","poem":2},{"text":"அவர் வில்லை முறித்து, ஈட்டியை நொறுக்குகிறார்;","poem":1},{"text":"கேடயங்களை நெருப்பினால் எரிக்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"யெகோவா சொல்கிறார், “நீங்கள் அமைதியாய் இருந்து","poem":1},{"text":"நானே இறைவன் என்று அறிந்துகொள்ளுங்கள்.","poem":2},{"text":"நான் நாடுகளுக்கு மத்தியில் புகழ்ந்து உயர்த்தப்படுவேன்,","poem":1},{"text":"நான் பூமியிலே புகழ்ந்து உயர்த்தப்படுவேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"சேனைகளின் யெகோவா நம்மோடிருக்கிறார்;","poem":1},{"text":"யாக்கோபின் இறைவன் நமக்கு கோட்டையாய் இருக்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":11}