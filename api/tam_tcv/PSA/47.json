{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":47,"content":[{"type":"hebrew_subtitle","content":["கோராகின் மகன்களிலுள்ள பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நாடுகளே, நீங்கள் எல்லோரும் உங்கள் கைகளைத் தட்டுங்கள்;","poem":1},{"text":"மகிழ்ச்சியின் சத்தத்துடன் ஆர்ப்பரித்து இறைவனைத் துதியுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"உன்னதமானவராகிய யெகோவா அச்சத்திற்கு உரியவர்,","poem":1},{"text":"அவர் பூமி முழுவதற்கும் மகா அரசர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர் மக்களை நமக்குக் கீழ்ப்படுத்தினார்,","poem":1},{"text":"மக்கள் கூட்டத்தை நம்முடைய பாதங்களுக்குக் கீழ்ப்படுத்தினார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இறைவன் தமக்கு அன்பான யாக்கோபியரை,","poem":1},{"text":"தமது உரிமைச்சொத்தாக தேர்ந்தெடுப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இறைவன் மகிழ்ச்சியின் ஆரவாரத்தின் மத்தியில் எழுந்தருளினார்;","poem":1},{"text":"யெகோவா எக்காள சத்தத்தோடும் உயர்த்தப்பட்டிருக்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இறைவனுக்குத் துதிகளைப் பாடுங்கள், துதிகளைப் பாடுங்கள்;","poem":1},{"text":"நமது அரசருக்குத் துதிகளைப் பாடுங்கள், துதிகளைப் பாடுங்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஏனெனில் இறைவனே பூமி முழுவதற்கும் அரசராய் இருக்கிறார்;","poem":1},{"text":"அவருக்குத் துதியின் சங்கீதத்தைப் பாடுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"இறைவன் நாடுகளுக்கு மேலாக ஆளுகை செய்கிறார்;","poem":1},{"text":"அவர் தமது பரிசுத்த சிங்காசனத்தின்மேல் அமர்ந்திருக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மக்களின் தலைவர்கள்,","poem":1},{"text":"ஆபிரகாமின் இறைவனுடைய மக்களாக ஒன்றுகூடுகிறார்கள்.","poem":2},{"text":"ஏனெனில் பூமியின் அரசர்கள் இறைவனுக்கே உரியவர்கள்;","poem":1},{"text":"அவர் மிகவும் புகழ்ந்து உயர்த்தப்பட்டிருக்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":9}