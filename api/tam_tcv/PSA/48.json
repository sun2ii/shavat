{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":48,"content":[{"type":"hebrew_subtitle","content":["கோராகியரின் சங்கீதப் பாட்டு."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா மிகவும் பெரியவர்,","poem":1},{"text":"நமது இறைவனுடைய நகரத்தில், அவருடைய பரிசுத்த மலையில்","poem":2},{"lineBreak":true},{"text":"அவர் மிகவும் துதிக்கப்படத்தக்கவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"சீயோன் மலை தன் கம்பீரத்தில் அழகாய்,","poem":1},{"text":"முழு பூமியின் மகிழ்ச்சியாய் இருக்கிறது,","poem":2},{"text":"வடதிசையின் மிக உயர்ந்த மேடுகளைப் போல இருக்கிற அது","poem":1},{"text":"மகா அரசரின் நகரம்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இறைவன் அதின் கோட்டைப் பட்டணங்களில் வீற்றிருந்து,","poem":1},{"text":"அவர்தாமே அதின் கோட்டை எனக் காண்பிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அரசர்கள் படைதிரட்டி ஒருமித்து","poem":1},{"text":"முன்னேறி வந்தபோது,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"சீயோன் மலையைக் கண்டு அதிர்ச்சியடைந்து,","poem":1},{"text":"திகிலடைந்து தப்பி ஓடினார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அங்கே நடுக்கம் அவர்களைப் பிடித்தது;","poem":1},{"text":"பிரசவிக்கும் பெண்ணுக்கு உண்டாகுவதைப் போன்ற வேதனை அவர்களைப் பிடித்தது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே, நீர் கிழக்குக் காற்றினால்,","poem":1},{"text":"தர்ஷீசின் கப்பல்களை உடைக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"நாம் கேள்விப்பட்டது போலவே,","poem":1},{"text":"சேனைகளின் இறைவனுடைய பட்டணத்தில்,","poem":2},{"text":"நம்முடைய யெகோவாவின் பட்டணத்தில்","poem":1},{"text":"நாம் கண்டும் இருக்கிறோம்:","poem":2},{"text":"இறைவன் அந்தப் பட்டணத்திற்கு","poem":1},{"text":"என்றென்றைக்கும் பாதுகாப்பு கொடுக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"இறைவனே, உமது உடன்படிக்கையின் அன்பைக்குறித்து,","poem":1},{"text":"உமது ஆலயத்தில் நாங்கள் தியானிக்கிறோம்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இறைவனே, உமது பெயரைப் போலவே","poem":1},{"text":"உமது துதியும் பூமியின் கடைசிவரை எட்டுகிறது;","poem":2},{"lineBreak":true},{"text":"உமது வலதுகரம் நீதியால் நிறைந்திருக்கிறது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உமது நியாயத்தீர்ப்பின் நிமித்தம்","poem":1},{"text":"சீயோன் மலை களிகூருகிறது,","poem":2},{"lineBreak":true},{"text":"யூதாவின் கிராமங்கள் மகிழ்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"சீயோனைச் சுற்றி உலாவுங்கள்;","poem":1},{"text":"அதின் கோபுரங்களைக் கணக்கிடுங்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவற்றைப்பற்றி அடுத்த தலைமுறைக்கு","poem":1},{"text":"நீங்கள் சொல்லும்படி,","poem":2},{"text":"அதின் காவல் அரண்களை நன்றாய் கவனியுங்கள்;","poem":1},{"text":"கோட்டைப் பட்டணங்களைப் பார்வையிடுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"ஏனெனில் இந்த இறைவனே என்றென்றும் நம்முடைய இறைவன்;","poem":1},{"text":"மரணம் வரையும் அவரே நமக்கு வழிகாட்டியாய் இருப்பார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":14}