{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":49,"content":[{"type":"hebrew_subtitle","content":["கோராகின் மகன்களிலுள்ள பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"மக்களே, நீங்கள் எல்லோரும் இதைக் கேளுங்கள்,","poem":1},{"text":"இந்த உலகத்தில் வாழ்கிறவர்களே,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"தாழ்ந்தோரே, உயர்ந்தோரே, செல்வந்தரே, ஏழைகளே,","poem":1},{"text":"எல்லோரும் ஒருமித்துச் செவிகொடுங்கள்:","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என் வாய் ஞானமுள்ள வார்த்தைகளைப் பேசும்;","poem":1},{"text":"என் இருதயத்திலிருந்து வரும் தியானம் விளங்கிக்கொள்ளும் ஆற்றலைக் கொடுக்கும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் பழமொழிக்கு என் செவியைச் சாய்ப்பேன்;","poem":1},{"text":"விடுகதையை யாழ் இசைத்து விவரிப்பேன்:","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"தீங்கு நாட்கள் வரும்போதும்,","poem":1},{"text":"கொடிய ஏமாற்றுக்காருடைய அக்கிரமம் என்னைச் சூழ்ந்துகொள்ளும்போதும்","poem":2},{"lineBreak":true},{"text":"நான் ஏன் பயப்படவேண்டும்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் தங்கள் செல்வத்தில் நம்பிக்கை வைத்து,","poem":1},{"text":"தங்கள் மிகுதியான உடைமைகளில் பெருமை பாராட்டுகிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஒருவனாலும் இன்னொருவனுடைய உயிரை மீட்கமுடியாது;","poem":1},{"text":"அவனுக்கான மீட்பின் பதிலீட்டை இறைவனுக்குக் கொடுக்கவும் முடியாது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஏனெனில் உயிருக்கான மீட்பின் பதிலீடு விலையுயர்ந்தது;","poem":1},{"text":"எந்த விலை கொடுத்தும் மீட்கமுடியாது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்கள் அழிவைக் காணாமல்","poem":1},{"text":"என்றென்றும் வாழும்படி எப்படிப்பட்ட விலையும் கொடுக்க முடியாது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஞானிகள் சாவதையும்,","poem":1},{"text":"மூடரும் புத்தியற்றவர்களும் அழிவதையும் எல்லோராலும் காணமுடியும்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் தங்கள் செல்வத்தை மற்றவர்களுக்கு விட்டுச் செல்வதைக் காணலாம்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"தங்கள் பெயர்களையே அவர்கள் நிலங்களுக்கு வைத்தாலும்,","poem":1},{"text":"அவர்களுடைய கல்லறைகளே என்றென்றைக்கும் அவர்கள் வீடாகவும்","poem":2},{"lineBreak":true},{"text":"முடிவற்ற தலைமுறைகளுக்கு அவர்களுடைய தங்குமிடமாகவும் நிலைத்திருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ஆனாலும் மக்கள் நன்மதிப்பிலே நிலைத்திருக்கிறதில்லை;","poem":1},{"text":"அவர்கள் அழிந்துபோகும் மிருகங்களைப்போலவே இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"தங்களிலேயே நம்பிக்கை வைக்கிறவர்களின் முடிவு இதுவே;","poem":1},{"text":"இவர்கள் சொல்வதையெல்லாம் கேட்டுப் பின்பற்றுகிறவர்களின் நிலையும் அதுவே.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்கள் செம்மறியாடுகளைப்போல சாவுக்கென்றே நியமிக்கப்பட்டுள்ளார்கள்;","poem":1},{"text":"மரணம் அவர்களின் மேய்ப்பனாயிருக்கும்.","poem":2},{"lineBreak":true},{"text":"நீதிமான்கள் காலையில் அவர்களை ஆளுகை செய்வார்கள்;","poem":2},{"text":"அவர்கள் அரண்மனையில் நிலைத்திராமல்,","poem":1},{"text":"கல்லறை அவர்களுடைய உருவத்தை அழித்துவிடும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆனால், இறைவனோ என் உயிரைப் பாதாளத்திலிருந்து மீட்டுக்கொள்வார்;","poem":1},{"text":"அவர் நிச்சயமாக என்னைத் தம்மிடத்தில் ஏற்றுக்கொள்வார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"பிறர் செல்வந்தர்களாகி,","poem":1},{"text":"அவர்கள் வீட்டின் செழிப்பு அதிகரிக்கும்போது, திடுக்கிடாதே;","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஏனெனில் அவர்கள் சாகும்போது, தம்முடன் ஒன்றையும் கொண்டுபோகமாட்டார்கள்;","poem":1},{"text":"அவர்களுடைய செழிப்பும் அவர்களைப் பின்தொடராது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்கள் உயிரோடிருந்தபோது,","poem":1},{"text":"தங்களை ஆசீர்வதிக்கப்பட்டவர்கள் என்று எண்ணினார்கள்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் செழிப்படைந்து இருக்கும்போது மனிதர் அவர்களைப் புகழ்ந்தார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"ஆனால் அவர்கள் தங்களுடைய முன்னோர்களைப் போலவே மரிப்பார்கள்;","poem":1},{"text":"வாழ்வின் ஒளியை இனி ஒருபோதும் காணமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"செல்வந்தராயிருந்தும் அறிவு இல்லாதிருந்தால்","poem":1},{"text":"அவர்கள் அழிந்துபோகும் மிருகத்தைப் போல் இருக்கிறார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/49.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/50.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/48.json","previousChapterAudioLinks":{},"numberOfVerses":20}