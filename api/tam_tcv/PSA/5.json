{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":5,"content":[{"type":"hebrew_subtitle","content":["புல்லாங்குழல்களுடன் பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என் வார்த்தைகளுக்குச் செவிகொடும்,","poem":1},{"text":"என் பெருமூச்சைக் கவனியும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உதவிக்காய் கதறும் என் சத்தத்தைக் கேளும்,","poem":1},{"text":"என் அரசனே, என் இறைவனே,","poem":2},{"lineBreak":true},{"text":"உம்மிடமே நான் வேண்டுகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே, காலையிலே என் குரலைக் கேளும்;","poem":1},{"text":"நான் என் வேண்டுதல்களைக் காலையில் உம்முன் வைத்து,","poem":2},{"lineBreak":true},{"text":"எதிர்பார்ப்புடன் காத்திருப்பேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீர் கொடுமையானதில் மகிழ்ச்சியடையும் இறைவன் அல்ல;","poem":1},{"text":"தீயவர் உம்முடன் குடியிருக்க முடியாது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"திமிர் பிடித்தவர்கள்","poem":1},{"text":"உமது சமுகத்தில் நிற்கமுடியாது;","poem":2},{"text":"அநியாயம் செய்யும் எல்லோரையும் நீர் வெறுக்கிறீர்.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"பொய் சொல்கிறவர்களை நீர் அழிக்கிறீர்;","poem":2},{"text":"இரத்த வெறியரையும் வஞ்சகமுள்ள மனிதரையும்","poem":1},{"text":"யெகோவா அருவருக்கிறார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனால் நானோ, உமது மிகுந்த உடன்படிக்கையின் அன்பினாலே","poem":1},{"text":"உமது வீட்டிற்கு வந்து,","poem":2},{"text":"உம்முடைய பரிசுத்த ஆலயத்தை நோக்கி","poem":1},{"text":"பயபக்தியுடன் வணங்குவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவே, என் எதிராளிகளின் நிமித்தம்","poem":1},{"text":"உம்முடைய நீதியில் என்னை வழிநடத்தும்;","poem":2},{"lineBreak":true},{"text":"உமது வழியை எனக்கு முன்பாக நேராக்கும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களுடைய வாயின் வார்த்தை ஒன்றைகூட நம்பமுடியாது;","poem":1},{"text":"அவர்களுடைய இருதயம் அழிவினால் நிரம்பியிருக்கிறது;","poem":2},{"text":"அவர்களின் தொண்டையோ திறந்திருக்கும் சவக்குழி;","poem":1},{"text":"அவர்கள் தங்கள் நாவினால் வஞ்சகம் பேசுகிறார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இறைவனே, அவர்களைக் குற்றவாளிகள் என்று தீர்ப்பளியும்;","poem":1},{"text":"அவர்களுடைய சதித்திட்டங்களினாலேயே அவர்கள் விழுந்துபோகட்டும்.","poem":2},{"text":"அவர்களுடைய அநேக பாவங்களின் நிமித்தம், அவர்களைத் துரத்திவிடும்;","poem":1},{"text":"ஏனெனில், அவர்கள் உமக்கு விரோதமாகக் கலகம் செய்திருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஆனால் உம்மிடத்தில் அடைக்கலம் புகுவோர் அனைவரும் மகிழ்ச்சியடையட்டும்;","poem":1},{"text":"அவர்கள் சந்தோஷத்தினால் என்றென்றும் பாடட்டும்;","poem":2},{"text":"உமது பெயரை நேசிக்கிறவர்கள் உம்மில் களிப்படையும்படி,","poem":1},{"text":"அவர்களை உமது பாதுகாப்பினால் மூடிக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவாவே, நீர் நிச்சயமாகவே நீதிமான்களை ஆசீர்வதிக்கிறவர்;","poem":1},{"text":"ஒரு கேடயத்தைப் போல, உமது தயவினால் நீர் அவர்களைச் சூழ்ந்துகொள்ளுவீர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":12}