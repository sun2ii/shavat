{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":50,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"வல்லமையுள்ள இறைவனாகிய யெகோவா பேசுகிறார்,","poem":1},{"text":"அவர் சூரியன் உதிக்கும் இடத்திலிருந்து,","poem":2},{"lineBreak":true},{"text":"அது மறையும் இடம் வரையுமுள்ள முழு உலகத்தையும் அழைக்கிறார்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பூரண அழகுள்ள சீயோனிலிருந்து","poem":1},{"text":"இறைவன் பிரகாசிக்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நம்முடைய இறைவன் வருகிறார்,","poem":1},{"text":"அவர் மவுனமாய் இருக்கமாட்டார்;","poem":2},{"text":"அவருக்கு முன்னாக நெருப்பு சுட்டெரித்துச் செல்கிறது;","poem":1},{"text":"அவரைச் சுற்றிப் புயல் சீற்றத்துடன் வீசுகிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் தமது மக்களை நியாயந்தீர்க்கும்படியாக,","poem":1},{"text":"மேலேயுள்ள வானங்களையும் பூமியையும் அழைத்துச் சொல்கிறார்:","poem":2}]},{"type":"verse","number":5,"content":[{"text":"“பலியினால் என்னுடன் உடன்படிக்கை செய்த,","poem":1},{"text":"பரிசுத்தவான்களை ஒன்றுகூட்டுங்கள்.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வானங்கள் அவருடைய நீதியை அறிவிக்கின்றன;","poem":1},{"text":"அவர் நியாதிபதியாகிய இறைவன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“என் மக்களே, கேளுங்கள், நான் பேசுவேன்;","poem":1},{"text":"இஸ்ரயேலே, நான் உனக்கு விரோதமாகச் சாட்சி கூறுவேன்:","poem":2},{"lineBreak":true},{"text":"நான் இறைவன், நானே உங்கள் இறைவன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எப்பொழுதும் எனக்கு முன்பாக இருக்கும் உங்கள் பலிகளுக்காகவோ,","poem":1},{"text":"அல்லது உங்கள் தகன காணிக்கைகளுக்காகவோ நான் உங்களைக் கண்டிக்கவில்லை.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"உங்கள் வீட்டிலிலுள்ள காளைகளோ,","poem":1},{"text":"உங்கள் தொழுவத்திலுள்ள வெள்ளாடுகளோ எனக்கு வேண்டியதில்லை.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஏனெனில் காட்டிலுள்ள எல்லா மிருகங்களும்","poem":1},{"text":"ஆயிரக்கணக்கான குன்றுகளிலுள்ள ஆடுமாடுகளும் என்னுடையவைகள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"மலைகளிலுள்ள ஒவ்வொரு பறவையையும் நான் அறிவேன்;","poem":1},{"text":"வயல்வெளிகளிலுள்ள உயிரினங்களும் என்னுடையவைகள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நான் பசியாயிருந்தால் உங்களிடம் சொல்லமாட்டேன்;","poem":1},{"text":"ஏனெனில் உலகமும் அதிலுள்ள யாவும் என்னுடையவைகள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் காளைகளின் இறைச்சியை உண்டு,","poem":1},{"text":"ஆட்டுக்கடாக்களின் இரத்தத்தைக் குடிப்பேனோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“நீங்கள் இறைவனாகிய எனக்கு உங்கள் நன்றிக் காணிக்கைகளைப் பலியிடுங்கள்;","poem":1},{"text":"மகா உன்னதமான இறைவனாகிய எனக்கு உங்கள் நேர்த்திக் கடன்களை நிறைவேற்றுங்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"துன்ப நாளில் என்னை நோக்கி மன்றாடிக் கூப்பிடுங்கள்,","poem":1},{"text":"நான் உங்களை விடுவிப்பேன்; நீங்கள் என்னை மகிமைப்படுத்துவீர்கள்.”","poem":2}]},{"type":"verse","number":16,"content":["கொடியவர்களுக்கு இறைவன் சொல்கிறதாவது:",{"text":"“என் சட்டங்களைக் கூறுவதற்கும்,","poem":1},{"text":"என் உடன்படிக்கையை உங்கள் உதடுகளினால் உச்சரிப்பதற்கும்","poem":2},{"lineBreak":true},{"text":"உங்களுக்கு என்ன உரிமை இருக்கிறது?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"என்னுடைய அறிவுறுத்தலை வெறுத்து,","poem":1},{"text":"என் வார்த்தைகளை உங்களுக்குப் பின்னாக எறிந்துவிடுகிறீர்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நீங்கள் திருடனைக் காணும்போது அவனோடு சேர்ந்துகொள்கிறீர்கள்;","poem":1},{"text":"விபசாரக்காரருடனும் நீங்கள் பங்குகொள்கிறீர்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"நீங்கள் உங்கள் வாயைத் தீமைக்காக பயன்படுத்துகிறீர்கள்;","poem":1},{"text":"உங்கள் நாவை வஞ்சகத்தைப் பேசப் பயன்படுத்துகிறீர்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நீங்கள் உங்கள் சகோதரனுக்கு விரோதமாய்ப் பேசுகிறீர்கள்;","poem":1},{"text":"இடைவிடாமல் உங்கள் சகோதரனையே தூற்றுகிறீர்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"இவற்றை நீங்கள் செய்தபோது நான் மவுனமாய் இருந்தேன்;","poem":1},{"text":"நானும் உங்களைப்போலவே இருப்பேன் என்று நினைத்தீர்கள்.","poem":2},{"text":"ஆனால் நான் உங்களைக் கடிந்துகொண்டு,","poem":1},{"text":"உங்கள் கண்களுக்கு முன்பாகவே உங்களைக் குற்றஞ்சாட்டுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“இறைவனை மறக்கிறவர்களே, இதைக் கவனியுங்கள்;","poem":1},{"text":"இல்லாவிட்டால் நான் உங்களை முற்றிலும் தண்டித்துப் போடுவேன்;","poem":2},{"lineBreak":true},{"text":"ஒருவரும் உங்களைத் தப்புவிக்கமாட்டார்கள்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நன்றி பலியைச் செலுத்துகிறவன் என்னைக் கனம்பண்ணுகிறான்;","poem":1},{"text":"இறைவனாகிய என் இரட்சிப்பை நான் குற்றமற்றவனுக்குக் காண்பிப்பேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/50.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/51.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/49.json","previousChapterAudioLinks":{},"numberOfVerses":23}