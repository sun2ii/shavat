{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":51,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம். தாவீது பத்சேபாளுடன் விபசாரம் செய்தபின், இறைவாக்கினன் நாத்தான் அவனிடம் வந்து, அவன் பாவத்தை உணர்த்திய பின்பு பாடிய சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, உமது அன்பின் நிமித்தம்","poem":1},{"text":"எனக்கு இரக்கம் காட்டும்,","poem":2},{"text":"உமது பெரிதான கருணையின் நிமித்தம்","poem":1},{"text":"என் மீறுதல்களை நீக்கிவிடும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் அநியாயங்கள் எல்லாவற்றையும் நீர் கழுவி,","poem":1},{"text":"என் பாவத்திலிருந்து என்னைச் சுத்தமாக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"என் மீறுதல்களை நான் அறிவேன்;","poem":1},{"text":"என் பாவம் எப்பொழுதும் எனக்கு முன்பாக இருக்கிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உமக்கு எதிராக, உமக்கு எதிராக மட்டுமே நான் பாவம் செய்தேன்;","poem":1},{"text":"உமது பார்வையில் தீமையானதைச் செய்திருக்கிறேன்;","poem":2},{"text":"ஆதலால், உம்முடைய தீர்ப்பில் நீர் சரியானவர்,","poem":1},{"text":"உம்முடைய நியாய விசாரணையில் நீர் நீதியானவராயிருக்கிறீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நிச்சயமாகவே நான் பிறந்ததிலிருந்து பாவியாயிருக்கிறேன்;","poem":1},{"text":"என் தாய் என்னைக் கர்ப்பந்தரித்ததில் இருந்தே நான் பாவியாய் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஆனாலும், நான் கருப்பையிலிருந்தே உண்மையாயிருக்க நீர் விரும்புகிறீர்;","poem":1},{"text":"அந்த மறைவான இடத்திலிருந்தே நீர் ஞானத்தை எனக்குத் தெரியப்படுத்துவீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஈசோப்புத் தளையினால் என்னைச் சுத்தப்படுத்தும், அப்பொழுது நான் சுத்தமாவேன்;","poem":1},{"text":"என்னைக் கழுவும், அப்பொழுது நான் வெண்பனியைப் பார்க்கிலும் வெண்மையாவேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் மகிழ்ச்சியையும், சந்தோஷத்தையும் கேட்கும்படிச் செய்யும்;","poem":1},{"text":"நீர் நொறுக்கிய என் எலும்புகள் களிகூரட்டும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"என் பாவங்களைக் காணாதபடி உமது முகத்தை மறைத்து,","poem":1},{"text":"என் எல்லா அநியாயத்தையும் நீக்கிவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"இறைவனே, தூய்மையான இருதயத்தை என்னில் படைத்து,","poem":1},{"text":"நிலையான ஆவியை எனக்குள் புதுப்பியும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உமது சமுகத்தில் இருந்து என்னைத் தள்ளிவிட வேண்டாம்,","poem":1},{"text":"உமது பரிசுத்த ஆவியானவரை என்னிடமிருந்து எடுத்துக்கொள்ளவும் வேண்டாம்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உமது இரட்சிப்பின் மகிழ்ச்சியைத் எனக்குத் திரும்பத்தாரும்;","poem":1},{"text":"விரும்பி நடக்கும் ஆவியை தந்து என்னைத் தாங்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"அப்பொழுது நான் குற்றம் செய்கிறவர்களுக்கு உமது வழிகளைப் போதிப்பேன்;","poem":1},{"text":"பாவிகள் உம்மிடம் மனந்திரும்புவார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"இறைவனே, இரத்தப்பழியிலிருந்து என்னை விடுவியும்;","poem":1},{"text":"நீர் என்னை இரட்சிக்கும் இறைவன்.","poem":2},{"lineBreak":true},{"text":"எனது நாவு உமது நீதியைப் பாடும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"யெகோவாவே, என் உதடுகளைத் திறந்தருளும்;","poem":1},{"text":"அதினால் என் வாய் உம்முடைய புகழை அறிவிக்கும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீர் பலியை விரும்புவதில்லை, விரும்பினால் நான் அதைக் கொண்டுவருவேன்;","poem":1},{"text":"தகன காணிக்கையிலும் நீர் மகிழ்வதில்லை.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இறைவனுக்கு உகந்த பலி உடைந்த ஆவிதான்;","poem":1},{"text":"இறைவனே, குற்றத்தை உணர்ந்து உடைந்த இதயத்தை","poem":2},{"lineBreak":true},{"text":"நீர் புறக்கணிக்கமாட்டீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"உமது தயவின்படி சீயோனுக்கு நன்மை செய்யும்;","poem":1},{"text":"எருசலேமின் மதில்களைக் கட்டும்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அப்பொழுது முழு தகன காணிக்கைகளிலும்,","poem":1},{"text":"சர்வாங்க தகன காணிக்கையான நீதி பலிகளிலும் நீர் மகிழ்ச்சியடைவீர்;","poem":2},{"lineBreak":true},{"text":"உமது பலிபீடத்தின்மேல் காளைகளை அர்ப்பணிப்பார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/51.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/52.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/50.json","previousChapterAudioLinks":{},"numberOfVerses":19}