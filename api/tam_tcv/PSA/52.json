{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":52,"content":[{"type":"hebrew_subtitle","content":["தாவீது அகிமெலேக்கின் வீட்டிற்கு சென்றான் என்று ஏதோமியனாகிய தோவேக்கு வந்து சவுலுக்கு சொன்னபோது பாடிய மஸ்கீல் என்னும் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"பலவானே, ஏன் தீமையைப்பற்றி பெருமை பாராட்டுகிறாய்?","poem":1},{"text":"இறைவனுடைய உடன்படிக்கையின் அன்பு","poem":2},{"lineBreak":true},{"text":"எந்நாளும் உள்ளது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"வஞ்சகம் செய்கிறவனே,","poem":1},{"text":"உன் நாவு அழிவை ஏற்படுத்த சதி செய்கிறது;","poem":2},{"lineBreak":true},{"text":"அது தீட்டப்பட்ட சவரக்கத்தியைப் போலிருக்கிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீ நன்மையைப் பார்க்கிலும் தீமையையும்","poem":1},{"text":"உண்மை பேசுவதைவிட பொய்யையும் விரும்புகிறாய்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"வஞ்சக நாவே,","poem":1},{"text":"நீ அனைத்துத் தீங்கான வார்த்தைகளை விரும்புகிறாய்!","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இறைவன் உன்னை நிச்சயமாகவே நித்திய அழிவுக்குள்ளாக்குவார்:","poem":1},{"text":"அவர் உன்னை உன் கூடாரத்திலிருந்து விலக்கி,","poem":2},{"lineBreak":true},{"text":"வாழ்வோரின் நாட்டிலிருந்து உன்னை வேரோடு எடுத்துப் போடுவார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இதைக்கண்டு நீதிமான்கள் பயப்படுவார்கள்;","poem":1},{"text":"அவர்கள் அவனைப் பார்த்து சிரித்து,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“இதோ பாருங்கள்,","poem":1},{"text":"இவன் இறைவனைத் தன் அரணாகக் கொள்ளாதவன்;","poem":2},{"text":"தன் மிகுந்த செல்வத்தில் நம்பிக்கை வைத்து,","poem":1},{"text":"தன்னுடைய அக்கிரமத்தில் பலத்துக்கொண்ட மனிதன்!” என்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஆனால் நானோ, செழித்து வளரும் ஒலிவமரத்தைப் போல்","poem":1},{"text":"இறைவனின் ஆலயத்தில் இருக்கிறேன்;","poem":2},{"text":"நான் இறைவனுடைய உடன்படிக்கையின் அன்பில்","poem":1},{"text":"எப்பொழுதும் நம்பிக்கை வைத்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீர் எனக்குச் செய்தவற்றிற்காக உமது பரிசுத்தவான்களுக்கு முன்பாக","poem":1},{"text":"நான் உம்மை என்றென்றும் துதிப்பேன்,","poem":2},{"text":"உம்முடைய பெயரில் நான் எதிர்பார்ப்பை வைப்பேன்;","poem":1},{"text":"இறைவனே உமது பெயர் நல்லது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":9}