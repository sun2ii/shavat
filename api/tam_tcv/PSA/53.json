{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":53,"content":[{"type":"hebrew_subtitle","content":["மகலாத் என்னும் பாணியில் வாசிக்கப்படும்படி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட மஸ்கீல் என்னும் தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"மூடன் தன் இருதயத்தில், “இறைவன் இல்லை” என்று சொல்கிறான்.","poem":1},{"text":"அவர்கள் சீர்கெட்டவர்கள்;","poem":2},{"text":"அவர்களுடைய வழிகள் இழிவானவை;","poem":1},{"text":"அவர்களில் நன்மை செய்கிறவன் ஒருவனும் இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"இறைவன் பரலோகத்திலிருந்து","poem":1},{"text":"மனுமக்களை நோக்கிப் பார்க்கிறார்,","poem":2},{"text":"அவர்களில் விவேகமுள்ளவனாவது","poem":1},{"text":"இறைவனைத் தேடுகிறவனாவது உண்டோ என்று பார்க்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எல்லோரும் வழிவிலகி, சீர்கெட்டுப் போனார்கள்;","poem":1},{"text":"நன்மை செய்கிறவன் ஒருவனுமில்லை,","poem":2},{"lineBreak":true},{"text":"ஒருவனாகிலும் இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"தீயோர்களுக்கு எதுவும் தெரியாதோ?","poem":1},{"lineBreak":true},{"text":"மனிதர் அப்பம் சாப்பிடுவதுபோல், அவர்கள் என் மக்களை விழுங்குகிறார்கள்;","poem":1},{"text":"அவர்கள் இறைவனை வழிபடுவதுமில்லை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பயப்படுவதற்கு எதுவுமில்லாத இடத்திலே,","poem":1},{"text":"அவர்கள் பயத்தில் நடுங்குகிறார்கள்.","poem":2},{"text":"உன்னைத் தாக்கியவர்களின் எலும்புகளை இறைவன் சிதறடித்தார்;","poem":1},{"text":"இறைவன் அவர்களைப் புறக்கணித்தபடியால், நீ அவர்களை வெட்கப்படுத்தினாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"சீயோனிலிருந்து இஸ்ரயேலுக்கு இரட்சிப்பு வெளிவருவதாக!","poem":1},{"text":"இறைவன் தமது மக்களின் சிறையிருப்பைத் திருப்பும்போது,","poem":2},{"lineBreak":true},{"text":"யாக்கோபு மகிழட்டும், இஸ்ரயேல் களிகூரட்டும்!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":6}