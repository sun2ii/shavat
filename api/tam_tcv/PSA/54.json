{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":54,"content":[{"type":"hebrew_subtitle","content":["தாவீது தங்களிடம் ஒளிந்திருக்கிறான் என்று சீப்பூரார் சவுலுக்கு சொன்னபோது, கம்பியிசைக் கருவிகளுடன் தாவீது பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட மஸ்கீல் என்னும் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, உமது பெயரால் என்னைக் காப்பாற்றும்,","poem":1},{"text":"உமது வல்லமையால் எனக்கு நியாயம் செய்யும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இறைவனே, என் மன்றாட்டைக் கேளும்;","poem":1},{"text":"என் வாயின் வார்த்தைகளுக்குச் செவிகொடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"தற்பெருமையுள்ளவர்கள் என்னைத் தாக்குகிறார்கள்;","poem":1},{"text":"இறைவனை மதியாத, ஈவு இரக்கமற்ற மனிதர்","poem":2},{"lineBreak":true},{"text":"என் உயிரை வாங்கத் தேடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நிச்சயமாக இறைவனே எனக்கு உதவுபவர்;","poem":1},{"text":"யெகோவாவே என்னை ஆதரிக்கிறவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"எனக்குத் தீமை செய்கிறவர்கள் மேலேயே அவர்களுடைய தீமை திரும்பட்டும்;","poem":1},{"text":"உமது உண்மையின் நிமித்தம் அவர்களை தண்டித்துவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நான் உமக்கு சுயவிருப்பக் காணிக்கையைப் பலியிடுவேன்;","poem":1},{"text":"யெகோவாவே, நான் உமது பெயரைத் துதிப்பேன், ஏனெனில் அது நல்லது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நீர் என்னை என்னுடைய எல்லாக் கஷ்டங்களிலிருந்தும் விடுவித்தீர்;","poem":1},{"text":"என் கண்கள் என் எதிரிகளின் வீழ்ச்சியைப் பார்த்தன.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":7}