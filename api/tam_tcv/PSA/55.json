{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":55,"content":[{"type":"hebrew_subtitle","content":["கம்பியிசைக் கருவிகளுடன் பாடி பாடகர் குழுத் தலைவனுக்குப் ஒப்புவிக்கப்பட்ட மஸ்கீல் என்னும் தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, என் மன்றாட்டைக் கேளும்;","poem":1},{"text":"என் வேண்டுதலை அசட்டை பண்ணாதிரும்.","poem":2}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"எனக்குச் செவிகொடுத்து, எனக்குப் பதில் தாரும்;","poem":2},{"text":"என் சிந்தனைகள் என்னைக் கலங்கப்பண்ணுகின்றன; நான் மிகவும் கலக்கமடைந்துள்ளேன்.","poem":1}]},{"type":"verse","number":3,"content":[{"text":"எதிரியின் வார்த்தையினாலும்","poem":2},{"lineBreak":true},{"text":"கொடியவர்களின் அழுத்தத்தினாலும் கலக்கமடைந்துள்ளேன்;","poem":2},{"text":"அவர்கள் என்மேல் வேதனையைக் கொண்டுவந்து,","poem":1},{"text":"கோபத்தில் என்னை பகைக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"என் இருதயம் எனக்குள்ளே கடுந்துயரப்படுகிறது;","poem":1},{"text":"மரணபயம் என்னைத் தாக்குகின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"பயமும் நடுக்கமும் என்னைப் பற்றிக்கொண்டன;","poem":1},{"text":"பயங்கரம் என்னை மூடிக்கொண்டது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நானோ, “புறாவின் சிறகுகள் எனக்கு இருந்திருந்தால்!","poem":1},{"text":"பறந்துபோய் இளைப்பாறுவேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் தொலைவில் தப்பிப்போய்","poem":1},{"text":"பாலைவனத்தில் தங்குவேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"கடும் காற்றுக்கும் புயலுக்கும்","poem":1},{"text":"தப்பிக்கும்படி விரைந்து செல்வேன்” என்றேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, அவர்களுக்கு குழப்பத்தை உண்டுபண்ணி,","poem":1},{"text":"அவர்களுடைய பேச்சிலும் பிளவுண்டாக்கும்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில், நான் வன்முறையையும் போராட்டத்தையுமே பட்டணத்தில் காண்கிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் இரவும் பகலும் பட்டண மதில்களின்மேல் பதுங்கித் திரிகிறார்கள்;","poem":1},{"text":"கொடுமையும் பிரச்சனையும் அதனுள்ளே காணப்படுகின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பேரழிவு பட்டணத்தின் நடுவே இருக்கிறது;","poem":1},{"text":"அச்சுறுத்தல்களும் பொய்களும் அதின் வீதிகளைவிட்டு ஒருபோதும் நீங்குவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"என்னை நிந்திப்பவன் என் பகைவனல்ல;","poem":1},{"text":"அப்படியிருந்தால், அதை நான் சகித்துக்கொள்ளலாம்;","poem":2},{"text":"எனக்கு விரோதமாக ஒரு எதிரி எழும்பியிருந்தால்,","poem":1},{"text":"நான் அவனிடமிருந்து மறைந்துகொள்வேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஆனால் எதிர்த்தவன் என்னைப்போன்ற மனிதனும்,","poem":1},{"text":"எனக்கு அறிமுகமான, என் நெருங்கிய நண்பனுமே.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நாங்கள் ஒன்றுகூடி","poem":1},{"text":"இனிய ஆலோசனைபண்ணி,","poem":2},{"text":"மக்கள் கூட்டத்துடன்","poem":1},{"text":"இறைவனின் ஆலயத்திற்குச் சென்றோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"மரணம் என் எதிரிகளைத் திடீரெனப் பற்றிக்கொள்ளட்டும்;","poem":1},{"text":"தீமை அவர்கள் மத்தியில் குடியிருப்பதால்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் உயிருடன் பாதாளத்தில் இறங்குவார்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"நானோ இறைவனை நோக்கிக் கூப்பிடுகிறேன்;","poem":1},{"text":"யெகோவா என்னைக் காப்பாற்றுவார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"மாலையிலும் காலையிலும்","poem":1},{"text":"மத்தியான வேளையிலும் நான் துயரத்தால் முறையிடுவேன்;","poem":2},{"lineBreak":true},{"text":"அவர் என் குரலைக் கேட்பார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"பலர் என்னை எதிர்த்தபோதும்,","poem":1},{"text":"எனக்கு விரோதமாய் நடத்தப்படும் யுத்தத்தில் இருந்து","poem":2},{"lineBreak":true},{"text":"அவர் என்னைத் தீங்கின்றி மீட்டுக்கொண்டார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"சிங்காசனத்தில் என்றென்றும் அமர்ந்திருக்கும் இறைவன் கேட்டு,","poem":1},{"text":"அவர்களைத் தாழ்த்திவிடுவார்;","poem":2},{"text":"அவர்கள் இறைவனுக்குப் பயப்படவும் இல்லை,","poem":1},{"text":"ஒருபோதும் தங்கள் வழிகளை மாற்றிக்கொள்ளவுமில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"என் தோழன் தனது நண்பர்களைத் தாக்குகிறான்;","poem":1},{"text":"அவன் தன் உடன்படிக்கையையும் மீறுகிறான்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவனுடைய பேச்சு வெண்ணெயைப் போல் மிருதுவானது,","poem":1},{"text":"ஆனாலும் அவனுடைய இருதயத்தில் யுத்தம் மறைந்திருக்கிறது;","poem":2},{"text":"அவனுடைய வார்த்தைகள் எண்ணெயைப் பார்க்கிலும் மென்மையானவை,","poem":1},{"text":"ஆனாலும் அவை கூர்மையான வாள்களைப்போல் இருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"உங்கள் கவலைகளை யெகோவாமேல் வைத்து விடுங்கள்;","poem":1},{"text":"அவர் உங்களைத் தாங்குவார்;","poem":2},{"text":"நீதிமான்களை அவர்","poem":1},{"text":"ஒருபோதும் விழுந்துபோக விடமாட்டார்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஆனால் இறைவனே, நீரோ கொடுமையானவனை","poem":1},{"text":"அழிவின் குழியில் இறங்கப்பண்ணுவீர்;","poem":2},{"text":"இரத்த வெறியரும் ஏமாற்றுக்காரர்களும்","poem":1},{"text":"தங்கள் ஆயுளின் பாதிநாட்கள்கூட உயிர் வாழமாட்டார்கள்.","poem":2},{"lineBreak":true},{"text":"ஆனால் என்னைப் பொறுத்தவரையில், நான் உம்மிடத்திலேயே நம்பிக்கையாய் இருக்கிறேன்.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/55.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/56.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/54.json","previousChapterAudioLinks":{},"numberOfVerses":23}