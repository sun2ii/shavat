{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":56,"content":[{"type":"hebrew_subtitle","content":["பெலிஸ்தியர் தாவீதை காத் ஊரில் பிடித்தபோது, “தொலைவில் உள்ள கருவாலி மரத்தில் வாழும் மெளன மாடப்புறா” என்ற இசையில் தாவீது பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட மிக்தாம் என்னும் தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, என்மேல் இரக்கமாயிரும்,","poem":1},{"text":"மனிதன் என்னை தாக்குகிறான்;","poem":2},{"lineBreak":true},{"text":"நாள்தோறும் போர்செய்து என்னை அடக்குகிறான்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் பகைவர்கள் நாள்தோறும் என்னை அழுத்துகிறார்கள்;","poem":1},{"text":"அநேகர் தங்கள் பெருமையோடு என்னை எதிர்த்துப் போரிடுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நான் பயப்படும் நாளில், உம்மை நம்புவேன்.","poem":1}]},{"type":"verse","number":4,"content":[{"text":"நான் இறைவனுடைய வார்த்தைகளைப் புகழ்வேன்;","poem":2},{"text":"அவரை நம்பியிருக்கிறேன், நான் பயப்படமாட்டேன்.","poem":1},{"text":"அழிவுக்குரிய மனிதன் எனக்கு என்ன செய்யமுடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"எப்பொழுதும் அவர்கள் என் வார்த்தைகளைப் புரட்டுகிறார்கள்;","poem":1},{"text":"அவர்களின் திட்டங்கள் அனைத்தும் எனக்குத் தீமை செய்வதற்கே.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் ஒன்றுகூடி பதுங்கி இருக்கிறார்கள்,","poem":1},{"text":"என் உயிரைப் பறிக்க விருப்பம் உள்ளவர்களாய்","poem":2},{"lineBreak":true},{"text":"மறைந்திருந்து என் காலடிகளைக் கவனிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் அக்கிரமங்களின் நிமித்தம் அவர்களைத் தப்பவிடாதேயும்;","poem":1},{"text":"இறைவனே, உமது கோபத்தில் மக்கள் கூட்டத்தைக் கீழே வீழ்த்திவிடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"நீர் என் அலைச்சலை கணக்கில் வைத்திருக்கிறீர்;","poem":1},{"text":"என் கண்ணீரை உமது தோற்குடுவையில் சேர்த்து வைத்திருக்கிறீர்;","poem":2},{"lineBreak":true},{"text":"அவை உமது பதிவேட்டில் இருக்கிறது அல்லவா?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நான் உம்மிடம் உதவிக்கேட்டு கூப்பிடும்போது,","poem":1},{"text":"என் பகைவர் புறமுதுகிட்டு ஓடுவார்கள்;","poem":2},{"lineBreak":true},{"text":"அதினால் இறைவன் என்னுடன் இருக்கிறார் என அறிந்துகொள்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நான் இறைவனுடைய வார்த்தையைப் புகழ்வேன்;","poem":1},{"text":"யெகோவாவினுடைய வார்த்தையைப் புகழ்வேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான் இறைவனை நம்பியிருக்கிறேன், நான் பயப்படமாட்டேன்;","poem":1},{"text":"மனிதன் எனக்கு என்ன செய்யமுடியும்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"இறைவனே, நான் உமக்கு நேர்த்திக் கடன்களைச் செய்திருக்கிறேன்;","poem":1},{"text":"நன்றிக் காணிக்கைகளை நான் உமக்குச் செலுத்துவேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"ஏனெனில், நீர் என்னை மரணத்திலிருந்து மீட்டுக்கொண்டீர்,","poem":1},{"text":"என் கால்களை இடறாமல் காத்துக்கொண்டீர்;","poem":2},{"text":"இதினால் நான் இறைவனுக்கு முன்பாக","poem":1},{"text":"வாழ்வின் வெளிச்சத்தில் நடப்பேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":13}