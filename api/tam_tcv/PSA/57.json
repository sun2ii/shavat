{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":57,"content":[{"type":"hebrew_subtitle","content":["தாவீது சவுலிடமிருந்து தப்பிக் குகைக்குள் ஒளிந்துகொண்டிருந்தபோது, “அழிக்காதே” என்ற இசையில் பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட மிக்தாம் என்னும் தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என்மேல் இரக்கமாயிரும், இறைவனே, என்மேல் இரக்கமாயிரும்,","poem":1},{"text":"என் ஆத்துமா உம்மிடத்தில் தஞ்சம் அடைகிறது.","poem":2},{"text":"பேரழிவு கடந்து செல்லுமளவும்,","poem":1},{"text":"நான் உமது சிறகுகளின் நிழலில் புகலிடம் கொள்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"எனக்காக யாவையும் செய்து முடிக்கும்,","poem":1},{"text":"மகா உன்னதமானவரான இறைவனை நோக்கி நான் கூப்பிடுவேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர் பரலோகத்திலிருந்து உதவி அனுப்பி என்னைக் காப்பாற்றுவார்,","poem":1},{"text":"என்னைத் தாக்குகிறவர்களைக் கடிந்துகொள்வார்;","poem":2},{"lineBreak":true},{"text":"இறைவன் தமது உடன்படிக்கையின் அன்பையும் உண்மையையும் அனுப்புவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நான் சிங்கங்களின் நடுவில் இருக்கிறேன்;","poem":1},{"text":"என்னை எதிர்க்கும் மனுமக்களின் மத்தியில் இருக்கிறேன்;","poem":2},{"text":"அவர்களுடைய பற்கள் ஈட்டிகளும் அம்புகளுமாய் இருக்கிறது;","poem":1},{"text":"அவர்களின் நாவுகளோ கூர்மையான வாள்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இறைவனே, வானங்களுக்கு மேலாகப் புகழ்ந்து உயர்த்தப்படுவீராக;","poem":1},{"text":"உமது மகிமை பூமியெங்கும் இருப்பதாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"என் கால்களுக்கு அவர்கள் வலையை விரித்தார்கள்;","poem":1},{"text":"துயரத்தினால் நான் சோர்ந்து போனேன்.","poem":2},{"text":"அவர்கள் என் பாதையில் ஒரு குழியைத் தோண்டினார்கள்;","poem":1},{"text":"அதற்குள் அவர்களே விழுந்து போனார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"என் இருதயம் உறுதியாயிருக்கிறது,","poem":1},{"text":"இறைவனே, என் இருதயம் உறுதியாயிருக்கிறது;","poem":2},{"lineBreak":true},{"text":"நான் இசையமைத்துப் பாடுவேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் ஆத்துமாவே, விழித்தெழும்பு!","poem":1},{"text":"யாழே, வீணையே, விழித்தெழுங்கள்!","poem":2},{"lineBreak":true},{"text":"நான் அதிகாலையில் விழித்தெழுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"ஆண்டவரே, நாடுகள் மத்தியில் நான் உம்மைத் துதிப்பேன்;","poem":1},{"text":"மக்கள் மத்தியில் நான் உம்மைப் பாடுவேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஏனெனில் உமது உடன்படிக்கையின் அன்பு பெரியது, அது வானங்களை எட்டுகிறது;","poem":1},{"text":"உமது சத்தியம் ஆகாயங்களை எட்டுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"இறைவனே, வானங்களுக்கு மேலாகப் புகழ்ந்து உயர்த்தப்படுவீராக;","poem":1},{"text":"உமது மகிமை பூமியெங்கும் இருப்பதாக.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":11}