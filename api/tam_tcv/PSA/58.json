{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":58,"content":[{"type":"hebrew_subtitle","content":["“அழிக்காதே” என்ற இசையில் வாசிக்க பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட மிக்தாம் என்னும் தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"ஆளுநர்களே, உண்மையிலேயே நீங்கள் நீதியைத்தான் பேசுகிறீர்களோ?","poem":1},{"text":"மனிதர் மத்தியில் நியாயமாய்த் தீர்ப்பு செய்கிறீர்களோ?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இல்லை, நீங்கள் உங்கள் இருதயத்தில் அநீதியையே திட்டமிடுகிறீர்கள்;","poem":1},{"text":"உங்கள் கைகள் பூமியின்மேல் வன்முறையைப் பரப்புகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"கொடியவர்கள் பிறப்பிலிருந்தே வழிதப்பிப் போகிறார்கள்;","poem":1},{"text":"அவர்கள் கர்ப்பத்திலிருந்தே பொய்களைப் பேசுகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்களுடைய நச்சுத்தன்மை ஒரு பாம்பின் நஞ்சைப்போல் இருக்கிறது;","poem":1},{"text":"அவர்கள் காதை அடைத்துக்கொள்கிற செவிட்டு நாகம்போல இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இந்த நாகபாம்போ, பாம்பாட்டி எவ்வளவு திறமையாய் ஊதினாலும்","poem":1},{"text":"அவனுடைய இசைக்குக் கவனம் செலுத்தாது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"இறைவனே, அவர்களுடைய வாயிலுள்ள பற்களை உடைத்துப்போடும்;","poem":1},{"text":"யெகோவாவே, அந்த சிங்கங்களின் கடைவாய்ப் பற்களைப் பிடுங்கிப்போடும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஓடிப்போகும் தண்ணீரைப்போல, அவர்கள் மறைந்துபோகட்டும்;","poem":1},{"text":"அவர்கள் தங்கள் வில்லை இழுக்கும்போது, அவர்களுடைய அம்புகள் முறிந்து போகட்டும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நகரும்போதே கரைந்து போகும் நத்தையைப்போல, அவர்கள் மறைந்துபோகட்டும்;","poem":1},{"text":"ஒரு பெண்ணின் வயிற்றில் சிதைந்த கருவைப்போல,","poem":2},{"lineBreak":true},{"text":"சூரியனை அவர்கள் பார்க்காமல் போகட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"முட்செடிகள் எரிந்து பானை அதின் சூட்டை உணருவதற்கு முன்பதாகவே,","poem":1},{"text":"பச்சையானதையும் எரிந்துபோனதையும் சுழற்காற்று வாரியதைப்போல","poem":2},{"lineBreak":true},{"text":"கொடியவர்களை வாரிக்கொள்ளும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் பழிவாங்கப்படும்போது நீதிமான்கள் மகிழ்வார்கள்;","poem":1},{"text":"கொடியவர்களின் உயிர் நீதிமான்களின் பாதபடியில் இருக்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அப்பொழுது மனிதர்,","poem":1},{"text":"“நிச்சயமாகவே நீதிமான்களுக்கு வெற்றி உண்டென்றும்","poem":2},{"lineBreak":true},{"text":"பூமியை நியாயந்தீர்க்கும் இறைவன் உண்டு” என்றும் சொல்வார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":11}