{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":59,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் வீட்டின் அருகே காத்திருந்து அவனை கொல்வதற்கு சவுல் ஆட்களை அனுப்பியபோது, “அழிக்காதே” என்ற இசையில் வாசிக்கத் தாவீது பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட மிக்தாம் என்னும் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, பகைவர்களிடமிருந்து என்னை விடுவியும்;","poem":1},{"text":"எனக்கெதிராக எழும்புகிறவர்களிடமிருந்து என்னைக் காத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"தீமை செய்கிறவர்களிடமிருந்து என்னை விடுவியும்;","poem":1},{"text":"என்னைக் கொல்ல முயற்சிக்கும் வெறியர்களிடமிருந்து என்னைக் காப்பாற்றும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"அவர்கள் எப்படி எனக்காகப் பதுங்கிக் காத்திருக்கிறார்கள் என்று பாரும்!","poem":1},{"text":"யெகோவாவே, நான் குற்றமோ பாவமோ செய்யாதிருக்க,","poem":2},{"lineBreak":true},{"text":"சிலர் பயங்கரமானச் சதியை எனக்கெதிராகச் செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் ஒரு தவறும் செய்யவில்லை;","poem":1},{"text":"இருந்தும் என்னைத் தாக்குவதற்கு அவர்கள் ஆயத்தமாயிருக்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"எனக்கு உதவிசெய்ய எழுந்தருளும்; எனது நிலைமையைப் பாரும்!","poem":2}]},{"type":"verse","number":5,"content":[{"text":"சேனைகளின் இறைவனாகிய யெகோவாவே,","poem":1},{"text":"இஸ்ரயேலின் இறைவனே,","poem":2},{"text":"இந்த எல்லா மக்களையும் தண்டிப்பதற்காக எழுந்தருளும்;","poem":1},{"text":"கொடுமையான துரோகிகளுக்கு இரக்கம் காட்டாதிரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"மாலையிலே அவர்கள்","poem":1},{"text":"நாய்களைப்போல் குரைத்துக்கொண்டு திரும்பிவருகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"நகரத்தைச் சுற்றித் திரிகிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் வாய் திறந்து என்னத்தைப் பேசுகிறார்கள் என்று பாரும்;","poem":1},{"text":"அவர்கள் தங்கள் உதடுகளிலிருந்து வரும் வார்த்தைகள் வாள் போன்றவை,","poem":2},{"lineBreak":true},{"text":"அவர்கள், “நாங்கள் சொல்வதை கேட்கிறவர் யார்?” என்று கூறுகிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆனால் யெகோவாவே, நீரோ அவர்களைப் பார்த்துச் சிரிக்கிறீர்;","poem":1},{"text":"அவர்களைப் பார்த்து ஏளனம் செய்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"நீர் என் பெலன், உமக்காக நான் காத்திருக்கிறேன்;","poem":1},{"text":"இறைவனே, நீரே என் கோட்டை,","poem":2}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"நான் சார்ந்திருக்கும் இறைவன்.","poem":2},{"lineBreak":true},{"text":"தமது உடன்படிக்கையின் அன்பினால் என்னைச் சந்திப்பார்.","poem":1},{"text":"என் பகைவர்களின் வீழ்ச்சியை பார்க்கும்படி செய்வார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எங்கள் கேடயமான யெகோவாவே, அவர்களை ஒரேயடியாய் அழிக்கவேண்டாம்;","poem":1},{"text":"அப்படியானால், என் மக்கள் அதைப்பற்றி மறந்துவிடுவார்கள்.","poem":2},{"text":"உமது வல்லமையினால் நிலையற்றவர்களாக்கி,","poem":1},{"text":"அவர்களைத் தாழ்த்திவிடும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர்களுடைய உதடுகளின் பேச்சு,","poem":1},{"text":"அவர்களுடைய வாயின் பாவமாயிருக்கிறது;","poem":2},{"lineBreak":true},{"text":"அவர்கள் சொல்லும் சாபமும் பொய்யும்,","poem":2},{"text":"அவர்களை பெருமையில் சிக்கவைப்பதாக.","poem":1}]},{"type":"verse","number":13,"content":[{"text":"உமது கோபத்தால் அவர்களை தண்டித்துவிடும்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் இல்லாமல் போகும்வரை அவர்களை தண்டித்துவிடும்.","poem":2},{"text":"அப்பொழுது இறைவன்,","poem":1},{"text":"யாக்கோபின்மேல் ஆளுகை செய்கிறார் என்று","poem":2},{"lineBreak":true},{"text":"பூமியின் எல்லைகள்வரை எல்லோரும் அறிந்துகொள்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"மாலையிலே அவர்கள்","poem":1},{"text":"நாய்களைப்போல் குரைத்துக்கொண்டு திரும்பிவருகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"நகரத்தைச் சுற்றித் திரிகிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"உணவுக்காக அவர்கள் அலைந்து திரிகிறார்கள்;","poem":1},{"text":"திருப்தியடையாவிட்டால் முறுமுறுத்துக் கொண்டே இரவைக் கடக்கிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆனால் நானோ, உமது பெலனைக் குறித்துப் பாடுவேன்;","poem":1},{"text":"காலையிலே உமது உடன்படிக்கையின் அன்பை குறித்துப் பாடுவேன்;","poem":2},{"text":"ஏனெனில் நீரே எனது கோட்டையும்","poem":1},{"text":"துன்பகாலங்களில் என் புகலிடமுமாய் இருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"என் பெலனே, நான் உமக்குத் துதி பாடுவேன்;","poem":1},{"text":"இறைவனே, நீரே என் கோட்டையும்,","poem":2},{"lineBreak":true},{"text":"என் அன்பான இறைவனுமாயிருக்கிறீர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/59.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/60.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/58.json","previousChapterAudioLinks":{},"numberOfVerses":17}