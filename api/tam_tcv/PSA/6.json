{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":6,"content":[{"type":"hebrew_subtitle","content":["கம்பியிசைக் கருவிகளுடன் செமினீத் என்னும் இராகத்தில் வாசிக்க இசைக்குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்"]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, உமது கோபத்தில் என்னைக் கண்டியாதேயும்;","poem":1},{"text":"உம்முடைய கடுங்கோபத்தில் என்னைத் தண்டியாதேயும்;","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவே, நான் சோர்ந்துபோகிறேன், என்னில் இரக்கமாயிரும்;","poem":1},{"text":"யெகோவாவே, என் எலும்புகள் வேதனைக்குள்ளாகி இருக்கின்றன, என்னைக் குணமாக்கும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என் ஆத்துமா துயரத்துக்குள்ளாகி இருக்கிறது.","poem":1},{"text":"எவ்வளவு காலத்திற்கு யெகோவாவே, இது எவ்வளவு காலத்திற்கு?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே, என் பக்கமாய்த் திரும்பி என்னை விடுவியும்;","poem":1},{"text":"உமது உடன்படிக்கையின் அன்பினிமித்தம் என்னைக் காப்பாற்றும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறந்தவர்களில் ஒருவரும் உம்மை நினைவுகூர்வதில்லை.","poem":1},{"text":"பிரேதக் குழியிலிருந்து உம்மைத் துதிக்கிறவன் யார்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நான் கலங்கியே இளைத்துப் போனேன்.","poem":1},{"lineBreak":true},{"text":"இரவு முழுவதும் என் அழுகையின் வெள்ளத்தால் நான் என் படுக்கையை நிரப்பி,","poem":1},{"text":"நான் அதைக் கண்ணீரால் நனைக்கிறேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் கண்கள் துக்கத்தால் பெலவீனமடைகின்றன;","poem":1},{"text":"என் எல்லா பகைவரின் நிமித்தம் அவைகள் மங்குகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அக்கிரம செய்கைக்காரர்களே, நீங்கள் எல்லோரும் என்னைவிட்டு அகன்றுபோங்கள்;","poem":1},{"text":"ஏனெனில் யெகோவா என் அழுகையைக் கேட்டிருக்கிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இரக்கத்திற்கான என் கதறலை யெகோவா கேட்டார்;","poem":1},{"text":"யெகோவா என் மன்றாட்டை ஏற்றுக்கொள்வார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என்னுடைய எல்லா எதிரிகளும் வெட்கப்பட்டு மனச்சோர்வு அடைவார்கள்;","poem":1},{"text":"அவர்கள் பின்னிட்டுத் திரும்பி திடீரென வெட்கப்பட்டுப் போவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":10}