{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":60,"content":[{"type":"hebrew_subtitle","content":["ஆராம் நகராயிம், ஆராம் சேபா என்ற அரசுகளோடு தாவீது போர் செய்கையில் யோவாப் உப்புப் பள்ளத்தாக்கில் பன்னீராயிரம் ஏதோமியரை வெற்றிக்கொண்டபோது, “உடன்படிக்கையின் லீலிமலர்” என்ற இசையில் மிக்தாம் என்னும் சங்கீதத்தை போதனையாக தாவீது பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, நீர் எங்களைப் புறக்கணித்துவிட்டீர், எங்களை சிதறடித்துவிட்டீர்;","poem":1},{"text":"நீர் கோபமாயிருந்தீர்; மறுபடியும் எங்களிடம் திரும்பி வாரும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீர் நாட்டை அதிரப்பண்ணி, அதைப் பிளந்து விட்டீர்;","poem":1},{"text":"அசைந்து கொண்டிருக்கும் அந்த வெடிப்புகளைச் சரிப்படுத்தும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"கடினமான காரியங்களை நீர் உமது மக்களை காணச்செய்தீர்;","poem":1},{"text":"தடுமாறச் செய்யும் திராட்சை இரசத்தை எங்களுக்குக் குடிக்கக் கொடுத்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால் உமக்குப் பயந்து நடக்கிறவர்கள்,","poem":1},{"text":"வில்லுக்கு தப்பித்துக் கொள்ளுமாறு ஒரு கொடியை உயர்த்தினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நீர் நேசிப்பவர்கள் மீட்கப்படும்படி, நீர் எங்களைக் காப்பாற்றி,","poem":1},{"text":"உமது வலதுகரத்தின் வல்லமையினால் எங்களுக்கு உதவிசெய்யும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இறைவன் தமது பரிசுத்த இடத்திலிருந்து பேசியது:","poem":1},{"text":"“நான் வெற்றிகொண்டு சீகேமைப் பிரித்தெடுப்பேன்;","poem":2},{"lineBreak":true},{"text":"சுக்கோத்தின் பள்ளத்தாக்கை அளந்துகொடுப்பேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கீலேயாத் என்னுடையது, மனாசேயும் என்னுடையது;","poem":1},{"text":"எப்பிராயீம் என் தலைக்கவசம்,","poem":2},{"lineBreak":true},{"text":"யூதா என் செங்கோல்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மோவாப் என் கழுவும் பாத்திரம்,","poem":1},{"text":"நான் ஏதோமின்மீது என் காலணியை எறிவேன்;","poem":2},{"lineBreak":true},{"text":"நான் பெலிஸ்தியாவை வென்று முழக்கமிடுவேன்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"அரண்சூழ்ந்த நகரத்திற்கு யார் என்னைக் கொண்டுவருவார்?","poem":1},{"text":"யார் என்னை ஏதோமுக்கு வழிநடத்துவார்?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இறைவனே, எங்களைப் புறக்கணித்தவரும்,","poem":1},{"text":"எங்கள் படைகளுடன் போகாதிருந்தவரும் நீரல்லவா?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பகைவரை மேற்கொள்ள எங்களுக்கு உதவும்;","poem":1},{"text":"ஏனெனில் மனிதனின் உதவியோ பயனற்றது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இறைவனாலேயே நாம் வெற்றிபெறுவோம்;","poem":1},{"text":"அவர் நமது பகைவரை மிதித்துப்போடுவார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/60.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/61.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/59.json","previousChapterAudioLinks":{},"numberOfVerses":12}