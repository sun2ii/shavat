{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":61,"content":[{"type":"hebrew_subtitle","content":["கம்பியிசைக் கருவிகளுடன் பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என் இறைவனே, என் கதறுதலைக் கேளும்,","poem":1},{"text":"என் மன்றாட்டுக்குச் செவிகொடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"பூமியின் கடைசிகளில் இருந்து உம்மை நோக்கிக் கூப்பிடுவேன்;","poem":1},{"text":"என் இருதயம் சோர்ந்து போகையில் உம்மைக் கூப்பிடுகிறேன்;","poem":2},{"lineBreak":true},{"text":"என்னைப் பார்க்கிலும் உயரமான கற்பாறையினிடத்திற்கு என்னை வழிநடத்தும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீரே என் புகலிடமாய் இருக்கிறீர்;","poem":1},{"text":"பகைவருக்கு எதிரான பலமுள்ள கோபுரமாய் இருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நான் என்றென்றும் உமது கூடாரத்தில் குடியிருப்பேன்;","poem":1},{"text":"உமது சிறகுகளின் அடைக்கலத்தில் தஞ்சமடைவேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறைவனே, நீர் என் நேர்த்திக்கடன்களைக் கேட்டிருக்கிறீர்;","poem":1},{"text":"உமது பெயருக்குப் பயந்து நடக்கிறவர்களுக்குரிய உரிமைச்சொத்தை","poem":2},{"lineBreak":true},{"text":"நீர் எனக்குத் தந்திருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அரசனின் வாழ்நாட்களை அதிகமாக்கும்;","poem":1},{"text":"அவனுடைய வருடங்களை தலைமுறை தலைமுறைகளாக அதிகமாக்கும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இறைவனின் சமுகத்தில் அவன் என்றைக்கும் சிங்காசனத்தில் அமர்ந்திருப்பானாக;","poem":1},{"text":"அவனைப் பாதுகாப்பதற்காக உமது உடன்படிக்கையின் அன்பையும்","poem":2},{"lineBreak":true},{"text":"உண்மையையும் நியமித்தருளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"அப்பொழுது நான் என்றென்றைக்கும் உமது பெயருக்குத் துதி பாடுவேன்;","poem":1},{"text":"நாள்தோறும் எனது நேர்த்திக் கடன்களை நிறைவேற்றுவேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":8}