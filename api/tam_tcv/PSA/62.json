{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":62,"content":[{"type":"hebrew_subtitle","content":["எதுத்தூன் என்னும் பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என் ஆத்துமா இறைவனில் இளைப்பாறுகிறது;","poem":1},{"text":"என் இரட்சிப்பு அவரால் வருகிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவரே என் கன்மலையும் என் இரட்சிப்பும் என் கோட்டையுமாய் இருக்கிறார்;","poem":1},{"text":"நான் ஒருபோதும் அசைக்கப்படமாட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"எவ்வளவு காலத்திற்கு நீங்கள் என்னைத் தாக்குவீர்கள்?","poem":1},{"text":"நீங்கள் எல்லோரும் என்னைத் தூக்கி எறிந்துவிடுவீர்களா?","poem":2},{"lineBreak":true},{"text":"நான் சாய்ந்த சுவரைப் போலவும் தள்ளப்பட்ட வேலியைப் போலவும் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என்னுடைய உயர்ந்த நிலையிலிருந்து என்னைத் தள்ளி வீழ்த்துவதற்கு","poem":1},{"text":"அவர்கள் ஆலோசனை செய்கிறார்கள்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் பொய்களில் மகிழ்ச்சி கொள்கிறார்கள்;","poem":2},{"text":"அவர்கள் தங்கள் வாய்களினால் ஆசீர்வதிக்கிறார்கள்,","poem":1},{"text":"ஆனால் தங்களுடைய இருதயங்களிலோ சபிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஆம், என் ஆத்துமாவே, நீ இறைவனில் மட்டுமே இளைப்பாறு;","poem":1},{"text":"என் நம்பிக்கை அவரிடத்தில் இருக்கிறது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவரே என் கன்மலையும் என் இரட்சிப்பும்","poem":1},{"text":"என் கோட்டையுமாயிருக்கிறார்; நான் அசைக்கப்படமாட்டேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் இரட்சிப்பும் என் கனமும் இறைவனிடத்தில் இருக்கிறது;","poem":1},{"text":"இறைவன் என் பலமான கன்மலையும் என் புகலிடமுமாய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"மக்களே, எக்காலத்திலும் அவரை நம்புங்கள்;","poem":1},{"text":"உங்கள் இருதயங்களின் பாரங்களை அவரிடத்தில் இறக்கி வையுங்கள்;","poem":2},{"lineBreak":true},{"text":"இறைவனே நமது புகலிடம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"கீழ்க்குடி மனிதர் வெறும் சுவாசமே,","poem":1},{"text":"உயர்குடி மனிதர் வெறும் பொய்யே;","poem":2},{"text":"தராசில் நிறுக்கப்பட்டால் அவர்கள் ஒன்றுமில்லை;","poem":1},{"text":"அவர்கள் சுவாசத்திலும் லேசானவர்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"பயமுறுத்தி பறித்தெடுப்பதில் நம்பிக்கை வைக்காதே;","poem":1},{"text":"களவாடிய பொருட்களைக் குறித்துப் பெருமைகொள்ளாதே;","poem":2},{"text":"உனது செல்வங்கள் அதிகரித்தாலும்,","poem":1},{"text":"உன் இருதயத்தை அவைகளின்மேல் வைக்காதே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"இறைவன் ஒருமுறை பேசினார்,","poem":1},{"text":"நான் இரண்டுதரம் கேட்டிருக்கிறேன்:","poem":2},{"text":"“இறைவனே, வல்லமை உமக்கே உரியது,","poem":1}]},{"type":"verse","number":12,"content":[{"text":"ஆண்டவரே, உடன்படிக்கையின் அன்பும் உம்முடையது”;","poem":2},{"text":"நிச்சயமாகவே, “நீர் ஒவ்வொருவருக்கும்","poem":1},{"text":"அவனவன் செய்ததற்குத் தக்கதாக பலனளிப்பீர்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":12}