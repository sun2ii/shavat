{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":63,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் சங்கீதம். யூதாவின் வனாந்திரத்திலிருக்கும்போது பாடியது."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, நீரே என் இறைவன்,","poem":1},{"text":"நான் ஆர்வத்துடன் உம்மைத் தேடுகிறேன்;","poem":2},{"text":"தண்ணீரில்லாமல் வறண்டதும்,","poem":1},{"text":"காய்ந்ததுமான நிலத்திலே","poem":2},{"text":"என் ஆத்துமா உம்மேல் தாகமாக இருக்கிறது,","poem":1},{"text":"என் உடலோ உமக்காக ஏங்குகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"பரிசுத்த இடத்தில் நான் உம்மைக் கண்டேன்;","poem":1},{"text":"உமது வல்லமையையும் உமது மகிமையையும் கண்டறிந்தேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உமது உடன்படிக்கையின் அன்பு உயிரைப் பார்க்கிலும் சிறந்தது;","poem":1},{"text":"ஆகையால் என் உதடுகள் உம்மை மகிமைப்படுத்தும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் உயிருடன் இருக்கும்வரை உம்மைத் துதிப்பேன்;","poem":1},{"text":"ஜெபத்தில் உமது பெயரைச் சொல்லி என் கைகளை உயர்த்துவேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அறுசுவை உணவுகளால் திருப்தியடைவது போல, என் ஆத்துமா திருப்தியடையும்;","poem":1},{"text":"என் வாய் களிப்புள்ள உதடுகளினால் பாடி, உம்மைத் துதிக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"என் படுக்கையில் நான் உம்மை நினைக்கிறேன்;","poem":1},{"text":"இராக்காலங்களில் உம்மை தியானம் செய்கிறேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நீரே என் உதவியாயிருப்பதால்,","poem":1},{"text":"உமது சிறகுகளின் நிழலிலே நான் மகிழ்ச்சியுடன் பாடுவேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் உம்மை விடாமல் பற்றிக்கொண்டிருக்கிறேன்;","poem":1},{"text":"உமது வலதுகரம் என்னைத் தாங்குகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"என் உயிரை அழிக்கத் தேடுகிறவர்கள்","poem":1},{"text":"பூமியின் ஆழங்களில் இறங்குவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் வாளுக்கு ஒப்புக்கொடுக்கப்படுவார்கள்;","poem":1},{"text":"நரிகளுக்கு இரையாவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"ஆனால் அரசன் இறைவனில் மகிழ்வான்;","poem":1},{"text":"இறைவனுடைய பெயரில் சத்தியம்பண்ணுகிற யாவரும் அவரில் மேன்மைபாராட்டுவார்கள்;","poem":2},{"lineBreak":true},{"text":"பொய்யர்களுடைய வாய்களோ மூடப்படும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":11}