{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":64,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, நான் முறையிடும் என் குரலுக்குச் செவிகொடும்;","poem":1},{"text":"பகைவனின் பயமுறுத்தலிலிருந்து என் உயிரைப் பாதுகாத்துக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"கொடியவர்களின் சதியிலிருந்தும்,","poem":1},{"text":"ஆரவாரிக்கும் தீயவர்களின் கூட்டத்திலிருந்தும் என்னை மறைத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் தங்களுடைய நாவுகளை வாள்களைப்போல் கூராக்குகிறார்கள்;","poem":1},{"text":"தங்கள் சொற்களைப் பயங்கரமான அம்புகளைப்போல் எய்கிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்கள் மறைவிலிருந்து குற்றமற்றவன்மேல் எய்கிறார்கள்;","poem":1},{"text":"அவர்கள் பயமின்றி திடீரென அவன்மேல் எய்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"தீமையான திட்டமிடுவதில் அவர்கள் ஒருவரையொருவர் உற்சாகப்படுத்துகிறார்கள்;","poem":1},{"text":"தங்கள் கண்ணிகளை மறைத்து வைப்பதுபற்றி பேசிக்கொள்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"“நாம் என்ன செய்கிறோம் என்பதை யார் காணுவார்கள்?” என்கிறார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் அநீதி செய்ய சதிசெய்து,","poem":1},{"text":"“நாங்கள் ஒரு சிறந்த திட்டத்தை வகுத்துள்ளோம்!” என்கிறார்கள்.","poem":2},{"lineBreak":true},{"text":"நிச்சயமாகவே மனிதனின் மனமும் இருதயமும் ஆழமானவை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஆனால் இறைவன் அவர்களை அம்புகளால் எய்து தாக்குவார்;","poem":1},{"text":"உடனே அவர்கள் அடித்து வீழ்த்தப்படுவார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"இறைவன் அவர்களுடைய நாவுகளையே அவர்களுக்கெதிராக திரும்பப்பண்ணி,","poem":1},{"text":"அவர்களை அழிவுக்குள்ளாக்குவார்;","poem":2},{"lineBreak":true},{"text":"அவர்களைப் பார்ப்போர் அனைவரும் தங்கள் தலைகளை அசைத்துக் கேலி செய்வார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எல்லா மனிதரும் பயப்படுவார்கள்;","poem":1},{"text":"இறைவனின் செயல்களை அவர்கள் அறிவித்து,","poem":2},{"lineBreak":true},{"text":"அவர் செய்தவற்றைப்பற்றி சிந்திப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"நீதிமான்கள் யெகோவாவிடம் மகிழ்ந்து,","poem":1},{"text":"அவரிடத்தில் தஞ்சம் அடைவார்கள்;","poem":2},{"lineBreak":true},{"text":"இருதயத்தில் நீதியுள்ளோர் அனைவரும் அவரைப் புகழ்வார்கள்!","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":10}