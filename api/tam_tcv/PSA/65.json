{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":65,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, சீயோனிலே துதி உமக்காகக் காத்திருக்கிறது;","poem":1},{"text":"எங்கள் நேர்த்திக்கடன்கள் உமக்கென்றே நிறைவேற்றப்படும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மன்றாட்டைக் கேட்கிறவர் நீரே,","poem":1},{"text":"மனிதர் அனைவரும் உம்மிடம் வருவார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நாங்கள் பாவங்களில் மூழ்கியிருக்கையில்,","poem":1},{"text":"எங்கள் மீறுதல்களை நீர் மன்னித்தீர்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உமது ஆலய முற்றங்களில் வாழும்படியாக,","poem":1},{"text":"நீர் தெரிந்தெடுத்து சேர்த்துக்கொண்டவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்.","poem":2},{"text":"நாங்கள் உமது பரிசுத்த ஆலயமாகிய","poem":1},{"text":"உம்முடைய வீட்டின் நன்மைகளால் நிரப்பப்பட்டிருக்கிறோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"எங்கள் இரட்சகராகிய இறைவனே,","poem":1},{"text":"உம்முடைய அற்புதமான மற்றும் நேர்மையான செயல்களால்","poem":2},{"lineBreak":true},{"text":"நீர் எங்களுக்குப் பதில் தருகிறீர்;","poem":2},{"text":"பூமியின் கடைசிகளில் உள்ளவர்களுக்கும்","poem":1},{"text":"தூரத்திலுள்ள கடல்களில் உள்ளவர்களுக்கும் நீரே நம்பிக்கையாயிருக்கிறீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீரே பெலனைத் தரித்துக்கொண்டு,","poem":1},{"text":"உமது வல்லமையால் மலைகளை உருவாக்கினீர்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கடல்களின் இரைச்சலையும்","poem":1},{"text":"அலைகளின் இரைச்சலையும் அமைதிப்படுத்தி,","poem":2},{"lineBreak":true},{"text":"மக்கள் கூட்டத்தின் கலகத்தையும் அடக்கினீர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பூமியின் கடைசிகளில் வாழ்பவர்களும்","poem":1},{"text":"உம்முடைய அதிசயங்களைக் குறித்துப் பயப்படுகிறார்கள்.","poem":2},{"text":"விடியும் திசையிலிருந்தும் மாலைமங்கும் திசையிலிருந்தும்","poem":1},{"text":"நீர் மகிழ்ச்சியின் பாடல்களைத் தொனிக்கப் பண்ணுகிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"நிலத்தைக் கவனித்து அதற்கு நீர்ப்பாய்ச்சுகிறீர்;","poem":1},{"text":"நீர் அதைச் செழிப்பாக்குகிறீர்;","poem":2},{"text":"மக்களுக்குத் தானியத்தைக் கொடுக்கும்படி,","poem":1},{"text":"இறைவனின் நீரோடைகள் தண்ணீரால் நிறைந்திருக்கின்றன;","poem":2},{"lineBreak":true},{"text":"இவ்விதமாகவே நீர் அதை ஏற்படுத்தியிருக்கிறீர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீர் அதின் வரப்புகளை நனைத்து, அதின் வயல்களுக்குத் தண்ணீர் இறைத்து,","poem":1},{"text":"மழையினால் அதை மென்மையாக்கி, அதின் பயிர்களை ஆசீர்வதிக்கிறீர்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"வருடத்தை உமது நன்மையின் நிறைவினால் முடிசூட்டுகிறீர்;","poem":1},{"text":"நீர் செல்லும் இடமெல்லாம் வளம் நிரம்பி வழிகின்றது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பாலைவனத்திலும்கூட புல்வெளிகள் நிறைந்து இருக்கின்றன;","poem":1},{"text":"குன்றுகள் மகிழ்ச்சியினால் மூடப்பட்டுள்ளன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"புற்தரைகள் மந்தைகளினால் நிரம்பியுள்ளன;","poem":1},{"text":"பள்ளத்தாக்குகள் தானியத்தைப் போர்வைபோல் கொண்டிருக்கின்றன;","poem":2},{"lineBreak":true},{"text":"அவை சந்தோஷத்தால் ஆர்ப்பரித்துப் பாடுகின்றன.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":13}