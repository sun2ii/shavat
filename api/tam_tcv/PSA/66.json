{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":66,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட சங்கீதமாகிய பாட்டு."]},{"type":"verse","number":1,"content":[{"text":"பூமியிலுள்ளவர்களே, நீங்கள் எல்லோரும் சந்தோஷத்துடன்","poem":1},{"text":"இறைவனை ஆர்ப்பரித்துத் துதியுங்கள்!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவருடைய பெயரின் மகிமையைப் பாடுங்கள்;","poem":1},{"text":"அவருடைய துதியை மகிமையுள்ளதாக்குங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"இறைவனிடம் சொல்லுங்கள், “உமது செயல்கள் எவ்வளவு பிரமிக்கத்தக்கவை!","poem":1},{"text":"உமது வல்லமை பெரிதானது;","poem":2},{"lineBreak":true},{"text":"அதினால் பகைவர்கள் உமக்கு வஞ்சகம் பேசி அடங்குவார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பூமியிலுள்ள அனைவரும் உம்மைப் பணிந்து வழிபடுகிறார்கள்;","poem":1},{"text":"அவர்கள் உமக்குத் துதி பாடுகிறார்கள்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் உமது பெயருக்குத் துதி பாடுகிறார்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இறைவன் செய்துள்ளவற்றை வந்து பாருங்கள்;","poem":1},{"text":"மனிதரிடையே அவர் செய்யும் செயல்கள் எவ்வளவு பயப்படத்தக்கவை.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர் கடலை வறண்ட நிலமாக மாற்றினார்;","poem":1},{"text":"மக்கள் கால்நடையாய் தண்ணீரைக் கடந்தார்கள்;","poem":2},{"lineBreak":true},{"text":"வாருங்கள், அவரில் களிகூருவோம்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் தமது வல்லமையினால் என்றென்றைக்கும் அரசாளுகிறார்;","poem":1},{"text":"அவருடைய கண்கள் நாடுகளைக் கவனித்துப் பார்த்துக் கொண்டிருக்கின்றன;","poem":2},{"lineBreak":true},{"text":"கலகக்காரர் அவருக்கு எதிராக எழும்பாதிருக்கட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"எல்லா மக்களும், நம்முடைய இறைவனைத் துதியுங்கள்;","poem":1},{"text":"அவரைத் துதிக்கும் சத்தம் கேட்கப்படுவதாக.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர் நம்முடைய உயிர்களைப் பாதுகாத்திருக்கிறார்;","poem":1},{"text":"நம்முடைய பாதங்கள் சறுக்கிவிடாதபடி காத்துக்கொள்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இறைவனே, நீர் எங்களைச் சோதித்துப் பார்த்தீர்;","poem":1},{"text":"வெள்ளியைப்போல் எங்களைப் புடமிட்டுச் சுத்திகரித்தீர்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எங்களைச் சிறைபிடித்து,","poem":1},{"text":"எங்கள் முதுகுகளில் பாரங்களை சுமத்தினீர்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"மனிதரை எங்கள் தலையின்மேல் ஏறிப்போகச் செய்தீர்;","poem":1},{"text":"நாங்கள் நெருப்பையும் தண்ணீரையும் கடந்துசென்றோம்,","poem":2},{"lineBreak":true},{"text":"ஆனால் நீர் எங்களைச் செழிப்பான இடத்திற்கு கொண்டுவந்தீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"நான் தகன காணிக்கைகளுடன் உமது ஆலயத்திற்கு வருவேன்;","poem":1},{"text":"எனது நேர்த்திக் கடன்களை நிறைவேற்றுவேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் துன்பத்திலிருந்தபோது","poem":1},{"text":"என் உதடுகளைத் திறந்து, என் வாயினால் சொன்ன நேர்த்திக் கடன்களைச் செய்வேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நான் கொழுத்த மிருகங்களையும்","poem":1},{"text":"செம்மறியாட்டுக் கடாக்களையும் உமக்குப் பலியிடுவேன்;","poem":2},{"lineBreak":true},{"text":"நான் எருதுகளையும் வெள்ளாடுகளையும் காணிக்கையாகச் செலுத்துவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"இறைவனுக்குப் பயப்படுகிறவர்களே, நீங்கள் எல்லோரும் வந்து, செவிகொடுங்கள்;","poem":1},{"text":"அவர் எனக்குச் செய்தவற்றை நான் உங்களுக்குச் சொல்ல விரும்புகிறேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நான் என் வாயினால் அவரைச் சத்தமிட்டுக் கூப்பிட்டேன்;","poem":1},{"text":"அவருடைய துதி என் நாவில் இருந்தது.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"என் இருதயத்தில் பாவத்திற்கு இடமளித்திருந்தால்,","poem":1},{"text":"யெகோவா எனக்குச் செவிகொடுக்கமாட்டார்;","poem":2}]},{"type":"verse","number":19,"content":[{"text":"இறைவனோ நிச்சயமாய் எனக்குச் செவிகொடுத்து,","poem":1},{"text":"என் மன்றாட்டின் குரலைக் கேட்டார்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"என் மன்றாட்டைத் தள்ளிவிடாமல்,","poem":1},{"text":"என்னிடமிருந்து தமது உடன்படிக்கையின் அன்பை விலக்காமலிருந்த","poem":2},{"lineBreak":true},{"text":"இறைவனுக்குத் துதி உண்டாகட்டும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/66.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/67.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/65.json","previousChapterAudioLinks":{},"numberOfVerses":20}