{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":67,"content":[{"type":"hebrew_subtitle","content":["கம்பியிசைக் கருவிகளுடன் பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவன் நம்மேல் கிருபையாயிருந்து நம்மை ஆசீர்வதிப்பாராக;","poem":1},{"text":"அவர் தமது முகத்தை நம்மீது பிரகாசிக்கச் செய்வாராக.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இறைவனே, உமது வழிகள் பூமியிலும்,","poem":1},{"text":"உமது இரட்சிப்பு எல்லா நாடுகளுக்கு மத்தியிலும் அறியப்படும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"இறைவனே, மக்கள் உம்மைத் துதிப்பார்களாக;","poem":1},{"text":"எல்லா மக்களும் உம்மைத் துதிப்பார்களாக.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீர் மக்கள் கூட்டத்தை நீதியாய் ஆட்சிசெய்து,","poem":1},{"text":"பூமியின் நாடுகளுக்கு வழிகாட்டுவதால்,","poem":2},{"lineBreak":true},{"text":"மக்கள் மகிழ்ந்து களிப்புடன் பாடுவார்களாக.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறைவனே, மக்கள் உம்மைத் துதிப்பார்களாக;","poem":1},{"text":"எல்லா மக்களும் உம்மைத் துதிப்பார்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அப்பொழுது நிலம் விளைச்சலைக் கொடுக்கும்;","poem":1},{"text":"இறைவனாகிய எங்கள் இறைவனே எங்களை ஆசீர்வதிப்பார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இறைவன் எங்களை இன்னும் ஆசீர்வதிப்பார்;","poem":1},{"text":"ஆகையால் பூமியின் எல்லைகளில் உள்ளவர்கள் எல்லோரும் அவருக்குப் பயப்படுவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/67.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/68.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/66.json","previousChapterAudioLinks":{},"numberOfVerses":7}