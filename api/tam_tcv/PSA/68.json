{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":68,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதமாகிய பாட்டு."]},{"type":"verse","number":1,"content":[{"text":"இறைவன் எழுந்திருப்பாராக, அவருடைய பகைவர் சிதறடிக்கப்படுவார்களாக;","poem":1},{"text":"அவருடைய எதிரிகள் அவருக்கு முன்பாகப் பயந்து ஓடுவார்களாக.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"காற்றினால் புகை அடித்துச் செல்லப்படுகிறது போல, நீர் அவர்களை ஊதிவிடும்;","poem":1},{"text":"நெருப்பின் முன்னே மெழுகு உருகுவது போல,","poem":2},{"lineBreak":true},{"text":"இறைவனுக்கு முன்பாகக் கொடியவர்கள் அழிவார்களாக.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"ஆனால் நீதிமான்கள் மகிழ்ந்து","poem":1},{"text":"இறைவனுக்கு முன்பாகக் களிகூருவார்களாக;","poem":2},{"lineBreak":true},{"text":"அவர்கள் சந்தோஷப்பட்டு மகிழ்வார்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"இறைவனைப் பாடுங்கள், அவருடைய பெயருக்குத் துதி பாடுங்கள்;","poem":1},{"text":"மேகங்களில் ஏறிப் போகிறவரை புகழ்ந்து உயர்த்துங்கள்;","poem":2},{"lineBreak":true},{"text":"யெகோவா என்பது அவருடைய பெயர்; அவருக்கு முன்பாகக் களிகூருங்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறைவன் தமது பரிசுத்த வாழ்விடத்தில்","poem":1},{"text":"தகப்பன் இல்லாதவர்களுக்குத் தகப்பனாகவும்","poem":2},{"lineBreak":true},{"text":"விதவைகளுக்கு பாதுகாவலராகவும் இருக்கிறார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இறைவன் தனிமையானவர்களுக்கு குடும்பத்தை ஏற்படுத்துகிறார்;","poem":1},{"text":"சிறைக் கைதிகளை விடுவித்து, செழிப்பான வாழ்வுக்குள் நடத்திச் செல்கிறார்;","poem":2},{"lineBreak":true},{"text":"கலகக்காரரோ வெயிலால் வறண்ட நாட்டில் வாழ்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"இறைவனே, நீர் உமது மக்களுக்கு முன்பாகச் சென்று,","poem":1},{"text":"அவர்களைப் பாலைவனத்தின் வழியே அணிவகுத்து வருகையில்,","poem":2}]},{"type":"verse","number":8,"content":[{"text":"சீனாய் மலையின் இறைவனுக்குமுன்,","poem":1},{"text":"இஸ்ரயேலின் இறைவனுக்குமுன்","poem":2},{"lineBreak":true},{"text":"பூமி அதிர்ந்து, வானங்கள் மழையைப் பொழிந்தன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இறைவனே, நீர் நிறைவான மழையைக் கொடுத்தீர்;","poem":1},{"text":"இளைத்துப்போன உமது உரிமைச்சொத்திற்கு நீர் புத்துயிர் அளித்தீர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உமது மக்கள் அதில் குடியமர்ந்தார்கள்;","poem":1},{"text":"இறைவனே, உமது நிறைவான நன்மையிலிருந்து ஏழைகளுக்கு வழங்கினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"யெகோவா வார்த்தையை அறிவித்தார்;","poem":1},{"text":"அதைப் பிரசித்தப்படுத்தியதோ பெரிய கூட்டம்:","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“இராணுவத்தையுடைய அரசர்கள் ஓடினார்கள்;","poem":1},{"text":"வீட்டிலிருந்த பெண்கள் கொள்ளைப்பொருட்களைப் பங்கிட்டுக் கொள்கிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீங்கள் ஆட்டு மந்தைகளின் மத்தியில் படுத்திருந்தபோதிலும்,","poem":1},{"text":"வெள்ளியினால் மூடப்பட்ட புறாச்சிறகுகளையும்","poem":2},{"lineBreak":true},{"text":"பசும்பொன்னினால் அலங்கரிக்கப்பட்ட இறகுகளையும் கண்டுபிடிப்பீர்கள்.”","poem":2}]},{"type":"verse","number":14,"content":[{"text":"எல்லாம் வல்லவர் நாட்டின் அரசர்களைச் சிதறடித்தது","poem":1},{"text":"சல்மோன் மலையில் பனிமழை பெய்ததுபோல இருந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"பாசான் மலை இறைவனுடைய மலை;","poem":1},{"text":"பாசான் மலை சிகரங்களையுடைய மலை.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"சிகரங்களையுடைய மலையே, ஏன் சீயோன் மலையின்மேல் பொறாமைப்படுகிறீர்கள்?","poem":1},{"text":"அங்குதான் இறைவன் தாம் ஆளும்படி விரும்பினார்;","poem":2},{"lineBreak":true},{"text":"அங்குதான் என்றென்றும் யெகோவா குடியிருப்பார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இறைவனின் தேர்கள் பத்தாயிரங்களும்,","poem":1},{"text":"ஆயிரம் ஆயிரங்களுமாய் இருக்கின்றன;","poem":2},{"lineBreak":true},{"text":"யெகோவா சீனாய் மலையிலிருந்து அவருடைய பரிசுத்த இடத்திற்கு வந்தார்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நீர் மேலே ஏறிச்சென்றபோது,","poem":1},{"text":"சிறைப்பட்ட அநேகரை உம்மோடு எடுத்துச்சென்றீர்;","poem":2},{"text":"மனிதரிடமிருந்தும் கலகக்காரரிடமிருந்தும் நீர் நன்கொடைகளைப் பெற்றுக்கொண்டீர்;","poem":1},{"text":"இறைவனாகிய யெகோவாவின் வாழ்விடம் அதுவே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"தினந்தோறும் நம் பாரங்களைச் சுமக்கிற நமது இரட்சகரும்","poem":1},{"text":"இறைவனுமான யெகோவாவுக்குத் துதி உண்டாகட்டும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நம்முடைய இறைவன் காப்பாற்றுகிற இறைவன்;","poem":1},{"text":"வல்லமையுள்ள யெகோவா மரணத்திலிருந்து நம்மை தப்புவிக்கிறார்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"இறைவன் நிச்சயமாகவே தமது பகைவர்களின் தலைகளை உடைப்பார்;","poem":1},{"text":"தங்கள் பாவங்களில் தொடர்கிறவர்களின் முடியுள்ள","poem":2},{"lineBreak":true},{"text":"உச்சந்தலைகளை அவர் நொறுக்கிப்போடுவார்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"யெகோவா கூறுவதாவது, “நான் அவர்களைப் பாசானிலிருந்து கொண்டுவருவேன்;","poem":1},{"text":"நான் அவர்களைக் கடலின் ஆழங்களிலிருந்தும் கொண்டுவருவேன்,","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அப்பொழுது உங்கள் எதிரிகளின் இரத்தம் உங்கள் பாதங்களில் பதியும்;","poem":1},{"text":"உங்கள் நாய்களும் தங்கள் பங்கிற்கு நாவினால் நக்கும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":24,"content":[{"text":"என் இறைவனும் என் அரசனுமானவர்,","poem":1},{"text":"பரிசுத்த இடத்திற்குள் உமது ஊர்வலம் போவதை, இறைவனே அனைவரும் கண்டனர்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"முன்னால் பாடகரும், அவர்களுக்குப் பின்னால் இசைக் கலைஞர்களும் போகிறார்கள்;","poem":1},{"text":"அவர்களுடன் இளம்பெண்கள் தம்புராவை வாசித்துக்கொண்டு போகிறார்கள்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"மகா சபையில் இறைவனைத் துதியுங்கள்.","poem":1},{"text":"இஸ்ரயேலின் சபையிலே யெகோவாவைத் துதியுங்கள்;","poem":2}]},{"type":"verse","number":27,"content":[{"text":"சிறிய கோத்திரமாகிய பென்யமீன் அவர்களை வழிநடத்துகிறான்;","poem":1},{"text":"பின்பு யூதா கோத்திரப் பிரபுக்களின் பெருங்கூட்டமும்,","poem":2},{"lineBreak":true},{"text":"செபுலோன், நப்தலி கோத்திரப் பிரபுக்களும் அங்கே இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":28,"content":[{"text":"இறைவனே, உமது வல்லமையை கட்டளையிடும்;","poem":1},{"text":"எங்கள் இறைவனே, முன்பு நீர் செயலாற்றியதுபோல","poem":2},{"lineBreak":true},{"text":"உமது பலத்தை எங்களுக்குக் காண்பியும்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"எருசலேமில் இருக்கும் உமது ஆலயத்திற்காக","poem":1},{"text":"அரசர்கள் உமக்கு நன்கொடைகளைக் கொண்டுவருவார்கள்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"நாணல்களின் நடுவிலுள்ள விலங்கினங்களைக் கடிந்துகொள்ளும்;","poem":1},{"text":"கன்றுகளோடுள்ள காளைகள் கூட்டத்தைப் போன்ற மக்களைக் கடிந்துகொள்ளும்;","poem":2},{"text":"அவர்கள் வெள்ளி அன்பளிப்புகளுடன் உமக்கு முன்பாகப் பணிந்துகொள்ளட்டும்;","poem":1},{"text":"யுத்தத்தில் மகிழ்கிற மக்களைச் சிதறடியும்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"எகிப்திலிருந்து அரச தூதுவர்கள் வருவார்கள்;","poem":1},{"text":"எத்தியோப்பியர் இறைவனிடத்தில் தங்களை சமர்ப்பிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"பூமியின் அரசுகளே, இறைவனைப் பாடுங்கள்;","poem":1},{"text":"யெகோவாவுக்குத் துதி பாடுங்கள்.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"வானங்களில் பூர்வீக வானங்களில் ஏறிச் செல்கிறவரை,","poem":1},{"text":"வல்லமையுள்ள சத்தத்துடன் முழங்குகிறவரைப் பாடுங்கள்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"இறைவனுடைய வல்லமையை அறிவியுங்கள்;","poem":1},{"text":"அவருடைய மகத்துவம் இஸ்ரயேலின் மேலாக இருக்கிறது;","poem":2},{"lineBreak":true},{"text":"அவருடைய வல்லமை ஆகாயங்களில் இருக்கிறது.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"இறைவனே, நீர் உமது பரிசுத்த இடத்தில் பிரமிக்கத்தக்கவராய் இருக்கிறீர்;","poem":1},{"text":"இஸ்ரயேலின் இறைவன் தமது மக்களுக்கு பெலனையும் வல்லமையையும், கொடுக்கிறார்.","poem":2},{"lineBreak":true},{"text":"இறைவனுக்குத் துதி உண்டாவதாக!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/68.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/69.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/67.json","previousChapterAudioLinks":{},"numberOfVerses":35}