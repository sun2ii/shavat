{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":69,"content":[{"type":"hebrew_subtitle","content":["“லீலிமலர்” என்ற இசையில் பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, என்னைக் காப்பாற்றும்;","poem":1},{"text":"வெள்ளம் என் கழுத்துமட்டும் வந்துவிட்டது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"கால் ஊன்ற முடியாத சேறு நிறைந்த ஆழங்களில் நான் அமிழ்ந்திருக்கிறேன்;","poem":1},{"text":"ஆழமான வெள்ளத்தில்","poem":2},{"text":"நான் அகப்பட்டு விட்டேன்;","poem":1},{"text":"வெள்ளம் என்னை மூடுகிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"சத்தமிட்டுக் கூப்பிட்டு நான் களைத்துப் போனேன்;","poem":1},{"text":"என் தொண்டையும் வறண்டுபோயிற்று;","poem":2},{"text":"என் இறைவனைத் தேடி","poem":1},{"text":"என் கண்கள் மங்கிப்போயின.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"காரணம் இல்லாமல் என்னை வெறுக்கிறவர்கள்","poem":1},{"text":"என் தலைமுடியைவிட அதிகமாய் இருக்கிறார்கள்;","poem":2},{"text":"அநேகர் காரணமில்லாமல் எனக்குப் பகைவர்களாய் இருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் என்னை அழிக்கத் தேடுகிறார்கள்.","poem":2},{"text":"நான் திருடாததைத் திருப்பிக் கொடுக்க","poem":1},{"text":"கட்டாயப்படுத்தப்படுகிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"இறைவனே, என் புத்தியீனத்தை நீர் அறிந்திருக்கிறீர்;","poem":1},{"text":"என் குற்றம் உமக்கு மறைக்கப்பட்டிருக்கவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"சேனைகளின் யெகோவாவாகிய ஆண்டவரே,","poem":1},{"text":"உமக்காகக் காத்திருக்கிறவர்கள்","poem":2},{"lineBreak":true},{"text":"என் நிமித்தம் அவமானம் அடையாதிருப்பார்களாக;","poem":2},{"text":"இஸ்ரயேலின் இறைவனே,","poem":1},{"text":"உம்மைத் தேடுகிறவர்கள்","poem":2},{"lineBreak":true},{"text":"என் நிமித்தம் வெட்கம் அடையாதிருப்பார்களாக.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உமக்காக நான் நிந்தையை சகித்திருக்கிறேன்;","poem":1},{"text":"வெட்கம் என் முகத்தை மூடியிருக்கிறது","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் என் சகோதரர்களுக்கு வேறுநாட்டைச் சேர்ந்தவனாகவும்","poem":1},{"text":"என் சொந்தத் தாயின் மகன்களுக்கு அறியாதவனாகவும் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஏனெனில் உமது ஆலயத்தைப் பற்றிய வைராக்கியம் என்னை எரித்துவிடுகிறது;","poem":1},{"text":"உம்மை இகழ்கிறவர்களின் இகழ்ச்சி என்மேல் விழுகிறது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் அழுது உபவாசித்தபோது,","poem":1},{"text":"அவர்கள் என்னை நிந்தித்தார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நான் துக்கவுடை உடுத்தும் போது,","poem":1},{"text":"அவர்களுக்குப் பழமொழியானேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நகர வாசலில் அமர்ந்திருக்கிறவர்கள் என்னைப் பரிகாசம் செய்கிறார்கள்;","poem":1},{"text":"நான் குடிகாரரின் பாடலாக இருக்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஆனாலும் யெகோவாவே, உம்முடைய தயவின் காலத்திலே,","poem":1},{"text":"நான் உம்மை நோக்கி மன்றாடுகிறேன்;","poem":2},{"text":"இறைவனே, உமது உடன்படிக்கையின் அன்பினிமித்தம்","poem":1},{"text":"நிச்சயமான உமது மீட்பைத் தந்து பதிலளியும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"சேற்றிலிருந்து என்னைத் தப்புவியும்,","poem":1},{"text":"என்னை மூழ்கிப்போக விடாதேயும்;","poem":2},{"text":"என்னை வெறுக்கிறவர்களிடம் இருந்தும்","poem":1},{"text":"ஆழ்கடலினின்றும் என்னை விடுவியும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"வெள்ளப்பெருக்கு என்னை மூடிக்கொள்ள விடாதேயும்;","poem":1},{"text":"ஆழங்கள் என்னை விழுங்க விடாதேயும்;","poem":2},{"lineBreak":true},{"text":"சவக்குழி என்மீது தன் வாயை மூடிக்கொள்ள விடாதேயும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"யெகோவாவே, எனக்குப் பதில் தாரும், உமது உடன்படிக்கையின் அன்பு நல்லது;","poem":1},{"text":"உமது பெரிதான இரக்கத்தால் என்னிடம் திரும்பும்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"உமது முகத்தை அடியேனுக்கு மறையாதிரும்,","poem":1},{"text":"விரைவாய் எனக்குப் பதில் தாரும்; நான் துயரத்தில் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"என்னருகே வந்து என்னைத் தப்புவியும்;","poem":1},{"text":"என் பகைவரிடமிருந்து என்னை மீட்டுக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"என் நிந்தையும் என் அவமானமும் என் இழிவும் உமக்குத் தெரியும்;","poem":1},{"text":"என் பகைவர் எல்லோருமே உமக்கு முன்பாக இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நிந்தை என் உள்ளத்தை நொறுக்கியதால்","poem":1},{"text":"நான் களைத்துப் போனேன்.","poem":2},{"text":"நான் அனுதாபத்தைத் தேடினேன், அது கிடைக்கவில்லை;","poem":1},{"text":"ஆறுதல்படுத்துகிறவர்களைத் தேடினேன், ஆனால் ஒருவரையும் நான் காணவில்லை.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அவர்கள் என் உணவில் கசப்பான நஞ்சைக் கொடுத்தார்கள்;","poem":1},{"text":"என் தாகத்துக்குக் குடிக்க எனக்கு காடியைக் கொடுத்தார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"அவர்களுடைய பந்தி அவர்களுக்குக் கண்ணியும்","poem":1},{"text":"அவர்களுடைய செல்வம் அவர்களுக்குப் பொறியாயும் இருப்பதாக.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவர்கள் பார்க்க முடியாதபடி அவர்களுடைய கண்கள் இருளடையட்டும்,","poem":1},{"text":"அவர்களுடைய முதுகுகள் என்றென்றுமாக கூனிப்போகட்டும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"உமது கடுங்கோபத்தை அவர்கள்மேல் ஊற்றும்;","poem":1},{"text":"உமது சினம் அவர்களைப் பின்தொடர்வதாக.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"அவர்களுடைய இருப்பிடங்கள் பாழடைவதாக;","poem":1},{"text":"அவர்களுடைய கூடாரங்களில் யாரும் குடியேறாதிருப்பார்களாக.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"ஏனெனில் நீர் அடித்தவர்களை அவர்கள் துன்புறுத்தி,","poem":1},{"text":"நீர் காயப்படுத்தியவர்களின் வேதனையைக் குறித்து தூற்றிப் பேசுகிறார்கள்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவர்களுடைய அநீதியின்மேல் அநீதியை சுமத்தும்;","poem":1},{"text":"அவர்கள் உமது இரட்சிப்பில் பங்குபெற இடமளியாதேயும்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"வாழ்வின் புத்தகத்திலிருந்து அவர்கள் நீக்கப்பட்டுப் போவார்களாக;","poem":1},{"text":"நீதிமான்களின் பெயர்ப்பட்டியலில் அவர்கள் சேர்க்கப்படாதிருப்பார்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":29,"content":[{"text":"நான் வருத்தத்திலும் துன்பத்திலும் இருக்கிறேன்;","poem":1},{"text":"இறைவனே, உமது இரட்சிப்பு என்னைப் பாதுகாப்பதாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"நான் இறைவனுடைய பெயரைப் பாட்டினால் துதித்து,","poem":1},{"text":"நன்றி செலுத்தி அவரை மகிமைப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"காணிக்கையாகக் கொடுக்கும்","poem":1},{"text":"கொம்பும், விரிகுளம்புமுள்ள காளை எருதைவிட,","poem":2},{"lineBreak":true},{"text":"மகிமைப்படுத்துவதே யெகோவாவுக்கு அதிக மகிழ்வைக் கொடுக்கும்.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"இதைக்கண்டு ஏழைகள் மகிழ்ச்சியடைவார்கள்;","poem":1},{"text":"இறைவனைத் தேடுகிறவர்களே, உங்கள் இருதயம் வாழ்வடைவதாக!","poem":2}]},{"type":"verse","number":33,"content":[{"text":"யெகோவா தேவையுள்ளோருக்குச் செவிகொடுக்கிறார்;","poem":1},{"text":"சிறைப்பட்ட தமது மக்களை அவர் இழிவாகக் கருதுவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":34,"content":[{"text":"வானமும் பூமியும் அவரைத் துதிக்கட்டும்;","poem":1},{"text":"கடலும் அவற்றில் வாழும் அனைத்தும் அவரைத் துதிக்கட்டும்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"இறைவன் சீயோனை மீட்டு,","poem":1},{"text":"யூதாவின் பட்டணங்களை மீண்டும் கட்டுவார்;","poem":2},{"text":"அப்பொழுது அவருடைய மக்கள் அங்கே குடியிருந்து அதை உரிமையாக்கிக்கொள்வார்கள்.","poem":1}]},{"type":"verse","number":36,"content":[{"text":"அவருடைய பணியாளரின் பிள்ளைகள் அதை உரிமைச்சொத்தாகப் பெறுவார்கள்;","poem":2},{"lineBreak":true},{"text":"அவருடைய பெயரை நேசிக்கிறவர்கள் அங்கே குடியிருப்பார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/69.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/70.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/68.json","previousChapterAudioLinks":{},"numberOfVerses":36}