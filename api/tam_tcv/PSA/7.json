{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":7,"content":[{"type":"hebrew_subtitle","content":["பென்யமீனியனான கூஷின் வார்த்தையின் நிமித்தம் தாவீது யெகோவாவுக்கு பாடிய சிகாயோன் என்னும் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என் இறைவனாகிய யெகோவாவே, நான் உம்மிடத்தில் தஞ்சமடைகிறேன்;","poem":1},{"text":"என்னைத் துரத்துகின்ற அனைவரிடமிருந்தும் என்னைக் காப்பாற்றி விடுவியும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இல்லாவிட்டால், அவர்கள் சிங்கத்தைப்போல் என்னைக் கிழித்து,","poem":1},{"text":"என்னைத் தப்புவிக்க ஒருவருமின்றித் துண்டு துண்டாக்கிப் போடுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"என் இறைவனாகிய யெகோவாவே, அவர்கள் கூறுகிறதை நான் செய்திருந்து","poem":1},{"text":"என் கைகள் குற்றமுடையதாய் இருந்தால்,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என்னுடன் சமாதானமாய் இருக்கிறவனுக்கு நான் தீமை செய்திருந்தால்,","poem":1},{"text":"அல்லது காரணமின்றி என் பகைவனைக் கொள்ளையிட்டிருந்தால்,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அப்பொழுது என் எதிரி என்னைப் பின்தொடர்ந்து என்னைப் பிடிக்கட்டும்;","poem":1},{"text":"அவன் என்னைத் தரையில் தள்ளி,","poem":2},{"lineBreak":true},{"text":"உயிர்போக மிதித்து தூசியிலே என்னைக் கிடக்கப்பண்ணட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"யெகோவாவே, உம்முடைய கோபத்தில் எழும்பும்;","poem":1},{"text":"என் எதிரிகளினுடைய கடுங்கோபத்திற்கு விரோதமாக எழுந்திடும்.","poem":2},{"lineBreak":true},{"text":"என் இறைவனே, விழித்தெழும்; நீதியைக் கட்டளையிடும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எல்லா நாட்டினரும் உம்மைச் சூழ ஒன்றுசேர்த்து","poem":1},{"text":"நீர் உன்னதத்திலிருந்து அவர்களை ஆளுகை செய்யும்.","poem":2}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"யெகோவா மக்களை நியாயந்தீர்க்கட்டும்.","poem":2},{"text":"யெகோவாவே, என்னுடைய நீதிக்குத் தக்கதாய் என்னை நியாயந்தீரும்;","poem":1},{"text":"மகா உன்னதமானவரே, என் உத்தமத்திற்கு ஏற்ப எனக்கு நியாயம் செய்யும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"சிந்தனைகளையும் இருதயங்களையும் ஆராய்ந்தறிகிற","poem":1},{"text":"நீதியுள்ள இறைவனே,","poem":2},{"text":"கொடியவர்களின் வன்செயலை ஒரு முடிவுக்குக் கொண்டுவாரும்;","poem":1},{"text":"நீதியுள்ளவர்களைப் பாதுகாப்பாய் இருக்கச் செய்யும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"மகா உன்னதமான இறைவனே என் கேடயம்;","poem":1},{"text":"இருதயத்தில் நேர்மையுள்ளவர்களை விடுவிக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"இறைவன் நீதியுள்ள நீதிபதி;","poem":1},{"text":"அவர் நாள்தோறும் தமது கடுங்கோபத்தை வெளிப்படுத்தும் இறைவன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"கொடியவன் மனம் மாறாவிட்டால்,","poem":1},{"text":"இறைவன் தமது வாளைக் கூராக்குவார்;","poem":2},{"lineBreak":true},{"text":"அவர் தமது வில்லை வளைத்து நாணேற்றுவார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர் தமது பயங்கர ஆயுதங்களை ஆயத்தப்படுத்தியிருக்கிறார்;","poem":1},{"text":"எரிகிற அம்புகளையும் ஆயத்தமாக்குகிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"தீமையினால் நிறைந்தவர்களோ","poem":1},{"text":"பிரச்சனையைக் கர்ப்பந்தரித்து, வஞ்சகத்தைப் பெற்றெடுக்கிறார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"மற்றவர்கள் விழும்படி குழியைத் தோண்டுகிறவர்களோ,","poem":1},{"text":"தாங்களே அதற்குள் விழுகிறார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர்கள் செய்யும் தீங்கு அவர்கள் மேலேயே திரும்புகிறது;","poem":1},{"text":"அவர்கள் வன்செயல் அவர்கள் தலைமீதே விழுகிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"யெகோவாவினுடைய நீதியினிமித்தம் நான் அவருக்கு நன்றி செலுத்துவேன்;","poem":1},{"text":"மகா உன்னதமான யெகோவாவின் பெயரைப் புகழ்ந்து பாடுவேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":17}