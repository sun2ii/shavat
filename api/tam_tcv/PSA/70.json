{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":70,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, என்னைக் காப்பாற்ற விரைவாய் வாரும்;","poem":1},{"text":"யெகோவாவே, எனக்கு உதவிசெய்ய விரைவாய் வாரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"என் உயிரை அழிக்கத் தேடுகிறவர்கள்","poem":1},{"text":"வெட்கப்பட்டுக் குழப்பமடைவார்களாக;","poem":2},{"text":"எனது அழிவை விரும்புகிற யாவரும்","poem":1},{"text":"அவமானமடைந்து திரும்புவார்களாக.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என்னைப் பார்த்து, “ஆ! ஆ!” என்று ஏளனம் செய்கிறவர்கள்,","poem":1},{"text":"அவர்களுடைய வெட்கத்தினால் திரும்புவார்களாக.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால் உம்மைத் தேடுகிற யாவரும்","poem":1},{"text":"உம்மில் மகிழ்ந்து களிகூருவார்களாக;","poem":2},{"text":"உமது இரட்சிப்பை விரும்புவோர்,","poem":1},{"text":"“இறைவன் பெரியவர்!” என்று எப்போதும் சொல்வார்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நானோ, ஏழையும் எளியவனுமாயிருக்கிறேன்;","poem":1},{"text":"இறைவனே, என்னிடம் விரைந்து வாரும்.","poem":2},{"text":"நீரே என் துணை, நீரே என் மீட்பர்;","poem":1},{"text":"யெகோவாவே, தாமதியாதேயும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/70.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/71.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/69.json","previousChapterAudioLinks":{},"numberOfVerses":5}