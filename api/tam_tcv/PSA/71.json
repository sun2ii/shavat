{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":71,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நான் உம்மிடத்தில் தஞ்சமடைந்திருக்கிறேன்;","poem":1},{"text":"என்னை ஒருபோதும் வெட்கமடைய விடாதேயும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உமது நீதியின் நிமித்தம் என்னை விடுவித்து, என்னை மீட்டுக்கொள்ளும்;","poem":1},{"text":"உமது செவியை எனக்குச் சாய்த்து, என்னைக் காப்பாற்றும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் எப்பொழுதும் வந்தடையத்தக்க","poem":1},{"text":"என் புகலிடமான கன்மலையாய் இரும்;","poem":2},{"text":"நீர் என் கன்மலையும் என் கோட்டையுமாயிருப்பதால்,","poem":1},{"text":"என்னைக் காப்பாற்றக் கட்டளையிடும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் இறைவனே, என்னைக் கொடியவன் கையிலிருந்து விடுவியும்;","poem":1},{"text":"தீமையும் கொடூரமும் நிறைந்த மனிதரின் பிடியிலிருந்தும் விடுவியும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"ஆண்டவராகிய யெகோவாவே, நீரே என் எதிர்பார்ப்பு;","poem":1},{"text":"என் இளமையிலிருந்து நீரே என் நம்பிக்கை.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் பிறந்ததுமுதல் உம்மைச் சார்ந்திருக்கிறேன்;","poem":1},{"text":"என் தாயின் கருப்பையிலிருந்து என்னைப் பராமரித்தவர் நீரே;","poem":2},{"lineBreak":true},{"text":"நான் என்றென்றும் உம்மைத் துதிப்பேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"நான் அநேகருக்கு வியப்புக்குரிய எடுத்துக்காட்டாய் இருக்கிறேன்;","poem":1},{"text":"நீரே என் பலமுள்ள புகலிடம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நாள்முழுவதும் உம்முடைய மகத்துவத்தை அறிவித்து,","poem":1},{"text":"என் வாய் உமது துதியினால் நிறைந்திருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"நான் முதியவனாகும்போது, என்னைத் தள்ளிவிடாதேயும்;","poem":1},{"text":"என் பெலன் ஒடுங்கும்போது என்னைக் கைவிடாதேயும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஏனெனில் என் பகைவர் எனக்கு விரோதமாய்ப் பேசுகிறார்கள்;","poem":1},{"text":"என்னைக் கொலைசெய்யக் காத்திருக்கிறவர்கள் ஒன்றுகூடி சதி செய்கிறார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள், “இறைவன் அவனைக் கைவிட்டுவிட்டார்;","poem":1},{"text":"அவனைப் பின்தொடர்ந்து பிடியுங்கள்;","poem":2},{"lineBreak":true},{"text":"அவனை விடுவிக்கிறவர் யாருமே இல்லை” என்கிறார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"இறைவனே, என்னைவிட்டுத் தூரமாகாதேயும்;","poem":1},{"text":"என் இறைவனே, எனக்கு உதவிசெய்ய விரைந்து வாரும்;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"என்மீது குற்றம் சுமத்துகிறவர்கள் வெட்கத்தால் அழிந்துபோவார்களாக;","poem":1},{"text":"எனக்குத் தீங்குசெய்ய நினைக்கிறவர்கள்,","poem":2},{"lineBreak":true},{"text":"ஏளனத்தாலும் அவமானத்தாலும் மூடப்படுவார்களாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"நானோ எப்பொழுதுமே எதிர்பார்ப்புடனே இருப்பேன்;","poem":1},{"text":"நான் மேன்மேலும் உம்மைத் துதிப்பேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"எப்பொழுதும் என் வாய் உமது நீதியைப்பற்றிச் சொல்லும்;","poem":1},{"text":"உமது இரட்சிப்பின் செயல்களை நான் அறியாதிருந்த போதிலும்,","poem":2},{"lineBreak":true},{"text":"அதைப்பற்றி நாள்தோறும் என் வாய் சொல்லும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆண்டவராகிய யெகோவாவே, நான் உமது வல்லமையான செயல்களை எடுத்துச்சொல்வேன்;","poem":1},{"text":"நான் உம்முடைய நீதியை மட்டுமே பிரசித்தம் பண்ணுவேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"இறைவனே, என் இளமையிலிருந்தே நீர் எனக்குப் போதித்திருக்கிறீர்;","poem":1},{"text":"நான் உமது அற்புதமான செயல்களை இன்றுவரை அறிவித்து வருகிறேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"இறைவனே, வரப்போகும் எல்லோருக்கும் அடுத்த தலைமுறைக்கும்","poem":1},{"text":"உமது ஆற்றலையும் உம்முடைய வல்லமையையும் அறிவிக்குமளவும்","poem":2},{"text":"நான் முதிர்வயதாகும்போதும் என் தலைமுடி நரைக்கும்போதும்,","poem":1},{"text":"என்னைக் கைவிடாதேயும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"பெரிய காரியங்களைச் செய்த இறைவனே,","poem":1},{"text":"உமது நீதி ஆகாயங்களை எட்டுகிறது;","poem":2},{"lineBreak":true},{"text":"இறைவனே, உம்மைப்போல் யாருண்டு?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நீர் என்னை அநேக கசப்பான","poem":1},{"text":"துன்பங்களையும் காணச் செய்திருந்தாலும்","poem":2},{"lineBreak":true},{"text":"என் வாழ்வை மீண்டும் புதுப்பிப்பீர்;","poem":2},{"text":"பூமியின் ஆழங்களில் இருந்து","poem":1},{"text":"நீர் என்னை மறுபடியும் மேலே கொண்டுவருவீர்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"நீர் என் மேன்மையைப் பெருகப்பண்ணி,","poem":1},{"text":"மீண்டும் என்னைத் தேற்றுவீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"என் இறைவனே, நான் உமது உண்மையைப் பற்றி","poem":1},{"text":"வீணை இசைத்து உம்மைத் துதிப்பேன்;","poem":2},{"text":"இஸ்ரயேலின் பரிசுத்தரே,","poem":1},{"text":"யாழ் இசைத்து நான் உமக்குத் துதி பாடுவேன்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"உம்மால் மீட்கப்பட்ட நான்","poem":1},{"text":"உமக்குத் துதிபாடும்போது,","poem":2},{"lineBreak":true},{"text":"என் உதடுகளும் கம்பீரித்து மகிழும்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"என் நாவு நாள்முழுவதும்","poem":1},{"text":"உமது நீதியின் செயல்களைப் பற்றிச் சொல்லும்;","poem":2},{"text":"ஏனெனில் எனக்குத் தீங்குசெய்ய விரும்பியவர்கள்","poem":1},{"text":"வெட்கத்திற்கும் கலக்கத்திற்கும் உள்ளானார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/71.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/72.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/70.json","previousChapterAudioLinks":{},"numberOfVerses":24}