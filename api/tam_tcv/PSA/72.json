{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":72,"content":[{"type":"hebrew_subtitle","content":["சாலொமோனின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, அரசனுக்கு உமது நியாயமான தீர்ப்பையும்","poem":1},{"text":"இளவரசனுக்கு உமது நீதியையும் கொடும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அப்பொழுது அவர் உமது மக்களை நீதியோடும்,","poem":1},{"text":"துன்பப்பட்ட உம்முடையவர்களை நேர்மை தவறாமலும் நியாயந்தீர்ப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"மலைகள் அனைவருக்கும் செழிப்பை உண்டாக்கட்டும்,","poem":1},{"text":"குன்றுகள் நீதியின் பலனைக் கொண்டுவரட்டும்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மக்கள் மத்தியில் ஒடுக்கப்பட்டவர்களை அவர் பாதுகாத்து,","poem":1},{"text":"ஏழைகளின் பிள்ளைகளைக் காப்பாற்றட்டும்;","poem":2},{"lineBreak":true},{"text":"ஒடுக்குவோரை அவர் நொறுக்கிப்போடட்டும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"சூரியனும் சந்திரனும் உள்ளமட்டும்,","poem":1},{"text":"தலைமுறை தலைமுறையாக அவர்கள் உமக்குப் பயந்திருப்பார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அரசர் புல்வெட்டப்பட்ட வயலின்மேல் பொழியும் மழையைப்போலவும்,","poem":1},{"text":"பூமியை நீர்ப்பாய்ச்சும் மழைத்தூறலைப் போலவும்","poem":2},{"lineBreak":true},{"text":"அரசரின் ஆட்சி புத்துணர்ச்சி அடையட்டும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவருடைய நாட்களில் நீதிமான்கள் செழிப்பார்கள்;","poem":1},{"text":"சந்திரனுள்ளவரைக்கும் மிகுந்த சமாதானம் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஒரு கடலில் இருந்து மறுகடல் வரைக்கும்,","poem":1},{"text":"நதிதொடங்கி பூமியின் எல்லைகள் வரைக்கும் அரசர் ஆளுகை செய்யட்டும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"பாலைவன வாசிகள் அவருக்குமுன் பணிவார்கள்;","poem":1},{"text":"அவருடைய பகைவர்கள் மண்ணை நக்குவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"தர்ஷீசு மற்றும் தூரத்து தீவுகளின் அரசர்கள்","poem":1},{"text":"அவருக்கு காணிக்கைகளைக் கொண்டுவரட்டும்;","poem":2},{"text":"ஷேபாவும், சேபாவின் அரசர்களும்","poem":1},{"text":"அவருக்கு அன்பளிப்புகளைக் கொடுக்கட்டும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எல்லா அரசர்களும் அவரை வணங்கட்டும்;","poem":1},{"text":"எல்லா நாடுகளும் அவருக்குப் பணிவிடை செய்யட்டும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"ஏனெனில் கதறுகின்ற ஏழைகளையும்","poem":1},{"text":"உதவி செய்வாரின்றித் தவிக்கும் எளியோரையும் அவர் விடுவிப்பார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"பலவீனருக்கும் எளியோருக்கும் அவர் அனுதாபங்காட்டி,","poem":1},{"text":"எளியோரை மரணத்திலிருந்து காப்பாற்றுவார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்களை ஒடுக்குதலுக்கும் வன்செயலுக்கும் தப்புவிப்பார்;","poem":1},{"text":"ஏனெனில் அவர்களுடைய வாழ்க்கை அவருடைய பார்வையில் விலையுயர்ந்ததாய் இருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"அவர் நீடித்து வாழ்வாராக!","poem":1},{"text":"சேபாவின் தங்கம் அவருக்குக் கொடுக்கப்படுவதாக;","poem":2},{"text":"மக்கள் எக்காலத்திலும் அவருக்காக மன்றாடி,","poem":1},{"text":"நாள்தோறும் அவரை ஆசீர்வதிப்பார்களாக.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நாட்டிலே தானியம் மிகுதியாக விளையட்டும்;","poem":1},{"text":"குன்றுகளின் உச்சியில் தானியக்கதிர்கள் அசையட்டும்;","poem":2},{"text":"அதின் உற்பத்தி லெபனோனைப்போல செழிக்கட்டும்;","poem":1},{"text":"அதின் பட்டணத்தார் வெளியின் புல்லைப்போல் செழித்து வளருவார்களாக.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவருடைய பெயர் என்றும் நிலைத்திருப்பதாக;","poem":1},{"text":"சூரியன் உள்ளமட்டும் அது தொடர்ந்திருப்பதாக.","poem":2},{"lineBreak":true},{"text":"எல்லா நாடுகளும் அவர்மூலம் ஆசீர்வதிக்கப்பட்டிருப்பார்கள்;","poem":1},{"text":"அவர்கள் அவரை ஆசீர்வதிக்கப்பட்டவர் என்று அழைப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"இஸ்ரயேலின் இறைவனாயிருக்கிற, யெகோவாவாகிய இறைவனுக்குத் துதி உண்டாவதாக;","poem":1},{"text":"அவர் அதிசயமான செயல்களைச் செய்கிறார்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவருடைய மகத்துவமான பெயர் என்றென்றும் துதிக்கப்படுவதாக;","poem":1},{"text":"பூமி முழுவதும் அவருடைய மகிமையால் நிரம்புவதாக.","poem":2},"ஆமென், ஆமென்."]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"ஈசாயின் மகன் தாவீதின் மன்றாட்டுகள் இத்துடன் நிறைவுபெறுகின்றன.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/72.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/73.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/71.json","previousChapterAudioLinks":{},"numberOfVerses":20}