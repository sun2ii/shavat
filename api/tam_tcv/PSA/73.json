{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":73,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நிச்சயமாகவே, இருதயத்தில் சுத்தமுள்ள இஸ்ரயேலருக்கு,","poem":1},{"text":"இறைவன் நல்லவராயிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"ஆனால் நானோ, என் கால்கள் சறுக்கி,","poem":1},{"text":"என் காலடிகள் இடறி விழப்போனேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பெருமையுள்ளவர்களைக் குறித்துப் பொறாமை கொண்டேன்;","poem":1},{"text":"கொடியவர்களின் வளமான வாழ்வை நான் கண்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அவர்களுக்கு சாகும்வரை வேதனைகளே இல்லை;","poem":1},{"text":"அவர்களுடைய உடல்கள் ஆரோக்கியமாகவும் பலமாகவும் இருக்கின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர்கள் சாதாரண மனிதர்களைப்போல துன்பப்படுவதில்லை;","poem":1},{"text":"மனிதருக்கு வரும் நோய்களினாலும் அவர்கள் பீடிக்கப்படுவதில்லை.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"ஆதலால் பெருமை அவர்களுடைய கழுத்துச் சங்கிலியாய் இருக்கிறது;","poem":1},{"text":"அவர்கள் வன்முறையை உடையாகக் கொண்டிருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்களுடைய இருதயம் கொழுப்பினால் புடைத்து அநியாயம் வெளியே வருகிறது;","poem":1},{"text":"அவர்கள் மனதிலிருந்து எழும் தீமையான எண்ணங்களுக்கு அளவேயில்லை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்கள் ஏளனம் செய்து, தீமையானதைப் பேசுகிறார்கள்;","poem":1},{"text":"அகங்காரத்தில் ஒடுக்கப்போவதாகப் பயமுறுத்துகிறார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவர்களுடைய வாயின் வார்த்தைகள் வானமட்டும் எட்டுகிறது;","poem":1},{"text":"அவர்களுடைய நாவின் சொற்கள் பூமியெங்கும் சுற்றித்திரிகிறது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"ஆகையால் மக்களும் அவர்களிடமாய்த் திரும்பி,","poem":1},{"text":"அவர்களின் சொற்களைத் தண்ணீரைப்போல் குடிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள், “இறைவன் எப்படி அறிவார்?","poem":1},{"text":"மகா உன்னதமானவருக்கு இவற்றைப் பற்றிய அறிவு உண்டோ?” என்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"கொடியவர்கள் எப்பொழுதும் சிந்தனை அற்றவர்களாகவும்,","poem":1},{"text":"செல்வத்தினால் பெருகுகிறவர்களாகவும் இருக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"உண்மையில், நான் வீணாகவே என் இருதயத்தைச் சுத்தமாக வைத்துக்கொண்டேன்;","poem":1},{"text":"வீணாகவே குற்றமற்றவனாய் என் கைகளைக் கழுவிக் கொண்டேன்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நாளெல்லாம் நான் பாதிக்கப்பட்டேன்;","poem":1},{"text":"காலைதோறும் நான் கண்டிக்கப்பட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"இவ்வாறு பேசியிருந்தால்,","poem":1},{"text":"நான் உமது பிள்ளைகளுக்கு துரோகம் செய்திருப்பேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"இவற்றையெல்லாம் விளங்கிக்கொள்ள நான் முயன்றபோது,","poem":1},{"text":"அது எனக்குக் கடினமாய் இருந்தது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"ஆனால் நான் இறைவனின் பரிசுத்த இடத்திற்குள் நுழைந்த பின்புதான்,","poem":1},{"text":"நான் அவர்களுடைய இறுதிமுடிவை அறிந்துகொண்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"நிச்சயமாகவே, நீர் அவர்களைச் சறுக்கலான நிலத்தில் நிறுத்துகிறீர்;","poem":1},{"text":"நீர் அவர்களை சேதமடைந்து போகவிடுகிறீர்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர்கள் சீக்கிரமாய் அழிந்துபோகிறார்கள்;","poem":1},{"text":"திடீரென வரும் பயங்கரங்களால் முழுமையாக அழிந்துபோகிறார்கள்!","poem":2}]},{"type":"verse","number":20,"content":[{"text":"விழித்தெழுகிறவனின் கனவு கலைவதுபோல்,","poem":1},{"text":"யெகோவாவே, நீர் எழும்பும்போது,","poem":2},{"lineBreak":true},{"text":"அவர்களை கற்பனைக் காட்சியென்று இகழ்வீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"என் இருதயம் கசந்தது,","poem":1},{"text":"என் உள்ளம் குத்தப்பட்டது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"நான் ஒன்றும் அறியாத மூடனானேன்;","poem":1},{"text":"நான் உமக்கு முன்பாக விலங்கைப்போல நடந்துகொண்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"ஆனாலும், நான் எப்பொழுதும் உம்முடனே இருக்கிறேன்;","poem":1},{"text":"நீர் என் வலதுகையை பிடித்துக்கொள்கிறீர்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"நீர் உமது ஆலோசனையினால் எனக்கு வழிகாட்டுகிறீர்;","poem":1},{"text":"பின்பு நீர் என்னை உமது மகிமைக்குள் எடுத்துக்கொள்வீர்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"பரலோகத்தில் உம்மையன்றி எனக்கு யார் உண்டு?","poem":1},{"text":"பூமியிலும் உம்மைத்தவிர எனக்கு வேறொரு விருப்பமில்லை.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"என் உடலும் உள்ளமும் சோர்ந்துபோயிற்று;","poem":1},{"text":"ஆனால் இறைவனே என்றென்றைக்கும் நீரே என் இருதயத்தின் பெலனும்","poem":2},{"lineBreak":true},{"text":"எனக்குரியவருமாய் இருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":27,"content":[{"text":"உம்மைவிட்டுத் தூரமாகிறவர்கள் அழிவார்கள்;","poem":1},{"text":"உமக்கு உண்மையற்றவர்களை நீர் தண்டிப்பீர்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"ஆனால் என்னைப் பொறுத்தவரை, இறைவனுக்கு அருகில் இருப்பதே எனக்கு நலம்;","poem":1},{"text":"ஆண்டவராகிய யெகோவாவை நான் என் புகலிடமாக்கிக் கொண்டேன்;","poem":2},{"lineBreak":true},{"text":"உமது செயல்களையெல்லாம் நான் விவரிப்பேன்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/73.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/74.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/72.json","previousChapterAudioLinks":{},"numberOfVerses":28}