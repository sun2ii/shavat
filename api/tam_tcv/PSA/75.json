{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":75,"content":[{"type":"hebrew_subtitle","content":["“அழிக்காதே” என்ற இசையில் வாசிக்கும்படி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, உமக்கு நன்றி செலுத்துகிறோம்;","poem":1},{"text":"உமது பெயர் சமீபமாயிருப்பதால் நாங்கள் நன்றி செலுத்துகிறோம்;","poem":2},{"lineBreak":true},{"text":"மனிதர் உமது அதிசயமான செயல்களைப்பற்றிக் கூறுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"இறைவனோ, “நியமிக்கப்பட்ட காலத்தை நான் தெரிந்துகொண்டு,","poem":1},{"text":"நீதியாய் நியாயந்தீர்பேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பூமியும் அதிலுள்ள எல்லா மக்களுடன் கரைந்துபோகின்றது;","poem":1},{"text":"நான் அதின் தூண்களை உறுதியாய்ப் பிடித்துக்கொள்வேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அகங்காரம் உள்ளவர்களைப் பார்த்து, ‘இனிமேல் பெருமை பேசாதிருங்கள்’ என்றும்,","poem":1},{"text":"கொடியவர்களைப் பார்த்து, ‘உங்கள் கொம்பை உயர்த்தாதிருங்கள்’ என்றும் சொல்கிறார்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உங்கள் கொம்பை வானங்களுக்கு விரோதமாக உயர்த்தாதிருங்கள்;","poem":1},{"text":"தலைக்கனம் உடையவர்களாய்ப் பேசாதிருங்கள் என்றும் சொல்கிறார். ”","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"கிழக்கிலிருந்தோ, மேற்கிலிருந்தோ,","poem":1},{"text":"அல்லது பாலைவனத்திலிருந்தோ உயர்வு வராது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனால் நியாயந்தீர்க்கிறவர் இறைவனே:","poem":1},{"text":"அவர் ஒருவனைத் தாழ்த்தி இன்னொருவனை உயர்த்துகிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவாவினுடைய கரத்தில் நியாயத்தீர்ப்பென்னும்","poem":1},{"text":"காரசாரமான நுரைக்கின்ற திராட்சை இரசம் நிறைந்த ஒரு கிண்ணம் இருக்கிறது;","poem":2},{"text":"அவர் அதை ஊற்றுகிறார்;","poem":1},{"text":"பூமியின் கொடியவர்கள் எல்லோரும் அதைக் கடைசிவரைக் குடிக்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"நானோ, இதை எக்காலத்திலும் அறிவிப்பேன்;","poem":1},{"text":"நான் யாக்கோபின் இறைவனுக்குத் துதி பாடுவேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“கொடியவர்களின் கொம்பாகிய பலத்தை நான் வெட்டிப்போடுவேன்;","poem":1},{"text":"ஆனால் நீதிமான்களின் கொம்பாகிய பலத்தை மேலும் உயர்த்துவேன்”","poem":2},{"lineBreak":true},{"text":"என்று இறைவன் சொல்கிறார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":10}