{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":76,"content":[{"type":"hebrew_subtitle","content":["கம்பியிசைக் கருவிகளுடன் பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட பாட்டாகிய ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யூதாவில் இறைவன் அறியப்பட்டிருக்கிறார்;","poem":1},{"text":"இஸ்ரயேலில் அவருடைய பெயர் பெரியது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவருடைய கூடாரம் சாலேமில்","poem":1},{"noteId":7},{"text":"இருக்கிறது;","poem":1},{"text":"அவருடைய தங்குமிடம் சீயோனில் இருக்கிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அங்கே அவர் தீப்பிழம்போடு பாயும் அம்புகளையும்,","poem":1},{"text":"கேடயங்களையும், வாள்களையும், போராயுதங்களையும் உடைத்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"நீர் ஒளியுள்ளவராய்த் துலங்குகிறீர்;","poem":1},{"text":"வேட்டையாடும் மலைகளைப் பார்க்கிலும் அதிக கம்பீரமுடையவராய் இருக்கிறீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"வீரமுள்ள மனிதர் கொள்ளையிடப்பட்டு,","poem":1},{"text":"அவர்கள் மரண நித்திரை அடைந்தார்கள்;","poem":2},{"text":"போர்வீரரில் ஒருவனும் தன் கைகளை","poem":1},{"text":"உயர்த்த முடியாமலிருக்கிறான்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யாக்கோபின் இறைவனே, உமது கோபத்தில்","poem":1},{"text":"குதிரை, தேர் இரண்டுமே செயலிழந்து கிடக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நீரே, நீர் ஒருவருரே பயப்படத்தக்கவர்;","poem":1},{"text":"நீர் கோபமாய் இருக்கும்போது உம்முன் யாரால் நிற்கமுடியும்?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீர் வானத்திலிருந்து நியாயத்தீர்ப்பை வழங்கினீர்;","poem":1},{"text":"பூமி பயந்து அமைதியாய் இருந்தது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இறைவனே, நாட்டில் துன்புற்ற யாவரையும் காப்பாற்றுவதற்காக","poem":1},{"text":"நீர் எழுந்தபோதே, அந்த நியாயத்தீர்ப்பை வழங்கினீர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நிச்சயமாகவே, மனிதருக்கு விரோதமான உமது கோபம்","poem":1},{"text":"உமக்குத் துதியைக் கொண்டுவருகிறது;","poem":2},{"lineBreak":true},{"text":"உமது கடுங்கோபத்திற்குத் தப்பி மீந்தவர்களை நீர் அடக்குவீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"உங்கள் யெகோவாவாகிய இறைவனுக்கு நேர்த்திக் கடன்களைச் செய்து,","poem":1},{"text":"அவைகளை நிறைவேற்றுங்கள்.","poem":2},{"text":"அவரைச் சுற்றியிருக்கிற நாடுகளெல்லாம் பயப்படத்தக்கவரான","poem":1},{"text":"அவருக்கே அன்பளிப்புகளைக் கொண்டுவரட்டும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் ஆளுநர்களின் ஆவியை நொறுக்குகிறார்;","poem":1},{"text":"பூமியின் அரசர்கள் அவருக்குப் பயப்படுகிறார்கள்.","poem":2}]}],"footnotes":[{"noteId":7,"caller":"+","text":"சாலேமில் என்பதற்கு இதற்கு இன்னொரு பெயர் எருசலேம்.","reference":{"chapter":76,"verse":2}}]},"thisChapterLink":"/api/tam_tcv/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":12}