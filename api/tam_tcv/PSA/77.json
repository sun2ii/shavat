{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":77,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவன் எதுத்தூனுக்கு ஒப்புவிக்கப்பட்ட ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நான் உதவிக்காக இறைவனை நோக்கி அழுதேன்;","poem":1},{"text":"எனக்குச் செவிகொடுக்கும்படியாக நான் இறைவனை நோக்கி அழுதேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் துன்பத்தில் இருந்தபோது ஆண்டவரைத் தேடினேன்;","poem":1},{"text":"இரவில் என் கைகளைத் தளராமல் உயர்த்தினேன்,","poem":2},{"lineBreak":true},{"text":"என் ஆத்துமாவோ ஆறுதலடைய மறுத்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"இறைவனே, உம்மை நான் நினைவுகூர்ந்தேன், நான் புலம்பினேன்;","poem":1},{"text":"நான் தியானித்தேன், என் ஆவியோ சோர்ந்துபோயிற்று.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீர் என் கண்களை மூடாதபடி தடுத்தீர்;","poem":1},{"text":"நான் பேசமுடியாதபடி மிகவும் கஷ்டப்பட்டேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"முந்தின நாட்களையும்,","poem":1},{"text":"கடந்துபோன வருடங்களைப்பற்றியும் நான் நினைத்தேன்;","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் இரவில் என் பாடல்களை நினைவுகூர்ந்தேன்.","poem":1},{"text":"என் இருதயம் தியானித்தது, என் ஆவியோ இப்படி விசாரணை செய்தது:","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“யெகோவா என்றென்றும் புறக்கணிப்பாரோ?","poem":1},{"text":"அவர் மீண்டும் ஒருபோதும் தயவு காண்பிக்கமாட்டாரோ?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவருடைய உடன்படிக்கையின் அன்பு என்றென்றும் ஒழிந்துபோயிற்றோ?","poem":1},{"text":"அவருடைய வாக்குத்தத்தம் தலைமுறை தலைமுறைக்கும் அற்றுப்போயிற்றோ?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"இறைவன் தயைசெய்ய மறந்துவிட்டாரோ?","poem":1},{"text":"அவர் தமது கோபத்தில் இரக்கங்காட்ட மறுத்துவிட்டாரோ?”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அப்பொழுது நான்: “மகா உன்னதமானவரின் வலதுகரம்,","poem":1},{"text":"எனக்காக செயலாற்றுகிறது,","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவாவின் செயல்களை நான் நினைவுகூருவேன்;","poem":1},{"text":"ஆம், முற்காலத்தில் நீர் செய்த அற்புதங்களை நான் நினைவிற்கொள்வேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உமது செய்கைகளையெல்லாம் நான் தியானிப்பேன்;","poem":1},{"text":"உமது வல்லமையான செயல்களை நான் சிந்திப்பேன்” என்றேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"இறைவனே, உமது வழிகள் பரிசுத்தமானவை;","poem":1},{"text":"நம்முடைய இறைவனைப்போல் பெரிய தெய்வம் யார்?","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அற்புதங்களைச் செய்கிற இறைவன் நீரே;","poem":1},{"text":"நீர் மக்கள் மத்தியில் உமது வல்லமையை வெளிப்படுத்துகிறீர்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"உமது வல்லமையுள்ள புயத்தினால்","poem":1},{"text":"யாக்கோபு, யோசேப்பு ஆகியோரின் சந்ததியான உமது மக்களை நீர் மீட்டுக்கொண்டீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"இறைவனே, சமுத்திரம் உம்மைக் கண்டது,","poem":1},{"text":"சமுத்திரம் உம்மைக் கண்டு தத்தளித்தது;","poem":2},{"lineBreak":true},{"text":"மகா ஆழங்களும் நடுங்கின.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"மேகங்கள் தண்ணீரைப் பொழிந்தன,","poem":1},{"text":"ஆகாயங்கள் முழங்கி அதிர்ந்தன;","poem":2},{"lineBreak":true},{"text":"உமது அம்புகள் அங்கும் இங்கும் மின்னிப் பாய்ந்தன.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உமது இடியொலி சுழற்காற்றில் கேட்டது,","poem":1},{"text":"உமது மின்னல் உலகத்திற்கு வெளிச்சம் கொடுத்தது;","poem":2},{"lineBreak":true},{"text":"பூமி நடுங்கி அதிர்ந்தது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"உமது பாதை கடலிலும்,","poem":1},{"text":"உமது வழி பெருவெள்ளத்திலும் இருந்தது;","poem":2},{"lineBreak":true},{"text":"ஆனாலும் உமது அடிச்சுவடுகள் காணப்படவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"மோசே, ஆரோன் என்பவர்களுடைய கையினால்","poem":1},{"text":"நீர் உமது மக்களை ஒரு மந்தையைப்போல் நடத்தினீர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/77.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/78.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/76.json","previousChapterAudioLinks":{},"numberOfVerses":20}