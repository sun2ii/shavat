{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":78,"content":[{"type":"hebrew_subtitle","content":["மஸ்கீல் என்னும் ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"என் மக்களே, என் போதனையைக் கேளுங்கள்;","poem":1},{"text":"என் வாயின் வார்த்தைகளுக்குச் செவிகொடுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் என் வாயைத் திறந்து உவமைகளால் பேசுவேன்;","poem":1},{"text":"நான் முற்காலத்து மறைபொருட்களை எடுத்துச்சொல்வேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நாங்கள் கேட்டதையும் அறிந்ததையும்","poem":1},{"text":"எங்கள் முற்பிதாக்கள் எங்களுக்குச் சொன்னார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நாங்கள் எங்கள் பிள்ளைகளிடமிருந்து அவைகளை மறைக்கமாட்டோம்;","poem":1},{"text":"யெகோவாவின் புகழத்தக்கச் செயல்களையும்,","poem":2},{"text":"அவருடைய வல்லமையையும்,","poem":1},{"text":"அவர் செய்த அதிசயங்களையும் அடுத்துவரும் தலைமுறையினருக்குச் சொல்வோம்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அவர் யாக்கோபுக்கு நியமங்களை ஆணையிட்டு,","poem":1},{"text":"இஸ்ரயேலிலே சட்டத்தை நிலைநாட்டி,","poem":2},{"text":"அவற்றைத் தமது பிள்ளைகளுக்குப் போதிக்கும்படி,","poem":1},{"text":"நமது முற்பிதாக்களுக்குக் கட்டளையிட்டார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அடுத்த தலைமுறையினர் உமது சட்டத்தை அறிந்துகொள்வார்கள்;","poem":1},{"text":"இனி பிறக்கவிருக்கும் பிள்ளைகளும் அறிந்துகொள்வார்கள்,","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய பிள்ளைகளுக்கு கற்றுக்கொடுப்பார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அதினால் அவர்கள் இறைவனில் தங்கள் நம்பிக்கையை வைத்து,","poem":1},{"text":"அவருடைய செயல்களை மறவாமல்,","poem":2},{"lineBreak":true},{"text":"அவருடைய கட்டளைகளைக் கைக்கொள்ளுவார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்கள் தங்கள் முற்பிதாக்களைப்போல் இருக்கமாட்டார்கள்;","poem":1},{"text":"ஏனெனில் அவர்களுடைய முற்பிதாக்கள் பிடிவாதமும் கலகமும் உள்ள தலைமுறையினராயும்","poem":2},{"text":"நேர்மையற்ற இருதயமுள்ளவர்களாகவும்,","poem":1},{"text":"அவர்களுடைய ஆவி இறைவனிடம் உண்மையற்றதாய் இருந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"எப்பிராயீமின் மனிதர்கள் வில்லேந்தியவர்களாய் இருந்தபோதிலும்,","poem":1},{"text":"யுத்தநாளிலே புறமுதுகு காட்டி ஓடினார்கள்;","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் இறைவனுடைய உடன்படிக்கையைக் கைக்கொள்ளாமல்,","poem":1},{"text":"அவருடைய சட்டத்தின்படி வாழ மறுத்தார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்கள் அவருடைய செயல்களையும்,","poem":1},{"text":"அவர் தங்களுக்குச் செய்த அதிசயங்களையும் மறந்தார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவர் சோவான் பிரதேசத்திலே எகிப்து நாட்டில்,","poem":1},{"text":"அவர்களுடைய முற்பிதாக்களுக்கு முன்பாக அற்புதங்களைச் செய்தார்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர் கடலைப் பிரித்து அதற்குள் அவர்களை நடத்தினார்;","poem":1},{"text":"அவர் தண்ணீரை ஒரு சுவர்போல் உறுதியாய் நிற்கச்செய்தார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர் பகலில் மேகத்தினாலும்,","poem":1},{"text":"இரவு முழுவதும் நெருப்பு வெளிச்சத்தினாலும் அவர்களை வழிநடத்தினார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர் பாலைவனத்திலே கற்பாறைகளைப் பிளந்து,","poem":1},{"text":"கடலளவு நிறைவான தண்ணீரை அவர் குடிக்கக் கொடுத்தார்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர் கற்பாறை வெடிப்புகளிலிருந்து நீரோடைகளை வருவித்து,","poem":1},{"text":"தண்ணீரை ஆறுகளைப்போல் பாயும்படி செய்தார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"ஆனாலும் அவர்களோ அவருக்கு விரோதமாய் தொடர்ந்து பாவம் செய்தார்கள்;","poem":1},{"text":"மகா உன்னதமானவருக்கு விரோதமாய்ப் பாலைவனத்தில் கலகம் செய்தார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அவர்கள் தாம் ஆசைப்பட்ட உணவைக் கேட்டு,","poem":1},{"text":"வேண்டுமென்றே இறைவனைச் சோதித்தார்கள்.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அவர்கள் இறைவனுக்கு விரோதமாய்ப் பேசி,","poem":1},{"text":"“பாலைவனத்தில் விருந்தளிக்க","poem":2},{"lineBreak":true},{"text":"இறைவனால் முடியுமோ?","poem":2}]},{"type":"verse","number":20,"content":[{"text":"ஆம், அவர் கற்பாறையை அடித்தபோது,","poem":1},{"text":"தண்ணீர் பீறிட்டுப் பாய்ந்தது,","poem":2},{"lineBreak":true},{"text":"நீரோடைகள் நிரம்பி வழிந்தன,","poem":2},{"text":"ஆனால் உணவையும் அவரால் கொடுக்க முடியுமோ?","poem":1},{"text":"தமது மக்களுக்கு இறைச்சியைக் கொடுக்கவும் அவரால் முடியுமோ?” என்றார்கள்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"யெகோவா அவைகளைக் கேட்டபோது, மிகுந்த கோபமடைந்தார்;","poem":1},{"text":"அவருடைய நெருப்பு யாக்கோபுக்கு விரோதமாய்ப் பற்றியெரிந்தது;","poem":2},{"lineBreak":true},{"text":"அவருடைய கடுங்கோபம் இஸ்ரயேலுக்கு விரோதமாய் எழும்பியது.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஏனெனில் அவர்கள் இறைவனை விசுவாசிக்கவுமில்லை,","poem":1},{"text":"அவருடைய மீட்பில் நம்பிக்கை வைக்கவுமில்லை.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"ஆனாலும் அவர் மேலேயுள்ள மேகங்களுக்குக் கட்டளையிட்டார்;","poem":1},{"text":"வானங்களின் கதவுகளைத் திறந்தார்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"அவர் மக்கள் உண்பதற்காக மன்னாவைப் பொழியப்பண்ணினார்;","poem":1},{"text":"பரலோகத்தின் தானியத்தை அவர்களுக்குக் கொடுத்தார்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"இறைவனுடைய தூதர்களின் உணவை மனிதர்கள் சாப்பிட்டார்கள்;","poem":1},{"text":"அவர்கள் வேண்டியமட்டும் உண்ணுவதற்குத் தேவையான உணவை","poem":2},{"lineBreak":true},{"text":"இறைவன் அவர்களுக்கு அனுப்பினார்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவர் வானங்களிலிருந்து கீழ்க்காற்றை வீசப்பண்ணினார்;","poem":1},{"text":"தம் வல்லமையினால் தென்காற்றை வழிநடத்தினார்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"அவர் இறைச்சியை அவர்கள்மேல் தூசியைப்போல் திரளாய் பொழியச் செய்தார்,","poem":1},{"text":"பறக்கும் பறவைகளை கடற்கரை மணலைப்போல் பொழியச் செய்தார்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"அவர் அவற்றை அவர்களுடைய முகாமின் நடுவிலும்,","poem":1},{"text":"அவர்களுடைய கூடாரங்களைச் சுற்றிலும் விழச்செய்தார்.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"அவர்கள் திருப்தியடையுமட்டும் சாப்பிட்டார்கள்;","poem":1},{"text":"அவர்கள் எதை ஆசைப்பட்டார்களோ அதையே அவர்களுக்குக் கொடுத்தார்.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"ஆனாலும் அவர்கள் ஆசைப்பட்ட உணவைச் சாப்பிட்டு முடிக்குமுன்,","poem":1},{"text":"அது அவர்களுடைய வாய்களில் இருக்கும்போதே,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"இறைவனுடைய கோபம் அவர்களுக்கு விரோதமாய் எழுந்தது;","poem":1},{"text":"அவர் அவர்கள் மத்தியிலுள்ள பலமானவர்களைக் அழித்து,","poem":2},{"lineBreak":true},{"text":"இஸ்ரயேலின் இளைஞர்களை வீழ்த்தினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"இவைகளெல்லாம் ஏற்பட்டபோதிலும்,","poem":1},{"text":"அவர்கள் தொடர்ந்து பாவம் செய்துகொண்டே இருந்தார்கள்;","poem":2},{"lineBreak":true},{"text":"அவருடைய அதிசயங்களைக் கண்டும் அவர்கள் அவரை நம்பவில்லை.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ஆகவே அவர் அவர்களுடைய நாட்களைப் பயனற்றதாயும்,","poem":1},{"text":"அவர்களுடைய வருடங்களைப் பயங்கரமானதாயும் முடியப்பண்ணினார்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"இறைவன் அவர்களில் பலரை அழிக்கும்போதெல்லாம் அவர்கள் அவரைத் தேடினார்கள்;","poem":1},{"text":"ஆர்வத்தோடு அவரிடம் திரும்பி வந்தார்கள்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"இறைவன் தங்கள் கன்மலையாய் இருந்தார் என்றும்,","poem":1},{"text":"மகா உன்னதமான இறைவன் தங்கள் மீட்பராய் இருந்தார் என்றும் நினைவில் கொண்டார்கள்.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"ஆனாலும் அவர்கள் தங்கள் வாயினால் அவரைப் புகழ்ந்து,","poem":1},{"text":"தங்கள் நாவினால் பொய் சொன்னார்கள்.","poem":2}]},{"type":"verse","number":37,"content":[{"text":"அவர்களுடைய இருதயங்கள் அவரிடத்தில் உறுதியாய் இருக்கவில்லை;","poem":1},{"text":"அவர்கள் அவருடைய உடன்படிக்கைக்கு உண்மையாய் இருந்ததுமில்லை.","poem":2}]},{"type":"verse","number":38,"content":[{"text":"ஆகிலும் அவர் இரக்கம் உள்ளவராகவே இருந்தார்;","poem":1},{"text":"அவர் அவர்களை அழித்துவிடாமல்","poem":2},{"lineBreak":true},{"text":"அவர்களுடைய அநியாயங்களை மன்னித்தார்.","poem":2},{"text":"அவர் அநேகமுறை கோபங்கொள்ளவில்லை,","poem":1},{"text":"அவர் தமது கடுங்கோபத்தை முழுமையாக வெளிப்படுத்தவில்லை.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"அவர்கள் மனிதர்கள் மட்டுமே என்பதையும்,","poem":1},{"text":"அவர்கள் ஒருபோதும் திரும்பிவராத காற்று என்பதையும் அவர் நினைவிற்கொண்டார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":40,"content":[{"text":"அவர்கள் எத்தனை முறை பாலைவனத்திலே அவருக்கு விரோதமாய்க் கலகம் செய்தார்கள்;","poem":1},{"text":"பாழ்நிலத்திலே அவரைத் துக்கப்படுத்தினார்கள்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"அவர்கள் திரும்பத்திரும்ப இறைவனைச் சோதித்தார்கள்;","poem":1},{"text":"அவர்கள் இஸ்ரயேலின் பரிசுத்தரை வேதனைப்படுத்தினார்கள்.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"அவர்கள் அவருடைய வல்லமையையும்,","poem":1},{"text":"ஒடுக்கியவனிடமிருந்து அவர் தங்களை மீட்ட நாளையும் நினைவில்கொள்ளவில்லை.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"அந்நாளில் எகிப்திலே அவர் அடையாளங்களையும்,","poem":1},{"text":"சோவான் பிரதேசத்தில் அற்புதங்களையும் செய்தார்.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"அவர் அவர்களுடைய நதிகளை இரத்தமாக மாறப்பண்ணினார்;","poem":1},{"text":"அவர்களுடைய நீரோடைகளிலிருந்து அவர்களால் தண்ணீர் குடிக்க முடியவில்லை.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"அவர் பறக்கும் வண்டு கூட்டங்களை அனுப்பினார், அவைகள் அவர்களை தாக்கின.","poem":1},{"text":"அவர் தவளைகளை அனுப்பினார், அவைகள் அவர்களைப் பாழாக்கின.","poem":2}]},{"type":"verse","number":46,"content":[{"text":"அவர் அவர்களுடைய பயிர்களைப் பச்சைப் புழுக்களுக்கும்,","poem":1},{"text":"அவர்களுடைய விளைச்சல்களை வெட்டுக்கிளிகளுக்கும் ஒப்புக்கொடுத்தார்.","poem":2}]},{"type":"verse","number":47,"content":[{"text":"அவர் அவர்களுடைய திராட்சைக் கொடிகளை பனிக்கட்டி மழையாலும்,","poem":1},{"text":"அவர்களுடைய காட்டத்தி மரங்களை கல்மழையாலும் அழித்தார்.","poem":2}]},{"type":"verse","number":48,"content":[{"text":"அவர் அவர்களுடைய மாடுகளை பனிக்கட்டி மழைக்கும்,","poem":1},{"text":"அவர்களுடைய மந்தை மிருகங்களை மின்னல் தாக்கத்திற்கும் ஒப்புக்கொடுத்தார்.","poem":2}]},{"type":"verse","number":49,"content":[{"text":"அவர் தமது கடுங்கோபத்தையும்,","poem":1},{"text":"சினத்தையும், எதிர்ப்பையும்,","poem":2},{"lineBreak":true},{"text":"இன்னலையும் அழிவின் தூதர் கூட்டமாக அவர்கள்மேல் கட்டவிழ்த்தார்.","poem":2}]},{"type":"verse","number":50,"content":[{"text":"அவர் தமது கோபத்தை வெளிப்படுத்துவதற்கான ஒரு வழியை அமைத்தார்;","poem":1},{"text":"அவர் அவர்களை மரணத்திலிருந்து தப்பவிடாமல்,","poem":2},{"lineBreak":true},{"text":"கொள்ளைநோய்க்கு ஒப்புக்கொடுத்தார்.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"அவர் எகிப்தின் எல்லா மூத்த மகன்களையும்","poem":1},{"text":"காமின் கூடாரங்களில்","poem":2},{"noteId":8},{"text":"அவர்களுக்கு பிறந்த மூத்த மகன்களையும் அழித்தார்.","poem":2}]},{"type":"verse","number":52,"content":[{"text":"ஆனால் அவர் தமது மக்களை செம்மறியாடுகளைப்போல் வெளியே கொண்டுவந்து,","poem":1},{"text":"அவர்களை மந்தையைப்போல் பாலைவனத்தின் வழியே,","poem":2}]},{"type":"verse","number":53,"content":[{"text":"பாதுகாப்பாய் அவர்களை அழைத்துச் சென்றபடியால்,","poem":1},{"text":"அவர்கள் பயப்படாதிருந்தார்கள்;","poem":2},{"lineBreak":true},{"text":"ஆனால் அவர்களுடைய பகைவர்களையோ, கடல் மூடிப்போட்டது.","poem":2}]},{"type":"verse","number":54,"content":[{"text":"இறைவன் தமது பரிசுத்த நாட்டின் எல்லைக்கு,","poem":1},{"text":"தமது வலதுகரத்தினால் கைப்பற்றியிருந்த மலைநாட்டிற்கு, அவர்களைக் கொண்டுவந்தார்.","poem":2}]},{"type":"verse","number":55,"content":[{"text":"அவர் அவர்களுக்கு முன்பாகப் பிற நாட்டு மக்களைத் துரத்தி,","poem":1},{"text":"அவர்களுடைய நிலங்களைப் பங்கிட்டு சொத்துரிமையாகப் பிரித்துக் கொடுத்தார்;","poem":2},{"lineBreak":true},{"text":"அவர் இஸ்ரயேலின் கோத்திரங்களை அவர்களுடைய வீடுகளில் குடியமர்த்தினார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":56,"content":[{"text":"ஆனால், அவர்களோ இறைவனைச் சோதித்து,","poem":1},{"text":"உன்னதமானவருக்கு விரோதமாய்க் கலகம் செய்தார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் அவருடைய நியமங்களைக் கைக்கொள்ளவில்லை.","poem":2}]},{"type":"verse","number":57,"content":[{"text":"அவர்கள் தங்களுடைய முன்னோர்களைப் போலவே வழிதவறி, துரோகம் செய்தார்கள்;","poem":1},{"text":"இலக்குத் தவறும் வில்லைப்போல் நம்பமுடியாதவர்களாய் இருந்தார்கள்.","poem":2}]},{"type":"verse","number":58,"content":[{"text":"அவர்கள் தங்கள் வழிபாட்டு மேடைகளால் அவருக்குக் கோபமூட்டினார்கள்;","poem":1},{"text":"அவர்கள் தங்களுடைய இறைவனல்லாதவைகளால் அவருக்கு எரிச்சலை மூட்டினார்கள்.","poem":2}]},{"type":"verse","number":59,"content":[{"text":"இறைவன் அவற்றைக் கேட்டபோது மிகவும் கோபங்கொண்டார்;","poem":1},{"text":"அவர் இஸ்ரயேலரை முழுமையாகப் புறக்கணித்தார்.","poem":2}]},{"type":"verse","number":60,"content":[{"text":"மனிதர் மத்தியில் தாம் அமைத்திருந்த கூடாரமாகிய","poem":1},{"text":"சீலோவின் இறைசமுகக் கூடாரத்தைவிட்டு அகன்றார்.","poem":2}]},{"type":"verse","number":61,"content":[{"text":"அவர் தமது வல்லமையின் உடன்படிக்கைப் பெட்டியைச் சிறைப்பட்டுப் போகச்செய்து,","poem":1},{"text":"தமது மகிமையைப் பகைவரின் கைகளில் ஒப்புக்கொடுத்தார்.","poem":2}]},{"type":"verse","number":62,"content":[{"text":"அவர் தமது மக்களை வாளுக்கு ஒப்புக்கொடுத்தார்;","poem":1},{"text":"அவர் தமது உரிமைச்சொத்தான அவர்கள்மீது மிகவும் கோபங்கொண்டார்.","poem":2}]},{"type":"verse","number":63,"content":[{"text":"அவர்களுடைய இளைஞரை நெருப்பு சுட்டெரித்தது;","poem":1},{"text":"அவர்களுடைய இளம்பெண்களுக்குத் திருமணப் பாடல்கள் இல்லாமல் போனது.","poem":2}]},{"type":"verse","number":64,"content":[{"text":"அவர்களுடைய ஆசாரியர்கள் வாளுக்கு இரையாக்கப்பட்டார்கள்;","poem":1},{"text":"அவர்களுடைய விதவைகளினால் அழவும் முடியவில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":65,"content":[{"text":"அதின்பின் யெகோவா நித்திரையிலிருந்து எழும்புவது போலவும்,","poem":1},{"text":"போர்வீரன் மதுமயக்கத்திலிருந்து எழும்புவது போலவும் விழித்தெழுந்தார்.","poem":2}]},{"type":"verse","number":66,"content":[{"text":"அவர் தமது பகைவர்களை விரட்டிப் பின்வாங்கச் செய்தார்;","poem":1},{"text":"அவர்களை நித்திய வெட்கத்திற்கு உள்ளாக்கினார்.","poem":2}]},{"type":"verse","number":67,"content":[{"text":"அவர் யோசேப்பின் வம்சங்களைப் புறக்கணித்தார்;","poem":1},{"text":"எப்பிராயீம் கோத்திரத்தை அவர் தெரிந்துகொள்ளவில்லை.","poem":2}]},{"type":"verse","number":68,"content":[{"text":"ஆனால் அவர் யூதா கோத்திரத்தையும்,","poem":1},{"text":"தாம் நேசித்த சீயோன் மலையையும் தெரிந்துகொண்டார்.","poem":2}]},{"type":"verse","number":69,"content":[{"text":"அவர் தாம் வாழும் தமது பரிசுத்த இடத்தை உயர்ந்த வானங்களைப் போலவும்,","poem":1},{"text":"நித்தியமாய் தாம் நிலைப்படுத்தின பூமியைப்போலவும் கட்டினார்.","poem":2}]},{"type":"verse","number":70,"content":[{"text":"அவர் தமது அடியானாகிய தாவீதைத் தெரிந்தெடுத்து,","poem":1},{"text":"அவனை செம்மறியாட்டுத் தொழுவங்களிலிருந்து கொண்டுவந்தார்.","poem":2}]},{"type":"verse","number":71,"content":[{"text":"ஆடுகளை மேய்ப்பதைவிட்டுத் தமது மக்களாகிய யாக்கோபுக்கும்,","poem":1},{"text":"தமது உரிமைச்சொத்தான இஸ்ரயேலுக்கும்","poem":2},{"lineBreak":true},{"text":"மேய்ப்பனாக இருக்கும்படியாக அவனைக் கொண்டுவந்தார்.","poem":2}]},{"type":"verse","number":72,"content":[{"text":"தாவீது அவர்களை தன் இருதயத்தின் உத்தமத்தோடு மேய்த்தான்;","poem":1},{"text":"கைத்திறமையால் அவர்களை வழிநடத்தினான்.","poem":2}]}],"footnotes":[{"noteId":8,"caller":"+","text":"காமின் கூடாரங்களில் என்பது எகிப்தைப் பற்றி பேசும் ஒரு வழியாகும்.","reference":{"chapter":78,"verse":51}}]},"thisChapterLink":"/api/tam_tcv/PSA/78.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/79.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/77.json","previousChapterAudioLinks":{},"numberOfVerses":72}