{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":79,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, பிற நாட்டு மக்கள் உமது உரிமைச்சொத்தின்மேல் படையெடுத்தார்கள்;","poem":1},{"text":"அவர்கள் உமது பரிசுத்த ஆலயத்தை அசுத்தப்படுத்திவிட்டார்கள்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் எருசலேமை இடித்துக் கற்குவியலாக்கிவிட்டார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவர்கள் உமது பணியாளர்களின் இறந்த உடல்களை","poem":1},{"text":"ஆகாயத்துப் பறவைகளுக்கு இரையாக்கி,","poem":2},{"lineBreak":true},{"text":"உமது பரிசுத்தவான்களின் சதையை காட்டு மிருகங்களுக்குக் கொடுத்துள்ளார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் எருசலேம் முழுவதையும் சுற்றிலும்,","poem":1},{"text":"இரத்தத்தைத் தண்ணீரைப்போல் ஊற்றிவிட்டார்கள்;","poem":2},{"lineBreak":true},{"text":"அங்கு இறந்தோரைப் புதைக்க ஒருவரும் இல்லை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நாங்கள் எங்கள் அயலாரின் நிந்தனைக்கும்,","poem":1},{"text":"எங்கள் சுற்றுப்புறத்தாரின் ஏளனத்திற்கும் கேலிக்கும் உரியவர்களாய் இருக்கிறோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, எதுவரைக்கும் எங்கள்மேல் கோபமாய் இருப்பீர்?","poem":1},{"text":"எப்பொழுதுமே கோபமாய் இருப்பீரோ?","poem":2},{"lineBreak":true},{"text":"உமது சினம் எவ்வளவு காலத்திற்கு நெருப்பைப்போல் எரியும்?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உம்மை ஏற்றுக்கொள்ள மறுக்கும் நாடுகள்மேலும்,","poem":1},{"text":"உமது பெயரைச் சொல்லி வழிபடாத","poem":2},{"text":"அரசுகள் மேலும்","poem":1},{"text":"உமது கடுங்கோபத்தை ஊற்றும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஏனெனில் அவர்கள் யாக்கோபை விழுங்கி,","poem":1},{"text":"அவனுடைய சொந்த நாட்டை அழித்துப்போட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"எங்கள் முன்னோரின் பாவங்களை எங்களுக்கு விரோதமாய் நினைவில் கொள்ளாதேயும்;","poem":1},{"text":"உமது இரக்கம் எங்களை விரைவாய் சந்திப்பதாக;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் நாங்கள் மிகவும் தாழ்த்தப்பட்டு இருக்கிறோம்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எங்கள் இரட்சகராகிய இறைவனே,","poem":1},{"text":"உமது பெயரின் மகிமையின் நிமித்தம் எங்களுக்கு உதவிசெய்யும்;","poem":2},{"text":"உமது பெயரின் நிமித்தம்","poem":1},{"text":"எங்களை மீட்டு, எங்கள் பாவங்களை மன்னியும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“அவர்களுடைய இறைவன் எங்கே?”","poem":1},{"text":"என்று பிற நாட்டு மக்கள் ஏன் சொல்லவேண்டும்?","poem":2},{"lineBreak":true},{"text":"சிந்தப்பட்ட உமது ஊழியரின் இரத்தத்திற்காக நீர் பழிவாங்குகிறீர் என்பதை,","poem":1},{"text":"எங்கள் கண்களுக்கு முன்பாக பிற நாட்டு மக்கள் மத்தியில் தெரியும்படிச் செய்யும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"சிறைக் கைதிகளின் பெருமூச்சைக் கேளும்;","poem":1},{"text":"மரணத் தீர்ப்புக்கு உள்ளானவர்களை உமது புயத்தின் பலத்தால் பாதுகாத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"யெகோவாவே, எங்கள் அயலார் உம்மேல் வாரியெறிந்த நிந்தனையை","poem":1},{"text":"அவர்களுடைய மடியில் ஏழுமடங்காகத் திரும்பக்கொடும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அப்பொழுது உமது மக்களும் உமது நிலத்தின் செம்மறியாடுகளுமாகிய நாங்கள்","poem":1},{"text":"என்றென்றும் உம்மைத் துதிப்போம்;","poem":2},{"text":"தலைமுறை தலைமுறையாக","poem":1},{"text":"நாங்கள் உமது துதியைச் சொல்வோம்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/79.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/80.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/78.json","previousChapterAudioLinks":{},"numberOfVerses":13}