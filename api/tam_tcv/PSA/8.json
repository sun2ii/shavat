{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":8,"content":[{"type":"hebrew_subtitle","content":["கித்தீத் வாத்தியத்தில் வாசிக்க பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"எங்கள் ஆண்டவராகிய யெகோவாவே,","poem":1},{"text":"பூமியெங்கும் உமது பெயர் எவ்வளவு புகழ் உடையதாய் இருக்கிறது!","poem":2},{"lineBreak":true},{"text":"நீர் வானங்களுக்கு மேலாக","poem":1},{"text":"உமது மகிமையை வைத்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உமது எதிரிகளையும் பழிவாங்குபவர்களையும் ஒடுக்க,","poem":1},{"text":"உமது பகைவர்களின் நிமித்தம் பிள்ளைகள் மற்றும் குழந்தைகளின்","poem":2},{"text":"உதடுகளிலிருந்து வரும் துதியின் மூலமாக","poem":1},{"text":"வல்லமையை உறுதிப்படுத்தினீர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உமது விரல்களின் வேலைப்பாடான வானங்களையும்","poem":1},{"text":"அவற்றில் நீர் பதித்து வைத்த","poem":2},{"text":"சந்திரனையும் நட்சத்திரங்களையும் பற்றி","poem":1},{"text":"நான் சிந்திக்கும்போது,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மனுக்குலத்தில் நீர் கரிசனை கொள்வதற்கும்,","poem":1},{"text":"மனிதரில் நீர் அக்கறை கொள்வதற்கும் அவர்கள் எம்மாத்திரம்?","poem":2},{"noteId":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"நீர் அவர்களை இறைத்தூதர்களைப் பார்க்கிலும் சற்று சிறியவர்களாகப் படைத்து,","poem":1},{"text":"அவர்களை","poem":2},{"noteId":3},{"text":"மகிமையினாலும் கனத்தினாலும் முடிசூட்டினீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உமது கைகளின் வேலைப்பாடுகளின்மேல் அவர்களை ஆளுநர்களாக்கினீர்;","poem":1},{"text":"அனைத்தையும்:","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எல்லா ஆட்டு மந்தைகளையும் மாட்டு மந்தைகளையும்","poem":1},{"text":"காட்டு மிருகங்களையும்","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆகாயத்துப் பறவைகளையும்","poem":1},{"text":"கடல் மீன்களையும்","poem":2},{"lineBreak":true},{"text":"கடற்பரப்பில் நீந்தும் அனைத்தையும் அவர்களுடைய பாதங்களுக்குக்கீழ் வைத்தீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"எங்கள் ஆண்டவராகிய யெகோவாவே,","poem":1},{"text":"பூமியெங்கும் உமது பெயர் எவ்வளவு மாட்சிமை உடையதாய் இருக்கிறது!","poem":2}]}],"footnotes":[{"noteId":2,"caller":"+","text":"எபிரெய மொழியில் மனுஷனை நீர் நினைக்கிறதற்கும், மனுஷக்குமாரனை நீர் கவனிப்பதற்கும் அவன் எம்மாத்திரம்?","reference":{"chapter":8,"verse":4}},{"noteId":3,"caller":"+","text":"அவர்களை அல்லது அவனை","reference":{"chapter":8,"verse":5}}]},"thisChapterLink":"/api/tam_tcv/PSA/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/7.json","previousChapterAudioLinks":{},"numberOfVerses":9}