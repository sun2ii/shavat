{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":80,"content":[{"type":"hebrew_subtitle","content":["“உடன்படிக்கையின் லீலிமலர்” என்ற இசையில் பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இஸ்ரயேலின் மேய்ப்பரே, யோசேப்பை மந்தைபோல் நடத்திச் செல்கிறவரே,","poem":1},{"text":"எங்களுக்குச் செவிகொடும்.","poem":2},{"text":"கேருபீன்களுக்கு இடையில் சிங்காசனத்தில் அமர்ந்திருக்கிறவரே,","poem":1}]},{"type":"verse","number":2,"content":[{"text":"எப்பிராயீம், பென்யமீன், மனாசே கோத்திரங்களுக்கு முன்பாக பிரகாசியும்.","poem":2},{"text":"உமது வல்லமையை எழச்செய்து,","poem":1},{"text":"எங்களை இரட்சிக்க வாரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"இறைவனே, எங்களை முன்னிருந்த நிலைக்குத் திரும்பக் கொண்டுவாரும்;","poem":1},{"text":"உமது முகத்தை எங்கள்மேல் பிரகாசிக்கச் செய்யும்.","poem":2},{"lineBreak":true},{"text":"அப்பொழுது இரட்சிக்கப்படுவோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"சேனைகளின் இறைவனாகிய யெகோவாவே,","poem":1},{"text":"உமது மக்கள் மன்றாடும்போது","poem":2},{"lineBreak":true},{"text":"எவ்வளவு காலத்திற்கு கோபங்கொண்டிருப்பீர்?","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீர் அவர்களுக்குக் கண்ணீரை உணவாகக் கொடுத்தீர்;","poem":1},{"text":"நீர் அவர்களை நிறைய கண்ணீரைப் பருகும்படிச் செய்தீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நீர் எங்களை அயலாருக்கிடையே கேலிப் பொருளாக்கினீர்;","poem":1},{"text":"எங்கள் பகைவர் எங்களை ஏளனம் செய்யவிட்டீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"சேனைகளின் இறைவனே, எங்களை முன்னிருந்த நிலைக்குத் திரும்பக் கொண்டுவாரும்;","poem":1},{"text":"நாங்கள் இரட்சிக்கப்படும்படி","poem":2},{"lineBreak":true},{"text":"உமது முகத்தை எங்கள்மேல் பிரகாசிக்கச் செய்யும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"நீர் எகிப்திலிருந்து ஒரு திராட்சைக் கொடியைக் கொண்டுவந்தீர்;","poem":1},{"text":"பிற நாட்டு மக்களைத் துரத்திவிட்டு அதை நாட்டினீர்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நீர் அந்த திராட்சைக் கொடிக்காக நிலத்தைச் சுத்தப்படுத்தினீர்;","poem":1},{"text":"அது வேர்விட்டு நாடெங்கும் படர்ந்தது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அதின் நிழலால் மலைகள் மூடப்பட்டன;","poem":1},{"text":"அதின் கிளைகளால் வலிமையான கேதுரு மரங்களும் மூடப்பட்டன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அது தன் கிளைகளை மத்திய தரைக்கடல் வரைக்கும்,","poem":1},{"text":"தன் தளிர்களை நதி","poem":2},{"noteId":9},{"text":"வரைக்கும் பரப்பியது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"நீர் ஏன் அதின் மதில்களைத் தகர்த்துப்போட்டீர்?","poem":1},{"text":"அதைக் கடந்துபோகிற எல்லாருமே இப்போது அதின் பழங்களைப் பறிக்கிறார்களே.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"காட்டுப் பன்றிகள் அதை அழிக்கின்றன;","poem":1},{"text":"வயல்வெளியின் உயிரினங்கள் அதில் மேய்கின்றன.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"சேனைகளின் இறைவனே, எங்களிடம் திரும்பி வாரும்,","poem":1},{"text":"பரலோகத்திலிருந்து கீழே நோக்கிப்பாரும்,","poem":2},{"text":"இந்தத் திராட்சைக் கொடியைக் கவனியும்,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"உமது வலதுகரம் நாட்டிய வேரையும்,","poem":2},{"lineBreak":true},{"text":"உமக்காகவே நீர் வளர்த்தெடுத்த உமது மகனையும் காத்துக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"உமது திராட்சைக்கொடி வெட்டப்பட்டு, நெருப்பினால் எரிக்கப்பட்டது;","poem":1},{"text":"உமது முகத்தின் கண்டிப்பான பார்வையினால் உமது மக்கள் அழிகிறார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"உமது கரத்தை உமது வலதுபக்கத்திலுள்ள மனிதன்மேல்,","poem":1},{"text":"உமக்காகவே நீர் வளர்த்தெடுத்த மானிடமகன்மேல் அமரச்செய்யும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"அப்பொழுது நாங்கள் உம்மைவிட்டு விலகமாட்டோம்;","poem":1},{"text":"எங்களை உயிர்ப்பியும், நாங்கள் உமது பெயரைச் சொல்லி வழிபடுவோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"சேனைகளின் இறைவனாகிய யெகோவாவே,","poem":1},{"text":"எங்களை முன்னிருந்த நிலைக்குத் திரும்பக் கொண்டுவாரும்;","poem":2},{"text":"நாங்கள் இரட்சிக்கப்படும்படி","poem":1},{"text":"உமது முகத்தை எங்கள்மேல் பிரகாசிக்கச் செய்யும்.","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"அதாவது, ஐப்பிராத்து","reference":{"chapter":80,"verse":11}}]},"thisChapterLink":"/api/tam_tcv/PSA/80.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/81.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/79.json","previousChapterAudioLinks":{},"numberOfVerses":19}