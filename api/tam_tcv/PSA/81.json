{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":81,"content":[{"type":"hebrew_subtitle","content":["கித்தீத் என்னும் இசையில் வாசிக்கும்படி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"நம்முடைய பெலனாகிய இறைவனை மகிழ்ச்சியுடன் பாடுங்கள்,","poem":1},{"text":"யாக்கோபின் இறைவனை சத்தமிட்டு ஆர்ப்பரியுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"இசையைத் தொடங்குங்கள், தம்புராவை தட்டுங்கள்;","poem":1},{"text":"நாதமுள்ள யாழையும் வீணையையும் மீட்டுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நாளிலும்,","poem":1},{"text":"நமது பண்டிகையின் நாளான பெளர்ணமி நாளிலும் கொம்பு எக்காளத்தை ஊதுங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"இது இஸ்ரயேலுக்கு ஒரு விதிமுறையாகவும்,","poem":1},{"text":"யாக்கோபின் இறைவனுடைய நியமமாகவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இறைவன் எகிப்திற்கு விரோதமாகப் புறப்பட்டபொழுது,","poem":1},{"text":"அதை யோசேப்புக்கான ஒழுங்குவிதியாக ஏற்படுத்தினார்.","poem":2},{"lineBreak":true},{"text":"நான் அறியாத ஒரு குரலை இவ்வாறு கேட்டேன்:","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“நான் அவர்களுடைய தோள்களிலிருந்து சுமையை விலக்கினேன்;","poem":1},{"text":"கனமான கூடைகளை சுமப்பதிலிருந்து அவர்களுடைய கைகளை விடுவித்தேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உங்கள் கஷ்டத்தில் நீங்கள் கூப்பிட்டீர்கள், நான் உங்களைத் தப்புவித்தேன்;","poem":1},{"text":"முழங்குகிற மேகத்திலிருந்து நான் உங்களுக்குப் பதிலளித்தேன்;","poem":2},{"lineBreak":true},{"text":"மேரிபாவின் தண்ணீர் அருகில் நான் உங்களைச் சோதித்தேன்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் மக்களே கேளுங்கள், நான் உங்களை எச்சரிக்கிறேன்;","poem":1},{"text":"இஸ்ரயேலே, நீங்கள் எனக்குச் செவிகொடுத்தால் நலமாயிருக்கும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"உங்கள் மத்தியில் நீங்கள் வேறு தெய்வத்தை வைத்திருக்கக்கூடாது;","poem":1},{"text":"வேறு எந்த தெய்வத்தையும் நீங்கள் வணங்கவும் கூடாது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எகிப்திலிருந்து உங்களைக் கொண்டுவந்த உங்கள் இறைவனாகிய யெகோவா நானே;","poem":1},{"text":"உங்கள் வாயை விரிவாய்த் திறவுங்கள்;","poem":2},{"text":"நானே அதை நிரப்புவேன்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“ஆனால் என் மக்களோ, எனக்குச் செவிகொடுக்க மறுத்துவிட்டார்கள்;","poem":1},{"text":"இஸ்ரயேல் மக்கள் எனக்குப் அடங்கியிருக்கவில்லை.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"எனவே நான் அவர்களை தங்கள் சொந்தத் திட்டங்களிலேயே நடக்கும்படி,","poem":1},{"text":"அவர்களை அவர்களுடைய பிடிவாதமான இருதயங்களுக்கே ஒப்புவித்தேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“என் மக்கள் எனக்குச் செவிசாய்த்திருந்தால்,","poem":1},{"text":"இஸ்ரயேலர் என் வழிகளைப் பின்பற்றியிருந்தால்,","poem":2},{"lineBreak":true},{"text":"எவ்வளவு நலமாயிருந்திருக்கும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"நான் எவ்வளவு விரைவில் அவர்களுடைய பகைவர்களை அடக்குவேன்,","poem":1},{"text":"என் கரம் அவர்களின் எதிரிகளுக்கு விரோதமாய் திரும்பும்!","poem":2}]},{"type":"verse","number":15,"content":[{"text":"யெகோவாவை வெறுக்கிறவர்கள் அவருக்கு முன்பாக ஒடுங்கி விழுவார்கள்;","poem":1},{"text":"அவர்களுக்குரிய தண்டனை என்றென்றைக்குமாய் நீடித்திருக்கும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"ஆனால் நீங்களோ, மிகச்சிறந்த கோதுமையினால் உணவளிக்கப்படுவீர்கள்;","poem":1},{"text":"மலைத் தேனினால் நான் உங்களைத் திருப்தியாக்குவேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/81.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/82.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/80.json","previousChapterAudioLinks":{},"numberOfVerses":16}