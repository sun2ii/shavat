{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":82,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"மகா சபையிலே இறைவன் தலைமை வகிக்கிறார்;","poem":1},{"text":"“கடவுள்களுக்கு” நடுவிலே அவர் தீர்ப்பு வழங்குகிறார்:","poem":2}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"“நீங்கள் எதுவரைக்கும் அநீதியான தீர்ப்பு வழங்கி,","poem":1},{"text":"கொடியவர்களுக்குப் பாரபட்சம் காட்டுவீர்கள்?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பலவீனருக்கும், தந்தையற்றோருக்கும் நீதி வழங்குங்கள்;","poem":1},{"text":"ஏழைகளுடைய ஒடுக்கப்பட்டவர்களுடைய உரிமைகளுக்குப் பாதுகாப்பளியுங்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பலவீனரையும் ஏழைகளையும் தப்புவியுங்கள்;","poem":1},{"text":"அவர்களைக் கொடியவர்களின் கையிலிருந்து விடுவியுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“அவர்கள் எதையும் அறியாமலும், விளங்கிக்கொள்ளாமலும் இருக்கிறார்கள்;","poem":1},{"text":"அவர்கள் இருளிலேயே நடக்கிறார்கள்;","poem":2},{"lineBreak":true},{"text":"பூமியின் அடித்தளங்கள் எல்லாம் அசைக்கப்படுகின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“ ‘நீங்கள் “தெய்வங்கள்” என்றும்;","poem":1},{"text":"நீங்கள் எல்லோருமே மகா உன்னதமானவரின் மகன்கள்’ என்றும் நான் சொன்னேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"ஆனாலும், நீங்கள் சாதாரண மனிதர்களைப் போலவே சாவீர்கள்;","poem":1},{"text":"மற்ற எல்லா ஆளுநர்களையும் போலவே நீங்களும் விழுவீர்கள்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"இறைவனே எழுந்தருளும், பூமியை நியாயம் தீர்த்தருளும்;","poem":1},{"text":"ஏனெனில் எல்லா நாட்டு மக்களும் உமது உரிமைச்சொத்தே.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}