{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":83,"content":[{"type":"hebrew_subtitle","content":["ஆசாபின் பாட்டாகிய சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"இறைவனே, மவுனமாய் இருக்கவேண்டாம்;","poem":1},{"text":"செவிகொடாமல் இருக்கவேண்டாம்;","poem":2},{"lineBreak":true},{"text":"இறைவனே, அமைதியாய் இருக்கவேண்டாம்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பாரும், உமது பகைவர் எவ்வளவாய் கொந்தளித்திருக்கிறார்கள்;","poem":1},{"text":"உமது எதிரிகள் எவ்வளவாய்த் தங்கள் தலையை உயர்த்துகிறார்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர்கள் உமது மக்களுக்கு விரோதமாகத் தந்திரமாய் சூழ்ச்சி செய்கிறார்கள்;","poem":1},{"text":"நீர் காக்கிறவர்களுக்கு விரோதமாய் சதித்திட்டம் தீட்டுகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“அவர்கள், வாருங்கள், ஒரு நாடாக அவர்கள் இல்லாதவாறு அழிப்போம்;","poem":1},{"text":"இஸ்ரயேலின் பெயரை இனி எவரும் நினைக்காதவாறு செய்திடுவோம்” என்று சொல்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"அவர்கள் ஒரே மனதுடன் ஒன்றிணைந்து சதித்திட்டம் தீட்டுகிறார்கள்;","poem":1},{"text":"அவர்கள் உமக்கு விரோதமாக தங்களிடையே ஒரு நட்புடன்படிக்கை ஏற்படுத்துகிறார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அந்த உடன்படிக்கையிலே ஏதோமின் கூடாரத்தாரும்,","poem":1},{"text":"இஸ்மயேலர், மோவாபியர், ஆகாரியர்,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கேபாலர், அம்மோனியர், அமலேக்கியர், பெலிஸ்தியர் ஆகியோரும்,","poem":1},{"text":"தீருவின் மக்களும் இணைந்திருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"லோத்தின் சந்ததியினருக்குப் பக்கபலமாய் இருக்க","poem":1},{"text":"அசீரியாவும் அவர்களோடு சேர்ந்துகொண்டது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"இறைவனே, நீர் மீதியானியருக்குச் செய்தது போலவும்,","poem":1},{"text":"கீசோன் நதியருகே சிசெராவுக்கும் யாபீனுக்கும் செய்தது போலவும்","poem":2},{"lineBreak":true},{"text":"அவர்களுக்கும் செய்யும்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்கள் எந்தோரில்","poem":1},{"text":"அழிந்து நிலத்தின் குப்பைபோல் ஆனார்களே.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர்களுடைய தலைவர்களை ஓரேபையும், சேபையும் போலாக்கும்.","poem":1},{"text":"அவர்களுடைய இளவரசர்கள் எல்லோரையும் சேபாவையும், சல்முனாவையும் போலாக்கும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"“அவர்கள் இறைவனின் மேய்ச்சல் நிலங்களை எங்கள் உடைமையாக்குவோம்”","poem":1},{"text":"என்று சொன்னார்களே.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"என் இறைவனே, அவர்களைக் காய்ந்த சருகைப் போலவும்,","poem":1},{"text":"காற்றில் பறக்கும் பதரைப்போலவும் ஆக்கும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"காட்டை நெருப்பு எரித்து அழிப்பது போலவும்,","poem":1},{"text":"நெருப்புச் சுவாலை மலைகள் முழுவதையும் கொழுந்துவிட்டெரியச் செய்வதுபோலவும்,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவர்களை உமது புயலினால் பின்தொடர்ந்து துரத்தும்;","poem":1},{"text":"உமது சூறாவளியினால் திகிலடையச் செய்யும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யெகோவாவே, மனிதர்கள் உமது பெயரைத் தேடும்படி,","poem":1},{"text":"அவர்களுடைய முகங்களை வெட்கத்தால் மூடும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"அவர்கள் எப்பொழுதும் வெட்கமடைந்து, மனம்சோர்ந்து போவார்களாக;","poem":1},{"text":"அவர்கள் அவமானத்தால் அழிவார்களாக.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"யெகோவா என்ற பெயருள்ள நீர் ஒருவரே,","poem":1},{"text":"பூமியெங்கும் மகா உன்னதமானவர் என்பதை அவர்கள் அறிவார்களாக.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":18}