{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":84,"content":[{"type":"hebrew_subtitle","content":["கித்தீத் என்னும் இசையில் வாசிக்கக் கோராகின் மகன்களிலுள்ள பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"சர்வ வல்லமையுள்ள யெகோவாவே,","poem":1},{"text":"உமது தங்குமிடம் எவ்வளவு அழகானது!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் ஆத்துமா யெகோவாவினுடைய ஆலய முற்றங்களுக்காக","poem":1},{"text":"ஏங்கித் தவிக்கிறது;","poem":2},{"text":"என் உடலும் உள்ளமும்","poem":1},{"text":"உயிருள்ள இறைவனை நோக்கி மகிழ்ச்சியுடன் ஆர்ப்பரிக்கிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"என் அரசரும் என் இறைவனுமாய் இருக்கிற சர்வ வல்லமையுள்ள யெகோவாவே,","poem":1},{"text":"உம்முடைய பீடத்தினருகே","poem":2},{"lineBreak":true},{"text":"அடைக்கலான் குருவிக்கு வீடும்,","poem":2},{"text":"இரட்டைவால் குருவிக்குத்","poem":1},{"text":"தன் குஞ்சுகளை வைத்துக்கொள்ள கூடும் கிடைத்ததே.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உம்முடைய வீட்டில் வசிக்கிறவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்;","poem":1},{"text":"அவர்கள் எப்பொழுதும் உம்மைத் துதித்துக்கொண்டே இருப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"உம்மில் பெலன் கொள்கிறவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்,","poem":1},{"text":"தங்கள் உள்ளத்தை சீயோனுக்குச் செல்லும் நெடுஞ்சாலைகள்மேல் பதித்துள்ளார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவர்கள் பாக்கா என்னும் வறண்ட பள்ளத்தாக்கைக் கடந்து போகையில்,","poem":1},{"text":"அதை நீரூற்றுகளின் இடமாக்குகிறார்கள்;","poem":2},{"lineBreak":true},{"text":"முன்மாரி மழையும் அதை நீர்நிலைகளால் நிரப்புகின்றது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர்கள் ஒவ்வொருவரும் சீயோனின் இறைவனுக்கு முன்பாக வரும்வரைக்கும்,","poem":1},{"text":"பலத்தின்மேல் பலம் அடைகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"சர்வ வல்லமையுள்ள இறைவனாகிய யெகோவாவே, என் மன்றாட்டைக் கேளும்;","poem":1},{"text":"யாக்கோபின் இறைவனே, எனக்குச் செவிகொடும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எங்கள் கேடயமாகிய இறைவனே, எங்களை நோக்கிப்பாரும்;","poem":1},{"text":"நீர் அபிஷேகம் பண்ணியவரின் முகத்தை தயவுடன் பாரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"உமது ஆலய முற்றங்களில் ஒரு நாளைக் கழிப்பது,","poem":1},{"text":"வேறெங்காவது ஆயிரம் நாட்களைக் கழிப்பதைவிட சிறந்தது;","poem":2},{"text":"கொடியவர்களின் கூடாரங்களில் குடியிருப்பதைவிட,","poem":1},{"text":"என் இறைவனுடைய வீட்டில் வாசல் காவலனாக இருப்பதை நான் அதிகமாய் விரும்புவேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"ஏனெனில் இறைவனாகிய யெகோவா சூரியனும் கேடயமுமாய் இருக்கிறார்;","poem":1},{"text":"யெகோவா கிருபையையும் மகிமையையும் கொடுப்பார்;","poem":2},{"text":"குற்றமற்றோராய் நடப்போருக்கு","poem":1},{"text":"அவர் நன்மையானவற்றைக் கொடாமல் இருப்பதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"சர்வ வல்லமையுள்ள யெகோவாவே,","poem":1},{"text":"உம்மில் நம்பிக்கையாயிருக்கிற மனிதர் ஆசீர்வதிக்கப்பட்டவர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/84.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/85.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/83.json","previousChapterAudioLinks":{},"numberOfVerses":12}