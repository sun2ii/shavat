{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":85,"content":[{"type":"hebrew_subtitle","content":["பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட கோராகின் மகன்களின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நீர் உமது நாட்டுக்குத் தயவு காட்டினீர்;","poem":1},{"text":"யாக்கோபின் மக்கள் இழந்த நல்ல நிலையை அவர்களுக்குத் திரும்பக் கொடுத்தீர்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நீர் உமது மக்களின் அநியாயத்தை மன்னித்து,","poem":1},{"text":"அவர்களுடைய பாவங்களையெல்லாம் மூடிவிட்டீர்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நீர் உமது கடுங்கோபத்தையெல்லாம் விலக்கிவிட்டு,","poem":1},{"text":"உமது பெருங்கோபத்திலிருந்தும் திரும்பினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"எங்கள் இரட்சகராகிய இறைவனே, மறுபடியும் எங்களைப் புதுப்பியும்;","poem":1},{"text":"எங்கள் மேலுள்ள உமது கோபத்தை அகற்றும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீர் எங்களுடன் என்றென்றும் கோபமாய் இருப்பீரோ?","poem":1},{"text":"உமது கோபத்தைத் தலைமுறைகள்தோறும் நீடிக்கச் செய்வீரோ?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உமது மக்கள் உம்மில் மகிழ்ந்திருக்கும்படி","poem":1},{"text":"நீர் எங்களை மீண்டும் உயிர்ப்பிக்கமாட்டீரோ?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"யெகோவாவே, உமது உடன்படிக்கையின் அன்பை எங்களுக்குக் காண்பித்து,","poem":1},{"text":"உமது இரட்சிப்பை எங்களுக்குத் தாரும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவாகிய இறைவன் சொல்வதை நான் கேட்பேன்;","poem":1},{"text":"அவர் தமது மக்களுக்கும் தமது பரிசுத்தவான்களுக்கும் சமாதானத்தை வாக்குப் பண்ணுகிறார்;","poem":2},{"lineBreak":true},{"text":"ஆனால் அவர்கள் மதியீனத்துக்குத் திரும்பாதிருக்கட்டும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவருக்குப் பயந்து நடப்பவர்களுக்கு,","poem":1},{"text":"அவருடைய இரட்சிப்பு நிச்சயமாகவே சமீபமாய் இருப்பதால்,","poem":2},{"lineBreak":true},{"text":"அவருடைய மகிமையும் நமது நாட்டில் தங்கியிருக்கும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"அன்பும் உண்மையும் ஒன்றாய்ச் சந்திக்கின்றன;","poem":1},{"text":"நீதியும் சமாதானமும் ஒன்றையொன்று முத்தம் செய்கின்றன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உண்மை பூமியிலிருந்து முளைத்தெழும்புகிறது,","poem":1},{"text":"நீதி வானத்திலிருந்து கீழே பார்க்கிறது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"யெகோவா உண்மையாகவே நன்மையானதைத் தருவார்;","poem":1},{"text":"நம்முடைய நாடும் அதின் விளைச்சலைக் கொடுக்கும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீதி அவருக்கு முன்சென்று,","poem":1},{"text":"அவருடைய காலடிகளுக்காக வழியை ஆயத்தப்படுத்துகிறது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/85.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/86.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/84.json","previousChapterAudioLinks":{},"numberOfVerses":13}