{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":86,"content":[{"type":"hebrew_subtitle","content":["தாவீதின் மன்றாட்டு."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, எனக்குச் செவிசாய்த்துப் பதிலளியும்,","poem":1},{"text":"ஏனெனில், நான் ஏழையும் எளியவனுமாய் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் உமக்கு உண்மையாயிருப்பதால் என் வாழ்வைக் காத்துக்கொள்ளும்;","poem":1},{"text":"உம்மில் நம்பிக்கை வைத்திருக்கும் உமது அடியேனைக் காப்பாற்றும்.","poem":2},{"text":"நீரே என் இறைவன்;","poem":1}]},{"type":"verse","number":3,"content":[{"text":"என்மேல் இரக்கமாய் இரும், யெகோவாவே,","poem":1},{"text":"நான் நாளெல்லாம் உம்மை நோக்கிக் கூப்பிடுகிறேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே உமது அடியேனுக்கு மகிழ்ச்சியைத் தாரும்;","poem":1},{"text":"ஏனெனில் நான் என் நம்பிக்கையை உம்மேல் வைக்கிறேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, நீர் மன்னிக்கிறவரும் நல்லவருமாய் இருக்கிறீர்;","poem":1},{"text":"உம்மை நோக்கிக் கூப்பிடுகிற அனைவருக்கும் அன்பு மிகுந்தவராயும் இருக்கிறீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவே என் மன்றாட்டுக்குச் செவிகொடும்;","poem":1},{"text":"இரக்கத்திற்கான என் கதறுதலைக் கேளும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் துன்ப நாளிலே, நான் உம்மை நோக்கிக் கூப்பிடுவேன்;","poem":1},{"text":"ஏனெனில் நீர் எனக்குப் பதில் கொடுப்பீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவே, தெய்வங்களில் உம்மைப் போன்றவர் ஒருவரும் இல்லை;","poem":1},{"text":"உமது செயல்களை யாராலும் செய்யமுடியாது.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, நீர் உண்டாக்கிய எல்லா நாட்டு மக்களும்","poem":1},{"text":"உமக்கு முன்பாக வந்து வழிபடுவார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் உமது பெயருக்கு மகிமையைக் கொண்டுவருவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீர் பெரியவராய் இருக்கிறீர், மகத்துவமான செயல்களைச் செய்கிறீர்;","poem":1},{"text":"நீர் ஒருவரே இறைவன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"யெகோவாவே, உமது வழியை எனக்குப் போதியும்;","poem":1},{"text":"அதினால் நான் உமது உண்மையைச் சார்ந்திருப்பேன்;","poem":2},{"text":"நான் உமது பெயரில் பயந்து நடக்கும்படி","poem":1},{"text":"ஒரே சிந்தையுள்ள இருதயத்தை எனக்குத் தாரும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"என் இறைவனாகிய யெகோவாவே, நான் என் முழு இருதயத்தோடும் உம்மைத் துதிப்பேன்;","poem":1},{"text":"உமது பெயரை என்றென்றும் மகிமைப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீர் என்மீது கொண்டிருக்கும் அன்பு பெரியது;","poem":1},{"text":"நீர் என்னை ஆழங்களிலிருந்தும்","poem":2},{"lineBreak":true},{"text":"பாதாளத்திலிருந்தும் விடுவித்தீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"இறைவனே, அகங்காரிகள் என்னைத் தாக்குகிறார்கள்;","poem":1},{"text":"கொடூரமான கூட்டத்தார் என்னைக் கொல்ல முயற்சிக்கின்றனர்,","poem":2},{"lineBreak":true},{"text":"அவர்கள் உம்மை மதிக்காதவர்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"ஆனாலும் யெகோவாவே, நீரோ கருணையும் கிருபையுமுள்ள இறைவனாய் இருக்கிறீர்;","poem":1},{"text":"கோபப்படுவதில் தாமதிப்பவராயும், அன்பும் உண்மையும் நிறைந்தவராயும் இருக்கிறீர்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"என் பக்கமாய்த் திரும்பி என்மேல் இரக்கமாயிரும்;","poem":1},{"text":"உமது அடியேனுக்கு உமது பெலத்தைக் காண்பியும்;","poem":2},{"text":"என்னைக் காப்பாற்றும்,","poem":1},{"text":"ஏனெனில் என் தாயைப்போலவே நானும் உமக்கு சேவை செய்கிறேன்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"என் பகைவர் கண்டு வெட்கப்படும்படியாக,","poem":1},{"text":"உமது நன்மைக்கான ஓர் அடையாளத்தை எனக்குத் தாரும்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் யெகோவாவே, நீர் எனக்கு உதவிசெய்து, என்னைத் தேற்றியிருக்கிறீர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/86.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/87.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/85.json","previousChapterAudioLinks":{},"numberOfVerses":17}