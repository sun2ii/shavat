{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":87,"content":[{"type":"hebrew_subtitle","content":["கோராகின் மகன்களின் பாட்டாகிய சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவா தமது அஸ்திபாரத்தைப் பரிசுத்த மலையில் அமைத்திருக்கிறார்.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"யெகோவா யாக்கோபிலுள்ள எல்லா வாழ்விடங்களைப் பார்க்கிலும்,","poem":1},{"text":"சீயோனின் வாசல்களை நேசிக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"இறைவனின் நகரமே,","poem":1},{"text":"உன்னைக்குறித்து மகிமையான காரியங்கள் சொல்லப்படுகின்றன:","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“என்னை ஏற்றுக்கொள்ளுகிறவர்களோடு","poem":1},{"text":"நான் ராகாபையும் பாபிலோனையும் குறித்து,","poem":2},{"text":"‘இவர்கள் சீயோனிலே பிறந்தவர்கள்’ என்று சொல்வேன்;","poem":1},{"text":"பெலிஸ்தியாவையும் தீருவையும் எத்தியோப்பியாவையும் குறித்தும் அப்படியே சொல்வேன்.”","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உண்மையாகவே சீயோனைக் குறித்து,","poem":1},{"text":"“இன்னார் இன்னார் அங்கே பிறந்தார்கள் என்றும்,","poem":2},{"lineBreak":true},{"text":"மகா உன்னதமானவர் தாமே அதை நிலைநிறுத்துவார்” என்றும் சொல்லப்படும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"“இன்னார் சீயோனிலே பிறந்தார்”","poem":1},{"text":"என்பதாக யெகோவா மக்களின் பதிவேட்டில் எழுதுவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"அவர்கள் இசை மீட்டும்பொழுது,","poem":1},{"text":"“எங்கள் ஊற்றுகள் எல்லாம் உம்மிலேயே இருக்கிறது” என்று பாடுவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/87.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/88.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/86.json","previousChapterAudioLinks":{},"numberOfVerses":7}