{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":88,"content":[{"type":"hebrew_subtitle","content":["மகலாத் லேயனோத் என்னும் இசையில் வாசிக்க, எஸ்ராகியனாகிய ஏமானின் மஸ்கீல் என்னும் கோராகின் மகன்களின் பாட்டாகிய சங்கீதம். பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்டது."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, நீர் என்னைக் காப்பாற்றுகிற இறைவன்;","poem":1},{"text":"இரவும் பகலும் நான் உமக்கு முன்பாகக் கதறுகிறேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என்னுடைய மன்றாட்டு உமக்குமுன் வருவதாக;","poem":1},{"text":"என் கூப்பிடுதலுக்கு செவிகொடுத்துக் கேளும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"என் ஆத்துமா துன்பத்தால் நிறைந்திருக்கிறது;","poem":1},{"text":"என் உயிர் மரணத்தை நெருங்கிக் கொண்டிருக்கிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் பிரேதக்குழிக்குப் போகிறவர்கள்போல் எண்ணப்படுகிறேன்;","poem":1},{"text":"நான் பெலனற்ற மனிதனைப்போல் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நான் மரித்தவர்களுடன் ஒதுக்கப்பட்டிருக்கிறேன்;","poem":1},{"text":"நீர் இனி எப்போதும் உம்மால் நினைவுகூரப்படாமல்","poem":2},{"text":"உமது கவனத்திலிருந்து அகற்றப்பட்டு,","poem":1},{"text":"பாதாளத்தில் அழிக்கப்பட்டவர்கள்போல் ஆனேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"நீர் என்னை மிகுந்த இருளில்,","poem":1},{"text":"ஆழம் மிகுந்த படுகுழியில் போட்டுவிட்டீர்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உமது கோபம் என்மீது மிகவும் பாரமாய் இருக்கிறது;","poem":1},{"text":"உமது அலைகள் எல்லாவற்றினாலும் நீர் என்னை மூடிவிட்டீர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"என் நெருங்கிய நண்பர்களை நீர் என்னைவிட்டு விலக்கி,","poem":1},{"text":"என்னை அவர்களின் வெறுப்புக்கு உள்ளாக்கினீர்;","poem":2},{"text":"நான் அடைபட்டு தப்பமுடியாமல் இருக்கிறேன்.","poem":1}]},{"type":"verse","number":9,"content":[{"text":"என் கண்கள் துக்கத்தினால் மயங்கி இருக்கின்றன.","poem":2},{"lineBreak":true},{"text":"யெகோவாவே, நான் ஒவ்வொரு நாளும் உம்மை நோக்கிக் கூப்பிடுகிறேன்.","poem":1},{"text":"உம்மை நோக்கியே என் கைகளை நீட்டுகிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"இறந்தவர்களுக்கு நீர் உமது அதிசயங்களைக் காட்டுவீரோ?","poem":1},{"text":"இறந்தவர்கள் எழுந்து உம்மைத் துதிப்பார்களோ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பிரேதக்குழியில் உமது அன்பும்,","poem":1},{"text":"அழிவில் உமது சத்தியமும் அறிவிக்கப்படுகிறதோ?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உமது அதிசயங்கள் இருள் நிறைந்த இடத்திலும்,","poem":1},{"text":"மறதியின் நாட்டில் உமது நீதியான செயல்களும் அறியப்படுமோ?","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"ஆனாலும் யெகோவாவே, நான் உதவிகேட்டு உம்மை நோக்கிக் கதறுகிறேன்;","poem":1},{"text":"காலையிலே எனது மன்றாட்டு உமக்கு முன்பாக வருகிறது.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"யெகோவாவே, நீர் ஏன் என்னைப் புறக்கணிக்கிறீர்?","poem":1},{"text":"உமது முகத்தை ஏன் எனக்கு மறைக்கிறீர்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"என் இளமையிலிருந்தே நான் துன்புறுத்தப்பட்டு மரணத்திற்குச் சமீபமானேன்;","poem":1},{"text":"நான் உம்மால் வரும் திகிலை அனுபவித்து மனமுடைந்து போயிருக்கிறேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"உமது கோபம் என்மேல் வந்து என்னை மூடியது;","poem":1},{"text":"உமது திகில் என்னைத் தாக்குகிறது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவை நாள்தோறும் வெள்ளத்தைப்போல் என்னைச் சூழ்ந்து கொள்கின்றன;","poem":1},{"text":"என்னை அவை முழுமையாய் வளைத்துக்கொண்டன.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"நீர் என் கூட்டாளிகளையும் என் அன்புக்குரியவர்களையும்","poem":1},{"text":"என்னைவிட்டு அகற்றினீர்;","poem":2},{"lineBreak":true},{"text":"இருளே என் நெருங்கிய நண்பனாய் இருக்கிறது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/88.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/89.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/87.json","previousChapterAudioLinks":{},"numberOfVerses":18}