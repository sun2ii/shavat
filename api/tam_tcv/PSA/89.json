{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":89,"content":[{"type":"hebrew_subtitle","content":["எஸ்ராகியனாகிய ஏத்தானின் மஸ்கீல் என்னும் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவின் உடன்படிக்கையின் அன்பை நான் என்றென்றும் பாடுவேன்;","poem":1},{"text":"எல்லாத் தலைமுறைகளுக்கும்","poem":2},{"lineBreak":true},{"text":"உமது சத்தியத்தை என் வாயினால் தெரியப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உமது உடன்படிக்கையின் அன்பு","poem":1},{"text":"என்றென்றைக்கும் உறுதியாய் நிலைக்கிறது என்று அறிவிப்பேன்;","poem":2},{"lineBreak":true},{"text":"நீர் உமது சத்தியத்தை வானத்தில் நிறுவினீர் என்பதையும் நான் அறிவிப்பேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“நான் தெரிந்துகொண்டவனோடு ஓர் உடன்படிக்கையை ஏற்படுத்தியிருக்கிறேன்;","poem":1},{"text":"என் அடியவனாகிய தாவீதுக்கு ஆணையிட்டிருக்கிறேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"‘உன் வம்சத்தை என்றென்றும் நிலைநிறுத்தி,","poem":1},{"text":"எல்லாத் தலைமுறைகளிலும் உன் சிங்காசனத்தை உறுதிப்படுத்துவேன்’ ”","poem":2},{"lineBreak":true},{"text":"என்று நீர் சொன்னீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, வானங்கள் உமது அதிசயங்களைப் புகழ்கின்றன;","poem":1},{"text":"அவை பரிசுத்தவான்களின் சபையிலே உமது சத்தியத்தைப் புகழ்கின்றன.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மேலே ஆகாயத்தில் உள்ளவர்களில் யெகோவாவுடன் ஒப்பிடத்தக்கவர் யார்?","poem":1},{"text":"பரலோக தூதர்களின் மத்தியில் யெகோவாவைப் போன்றவர் யார்?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"பரிசுத்தவான்களின் சபையில் இறைவனே மிகவும் பயத்திற்கு உரியவராயிருக்கிறார்;","poem":1},{"text":"தம்மைச் சுற்றியுள்ள எல்லாரைப்பார்க்கிலும் அவரே பிரமிக்கத்தக்கவர்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"சர்வ வல்லமையுள்ள இறைவனாகிய யெகோவாவே, உம்மைப்போல் யாருண்டு?","poem":1},{"text":"யெகோவாவே, நீர் வல்லவர்; உமது சத்தியம் உம்மைச் சூழ்ந்திருக்கிறது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"பொங்கியெழும் கடலின்மேல் நீர் ஆளுகை செய்கிறீர்;","poem":1},{"text":"அதின் அலைகள் பயங்கரமாக எழும்பும்போது நீர் அவற்றை அமைதியாக்குகிறீர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நீர் ராகாபை அழிந்தவர்களில் ஒருவரைப்போல் நொறுக்கினீர்;","poem":1},{"text":"உமது பலமுள்ள புயத்தினால் உமது பகைவரைச் சிதறடித்தீர்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"வானங்கள் உம்முடையவை, பூமியும் உம்முடையதே;","poem":1},{"text":"உலகத்தையும் அதிலுள்ள அனைத்தையும் நீரே நிலைநிறுத்தினீர்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"வடக்கையும் தெற்கையும் நீர் ஏற்படுத்தினீர்;","poem":1},{"text":"தாபோரும் எர்மோனும் உமது பெயரில் மகிழ்ந்து பாடுகின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"உமது புயம் வலிமைமிக்கது;","poem":1},{"text":"உமது கரம் பலமுள்ளது, உமது வலதுகரம் உயர்த்தப்பட்டுள்ளது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"நீதியும் நியாயமும் உமது சிங்காசனத்தின் அடித்தளம்;","poem":1},{"text":"அன்பும் சத்தியமும் உமக்குமுன் செல்கின்றன.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"யெகோவாவே உம்மை ஆர்ப்பரித்துத் துதிக்க அறிந்தவர்கள் ஆசீர்வதிக்கப்பட்டவர்கள்;","poem":1},{"text":"அவர்கள் உமது பிரசன்னத்தின் வெளிச்சத்திலே நடப்பார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவர்கள் நாள்தோறும் உமது பெயரில் களிகூருகிறார்கள்;","poem":1},{"text":"அவர்கள் உமது நீதியில் மேன்மை அடைவார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நீரே அவர்களின் மகிமையும் பெலனுமாய் இருக்கிறீர்;","poem":1},{"text":"நீர் உமது தயவினால் எங்கள் பலத்தை உயரப்பண்ணினீர்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"உண்மையாகவே எங்கள் கேடயம் யெகோவாவுக்குரியது;","poem":1},{"text":"எங்கள் அரசர் இஸ்ரயேலின் பரிசுத்தருக்குரியவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"நீர் ஒருமுறை தரிசனத்தில்,","poem":1},{"text":"உமக்கு உண்மையான மக்களுடன் பேசிச் சொன்னதாவது:","poem":2},{"text":"“நான் ஒரு வீரனைப் பலத்தால் நிறைத்தேன்; மக்கள் மத்தியிலிருந்து நான்","poem":1},{"text":"ஓர் இளைஞனை உயர்த்தியிருக்கிறேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"நான் என் பணியாளனான தாவீதைக் கண்டுபிடித்தேன்;","poem":1},{"text":"என் பரிசுத்த எண்ணெயால் அவனை அபிஷேகம் செய்தேன்.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"என் கரம் அவனைத் தாங்கும்;","poem":1},{"text":"நிச்சயமாகவே என் புயம் அவனைப் பலப்படுத்தும்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"பகைவன் அவனைக் கீழ்ப்படுத்தமாட்டான்;","poem":1},{"text":"கொடியவன் அவனை ஒடுக்கவுமாட்டான்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"நான் அவனுடைய எதிரிகளை அவனுக்கு முன்பாக நொறுக்குவேன்,","poem":1},{"text":"அவனுடைய விரோதிகளை அடித்து வீழ்த்துவேன்.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"என் உடன்படிக்கையின் அன்பும் சத்தியமும் அவனோடிருக்கும்;","poem":1},{"text":"என் பெயரால் அவன் பலம் உயரும்.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"நான் அவனுடைய ஆளுகையை கடலுக்கு மேலாகவும்,","poem":1},{"text":"அவனுடைய ஆட்சியை ஆறுகளுக்கு மேலாகவும் பரப்புவேன்.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"அவன் என்னை நோக்கி, ‘நீரே என் தகப்பன்,","poem":1},{"text":"என் இறைவன், என் இரட்சகராகிய கன்மலை’ என்று கூப்பிடுவான்.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"நான் அவனை எனது முதற்பேறான மகனாகவும்,","poem":1},{"text":"பூமியின் அரசர்களிலெல்லாம் மிக உயர்ந்தவனாகவும் நியமிப்பேன்.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"நான் எப்பொழுதும் அவனுக்கு என் உடன்படிக்கையின் அன்பை வழங்குவேன்;","poem":1},{"text":"நான் அவனோடு செய்யும் உடன்படிக்கை ஒருபோதும் மாறாது.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"நான் அவனுடைய வம்சத்தை என்றென்றைக்கும் நிலைப்படுத்துவேன்;","poem":1},{"text":"அவனுடைய சிங்காசனத்தை வானங்கள் உள்ளமட்டும் நிலைப்படுத்துவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“அவனுடைய மகன்கள் என் சட்டத்தைக் கைவிட்டு,","poem":1},{"text":"என் நியமங்களைப் பின்பற்றாது போனால்,","poem":2}]},{"type":"verse","number":31,"content":[{"text":"என் விதிமுறைகளை மீறி,","poem":1},{"text":"எனது கட்டளைகளைக் கைக்கொள்ளத் தவறினால்,","poem":2}]},{"type":"verse","number":32,"content":[{"text":"நான் அவர்களுடைய பாவத்தைத் தடியினாலும்,","poem":1},{"text":"அவர்களுடைய அநியாயத்தை சவுக்கடியினாலும் தண்டிப்பேன்;","poem":2}]},{"type":"verse","number":33,"content":[{"text":"ஆனாலும் நான் என் உடன்படிக்கையின் அன்பை அவனைவிட்டு அகற்றமாட்டேன்;","poem":1},{"text":"என் வாக்குறுதியை ஒருபோதும் மாற்றவுமாட்டேன்.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"நான் என் உடன்படிக்கையை மீறமாட்டேன்;","poem":1},{"text":"என் உதடுகள் சொன்னதை மாற்றவுமாட்டேன்.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"ஒரேதரமாக நான் என் பரிசுத்தத்தைக்கொண்டு ஆணையிட்டிருக்கிறேன்;","poem":1},{"text":"தாவீதுக்கு நான் பொய்சொல்லமாட்டேன்:","poem":2}]},{"type":"verse","number":36,"content":[{"text":"அவன் சந்ததி என்றென்றைக்கும் நிலைக்கும்,","poem":1},{"text":"அவன் சிங்காசனம் சூரியனைப்போல எனக்கு முன்பாக நிலைநிற்கும்;","poem":2}]},{"type":"verse","number":37,"content":[{"text":"அது ஆகாயத்தின் உண்மையான சாட்சியாக","poem":1},{"text":"சந்திரனைப்போல என்றென்றைக்கும் நிலைநிறுத்தப்படும்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":38,"content":[{"text":"ஆனாலும், இப்பொழுது நீர் அவனைத் தள்ளி,","poem":1},{"text":"அவனைப் புறக்கணித்து விட்டிருக்கிறீர்;","poem":2},{"lineBreak":true},{"text":"நீர் அபிஷேகம் பண்ணியவன்மேல் கோபமாயிருக்கிறீர்.","poem":2}]},{"type":"verse","number":39,"content":[{"text":"உமது பணியாளனுடன் செய்த உடன்படிக்கையை கைவிட்டு,","poem":1},{"text":"அவனுடைய கிரீடத்தைத் தூசியில் தள்ளி அவமானப்படுத்தினீர்.","poem":2}]},{"type":"verse","number":40,"content":[{"text":"நீர் அவனுடைய மதில்களைத் தகர்த்து,","poem":1},{"text":"அவனுடைய அரண்களையெல்லாம் இடித்துத் தூளாக்கினீர்.","poem":2}]},{"type":"verse","number":41,"content":[{"text":"கடந்து செல்லும் அனைவருமே அவனைக் கொள்ளையிட்டார்கள்;","poem":1},{"text":"அவன் தனது அயலவர்களின் இகழ்ச்சிக்குள்ளானான்.","poem":2}]},{"type":"verse","number":42,"content":[{"text":"நீர் அவனுடைய எதிரிகளின் வலதுகையை உயர்த்தினீர்;","poem":1},{"text":"அவனுடைய பகைவர் அனைவரும் மகிழும்படி செய்தீர்.","poem":2}]},{"type":"verse","number":43,"content":[{"text":"நீர் அவனுடைய வாளின் முனையை மழுங்கப்பண்ணி,","poem":1},{"text":"யுத்தத்தில் அவனுக்குத் துணைசெய்யாதிருந்தீர்.","poem":2}]},{"type":"verse","number":44,"content":[{"text":"நீர் அவனுடைய சிறப்புக்கு முடிவை ஏற்படுத்தி,","poem":1},{"text":"அவனுடைய சிங்காசனத்தை தரையிலே தள்ளினீர்.","poem":2}]},{"type":"verse","number":45,"content":[{"text":"நீர் அவனுடைய வாலிப நாட்களை குறுகப்பண்ணி,","poem":1},{"text":"அவனை வெட்கத்தின் உடையால் மூடினீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":46,"content":[{"text":"யெகோவாவே, நீர் எவ்வளவு காலத்திற்கு மறைந்திருப்பீர்?","poem":1},{"text":"நீர் என்றென்றுமாய் மறைந்திருப்பீரோ?","poem":2},{"lineBreak":true},{"text":"எவ்வளவு காலத்திற்கு உமது கோபம் நெருப்பைப்போல் பற்றியெரியும்?","poem":2}]},{"type":"verse","number":47,"content":[{"text":"என் வாழ்வு எவ்வளவு துரிதமாய் முடிவடைகிறது என்பதை நினைத்துக்கொள்ளும்;","poem":1},{"text":"பயனற்ற நோக்கத்திற்காகவா நீர் எல்லா மக்களையும் படைத்தீர்!","poem":2}]},{"type":"verse","number":48,"content":[{"text":"மரணத்தைக் காணாமல் யார் உயிரோடிருப்பான்?","poem":1},{"text":"அல்லது யார் பாதாளத்தின் வல்லமையிலிருந்து தன்னைக் காப்பாற்றிக்கொள்வான்?","poem":2}]},{"type":"verse","number":49,"content":[{"text":"யெகோவாவே, நீர் உமது சத்தியத்தில் தாவீதுக்கு ஆணையிட்ட","poem":1},{"text":"உமது முந்தைய உடன்படிக்கையின் அன்பு எங்கே?","poem":2}]},{"type":"verse","number":50,"content":[{"text":"யெகோவாவே, உமது அடியவன் எவ்வளவாய் ஏளனம் செய்யப்பட்டிருக்கிறேன் என்பதையும்","poem":1},{"text":"எல்லா நாட்டு மக்களின் நிந்தைகளை நான் என் இருதயத்தில்","poem":2},{"lineBreak":true},{"text":"எவ்வாறு சகிக்கிறேன் என்பதையும் நினைத்துக்கொள்ளும்.","poem":2}]},{"type":"verse","number":51,"content":[{"text":"யெகோவாவே, உமது பகைவர் ஏளனம் செய்த நிந்தனை வார்த்தைகளையும்,","poem":1},{"text":"நீர் அபிஷேகித்தவரின் ஒவ்வொரு காலடிகளையும்","poem":2},{"lineBreak":true},{"text":"அவர்கள் ஏளனம் செய்ததையும் நினைத்துக்கொள்ளும்.","poem":2}]},{"type":"line_break"},{"type":"line_break"},{"type":"verse","number":52,"content":[{"text":"யெகோவாவுக்கு என்றென்றைக்கும் துதி உண்டாவதாக!","poem":1},"ஆமென், ஆமென்."]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/89.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/90.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/88.json","previousChapterAudioLinks":{},"numberOfVerses":52}