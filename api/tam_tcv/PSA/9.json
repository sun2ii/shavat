{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":9,"content":[{"type":"hebrew_subtitle","content":["“மகனின் மரணம்” என்ற இராகத்தில் பாடி பாடகர் குழுத் தலைவனுக்கு ஒப்புவிக்கப்பட்ட தாவீதின் சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, என் முழு இருதயத்தோடும் நான் உம்மைத் துதிப்பேன்;","poem":1},{"text":"உமது அதிசயமான செயல்களையெல்லாம் எடுத்துரைப்பேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் மகிழ்ந்து உம்மில் களிகூருவேன்;","poem":1},{"text":"மகா உன்னதமானவரே, உமது பெயருக்குத் துதி பாடுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"என் பகைவர் திரும்பி ஓடுகிறார்கள்;","poem":1},{"text":"அவர்கள் உமக்கு முன்பாக இடறிவிழுந்து அழிந்துபோகிறார்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நீர் எனக்கு ஆதரவாய் நியாயம் செய்து,","poem":1},{"text":"நீதியுள்ள நியாயாதிபதியாய் சிங்காசனத்தில் அமர்ந்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீர் நாடுகளைக் கண்டித்து, கொடியவர்களை ஒழித்துவிட்டீர்;","poem":1},{"text":"அவர்களுடைய பெயரை என்றென்றுமாய் அழித்து விட்டீர்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"முடிவற்ற அழிவு என் பகைவர்களை மேற்கொண்டு,","poem":1},{"text":"நீர் அவர்களுடைய பட்டணங்களை முற்றிலும் அழித்துப்போட்டீர்;","poem":2},{"lineBreak":true},{"text":"அவை பற்றிய ஞாபகமும் ஒழிந்துபோயிற்று.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"யெகோவாவோ என்றென்றும் அரசாளுகிறார்;","poem":1},{"text":"நியாயந்தீர்க்கும்படியாக தமது சிங்காசனத்தை அவர் நிலைநிறுத்தியிருக்கிறார்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர் உலகத்தை நீதியாய் நியாயந்தீர்பார்,","poem":1},{"text":"எல்லா மக்களையும் அவர் நீதியாய் ஆளுகை செய்வார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஒடுக்கப்பட்டோருக்கு யெகோவா அடைக்கலமானவர்;","poem":1},{"text":"இக்கட்டான வேளைகளில் அவர் அரணானவர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"உமது பெயரை அறிந்தவர்கள் உம்மில் நம்பிக்கை வைப்பார்கள்;","poem":1},{"text":"ஏனெனில் யெகோவாவே, உம்மைத் தேடுகிறவர்களை நீர் ஒருபோதும் கைவிடுவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"சீயோனில் சிங்காசனத்தில் அமர்ந்திருக்கும் யெகோவாவைத் துதித்துப் பாடி,","poem":1},{"text":"அவர் செய்தவற்றை நாடுகளுக்குள்ளே பிரசித்தப்படுத்துங்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஏனெனில் இரத்தம் சிந்துகிறவர்களுக்கு அவர் பதிற்செய்ய மறப்பதில்லை;","poem":1},{"text":"அவர் துன்புற்றவர்களின் கதறுதலை அசட்டை செய்வதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"யெகோவாவே, என் பகைவரால் எனக்குவரும் துன்பத்தைப் பாரும்!","poem":1},{"text":"என்மேல் இரக்கங்கொண்டு, மரண வாசல்களிலிருந்து என்னைத் தூக்கிவிடும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அப்பொழுது நான் சீயோனின் வாசல்களில்","poem":1},{"text":"உமது துதிகளைப் பிரசித்தப்படுத்தி,","poem":2},{"lineBreak":true},{"text":"அங்கே உமது இரட்சிப்பில் களிகூருவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"நாடுகள் தாங்கள் தோண்டிய குழிகளுக்குள்ளேயே விழுந்து விட்டார்கள்;","poem":1},{"text":"அவர்கள் மறைத்துவைத்த வலையில் அவர்களுடைய கால்களே அகப்பட்டன.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"யெகோவா தமது நீதியினால் அறியப்படுகிறார்;","poem":1},{"text":"கொடியவர்கள் தங்கள் கைகளின் செயலினாலேயே சிக்கியிருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"கொடியவர்களும் இறைவனை மறக்கும் எல்லா நாட்டினரும்","poem":1},{"text":"பாதாளத்திற்கே திரும்புவார்கள்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"ஆனால் இறைவன் ஏழைகளை ஒருபோதும் மறக்கமாட்டார்;","poem":1},{"text":"துன்புறுத்தப்பட்டோரின் நம்பிக்கை ஒருபோதும் அழிவதில்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"யெகோவாவே, எழுந்தருளும்; மனிதன் வெற்றி கொள்ளாதிருக்கட்டும்;","poem":1},{"text":"நாடுகள் உம்முடைய சமுகத்தில் நியாயந்தீர்க்கப்படட்டும்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"யெகோவாவே, அவர்களுக்கு பயங்கரத்தை உண்டாக்கும்;","poem":1},{"text":"தாங்கள் மனிதர் மட்டுமே என்பதை நாடுகள் அறிந்துகொள்ளட்டும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/8.json","previousChapterAudioLinks":{},"numberOfVerses":20}