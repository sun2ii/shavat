{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":90,"content":[{"type":"hebrew_subtitle","content":["இறைவனின் மனிதனாகிய மோசேயின் மன்றாட்டு."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவே, தலைமுறைதோறும்","poem":1},{"text":"நீரே எங்கள் வாழ்விடமாய் இருக்கிறீர்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மலைகள் தோன்றுமுன்னும், பூமியையும்","poem":1},{"text":"உலகத்தையும் நீர் உருவாக்குமுன்னும்,","poem":2},{"lineBreak":true},{"text":"நித்தியத்திலிருந்து நித்தியம் வரைக்கும் நீரே இறைவனாய் இருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நீர் மனிதனை மீண்டும் தூசிக்குத் திருப்பி,","poem":1},{"text":"“மனுமக்களே, தூசியாகுங்கள்” என்கிறீர்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உமது பார்வையில் ஆயிரம் வருடங்கள்","poem":1},{"text":"கழிந்துபோன ஒரு நாளைப் போலவும்,","poem":2},{"lineBreak":true},{"text":"இரவின் ஒரு சாமத்தைப் போலவும் இருக்கின்றன.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"ஆனாலும் மரண நித்திரையில் நீர் மானிடரை வெள்ளம்போல வாரிக்கொண்டு போகிறீர்;","poem":1},{"text":"அவர்கள் காலையில் முளைக்கும் பசும்புல்லைப்போல் இருக்கிறார்கள்:","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அது காலையில் புதிதாக முளைத்துப் பூத்தாலும்,","poem":1},{"text":"மாலையாகும்போது உலர்ந்து வாடிப்போகும்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நாங்கள் உமது கோபத்தால் சோர்ந்துபோகிறோம்,","poem":1},{"text":"உமது கடுங்கோபத்தால் திகிலடைகிறோம்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நீர் எங்கள் அநியாயங்களை உமக்கு முன்பாகவும்,","poem":1},{"text":"எங்கள் இரகசிய பாவங்களை உமது முகத்தின் வெளிச்சத்திலும் நிறுத்தினீர்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"எங்கள் நாட்கள் எல்லாம் உமது கடுங்கோபத்தால் கடந்துபோய்விட்டது;","poem":1},{"text":"நாங்கள் எங்களுடைய வருடங்களைப் புலம்பலோடே முடிக்கின்றோம்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எங்கள் வாழ்நாட்கள் எழுபது வருடங்களே;","poem":1},{"text":"நாங்கள் பெலனுள்ளவர்களாய் இருந்தால், அது எண்பது வருடங்களாகவும் இருக்கலாம்,","poem":2},{"text":"ஆனாலும் அவை கஷ்டமும் துன்பமும் நிறைந்தவையாகவே இருக்கின்றன;","poem":1},{"text":"எங்கள் வாழ்நாட்கள் விரைவாய்க் கடந்து போகிறது, நாங்களும் பறந்துபோகிறோம்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"உமது கோபத்தின் வல்லமையை யார் அறிவார்?","poem":1},{"text":"உமக்குப் பயப்படத்தக்கதாய் உமது கோபத்தை யார் அறிவார்?","poem":2}]},{"type":"verse","number":12,"content":[{"text":"எங்கள் நாட்களை சரியாகக் கணக்கிட எங்களுக்குப் போதியும்,","poem":1},{"text":"அதினால் நாங்கள் ஞானமுள்ள இருதயத்தைப் பெற்றுக்கொள்வோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"யெகோவாவே, மனமிரங்கும்; எவ்வளவு காலத்திற்கு இந்த நிலை?","poem":1},{"text":"உமது பணியாளர்கள்மேல் கருணையாய் இரும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"காலையிலே எங்களை உமது உடன்படிக்கையின் அன்பினால் திருப்தியாக்கும்;","poem":1},{"text":"அப்பொழுது நாங்கள் இன்பமாய்ப் பாடி,","poem":2},{"lineBreak":true},{"text":"எங்கள் வாழ்நாளெல்லாம் மகிழ்ச்சியாய் இருப்போம்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீர் எங்களைத் துன்புறுத்திய நாட்களுக்கும்,","poem":1},{"text":"நாங்கள் துன்பங்களைக் கண்ட வருடங்களுக்கும் ஈடாக எங்களை மகிழச் செய்யும்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"உமது செயல்கள் உம்முடைய பணியாளர்களுக்கும்,","poem":1},{"text":"உமது மகிமை அவர்களுடைய பிள்ளைகளுக்கும் காண்பிக்கப்படுவதாக.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"எங்கள் இறைவனாகிய யெகோவாவின் தயவு எங்கள்மேல் இருப்பதாக;","poem":1},{"text":"எங்கள் கைகளின் வேலையை நிலைப்படுத்தும்;","poem":2},{"lineBreak":true},{"text":"ஆம், எங்கள் கைகளின் வேலையை நிலைப்படுத்தும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/90.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/91.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/89.json","previousChapterAudioLinks":{},"numberOfVerses":17}