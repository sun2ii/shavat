{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":91,"content":[{"type":"verse","number":1,"content":[{"text":"மகா உன்னதமானவரின் அடைக்கலத்தில் வாழ்கிறவன்,","poem":1},{"text":"எல்லாம் வல்லவரின் நிழலில் இளைப்பாறுவான்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் யெகோவாவைக் குறித்து, “அவரே என் புகலிடம், என் கோட்டை,","poem":1},{"text":"நான் நம்பியிருக்கிற என் இறைவன்” என்று சொல்வேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"நிச்சயமாகவே அவர் உன்னை","poem":1},{"text":"வேடனுடைய கண்ணியிலிருந்தும்,","poem":2},{"lineBreak":true},{"text":"கொன்றழிக்கும் கொள்ளைநோயிலிருந்தும் தப்புவிப்பார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"யெகோவா தமது சிறகுகளால் உன்னை மூடுவார்;","poem":1},{"text":"அவருடைய சிறகுகளின் கீழே நீ புகலிடம் காண்பாய்;","poem":2},{"lineBreak":true},{"text":"அவருடைய சத்தியம் உனது கேடயமும் கவசமுமாயிருக்கும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நீ இரவின் பயங்கரத்திற்கும்,","poem":1},{"text":"பகலில் பறக்கும் அம்புக்கும் பயப்படாதிருப்பாய்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"இருளில் பின்தொடரும் கொள்ளைநோய்க்கும்,","poem":1},{"text":"நடுப்பகலில் பாழாக்கும் கொடிய வாதைக்கும் நீ பயப்படாதிருப்பாய்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உன் பக்கத்தில் ஆயிரம்பேரும்,","poem":1},{"text":"உன் வலதுபக்கத்தில் பத்தாயிரம்பேரும் வீழ்ந்தாலும்,","poem":2},{"lineBreak":true},{"text":"அது உன்னை நெருங்காது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"உன் கண்களால் மட்டுமே நீ அதைப் பார்த்து,","poem":1},{"text":"கொடியவர்களுக்கு வரும் தண்டனையைக் காண்பாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“யெகோவா எனக்குப் புகலிடம்” என்று நீ சொல்வாயானால்,","poem":1},{"text":"மகா உன்னதமானவரை உனது வாழ்விடமாகக் கொள்வாயானால்,","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அப்பொழுது ஒரு தீங்கும் உன்மேல் வராது;","poem":1},{"text":"கொள்ளைநோய் உன் கூடாரத்தை நெருங்காது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவர் உன் வழிகளிலெல்லாம் உன்னைக் காக்கும்படி,","poem":1},{"text":"உன்னைக்குறித்து தமது தூதர்களுக்குக் கட்டளையிடுவார்;","poem":2}]},{"type":"verse","number":12,"content":[{"text":"உன் பாதம் கல்லில் மோதாதபடி,","poem":1},{"text":"அவர்கள் உன்னைத் தங்கள் கரங்களில் தாங்கிக்கொள்வார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நீ சிங்கத்தின்மேலும் விரியன்பாம்பின்மேலும் நடப்பாய்;","poem":1},{"text":"இளஞ்சிங்கத்தையும் பாம்பையும் மிதிப்பாய்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"யெகோவா இப்படியாக சொல்கிறார்:","poem":1},{"text":"“அவன் என்னை நேசிக்கிறபடியால், நான் அவனை விடுவிப்பேன்;","poem":2},{"lineBreak":true},{"text":"அவன் என் பெயரை அறிந்திருக்கிறபடியால், நான் அவனைப் பாதுகாப்பேன்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவன் என்னை நோக்கிக் கூப்பிடுவான், நான் அவனுக்குப் பதில் கொடுப்பேன்;","poem":1},{"text":"துன்பத்தில் நான் அவனோடிருந்து,","poem":2},{"lineBreak":true},{"text":"அவனை விடுவித்து, அவனைக் கனப்படுத்துவேன்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"நீண்ட ஆயுளால் நான் அவனைத் திருப்தியாக்கி,","poem":1},{"text":"என் இரட்சிப்பை அவனுக்குக் காண்பிப்பேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/91.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/92.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/90.json","previousChapterAudioLinks":{},"numberOfVerses":16}