{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":92,"content":[{"type":"hebrew_subtitle","content":["ஓய்வுநாளுக்கான பாடலாகிய சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவைத் துதிப்பதும், உன்னதமானவரே,","poem":1},{"text":"உமது பெயரைப் புகழ்ந்து பாடுவதும் நல்லது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"காலையிலே உமது அன்பையும்","poem":1},{"text":"இரவிலே உமது உண்மையையும் அறிவிப்பது நல்லது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பத்து நரம்பு வீணையின் இசையினாலும்,","poem":1},{"text":"யாழின் ஓசையினாலும் அதை அறிவிப்பது நல்லது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"யெகோவாவே, நீர் உமது செயல்களினால் என்னை மகிழ்ச்சியாக்குகிறீர்;","poem":1},{"text":"உமது கைகளின் வேலைகளினிமித்தம் நான் மகிழ்ந்து பாடுகிறேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, உமது செயல்கள் எவ்வளவு பெரிதானவை,","poem":1},{"text":"உம்முடைய யோசனைகள் எவ்வளவு ஆழமானவை!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உணர்வற்ற மனிதன் அறியாததும்,","poem":1},{"text":"மூடர் விளங்கிக்கொள்ளாததும் இதுவே,","poem":2}]},{"type":"verse","number":7,"content":[{"text":"கொடியவர்கள் புல்லைப்போல் முளைத்தாலும்,","poem":1},{"text":"தீங்கு செய்கிறவர்கள் எல்லோரும் செழித்தாலும்,","poem":2},{"lineBreak":true},{"text":"என்றென்றைக்கும் அழிந்துபோவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"ஆனாலும் யெகோவாவே, நீர் என்றென்றுமாய் புகழ்ந்து உயர்த்தப்படுகிறீர்.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, உமது பகைவர்,","poem":1},{"text":"நிச்சயமாகவே உம்முடைய பகைவர் அழிந்தேபோவார்கள்;","poem":2},{"lineBreak":true},{"text":"தீமை செய்வோர் எல்லோருமே சிதறடிக்கப்படுவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"காட்டெருதின் பெலத்தைப்போல் நீர் என் பெலத்தை உயர்த்துவீர்;","poem":1},{"text":"சிறந்த எண்ணெய் என்மேல் ஊற்றப்பட்டன.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் விரோதிகளின் தோல்வியைக் கண்ணாரக் கண்டேன்;","poem":1},{"text":"என் செவிகள் என் கொடிய எதிரிகள் முறியடிக்கப்படுவதைக் காதாரக் கேட்டேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"நீதிமான்கள் பனைமரத்தைப்போல் செழிப்பார்கள்,","poem":1},{"text":"அவர்கள் லெபனோனின் கேதுரு மரம்போல் வளர்வார்கள்;","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்கள் யெகோவாவினுடைய வீட்டிலே நாட்டப்பட்டு,","poem":1},{"text":"நமது இறைவனுடைய ஆலய முற்றங்களில் செழிப்பார்கள்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவர்கள் செழுமையும் பசுமையுமாயிருந்து,","poem":1},{"text":"தங்கள் முதிர்வயதிலும் கனி கொடுப்பார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“யெகோவா நீதியுள்ளவர்; அவரே என் கன்மலை;","poem":1},{"text":"அவரிடத்தில் அநீதி இல்லை” என்று அவர்கள் பிரசித்தப்படுத்துவார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/92.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/93.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/91.json","previousChapterAudioLinks":{},"numberOfVerses":15}