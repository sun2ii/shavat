{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":93,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா ஆட்சி செய்கிறார், அவர் மாட்சிமையை அணிந்திருக்கிறார்;","poem":1},{"text":"யெகோவா மாட்சிமையை அணிந்து பெலத்தைத் தரித்துக்கொண்டிருக்கிறார்;","poem":2},{"lineBreak":true},{"text":"உண்மையில், உலகம் நிலைபெற்று உறுதியாகவும் பாதுகாப்பாகவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உமது சிங்காசனம் பூர்வகாலத்திலே ஏற்படுத்தப்பட்டது;","poem":1},{"text":"நீர் நித்தியத்தில் இருந்தே இருக்கிறீர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே, கடல்கள் எழும்பின;","poem":1},{"text":"கடல்கள் தங்கள் குரலை எழுப்பின;","poem":2},{"lineBreak":true},{"text":"கடல்கள் மோதியடிக்கும் தங்கள் அலைகளை எழுப்பின.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பெருவெள்ளத்தின் முழக்கத்தைப் பார்க்கிலும்,","poem":1},{"text":"கடல்களின் அலைகளைப் பார்க்கிலும்","poem":2},{"lineBreak":true},{"text":"உன்னதத்தில் இருக்கும் யெகோவா வல்லமையுள்ளவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, உமது நியமங்கள் உறுதியாய் நிற்கின்றன;","poem":1},{"text":"பரிசுத்தம் உமது ஆலயத்தை","poem":2},{"lineBreak":true},{"text":"என்றென்றும் அலங்கரிக்கிறது.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}