{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":94,"content":[{"type":"verse","number":1,"content":[{"text":"அநீதிக்கு பழிவாங்குகிற இறைவனாகிய யெகோவாவே,","poem":1},{"text":"அநீதிக்கு பழிவாங்குகிற இறைவனே, பிரகாசியும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"பூமியின் நீதிபதியே, எழுந்தருளும்;","poem":1},{"text":"பெருமை உள்ளவர்களுக்குத் தக்கபடி பதிலளியும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"எவ்வளவு காலத்திற்கு யெகோவாவே, கொடியவர்கள்,","poem":1},{"text":"எவ்வளவு காலத்திற்கு கொடியவர்கள் களிகூர்ந்திருப்பார்கள்?","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அவர்கள் அகங்காரமான வார்த்தைகளைப் பேசுகிறார்கள்;","poem":1},{"text":"தீமை செய்வோர் யாவரும் பெருமை நிறைந்து பேசுகிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவாவே, அவர்கள் உமது மக்களை தாக்குகிறார்கள்;","poem":1},{"text":"உமது உரிமைச்சொத்தை ஒடுக்குகிறார்கள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"விதவைகளையும் வேறுநாட்டைச் சேர்ந்தவரையும் அவர்கள் அழிக்கிறார்கள்;","poem":1},{"text":"அவர்கள் தந்தையற்றவர்களைக் கொலைசெய்கிறார்கள்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"“யெகோவா இவற்றைக் காண்பதில்லை,","poem":1},{"text":"யாக்கோபின் இறைவன் இவற்றைக் கவனிப்பதில்லை” என்று சொல்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"மக்கள் மத்தியில் அறிவற்றவர்களாய் இருப்பவர்களே, கவனமாயிருங்கள்;","poem":1},{"text":"மூடரே, நீங்கள் எப்பொழுது அறிவு பெறுவீர்கள்?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"காதைப் படைத்தவர் கேட்கமாட்டாரோ?","poem":1},{"text":"கண்ணை உருவாக்கியவர் பார்க்கமாட்டாரோ?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"மக்களைத் தண்டிக்கிறவர் உங்களையும் தண்டிக்கமாட்டாரோ?","poem":1},{"text":"மனிதருக்குப் போதிக்கிறவர் அறிவில் குறைந்தவரோ?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"மனிதரின் சிந்தனைகளை யெகோவா அறிந்திருக்கிறார்;","poem":1},{"text":"அவை பயனற்றவை என்பதையும் அவர் அறிவார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"யெகோவாவே, நீர் தண்டித்து,","poem":1},{"text":"உமது சட்டத்திலிருந்து போதிக்கிற நபர் ஆசீர்வதிக்கப்பட்டவர்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"கொடியவர்களுக்கோ குழிவெட்டப்படும் வரை","poem":1},{"text":"கஷ்ட நாட்களிலிருந்து அவர்களுக்கு நீர் விடுதலை வழங்குகிறீர்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"ஏனெனில் யெகோவா தமது மக்களைப் புறக்கணிக்கமாட்டார்;","poem":1},{"text":"தமது உரிமைச்சொத்தை ஒருபோதும் கைவிடமாட்டார்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீதியின்மேல் நியாயத்தீர்ப்பு திரும்பவும் கட்டப்படும்;","poem":1},{"text":"அதை இருதயத்தில் நேர்மையுள்ளோர் அனைவரும் பின்பற்றுவார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"எனக்காக கொடியவனுக்கு விரோதமாய் எழும்புகிறவன் யார்?","poem":1},{"text":"தீமை செய்வோருக்கு எதிராய் எனக்குத் துணைநிற்பவன் யார்?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"யெகோவா எனக்கு உதவி செய்திருக்காவிட்டால்,","poem":1},{"text":"நான் சீக்கிரமாய் மரணத்தின் மவுனத்தில் குடிகொண்டிருந்திருப்பேன்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"“என் கால் சறுக்குகிறது” என்று நான் சொன்னபோது,","poem":1},{"text":"யெகோவாவே உமது உடன்படிக்கையின் அன்பே என்னைத் தாங்கியது.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"கவலை எனக்குள் பெரிதாய் இருக்கையில்,","poem":1},{"text":"உமது ஆறுதல் என் ஆத்துமாவுக்கு மகிழ்வைத் தந்தது.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"தான் பிறப்பிக்கும் விதிமுறைகளினாலேயே துன்பத்தைக் கொண்டுவரும்,","poem":1},{"text":"ஊழல் நிறைந்த ஆட்சியாளர்கள் உமக்கு கூட்டாளிகளாயிருக்க முடியுமோ?","poem":2}]},{"type":"verse","number":21,"content":[{"text":"அந்தக் கொடியவர்கள் நீதிமான்களுக்கு விரோதமாகக் கூட்டங்கூடி,","poem":1},{"text":"குற்றமற்றவர்களுக்கு மரணத்தீர்ப்பு அளிக்கிறார்கள்.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"ஆனால் யெகோவாவோ என் கோட்டையும்,","poem":1},{"text":"நான் தஞ்சமடையும் கன்மலையான என் இறைவனுமானார்.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"அவர் அவர்களுடைய பாவங்களுக்காகப் பதில்செய்து,","poem":1},{"text":"அவர்கள் கொடுமைகளினிமித்தம் அவர்களை தண்டிப்பார்;","poem":2},{"lineBreak":true},{"text":"எங்கள் இறைவனாகிய யெகோவா அவர்களை தண்டிப்பார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/94.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/95.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/93.json","previousChapterAudioLinks":{},"numberOfVerses":23}