{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":95,"content":[{"type":"verse","number":1,"content":[{"text":"வாருங்கள், யெகோவாவை மகிழ்ச்சியோடு பாடுவோம்;","poem":1},{"text":"நம்முடைய இரட்சிப்பின் கன்மலையை சத்தமிட்டுத் துதிப்போம்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நன்றியுடன் அவர்முன் வருவோம்;","poem":1},{"text":"இசையினாலும் பாட்டினாலும் அவரைப் புகழ்ந்து உயர்த்துவோம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"யெகோவாவே மகா இறைவனாய் இருக்கிறார்;","poem":1},{"text":"எல்லாத் தெய்வங்களுக்கும் மேலான மகா அரசருமாய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"பூமியின் ஆழங்கள் அவருடைய கரத்தில் இருக்கின்றன;","poem":1},{"text":"மலை உச்சிகளும் அவருக்கே உரியவை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கடல் அவருடையது, அவரே அதை உண்டாக்கினார்;","poem":1},{"text":"வறண்ட நிலத்தையும் அவருடைய கரங்களே உருவாக்கின.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"வாருங்கள், நம்மை உண்டாக்கின யெகோவாவுக்கு முன்பாக","poem":1},{"text":"நாம் குனிந்து, பணிந்து, வழிபடுவோம்;","poem":2},{"lineBreak":true},{"text":"நாம் முழங்காலிடுவோம்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவரே நம் இறைவன்;","poem":1},{"text":"நாம் அவருடைய மேய்ச்சலின் மக்களும்","poem":2},{"lineBreak":true},{"text":"அவருடைய பராமரிப்புக்குள்ளான மந்தையுமாய் இருக்கிறோம்.","poem":2},{"lineBreak":true},{"text":"இன்று நீங்கள் அவருடைய குரலைக் கேட்பீர்களானால்,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"“அன்று மேரிபாவில் விவாதம் செய்தது போலவும்,","poem":1},{"text":"பாலைவனத்திலே மாசாவில் சோதனை செய்தது போலவும்,","poem":2},{"lineBreak":true},{"text":"உங்கள் இருதயங்களைக் கடினப்படுத்த வேண்டாம்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அங்கே உங்கள் முன்னோர்கள் என்னைச் சோதித்தார்கள்;","poem":1},{"text":"நான் செய்தவைகளைக் கண்டிருந்தும் என்னைப் பரீட்சை பார்த்தார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் நாற்பது வருடங்களாக அந்தச் சந்ததியோடு கோபமாயிருந்தேன்;","poem":1},{"text":"‘அவர்கள் என்னைவிட்டு விலகிப்போகும் இருதயமுள்ள மக்கள் என்றும்,","poem":2},{"lineBreak":true},{"text":"என்னுடைய வழிகளை அறியாதவர்கள்’ என்றும் நான் சொன்னேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எனவே கோபங்கொண்டு,","poem":1},{"text":"‘அவர்கள் என்னுடைய இளைப்பாறுதலுக்குள் பிரவேசிப்பதில்லை’ என்று,","poem":2},{"lineBreak":true},{"text":"ஆணையிட்டு அறிவித்தேன்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}