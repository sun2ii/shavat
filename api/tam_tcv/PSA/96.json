{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":96,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்குப் புதுப்பாட்டைப் பாடுங்கள்;","poem":1},{"text":"பூமியில் உள்ளவர்களே, எல்லோரும் யெகோவாவுக்குத் துதி பாடுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவாவுக்குத் துதி பாடுங்கள், அவர் பெயரைத் துதியுங்கள்,","poem":1},{"text":"நாள்தோறும் அவருடைய இரட்சிப்பை அறிவியுங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நாடுகளுக்குள்ளே அவரது மகிமையையும்,","poem":1},{"text":"மக்கள் எல்லோருக்கும் அவரது அற்புத செயல்களையும் அறிவியுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"ஏனெனில் யெகோவா மேன்மையானவர், அவரே மிகவும் துதிக்கப்படத்தக்கவர்;","poem":1},{"text":"எல்லா தெய்வங்களுக்கும் மேலாக பயப்படத்தக்கவர் அவரே.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நாடுகளின் தெய்வங்கள் எல்லாம் விக்கிரகங்களாகவே இருக்கின்றன;","poem":1},{"text":"ஆனால் யெகோவாவே வானங்களை உண்டாக்கினார்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மாட்சிமையும் மகத்துவமும் அவருக்கு முன்பாக இருக்கின்றன;","poem":1},{"text":"வல்லமையும் மகிமையும் அவருடைய பரிசுத்த இடத்தில் இருக்கின்றன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"நாடுகளின் குடும்பங்களே, மகிமையையும் வல்லமையையும்","poem":1},{"text":"யெகோவாவுக்கு செலுத்துங்கள்;","poem":2},{"lineBreak":true},{"text":"யெகோவாவுக்கே அதைச் செலுத்துங்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"யெகோவாவின் பெயருக்குரிய மகிமையை அவருக்குச் செலுத்துங்கள்;","poem":1},{"text":"காணிக்கையை எடுத்துக்கொண்டு அவருடைய ஆலய முற்றத்திற்கு வாருங்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவருடைய பரிசுத்தத்தின் மகிமையிலே யெகோவாவை வழிபடுங்கள்;","poem":1},{"text":"பூமியில் உள்ள யாவரும் அவருக்குமுன் நடுங்குங்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"“யெகோவா ஆளுகிறார்” என்று நாடுகளின் மத்தியில் சொல்லுங்கள்;","poem":1},{"text":"உலகம் உறுதியாய் நிலைநிறுத்தப்பட்டுள்ளது, அது அசையாது;","poem":2},{"lineBreak":true},{"text":"அவர் நாடுகளை நீதியாய் நியாயந்தீர்ப்பார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"வானங்கள் மகிழட்டும், பூமி களிகூரட்டும்;","poem":1},{"text":"கடலும் அதிலுள்ள அனைத்தும் சத்தமிடட்டும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"வயல்வெளிகளும் அவைகளிலுள்ள அனைத்தும் பூரிப்படையட்டும்;","poem":1},{"text":"அப்பொழுது காட்டு மரங்கள் அனைத்தும் மகிழ்ச்சியாய்ப் பாடட்டும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"யெகோவா வருகிறார், அதினால் அவருக்கு முன்பாக","poem":1},{"text":"அனைத்துப் படைப்புகளும் மகிழ்ச்சியுடன் பாடட்டும்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் அவர் பூமியை நியாயந்தீர்க்க வருகிறார்;","poem":2},{"text":"அவர் உலகத்தை நீதியுடனும்","poem":1},{"text":"மக்களை அவருடைய சத்தியத்தின்படியும் நியாயந்தீர்ப்பார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/96.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/97.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/95.json","previousChapterAudioLinks":{},"numberOfVerses":13}