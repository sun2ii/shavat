{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":97,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா ஆட்சி செய்கிறார், பூமி களிகூரட்டும்;","poem":1},{"text":"தொலைவில் உள்ள தீவுகள் மகிழட்டும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"மேகங்களும் காரிருளும் அவரைச் சூழ்கின்றன;","poem":1},{"text":"நேர்மையுடனும் நீதியுடனும் அவர் ஆளுகை செய்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நெருப்பு அவருக்கு முன்சென்று,","poem":1},{"text":"சுற்றிலுமுள்ள அவருடைய எதிரிகளைச் சுட்டெரிக்கின்றது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவருடைய மின்னல் உலகத்துக்கு வெளிச்சம் கொடுக்கிறது;","poem":1},{"text":"பூமி அதைக்கண்டு நடுங்குகிறது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யெகோவாவுக்கு முன்பாக, பூமியனைத்திற்கும் ஆண்டவராகிய யெகோவாவுக்கு முன்பாகவே","poem":1},{"text":"மலைகள் மெழுகுபோல் உருகுகின்றன.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வானங்கள் அவருடைய நீதியை அறிவிக்கிறது;","poem":1},{"text":"எல்லா நாடுகளும் அவருடைய மகிமையைக் காண்கிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"உருவச்சிலைகளை வணங்குகிற அனைவரும்,","poem":1},{"text":"விக்கிரகங்களைப்பற்றிப் பெருமைபாராட்டுகிற அனைவரும் வெட்கப்பட்டுப் போவார்கள்;","poem":2},{"lineBreak":true},{"text":"தெய்வங்களே, நீங்களெல்லோரும் யெகோவாவையே வழிபடுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவே, உமது நியாயத்தீர்ப்புகளினால்","poem":1},{"text":"சீயோன் கேட்டுக் களிகூருகிறது;","poem":2},{"lineBreak":true},{"text":"யூதாவின் கிராமங்களும் மகிழ்கின்றன.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"யெகோவாவே, நீரோ பூமியெங்கும் மகா உன்னதமானவராய் இருக்கிறீர்;","poem":1},{"text":"எல்லாத் தெய்வங்களுக்கும் மேலாக நீரே உயர்த்தப்பட்டிருக்கிறீர்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"யெகோவாவை நேசிக்கிறவர்கள் தீமையை வெறுக்கட்டும்;","poem":1},{"text":"ஏனெனில் அவர் தமக்கு உண்மையுள்ளோரின் உயிர்களைக் காப்பாற்றி,","poem":2},{"lineBreak":true},{"text":"கொடியவர்களின் கைகளிலிருந்து அவர்களை விடுவிக்கிறார்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நீதிமான்கள்மேல் வெளிச்சம் பிரகாசிக்கிறது,","poem":1},{"text":"இருதயத்தில் நீதி உள்ளவர்களுக்குக் களிப்புண்டாகிறது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நீதிமான்களே, யெகோவாவிடம் களிகூருங்கள்,","poem":1},{"text":"அவருடைய பரிசுத்தத்தை நினைத்துத் துதியுங்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}