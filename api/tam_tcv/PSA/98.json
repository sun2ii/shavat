{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":98,"content":[{"type":"hebrew_subtitle","content":["சங்கீதம்."]},{"type":"verse","number":1,"content":[{"text":"யெகோவாவுக்குப் புதுப்பாட்டைப் பாடுங்கள்;","poem":1},{"text":"ஏனெனில் அவர் அற்புதமான காரியங்களைச் செய்திருக்கிறார்;","poem":2},{"text":"அவருடைய வலதுகரமும், அவருடைய பரிசுத்த புயமுமே","poem":1},{"text":"இரட்சிப்பைக் கொடுத்திருக்கிறது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"யெகோவா தமது இரட்சிப்பைத் தெரியப்படுத்தி,","poem":1},{"text":"தமது நீதியைப் பிறநாடுகளின் கண்முன்னே வெளிப்படுத்தினார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவர் இஸ்ரயேல் குடும்பத்தாரிடம் கொண்டிருந்த","poem":1},{"text":"தமது அன்பையும் உண்மையையும் நினைவில்கொண்டார்;","poem":2},{"text":"பூமியின் எல்லைகள் எல்லாம்","poem":1},{"text":"நமது இறைவனுடைய இரட்சிப்பைக் கண்டன.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"பூமியிலுள்ளவர்களே, நீங்கள் எல்லோரும்","poem":1},{"text":"யெகோவாவை மகிழ்ச்சியுடன் ஆர்ப்பரியுங்கள்;","poem":2},{"lineBreak":true},{"text":"முழக்கமிட்டு களிப்புடன் இசையோடு பாடுங்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யாழோடு யெகோவாவுக்கு இசை பாடுங்கள்;","poem":1},{"text":"யாழோடும், கீதசத்தத்தோடும்,","poem":2}]},{"type":"verse","number":6,"content":[{"text":"எக்காளங்களோடும், கொம்பு வாத்திய முழக்கங்களோடும்","poem":1},{"text":"யெகோவாவாகிய அரசரின்முன் மகிழ்ந்து பாடுங்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"கடலும் அதிலுள்ள அனைத்தும்,","poem":1},{"text":"உலகமும் அதிலுள்ள அனைவரும் ஆர்ப்பரிப்பார்களாக.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆறுகள் தங்கள் கைகளைத் தட்டட்டும்;","poem":1},{"text":"மலைகள் மகிழ்ச்சியுடன் ஒன்றுசேர்ந்து பாடட்டும்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவை யெகோவாவுக்கு முன்பாகப் பாடட்டும்;","poem":1},{"text":"ஏனெனில், அவர் பூமியை நியாயந்தீர்க்க வருகிறார்;","poem":2},{"text":"அவர் உலகத்தை நீதியுடனும்,","poem":1},{"text":"நாடுகளை நேர்மையுடனும் நியாயந்தீர்ப்பார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}