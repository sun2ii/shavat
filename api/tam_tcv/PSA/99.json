{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"PSA","translationId":"tam_tcv","name":"சங்கீதம்","commonName":"சங்கீதம்","title":"சங்கீதம்","order":19,"numberOfChapters":150,"sha256":"44e87bf385fb420daad05af3e5ebd53a8cfc4d291499f17563ef5d2c586e1366","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tam_tcv/PSA/150.json","totalNumberOfVerses":2460},"chapter":{"number":99,"content":[{"type":"verse","number":1,"content":[{"text":"யெகோவா ஆட்சி செய்கிறார்,","poem":1},{"text":"நாடுகள் நடுங்கட்டும்;","poem":2},{"text":"அவர் கேருபீன்களின் நடுவில் சிங்காசனத்தில் அமர்ந்திருக்கிறார்;","poem":1},{"text":"பூமி அதிரட்டும்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"சீயோனிலே யெகோவா பெரியவர்;","poem":1},{"text":"அவர் எல்லா நாடுகளுக்கும் மேலாக புகழ்ந்து உயர்த்தப்பட்டிருக்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"பெரியதும் பிரமிக்கத்தக்கதுமான உமது பெயரை அவர்கள் துதிக்கட்டும்;","poem":1},{"text":"அவர் பரிசுத்தமானவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"அரசர் வல்லமையுள்ளவர், அவர் நீதியை விரும்புகிறார்;","poem":1},{"text":"நீர் நியாயத்தை நிலைநாட்டியிருக்கிறீர்;","poem":2},{"text":"நீர் யாக்கோபில்","poem":1},{"text":"நீதியையும் நேர்மையானதையும் செய்திருக்கிறீர்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நம் இறைவனாகிய யெகோவாவைப் புகழ்ந்துயர்த்தி,","poem":1},{"text":"அவருடைய பாதபடியிலே வழிபடுங்கள்;","poem":2},{"lineBreak":true},{"text":"அவர் பரிசுத்தமானவர்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"அவருடைய ஆசாரியருள் மோசேயும் ஆரோனும் இருந்தார்கள்;","poem":1},{"text":"அவருடைய பெயரைச் சொல்லி வழிபடுகிறவர்களில் சாமுயேலும் இருந்தான்;","poem":2},{"text":"அவர்கள் யெகோவாவை நோக்கிக் கூப்பிட்டார்கள்;","poem":1},{"text":"அவர் அவர்களுக்குப் பதிலளித்தார்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அவர் மேகத்தூணிலிருந்து அவர்களோடு பேசினார்;","poem":1},{"text":"அவர் அவர்களுக்குக் கொடுத்த","poem":2},{"lineBreak":true},{"text":"அவருடைய நியமங்களையும் விதிமுறைகளையும் கைக்கொண்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"எங்கள் இறைவனாகிய யெகோவாவே,","poem":1},{"text":"நீர் அவர்களுடைய வேண்டுதலுக்குப் பதிலளித்தீர்;","poem":2},{"text":"இஸ்ரயேலருடைய தீயசெயல்களுக்காக நீர் அவர்களைத் தண்டித்த போதிலும்,","poem":1},{"text":"நீர் அவர்களுக்கு மன்னிக்கிற இறைவனாகவே இருந்தீர்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"நமது இறைவனாகிய யெகோவாவைப் புகழ்ந்து உயர்த்தி","poem":1},{"text":"அவருடைய பரிசுத்த மலையில் வழிபடுங்கள்;","poem":2},{"lineBreak":true},{"text":"ஏனெனில் நம் இறைவனாகிய யெகோவா பரிசுத்தமானவர்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}