{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_tcv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"3016b99ddc546c26e0a93d4330a6cfb3e2183ac6e3dafea3688c93c1256afe8c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_tcv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["சாலொமோனின் உன்னதப்பாட்டு."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"அவர் தமது வாயின் முத்தங்களினால் என்னை முத்தமிடுவாராக;","poem":1},{"text":"ஏனெனில் உமது அன்பு திராட்சை இரசத்தைப் பார்க்கிலும் அதிக இன்பமாயிருக்கிறது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உமது வாசனைத் தைலங்களின் நறுமணம் இன்பம் தருகிறது;","poem":1},{"text":"உமது பெயர் ஊற்றுண்ட வாசனைத் தைலம்போல் இருக்கிறது.","poem":2},{"lineBreak":true},{"text":"கன்னியர் உம்மைக் காதலிப்பதில் ஆச்சரியம் இல்லையே!","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என்னை உம்முடன் கூட்டிச்செல்லும்; நாம் விரைவாய் போய்விடுவோம்.","poem":1},{"text":"அரசன் தமது அறைக்குள் என்னைக் கொண்டுவரட்டும்.","poem":2},"தோழியர்",{"text":"நாங்கள் உம்மில் மகிழ்ந்து களிப்படைகிறோம்;","poem":1},{"text":"திராட்சை இரசத்தைப் பார்க்கிலும் உமது அன்பையே புகழ்வோம்.","poem":2},"காதலி",{"text":"அவர்கள் உம்மீது காதல்கொள்வது எவ்வளவு சரியானது!","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"எருசலேமின் மங்கையரே,","poem":1},{"text":"நான்","poem":2},{"noteId":0},{"text":"கேதாரின் கூடாரங்களைப் போலவும்,","poem":2},{"text":"சாலொமோனின்","poem":1},{"noteId":1},{"text":"திரைகளைப்போலவும்","poem":1},{"text":"கருப்பாய் இருந்தாலும் அழகாகவே இருக்கிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் கருப்பாய் இருக்கிறேன் என்று பார்க்கவேண்டாம்;","poem":1},{"text":"வெயில் பட்டதினாலே நான் கருப்பாய் இருக்கிறேன்.","poem":2},{"text":"என் சகோதரர்கள்","poem":1},{"noteId":2},{"text":"என்மேல் கோபங்கொண்டு,","poem":1},{"text":"திராட்சைத் தோட்டங்களைப் பராமரிக்க என்னை வைத்தார்கள்;","poem":2},{"lineBreak":true},{"text":"அதினால் என் சொந்தத் திராட்சைத் தோட்டத்தை","poem":2},{"noteId":3},{"text":"என்னால் கவனிக்க முடியாமல் போய்விட்டது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் காதலரே, உமது மந்தைகளை எங்கே மேய்க்கிறீர்?","poem":1},{"text":"மத்தியான வேளையிலே உமது செம்மறியாடுகளை எங்கே இளைப்பாறப் பண்ணுகிறீர்?","poem":2},{"lineBreak":true},{"text":"அதை எனக்குச் சொல்லும்.","poem":2},{"text":"முகத்திரையிட்ட பெண்போல்","poem":1},{"noteId":4},{"text":",","poem":1},{"text":"ஏன் நான் உமது தோழர்களின் மந்தைகளுக்கிடையில் இருக்கவேண்டும்?","poem":2}]},{"type":"verse","number":8,"content":[{"text":"பெண்களுள் பேரழகியே, அதை நீ அறியாவிட்டால்,","poem":1},{"text":"செம்மறியாட்டின் அடிச்சுவடுகளைப் பின்தொடர்ந்து போய்,","poem":2},{"text":"மேய்ப்பர்களின் கூடாரங்களுக்கு அருகில்","poem":1},{"text":"உன் வெள்ளாட்டுக் குட்டிகளை மேயவிடு.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"என் அன்பே, நான் உன்னைப்","poem":1},{"text":"பார்வோனின் தேர்களில் பூட்டப்பட்ட பெண் குதிரைக்கு ஒப்பிடுகிறேன்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"காதணிகள் தொங்கும் உன் கன்னங்களும்,","poem":1},{"text":"நகைகள் அணிந்த உன் கழுத்தும் அழகானவை.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"நாங்கள் உனக்கு வெள்ளிப் பதிக்கப்பட்ட","poem":1},{"text":"தங்கக் காதணிகளைச் செய்வோம்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அரசர் தமது பந்தியில்","poem":1},{"noteId":5},{"text":"இருக்கையிலே","poem":1},{"text":"எனது வாசனைத் தைலம் நறுமணம் வீசியது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"என் காதலர் எனக்கு என் மார்பகங்களுக்கிடையில் இருக்கும்","poem":1},{"text":"வெள்ளைப்போள முடிச்சாய் இருக்கிறார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"என் காதலர் எனக்கு என்கேதி","poem":1},{"noteId":6},{"text":"ஊர் திராட்சைத் தோட்டங்களில் உள்ள,","poem":1},{"text":"மருதாணி பூங்கொத்து போன்றவர்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"என் அன்பே, நீ எவ்வளவு அழகானவள்!","poem":1},{"text":"ஆ, நீ எவ்வளவு அழகானவள்!","poem":2},{"lineBreak":true},{"text":"உன் கண்கள் புறாக்கண்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"என் காதலரே, நீர் எவ்வளவு அழகானவர்!","poem":1},{"text":"ஆ, எவ்வளவு கவர்ச்சி!","poem":2},{"lineBreak":true},{"text":"நமது படுக்கை பசுமையானது.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"நம் வீட்டின் விட்டங்கள் கேதுரு மரத்தாலானவை,","poem":1},{"text":"நம்முடைய மச்சு தேவதாரு மரத்தாலானவை.","poem":2}]}],"footnotes":[{"noteId":0,"caller":"+","text":"அரேபியாவுடன் தொடர்புடைய இஸ்மயேல் பழங்குடியினரில் கேதரும் ஒருவர். இவர்கள் பொதுவாக கருப்பு கூடாரங்களில் வாழ்ந்தனர். இது இளம்பெண்ணின் கருப்பு தோலைக் குறிக்கிறது","reference":{"chapter":1,"verse":5}},{"noteId":1,"caller":"+","text":"சாலொமோனின் அல்லது சல்மா.","reference":{"chapter":1,"verse":5}},{"noteId":2,"caller":"+","text":"சகோதரர்கள் அல்லது என் தாயின் மகன்கள்.","reference":{"chapter":1,"verse":6}},{"noteId":3,"caller":"+","text":"திராட்சைத் தோட்டம் இளம்பெண்ணைக் குறிக்கிறது. இந்த உருவகம் அவளது உடல் தோற்றத்தை கவனித்துக்கொள்வதற்கான அவளது திறனைக் குறிக்கிறது.","reference":{"chapter":1,"verse":6}},{"noteId":4,"caller":"+","text":"முகத்திரையிட்ட பெண்போல் அல்லது அலைந்து திரிகிறவள் எனப்படும்.","reference":{"chapter":1,"verse":7}},{"noteId":5,"caller":"+","text":"பந்தியில் அல்லது படுக்கையில்.","reference":{"chapter":1,"verse":12}},{"noteId":6,"caller":"+","text":"என்கேதி என்பது சவக்கடலின் தென்மேற்கு கரையில் ஒரு சோலை; இது ஒரு புத்துணர்ச்சியூட்டும் மற்றும் வளமான இடமாக அறியப்படுகிறது, ஏனெனில் இது ஒரு நீரூற்று மூலம் பாய்கிறது","reference":{"chapter":1,"verse":14}}]},"thisChapterLink":"/api/tam_tcv/SNG/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/SNG/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ECC/12.json","previousChapterAudioLinks":{},"numberOfVerses":17}