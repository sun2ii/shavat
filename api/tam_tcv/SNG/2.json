{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_tcv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"3016b99ddc546c26e0a93d4330a6cfb3e2183ac6e3dafea3688c93c1256afe8c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_tcv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":[{"text":"நான்","poem":1},{"noteId":7},{"text":"சாரோனின் ரோஜாவும்","poem":1},{"noteId":8},{"text":",","poem":1},{"text":"பள்ளத்தாக்குகளின் லில்லிப் பூவுமாய் இருக்கிறேன்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"முட்களுக்கிடையில் லில்லிப் பூவைப்போல்","poem":1},{"text":"கன்னியர் நடுவில் என் காதலியும் இருக்கிறாள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"காட்டு மரங்கள் நடுவில் ஆப்பிள் மரத்தைப்போல்,","poem":1},{"text":"வாலிபர்களுக்குள் என் காதலரும் இருக்கிறார்.","poem":2},{"text":"அவருடைய நிழலில் நான் மகிழ்ந்திருந்தேன்,","poem":1},{"text":"அவருடைய கனி எனக்கு மிகவும் இனிமையாயிருந்தது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர் என்னை விருந்து மண்டபத்திற்கு அழைத்துச் சென்றார்;","poem":1},{"text":"என்மேல் அவருடைய அன்பு, கொடியாகப் பறந்தது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உலர்ந்த திராட்சையினால் என்னைப் பெலப்படுத்துங்கள்,","poem":1},{"text":"ஆப்பிள் பழங்களினால் எனக்குப் புத்துயிர் கொடுங்கள்,","poem":2},{"lineBreak":true},{"text":"ஏனெனில் நான் காதலால் பலவீனமடைந்திருக்கிறேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"அவருடைய இடதுகை என் தலையின்கீழ் இருக்கிறது,","poem":1},{"text":"அவருடைய வலதுகை என்னை அணைத்துக்கொள்கிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எருசலேமின் மங்கையரே,","poem":1},{"text":"கலைமான்கள்மேலும் வெளியின் பெண்மான்கள்மேலும் ஆணை!","poem":2},{"text":"காதலைத் தட்டி எழுப்பவேண்டாம்,","poem":1},{"text":"அது தானே விரும்பும்வரை எழுப்பவேண்டாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"கேளுங்கள்! இதோ, என் காதலரின் குரல் கேட்கிறது!","poem":1},{"text":"இதோ, என் காதலர் வந்துவிட்டார்!","poem":2},{"text":"மலைகளைத் தாண்டியும்,","poem":1},{"text":"குன்றுகள்மேல் தாவியும் வருகிறார்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"என் காதலர் வெளிமானுக்கும், மரைக்குட்டிக்கும் ஒப்பாயிருக்கிறார்.","poem":1},{"text":"இதோ, அவர் எங்கள் மதிலுக்குப் பின்னே நிற்கிறார்,","poem":2},{"text":"ஜன்னல்களின் வழியாய்ப் பார்க்கிறார்,","poem":1},{"text":"கிராதியின் வழியாய் எட்டிப் பார்க்கிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என் காதலர் என்னோடு பேசி,","poem":1},{"text":"“என் அன்பே, எழுந்திரு,","poem":2},{"lineBreak":true},{"text":"என் அழகே, என்னோடு வா.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"இதோ பார், குளிர்க்காலம் முடிந்துவிட்டது;","poem":1},{"text":"மழையும் பெய்து ஓய்ந்துவிட்டது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"பூமியில் பூக்கள் பூக்கத் தொடங்கிவிட்டன;","poem":1},{"text":"பறவைகள் பாடும் பருவம் வந்துவிட்டது,","poem":2},{"text":"காட்டுப்புறா கூவும்","poem":1},{"text":"சத்தமும் நம் நாட்டில் கேட்கிறது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அத்திமரத்தில் பழங்கள் பழுத்திருக்கின்றன;","poem":1},{"text":"திராட்சைக்கொடிகள் பூத்து நறுமணம் வீசுகின்றன.","poem":2},{"text":"என் அன்பே, எழுந்து வா;","poem":1},{"text":"என் அழகே, என்னோடு வா” என்று சொல்கிறார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"பாறைப் பிளவுகளில் மறைந்திருப்பவளே,","poem":1},{"text":"கற்பாறை வெடிப்புகளில் தங்கும் என் புறாவே,","poem":2},{"text":"உன் முகத்தை எனக்குக் காட்டு,","poem":1},{"text":"உனது குரலை நான் கேட்கட்டும்;","poem":2},{"text":"உன் குரல் இனிமையானது,","poem":1},{"text":"உன் முகம் அழகானது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நம்முடைய திராட்சைத் தோட்டங்கள்","poem":1},{"text":"பூத்திருக்கின்றன,","poem":2},{"text":"அவற்றைப் பாழாக்குகின்ற நரிகளையும்","poem":1},{"text":"குள்ளநரிகளையும்","poem":2},{"noteId":9},{"text":"நமக்காகப் பிடியுங்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"என் காதலர் என்னுடையவர், நான் அவருடையவள்;","poem":1},{"text":"அவர் லில்லிப் பூக்களுக்கிடையில் தன் மந்தையை மேய்க்கிறார்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"என் காதலரே, பொழுது விடிவதற்குள்,","poem":1},{"text":"நிழல்கள் மறைவதற்குள்","poem":2},{"text":"திரும்பி வாரும்,","poem":1},{"text":"குன்றுகளில் உள்ள மானைப்போலவும்,","poem":2},{"text":"மரைக்குட்டியைப் போலவும்","poem":1},{"text":"திரும்பி வாரும்.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":7,"caller":"+","text":"சாரோன் சமவெளி என்பது பாலஸ்தீனத்தின் கடலோர சமவெளியில் உள்ள ஒரு பகுதி.","reference":{"chapter":2,"verse":1}},{"noteId":8,"caller":"+","text":"ரோஜாவும் அல்லது குங்குமப்பூவின் குடும்பத்தைச் சேர்ந்தது.","reference":{"chapter":2,"verse":1}},{"noteId":9,"caller":"+","text":"குள்ளநரிகளையும் என்பது இளம்பெண்ணின் பாசத்திற்காக போட்டியிடும் மற்ற ஆண்களைக் குறிக்கிறது.","reference":{"chapter":2,"verse":15}}]},"thisChapterLink":"/api/tam_tcv/SNG/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/SNG/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/SNG/1.json","previousChapterAudioLinks":{},"numberOfVerses":17}