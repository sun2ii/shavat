{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_tcv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"3016b99ddc546c26e0a93d4330a6cfb3e2183ac6e3dafea3688c93c1256afe8c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_tcv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":3,"content":[{"type":"verse","number":1,"content":[{"text":"இரவு முழுவதும் என் படுக்கையில் இருந்தேன்;","poem":1},{"text":"என் உயிர்க் காதலரை நான் தேடினேன்.","poem":2},{"lineBreak":true},{"text":"நான் அவரைத் தேடியும், அவரைக் காணவில்லை.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் இப்பொழுதே எழுந்திருப்பேன், பட்டணத்தின் வீதிகளிலும்","poem":1},{"text":"பொது இடங்களிலும் போய்ப்பார்ப்பேன்.","poem":2},{"text":"அங்கே நான் என் உயிர்க் காதலரைத் தேடுவேன்.","poem":1},{"text":"அப்படியே நான் அவரைத் தேடினேன், ஆனாலும் அவரைக் காணவில்லை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"காவலர்கள் பட்டணத்தைச் சுற்றித் திரிகையில்","poem":1},{"text":"என்னைக் கண்டார்கள்.","poem":2},{"lineBreak":true},{"text":"“என் உயிர்க் காதலரைக் கண்டீர்களா?” என்று நான் கேட்டேன்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவர்களை நான் கடந்துசென்றதும் என் உயிர்க் காதலரை நான் கண்டேன்.","poem":1},{"text":"நான் அவரைப் பிடித்துக்கொண்டேன்;","poem":2},{"text":"என் தாயின் வீட்டிற்கும், என்னைப் பெற்றவளின் அறைக்கும்","poem":1},{"text":"கூட்டிக்கொண்டு போகும்வரை","poem":2},{"lineBreak":true},{"text":"நான் அவரைப் போகவிடவேயில்லை.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"எருசலேமின் மங்கையரே,","poem":1},{"text":"கலைமான்கள்மேலும் வெளியின் பெண்மான்கள்மேலும் ஆணை!","poem":2},{"text":"காதலைத் தட்டி எழுப்பவேண்டாம்,","poem":1},{"text":"அது தானே விரும்பும்வரை எழுப்பவேண்டாம்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"பாலைவனத்திலிருந்து புகைமண்டலத்தைப்போல","poem":1},{"text":"வருகின்ற இவர் யார்?","poem":2},{"text":"வெள்ளைப்போளம் மணக்க, சாம்பிராணி புகைய,","poem":1},{"text":"வர்த்தகர்களின் வாசனைத் திரவியங்கள் யாவும் மணங்கமழ வருகின்ற இவர் யார்?","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இதோ, சாலொமோனின் படுக்கை!","poem":1},{"text":"இஸ்ரயேலின் மிகச்சிறந்த வீரர்களில்","poem":2},{"lineBreak":true},{"text":"அறுபது வீரர்கள் அதைச் சுற்றி நிற்கிறார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அவர்கள் எல்லோரும் வாளேந்திய வீரர்கள்,","poem":1},{"text":"அவர்கள் யுத்தத்தில் அனுபவமிக்கவர்கள்,","poem":2},{"text":"இரவின் பயங்கரத்தை எதிர்க்க","poem":1},{"text":"தம் இடுப்பில் வாள் கொண்டுள்ளவர்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"சாலொமோன் அரசன் தனக்கென லெபனோனின் மரத்தினால்","poem":1},{"text":"ஒரு பல்லக்கை செய்தார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அதின் தூண்களை வெள்ளியினாலும்,","poem":1},{"text":"அதின் சாய்மனையைத் தங்கத்தினாலும்,","poem":2},{"text":"உட்காருமிடத்தை இரத்தாம்பர நிற மெத்தையினாலும் செய்ய வைத்தார்;","poem":1},{"text":"அதின் உட்புறத்தை எருசலேமின் மங்கையர்","poem":2},{"text":"தங்கள் அன்பால் அலங்கரித்திருந்தார்கள்.","poem":1}]},{"type":"verse","number":11,"content":[{"text":"சீயோனின் மகள்களே,","poem":1},{"text":"வெளியே வாருங்கள்.","poem":2},{"text":"சாலொமோன் அரசன் மகுடம் அணிந்திருப்பதைப் பாருங்கள்,","poem":1},{"text":"அவருடைய உள்ளம் மகிழ்ச்சியுற்ற நாளான","poem":2},{"text":"அவருடைய திருமண நாளிலேயே","poem":1},{"text":"அந்த மகுடத்தை அவருடைய தாயார் அவருக்குச் சூட்டினாள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/SNG/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/SNG/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/SNG/2.json","previousChapterAudioLinks":{},"numberOfVerses":11}