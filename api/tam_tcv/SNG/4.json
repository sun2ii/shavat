{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_tcv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"3016b99ddc546c26e0a93d4330a6cfb3e2183ac6e3dafea3688c93c1256afe8c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_tcv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"என் அன்பே, நீ எவ்வளவு அழகானவள்!","poem":1},{"text":"ஆ, நீ எவ்வளவு அழகானவள்;","poem":2},{"lineBreak":true},{"text":"முகத்திரையின் பின்னாலுள்ள உன் கண்கள் புறாக்கண்கள்;","poem":2},{"text":"உனது தலைமுடி கீலேயாத் மலைச்சரிவில் இருந்து இறங்கிவரும்","poem":1},{"text":"வெள்ளாட்டு மந்தையைப் போன்றது.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உன் பற்கள் முடி கத்தரிக்கப்பட்டு,","poem":1},{"text":"குளிப்பாட்டப்பட்டுக் கரையேறுகிற செம்மறியாட்டு மந்தையைப்போல் இருக்கின்றன.","poem":2},{"text":"அவை ஒவ்வொன்றும் இரட்டைக்குட்டி ஈன்றவை,","poem":1},{"text":"அவற்றில் எதுவும் மலடாய் அல்ல.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உன் உதடுகள் செம்பட்டு நாடா போன்றவை;","poem":1},{"text":"உன் வாய் அழகானது.","poem":2},{"text":"உனது முகத்திரையின் பின்னால் உள்ள உன் கன்னங்கள்","poem":1},{"text":"பிளந்த மாதுளம் பழத்திற்கு ஒப்பானவை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உன் கழுத்து தாவீதின் கோபுரம்போல் இருக்கிறது,","poem":1},{"text":"அடுக்கடுக்காய் ஆயிரக்கணக்கான கேடயங்கள் தொங்குகின்றன;","poem":2},{"text":"அவைகளெல்லாம்","poem":1},{"text":"போர் வீரர்களுடைய ஆயுதங்களே.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உனது மார்பகங்கள் இரண்டு மான்குட்டிகள் போன்றவை,","poem":1},{"text":"அவை லில்லிகள் நடுவில் மேயும்","poem":2},{"lineBreak":true},{"text":"வெளிமானின் இரட்டைக்குட்டிகள் போன்றவை.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"பொழுது சாய்வதற்குள்,","poem":1},{"text":"நிழல் மறைவதற்குள்,","poem":2},{"text":"நான் வெள்ளைப்போள மலைக்கும்,","poem":1},{"text":"சாம்பிராணிக் குன்றுக்கும் விரைந்து செல்வேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"என் அன்பே, நீ முற்றிலும் அழகானவள்;","poem":1},{"text":"உன்னில் குறைபாடு எதுவும் இல்லை.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"லெபனோனில் இருந்து என்னுடன் வா, என் மணமகளே,","poem":1},{"text":"லெபனோனில் இருந்து என்னுடன் வா.","poem":2},{"text":"அமனா மலைச் சிகரத்திலிருந்தும்,","poem":1},{"text":"சேனீர் மற்றும் எர்மோன் மலை உச்சியிலிருந்தும்,","poem":2},{"text":"சிங்கக் குகைகளிலிருந்தும்,","poem":1},{"text":"சிறுத்தைப் புலிகள் தங்கும் இடமான மலைகளிலிருந்தும் இறங்கி வா.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"என் சகோதரியே, என் மணமகளே, நீ என் உள்ளத்தைக் கொள்ளை கொண்டாய்;","poem":1},{"text":"உன் கண்களின் ஒரு பார்வையினாலே,","poem":2},{"text":"உன் கழுத்து மாலையின் ஒரு மணியினாலே","poem":1},{"text":"என் உள்ளத்தைக் கொள்ளை கொண்டாய்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என் சகோதரியே, என் மணமகளே, உன் அன்பு எவ்வளவு இனிமையானது!","poem":1},{"text":"உன் அன்பு திராட்சை இரசத்திலும் இன்பமானது;","poem":2},{"text":"உனது வாசனைத் தைலத்தின் நறுமணம்","poem":1},{"text":"எல்லாவகை வாசனைத் தைலத்தைப் பார்க்கிலும் சிறந்தது!","poem":2}]},{"type":"verse","number":11,"content":[{"text":"என் மணமகளே, உன் உதடுகள் தேன்கூட்டைப்போல் இனிமையைப் பொழிகின்றன;","poem":1},{"text":"உன் நாவின்கீழே பாலும் தேனும் இருக்கின்றன.","poem":2},{"text":"உன் உடைகளின் நறுமணம்","poem":1},{"text":"லெபனோனின் நறுமணம்போல் இருக்கின்றது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"என் சகோதரியே, என் மணமகளே, நீ சுற்றி அடைக்கப்பட்ட தோட்டம்,","poem":1},{"text":"நீ பூட்டப்பட்ட நீரூற்று, முத்திரையிடப்பட்ட கிணறு.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"மாதுளைத் தோட்டத்தைப்போல தளிர்த்துள்ளாய்;","poem":1},{"text":"அங்கே சிறந்த கனிகளுண்டு,","poem":2},{"lineBreak":true},{"text":"மருதோன்றிச் செடிகளும் நளதச்செடிகளும் உண்டு.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"அங்கே நளதம், குங்குமம்,","poem":2},{"lineBreak":true},{"text":"வசம்பு, இலவங்கம்,","poem":2},{"lineBreak":true},{"text":"எல்லாவித நறுமண மரங்களும்,","poem":2},{"lineBreak":true},{"text":"வெள்ளைப்போளமும் சந்தனமும்,","poem":2},{"lineBreak":true},{"text":"எல்லாச் சிறந்த நறுமணச்செடிகளும் நிறைந்துள்ளது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"நீ தோட்டத்திலுள்ள நீரூற்று,","poem":1},{"text":"ஜீவத்தண்ணீரின் கிணறு,","poem":2},{"lineBreak":true},{"text":"லெபனோனிலிருந்து ஓடிவரும் நீரோடை.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"வாடைக்காற்றே எழும்பு,","poem":1},{"text":"தென்றல் காற்றே வா!","poem":2},{"text":"வாசனை நிரம்பிப் பரவும்படி","poem":1},{"text":"என் தோட்டத்தில் வீசு.","poem":2},{"text":"என் காதலர் தமது தோட்டத்திற்குள் வந்து","poem":1},{"text":"அதின் சிறந்த பழங்களைச் சுவைக்கட்டும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/SNG/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/SNG/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/SNG/3.json","previousChapterAudioLinks":{},"numberOfVerses":16}