{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_tcv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"3016b99ddc546c26e0a93d4330a6cfb3e2183ac6e3dafea3688c93c1256afe8c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_tcv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"என் சகோதரியே, என் மணவாளியே, நான் என் தோட்டத்திற்கு வந்துள்ளேன்;","poem":1},{"text":"என் நறுமணப் பொருட்களுடன் என் வெள்ளைப்போளத்தையும் சேர்த்துக்கொண்டேன்.","poem":2},{"text":"என்னுடைய தேன்கூட்டை என் தேனோடு சாப்பிட்டேன்;","poem":1},{"text":"நான் என்னுடைய திராட்சை இரசத்தையும் என் பாலையும் குடித்தேன்.","poem":2},"தோழியர்",{"text":"நண்பர்களே, சாப்பிடுங்கள், குடியுங்கள்;","poem":1},{"text":"அன்பர்களே, திருப்தியாய்க் குடியுங்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் உறங்கினேன், என் இருதயமோ விழித்திருந்தது.","poem":1},{"text":"கேளுங்கள், என் காதலர் கதவைத் தட்டுகிறார்:","poem":2},{"text":"“என் சகோதரியே, என் அன்பே,","poem":1},{"text":"என் புறாவே, என் உத்தமியே, கதவைத்திற.","poem":2},{"text":"என் தலை பனியால் நனைந்திருக்கிறது,","poem":1},{"text":"என் தலைமுடி இரவின் தூறலினால் நனைந்திருக்கிறது” என்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் என் உடைகளைக் கழற்றிவிட்டேன்;","poem":1},{"text":"அவற்றைத் திரும்பவும் நான் உடுக்க வேண்டுமோ?","poem":2},{"text":"நான் என் கால்களைக் கழுவிவிட்டேன்;","poem":1},{"text":"அவற்றைத் திரும்பவும் நான் அழுக்காக்க வேண்டுமோ?","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் காதலர் கதவுத் துவாரத்தின் வழியாகத் தன் கையை நுழைத்தார்;","poem":1},{"text":"என் உள்ளம் அவரைக்காண துடித்தது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நான் என் காதலருக்காகக் கதவைத் திறக்க எழுந்தேன்,","poem":1},{"text":"என் கையிலிருந்து வெள்ளைப்போளம் வடிந்தது;","poem":2},{"text":"கதவின் பிடியில் என் கைவிரல்கள்","poem":1},{"text":"வெள்ளைப்போளத்தைச் சிந்தின.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"நான் என் காதலருக்காகக் கதவைத் திறந்தேன்,","poem":1},{"text":"ஆனால் என் காதலரோ அங்கு இல்லை; அவர் போய்விட்டார்.","poem":2},{"lineBreak":true},{"text":"அதினால் என் உள்ளம் ஏங்கியது.","poem":2},{"text":"நான் அவரைத் தேடினேன்; அவரைக் காணவில்லை.","poem":1},{"text":"நான் கூப்பிட்டேன்; அவர் பதில் கொடுக்கவில்லை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"காவற்காரர்கள் பட்டணத்தைச்சுற்றி வரும்போது,","poem":1},{"text":"என்னைக் கண்டார்கள்.","poem":2},{"text":"அவர்கள் என்னை அடித்தனர், காயப்படுத்தினர்,","poem":1},{"text":"என் மேலுடையை எடுத்துக்கொண்டார்கள்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் அரணைக் காவல் செய்வோர்!","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எருசலேம் மங்கையரே,","poem":1},{"text":"நான் உங்களுக்கு ஆணையிட்டுச் சொல்கிறேன்;","poem":2},{"text":"நீங்கள் என் காதலரைக் காண்பீர்களானால் என்னத்தைச் சொல்வீர்கள்?","poem":1},{"text":"காதலினால் மயங்கியிருக்கிறேன் என்று சொல்லுங்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"பெண்களுள் பேரழகியே,","poem":1},{"text":"உன் காதலர் மற்றவர்களைவிட எவ்வகையில் சிறந்தவர்?","poem":2},{"text":"நீ இவ்விதம் ஆணையிட்டுச் சொல்லும் அளவுக்கு","poem":1},{"text":"உன் காதலர் மற்றவர்களைவிட எவ்வகையில் சிறந்தவர்?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"என் காதலர் பிரகாசமான","poem":1},{"noteId":10},{"text":"சிவந்த தோற்றமுள்ளவர்,","poem":1},{"text":"பத்தாயிரம் பேருக்குள் அதிசிறந்தவர்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அவருடைய தலை சுத்தமான தங்கமாயிருக்கிறது;","poem":1},{"text":"தலைமயிரோ சுருள் சுருளாகவும்","poem":2},{"lineBreak":true},{"text":"காகத்தைப்போல் கருமையாகவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அவருடைய கண்களோ","poem":1},{"text":"பாலில் குளித்து,","poem":2},{"text":"நீரூற்றருகே தங்கும் புறாக்களைப்போலவும்,","poem":1},{"text":"பதிக்கப்பட்டக் கற்களைப்போலவும் இருக்கின்றன.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர் கன்னங்கள் நறுமணச்செடிகள் முளைக்கும்","poem":1},{"text":"பாத்திகள்போல் இருக்கின்றன.","poem":2},{"text":"அவருடைய உதடுகள் வெள்ளைப்போளம்","poem":1},{"text":"வடிகின்ற லில்லிப் பூக்களைப்போல் இருக்கின்றன.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அவருடைய புயங்களோ கோமேதகம்","poem":1},{"text":"பதித்த தங்க வளையல்களைப்போல் இருக்கின்றன.","poem":2},{"text":"அவருடைய வயிறு நீலக்கற்களினால் அலங்கரிக்கப்பட்ட,","poem":1},{"text":"துலக்கிய தந்தம்போல் இருக்கின்றது.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அவருடைய கால்களோ சுத்தத்தங்கத்தால்","poem":1},{"text":"அடித்தளமிடப்பட்ட பளிங்குத் தூண்களாய் இருக்கின்றன.","poem":2},{"text":"அவருடைய தோற்றமோ லெபனோனைப்போலவும்","poem":1},{"text":"அது சிறந்த கேதுரு மரங்களைப் போலவும் இருக்கிறது.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அவருடைய வாய் இனிமையானது;","poem":1},{"text":"அவர் முற்றிலும் அழகானவர்.","poem":2},{"text":"எருசலேமின் மங்கையரே,","poem":1},{"text":"இவரே என் காதலர், இவரே என் நண்பர்.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"பிரகாசமான அல்லது வலிமை உடையவர், அவருக்கு நிகரானவர் எவருமில்லை.","reference":{"chapter":5,"verse":10}}]},"thisChapterLink":"/api/tam_tcv/SNG/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/SNG/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/SNG/4.json","previousChapterAudioLinks":{},"numberOfVerses":16}