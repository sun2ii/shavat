{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_tcv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"3016b99ddc546c26e0a93d4330a6cfb3e2183ac6e3dafea3688c93c1256afe8c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_tcv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":6,"content":[{"type":"verse","number":1,"content":[{"text":"பெண்களுள் பேரழகியே,","poem":1},{"text":"உன் காதலர் எங்கே போய்விட்டார்?","poem":2},{"text":"உன் காதலர் எப்பக்கம் திரும்பிப்போனார்?","poem":1},{"text":"சொன்னால் உன்னோடு சேர்ந்து நாங்களும் அவரைத் தேடுவோம்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"என் காதலர் தோட்டங்களில் மேய்வதற்கும்,","poem":1},{"text":"லில்லிப் பூக்களைச் சேர்ப்பதற்கும்,","poem":2},{"text":"நறுமணச்செடிகளின் பாத்திகளுக்கும்","poem":1},{"text":"போயிருக்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நான் என் காதலருக்குரியவள், என் காதலர் என்னுடையவர்;","poem":1},{"text":"அவர் லில்லிப் பூக்களுக்கிடையில் தன் மந்தையை மேய்க்கிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"என் அன்பே, நீ திர்சா பட்டணத்தைப்போல அழகானவள்,","poem":1},{"text":"எருசலேமைப்போல வசீகரமானவள்,","poem":2},{"lineBreak":true},{"text":"கொடிகள் ஏந்தும் படைகளைப்போல கம்பீரமானவள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உன் கண்களை என்னைவிட்டுத் திருப்பு;","poem":1},{"text":"அவை என்னை மயக்குகின்றன.","poem":2},{"text":"உனது தலைமுடி கீலேயாத் மலைச்சரிவில் இருந்து இறங்கிவரும்","poem":1},{"text":"வெள்ளாட்டு மந்தையைப் போன்றது.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"உனது பற்கள் குளிப்பாட்டப்பட்டுக் கரையேறுகிற செம்மறியாட்டு","poem":1},{"text":"மந்தையைப்போல் இருக்கின்றன.","poem":2},{"text":"அவை ஒவ்வொன்றும் இரட்டைக்குட்டி ஈன்றவை,","poem":1},{"text":"அவற்றில் எதுவும் மலடாய் அல்ல.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உனது முகத்திரையின் பின்னால் உள்ள உன் கன்னங்கள்","poem":1},{"text":"பிளந்த மாதுளம் பழத்திற்கு ஒப்பானவை.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"அறுபது அரசிகளும்,","poem":1},{"text":"எண்பது வைப்பாட்டிகளும்;","poem":2},{"lineBreak":true},{"text":"கணக்கிடமுடியாத கன்னிப்பெண்களும் இருக்கலாம்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஆனால் என் புறாவோ, என் உத்தமியோ ஈடு இணையற்றவள்,","poem":1},{"text":"அவள் தன் தாய்க்கு ஒரே மகள்,","poem":2},{"lineBreak":true},{"text":"அவள் அவளைப் பெற்றவளுக்குச் செல்லப்பிள்ளை.","poem":2},{"text":"கன்னிப்பெண்கள் அவளைக் கண்டு வாழ்த்தினார்கள்;","poem":1},{"text":"அரசிகளும் வைப்பாட்டிகளும் அவளைப் புகழ்ந்தார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"சந்திரனைப்போல் அழகுள்ளவளாயும், சூரியனைப்போல் ஒளியுள்ளவளாயும்,","poem":1},{"text":"அணிவகுத்து நிற்கும் நட்சத்திரங்களைப்போல் கம்பீரமானவளாயும்","poem":2},{"lineBreak":true},{"text":"அதிகாலையைப்போல் தோன்றுகிற இவள் யார்?","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பள்ளத்தாக்கின் புதுத் தளிர்களைப் பார்க்கவும்,","poem":1},{"text":"திராட்சைக்கொடிகள் மொட்டு விட்டிருக்கின்றனவா என்று பார்க்கவும்,","poem":2},{"text":"மாதுளை மரங்கள் பூத்திருக்கின்றனவா என்று பார்க்கவும்","poem":1},{"text":"நான் வாதுமைத் தோட்டத்திற்குப் போனேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நான் புரிந்துகொள்ளும் முன்னமே,","poem":1},{"text":"என் ஆசை என்னை என் மக்களின் அரச தேர்களுக்கு","poem":2},{"noteId":11},{"text":"அழைத்துச் சென்றது.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"திரும்பி வா, திரும்பி வா, சூலமித்தியே,","poem":1},{"text":"நாங்கள் உன்னை நன்றாய்ப் பார்க்கும்படி திரும்பி வா, திரும்பி வா!","poem":2},"காதலன்",{"text":"இரண்டு அணிகளின் நடனங்களைப் பார்ப்பதுபோல்,","poem":1},{"text":"நீங்கள் ஏன் சூலமித்தியை உற்றுப் பார்க்கிறீர்கள்?","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":11,"caller":"+","text":"அரச தேர்களுக்கு அல்லது அம்மினாதாபின் தேர்களுக்கு","reference":{"chapter":6,"verse":12}}]},"thisChapterLink":"/api/tam_tcv/SNG/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/SNG/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/SNG/5.json","previousChapterAudioLinks":{},"numberOfVerses":13}