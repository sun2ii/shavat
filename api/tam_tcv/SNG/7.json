{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_tcv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"3016b99ddc546c26e0a93d4330a6cfb3e2183ac6e3dafea3688c93c1256afe8c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_tcv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"இளவரசனின் மகளே,","poem":1},{"text":"பாதணி அணிந்த உன் பாதங்கள் எவ்வளவு அழகானவை!","poem":2},{"text":"உன் தொடையின் வளைவுகள்,","poem":1},{"text":"கலைஞனின் கைவேலைப்பாடான நகைகள்போல் இருக்கின்றன.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"உனது தொப்புள்","poem":1},{"text":"ஒருபோதும் திராட்சை இரசம் குறையாத வட்டமான கிண்ணம் போன்றது.","poem":2},{"text":"உனது வயிறோ,","poem":1},{"text":"லில்லியினால் சூழ்ந்துள்ள கோதுமைக் குவியல் போன்றது.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"உனது மார்பகங்கள் இரண்டு மான்குட்டிகள் போன்றவை,","poem":1},{"text":"வெளிமானின் இரட்டைக்குட்டிகள் போன்றவை.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"உன் கழுத்து தந்தத்தினாலான கோபுரம் போன்றது.","poem":1},{"lineBreak":true},{"text":"உன் கண்கள் பத்ரபீம் வாசல் அருகேயுள்ள","poem":1},{"text":"எஸ்போனின் குளங்களைப் போன்றவை.","poem":2},{"text":"உன் மூக்கு தமஸ்கு பட்டணத்தை நோக்கியுள்ள","poem":1},{"text":"லெபனோனின் கோபுரம் போன்றது.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"உன் தலை கர்மேல் மலைபோல் உனக்கு முடிசூட்டுகிறது.","poem":1},{"text":"உனது தலைமுடி அரசர்களுக்கென அலங்கரிக்கப்பட்ட இரத்தாம்பர பின்னல்போல் இருக்கிறது;","poem":2},{"lineBreak":true},{"text":"அந்தப் பின்னலின் அழகில் அரசன் மயங்குகிறான்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"மகிழ்ச்சி உண்டாக்கும் என் அன்பே,","poem":1},{"text":"நீ எவ்வளவு அழகானவள், எவ்வளவு இன்பமானவள்!","poem":2}]},{"type":"verse","number":7,"content":[{"text":"உன் உயரம் பனைமரத்தின் உயரம் போன்றது,","poem":1},{"text":"உன் மார்பகங்கள் பழக்குலைகள் போன்றது.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"“நான் அந்தப் பனைமரத்தில் ஏறுவேன்;","poem":1},{"text":"அதின் பழத்தைப் பிடித்துக்கொள்வேன்” என்றேன்.","poem":2},{"text":"உனது மார்பகங்கள் திராட்சைக் குலைகள்போல் ஆவதாக,","poem":1},{"text":"உன் சுவாசத்தின் வாசனை ஆப்பிள்போல் மணம் கமழ்வதாக,","poem":2}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"உனது வாயின் முத்தங்கள் திராட்சை இரசம் போன்றது.","poem":2},"காதலி",{"text":"அது உதடுகளுக்கும் பற்களுக்கும் இடையில் மெதுவாய் இறங்கும்","poem":1},{"text":"இனிமையான திராட்சை இரசம்போல் இருக்கிறது.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் என் காதலருக்கே உரியவள்,","poem":1},{"text":"அவரின் ஆசை என்மேலேயே உள்ளது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அன்பரே வாரும், நாம் வயல்வெளிக்குப் போய்,","poem":1},{"text":"நம் இரவைக் கிராமங்களில்","poem":2},{"noteId":12},{"text":"கழிப்போம்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அதிகாலையில் எழுந்து திராட்சைத் தோட்டங்களுக்குப் போவோம்;","poem":1},{"text":"அங்கே திராட்சை துளிர்த்திருக்கிறதா என்றும்,","poem":2},{"text":"அவைகளின் மொட்டுகள் விரிந்திருக்கின்றனவா என்றும்,","poem":1},{"text":"மாதளஞ்செடிகள் பூத்திருக்கிறதா என்றும் பார்ப்போம்.","poem":2},{"lineBreak":true},{"text":"அங்கே என் காதலைப் பொழிவேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"தூதாயீம்","poem":1},{"noteId":13},{"text":"பழங்களின் வாசனை வீசுகின்றது,","poem":1},{"text":"புதியதும் பழையதுமான","poem":2},{"text":"எல்லாச் சிறந்த பழங்களும் நம் வாசலருகில் உள்ளது;","poem":1},{"text":"என் அன்பரே, உமக்கென்றே நான் அவற்றைச் சேர்த்துவைத்தேன்.","poem":2}]},{"type":"line_break"}],"footnotes":[{"noteId":12,"caller":"+","text":"கிராமங்களில் என்பது மருதோன்றிகள் அல்லது காட்டுப் புதர்கள் மத்தியில்","reference":{"chapter":7,"verse":11}},{"noteId":13,"caller":"+","text":"அக்கால கலாச்சாரத்தில் இந்த மூலிகை பாலுணர்வைத் தூண்டுவதாகவும் கருவுறுதலை ஊக்குவிப்பதாகவும் நம்பப்பட்டது. ஆதி. 30:14-16.","reference":{"chapter":7,"verse":13}}]},"thisChapterLink":"/api/tam_tcv/SNG/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/SNG/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/SNG/6.json","previousChapterAudioLinks":{},"numberOfVerses":13}