{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"SNG","translationId":"tam_tcv","name":"உன்னதப்பாட்டு","commonName":"உன்னதப்பாட்டு","title":"உன்னதப்பாட்டு","order":22,"numberOfChapters":8,"sha256":"3016b99ddc546c26e0a93d4330a6cfb3e2183ac6e3dafea3688c93c1256afe8c","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/SNG/1.json","lastChapterNumber":8,"lastChapterApiLink":"/api/tam_tcv/SNG/8.json","totalNumberOfVerses":117},"chapter":{"number":8,"content":[{"type":"verse","number":1,"content":[{"text":"நீர் என் தாயின் மார்பில் பால் குடித்த","poem":1},{"text":"என் சகோதரனாய் இருந்திருந்தால் நலமாயிருந்திருக்குமே!","poem":2},{"text":"உம்மை வெளியில் கண்டால்","poem":1},{"text":"நான் உம்மை முத்தம் செய்திருப்பேன்;","poem":2},{"lineBreak":true},{"text":"யாரும் என்னை இகழமாட்டார்கள்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நான் உம்மை என் தாயின் வீட்டிற்கு கூட்டிக்கொண்டு போவேன்,","poem":1},{"text":"எனக்குக்","poem":2},{"noteId":14},{"text":"கற்றுக்கொடுத்தவளிடம் கொண்டு வந்திருப்பேன்.","poem":2},{"lineBreak":true},{"text":"குடிப்பதற்கு வாசனையுள்ள திராட்சை இரசத்தையும்","poem":2},{"text":"என் மாதுளம் பழச்சாற்றையும்","poem":1},{"text":"நான் உமக்குக் குடிக்கத் தருவேன்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவருடைய இடதுகை என் தலையின்கீழ் இருக்கிறது,","poem":1},{"text":"அவருடைய வலதுகை என்னை அணைத்துக்கொள்கிறது.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"எருசலேமின் மங்கையரே, ஆணையிடுகிறேன்;","poem":1},{"text":"காதலைத் தட்டி எழுப்பவேண்டாம்,","poem":2},{"lineBreak":true},{"text":"அது தானே விரும்பும்வரை எழுப்பவேண்டாம்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"தன் காதலர்மேல் சாய்ந்துகொண்டு","poem":1},{"text":"பாலைவனத்திலிருந்து வருகிற இவள் யார்?","poem":2},"காதலி",{"text":"ஆப்பிள் மரத்தின் கீழே நான் உம்மை எழுப்பினேன்;","poem":1},{"text":"அங்குதான் உமது தாய் உம்மைப் பெற்றெடுத்தாள்,","poem":2},{"lineBreak":true},{"text":"பிரசவ வேதனைப்பட்ட அவள், அங்குதான் உம்மைப் பெற்றெடுத்தாள்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"என்னை உமது உள்ளத்திலும் கையிலும்","poem":1},{"text":"முத்திரையைப்போல் பதித்துக்கொள்ளும்;","poem":2},{"text":"ஏனெனில் காதல் மரணத்தைப்போல வலிமைமிக்கது,","poem":1},{"lineBreak":true},{"text":"அதின் வைராக்கியம்","poem":1},{"text":"பாதாளத்தைப்போல கொடியது,","poem":2},{"text":"அது கொழுந்து விட்டெரியும் நெருப்பு,","poem":1},{"text":"அதின் ஜூவாலை பெரிதாயிருக்கிறது.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"பெருவெள்ளமும் காதலை அணைக்காது;","poem":1},{"text":"ஆறுகள் அதை அடித்துக்கொண்டு போகாது.","poem":2},{"text":"காதலுக்குக் கைமாறாக,","poem":1},{"text":"ஒருவன் தனது எல்லா செல்வங்களையும் கொடுத்தாலும்,","poem":2},{"lineBreak":true},{"text":"அது","poem":2},{"noteId":15},{"text":"முற்றிலும் அவமதிக்கப்படும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"எங்களுக்கு ஒரு தங்கை இருக்கிறாள்,","poem":1},{"text":"அவள் மார்பகங்கள் இன்னும் வளர்ச்சியடையவில்லை.","poem":2},{"text":"அவளைப் பெண்பார்க்க வரும்நாளில்","poem":1},{"text":"நம் தங்கைக்காக நாம் என்ன செய்யலாம்?","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அவள் ஒரு மதில்போல கன்னிகையாயிருந்தால்,","poem":1},{"text":"அவள்மேல் வெள்ளியினால் கோபுரம் அமைப்போம்.","poem":2},{"text":"ஆனால் அவள் ஊசலாடும் கதவைப்போல ஒழுக்கமற்றவளாயிருந்தால்,","poem":1},{"text":"கேதுரு மரப்பலகைப் பதித்து அவளை மூடி மறைப்போம்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"நான் ஒரு மதில்போல கன்னிகைதான்,","poem":1},{"text":"என் மார்பகங்கள் கோபுரங்கள் போலிருக்கின்றன.","poem":2},{"noteId":16},{"text":"அவர் என்னைப் பார்க்கும்போது","poem":1},{"text":"அவருடைய கண்களுக்கு மகிழ்ச்சி தருபவளாவேன்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"பாகால் ஆமோனில் சாலொமோனுக்கு ஒரு திராட்சைத் தோட்டம் இருந்தது;","poem":1},{"text":"அவர் தனது திராட்சைத் தோட்டத்தைக் குத்தகைக்காரருக்குக் கொடுத்திருந்தார்.","poem":2},{"text":"ஒவ்வொருவரும் அதின் பழங்களுக்கு","poem":1},{"text":"ஆயிரம் சேக்கல்","poem":2},{"noteId":17},{"text":"வெள்ளிக்காசைக் கொண்டுவர வேண்டியிருந்தது.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"ஆனால் என் சொந்தத் திராட்சைத் தோட்டமோ, என் முன்னே இருக்கிறது;","poem":1},{"text":"சாலொமோனே, அந்த ஆயிரம் சேக்கல் உமக்கும்,","poem":2},{"lineBreak":true},{"text":"அதின் பழங்களைப் பராமரிக்கிறவர்களுக்கு இருநூறு சேக்கலும் உரியதாகும்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"தோழிகள் சூழ,","poem":1},{"text":"தோட்டத்தில் வசிப்பவளே,","poem":2},{"lineBreak":true},{"text":"உன் குரலை நான் கேட்கட்டும்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"என் அன்பரே, இங்கே வாரும்,","poem":1},{"text":"நறுமணச்செடிகள் நிறைந்த மலைகளின்மேல்,","poem":2},{"text":"வெளிமானைப் போலவும்","poem":1},{"text":"மரைக்குட்டியைப் போலவும் வாரும்.","poem":2}]}],"footnotes":[{"noteId":14,"caller":"+","text":"அல்லது அங்கே நீர் எனக்கு போதிப்பாய்","reference":{"chapter":8,"verse":2}},{"noteId":15,"caller":"+","text":"அல்லது அவன்","reference":{"chapter":8,"verse":7}},{"noteId":16,"caller":"+","text":"அல்லது நான் முழுமையாக முதிர்ச்சியடைந்தவள் அல்லது வளர்ந்தவள் என்று அவர் நினைப்பார்","reference":{"chapter":8,"verse":10}},{"noteId":17,"caller":"+","text":"ஒவ்வொரு சேக்கலும் ஒரு கிராமப்புற தொழிலாளிக்கு ஒரு நாள் ஊதியத்திற்கு சமம்","reference":{"chapter":8,"verse":11}}]},"thisChapterLink":"/api/tam_tcv/SNG/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ISA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/SNG/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}