{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ZEC","translationId":"tam_tcv","name":"சகரியா","commonName":"சகரியா","title":"சகரியா","order":38,"numberOfChapters":14,"sha256":"aeeddb4589dda3feab839da68a4d42bf4a93c792bbdc84ef01559939a7ac3994","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":10,"content":[{"type":"heading","content":["யெகோவா யூதாவை ஆதரிப்பார்"]},{"type":"verse","number":1,"content":[{"text":"யூதா மக்களே, யெகோவாவிடம் வசந்தகாலத்தில் மழைக்காக மன்றாடுங்கள்;","poem":1},{"text":"யெகோவாவே மழைமேகங்களை உண்டாக்குகிறவர்.","poem":2},{"text":"அவர் மனிதர்களுக்கு மழையைப் பொழியச்செய்து,","poem":1},{"text":"அனைவருக்காகவும் வயலின் பயிர்களை விளையச் செய்கிறவர்.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"விக்கிரகங்கள் வஞ்சனை பேசுகின்றன.","poem":1},{"text":"குறிசொல்கிறவர்கள் பொய்யான காட்சிகளைக் காண்கிறார்கள்.","poem":2},{"text":"உண்மையற்ற கனவுகளைக் கூறுகிறார்கள்.","poem":1},{"text":"அவர்கள் கொடுக்கும் ஆறுதலும் பயனற்றது.","poem":2},{"text":"ஆகவே மக்கள் செம்மறியாடுகளைப்போல் வழிதப்பி,","poem":1},{"text":"மேய்ப்பன் இல்லாதபடியால் ஒடுக்கப்படுகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“மேய்ப்பர்கள்மேல் என் கோபம் பற்றியெரிகிறது,","poem":1},{"text":"தலைவர்களை நான் தண்டிப்பேன்;","poem":2},{"text":"சேனைகளின் யெகோவா,","poem":1},{"text":"யூதா குடும்பத்தாராகிய தமது மந்தையைப் பராமரிப்பார்,","poem":2},{"lineBreak":true},{"text":"அவர்களை யுத்த களத்தின் கம்பீரமான குதிரையைப் போலாக்குவார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"மூலைக்கல்லும் கூடாரத்திற்கான முளையும்,","poem":1},{"text":"யுத்த வில்லும்,","poem":2},{"text":"யூதாவிலிருந்தே தோன்றும்.","poem":1},{"text":"யூதாவிலிருந்தே எல்லா ஆளுநர்களும் தோன்றுவார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"யுத்தத்தில் வீதிகளின் சேற்றில் எதிரியை மிதிக்கும் வலிமையான மனிதர்போல்,","poem":1},{"text":"அவர்கள் ஒன்றுசேர்ந்திருப்பார்கள்.","poem":2},{"text":"யெகோவா அவர்களோடிருப்பதால் அவர்கள் போரிட்டு,","poem":1},{"text":"குதிரைவீரரையும் முறியடிப்பார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“நான் யூதா குடும்பத்தாரைப் பெலப்படுத்துவேன்.","poem":1},{"text":"யோசேப்பு குடும்பத்தாரைக் காப்பாற்றுவேன்.","poem":2},{"text":"நான் அவர்கள்மேல் இரக்கங்கொண்டபடியால்,","poem":1},{"text":"நான் அவர்களை","poem":2},{"text":"முந்திய நிலைக்குக் கொண்டுவருவேன்.","poem":1},{"text":"அவர்கள் என்னால் புறக்கணிக்கப்படாதவர்கள்போல் இருப்பார்கள்.","poem":2},{"text":"ஏனெனில் அவர்களின் இறைவனாகிய யெகோவா நானே.","poem":1},{"text":"நான் அவர்களின் வேண்டுதலுக்கு விடையளிப்பேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எப்பிராயீமியர் வலிமைமிக்க மனிதரைப் போலாவார்கள்.","poem":1},{"text":"திராட்சை இரசம் குடித்தவர்களைப்போல் அவர்கள் உள்ளத்தில் மகிழ்வார்கள்.","poem":2},{"text":"அவர்களுடைய பிள்ளைகள் அதைக்கண்டு களிகூருவார்கள்;","poem":1},{"text":"அவர்களின் உள்ளம் யெகோவாவிடம் மகிழும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"நான் சைகை காட்டி","poem":1},{"text":"அவர்களை ஒன்றுகூட்டுவேன்.","poem":2},{"text":"நிச்சயமாய் நான் அவர்களை மீட்பேன்.","poem":1},{"text":"அவர்கள் முன்போல் எண்ணற்றவர்களாய் இருப்பார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"மக்கள் கூட்டங்களிடையே நான் அவர்களைச் சிதறடித்தாலும்,","poem":1},{"text":"தூரதேசங்களிலும் இன்னும் அவர்கள் என்னை நினைத்துக்கொண்டிருப்பார்கள்.","poem":2},{"text":"அவர்களும் அவர்கள் பிள்ளைகளும் தப்பிப் பிழைப்பார்கள்.","poem":1},{"text":"அவர்கள் திரும்பி வருவார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"அவர்களை நான் எகிப்திலிருந்து திரும்பவும் கொண்டுவந்து,","poem":1},{"text":"அசீரியாவிலிருந்த அவர்களை ஒன்றுகூட்டி,","poem":2},{"text":"கீலேயாத், லெபனோன் நாடுகளுக்குக் கொண்டுவருவேன்.","poem":1},{"text":"அவர்களுக்கு அங்கே போதுமான இடம் இருக்காது.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"தொல்லை என்னும் கடலைக் கடந்து செல்வார்கள்;","poem":1},{"text":"ஏனெனில் கொந்தளிக்கும் கடல் அமைதியாக்கப்படும்.","poem":2},{"lineBreak":true},{"text":"நைல் நதியின் ஆழங்களெல்லாம் வறண்டுபோகும்;","poem":2},{"text":"அசீரியாவின் அகந்தை தாழ்த்தப்படும்.","poem":1},{"text":"எகிப்தின் செங்கோலும் அதைவிட்டு எடுபடும்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நான் அவர்களை யெகோவாவிடம் பெலப்படுத்துவேன்”","poem":1},{"text":"அவருடைய பெயரில் அவர்கள் நடப்பார்கள்","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"line_break"}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ZEC/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ZEC/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ZEC/9.json","previousChapterAudioLinks":{},"numberOfVerses":12}