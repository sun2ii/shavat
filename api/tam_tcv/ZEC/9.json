{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ZEC","translationId":"tam_tcv","name":"சகரியா","commonName":"சகரியா","title":"சகரியா","order":38,"numberOfChapters":14,"sha256":"aeeddb4589dda3feab839da68a4d42bf4a93c792bbdc84ef01559939a7ac3994","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ZEC/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tam_tcv/ZEC/14.json","totalNumberOfVerses":211},"chapter":{"number":9,"content":[{"type":"heading","content":["இஸ்ரயேலின் பகைவருக்கு நியாயத்தீர்ப்பு"]},{"type":"verse","number":1,"content":["ஒரு இறைவாக்கு:",{"text":"யெகோவாவின் வார்த்தை ஹதெராக் நாட்டுக்கு விரோதமாய் இருக்கிறது.","poem":1},{"text":"அவரது தண்டனை தமஸ்கு நகரத்தின்மேல் வரும்.","poem":2},{"text":"ஏனெனில் எல்லா மக்களினுடைய, இஸ்ரயேல் வம்சம் முழுவதினுடைய கண்கள்","poem":1},{"text":"யெகோவாவையே நோக்கிக் கொண்டிருக்கின்றன.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"தமஸ்குவின் எல்லையாக உள்ள ஆமாத்தின்மேலும்,","poem":1},{"text":"தீரு, சீதோன் பட்டணங்கள் திறமைமிக்கதாய் இருந்தபோதும்,","poem":2},{"lineBreak":true},{"text":"அவற்றின்மேலும் அவரது தண்டனை வரும்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"தீரு தனக்கென ஒரு அரணைக் கட்டியிருக்கிறாள்.","poem":1},{"text":"அவள் வெள்ளியைத் தூசியைப்போலவும்,","poem":2},{"lineBreak":true},{"text":"தங்கத்தை வீதியின் அழுக்கைப்போலவும் குவித்து வைத்திருக்கிறாள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"ஆனால் யெகோவா அவளுடைய உடைமைகள் அனைத்தையும் எடுத்துப் போடுவார்.","poem":1},{"text":"கடலில் அவளுக்குள்ள வலிமையை அழித்துப்போடுவார்.","poem":2},{"lineBreak":true},{"text":"அவள் நெருப்புக்கு இரையாக்கப்படுவாள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"அஸ்கலோன் பட்டணம் அதைக்கண்டு அஞ்சும்;","poem":1},{"text":"காசா பட்டணமும் வேதனையால் துடிக்கும்.","poem":2},{"lineBreak":true},{"text":"எக்ரோன் பட்டணத்தின் எதிர்பார்ப்பும் அற்றுப்போகும்.","poem":2},{"text":"காசா தன் அரசனை இழப்பாள்.","poem":1},{"text":"அஸ்கலோன் பாழாய்ப்போகும்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"வெளிநாட்டவர் அஸ்தோத்தில் குடியிருப்பார்கள்.","poem":1},{"text":"நான் பெலிஸ்தியரின் அகந்தையை இல்லாமல் ஒழிப்பேன்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"இரத்தம் வடியும் உணவை அவர்கள் வாயிலிருந்தும்","poem":1},{"text":"அருவருப்பான உணவை அவர்களின் பற்களின் இடையிலிருந்தும் நீக்குவேன்;","poem":2},{"lineBreak":true},{"text":"மீதியான பெலிஸ்தியரோ நம் இறைவனுக்கு உரியவராவார்கள்.","poem":2},{"text":"அவர்கள் யூதாவின் தலைவர்களாவார்கள்.","poem":1},{"text":"எக்ரோன் எபூசியரைப்போல் ஆகும்.","poem":2},{"lineBreak":true},{"text":"எனவே பெலிஸ்திய நாடு இஸ்ரயேலில் ஒரு பங்காகும்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆனால் நான் கொள்ளையர்களை எதிர்த்து,","poem":1},{"text":"என் ஆலயத்தைப் பாதுகாப்பேன்;","poem":2},{"text":"நான் என் மக்களைப் பாதுகாத்துக் கொண்டிருப்பதால்,","poem":1},{"text":"ஒடுக்குவோர் யாரும் திரும்பவும் ஒருபோதும் என் மக்களை மேற்கொள்ளமாட்டார்கள்.","poem":2}]},{"type":"heading","content":["சீயோன் அரசனின் வருகை"]},{"type":"verse","number":9,"content":[{"text":"சீயோன் மகளே, நீ மிகவும் களிகூரு.","poem":1},{"text":"எருசலேம் மகளே, நீ ஆர்ப்பரி.","poem":2},{"text":"இதோ பார், உன் அரசர் உன்னிடம் வருகிறார்.","poem":1},{"text":"அவர் நீதியுள்ளவராய் இரட்சிப்புடன் வருகிறார்,","poem":2},{"text":"தாழ்மையுள்ள அவர், கழுதையின்மேலும்,","poem":1},{"text":"கழுதைக் குட்டியான மறியின்மேலும் ஏறி வருகிறார்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எப்பிராயீமிலிருந்து தேர்களையும்,","poem":1},{"text":"எருசலேமிலிருந்து போர்க் குதிரைகளையும் அகற்றிவிடுவேன்.","poem":2},{"lineBreak":true},{"text":"யுத்த வில்லும் முறிக்கப்படும்.","poem":2},{"text":"உன் அரசர் நாடுகளுக்குச் சமாதானத்தை அறிவிப்பார்;","poem":1},{"text":"அவரது ஆட்சி ஒரு கடல் தொடங்கி, மறுகடல் வரையும்,","poem":2},{"lineBreak":true},{"text":"ஐபிராத்து நதிதொடங்கி, பூமியின் எல்லைகள் வரைக்கும் பரந்திருக்கும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"சீயோனே உனக்கோவெனில், உன்னுடன் நான் செய்துகொண்ட","poem":1},{"text":"என் உடன்படிக்கையின் இரத்தத்தின் நிமித்தம்,","poem":2},{"lineBreak":true},{"text":"தண்ணீரில்லாத குழியில் அடைபட்டுள்ள உன் கைதிகளை விடுதலை செய்வேன்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"நம்பிக்கையுள்ள கைதிகளே, உங்கள் கோட்டைக்குத் திரும்புங்கள்.","poem":1},{"text":"நீங்கள் இழந்தவற்றை இரண்டு மடங்காகத் திரும்பவும் தருவேன்","poem":2},{"lineBreak":true},{"text":"என நான் இப்பொழுதும் உங்களுக்கு அறிவிக்கிறேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"நான் எனது வில்லை வளைப்பது போல், யூதாவை வளைத்து,","poem":1},{"text":"எப்பிராயீமை அதன் அம்பாக வைப்பேன்;","poem":2},{"text":"சீயோனே, உன் மகன்களை நான் எழுப்புவேன்.","poem":1},{"text":"கிரேக்க நாடே, அவர்களை உன் மகன்களுக்கு விரோதமாய் அனுப்புவேன்.","poem":2},{"lineBreak":true},{"text":"என் மக்களைப் போர்வீரனின் வாளைப்போல் ஆக்குவேன்.","poem":2}]},{"type":"heading","content":["யெகோவா காட்சி கொடுப்பார்"]},{"type":"verse","number":14,"content":[{"text":"அப்பொழுது யெகோவா தமது மக்களுக்கு மேலாகக் காட்சியளிப்பார்;","poem":1},{"text":"அவரது அம்பு மின்னலைப்போல் விரையும்.","poem":2},{"text":"ஆண்டவராகிய யெகோவா எக்காளத் தொனியை எழுப்புவார்.","poem":1},{"text":"அவர் தென்திசைச் சுழல் காற்றில் கெம்பீரமாய் வருவார்.","poem":2}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"சேனைகளின் யெகோவா தன் மக்களின் கேடகமாய் நின்று பாதுகாப்பார்.","poem":2},{"text":"அவர்கள் தமது பகைவர்களை அழித்து,","poem":1},{"text":"கவண் கற்களால் தாக்கி வெற்றி பெறுவார்கள்.","poem":2},{"text":"அப்பொழுது அவர்கள் திராட்சை மதுவினால் வெறிகொண்டவர்களைப்போல் ஆரவாரிப்பார்கள்.","poem":1},{"text":"பலிபீடத்தின் மூலைகளில் தெளிப்பதற்கு பயன்படுத்தப்படும் கிண்ணத்தைப்போல்","poem":2},{"lineBreak":true},{"text":"அவர்கள் நிரம்பியிருப்பார்கள்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"தமது மக்களின் மந்தையைப்போல, அந்த நாளில்,","poem":1},{"text":"அவர்களுடைய இறைவனாகிய யெகோவா அவர்களைப் பாதுகாப்பார்.","poem":2},{"text":"கிரீடத்தில் பதிக்கப்பட்ட மாணிக்கக் கற்களைப்போல,","poem":1},{"text":"அவரது நாட்டில் அவர்கள் மின்னுவார்கள்.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"அவர்கள் எவ்வளவு கவர்ச்சியும் அழகுமாய் இருப்பார்கள்!","poem":1},{"text":"தானியமும், புதிய திராட்சை இரசமும்","poem":2},{"lineBreak":true},{"text":"வாலிபரையும் இளம்பெண்களையும் ஊக்கமாய் வளர்க்கும்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ZEC/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ZEC/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ZEC/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}