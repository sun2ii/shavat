{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ZEP","translationId":"tam_tcv","name":"செப்பனியா","commonName":"செப்பனியா","title":"செப்பனியா","order":36,"numberOfChapters":3,"sha256":"0295f413e12641e7b37b721e1c1462dc71bc2aa163f9d434a715a768d0ef9d4b","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["யூதாவின் அரசனான ஆமோனின் மகன் யோசியாவின் ஆட்சிக்காலத்தில், யெகோவாவின் வார்த்தை செப்பனியாவுக்கு வந்தது. செப்பனியா கூசியின் மகன், கூசி கெதலியாவின் மகன், கெதலியா அமரியாவின் மகன், அமரியா எசேக்கியாவின் மகன்."]},{"type":"line_break"},{"type":"heading","content":["வரப்போகும் அழிவைப்பற்றிய எச்சரிக்கை"]},{"type":"verse","number":2,"content":[{"text":"“பூமியின் மேற்பரப்பில் காணப்படும் அனைத்தையும்,","poem":1},{"text":"நான் வாரிக்கொண்டு போவேன்”","poem":2},{"lineBreak":true},{"text":"என யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"“நான் மனிதர்களையும், மிருகங்களையும் வாரிக்கொண்டு போவேன்;","poem":1},{"text":"நான் ஆகாயத்துப் பறவைகளையும்,","poem":2},{"lineBreak":true},{"text":"கடலின் மீன்களையும்","poem":2},{"lineBreak":true},{"text":"வாரிக்கொண்டு போவேன்.”","poem":2},{"lineBreak":true},{"text":"“நான் பூமியின் மேற்பரப்பிலிருந்து மனிதர்களை அகற்றும்போது,","poem":1},{"text":"கொடியவர்களையும் அவர்களுடைய தெய்வங்களையும் அழிப்பேன்”","poem":2},{"lineBreak":true},{"text":"என்று யெகோவா அறிவிக்கிறார்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"நான் யூதாவுக்கு எதிராகவும், எருசலேமில் வாழும்","poem":1},{"text":"அனைவருக்கு எதிராகவும் என் கையை நீட்டுவேன்;","poem":2},{"text":"நான் இந்த இடத்திலிருந்து பாகால் வணக்கத்தின்","poem":1},{"text":"மீதியான எல்லாவற்றையும் அகற்றுவேன்.","poem":2},{"text":"விக்கிரக வணக்கத்தில் ஈடுபடுகிறவர்களையும் அவர்களுடைய பூசாரிகளையும்","poem":1},{"text":"அவர்களுடைய பெயர்களே இல்லாமல் போகும்படி அழிப்பேன்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"நட்சத்திரக் கூட்டங்களை வணங்குவதற்காக,","poem":1},{"text":"வீட்டின் மேல்மாடங்களில் விழுந்து வணங்குகிறவர்களையும் அகற்றுவேன்.","poem":2},{"text":"யெகோவாவை விழுந்து வழிபட்டும், அவர் பேரில் ஆணையிடுவதோடு,","poem":1},{"text":"மோளேக்கு தெய்வத்தின் பெயரிலும் ஆணையிடுகிறவர்களை அகற்றுவேன்.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"யெகோவாவைப் பின்பற்றுவதிலிருந்து பின்வாங்கியவர்களையும்,","poem":1},{"text":"யெகோவாவின் ஆசீர்வாதத்தைத் தேடாமலும்,","poem":2},{"lineBreak":true},{"text":"அவரிடமிருந்து ஆலோசனைக் கேட்டு அறியாமல் இருப்பவர்களையும் அகற்றுவேன்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"ஆண்டவராகிய யெகோவாவுக்கு முன்பாக மவுனமாயிருங்கள்.","poem":1},{"text":"ஏனெனில் யெகோவாவின் நாள் சமீபமாயுள்ளது.","poem":2},{"text":"யெகோவா ஒரு பலியை ஆயத்தம் செய்திருக்கிறார்.","poem":1},{"text":"அவர் தாம் அழைத்திருக்கிறவர்களைப் பரிசுத்தப்படுத்தியிருக்கிறார்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"யெகோவாவினுடைய பலியின் நாளில்,","poem":1},{"text":"நான் பிரபுக்களையும்,","poem":2},{"lineBreak":true},{"text":"இளவரசர்களையும்,","poem":2},{"text":"பிற நாட்டவரின் பழக்கவழக்கங்களைப்","poem":1},{"text":"பின்பற்றுகிறவர்களையும் தண்டிப்பேன்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"அந்நாளில் போலியான தெய்வங்களை வணங்கி,","poem":1},{"text":"அதன் வழிபாட்டில் பங்குகொள்கிறவர்களைத் தண்டிப்பேன்.","poem":2},{"text":"அவர்கள் தங்கள் தெய்வங்களின் கோயில்களை","poem":1},{"text":"வன்முறையாலும் வஞ்சனையினாலும் நிரப்புகிறார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"யெகோவா அறிவிக்கிறதாவது:","poem":1},{"text":"அந்த நாளில் எருசலேம் மதிலிலுள்ள","poem":2},{"text":"மீன் வாசலில் இருந்து அழுகை கேட்கும்.","poem":1},{"text":"அந்த நகரத்தின் புதிய பகுதியிலிருந்து புலம்பலும்,","poem":2},{"lineBreak":true},{"text":"குன்றுகளிலிருந்து அது இடிந்துவிழும் சத்தமும் உண்டாகும்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"எருசலேமின் சந்தைப் பகுதியில் வாழும் மக்களே;","poem":1},{"text":"அழுது புலம்புங்கள், உங்கள் வர்த்தகர் எல்லோரும் அழிந்துபோவார்கள்.","poem":2},{"lineBreak":true},{"text":"வெள்ளி வியாபாரிகள் யாவரும் பாழாய்ப் போவார்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"அந்த வேளையில் நான் எருசலேமில் விளக்குகளைக்கொண்டு தேடுவேன்.","poem":1},{"text":"யெகோவா நன்மையோ தீமையோ ஒன்றும் செய்யவில்லை என்று சொல்லி,","poem":2},{"lineBreak":true},{"text":"ஏனோ தானோ என்று இருப்பவர்களைத் தண்டிப்பேன்.","poem":2},{"text":"அவர்கள் திராட்சை மதுவின்","poem":1},{"text":"மண்டியைப்போல் இருக்கிறார்கள்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"அவர்களுடைய செல்வம் சூறையாடப்படும்,","poem":1},{"text":"வீடுகள் உடைத்து அழிக்கப்படும்.","poem":2},{"text":"அவர்கள் வீடுகளைக் கட்டுவார்கள்,","poem":1},{"text":"அதில் அவர்கள் குடியிருக்கமாட்டார்கள்,","poem":2},{"text":"திராட்சைத் தோட்டத்தை நாட்டுவார்கள்.","poem":1},{"text":"அதன் திராட்சரசத்தைக் குடிக்கமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"யெகோவாவின் பெரிய நாள் சமீபித்துள்ளது;","poem":1},{"text":"அது மிக சமீபமாய் இருந்து விரைவாய் வருகிறது.","poem":2},{"text":"கேளுங்கள்! யெகோவாவின் நாளில் ஏற்படும் அழுகை மிகவும் கசப்பாயிருக்கும்.","poem":1},{"text":"இராணுவவீரருங்கூட கூக்குரலிடுவார்கள்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"அந்த நாள் கடுங்கோபத்தின் நாள்,","poem":1},{"text":"துன்பமும் வேதனையும் நிறைந்த நாள்,","poem":2},{"text":"தொல்லையும் அழிவுமான நாள்,","poem":3},{"text":"அது இருளும் அந்தகாரமுமான நாள்.","poem":2},{"text":"மப்பும் மந்தாரமுமான நாள்.","poem":3}]},{"type":"verse","number":16,"content":[{"text":"அரணான நகரங்களுக்கு எதிராகவும்,","poem":2},{"text":"மூலைக் கோபுரங்களுக்கு எதிராகவும்","poem":1},{"text":"எக்காள சத்தமும் போர் முரசும் எழுப்பப்படும் நாள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"மக்கள் யெகோவாவுக்கு எதிராகப் பாவம் செய்ததால்,","poem":1},{"text":"நான் அவர்கள்மேல் துன்பத்தை வரப்பண்ணுவேன்;","poem":2},{"lineBreak":true},{"text":"அவர்கள் குருடரைப்போல் தட்டித் தடவி நடப்பார்கள்.","poem":2},{"text":"அவர்களுடைய இரத்தம் புழுதியில் ஊற்றப்படும்.","poem":1},{"text":"அவர்களுடைய குடல்கள் சாணத்தைப்போல் நிலத்தில் கொட்டப்படும்.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"யெகோவாவினுடைய கடுங்கோபத்தின் நாளிலே,","poem":1},{"text":"அவர்களுடைய வெள்ளியோ தங்கமோ","poem":2},{"lineBreak":true},{"text":"அவர்களைக் காப்பாற்றமாட்டாது.","poem":2},{"lineBreak":true},{"text":"அவருடைய வைராக்கியத்தின் நெருப்பினால்,","poem":1},{"text":"முழு உலகமும் சுட்டெரிக்கப்படும்.","poem":2},{"text":"ஏனெனில் அவர் பூமியில் வாழும் யாவருக்கும்","poem":1},{"text":"திடீரென ஒரு முடிவைக் கொண்டுவருவார்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ZEP/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ZEP/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/HAB/3.json","previousChapterAudioLinks":{},"numberOfVerses":18}