{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ZEP","translationId":"tam_tcv","name":"செப்பனியா","commonName":"செப்பனியா","title":"செப்பனியா","order":36,"numberOfChapters":3,"sha256":"0295f413e12641e7b37b721e1c1462dc71bc2aa163f9d434a715a768d0ef9d4b","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":2,"content":[{"type":"heading","content":["யூதாவும் எருசலேமும் தேசங்களுடன் நியாயந்தீர்க்கப்பட்டன"]},{"type":"heading","content":["யூதா மனந்திரும்ப அழைத்தல்"]},{"type":"verse","number":1,"content":[{"text":"யூதாவே, வெட்கங்கெட்ட தேசமே,","poem":1},{"text":"ஒன்றுசேருங்கள், ஒன்றாய் சேருங்கள்,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"நியமிக்கப்பட்ட காலம் வருமுன்பும்,","poem":1},{"text":"அந்த நாள் பதரைப்போல் வாரிக்கொள்ளப்படும் முன்பும்,","poem":2},{"text":"யெகோவாவின் பயங்கர கோபம்","poem":1},{"text":"உங்கள்மேல் இறங்கும் முன்பும்,","poem":2},{"text":"யெகோவாவின் கடுங்கோபத்தின் நாள்","poem":1},{"text":"வரும் முன்பும் ஒன்றுசேருங்கள்.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"நாட்டில் தாழ்மையுள்ளோரே,","poem":1},{"text":"யெகோவாவின் கட்டளைகளைச் செய்கிறவர்களே,","poem":2},{"text":"நீங்கள் எல்லோரும் யெகோவாவைத் தேடுங்கள்.","poem":1},{"text":"நியாயத்தைத் தேடுங்கள், மனத்தாழ்மையைத் தேடுங்கள்;","poem":2},{"lineBreak":true},{"text":"அப்பொழுது ஒருவேளை யெகோவாவின் கோபத்தின் நாளிலே நீங்கள் பாதுகாக்கப்படுவீர்கள்.","poem":2}]},{"type":"heading","content":["பெலிஸ்தியாவுக்கு எதிரானது"]},{"type":"verse","number":4,"content":[{"text":"காசா கைவிடப்படும்,","poem":1},{"text":"அஸ்கலோன் பாழாக விடப்படும்.","poem":2},{"text":"அஸ்தோத் நண்பகலில் வெறுமையாக்கப்படும்,","poem":1},{"text":"எக்ரோன் வேரோடு பிடுங்கப்படும்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"கடற்கரை அருகே வாழும் கிரேத்திய மக்களே,","poem":1},{"text":"உங்களுக்கு ஐயோ கேடு;","poem":2},{"text":"பெலிஸ்தியரின் நாடாகிய கானானே,","poem":1},{"text":"யெகோவாவின் வார்த்தை உனக்கு எதிராக இருக்கிறது.","poem":2},{"text":"“நான் உன்னை அழிப்பேன்,","poem":1},{"text":"ஒருவரும் அங்கு தப்பியிருக்கமாட்டார்கள்.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"கிரேத்தியர் வாழும் கடற்கரை நாடு,","poem":1},{"text":"இடையர்களுக்கும் செம்மறியாடுகளின்","poem":2},{"lineBreak":true},{"text":"தொழுவங்களுக்கும் உரிய இடமாகும்.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"அது யூதா குடும்பத்தில் மீதியாயிருப்பவர்களுக்கு உரியதாகும்.","poem":1},{"text":"அங்கு அவர்கள் மேய்ச்சலைக் கண்டுகொள்வார்கள்.","poem":2},{"lineBreak":true},{"text":"அவர்கள் மாலை வேளைகளில்,","poem":2},{"text":"அஸ்கலோனிலுள்ள வீடுகளில் படுத்திருப்பார்கள்.","poem":1},{"text":"அவர்களின் இறைவனாகிய யெகோவா,","poem":2},{"text":"அவர்களில் கரிசனையாயிருப்பார்;","poem":1},{"text":"அவர்கள் இழந்த செல்வங்களை அவர்களுக்குத் திரும்பவும் கொடுப்பார்.","poem":2}]},{"type":"heading","content":["மோவாபியருக்கும், அம்மோனியருக்கும் எதிரானது"]},{"type":"verse","number":8,"content":[{"text":"மோவாபியரின் இழிவுகளையும்,","poem":1},{"text":"அம்மோனியரின் நிந்தனைகளையும் நான் கேட்டேன்.","poem":2},{"text":"அவர்கள் என் மக்களை இழிவாய் பேசி,","poem":1},{"text":"அவர்களின் நாட்டிற்கெதிராக பயமுறுத்தல்களை ஏற்படுத்தினார்கள்.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"ஆகவே, இஸ்ரயேலின் இறைவனாகிய","poem":1},{"text":"சேனைகளின் யெகோவா சொல்கிறதாவது,","poem":2},{"lineBreak":true},{"text":"நான் வாழ்வது நிச்சயம்போலவே,","poem":2},{"text":"மோவாப் நாடு சோதோமைப் போலவும்,","poem":1},{"text":"அம்மோனியரின் நாடு கொமோராவைப் போலாவதும் நிச்சயம்.","poem":2},{"text":"அவை என்றென்றும் களைகள் வளரும் இடமாகவும்,","poem":1},{"text":"உப்புப் பள்ளங்களாகவும், பாழிடமாகவும் காணப்படும்.","poem":2},{"text":"என் மக்களில் மீதியாயிருப்போர் அவர்களைக் கொள்ளையடிப்பார்கள்.","poem":1},{"text":"என் நாட்டில் தப்பியவர்கள் அவர்கள் நாட்டைத் தங்கள் உரிமையாக்கிக்கொள்வார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"சேனைகளின் யெகோவாவின் மக்களை இகழ்ந்து,","poem":1},{"text":"கேலி செய்த அவர்களின் அகந்தைக்குப் பதிலாக,","poem":2},{"lineBreak":true},{"text":"அவர்களுக்குக் கிடைப்பது இதுவே.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"யெகோவா நாட்டிலுள்ள தெய்வங்களையெல்லாம் அழிக்கும்போது,","poem":1},{"text":"அவர் அவர்களுக்கு ஒரு பெரும் பயங்கரமாய் இருப்பார்.","poem":2},{"text":"அப்பொழுது பூமியெங்குமுள்ள நாடுகளும் யெகோவாவை ஆராதிப்பார்கள்.","poem":1},{"text":"ஒவ்வொருவரும் தன்தன் சொந்த நாட்டிலிருந்து அவரை வழிபடுவார்கள்.","poem":2}]},{"type":"heading","content":["கூஷ்"]},{"type":"verse","number":12,"content":[{"text":"எத்தியோப்பியரே,","poem":1},{"text":"நீங்களும் என் வாளுக்கு இரையாவீர்கள்.","poem":2}]},{"type":"heading","content":["அசீரியாவுக்கு எதிரானது"]},{"type":"verse","number":13,"content":[{"text":"அவர் தன் கையை வடக்கிற்கு எதிராக நீட்டி,","poem":1},{"text":"அசீரியாவை அழிப்பார்,","poem":2},{"text":"நினிவேயை அவர் முற்றிலும் பாழாக்கி,","poem":1},{"text":"பாலைவனத்திற்கு ஒப்பான பாழ்நிலமாக்குவார்.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"அங்கே ஆட்டு மந்தையும் மாட்டு மந்தையும் படுத்திருக்கும்.","poem":1},{"text":"எல்லா விதமான விலங்குகளும் அங்கே படுத்திருக்கும்.","poem":2},{"text":"பாலைவன ஆந்தையும், கீச்சிடும் ஆந்தையும்","poem":1},{"text":"அதன் தூண்களில் தங்கியிருக்கும்.","poem":2},{"text":"அவற்றின் சத்தம் ஜன்னல்களின் வழியாக எதிரொலிக்கும்.","poem":1},{"text":"வாசல்களில் இடிபாடுகள் குவிந்து கிடக்கும்.","poem":2},{"lineBreak":true},{"text":"கேதுரு மரத்தினாலான உத்திரங்கள் வெளியே தெரியும்.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"“நான்தான், என்னைத்தவிர வேறொருவரும் இல்லை.”","poem":1},{"text":"என தனக்குள் சொல்லிக்கொண்டு,","poem":2},{"text":"பாதுகாப்புடன் கவலையின்றி வாழ்ந்த நினிவே நகரம் இதுவோ.","poem":1},{"text":"இது எவ்வளவாய்ப் பாழடைந்து,","poem":2},{"text":"காட்டு மிருகங்களுக்குப் தங்குமிடமாயிற்று!","poem":1},{"text":"அதைக் கடந்துசெல்கிறவர்கள்,","poem":2},{"text":"கைகளைத் தட்டி,","poem":1},{"text":"கேலி செய்வார்கள்.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ZEP/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/ZEP/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ZEP/1.json","previousChapterAudioLinks":{},"numberOfVerses":15}