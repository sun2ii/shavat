{"translation":{"id":"tam_tcv","name":"Biblica® திறந்தநிலை தமிழ் சமகால பதிப்பு","website":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tamtcv","licenseNotes":null,"shortName":"TCV","englishName":"Biblica® திறநதநிலை தமிழ சமகால பதிபபு","language":"tam","textDirection":"ltr","sha256":"9b22cd9b2048f40d9cc8f6a5c9681431938fa92dce1c415c938a0f1e5281b4cd","availableFormats":["json"],"listOfBooksApiLink":"/api/tam_tcv/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31102,"languageName":"தமிழ்","languageEnglishName":"Tamil"},"book":{"id":"ZEP","translationId":"tam_tcv","name":"செப்பனியா","commonName":"செப்பனியா","title":"செப்பனியா","order":36,"numberOfChapters":3,"sha256":"0295f413e12641e7b37b721e1c1462dc71bc2aa163f9d434a715a768d0ef9d4b","firstChapterNumber":1,"firstChapterApiLink":"/api/tam_tcv/ZEP/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tam_tcv/ZEP/3.json","totalNumberOfVerses":53},"chapter":{"number":3,"content":[{"type":"heading","content":["எருசலேமின் எதிர்காலம்"]},{"type":"verse","number":1,"content":[{"text":"கலகம் செய்கிறவர்களும், கறைப்பட்டவர்களும்,","poem":1},{"text":"அடக்கி ஒடுக்குகிறவர்களும் வாழும் நகரமே! உனக்கு ஐயோ கேடு.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"அவள் ஒருவருக்கும் கீழ்ப்படிய மாட்டாள்,","poem":1},{"text":"அவள் எந்த சீர்திருத்தத்தையும் ஏற்றுக்கொள்ள மாட்டாள்.","poem":2},{"text":"அவள் யெகோவாவை நம்புவதில்லை,","poem":1},{"text":"அவள் தனது இறைவனிடத்தில் நெருங்குவதுமில்லை.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"அவளுடைய அதிகாரிகள்","poem":1},{"text":"கெர்ச்சிக்கும் சிங்கங்கள்.","poem":2},{"text":"அவளுடைய ஆளுநர்கள் மாலை நேரத்து ஓநாய்கள்.","poem":1},{"text":"காலைப்பொழுதிற்காக ஒன்றையும் விட்டுவைக்காத ஓநாய்கள்.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"அவளுடைய இறைவாக்கினர் அகந்தை உடையவர்கள்;","poem":1},{"text":"அவர்கள் துரோகிகள்.","poem":2},{"text":"அவளுடைய ஆசாரியர்கள் பரிசுத்த இடத்தை கறைப்படுத்தி,","poem":1},{"text":"சட்டத்தை மீறுகிறார்கள்.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"இன்னும் அவள் நடுவில் இருக்கும் யெகோவா நீதியுள்ளவர்;","poem":1},{"text":"அவர் அநியாயம் செய்வதில்லை;","poem":2},{"text":"அவர் காலைதோறும் தமது நீதியை வெளிப்படுத்துகிறார்.","poem":1},{"text":"அவர் ஒவ்வொரு புதிய நாளிலும் தவறாமல் அதை வெளிப்படுத்துகிறார்,","poem":2},{"text":"ஆயினும் நீதியற்றவர்கள் தங்கள் தீமையில் தொடர்ந்து ஈடுபடுகிறார்கள்;","poem":1},{"text":"அவர்கள் வெட்கத்தை அறியமாட்டார்கள்.","poem":2}]},{"type":"heading","content":["எருசலேம் மனந்திரும்பாமல் உள்ளது"]},{"type":"verse","number":6,"content":[{"text":"நான் நாடுகள் பலவற்றை முழுவதும் தண்டித்துப்போட்டேன்;","poem":1},{"text":"அவர்களின் கோட்டைகள் அழிக்கப்பட்டுவிட்டன.","poem":2},{"text":"நான் அவர்களின் வீதிகளில் யாரும் கடந்துபோகாதபடி,","poem":1},{"text":"அவற்றை வெறிச்சோடப் பண்ணினேன்.","poem":2},{"text":"அவர்களுடைய பட்டணங்கள் அழிக்கப்பட்டன;","poem":1},{"text":"ஒருவரும் மீந்திருக்கவில்லை. நடந்ததைச் சொல்வதற்குக்கூட ஒருவருமே இல்லை.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"எனவே நான் எருசலேம் பட்டணத்தைப் பார்த்து,","poem":1},{"text":"“நிச்சயமாக நீ என்னில் பயமுள்ளவளாயிரு,","poem":2},{"lineBreak":true},{"text":"என் சீர்திருத்தலை ஏற்றுக்கொள்!” என்று சொன்னேன்.","poem":2},{"text":"அப்போது அவளுடைய குடியிருப்பு அகற்றப்படுவதில்லை.","poem":1},{"text":"என் தண்டனைகள் எல்லாம் அவள்மேல் வருவதில்லை என நான் எண்ணினேன்.","poem":2},{"text":"ஆனால் அவர்களோ தாங்கள் செய்த எல்லாத் தீமையான செயல்கள்மீதும்,","poem":1},{"text":"இன்னும் வாஞ்சையாயிருந்தார்கள்.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"ஆகவே, “நான் எழுந்து குற்றஞ்சுமத்தும் நாள் வருமளவும்","poem":1},{"text":"நீ எனக்காகக் காத்திரு” என்று யெகோவா அறிவிக்கிறார்.","poem":2},{"text":"நான் எல்லா நாடுகளையும்","poem":1},{"text":"அரசுகளையும் ஒன்றுகூட்டி,","poem":2},{"text":"என் கடுங்கோபத்தை","poem":1},{"text":"அவர்கள்மேல் ஊற்றுவதற்குத் தீர்மானித்துள்ளேன்.","poem":2},{"text":"அப்பொழுது என் வைராக்கியமான கோபத்தின் நெருப்பினால்","poem":1},{"text":"முழு உலகமும் சுட்டெரிக்கப்படும்.","poem":2}]},{"type":"heading","content":["இஸ்ரயேலின் சிதறியதாக மறுசீரமைப்பு"]},{"type":"verse","number":9,"content":[{"text":"நான் அவ்வேளையில் மக்கள் கூட்டங்களின் உதடுகளைத் தூய்மைப்படுத்துவேன்.","poem":1},{"text":"அவர்கள் யாவரும், யெகோவாவின் பெயரை வழிபட்டு,","poem":2},{"lineBreak":true},{"text":"தோளுக்குத் தோள்கொடுத்து பணிசெய்வார்கள்.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"எத்தியோப்பிய நதிகளுக்கு அப்பால் இருக்கிற என்னை ஆராதிக்கிறவர்களான,","poem":1},{"text":"சிதறுண்ட என் மக்கள்,","poem":2},{"lineBreak":true},{"text":"எனக்குக் காணிக்கைகளைக் கொண்டுவருவார்கள்.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"அந்த நாளில் தங்கள் பெருமையில் களிகூருகிற","poem":1},{"text":"அனைவரையும் இந்த பட்டணத்திலிருந்து அகற்றிப்போடுவேன்.","poem":2},{"text":"அதனால் நீங்கள் எனக்குச் செய்த எல்லா அநியாயங்களுக்காகவும்","poem":1},{"text":"நீங்கள் வெட்கப்பட மாட்டீர்கள்.","poem":2},{"text":"இனி ஒருபோதும் என் பரிசுத்த மலையில் நீங்கள்","poem":1},{"text":"அகந்தையுள்ளவர்களாய் இருக்கமாட்டீர்கள்.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"எனினும் யெகோவாவின் பெயரில் நம்பிக்கை கொண்டிருக்கிற,","poem":1},{"text":"சாந்தகுணமுள்ளோரையும்,","poem":2},{"text":"தாழ்மையுள்ளோரையும்","poem":1},{"text":"உன் பட்டணத்தின் நடுவில் மீதியாக விட்டுவைப்பேன்.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"இஸ்ரயேலில் மீந்திருப்போர்","poem":1},{"text":"அநியாயம் செய்யமாட்டார்கள்;","poem":2},{"text":"அவர்கள் பொய் பேசமாட்டார்கள்;","poem":1},{"text":"அவர்களின் வாயில் வஞ்சகம் காணப்படுவதுமில்லை.","poem":2},{"text":"அவர்கள் சாப்பிட்டு படுத்திருப்பார்கள்.","poem":1},{"text":"ஒருவரும் அவர்களைப் பயமுறுத்தமாட்டார்கள்.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"சீயோன் மகளே, பாடு; இஸ்ரயேலே,","poem":1},{"text":"பலமாய்ச் சத்தமிடு;","poem":2},{"text":"எருசலேம் மகளே,","poem":1},{"text":"உன் முழு உள்ளத்தோடும் மகிழ்ந்து களிகூரு.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"யெகோவா உன் தண்டனையை நீக்கிப்போட்டார்,","poem":1},{"text":"அவர் உன் பகைவரைத் துரத்திவிட்டார்.","poem":2},{"text":"இஸ்ரயேலின் அரசனாகிய யெகோவாவே உன்னுடன் இருக்கிறார்;","poem":1},{"text":"நீ இனி ஒருபோதும் எவ்வித தீங்கைக் குறித்தும் பயப்படமாட்டாய்.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"அந்த நாளில்","poem":1},{"text":"அவர்கள் எருசலேமைப் பார்த்துச் சொல்வதாவது,","poem":2},{"text":"“சீயோனே, பயப்படாதே;","poem":1},{"text":"உன் கைகளைச் சோர்ந்துபோக விடாதே.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"உன் இறைவனாகிய யெகோவா உன்னுடன் இருக்கிறார்.","poem":1},{"text":"அவர் உன்னை இரட்சிக்க வல்லவர்.","poem":2},{"text":"உன்னில் அவர் மகிழ்ந்து களிகூருவார்.","poem":1},{"text":"அவர் தம்முடைய அன்பினிமித்தம் உன்னைக் கடிந்துகொள்ளமாட்டார்.","poem":2},{"lineBreak":true},{"text":"அவர் உன்னைக்குறித்துப் பாடல்களுடன் மகிழ்வார்.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"“நியமிக்கப்பட்ட உங்கள் பண்டிகைகளை இழந்ததால் நீங்கள் அடைந்த துக்கத்தை,","poem":1},{"text":"நான் உங்களைவிட்டு நீக்குவேன்.","poem":2},{"lineBreak":true},{"text":"அவை உங்களுக்குப் பாரமாயும் நிந்தையாயும் இருக்கின்றன.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"அக்காலத்தில் உன்னை ஒடுக்கிய அனைவரையும் நான் தண்டிப்பேன்.","poem":1},{"text":"முடமானவர்களைத் தப்புவித்துச்","poem":2},{"text":"சிதறடிக்கப்பட்டவர்களை ஒன்றுசேர்ப்பேன்.","poem":1},{"text":"அவர்கள் வெட்கத்திற்குள்ளான","poem":2},{"text":"நாடுகளில் எல்லாம் அவர்களுக்குப் புகழ்ச்சியையும்,","poem":1},{"text":"மேன்மையையும் கொடுப்பேன்.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"அக்காலத்தில் நான் உங்களை ஒன்றுசேர்ப்பேன்;","poem":1},{"text":"அக்காலத்தில் நான் உங்களை உங்கள் வீட்டிற்குக் கொண்டுவருவேன்.","poem":2},{"text":"உங்கள் கண்களுக்கு முன்பாக நீங்கள் இழந்த செல்வங்களையும்","poem":1},{"text":"நாடுகடத்தப்பட்டு வந்த மக்களையும் நான் உங்களுக்குத் திருப்பிக் கொடுப்பேன்.","poem":2},{"text":"அப்போது பூமியின் மக்கள் அனைவருக்குள்ளும் உங்களுக்குப் புகழ்ச்சியையும்,","poem":1},{"text":"மேன்மையையும் கொடுப்பேன்","poem":2},{"lineBreak":true},{"text":"என யெகோவா சொல்கிறார்.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tam_tcv/ZEP/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tam_tcv/HAG/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tam_tcv/ZEP/2.json","previousChapterAudioLinks":{},"numberOfVerses":20}