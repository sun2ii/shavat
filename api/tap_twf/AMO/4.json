{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"AMO","translationId":"tap_twf","name":"AMOSI","commonName":"AMOSI","title":"KITABU KYAKUA AMOSI","order":30,"numberOfChapters":9,"sha256":"e70fe1e4d383708fcb0c7bf0e4b3ff9ea07650f92ed27756bee6aae22aa62869","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tap_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":4,"content":[{"type":"verse","number":1,"content":[{"text":"Twilizie kaka keebo mwe banakazi ba pa lupili lwa Samaria, mwe bali nga nghombe ya ku Basani,","poem":1},{"text":"mwe balibabiibikizia bapabi, ni mwe balibakita bibiipile ku babulilue,","poem":2},{"lineBreak":true},{"text":"ni kubaana balume benu nangue “tupeele bikolani!”","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawe Kabezia Mpungu waalaile mu buzuuke bwakue nangue,","poem":1},{"text":"“Kisinka musita ulimukwiza","poem":2},{"text":"lubakaba kumifumia na ndobaano,","poem":1},{"text":"ni basyelepo pakati kenu baakaba kulobua na ndobaano nga lisabi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mwaakafumiziwa lya palia patutikile bibumba,","poem":1},{"text":"mwakapoozua panze lya ku Harmoni,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Endo ku Beteli, muye mubale kibalo,","poem":1},{"text":"endo ku Gilgali, mulunduluke kubala.","poem":2},{"text":"Leete ngelelo yenu kubalua lukeelekeele,","poem":1},{"text":"kamo ka pa lyanondo mu nsiku itatu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Zizie mukate ututumukile nga ngelelo ya kusantila,","poem":1},{"text":"iitasie palua bupe bumulimwapeela mu kutona kwenu,","poem":2},{"text":"iitantamune palua bebio byabupe mwe Baizraeli","poem":1},{"text":"pantu bebi i bimutonene kukita,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe Kabezia Mpungu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"“Naaleetele kimina kya nzala mu mizi yenu yonse,","poem":1},{"text":"ni kubulua kwa bilio mu kubalua muzi.","poem":2},{"lineBreak":true},{"text":"Anzia kyaali evio temwambweleele,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Ntanzi ya kufikiila kuzombola,","poem":1},{"text":"nsyaamipeele nvula pa myezi itatu.","poem":2},{"text":"Naanokiizie nvula mu muzi umo,","poem":1},{"text":"inzi mu unge muzi nsyaanokiiziemo.","poem":2},{"text":"Nvula yaanokeele mu bukaba bumo,","poem":1},{"text":"mu bunge mwaasyele mwaumine pantu nsyanokiiziemo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Bantu baendookele mu mizi ni mizi balimukukeba menda a kumina","poem":1},{"text":"inzi tebasangilemo a kubakumana.","poem":2},{"lineBreak":true},{"text":"Anzia kyaali evio, temwambweleele,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Lingi nainoonene makaba enu ni makaba a mizabibu,","poem":1},{"text":"naumiizie bimuti na mwela wa lyuza.","poem":2},{"text":"Luzie lwaaliile bilimbua byonse bya mu makaba enu ni bimuti bya mizeituni.","poem":1},{"text":"Anzia kyaali evio, temwambweleele,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Naatumine kimina pakati kenu,","poem":1},{"text":"nga vinaakitile ku Bamisri.","poem":2},{"text":"Naipaile baana benu balumendo na kipanga.","poem":1},{"text":"Naamipokele farasi yenu.","poem":2},{"text":"Naizuziizie myona yenu na bunu bwa mibili ibolele mu mitanda yenu.","poem":1},{"text":"Anzia kyaali evio, temwambweleele,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"verse","number":11,"content":["“Nainoonene bamo pakati kenu",{"text":"nga evelia vinainoonene Sodoma ni Gomora.","poem":2},{"text":"Naamisomwene nga kakooko ka-apulua pa mulilo.","poem":1},{"text":"Anzia kyaali evio, temwambweleele,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Ni pakako, evi i vinaakamikitila mwe Baizraeli!","poem":1},{"text":"Kabili pantu naakamikitila evio mwe Baizraeli,","poem":2},{"lineBreak":true},{"text":"iiteanie kusaakaana ni Leza wenu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Olia waabumbile mpili","poem":1},{"text":"ni waalengele mwela,","poem":2},{"lineBreak":true},{"text":"olia aliwafyula malanga akue ku bantu,","poem":2},{"text":"aliwa-alula lukeelekeele kuba nfinzi","poem":1},{"text":"ni kwenda pa kyalo pa nkendo ilendukile,","poem":2},{"lineBreak":true},{"text":"Yawe, Leza wa Maka onse, i Liina lyakue.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/AMO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/AMO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/AMO/3.json","previousChapterAudioLinks":{},"numberOfVerses":13}