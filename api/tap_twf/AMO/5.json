{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"AMO","translationId":"tap_twf","name":"AMOSI","commonName":"AMOSI","title":"KITABU KYAKUA AMOSI","order":30,"numberOfChapters":9,"sha256":"e70fe1e4d383708fcb0c7bf0e4b3ff9ea07650f92ed27756bee6aae22aa62869","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tap_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":5,"content":[{"type":"heading","content":["Amosi wa-ana bantu balapile"]},{"type":"verse","number":1,"content":["Mwe Baizraeli, twilizie totu twebo twa lwimbo lwa malilo lundimukumimbila."]},{"type":"verse","number":2,"content":[{"text":"“Kinundue Izraeli aponene,","poem":1},{"text":"takikabuuka,","poem":2},{"text":"waasiilue waleele pansi,","poem":1},{"text":"tekuli wa kumukwasia kubuuka.”","poem":2}]},{"type":"verse","number":3,"content":["Yawe Kabezia Mpungu wa-ana Baizraeli nangue,",{"text":"“Muzi waakatuma balukale 1,000 ku bului,","poem":1},{"text":"kwaakabwela sie balukale 100.","poem":2},{"text":"Muzi waakatuma balukale 100 ku bului,","poem":1},{"lineBreak":true},{"text":"kwaakabwela sie balukale lyanondo.”","poem":1}]},{"type":"verse","number":4,"content":["Yawe wabaana Baizraeli nangue,",{"text":"“Nkebe mube ni bukose.","poem":1}]},{"type":"verse","number":5,"content":[{"text":"Tekunkebe ku Beteli,","poem":2},{"text":"tekuye ku Gilgali,","poem":1},{"text":"tekwabuke kuya ku Bersheba.","poem":2},{"text":"Pantu Gilgali, kisinka waakaya mu buzia.","poem":1},{"text":"Ni Beteli waaka-alulua kuba mpuni.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mukebe Yawe mube ni bukose,","poem":1},{"text":"kine te evio, Yawe waakapyanga bantu ba mu nghanda yakua Yusufu nga mulilo.","poem":2},{"text":"Ozo mulilo waakazizia Beteli,","poem":1},{"text":"tekuli muntu waakauzimia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Lisyamo lyenu mwe baliba-alulula nsambu kuba bwimba bululile,","poem":1},{"text":"ni kupooza nsambu pansi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Olia waakitile Bulimina ni Kipindabusiku pamo ni Orioni,","poem":1},{"text":"olia aliwa-alulula nfinzi kuba lukeelekeele,","poem":2},{"lineBreak":true},{"text":"ni musita wa koba kuba busiku,","poem":2},{"text":"olia aliwakuuta menda a lyezi ni ku-etila pa kyalo,","poem":1},{"text":"Liina lyakue i Yawe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Aliwainoona nghanda lubilo lubilo,","poem":1},{"text":"ni kutuuta byubo bya mizi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Basuulile olia aliwasasililana mu kilie,","poem":1},{"text":"baleebwile olia aliwalanda kisinka.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mulimwaabiibikizia bapabi,","poem":1},{"text":"ni kubeebila buzombozi mu kusonkia musonko.","poem":2},{"text":"Ni pakako, anzia kine mwaakuulile nghanda ya mabue,","poem":1},{"text":"temukeekalamo.","poem":2},{"text":"Anzia kine mwaalimine bukaba bwa mizabibu,","poem":1},{"text":"temukamina divai ya mizabibu.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Pantu n'manine vivulile bilubo byenu","poem":1},{"text":"ni vitanine bibalo byenu.","poem":2},{"lineBreak":true},{"text":"Mulimwaemia bantu basili na kilubo ni kupoka bituulilo,","poem":1},{"text":"kabili mulimwatana bapabi nsambu mu kilie.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Ni pakako, olia akengeele aliwatalala pa musita nga ozo,","poem":1},{"text":"pantu musita ubiipile.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Kite biweme, tekuba bibiipile,","poem":1},{"text":"evi mube ni bukose.","poem":2},{"text":"Ni Yawe Leza wa Maka onse waakaba pamo nenu","poem":1},{"text":"nga vimulimwalanda nangue pa-ali.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Suule bibiipile, tone biweme,","poem":1},{"text":"biike nsambu mu bilie.","poem":2},{"text":"Pange Yawe Leza wa Maka onse waakeeleela","poem":1},{"text":"bantu basyele bakosele ba mu luvyalo lwakua Yusufu.","poem":2}]},{"type":"verse","number":16,"content":["Ni pakako, Mulopue Yawe Leza wa Maka onse walanda evi,",{"text":"“Kwaakaba malilo mu misebo yonse,","poem":1},{"text":"kuloosia kwa bulanda mu kubalua kisaakaanino kya bantu.","poem":2},{"text":"Balimi baakakuutua kwiza kulila,","poem":1},{"text":"ni ba kuloosia bakeeza kuloosia.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mu makaba onse a mizabibu mwaakaba malilo.","poem":1},{"text":"Pantu naakeeza kupita pakati kenu,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"heading","content":["Busiku bwakua Yawe"]},{"type":"verse","number":18,"content":[{"text":"Lisyamo kuli mwe balibatokamua","poem":1},{"text":"busiku bwakua Yawe.","poem":2},{"text":"Mulimwatokaminuaki busiku bwakua Yawe?","poem":1},{"text":"Bobo busiku bwaakaba nfinzi, tekuba kisue.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Kyaakaba nga muntu wabutuka nkalamu,","poem":1},{"text":"wasaakaana na kimbui,","poem":2},{"text":"wapanda ku kimbui, waingila mu nghanda yakue, ni kukikilizia kuboko kwakue ku kibumba,","poem":1},{"text":"wasumua na nzoka.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Kubako busiku bwakua Yawe tebukaba nfinzi, pasili kuba kisue?","poem":1},{"text":"Kubako teikaba nfinzi ikata isili na minghenghe?","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"Yawe walanda nangue, “Nsuulile, ndeebwile nsikunkulu yenu ya mpupo,","poem":1},{"text":"nsiwamiinue na kulonghana kwenu.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Anzia kili evio, mulimwandeetela ngelelo ya kuzizia ni bupe bwa bunga","poem":1},{"text":"nsikabipokelela.","poem":2},{"text":"Anzia kine mulimwaleeta bupe bwa mutende,","poem":1},{"text":"nsikabukentako.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Lekele nsungu ya nghimbo yenu,","poem":2},{"lineBreak":true},{"text":"nsikatwilizia nghimbo ya bilimba byenu.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Inzi lekele nsambu ipongoke nga mwenzi,","poem":1},{"text":"bulunghami bube nga kaezi kasili kakama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":25,"content":[{"text":"“Kubako mwe Baizraeli, mwandeeteele ngelelo ni bupe","poem":1},{"text":"mu kaseeba mu elia myaka 40?","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mwakilendula kitale kyakua likolo wenu,","poem":1},{"text":"Sukoti kateeka leza wenu,","poem":2},{"lineBreak":true},{"text":"ni Kiuni leza wenu wa lutanda,","poem":2},{"lineBreak":true},{"text":"bamwaikitiile mwe bene.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Ni pakako, naakamitwala mu kyalo kya buzia, kule kupita ku Damaski,”","poem":1},{"text":"koku i kulanda kwakua Yawe, ali ni Liina lya Leza wa Maka onse.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/AMO/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/AMO/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/AMO/4.json","previousChapterAudioLinks":{},"numberOfVerses":27}