{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"AMO","translationId":"tap_twf","name":"AMOSI","commonName":"AMOSI","title":"KITABU KYAKUA AMOSI","order":30,"numberOfChapters":9,"sha256":"e70fe1e4d383708fcb0c7bf0e4b3ff9ea07650f92ed27756bee6aae22aa62869","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/AMO/1.json","lastChapterNumber":9,"lastChapterApiLink":"/api/tap_twf/AMO/9.json","totalNumberOfVerses":146},"chapter":{"number":9,"content":[{"type":"heading","content":["Bupinguzi bwakua Yawe"]},{"type":"verse","number":1,"content":["Naamwene Yawe waimeene mumbali kitale. Waalandile nangue,",{"text":"“Uma ku bisulo,","poem":1},{"text":"evi mapumpu atente.","poem":2},{"text":"Biponiizie pa mitue ya bantu bonse.","poem":1},{"text":"Ni balia baakasyalapo naakabeepaya na kipanga.","poem":2},{"text":"Tekuli muntu waakabutuka.","poem":1},{"text":"Tekuli waakapanda.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Anzia beimbila nzila ya kuya kumbo,","poem":1},{"text":"nakaba kubafumiamo na kuboko kwane.","poem":2},{"text":"Anzia basela mu myulu,","poem":1},{"text":"nakaba kubakoosiizia pansi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Anzia befiika peulu lupili lwa Karmeli,","poem":1},{"text":"nakaba kubakeba ni kubakwata.","poem":2},{"text":"Anzia banfyama kwinsina lyezi,","poem":1},{"text":"nakaba kwana kizoka kikabe kubasumina koko kwenka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Anzia batwalua ku buzia na balwani babo,","poem":1},{"text":"nakaba kulengia bakeepailue koko kwenka.","poem":2},{"lineBreak":true},{"text":"“Nakaba kuya nabakenteleele na menso ane,","poem":1},{"text":"pakuti n'mbakitile bibiipile tekuba biweme.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mulopue, Yawe wa Maka onse aliwakumia kyalo, ni kyo kilikyasunguluka.","poem":1},{"text":"Bonse bekeelemo balibaloosia.","poem":2},{"text":"Kyalo kyalingi kilikyalenduka ni kukooka nga mabimbi a Mwenzi wa Nile.","poem":1},{"text":"Ni pa kyamba kilikyakooka nga mabimbi a mwenzi wa ku Misri.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ozu Yawe aliwakuula nghanda yakue ya bukolo mu myulu","poem":1},{"text":"ni aliwaimika biputa byakue pa kyalo,","poem":2},{"text":"ozu aliwakuuta menda a mu lyezi","poem":1},{"text":"ni aliwa-etila pa kyalo,","poem":2},{"lineBreak":true},{"text":"Liina lyakue ni Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Yawe waipuzia evi, “Mwe Baizraeli!","poem":1},{"text":"Kubako nsimipendele nga vin'mpendele bantu ba ku Etyopia?”","poem":2},{"noteId":6},{"text":"“Kubako te nene waamifumiizie mu Misri?","poem":1},{"text":"Te nene waafumiizie Bafilistini ku Kaftori?","poem":2},{"lineBreak":true},{"text":"Te nene waafumiizie Bashamu ku Kiri?","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kisinka menso ane ne Yawe Kabezia Mpungu,","poem":1},{"text":"akentele pa bukolo bwa bibalo.","poem":2},{"text":"Nakaba kubwinoona pa kyalo,","poem":1},{"text":"inzi nsikeenoona nvyalo yonse yakua Yakobo,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"“Pantu naakafumia nsambu ya kuuluzia Baizraeli pa ntundu yonse,","poem":1},{"text":"naakabauluzia nga nghano iliyauluziiwa mu kipanda.","poem":2},{"lineBreak":true},{"text":"Tekuli lubezu lwa nghano lwaakaponena pansi.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Bantu bonse ba bibalo pa bantu bane,","poem":1},{"text":"baakeepawa na kipanga,","poem":2},{"text":"balia bonse balibalanda nangue,","poem":1},{"text":"‘Tetukasanzua.’","poem":2}]},{"type":"heading","content":["Kuwamiwa paakale pa kyamba kya kwinoonua"]},{"type":"verse","number":11,"content":["“Mu bobo busiku",{"text":"“naakabwezia nghanda iponene yakua Daudi,","poem":1},{"text":"naakawamia palia penoonekele,","poem":2},{"lineBreak":true},{"text":"naakeemika paakale bituuti byakue,","poem":2},{"lineBreak":true},{"text":"naakakuula paakale nga viyaali pa mambo,","poem":2}]},{"type":"verse","number":12,"content":[{"text":"evi Baizraeli bakapoke nkendo yaasyeleko mu kyalo kya Edomu,","poem":1},{"text":"pamo ni ntundu yane yonse,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe ozo waakakita bebi bintu.","poem":2}]},{"type":"verse","number":13,"content":["Yawe walanda evi,",{"text":"“Nsiku ilimukwiza, muzombozi lu-aliwaakaba wakitwaliile kuzombola","poem":1},{"text":"musita wa kulima wasyafikile,","poem":2},{"text":"ni aliwatika mizabibu lu-aliwaakaba wakitwaliilile kutika musita wa kulimba wasyafikile,","poem":1},{"lineBreak":true},{"text":"mpili yaakatoonia divai ya lenu,","poem":1},{"text":"ni tupili ni to twaakaipongola.","poem":2}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Naakafumia bantu bane, Baizraeli, mu buzia ni kubabwezia.","poem":2},{"lineBreak":true},{"text":"“Baakakuula paakale mizi ituutikile ni kwikalamo.","poem":1},{"text":"Baakalimba mizabibu ni kuminako divai.","poem":2},{"lineBreak":true},{"text":"Baakalima makaba ni kulia bibaakabyalamo.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Naakalimba Izraeli mu kyalo kyakue,","poem":1},{"text":"kabili tekuli muntu waakamunukula mu kyalo kinaamupeele,”","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe Leza wenu.","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"9.7 Etyopia: Leli liina mu Kiebrania ikulanda nangue Kushi","reference":{"chapter":9,"verse":7}}]},"thisChapterLink":"/api/tap_twf/AMO/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/OBA/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/AMO/8.json","previousChapterAudioLinks":{},"numberOfVerses":15}