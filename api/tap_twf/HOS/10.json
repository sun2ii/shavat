{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Izraeli waali muzabibu waali wakula bwino,","poem":1},{"text":"waali waseekako mazabo.","poem":2},{"text":"Nga vyaali vyavula mazabo akue,","poem":1},{"text":"i vi-aali wakila kukuula bitale.","poem":2},{"text":"Nga vyaali vyatwalilila kyalo kyakue,","poem":1},{"text":"i vi-aali wakila kufwaniizia mabue akue a mpupo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Mutima wabo ni wa bupompo,","poem":1},{"text":"ni evi bapalile kutwama bubi bwabo.","poem":2},{"text":"Yawe wakaba kutuuta bitale byabo","poem":1},{"text":"ni kwinoona mabue abo a mpupo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"I lubaakalanda nangue, “Tetuli na likolo","poem":1},{"text":"pantu tetwakimutiina Yawe.","poem":2},{"text":"Inzi anzia kine tubenge na likolo,","poem":1},{"text":"kubako nga waatukitiileki?”","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Balibalaya bulayo bwingi,","poem":1},{"text":"balibalapa milapo ya bufi","poem":2},{"lineBreak":true},{"text":"ni kukita bipingo.","poem":2},{"text":"Ni pakako, busongezi bulibwamena","poem":1},{"text":"nga bikusi bilibyaleeta bwimba mu bukaba buliminue.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Bekazi ba mu Samaria basakameene","poem":1},{"text":"pa mulandu wa mukisi wa nghombe musoka wa ku Bet-Aveni.","poem":2},{"text":"Bantu ba mu Samaria baakaulilila ozo mukisi,","poem":1},{"text":"evio vyenka ni babitambua bakue balibaupupa,","poem":2},{"text":"balia bakiba bawaminua na bulumba bwa ozo mukisi,","poem":1},{"text":"pantu ufumiiziwe kwabo ni kutwalua mu buzia.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ozo mukisi waakatwalua ku Asuria","poem":1},{"text":"kuba kyabupe kuli likolo mukulu.","poem":2},{"text":"Efraimu wakaba kusebaana,","poem":1},{"text":"Izraeli wakaba kumona busoni palua mukisi wakue wa kimuti.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Likolo wa mu Samaria waakeenoonua,","poem":1},{"text":"waakakungululua nga kiputu kya kimuti peulu menda.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Pa bifuka bibi bya kupupilapo mukisi paakeenoonua,","poem":1},{"text":"i nkendo iliyabalilapo Izraeli.","poem":2},{"text":"Myunga ni tumuti twa bukobola byaakamena","poem":1},{"text":"ni kukupilila pa bitale byabo.","poem":2},{"text":"Pa kyamba baakaana mpili nangue, “Ize mutukupilile,”","poem":1},{"text":"ni kwana tupili, “Ize mutuponene!”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“We Izraeli, kutula busiku buwaabalile mu Gibea,","poem":1},{"noteId":9},{"text":"koko i kumwasyele.","poem":2},{"text":"Kubako bului tebwaakitikile","poem":1},{"text":"ku bankitatubi ba mu Gibea?","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pa musita unaakatona, naakabakanda.","poem":1},{"text":"Ntundu yaakabakolonghanina kuti ikabakake","poem":2},{"lineBreak":true},{"text":"pa mulandu wa bibalo byabo bibili.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraimu i nghombe musoka asambiliziiziwe,","poem":1},{"text":"musoka atonene kupuula.","poem":2},{"text":"Ni pakako, nakaba kumukaka mupingo","poem":1},{"text":"pa mukosi wakue uweme.","poem":2},{"text":"Nakaba kumulombola Efraimu,","poem":1},{"text":"Yuda apalile kutipa,","poem":2},{"lineBreak":true},{"text":"ni Yakobo apalile kupuma bisinde.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Byale nsambu mwe bene,","poem":1},{"text":"zombole mazabo a ntono isiliyapua,","poem":2},{"text":"lime mu nsinde","poem":1},{"text":"pantu i musita wakumukeba Yawe mpaka pa-akaba kwiza","poem":2},{"text":"ni kuminookiizia bulunghami.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Inzi mwaalimbile bilubo,","poem":1},{"text":"mwaazombwele bubi,","poem":2},{"lineBreak":true},{"text":"mwaaliile buzabo bwa bupompo,","poem":2},{"text":"muketekeele sie maka enu mwe bene,","poem":1},{"text":"ni bwingi bwa balukale benu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ni pakako, nsungu ya bului yaakaba pa bantu bobe,","poem":1},{"text":"ni byubo byobe byonse byaakeenoonua","poem":2},{"text":"nga vyainoonenue Beti-Arbeli na likolo Salmani pa busiku bwa bului,","poem":1},{"text":"nghina ni baana bakue lubaapoozelue pansi na maka.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Evi i vikyaakakitika ni kuli wewe Beteli,","poem":1},{"text":"pantu bubi bobe ni bukata.","poem":2},{"text":"Bobo busiku pa bukakia,","poem":1},{"text":"likolo wakua Izraeli waakaloviiwa.”","poem":2}]}],"footnotes":[{"noteId":9,"caller":"+","text":"10.9 Gibea: Mona 9.9.","reference":{"chapter":10,"verse":9}}]},"thisChapterLink":"/api/tap_twf/HOS/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/9.json","previousChapterAudioLinks":{},"numberOfVerses":15}