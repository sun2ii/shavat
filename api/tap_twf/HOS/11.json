{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":11,"content":[{"type":"heading","content":["Ntono yakua Leza pa Baizraeli"]},{"type":"verse","number":1,"content":[{"text":"“Izraeli lu-aali wakili mwanike, naamutonene,","poem":1},{"text":"ni kufuma ku Misri, naamukuutile mwanane.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inzi nga vibaali bakila kukuutua,","poem":1},{"text":"i vibaali bakila kuya kule ni nene.","poem":2},{"text":"Baeleele ngelelo ku ba Baali","poem":1},{"text":"ni kufunkia bubaani ku mikisi.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Nene i waamusambiliziizie Efraimu kwenda,","poem":1},{"text":"nabakwete ku maboko,","poem":2},{"text":"inzi tebainikile","poem":1},{"text":"nangue nene i waabakosiizie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naabalombwele na nkamba ya nkumbu ya bumuntu,","poem":1},{"text":"na nkakilo ya ntono,","poem":2},{"text":"kuli bene naali nga olia aliwatwama","poem":1},{"text":"mwana pa nkombe,","poem":2},{"lineBreak":true},{"text":"kabili naafwineeme kuti n'mbaliisie.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"“Kubako tebakabwelela ku Misri","poem":1},{"text":"ni kuteekua na Asuria","poem":2},{"lineBreak":true},{"text":"pantu baakeene kulapila?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Kipanga kyaakabeekia mu mizi yabo.","poem":1},{"text":"Kyaakazakila minkolonto ya milyango yabo","poem":2},{"lineBreak":true},{"text":"ni kupwisia mapange abo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bantu bane bekinkiziizie kuti ban'mbutuke.","poem":1},{"text":"Anzia kine balibankuuta Leza Kabezia Mpungu,","poem":2},{"lineBreak":true},{"text":"ata pakaba syani, nsikavinda kubasezia.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Kuti nakusia syani we Efraimu?","poem":1},{"text":"Kuti nakulekelela syani we Izraeli?","poem":2},{"text":"Kuti nakukitila syani bibiipile nga vinaakitiile Adma?","poem":1},{"text":"Kuti nakukita syani nga Zeboimu?","poem":2},{"text":"Mutima wane walulukile mukati mwane,","poem":1},{"text":"nkumbu yane yonse ibuukulukile.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nsikafikilizia kikonko kyane kikata,","poem":1},{"text":"kabili nsika-alulula malanga ni kumwinoona Efraimu paakale,","poem":2},{"text":"pantu nene ndi Leza, kabili nsili muntu,","poem":1},{"text":"ndi Muzuuke pakati kenu.","poem":2},{"lineBreak":true},{"text":"Nsikeeza kukanda mizi yabo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Baakamukonka Yawe.","poem":1},{"text":"Waakabuluma nga nkalamu.","poem":2},{"text":"Lu-aliwabuluma,","poem":1},{"text":"baana bakue balibaiza kufuma ku mboosi balimukututuma.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Baakeeza kufuma ku Misri,","poem":1},{"text":"balimukututuma nga minsole,","poem":2},{"lineBreak":true},{"text":"kufuma ku Asuria, bapupukile nga nkunda.","poem":2},{"text":"Naakabeekazia mu nghanda yabo ingi,”","poem":1},{"text":"nangue Yawe.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Efraimu anzyungulukiile na bufi,","poem":1},{"text":"Izraeli na bupompo,","poem":2},{"text":"inzi Bayuda baatwaliile kuba ba kisinka kuli Leza,","poem":1},{"text":"Leza Muzuuke wa kisinka.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/HOS/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/10.json","previousChapterAudioLinks":{},"numberOfVerses":12}