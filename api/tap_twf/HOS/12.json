{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":12,"content":[{"type":"verse","number":1,"content":[{"text":"Efraimu aliwailiisia mwela.","poem":1},{"text":"Aliwakumba mwela wa ku kabanga koba konse","poem":2},{"lineBreak":true},{"text":"ni kuvuzia bufi ni bubi.","poem":2},{"text":"Aliwaunvwana ni Asuria","poem":1},{"text":"ni kutuma mafuta a mizeituni ku Misri.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Yawe ali ni mulandu ni Yuda.","poem":1},{"text":"Wakaba kumukanda Yakobo kukonkana ni mibeele yakue","poem":2},{"lineBreak":true},{"text":"ni kumusazia kukonkana ni bikitua byakue.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Yakobo lu-aali munda, waamusakatiile mukuluube lya ku kasinghino.","poem":1},{"text":"Wene lu-aakulile, waalwile na Leza.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Waalwile na malaika ni kumwanzia,","poem":1},{"text":"waalilile ni kulomba buwame.","poem":2},{"text":"Waamusangile ku Beteli","poem":1},{"text":"ni kwambaula ni ye","poem":2},{"noteId":10},{"text":"koko kwenka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Yawe Leza wa Maka onse,","poem":1},{"text":"Yawe i liina lyakue!","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Inzi upalile kubwela kuli Leza obe.","poem":1},{"text":"Sunga ntono ni bulunghami,","poem":2},{"lineBreak":true},{"text":"ni kupempa Leza obe lyonse.","poem":2}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Musulu aliwabombia tulingo twa bupompo,","poem":1},{"text":"aliwatona kukalana.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Efraimu aliwaitantamuna,","poem":1},{"text":"“Nene ndi munonsi mukata. Nakyaluka munonsi.","poem":2},{"text":"Mu bunonsi bwane bonse,","poem":1},{"text":"tebakansangamo na lubiibi ao na kibalo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Nene ndi Yawe Leza wenu","poem":1},{"text":"waamifumiizie ku Misri.","poem":2},{"text":"Naakamilengia kwikala paakale mu maema,","poem":1},{"text":"nga mu nsiku ya nsikunkulu yenu yaabiikilue.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Naalandile na bakabika,","poem":1},{"text":"naabapeele bimonua bingi","poem":2},{"text":"ni kulandila mu bipalo kupitila muli bene.”","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kubako Gileadi te mubi?","poem":1},{"text":"Bantu bakue ni ba mpuni!","poem":2},{"text":"Eba, balibaeleela nghombe ndume mu Gilgali?","poem":1},{"text":"Bitale byabo byaakaba nga milui ya mabue","poem":2},{"lineBreak":true},{"text":"mu bukaba buliminue.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Yakobo waabutukiile mu kyalo kya Aramu,","poem":1},{"text":"Izraeli waabombele pakuti apate mukazi,","poem":2},{"lineBreak":true},{"text":"ni pakuti alipe pa mulandu wa mukazi, waasungile mikooko.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Yawe waabombiizie kabika pakuti amufumie Izraeli ku Misri,","poem":1},{"text":"kupitila muli kabika waamusungile.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Inzi Efraimu waasonseziizie kipuki kyakua Yawe,","poem":1},{"text":"Mulopue wakue waakamupenda kuba wa kilubo pa mulandu wa bungipaani bwakue","poem":2},{"lineBreak":true},{"text":"ni kumukanda pa mulandu wa mufuupula wakue.","poem":2}]}],"footnotes":[{"noteId":10,"caller":"+","text":"12.4 Bwaluzi bumo bwa kale buli na Ye; Mu Kiebrania Fwe.","reference":{"chapter":12,"verse":4}}]},"thisChapterLink":"/api/tap_twf/HOS/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/11.json","previousChapterAudioLinks":{},"numberOfVerses":14}