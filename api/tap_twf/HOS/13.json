{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":13,"content":[{"type":"heading","content":["Bupinguzi bwa mpeleezio pa Baizraeli"]},{"type":"verse","number":1,"content":[{"text":"Efraimu lu-aalandile, bantu baatutumine.","poem":1},{"text":"Waalumbilue mu Izraeli.","poem":2},{"text":"Inzi waisangile kuba mubi pa mulandu wa kupupa leza Baali, ni ye waafwile.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Evi balimukukila kubala.","poem":1},{"text":"Balimukwikitila mikisi na mutofue wabo","poem":2},{"text":"mu musango ubamaniinemo bo bene,","poem":1},{"text":"byonse byaakitilue na bantu bamanine mwilo.","poem":2},{"text":"Kilandilue palua baba bantu nangue,","poem":1},{"text":"“Balibafumia bantu kuba ngelelo!","poem":2},{"lineBreak":true},{"text":"Balibakumbatila mukisi wa nghombe musoka!”","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ni pakako, baakaba nga fuube wa lukeelekeele,","poem":1},{"text":"nga lume lusililwakokola kuzeeza,","poem":2},{"text":"nga makapa aliaululua na mwela pa kipuulilo,","poem":1},{"text":"nga kyunsi kilikyafumina pa nzota.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Inzi nene ndi Yawe Leza wenu","poem":1},{"text":"kutula pa musita umwaafumine ku Misri,","poem":2},{"text":"temupalile kukindika unge Leza inga sie nene,","poem":1},{"text":"tekuli Mupususi unge inga sie nene.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naakulabukiile mu kaseeba,","poem":1},{"text":"mu kyalo kya kyaka.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lunaabaliisiizie, baikutile.","poem":1},{"text":"Lubaikutile, ba-alukile ni kiitoni.","poem":2},{"lineBreak":true},{"text":"I kyaalengele kuti bandabe.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ni pakako, naakaba nali nga nkalamu kuli bene,","poem":1},{"text":"nga kanfuma, naakababenza mu nzila.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Nga kimbui kiibiilue baana bakue,","poem":1},{"text":"naakabasakukila ni kuzanghununa mitima yabo.","poem":2},{"text":"Nga nkalamu mukota, naakabazakila.","poem":1},{"text":"Nama ya mu kisonso yaakabazanghununa tuputu tuputu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"“Wainoonua we Izraeli","poem":1},{"text":"pantu wanfunghamina. Wafunghamina mukwasi obe.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ale likolo obe wakuti akupususie alipi?","poem":1},{"text":"Bakateeka ba mu mizi yobe yonse bali pi","poem":2},{"text":"balia bawaanombele nangue,","poem":1},{"text":"‘N'mpeele likolo ni babiloolo?’","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Mu kipuki kyane naakupeele likolo,","poem":1},{"text":"ni mu kikonko kyane naamufumiiziepo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bubi bwakua Efraimu busungilue,","poem":1},{"text":"bibalo byakue bilembelue.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Wene misa iliyamwizila nga mwanakazi alimukuvyala mwana,","poem":1},{"text":"inzi ozo mwana tali na mulangue.","poem":2},{"text":"Musita kine wakumana,","poem":1},{"text":"aliwa-anda kufuma munda mwa nghina.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Naakalubula baba bantu ku maka a kilibu,","poem":1},{"text":"naakabapususia ku lufu.","poem":2},{"text":"We lufu, lyemo lyobe lili pi?","poem":1},{"text":"We kumbo, lwinoono lobe luli pi?","poem":2},{"lineBreak":true},{"text":"“Nsikaba na nkumbu,","poem":1}]},{"type":"verse","number":15,"content":[{"text":"anzia kine Efraimu akakitikilua na biweme pa ba kwakue,","poem":2},{"text":"mwela wa ku kabanga kufuma kuli Yawe waakeeza","poem":1},{"text":"wapuupile kufuma ku kaseeba.","poem":2},{"text":"Kasulo kakue tekakasula,","poem":1},{"text":"ni kiina kyakue kya menda kyaakakama.","poem":2},{"text":"Muluwe wakue waakeenoonua","poem":1},{"text":"pamo ni bintu byonse bilimo bya mutengo.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Bantu ba mu Samaria bapalile kwisanga bali ni mulandu,","poem":1},{"text":"pantu bakimusangukila Leza wabo.","poem":2},{"text":"Baakaloviiwa na kipanga.","poem":1},{"text":"Baana babo baniini baakafuntwilua pansi na maka,","poem":2},{"lineBreak":true},{"text":"banakazi bemisi ba mu Samaria baakatumbulua.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/HOS/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/12.json","previousChapterAudioLinks":{},"numberOfVerses":16}