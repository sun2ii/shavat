{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":14,"content":[{"type":"heading","content":["Hosea wapaapaatila Izraeli"]},{"type":"verse","number":1,"content":[{"text":"We Izraeli, bwelela kuli Yawe Leza obe.","poem":1},{"text":"Bibalo byobe byakikuponia!","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Be mwali ni twebo","poem":1},{"text":"mubwelele kuli Yawe.","poem":2},{"text":"Mumwane nangue,","poem":1},{"text":"“Eleela bibalo byetu byonse","poem":2},{"text":"ni kutupokelela na buwame,","poem":1},{"text":"pakuti tufumie buzabo bwetu bwa ku milomo.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Asuria tavinda kutupususia,","poem":1},{"text":"tetukikasela pa farasi wa bului.","poem":2},{"text":"Tetukikalanda nangue, ‘Baleza betu’","poem":1},{"text":"ku bintu bitwaakitile na minue yetu,","poem":2},{"lineBreak":true},{"text":"pantu kuli wewe, mwana nsiwa aliwaunvwilua nkumbu.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Naakoondapa butaale bwabo","poem":1},{"text":"ni kubatona na mutima wane onse,","poem":2},{"lineBreak":true},{"text":"pantu nsikibafiitiilue.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Naakaba nga lume kuli Izraeli,","poem":1},{"text":"waakatoota nga buluba.","poem":2},{"text":"Waakengizia misila pansi","poem":1},{"text":"nga kimuti kya mumpelempele kya ku Lebanoni.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Misambo yakue yaakabazalala.","poem":1},{"text":"Kuvumba kwakue kwaakaba nga kimuti kya muzeituni,","poem":2},{"lineBreak":true},{"text":"bunu bwakue nga kimuti kya mumpelempele kya ku Lebanoni.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Bantu baakeekala mu bulelo bwakue paakale,","poem":1},{"text":"baakasana nga nghano,","poem":2},{"text":"baakatoota nga mizabibu.","poem":1},{"text":"Kumanika kwakua Izraeli kwaakaba nga divai ifumine ku Lebanoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"We Efraimu, kubako ni bwampanoki buli pali nene ni mikisi?","poem":1},{"text":"Nene ndikukwasuka ni kukulabukila.","poem":2},{"text":"Nene ndi nga kimuti kibisi kisili kyauma lyonse.","poem":1},{"text":"Kuseeka kwa mazabo kobe kulikwafuma kuli nene.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Nani ali ni mulangue? Enike totu twebo.","poem":1},{"text":"Nani ali ni maano? Amane totu twebo.","poem":2},{"text":"Nzila yakua Yawe ilungheeme,","poem":1},{"text":"balunghami i balibaendamo,","poem":2},{"lineBreak":true},{"text":"inzi babisanguka balibaipuutalamo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/HOS/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/JOL/1.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/13.json","previousChapterAudioLinks":{},"numberOfVerses":9}