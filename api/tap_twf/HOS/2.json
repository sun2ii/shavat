{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":2,"content":[{"type":"verse","number":1,"content":["Mu bobo busiku waakakuuta ba kobe nangue Ami, “Bantu bane.” Ni bankaziizo nangue Ruhama, “Batonua bane.”"]},{"type":"heading","content":["Kukandua kwakua Izraeli, mukazi mukende"]},{"type":"verse","number":2,"content":[{"text":"Sasilile nghinenue, musasilile,","poem":1},{"text":"pantu wene takili mukazi wane,","poem":2},{"lineBreak":true},{"text":"ni nene nsikili mulume wakue.","poem":2},{"text":"Mwane alekele mibeele ya bukende mu monekelo yakue","poem":1},{"text":"ni bukende pa bukata bwa mabeele akue.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kine te evio nakaba kumuvuula ngubo yakue,","poem":1},{"text":"ni kumusia mu-aavyaliilue.","poem":2},{"text":"Nakaba kumukita nga kaseeba,","poem":1},{"text":"nakaba kumwalula kuba musili uume,","poem":2},{"lineBreak":true},{"text":"ni kumwipaya na kyaka.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Baana bakue nsikabonvwila nkumbu,","poem":1},{"text":"pantu ni baana ba mu bukende.","poem":2},{"text":"Nghinabo tali na bukisinka,","poem":1},{"text":"wakibeemita mu nzila isipalile.","poem":2},{"text":"Gomeri waalandile evi, “Ndikukonkelela batonua bane,","poem":1},{"text":"balia baliban'mpeela bilio,","poem":2},{"lineBreak":true},{"text":"ni baliban'mpeela menda.","poem":2},{"text":"Baliban'mpeela ngubo ya masako a nama ni kitani, ni mafuta a mizeituni,","poem":1},{"text":"pamo ni bikolani.”","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Ni pakako, ne Leza nakaba kusaka nzila yakue na myunga,","poem":1},{"text":"nakaba kumukingilila mukati luuba,","poem":2},{"lineBreak":true},{"text":"evi tekuti akamone pa kupitila.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Gomeri waakakonkelela batonua bakue, inzi takabasanga.","poem":1},{"text":"Waakabakeba, inzi takabamona.","poem":2},{"text":"Pa kyamba waakalanda nangue,","poem":1},{"text":"“Ndikubwela sie ku mulume wane wa mambo,","poem":2},{"lineBreak":true},{"text":"pantu naali nali bwino kukila lenu.”","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gomeri tainikile nangue nene","poem":1},{"text":"i waamupeele bintu byonse bi-ali nabio, nghano ni divai ya lenu pamo ni mafuta a mizeituni,","poem":2},{"text":"nene i waamunonsiizie mutofue ni oro ibaali babombia","poem":1},{"text":"mu kumubombela leza Baali.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ni pakako, nakaba kupokolola nghano yane musita wa kuzombola,","poem":1},{"text":"ni divai yane ya lenu pa kyamba kya kutika,","poem":2},{"text":"nakaba kupokolola ngubo yane ya masako pamo ni kitani kyane,","poem":1},{"text":"bebio byaali byapalile kukupa mubili wakue.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Ni evi, naakamuvuula ni kumusia mu-aavyaliilue","poem":1},{"text":"ntanzi ya batonua bakue.","poem":2},{"lineBreak":true},{"text":"Tekuli muntu waakamupokolola mu minue yane.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Naakapwisia maliila akue onse,","poem":1},{"text":"nsikunkulu yakue ya kubalua mwaka, ni ya kubaluka kwa kwezi,","poem":2},{"lineBreak":true},{"text":"ni nsiku yakue ya Sabata, nsikunkulu yakue yonse itantikilue.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naakenoona mizabibu yakue ni bimuti byakue bya miku,","poem":1},{"text":"bebio bi-aliwalanda nangue i nsazio yakue i-aapeelue na batonua bakue.","poem":2},{"text":"Ni ne naakalengia mizabibu ni bimuti bya miku kuba musitu,","poem":1},{"text":"ni nama ya mu kisonso yaakalia mazabo abio.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Naakamukanda pa mulandu wa ezio nsiku","poem":1},{"text":"i aafunkiziizie bubaani kuli leza Baali,","poem":2},{"text":"lu-aifwaniizie na tuzele twa ku minue","poem":1},{"text":"ni binge bifwanizio bya mutengo,","poem":2},{"text":"ni kuya kubembia batonua bakue,","poem":1},{"text":"inzi nene wandabile,","poem":2},{"lineBreak":true},{"text":"koku i kulanda kwakua Yawe.","poem":2}]},{"type":"heading","content":["Ntono yakua Leza pa bantu bakue"]},{"type":"verse","number":14,"content":[{"text":"Ni pakako, nakaba kumubembia,","poem":1},{"text":"nakaba kumulombola mu kaseeba","poem":2},{"lineBreak":true},{"text":"ni kwambaula nakue mubufuuke.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Koko, i kunakaba kumubweziizia makaba akue a mizabibu,","poem":1},{"text":"ni lulambe lwa Akori","poem":2},{"noteId":4},{"text":"nakaba kulukita kuba mulyango wa maswapi.","poem":2},{"text":"Koko i ku-akaba kwimba lwimbo nga vi-aali waimba ku bukazyana bwakue,","poem":1},{"text":"nga mu bolia busiku bu-aafumine ku Misri.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Yawe walanda nangue, “Mu bobo busiku,","poem":1},{"text":"wewe waakankuuta nangue, ‘Mulume wane.’","poem":2},{"lineBreak":true},{"text":"Teukikankuuta nangue, ‘leza wane Baali.’","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Naakafumia meena a baleza baliwakuutua Baali mu milomo yakue,","poem":1},{"text":"ni meena abo takika-azimbula.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mu ezio nsiku naakakita kipingo pa mulandu wa Baizraeli,","poem":1},{"text":"ni nama ya mu kisonso ni tooni twa mulweleele,","poem":2},{"lineBreak":true},{"text":"pamo ni bilengua bilibyayibula pansi.","poem":2},{"text":"Buta, ni kipanga pamo ni bului,","poem":1},{"text":"naakabifumia mu kyalo,","poem":2},{"lineBreak":true},{"text":"evi bonse bakabe baikeele mu mutende.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Naakakusaka we Izraeli kuti ukabe wane muyayaya,","poem":1},{"text":"naakakusaka mu nsambu ni mu bulunghami,","poem":2},{"lineBreak":true},{"text":"mu ntono ni mu nkumbu.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Naakakusaka kuti ukabe wane mu kisinka,","poem":1},{"text":"ni we waakanghinika nangue nene i Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“Mu bobo busiku naakaasuka,”","poem":1},{"text":"nangue Yawe,","poem":2},{"lineBreak":true},{"text":"“naakaasuka myulu,","poem":2},{"lineBreak":true},{"text":"myulu ni yo yaakaasuka kyalo,","poem":2},{"text":"ni kyalo kyaakaasuka mbezu,","poem":1},{"text":"ni divai ya lenu ni mafuta a mizeituni,","poem":2},{"lineBreak":true},{"text":"ni bebi byonse byaakamwasuka Yezreeli.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Naakamulimba Yezreeli mu kyalo.","poem":1},{"text":"Naakalanga ntono yane ku olia unainikile Lo-Ruhama.","poem":2},{"text":"Balia banainikile Lo-Ami, naakabaana nangue, ‘Muli bantu bane,’","poem":1},{"text":"ni bo baakalanda nangue, ‘Uli Leza wetu.’”","poem":2}]}],"footnotes":[{"noteId":4,"caller":"+","text":"2.15 Akori I kulanda nangue Lyemo.","reference":{"chapter":2,"verse":15}}]},"thisChapterLink":"/api/tap_twf/HOS/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/1.json","previousChapterAudioLinks":{},"numberOfVerses":21}