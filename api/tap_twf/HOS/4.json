{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":4,"content":[{"type":"heading","content":["Izraeli wasongelua"]},{"type":"verse","number":1,"content":[{"text":"Mwe Baizraeli, unvue keebo kakua Yawe,","poem":1},{"text":"pantu Yawe alimukumisongela","poem":2},{"lineBreak":true},{"text":"mwe bekeele mu kyalo walimukulanda nangue,","poem":2},{"text":"“Mu kyalo temuli bukisinka ni ntono,","poem":1},{"text":"kwinika Leza tekulimo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Muli sie ntiipu, bufi ni bungipaani,","poem":1},{"text":"bukabooko pamo ni bukende","poem":2},{"text":"mwaya kyalo,","poem":1},{"text":"ni bungipaani tekuba bwapua.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Ni pakako, kyalo kilimukulilooka,","poem":1},{"text":"ni bonse bekeelemo baakafua.","poem":2},{"text":"Nama ya mu kisonso ni tooni twa mu lweleele,","poem":1},{"text":"pamo ni masabi a mu lyezi byaakafua.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Kubalua muntu tekuti aye wasongela mwinakue,","poem":1},{"text":"kubalua muntu tekuti aye wamwitendookela mwinakue,","poem":2},{"text":"pantu bantu bobe bali nga balia","poem":1},{"text":"balibasongela kitambua.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Wewe uliwaipuutala busiku ni koba,","poem":1},{"text":"bakabika ba bufi balibaipuutala pamo nobe.","poem":2},{"text":"Ni pakako, nakaba kumulovia noko.","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Bantu baane bainooneka pa mulandu wa kusimana.","poem":2},{"lineBreak":true},{"text":"“Pa mulandu wa kukaana bukengezi,","poem":1},{"text":"ni ne ndikumikaana tekuti muye mwali babitambua bane.","poem":2},{"text":"Pa mulandu wa kukaana mizilo yane ne Leza wenu,","poem":1},{"text":"ni ne nsipoozako maano ku baana benu.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kukonkana ni vivulile babitambua,","poem":1},{"text":"i vivulile ni bibalo bibaliban'mbala.","poem":2},{"lineBreak":true},{"text":"Naakaalula bulumba kuba busoni.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Balibalia ngelelo ya bibalo iliyaleetua na bantu bane,","poem":1},{"text":"ni kuwaminua na bubi bwa bantu bane.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Ni pakako, vilivyakita babitambua, i vilivyakita ni bantu.","poem":1},{"text":"Bonse babili naakabakanda kukonkana ni misango yabo,","poem":2},{"lineBreak":true},{"text":"ni kubasazia mubeeleele bikitua byabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Anzia bakalia, tebakeekuta,","poem":1},{"text":"anzia bakakambula, tebakaba na baana,","poem":2},{"text":"pantu baamufunghamiine Yawe ni kukonkelela baleza bange.”","poem":1}]},{"type":"heading","content":["Yawe wakanda mpupo ya Bazima"]},{"type":"verse","number":11,"content":[{"text":"Kukita bukambue,","poem":1},{"lineBreak":true},{"text":"ni kumina divai ya kale pamo ni ya lenu,","poem":1},{"text":"bebio i bilibyabalengia kusiba na bukengezi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Bantu bane balibalomba nsokezi ku mukisi wa kimuti,","poem":1},{"text":"ni kuya ba-asukua na kabango ka kimuti.","poem":2},{"text":"Mutima wa bukambue uliwabazeezia.","poem":1},{"text":"Tebali na bukisinka kuli Leza wabo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Balibaelela ngelelo peulu lupili,","poem":1},{"text":"ni ngelelo ya kuziziiwa peulu tupili,","poem":2},{"text":"mwinsina bimuti bya oaki, ni bya popla pamo ni bya terebenti,","poem":1},{"text":"momo muli bulelo buweme.","poem":2},{"text":"Ni pakako, baana benu bakazyana i kibalimukukitila bukambue,","poem":1},{"text":"ni bamuka baana benu i kibalimukukitila bukende.","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"“Nsikakanda baana benu banakazi","poem":1},{"text":"lubalibaakita bukambue.","poem":2},{"text":"Ao bamuka baana benu","poem":1},{"text":"lubalibakita bukende,","poem":2},{"text":"pantu balalume bene i balibakita bukambue,","poem":1},{"text":"ni kwelela ngelelo pamo ni bakambue.","poem":2},{"text":"Balibaelela pa nkendo ya kupupilapo nga mulandiile mapinda nangue,","poem":1},{"text":"‘Bantu basikengeele, balobele.’”","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“We Izraeli! Anzia kine wakikita bukende,","poem":1},{"text":"tekumulengia Yuda kuba ni bubi.","poem":2},{"lineBreak":true},{"text":"“Tekuya kupupa ku Gilgali,","poem":1},{"text":"ao ku Bet-Aveni.","poem":2},{"noteId":5},{"lineBreak":true},{"text":"Kabili tekuye kukitako mulapo nangue, ‘mu Liina lyakua Yawe mukose.’”","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Baizraeli, bataale","poem":1},{"text":"nga nghombe musoka.","poem":2},{"text":"Kubako Yawe kuti wabasunga syani","poem":1},{"text":"nga mikooko mu bikusi bibisi?","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Efraimu wailunda ku mikisi,","poem":1},{"text":"musie bunke.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Banombozi ba Baizraeli lubalibapua bikolani byabo,","poem":1},{"text":"balibatwalilila mu bukambue bwabo,","poem":2},{"lineBreak":true},{"text":"ni kutonesia mibeele ya busoni.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mulula wakaba kubapyangila kule,","poem":1},{"text":"ni ngelelo yabo yakaba kubaleetela busoni.","poem":2}]}],"footnotes":[{"noteId":5,"caller":"+","text":"4.15 Bet-Aveni: Leli liina i kulanda nangue nghanda ya bubi ao nghanda ya kupupilamo baleza, ni mu bobu bulanzi mwimaniineko muzi wa Beteli, liina lili ni bupilibulo bwa Nghanda yakua Leza. Mona ni mu 5.8, 10.5 ni 10.8.","reference":{"chapter":4,"verse":15}}]},"thisChapterLink":"/api/tap_twf/HOS/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/3.json","previousChapterAudioLinks":{},"numberOfVerses":19}