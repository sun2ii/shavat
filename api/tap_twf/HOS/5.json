{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":5,"content":[{"type":"verse","number":1,"content":[{"text":"“Mwe babitambua unvue!","poem":1},{"text":"Poozeko maano mwe Baizraeli!","poem":2},{"text":"Mwe nghanda ya bukolo twilizie!","poem":1},{"text":"Bobu bupinguzi ni pa mulandu wenu:","poem":2},{"text":"Mwemue mwaali muteo ku Misipa,","poem":1},{"text":"bukila buteelue pa lupili lwa Tabori.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Babisanguka bakila kwipaana.","poem":1},{"text":"Nene nakaba kubakanda bonse.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"N'manine byonse palwakua Efraimu,","poem":1},{"text":"Izraeli tanfyeme.","poem":2},{"text":"We Efraimu, watendeka kukita bukambue,","poem":1},{"text":"Izraeli waitiikania.","poem":2}]},{"type":"heading","content":["Hosea wabasoka palua kupupa mikisi"]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“Bikitua byabo tebibetabiizie,","poem":1},{"text":"kubwela kuli Leza wabo.","poem":2},{"text":"Mupasi wa bukambue uli mu mitima yabo,","poem":1},{"text":"tebamumanine Yawe.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Izraeli wasininkiziiwa na kiitoni kyakue.","poem":1},{"text":"Baizraeli ni Efraimu baipuutala mu bibalo byabo.","poem":2},{"lineBreak":true},{"text":"Yuda ni ye waipuutala pamo nabo.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Lubalibaya ni mikooko yabo pamo ni nghombe,","poem":1},{"text":"kuya kumukeba Yawe,","poem":2},{"text":"tebezi kumusanga,","poem":1},{"text":"pantu abafunghamiine.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Tebakili ba kisinka kuli Yawe.","poem":1},{"text":"Bakivyala baana mu bukambue.","poem":2},{"text":"Nsikunkulu yabo ya kubaluka kwa kwezi yaakabalovia,","poem":1},{"text":"pamo ni makaba abo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Lizie ntandala mu Gibea,","poem":1},{"text":"lisengo mu Rama.","poem":2},{"text":"Samune lizui lya bului mu Bet-Aveni,","poem":1},{"noteId":6},{"text":"mu kyamba kyobe we mukowa wakua Benyamina.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Efraimu waakasiiwa kibolia","poem":1},{"text":"mu nsiku ya kukandua.","poem":2},{"text":"Bindimukulanda pa mikowa ya Baizraeli","poem":1},{"text":"ni bya kisinka.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Banombozi ba Bayuda bali nga bantu","poem":1},{"text":"balibatelulula mabue a mu mipaka pasili nsambu.","poem":2},{"text":"Naakapongola kikonko kyane pali bene","poem":1},{"text":"nga kibunda kya menda.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Efraimu waemiiwa,","poem":1},{"text":"wabiibikiziiwa mu bupinguzi,","poem":2},{"lineBreak":true},{"text":"pakafi ka kutona kupupa mikisi.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Nene ndi nga nondo kuli Efraimu,","poem":1},{"text":"ndi nga kintu kibolele ku Bayuda.","poem":2}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"“Efraimu lu-aamwene bulwele bwakue,","poem":1},{"text":"ni Yuda bilonda byakue,","poem":2},{"text":"Efraimu i lu-aile ku Asuria,","poem":1},{"text":"ni kutuma mikenzi ya kuya kulomba bukwasi kuli likolo mukulu.","poem":2},{"text":"Inzi tali na buvinde bwa kumikosia,","poem":1},{"text":"ao kukosia bilonda byenu.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Ni pakako, naakaba nga nkalamu kuli Efraimu,","poem":1},{"text":"nga nkalamu asasile kuli Yuda.","poem":2},{"text":"Naakabazanghununa tuniini tuniini ni kuya,","poem":1},{"text":"naakabatwala kule kusikaba wa kubapususia.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Pa kyamba, naakabwelela pa kifuka kyane","poem":1},{"text":"mpaka musita ubaakeetabila bubi bwabo","poem":2},{"lineBreak":true},{"text":"ni kukeba lukebu lwane.","poem":2},{"text":"Mu maavia abo","poem":1},{"text":"baakankeba na mute.”","poem":2}]}],"footnotes":[{"noteId":6,"caller":"+","text":"5.8 Bet-Aveni: Mona 4.15.","reference":{"chapter":5,"verse":8}}]},"thisChapterLink":"/api/tap_twf/HOS/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/4.json","previousChapterAudioLinks":{},"numberOfVerses":15}