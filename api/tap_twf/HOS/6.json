{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":6,"content":[{"type":"heading","content":["Leza wasoka Baizraeli kuti balapile"]},{"type":"verse","number":1,"content":[{"text":"“Ize tubwelele kuli Yawe.","poem":1},{"lineBreak":true},{"text":"Wakituzanghununa tuputu tuputu,","poem":1},{"text":"inzi wakaba kutukosia.","poem":2},{"text":"Wakitukisia,","poem":1},{"text":"inzi wakatukakilila bilonda byetu ni kutundapa.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pa kyamba kya nsiku ibili wakaba kututuntumuna.","poem":1},{"text":"Mu busiku bwa butatu wakaba kutubuusia,","poem":2},{"lineBreak":true},{"text":"pakuti tukabe bakose pa ntanzi yakue.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kansi tumumane Yawe.","poem":1},{"text":"Tumumane twakoniizie.","poem":2},{"text":"Kisinka nga vilivyatula koba,","poem":1},{"text":"i vi-ali wakaba kumoneka.","poem":2},{"text":"Wakaba kwiza kuli fwefue nga nvula ya muloboko,","poem":1},{"text":"nga nvula ya mpeleezio iliyatomia pa kyalo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"“We Efraimu! Nkukite syani?","poem":1},{"text":"We Yuda! Nkukite syani?","poem":2},{"text":"Ntono yenu ili nga fuube wa lukeelekeele,","poem":1},{"text":"nga lume lwa kumakia lusililwakokola kuzeeza.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ni pakako, nakimiputulania tuputu tuputu","poem":1},{"text":"kupitila mu bakabika bane.","poem":2},{"text":"Nakimipaya na twebo twa mu kanua kane,","poem":1},{"text":"bupinguzi bwane bwaakasaama nga kisue kya koba.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pantu nene ntonene nkumbu, tekuba ngelelo,","poem":1},{"text":"ni kunakila Leza","poem":2},{"lineBreak":true},{"text":"kukila ngelelo ya kuzizia.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Inzi ku Adamu,","poem":1},{"noteId":7},{"text":"bainoonene kipingo,","poem":1},{"text":"koko, kubasibanga ba kisinka kuli nene.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Gileadi i muzi wa bankitatubi,","poem":1},{"text":"muzi utiikaaniiziwe na mulopa.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Nga vili mabumba a bapoti balibafyamina bantu,","poem":1},{"text":"i vili ni libumba lya babitambua.","poem":2},{"text":"Balibaipaya bantu mu nzila ya ku Sekemu,","poem":1},{"text":"ni kukita bintu bibiipile.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Nakimona kintu kibi mu Izraeli.","poem":1},{"text":"Momo mulimukukita Efraimu bukambue.","poem":2},{"lineBreak":true},{"text":"Izraeli waitiikania.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Ni palwakua wewe Yuda,","poem":1},{"text":"musita wa kuzombolua uteaniiziwe.","poem":2},{"text":"Musita unakaba kubwezia bakakua ba pa bantu bane.”","poem":1}]}],"footnotes":[{"noteId":7,"caller":"+","text":"6.7 Ao Nga Adam; Mu Kiebrania Nga bantu","reference":{"chapter":6,"verse":7}}]},"thisChapterLink":"/api/tap_twf/HOS/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}