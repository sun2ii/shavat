{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":7,"content":[{"type":"verse","number":1,"content":[{"text":"“Lyonse lundinakeba kukosia Izraeli,","poem":1},{"text":"bibalo byakua Efraimu bilibyabiikua paswetele.","poem":2},{"text":"Bubi bwakua Samaria bulibwafyulua,","poem":1},{"text":"balibapompolana,","poem":2},{"text":"bakabooko balibaingililana mu nghanda,","poem":1},{"text":"babipoopoosi balibasompolana mu misebo.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Inzi tebenikile","poem":1},{"text":"nangue nangulukile bikitua byabo byonse bibi.","poem":2},{"text":"Bibalo byabo bibazyungulukiile,","poem":1},{"text":"ni byo bili pa ntanzi yane lyonse.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"“Balibamusansamusia likolo na bilubo byabo,","poem":1},{"text":"ni babiloolo na bufi bwabo.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Bonse balibakita bukende,","poem":1},{"text":"baswelele nga kyapiko kya mikate,","poem":2},{"text":"kekio kili ni mulilo usikebekele kusonseziiwa na kaapika wa mikate","poem":1},{"text":"kutula musita wa kukandila bunga mpaka musita wa kututumuka.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mu busiku bwa nsikunkulu yakua likolo wetu,","poem":1},{"text":"babiloolo balibaleema na bikolani,","poem":2},{"lineBreak":true},{"text":"ni likolo aliwailunda ku bantu bali ni mufuupula.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Mitima yabo ili nga kikuka kya mulilo,","poem":1},{"text":"balibamuwila likolo mu bubi.","poem":2},{"text":"Kipuki kyabo kilikyafunka kyunsi busiku bonse,","poem":1},{"text":"ni lukeelekeele kilikyatuutuuka nga libeebe lya mulilo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Baswelele nga kyapiko kya mikate.","poem":1},{"text":"Balibazakila bakateeka babo.","poem":2},{"text":"Makolo abo onse aliapona,","poem":1},{"text":"kabili tepali muntu aliwankuuta.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"“Efraimu esanziizie mu ntundu.","poem":1},{"text":"Efraimu i mukate umaatikile upiile bwala bumo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Baeni bamupwile maka,","poem":1},{"text":"inzi wene tenikile.","poem":2},{"text":"Mu misisi yakue muli ni ndale pale pale,","poem":1},{"text":"inzi wene tamanine.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Kiitoni kyakua Izraeli kilikyamusininkizia,","poem":1},{"text":"anzia evio,","poem":2},{"text":"tamubweleele Yawe Leza wakue","poem":1},{"text":"ao kumukeba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Efraimu ali sie nga nkunda,","poem":1},{"text":"tezi kukokola kubeepua, kabili tali na maano.","poem":2},{"text":"Musita umo aliwakuuta ku Misri,","poem":1},{"text":"ni unge musita aliwaya ku Asuria.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Mu lwendo lwabo nakaba kubateela bukila,","poem":1},{"text":"nakaba kubakula ni kubaponiizia pansi nga tooni twa mu lweleele.","poem":2},{"text":"Pankaba kunvua nangue balimukukolonghana pamo,","poem":1},{"text":"nakaba kubakwata.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Lisyamo lyabo,","poem":1},{"text":"pantu bakinfunghamina!","poem":2},{"text":"Busanzo buli pali bene,","poem":1},{"text":"pantu bakinsangukila.","poem":2},{"text":"Ntonene kubalubula,","poem":1},{"text":"inzi baliban'mbeepezia.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tebalimukundilila na mitima yabo yonse,","poem":1},{"text":"inzi balimukuloosia baleele pa malita abo.”","poem":2},{"text":"Balimukukolonghana pamo balomba baleza babo","poem":1},{"text":"pa mulandu wa nghano ni pa mulandu wa divai ya lenu.","poem":2},{"lineBreak":true},{"text":"Baba bantu banfunghamiine.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Ndinabasambilizia ni kubakoselezia,","poem":1},{"text":"inzi balibankambila.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Tebezi kumubwelela Kabezia Mpungu.","poem":1},{"text":"Bali nga buta busifimbile.","poem":2},{"text":"Banombozi babo baakeepawa na kipanga","poem":1},{"text":"pa mulandu wa twebo twabo twa bukisanguka.","poem":2},{"text":"Ni pakako, baakafuupulua","poem":1},{"text":"mu kyalo kya Misri.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/HOS/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/6.json","previousChapterAudioLinks":{},"numberOfVerses":16}