{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":8,"content":[{"type":"heading","content":["Kubyala mwela ni kuzombola mulula"]},{"type":"verse","number":1,"content":[{"text":"“Biika ntandala ku kanua kobe!","poem":1},{"text":"Kipungu kili peulu nghanda yakua Yawe","poem":2},{"text":"pantu bantu bakityona kipingo kyane","poem":1},{"text":"ni kusangukila mizilo yane.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Izraeli wandilila,","poem":1},{"text":"‘We Leza wetu, tukumanine!’","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Inzi Izraeli wakikaana kiweme.","poem":1},{"text":"Mulwani wakaba kumukumbizia.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Balibabiika makolo pasili kutona kwane,","poem":1},{"text":"balibasaakula babiloolo tekuba nabapeele nsambu.","poem":2},{"text":"Balibaikitila mikisi ya mutofue ni ya oro","poem":1},{"text":"mu kwileetelela lwinoono.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwe Basamaria, pooze mukisi wenu wa nghombe ndume!","poem":1},{"text":"Nene n'mbafiitiilue,","poem":2},{"text":"baakaba batiikeenetiikeene sie mpaka musitaki?","poem":1}]},{"type":"verse","number":6,"content":[{"text":"Ozu mukisi wa nghombe musoka ufumine ku Izraeli!","poem":2},{"text":"Ukitilue na muntu amanine ozo mwilo. Ozo mukisi te Leza.","poem":1},{"text":"Mukisi wa Basamaria","poem":2},{"text":"wakaba kutyonua tuputu tuputu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"“Balibabyala mwela","poem":1},{"text":"ni kuzombola mulula.","poem":2},{"text":"Musense usili na musokoti,","poem":1},{"text":"teuvinda kufumia bunga.","poem":2},{"text":"Ufumiengeko mbezu,","poem":1},{"text":"baeni nga baitelekele.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Izraeli atelekelue,","poem":1},{"text":"evi ali pa bukata bwa ntundu","poem":2},{"lineBreak":true},{"text":"nga kintu kya mpuni.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Pantu bakisela ku Asuria,","poem":1},{"text":"nga punda wa mu kisonso aliwaendooka bunke.","poem":2},{"lineBreak":true},{"text":"Efraimu waki-isisia ye mwine ku batonua.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Anzia kine bai-isisiizie bo bene pa ntundu,","poem":1},{"text":"nakaba kubakolonghania pamo.","poem":2},{"text":"Bakaba kubamba konda na kubiibikiziiwa na likolo wa maka.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"“Anzia kine Efraimu waakuulile bitale bingi bya ngelelo ya bibalo,","poem":1},{"text":"bya-alukile bitale bya kukitilapo bibalo.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Naabalembeele bintu bingi palua mizilo,","poem":1},{"text":"inzi baabimwene nga kintu kyeni.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Anzia kine balimukungelela ngelelo kuba bupe,","poem":1},{"text":"kabili anzia kine balimukulia nama,","poem":2},{"lineBreak":true},{"text":"Yawe tabawamiinue.","poem":2},{"text":"Evi wene wakaba kulanguluka bubi bwabo","poem":1},{"text":"ni kubakanda pa bibalo byabo.","poem":2},{"lineBreak":true},{"text":"Bakaba kubwelela ku Misri.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Izraeli wakimulaba Kabumba wakue,","poem":1},{"text":"ni kukuula nghanda ingi ya bukolo.","poem":2},{"lineBreak":true},{"text":"Mu mizi ingi Yuda wakikuulamo byubo.","poem":2},{"text":"Inzi nakaba kutuma mulilo mu mizi yabo,","poem":1},{"text":"mulilo wakaba kufita byubo byabo.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/HOS/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/7.json","previousChapterAudioLinks":{},"numberOfVerses":14}