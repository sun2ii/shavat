{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"HOS","translationId":"tap_twf","name":"HOSEA","commonName":"HOSEA","title":"KITABU KYAKUA HOSEA","order":28,"numberOfChapters":14,"sha256":"f76223be088349655a786922f7ee2bd492d362c9657a28f08a82cc1d36d1cfdc","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/HOS/1.json","lastChapterNumber":14,"lastChapterApiLink":"/api/tap_twf/HOS/14.json","totalNumberOfVerses":195},"chapter":{"number":9,"content":[{"type":"heading","content":["Kukandua kwakua Izraeli"]},{"type":"verse","number":1,"content":[{"text":"We Izraeli, tekuwaminua,","poem":1},{"text":"tekusangalala nga Bazima.","poem":2},{"text":"Pantu tewakiba wa kisinka kuli Leza obe,","poem":1},{"text":"utonene kuongua mu bukambue","poem":2},{"text":"mu nkendo yonse ya kupuulilamo nghano.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kipuulilo kya nghano ni kya kutikilamo divai,","poem":1},{"text":"tekikabeekusia.","poem":2},{"lineBreak":true},{"text":"Divai ya lenu yaakaba yabakeepeele.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Tebakeekala mu kyalo kyakua Yawe,","poem":1},{"text":"Efraimu waakabwelela ku Misri","poem":2},{"lineBreak":true},{"text":"ni kulia bilio bitiikeene mu Asuria.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tebakamupongwela Yawe bupe bwa divai,","poem":1},{"text":"ngelelo yabo teikikamuwamina.","poem":2},{"text":"Ngelelo ya ozo musango kuli bene yaakaba nga mukate wa balia balimukuloosia.","poem":1},{"text":"Bonse balibalia bebio bilio baakaba batiikeene.","poem":2},{"text":"Bebi bilio bilikuya byali bya bo bene.","poem":1},{"text":"Tekuti bitwalue mu Nghanda yakua Yawe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mwaakakitaki mu busiku bwa nsikunkulu yenu ibiikilue,","poem":1},{"text":"pa busiku bwa nsikunkulu yakua Yawe?","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Anzia kine bapusuka mu busanzo,","poem":1},{"text":"Misri wakaba kubakolonghania,","poem":2},{"lineBreak":true},{"text":"ni Memfisi wakaba kubaziika.","poem":2},{"text":"Kipao kyabo kya mutofue kyaakamenamo mikunkuli,","poem":1},{"text":"ni myunga yakaba kukupilila mitanda yabo.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Nsiku ya kukandua yapalama,","poem":1},{"text":"nsiku ya kusaziiwa yakumana.","poem":2},{"lineBreak":true},{"text":"Izraeli amane evio.","poem":2},{"text":"Pantu bibalo byenu byavulisia","poem":1},{"text":"ni bulwani bwenu bwatanisia,","poem":2},{"text":"kabika amwenue kuba kipuba,","poem":1},{"text":"muntu alombwelue na mweo,","poem":2},{"lineBreak":true},{"text":"kuba wa luuba.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Kabika ali ni Leza wane,","poem":1},{"text":"i musungi pali Efraimu.","poem":2},{"text":"Anzia kili evio, miteo imupembeele","poem":1},{"text":"monse mu-aliwapita,","poem":2},{"lineBreak":true},{"text":"bulwani ni bo mu Nghanda yakua Leza wakue.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bakikila kwi-ingizia mu bituulilo","poem":1},{"text":"nga vikyaali mu nsiku yakua Gibea.","poem":2},{"noteId":8},{"text":"Leza waakalanguluka bubi bwabo","poem":1},{"text":"ni kubakanda pa mulandu wa bibalo byabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"“Lunaamusangile Izraeli,","poem":1},{"text":"kyaali kyali nga kusanga mizabibu mu kaseeba.","poem":2},{"text":"Lunaamwene babikolue benu,","poem":1},{"text":"kyaali kyali nga kumona mazabo a kutendekelapo a ku kimuti kya miku.","poem":2},{"text":"Inzi lubaafikile ku Baali-Peori","poem":1},{"text":"baizuukiizie bo bene ku mikisi ya busoni,","poem":2},{"text":"ni bo baitiikaaniizie","poem":1},{"text":"nga kintu kibaatonene bo bene.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Bulumba bwakua Efraimu bwaakapupuka nga koni,","poem":1},{"text":"tekuli kuvyala, tekuli liimi, tekuli kwimita.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Anzia balela baana,","poem":1},{"text":"naakabeepaya, tekuli waakasyalapo.","poem":2},{"text":"Lisyamo lyabo","poem":1},{"text":"musita unakaba kubafunghamina!","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Efraimu naamumwene nga Tiro,","poem":1},{"text":"abyelue pa bulongo bufukile,","poem":2},{"text":"inzi Efraimu waakatwala","poem":1},{"text":"baana bakue ku bangipaani.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"We Yawe, bapeele,","poem":1},{"text":"kubako ulikubapeelaki?","poem":2},{"text":"Bapeele tuvumo twa kupulumuna","poem":1},{"text":"ni kukama kwa mabeele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"“Pa mulandu wa bubi bwabo bonse buli mu Gilgali,","poem":1},{"text":"momo i munaabasuliile.","poem":2},{"text":"Pa mulandu wa bikitua byabo bya bibalo,","poem":1},{"text":"nakaba kubakumba mu nghanda yane.","poem":2},{"text":"Nsikikaba kubatona,","poem":1},{"text":"pantu banombozi babo bonse ni babisanguka.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Efraimu wakiinoonua,","poem":1},{"text":"musila wabo wakifumpa,","poem":2},{"lineBreak":true},{"text":"tebakilimukuseekako buzabo.","poem":2},{"text":"Anzia kine bakaba kuvyala baana,","poem":1},{"text":"nakaba kwipaya mazabo a mponvu a mavumo abo.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"Leza wane waakabakaana","poem":1},{"text":"pantu tebaali bamunvua.","poem":2},{"text":"Baakaba baya banukunta mu ntundu.","poem":1}]}],"footnotes":[{"noteId":8,"caller":"+","text":"9.9 Gibea: Ku ozu muzi Baizraeli bamo ba mu mukowa wakua Benyamina baakitile bibiipile ku muka Mulawi. Keki kintu kyaaleetele bului bukata ni kulengia bantu ba mu mukowa wakua Benyamina kukumbua (mona Bap 19—21).","reference":{"chapter":9,"verse":9}}]},"thisChapterLink":"/api/tap_twf/HOS/9.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/HOS/10.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/8.json","previousChapterAudioLinks":{},"numberOfVerses":17}