{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"JOL","translationId":"tap_twf","name":"YOELI","commonName":"YOELI","title":"KITABU KYAKUA YOELI","order":29,"numberOfChapters":3,"sha256":"08e5bebc399d867933924c52de519c60b497cf3ad0f633ab3555e845447c6b61","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tap_twf/JOL/3.json","totalNumberOfVerses":72},"chapter":{"number":1,"content":[{"type":"verse","number":1,"content":["Mpunda ya keebo kakua Yawe yaizile kuli Yoeli mwana mwina Petueli ni ezi."]},{"type":"heading","content":["Busakukilo bwa luzie"]},{"type":"verse","number":2,"content":[{"text":"Mwe masiiko unvue kaka keebo,","poem":1},{"text":"mwe bekazi bonse ba mu kyalo kya Yudea twilizie!","poem":2},{"text":"Kubako kintu kya ozu musango kyaakitikilepo kale mu nsiku yenu,","poem":1},{"text":"ao mu nsiku ya babikolue benu?","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kaka keebo mukabe kwanako baana benu,","poem":1},{"text":"baana benu ni bo bakaaneko baana babo,","poem":2},{"lineBreak":true},{"text":"ni babo baana babo bakaaneko nvyalo yaakakonkapo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Belia byaasiilueko na balyambala,","poem":1},{"text":"byaaliilue na kisepe kya luzie.","poem":2},{"text":"Byaasiilueko na kisepe kya luzie,","poem":1},{"text":"byaaliilue na bazingilila.","poem":2},{"text":"Ni byaasiilueko na bazingilila,","poem":1},{"text":"byaaliilue na mifwinzi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwe bakyakolua, buuke mulile.","poem":1},{"text":"Mwe bamini ba divai, angule.","poem":2},{"text":"Angule pa mulandu wa divai ya lenu,","poem":1},{"text":"pantu mwakipokua ku milomo yenu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kisepe kya luzie kyakisakukila kyalo kyane,","poem":1},{"text":"kisepe kya luzie lusililwapendeka,","poem":2},{"text":"lolo luli ni meeno a nkalamu,","poem":1},{"text":"ni luli ni lumuma lwa nkalamu mukota.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lwakiinoona mizabibu yane,","poem":1},{"text":"lwakilovia miku yane,","poem":2},{"text":"lwakyubulako mamba,","poem":1},{"text":"lwaki-apooza kule.","poem":2},{"lineBreak":true},{"text":"Lwakisia misambo yaswetele sie pepepe.","poem":2}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Lila nga kinundue avwele lisaaka,","poem":1},{"text":"kinundue onvwile bulanda pa mulandu wa kufwilua na musakua wakue.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Bupe bwa misenga ya nghano ni bupe bwa bya kumina,","poem":1},{"text":"tebukili bwaleetua mu nghanda yakua Yawe.","poem":2},{"text":"Ni pakako, balia babitambua balibabomba ntanzi yakua Yawe,","poem":1},{"text":"bali mu malilo.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Makaba ainoonua,","poem":1},{"text":"musili waumina.","poem":2},{"text":"Tekukili nghano,","poem":1},{"text":"tekukili divai ya lenu,","poem":2},{"lineBreak":true},{"text":"mafuta a mizeituni akama.","poem":2}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Mwe balimi polokelue,","poem":1},{"text":"mwe balimi ba mizabibu lile.","poem":2},{"text":"Unvue bulanda pa mulandu wa nghano ni shairi,","poem":1},{"text":"pantu buzombozi bwa mu makaba enu bwainoonua.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Misila ya mizabibu teisyaumine.","poem":1},{"text":"Bimuti bya miku tebisyafumpile.","poem":2},{"text":"Bimuti bya komamanga ni bya bunkindu pamo ni bya pome,","poem":1},{"text":"byonse tebisyaumine.","poem":2},{"text":"Kisinka nsansa ya bantu teisyapwile.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Mwe babitambua, vwale masaaka mulile,","poem":1},{"text":"mwe balibabombela ku kitale, loosie.","poem":2},{"text":"Ize mupunge busiku bonse mwavwele masaaka.","poem":1},{"text":"Mwe balibabombela Leza wane,","poem":2},{"text":"pantu bupe bwa misenga ya nghano ni bupe bwa bya kumina","poem":1},{"text":"tebukili bwaleetua mu Nghanda yakua Yawe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Punde palua kuizilika kuzuuke.","poem":1},{"text":"Kuute libumba lya bazuuke.","poem":2},{"text":"Kuute masiiko","poem":1},{"text":"pamo ni bonse bekeele mu kyalo,","poem":2},{"text":"baye mu Nghanda yakua Yawe Leza wenu,","poem":1},{"text":"ni kumulilila Yawe.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Lisyamo pa bobo busiku!","poem":1},{"text":"Pantu busiku bwakua Yawe bwapalama,","poem":2},{"lineBreak":true},{"text":"bwakaba kwiza nga lwinoono kufuma kuli wa Maka onse.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Twimweneene na menso etu bilio vibisikilibyamoneka,","poem":1},{"text":"ni mu nghanda yakua Leza vimusikili nsansa ni musangalalo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mbezu teisyaumine mu bibungulu bya bulongo buume.","poem":1},{"text":"Mu milue temukili kantu,","poem":2},{"text":"milue ya bilio yatuutua,","poem":1},{"text":"pantu temukili kantu.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Mone nghombe vi-ilimukulila!","poem":1},{"text":"Bisepe bilimukwema","poem":2},{"text":"pantu tebikili na bilio.","poem":1},{"text":"Bisepe bya mikooko ni byo bilimukwema.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"We Yawe nakukuuta.","poem":1},{"text":"Nakukuuta pantu mulilo wazizia bikusi bya mu kisonso.","poem":2},{"lineBreak":true},{"text":"Ni libeebe lyazizia bimuti byonse bya mu makaba.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nama yonse ya mu kisonso ni yo yakulilila,","poem":1},{"text":"pantu twezi twa menda twakikama.","poem":2},{"lineBreak":true},{"text":"Mulilo wazizia bikusi byonse bya mu kisonso.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/JOL/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/JOL/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/HOS/14.json","previousChapterAudioLinks":{},"numberOfVerses":20}