{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"JOL","translationId":"tap_twf","name":"YOELI","commonName":"YOELI","title":"KITABU KYAKUA YOELI","order":29,"numberOfChapters":3,"sha256":"08e5bebc399d867933924c52de519c60b497cf3ad0f633ab3555e845447c6b61","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/JOL/1.json","lastChapterNumber":3,"lastChapterApiLink":"/api/tap_twf/JOL/3.json","totalNumberOfVerses":72},"chapter":{"number":2,"content":[{"type":"heading","content":["Bupinguzi bwakua Yawe"]},{"type":"verse","number":1,"content":[{"text":"Lizie ntandala mu Sayuni,","poem":1},{"text":"Punde pa lupili lwane luzuuke.","poem":2},{"text":"Bekala kyalo bonse batutume","poem":1},{"text":"pantu busiku bwakua Yawe bwapalama, pasia bufike.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Bwaakaba busiku bwa nfinzi ni bulanda,","poem":1},{"text":"busiku bwa malezi ni kifutika.","poem":2},{"text":"Nga vilivyakumana kakula mwaya mpili,","poem":1},{"text":"i vilimukwiza ni kisepe kya maka kya luzie.","poem":2},{"text":"Kutula pa kale tepanakitike kintu nga keki,","poem":1},{"text":"kabili tekikabako ku nvyalo ilimukwiza.","poem":2}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ku ntanzi ya luzie, mulilo ulimukuzizia.","poem":1},{"text":"Ku kyamba, libeebe lilimukutuutuuka.","poem":2},{"text":"Ku ntanzi ya luzie, kyalo kili nga bukaba bwa mu Edeni.","poem":1},{"text":"Ku kyamba kya luzie, kuli nga kaseeba ka kutiinia.","poem":2},{"lineBreak":true},{"text":"Tekuli kyaapusukile pasili kwinoonua na luzie.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Nmonekelo ya lolo luzie luli nga farasi.","poem":1},{"text":"Lwendele lubilo nga baseli ba pa farasi.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ni katuuto nga katuuto ka matyakala a bului,","poem":1},{"text":"koku lwalimukusontoka peulu lupili","poem":2},{"text":"lwatuuta nga libebe lilimukuzizia bikusi byume,","poem":1},{"text":"nga balukale ba maka batanteeme ku bului.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Musita ululilwamoneka, ntundu iliyatiina.","poem":1},{"text":"Kubalua muntu aliwatooboka.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Lolu luzie lulilwasakukila nga bantu ba bului.","poem":1},{"text":"Lulilwasela mu bibumba nga balukale.","poem":2},{"text":"Lonse lulilwasela mu milongo","poem":1},{"text":"pasili kusalanghana mu milongo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Lulilwaya pasili kutintana.","poem":1},{"text":"Kubalua luzie lulilwaya lwalungheeme ku ntanzi.","poem":2},{"text":"Lulilwapulania lusako","poem":1},{"text":"pasili kusalanghana mu milongo.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Lulilwaya mu muzi lwali lubilo.","poem":1},{"text":"Lulilwakunduka mu bibumba.","poem":2},{"text":"Lulilwaingila mu nghanda.","poem":1},{"text":"Lulilwaingila kupitila mu nzota nga bakabooko.","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ntanzi ya luzie, kyalo kiliyakwaka.","poem":1},{"text":"Myulu iliyasunkeena.","poem":2},{"text":"Koba ni kwezi bilibya-aluka nfinzi.","poem":1},{"text":"Ntanda ni yo iliyazima.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Yawe wa-ana libumba lya balukale bakue walimukubuluma.","poem":1},{"text":"Balukale bakue tebezi kupendeka.","poem":2},{"text":"Kuluma kuli ku balia balukale,","poem":1},{"text":"balukale banakiile mafunde akue.","poem":2},{"text":"Busiku bwakua Yawe bwaviizie,","poem":1},{"lineBreak":true},{"text":"bwene busiku bwa kutiinia.","poem":1},{"text":"Kubako nani alikuvinda kubusipikizia?","poem":2}]},{"type":"heading","content":["Lwito lwa bulapilo"]},{"type":"verse","number":12,"content":[{"text":"Yawe walanda evi,","poem":1},{"text":"“Lapile na mitima yenu yonse mun'mbwelele.","poem":2},{"lineBreak":true},{"text":"Iizilike mulile ni kuloosia.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kaate mitima yenu mu kulanga bulanda,","poem":1},{"text":"tekuba ngubo yenu.”","poem":2},{"lineBreak":true},{"text":"Mubwelele Yawe Leza wenu","poem":1},{"text":"wene ali ni buwame pamo ni nkumbu.","poem":2},{"text":"Wene tezi kulenga kufiitua, ali ni ntono ingi,","poem":1},{"text":"aliwaeleela lyonse, ni kuya wali lebe mu kukanda.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nani amanine nangue Yawe Leza wenu kuti wa-alulula malanga akue?","poem":1},{"text":"N'manine nangue Yawe kuti wamipaala na kumipeela buzombozi bwingi,","poem":2},{"lineBreak":true},{"text":"evi ni mwe mumwelele nghano ni bya kumina.","poem":2}]},{"type":"line_break"},{"type":"verse","number":15,"content":[{"text":"Lizie ntandala mu Sayuni,","poem":1},{"text":"punde kuizilika kuzuuke,","poem":2},{"lineBreak":true},{"text":"kuute libumba lilonghaane.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Kolonghanie bantu.","poem":1},{"text":"Zuukie libumba,","poem":2},{"text":"kolonghanie bakote,","poem":1},{"text":"kolonghanie baana,","poem":2},{"text":"balia bakilibaonka.","poem":1},{"text":"Syabuinga afume mu muputule wakue,","poem":2},{"text":"nabuinga ni ye afume mu muputule wakue.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Balia babitambua balibabomba ntanzi yakua Yawe,","poem":1},{"text":"balile pa bukata bwa nghingililo ya Nghanda yakua Leza ni kitale.","poem":2},{"text":"Balande nangue, “We Yawe eleela bantu bobe.","poem":1},{"text":"Tekulekelela bupyani bobe kuleebulua na twebo twa kapuni pa ntundu.","poem":2},{"text":"Ale ni kiki kibalikulandila pa bantu nangue,","poem":1},{"text":"‘Leza wabo ali pi?’”","poem":2}]},{"type":"heading","content":["Bwasuko bwakua Yawe"]},{"type":"verse","number":18,"content":[{"text":"Pa kyamba, Yawe waunvwiliile bunkua kyalo kyakue,","poem":1},{"text":"ni kunvwila nkumbu bantu bakue.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Yawe waabaasukile evi,","poem":1},{"text":"“Unvue, nakaba kumitumina bilio,","poem":2},{"text":"divai ya lenu pamo ni mafuta a mizeituni,","poem":1},{"text":"bebio byakaba kumiikusia ni kumiwamina.","poem":2},{"lineBreak":true},{"text":"Nsikikamilekelela kuleebulua na ntundu inge.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Nakaba kufumia kisepe kya luzie kifumine ku nkungua","poem":1},{"text":"ni kukikumbila kule lya ku kaseeba mu musili uume.","poem":2},{"text":"Luzie lwakaba lwali mu milongo lya ku ntanzi ku kabanga, naakalupooza mu Lyezi lya Mukele,","poem":1},{"text":"lolia lwaakaba lwali ku kyamba lya ku mboosi naakalupooza mu Lyezi lya Mediterania.","poem":2},{"text":"Luzie lufwile lwakaba kufumia bunu bubiipile,","poem":1},{"text":"ni kununka kwa lolo luzie kwaakasalanghana.”","poem":2},{"text":"Kisinka Yawe wakikita bintu bikata!","poem":1}]},{"type":"line_break"},{"type":"verse","number":21,"content":[{"text":"“We kyalo kya Yudea tekutiina.","poem":1},{"text":"Waminua usangalale.","poem":2},{"lineBreak":true},{"text":"Kisinka Yawe wakikita bintu bikata!","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Mwe binama bya mu kisonso tekutiine","poem":1},{"text":"pantu bikusi bya mu kisonso byavumba paakale.","poem":2},{"text":"Bimuti byabamba kuseekako mazabo.","poem":1},{"text":"Bimuti bya miku pamo ni mizabibu byatwamako mazabo engi.","poem":2}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"“Sansamuke mwe bantu ba mu Sayuni.","poem":1},{"text":"Sangalale muli Yawe Leza wenu","poem":2},{"text":"pantu wakimipeela nvula ya muloboko.","poem":1},{"text":"Wene ni wa kisinka.","poem":2},{"text":"Aliwaminokiizia nvula ya muvumbi,","poem":1},{"text":"nvula ya muloboko ni ya kawalala nga viyaali yanoka pa mambo.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Nghano yaakeezula pa tubanga twa kupupiiziapo.","poem":1},{"text":"Ngeso yaakeezulamo divai ya lenu pamo ni mafuta a mizeituni.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Ne Yawe naakamibweziizia belia byaalilue na luzie mu myaka yaapitile,","poem":1},{"text":"byaaliilue na luzie ni balyambala pamo ni mifwinzi,","poem":2},{"lineBreak":true},{"text":"kisepe kyane kikata kinaatumine pakati kenu.”","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Mwaakaba ni bilio bingi bya kulia ni kwikuta.","poem":1},{"text":"Mwaakamutasia Yawe Leza wenu,","poem":2},{"lineBreak":true},{"text":"Yawe waamikitiile tupapo.","poem":2},{"lineBreak":true},{"text":"Bantu bane tebakikamoniwa busoni.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Papo i pamwaakamana nangue ndi pamo nenu mu Izraeli.","poem":1},{"text":"Mwaakamana nangue nene ndi Yawe Leza wenu,","poem":2},{"lineBreak":true},{"text":"kabili tekuli unge.","poem":2},{"lineBreak":true},{"text":"Bantu bane tebakikamoniiwa busoni.","poem":2}]},{"type":"heading","content":["Bulayo bwa Mweo Muzuuke"]},{"type":"verse","number":28,"content":[{"text":"“Pa kyamba, naakakoosia Mweo wane pa bantu bonse.","poem":1},{"text":"Baana benu balalume ni banakazi baakabikula.","poem":2},{"lineBreak":true},{"text":"Bakote benu baakaloota bilooto,","poem":2},{"lineBreak":true},{"text":"ni balumendo benu baakamona bimonua.","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Pa babombi bane balalume ni banakazi ni po","poem":1},{"text":"mu ezio nsiku naakakoosiiziapo Mweo wane.","poem":2}]},{"type":"line_break"},{"type":"verse","number":30,"content":[{"text":"“Naakalanga tulangi mu myulu ni pa kyalo,","poem":1},{"text":"mulopa ni mulilo pamo ni mapumpu a kyunsi kitikeeme.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Koba kaakaalulua nfinzi,","poem":1},{"text":"ni kwezi waakakasika nga mulopa,","poem":2},{"lineBreak":true},{"text":"ntanzi ya kwiza kwa bobo busiku bukata bwa kutiinia bwakua Yawe.","poem":2}]},{"type":"verse","number":32,"content":[{"text":"Inzi kubalua muntu aliwakuuta","poem":1},{"text":"mu liina lyakua Yawe waakapususiiwa.","poem":2},{"text":"Pantu peulu Lupili lwa Sayuni ni mu Yeruzalemu,","poem":1},{"text":"mwaakaba bupusuko nga mwaalandiile Yawe","poem":2},{"text":"palua balia baapusukile,","poem":1},{"text":"baakuutilue na Yawe.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/JOL/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/JOL/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/JOL/1.json","previousChapterAudioLinks":{},"numberOfVerses":32}