{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"JON","translationId":"tap_twf","name":"YONA","commonName":"YONA","title":"KITABU KYAKUA YONA","order":32,"numberOfChapters":4,"sha256":"75126a730d25e4bcd755d1d4c4eed9ddead106805b469087a6b0e18c136581d5","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tap_twf/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Mapepo akua Yona"]},{"type":"verse","number":1,"content":["Yona lu-aali munda mwa lisabi waatendekele kumulomba Yawe Leza wakue walanda nangue,"]},{"type":"verse","number":2,"content":[{"text":"“Pa musita wa maavia ane naamulombele Yawe,","poem":1},{"text":"ni ye wangasukile.","poem":2},{"text":"Lunaali mukati kilibu naalombele bukwasi,","poem":1},{"text":"ni we waunvwile lizui lyane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Pantu wan'mpoozele pazikiisie,","poem":1},{"text":"mukati buziba,","poem":2},{"lineBreak":true},{"text":"naazyungulukiilue na menda engi,","poem":2},{"lineBreak":true},{"text":"mabimbi obe onse pamo ni kusana kwakue byan'mpitile peulu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Naalandile nangue, naapozelue kule ni wewe,","poem":1},{"text":"anzia evio, naakakenta kabili ku Nghanda yobe izuuke.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mutima uzyungulukiilue na menda,","poem":1},{"text":"nkupilue na buziba,","poem":2},{"lineBreak":true},{"text":"mutue wane ukupilue na bikusi bya pa menda.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Naakookeele kwinsina mpili,","poem":1},{"text":"kyalo ni minkolonto yakue byankilikiile nsiku ingi,","poem":2},{"text":"anzia evio, wewe waaseziizie bukose bwane kufuma mu kilibu,","poem":1},{"text":"we Yawe Leza wane.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Mutima mukati mwane luwaapenzukile,","poem":1},{"text":"naamulangulukile Yawe,","poem":2},{"lineBreak":true},{"text":"ni mapepo ane aafikile kuli wewe mu Nghanda yobe izuuke.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Balia balibapupa mikisi ya mpuni,","poem":1},{"text":"balibamufunghamina Yawe ni kukaana ntono yakue.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Inzi nene naakazanzula lizui lya malumbo,","poem":1},{"text":"naakakwelela ngelelo.","poem":2},{"lineBreak":true},{"text":"Naakafikilizia kilapo kinaalapile.","poem":2},{"text":"Bupusuko bulibwafuma kuli Yawe.”","poem":1}]},{"type":"verse","number":10,"content":["Kupwako, Yawe wa-ana lisabi liye limulukile Yona kunze."]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":10}