{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"PRO","translationId":"tap_twf","name":"MAPINDA","commonName":"MAPINDA","title":"KITABU KYA MAPINDA","order":20,"numberOfChapters":31,"sha256":"68dceb76de91060ad5f1eab2b0feedea0a438ee680d27984061f1667174dd888","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tap_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":2,"content":[{"type":"heading","content":["Kilambu kya mulangue"]},{"type":"verse","number":1,"content":[{"text":"We mwana wane, kine waitabila twebo twane,","poem":1},{"text":"ni kusunga bwino mafunde ane mukati mobe,","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pamo ni kuteya kutui kobe kuti kutwilizie mulangue,","poem":1},{"text":"ni kunvwisia mu mutima obe,","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Kisinka kine wamukuuta mulangue,","poem":1},{"text":"ni kumana wamuzanzwila lizui,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Kabili kine wabakeba nga mutofue,","poem":1},{"text":"ni kubakebelezia nga bukonto bufiikilue,","poem":2}]},{"type":"verse","number":5,"content":[{"text":"I paulikumana vya kumutiina Yawe,","poem":1},{"text":"ni kwinika vya kumumana Leza.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Pantu Yawe aliwapeela bantu mulangue,","poem":1},{"text":"mu kanua kakue mulimwafuma bukengezi ni kumana.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Aliwabiikila balunghami bukonto,","poem":1},{"text":"wene i kisoolelo kya balia balibaenda mu kisinka.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Aliwalabukila nghendelo ya bantu balibakita bintu bya nsambu,","poem":1},{"text":"ni kusunga nzila ya bazuuke bakue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kine wewe wantwilizia ulikwinika bulunghami ni nsambu pamo ni kisinka.","poem":1},{"text":"Ulikwinika kubalua nzila iweme.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Pantu mulangue alikwingila mu mutima obe,","poem":1},{"text":"ni maano alikusansamusia bukose bobe.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Kwinika kulikukusunga,","poem":1},{"text":"ni kumana kulikukulabukila.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Mulangue alikukupususia mu nzila ya babi,","poem":1},{"text":"ni ku bantu balibalanda twebo tubi.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Bantu balibasia nzila ilungi","poem":1},{"text":"pakuti bende mu nzila ya nfinzi,","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Bantu balibawaminua kukita bibiipile,","poem":1},{"text":"ni kusansamukila mu bupompo bwa bubi,","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Tusansaila twabo, ni twa mampetompeto,","poem":1},{"text":"ni nzila yabo teyololokele.","poem":2}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Mulangue alikukupususia ku mwanakazi mukambue,","poem":1},{"text":"ku mwanakazi mweni ali ni twebo twa kubembia.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Mwanakazi aliwasia kibuza wa mu bukazyana bwakue,","poem":1},{"text":"ni kulaba kipingo kyakua Leza wakue.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Kisinka nghanda yakue ilungi ku lufu,","poem":1},{"text":"ni ku bafwile i kulungheeme nzila yakue.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Bonse balibaya kuli wene, tepali aliwabwela,","poem":1},{"text":"ao kubwelela ku nzila ya bukose.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Ni pakako upalile kuya waendela mu nzila ya bantu baweme,","poem":1},{"text":"ni kukonka mibeele ya balunghami.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Pantu balunghami baakeekala mu kyalo,","poem":1},{"text":"ni basili na kabi baakeekalililamo.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Inzi babi baakafumiiwa mu kyalo,","poem":1},{"text":"ni bankitatubi baakanukuluamo.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}