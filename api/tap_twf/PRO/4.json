{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"PRO","translationId":"tap_twf","name":"MAPINDA","commonName":"MAPINDA","title":"KITABU KYA MAPINDA","order":20,"numberOfChapters":31,"sha256":"68dceb76de91060ad5f1eab2b0feedea0a438ee680d27984061f1667174dd888","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tap_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":4,"content":[{"type":"heading","content":["Kibwezia kya mulangue"]},{"type":"verse","number":1,"content":[{"text":"Mwe baana bane, unvue mafunde akua sinue,","poem":1},{"text":"kabili twilizie evi mube ni maano.","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pantu ndimukumipeela mafunde aweme,","poem":1},{"text":"tekuti mukasie masambilizio ane.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Lunaali mwana mu nghanda yakua tawe,","poem":1},{"text":"nakili kalala, mwana lyonga wakua yangu.","poem":2}]},{"type":"verse","number":4,"content":[{"text":"Tawe waali wansambilizia walanda nangue,","poem":1},{"text":"“Mutima obe uye walanguluka twebo twane,","poem":2},{"lineBreak":true},{"text":"sunga milao yane, ni we ulikuya wali mukose.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Ba wali ni mulangue, ba wali ni kyunvwila","poem":1},{"text":"tekulaba ao kukaana twebo twa mu kanua kane.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Tekumusia mulangue, ni ye alikukulabukila,","poem":1},{"text":"mutone, ni ye alikukusunga.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Ntendeko ya mulangue ni ezi: Ba wali ni mulangue.","poem":1},{"text":"Anzia uzeeziiziapo byonse bi-uli nabio, kya mponvu ba wali ni kyunvwila.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Mukindike, ni ye alikukukindika.","poem":1},{"text":"Kine wamukumbatila alikukukindika.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Alikukupeela buwame kuba kitambala ku mutue obe,","poem":1},{"text":"alikukufwanizia na ngala ya bulumba.”","poem":2}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Twilizia we mwana wane, itabila bindimukulanda,","poem":1},{"text":"ni myaka ya bukose bobe ilikuvula.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Nakusambilizia nzila ya mulangue,","poem":1},{"text":"nakulombola mu tusansaila twa bulunghami.","poem":2}]},{"type":"verse","number":12,"content":[{"text":"Luuliwaenda, lutanfu lobe telukilinghaniiwa.","poem":1},{"text":"Kine wakunduka tewipuutala.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kwatisia mafunde, pasili ku-aleka aye,","poem":1},{"text":"akwatisia, pantu ene i bukose bobe.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Tekwingila mu nzila ya babi,","poem":1},{"text":"tekukonka mibeele ya bantu babi.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Leya ezio nzila, kabili tekwendamo,","poem":1},{"text":"isie uye mu nzila yobe.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Pantu tebezi kulaala kine tebanakitenke bubi,","poem":1},{"text":"ni tulo tetwizi kuoneka kine tebanapuutazie muntu.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Pantu bubi i bilio byabo.","poem":1},{"text":"Nghemo ikata i divai yabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Nzila ya balunghami ili nga kisue kya ku makia,","poem":1},{"text":"kilikyailundilako mpaka bwakiililila.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Inzi nzila ya babi ili nga nfinzi ikata,","poem":1},{"text":"ni kilikyabeepuutazia tebakimanine.","poem":2}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"We mwana wane, pooza maano ku bindimukulanda,","poem":1},{"text":"teya kutui ku twebo twane.","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Tekubifumia pa menso obe,","poem":1},{"text":"bisunge bwino mu mutima obe.","poem":2}]},{"type":"verse","number":22,"content":[{"text":"Pantu i bukose ku muntu aliwabisyukila.","poem":1},{"text":"Kabili i kutuuka kwa mubili wakue onse.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Sunga mutima obe kukila byonse biuliwasunga,","poem":1},{"text":"pantu i mulimwafuma byonse bi-uliwakita.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Sunga kanua kobe ku twebo twa bukisanguka,","poem":1},{"text":"ni milomo ya kiitoni ibe kule ni wewe.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Menso obe akente ku ntanzi,","poem":1},{"text":"ni nkopio yobe pasili kukapa.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Pooza maano mulimwapita makasa obe,","poem":1},{"text":"ni nzila yobe yonse iwamiiwe bwino.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Tekupilibukila kulio ao kuso,","poem":1},{"text":"fumia kuulu kobe mu bubi.","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/PRO/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/PRO/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/PRO/3.json","previousChapterAudioLinks":{},"numberOfVerses":27}