{"translation":{"id":"tap_twf","name":"Kitaabua New Testament","website":"https://ebible.org/Scriptures/details.php?id=tap","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tap","licenseNotes":null,"shortName":"TWF","englishName":"Kitaabua NT","language":"tap","textDirection":"ltr","sha256":"d205f6efe16a1f6dbac5da901ce6b9606b1b260ad8a28d02e9d9dc451ae3e033","availableFormats":["json"],"listOfBooksApiLink":"/api/tap_twf/books.json","numberOfBooks":12,"totalNumberOfChapters":189,"totalNumberOfVerses":5061,"languageName":"Taabwa","languageEnglishName":"Taabwa"},"book":{"id":"PRO","translationId":"tap_twf","name":"MAPINDA","commonName":"MAPINDA","title":"KITABU KYA MAPINDA","order":20,"numberOfChapters":31,"sha256":"68dceb76de91060ad5f1eab2b0feedea0a438ee680d27984061f1667174dd888","firstChapterNumber":1,"firstChapterApiLink":"/api/tap_twf/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tap_twf/PRO/31.json","totalNumberOfVerses":915},"chapter":{"number":8,"content":[{"type":"heading","content":["Bulumba bwa mulangue"]},{"type":"verse","number":1,"content":[{"text":"Eba, mulangue tezi kulila?","poem":1},{"text":"Kumana ni ye tezi kuzanzula lizui lyakue?","poem":2}]},{"type":"verse","number":2,"content":[{"text":"Pa kifuka kya pa muulu sana pepi ni nzila,","poem":1},{"text":"pa masanzyonzila i paimeene.","poem":2}]},{"type":"verse","number":3,"content":[{"text":"Mumbali mulyango wa kwingililapo mu muzi,","poem":1},{"text":"pa nghingililo, aliwasamuna,","poem":2}]},{"type":"verse","number":4,"content":[{"text":"“Mwe bantu, ndinamikuuta,","poem":1},{"text":"ni lizui lyane ni pa mulandu wa bantu.","poem":2}]},{"type":"verse","number":5,"content":[{"text":"Mwe basimanine kantu, be ni maano,","poem":1},{"text":"ni mwe babipuba, be ni mutima wa kumana.","poem":2}]},{"type":"verse","number":6,"content":[{"text":"Twilizie pantu ndi ni twa kulanda twa mponvu,","poem":1},{"text":"ndikwizula milomo yane nande twebo tulungi.","poem":2}]},{"type":"verse","number":7,"content":[{"text":"Kanua kane kalikulanda kisinka,","poem":1},{"text":"pantu bubi kunvwika mu milomo yane ni kibalo.","poem":2}]},{"type":"verse","number":8,"content":[{"text":"Twebo tonse twa mu kanua kane ni twa nsambu,","poem":1},{"text":"tepali kalubile ao kabiipile pa tonse.","poem":2}]},{"type":"verse","number":9,"content":[{"text":"Tonse tuli sie bwino ku olia amanine,","poem":1},{"text":"tulungheeme ku balia bali ni maano.","poem":2}]},{"type":"verse","number":10,"content":[{"text":"Saakula masambilizio ane kukila mutofue,","poem":1},{"text":"ni kumana kukila oro isambikile.","poem":2}]},{"type":"verse","number":11,"content":[{"text":"Pantu mulangue i aweme kukila mabue a mutengo,","poem":1},{"text":"ni bintu byonse bitonekele tebivinda kulinghaniwa nakue.","poem":2}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"“Nene, ne mulangue, ngikeele pamo ni bukengezi,","poem":1},{"text":"kwinika ni kumana ndi nabo.","poem":2}]},{"type":"verse","number":13,"content":[{"text":"Kutiina Yawe, kusuula bubi.","poem":1},{"text":"Nsuulile kiitoni, ni kwitasia, ni mibeele ibi,","poem":2},{"lineBreak":true},{"text":"pamo ni bulanzi bubi.","poem":2}]},{"type":"verse","number":14,"content":[{"text":"Nsokezi ni yane pamo ni bukengezi bwa kiine,","poem":1},{"text":"kumana ni maka ndi nabio.","poem":2}]},{"type":"verse","number":15,"content":[{"text":"Mubukwasi bwane, makolo aliateeka,","poem":1},{"text":"ni kupingula mu nsambu.","poem":2}]},{"type":"verse","number":16,"content":[{"text":"Mubukwasi bwane, bena makolo balibateeka,","poem":1},{"text":"ni babiloolo balibalombola bwino pa kyalo.","poem":2}]},{"type":"verse","number":17,"content":[{"text":"Ntonene balia bantonene,","poem":1},{"text":"ni bonse balibankeba na mute, baliban'mona.","poem":2}]},{"type":"verse","number":18,"content":[{"text":"Bunonsi ni mukinzi bili kuli nene,","poem":1},{"text":"bunonsi bulibwalunduluka pamo ni nsambu.","poem":2}]},{"type":"verse","number":19,"content":[{"text":"Mazabo ane akindeeme kukila oro,","poem":1},{"text":"ni kibwezia kyane kikilile mutofue usambikile.","poem":2}]},{"type":"verse","number":20,"content":[{"text":"Ndinaenda mu nzila ya bulunghami,","poem":1},{"text":"mu tusansaila twa nsambu,","poem":2}]},{"type":"verse","number":21,"content":[{"text":"Ndinanonsia balia bantonene,","poem":1},{"text":"ndinaizuzia kipao kyabo.","poem":2}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"“Yawe waanengele wa mambo mu miilo yakue,","poem":1},{"text":"ntanzi ya miilo yakue ya kale.","poem":2}]},{"type":"verse","number":23,"content":[{"text":"Nene kundi kutula ku mambo,","poem":1},{"text":"kyalo lukyaali tekinabeko.","poem":2}]},{"type":"verse","number":24,"content":[{"text":"Biponga lubyaali tebinabeko, naali nasyavyelue,","poem":1},{"text":"tusulo twizwilemo menda lutwaali tetunabeko.","poem":2}]},{"type":"verse","number":25,"content":[{"text":"Mpili luyaali teinabeko,","poem":1},{"text":"ntanzi ya tupili naali nasyavyelue.","poem":2}]},{"type":"verse","number":26,"content":[{"text":"Lu-aali tanalenge kyalo, ao makaba,","poem":1},{"text":"ni ntendeko ya lufunko lwa mu kyalo.","poem":2}]},{"type":"verse","number":27,"content":[{"text":"Naali nalipo lu-aali wabiika myulu,","poem":1},{"text":"lu-aali wabiika mupaka wa lyulu ni menda.","poem":2}]},{"type":"verse","number":28,"content":[{"text":"Lu-aali wabiika malezi a mu muulu,","poem":1},{"text":"ni lu-aali walumia tusulo twa menda,","poem":2}]},{"type":"verse","number":29,"content":[{"text":"Lu-aali wabiika mupaka wa lyezi,","poem":1},{"text":"evi menda tekuti apule mafunde akue,","poem":2},{"lineBreak":true},{"text":"ni lu-aakitile biputa bya kyalo.","poem":2}]},{"type":"verse","number":30,"content":[{"text":"Naali pamo nakue nga kituemambo wa miilo.","poem":1},{"text":"Naali nsansa yakue kubalua busiku.","poem":2},{"lineBreak":true},{"text":"Naali ni nsansa kubalua busiku ku menso akue.","poem":2}]},{"type":"verse","number":31,"content":[{"text":"Naali nasansamukila kyalo kikeeluemo na bantu,","poem":1},{"text":"ni nsansa yane yaali yali pamo ni bena bantu.","poem":2}]},{"type":"line_break"},{"type":"verse","number":32,"content":[{"text":"“Ni pakako, ntwilizie mwe baana bane,","poem":1},{"text":"pantu lisyuko lili na balia balibakonka nzila yane.","poem":2}]},{"type":"verse","number":33,"content":[{"text":"Unvue masambilizio ane mube ni mulangue,","poem":1},{"text":"kabili tekukaane.","poem":2}]},{"type":"verse","number":34,"content":[{"text":"Lisyuko ku olia aliwantwilizia,","poem":1},{"text":"aliwapempa kubalua busiku ku milyango yane,","poem":2},{"lineBreak":true},{"text":"wapembeele mumbali milyango yane.","poem":2}]},{"type":"verse","number":35,"content":[{"text":"Pantu olia wansanga, wasanga bukose","poem":1},{"text":"ni kupokelela buwame kuli Yawe.","poem":2}]},{"type":"verse","number":36,"content":[{"text":"Inzi olia aliwa-andua kunsanga, aliwakisia mutima wakue mwine,","poem":1},{"text":"balia bonse bansuulile, batonene lufu.”","poem":2}]}],"footnotes":[]},"thisChapterLink":"/api/tap_twf/PRO/8.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tap_twf/PRO/9.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tap_twf/PRO/7.json","previousChapterAudioLinks":{},"numberOfVerses":36}