{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"ECC","translationId":"tbz_sim","name":"Mɛborimɛ Wɛ́ìtì","commonName":"Mɛborimɛ Wɛ́ìtì","title":"Mɛborimɛ wéìtì wɑ̃̀ri dìì pɑ́tíri","order":21,"numberOfChapters":12,"sha256":"57db31906a703c1bba0cc0e742dbff7560519fa6d4eac1490659333f36ac89c4","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/ECC/1.json","lastChapterNumber":12,"lastChapterApiLink":"/api/tbz_sim/ECC/12.json","totalNumberOfVerses":221},"chapter":{"number":11,"content":[{"type":"heading","content":["Dɛ̀ wennimu ɑ bo bennɛ́mɛ̀ dɛ̀mɑrɛ̀"]},{"type":"line_break"},{"type":"verse","number":1,"content":[{"text":"Dootóo ɑ diì dibinni miɛkɛ,","poem":1},{"lineBreak":true},{"text":"dɛ̀ yó mboní kɑ̀ɑ wɛ̃tɛ kɛ́ mù pɛ̀tɛ́mu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Pɑ̃ ɑ kpɛrɛ bɛnìtìbɛ̀ bɛ̀yiekɛ̀,","poem":1},{"lineBreak":true},{"text":"bɑ́ bɛ̀ni kɛ yɛ̃́ ɑ í yɛ̃́mɛ̀ tìì nɑɑ yóó dɑ tuɔkɛní.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Fɛtɑɑfɛ̀ ɔ̃ɔ̃ kperi dɛ ĩ́nkɛ̀ kɛ́ni kɛtenkɛ̀ nkɛ.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ mutie do kubɑkù cɑ̃̀nku","poem":1},{"lineBreak":true},{"text":"yoo kuyoú mù ɔ̃ nduɔ́ mù do kùù píkù nku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Wèè weí kuyɑɑkù ò ɔ̃ɔ̃ í mbuɔtí.","poem":1},{"lineBreak":true},{"text":"Wèè bɔ́ú nyɛwɛtɛ̀ ò mɛ nhɔ̃ɔ̃ í nkɔ̃ṹ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A í yɛ̃́ mɛ̀ɛ̀ botí kuyɑɑkù keri kùù cɛ,","poem":1},{"lineBreak":true},{"text":"ɑ í mɛ nyɛ̃́ dɛbirɛ ɔ̃ɔ̃ píítɛ́ mɛ̀ɛ̀ botí","poem":1},{"lineBreak":true},{"text":"dɛ yɔ̃ pɔutì miɛkɛ kɛ́nweí.","poem":1},{"lineBreak":true},{"text":"A í mɛ nyɛ̃́ Kuyie mpĩ́mmɛ̀ ku tɔ̃mmú kunku kùù dɔ̀ɔ̀ri dɛmɔu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kɛ̀ dɛ̀ wentɛ́ ɑ buɔtí ɑ diitì.","poem":1},{"lineBreak":true},{"text":"Kuyuoku bɑ́ mmɛĩ́ ɑ nɔu","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ ɑ í yɛ̃́mɛ̀ dɛ̀ɛ̀ yóó yiénnɛ̀ dɛ̀tɛrɛ̀,","poem":1},{"lineBreak":true},{"text":"yoo kɛ̀ dɛ̀ mɛ mbo yié ndɛdɛ́, ɑ í yɛ̃́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"A bo nwúómmɛ̀ kuwenniku","poem":1},{"lineBreak":true},{"text":"dɛ̀ wentɛ́ dìì mɔ̀nnì dɛ̀ nɑɑtimu,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ fòù dɛɛ̀ wenni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kɛ̀ wèè fòù kɛ yĩ yɛbie mpɛ́u dɛ̀ nhò nɑɑti","poem":1},{"lineBreak":true},{"text":"dɛ kó yɛbie nyɛmɔu miɛkɛ,","poem":1},{"lineBreak":true},{"text":"dɛ yiɛ̀ nnɛ́ nyɛ̃́ yɛwe yɛiyɛ sũmɛ̀,","poem":1},{"lineBreak":true},{"text":"dɛ̀ɛ̀ kpɑɑní dɛ̀ í dò nkɛ́bɑntɛ́.","poem":1}]},{"type":"heading","content":["Nyɑ̃nku kɛ nɛ́ nyɛ̃́"]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Odɑpɑ̀ɑ̀ nfɔ̃́!","poem":1},{"lineBreak":true},{"text":"Dɛ̀ ndɑ nɑɑti, kɑ̀ɑ mmɔkɛ diwɛ̀ì ɑ dɑpɑ̀ntì mɔ̀nnì.","poem":1},{"lineBreak":true},{"text":"Ntũ nhɑ yɛ̀mmɛ̀ dɑ nɑ́ɑ́ ntì,","poem":1},{"lineBreak":true},{"text":"kɛ́ndɔɔri ɑ dɔ́mɛ̀.","poem":1},{"lineBreak":true},{"text":"A nɛ́ nyɛ̃́ kɛ dò nKuyie nyóó dɑ bekɛ́nɛ̀ dɛmɔu dɛ kpɛ́í.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kɛntɛ́nɛ̀ ɑmɑ́ɑ̀ dɛ̀ɛ̀ bo dɑ tɑnnɛ́ mɛyɛǹcɑɑ̀rìmɛ̀ miɛkɛ","poem":1},{"lineBreak":true},{"text":"nɛ̀ mumɔmmú kɛ yɛ̃́ tidɑpɑ̀ntì","poem":1},{"lineBreak":true},{"text":"nɛ̀ tibíkɛ́mbɛ́ntì dɛ̀ í yóó ɔɔtɛmɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/ECC/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/ECC/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/ECC/10.json","previousChapterAudioLinks":{},"numberOfVerses":10}