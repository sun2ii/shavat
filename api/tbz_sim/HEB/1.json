{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"HEB","translationId":"tbz_sim","name":"Ebedeebɛ","commonName":"Ebedeebɛ","title":"Bɛ̀ wɑ̃̀ri dìì pɑ́tíri Kirisi kɔbɛ bɛ̀ɛ̀ tu Ebedeebɛ","order":58,"numberOfChapters":13,"sha256":"fe17b0cb79dee1232f424e8b8e954bb535c5922e0008e7b686700b32cd81b917","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/HEB/1.json","lastChapterNumber":13,"lastChapterApiLink":"/api/tbz_sim/HEB/13.json","totalNumberOfVerses":303},"chapter":{"number":1,"content":[{"type":"heading","content":["Kuyie nti nɑ́ɑ́nnɛ̀ ku Birɛ nùù miɛkɛ nkɛ"]},{"type":"verse","number":1,"content":["Kuyie ndo nɑ́ɑ́nnɛ̀ ti yɛmbɛ̀ nɛ̀ ku pɑ̃ɑ̃nɑ́ɑǹtì nɑ́ɑm̀bɛ̀ nɔ̀ miɛkɛ nkɛ kucɛ mɛ̀pɛ́u, nɛ̀ mɛborimɛ pɛ́u miɛkɛ."]},{"type":"verse","number":2,"content":["Yɛmɔ̀rɛ̀ sɔnyɛ yiɛ mmiɛkɛ kɛ̀ kù ti nɑ́ɑ́nnɛ̀ ku Birɛ nùù miɛkɛ. Nɛ̀ ku Birɛ bɛɛ̀ wɛ̃nnɛ́ kɛ dɔ̀ɔ̀ kutenkù. Kù dɛ ntɑ̃ɑ̃tɛ́ kɛ̀ dɛ̀ yóó tiekɛ dɛmɔu."]},{"type":"verse","number":3,"content":["Ti yɑ̀ Yesu dɛumɛ̀ mmɛ kɛ bɑntɛ́ Kuyie ndɛumɛ̀. Weè nɑ́ɑǹtì kpeńnì kɛ tɔ kutenkù kɛ te dɛmɔu kɛ̀ dɛ̀ kérí mɛsɑ̀ɑ̀. Weè ku kɛ ũtɛ́ ti yɛi nkɛ dèè kɛ kɑ̀ri Kuyie nkùù nɔ ndɛmɔu ku bɑkù yoú."]},{"type":"heading","content":["Yesu pɛ̃ɛ̃tɛ́mɛ̀ Kuyie ntɔ̃rɛ̀"]},{"type":"verse","number":4,"content":["Yesu kpeńnìmu kɛ pɛ̃ɛ̃tɛ́ Kuyie ntɔ̃rɛ̀, Kuyie nwe n duɔ́ ndiyètìrì diɛrì, dìì dɛu kɛ pɛ̃ɛ̃tɛ́ ku tɔ̃rɛ̀ kpɛyɛ."]},{"type":"verse","number":5,"content":["Kuyie nyí nɑ̀kɛ́ ku tɔ̃nnì mɑrì kɛ yĩ:",{"text":"A tú m birɛ ndɛ yíe,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n tu ɑ cicɛ.","poem":1},"Kù mɛ nyí nɑ̀kɛ́ ku tɔ̃nnì mɑrì kɛ yĩ:",{"text":"M bo ntú ɑ cicɛ,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ ntú m birɛ.","poem":1}]},{"type":"verse","number":6,"content":["Kuyie nyóó duɔnní dìì mɔ̀nnì kutenkù miɛkɛ ku Birɛ dɛ̀ɛ̀ tu Mpo kɛ bɛ́immu kɛ dɔ̀:",{"text":"Kuyie ntɔ̃rɛ̀ ndɛ̀ bɑ̀ɑ́.","poem":1}]},{"type":"verse","number":7,"content":["Kuyie mbɛ́immu ku tɔ̃rɛ̀ kpɛ́í nkɛ yĩ:",{"text":"Kuyie nkuù cèèri ku tɔ̃rɛ̀","poem":1},{"lineBreak":true},{"text":"kɛ̀ yɛ̀ nɑɑ̀ nkuyɑɑkù,","poem":1},{"lineBreak":true},{"text":"kɛ ceeri ku tɔ̃mbɛ̀","poem":1},{"lineBreak":true},{"text":"kɛ bɛ̀ nɑɑ̀ nfɛhɑ̃ɑ̃dɛɛ̀nfɛ̀.","poem":1}]},{"type":"verse","number":8,"content":["Kɛ nɛ́ nɑ̀kɛ́ ku Birɛ kɛ yĩ:",{"text":"A tú Kuyie nku,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ kpɑ̀ɑ̀tìkɑ̀rì yó mbo sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"ɑ bɑkɛ́ nɛ̀ timɔ́mmɔnti nti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A dɔ́ timɔ́mmɔnti nti,","poem":1},{"lineBreak":true},{"text":"ɑ í dɔ́ mɛyɛi,","poem":1},{"lineBreak":true},{"text":"dɛɛ̀ te kɛ̀ Kuyie nhɑ Yiɛ̀ ndɑ tɑ̃ɑ̃tɛ́","poem":1},{"lineBreak":true},{"text":"ɑ kɔbɛ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ wɑɑrɛ ɑ yuu mɛkùɔ̀,","poem":1},{"lineBreak":true},{"text":"kɛ dɑ duɔ́ ndiwɛ̀ì.","poem":1}]},{"type":"verse","number":10,"content":["Kɛ yìɛ́ kɛ bɛ̀ nɑ̀kɛ́ kɛ yĩ:",{"text":"Fɔ̃́ nti Yiɛ̀","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ dɔ̀ɔ̀ kɛtenkɛ̀ nɛ̀ dimɔ̀nnì,","poem":1},{"lineBreak":true},{"text":"tiwɛtì tu ɑ nɔ̀ùtɛ̀ kó mutɔ̃mmú mmu.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Dɛndɛ yóó pɛ̃ɛ̃tɛ́mu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ fɔ̃́ nni mbo,","poem":1},{"lineBreak":true},{"text":"dɛ̀ yóó kótɛ́mu kuyɑ̀ɑ̀kù tɛ̃mɛ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A yóó dɛ̀ kpɛ̀úmu kuyɑ̀ɑ̀kù kɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ɛ ceetɛ.","poem":1},{"lineBreak":true},{"text":"Fɔ̃́ nyie mɛ mbɑɑ yó ndò nhɑ dòntì nti,","poem":1},{"lineBreak":true},{"text":"ɑ í deu.","poem":1}]},{"type":"verse","number":13,"content":["Kuyie nyí nɑ̀kɛ́ ku kó ditɔ̃nnì mɑrì kɛ yĩ:",{"text":"Nkɑri m bɑkù yoú","poem":1},{"lineBreak":true},{"text":"kɛ kémmúnɛ̀ m bo dɑ duɔ́mmɛ̀","poem":1},{"lineBreak":true},{"text":"ɑ dootitɔbɛ̀ kɑ̀ɑ bɛ̀ nɑ kɛ́ bɛ̀ cùùti.","poem":1}]},{"type":"verse","number":14,"content":["Bɑ ntu Kuyie ntɔ̃rɛ̀? Ku tɔ̃mbɛ̀ mbɛ kù tũɔ̃̀nní bɛ̀, kɛ̀ bɛ̀ teénnɛ̀ kù yóó dɛɛtɛ́ bɛ̀."]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/HEB/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/HEB/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PHM/1.json","previousChapterAudioLinks":{},"numberOfVerses":14}