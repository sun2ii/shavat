{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"ISA","translationId":"tbz_sim","name":"Esɑii","commonName":"Esɑii","title":"Esɑii","order":23,"numberOfChapters":66,"sha256":"60f62ae858ac2d12d04d0b774aa1d95cf69ef00c77a7b8fd7ea972cb77b4687f","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tbz_sim/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":12,"content":[{"type":"heading","content":["Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie nti dɛɛtíwè"]},{"type":"verse","number":1,"content":[{"text":"Dɛ yiè di bo yĩ́:","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nti dɑ sɑ̃ntí!","poem":1},{"lineBreak":true},{"text":"A miɛkɛ do ti yonkɛmu, di mmɔ̀nnì kɛ bonkɛ,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ ti bɑ́ntɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Di bo yĩ́: Kuyie nti dɛɛtɛ́mu,","poem":1},{"lineBreak":true},{"text":"ti tɛ̃́nkɛ í yĩɛ̃̀kù, kufɔ̃wɑɑ́ nyí ti bo,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nkuù tu ti kó muwɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"ti yó nku nsɑ̃ntí kuù ti dɛɛtɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɛ yiè di bo dó mɛniɛ nnɛ̀ diwɛ̀ì","poem":1},{"lineBreak":true},{"text":"mɛdɛɛtímɛ̀ kó tɛbintɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Dɛ yiè di bo yĩ́:","poem":1},{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"pĩɛ̃kɛ́nɛ̀ ku yètìrì.","poem":1},{"lineBreak":true},{"text":"Bɛnkɛnɛ̀ yɛbotɛ̀ ku tɔ̃mmú dɛumɛ̀,","poem":1},{"lineBreak":true},{"text":"nyɛ̃́nɛ̀ ku yètìrì dɛumɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie nkɛ yɛ̃́ kù dɔ̀ɔ̀ dɛ̀ dɛumɛ̀,","poem":1},{"lineBreak":true},{"text":"pĩɛ̃kɛ́nɛ̀ dɛ kpɛ́í kɛtenkɛ̀ kɛmɔu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Díndi Siyɔ̃ɔ̃ ɛì kɔbɛ nyɑ̃nkunɛ̀ diwɛ̀ì kɛ́nyíú,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ wèè bo di cuokɛ̀ ò dɛumɛ̀mu,","poem":1},{"lineBreak":true},{"text":"wèè te Isidɑyɛɛribɛ ò do mpɑ́íí nwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/ISA/12.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/ISA/13.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/ISA/11.json","previousChapterAudioLinks":{},"numberOfVerses":6}