{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"ISA","translationId":"tbz_sim","name":"Esɑii","commonName":"Esɑii","title":"Esɑii","order":23,"numberOfChapters":66,"sha256":"60f62ae858ac2d12d04d0b774aa1d95cf69ef00c77a7b8fd7ea972cb77b4687f","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/ISA/1.json","lastChapterNumber":66,"lastChapterApiLink":"/api/tbz_sim/ISA/66.json","totalNumberOfVerses":1290},"chapter":{"number":24,"content":[{"type":"heading","content":["Kuyie nyóó pɔntɛmɛ̀ kutenkù"]},{"type":"verse","number":1,"content":["Ti Yiɛ̀ nKuyie nyóó pɔntɛmu kɛtenkɛ̀, kɛ̀ kɛ̀ɛ̀ dɔúnko,",{"text":"kutenkù bo kóntɛ́ kɛ̀ bɛnìtìbɛ̀ɛ cíɛ́tɛ́ bɛ̀ɛ̀ tu:","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ikuɔ́ nìùbɛ̀ nɛ̀ cɛ̃́nkoo kɔbɛ.","poem":1},{"lineBreak":true},{"text":"Kudɑɑkù yiɛ̀ nnɛ̀ kudɑɑkù,","poem":1},{"lineBreak":true},{"text":"Tɛcĩ́ɛ̃̀tɛ̀ yɔ̃ nɛ̀ o kóo tɔ̃ntì,","poem":1},{"lineBreak":true},{"text":"wèè fiiti nɛ̀ wèè do,","poem":1},{"lineBreak":true},{"text":"wèè pènni nɛ̀ bɛ̀ pènni wè.","poem":1},{"lineBreak":true},{"text":"Dibɑ̀nnì yiɛ̀ nnɛ̀ ò bɑnnɛ̀ wè.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nyóó pɔntɛmu kɛtenkɛ̀ pɑ́íí,","poem":1},{"lineBreak":true},{"text":"kɛ́hɛí di kpɛrɛ, kɛ̀ di tenkɛ̀ɛ dɔúnkoo.","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù tì bɛ́i.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛtenkɛ̀ kuɔ̀mmu kɛ cĩ̀tɛ,","poem":1},{"lineBreak":true},{"text":"kutenkù cɑ̀kɛmu kɛ nɑɑ́ ntidobontì kɛ wɛ̃nnɛ́nɛ̀ kɛĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ bo kɛtenkɛ̀ ĩ́nkɛ̀ bɛɛ̀ kɛ̀ sɑ̃ũ,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ bɛ̀ bùtínnɛ́mɛ̀ Kuyie nkuɔ́,","poem":1},{"lineBreak":true},{"text":"bɛ̀ sèńtɛ́ Kuyie ntié nyi,","poem":1},{"lineBreak":true},{"text":"kɛ tɔ̃̀tɛ mɛtɑummɛ̀ mɛ̀ɛ̀ do bo sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"bɛmbɛ nɛ̀ Kuyie mbɛ cuokɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dɛɛ̀ te kɛ̀ Kuyie ncɔ̃ɔ̃ kɛtenkɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ bo kɛtenkɛ̀ kɛ̀ bɛ̀ yɑ̀u bɛ yɛi nkó mucɔ̃́ntimu,","poem":1},{"lineBreak":true},{"text":"kɛ dèè bɑ́ bɛ̀ɛ̀ kpɑɑ́ bɛ̀ tɛ̃́nkɛ í tùɔ̀kɛ dɛ̀mɑrɛ̀.","poem":1}]},{"type":"heading","content":["Mɛnɑɑ̀ ndèèmɛ̀ dihɛì kɛ̀ diwɛ̀ì dèè"]},{"type":"verse","number":7,"content":[{"text":"Fínyĩ̀ kó dɛtie mmɔ̀tɛ́mu,","poem":1},{"lineBreak":true},{"text":"mɛnɑɑ̀ pɑ̀mmɛ̀ tɛ̃́nkɛ í kpɑɑ́.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ɛ̀ yɛ̀mmɛ̀ do dò ncɑ́tírɛ́","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ tɑ mɛyɛǹcɑɑ̀rìmɛ̀ miɛkɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yɛbɑ̀rɛ̀ kó yɛdɑbùò ncĩ̀ɛ̃́kɛ́mu","poem":1},{"lineBreak":true},{"text":"kɛ̀ siyíkpèi yɛ̃ nyúóó,","poem":1},{"lineBreak":true},{"text":"kɛ̀ tibómbonti yɛ̃ nkɑ́rɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Inɑɑyɑ̃̀ɑ̃̀yìɛ ntɛ̃́nkɛ í bo.","poem":1},{"lineBreak":true},{"text":"Mɛnɑɑ̀ kperímɛ̀ tiikɛmu, bɛnɑɑyɑ̃̀ɑ̃̀bɛ̀ kpɛ́í.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Dihɛì dimɔu dɔúnkomu kɛ pùɔ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ sicɛ̃́ĩ yɑ̃̀ɑ̃̀ nyɑ̃̀ɑ̃ mbɑ́ òmɔù tɛ̃́nkɛ í nɔ nkɛ tɑɑ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɛ̀ bɛnìtìbɛ̀ kuɔ̀ ndihɛì miɛkɛ.","poem":1},{"lineBreak":true},{"text":"Mɛnɑɑ̀ ndòńtɛ́ mɛ̀ɛ̀ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"diwɛ̀ì tɛ̃́nkɛ í kpɑɑ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ tiyɑ̃ǹkùtì dèè dihɛì.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dihɛì dimɔu nɑɑ́ ntidobontì nti,","poem":1},{"lineBreak":true},{"text":"kɛ̀ yɛcɑ̀kɛ̀ pɛ̀ítɛ́ pɛ́ítɛ́ kɛ cóú.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Ibotí imɔu kutenkù","poem":1},{"lineBreak":true},{"text":"dɛ̀ bo ndònnɛ̀ bɛ̀ ɔ̃ɔ̃ tɔ̃ũ odìfíè kó yɛbɛ kɛ íntɛ́ yɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ ɔ̃ɔ̃ tɔ̃ũ fínyĩ̀ bɛ kɛ́yɑ́kɛ́ yɛ̀.","poem":1}]},{"type":"heading","content":["Bɛ̀ɛ̀ nɑntɛ́ kɛ yɑ̃nku"]},{"type":"verse","number":14,"content":[{"text":"Bɛ̀ pĩɛ̃kù mɛtɑmmɛ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"kɛ dɛ́úkùnko ti Yiɛ̀ nKuyie nyètìrì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ diyiè tɑɑ̀ kɛ̀ɛ̀ bíɛ́kɛ̀ kɔbɛ yɑ̃nku.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Díndi diyiè yìɛ̀ní kɛ̀ɛ̀ bíɛ́kɛ̀ kɔbɛ,","poem":1},{"lineBreak":true},{"text":"dɛ́úkùnnɛ ti Yiɛ̀ nKuyie nyètìrì.","poem":1},{"lineBreak":true},{"text":"Díndi dɑ̀mɛ́ɛ̀rì bíɛ́kɛ̀ kɔbɛ","poem":1},{"lineBreak":true},{"text":"sɑ̃ntɛnɛ̀ ti Yiɛ̀ nKuyie kùù ti te tínti Isidɑyɛɛribɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ti kèèmu bɛ̀ dìèmmɛ̀ fɛ nyɛ̀nfɛ̀:","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkùù wetí ku yètìrì ndɛu!","poem":1},{"lineBreak":true},{"text":"Kɛ̀ mí nnɛ́ kuɔ́nko kɛ dɔ̀:","poem":1},{"lineBreak":true},{"text":"Ń fetimu, ǹ fetimu!","poem":1},{"lineBreak":true},{"text":"Mɛyɛi mmɛɛ̀ ti do,","poem":1},{"lineBreak":true},{"text":"bɛ̀ ǹ fìtɛ́mu, nɛ̀ bɛ̀ ti do nɑɑti bɛɛ̀ kòńtɛ́ kɛ n fìtɛ́.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Díndi bɛ̀ɛ̀ bo kɛtenkɛ̀ ĩ́nkɛ̀","poem":1},{"lineBreak":true},{"text":"Difɔ̃̀tìrì nɛ̀ ticùɔ̀tì,","poem":1},{"lineBreak":true},{"text":"dɛɛ̀ bo di ììkɛ̀.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wèè bo keè iúu kɛ́cokɛ́nɛ̀ kufɔ̃wɑɑ́,","poem":1},{"lineBreak":true},{"text":"nhò doti difɔ̃̀tìrì ndi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ wèè yɛ̀tìní difɔ̃̀tìrì kòo tɑ ticùɔ̀tì miɛkɛ.","poem":1},{"lineBreak":true},{"text":"Yɛwɛtibòrɛ̀ yɛɛ̀ kpetɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kɛtenkɛ̀ kó dipũũ sɑ̃̀ntɛ̀.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kɛtenkɛ̀ kɛɛ̀ sɑ̃̀nti,","poem":1},{"lineBreak":true},{"text":"kɛ yɑú kɛ wɛ́ú yɛwɛ́tiyɛ̀.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Kɛtenkɛ̀ ɑ̃̀ntimu kunɑɑ̀yɑ̃̀kɛ́muɔ́nkù tɛ̃mɛ̀.","poem":1},{"lineBreak":true},{"text":"Kɛ sɑ̃nti dipɑɑkɔ̃tɛ́fii kɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"mɛyɛi mmɛɛ̀ kɛ̀ yɔ̃̀ntɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ domu kɛ tɛ̃́nkɛ í yóó ítɛ́.","poem":1}]},{"type":"heading","content":["Bɛkpɑ̀ɑ̀tìbɛ̀ yóó domɛ̀ kɛ̀ Kuyie mbɑɑtɛ́"]},{"type":"verse","number":21,"content":["Dɛ yiè ti Yiɛ̀ nKuyie mbo ɑ̃nnɛ́ tɛnɔ̀ùtɛ̀ kɛĩ́nkɛ̀ kó bɛkperíbɛ̀, kɛ́potɛ́ kɛtenkɛ̀ kó bɛkpɑ̀ɑ̀tìbɛ̀,"]},{"type":"verse","number":22,"content":["kɛ́ bɛ̀ tìí mbɛmɔu bɛ̀ ɔ̃ɔ̃ tíímmɛ̀ tikpetíntì kɛ́ tì tɑnnɛ́ difɔ̃̀tìrì, kɛ́kpetínnɛ́ kɛ̀ bɛ̀ nkpetí, kɛ̀ dɛ̀ɛ mɔntɛ kɛ̀ bɛ̀ nɛ́ bɛ̀ dɔ̀ɔ̀ bɛ̀ dò mbɛ̀ɛ bɛ̀ dɔ̀ɔ̀ tì."]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Otɑ̃̀nkù bo sĩ́nnɛ́","poem":1},{"lineBreak":true},{"text":"kɛ̀ ifɛii pĩ́ ndiyiè.","poem":1},{"lineBreak":true},{"text":"Dɛ yiè ti Yiɛ̀ nKuyie Mpɑkɛdɑɑ weè yó mbɑkɛ́","poem":1},{"lineBreak":true},{"text":"kɛ́mbo Sedisɑdɛmmu Siyɔ̃ɔ̃ tɑ̃rì ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"nɛ̀ o kpetì kɛ̀ bɛkótíbɛ̀ ntì wùó.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/ISA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/ISA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/ISA/23.json","previousChapterAudioLinks":{},"numberOfVerses":23}