{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"JER","translationId":"tbz_sim","name":"Sedemii","commonName":"Sedemii","title":"Sedemii","order":24,"numberOfChapters":52,"sha256":"068780c25da76492caec71ab52733d160c18ed3407dcc0988476272e51d7fe3d","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tbz_sim/JER/52.json","totalNumberOfVerses":1356},"chapter":{"number":45,"content":[{"type":"heading","content":["Sedemii yɑ̀úkùnnɛmɛ̀ Bɑduki kɔ̃̀ntì"]},{"type":"verse","number":1,"content":["Sudɑɑ kɔbɛ kóo kpɑ̀ɑ̀tì Sosiɑsi birɛ Sosɑkimmu bo dìì mɔ̀nnì o kpɑ̀tì benni dinɑɑnnì mí nSedemii kɛ̀ mbɛ́innɛ̀ Nɛdiyɑ birɛ Bɑduki. N do ɔ̃ nwe nnɑ́ɑ́ nkòò wɑ̃̀ũ dipɑ́tíri miɛkɛ. Mɛm̀mɛ kɛ̀ n dɔ̀:"]},{"type":"verse","number":2,"content":["Ti Yiɛ̀ nKuyie ntínti Isidɑyɛɛribɛ ti tũ̀ nkù kuù dɑ nɑ́ɑ́nnɛ̀ fɔ̃́ mBɑduki kɛ tú:"]},{"type":"verse","number":3,"content":["A mɛ ntúmɛ̀ ɑ tùɔ̀ti icɛ, kɑ̀ɑ Yiɛ̀ nKuyie ndɑ yìɛ́ tihɔ̀ùtì ɑ yɛǹcɑɑ̀rìmɛ̀ ĩ́nkɛ̀, kɑ̀ɑ fìu kɛ wei kɛ́tú ũ̀ũ̀ kɛ í piɛti mɛom̀pùmɛ̀."]},{"type":"verse","number":4,"content":["Ti Yiɛ̀ nKuyie ntu kù pùɔ̀ nkù do mɑɑ́ dɛ̀ndɛ,",{"text":"kɛ u kù do fìí ndɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ yóó mɛ ndɔ̀ɔ̀ kɛtenkɛ̀ kɛmɔu.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ̀ fɔ̃́ nnɛ́ wɑnti dɛ̀mɑrɛ̀ diɛrɛ̀ ɑ mɔ́mmuɔ nhɑ kpɛ́ínnɑ́ɑ̀?","poem":1},{"lineBreak":true},{"text":"Bɑ́ nwɑnti dɛ̀mɑrɛ̀,","poem":1},{"lineBreak":true},{"text":"kù yóó bɔntɛ́ mɛyɛi mmɛ bɛnìtìbɛ̀ bɛmɔu.","poem":1},{"lineBreak":true},{"text":"Kù yóó dɑ dɛɛtɛ́mu kɑ̀ɑ fòmmu ntú ɑ kó ticɔ̃nti","poem":1},{"lineBreak":true},{"text":"bɑ́ kɑ̀ɑ bo kùù píkù.","poem":1},{"lineBreak":true},{"text":"Kunku Ti Yiɛ̀ nKuyie nkuù bɛ́i!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/JER/45.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/JER/46.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/JER/44.json","previousChapterAudioLinks":{},"numberOfVerses":5}