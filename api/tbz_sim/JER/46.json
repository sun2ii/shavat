{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"JER","translationId":"tbz_sim","name":"Sedemii","commonName":"Sedemii","title":"Sedemii","order":24,"numberOfChapters":52,"sha256":"068780c25da76492caec71ab52733d160c18ed3407dcc0988476272e51d7fe3d","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/JER/1.json","lastChapterNumber":52,"lastChapterApiLink":"/api/tbz_sim/JER/52.json","totalNumberOfVerses":1356},"chapter":{"number":46,"content":[{"type":"verse","number":1,"content":["Ntɛ Kuyie nní nnɑ̀kɛ́ tì mí nSedemii yɛbotɛ̀ kpɛ́í."]},{"type":"heading","content":["Bɛ̀ nɑmɛ̀ Esibiti kɔbɛ Kɑdikemiisi"]},{"type":"verse","number":2,"content":["Kuyie nnɑ̀kɛ́ tì Esibiti kpɛ́í nɛ̀ o kó bɛhɑ̃ɑ̃pɔ̀mbɛ̀, nɛ̀ bɛ kóo kpɑ̀ɑ̀tì Nɛko, ò do bo Kɑdikemiisi nwe kukó nhEfɑdɑti mpɛɛ́mmɛ̀ kɛ̀ Nɛbukɑnnɛsɑɑ Bɑbidɔnni kóo kpɑ̀ɑ̀tì ò do mudoò kóò nɑ. Dɛ̀ do sɔ̃́ nSudɑɑ kɔbɛ kóo kpɑ̀ɑ̀tì Sosiɑsi birɛ Sosɑkimmu bo o kpɑ̀tì benni dinɑɑnnì ndi."]},{"type":"verse","number":3,"content":[{"text":"Kɛ̀ Kuyie ndɔ̀:","poem":1},{"lineBreak":true},{"text":"Tũntɛnɛ̀ di dɔpììtì sɑ́m̀pɔ́tì nɛ̀ tidiɛtì,","poem":1},{"lineBreak":true},{"text":"kétɛ́nɛ̀ kɛ́kɔtɛ mudoò.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Boúnɛ̀ sisɛ̃ĩ́ si kɔ̃̀nkɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛsɑ̃ndèèbɛ̀ dekɛnɛ̀ di sɛ̃ĩ́,","poem":1},{"lineBreak":true},{"text":"ókɛ́nɛ̀ di pìkɛ̀ kɛ́cómmú,","poem":1},{"lineBreak":true},{"text":"sṹɔ̃́kɛ́nɛ̀ di kpɑ̃ɑ̃̀!","poem":1},{"lineBreak":true},{"text":"Piinnɛ̀ tikɔ̃̀ntì di cĩ̀ncĩ̀rɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bɑ nni ndɛ n nɛ́ wúómmɛ̀?","poem":1},{"lineBreak":true},{"text":"Kufɔ̃wɑɑ́ nkuù bɛ̀ ɑutɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ bótìrì kɛ wĩɛ̃ti bɛ fɔ̃nkó,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛkɔ̃mbɔ̀tiebɛ duò,","poem":1},{"lineBreak":true},{"text":"kɛ cokù bɑ́ bɛ̀ í wɛ̃ɛ̃riní,","poem":1},{"lineBreak":true},{"text":"kufɔ̃wɑɑ́ nnɛ́ nku tipíìtì timɔu.","poem":1},{"lineBreak":true},{"text":"Mí ndi Yiɛ̀ nKuyie míì bɛ́i!","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tɛnɑɑ̀cɛ̀cɑ̃ɑ̃tɛ yiɛ̀ mbɑ́ bennɛ́ kɛ́cokɛ́,","poem":1},{"lineBreak":true},{"text":"okɔ̃m̀bɔ̀teu í yóó cootɛ́,","poem":1},{"lineBreak":true},{"text":"kubɑkù yoú bíɛ́kɛ̀ kukó nhEfɑdɑti kó mɛpɛɛ́mmɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ dɛ mbétírí kɛ duò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wennínwe wèè iitiní,","poem":1},{"lineBreak":true},{"text":"kɛ dò nkukó nNiidi ɔ̃ɔ̃ tɑ mɛniɛ kɛ́nyiitimɛ̀?","poem":1},{"lineBreak":true},{"text":"We nkùtiri kɛ kpɛ́inko,","poem":1},{"lineBreak":true},{"text":"ikó ndiɛyì kó yɛnɛ́fĩ̀nfĩ̀rɛ̀ kɔ̃mɛ?","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Esibiti weè iitiní kukó nNiidi kɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"kòo niɛ mpiɛku ikó ndihɛì tɛ̃mɛ̀!","poem":1},{"lineBreak":true},{"text":"Weè do nɑ́ɑ́ nkɛ tú:","poem":1},{"lineBreak":true},{"text":"M bo píɛ nkɛ dɑ́tínnɛ́ yɛhɛkɛ̀ nɛ̀ yɛ nìtìbɛ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Sisɛ̃ĩ́, kétɛ́nɛ̀!","poem":1},{"lineBreak":true},{"text":"Sinɑɑsɛ̃ĩ́ butɛ́nɛ̀ yɛtɑ̀rɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛkɔ̃m̀bɔ̀tiebɛ yɛ̀nnɛ̀nní,","poem":1},{"lineBreak":true},{"text":"Etiopii nɛ̀ Puti dɛ ɛkɛ̀ kɔbɛ bɛ̀ɛ̀ nɔ nkɛ kɛ́í ntidɔpììtì.","poem":1},{"lineBreak":true},{"text":"Duti ɛì kɔbɛ díndi bɛtɑ̃ntɑ̃ũbɛ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Di nyiè tu mí ndi Yiɛ̀ nKuyie Mpɑkɛdɑɑ kpɛri ndi,","poem":1},{"lineBreak":true},{"text":"diyiè ndi n yóó pɛitɛ ndì n dootitɔbɛ̀,","poem":1},{"lineBreak":true},{"text":"n kpɑ̀rìseú bo si kɛ́nsɑ̀nnɛ̀,","poem":1},{"lineBreak":true},{"text":"n seú bo yɑ̃̀ mɛnitiyĩ̀ĩ̀ kɛ́muɔ́.","poem":1},{"lineBreak":true},{"text":"Mí ndi Yiɛ̀ nKuyie míì ɑ̃nnɛ́ diféúbɑnni,","poem":1},{"lineBreak":true},{"text":"kubɑkù yoú kó kutempɛ̃ kukó nhEfɑdɑti pɛɛ́mmɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Esibiti kɔbɛ kpɛrɛ dò mmɛsémmɛ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"kɔtɛnɛ̀ Kɑdɑɑdi mutie wɑmmù","poem":1},{"lineBreak":true},{"text":"kɛ̀ di dɔ́ di wɑmmú kɛ́wɑmmú dɛtie dɛtetìrɛ̀ ndɛ,","poem":1},{"lineBreak":true},{"text":"mutie mɑmù í bo mùù bo di tɑɑ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Yɛbotɛ̀ kèèmu di dimɛ̀ ifɛi,","poem":1},{"lineBreak":true},{"text":"yɛ̀ kèèmu di kuɔ̀mmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ kèè okɔ̃m̀bɔ̀teu cootimɛ̀","poem":1},{"lineBreak":true},{"text":"kɛ bètɛ́ otɔù kɛ̀ bɛ̀ do bɛdɛ́.","poem":1}]},{"type":"heading","content":["Bɛ̀ dotimɛ̀ Esibiti kɔbɛ mudoò"]},{"type":"verse","number":13,"content":["Kɛ̀ ti Yiɛ̀ nKuyie nni nnɑ́kɛ́ mí nSedemii Bɑbidɔnni kóo kpɑ̀ɑ̀tì Nɛbukɑnnɛsɑɑ kɔ̀rimɛ̀ kɛ bo do Esibiti kɔbɛ mudoò."]},{"type":"verse","number":14,"content":[{"text":"Pĩɛ̃kɛ́nɛ̀ ti Esibiti,","poem":1},{"lineBreak":true},{"text":"yeenɛ̀ ti Mikidɔdi ɛì kɔbɛ,","poem":1},{"lineBreak":true},{"text":"yeenɛ̀ ti Mɑnfi nɛ̀ Tɑpɑnɛsi ɛkɛ̀ kɔbɛ,","poem":1},{"lineBreak":true},{"text":"nɑ́kɛ́nɛ̀ bɛ kɛ tú:","poem":1},{"lineBreak":true},{"text":"Bɑ́ɑ́tínɛ̀ kɛ yɛ̃́ bɛ̀ domɛ̀ di pɛɛtitɔbɛ̀ mudoò.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Dɛ̀ nɛ́ dòmmɛ kɛ̀ di kó dibɔɔ̀ Apiisi do?","poem":1},{"lineBreak":true},{"text":"Dɛ̀ yĩ́mɛ kòò yɑ̀ntoo?","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù ò yèètɛ.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bɛhɑ̃ɑ̃pɔ̀mbɛ̀ kusṹkù bétírí","poem":1},{"lineBreak":true},{"text":"kɛ duòmu bɛtɔbɛ̀ ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ nɑ́ɑ́ mbɛtɔbɛ̀ kɛ tú:","poem":1},{"lineBreak":true},{"text":"Ítɛ́nɛ̀ kɛ̀ ti kɔtɛ ti kɔbɛ borɛ̀,","poem":1},{"lineBreak":true},{"text":"ti ɛì bɛ̀ ti piɛ́ dɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́yentɛ́nɛ̀ kukpɑ̀rìseú yɛiku.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Yúnɛ̀ Esibiti kóo kpɑ̀ɑ̀tì kɛ dɔ̀:","poem":1},{"lineBreak":true},{"text":"Kutoweku dɛtetìrɛ̀ kɔku yiɛ̀,","poem":1},{"lineBreak":true},{"text":"ò yóu kɛ̀ dɛ̀ ɔɔtɛmu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"Kɛ̀ Ti Yiɛ̀ nKuyie mbɛ́i nkɛ dɔ̀:","poem":1},{"lineBreak":true},{"text":"Tɑbɔɔ tɑ̃rì dɛunɛ̀mɛ̀ yɛtɑ̃rɛ̀ sɔnyɛ,","poem":1},{"lineBreak":true},{"text":"Kɑdimɛɛdi tɑ̃rì ikúnɛ̀mɛ̀ dɑ̀mɛ́ɛ̀rì,","poem":1},{"lineBreak":true},{"text":"Esibiti kóo kpɑ̀ɑ̀tì kèríní kɛ yó nkpeńnì mɛɛ̀ botí.","poem":1},{"lineBreak":true},{"text":"M bomu, mí nhokpɑ̀ɑ̀tì wèè yètìrì tu Mpɑkɛdɑɑ kɛ̀ míì bɛ́i.","poem":1}]},{"type":"line_break"},{"type":"verse","number":19,"content":[{"text":"Díndi Esibiti kɔbɛ,","poem":1},{"lineBreak":true},{"text":"pɑ̃̀nkɛ mbounɛ̀ di nɛntì,","poem":1},{"lineBreak":true},{"text":"bɛ̀ yóó di pĩ́mmúmu,","poem":1},{"lineBreak":true},{"text":"Mɑnfi kó dihɛì bo dɔúnko kɛ́nɑɑ́ ndikpɑ́ɑ̀,","poem":1},{"lineBreak":true},{"text":"dì bo cɔ́útɛ́ kɛ́nɑɑ́ ntidobontì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"Esibiti tu dinɑɑsɛrì sɑ̀ɑ̀rì ndi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ disɑ̃nsũɔ̃̀ mɛ nyìtɛ́ní kubɑkù yoú bíɛ́kɛ̀ kɛ kéríní,","poem":1},{"lineBreak":true},{"text":"dì kèrínímu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Bɛhɑ̃ɑ̃pɔ̀mbɛ̀ bɛ̀ yietí bɛ̀ mudoò kpɛ́í,","poem":1},{"lineBreak":true},{"text":"bɛ̀ í cɑ̃́ɑ̃́nnɛ̀ yɛnɑɑdɑkɛ̀ bɛ̀ dùnnɛ yɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ múnkɛ bùtínnɛ́mu kɛ dɛ̀ítɛ́ itɑ̃́ɑ̃́,","poem":1},{"lineBreak":true},{"text":"bɛ̀ cokɛ́mu bɛmɔu,","poem":1},{"lineBreak":true},{"text":"òmɔù í bɑ̀ɑ̀o,","poem":1},{"lineBreak":true},{"text":"bɛ kó mudorimù muù tùɔ̀kɛ,","poem":1},{"lineBreak":true},{"text":"bɛ yɛ̃ĩti yiè diì tùɔ̀kɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Kɛ̀ bɛ̀ tu núɔ́ɔ́,","poem":1},{"lineBreak":true},{"text":"fɛwɑ̀ɑ̀fɛ̀ ɔ̃ɔ̃ kèè kuwɑɑroo kɛ́yĩ́mɛ̀.","poem":1},{"lineBreak":true},{"text":"Bɛ dootitɔbɛ̀ bɛɛ̀ kèríní ditĩ̀nnì","poem":1},{"lineBreak":true},{"text":"nɛ̀ sipɛ̃ɛ̃́ bɛtekɔ̃ũbɛ̀ tɛ̃mɛ̀.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Bɛ̀ yóó kɔ̃ṹmu o túúkù.","poem":1},{"lineBreak":true},{"text":"Mí ndi Yiɛ̀ nKuyie míì bɛ́i!","poem":1},{"lineBreak":true},{"text":"Bɑ́ kù mɛ nfĩḿmɛ̀ kɛ í dò nkɛ́nɑ kɛ́tɑ,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ bɛkɔ̃ũbɛ̀ sũmɛ̀mu","poem":1},{"lineBreak":true},{"text":"kɛ dò nfɛcofɛ dòmmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ í dò nkɛ́nɑ kɛ́kɑɑ nkɛ́deè.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Ifɛi iì kùɔ̀ Esibiti ɛì kɔbɛ,","poem":1},{"lineBreak":true},{"text":"kubɑkù yoú bíɛ́kɛ̀ kɔbɛ bɛ̀ nɑmu.","poem":1}]},{"type":"verse","number":25,"content":["Mí ndi Yiɛ̀ nKuyie Mpɑkɛdɑɑ Isidɑyɛɛribɛ tũ nkù míì bɛ́i nkɛ tú: N yìtɛ́ kɛ còḿmúmu dibɔɔ̀ Amɔɔ dìì bo Tɑbɛsi ɛì di kpɛ́í, Esibiti kóo kpɑ̀ɑ̀tì nɛ̀ o nìtìbɛ̀ bɛ kpɛ́í, Esibiti kɔbɛ nɛ̀ bɛ kóo kpɑ̀ɑ̀tì nɛ̀ bɛ̀ɛ̀ ò bùɔ́ bɛ kpɛ́í."]},{"type":"verse","number":26,"content":["N yóó bɛ̀ ɑ̃nnɛ́mu bɛ̀ɛ̀ dɔ́ bɛ kɔ̀ù bɛ nɔu miɛkɛ, bɛ̀ɛ̀ tu: Nɛbukɑnnɛsɑɑ Bɑbidɔnni kóo kpɑ̀ɑ̀tì nɛ̀ o kɔbɛ, o kó bɛtɔ̃mbɛ̀. Dɛ kó difɔ̃nkúò kɛ̀ Esibiti ɛìi wɛ̃tɛ kɛ́mɑɑ́ di do dòmmɛ̀ nɛ̀ dimɔ̀nnì. Mí ndi Yiɛ̀ nKuyie míì bɛ́i."]},{"type":"heading","content":["Kuyie nyóó dɛɛtɛ́mɛ̀ Isidɑyɛɛribɛ"]},{"type":"verse","number":27,"content":[{"text":"Díndi n kóo tɔ̃ntì Sɑkɔbu yɑɑ̀bí di bɑ́ nyĩɛ̃̀kù,","poem":1},{"lineBreak":true},{"text":"díndi Isidɑyɛɛribɛ di bùɔ̀tì bɑ́ nduò.","poem":1},{"lineBreak":true},{"text":"N yóó di dennɛmu dihɛì dɛ́tirì miɛkɛ,","poem":1},{"lineBreak":true},{"text":"di yɑɑ̀bí í yó nkpɑɑní bɛ̀ ì pĩ̀ḿmu kɛ kònnɛ̀ kɛ̀.","poem":1},{"lineBreak":true},{"text":"Sɑkɔbu yɑɑ̀bí wɛ̃timu kɛ bo kɑri bɑ̀mmùù","poem":1},{"lineBreak":true},{"text":"bɑ́ òmɔù bɑ́ nyì kɔɔ́nnɛ̀.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Díndi n kóo tɔ̃ntì Sɑkɔbu yɑɑ̀bí","poem":1},{"lineBreak":true},{"text":"di bɑ́ nyĩɛ̃̀kù, n di bonɛ̀mu,","poem":1},{"lineBreak":true},{"text":"n yóó kuɔmu ibotí imɔu,","poem":1},{"lineBreak":true},{"text":"n di cìɛ́ nkɛ̀ di tɑɑ́ ìì miɛkɛ,","poem":1},{"lineBreak":true},{"text":"m bo ì dèè m mɛ nyí yóó deè díndi biɛ,","poem":1},{"lineBreak":true},{"text":"n nɛ́ yóó di potɛ́mu di mɑ̀nnɛ̀ tìì yɛ̃ĩti,","poem":1},{"lineBreak":true},{"text":"dɛ̀ í tú n yó ndi wúónko mɛmmɛ,","poem":1},{"lineBreak":true},{"text":"kɛ dò ndi í cɑ̀ɑ̀rɛ̀ mùmɑmù.","poem":1},{"lineBreak":true},{"text":"Mí ndi Yiɛ̀ nKuyie míì bɛ́i.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/JER/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/JER/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/JER/45.json","previousChapterAudioLinks":{},"numberOfVerses":28}