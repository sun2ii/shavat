{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"JOB","translationId":"tbz_sim","name":"Isɔbu","commonName":"Isɔbu","title":"Isɔbu","order":18,"numberOfChapters":42,"sha256":"9f455c289d78eab762dece3d436057d0f94e8d2fdeba12aafd361cfa2f73c8ae","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tbz_sim/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":17,"content":[{"type":"heading","content":["Bɛ̀ yetɛmɛ̀ Isɔbu koò bɔntóo"]},{"type":"verse","number":1,"content":[{"text":"Kɛ̀ Isɔbuu sɔɔtɛ́ kɛ́bɛ́i nkɛ dɔ̀:","poem":1},{"lineBreak":true},{"text":"N wemmu tɛ̃́nkɛ í yiɛ̀ sɛ́i,","poem":1},{"lineBreak":true},{"text":"n we yɛɛ̀ kũpɛ,","poem":1},{"lineBreak":true},{"text":"kufɔ̃ti kuù m bɑ̀ɑ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mudɑɑ́ nyɛmbɛ̀ bɛɛ̀ n fitɛ́,","poem":1},{"lineBreak":true},{"text":"n yí nɔ nkɛdɔunɛ̀ bɛ kó yɛsɑ̃́ɑ̃̀mbɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kuyie, nyietí ɑ yɛ̃ n cɑ̀kɛ mù kɛ́ n fĩ́ĩnko,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ í tú fɔ̃́ nhòmɔù í bo wèè bo m pɑtɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ bɛ̀ mɔ̀ntɛ mɛyɛ̀mmɛ̀ kɛ̀ bɛ̀ í bɑntɛ́,","poem":1},{"lineBreak":true},{"text":"ɑ bɑ́ɑ́ yóu kɛ̀ bɛ̀ n nɑ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɛ̀ yɑ̀ɑ̀ bo dɔɔ̀ dinɑ́ɑǹhɑ̃ntírì mɑrì tu dɛ̀:","poem":1},{"lineBreak":true},{"text":"A yu ɑ nɛ́pobɛ̀ kɛ̀ di yo ndi ɛí dɛ̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ bí ɑunɛ̀ dikònnì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N kpɛrɛ nɑɑ́ nfɛoǹnìfɛ̀ nfɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ nɑ́ɑǹtɛ n kpɛ́í nkutenkù,","poem":1},{"lineBreak":true},{"text":"bɛ̀ sùu n yììkɛ̀ nkɛ tinɔ́ntɔ̃ũtì.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N nuɔ ntɛ̃́nkɛ í wúónnɛ̀ mɛsémmɛ̀,","poem":1},{"lineBreak":true},{"text":"n tùoti iì cĩ̀tiroo mɛdɛ́ɛ̀ ndèumɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Bɛnìtìbɛ̀ bɛ̀ɛ̀ wetí bɛ̀ n yɑ̀ kɛ̀ dɛ̀ bɛ̀ dimu,","poem":1},{"lineBreak":true},{"text":"onitisɑ̀ù ɔ̃ n yɑ̀ kòo miɛkɛ kɛɛ̀ yɛ̀nní bɛ̀ɛ̀ í dé Kuyie.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Wèè wetí ò fìíkú teii nwe ò kèrí kùù cɛ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"wèè wenni kòò yɛ̀útí omɑ́ɑ̀ muwɛ̃rímú.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Díndi biɛ kɛ̀ di dɔ́ di nwĩɛ̃tiní,","poem":1},{"lineBreak":true},{"text":"n yí kpɑɑ́ kɛ bo yɑ̀ di miɛkɛ wèè mɔ̀kɛ mɛyɛ̀mmɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"N we pɛ̃nkɛ́mu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n do dɔ́ kɛ́dɔɔ̀ tì kũ̀ńtɛ́ dɛndɛ,","poem":1},{"lineBreak":true},{"text":"n yɛ̀mmɛ̀ do nɑɑtinɛ̀ dɛ̀ mɛdiɛ̀ nkɛ̀ dɛ̀ pɑ̀ɑ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɛ̀ dɛ̀ bììtɛ n nɛ́pobɛ̀ ɔ̃ɔ̃ dɔ̀ dɛ̀ wentɛ́mu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ urikɛ bɛ̀ dɔ̀ dikṹnweńnì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N tɛ̃́nkɛ bɑɑ bɑ?","poem":1},{"lineBreak":true},{"text":"Kudɔnkù kuù tu n cĩ́ɛ̃̀tɛ̀,","poem":1},{"lineBreak":true},{"text":"m pitɛ́ n dɔ́ù dibiìnnì miɛkɛ nkɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N nɑ̀kɛ́mu n fɔ̃ti kɛ yĩ kuù tu n cicɛ,","poem":1},{"lineBreak":true},{"text":"kɛ nɑ̀kɛ́ yɛbiɛ̀ kɛ yĩ yɛɛ̀ tu n yɔ̃ nɛ̀ n tɑ̃ũ̀.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N do bɑɑ dɛ̀ kɔ̀tɛ kɛ?","poem":1},{"lineBreak":true},{"text":"We ndɛ̀ wùó ntɛ̃́nkɛ?","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"N do bɑɑ dɛ̀ dɛmɔu nɛ̀ mí ti tɑti kufɔ̃ti nku,","poem":1},{"lineBreak":true},{"text":"Mí nnɛ̀ dɛndɛ ti cuti kɛtenkɛ̀ nkɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/JOB/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/JOB/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/JOB/16.json","previousChapterAudioLinks":{},"numberOfVerses":16}