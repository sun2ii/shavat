{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"JOB","translationId":"tbz_sim","name":"Isɔbu","commonName":"Isɔbu","title":"Isɔbu","order":18,"numberOfChapters":42,"sha256":"9f455c289d78eab762dece3d436057d0f94e8d2fdeba12aafd361cfa2f73c8ae","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/JOB/1.json","lastChapterNumber":42,"lastChapterApiLink":"/api/tbz_sim/JOB/42.json","totalNumberOfVerses":1070},"chapter":{"number":26,"content":[{"type":"heading","content":["Isɔbu tɛ̃̀ńnɛ́ tì Bididɑɑ"]},{"type":"verse","number":1,"content":["Kɛ̀ Isɔbuu ò tɛ̃̀ńnɛ́ kòo nùù dɔ̀:"]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ɔ̃̀mmɛ teèmmɛ̀ tɛ̃́nkɛ nɛ́ mmɛ ɑ teémmɛ̀ ocĩ̀rì?","poem":1},{"lineBreak":true},{"text":"A teénnɛ̀ ɔ̃̀mmɛ wèè bɑɑ̀ nhɔ̀u?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A mɛ̀ nnɔmmɛ̀mu kɛ tiè nwèè í mɔkɛ mɛyɛ̀mmɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛnkɛ we ɑ ciìmɛ̀ nɛ̀ ɑ nɑ́ɑǹtì miɛkɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"We nni nwe ɑ nɑ́ɑ́nnɛ̀mɛ̀ dɛ kó tinɑ́ɑǹtì?","poem":1},{"lineBreak":true},{"text":"Ɔ̃̀mmɛ yɛ̀mmɛ̀ mmɛ mɛ̀ɛ̀ nɑ̀ɑ́nní ɑ miɛkɛ?","poem":1}]},{"type":"heading","content":["Kuyie mbɑkɛ́mɛ̀ kutenkù"]},{"type":"verse","number":5,"content":[{"text":"Bɛdɔmbɛ̀ kɔ̃̀ntì ɑumu bɛ ɛì bɛ̀ borɛ̀ mɛniɛ nfũ̀ɔ̃̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie mborɛ̀ kudɔnkù feímu,","poem":1},{"lineBreak":true},{"text":"mukṹṹ nkó dihɛì í kù sɔ̀rinɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kuyie nkuù pitɛ́ tiwɛtì kɛ̀ tì nùú mmɛmmɛ kubɑkù yoú bíɛ́kɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kuù nùńnɔ́ɔ kɛtenkɛ̀ dɛtetìrɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuù pɔ̃ṹ nfɛtɑɑfɛ̀ yɛwɛtɛ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"mɛniɛ mmɛ nyí yɔ̃̀ntɛ yɛwɛtɛ̀ kɛ̀ yɛ̀ kɛ̃tɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuù ɔ̃ɔ̃ pitɛ́ tiwɛtì kɛ́kɑ̃ɑ̃́ nku kpɑ̀ɑ̀tìkɑ̀rì, kɛ̀ yɛwɛtɛ̀ɛ di dɑ̀tínnɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kuù kèétɛ́ dɑ̀mɛ́ɛ̀rì ò yó nfirì dɛ̀,","poem":1},{"lineBreak":true},{"text":"kuù kèétɛ́ dibiìnnì nɛ̀ kuwenniku dɛ̀ mɑ̀nkɛ dɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɛ̀ Kuyie mpɛ́i nkɛĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"dɛ̀ kɛ̀ dimu kɛ̀ kɛ sɑ̃ǹkɛ̀ɛ sɑ̃ntɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Ku wɛ̃rímú muù te kɛ̀ dɑ̀mɛ́ɛ̀rì sɑ̃̀nti,","poem":1},{"lineBreak":true},{"text":"nɛ̀ ku ciìmmɛ̀ kù nɑmɛ̀ dɑ̀mɛ́ɛ̀rì kó musĩ̀mmù.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ku nùù kó muyɑɑ́ mmuù kɑ̀útóo tiwɛtì kɛ̀ tì wenkɛ.","poem":1},{"lineBreak":true},{"text":"Nɛ̀ ku nɔ̀ùtɛ̀ ntɛ kù yɛ̀ìtɛ yɛitɛmɛ̀ fɛwɑɑ̀yɛifɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ku tɔ̃mmú kù pĩĩ mmù kó tɛkéètɛ̀ ntɛ mɛmmɛ,","poem":1},{"lineBreak":true},{"text":"ti yo ku tɔ̃mmú kù pĩ mmù kó tinɑ́ɑǹtì sɑ́m̀pɔ́ nwe,","poem":1},{"lineBreak":true},{"text":"kɛ̀ mù nɛ́ bo pɛɛ́ mɛtɑmmɛ̀ mɛdiɛ̀","poem":1},{"lineBreak":true},{"text":"we mbo dɑ́ɑ́tí kɛ́keè dɛ kó mɛtɑmmɛ̀?","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/JOB/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/JOB/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/JOB/25.json","previousChapterAudioLinks":{},"numberOfVerses":14}