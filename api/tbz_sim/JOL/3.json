{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"JOL","translationId":"tbz_sim","name":"Sowɛɛri","commonName":"Sowɛɛri","title":"Sowɛɛri","order":29,"numberOfChapters":4,"sha256":"88edd593dae4e7ec456a807cecac793e158a6e16c210337c8fa0a2a8129f5ceb","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/JOL/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tbz_sim/JOL/4.json","totalNumberOfVerses":73},"chapter":{"number":3,"content":[{"type":"heading","content":["Kuyie nnɑ̀kɛ́mɛ̀ kù yóó duɔnnímɛ̀ ku Yɑɑ́"]},{"type":"verse","number":1,"content":[{"text":"Kɛ̀ Kuyie mbɛ́i nkɛ dɔ̀:","poem":1},{"lineBreak":true},{"text":"Dɛ bo yíɛ́ mí di Yiɛ̀ nKuyie nkɛ̀ n cṹũnko n Yɑɑ́ mbɛnìtìbɛ̀ bɛmɔu ĩ́nkɛ̀","poem":1},{"lineBreak":true},{"text":"di kó bɛdɑpɑ̀mbɛ̀ nɛ̀ di kó bɛsɑpɑ̀mbɛ̀","poem":1},{"lineBreak":true},{"text":"bɛ̀ bo nɑɑ́ m pɑ̃ɑ̃nɑ́ɑǹtì nɑ́ɑm̀bɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛkótíbɛ̀ nyɑu n kó tidɔuǹtì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛbɛ́mbɛ̀ nyɑu n kó mɛbɛǹkùmɛ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dɛ kó yɛwe miɛkɛ n yóó cṹũnkomu n Yɑɑ́ n tɔ̃mbɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛnitidɑɑbɛ̀ nɛ̀ bɛnitipòbɛ̀ bɛ ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ɛ nɑɑ́ m pɑ̃ɑ̃nɑ́ɑǹtì nɑ́ɑm̀bɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɛ yiè m bo ɑ̃nnɛ́ mɛbɛnkùmɛ̀ cɑ̀mmɛ̀ mɛ̀ɛ̀ tu,","poem":1},{"lineBreak":true},{"text":"kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀ dɛ̀ bo nɑɑ́mmɛ̀ mɛyĩ̀ĩ̀ nnɛ̀ muhɑ̃ɑ̃́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kuyukúu dɑ́tínnɛ́ diwɛtirì kɔ̃mɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Diyiè bo sɔutɛ, kòo tɑ̃̀nkùu wũɔ̃tɛ́ kɛ́ndò mmɛyĩ̀ĩ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ti Yiɛ̀ nKuyie nkó diyiè diɛrì nɛ́ nɑ kɛ́tuɔkɛní,","poem":1},{"lineBreak":true},{"text":"dìì dɛu kɛ duò tikɔ̃m̀bùɔ̀tì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dɛ mɔ̀nnì wèè bo kuɔ́nnɛ̀ ti Yiɛ̀ nKuyie nhò bo cootɛ́.","poem":1},{"lineBreak":true},{"text":"Kɛ yɛ̃́ mɛdɛɛtímɛ̀ yó mbomɛ̀ Siyɔ̃ɔ̃ tɑ̃rì ĩ́nkɛ̀ nɛ̀ Sedisɑdɛmmu,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nkuù do tì bɛ́i.","poem":1},{"lineBreak":true},{"text":"Kù bo yú bɛ̀, bɛɛ̀ yó ntú bɛ̀ɛ̀ yentɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/JOL/3.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/JOL/4.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/JOL/2.json","previousChapterAudioLinks":{},"numberOfVerses":5}