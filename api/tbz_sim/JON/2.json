{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"JON","translationId":"tbz_sim","name":"Sonɑɑsi","commonName":"Sonɑɑsi","title":"Sonɑɑsi","order":32,"numberOfChapters":4,"sha256":"e91cb1b3e5310bf12c762fb162efc8db458ca067e210895178d012a0cdb5b4e4","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/JON/1.json","lastChapterNumber":4,"lastChapterApiLink":"/api/tbz_sim/JON/4.json","totalNumberOfVerses":48},"chapter":{"number":2,"content":[{"type":"heading","content":["Sonɑɑsi bɑ̀ɑ́mmɛ̀ Kuyie ntɛyĩǹtɛ̀ miɛkɛ"]},{"type":"verse","number":1,"content":["Bɛ̀ dootóo mɛmmɛ Sonɑɑsi kɛ̀ Kuyie nduɔ́ nkɛ̀ tɛyĩndiɛtɛ̀ɛ ò mɑɑ́nko. Kòò dɔ̀ iyie nyìtɑ̃ɑ̃ti, dɛyènnɛ̀ dɛ̀tɑ̃ɑ̃ti tɛyĩǹtɛ̀ miɛkɛ."]},{"type":"verse","number":2,"content":["Kɛ̀ Sonɑɑsi mbɑ́ɑ́ nho Yiɛ̀ nKuyie nkɛ tú:"]},{"type":"verse","number":3,"content":[{"text":"Dɛ̀ m pɑ̀kɛ́mu n Yiɛ̀ nKuyie nkɛ̀ n dɑ kuɔ́nnɛ̀ kɑ̀ɑ n dɛɛtɛ́!","poem":1},{"lineBreak":true},{"text":"N do bo kudɔnkù nku kɛ dɑ yu, kɑ̀ɑ kèè n tɑmmɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A do n dootóo dɑ̀mɛ́ɛ̀rì fũ̀ɔ̃̀ ndi dɛcũmpurɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ mɛniɛ nni ndɑ̀tínnɛ́, kɛ̀ yɛnɛ́fĩ̀nfĩ̀rɛ̀ nni mpuotì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yɛ̀mmɛ̀ do dò nhɑ n dootóomu,","poem":1},{"lineBreak":true},{"text":"bɑ́ nɛ̀ mɛmmɛ n do yɛ̃́mu kɛ dò m bo wɛ̃tɛ kɛ́yɑ̀ ɑ cɛ̃sɑ̀ɑ̀tɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N do dìumu kɛ́fiu, n do tɑ tɛbintuotɛ̀ ntɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɑ̀mɛ́ɛ̀rì kó tipèntì nni kɔti.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"N do cùtɛ́ dɛ fũ̀ɔ̃̀ ndi kɛ́tɑ kudɔnkù sɑ̃́ɑ̃̀.","poem":1},{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nkɑ̀ɑ n dɛɛtɛ́ kɛ n dènnɛní kudɔnkù!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N do fìumu kɛ̀ n yɛ̀mmɛ̀ɛ cuonní ɑ bíɛ́kɛ̀","poem":1},{"lineBreak":true},{"text":"kɛ̀ nní ndɑ bɑ́ɑ́ nkɛ tú m bɑ́ɑmmìi tuɔkoo ɑ cɛ̃sɑ̀ɑ̀tɛ̀ miɛkɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛbɔɔféúbɛ̀ pɑ̀ɑ̀mu Kuyie nkó mɛsɑ̀ɑ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mí m bo dɑ fíé iwũɔ̃, kɛ́ndiè nkɛ dɑ sɑ̃ntí,","poem":1},{"lineBreak":true},{"text":"kɛ dɔɔri m bɛ́i ntì, Kuyie nfɔ̃́ɔ̃̀ mɑ́ɑ̀ dɛɛrí.","poem":1}]},{"type":"verse","number":11,"content":["Kɛ̀ Kuyie nduɔ́ nkɛ̀ tɛyĩ̀ntɛ̀ɛ tĩ́ṹtóo Sonɑɑsi dikonnɛ́bɛ̀nnì."]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/JON/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/JON/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/JON/1.json","previousChapterAudioLinks":{},"numberOfVerses":11}