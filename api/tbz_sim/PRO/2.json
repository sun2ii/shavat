{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PRO","translationId":"tbz_sim","name":"Yɛkotinɔ̀","commonName":"Yɛkotinɔ̀","title":"Yɛkotinɔ̀","order":20,"numberOfChapters":31,"sha256":"6ecebb5c55cb62d09474657b86a81b19da2e1c50e2d77ddef611fd99d9a390f8","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PRO/1.json","lastChapterNumber":31,"lastChapterApiLink":"/api/tbz_sim/PRO/31.json","totalNumberOfVerses":911},"chapter":{"number":2,"content":[{"type":"heading","content":["Mɛciì mmɛɛ̀ ɔ̃ nkɑ̃nkɛ́ onìtì kɛ̀ mɛyɛi mbɑ́ɑ́ ò nìntɛ"]},{"type":"verse","number":1,"content":["M birɛ mpĩ́ ndɑ tiè ntì,",{"text":"ɑ bɑ́ɑ́ yɛ̃̀ n yɛ̃ nhɑ ndɔɔri dɛ̀,","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"kéntɛ́ mɛsɑ̀ɑ̀ mɛciì nkó tinɑ́ɑǹtì,","poem":1},{"lineBreak":true},{"text":"kɛ́duɔ́ nhɑ yɛ̀mmɛ̀ kɛ́ tì bɑntɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Yú mɛciì nnɛ̀ mɛyɛ̀mmɛ̀ kɛ̀ dɛ̀ ndɑ teénnɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wɑmmú dɛ bɛ̀ wɑɑ̀mmɛ̀ idíítí,","poem":1},{"lineBreak":true},{"text":"kɛ́ ndɛ̀ bɛ̀tì tikpɑ̀tì kɔ̃mɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dɛ mɔ̀nnì ndi ɑ yóó depɛmɛ̀ Kuyie nkɛ́nɑ kɛ́ kù yĩ̀ɛ̃́tɛ́,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"kɛ yɛ̃́ Kuyie nkuù duɔ̀mmɛ̀ mɛciì,","poem":1},{"lineBreak":true},{"text":"kuù ɔ̃ nte kòo nìtìi ciitɛ́ kɛ́bɑntɛ́ dɛ̀mɑrɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuù dɔ̀ɔ̀ri mɛsɑ̀ɑ̀ mbɛ̀ɛ̀ borimɛ wenni,","poem":1},{"lineBreak":true},{"text":"kɛ kɑ̃nkɛ́ bɛ̀ɛ̀ dɔ̀ɔ̀ri kù dɔ́mɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuù kɑ̃nkɛ́ bɛ̀ɛ̀ dɔɔ̀rìmɛ̀ wenni,","poem":1},{"lineBreak":true},{"text":"kɛ bɑɑ bɛ̀ɛ̀ kù duɔ́ mbɛmɑ́ɑ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɑ̀ɑ kèḿmú n kpɛti ɑ bo bɑntɛ́ kucɛ sɑ̀ɑ̀kù","poem":1},{"lineBreak":true},{"text":"kɛ́nɑ kɛ́dɔɔ̀ dɛ̀ɛ̀ sìɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Dɛ mɔ̀nnì ndi ɑ bo nciìmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ ciì ndɑ duɔ́ ndiwɛ̀ì.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɛ̀ mɛciì nni ndɑ kɑ̃nkɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ mɛyɛ̀mmɛ̀ dɑ bɑɑ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Dɛɛ̀ yó nte kɑ̀ɑ bɑ́ɑ́ dɔɔ̀ mɛyɛi,","poem":1},{"lineBreak":true},{"text":"dɛɛ̀ yó ndɑ kɑ̃nkɛ́ siyɑ́ɑ̀bìsí yɛmbɛ̀,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"nɛ̀ bɛ̀ɛ̀ yóu kucɛ sɑ̀ɑ̀kù kɛ tũ ndibiìnnì kɔku,","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"bɛ̀ɛ̀ kpɛ̀itinɛ̀ mɛyɛi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ bɛ̀ nɑɑtinɛ̀ mɛyɛi,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"kɛ̀ bɛ̀ tũ̀ nyicɛ ìì í wenni.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Mɛm̀mɛ ɑ bo nɑmɛ̀ kɛ́yentɛ́nɛ̀ onitipòkù","poem":1},{"lineBreak":true},{"text":"wèè dɔuti dɔutinɛ̀ bɛnitidɑɑbɛ̀ o nùnɑɑtí,","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"wèè yetɛ o dɔù,","poem":1},{"lineBreak":true},{"text":"kɛ bùtínnɛ́ ò dɔúnnɛ̀ dìì nùù Kuyie.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wèè tũ̀ nho cĩ́ɛ̃̀tɛ̀ kó kucɛ","poem":1},{"lineBreak":true},{"text":"ò kɔ̀ri mukṹṹ mborɛ̀ ndɛ.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wèè kɔ̀tɛ o borɛ̀ ò ɔ̃ɔ̃ í nwɛ̃̀tɛní,","poem":1},{"lineBreak":true},{"text":"ò tɛ̃́nkɛ ɔ̃ɔ̃ í mpɛ̀tɛ́ mufòmmu kó kucɛ.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Tɑ̃ɑ̃tɛ́ bɛnitisɑ̀ɑ̀bɛ̀ kó kucɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ntũ mbɛ̀ɛ̀ borimɛ wenni bɛ dɔɔ̀rìmɛ̀.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kɛ yɛ̃́ bɛ̀ɛ̀ borimɛ wenni,","poem":1},{"lineBreak":true},{"text":"bɛɛ̀ yó mbo dihɛì miɛkɛ.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Bɛ̀ nɛ́ yóó dennɛmu bɛnitiyonkubɛ dihɛì miɛkɛ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ yóó dɛitɛmu bɛ̀ɛ̀ borimɛ í wenni.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PRO/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PRO/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PRO/1.json","previousChapterAudioLinks":{},"numberOfVerses":22}