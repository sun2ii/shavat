ontì nti kuyɑɑkù tɔ tì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dɛɛ̀ te kɛ̀ bɛ̀ í yóó nɑ kɛ́cómmú Kuyie mbeéntì yiè,","poem":1},{"lineBreak":true},{"text":"bɛ̀ mɛ nyí yó nkɔkɛ́ Kuyie nkɔbɛ tĩ̀nnì.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie nyɛ̃́mu bɛ̀ɛ̀ wetí bɛ kó kucɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛyɛibɛ biɛ tũ mmɛfétimɛ̀ kɔku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/1.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/2.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/JOB/42.json","previousChapterAudioLinks":{},"numberOfVerses":6}