{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":10,"content":[{"type":"verse","number":1,"content":[{"text":"Dɛ̀ yĩ́mɛ n Yiɛ̀ nKuyie nkɑ̀ɑ dɛ́tɛ́?","poem":1},{"lineBreak":true},{"text":"Dɛ̀ dòmmɛ kɑ̀ɑ sɔ̀ri mɛyɛǹcɑɑ̀rìmɛ̀ mɔ̀nnì?","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bɛnitidɔnnibɛ̀ mɔ̀kɛ sipɔɔ nsi,","poem":1},{"lineBreak":true},{"text":"kɛ fɛ̃́ũnko bɛcĩ̀rìbɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ dɔɔ̀rìmɛ̀ bɛ̀ pĩĩ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɛ̀ ɔ̃ nnɑɑtimu onitiyɛiwe ò dɔ́ kɛ́dɔɔ̀ tì kpɛ́í,","poem":1},{"lineBreak":true},{"text":"kòò fìètɛ otɔù kpɛrɛ dɛ̀ nhò nɑɑti,","poem":1},{"lineBreak":true},{"text":"kòò sɑ̃̀ɑ̃́ nKuyie.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Onitiyɛiwe ɔ̃ nnɑ́ɑ́nnɛ̀ tɛpɔ̀tɛ̀ ntɛ kɛ tú:","poem":1},{"lineBreak":true},{"text":"Kuyie nyí kpetì òmɔù,","poem":1},{"lineBreak":true},{"text":"kù ketɛ́ kɛ́ í bo.","poem":1},{"lineBreak":true},{"text":"Tiì bo o yɛ̀mmɛ̀ sɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ò dɔ̀ɔ̀ri dɛ̀ yíémmu sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"ò í bɑnní Kuyie mbeéntì,","poem":1},{"lineBreak":true},{"text":"ò ɑúmmu o dootitɔbɛ̀ bɛmɔu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kòò nɑ̀ɑ́ nho yɛ̀mmɛ̀ miɛkɛ kɛ tú:","poem":1},{"lineBreak":true},{"text":"N yí doti bìtì,","poem":1},{"lineBreak":true},{"text":"mɛyɛi nyí yó n yɑ̀ bìtì bìtì!","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kòo nùù mɔ̀kɛ tinɑ́ɑǹsĩ̀ntì,","poem":1},{"lineBreak":true},{"text":"siyɑ́ɑ̀bìsí nɛ̀ mɛciìmmɛ̀,","poem":1},{"lineBreak":true},{"text":"kòo nɑ́ɑǹtì tu tiyɛiti ò í nɑ́ɑ́ ntimɔ́mmɔnti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ò ɔ̃ɔ̃ okɛ dihɛì tɑkɛ́ nkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́kuɔ wèè í cɑ̀ɑ̀rɛ̀ mùmɑmù disɔ̀rì","poem":1},{"lineBreak":true},{"text":"kɛ ɔ̃ ntṹṹ nkɛ pɑkɛ́ ocĩ̀rì.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ò ɔ̃ nhokɛ kutúúkù nku,","poem":1},{"lineBreak":true},{"text":"mɛdɛ́timɛ̀ dicìrícìrì kɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"kɛ pɑkɛ́ ocĩ̀rì,","poem":1},{"lineBreak":true},{"text":"kóò kpɑ̀ɑ̀kɛ kɛ́tɑnnɛ́ ticùɔ̀tì miɛkɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ò ɔ̃ɔ̃ kúkúmu, kɛ́bɑkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́yɑ̃kɛ ocĩ̀rì.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kòo yɛ̀mmɛ̀ dò nKuyie nyɛ̃̀ nho kpɛti,","poem":1},{"lineBreak":true},{"text":"kɛ dò nkù í dɑkɛ o kpɛti ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ dò nkù í wúó nhò dɔ̀ɔ̀ri dɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kuyie, nyítɛ́ kɛ́cómmú,","poem":1},{"lineBreak":true},{"text":"Kuyie, nyoutɛ ɑ nɔ̀ùtɛ̀!","poem":1},{"lineBreak":true},{"text":"Bɑ́ɑ́ yɛ̃̀ mbɛcĩ̀rìbɛ̀ kpɛ́í.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dɛ̀ yĩ́mɛ kòo yɛiwe dɑ dɑú,","poem":1},{"lineBreak":true},{"text":"kɛ tú ɑ í yóó ò kpetínnɛ́?","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"A wúómmu ocĩ̀rì ɑ́ɑ̀rìmɛ̀ kɛ fɛ̃́ṹrì,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ ò kómmú.","poem":1},{"lineBreak":true},{"text":"Ocĩ̀rì duɔ́ nfɔ̃́ nwe omɑ́ɑ̀,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ dɑ̀kɛ dɛciribirɛ kpɛ́í.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Pɔntɛ oyɛiwe wɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"yietí we o yɛi,","poem":1},{"lineBreak":true},{"text":"dɛitɛ we ɑ ììkɛ̀.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nfɔ̃́ɔ̃̀ tu okpɑ̀ɑ̀tì sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ í dɑ yɛ̃́ bɛ̀ í yó nkpɑɑ́ ɑ ɛì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":17,"content":[{"text":"A kemmumu bɛcĩ̀rìbɛ̀ dɔ́ tì,","poem":1},{"lineBreak":true},{"text":"kɛ nɑ́ríkùnko bɛ yɛ̀mmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ yo bɛ̀ tu mù.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kɛ kommu iciribí nɛ̀ bɛ̀ fɛ̃́ũnko wè,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ bo yie nkòo nìtì bɑ́ ndɔɔrinɛ̀ otɔù muwɛ̃rímú.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/10.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/11.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/9.json","previousChapterAudioLinks":{},"numberOfVerses":18}