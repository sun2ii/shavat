{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":100,"content":[{"type":"heading","content":["Ti níí tɑ Kuyie ncĩ́ɛ̃̀tɛ̀ nɛ̀ yɛsɑ̃ɑ̃"]},{"type":"verse","number":1,"content":["Disɑ̃nni kó fɛyɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Kɛtenkɛ̀ kɛmɔu kɔbɛ piɛtɛnɛ̀ ti Yiɛ̀ nKuyie.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Mpĩ́nnɛ̀ ti Yiɛ̀ nKuyie ntɔ̃mmú nɛ̀ diwɛ̀ì.","poem":1},{"lineBreak":true},{"text":"Kɔtɛnɛ̀ní ku borɛ̀ kɛ́ndiènnɛ̀ diwɛ̀ì.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɑntɛ́nɛ̀ kɛ dò nKuyie nkuù tu ti Yiɛ̀.","poem":1},{"lineBreak":true},{"text":"Kuù ti dɔ̀ɔ̀ kɛ̀ ti tú ku kɔbɛ,","poem":1},{"lineBreak":true},{"text":"ku nìtìbɛ̀, ku pìètì kù cɛ̃mmú tì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kɛ̀ di níí tɑti ku cĩ́ɛ̃̀tɛ̀ di nkù sɑ̃ntí.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ di tɑ tɛ dɑ̀nkù di ndɛ́úkùnko ku yètìrì,","poem":1},{"lineBreak":true},{"text":"kɛ́ nkù dɔúnnɛ̀ mutɔ̃mmú, kɛ dɛ́úkùnko ku yètìrì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ti Yiɛ̀ nKuyie nnìtimu kɛ̀ ku sɑ̀ɑ̀ mbo sɑ̃́ɑ̃̀.","poem":1},{"lineBreak":true},{"text":"Kuù dɔ̀ɔ̀ri timɔ́mmɔnti nɛ̀ kù bɑɑ bomɛ̀ sɑ̃́ɑ̃̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/100.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/101.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/99.json","previousChapterAudioLinks":{},"numberOfVerses":5}