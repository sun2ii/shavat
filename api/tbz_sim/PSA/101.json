{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":101,"content":[{"type":"heading","content":["Okpɑ̀ɑ̀tì yɛ̃mmɛ̀ ò yóó ntũ ntimɔ́mmɔnti"]},{"type":"verse","number":1,"content":["Dɑfiti kó fɛyɛ̀nfɛ̀.",{"lineBreak":true},{"text":"N yó ndièmmu Kuyie nkó mɛsɑ̀ɑ̀ nnɛ̀ ku beéntì,","poem":1},{"lineBreak":true},{"text":"n yó ndɛ́úkùnko fɔ̃́ɔ̃̀ yètìrì nɛ̀ n kó iyiɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N yó nkérí bɛ̀ɛ̀ dɔ́ mɛwetímmɛ̀ bɛ̀ bo kùù cɛ miɛkɛ nkɛ.","poem":1},{"lineBreak":true},{"text":"Dɛ̀ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɑ̀ɑ kɔtɛní m borɛ̀?","poem":1},{"lineBreak":true},{"text":"N yó ntũ nkucɛ wenniku nku n yɛ̀mmɛ̀ kɔku, n kɔbɛ cuokɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"M bɑ́ɑ́ yie nkɛ́nwúó ndɛ̀mɑrɛ̀ yɛirɛ,","poem":1},{"lineBreak":true},{"text":"n yí dɔ́ bɛ̀ɛ̀ í tũ ntimɔ́mmɔnti bɛ kó mufòmmu,","poem":1},{"lineBreak":true},{"text":"bɛ borimɛ í n yũɔ̃.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Mɛyɛ̀mmɛ̀ yɛimɛɛ fũtɛ m borɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛyɛibɛ m bɑ́ɑ́ bɛ̀ tɔ̀ɔ́nnɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ wɑ́tìrì bɛtɔbɛ̀ disɔ̀rì m bo bɛ̀ dɛ̀ìtɛ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ mɔ̀kɛ sifeí nɛ̀ sipɔɔ yɛmbɛ̀ n yí yóó bɛ̀ wɛ̃nnɛ́nɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bɛ̀ɛ̀ dɔ̀ɔ̀ri timɔ́mmɔnti n yó mbɛ̀ yɛ̃́mu,","poem":1},{"lineBreak":true},{"text":"nɛ̀ bɛ tíì yó nwɛ̃ nkɛ bo,","poem":1},{"lineBreak":true},{"text":"wèè tũ̀ nkucɛ sɑ̀ɑ̀kù weè yó ntú n kóo tɔ̃ntì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Wèè ciintɛ bɛtɔbɛ̀ dɛ yiɛ̀ nyí mɔkɛ dikɑ̀rì m borɛ̀.","poem":1},{"lineBreak":true},{"text":"Wèè mɔ̀kɛ siyɑ́ɑ̀bìsí dɛ yiɛ̀ mbɑ́ɑ́ cómmú n yììkɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɑ́ dìì kṹnweńnì n níí yóó dɛitɛmu bɛyɛibɛ ti kó kɛtenkɛ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"n yó dɛitɛmu bɛ̀ɛ̀ dɔ́nɛ̀ bɛtɔbɛ̀ mɛyɛi n Yiɛ̀ nKuyie nkó dihɛì miɛkɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/101.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/102.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/100.json","previousChapterAudioLinks":{},"numberOfVerses":8}