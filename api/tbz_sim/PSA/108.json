{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":108,"content":[{"type":"heading","content":["N dɔ́ kɛ́nɑmpɛmu kɛ́entɛ dikṹnweńnì ndi"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀ ò dèntɛ̀ fɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N kɔ̃m̀bùɔ̀tì í nɑmpú,","poem":1},{"lineBreak":true},{"text":"Kuyie n yó n dièmmu kɛ dɑ sɑ̃ntí.","poem":1},{"lineBreak":true},{"text":"Kɛ biennɛ̀ dɛbémbénnɛ̀ dɛ̀ɛ̀ tu n kó disɑ̃nni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N kùtìdùùtì nɛ̀ m bómbonti, entɛnɛ̀!","poem":1},{"lineBreak":true},{"text":"N dɔ́ kɛ́entɛ dikṹnweńnì ndi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N Yiɛ̀ nKuyie nyó ndɑ sɑ̃ntímu bɛnìtìbɛ̀ cuokɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ndɛ́úkùnko ɑ yètìrì ibotí cuokɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ yɛ̃́ ɑ sɑ̀ɑ̀ mpɛ̃ɛ̃tóomɛ̀ tiwɛtì,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ kó timɔ́mmɔnti sèńtɛ́ yɛwɛtɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie nhɑ́ ńdɛu kɛĩ́nkɛ̀","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ kpetì ḿbo kɛtenkɛ̀ kɛmɔu ĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A ti dɛɛtɛ́ tínti ɑ dɔ́ bɛ̀ mɛdiɛ̀.","poem":1},{"lineBreak":true},{"text":"Kéntɛ́ m bɑ́ɑmmu, yɑ̀ɑ ti pɑtɛ nɛ̀ ɑ wɛ̃rímú.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kuyie mbɛ́immu ku cɛ̃sɑ̀ɑ̀tɛ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ tú kù yóó bɛ̀ nɑmu, kɛ́totí Sisɛmmu ɛì,","poem":1},{"lineBreak":true},{"text":"kɛ́berí Sukɔti biriku kɛ́totí,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kɛ́nte Kɑdɑɑdi ɛì nɛ̀ Mɑnɑnsee kpɛri.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ Efɑdɑimmu ntú ku pìì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Sudɑɑ tu ku kó kukpɑ̀ɑ̀tìpɑ̀ɑ̀ti.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mɔɑbu tu tɛnɑɑtɛ ntɛ, kù wùɔ̀nɛ̀ tɛ̀,","poem":1},{"lineBreak":true},{"text":"kù nɑmu Edɔmmu koò bɔntɛ́ kunɛùkù dɛ̀ɛ̀ bɛnkú kù bɛ̀ temɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ pɛ́ú Fidisitɛ̃ɛ̃bɛ mɛkpɑ̀rìtɑmmɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"We mbo n kɔtɛnɛ̀ dihɛikperì?","poem":1},{"lineBreak":true},{"text":"We mbo n tɑnnɛ́ Edɔmmu tenkɛ̀?","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɛ̀ dɛ̀ í tú fɔ̃́ nKuyie nkùù do ti dootóo,","poem":1},{"lineBreak":true},{"text":"bɑ́ ɑ tɛ̃́nkɛ í niɛ̀nɛ̀ ti kó bɛhɑ̃ɑ̃pɔ̀mbɛ̀ mudoò.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kɔtɛní kɛ́ tí teennɛ̀, tí pɑtɛnɛ̀ ti dootitɔbɛ̀.","poem":1},{"lineBreak":true},{"text":"Kɛ yɛ̃́ onìtì kó mɛteèmmɛ̀ í túmɛ̀ mɛ̀mɑmɛ̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kuyie nyó nti bonɛ̀mu kɛ̀ ti pĩ́ mmutɔ̃ndiɛmù.","poem":1},{"lineBreak":true},{"text":"Kuù yóó nɑ̀u ti dùɔ̀ntɔbɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/108.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/109.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/107.json","previousChapterAudioLinks":{},"numberOfVerses":14}