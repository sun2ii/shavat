":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ bɛ yɛ̀mmɛ̀ miɛkɛ dòmmɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuyie nyɛ̃́mu osɑ̀ɑ̀wè nɛ̀ oyɛiwe bɛ yɛ̀mmɛ̀,","poem":1},{"lineBreak":true},{"text":"kù í dɔ́ oyonkuwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie nyóó cṹũnní yɛhɑ̃ɑ̃kũɔ̃ nyɛ nɛ̀ mɛhɑ̃ɑ̃kpɛ̀rìmɛ̀ bɛnitiyɛibɛ ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ kó tiyeti dɛ ntú.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie ntu timɔ́mmɔnti yiɛ̀ nwe,","poem":1},{"lineBreak":true},{"text":"kɛ dɔ́ wèè dɔ̀ɔ̀ri timɔ́mmɔnti,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ pĩ ntimɔ́mmɔnti bɛɛ̀ yóó kù yɑ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/11.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/12.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/10.json","previousChapterAudioLinks":{},"numberOfVerses":7}