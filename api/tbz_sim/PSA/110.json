{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":110,"content":[{"type":"heading","content":["Kuyie ntɑ̃ɑ̃tɛ́ wè kòò tu ikuɔ́ nìùtì kɛ tú okpɑ̀ɑ̀tì"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie n nɑ̀kɛ́mu n Yiɛ̀ nkɛ yĩ","poem":1},{"lineBreak":true},{"text":"we nkɑ̀ri o bɑkù yoú,","poem":1},{"lineBreak":true},{"text":"kɛ kémmúnɛ̀ kù bo ò duɔ́mmɛ̀ o dootitɔbɛ̀,","poem":1},{"lineBreak":true},{"text":"kòo bɛ̀ cùùti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuyie ndɑ duɔ́mmu fɛkpɑ̀ɑ̀tìpɑ̀tìfɛ̀ Siyɔ̃ɔ̃,","poem":1},{"lineBreak":true},{"text":"mbɑkɛ́ ɑ dootitɔbɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A kpɑ̀rìnuɔmbɛ dɑ duɔ́mmu bɛmɑ́ɑ̀,","poem":1},{"lineBreak":true},{"text":"ɑ ɔ̃ nyóó tíí nhɑ ɑ̃ɑ̃pɔ̀mbɛ̀ kɛ̀ bɛ̀ɛ kɔtɛnímu nɛ̀ tikɔ̃nyɑuti ɑ cɛ̃sɑ̀ɑ̀tɛ̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ dɑpɑ̀ntì kó muwɛ̃rímúu wɛ̃tɛní ɑ borɛ̀","poem":1},{"lineBreak":true},{"text":"tikṹnwentɛ́mɑɑ̀ntì kɔ̃mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ti Yiɛ̀ nKuyie m bɛ́immu kɛ ĩkú,","poem":1},{"lineBreak":true},{"text":"kù í yóó kpɑtɛ ku nùù.","poem":1},{"lineBreak":true},{"text":"Kù yĩ ɑ tú ikuɔ́ nìùtì nwe sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"kɛ dònnɛ̀ Mɛsisedɛki.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie, n kómmú fɔ̃́ nwe,","poem":1},{"lineBreak":true},{"text":"kù miɛkɛ bo ítɛ́ dìì yiè,","poem":1},{"lineBreak":true},{"text":"kù bo ũtirɛ bɛkpɑ̀ɑ̀tìbɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie nyóó bekɛ́nɛ̀mu yɛbotɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛcíríbɛ̀ mɑ́ɑ̀ píɛ ndihɛì.","poem":1},{"lineBreak":true},{"text":"Kù kóo kpɑ̀ɑ̀tì yóó ũtirɛmu kɛtendiɛkɛ̀ kóo kpɑ̀ɑ̀tì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ò yó nkérí kɛ́yɑ̃̀ kukó nku,","poem":1},{"lineBreak":true},{"text":"kɛ́wɛ̃tɛ kɛ́pɛ́tɛ́ muwɛ̃rímú ò yóó nɑnɛ̀ mù o dootitɔbɛ̀.","poem":1},{"noteId":3}]}],"footnotes":[{"noteId":3,"caller":"+","text":"fr 110:7 Dɛ kó tinɑ́ɑǹtì bo nɑ kɛ́mbɛnkú bɛhɑ̃ɑ̃pɔ̀mbɛ̀ bɛ̀ɛ̀ do yɑ̃̀ kukó nkɛ́pɛ́tɛ́ muwɛ̃rímú Sedeɔ̃ɔ̃ kó dimɔ̀nnì, yoo ti Yiɛ̀ nYesu wèè nɑ o dootitɔbɛ̀ nɛ̀ Kuyie nkó mɛteèmmɛ̀, kɛ kérí kɛ yíéo.","reference":{"chapter":110,"verse":7}}]},"thisChapterLink":"/api/tbz_sim/PSA/110.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/111.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/109.json","previousChapterAudioLinks":{},"numberOfVerses":7}