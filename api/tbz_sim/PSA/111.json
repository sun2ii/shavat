{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":111,"content":[{"type":"heading","content":["Bɛ̀ sɑ̃ntímɛ̀ Kuyie nkù dɔ̀ɔ̀ dɛ̀ kpɛ́í"]},{"type":"verse","number":1,"content":[{"text":"Nsɑ̃ntínɛ̀ Kuyie, kù bomu nsɑ̃́ɑ̃̀!","poem":1},{"lineBreak":true},{"text":"N yó nsɑ̃ntímu n Yiɛ̀ nKuyie nnɛ̀ n yɛ̀mmɛ̀ mɛmɔu","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ tũ ntimɔ́mmɔnti bɛ cuokɛ̀, ku tĩ̀nnì tìkú dɛ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie ntɔ̃mmú dɛumu,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ mù dɔ́ kɛ̀ bɛ̀ wɑnti kɛ́ mù yĩ̀ɛ̃́tɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ku tɔ̃mmú dɛumu kɛ wenni,","poem":1},{"lineBreak":true},{"text":"kù dɔ̀ɔ̀ri timɔ́mmɔnti nti sɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kù dɔ́ tí nyɛ̃́mu kù pĩ́ mmùù tɔ̃ndiɛmù kpɛ́í,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nsɑ̀mu kɛ mɔkɛ onìtì kó mɛsémmɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ duɔ̀ mmudiì bɛ̀ɛ̀ kù dé,","poem":1},{"lineBreak":true},{"text":"kù í yĩɛ̃̀ nkù bɛ̀ dɔúnnɛ̀ dìì nùù kpɛ́í bìtì.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kù bɛnkɛmu ku nìtìbɛ̀ kù pĩ mmùù tɔ̃ndiɛmù,","poem":1},{"lineBreak":true},{"text":"kɛ bɛ̀ duɔ́ nyibotí tɛì kó yɛhɛkɛ̀ kɛ̀ bɛ̀ tiekɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kù dɔ̀ɔ̀ri dɛ̀ɛ̀ kó dimɑ̀ɑ̀ tu timɔ́mmɔnti nti kɛ síɛ́,","poem":1},{"lineBreak":true},{"text":"ku tɑnnɔ̀ í ceeri.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Yɛ̀ fìíkúmu sɑ̃́ɑ̃̀, yɛ̀ í yóó ceetɛ,","poem":1},{"lineBreak":true},{"text":"yɛ̀ tu timɔ́mmɔnti nti kɛ síɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuù dontɛ́ ku nìtìbɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ bɛ̀ dɔ̀ɔ̀nɛ̀ mɛtɑummɛ̀ kɛ̀ mɛ̀ bo sɑ̃́ɑ̃̀.","poem":1},{"lineBreak":true},{"text":"Kù dò mpɑ́íí nwe, kɛ duò tikɔ̃m̀bùɔ̀tì.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A bo ndémɛ̀ Kuyie ndɛɛ̀ tu mɛciì nkó diketírì,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ dɔ̀ɔ̀ri mɛmmɛ bɛ̀ mɔ̀kɛ mɛyɛ̀mmɛ̀ mmɛ.","poem":1},{"lineBreak":true},{"text":"Kuyie nhɑ sɑ̃nni bomu nsɑ̃́ɑ̃̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/111.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/112.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/110.json","previousChapterAudioLinks":{},"numberOfVerses":10}