{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":112,"content":[{"type":"heading","content":["Wèè wetí ò ɔ̃ nkɑrimɛ̀ kɛ í yĩɛ̃̀kù"]},{"type":"verse","number":1,"content":[{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie!","poem":1},{"lineBreak":true},{"text":"Dɛ̀ nnɑɑti onìtì wèè dé Kuyie,","poem":1},{"lineBreak":true},{"text":"dɛ̀ nnɑɑti wèè piɛti diwɛ̀ì ku tɑnnɔ̀ miɛkɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuyie mbo dɔɔ̀ mɛsɑ̀ɑ̀ nwèè wetí o kó fɛyɑnfɛ̀,","poem":1},{"lineBreak":true},{"text":"o kó kuwuɔ mbo nkpeńnì bɛ tenkɛ̀ miɛkɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɛsɑ̀ɑ̀ nɛ̀ tikpɑ̀tì dɛ̀ yó mbomu dɛ yiɛ̀ ncĩ́ɛ̃̀tɛ̀,","poem":1},{"lineBreak":true},{"text":"Kuyie nhò wùó nwèè wetí wènwe sɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛ̀ dɛ̀ bììtoo wèè wetí Kuyie nkuù ɔ̃ɔ̃ ò mìítɛ́,","poem":1},{"lineBreak":true},{"text":"wèè sɑ̀ kɛ mɔkɛ onìtì kó mɛsémmɛ̀,","poem":1},{"lineBreak":true},{"text":"Kuyie nkuù ɔ̃ nhò mí.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dɛ̀ ńnɑɑti onìtì wèè pènni bɛtɔbɛ̀ o kpɛrɛ nɛ̀ diwɛ̀ì,","poem":1},{"lineBreak":true},{"text":"kɛ tũ nyikuɔ́ duɔ́ kɛ dòmmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ tũnni o kpɛti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Dɛ yiɛ̀ nhɔ̃ í ndo bìtì.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ ɔ̃ nyɛ̃́mu wèè wetí o kpɛ́í nsɑ̃́ɑ̃̀","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dɛ yiɛ̀ nkòo kèè tiyɛiti mɑtì ò ɔ̃ɔ̃ í nyĩɛ̃̀kù,","poem":1},{"lineBreak":true},{"text":"dɛ̀ ɔ̃ɔ̃ í nhò nɑmpɛ kɛ yɛ̃́ ò duɔ́mmɛ̀ omɑ́ɑ̀ Kuyie nku.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"O kɔ̃m̀bùɔ̀tì í duò, ò í yĩɛ̃̀kù dɛ̀mɑrɛ̀,","poem":1},{"lineBreak":true},{"text":"kòò wetí o dootitɔbɛ̀, ò ɔ̃ nyɛ̃́mu weè yóó nɑmɛ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"O nɔ̀ùtɛ̀ yɑ̀ɑmmu kòò pɑ̃ɑ̃ mbɛcĩ̀rìbɛ̀,","poem":1},{"lineBreak":true},{"text":"Kuyie nhò wùó nwèè wetí wènwe sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"o wɛ̃rímú nɛ̀ o kpetì kɛ̀ dɛ̀ dɛ̀úkú.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kòo yɛiwe ò wùó nkɛ̀ dɛ̀ ò yóù,","poem":1},{"lineBreak":true},{"text":"kòò cɑ̀ɑ́ nho nìì kɛ cĩtiri,","poem":1},{"lineBreak":true},{"text":"oyɛiwe dɔ́ dɛ̀ ɔ̃ɔ̃ yɛ̀ dɛtetìrɛ̀ ndɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/112.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/113.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/111.json","previousChapterAudioLinks":{},"numberOfVerses":10}