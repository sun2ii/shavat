{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":113,"content":[{"type":"heading","content":["Ti dòmmɛ̀ kɛ́nsɑ̃ntí ti Yiɛ̀ nKuyie"]},{"type":"verse","number":1,"content":[{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie!","poem":1},{"lineBreak":true},{"text":"Díndi ti Yiɛ̀ nKuyie nkó bɛtɔ̃mbɛ̀, ńsɑ̃ntínɛ̀ ku,","poem":1},{"lineBreak":true},{"text":"ndɛ́úkùnkonɛ̀ ti Yiɛ̀ nKuyie nyètìrì.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nyètìrì ndɛu","poem":1},{"lineBreak":true},{"text":"kɛ́túótɛ́ yíe nnɛ̀ ti bo mbomɔ̀ɔ sɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ndɛ́úkùnkonɛ̀ ti Yiɛ̀ nKuyie nyètìrì,","poem":1},{"lineBreak":true},{"text":"diyiè bo yɛ̀nnímɛ̀ nɛ̀ di yɑ̀ɑ bo tɑmɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù bɑkɛ́ yɛbotɛ̀ yɛmɔu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ku kpetì dèkɛ kɛ sèńtɛ́ tiwɛtì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"We ndònnɛ̀ ti Yiɛ̀ nKuyie nti tũ nkù?","poem":1},{"lineBreak":true},{"text":"Ku kpɑ̀ɑ̀tìkɑ̀rì bo kɛĩ́nkɛ̀ nkɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛ̀ ku ɔ̃ɔ̃ sĩ́nnɛ́ kɛ́wéntɛ́ní,","poem":1},{"lineBreak":true},{"text":"kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuù ɔ̃ɔ̃ íinní osénnìwè mutɑ̃́ɑ̃́ mmiɛkɛ,","poem":1},{"lineBreak":true},{"text":"kuù ɔ̃ɔ̃ kũtɛ́ní ocĩ̀rì ditɑ́pùò miɛkɛ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kóò wɛ̃nnɛ́nɛ̀ sikpɑ̀ɑ̀tìbìí kɛ́kɑnnɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ wèe wɛ̃nnɛ́nɛ̀ o ɛì kó bɛkótíbɛ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuù ɔ̃ɔ̃ pɑ̃ tɛcĩ́ɛ̃̀tɛ̀ wèè do tú tɛhɑ̃ũntɛ,","poem":1},{"lineBreak":true},{"text":"kòò nɑɑ́ nhobíyɔ̃ kɛ́mbonɛ̀ diwɛ̀ì.","poem":1},{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/113.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/114.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/112.json","previousChapterAudioLinks":{},"numberOfVerses":9}