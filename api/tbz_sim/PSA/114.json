ɛ kɑ̀ɑ niɛ mbòtí?","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Díndi yɛtɑ̃rɛ̀ dɛ̀ dòmmɛ kɛ̀ di puù yɛpedɑkɛ̀ kɔ̃mɛ?","poem":1},{"lineBreak":true},{"text":"Sitɑ̃ɑ̃́ bɑ nte kɛ̀ di puù yɛbɔdɑkɛ̀ tɛ̃mɛ̀?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kɛtenkɛ̀ ɑ kɔ̃̀ntì nhɑu ti Yiɛ̀ nKuyie nyììkɛ̀,","poem":1},{"lineBreak":true},{"text":"kunku Sɑkɔbu do tũ nkù","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuù ɔ̃ɔ̃ ceetɛ dipèrì borɛ̀ kɛ̀ dɛ̀ɛ nɑɑ́ ndibinni,","poem":1},{"lineBreak":true},{"text":"kutɑ̃ɑ̃́ duɔ́ dɛ̀ kɛ̀ dɛ̀ɛ nɑɑ́ nkukó.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/114.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/115.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/113.json","previousChapterAudioLinks":{},"numberOfVerses":8}