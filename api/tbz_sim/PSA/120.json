tent":[{"lineBreak":true},{"text":"N kóò kɛ́mbo bɛkpɑ́kpɑ̀rìbɛ̀ cuokɛ̀ dɛ̀ í n dɔ̀ɔ̀ mɛsɑ̀ɑ̀,","poem":1},{"lineBreak":true},{"text":"n kóò kɛ́nhɑ̃nɛ̀ bɛ̀ɛ̀ í yɛ̃́ Kuyie dɛ̀ n cɑ̀ɑ̀rɛ̀mu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N kɑrinɛ̀ bɛ̀ɛ̀ í dɔ́ kunɑɑtí kɛ̀ dɛ̀ mɔ̀ntɛmu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Mí n dɔ́ kunɑɑtí nku,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n nɛ́ nɑ́ɑ́ mbɛ̀ nni nwɑntinɛ̀ mudoò.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/120.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/121.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/119.json","previousChapterAudioLinks":{},"numberOfVerses":7}