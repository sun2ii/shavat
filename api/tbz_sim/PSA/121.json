{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":121,"content":[{"type":"heading","content":["Ti Yiɛ̀ nKuyie ntúmɛ̀ Isidɑyɛɛribɛ kóo bɑ̀rì"]},{"type":"verse","number":1,"content":["Bɛ̀ ɔ̃ nkɔri Kuyie ncĩ́ɛ̃̀tɛ̀ kɛ dentì fɛ̀ɛ̀ yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"M búɔ́ yɛtɑ̃rɛ̀ bíɛ́kɛ̀ nkɛ","poem":1},{"lineBreak":true},{"text":"mɛteèmmɛ̀ yóó kɛ nyɛnní.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N Yiɛ̀ nKuyie nkuù tu n kóo teèntì,","poem":1},{"lineBreak":true},{"text":"kunku kùù dɔ̀ɔ̀ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuyie mbɑ́ɑ́ yóu díndi Isidɑyɛɛribɛ kɛ̀ di nɑɑ̀cɛ̀ii seitɛ,","poem":1},{"lineBreak":true},{"text":"wèè di bɑɑ munɔndɔmmú í ò pĩĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Isidɑyɛɛribɛ kóo bɑ̀rì munɔndɔmmú í ò pĩĩ,","poem":1},{"lineBreak":true},{"text":"ò ɔ̃ɔ̃ í nyɛ̃̀ nkɛ́duɔ́.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù tu di kóo bɑ̀rì kɛ di díɛ́kɛ́ ku kó mɛdɛ́ɛ̀,","poem":1},{"lineBreak":true},{"text":"kù bomu di bɑkù yoú.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Diyiè bɑ́ɑ́ di kɔkɛ́nɛ̀ kuyie mmɔ̀nnì,","poem":1},{"lineBreak":true},{"text":"yoo otɑ̃̀nkù kɛyènkɛ̀ mɔ̀nnì.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nyó ndi kɑ̃nkɛ́mu mɛyɛi mɛmɔu.","poem":1},{"lineBreak":true},{"text":"Kù yó nkɑ̃nkɛ́mu di fòmmu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɛ̀ di yɛtì, ti Yiɛ̀ nKuyie nyó ndi bonɛ̀mu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ di kũntiní kù ndi bonɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́túótɛ́ yíe nnɛ̀ di bo mbomɔ̀ɔ sɑ̃́ɑ̃̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/121.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/122.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/120.json","previousChapterAudioLinks":{},"numberOfVerses":8}