i dɑ̀tínnɛ́,","poem":1},{"lineBreak":true},{"text":"yɛnɛ́fĩ̀nfĩ̀rɛ̀ diɛyɛ̀ yɛɛ̀ nɑ mpɛ̃ɛ̃tɛ́ ti ĩ́nkɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ti Yiɛ̀ nKuyie nyètìrì ndɛu,","poem":1},{"lineBreak":true},{"text":"kunku kùù í yóu kɛ̀ bɛ̀ ti di.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuù te kɛ̀ ti nɑ kɛ yentɛ́,","poem":1},{"lineBreak":true},{"text":"tɛnɔ̀tɛ̀ ɔ̃ɔ̃ yentɛ́nɛ̀ mɛ̀ɛ̀ botí ticùɔ̀tì,","poem":1},{"lineBreak":true},{"text":"kuù tɔ̃̀tɛ ticùɔ̀tì kɛ̀ ti nɑ kɛ yentɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ti kó mɛteèmmɛ̀ boní ti Yiɛ̀ nKuyie mborɛ̀ ndɛ,","poem":1},{"lineBreak":true},{"text":"kunku kùù dɔ̀ɔ̀ kɛtenkɛ̀ nɛ̀ kɛĩ́nkɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/124.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/125.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/123.json","previousChapterAudioLinks":{},"numberOfVerses":8}