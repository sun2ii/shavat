̀,","poem":1},{"lineBreak":true},{"text":"mɛniɛ nhɔ̃ɔ̃ tɑ mɛ̀ɛ̀ botí kukó nkùù do kũ̀ṹ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Wèè buɔtì nɛ̀ tinɔnniɛti,","poem":1},{"lineBreak":true},{"text":"ò ɔ̃ ntì dɛ̀ì kɛ dièmmu nɛ̀ diwɛ̀ì.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Wèè kɔ̃ti kɛ bo buɔtí tidibotì kɛ kɔnti,","poem":1},{"lineBreak":true},{"text":"ò ɔ̃ɔ̃ nti dɛ̀ì kɛ́ntɔ kɛ̀ diwɛ̀ì diì ò bo","poem":1},{"lineBreak":true},{"text":"kòò ìútí kɛ kũnti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/126.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/127.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/125.json","previousChapterAudioLinks":{},"numberOfVerses":6}