{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":127,"content":[{"type":"heading","content":["Kuyie nkuù mɑɑ̀ tɛcĩ́ɛ̃̀tɛ̀"]},{"type":"verse","number":1,"content":["Sɑdomɔɔ kó fɛyɛ̀nfɛ̀, bɛ̀ ɔ̃ ndiè nfɛ̀ kɛ kɔri Kuyie ncĩ́ɛ̃̀tɛ̀.",{"lineBreak":true},{"text":"Kɛ̀ ti Yiɛ̀ nKuyie nyí mɑɑ́ tɛcĩ́ɛ̃̀tɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ɛ̀ tɛ̀ mɑɑ̀ bɛ̀ ɔ̀ù dɛtetìrɛ̀ ndɛ.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ ti Yiɛ̀ nKuyie nyí bɑɑ dihɛì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ wèè dì bɑ̀ɑ ò dì bɑ̀ɑ̀ dɛtetìrɛ̀ ndɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Di bo nɑ kɛ níí pikɛ entɛ mɛcɑ̃ɑ̃ nkɛ́kɔ̃tɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ bɑ́ɑ́ cɑ̃rikɛ kɛ́konní,","poem":1},{"lineBreak":true},{"text":"kɛ níí kɑ̃́tɛ́ di tĩ́ĩ̀ nkɛ nɑ kɛ́pɛ́tɛ́ kɛ́di,","poem":1},{"lineBreak":true},{"text":"Kuyie nkuu mɛ nduɔ̀ nkù dɔ́ wè o dɔ́ù ndi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ibí tú mɛsɑ̀ɑ̀ mmɛ ti Yiɛ̀ nKuyie nhɔ̃ɔ̃ dɔɔ̀mɛ̀ tɛcĩ́ɛ̃̀tɛ̀,","poem":1},{"lineBreak":true},{"text":"ibí tú mucɔ̃́ntimu mmu ti Yiɛ̀ nKuyie ndi duɔ̀ mmù.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ipie nhɔ̃ ndommɛ̀ okpɑ̀rìnuɔnti nɔu miɛkɛ,","poem":1},{"lineBreak":true},{"text":"onìtì pɛitɛ ìì bí o dɑcɛ̃ntì mɔ̀nnì ì ɔ̃ mmɛ nhò dò.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dɛ̀ nnɑɑti onìtì wèè píɛ nyipie nho doò,","poem":1},{"lineBreak":true},{"text":"dɛ yiɛ̀ nhò bo bootɛnɛ̀ dìì mɔ̀nnì o dootitɔbɛ̀ dihɛì kó dibòrì nùù","poem":1},{"lineBreak":true},{"text":"dɛ̀ bɑ́ ò di.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/127.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/128.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/126.json","previousChapterAudioLinks":{},"numberOfVerses":5}