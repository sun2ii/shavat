:"kù ɔ̃ɔ̃ ò dɔ̀ɔ̀ mɛsɑ̀ɑ̀ mmɛɛ̀ botí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kuyie nhɑ́ mboní ɑ cĩ́ɛ̃̀tɛ̀,","poem":1},{"lineBreak":true},{"text":"Siyɔ̃ɔ̃ tɑ̃rì kóò dɔ̀ɔ̀ mɛsɑ̀ɑ̀,","poem":1},{"lineBreak":true},{"text":"kòò yɑ̀ Sedisɑdɛmmu yóó yɑ̀ mɛ̀ɛ̀ sɑ̀ɑ̀","poem":1},{"lineBreak":true},{"text":"o fòmmu mumɔu miɛkɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kòò yɑ̀ o yɑɑ̀bí.","poem":1},{"lineBreak":true},{"text":"Kunɑɑtí mbonɛ̀ Isidɑyɛɛribɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/128.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/129.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/127.json","previousChapterAudioLinks":{},"numberOfVerses":6}