{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":129,"content":[{"type":"heading","content":["Bɛyɛibɛ cɑ̀kɛmu kɛ̀ dɛ̀ dɛu"]},{"type":"verse","number":1,"content":["Bɛ̀ ɔ̃ ndentì fɛ̀ɛ̀ yɛ̀nfɛ̀ kɛ kɔri Kuyie ncĩ́ɛ̃̀tɛ̀.",{"lineBreak":true},{"text":"N dootitɔbɛ̀ n do kɛ n domu mudoò nɛ̀ m bɛmmɛ̀.","poem":1},{"lineBreak":true},{"text":"Isidɑyɛɛribɛ nnɑ́ɑ́nnɛ̀ ti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɛ̀ n do kɛ n domu mudoò nɛ̀ m bɛmmɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ mɛ nyí n nɑ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kɛ dirí kɛ dirí n yĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ dò mbɛ̀ dɛí kupɑku ipɛ̃ nhokùì.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nwetímu,","poem":1},{"lineBreak":true},{"text":"kuù tɔ̃̀tɛ bɛyɛibɛ kó iwɛ̃ĩ iì do m boú.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bɛ̀ɛ̀ kó dimɑ̀ɑ̀ í dɔ́ Siyɔ̃ɔ̃ ɛì,","poem":1},{"lineBreak":true},{"text":"ifɛi bɛ̀ pĩ nkɛ̀ bɛ̀ɛ bútínnɛ́ kɛ́cokɛ́.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɛ̀ dònnɛ̀ timútì tìì ɔ̃ɔ̃ yɛ̀nní tìnti kudɑ̀nkù ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ ɔ̃ nkpɑɑ́ kɛ í uutɛ́ tì kɛ̀ tì kpeío.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Tì mɛ mbɑ́ɑ́ píɛ nwèè tì uutɛ́ o nɔ̀ùtɛ̀,","poem":1},{"lineBreak":true},{"text":"tì mɛ mbɑ́ɑ́ tuɔkɛ ò bo tì boúmɛ̀ dibou.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɛcɛpɛ̃̀mbɛ̀ bɑ́ɑ́ mɔɔ ti Yiɛ̀ nKuyie nkó mɛsɑ̀ɑ̀ ndi kpɛ́í.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ bɑ́ɑ́ yĩ́:","poem":1},{"lineBreak":true},{"text":"Ti tú ti Yiɛ̀ nKuyie ndi dɔɔ̀ mɛsɑ̀ɑ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/129.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/130.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/128.json","previousChapterAudioLinks":{},"numberOfVerses":8}