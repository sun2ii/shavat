{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":13,"content":[{"type":"heading","content":["Onìtì dɔ́mɛ̀ Kuyie nhò dɛɛtɛ́ kɛ̀ dɛ̀ ò ɔɔtí"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie ndɛ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɑ̀ɑ dentɛní n kpɛ́í?","poem":1},{"lineBreak":true},{"text":"Dɛ̀ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɑ̀ɑ yóu kɛ̀ n dɑ yɑ̀?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɛ̀ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɛ̀ iyĩ̀ɛ̃̀kɛ nɛ̀ mɛyɛǹcɑɑ̀rìmɛ̀ yɛwe yɛmɔu kɔ̃mɛ kɛ̀ dɛ̀ɛ deè m miɛkɛ?","poem":1},{"lineBreak":true},{"text":"Dɛ̀ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɛ̀ n nɑ n dootitɔbɛ̀?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yiɛ̀ nKuyie nwéntɛ́ní kɛ́keè n tú mù,","poem":1},{"lineBreak":true},{"text":"kɛ́ n yíɛ́ muwɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"n yɑ̀ɑ̀ bo kú.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ̀ n dootitɔbɛ̀ bɑ́ɑ́ yĩ́ bɛ̀ n nɑ,","poem":1},{"lineBreak":true},{"text":"dɛ̀ yɑ̀ɑ̀ bo nɑrikɛ n dootitɔbɛ̀ n yĩɛ̃kɛmɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N yɛ̃́mu ɑ túmɛ̀ mɛsɑ̀ɑ̀ nyiɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n yɛ̀mmɛ̀ nɑɑti ɑ n dɛɛtɛ́mɛ̀.","poem":1},{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie, n yó ndiè nkɛ dɑ sɑ̃ntímu,","poem":1},{"lineBreak":true},{"text":"ɑ n dɔ̀ɔ̀ mɛ̀ɛ̀ sɑ̀ɑ̀ nkpɛ́í.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/13.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/14.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/12.json","previousChapterAudioLinks":{},"numberOfVerses":6}