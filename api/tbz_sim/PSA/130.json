{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":130,"content":[{"type":"heading","content":["Mɛyɛǹcɑɑ̀rìmɛ̀ kó fɛyɛ̀nfɛ̀"]},{"type":"verse","number":1,"content":["Bɛ̀ ɔ̃ ndentì fɛ̀ɛ̀ yɛ̀nfɛ̀ kɛ kɔri Kuyie ncĩ́ɛ̃̀tɛ̀.",{"lineBreak":true},{"text":"Mɛyɛǹcɑɑ̀rìmɛ̀ mɛɛ̀ m bi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n dɑ yu fɔ̃́ n Yiɛ̀ nKuyie.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie, keè n tɑmmɛ̀,","poem":1},{"lineBreak":true},{"text":"bíinní ɑ toò kɛ́keè ibɑ́ɑmmìi n dɑ bɑ́ɑ́ nyì.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkɑ̀ɑ tu ɑ bo wéntɛ́ ti yɛi,","poem":1},{"lineBreak":true},{"text":"we mbo nkpɑɑ́ bo?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A mɛ ntu mɛcĩ́ɛ̃́mmɛ̀ yiɛ̀ nwe,","poem":1},{"lineBreak":true},{"text":"kɛ dò nti ndɑ dé.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"M buɔ́ n Yiɛ̀ nKuyie nku,","poem":1},{"lineBreak":true},{"text":"n kémmú kù yó n nɑ́kɛ́ tì nti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N wɛ̃nnì yɑ̀ɑ́ nYiɛ̀ nKuyie","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ pɛ̃ɛ̃tɛ́mu ohɛikɛ̀mbɑ̀rì ɔ̃ nyɑ́ɑ́mmɛ̀ dikṹnweńnì.","poem":1},{"lineBreak":true},{"text":"Dɛ̀ pɛ̃ɛ̃tɛ́mu ohɛibɑ̀rì yɑ̀ɑ́mmɛ̀ dɛ̀ bo wentɛ́mɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Isidɑyɛɛribɛ, mbúɔ́nɛ̀ ti Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ mɛsɑ̀ɑ̀ mbomɛ̀ kuù borɛ̀,","poem":1},{"lineBreak":true},{"text":"mɛdɛɛtímɛ̀ mɛbotí mɛbotí bo kuù borɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuù yóó dɛɛtɛ́ Isidɑyɛɛribɛ bɛ yɛi mmɛmɔu miɛkɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/130.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/131.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/129.json","previousChapterAudioLinks":{},"numberOfVerses":8}