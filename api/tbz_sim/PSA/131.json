{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":131,"content":[{"type":"heading","content":["Wèè dèntɛ̀ ò kɛ̃́kùnnɛmɛ̀ omɑ́ɑ̀ dɛbirɛ kɔ̃mɛ"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀ bɛ̀ ɔ̃ ndentì fɛ̀ kɛ kɔri Kuyie ncĩ́ɛ̃̀tɛ̀.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie, n yí mɔkɛ tɛfentɛ̀,","poem":1},{"lineBreak":true},{"text":"n yí tú tɛpɔ̀tɛ̀ yiɛ̀,","poem":1},{"lineBreak":true},{"text":"n yí bɛtì dɛdiɛrɛ̀,","poem":1},{"lineBreak":true},{"text":"n yí wɑnti dɛ̀ɛ̀ m pɛ̃ɛ̃tɛ́.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N dò mbɛ́u nwe, kɛ dò nsó,","poem":1},{"lineBreak":true},{"text":"dɛbirɛ dɛ̀ɛ̀ yɑ̃ɑ̃́ nkɛ sɑnnɛ̀ dɛ̀ ɔ̃ ndòmmɛ̀ dɛ yɔ̃ kpèrɛ̀ ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"n yɛ̀mmɛ̀ dònnɛ̀ dɛbirɛ kɔ̃mɛ dòmmɛ̀ mmɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Isidɑyɛɛribɛ, nyĩkúnɛ̀ di Yiɛ̀ nKuyie nyĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́túótɛ́ di mmɔ̀nnì nɛ̀ sɑ̃́ɑ̃̀o.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api