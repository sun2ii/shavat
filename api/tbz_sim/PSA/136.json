{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":136,"content":[{"type":"heading","content":["Disɑ̃nni kó fɛyɛ̀nfɛ̀"]},{"type":"verse","number":1,"content":[{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie, kù nìtimu,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ Kuyie nkù kpénnìnɛ̀mu yɛbɔkɛ̀ yɛmɔu,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie nkuù bɑkɛ́ dɛmɔu,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kuù mɑ́ɑ̀ dɔ̀ɔ̀ri tidiɛtì,","poem":1},{"lineBreak":true},{"text":"kù sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuù dɔ̀ɔ̀ kɛĩ́nkɛ̀ nɛ̀ ku kó mɛciì,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuù pitɛ́ kɛtenkɛ̀ mɛniɛ nyĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuù dɔ̀ɔ̀ diyiè nɛ̀ otɑ̃̀nkù nɛ̀ siwɑ̃̀ɑ̃.","poem":1},{"lineBreak":true},{"text":"Ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuù dɔ̀ɔ̀ diyiè kɛ̀ dì bo mmí kuyie,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuù dɔ̀ɔ̀ otɑ̃̀nkù nɛ̀ siwɑ̃̀ɑ̃ kɛ̀ dɛ̀ bo mmí kɛyènkɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kunku kùù kùɔ Esibiti tenkɛ̀ kɔbɛ bɛ̀ɛ̀ tu Mpo,","poem":1},{"lineBreak":true},{"text":"kù sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɛ dènnɛ Isidɑyɛɛribɛ Esibiti ɛì kɔbɛ cuokɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Nɛ̀ ku wɛ̃rímú diɛmù mmu kù bɛ̀ dènnɛmɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kuù do totɛ́ tipèntì kóo dɑ̀mɛ́ɛ̀rì mɛ̀dɛ́mɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɛ duɔ́ nkɛ̀ Isidɑyɛɛribɛ nɑ̀ o miɛkɛ kɛ sèńtɛ́,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Kuù dìu Esibiti kóo kpɑ̀ɑ̀tì nɛ̀ o ɑ̃ɑ̃pɔ̀mbɛ̀ tipèntì kóo dɑ̀mɛ́ɛ̀rì,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Kuù do ni ku nìtìbɛ̀ bɛ̀ kèrí dɛ̀ dikpɑ́ɑ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kuù do kɔùtì bɛkpɑ̀ɑ̀tìbɛ̀ diɛbɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Kuù do kùɔ bɛkpɑ̀ɑ̀tìkperíbɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Amɔriibɛ kpɑ̀ɑ̀tì Siyɔ̃ɔ̃,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Bɑsɑ̃ɑ̃ tenkɛ̀ kóo kpɑ̀ɑ̀tì Ɔku,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Kɛ̀ bɛ̀ɛ tiekɛ bɛ tenkɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ku kó bɛtɔ̃mbɛ̀ Isidɑyɛɛribɛ bɛɛ̀ do tiekɛ bɛ tenkɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":23,"content":[{"text":"Ti bo dìì mɔ̀nnì mɛsémmɛ̀ miɛkɛ kù í yĩɛ̃̀ nti kpɛ́í.","poem":1},{"lineBreak":true},{"text":"Ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Kuù ti dɛɛtɛ́nɛ̀ ti dùɔ̀ntɔbɛ̀,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Kuù duɔ̀ nfɛnitiyɑnfɛ̀ fɛmɔu mudiì,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ Kuyie nkù bɑkɛ́mu dɛmɔu,","poem":1},{"lineBreak":true},{"text":"ku sɑ̀ɑ̀ nyí mɔkɛ kumɑ̀nku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/