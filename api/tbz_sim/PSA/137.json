{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":137,"content":[{"type":"heading","content":["Bɛ̀ pĩ̀ḿmú bɛ̀ kɛ dɔ̀ɔ̀ tidɑɑtì bɛ̀ dìè nfɛ̀ɛ̀ yɛ̀nfɛ̀"]},{"type":"verse","number":1,"content":[{"text":"Ti do kɑri Bɑbidɔnni kó kukó nnùù ndi,","poem":1},{"lineBreak":true},{"text":"ti do dɛ nkɑri kɛ́dentɛní Siyɔ̃ɔ̃ ɛì kpɛ́í kɛ́nkuɔ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ti do nùńnɛ́ núnnɛ́ ti kó tikùtìdùùtì kukó nkó titieti nti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ ti pĩ̀ḿmúní bɛmbɛ bɛ̀ɛ̀ ti fɛ̃́ũnko bɛ̀ dɛ nti békú kɛ tú","poem":1},{"lineBreak":true},{"text":"ti bɛ̀ dèntɛ̀ diwɛ̀ì kó fɛyɛ̀nfɛ̀,","poem":1},{"lineBreak":true},{"text":"Siyɔ̃ɔ̃ ɛì kó fɛyɛ̀nfɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ti nɛ́ bo yĩ́mɛ kɛ́dentɛ̀ ti Yiɛ̀ nKuyie nkó fɛyɛ̀nfɛ̀ bɛtɔbɛ̀ ciɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Sedisɑdɛmmu kɛ̀ n dɑ yɛ̃̀,","poem":1},{"lineBreak":true},{"text":"n nɔ̀ùtɛ̀ youtɛɛ fɑ̃ũ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N nɔ́ndɛnfɛ̀ɛ dɑri, kɛ̀ nsɑ̀ kɛ̀ n dɑ yɛ̃̀.","poem":1},{"lineBreak":true},{"text":"Fɛ̀ɛ dɑri kɛ̀ nsɑ̀ kɛ̀ dɛ̀ í n nɑɑtinɛ̀ fɔ̃́ nSedisɑdɛmmu kɛ pɛ̃ɛ̃tɛ́ dɛsɔnnɛ dɛmɔu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N Yiɛ̀ nKuyie nhɑ bɑ́ɑ́ yɛ̃̀ nhEdɔmmu ɛì kɔbɛ do dɔ̀ɔ̀ dɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ pɔ̀ntɛ dìì yiè Sedisɑdɛmmu bɛ̀ do pĩɛ̃kù kɛ tú:","poem":1},{"lineBreak":true},{"text":"Pɔntɛnɛ̀ we kɛ́dɛ́ítɛ́ pɑ́íí nɛ̀ dipũũo.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ yóó pɔntɛ Bɑbidɔnni ɛì kɔbɛ, kunɑɑtí mbɛ̀ bonɛ̀.","poem":1},{"lineBreak":true},{"text":"Bɛɛ̀ yóó di fɔ́ɔ́ mmɛyɛi ndì ti dɔ̀ɔ̀ mɛ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dɛ̀ nnɑɑti bɛ̀ɛ̀ bo pĩ́mmú Bɑbidɔnni ɛì kó ibíbɛ́nní","poem":1},{"lineBreak":true},{"text":"kɛ ì fɑ̃̀ṹtɛ́ fɑ̃́ṹtɛ́ dipèrì ĩ́nkɛ̀!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/137.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/138.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/136.json","previousChapterAudioLinks":{},"numberOfVerses":9}