{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":138,"content":[{"type":"heading","content":["Disɑ̃nni kó fɛyɛ̀nfɛ̀"]},{"type":"verse","number":1,"content":["Bɛ̀ dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie n dɑ dɛ́úkùnkomu nɛ̀ n yɛ̀mmɛ̀ mɛmɔu,","poem":1},{"lineBreak":true},{"text":"n yó ndièmmu kɛ dɑ sɑ̃ntí ɑ tɔ̃rɛ̀ ììkɛ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N nínkúmu ɑ cɛ̃sɑ̀ɑ̀tɛ̀ kɛ dɛ́úkùnko ɑ yètìrì,","poem":1},{"lineBreak":true},{"text":"ɑ sɑ̀ mɛ̀ɛ̀ kpɛ́í nɛ̀ ɑ túmɛ̀ timɔ́mmɔnti yiɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ ɑ ti dɔúnnɛ̀ dìì nùù pɛ̃ɛ̃tɛ́mɛ̀ ti yɛ̀mmɛ̀ do dò nhɑ́ bo ti dɔɔ̀mɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N dɑ yu dìì yiè kɑ̀ɑ yiemmu,","poem":1},{"lineBreak":true},{"text":"kɛ yɑ́úkùnnɛ n kɔ̃̀ntì kɛ n kpénkùnnɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N Yiɛ̀ nKuyie, yɛbotɛ̀ yɛmɔu kó bɛkpɑ̀ɑ̀tìbɛ̀ yó ndɛ́úkùnko fɔ̃́ nwe,","poem":1},{"lineBreak":true},{"text":"bɛ̀ bo keè dìì mɔ̀nnì ɑ nùù.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɛ̀ yó ndièmmu ti Yiɛ̀ nKuyie mpĩ́ mùù tɔ̃mmú,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ ti Yiɛ̀ nKuyie nkpetì dɛumɛ̀mu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie mborɛ̀ í tɔ́kɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kù wùónní bɛsĩ́ntíbɛ̀,","poem":1},{"lineBreak":true},{"text":"kù wùómmu sipɔɔ yɛmbɛ̀ bɑ́ kɛ̀ bɛ̀ borɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bɑ́ kɛ̀ m bo mbo mɛyɛǹcɑɑ̀rìmɛ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ yó nkɑ̃nkɛ́ n fòmmu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n dootitɔbɛ̀ miɛkɛ n yɛ̀nní,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ yóó bɛ̀ còńnɛ́ kɛ́ n dɛɛtɛ́ nɛ̀ ɑ wɛ̃rímú.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nyóó pṹɔ̃mmu kù ketɛ́ mùù tɔ̃mmú,","poem":1},{"lineBreak":true},{"text":"n Yiɛ̀ nKuyie nhɑ sɑ̀ɑ̀ mbomu sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"bɑ́ɑ́ kṹnnɛ́ ɑ tɔ̃mmú.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/138.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/139.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/137.json","previousChapterAudioLinks":{},"numberOfVerses":8}