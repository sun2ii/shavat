{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":14,"content":[{"type":"heading","content":["Onitiyɛiwe kó mɛborimɛ"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Tiyɛìntì tiì ɔ̃ɔ̃ yĩ́ Kuyie nyí bo!","poem":1},{"lineBreak":true},{"text":"Bɛ̀ cɑ̀kɛmu, bɛ̀ dɔ̀ɔ̀ri isɔkɛ kpɛrɛ ndɛ,","poem":1},{"lineBreak":true},{"text":"òmɔù í bo bɛ miɛkɛ wèè dɔ̀ɔ̀ri mɛsɑ̀ɑ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie mboní kɛĩ́nkɛ̀ nkɛ kɛ wúó mbɛnìtìbɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ bo yɑ̀ wèè mɔ̀kɛ mɛyɛ̀mmɛ̀ kɛ kù wɑɑ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɛmɔu bɛ̀ fetimu kɛ cɑ̀kɛ,","poem":1},{"lineBreak":true},{"text":"òmɔù í bo wèè dɔ̀ɔ̀ri mɛsɑ̀ɑ̀ mbɑ́ omɑ́ɑ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kuyie mbɛ́imu kɛ tú: Dɛ kó bɛnìtìbɛ̀ sɑ̀ɑ̀ í yɛ̃́ dɛ̀mɑrɑ̀ɑ̀?","poem":1},{"lineBreak":true},{"text":"Kɛ soú n nìtìbɛ̀ kɛ bɛ̀ yo mbɑ́ bɛ̀ í dɑkɛ n kpɛtɑɑ̀?","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kufɔ̃wɑɑ́ n yóó bɛ̀ ɑutɛ́mu kɛ̀ bɛ̀ nkpeutí,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ Kuyie nkommumɛ̀ bɛsɑ̀ɑ̀bɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Di pɑɑnkonɛ̀ bɛcĩ̀rìbɛ̀ mbɛ bɛ kpɛrɛ kɛ̀ ifɛi yóó di pĩ́,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ ti Yiɛ̀ nKuyie nkuù tumɛ̀ bɛ kó disɔ̀rì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɛdɛɛtímɛ̀ɛ yɛ̀nní Siyɔ̃ɔ̃ kɛ́dɛɛtɛ́ Isidɑyɛɛribɛ!","poem":1},{"lineBreak":true},{"text":"Kuyie mbo wɛ̃tɛ kɛ́tɛ̃́nnɛ́ní dìì mɔ̀nnì ku nìtìbɛ̀,","poem":1},{"lineBreak":true},{"text":"dɛ̀ bo nɑrikɛ Sɑkɔbu kɔbɛ,","poem":1},{"lineBreak":true},{"text":"Isidɑyɛɛribɛ bo nyɑ̃nku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/14.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/15.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/13.json","previousChapterAudioLinks":{},"numberOfVerses":7}