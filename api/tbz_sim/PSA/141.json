{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":141,"content":[{"type":"heading","content":["N Yiɛ̀ nKuyie m píe mbɛyɛibɛ"]},{"type":"verse","number":1,"content":["Dɑfiti kó fɛyɛ̀nfɛ̀.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie n dɑ yumu, cɑ̃rikɛní kɛ́ n teennɛ̀,","poem":1},{"lineBreak":true},{"text":"kéntɛ́ kɛ́keè n dɑ kuɔ̀nnɛ̀mɛ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Yóu kɛ̀ m bɑ́ɑmmuu tuɔkoo ɑ borɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ndò ntihúúntì fɔ̃ɔ̃ti,","poem":1},{"lineBreak":true},{"text":"cɔutɛ́ m bɑ́ɑmmìi kɛ̀ ì ndò nkuyuoku kó dipɑ̃nnì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"N Yiɛ̀ nKuyie nhɑ́ ndò n nùù kóo bɑ̀rì,","poem":1},{"lineBreak":true},{"text":"mbɑɑ n nùù dibòrì kɔ̃mɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɑ́ɑ́ yóu kɛ̀ n duɔ́ n yɛ̀mmɛ̀ dɛyɛirɛ,","poem":1},{"lineBreak":true},{"text":"bɑ́ɑ́ yóu kɛ̀ n tũnnɛ bɛnitiyonkubɛ kó mɛdɔɔ̀rìmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́dɔɔ̀ mɛyɛi, bɑ́ɑ́ yóu kɛ̀ n di bɛ kó tibɑndiitì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wèè wetí kòò bo m potɛ́ ò n dɔ́mu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Kuyie nkóo nìtì n tiè ndɛ̀ dò nhò yɔ́ɔ̀rì tùdɑ̀ɑ̀rí nwe n yuu,","poem":1},{"lineBreak":true},{"text":"m bɑ́ɑ́ ò yetɛnɛ̀ n yuu,","poem":1},{"lineBreak":true},{"text":"m bɑ́ɑ́ yóu m bo m bɑ́ɑ́mmɛ̀ Kuyie nkɛ tú kùu cónnɛ́ bɛyɛibɛ yɛi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Bɛ̀ bo ntemmùní dìì mɔ̀nnì bɛ kó bɛbɑɑtíbɛ̀ yɛtɑ̃́rɛ̀ ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ bo bɑntɛ́ ɑ nɑ́ɑǹtì do nɑɑtimɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛ̀ ɔ̃ nduɔ̀ kɛtenkɛ̀ kɛ̀ kɛ̀ yɑúmɛ̀,","poem":1},{"lineBreak":true},{"text":"kudɔnkù yóó mɛ nhɑɑtɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ kṹɔ̃̀ yɛ̀ɛ̀ yɑɑ́ yɑɑ́ kɛ̀ yɛ̀ɛ tɑɑ́ kudɔnkù.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N Yiɛ̀ nKuyie m búɔ́ fɔ̃́ nwe,","poem":1},{"lineBreak":true},{"text":"n sɔri fɔ̃́ɔ̃̀ borɛ̀ ɑ bɑ́ɑ́ yóu kɛ̀ n kú.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A nni nkɑ̃nkɛ́ bɛ̀ n dii tìì cùɔ̀tì,","poem":1},{"lineBreak":true},{"text":"n dɛ́tinnɛ mɛyɛi ndɔɔ̀rìbɛ̀ kó yɛdíìntɑ̃́rɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Yóu kɛ̀ bɛyɛibɛɛ duó bɛ̀ dii tìì cùɔ̀tì miɛkɛ","poem":1},{"lineBreak":true},{"text":"kɛ̀ mí n yentɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/141.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/142.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/140.json","previousChapterAudioLinks":{},"numberOfVerses":10}