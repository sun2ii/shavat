{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":142,"content":[{"type":"heading","content":["Wèè kuɔ̀nnɛ̀ mɛsémmɛ̀ kɛ yu Kuyie"]},{"type":"verse","number":1,"content":["Dɑfiti dèntɛ̀ fɛ̀ɛ̀ yɛ̀nfɛ̀ ò bo dìì mɔ̀nnì kutɑ̃dènkù miɛkɛ."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N kuɔ̀mmu kɛ yu n Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"n kù kuɔ̀nnɛ̀mu kɛ kù sɛ̀ɛ́tí.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N kù sɑ̀útínɛ̀mu","poem":1},{"lineBreak":true},{"text":"kɛ kù nɑ̀ɑ́ n yɛǹcɑɑ̀rìmɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N wɛ̃rímú ɔ̃ nkɛ̀ mù dèè, fɔ̃́ɔ̃̀ ɔ̃ n yɛ̃́ kucɛ n yóó tũnnɛ kù,","poem":1},{"lineBreak":true},{"text":"bɛ̀ n dii ticùɔ̀tì nti kucɛ n kérí kùù miɛkɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wéntɛ́ m bɑkù yoú bíɛ́kɛ̀ kɛ́yɑ̀,","poem":1},{"lineBreak":true},{"text":"òmɔù í dɑkɛ n kpɛ́í,","poem":1},{"lineBreak":true},{"text":"n tɛ̃́nkɛ í mɔkɛ m bo sɔri dɛ̀,","poem":1},{"lineBreak":true},{"text":"òmɔù í bɔti n fòmmu kpɛti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N Yiɛ̀ nKuyie n kuɔ̀nnɛ̀ fɔ̃́ nwe,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n tú fɔ̃́ɔ̃̀ tu n kó disɔ̀rì,","poem":1},{"lineBreak":true},{"text":"n kpɛrɛ dɛmɔu tú fɔ̃́ nwe kɛtenkɛ̀ kiɛ̀ nyĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kéntɛ́ kɛ́keè n dɑbònnì,","poem":1},{"lineBreak":true},{"text":"n di mɛsémmɛ̀ mmɛ, n dɛɛtɛ́nɛ̀ bɛ̀ɛ̀ n fɛ̃́ũnko,","poem":1},{"lineBreak":true},{"text":"bɛ̀ kpénnìmu kɛ m pɛ̃ɛ̃tɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Á n dennɛ dikpetíntou miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ nní ndɛ́úkùnko ɑ yètìrì,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ wetí bɛ̀ yó nh ɔnnɛ́mu,","poem":1},{"lineBreak":true},{"text":"bɛ̀ bo yɑ̀ dìì mɔ̀nnì mɛsɑ̀ɑ̀ nhɑ n dɔ̀ɔ̀ mɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/142.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/143.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/141.json","previousChapterAudioLinks":{},"numberOfVerses":8}