{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":143,"content":[{"type":"heading","content":["Osénnìwè kuɔ̀nnɛ̀mɛ̀ Kuyie"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nkéntɛ́ m bɑ́ɑmmìi,","poem":1},{"lineBreak":true},{"text":"ɑ tú timɔ́mmɔnti yiɛ̀ nwe,","poem":1},{"lineBreak":true},{"text":"kɛ dɔɔri ɑ bɛ́i ntì,","poem":1},{"lineBreak":true},{"text":"kéntɛ́ kɛ́keè n sɑ́útìi,","poem":1},{"lineBreak":true},{"text":"cɔutɛ́ m bɑ́ɑmmìi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Bɑ́ɑ́ bekɛ́nɛ̀ mí nhɑ́ kóo tɔ̃ntì,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ òmɔù í bomɛ̀ wèè bo yĩ́ ò í mɔkɛ mɛyetímɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"N dootitɔù weè m bɛ̀ti,","poem":1},{"lineBreak":true},{"text":"ò m bɔmmu kɛ nɑù,","poem":1},{"lineBreak":true},{"text":"ò n tɑnnɛ́ dibiìnnì miɛkɛ nkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n sɑ̃̀ɑ̃́tɛ́nɛ̀ bɛ̀ɛ̀ duɔ́ kudɔnkù nɛ̀ dimɔ̀nnì.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dɛ̀ m bimu n tɛ̃́nkɛ í nɔ nkɛ nɑmpú.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N kpɑɑ́ kɛ yɛ̃́mu yɛwe yɛ̀ɛ̀ pɛ̃ɛ̃tɛ́ yɛ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"n kpɑɑ́ siɛmmumu mutɔ̃mmú ɑ do dɔɔri mù ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ totí n yɛ̀mmɛ̀ ɑ dɔ̀ɔ̀ dɛ̀ ĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N yuo n nɔu nsi kɛ dɑ bɑ́ɑ́,","poem":1},{"lineBreak":true},{"text":"n dònnɛ̀ kɛtenkɛ̀ kɛ̀ɛ dóntɛ́ kɛ̀nkɛ mɛniɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N Yiɛ̀ nKuyie ncɑ̃rikɛ kɛ́cɔutɛ́ m bɑ́ɑmmìi,","poem":1},{"lineBreak":true},{"text":"dɛ̀ m bimu ɑ bɑ́ɑ́ m bútínnɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ mɛɛ̀ dɔkɛ m bo nɑɑ́nnɛ̀ bɛ̀ɛ̀ duɔ́ kudɔnkù.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɑ́ dìì kṹnweńnì ɑ n nɑ́kɛ́ ɑ kó mɛsɑ̀ɑ̀,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ n yĩkúmɛ̀ fɔ̃́ɔ̃̀ ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"m bɛnkɛ kucɛ n do nkɛ́tũnnɛ kù,","poem":1},{"lineBreak":true},{"text":"n duɔ́ nfɔ̃́ nwe mmɑ́ɑ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nhɑ́ n dɛɛtɛ́nɛ̀ n dootitɔbɛ̀,","poem":1},{"lineBreak":true},{"text":"n sɔri fɔ̃́ɔ̃̀ borɛ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"M bɛnkɛ kɛ̀ n nɑ kɛ́ndɔɔri ɑ dɔ́ dɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́yɛ̃́ fɔ̃́ nKuyie nfɔ̃́ɔ̃̀ n temɛ̀,","poem":1},{"lineBreak":true},{"text":"ɑ kó Muyɑɑ́nsɑ̀ɑ̀mù n niitɛ́ kucɛ kùù ɛ̀ri.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie, dɛ́úkùnnɛ ɑ yètìrì, n fòùkùnnɛ,","poem":1},{"lineBreak":true},{"text":"ɑ tú timɔ́mmɔnti yiɛ̀ nwe,","poem":1},{"lineBreak":true},{"text":"n dennɛ mɛyɛǹcɑɑ̀rìmɛ̀ miɛkɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A n dɔ́ mɛ̀ɛ̀ kpɛ́í, ɑ́ kuɔ n dootitɔbɛ̀,","poem":1},{"lineBreak":true},{"text":"ɑ bɑ́ɑ́ súɔ́ n dùɔ̀ntɔbɛ̀ kóò mɔù,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ n túmɛ̀ ɑ kóo tɔ̃ntì nwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/143.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/144.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/142.json","previousChapterAudioLinks":{},"numberOfVerses":12}