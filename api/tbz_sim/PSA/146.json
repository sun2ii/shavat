{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":146,"content":[{"type":"heading","content":["Kuyie nkɑ̃nkɛ́mɛ̀ bɛcĩ̀rìbɛ̀"]},{"type":"verse","number":1,"content":[{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie!","poem":1},{"lineBreak":true},{"text":"N yó nsɑ̃ntímu n Yiɛ̀ nKuyie.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N yó nsɑ̃ntímu n Yiɛ̀ nKuyie n fòmmu mumɔu,","poem":1},{"lineBreak":true},{"text":"n fòmmu mumɔu n yó ndièmmu kɛ kù sɑ̃ntí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Di bɑ́ɑ́ duɔ́ ndimɑ́ɑ̀ kutenkù kó bɛkpɑ̀ɑ̀tìbɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛnìtìbɛ̀ mbɛ bɛ̀ bɑ́ɑ́ nɑ kɛ́ di dɛɛtɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kòò nìtì wemmu kũ̀ńtɛ́, ò tɑ kɛtenkɛ̀ nkɛ,","poem":1},{"lineBreak":true},{"text":"kòò do wúó ntìi deè dɛ yiè.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Dɛ̀ nnɑɑti onìtì wèè ĩkú Kuyie nSɑkɔbu do tũ nkù ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"wèè kèḿmú ti Yiɛ̀ nKuyie nhò tũ̀ nkù.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuù dɔ̀ɔ̀ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀,","poem":1},{"lineBreak":true},{"text":"dɑ̀mɛ́ɛ̀rì nɛ̀ dɛ̀ɛ̀ kó dimɑ̀ɑ̀ bo o miɛkɛ","poem":1},{"lineBreak":true},{"text":"kuù pĩ ntimɔ́mmɔnti sɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuù ɔ̃ɔ̃ kónnɛ́ ocĩ̀rì ò nɑɑti dìì mɔ̀nnì,","poem":1},{"lineBreak":true},{"text":"kuù duɔ̀ mmudiì dikònnì bo bɛ̀,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nkuù ɔ̃ɔ̃ pítɛ́ tidɑɑtì iwɛ̃ĩ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuu ɔ̃ɔ̃ wéí nwèè tu kuyũ̀ɔ̃̀nkù,","poem":1},{"lineBreak":true},{"text":"kuù ɔ̃ɔ̃ teennɛ̀ bɛcĩ̀rìbɛ̀,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ ndɔ́mu bɛ̀ɛ̀ tũ̀ ntimɔ́mmɔnti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù ɔ̃ɔ̃ nkɑ̃nkɛ́ bɛpɔ̀ɔ̀bɛ̀,","poem":1},{"lineBreak":true},{"text":"kuù kommu iciribí nɛ̀ bɛkúpobɛ̀,","poem":1},{"lineBreak":true},{"text":"kuù ɔ̃ɔ̃ duɔ́ nkɛ̀ bɛnitiyonkubɛ dɔ́ kɛ́dɔɔ̀ tìi yetɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Ti Yiɛ̀ nKuyie mbɑkɛ́mu sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"Siyɔ̃ɔ̃ ɛì kɔbɛ Kuyie ndi tũ nkù yó mbɑkɛ́mu sɑ̃́ɑ̃̀.","poem":1},{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/146.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/147.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/145.json","previousChapterAudioLinks":{},"numberOfVerses":10}