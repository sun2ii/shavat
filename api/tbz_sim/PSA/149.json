{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":149,"content":[{"type":"heading","content":["Kuyie nkɔbɛ kó diwɛ̀ì"]},{"type":"verse","number":1,"content":[{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie!","poem":1},{"lineBreak":true},{"text":"Dentɛ̀nɛ̀ fɛyɛmpɑ̀nfɛ̀ di Yiɛ̀ nKuyie nkpɛ́í,","poem":1},{"lineBreak":true},{"text":"díndi bɛ̀ɛ̀ dɔ̀ɔ̀ri Kuyie ndɔ́mɛ̀ kɛ̀ di tìí, nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Isidɑyɛɛribɛ diwɛ̀ì ndi bonɛ̀ wèè di dɔ̀ɔ̀,","poem":1},{"lineBreak":true},{"text":"Siyɔ̃ɔ̃ ɛì kɔbɛ, nyɑ̃nkunɛ̀ di kóo kpɑ̀ɑ̀tì kpɛ́í.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nhɑunɛ̀ kɛ sɑ̃ntí ti Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"ndiènnɛ̀ kɛ kù sɑ̃ntí kɛ biennɛ̀ yɛbɑ̀rɛ̀ nɛ̀ tibómbonti,","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"kɛ yɛ̃́ ti Yiɛ̀ nKuyie mpiɛtimɛ̀ ku kó diwɛ̀ì ku kɔbɛ cuokɛ̀ nkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛsĩ́ntíbɛ̀ kó tisɑ̃tì tu mɛdɛɛtímɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Díndi bɛ̀ɛ̀ dɔ̀ɔ̀ri Kuyie ndɔ́mɛ̀ nyɑ̃nkunɛ̀ diwɛ̀ì,","poem":1},{"lineBreak":true},{"text":"kɛ dɛ́úkùnko ku yètìrì, kɛ́nyíútí nɛ̀ di dúɔ̀ ĩ́nkòo.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie nsɑ̃nni mbo di nɔ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ di nɔu mpikú kuseú mɛnɑtimɛ̀ mɛ̀dɛ́mɛ̀ kɔku.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dí pɛitɛ yɛbotɛ̀ yɛ̀ di dɔ̀ɔ̀ dɛ̀,","poem":1},{"lineBreak":true},{"text":"dí ɑ̃nnɛ́ ibotí tiyɛ̃ĩti kɛ́fɔ́ɔ́,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kɛ́pĩ́mmú yɛ kó bɛkpɑ̀ɑ̀tìbɛ̀ kɛ́ bɛ̀ boú mɛfĩmmɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́tɑ́ú mbɛ kpɑ̀ɑ̀tìtũ̀mbɛ̀ timɑ́tì.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dí bɛ̀ bekɛ́nɛ̀ tì wɑ̃̀ri kɛ yɛ̃mmɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ dɔ̀ɔ̀ri Kuyie ndɔ́mɛ̀ bɛ kó disɑ̃nni ndi mɛmmɛ.","poem":1},{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie!","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/149.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/150.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/148.json","previousChapterAudioLinks":{},"numberOfVerses":9}