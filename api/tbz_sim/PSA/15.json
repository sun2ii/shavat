{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":15,"content":[{"type":"heading","content":["Kuyie ndɔ́ ku kɔbɛ ndommɛ̀"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nhɑ yóó cɔutɛ́ we ɑ cĩ́ɛ̃̀tɛ̀ miɛkɛ?","poem":1},{"lineBreak":true},{"text":"We n yó mbo ɑ tɑ̃sɑ̀ɑ̀rì ĩ́nkɛ̀?","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Wèè borimɛ wenni wènwe kòò tũ̀ ntimɔ́mmɔnti,","poem":1},{"lineBreak":true},{"text":"kɛ nɑ́ɑ́ mmɔ́mmuɔ ntìì boní o yɛ̀mmɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Wèè í wɑ́tìrì bɛtɔbɛ̀, wèè í cɑɑ̀ri o kou,","poem":1},{"lineBreak":true},{"text":"wèè í sɑ̃́ɑ̃́ nho cɛ̃pɛɛtitɔù.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wèè yetírí Kuyie nyetɛ bɛ̀, kɛ cɔú bɛ̀ɛ̀ kù dé,","poem":1},{"lineBreak":true},{"text":"kòò bɛ́i ndìì nùù bɑ́ kɛ̀ dì ò yóù wèe dì dɔ̀ɔ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Wèè í penni o díítí kɛ dɔ́ mucɔ̃́ntimu,","poem":1},{"lineBreak":true},{"text":"wèè ɔ̃ɔ̃ í ncɔutɛ́ ticuuti kɛ́cɑɑ̀rɛ̀ wèè nɑɑti.","poem":1},{"lineBreak":true},{"text":"Wèè dɔ̀ɔ̀ri mɛmmɛ dɛ̀mɑrɛ̀ bɑ́ɑ́ ò nɑmpɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/15.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/16.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/14.json","previousChapterAudioLinks":{},"numberOfVerses":5}