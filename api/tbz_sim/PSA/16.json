{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":16,"content":[{"type":"heading","content":["Kuyie ndɛɛtɛ́ wè kó diwɛ̀ì"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Áú Kuyie! Nni nkɑ̃nkɛ́,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ tu n kó disɔ̀rì.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nfɔ̃́ɔ̃̀ m bɑkɛ́,","poem":1},{"lineBreak":true},{"text":"m pɛ́ú fɔ̃́ɔ̃̀ mɑ́ɑ̀ borɛ̀ diwɛ̀ì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bɛsɑ̀ɑ̀bɛ̀ bɛ̀ɛ̀ bo dihɛì miɛkɛ","poem":1},{"lineBreak":true},{"text":"bɛɛ̀ tu bɛnitimɔ́mmɔmbɛ n dé bɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ kɔ̀rì yɛbɔkɛ̀ borɛ̀,","poem":1},{"lineBreak":true},{"text":"m bɑ́ɑ́ kɔtɛ bɛ̀ feu dɛ̀ bɛ kó iwũɔ̃,","poem":1},{"lineBreak":true},{"text":"m bɑ́ɑ́ fíé bɛ kó iwũɔ̃,","poem":1},{"lineBreak":true},{"text":"n ketɛ́ kɛ bɑ́ɑ́ ɑɑtɛ kɛ́yú bɛ bɔkɛ̀ kó yɛyètɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N Yiɛ̀ nKuyie nfɔ̃́ɔ̃̀ tu n kpɛrɛ dɛmɔu,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ n duɔ̀ n dɔ́ dɛ̀,","poem":1},{"lineBreak":true},{"text":"n kpɛti timɔu bo ɑ nɔu miɛkɛ nkɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A n duɔ́ ndɛ̀ n nɑɑtimu,","poem":1},{"lineBreak":true},{"text":"dɛ̀ tu dɛsɑ̀ɑ̀rɛ̀ ndɛ n kpɛ́í","poem":1},{"lineBreak":true},{"text":"kɛ n duɔ̀ ndiwɛ̀ì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N sɑ̃ntímu Kuyie nkùù n tiè,","poem":1},{"lineBreak":true},{"text":"bɑ́ kɛyènkɛ̀ n yɛ̀mmɛ̀ ɔ̃ n dentɛmmu dɛ kó itié.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"M buɔ́ n Yiɛ̀ nKuyie nku sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"kù m bonɛ̀mu, m bɑ́ɑ́ kpeutɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Dɛɛ̀ te kɛ̀ n yɛ̀mmɛ̀ nɑɑti,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n dìènnɛ̀ diwɛ̀ì.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɛ yɛ̃́ kɛ dò mbɑ́ kɛ̀ n ku,","poem":1},{"lineBreak":true},{"text":"m bɑ́ nkpɑɑ́ kufɔ̃ti miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ ɑ í yóó yóumɛ̀ ɑ kou kòo pɑ̃ɑ̃kɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A m bɛnkɛmu mufòmmu kó kucɛ,","poem":1},{"lineBreak":true},{"text":"kɛ yo nni mbonɛ̀ kɛ n duɔ̀ ndiwɛ̀ì.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/15.json","previousChapterAudioLinks":{},"numberOfVerses":11}