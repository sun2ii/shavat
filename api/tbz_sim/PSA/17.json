{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":17,"content":[{"type":"heading","content":["Wèè í cɑ̀ɑ̀rɛ̀ mùmɑmù ò mɔɔmɛ̀ Kuyie mmɛteèmmɛ̀"]},{"type":"verse","number":1,"content":["Dɑfiti kó ibɑ́ɑmmìi.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie, keè n dɑ mɔ́ú tì, kɛ́ n kónnɛ́,","poem":1},{"lineBreak":true},{"text":"keè n dɑbònnì kɛ́keè m bɑ́ɑmmìi,","poem":1},{"lineBreak":true},{"text":"siyɑ́ɑ̀bìsí í bo m miɛkɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ yó m bekɛ́nɛ̀,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ yó m pútɛ́ n nɑɑtimu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A yɛ̃́mu n yɛ̀mmɛ̀, ɑ n séúmu kɛyènkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ n fiɛ ɑ í yóó yɑ̀ tìmɑtì,","poem":1},{"lineBreak":true},{"text":"tìì bo n yɛ̀mmɛ̀ tiì yìɛ̀ní n nùù.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A nɑ́ɑǹtì tiì n ni,","poem":1},{"lineBreak":true},{"text":"kɛ n yennínɛ̀ mmɑ́ɑ̀ bɛyɛibɛ kó icɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N tũmmu weti weti ɑ cɛ,","poem":1},{"lineBreak":true},{"text":"n tɑ̀ɑ̀kɛ í kpeutí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuyie n dɑ yumu kɛ́ yɛ̃́ ɑ yó n tɛ̃́nnɛ́mɛ̀,","poem":1},{"lineBreak":true},{"text":"kéntɛ́ m bíɛ́kɛ̀ kɛ́keè n dɑ nɑ́ɑ́ ntì.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛnkɛ ɑ sɑ̀ɑ̀ n diɛmɛ̀ fɔ̃́ nwèè dɛɛrí bɛ̀ɛ̀ wɑnti disɔ̀rì ɑ borɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ bɛ̀ fèkù bɛ dootitɔbɛ̀ nɔu miɛkɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N ni nkɑ̃nkɛ́ kunɔmpòkù ɔ̃ nkɑ̃nkɛ́mɛ̀ tɛnɔnnìtɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛnitiyɛibɛ bɛ̀ɛ̀ n fɛ̃́ũnko bɛ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"ɑ nni ndíɛ́kɛ́ ɑ kó mɛdɛ́ɛ̀.","poem":1},{"lineBreak":true},{"text":"N dootitɔbɛ̀ yonkubɛ bɛ̀ɛ̀ n fitɛ́ bɛ kpɛ́í.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bɛ̀ í mɔkɛ mɛsémmɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ nɑ̀ɑ́nnɛ̀ sipɔɔ nsi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bɛ̀ tũ n nɑɑ̀cɛ̀i nsi,","poem":1},{"lineBreak":true},{"text":"kɛ n fitɛ́ kɛ wɑnti kɛ́ m bɔ nkɛtenkɛ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɛ̀ dònnɛ̀ dicìrícìrì ndi dìì dɔ́ kɛ́pĩ́ nkɛ̀ dɛ̀ dì ɔɔtí,","poem":1},{"lineBreak":true},{"text":"musĩ̀mmù mùù òkɛ difɑ̃pèù kɛ díí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kuyie mbɑ́ɑ́tí kɛ́ bɛ̀ kpɑnnɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ bɛ̀ bɔ nkɛtenkɛ̀,","poem":1},{"lineBreak":true},{"text":"youtɛ ɑ siè kɛ́ n dɛɛtɛ́nɛ̀ bɛnitiyonkubɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"A bɛ̀ kùɔnɛ̀ ɑ kpɑ̀rìsiè, kɛ́ bɛ̀ dèè pɑ́íí,","poem":1},{"lineBreak":true},{"text":"bɛ̀ bɑ́ nkpɑɑ́ bɛfòùbɛ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"nii mbɛ mɛnɛ́tiimɛ ɑ sùɔ́ mmɛ̀ bɛ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ bíí yɑ̃̀ kɛ́nsɑ̀nnɛ̀ kɛ́súɔ́ mbɛ yɑɑ̀bí.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Mí n wetímu kɛ yóó dɑ yɑ̀,","poem":1},{"lineBreak":true},{"text":"m bo entɛ dìì mɔ̀nnì n yóó dɑ yɑ̀mu kɛ́nsɑ̀nnɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/17.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/18.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/16.json","previousChapterAudioLinks":{},"numberOfVerses":14}