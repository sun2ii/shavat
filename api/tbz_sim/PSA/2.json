bɛ̀ nɑ̀ɑ́nnɛ̀ kɛmiɛkɛ.","poem":1},{"lineBreak":true},{"text":"Nɛ̀ kɛmiɛyonkukɛ kɛ bɛ̀ ɑ̃ɑ̃̀ kufɔ̃wɑɑ́ nkɛ tú:","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Míì pĩ n kóo kpɑ̀ɑ̀tì,","poem":1},{"lineBreak":true},{"text":"ditɑ̃sɑ̀ɑ̀rì Siyɔ̃ɔ̃ ĩ́nkɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N yó nnɑ́ɑ́mmu Kuyie nyɛ̃ nkù yóó dɔɔ̀ dɛ̀ kpɛ́í.","poem":1},{"lineBreak":true},{"text":"Kù ǹ nɑ̀kɛ́mu kɛ yĩ:","poem":1},{"lineBreak":true},{"text":"A tú m birɛ ndɛ yíe,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n tú ɑ cicɛ,","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"kɛ tú n kù mɔɔ yɛbotɛ̀ yɛmɔu kɛ̀ kùu yɛ̀ nni nduɔ́ nkɛ̀ n yɛ̀ tiekɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ntenɛ̀ itemmɑ̀nkoo,","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"kɛ́ncɛ̃mmú yɛbotɛ̀ nɛ̀ kumɑ́tìpɑ̀ɑ̀ti,","poem":1},{"lineBreak":true},{"text":"kɛ́ nyɛ̀ pùɔ̀ ntiyɑɑmɑtì kɔ̃mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Díndi bɛkpɑ̀ɑ̀tìbɛ̀, ńciìnɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛtenkɛ̀ kó bɛbeémbɛ̀, ńyiénnɛ̀ itié.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mpĩ́nnɛ̀ Kuyie ntɔ̃mmú kɛ kù dé,","poem":1},{"lineBreak":true},{"text":"nyɛ̃́nɛ̀ kù kpeńnìmɛ̀ kɛ̀ di kɔ̃m̀bùɔ̀tì nkù duò.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɛ̀ di nkù dɛ́úkùnko","poem":1},{"lineBreak":true},{"text":"ku miɛkɛ yɑ̀ɑ̀ bo di pɛikɛ mɛ̀ɛ̀ kpɛ́í","poem":1},{"lineBreak":true},{"text":"kɛ̀ di feti di tũ nkùù cɛ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"ku miɛkɛ í yóó ɔɔtɛ kɛ̀ bo pɛikɛmɛ̀.","poem":1},{"lineBreak":true},{"text":"Dɛ̀ nnɑɑti bɛ̀ɛ̀ sɔ̀ri ku borɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/2.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/3.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/1.js