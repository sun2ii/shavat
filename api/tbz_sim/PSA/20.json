{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":20,"content":[{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kɑ̀ɑ bo mɛyɛǹcɑɑ̀rìmɛ̀ miɛkɛ ti Yiɛ̀ nKuyie ndɑ teennɛ̀,","poem":1},{"lineBreak":true},{"text":"kunku Kuyie nSɑkɔbu do tũ nkù ndɑ kɑ̃nkɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kù mbo ku cĩ́ɛ̃̀tɛ̀ Sedisɑdɛmmu kɛ dɑ teennɛ̀,","poem":1},{"lineBreak":true},{"text":"kù mboní Siyɔ̃ɔ̃ tɑ̃rì kɛ dɑ cúɔ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kù bɑ́ɑ́ yɛ̃̀ nhɑ pɑ̃rɛ̀ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"kùu cɔutɛ́ iwũɔ̃ ɑ kù feu ì kɛ tuɔ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kù dɑ duɔ́ nhɑ yɛ̀mmɛ̀ dɔ́ dɛ̀ dɛmɔu,","poem":1},{"lineBreak":true},{"text":"kɛ́tũnnɛ ɑ dɔ́ kɛ́dɔɔ̀ tì timɔu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛ̀ ti nyíúnɛ̀ diwɛ̀ì kù dɑ teennɛ̀mɛ̀ kɑ̀ɑ nɑ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ti còńnnɛ́ mɛnɑkùmɛ̀ kó mɛcɑnnimɛ̀ nɛ̀ ti Yiɛ̀ nKuyie nkó diyètìrì.","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie ndɔɔ̀ ɑ kù mɔɔ dɛ̀ dɛmɔu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N yɛ̃́mu kɛ dò nti Yiɛ̀ nKuyie ndɛɛrí okpɑ̀ɑ̀tì kù tɑ̃ɑ̃tɛ́ wè,","poem":1},{"lineBreak":true},{"text":"kɛ boní ku cĩ́ɛ̃̀tɛ̀ kɛĩ́nkɛ̀ koò teenní,","poem":1},{"lineBreak":true},{"text":"koò dɛɛrínɛ̀ ku wɛ̃rímú diɛmù.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɛ̀mɑbɛ̀ tɑ̃́ bɛ kpɑ̀rìsɛ̃ĩ́ nsi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛtɔbɛ̀ tɑ̃́ bɛ sɛ̃ĩ́.","poem":1},{"lineBreak":true},{"text":"Tínti mɛ nyu ti Yiɛ̀ nKuyie nyètìrì ndi.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɛ̀ bɛ̀ bótìrì kɛ duò,","poem":1},{"lineBreak":true},{"text":"kɛ̀ tínti biɛ cómmú teii,","poem":1},{"lineBreak":true},{"text":"ti í nɑmpú.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kuyie nteennɛ̀ okpɑ̀ɑ̀tì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ tì dɑ yu ɑ́ keè.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/20.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/21.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/19.json","previousChapterAudioLinks":{},"numberOfVerses":10}