{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":21,"content":[{"type":"verse","number":1,"content":["Bɛ̀ dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ti Yiɛ̀ nKuyie ndɛ̀ nɑɑtimu okpɑ̀ɑ̀tì ɑ mɔkɛ mɛ̀ɛ̀ kpɛ́í mmuwɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"ɑ ò teennɛ̀mu kɛ̀ dɛ kó diwɛ̀ì diɛrì ò bo.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A ò duɔ́mmu o yɛ̀mmɛ̀ dɔ́ dɛ̀,","poem":1},{"lineBreak":true},{"text":"ɑ í ò yetɛnɛ̀ ò dɑ mɔɔ dɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A ɔ̃ɔ̃ ò conɛ̀ mɛsɑ̀ɑ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"kóò òó mmɛsɔɔ nsɑ̀ɑ̀mɛ̀ kó dipìì","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ò dɑ mɔɔ mufòmmu mmu kɑ̀ɑ mù nhò duɔ́,","poem":1},{"lineBreak":true},{"text":"koò yìɛ́ yɛwe kòo fòmmu òkɛ̀ mɛdiɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ ò dɛɛtɛ́ kòo yètìrì dɛukɛ,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ ò dɛ̀úkùnnɛ koò duɔ́ ndisɑ̃nni.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Koò dɔ̀ɔ̀ri mɛsɑ̀ɑ̀ ndiɛmɛ̀ sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"kòo duɔ̀ ndiwɛ̀ì ɑ borɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Okpɑ̀ɑ̀tì duɔ́ nhomɑ́ɑ̀ ndi Kuyie,","poem":1},{"lineBreak":true},{"text":"nɛ̀ Kuyie nkùù bɑkɛ́ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀","poem":1},{"lineBreak":true},{"text":"ku kó mɛsɑ̀ɑ̀ nkpɛ́í nkɛ ò fìíkúmɛ̀ teii.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Okpɑ̀ɑ̀tì, ɑ yóó nintɛmu ɑ dootitɔbɛ̀,","poem":1},{"lineBreak":true},{"text":"ɑ yóó pĩ́mmú bɛ̀ɛ̀ dɑ níí.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A yóó feitɛ́ní dìì yiè kɛ́ bɛ̀ tɑnnɛ́ fɛhɑ̃ɑ̃tofɛ miɛkɛ nkɛ,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie mbo bɛ̀ mɑɑnko nɛ̀ kɛmiɛkɛ kɛ̀ bɛ̀ɛ cɔ́útɛ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"A yóó kuɔmu bɛ kó fɛyɑnfɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ yɑɑ̀bí nɛ̀ bɛ botóo kɛtenkɛ̀ ĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɛ̀ dɔ́ kɛ dɑ́ dɔɔ̀ mɛyɛi mmɛ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ wɛ̃nnɛ́ kɛ bo dɑ cɑkɛmu,","poem":1},{"lineBreak":true},{"text":"bɛ̀ mɛ nyí yóó nɑ.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A yóó duɔ́ nkɛ̀ bɛ̀ɛ bútínnɛ́ kɛ́cokɛ́mu,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ mbɛ̀ tɑ̃ũ ipie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"Ti Yiɛ̀ nKuyie mbɛnkɛ ɑ wɛ̃rímú diɛmù,","poem":1},{"lineBreak":true},{"text":"ti diè nkɛ dɛ́úkùnko fɔ̃́ɔ̃̀ yètìrì ɑ wɛ̃rímú kpɛ́í.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/21.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/22.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/20.json","previousChapterAudioLinks":{},"numberOfVerses":14}