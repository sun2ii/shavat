{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":24,"content":[{"type":"heading","content":["Kuyie ntɑtimɛ̀ ku cĩ́ɛ̃̀tɛ̀"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Kuyie nkuù te kɛtenkɛ̀ nɛ̀ dɛ̀ɛ̀ bo kɛ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kuù te kutenkù nɛ̀ bɛ̀ɛ̀ bo ku miɛkɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kuyie nkuù fìí nkɛtenkɛ̀ dɑ̀mɛ́ɛ̀rì ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"kuù kɛ̀ fìí nyikó nyĩ́nkɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"We mbo nɑ kɛ́dekɛ Kuyie ntɑ̃rì?","poem":1},{"lineBreak":true},{"text":"We mbo nɑ kɛ́tɑ ku cɛ̃sɑ̀ɑ̀tɛ̀ miɛkɛ?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Wèè nɔu wenni kòo yɛ̀mmɛ̀ dò mpɑ́íí,","poem":1},{"lineBreak":true},{"text":"wèè í duɔ́ nho yɛ̀mmɛ̀ yɛbɔkɛ̀,","poem":1},{"lineBreak":true},{"text":"wèè ɔ̃ɔ̃ í mpɑriku kɛ nɛ́ soú.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Weè yóó pɛ́tɛ́ Kuyie nkó mɛsɑ̀ɑ̀,","poem":1},{"lineBreak":true},{"text":"Kuyie nho dɛɛtíwè yóó wè kòńnɛ́mu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ wɑnti Kuyie mbɛ kpɛrɛ yó mmɛ ndò,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ wɑnti Kuyie nSɑkɔbu do tũ nkù.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Di yíɛ́ kɛ́okùnnɛ yɛbòrɛ̀,","poem":1},{"lineBreak":true},{"text":"okùnnɛnɛ̀ yɛbòrɛ̀ yɛ̀ɛ̀ bo nɛ̀ dimɔ̀nnì,","poem":1},{"lineBreak":true},{"text":"kòo kpɑ̀ɑ̀tì diɛwèe tɑ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"We ntu dɛ kóo kpɑ̀ɑ̀tì diɛwè?","poem":1},{"lineBreak":true},{"text":"Kuyie nku, kù kpeńnìmu,","poem":1},{"lineBreak":true},{"text":"kuù tu okɔ̃m̀bɔ̀teu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Yíɛ́ kɛ́okùnnɛ yɛbòrɛ̀,","poem":1},{"lineBreak":true},{"text":"okùnnɛ yɛbòrɛ̀ yɛ̀ɛ̀ do bonɛ̀ dimɔ̀nnì,","poem":1},{"lineBreak":true},{"text":"kòo kpɑ̀ɑ̀tì diɛwèe tɑ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"We ntu dɛ kóo kpɑ̀ɑ̀tì diɛwè?","poem":1},{"lineBreak":true},{"text":"Kuyie Mpɑkɛdɑɑ nwe,","poem":1},{"lineBreak":true},{"text":"kuù tu okpɑ̀ɑ̀tì diɛwè.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/24.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/25.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/23.json","previousChapterAudioLinks":{},"numberOfVerses":10}