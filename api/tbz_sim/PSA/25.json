{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":25,"content":[{"type":"heading","content":["N Yiɛ̀ nKuyie m bɛnkɛ ɑ cɛ kɛ́ n cĩ́ɛ̃́ n yɛi"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie m búɔ́ fɔ̃́ nwe.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie n duɔ́ nfɔ̃́ nwe m mɑ́ɑ̀,","poem":1},{"lineBreak":true},{"text":"A bɑ́ɑ́ yóu kɛ̀ n di ifɛi,","poem":1},{"lineBreak":true},{"text":"n dootitɔbɛ̀ bɑ́ n nɑ kɛ́nyɑ̃nku.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ dɑ duɔ́ mbɛmɑ́ɑ̀ ifɛi í bɛ̀ pĩĩ,","poem":1},{"lineBreak":true},{"text":"ì yóó pĩ́ mbɛ̀ɛ̀ dɑ yetɛ bɛ̀mbɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N Yiɛ̀ nKuyie, m bɛnkɛ ɑ cɛ,","poem":1},{"lineBreak":true},{"text":"n niitɛ́ icɛ ɑ dɔ́ nní ntũ nyì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"M bɛnkɛ timɔ́mmɔnti kó kucɛ kɛ́ n tié,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ tu Kuyie nkɛ n dɛɛrí.","poem":1},{"lineBreak":true},{"text":"N yĩkú fɔ̃́ɔ̃̀ ĩ́nkɛ̀ yɛwe yɛmɔu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nhɑ bɑ́ɑ́ yɛ̃̀, nhɑ ti kuɔ̀mmɛ̀ mɛsémmɛ̀","poem":1},{"lineBreak":true},{"text":"kɛ ti dɔɔri mɛsɑ̀ɑ̀ nsɑ̃́ɑ̃̀.","poem":1},{"lineBreak":true},{"text":"A sémmɛ̀ nɛ̀ ɑ sɑ̀ɑ̀ ndɛ̀ bomu nsɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɑ́ ndenniní n do dɔɔri mɛ̀ɛ̀ yɛi,","poem":1},{"lineBreak":true},{"text":"nɛ̀ n yetɛ́mɛ̀ n kpɑɑ́ bɛ ndìì mɔ̀nnì,","poem":1},{"lineBreak":true},{"text":"ɑ sɑ̀ mɛ̀ɛ̀ kpɛ́í bɑ́ n yɛ̃̀.","poem":1},{"lineBreak":true},{"text":"A niti mɛ̀ɛ̀ kpɛ́í nyɛ̃́ n kpɛ́í.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kuyie nwennimɛ̀ kɛ dɔɔri dɛ̀ɛ̀ wenni,","poem":1},{"lineBreak":true},{"text":"dɛɛ̀ te kɛ̀ kù bɛnkú onitiyɛiwe ò dò nkɛ́tũnnɛ kùù cɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɛ kerinɛ̀ bɛ̀ɛ̀ kɛ̃́kùnko bɛmɑ́ɑ̀ timɔ́mmɔnti miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ bɛ̀ bɛnkú ku kó kucɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kuyie nkó itié nwennimu, kɛ tú imɔ́mmɔnyi,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ kù tɑunnɛ̀ kɛ tũ nku kuɔ́ bɛ kpɛ́í.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nnɛ̀ ɑ kó diyètìrì kpɛ́í,","poem":1},{"lineBreak":true},{"text":"n cĩ́ɛ̃́ n yɛi, mɛ̀ dɛumu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kòo nìtì dé ti Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"kù ɔ̃ɔ̃ ò bɛnkɛmu kucɛ ò dò nkɛ́tɑ̃ɑ̃tɛ́ kù.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Dɛ yiɛ̀ nhɔ̃ɔ̃ di diwɛ̀ì ndi,","poem":1},{"lineBreak":true},{"text":"kòo bíi tiekɛ dihɛì.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kuyie mbɛnkúmu ku kó disɔ̀rì kpɛti bɛ̀ɛ̀ kù dé,","poem":1},{"lineBreak":true},{"text":"kɛ bɛ̀ bɛnkú ku tɑummɛ̀ tié.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"M buɔ́ Kuyie nku sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"kuù yó m pítɛ́ ticùɔ̀tì tìì m pĩ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"Wéntɛ́ní m bíɛ́kɛ̀ kɛ́ n kuɔ́ mmɛsémmɛ̀,","poem":1},{"lineBreak":true},{"text":"n kpɑ n kou nwe kɛ sénní.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Kukɔ̃m̀bɔ̀dorí kuù m bo,","poem":1},{"lineBreak":true},{"text":"n dennɛ kukɔ̃m̀bɔ̀dorí miɛkɛ.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Wéntɛ́ n sémmɛ̀ nɛ̀ n fɛ̃́ṹtímɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ n cĩ́ɛ̃́ n yɛi mmɛmɔu.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Wéntɛ́ n dootitɔbɛ̀ sũmɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ miɛkɛ kɛɛ̀ ǹ cɔ̀ú.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Nni nkɑ̃nkɛ́ kɛ́ n dɛɛtɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ m bɑ́ nsɔri ɑ borɛ̀ kɛ́di ifɛi.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"M búɔ́ fɔ̃́ nwe, fɔ̃́ɔ̃̀ yó n teennɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ nní ndò mpɑ́íí kɛ wenni.","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Áú, Kuyie! Dɛɛtɛ́ Isidɑyɛɛribɛ","poem":1},{"lineBreak":true},{"text":"nɛ̀ bɛ ɑ́ɑ̀rìmɛ̀ mɛmɔu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/25.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/26.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/24.json","previousChapterAudioLinks":{},"numberOfVerses":22}