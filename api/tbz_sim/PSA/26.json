{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":26,"content":[{"type":"heading","content":["Dɑfiti tumɛ̀ Kuyie nhò kòńnɛ́"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie n kónnɛ́,","poem":1},{"lineBreak":true},{"text":"n tũmmu ɑ kuɔ́,","poem":1},{"lineBreak":true},{"text":"n yĩkú fɔ̃́ɔ̃̀ ĩ́nkɛ̀ nɛ̀ n yɛ̀mmɛ̀ mɛmɔu,","poem":1},{"lineBreak":true},{"text":"n yí yóó nɑmpɛ.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie, n wéntɛ́,","poem":1},{"lineBreak":true},{"text":"n yɑ́ɑ́kɛ́, fɛitɛ́ n yɛ̀mmɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"M búɔ́ fɔ̃́ nwe kɛ bɑ̀ɑ ɑ kó mɛsɑ̀ɑ̀,","poem":1},{"lineBreak":true},{"text":"n kérí ɑ kó timɔ́mmɔnti miɛkɛ nkɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yí kɑtìnɛ̀ siyɑ́ɑ̀bìsí yɛmbɛ̀,","poem":1},{"lineBreak":true},{"text":"n yí nɛitinɛ̀ mɛyɛ̀mmɛ̀ mɛ̀dɛ́mɛ̀ yɛmbɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yí dɔ́ bɛ̀ɛ̀ dɔ̀ɔ̀ri mɛyɛi mbɛ kó ditĩ̀nnì,","poem":1},{"lineBreak":true},{"text":"n yí kɑtìnɛ̀ bɛnitiyonkubɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"N Yiɛ̀ nKuyie n yóó nitɛ n nɔu nsi kɛ́bɛnkɛ n wennimɛ̀,","poem":1},{"lineBreak":true},{"text":"n firì ɑ wũɔ̃tɔ̀nnì ndi,","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"kɛ dɑ sɑ̃ntí,","poem":1},{"lineBreak":true},{"text":"kɛ nɑ́ɑ́ nhɑ kó mɛsɑ̀ɑ̀ mmɛmɔu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie, n dɔ́mu kɛ́ mbo ɑ cĩ́ɛ̃̀tɛ̀,","poem":1},{"lineBreak":true},{"text":"ɑ wɛ̃rímú bo tɛ̀ɛ̀ miɛkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Bɑ́ n wɛ̃nnɛ́nɛ̀ bɛyɛibɛ kɛ́kuɔ,","poem":1},{"lineBreak":true},{"text":"bɑ́ n wɛ̃nnɛ́nɛ̀ bɛnitikɔ̀ùbɛ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɛ nɔu tú sisĩ̀nsì nsi,","poem":1},{"lineBreak":true},{"text":"bɛ̀ bɛ̀ duɔ̀ nticuuti nti kɛ dɔ́ bɛ̀ɛ bɛ̀ kòńnɛ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N tũ̀mmu ɑ kuɔ́,","poem":1},{"lineBreak":true},{"text":"n kuɔ́ mmɛsémmɛ̀ kɛ́ n dɛɛtɛ́.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N kérí kucɛ sɑ̀ɑ̀kù nku.","poem":1},{"lineBreak":true},{"text":"M bo nsɑ̃ntí n Yiɛ̀ nKuyie nku nìtìbɛ̀ tìkú dɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/26.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/27.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/25.json","previousChapterAudioLinks":{},"numberOfVerses":12}