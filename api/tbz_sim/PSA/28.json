{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":28,"content":[{"type":"heading","content":["Wèè tɔ̀ɔ́nnɛ̀ mukṹṹ nhò bɑ̀ɑ́mmɛ̀ Kuyie"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie n kuɔ̀nnɛ̀ fɔ̃́ nwe,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ tu dipèrì dìì n kɑ̃nkɛ́,","poem":1},{"lineBreak":true},{"text":"bɑ́ ncĩ́ɛ̃́kɛ́ kɛ̀ n kuɔ̀ nkɑ̀ɑ cĩ̀ɛ̃́kɛ́,","poem":1},{"lineBreak":true},{"text":"n tɑti kudɔnkù nku.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Kéntɛ́ m bɑ́ɑmmìi n dɑ bɑ́ɑ́ nyì.","poem":1},{"lineBreak":true},{"text":"Keè n dɑ yumɛ̀ kɛ tú ɑ n tee.","poem":1},{"lineBreak":true},{"text":"N yuo n nɔu nsi ɑ cɛ̃sɑ̀ɑ̀tɛ̀ bíɛ́kɛ̀ kɛ dɑ bɑ́ɑ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Bɑ́ n wɛ̃nnɛ́nɛ̀ bɛyonkubɛ nɛ̀ bɛ̀ɛ̀ dɔ̀ɔ̀ri mɛyɛi,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ ɔ̃ nnɑ́ɑ́ mbɛ kɔbɛ diwɛ̀ì kó tinɑ́ɑǹtì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ mɛyɛi nnɛ́ píɛ́kɛ́ bɛ miɛkɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dɔɔ̀ bɛ bɛ tɔ̃mmú dòmmɛ̀, bɛ yɛi ndòmmɛ̀,","poem":1},{"lineBreak":true},{"text":"yietí bɛ bɛ yɛi mbɛ̀ dɔ̀ɔ̀ mɛ̀ bɛtɔbɛ̀.","poem":1},{"lineBreak":true},{"text":"Duɔ́ nkɛ̀ bɛ̀ dɔ̀ɔ̀ mɛ̀ɛ̀ yɛi ndo bɛ yɔ ĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie mbɛ̀ í dɑkɛ ɑ teèmmɛ̀ kpɛ́í","poem":1},{"lineBreak":true},{"text":"nɛ̀ ɑ pĩ́ mmùù tɔ̃mmú,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nhɑ bɛ̀ bɔ nkɛ bɑ́ɑ́ bɛ̀ íi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ti Yiɛ̀ nKuyie nyètìrì ndɛu,","poem":1},{"lineBreak":true},{"text":"kù kèèmɛ̀ m bɑ́ɑmmìi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù n kɑ̃nkɛ́,","poem":1},{"lineBreak":true},{"text":"kuù tu n kó kudɔpìkù,","poem":1},{"lineBreak":true},{"text":"n ku n duɔ́ mmɑ́ɑ̀,","poem":1},{"lineBreak":true},{"text":"kuù ǹ teénnɛ̀ kɛ̀ n yɛ̀mmɛ̀ nɑɑti,","poem":1},{"lineBreak":true},{"text":"n yó ndiè kɛ ku nsɑ̃ntí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ti Yiɛ̀ nKuyie nkuù kɑ̃nkɛ́ ku kɔbɛ,","poem":1},{"lineBreak":true},{"text":"kuù tu tɛcɛ̃kpetɛ̀ kɛ dɛɛrí kù tɑ̃ɑ̃tɛ́ wè.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie ndɛɛtɛ́ ɑ kɔbɛ, fɔ̃́ɔ̃̀ bɛ̀ te,","poem":1},{"lineBreak":true},{"text":"dɔɔ̀ bɛ mɛsɑ̀ɑ̀, ɑ ntú bɛ kóo cɛ̃nti, ntɔ bɛ sɑ̃́ɑ̃̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/28.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/29.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/27.json","previousChapterAudioLinks":{},"numberOfVerses":9}