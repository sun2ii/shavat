{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":29,"content":[{"type":"heading","content":["Kuyie mpɛ̀úmɛ̀ ku tɑmmɛ̀"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Díndi kɛĩ́nkɛ̀ kɔbɛ dɛ́úkùnkonɛ̀ Kuyie nyètìrì,","poem":1},{"lineBreak":true},{"text":"sɑ̃ntɛnɛ̀ ku, kù dɛu mɛ̀ɛ̀ kpɛ́í nkɛ mɔkɛ muwɛ̃rímú.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dɛ́úkùnnɛ ti Yiɛ̀ nKuyie nyètìrì,","poem":1},{"lineBreak":true},{"text":"nínkúnɛ̀ ku ììkɛ̀ ku cɛ̃sɑ̀ɑ̀tɛ̀ miɛkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Ti Yiɛ̀ nKuyie nkpeńnìmu, kuù te kɛ̀ fɛtɑɑfɛ̀ pɛ̀ú,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kù pɛ̀ú mɛtɑmmɛ̀ mɛniɛ n yĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"kuù bɑkɛ́ mɛnɛ́diɛmɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù pĩɛ̃kù nɛ̀ muwɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nkuù pɛ̀ú mɛtɑmmɛ̀ kperímɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ti Yiɛ̀ nKuyie nkuù pɛ̀ú kɛ̀ dɛtekperɛ̀ duò.","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù kèkíí Dimɑɑ kó dɛtekperɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuù duɔ́ nkɛ̀ Dimɑɑ kó yɛtɑ̃rɛ̀ yɑ̃̀nku kunɑɑbiiku kɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Edimɔɔ tɑ̃rì yɑ̃̀nku dipɑɑnɑɑbii kɔ̃mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Ti Yiɛ̀ nKuyie nkuù pɛ̀ú kɛ̀ fɛhɑ̃ɑ̃dɛɛ̀nfɛ̀ yiɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuyie nkuù pɛ̀ú mɛtɑmmɛ̀ kɛ̀ dikpɑ́ɑ̀ sɑ̃̀nti,","poem":1},{"lineBreak":true},{"text":"kuù duɔ́ nkɛ̀ Kɑdɛɛsi kpɑ́ɑ̀ sɑ̃̀nti.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuyie nkuù pɛ̀ú mɛtɑmmɛ̀ kɛ̀ dɛtie nsɑ̃nti,","poem":1},{"lineBreak":true},{"text":"kuù pɛ̀ú kɛ̀ tifɑ̃ɑ̃̀tì yòrì dikpɑ́ɑ̀.","poem":1},{"lineBreak":true},{"text":"Ku cĩ́ɛ̃̀tɛ̀ miɛkɛ bɛmɔu kɛ̀ bɛ̀ tu ku yètìrì ńdɛu.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkuù do bɑkɛ́ fɛtɑdiɛfɛ̀ mɔ̀nnì,","poem":1},{"lineBreak":true},{"text":"kuù tu okpɑ̀ɑ̀tì sɑ̃́ɑ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Ti Yiɛ̀ nKuyie nduɔ́ nhɑ kɔbɛ muwɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"pɑ̃ bɛ mɛsɑ̀ɑ̀, kɛ́ bɛ̀ duɔ́ ndiwɛ̀ì.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/29.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/30.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/28.json","previousChapterAudioLinks":{},"numberOfVerses":11}