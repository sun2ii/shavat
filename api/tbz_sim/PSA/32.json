{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":32,"content":[{"type":"heading","content":["Kuyie ncĩ̀ɛ̃́ nwè mɔ̀kɛmɛ̀ diwɛ̀ì"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Dɛ̀ nnɑɑti Kuyie ncĩ̀ɛ̃́ nwè o yetímɛ̀,","poem":1},{"lineBreak":true},{"text":"kù ũtɛ́ wè o yɛi.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Dɛ̀ nnɑɑti ti yiɛ̀ nKuyie ntɛ̃́nkɛ í kɑɑ̀nnɛ̀ wèè kó mɛyɛi,","poem":1},{"lineBreak":true},{"text":"dɛ̀ nnɑɑti wèè yɛ̀mmɛ̀ wenni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"N do í dɑ́ɑ dìì mɔ̀nnì n yɛi nkɛ̀ n wɛ̃rímú mùù dèè,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n níí ntṹṹ nkɛ mítìrì.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛ yɛ̃́ ɑ do m puotìmɛ̀ kuyie nnɛ̀ kɛyènkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n wɛ̃rímú dèè kɛ̀ m mɔ̀tɛ́ mupɑɑkɛ̀ntie kɔ̃mɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"M mɛ ndɑ dɑ́ɑmmu n yɛi,","poem":1},{"lineBreak":true},{"text":"n yí sɔ̀nnɛ n yetímɛ̀,","poem":1},{"lineBreak":true},{"text":"m bɛ́immu kɛ tú n cɑ̀ɑ̀rɛ̀, kɛ dɑ dɑ́ɑ n yɛi,","poem":1},{"lineBreak":true},{"text":"nkɑ̀ɑ mɛ̀ nni nhũtɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Dɛɛ̀ te kɛ̀ bɛsɑ̀ɑ̀bɛ̀ dò nkɛ́ ndɑ bɑ́ɑ́ ndimɔ̀nnì sɑ̀ɑ̀rì.","poem":1},{"lineBreak":true},{"text":"Bɑ́ kɛ̀ mɛyɛi tùɔ̀kɛní fɛtɑɑfɛ̀ diɛfɛ̀ kɔ̃mɛ mɛ̀ bɑ́ɑ́ bɛ̀ nìntɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ tu n kó disɔ̀rì kɛ ɔ̃ nni nkɑ̃nkɛ́ mɛhɑ́ɑ́rìmɛ̀ mɔ̀nnì,","poem":1},{"lineBreak":true},{"text":"M bo ndiè nkɛ dɑ sɑ̃ntí ɑ n kɑ̃nkɛ́ mɛ̀ɛ̀ kpɛ́í.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kɛ̀ Kuyie ndɔ̀:","poem":1},{"lineBreak":true},{"text":"N yóó dɑ tiémmu kɛ dɑ bɛnkɛ kucɛ ɑ dò nkɛ́tũnnɛ kù,","poem":1},{"lineBreak":true},{"text":"m bo ndɑ duɔ̀ nyitié kɛ́ ndɑ wúó nsɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɑ́ɑ́ yɛi ntɛsɑ̃ntɛ̀ nɛ̀ sɑ̃mmɑrímú dɛ kɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ ɑ̃ɑ̃̀ dɛ̀ tisɑ̃nkɛ́ndɑ́ntì nɛ̀ iwɛ̃ĩ kɛ̀ dɛ̀ bo yie mbɛ kpɛti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Oyɛiwe ɔ̃ nfɛ̃́ũrìmu mɛdiɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Kuyie nyɑ́rí wèè kù duɔ́ nhomɑ́ɑ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Díndi bɛsɑ̀ɑ̀bɛ̀ nyɑ̃nkunɛ̀ Kuyie nkó kucɛ miɛkɛ, diwɛ̀ì ndi bo.","poem":1},{"lineBreak":true},{"text":"Díndi bɛ̀ɛ̀ yɛ̀mmɛ̀ wenni mpĩɛ̃kùnɛ̀ diwɛ̀ì.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/32.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/33.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/31.json","previousChapterAudioLinks":{},"numberOfVerses":11}