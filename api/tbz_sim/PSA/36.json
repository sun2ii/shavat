{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":36,"content":[{"type":"heading","content":["Ti Yiɛ̀ nKuyie mborɛ̀ ndɛ mufòmmu bomɛ̀"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ ti Yiɛ̀ nKuyie nkóo tɔ̃ntì Dɑfiti yɛ̀nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Oyɛiwe nɑ́ɑ́ ntì tiì n yóù,","poem":1},{"lineBreak":true},{"text":"ò tu dɛ̀ ò bo ndé bɑ nkpɛ́í Kuyie?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ò tɑ̃́ omɑ́ɑ̀ ndi,","poem":1},{"lineBreak":true},{"text":"ò í dɔ́ kɛ́bɑntɛ́ o yɛi nkɛ́ mɛ̀ yetɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ò mɔ̀kɛ siyɑ́ɑ̀bìsí nsi kɛ soú,","poem":1},{"lineBreak":true},{"text":"ò í dɔ́ kɛ́bɑntɛ́ mɛsɑ̀ɑ̀ ntúmɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kòò duɔ́ wè ntotí o yɛ̀mmɛ̀ mɛyɛi nkpɛti mɑ́ɑ̀,","poem":1},{"lineBreak":true},{"text":"kɛ tũ nkucɛ yɛiku,","poem":1},{"lineBreak":true},{"text":"ò í yóu mɛyɛi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ti Yiɛ̀ nKuyie nhɑ sɑ̀ɑ̀ mmɑ̀nnɛ̀ tiwɛtì nti,","poem":1},{"lineBreak":true},{"text":"ɑ dɔɔrimu ɑ bɛ́i ntì kɛ̀ dɛ̀ feí tiwɛtì kɔ̃mɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A wetí kɛ̀ dɛ̀ dɛumu kɛ mɑ̀nnɛ̀ ɑ tɑ̃rɛ̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ beéntì cũmpúrì difɔ̃̀tìrì kɔ̃mɛ.","poem":1},{"lineBreak":true},{"text":"Kuyie nkuù teénnɛ̀ bɛnìtìbɛ̀ nɛ̀ tikpɑsĩ̀ntì.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuyie nhɑ sɑ̀ɑ̀ nwenni mɛdiɛ̀ mmɛ.","poem":1},{"lineBreak":true},{"text":"Bɛnìtìbɛ̀ dìɛ́kɛ́ ɑ fiɛti dɛ́ɛ̀ mmɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛ̀ yo nhɑ cĩ́ɛ̃̀tɛ̀ sɑ̀ɑ̀ mmɛ̀ kɛ sɑ̀nnɛ̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ bɛ̀ nììnko ɑ sɑ̀ɑ̀ nkó kukó.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ tu mufòmmu kũ̀nnì,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ ti duɔ̀ nkuwenniku.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"A sɑ̀ɑ̀ nní mbonɛ̀ bɛ̀ɛ̀ dɑ yɛ̃́,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ nkómmú bɛ̀ɛ̀ yɛ̀mmɛ̀ wenni.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Bɑ́ɑ́ yie nkɛ̀ tɛpɔ̀tɛ̀ yiɛ̀ nni nnintɛ,","poem":1},{"lineBreak":true},{"text":"bɑ́ɑ́ yóu kòo yɛiwe nni mbɛti.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ dɔ̀ɔ̀ri dɛ̀ɛ̀ í wenni bɛ̀ duòmu,","poem":1},{"lineBreak":true},{"text":"bɛ̀ domu bɛ̀ í yóó nɑ kɛ́ítɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/36.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/37.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/35.json","previousChapterAudioLinks":{},"numberOfVerses":13}