{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":38,"content":[{"type":"heading","content":["Omuɔnti wèè bɑntɛ́ o yɛi nhò bɑ̀ɑ́mmɛ̀ Kuyie"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀ bɛ̀ dìè nfɛ̀ kɛ denniní Kuyie nkpɛ́í."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ti Yiɛ̀ nKuyie nhɑ bɑ́ n fɛ̃́ũnnɛ̀ kɛmiɛkɛ,","poem":1},{"lineBreak":true},{"text":"bɑ́ m puotínɛ̀ kunɑupíɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"A pie nduò n yĩ́nkɛ̀ nkɛ,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ nɑcɛ̀kuutɛ duò n yĩ́nkɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N kɔ̃̀ntì miɛkɛ tɛ̃́nkɛ í pĩ́,","poem":1},{"lineBreak":true},{"text":"ɑ miɛkɛ n cɔ́ú mmɛ̀ɛ̀ kpɛ́í.","poem":1},{"lineBreak":true},{"text":"N kṹɔ̃̀ yɛɛ̀ bɔ̀kɛ́ n yɛi nkpɛ́í.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yɛi mmɛɛ̀ dɛukɛ kɛ m pɛ̃ɛ̃tɛ́,","poem":1},{"lineBreak":true},{"text":"mɛ̀ n yɔ̃̀ntɛmu ditɔu cɛ̃́ɛ̃́rì kɔ̃mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"M muɔ nyɛɛ̀ ɑ̃nnɛ́ imɑǹcírí,","poem":1},{"lineBreak":true},{"text":"yɛ̀ pɑ̃̀ɑ̃̀kɛmu n yɛìntì kpɛ́í.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuyonku kuù ǹ nɑ kɛ m̀ pũ̀tínnɛ́ mɛdiɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n yɛ̀mmɛ̀ cɑ̀ɑ̀ri yɛwe yɛmɔu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N kɔ̃̀ntì tiì cɔ̀ú,","poem":1},{"lineBreak":true},{"text":"dɛ̀mɑrɛ̀ tɛ̃́nkɛ í pĩ́ n kɔ̃̀ntì miɛkɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N yí mɔkɛ muwɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"n kɔ̃̀ntì kèétɛ́ kéétɛ́mu,","poem":1},{"lineBreak":true},{"text":"n yɛ̀mmɛ̀ mɛɛ̀ cɑ̀ɑ̀rɛ̀ kɛ̀ n kuɔ̀ nkɛ mítìrì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kuyie nhɑ yɛ̃́mu n dɔ́ dɛ̀,","poem":1},{"lineBreak":true},{"text":"ɑ wúómmu n dɑbònnì.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N kɔ̃m̀bùɔ̀tì tiì duò,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n wɛ̃rímú dèè,","poem":1},{"lineBreak":true},{"text":"n nuɔ ntɛ̃́nkɛ í wúó.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"N nɛ́pobɛ̀ nɛ̀ n nɛitinɛ̀ bɛ̀ n kɛntɛ́mu,","poem":1},{"lineBreak":true},{"text":"n kɔbɛ n yentɛ́mu nh ɑ́ɑ̀rìmɛ̀ kpɛ́í.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ n dɔ́nɛ̀ mukṹṹ mbɛ̀ n dii timɑ́tì nti,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ n dɔ́nɛ̀ mɛyɛi nkɛ̀ bɛ̀ n sɑ̃́ɑ̃́,","poem":1},{"lineBreak":true},{"text":"bɛ̀ ɔ̃ ntṹṹ nkɛ nɑ́ɑntɛ n kpɛ́í nkɛ.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Mí n nɑɑ́ ndiɔ̃̀nnì ndi, n tɛ̃́nkɛ í yo,","poem":1},{"lineBreak":true},{"text":"n nɑɑ́ nwèè nɔ́ndɛnfɛ̀ dɑ̀ri wènwe n yí nɑ́ɑ́ ntìmɑtì.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"N dò ndiɔ̃̀nnì ndi,","poem":1},{"lineBreak":true},{"text":"n yí tɛ̃́nninko tìmɑtì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":16,"content":[{"text":"N Yiɛ̀ nKuyie m búɔ́ fɔ̃́ nwe,","poem":1},{"lineBreak":true},{"text":"Kuyie nfɔ̃́ɔ̃̀ n te,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ yóó n teennɛ̀.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Bɑ́ɑ́ yóu kɛ̀ bɛ̀ nni nyɑ̃nkunɛ̀,","poem":1},{"lineBreak":true},{"text":"n dɔ́ kɛ́do dìì mɔ̀nnì, bɑ́ɑ́ yóu kɛ̀ bɛ̀ n nɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"N tɔ̀ɔ́nnɛ̀ m bo domɛ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"mɛfɛ̃́ṹtímɛ̀ í iiti m borɛ̀.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"N yiemmu n cɑɑ̀rìmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n yɛi nni nkɔɔ́nnɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":20,"content":[{"text":"N dootitɔbɛ̀ kɔ̃̀ntì nɑɑtimu kɛ̀ bɛ̀ kpeńnì,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ n nìí ndɛtetìrɛ̀ bɛ̀ sũmu.","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"M bɛ̀ dɔ̀ɔ̀ri mɛsɑ̀ɑ̀ mmɛ kɛ̀ bɛ̀ n tɛ̃̀ńnìnko mɛyɛi,","poem":1},{"lineBreak":true},{"text":"kɛ n kpɑnnɛ̀ n dɔɔri mɛ̀ɛ̀ kpɛ́í mmɛsɑ̀ɑ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":22,"content":[{"text":"N Yiɛ̀ nKuyie mbɑ́ n dootóo,","poem":1},{"lineBreak":true},{"text":"bɑ́ n dɛ́tɛ́nɛ̀, Kuyie nfɔ̃́ɔ̃̀ ǹ te.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Kɔtɛní mɛcɑ̃ɑ̃ nkɛ́ n teennɛ̀,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ n Yiɛ̀ nKuyie n kóò dɛɛtíwè.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/38.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/39.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/37.json","previousChapterAudioLinks":{},"numberOfVerses":23}