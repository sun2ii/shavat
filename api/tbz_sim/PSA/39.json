{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":39,"content":[{"type":"heading","content":["Wèè fɛ̃́ũ̀rì ò bɑ̀ɑ́mmɛ̀ Kuyie"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ Yedutunni kpɛ́í."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N yɛ̀mmɛ̀ do dò n yó ndɑkɛmu n dɔɔ̀rìmɛ̀ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"kɛ bɑ́ɑ́ bɛ́i ntìmɑtì kɛ́yetɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ́mmuti tɑ́u oyɛiwe ììkɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Mɛm̀mɛ kɛ̀ nni ndò nyúóó kɛ dò nkɑ́rɛ́ kɛ í mmɔkɛ diwɛ̀ì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n fɛ̃́ṹtímɛ̀ nɛ́ dɔkɛ dɛukɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛ̀ dɛ̀ n cɔ́ú m miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ iyɛntotíi n tùɔ̀ nkɛ dò mmuhɑ̃ɑ̃́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n dentɛnɛ̀ m bo bɛ́immɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N Yiɛ̀ nKuyie n nɑ́kɛ́ n fòmmu mɑmɛ̀,","poem":1},{"lineBreak":true},{"text":"n nɑ́kɛ́ n we kpɑɑ́ yɛ̀dɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ m bɑntɛ́ n yí kpeńnìmɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A n duɔ́ mmùù fòmmu mɑ̀nnɛ̀ tɛnɔ̀ùtɛ̀ pɛ̃kùmɛ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"n we í tùɔ̀kɛ dɛ̀mɑrɛ̀ ɑ ììkɛ̀,","poem":1},{"lineBreak":true},{"text":"ɑ borɛ̀ onìtì dò mmuyɑɑ́ mmu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Onìtì dònnɛ̀ mɛdɛ́ɛ̀ mmɛ kɛ firì,","poem":1},{"lineBreak":true},{"text":"ò ɑ̀rìmu kɛ dò mmuyɑɑ́","poem":1},{"lineBreak":true},{"text":"kɛ wɑɑ̀ ntikpɑ̀tì ò mɛ nyí yɛ̃́ wèè yóó tì tiekɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"N Yiɛ̀ nKuyie, n kémmú we?","poem":1},{"lineBreak":true},{"text":"Fɔ̃́ nwe m búɔ́mɛ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N dɛɛtɛ́nɛ̀ n yɛi,","poem":1},{"lineBreak":true},{"text":"bɑ́ɑ́ yóu kɛ̀ tiyɛìntì nni ndɑú.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"M muti tɑ́u nwe,","poem":1},{"lineBreak":true},{"text":"n yí nɑ́ɑ́ nkɛ́yɛ̃́ dɛ̀ bonímɛ̀ fɔ̃́ɔ̃̀ borɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N yóu tiyɛ̃ĩti,","poem":1},{"lineBreak":true},{"text":"ɑ m puotì kɛ̀ n duòmu.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"A ɔ̃ mpuotì onìtì koò tiè nho yɛi nkpɛ́í nkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ dò nyibiɛ́ kɛ cɑɑ̀ri ò dɔ́ dɛ̀ mɛdiɛ̀.","poem":1},{"lineBreak":true},{"text":"Onìtì dò mmuyɑɑ́ mmu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"N Yiɛ̀ nKuyie nkéntɛ́ m bɑ́ɑmmìi nɛ̀ n sɑ́útìi,","poem":1},{"lineBreak":true},{"text":"m bɑ́ nkuɔ̀ nkɑ̀ɑ cĩ̀ɛ̃́kɛ́,","poem":1},{"lineBreak":true},{"text":"n tú opɔ̀ɔ̀ nwe ɑ borɛ̀ kɛ yóó pɛ̃ɛ̃tɛ́ n yɛmbɛ̀ kɔ̃mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":14,"content":[{"text":"N yóu kɛ̀ nh om̀pɛ̀ kɛ̀ n yɛ̀mmɛ̀ɛ nɑrikɛ","poem":1},{"lineBreak":true},{"text":"kɛ̀ n nɛ́ nɑ kɛ́kpɑɑkɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/39.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/40.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/38.json","previousChapterAudioLinks":{},"numberOfVerses":14}