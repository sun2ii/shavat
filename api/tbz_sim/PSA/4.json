{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":4,"content":[{"type":"heading","content":["Kuyie ndɛɛrímɛ̀ bɛ̀ sɔ̃̀ńtɛ́ kɛ wɑ́tìrì wè"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀ bɛ̀ dìè nfɛ̀ nkɛ biennɛ̀ tibómbonti."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Fɔ̃́ nKuyie nfɔ̃́ɔ̃̀ n kòḿmú,","poem":1},{"lineBreak":true},{"text":"n kuɔ̀nnɛ̀ fɔ̃́ nwe, n teennɛ̀!","poem":1},{"lineBreak":true},{"text":"N yɛ̀mmɛ̀ do cɑ̀ɑ̀rɛ̀ kɛ̀ fɔ̃́ɔ̃̀ n dɛɛtɛ́,","poem":1},{"lineBreak":true},{"text":"n kuɔ́ mmɛsémmɛ̀ kɛ́kéntɛ́ m bɑ́ɑmmìi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Díndi bɛnìtìbɛ̀,","poem":1},{"lineBreak":true},{"text":"dɛ̀ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɛ̀ di yóu di bo ncɑɑ̀rimɛ̀ n yètìrì?","poem":1},{"lineBreak":true},{"text":"Dɛ̀ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɛ̀ di yóu di bo ndɔ́mɛ̀ dɛtetìrɛ̀ kpɛrɛ","poem":1},{"lineBreak":true},{"text":"kɛ wɑnti siyɑ́ɑ̀bìsí?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɑntɛ́nɛ̀ Kuyie nkuù n dɔ̀ɔ̀mɛ̀ mɛsɑ̀ɑ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n kù yu kù n tee.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ̀ di miɛkɛ pɛikɛ di bɑ́ɑ́ dɔɔ̀ mɛyɛi,","poem":1},{"lineBreak":true},{"text":"totínɛ̀ kɛyènkɛ̀ di yɛ̀mmɛ̀ di duɔ́ dɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́bónkùnnɛ di miɛkɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fíénɛ̀ Kuyie nyiwũɔ̃ kù dɔ́ ì,","poem":1},{"lineBreak":true},{"text":"kɛ́ kù duɔ́ ndimɑ́ɑ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bɛsṹkùbɛ̀ nɑ̀ɑ́mmu kɛ tú:","poem":1},{"lineBreak":true},{"text":"We mbo ti duɔ́ ndiwɛ̀ì?","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie ntí míítɛ́ ɑ wenniku.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"A nɛ́ n duɔ́ ndìì wɛ̀ì pɛ̃ɛ̃tɛ́mu tidiitì nɛ̀ mɛnɑɑ̀","poem":1},{"lineBreak":true},{"text":"ndɛ̀ ɔ̃ mpíɛ́kɛ́ kɛ̀ bɛ̀ mɔ̀kɛ dì.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Nh ɔ̃ɔ̃ duɔ́ kɛ́yɛ̃̀ nkɛ́duɔ́ nɛ̀ diwɛ̀ì ndi,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ n Yiɛ̀ Kuyie nfɔ̃́ɔ̃̀ n kɑ̃nkɛ́mɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/4.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/5.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/3.json","previousChapterAudioLinks":{},"numberOfVerses":9}