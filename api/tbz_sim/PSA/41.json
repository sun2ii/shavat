{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":41,"content":[{"type":"heading","content":["Bɛ̀ fɛ̃́ũnko wè bɑ̀ɑ́mmɛ̀ Kuyie"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dɛ̀ nnɑɑti wèè dɑ̀kɛ bɛcĩ̀rìbɛ̀ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"kɛ̀ mɛhɑ́ɑ́rìmɛ̀ ò tùɔ̀kɛní Kuyie nhɔ̃ɔ̃ ò dènnɛmu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nhɔ̃ nhò kɑ̃nkɛ́mu kòo ńfòù,","poem":1},{"lineBreak":true},{"text":"kɛ́di kunɑɑtí kɛtenkɛ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kù ɔ̃ɔ̃ í nyóu kòo dootitɔbɛ̀ɛ ò nɑ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kòò mɔ nkɛ duɔ́ Kuyie nhɔ̃ nhò bɑ̀ɑ̀mu,","poem":1},{"lineBreak":true},{"text":"kɛ yɑ́úkùnko o kɔ̃̀ntì o muɔndɔ́ù ĩ́nkɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Mí nhɔ̃ɔ̃ yĩ́: N Yiɛ̀ nKuyie n kuɔ́ mmɛsémmɛ̀","poem":1},{"lineBreak":true},{"text":"kɛ́ m miɛkùnnɛ n dɑ yetɛ́nɛ̀mu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"N dootitɔbɛ̀ nɑ̀ɑ́mmu n kpɛ́í nkɛ tú:","poem":1},{"lineBreak":true},{"text":"Ò yóó kú ɔ̃̀mmɔ̀nnì?","poem":1},{"lineBreak":true},{"text":"O yètìrì yóó kpɑ́nnɛ́ ɔ̃mmɔ̀nnì?","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛ miɛkɛ kòò mɔù kɔ̀tɛní kɛ n yɑ̀,","poem":1},{"lineBreak":true},{"text":"ò nni nwɑ́tìrì,","poem":1},{"lineBreak":true},{"text":"kɛ́tɔ siyɑ́ɑ̀bìsí kɛ́yɛ̀nnɛ̀ kɛ́pitɛ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"N dootitɔbɛ̀ ɔ̃ɔ̃ tíímmu kɛ́nwɛ́ú n kpɛ́í,","poem":1},{"lineBreak":true},{"text":"bɛ̀ nɑ́ɑntɛ n kó mɛyɛi mmɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛ̀ tu dɛ̀ɛ ǹ tùɔ̀kɛní dɛ̀ í tú dɛsɑ̀ɑ̀rɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ tu n domu kɛ tɛ̃́nkɛ í yóó ítɛ́.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɛ̀ n nɛ́po mɔ́mmuɔ n tɑ̃́ wè,","poem":1},{"lineBreak":true},{"text":"nɛ̀ wè ti wɛ̃ nkɛ yo, weè kòńtɛ́ kɛ n cuùtì.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie n kuɔ́ mmɛsémmɛ̀,","poem":1},{"lineBreak":true},{"text":"n yíi nkɛ̀ m bɛ̀ fɔ̀ɔ́ mbɛ̀ n dɔ̀ɔ̀ dɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"N yóó bɑntɛ́ ɑ n kómmúmɛ̀,","poem":1},{"lineBreak":true},{"text":"n dootitɔbɛ̀ n yĩɛ̃kɛ dìì mɔ̀nnì ndi.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"A yó nni ntɔ n yíé mmɛ̀ɛ̀ kpɛ́í nkɛ ɑ kuɔ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ nni mbo ɑ borɛ̀ sɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nyIsidɑyɛɛribɛ dɔú nkù,","poem":1},{"lineBreak":true},{"text":"ɑ yètìrì ńdɛu kɛ̀ tí ndɑ sɑ̃ntí sɑ̃́ɑ̃̀ fɔ̃́ nnɛ̀ mutɔ̃mmú ɑ pĩ́ mmù,","poem":1},{"lineBreak":true},{"text":"kɛ yó mmù pĩ nsɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ mmɛ ndò. Ami.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/41.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/42.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/40.json","previousChapterAudioLinks":{},"numberOfVerses":14}