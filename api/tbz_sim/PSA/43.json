ɛ̀ fɔ̃́ nhɑ mɔ́mmuɔ nwèè tu n wɛ̀ì,","poem":1},{"lineBreak":true},{"text":"kɛ́tuótɛ́ n kùtìdùkù kɛ́nyɑ̃nku,","poem":1},{"lineBreak":true},{"text":"kɛ dɑ sɑ̃ntí fɔ̃́ nKuyie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N yɛ̀mmɛ̀ bo cɑɑ̀rɛ̀ bɑ nkpɛ́í kɛ̀ nní nsɑ́útí?","poem":1},{"lineBreak":true},{"text":"N yó mbúɔ́ Kuyie nku kɛ ku nsɑ̃ntí,","poem":1},{"lineBreak":true},{"text":"kunku kùù tu n dɛɛtíwè.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/43.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/44.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/42.json","previousChapterAudioLinks":{},"numberOfVerses":5}