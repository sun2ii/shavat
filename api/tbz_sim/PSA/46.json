{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":46,"content":[{"type":"heading","content":["Kuyie nti bonɛ̀mɛ̀"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Kodee bí yɛ̀nfɛ̀ kɛ biennɛ̀ dɛbémbénnɛ̀ mɛtɑmmɛ̀ mɛdɑɑmɛ̀ kpɛrɛ."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie nkuù tu ti kó disɔ̀rì mɔ́mmɔnni,","poem":1},{"lineBreak":true},{"text":"kuù ti duɔ̀ mmuwɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"kuù ti teénnɛ̀ mɛyɛǹcɑɑ̀rìmɛ̀ mɔ̀nnì.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Dɛɛ̀ te kɛ̀ ti í yĩɛ̃̀kù, bɑ́ kɛ̀ kɛtenkɛ̀ ɑu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ yɛtɑ̃rɛ̀ duò dɑ̀mɛ́ɛ̀rì miɛkɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɑ́ kɛ̀ mɛniɛ nkpɑ nkɛ kóonko kɛ puotì yɛtɑ̃rɛ̀","poem":1},{"lineBreak":true},{"text":"kɛ̀ yɛ̀ sɑ̃̀nti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kukó nkuù pũɔ̃̀ nKuyie nhɛì,","poem":1},{"lineBreak":true},{"text":"kɛ duɔ̀ ndiwɛ̀ì Kuyie kùù bɑkɛ́ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀ ku ɛì sɑ̀ɑ̀rì miɛkɛ.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie mbomu dɛ kó dihɛì miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dì yó nfííkú teii, kuù di teénnɛ̀ dikṹnweńnì sɛ̀ì.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Ibotí iì kuɔ̀ nkɛ̀ yɛkpɑ̀ɑ̀tìyɔ sɑ̃nti,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Kuyie mpɛ́ú mɛtɑmmɛ̀ kɛ̀ kɛtenkɛ̀ pùɔ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie Mpɑkɛdɑɑ wèè bɑkɛ́ dɛmɔu,","poem":1},{"lineBreak":true},{"text":"wè ti bonɛ̀mu,","poem":1},{"lineBreak":true},{"text":"Kuyie nSɑkɔbu do tũ nkù tu ti kó tɛcɛ̃kpetɛ̀ ntɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Kɔtɛnɛ̀ní kɛ́yɑ̀ ti Yiɛ̀ nKuyie ndɔ̀ɔ̀ dɛ̀,","poem":1},{"lineBreak":true},{"text":"kù cɑ̀kɛmɛ̀ kutenkù.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kuyie nkuù còḿmú dikpɑ̀nnì kutenkù kumɔu duɔ́mɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ kékíí dɛtɑ̃nnɛ̀ nɛ̀ yɛkpɑ̃ɑ̃̀, kɛ cɔ́unko sikpɑ̀rìsɛ̃ĩ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kɛ nɑ́ɑ́ nkɛ tú: Yĩ́nɛ̀ só kɛ́bɑntɛ́ míì","poem":1},{"lineBreak":true},{"text":"túmɛ̀ Kuyie nkɛ bɑkɛ́ ibotí nɛ̀ kutenkù.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kuyie nkùù bɑkɛ́ dɛmɔu kù ti bonɛ̀mu,","poem":1},{"lineBreak":true},{"text":"Kuyie nSɑkɔbu do tũ nkù tu ti kó tɛcɛ̃kpetɛ̀ ntɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/46.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/47.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/45.json","previousChapterAudioLinks":{},"numberOfVerses":12}