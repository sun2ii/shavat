{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":47,"content":[{"type":"heading","content":["Ti bo dɛ́úkùnkomɛ̀ Kuyie nhokpɑ̀ɑ̀tì diɛwè"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Kodee bí kó didèntĩ̀nnì kó fɛyɛ̀nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ibotí imɔu, mpɛ́únɛ̀ di nɔu,","poem":1},{"lineBreak":true},{"text":"ńdiènnɛ̀ diwɛ̀ì kɛ sɑ̃ntí Kuyie.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkùù bɑkɛ́ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀ kù duò tikɔ̃m̀bùɔ̀tì nti,","poem":1},{"lineBreak":true},{"text":"kuù tu kɛtenkɛ̀ kɛmɔu kóo kpɑ̀ɑ̀tì diɛwè.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuyie nkuù duɔ́ nkɛ̀ ti nɑ ti dootitɔbɛ̀","poem":1},{"lineBreak":true},{"text":"kuù te kɛ̀ ti nɔ nyɛbotɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuù ti tɑ̃ɑ̃tɛ́ ti yóó tiekɛ dɛ̀ tínti ku kɔbɛ,","poem":1},{"lineBreak":true},{"text":"ti yɛ̀mmɛ̀ nɑɑtinɛ̀mu ti yóó tiekɛ dɛ̀,","poem":1},{"lineBreak":true},{"text":"tínti Sɑkɔbu yɑɑ̀bí kù dɔ́ bɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie ndèètì Siyɔ̃ɔ̃ nwe kɛ̀ bɛ̀ kù sɑ̃ntí,","poem":1},{"lineBreak":true},{"text":"kɛ eu ditɑ̃tɛheù kɛ̀ kù kèrí.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ Kuyie! Nsɑ̃ntínɛ̀ ku!","poem":1},{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ ti kóo kpɑ̀ɑ̀tì! Nsɑ̃ntínɛ̀ we!","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuyie nkuù tu kɛtenkɛ̀ kɛmɔu kóo kpɑ̀ɑ̀tì,","poem":1},{"lineBreak":true},{"text":"ńdiènnɛ̀ kɛ kù sɑ̃ntí.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuyie nkuù bɑkɛ́ yɛbotɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ kɑri ku kpɑ̀ɑ̀tìkɑ̀rì sɑ̀ɑ̀rì.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kutenkù kó ikpɑ̀ɑ̀tìbí,","poem":1},{"lineBreak":true},{"text":"wɛ̃nnɛ́nɛ̀mu Kuyie Abɑrɑhɑmmu do tũ nkù kɔbɛ,","poem":1},{"lineBreak":true},{"text":"Kuyie nkuù te bɛkpɑ̀ɑ̀tìbɛ̀ bɛ̀ɛ̀ bɑkɛ́ kutenkù,","poem":1},{"lineBreak":true},{"text":"kuù te kutenkù kó bɛkpɑ̀ɑ̀tìbɛ̀,","poem":1},{"lineBreak":true},{"text":"kuù bɑkɛ́ dɛmɔu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/47.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/48.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/46.json","previousChapterAudioLinks":{},"numberOfVerses":10}