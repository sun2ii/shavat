{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":48,"content":[{"type":"heading","content":["Okpɑ̀ɑ̀tì diɛwè ɛì kó tinɑ́ɑǹtì"]},{"type":"verse","number":1,"content":["Fɛyɛ̀nfɛ̀ Kodee bí kó didèntĩ̀nnì dìè nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ti Yiɛ̀ nKuyie ndɛumu, Kuyie nkuù dò mbɛ̀ nkù sɑ̃ntí","poem":1},{"lineBreak":true},{"text":"ku ɛì, ku tɑ̃sɑ̀ɑ̀rì ĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Siyɔ̃ɔ̃ tɑ̃rì kubɑkù yoú bíɛ́kɛ̀ okpɑ̀ɑ̀tì diɛwè ɛì.","poem":1},{"lineBreak":true},{"text":"Di wennimu kɛ̀ dɛ̀ nɑɑti kutenkù kumɔu di kpɛ́í","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuyie mbomu ku kpɑ̀ɑ̀tìcĩ́ɛ̃̀tɛ̀ miɛkɛ Siyɔ̃ɔ̃,","poem":1},{"lineBreak":true},{"text":"Kuyie nkuù tu ti kó tɛcɛ̃kpetɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bɛkpɑ̀ɑ̀tìbɛ̀ bɛɛ̀ wɛ̃nnɛ́ kɛ dɑ̀kɛ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ bɑ̀ɑ́tímu kɛ bo kpɑnnɛ̀ Siyɔ̃ɔ̃.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛ yɑ̀ Siyɔ̃ɔ̃ kɛ̀ dɛ̀ bɛ̀ pĩ nkufɔ̃wɑɑ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ yɔ̀tɛ kɛ cokɛ́.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kɛ̀ bɛ kɔ̃̀ntì ɑɑ́ dɛndɛ bɑ̀mbɑ̀,","poem":1},{"lineBreak":true},{"text":"nkupɛitɛ́yonku ɔ̃ɔ̃ pĩ́ nhonitipòkù kòò nkpeutímɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɛ dò ndiyiè yìɛ̀ní kɛ̀ɛ̀ bíɛ́kɛ̀ kó kuyɑɑkù kùù pùɔ̀ Tɑdisisi kóo bɑ̀tóòbɛ̀ diɛbɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ti kèè dɛ̀ ti dɛ nyɑ̀. Kuyie Mpɑkɛdɑɑ ɛì,","poem":1},{"lineBreak":true},{"text":"Kuyie nhɛì, kuù dì kpénkùnnɛ sɑ̃́ɑ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Kuyie nti wɛ̃̀tɛ kɛ yɑumu ɑ sɑ̀ɑ̀ nhɑ cĩ́ɛ̃̀tɛ̀ miɛkɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kuyie nhɑ yètìrì pitɛ́mɛ̀ kutenkù,","poem":1},{"lineBreak":true},{"text":"ɑ sɑ̃nni tùɔ̀kɛmu itemmɑ̀nkɛ,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ bekù kɛ dɛ̀ sìɛ́.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Siyɔ̃ɔ̃ tɑ̃rì kɔbɛ, nyɑ̃nkunɛ̀!","poem":1},{"lineBreak":true},{"text":"Kɛ̀ dɛ̀ nnɑɑti Sudɑɑ ɛkɛ̀ kɔbɛ","poem":1},{"lineBreak":true},{"text":"Kuyie mbeéntì kpɛ́í.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Fitɛ́nɛ̀ Siyɔ̃ɔ̃ ɛì","poem":1},{"lineBreak":true},{"text":"kɑɑnnɛ̀ o dèrɛ̀ mɑ̀mɛ̀.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɛ wéntɛ́ o duotí kɛ́yɑ̀ o cɛ̃kperí,","poem":1},{"lineBreak":true},{"text":"kɛ́nɑ kɛ́nɑ́kɛ́ di yɑɑ̀bí,","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"kɛ dɔ̀: Kuyie nkuù ti te kɛ yó nti ni nɛ̀ ti kṹṹnko.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/48.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/49.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/47.json","previousChapterAudioLinks":{},"numberOfVerses":15}