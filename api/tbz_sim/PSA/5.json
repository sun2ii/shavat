{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":5,"content":[{"type":"heading","content":["Kuyie ncɔutɛ́ wèè kó ibɑ́ɑmmìi"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ kɛ eunɛ̀ itɑ̃rí."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N Yiɛ̀ nKuyie nkéntɛ́ n nɑ́ɑǹtì,","poem":1},{"lineBreak":true},{"text":"keè n dɑbònnì.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N kóo kpɑ̀ɑ̀tì, fɔ̃́ nKuyie fɔ̃́ɔ̃̀ n te,","poem":1},{"lineBreak":true},{"text":"keè n dɑ yumɛ̀, fɔ̃́ nwe m bɑ́ɑ́mmɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie ndikṹnweńnì ɑ ɔ̃ɔ̃ keèmu n tɑmmɛ̀,","poem":1},{"lineBreak":true},{"text":"nh ɔ̃ɔ̃ pikɛ mbúɔ́ fɔ̃́ nwe kɛ dɑ kémmú.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Kuyie nhɑ í dɔ́ mɛyɛi,","poem":1},{"lineBreak":true},{"text":"ɑ ɔ̃ɔ̃ í ncɔutɛ́ oyɛiwe.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ yetɛ yɛto bɛ̀ í yóó dɑ tɔ́ɔ́nnɛ̀,","poem":1},{"lineBreak":true},{"text":"ɑ í dɔ́ bɛ̀ɛ̀ dɔ̀ɔ̀ri bɛtɔbɛ̀ mɛyɛi.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"A kɔùmu siyɑ́ɑ̀bìsí yɛmbɛ̀,","poem":1},{"lineBreak":true},{"text":"nɛ̀ bɛ̀ɛ̀ cou mɛnitiyĩ̀ĩ̀ nɛ̀ bɛciìmbɛ̀,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie mbɛ̀ dò nhɑ borɛ̀ isɔkɛ nyi.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Mí nyie ɑ n dɔ̀ɔ̀ mɛ̀ɛ̀ sɑ̀ɑ̀ ndɛumu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n tɑti ɑ cĩ́ɛ̃̀tɛ̀.","poem":1},{"lineBreak":true},{"text":"N dɑ dému,","poem":1},{"lineBreak":true},{"text":"kɛ yó nnínkú ɑ cɛ̃sɑ̀ɑ̀tɛ̀ miɛkɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nhɑ tú timɔ́mmɔnti yiɛ̀ nwe,","poem":1},{"lineBreak":true},{"text":"nni ncɛ̃mmú bɛ̀ɛ̀ n dííntɛ bɛ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"tũntɛ kucɛ ɑ dɔ́ n tũnnɛ kù.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɛ̀ í mɔkɛ timɔ́mmɔnti,","poem":1},{"lineBreak":true},{"text":"bɛ̀ dɔ́ mɛyɛi mmɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ nɑ́ɑǹtì dò nkufɔ̃ti kùù feí,","poem":1},{"lineBreak":true},{"text":"bɛ̀ tu bɛsoùmbɛ̀ mbɛ,","poem":1},{"lineBreak":true},{"text":"kɛ ɔ̃ nnɑ́ɑ́ nkɛ kpɛnti kɛ nɛ́ dɔ́ mɛyɛi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kuyie nwéntɛ́ bɛ bɛyɛibɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ dɔ́ kɛ́dɔɔ̀ tìi bɛ̀ buɔ́,","poem":1},{"lineBreak":true},{"text":"bɛ yɛi nsũ̀ṹmmu,","poem":1},{"lineBreak":true},{"text":"bɛti bɛ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ yetɛ ɑ kpɛti nti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kɛ̀ bɛ̀ɛ̀ biɛ sɔri ɑ borɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ diwɛ̀ì mbɛ̀ bo,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ nyɑ̃nku sɑ̃́ɑ̃̀ nɛ̀ diwɛ̀ì,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ mbɛ̀ kɑ̃nkɛ́,","poem":1},{"lineBreak":true},{"text":"bɛ̀ dɑ dɔ́mu, yóu kɛ̀ bɛ̀ nyɑ̃nkunɛ̀ diwɛ̀ì.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Fɔ̃́ nKuyie nfɔ̃́ɔ̃̀ dɔ̀ɔ̀ri mɛsɑ̀ɑ̀ mbɛsɑ̀ɑ̀bɛ̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ sɑ̀ɑ̀ mbɛ̀ kɑ̃nkɛ́ kudɔpìkù kɔ̃mɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/5.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/6.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/4.json","previousChapterAudioLinks":{},"numberOfVerses":13}