{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":52,"content":[{"type":"heading","content":["Tikpɑ̀tì yɛiti yiɛ̀ nyóó dentɛnɛ̀ tì"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀."]},{"type":"verse","number":2,"content":["Dowɛki Edomiibɛ kou do nɑ̀kɛ́ Sɑuri Dɑfiti tɑmɛ̀ Aimmɛdɛki cĩ́ɛ̃̀tɛ̀ kòò dentɛ̀ fɛ̀."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Dɛ̀ dòmmɛ fɔ̃́ nwèè kpeńnì mɛyɛi ndɔɔ̀rìmù miɛkɛ kɑ̀ɑ pɔ̀tìnɛ̀ mɛyɛi?","poem":1},{"lineBreak":true},{"text":"Kɛ ɔ̃ ntṹṹ nkɛ toti mukɔ̀ù mɑ́ɑ̀ kpɛ́í?","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A mɔkɛ mɛsoùmmɛ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ nùù nɑɑti kuponkù kɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ tú oniticiìntì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"A dɔ́ mɛyɛi mmɛ kɛ yóu mɛsɑ̀ɑ̀,","poem":1},{"lineBreak":true},{"text":"kɛ dɔ́ siyɑ́ɑ̀bìsí kɛ yóu timɔ́mmɔnti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"A nɔnnɛ̀ tinɑ́ɑǹtì tìì kó dimɑ̀ɑ̀ kɔ̀ùrì tìnti,","poem":1},{"lineBreak":true},{"text":"kɛ mɔkɛ mɛciìmmɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kuyie mbo dɑ bɔ nsɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"kù bo dɑ uutɛ́ ɑ cĩ́ɛ̃̀tɛ̀ miɛkɛ kɛ́ dɑ dennɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ dɑ dɛitɛ bɛfòùbɛ̀ miɛkɛ kɛtenkɛ̀ kiɛ nyĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ borimɛ wenni kɛ̀ bɛ̀ dɑ yɑ̀ kɛ kufɔ̃wɑɑ́ mbɛ̀ pĩ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ ndɑ dɑú kɛ tú:","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ntɛnɛ̀ onìtì wèè do í yíé nKuyie mbo nhò kɑ̃nkɛ́mɛ̀,","poem":1},{"lineBreak":true},{"text":"kòo yɛ̀mmɛ̀ ńnɑɑtinɛ̀ o kpɑ̀tì,","poem":1},{"lineBreak":true},{"text":"ò do soutɛ́mu kɛ́kpenkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mí m bo Kuyie ncĩ́ɛ̃̀tɛ̀ ntɛ kɛ dò mmutie mùù sɛ̀nti,","poem":1},{"lineBreak":true},{"text":"kɛ búɔ́ Kuyie nkó mɛsɑ̀ɑ̀ nsɑ̃́ɑ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"N yó nsɑ̃ntí fɔ̃́ nwe sɑ̃́ɑ̃̀ ɑ dɔ̀ɔ̀ dɛ̀ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"n yó mbúɔ́ fɔ̃́ nwe kɛ yɛ̃́ ɑ sɑ̀ɑ̀ mbonɛ̀mɛ̀ bɛ̀ɛ̀ dɑ dɔ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/52.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/53.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/51.json","previousChapterAudioLinks":{},"numberOfVerses":11}