{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":53,"content":[{"type":"heading","content":["Kuyie nyí boɑ̀?"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ kɛ eu fɛtɑ̃rifɛ."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyɛìnkù kuù ɔ̃ɔ̃ yĩ́ nɛ̀ ku yɛ̀mmɛ̀ miɛkɛ Kuyie nyí bo.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ cɑ̀kɛmu kɛ dɔɔri isɔkɛ kpɛrɛ,","poem":1},{"lineBreak":true},{"text":"bɛ miɛkɛ òmɔù í dɔɔri dɛ̀ɛ̀ wenni.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuyie mbo kɛĩ́nkɛ̀ nkɛ kɛ wúónní bɛnìtìbɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ bo yɑ̀ kòò mɔù bo wèè mɔ̀kɛ mɛyɛ̀mmɛ̀ kɛ kù wɑnti.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Bɛmɔu bɛ̀ dɛ̀tɛ́nɛ̀ Kuyie nku,","poem":1},{"lineBreak":true},{"text":"bɛmɔu bɛ̀ cɑ̀kɛmu,","poem":1},{"lineBreak":true},{"text":"òmɔù í dɔɔri mɛsɑ̀ɑ̀ mbɑ́ omɑ́ɑ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bɛ̀ɛ̀ dɔ̀ɔ̀ri mɛyɛi mbɛtɔbɛ̀ bɛ̀ í yɛ̃́ dɛ̀mɑrɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ soú n kɔbɛ mbɛ kɛ yo,","poem":1},{"lineBreak":true},{"text":"bɛ̀ í n yu mí nKuyie.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Ntɛ bɛ kɛ̀ kufɔ̃wɑɑ́ mbɛ̀ ɑutɛ́ dɛtetìrɛ̀,","poem":1},{"lineBreak":true},{"text":"Kuyie nyóó díɛ́mu ɑ dootitɔbɛ̀ kṹɔ̃̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ bɛ̀ ɑ̃nnɛ́ ifɛi,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ Kuyie mbɛ̀ bɔntóomɛ̀mu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"We nyóó yɛ̀nní Siyɔ̃ɔ̃ kɛ́dɛɛtɛ́ Isidɑyɛɛribɛ?","poem":1},{"lineBreak":true},{"text":"Kuyie mbo fietɛní dìì mɔ̀nnì ku kɔbɛ bɛ̀ɛ̀ tu tidɑɑtì,","poem":1},{"lineBreak":true},{"text":"dɛ̀ bo nɑrikɛ Sɑkɔbu kɔbɛ,","poem":1},{"lineBreak":true},{"text":"Isidɑyɛɛribɛ bo nyɑ̃nku.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/53.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/54.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/52.json","previousChapterAudioLinks":{},"numberOfVerses":7}