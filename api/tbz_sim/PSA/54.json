{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":54,"content":[{"type":"heading","content":["Wèè fɛ̃́ũ̀rì ò bɑ̀ɑ́mmɛ̀ Kuyie"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ bɛ̀ dìè nfɛ̀ kɛ bie ntibómbonti iwɛ̃ĩ kpɛti."]},{"type":"verse","number":2,"content":["Sifĩɛ̃bɛ do nɑ̀kɛ́ Sɑuri kɛ dɔ̀ Dɑfiti sɔ̀ri bɛ ciɛ kɛ̀ Dɑfitii dentɛ̀ fɛ̀."]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Áú Kuyie! N dɛɛtɛ́ ɑ yètìrì kpɛ́í,","poem":1},{"lineBreak":true},{"text":"n kónnɛ́ kɛ́bɛnkɛ ɑ wɛ̃rímú.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuyie nkéntɛ́ m bɑ́ɑmmìi,","poem":1},{"lineBreak":true},{"text":"keè n yɛ̃ mmù.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Bɛpɔ̀ɔ̀bɛ̀ bɛɛ̀ ìtɛ́ kɛ n dokùnɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛnitiyonkubɛ dɔ́ kɛ́ n kuɔ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ í bɔti Kuyie nkpɛti.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie nyó n teennɛ̀mu,","poem":1},{"lineBreak":true},{"text":"n Yiɛ̀ nKuyie nyó nni nkpénkùnkoomu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Mɛyɛi ndo n dootitɔbɛ̀ ĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ ntimɔ́mmɔnti yiɛ̀, kuɔ bɛ pɑ́íí.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"M bo dɑ pɑ̃ dipɑ̃nnì nɛ̀ n yɛ̀mmɛ̀ mɛmɔu,","poem":1},{"lineBreak":true},{"text":"n Yiɛ̀ nKuyie m bo ndɛ́úkùnko ɑ yètìrì, ɑ wennimu.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A n dɛɛtɛ́nɛ̀ mɛyɛǹcɑɑ̀rìmɛ̀ mɛmɔu ndi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n yɑ̀ n dootitɔbɛ̀ domɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/54.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/55.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/53.json","previousChapterAudioLinks":{},"numberOfVerses":9}