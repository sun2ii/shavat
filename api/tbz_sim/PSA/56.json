{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":56,"content":[{"type":"heading","content":["Bɛ̀ fɛ̃́ũnko wè ò duɔ́mmɛ̀ omɑ́ɑ̀ Kuyie"]},{"type":"verse","number":1,"content":["Bɛ̀dèmbɛ̀ kóo kótì dìèmmɛ̀ fɛyɛ̀nfɛ̀ Fidisitɛ̃ɛ̃bɛ do pĩ nDɑfiti Kɑti kó dihɛì kòo dentɛ̀ fɛ̀. Bɛ̀ fɛ̀ dìènnɛ̀ mɛ̀ɛ̀ tɑmmɛ̀ dònnɛ̀ dikpɛtinɔ́nkperi kó didɑbònnì ndi, dìì yìɛ̀ní dɛdɛ́tirɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Áú! Kuyie n kuɔ́ mmɛsémmɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛ̀ m bɛ̀tìmu,","poem":1},{"lineBreak":true},{"text":"kɛ n dimmù kɛ n dokùnɛ̀ yɛwe yɛmɔu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N kpɑntídɛ̀ntɔbɛ̀ m bɛ̀tì yɛwe yɛmɔu ndi,","poem":1},{"lineBreak":true},{"text":"bɛ̀ sũmu bɛ̀ɛ̀ n dimmù kɛ n dokùnɛ̀ tɛfentɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kufɔ̃wɑɑ́ nhɔ̃ɔ̃ m pĩ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n duɔ́ fɔ̃́ nwe mmɑ́ɑ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N sɑ̃ntímu Kuyie nku nɑ́ɑǹtì kpɛ́í,","poem":1},{"lineBreak":true},{"text":"n ku nduɔ́ mmɑ́ɑ̀","poem":1},{"lineBreak":true},{"text":"n yí yĩɛ̃̀kù dɛ̀mɑrɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛnìtìbɛ̀ bo nɑ kɛ́ n dɔɔ̀ bɑ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Yɛwe yɛmɔu bɛ nɑ́ɑǹtì ǹ kɔɔ́nnɛ̀mu,","poem":1},{"lineBreak":true},{"text":"bɛ̀ n wɑntinɛ̀ mɛyɛi mmɛ.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛ̀ dɑ̀kiimu kɛ m pɑkíí,","poem":1},{"lineBreak":true},{"text":"bɛ̀ tũ n nɑɑ̀cɛ̀i nsi kɛ dɔ́ kɛ́ n kuɔ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Bɛ̀ bo dɔ̀ɔ̀ mɛyɛi mmiɛ nkɛ́nɑ kɛ dɑ yentɛ́nɑ̀ɑ̀?","poem":1},{"lineBreak":true},{"text":"Kuyie, mbɔ mbɛ nɛ̀ kɛmiɛkɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"A yɛ̃́mu nh ɑrì mɛ̀ɛ̀ botí,","poem":1},{"lineBreak":true},{"text":"ceé n nɔnniɛti ɑ dɔukù miɛkɛ,","poem":1},{"lineBreak":true},{"text":"ɑ ti wɑ̃̀rimu ɑ pɑ́tíri miɛkɛ.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɛ̀ n dɑ yu n dootitɔbɛ̀ ɔ̃ɔ̃ cokɛ́mu,","poem":1},{"lineBreak":true},{"text":"Kuyie, n yɛ̃́mu ɑ n kómmúmɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kuyie n dɑ sɑ̃ntímu ɑ bɛ́i ntì kpɛ́í,","poem":1},{"lineBreak":true},{"text":"n Yiɛ̀ nKuyie n dɑ sɑ̃ntímu ɑ nɑ́ɑǹtì kpɛ́í.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"N dɑ duɔ́ mmɑ́ɑ̀ ndi n yí yĩɛ̃̀kù tìmɑtì,","poem":1},{"lineBreak":true},{"text":"bɛnìtìbɛ̀ bo nɑ kɛ́ n dɔɔ̀ bɑ?","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kuyie ndò nkɛ́dɔɔ̀mu n yɛ̃ n yóó dɑ dɔ̀ɔ̀ tì,","poem":1},{"lineBreak":true},{"text":"n yóó dɑ fíé disɑ̃nni kó iwũɔ̃ nyi.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ n dɛɛtɛ́ nɛ̀ mukṹṹ,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ n teennɛ̀ kɛ̀ n nɑɑ̀cɛ̀i í bètɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ bo yie nkɛ̀ nni nkérí ɑ ììkɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ wúó mmɛnɑ́ɑ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/56.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/57.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/55.json","previousChapterAudioLinks":{},"numberOfVerses":14}