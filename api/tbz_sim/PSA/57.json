{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":57,"content":[{"type":"heading","content":["Dɑfiti yumɛ̀ Kuyie nhoĩ́nkɛ̀nkpɑ̀ɑ̀tì"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ ò do cokùnɛ̀ Sɑuri titɑ̃dèntì miɛkɛ kɛ́dentɛ̀ fɛ̀. Bɛ̀ do fɛ̀ dìènnɛ̀ mɛtɑmmɛ̀ mɛ̀ɛ̀ tu mɛ̀ mmɛ bɑ́ɑ́ kuɔ."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Áú Kuyie, n dɛɛtɛ́, yɑ̀ɑ n dɛɛtɛ́!","poem":1},{"lineBreak":true},{"text":"N sɔri ɑ fìɛ̀ti dɛ́ɛ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"kɛ kémmú mɛfɛ̃́ṹtímɛ̀ bo deèmɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuyie n dɑ yumu fɔ̃́ wèè bɑkɛ́ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ te kɛ̀ n kpɛti timɔu yíé.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A yó mboní kɛĩ́nkɛ̀ nkɛ kɛ́ n dɛɛtɛ́,","poem":1},{"lineBreak":true},{"text":"kɛ́fɛìkùnnɛ wèè m bɛ̀tì,","poem":1},{"lineBreak":true},{"text":"kɛ́ m bɛnkɛ ɑ sɑ̀ɑ̀ nnɛ̀ ɑ kó timɔ́mmɔnti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"N sokɛ́ yɛcìrícìrɛ̀ cuokɛ̀ nkɛ,","poem":1},{"lineBreak":true},{"text":"n duɔ́ bɛnìtìcɑ́ɑ̀mbɛ̀ cuokɛ̀ nkɛ,","poem":1},{"lineBreak":true},{"text":"Bɛ nìì ndò nyɛkpɑ̃ɑ̃̀ nyɛ nɛ̀ ipie,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ nɔ́ndiɛ́ ndò tikpɑ̀rìseuti.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuyie nhɑ yètìrì ńdɛu kɛĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛnkɛ ɑ kpetì kɛtenkɛ̀ kɛmɔu miɛkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bɛ̀ n dii ticùɔ̀tì nti,","poem":1},{"lineBreak":true},{"text":"bɛ̀ ɑ̀ɑ nkuhɔ̃ũ deè ndi kɛ bo n dúú,","poem":1},{"lineBreak":true},{"text":"bɛ̀ keù difɔ̃̀tìrì ndi n yììkɛ̀.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ɛ do bɛmɔ́mmɔmbɛ di miɛkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kuyie, m bùɔ̀tì tɛ̃́nkɛ í duò, n tɛ̃́nkɛ í yĩɛ̃̀kù,","poem":1},{"lineBreak":true},{"text":"m bo ndiè nkɛ dɑ sɑ̃ntí.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N wɛ̃nnì, entɛ,","poem":1},{"lineBreak":true},{"text":"n kùtìdùkù nɛ̀ m bómbonku, entɛnɛ̀,","poem":1},{"lineBreak":true},{"text":"n yóó entɛmu dikṹnweńnì sɛ̀ì kɛ́dentɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"N Yiɛ̀ nKuyie n yó ndɑ sɑ̃ntímu bɛnìtìbɛ̀ cuokɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́ndiè nkɛ dɛ́úkùnko ɑ yètìrì ibotí cuokɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɛ yɛ̃́ ɑ sɑ̀ɑ̀ ndɛumɛ̀ kɛ tuɔ̀kù tiwɛtì,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ mɔ́mmɔnti tuɔ̀kù yɛwɛtɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Áú Kuyie! A yètìrì ndɛu kɛĩ́nkɛ̀,","poem":1},{"lineBreak":true},{"text":"bɛnkɛ ɑ kpetì kɛtenkɛ̀ kɛmɔu miɛkɛ.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/57.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/58.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/56.json","previousChapterAudioLinks":{},"numberOfVerses":12}