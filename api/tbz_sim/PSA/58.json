{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":58,"content":[{"type":"heading","content":["Kuyie mbomɛ̀ kutenkù kɛ bekù"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ nɛ̀ mɛtɑmmɛ̀ mɛ̀ɛ̀ tu: Á bɑ́ɑ́ kuɔ."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Bɛkpɑ̀ɑ̀tìbɛ̀ di bekù bɑkɛ weti weti nweɑ̀?","poem":1},{"lineBreak":true},{"text":"Bɛ̀ bekùnɛ̀ miɛ̀ mmɛ bɛnìtìbɑ̀ɑ̀?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Di dɔɔri dɛ̀ɛ̀ í wenni kɛ yɛ̃́mu,","poem":1},{"lineBreak":true},{"text":"díì píɛ mmɛyɛi ndihɛì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Oyɛiwe tú oyɛiwe nwe nɛ̀ o yɔ̃ pɔutì miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ siyɑ́ɑ̀bìsí yiɛ̀ nfeti nɛ̀ bɛ̀ ò pɛinímɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɛ̀ mɔ̀kɛ mɛdɑutidɔ̀mmɛ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"kɛ dɔɔri kɛ dò ndiwɑɑ̀hɔ̃̀nnì,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"dìì í yo owɑɑ̀pĩ́ntì tɑmmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ í yo oteteu diɛwè nɑ́ɑǹtì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kuyie, mbɔ́kɛ́ bɛ nìì,","poem":1},{"lineBreak":true},{"text":"bɔ́kɛ́ yɛcìrícìrìnìì mbɛ̀ mɔ̀kɛ yɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kɛ̀ bɛ̀ɛ pɛ̃ɛ̃tóo mɛniɛ nhɔ̃ɔ̃ pɔ̃ntɛ́ mmɛ̀ɛ̀ botí,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ ntɑ̃ũ bɛ pie mbɑ́ ì bɑ́ɑ́ dɔ̀ɔ̀ dɛ̀mɑrɛ̀.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ nɑɑ́nnɛ̀ tidɑ̀tìkonkontì,","poem":1},{"lineBreak":true},{"text":"tìì fũrì kɛ̀ ti ɑmmɛ̀ dèu,","poem":1},{"lineBreak":true},{"text":"bɛ̀ ndò mbɛ̀ pɛitɛ́ wè ocírì kòò í yɑ̀ diyiè.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Bɛ po yó nkpɑɑ́ kɛ mu nyí yɛ̀ tifɑ̃ɑ̃̀tì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ tɛfɔ̀dɔ́ntɛ̀ɛ ì tùótɛ́mu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ sɔ̃́ nyì sũ̀ tɛ̀ɛ ì tùótɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Osɑ̀ù bo yɑ̀ Kuyie mpɛ̀itɛmɛ̀ kɛ̀ dɛ̀ɛ ò nɑrikɛ mɛdiɛ̀,","poem":1},{"lineBreak":true},{"text":"kòo ɔ́ú o nɑɑ̀cɛ̀i bɛ yĩ̀ĩ̀ mmiɛkɛ.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɛ̀ bɛnìtìbɛ̀ɛ dɛ̀ yɑ̀ kɛ dɔ̀:","poem":1},{"lineBreak":true},{"text":"Kuyie mmɛ̀nkɛ yietìmu osɑ̀ù,","poem":1},{"lineBreak":true},{"text":"bɛ̀ bo yĩ́ Kuyie mmɛ̀nkɛ bomu kɛtenkɛ̀ kɛ bekù.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/58.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/59.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/57.json","previousChapterAudioLinks":{},"numberOfVerses":12}