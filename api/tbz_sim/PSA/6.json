{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":6,"content":[{"type":"heading","content":["Bɛ̀ bɑ̀ɑ́mmɛ̀ Kuyie nkɛ dɔ́ mɛteèmmɛ̀"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ kɛ biennɛ̀ kubómbonku iwɛ̃ĩ ini kɔku."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie nhɑ bɑ́ m potɛ́ nɛ̀ kɛmiɛkɛ,","poem":1},{"lineBreak":true},{"text":"ɑ bɑ́ n tiénnɛ̀ kumiɛpíɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie, n kuɔ́ mmɛsémmɛ̀, n cĩ̀tɛmu,","poem":1},{"lineBreak":true},{"text":"n Yiɛ̀ nKuyie, m miɛkùnnɛ n kṹɔ̃̀ í pĩ́ nyɛtɔbɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"N yí yɛ̃́ m bo tìì miɛkɛ.","poem":1},{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie dɛ̀ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɑ̀ɑ n teennɛ̀?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Áú n Yiɛ̀ nKuyie, bónkùnnɛ ɑ miɛkɛ kɛ́ n dɛɛtɛ́!","poem":1},{"lineBreak":true},{"text":"N coo nhɑ sɑ̀ɑ̀ nkpɛ́í.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɛcíríbɛ̀ dɑ yɛ̃̀mmu,","poem":1},{"lineBreak":true},{"text":"we mbo dɑ sɑ̃ntɛ kudɔnkù?","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N kuɔ̀mmu kɛ cĩtiroo,","poem":1},{"lineBreak":true},{"text":"bɑ́ kɛ̀ɛ̀ yènkɛ̀ nh ɔ̃ nkuɔ̀mmu kɛ̀ n dɔ́ùu búútɛ́,","poem":1},{"lineBreak":true},{"text":"n dɔ́ù diì sɑ̃̀ɑ̃̀kɛnɛ̀ tinɔnniɛti.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Mɛsémmɛ̀ mɛɛ̀ te kɛ̀ n nuɔ ncĩ̀tɛ,","poem":1},{"lineBreak":true},{"text":"n dùɔ̀ntɔbɛ̀ bɛɛ̀ sũ kɛ̀ n nuɔ nhɔ̀u.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Fũtɛnɛ̀ m borɛ̀, díndi bɛ̀ɛ̀ dɔ̀ɔ̀ri mɛyɛi,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nkèèmu n dɑbònnì.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkèèmu n sɑ́útìi,","poem":1},{"lineBreak":true},{"text":"kɛ cɔutɛ́ m bɑ́ɑmmìi.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N dootitɔbɛ̀ kufɔ̃wɑɑ́ nkuù bɛ̀ pĩ nkɛ̀ bɛ̀ di ifɛi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ kɔ̃̀ntì ɑu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ cokù mɛcɑ̃ɑ̃ nnɛ̀ ifɛi kɛ wɛ̃ti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/6.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/7.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/5.json","previousChapterAudioLinks":{},"numberOfVerses":11}