{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":61,"content":[{"type":"heading","content":["Dɑfiti dɔ́mɛ̀ Kuyie nni nhò kɑ̃nkɛ́"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ kɛ biennɛ̀ tibómbonti iwɛ̃ĩ kpɛti."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie nkéntɛ́ n dɑbònnì,","poem":1},{"lineBreak":true},{"text":"keè m bɑ́ɑmmìi.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"M bo kutemmɑ̀nku nku,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n yɛ̀mmɛ̀ cɑ̀ɑ̀rɛ̀ kɛ̀ n dɑ kuɔ̀nnɛ̀,","poem":1},{"lineBreak":true},{"text":"n dee kupèrìkù n yĩɛ̃kɛ kù.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Fɔ̃́ɔ̃̀ tu n kó disɔ̀rì,","poem":1},{"lineBreak":true},{"text":"didènnì kperì ti dootitɔbɛ̀ í yóó nintɛ dì.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N dɔ́ kɛ́mbo ɑ cĩ́ɛ̃̀tɛ̀ miɛkɛ nkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́nsɔri ɑ fìɛ̀ti miɛkɛ sɑ̃́ɑ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Kuyie nfɔ̃́ɔ̃̀ kèè n dɑ nɑ́ɑ́ ntì,","poem":1},{"lineBreak":true},{"text":"kɛ duɔ́ nhɑ kɔbɛ bɛ̀ɛ̀ dɑ dé bɛ kó kɛtenkɛ̀ sɑ̀ɑ̀kɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Yíɛ́ okpɑ̀ɑ̀tì mufòmmu,","poem":1},{"lineBreak":true},{"text":"kòò nfòù yɛbie nyɛbie.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kòò ndɑ tɑunnɛ̀, ɑ́ nhò bonɛ̀ kòo mbɑkɛ́ sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ sɑ̀ɑ̀ nnɛ̀ timɔ́mmɔnti nhò bɑ̀ɑ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"M bo ndiè nkɛ dɛ́úkùnko ɑ yètìrì sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"bɑ́ dìì yiè kɛ́ndɔɔri n yɛ̃ n yóó dɑ dɔɔ̀ tì.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/61.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/62.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/60.json","previousChapterAudioLinks":{},"numberOfVerses":9}