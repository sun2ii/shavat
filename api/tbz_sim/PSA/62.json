{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":62,"content":[{"type":"heading","content":["Kuyie mborɛ̀ n dɛ mmɔkɛ diwɛ̀ì"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀ Yedutunni dìè nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie mborɛ̀ mɑ́ɑ̀ ndi m mɔkɛmɛ̀ diwɛ̀ì,","poem":1},{"lineBreak":true},{"text":"kuù n dɛɛrí.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kuù tu dipèrì dìì n kɑ̃nkɛ́,","poem":1},{"lineBreak":true},{"text":"tɛcɛ̃kpetɛ̀ tɛ̀ɛ̀ n dɛɛrí,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kù m bonɛ̀ m bɑ́ɑ́ cĩtɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Ɔ̃mmɔ̀nnì ndi di yóó yóumɛ̀ di bo ntíkúmɛ̀,","poem":1},{"lineBreak":true},{"text":"di bo domɛ̀ onìtì kóò pɔ̀ntɛ kumɑrí kùù ku ku kɔ̃mɛ?","poem":1},{"lineBreak":true},{"text":"Kóò yèètɛ kuduotí kùù bíi nku kɔ̃mɛ?","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Di mɛ̀nkɛ dɑkiimu kɛ bo bɔ nhokpɑ̀ɑ̀tì,","poem":1},{"lineBreak":true},{"text":"kɛ nɔnnɛ̀ siyɑ́ɑ̀bìsí,","poem":1},{"lineBreak":true},{"text":"kɛ ɔ̃ nsɑ̃ntínɛ̀ di nɔ̀ di yɛ̀mmɛ̀ miɛkɛ kɛ nɛ́ buɔ̀ nkusĩ̀nkù.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kuyie mborɛ̀ mɑ́ɑ̀ ndi n yóó nɑ kɛ́pɛ́tɛ́mɛ̀ diwɛ̀ì,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ n ku mbúɔ́mɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuù tu dipèrì dìì n kɑ̃nkɛ́,","poem":1},{"lineBreak":true},{"text":"tɛcɛ̃kpetɛ̀ tɛ̀ɛ̀ n dɛɛrí,","poem":1},{"lineBreak":true},{"text":"kɛ̀ n kù bonɛ̀ m bɑ́ cĩtɛ.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuyie nkuù n dɛɛrí,","poem":1},{"lineBreak":true},{"text":"kuù tu n kó disɑ̃nni,","poem":1},{"lineBreak":true},{"text":"kuù tu dipèrì dìì n kɑ̃nkɛ́,","poem":1},{"lineBreak":true},{"text":"kuù tu n sɔ̀rì.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Díndi Isidɑyɛɛribɛ mbúɔ́nɛ̀ ku sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"kɛ kù nɑ̀ɑ́ ndi yɛ̀mmɛ̀ kpɛti,","poem":1},{"lineBreak":true},{"text":"kuù tu ti kó disɔ̀rì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Onìtì dò nkuyɑɑkù nku,","poem":1},{"lineBreak":true},{"text":"bɛnìtìbɛ̀ mɛ̀nkɛ tú siyɑ́ɑ̀bìsí yɛmbɛ̀ mbɛ,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ bɛ̀ wɛ̃nnɛ́ kɛ́cɔ̃nnɛ́ cìdóò bɛ̀ bo nyɑu kɛ pɛ̃ɛ̃tɛ́ muyɑɑ́.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Di bɑ́ ndɔ́ kɛ́nyo mbɛtɔbɛ̀ nɛ̀ muwɛ̃rímú,","poem":1},{"lineBreak":true},{"text":"bɑ́ ndɔ́nɛ̀ mufèè kpɛrɛ,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ kpɑ̀tì dɛ̀úkú ɑ bɑ́ɑ́ tì duɔ́ nhɑ yɛ̀mmɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dɛ̀ í tú kucɛ mɛ̀mɑ́ɑ̀ ndi Kuyie mbɛ́immɛ̀.","poem":1},{"lineBreak":true},{"text":"N kèèmu kù tumɛ̀ kuù te muwɛ̃rímú.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"N Yiɛ̀ nKuyie nhɑ sɑ̀mu,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ fɔ̃́ɔ̃̀ yietìmɛ̀ bɑ́ wè o tɔ̃mmú mɑnnɛ̀ tìì yeti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/62.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/63.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/61.json","previousChapterAudioLinks":{},"numberOfVerses":13}