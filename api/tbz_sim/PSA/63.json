{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":63,"content":[{"type":"heading","content":["Kuyie m bo ndɑ dɔ́mɛ̀ pɛ̃ɛ̃tɛ́mu mufòmmu"]},{"type":"verse","number":1,"content":["Dɑfiti yɛ̀nfɛ̀ ò dèntɛ̀ fɛ̀ o cooti dìì mɔ̀nnì kɛ bo Sudɑɑ kpɑ́ɑ̀ miɛkɛ."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie, nfɔ̃́ɔ̃̀ tu Kuyie n dɑ wɑɑ̀mmu,","poem":1},{"lineBreak":true},{"text":"n dɑ yɑ́ɑ́mmu kɛ dò ntɛdɔntɛ̀ tɛ̀ɛ̀ kpeí tɛ̀ ɔ̃ ndɔ́mɛ̀ mɛniɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N dɔ́ kɛ́ ndɑ wúómmu ɑ cĩ́ɛ̃̀tɛ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́yɑ̀ ɑ wɛ̃rímú nɛ̀ ɑ dɛumɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A n dɔ́mɛ̀ pɛ̃ɛ̃tɛ́mu m bo n fòùmɛ̀,","poem":1},{"lineBreak":true},{"text":"n yó ndɑ sɑ̃ntímu sɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N yó ndɑ sɑ̃ntímu n fòmmu mumɔu miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ dɑ bɑ́ɑ́ nkɛ yu ɑ yètìrì.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ te kɛ̀ n sɑ̀nnɛ̀ kɛ dò n di mɛkùɔ̀ nkpɛrɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ n nɑɑti kɛ̀ n dìè nkɛ dɑ sɑ̃ntí.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Kɛ̀ n duɔ́ nh ɔ̃ nyɛ̃́ fɔ̃́ɔ̃̀ kpɛ́í,","poem":1},{"lineBreak":true},{"text":"kɛ totí n yɛ̀mmɛ̀ ɑ bíɛ́kɛ̀ kɛyènkɛ̀ kɛmɔu.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ n teénnɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ n kɑ̃nkɛ́ ɑ fìɛ̀ti,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ n nɑɑti kɛ̀ n dìè nkɛ dɑ sɑ̃ntí.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"N dɑ pĩ́ n nɔu sidɛ́ ndi,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ nɔ̀ùtɛ̀ youtɛ n cúɔ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Bɛ̀ɛ̀ dɔ́ kɛ́ n kuɔ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ tɑɑ́ kudɔnkù.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Duɔ́ nkɛ̀ mudoò bɛ̀ kùɔ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ sikpɑmɔɔ́ bɛ̀ cɑ̀ɑ́kɛ́.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Kɛ̀ Kuyie nnɑ́rìkùnnɛ okpɑ̀ɑ̀tì yɛ̀mmɛ̀.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ɛ̀ cɑ̀nnɛnɛ̀ bɛtɔbɛ̀ yɛnɔ̀ nɛ̀ Kuyie nkó diyètìrì,","poem":1},{"lineBreak":true},{"text":"bɛ̀ yó nsɑ̃ntímu bɛmɑ́ɑ̀.","poem":1},{"lineBreak":true},{"text":"Siyɑ́ɑ̀bìsí yɛmbɛ̀ biɛ kó yɛnɔ̀ mɛ mbɑ́ɑ́ tɑ́útɛ́.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/63.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/64.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/62.json","previousChapterAudioLinks":{},"numberOfVerses":12}