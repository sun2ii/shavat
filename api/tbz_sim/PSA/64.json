{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":64,"content":[{"type":"heading","content":["Dɑfiti bɑ̀ɑ́mmɛ̀ Kuyie nkɛ tú kùu ò dɛɛtɛ́nɛ̀ bɛyɛibɛ"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Áú Kuyie! N kuɔ̀nnɛ̀ fɔ̃́ nwe,","poem":1},{"lineBreak":true},{"text":"kéntɛ́ n dɑbònnì,","poem":1},{"lineBreak":true},{"text":"ɑ nni nkɑ̃nkɛ́ n dootitɔbɛ̀,","poem":1},{"lineBreak":true},{"text":"n kɔ̃m̀bùɔ̀tì duò bɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"N dɛɛtɛ́ nɛ̀ bɛnitiyɛibɛ dɑkii kɛ bo n dɔɔ̀ tì,","poem":1},{"lineBreak":true},{"text":"ɑ n dɛ́tinnɛ yɛdɔnnɛtĩ̀rɛ̀ yɛ̀ɛ̀ dɑ̀kii n kpɛ́í.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Bɛ nɔ́ndiɛ́ nyiì dò nyɛsekontɛ bɛ̀ sũ̀ɔ̃́tɛ́ yɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ nɑ́ɑǹtì kɔ̀ùrì ipendɔ̀nni kɔ̃mɛ.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Bɛɛ̀ ɔ̃ɔ̃ dɛ́kɛ́ bɛnitisɑ̀ɑ̀bɛ̀ kɛ́ mbɛ̀ tɑ̃ũ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ ɔ̃ mbɛ̀ tɑ̃ũ disɔ̀rì ndi kɛ í yĩɛ̃̀kù.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Bɛ̀ yɑ̀úkùnko bɛtɔbɛ̀ kɔ̃̀ntì nti kɛ bo ndɔɔri mɛyɛi,","poem":1},{"lineBreak":true},{"text":"kɛ dɑkii kɛ bo sɔri kɛ díí ntimɑ́tì,","poem":1},{"lineBreak":true},{"text":"kɛ nɑ́ɑ́ nkɛ tú: Òmɔù í yóó ti yɑ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Bɛ̀ dɑ̀kii kɛ dɔ́ mɛyɛi mmɑ́ɑ̀ ndi,","poem":1},{"lineBreak":true},{"text":"kɛ nɑ́ɑ́ nkɛ tú bɛ̀ bɑ̀ɑ́tí kɛ̀ dɛ̀ wennimu.","poem":1},{"lineBreak":true},{"text":"Onìtì yɛ̀mmɛ̀ cũmpúrìmu,","poem":1},{"lineBreak":true},{"text":"ɑ bɑ́ɑ́ nɑ kɛ́nyɛ̃́ dɛ̀ɛ̀ bo o miɛkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Kuyie mmɛ mbɛ̀ tɑ̃ũ ku pie nyi dɛndɛ bɑ̀mbɑ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ ì bɛ̀ tùɔ̀tì kɛ̀ bɛ̀ duò.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Bɛ nɔ̀ yɛɛ̀ bɛ̀ tùɔ̀tì,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ bɛ̀ yɑ̀u bɛ̀ bo ndɑú kɛ́héùròo.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Kɛ̀ kufɔ̃wɑɑ́ mpĩ́ mbɛnìtìbɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ nnɑ́ɑ́ nKuyie ndɔɔ̀ dɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́bɑntɛ́ kù pĩ mmɛ̀ɛ̀ botí mutɔ̃mmú.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Wèè wetí we nyɑ̃nku o Yiɛ̀ nKuyie nkpɛ́í,","poem":1},{"lineBreak":true},{"text":"kɛ́nsɔ̀rì ku borɛ̀.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ɛ̀ yɛ̀mmɛ̀ wenni kɛ̀ bɛ̀ nyɑ̃nku ku kpɛ́í.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/64.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/65.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/63.json","previousChapterAudioLinks":{},"numberOfVerses":11}