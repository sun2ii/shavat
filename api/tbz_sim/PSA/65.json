{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":65,"content":[{"type":"heading","content":["Kuyie nkuù mɑ̀nnɛ̀ ti nkù sɑ̃ntí"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Dɑfiti yɛ̀nfɛ̀."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie nhɑ ɛì Siyɔ̃ɔ̃ miɛkɛ fɔ̃́ɔ̃̀ dò mbɛnìtìbɛ̀ bɛmɔu ndɑ sɑ̃ntí,","poem":1},{"lineBreak":true},{"text":"bɑ́ wè kòo ndɔɔri ò dɑ dɔúnnɛ̀ dìì nùù.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Fɔ̃́ nwèè yo bɛnìtìbɛ̀ bɑ́ɑmmìi,","poem":1},{"lineBreak":true},{"text":"bɛnìtìbɛ̀ bɛmɔu kɔ̀rìní ɑ borɛ̀ ndɛ.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ti yɛi mmɛɛ̀ ti dɛutɛ́,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ ti cĩ́ɛ̃nko ti cɑɑ̀rìmɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Dɛ̀ nnɑɑti ɑ tɑ̃ɑ̃tɛ́ bɛ̀ kɛ̀ bɛ̀ bo mbo ɑ cĩ́ɛ̃̀tɛ̀,","poem":1},{"lineBreak":true},{"text":"tíì yó nte dɛsɑ̀ɑ̀rɛ̀ dɛ̀ɛ̀ bo ɑ cɛ̃sɑ̀ɑ̀tɛ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ nti sɑ̀nnɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Fɔ̃́ nKuyie nti dɛɛtíwè,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ ntimɔ́mmɔnti yiɛ̀,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ cɔú ti bɑ́ɑmmu kɛ dɔɔri tidiɛtì kɛ̀ titentì timɔu kɔbɛ dɑ búɔ́","poem":1},{"lineBreak":true},{"text":"nɛ̀ kɛtenkɛ̀ kɛ̀ɛ̀ sokɛ́ dɑ̀mɛ́ɛ̀rì cuokòo.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Fɔ̃́ɔ̃̀ kó muwɛ̃rímú te kɛ̀ yɛtɑ̃rɛ̀ fìíkú.","poem":1},{"lineBreak":true},{"text":"A wɛ̃rímú muù tu ɑ kpɑ̀rìnɛnkù.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ commu dɑ̀mɛ́ɛ̀rì nɛ̀ o nɛ́fĩ̀nfĩ̀rɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ commu kutenkù kó kunɑmpoo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kutenkù kumɔu yɑ̀ ɑ dɔɔri tìì diɛtì nti kɛ dɑ yɔ̀tɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ diyiè yìɛ̀ kɛ̀ɛ̀ bíɛ́kɛ̀ nɛ̀ dì tɑɑ̀ kɛ̀ɛ̀ bíɛ́kɛ̀ kɔbɛ íú mɛdiɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Fɔ̃́ɔ̃̀ dɔ̀ɔ̀ri kɛtenkɛ̀ mɛsɑ̀ɑ̀ kɛ kɛ̀ duɔ̀ nfɛtɑɑfɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ boo kɛ̀ tidiitì pɛí,","poem":1},{"lineBreak":true},{"text":"Kuyie nhɑ bintɛ í kũũ,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ɔ̃̀ duɔ̀ mbɛnìtìbɛ̀ tidiitì,","poem":1},{"lineBreak":true},{"text":"kɛ tũnni kɛtenkɛ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Kɛ yɔ́ɔ̀rì ipɛ̃,","poem":1},{"lineBreak":true},{"text":"kɛ puɔ̀ nyɛdombiɛ,","poem":1},{"lineBreak":true},{"text":"kɛ duɔ̀ nkɛ̀ fɛtɑɑfɛ̀ nìù,","poem":1},{"lineBreak":true},{"text":"kɛ duɔ̀ nkɛ̀ tidiitì yìɛ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kɛ dɔ̀ɔ̀ mɛsɑ̀ɑ̀ ndibenni dimɔu,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ pɛ̃ɛ̃tɛ́ kɛ̀ɛ̀ bíɛ́kɛ̀ tidiitì mpíɛ́kɛ́.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kɛ̀ timútì yɛ̀ tɛdɔntɛ̀,","poem":1},{"lineBreak":true},{"text":"nɛ̀ yɛtɑ̃rɛ̀ ĩ́nkòo kɛ̀ dɛ̀ yɛ̀ nɑɑti.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Kɛ̀ iwũɔ̃ pìɛ́kɛ́ dinɑɑcɛ̃nhòò,","poem":1},{"lineBreak":true},{"text":"kɛ̀ tidiitì dɑ̀ɑ́tí kubiriku,","poem":1},{"lineBreak":true},{"text":"dɛmɔu kɛ̀ dɛ̀ yɑ̃̀nku kɛ íú.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/65.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/66.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/64.json","previousChapterAudioLinks":{},"numberOfVerses":14}