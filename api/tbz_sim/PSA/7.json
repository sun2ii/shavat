{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":7,"content":[{"type":"heading","content":["Dɑfiti dɔ́mɛ̀ Kuyie nhò kòńnɛ́"]},{"type":"verse","number":1,"content":["Fɛyɛ̀nfɛ̀ Dɑfiti dèntɛ̀ fɛ̀ Kuyie. Kuusi, Bɛnsɑmɛɛ wuɔ nkou kpɛ́í."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"N Yiɛ̀ nKuyie n sɔri fɔ̃́ɔ̃̀ borɛ̀,","poem":1},{"lineBreak":true},{"text":"n dɛɛtɛ́nɛ̀ bɛ̀ɛ̀ n fɛ̃́ũnko,","poem":1},{"lineBreak":true},{"text":"m pɑtɛ.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Bɛ̀ yɑ̀ɑ̀ bo n nɛ́tɛ́ dicìrícìrì kɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"dicìrícìrì ɔ̃ɔ̃ pĩ́mmɛ̀ kɛ́nɛ́tɛ́ bɑ́ òmɔù bɑ́ɑ́ fietɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"N Yiɛ̀ nKuyie, kɛ̀ m mɛ̀nkɛ dɔ̀ɔ̀ bɛ̀ n wɑ́tìrì tì","poem":1},{"lineBreak":true},{"text":"kɛ̀ m mɛ̀nkɛ cɑ̀ɑ̀rɛ̀,","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kɛ̀ n fɔ̀ɔ́ mmɛyɛi n wèè n dɔ̀ɔ̀ mɛyɛi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ nh ɛí n dùɔ̀ntɔbɛ̀ kpɛrɛ dɛtetìrɛ̀,","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"n dùɔ̀ntɔbɛ̀ɛ nni mbɛtì kɛ́ n nintɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́ n yɛ̃ɛ̃rɛ, kɛ́ n kuɔ,","poem":1},{"lineBreak":true},{"text":"kɛ́kũnnɛ́ n yètìrì mutɑ̃́ɑ̃́ mmiɛkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"N Yiɛ̀ nKuyie nyítɛ́ kɛ́cómmú,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ miɛkɛɛ bɛ̀ yɛ̀,","poem":1},{"lineBreak":true},{"text":"bɑɑo n dùɔ̀ntɔbɛ̀ bɛ̀ɛ̀ miɛkɛ n cɔ́ú,","poem":1},{"lineBreak":true},{"text":"n kónnɛ́ fɔ̃́ nwèè te tibeéntì.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ibotí imɔuu tíí nhɑ borɛ̀,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ mbo kɛĩ́nkɛ̀ kɛ ì bɑkɛ́.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuyie nfɔ̃́ nwèè bekùnɛ̀ ibotí,","poem":1},{"lineBreak":true},{"text":"n kónnɛ́ n nɑɑtí kpɛ́í,","poem":1},{"lineBreak":true},{"text":"n yí cɑ̀ɑ̀rɛ̀ dɛ̀mɑrɛ̀.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Cónnɛ́ bɛnitiyɛibɛ cɑɑ̀rìmɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ́kpénkùnnɛ bɛsɑ̀ɑ̀bɛ̀,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ nwèè yɛ̃́ bɛnìtìbɛ̀ yɛ̀mmɛ̀,","poem":1},{"lineBreak":true},{"text":"nɛ̀ bɛ yɛntotí,","poem":1},{"lineBreak":true},{"text":"ɑ tú Kuyie nku kɛ wenni.","poem":1}]},{"type":"line_break"},{"type":"verse","number":11,"content":[{"text":"Kuyie nkuù tu n kó kudɔpìkù,","poem":1},{"lineBreak":true},{"text":"kuù dɛɛrí bɛsɑ̀ɑ̀bɛ̀.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Kuyie nkuù bekùnɛ̀ timɔ́mmɔnti,","poem":1},{"lineBreak":true},{"text":"kɛ nɛ́ yóù sɑ̃́ɑ̃̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":13,"content":[{"text":"Kòo nitiyɛiwe í cèètɛ ò sɔ̃̀ṹ o siè ndi,","poem":1},{"lineBreak":true},{"text":"kɛ deenko o tɑ̃mmù.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ò mɑ̀ɑ́tí tìì kpɑ̀rìnɛntì yóó we nkuɔ,","poem":1},{"lineBreak":true},{"text":"ò sɔ̃̀ṹ ìì pie nyóó we ntɑ̃.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Ò kuɔ̀ mmɛyɛi nkó tipɔutì nti,","poem":1},{"lineBreak":true},{"text":"ò pùó mmɛsoùmmɛ̀ mmɛ,","poem":1},{"lineBreak":true},{"text":"kɛ yóó pɛitɛ́ siyɑ́ɑ̀bìsí.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Ò keù difɔ̃̀tìrì ndi kɛ dì cũmpùnko,","poem":1},{"lineBreak":true},{"text":"ò doti ò keú dìì fɔ̃̀tìrì miɛkɛ nkɛ.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ò dɔ̀ɔ̀ mɛ̀ɛ̀ yɛi ndoti o yuu ĩ́nkɛ̀ nkɛ,","poem":1},{"lineBreak":true},{"text":"ò yóù kùù yonku doti o tĩ́nnì ĩ́nkɛ̀ nkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":18,"content":[{"text":"N yó nsɑ̃ntímu n Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"kù tumɛ̀ timɔ́mmɔnti yiɛ̀,","poem":1},{"lineBreak":true},{"text":"n yó ndièmmu kɛ bie ntibómbonti,","poem":1},{"lineBreak":true},{"text":"kɛ dɛ́úkùnko Kuyie nkùù bɑkɛ́ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀ ku yètìrì.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/7.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/8.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/6.json","previousChapterAudioLinks":{},"numberOfVerses":18}