{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":75,"content":[{"type":"heading","content":["Kuyie nkuù tu obeéntì diɛwè"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Asɑfu yɛ̀nfɛ̀ nɛ̀ mɛtɑmmɛ̀ mɛ̀ɛ̀ tu: Bɑ́ɑ́ kuɔ."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie nti dɛ́úkùnko fɔ̃́ nwe,","poem":1},{"lineBreak":true},{"text":"ɑ yètìrì í yiɛ̀ ti nɔ̀ miɛkɛ,","poem":1},{"lineBreak":true},{"text":"ti nɑ́ɑ́mmu ɑ dɔ̀ɔ̀ mùù tɔ̃ndiɛmù.","poem":1}]},{"type":"line_break"},{"type":"verse","number":3,"content":[{"text":"Kɛ̀ Kuyie mbɛ́i nkɛ dɔ̀:","poem":1},{"lineBreak":true},{"text":"Mí nKuyie, kɛ̀ m mɔ̀nnì tùɔ̀kɛ,","poem":1},{"lineBreak":true},{"text":"n yó mbekù kɛ̀ dɛ̀ sìɛ́mu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kɛtenkɛ̀ sɑ̃̀ntimu nɛ̀ kɛ nìtìbɛ̀,","poem":1},{"lineBreak":true},{"text":"mí nKuyie míì fìí nkɛtenkɛ̀ sɑ̃ǹkɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"N nɑ̀kɛ́mu sipɔɔ yɛmbɛ̀ kɛ tú bɛ̀ bɑ́ mmɔkɛ sipɔɔ,","poem":1},{"lineBreak":true},{"text":"kɛ nɑ̀kɛ́ bɛyɛibɛ kɛ tú bɛ̀ɛ yóu sifeí.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛ bɑ́ nhéunko bɛ yɔ,","poem":1},{"lineBreak":true},{"text":"bɛ̀ bɑ́ nnɑ́ɑ́ ntipocɛ̃mmúnɑ́ɑǹtì.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Dɛ̀ í bonní diyiè yìɛ̀ní kɛ̀ɛ̀ bíɛ́kɛ̀ yoo diyiè tɑɑ̀ kɛ̀ɛ̀ bíɛ́kɛ̀,","poem":1},{"lineBreak":true},{"text":"dɛ̀ mɛ nyí bonní dikpɑ́ɑ̀ yoo yɛtɑ̃rɛ̀ ĩ́nkɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Dɛ̀ bonní Kuyie mborɛ̀ ndɛ̀,","poem":1},{"lineBreak":true},{"text":"kùù bekùnɛ̀ bɛnìtìbɛ̀","poem":1},{"lineBreak":true},{"text":"kuù ɔ̃ɔ̃ kɛ̃́kùnnɛ yie nkɛ́dɛ́úkùnnɛ otɔù.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ti Yiɛ̀ nKuyie mpikú fɛbòòfɛ̀ nfɛ,","poem":1},{"lineBreak":true},{"text":"nɛ̀ ku miɛkɛ kó mɛnɑɑ̀ nkperímɛ̀ kù kɔnnɛ́mɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ yóó mɛ̀ yɑutɛ́ bɛnitidɔnnibɛ̀ bɛmɔu,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ɛ mɛ̀ yɑ̃̀ kɛ́kúótóo nɛ̀ dɛfũ̀ɔ̃̀ kpɛrɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Mí nyó mpĩɛ̃kùmu sɑ̃́ɑ̃̀ ku yètìrì,","poem":1},{"lineBreak":true},{"text":"n yó ndièmmu kɛ sɑ̃ntí Kuyie Sɑkɔbu do tũ nkù.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"N yóó dɛitɛmu bɛyɛibɛ feí,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ wetí kɛ̀ bɛ̀ ndɛukú.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/75.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/76.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/74.json","previousChapterAudioLinks":{},"numberOfVerses":11}