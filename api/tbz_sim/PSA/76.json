{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":76,"content":[{"type":"heading","content":["Kuyie kuù nɔ nku dootitɔbɛ̀"]},{"type":"verse","number":1,"content":["Bɛdèmbɛ̀ kóo kótì dìèmmɛ̀ Asɑfu yɛ̀nfɛ̀ bɛ̀ dìè nfɛ̀ kɛ biennɛ̀ tibómbonti iwɛ̃ĩ kpɛti."]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Kuyie nyètìrì feímu Sudɑɑ kɔbɛ cuokɛ̀,","poem":1},{"lineBreak":true},{"text":"ku yètìrì dɛumu bɛmbɛ Isidɑyɛɛribɛ borɛ̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ku cĩ́ɛ̃̀tɛ̀ bo Sɑdɛmmu nwe","poem":1},{"lineBreak":true},{"text":"kù ɑ̃ Siyɔ̃ɔ̃ nwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Dɛǹdɛ Kuyie nkèkɛ́mɛ̀ bɛtɑ̃ntɑ̃ũbɛ̀ pie,","poem":1},{"lineBreak":true},{"text":"bɛ dɔpììtì nɛ̀ bɛ̀ kpɑ̀rìse, bɛ kpɑ̀rìnɛntì timɔu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"A nɑ́ɑ̀ ndɛumu nɛ̀ ɑ wenniku,","poem":1},{"lineBreak":true},{"text":"ɑ dɛumu kɛ pɛ̃ɛ̃tɛ́ yɛtɑ̃rɛ̀ yɛ̀ɛ̀ do bonɛ̀ dimɔ̀nnì.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Yɛkɔ̃m̀bɔ̀ yɛmbɛ̀ yɛ̃̀ nkɛ duɔ́mu kɛ̀ bɛ̀ bɛ̀ ɛí,","poem":1},{"lineBreak":true},{"text":"bɛkpɑ̀rìtiebɛ nɔu bɛ̀ìtɛ̀mu.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuyie nSɑkɔbu do tũ nkù kuù pɛ́i,","poem":1},{"lineBreak":true},{"text":"sikpɑ̀rìnɑɑsɛ̃ĩ́ nɛ̀ bɛhɑ̃ɑ̃pɔ̀nsɑ̃ndèèbɛ̀ kɛ̀ bɛ̀ yɛ̃̀ nkɛ duɔ́.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Kuyie nhɑ duò tikɔ̃m̀bùɔ̀tì nti,","poem":1},{"lineBreak":true},{"text":"kɑ̀ɑ miɛkɛ pɛikɛ dìì yiè we mbo dɑ́ɑ́tí kɛ́cómmú ɑ ììkɛ̀?","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kuyie nhɑ bo kɛĩ́nkɛ̀ nkɛ kɛ nɑ́ɑ́nní ɑ tɑ̃ɑ̃tɛ́ tì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kufɔ̃wɑɑ́ mpĩ kɛtenkɛ̀ kɔbɛ kɛ̀ bɛ̀ yɛ̃ nyúóó!","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"A ìtɛ́ dìì mɔ̀nnì kɛ bo bekɛ́nɛ̀ kutenkù,","poem":1},{"lineBreak":true},{"text":"kɛ́dɛɛtɛ́ bɛ̀ɛ̀ kɛ̃́kùnnɛ bɛmɑ́ɑ̀.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bɑ́ bɛnìtìbɛ̀ kó kɛmiɛkɛ kɛ̀ dɛ̀úkùnkomu ɑ yètìrì,","poem":1},{"lineBreak":true},{"text":"bɛ̀ɛ̀ bo cootɛ́ ɑ miɛkɛ bo pɛikɛ dìì yiè bɛ̀ bo ɑ̃nnɛ́ dibɑnni ɑ kpɛ́í.","poem":1}]},{"type":"line_break"},{"type":"verse","number":12,"content":[{"text":"Dí dɔúnnɛ̀ di Yiɛ̀ nKuyie nyɛnɔ̀ kɛ́ yɛ̀ dɔ̀ɔ̀,","poem":1},{"lineBreak":true},{"text":"díndi bɛ̀ɛ̀ kù tɔ̀kɛ́nɛ̀, pɑ̃mmúnɛ̀ ku yɛpɑ̃rɛ̀, kù duò tikɔ̃m̀bùɔ̀tì nti.","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Kuù kèkíí sikpɑ̀ɑ̀tìbìí kó muwemmu,","poem":1},{"lineBreak":true},{"text":"kutenkù kó bɛkpɑ̀ɑ̀tìbɛ̀ í kù dɑɑti.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/76.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/77.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/75.json","previousChapterAudioLinks":{},"numberOfVerses":13}