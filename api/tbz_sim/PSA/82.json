{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":82,"content":[{"type":"heading","content":["Kuyie nyóó bekɛ́nɛ̀mɛ̀ bɛbeényɛibɛ"]},{"type":"verse","number":1,"content":["Asɑfu kó fɛyɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Kuyie nyìtɛ́ kɛ còḿmúmu ku kó ditĩ̀nnì cuokɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ bekùnɛ̀ bɛ̀ɛ̀ tu bɛbeémbɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Dɛ̀ yó nkɑ̃́ɑ̃́kɛ́ dɛ kɛ̀ di yóu di bo ncɑɑ̀rimɛ̀ tibeéntì,","poem":1},{"lineBreak":true},{"text":"nɛ̀ di bo nkómmúmɛ̀ bɛyɛibɛ?","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Di ntũ nyikuɔ́ yɛ̃mmɛ̀ kɛ́nduɔ̀ bɛcĩ̀rìbɛ̀ nɛ̀ iciribí bɛ̀ dò nkɛ́nte dɛ̀,","poem":1},{"lineBreak":true},{"text":"di mbekùnɛ̀ bɛsénnìbɛ̀ nɛ̀ bɛcĩ̀rìbɛ̀ dɛ̀ bèkúmɛ̀.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Ndɛɛrínnɛ̀ bɛsénìbɛ̀ nɛ̀ bɛcĩ̀rìbɛ̀,","poem":1},{"lineBreak":true},{"text":"fietɛnɛ̀ bɛ bɛyɛibɛ nɔu miɛkɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Di í yɛ̃́ dɛ̀mɑrɛ̀, di í ciì,","poem":1},{"lineBreak":true},{"text":"di kérí dibiìnnì miɛkɛ nkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kɛtenkɛ̀ kó dipũũ dimɔu sɑ̃̀ntɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"M bɛ́immu kɛ tú: Di tú kɛĩ́nkɛ̀ kɔbɛ mbɛ,","poem":1},{"lineBreak":true},{"text":"kɛ tú di mɔu Kuyie nkùù bɑkɛ́ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀ ku kó ibí.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Di yóó kú bɛnìtìbɛ̀ kɔ̃mɛ mmɛ,","poem":1},{"lineBreak":true},{"text":"di yóó duómu dimɔu sikpɑ̀ɑ̀tìbìí kɔ̃mɛ.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ti Yiɛ̀ nKuyie nyítɛ́ kɛ́bekɛ́nɛ̀ kutenkù,","poem":1},{"lineBreak":true},{"text":"kɛ yɛ̃́ fɔ̃́ɔ̃̀ temɛ̀ yɛbotɛ̀ yɛmɔu.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/82.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/83.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/81.json","previousChapterAudioLinks":{},"numberOfVerses":8}