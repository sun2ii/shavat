tóo bɛ fɛhɑ̃ɑ̃dɛɛ̀nfɛ̀ ɔ̃ɔ̃ dɛ́útóomɛ̀ ditɑ̃rì.","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"Bɛti bɛ nɛ̀ kuyɑɑkù nɛ̀ fɛtɑɑfɛ̀,","poem":1},{"lineBreak":true},{"text":"donnɛ́ bɛ kɔ̃m̀bùɔ̀tì nɛ̀ kuyɑɑkperíkù.","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ãnnɛ́ bɛ ifɛi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ dɛ̀ɛ yie nkɛ̀ bɛ̀ dɑ wɑmmú fɔ̃́ nti Yiɛ̀ nKuyie.","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Yóu kɛ̀ bɛ̀ɛ di ifɛi,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ kɔ̃m̀bùɔ̀tì nduò sɑ̃́ɑ̃̀,","poem":1},{"lineBreak":true},{"text":"yóu kɛ̀ dɛ̀ɛ bɛ̀ di,","poem":1},{"lineBreak":true},{"text":"kɛ̀ bɛ̀ɛ kú.","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"Kɛ̀ bɛ̀ɛ bɑntɛ́ kɛ do nfɔ̃́ɔ̃̀ mɑ́ɑ̀ yètìrì tu ti Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"kɛ̀ fɔ̃́ɔ̃̀ bɑkɛ́ kɛtenkɛ̀ nɛ̀ kɛĩ́nkɛ̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/83.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/84.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/82.json","previousChapterAudioLinks":{},"numberOfVerses":19}