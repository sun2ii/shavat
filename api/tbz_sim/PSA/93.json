{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":93,"content":[{"type":"heading","content":["Kuyie nkuù tu okpɑ̀ɑ̀tì"]},{"type":"verse","number":1,"content":[{"text":"Kuyie nkuù tu okpɑ̀ɑ̀tì, tikpɑ̀tì tiì tu ku kó diyɑɑ̀bòrì,","poem":1},{"lineBreak":true},{"text":"kɛ̀ muwɛ̃rímú tú ku nɑɑ̀kɔ̃̀nfɛ̀.","poem":1},{"lineBreak":true},{"text":"Dɛɛ̀ te kɛ̀ kɛtenkɛ̀ fìíkú bɛ́ù bɑ́ kɛ í nɑmpú.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Ti Yiɛ̀ nKuyie, ɑ kpɑ̀tì í mɔkɛ tì ketɛ́ dɛ̀ tì mɛ nyí mɔkɛ kumɑ̀nku.","poem":1},{"lineBreak":true},{"text":"A bo nɛ̀ dimɔ̀nnì ndi kɛ yó mbo sɑ̃́ɑ̃̀.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nyikó mpíɛmmu kɛ uuti,","poem":1},{"lineBreak":true},{"text":"kɛ̀ yɛnɛ́fĩ̀nfĩ̀rɛ̀ iiti,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kutoweku dɑ́ɑ́tí.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A mɛ ndɛumu kɛ pɛ̃ɛ̃tɛ́ mɛniɛ nkó kunɔɔdoo,","poem":1},{"lineBreak":true},{"text":"kɛ pɛ̃ɛ̃tɛ́ dɑ̀mɛ́ɛ̀rì kó yɛnɛ́fĩ̀nfĩ̀rɛ̀.","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nhɑ bomu nkɛĩ́nkɛ̀ kɛ pɛ̃ɛ̃tɛ́ dɛndɛ kó dimɑ̀ɑ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ti Yiɛ̀ nKuyie nhɑ kuɔ́ tú imɔ́mmɔnyi nyi,","poem":1},{"lineBreak":true},{"text":"ɑ cĩ́ɛ̃̀tɛ̀ sɑ̀mu kɛ yóó nsɑ̀ sɑ̃́ɑ̃̀.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/93.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/94.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/92.json","previousChapterAudioLinks":{},"numberOfVerses":5}