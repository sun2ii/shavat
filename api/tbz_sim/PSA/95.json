{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":95,"content":[{"type":"heading","content":["Tí kɔtɛnɛ̀ Kuyie ncĩ́ɛ̃̀tɛ̀ nɛ̀ diwɛ̀ì"]},{"type":"verse","number":1,"content":[{"text":"Ti kɔtɛnɛ̀ kɛ́nsɑ̃ntí ti Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"diwɛ̀ì nti bonɛ̀ ti Yiɛ̀ nKuyie nkɛ̀ ti nyíútí,","poem":1},{"lineBreak":true},{"text":"kuù tu ti kó dipèrì dìì ti dɛɛrí.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ti kɔtɛnɛ̀ ku cĩ́ɛ̃̀tɛ̀ kɛ kù sɑ̃ntɛ,","poem":1},{"lineBreak":true},{"text":"kɛ́mpíɛ́tí kɛ bie ndɛbémbénnɛ̀ nɛ̀ diwɛ̀ì.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie ndɛumu,","poem":1},{"lineBreak":true},{"text":"kù tu okpɑ̀ɑ̀tì diɛwè nwe kɛ kpeńnìnɛ̀ yɛbɔkɛ̀ yɛmɔu.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuù bɑkɛ́ kɛtenkɛ̀ nɛ̀ kɛ cũmpumɛ,","poem":1},{"lineBreak":true},{"text":"yɛtɑ̃rɛ̀ nɛ̀ yɛ yómmɛ̀.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Kuù dɔ̀ɔ̀ dɑ̀mɛ́ɛ̀rì kɛ̀ kuù ò te.","poem":1},{"lineBreak":true},{"text":"Kuù pìítɛ́ kɛtenkɛ̀ nɛ̀ ku nɔu.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Tí tɑnnɛ̀ ku cĩ́ɛ̃̀tɛ̀ kɛ́nínkú kɛ́sĩ́nnɛ́ kɛ́kɔ̃nkɛ,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nkùù ti dɔ̀ɔ̀ ku ììkɛ̀.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kuù ti te kɛ̀ ti tú ku nìtìbɛ̀ kù cɛ̃mmú bɛ̀,","poem":1},{"lineBreak":true},{"text":"tipìètì kù kpɑ̀ɑkɛ tì nɛ̀ ku nɔ̀ùtɛ̀.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ Kuyie ndi bɛ́innɛ̀ yíe","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"di bɑɑ́ kpénkùnnɛ di to,","poem":1},{"lineBreak":true},{"text":"di yɛmbɛ̀ do dɔ̀ɔrimɛ̀ Mɛdibɑ.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ do dɔ̀ɔ̀ dɛ̀ diyiè mɑrì Mɑsɑ kó dikpɑ́ɑ̀ miɛkɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Di yɛmbɛ̀ do kù bennɛ́mu,","poem":1},{"lineBreak":true},{"text":"bɛ̀ do dɛ nkù yɑ̀ɑ́kɛ́ bɑ́ nɛ̀ bɛ̀ do mɛ nyɑ̀mɛ̀ kù pĩ mùù tɔ̃mmú.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Yɛbie nsipísìnɑ̀ɑ̀ miɛkɛ kɛ̀ kùu bɛ̀ pɛ̃̀,","poem":1},{"lineBreak":true},{"text":"kɛ bɛ́i nkɛ dɔ̀ ku mbotí yɛ̀mmɛ̀ mɛɛ̀ kù dɛ̀tɛ́nɛ̀ bɑ́ bɛ̀ í yie ku kpɛti.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Mɛmmɛ kɛ̀ ku miɛkɛɛ bɛ̀ pɛikɛ kɛ̀ kùu bɛ́i nkɛ́pɑrìkɛ̀ kɛ yĩ́","poem":1},{"lineBreak":true},{"text":"bɛ̀ í tɑti ku ɛì mɛom̀pùmɛ̀ kpɛri.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/95.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/96.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/94.json","previousChapterAudioLinks":{},"numberOfVerses":11}