{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":97,"content":[{"type":"heading","content":["Kuyie mbɑkɛ́mɛ̀ kutenkù kumɔu"]},{"type":"verse","number":1,"content":[{"text":"Ti Yiɛ̀ nKuyie nkuù tu okpɑ̀ɑ̀tì,","poem":1},{"lineBreak":true},{"text":"kɛtenkɛ̀ kɛmɔu kɔbɛ nyɑ̃nkunɛ̀,","poem":1},{"lineBreak":true},{"text":"yɛhɛkɛ̀ dɛ́tiyɛ̀ kɔbɛ nhɑunɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":2,"content":[{"text":"Diwɛtirì nɛ̀ dibiìnnì dɛɛ̀ kù fitɛ́,","poem":1},{"lineBreak":true},{"text":"kù bɑkɛ́ kɛ̀ dɛ̀ wennimu kɛ̀ ku beéntì sìɛ́.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Muhɑ̃ɑ̃́ mmuù ni ku ììkɛ̀ kɛ kérí,","poem":1},{"lineBreak":true},{"text":"kɛ tɔntì ku dùɔ̀ntɔbɛ̀ bɛ̀ɛ̀ kù fitɛ́.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"Kuù duɔ́ nkɛ̀ fɛtɑɑfɛ̀ mìí nkutenkù,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kutenkù kɔbɛ dɛ̀ yɑ̀u kɛ kpeutí.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Yɛtɑ̃rɛ̀ yìɛ̀rimu ti Yiɛ̀ nKuyie nyììkɛ̀ mɛkùɔ̀ nkɔ̃mɛ,","poem":1},{"lineBreak":true},{"text":"kunku ti Yiɛ̀ nKuyie nkùù bɑkɛ́ kutenkù kumɔu ku ììkɛ̀.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Kɛĩ́nkɛ̀ nɑ̀ɑ́mmu Kuyie ntumɛ̀ timɔ́mmɔnti yiɛ̀,","poem":1},{"lineBreak":true},{"text":"kɛ̀ yɛbotɛ̀ yɑ̀ ku kó tikpetì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":7,"content":[{"text":"Bɛbɔɔféúbɛ̀ bɛmɔu ifɛi bo bɛ̀ pĩ́.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ɛ̀ pɔ̀tìnɛ̀ yɛbɔkɛ̀ nɛ̀ sitenkɑɑnìi.","poem":1},{"lineBreak":true},{"text":"Díndi yɛbɔkɛ̀ dimɔu nínkúnɛ̀ ti Yiɛ̀ nKuyie nyììkɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nhɑ dɔ̀ɔ̀ tì,","poem":1},{"lineBreak":true},{"text":"Siyɔ̃ɔ̃ kɔbɛ ti kèèmu kɛ̀ diwɛ̀ì bɛ̀ bo,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Sudɑɑ kɔbɛ ti kèè kɛ yɑ̃nku.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Kɛtenkɛ̀ kɛmɔu duɔ́mɛ̀,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nfɔ̃́ɔ̃̀ bɑkɛ́ kɛĩ́nkɛ̀ nɛ̀ kɛtenkɛ̀ kɛmɔu,","poem":1},{"lineBreak":true},{"text":"ɑ pɛ̃ɛ̃tɛ́mu yɛbɔkɛ̀ yɛmɔu.","poem":1}]},{"type":"line_break"},{"type":"verse","number":10,"content":[{"text":"Díndi bɛ̀ɛ̀ dɔ́ ti Yiɛ̀ nKuyie, nníínnɛ̀ mɛyɛi.","poem":1},{"lineBreak":true},{"text":"Kuù kɑ̃nkɛ́ ku kɔbɛ,","poem":1},{"lineBreak":true},{"text":"kɛ bɛ̀ dɛɛrínɛ̀ bɛyɛibɛ.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Bɛ̀ɛ̀ dɔ̀ɔ̀ri timɔ́mmɔnti kuwenniku kuù ɔ̃ mbɛ̀ mí.","poem":1},{"lineBreak":true},{"text":"Bɛ̀ɛ̀ yɛ̀mmɛ̀ wenni bɛ̀ ɔ̃ mmɔkɛmu ndiwɛ̀ì.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Díndi bɛ̀ɛ̀ dɔ̀ɔ̀ri timɔ́mmɔnti nyɑ̃nkunɛ̀,","poem":1},{"lineBreak":true},{"text":"nsɑ̃ntínɛ̀ ku kɛ dɛ́úkùnko ku yètìrì, kù do mpɑ́íí nwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/97.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/98.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/96.json","previousChapterAudioLinks":{},"numberOfVerses":12}