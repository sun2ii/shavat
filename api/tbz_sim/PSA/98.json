{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":98,"content":[{"type":"heading","content":["Piɛtɛnɛ̀ ti Yiɛ̀ nKuyie"]},{"type":"verse","number":1,"content":["Fɛyɛ̀nfɛ̀.",{"lineBreak":true},{"text":"Dentɛ̀nɛ̀ ti Yiɛ̀ nKuyie fɛyɛmpɑ̀nfɛ̀, kù dɔ̀ɔ̀ tìì diɛtì kpɛ́í.","poem":1},{"lineBreak":true},{"text":"Nɛ̀ ku wɛ̃rímú diɛmù mmu kù dɛɛrímɛ̀.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie mbɛnkɛmu kutenkù kù dɛɛrímɛ̀.","poem":1},{"lineBreak":true},{"text":"Kuù bɛnkɛ yɛbotɛ̀ kù dɔ̀ɔ̀rimɛ̀ timɔ́mmɔnti.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Kù í yɛ̃̀ mmɛsɑ̀ɑ̀ kù do yɛ̃ nkù yóó dɔɔ̀mɛ̀ Isidɑyɛɛribɛ,","poem":1},{"lineBreak":true},{"text":"kù pĩ̀ḿmu kù bɛ́i ntì.","poem":1},{"lineBreak":true},{"text":"Itemmɑ̀nkɛ imɔu kɔbɛ yɑ̀mu,","poem":1},{"lineBreak":true},{"text":"Kuyie nkùù ti te kù ti dɛɛtɛ́mɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":4,"content":[{"text":"Kutenkù kumɔu kɔbɛ piɛtɛnɛ̀ ti Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"ndiènnɛ̀ kɛ íú.","poem":1}]},{"type":"verse","number":5,"content":[{"lineBreak":true},{"text":"Mbiennɛ̀ kukùtìdùkù kɛ dɛ́úkùnko ti Yiɛ̀ nKuyie,","poem":1},{"lineBreak":true},{"text":"kɛ́mbie ntibómbonti kɛ diè.","poem":1}]},{"type":"verse","number":6,"content":[{"lineBreak":true},{"text":"Ndɛ́úkùnkonɛ̀ ku nɛ̀ siheú, nɛ̀ yɛtɑ̃tɛhe.","poem":1},{"lineBreak":true},{"text":"Piɛtɛnɛ̀ ti Yiɛ̀ nKuyie nkuù tu okpɑ̀ɑ̀tì.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Fɔ̃́ ndɑ̀mɛ́ɛ̀rì yɔ̃ɔ̃tɛ̀ nɛ̀ ɑ mɔkɛ dɛ̀ dɛmɔu.","poem":1},{"lineBreak":true},{"text":"Kɛtenkɛ̀ nɛ̀ dɛ̀ɛ̀ kó dimɑ̀ɑ̀ bo ɑ miɛkɛ nyɑ̃nkunɛ̀.","poem":1}]},{"type":"verse","number":8,"content":[{"lineBreak":true},{"text":"Díndi ikó, mpotɛ́nɛ̀ tipíɛ́tì.","poem":1},{"lineBreak":true},{"text":"Díndi yɛtɑ̃rɛ̀ kɛ̀ di wɛ̃nnɛ́ kɛ́iitɛ.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nkèrínímu kɛ yóó bekɛ́nɛ̀ kutenkù.","poem":1},{"lineBreak":true},{"text":"Kuù yóó bekɛ́nɛ̀ kutenkù kɛ̀ dɛ̀ nwenni.","poem":1},{"lineBreak":true},{"text":"Kuù yóó bekɛ́nɛ̀ yɛbotɛ̀ sɛ́i.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/98.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/99.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/97.json","previousChapterAudioLinks":{},"numberOfVerses":9}