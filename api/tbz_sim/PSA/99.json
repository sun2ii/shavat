{"translation":{"id":"tbz_sim","name":"Bibiri Kuyie Nnɑ́ɑǹtì Pɑ́tíri","website":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tbzsim","licenseNotes":null,"shortName":"SIM","englishName":"Ditammari Bible","language":"tbz","textDirection":"ltr","sha256":"d88b7700359bc232026629ebd6f53083b005b514580728f99c4bd75c359bea91","availableFormats":["json"],"listOfBooksApiLink":"/api/tbz_sim/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":30873,"languageName":"Ditammari","languageEnglishName":"Ditammari"},"book":{"id":"PSA","translationId":"tbz_sim","name":"Yɛsɑ̃ɑ̃","commonName":"Yɛsɑ̃ɑ̃","title":"Yɛsɑ̃ɑ̃","order":19,"numberOfChapters":150,"sha256":"951c714e7a98316fad599580ce7396103ecb9ac2e9ec18dd6532ce58d0c09eaa","firstChapterNumber":1,"firstChapterApiLink":"/api/tbz_sim/PSA/1.json","lastChapterNumber":150,"lastChapterApiLink":"/api/tbz_sim/PSA/150.json","totalNumberOfVerses":2523},"chapter":{"number":99,"content":[{"type":"heading","content":["Ti Yiɛ̀ nKuyie ti kóo kpɑ̀ɑ̀tì dò mpɑ́íí nwe"]},{"type":"verse","number":1,"content":[{"text":"Ti Yiɛ̀ nKuyie nkuù tu okpɑ̀ɑ̀tì kɛ̀ yɛbotɛ̀ kɔ̃̀ntì ɑu.","poem":1},{"lineBreak":true},{"text":"Kù kɑ̀ri ku kpɑ̀ɑ̀tìkɑ̀rì bɛĩ́nkɛ̀mbɑ̀rìbɛ̀ cuokɛ̀ nkɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ kɛtenkɛ̀ sɑ̃̀nti.","poem":1}]},{"type":"verse","number":2,"content":[{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie nyètìrì dɛumu Siyɔ̃ɔ̃ ɛì miɛkɛ.","poem":1},{"lineBreak":true},{"text":"Kù dɛumu kɛ̀ kuù bɑkɛ́ yɛbotɛ̀ yɛmɔu.","poem":1}]},{"type":"verse","number":3,"content":[{"lineBreak":true},{"text":"Nsɑ̃ntínɛ̀ ti Yiɛ̀ nKuyie, ku yètìrì dɛumu,","poem":1},{"lineBreak":true},{"text":"kɛ duò tikɔ̃m̀bùɔ̀tì kù dò mpɑ́íí nwe.","poem":1}]},{"type":"verse","number":4,"content":[{"lineBreak":true},{"text":"A kpeńnìmu kɛ tú okpɑ̀ɑ̀tì wèè dɔ́ tibeéntì sɑ̀ɑ̀tì,","poem":1},{"lineBreak":true},{"text":"ti Yiɛ̀ nKuyie nfɔ̃́ɔ̃̀ ti bɛnkɛ kucɛ kùù sìɛ́.","poem":1},{"lineBreak":true},{"text":"Fɔ̃́ɔ̃̀ bɛnkɛ timɔ́mmɔnti Sɑkɔbu yɑɑ̀bí cuokɛ̀.","poem":1}]},{"type":"line_break"},{"type":"verse","number":5,"content":[{"text":"Ndɛ́úkùnkonɛ̀ ti Yiɛ̀ nKuyie nyètìrì.","poem":1},{"lineBreak":true},{"text":"Nínkúnɛ̀ ku kpɑ̀ɑ̀tìkɑ̀rì ììkɛ̀ kɛ́kɔ̃nkɛ, kù dò mpɑ́íí nwe.","poem":1}]},{"type":"line_break"},{"type":"verse","number":6,"content":[{"text":"Mɔyiisi nɛ̀ Anɔɔ bɛ̀ do tú Kuyie nkuɔ́ nìùbɛ̀ mbɛ,","poem":1},{"lineBreak":true},{"text":"kɛ̀ Sɑmmuyɛɛri ntú wèè bɑ̀ɑ́ nKuyie.","poem":1},{"lineBreak":true},{"text":"Bɛɛ̀ do ɔ̃ɔ̃ yú Kuyie nkɛ̀ kùu yie.","poem":1}]},{"type":"verse","number":7,"content":[{"lineBreak":true},{"text":"Kù do bɛ̀ nɑ̀ɑ́nnɛ̀nní diwɛtirì miɛkɛ nkɛ.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ bɛ̀ nyíé nku tɑnnɔ̀ kɛ pĩ́ nku kuɔ́ kù bɛ̀ duɔ́ nyì.","poem":1}]},{"type":"line_break"},{"type":"verse","number":8,"content":[{"text":"Ti Yiɛ̀ nKuyie, bɛ̀ do ɔ̃ ndɑ nɑ́ɑ́nnɛ̀ kɑ̀ɑ bɛ̀ cɔ̀úmmu,","poem":1},{"lineBreak":true},{"text":"fɔ̃́ nKuyie nkɛ bɛ̀ cĩ́ɛ̃́mmu bɛ yɛi.","poem":1},{"lineBreak":true},{"text":"Kɛ̀ bɛ̀ cɑ̀ɑ̀rɛ̀ ɑ nɛ́ yṹɔ̃́ mbɛ to.","poem":1}]},{"type":"line_break"},{"type":"verse","number":9,"content":[{"text":"Ndɛ́úkùnkonɛ̀ ti Yiɛ̀ nKuyie nyètìrì.","poem":1},{"lineBreak":true},{"text":"Nínkúnɛ̀ ku tɑ̃sɑ̀ɑ̀rì ĩ́nkɛ̀.","poem":1},{"lineBreak":true},{"text":"Ti Yiɛ̀ nKuyie ndò mpɑ́íí nwe.","poem":1}]}],"footnotes":[]},"thisChapterLink":"/api/tbz_sim/PSA/99.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tbz_sim/PSA/100.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tbz_sim/PSA/98.json","previousChapterAudioLinks":{},"numberOfVerses":9}