{"translation":{"id":"tdx_sle","name":"Saontsin’ Añahare","website":"https://ebible.org/Scriptures/details.php?id=tdx","licenseUrl":"https://ebible.org/Scriptures/details.php?id=tdx","licenseNotes":null,"shortName":"SLE","englishName":"Tandroy Bible","language":"tdx","textDirection":"ltr","sha256":"0c9caa8e10cda2749d73e34d7926608b9f73079eae1a0743c09b8a71ed8639df","availableFormats":["json"],"listOfBooksApiLink":"/api/tdx_sle/books.json","numberOfBooks":66,"totalNumberOfChapters":1189,"totalNumberOfVerses":31081,"languageName":"Tandroy-Mahafaly Malagasy","languageEnglishName":"Tandroy-Mahafaly Malagasy"},"book":{"id":"1CH","translationId":"tdx_sle","name":"Fiantoñoñe I","commonName":"Fiantoñoñe I","title":"Fiantoñoñe I","order":13,"numberOfChapters":29,"sha256":"5de1e58bde5dc2184db29c3d6a5d6d4cc4e5517088cd5157257837b5e649ceec","firstChapterNumber":1,"firstChapterApiLink":"/api/tdx_sle/1CH/1.json","lastChapterNumber":29,"lastChapterApiLink":"/api/tdx_sle/1CH/29.json","totalNumberOfVerses":941},"chapter":{"number":16,"content":[{"type":"verse","number":1,"content":["Aa le nendese’ iareo i vatan’ Añaharey naho najadoñe amy kivoho nihen­tseña’ i Davide ao vaho nañenga soroñe miharo engam-panintsiñañe añatrefan’ Añahare."]},{"type":"verse","number":2,"content":["Ie nihenefe’ i Davide ty fañengàñe o soroñe naho engam-panintsiñañeo, le nitatae’e ondatio ami’ty tahina’ Iehovà."]},{"type":"verse","number":3,"content":["Le nanjotsoa’e iaby t’Israele, hene ondaty naho roa­kemba, ty vonga-mofo naho venten-kena vaho ty garatom-baloboke maike."]},{"type":"verse","number":4,"content":["Tinendre’e hito­roñe añatrefa’ i vata’ Iehovày ty ila’ o nte-Levio haniahy naho hañandriañe vaho handrenge Iehovà Andrianañahare’ Israele."]},{"type":"verse","number":5,"content":["I Asafe ty talè, faharoe’e t’i Zekarià, Ieiele naho i Semiramote naho Iehiele naho i Matitià naho i Eliabe naho i Benaià naho i Ovededome naho Ieiele ro aman-jejobory naho talivalo; vaho nipoña-peo am-pikarantsañe t’i Asafe;"]},{"type":"verse","number":6,"content":["le nampipopò trompetra nainai’e añatrefa’ i vatam-pañinan’ Añaharey t’i Benaià naho Iakaziele."]},{"type":"verse","number":7,"content":["Amy andro zay ty nañoriza’ i Davide ty fañandriañañe am’ Iehovà, am-pità’ i Asafe naho o longo’eo."]},{"type":"verse","number":8,"content":[{"text":"Ehe andriaño t’Iehovà, kanjio ty tahina’e;","poem":1},{"lineBreak":true},{"text":"ampahafohino ondatio o fitoloña’eo.","poem":1}]},{"type":"verse","number":9,"content":[{"lineBreak":true},{"text":"Isabo, irengeo an-takasy;","poem":1},{"lineBreak":true},{"text":"taroño am’ondatio","poem":1},{"lineBreak":true},{"text":"ze hene fitoloña’e fanjaka.","poem":1}]},{"type":"verse","number":10,"content":[{"lineBreak":true},{"text":"Mitrèña amy tahina’e masiñey;","poem":1},{"lineBreak":true},{"text":"ampirebeho ty arofo’","poem":1},{"lineBreak":true},{"text":"o mipay Iehovào.","poem":1}]},{"type":"verse","number":11,"content":[{"lineBreak":true},{"text":"Hotsohotsò t’Iehovà naho o haozara’eo,","poem":1},{"lineBreak":true},{"text":"tsoeho nainai’e i lahara’ey.","poem":1}]},{"type":"verse","number":12,"content":[{"lineBreak":true},{"text":"Tiahio o fitoloñañe fanjaka nanoe’eo,","poem":1},{"lineBreak":true},{"text":"o raha tsitantaneo,","poem":1},{"lineBreak":true},{"text":"naho o fizakàm-palie’eo,","poem":1}]},{"type":"verse","number":13,"content":[{"lineBreak":true},{"text":"Ry tarira’ Israele mpitoro’eo,","poem":1},{"lineBreak":true},{"text":"ry ana’ Iakobe jinobo’eo.","poem":1}]},{"type":"verse","number":14,"content":[{"lineBreak":true},{"text":"Ie t’Iehovà Andrianañaharentika;","poem":1},{"lineBreak":true},{"text":"manitsike ty tane toy o fizakà’eo.","poem":1}]},{"type":"verse","number":15,"content":[{"lineBreak":true},{"text":"Tiahio nainai’e i fañina’ey;","poem":1},{"lineBreak":true},{"text":"i tsara linili’e ami’ty","poem":1},{"lineBreak":true},{"text":"tariratse faharivo’ey;","poem":1}]},{"type":"verse","number":16,"content":[{"lineBreak":true},{"text":"I nanoe’e amy Avrahamey,","poem":1},{"lineBreak":true},{"text":"naho i nifantà’e am’ Ietsàkey;","poem":1}]},{"type":"verse","number":17,"content":[{"lineBreak":true},{"text":"Ie niventè’e am’ Iakobe ho lily,","poem":1},{"lineBreak":true},{"text":"naho am’Israele ho fañina tsy modo,","poem":1}]},{"type":"verse","number":18,"content":[{"lineBreak":true},{"text":"Ami’ty hoe: Ihe ty hitolorako","poem":1},{"lineBreak":true},{"text":"ty tane’ i Kanàne, ho anjara lova’o;","poem":1}]},{"type":"verse","number":19,"content":[{"lineBreak":true},{"text":"ie mbe tsy niampeampe,","poem":1},{"lineBreak":true},{"text":"toe potrapotra’e naho renetane ama’e ao.","poem":1}]},{"type":"verse","number":20,"content":[{"lineBreak":true},{"text":"Aa ie nirererere mb’an-tane mb’an-tane naho boak’ ami’ty fiheheañe,","poem":1},{"lineBreak":true},{"text":"pak’ am-borizañe ila’e,","poem":1}]},{"type":"verse","number":21,"content":[{"lineBreak":true},{"text":"Le tsy napo’e ho joie’ondatio;","poem":1},{"lineBreak":true},{"text":"eka, iereo ty nañendaha’e mpanjaka ami’ty hoe:","poem":1}]},{"type":"verse","number":22,"content":[{"lineBreak":true},{"text":"Ko tsapae’o o norizakoo,","poem":1},{"lineBreak":true},{"text":"naho ko joie’o o mpitokikoo.","poem":1}]},{"type":"verse","number":23,"content":[{"lineBreak":true},{"text":"Misaboa am’ Iehovà ry tane toy iaby;","poem":1},{"lineBreak":true},{"text":"talilio boak’ andro boak’ andro","poem":1},{"lineBreak":true},{"text":"ty hasoa’ i fandrombaha’ey.","poem":1}]},{"type":"verse","number":24,"content":[{"lineBreak":true},{"text":"Tseizo amo kilakila’ndatio ty enge’e;","poem":1},{"lineBreak":true},{"text":"o fitoloña’e fanjakao","poem":1},{"lineBreak":true},{"text":"amo kilakila ondatio.","poem":1}]},{"type":"verse","number":25,"content":[{"lineBreak":true},{"text":"Amy te ra’elahy t’Iehovà,","poem":1},{"lineBreak":true},{"text":"ho rengèñe añ’abo; hañeveñan-dre","poem":1},{"lineBreak":true},{"text":"te amo ‘ndrahare ila’e iabio.","poem":1}]},{"type":"verse","number":26,"content":[{"lineBreak":true},{"text":"Toe kafoake iaby ze ndrahare’ ondatio;","poem":1},{"lineBreak":true},{"text":"Iehovà ty namboatse o likerañeo","poem":1},{"noteId":11},{"text":".","poem":1}]},{"type":"verse","number":27,"content":[{"lineBreak":true},{"text":"Engeñe naho asiñe ro añatrefa’e eo,","poem":1},{"lineBreak":true},{"text":"haozarañe naho hafaleañe ro an-toe’e ao.","poem":1}]},{"type":"verse","number":28,"content":[{"lineBreak":true},{"text":"Manolora am’ Iehovà","poem":1},{"lineBreak":true},{"text":"ry fifokoa’ ondatio,","poem":1},{"lineBreak":true},{"text":"atoloro am’ Iehovà ty engeñe","poem":1},{"lineBreak":true},{"text":"naho haozarañe.","poem":1}]},{"type":"verse","number":29,"content":[{"lineBreak":true},{"text":"Atoloro am’ Iehovà ty engeñe","poem":1},{"lineBreak":true},{"text":"mañeva i tahina’ey;","poem":1},{"lineBreak":true},{"text":"añandeso engeñe, le iatrefo,","poem":1},{"lineBreak":true},{"text":"mitalahoa am’ Iehovà","poem":1},{"lineBreak":true},{"text":"am-pibangoañe miavake.","poem":1}]},{"type":"verse","number":30,"content":[{"lineBreak":true},{"text":"Minevenevera ama’e ry tane toy iaby;","poem":1},{"lineBreak":true},{"text":"toe mijadoñe ty voatse toy,","poem":1},{"lineBreak":true},{"text":"tsy hasitsìtse.","poem":1}]},{"type":"verse","number":31,"content":[{"lineBreak":true},{"text":"Ampiehafo o andindiñeo,","poem":1},{"lineBreak":true},{"text":"ampirebeho ty tane toy;","poem":1},{"lineBreak":true},{"text":"ampitaroño amo kilakila’ondatio te","poem":1},{"lineBreak":true},{"text":"mifehe t’Iehovà!","poem":1}]},{"type":"verse","number":32,"content":[{"lineBreak":true},{"text":"Ampitroño i riakey an-kalifora’e,","poem":1},{"lineBreak":true},{"text":"ampandiao taroba i hivokey,","poem":1},{"lineBreak":true},{"text":"naho ze hene ama’e ao.","poem":1}]},{"type":"verse","number":33,"content":[{"lineBreak":true},{"text":"Le hisabo an-kafaleañe añatrefa’ Iehovà o hatae añ’alao,","poem":1},{"lineBreak":true},{"text":"Ie hitotsake eo hizaka ty tane toy.","poem":1}]},{"type":"verse","number":34,"content":[{"lineBreak":true},{"text":"Andriaño t’Iehovà, amy te ie ro soa;","poem":1},{"lineBreak":true},{"text":"nainai’e ty fiferenaiña’e.","poem":1}]},{"type":"verse","number":35,"content":[{"lineBreak":true},{"text":"Le ano ty hoe: Rombaho zahay, ry Andrianañaharem-pandrombaha’ay,","poem":1},{"lineBreak":true},{"text":"le atontono vaho avotsoro","poem":1},{"lineBreak":true},{"text":"amo kilakila ondatio,","poem":1},{"lineBreak":true},{"text":"hañandriaña’ay i tahina’o masiñey,","poem":1},{"lineBreak":true},{"text":"hitreña’ay azo am-pandrengeañe.","poem":1}]},{"type":"verse","number":36,"content":[{"lineBreak":true},{"text":"Andriañeñe t’Iehovà,","poem":1},{"lineBreak":true},{"text":"Andrianañahare’ Israele,","poem":1},{"lineBreak":true},{"text":"boak’ an-kaehae’e pake haehae añe.","poem":1},"hene nirihoñe ty hoe ondatio: Amène vaho nandrenge Iehovà."]},{"type":"verse","number":37,"content":["Aa le nenga’e añatrefa’ i vatam-pañina’ Iehovày t’i Asafe mirolongo, hitoroñe añatrefa’ i vatay nainai’e, amy ze fitoloñañe mañeva ty andro;"]},{"type":"verse","number":38,"content":["i Ovededome naho o rahalahi’eo: enempolo-valo amby; naho i Ovede­dome ana’ Ieditone naho i Kosà ro mpañamben-dalañe;"]},{"type":"verse","number":39,"content":["i Tsadoke mpisoroñe naho o rahalahi’e mpisoroñeo, añatrefa’ i kivoho’ Iehovày, an­kaboañe e Gibone eo,"]},{"type":"verse","number":40,"content":["ty hisoroñe am’ Iehovà nainai’e boak’ andro naho hariva, ty amy ze hene sinokitse amy Hà’ Iehovà nandilia’e am’ Israeley;"]},{"type":"verse","number":41,"content":["mpiam’ iereo t’i Hemane naho Iedotone naho o ila’e jinoboñeo, o tinoñon-tahinañeo,",{"text":"hañandriañe Iehovà, fa nainai’e ty fifere­nai­ña’e;","poem":1}]},{"type":"verse","number":42,"content":["aa le o mindre amy Hemane naho Iedotoneo ro hampipoñake trompetra naho fikaran­tsañe naho o raha titiheñe am-pisaboañe aman’ Añahareo; le an-dalambey eo o ana’ Iedotoneo."]},{"type":"verse","number":43,"content":["Aa le songa nimpoly mb’añ’ anjomba’e mb’eo ondatio; vaho nimpoly hitata i anjomba’ey t’i Davide."]}],"footnotes":[{"noteId":11,"caller":"+","text":"Sab 96:5","reference":{"chapter":16,"verse":26}}]},"thisChapterLink":"/api/tdx_sle/1CH/16.json","thisChapterAudioLinks":{},"nextChapterApiLink":"/api/tdx_sle/1CH/17.json","nextChapterAudioLinks":{},"previousChapterApiLink":"/api/tdx_sle/1CH/15.json","previousChapterAudioLinks":{},"numberOfVerses":43}